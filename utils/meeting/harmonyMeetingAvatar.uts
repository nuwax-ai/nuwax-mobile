import { resolveAuthProtectedFileFetchUrl } from "@/utils/authProtectedFileUrl";
import { resolveImAvatarDisplay } from "@/utils/imAvatarDisplay";

const avatarDataCache = new Map<string, string>();
const avatarDataPending = new Map<string, Promise<string>>();
const AVATAR_DATA_CACHE_LIMIT = 128;
const AVATAR_DATA_MAX_BYTES = 512 * 1024;

function avatarMimeType(url: string, base64: string): string {
  if (base64.indexOf("iVBOR") == 0) return "image/png";
  if (base64.indexOf("R0lGOD") == 0) return "image/gif";
  if (base64.indexOf("UklGR") == 0) return "image/webp";
  if (base64.indexOf("/9j/") == 0) return "image/jpeg";
  const path = url.toLowerCase().split("?")[0].split("#")[0];
  if (path.endsWith(".png")) return "image/png";
  if (path.endsWith(".gif")) return "image/gif";
  if (path.endsWith(".webp")) return "image/webp";
  if (path.endsWith(".svg")) return "image/svg+xml";
  return "image/jpeg";
}

function localAvatarDataUrl(filePath: string, sourceUrl: string): Promise<string> {
  return new Promise<string>((resolve) => {
    const fileManager = uni.getFileSystemManager();
    fileManager.getFileInfo({
      filePath: filePath,
      success: (info) => {
        if (info.size <= 0 || info.size > AVATAR_DATA_MAX_BYTES) {
          resolve("");
          return;
        }
        fileManager.readFile({
          filePath: filePath,
          encoding: "base64",
          success: (res) => {
            const data = res.data as string;
            resolve(data.length > 0 ? `data:${avatarMimeType(sourceUrl, data)};base64,${data}` : "");
          },
          fail: (_error) => { resolve(""); },
        });
      },
      fail: (_error) => { resolve(""); },
    });
  });
}

function remoteAvatarDataUrl(url: string, sourceUrl: string): Promise<string> {
  return new Promise<string>((resolve) => {
    uni.downloadFile({
      url: url,
      header: {} as UTSJSONObject,
      success: (res) => {
        const path = res.tempFilePath;
        if (res.statusCode != 200 || path == null || path.length == 0) {
          resolve("");
          return;
        }
        localAvatarDataUrl(path, sourceUrl).then(resolve);
      },
      fail: (_error) => { resolve(""); },
    });
  });
}

async function loadAvatarDataUrl(sourceUrl: string): Promise<string> {
  const displayUrl = await resolveImAvatarDisplay(sourceUrl, 96);
  if (displayUrl.indexOf("data:image/") == 0) return displayUrl;
  if (displayUrl.indexOf("https://") == 0 || displayUrl.indexOf("http://") == 0) {
    return await remoteAvatarDataUrl(displayUrl, sourceUrl);
  }
  if (displayUrl.indexOf("/") == 0 && displayUrl == sourceUrl) {
    return await remoteAvatarDataUrl(resolveAuthProtectedFileFetchUrl(displayUrl), sourceUrl);
  }
  return await localAvatarDataUrl(displayUrl, sourceUrl);
}

/** ArkWeb cannot consume ArkUI temp paths, so bridge the resolved avatar as an inline image. */
export function resolveHarmonyMeetingAvatarData(sourceUrl: string): Promise<string> {
  if (sourceUrl.length == 0) return Promise.resolve("");
  const cached = avatarDataCache.get(sourceUrl);
  if (cached != null) return Promise.resolve(cached);
  const pending = avatarDataPending.get(sourceUrl);
  if (pending != null) return pending;
  if (avatarDataCache.size >= AVATAR_DATA_CACHE_LIMIT) avatarDataCache.clear();
  const task = loadAvatarDataUrl(sourceUrl).then((dataUrl: string): string => {
    avatarDataCache.set(sourceUrl, dataUrl);
    avatarDataPending.delete(sourceUrl);
    return dataUrl;
  }).catch((_error: any | null): string => {
    avatarDataPending.delete(sourceUrl);
    return "";
  });
  avatarDataPending.set(sourceUrl, task);
  return task;
}
