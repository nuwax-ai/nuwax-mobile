/**
 * 自绘底部 TabBar 开关与参数。
 *
 * 原生 pages.json tabBar 注册始终保留（承担路由 / 页面保活 / switchTab），
 * 本模块只控制「是否用自绘 5 槽栏替代原生栏视觉」以及 ➕ 动作槽的目标。
 */

/** ➕ 视觉槽类型。terminal / union 同一视觉位（槽 1），按平台取其一。 */
export type CustomTabSlotKind =
  | "index"
  | "terminal"
  | "union"
  | "agent"
  | "mine"
  | "plus";

/** 自绘底栏挂载形态。 */
export type CustomTabBarMount = "in-flow" | "fixed";

/** 总开关：false = 全平台退化为原生 tabBar，不再叠自绘栏（兜底熔断，改回即恢复）。 */
export const CUSTOM_TAB_BAR_ENABLED: boolean = true;

/**
 * 挂载形态（平台默认，真机验证后可收紧）：
 * - 'in-flow'：栏体为页面根 flex-col 的最后一个子节点，依赖 hideTabBar 释放底部空间；
 * - 'fixed'：栏体 position:fixed 固定底部 + 组件内渲染等高占位（hide 不释放空间的兜底）。
 */
// #ifdef H5 || WEB
export const CUSTOM_TAB_BAR_MODE: CustomTabBarMount = "fixed";
// #endif
// #ifndef H5 || WEB
export const CUSTOM_TAB_BAR_MODE: CustomTabBarMount = "in-flow";
// #endif

/** ➕ 动作槽开关：true 时点击跳转 PLUS_ACTION_TARGET_PATH。 */
export const PLUS_ACTION_ENABLED: boolean = true;
/** ➕ 跳转目标路径：指向 tab 页时走 uni.switchTab，否则 uni.navigateTo。 */
export const PLUS_ACTION_TARGET_PATH: string = "/subpackages/pages/create-conversation/create-conversation";
/** ➕ 占位 toast 的 i18n key。 */
export const PLUS_ACTION_TOAST_KEY: string = "Mobile.Common.comingSoon";
