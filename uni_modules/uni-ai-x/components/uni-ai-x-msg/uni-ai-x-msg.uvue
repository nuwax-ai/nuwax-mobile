.msg-root-math-scroll {
	width: 100%;
	flex-direction: row;
}
/* H5：scroll-view 的内容容器默认不开横向滚动，需显式 overflow-x:auto 才能横滚看全超宽公式 */
/* #ifdef WEB */
.msg-root-math-scroll ::v-deep .uni-scroll-view-content {
