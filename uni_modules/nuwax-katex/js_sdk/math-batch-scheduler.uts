/**
 * nuwax-katex 公式批量渲染调度器（App 专用）
 *
 * 公式密集消息进入视口时，虚拟列表会在同一帧挂载多个 block（含几十个 nuwax-katex 组件），
 * 每个组件在 App 端创建一个独立 web-view（每个都是完整 WebView + KaTeX 页面），
 * 瞬时全部创建会把主线程打满 → 卡顿。
 *
 * 本调度器把「创建 web-view」摊到多帧：组件挂载时只登记一个放行回调，
 * 每 TICK_INTERVAL_MS 只放行 BATCH_PER_TICK 个，队列清空后停止调度。
 * 孤立公式（队列空）会在下一帧立即放行，感知不到延迟。
 *
 * 模块顶层状态是应用级单例（与 js_sdk/webview-id.uts 同模式）。
 */

const BATCH_PER_TICK: number = 6;
const TICK_INTERVAL_MS: number = 16;

let batchQueue: Array<() => void> = [] as Array<() => void>;
let draining: boolean = false;

/** 一个滴答：放行一批，剩余继续排队。 */
function drainTick(): void {
  let released = 0;
  while (released < BATCH_PER_TICK && batchQueue.length > 0) {
    const release = batchQueue.shift();
    if (release != null) {
      try {
        release();
      } catch (_eRelease) {
        // 单个公式放行失败不影响后续
      }
    }
    released++;
  }
  if (batchQueue.length > 0) {
    setTimeout((): void => {
      drainTick();
    }, TICK_INTERVAL_MS);
  } else {
    draining = false;
  }
}

/**
 * 登记一个待放行的公式渲染任务。
 * 调用方在 release 内创建 web-view（设置 webviewSrc）；release 前组件显示占位盒。
 */
export function enqueueFormulaRelease(release: () => void): void {
  batchQueue.push(release);
  if (draining != true) {
    draining = true;
    setTimeout((): void => {
      drainTick();
    }, 0);
  }
}
