import { getApiBaseUrl } from "@/constants/config";

/**
 * App / 小程序：拼浏览器可打开的 PC 端会话分享地址（域名取当前请求域名）。
 * - 普通智能体：{domain}/home/chat/{conversationId}/{agentId}
 * - 应用智能体：{domain}/app/chat/{agentId}/{conversationId}
 * 对齐 nuwax PC 路由：/home/chat/:id/:agentId 与 /app/chat/:agentId/:id。
 * agentId / conversationId 任一无效（<=0）时无法拼出有效会话链接，返回空串。
 */
export function buildBrowserShareUrl(
  agentId: number,
  conversationId: number,
  isAppDetails: boolean,
): string {
  const baseUrl = getApiBaseUrl();
  if (agentId <= 0 || conversationId <= 0 || baseUrl.length == 0) {
    return "";
  }
  const agentIdStr = agentId.toString();
  const conversationIdStr = conversationId.toString();
  if (isAppDetails == true) {
    // 应用智能体：/app/chat/{agentId}/{conversationId}
    return `${baseUrl}/app/chat/${agentIdStr}/${conversationIdStr}`;
  }
  // 普通智能体：/home/chat/{conversationId}/{agentId}
  return `${baseUrl}/home/chat/${conversationIdStr}/${agentIdStr}`;
}
