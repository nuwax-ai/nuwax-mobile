    margin-bottom: 16rpx;
    padding-left: 12rpx;
    border-left-width: 6rpx;
    border-left-color: #5147ff;
  }

  .nkx-formula {
    margin-bottom: 20rpx;
  }

  .nkx-formula-desc {
    font-size: 22rpx;
