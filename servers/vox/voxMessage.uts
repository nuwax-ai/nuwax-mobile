/**
 * Nuwax Vox 设备语音网关 - App 推送消息接口（应用内消息中心，不走系统推送）
 * 列表/未读数/标记已读；mock 开关见 mockVoxData.uts
 */
import request from "@/servers/useRequest";
import { VOX_BASE_URL } from "@/constants/config";
import type { RequestResponse, VoidRequestResponse } from "@/types/interfaces/request";
import type {
  AppPushMessageListParams,
  IAppPushMessageView,
  IAppPushUnreadCountView,
} from "@/types/interfaces/voxMessage";
import {
  isVoxMockEnabled,
  mockVoxMarkMessageRead,
  mockVoxMessageList,
  mockVoxUnreadCount,
} from "./mockVoxData";

/** 推送消息列表（默认最近 20 条，可按未读筛选） */
export async function apiVoxMessageList(data: AppPushMessageListParams): Promise<RequestResponse<IAppPushMessageView[]>> {
  if (isVoxMockEnabled()) {
    return mockVoxMessageList(data.unreadOnly, data.limit);
  }
  const res = await request({
    url: `/api/app/push/messages?unreadOnly=${data.unreadOnly}&limit=${data.limit}`,
    method: "GET",
    baseUrl: VOX_BASE_URL,
  });
  return res;
}

/** 未读推送数量（应用内角标） */
export async function apiVoxUnreadCount(): Promise<RequestResponse<IAppPushUnreadCountView>> {
  if (isVoxMockEnabled()) {
    return mockVoxUnreadCount();
  }
  const res = await request({ url: "/api/app/push/unread-count", method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 标记消息已读 */
export async function apiVoxMarkMessageRead(id: number): Promise<VoidRequestResponse> {
  if (isVoxMockEnabled()) {
    return mockVoxMarkMessageRead(id);
  }
  const res = await request({ url: `/api/app/push/messages/${id}/read`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}
