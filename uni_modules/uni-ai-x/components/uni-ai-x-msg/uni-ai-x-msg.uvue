<template>
	<view class="msg-root-content">
		<template v-for="(item, index) in markdownElList" :key="markdownItemKey(item, index)">
			<TaskResultCard
				v-if="item.type == 'task_result'"
				class="msg-root-process-box"
				:task-result-data="getTaskResultData(item)"
				:conversation-id="conversationId"
			/>
			<template v-else-if="item.type == 'markdown_custom_process_group'">
				<ToolCallGroup
					:items="getCustomProcessList(item)"
					class="msg-root-process-box"
				>
					<ToolCallCard
						v-for="(process, processIndex) in getCustomProcessList(item)"
						:key="getProcessKey(process, processIndex)"
						:tool-call-data="resolveProcessData(process)"
					/>
				</ToolCallGroup>
				<!-- 工具组内的 OpenUI 产物（预过滤，避免 v-for+v-if 致 vapor 编译 bug） -->
				<template v-for="(process, processIndex) in getOpenUiProcessList(item)" :key="'openui-grp-' + getProcessKey(process, processIndex)">
					<OpenUiCard
						:artifact-id="openuiProcessId(process)"
						:title="openuiProcessTitle(process)"
						:conversation-id="conversationId"
					/>
				</template>
			</template>
			<view
				v-else-if="item.type == 'markdown_custom_process'"
				class="msg-root-process-box"
			>
				<ToolCallCard :tool-call-data="resolveFirstProcessData(item)" />
				<!-- OpenUI 产物：EXECUTING 时也渲染占位卡，FINISHED 后 artifactId 到了变可点击 -->
				<OpenUiCard
					v-if="isRenderToolItem(item)"
					:artifact-id="openuiIdOf(item)"
					:title="openuiTitleOf(item)"
					:conversation-id="conversationId"
				/>
			</view>
			<view
				v-else-if="item.type == 'markdown_image'"
				class="msg-root-markdown-image-box"
			>
				<image
					class="msg-root-markdown-image"
					:src="getMarkdownImageSrc(item)"
					mode="widthFix"
					@click="previewMarkdownImage(item)"
				/>
			</view>
			<view v-else-if="item.type == 'block_quote'" class="msg-root-block-quote-box">
				<uni-ai-text-md v-for="(blockQuote, i) in item.datasList" :key="i" :datas="blockQuote" :itemType="item.type" :is-app-details="isAppDetails"/>
			</view>
			<!-- 列表：支持行内公式混排（text + katex-el），避免 $|\Psi|^2$ 等露出裸 LaTeX -->
			<view v-else-if="item.type == 'list'" class="msg-root-list-box">
				<view
					class="msg-root-list-row"
					v-for="(listRow, listIndex) in item.datasList"
					:key="'list-' + index + '-' + listIndex"
				>
					<template v-for="(token, tokenIndex) in listRow" :key="'lt-' + tokenIndex">
						<katex-el
							v-if="token.type == 'math'"
							class="msg-root-list-math"
							:html="token.html"
							:href="token.href"
							:svg="token.svg"
							:width="token.width"
							:height="token.height"
							:inline="true"
							:key="'lm-' + tokenIndex + '-' + ((token.href ?? '').length) + '-' + ((token.svg ?? '').length) + '-' + ((token.html ?? '').length)"
						/>
						<text
							v-else-if="isListLinebreakToken(token) != true"
							:class="listTokenClass(token.className)"
							@click="onListTokenClick(token.href)"
						>{{ resolveListTokenText(token) }}</text>
					</template>
				</view>
			</view>
			<!-- 标题：支持行内公式混排（text + katex-el） -->
			<template v-else-if="item.type == 'heading'">
				<view
					class="msg-root-heading-box"
					v-for="(datas, headingRowIndex) in item.datasList"
					:key="'heading-' + index + '-' + headingRowIndex"
				>
					<template v-for="(token, tokenIndex) in datas" :key="'ht-' + tokenIndex">
						<katex-el
							v-if="token.type == 'math'"
							class="msg-root-heading-math"
							:html="token.html"
							:href="token.href"
							:svg="token.svg"
							:width="token.width"
							:height="token.height"
							:inline="true"
							:key="'hm-' + tokenIndex + '-' + ((token.href ?? '').length) + '-' + ((token.svg ?? '').length) + '-' + ((token.html ?? '').length)"
						/>
						<text
							v-else
							:class="'msg-root-heading-text ' + headingTokenClass(token.className)"
						>{{ token.text ?? '' }}</text>
					</template>
				</view>
			</template>
			<!-- 忽略水平线 thematic_break，避免 $$ 后 --- 等产生多余中横线 -->
			<template v-else-if="item.type != 'thematic_break'">
				<template v-for="(datas, i) in item.datasList" :key="i">
				<template v-if="['table', 'code_block', 'math', 'block_quote'].includes(item.type)">
					<template v-for="(data, k) in datas" :key="k">
					<uni-ai-msg-table
						class="msg-root-table-box"
						v-if="item.type == 'table'"
						:table-node="data"
						:key="'table-' + (data.uniqueId ?? k) + '-' + tableMathKey(data)"
					/>
					<uni-ai-msg-code class="msg-root-code-box" v-else-if="item.type == 'code_block'" :codeTokens="data.codeTokens ?? []"  :codeText="data.text ?? ''" :language="data.lang ?? 'text'" :href="data.href" :width="data.width ?? 0" :height="data.height ?? 0" />
					<!-- App：块级公式图——单一 scroll-view 容器（避免 view↔scroll-view 切换与渲染帧竞争触发 CME）；
						放得下时居中无滚动条，超宽横滚；点击放大预览 -->
					<scroll-view
						v-else-if="item.type == 'math'"
						class="msg-root-math-scroll"
						direction="horizontal"
						:show-scrollbar="false"
						@click="onBlockMathClick(data.href)"
					>
						<view class="msg-root-math-inner">
							<katex-el :html="data.html" :href="data.href" :svg="data.svg" :width="data.width" :height="data.height" :key="'bm-' + k + '-' + ((data.href ?? '').length) + '-' + ((data.svg ?? '').length) + '-' + ((data.html ?? '').length)" />
						</view>
					</scroll-view>
				</template>
				</template>
				<!-- 段落含行内公式：view 混排（text + katex-el 同行），否则 uni-ai-text-md 纯文本排版 -->
				<view
					v-else-if="item.type == 'paragraph' && hasMathToken(datas)"
					class="msg-root-paragraph-mixed-box"
					:key="'para-mixed-' + i + '-' + paragraphMathKey(datas)"
				>
					<template v-for="(token, tokenIndex) in datas" :key="'pt-' + tokenIndex">
						<katex-el
							v-if="token.type == 'math'"
							class="msg-root-paragraph-math"
							:html="token.html"
							:href="token.href"
							:svg="token.svg"
							:width="token.width"
							:height="token.height"
							:inline="true"
							:key="'pm-' + tokenIndex + '-' + ((token.href ?? '').length) + '-' + ((token.svg ?? '').length) + '-' + ((token.html ?? '').length)"
						/>
						<!-- 段落内换行符：flex 混排里 \n 不认，用整行占位强制换行 -->
						<view
							v-else-if="isNewlineToken(token)"
							class="msg-root-paragraph-br"
							:key="'pbr-' + tokenIndex"
						/>
						<text
							v-else
							:class="paragraphTokenClass(token.className)"
							@click="onListTokenClick(token.href)"
						>{{ token.text ?? '' }}</text>
					</template>
				</view>
				<uni-ai-text-md v-else :datas="datas" :itemType="item.type" :is-app-details="isAppDetails" :key="item.uniqueId"/>
			</template>
		</template>
		</template>
	</view>
</template>

<script lang="uts" setup>
import type { UniAiMarkdownElItem } from '@/uni_modules/uni-ai-x/types.uts'
import type { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import type { ProcessingInfo, ExecuteResultInfo } from '@/types/interfaces/conversationInfo.uts'
import ToolCallCard from '@/subpackages/components/tool-call/tool-call-card.uvue'
import ToolCallGroup from '@/subpackages/components/tool-call/tool-call-group.uvue'
import TaskResultCard from '@/subpackages/components/task-result/task-result-card.uvue'
import OpenUiCard from '@/subpackages/components/openui-card/openui-card.uvue'
import { extractOpenUiArtifactFromMessage, extractOpenUiArtifactIdFromText, extractOpenUiArtifactInfo, isOpenUiRenderToolName, type OpenUiArtifactInfo } from '@/utils/openUiSchema.uts'

const props = withDefaults(
	defineProps<{
		markdownElList: UniAiMarkdownElItem[]
		processingList?: any[]
		conversationId?: string
		isAppDetails?: boolean
		bodyText?: string
	}>(),
	{
		markdownElList: (): UniAiMarkdownElItem[] => [] as UniAiMarkdownElItem[],
		processingList: (): any[] => [] as any[],
		conversationId: '',
		isAppDetails: false,
		bodyText: '',
	},
)

// 行内公式：段落/列表/标题均用 katex-el 混排（:inline）；块级公式仍走 scroll-view + 截图。

/**
 * 稳定 key：避免 SSE 插入工具卡后 :key=index 错位复用导致 Android 原生列表停更。
 * 有 uniqueId 时禁止再拼 list index（插卡后后续项 index 漂移会再次触发错位复用）。
 */
function markdownItemKey(item: UniAiMarkdownElItem, index: number): string {
	const id = item.uniqueId
	if (id != null && `${id}`.length > 0) {
		return `${item.type}__` + `${id}`
	}
	return `${item.type}__i` + index
}

/** 获取 task-result 结构化数据。 */
function getTaskResultData(item: UniAiMarkdownElItem): any {
	return item.taskResultData != null
		? item.taskResultData!
		: new UTSJSONObject()
}

/** 获取自定义工具标签列表。 */
function getCustomProcessList(item: UniAiMarkdownElItem): any[] {
	return item.customProcessList != null
		? item.customProcessList!
		: [] as any[]
}

/** 预过滤：仅返回 isRenderToolProcess 为 true 的 process（避免模板 v-for+v-if 致 vapor 编译 bug） */
function getOpenUiProcessList(item: UniAiMarkdownElItem): any[] {
	const all = getCustomProcessList(item)
	const result: any[] = [] as any[]
	for (let i = 0; i < all.length; i++) {
		if (isRenderToolProcess(all[i])) {
			result.push(all[i])
		}
	}
	return result
}

/** 读取标签对象中的 executeId。 */
function getTagExecuteId(item: any | null): string {
	if (item == null) return ''
	const tag = item as UTSJSONObject
	const direct = tag['executeId']
	if (direct != null && `${direct}`.length > 0) {
		return `${direct}`
	}
	return ''
}

/** 兼容 ExecuteResultInfo 类实例与动态对象读取。 */
function readResultField(result: any | null, key: string): any | null {
	if (result == null) return null
	try {
		const obj = result as UTSJSONObject
		const value = obj[key]
		if (value != null) return value
	} catch (_eObj) {
		// ExecuteResultInfo 类实例不能强转 UTSJSONObject
	}
	try {
		const value = result as ExecuteResultInfo
		if (key == 'data') return value.data
		if (key == 'error') return value.error
		if (key == 'id') return value.id
		if (key == 'icon') return value.icon
		if (key == 'input') return value.input
		if (key == 'name') return value.name
		if (key == 'startTime') return value.startTime
		if (key == 'endTime') return value.endTime
		if (key == 'success') return value.success
		if (key == 'type') return value.type
		if (key == 'kind') return value.kind
	} catch (_eResult) {
		// 非 ExecuteResultInfo
	}
	// SSE result 动态对象上的 executeId/status（ExecuteResultInfo 无这两字段）
	try {
		const obj = result as UTSJSONObject
		if (key == 'executeId' || key == 'status') {
			const value = obj[key]
			if (value != null) return value
		}
	} catch (_eDyn) {
		// ignore
	}
	return null
}

/** 读取强类型 ProcessingInfo 中的字段；顶层缺失时回退到 result 内同名字段。 */
function readProcessingField(item: any | null, key: string): any | null {
	if (item == null) return null
	let top: any | null = null
	try {
		const obj = item as UTSJSONObject
		const value = obj[key]
		if (value != null) top = value
	} catch (_eObj) {
		// ProcessingInfo 类实例不能强转 UTSJSONObject
	}
	if (top == null) {
		try {
			const process = item as ProcessingInfo
			if (key == 'executeId') top = process.executeId
			else if (key == 'cardBindConfig') top = process.cardBindConfig
			else if (key == 'name') top = process.name
			else if (key == 'result') top = process.result
			else if (key == 'status') top = process.status
			else if (key == 'targetId') top = process.targetId
			else if (key == 'type') top = process.type
		} catch (_eProcess) {
			// 非 ProcessingInfo
		}
	}
	if (top != null) {
		return top
	}
	// App SSE：executeId/status/type/name 常只在 result 内
	if (key == 'result' || key == 'cardBindConfig' || key == 'targetId') {
		return null
	}
	let result: any | null = null
	try {
		const obj = item as UTSJSONObject
		result = obj['result']
	} catch (_eResultObj) {
		try {
			result = (item as ProcessingInfo).result
		} catch (_eResult) {
			result = null
		}
	}
	if (result == null) {
		return null
	}
	return readResultField(result, key)
}

/** 将执行结果规范为 MarkdownContainer 可安全读取的对象。 */
function normalizeExecuteResult(result: any | null): UTSJSONObject {
	const out = new UTSJSONObject()
	out['data'] = readResultField(result, 'data')
	out['error'] = readResultField(result, 'error')
	out['id'] = readResultField(result, 'id')
	out['icon'] = readResultField(result, 'icon')
	out['input'] = readResultField(result, 'input')
	out['name'] = readResultField(result, 'name')
	out['startTime'] = readResultField(result, 'startTime')
	out['endTime'] = readResultField(result, 'endTime')
	out['success'] = readResultField(result, 'success')
	out['type'] = readResultField(result, 'type')
	out['kind'] = readResultField(result, 'kind')
	return out
}

/** 将 ProcessingInfo 类实例规范为 UTSJSONObject，避免 Android 强转崩溃。 */
function normalizeProcessingInfo(item: any): UTSJSONObject {
	const out = new UTSJSONObject()
	out['executeId'] = readProcessingField(item, 'executeId')
	out['cardBindConfig'] = readProcessingField(item, 'cardBindConfig')
	out['name'] = readProcessingField(item, 'name')
	out['result'] = normalizeExecuteResult(readProcessingField(item, 'result'))
	out['status'] = readProcessingField(item, 'status')
	out['targetId'] = readProcessingField(item, 'targetId')
	out['type'] = readProcessingField(item, 'type')
	return out
}

/** 工具调用 executeId。 */
function getProcessingExecuteId(item: any | null): string {
	const executeId = readProcessingField(item, 'executeId')
	return executeId != null ? `${executeId}` : ''
}

/** 读取标签上的 type（用于与 processingList 类型对齐，避免同 executeId 的 Event 覆盖 Plan）。 */
function getTagType(tag: any | null): string {
	if (tag == null) return ''
	const obj = tag as UTSJSONObject
	const value = obj['type']
	return value != null ? `${value}` : ''
}

/**
 * 用 processingList 中的完整执行数据补齐标签属性。
 * 对齐 dev mp-html getProcessingDataByPriority：同 executeId 时优先匹配标签声明的 type。
 */
function resolveProcessData(tag: any | null): any {
	const executeId = getTagExecuteId(tag)
	const expectedType = getTagType(tag).toLowerCase()
	const base = tag != null ? tag as UTSJSONObject : new UTSJSONObject()
	if (executeId.length == 0) {
		return base
	}

	const list = props.processingList
	let best: any | null = null
	let bestScore = 9999
	for (let i = 0; i < list.length; i++) {
		const process = list[i]
		if (getProcessingExecuteId(process) != executeId) {
			continue
		}
		const processTypeRaw = readProcessingField(process, 'type')
		const statusRaw = readProcessingField(process, 'status')
		const processType = (processTypeRaw != null ? `${processTypeRaw}` : '').toLowerCase()
		const status = statusRaw != null ? `${statusRaw}` : ''
		let score = 100
		if (expectedType.length > 0 && processType == expectedType) {
			score = 0
		} else if (processType == 'event') {
			score = 200
		}
		if (status == 'FINISHED') {
			score += 1
		} else if (status == 'FAILED') {
			score += 2
		} else {
			score += 3
		}
		if (score < bestScore) {
			bestScore = score
			best = process
		}
	}

	if (best == null) {
		return base
	}

	// 以 processing 完整数据为主，保留标签上的 name/type/status 兜底
	const merged = normalizeProcessingInfo(best)
	if (merged['name'] == null || `${merged['name']}`.length == 0) {
		const tagName = base['name']
		if (tagName != null) merged['name'] = tagName
	}
	if (merged['type'] == null || `${merged['type']}`.length == 0) {
		const tagType = base['type']
		if (tagType != null) merged['type'] = tagType
	}
	if (merged['status'] == null || `${merged['status']}`.length == 0) {
		const tagStatus = base['status']
		if (tagStatus != null) merged['status'] = tagStatus
	}
	return merged
}

/** 单个工具标签的完整渲染数据。 */
function resolveFirstProcessData(item: UniAiMarkdownElItem): any {
	const list = getCustomProcessList(item)
	return list.length > 0 ? resolveProcessData(list[0]) : new UTSJSONObject()
}

/** 精确 executeId 未匹配时，从同一消息的 processingList 中查找已完成 OpenUI 产物。 */
function openuiMessageFallback(): OpenUiArtifactInfo | null {
	return extractOpenUiArtifactFromMessage(props.bodyText, props.processingList)
}

/** 工具标签是否为 OpenUI 渲染产物；命中返回 artifact 信息（含 mode），否则 null。 */
function openuiInfoOf(item: UniAiMarkdownElItem): OpenUiArtifactInfo | null {
	const data = resolveFirstProcessData(item) as UTSJSONObject
	const name = `${data['name']}`
	if (isOpenUiRenderToolName(name) == false) {
		return null
	}
	const exact = extractOpenUiArtifactInfo(data['result'], name)
	return exact != null ? exact : openuiMessageFallback()
}
/** 是否为 render 工具（不需要 result，EXECUTING 时也能判断）→ 流式占位入口。 */
function isRenderToolItem(item: UniAiMarkdownElItem): boolean {
	const data = resolveFirstProcessData(item) as UTSJSONObject
	return isOpenUiRenderToolName(`${data['name']}`)
}
function isRenderToolProcess(process: any): boolean {
	const data = resolveProcessData(process) as UTSJSONObject
	return isOpenUiRenderToolName(`${data['name']}`)
}
/** 工具组内单个 process 的 OpenUI artifact 信息（供 group 分支渲染）。 */
function openuiInfoOfProcess(process: any): OpenUiArtifactInfo | null {
	const data = resolveProcessData(process) as UTSJSONObject
	const name = `${data['name']}`
	if (isOpenUiRenderToolName(name) == false) {
		return null
	}
	const exact = extractOpenUiArtifactInfo(data['result'], name)
	return exact != null ? exact : openuiMessageFallback()
}
function openuiProcessId(process: any): string {
	const info = openuiInfoOfProcess(process)
	const id = info != null ? info.artifactId : ''
	if (id.length > 0) return id
	return extractOpenUiArtifactIdFromText(props.bodyText)
}
function openuiProcessTitle(process: any): string {
	const info = openuiInfoOfProcess(process)
	return info != null ? info.title : ''
}
function openuiProcessMode(process: any): string {
	const info = openuiInfoOfProcess(process)
	return info != null ? info.mode : ''
}
function openuiIdOf(item: UniAiMarkdownElItem): string {
	const info = openuiInfoOf(item)
	const id = info != null ? info.artifactId : ''
	if (id.length > 0) return id
	// processingList result 没到（流式 EXECUTING）→ 从消息正文提取 data/{uuid}.openui.json
	return extractOpenUiArtifactIdFromText(props.bodyText)
}
function openuiTitleOf(item: UniAiMarkdownElItem): string {
	const info = openuiInfoOf(item)
	return info != null ? info.title : ''
}
function openuiModeOf(item: UniAiMarkdownElItem): string {
	const info = openuiInfoOf(item)
	return info != null ? info.mode : ''
}

/** 工具标签稳定 key（优先 executeId，避免 SSE 重解析后 index 漂移）。 */
function getProcessKey(process: any | null, index: number): string {
	const executeId = getTagExecuteId(process)
	return executeId.length > 0 ? `proc__${executeId}` : `proc__i${index}`
}

/** 读取 markdown_image 节点的图片地址。 */
function getMarkdownImageSrc(item: UniAiMarkdownElItem): string {
	const rows = item.datasList
	if (rows == null || rows.length == 0) {
		return ""
	}
	const row = rows[0]
	if (row == null || row.length == 0) {
		return ""
	}
	const tok = row[0]
	const href = tok.href
	return href != null ? `${href}` : ""
}

/** 行内公式是否已渲染完成。 */
function isInlineMathRendered(token: MarkdownToken): boolean {
	const html = token.html ?? ''
	const href = token.href ?? ''
	return html.length > 0 || href.length > 0
}

/** 列表行间 linebreak 不渲染（每行已是独立 view）。 */
function isListLinebreakToken(token: MarkdownToken): boolean {
	const className = token.className != null ? `${token.className}` : ''
	if (className.indexOf('linebreak') >= 0) {
		return true
	}
	const text = token.text != null ? `${token.text}` : ''
	return text == '\n'
}

function resolveListTokenText(token: MarkdownToken): string {
	return token.text != null ? `${token.text}` : ''
}

function listTokenClass(className: string | null): string {
	const raw = className != null ? `${className}` : 'text'
	if (raw.indexOf('list-item-index') >= 0) {
		return 'msg-root-list-text msg-root-list-bullet'
	}
	if (raw.indexOf('strong') >= 0) {
		return 'msg-root-list-text msg-root-list-strong'
	}
	if (raw.indexOf('em') >= 0) {
		return 'msg-root-list-text msg-root-list-em'
	}
	if (raw.indexOf('del') >= 0) {
		return 'msg-root-list-text msg-root-list-del'
	}
	if (raw.indexOf('code') >= 0) {
		return 'msg-root-list-text msg-root-list-code'
	}
	if (raw.indexOf('link') >= 0) {
		return 'msg-root-list-text msg-root-list-link'
	}
	return 'msg-root-list-text'
}

/** 段落 token 样式（与 uni-ai-text-md 正文一致：strong/em/del/code/link）。 */
function paragraphTokenClass(className: string | null): string {
	const raw = className != null ? `${className}` : 'text'
	if (raw.indexOf('strong') >= 0) {
		return 'msg-root-paragraph-text msg-root-paragraph-strong'
	}
	if (raw.indexOf('em') >= 0) {
		return 'msg-root-paragraph-text msg-root-paragraph-em'
	}
	if (raw.indexOf('del') >= 0) {
		return 'msg-root-paragraph-text msg-root-paragraph-del'
	}
	if (raw.indexOf('code') >= 0) {
		return 'msg-root-paragraph-text msg-root-paragraph-code'
	}
	if (raw.indexOf('link') >= 0) {
		return 'msg-root-paragraph-text msg-root-paragraph-link'
	}
	return 'msg-root-paragraph-text'
}

/** 段落 token 列表是否含行内公式（App/H5 均走 katex-el 混排，与 list/heading 一致）。 */
function hasMathToken(datas: MarkdownToken[]): boolean {
	for (let i = 0; i < datas.length; i++) {
		if (datas[i].type == 'math') {
			return true
		}
	}
	return false
}

/** 段落公式渲染签名：KaTeX 回填后变化，驱动混排容器 remount。 */
function paragraphMathKey(datas: MarkdownToken[]): string {
	let sign = ''
	for (let i = 0; i < datas.length; i++) {
		const t = datas[i]
		if (t.type == 'math') {
			sign += (t.href ?? '').length + 'x' + (t.html ?? '').length + ':'
		}
	}
	return sign.length > 0 ? sign : '0'
}

/** 段落内换行符 token（多行段落行间插入的 \n）。 */
function isNewlineToken(token: MarkdownToken): boolean {
	const text = token.text != null ? `${token.text}` : ''
	return token.type != 'math' && text == '\n'
}

function onListTokenClick(url: string | null): void {
	if (url == null || `${url}`.length == 0) {
		return
	}
	const href = `${url}`
	if (href.indexOf('conversation://') == 0) {
		return
	}
	// H5 未注册 uni-ai-x 的内置 webview 页面，外部链接直接交给浏览器打开。
	// #ifdef H5 || WEB
	window.open(href, '_blank')
	return
	// #endif
	uni.navigateTo({
		url: '/subpackages/pages/webview/webview?url=' + encodeURIComponent(href),
		fail: (_e) => {},
	})
}

/** 标题 token 样式（depth-1..6）。 */
function headingTokenClass(className: string | null): string {
	const raw = className != null ? `${className}` : 'text depth-3'
	let depth = '3'
	if (raw.indexOf('depth-1') >= 0) depth = '1'
	else if (raw.indexOf('depth-2') >= 0) depth = '2'
	else if (raw.indexOf('depth-3') >= 0) depth = '3'
	else if (raw.indexOf('depth-4') >= 0) depth = '4'
	else if (raw.indexOf('depth-5') >= 0) depth = '5'
	else if (raw.indexOf('depth-6') >= 0) depth = '6'
	return 'msg-root-heading-depth-' + depth
}

/** 表格内公式渲染签名：KaTeX 回填后变化，驱动 table 组件 remount。 */
function tableMathKey(tableNode: MarkdownToken): string {
	const rows = tableNode.tokens ?? []
	let sign = ''
	for (let r = 0; r < rows.length; r++) {
		const cells = rows[r].tokens ?? []
		for (let c = 0; c < cells.length; c++) {
			const tokens = cells[c].tokens ?? []
			for (let t = 0; t < tokens.length; t++) {
				const token = tokens[t]
				if (token.type == 'math') {
					const hrefLen = (token.href ?? '').length
					const htmlLen = (token.html ?? '').length
					sign += hrefLen + 'x' + htmlLen + ':'
				}
			}
		}
	}
	return sign.length > 0 ? sign : '0'
}

/** 预览正文原位图片。 */
function previewMarkdownImage(item: UniAiMarkdownElItem): void {
	const src = getMarkdownImageSrc(item)
	if (src.length == 0) {
		return
	}
	const urls = [] as string[]
	const list = props.markdownElList
	for (let i = 0; i < list.length; i++) {
		const el = list[i]
		if (el.type == "markdown_image") {
			const u = getMarkdownImageSrc(el)
			if (u.length > 0) {
				urls.push(u)
			}
		}
	}
	uni.previewImage({
		urls: urls.length > 0 ? urls : [src],
		current: src,
	})
}

/** App：块级公式图点击放大预览。href 为 proxy 截图 base64，与 mermaid 一致直接喂 uni.previewImage。 */
function onBlockMathClick(href: string | null): void {
	const src = href != null ? `${href}` : ''
	if (src.length == 0) {
		return
	}
	uni.previewImage({
		urls: [src],
		current: src,
	})
}

</script>

<style lang="scss">
