      .row-avatar-emoji {
        font-size: 40rpx;
      }
    }

    .row-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;

      .row-title {
        font-size: 30rpx;
        font-weight: 600;
        color: #1a1a1a;
      }

