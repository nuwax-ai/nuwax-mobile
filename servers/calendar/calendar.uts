/**
 * 日程 / 待办接口。
 * 本目录承接 /api/calendar/*，后续创建、查询等接口也加在这里。
 *
 * 创建：POST /api/calendar/create。可同时按人邀请和按群邀请。
 *
 * 更新契约：POST /api/calendar/update。
 * 创建者或可编辑参与人可调用。请求里为 null 的字段服务端保持原值；
 * 修改开始或结束时间时，服务端按新时间重算提醒。
 *
 * 重新打开：POST /api/calendar/reopen。请求体为 CalendarIdReq，只传 id。
 *
 * 一键完成：POST /api/calendar/force-complete。仅创建者可调用。
 * 请求体为 CalendarIdReq，只传 id。服务端直接把整条待办置为完成，不等参与人逐人完成。
 *
 * 日程详情：POST /api/calendar/detail。请求体为 CalendarIdReq，只传 id。返回含参与人列表与回复状态。
 *
 * 删除日程：POST /api/calendar/delete。请求体为 CalendarIdReq，只传 id。
 *
 * 取消日程：POST /api/calendar/cancel。请求体为 CalendarIdReq，只传 id。
 *
 * 变更参与人角色：POST /api/calendar/participant/role。仅创建者可调用，角色在 EDITOR 与 VIEWER 之间切换。
 *
 * 回复邀请：POST /api/calendar/participant/reply。拒绝后不再接收该日程提醒。
 *
 * 移除参与人：POST /api/calendar/participant/remove。仅创建者可调用。
 *
 * 邀请参与人：POST /api/calendar/participant/invite。仅创建者可调用，限同租户用户。
 * participants 按人邀请，inviteGroupConvIds 按群整体邀请。
 *
 * 参与人完成份额：POST /api/calendar/participant/complete。
 * 多人待办由服务端按完成模式判定整体是否完成；requireSubmit 时 fileKey 必传。
 *
 * 我的日程列表：POST /api/calendar/list/my。
 * 传 beginTime、endTime 时按日历窗口查询；都不传时返回未完成全量，以及前后 90 天内已完成的日程。
 *
 * 我创建的日程 / 待办列表：POST /api/calendar/list-my-created。
 * 请求体同样是 CalendarEventQueryReq，可按群会话 groupConvId 过滤。只返回当前用户创建的记录。
 *
 * 我参与的日程 / 待办列表：POST /api/calendar/list-my-participated。
 * 请求体同样是 CalendarEventQueryReq。我创建但参与人里没有自己的记录不在其中。
 *
 * 群待办列表：POST /api/calendar/list-by-group。按来源群查全部，调用人须为该群成员。
 * groupConvId 必填，仍用十进制字符串写入原始数字。
 *
 * 联系人工作日程：POST /api/calendar/list/contact。含其参与的日程，服务端校验好友关系。
 *
 * 忙闲查询：POST /api/calendar/busy。不传 contactUserId 查自己，传入则查联系人。
 * 返回进行中工作日程的忙碌时段，含其参与的日程。
 *
 * 我的待回复邀请：POST /api/calendar/invitation/my。无请求参数，Content-Type 为表单。
 *
 * id、eventId、userId、contactUserId、群会话 ID 是 int64。入参用十进制字符串，请求体里以原始数字写出，不经过 number。
 */
import request from "@/servers/useRequest";
import type { RequestResponse } from "@/types/interfaces/request";
import type { CalendarBusySlotDto, CalendarEventDto, CalendarInvitationDto, CalendarParticipantDto } from "@/types/interfaces/calendar";
import { CalendarBusyQueryReq, CalendarContactQueryReq, CalendarEventCreateDto, CalendarEventQueryReq, CalendarEventUpdateDto, CalendarExtraField, CalendarIdReq, CalendarInviteReq, CalendarParticipantCompleteReq, CalendarParticipantOpReq, CalendarParticipantReq } from "@/types/interfaces/calendar";

function isUnsignedIntLiteral(value: string): boolean {
  if (value.length == 0) {
    return false;
  }
  for (let i = 0; i < value.length; i++) {
    const ch = value.charAt(i);
    if (ch < "0" || ch > "9") {
      return false;
    }
  }
  return true;
}

function pushJsonString(parts: string[], key: string, value: string | null): void {
  if (value == null) {
    return;
  }
  parts.push(`"${key}":${JSON.stringify(value)}`);
}

function pushJsonBool(parts: string[], key: string, value: boolean | null): void {
  if (value == null) {
    return;
  }
  const literal = value == true ? "true" : "false";
  parts.push(`"${key}":${literal}`);
}

function pushJsonInt(parts: string[], key: string, value: number | null): void {
  if (value == null) {
    return;
  }
  parts.push(`"${key}":${value}`);
}

/** int64 按原始数字写入。null 或非十进制数字时跳过，避免拼出非法 JSON。 */
function pushJsonInt64(parts: string[], key: string, value: string | null): void {
  if (value == null || !isUnsignedIntLiteral(value)) {
    return;
  }
  parts.push(`"${key}":${value}`);
}

function extraFieldsJson(fields: CalendarExtraField[] | null): string | null {
  if (fields == null) {
    return null;
  }
  const items: string[] = [];
  for (let i = 0; i < fields.length; i++) {
    const field = fields[i];
    const key = field.key != null ? field.key : "";
    const value = field.value != null ? field.value : "";
    items.push(`{"key":${JSON.stringify(key)},"value":${JSON.stringify(value)}}`);
  }
  return `[${items.join(",")}]`;
}

/**
 * 只写出非 null 字段。null 不进请求体，避免把「不修改」误写成空字符串。
 * id 单独按数字字面量拼接。
 */
function buildCalendarEventUpdateBody(data: CalendarEventUpdateDto): string {
  const parts: string[] = [];
  if (isUnsignedIntLiteral(data.id)) {
    parts.push(`"id":${data.id}`);
  }
  pushJsonString(parts, "category", data.category);
  pushJsonString(parts, "title", data.title);
  pushJsonString(parts, "description", data.description);
  pushJsonString(parts, "location", data.location);
  pushJsonBool(parts, "allDay", data.allDay);
  pushJsonString(parts, "startTime", data.startTime);
  pushJsonString(parts, "endTime", data.endTime);
  pushJsonInt(parts, "priority", data.priority);
  pushJsonBool(parts, "remindEnabled", data.remindEnabled);
  pushJsonInt(parts, "remindBeforeMinutes", data.remindBeforeMinutes);
  pushJsonString(parts, "remindType", data.remindType);
  pushJsonInt(parts, "remindIntervalMinutes", data.remindIntervalMinutes);
  pushJsonString(parts, "completeMode", data.completeMode);
  pushJsonInt(parts, "completeRatio", data.completeRatio);
  pushJsonBool(parts, "requireSubmit", data.requireSubmit);
  const extraFields = extraFieldsJson(data.extraFields);
  if (extraFields != null) {
    parts.push(`"extraFields":${extraFields}`);
  }
  return `{${parts.join(",")}}`;
}

/** 只含 id 的请求体。id 不是十进制数字时不写入，避免拼出非法 JSON。 */
function buildCalendarIdBody(id: string): string {
  if (!isUnsignedIntLiteral(id)) {
    return "{}";
  }
  return `{"id":${id}}`;
}

function participantsJson(list: CalendarParticipantReq[] | null): string | null {
  if (list == null) {
    return null;
  }
  const items: string[] = [];
  for (let i = 0; i < list.length; i++) {
    const item = list[i];
    const fields: string[] = [];
    pushJsonInt64(fields, "userId", item.userId);
    pushJsonString(fields, "role", item.role);
    items.push(`{${fields.join(",")}}`);
  }
  return `[${items.join(",")}]`;
}

function int64ListJson(ids: string[] | null): string | null {
  if (ids == null) {
    return null;
  }
  const literals: string[] = [];
  for (let i = 0; i < ids.length; i++) {
    if (isUnsignedIntLiteral(ids[i])) {
      literals.push(ids[i]);
    }
  }
  return `[${literals.join(",")}]`;
}

/** 邀请请求体。null 字段不提交；用户 ID 与群会话 ID 按原始数字写出。 */
function buildCalendarInviteBody(data: CalendarInviteReq): string {
  const parts: string[] = [];
  pushJsonInt64(parts, "eventId", data.eventId);
  const participants = participantsJson(data.participants);
  if (participants != null) {
    parts.push(`"participants":${participants}`);
  }
  const groupIds = int64ListJson(data.inviteGroupConvIds);
  if (groupIds != null) {
    parts.push(`"inviteGroupConvIds":${groupIds}`);
  }
  return `{${parts.join(",")}}`;
}

/** 创建请求体。null 字段不提交。 */
function buildCalendarEventCreateBody(data: CalendarEventCreateDto): string {
  const parts: string[] = [];
  pushJsonString(parts, "category", data.category);
  pushJsonString(parts, "title", data.title);
  pushJsonString(parts, "description", data.description);
  pushJsonString(parts, "location", data.location);
  pushJsonBool(parts, "allDay", data.allDay);
  pushJsonString(parts, "startTime", data.startTime);
  pushJsonString(parts, "endTime", data.endTime);
  pushJsonInt(parts, "priority", data.priority);
  pushJsonBool(parts, "remindEnabled", data.remindEnabled);
  pushJsonInt(parts, "remindBeforeMinutes", data.remindBeforeMinutes);
  pushJsonString(parts, "remindType", data.remindType);
  pushJsonInt(parts, "remindIntervalMinutes", data.remindIntervalMinutes);
  const participants = participantsJson(data.participants);
  if (participants != null) {
    parts.push(`"participants":${participants}`);
  }
  const groupIds = int64ListJson(data.inviteGroupConvIds);
  if (groupIds != null) {
    parts.push(`"inviteGroupConvIds":${groupIds}`);
  }
  pushJsonString(parts, "completeMode", data.completeMode);
  pushJsonInt(parts, "completeRatio", data.completeRatio);
  pushJsonBool(parts, "requireSubmit", data.requireSubmit);
  const extraFields = extraFieldsJson(data.extraFields);
  if (extraFields != null) {
    parts.push(`"extraFields":${extraFields}`);
  }
  return `{${parts.join(",")}}`;
}

function pushJsonStringList(parts: string[], key: string, values: string[] | null): void {
  if (values == null) {
    return;
  }
  const items: string[] = [];
  for (let i = 0; i < values.length; i++) {
    items.push(`${JSON.stringify(values[i])}`);
  }
  parts.push(`"${key}":[${items.join(",")}]`);
}

/** 我的日程查询请求体。null 字段不提交。 */
function buildCalendarEventQueryBody(data: CalendarEventQueryReq): string {
  const parts: string[] = [];
  pushJsonString(parts, "beginTime", data.beginTime);
  pushJsonString(parts, "endTime", data.endTime);
  pushJsonString(parts, "category", data.category);
  pushJsonStringList(parts, "statuses", data.statuses);
  pushJsonString(parts, "keyword", data.keyword);
  pushJsonInt64(parts, "groupConvId", data.groupConvId);
  return `{${parts.join(",")}}`;
}

/** 联系人工作日程查询请求体。null 字段不提交。 */
function buildCalendarContactQueryBody(data: CalendarContactQueryReq): string {
  const parts: string[] = [];
  pushJsonString(parts, "beginTime", data.beginTime);
  pushJsonString(parts, "endTime", data.endTime);
  pushJsonString(parts, "category", data.category);
  pushJsonStringList(parts, "statuses", data.statuses);
  pushJsonString(parts, "keyword", data.keyword);
  pushJsonInt64(parts, "contactUserId", data.contactUserId);
  return `{${parts.join(",")}}`;
}

/** 忙闲查询请求体。null 字段不提交。 */
function buildCalendarBusyQueryBody(data: CalendarBusyQueryReq): string {
  const parts: string[] = [];
  pushJsonInt64(parts, "contactUserId", data.contactUserId);
  pushJsonString(parts, "beginTime", data.beginTime);
  pushJsonString(parts, "endTime", data.endTime);
  return `{${parts.join(",")}}`;
}

/** 参与人完成份额请求体。null 字段不提交。 */
function buildCalendarParticipantCompleteBody(data: CalendarParticipantCompleteReq): string {
  const parts: string[] = [];
  pushJsonInt64(parts, "eventId", data.eventId);
  pushJsonString(parts, "fileKey", data.fileKey);
  return `{${parts.join(",")}}`;
}

/** 参与人操作请求体。null 字段不提交。 */
function buildCalendarParticipantOpBody(data: CalendarParticipantOpReq): string {
  const parts: string[] = [];
  pushJsonInt64(parts, "eventId", data.eventId);
  pushJsonInt64(parts, "userId", data.userId);
  pushJsonString(parts, "role", data.role);
  pushJsonString(parts, "replyStatus", data.replyStatus);
  return `{${parts.join(",")}}`;
}

/**
 * 创建日程 / 待办。可同时按人邀请和按群邀请。
 * @param data 要创建的字段；不需要的字段保持 null
 * @returns 创建后的日程。业务成功码为 0000，id 与 creatorId 按字符串读取
 */
export async function apiCalendarCreate(data: CalendarEventCreateDto): Promise<RequestResponse<CalendarEventDto>> {
  return await request({
    url: "/api/calendar/create",
    method: "POST",
    data: buildCalendarEventCreateBody(data),
  });
}

/**
 * 更新日程 / 待办。
 * @param data 只填需要修改的字段；其余保持 null
 * @returns 更新后的日程。业务成功码为 0000，data 运行时为 UTSJSONObject
 */
export async function apiCalendarUpdate(data: CalendarEventUpdateDto): Promise<RequestResponse<CalendarEventDto>> {
  return await request({
    url: "/api/calendar/update",
    method: "POST",
    data: buildCalendarEventUpdateBody(data),
  });
}

/**
 * 重新打开日程 / 待办。
 * @param data 事件 ID
 * @returns 重新打开后的日程，结构与更新接口的 data 相同
 */
export async function apiCalendarReopen(data: CalendarIdReq): Promise<RequestResponse<CalendarEventDto>> {
  return await request({
    url: "/api/calendar/reopen",
    method: "POST",
    data: buildCalendarIdBody(data.id),
  });
}

/**
 * 一键完成日程 / 待办。仅创建者可调用，直接把整体置为完成，不等参与人逐人完成。
 * @param data 事件 ID
 * @returns 完成后的日程。业务成功码为 0000，id 与 creatorId 按字符串读取
 */
export async function apiCalendarForceComplete(data: CalendarIdReq): Promise<RequestResponse<CalendarEventDto>> {
  return await request({
    url: "/api/calendar/force-complete",
    method: "POST",
    data: buildCalendarIdBody(data.id),
  });
}

/**
 * 日程详情，含参与人列表与回复状态。
 * @param data 事件 ID
 * @returns 日程详情。业务成功码为 0000，id、creatorId、参与人 userId 按字符串读取
 */
export async function apiCalendarDetail(data: CalendarIdReq): Promise<RequestResponse<CalendarEventDto>> {
  return await request({
    url: "/api/calendar/detail",
    method: "POST",
    data: buildCalendarIdBody(data.id),
  });
}

/**
 * 删除日程。
 * @param data 事件 ID
 * @returns data 为是否成功。业务成功码为 0000，运行时用 apiResData 读取
 */
export async function apiCalendarDelete(data: CalendarIdReq): Promise<RequestResponse<boolean>> {
  return await request({
    url: "/api/calendar/delete",
    method: "POST",
    data: buildCalendarIdBody(data.id),
  });
}

/**
 * 取消日程。
 * @param data 事件 ID
 * @returns 取消后的日程。业务成功码为 0000，id 与 creatorId 按字符串读取
 */
export async function apiCalendarCancel(data: CalendarIdReq): Promise<RequestResponse<CalendarEventDto>> {
  return await request({
    url: "/api/calendar/cancel",
    method: "POST",
    data: buildCalendarIdBody(data.id),
  });
}

/**
 * 变更参与人角色。仅创建者可调用，角色在 EDITOR 与 VIEWER 之间切换。
 * @param data 事件 ID、参与人用户 ID、目标角色
 * @returns data 为是否成功。业务成功码为 0000，运行时用 apiResData 读取
 */
export async function apiCalendarParticipantRole(data: CalendarParticipantOpReq): Promise<RequestResponse<boolean>> {
  return await request({
    url: "/api/calendar/participant/role",
    method: "POST",
    data: buildCalendarParticipantOpBody(data),
  });
}

/**
 * 回复日程邀请。replyStatus 可用值 NEED_ACTION、ACCEPTED、TENTATIVE、REFUSED。
 * 拒绝后服务端不再发送该日程的提醒。
 * @param data 事件 ID、参与人用户 ID、回复状态
 * @returns data 为是否成功。业务成功码为 0000，运行时用 apiResData 读取
 */
export async function apiCalendarParticipantReply(data: CalendarParticipantOpReq): Promise<RequestResponse<boolean>> {
  return await request({
    url: "/api/calendar/participant/reply",
    method: "POST",
    data: buildCalendarParticipantOpBody(data),
  });
}

/**
 * 移除参与人。仅创建者可调用。
 * @param data 事件 ID、被移除的参与人用户 ID
 * @returns data 为是否成功。业务成功码为 0000，运行时用 apiResData 读取
 */
export async function apiCalendarParticipantRemove(data: CalendarParticipantOpReq): Promise<RequestResponse<boolean>> {
  return await request({
    url: "/api/calendar/participant/remove",
    method: "POST",
    data: buildCalendarParticipantOpBody(data),
  });
}

/**
 * 邀请参与人。仅创建者可调用，且限同租户用户。
 * 可按 participants 逐人邀请，也可按 inviteGroupConvIds 整群邀请。
 * @param data 事件 ID、被邀请人、群会话 ID
 * @returns data 为参与人列表。业务成功码为 0000，userId 按字符串读取
 */
export async function apiCalendarParticipantInvite(data: CalendarInviteReq): Promise<RequestResponse<CalendarParticipantDto[]>> {
  return await request({
    url: "/api/calendar/participant/invite",
    method: "POST",
    data: buildCalendarInviteBody(data),
  });
}

/**
 * 参与人完成自己的份额。
 * 多人待办由服务端按完成模式判定整体是否完成。日程开启 requireSubmit 时必须传 fileKey。
 * @param data 事件 ID、完成时提交的文件 key
 * @returns data 为是否成功。业务成功码为 0000，运行时用 apiResData 读取
 */
export async function apiCalendarParticipantComplete(data: CalendarParticipantCompleteReq): Promise<RequestResponse<boolean>> {
  return await request({
    url: "/api/calendar/participant/complete",
    method: "POST",
    data: buildCalendarParticipantCompleteBody(data),
  });
}

/**
 * 我的日程 / 待办列表。
 * 传 beginTime 与 endTime 时按日历窗口查询；都不传时返回未完成全量，以及前后 90 天内已完成的日程。
 * @param data 时间范围、分类、状态、关键词。不需要的字段保持 null
 * @returns data 为日程列表。业务成功码为 0000，id 与 creatorId 按字符串读取
 */
export async function apiCalendarListMy(data: CalendarEventQueryReq): Promise<RequestResponse<CalendarEventDto[]>> {
  return await request({
    url: "/api/calendar/list/my",
    method: "POST",
    data: buildCalendarEventQueryBody(data),
  });
}

/**
 * 我创建的日程 / 待办列表。只返回当前用户创建的记录。
 * @param data 时间范围、分类、状态、关键词、群会话 ID。不需要的字段保持 null
 * @returns data 为日程列表。业务成功码为 0000，id、creatorId、groupConvId 按字符串读取
 */
export async function apiCalendarListMyCreated(data: CalendarEventQueryReq): Promise<RequestResponse<CalendarEventDto[]>> {
  return await request({
    url: "/api/calendar/list-my-created",
    method: "POST",
    data: buildCalendarEventQueryBody(data),
  });
}

/**
 * 我参与的日程 / 待办列表。我创建但参与人里没有自己的记录不返回。
 * @param data 时间范围、分类、状态、关键词、群会话 ID。不需要的字段保持 null
 * @returns data 为日程列表。业务成功码为 0000，id、creatorId、groupConvId 按字符串读取
 */
export async function apiCalendarListMyParticipated(data: CalendarEventQueryReq): Promise<RequestResponse<CalendarEventDto[]>> {
  return await request({
    url: "/api/calendar/list-my-participated",
    method: "POST",
    data: buildCalendarEventQueryBody(data),
  });
}

/**
 * 群待办列表。按来源群查全部，调用人须为该群成员。
 * @param data 群会话 ID 必填；时间范围、分类、状态、关键词不需要时保持 null
 * @returns data 为日程列表。业务成功码为 0000，id、creatorId、groupConvId 按字符串读取
 */
export async function apiCalendarListByGroup(data: CalendarEventQueryReq): Promise<RequestResponse<CalendarEventDto[]>> {
  return await request({
    url: "/api/calendar/list-by-group",
    method: "POST",
    data: buildCalendarEventQueryBody(data),
  });
}

/**
 * 联系人的工作日程，包含其参与的日程。服务端校验好友关系。
 * @param data 联系人用户 ID、时间范围、分类、状态、关键词。不需要的字段保持 null
 * @returns data 为日程列表。业务成功码为 0000，id 与 creatorId 按字符串读取
 */
export async function apiCalendarListContact(data: CalendarContactQueryReq): Promise<RequestResponse<CalendarEventDto[]>> {
  return await request({
    url: "/api/calendar/list/contact",
    method: "POST",
    data: buildCalendarContactQueryBody(data),
  });
}

/**
 * 忙闲查询。不传 contactUserId 时查自己，传入时查该联系人。
 * 返回进行中工作日程的忙碌时段，包含其参与的日程。
 * @param data 联系人用户 ID、时间范围。不需要的字段保持 null
 * @returns data 为忙碌时段列表。业务成功码为 0000
 */
export async function apiCalendarBusy(data: CalendarBusyQueryReq): Promise<RequestResponse<CalendarBusySlotDto[]>> {
  return await request({
    url: "/api/calendar/busy",
    method: "POST",
    data: buildCalendarBusyQueryBody(data),
  });
}

/**
 * 我的待回复邀请列表。无请求参数。
 * @returns data 为邀请列表。业务成功码为 0000，event 内的 id 与 creatorId 按字符串读取
 */
export async function apiCalendarInvitationMy(): Promise<RequestResponse<CalendarInvitationDto[]>> {
  const header = new UTSJSONObject();
  header["Content-Type"] = "application/x-www-form-urlencoded";
  return await request({
    url: "/api/calendar/invitation/my",
    method: "POST",
    data: "",
    header: header,
  });
}
