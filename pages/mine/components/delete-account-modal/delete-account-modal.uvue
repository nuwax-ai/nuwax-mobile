<template>
  <!--
    注销账号确认弹窗。
    风格对齐项目内系统弹窗（uni.showModal）：白色圆角面板、居中标题、底部分割线双按钮；
    在此基础上加一个输入框，要求手动输入确认短语，构成双重确认。
    未用 uni.showModal 的 editable：该模式下 content 会变成输入框初始内容，无法同时展示说明文案。
  -->
  <view v-if="visible" class="delete-account-modal__mask" @tap="cancel">
    <view class="delete-account-modal__panel" @tap.stop>
      <text class="delete-account-modal__title">{{ t("Mobile.Header.deleteAccount") }}</text>
      <view class="delete-account-modal__body">
        <text class="delete-account-modal__desc">{{ desc }}</text>
        <input
          class="delete-account-modal__input"
          v-model="inputValue"
          :placeholder="phrase"
          placeholder-class="delete-account-modal__placeholder"
          :maxlength="40"
          confirm-type="done"
          @confirm="confirm"
        />
        <text v-if="errorText.length > 0" class="delete-account-modal__error">{{ errorText }}</text>
      </view>
      <view class="delete-account-modal__actions">
        <view class="delete-account-modal__btn delete-account-modal__btn--cancel" @tap="cancel">
          <text class="delete-account-modal__btn-text">{{ t("Mobile.Common.cancel") }}</text>
        </view>
        <view class="delete-account-modal__btn" @tap="confirm">
          <text class="delete-account-modal__btn-text delete-account-modal__btn-text--danger">{{
            t("Mobile.Header.deleteAccountConfirmBtn")
          }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { emptyI18nParams, toI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** UTS 兼容：带 phrase 插值的翻译 */
  const tPhrase = (key: string, value: string): string => {
    const m = new Map<string, string | number>();
    m.set("phrase", value);
    return translateFn(key, toI18nParams(m), "");
  };

  const emit = defineEmits<{
    confirm: [];
    cancel: [];
  }>();

  const visible = ref(false);
  const inputValue = ref("");
  const errorText = ref("");

  /** 需要用户手动输入的确认短语；词条缺失时退回按钮文案，保证展示与校验取同一个值 */
  const phrase = computed((): string => {
    const value = t("Mobile.Header.deleteAccountConfirmPhrase");
    return value.length > 0 && value.indexOf("Mobile.") != 0
      ? value
      : t("Mobile.Header.deleteAccountConfirmBtn");
  });

  /** 说明文案：后果告知 + 输入要求（{phrase} 插值当前语言的确认短语） */
  const desc = computed((): string => {
    return tPhrase("Mobile.Header.deleteAccountConfirm", phrase.value);
  });

  /** 归一化：去首尾空白、去空格（含全角）、统一小写，避免大小写/空格导致误判 */
  const normalize = (value: string): string => {
    return value.trim().replaceAll(" ", "").replaceAll("　", "").toLowerCase();
  };

  function open(): void {
    inputValue.value = "";
    errorText.value = "";
    visible.value = true;
  }

  function close(): void {
    visible.value = false;
    inputValue.value = "";
    errorText.value = "";
  }

  /** 用户主动取消（点遮罩或「取消」）：关闭并通知宿主（dialogPage 需要据此关闭自身） */
  function cancel(): void {
    close();
    emit("cancel");
  }

  /** 输入与确认短语一致才向外抛 confirm，由页面执行注销 */
  function confirm(): void {
    const expected = phrase.value;
    const input = normalize(inputValue.value);
    if (input.length == 0 || input != normalize(expected)) {
      errorText.value = tPhrase("Mobile.Header.deleteAccountTypeMismatch", expected);
      return;
    }
    close();
    emit("confirm");
  }

  defineExpose({ open, close });
</script>

<style lang="scss" scoped>
  .delete-account-modal__mask {
    position: fixed;
    z-index: 1000;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .delete-account-modal__panel {
    width: 600rpx;
    box-sizing: border-box;
    background-color: #ffffff;
    border-radius: 24rpx;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .delete-account-modal__title {
    font-size: 32rpx;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 44rpx;
    text-align: center;
    margin-top: 44rpx;
  }

  .delete-account-modal__body {
    display: flex;
    flex-direction: column;
    padding: 24rpx 40rpx 40rpx;
  }

  .delete-account-modal__desc {
    font-size: 28rpx;
    color: #666666;
    line-height: 44rpx;
  }

  .delete-account-modal__input {
    box-sizing: border-box;
    width: 100%;
    height: 80rpx;
    margin-top: 28rpx;
    padding: 0 24rpx;
    border: 2rpx solid #e5e6eb;
    border-radius: 12rpx;
    background-color: #f7f8fa;
    font-size: 28rpx;
    color: #1a1a1a;
  }

  .delete-account-modal__placeholder {
    color: #b0b0b0;
    font-size: 28rpx;
  }

  .delete-account-modal__error {
    font-size: 24rpx;
    color: #fa5151;
    line-height: 36rpx;
    margin-top: 12rpx;
  }

  .delete-account-modal__actions {
    display: flex;
    flex-direction: row;
    border-top: 2rpx solid #f0f0f0;
  }

  .delete-account-modal__btn {
    flex: 1;
    height: 100rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .delete-account-modal__btn--cancel {
    border-right: 2rpx solid #f0f0f0;
  }

  .delete-account-modal__btn-text {
    font-size: 32rpx;
    color: #1a1a1a;
  }

  .delete-account-modal__btn-text--danger {
    color: #fa5151;
  }
</style>
