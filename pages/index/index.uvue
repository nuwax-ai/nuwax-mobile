    box-sizing: border-box;
    border-bottom: 2rpx solid #ececef;
  }

  .create-hub__guide-item--last {
    border-bottom-width: 0;
  }

  .create-hub__guide-arrow {
    flex-shrink: 0;
    margin-left: 16rpx;
