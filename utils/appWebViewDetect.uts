/**
 * App web-view 内嵌检测（无业务依赖，供鉴权 / 系统工具共用，避免循环引用）。
 */

/** 聊天页 / 鉴权引导确认内嵌后写入；整页 replace 后仍在，供首屏 Bearer 判断。 */
const APP_WEBVIEW_FLAG_KEY: string = "__nuwax_app_webview";

/**
 * 持久化「当前页在 App web-view 内」标记。
 * 桥全局在 iOS 上常晚于首批接口；有此标记后 isAppWebViewEmbedded 立即为 true。
 */
export function persistAppWebViewEmbeddedFlag(): void {
  // #ifdef H5 || WEB
  try {
    const w = window as any;
    if (w != null && w.sessionStorage != null) {
      w.sessionStorage.setItem(APP_WEBVIEW_FLAG_KEY, "1");
    }
  } catch (_e) {
    // ignore
  }
  // #endif
}

/**
 * 是否处于 App web-view 内嵌 H5。
 * 仅 H5/WEB 有 window；其它端恒 false。
 * 桥全局 + sessionStorage 标记（桥偏晚时仍能给请求加 Bearer）。
 */
export function isAppWebViewEmbedded(): boolean {
  // #ifdef H5 || WEB
  try {
    const w = window as any;
    if (w == null) {
      return false;
    }
    if (w.__uniapp_x_postMessage != null || w.__uniapp_x_ != null) {
      return true;
    }
    if (w.__dcloud_weex_postMessage != null || w.__dcloud_weex_ != null) {
      return true;
    }
    const uniGlobal = w.uni;
    if (uniGlobal != null && uniGlobal.webView != null) {
      return true;
    }
    if (w.sessionStorage != null) {
      const flag = w.sessionStorage.getItem(APP_WEBVIEW_FLAG_KEY);
      if (flag == "1") {
        return true;
      }
    }
  } catch (_e) {
    // ignore
  }
  // #endif
  return false;
}

/**
 * App 内嵌 H5 的宿主平台：ios / android / harmony。
 * 优先壳注入的 __nuwaxKbPlatform；桥未就绪时才用 UA 兜底（规范主体仍看请求头）。
 */
export function readAppWebViewHostPlatform(): string {
  // #ifdef H5 || WEB
  try {
    const w = window as any;
    if (w != null && w.__nuwaxKbPlatform != null) {
      const platform = `${w.__nuwaxKbPlatform}`;
      if (platform == "ios" || platform == "android" || platform == "harmony") {
        return platform;
      }
    }
    if (w != null && w.navigator != null) {
      const ua = `${w.navigator.userAgent}`.toLowerCase();
      if (
        ua.indexOf("iphone") >= 0 ||
        ua.indexOf("ipad") >= 0 ||
        ua.indexOf("ipod") >= 0
      ) {
        return "ios";
      }
      if (ua.indexOf("android") >= 0) {
        return "android";
      }
      if (
        ua.indexOf("harmony") >= 0 ||
        ua.indexOf("openharmony") >= 0 ||
        ua.indexOf("arkweb") >= 0
      ) {
        return "harmony";
      }
    }
  } catch (_e) {
    // ignore
  }
  // #endif
  return "";
}

/**
 * 是否处于「iOS 常驻壳」内嵌 H5（Android / 鸿蒙 / 浏览器直开恒 false）。
 * 同一份 H5 构建同时服务 iOS 常驻壳与 Android/鸿蒙独立页壳，编译期无法用
 * #ifdef APP-IOS 区分运行宿主，只能靠壳注入的键盘平台标记（__nuwaxKbPlatform）。
 */
export function isIosAppWebView(): boolean {
  // #ifdef H5 || WEB
  if (isAppWebViewEmbedded() != true) {
    return false;
  }
  return readAppWebViewHostPlatform() == "ios";
  // #endif
  return false;
}

/**
 * 统一识别头 X-Client-Type（全部 HTTP 链路只看此头，不依赖 UA）。
 * 原生 App：ios / android / harmony；微信小程序：mp-weixin；
 * 浏览器直开 H5：h5；App 内嵌 H5：与宿主一致（ios / android / harmony）。
 */
export function resolveXClientType(): string {
  // #ifdef APP-IOS
  return "ios";
  // #endif
  // #ifdef APP-ANDROID
  return "android";
  // #endif
  // #ifdef APP-HARMONY
  return "harmony";
  // #endif
  // #ifdef MP-WEIXIN
  return "mp-weixin";
  // #endif
  // #ifdef H5 || WEB
  if (isAppWebViewEmbedded() == true) {
    const host = readAppWebViewHostPlatform();
    if (host == "ios" || host == "android" || host == "harmony") {
      return host;
    }
  }
  return "h5";
  // #endif
  return "";
}

export function applyXClientTypeHeader(header: UTSJSONObject): void {
  const clientType = resolveXClientType();
  if (clientType.length > 0) {
    header["X-Client-Type"] = clientType;
  }
}

/**
 * 从 hash query 读取常驻壳写入的 accessToken（仅 token 本身，不含路径）。
 * URL 形态：`#/subpackages/pages/agent-detail/...?id=1&accessToken=<token>`
 * 按 `&` 拆段，绝不把 `#/...` 路径拼进 token。
 */
export function readAccessTokenFromHashQuery(): string {
  // #ifdef H5 || WEB
  try {
    const hash = window.location.hash;
    if (hash == null) {
      return "";
    }
    const hashStr = `${hash}`;
    const qIdx = hashStr.indexOf("?");
    if (qIdx < 0) {
      return "";
    }
    const query = hashStr.substring(qIdx + 1);
    const parts = query.split("&");
    if (parts == null) {
      return "";
    }
    for (let i = 0; i < parts.length; i++) {
      const part = parts[i];
      if (part.indexOf("accessToken=") != 0) {
        continue;
      }
      const raw = part.substring("accessToken=".length);
      if (raw.length == 0) {
        return "";
      }
      let token = raw;
      try {
        const decoded = decodeURIComponent(raw);
        if (decoded != null && `${decoded}`.length > 0) {
          token = `${decoded}`;
        }
      } catch (_d) {
        token = raw;
      }
      return token;
    }
  } catch (_e) {
    // ignore
  }
  // #endif
  return "";
}
