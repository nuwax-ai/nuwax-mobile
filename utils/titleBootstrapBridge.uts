import { captureDrawerTitleContext } from "@/utils/drawerTitleSync";
import { postAppWebViewMessage } from "@/utils/system";

// 只向明确支持后台命名的宿主委托；普通 H5、旧宿主仍在本运行时执行。
function readNativeBootstrapCapability(): boolean {
  // #ifdef H5 || WEB
  try {
    const query = window.location.hash.split("?").slice(1).join("?");
    return new URLSearchParams(query).get("drawerTitleBootstrap") == "1";
  } catch (_error) {}
  // #endif
  return false;
}
let nativeBootstrapCapability = readNativeBootstrapCapability();

/** 交给 App 运行时，退出详情销毁 WebView 后仍能完成写回和重试。 */
export function delegateTitleBootstrap(kind: string, id: number, prompt: string, projectType: string): boolean {
  if (readNativeBootstrapCapability()) nativeBootstrapCapability = true;
  if (!nativeBootstrapCapability) return false;
  const context = captureDrawerTitleContext();
  if (context.scope.length == 0) return false;
  return postAppWebViewMessage({
    type: "app-title-bootstrap", kind: kind, id: id, prompt: prompt,
    projectType: projectType, scopeKey: context.scope,
  });
}
