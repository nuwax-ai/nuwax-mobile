  }

  .group-sheet__input {
    height: 80rpx;
    padding: 0 24rpx;
    border-radius: 20rpx;
    background-color: #f6f5f8;
    font-size: 28rpx;
    color: #1c1b20;
  }

  .group-sheet__search {
    height: 80rpx;
    padding: 0 8rpx 0 24rpx;
    border-radius: 20rpx;
    background-color: #f6f5f8;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .group-sheet__search-input {
    flex: 1;
    height: 80rpx;
    font-size: 28rpx;
