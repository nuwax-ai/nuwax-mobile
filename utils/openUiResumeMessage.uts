/**
 * 把 OpenUI onAction 事件转成「续作用户消息」（对齐 PC Web 的
 * src/components/business-component/OpenUiArtifactView/openUiResumeMessage.ts）。
 * 概要行（humanFriendlyMessage，转第一人称）+ 各字段 `字段：值` 行。
 * UTS（编译到 Kotlin）：参照 utils/openUiSchema.uts 的 asRecord / UTSJSONObject.keys 模式，
 * 可空值先判空再用。
 */
import { orEmpty } from "@/utils/utsCoalesce";

function asRecord(value: any | null): UTSJSONObject | null {
  if (value == null || typeof value != "object") return null;
  if (Array.isArray(value)) return null;
  try {
    return value as UTSJSONObject;
  } catch (_e) {
    return null;
  }
}

/** 解包控件值（{value: ...} 链），上限 8 层避免循环。 */
function unwrapControlValue(value: any | null): any | null {
  let current: any | null = value;
  let depth = 0;
  while (
    current != null &&
    typeof current == "object" &&
    Array.isArray(current) == false &&
    depth < 8
  ) {
    const rec = asRecord(current);
    if (rec == null) break;
    const inner = rec["value"];
    if (inner == null) break;
    current = inner;
    depth += 1;
  }
  return current;
}

function formatDisplayValue(value: any | null): string {
  const current = unwrapControlValue(value);
  if (current == null) return "null";
  if (Array.isArray(current)) {
    const arr = current as any[];
    const parts: string[] = [];
    for (let i = 0; i < arr.length; i++) {
      parts.push(formatDisplayValue(arr[i]));
    }
    return parts.join("、");
  }
  if (typeof current == "object") {
    const rec = asRecord(current);
    if (rec != null) {
      const keys = UTSJSONObject.keys(rec);
      const parts: string[] = [];
      for (let i = 0; i < keys.length; i++) {
        parts.push(`${keys[i]}：${formatDisplayValue(rec[keys[i]])}`);
      }
      return parts.join("，");
    }
    return `${current}`;
  }
  return `${current}`;
}

/** 对齐 PC flattenActionValues：嵌套对象使用 `parent.child：value` 独立成行。 */
function appendValueLines(
  record: UTSJSONObject,
  prefix: string,
  lines: string[],
): void {
  const keys = UTSJSONObject.keys(record);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const fieldName = prefix.length > 0 ? `${prefix}.${key}` : key;
    const value = unwrapControlValue(record[key]);
    const nested = asRecord(value);
    if (nested != null && UTSJSONObject.keys(nested).length > 0) {
      appendValueLines(nested, fieldName, lines);
    } else {
      lines.push(`${fieldName}：${formatDisplayValue(value)}`);
    }
  }
}

/**
 * @param action runtime OPENUI_ACTION 的 event 对象（含 values/formName/humanFriendlyMessage）
 * @param fallbackTitle humanFriendlyMessage 缺失时的概要兜底标题
 */
export function buildOpenUiResumeMessage(
  action: UTSJSONObject,
  fallbackTitle: string,
): string {
  let summary = orEmpty(action["humanFriendlyMessage"]).trim();
  // 第一人称化（与 PC Web normalizeUserPerspective 一致）
  if (summary.startsWith("用户已提交")) {
    summary = "我已提交" + summary.substring(5);
  } else if (summary.startsWith("用户提交")) {
    summary = "我提交" + summary.substring(4);
  }
  if (summary.length == 0) {
    summary = `${fallbackTitle} 表单已提交`;
  }

  const lines: string[] = [summary];
  const formName = orEmpty(action["formName"]);
  let formValues: UTSJSONObject | null = asRecord(action["values"]);
  if (formName.length > 0) {
    const nested = asRecord(formValues == null ? null : formValues[formName]);
    if (nested != null) formValues = nested;
  }
  if (formValues != null) {
    appendValueLines(formValues, "", lines);
  }
  return lines.join("\n");
}
