<template>
  <view class="container relative flex flex-col">
    <!-- 顶部导航栏 -->
    <custom-nav-bar :title="deviceName" className="border-b" hasSafetyZone showBack />

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <!-- 头部 -->
      <view class="detail-header">
        <view :class="['detail-icon', isLingzhu ? '' : 'detail-icon-computer']">
          <text class="detail-icon-emoji">{{ isLingzhu ? "🔮" : "💻" }}</text>
        </view>
        <text class="detail-name">{{ deviceName }}</text>
        <view class="detail-status">
          <text class="detail-status-text">{{ isLingzhu ? t("Mobile.Terminal.lingzhuTerminal") : t("Mobile.Terminal.computerTerminal") }} · {{ deviceOnline ? t("Mobile.Terminal.connected") : t("Mobile.Terminal.disconnected") }}</text>
          <!-- 灵珠快捷入口：对话 / 组员管理 -->
          <template v-if="isLingzhu">
            <view :class="['quick-btn', quickBtnDisabled ? 'quick-btn-disabled' : '']" @click="handleOpenChat">
              <text class="quick-btn-emoji">💬</text>
            </view>
            <view :class="['quick-btn', quickBtnDisabled ? 'quick-btn-disabled' : '']" @click="handleGroupMembers">
              <text class="quick-btn-emoji">👥</text>
            </view>
          </template>
        </view>
      </view>

      <!-- 名称 -->
      <view class="field-label">{{ isLingzhu ? t("Mobile.Terminal.deviceName") : t("Mobile.Terminal.computerName") }}</view>
      <view class="field-input-box">
        <input class="field-input" v-model="editName" placeholder="" placeholder-class="field-placeholder" @blur="handleNameChange" />
      </view>
      <text v-if="isLingzhu" class="field-tip">{{ t("Mobile.Terminal.wakeTip") }}</text>

      <!-- ===== 灵珠专属：模式选择 ===== -->
      <template v-if="isLingzhu">
        <view class="field-label">{{ t("Mobile.Terminal.modeSelect") }}</view>
        <view class="mode-row">
          <view
            v-for="mode in modeList"
            :key="mode.key"
            :class="['mode-btn', activeMode == mode.key ? 'mode-btn-on' : '']"
            @click="handleModeSwitch(mode.key)"
          >
            <text :class="['mode-btn-text', activeMode == mode.key ? 'mode-btn-text-on' : '']">{{ mode.label }}</text>
          </view>
        </view>

        <!-- 会议记录 / 监控记录入口 -->
        <view class="record-row">
          <view class="record-btn" hover-class="record-btn-active" @click="handleMeetingRecords">
            <text class="record-btn-text">{{ t("Mobile.Terminal.meetingRecords") }}</text>
          </view>
          <view class="record-btn" hover-class="record-btn-active" @click="handleMonitorRecords">
            <text class="record-btn-text">{{ t("Mobile.Terminal.monitorRecords") }}</text>
          </view>
        </view>

        <!-- 对话模式配置 -->
        <template v-if="activeMode == 'chat'">
          <view class="field-label">{{ t("Mobile.Terminal.voiceBroadcast") }}</view>
          <view class="card-group">
            <view class="row-item" hover-class="row-item-active" @click="handleVoiceBroadcastToggle">
              <view class="row-info">
                <text class="row-title">{{ t("Mobile.Terminal.voiceSwitch") }}</text>
                <text class="row-desc">{{ t("Mobile.Terminal.voiceSwitchDesc") }}</text>
              </view>
              <view :class="voiceBroadcastEnabled ? 'pill-on' : 'pill-off'">
                <text :class="voiceBroadcastEnabled ? 'pill-on-text' : 'pill-off-text'">{{ voiceBroadcastEnabled ? t("Mobile.Terminal.switchOn") : t("Mobile.Terminal.switchOff") }}</text>
              </view>
            </view>
            <view class="row-item">
              <view class="row-info">
                <text class="row-title">{{ t("Mobile.Terminal.voiceVolume") }}</text>
              </view>
              <view class="volume-box">
                <text class="volume-label">{{ t("Mobile.Terminal.volumeLow") }}</text>
                <slider
                  class="volume-slider"
                  :value="voiceVolume"
                  :min="0"
                  :max="100"
                  :block-size="14"
                  activeColor="#5147ff"
                  backgroundColor="#e8e8e8"
                  @changing="handleVolumeChanging"
                  @change="handleVolumeChange"
                />
                <text class="volume-label">{{ t("Mobile.Terminal.volumeHigh") }}</text>
              </view>
            </view>
            <view class="row-item" hover-class="row-item-active" @click="handlePickTtsVoice">
              <view class="row-info">
                <text class="row-title">{{ t("Mobile.Terminal.ttsVoice") }}</text>
              </view>
              <text class="tts-current">{{ ttsVoiceName != "" ? ttsVoiceName : t("Mobile.Terminal.ttsVoiceDefault") }}</text>
              <text class="row-arrow">›</text>
            </view>
          </view>
          <!-- 事件表情绑定 -->
          <event-emoji-bind :deviceId="deviceId" />
        </template>

        <!-- 会议模式配置 -->
        <template v-if="activeMode == 'meeting'">
          <view class="field-label">{{ t("Mobile.Terminal.meetingMode") }}</view>
          <view class="card-group">
            <view class="row-item" hover-class="row-item-active" @click="handleMeetingModeToggle">
              <view class="row-info">
                <text class="row-title">{{ t("Mobile.Terminal.meetingMode") }}</text>
                <text class="row-desc">{{ t("Mobile.Terminal.meetingModeDesc") }}</text>
              </view>
              <view :class="meetingModeOn ? 'pill-on' : 'pill-off'">
                <text :class="meetingModeOn ? 'pill-on-text' : 'pill-off-text'">{{ meetingModeOn ? t("Mobile.Terminal.switchOn") : t("Mobile.Terminal.switchOff") }}</text>
              </view>
            </view>
          </view>
          <view class="field-label">{{ t("Mobile.Terminal.meetingPush") }}</view>
          <view class="card-group">
            <view class="row-item" v-for="item in pushChannelList" :key="item.key" hover-class="row-item-active" @click="handlePushChannelToggle(item)">
              <view class="row-info"><text class="row-title">{{ item.label }}</text></view>
              <view :class="item.enabled ? 'pill-on' : 'pill-off'">
                <text :class="item.enabled ? 'pill-on-text' : 'pill-off-text'">{{ item.enabled ? "✓" : "—" }}</text>
              </view>
            </view>
          </view>
          <event-emoji-bind :deviceId="deviceId" />
        </template>

        <!-- 监控模式配置 -->
        <template v-if="activeMode == 'monitor'">
          <view class="field-label">{{ t("Mobile.Terminal.monitorContent") }}</view>
          <view class="card-group">
            <view class="row-item" v-for="item in monitorContentList" :key="item.id" hover-class="row-item-active" @click="handleMonitorContentToggle(item)">
              <view class="row-info">
                <text class="row-title">{{ item.title }}</text>
                <text class="row-desc">{{ item.keywordsText }}</text>
              </view>
              <view :class="item.enabled ? 'pill-on' : 'pill-off'">
                <text :class="item.enabled ? 'pill-on-text' : 'pill-off-text'">{{ item.enabled ? t("Mobile.Terminal.monitoring") : t("Mobile.Terminal.switchOff") }}</text>
              </view>
            </view>
            <view class="row-item" hover-class="row-item-active" @click="handleToggle('添加监控内容')">
              <view class="row-info"><text class="row-title add-text">{{ t("Mobile.Terminal.addMonitorContent") }}</text></view>
            </view>
          </view>
          <view class="field-label">{{ t("Mobile.Terminal.alarmNotify") }}</view>
          <view class="card-group">
            <view class="row-item" hover-class="row-item-active" @click="handleAlarmToggle('app')">
              <view class="row-info"><text class="row-title">{{ t("Mobile.Terminal.alarmChannelApp") }}</text></view>
              <view :class="appAlertEnabled ? 'pill-on' : 'pill-off'">
                <text :class="appAlertEnabled ? 'pill-on-text' : 'pill-off-text'">{{ appAlertEnabled ? "✓" : "—" }}</text>
              </view>
            </view>
            <view class="row-item" hover-class="row-item-active" @click="handleAlarmToggle('sms')">
              <view class="row-info"><text class="row-title">{{ t("Mobile.Terminal.alarmChannelSms") }}</text></view>
              <view :class="smsAlertEnabled ? 'pill-on' : 'pill-off'">
                <text :class="smsAlertEnabled ? 'pill-on-text' : 'pill-off-text'">{{ smsAlertEnabled ? "✓" : "—" }}</text>
              </view>
            </view>
          </view>
          <event-emoji-bind :deviceId="deviceId" />
        </template>
      </template>

      <!-- ===== 我的电脑专属：接入工具 ===== -->
      <template v-else>
        <view class="field-label">{{ t("Mobile.Terminal.accessTools") }}</view>
        <view class="card-group">
          <view class="row-item" v-for="tool in computerTools" :key="tool.name" hover-class="row-item-active" @click="handleToggle(tool.name)">
            <view class="row-avatar">
              <text class="row-avatar-emoji">{{ tool.icon }}</text>
            </view>
            <view class="row-info">
              <text class="row-title">{{ tool.name }}</text>
              <text class="row-desc">{{ tool.desc }}</text>
            </view>
            <text :class="['tool-status', tool.installed ? 'tool-status-on' : '']">{{ tool.installed ? t("Mobile.Terminal.installed") : t("Mobile.Terminal.notInstalled") }}</text>
            <text class="row-arrow">›</text>
          </view>
        </view>
      </template>

      <!-- 重新配网（仅网关已绑定的灵珠设备） -->
      <template v-if="isLingzhu && deviceId != ''">
        <view class="reprovision-btn" hover-class="reprovision-btn-active" @click="handleReprovision">
          <text class="reprovision-btn-text">{{ t("Mobile.Terminal.reprovision") }}</text>
        </view>
      </template>

      <!-- 解绑设备（仅网关已绑定的灵珠设备） -->
      <template v-if="isLingzhu && deviceId != ''">
        <view class="unbind-btn" hover-class="unbind-btn-active" @click="handleUnbind">
          <text class="unbind-btn-text">{{ t("Mobile.Terminal.unbindDevice") }}</text>
        </view>
      </template>

      <view class="bottom-space"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { orEmpty } from "@/utils/utsCoalesce.uts";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import EventEmojiBind from "./components/event-emoji-bind.uvue";
  import {
    apiVoxDeviceDetail,
    apiVoxRenameDevice,
    apiVoxUnbindDevice,
    apiVoxMeetingModeStart,
    apiVoxMeetingModeStop,
    apiVoxUpdateDeviceMode,
    apiVoxGetVoiceSettings,
    apiVoxUpdateVoiceSettings,
    apiVoxGetTtsVoices,
  } from "@/servers/vox/voxDevice";
  import { apiVoxGetPushSettings, apiVoxUpdatePushSettings } from "@/servers/vox/voxPushSettings";
  import { apiVoxGetMonitoringSettings, apiVoxUpdateMonitoringSettings, apiVoxUpdateMonitoringContent } from "@/servers/vox/voxMonitoring";
  import { AppDeviceRenameParams, AppDeviceVoiceSettingsUpdateParams } from "@/types/interfaces/voxDevice";
  import { AppMonitoringSettingsUpdateParams, AppMonitoringContentUpsertParams } from "@/types/interfaces/voxMonitoring";
  import { AppMeetingPushSettingsUpdateParams } from "@/types/interfaces/voxPushSettings";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import { jumpToAgentDetailPage } from "@/utils/commonBusiness";
  import { SUCCESS_CODE } from "@/constants/codes.constants";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // 设备类型 / 标识 / 名称
  const deviceType = ref<string>("lingzhu");
  const deviceId = ref<string>("");
  /** 设备关联的终端智能体 ID（组员管理接口入参）；0 表示尚未关联 */
  const deviceAgentId = ref<number>(0);
  /** 设备当前会话 Id（进会话加载历史用）；接口补齐前 0=未下发，跳转时用本地兜底 */
  const deviceConversationId = ref<number>(0);
  /**
   * ⚠️ 临时硬编码兜底：device 详情接口暂未下发 conversationId（会话 Id），
   * 进会话需要它才能加载历史。接口补齐 conversationId 字段后删除此函数即可
   * （接口值优先，兜底仅在缺省时生效）。注：agentId 由接口下发，不在此兜底。
   * 放顶部：UTS 不允许 const 在使用点之后定义（forward-ref 会编译报错）。
   */
  const tempFallbackConversationId = (id: string): number => {
    if (id == "NX-3927-2693-9288") return 1557344;
    return 0;
  };
  const deviceName = ref<string>("灵珠");
  const editName = ref<string>("灵珠");
  const deviceOnline = ref<boolean>(true);
  const meetingModeOn = ref<boolean>(false);

  // Android UTS：字符串比较用 ==
  const isLingzhu = computed((): boolean => deviceType.value == "lingzhu");

  // 模式：本地 key（chat/meeting/monitor）↔ 后端 enum（CONVERSATION/MEETING/MONITORING）
  const MODE_CHAT = "chat";
  const MODE_MEETING = "meeting";
  const MODE_MONITOR = "monitor";
  const activeMode = ref<string>("chat");
  const toModeEnum = (key: string): string => {
    if (key == MODE_MEETING) return "MEETING";
    if (key == MODE_MONITOR) return "MONITORING";
    return "CONVERSATION";
  };
  const toModeKey = (mode: string): string => {
    if (mode == "MEETING") return MODE_MEETING;
    if (mode == "MONITORING") return MODE_MONITOR;
    return MODE_CHAT;
  };
  class ModeItem {
    key: string = "";
    label: string = "";
    constructor(key: string, label: string) {
      this.key = key;
      this.label = label;
    }
  }
  const modeList = ref<ModeItem[]>([]);

  // 设备详情是否就绪（消除 💬/👥 按钮在拉取完成前的竞态误报）
  const infoReady = ref<boolean>(false);
  const quickBtnDisabled = computed((): boolean => !infoReady.value || deviceAgentId.value <= 0);

  // 语音设置（voiceBroadcastEnabled / volumePercent / ttsVoice）
  const voiceBroadcastEnabled = ref<boolean>(true);
  const voiceVolume = ref<number>(70);
  // 最近一次已落库的音量，用于失败回滚（拖动预览会临时改 voiceVolume）
  const lastPersistedVolume = ref<number>(70);
  // 当前 TTS 音色展示名 + 可选项
  const ttsVoiceName = ref<string>("");
  class TtsVoiceOption {
    voiceId: string = "";
    name: string = "";
    constructor(voiceId: string, name: string) {
      this.voiceId = voiceId;
      this.name = name;
    }
  }
  const ttsVoiceOptions = ref<TtsVoiceOption[]>([]);

  // 会议推送渠道（网关 push-settings）
  class PushChannel {
    key: string = "";
    label: string = "";
    enabled: boolean = false;
    constructor(key: string, label: string, enabled: boolean) {
      this.key = key;
      this.label = label;
      this.enabled = enabled;
    }
  }
  const pushChannelList = ref<PushChannel[]>([]);

  const buildPushChannelList = (
    appEnabled: boolean, emailEnabled: boolean, feishuEnabled: boolean,
    wecomEnabled: boolean, dingtalkEnabled: boolean,
  ) => {
    pushChannelList.value = [
      new PushChannel("appEnabled", t("Mobile.Terminal.pushChannelApp"), appEnabled),
      new PushChannel("emailEnabled", t("Mobile.Terminal.pushChannelEmail"), emailEnabled),
      new PushChannel("feishuEnabled", t("Mobile.Terminal.pushChannelFeishu"), feishuEnabled),
      new PushChannel("wecomEnabled", t("Mobile.Terminal.pushChannelWecom"), wecomEnabled),
      new PushChannel("dingtalkEnabled", t("Mobile.Terminal.pushChannelDingtalk"), dingtalkEnabled),
    ];
  };

  const fetchPushSettings = async () => {
    if (deviceId.value == "") return;
    try {
      const res = await apiVoxGetPushSettings(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          buildPushChannelList(
            d["appEnabled"] != null ? (d["appEnabled"] as boolean) : false,
            d["emailEnabled"] != null ? (d["emailEnabled"] as boolean) : false,
            d["feishuEnabled"] != null ? (d["feishuEnabled"] as boolean) : false,
            d["wecomEnabled"] != null ? (d["wecomEnabled"] as boolean) : false,
            d["dingtalkEnabled"] != null ? (d["dingtalkEnabled"] as boolean) : false,
          );
        }
      } else {
        uni.showToast({ title: t("Mobile.Terminal.pushSettingLoadFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchPushSettings error", e);
      uni.showToast({ title: t("Mobile.Terminal.pushSettingLoadFailed"), icon: "none" });
    }
  };

  // 乐观更新 + 失败回滚
  const handlePushChannelToggle = async (channel: PushChannel) => {
    const next = !channel.enabled;
    channel.enabled = next;
    const params = new AppMeetingPushSettingsUpdateParams();
    if (channel.key == "appEnabled") params.appEnabled = next;
    else if (channel.key == "emailEnabled") params.emailEnabled = next;
    else if (channel.key == "feishuEnabled") params.feishuEnabled = next;
    else if (channel.key == "wecomEnabled") params.wecomEnabled = next;
    else if (channel.key == "dingtalkEnabled") params.dingtalkEnabled = next;
    try {
      const res = await apiVoxUpdatePushSettings(deviceId.value, params);
      if (apiResCode(res) != SUCCESS_CODE) {
        channel.enabled = !next;
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.pushSettingFailed"), icon: "none" });
      }
    } catch (e) {
      channel.enabled = !next;
      console.error("handlePushChannelToggle error", e);
    }
  };

  // 监控内容（来自 /monitoring/settings.contents，启用态可切）
  class MonitorContent {
    id: number = 0;
    title: string = "";
    keywordsText: string = "";
    enabled: boolean = false;
    constructor(id: number, title: string, keywordsText: string, enabled: boolean) {
      this.id = id;
      this.title = title;
      this.keywordsText = keywordsText;
      this.enabled = enabled;
    }
  }
  const monitorContentList = ref<MonitorContent[]>([]);

  // 告警通知（来自 /monitoring/settings）
  const appAlertEnabled = ref<boolean>(false);
  const smsAlertEnabled = ref<boolean>(false);

  const fetchMonitoringSettings = async () => {
    if (deviceId.value == "") return;
    try {
      const res = await apiVoxGetMonitoringSettings(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          const appV = d["appAlertEnabled"];
          appAlertEnabled.value = appV != null ? (appV as boolean) : false;
          const smsV = d["smsAlertEnabled"];
          smsAlertEnabled.value = smsV != null ? (smsV as boolean) : false;
          const contentsVal = d["contents"];
          const arr = contentsVal != null ? (contentsVal as UTSJSONObject[]) : ([] as UTSJSONObject[]);
          const list: MonitorContent[] = [];
          for (let i = 0; i < arr.length; i++) {
            const c = arr[i];
            const idVal = c["id"];
            const titleVal = c["title"];
            const kwVal = c["keywords"];
            const enVal = c["enabled"];
            const kwArr = kwVal != null ? (kwVal as string[]) : ([] as string[]);
            list.push(new MonitorContent(
              idVal != null ? (idVal as number) : 0,
              titleVal != null ? `${titleVal}` : "",
              kwArr.join("、"),
              enVal != null ? (enVal as boolean) : false,
            ));
          }
          monitorContentList.value = list;
        }
      } else {
        uni.showToast({ title: t("Mobile.Terminal.monitorSettingsLoadFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchMonitoringSettings error", e);
      uni.showToast({ title: t("Mobile.Terminal.monitorSettingsLoadFailed"), icon: "none" });
    }
  };

  /** 监控内容启用切换：乐观 + POST /monitoring/contents/{id}/update */
  const handleMonitorContentToggle = async (item: MonitorContent) => {
    if (deviceId.value == "" || item.id <= 0) return;
    const prev = item.enabled;
    item.enabled = !prev;
    const params = new AppMonitoringContentUpsertParams();
    params.enabled = item.enabled;
    try {
      const res = await apiVoxUpdateMonitoringContent(deviceId.value, item.id, params);
      if (apiResCode(res) != SUCCESS_CODE) {
        item.enabled = prev;
        uni.showToast({ title: t("Mobile.Terminal.monitorSettingsUpdateFailed"), icon: "none" });
      }
    } catch (e) {
      item.enabled = prev;
      console.error("handleMonitorContentToggle error", e);
      uni.showToast({ title: t("Mobile.Terminal.monitorSettingsUpdateFailed"), icon: "none" });
    }
  };

  /** 告警渠道切换：乐观 + POST /monitoring/settings/update */
  const handleAlarmToggle = async (key: string) => {
    if (deviceId.value == "") return;
    const isApp = key == "app";
    const next = !(isApp ? appAlertEnabled.value : smsAlertEnabled.value);
    if (isApp) appAlertEnabled.value = next;
    else smsAlertEnabled.value = next;
    const params = new AppMonitoringSettingsUpdateParams();
    if (isApp) params.appAlertEnabled = next;
    else params.smsAlertEnabled = next;
    try {
      const res = await apiVoxUpdateMonitoringSettings(deviceId.value, params);
      if (apiResCode(res) != SUCCESS_CODE) {
        if (isApp) appAlertEnabled.value = !next;
        else smsAlertEnabled.value = !next;
        uni.showToast({ title: t("Mobile.Terminal.monitorSettingsUpdateFailed"), icon: "none" });
      }
    } catch (e) {
      if (isApp) appAlertEnabled.value = !next;
      else smsAlertEnabled.value = !next;
      console.error("handleAlarmToggle error", e);
      uni.showToast({ title: t("Mobile.Terminal.monitorSettingsUpdateFailed"), icon: "none" });
    }
  };

  // 电脑接入工具（静态）
  class ComputerTool {
    name: string = "";
    desc: string = "";
    icon: string = "";
    installed: boolean = false;
    constructor(name: string, desc: string, icon: string, installed: boolean) {
      this.name = name;
      this.desc = desc;
      this.icon = icon;
      this.installed = installed;
    }
  }
  const computerTools = ref<ComputerTool[]>([
    new ComputerTool("nuwaclaw", "命令行终端工具", "⌨️", true),
    new ComputerTool("nuwa-cli", "网页终端工具", "💻", false),
  ]);

  const initModeList = () => {
    modeList.value = [
      new ModeItem("chat", t("Mobile.Terminal.modeChat")),
      new ModeItem("meeting", t("Mobile.Terminal.modeMeeting")),
      new ModeItem("monitor", t("Mobile.Terminal.modeMonitor")),
    ];
  };

  const handleModeSwitch = async (key: string) => {
    // 我的电脑等无 deviceId 场景：仅本地切换
    if (deviceId.value == "" || activeMode.value == key) {
      activeMode.value = key;
      return;
    }
    const prev = activeMode.value;
    activeMode.value = key; // 乐观切换
    try {
      const res = await apiVoxUpdateDeviceMode(deviceId.value, toModeEnum(key));
      if (apiResCode(res) == SUCCESS_CODE) {
        // 用返回的最新设备详情校准 mode / online
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          const modeVal = d["mode"];
          if (modeVal != null) activeMode.value = toModeKey(`${modeVal}`);
          const onlineVal = d["online"];
          if (onlineVal != null) deviceOnline.value = onlineVal as boolean;
        }
      } else {
        activeMode.value = prev;
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.modeSwitchFailed"), icon: "none" });
      }
    } catch (e) {
      activeMode.value = prev;
      console.error("handleModeSwitch error", e);
      uni.showToast({ title: t("Mobile.Terminal.modeSwitchFailed"), icon: "none" });
    }
  };

  /** 音量拖动中实时预览，松手落定并下发 /voice-settings/update（离线由后端拒绝，失败回滚） */
  const readSliderValue = (e: any): number => {
    const detail = (e as UTSJSONObject)["detail"] as UTSJSONObject;
    const val = detail["value"];
    return val != null ? (val as number) : voiceVolume.value;
  };
  const handleVolumeChanging = (e: any) => {
    voiceVolume.value = readSliderValue(e);
  };
  const handleVolumeChange = async (e: any) => {
    const v = readSliderValue(e);
    if (deviceId.value == "") {
      voiceVolume.value = v;
      lastPersistedVolume.value = v;
      return;
    }
    const params = new AppDeviceVoiceSettingsUpdateParams();
    params.volumePercent = v;
    try {
      const res = await apiVoxUpdateVoiceSettings(deviceId.value, params);
      if (apiResCode(res) == SUCCESS_CODE) {
        voiceVolume.value = v;
        lastPersistedVolume.value = v;
      } else {
        voiceVolume.value = lastPersistedVolume.value; // 回滚到上次落库值
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
      }
    } catch (err) {
      voiceVolume.value = lastPersistedVolume.value;
      console.error("handleVolumeChange error", err);
      uni.showToast({ title: t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
    }
  };

  /** 语音播报开关：乐观切换 + 失败回滚 */
  const handleVoiceBroadcastToggle = async () => {
    if (deviceId.value == "") return;
    const next = !voiceBroadcastEnabled.value;
    const prev = voiceBroadcastEnabled.value;
    voiceBroadcastEnabled.value = next;
    const params = new AppDeviceVoiceSettingsUpdateParams();
    params.voiceBroadcastEnabled = next;
    try {
      const res = await apiVoxUpdateVoiceSettings(deviceId.value, params);
      if (apiResCode(res) != SUCCESS_CODE) {
        voiceBroadcastEnabled.value = prev;
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
      }
    } catch (e) {
      voiceBroadcastEnabled.value = prev;
      console.error("handleVoiceBroadcastToggle error", e);
      uni.showToast({ title: t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
    }
  };

  const fetchVoiceSettings = async () => {
    if (deviceId.value == "") return;
    try {
      const res = await apiVoxGetVoiceSettings(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          const vbe = d["voiceBroadcastEnabled"];
          voiceBroadcastEnabled.value = vbe != null ? (vbe as boolean) : true;
          const vp = d["volumePercent"];
          const v = vp != null ? (vp as number) : 70;
          voiceVolume.value = v;
          lastPersistedVolume.value = v;
          const tvn = d["ttsVoiceName"];
          ttsVoiceName.value = tvn != null ? `${tvn}` : "";
        }
      } else {
        uni.showToast({ title: t("Mobile.Terminal.voiceSettingsLoadFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchVoiceSettings error", e);
      uni.showToast({ title: t("Mobile.Terminal.voiceSettingsLoadFailed"), icon: "none" });
    }
  };

  const fetchTtsVoices = async () => {
    try {
      const res = await apiVoxGetTtsVoices();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        const opts: TtsVoiceOption[] = [];
        for (let i = 0; i < arr.length; i++) {
          const vid = arr[i]["voiceId"];
          const nm = arr[i]["name"];
          opts.push(new TtsVoiceOption(
            vid != null ? `${vid}` : "",
            nm != null ? `${nm}` : "",
          ));
        }
        ttsVoiceOptions.value = opts;
      }
    } catch (e) {
      console.error("fetchTtsVoices error", e);
    }
  };

  const applyTtsVoice = async (voiceId: string, label: string) => {
    const prev = ttsVoiceName.value;
    ttsVoiceName.value = voiceId == "" ? t("Mobile.Terminal.ttsVoiceDefault") : label;
    const params = new AppDeviceVoiceSettingsUpdateParams();
    params.ttsVoice = voiceId;
    try {
      const res = await apiVoxUpdateVoiceSettings(deviceId.value, params);
      if (apiResCode(res) != SUCCESS_CODE) {
        ttsVoiceName.value = prev;
        uni.showToast({ title: t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
      }
    } catch (e) {
      ttsVoiceName.value = prev;
      console.error("applyTtsVoice error", e);
      uni.showToast({ title: t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
    }
  };

  /** 选择 TTS 音色：action sheet → POST /voice-settings/update {ttsVoice} */
  const handlePickTtsVoice = () => {
    if (deviceId.value == "" || ttsVoiceOptions.value.length == 0) return;
    const labels: string[] = [];
    const ids: string[] = [];
    for (let i = 0; i < ttsVoiceOptions.value.length; i++) {
      labels.push(ttsVoiceOptions.value[i].name != "" ? ttsVoiceOptions.value[i].name : ttsVoiceOptions.value[i].voiceId);
      ids.push(ttsVoiceOptions.value[i].voiceId);
    }
    labels.push(t("Mobile.Terminal.eventEmojiReset")); // 复用「恢复默认」
    ids.push("");
    uni.showActionSheet({
      itemList: labels,
      success: (res) => {
        const idx = res.tapIndex;
        if (idx < 0 || idx >= ids.length) return;
        applyTtsVoice(ids[idx], labels[idx]);
      },
    });
  };

  const handleNameChange = async () => {
    const newName = editName.value.trim();
    if (newName == "" || newName == deviceName.value) {
      editName.value = deviceName.value;
      return;
    }
    if (deviceId.value == "") {
      // 我的电脑：静态，不支持改名；回退编辑态并提示，避免 UI 显示新名却未落库
      editName.value = deviceName.value;
      uni.showToast({ title: t("Mobile.Terminal.renameNotSupported"), icon: "none" });
      return;
    }
    const params = new AppDeviceRenameParams();
    params.displayName = newName;
    try {
      const res = await apiVoxRenameDevice(deviceId.value, params);
      if (apiResCode(res) == SUCCESS_CODE) {
        deviceName.value = newName;
        uni.showToast({ title: t("Mobile.Terminal.nameUpdated"), icon: "none" });
      } else {
        editName.value = deviceName.value;
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.renameFailed"), icon: "none" });
      }
    } catch (e) {
      editName.value = deviceName.value;
      console.error("handleNameChange error", e);
    }
  };

  const doUnbind = async () => {
    try {
      const res = await apiVoxUnbindDevice(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Terminal.unbindSuccess"), icon: "none" });
        setTimeout(() => {
          uni.navigateBack();
        }, 600);
      } else {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.unbindFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("doUnbind error", e);
    }
  };

  const handleUnbind = () => {
    if (deviceId.value == "") return;
    uni.showModal({
      title: t("Mobile.Terminal.unbindTitle"),
      content: t("Mobile.Terminal.unbindConfirm"),
      confirmText: t("Mobile.Terminal.unbindConfirmBtn"),
      cancelText: t("Mobile.Terminal.unbindCancel"),
      success: function (r) {
        if (r.confirm == true) {
          doUnbind();
        }
      },
    });
  };

  const handleMeetingModeToggle = async () => {
    if (deviceId.value == "") return;
    const next = !meetingModeOn.value;
    try {
      const res = next
        ? await apiVoxMeetingModeStart(deviceId.value)
        : await apiVoxMeetingModeStop(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        meetingModeOn.value = next;
        uni.showToast({ title: next ? t("Mobile.Terminal.meetingModeStarted") : t("Mobile.Terminal.meetingModeStopped"), icon: "none" });
      } else {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.meetingModeFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("handleMeetingModeToggle error", e);
    }
  };

  const handleToggle = (name: string) => {
    uni.showToast({ title: name, icon: "none" });
  };

  const handleOpenChat = () => {
    // 详情未就绪时提示加载中，避免 fetchDeviceInfo 返回前误报"未关联"
    if (!infoReady.value) {
      uni.showToast({ title: t("Mobile.Terminal.loading"), icon: "none" });
      return;
    }
    // 用设备绑定的终端智能体 agentId 进入通用智能体会话详情页（与首页/智联录入口一致）
    if (deviceAgentId.value <= 0) {
      uni.showToast({ title: t("Mobile.Terminal.agentIdMissing"), icon: "none" });
      return;
    }
    // 会话 Id：接口补齐前用本地兜底（NX-3927-2693-9288 → 1557344），带上才能加载历史会话
    const convNum = deviceConversationId.value > 0
      ? deviceConversationId.value
      : tempFallbackConversationId(deviceId.value);
    const convId: number | null = convNum > 0 ? convNum : null;
    jumpToAgentDetailPage(deviceAgentId.value, convId, "ChatBot", deviceName.value);
  };

  const handleGroupMembers = () => {
    if (!infoReady.value) {
      uni.showToast({ title: t("Mobile.Terminal.loading"), icon: "none" });
      return;
    }
    // 组员接口以设备关联的 agentId 为宿主，缺省时拦截进页
    if (deviceAgentId.value <= 0) {
      uni.showToast({ title: t("Mobile.Terminal.agentIdMissing"), icon: "none" });
      return;
    }
    uni.navigateTo({
      url: `/subpackages/pages/terminal/terminal-group-members?agentId=${deviceAgentId.value}`,
    });
  };

  const handleMeetingRecords = () => {
    uni.navigateTo({
      url: `/subpackages/pages/terminal/terminal-meeting-records?deviceId=${encodeURIComponent(deviceId.value)}&name=${encodeURIComponent(deviceName.value)}`,
    });
  };

  const handleMonitorRecords = () => {
    uni.navigateTo({
      url: `/subpackages/pages/terminal/terminal-monitor-records?deviceId=${encodeURIComponent(deviceId.value)}&name=${encodeURIComponent(deviceName.value)}`,
    });
  };

  // 重新配网（换 WiFi）
  const handleReprovision = () => {
    if (deviceId.value == "") return;
    uni.navigateTo({
      url: `/subpackages/pages/provision/provision-entry/provision-entry?deviceId=${encodeURIComponent(deviceId.value)}&name=${encodeURIComponent(deviceName.value)}`,
    });
  };

  const fetchDeviceInfo = async () => {
    if (deviceId.value == "") {
      infoReady.value = true;
      return;
    }
    try {
      const res = await apiVoxDeviceDetail(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          const onlineVal = d["online"];
          deviceOnline.value = onlineVal != null ? (onlineVal as boolean) : false;
          const nameVal = d["displayName"];
          if (nameVal != null && `${nameVal}` != "") {
            deviceName.value = `${nameVal}`;
            editName.value = deviceName.value;
          }
          // 后端下发 agentId，供组员管理等主站配置接口使用
          const agentIdVal = d["agentId"];
          if (agentIdVal != null) {
            const parsed = parseFloat(`${agentIdVal}`);
            deviceAgentId.value = !isNaN(parsed) && parsed > 0 ? parsed as number : 0;
          } else {
            deviceAgentId.value = 0;
          }
          // 会话 Id：接口补齐 conversationId 前为 0（进会话时用 tempFallbackConversationId 兜底）
          const convIdVal = d["conversationId"];
          if (convIdVal != null) {
            const parsedConv = parseFloat(`${convIdVal}`);
            deviceConversationId.value = !isNaN(parsedConv) && parsedConv > 0 ? parsedConv as number : 0;
          } else {
            deviceConversationId.value = 0;
          }
          // 工作模式回显（CONVERSATION/MEETING/MONITORING → chat/meeting/monitor）
          const modeVal = d["mode"];
          if (modeVal != null) activeMode.value = toModeKey(`${modeVal}`);
        }
      } else {
        uni.showToast({ title: t("Mobile.Terminal.fetchDevicesFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchDeviceInfo error", e);
      uni.showToast({ title: t("Mobile.Terminal.fetchDevicesFailed"), icon: "none" });
    }
    infoReady.value = true;
  };

  onLoad((options: any) => {
    if (options != null) {
      const optObj = options as UTSJSONObject;
      const dt = optObj["deviceType"];
      if (dt != null && `${dt}`.length > 0) {
        deviceType.value = `${dt}`;
      }
      const id = optObj["deviceId"];
      if (id != null && `${id}`.length > 0) {
        deviceId.value = orEmpty(decodeURIComponent(`${id}`));
        // 网关绑定设备一律按灵珠处理
        deviceType.value = "lingzhu";
      }
      const nm = optObj["name"];
      if (nm != null && `${nm}`.length > 0) {
        deviceName.value = orEmpty(decodeURIComponent(`${nm}`));
        editName.value = deviceName.value;
      }
    }
    initModeList();
    setCurrentPageNavigationBarTitle();
    if (isLingzhu.value && deviceId.value != "") {
      fetchDeviceInfo();
      fetchPushSettings();
      fetchVoiceSettings();
      fetchTtsVoices();
      fetchMonitoringSettings();
    }
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  /* 头部 */
  .detail-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24rpx 0 16rpx;

    .detail-icon {
      width: 128rpx;
      height: 128rpx;
      border-radius: 32rpx;
      background-color: #5147ff;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16rpx;

      &.detail-icon-computer {
        background-color: #576b95;
      }

      .detail-icon-emoji {
        font-size: 64rpx;
      }
    }

    .detail-name {
      font-size: 36rpx;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 8rpx;
    }

    .detail-status {
      display: flex;
      flex-direction: row;
      align-items: center;

      .detail-status-text {
        font-size: 24rpx;
        color: #666666;
      }

      .quick-btn {
        width: 48rpx;
        height: 48rpx;
        border-radius: 50%;
        background-color: rgba(81, 71, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: 16rpx;

        &.quick-btn-disabled {
          opacity: 0.4;
        }

        .quick-btn-emoji {
          font-size: 24rpx;
        }
      }
    }
  }

  /* 字段 */
  .field-label {
    font-size: 24rpx;
    color: #666666;
    padding: 20rpx 32rpx 12rpx;
  }

  .field-input-box {
    background-color: #ffffff;
    border-radius: 16rpx;
    margin: 0 24rpx;
    padding: 24rpx 32rpx;

    .field-input {
      width: 100%;
      font-size: 32rpx;
      color: #1a1a1a;
    }

    .field-placeholder {
      color: #c0c0c0;
    }
  }

  .field-tip {
    font-size: 22rpx;
    color: #999999;
    padding: 8rpx 32rpx 0;
  }

  /* 模式选择 */
  .mode-row {
    display: flex;
    flex-direction: row;
    margin: 0 24rpx;

    .mode-btn {
      flex: 1;
      padding: 20rpx 0;
      border-radius: 16rpx;
      background-color: #ffffff;
      border: 2rpx solid #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 12rpx;
      transition: border-color 0.2s ease, background-color 0.2s ease;

      &:last-child {
        margin-right: 0;
      }

      &.mode-btn-on {
        border-color: #5147ff;
        background-color: rgba(81, 71, 255, 0.08);
      }

      .mode-btn-text {
        font-size: 26rpx;
        font-weight: 500;
        color: #666666;
        transition: color 0.2s ease;

        &.mode-btn-text-on {
          color: #5147ff;
          font-weight: 600;
        }
      }
    }
  }

  /* 记录入口 */
  .record-row {
    display: flex;
    flex-direction: row;
    margin: 24rpx 24rpx 0;

    .record-btn {
      flex: 1;
      padding: 20rpx 0;
      border-radius: 16rpx;
      background-color: #ffffff;
      border: 2rpx solid #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 16rpx;

      &:last-child {
        margin-right: 0;
      }

      &-active {
        background-color: rgba(12, 20, 102, 0.04);
      }

      .record-btn-text {
        font-size: 26rpx;
        font-weight: 500;
        color: #1a1a1a;
      }
    }
  }

  /* 卡片组 */
  .card-group {
    background-color: #ffffff;
    border-radius: 16rpx;
    margin: 0 24rpx;
    overflow: hidden;
  }

  /* 行项 */
  .row-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 24rpx 32rpx;
    border-bottom: 2rpx solid #f8f8f8;

    &:last-child {
      border-bottom-width: 0;
    }

    &-active {
      background-color: rgba(12, 20, 102, 0.04);
    }

    .row-avatar {
      width: 72rpx;
      height: 72rpx;
      border-radius: 12rpx;
      background-color: #fafafa;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 24rpx;

      .row-avatar-emoji {
        font-size: 36rpx;
      }
    }

    .row-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;

      .row-title {
        font-size: 30rpx;
        font-weight: 500;
        color: #1a1a1a;

        &.add-text {
          color: #5147ff;
        }
      }

      .row-desc {
        font-size: 24rpx;
        color: #666666;
        margin-top: 4rpx;
        line-height: 1.4;
      }
    }

    .tts-current {
      font-size: 26rpx;
      color: #5147ff;
      margin-right: 8rpx;
    }

    .row-arrow {
      font-size: 40rpx;
      color: #c0c0c0;
      font-weight: 300;
      line-height: 1;
      padding-left: 8rpx;
    }

    .pill-on {
      padding: 8rpx 24rpx;
      border-radius: 28rpx;
      background-color: rgba(81, 71, 255, 0.1);

      .pill-on-text {
        font-size: 24rpx;
        color: #5147ff;
        font-weight: 600;
      }
    }

    .pill-off {
      padding: 8rpx 24rpx;
      border-radius: 28rpx;
      background-color: #f0f0f0;

      .pill-off-text {
        font-size: 24rpx;
        color: #999999;
        font-weight: 600;
      }
    }

    .volume-box {
      display: flex;
      flex-direction: row;
      align-items: center;

      .volume-label {
        font-size: 24rpx;
        color: #666666;
      }

      .volume-slider {
        width: 200rpx;
        margin: 0 12rpx;
      }
    }

    .tool-status {
      font-size: 24rpx;
      color: #999999;
      margin-right: 8rpx;

      &.tool-status-on {
        color: #07c160;
      }
    }
  }

  .reprovision-btn {
    margin: 32rpx 24rpx 0;
    padding: 26rpx 0;
    border-radius: 20rpx;
    background-color: rgba(81, 71, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;

    &-active {
      opacity: 0.7;
    }

    .reprovision-btn-text {
      font-size: 30rpx;
      color: #5147ff;
      font-weight: 600;
    }
  }

  .unbind-btn {
    margin: 32rpx 24rpx 0;
    padding: 26rpx 0;
    border-radius: 20rpx;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;

    &-active {
      opacity: 0.7;
    }

    .unbind-btn-text {
      font-size: 30rpx;
      color: #dd524d;
      font-weight: 600;
    }
  }

  .bottom-space {
    height: 40rpx;
  }
</style>
