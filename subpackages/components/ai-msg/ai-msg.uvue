       * - uni-ai-x-msg `.msg-root-paragraph-text`
       * 取值：color #404040、font-size 32rpx、line-height 48rpx(=1.5)
       */
      width: 100%;
    }

    .answer-fallback {
      /* 若使用：须挂在 <text class="answer-fallback">，勿挂 view */
      width: 100%;
      font-size: 32rpx;
      color: #404040;
      line-height: 48rpx;
      white-space: pre-wrap;
    }

    .error-msg {
      color: #ff4d4f;
