// 页面请求结果回写
export async function apiAgentComponentPageResultUpdate(
  data: ApiAgentConversationChatPageResultParams,
): Promise<VoidRequestResponse> {
  const res = await request({
    url: "/api/agent/conversation/chat/page/result",
    method: "POST",
