/**
 * HarmonyOS NEXT ESP 配网 UTS 入口。
 *
 * 导出函数名/参数与 app-android、app-ios 对齐，业务层 EspProvisioningClient 零改动。
 * 蓝牙权限走 ohos.permission.ACCESS_BLUETOOTH；BLE/GATT 在 EspProvisioningBridge.ets。
 */
import type {
  NativeEspDeviceCallback,
  NativeEspFailureCallback,
  NativeEspLogCallback,
  NativeEspProgressCallback,
  NativeEspSuccessCallback,
} from '../interface.uts'
import { getEspProvisioningBridge } from './EspProvisioningBridge.ets'
import { abilityAccessCtrl, Permissions } from '@kit.AbilityKit'
import { BusinessError } from '@kit.BasicServicesKit'

const BT_PERMISSION: Permissions = 'ohos.permission.ACCESS_BLUETOOTH'

function bridge() {
  return getEspProvisioningBridge()
}

/** Harmony 权限回调：authResults[i]==0 表示已授权。 */
function grantOk(data: UTSJSONObject): boolean {
  const results = data['authResults'] as number[] | null
  if (results == null || results.length == 0) {
    return false
  }
  for (let i = 0; i < results.length; i++) {
    if (results[i] != 0) {
      return false
    }
  }
  return true
}

/**
 * 仅申请蓝牙运行时权限（不创建扫描会话）。
 * 供配网入口页预请求，避免与相机权限弹窗叠在一起。
 * @UTSJS.keepAlive：弹窗停留期间回调必须防 GC。
 */
@UTSJS.keepAlive
export function ensureNativeEspPermissions(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  try {
    const context = UTSHarmony.getUIAbilityContext()
    const list: Permissions[] = [BT_PERMISSION]
    abilityAccessCtrl
      .createAtManager()
      .requestPermissionsFromUser(context, list)
      .then((data: UTSJSONObject) => {
        if (!grantOk(data)) {
          fail('NO_PERMISSION', 'Bluetooth permission was not granted')
          return
        }
        success('')
      })
      .catch((e: BusinessError) => {
        fail('NO_PERMISSION', 'requestPermissionsFromUser: ' + e.code + ' ' + e.message)
      })
  } catch (e) {
    fail('UNSUPPORTED', 'Harmony UIAbility context unavailable')
  }
}

/**
 * 申请蓝牙权限后完成初始化。已授权则直接成功。
 */
@UTSJS.keepAlive
export function initializeNativeEspProvisioning(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  ensureNativeEspPermissions(success, fail)
}

@UTSJS.keepAlive
export function setNativeEspLog(cb: NativeEspLogCallback): void {
  bridge().setLog(cb)
}

@UTSJS.keepAlive
export function startNativeEspScan(
  prefix: string,
  serviceUuid: string,
  onDevice: NativeEspDeviceCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().startScan(prefix, serviceUuid, onDevice, fail)
}

export function stopNativeEspScan(): void {
  bridge().stopScan()
}

@UTSJS.keepAlive
export function connectNativeEspDevice(
  deviceId: string,
  serviceUuid: string,
  username: string,
  proofOfPossession: string,
  timeoutMs: number,
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().connect(deviceId, serviceUuid, username, proofOfPossession, timeoutMs, success, fail)
}

@UTSJS.keepAlive
export function getNativeEspCapabilities(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().getCapabilities(success, fail)
}

@UTSJS.keepAlive
export function getNativeEspDeviceInfo(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().getDeviceInfo(success, fail)
}

@UTSJS.keepAlive
export function sendNativeEspCustomData(
  endpoint: string,
  payload: string,
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().sendCustomData(endpoint, payload, success, fail)
}

@UTSJS.keepAlive
export function scanNativeEspNetworks(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().scanNetworks(success, fail)
}

@UTSJS.keepAlive
export function provisionNativeEspDevice(
  ssid: string,
  password: string,
  timeoutMs: number,
  progress: NativeEspProgressCallback,
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().provision(ssid, password, timeoutMs, progress, success, fail)
}

export function disconnectNativeEspDevice(): void {
  bridge().disconnect()
}

export function disposeNativeEspProvisioning(): void {
  bridge().dispose()
}
