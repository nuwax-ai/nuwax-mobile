/**
 * 名字首字母（分组用）：取首字符——汉字按 CN_FIRST_TABLE 读拼音首字母；
 * ASCII 字母直接大写归组；其余（数字/符号/生僻字/代理对）归 # 组。
 */
export function cnFirstLetter(name: string): string {
  if (name.length == 0) {
    return "#";
  }
  const cp = name.charCodeAt(0) ?? 0;
  if (cp >= CN_FIRST_START && cp < CN_FIRST_START + CN_FIRST_TABLE.length) {
    return CN_FIRST_TABLE.charAt(cp - CN_FIRST_START);
  }
  const up = name.charAt(0).toUpperCase();
  return up >= "A" && up <= "Z" ? up : "#";
}
