import { urlExtOf } from "@/utils/imChatAttachments";

/**
 * 会话文件页共享模型（页面与 im-file-pane 组件共用，保证跨组件类型同一性）。
 * 数据源：服务端会话附件行分页（apiImConvFiles，覆盖会话全部消息，新→旧；
 * 对齐 PC ChatFilesPanel / DEV-300），页面拉取后映射成本模型传入组件。
 */
export class GfFile {
  key: string = "";
  kind: string = "file";
  url: string = "";
  fileName: string = "";
  size: number = 0;
  senderName: string = "";
  sendTime: number = 0;
  /** 次行左段：发送人 · 大小（过长由 UI 省略号截断，不挤右侧时间）。 */
  subText: string = "";
  /** 次行右段：时间（恒完整展示，勿与左段合并成一条可截断文案）。 */
  timeText: string = "";
}

/**
 * 预览网关（/static/file-preview.html）渲染器支持的扩展名，与网关
 * file-preview.js 的类型 switch 一一对应（docx/xlsx/pdf/pptx/md/txt/html/
 * 代码类/图片/视频/音频）。doc/xls/ppt 老格式网关会归一成新格式渲染、
 * 二进制不兼容必然报错，不进此表（仍可下载）。
 */
export const PREVIEWABLE_EXTS: string[] = [
  "pdf", "docx", "xlsx", "pptx",
  "md", "txt", "html",
  "json", "js", "ts", "css", "py", "java",
  "png", "jpg", "jpeg", "gif", "svg",
  "mp4", "webm", "ogg", "mov", "avi",
  "mp3", "wav", "m4a", "aac", "flac", "wma",
];

/**
 * 是否显示「预览」按钮：网关按 fileUrl 路径后缀识别类型，这里用同一口径
 * （urlExtOf）判断。fileName 有后缀而 URL 没有时网关识别不了，宁可不给
 * 按钮也不给一个点开必报错的死入口。
 */
export function gfCanPreviewUrl(url: string): boolean {
  if (url.length == 0) {
    return false;
  }
  return PREVIEWABLE_EXTS.indexOf(urlExtOf(url)) >= 0;
}
