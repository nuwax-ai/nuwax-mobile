export class I18nLangDto {
  id: number = 0;
  name: string = "";
  lang: string = "";
  status: number = 0;
  isDefault: number = 0;
  sort: number = 0;
  modified: string = "";
  created: string = "";
}

export interface I18nState {
  currentLang: string;
  langMap: Record<string, string>;
  langList: I18nLangDto[];
  loaded: boolean;
  loading: boolean;
}

