import request from '@/servers/useRequest';
import { RequestResponse } from '@/types/interfaces/request';
import {
  currentQrLoginOrigin,
  normalizeQrLoginOrigin,
  qrLoginPageUrl,
  validQrLoginScene,
} from '@/utils/qrLogin';

// 内部失效标记由确认页转换为本地化提示，不直接展示给用户。
const QR_LOGIN_CONTEXT_CHANGED = 'qrLoginContextChanged';

function requireCurrentScene(sceneId: string, origin: string): void {
  if (
    !validQrLoginScene(sceneId) ||
    currentQrLoginOrigin().length == 0 ||
    currentQrLoginOrigin() != normalizeQrLoginOrigin(origin)
  ) {
    throw new Error(QR_LOGIN_CONTEXT_CHANGED);
  }
}

// 页面负责确认账号和登录返回，避免旧请求的 401 在换账号/换域后踢走新会话。
export async function apiQrLoginUser(
  sceneId: string,
  origin: string,
): Promise<RequestResponse<any>> {
  requireCurrentScene(sceneId, origin);
  return await request({
    url: '/api/user/getLoginInfo',
    method: 'GET',
    authReturnUrl: qrLoginPageUrl(sceneId, origin),
    suppressErrorToast: true,
    suppressAuthRedirect: true,
  });
}

export async function apiQrLoginScan(
  sceneId: string,
  origin: string,
): Promise<RequestResponse<any>> {
  requireCurrentScene(sceneId, origin);
  return await request({
    url: '/api/user/qrcode/scan/' + encodeURIComponent(sceneId),
    method: 'POST',
    authReturnUrl: qrLoginPageUrl(sceneId, origin),
    suppressErrorToast: true,
    suppressAuthRedirect: true,
  });
}

export async function apiQrLoginConfirm(
  sceneId: string,
  origin: string,
): Promise<RequestResponse<any>> {
  requireCurrentScene(sceneId, origin);
  return await request({
    url: '/api/user/qrcode/confirm/' + encodeURIComponent(sceneId),
    method: 'POST',
    authReturnUrl: qrLoginPageUrl(sceneId, origin),
    suppressErrorToast: true,
    suppressAuthRedirect: true,
  });
}
