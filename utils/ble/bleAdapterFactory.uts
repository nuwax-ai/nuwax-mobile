/**
 * BLE 适配器工厂
 *
 * 按「运行时 Mock 开关 + 条件编译平台」返回单例 BleAdapter：
 *  - Mock 开关开启 → MockBleAdapter（任何端都可，便于无真机验收 UI）
 *  - 关闭 → 平台实现：Android/iOS 用 UniBleAdapter(M2)，鸿蒙用 HarmonyBleAdapter(M3)
 *
 * Mock 开关持久化在 storage（key 见 constants），运行时可切换、无需重新打包。
 */
import type { BleAdapter } from '@/utils/ble/bleAdapter';
import { MockBleAdapter } from '@/utils/ble/mockBleAdapter';
import { PROV_USE_MOCK_STORAGE_KEY } from '@/constants/provision.constants';

// #ifdef APP-ANDROID || APP-IOS
import { UniBleAdapter } from '@/utils/ble/uniBleAdapter';
// #endif

// #ifdef APP-HARMONY
import { HarmonyBleAdapter } from '@/utils/ble/harmonyBleAdapter';
// #endif

/** 平台适配器单例（惰性创建） */
let platformAdapter: BleAdapter | null = null;
/** Mock 适配器单例 */
let mockAdapter: BleAdapter | null = null;

/** 是否使用 Mock（读 storage，默认 development=true / production=false） */
export function isUsingMock(): boolean {
  const v = uni.getStorageSync(PROV_USE_MOCK_STORAGE_KEY);
  if (v == null || v == '') {
    // #ifdef DEBUG
    return true;
    // #endif
    // #ifndef DEBUG
    return false;
    // #endif
  }
  return v == '1';
}

/** 设置是否使用 Mock（写 storage） */
export function setUseMock(useMock: boolean): void {
  uni.setStorageSync(PROV_USE_MOCK_STORAGE_KEY, useMock ? '1' : '0');
}

/** 创建平台适配器（按条件编译） */
function createPlatformAdapter(): BleAdapter {
  // #ifdef APP-ANDROID || APP-IOS
  return new UniBleAdapter();
  // #endif
  // #ifdef APP-HARMONY
  return new HarmonyBleAdapter();
  // #endif
  // 其它端（H5/小程序不在本期范围）兜底用 Mock，避免崩溃
  // #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
  return new MockBleAdapter();
  // #endif
}

/**
 * 获取当前 BleAdapter（按 Mock 开关选择，单例）
 */
export function getBleAdapter(): BleAdapter {
  if (isUsingMock()) {
    if (mockAdapter == null) {
      mockAdapter = new MockBleAdapter();
    }
    return mockAdapter!!;
  }
  if (platformAdapter == null) {
    platformAdapter = createPlatformAdapter();
  }
  return platformAdapter!!;
}
