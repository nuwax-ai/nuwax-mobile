<template>
  <!-- vapor：tabBar 启动即预挂载全部 tab 页（隐藏态）。此时 swiper/swiper-item 的原生元素尚未创建，
       框架 mounted 钩子先于 shared-data 模板 ref 赋值执行 → 6× NPE
       （4× swiperItem.value.itemId + 2× swiper init2 wrapperEl.offsetWidth）。
       延迟到首次 onShow（页面已附着、元素创建先行）再挂载列表组件，NPE 消除；
       page-app（navigateTo 页）挂载即附着，无此问题，不受影响。 -->
  <published-agent-list
    v-if="hasShownOnce"
    ref="publishedAgentListRef"
    agentType="ChatBot"
    :title="t('Mobile.Nav.agent')"
  ></published-agent-list>
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  import PublishedAgentList from '@/components/published-agent-list/published-agent-list.uvue'
  // #ifdef MP-WEIXIN
  import { onAddToFavorites } from '@dcloudio/uni-app'
  // #endif
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { onShow } from "@dcloudio/uni-app";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const publishedAgentListRef = ref<ComponentPublicInstance | null>(null);

  // 首次 onShow 前不挂载列表（见模板注释）；true 后常驻，避免切 tab 反复销毁重建
  const hasShownOnce = ref<boolean>(false);

  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) return;
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // 切到本 tab 时清除可能残留的 mask:true loading，并触发智能体列表静默刷新（对齐 index.uvue / mine.uvue）
  onShow(() => {
    // 首次 onShow：本 tick 才挂载列表组件（ref 尚为 null，refreshData 安全跳过），
    // 组件自身 mounted 会完成首次拉取；之后每次 onShow 走下方静默刷新。
    hasShownOnce.value = true;
    uni.hideLoading();
    callRefMethod(publishedAgentListRef.value, "refreshData");
  });

  // #ifdef MP-WEIXIN
  // 收藏
  onAddToFavorites(() => {
    return {
      title: t("Mobile.Nav.agent"),
    }
  })
  // #endif
</script>

<!-- H5：禁止页面级滚动，仅列表内部滚动 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
  }
  /* #endif */
</style>
