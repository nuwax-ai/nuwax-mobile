import { Page, RequestResponse } from '../types/interfaces/request';
import { SquarePublishedListParams, SquarePublishedItemInfo, SquareCategoryInfo } from '../types/interfaces/square';
import request from './useRequest';
import { AgentDetailDto } from '../types/interfaces/agent';

/**
 * Android：UTS class 经 JSON.stringify 可能丢字段，显式拼 UTSJSONObject。
 */
function buildSquarePublishedListBody(
  data: SquarePublishedListParams,
): UTSJSONObject {
  const body = new UTSJSONObject();
  if (data.targetType != null && data.targetType != "") {
    body["targetType"] = data.targetType;
  }
  if (data.targetSubType != null && data.targetSubType != "") {
    body["targetSubType"] = data.targetSubType;
  }
  body["page"] = data.page;
  body["pageSize"] = data.pageSize;
  if (data.category != null && data.category != "") {
    body["category"] = data.category;
  }
  if (data.kw != null && data.kw != "") {
    body["kw"] = data.kw;
  }
  if (data.official != null) {
    body["official"] = data.official;
  }
  if (data.justReturnSpaceData != null) {
    body["justReturnSpaceData"] = data.justReturnSpaceData;
  }
  const spaceId = data.spaceId;
  if (spaceId != null && spaceId > 0) {
    body["spaceId"] = spaceId;
  }
  const spaceIds = data.spaceIds;
  if (spaceIds != null && spaceIds.length > 0) {
    body["spaceIds"] = spaceIds;
  }
  return body;
}

// 广场-已发布智能体列表接口
export async function apiPublishedAgentList(
  data: SquarePublishedListParams,
): Promise<RequestResponse<Page<SquarePublishedItemInfo>>> {
  const res = await request({
    url: '/api/published/agent/list',
    method: 'POST',
    data: buildSquarePublishedListBody(data),
  });
  return res;
}

// 获取广场分类列表
export async function apiPublishedCategoryList(): Promise<RequestResponse<SquareCategoryInfo[]>> {
  const res = await request({
    url: '/api/published/category/list',
    method: 'GET',
  });
  return res;
}

// 获取已发布的智能体详情
export async function apiSquareAgentDetail(
  agentId: number,
): Promise<RequestResponse<AgentDetailDto>> {
  const res = await request({
    url: `/api/published/agent/${agentId}`,
    method: 'GET',
  });
  return res;
}
