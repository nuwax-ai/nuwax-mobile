<template>
  <!-- 导航栏 -->
  <custom-nav-bar :title="t('Mobile.Nav.app')" hasSafetyZone :showBack="true">
    <!-- #ifdef MP-WEIXIN -->
    <template v-slot:left>
      <svg-icon v-if="isLoggedIn" name="icon-Search" size="48" @click="handleSearch" />
    </template>
    <!-- #endif -->
    <!-- #ifndef MP-WEIXIN -->
    <template v-slot:right>
      <svg-icon v-if="isLoggedIn" name="icon-Search" size="48" @click="handleSearch" />
    </template>
    <!-- #endif -->
  </custom-nav-bar>

  <published-agent-list
    targetType="PageApp"
    :is-app="true"
    :preview-homepage="true"
  ></published-agent-list>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import PublishedAgentList from '@/components/published-agent-list/published-agent-list.uvue'
  // #ifdef MP-WEIXIN
  import { onAddToFavorites } from '@dcloudio/uni-app'
  // #endif
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { getCurrentPagePath } from "@/utils/commonBusiness";
  import { onShow } from "@dcloudio/uni-app";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const authInterceptor = useAuthInterceptor();
  const checkAuthAndShowPopup = authInterceptor.checkAuthAndShowPopup as () => Promise<boolean>;
  const hasToken = authInterceptor.hasToken as () => Promise<boolean>;
  const isLoggedIn = ref<boolean>(false);

  const handleSearch = async () => {
    const loggedIn = await checkAuthAndShowPopup();
    if (loggedIn != true) {
      return;
    }
    const currentUrl = getCurrentPagePath();
    uni.navigateTo({
      url:
        `/subpackages/pages/agent-search/agent-search?type=PageApp&backUrl=` +
        encodeURIComponent(currentUrl),
    });
  };

  const initData = async () => {
    isLoggedIn.value = await hasToken();
  };

  onShow(() => {
    initData();
  });

  // #ifdef MP-WEIXIN
  // 收藏
  onAddToFavorites(() => {
      return {
          title: t("Mobile.Nav.app"),
      }
  })
  // #endif
</script>

<!-- H5：禁止页面级滚动，仅列表内部滚动 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
  }
  /* #endif */
</style>
