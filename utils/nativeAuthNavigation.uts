import { resolveMobileAuthReturn } from "@/utils/authIdp";
import { switchMainTab, isMainTabPath } from "@/utils/mainTabNavigation";

/** 返回目标已校验；不对业务 query 再解码，保留 %26/%20 等字段编码。 */
export function finishNativeAuthNavigation(returnPath: string): void {
  const target = resolveMobileAuthReturn(returnPath);
  if (isMainTabPath(target)) switchMainTab({ url: target });
  else uni.reLaunch({ url: target });
}
