/**
 * 音频播放队列管理器（模块级单例）
 * 封装 uni.createInnerAudioContext：顺序播放、追加队列、打断、单句失败跳过。
 */
import { AudioQueueItem, AudioPlayerState, OnPlayerStateChange, loadVoiceSettings } from "./voiceTypes";

export class AudioPlayerManager {
  private ctx: InnerAudioContext | null = null;
  private queue: AudioQueueItem[] = [];
  private state: AudioPlayerState = "idle";
  private currentItem: AudioQueueItem | null = null;
  private onStateChange: OnPlayerStateChange | null = null;
  /** 手动停止标记：stop 后忽略后续 onEnded/onError 驱动的继续播放 */
  private stopped: boolean = true;
  /**
   * 播放会话序号：playList/stop 时自增。
   * enqueue 凭序号校验是否同一会话，防止打断后旧异步任务继续入队。
   */
  private sessionId: number = 0;

  /** 因静音暂停：保留队列与当前句，取消静音后可 resume */
  private pausedByMute: boolean = false;

  /** 注册状态回调 */
  setOnStateChange(cb: OnPlayerStateChange | null): void {
    this.onStateChange = cb;
  }

  getState(): AudioPlayerState {
    return this.state;
  }

  /** 当前播放会话序号 */
  getSessionId(): number {
    return this.sessionId;
  }

  /** 当前正在播放的消息 ID（无则空串） */
  getCurrentMessageId(): string {
    const item = this.currentItem;
    return item != null ? item!.messageId : "";
  }

  /**
   * 全局静音：只调节音量；正在播放时请配合 pause()。
   */
  setMuted(muted: boolean): void {
    const ctx = this.ctx;
    if (ctx != null) {
      ctx!.volume = muted ? 0 : 1;
    }
  }

  /** 暂停当前播放（保留队列，供取消静音后 resume） */
  pause(): void {
    if (this.state != "playing" || this.ctx == null) {
      return;
    }
    try {
      this.ctx!.pause();
    } catch (e: any) {
      console.warn("[AudioPlayer] pause error", e);
    }
    this.pausedByMute = true;
    const msgId = this.getCurrentMessageId();
    this.setState("idle", msgId);
  }

  /** 恢复因静音暂停的播放 */
  resume(): void {
    if (this.pausedByMute != true || this.ctx == null || this.currentItem == null) {
      return;
    }
    this.pausedByMute = false;
    this.stopped = false;
    const msgId = this.getCurrentMessageId();
    this.ctx!.volume = this.getTargetVolume();
    this.setState("playing", msgId);
    try {
      this.ctx!.play();
    } catch (e: any) {
      console.warn("[AudioPlayer] resume error", e);
    }
  }

  private getTargetVolume(): number {
    return loadVoiceSettings().muted == true ? 0 : 1;
  }

  /**
   * 替换队列并从头播放
   * @returns 本次播放会话序号（用于后续 enqueue 校验）
   */
  playList(items: AudioQueueItem[]): number {
    this.stopInternal();
    this.stopped = false;
    this.queue = items;
    this.playNext();
    return this.sessionId;
  }

  /** 向当前会话追加队列项（边生成边播报场景）；会话不匹配则丢弃 */
  enqueue(items: AudioQueueItem[], sessionId: number): void {
    if (sessionId != this.sessionId || this.stopped) {
      return;
    }
    for (let i = 0; i < items.length; i++) {
      this.queue.push(items[i]);
    }
    // 静音暂停中只入队，不自动续播
    if (this.state == "idle" && this.pausedByMute != true) {
      this.playNext();
    }
  }

  /** 停止播放并清空队列 */
  stop(): void {
    this.stopInternal();
    this.setState("idle", "");
  }

  private stopInternal(): void {
    this.stopped = true;
    this.pausedByMute = false;
    this.sessionId += 1;
    this.queue = [];
    this.currentItem = null;
    const ctx = this.ctx;
    if (ctx != null) {
      try {
        ctx!.stop();
      } catch (e: any) {
        console.warn("[AudioPlayer] stop error", e);
      }
      // 销毁以释放音频焦点，避免后续 TTS 出现“在播却无声”
      try {
        ctx!.destroy();
      } catch (e2: any) {
        console.warn("[AudioPlayer] destroy error", e2);
      }
      this.ctx = null;
    }
  }

  private ensureContext(): InnerAudioContext {
    if (this.ctx == null) {
      const ctx = uni.createInnerAudioContext();
      ctx.volume = this.getTargetVolume();
      // #ifdef APP-IOS
      ctx.obeyMuteSwitch = false;
      // #endif
      ctx.onEnded(() => {
        this.handleEnded();
      });
      ctx.onError((res: any) => {
        this.handlePlayError(res);
      });
      this.ctx = ctx;
    }
    return this.ctx!;
  }

  private playNext(): void {
    if (this.stopped) {
      return;
    }
    if (this.queue.length == 0) {
      this.currentItem = null;
      this.setState("idle", "");
      return;
    }
    const item = this.queue.shift()!;
    this.currentItem = item;
    if (item.src.length == 0) {
      // 空音频（mock 占位）：直接跳下一句，保持状态流转
      this.playNext();
      return;
    }
    this.setState("playing", item.messageId);
    const ctx = this.ensureContext();
    ctx.volume = this.getTargetVolume();
    // #ifdef APP-IOS
    ctx.obeyMuteSwitch = false;
    // #endif
    ctx.src = item.src;
    ctx.play();
  }

  private handleEnded(): void {
    if (this.pausedByMute) {
      return;
    }
    this.playNext();
  }

  /** 单句播放失败：跳过并继续下一句，避免整段卡死 */
  private handlePlayError(err: any): void {
    console.warn("[AudioPlayer] play error, skip segment", err);
    this.playNext();
  }

  private setState(state: AudioPlayerState, messageId: string): void {
    this.state = state;
    const cb = this.onStateChange;
    if (cb != null) {
      cb(state, messageId);
    }
  }

  /** 释放资源（页面卸载时调用） */
  destroy(): void {
    this.stopInternal();
    this.onStateChange = null;
    const ctx = this.ctx;
    if (ctx != null) {
      try {
        ctx!.destroy();
      } catch (e: any) {
        console.warn("[AudioPlayer] destroy error", e);
      }
      this.ctx = null;
    }
    this.state = "idle";
  }
}

/** 全局播放单例（全应用同时只有一路语音播报） */
export const audioPlayerManager = new AudioPlayerManager();
