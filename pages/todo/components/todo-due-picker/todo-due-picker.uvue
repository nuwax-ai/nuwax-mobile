<template>
  <view class="due-page">
    <uni-modal-popup
      ref="popupRef"
      position="bottom"
      height="100%"
      :show-header="false"
      :body-scroll="false"
      :mask-click="false"
      :round="false"
      :close-on-slide-down="false"
      :z-index="1400"
    >
      <view class="due">
        <custom-nav-bar title="" hasSafetyZone :show-back="false">
          <template #left>
            <text class="due__nav due__nav--cancel" @click="close">{{ t("Mobile.Common.cancel") }}</text>
          </template>
          <template #right>
            <text class="due__nav due__nav--save" @click="confirm">{{ t("Mobile.Common.save") }}</text>
          </template>
        </custom-nav-bar>

        <view class="due__month">
          <text class="due__month-title">{{ monthTitle }}</text>
          <view class="due__month-nav">
            <view class="due__arrow" @click="shiftMonth(-1)">
              <svg-icon name="icon-a-Chevronleft" size="18" unit="px" color="#1f2329" />
            </view>
            <view class="due__arrow" @click="shiftMonth(1)">
              <svg-icon name="icon-a-Chevronright" size="18" unit="px" color="#1f2329" />
            </view>
          </view>
        </view>

        <view class="due__week">
          <text
            v-for="(label, index) in weekdayLabels"
            :key="index"
            class="due__head"
            :class="index == todayWeekIndex ? 'due__head--today' : ''"
          >{{ label }}</text>
        </view>

        <view v-for="(week, weekIndex) in weeks" :key="weekIndex" class="due__row">
          <view v-for="(cell, dayIndex) in week" :key="dayIndex" class="due__cell" @click="pick(cell)">
            <view class="due__day" :class="cell.selected ? 'due__day--picked' : ''">
              <text :class="dayTextClass(cell)">{{ cell.day }}</text>
            </view>
          </view>
        </view>

        <picker mode="time" :value="timePickerValue" @change="onTimeChange">
          <view class="due__time">
            <svg-icon name="icon-Clock" size="20" unit="px" color="#1f2329" />
            <text class="due__time-label">{{ t("Mobile.Discover.todoDueSetTime") }}</text>
            <text v-if="draftTime.length > 0" class="due__time-value">{{ draftTime }}</text>
            <svg-icon name="icon-a-Chevronright" size="16" unit="px" color="#c9cdd4" />
          </view>
        </picker>
      </view>
    </uni-modal-popup>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, type ComponentPublicInstance } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  class DueDay {
    year: number = 0;
    month: number = 0;
    day: number = 0;
    inMonth: boolean = true;
    selected: boolean = false;
    today: boolean = false;

    constructor(year: number, month: number, day: number, inMonth: boolean) {
      this.year = year;
      this.month = month;
      this.day = day;
      this.inMonth = inMonth;
    }
  }

  const emit = defineEmits<{
    confirm: [payload: string];
  }>();

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const popupRef = ref<any | null>(null);
  const viewYear = ref<number>(2026);
  const viewMonth = ref<number>(1);
  const selectedYear = ref<number>(2026);
  const selectedMonth = ref<number>(1);
  const selectedDay = ref<number>(1);
  const todayYear = ref<number>(2026);
  const todayMonth = ref<number>(1);
  const todayDay = ref<number>(1);
  const todayWeekIndex = ref<number>(0);
  const draftTime = ref<string>("");
  const weeks = ref<DueDay[][]>([]);

  const weekdayLabels = ref<string[]>([
    t("Mobile.Discover.weekdaySunShort"),
    t("Mobile.Discover.weekdayMonShort"),
    t("Mobile.Discover.weekdayTueShort"),
    t("Mobile.Discover.weekdayWedShort"),
    t("Mobile.Discover.weekdayThuShort"),
    t("Mobile.Discover.weekdayFriShort"),
    t("Mobile.Discover.weekdaySatShort"),
  ]);

  const monthTitle = computed((): string => {
    return `${viewYear.value}.${pad2(viewMonth.value)}`;
  });

  const timePickerValue = computed((): string => {
    if (draftTime.value.length > 0) {
      return draftTime.value;
    }
    return "09:00";
  });

  function pad2(value: number): string {
    if (value < 10) {
      return `0${value}`;
    }
    return `${value}`;
  }

  function callPopup(methodName: string): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(methodName);
  }

  function daysInMonth(year: number, month: number): number {
    const cursor = new Date(year, month, 0);
    return cursor.getDate();
  }

  function shiftYearMonth(year: number, month: number, delta: number): number[] {
    let nextMonth = month + delta;
    let nextYear = year;
    while (nextMonth < 1) {
      nextMonth += 12;
      nextYear--;
    }
    while (nextMonth > 12) {
      nextMonth -= 12;
      nextYear++;
    }
    const pair: number[] = [];
    pair.push(nextYear);
    pair.push(nextMonth);
    return pair;
  }

  function readDatePart(text: string, index: number): number {
    const parts = text.split("-");
    if (index < 0 || index >= parts.length) {
      return 0;
    }
    const parsed = parseInt(parts[index]);
    if (parsed > 0) {
      return parsed;
    }
    return 0;
  }

  function decorate(cell: DueDay): DueDay {
    cell.selected = cell.year == selectedYear.value && cell.month == selectedMonth.value && cell.day == selectedDay.value;
    cell.today = cell.year == todayYear.value && cell.month == todayMonth.value && cell.day == todayDay.value;
    return cell;
  }

  function rebuild(): void {
    const year = viewYear.value;
    const month = viewMonth.value;
    const first = new Date(year, month - 1, 1);
    const lead = first.getDay();
    const count = daysInMonth(year, month);
    const prev = shiftYearMonth(year, month, -1);
    const prevCount = daysInMonth(prev[0], prev[1]);
    const cells: DueDay[] = [];
    let leadDay = prevCount - lead + 1;
    for (let i = 0; i < lead; i++) {
      cells.push(decorate(new DueDay(prev[0], prev[1], leadDay, false)));
      leadDay++;
    }
    for (let day = 1; day <= count; day++) {
      cells.push(decorate(new DueDay(year, month, day, true)));
    }
    const next = shiftYearMonth(year, month, 1);
    let nextDay = 1;
    while (cells.length < 42) {
      cells.push(decorate(new DueDay(next[0], next[1], nextDay, false)));
      nextDay++;
    }
    const nextWeeks: DueDay[][] = [];
    let start = 0;
    while (start < cells.length) {
      const week: DueDay[] = [];
      for (let offset = 0; offset < 7; offset++) {
        week.push(cells[start + offset]);
      }
      nextWeeks.push(week);
      start += 7;
    }
    weeks.value = nextWeeks;
  }

  function dayTextClass(cell: DueDay): string {
    if (cell.selected) {
      return "due__num";
    }
    if (cell.today) {
      return "due__num due__num--today";
    }
    if (!cell.inMonth) {
      return "due__num due__num--muted";
    }
    return "due__num";
  }

  function pick(cell: DueDay): void {
    selectedYear.value = cell.year;
    selectedMonth.value = cell.month;
    selectedDay.value = cell.day;
    if (!cell.inMonth) {
      viewYear.value = cell.year;
      viewMonth.value = cell.month;
    }
    rebuild();
  }

  function shiftMonth(delta: number): void {
    const next = shiftYearMonth(viewYear.value, viewMonth.value, delta);
    viewYear.value = next[0];
    viewMonth.value = next[1];
    rebuild();
  }

  function onTimeChange(event: UniPickerChangeEvent): void {
    const raw = event.detail.value;
    if (typeof raw == "string" && raw.length > 0) {
      draftTime.value = raw;
    }
  }

  /** 打开整页日历。日期为空时选中当天；已有日期则停在该日。 */
  function open(payload: string): void {
    const parts = payload.split("|");
    const dateText = parts.length > 0 ? parts[0] : "";
    const timeText = parts.length > 1 ? parts[1] : "";
    const now = new Date();
    todayYear.value = now.getFullYear();
    todayMonth.value = now.getMonth() + 1;
    todayDay.value = now.getDate();
    todayWeekIndex.value = now.getDay();
    let year = todayYear.value;
    let month = todayMonth.value;
    let day = todayDay.value;
    const parsedYear = readDatePart(dateText, 0);
    const parsedMonth = readDatePart(dateText, 1);
    const parsedDay = readDatePart(dateText, 2);
    if (parsedYear > 0 && parsedMonth > 0 && parsedDay > 0) {
      year = parsedYear;
      month = parsedMonth;
      day = parsedDay;
    }
    viewYear.value = year;
    viewMonth.value = month;
    selectedYear.value = year;
    selectedMonth.value = month;
    selectedDay.value = day;
    draftTime.value = timeText;
    rebuild();
    callPopup("open");
  }

  function close(): void {
    callPopup("close");
  }

  function confirm(): void {
    const dateText = `${selectedYear.value}-${pad2(selectedMonth.value)}-${pad2(selectedDay.value)}`;
    emit("confirm", `${dateText}|${draftTime.value}`);
    close();
  }

  defineExpose({
    open: open as any,
    close: close as any,
  });
</script>

<style scoped>
  .due {
    height: 100%;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
  }

  .due__nav {
    font-size: 16px;
    padding: 0 4px;
  }

  .due__nav--cancel {
    color: #1f2329;
  }

  .due__nav--save {
    color: #3370ff;
    font-weight: 600;
  }

  .due__month {
    height: 56px;
    padding: 0 8px 0 20px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .due__month-title {
    font-size: 28px;
    font-weight: 700;
    color: #1f2329;
  }

  .due__month-nav {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .due__arrow {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .due__week,
  .due__row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .due__head,
  .due__cell {
    flex: 1;
    text-align: center;
  }

  .due__head {
    height: 36px;
    line-height: 36px;
    font-size: 14px;
    color: #86909c;
  }

  .due__head--today {
    color: #3370ff;
  }

  .due__cell {
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .due__day {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 1px;
    border-style: solid;
    border-color: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .due__day--picked {
    background-color: #e8e9eb;
    border-color: transparent;
  }

  .due__num {
    font-size: 16px;
    color: #1f2329;
    text-align: center;
  }

  .due__num--muted {
    color: #c9cdd4;
  }

  .due__num--today {
    color: #3370ff;
  }

  .due__time {
    margin: 16px 16px 0;
    padding: 0 4px;
    height: 52px;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-style: solid;
    border-top-color: #f2f3f5;
  }

  .due__time-label {
    flex: 1;
    margin-left: 12px;
    font-size: 16px;
    color: #1f2329;
  }

  .due__time-value {
    margin-right: 8px;
    font-size: 15px;
    color: #86909c;
  }

  .due-page :deep(.uni-modal-popup__panel) {
    max-height: 100%;
    border-radius: 0;
    box-shadow: none;
  }
</style>
