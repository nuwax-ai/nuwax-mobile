<template>
  <view class="create-hub">
    <safety-zone />

    <view
      class="create-hub__nav"
      @touchstart="onEdgeSwipeTouchStart"
      @touchmove="onEdgeSwipeTouchMove"
      @touchend="onEdgeSwipeTouchEnd"
      @touchcancel="onEdgeSwipeTouchCancel"
    >
      <view class="create-hub__menu" @click="handleDrawerOpen">
        <svg-icon name="icon-Menu" size="40" color="#111111" />
      </view>
    </view>

    <scroll-view
      class="create-hub__scroll"
      direction="vertical"
      :show-scrollbar="false"
      @touchstart="onEdgeSwipeTouchStart"
      @touchmove="onEdgeSwipeTouchMove"
      @touchend="onEdgeSwipeTouchEnd"
      @touchcancel="onEdgeSwipeTouchCancel"
    >
      <view
        class="create-hub__hero"
        @touchstart="onEdgeSwipeTouchStart"
        @touchmove="onEdgeSwipeTouchMove"
        @touchend="onEdgeSwipeTouchEnd"
        @touchcancel="onEdgeSwipeTouchCancel"
      >
        <view class="create-hub__title" :style="homeTitleStyle">
          <rich-text class="create-hub__title-rich" :nodes="homeHeroNodes" />
        </view>
        <text class="create-hub__subtitle">{{ t("Mobile.CreateHub.heroSubtitle") }}</text>

        <!-- ── 类型分类胶囊（对齐 PC HomeCategoryTabs）──
             接口下发分类动态渲染，推荐数据未到不渲染。
             灰色胶囊为固定轨道（少分类自适应内容宽，多分类封顶容器宽），
             pill 在其内部横向滚动；二级推荐下拉面板见页面根级浮层。 -->
        <view v-if="categoryNavList.length > 0" class="create-hub__category-wrap" @touchstart.stop="onEdgeSwipeTouchCancel">
          <view class="create-hub__category-capsule">
            <scroll-view
              class="create-hub__category-scroll"
              :scroll-x="true"
              direction="horizontal"
              :show-scrollbar="false"
              :scroll-into-view="categoryScrollInto"
              :scroll-with-animation="true"
            >
              <!-- 行宽由实测内容宽驱动（iOS 原生端不认 max-content，见 toolsRowStyle 同款说明） -->
              <view
                :key="categoryRenderVersion"
                class="create-hub__category-list"
                :style="categoryListStyle"
              >
                <!-- iOS 原生端仅移除动态 class 时偶发保留旧的 CALayer 阴影；
                     选中态变化时重建当前 pill，确保关闭面板后白底和阴影同步消失。 -->
                <view
                  v-for="category in categoryNavList"
                  :key="category.key + '-' + categoryRenderVersion"
                  :id="category.key"
                  class="create-hub__category"
                  :class="{ 'create-hub__category--on': category.key == activeCategory }"
                  @tap.stop="handleCategoryChange(category.key)"
                >
                  <image
                    v-if="category.icon.length > 0"
                    class="create-hub__category-icon"
                    :src="category.icon"
                    mode="aspectFit"
                  />
                  <text
                    class="create-hub__category-text"
                    :class="{ 'create-hub__category-text--on': category.key == activeCategory }"
                  >{{ category.label }}</text>
                </view>
              </view>
            </scroll-view>
          </view>
        </view>
        <scroll-view
          v-if="activeGuideQuestions.length > 0 && sending != true"
          class="create-hub__guide-scroll"
          direction="vertical"
          :scroll-y="true"
          :show-scrollbar="true"
          :style="{ height: guideScrollHeightPx + 'px' }"
        >
          <view class="create-hub__guide-content">
            <view
              v-for="(question, index) in activeGuideQuestions"
              :key="'home-guide-' + index"
              class="create-hub__guide-item"
              @tap.stop="handleHomeGuideQuestion(question)"
            >
              <text class="create-hub__guide-arrow">↘</text>
              <text class="create-hub__guide-text">{{ question.info }}</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </scroll-view>

    <view
      class="create-hub__bottom"
      :class="{
        'create-hub__bottom--keyboard-raised': homeKeyboardOffset > 0,
        'create-hub__bottom--quick-popup': homeQuickPopupVisible,
      }"
      :style="{ bottom: homeKeyboardOffset + 'px' }"
    >
      <!-- 输入区：props/events 契约与 conversation-input 对齐，勿随意增删 -->
      <conversation-input
        ref="chatInputRef"
        scene="home"
        :agent-id="activeAgentId"
        :agent-type="activeAgentType"
        :is-task-agent="effectiveTaskAgent"
        :enable-skill-at="activeEnableSkillAt"
        :selected-tag="selectedRecommend != null ? selectedRecommend.label : ''"
        :selected-tag-icon="selectedRecommend != null && selectedRecommend.icon.length > 0 ? selectedRecommend.icon : ''"
        :selected-tag-closable="!isProjectAgentLocked"
        :allow-expert-selection="!projectExpertRestricted"
        :input-placeholder="activePlaceholder"
        :allow-other-model="activeAllowOtherModel"
        :current-model-id="currentModelId"
        :current-model-name="currentModelName"
        :current-sandbox-id="activeAgentSandboxId.length > 0 ? activeAgentSandboxId : currentComputerId"
        :current-computer-name="currentComputerName"
        :agent-enable-version-control="activeEnableVersionControl"
        :summoned-expert-id="summonedExpertId"
        :summoned-expert-name="summonedExpertName"
        :summoned-expert-icon="summonedExpertIcon"
        :allow-choose-mode="activeAllowChooseMode"
        :is-sandbox-switch-disabled="disablePersonalComputer"
        :allow-private-sandbox="activeAllowPrivateSandbox"
        :hide-computer-selector="pinnedProject != null"
        :pinned-project-name="pinnedProject != null ? pinnedProject.name : ''"
        :pinned-project-icon="pinnedProject != null ? pinnedProject.icon : ''"
        :workspace-dir-label="showWorkspaceDirBar ? (workspacePath.length > 0 ? workspacePath : t('Mobile.CreateHub.defaultWorkspaceDir')) : ''"
        :space-selector-label="showSpaceSelector && selectedSpaceName.length > 0 ? selectedSpaceName : ''"
        :enable-voice="true"
        :is-conversation-active="false"
        :whole-disabled="sending"
        :has-permission="true"
        :manual-components="activeManualComponents"
        :default-selected-components="selectedToolComponents"
        @onSendMessage="handleSendMessage"
        @onModelChange="handleModelChange"
        @onComputerChange="handleComputerChange"
        @onOpenAction="handleInputAction"
        @onFocusChange="handleInputFocusChange"
        @onKeyboardOffsetChange="handleKeyboardOffsetChange"
        @onQuickPopupVisibleChange="handleQuickPopupVisibleChange"
        @onExpertAgentSelect="handleExpertAgentSelect"
        @onClearExpert="clearSummonedExpert"
        @onClearSelectedTag="handleClearSelectedTag"
        @onClearPinnedProject="handleClearPinnedProject"
        @onOpenWorkspaceDirPicker="workspaceDirMenuVisible = true"
        @onOpenSpaceSelector="spaceSheetVisible = true"
      />
    </view>

    <!-- ── 分类二级推荐下拉浮层（页面根级）──
         原生端 scroll-view 会裁剪超出内容区的子视图、且内部浮层的 z-index 被困在滚动子树内
         （会被后绘制的 create-hub__bottom 盖住），因此面板与遮罩必须放在页面根级 fixed 定位。
         ⚠ Android 实测（2026-09-19 Redmi 真机）：fixed 元素上带 rpx 的 left/right 偏移与
         内容自适应高度都不生效，面板布局盒被撑成全宽并上移，透明区域盖住胶囊行下半部吞掉点击
         （点「对话任务」后再点「项目开发」无反应的根因）；同页面 left:0;right:0 + 内联 px top/height
         的遮罩完全正确。因此面板宿主必须与遮罩同构：全宽 fixed + 内联 px top + bottom:0，
         白卡作为普通流子元素用 margin 内缩，禁止在 fixed 元素上用 rpx 偏移与自适应高度。
         宿主为胶囊底→屏幕底的整带（点空白关闭，替代旧下段遮罩）；上段遮罩（胶囊顶以上）独立保留，
         面板展开期间胶囊行不被任何浮层覆盖，点其他分类可直接切换。
         锚点坐标在 openPanel 时经 SelectorQuery 实测胶囊位置换算（px）；
         测量失败（锚点为 0）时整体不渲染，杜绝「面板在、遮罩无」的半失效态。 -->
    <template v-if="categoryPanelMounted">
      <view
        class="create-hub__category-mask create-hub__category-mask--top"
        :style="categoryMaskTopStyle"
        @click="closePanel"
      />
      <!-- 面板宿主：胶囊底→屏幕底整带（透明承接点击=关闭）；白卡内点击不冒泡 -->
      <view class="create-hub__category-panel" :style="categoryPanelStyle" @click="closePanel">
        <view
          v-if="activeCategoryItems.length > 0"
          class="create-hub__category-panel-card"
          :class="{ 'create-hub__category-panel-card--closing': categoryPanelClosing }"
          @click.stop="onPanelCardTap"
          @touchstart="onPanelTouchStart"
          @touchend="onPanelTouchEnd"
        >
          <scroll-view
            class="create-hub__category-panel-scroll"
            direction="vertical"
            :show-scrollbar="false"
            @scroll="onPanelGridScroll"
          >
            <view class="create-hub__category-panel-grid">
              <view
                v-for="item in activeCategoryItems"
                :key="item.id"
                class="create-hub__category-panel-item"
                :class="{
                  'create-hub__category-panel-item--on': selectedRecommend != null && selectedRecommend.id == item.id,
                  'create-hub__category-panel-item--disabled': isPanelItemSelectable(item) != true,
                }"
                @click="handlePanelItemClick(item)"
              >
                <image
                  v-if="item.icon.length > 0"
                  class="create-hub__category-panel-item-icon"
                  :src="item.icon"
                  mode="aspectFit"
                />
                <text
                  class="create-hub__category-panel-item-text"
                  :class="{ 'create-hub__category-panel-item-text--on': selectedRecommend != null && selectedRecommend.id == item.id }"
                >{{ item.label }}</text>
              </view>
            </view>
          </scroll-view>
          <view class="create-hub__category-panel-handle">
            <view class="create-hub__category-panel-handle-bar" />
          </view>
        </view>
      </view>
    </template>

    <!-- 空间选择（对齐 PC SpaceSelector）：项目类推荐建项目时选空间 -->
    <space-select-sheet
      :visible="spaceSheetVisible"
      :spaces="spaceList"
      :selected-id="selectedSpaceId"
      :avoid-tab-bar="true"
      @close="spaceSheetVisible = false"
      @select="handleSpaceSelect"
    />

    <!-- 工作目录两选项菜单（对齐 PC workspace-dir-bar Dropdown） -->
    <workspace-dir-menu
      :visible="workspaceDirMenuVisible"
      :current-path="workspacePath"
      :avoid-tab-bar="true"
      @close="workspaceDirMenuVisible = false"
      @selectDefault="handleWorkspaceDirSelect('')"
      @openPicker="workspaceDirSheetVisible = true"
    />

    <!-- 工作目录选择（对齐 PC WorkspaceDirPickerModal）：roots/children 逐层浏览 -->
    <workspace-dir-sheet
      :visible="workspaceDirSheetVisible"
      :sandbox-id="currentComputerId"
      :current-path="workspacePath"
      :avoid-tab-bar="true"
      @close="workspaceDirSheetVisible = false"
      @select="handleWorkspaceDirSelect"
    />

    <!-- 项目/任务抽屉（App v3）：左上角菜单或首页内容区右滑唤起；「＋新建会话」上框到首页 -->
    <project-task-drawer
      ref="drawerRef"
      :is-logged-in="isLoggedIn"
      @conversation-click="handleConversationClick"
      @pin-project="applyPinnedProject"
    />

    <!-- iOS 常驻聊天壳 + 打开/换会话白遮罩（仅 iOS；Android / 鸿蒙走 zhuoda 独立页，不使用本壳） -->
    <!-- #ifdef APP-IOS -->
    <resident-chat-shell />
    <view v-if="residentChatCover" class="resident-chat-opening-cover" />
    <!-- #endif -->

    <!-- Android / 鸿蒙：离线包预热。1px 隐藏容器在启动后加载本地 bootstrap，
         让系统 WebView 的 JS 编译缓存（V8 code cache 等）预先落盘，
         进入 agent-detail 时新 WebView 解析 5MB bundle 明显变快。
         外层宿主用显式 1px + overflow hidden：组件根节点自带 flex:1/100% 尺寸，
         外部 class 直接挂组件根在原生端样式合并顺序不可靠，曾撑成全屏吞掉点击。 -->
    <!-- #ifdef APP-ANDROID || APP-HARMONY -->
    <view class="offline-warmup-host">
      <offline-h5-container
        v-if="offlineWarmupReady"
        :request="offlineWarmupRequest"
      />
    </view>
    <!-- #endif -->

    <!-- 登录弹窗（仅微信小程序） -->
    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>

<!--
  首页（CreateHub）重写版 · 2026-09-19

  本文件按固定分区组织，重排任何代码前先读以下两条铁律：

  1) UTS/Kotlin 前向引用（error18）：函数 / computed / watch 只能引用其上方已声明的绑定，
     分区顺序不可打乱 —— 工具 → 类型 → 状态 → 派生 → 函数 → watch → 平台块 → 生命周期。
  2) 跨边界数据一律「值归一」，禁止裸 as：
     - 组件事件载荷（class 实例数组混 JSON 对象）入口处 JSON 往返归一（normalizeSendPayload）；
     - 接口响应字段经 strOf / numFromAny / numField 读取；
     - 字符串 → 枚举只能走 parseComponentType（Android 裸 as 枚举必 ClassCastException）。
  视觉/交互结构中的平台 workaround（根级浮层、实测 px 宽、分段遮罩等）均经真机验证，勿「优化」。
-->
<script setup lang="uts">
  import { computed, getCurrentInstance, onMounted, onUnmounted, ref, watch, type ComponentPublicInstance } from "vue";
  import { onLoad, onShow } from "@dcloudio/uni-app";
  import { refreshImUnreadBadge } from "@/utils/imUnreadBadge";
  // #ifdef APP-IOS
  import { onBackPress } from "@dcloudio/uni-app";
  import ResidentChatShell from "@/components/resident-chat-shell/resident-chat-shell.uvue";
  import {
    flushPendingResidentChat,
    isResidentChatCoverActive,
    isResidentChatVisible,
    handleResidentChatBackPress,
    RESIDENT_CHAT_COVER_EVENT,
  } from "@/utils/residentChatShell";
  // #endif
  // #ifdef APP-ANDROID || APP-HARMONY
  import { createChatWarmupRequest } from "@/utils/chatOfflineH5";
  // #endif
  // #ifdef MP-WEIXIN
  import { onShareAppMessage, onAddToFavorites } from "@dcloudio/uni-app";
  import AuthLoginPopup from "@/components/auth-login-popup/auth-login-popup.uvue";
  // #endif
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
  import { apiTenantConfig } from "@/servers/account";
  import { parseHomeSloganNodes } from "@/utils/homeSlogan";
  import { apiPublishedAgentInfo, apiDisplayRecommendList } from "@/servers/agentDev";
  import { apiAgentConversationCreate } from "@/servers/conversation";
  import { apiSpaceList } from "@/servers/space";
  import { apiProjectCreateUnified } from "@/servers/project";
  import { fetchChatboxCategories } from "@/servers/square";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { addTicketAndJumpToWebview, jumpToAgentDetailPage, syncNativeTabBarState } from "@/utils/commonBusiness";
  import { goToLogin } from "@/utils/authNavigation";
  import { appGlobalState } from "@/utils/appGlobalState";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import { applyTabBarI18n, emptyI18nParams, useI18n } from "@/utils/i18n";
  import { handleExternalLink, setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { orEmpty } from "@/utils/utsCoalesce.uts";
  import { PendingChatDraft } from "@/types/interfaces/pendingChatDraft";
  import { SelectedDocInfo } from "@/types/interfaces/knowledgeList";
  import { savePendingChatDraft } from "@/utils/pendingChatDraft";
  import { AgentSelectedComponentInfo, AgentManualComponentInfo, ExpertGuideQuestionInfo } from "@/types/interfaces/agent";
  import { AgentComponentTypeEnum, DefaultSelectedEnum } from "@/types/enums/agent";
  import { SpaceOptionInfo } from "@/types/interfaces/spaceOption";
  import { SquareCategoryInfo } from "@/types/interfaces/square";
  import {
    DisplayRecommendInfo,
    PinnedProjectInfo,
    findDefaultAgent,
    findTypeFallbackAgent,
    getProjectTypeByFunctionType,
    getWorkspaceDirPolicy,
    isRecommendSelectable,
    isProjectExpertRestricted,
    showSpaceSelectorForFunctionType,
    isTaskAgentFunctionType,
    resolvePersonalWorkspacePath,
  } from "@/types/interfaces/displayRecommend";
  import ConversationInput from "@/components/conversation-input/conversation-input.uvue";
  import WorkspaceDirSheet from "@/components/conversation-input/workspace-dir-sheet/workspace-dir-sheet.uvue";
  import WorkspaceDirMenu from "@/components/conversation-input/workspace-dir-menu/workspace-dir-menu.uvue";
  import SpaceSelectSheet from "@/components/conversation-input/space-select-sheet/space-select-sheet.uvue";
  import ProjectTaskDrawer from "@/components/project-task-drawer/project-task-drawer.uvue";

  // ════════════════ 1. 值归一工具（跨平台强转唯一出口）════════════════

  /** any → string：null/undefined 归空串（模板串比 orEmpty 少一次函数包装） */
  function strOf(raw: any | null): string {
    return raw != null ? `${raw}` : "";
  }

  /** any → number：null / 非数字 / NaN 一律回落 fallback（禁止裸 `as number`，Android 擦除后强转字符串必炸） */
  function numFromAny(raw: any | null, fallback: number): number {
    if (raw == null) {
      return fallback;
    }
    if (typeof raw == "number") {
      const n = raw as number;
      return n != n ? fallback : n;
    }
    const parsed = parseFloat(`${raw}`);
    return parsed != parsed ? fallback : parsed;
  }

  /** UTSJSONObject 字段 → number */
  function numField(obj: UTSJSONObject, key: string, fallback: number): number {
    return numFromAny(obj[key], fallback);
  }

  /** 接口响应 data → UTSJSONObject（Android 上 data 可能是 UTSArray/包装值，JSON 往返统一，仓库已验证模式） */
  function resObject(dataRaw: any | null): UTSJSONObject | null {
    if (dataRaw == null) {
      return null;
    }
    const jsonStr = JSON.stringify(dataRaw);
    if (jsonStr == null || jsonStr.length == 0) {
      return null;
    }
    return JSON.parse<UTSJSONObject>(jsonStr);
  }

  /**
   * 跨 API / 组件边界的数组统一转为 JSON 对象数组。
   * Android 返回的 UTSArray、iOS 桥接数组和 H5 原生数组运行时类型不同，不能直接互相强转。
   */
  function objectRows(raw: any | null): UTSJSONObject[] {
    const result = [] as UTSJSONObject[];
    if (raw == null) return result;
    const jsonStr = JSON.stringify(raw);
    if (jsonStr == null || jsonStr.length == 0) return result;
    const parsed = JSON.parse(jsonStr);
    if (parsed == null || Array.isArray(parsed) != true) return result;
    const rows = parsed as any[];
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      if (row != null) result.push(row as UTSJSONObject);
    }
    return result;
  }

  /** 工具类型字符串 → 枚举（禁止字符串 as 枚举，Android ClassCastException） */
  function parseComponentType(v: string): AgentComponentTypeEnum {
    if (v == "Workflow") return AgentComponentTypeEnum.Workflow;
    if (v == "Trigger") return AgentComponentTypeEnum.Trigger;
    if (v == "Knowledge") return AgentComponentTypeEnum.Knowledge;
    if (v == "Variable") return AgentComponentTypeEnum.Variable;
    if (v == "Table") return AgentComponentTypeEnum.Table;
    if (v == "Model") return AgentComponentTypeEnum.Model;
    if (v == "Agent") return AgentComponentTypeEnum.Agent;
    if (v == "Mcp") return AgentComponentTypeEnum.MCP;
    if (v == "Page") return AgentComponentTypeEnum.Page;
    if (v == "Event") return AgentComponentTypeEnum.Event;
    if (v == "Skill") return AgentComponentTypeEnum.Skill;
    if (v == "ToolCall") return AgentComponentTypeEnum.ToolCall;
    return AgentComponentTypeEnum.Plugin;
  }

  /** rpx→px（窗口宽度缓存；本页宽不变） */
  let cachedWindowWidthPx = 0;
  function rpxToPx(rpx: number): number {
    if (cachedWindowWidthPx <= 0) {
      const info = uni.getWindowInfo();
      cachedWindowWidthPx = info.windowWidth != null ? info.windowWidth : 375;
    }
    return (rpx * cachedWindowWidthPx) / 750;
  }

  // ════════════════ 2. 页面私有类型 ════════════════

  /** 首页类型分类（对齐 PC HomeCategoryDef；items = 归入该分类的推荐位） */
  class HomeCategoryDef {
    key: string = "";
    label: string = "";
    icon: string = "";
    items: DisplayRecommendInfo[] = [] as DisplayRecommendInfo[];
  }

  /** Android：UTSJSONObject 不能 as 接口，逐字段构造（对齐 AgentDetailService._ManualComponentInfo） */
  class HomeManualComponent implements AgentManualComponentInfo {
    id: number = 0;
    name: string = "";
    icon: string = "";
    description: string = "";
    type: AgentComponentTypeEnum = AgentComponentTypeEnum.Plugin;
    defaultSelected: DefaultSelectedEnum = DefaultSelectedEnum.No;
    constructor(raw: UTSJSONObject) {
      this.id = numFromAny(raw["id"], 0);
      this.name = strOf(raw["name"]);
      this.icon = strOf(raw["icon"]);
      this.description = strOf(raw["description"]);
      this.type = parseComponentType(strOf(raw["type"]).length > 0 ? strOf(raw["type"]) : "Plugin");
      this.defaultSelected = raw["defaultSelected"] == 1 ? DefaultSelectedEnum.Yes : DefaultSelectedEnum.No;
    }
  }

  // ════════════════ 3. 基础状态 ════════════════

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
  /** 对齐 PC：首页主标题由租户 homeSlogan 配置驱动；接口缺省时保留平台默认文案。 */
  const homeHeroNodes = ref<UTSJSONObject[]>(parseHomeSloganNodes(t("Mobile.CreateHub.heroTitle")));
  const homeTitleStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    const info = uni.getWindowInfo();
    const height = info.windowHeight != null ? info.windowHeight : 800;
    style["maxHeight"] = `${Math.round(height * 0.33)}px`;
    return style;
  });
  const { loginPopupRef, checkAuthAndShowPopup, hasToken } = useAuthInterceptor();
  const pageInstance = getCurrentInstance();

  const sending = ref<boolean>(false);
  const projectCreating = ref<boolean>(false);

  // 类型体系数据（对齐 PC Home）：分类 = ChatBox 分类接口，推荐位 = recChatBoxNav.Agent
  const chatboxCategories = ref<SquareCategoryInfo[]>([] as SquareCategoryInfo[]);
  const recommendNavList = ref<DisplayRecommendInfo[]>([] as DisplayRecommendInfo[]);
  let chatboxNavLoaded = false;
  const userPickedCategory = ref<string>("");
  const selectedRecommend = ref<DisplayRecommendInfo | null>(null);

  // 项目上框（对齐 PC pinnedProject）：抽屉「＋新建会话」pin 进来，约束推荐可选范围并随会话绑定项目
  const pinnedProject = ref<PinnedProjectInfo | null>(null);
  // 上框未命中提示去重（同一项目只提示一次，对齐 PC agentMissedPromptedRef）
  let pinnedMissedProjectId = 0;

  // 工作目录（仅个人电脑沙箱生效）
  const workspacePath = ref<string>("");
  const workspaceDirMenuVisible = ref<boolean>(false);
  const workspaceDirSheetVisible = ref<boolean>(false);

  // 会话对象详情派生门控（对齐 PC agentDetail：模型可选/模式可选/私有沙箱/绑定沙箱/工具）
  const activeAllowOtherModel = ref<boolean>(true);
  const activeAllowChooseMode = ref<number>(1);
  const activeAllowPrivateSandbox = ref<boolean>(false);
  const activeAgentSandboxId = ref<string>("");
  const activeDetailAgentType = ref<string>("ChatBot");
  const activeManualComponents = ref<AgentManualComponentInfo[]>([] as AgentManualComponentInfo[]);
  const activeGuideQuestions = ref<ExpertGuideQuestionInfo[]>([] as ExpertGuideQuestionInfo[]);
  const guideScrollHeightPx = ref<number>(220);

  // 工具勾选状态（对齐 PC selectedComponentList）：随智能体详情重建默认勾选（defaultSelected=Yes）
  const selectedToolComponents = ref<AgentSelectedComponentInfo[]>([] as AgentSelectedComponentInfo[]);
  const homeToolsExpanded = ref<boolean>(false);
  // 工具一行能完全放下时不显示展开/收起（内容溢出才出现）
  const toolsOverflow = ref<boolean>(false);
  // Android 首页键盘避让量由共享输入组件按真实 editor 底边计算；页面整体消费，
  // 保证工具栏、上传预览和输入卡一起上移。
  const homeKeyboardOffset = ref<number>(0);
  const homeQuickPopupVisible = ref<boolean>(false);

  function handleKeyboardOffsetChange(offset: number): void {
    homeKeyboardOffset.value = offset > 0 ? offset : 0;
  }

  function handleQuickPopupVisibleChange(visible: boolean): void {
    homeQuickPopupVisible.value = visible;
  }

  /**
   * 横滚内容行实测宽度（px；0 = 未溢出，用 auto 收缩）。
   * iOS 原生端不认 width:max-content，flex 行不会随内容撑宽（真机实测内容宽==视口宽），
   * 溢出时必须把行宽显式设为实测内容宽，scroll-view 才有滚动余量。
   */
  const toolsRowWidthPx = ref<number>(0);
  const categoryListWidthPx = ref<number>(0);
  // iOS 原生端动态移除阴影 class 后偶发保留旧 CALayer；关闭面板时重建 pill 行强制刷新。
  const categoryRenderVersion = ref<number>(0);

  // 推荐位详情联动（对齐 PC agentDetail 消费面：技能门控/版本控制/placeholder）
  const recommendAllowAtSkill = ref<number>(1);
  const recommendEnableVersionControl = ref<number>(0);
  const recommendPlaceholder = ref<string>("");

  // 租户默认智能体（会话对象三态的最后兜底）
  const defaultAgentId = ref<number>(0);
  const defaultAgentName = ref<string>("");
  const defaultAgentType = ref<string>("ChatBot");
  const defaultEnableVersionControl = ref<number>(0);

  // 召唤专家（能力弹窗选中；会话对象三态的最高优先级）
  const summonedExpertId = ref<number>(0);
  const summonedExpertName = ref<string>("");
  const summonedExpertIcon = ref<string>("");
  const summonedExpertType = ref<string>("ChatBot");
  const summonedExpertEnableVersionControl = ref<number>(0);
  // 所选专家是否允许 / 技能（allowAtSkill；默认 1，详情拉取后按实际值收敛）
  const summonedExpertAllowAtSkill = ref<number>(1);

  const currentModelId = ref<number>(0);
  const currentModelName = ref<string>("");
  const currentComputerId = ref<string>("-1");
  const currentComputerName = ref<string>(t("Mobile.CreateHub.selectComputer"));

  // 二级推荐下拉面板：点分类展开、再点同分类收起、上滑关闭、选中即收起
  const categoryPanelVisible = ref<boolean>(false);
  // 离场中标记（挂离场动画类；入场动画在挂载时由 keyframes 自动播放，不依赖定时器加类）
  const categoryPanelClosing = ref<boolean>(false);
  let panelCloseTimer = 0;
  // 异步测量世代：关闭/切换后，旧 boundingClientRect 回调不得重新挂载命中层。
  let categoryPanelRequestId = 0;
  // 面板根级 fixed 定位锚点：胶囊实测视口坐标（px；0 = 未测量，浮层三件套一并不渲染）
  const categoryCapsuleTopPx = ref<number>(0);
  const categoryCapsuleBottomPx = ref<number>(0);
  // 选中分类自动滚入胶囊可视区（scroll-into-view 目标 id = 分类 key）
  const categoryScrollInto = ref<string>("");
  // 面板内容纵向滚动位置：滚离顶部时不把上滑当收起手势，避免与内容滚动冲突
  let panelScrollTop = 0;

  // ── 空间选择（对齐 PC SpaceSelector）：项目类推荐选中时展示，随建项目传 spaceId ──
  const spaceList = ref<SpaceOptionInfo[]>([] as SpaceOptionInfo[]);
  const selectedSpaceId = ref<number>(0);
  const spaceSheetVisible = ref<boolean>(false);

  // ── 抽屉 / 登录态 ──
  const drawerRef = ref<any | null>(null);
  const isLoggedIn = ref<boolean>(false);
  const chatInputRef = ref<any | null>(null);

  // ════════════════ 4. 派生状态（computed，声明顺序即依赖顺序）════════════════

  const toolsRowStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    if (toolsRowWidthPx.value > 0) {
      style["width"] = `${toolsRowWidthPx.value}px`;
    }
    return style;
  });

  const categoryListStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    if (categoryListWidthPx.value > 0) {
      style["width"] = `${categoryListWidthPx.value}px`;
    }
    return style;
  });

  // 会话对象三态（对齐 PC currentAgentId）：召唤专家 > 推荐位 > 租户默认；上框全栈未命中不回落默认
  const isUserAppPinned = computed((): boolean => pinnedProject.value != null && pinnedProject.value.projectType == "UserApp");
  // 全栈项目自动/手动确定智能体后，项目绑定的专家不能单独移除（与 PC 一致）。
  const isProjectAgentLocked = computed((): boolean => isUserAppPinned.value && selectedRecommend.value != null);
  const projectExpertRestricted = computed((): boolean => {
    const pinned = pinnedProject.value;
    return pinned != null && isProjectExpertRestricted(pinned.projectType);
  });
  const activeAgentId = computed((): number => {
    if (summonedExpertId.value > 0) return summonedExpertId.value;
    const recommend = selectedRecommend.value;
    if (recommend != null && recommend.targetId > 0) return recommend.targetId;
    // 全栈上框命中前不回落租户默认（出范围；对齐 PC）
    if (isUserAppPinned.value) return 0;
    return defaultAgentId.value;
  });
  const activeAgentName = computed((): string => {
    if (summonedExpertId.value > 0) return summonedExpertName.value;
    const recommend = selectedRecommend.value;
    if (recommend != null) return recommend.label;
    return defaultAgentName.value;
  });
  const activeAgentType = computed((): string => {
    if (summonedExpertId.value > 0) return summonedExpertType.value;
    // 推荐位智能体的类型取详情（对齐 PC agentDetail.type：如 functionType=Chat 但实体是 TaskAgent 的推荐位）
    if (selectedRecommend.value != null) return activeDetailAgentType.value;
    return defaultAgentType.value;
  });
  const activeEnableVersionControl = computed((): number => {
    if (summonedExpertId.value > 0) return summonedExpertEnableVersionControl.value;
    if (selectedRecommend.value != null) return recommendEnableVersionControl.value;
    return defaultEnableVersionControl.value;
  });
  /** 首页技能入口（/ 快捷浮层、+ 弹层技能项）：召唤专家 > 推荐位 的 allowAtSkill；都无时默认放开 */
  const activeEnableSkillAt = computed((): boolean => {
    if (summonedExpertId.value > 0) return summonedExpertAllowAtSkill.value == 1;
    if (selectedRecommend.value != null) return recommendAllowAtSkill.value == 1;
    return true;
  });
  const isTaskAgent = computed((): boolean => activeAgentType.value == "TaskAgent");
  // 推荐位选中按任务智能体形态生效（对齐 PC effectiveTaskAgentActive）
  const effectiveTaskAgent = computed((): boolean => {
    if (summonedExpertId.value > 0) return isTaskAgent.value;
    const recommend = selectedRecommend.value;
    if (recommend != null) return isTaskAgentFunctionType(recommend.functionType);
    return isTaskAgent.value;
  });
  const activePlaceholder = computed((): string => {
    if (summonedExpertId.value > 0) return "";
    const recommend = selectedRecommend.value;
    if (recommend != null) return recommendPlaceholder.value;
    return "";
  });
  // 全栈/网页应用等类型锁定云端电脑（对齐 PC disablePersonalComputer + getWorkspaceDirPolicy）
  const disablePersonalComputer = computed((): boolean => {
    if (pinnedProject.value != null) {
      return !getWorkspaceDirPolicy(pinnedProject.value.projectType).personalComputer;
    }
    const recommend = selectedRecommend.value;
    if (recommend == null) return false;
    const projectType = getProjectTypeByFunctionType(recommend.functionType);
    if (projectType.length == 0) return false;
    return !getWorkspaceDirPolicy(projectType).personalComputer;
  });
  // 工作目录灰条（对齐 PC workspace-dir-bar）：任务形态 && 非上框 && 非锁定云端 && 用户自选个人电脑
  const showWorkspaceDirBar = computed((): boolean => {
    // 对齐 PC：上框期间沙箱由项目隐含（会话创建走项目 sandboxId），目录条整条隐藏
    if (pinnedProject.value != null) return false;
    if (disablePersonalComputer.value) return false;
    if (effectiveTaskAgent.value != true && activeAgentType.value != "TaskAgent") return false;
    // 对齐 PC !readonly：智能体不允许私有沙箱时不显示目录条
    if (activeAllowPrivateSandbox.value != true) return false;
    return currentComputerId.value.length > 0 && currentComputerId.value != "-1";
  });
  const showSpaceSelector = computed((): boolean => {
    // 对齐 PC：上框期间隐藏（空间随项目）；项目类推荐选中才显示
    if (pinnedProject.value != null) return false;
    const recommend = selectedRecommend.value;
    if (recommend == null) return false;
    return showSpaceSelectorForFunctionType(recommend.functionType);
  });
  const selectedSpaceName = computed((): string => {
    const list = spaceList.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].id == selectedSpaceId.value) return list[i].name;
    }
    return list.length > 0 ? list[0].name : "";
  });

  // ── 类型体系派生（对齐 PC categoryNavList/autoCategoryKey/activeCategory） ──
  const categoryNavList = computed((): HomeCategoryDef[] => {
    const result = [] as HomeCategoryDef[];
    const categories = chatboxCategories.value;
    const recommends = recommendNavList.value;
    if (categories.length == 0) return result;
    const firstKey = categories[0].key;
    for (let i = 0; i < categories.length; i++) {
      const category = categories[i];
      const def = new HomeCategoryDef();
      def.key = category.key;
      def.label = category.label;
      def.icon = category.icon;
      const items = [] as DisplayRecommendInfo[];
      for (let j = 0; j < recommends.length; j++) {
        const item = recommends[j];
        const itemCategory = item.category.length > 0 ? item.category : firstKey;
        if (itemCategory == category.key) items.push(item);
      }
      def.items = items;
      result.push(def);
    }
    return result;
  });
  // 默认不选中任何分类：仅用户点选后才有选中态，收起面板即取消
  const activeCategory = computed((): string => userPickedCategory.value);
  const activeCategoryItems = computed((): DisplayRecommendInfo[] => {
    const list = categoryNavList.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].key == activeCategory.value) return list[i].items;
    }
    return [] as DisplayRecommendInfo[];
  });

  // ── 面板浮层定位（px 实测避免混合单位 calc 兼容问题） ──
  /** 浮层统一挂载条件：面板可见 && 锚点已实测（测量失败不渲染，杜绝无遮罩半失效态） */
  const categoryPanelMounted = computed((): boolean => {
    return categoryPanelVisible.value == true && categoryCapsuleTopPx.value > 0 && categoryCapsuleBottomPx.value > 0;
  });
  /** 上段遮罩：胶囊顶以上（点空白关闭，不遮胶囊） */
  const categoryMaskTopStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    style["height"] = `${categoryCapsuleTopPx.value}px`;
    return style;
  });
  /** 面板宿主：胶囊底→屏幕底整带（top 内联 px；与遮罩同构，规避 Android fixed rpx 偏移失效） */
  const categoryPanelStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    style["top"] = `${categoryCapsuleBottomPx.value}px`;
    return style;
  });

  // ════════════════ 5. 函数（声明顺序即依赖顺序，勿前向引用）════════════════

  /** conversation-input expose 方法调用（Android Gen* 须走 $callMethod） */
  function callInputRef(method: string): void {
    const inst = chatInputRef.value;
    if (inst == null) return;
    (inst as ComponentPublicInstance).$callMethod(method);
  }

  /** 提示问题只填入草稿，不自动发送；页面/链接沿用现有移动端跳转。 */
  async function handleHomeGuideQuestion(question: ExpertGuideQuestionInfo): Promise<void> {
    if (question.type == "Link") {
      if (question.url.length > 0) handleExternalLink(question.url, question.info);
      return;
    }
    if (question.type == "Page") {
      if (question.pageUrl.length > 0) {
        await addTicketAndJumpToWebview(question.pageUrl, "inner", question.info);
      }
      return;
    }
    const inst = chatInputRef.value;
    if (inst == null) return;
    (inst as ComponentPublicInstance).$callMethod("setText", question.info);
  }

  function measureHomeGuideHeight(attempt: number): void {
    if (activeGuideQuestions.value.length == 0 || pageInstance == null || pageInstance.proxy == null) return;
    uni.createSelectorQuery()
      .in(pageInstance.proxy)
      .select(".create-hub__scroll")
      .boundingClientRect()
      .select(".create-hub__guide-scroll")
      .boundingClientRect()
      .select(".create-hub__guide-content")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        if (results.length < 3 || results[0] == null || results[1] == null || results[2] == null) {
          if (attempt < 3) setTimeout((): void => measureHomeGuideHeight(attempt + 1), 180);
          return;
        }
        const viewport = results[0] as NodeInfo;
        const guide = results[1] as NodeInfo;
        const content = results[2] as NodeInfo;
        const viewportBottom = viewport.bottom != null ? parseFloat(`${viewport.bottom}`) : 0;
        const guideTop = guide.top != null ? parseFloat(`${guide.top}`) : 0;
        const contentHeight = content.height != null ? parseFloat(`${content.height}`) : 0;
        if (viewportBottom <= 0 || guideTop <= 0 || contentHeight <= 0) return;
        const available = Math.max(rpxToPx(120), viewportBottom - guideTop - rpxToPx(48));
        guideScrollHeightPx.value = Math.ceil(Math.min(contentHeight, available));
      });
  }

  /** Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject；用 $callMethod 调 defineExpose 方法 */
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // ── 5.1 工具勾选 ──

  function isHomeToolSelected(comp: AgentManualComponentInfo): boolean {
    const list = selectedToolComponents.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].id == comp.id) {
        return true;
      }
    }
    return false;
  }

  function toggleHomeTool(comp: AgentManualComponentInfo): void {
    const list = selectedToolComponents.value;
    const next = [] as AgentSelectedComponentInfo[];
    let found = false;
    for (let i = 0; i < list.length; i++) {
      if (list[i].id == comp.id) {
        found = true;
      } else {
        next.push(list[i]);
      }
    }
    if (found != true) {
      next.push(new AgentSelectedComponentInfo(comp.id, comp.type));
    }
    selectedToolComponents.value = next;
  }

  // ── 5.2 溢出测量（setTimeout 后 SelectorQuery 实测；失败自动重试，杜绝慢设备上展开按钮永久缺失） ──

  /** 测量收起态工具行是否溢出：逐 chip 实测求和（行盒宽在 iOS 不反映内容宽） */
  function measureToolsOverflow(attempt: number): void {
    if (pageInstance == null || pageInstance.proxy == null) return;
    uni.createSelectorQuery()
      .in(pageInstance.proxy)
      .select(".create-hub__tools-scroll")
      .boundingClientRect()
      .selectAll(".create-hub__tool-chip")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        const ready = results.length >= 2 &&
          results[0] != null &&
          results[1] != null &&
          Array.isArray(results[1]);
        if (ready != true) {
          if (attempt < 2) {
            setTimeout(() => { measureToolsOverflow(attempt + 1); }, 180);
          }
          return;
        }
        const viewport = results[0] as NodeInfo;
        const chips = results[1] as NodeInfo[];
        const vw = viewport.width != null ? parseFloat(`${viewport.width}`) : 0;
        let contentW = 0;
        for (let i = 0; i < chips.length; i++) {
          const chip = chips[i];
          contentW += chip.width != null ? parseFloat(`${chip.width}`) : 0;
        }
        // chip 间的 12rpx margin-right（含末枚）
        contentW += chips.length * rpxToPx(12);
        const overflow = contentW > vw + 1;
        toolsOverflow.value = overflow;
        toolsRowWidthPx.value = overflow ? Math.ceil(contentW) + 2 : 0;
        if (overflow != true) {
          homeToolsExpanded.value = false;
        }
      });
  }

  /** 分类 pill 行同因：溢出时把行宽设为实测内容宽（iOS 不认 max-content） */
  function measureCategoryOverflow(attempt: number): void {
    if (pageInstance == null || pageInstance.proxy == null) return;
    uni.createSelectorQuery()
      .in(pageInstance.proxy)
      .select(".create-hub__category-capsule")
      .boundingClientRect()
      .selectAll(".create-hub__category")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        const ready = results.length >= 2 &&
          results[0] != null &&
          results[1] != null &&
          Array.isArray(results[1]);
        if (ready != true) {
          if (attempt < 2) {
            setTimeout(() => { measureCategoryOverflow(attempt + 1); }, 180);
          }
          return;
        }
        const capsule = results[0] as NodeInfo;
        const items = results[1] as NodeInfo[];
        const vw = capsule.width != null ? parseFloat(`${capsule.width}`) : 0;
        let contentW = 0;
        for (let i = 0; i < items.length; i++) {
          contentW += items[i].width != null ? parseFloat(`${items[i].width}`) : 0;
        }
        // 8rpx 胶囊内边距两侧
        contentW += rpxToPx(16);
        categoryListWidthPx.value = contentW > vw + 1 ? Math.ceil(contentW) + 2 : 0;
      });
  }

  // ── 5.3 分类面板（开/关/手势） ──

  /** 收起后复位：取消分类选中与滚动指示（已选推荐位不受影响，仍回显于输入框） */
  function resetCategorySelection(): void {
    if (userPickedCategory.value.length > 0) {
      userPickedCategory.value = "";
    }
    if (categoryScrollInto.value.length > 0) {
      categoryScrollInto.value = "";
    }
    panelScrollTop = 0;
    categoryRenderVersion.value += 1;
  }

  /** 面板展开：先实测胶囊视口位置再挂载（根级 fixed 锚点）；
      若正处于离场中则取消卸载并复播入场；测量失败则不开（浮层三件套一体渲染） */
  function openPanel(): void {
    const requestId = categoryPanelRequestId + 1;
    categoryPanelRequestId = requestId;
    const requestedCategory = activeCategory.value;
    if (panelCloseTimer != 0) {
      clearTimeout(panelCloseTimer);
      panelCloseTimer = 0;
    }
    categoryPanelClosing.value = false;
    if (pageInstance == null || pageInstance.proxy == null) {
      return;
    }
    uni.createSelectorQuery()
      .in(pageInstance.proxy)
      .select(".create-hub__category-capsule")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        if (requestId != categoryPanelRequestId || requestedCategory != activeCategory.value) return;
        if (results.length < 1 || results[0] == null) {
          categoryPanelVisible.value = false;
          return;
        }
        const rect = results[0] as NodeInfo;
        const top = rect.top != null ? parseFloat(`${rect.top}`) : 0;
        const height = rect.height != null ? parseFloat(`${rect.height}`) : 0;
        if (top != top || height != height || top < 0 || height <= 0) {
          categoryPanelVisible.value = false;
          return;
        }
        categoryCapsuleTopPx.value = Math.round(top);
        categoryCapsuleBottomPx.value = Math.round(top + height);
        categoryPanelVisible.value = true;
      });
  }

  /** 面板收起：挂离场动画类播完后再卸载 DOM，并取消分类选中态 */
  function closePanel(): void {
    categoryPanelRequestId += 1;
    if (categoryPanelVisible.value != true) {
      resetCategorySelection();
      return;
    }
    categoryPanelClosing.value = true;
    if (panelCloseTimer != 0) {
      clearTimeout(panelCloseTimer);
    }
    // 原生端没有 CSS keyframes，立即卸载命中层，避免透明宿主继续吞掉后续点击。
    // #ifndef H5
    categoryPanelVisible.value = false;
    categoryPanelClosing.value = false;
    panelCloseTimer = 0;
    resetCategorySelection();
    return;
    // #endif
    // #ifdef H5
    panelCloseTimer = setTimeout(() => {
      categoryPanelVisible.value = false;
      categoryPanelClosing.value = false;
      panelCloseTimer = 0;
      resetCategorySelection();
    }, 200) as number;
    // #endif
  }

  /** 二级面板：上滑手势关闭（终点高于起点超过阈值即视为上滑）；内容滚离顶部时上滑交给内容滚动 */
  let panelTouchStartY = 0;

  function onPanelTouchStart(e: TouchEvent): void {
    const touches = e.touches;
    if (touches.length > 0) {
      panelTouchStartY = touches[0].clientY;
    }
  }

  function onPanelTouchEnd(e: TouchEvent): void {
    const touches = e.changedTouches;
    if (touches.length == 0) {
      return;
    }
    if (panelScrollTop > 0) {
      return;
    }
    if (panelTouchStartY - touches[0].clientY > 40) {
      closePanel();
    }
  }

  /** 面板内容滚动位置同步：仅顶部上滑视为收起手势 */
  function onPanelGridScroll(e: UniScrollEvent): void {
    panelScrollTop = e.detail.scrollTop;
  }

  /** 白卡内点击仅阻断冒泡（宿主 click=关闭，卡内空白不关闭） */
  function onPanelCardTap(): void {}

  // ── 5.4 推荐位 / 分类选择 ──

  /** 清空推荐位选中及其派生门控（多处复用） */
  function clearRecommendState(): void {
    selectedRecommend.value = null;
    recommendAllowAtSkill.value = 1;
    recommendEnableVersionControl.value = 0;
    recommendPlaceholder.value = "";
  }

  /** 复位电脑选择与工作目录为云端默认（切推荐/上框/锁定云端共用） */
  function resetComputerSelection(): void {
    currentComputerId.value = "-1";
    currentComputerName.value = t("Mobile.CreateHub.selectComputer");
    workspacePath.value = "";
  }

  function clearSummonedExpert(): void {
    summonedExpertId.value = 0;
    summonedExpertName.value = "";
    summonedExpertIcon.value = "";
    summonedExpertType.value = "ChatBot";
    summonedExpertEnableVersionControl.value = 0;
    summonedExpertAllowAtSkill.value = 1;
  }

  /** 推荐位选中 → 拉详情联动门控/placeholder（对齐 PC currentAgentId → agentDetail） */
  async function loadRecommendDetail(targetId: number): Promise<void> {
    recommendAllowAtSkill.value = 1;
    recommendEnableVersionControl.value = 0;
    recommendPlaceholder.value = selectedRecommend.value != null ? selectedRecommend.value.placeholder : "";
    try {
      const res = await apiPublishedAgentInfo(targetId, false);
      if (apiResCode(res) != SUCCESS_CODE) return;
      const detail = resObject(apiResData<any>(res));
      if (detail == null) return;
      const recommend = selectedRecommend.value;
      if (recommend == null || recommend.targetId != targetId) return;
      recommendAllowAtSkill.value = detail["allowAtSkill"] == 1 ? 1 : 0;
      recommendEnableVersionControl.value = detail["enableVersionControl"] == 1 ? 1 : 0;
    } catch (_error) {
      // 详情失败保留推荐位自带能力（placeholder 已就位）
    }
  }

  /** 推荐位 pill 点击（对齐 PC handleRecommendSelect）：显式切换会话对象，清召唤态；全栈上框已选中项再点不取消 */
  function handleRecommendSelect(item: DisplayRecommendInfo): void {
    const current = selectedRecommend.value;
    if (current != null && current.id == item.id) {
      // 全栈上框：已选中项再点不取消（回落会出范围到租户默认；对齐 PC）
      if (isUserAppPinned.value) return;
      // 同项再点取消 → 回落默认
      clearRecommendState();
    } else {
      selectedRecommend.value = item;
      loadRecommendDetail(item.targetId);
    }
    // 显式切换/取消：清召唤态、模型复位、清输入并聚焦
    clearSummonedExpert();
    currentModelId.value = 0;
    currentModelName.value = "";
    resetComputerSelection();
    callInputRef("clear");
    callInputRef("focus");
  }

  /** 面板内选推荐位：沿用 pill 选中逻辑并收起面板 */
  function handlePanelRecommendSelect(item: DisplayRecommendInfo): void {
    closePanel();
    handleRecommendSelect(item);
  }

  /** 上框期间推荐位可选性（对齐 PC isAgentSelectable：非同类型置灰不可选） */
  function isPanelItemSelectable(item: DisplayRecommendInfo): boolean {
    const pinned = pinnedProject.value;
    if (pinned == null) return true;
    return isRecommendSelectable(item.functionType, pinned.projectType);
  }

  /** 面板项点击：置灰项拦截提示，可选项走选中逻辑；离场动画期间面板即将卸载，忽略误触 */
  function handlePanelItemClick(item: DisplayRecommendInfo): void {
    if (categoryPanelClosing.value == true) {
      return;
    }
    if (isPanelItemSelectable(item) != true) {
      uni.showToast({ title: t("Mobile.CreateHub.pinnedTypeLocked"), icon: "none" });
      return;
    }
    handlePanelRecommendSelect(item);
  }

  /** 分类切换：默认无选中；点选即选中并展开面板；再点同分类收起并取消选中 */
  function handleCategoryChange(key: string): void {
    if (userPickedCategory.value == key) {
      // 再点同一分类：收起面板（closePanel 卸载后取消选中态）
      closePanel();
      return;
    }
    userPickedCategory.value = key;
    // iOS 原生端切换选中 pill 时偶发复用上一项的 CALayer 阴影；每次切换都重建 pill 行，
    // 不能只在关闭面板时重建，否则连续切换分类会留下旧阴影。
    categoryRenderVersion.value += 1;
    // 选中分类滚入胶囊可视区
    categoryScrollInto.value = key;
    // 切分类只是浏览：不清理已选推荐智能体/召唤专家/模型/电脑/输入，
    // 仅当用户明确点选了面板里的推荐项时才清理（见 handleRecommendSelect）
    if (activeCategoryItems.value.length > 0) {
      openPanel();
    } else {
      closePanel();
    }
  }

  /** 上框清除（对齐 PC onClearSelectedTag）：恢复首页默认形态 */
  function handleClearSelectedTag(): void {
    if (isProjectAgentLocked.value) return;
    clearRecommendState();
    callInputRef("focus");
  }

  // ── 5.5 上框项目 ──

  /** 上框默认命中（对齐 PC）：全栈按 devAgentId 精确命中 → 同类型唯一兜底；未命中提示手选（每项目一次） */
  function resolvePinnedAgentHit(): void {
    const pinned = pinnedProject.value;
    // 用户在项目上框后主动选了专家时，不再用项目默认推荐覆盖/叠加。
    if (pinned == null || selectedRecommend.value != null || summonedExpertId.value > 0) return;
    // 对齐 PC：仅全栈（UserApp）上框才做自动命中与未命中提示；
    // 常规项目不自动命中也不提示——保留用户手选，未手选时发送由后端兜默认
    if (pinned.projectType != "UserApp") return;
    const list = recommendNavList.value;
    if (list.length == 0) return; // 推荐列表未就绪不做未命中判定
    let hit = findDefaultAgent(list, pinned.projectType, pinned.devAgentId);
    if (hit == null) hit = findTypeFallbackAgent(list, pinned.projectType);
    if (hit != null) {
      selectedRecommend.value = hit;
      loadRecommendDetail(hit.targetId);
      // 对齐 PC：命中项自带分类时切到该分类（胶囊高亮同步）
      if (hit.category.length > 0) {
        userPickedCategory.value = hit.category;
        categoryScrollInto.value = hit.category;
      }
      return;
    }
    if (pinnedMissedProjectId != pinned.projectId) {
      pinnedMissedProjectId = pinned.projectId;
      uni.showToast({ title: t("Mobile.CreateHub.pinnedAgentMissed"), icon: "none" });
    }
  }

  /** 上框项目落地（对齐 PC consumePinnedProject）：切换项目时清旧会话对象及互斥选择 */
  function applyPinnedProject(project: PinnedProjectInfo): void {
    const current = pinnedProject.value;
    if (current != null && current.projectId == project.projectId) {
      // 同项目重复 pin：只刷新数据不重置选择态（避免命中项弹回默认）
      pinnedProject.value = project;
      return;
    }
    pinnedProject.value = project;
    pinnedMissedProjectId = 0;
    clearSummonedExpert();
    clearRecommendState();
    closePanel();
    currentModelId.value = 0;
    currentModelName.value = "";
    // 新项目不能继承上一位专家或模型；同项目重复 pin 在上方提前返回，不影响当前输入。
    resetComputerSelection();
    // 推荐列表已就绪则立即尝试默认命中
    resolvePinnedAgentHit();
    callInputRef("focus");
  }

  /** 移除上框：恢复首页默认形态（对齐 PC handleClearPinnedProject） */
  function handleClearPinnedProject(): void {
    pinnedProject.value = null;
    pinnedMissedProjectId = 0;
    clearRecommendState();
    userPickedCategory.value = "";
    categoryScrollInto.value = "";
    workspacePath.value = "";
    resetComputerSelection();
    // 对齐 PC：移除上框时清输入并聚焦
    callInputRef("clear");
    callInputRef("focus");
  }

  // ── 5.6 输入区联动 ──

  /** 工作目录选择（对齐 PC onWorkspaceDirChange：空串 = 默认工作目录） */
  function handleWorkspaceDirSelect(path: string): void {
    workspacePath.value = path;
  }

  function handleSpaceSelect(spaceId: number): void {
    selectedSpaceId.value = spaceId;
  }

  function handleModelChange(modelId: number, name: string): void {
    currentModelId.value = modelId;
    currentModelName.value = name;
  }

  function handleComputerChange(computerId: string, name: string): void {
    currentComputerId.value = computerId;
    currentComputerName.value = name;
    // 对齐 PC：切回云电脑时清掉已选工作目录（仅个人电脑沙箱生效）
    if (computerId == "-1" && workspacePath.value.length > 0) {
      workspacePath.value = "";
    }
  }

  function handleInputAction(action: string): void {
    closePanel();
    const labels = new Map<string, string>();
    labels.set("connector", t("Mobile.CreateHub.connector"));
    labels.set("knowledge", t("Mobile.CreateHub.knowledgeBase"));
    labels.set("version", t("Mobile.CreateHub.versionManagement"));
    const label = labels.get(action);
    uni.showToast({ title: label != null ? `${label}即将接入` : t("Mobile.Common.comingSoon"), icon: "none" });
  }

  /** 输入区开始编辑时撤掉分类浮层，避免两套根级命中层并存。草稿与推荐选择保持不变。 */
  function handleInputFocusChange(focused: boolean): void {
    if (focused == true) closePanel();
  }

  /** 能力弹窗选专家 = 切换会话智能体（对齐 PC onExpertAgentSelect），清掉推荐选中避免误触发建项目分支 */
  async function handleExpertAgentSelect(item: UTSJSONObject): Promise<void> {
    // 分类已按项目类型锁定时，外部搜索/快捷选择同样不能绕过限制。
    if (projectExpertRestricted.value) return;
    const targetId = numFromAny(item["targetId"], 0);
    if (targetId <= 0) return;
    clearRecommendState();
    summonedExpertId.value = targetId;
    summonedExpertName.value = strOf(item["name"]);
    summonedExpertIcon.value = strOf(item["icon"]);
    summonedExpertType.value = "ChatBot";
    summonedExpertEnableVersionControl.value = 0;
    summonedExpertAllowAtSkill.value = 1;
    try {
      const res = await apiPublishedAgentInfo(targetId, false);
      if (apiResCode(res) == SUCCESS_CODE) {
        const detail = resObject(apiResData<any>(res));
        if (detail != null && summonedExpertId.value == targetId) {
          const typeStr = strOf(detail["type"]);
          summonedExpertType.value = typeStr.length > 0 ? typeStr : "ChatBot";
          summonedExpertEnableVersionControl.value = detail["enableVersionControl"] == 1 ? 1 : 0;
          // 对齐 PC 会话页口径：仅 allowAtSkill==1 才开放技能入口
          summonedExpertAllowAtSkill.value = detail["allowAtSkill"] == 1 ? 1 : 0;
        }
      }
    } catch (_error) {
      // 列表数据足够创建会话；详情失败时保留 ChatBot 默认能力。
    }
  }

  // ── 5.7 数据加载 ──

  /** 空间列表（对齐 PC SpaceSelector 挂载即拉；未选中或选中项不在列表 → 自动选首项） */
  async function loadSpaces(): Promise<void> {
    try {
      const res = await apiSpaceList();
      if (apiResCode(res) != SUCCESS_CODE) return;
      const rows = objectRows(apiResData<any>(res));
      const list = [] as SpaceOptionInfo[];
      for (let i = 0; i < rows.length; i++) {
        const row = rows[i];
        const item = new SpaceOptionInfo();
        item.id = numFromAny(row["id"], 0);
        item.name = strOf(row["name"]);
        item.description = strOf(row["description"]);
        item.icon = strOf(row["icon"]);
        if (item.id > 0 && item.name.length > 0) list.push(item);
      }
      spaceList.value = list;
      let inList = false;
      for (let i = 0; i < list.length; i++) {
        if (list[i].id == selectedSpaceId.value) { inList = true; break; }
      }
      if (inList != true && list.length > 0) {
        selectedSpaceId.value = list[0].id;
      }
    } catch (_error) {
      spaceList.value = [] as SpaceOptionInfo[];
    }
  }

  /** 类型体系数据加载（对齐 PC runRecommendNavList + fetchChatboxCategories；onShow 触发但只拉一次） */
  async function loadChatboxNav(): Promise<void> {
    if (chatboxNavLoaded == true) return;
    // 分类与推荐并行；任一失败保持空（区域整体不渲染，下次 onShow 重试）
    try {
      const categories = await fetchChatboxCategories();
      chatboxCategories.value = categories;
      console.log("[home] chatbox categories:", categories.length);
    } catch (_catError) {
      console.warn("[home] chatbox categories failed");
    }
    try {
      const res = await apiDisplayRecommendList();
      if (apiResCode(res) == SUCCESS_CODE) {
        const data = resObject(apiResData<any>(res));
        if (data != null) {
          const navRaw = data["recChatBoxNav"];
          if (navRaw != null) {
            const agentRaw = (navRaw as UTSJSONObject)["Agent"];
            // Android data 为 UTSArray：JSON 往返转真数组（对齐 home-header 已验证模式）
            const rows = objectRows(agentRaw);
            if (rows.length > 0) {
              const list = [] as DisplayRecommendInfo[];
              for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                const item = new DisplayRecommendInfo();
                item.id = numFromAny(row["id"], 0);
                item.targetType = strOf(row["targetType"]);
                item.targetId = numFromAny(row["targetId"], 0);
                item.functionType = strOf(row["functionType"]);
                item.label = strOf(row["label"]);
                item.icon = strOf(row["icon"]);
                item.placeholder = strOf(row["placeholder"]);
                item.category = strOf(row["category"]);
                item.sort = numFromAny(row["sort"], 0);
                if (item.targetId > 0 && item.label.length > 0) list.push(item);
              }
              // 按 sort 升序（对齐 PC）
              const sorted = [...list].sort((a: DisplayRecommendInfo, b: DisplayRecommendInfo): number => a.sort - b.sort);
              recommendNavList.value = sorted;
              // 上框等待推荐列表就绪后做默认命中
              resolvePinnedAgentHit();
            }
          }
        }
      }
    } catch (_error) {
      recommendNavList.value = [] as DisplayRecommendInfo[];
    }
    console.log("[home] recommends:", recommendNavList.value.length);
    if (recommendNavList.value.length > 0 || chatboxCategories.value.length > 0) {
      chatboxNavLoaded = true;
    }
  }

  /** 当前智能体详情的提示问题，兼容 GuidQuestionDto[] 和旧版 string[]。 */
  function parseHomeGuideQuestions(raw: any | null): ExpertGuideQuestionInfo[] {
    const result = [] as ExpertGuideQuestionInfo[];
    if (raw == null) return result;
    try {
      const jsonStr = JSON.stringify(raw);
      if (jsonStr == null || jsonStr.length == 0) return result;
      const parsed = JSON.parse<any[]>(jsonStr);
      if (parsed == null) return result;
      for (let i = 0; i < parsed.length; i++) {
        const item = parsed[i];
        const question = new ExpertGuideQuestionInfo();
        if (typeof item == "string") {
          question.info = `${item}`.trim();
        } else if (item != null) {
          const itemJson = JSON.stringify(item);
          if (itemJson == null || itemJson.length == 0) continue;
          const obj = JSON.parse<UTSJSONObject>(itemJson);
          if (obj == null) continue;
          const type = strOf(obj["type"]);
          question.type = type.length > 0 ? type : "Question";
          question.info = strOf(obj["info"]).trim();
          question.icon = strOf(obj["icon"]);
          question.url = strOf(obj["url"]);
          question.pageUrl = strOf(obj["pageUrl"]);
        }
        if (question.info.length > 0) result.push(question);
      }
    } catch (_error) {
      return [] as ExpertGuideQuestionInfo[];
    }
    return result;
  }

  /** 会话对象详情派生门控（对齐 PC agentDetail：allowOtherModel/allowChooseMode/manualComponents；详情未到保持放开默认） */
  async function loadActiveAgentDetail(agentId: number): Promise<void> {
    activeAllowOtherModel.value = true;
    activeAllowChooseMode.value = 1;
    activeAllowPrivateSandbox.value = false;
    activeAgentSandboxId.value = "";
    activeDetailAgentType.value = "ChatBot";
    activeManualComponents.value = [] as AgentManualComponentInfo[];
    activeGuideQuestions.value = [] as ExpertGuideQuestionInfo[];
    if (agentId <= 0) return;
    try {
      const res = await apiPublishedAgentInfo(agentId, false);
      if (apiResCode(res) != SUCCESS_CODE) return;
      // 快速切换守卫（对齐 PC 禅道bug2394：旧响应晚到不得覆盖新对象详情）
      if (activeAgentId.value != agentId) return;
      const detail = resObject(apiResData<any>(res));
      if (detail == null) return;
      let guideQuestions = parseHomeGuideQuestions(detail["guidQuestionDtos"]);
      if (guideQuestions.length == 0) guideQuestions = parseHomeGuideQuestions(detail["openingGuidQuestions"]);
      activeGuideQuestions.value = guideQuestions;
      const modelRaw = detail["allowOtherModel"];
      activeAllowOtherModel.value = modelRaw == null ? true : modelRaw != 0;
      activeAllowChooseMode.value = numFromAny(detail["allowChooseMode"], 1);
      // 私有沙箱能力（对齐 PC allowPrivateSandbox：非 1 = 隐藏电脑选择器）
      activeAllowPrivateSandbox.value = detail["allowPrivateSandbox"] == 1;
      // 详情 type（对齐 PC agentDetail.type：参与电脑选择器显隐的 agentType 操作数）
      const typeStr = strOf(detail["type"]);
      activeDetailAgentType.value = typeStr == "TaskAgent" || typeStr == "PageApp" ? typeStr : "ChatBot";
      // 绑定沙箱（对齐 PC agentSandboxId：优先于用户电脑选择；云端哨兵/缺失视为未绑定）
      const sandboxStr = strOf(detail["sandboxId"]);
      activeAgentSandboxId.value = sandboxStr.length > 0 && sandboxStr != "-1" && sandboxStr != "0" ? sandboxStr : "";
      // 工具列表（对齐 PC manualComponents：输入区上方勾选）
      const comps = objectRows(detail["manualComponents"]);
      if (comps.length > 0) {
        const parsed = [] as AgentManualComponentInfo[];
        for (let i = 0; i < comps.length; i++) {
          parsed.push(new HomeManualComponent(comps[i]));
        }
        activeManualComponents.value = parsed;
      }
    } catch (_error) {
      // 详情失败保持放开默认
    }
  }

  /** 首页品牌配置（对齐 PC tenantConfigInfo：站点标题 + homeSlogan）。 */
  function applyHomeBranding(config: UTSJSONObject): void {
    const nodes = parseHomeSloganNodes(strOf(config["homeSlogan"]));
    homeHeroNodes.value = nodes.length > 0
      ? nodes
      : parseHomeSloganNodes(t("Mobile.CreateHub.heroTitle"));

    const siteName = strOf(config["siteName"]).trim();
    if (siteName.length > 0) {
      uni.setNavigationBarTitle({ title: siteName });
    }
  }

  /** 租户默认智能体与首页品牌（对齐 PC：本地缓存先行，接口刷新覆盖） */
  function applyDefaultAgentConfig(config: UTSJSONObject): number {
    applyHomeBranding(config);
    const id = numFromAny(config["defaultAgentId"], 0);
    defaultAgentId.value = id;
    return id;
  }

  async function loadDefaultAgentEntry(): Promise<void> {
    try {
      let agentId = 0;
      const cachedRaw = uni.getStorageSync(TENANT_CONFIG_INFO);
      if (cachedRaw != null && `${cachedRaw}`.length > 0) {
        try {
          const cached = JSON.parse<UTSJSONObject>(`${cachedRaw}`);
          if (cached != null) {
            agentId = applyDefaultAgentConfig(cached);
          }
        } catch (_e) {
          agentId = 0;
        }
      }

      const configRes = await apiTenantConfig();
      if (apiResCode(configRes) == SUCCESS_CODE) {
        const configData = apiResData<any>(configRes);
        if (configData != null) {
          uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(configData));
          const config = resObject(configData);
          if (config != null) {
            agentId = applyDefaultAgentConfig(config);
          }
        }
      }

      if (agentId > 0) {
        const detailRes = await apiPublishedAgentInfo(agentId, false);
        if (apiResCode(detailRes) == SUCCESS_CODE) {
          const detail = resObject(apiResData<any>(detailRes));
          if (detail != null) {
            const nameStr = strOf(detail["name"]);
            const typeStr = strOf(detail["type"]);
            defaultAgentName.value = nameStr.length > 0 ? nameStr : t("Mobile.Common.appName");
            defaultAgentType.value = typeStr.length > 0 ? typeStr : "ChatBot";
            defaultEnableVersionControl.value = detail["enableVersionControl"] == 1 ? 1 : 0;
          }
        }
      }
    } catch (error) {
      console.error("加载创建页默认智能体失败", error);
    }
  }

  /** 登录校验：未登录时微信弹登录 / 其余端跳登录页，返回是否可继续发送 */
  async function ensureLoggedIn(): Promise<boolean> {
    const loggedIn = await hasToken();
    if (loggedIn == true) {
      return true;
    }
    // #ifdef MP-WEIXIN
    await checkAuthAndShowPopup();
    return false;
    // #endif
    // #ifndef MP-WEIXIN
    goToLogin(true);
    return false;
    // #endif
  }

  // ── 5.8 发送链路（载荷归一 → 建项目 / 建会话 → 草稿交接） ──

  /**
   * 组件发送载荷 → 纯 JSON 值（跨平台兼容唯一入口）。
   * conversation-input emit 的 payload 里混有 UTS class 实例数组（AgentSelectedComponentInfo[] /
   * SelectedDocInfo[]）与 UTSJSONObject[]（files）：Android(Kotlin 泛型擦除后的 as 强转) /
   * iOS(Swift as 强转) 直接按具体类型读取都会 ClassCastException。
   * JSON 往返统一成纯 JSON 值（仓库已验证模式，PendingChatDraft 落盘同源），
   * 之后 type 字段为字符串，必须经 parseComponentType 还原枚举。
   */
  function normalizeSendPayload(data: any): UTSJSONObject {
    const jsonStr = JSON.stringify(data);
    if (jsonStr == null || jsonStr.length == 0) {
      return {} as UTSJSONObject;
    }
    const parsed = JSON.parse<UTSJSONObject>(jsonStr);
    return parsed != null ? parsed : ({} as UTSJSONObject);
  }

  /** 归一化后的 files → 草稿附件（fileUrl/mimeType/fileName/fileKey/fileSize） */
  function collectAttachments(filesRaw: any | null): UTSJSONObject[] {
    const result: UTSJSONObject[] = [];
    if (filesRaw == null || Array.isArray(filesRaw) != true) {
      return result;
    }
    const rows = filesRaw as UTSJSONObject[];
    for (let i = 0; i < rows.length; i++) {
      const file = rows[i];
      const item: UTSJSONObject = {} as UTSJSONObject;
      item["fileUrl"] = strOf(file["url"]);
      item["mimeType"] = strOf(file["type"]);
      item["fileName"] = strOf(file["name"]);
      item["fileKey"] = strOf(file["key"]);
      item["fileSize"] = numFromAny(file["size"], 0);
      result.push(item);
    }
    return result;
  }

  /** 发送载荷的公共解析（skillIds/模型/沙箱/组件/模式/资料文档）填入草稿；建项目/建会话两分支共用 */
  function applySendPayloadToDraft(draft: PendingChatDraft, payload: UTSJSONObject, sandboxFallback: string, wsPath: string): void {
    // 技能
    const skillsRaw = payload["skillIds"];
    if (skillsRaw != null && Array.isArray(skillsRaw)) {
      const skills = skillsRaw as any[];
      for (let i = 0; i < skills.length; i++) {
        const id = numFromAny(skills[i], 0);
        if (id > 0) draft.skillIds.push(id);
      }
    }
    // 模型（载荷未带时回落页面当前选择）
    draft.modelId = numField(payload, "modelId", currentModelId.value);
    const modelName = strOf(payload["modelName"]);
    draft.modelName = modelName.length > 0 ? modelName : currentModelName.value;
    // 沙箱
    const sandboxStr = strOf(payload["sandboxId"]);
    draft.sandboxId = sandboxStr.length > 0 ? sandboxStr : sandboxFallback;
    draft.workspacePath = wsPath;
    // 输入区自带组件（载荷经 JSON 往返后 type 为字符串 → parseComponentType 还原枚举）
    const compsRaw = payload["selectedComponents"];
    if (compsRaw != null && Array.isArray(compsRaw)) {
      const comps = compsRaw as any[];
      for (let i = 0; i < comps.length; i++) {
        const row = comps[i] as UTSJSONObject;
        const id = numField(row, "id", 0);
        if (id <= 0) continue;
        const type = parseComponentType(strOf(row["type"]));
        draft.selectedComponents.push(new AgentSelectedComponentInfo(id, type));
      }
    }
    // 模式（仅任务智能体载荷会带）
    const agentMode = strOf(payload["agentMode"]);
    if (agentMode == "ask" || agentMode == "yolo") {
      draft.agentMode = agentMode;
    }
    // 已选资料库文档（对齐 PC selectedDocs：随首条消息发送）
    const docsRaw = payload["selectedDocs"];
    if (docsRaw != null && Array.isArray(docsRaw)) {
      const docs = docsRaw as any[];
      for (let i = 0; i < docs.length; i++) {
        const row = docs[i] as UTSJSONObject;
        const doc = new SelectedDocInfo();
        doc.slugId = strOf(row["slugId"]);
        doc.title = strOf(row["title"]);
        doc.pageType = strOf(row["pageType"]);
        if (doc.slugId.length > 0) draft.selectedDocs.push(doc);
      }
    }
  }

  /** 建会话响应 → conversationId（失败 0） */
  function parseConversationId(dataRaw: any | null): number {
    const parsed = resObject(dataRaw);
    if (parsed == null) return 0;
    return numFromAny(parsed["id"], 0);
  }

  /** 项目创建响应 → 项目 id / 附加数字字段（失败 0） */
  function readCreatedTargetId(dataRaw: any | null): number {
    const obj = resObject(dataRaw);
    if (obj == null) return 0;
    const idRaw = obj["targetId"];
    return numFromAny(idRaw, 0);
  }

  function readCreatedNumber(dataRaw: any | null, key: string): number {
    const obj = resObject(dataRaw);
    if (obj == null) return 0;
    return numFromAny(obj[key], 0);
  }

  function failProjectCreate(message: string): void {
    uni.hideLoading();
    uni.showToast({
      title: message.length > 0 ? message : t("Mobile.CreateHub.createProjectFailed"),
      icon: "none",
    });
  }

  function resolveAgentType(): "ChatBot" | "PageApp" | "TaskAgent" {
    const rawType = activeAgentType.value;
    if (rawType == "PageApp") {
      return "PageApp";
    }
    if (rawType == "TaskAgent") {
      return "TaskAgent";
    }
    return "ChatBot";
  }

  /** 建草稿并落盘（agent-detail 页消费后发送首条消息） */
  function saveDraft(agentId: number, conversationId: number, message: string, attachments: UTSJSONObject[], payload: UTSJSONObject, sandboxId: string, wsPath: string): void {
    const draft = new PendingChatDraft();
    draft.createdAt = Date.now();
    draft.agentId = agentId;
    draft.conversationId = conversationId;
    draft.message = message;
    draft.attachments = attachments;
    applySendPayloadToDraft(draft, payload, sandboxId, wsPath);
    console.log(`[pending-chat-draft] saved conversationId=${conversationId} toolCount=${draft.selectedComponents.length}`);
    savePendingChatDraft(draft);
  }

  /**
   * 项目类推荐分支（对齐 PC buildHomeSendPlan）：
   * 常规/全栈/网页应用统一走 /api/project/create；创建成功即建首会话并带草稿跳转。
   * 返回 true = 已接管本次发送（含失败提示），调用方直接返回。
   */
  async function tryCreateProjectFlow(agentId: number, message: string, attachments: UTSJSONObject[], payload: UTSJSONObject): Promise<boolean> {
    // 上框期间不走建项目分支（会话直接绑定项目）；仅推荐位 functionType 映射出项目类型时触发
    const pinned = pinnedProject.value;
    const recommend = selectedRecommend.value;
    const functionType = recommend != null ? recommend.functionType : "";
    const projectType = pinned == null ? getProjectTypeByFunctionType(functionType) : "";
    if (projectType.length == 0) return false;

    projectCreating.value = true;
    uni.showLoading({ title: t("Mobile.Page.loading"), mask: true });
    // 后端 name 必填：取消息前 30 字作项目名（PC 语义里 prompt 才是首条消息正文）
    // let projectName = message.split("\n").join("").split("\t").join("").split(" ").join("");
    // if (projectName.length > 30) projectName = projectName.substring(0, 30);
    // if (projectName.length == 0) projectName = recommend != null ? recommend.label : "";
    // sandboxId=当前电脑、devAgentId=当前选中智能体、workspacePath 仅个人电脑生效；
    // prompt 不随创建传——建完首会话后由会话页发送（经 PendingChatDraft 交接）
    const payloadSandboxId = strOf(payload["sandboxId"]);
    const createSandboxId = payloadSandboxId.length > 0
      ? payloadSandboxId
      : (currentComputerId.value.length > 0 ? currentComputerId.value : "-1");
    const sandboxNum = numFromAny(parseFloat(createSandboxId), -1);
    const createWorkspacePath = resolvePersonalWorkspacePath(createSandboxId, workspacePath.value);
    try {
      const res = await apiProjectCreateUnified(
        selectedSpaceId.value,
        projectType,
        // projectName,
        "",
        Math.round(sandboxNum),
        agentId,
        createWorkspacePath,
      );
      const dataRaw = apiResData<any>(res);
      if (apiResCode(res) == SUCCESS_CODE && readCreatedTargetId(dataRaw) > 0) {
        const convId = readCreatedNumber(dataRaw, "conversationId");
        const resAgentId = readCreatedNumber(dataRaw, "agentId");
        const finalAgentId = resAgentId > 0 ? resAgentId : agentId;
        uni.hideLoading();
        uni.showToast({ title: t("Mobile.CreateHub.createProjectSuccess"), icon: "success" });
        callRefMethod(drawerRef.value, "refreshProjects");
        const projectId = readCreatedTargetId(dataRaw);
        if (convId > 0 && finalAgentId > 0 && projectId > 0) {
          const chatPType = projectType == "UserApp" ? "UserApp" : "NormalProject";
          saveDraft(finalAgentId, convId, message, attachments, payload, createSandboxId, createWorkspacePath);
          // 全栈项目跳转 id 为项目 id；常规项目跳转 id 为智能体 id（草稿仍按 agentId 存、convId 取）
          const jumpId = projectType == "UserApp" ? projectId : finalAgentId;
          setTimeout(() => {
            projectCreating.value = false;
            jumpToAgentDetailPage(jumpId, convId, "ChatBot", "", chatPType);
          }, 600) as number;
        } else {
          projectCreating.value = false;
        }
      } else {
        projectCreating.value = false;
        failProjectCreate(apiResMessage(res));
      }
    } catch (error) {
      console.error("performProjectCreate error:", error);
      projectCreating.value = false;
      failProjectCreate("");
    }
    return true;
  }

  /**
   * 发送入口（首页首条消息）：
   * 建项目（项目类推荐）> 建会话绑定上框项目 > 建普通会话；
   * 双击防护覆盖两分支（sending / projectCreating 任一进行中直接忽略）。
   */
  async function handleSendMessage(data: any): Promise<void> {
    if (sending.value == true || projectCreating.value == true) {
      return;
    }
    const payload = normalizeSendPayload(data);
    const message = strOf(payload["messageInfo"]).trim();
    const attachments = collectAttachments(payload["files"]);
    if (message.length == 0 && attachments.length == 0) {
      return;
    }
    const loggedIn = await ensureLoggedIn();
    if (loggedIn != true) {
      return;
    }
    const agentId = activeAgentId.value;
    if (agentId <= 0) {
      uni.showToast({
        title: t(pinnedProject.value != null ? "Mobile.CreateHub.pinnedAgentMissed" : "Mobile.CreateHub.noDefaultAgent"),
        icon: "none",
      });
      return;
    }

    // 分支一：项目类推荐 → 建项目（内部自带 loading/toast/跳转）
    const handled = await tryCreateProjectFlow(agentId, message, attachments, payload);
    if (handled) {
      return;
    }

    // 分支二：普通会话（含上框项目绑定）
    sending.value = true;
    uni.showLoading({ title: t("Mobile.Page.loading"), mask: true });
    try {
      const conversationParams: UTSJSONObject = {
        agentId: agentId,
        devMode: false,
      };
      // 沙箱：项目自带沙箱优先，否则保持当前电脑选择（对齐 PC attach）
      const payloadSandboxId = strOf(payload["sandboxId"]);
      let effectiveSandboxId = payloadSandboxId.length > 0 ? payloadSandboxId : currentComputerId.value;
      const pinned = pinnedProject.value;
      if (pinned != null && pinned.sandboxId > 0) {
        effectiveSandboxId = `${pinned.sandboxId}`;
      }
      if (pinned != null) {
        conversationParams["projectId"] = pinned.projectId;
        conversationParams["projectType"] = pinned.projectType;
        // 全栈上框：devAgentId = 当前选中的全栈类智能体（对齐 PC）
        if (pinned.projectType == "UserApp") {
          conversationParams["devAgentId"] = agentId;
        }
      }
      // 工作目录仅个人电脑沙箱生效（对齐 PC resolvePersonalWorkspacePath）
      const effectiveWorkspacePath = resolvePersonalWorkspacePath(effectiveSandboxId, workspacePath.value);
      if (effectiveWorkspacePath.length > 0) {
        conversationParams["workspacePath"] = effectiveWorkspacePath;
      }
      const res = await apiAgentConversationCreate(conversationParams);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({
          title: apiResMessage(res).length > 0 ? apiResMessage(res) : t("Mobile.CreateHub.sendFailed"),
          icon: "none",
        });
        return;
      }
      const convId = parseConversationId(apiResData<any>(res));
      if (convId <= 0) {
        uni.showToast({
          title: t("Mobile.CreateHub.sendFailed"),
          icon: "none",
        });
        return;
      }
      saveDraft(agentId, convId, message, attachments, payload, effectiveSandboxId, effectiveWorkspacePath);
      await jumpToAgentDetailPage(agentId, convId, resolveAgentType(), activeAgentName.value);
    } catch (error) {
      console.error("创建会话失败", error);
      uni.showToast({
        title: t("Mobile.CreateHub.sendFailed"),
        icon: "none",
      });
    } finally {
      sending.value = false;
      uni.hideLoading();
    }
  }

  // ── 5.9 抽屉 / 登录 ──

  async function refreshLoginStateAndDrawer(): Promise<void> {
    isLoggedIn.value = await hasToken();
    // 抽屉开着（如从会话页返回）时静默补差
    callRefMethod(drawerRef.value, "resumeData");
  }

  function handleDrawerOpen(): void {
    if (isLoggedIn.value != true) {
      // 未登录先去登录（抽屉数据依赖登录态）
      // #ifdef MP-WEIXIN
      checkAuthAndShowPopup();
      // #endif
      // #ifndef MP-WEIXIN
      goToLogin(true);
      // #endif
      return;
    }
    callRefMethod(drawerRef.value, "open");
  }

  /** ── 首页右滑呼出抽屉 ──
      Android 系统返回手势先于页面接收物理左缘的触摸，旧 24px 边缘条在真机上
      会触发系统返回。改由导航/主滚动区承接，起点稍离左缘；分类横滑单独阻断。
      方向锁避免抢纵向滚动，滑入动画仍由 page-container 完成。 */
  let edgeSwipeTracking: boolean = false;
  let edgeSwipeStartX: number = 0;
  let edgeSwipeStartY: number = 0;
  let edgeSwipeLocked: boolean = false;
  let edgeSwipeFired: boolean = false;
  /** 右滑触发阈值：窗口宽 20%，下限 56px（对齐 resident-chat-shell__edge-back） */
  function edgeSwipeMinDx(): number {
    const w = rpxToPx(750);
    const byRatio = w * 0.2;
    return byRatio > 56 ? byRatio : 56;
  }

  function resetEdgeSwipeGesture(): void {
    edgeSwipeTracking = false;
    edgeSwipeLocked = false;
  }

  function fireEdgeSwipeOpen(): void {
    edgeSwipeFired = true;
    resetEdgeSwipeGesture();
    handleDrawerOpen();
  }

  function onEdgeSwipeTouchStart(e: any): void {
    if (edgeSwipeTracking) return;
    resetEdgeSwipeGesture();
    edgeSwipeFired = false;
    // 分类面板 / 快捷弹层展开时不抢手势（层级已在其下，此处兜底）
    if (categoryPanelMounted.value || homeQuickPopupVisible.value) {
      return;
    }
    if (e == null) return;
    const event = e as UniTouchEvent;
    if (event.touches == null || event.touches.length != 1) {
      return;
    }
    const t = event.touches[0];
    if (t == null) {
      return;
    }
    // 物理边缘会被 Android 系统返回抢走；内容区左侧 45% 可起滑。
    const minX = rpxToPx(56);
    const maxX = rpxToPx(750) * 0.45;
    if (t.clientX < minX || t.clientX > maxX) return;
    edgeSwipeTracking = true;
    edgeSwipeStartX = t.clientX;
    edgeSwipeStartY = t.clientY;
  }

  function onEdgeSwipeTouchMove(e: any): void {
    if (edgeSwipeTracking != true || edgeSwipeFired == true) {
      return;
    }
    if (e == null) return;
    const event = e as UniTouchEvent;
    if (event.touches == null || event.touches.length == 0) {
      return;
    }
    const t = event.touches[0];
    if (t == null) {
      return;
    }
    const dx = t.clientX - edgeSwipeStartX;
    const dy = t.clientY - edgeSwipeStartY;
    const absDx = dx > 0 ? dx : -dx;
    const absDy = dy > 0 ? dy : -dy;
    if (edgeSwipeLocked != true) {
      // 先竖后横（竖向滚动意图）直接放弃；横向上右且水平主导才锁定
      if (absDy > 12 && absDy > absDx * 0.65) {
        resetEdgeSwipeGesture();
        return;
      }
      if (absDx > 8 && dx > 0 && absDx > absDy * 0.65) {
        edgeSwipeLocked = true;
      } else {
        return;
      }
    }
    if (dx < edgeSwipeMinDx()) {
      return;
    }
    fireEdgeSwipeOpen();
  }

  function onEdgeSwipeTouchEnd(e: any): void {
    if (edgeSwipeTracking == true && edgeSwipeFired != true && e != null) {
      const event = e as UniTouchEvent;
      const touches = event.changedTouches;
      if (touches != null && touches.length > 0) {
        const t = touches[0];
        if (t != null) {
          const dx = t.clientX - edgeSwipeStartX;
          const dy = t.clientY - edgeSwipeStartY;
          const absDx = dx > 0 ? dx : -dx;
          const absDy = dy > 0 ? dy : -dy;
          if (dx >= edgeSwipeMinDx() && absDx > absDy * 0.65) {
            fireEdgeSwipeOpen();
            return;
          }
        }
      }
    }
    resetEdgeSwipeGesture();
  }

  function onEdgeSwipeTouchCancel(): void {
    resetEdgeSwipeGesture();
  }

  /** 抽屉会话点击 → 会话页 */
  function handleConversationClick(item: any): void {
    const obj = resObject(item);
    if (obj == null) return;
    const agentId = numFromAny(obj["agentId"], 0);
    // 项目下的会话：按会话 devTargetType 取跳转 id。常规项目用 agentId，全栈项目用 devTargetId
    const devTargetTypeRaw = obj["devTargetType"];
    const typeRaw = devTargetTypeRaw != null && `${devTargetTypeRaw}`.length > 0
      ? devTargetTypeRaw
      : (obj["pType"] != null ? obj["pType"] : obj["projectType"]);
    const pType = typeRaw != null ? `${typeRaw}` : "";
    if (pType == "NormalProject" || pType == "UserApp") {
      const projectConvId = numFromAny(obj["conversationId"], 0);
      const devTargetId = numFromAny(obj["devTargetId"], 0);
      const jumpId = pType == "UserApp" ? devTargetId : agentId;
      if (jumpId <= 0 || projectConvId <= 0) {
        return;
      }
      jumpToAgentDetailPage(jumpId, projectConvId, "ChatBot", "", pType);
      return;
    }
    const conversationId = numFromAny(obj["id"], 0);
    if (agentId <= 0 || conversationId <= 0) {
      return;
    }
    jumpToAgentDetailPage(agentId, conversationId);
  }

  // ── 5.10 分享标题（微信） ──

  const shareTitle = ref<string>("");
  const fallbackShareTitle = computed<string>((): string => t("Mobile.Nav.home"));

  async function setCurrentShareTitle(): Promise<void> {
    const tenantConfigRaw = uni.getStorageSync(TENANT_CONFIG_INFO);
    const tenantConfigInfoString = orEmpty(tenantConfigRaw);
    if (tenantConfigInfoString.length > 0) {
      try {
        const parsed = JSON.parse<UTSJSONObject>(tenantConfigInfoString);
        if (parsed != null) {
          const siteName = parsed["siteName"] as string | null;
          const siteDescription = parsed["siteDescription"] as string | null;
          let titleStr = "";
          if (siteName != null) {
            titleStr = siteName;
          }
          if (siteDescription != null) {
            titleStr = titleStr.length > 0
              ? titleStr + " " + siteDescription
              : siteDescription;
          }
          shareTitle.value = titleStr;
        }
      } catch (error) {
        console.error("获取本地用户配置失败:", error);
      }
    }
  }

  // ════════════════ 6. watch（只能引用上方已声明的绑定；UTS/Kotlin 前向引用 error18）════════════════

  /** 工具列表重建 → 恢复默认勾选并测溢出（空列表跳过测量，浮层已卸载测不到） */
  watch(activeManualComponents, (list: AgentManualComponentInfo[]) => {
    const defaults = [] as AgentSelectedComponentInfo[];
    for (let i = 0; i < list.length; i++) {
      if (list[i].defaultSelected == DefaultSelectedEnum.Yes) {
        defaults.push(new AgentSelectedComponentInfo(list[i].id, list[i].type));
      }
    }
    selectedToolComponents.value = defaults;
    homeToolsExpanded.value = false;
    if (list.length == 0) {
      toolsOverflow.value = false;
      toolsRowWidthPx.value = 0;
      return;
    }
    // 渲染完成后测量是否需要展开/收起（慢设备未渲染完由测量内部重试兜底）
    setTimeout(() => {
      measureToolsOverflow(0);
    }, 120);
  });

  /** 分类 pill 行渲染后测溢出（iOS 不认 max-content，溢出时需实测内容宽定宽） */
  watch(categoryNavList, (list: HomeCategoryDef[]) => {
    if (list.length == 0) {
      categoryListWidthPx.value = 0;
      return;
    }
    setTimeout(() => {
      measureCategoryOverflow(0);
      measureHomeGuideHeight(0);
    }, 120);
  });

  watch(activeGuideQuestions, (list: ExpertGuideQuestionInfo[]) => {
    if (list.length == 0) return;
    guideScrollHeightPx.value = 220;
    setTimeout((): void => measureHomeGuideHeight(0), 120);
  });

  watch(homeKeyboardOffset, (): void => {
    if (activeGuideQuestions.value.length > 0) {
      setTimeout((): void => measureHomeGuideHeight(0), 120);
    }
  });

  watch(sending, (busy: boolean): void => {
    if (busy != true && activeGuideQuestions.value.length > 0) {
      setTimeout((): void => measureHomeGuideHeight(0), 120);
    }
  });

  /** 锁定云端时复位电脑选择与工作目录（对齐 PC：目录仅个人电脑有效） */
  watch(disablePersonalComputer, (disabled: boolean) => {
    if (disabled) {
      resetComputerSelection();
    }
  });

  /** 会话对象切换 → 重拉详情派生门控（对齐 PC currentAgentId → agentDetail；快速切换旧响应不覆盖） */
  watch(activeAgentId, (agentId: number) => {
    loadActiveAgentDetail(agentId);
  });

  onUnmounted(() => {
    categoryPanelRequestId += 1;
    if (panelCloseTimer != 0) {
      clearTimeout(panelCloseTimer);
      panelCloseTimer = 0;
    }
  });

  // ════════════════ 7. 平台条件块 ════════════════

  // #ifdef APP-IOS
  /** 从其它 Tab 开聊天时盖住首页，避免先闪对话内容再出 web-view */
  const residentChatCover = ref<boolean>(isResidentChatCoverActive());
  function onResidentChatCoverEvent(active: any): void {
    residentChatCover.value = active == true;
  }
  onMounted(() => {
    uni.$on(RESIDENT_CHAT_COVER_EVENT, onResidentChatCoverEvent);
    residentChatCover.value = isResidentChatCoverActive();
  });
  onUnmounted(() => {
    uni.$off(RESIDENT_CHAT_COVER_EVENT, onResidentChatCoverEvent);
  });
  // #endif

  // #ifdef APP-ANDROID || APP-HARMONY
  /** 离线包预热：延迟 1.5s 挂载，避免与首页首帧争资源；请求不带远程地址，失败不偷跑网络 */
  const offlineWarmupRequest = ref<UTSJSONObject>({});
  const offlineWarmupReady = ref<boolean>(false);
  let offlineWarmupTimer = 0;
  onMounted(() => {
    offlineWarmupTimer = setTimeout(() => {
      offlineWarmupRequest.value = createChatWarmupRequest();
      offlineWarmupReady.value = true;
    }, 1500) as number;
  });
  onUnmounted(() => {
    if (offlineWarmupTimer != 0) {
      clearTimeout(offlineWarmupTimer);
      offlineWarmupTimer = 0;
    }
  });
  // #endif
  
  // ════════════════ 8. 生命周期 ════════════════

  onLoad((options: any) => {
    // #ifdef MP-WEIXIN
    if (options?.cId && options?.fileProxyUrl) {
      uni.navigateTo({
        url: `/subpackages/pages/file-preview-page/file-preview-page?cId=${options.cId}&fileProxyUrl=${encodeURIComponent(options.fileProxyUrl)}`,
      });
      return;
    }
    // #endif

    setCurrentPageNavigationBarTitle();
    setCurrentShareTitle();
  });

  onShow(() => {
    uni.hideLoading();
    applyTabBarI18n();

    // 处理首页上框的智能体
    const pendingTargetId = appGlobalState.pendingHomeAgentTargetId;
    if (pendingTargetId > 0) {
      const pendingItem = {} as UTSJSONObject;
      pendingItem["targetId"] = pendingTargetId;
      pendingItem["name"] = appGlobalState.pendingHomeAgentName;
      pendingItem["icon"] = appGlobalState.pendingHomeAgentIcon;
      appGlobalState.pendingHomeAgentTargetId = 0;
      appGlobalState.pendingHomeAgentName = "";
      appGlobalState.pendingHomeAgentIcon = "";
      handleExpertAgentSelect(pendingItem);
    }
    loadDefaultAgentEntry();
    // 类型体系（对齐 PC Home）：分类 + 推荐位并行拉取
    loadChatboxNav();
    // 空间列表（对齐 PC SpaceSelector 挂载即拉）
    loadSpaces();
    refreshLoginStateAndDrawer();
    // IM 未读徽标：登录落地/退出登录回首页时立即同步一次（TabBar 此时必已挂载）。
    refreshImUnreadBadge();
    // #ifdef APP-IOS
    residentChatCover.value = isResidentChatCoverActive();
    flushPendingResidentChat();
    if (
      isResidentChatVisible() != true &&
      isResidentChatCoverActive() != true
    ) {
      syncNativeTabBarState();
    }
    // #endif
    // #ifndef APP-IOS
    syncNativeTabBarState();
    // #endif
  });

  // #ifdef APP-IOS
  onBackPress((_options: OnBackPressOptions): boolean => {
    return handleResidentChatBackPress();
  });
  // #endif

  // #ifdef MP-WEIXIN
  onShareAppMessage(() => {
    return {
      title: shareTitle.value.length > 0 ? shareTitle.value : fallbackShareTitle.value,
      path: "/pages/index/index",
    };
  });

  onAddToFavorites(() => {
    return {
      title: shareTitle.value.length > 0 ? shareTitle.value : fallbackShareTitle.value,
    };
  });
  // #endif
</script>

<style lang="scss" scoped>
  .create-hub {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #ffffff;
    box-sizing: border-box;
    /* Android/iOS/鸿蒙页面窗口均已避让原生 TabBar，不重复预留栏体高度。
       鸿蒙额外的 100rpx 会在键盘打开和收起时都留下空白。
       H5 TabBar 为页面内固定层，需让出栏体 + 底部安全区。 */
    /* #ifdef APP-ANDROID || APP-IOS || APP-HARMONY */
    padding-bottom: 0rpx;
    /* #endif */
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
    /* #endif */
  }

  .create-hub__nav {
    padding: 12rpx 32rpx 0;
  }

  .create-hub__menu {
    width: 72rpx;
    height: 72rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* 页面主体：从上到下正常流，内容超出即垂直滚动 */
  .create-hub__scroll {
    flex: 1;
    min-height: 0;
  }

  .create-hub__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 48rpx 48rpx;
  }

  .create-hub__title {
    width: 100%;
    overflow: hidden;
  }

  .create-hub__title-rich {
    width: 100%;
    font-size: 52rpx;
    font-weight: 700;
    line-height: 72rpx;
    color: #111111;
    text-align: center;
  }

  .create-hub__subtitle {
    margin-top: 16rpx;
    font-size: 28rpx;
    line-height: 40rpx;
    color: #8a8a8a;
    text-align: center;
  }

  /* ── 类型体系（对齐 PC HomeCategoryTabs；二级推荐走根级 fixed 下拉面板） ── */
  /* 胶囊行容器：仅负责居中；面板锚定与定位在页面根级完成 */
  .create-hub__category-wrap {
    width: 100%;
    margin-top: 48rpx;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .create-hub__guide-scroll {
    width: 100%;
    flex-shrink: 0;
    margin-top: 28rpx;
  }

  .create-hub__guide-content {
    display: flex;
    flex-direction: column;
    padding: 4rpx 0;
    box-sizing: border-box;
  }

  .create-hub__guide-item {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 16rpx 8rpx;
    box-sizing: border-box;
  }

  .create-hub__guide-arrow {
    flex-shrink: 0;
    margin-right: 14rpx;
    font-size: 30rpx;
    line-height: 42rpx;
    color: #6660d9;
  }

  .create-hub__guide-text {
    flex: 1;
    min-width: 0;
    font-size: 28rpx;
    line-height: 42rpx;
    color: #33333b;
    white-space: normal;
  }

  /* 灰色胶囊固定轨道：分类少时按内容收缩居中（flex 行子项主轴 auto 即内容宽，
     勿加 width:max-content —— iOS 原生端不认会塌缩成整行），多时封顶容器宽、pill 在内部滚动 */
  .create-hub__category-capsule {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    padding: 8rpx;
    border-radius: 999rpx;
    background-color: #f3f3f3;
    overflow: hidden;
  }

  /* 面板展开期间的上段遮罩（页面根级 fixed）：胶囊顶以上，点空白关闭 */
  .create-hub__category-mask {
    position: fixed;
    left: 0;
    right: 0;
    /* 全透明在鸿蒙/iOS 原生端可能点不透/收不到手势，用极淡底色承接点击 */
    background-color: rgba(255, 255, 255, 0.01);
    z-index: 29;
  }

  .create-hub__category-mask--top {
    top: 0;
    /* height 由内联实测胶囊顶坐标驱动 */
  }

  .create-hub__category-scroll {
    width: 100%;
  }

  .create-hub__category-list {
    /* 横滑关键：flex nowrap 自然按内容撑宽（对齐 manual-component-bar 模式）；
       勿加 width: max-content —— iOS 原生端会塌缩成容器宽，导致无法滚动。
       行宽在溢出时由内联实测内容宽（px）显式指定。 */
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
  }

  .create-hub__category {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    /* 横滑关键：禁止压缩，保持固有宽度使内容可溢出滚动 */
    flex: none;
    height: 72rpx;
    padding: 0 30rpx;
    border-radius: 999rpx;
  }

  .create-hub__category--on {
    background-color: #ffffff;
    /* #ifndef APP-HARMONY */
    box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
    /* #endif */
  }

  .create-hub__category-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 8rpx;
  }

  .create-hub__category-text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #8a8a8a;
  }

  .create-hub__category-text--on {
    color: #111111;
    font-weight: 600;
  }

  /* ── 二级推荐下拉面板宿主：胶囊底→屏幕底整带（页面根级 fixed）──
     ⚠ Android 实测：fixed 元素带 rpx 的 left/right 偏移与自适应高度不生效（布局盒被撑成
     全宽且上移，透明区吞掉胶囊行点击）。宿主必须与遮罩同构：left:0; right:0; bottom:0 +
     内联 px top；视觉内缩交给普通流子元素（白卡 margin）。宿主透明承接整带点击=关闭，
     白卡内 @click.stop 阻断。padding-top 为胶囊与白卡的视觉间隙。 */
  .create-hub__category-panel {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 31;
    /* 全透明在鸿蒙/iOS 原生端可能点不透，用极淡底色承接点击（同遮罩） */
    background-color: rgba(255, 255, 255, 0.01);
    padding-top: 16rpx;
  }

  /* 白卡：普通流子元素做视觉内缩（与 hero 左右留白对齐），原生端可靠 */
  .create-hub__category-panel-card {
    margin: 0 48rpx;
    background-color: #ffffff;
    border-radius: 24rpx;
    /* #ifndef APP-HARMONY */
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
    /* #endif */
    overflow: hidden;
    /* #ifdef H5 */
    animation: create-hub-panel-in 0.22s ease-out;
    /* #endif */
  }

  /* 离场：上移淡出后保持隐藏，等待卸载（仅 H5 动画；原生端 keyframes 不支持，直出直隐） */
  /* #ifdef H5 */
  .create-hub__category-panel-card--closing {
    animation: create-hub-panel-out 0.18s ease-in forwards;
  }
  /* #endif */

  /* #ifdef H5 */
  @keyframes create-hub-panel-in {
    from {
      opacity: 0;
      transform: translateY(-24rpx);
    }
    to {
      opacity: 1;
      transform: translateY(0rpx);
    }
  }

  @keyframes create-hub-panel-out {
    from {
      opacity: 1;
      transform: translateY(0rpx);
    }
    to {
      opacity: 0;
      transform: translateY(-24rpx);
    }
  }
  /* #endif */

  .create-hub__category-panel-handle {
    height: 44rpx;
