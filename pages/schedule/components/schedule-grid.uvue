<template>
  <view class="span">
    <view class="span__bar">
      <view class="span__arrow" @click="onPrev">
        <svg-icon name="icon-a-Chevronleft" size="18" unit="px" color="#1f2329" />
      </view>
      <view class="span__title">
        <text class="span__title-text">{{ titleText }}</text>
        <text v-if="titleToday.length > 0" class="span__title-today">{{ titleToday }}</text>
      </view>
      <view class="span__arrow" @click="onNext">
        <svg-icon name="icon-a-Chevronright" size="18" unit="px" color="#1f2329" />
      </view>
    </view>

    <view class="span__sheet">
      <view v-if="single != true" class="span__heads">
        <view class="span__gutter"></view>
        <view class="span__heads-cols">
          <view v-for="(col, index) in columns" :key="index" class="span__head" @click="onPickDay(col)">
            <text :class="col.anchor ? 'span__wd span__wd--on' : 'span__wd'">{{ col.weekday }}</text>
            <text :class="col.anchor ? 'span__num span__num--on' : 'span__num'">{{ col.dayText }}</text>
          </view>
        </view>
      </view>
      <view v-else class="span__mine">
        <view class="span__gutter"></view>
        <text class="span__mine-text">{{ t("Mobile.Discover.scheduleMine") }}</text>
      </view>

      <view class="span__all">
        <view class="span__gutter span__gutter--all">
          <text class="span__gmt">{{ gmtText }}</text>
          <text class="span__all-label">{{ t("Mobile.Discover.scheduleAllDay") }}</text>
        </view>
        <view class="span__all-cols">
          <view v-for="(col, index) in columns" :key="index" class="span__all-cell">
            <view v-for="(chip, chipIndex) in col.chips" :key="chipIndex" class="span__chip" :style="chip.bgStyle" @click="onOpen(chip.id)">
              <text class="span__chip-text" :style="chip.inkStyle">{{ chip.title }}</text>
            </view>
          </view>
        </view>
      </view>

      <scroll-view class="span__scroll" direction="vertical" :show-scrollbar="false" :scroll-top="scrollTop">
        <view class="span__grid">
          <view class="span__hours">
            <view v-for="(label, index) in hourLabels" :key="index" class="span__hour">
              <text class="span__hour-text">{{ label }}</text>
            </view>
          </view>
          <view class="span__cols">
            <view v-for="(line, index) in hourLines" :key="index" class="span__line" :style="line.topStyle"></view>
            <view v-for="(col, index) in columns" :key="index" class="span__col">
              <view v-for="(block, blockIndex) in col.blocks" :key="blockIndex" class="span__block" :style="block.boxStyle" @click="onOpen(block.id)">
                <text class="span__block-title">{{ block.title }}</text>
                <text v-if="block.showTime" class="span__block-time">{{ block.time }}</text>
              </view>
            </view>
            <view v-if="showNow" class="span__now" :style="nowStyle">
              <view class="span__now-dot" :style="nowDotStyle"></view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, watch } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { ScheduleEvent, loadScheduleEvents } from "@/utils/scheduleStore";
  import { buildItems, dayHead, gmtLabel, pad2, shiftDate, toIso, weekSpan, weekSunday } from "@/utils/scheduleBoard";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const HOUR_H = 52;

  class Chip {
    id: string = "";
    title: string = "";
    bgStyle: string = "";
    inkStyle: string = "";
  }

  class GridBlock {
    id: string = "";
    title: string = "";
    time: string = "";
    showTime: boolean = true;
    boxStyle: string = "";
  }

  class WeekCol {
    iso: string = "";
    weekday: string = "";
    dayText: string = "";
    anchor: boolean = false;
    chips: Chip[] = [];
    blocks: GridBlock[] = [];
  }

  class HourLine {
    topStyle: string = "";
  }

  const props = defineProps({
    year: { type: Number, default: 0 },
    month: { type: Number, default: 0 },
    day: { type: Number, default: 0 },
    single: { type: Boolean, default: false },
    markVersion: { type: Number, default: 0 },
  });

  const emit = defineEmits<{
    shift: [delta: number];
    pick: [value: string];
    open: [id: string];
  }>();

  const weekdayKeys: string[] = [
    "Mobile.Discover.weekdaySun",
    "Mobile.Discover.weekdayMon",
    "Mobile.Discover.weekdayTue",
    "Mobile.Discover.weekdayWed",
    "Mobile.Discover.weekdayThu",
    "Mobile.Discover.weekdayFri",
    "Mobile.Discover.weekdaySat",
  ];

  const hourLabels: string[] = [];
  const hourLines: HourLine[] = [];
  for (let hour = 0; hour < 24; hour++) {
    hourLabels.push(pad2(hour) + ":00");
    const line = new HourLine();
    line.topStyle = "top:" + hour * HOUR_H + "px";
    hourLines.push(line);
  }

  const titleText = ref<string>("");
  const titleToday = ref<string>("");
  const gmtText = ref<string>(gmtLabel());
  const columns = ref<WeekCol[]>([]);
  const scrollTop = ref<number>(8 * HOUR_H);
  const showNow = ref<boolean>(false);
  const nowStyle = ref<string>("");
  const nowDotStyle = ref<string>("");

  function isSameToday(year: number, month: number, day: number): boolean {
    const today = new Date();
    return year == today.getFullYear() && month == today.getMonth() + 1 && day == today.getDate();
  }

  function buildColumn(year: number, month: number, day: number, locals: ScheduleEvent[], anchorIso: string): WeekCol {
    const col = new WeekCol();
    col.chips = [] as Chip[];
    col.blocks = [] as GridBlock[];
    col.iso = toIso(year, month, day);
    col.weekday = t(weekdayKeys[new Date(year, month - 1, day).getDay()]);
    col.dayText = "" + day;
    col.anchor = col.iso == anchorIso;
    const items = buildItems(col.iso, locals);
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      if (item.allDay) {
        const chip = new Chip();
        chip.id = item.id;
        chip.title = item.title;
        chip.bgStyle = "background-color:" + item.pastel;
        chip.inkStyle = "color:" + item.ink;
        col.chips.push(chip);
      } else {
        const block = new GridBlock();
        block.id = item.id;
        block.title = item.title;
        block.time = item.timeRange;
        const top = Math.floor((item.startMin * HOUR_H) / 60);
        let height = Math.floor(((item.endMin - item.startMin) * HOUR_H) / 60);
        if (height < 28) {
          height = 28;
        }
        block.showTime = height >= 40;
        block.boxStyle = "top:" + top + "px;height:" + height + "px;background-color:" + item.solid;
        col.blocks.push(block);
      }
    }
    return col;
  }

  function rebuild(): void {
    const year = props.year;
    const month = props.month;
    const day = props.day;
    if (year <= 0 || month <= 0 || day <= 0) {
      return;
    }
    const locals = loadScheduleEvents();
    const anchorIso = toIso(year, month, day);
    const single = props.single == true;
    const cols: WeekCol[] = [];
    let containsToday = false;
    let todayIndex = 0;
    if (single) {
      const weekday = t(weekdayKeys[new Date(year, month - 1, day).getDay()]);
      titleText.value = dayHead(month, day, weekday);
      titleToday.value = isSameToday(year, month, day) ? t("Mobile.Discover.scheduleTodayWrap") : "";
      cols.push(buildColumn(year, month, day, locals, anchorIso));
      containsToday = isSameToday(year, month, day);
      todayIndex = 0;
    } else {
      titleToday.value = "";
      const sunday = weekSunday(year, month, day);
      const saturday = shiftDate(sunday[0], sunday[1], sunday[2], 6);
      titleText.value = weekSpan(sunday[1], sunday[2], saturday[1], saturday[2]);
      for (let i = 0; i < 7; i++) {
        const date = shiftDate(sunday[0], sunday[1], sunday[2], i);
        if (isSameToday(date[0], date[1], date[2])) {
          containsToday = true;
          todayIndex = i;
        }
        cols.push(buildColumn(date[0], date[1], date[2], locals, anchorIso));
      }
    }
    columns.value = cols;
    gmtText.value = gmtLabel();
    showNow.value = containsToday;
    if (containsToday) {
      const now = new Date();
      const minutes = now.getHours() * 60 + now.getMinutes();
      nowStyle.value = "top:" + Math.floor((minutes * HOUR_H) / 60) + "px";
      const count = single ? 1 : 7;
      nowDotStyle.value = "left:" + Math.floor((todayIndex * 100) / count) + "%";
      let targetHour = now.getHours() - 5;
      if (targetHour < 0) {
        targetHour = 0;
      }
      scrollTop.value = targetHour * HOUR_H;
    } else {
      scrollTop.value = 8 * HOUR_H;
    }
  }

  function onPrev(): void {
    emit("shift", props.single == true ? -1 : -7);
  }

  function onNext(): void {
    emit("shift", props.single == true ? 1 : 7);
  }

  function onPickDay(col: WeekCol): void {
    emit("pick", col.iso);
  }

  function onOpen(id: string): void {
    emit("open", id);
  }

  watch((): string => {
    const singleFlag = props.single == true ? "1" : "0";
    return props.year + "-" + props.month + "-" + props.day + "-" + props.markVersion + "-" + singleFlag;
  }, (_value: string): void => {
    rebuild();
  });

  rebuild();
</script>

<style scoped>
  .span {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .span__bar {
    height: 44px;
    padding: 0 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .span__arrow {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .span__title {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .span__title-text {
    font-size: 16px;
    font-weight: 600;
    color: #1f2329;
  }

  .span__title-today {
    margin-left: 4px;
    font-size: 16px;
    font-weight: 600;
    color: #5b4dff;
  }

  .span__sheet {
    flex: 1;
    margin: 0 12px 12px;
    background-color: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .span__heads,
  .span__mine,
  .span__all {
    display: flex;
    flex-direction: row;
    align-items: stretch;
  }

  .span__gutter {
    width: 52px;
  }

  .span__gutter--all {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 4px;
  }

  .span__gmt {
    font-size: 10px;
    color: #86909c;
    line-height: 14px;
  }

  .span__all-label {
    margin-top: 2px;
    font-size: 11px;
    color: #86909c;
    line-height: 14px;
  }

  .span__heads-cols,
  .span__all-cols {
    flex: 1;
    display: flex;
    flex-direction: row;
  }

  .span__head {
    flex: 1;
    padding: 8px 0 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .span__wd {
    font-size: 11px;
    color: #86909c;
    line-height: 16px;
  }

  .span__wd--on {
    color: #5b4dff;
  }

  .span__num {
    margin-top: 2px;
    font-size: 14px;
    color: #1f2329;
    line-height: 20px;
  }

  .span__num--on {
    color: #5b4dff;
    font-weight: 600;
  }

  .span__mine {
    height: 36px;
    align-items: center;
  }

  .span__mine-text {
    flex: 1;
    text-align: center;
    font-size: 13px;
    color: #86909c;
  }

  .span__all {
    padding-bottom: 6px;
    border-bottom: 1px solid #f2f3f5;
  }

  .span__all-cell {
    flex: 1;
    padding: 2px;
    display: flex;
    flex-direction: column;
  }

  .span__chip {
    min-height: 18px;
    margin-bottom: 2px;
    padding: 1px 3px;
    border-radius: 4px;
    overflow: hidden;
  }

  .span__chip-text {
    font-size: 10px;
    line-height: 16px;
  }

  .span__scroll {
    flex: 1;
  }

  .span__grid {
    height: 1248px;
    display: flex;
    flex-direction: row;
  }

  .span__hours {
    width: 52px;
  }

  .span__hour {
    height: 52px;
    padding-left: 4px;
  }

  .span__hour-text {
    font-size: 11px;
    color: #86909c;
    line-height: 14px;
  }

  .span__cols {
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: row;
  }

  .span__line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: #f2f3f5;
  }

  .span__col {
    flex: 1;
    position: relative;
    border-left: 1px solid #f2f3f5;
  }

  .span__block {
    position: absolute;
    left: 2px;
    right: 2px;
    border-radius: 4px;
    padding: 2px 3px;
    overflow: hidden;
    z-index: 2;
  }

  .span__block-title,
  .span__block-time {
    color: #ffffff;
    font-size: 10px;
    line-height: 14px;
  }

  .span__now {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #f53f3f;
    z-index: 3;
  }

  .span__now-dot {
    position: absolute;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #f53f3f;
  }
</style>
