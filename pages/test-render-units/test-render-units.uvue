<template>
  <view class="benchmark-page">
    <text class="title">RenderUnit 布局内核 Benchmark</text>
    <text class="subtitle">独立验证高度索引、锚点补偿、版本门禁与滚动状态机；尚未接管生产会话。</text>
    <view class="options">
      <text
        v-for="count in countOptions"
        :key="`${count}`"
        class="option"
        :class="selectedCount == count ? 'option-active' : ''"
        @click="selectedCount = count"
      >{{ count }} units</text>
    </view>
    <button type="primary" class="run" @click="runBenchmark">运行 Benchmark</button>
    <view class="result" v-if="hasRun">
      <text :class="passed ? 'passed' : 'failed'">{{ passed ? 'PASS' : 'FAIL' }}</text>
      <text class="metric">units {{ resultUnitCount }}</text>
      <text class="metric">build {{ buildMs }}ms</text>
      <text class="metric">5000 queries {{ queryMs }}ms</text>
      <text class="metric">anchor mutation {{ mutationMs }}ms</text>
      <text class="metric">totalHeight {{ totalHeightText }}px</text>
      <text class="metric">assertions {{ assertionCount }}</text>
      <text class="failure" v-if="failure.length > 0">{{ failure }}</text>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { onMounted, ref } from "vue";
  import { runRenderUnitBenchmark } from "@/subpackages/pages/chat-conversation-component/render-units/RenderUnitBenchmark.uts";

  const countOptions = [1000, 5000, 10000];
  const selectedCount = ref<number>(10000);
  const hasRun = ref<boolean>(false);
  const passed = ref<boolean>(false);
  const resultUnitCount = ref<number>(0);
  const buildMs = ref<number>(0);
  const queryMs = ref<number>(0);
  const mutationMs = ref<number>(0);
  const totalHeightText = ref<string>("0");
  const assertionCount = ref<number>(0);
  const failure = ref<string>("");

  function runBenchmark(): void {
    const result = runRenderUnitBenchmark(selectedCount.value);
    hasRun.value = true;
    passed.value = result.passed;
    resultUnitCount.value = result.unitCount;
    buildMs.value = result.buildMs;
    queryMs.value = result.queryMs;
    mutationMs.value = result.mutationMs;
    totalHeightText.value = result.totalHeight.toFixed(0);
    assertionCount.value = result.assertions;
    failure.value = result.failure;
    console.log(`[RenderUnitBench] passed=${result.passed} units=${result.unitCount} build=${result.buildMs}ms query=${result.queryMs}ms mutation=${result.mutationMs}ms assertions=${result.assertions} failure=${result.failure}`);
  }

  onMounted((): void => {
    runBenchmark();
  });
</script>

<style lang="scss" scoped>
  .benchmark-page { padding: 32rpx; }
  .title { font-size: 36rpx; font-weight: 700; color: #1d1d1f; }
  .subtitle { margin-top: 12rpx; font-size: 24rpx; color: #777; }
  .options { margin-top: 28rpx; flex-direction: row; flex-wrap: wrap; }
  .option { margin: 0 16rpx 16rpx 0; padding: 12rpx 20rpx; border-radius: 24rpx; background-color: #eeeeee; font-size: 26rpx; color: #444; }
  .option-active { background-color: #168548; color: #fff; }
  .run { margin-top: 20rpx; }
  .result { margin-top: 28rpx; padding: 24rpx; border-radius: 16rpx; background-color: #f5f7f5; }
  .passed { color: #168548; font-size: 36rpx; font-weight: 700; }
  .failed { color: #d93025; font-size: 36rpx; font-weight: 700; }
  .metric { margin-top: 10rpx; font-size: 27rpx; color: #333; }
  .failure { margin-top: 14rpx; font-size: 24rpx; color: #d93025; }
</style>
