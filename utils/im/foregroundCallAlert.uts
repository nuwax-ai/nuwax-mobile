/**
 * App 前台来电提示音与震动。
 *
 * 系统来电 UI 可用时由 Telecom / LiveCommunicationKit 自己响铃；这里只覆盖
 * 应用内会议邀请横幅，以及系统来电 UI 不可用时打开的应用内接听页。
 */
let audio: InnerAudioContext | null = null;
let vibrationTimer = 0;
let owner = "";

function ensureAudio(): InnerAudioContext {
  if (audio != null) return audio as InnerAudioContext;
  const next = uni.createInnerAudioContext();
  next.loop = true;
  next.autoplay = false;
  next.src = "/static/ringtones/ringtone.m4a";
  audio = next;
  return next;
}
function vibrate(): void {
  try {
    uni.vibrateShort({ type: "medium", fail: (_error) => {} });
  } catch (_error) {}
}

/** 同一时刻只有一个前台来电提示；新 owner 会接管旧提示。 */
export function startForegroundCallAlert(nextOwner: string): void {
  if (nextOwner.length == 0 || owner == nextOwner) return;
  stopForegroundCallAlert();
  owner = nextOwner;
  try {
    const player = ensureAudio();
    player.seek(0);
    player.play();
  } catch (_error) {}
  vibrate();
  vibrationTimer = setInterval((): void => { vibrate(); }, 1400);
}

/** 传 owner 时只允许提示的当前持有者停止，避免页面切换时误停新页面的铃声。 */
export function stopForegroundCallAlert(expectedOwner: string = ""): void {
  if (expectedOwner.length > 0 && owner != expectedOwner) return;
  owner = "";
  if (vibrationTimer != 0) {
    clearInterval(vibrationTimer);
    vibrationTimer = 0;
  }
  if (audio != null) {
    try {
      const player = audio as InnerAudioContext;
      player.stop();
      player.seek(0);
    } catch (_error) {}
  }
}
