<template>
  <view class="launch-page">
    <!-- #ifdef APP-ANDROID -->
    <!-- 用户明确同意之前不进入业务页面。 -->
    <view v-if="showPrivacy" class="privacy-brand">
      <image class="privacy-brand-logo" src="/static/logo.png" mode="aspectFit" />
      <text class="privacy-brand-name">女娲 Nuwax</text>
    </view>
    <view v-if="showPrivacy" class="privacy-card">
      <text class="privacy-title">温馨提示</text>
      <text class="privacy-text">感谢您信任并使用女娲 Nuwax！我们重视并保护你的个人信息，请在使用前了解以下隐私保护要点。</text>
      <scroll-view class="privacy-document" :scroll-y="true" :show-scrollbar="true">
        <text class="privacy-document-text">{{ privacyPolicySummary }}</text>
      </scroll-view>
      <view class="privacy-links">
        <text class="privacy-link-prefix">您可通过阅读完整版</text>
        <text class="privacy-link" @click="openServiceAgreement">《服务使用协议》</text>
        <text class="privacy-link-prefix">及</text>
        <text class="privacy-link" @click="openPrivacyAgreement">《隐私协议》</text>
        <text class="privacy-link-prefix">了解条款内容</text>
      </view>
      <view class="privacy-actions">
        <button class="privacy-agree" open-type="agreePrivacyAuthorization" @click="agreePrivacy">同意</button>
        <button class="privacy-decline" @click="declinePrivacy">不同意</button>
      </view>
    </view>
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { switchMainTab } from "@/utils/mainTabNavigation";
  import { onReady, onUnload } from "@dcloudio/uni-app";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import { routeIncomingShare, takeColdStartScheme } from "@/utils/appShare";
  import { routeIncomingQrLogin } from "@/utils/qrLoginNavigation";
  // #ifdef APP-ANDROID
  import { completeAppPrivacyConsent, prepareAppPrivacyConsent } from "@/utils/appPrivacyConsent";
  import { APP_PRIVACY_POLICY_SUMMARY } from "@/constants/appPrivacyPolicySummary";
  import { handleExternalLink } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  // #endif
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  import { scheduleImPushAfterLogin } from "@/utils/im/imPushClient";
  // #endif
  // #ifdef APP-ANDROID
  import { schedulePushBackgroundGuideAfterLogin } from "@/utils/push/pushBackgroundGuide";
  // #endif

  // #ifdef APP-ANDROID
  const showPrivacy = ref(false);
  const privacyPolicySummary = APP_PRIVACY_POLICY_SUMMARY;
  const i18nParams = emptyI18nParams();
  let privacyListener = 0;
  let acceptingPrivacy = false;
  // #endif
  let routed = false;

  function routeByAuthState(): void {
    if (routed) return;
    routed = true;
    const raw = uni.getStorageSync(ACCESS_TOKEN);
    const token = raw != null ? `${raw}`.trim() : "";
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    if (token.length > 0) scheduleImPushAfterLogin();
    // #endif
    // #ifdef APP-ANDROID
    if (token.length > 0) schedulePushBackgroundGuideAfterLogin();
    // #endif
    // 冷启动：扫码登录优先，其次外部分享，都没有再按登录态进登录页或消息页。
    // Android 调用本函数前已经完成隐私同意，因此这里可以读取启动链接。
    if (routeIncomingQrLogin(token.length > 0, "", true)) return;
    if (routeIncomingShare(token.length > 0, takeColdStartScheme())) return;
    if (token.length == 0) {
      uni.reLaunch({ url: "/subpackages/pages/login/login" });
    } else {
      switchMainTab({ url: "/pages/message/message" });
    }
  }

  // #ifdef APP-ANDROID
  function declinePrivacy(): void { uni.exit(); }

  function openServiceAgreement(): void {
    handleExternalLink(translateFn("Mobile.Auth.userAgreementLink", i18nParams, ""));
  }

  function openPrivacyAgreement(): void {
    handleExternalLink(translateFn("Mobile.Auth.privacyAgreementLink", i18nParams, ""));
  }

  // 原生按钮完成真实授权后，显式完成本地记录、关闭弹窗和登录态分流。
  // 不能只依赖全局授权变化事件：独立 APK 里的按钮点击也必须有自己的完成链路。
  function agreePrivacy(): void {
    if (acceptingPrivacy || routed) return;
    acceptingPrivacy = true;
    setTimeout(() => {
      completeAppPrivacyConsent((accepted: boolean) => {
        acceptingPrivacy = false;
        if (!accepted) {
          uni.showToast({ title: "隐私授权未完成，请再次点击同意", icon: "none" });
          return;
        }
        showPrivacy.value = false;
        routeByAuthState();
      });
    }, 0);
  }
  // #endif

  onReady(() => {
    // #ifdef APP-ANDROID
    privacyListener = uni.onPrivacyAuthorizationChange((res) => {
      if (res.needAuthorization) return;
      agreePrivacy();
    });
    prepareAppPrivacyConsent((accepted: boolean) => {
      if (accepted) routeByAuthState();
      else showPrivacy.value = true;
    });
    // #endif
    // #ifndef APP-ANDROID
    routeByAuthState();
    // #endif
  });
  onUnload(() => {
    // #ifdef APP-ANDROID
    if (privacyListener > 0) uni.offPrivacyAuthorizationChange(privacyListener);
    // #endif
  });
</script>

<style scoped>
  /* #ifndef APP-ANDROID */
  .launch-page { flex: 1; background-color: #ffffff; }
  /* #endif */
  /* #ifdef APP-ANDROID */
  .launch-page { flex: 1; padding: 20px 8%; background-color: #666666; justify-content: center; align-items: center; }
  .privacy-brand { position: absolute; left: 0; right: 0; bottom: 64px; z-index: 0; flex-direction: row; align-items: center; justify-content: center; opacity: 0.42; }
  .privacy-brand-logo { width: 36px; height: 36px; margin-right: 10px; }
  .privacy-brand-name { font-size: 18px; font-weight: 600; color: #111111; }
  .privacy-card { position: relative; z-index: 1; display: flex; flex-direction: column; flex: none; width: 100%; height: 70%; border-radius: 16px; background-color: #ffffff; padding: 16px 16px 12px; box-sizing: border-box; }
  .privacy-title { align-self: center; font-size: 20px; font-weight: 600; color: #222222; margin: 2px 0 10px; }
  .privacy-document { flex: 1; width: 100%; min-height: 0; margin-bottom: 8px; }
  .privacy-document-text { font-size: 13px; line-height: 20px; color: #333333; white-space: pre-wrap; }
  .privacy-text { font-size: 13px; line-height: 20px; color: #555555; margin: 0 0 6px; }
  .privacy-links { flex-direction: row; flex-wrap: wrap; margin: 0 0 12px; }
  .privacy-link-prefix { font-size: 12px; line-height: 19px; color: #555555; }
  .privacy-link { font-size: 12px; line-height: 19px; color: #5147ff; }
  .privacy-actions { flex-direction: column; margin: 0; }
  .privacy-decline { height: 42px; line-height: 42px; padding: 0; margin: 8px 0 0; font-size: 15px; color: #666666; background-color: #ffffff; border: 1px solid #e5e5e5; border-radius: 7px; }
  .privacy-agree { height: 44px; line-height: 44px; padding: 0; margin: 0; font-size: 15px; font-weight: 600; color: #ffffff; background-color: #111111; border-radius: 7px; }
  /* #endif */
</style>
