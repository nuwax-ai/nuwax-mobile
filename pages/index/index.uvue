    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
  }

  .create-hub__guide-content {
    display: flex;
    flex-direction: column;
    padding: 0 48rpx;
    box-sizing: border-box;
  }

  .create-hub__guide-item {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 84rpx;
    flex-shrink: 0;
