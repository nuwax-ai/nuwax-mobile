  }

  .mr-chat-empty {
    flex: 1;
    padding-top: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mr-chat-empty__text {
    font-size: 13px;
    color: #a0a3ab;
  }

  .mr-chat-row {
    width: 100%;
    margin-bottom: 10px;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
  }

  .mr-chat-row--self {
    justify-content: flex-end;
  }

  .mr-chat-bubble {
    max-width: 78%;
