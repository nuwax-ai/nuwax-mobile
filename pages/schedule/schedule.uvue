<template>
  <view class="schedule">
    <custom-nav-bar :title="t('Mobile.Discover.calendar')" className="border-b" hasSafetyZone :show-back="true">
      <template #right>
        <view class="schedule__today" @click="jumpToday">
          <text class="schedule__today-text">{{ t("Mobile.Discover.scheduleToday") }}</text>
        </view>
      </template>
    </custom-nav-bar>
    <!-- sticky-header / sticky-section 只支持作为 list-view 的子节点，所以纵向滚动容器用 list-view -->
    <list-view class="schedule__scroll" direction="vertical" :show-scrollbar="false">
      <list-item>
        <view class="schedule__calendar">
          <month-calendar ref="calendarRef" @select="onSelect" />
        </view>
      </list-item>
      <sticky-section>
        <!-- sticky-header 不支持 css 样式，日期这一行自己画背景，吸顶后遮住下方滚动内容 -->
        <sticky-header>
          <view class="schedule__date-bar">
            <text class="schedule__date">{{ dateLine }}</text>
          </view>
        </sticky-header>
        <!-- Android 上 sticky-section 的子节点只能是 sticky-header / list-item -->
        <list-item>
          <view class="schedule__empty">
            <view class="schedule__empty-icon">
              <svg-icon name="icon-Calendar" size="22" unit="px" color="#c9cdd4" />
            </view>
            <text class="schedule__empty-text">{{ emptyText }}</text>
            <view class="schedule__create" @click="onCreate">
              <text class="schedule__create-text">+ {{ t("Mobile.Discover.scheduleCreate") }}</text>
            </view>
          </view>
        </list-item>
      </sticky-section>
    </list-view>
  </view>
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  import MonthCalendar from "@/components/month-calendar/month-calendar.uvue";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const calendarRef = ref<any | null>(null);
  const today = new Date();
  const selectedYear = ref<number>(today.getFullYear());
  const selectedMonth = ref<number>(today.getMonth() + 1);
  const selectedDay = ref<number>(today.getDate());
  const dateLine = ref<string>("");
  const emptyText = ref<string>("");

  const weekdayKeys: string[] = [
    "Mobile.Discover.weekdaySun",
    "Mobile.Discover.weekdayMon",
    "Mobile.Discover.weekdayTue",
    "Mobile.Discover.weekdayWed",
    "Mobile.Discover.weekdayThu",
    "Mobile.Discover.weekdayFri",
    "Mobile.Discover.weekdaySat",
  ];

  function refreshSummary(): void {
    const date = new Date(selectedYear.value, selectedMonth.value - 1, selectedDay.value);
    const params = new Map<string, string | number>();
    params.set("month", selectedMonth.value);
    params.set("day", selectedDay.value);
    params.set("weekday", t(weekdayKeys[date.getDay()]));
    dateLine.value = translateFn("Mobile.Discover.scheduleDate", toI18nParams(params), "");
    const isToday = selectedYear.value == today.getFullYear() && selectedMonth.value == today.getMonth() + 1 && selectedDay.value == today.getDate();
    const suffix = isToday ? "  " + t("Mobile.Discover.scheduleToday") : "";
    dateLine.value = dateLine.value + suffix;
    emptyText.value = isToday ? t("Mobile.Discover.scheduleEmptyToday") : t("Mobile.Discover.scheduleEmptyDay");
  }

  function onSelect(value: string): void {
    const parts = value.split("-");
    if (parts.length < 3) return;
    const year = parseInt(parts[0]);
    const month = parseInt(parts[1]);
    const day = parseInt(parts[2]);
    if (isNaN(year) || isNaN(month) || isNaN(day)) return;
    selectedYear.value = year;
    selectedMonth.value = month;
    selectedDay.value = day;
    refreshSummary();
  }

  function jumpToday(): void {
    if (calendarRef.value == null) return;
    const proxy = calendarRef.value as ComponentPublicInstance;
    proxy.$callMethod("goToday");
  }

  function onCreate(): void {
    uni.showToast({ title: t("Mobile.Common.comingSoon"), icon: "none" });
  }

  refreshSummary();
</script>

<style scoped>
  .schedule {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: #f7f7f8;
  }

  .schedule__today {
    height: 28px;
    padding: 0 12px;
    margin-right: 12px;
    border-radius: 14px;
    background-color: #efedff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .schedule__today-text {
    font-size: 13px;
    color: #5b4dff;
  }

  .schedule__scroll {
    flex: 1;
  }

  .schedule__calendar {
    margin: 12px 16px 0;
  }

  /* 吸顶行：用 padding 而不是 margin，让 sticky-header 的高度可预期，背景铺满整行 */
  .schedule__date-bar {
    padding: 16px 16px 10px;
    background-color: #f7f7f8;
  }

  .schedule__date {
    font-size: 16px;
    font-weight: 600;
    color: #1f2329;
  }

  .schedule__empty {
    margin: 0 16px 24px;
    padding: 28px 16px 20px;
    background-color: #ffffff;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .schedule__empty-icon {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: #f2f3f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .schedule__empty-text {
    margin-top: 12px;
    font-size: 14px;
    color: #86909c;
  }

  .schedule__create {
    margin-top: 20px;
    height: 44px;
    padding: 0 28px;
    border-radius: 22px;
    background-color: #5b4dff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .schedule__create-text {
    font-size: 16px;
    color: #ffffff;
    font-weight: 600;
  }
</style>
