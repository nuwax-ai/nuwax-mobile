/** 在同宽的不可见副本上测量，不改变真实编辑器高度、内容或光标。 */
export function measureWebComposerLayout(q: any): UTSJSONObject | null {
  // #ifdef H5 || WEB
  const root = q.root as any;
  if (root == null || root.parentElement == null || root.getBoundingClientRect == null) return null;
  root.style.setProperty("font-size", "16px", "important");
  root.style.setProperty("line-height", "24px", "important");
  root.style.setProperty("font-family", "sans-serif", "important");
  root.style.setProperty("-webkit-text-size-adjust", "100%");
  root.style.setProperty("padding-top", "0px", "important");
  root.style.setProperty("padding-bottom", "0px", "important");
  const width = root.getBoundingClientRect().width;
  if (width <= 0) return null;
  const probe = root.cloneNode(true) as any;
  probe.removeAttribute("id");
  probe.removeAttribute("contenteditable");
  probe.setAttribute("aria-hidden", "true");
  const styles = { position: "absolute", visibility: "hidden", pointerEvents: "none", height: "auto", minHeight: "0", maxHeight: "none", overflow: "visible", width: `${width}px`, top: "0", left: "0" };
  Object.assign(probe.style, styles);
  // 页面中 height:100%!important 的 editor 约束也必须在测量节点上解除。
  probe.style.setProperty("height", "auto", "important");
  probe.style.setProperty("min-height", "0", "important");
  probe.style.setProperty("max-height", "none", "important");
  root.parentElement.appendChild(probe);
  try {
    const contentHeight = probe.getBoundingClientRect().height;
    probe.innerHTML = "<p><br></p>";
    const singleHeight = probe.getBoundingClientRect().height;
    probe.innerHTML = "<p><br></p><p><br></p>";
    const lineHeight = probe.getBoundingClientRect().height - singleHeight;
    if (singleHeight <= 0 || lineHeight <= 0) return null;
    return { contentHeight: contentHeight, singleHeight: singleHeight, lineHeight: lineHeight };
  } finally { probe.remove(); }
  // #endif
  // #ifndef H5 || WEB
  return null;
  // #endif
}

/** Web 与原生 editor 的事件适配。业务规则由 composerQuickTrigger 统一处理。 */
export function observeWebComposer(q: any, report: (state: UTSJSONObject) => void): () => void {
  // #ifdef H5 || WEB
  let composing = false;
  let pasted = false;
  let pending = "";
  let timer: number | null = null;
  const schedule = (reason: string): void => {
    if ((reason != "selection" && reason != "layout") || pending == "") pending = reason;
    if (timer != null) clearTimeout(timer!);
    timer = setTimeout((): void => {
      timer = null;
      const range = q.getSelection();
      const delta = q.getContents();
      let text = delta.ops.map((op: any): string => typeof op.insert == "string" ? op.insert : "\ufffc").join("");
      if (text.endsWith("\n")) text = text.substring(0, text.length - 1);
      const layout = measureWebComposerLayout(q);
      report({ layout: layout, text: text, cursor: range != null ? range.index : -1, length: range != null ? range.length : 0, composing: composing, reason: pending });
      pending = "";
      pasted = false;
    }, 0);
  };
  const onText = (_delta: any, _old: any, source: string): void => schedule(pasted ? "paste" : (source == "user" ? "edit" : "programmatic"));
  const onSelection = (): void => schedule("selection");
  const onPaste = (): void => { pasted = true; schedule("paste"); };
  const onBeforeInput = (event: any): void => { if (event.inputType == "insertFromPaste" || event.inputType == "insertFromDrop") onPaste(); };
  const onStart = (): void => { composing = true; schedule("composition"); };
  const onEnd = (): void => { composing = false; schedule("edit"); };
  const onKey = (event: any): void => { if (event.key == "Escape") schedule("dismiss"); };
  const onResize = (): void => schedule("layout");
  q.__nuwaxRequestLayout = onResize;
  let measuredWidth = -1;
  const resizeObserver = typeof ResizeObserver != "undefined" ? new ResizeObserver(() => {
    const width = q.root.getBoundingClientRect().width;
    if (width != measuredWidth) { measuredWidth = width; schedule("layout"); }
  }) : null;
  if (resizeObserver != null) resizeObserver.observe(q.root);
  window.addEventListener("resize", onResize);
  q.on("text-change", onText);
  q.on("selection-change", onSelection);
  q.root.addEventListener("paste", onPaste, true);
  q.root.addEventListener("drop", onPaste, true);
  q.root.addEventListener("beforeinput", onBeforeInput, true);
  q.root.addEventListener("compositionstart", onStart);
  q.root.addEventListener("compositionend", onEnd);
  q.root.addEventListener("keydown", onKey);
  schedule("layout");
  return (): void => {
    if (resizeObserver != null) resizeObserver.disconnect();
    window.removeEventListener("resize", onResize);
    if (q.__nuwaxRequestLayout == onResize) q.__nuwaxRequestLayout = null;
    if (timer != null) clearTimeout(timer!);
    q.off("text-change", onText);
    q.off("selection-change", onSelection);
    q.root.removeEventListener("paste", onPaste, true);
    q.root.removeEventListener("drop", onPaste, true);
    q.root.removeEventListener("beforeinput", onBeforeInput, true);
    q.root.removeEventListener("compositionstart", onStart);
    q.root.removeEventListener("compositionend", onEnd);
    q.root.removeEventListener("keydown", onKey);
  };
  // #endif
  // #ifndef H5 || WEB
  return (): void => {};
  // #endif
}

/** 原生 editor 已支持 input 的 delta 透传；只附加观测信息，不改内容和 SDK。 */
export function buildComposerEditorObserverScript(watchIOSViewport: boolean = false, harmonyCaretAnchor: boolean = false): string {
  return `(function installComposerObserver(attempt){
    var root=document.querySelector('.ql-container');
    var q=root&&(root.__quill||(window.Quill&&window.Quill.find(root)));
    if(!q){if((attempt||0)<20)setTimeout(function(){installComposerObserver((attempt||0)+1)},50);return;}
    if(q.__nuwaxLayoutVersion===3){q.__nuwaxRequestLayout();return;}
    q.__nuwaxObserver=true;q.__nuwaxLayoutVersion=3;
    var watchViewport=${watchIOSViewport ? "true" : "false"},iosScrollable=false;
    /* 鸿蒙空文档光标锚点（2026-11-13 真机日志实证）：
       空输入框里 collapsed range 的 rect 全 0（caret=0,0,0,0），ArkUI 拿不到锚点，
       系统「粘贴 / 权限」浮窗就回落到页面顶部；有正文时 rect 正常、浮窗也正常。
       CSS 伪元素（零宽 ::before）经真机验证无效 —— Chromium 只认真实文本节点。
       故空文档时在开头常驻一个零宽空格（U+200B，silent 插入，不进 undo 栈）；
       它只存在于编辑器内部，原生侧展示/发送用的纯文本必须过 stripAnchor 剔除，
       而 indexed 文本（@ 触发、mention 原子替换下标）必须保留它才能与 Quill 索引对齐。 */
    var harmonyAnchor=${harmonyCaretAnchor ? "true" : "false"};var ZWSP=String.fromCharCode(0x200B);
    function stripAnchor(s){return s==null?'':String(s).split(ZWSP).join('');}
    // iOS 首页仅允许五行以上的编辑内容滚动，文档和外层容器始终停在原点。
    function resetIOSScroll(){
      if(!watchViewport)return;
      if(!iosScrollable&&q.root.scrollTop)q.root.scrollTop=0;
      if(root.scrollTop)root.scrollTop=0;
      if(document.body&&document.body.scrollTop)document.body.scrollTop=0;
      if(document.documentElement&&document.documentElement.scrollTop)document.documentElement.scrollTop=0;
      if(window.scrollX||window.scrollY)window.scrollTo(0,0);
    }
    function syncIOSScroll(layout){
      if(!watchViewport||!layout)return;
      var wasScrollable=iosScrollable;
      iosScrollable=layout.contentHeight>layout.singleHeight+layout.lineHeight*4+1;
      document.documentElement.style.setProperty('overflow','hidden');
      document.body.style.setProperty('position','fixed');
      document.body.style.setProperty('inset','0');
      document.body.style.setProperty('overflow','hidden');
      root.style.setProperty('min-height','0px','important');
      q.root.style.setProperty('min-height','0px','important');
      q.root.style.setProperty('max-height','100%','important');
      q.root.style.setProperty('overflow-y',iosScrollable?'auto':'hidden','important');
      q.root.style.setProperty('overscroll-behavior-y','none');
      resetIOSScroll();
      if(iosScrollable&&!wasScrollable&&typeof q.scrollIntoView==='function')q.scrollIntoView();
    }
    function measureLayout(){
      var editor=q.root;
      if(!editor||!editor.parentElement||!editor.getBoundingClientRect)return null;
      editor.style.setProperty('font-size','16px','important');
      editor.style.setProperty('line-height','24px','important');
      editor.style.setProperty('font-family','sans-serif','important');
      editor.style.setProperty('-webkit-text-size-adjust','100%');
      editor.style.setProperty('padding-top','0px','important');editor.style.setProperty('padding-bottom','0px','important');
      var width=editor.getBoundingClientRect().width;if(width<=0)return null;
      var probe=editor.cloneNode(true);
      probe.removeAttribute('id');probe.removeAttribute('contenteditable');probe.setAttribute('aria-hidden','true');
      Object.assign(probe.style,{position:'absolute',visibility:'hidden',pointerEvents:'none',height:'auto',minHeight:'0',maxHeight:'none',overflow:'visible',width:width+'px',top:'0',left:'0'});
      probe.style.setProperty('height','auto','important');probe.style.setProperty('min-height','0','important');probe.style.setProperty('max-height','none','important');
      // iOS 在活动编辑器内临时放入两行测量内容，也可能触发焦点自动滚动。
      // 用零高度裁剪容器隔离测量节点，保持活动编辑器的滚动范围稳定。
      var probeHost=null;
      if(watchViewport){
        probeHost=document.createElement('div');probeHost.className=root.className;
        probeHost.style.cssText='position:fixed!important;top:0;left:0;width:'+width+'px;height:0!important;min-height:0!important;overflow:hidden!important;visibility:hidden;pointer-events:none';
        document.body.appendChild(probeHost);probeHost.appendChild(probe);
      }else editor.parentElement.appendChild(probe);
      try{
        var contentHeight=probe.getBoundingClientRect().height;
        probe.innerHTML='<p><br></p>';var singleHeight=probe.getBoundingClientRect().height;
        probe.innerHTML='<p><br></p><p><br></p>';var lineHeight=probe.getBoundingClientRect().height-singleHeight;
        if(singleHeight<=0||lineHeight<=0)return null;
        return {contentHeight:contentHeight,singleHeight:singleHeight,lineHeight:lineHeight};
      }finally{probe.remove();if(probeHost)probeHost.remove();}
    }
    var composing=false,pasted=false,pending='',timer=null;
    function schedule(reason){
      if((reason!=='selection'&&reason!=='layout')||!pending)pending=reason;
      if(timer!==null)clearTimeout(timer);
      timer=setTimeout(function(){
        timer=null;var range=q.getSelection(),delta=q.getContents();
        var text=delta.ops.map(function(op){return typeof op.insert==='string'?op.insert:'\uFFFC';}).join('');
        if(text.slice(-1)==='\\n')text=text.slice(0,-1);
        var measured=measureLayout();
        syncIOSScroll(measured);
        if(measured&&typeof triggerEvent==='function')triggerEvent('nuwax-layout',measured);
        delta.__nuwaxComposer={layout:measured,text:text,cursor:range?range.index:-1,length:range?range.length:0,composing:composing,reason:pending,viewportCollapsed:window.innerWidth===0||window.innerHeight===0};
        if(typeof triggerEvent==='function')triggerEvent('input',{text:stripAnchor(q.getText()),html:q.root.innerHTML,delta:delta});
        pending='';pasted=false;
      },0);
    }
    function paste(){pasted=true;schedule('paste');}
    function checkViewport(){
      if(watchViewport&&!composing&&(window.innerWidth===0||window.innerHeight===0))schedule('viewport-check');
    }
    q.on('text-change',function(d,o,source){schedule(pasted?'paste':(source==='user'?'edit':'programmatic'));});
    q.on('selection-change',function(){schedule('selection');});
    q.root.addEventListener('paste',paste,true);q.root.addEventListener('drop',paste,true);
    q.root.addEventListener('beforeinput',function(e){if(e.inputType==='insertFromPaste'||e.inputType==='insertFromDrop')paste();},true);
    q.root.addEventListener('compositionstart',function(){composing=true;schedule('composition');});
    q.root.addEventListener('compositionend',function(){
      composing=false;schedule('edit');
      if(watchViewport){setTimeout(checkViewport,80);setTimeout(checkViewport,320);}
    });
    window.addEventListener('resize',function(){setTimeout(checkViewport,0);schedule('layout');});
    if(watchViewport){
      document.addEventListener('scroll',resetIOSScroll,true);
      window.addEventListener('scroll',resetIOSScroll);
      if(window.visualViewport)window.visualViewport.addEventListener('scroll',resetIOSScroll);
    }
    if(typeof ResizeObserver!=='undefined'){
      var measuredWidth=-1;
      var resizeObserver=new ResizeObserver(function(){
        var width=q.root.getBoundingClientRect().width;
        if(width!==measuredWidth){measuredWidth=width;schedule('layout');}
      });
      resizeObserver.observe(q.root);
    }
    q.__nuwaxRequestLayout=function(){schedule('layout');};
    schedule('layout');
    q.root.addEventListener('keydown',function(e){if(e.key==='Escape')schedule('dismiss');});
    if(harmonyAnchor){
      // 只有换行/空格也算空（零宽字符本身要忽略）
      function visuallyBlank(){
        var t=stripAnchor(q.getText()||'');
        for(var i=0;i<t.length;i++){var c=t.charCodeAt(i);if(c!==10&&c!==13&&c!==32&&c!==160)return false;}
        return true;
      }
      // 零宽字符会让 Quill 认为「非空」从而摘掉 ql-blank，placeholder 会消失；这里补回来
      function syncBlankClass(){
        if(!q.root||!q.root.classList)return;
        if(visuallyBlank()){if(!q.root.classList.contains('ql-blank'))q.root.classList.add('ql-blank');}
        else if(q.root.classList.contains('ql-blank'))q.root.classList.remove('ql-blank');
      }
      function ensureAnchor(){
        try{
          if(!visuallyBlank())return;
          if((q.getText()||'').indexOf(ZWSP)>=0)return;
          q.insertText(0,ZWSP,'silent');
          q.setSelection(1,0,'silent');
          syncBlankClass();
        }catch(eEnsure){}
      }
      // 锚点插入后一直留着（silent，不进 undo 栈、不触发 text-change）：
      // 用户开始输入后它仍在正文最前面，所以「回传给原生的纯文本 / indexed 文本 /
      // @ 触发坐标」必须口径一致 —— 见 conversation-input 的 stripComposerAnchor
      // 与 indexedEditorText 注释（indexed 保持 Quill 原始索引，不能剔）。
      q.root.addEventListener('focusin',function(){setTimeout(ensureAnchor,0);});
      q.on('selection-change',function(){syncBlankClass();if(visuallyBlank())setTimeout(ensureAnchor,0);});
      q.on('text-change',function(){setTimeout(syncBlankClass,0);});
      setTimeout(function(){if(document.activeElement===q.root)ensureAnchor();},0);
    }
  })();`;
}
