<template>
  <view
    class="avatar-uploader"
    :style="{ opacity: isUploading ? 0.7 : 1 }"
    @tap="handleChooseAvatar"
    @touchstart="setPressed(true)"
    @touchend="setPressed(false)"
    @touchcancel="setPressed(false)"
  >
    <image :src="resolvedAvatarSrc" mode="aspectFill" class="avatar-image" :alt="props.alt" @error="handleImageError" />
    <view class="avatar-edit-mask" :class="{ 'avatar-edit-mask-visible': isUploading || isPressed }"></view>
    <view class="avatar-edit-badge">
      <svg-icon name="icon-Edit" size="28" />
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, watch } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { getUploadFileAction } from "@/constants/common.constants";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import { apiUserUpdate } from "@/servers/account";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import { resolveAppSvgUrl } from "@/utils/remoteSvgImage";
  import defaultAvatar from "@/static/assets/avatar.png";

  interface AvatarUploaderProps {
    avatar: string;
    alt: string;
  }

  const props = defineProps<AvatarUploaderProps>();
  const emit = defineEmits(["update-avatar"]);
  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
  const isUploading = ref<boolean>(false);
  const isPressed = ref<boolean>(false);
  const imageLoadFailed = ref<boolean>(false);

  const setPressed = (pressed: boolean): void => {
    isPressed.value = pressed;
  };

  const displayAvatar = computed((): string => {
    if (imageLoadFailed.value || props.avatar.length == 0) return defaultAvatar;
    return props.avatar;
  });

  // App 端 <image> 渲染远程 SVG 缩放失效，统一走 resolveAppSvgUrl 按容器尺寸解析为 data URL；
  // 非 SVG / H5 / 小程序原样透传，不产生额外请求。
  const resolvedAvatarSrc = ref<string>(defaultAvatar);
  watch(
    displayAvatar,
    async (val: string) => {
      resolvedAvatarSrc.value = await resolveAppSvgUrl(val, 120, 120);
    },
    { immediate: true },
  );

  const handleImageError = () => {
    imageLoadFailed.value = true;
  };

  const isAvatarImage = (type: string, fileName: string): boolean => {
    if (type == "image/jpeg" || type == "image/jpg" || type == "image/png" || type == "image/svg+xml") return true;
    const lowerName = fileName.toLowerCase().split("?")[0];
    return lowerName.endsWith(".jpg") || lowerName.endsWith(".jpeg") || lowerName.endsWith(".png") || lowerName.endsWith(".svg");
  };

  const uploadAvatarFile = (filePath: string): Promise<string> => {
    const header = new UTSJSONObject();
    const token = uni.getStorageSync(ACCESS_TOKEN);
    if (token != null && `${token}`.length > 0) header["Authorization"] = `Bearer ${token}`;

    return new Promise<string>((resolve, reject) => {
      uni.uploadFile({
        url: getUploadFileAction(),
        filePath,
        name: "file",
        header,
        formData: { type: "tmp" },
        success: (res) => {
          try {
            const response = JSON.parse(res.data) as UTSJSONObject;
            if (apiResCode(response) != SUCCESS_CODE) {
              reject(new Error("avatar upload response failed"));
              return;
            }
            const data = apiResData<any>(response);
            if (data == null) {
              reject(new Error("avatar upload url missing"));
              return;
            }
            const urlValue = (data as UTSJSONObject)["url"];
            const url = urlValue != null ? `${urlValue}` : "";
            if (url.length == 0) {
              reject(new Error("avatar upload url missing"));
              return;
            }
            resolve(url);
          } catch (error) {
            reject(error);
          }
        },
        fail: (error) => reject(error),
      });
    });
  };

  const uploadAvatar = async (filePath: string) => {
    isUploading.value = true;
    uni.showLoading({ title: t("Mobile.Common.loading") });
    try {
      const avatarUrl = await uploadAvatarFile(filePath);
      const updateBody = new UTSJSONObject();
      updateBody["avatar"] = avatarUrl;
      const updateResult = await apiUserUpdate(updateBody);
      if (apiResCode(updateResult) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Profile.avatarUploadFailed"), icon: "none" });
        return;
      }
      imageLoadFailed.value = false;
      emit("update-avatar", avatarUrl);
      uni.showToast({ title: t("Mobile.Profile.avatarUpdated"), icon: "success" });
    } catch (error) {
      console.error("更新头像失败", error);
      uni.showToast({ title: t("Mobile.Profile.avatarUploadFailed"), icon: "none" });
    } finally {
      uni.hideLoading();
      isUploading.value = false;
    }
  };

  const handleChooseAvatar = () => {
    if (isUploading.value) return;
    uni.chooseImage({
      count: 1,
      sizeType: ["compressed"],
      sourceType: ["album", "camera"],
      success: (res) => {
        const file = res.tempFiles.length > 0 ? res.tempFiles[0] : null;
        if (file == null) return;
        const fileType = file.type != null ? `${file.type}`.toLowerCase() : "";
        const fileName = file.name != null && file.name.length > 0 ? file.name : file.path;
        if (!isAvatarImage(fileType, fileName)) {
          uni.showToast({ title: t("Mobile.Profile.avatarInvalidType"), icon: "none" });
          return;
        }
        if (file.size >= 2 * 1024 * 1024) {
          uni.showToast({ title: t("Mobile.Profile.avatarTooLarge"), icon: "none" });
          return;
        }
        uploadAvatar(file.path);
      },
    });
  };
</script>

<style lang="scss" scoped>
  .avatar-uploader {
    position: relative;
    width: 160rpx;
    height: 160rpx;
    overflow: hidden;
    background-color: #ffffff;
    border-radius: 50%;

    .avatar-image {
      width: 100%;
      height: 100%;
    }

    .avatar-edit-mask {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background-color: rgba(0, 0, 0, 0.28);
      opacity: 0;
    }

    .avatar-edit-badge {
      position: absolute;
      right: 8rpx;
      bottom: 8rpx;
      z-index: 1;
      width: 52rpx;
      height: 52rpx;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: rgba(255, 255, 255, 0.72);
      border-radius: 50%;
      box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
    }

    .avatar-edit-mask-visible {
      opacity: 1;
    }
  }
</style>
