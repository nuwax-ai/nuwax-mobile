<template>
  <view class="checkbox-row">
    <checkbox
      class="checkbox"
      color="#5147ff"
      style="transform: scale(0.7)"
      iconColor="#fff"
      activeBackgroundColor="#5147ff"
      value="agree"
      :checked="modelValue"
      @click.stop="toggleAgree"
    />
    <!-- App 端约束：协议片段不可嵌进父 text（text 内嵌 text 渲染为 span，border 不渲染）；下划线用绝对定位 view 覆盖，零占位不影响基线 -->
    <view class="agreement-content">
      <text class="prefix" @click.stop="toggleAgree">{{
        t("Mobile.Auth.agreementPrefix")
      }}</text>
      <view class="link-wrap">
        <text class="link" @click.stop="handleServiceAgreement">{{
          t("Mobile.Auth.serviceAgreement")
        }}</text>
        <view class="link-underline" />
      </view>
      <text class="separator">{{
        t("Mobile.Auth.agreementSeparator")
      }}</text>
      <view class="link-wrap">
        <text class="link" @click.stop="handlePrivacyAgreement">{{
          t("Mobile.Auth.privacyAgreement")
        }}</text>
        <view class="link-underline" />
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { handleExternalLink } from "@/utils/system";
import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

const _params = emptyI18nParams();
const t = (key: string): string => translateFn(key, _params, "");

interface AgreementCheckboxProps {
  modelValue: boolean;
}

const props = withDefaults(defineProps<AgreementCheckboxProps>(), {
  modelValue: false,
});

const emit = defineEmits<{
  "update:modelValue": [value: boolean];
}>();

/** 勾选 / 取消勾选（checkbox 与协议前缀文案共用） */
const toggleAgree = () => {
  emit("update:modelValue", !props.modelValue);
};

// 打开服务协议
const handleServiceAgreement = () => {
  handleExternalLink(translateFn("Mobile.Auth.userAgreementLink", _params, ""));
};

// 打开隐私协议
const handlePrivacyAgreement = () => {
  handleExternalLink(translateFn("Mobile.Auth.privacyAgreementLink", _params, ""));
};
</script>

<style lang="scss" scoped>
  .checkbox-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;

    .checkbox {
      flex-shrink: 0;
    }

    .agreement-content {
      flex: 1;
      width: 0;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      // align-items: flex-start;
      font-size: 26rpx;
      // line-height: 44rpx;
      color: rgba(21, 23, 31, 0.5);

      .prefix,
      .separator {
        font-size: 26rpx;
        // line-height: 44rpx;
        color: rgba(21, 23, 31, 0.5);
      }

      .link-wrap {
        position: relative;

        .link {
          font-size: 26rpx;
          font-weight: 500;
          color: rgba(21, 23, 31, 0.5);
        }

        .link-underline {
          position: absolute;
          left: 0;
          width: 100%;
          bottom: 2rpx;
          height: 2rpx;
          background-color: rgba(21, 23, 31, 0.3);
        }
      }
    }
  }
</style>
