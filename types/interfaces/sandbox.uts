export interface SandboxInfo {
  sandboxId: string;
  name: string;
  description: string;
}

/** 智能体与沙盒的映射：agentId -> sandboxId */
export type AgentSandboxMap = Record<string, string>;

export interface SandboxListResponse {
  sandboxes: SandboxInfo[];
  agentSelected: AgentSandboxMap;
}

/** 我的电脑列表项（GET /api/sandbox/config/list，SandboxConfigDto 子集） */
export interface SandboxComputerItem {
  // 配置 ID
  id: number;
  // 电脑/沙盒名称
  name: string;
  // 是否在线
  online: boolean;
  // 唯一标识
  configKey: string;
}
