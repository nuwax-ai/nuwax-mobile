/**
 * App web-view 内嵌 H5：左边缘右滑返回。
 *
 * 常驻聊天壳盖在首页 Tab 上，不是独立原生页；iOS 系统侧滑不会触发 onBackPress。
 * 在 H5 内检测左边缘右滑，达到阈值后回调，由调用方走 app-nav-back / app-exit。
 *
 * 仅 H5/WEB 生效；其它端 install/uninstall 为空操作。
 */

type EdgeSwipeBackHandler = () => void;

const EDGE_START_PX: number = 48;
const MIN_HORIZONTAL_PX: number = 56;
const MIN_HORIZONTAL_RATIO: number = 0.2;
/** |dy| 超过 |dx| 的此比例则视为纵向滚动，取消本次边缘返回 */
const MAX_VERTICAL_TO_HORIZONTAL: number = 0.65;

let installed: boolean = false;
let swipeHandler: EdgeSwipeBackHandler | null = null;
let tracking: boolean = false;
let startX: number = 0;
let startY: number = 0;
let lockedHorizontal: boolean = false;
let fired: boolean = false;

function screenWidth(): number {
  // #ifdef H5 || WEB
  try {
    const w = window.innerWidth;
    if (w > 0) {
      return w;
    }
  } catch (_e) {
    // ignore
  }
  // #endif
  return 375;
}

function minDxThreshold(): number {
  const byRatio = screenWidth() * MIN_HORIZONTAL_RATIO;
  return byRatio > MIN_HORIZONTAL_PX ? byRatio : MIN_HORIZONTAL_PX;
}

function onTouchStart(e: TouchEvent): void {
  tracking = false;
  lockedHorizontal = false;
  fired = false;
  if (e.touches == null || e.touches.length == 0) {
    return;
  }
  const t = e.touches[0];
  if (t == null) {
    return;
  }
  const x = t.clientX;
  if (x > EDGE_START_PX) {
    return;
  }
  tracking = true;
  startX = x;
  startY = t.clientY;
}

function onTouchMove(e: TouchEvent): void {
  if (tracking != true || fired == true) {
    return;
  }
  if (e.touches == null || e.touches.length == 0) {
    return;
  }
  const t = e.touches[0];
  if (t == null) {
    return;
  }
  const dx = t.clientX - startX;
  const dy = t.clientY - startY;
  const absDx = dx > 0 ? dx : -dx;
  const absDy = dy > 0 ? dy : -dy;

  if (lockedHorizontal != true) {
    // 尚未判定方向：纵向占优则放弃（避免干扰消息列表滚动）
    if (absDy > 12 && absDy > absDx * MAX_VERTICAL_TO_HORIZONTAL) {
      tracking = false;
      return;
    }
    if (absDx > 10 && dx > 0 && absDx > absDy * MAX_VERTICAL_TO_HORIZONTAL) {
      lockedHorizontal = true;
    } else {
      return;
    }
  }

  if (dx <= 0) {
    return;
  }

  try {
    e.preventDefault();
  } catch (_ePrev) {
    // ignore
  }

  if (dx >= minDxThreshold()) {
    fired = true;
    tracking = false;
    lockedHorizontal = false;
    const h = swipeHandler;
    if (h != null) {
      h();
    }
  }
}

function onTouchEnd(_e: TouchEvent): void {
  tracking = false;
  lockedHorizontal = false;
}

function onTouchCancel(_e: TouchEvent): void {
  tracking = false;
  lockedHorizontal = false;
  fired = false;
}

/**
 * 安装左边缘右滑监听（幂等）。重复调用只更新回调。
 * @param onSwipeBack 达到阈值时触发（由业务发 app-nav-back / app-exit 或关弹窗）
 */
export function installAppWebViewEdgeSwipeBack(onSwipeBack: EdgeSwipeBackHandler): void {
  // #ifdef H5 || WEB
  swipeHandler = onSwipeBack;
  if (installed == true) {
    return;
  }
  try {
    // capture=true：优先于列表滚动拿到边缘起点；move 非 passive 才能 preventDefault
    const optsPassive = { capture: true, passive: true } as any;
    const optsActive = { capture: true, passive: false } as any;
    window.addEventListener("touchstart", onTouchStart, optsPassive);
    window.addEventListener("touchmove", onTouchMove, optsActive);
    window.addEventListener("touchend", onTouchEnd, optsPassive);
    window.addEventListener("touchcancel", onTouchCancel, optsPassive);
    installed = true;
  } catch (_eInstall) {
    installed = false;
    swipeHandler = null;
  }
  // #endif
}

/** 卸载边缘滑动监听；页面卸载时调用。 */
export function uninstallAppWebViewEdgeSwipeBack(): void {
  // #ifdef H5 || WEB
  swipeHandler = null;
  tracking = false;
  lockedHorizontal = false;
  fired = false;
  if (installed != true) {
    return;
  }
  try {
    window.removeEventListener("touchstart", onTouchStart, true);
    window.removeEventListener("touchmove", onTouchMove, true);
    window.removeEventListener("touchend", onTouchEnd, true);
    window.removeEventListener("touchcancel", onTouchCancel, true);
  } catch (_eRemove) {
    // ignore
  }
  installed = false;
  // #endif
}
