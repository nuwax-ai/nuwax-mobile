<!-- 智能体卡片组件 -->
<template>
  <!-- #ifndef APP-IOS -->
  <view
    class="container"
    :hover-class="hoverClass"
    @click.prevent="handleClick"
    @longpress.stop.prevent="handleLongPress"
    @touchstart="handleTouchStart"
    @touchmove="handleTouchMove"
    @touchend="handleTouchEnd"
    @touchcancel="handleTouchEnd"
  >
  <!-- #endif -->
  <!-- #ifdef APP-IOS -->
  <view
    class="container"
    @click.prevent="handleClick"
    @longpress.stop.prevent="handleLongPress"
  >
  <!-- #endif -->
    <image
      :src="currentIcon"
      class="agent-icon-image"
      mode="aspectFill"
      lazy-load
      :alt="name != null && name != '' ? name : agentIconAltLabel"
      @error="handleImageError"
    />
    <view class="info-box">
      <view class="agent-name-row">
        <text class="agent-name text-ellipsis">{{ name }}</text>
        <text class="agent-time text-ellipsis" v-if="modifiedTime">{{ modifiedTime }}</text>
      </view>
      <view class="agent-description-row" v-if="description || paymentRequired">
        <text class="agent-description text-ellipsis">{{ description }}</text>
        <view class="status-tags" v-if="paymentRequired">
          <text v-if="subscribed" class="status-tag status-active">{{ subscribedTagLabel }}</text>
          <text v-else class="status-tag status-warning">{{ paymentRequiredTagLabel }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import agentImage from "@/static/assets/agent_image.png";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  const t = (key : string) : string => {
    return translateFn(key, emptyI18nParams(), key);
  };

  interface RecentUsedAgentItemProps {
    icon: string;
    name: string;
    showModifiedTime: boolean;
    modifiedTime: string;
    description: string;
    paymentRequired: boolean;
    subscribed: boolean;
  }

  const props = withDefaults(defineProps<RecentUsedAgentItemProps>(), {
    showModifiedTime: true,
    modifiedTime: "",
    description: "",
    paymentRequired: false,
    subscribed: false,
  });

  const currentIcon = ref<string>(props.icon);

  const emit = defineEmits(["click", "longpress"]);

  const touchStartX = ref<number>(0);
  const touchStartY = ref<number>(0);
  const hasMoved = ref<boolean>(false);

  // iOS 模拟器：关闭 hover-class，减少 UIKit touch 状态追踪开销
  const hoverClass = computed<string>(() : string => {
    // #ifdef APP-IOS
    return "";
    // #endif
    // #ifndef APP-IOS
    return "container-active";
    // #endif
  });

  // 静态文案抽成 computed：本组件每个可见 cell 都会渲染，避免每次渲染都调 t()
  const agentIconAltLabel = computed((): string => t("Mobile.Common.agentIconAlt"));
  const subscribedTagLabel = computed((): string => t("Mobile.AgentList.subscribedTag"));
  const paymentRequiredTagLabel = computed((): string => t("Mobile.AgentList.paymentRequiredTag"));

  const handleImageError = () => {
    currentIcon.value = agentImage;
  };

  const handleTouchStart = (e: UniTouchEvent) => {
    if (e == null || e.touches == null || e.touches.length == 0) return;
    touchStartX.value = e.touches[0].clientX;
    touchStartY.value = e.touches[0].clientY;
    hasMoved.value = false;
  };

  const handleTouchMove = (e: UniTouchEvent) => {
    if (e == null || e.touches == null || e.touches.length == 0) return;
    const deltaX = Math.abs(e.touches[0].clientX - touchStartX.value);
    const deltaY = Math.abs(e.touches[0].clientY - touchStartY.value);
    if (deltaX > 10 || deltaY > 10) {
      hasMoved.value = true;
    }
  };

  const handleTouchEnd = () => {
  };

  const handleClick = () => {
    emit("click");
  };

  const handleLongPress = () => {
    if (hasMoved.value == true) {
      return;
    }
    emit("longpress");
  };
</script>

<style scoped lang="scss">
  .container {
    width: 100%;
    height: 150rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 16rpx 0 32rpx;

    /* #ifdef H5 || APP-ANDROID */
    overflow: hidden;
    transform: translateZ(0);
    transition: background-color 0.3s ease;
    /* #endif */

    &-active {
      background-color: rgba(12, 20, 102, 0.04);
    }

    /* 头像：直接 border-radius，无 wrapper view，无 overflow hidden
       在 iOS 上映射为 UIImageView.layer.cornerRadius，硬件加速、无离屏渲染 */
    .agent-icon-image {
      width: 96rpx;
      height: 96rpx;
      border-radius: 50%;
      flex-shrink: 0;
      margin-right: 24rpx;
    }

    .info-box {
      height: 150rpx;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-bottom-width: 0;

      .agent-name-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        margin-bottom: 8rpx;

        .agent-name {
          flex: 1;
          min-width: 0;
          font-size: 32rpx;
          font-weight: 600;
          color: #15171f;
          margin-right: 8rpx;
        }

        .agent-time {
          flex-shrink: 0;
          width: 180rpx;
          font-size: 24rpx;
          font-weight: 400;
          color: rgba(21, 23, 31, 0.5);
          text-align: right;
        }
      }

      .agent-description-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        min-width: 0;

        .agent-description {
          flex: 1;
          min-width: 0;
          font-size: 28rpx;
          color: rgba(21, 23, 31, 0.7);
          line-height: 44rpx;
          font-weight: 400;
        }

        .status-tags {
          display: flex;
          align-items: center;
          flex-shrink: 0;
          margin-left: 12rpx;

          .status-tag {
            padding: 2rpx 12rpx;
            border-radius: 6rpx;
            font-size: 20rpx;
            font-weight: 500;
            line-height: 1.5;
          }

          .status-active {
            background-color: rgba(82, 196, 26, 0.1);
            color: #52c41a;
          }

          .status-warning {
            border: 2rpx solid rgba(0, 122, 255, 0.4);
            color: #007aff;
            background-color: rgba(0, 122, 255, 0.08);
          }
        }
      }
    }
  }
</style>
