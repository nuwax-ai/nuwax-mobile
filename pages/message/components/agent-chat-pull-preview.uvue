    justify-content: center;
    position: relative;
  }

  .pull-chat-preview__tab--active {
    border-bottom: 2px solid #5147ff;
  }

  .pull-chat-preview__tab-text {
    font-size: 14px;
    line-height: 20px;
    color: #777582;
  }

  .pull-chat-preview__tab-text--active {
    color: #292733;
