  }

  .think-caret-open {
    transform: rotate(0deg);
    color: rgba(5, 5, 5, 0.65);
  }

  /* 顶层兜底：思考时长 + 运行中 ticker（与嵌套版本等值，防 dev 深层链路不命中） */
  .think-duration {
    margin-left: 8rpx;
    color: rgba(5, 5, 5, 0.45);
    font-size: 26rpx;
    line-height: 40rpx;
