    justify-content: space-between;
  }

  .ms-row-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-right: 12px;
  }

  /* 与发起会议页一致：字段标题取 rgba(21,23,31,0.8) */
  .ms-label {
    font-size: 13px;
    line-height: 18px;
    color: rgba(21, 23, 31, 0.8);
  }

  .ms-label--inline {
    flex-shrink: 0;
    margin-right: 12px;
  }

  /* 与发起会议页一致：提示文案用 rgba(21,23,31,0.8) */
  .ms-hint {
    margin-top: 4px;
    font-size: 11px;
    line-height: 16px;
    color: rgba(21, 23, 31, 0.8);
  }

  .ms-input {
    margin-top: 8px;
    height: 24px;
    font-size: 16px;
    line-height: 24px;
    color: #141416;
  }

  /* ===== 开始时间：两个底部浮层选择器（日期 / 时间） ===== */
  .ms-pick-row {
    margin-top: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .ms-pick-col {
    flex: 1;
    margin-right: 10px;
  }

  .ms-pick-col--last {
    margin-right: 0;
  }

  .ms-pick {
    width: 100%;
  }

  .ms-pick__box {
    height: 40px;
    padding: 0 10px;
    border-radius: 10px;
    background-color: #f6f5f8;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .ms-pick__text {
    margin: 0 6px;
    font-size: 14px;
    line-height: 20px;
    color: #141416;
  }

  /* ===== 会议号 ===== */
  .ms-no {
    margin-top: 6px;
    font-size: 20px;
    line-height: 27px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #141416;
  }

  .ms-no-actions {
    margin-top: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .ms-text-btn {
    margin-right: 8px;
    padding: 5px 12px;
    border-radius: 14px;
    background-color: #f2f1f7;
  }

  .ms-text-btn--active {
    background-color: #e8e7f0;
  }

  .ms-text-btn__text {
    font-size: 12px;
    line-height: 17px;
    color: #5147ff;
  }

  .ms-switch {
    transform: scale(0.85);
  }

  /* ===== 添加参与者（选人盒：与建群页 cg-tagbox 同款） ===== */
  .ms-tagbox {
    margin-top: 8px;
    min-height: 40px;
    padding: 4px 4px 4px 12px;
    border-radius: 10px;
    background-color: #f6f5f8;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    box-sizing: border-box;
  }

  /* Android 原生输入控件底部视觉偏高，建群页同样只去掉下内边距（真机实测） */
  /* #ifdef APP-ANDROID */
  .ms-tagbox {
    padding-bottom: 0;
  }
  /* #endif */

  .ms-tagbox-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }

  /* 输入外固定高行槽：Android EditText 按内容行盒测量、可超 CSS 高，
     直接作 flex 子项会把盒子撑高（建群页同款处理），超出部分裁掉 */
  .ms-tagbox-field {
    flex: 1;
    min-width: 60px;
    height: 32px;
    display: flex;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
  }

  .ms-tagbox-input {
    flex: 1;
    /* H5 高度+行高必须同值成对设（同建群页注释：placeholder 是绝对定位盒子） */
    height: 32px;
    /* #ifdef H5 */
    line-height: 32px;
    /* #endif */
    font-size: 14px;
    color: #1c1b20;
  }

  .ms-search-icon {
    width: 32px;
    height: 32px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ms-ph {
    color: #b7b7be;
    font-size: 13px;
  }

  /* 灰盒内白芯 tag（描边分隔），点整芯移除 */
  .ms-tag {
    margin: 0 8px 6px 0;
    padding: 4px 10px;
    border-radius: 16px;
    background-color: #ffffff;
    border: 1px solid #eceaf1;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
  }

  .ms-tag--active {
    background-color: #f4f3fa;
  }

  .ms-tag__text {
    color: #4b4b52;
    font-size: 12px;
    line-height: 17px;
  }

  .ms-tag__x {
    margin-left: 5px;
    color: #9a9aa2;
    font-size: 14px;
    line-height: 17px;
  }

  /* ===== 候选面板（盒子下方，常驻） ===== */
  .ms-panel {
    margin-top: 8px;
    border-radius: 10px;
    background-color: #f9f9fb;
    overflow: hidden;
  }

  /* 高度由模板上的 :style 按行数算出（见 inviteeListHeight） */
  .ms-panel-list {
    width: 100%;
  }

  .ms-panel-body {
    padding: 2px 0;
