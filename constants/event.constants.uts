/**
 * 事件常量
 * 用于事件订阅和发布时的类型安全引用
 *
 * 与 PC 端 @/constants/event.constants.tsx 保持一致。
 * 字符串值与 types/enums/event.uts 中 EventTypeEnum 对齐（snake_case）。
 */
import { EventTypeEnum } from '@/types/enums/event';

export const EVENT_TYPE = {
  // ---- 现有：5s 事件总线 + 通知 ----
  NewNotifyMessage: EventTypeEnum.NewNotifyMessage, // 新通知消息
  RefreshChatMessage: EventTypeEnum.RefreshChatMessage, // 刷新会话
  RefreshFileList: EventTypeEnum.RefreshFileList, // 刷新文件列表
  ChatFinished: EventTypeEnum.ChatFinished, // 会话结束

  // ---- 新增：IM WebSocket 帧事件 ----
  ImMessageReceived: EventTypeEnum.ImMessageReceived,
  ImMessageRevoked: EventTypeEnum.ImMessageRevoked,
  ImMessageEdited: EventTypeEnum.ImMessageEdited,
  ImConversationUpdated: EventTypeEnum.ImConversationUpdated,
  ImConversationUnread: EventTypeEnum.ImConversationUnread,
  ImReadNotified: EventTypeEnum.ImReadNotified,
  ImAgentStatus: EventTypeEnum.ImAgentStatus,
  ImCustomEvent: EventTypeEnum.ImCustomEvent,
  ImContactUpdated: EventTypeEnum.ImContactUpdated,
  ImKicked: EventTypeEnum.ImKicked,
  ImError: EventTypeEnum.ImError,
  ImConnectionState: EventTypeEnum.ImConnectionState,
  ImAuthInvalid: EventTypeEnum.ImAuthInvalid,
};