<template>
  <view class="container relative flex flex-col">
    <custom-nav-bar :title="t('Mobile.Terminal.monitorRecords')" className="border-b" hasSafetyZone showBack />

    <!-- 搜索 + 时间筛选 -->
    <view class="search-row">
      <view class="search-box">
        <input class="search-input" v-model="keyword" :placeholder="searchPlaceholder" placeholder-class="search-placeholder" @confirm="handleSearch" />
      </view>
      <view class="filter-btn" hover-class="filter-btn-active" @click="handleFilter">
        <text class="filter-text">{{ currentFilterLabel }}</text>
      </view>
    </view>

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false" @scrolltolower="handleLoadMore">
      <view class="record-list">
        <view
          :class="['record-card', 'level-' + item.level]"
          v-for="item in recordList"
          :key="item.id"
          hover-class="record-card-active"
          @click="handleDetail(item)"
        >
          <view class="record-head">
            <text class="record-title text-ellipsis">{{ item.title }}</text>
            <text class="record-date">{{ formatDate(item.startedAt) }}</text>
          </view>
          <view class="record-meta">
            <text :class="['keyword-text', 'keyword-' + item.level]">{{ item.statusLabel }}</text>
          </view>
          <text v-if="item.transcriptPreview != ''" class="record-summary">{{ item.transcriptPreview }}</text>
          <view class="record-actions" @tap.stop="">
            <view v-if="item.hasAudio" class="action-btn" hover-class="action-btn-active" @click="handleReplay(item)">
              <text class="action-text">▶ {{ t("Mobile.Terminal.replay") }}</text>
            </view>
            <view v-if="item.hasAudio" :class="['action-btn', item.downloading ? 'action-btn--busy' : '']" hover-class="action-btn-active" @click="handleDownload(item)">
              <text class="action-text">{{ item.downloading ? "… " : "⬇ " }}{{ item.downloading ? t("Mobile.Terminal.downloading") : t("Mobile.Terminal.download") }}</text>
            </view>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-box" v-if="!loading && recordList.length == 0">
          <text class="empty-text">{{ t("Mobile.Terminal.noMonitorRecords") }}</text>
        </view>
        <!-- 加载更多 -->
        <view class="empty-box" v-if="loading">
          <text class="empty-text">{{ t("Mobile.Terminal.loading") }}</text>
        </view>
        <view class="empty-box" v-if="!loading && !hasMore && recordList.length > 0">
          <text class="empty-text">{{ t("Mobile.Terminal.noMore") }}</text>
        </view>
      </view>
      <view class="bottom-space"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad, onShow } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiVoxMonitoringList, apiVoxMonitoringAudioUrl } from "@/servers/vox/voxMonitoring";
  import { AppMonitoringListParams } from "@/types/interfaces/voxMonitoring";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import { SUCCESS_CODE, USER_NO_LOGIN, REDIRECT_LOGIN } from "@/constants/codes.constants";
  import { downloadVoxRecording } from "@/utils/voxRecordingDownload";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const keyword = ref<string>("");
  const searchPlaceholder = ref<string>(t("Mobile.Terminal.searchKeyword"));
  // 从设备详情带入；监控列表接口必传
  const agentId = ref<number>(0);

  /**
   * 监控记录项（对齐后端 AppMonitoringView）。
   * title 由 runId / #id 派生；level 由 status 推导：FAIL/ERROR=error、处理中类=warn、其余=info。
   */
  class MonitorRecord {
    id: number = 0;
    title: string = "";
    status: string = "";
    statusLabel: string = "";
    transcriptPreview: string = "";
    startedAt: string = "";
    hasAudio: boolean = false;
    level: string = "info";
    downloading: boolean = false;
    constructor(id: number, runId: string, status: string, transcriptPreview: string, startedAt: string, hasAudio: boolean) {
      this.id = id;
      this.title = runId != "" ? runId : "监控 #" + id;
      this.status = status;
      this.statusLabel = status != "" ? status : "—";
      this.transcriptPreview = transcriptPreview;
      this.startedAt = startedAt;
      this.hasAudio = hasAudio;
      const s = status.toUpperCase();
      if (s.includes("FAIL") || s.includes("ERROR")) {
        this.level = "error";
      } else if (s.includes("PEND") || s.includes("PROCESS") || s.includes("RUN") || s.includes("ACTIVE")) {
        this.level = "warn";
      } else {
        this.level = "info";
      }
    }
  }

  const recordList = ref<MonitorRecord[]>([]);
  const loading = ref<boolean>(false);
  const page = ref<number>(1);
  const pageSize = 10;
  const total = ref<number>(0);
  const hasMore = ref<boolean>(false);

  // 时间筛选（timeRange）
  class FilterOption {
    value: string = "";
    label: string = "";
    constructor(value: string, label: string) {
      this.value = value;
      this.label = label;
    }
  }
  const timeRange = ref<string>("ALL");
  const currentFilterLabel = ref<string>(t("Mobile.Terminal.allTime"));
  const filterOptions = [
    new FilterOption("ALL", t("Mobile.Terminal.allTime")),
    new FilterOption("TODAY", t("Mobile.Terminal.rangeToday")),
    new FilterOption("THIS_WEEK", t("Mobile.Terminal.rangeThisWeek")),
    new FilterOption("THIS_MONTH", t("Mobile.Terminal.rangeThisMonth")),
  ];

  // ISO 时间 → MM-DD HH:mm 展示
  const formatDate = (iso: string): string => {
    if (iso.length < 16) return iso;
    return `${iso.substring(5, 10)} ${iso.substring(11, 16)}`;
  };

  const strVal = (obj: UTSJSONObject, key: string): string => {
    const v = obj[key];
    return v != null ? `${v}` : "";
  };

  const fetchList = async (reset: boolean) => {
    if (loading.value) return;
    if (agentId.value <= 0) {
      uni.showToast({ title: t("Mobile.Terminal.agentIdMissing"), icon: "none" });
      return;
    }
    loading.value = true;
    if (reset) {
      page.value = 1;
    }
    try {
      const params = new AppMonitoringListParams();
      params.keyword = keyword.value.trim();
      params.timeRange = timeRange.value;
      params.page = page.value;
      params.pageSize = pageSize;
      params.agentId = agentId.value;
      const res = await apiVoxMonitoringList(params);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const obj = raw != null ? (raw as UTSJSONObject) : null;
        const itemsVal = obj != null ? obj["items"] : null;
        const items = itemsVal != null ? (itemsVal as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        const list: MonitorRecord[] = [];
        for (let i = 0; i < items.length; i++) {
          const m = items[i];
          const idVal = m["id"];
          const audioVal = m["audioFileUrl"];
          list.push(new MonitorRecord(
            idVal != null ? (idVal as number) : 0,
            strVal(m, "runId"),
            strVal(m, "status"),
            strVal(m, "transcriptPreview"),
            strVal(m, "startedAt"),
            audioVal != null && `${audioVal}` != "",
          ));
        }
        if (reset) {
          recordList.value = list;
        } else {
          recordList.value = recordList.value.concat(list);
        }
        const totalVal = obj != null ? obj["total"] : null;
        total.value = totalVal != null ? (totalVal as number) : 0;
        hasMore.value = recordList.value.length < total.value;
      } else if (apiResCode(res) != USER_NO_LOGIN && apiResCode(res) != REDIRECT_LOGIN) {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.fetchMonitorFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchList error", e);
    } finally {
      loading.value = false;
    }
  };

  const handleSearch = () => {
    fetchList(true);
  };

  const handleFilter = () => {
    const labels: string[] = [];
    const values: string[] = [];
    for (let i = 0; i < filterOptions.length; i++) {
      labels.push(filterOptions[i].label);
      values.push(filterOptions[i].value);
    }
    uni.showActionSheet({
      itemList: labels,
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        const next = values[res.tapIndex];
        if (next != timeRange.value) {
          timeRange.value = next;
          currentFilterLabel.value = labels[res.tapIndex];
          fetchList(true);
        }
      },
    });
  };

  const handleLoadMore = () => {
    if (!hasMore.value || loading.value) return;
    page.value = page.value + 1;
    fetchList(false);
  };

  const handleReplay = (item: MonitorRecord) => {
    uni.navigateTo({
      url: `/subpackages/pages/terminal/terminal-meeting-detail?id=${item.id}&autoplay=1&recordType=monitoring`,
    });
  };

  /** 监控详情页尚未独立，先诚实提示 */
  const handleDetail = (_item: MonitorRecord) => {
    uni.showToast({ title: t("Mobile.Terminal.monitorDetailWip"), icon: "none" });
  };

  const handleDownload = async (item: MonitorRecord) => {
    if (item.downloading) return;
    item.downloading = true;
    try {
      await downloadVoxRecording(apiVoxMonitoringAudioUrl(item.id));
    } catch (e) {
      console.error("handleDownload error", e);
      uni.showToast({ title: t("Mobile.Terminal.downloadFailed"), icon: "none" });
    } finally {
      item.downloading = false;
    }
  };

  onLoad((options: any) => {
    setCurrentPageNavigationBarTitle();
    if (options != null) {
      const optObj = options as UTSJSONObject;
      const id = optObj["agentId"];
      if (id != null && `${id}`.length > 0) {
        const parsed = parseFloat(`${id}`);
        agentId.value = !isNaN(parsed) && parsed > 0 ? parsed as number : 0;
      }
    }
  });

  onShow(() => {
    fetchList(true);
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .search-row {
    display: flex;
    flex-direction: row;
    padding: 24rpx 24rpx 0;

    .search-box {
      flex: 1;
      background-color: #ffffff;
      border-radius: 16rpx;
      padding: 20rpx 28rpx;
      margin-right: 16rpx;

      .search-input {
        width: 100%;
        font-size: 28rpx;
        color: #1a1a1a;
      }

      .search-placeholder {
        color: #c0c0c0;
      }
    }

    .filter-btn {
      padding: 20rpx 28rpx;
      border-radius: 16rpx;
      background-color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;

      &-active {
        background-color: rgba(12, 20, 102, 0.04);
      }

      .filter-text {
        font-size: 26rpx;
        color: #666666;
      }
    }
  }

  .record-list {
    padding: 24rpx;
  }

  .record-card {
    background-color: #ffffff;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 20rpx;
    border-left: 6rpx solid #c0c0c0;

    &.level-error {
      border-left-color: #fa5151;
    }

    &.level-warn {
      border-left-color: #ff9500;
    }

    &.level-info {
      border-left-color: #999999;
    }

    &-active {
      background-color: rgba(12, 20, 102, 0.04);
    }

    .record-head {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 12rpx;

      .record-title {
        flex: 1;
        font-size: 30rpx;
        font-weight: 600;
        color: #1a1a1a;
        margin-right: 16rpx;
      }

      .record-date {
        font-size: 22rpx;
        color: #999999;
        flex-shrink: 0;
      }
    }

    .record-meta {
      display: flex;
      flex-direction: row;
      align-items: center;
      margin-bottom: 12rpx;

      .keyword-text {
        font-size: 22rpx;
        padding: 4rpx 16rpx;
        border-radius: 8rpx;
        font-weight: 600;
        margin-right: 16rpx;

        &.keyword-error {
          color: #fa5151;
          background-color: rgba(250, 81, 81, 0.08);
        }

        &.keyword-warn {
          color: #ff9500;
          background-color: rgba(255, 149, 0, 0.08);
        }

        &.keyword-info {
          color: #666666;
          background-color: #f0f0f0;
        }
      }
    }

    .record-summary {
      font-size: 26rpx;
      color: #1a1a1a;
      line-height: 1.5;
      margin-bottom: 20rpx;
    }

    .record-actions {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;

      .action-btn {
        padding: 12rpx 24rpx;
        border-radius: 12rpx;
        border: 2rpx solid #e0e0e0;
        margin-right: 16rpx;
        margin-bottom: 8rpx;

        &-active {
          background-color: rgba(12, 20, 102, 0.04);
        }

        &--busy {
          opacity: 0.6;
        }

        .action-text {
          font-size: 24rpx;
          color: #666666;
        }
      }
    }
  }

  .empty-box {
    padding: 80rpx 0;
    display: flex;
    align-items: center;
    justify-content: center;

    .empty-text {
      font-size: 28rpx;
      color: #999999;
    }
  }

  .bottom-space {
    height: 40rpx;
  }
</style>
