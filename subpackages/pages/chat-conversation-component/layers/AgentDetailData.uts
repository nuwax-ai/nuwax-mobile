import { ref } from "vue";
import type {
  AgentManualComponentInfo,
  AgentSelectedComponentInfo,
  FileNode,
} from "@/types/interfaces/agent";
import { StringAnyRecord } from "@/types/interfaces/common";
import {
  MessageInfo,
  ConversationInfo,
  ProcessingInfo,
  OpenAppParams,
} from "@/types/interfaces/conversationInfo";
import { SandboxInfo } from "@/types/interfaces/sandbox";

/**
 * 数据层：负责状态管理和数据存储
 */
export default class AgentDetailData {
  // 基础信息
  agentId = ref<number | null>(null);
  agentName = ref<string>("");
  agentInfo = ref<UTSJSONObject | null>(null);
  conversationId = ref<number | null>(null);
  // 是否是临时会话
  isTempChat = ref<boolean>(false);
  // 首页页面URL
  pageHomeUrl = ref<string>("");
  // 首页页面弹窗
  popupPage = ref<any | null>(null);

  // 消息相关
  messageList = ref<MessageInfo[]>([]);
  /** App 流式打字机：独立字符串通道，避免 MessageInfoClass 与批量渲染导致 UI 滞后 */
  streamingAssistantText = ref<string>("");
  /** 当前流式正文所属助手消息 id，防止串到下一轮空气泡 */
  streamingAssistantMessageId = ref<string>("");
  /** 真实 SSE 出现大块/长间隔时，当前流式 renderer 启用显示层匀速揭示。 */
  streamDisplayPacing = ref<boolean>(false);
  /** 当前正文是否可能异步重排；纯文本为 false，可跳过公式/图片式延迟补滚。 */
  streamContentMayRelayout = ref<boolean>(true);
  // 引导问题建议
  chatSuggestList = ref<any[]>([]);
  requestId = ref<string>("");
  messageIdRef = ref<string>("");
  // 当前会话消息请求ID
  currentConversationRequestId = ref<string>("");
  // 停止操作是否正在进行中
  isStoppingConversation = ref<boolean>(false);

  // 会话状态
  conversationInfo = ref<any | null>(null);
  // 是否用户问题建议
  isSuggest = ref<boolean>(false);
  // 是否需要更新主题
  needUpdateTopicRef = ref<boolean>(true);
  // 是否正在加载会话
  isLoadingConversation = ref<boolean>(false);
  // 首次进入页面是否正在加载历史会话（显示全局 loading 图标）
  isPageLoading = ref<boolean>(false);
  // 会话是否正在进行中（有消息正在处理）
  isConversationActive = ref<boolean>(false);
  // 是否发送过消息,如果是,则禁用变量参数
  isSendMessageRef = ref<boolean>(false);
  // 是否禁用发送按钮
  wholeDisabled = ref<boolean>(false);

  // ==================== 临时会话相关 ====================
  // 链接Key
  chatKey = ref<string>("");
  // 验证码参数
  captchaVerifyParam = ref<string>("");
  // 会话唯一标识
  // 会话唯一标识
  conversationUid = ref<string>("");

  // ==================== 沙盒相关 ====================
  // 沙盒列表
  sandboxList = ref<SandboxInfo[]>([]);
  // 智能体选中的沙盒映射（Android 运行时为 UTSJSONObject）
  agentSelectedSandbox = ref<any>(new UTSJSONObject());
  // 当前选中的沙盒ID
  currentSandboxId = ref<string>("");
  // 是否允许切换沙盒 (当ID固定时为true)
  isSandboxSwitchDisabled = ref<boolean>(false);
  // 沙盒是否不可用 (当显示"电脑不可用"时为true)
  isSandboxUnavailable = ref<boolean>(false);
  // 沙盒不可用时的提示文案
  sandboxDisabledText = ref<string>("");

  // ==================== 模型选择相关 ====================
  // 当前选中的模型ID
  currentModelId = ref<number>(0);
  // 当前选中的模型名称
  currentModelName = ref<string>("");
  // 模型选择弹窗是否可见
  modelSelectVisible = ref<boolean>(false);

  // 组件和功能
  manualComponents = ref<AgentManualComponentInfo[]>([]);
  // 已选组件列表
  selectedComponents = ref<AgentSelectedComponentInfo[]>([]);
  // 变量参数（Android：接口数组元素常为 UTSJSONObject/Map，禁止 BindConfigWithSub[]）
  variables = ref<any[]>([]);
  // 用户填充变量
  userFillVariables = ref<StringAnyRecord>(new Map<string, any>() as any as StringAnyRecord);
  processingList = ref<ProcessingInfo[]>([]);
  // Android：StringAnyRecord = Map，禁止用 {} 再 as UTSJSONObject.keys
  messageRefs = ref<StringAnyRecord>(new Map<string, any>() as any as StringAnyRecord);

  // 滚动相关（z-paging-x 无 scroll-into-view，滚底/定位统一由 ScrollManager 走其 scrollToY/scrollToBottom）
  // 滚动相关
  scrollIntoView = ref<string>("");
  // list-view 回收兜底：scroll-into-view 在 type=95 的 last-msg 锚点被回收/detach 时会静默失效，
  // 回到底这类显式动作用数值 scroll-top 命令值兜底（act-on-change，clamp 到 scrollHeight 即到底，
  // 不锁位、不与用户手动滚动冲突）。命令值，仅写、绝不被 @scroll 回写。
  scrollToBottomAnchor = ref<number>(0);
  scrollInBottom = ref<boolean>(true);
  scrollWithAnimation = ref<boolean>(false);
  scrollTouch = ref<boolean>(false);
  scrolling = ref<boolean>(false);
  keyboardHeight = ref<number>(0);
  /** 当前 scrollTop（onScroll 写；虚拟滚动窗口计算 / prepend 补偿基线用） */
  scrollTop = ref<number>(0);

  // 弹窗引用
  refMorePopup = ref<any | null>(null);
  refSubscriptionModal = ref<any | null>(null);

  sseProcessor: any | null = null;
  autoToLastMsg = ref<boolean>(false);
  scrollingT = ref<number>(0);
  mouseScroll = ref<boolean>(false);
  needSetLockAutoToLastMsg = ref<boolean>(true);

  // ==================== 任务型智能体文件列表相关 ====================
  // 文件列表
  fileList = ref<FileNode[]>([]);
  // 是否正在加载文件列表
  isLoadingFiles = ref<boolean>(false);

  // ==================== 加载更多历史消息相关 ====================
  // 是否正在加载更多消息
  isLoadingMoreMessages = ref<boolean>(false);
  // 是否还有更多历史消息
  hasMoreMessages = ref<boolean>(false);

  // ==================== 开放应用参数, 来自用户自定义url地址传入的参数params ====================
  appParams = ref<OpenAppParams | null>(null);
  // 如果没有携带message参数，则将其他参数(files、attachments、selectedComponents、skillIds、modelId等)保存到urlOtherParams中，用于后续首次发送消息时使用
  urlOtherParams = ref<StringAnyRecord | null>(null);

  // ==================== 订阅和付费限制相关 ====================
  // 是否需要付费/订阅锁定
  subscriptionRequired = ref<boolean>(false);
  // 付费/订阅弹窗可见性
  subscriptionModalVisible = ref<boolean>(false);
  // 是否允许开启订阅限制（根据租户配置中的 enableSubscription 是否等于 1 来决定）
  enableSubscription = ref<number>(0);
  // 已使用试用次数
  localCalledTrialCount = ref<number>(0);
}
