<template>
  <view class="create-hub">
    <safety-zone />

    <view class="create-hub__nav">
      <view class="create-hub__back" hover-class="create-hub__back--pressed" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#111111" />
      </view>
    </view>

    <view class="create-hub__hero">
      <text class="create-hub__title">{{ t("Mobile.CreateHub.heroTitle") }}</text>
      <text class="create-hub__subtitle">{{ t("Mobile.CreateHub.heroSubtitle") }}</text>
      <view class="create-hub__modes">
        <view
          class="create-hub__mode"
          :class="{ 'create-hub__mode--on': currentMode == 'chat' }"
          @click="handleModeChange('chat')"
        >
          <text
            class="create-hub__mode-text"
            :class="{ 'create-hub__mode-text--on': currentMode == 'chat' }"
          >{{ t("Mobile.CreateHub.modeChat") }}</text>
        </view>
        <view
          class="create-hub__mode"
          :class="{ 'create-hub__mode--on': currentMode == 'project' }"
          @click="handleModeChange('project')"
        >
          <text
            class="create-hub__mode-text"
            :class="{ 'create-hub__mode-text--on': currentMode == 'project' }"
          >{{ t("Mobile.CreateHub.modeProject") }}</text>
        </view>
      </view>
    </view>

    <view class="create-hub__bottom">
      <scroll-view class="create-hub__chips" scroll-x direction="horizontal" :show-scrollbar="false">
        <view class="create-hub__chip-row">
          <view
            v-for="chip in actionChips"
            :key="chip.id"
            class="create-hub__chip"
            :class="{ 'create-hub__chip--on': selectedActionId == chip.id }"
            hover-class="create-hub__chip--pressed"
            @click="handleChipTap(chip.id)"
          >
            <svg-icon :name="chip.icon" size="32" :color="selectedActionId == chip.id ? '#111111' : '#555555'" />
            <text class="create-hub__chip-text">{{ chipLabel(chip.i18nKey) }}</text>
          </view>
        </view>
      </scroll-view>

      <view class="create-hub__input-wrap">
        <view
          class="create-hub__input"
          :class="{
            'create-hub__input--voice': isVoiceInput,
            'create-hub__input--recording': isRecording,
          }"
        >
          <view
            class="create-hub__icon-hit"
            hover-class="create-hub__icon-hit--pressed"
            @click.stop.prevent="handleToggleInputMethod"
          >
            <svg-icon
              :name="isVoiceInput ? 'icon-keyboard' : 'icon-voice'"
              size="44"
              color="#222222"
            />
          </view>

          <voice-recorder-button
            v-if="isVoiceInput"
            class="create-hub__recorder"
            :duration="600000"
            :is-conversation-active="false"
            :enable-asr="enableVoiceAsr"
            :native-bridge="false"
            @onRecordStop="handleVoiceStop"
            @onError="handleVoiceError"
            @onVisualActive="handleRecorderVisualActive"
          />
          <textarea
            v-else
            class="create-hub__textarea"
            placeholder-class="create-hub__placeholder"
            v-model="inputValue"
            :auto-height="true"
            adjust-position="false"
            :show-confirm-bar="false"
            :maxlength="-1"
            :disable-default-padding="true"
            :placeholder="t('Mobile.CreateHub.inputPlaceholder')"
            @keyboardheightchange="onKeyboardHeightChange"
            @confirm="handleSend"
          />

          <view
            v-if="!isRecording"
            class="create-hub__icon-hit"
            hover-class="create-hub__icon-hit--pressed"
            @click.stop.prevent="handleRightAction"
          >
            <svg-icon
              :name="showSendIcon ? 'icon-send' : 'icon-Plus'"
              size="44"
              :color="showSendIcon ? '#5147FF' : '#222222'"
            />
          </view>
        </view>
      </view>

      <view class="create-hub__extra" v-if="showExtra">
        <view class="create-hub__extra-item" @click="handleExtraAction('camera')">
          <view class="create-hub__extra-icon">
            <svg-icon name="icon-Camera" size="48" />
          </view>
          <text class="create-hub__extra-text">{{ t("Mobile.Chat.takePhoto") }}</text>
        </view>
        <view class="create-hub__extra-item" @click="handleExtraAction('album')">
          <view class="create-hub__extra-icon">
            <svg-icon name="icon-Image" size="48" />
          </view>
          <text class="create-hub__extra-text">{{ t("Mobile.Chat.album") }}</text>
        </view>
        <view class="create-hub__extra-item" @click="handleExtraAction('file')">
          <view class="create-hub__extra-icon">
            <svg-icon name="icon-Folder" size="48" />
          </view>
          <text class="create-hub__extra-text">{{ t("Mobile.Chat.file") }}</text>
        </view>
      </view>

      <view class="create-hub__disclaimer">
        <text class="create-hub__disclaimer-text">{{ t("Mobile.CreateHub.disclaimer") }}</text>
      </view>
      <view class="create-hub__keyboard" :style="{ height: keyboardHeight + 'px' }"></view>
    </view>

    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { onShow } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
  import { apiTenantConfig } from "@/servers/account";
  import { apiPublishedAgentInfo } from "@/servers/agentDev";
  import { apiAgentConversationCreate } from "@/servers/conversation";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { jumpNavigateBack } from "@/utils/common";
  import { jumpToAgentDetailPage, syncNativeTabBarState } from "@/utils/commonBusiness";
  import { goToLogin } from "@/utils/authNavigation";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import { emptyI18nParams, useI18n } from "@/utils/i18n";
  import { PendingChatDraft } from "@/types/interfaces/pendingChatDraft";
  import { savePendingChatDraft } from "@/utils/pendingChatDraft";
  import VoiceRecorderButton from "@/subpackages/components/chat-input-phone/voice-recorder-button/voice-recorder-button.uvue";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  type CreateHubMode = "chat" | "project";

  // UTS 对象字面量只能匹配 type 别名，不能 new interface
  type CreateHubChip = {
    id: string;
    icon: string;
    i18nKey: string;
  };

  const chipList: CreateHubChip[] = [];
  chipList.push({
    id: "document",
    icon: "icon-a-Filetext",
    i18nKey: "Mobile.CreateHub.actionDocument",
  } as CreateHubChip);
  chipList.push({
    id: "slides",
    icon: "icon-layout",
    i18nKey: "Mobile.CreateHub.actionSlides",
  } as CreateHubChip);
  chipList.push({
    id: "artifact",
    icon: "icon-Grid",
    i18nKey: "Mobile.CreateHub.actionArtifact",
  } as CreateHubChip);
  chipList.push({
    id: "more",
    icon: "icon-More",
    i18nKey: "Mobile.CreateHub.actionMore",
  } as CreateHubChip);
  const actionChips = ref<CreateHubChip[]>(chipList);

  const currentMode = ref<CreateHubMode>("chat");
  const selectedActionId = ref<string>("");
  const inputValue = ref<string>("");
  const isVoiceInput = ref<boolean>(false);
  const isRecording = ref<boolean>(false);
  const showExtra = ref<boolean>(false);
  const keyboardHeight = ref<number>(0);
  const sending = ref<boolean>(false);

  const defaultAgentId = ref<number>(0);
  const defaultAgentName = ref<string>("");
  const defaultAgentType = ref<string>("ChatBot");

  const { loginPopupRef, checkAuthAndShowPopup, hasToken } = useAuthInterceptor();

  // #ifdef APP
  const enableVoiceAsr = true;
  // #endif
  // #ifndef APP
  const enableVoiceAsr = false;
  // #endif

  const showSendIcon = computed((): boolean => {
    return inputValue.value.trim().length > 0;
  });

  function applyDefaultAgentConfig(raw: any | null): number {
    if (raw == null) {
      return 0;
    }
    const obj = raw as UTSJSONObject;
    const idRaw = obj["defaultAgentId"];
    const id = idRaw != null ? (idRaw as number) : 0;
    defaultAgentId.value = id;
    return id;
  }

  async function loadDefaultAgentEntry(): Promise<void> {
    try {
      let agentId = 0;
      const cachedRaw = uni.getStorageSync(TENANT_CONFIG_INFO);
      if (cachedRaw != null && `${cachedRaw}`.length > 0) {
        try {
          const cached = JSON.parse<UTSJSONObject>(`${cachedRaw}`);
          agentId = applyDefaultAgentConfig(cached);
        } catch (_e) {
          agentId = 0;
        }
      }

      const configRes = await apiTenantConfig();
      if (apiResCode(configRes) == SUCCESS_CODE) {
        const configData = apiResData<any>(configRes);
        if (configData != null) {
          uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(configData));
          agentId = applyDefaultAgentConfig(configData);
        }
      }

      if (agentId > 0) {
        const detailRes = await apiPublishedAgentInfo(agentId, false);
        if (apiResCode(detailRes) == SUCCESS_CODE) {
          const detailRaw = apiResData<any>(detailRes);
          if (detailRaw != null) {
            const detail = detailRaw as UTSJSONObject;
            const nameRaw = detail["name"];
            const typeRaw = detail["type"];
            defaultAgentName.value = nameRaw != null ? `${nameRaw}` : t("Mobile.Common.appName");
            defaultAgentType.value = typeRaw != null ? `${typeRaw}` : "ChatBot";
          }
        }
      }
    } catch (error) {
      console.error("加载创建页默认智能体失败", error);
    }
  }

  onShow(() => {
    loadDefaultAgentEntry();
  });

  function chipLabel(key: string): string {
    return t(key);
  }

  function handleBack(): void {
    // #ifdef APP-IOS
    syncNativeTabBarState();
    // #endif
    jumpNavigateBack();
  }

  function handleModeChange(mode: string): void {
    currentMode.value = mode == "project" ? "project" : "chat";
  }

  function handleChipTap(chipId: string): void {
    if (chipId == "more") {
      uni.showToast({
        title: t("Mobile.Common.comingSoon"),
        icon: "none",
      });
      return;
    }
    selectedActionId.value = selectedActionId.value == chipId ? "" : chipId;
  }

  function handleToggleInputMethod(): void {
    isVoiceInput.value = !isVoiceInput.value;
    showExtra.value = false;
    if (isVoiceInput.value == true) {
      keyboardHeight.value = 0;
    }
  }

  async function ensureLoggedIn(): Promise<boolean> {
    const loggedIn = await hasToken();
    if (loggedIn == true) {
      return true;
    }
    // #ifdef MP-WEIXIN
    await checkAuthAndShowPopup();
    return false;
    // #endif
    // #ifndef MP-WEIXIN
    goToLogin(true);
    return false;
    // #endif
  }

  function resolveAgentType(): "ChatBot" | "PageApp" | "TaskAgent" {
    const rawType = defaultAgentType.value;
    if (rawType == "PageApp") {
      return "PageApp";
    }
    if (rawType == "TaskAgent") {
      return "TaskAgent";
    }
    return "ChatBot";
  }

  function parseConversationId(raw: any | null): number {
    if (raw == null) {
      return 0;
    }
    const jsonStr = JSON.stringify(raw);
    if (jsonStr == null || jsonStr.length == 0) {
      return 0;
    }
    const parsed = JSON.parse(jsonStr) as UTSJSONObject | null;
    if (parsed == null) {
      return 0;
    }
    const idRaw = parsed["id"];
    if (idRaw == null) {
      return 0;
    }
    if (typeof idRaw == "number") {
      return idRaw as number;
    }
    const parsedId = parseInt(`${idRaw}`, 10);
    return parsedId != parsedId ? 0 : parsedId;
  }

  async function handleSend(): Promise<void> {
    const message = inputValue.value.trim();
    if (message.length == 0 || sending.value == true) {
      return;
    }
    const loggedIn = await ensureLoggedIn();
    if (loggedIn != true) {
      return;
    }
    const agentId = defaultAgentId.value;
    if (agentId <= 0) {
      uni.showToast({
        title: t("Mobile.CreateHub.noDefaultAgent"),
        icon: "none",
      });
      return;
    }

    sending.value = true;
    uni.showLoading({ title: t("Mobile.Page.loading"), mask: true });
    try {
      const conversationParams: UTSJSONObject = {
        agentId: agentId,
        devMode: false,
      };
      const res = await apiAgentConversationCreate(conversationParams);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({
          title: apiResMessage(res).length > 0 ? apiResMessage(res) : t("Mobile.CreateHub.sendFailed"),
          icon: "none",
        });
        return;
      }
      const convId = parseConversationId(apiResData<any>(res));
      if (convId <= 0) {
        uni.showToast({
          title: t("Mobile.CreateHub.sendFailed"),
          icon: "none",
        });
        return;
      }
      const draft = new PendingChatDraft();
      draft.createdAt = Date.now();
      draft.agentId = agentId;
      draft.conversationId = convId;
      draft.message = message;
      savePendingChatDraft(draft);
      inputValue.value = "";
      showExtra.value = false;
      await jumpToAgentDetailPage(agentId, convId, resolveAgentType(), defaultAgentName.value);
    } catch (error) {
      console.error("创建会话失败", error);
      uni.showToast({
        title: t("Mobile.CreateHub.sendFailed"),
        icon: "none",
      });
    } finally {
      sending.value = false;
      uni.hideLoading();
    }
  }

  function handleRightAction(): void {
    if (showSendIcon.value == true) {
      handleSend();
      return;
    }
    showExtra.value = !showExtra.value;
  }

  function onKeyboardHeightChange(res: UniInputKeyboardHeightChangeEvent): void {
    const height = res.detail.height;
    keyboardHeight.value = height > 0 ? height : 0;
    if (height > 0) {
      showExtra.value = false;
    }
  }

  function handleRecorderVisualActive(active: boolean): void {
    isRecording.value = active;
  }

  function handleVoiceStop(transcriptText: string): void {
    if (typeof transcriptText == "string" && transcriptText.length > 0) {
      inputValue.value = transcriptText;
      handleSend();
    }
  }

  function handleVoiceError(error: any | null): void {
    const fallback = t("Mobile.AgentDetail.recognizeFailed");
    let message = fallback;
    if (error != null) {
      try {
        const err = error as Error;
        if (err.message != null && `${err.message}`.length > 0) {
          message = `${err.message}`;
        }
      } catch (_e) {
        // ignore
      }
    }
    uni.showToast({ title: message, icon: "none" });
  }

  async function openDefaultAgent(conversationId: number | null): Promise<void> {
    const agentId = defaultAgentId.value;
    if (agentId <= 0) {
      uni.showToast({
        title: t("Mobile.CreateHub.noDefaultAgent"),
        icon: "none",
      });
      return;
    }
    await jumpToAgentDetailPage(agentId, conversationId, resolveAgentType(), defaultAgentName.value);
  }

  async function handleExtraAction(kind: string): Promise<void> {
    if (kind.length == 0) {
      return;
    }
    showExtra.value = false;
    const loggedIn = await ensureLoggedIn();
    if (loggedIn != true) {
      return;
    }
    await openDefaultAgent(null);
  }
</script>

<style lang="scss" scoped>
  .create-hub {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #ffffff;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  .create-hub__nav {
    padding: 12rpx 32rpx 0;
  }

  .create-hub__back {
    width: 72rpx;
    height: 72rpx;
    border-radius: 50%;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  }

  .create-hub__back--pressed {
    opacity: 0.7;
  }

  .create-hub__hero {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 48rpx 40rpx;
  }

  .create-hub__title {
    font-size: 52rpx;
    font-weight: 700;
    line-height: 72rpx;
    color: #111111;
    text-align: center;
  }

  .create-hub__subtitle {
    margin-top: 16rpx;
    font-size: 28rpx;
    line-height: 40rpx;
    color: #8a8a8a;
    text-align: center;
  }

  .create-hub__modes {
    margin-top: 48rpx;
    width: 480rpx;
    max-width: 100%;
    padding: 8rpx;
    border-radius: 999rpx;
    background-color: #f3f3f3;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .create-hub__mode {
    flex: 1;
    height: 72rpx;
    border-radius: 999rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .create-hub__mode--on {
    background-color: #ffffff;
    box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  }

  .create-hub__mode-text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #8a8a8a;
  }

  .create-hub__mode-text--on {
    color: #111111;
    font-weight: 600;
  }

  .create-hub__bottom {
    padding: 0 32rpx;
    padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  }

  .create-hub__chips {
    width: 100%;
    height: 76rpx;
    margin-bottom: 20rpx;
  }

  .create-hub__chip-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-bottom: 4rpx;
  }

  .create-hub__chip {
    flex-shrink: 0;
    margin-right: 16rpx;
    padding: 14rpx 22rpx;
    border-radius: 24rpx;
    background-color: #f3f3f3;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .create-hub__chip:last-child {
    margin-right: 0;
  }

  .create-hub__chip--on {
    background-color: #ffffff;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  }

  .create-hub__chip--pressed {
    opacity: 0.75;
  }

  .create-hub__chip-text {
    margin-left: 8rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #333333;
    white-space: nowrap;
  }

  .create-hub__input-wrap {
    width: 100%;
  }

  .create-hub__input {
    min-height: 96rpx;
    border-radius: 48rpx;
    background-color: #f3f3f3;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 8rpx 8rpx 8rpx 12rpx;
  }

  .create-hub__input--recording {
    background-color: transparent;
    padding: 0;
  }

  .create-hub__icon-hit {
    width: 72rpx;
    height: 72rpx;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .create-hub__icon-hit--pressed {
    opacity: 0.65;
  }

  .create-hub__textarea {
    flex: 1;
    min-width: 0;
    min-height: 44rpx;
    max-height: 264rpx;
    line-height: 44rpx;
    font-size: 30rpx;
    color: #111111;
    padding: 12rpx 8rpx;
    /* #ifndef APP */
    outline: none;
    resize: none;
    /* #endif */
  }

  .create-hub__placeholder {
    color: rgba(0, 0, 0, 0.28);
    font-size: 28rpx;
  }

  .create-hub__recorder {
    flex: 1;
    min-width: 0;
  }

  .create-hub__extra {
    margin-top: 24rpx;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
  }

  .create-hub__extra-item {
    width: 160rpx;
    margin-right: 24rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .create-hub__extra-icon {
    width: 112rpx;
    height: 112rpx;
    border-radius: 16rpx;
    background-color: #f5f5f5;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .create-hub__extra-text {
    margin-top: 12rpx;
    font-size: 26rpx;
    line-height: 36rpx;
    color: #15171f;
  }

  .create-hub__disclaimer {
    padding-top: 16rpx;
    padding-bottom: 8rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .create-hub__disclaimer-text {
    font-size: 20rpx;
    line-height: 28rpx;
    color: #b0b0b0;
  }

  .create-hub__keyboard {
    width: 100%;
  }
</style>

<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  /* #endif */
</style>
