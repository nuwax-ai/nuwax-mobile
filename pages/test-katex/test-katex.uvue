<template>
  <view class="tk-page">
    <!-- 隐藏 web-view：H5 公式 v-html 由它算 resultHtml 回传 -->
    <web-view
      class="markdown-proxy-web"
      id="markdown-proxy-web"
      src="/uni_modules/uni-ai-x/static/proxy-web/proxy-web.html"
      @message="onProxyMsg"
    ></web-view>

    <view class="tk-header">
      <text class="tk-title">KaTeX 块级公式换行测试（H5）</text>
      <text class="tk-sub">proxy 状态: {{ proxyReady ? "就绪" : "未就绪" }}</text>
    </view>

    <scroll-view class="tk-scroll" direction="vertical">
      <!-- 1. 短块级公式（不应换行） -->
      <view class="tk-case">
        <text class="tk-case-title">1. 短块级公式 $$E=mc^2$$</text>
        <katex-el :html="html1" :href="''" :width="0" :height="0" />
      </view>

      <!-- 2. 长块级公式（超宽应横滚不换行） -->
      <view class="tk-case">
        <text class="tk-case-title">2. 长块级公式（应横滚不换行）</text>
        <katex-el :html="html2" :href="''" :width="0" :height="0" />
      </view>

      <!-- 3. 含中文的块级公式（截图同款） -->
      <view class="tk-case">
        <text class="tk-case-title">3. 含中文块级公式（T_resize 同款）</text>
        <katex-el :html="html3" :href="''" :width="0" :height="0" />
      </view>

      <!-- 4. 行内公式混排 -->
      <view class="tk-case">
        <text class="tk-case-title">4. 行内公式混排（与文字同行）</text>
        <view class="tk-inline-row">
          <text class="tk-inline-text">设容量初始为 </text>
          <katex-el :html="html4" :href="''" :width="0" :height="0" :inline="true" />
          <text class="tk-inline-text"> ，倍增因子为 2，则 </text>
          <katex-el :html="html5" :href="''" :width="0" :height="0" :inline="true" />
          <text class="tk-inline-text"> 次插入。</text>
        </view>
      </view>

      <!-- 5. 多行公式（\\ 换行，验证 nowrap 不破坏内部换行） -->
      <view class="tk-case">
        <text class="tk-case-title">5. 多行公式（\\ 换行，应保持两行）</text>
        <katex-el :html="html6" :href="''" :width="0" :height="0" />
      </view>

      <!-- 6. 分数+上下标混合（验证内部结构不错位） -->
      <view class="tk-case">
        <text class="tk-case-title">6. 分数+上下标（内部结构应正常）</text>
        <katex-el :html="html7" :href="''" :width="0" :height="0" />
      </view>

      <!-- 7. x-math 自包含（块级，直接传 latex，不经 Markdown 管线） -->
      <view class="tk-case">
        <text class="tk-case-title">7. &lt;x-math&gt; 自包含块级（MathRendererCore → proxyWebBackend）</text>
        <x-math :latex="xmBlock" :display-mode="true" />
      </view>

      <!-- 8. x-math 自包含（行内混排，与文字同行） -->
      <view class="tk-case">
        <text class="tk-case-title">8. &lt;x-math&gt; 行内混排</text>
        <view class="tk-inline-row">
          <text class="tk-inline-text">能量方程 </text>
          <x-math :latex="xmInline" :inline="true" />
          <text class="tk-inline-text"> 描述质能等价。</text>
        </view>
      </view>

      <!-- 9. x-math 自包含（aligned 多行，验证 nowrap 不破坏内部换行） -->
      <view class="tk-case">
        <text class="tk-case-title">9. &lt;x-math&gt; aligned 多行</text>
        <x-math :latex="xmAligned" :display-mode="true" />
      </view>

      <!-- ==================== 原生渲染（Android AndroidMath / MTMathView）==================== -->
      <!-- #ifdef APP-ANDROID -->
      <view class="tk-case tk-native-banner">
        <text class="tk-case-title">▼ 原生渲染（MTMathView：真原生 Canvas + FreeType 矢量，可选 / 可复制 / 清晰，不过 proxy web-view）</text>
      </view>

      <!-- N1. 分数 + 根号（求根公式） -->
      <view class="tk-case">
        <text class="tk-case-title">N1. 分数 + 根号（求根公式）</text>
        <x-native-math :latex="natFrac" :display-mode="true" :font-size="22" />
      </view>

      <!-- N2. n 次根号 -->
      <view class="tk-case">
        <text class="tk-case-title">N2. n 次根号</text>
        <x-native-math :latex="natSqrt" :display-mode="true" :font-size="22" />
      </view>

      <!-- N3. 定积分（高斯积分） -->
      <view class="tk-case">
        <text class="tk-case-title">N3. 积分（高斯积分）</text>
        <x-native-math :latex="natIntegral" :display-mode="true" :font-size="22" />
      </view>

      <!-- N4. 矩阵 + 行列式 -->
      <view class="tk-case">
        <text class="tk-case-title">N4. 矩阵 + 行列式</text>
        <x-native-math :latex="natMatrix" :display-mode="true" :font-size="22" />
      </view>

      <!-- N5. 方程组（cases） -->
      <view class="tk-case">
        <text class="tk-case-title">N5. 方程组（cases）</text>
        <x-native-math :latex="natCases" :display-mode="true" :font-size="22" />
      </view>

      <!-- N6. 定界符（\left \right 自适应高度） -->
      <view class="tk-case">
        <text class="tk-case-title">N6. 定界符（\left \right 自适应）</text>
        <x-native-math :latex="natDelim" :display-mode="true" :font-size="22" />
      </view>

      <!-- N7. 希腊字母 -->
      <view class="tk-case">
        <text class="tk-case-title">N7. 希腊字母</text>
        <x-native-math :latex="natGreek" :display-mode="true" :font-size="22" />
      </view>

      <!-- N8. 行内混排 -->
      <view class="tk-case">
        <text class="tk-case-title">N8. 原生行内混排</text>
        <view class="tk-inline-row">
          <text class="tk-inline-text">能量 </text>
          <x-native-math :latex="'E=mc^2'" :display-mode="false" :font-size="18" />
          <text class="tk-inline-text"> 描述质能等价。</text>
        </view>
      </view>
      <!-- #endif -->
    </scroll-view>
  </view>
</template>

<script lang="uts" setup>
import { onMounted, ref } from "vue";
import proxyWeb from "@/uni_modules/uni-ai-x/sdk/proxy-web.uts";

const proxyReady = ref(false);
const html1 = ref("");
const html2 = ref("");
const html3 = ref("");
const html4 = ref("");
const html5 = ref("");
const html6 = ref("");
const html7 = ref("");

// x-math 自包含用例：直接传 LaTeX（不含 $ 定界符），由 <x-math> 内部走 MathRendererCore 渲染。
// 脚本字符串字面量里 \\ → 一个反斜杠；LaTeX 的 \\（换行）需写四个 \\\\。
const xmBlock = "\\frac{-b \\pm \\sqrt{b^2-4ac}}{2a}";
const xmInline = "E=mc^2";
const xmAligned = "\\begin{aligned} a &= b+c \\\\ d &= e+f \\end{aligned}";

// 原生渲染（AndroidMath / MTMathView）LaTeX 用例：覆盖用户要求的 7 类
// 分数 / 根号 / 积分 / 矩阵 / 方程组 / 定界符 / 希腊字母
const natFrac = "\\frac{-b \\pm \\sqrt{b^2-4ac}}{2a}";
const natSqrt = "\\sqrt[3]{x^2+1} + \\sqrt{2} + \\frac{\\sqrt{5}}{2}";
const natIntegral = "\\int_0^{\\infty} e^{-x^2}\\,dx = \\frac{\\sqrt{\\pi}}{2}";
const natMatrix =
  "A = \\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix}, \\quad |M| = \\begin{vmatrix} 1 & 2 \\\\ 3 & 4 \\end{vmatrix}";
const natCases = "\\begin{cases} x + y = 1 \\\\ x - y = 3 \\end{cases}";
const natDelim = "f(x) = \\left( \\frac{a}{b} \\right)^2 + \\left[ \\frac{1}{2} + \\frac{1}{3} \\right]";
const natGreek = "\\alpha + \\beta = \\gamma, \\quad \\Delta = \\Theta - \\Phi, \\quad \\sum_{i=1}^{n} \\lambda_i";

function onProxyMsg(e: UniWebViewMessageEvent) {
  proxyWeb.onWebMsg(e);
}

/** 调 proxy 渲染一条公式，回写 resultHtml（H5 v-html 路径） */
function renderMath(latex: string, displayMode: boolean, target: Ref<string>) {
  const param = new UTSJSONObject();
  param["action"] = "katexRender";
  param["pureMathText"] = latex;
  param["displayMode"] = displayMode;
  proxyWeb.callMethod(param, (res: UTSJSONObject): void => {
    const html = res["resultHtml"];
    if (html != null && `${html}`.length > 0) {
      target.value = `${html}`;
    }
  });
}

function renderAll() {
  renderMath("E=mc^2", true, html1);
  renderMath(
    "f(x)=a_0+a_1x+a_2x^2+a_3x^3+a_4x^4+a_5x^5+a_6x^6+a_7x^7+a_8x^8+a_9x^9",
    true,
    html2,
  );
  renderMath(
    "T_{\\text{resize}}(n) = m + 2m + 4m + \\cdots + 2^{\\lfloor \\log_2(n/m) \\rfloor} m = O(n)",
    true,
    html3,
  );
  renderMath("m", false, html4);
  renderMath("n", false, html5);
  // 多行公式（\\ 换行）：验证 nowrap 不破坏内部换行
  renderMath(
    "\\begin{aligned} T_{\\text{resize}}(n) &= m + 2m + 4m + \\dots \\\\ &= 2^{\\lfloor \\log_2(n/m) \\rfloor} m = O(n) \\end{aligned}",
    true,
    html6,
  );
  // 分数+上下标：验证内部结构不错位
  renderMath(
    "\\frac{-b \\pm \\sqrt{b^2-4ac}}{2a} + \\sum_{i=1}^{n} x_i^2",
    true,
    html7,
  );
}

onMounted(() => {
  // #ifdef WEB
  const el = document.getElementById("markdown-proxy-web");
  proxyWeb.init(el as any, "markdown-proxy-web");
  // #endif
  // #ifndef WEB
  proxyWeb.ensureAppContext("markdown-proxy-web");
  // #endif
  proxyWeb.whenReady((): void => {
    proxyReady.value = true;
    renderAll();
  });
});
</script>

<style lang="scss">
.tk-page {
  width: 100%;
  height: 100vh;
  background-color: #f5f5f5;
  flex-direction: column;
}
.markdown-proxy-web {
  width: 0;
  height: 0;
  position: absolute;
  left: -9999px;
  top: -9999px;
}
.tk-header {
  padding: 24rpx;
  background-color: #fff;
  border-bottom: 1px solid #eee;
}
.tk-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}
.tk-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.tk-scroll {
  flex: 1;
}
.tk-case {
  background-color: #fff;
  margin: 16rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 1px solid #eee;
}
.tk-case-title {
  font-size: 26rpx;
  color: #0066cc;
  margin-bottom: 16rpx;
  display: block;
}
.tk-inline-row {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}
.tk-inline-text {
  font-size: 32rpx;
  color: #404040;
}
</style>
