<template>
  <view v-if="hasDisplayText" class="plain-stream-text-stack" :style="textStyle">
    <text
      v-for="(chunk, index) in frozenChunks"
      :key="`frozen-${index}`"
      class="plain-stream-frozen-text"
    >{{ chunk }}</text>
    <text
      v-if="liveChunk.length > 0"
      ref="liveTextRef"
      class="plain-stream-live-text"
    >{{ liveChunk }}</text>
  </view>
</template>

<script lang="uts" setup>
  import {
    nextPlainStreamRevealEnd,
    PLAIN_STREAM_TICK_MS,
    safePlainStreamRevealEnd,
  } from "@/subpackages/components/ai-msg/plainStreamDisplay.uts";

  const props = withDefaults(
    defineProps<{
      initialText?: string;
      pacing?: boolean;
      textStyle?: string;
    }>(),
    {
      initialText: "",
      pacing: false,
      textStyle: "",
    },
  );

  const emit = defineEmits<{
    caughtUp: [];
    displayProgress: [];
  }>();

  const frozenChunks = ref<string[]>([] as string[]);
  const liveChunk = ref<string>("");
  const liveTextRef = ref<UniTextElement | null>(null);
  const hasDisplayText = computed((): boolean => {
    return frozenChunks.value.length > 0 || liveChunk.value.length > 0;
  });
  let displayText: string = "";
  let targetText: string = "";
  let frozenTextLength: number = 0;
  let timer: number = 0;
  let progressTimer: number = 0;
  let progressPending: boolean = false;
  const DISPLAY_PROGRESS_MS: number = 240;
  /** live 尾部达到该长度后，在自然换行处冻结，避免累计 text 每次刷新全文重排。 */
  const FREEZE_TARGET_CHARS: number = 512;
  /** 最多向后寻找这么多字符的自然边界；超出则按 Unicode 安全边界硬切。 */
  const FREEZE_BOUNDARY_LOOKAHEAD: number = 128;

  function nextFreezeCut(text: string, preferredEnd: number): number {
    const maxEnd = Math.min(
      text.length,
      preferredEnd + FREEZE_BOUNDARY_LOOKAHEAD,
    );
    let cut = text.indexOf("\n", preferredEnd);
    if (cut >= 0 && cut < maxEnd) {
      return cut + 1;
    }
    // 真实模型常输出上千字单段；只等换行会让 live <text> 无限增长，
    // Android 每个 patch 都重新排版整个累计节点。优先找后续空格，保持单词完整。
    cut = text.indexOf(" ", preferredEnd);
    if (cut >= 0 && cut < maxEnd) {
      return cut + 1;
    }
    // 无自然边界时也必须封顶，并避免切开 UTF-16 代理对。
    return safePlainStreamRevealEnd(text, preferredEnd);
  }

  function clearTimer(): void {
    if (timer != 0) {
      clearTimeout(timer);
      timer = 0;
    }
  }

  /**
   * 可见正文增长只需按跟底窗口报告，不应跟文本 paint 同频触发 scroll-view。
   * 否则一次字符 patch 紧跟一次 scroll-into-view，会把 Android DOM 批处理拖成
   * 160～250ms 的反馈环，反而表现为整块上屏。这里使用 leading + trailing，
   * 连续输出最多每 240ms 通知一次，约等于正文新增一行的节奏；结束尾帧也不会丢。
   */
  function emitDisplayProgress(): void {
    if (progressTimer != 0) {
      progressPending = true;
      return;
    }
    emit("displayProgress");
    progressPending = false;
    progressTimer = setTimeout((): void => {
      progressTimer = 0;
      if (progressPending == true) {
        emitDisplayProgress();
      }
    }, DISPLAY_PROGRESS_MS) as number;
  }

  function clearProgressTimer(): void {
    if (progressTimer != 0) {
      clearTimeout(progressTimer);
      progressTimer = 0;
    }
    progressPending = false;
  }

  function paint(text: string): void {
    if (text.indexOf(displayText) != 0 || text.length < frozenTextLength) {
      frozenChunks.value = [] as string[];
      frozenTextLength = 0;
    }
    displayText = text;
    let remaining = text.length - frozenTextLength;
    let frozeChunk = false;
    while (remaining >= FREEZE_TARGET_CHARS) {
      const preferredEnd = frozenTextLength + FREEZE_TARGET_CHARS;
      const cut = nextFreezeCut(text, preferredEnd);
      if (cut <= frozenTextLength || cut > text.length) break;
      const next = frozenChunks.value.slice();
      next.push(text.substring(frozenTextLength, cut));
      frozenChunks.value = next;
      frozenTextLength = cut;
      frozeChunk = true;
      remaining = text.length - frozenTextLength;
    }
    const nextLive = text.substring(frozenTextLength);
    const liveEl = liveTextRef.value;
    if (liveEl != null && frozeChunk != true) {
      // 高频热路径直写原生 text，避免 liveChunk.value 每次触发 Vue 子树 diff。
      liveEl.value = nextLive;
    } else {
      // 首次挂载 / 冻结边界仍提交一次响应式状态，同步新 frozen 块。
      liveChunk.value = nextLive;
    }
    emitDisplayProgress();
    if (displayText == targetText) {
      emit("caughtUp");
    }
  }

  function scheduleTick(): void {
    if (timer != 0) return;
    timer = setTimeout((): void => {
      timer = 0;
      if (targetText.indexOf(displayText) != 0) {
        paint(targetText);
        return;
      }
      const end = nextPlainStreamRevealEnd(displayText.length, targetText);
      paint(targetText.substring(0, end));
      if (end < targetText.length) scheduleTick();
    }, PLAIN_STREAM_TICK_MS) as number;
  }

  function updateText(text: string, pacing: boolean): void {
    const previousTargetLength = targetText.length;
    const wasBehindPreviousTarget = displayText.length < previousTargetLength;
    const visibleBatchChars = text.length - previousTargetLength;
    targetText = text;
    // 原始 SSE 可能是密集小块，但经过 UI 合并后形成一次几十字的可见突发。
    // 在叶子层按实际目标增量兜底，避免只看 raw chunk 的 p95/maxChunk 时误判为无需匀速。
    const shouldPace =
      pacing == true ||
      visibleBatchChars > 16 ||
      wasBehindPreviousTarget == true;
    if (shouldPace != true) {
      clearTimer();
      paint(text);
      return;
    }
    scheduleTick();
  }

  function isCaughtUp(): boolean {
    return displayText == targetText;
  }

  watch(
    (): string => props.initialText,
    (text: string) => updateText(text, props.pacing),
    { immediate: true },
  );

  onUnmounted(() => {
    clearTimer();
    clearProgressTimer();
  });

  defineExpose({ updateText, isCaughtUp });
</script>

<style lang="scss">
  .plain-stream-live-text {
    width: 100%;
    color: #404040;
    font-size: 32rpx;
    line-height: 48rpx;
    white-space: pre-wrap;
  }

  .plain-stream-text-stack {
    width: 100%;
    flex-direction: column;
  }

  .plain-stream-frozen-text {
    width: 100%;
    color: #404040;
    font-size: 32rpx;
    line-height: 48rpx;
    white-space: pre-wrap;
  }
</style>
