<template>
  <!--
    长按行操作浮层（组件化 Stage 2 从 message-content 抽出，模板/样式原样迁移）：
    - 双模式：dark（自定义 tabbar 平台）= 飞书式压暗蒙层条「挖洞」+ 行旁白色气泡；
      MP（原生 tabBar 盖不住）= 无蒙层同款气泡。显隐/定位/操作项全部由页面状态经
      props 下发（单一事实源在 message-content），组件零自有状态
    - 蒙层条触摸 = 按下 + 完整抬起即收层（@touchend/.stop → mask-close 上抛，
      页面 closeRowMenu）；touchstart 仅 .stop 断冒泡（不依赖页面根处理器）
    - 气泡根 @touchstart/touchend/touchcancel 三阶段全断冒泡（气泡内不算点外——
      add-menu-drawer 同款，漏断 touchend 会让页面吞击守卫拿旧起点误判滑动、白吞
      item click），同手势补发的 click 全吞（空操作）防误进会话/误触入口
    - 几何：宽 120px 固定、项高 44px×N、垂直内边距 4px×2——与页面测量拼装常量
      严格对齐（改样式必须同步改测量）
  -->
  <view
    v-if="visible && dark"
    class="row-menu-mask row-menu-mask--top"
    :style="maskTopStyle"
    @touchstart.stop="swallowRowMenuTouch"
    @touchend.stop="emitMaskClose"
    @touchcancel.stop="emitMaskClose"
  />
  <view
    v-if="visible && dark"
    class="row-menu-mask row-menu-mask--bottom"
    :style="maskBottomStyle"
    @touchstart.stop="swallowRowMenuTouch"
    @touchend.stop="emitMaskClose"
    @touchcancel.stop="emitMaskClose"
  />
  <!-- 操作气泡：白底纵向列表，操作项按行类型由页面生成（acts：图标+文案） -->
  <view
    v-if="visible"
    class="row-menu-pop"
    :style="popStyle"
    @touchstart.stop="swallowRowMenuTouch"
    @touchend.stop="swallowRowMenuTouch"
    @touchcancel.stop="swallowRowMenuTouch"
    @click.stop="handleRowMenuPopTap"
  >
    <view
      v-for="(act, index) in acts"
      :key="index"
      class="row-menu-act"
      hover-class="row-menu-act--active"
      @click="emitActTap(index)"
    >
      <view class="row-menu-act__icon">
        <svg-icon :name="act.icon" size="16" unit="px" color="#5a5966" />
      </view>
      <text class="row-menu-act__text">{{ act.label }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import type { ImRowMenuAct } from "./im-row-models.uts";

  // 事件名须 kebab-case：App-Android 模板监听会把 camelCase 转小写导致收不到（add-menu-drawer 同规约）
  const emit = defineEmits<{
    /** 蒙层条完整抬手/取消 = 请求收层（页面 closeRowMenu）。 */
    "mask-close": [];
    /** 操作项点击（页面按 index 分发 handleRowMenuAct）。 */
    "act-tap": [index: number];
  }>();

  withDefaults(
    defineProps<{
      /** 浮层是否展开（页面 rowMenuVisible 直发）。 */
      visible: boolean;
      /** 压暗蒙层开关（页面 rowMenuDark 常量直发：自定义 tabbar 平台开）。 */
      dark: boolean;
      /** 气泡操作项（页面按行类型生成：文案+图标）。 */
      acts: ImRowMenuAct[];
      /** 气泡定位（视口坐标系 px 样式串，页面测行矩形后拼装）。 */
      popStyle: string;
      /** 压暗蒙层条样式（上/下条，页面拼装；仅 dark 平台有值）。 */
      maskTopStyle: string;
      maskBottomStyle: string;
    }>(),
    {
      visible: false,
      dark: false,
      acts: [] as ImRowMenuAct[],
      popStyle: "",
      maskTopStyle: "",
      maskBottomStyle: "",
    },
  );

  /** 断冒泡空操作（.stop 修饰符本身断冒泡，处理器为空实现占位）。 */
  function swallowRowMenuTouch(): void {}

  /** 气泡根节点吞点击：点在气泡空白区不落穿到下方行/入口。 */
  function handleRowMenuPopTap(): void {}

  function emitMaskClose(): void {
    emit("mask-close");
  }

  function emitActTap(index: number): void {
    emit("act-tap", index);
  }
</script>

<style lang="scss" scoped>
  /* 气泡与蒙层条同为 fixed 层：App 原生 fixed 浮于普通流之上，absolute 气泡会被
     蒙层条压住（z-index 跨定位模式不作数）；同层后 991 > 990 恒在蒙层之上。
     定位用视口坐标（页面测量换算直传 popStyle） */
  .row-menu-pop {
    position: fixed;
    z-index: 991;
    width: 120px;
    display: flex;
    flex-direction: column;
    padding: 4px 0;
    background-color: #ffffff;
    border-radius: 10px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.16);
  }

  .row-menu-act {
    height: 44px;
    padding: 0 14px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  /* 操作项按压：白底上深一档灰保持可见 */
  .row-menu-act--active {
    background-color: #e7e5ef;
  }

  /* ===== 飞书式压暗蒙层条（挖洞：洞=长按行矩形全宽）===== 条 z-index 990 低于气泡 991；
     高度由 maskTopStyle/BottomStyle 内联（上条锚 top:0、下条锚 bottom:0），
     仅 dark 平台渲染。 */
  .row-menu-mask {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 990;
    background-color: rgba(0, 0, 0, 0.45);
  }

  .row-menu-mask--top {
    top: 0;
  }

  .row-menu-mask--bottom {
    bottom: 0;
  }

  /* 图标统一盒（同尺寸不同形）：svg-icon 字形 16px 居中其中 */
  .row-menu-act__icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .row-menu-act__text {
    font-size: 14px;
    line-height: 20px;
    color: #1c1b20;
    /* 项宽恒定，文案正常不截断；此配方仅作长文案（i18n）兜底：
       App 端 lines 须与 overflow/text-overflow 同元素配合才截断（global.scss 同配方），
       H5 端靠 white-space 收敛 */
    /* #ifndef H5 */
    lines: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    /* #endif */
    /* #ifdef H5 */
    white-space: nowrap;
    overflow: hidden;
    /* #endif */
  }
</style>
