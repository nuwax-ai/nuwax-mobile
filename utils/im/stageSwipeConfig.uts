/**
 * Stage（伙伴页下拉会话）「上滑收起」手势的共享常量与原生适配。
 *
 * 为什么放在模块里、而不是 chat-view 的 setup 顶层：chat-view 的渲染 lambda 已经顶到
 * Android 的 255 参数硬限（越界即 `VerifyError: invalid arg count`，整页加载失败），
 * setup 顶层每多一个绑定都可能踩线。这里的符号只给 script 用、模板不引用，走 import
 * 不占渲染参数。
 */

/** 无跟手过程时（原生列表吞掉 mid-move）按 touchend 最终位移判定的收起线（px）。
 *  与 tab-shell 的 CLOSE_TRIGGER_PX 同值。 */
export const STAGE_NATIVE_CLOSE_PX = 110;

/** 横向占优判据：|dx| > |dy| * 该值 才认为是在横滑、作废上滑收起手势。
 *  原值 0.82 太敏感——手指自然斜着上滑（真机实测 dx=7/dy=-7、dx=51/dy=-62）就被判成
 *  横滑，已经跟手的卡片被 reset 回弹，按住上滑时表现为持续抖动。 */
export const STAGE_SWIPE_HORIZONTAL_RATIO = 1.2;

/** 单帧位移上限（px）：超过即视为坐标系跳变样本并丢弃（实测跳变幅度 145~198px）。
 *  正常手指单帧（16~33ms）要超过 100px 需要 3000px/s 以上。 */
export const STAGE_SWIPE_COORD_JUMP_PX = 100;

/**
 * 关掉滚动容器的原生 overscroll（仅 Android）。
 *
 * overscroll 拉伸期间，原生滚动容器会把 touch 坐标换算成「内容坐标」（= 屏幕坐标 − 拉伸量），
 * 与屏幕坐标交替上报；上滑收起手势按 clientY 算出的距离于是两个值来回跳（真机实测 198 与 0
 * 交替），父层卡片表现为持续抖动。关掉拉伸后不再产生第二套坐标。
 * 代价：该列表滑到边界不再有拉伸/辉光反馈（聊天列表本来就不显示滚动条）。
 */
export function disableAndroidOverScroll(elementId: string): void {
  // #ifdef APP-ANDROID
  const el = uni.getElementById(elementId);
  if (el == null) return;
  const view = el.getAndroidView();
  if (view == null) return;
  // 2 = View.OVER_SCROLL_NEVER
  view.setOverScrollMode(2);
  // #endif
}
