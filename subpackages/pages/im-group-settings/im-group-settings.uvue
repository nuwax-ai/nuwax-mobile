<template>
  <view class="gs-page">
    <safety-zone />

    <!-- 顶部：返回 + 群管理 -->
    <view class="gs-header">
      <view class="gs-header__btn" hover-class="gs-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="gs-header__title-wrap">
        <text class="gs-header__title">{{ t("Mobile.Message.groupManage") }}</text>
      </view>
      <view class="gs-header__btn gs-header__btn--ghost" />
    </view>

    <scroll-view class="gs-body" direction="vertical" :show-scrollbar="false">
      <view v-if="loading" class="gs-state">
        <text class="gs-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view v-else-if="loadFailed" class="gs-state" @click="handleRetry">
        <text class="gs-state__text">{{ t("Mobile.Message.loadFailed") }}</text>
      </view>
      <view v-else class="gs-list">

        <!-- 群名称：管理员可改（输入框 + 保存），普通成员只读 -->
        <view class="gs-card">
          <view class="gs-sec-head">
            <text class="gs-sec-title">{{ t("Mobile.Message.groupName") }}</text>
            <view v-if="canGovern" class="gs-save" hover-class="gs-save--active" @click="handleSaveName">
              <text class="gs-save__text">{{ savingName ? t("Mobile.Page.loadingMore") : t("Mobile.Common.save") }}</text>
            </view>
          </view>
          <input
            class="gs-name-input"
            v-model="nameDraft"
            :disabled="canGovern != true"
            :placeholder="t('Mobile.Message.groupNamePlaceholder')"
            placeholder-style="color:#b0aebc"
            :maxlength="30"
          />
        </view>

        <!-- 群号：点击复制（邀人加群用） -->
        <view class="gs-card">
          <view class="gs-cell" hover-class="gs-cell--active" @click="handleCopyGroupNo">
            <text class="gs-cell__label">{{ t("Mobile.Message.joinGroupNoLabel") }}</text>
            <view class="gs-cell__space" />
            <text class="gs-cell__value">{{ groupNo.length > 0 ? groupNo : "--" }}</text>
            <view class="gs-copy">
              <svg-icon name="icon-Copy" size="32" color="#5147ff" />
            </view>
          </view>
        </view>

        <!-- 治理开关：仅群主/管理员可改（disabled 锁交互），普通成员只读展示 -->
        <view class="gs-card">
          <view class="gs-cell">
            <text class="gs-cell__label">{{ t("Mobile.Message.joinApproveLabel") }}</text>
            <view class="gs-cell__space" />
            <switch class="gs-switch" :checked="joinApprove" color="#5147ff" :disabled="canGovern != true" @change="handleJoinApproveChange" />
          </view>
          <view class="gs-divider" />
          <view class="gs-cell">
            <text class="gs-cell__label">{{ t("Mobile.Message.allowInviteLabel") }}</text>
            <view class="gs-cell__space" />
            <switch class="gs-switch" :checked="allowInvite" color="#5147ff" :disabled="canGovern != true" @change="handleAllowInviteChange" />
          </view>
          <view class="gs-divider" />
          <view class="gs-cell">
            <text class="gs-cell__label">{{ t("Mobile.Message.allowPinLabel") }}</text>
            <view class="gs-cell__space" />
            <switch class="gs-switch" :checked="allowPin" color="#5147ff" :disabled="canGovern != true" @change="handleAllowPinChange" />
          </view>
          <view class="gs-divider" />
          <view class="gs-cell">
            <text class="gs-cell__label">{{ t("Mobile.Message.readReceiptLabel") }}</text>
            <view class="gs-cell__space" />
            <switch class="gs-switch" :checked="readReceipt" color="#5147ff" :disabled="canGovern != true" @change="handleReadReceiptChange" />
          </view>
        </view>

        <!-- 解散群聊（仅群主；群主退群需先转让，此页只给解散） -->
        <view v-if="myRole == 3" class="gs-card">
          <view class="gs-disband" hover-class="gs-disband--active" @click="handleDisbandTap">
            <text class="gs-disband__text">{{ t("Mobile.Message.dissolveGroupConfirm") }}</text>
          </view>
        </view>

        <view class="gs-tail" />
      </view>
    </scroll-view>

    <!-- 紧凑确认弹窗（解散群聊二次确认，替代系统 showModal 样式） -->
    <confirm-modal ref="confirmModalRef" @confirm="disbandGroup" />
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, type ComponentPublicInstance } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import {
    apiImConvDetail,
    apiImGroupDisband,
    apiImGroupSetAllowInvite,
    apiImGroupSetAllowPin,
    apiImGroupSetJoinApprove,
    apiImGroupSetName,
    apiImGroupSetReadReceipt,
  } from "@/servers/im";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import ConfirmModal from "@/components/confirm-modal/confirm-modal.uvue";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ===== 页面入参 =====
  const convId = ref<string>("");

  // ===== 群详情状态 =====
  const nameDraft = ref<string>("");
  const groupNo = ref<string>("");
  const memberCount = ref<number>(0);
  /** 我的角色：1=普通成员 2=管理员 3=群主（★对齐服务端 ImConstants；管理权限 = >=2）。 */
  const myRole = ref<number>(1);
  const joinApprove = ref<boolean>(false);
  const allowInvite = ref<boolean>(true);
  const allowPin = ref<boolean>(false);
  const readReceipt = ref<boolean>(false);
  /** allowMemberInvite 三态原始值：""=键缺失(视为允许) / "true" / "false"。 */
  let allowInviteRaw = "";

  // ===== 页面态 =====
  const loading = ref<boolean>(false);
  const loadFailed = ref<boolean>(false);
  const savingName = ref<boolean>(false);
  const disbanding = ref<boolean>(false);

  const canGovern = computed((): boolean => myRole.value >= 2);

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  /** 详情：groupNo/治理开关只在此端点返回。 */
  async function loadAll(): Promise<void> {
    if (convId.value.length == 0 || loading.value) {
      return;
    }
    loading.value = true;
    loadFailed.value = false;
    try {
      const res = await apiImConvDetail(convId.value);
      if (apiResCode(res) != SUCCESS_CODE) {
        loading.value = false;
        loadFailed.value = true;
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        nameDraft.value = readString(dataObj, "name");
        groupNo.value = readString(dataObj, "groupNo");
        memberCount.value = readNumber(dataObj, "memberCount", 0);
        myRole.value = readNumber(dataObj, "myRole", 1);
        joinApprove.value = readBool(dataObj, "joinApprove");
        allowPin.value = readBool(dataObj, "allowMemberPin");
        readReceipt.value = readBool(dataObj, "readReceiptOn");
        // ★allowMemberInvite 缺键=允许（PC `!== false` 同口径），勿用 readBool 读成关
        const inviteRaw = dataObj["allowMemberInvite"];
        allowInviteRaw = inviteRaw == null ? "" : `${inviteRaw}`;
        allowInvite.value = allowInviteRaw != "false";
      }
      loading.value = false;
    } catch (_error) {
      loading.value = false;
      loadFailed.value = true;
    }
  }

  function handleRetry(): void {
    if (loadFailed.value) {
      loadAll();
    }
  }

  /** 改群名（管理员）：空名提示；成功后本地生效。 */
  async function handleSaveName(): Promise<void> {
    const name = nameDraft.value.trim();
    if (name.length == 0) {
      uni.showToast({ title: t("Mobile.Message.groupNameRequired"), icon: "none" });
      return;
    }
    if (savingName.value || convId.value.length == 0) {
      return;
    }
    savingName.value = true;
    try {
      const res = await apiImGroupSetName(convId.value, name);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Profile.saveSuccess"), icon: "none" });
      } else {
        uni.showToast({ title: apiResMessage(res), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
    savingName.value = false;
  }

  /** 复制群号。 */
  function handleCopyGroupNo(): void {
    if (groupNo.value.length == 0) {
      return;
    }
    uni.setClipboardData({
      data: groupNo.value,
      success: (_res) => {
        uni.showToast({ title: t("Mobile.Common.copySuccess"), icon: "none" });
      },
    });
  }

  // ===== 治理开关（乐观更新，失败回滚；disabled 已锁普通成员，这里仍防御） =====

  function handleJoinApproveChange(event: any): void {
    const se = event as UniSwitchChangeEvent;
    const next = se.detail.value;
    apiImGroupSetJoinApprove(convId.value, next)
      .then((res) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          joinApprove.value = next;
        } else {
          joinApprove.value = !next;
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
      })
      .catch((_e: any | null) => {
        joinApprove.value = !next;
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
  }

  function handleAllowInviteChange(event: any): void {
    const se = event as UniSwitchChangeEvent;
    const next = se.detail.value;
    apiImGroupSetAllowInvite(convId.value, next)
      .then((res) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          allowInvite.value = next;
        } else {
          allowInvite.value = !next;
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
      })
      .catch((_e: any | null) => {
        allowInvite.value = !next;
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
  }

  function handleAllowPinChange(event: any): void {
    const se = event as UniSwitchChangeEvent;
    const next = se.detail.value;
    apiImGroupSetAllowPin(convId.value, next)
      .then((res) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          allowPin.value = next;
        } else {
          allowPin.value = !next;
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
      })
      .catch((_e: any | null) => {
        allowPin.value = !next;
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
  }

  function handleReadReceiptChange(event: any): void {
    const se = event as UniSwitchChangeEvent;
    const next = se.detail.value;
    apiImGroupSetReadReceipt(convId.value, next)
      .then((res) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          readReceipt.value = next;
        } else {
          readReceipt.value = !next;
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
      })
      .catch((_e: any | null) => {
        readReceipt.value = !next;
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
  }

  // ===== 解散群聊（仅群主，二次确认红色弹窗） =====
  async function disbandGroup(): Promise<void> {
    disbanding.value = true;
    try {
      const res = await apiImGroupDisband(convId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.dissolveGroupSuccess"), icon: "none" });
        // 群不复存在：切回消息 tab（清掉底下的群信息页/聊天页栈）
        setTimeout(() => {
          uni.switchTab({ url: "/pages/message/message" });
        }, 400);
      } else {
        uni.showToast({ title: apiResMessage(res), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
    disbanding.value = false;
  }

  // ===== 紧凑确认弹窗（confirm-modal）=====
  const confirmModalRef = ref<any | null>(null);

  function handleDisbandTap(): void {
    if (disbanding.value) {
      return;
    }
    const nameParams = new Map<string, string | number>();
    nameParams.set("name", nameDraft.value);
    const tipParams = new Map<string, string | number>();
    tipParams.set("count", memberCount.value);
    const proxy = confirmModalRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(
      "open",
      translateFn("Mobile.Message.dissolveGroupTitle", toI18nParams(nameParams), t("Mobile.Message.dissolveGroupConfirm")),
      translateFn("Mobile.Message.dissolveGroupTip", toI18nParams(tipParams), ""),
      t("Mobile.Message.dissolveGroupConfirm"),
    );
  }


  function handleBack(): void {
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      uni.switchTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    loadAll();
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架 ===== */
  .gs-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #f6f5fb;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  .gs-header {
    flex-shrink: 0;
    height: 108rpx;
    padding: 0 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(250, 249, 253, 0.92);
    border-bottom: 2rpx solid rgba(81, 71, 255, 0.1);
  }

  .gs-header__btn {
    width: 72rpx;
    height: 72rpx;
    border-radius: 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gs-header__btn--active {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .gs-header__btn--ghost {
    background-color: rgba(0, 0, 0, 0);
  }

  .gs-header__title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .gs-header__title {
    font-size: 33rpx;
    line-height: 46rpx;
    font-weight: 600;
    color: #17171a;
  }

  .gs-body {
    flex: 1;
    min-height: 0;
    padding: 28rpx 32rpx;
  }

  .gs-state {
    padding: 240rpx 48rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .gs-state__text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #9a98a5;
  }

  .gs-list {
    display: flex;
    flex-direction: column;
  }

  .gs-card {
    margin-bottom: 24rpx;
    padding: 0 28rpx;
    background-color: #ffffff;
    border: 2rpx solid #ecebf1;
    border-radius: 20rpx;
    display: flex;
    flex-direction: column;
  }

  /* ===== 群名编辑 ===== */
  .gs-sec-head {
    padding-top: 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .gs-sec-title {
    flex: 1;
    min-width: 0;
    font-size: 26rpx;
    line-height: 36rpx;
    color: #9a98a5;
  }

  .gs-save {
    padding: 8rpx 20rpx;
    border-radius: 24rpx;
    background-color: rgba(81, 71, 255, 0.08);
  }

  .gs-save--active {
    background-color: rgba(81, 71, 255, 0.16);
  }

  .gs-save__text {
    font-size: 25rpx;
    line-height: 36rpx;
    font-weight: 600;
    color: #5147ff;
  }

  .gs-name-input {
    height: 92rpx;
    padding: 0;
    font-size: 30rpx;
    line-height: 42rpx;
    color: #22212a;
  }

  /* ===== 通用 cell ===== */
  .gs-cell {
    min-height: 104rpx;
    padding: 16rpx 0;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .gs-cell--active {
    background-color: #f7f6fb;
  }

  .gs-cell__label {
    flex-shrink: 0;
    font-size: 29rpx;
    line-height: 40rpx;
    color: #22212a;
  }

  .gs-cell__space {
    flex: 1;
  }

  .gs-cell__value {
    font-size: 26rpx;
    line-height: 36rpx;
    color: #6b6976;
  }

  .gs-copy {
    width: 56rpx;
    height: 56rpx;
    margin-left: 12rpx;
    border-radius: 16rpx;
    background-color: rgba(81, 71, 255, 0.08);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gs-divider {
    height: 2rpx;
    background-color: #f1f0f6;
  }

  .gs-switch {
    flex-shrink: 0;
    transform: scale(0.9);
  }

  /* ===== 解散群聊 ===== */
  .gs-disband {
    padding: 26rpx 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .gs-disband--active {
    opacity: 0.7;
  }

  .gs-disband__text {
    font-size: 30rpx;
    line-height: 42rpx;
    font-weight: 500;
    color: #ff4d4f;
  }

  .gs-tail {
    height: 40rpx;
  }
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #f6f5fb;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #f6f5fb;
  }
  /* #endif */
</style>
