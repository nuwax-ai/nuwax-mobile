  }

  .detail-load-error-text {
    color: #dd524d;
    font-size: 26rpx;
  }

  .detail-offline-tip {
    margin: 0 32rpx 20rpx;
    color: #999999;
    font-size: 24rpx;
    text-align: center;
  }

  /* 字段 */
  .field-label {
    font-size: 24rpx;
    color: #666666;
    padding: 20rpx 32rpx 12rpx;
  }

  .field-input-box {
    background-color: #ffffff;
    border-radius: 16rpx;
    margin: 0 24rpx;
