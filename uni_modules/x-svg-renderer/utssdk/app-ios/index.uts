import { UIImageView, UIView } from "UIKit"
import { SVGKImage } from "SVGKit"

export class NativeSvgRenderer {
  private element: UniNativeViewElement
  private imageView: UIImageView | null = null
  private listener: ((message: string | null) => void) | null = null
  private lastContent: string = ''
  private destroyed: boolean = false

  constructor(element: UniNativeViewElement) {
    this.element = element
    const view = new UIImageView()
    view.contentMode = UIView.ContentMode.scaleAspectFit
    view.clipsToBounds = true
    this.imageView = view
    this.element.bindIOSView(view)
  }

  setListener(listener: (message: string | null) => void): void {
    if (this.destroyed) return
    this.listener = listener
  }

  setFit(fit: string): void {
    if (this.destroyed) return
    const view = this.imageView
    if (view == null) return
    if (fit == 'cover') view.contentMode = UIView.ContentMode.scaleAspectFill
    else if (fit == 'fill') view.contentMode = UIView.ContentMode.scaleToFill
    else if (fit == 'center') view.contentMode = UIView.ContentMode.center
    else view.contentMode = UIView.ContentMode.scaleAspectFit
  }

  setSvg(content: string): void {
    if (this.destroyed) return
    const view = this.imageView
    if (view == null) {
      this.listener?.invoke('iOS native view is not initialized')
      return
    }

    if (content.trim().length == 0) {
      clear()
      return
    }

    if (content == this.lastContent) {
      this.listener?.invoke(null)
      return
    }

    const data = content.data(using = String.Encoding.utf8)
    if (data == null) {
      this.listener?.invoke('failed to encode SVG')
      return
    }

    const svgImage = new SVGKImage(data = data)
    if (svgImage == null) {
      view.image = null
      this.lastContent = ''
      this.listener?.invoke('failed to render SVG')
      return
    }

    view.image = svgImage.uiImage
    this.lastContent = content
    this.listener?.invoke(null)
  }

  clear(): void {
    const view = this.imageView
    if (view != null) {
      view.image = null
    }
    this.lastContent = ''
  }

  destroy(): void {
    if (this.destroyed) return
    this.destroyed = true
    clear()
    this.listener = null
    this.imageView = null
    UTSiOS.destroyInstance(this)
  }
}
