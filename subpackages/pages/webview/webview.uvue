<template>
  <view class="webview-page page-container">
    <!-- #ifdef H5 || WEB || APP -->
    <!-- Web 与 App 统一使用自定义导航栏；安全区覆盖 Android 状态栏和 iOS 刘海区域。 -->
    <custom-nav-bar
      class="webview-nav"
      :title="displayPageTitle"
      :subtitle="displayPageHost"
      :has-safety-zone="true"
    >
      <!-- 密度类尺寸 px 定值（22px = 44rpx @375），折叠屏展开/宽屏不随屏宽放大 -->
      <template v-slot:left>
        <view class="webview-back" @click="onBackClick">
          <svg-icon name="icon-X" size="18" unit="px" />
        </view>
      </template>
      <template v-slot:right>
        <view class="webview-share" @click="handleShare">
          <svg-icon name="icon-More" size="18" unit="px" />
        </view>
      </template>
    </custom-nav-bar>
    <!-- #endif -->

    <view class="webview-content">
      <web-view
        class="web-view"
        :class="repoBootstrapCover ? 'web-view--hidden' : ''"
        v-if="url.length != 0"
        :src="url"
        id="webview"
        <!-- #ifndef APP -->
        @error="handleWebviewError"
        <!-- #endif -->
        @load="handleWebviewLoad"
        @message="handleWebviewMessage"
      ></web-view>
      <!-- #ifdef APP -->
      <!-- 不可见占位：Android 内容区只有 web-view 时会走全屏原生层，createWebviewContext 拿不到。 -->
      <view class="webview-placeholder" />
      <!-- #endif -->
    </view>
    <share-sheet />
  </view>
</template>

<script lang="uts" setup>
  import { switchMainTab } from "@/utils/mainTabNavigation";

  import { computed, nextTick, ref, watch } from "vue";
  // #ifdef APP
  import { getCurrentInstance } from "vue";
  // #endif
  import { removeQueryCompat, isHttpUrl } from "@/utils/common";
  // #ifdef APP
  import { getApiBaseUrl } from "@/constants/config";
  // #endif
  import { apiUserTicketCreate } from "@/servers/agentDev";
  // #ifdef APP || MP-WEIXIN
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  // #endif
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { onLoad, onUnload, onBackPress, onShareAppMessage, onAddToFavorites } from "@dcloudio/uni-app";
  import { isRepoLibraryPath } from "@/utils/repoLibraryLink";
  import { prepareRepoPageShare } from "./repoPageShare";
  import { filePreviewPath, prepareFilePageShare } from "./filePageShare";
  import { isTabPage } from "@/utils/commonBusiness";
  // #ifdef APP-IOS
  // iOS：返回时须显式恢复 TabBar（常驻壳关壳可能 hide 过）
  import { navigateBackByBackUrl } from "@/utils/commonBusiness";
  // #endif
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  // App 端内嵌 H5 字体放大修复：Android 强制 webview textZoom = 100%（iOS 无此问题，自动跳过）
  import { fixAppWebviewTextZoom } from "@/subpackages/utils/webviewTextZoom";
  // #ifdef APP-IOS
  import { primeIosRepoAccessToken } from "@/uni_modules/nuwax-webview-document-start";
  // #endif
  // #ifdef APP
  import {
    appWebViewGoBack,
    appWebViewPageTitle,
    appWebViewPageUrl,
    buildRepoTokenHtml,
    clearAndroidWebViewHistory,
    primeAppWebViewAccessToken,
  } from "@/subpackages/utils/appWebViewHistory";
  // #endif
  // #ifdef APP-IOS
  import {
    appWebViewCanGoBack,
    enableAppWebViewBackGesture,
  } from "@/subpackages/utils/appWebViewHistory";
  // #endif
  import ShareSheet from "@/components/share-sheet/share-sheet.uvue";
  import { useShareLink, ShareLinkOptions } from "@/hooks/useShareLink";
  import { buildOutgoingShareUrl, chooseShareTarget, dismissShareSheet, isShareSheetOpen, ShareTarget } from "@/utils/appShare";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
  // uvue 中直接调用 t() 会因缺少 params 形参报错，这里包一层单参版本

  const url = ref<string>("");
  /** 资料库写入 token 的引导页期间藏起 web-view，避免露出 about:blank。 */
  const repoBootstrapCover = ref<boolean>(false);
  const method = ref<string>("");
  const data_type = ref<string>("");
  const request_id = ref<string>("");
  const pageTitle = ref<string>("");
  /** 当前地址的域名。加载完成前单独居中显示。 */
  const pageHost = ref<string>("");
  /** 内嵌 webview / iframe 当前地址。分享按这个地址生成，页内跳转后会更新。 */
  const embeddedPageUrl = ref<string>("");
  /** 内嵌页 document.title。读到之后才显示在域名上方。 */
  const embeddedTitle = ref<string>("");
  let navSyncTimer: number = 0;

  // #ifdef APP
  const instance = getCurrentInstance();
  let webViewContext: WebviewContext | null = null;
  /** 先创建 WebView 并登记 document-start，再打开资料库。 */
  let repoDocBootstrap = false;
  let repoDocTarget = "";
  let repoDocOrigin = "";
  let repoDocTimer: number = 0;
  let repoDocAttempts = 0;
  // #endif
  // #ifdef APP-IOS
  /** iOS 页面侧滑是否已按网页 canGoBack 锁住。-1 表示还没设置过。 */
  let iosSwipeLocked = -1;
  let iosSwipeSyncTimer: number = 0;
  // #endif

  /** 与模板 web-view id 一致，供原生后退栈查询。 */
  const WEBVIEW_ELEMENT_ID = "webview";

  const displayPageTitle = computed((): string => {
    if (embeddedTitle.value.length > 0) {
      return embeddedTitle.value;
    }
    if (pageHost.value.length > 0) {
      return pageHost.value;
    }
    return pageTitle.value.length > 0 ? pageTitle.value : t("Mobile.Webview.defaultTitle");
  });

  /** 只有读到网页标题后才把域名放到第二行，加载前标题位本身就是域名。 */
  const displayPageHost = computed((): string => {
    return embeddedTitle.value.length > 0 ? pageHost.value : "";
  });

  /** 去掉协议后，截出主机名，不带端口、路径和账号。 */
  const stripHost = (raw: string): string => {
    let value = raw.trim();
    const schemeIdx = value.indexOf("://");
    if (schemeIdx >= 0) {
      value = value.substring(schemeIdx + 3);
    }
    const slash = value.indexOf("/");
    if (slash >= 0) {
      value = value.substring(0, slash);
    }
    const query = value.indexOf("?");
    if (query >= 0) {
      value = value.substring(0, query);
    }
    const hash = value.indexOf("#");
    if (hash >= 0) {
      value = value.substring(0, hash);
    }
    const at = value.indexOf("@");
    if (at >= 0) {
      value = value.substring(at + 1);
    }
    const colon = value.indexOf(":");
    if (colon >= 0) {
      value = value.substring(0, colon);
    }
    return value;
  };

  /**
   * 从地址里取出主机名，不带协议、端口和路径。
   * 站内相对路径用当前站点或接口域名。
   */
  const hostOf = (raw: string): string => {
    const value = raw.trim();
    if (value.length == 0) {
      return "";
    }
    if (value.indexOf("://") < 0 && value.indexOf("/") == 0) {
      // #ifdef H5 || WEB
      return `${window.location.host}`;
      // #endif
      // #ifdef APP
      return stripHost(getApiBaseUrl());
      // #endif
      // #ifdef MP-WEIXIN
      return "";
      // #endif
    }
    return stripHost(value);
  };

  /** 加载中 WebView 的 title 经常就是整段地址，这种情况不拿来当标题。 */
  const isDocumentTitle = (title: string, pageUrl: string): boolean => {
    const text = title.trim();
    if (text.length == 0) {
      return false;
    }
    if (text.indexOf("http://") == 0 || text.indexOf("https://") == 0) {
      return false;
    }
    if (pageUrl.length > 0 && text == pageUrl) {
      return false;
    }
    const host = hostOf(pageUrl.length > 0 ? pageUrl : text);
    return host.length == 0 || text != host;
  };

  const applyNavTitle = (title: string): void => {
    if (title == embeddedTitle.value) {
      return;
    }
    embeddedTitle.value = title;
    if (title.length > 0) {
      uni.setNavigationBarTitle({ title: title });
    }
  };

  /**
   * 记下内嵌页当前地址。分享链接在用户打开分享弹窗时再取。
   */
  const rememberEmbeddedPage = (rawUrl: string): void => {
    if (rawUrl.indexOf("http://") != 0 && rawUrl.indexOf("https://") != 0) {
      return;
    }
    const clean = removeQueryCompat(rawUrl, ["_ticket"]);
    if (clean.length == 0 || clean == embeddedPageUrl.value) {
      return;
    }
    embeddedPageUrl.value = clean;
  };

  /** 引导页地址，不能拿来当资料库页面或导航标题。 */
  const isBootstrapPageUrl = (raw: string): boolean => {
    return raw.indexOf("about:blank") >= 0 || raw.indexOf("about://") == 0 || raw.indexOf("data:text/html") == 0;
  };

  /**
   * 读取内嵌页标题和当前地址。
   * App 走原生 WebView；H5 只在同源 iframe 可读，跨域时保持域名单行。
   */
  const syncEmbeddedNav = (): void => {
    let nextUrl = "";
    let nextTitle = "";
    // #ifdef APP
    nextUrl = appWebViewPageUrl(WEBVIEW_ELEMENT_ID);
    nextTitle = appWebViewPageTitle(WEBVIEW_ELEMENT_ID);
    // #endif
    // #ifdef H5 || WEB
    try {
      const frames = document.getElementsByTagName("iframe");
      if (frames.length > 0) {
        const frame = frames[frames.length - 1];
        const frameSrc = frame.src != null ? `${frame.src}` : "";
        try {
          const doc = frame.contentDocument;
          if (doc != null) {
            nextTitle = doc.title != null ? `${doc.title}` : "";
            nextUrl = frame.contentWindow != null ? `${frame.contentWindow.location.href}` : "";
          }
        } catch (_eCross) {
          // 外链跨域读不到 location，退回 iframe 自己的地址。
          nextUrl = frameSrc;
        }
        if (nextUrl.length == 0) {
          nextUrl = frameSrc;
        }
      }
    } catch (_eFrame) {
      nextTitle = "";
      nextUrl = "";
    }
    // #endif
    const hostSource = nextUrl.length > 0 ? nextUrl : url.value;
    if (repoBootstrapCover.value == true || isBootstrapPageUrl(hostSource)) {
      return;
    }
    const host = hostOf(hostSource);
    if (host.length > 0) {
      pageHost.value = host;
    }
    if (nextUrl.length > 0) {
      rememberEmbeddedPage(nextUrl);
    }
    if (isDocumentTitle(nextTitle, hostSource)) {
      applyNavTitle(nextTitle.trim());
    }
  };

  const stopEmbeddedNavSync = (): void => {
    if (navSyncTimer != 0) {
      clearInterval(navSyncTimer);
      navSyncTimer = 0;
    }
  };

  const startEmbeddedNavSync = (): void => {
    syncEmbeddedNav();
    if (navSyncTimer != 0) {
      return;
    }
    navSyncTimer = setInterval((): void => {
      syncEmbeddedNav();
    }, 500) as number;
  };

  // #ifdef APP-IOS
  /** 标题桥消息类型，与注入脚本里的 type 保持一致。 */
  const WEBVIEW_TITLE_MESSAGE_TYPE = "nuwax-webview-title";
  /** @load 后读 document.title 的短轮询次数与间隔。 */
  const WEBVIEW_TITLE_READ_TIMES = 10;
  const WEBVIEW_TITLE_READ_INTERVAL = 400;
  let webTitleReadTimer: number = 0;
  let webTitleReadCount = 0;

  /**
   * iOS 读不到原生页面标题：appWebViewPageTitle 要拿 WKWebView 的 title，
   * 而 WKWebView 只能经 utssdk 插件访问（见 appWebViewHistory 文件头），
   * 业务代码里 import WebKit 打包期就编不过。
   * 这里改在已加载的网页上下文里读 document.title，经容器注入的原生桥
   * `__uniapp_x_postMessage` 回传本页 @message，与 Android / 鸿蒙的 getTitle 效果对齐。
   */
  const requestWebViewDocumentTitle = (): void => {
    let ctx: WebviewContext | null = webViewContext;
    if (ctx == null) {
      try {
        ctx = uni.createWebviewContext(
          WEBVIEW_ELEMENT_ID,
          instance != null ? instance.proxy : null,
        );
        webViewContext = ctx;
      } catch (_eCtx) {
        return;
      }
      if (ctx == null) {
        return;
      }
    }
    const context = ctx;
    if (context == null) {
      return;
    }
    try {
      context.evalJS(
        "(function(){try{var t=document.title||'';var u=location.href||'';if(!t&&!u){return;}" +
          "var p={type:'nuwax-webview-title',title:t,url:u};" +
          "if(window.__uniapp_x_postMessage){window.__uniapp_x_postMessage({data:p});return;}" +
          "if(window.uni&&window.uni.webView&&window.uni.webView.postMessage){window.uni.webView.postMessage({data:p});}" +
          "}catch(e){}})()",
      );
    } catch (_eEval) {
      // 文档还在加载时 evalJS 可能抛错，交给下一次轮询
    }
  };

  let iosUrlSyncTimer: number = 0;

  /** 页内跳到外链后，持续读取当前网址，供分享使用。 */
  const startIosEmbeddedUrlSync = (): void => {
    if (iosUrlSyncTimer != 0) {
      return;
    }
    iosUrlSyncTimer = setInterval((): void => {
      if (isNeedCallApi.value == false) {
        requestWebViewDocumentTitle();
      }
    }, 500) as number;
  };

  const stopIosEmbeddedUrlSync = (): void => {
    if (iosUrlSyncTimer != 0) {
      clearInterval(iosUrlSyncTimer);
      iosUrlSyncTimer = 0;
    }
  };

  const stopWebViewTitleRead = (): void => {
    if (webTitleReadTimer != 0) {
      clearInterval(webTitleReadTimer);
      webTitleReadTimer = 0;
    }
  };

  /**
   * 每次 @load 后短轮询读标题：不少页面在 load 之后才由脚本写入 title，
   * 读到有效标题即停（由消息回调触发 stopWebViewTitleRead）。
   */
  const startWebViewTitleRead = (): void => {
    stopWebViewTitleRead();
    webTitleReadCount = 0;
    requestWebViewDocumentTitle();
    webTitleReadTimer = setInterval((): void => {
      webTitleReadCount++;
      requestWebViewDocumentTitle();
      if (webTitleReadCount >= WEBVIEW_TITLE_READ_TIMES) {
        stopWebViewTitleRead();
      }
    }, WEBVIEW_TITLE_READ_INTERVAL) as number;
  };

  /**
   * 消费标题桥消息并更新导航栏标题/域名。
   * 返回 true 表示这条 @message 是标题桥消息，已处理完。
   */
  const consumeWebViewTitleMessage = (messages: Array<UTSJSONObject>): boolean => {
    let matched = false;
    let nextTitle = "";
    let nextUrl = "";
    for (let i = 0; i < messages.length; i++) {
      const msg = messages[i];
      const typeVal = msg["type"];
      if (typeVal == null || `${typeVal}` != WEBVIEW_TITLE_MESSAGE_TYPE) {
        continue;
      }
      matched = true;
      const titleVal = msg["title"];
      nextTitle = titleVal != null ? `${titleVal}` : "";
      const urlVal = msg["url"];
      nextUrl = urlVal != null ? `${urlVal}` : "";
    }
    if (matched == false) {
      return false;
    }
    // 页内跳转后地址也会变，顺手同步域名，与 Android / 鸿蒙读 getUrl 的效果一致
    if (nextUrl.indexOf("http://") == 0 || nextUrl.indexOf("https://") == 0) {
      const host = hostOf(nextUrl);
      if (host.length > 0) {
        pageHost.value = host;
      }
      rememberEmbeddedPage(nextUrl);
    }
    const title = nextTitle.trim();
    if (isDocumentTitle(title, nextUrl)) {
      applyNavTitle(title);
      stopWebViewTitleRead();
    }
    return true;
  };
  // #endif

  watch(url, (value: string): void => {
    if (isBootstrapPageUrl(value)) {
      return;
    }
    const host = hostOf(value);
    if (host.length > 0) {
      pageHost.value = host;
    }
    embeddedTitle.value = "";
  });

  /**
   * 还原 webview 的 url 参数。
   * 资料库链接会编码两次，避开 iOS 对整段路由的一次 decodeURI；
   * 其它调用方仍是编码一次或已是绝对地址，循环解开到 http(s) 或站内路径即可。
   */
  const unwrapWebviewUrl = (raw: string): string => {
    let value = raw.trim();
    for (let i = 0; i < 2; i++) {
      if (
        value.indexOf("http://") == 0 ||
        value.indexOf("https://") == 0 ||
        (value.indexOf("/") == 0 && value.indexOf("//") != 0)
      ) {
        return value;
      }
      if (value.indexOf("%") < 0) {
        break;
      }
      try {
        const next = decodeURIComponent(value);
        const nextText = next != null ? `${next}` : "";
        if (nextText.length == 0 || nextText == value) {
          break;
        }
        value = nextText;
      } catch (_e) {
        break;
      }
    }
    return value;
  };

  // 获取查询参数
  const getQueryParams = (url: string): UTSJSONObject => {
    const parts = url.split("?");
    const queryString = parts.length > 1 ? parts[1] : "";
    const pairs = queryString.split("&");
    const params = new UTSJSONObject();
    for (let i = 0; i < pairs.length; i++) {
      const pair = pairs[i];
      if (pair.length == 0) {
        continue;
      }
      const kv = pair.split("=");
      const k = kv.length > 0 ? kv[0] : "";
      const v = kv.length > 1 ? kv[1] : "";
      const decK = decodeURIComponent(k);
      const decV = decodeURIComponent(v);
      const keyStr = decK != null ? decK : "";
      const valStr = decV != null ? decV : "";
      params[keyStr] = valStr;
    }
    return params;
  };

  // 判断是否需要调用接口
  const isNeedCallApi = computed((): boolean => {
    return (
      method.value == "browser_navigate_page" &&
      data_type.value.length > 0 &&
      request_id.value.length > 0
    );
  });

  // WebView 加载错误处理
  const handleWebviewError = (e: any) => {
    console.error("WebView 加载错误:", e);
    uni.showToast({
      title: t("Mobile.Webview.loadFailed"),
      icon: "none",
      duration: 2000,
    });
  };

  /** 资料库地址的站点源。localStorage 按这个源隔离。 */
  const originOfAbsolute = (raw: string): string => {
    const value = raw.trim();
    const proto = value.indexOf("://");
    if (proto < 0) {
      return "";
    }
    const rest = value.substring(proto + 3);
    let end: number = rest.length;
    const slash = rest.indexOf("/");
    if (slash >= 0 && slash < end) {
      end = slash;
    }
    const query = rest.indexOf("?");
    if (query >= 0 && query < end) {
      end = query;
    }
    const hash = rest.indexOf("#");
    if (hash >= 0 && hash < end) {
      end = hash;
    }
    if (end <= 0) {
      return "";
    }
    return value.substring(0, proto + 3 + end);
  };

  // #ifdef APP
  /** 本地登录 token。鸿蒙清空时会写成空串。 */
  const readCachedAccessToken = (): string => {
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    if (tokenRaw == null) {
      return "";
    }
    return `${tokenRaw}`.trim();
  };

  const stopRepoDocTimer = (): void => {
    if (repoDocTimer != 0) {
      clearInterval(repoDocTimer);
      repoDocTimer = 0;
    }
  };

  const primeRepoAccessToken = (): boolean => {
    const tokenNow = readCachedAccessToken();
    if (repoDocOrigin.length == 0 || tokenNow.length == 0 || repoDocTarget.length == 0) {
      return false;
    }
    // #ifdef APP-IOS
    try {
      return primeIosRepoAccessToken(
        WEBVIEW_ELEMENT_ID,
        buildRepoTokenHtml(tokenNow, repoDocTarget),
        repoDocOrigin + "/",
      );
    } catch (_eIos) {
      return false;
    }
    // #endif
    // #ifdef APP-ANDROID || APP-HARMONY
    return primeAppWebViewAccessToken(WEBVIEW_ELEMENT_ID, repoDocOrigin, tokenNow, repoDocTarget);
    // #endif
    // #ifndef APP-IOS
    // #ifndef APP-ANDROID
    // #ifndef APP-HARMONY
    return false;
    // #endif
    // #endif
    // #endif
  };

  const openRepoAfterDocumentStart = (): void => {
    const target = repoDocTarget;
    repoDocBootstrap = false;
    repoDocTarget = "";
    repoDocOrigin = "";
    stopRepoDocTimer();
    if (target.length == 0) {
      repoBootstrapCover.value = false;
      return;
    }
    repoBootstrapCover.value = false;
    url.value = target;
  };

  /**
   * 先让 WebView 挂上，在资料库文档脚本执行前写入本地 ACCESS_TOKEN，再打开资料库。
   * 没有本地 token，或当前端登记不上时返回 false，调用方直接打开资料库。
   */
  const startRepoDocumentStart = (target: string): boolean => {
    const origin = originOfAbsolute(target);
    const tokenToInject = readCachedAccessToken();
    if (origin.length == 0 || tokenToInject.length == 0) {
      return false;
    }
    repoDocTarget = target;
    repoDocOrigin = origin;
    repoDocAttempts = 0;
    repoDocBootstrap = true;
    repoBootstrapCover.value = true;
    stopRepoDocTimer();
    url.value = "about:blank";
    repoDocTimer = setInterval((): void => {
      if (repoDocBootstrap != true) {
        stopRepoDocTimer();
        return;
      }
      repoDocAttempts++;
      const tokenNow = readCachedAccessToken();
      if (tokenNow.length == 0) {
        return;
      }
      if (primeRepoAccessToken()) {
        stopRepoDocTimer();
        // 同源文档写入 token 后，再把组件地址换成资料库，避免停在 about:blank。
        setTimeout((): void => {
          openRepoAfterDocumentStart();
        }, 150);
        return;
      }
      if (repoDocAttempts >= 15) {
        const fallback = repoDocTarget;
        repoDocBootstrap = false;
        repoBootstrapCover.value = false;
        repoDocTarget = "";
        repoDocOrigin = "";
        stopRepoDocTimer();
        url.value = fallback;
      }
    }, 100) as number;
    return true;
  };
  // #endif

  /**
   * iOS：网页还能后退时关掉页面侧滑，边缘手势交给 WKWebView；
   * 已经在第一页时恢复页面侧滑，右滑离开本页。
   * canGoBack 会随网页跳转变化，且 pushState 不一定触发 @load，因此页面显示期间轮询。
   */
  const syncIosWebViewSwipe = (): void => {
    // #ifdef APP-IOS
    enableAppWebViewBackGesture(WEBVIEW_ELEMENT_ID);
    const canGoBack = appWebViewCanGoBack(WEBVIEW_ELEMENT_ID);
    const sheetOpen = isShareSheetOpen();
    const locked = canGoBack || sheetOpen ? 1 : 0;
    if (iosSwipeLocked == locked) {
      return;
    }
    const pages = getCurrentPages();
    if (pages.length == 0) {
      return;
    }
    const style = new UTSJSONObject();
    style["disableSwipeBack"] = canGoBack || sheetOpen;
    try {
      pages[pages.length - 1].setPageStyle(style);
      iosSwipeLocked = locked;
    } catch (_eStyle) {
      iosSwipeLocked = -1;
    }
    // #endif
  };

  const startIosWebViewSwipeSync = (): void => {
    // #ifdef APP-IOS
    syncIosWebViewSwipe();
    if (iosSwipeSyncTimer != 0) {
      return;
    }
    iosSwipeSyncTimer = setInterval((): void => {
      syncIosWebViewSwipe();
    }, 250) as number;
    // #endif
  };

  const stopIosWebViewSwipeSync = (): void => {
    // #ifdef APP-IOS
    if (iosSwipeSyncTimer != 0) {
      clearInterval(iosSwipeSyncTimer);
      iosSwipeSyncTimer = 0;
    }
    // #endif
  };

  // WebView 加载完成
  const handleWebviewLoad = (e: UniWebViewLoadEvent) => {
    let loadedSrc = "";
    if (e.detail.src != null) {
      loadedSrc = e.detail.src;
    }
    if (loadedSrc.indexOf("/m/static/repo-token-bridge.html") >= 0) {
      return;
    }
    // #ifdef APP
    if (repoDocBootstrap == true) {
      if (isRepoLibraryPath(loadedSrc) == false) {
        return;
      }
      repoDocBootstrap = false;
      // #ifdef APP-ANDROID
      clearAndroidWebViewHistory(WEBVIEW_ELEMENT_ID);
      // #endif
    }
    // #endif
    if (loadedSrc.length > 0) {
      rememberEmbeddedPage(loadedSrc);
    }
    // Android 内嵌 H5 字体放大修复：@load 时 WebView 必已存在，立即复位 textZoom
    fixAppWebviewTextZoom();
    syncIosWebViewSwipe();
    syncEmbeddedNav();
    // #ifdef APP-IOS
    // iOS 没有原生 getTitle，改注入脚本读 document.title（见 requestWebViewDocumentTitle）。
    // AI 读页（browser_navigate_page）的页面要独占 @message 取 html，这类页面不插标题桥。
    if (isNeedCallApi.value == false) {
      startWebViewTitleRead();
    }
    // #endif
    // #ifdef MP-WEIXIN || APP
    if (isNeedCallApi.value) {
      uni.showLoading({
        title: t("Mobile.Webview.aiReading"),
        mask: true,
      });
      setTimeout(() => {
        uni.navigateBack({ delta: 1 });
        uni.hideLoading();
      }, 4000);
    }
    // #endif
  };

  /**
   * WebView 消息处理
   *
   * ⚠️ 重要：微信小程序的 @message 不会实时触发！
   * 触发时机：
   * 1. 用户点击返回按钮（最常用）
   * 2. 组件销毁时
   * 3. 分享时
   *
   * 调试方法：
   * 1. 网页发送消息后，点击小程序的返回按钮
   * 2. 查看控制台是否有 "收到消息" 日志
   * 3. 如果没有，检查网页端代码是否正确调用 wx.miniProgram.postMessage
   */
  const handleWebviewMessage = (e: UniWebViewMessageEvent): void => {
    // #ifdef APP-IOS
    // 标题桥消息先消费掉，避免落进下面「取最后一条 html」的逻辑
    if (consumeWebViewTitleMessage(e.detail.data)) {
      return;
    }
    // #endif
    // #ifdef MP-WEIXIN || APP
    // UniWebViewMessageEvent 是原生强类型对象，Android 上不可整体强转 UTSJSONObject。
    // detail.data 是 postMessage 消息数组，只取最后一条的 html。
    const messages = e.detail.data;
    if (isNeedCallApi.value && messages.length > 0) {
      const lastMsg = messages[messages.length - 1];
      uni.$emit(
        "browser_navigate_page",
        {
          method: method.value,
          data_type: data_type.value,
          html: lastMsg["html"],
          request_id: request_id.value,
        } as UTSJSONObject,
      );
    } else {
      console.warn("消息数组为空");
    }
    // #endif
  };

  /**
   * 清理当前 webview 地址：分享出去的链接去掉 _ticket。
   * 小程序转发（拼进内部路径）与「复制链接/系统分享」（需要真实可直接打开的外链）共用同一份清理逻辑。
   */
  const buildCleanShareTargetUrl = (): string => {
    const source = embeddedPageUrl.value.length > 0 ? embeddedPageUrl.value : url.value;
    return removeQueryCompat(source, ["_ticket"]);
  };

  /**
   * 获取分享链接（用于小程序转发/收藏路径拼接，需 encode 后作为查询参数值）
   */
  const getSharingLink = () => {
    return encodeURIComponent(buildCleanShareTargetUrl());
  };

  /**
   * 分享当前网页的真实地址。
   * 文件预览只带 sk，避免把整段文件地址再嵌进链接后被飞书截断。
   */
  const readQueryValue = (raw: string, key: string): string => {
    const mark = key + "=";
    const idx = raw.indexOf(mark);
    if (idx < 0) return "";
    const start = idx + mark.length;
    const amp = raw.indexOf("&", start);
    const hash = raw.indexOf("#", start);
    // indexOf 在 Android 上是 Number，不能赋给由 length 推出的 Int。
    let encoded = "";
    if (amp >= 0 && (hash < 0 || amp <= hash)) {
      encoded = raw.substring(start, amp);
    } else if (hash >= 0) {
      encoded = raw.substring(start, hash);
    } else {
      encoded = raw.substring(start);
    }
    try {
      const decoded = decodeURIComponent(encoded);
      return decoded != null ? `${decoded}` : encoded;
    } catch (_e) {
      return encoded;
    }
  };

  const getShareUrl = async (): Promise<string> => {
    const target = new ShareTarget();
    target.title = displayPageTitle.value;
    const cleanUrl = buildCleanShareTargetUrl();
    // 资料库：打开分享弹窗时再取分享地址。
    if (isRepoLibraryPath(cleanUrl)) {
      const repoShareUrl = await prepareRepoPageShare(cleanUrl);
      if (repoShareUrl.length > 0) {
        return repoShareUrl;
      }
    }
    // 文件预览（路径含 /api/f/）：打开分享弹窗时再换成 ak 直链。其它页面不走这里。
    if (filePreviewPath(cleanUrl).length > 0) {
      const fileShareUrl = await prepareFilePageShare(cleanUrl);
      if (fileShareUrl.length > 0) {
        return fileShareUrl;
      }
    }
    const shareKey = readQueryValue(cleanUrl, "sk");
    if (cleanUrl.indexOf("file-preview.html") >= 0 && shareKey.length > 0) {
      target.sk = shareKey;
      const schemeIdx = cleanUrl.indexOf("://");
      const hostStart = schemeIdx >= 0 ? schemeIdx + 3 : -1;
      const pathIdx = hostStart >= 0 ? cleanUrl.indexOf("/", hostStart) : -1;
      const origin = pathIdx > 0 ? cleanUrl.substring(0, pathIdx) : "";
      if (origin.indexOf("http://") == 0 || origin.indexOf("https://") == 0) {
        target.pageUrl = origin + "/static/file-preview.html?sk=" + shareKey;
      }
    } else {
      target.pageUrl = cleanUrl;
    }
    const shareUrl = buildOutgoingShareUrl(target);
    if (shareUrl.indexOf("http://") != 0 && shareUrl.indexOf("https://") != 0) {
      throw new Error(t("Mobile.Share.shareFailed"));
    }
    return shareUrl;
  };

  // 分享交互统一由 useShareLink 提供，与 file-preview-page 共用同一套逻辑：
  // H5/WEB 点击分享直接复制链接；App 端唤起系统分享面板。模板无需渲染任何分享面板组件。
  // 入参须 new + 逐字段赋值（不能传对象字面量，Android UTS 编译器会把字面量误推导成
  // UTSJSONObject 而报参数类型不匹配，与 usePageResume 的 PageResumeOptions 同一避坑写法）。
  const shareTitle = (): string => {
    const title = displayPageTitle.value;
    if (title.length == 0) {
      return title;
    }
    return "【" + title + "】";
  };

  const shareOptions = new ShareLinkOptions();
  shareOptions.getShareTitle = () => shareTitle();
  shareOptions.getShareUrl = getShareUrl;
  const share = useShareLink(shareOptions);
  const handleShareOutside = share.handleShare;

  /** 分享面板里的「刷新」：先走网页自身刷新，不行再重设地址。 */
  const reloadCurrentWebView = (): void => {
    // #ifdef APP
    try {
      let ctx: WebviewContext | null = webViewContext;
      if (ctx == null) {
        ctx = uni.createWebviewContext(
          WEBVIEW_ELEMENT_ID,
          instance != null ? instance.proxy : null,
        );
        webViewContext = ctx;
      }
      if (ctx != null) {
        ctx.reload();
        return;
      }
    } catch (_e) {
      // 原生刷新不可用时重设地址
    }
    // #endif
    const current = url.value;
    if (current.length == 0) return;
    url.value = "";
    nextTick(() => {
      url.value = current;
    });
  };

  const handleShare = async (): Promise<void> => {
    try {
      const shareUrl = await getShareUrl();
      chooseShareTarget(shareTitle(), shareUrl, () => {
        handleShareOutside();
      }, reloadCurrentWebView);
    } catch (_error) {
      uni.showToast({
        title: t("Mobile.Share.shareFailed"),
        icon: "none",
      });
    }
  };

  /** 网页还有上一页时先退网页。返回 true 表示已经消费这次返回。 */
  const consumeWebViewBack = (): boolean => {
    // #ifdef APP
    if (appWebViewGoBack(WEBVIEW_ELEMENT_ID)) {
      syncIosWebViewSwipe();
      return true;
    }
    // #endif
    return false;
  };

  /** 导航栏关闭：不论网页内部跳了多少层，直接离开本页。侧滑和系统返回仍走 consumeWebViewBack。 */
  const onBackClick = () => {
    const pages = getCurrentPages();
    if (pages.length > 1) {
      uni.navigateBack({ delta: 1 });
      return;
    }

    // 栈只剩本页（H5 刷新 / 直接打开）：按 storage 里的来源落地
    const backUrlRaw = uni.getStorageSync("backUrl");
    const backUrl = backUrlRaw != null ? `${backUrlRaw}` : "";
    const toUrl =
      backUrl.length > 0 && backUrl != "/" ? backUrl : "/pages/message/message";

    // #ifdef APP-IOS
    // iOS：常驻壳关壳时 TabBar 可能仍被 hide，回 Tab 前须显式恢复
    navigateBackByBackUrl(toUrl);
    // #endif
    // #ifndef APP-IOS
    if (isTabPage(toUrl)) {
      switchMainTab({ url: toUrl });
    } else {
      uni.redirectTo({ url: toUrl });
    }
    // #endif
    uni.removeStorageSync("backUrl");
  };

  // 初始化加载
  const onLoadInit = async (params: OnLoadOptions) => {
    const pageAppVal = params["pageApp"];
    const isPageApp = pageAppVal != null && `${pageAppVal}` == "1";

    const urlVal = params["url"];
    if (urlVal == null) {
      return;
    }
    const urlStr = `${urlVal}`;
    const currentUrl = unwrapWebviewUrl(urlStr);
    if (currentUrl.length == 0) {
      return;
    }

    // 设置页面标题：优先取本页路由参数 title（外部链接不便在目标 URL 上拼 query），
    // 其次取目标 URL 自带的 title（站内页沿用原有约定），都没有才用默认标题
    const routeTitleRaw = params["title"];
    let routeTitle = "";
    if (routeTitleRaw != null) {
      // 调用方按路由约定做过 encodeURIComponent，这里与 url 参数一致地解码
      const decodedTitle = decodeURIComponent(`${routeTitleRaw}`);
      routeTitle = decodedTitle != null ? decodedTitle : "";
    }

    // 获取查询参数
    const queryParams = getQueryParams(currentUrl);
    const titleRaw = queryParams["title"];
    const title =
      routeTitle.length > 0
        ? routeTitle
        : (titleRaw != null ? `${titleRaw}` : t("Mobile.Webview.defaultTitle"));
    pageTitle.value = title;
    uni.setNavigationBarTitle({
      title: title,
    });

    // #ifdef H5 || WEB
    if (isHttpUrl(currentUrl)) {
      url.value = currentUrl;
    } else if (`${window.location.protocol}` == "file:") {
      // 本地包的 origin 是 file://。相对路径拼上去会打开包内 index，也就是 App 首页。
      return;
    } else {
      url.value = window.location.origin + currentUrl;
    }
    // #endif

    // #ifdef MP-WEIXIN || APP
    // 资料库不走 PageApp 的 _ticket。各端在资料库脚本执行前写入本地 token。
    if (isRepoLibraryPath(currentUrl)) {
      // #ifdef APP
      if (startRepoDocumentStart(currentUrl)) {
        return;
      }
      // #endif
      // #ifdef MP-WEIXIN
      const mpTokenRaw = uni.getStorageSync(ACCESS_TOKEN);
      const mpToken = mpTokenRaw != null ? `${mpTokenRaw}`.trim() : "";
      const mpOrigin = originOfAbsolute(currentUrl);
      if (mpToken.length > 0 && mpOrigin.length > 0) {
        url.value =
          mpOrigin +
          "/m/static/repo-token-bridge.html?token=" +
          encodeURIComponent(mpToken) +
          "&next=" +
          encodeURIComponent(currentUrl);
        return;
      }
      // #endif
      url.value = currentUrl;
      return;
    }
    const methodVal = queryParams["method"];
    if (methodVal != null) {
      method.value = `${methodVal}`;
    }
    const dtVal = queryParams["data_type"];
    if (dtVal != null) {
      data_type.value = `${dtVal}`;
    }
    const riVal = queryParams["request_id"];
    if (riVal != null) {
      request_id.value = `${riVal}`;
    }

    // 只有跳转时带 pageApp=1 才签发票据，并拼到目标地址的 _ticket= 上。
    if (isPageApp != true) {
      url.value = currentUrl;
      return;
    }

    // 网页应用跳转时签发票据，并拼到目标地址的 _ticket= 上。
    // #ifdef MP-WEIXIN
    globalThis.appConfig.redirectUrl = urlStr; // 未解码
    // #endif
    const ticketResult = await apiUserTicketCreate();
    if (ticketResult.code == SUCCESS_CODE && ticketResult.data != null) {
      // 带锚点(#fragment)的 URL 须把 _ticket 插在 # 之前，拼在末尾目标页读不到
      const hashIdx = currentUrl.indexOf("#");
      const baseUrl = hashIdx >= 0 ? currentUrl.substring(0, hashIdx) : currentUrl;
      const hashStr = hashIdx >= 0 ? currentUrl.substring(hashIdx) : "";
      const andStr = baseUrl.includes("?") ? "&" : "?";
      const createdTicket = `${ticketResult.data}`;
      url.value = baseUrl + andStr + `_ticket=${createdTicket}` + hashStr;
    } else {
      url.value = currentUrl;
    }
    // #endif
  };

  onLoad((params: OnLoadOptions) => {
    onLoadInit(params);
    fixAppWebviewTextZoom();
    startIosWebViewSwipeSync();
    startEmbeddedNavSync();
    // #ifdef APP-IOS
    startIosEmbeddedUrlSync();
    // #endif
  });

  // 导航栏返回不走 onBackPress。系统返回键、Android/鸿蒙侧滑走这里。
  // uni.navigateBack 会再次进入本回调，from 为 navigateBack 时必须放行，否则离页被取消。
  // #ifdef APP
  onBackPress((options: OnBackPressOptions): boolean => {
    if (options.from == "navigateBack") {
      return false;
    }
    if (isShareSheetOpen() == true) {
      dismissShareSheet();
      return true;
    }
    return consumeWebViewBack();
  });
  // #endif

  onUnload(() => {
    // #ifdef APP
    stopRepoDocTimer();
    // #endif
    // #ifdef APP-IOS
    stopWebViewTitleRead();
    stopIosEmbeddedUrlSync();
    // #endif
    stopIosWebViewSwipeSync();
    stopEmbeddedNavSync();
  });

  // #ifdef MP-WEIXIN
  // 转发给朋友
  onShareAppMessage(() => {
    const params = getQueryParams(url.value);
    const titleVal = params["title"];
    return {
      title:
        titleVal != null && `${titleVal}`.length > 0
          ? "【" + `${titleVal}` + "】"
          : "【" + t("Mobile.Common.appName") + "】",
      path: "/subpackages/pages/webview/webview?url=" + getSharingLink(),
    } as UTSJSONObject;
  });

  // 收藏
  onAddToFavorites(() => {
    const params = getQueryParams(url.value);
    const titleVal = params["title"];
    return {
      title:
        titleVal != null && `${titleVal}`.length > 0
          ? "【" + `${titleVal}` + "】"
          : "【" + t("Mobile.Common.appName") + "】",
      query: "url=" + getSharingLink(),
    } as UTSJSONObject;
  });
  // #endif
</script>

<style lang="scss" scoped>
  .webview-page {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .webview-nav {
    flex-shrink: 0;
    position: relative;
    z-index: 20;
    background: #fff;
  }

  .webview-back {
    /* px 定值（原 64rpx/-10rpx），折叠屏展开不随屏宽放大 */
    width: 32px;
    height: 32px;
    margin-left: -5px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .webview-share {
    /* 图标仍是 18px。热区扩到 44px，负边距把字形留在原来的位置。 */
    width: 44px;
    height: 44px;
    margin-right: -13px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .webview-content {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
    background-color: #ffffff;
  }

  .web-view {
    width: 100%;
    height: 100%;
  }

  .web-view--hidden {
    position: absolute;
    left: -2000px;
    top: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .webview-placeholder {
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
