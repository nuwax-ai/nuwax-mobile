/** 监控转写的 startedAt 是所属音频段的采集起点，不能按句内 startMs 推断段归属。 */
export function mapMonitoringTranscriptSegments(transcriptStarts: string[], audioStarts: string[]): number[] {
  const result = [] as number[];
  for (let i = 0; i < transcriptStarts.length; i++) {
    if (audioStarts.length == 1) {
      result.push(0);
      continue;
    }
    const start = transcriptStarts[i];
    let match = -1;
    if (start != "") {
      for (let j = 0; j < audioStarts.length; j++) {
        if (audioStarts[j] == start) {
          if (match >= 0) {
            // 起点重复时无法唯一关联，保留文字，避免跳到错误的录音。
            match = -1;
            break;
          }
          match = j;
        }
      }
    }
    result.push(match);
  }
  return result;
}
