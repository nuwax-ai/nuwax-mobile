<template>
  <button class="voice-recorder-container"
    hover-class="hover-class"
    hover-start-time="50"
    @touchstart="handleTouchStart"
    @touchend="handleTouchEnd"
    @touchcancel="cancelRecording"
    @touchmove="handleTouchMove"
    @contextmenu.stop.prevent
    @mousedown.prevent>
    <view v-show="!isTapped">
      <!-- 状态提示文字 -->
      <text class="hover-text" v-if="currentState == 'default'">{{
        t("Mobile.Voice.holdToTalk")
      }}</text>
      <text class="hover-text" v-else-if="currentState == 'recording'">{{
        t("Mobile.Voice.releaseToEnd")
      }}</text>
    </view>
  </button>
</template>

<script lang="uts" setup>
  // #ifdef H5
  import jzRecorder from '@/uni_modules/jz-h5-recorder-manager'
  // #endif

  import { ref, onMounted, onUnmounted } from 'vue';
  import { onShow, onHide } from "@dcloudio/uni-app";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import { streamingAsrService } from "@/subpackages/utils/voice/streamingAsrService";
  import { voiceConfig } from "@/subpackages/utils/voice/voiceConfig";

  const { t: tFn } = useI18n();
  function t(key: string): string {
    return tFn(key, emptyI18nParams(), "");
  }

  // 组件Props类型定义
  interface StreamingVoiceRecorderProps {
    // 最大录音时长 (ms)
    duration?: number
    // 会话是否正在进行中（有消息正在处理）
    isConversationActive?: boolean
  }

  // 录音状态类型（流式识别无上传态：识别随录音进行）
  type RecordState = 'default' | 'recording' | 'finishing'

  const props = defineProps<StreamingVoiceRecorderProps>();

  function getDuration(): number {
    return props.duration != null ? props.duration! : 600000;
  }

  const emit = defineEmits<{
    (e: 'onRecordStart'): void
    // 流式识别文本：text 为累计文本，isFinal 为是否最终（松手/结束时）
    (e: 'onStreamingText', text: string, isFinal: boolean): void
    (e: 'onError', error: any): void
    (e: 'onRecordCancel'): void
  }>()

  // 响应式状态
  const currentState = ref<RecordState>('default')
  // 是否按住
  const isTapped = ref<boolean>(false)

  // #ifdef H5 || WEB
  let h5RecorderManager: any | null = null
  // #endif
  // #ifndef H5
  let nativeRecorderManager: RecorderManager | null = null
  // #endif

  // #ifdef H5 || WEB
  function setH5TouchEndCancelFlag(value: boolean) {
    const rm = h5RecorderManager as UTSJSONObject | null
    if (rm != null) {
      rm["touchEndCancelFlag"] = value
    }
  }
  // #endif

  function callRecorderStop() {
    // #ifdef H5 || WEB
    if (h5RecorderManager != null) {
      (h5RecorderManager as any).stop()
    }
    // #endif
    // #ifndef H5
    if (nativeRecorderManager != null) {
      nativeRecorderManager!.stop()
    }
    // #endif
  }

  function callRecorderStart() {
    const duration = Math.min(getDuration(), 600000)
    // #ifdef H5 || WEB
    if (h5RecorderManager != null) {
      (h5RecorderManager as any).start({
        duration: duration,
        sampleRate: voiceConfig.asrSampleRate,
        numberOfChannels: 1,
        encodeBitRate: 192000,
        format: "mp3",
        frameSize: voiceConfig.asrFrameSize,
      })
    }
    // #endif
    // #ifndef H5
    if (nativeRecorderManager != null) {
      nativeRecorderManager!.start({
        duration: duration,
        sampleRate: voiceConfig.asrSampleRate,
        numberOfChannels: 1,
        encodeBitRate: 192000,
        format: voiceConfig.asrFormat,
        frameSize: voiceConfig.asrFrameSize,
      })
    }
    // #endif
  }

  // 重置状态
  function resetState() {
    currentState.value = 'default'
    isTapped.value = false
  }

  // 录音错误
  function handleRecordError(err: any) {
    streamingAsrService.cancel()
    resetState()
    // #ifdef H5 || WEB
    setH5TouchEndCancelFlag(false)
    // #endif
    emit('onError', err)
  }

  // 取消录音
  function cancelRecording() {
    try {
      callRecorderStop()
    } catch (error: any) {
      console.warn("[StreamingVoice] recorder cancel error", error)
    }
    streamingAsrService.cancel()
    resetState()
    // #ifdef H5 || WEB
    setH5TouchEndCancelFlag(false)
    // #endif
    emit('onRecordCancel')
  }

  // 结束识别会话（独立 async，避免回调里类型不匹配）
  async function finishAsrSession(): Promise<void> {
    try {
      await streamingAsrService.stop()
    } catch (error: any) {
      console.warn("[StreamingVoice] asr stop error", error)
    }
    // #ifdef H5 || WEB
    setH5TouchEndCancelFlag(false)
    // #endif
    resetState()
  }

  // 停止录音并结束识别
  function stopRecording() {
    try {
      callRecorderStop()
    } catch (error: any) {
      console.warn("[StreamingVoice] recorder stop error", error)
    }
    currentState.value = 'finishing'
    finishAsrSession()
  }

  // 录音中结束
  function handleTouchEnd() {
    // #ifdef H5 || WEB
    setH5TouchEndCancelFlag(true)
    // #endif
    isTapped.value = false;
    if (currentState.value == 'finishing') {
      return
    }
    if (currentState.value == 'default') {
      // 快速点按（录音尚未开始）：取消识别会话；start 完成后会检查 isTapped 兜底
      streamingAsrService.cancel()
      uni.hideLoading()
      resetState()
      return
    }
    stopRecording()
  }

  /** H5：仅在事件可取消时 preventDefault，避免 Intervention 警告 */
  function safePreventDefault(e: UniTouchEvent | null) {
    // #ifdef H5 || WEB
    if (e == null) return;
    if (e.cancelable == true) {
      e.preventDefault();
    }
    // #endif
  }

  // 开始录音
  async function handleTouchStart(e: UniTouchEvent) {
    // #ifdef H5 || WEB
    safePreventDefault(e);
    setH5TouchEndCancelFlag(false)
    // #endif

    if (props.isConversationActive == true) {
      emit("onError", new Error(t("Mobile.Voice.conversationActiveError")));
      return
    }
    if (currentState.value != 'default') {
      return
    }

    isTapped.value = true;
    uni.showLoading({
      title: t("Mobile.Voice.connecting"),
    })

    // 先创建识别会话，成功后再启动录音
    const started = await streamingAsrService.start((text: string, isFinal: boolean) => {
      emit('onStreamingText', text, isFinal)
    })
    if (!started) {
      uni.hideLoading()
      resetState()
      emit('onError', new Error(t("Mobile.Voice.recordFailed")))
      return
    }
    // 快速点按：会话创建期间手指已松开，直接取消
    if (isTapped.value == false) {
      streamingAsrService.cancel()
      uni.hideLoading()
      resetState()
      return
    }

    try {
      callRecorderStart()
    } catch (error: any) {
      streamingAsrService.cancel()
      uni.hideLoading()
      resetState()
      emit('onError', error)
    }
  }

  // 监听录音开始
  function handleRecordStart(_res: any | null) {
    if (isTapped.value == false) {
      try {
        callRecorderStop()
      } catch (error: any) {
        console.warn("[StreamingVoice] late recorder start stop error", error)
      }
      return
    }
    currentState.value = 'recording'
    emit('onRecordStart')
    uni.hideLoading()
  }

  // 录音帧回调：App/小程序 为 PCM ArrayBuffer，转 base64 后推给识别服务
  function handleFrameRecorded(res: any | null) {
    if (res == null) return;
    // H5 端 MediaRecorder 帧为 Blob，联调期再适配（mock 模式不依赖帧数据）
    // #ifndef H5
    const resObj = res as UTSJSONObject;
    const fb = resObj["frameBuffer"];
    if (fb == null) return;
    try {
      const base64 = uni.arrayBufferToBase64(fb as ArrayBuffer);
      streamingAsrService.pushFrame(base64);
    } catch (error: any) {
      console.warn("[StreamingVoice] frame convert error", error)
    }
    // #endif
  }

  // 录音自然停止（到达最大时长等）：走与松手相同的结束流程
  function handleRecordStop(_res: any | null) {
    if (currentState.value == 'recording') {
      currentState.value = 'finishing'
      finishAsrSession()
    }
  }

  function bindRecorderEvents() {
    // #ifdef H5 || WEB
    if (h5RecorderManager != null) {
      (h5RecorderManager as any).onStart(handleRecordStart)
      ;(h5RecorderManager as any).onStop(handleRecordStop)
      ;(h5RecorderManager as any).onError(handleRecordError)
      ;(h5RecorderManager as any).onFrameRecorded(handleFrameRecorded)
    }
    // #endif
    // #ifndef H5
    if (nativeRecorderManager != null) {
      nativeRecorderManager!.onStart(handleRecordStart)
      nativeRecorderManager!.onStop(handleRecordStop)
      nativeRecorderManager!.onError(handleRecordError)
      nativeRecorderManager!.onFrameRecorded(handleFrameRecorded)
    }
    // #endif
  }

  function unbindRecorderEvents() {
    // #ifdef H5 || WEB
    if (h5RecorderManager != null) {
      (h5RecorderManager as any).offStart(handleRecordStart)
      ;(h5RecorderManager as any).offStop(handleRecordStop)
      ;(h5RecorderManager as any).offError(handleRecordError)
      ;(h5RecorderManager as any).offFrameRecorded(handleFrameRecorded)
    }
    // #endif
    // #ifndef H5
    if (nativeRecorderManager != null) {
      // uni-app x 的 RecorderManager UTS 声明仅提供无参 off*，调用后清除对应监听。
      nativeRecorderManager!.offStart()
      nativeRecorderManager!.offStop()
      nativeRecorderManager!.offError()
      nativeRecorderManager!.offFrameRecorded()
    }
    // #endif
  }

  function initRecorderManager() {
    // #ifdef H5 || WEB
    if (h5RecorderManager != null) {
      return
    }
    h5RecorderManager = jzRecorder.getRecorderManager()
    // #endif

    // #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || APP
    if (nativeRecorderManager != null) {
      return
    }
    nativeRecorderManager = uni.getRecorderManager()
    // #endif

    bindRecorderEvents()
  }

  // 销毁录音管理器等资源
  function destroyRecorderManager() {
    try {
      callRecorderStop()
    } catch (error: any) {
      console.warn("[StreamingVoice] recorder destroy stop error", error)
    }
    streamingAsrService.cancel()
    resetState()
    unbindRecorderEvents()
    // #ifdef H5 || WEB
    h5RecorderManager = null
    // #endif
    // #ifndef H5
    nativeRecorderManager = null
    // #endif
  }

  function handleTouchMove(e: UniTouchEvent) {
    // #ifdef H5
    // 录音中阻止页面滚动；touchstart 不可取消时不强调 preventDefault
    if (isTapped.value == true || currentState.value == 'recording') {
      safePreventDefault(e);
    }
    // #endif
  }

  // 初始化录音管理器
  onShow(function () {
    // #ifdef MP-WEIXIN || APP
    initRecorderManager()
    // #endif
  })

  // 初始化录音管理器
  onMounted(function () {
    initRecorderManager()
  })

  // 组件卸载时清理资源
  onHide(function () {
    // #ifdef MP-WEIXIN || APP
    destroyRecorderManager()
    // #endif
  })

  // 组件卸载时清理资源
  onUnmounted(function () {
    destroyRecorderManager()
  })
</script>

<style lang="scss" scoped>
  .voice-recorder-container {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 90rpx;
    border-radius: 24rpx;
    transition: all 0.15s ease;
    /* #ifndef APP */
    -webkit-touch-callout: none;
    /* #endif */
    color: #000;
    font-size: 32rpx;
    font-weight: 400;
    background-color: transparent;
    padding: 0; // 删除uni-button默认padding
    /* #ifndef APP */
    user-select: none;
    -webkit-user-select: none;
    touch-action: none; /* 防止系统手势干预 */
    /* #endif */
    border: none;

    &::after {
      border: none !important;
    }

    .hover-text {
      color: #000;
    }

    &.hover-class {
      background-color: rgb(108, 101, 244);
      z-index: 100;

      .hover-text {
        color: #fff;
      }
    }
  }
</style>
