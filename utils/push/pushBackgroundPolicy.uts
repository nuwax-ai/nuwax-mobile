/** Android 后台接收保障的纯策略层：不依赖原生 API，便于 Vitest 覆盖。 */

export type PushSystemVendor =
  | "huawei"
  | "honor"
  | "xiaomi"
  | "oppo"
  | "vivo"
  | "fcm"
  | "none"
  | "unknown";

export type FcmAvailability = "available" | "unavailable" | "unknown";

export class PushBackgroundPolicyInput {
  vendorPushAvailable: boolean
  notificationEnabled: boolean
  batteryOptimizationSupported: boolean
  batteryOptimizationIgnored: boolean | null
  backgroundRestrictedSupported: boolean
  backgroundRestricted: boolean | null
  manualSetupAcknowledged: boolean

  constructor(
    vendorPushAvailable: boolean,
    notificationEnabled: boolean,
    batteryOptimizationSupported: boolean,
    batteryOptimizationIgnored: boolean | null,
    backgroundRestrictedSupported: boolean,
    backgroundRestricted: boolean | null,
    manualSetupAcknowledged: boolean,
  ) {
    this.vendorPushAvailable = vendorPushAvailable;
    this.notificationEnabled = notificationEnabled;
    this.batteryOptimizationSupported = batteryOptimizationSupported;
    this.batteryOptimizationIgnored = batteryOptimizationIgnored;
    this.backgroundRestrictedSupported = backgroundRestrictedSupported;
    this.backgroundRestricted = backgroundRestricted;
    this.manualSetupAcknowledged = manualSetupAcknowledged;
  }
}

function normalizedDeviceName(value: string): string {
  return value.trim().toLowerCase();
}

function containsAny(value: string, candidates: string[]): boolean {
  for (let i = 0; i < candidates.length; i++) {
    if (value.indexOf(candidates[i]) >= 0) return true;
  }
  return false;
}

/**
 * 识别项目已配置/明确排除的 Android OEM 系统推送通道。
 * 返回 none 只表示未命中 OEM；是否有 FCM 由 resolvePushSystemVendor 再判。
 */
export function classifyOemPushVendor(manufacturer: string, brand: string): PushSystemVendor {
  const source = `${normalizedDeviceName(manufacturer)} ${normalizedDeviceName(brand)}`;
  if (containsAny(source, ["huawei"])) return "huawei";
  if (containsAny(source, ["honor"])) return "honor";
  if (containsAny(source, ["xiaomi", "redmi", "poco"])) return "xiaomi";
  if (containsAny(source, ["oppo", "realme", "oneplus"])) return "oppo";
  if (containsAny(source, ["vivo", "iqoo"])) return "vivo";
  return "none";
}

/** OEM 优先；未命中 OEM 时才以 Google Play Services 可用性判断 FCM。 */
export function resolvePushSystemVendor(
  manufacturer: string,
  brand: string,
  fcmAvailability: FcmAvailability,
): PushSystemVendor {
  const oem = classifyOemPushVendor(manufacturer, brand);
  if (oem != "none") return oem;
  if (fcmAvailability == "available") return "fcm";
  if (fcmAvailability == "unavailable") return "none";
  return "unknown";
}

/**
 * 与 UI 无关的状态计算；vendor=unknown 时调用方不进入本策略。
 *
 * ★只看**可测项**：三项（通知权限 / 电池优化白名单 / 后台限制）全部通过即视为已优化。
 *   不可测的开关（厂商「自启动」「休眠应用」等）不参与判定——否则用户在系统设置里
 *   全部放开、回到 App 仍显示「需要设置」（2026-11-12 真机反馈）。
 *   `manualSetupAcknowledged` 只用于抑制「登录后的自动引导」弹窗（见 pushBackgroundGuide），
 *   不影响这里的结论，也不影响「我的」页状态展示。
 */
export function computeManualSettingsRequired(input: PushBackgroundPolicyInput): boolean {
  if (input.vendorPushAvailable) return false;
  if (!input.notificationEnabled) return true;
  if (
    input.batteryOptimizationSupported &&
    input.batteryOptimizationIgnored != true
  ) return true;
  if (
    input.backgroundRestrictedSupported &&
    input.backgroundRestricted == true
  ) return true;
  return false;
}
