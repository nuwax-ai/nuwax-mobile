<template>
  <!-- 总开关关闭 = 平台退化为原生 tabBar，组件不渲染、不拦截 -->
  <view v-if="CUSTOM_TAB_BAR_ENABLED" class="ctb-root" :class="mountMode == 'fixed' ? 'ctb-root--fixed' : 'ctb-root--flow'">
    <!-- fixed 挂载形态：文档流占位（栏体 + 凸起 + 安全区），避免 fixed 栏遮挡内容 -->
    <view v-if="mountMode == 'fixed'" class="ctb-spacer" :style="spacerStyle"></view>

    <view class="ctb-bar" :class="mountMode == 'fixed' ? 'ctb-bar--fixed' : ''" :style="barSafeStyle">
      <view
        v-for="slot in slots"
        :key="slot.visualIndex"
        class="ctb-item"
        :class="[slot.kind == 'plus' ? 'ctb-item--plus' : '', isActive(slot) ? 'ctb-item--active' : '']"
        :hover-class="slot.kind == 'plus' ? 'ctb-item-plus-pressed' : 'ctb-item-pressed'"
        @click="handleSlotTap(slot)"
      >
        <!-- 实槽：图标 + 文字 -->
        <template v-if="slot.kind != 'plus'">
          <view class="ctb-icon-wrap">
            <image class="ctb-icon" :src="iconOf(slot, isActive(slot))" mode="aspectFit" alt="" />
            <!-- 「我的」槽未读徽标 -->
            <view v-if="slot.kind == 'mine' && unreadCount > 0" class="ctb-badge">
              <text class="ctb-badge-text">{{ badgeText }}</text>
            </view>
          </view>
          <text class="ctb-label">{{ t(slot.i18nKey) }}</text>
        </template>
        <!-- ➕ 动作槽：品牌色圆形底 + 白色加号 -->
        <view v-else class="ctb-plus-circle">
          <svg-icon name="icon-Plus" size="48" color="#ffffff" />
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import {
    CUSTOM_TAB_BAR_ENABLED,
    CUSTOM_TAB_BAR_MODE,
    PLUS_ACTION_ENABLED,
    PLUS_ACTION_TARGET_PATH,
    PLUS_ACTION_TOAST_KEY,
    type CustomTabBarMount,
    type CustomTabSlotKind,
  } from "@/constants/customTabBar.constants";
  import { getCustomTabSlots, type CustomTabSlotConfig } from "./app-tab-bar.config";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { isTabPage } from "@/utils/commonBusiness";
  import { systemMessageUnreadCount } from "@/utils/notificationBadge";

  // tab 槽图标（与 pages.json tabBar.list / 原原生栏同源的 8 张静态图）
  import iconHome from "@/static/assets/icon_home.png";
  import iconHomeActive from "@/static/assets/icon_home_active.png";
  import iconTerminal from "@/static/assets/icon_terminal.png";
  import iconTerminalActive from "@/static/assets/icon_terminal_active.png";
  import iconUnionRecord from "@/static/assets/icon_union_record.png";
  import iconUnionRecordActive from "@/static/assets/icon_union_record_active.png";
  import iconAgent from "@/static/assets/icon_agent.png";
  import iconAgentActive from "@/static/assets/icon_agent_active.png";
  import iconMine from "@/static/assets/icon_mine.png";
  import iconMineActive from "@/static/assets/icon_mine_active.png";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const slots: Array<CustomTabSlotConfig> = getCustomTabSlots();

  interface CustomTabBarProps {
    /** 本页所在视觉槽序号：index=0 / terminal·union=1 / agent=3 / mine=4（页面静态自高亮） */
    active: number;
  }

  const props = defineProps<CustomTabBarProps>();

  const emit = defineEmits<{
    /** 点击页面槽（kind 不含 plus）；父页可拦截，未拦截则组件自行 switchTab */
    (e: "slot", kind: CustomTabSlotKind, pagePath: string): void;
    /** 点击 ➕ 动作槽；父页可接管，未接管则走占位 toast / PLUS_ACTION_TARGET_PATH */
    (e: "plus"): void;
  }>();

  /** 挂载形态读全局配置（H5=fixed、其余 in-flow）；需要形态差异时改 CUSTOM_TAB_BAR_MODE 即可 */
  const mountMode: CustomTabBarMount = CUSTOM_TAB_BAR_MODE;

  const isActive = (slot: CustomTabSlotConfig): boolean => {
    return slot.visualIndex == props.active;
  };

  /** 图标逻辑名 → 静态资源映射（key 为 iconName / activeIconName） */
  const iconMap = new Map<string, string>([
    ["home", iconHome],
    ["home_active", iconHomeActive],
    ["terminal", iconTerminal],
    ["terminal_active", iconTerminalActive],
    ["union_record", iconUnionRecord],
    ["union_record_active", iconUnionRecordActive],
    ["agent", iconAgent],
    ["agent_active", iconAgentActive],
    ["mine", iconMine],
    ["mine_active", iconMineActive],
  ]);

  const iconOf = (slot: CustomTabSlotConfig, active: boolean): string => {
    const key = active ? slot.activeIconName : slot.iconName;
    const src = iconMap.get(key);
    return src != null ? src : "";
  };

  // 「我的」未读徽标：直接渲染 notificationBadge 已维护的响应式未读数
  const unreadCount = computed((): number => systemMessageUnreadCount.value);
  const badgeText = computed((): string => {
    const count = systemMessageUnreadCount.value;
    return count > 99 ? "99+" : `${count}`;
  });

  /**
   * 底部安全区（px）。App 端 env() 不可靠，内联注入；
   * H5 / MP 交由 CSS env(safe-area-inset-bottom)（barSafeStyle 置空）。
   */
  const barSafeStyle = computed((): string => {
    // #ifdef APP
    try {
      const sys = uni.getSystemInfoSync();
      const safe = sys.safeAreaInsets != null ? sys.safeAreaInsets.bottom : 0;
      const bottom = safe != null && safe > 0 ? safe : 0;
      return `padding-bottom: ${bottom}px;`;
    } catch (_e) {
      return "";
    }
    // #endif
    // #ifndef APP
    return "";
    // #endif
  });

  /** fixed 形态下 spacer 的内联高度（仅 APP 自定义 fixed 时用；H5/MP 走 CSS env） */
  const spacerStyle = computed((): string => {
    // #ifdef APP
    if (mountMode != "fixed") {
      return "";
    }
    try {
      const sys = uni.getSystemInfoSync();
      const safe = sys.safeAreaInsets != null ? sys.safeAreaInsets.bottom : 0;
      const bottom = safe != null && safe > 0 ? safe : 0;
      const width = sys.windowWidth != null && sys.windowWidth > 0 ? sys.windowWidth : 375;
      const px = (rpx: number): number => (rpx * width) / 750;
      const height = Math.ceil(px(48) + px(96) + bottom); // 凸起 48 + 栏体 96 + 安全区
      return `height: ${height}px;`;
    } catch (_e) {
      return "";
    }
    // #endif
    // #ifndef APP
    return "";
    // #endif
  });

  function handlePlusTap(): void {
    emit("plus");
    if (PLUS_ACTION_ENABLED == true && PLUS_ACTION_TARGET_PATH.length > 0) {
      if (isTabPage(PLUS_ACTION_TARGET_PATH)) {
        uni.switchTab({ url: PLUS_ACTION_TARGET_PATH });
      } else {
        uni.navigateTo({ url: PLUS_ACTION_TARGET_PATH });
      }
      return;
    }
    uni.showToast({ title: t(PLUS_ACTION_TOAST_KEY), icon: "none" });
  }

  function handleSlotTap(slot: CustomTabSlotConfig): void {
    if (slot.kind == "plus") {
      handlePlusTap();
      return;
    }
    emit("slot", slot.kind, slot.pagePath);
    // 自绘模式：原生 tabBar 常隐；switchTab 后在目标页 onShow 之外再补一次 hide，压掉可能的闪现
    uni.switchTab({
      url: slot.pagePath,
      success: (): void => {
        if (CUSTOM_TAB_BAR_ENABLED == true) {
          uni.hideTabBar({ animation: false });
        }
      },
      fail: (_err: any): void => {
        // ignore：目标页缺失等场景交由框架提示
      },
    });
  }
</script>

<style lang="scss" scoped>
  $ctb-primary: #5147ff;
  $ctb-inactive: #666666;
  $ctb-icon-size: 46rpx;
  $ctb-label-size: 20rpx;
  $ctb-plus-size: 96rpx;
  $ctb-plus-overhang: 48rpx; // 凸起量 = 圆形半径（中心对齐栏体上沿）

  .ctb-root {
    /* 不设 overflow:hidden，否则 ➕ 凸起会被裁剪（uni-app x view 默认裁剪行为较严，显式放开） */
    flex-shrink: 0;
    overflow: visible;
    /* 显式提升到内容层之上：App 端原生 list-view/列表内容层级高于普通视图，
       否则 ➕ 探出栏体的上半圆会被列表内容盖住（凸起被“遮挡”） */
    position: relative;
    z-index: 20;
  }

  .ctb-root--flow {
    /* in-flow：页面根 flex-col 的最后一个子节点，由内容自然撑高 */
    /* 顶部预留 ➕ 凸起区：uni-app x 原生 list-view 层级高于普通 view（z-index 无效），
       若 ➕ 探入列表可视区会被列表盖住。预留后内容区底部停在 ➕ 之上，二者不再重叠。 */
    padding-top: $ctb-plus-overhang;
  }

  .ctb-root--fixed {
    /* fixed 由子栏体 .ctb-bar--fixed + .ctb-spacer 承担布局 */
  }

  .ctb-bar {
    position: relative;
    z-index: 20;
    /* 凸起的 ➕ 需要探出栏体上沿：显式允许溢出，禁止裁剪 */
    overflow: visible;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    background-color: #ffffff;
    /* 底部安全区：App 内联 px；H5/MP 走 env */
    /* #ifdef H5 || WEB || MP-WEIXIN */
    padding-bottom: env(safe-area-inset-bottom);
    /* #endif */
  }

  .ctb-bar--fixed {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
  }

  /* fixed 形态占位：凸起 48rpx + 栏体 96rpx + 安全区（H5/MP 用 env，真机无 env 时退化为固定 148rpx） */
  .ctb-spacer {
    height: 148rpx;
  }
  /* #ifdef H5 || WEB || MP-WEIXIN */
  .ctb-spacer {
    height: calc(148rpx + env(safe-area-inset-bottom));
  }
  /* #endif */

  .ctb-item {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 14rpx;
    padding-bottom: 10rpx;
    overflow: visible;
  }

  .ctb-item-pressed {
    opacity: 0.7;
  }

  .ctb-icon-wrap {
    position: relative;
    width: $ctb-icon-size;
    height: $ctb-icon-size;
  }

  .ctb-icon {
    width: 100%;
    height: 100%;
  }

  .ctb-label {
    margin-top: 4rpx;
    font-size: $ctb-label-size;
    line-height: 1.2;
    color: $ctb-inactive;
  }

  .ctb-item--active {
    .ctb-label {
      color: $ctb-primary;
    }
  }

  /* ➕ 动作槽：圆形底凸起（中心对齐栏体上沿，上半圆探出到内容区） */
  .ctb-item--plus {
    padding: 0;
  }

  .ctb-plus-circle {
    position: absolute;
    top: -$ctb-plus-overhang;
    left: 50%;
    width: $ctb-plus-size;
    height: $ctb-plus-size;
    margin-left: -48rpx; /* = $ctb-plus-size / 2 */
    border-radius: 50%;
    background-color: $ctb-primary;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 20rpx rgba(81, 71, 255, 0.35);
  }

  .ctb-item-plus-pressed {
    .ctb-plus-circle {
      transform: scale(0.94);
    }
  }

  /* 「我的」未读徽标：贴图标右上角，对齐 mine 页 row-badge 视觉 */
  .ctb-badge {
    position: absolute;
    top: -6rpx;
    right: -10rpx;
    min-width: 28rpx;
    height: 28rpx;
    padding: 0 6rpx;
    border-radius: 100rpx;
    background-color: #ff4d4f;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .ctb-badge-text {
    color: #ffffff;
    font-size: 18rpx;
    line-height: 1;
  }
</style>
