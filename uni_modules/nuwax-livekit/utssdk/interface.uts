/**
 * 会议 RTC（LiveKit）桥接的公共类型 —— 三端接口一致，业务层只认这一份。
 *
 * <h2>谁在用</h2>
 * <p>业务侧唯一入口是 `utils/meeting/meetingMedia.uts`；页面不直接 import 本插件，
 * 这样换实现（Android/iOS 接 LiveKit、鸿蒙自研 LiveKitClient）时页面零改动。</p>
 *
 * <h2>★★能力语义</h2>
 * <p>{@link NuwaxLiveKitSupportedApi} 返回 false 时，业务层必须把它当成"本端不能开会"：
 * 不发令牌、不改开关状态、界面如实提示接入中。**绝不允许在未连接时伪造 connected=true**。</p>
 *
 * <h2>为什么参数平铺而不是传对象</h2>
 * <p>对象要跨模块共享同一个 class；uni-app x 的插件根导出以平台 index.uts 为准，
 * 传 class 会引入"这个 class 到底从哪导出"的隐患。入会参数只有 6 个原始值，平铺最稳，
 * 原生桥接侧也不需要解析 model。</p>
 */

/**
 * 状态回报。
 * @param connected 是否已连上房间
 * @param connecting 是否正在连接
 * @param people 房间内人数（含本端；0 = 未知/未连接）
 * @param error 失败码（空串=无错）。已定义：`livekit_sdk_missing`（插件未接 SDK）、
 *        `harmony_rtc_unsupported`（鸿蒙无 RTC 客户端）、`connect`（SDK 连接失败）、
 *        `exception`（插件内部异常）
 */
export type NuwaxLiveKitStateCallback = (
  connected: boolean,
  connecting: boolean,
  people: number,
  error: string,
) => void;

/** 本端能否真正收发音视频（false ⇒ 只提供会议信息能力）。 */
export type NuwaxLiveKitSupportedApi = () => boolean;

/**
 * 连接已有房间（**不建房**）。
 * @param serverUrl LiveKit 连接地址（服务端下发，wss:// 或 ws://）
 * @param token 入会令牌（JWT，identity=tenant:user:platform）
 * @param room 会议号（= LiveKit 房间名）
 * @param displayName 展示名（写 participant name，不落库）
 * @param micOn 入会即开麦（PC 口径默认 true）
 * @param cameraOn 入会即开摄像头（默认 false）
 */
export type NuwaxLiveKitConnectApi = (
  serverUrl: string,
  token: string,
  room: string,
  displayName: string,
  micOn: boolean,
  cameraOn: boolean,
) => void;

/**
 * ★★为什么不给 connect 挂回调（2026-11-15 定）
 *
 * <p>UTS 的函数类型跨到 Swift 会变成 `UTSCallback`，在 iOS 上编译报
 * `'UTSCallback' is unavailable`（Swift 侧拿不到类声明），加多少参数都对不齐。
 * 所以连接结果改为**状态查询**：连接发起后，由业务层轮询 {@link NuwaxLiveKitStateQuery}
 * 拿到 connected / error，三端接口完全一致，也不再有回调生命周期（keepAlive）问题。</p>
 */
export type NuwaxLiveKitStateQuery = () => boolean;

/** 离开：只断本端，不删房（结束会议是主持人动作）。 */
export type NuwaxLiveKitLeaveApi = () => void;

/** 麦克风采集开关。 */
export type NuwaxLiveKitSetMicApi = (on: boolean) => void;

/** 摄像头采集开关（关闭时销毁渲染，不保留最后一帧）。 */
export type NuwaxLiveKitSetCameraApi = (on: boolean) => void;

/** 音频输出路由：true=扬声器，false=听筒/耳机。 */
export type NuwaxLiveKitSetSpeakerApi = (on: boolean) => void;

/** 当前远端人数（含本端；未连接返回 0）。 */
export type NuwaxLiveKitPeopleApi = () => number;

/** 房间 metadata 原始 JSON（服务端写入，所有端按同一协议解析）。 */
export type NuwaxLiveKitRoomMetadataApi = () => string;

/** 举手 / 放下手：写入本地 participant attributes.handRaised。 */
export type NuwaxLiveKitSetHandRaisedApi = (on: boolean) => void;

/** 查询本地 participant 是否举手。 */
export type NuwaxLiveKitLocalHandRaisedApi = () => boolean;

/** 入会后配置后台共享收尾；token 只驻留内存，不传给广播扩展。 */
export type NuwaxLiveKitConfigureBackgroundSessionApi = (releaseURL: string, token: string) => void;
/** 页面卸载仅释放渲染器，媒体会话和采集保持。 */
export type NuwaxLiveKitReleaseMeetingPageViewsApi = () => void;
export type NuwaxLiveKitIsScreenShareStoppingApi = () => boolean;
export type NuwaxLiveKitSetMeetingPresentationApi = (pageVisible: boolean, foreground: boolean) => void;
export type NuwaxLiveKitConsumeMeetingRestoreRequestApi = () => boolean;
