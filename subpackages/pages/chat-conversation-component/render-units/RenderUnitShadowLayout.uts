import { ConversationLayoutIndex } from "./ConversationLayoutIndex.uts";
import { buildMessageRenderUnits } from "./MessageRenderUnitBuilder.uts";
import { RenderUnitLayoutSignature, RenderUnitRange } from "./RenderUnitModels.uts";

class MessageUnitSpan {
  start: number = 0;
  end: number = 0;
}

/** 生产列表旁路索引：不参与 DOM，只用消息实测高度校准 Unit 数学并输出对账指标。 */
export class RenderUnitShadowLayout {
  readonly index: ConversationLayoutIndex = new ConversationLayoutIndex();
  private signature: RenderUnitLayoutSignature = new RenderUnitLayoutSignature();
  private spanByMessage: Map<string, MessageUnitSpan> = new Map<string, MessageUnitSpan>();

  constructor() {
    this.signature.platform = "android";
    this.signature.fontScale = 1;
    this.signature.rendererVersion = "render-unit-shadow-v1";
    this.signature.expandedState = "mixed";
  }

  sync(messages: any[], liveMessageKey: string, viewportWidth: number): void {
    this.signature.viewportWidth = viewportWidth;
    const units = buildMessageRenderUnits(messages, liveMessageKey);
    this.index.setUnits(units);
    const spans = new Map<string, MessageUnitSpan>();
    for (let i = 0; i < units.length; i++) {
      const key = units[i].messageGroupKey;
      const existing = spans.get(key);
      if (existing == null) {
        const span = new MessageUnitSpan();
        span.start = i;
        span.end = i + 1;
        spans.set(key, span);
      } else {
        existing.end = i + 1;
      }
    }
    this.spanByMessage = spans;
  }

  /** 把旧消息行的真实高度按估算权重分摊，保证 Unit 聚合高度与现网一致。 */
  reconcileMessageHeight(messageGroupKey: string, measuredHeight: number): number {
    if (measuredHeight <= 0) return 0;
    const span = this.spanByMessage.get(messageGroupKey);
    if (span == null) return 0;
    let estimateTotal = 0;
    for (let i = span.start; i < span.end; i++) {
      const unit = this.index.unitAt(i);
      if (unit != null) {
        estimateTotal = estimateTotal + unit.effectiveHeight();
      }
    }
    if (estimateTotal <= 0) return 0;
    let committed = 0;
    for (let i = span.start; i < span.end; i++) {
      const unit = this.index.unitAt(i);
      if (unit != null) {
        const target = measuredHeight * unit.effectiveHeight() / estimateTotal;
        committed = committed + this.index.commitHeight(
          unit.key, unit.layoutVersion, target, this.signature,
        );
      }
    }
    return committed;
  }

  range(scrollTop: number, viewportHeight: number, overscan: number): RenderUnitRange {
    return this.index.rangeBetween(
      Math.max(0, scrollTop - overscan),
      Math.max(0, scrollTop + viewportHeight + overscan),
    );
  }
}
