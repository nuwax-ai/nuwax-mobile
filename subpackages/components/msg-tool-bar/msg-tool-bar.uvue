<template>
	<view class="tool-bar-container">
		<svg-icon name="icon-Copy" customClass="btn" @click="copy" />
		<view
			class="speech-btn"
			:class="{ 'speech-btn--active': isSpeaking }"
			@click.stop.prevent="toggleSpeech"
		>
			<uni-icons
				:type="isSpeaking && speechFrame ? 'sound-filled' : 'sound'"
				size="36rpx"
				:color="isSpeaking ? '#5147ff' : '#333333'"
			/>
		</view>
		<text class="time">{{createTime}}</text>
	</view>
</template>

<script lang="uts" setup>
	import { ref, computed, onMounted, onUnmounted } from "vue";
	import { MsgItem } from '@/types/interfaces/ai-msg';
	import { formatTimeAgo } from '@/utils/common';
	import { useI18n, emptyI18nParams } from '@/utils/i18n';
	import { cleanTextForSpeech } from "@/subpackages/utils/voice/textFilter";
	import { loadVoiceSettings } from "@/subpackages/utils/voice/voiceTypes";
	import {
		ttsWebSocketPlayer,
		type TtsPlaybackState,
	} from "@/subpackages/utils/voice/ttsWebSocketPlayer";

	const { t: tFn } = useI18n();
	const t = (key: string): string => tFn(key, emptyI18nParams(), "");

	// 使用 ref 来存储时间，自动更新时间
	const createTime = ref<string>('')
	const isSpeaking = ref<boolean>(false)
	const speechFrame = ref<boolean>(false)
	let ttsListenerId: number = 0
	let speechAnimationTimer: number | null = null

	const props = withDefaults(defineProps<{
		msg: MsgItem
		speakText?: string
	}>(), {
		speakText: "",
	})

	const msg = computed<MsgItem>(() => props.msg as MsgItem)

	// 更新时间的函数
	const updateTime = () => {
		const ts = msg.value.create_time;
		if (ts <= 0) {
			createTime.value = '';
			return;
		}
		createTime.value = formatTimeAgo(new Date(ts).toISOString());
	}

	// 定时器 ID（ref 避免 closure smart cast 问题）
	const timerId = ref<number | null>(null)

	// 启动定时器，每分钟更新一次
	const startTimer = () => {
		updateTime()
		timerId.value = setInterval(() => {
			updateTime()
		}, 60000) as number
	}

	// 停止定时器
	const stopTimer = () => {
		const id = timerId.value
		if (id != null) {
			clearInterval(id)
			timerId.value = null
		}
	}

	const startSpeechAnimation = (): void => {
		if (speechAnimationTimer != null) {
			return
		}
		speechFrame.value = true
		speechAnimationTimer = setInterval(() => {
			speechFrame.value = !speechFrame.value
		}, 420) as number
	}

	const stopSpeechAnimation = (): void => {
		const timer = speechAnimationTimer
		if (timer != null) {
			clearInterval(timer)
			speechAnimationTimer = null
		}
		speechFrame.value = false
	}

	onMounted(() => {
		startTimer()
		ttsListenerId = ttsWebSocketPlayer.subscribe(
			(state: TtsPlaybackState, messageId: string): void => {
				isSpeaking.value =
					messageId == msg.value._id &&
					(state == "connecting" ||
						state == "synthesizing" ||
						state == "playing")
				if (isSpeaking.value) {
					startSpeechAnimation()
				} else {
					stopSpeechAnimation()
				}
			},
		)
	})

	onUnmounted(() => {
		stopTimer()
		stopSpeechAnimation()
		if (ttsListenerId > 0) {
			ttsWebSocketPlayer.unsubscribe(ttsListenerId)
			ttsListenerId = 0
		}
	})

	const copy = () => {
		const text = msg.value.body
		if (text.length == 0) {
			uni.showToast({
				title: t('Mobile.ThirdParty.UniAiX.invalidMessageContent'),
				icon: 'none',
			})
			return
		}
		uni.setClipboardData({
			data: text,
			success: () => {
				uni.showToast({
					title: t('Mobile.Common.copySuccess'),
					icon: 'success',
				})
			},
			fail: () => {
				uni.showToast({
					title: t('Mobile.Common.copyFailed'),
					icon: 'none',
				})
			}
		})
	}

	/** 将播报诊断文本转为单行，避免 UTS 在异步函数内解析正则表达式失败。 */
	const formatSpeechLogText = (text: string): string => {
		return text.split("\r").join("\\r").split("\n").join("\\n")
	}

	/** 播报或停止当前 AI 消息。 */
	const toggleSpeech = async (): Promise<void> => {
		const messageId = msg.value._id
		if (
			isSpeaking.value &&
			ttsWebSocketPlayer.getMessageId() == messageId
		) {
			ttsWebSocketPlayer.stop()
			return
		}
		const settings = loadVoiceSettings()
		const sourceText =
			props.speakText.length > 0 ? props.speakText : msg.value.body
		const sourceLogText = formatSpeechLogText(sourceText)
		console.log(
			"[TTS] toolbar.source messageId=" +
				messageId +
				" textLen=" +
				sourceText.length +
				" text=" +
				sourceLogText
		)
		const speakableText = cleanTextForSpeech(
			sourceText,
			settings,
		)
		const speakableLogText = formatSpeechLogText(speakableText)
		console.log(
			"[TTS] toolbar.cleaned messageId=" +
				messageId +
				" textLen=" +
				speakableText.length +
				" text=" +
				speakableLogText
		)
		if (speakableText.length == 0) {
			uni.showToast({
				title: t("Mobile.Voice.noSpeakableContent"),
				icon: "none",
			})
			return
		}
		try {
			await ttsWebSocketPlayer.play(messageId, speakableText)
		} catch (error: any) {
			console.error("[TTS] start failed", error)
		}
	}
</script>

<style lang="scss">
	.tool-bar-container {
		width: 100%;
		padding: 8rpx 0 16rpx 0;
		margin-top: 16rpx;
		display: flex;
		flex-direction: row;
		align-items: center;

		.btn {
			font-size: 36rpx;
			margin-right: 32rpx;
			// #ifndef APP
			cursor: pointer;
			&:hover {
				filter: brightness(0.8);
			}
			// #endif
		}

		.speech-btn {
			width: 48rpx;
			height: 48rpx;
			margin-right: 32rpx;
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			border-radius: 50%;
		}

		.speech-btn--active {
			background-color: rgba(81, 71, 255, 0.1);
		}

		.time {
			margin-left: auto;
			font-size: 28rpx;
			color: rgba(0, 0, 0, 0.45);
			font-weight: 400;
		}
	}
</style>
