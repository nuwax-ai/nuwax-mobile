<template>
  <view class="vh-page">
    <custom-nav-bar :title="t('Mobile.VoiceNote.history')" showBack hasSafetyZone interceptBack backgroundColor="#f4f5f7" @back="handleBack" />
    <scroll-view
      class="vh-list"
      scroll-y="true"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      @refresherrefresh="handleRefresh"
      @scrolltolower="loadMore"
    >
      <!-- 点卡片进详情。文档名和各个按钮单独 stop，按钮之间的空白仍进详情。 -->
      <view v-for="item in records" :key="item.id" class="vh-card" @click="openDetail(item)">
        <view class="vh-card__head">
          <text class="vh-card__title">{{ item.title }}</text>
          <!-- 状态固定在标题右侧，不随标题换行挤掉 -->
          <text v-if="statusLabel(item.status).length > 0" class="vh-card__status">{{ statusLabel(item.status) }}</text>
        </view>
        <!-- recordedAt 由列表 created 转成本地时间 -->
        <text class="vh-card__meta">{{ durationMeta(item.duration, item.recordedAt) }}</text>
        <view v-if="item.docLabel.length > 0" class="vh-card__file" @click.stop="handleDownload(item)">
          <svg-icon name="icon-a-Filetext" size="16" unit="px" color="#7a78e6" />
          <text class="vh-card__path">{{ item.docLabel }}</text>
        </view>
        <view class="vh-card__actions">
          <view v-if="item.status == 'SUCCESS'" class="vh-card__btn" @click.stop="handlePlay(item)">
            <view v-if="playingId == item.id" class="vh-card__stop"></view>
            <svg-icon v-else name="icon-video-play" size="16" unit="px" color="#666666" />
            <text class="vh-card__btn-text">{{ playingId == item.id ? t("Mobile.VoiceNote.stopPlayback") : t("Mobile.VoiceNote.play") }}</text>
          </view>
          <view v-if="item.status == 'SUCCESS'" class="vh-card__btn" hover-class="vh-card__btn--active" @click.stop="handleDownload(item)">
            <svg-icon name="icon-eye-open" size="16" unit="px" color="#666666" />
            <text class="vh-card__btn-text">{{ t("Mobile.VoiceNote.document") }}</text>
          </view>
          <view v-if="canReprocess(item.status)" class="vh-card__btn" hover-class="vh-card__btn--active" @click.stop="handleReprocess(item)">
            <spin-loading v-if="isReprocessing(item.id)" size="14px" color="#666666" :duration-ms="800" />
            <svg-icon v-else name="icon-restart" size="16" unit="px" color="#666666" />
            <text class="vh-card__btn-text">{{ reprocessLabel(item.status) }}</text>
          </view>
          <view v-if="canDownloadAudio(item.status)" class="vh-card__btn" hover-class="vh-card__btn--active" @click.stop="handleAudioFiles(item)">
            <spin-loading v-if="isAudioLoading(item.id)" size="14px" color="#666666" :duration-ms="800" />
            <svg-icon v-else name="icon-msg-download" size="16" unit="px" color="#666666" />
            <text class="vh-card__btn-text">{{ t("Mobile.VoiceNote.downloadAudio") }}</text>
          </view>
          <view v-if="item.id != recordingNoteId" class="vh-card__btn" hover-class="vh-card__btn--active" @click.stop="handleDelete(item)">
            <spin-loading v-if="isDeleting(item.id)" size="14px" color="#666666" :duration-ms="800" />
            <text :class="['vh-card__btn-text', isDeleting(item.id) ? '' : 'vh-card__btn-text--plain']">{{ t("Mobile.Common.delete") }}</text>
          </view>
        </view>
      </view>
      <view v-if="records.length > 0" class="vh-footer">
        <text class="vh-footer__text">{{ footerText }}</text>
      </view>
      <view v-else-if="listLoaded" class="vh-empty">
        <empty-state :text="t('Mobile.VoiceNote.empty')" />
      </view>
    </scroll-view>
    <uni-modal-popup
      ref="audioSheetRef"
      position="bottom"
      :height="audioSheetHeight"
      :show-header="false"
      :body-scroll="false"
      :mask-click="true"
      :close-on-slide-down="true"
      :duration="300"
      @afterleave="onAudioSheetClosed"
    >
      <view class="vh-sheet">
        <text class="vh-sheet__title">{{ audioSheetTitle }}</text>
        <scroll-view v-if="audioFiles.length > 0" class="vh-sheet__list" scroll-y="true">
          <view v-for="file in audioFiles" :key="file.segmentIndex" class="vh-sheet__row" @click="downloadAudioFile(file)">
            <view class="vh-sheet__meta">
              <text class="vh-sheet__name">{{ segmentLabel(file.segmentIndex) }}</text>
              <text class="vh-sheet__duration">{{ file.duration }}</text>
            </view>
            <spin-loading v-if="isDownloading(file.audioUrl)" size="14px" color="#666666" :duration-ms="800" />
            <text v-else class="vh-sheet__action">{{ t("Mobile.VoiceNote.download") }}</text>
          </view>
        </scroll-view>
        <text v-else class="vh-sheet__empty">{{ t("Mobile.VoiceNote.noAudio") }}</text>
        <view class="vh-sheet__close" @click="closeAudioSheet">
          <text class="vh-sheet__close-text">{{ t("Mobile.VoiceNote.close") }}</text>
        </view>
      </view>
    </uni-modal-popup>
  </view>
</template>

<script setup lang="uts">
/**
 * 录音历史。
 * 列表：POST /api/voice/note/list，按 noteId 游标翻页。
 * 卡片：标题右侧显示状态，下方是时长和 created 转成的本地时间。
 * 操作：已完成可看文档；转写失败、文档失败、文档已删除可重试；
 * 转写中、部分转写失败、文档失败、已完成可下载录音；删除走确认框。正在录音的那条不显示删除。
 */
import { type ComponentPublicInstance } from "vue";
import { apiVoiceNoteAudioFiles, apiVoiceNoteDelete, apiVoiceNoteDetail, apiVoiceNoteList, apiVoiceNoteReprocess } from "@/servers/voiceNote.uts";
import { backfillVoiceNoteByNoteId, completeOrphanUploadingNote, deleteCachedVoiceNoteFiles, orphanUploadNeedsComplete, startBackfill } from "@/utils/voice-note/voiceNoteEngine.uts";
import { loadRecordingNoteId } from "@/utils/voice-note/voiceNoteStore.uts";
import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
import EmptyState from "@/components/empty-state/empty-state.uvue";
import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
import SpinLoading from "@/subpackages/components/spin-loading/spin-loading.uvue";
import { navigateToPageOnce } from "@/utils/system";
// #ifdef APP
import { downloadFileInApp } from "@/subpackages/utils/fileTree";
// #endif

/** 列表一行。字段已从接口行转成展示用的字符串。 */
type VoiceRecordHistoryItem = {
  /** noteId */
  id: string;
  /** 标题；接口为空时显示「语音笔记」 */
  title: string;
  /** totalDurationMs 格式化后的 mm:ss；接口为 null 时是 00:00 */
  duration: string;
  /** created 解析后的本地时间，形如 2026-11-20 17:57 */
  recordedAt: string;
  /** 重试后的状态摘要，当前卡片不展示 */
  detail: string;
  /** 接口 status：UPLOADING / PROCESSING / SUCCESS / ASR_PARTIAL_FAILED / DOC_FAILED / DOC_REMOVED */
  status: string;
  /** 分段数 */
  segmentCount: number;
  /** 文稿地址；列表没有时点「文档」再查详情 */
  docUrl: string;
  /** 文稿标题，对应 docTitle */
  docLabel: string;
};

/** 弹窗里的一段可下载录音。audioUrl 是当次接口返回的地址。 */
type VoiceAudioFileItem = {
  segmentIndex: number;
  duration: string;
  audioUrl: string;
};

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

function tp(key: string, firstName: string, firstValue: string, secondName: string = "", secondValue: string = ""): string {
  const params = new Map<string, string | number>();
  params.set(firstName, firstValue);
  if (secondName.length > 0) {
    params.set(secondName, secondValue);
  }
  return translateFn(key, toI18nParams(params), "");
}

function durationMeta(duration: string, recordedAt: string): string {
  return tp("Mobile.VoiceNote.durationMeta", "duration", duration, "time", recordedAt);
}

function segmentLabel(segmentIndex: number): string {
  return tp("Mobile.VoiceNote.segment", "index", (segmentIndex + 1).toString());
}

const records = ref<VoiceRecordHistoryItem[]>([]);
const playingId = ref<string>("");
let player: InnerAudioContext | null = null;
let playToken = 0;
let playUrls: string[] = [];

/** 请求进行中，避免下拉和上拉叠在一起 */
const loading = ref<boolean>(false);
/** 至少完成过一次列表请求。首屏请求回来前不显示空态，避免进页先闪「暂无历史记录」。 */
const listLoaded = ref<boolean>(false);
/** 打开文档的全屏 loading。只挡住文档请求本身，不和行内转圈共用。 */
const actionLocked = ref<boolean>(false);
/** 正在删除的 noteId。每条各自转圈，互不影响。 */
const deletingIds = ref<string[]>([]);
/** 当前正在录音的 noteId。这条历史不显示删除。 */
const recordingNoteId = ref<string>("");
/** 正在重新转写的 noteId。每条各自转圈。 */
const reprocessingIds = ref<string[]>([]);
/** 正在拉取音频列表的 noteId。每条各自转圈。 */
const audioLoadingIds = ref<string[]>([]);
const audioSheetRef = ref<any | null>(null);
const audioSheetTitle = ref<string>(t("Mobile.VoiceNote.audioFiles"));
const audioFiles = ref<VoiceAudioFileItem[]>([]);
/** 底部弹层高度。按条数估算，避免一打开就铺满屏幕。 */
const audioSheetHeight = ref<string>("280px");
/** 正在下载的音频地址。每段各自转圈，互不影响。 */
const downloadingUrls = ref<string[]>([]);

function listHas(list: string[], id: string): boolean {
  for (let i = 0; i < list.length; i++) {
    if (list[i] == id) return true;
  }
  return false;
}

function listAdd(list: string[], id: string): string[] {
  const next: string[] = [];
  for (let i = 0; i < list.length; i++) next.push(list[i]);
  if (!listHas(next, id)) next.push(id);
  return next;
}

function listRemove(list: string[], id: string): string[] {
  const next: string[] = [];
  for (let i = 0; i < list.length; i++) {
    if (list[i] != id) next.push(list[i]);
  }
  return next;
}

function isDeleting(id: string): boolean {
  return listHas(deletingIds.value, id);
}

function isReprocessing(id: string): boolean {
  return listHas(reprocessingIds.value, id);
}

function isAudioLoading(id: string): boolean {
  return listHas(audioLoadingIds.value, id);
}

function isDownloading(url: string): boolean {
  return listHas(downloadingUrls.value, url);
}

function callAudioSheet(methodName: string): void {
  const proxy = audioSheetRef.value as ComponentPublicInstance | null;
  if (proxy == null) return;
  proxy.$callMethod(methodName);
}

/** 标题、关闭按钮和每行高度相加，最高不超过窗口的 72%。 */
function measureAudioSheet(count: number): void {
  let windowHeight = 640;
  try {
    const info = uni.getSystemInfoSync();
    const raw = info.windowHeight;
    if (raw != null && raw > 0) {
      windowHeight = raw;
    }
  } catch (_e) {
    windowHeight = 640;
  }
  let content = 220;
  if (count > 0) {
    content = 168 + count * 64;
  }
  const max = Math.floor(windowHeight * 0.72);
  if (content > max) content = max;
  if (content < 220) content = 220;
  audioSheetHeight.value = `${content}px`;
}

/** 转写中、部分转写失败、文档失败、已完成可以下载录音文件。 */
function canDownloadAudio(status: string): boolean {
  return status == "PROCESSING" || status == "ASR_PARTIAL_FAILED" || status == "DOC_FAILED" || status == "SUCCESS";
}

function closeAudioSheet(): void {
  callAudioSheet("close");
}

function onAudioSheetClosed(): void {}

function openAudioSheet(): void {
  measureAudioSheet(audioFiles.value.length);
  callAudioSheet("open");
}

/** 用 audioUrl 路径里的文件名；没有后缀时按分段号生成 m4a。 */
function audioDownloadName(file: VoiceAudioFileItem): string {
  const fallback = tp("Mobile.VoiceNote.fileFallback", "index", (file.segmentIndex + 1).toString());
  const url = file.audioUrl;
  const query = url.indexOf("?");
  const path = query >= 0 ? url.substring(0, query) : url;
  const slash = path.lastIndexOf("/");
  if (slash < 0 || slash >= path.length - 1) return fallback;
  const base = path.substring(slash + 1);
  if (base.length == 0 || base.indexOf(".") < 0) return fallback;
  return base;
}

/** App 按 audioUrl 下载到本地。预签名地址不能带登录头。成功后弹出和产物预览一样的保存位置引导。 */
function finishAudioDownload(url: string): void {
  downloadingUrls.value = listRemove(downloadingUrls.value, url);
}

function downloadAudioFile(file: VoiceAudioFileItem): void {
  if (file.audioUrl.length == 0) return;
  if (listHas(downloadingUrls.value, file.audioUrl)) return;
  const url = file.audioUrl;
  downloadingUrls.value = listAdd(downloadingUrls.value, url);
  const filename = audioDownloadName(file);
  // #ifdef APP
  downloadFileInApp(url, filename, false, false, true).then((_path: string) => {
    finishAudioDownload(url);
  }).catch((_err: any | null) => {
    finishAudioDownload(url);
  });
  return;
  // #endif
  uni.downloadFile({
    url: url,
    success: (res) => {
      finishAudioDownload(url);
      if (res.statusCode != 200) {
        uni.showToast({ title: t("Mobile.VoiceNote.downloadFailed"), icon: "none" });
        return;
      }
      uni.saveFile({
        tempFilePath: res.tempFilePath,
        success: () => {
          uni.showToast({ title: t("Mobile.VoiceNote.downloaded"), icon: "none" });
        },
        fail: () => {
          uni.showToast({ title: t("Mobile.VoiceNote.downloadFailed"), icon: "none" });
        },
      });
    },
    fail: () => {
      finishAudioDownload(url);
      uni.showToast({ title: t("Mobile.VoiceNote.downloadFailed"), icon: "none" });
    },
  });
}

/** 真正的拉列表逻辑在 readAudioFiles 之后赋值，避免模板引用时 Kotlin 还看不到后面的函数。 */
let handleAudioFilesRunner: ((item: VoiceRecordHistoryItem) => void) | null = null;

function handleAudioFiles(item: VoiceRecordHistoryItem): void {
  const runner = handleAudioFilesRunner;
  if (runner != null) {
    runner(item);
  }
}

const refreshing = ref<boolean>(false);
/** 本页条数不足 pageSize 时不再请求下一页 */
const hasMore = ref<boolean>(true);
/** 下一页游标，取当前已加载最后一条的 noteId */
const lastId = ref<string>("");
const pageSize = 20;
const footerText = computed((): string => {
  if (loading.value) return t("Mobile.Page.loading");
  if (!hasMore.value) return t("Mobile.VoiceNote.noMore");
  return t("Mobile.VoiceNote.loadMore");
});

function pad2(n: number): string {
  if (n < 10) return "0" + n.toString();
  return n.toString();
}

function formatDuration(ms: number): string {
  const safe = ms < 0 ? 0 : ms;
  const totalSec = Math.floor(safe / 1000);
  const sec = totalSec % 60;
  const min = Math.floor(totalSec / 60);
  return pad2(min) + ":" + pad2(sec);
}

function formatClock(ts: number): string {
  if (ts <= 0) return "";
  const d = new Date(ts);
  return (
    d.getFullYear() +
    "-" +
    pad2(d.getMonth() + 1) +
    "-" +
    pad2(d.getDate()) +
    " " +
    pad2(d.getHours()) +
    ":" +
    pad2(d.getMinutes())
  );
}

function readItemString(obj: UTSJSONObject, key: string): string {
  const raw = obj[key];
  if (raw == null) return "";
  return `${raw}`;
}

function readItemNumber(obj: UTSJSONObject, key: string): number {
  const raw = obj[key];
  if (raw == null) return 0;
  const value = parseFloat(`${raw}`);
  if (isNaN(value)) return 0;
  return value;
}

/** 列表标题右侧的状态文案。未知状态原样显示。 */
function statusLabel(status: string): string {
  if (status == "UPLOADING") return t("Mobile.VoiceNote.uploading");
  if (status == "PROCESSING") return t("Mobile.VoiceNote.transcribing");
  if (status == "ASR_PARTIAL_FAILED") return t("Mobile.VoiceNote.partialFailed");
  if (status == "DOC_FAILED") return t("Mobile.VoiceNote.docFailed");
  if (status == "SUCCESS") return t("Mobile.VoiceNote.completed");
  if (status == "DOC_REMOVED") return t("Mobile.VoiceNote.docRemoved");
  return status;
}

/**
 * 把 created 转成本地时间。
 * 接口示例：2026-11-20T09:57:46.000+00:00，在东八区显示为 2026-11-20 17:57。
 * 也兼容毫秒或秒时间戳。
 */
function formatCreated(raw: string): string {
  if (raw.length == 0) return "";
  const value = parseFloat(raw);
  const digitsOnly = !isNaN(value) && `${Math.floor(value)}` == raw;
  if (digitsOnly && value > 1000000000000) return formatClock(value);
  if (digitsOnly && value > 1000000000) return formatClock(value * 1000);
  const parsed = new Date(raw).getTime();
  if (!isNaN(parsed) && parsed > 0) return formatClock(parsed);
  return "";
}

/** 接口行转成卡片数据。docUrl、docTitle 为 null 时按空串处理。 */
function mapHistoryItem(row: UTSJSONObject): VoiceRecordHistoryItem {
  const noteId = readItemString(row, "noteId");
  const titleRaw = readItemString(row, "title");
  const status = readItemString(row, "status");
  const segmentCount = readItemNumber(row, "segmentCount");
  const created = formatCreated(readItemString(row, "created"));
  const title = titleRaw.length > 0 ? titleRaw : t("Mobile.VoiceNote.defaultTitle");
  let docUrl = readItemString(row, "docUrl");
  if (docUrl == "null") {
    docUrl = "";
  }
  let docTitle = readItemString(row, "docTitle");
  if (docTitle == "null") {
    docTitle = "";
  }
  const item: VoiceRecordHistoryItem = {
    id: noteId,
    title: title,
    duration: formatDuration(readItemNumber(row, "totalDurationMs")),
    recordedAt: created,
    detail: "",
    status: status,
    segmentCount: segmentCount,
    docUrl: docUrl,
    docLabel: docTitle,
  };
  return item;
}

function applyStatus(item: VoiceRecordHistoryItem, status: string): void {
  item.status = status;
  item.detail = tp("Mobile.VoiceNote.statusSegments", "status", statusLabel(status), "count", item.segmentCount.toString());
}

function readAudioFiles(data: UTSJSONObject | null): VoiceAudioFileItem[] {
  const result: VoiceAudioFileItem[] = [];
  if (data == null) return result;
  const raw = data["items"];
  if (raw == null) return result;
  const rows = raw as UTSJSONObject[];
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    const urlRaw = row["audioUrl"];
    const url = urlRaw != null ? `${urlRaw}` : "";
    if (url.length == 0 || url == "null") continue;
    let segmentIndex = i;
    const indexRaw = row["segmentIndex"];
    if (indexRaw != null) {
      const parsed = parseFloat(`${indexRaw}`);
      if (!isNaN(parsed)) segmentIndex = Math.floor(parsed);
    }
    let durationMs = 0;
    const durationRaw = row["durationMs"];
    if (durationRaw != null) {
      const parsedDuration = parseFloat(`${durationRaw}`);
      if (!isNaN(parsedDuration)) durationMs = parsedDuration;
    }
    const file: VoiceAudioFileItem = {
      segmentIndex: segmentIndex,
      duration: formatDuration(durationMs),
      audioUrl: url,
    };
    result.push(file);
  }
  return result;
}

/** 本地文件已经没了时，用列表或音频列表上的分段数补一次 complete。 */
async function completeHistoryUpload(item: VoiceRecordHistoryItem): Promise<void> {
  if (!orphanUploadNeedsComplete(item.id)) return;
  let total = item.segmentCount;
  if (total <= 0) {
    try {
      const data = await apiVoiceNoteAudioFiles(item.id, 1, 50);
      total = readAudioFiles(data).length;
    } catch (_e) {
      total = 0;
    }
  }
  completeOrphanUploadingNote(item.id, total);
}

/** 只处理这一页已经查出来、状态是上传中的记录。未加载的页不补。 */
function backfillUploadingHistory(items: VoiceRecordHistoryItem[]): void {
  for (let i = 0; i < items.length; i++) {
    const item = items[i];
    if (item.status != "UPLOADING") continue;
    backfillVoiceNoteByNoteId(item.id);
    void completeHistoryUpload(item);
  }
}

/** 录音面板记下的正在录音 noteId。 */
function refreshRecordingNoteId(): void {
  recordingNoteId.value = loadRecordingNoteId();
}

/**
 * 拉一页历史。
 * reset 为 true 时从第一页重拉，用于进入页面和下拉刷新。
 * 翻页游标是上一页最后一条 noteId。
 */
async function loadRecords(reset: boolean): Promise<void> {
  refreshRecordingNoteId();
  if (loading.value) {
    refreshing.value = false;
    return;
  }
  if (!reset && !hasMore.value) return;
  loading.value = true;
  const cursor = reset ? "" : lastId.value;
  try {
    const rows = await apiVoiceNoteList(cursor, pageSize);
    const next: VoiceRecordHistoryItem[] = [];
    for (let i = 0; i < rows.length; i++) {
      const item = mapHistoryItem(rows[i]);
      if (item.id.length > 0) next.push(item);
    }
    if (reset) {
      records.value = next;
    } else {
      const merged: VoiceRecordHistoryItem[] = [];
      for (let i = 0; i < records.value.length; i++) {
        merged.push(records.value[i]);
      }
      for (let i = 0; i < next.length; i++) {
        merged.push(next[i]);
      }
      records.value = merged;
    }
    if (next.length > 0) lastId.value = next[next.length - 1].id;
    hasMore.value = rows.length >= pageSize;
    backfillUploadingHistory(next);
  } catch (_error) {
    uni.showToast({ title: t("Mobile.VoiceNote.loadFailed"), icon: "none" });
  } finally {
    loading.value = false;
    refreshing.value = false;
    listLoaded.value = true;
  }
}

function loadMore(): void {
  void loadRecords(false);
}

function handleRefresh(): void {
  refreshing.value = true;
  void loadRecords(true);
}

function handleBack(): void {
  uni.navigateBack({ delta: 1 });
}

/** 开始一次卡片操作。已有操作在进行时返回 false。 */
function beginAction(title: string): boolean {
  if (actionLocked.value) return false;
  actionLocked.value = true;
  uni.showLoading({ title: title, mask: true });
  return true;
}

/** 结束卡片操作。先收起 loading，再由调用方决定是否 toast。 */
function endAction(): void {
  actionLocked.value = false;
  uni.hideLoading();
}

function openDoc(item: VoiceRecordHistoryItem, docUrl: string): void {
  navigateToPageOnce("/subpackages/pages/webview/webview?url=" + encodeURIComponent(docUrl) + "&title=" + encodeURIComponent(item.title));
}

/** 打开文稿。列表已带 docUrl 时直接打开，否则再查一次详情。 */
async function handleDownload(item: VoiceRecordHistoryItem): Promise<void> {
  if (actionLocked.value) return;
  if (item.status != "SUCCESS") {
    uni.showToast({ title: t("Mobile.VoiceNote.docNotReady"), icon: "none" });
    return;
  }
  if (item.docUrl.length > 0) {
    openDoc(item, item.docUrl);
    return;
  }
  if (!beginAction(t("Mobile.Page.loading"))) return;
  let failMessage = "";
  try {
    const detail = await apiVoiceNoteDetail(item.id);
    const docUrl = detail != null && detail["docUrl"] != null ? `${detail["docUrl"]}` : "";
    if (docUrl.length == 0) {
      failMessage = t("Mobile.VoiceNote.docNotReady");
    } else {
      item.docUrl = docUrl;
      openDoc(item, docUrl);
    }
  } catch (_error) {
    failMessage = t("Mobile.VoiceNote.docNotReady");
  } finally {
    endAction();
  }
  if (failMessage.length > 0) {
    uni.showToast({ title: failMessage, icon: "none" });
  }
}

function openDetail(item: VoiceRecordHistoryItem): void {
  if (item.id.length == 0) {
    return;
  }
  // 返回动画未结束时再进详情会报 navigateTo locked，并留下未处理的拒绝。
  navigateToPageOnce("/subpackages/pages/voice-record-detail/voice-record-detail?noteId=" + encodeURIComponent(item.id));
}

/** 拉第一页音频列表，最多 50 条，在弹窗里展示。 */
async function loadAudioFiles(item: VoiceRecordHistoryItem): Promise<void> {
  let failMessage = "";
  try {
    const data = await apiVoiceNoteAudioFiles(item.id, 1, 50);
    audioFiles.value = readAudioFiles(data);
    audioSheetTitle.value = item.title.length > 0 ? item.title : t("Mobile.VoiceNote.audioFiles");
    openAudioSheet();
  } catch (_error) {
    failMessage = t("Mobile.VoiceNote.audioListFailed");
  } finally {
    audioLoadingIds.value = listRemove(audioLoadingIds.value, item.id);
  }
  if (failMessage.length > 0) {
    uni.showToast({ title: failMessage, icon: "none" });
  }
}

handleAudioFilesRunner = (item: VoiceRecordHistoryItem): void => {
  if (listHas(audioLoadingIds.value, item.id)) return;
  audioLoadingIds.value = listAdd(audioLoadingIds.value, item.id);
  void loadAudioFiles(item);
};

function stopPlayback(): void {
  playToken = playToken + 1;
  playingId.value = "";
  playUrls = [];
  const current = player;
  player = null;
  if (current != null) {
    current.stop();
    current.destroy();
  }
}

function playClipAt(noteId: string, index: number, token: number): void {
  if (token != playToken || index < 0 || index >= playUrls.length) {
    stopPlayback();
    return;
  }
  const previous = player;
  player = null;
  if (previous != null) {
    previous.stop();
    previous.destroy();
  }
  const audio = uni.createInnerAudioContext();
  player = audio;
  audio.src = playUrls[index];
  audio.onEnded(() => {
    if (token != playToken) return;
    playClipAt(noteId, index + 1, token);
  });
  audio.onError((_err) => {
    if (token != playToken) return;
    stopPlayback();
    uni.showToast({ title: t("Mobile.VoiceNote.playFailed"), icon: "none" });
  });
  audio.play();
}

async function loadAudioUrls(noteId: string): Promise<string[]> {
  const urls: string[] = [];
  let page = 1;
  let total = 0;
  while (page < 20) {
    const data = await apiVoiceNoteAudioFiles(noteId, page, 50);
    if (data == null) break;
    total = readItemNumber(data, "total");
    const raw = data["items"];
    if (raw == null || !Array.isArray(raw)) break;
    const items = raw as UTSJSONObject[];
    for (let i = 0; i < items.length; i++) {
      const url = readItemString(items[i], "audioUrl");
      if (url.length > 0) urls.push(url);
    }
    if (items.length < 50 || (total > 0 && urls.length >= total)) break;
    page = page + 1;
  }
  return urls;
}

async function handlePlay(item: VoiceRecordHistoryItem): Promise<void> {
  if (playingId.value == item.id) {
    stopPlayback();
    return;
  }
  stopPlayback();
  const token = playToken;
  try {
    const urls = await loadAudioUrls(item.id);
    if (token != playToken) return;
    if (urls.length == 0) {
      uni.showToast({ title: t("Mobile.VoiceNote.noPlayableAudio"), icon: "none" });
      return;
    }
    playUrls = urls;
    playingId.value = item.id;
    playClipAt(item.id, 0, token);
  } catch (_error) {
    if (token != playToken) return;
    stopPlayback();
    uni.showToast({ title: t("Mobile.VoiceNote.playFailed"), icon: "none" });
  }
}

/** 只有转写失败、文档失败、文档已删除可以重试。 */
function canReprocess(status: string): boolean {
  return status == "ASR_PARTIAL_FAILED" || status == "DOC_FAILED" || status == "DOC_REMOVED";
}

/** 三种失败都调同一个 reprocess，后端按当前状态决定重新转写、重出文档或重建文档。 */
function reprocessLabel(status: string): string {
  if (status == "ASR_PARTIAL_FAILED") return t("Mobile.VoiceNote.retranscribe");
  if (status == "DOC_FAILED") return t("Mobile.VoiceNote.regenerateDoc");
  if (status == "DOC_REMOVED") return t("Mobile.VoiceNote.rebuildDoc");
  return "";
}

async function handleReprocess(item: VoiceRecordHistoryItem): Promise<void> {
  if (listHas(reprocessingIds.value, item.id)) return;
  reprocessingIds.value = listAdd(reprocessingIds.value, item.id);
  let failMessage = "";
  try {
    const status = await apiVoiceNoteReprocess(item.id);
    applyStatus(item, status);
  } catch (error) {
    const message = `${error}`;
    failMessage = message.length > 0 ? message : t("Mobile.VoiceNote.processFailed");
  } finally {
    reprocessingIds.value = listRemove(reprocessingIds.value, item.id);
  }
  if (failMessage.length > 0) {
    uni.showToast({ title: failMessage, icon: "none" });
  }
}

function removeRecord(noteId: string): void {
  const next: VoiceRecordHistoryItem[] = [];
  for (let i = 0; i < records.value.length; i++) {
    if (records.value[i].id != noteId) next.push(records.value[i]);
  }
  records.value = next;
}

async function confirmDelete(item: VoiceRecordHistoryItem): Promise<void> {
  if (listHas(deletingIds.value, item.id)) return;
  const noteId = item.id;
  deletingIds.value = listAdd(deletingIds.value, noteId);
  let failMessage = "";
  try {
    await apiVoiceNoteDelete(noteId);
    if (playingId.value == noteId) stopPlayback();
    removeRecord(noteId);
    await deleteCachedVoiceNoteFiles(noteId);
  } catch (_error) {
    failMessage = t("Mobile.VoiceNote.deleteFailed");
  } finally {
    deletingIds.value = listRemove(deletingIds.value, noteId);
  }
  if (failMessage.length > 0) {
    uni.showToast({ title: failMessage, icon: "none" });
  }
}

function handleDelete(item: VoiceRecordHistoryItem): void {
  if (item.id.length > 0 && item.id == recordingNoteId.value) return;
  if (listHas(deletingIds.value, item.id)) return;
  uni.showModal({
    title: t("Mobile.VoiceNote.deleteTitle"),
    content: t("Mobile.VoiceNote.deleteContent"),
    confirmText: t("Mobile.Common.delete"),
    cancelText: t("Mobile.Common.cancel"),
    success: (res) => {
      if (res.confirm != true) return;
      if (listHas(deletingIds.value, item.id)) return;
      void confirmDelete(item);
    },
  });
}

/** 每次进入页面都从第一页重拉，并补一轮本地未传完的录音。已在补传中则不再开一轮。 */
onUnload(() => {
  stopPlayback();
});

onShow(() => {
  void loadRecords(true);
  startBackfill();
});
</script>

