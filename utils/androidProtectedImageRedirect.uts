/** Android 内嵌 H5 图片：在原生侧读取 /api/f/ 的跳转地址，不向对象存储转发 Bearer。 */
// #ifdef APP-ANDROID
import URL from 'java.net.URL';
import HttpURLConnection from 'java.net.HttpURLConnection';
import { getApiBaseUrl } from '@/constants/config';
import { ACCESS_TOKEN } from '@/constants/home.constants';

export function resolveAndroidProtectedImageRedirect(rawUrl: string): Promise<string> {
  return new Promise((resolve, reject) => {
    const settle = (directUrl: string, errorMessage: string): void => {
      const finish = (): void => {
        if (directUrl.length > 0) resolve(directUrl);
        else reject(new Error(errorMessage));
      };
      const activity = UTSAndroid.getUniActivity();
      if (activity != null) activity.runOnUiThread(finish);
      else finish();
    };
    const apiBase = getApiBaseUrl();
    const path = rawUrl.indexOf('/') == 0 ? rawUrl : `/${rawUrl}`;
    const fetchUrl = rawUrl.indexOf('https://') == 0 ? rawUrl : `${apiBase}${path}`;
    if (fetchUrl.indexOf(`${apiBase}/api/f/`) != 0) {
      reject(new Error('Invalid protected image URL'));
      return;
    }
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    const token = tokenRaw != null ? `${tokenRaw}` : '';
    if (token.length == 0) {
      reject(new Error('Missing protected image token'));
      return;
    }
    UTSAndroid.getDispatcher('io').async(function (_: any | null): void {
      let connection: HttpURLConnection | null = null;
      try {
        connection = new URL(fetchUrl).openConnection() as HttpURLConnection;
        connection!!.setInstanceFollowRedirects(false);
        connection!!.setRequestMethod('GET');
        connection!!.setRequestProperty('Authorization', `Bearer ${token}`);
        connection!!.setConnectTimeout(10000);
        connection!!.setReadTimeout(10000);
        const status = connection!!.getResponseCode();
        const locationRaw = connection!!.getHeaderField('Location');
        const location = locationRaw != null ? `${locationRaw}` : '';
        if ((status == 301 || status == 302 || status == 303 || status == 307 || status == 308)
            && location.indexOf('https://') == 0) {
          settle(location, '');
        } else {
          settle('', `Protected image redirect unavailable: ${status}`);
        }
      } catch (error) {
        settle('', `${error}`);
      } finally {
        if (connection != null) connection!!.disconnect();
      }
    }, null);
  });
}
// #endif
