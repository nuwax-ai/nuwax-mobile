<template>
  <!-- H5 全屏预览（swiper 平滑切图 + 计数 + 下载 + 点击关闭）。
       App 内嵌时系统返回 / 边缘侧滑走 popupBackRegistry，只关预览不退出聊天。 -->
  <view v-if="visible" class="app-wv-image-preview">
    <swiper
      class="app-wv-image-preview__swiper"
      :current="currentIndex"
      :circular="false"
      :duration="280"
      easing-function="easeOut"
      @change="onSwiperChange"
    >
      <swiper-item
        v-for="(url, index) in previewUrls"
        :key="index"
      >
        <view class="app-wv-image-preview__slide" @tap="onOverlayTap">
          <!-- 与正文 mp-html 一样用原生 img：Android 上 uni <image> 会把 /api 解析到 /m/api 且不带 Cookie -->
          <img
            class="app-wv-image-preview__img"
            :src="url"
          />
        </view>
      </swiper-item>
    </swiper>
    <text v-if="showIndicator" class="app-wv-image-preview__indicator">
      {{ indicatorText }}
    </text>
    <!-- 必须叠在 swiper 之后：全屏 swiper 会抢走先声明的绝对定位按钮点击 -->
    <view
      class="app-wv-image-preview__download"
      @tap.stop="onDownloadTap"
      @click.stop="onDownloadTap"
      @touchstart.stop="onDownloadTouchStart"
    >
      <svg-icon
        name="icon-a-Arrowdown"
        size="44"
        color="#ffffff"
        customClass="app-wv-image-preview__download-icon"
        @click.stop="onDownloadTap"
      />
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, onUnmounted, ref, watch } from "vue";
  import {
    downloadPreviewImage,
    installAppWebViewImagePreviewHook,
    setAppWebViewImagePreviewHost,
    uninstallAppWebViewImagePreviewHook,
  } from "@/utils/appWebViewImagePreview.uts";
  import {
    registerBackInterceptionGlobals,
    registerPopupClose,
    unregisterPopupClose,
  } from "@/utils/popupBackRegistry";
  import SvgIcon from "@/components/svg-icon/svg-icon.uvue";

  const visible = ref<boolean>(false);
  const previewUrls = ref<string[]>([] as string[]);
  const currentIndex = ref<number>(0);
  let popupRegistryId: number = 0;
  let downloading: boolean = false;

  const showIndicator = computed((): boolean => {
    return previewUrls.value.length > 0;
  });

  const indicatorText = computed((): string => {
    const total = previewUrls.value.length;
    if (total == 0) {
      return "";
    }
    return `${currentIndex.value + 1} / ${total}`;
  });

  const close = (): void => {
    visible.value = false;
  };

  const onOverlayTap = (): void => {
    close();
  };

  const openPreview = (urls: string[], current: string): void => {
    const list: string[] = [] as string[];
    const urlLen = urls.length;
    for (let i = 0; i < urlLen; i++) {
      const item = urls[i];
      if (item != null && item.length > 0) {
        list.push(item);
      }
    }
    if (list.length == 0 && current.length > 0) {
      list.push(current);
    }
    let idx = 0;
    if (current.length > 0) {
      for (let i = 0; i < list.length; i++) {
        if (list[i] == current) {
          idx = i;
          break;
        }
      }
    }
    previewUrls.value = list;
    currentIndex.value = idx;
    visible.value = true;
  };

  const onSwiperChange = (e: UniSwiperChangeEvent): void => {
    if (e == null) {
      return;
    }
    const detail = e.detail;
    if (detail == null) {
      return;
    }
    currentIndex.value = detail.current;
  };

  /** 只拦截触摸，避免全屏 swiper 把下载按钮手势当成滑图。 */
  const onDownloadTouchStart = (): void => {
    return;
  };

  const onDownloadTap = (): void => {
    if (downloading == true) {
      return;
    }
    const list = previewUrls.value;
    const idx = currentIndex.value;
    if (idx < 0 || idx >= list.length) {
      return;
    }
    const url = list[idx];
    if (url.length == 0) {
      return;
    }
    downloading = true;
    downloadPreviewImage(url);
    setTimeout((): void => {
      downloading = false;
    }, 1200);
  };

  registerBackInterceptionGlobals();
  setAppWebViewImagePreviewHost(openPreview);
  installAppWebViewImagePreviewHook();
  watch(
    visible,
    (val: boolean) => {
      if (val == true) {
        if (popupRegistryId == 0) {
          popupRegistryId = registerPopupClose(close);
        }
      } else if (popupRegistryId != 0) {
        unregisterPopupClose(popupRegistryId);
        popupRegistryId = 0;
      }
    },
    { immediate: true },
  );

  onUnmounted(() => {
    setAppWebViewImagePreviewHost(null);
    uninstallAppWebViewImagePreviewHook();
    if (popupRegistryId != 0) {
      unregisterPopupClose(popupRegistryId);
      popupRegistryId = 0;
    }
    visible.value = false;
  });
</script>

<style lang="scss" scoped>
  .app-wv-image-preview {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 10050;
    background-color: #000000;
  }

  .app-wv-image-preview__indicator {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding-top: calc(24rpx + env(safe-area-inset-top, 0px));
    text-align: center;
    color: #ffffff;
    font-size: 28rpx;
    line-height: 40rpx;
    z-index: 2;
    pointer-events: none;
  }

  .app-wv-image-preview__download {
    position: absolute;
    top: calc(16rpx + env(safe-area-inset-top, 0px));
    right: 24rpx;
    z-index: 10;
    width: 72rpx;
    height: 72rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 36rpx;
    background-color: rgba(255, 255, 255, 0.16);
    pointer-events: auto;
  }

  .app-wv-image-preview__download-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .app-wv-image-preview__download :deep(.app-wv-image-preview__download-icon) {
    pointer-events: none;
  }

  .app-wv-image-preview__swiper {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  .app-wv-image-preview__slide {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .app-wv-image-preview__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border: none;
  }
</style>
