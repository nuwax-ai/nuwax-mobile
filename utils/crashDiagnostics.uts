// 旧版 Bugly 仅集成 Android 和 iOS，鸿蒙构建不引用原生插件。
// #ifdef APP-ANDROID || APP-IOS
export {
  isCrashDiagnosticsAllowed,
  isCrashDiagnosticsAvailable,
  setCrashDiagnosticsAllowed,
  startCrashDiagnostics,
} from "@/utils/crashDiagnosticsNative";
// #endif

// #ifndef APP-ANDROID || APP-IOS
// #ifdef APP-HARMONY
let unsupportedPlatformLogged = false;
// #endif

export function isCrashDiagnosticsAvailable(): boolean {
  return false;
}

export function isCrashDiagnosticsAllowed(): boolean {
  return false;
}

export function setCrashDiagnosticsAllowed(_allowed: boolean): boolean {
  return false;
}

export function startCrashDiagnostics(): void {
  // #ifdef APP-HARMONY
  if (unsupportedPlatformLogged) return;
  unsupportedPlatformLogged = true;
  console.log("[CrashDiagnostics] init_skipped platform=app-harmony reason=unsupported_platform");
  // #endif
}
// #endif
