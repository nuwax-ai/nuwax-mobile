// 环境配置
// 使用uni-app的条件编译来处理不同环境

let API_BASE_URL = "";
// Nuwax Vox 设备语音网关 / App BFF（设备绑定、会议、推送消息）
let VOX_BASE_URL = "";
// 设备连接语音网关的 WS 地址，绑定时随 deviceSecret 一起下发给设备
let VOX_DEVICE_WS_URL = "";

// uEnvProd
if (process.env.NODE_ENV === "production") {
  // #ifdef MP-WEIXIN || APP
  API_BASE_URL = "https://agent.nuwax.com";
  // #endif
}

// uEnvDev
if (process.env.NODE_ENV === "development") {
  API_BASE_URL = "https://testagent.xspaceagi.com";
}

// TODO 打包正式环境时要删除 这个 !!!-start
 API_BASE_URL = "https://testagent.xspaceagi.com";
// TODO 打包正式环境时要删除 这个 !!!-end

// Vox 网关已部署到测试环境，走全局域名（随 API_BASE_URL），不再写死内网 IP+端口
VOX_BASE_URL = API_BASE_URL;
VOX_DEVICE_WS_URL = "wss://" + API_BASE_URL.substring("https://".length) + "/ws/device";

// 允许外部链接跳转的域名
export const ALLOW_EXTERNAL_LINK_DOMAIN = [API_BASE_URL, "https://nuwax.com"];

// 不需要登录检查的地址
export const NO_LOGIN_CHECK_URL = [
  "https://nuwax.com/user-agreement.html",
  "https://nuwax.com/privacy.html",
];

// 版本号
export const VERSION = "v1.0.3";

// 登录白名单地址
export const LOGIN_WHITELIST_URL = [
  "/api/user/getLoginInfo",
];

// API_BASE_URL / VOX_BASE_URL / VOX_DEVICE_WS_URL 为 let 声明，单独导出；其余常量已在声明处直接导出
export { API_BASE_URL, VOX_BASE_URL, VOX_DEVICE_WS_URL };
