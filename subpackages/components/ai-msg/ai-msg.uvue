    /* #endif */
  }

  /* #ifndef APP */
  /* 运行中文案扫光：思考中标题与 V2 轨迹 running 行同款（对齐 PC shimmer-text） */
  @keyframes v2-shimmer-sweep {
    0% {
      background-position: 200% 0;
    }

    100% {
      background-position: -200% 0;
    }
  }

  .shimmer-text {
    background: linear-gradient(
      90deg,
      rgba(5, 5, 5, 0.45) 0%,
      rgba(5, 5, 5, 0.45) 38%,
      rgba(0, 0, 0, 0.88) 50%,
      rgba(5, 5, 5, 0.45) 62%,
      rgba(5, 5, 5, 0.45) 100%
    );
    background-size: 200% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: v2-shimmer-sweep 2.4s linear infinite;
  }
  /* #endif */
