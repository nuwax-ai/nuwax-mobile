/**
 * nuwax-livekit · app-ios（LiveKit Swift SDK 2.19.x 桥接）
 *
 * <h2>分工</h2>
 * <ul>
 *   <li>本文件：UTS 侧薄封装（参数/回调映射）。</li>
 *   <li>`MeetingRoomBridge.swift`：真正调 LiveKit Swift SDK 的地方（连接/退房/设备开关/
 *       AVAudioSession/人数）。**SDK API 只在那里出现**，升级 SDK 只改那一个文件。</li>
 * </ul>
 *
 * <h2>运行时权限</h2>
 * <p>iOS 的麦克风/摄像头授权在 SDK 首次采集时由系统弹窗触发（AVFoundation 负责），
 * 不需要 UTS 侧预申请；`Info.plist` 的 `NSMicrophoneUsageDescription` /
 * `NSCameraUsageDescription` 必须已就位，否则一采集就崩。</p>
 *
 * <h2>★★基座</h2>
 * <p>本插件依赖 CocoaPods `LiveKitClient`，**标准基座不含**：必须重打自定义基座
 * （`make app-resource` → `make base-ios-device` / `base-ios-simulator`）。</p>
 */
// Swift 侧 public 类对本文件直接可见（无需 import）；Swift 返回值的 UIKit 类型显式引入。
import { UIView } from "UIKit";
// ★线程约定：Swift 桥内部会把所有 SDK/UI 调用收敛到主线程（见 MeetingRoomBridge.onMain）；
//   本文件只做转发，不在这里做任何 await/延时，保持与 Android 同名同序。

/** 插件内置 SDK 版本（排查用；与 Podfile 版本保持一致）。 */
const LIVEKIT_VERSION = "2.19.0";

/** 本端能否真正收发音视频：iOS 已接 LiveKit Swift SDK，恒 true。 */
export function isSupported(): boolean {
  console.error("[MeetingBridge][UTS] isSupported -> Swift");
  const supported = MeetingRoomBridge.isSupported();
  console.error(`[MeetingBridge][UTS] isSupported <- Swift ${supported}`);
  return supported;
}

/**
 * 内部：SDK 版本号 + 原生诊断短串（页面/日志排查用）。
 *
 * <p>★为什么不单独加一个诊断导出：uni-app x 的 `?uts-proxy` 只认既有导出表，新增
 * `export function` 会让业务侧 import 直接编译失败（2026-11-15 实测）。这里借用既有
 * 导出把排查信息带回业务层。</p>
 *
 * <p>格式：`2.19.0|bridge=ios-native-view-v2 probe=ios-camera-20261115-p1 main=1 view=0 cam=0 conn=1 remotes=0 dev=`。
 * `bridge/probe` 来自原生 Swift，用于判别实际安装的基座；`main` 是本次调用线程是否主线程，
 * 0/1 都可能。</p>
 */
export function sdkVersion(): string {
  return `${LIVEKIT_VERSION}|${MeetingRoomBridge.diag()}`;
}

/**
 * 连接已有房间（不建房）。
 * ★Swift 侧 `MeetingRoomBridge` 的 public 类对本文件直接可见（无需 import）。
 * @UTSJS.keepAlive 回调被 Swift 侧持有到退房，须防回收。
 */
@UTSJS.keepAlive
export function connect(
  serverUrl: string,
  token: string,
  room: string,
  displayName: string,
  micOn: boolean,
  cameraOn: boolean,
): void {
  MeetingRoomBridge.connect(serverUrl, token, micOn, cameraOn);
}

/** 最近一次连接失败原因（空串=无错）。 */
export function lastError(): string {
  return MeetingRoomBridge.lastError();
}

/** 离开：只断本端，不删房。 */
export function disconnect(): void {
  MeetingRoomBridge.disconnect();
}

/** 麦克风开关。 */
export function setMicEnabled(on: boolean): void {
  MeetingRoomBridge.setMicEnabled(on);
}

/** 摄像头开关。 */
export function setCameraEnabled(on: boolean): void {
  MeetingRoomBridge.setCameraEnabled(on);
}

/** 音频输出：扬声器 / 听筒（耳机插入时系统优先级更高）。 */
export function setSpeakerEnabled(on: boolean): void {
  MeetingRoomBridge.setSpeakerEnabled(on);
}

/**
 * 在插件内创建并绑定视频视图。页面只能传 UniNativeViewElement，
 * 不能让 UIView 作为返回值跨过 uvue/UTS 边界。
 */
export function createVideoView(element: UniNativeViewElement): boolean {
  console.error("[MeetingBridge] local view -> Swift");
  const view = MeetingRoomBridge.createVideoView();
  if (view == null) {
    console.error("[MeetingBridge] local view unavailable");
    return false;
  }
  console.error("[MeetingBridge] local view -> bindIOSView");
  element.bindIOSView(view!);
  console.error("[MeetingBridge] local view bound");
  return true;
}

/** 把本机摄像头轨道挂到已绑定的渲染视图上（开摄像头/页面重进时各调一次）。 */
export function attachLocalVideo(): void {
  MeetingRoomBridge.attachLocalVideo();
}

/** 释放渲染视图（关摄像头/离开页面）。 */
export function releaseVideoView(): void {
  MeetingRoomBridge.releaseVideoView();
}

/** 本机麦克风音量（0..1）：页面每 250ms 拉一次画音波。 */
export function localAudioLevel(): number {
  return MeetingRoomBridge.localAudioLevel();
}

/** 已订阅到视频的远端成员 identity（逗号分隔；空串=没人开视频）。 */
export function remoteVideoIdentities(): string {
  return MeetingRoomBridge.remoteVideoIdentities();
}

/** 为某个远端成员创建并绑定渲染视图；UIView 不返回页面。 */
export function createRemoteVideoView(identity: string, element: UniNativeViewElement): boolean {
  console.error(`[MeetingBridge][UTS] remote view -> Swift ${identity}`);
  const view = MeetingRoomBridge.createRemoteVideoView(identity);
  if (view == null) {
    console.error(`[MeetingBridge][UTS] remote view unavailable ${identity}`);
    return false;
  }
  console.error(`[MeetingBridge][UTS] remote view -> bindIOSView ${identity}`);
  element.bindIOSView(view!);
  console.error(`[MeetingBridge][UTS] remote view bound ${identity}`);
  return true;
}

/** 切换前后摄像头（入会默认前置）。 */
export function switchCamera(): void {
  MeetingRoomBridge.switchCamera();
}

/** 房间人数（含本端；未连接返回 0）。 */
export function participantCount(): number {
  return MeetingRoomBridge.participantCount();
}

/** 房间 metadata 原始 JSON。 */
export function roomMetadata(): string {
  return MeetingRoomBridge.roomMetadata();
}

/** 举手 / 放下手（participant attributes.handRaised）。 */
export function setHandRaised(on: boolean): void {
  MeetingRoomBridge.setHandRaised(on);
}

/** 本端当前是否举手。 */
export function localHandRaised(): boolean {
  return MeetingRoomBridge.localHandRaised();
}

/** 是否已连接。 */
export function isConnected(): boolean {
  return MeetingRoomBridge.isConnected();
}

/** Reliable LiveKit DataChannel chat/danmaku, shared with the PC topics. */
export function sendMeetingMessage(text: string, displayName: string, danmaku: boolean): void {
  MeetingRoomBridge.sendMeetingMessage(text, displayName, danmaku);
}

/** Drain received and locally echoed meeting messages as a JSON array. */
export function drainMeetingMessages(): string {
  return MeetingRoomBridge.drainMeetingMessages();
}

/** iOS in-app ReplayKit capture (the Broadcast Upload Extension is not required for this path). */
export function requestScreenShare(): void {
  MeetingRoomBridge.requestScreenShare();
}

export function stopScreenShare(): void {
  MeetingRoomBridge.stopScreenShare();
}

export function isScreenShareOn(): boolean {
  return MeetingRoomBridge.isScreenShareOn();
}

export function screenShareError(): string {
  return MeetingRoomBridge.screenShareError();
}
