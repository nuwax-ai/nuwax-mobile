/** JSSDK 在普通浏览器也会定义 uni.webView，须以原生注入的桥区分 App。 */
export function isNativeAppWebView(): boolean {
  // #ifdef H5 || WEB
  const w = window as any;
  return w.__uniapp_x_postMessage != null || w.__uniapp_x_ != null ||
    w.__dcloud_weex_postMessage != null || w.__dcloud_weex_ != null ||
    (w.plus != null && w.plus.webview != null);
  // #endif
  return false;
}

let pendingSdk: Promise<boolean> | null = null;

/** 外链容器未必注入 JSSDK，按需加载随 H5 发布的版本；等待期间不发起导航。 */
export function ensureAppWebViewNavigationReady(): Promise<boolean> {
  // #ifdef H5 || WEB
  if (!isNativeAppWebView()) return Promise.resolve(false);
  const w = window as any;
  if (w.uni != null && w.uni.webView != null && w.uni.webView.navigateTo != null) return Promise.resolve(true);
  if (pendingSdk != null) return pendingSdk!;
  pendingSdk = new Promise<boolean>((resolve) => {
    let settled = false;
    let timer = 0;
    let attempts = 0;
    const finish = (ready: boolean): void => {
      if (settled) return;
      settled = true;
      if (timer != 0) clearInterval(timer);
      resolve(ready);
    };
    const check = (): void => {
      attempts += 1;
      if (w.uni != null && w.uni.webView != null && w.uni.webView.navigateTo != null) finish(true);
      else if (attempts >= 60) finish(false);
    };
    timer = setInterval(check, 50) as number;
    try {
      const script = w.document.createElement('script');
      script.src = './static/uni.webview.1.5.5.js';
      script.onload = check;
      script.onerror = (): void => { finish(false); };
      w.document.head.appendChild(script);
    } catch (_error) {
      finish(false);
    }
  });
  const result = pendingSdk!;
  return result.then((ready: boolean): boolean => { pendingSdk = null; return ready; });
  // #endif
  return Promise.resolve(false);
}
