<template>
  <!--
    预约会议（伙伴页「会议」tab 的第三个入口）。

    ★★字段顺序、文案、placeholder、提示语一律照抄 PC `MeetingPane.tsx` 预约弹窗
    （会议主题 → 开始时间 → 会议号 → 允许游客加入 → 允许提前进入 → 入会密码（可选）
    → 添加参与者 → 保存）。PC 没有的字段（如「会议类型」）移动端也不放：
    两边看到的东西必须能一一对上，加字段先改 PC。

    ★预约落服务端（POST /meetings/schedules → im_meeting, status=0）：
    换设备/多端登录看到的是同一条，不再是「本机私人名单」。

    ★会议号与分享 slug 在**进页那一刻**生成并随保存带给服务端：用户可能先复制邀请
    发出去，服务端另起一个号会让刚发出去的链接立刻失效。点「换一个」时两者一起换
    （同 PC rollNewNo），只换号不换 slug 会留下一条指向旧号的邀请链接。

    ★开始时间用原生 <picker mode="date"> + <picker mode="time">：底部弹出的
    年月日 / 时分选择器，比手输字符串少一类格式错误。日期 picker 的 start 卡在今天，
    避免选到过去；真正的「不能早于现在」仍在提交前校验（同日选早于当前时刻的情况
    picker 拦不住）。
  -->
  <view class="ms-page">
    <safety-zone />
    <!-- 前台会议邀请条：本页可能位于栈顶，需自挂一份（见 im-meeting-home 同款注释）。 -->
    <meeting-invite-banner />

    <view class="ms-header">
      <view class="ms-header__btn" hover-class="ms-header__btn--active" @click="handleBack">
        <back-chevron :size="20" color="#141416" />
      </view>
      <view class="ms-header__title-wrap">
        <text class="ms-header__title">{{ t("Mobile.Meeting.schedule") }}</text>
      </view>
      <view class="ms-header__btn ms-header__btn--ghost" />
    </view>

    <scroll-view class="ms-body" direction="vertical" :show-scrollbar="false">
      <!-- 会议主题 -->
      <view class="ms-card">
        <text class="ms-label">{{ t("Mobile.Meeting.titleLabel") }}</text>
        <input
          class="ms-input"
          v-model="titleText"
          :maxlength="60"
          :placeholder="t('Mobile.Meeting.scheduleTitlePlaceholder')"
          placeholder-style="color:#b0aebc;font-size:14px"
        />
      </view>

      <!-- 开始时间：点击拉起原生底部选择器（日期 + 时间两段） -->
      <view class="ms-card">
        <text class="ms-label">{{ t("Mobile.Meeting.startTimeLabel") }}</text>
        <view class="ms-pick-row">
          <view class="ms-pick-col">
            <picker
              class="ms-pick"
              mode="date"
              :value="dateText"
              :start="dateFloor"
              @change="handleDateChange"
            >
              <view class="ms-pick__box">
                <svg-icon name="icon-Calendar" size="15" unit="px" color="#8e8c99" />
                <text class="ms-pick__text">{{ dateText }}</text>
                <svg-icon name="icon-a-Chevrondown" size="11" unit="px" color="#b0aebc" />
              </view>
            </picker>
          </view>
          <view class="ms-pick-col ms-pick-col--last">
            <picker
              class="ms-pick"
              mode="time"
              :value="timeText"
              @change="handleTimeChange"
            >
              <view class="ms-pick__box">
                <svg-icon name="icon-Clock" size="15" unit="px" color="#8e8c99" />
                <text class="ms-pick__text">{{ timeText }}</text>
                <svg-icon name="icon-a-Chevrondown" size="11" unit="px" color="#b0aebc" />
              </view>
            </picker>
          </view>
        </view>
      </view>

      <!-- 会议号：换一个 / 复制 / 复制邀请（同 PC meeting-no-row） -->
      <view class="ms-card">
        <text class="ms-label">{{ t("Mobile.Meeting.roomNoLabel") }}</text>
        <text class="ms-no">{{ formattedRoom }}</text>
        <view class="ms-no-actions">
          <view class="ms-text-btn" hover-class="ms-text-btn--active" @click="handleRollRoomNo">
            <text class="ms-text-btn__text">{{ t("Mobile.Meeting.rollRoomNo") }}</text>
          </view>
          <view class="ms-text-btn" hover-class="ms-text-btn--active" @click="handleCopyNo">
            <text class="ms-text-btn__text">{{ t("Mobile.Meeting.copyNoShort") }}</text>
          </view>
          <view class="ms-text-btn" hover-class="ms-text-btn--active" @click="handleCopyInvite">
            <text class="ms-text-btn__text">{{ t("Mobile.Meeting.copyInvite") }}</text>
          </view>
        </view>
      </view>

      <!-- 允许游客加入（提示语随开关两态，文案同 PC） -->
      <view class="ms-card ms-card--row">
        <view class="ms-row-main">
          <text class="ms-label ms-label--inline">{{ t("Mobile.Meeting.allowGuestLabel") }}</text>
          <text class="ms-hint">{{ allowGuest ? t("Mobile.Meeting.allowGuestHintOn") : t("Mobile.Meeting.allowGuestHintOff") }}</text>
        </view>
        <switch class="ms-switch" :checked="allowGuest" color="#5147ff" @change="handleAllowGuestChange" />
      </view>

      <!-- 允许提前进入 -->
      <view class="ms-card ms-card--row">
        <view class="ms-row-main">
          <text class="ms-label ms-label--inline">{{ t("Mobile.Meeting.earlyJoinLabel") }}</text>
          <text class="ms-hint">{{ allowEarlyJoin ? t("Mobile.Meeting.earlyJoinHintOn") : t("Mobile.Meeting.earlyJoinHintOff") }}</text>
        </view>
        <switch class="ms-switch" :checked="allowEarlyJoin" color="#5147ff" @change="handleEarlyJoinChange" />
      </view>

      <!-- 入会密码（可选） -->
      <view class="ms-card">
        <text class="ms-label">{{ t("Mobile.Meeting.passcodeOptionalLabel") }}</text>
        <input
          class="ms-input"
          v-model="passcode"
          type="number"
          :maxlength="6"
          :placeholder="t('Mobile.Meeting.passcodePlaceholder')"
          placeholder-style="color:#b0aebc;font-size:14px"
        />
        <text class="ms-hint">{{ passcode.length > 0 ? t("Mobile.Meeting.passcodeHintOn") : t("Mobile.Meeting.passcodeHintOff") }}</text>
      </view>

      <!-- 添加参与者：选人盒与「创建群组 → 用户」页**同一套**（灰盒 + 已选芯片 + 尾部输入 +
           右侧放大镜）；聚焦即在下方展开候选面板，可直接搜索、多选。
           ★样式与交互逐项对齐 cg-tagbox / cg-tagbox-field（含 Android 去掉下内边距、
             输入外固定 32px 高行槽这两处真机踩过的细节），改这里请对照建群页一起改。 -->
      <view class="ms-card">
        <text class="ms-label">{{ t("Mobile.Meeting.participantsLabel") }}</text>
        <view class="ms-tagbox" @click="focusInviteeBox">
          <view class="ms-tagbox-main">
            <view
              v-for="p in inviteeTags"
              :key="p.userId"
              class="ms-tag"
              hover-class="ms-tag--active"
              @click.stop="removeInvitee(p)"
            >
              <text class="ms-tag__text">{{ p.displayName }}</text>
              <text class="ms-tag__x">×</text>
            </view>
            <view class="ms-tagbox-field">
              <input
                class="ms-tagbox-input"
                v-model="inviteeKeyword"
                :focus="inviteeFocusRequest"
                :placeholder="t('Mobile.Meeting.participantsSearchPlaceholder')"
                placeholder-class="ms-ph"
                @focus="handleInviteeFocus"
                @blur="handleInviteeBlur"
              />
            </view>
          </view>
          <view class="ms-search-icon">
            <svg-icon name="icon-Search" size="14" unit="px" color="#9a9aa2" />
          </view>
        </view>

        <!-- 候选面板：聚焦即展开，输入框失焦即收起（延迟 180ms 收，避免「点结果」那一下
             被 v-if 卸载点空；点中行会撤掉这次收起，选中不收起）。
             面板给了固定最大高并自带滚动，不会把「保存」推到屏幕之外。 -->
        <view v-if="inviteePanelVisible" class="ms-panel">
          <scroll-view class="ms-panel-list" direction="vertical" :show-scrollbar="false" :style="{ height: inviteeListHeight }">
            <view v-if="inviteeListState == 'loading'" class="ms-panel-state">
              <text class="ms-panel-state__text">{{ t("Mobile.Common.loading") }}</text>
            </view>
            <view v-else-if="inviteeListState == 'failed'" class="ms-panel-state" @click="retryInviteeList">
              <text class="ms-panel-state__text">{{ t("Mobile.Meeting.participantsLoadFailed") }}</text>
            </view>
            <view v-else-if="inviteeView.length == 0" class="ms-panel-state">
              <text class="ms-panel-state__text">{{ inviteeHasKeyword ? t("Mobile.AgentSearch.emptyResult") : t("Mobile.Meeting.participantsEmpty") }}</text>
            </view>
            <view v-else class="ms-panel-body">
              <view
                v-for="p in inviteeView"
                :key="p.userId"
                class="ms-panel-row"
                hover-class="ms-panel-row--active"
                @click="toggleInvitee(p)"
              >
                <text class="ms-panel-row__name text-ellipsis">{{ p.displayName }}</text>
                <view class="ms-panel-check" :class="{ 'ms-panel-check--on': isInviteeSelected(p.userId) }">
                  <svg-icon v-if="isInviteeSelected(p.userId)" name="icon-Check" size="12" unit="px" color="#ffffff" />
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="ms-submit">
        <view
          class="ms-primary"
          :class="{ 'ms-primary--disabled': submitting }"
          hover-class="ms-primary--active"
          @click="handleSubmit"
        >
          <text class="ms-primary__text">{{ submitting ? t("Mobile.Meeting.scheduling") : t("Mobile.Meeting.submitSchedule") }}</text>
        </view>
      </view>

      <view class="ms-tail" />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { computed, nextTick, onUnmounted, ref, watch } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { getApiBaseUrl } from "@/constants/config";
  import { apiImContacts, apiImSearchContacts } from "@/servers/im";
  import { apiImMeetingSchedule, IM_MEETING_CHANGED_EVENT } from "@/servers/imMeeting";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  // 会议数据变更广播（走仓内 eventBus，见 servers/imMeeting.uts 常量声明处）
  import eventBus from "@/utils/eventBus";
  import MeetingInviteBanner from "@/components/meeting-invite-banner/meeting-invite-banner.uvue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { getCachedMyInfo } from "@/utils/im/myInfoCache";
  import {
    buildMeetingInviteText,
    buildMeetingInviteUrl,
    formatMeetingId,
    makeMeetingNo,
    makeShareSlug,
  } from "@/utils/meeting/meetingLink";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 参与者行（搜索结果与已选共用；只取 id + 展示名，选择器不画头像——
   *  鸿蒙隐藏 page-container 内的 <image> 有不上屏的先例，这里没有头像就没有这类风险）。 */
  class MeetingInvitee {
    userId: string = "";
    displayName: string = "";
  }

  let shareSlug = "";
  const roomName = ref<string>("");
  const titleText = ref<string>("");
  const dateText = ref<string>("");
  const timeText = ref<string>("");
  const allowGuest = ref<boolean>(false);
  /** 允许提前进入：默认开（与 PC openSchedule 复位口径一致）。 */
  const allowEarlyJoin = ref<boolean>(true);
  const passcode = ref<string>("");
  const submitting = ref<boolean>(false);
  /** 日期 picker 可选下界（今天），只拦「选到上个月」这种明显错误。 */
  const dateFloor = ref<string>("");

  const formattedRoom = computed((): string => formatMeetingId(roomName.value));

  // ---------------------------------------------------------------- 参与者选择

  /** 已选参与者（跨关键字切换保持；tag 芯片与提交都用它）。 */
  const invitees = ref<MeetingInvitee[]>([]);
  /** 我的联系人（打开面板时拉一次，status=1 且是真人，已排除自己）。 */
  const inviteePool = ref<MeetingInvitee[]>([]);
  /** idle | loading | ready | failed */
  const inviteePoolState = ref<string>("idle");
  let inviteePoolLoading = false;
  const inviteeKeyword = ref<string>("");
  /** 远程搜索结果（本地命中排在前，远程补其后，按 userId 去重）。 */
  const inviteeRemote = ref<MeetingInvitee[]>([]);
  /** idle | loading | done | failed */
  const inviteeSearchState = ref<string>("idle");
  let inviteeSearchTimer = -1;
  let inviteeSearchSeq = 0;
  /** 候选面板是否已展开：展开期间输入框失焦就收起（见 handleInviteeBlur）。 */
  const inviteePanelVisible = ref<boolean>(false);
  /** 输入框是否真的聚焦（只看它决定要不要边沿驱动一次 focus）。 */
  const inviteeInputFocused = ref<boolean>(false);
  /** 程序化聚焦请求（同建群页 focusRequest：false→nextTick→true 才是一次新的聚焦边沿）。 */
  const inviteeFocusRequest = ref<boolean>(false);
  /** 失焦收起面板的延迟句柄（<0 = 没有待执行的收起）。
   *  ★为什么要延迟：原生 @blur 可能先于候选行 @click 派发，立刻 v-if 卸载会让那一下点空。 */
  let inviteeBlurTimer = -1;

  /** 取消待执行的「失焦收起」。点中候选行 / 重新聚焦时调用。 */
  function cancelInviteeBlurCollapse(): void {
    if (inviteeBlurTimer != -1) {
      clearTimeout(inviteeBlurTimer);
      inviteeBlurTimer = -1;
    }
  }

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  function myUserId(): string {
    const info = getCachedMyInfo();
    return info != null ? info.userId : "";
  }

  /** 联系人响应行：displayName 服务端已按 remark > nickName > userName 算好，缺键才回落。 */
  function readPoolRow(item: UTSJSONObject, selfId: string): MeetingInvitee | null {
    const row = new MeetingInvitee();
    row.userId = readString(item, "userId");
    if (row.userId.length == 0) {
      return null;
    }
    // 把自己列进「添加参与者」是纯噪音（PC 用 excludeUserIds 排掉同一个人）
    if (selfId.length > 0 && row.userId == selfId) {
      return null;
    }
    const display = readString(item, "displayName");
    const nick = readString(item, "nickName");
    row.displayName = display.length > 0 ? display : nick;
    return row;
  }

  /** 搜索响应行：ContactSearchItem 无 displayName，按 nickName > userName 回落。 */
  function readSearchRow(item: UTSJSONObject, selfId: string): MeetingInvitee | null {
    const row = new MeetingInvitee();
    row.userId = readString(item, "userId");
    if (row.userId.length == 0) {
      return null;
    }
    if (selfId.length > 0 && row.userId == selfId) {
      return null;
    }
    const nick = readString(item, "nickName");
    row.displayName = nick.length > 0 ? nick : readString(item, "userName");
    return row;
  }

  /**
   * 拉我的联系人（只在第一次打开选择面板时拉，不在进页时拉）：
   * 预约页每多一次进页请求，点「预约会议」到页面出现的那一下就更慢一分。
   */
  async function loadInviteePool(): Promise<void> {
    if (inviteePoolLoading) {
      return;
    }
    inviteePoolLoading = true;
    inviteePoolState.value = "loading";
    try {
      const res = await apiImContacts();
      if (apiResCode(res) != SUCCESS_CODE) {
        inviteePoolState.value = "failed";
        return;
      }
      const selfId = myUserId();
      const rows: MeetingInvitee[] = [];
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const item = items[i];
            // status 2/3 是待确认态，拉进会议会被服务端拒（PC 同口径只取已互为联系人）
            if (readNumber(item, "status", 1) != 1) {
              continue;
            }
            // subjectType 1=人；智能体不能当参会人
            if (readNumber(item, "subjectType", 1) != 1) {
              continue;
            }
            const row = readPoolRow(item, selfId);
            if (row != null) {
              rows.push(row);
            }
          }
        }
      }
      inviteePool.value = rows;
      inviteePoolState.value = "ready";
    } catch (_e) {
      inviteePoolState.value = "failed";
    } finally {
      inviteePoolLoading = false;
    }
  }

  /** 回初始搜索态：清防抖定时器 + 序号自增作废在途请求。 */
  function resetInviteeSearch(): void {
    if (inviteeSearchTimer != -1) {
      clearTimeout(inviteeSearchTimer);
      inviteeSearchTimer = -1;
    }
    inviteeSearchSeq++;
    inviteeSearchState.value = "idle";
    inviteeRemote.value = [];
  }

  /** 远程搜索联系人（本地没命中的才补进来，见 inviteeView）。 */
  async function doInviteeSearch(): Promise<void> {
    const kw = inviteeKeyword.value.trim();
    if (kw.length == 0) {
      resetInviteeSearch();
      return;
    }
    const seq = ++inviteeSearchSeq;
    inviteeSearchState.value = "loading";
    try {
      const res = await apiImSearchContacts(kw, 20);
      if (seq != inviteeSearchSeq) {
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        inviteeSearchState.value = "failed";
        return;
      }
      const selfId = myUserId();
      const rows: MeetingInvitee[] = [];
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const row = readSearchRow(items[i], selfId);
            if (row != null) {
              rows.push(row);
            }
          }
        }
      }
      inviteeRemote.value = rows;
      inviteeSearchState.value = "done";
    } catch (_e) {
      if (seq == inviteeSearchSeq) {
        inviteeSearchState.value = "failed";
      }
    }
  }

  /** 输入防抖 400ms（连打只发最后一次）；清空立即回默认联系人列表。 */
  watch(inviteeKeyword, (val: string) => {
    if (inviteeSearchTimer != -1) {
      clearTimeout(inviteeSearchTimer);
      inviteeSearchTimer = -1;
    }
    if (val.trim().length == 0) {
      resetInviteeSearch();
      return;
    }
    inviteeSearchTimer = setTimeout(() => {
      inviteeSearchTimer = -1;
      doInviteeSearch();
    }, 400);
  });

  /** 面板里要显示的候选：空关键字=我的联系人；有关键字=本地命中 + 远程结果（去重）。 */
  const inviteeView = computed((): MeetingInvitee[] => {
    const kw = inviteeKeyword.value.trim().toLowerCase();
    if (kw.length == 0) {
      return inviteePool.value;
    }
    const out: MeetingInvitee[] = [];
    const seen = new Map<string, boolean>();
    const local = inviteePool.value;
    for (let i = 0; i < local.length; i++) {
      const row = local[i];
      if (row.displayName.toLowerCase().indexOf(kw) >= 0) {
        out.push(row);
        seen.set(row.userId, true);
      }
    }
    const remote = inviteeRemote.value;
    for (let i = 0; i < remote.length; i++) {
      const row = remote[i];
      if (seen.get(row.userId) == true) {
        continue;
      }
      out.push(row);
      seen.set(row.userId, true);
    }
    return out;
  });

  /** 面板列表态（把「联系人加载」与「搜索」两个状态收敛成一个给模板用）。 */
  const inviteeListState = computed((): string => {
    if (inviteeKeyword.value.trim().length == 0) {
      return inviteePoolState.value;
    }
    if (inviteeRemote.value.length > 0) {
      return "ready";
    }
    if (inviteeSearchState.value == "loading" || inviteeSearchState.value == "idle") {
      return "loading";
    }
    if (inviteeSearchState.value == "failed") {
      return "failed";
    }
    return "ready";
  });

  /** 面板是否处于「有关键字」态（模板里不写 .trim() 调用链）。 */
  const inviteeHasKeyword = computed((): boolean => inviteeKeyword.value.trim().length > 0);

  /**
   * 候选列表的高度：scroll-view 竖直方向必须给定高度才滚得动。
   * 不写 `max-height`（App-uvue 的 CSS 子集对它支持不一致），改成按行数算出具体值：
   * 5 行以内按实际行高铺开（不留空），超过 5 行固定 220px 内部滚动。
   */
  const inviteeListHeight = computed((): string => {
    if (inviteeListState.value != "ready" || inviteeView.value.length == 0) {
      return "64px";
    }
    const n = inviteeView.value.length;
    return n >= 5 ? "220px" : `${n * 44 + 4}px`;
  });

  /** 表单里展示的已选 tag（截断到 12 个，避免上千人预约把表单刷爆）。 */
  const inviteeTags = computed((): MeetingInvitee[] => invitees.value.slice(0, 12));

  function isInviteeSelected(userId: string): boolean {
    const sel = invitees.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].userId == userId) {
        return true;
      }
    }
    return false;
  }

  function toggleInvitee(row: MeetingInvitee): void {
    // 点候选行时若已经吃过一次 @blur（原生 blur 先于 click），撤掉待收起并重新聚焦：
    // 面板展开期间输入框要保持聚焦（同 PC 的 antd 多选下拉——选中不收起），否则会变成
    // 「面板开着、输入框已失焦」，之后再点别处也不会再有 blur 事件，面板就再也收不起来。
    if (!inviteeInputFocused.value) {
      cancelInviteeBlurCollapse();
      inviteeFocusRequest.value = false;
      nextTick((): void => {
        inviteeFocusRequest.value = true;
      });
    }
    const next: MeetingInvitee[] = [];
    let removed = false;
    const sel = invitees.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].userId == row.userId) {
        removed = true;
      } else {
        next.push(sel[i]);
      }
    }
    if (removed != true) {
      // 与 PC MAX_INVITEES 同口径：50 人
      if (next.length >= 50) {
        uni.showToast({ title: t("Mobile.Meeting.inviteesLimit"), icon: "none" });
        return;
      }
      next.push(row);
      // 选中即清关键词：回到默认联系人列表（与建群页 toggleMember 同一手感）
      if (inviteeKeyword.value.length > 0) {
        inviteeKeyword.value = "";
      }
    }
    invitees.value = next;
  }

  function removeInvitee(row: MeetingInvitee): void {
    toggleInvitee(row);
  }

  /** 点选人盒（任意空白处）：展开面板 + 首次展开才拉联系人 + 未聚焦时边沿驱动拉起键盘。 */
  function focusInviteeBox(): void {
    cancelInviteeBlurCollapse();
    inviteePanelVisible.value = true;
    // 懒加载：进页不发请求，第一次用到联系人时才拉
    if (inviteePoolState.value != "ready" && inviteePoolState.value != "loading") {
      loadInviteePool();
    }
    if (inviteeInputFocused.value) {
      return;
    }
    inviteeFocusRequest.value = false;
    nextTick((): void => {
      inviteeFocusRequest.value = true;
    });
  }

  /** input 原生聚焦：记录聚焦态 + 展开面板（直接点 input 本体的双保险）。 */
  function handleInviteeFocus(): void {
    inviteeInputFocused.value = true;
    inviteePanelVisible.value = true;
    if (inviteePoolState.value != "ready" && inviteePoolState.value != "loading") {
      loadInviteePool();
    }
  }

  /** input 失焦：收起候选面板。
   *  ★延迟 180ms 收：原生 @blur 可能先于候选行 @click 派发，当场 v-if 卸载会让那一下点空；
   *  延迟窗内点中行（toggleInvitee）会撤掉这次收起，多选/边搜边选仍是一路点下去。
   *  ★窗内重新聚焦（点输入框/选人盒）也不收——判据看 inviteeInputFocused。 */
  function handleInviteeBlur(): void {
    inviteeInputFocused.value = false;
    inviteeFocusRequest.value = false;
    cancelInviteeBlurCollapse();
    inviteeBlurTimer = setTimeout(() => {
      inviteeBlurTimer = -1;
      if (inviteeInputFocused.value) {
        return;
      }
      inviteePanelVisible.value = false;
    }, 180);
  }

  function retryInviteeList(): void {
    if (inviteeKeyword.value.trim().length > 0) {
      doInviteeSearch();
      return;
    }
    loadInviteePool();
  }

  // ---------------------------------------------------------------- 时间与格式化

  function pad2(value: number): string {
    return value < 10 ? `0${value}` : `${value}`;
  }

  function dateTextOf(offsetDays: number): string {
    const d = new Date(Date.now() + offsetDays * 86400000);
    return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  }

  /** 当前本地时间（同格式字符串）：字符串比较即时间先后，避免 iOS 对日期串解析不一致。 */
  function nowText(): string {
    const d = new Date();
    return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())} ${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
  }

  /** 日期串合法性：yyyy-MM-dd 形状 + 月 01-12 / 日 01-31（2 月 30 这类交给服务端）。 */
  function isValidDate(text: string): boolean {
    if (text.length != 10 || text.charAt(4) != "-" || text.charAt(7) != "-") {
      return false;
    }
    for (let i = 0; i < text.length; i++) {
      if (i == 4 || i == 7) {
        continue;
      }
      const c = text.charCodeAt(i)!!;
      if (c < 48 || c > 57) {
        return false;
      }
    }
    const month = parseInt(text.substring(5, 7));
    const day = parseInt(text.substring(8, 10));
    if (isNaN(month) || isNaN(day)) {
      return false;
    }
    return month >= 1 && month <= 12 && day >= 1 && day <= 31;
  }

  /** 时间串合法性：HH:mm，两位小时（00-23）与两位分钟（00-59）。 */
  function isValidTime(text: string): boolean {
    if (text.length != 5 || text.charAt(2) != ":") {
      return false;
    }
    const hh = parseInt(text.substring(0, 2));
    const mm = parseInt(text.substring(3, 5));
    if (isNaN(hh) || isNaN(mm)) {
      return false;
    }
    return hh >= 0 && hh <= 23 && mm >= 0 && mm <= 59;
  }

  /** 入会密码：4-6 位纯数字（不用 RegExp——三端实现不一致，见 meetingLink 注释）。 */
  function isValidPasscode(text: string): boolean {
    if (text.length < 4 || text.length > 6) {
      return false;
    }
    for (let i = 0; i < text.length; i++) {
      const c = text.charCodeAt(i)!!;
      if (c < 48 || c > 57) {
        return false;
      }
    }
    return true;
  }

  /** 选择器回传值（UniPickerChangeEvent.detail.value 类型是 any，
   *  date 模式给 "yyyy-MM-dd"、time 模式给 "HH:mm"，统一按字符串读）。 */
  function pickerValueOf(event: any): string {
    const pe = event as UniPickerChangeEvent;
    return `${pe.detail.value}`;
  }

  function handleDateChange(event: any): void {
    const value = pickerValueOf(event);
    if (isValidDate(value)) {
      dateText.value = value;
    }
  }

  function handleTimeChange(event: any): void {
    const value = pickerValueOf(event);
    if (isValidTime(value)) {
      timeText.value = value;
    }
  }

  // ---------------------------------------------------------------- 交互

  function handleBack(): void {
    uni.navigateBack({ delta: 1 });
  }

  /** 换一个号：★号与分享 slug 必须一起换（同 PC rollNewNo），
   *  否则「复制邀请」发出去的链接还指着上一个号。 */
  function handleRollRoomNo(): void {
    roomName.value = makeMeetingNo(Math.floor(Math.random() * 1000000000));
    shareSlug = makeShareSlug();
  }

  function handleAllowGuestChange(event: any): void {
    const se = event as UniSwitchChangeEvent;
    allowGuest.value = se.detail.value;
  }

  function handleEarlyJoinChange(event: any): void {
    const se = event as UniSwitchChangeEvent;
    allowEarlyJoin.value = se.detail.value;
  }

  function copyText(data: string, toastText: string): void {
    if (data.length == 0) {
      return;
    }
    uni.setClipboardData({
      data,
      success: (_res) => {
        uni.showToast({ title: toastText, icon: "none" });
      },
    });
  }

  function handleCopyNo(): void {
    copyText(roomName.value, t("Mobile.Meeting.noCopied"));
  }

  /** 邀请文案逐行换行（会议主题 / 会议号 / 可选入会密码 / 链接），版式与 PC 逐字一致。 */
  function handleCopyInvite(): void {
    const url = buildMeetingInviteUrl(getApiBaseUrl(), shareSlug);
    const info = getCachedMyInfo();
    const who = info != null ? info.displayName : "";
    copyText(
      buildMeetingInviteText(who, titleText.value.trim(), roomName.value, url, passcode.value.trim()),
      t("Mobile.Meeting.copied"),
    );
  }

  async function handleSubmit(): Promise<void> {
    if (submitting.value) {
      return;
    }
    const date = dateText.value.trim();
    const time = timeText.value.trim();
    if (!isValidDate(date) || !isValidTime(time)) {
      uni.showToast({ title: t("Mobile.Meeting.invalidTime"), icon: "none" });
      return;
    }
    const startAt = `${date} ${time}`;
    if (startAt <= nowText()) {
      uni.showToast({ title: t("Mobile.Meeting.timePast"), icon: "none" });
      return;
    }
    const pwd = passcode.value.trim();
    if (pwd.length > 0 && !isValidPasscode(pwd)) {
      uni.showToast({ title: t("Mobile.Meeting.passcodeInvalid"), icon: "none" });
      return;
    }
    submitting.value = true;
    try {
      const ids: string[] = [];
      const sel = invitees.value;
      for (let i = 0; i < sel.length; i++) {
        ids.push(sel[i].userId);
      }
      const body: UTSJSONObject = {};
      body["title"] = titleText.value.trim();
      // ★沿用进页生成的号与 slug：复制出去的邀请链接必须仍然有效
      body["roomName"] = roomName.value;
      body["startAt"] = startAt;
      // ★PC 的预约弹窗没有「会议类型」：一律语音开局，进会后点「开视频」即可
      body["meetingType"] = 1;
      body["allowGuest"] = allowGuest.value;
      body["allowEarlyJoin"] = allowEarlyJoin.value;
      // 空串=不设密码（不要传 null：服务端语义是「不传=不改」）
      body["joinPasscode"] = pwd;
      body["shareSlug"] = shareSlug;
      // ★userId 是 int64 雪花号，但 PC 同样按字符串数组提交（服务端 DTO 为 List<Long>，可强转）
      if (ids.length > 0) {
        body["inviteeUserIds"] = ids;
      }

      const res = await apiImMeetingSchedule(body);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Meeting.failed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Meeting.scheduled"), icon: "none" });
      // 等 toast 露出再退；**退栈后**再广播——伙伴页会议 tab 此时才可见，
      // 广播早于退栈的话那次重拉是在本页覆盖期间发出的，回包可能赶在服务端写入
      // 对读请求可见之前，回到会议页就看不到刚建的预约。
      setTimeout(() => {
        uni.navigateBack({ delta: 1 });
        setTimeout(() => {
          eventBus.emit(IM_MEETING_CHANGED_EVENT, {});
        }, 260);
      }, 300);
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Meeting.failed"), icon: "none" });
    } finally {
      submitting.value = false;
    }
  }

  // ---------------------------------------------------------------- 生命周期
  // ★放在最后：uvue 的同级函数不支持前向引用（被调用的必须排在调用者之前）

  onLoad((_options: any) => {
    dateFloor.value = dateTextOf(0);
    handleRollRoomNo();
    // 默认给「下一个整点」：绝大多数预约都不是现在就开始（对齐 PC）
    const next = new Date(Date.now() + 3600000);
    dateText.value = `${next.getFullYear()}-${pad2(next.getMonth() + 1)}-${pad2(next.getDate())}`;
    timeText.value = `${pad2(next.getHours())}:00`;
  });

  onUnmounted(() => {
    if (inviteeSearchTimer != -1) {
      clearTimeout(inviteeSearchTimer);
      inviteeSearchTimer = -1;
    }
    cancelInviteeBlurCollapse();
  });
</script>

<style lang="scss" scoped>
