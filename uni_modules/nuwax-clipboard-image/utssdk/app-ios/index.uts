// nuwax-clipboard-image · app-ios
//
import type {
  ClipboardImageFailureCallback,
  ClipboardImageSuccessCallback,
  ClipboardProbeCallback,
} from "../interface.uts";

// 聊天页「粘贴剪贴板图片」的 iOS 实现：同目录 ClipboardImageBridge.swift。
// - 探测：UIPasteboard.hasImages / changeCount 均为元数据访问，不触发 iOS 14+ 粘贴隐私提示
// - 读取：取 PNG/JPEG 原始字节（或 UIImage 重压 JPEG）写沙盒 tmp 后回传绝对路径；
//   首次真正读数据时 iOS 16+ 弹系统「允许粘贴」（微信同款），拒绝时回 EMPTY
//
// 混编约定（同 nuwax-ios-file-picker）：Swift 文件的 public 类对本文件直接可见，
// 无需 import；回调按位置对应（无标签参数）。

/** 探测剪贴板是否含图片（元数据级，免费不弹提示）；fingerprint=changeCount 去重指纹。 */
export function probeClipboardImage(onResult: ClipboardProbeCallback): void {
  onResult(ClipboardImageBridge.hasImage(), ClipboardImageBridge.clipFingerprint());
}

/**
 * 读取剪贴板图片写入 tmp 缓存文件，回传绝对路径。
 * @UTSJS.keepAlive 回调被原生块持有到写文件完成，须防回收。
 */
@UTSJS.keepAlive
export function readClipboardImageFile(
  success: ClipboardImageSuccessCallback,
  fail: ClipboardImageFailureCallback,
): void {
  ClipboardImageBridge.readImage(success, fail);
}
