<template>
  <view class="provision-wifi">
    <custom-nav-bar :title="t('Mobile.Provision.Wifi.title')" :show-back="true" :has-safety-zone="true" />

    <scroll-view class="provision-wifi__scroll" :scroll-y="true" :scroll-into-view="scrollTarget">
      <view class="provision-wifi__inner">
      <!-- 目标设备 -->
      <view v-if="deviceName != ''" class="provision-wifi__device">
        <text class="provision-wifi__device-name">{{ deviceName }}</text>
      </view>

      <!-- 重配提示 -->
      <text v-if="isReprovision" class="provision-wifi__reprovision-tip">{{ t('Mobile.Provision.Wifi.reprovisionTip') }}</text>

      <!-- 设备发现的 WiFi 列表 -->
      <view v-if="showDeviceNetworks" class="network-section">
        <text class="network-section__label">{{ t('Mobile.Provision.Wifi.selectWifi') }}</text>
        <view v-if="networksLoading" class="network-loading">
          <text class="network-loading__text">{{ t('Mobile.Provision.Wifi.scanning') }}</text>
        </view>
        <template v-else>
          <view
            v-for="network in deviceNetworks"
            :key="network.ssid"
            :class="['network-item', selectedSsid == network.ssid ? 'network-item--selected' : '']"
            hover-class="network-item--hover"
            @tap="selectNetwork(network)"
          >
            <view class="network-item__info">
              <text class="network-item__ssid">{{ network.ssid }}</text>
              <view class="network-item__meta">
                <text v-if="network.security != 0" class="network-item__lock">🔒</text>
                <text :class="['network-item__rssi', network.rssi < -70 ? 'network-item__rssi--weak' : '']">
                  {{ network.rssi < -70 ? t('Mobile.Provision.Scan.signalWeak') : '📶' }}
                </text>
              </view>
            </view>
            <view v-if="selectedSsid == network.ssid" class="network-item__check">
              <text class="network-item__check-icon">✓</text>
            </view>
          </view>

          <!-- 选中设备 WiFi 后的密码输入 -->
          <view id="pwd-form" v-if="selectedSsid != ''" class="form form--inline">
            <view class="form__field">
              <text class="form__label">{{ t('Mobile.Provision.Wifi.passwordLabel') }}</text>
              <view class="form__pwd">
                <input
                  class="form__input form__input--pwd"
                  v-model="password"
                  :password="!showPassword"
                  :placeholder="t('Mobile.Provision.Wifi.passwordPlaceholder')"
                  placeholder-class="form__placeholder"
                />
                <text class="form__eye" @tap="showPassword = !showPassword">{{ showPassword ? '🙈' : '👁' }}</text>
              </view>
            </view>
          </view>
        </template>
      </view>

      <!-- 手动输入区（无设备列表或用户选择手动时显示） -->
      <view v-if="!showDeviceNetworks" class="form">
        <view class="form__field">
          <text class="form__label">{{ t('Mobile.Provision.Wifi.ssidLabel') }}</text>
          <input
            class="form__input"
            v-model="ssid"
            :placeholder="t('Mobile.Provision.Wifi.ssidPlaceholder')"
            placeholder-class="form__placeholder"
          />
        </view>

        <view class="form__field">
          <text class="form__label">{{ t('Mobile.Provision.Wifi.passwordLabel') }}</text>
          <view class="form__pwd">
            <input
              class="form__input form__input--pwd"
              v-model="password"
              :password="!showPassword"
              :placeholder="t('Mobile.Provision.Wifi.passwordPlaceholder')"
              placeholder-class="form__placeholder"
            />
            <text class="form__eye" @tap="showPassword = !showPassword">{{ showPassword ? '🙈' : '👁' }}</text>
          </view>
        </view>

        <!-- 使用当前 WiFi -->
        <view class="form__current" @tap="useCurrentWifi">
          <text class="form__current-text">{{ t('Mobile.Provision.Wifi.useCurrent') }}</text>
        </view>

        <text v-if="currentFailed" class="form__warn">{{ t('Mobile.Provision.Wifi.currentFailed') }}</text>
      </view>

      <!-- 手动输入切换链接（有设备列表时显示） -->
      <view v-if="showDeviceNetworks && selectedSsid == ''" class="manual-link" @tap="switchToManual">
        <text class="manual-link__text">{{ t('Mobile.Provision.Wifi.manualInput') }}</text>
      </view>

      <text class="form__band-tip">{{ t('Mobile.Provision.Wifi.bandTip') }}</text>
      <text v-if="errorTip != ''" class="form__error">{{ errorTip }}</text>
      </view>
    </scroll-view>

    <!-- 开始配网（固定底部，不随列表滚动） -->
    <view class="provision-wifi__footer">
      <view class="provision-wifi__start" :class="{ 'provision-wifi__start--disabled': !canStart }" @tap="startProvision">
        <text class="provision-wifi__start-text">{{ t('Mobile.Provision.Wifi.start') }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { ref, computed } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { getProvisionDevice, setProvisionCredentials, getReprovisionTarget } from "@/utils/provisionSession";
  import { WifiCredentials } from "@/types/interfaces/provision";
  import { getCurrentWifiSsid } from "@/utils/wifiInfo";
  import { validateSsid, validatePassword } from "@/utils/provisionProtocol";
  import { useEspProvisioning } from "@/hooks/useEspProvisioning";
  import { EspWifiNetwork } from "@/types/interfaces/espProvisioning";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const controller = useEspProvisioning();

  const ssid = ref<string>("");
  const password = ref<string>("");
  const showPassword = ref<boolean>(false);
  const currentFailed = ref<boolean>(false);
  const errorTip = ref<string>("");
  const deviceName = ref<string>("");
  const isReprovision = ref<boolean>(false);

  // 设备端 WiFi 列表
  const deviceNetworks = ref<EspWifiNetwork[]>([]);
  const networksLoading = ref<boolean>(true);
  const selectedSsid = ref<string>("");
  // 选中 WiFi 后滚动到密码输入框的锚点 id
  const scrollTarget = ref<string>("");
  const forceManual = ref<boolean>(false);
  // 设备端扫描/配网串行锁：开始配网前必须等当前 prov-scan 释放（契约 §5，不得并发）
  const scanPromise = ref<Promise<void> | null>(null);

  // 有设备列表且用户未强制手动时，显示设备列表区
  const showDeviceNetworks = computed((): boolean => {
    return !forceManual.value && deviceNetworks.value.length > 0;
  });

  const canStart = computed((): boolean => {
    if (showDeviceNetworks.value) {
      return selectedSsid.value != "" && validatePassword(password.value);
    }
    return ssid.value.trim().length > 0 && validatePassword(password.value);
  });

  const loadDeviceNetworks = async () => {
    networksLoading.value = true;
    try {
      const list = await controller.scanDeviceNetworks();
      // 过滤空 SSID，按信号降序
      const filtered: EspWifiNetwork[] = [];
      for (let i = 0; i < list.length; i++) {
        if (list[i].ssid.trim() != "") {
          filtered.push(list[i]);
        }
      }
      filtered.sort((a: EspWifiNetwork, b: EspWifiNetwork): number => b.rssi - a.rssi);
      deviceNetworks.value = filtered;
    } catch (e) {
      console.error("loadDeviceNetworks error", e);
      deviceNetworks.value = [];
    } finally {
      networksLoading.value = false;
    }
  };

  const selectNetwork = (network: EspWifiNetwork) => {
    selectedSsid.value = network.ssid;
    ssid.value = "";
    errorTip.value = "";
    // 选中后滚动到密码输入，避免被长列表挤到屏外
    scrollTarget.value = "pwd-form";
  };

  const switchToManual = () => {
    forceManual.value = true;
    selectedSsid.value = "";
    ssid.value = "";
    errorTip.value = "";
  };

  const useCurrentWifi = async () => {
    currentFailed.value = false;
    const current = await getCurrentWifiSsid();
    if (current != "") {
      ssid.value = current;
    } else {
      currentFailed.value = true;
    }
  };

  const startProvision = async () => {
    errorTip.value = "";
    // 契约 §5：prov-scan 与配网不得并发，开始配网前等当前扫描释放
    const pendingScan = scanPromise.value;
    if (networksLoading.value && pendingScan != null) {
      await pendingScan;
    }
    const finalSsid = showDeviceNetworks.value && selectedSsid.value != "" ? selectedSsid.value : ssid.value.trim();
    if (!validateSsid(finalSsid)) {
      errorTip.value = t("Mobile.Provision.Wifi.ssidInvalid");
      return;
    }
    if (!validatePassword(password.value)) {
      errorTip.value = t("Mobile.Provision.Wifi.passwordInvalid");
      return;
    }
    // 凭据经内存态传递（不走 URL query）
    setProvisionCredentials(new WifiCredentials(finalSsid, password.value));
    uni.navigateTo({ url: "/subpackages/pages/provision/provision-progress/provision-progress" });
  };

  onLoad((_options: OnLoadOptions) => {
    const device = getProvisionDevice();
    // 扫码链路 session 无 device，从 controller 的 deviceInfo 取 serialNumber
    if (device != null) {
      deviceName.value = device.name != "" ? device.name : device.deviceId;
    } else {
      const info = controller.deviceInfo.value;
      deviceName.value = info != null && info.productModel != "" ? info.productModel : (info != null ? info.serialNumber : "");
    }
    isReprovision.value = getReprovisionTarget() != null;
    // 重配场景不预填当前 WiFi（让用户从设备列表选新的）
    if (!isReprovision.value) {
      useCurrentWifi();
    }
    scanPromise.value = loadDeviceNetworks();
  });
</script>

<style lang="scss" scoped>
  .provision-wifi {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;

    &__scroll {
      flex: 1;
    }

    &__inner {
      display: flex;
      flex-direction: column;
      padding: 32rpx;
    }

    &__device {
      margin-bottom: 24rpx;
    }

    &__device-name {
      font-size: 26rpx;
      color: #999;
    }

    &__reprovision-tip {
      font-size: 26rpx;
      color: #5147ff;
      background-color: rgba(81, 71, 255, 0.08);
      border-radius: 12rpx;
      padding: 20rpx 24rpx;
      margin-bottom: 24rpx;
      text-align: center;
    }

    &__footer {
      padding: 32rpx 0;
    }

    &__start {
      background-color: #5147ff;
      border-radius: 48rpx;
      padding: 28rpx 0;
      display: flex;
      align-items: center;
      justify-content: center;

      &--disabled {
        opacity: 0.4;
      }
    }

    &__start-text {
      color: #ffffff;
      font-size: 32rpx;
      font-weight: 500;
    }
  }

  .network-section {
    margin-bottom: 24rpx;

    &__label {
      font-size: 26rpx;
      color: #999;
      margin-bottom: 16rpx;
      display: flex;
    }
  }

  .network-loading {
    background-color: #ffffff;
    border-radius: 20rpx;
    padding: 60rpx 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;

    &__text {
      font-size: 28rpx;
      color: #999;
    }
  }

  .network-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: #ffffff;
    border-radius: 16rpx;
    padding: 28rpx 32rpx;
    margin-bottom: 16rpx;
    border: 2rpx solid transparent;

    &--hover {
      background-color: #f5f5f5;
    }

    &--selected {
      border-color: #5147ff;
      background-color: rgba(81, 71, 255, 0.04);
    }

    &__info {
      flex: 1;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    &__ssid {
      font-size: 30rpx;
      color: #1a1a1a;
      font-weight: 500;
    }

    &__meta {
      display: flex;
      flex-direction: row;
      align-items: center;
    }

    &__lock {
      font-size: 24rpx;
      margin-right: 12rpx;
    }

    &__rssi {
      font-size: 24rpx;
      color: #4cd964;

      &--weak {
        color: #f0ad4e;
      }
    }

    &__check {
      width: 40rpx;
      height: 40rpx;
      border-radius: 50%;
      background-color: #5147ff;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-left: 16rpx;
    }

    &__check-icon {
      color: #ffffff;
      font-size: 24rpx;
    }
  }

  .manual-link {
    padding: 24rpx 0;
    display: flex;
    align-items: center;
    justify-content: center;

    &__text {
      font-size: 26rpx;
      color: #5147ff;
    }
  }

  .form {
    background-color: #ffffff;
    border-radius: 20rpx;
    padding: 32rpx;

    &--inline {
      margin-top: 16rpx;
    }

    &__field {
      margin-bottom: 32rpx;

      &:last-child {
        margin-bottom: 0;
      }
    }

    &__label {
      font-size: 26rpx;
      color: #999;
      margin-bottom: 16rpx;
      display: flex;
    }

    &__input {
      font-size: 32rpx;
      color: #333;
      height: 72rpx;
      border-bottom: 1rpx solid #eee;

      &--pwd {
        flex: 1;
        border-bottom: none;
      }
    }

    &__placeholder {
      color: #c0c0c0;
      font-size: 32rpx;
    }

    &__pwd {
      display: flex;
      flex-direction: row;
      align-items: center;
      border-bottom: 1rpx solid #eee;
      height: 72rpx;
    }

    &__eye {
      font-size: 32rpx;
      padding: 0 8rpx;
    }

    &__current {
      margin-top: 24rpx;
    }

    &__current-text {
      font-size: 26rpx;
      color: #5147ff;
    }

    &__warn {
      font-size: 24rpx;
      color: #f0ad4e;
      margin-top: 16rpx;
      display: flex;
    }

    &__band-tip {
      font-size: 24rpx;
      color: #999;
      margin-top: 24rpx;
      line-height: 1.5;
      display: flex;
    }

    &__error {
      font-size: 26rpx;
      color: #dd524d;
      margin-top: 16rpx;
      display: flex;
    }
  }
</style>
