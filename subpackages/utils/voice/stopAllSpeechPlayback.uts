/**
 * 打断当前所有语音播报（流式 / 工具栏 TTS / 音频队列）。
 * H5 / App / 小程序共用；发送新消息、停止会话、离开页面时调用。
 */
import { audioPlayerManager } from "./audioPlayerManager";
import { ttsWebSocketPlayer } from "./ttsWebSocketPlayer";
import { voiceStreamSpeaker } from "./voiceStreamSpeaker";

/**
 * 立即停止上一条（及当前）消息的语音播报。
 * 不关闭 ASR/TTS 预热连接；不触碰 chatService / SSE / messageList。
 */
export function stopAllSpeechPlayback(): void {
  try {
    voiceStreamSpeaker.stop();
  } catch (e1) {
    console.warn("[Speech] voiceStreamSpeaker.stop ignored", e1);
  }
  try {
    ttsWebSocketPlayer.stop();
  } catch (e2) {
    console.warn("[Speech] ttsWebSocketPlayer.stop ignored", e2);
  }
  try {
    audioPlayerManager.stop();
  } catch (e3) {
    console.warn("[Speech] audioPlayerManager.stop ignored", e3);
  }
}
