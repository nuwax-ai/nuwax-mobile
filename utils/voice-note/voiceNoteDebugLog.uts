/**
 * 录音页临时日志。只给联调看接口、缓存和录音状态。
 */
import { ref } from "vue";

export const voiceNoteDebugLines = ref<string[]>([]);

const MAX_LINES = 120;

function pad2(n: number): string {
  if (n < 10) return "0" + n.toString();
  return n.toString();
}

function clock(): string {
  const now = new Date();
  return pad2(now.getHours()) + ":" + pad2(now.getMinutes()) + ":" + pad2(now.getSeconds());
}

/**
 * 追加一行。
 * @param kind 如「接口」「缓存」「录音」
 * @param detail 这一步的结果
 */
export function pushVoiceNoteDebug(kind: string, detail: string): void {
  const next: string[] = [];
  const current = voiceNoteDebugLines.value;
  const start = current.length > MAX_LINES - 1 ? current.length - (MAX_LINES - 1) : 0;
  for (let i = start; i < current.length; i++) {
    next.push(current[i]);
  }
  next.push(clock() + " [" + kind + "] " + detail);
  voiceNoteDebugLines.value = next;
}
