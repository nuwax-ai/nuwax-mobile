import { getImSessionStamp } from "./imSessionScope";
/**
 * 当前用户信息（id/昵称/头像）模块级缓存（App 进程内，页面销毁不丢）。
 *
 * 目的：聊天页 isMine 依据 myUserId 比对 senderId。myUserId 只能从
 * /api/user/getLoginInfo 异步获得，而首屏消息缓存免网络立即渲染——若等接口
 * 返回（约一个网络往返），我方消息会先按对方侧渲染再翻到右侧（用户可感闪动）。
 * 进页先同步回填本缓存，接口返回后刷新并写回。
 *
 * 失效：随 IM 会话戳（token/origin/epoch 变化即换账号或登出）自动清空，
 * 与 imChatCache 同款机制——不会串账号。
 */

export class CachedMyInfo {
  userId: string = "";
  displayName: string = "";
  avatar: string = "";
}

let cached: CachedMyInfo | null = null;
let cacheSession = "";

function ensureCacheSession(): void {
  if (cacheSession != getImSessionStamp()) {
    cached = null;
    cacheSession = getImSessionStamp();
  }
}

/** 写/刷新缓存（userId 为空不写——拉取失败保持旧值或空）。 */
export function setCachedMyInfo(userId: string, displayName: string, avatar: string): void {
  ensureCacheSession();
  if (userId.length == 0) {
    return;
  }
  const info = new CachedMyInfo();
  info.userId = userId;
  info.displayName = displayName;
  info.avatar = avatar;
  cached = info;
}

/** 取缓存；未缓存或已失效返回 null。 */
export function getCachedMyInfo(): CachedMyInfo | null {
  ensureCacheSession();
  return cached;
}
