import { MTMathView } from 'com.agog.mathdisplay'

/**
 * Android 原生数学视图（UTS 组件式插件）。
 *
 * 把 AndroidMath 的 MTMathView（com.agog.mathdisplay：纯 Canvas + FreeType 矢量字形，
 * 自带 latinmodern / texgyretermes / xits OTF 数学字体）绑定到 uvue 的 <native-view>。
 * 数学排版在原生层完成，不过隐藏 proxy web-view。
 *
 * ★ 重要：MTMathView 是 Kotlin 类，latex/fontSize/labelMode/textColor/textAlignment/
 * displayErrorInline 都是 Kotlin var 属性（不是 Java setter）。UTS→Kotlin 里必须用
 * 「属性赋值 view.latex = x」，写 view.setLatex(x) 会被 kotlinc 判 Unresolved reference。
 * 继承自 android.view.View 的 requestLayout()/invalidate() 是 Java 方法，照常调用。
 *
 * 注：nativeSvg 后端（QuickJS + MathJax → AndroidSVG 位图，原 renderMathAsync 的真实实现）
 * 在当前分支为 WIP，其依赖 com.caverock:androidsvg 在标准基座下无法解析（Maven 拉取失败）。
 * 已暂时移除该实现，下方 renderMathAsync 为占位：返回 error，由 MathRendererCore 自动兜底
 * 回 proxyWebBackend（默认后端，不受影响）。待 nativeSvg 依赖修复后再恢复真实实现。
 */
export class NativeMathView {
	$element: UniNativeViewElement
	private view: MTMathView | null = null

	constructor(element: UniNativeViewElement) {
		// iOS（Swift）两段初始化禁止 super.init 前对 self 调方法；Android 无此限制，可抽 bindView。
		this.$element = element
		this.bindView()
	}

	private bindView(): void {
		const v = new MTMathView(this.$element.getAndroidActivity()!)
		v.displayErrorInline = true
		v.textAlignment = MTMathView.MTTextAlignment.KMTTextAlignmentLeft
		this.$element.bindAndroidView(v)
		this.view = v
	}

	/** 应用 LaTeX（不含 $ 定界符），重新排版并请求 measure / layout */
	setLatex(latex: string): void {
		const v = this.view
		if (v == null) {
			return
		}
		v.latex = latex
		v.requestLayout()
		v.invalidate()
	}

	/** display=true 块级（\displaystyle，分数 / 求和等更大）/ false 行内（text 模式） */
	setDisplayMode(display: boolean): void {
		const v = this.view
		if (v == null) {
			return
		}
		if (display) {
			v.labelMode = MTMathView.MTMathViewMode.KMTMathViewModeDisplay
		} else {
			v.labelMode = MTMathView.MTMathViewMode.KMTMathViewModeText
		}
		v.requestLayout()
	}

	/** 字号 px（MTMathView 用 px，非 sp） */
	setFontSize(px: number): void {
		const v = this.view
		if (v == null) {
			return
		}
		v.fontSize = px.toFloat()
		v.requestLayout()
	}

	/** 文字颜色 ARGB int（0xAARRGGBB，如 0xFF000000=不透明黑） */
	setTextColor(argb: number): void {
		const v = this.view
		if (v == null) {
			return
		}
		v.textColor = argb.toInt()
		v.invalidate()
	}

	/** App 端主动释放：置空引用（View 本身由 native-view 元素生命周期管理） */
	destroy(): void {
		this.view = null
	}
}

/**
 * 原生 SVG 渲染（QuickJS + MathJax tex-svg → AndroidSVG 位图）占位。
 *
 * nativeSvg 后端在当前分支 WIP 不可用（com.caverock:androidsvg Maven 依赖无法解析）。
 * 占位返回 { error }，调用方（nativeSvgBackend → MathRendererCore）会自动兜底回
 * proxyWebBackend。签名保持不变，待依赖修复后恢复真实实现即可，无需改调用方。
 */
export function renderMathAsync(
	latex: string,
	display: boolean,
	dpiScale: number,
	color: string,
	onResult: (res: UTSJSONObject) => void,
): void {
	const res = new UTSJSONObject()
	res["error"] = "nativesvg_disabled_wip"
	onResult(res)
}
