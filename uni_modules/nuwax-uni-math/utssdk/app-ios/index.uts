// #ifdef APP-IOS
import { UIView } from "UIKit"

/**
 * iOS 原生数学视图（UTS 组件式插件，镜像 Android 的 NativeMathView）。
 *
 * 把 iosMath 的 MTMathView（CoreText 矢量数学排版，自带 latinmodern 等 OTF 数学字体）绑到
 * uvue 的 <native-view>。数学排版在原生层完成，不过隐藏 proxy web-view → 根除数学渲染的
 * evalJS 桥死锁，公式原生可选 / 可复制、高 DPI 清晰、可跟随暗色主题。与 Android 的
 * NativeMathView（AndroidMath）API 一一对应（setLatex/DisplayMode/FontSize/TextColor/destroy），
 * 故 <x-native-math> 组件无需平台分叉。
 *
 * 重活在同目录 MathViewBridge.swift（混编纯 Swift，包 iosMath ObjC pod；UTS 直接 import ObjC
 * 不确定，故走 Swift 桥，同 MathSvgBridge/esp EspProvisioningBridge 范式）。本类只做
 * bindIOSView 绑定 + props 透传（各 setter 统一走 reapply → MathViewBridge.applyLatex）。
 *
 * ★ 状态：骨架，待 Xcode 真机验证（iosMath pod 版本/MTMathView API/ObjC 模块 import；
 *   详见 MathViewBridge.swift 文件头 TODO）。
 */
export class NativeMathView {
	$element: UniNativeViewElement
	private view: UIView | null = null
	private curLatex: string = ""
	private curDisplay: boolean = false
	private curFontSize: number = 0
	private curColor: number = -1

	constructor(element: UniNativeViewElement) {
		this.$element = element
		this.bindView()
	}

	private bindView(): void {
		// MathViewBridge（同目录 .swift，UTS 无需 import）创建 MTMathView 并按默认配置
		const v = MathViewBridge.createView()
		this.$element.bindIOSView(v)
		this.view = v
	}

	setLatex(latex: string): void {
		this.curLatex = latex
		this.reapply()
	}

	/** display=true 块级（\displaystyle）/ false 行内（text 模式） */
	setDisplayMode(display: boolean): void {
		this.curDisplay = display
		this.reapply()
	}

	/** 字号 px */
	setFontSize(px: number): void {
		this.curFontSize = px
		this.reapply()
	}

	/** 文字颜色 ARGB int（0xAARRGGBB，-1=默认） */
	setTextColor(argb: number): void {
		this.curColor = argb
		this.reapply()
	}

	/** 任一 setter 变化 → 统一下发并触发 CoreText 重排（iOS 无 requestLayout/invalidate） */
	private reapply(): void {
		const v = this.view
		if (v == null) {
			return
		}
		MathViewBridge.applyLatex(v, this.curLatex, this.curDisplay, this.curFontSize, this.curColor)
	}

	/** App 端主动释放：置空引用（UIView 本身由 native-view 元素生命周期管理） */
	destroy(): void {
		this.view = null
	}
}

/**
 * iOS 原生 SVG 数学渲染后端（混编，与 Android 端 renderMathAsync 同契约）— dormant fallback。
 *
 * 注：显示架构已定为 native-view（NativeMathView / iosMath）为主路径；本 SVG 路径
 * （JSContext + MathJax → SwiftDraw → PNG 位图）保留作 dormant fallback，未激活。
 * Core（mathRendererCore）目前走 nativeSvgBackend → renderMathAsync 这条线仅在 native-view
 * 不可用的回退场景才需要；保留契约不删，便于随时再激活或作导出 SVG 用。
 *
 * 混编约定：同目录 MathSvgBridge.swift 的 public class 对 UTS 直接可见（无需 import）。
 * 本函数只做 UTSJSONObject 组装 + 闭包透传。
 */
export function renderMathAsync(
	latex: string,
	display: boolean,
	dpiScale: number,
	color: string,
	onResult: (res: UTSJSONObject) => void,
): void {
	MathSvgBridge.renderMathAsync(
		latex,
		display,
		dpiScale,
		color,
		(imageDataURL: string, width: number, height: number, svg: string, error: string): void => {
			const res = new UTSJSONObject()
			if (error.length > 0) {
				res["error"] = error
			} else {
				res["imageDataURL"] = imageDataURL
				res["width"] = width
				res["height"] = height
				res["svg"] = svg
			}
			onResult(res)
		},
	)
}
// #endif
