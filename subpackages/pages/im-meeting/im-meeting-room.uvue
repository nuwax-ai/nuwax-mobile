    color: #d83931;
  }

  /* 主操作黑色（与「发起 / 加入 / 预约」三页的黑色主按钮同一口径） */
  .mr-primary {
    height: 46px;
    border-radius: 23px;
    background-color: #111111;
    display: flex;
    flex-direction: row;
    align-items: center;
