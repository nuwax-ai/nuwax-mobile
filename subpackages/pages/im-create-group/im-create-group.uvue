  .cg-state-text {
    color: #9a9aa2;
    font-size: 26rpx;
    line-height: 36rpx;
  }

  /* 进群规则三段说明（原 idle 态主内容，默认列表落地后收列表尾） */
  .cg-hint {
    padding: 32rpx 40rpx 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .cg-hint--tail {
    padding-top: 24rpx;
  }

  /* 面板未展开（初始态）：三段说明占列表位，留出顶部呼吸 */
