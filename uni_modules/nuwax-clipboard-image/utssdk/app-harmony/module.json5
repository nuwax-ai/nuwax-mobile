{
  "module": {
    // READ_PASTEBOARD 是受限开放权限（system_basic + user_grant + ACL 使能）：当前政策下
    // 手机端三方应用不可申请（仅 PC/2in1 设备、或使用系统 PasteButton 粘贴控件的场景可批），
    // 且 ACL 不在签名 profile 时打基座/签名直接失败——默认不声明，运行时 getData() 报 201
    // 时按「无图」降级（提示条不出现，纯文本粘贴不受影响）。
    // 调试期想真机验证（DevEco 自动签名可能放开 ACL）时，取消下方注释重打基座：
    // "requestPermissions": [
    //   {
    //     "name": "ohos.permission.READ_PASTEBOARD",
    //     "reason": "$string:nuwax_clipboard_read_reason",
    //     "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
    //   }
    // ]
    "requestPermissions": []
  }
}
