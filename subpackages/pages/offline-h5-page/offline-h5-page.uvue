<template>
  <view class="page">
    <offline-h5-container v-if="request != null" :request="request!" />
  </view>
</template>
<script setup lang="uts">
import { ref } from 'vue';
import { onLoad } from '@dcloudio/uni-app';
import OfflineH5Container from '@/components/offline-h5-container/offline-h5-container.uvue';
import { buildProjectOfflineH5Request } from '@/components/offline-h5-container/offline-h5-project';
// 第二个接入点：文件预览。只配置路由，无聊天壳、语音逻辑或专用计时器。
const request = ref<UTSJSONObject | null>(null);
onLoad((options: any) => {
  const obj = options as UTSJSONObject;
  const cId = obj['cId'] != null ? `${obj['cId']}` : '';
  const file = obj['fileProxyUrl'] != null ? `${obj['fileProxyUrl']}` : '';
  const route = `/subpackages/pages/file-preview-page/file-preview-page?cId=${encodeURIComponent(cId)}&fileProxyUrl=${encodeURIComponent(file)}`;
  request.value = buildProjectOfflineH5Request(route, 'file-preview');
});
</script>
<style>
.page { flex: 1; }
</style>
