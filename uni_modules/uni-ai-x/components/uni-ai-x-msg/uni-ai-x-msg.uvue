}

/* 段落行内公式混排（对齐 mp-html：文字 inline 流 + 公式 inline-block 嵌入，自然换行不截断） */
.msg-root-paragraph-mixed-box {
	width: 100%;
	margin: 16rpx 0;
	/* #ifdef WEB */
	/* H5：inline 文本流，文字与公式按 inline 自然断行（关键，勿用 flex-wrap，否则长文整项换行被截断） */
	display: block;
	/* #endif */
	/* #ifndef WEB */
	/* App：原生 flex 引擎无真正 inline 流，退化为 flex-wrap（App 公式为截图小图，影响小） */
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	/* #endif */
}

.msg-root-paragraph-text {
	/* 对齐 ai-msg `.answer-container` 原正文：32rpx / #404040 / lh 1.5 */
	font-size: 32rpx;
	line-height: 48rpx;
	color: #404040;
	/* #ifdef WEB */
	/* H5：inline 排列，文字与公式同一文本流自然换行 */
	display: inline;
	/* #endif */
}

.msg-root-paragraph-strong {
	font-weight: 600;
}

.msg-root-paragraph-em {
	font-style: italic;
}

.msg-root-paragraph-del {
	text-decoration-line: line-through;
	color: #999;
}

.msg-root-paragraph-code {
	font-family: monospace;
