/**
 * 桌宠配件初始化配置（BLE WiFi 配网）常量定义
 *
 * ⚠️ UUID 当前为占位值，正式实施前需与硬件团队确认并注册正式 128-bit UUID（见开放问题）。
 */

/** 配网 Service UUID（占位，实施时替换为正式 128-bit UUID） */
export const PROV_SERVICE_UUID = '0000ffff-0000-1000-8000-00805f9b34fb';
/** WiFi SSID 特征 UUID（Write，≤32 字节） */
export const PROV_CHAR_WIFI_SSID_UUID = '0000ff01-0000-1000-8000-00805f9b34fb';
/** WiFi 密码特征 UUID（Write，≤64 字节） */
export const PROV_CHAR_WIFI_PASSWORD_UUID = '0000ff02-0000-1000-8000-00805f9b34fb';
/** 配网状态特征 UUID（Notify/Read：byte0=状态码, byte1-2=错误详情） */
export const PROV_CHAR_STATUS_UUID = '0000ff03-0000-1000-8000-00805f9b34fb';
/** 设备信息特征 UUID（Read：SN/型号/固件版本） */
export const PROV_CHAR_DEVICE_INFO_UUID = '0000ff04-0000-1000-8000-00805f9b34fb';
/** 控制命令特征 UUID（Write：0x01 重置 / 0x02 触发扫描） */
export const PROV_CHAR_COMMAND_UUID = '0000ff05-0000-1000-8000-00805f9b34fb';

/** 扫描设备超时（毫秒） */
export const PROV_SCAN_TIMEOUT_MS = 15000;
/** 配网等待联网结果超时（毫秒） */
export const PROV_RESULT_TIMEOUT_MS = 30000;
/** 单次 BLE 连接超时（毫秒） */
export const PROV_CONNECT_TIMEOUT_MS = 10000;
/** BLE 连接失败最大重试次数 */
export const PROV_CONNECT_RETRY = 3;
/** 写凭据失败最大重试次数 */
export const PROV_WRITE_RETRY = 3;
/** 连接重试基础间隔（毫秒，指数退避：1s/2s/4s） */
export const PROV_CONNECT_RETRY_BASE_DELAY_MS = 1000;
/** 写凭据重试间隔（毫秒） */
export const PROV_WRITE_RETRY_DELAY_MS = 500;

/** SSID 最大字节数 */
export const PROV_SSID_MAX_BYTES = 32;
/** 密码最大字节数 */
export const PROV_PASSWORD_MAX_BYTES = 64;
/** 密码最小字节数（WPA/WPA2 至少 8 位；开放网络允许空） */
export const PROV_PASSWORD_MIN_BYTES = 8;

/** Mock 开关 storage key（值为 '1'/'0'） */
export const PROV_USE_MOCK_STORAGE_KEY = 'PROV_USE_MOCK_BLE';
/** Mock 场景 storage key（值为 MockScenarioEnum） */
export const PROV_MOCK_SCENARIO_STORAGE_KEY = 'PROV_MOCK_SCENARIO';

/** 模拟设备广播名前缀（Mock 与真实设备通用，用于扫描展示） */
export const PROV_DEVICE_NAME_PREFIX = 'NUWAX-PET';
