<template>
  <view class="home-content-wrapper flex-1">
    <swiper
      class="home-content-swiper flex-1"
      :current="activeTabIndex"
      :indicator-dots="false"
      :circular="false"
      :duration="260"
      easing-function="easeOut"
      @change="handleSwiperChange"
    >
      <!-- 最近使用：独立列表常驻，避免切换时销毁重建造成卡顿。 -->
      <swiper-item>
        <list-view
          class="home-content"
          direction="vertical"
          :lower-threshold="50"
          :refresher-enabled="true"
          :refresher-triggered="refreshing && activeTab == 'recent'"
          :show-scrollbar="false"
          @scrolltolower="handleRecentLoadMore"
          @refresherrefresh="handleRecentRefresh"
        >
          <template v-if="recentAgentList.length > 0">
            <list-item
              v-for="(info, index) in recentAgentList"
              :key="info.agentId"
              :type="3"
              class="recent-item"
            >
              <view class="recent-item-inner">
                <recent-used-agent-item
                  :icon="info.icon"
                  :name="info.name"
                  :description="info.description"
                  :modifiedTime="formatModifiedTime(info.modified)"
                  :showModifiedTime="isLoggedIn"
                  :paymentRequired="info.paymentRequired && enableSubscription == 1"
                  :subscribed="info.subscribed"
                  @click="handleRecentClick(info)"
                  @longpress="handleRecentLongPress(info)"
                />
              </view>
            </list-item>
          </template>
          <list-item v-else-if="!recentLoading && !(refreshing && activeTab == 'recent')" :type="93" class="state-item">
            <view class="empty-state">
              <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
              <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
            </view>
          </list-item>
          <list-item v-else-if="!(refreshing && activeTab == 'recent')" :type="94" class="state-item">
            <view class="loading-state">
              <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
            </view>
          </list-item>
          <list-item v-if="recentShowNoMore" :type="95" class="state-item">
            <view class="no-more-state">
              <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
            </view>
          </list-item>
        </list-view>
      </swiper-item>

      <!-- 会话记录：与最近使用并列常驻，由原生 swiper 负责跟手动画。 -->
      <swiper-item>
        <list-view
          class="home-content"
          direction="vertical"
          :lower-threshold="50"
          :refresher-enabled="true"
          :refresher-triggered="refreshing && activeTab == 'history'"
          :show-scrollbar="false"
          @scrolltolower="handleConversationLoadMore"
          @refresherrefresh="handleConversationRefresh"
        >
          <template v-if="convRowList.length > 0">
            <list-item
              v-for="(row, index) in convRowList"
              :key="row.id"
              :type="2"
              class="conv-item"
            >
              <view class="conv-item-inner" @click="handleConvClick(index)" @longpress="handleConvLongPress(index)">
                <view class="title-row">
                  <text class="conversation-title">{{ row.topic }}</text>
                  <text class="time-label">{{ row.timeLabel }}</text>
                </view>
                <view class="bottom-row">
                  <text class="agent-name">{{ row.agentName }}</text>
                  <view v-if="row.showExecuting" class="status-tag">
                    <text class="status-text">{{ t("Mobile.Conversation.executing") }}</text>
                  </view>
                </view>
              </view>
            </list-item>
          </template>
          <list-item v-else-if="!convLoading && !(refreshing && activeTab == 'history')" :type="90" class="state-item">
            <view class="empty-state">
              <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
              <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
            </view>
          </list-item>
          <list-item v-else-if="!(refreshing && activeTab == 'history')" :type="91" class="state-item">
            <view class="loading-state">
              <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
            </view>
          </list-item>
          <list-item v-if="convShowNoMore" :type="92" class="state-item">
            <view class="no-more-state">
              <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
            </view>
          </list-item>
        </list-view>
      </swiper-item>
    </swiper>
  </view>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { ref, computed, onMounted } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants.uts";
  import {
    apiUserUsedAgentList,
    apiUserUsedAgentDelete,
    apiHomeCategoryList,
  } from "@/servers/agentDev";
  import { apiPublishedAgentList } from "@/servers/square";
  import { SquarePublishedListParams } from "@/types/interfaces/square";
  import {
    apiAgentConversationList,
    apiAgentConversationUpdate,
    apiAgentConversationDelete,
  } from "@/servers/conversation";
  import { ConversationListParams } from "@/types/interfaces/conversationInfo";
  import { AgentConversationUpdateParams, AgentListItem } from "@/types/interfaces/agent";
  import { apiTenantConfig } from "@/servers/account";
  import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
  import { ListParams } from "@/types/interfaces/common";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { USER_NO_LOGIN, REDIRECT_LOGIN } from "@/constants/codes.constants";
  import { formatTimeAgo } from "@/utils/common";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import RecentUsedAgentItem from "@/components/recent-used-agent-item/recent-used-agent-item.uvue";
  import noData from "@/static/assets/no_data.png";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  interface HomeContentProps {
    isLoggedIn: boolean;
  }
  const props = defineProps<HomeContentProps>();

  const emit = defineEmits<{
    (e: "agent-click", info: any): void;
    (e: "conversation-click", item: any): void;
    (e: "tab-change", tab: string): void;
  }>();

  // vapor: scroll-view 需显式 px 高度（flex:1 不算"确定高度"，会导致无法滚动）
  const _sysInfo = uni.getSystemInfoSync();
  const _rpx2px = (rpx: number): number => {
    return Math.round(rpx * _sysInfo.windowWidth / 750);
  };
  // 可视高 - 顶部自定义导航栏(约104rpx) - 本组件 tab 栏(约100rpx)
  const scrollHeightStyle = computed((): string => {
    const h = _sysInfo.windowHeight - _rpx2px(104) - _rpx2px(100);
    return `${h}px`;
  });

  // ===== tab 状态（最近使用在左，会话记录在右） =====
  const activeTab = ref<string>("recent");
  const activeTabIndex = computed((): number => activeTab.value == "history" ? 1 : 0);
  const refreshing = ref<boolean>(false);

  function formatModifiedTime(modified: string): string {
    const r = formatTimeAgo(modified);
    return r != null ? r : "";
  }

  // ============================================================
  // 最近使用（agent-list-content 逻辑移植）
  // ============================================================
  const recentAgentList = ref<AgentListItem[]>([] as AgentListItem[]);
  const recentLoading = ref<boolean>(false);
  const recentHasMore = ref<boolean>(false);
  const currentPage = ref<number>(1);
  const tenantConfigInfo = ref<any | null>(null);

  const enableSubscription = computed((): number => {
    const tc = tenantConfigInfo.value;
    if (tc != null) {
      const obj = tc as UTSJSONObject;
      const sub = obj["enableSubscription"];
      if (sub != null) {
        return sub as number;
      }
    }
    return 0;
  });

  const recentShowNoMore = computed((): boolean => {
    const rl = recentAgentList.value;
    const rlLen = rl != null ? rl.length : 0;
    return !recentLoading.value && !recentHasMore.value && rlLen > 8;
  });

  function readStr(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }
  function readNum(obj: UTSJSONObject, key: string): number {
    const raw = obj[key];
    return raw != null ? (raw as number) : 0;
  }
  function readBool(obj: UTSJSONObject, key: string): boolean {
    return obj[key] == true;
  }

  function mapToAgentListItem(src: UTSJSONObject, agentIdFromTargetId: boolean): AgentListItem {
    const item = new AgentListItem();
    item.id = readNum(src, "id");
    item.agentId = agentIdFromTargetId ? readNum(src, "targetId") : readNum(src, "agentId");
    item.name = readStr(src, "name");
    item.icon = readStr(src, "icon");
    item.description = readStr(src, "description");
    item.modified = readStr(src, "modified");
    item.agentType = readStr(src, "agentType");
    item.paymentRequired = readBool(src, "paymentRequired");
    item.subscribed = readBool(src, "subscribed");
    return item;
  }

  function toRecentPayload(info: AgentListItem): UTSJSONObject {
    const obj = new UTSJSONObject();
    obj["id"] = info.id;
    obj["agentId"] = info.agentId;
    obj["name"] = info.name;
    obj["icon"] = info.icon;
    obj["description"] = info.description;
    obj["modified"] = info.modified;
    obj["agentType"] = info.agentType;
    obj["paymentRequired"] = info.paymentRequired;
    obj["subscribed"] = info.subscribed;
    return obj;
  }

  async function fetchUserUsedAgentList(page: number = 1, pageSize: number = 20): Promise<any> {
    try {
      const params = new ListParams();
      params.pageIndex = page;
      params.size = pageSize;
      const res = await apiUserUsedAgentList(params);
      recentLoading.value = false;
      const code = apiResCode(res);
      const dataRaw = apiResData<any>(res);
      if (code == SUCCESS_CODE) {
        const rawList = dataRaw != null ? (dataRaw as any[]) : ([] as any[]);
        const newList = [] as AgentListItem[];
        for (let j = 0; j < rawList.length; j++) {
          newList.push(mapToAgentListItem(rawList[j] as UTSJSONObject, false));
        }
        if (page > 1) {
          const existing = recentAgentList.value != null ? recentAgentList.value : ([] as AgentListItem[]);
          const combined = [] as AgentListItem[];
          for (let i = 0; i < existing.length; i++) {
            combined.push(existing[i]);
          }
          for (let k = 0; k < newList.length; k++) {
            combined.push(newList[k]);
          }
          recentAgentList.value = combined;
        } else {
          recentAgentList.value = newList;
        }
        recentHasMore.value = newList.length > 0;
        currentPage.value = page;
        return dataRaw;
      }
    } catch (error) {
      console.error("fetchUserUsedAgentList error:", error);
      return false;
    }
  }

  async function fetchPublishedAgentList(): Promise<any> {
    try {
      const params = new SquarePublishedListParams();
      params.targetType = "Agent";
      params.targetSubType = "ChatBot";
      params.page = 1;
      params.pageSize = 10;
      params.category = "";
      params.kw = "";
      const res = await apiPublishedAgentList(params);
      recentLoading.value = false;
      const code = apiResCode(res);
      if (code == SUCCESS_CODE) {
        const pageDataRaw = apiResData<any>(res);
        const pageObj = pageDataRaw != null ? (pageDataRaw as UTSJSONObject) : null;
        const recordsRaw = pageObj != null ? pageObj["records"] : null;
        const records = recordsRaw != null ? (recordsRaw as any[]) : ([] as any[]);
        const agentList = [] as AgentListItem[];
        for (let i = 0; i < records.length; i++) {
          agentList.push(mapToAgentListItem(records[i] as UTSJSONObject, true));
        }
        recentAgentList.value = agentList;
        recentHasMore.value = false;
        currentPage.value = 1;
        return agentList;
      }
    } catch (error) {
      console.error("fetchPublishedAgentList error:", error);
      return false;
    }
  }

  async function deleteUserUsedAgent(agentId: number): Promise<void> {
    const res = await apiUserUsedAgentDelete(agentId);
    const code = apiResCode(res);
    const message = apiResMessage(res);
    if (code == SUCCESS_CODE) {
      const current = recentAgentList.value != null ? recentAgentList.value : ([] as AgentListItem[]);
      const filtered = [] as AgentListItem[];
      for (let i = 0; i < current.length; i++) {
        if (current[i].agentId != agentId) {
          filtered.push(current[i]);
        }
      }
      recentAgentList.value = filtered;
    } else if (code != USER_NO_LOGIN && code != REDIRECT_LOGIN) {
      uni.showToast({
        title: message.length > 0 ? message : t("Mobile.AgentList.deleteFailed"),
        icon: "none",
      });
    }
  }

  function handleRecentLongPress(info: AgentListItem) {
    if (!props.isLoggedIn) {
      return;
    }
    uni.showModal({
      title: t("Mobile.AgentList.confirmDeleteAgent"),
      content: info.name,
      success: (res) => {
        if (res.confirm) {
          deleteUserUsedAgent(info.agentId);
        }
      },
    });
  }

  function handleRecentClick(info: AgentListItem) {
    emit("agent-click", toRecentPayload(info));
  }

  async function fetchTenantConfig() {
    const res = await apiTenantConfig();
    if (apiResCode(res) == SUCCESS_CODE) {
      const data = apiResData<any>(res);
      tenantConfigInfo.value = data;
      if (data != null) {
        uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(data));
      }
    }
  }

  async function initTenantConfig() {
    const tenantConfigInfoString = uni.getStorageSync(TENANT_CONFIG_INFO) as string;
    if (tenantConfigInfoString != null && tenantConfigInfoString.length > 0) {
      const parsed = JSON.parse(tenantConfigInfoString);
      if (parsed != null) {
        tenantConfigInfo.value = parsed;
      }
    }
    await fetchTenantConfig();
  }

  async function loadRecent() {
    if (recentLoading.value) return;
    recentLoading.value = true;
    await initTenantConfig();
    if (props.isLoggedIn) {
      await fetchUserUsedAgentList(1, 20 * currentPage.value);
    } else {
      await fetchPublishedAgentList();
    }
  }

  // ============================================================
  // 历史会话（conversation-list-content 逻辑移植）
  // ============================================================
  class ConversationRowView {
    id: number = 0;
    topic: string = "";
    timeLabel: string = "";
    agentName: string = "";
    showExecuting: boolean = false;
  }

  const conversationList = ref<UTSJSONObject[]>([]);
  const convLoading = ref<boolean>(false);
  const convHasMore = ref<boolean>(false);
  const lastId = ref<number | null>(null);

  function toNum(v: any | null, fallback: number = 0): number {
    if (v == null) {
      return fallback;
    }
    if (typeof v == "number") {
      const n = v as number;
      return n != n ? fallback : n;
    }
    const parsed = parseFloat(`${v}`);
    return parsed != parsed ? fallback : parsed;
  }
  function toStr(v: any | null, fallback: string = ""): string {
    if (v == null) {
      return fallback;
    }
    return `${v}`;
  }

  function normalizeList(raw: any | null): UTSJSONObject[] {
    const result: UTSJSONObject[] = [];
    if (raw == null) {
      return result;
    }
    let items: any[] = [];
    if (Array.isArray(raw)) {
      items = raw as any[];
    } else {
      try {
        const jsonStr = JSON.stringify(raw);
        if (jsonStr != null && jsonStr.length > 0) {
          const parsed = JSON.parse(jsonStr);
          if (Array.isArray(parsed)) {
            items = parsed as any[];
          }
        }
      } catch (_e) {
        return result;
      }
    }
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      if (item == null) {
        continue;
      }
      try {
        const jsonStr = JSON.stringify(item);
        if (jsonStr != null && jsonStr.length > 0) {
          const obj = JSON.parse(jsonStr) as UTSJSONObject | null;
          if (obj != null) {
            const agentRaw = obj["agent"];
            let agentName = "";
            if (agentRaw != null) {
              try {
                const agentStr = JSON.stringify(agentRaw);
                if (agentStr != null && agentStr.length > 0) {
                  const agentObj = JSON.parse(agentStr) as UTSJSONObject | null;
                  if (agentObj != null) {
                    agentName = toStr(agentObj["name"], "");
                  }
                }
              } catch (_3) {
                agentName = "";
              }
            }
            obj["_agentName"] = agentName;
            result.push(obj);
          }
        }
      } catch (_e2) {
        // skip
      }
    }
    return result;
  }

  const convRowList = computed((): ConversationRowView[] => {
    const raw = conversationList.value;
    const result: ConversationRowView[] = [];
    if (raw == null) {
      return result;
    }
    const unnamed = t("Mobile.Conversation.unnamed");
    const unknownAgent = t("Mobile.Conversation.unknownAgent");
    for (let i = 0; i < raw.length; i++) {
      const item = raw[i];
      if (item == null) {
        continue;
      }
      const row = new ConversationRowView();
      row.id = toNum(item["id"], 0);
      const topic = toStr(item["topic"], "");
      row.topic = topic.length > 0 ? topic : unnamed;
      const modified = toStr(item["modified"], "");
      const ago = formatTimeAgo(modified);
      row.timeLabel = ago != null ? ago : "";
      const agentName = toStr(item["_agentName"], "");
      row.agentName = agentName.length > 0 ? agentName : unknownAgent;
      const statusStr = toStr(item["taskStatus"], "");
      row.showExecuting = statusStr == "EXECUTING";
      result.push(row);
    }
    return result;
  });

  const convShowNoMore = computed((): boolean => {
    const cl = conversationList.value;
    const clLen = cl != null ? cl.length : 0;
    return !convLoading.value && !convHasMore.value && clLen > 8;
  });

  async function fetchConversationList(isLoadMore: boolean = false): Promise<void> {
    if (!props.isLoggedIn) {
      convLoading.value = false;
      return;
    }
    try {
      const params = new ConversationListParams();
      params.agentId = null;
      params.lastId = isLoadMore ? lastId.value : null;
      params.limit = 20;
      const res = await apiAgentConversationList(params);
      convLoading.value = false;
      if (apiResCode(res) == SUCCESS_CODE) {
        const newList = normalizeList(apiResData<any>(res));
        if (isLoadMore) {
          const existing = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
          const combined: UTSJSONObject[] = [];
          for (let i = 0; i < existing.length; i++) {
            combined.push(existing[i]);
          }
          for (let j = 0; j < newList.length; j++) {
            combined.push(newList[j]);
          }
          conversationList.value = combined;
        } else {
          conversationList.value = newList;
        }
        if (newList.length > 0) {
          const last = newList[newList.length - 1];
          lastId.value = toNum(last["id"], 0);
          convHasMore.value = newList.length >= 20;
        } else {
          convHasMore.value = false;
        }
      }
    } catch (error) {
      convLoading.value = false;
    }
  }

  async function loadConversation() {
    if (convLoading.value) return;
    convLoading.value = true;
    await fetchConversationList(false);
  }

  function getConvItemByIndex(index: number): UTSJSONObject | null {
    const list = conversationList.value;
    if (list == null || index < 0 || index >= list.length) {
      return null;
    }
    return list[index];
  }

  function handleConvClick(index: number) {
    const item = getConvItemByIndex(index);
    if (item != null) {
      emit("conversation-click", item);
    }
  }

  async function performRenameSubmit(item: UTSJSONObject, newName: string): Promise<void> {
    if (newName.length == 0) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleEmpty"), icon: "none" });
      return;
    }
    if (newName.length > 50) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleTooLong"), icon: "none" });
      return;
    }
    try {
      const updateParams = new AgentConversationUpdateParams();
      updateParams.id = toNum(item["id"], 0);
      updateParams.topic = newName;
      const updateRes = await apiAgentConversationUpdate(updateParams);
      if (apiResCode(updateRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameSuccess"), icon: "success" });
        item["topic"] = newName;
        const list = conversationList.value;
        conversationList.value = list != null ? list.slice(0) : ([] as UTSJSONObject[]);
      } else {
        const errorMessage = apiResMessage(updateRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  async function performDeleteSubmit(item: UTSJSONObject): Promise<void> {
    try {
      const id = toNum(item["id"], 0);
      const deleteRes = await apiAgentConversationDelete(id);
      if (apiResCode(deleteRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.deleteSuccess"), icon: "success" });
        const current = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
        const next: UTSJSONObject[] = [];
        for (let i = 0; i < current.length; i++) {
          const c = current[i];
          if (toNum(c["id"], -1) != id) {
            next.push(c);
          }
        }
        conversationList.value = next;
      } else {
        const errorMessage = apiResMessage(deleteRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  function handleConvRename(item: UTSJSONObject): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.renameModalTitle"),
      editable: true,
      placeholderText: t("Mobile.Components.HistoryConversationList.renamePlaceholder"),
      content: toStr(item["topic"], ""),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      success: (res) => {
        if (res.confirm) {
          const rawContent = res.content;
          const newName = rawContent != null ? rawContent.trim() : "";
          performRenameSubmit(item, newName);
        }
      },
    });
  }

  function handleConvDelete(item: UTSJSONObject): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.deleteModalTitle"),
      content: t("Mobile.Components.HistoryConversationList.deleteModalContent"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm) {
          performDeleteSubmit(item);
        }
      },
    });
  }

  function handleConvLongPress(index: number) {
    const item = getConvItemByIndex(index);
    if (item == null) {
      return;
    }
    const options = [
      t("Mobile.Components.HistoryConversationList.rename"),
      t("Mobile.Components.HistoryConversationList.delete"),
    ];
    uni.showActionSheet({
      itemList: options,
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.tapIndex == 0) {
          handleConvRename(item);
        } else if (res.tapIndex == 1) {
          handleConvDelete(item);
        }
      },
    });
  }

  // ============================================================
  // 刷新 / 加载更多（两个常驻列表各自处理，避免后台页误触发当前页请求）
  // ============================================================
  async function handleRecentRefresh() {
    if (refreshing.value) {
      return;
    }
    refreshing.value = true;
    currentPage.value = 1;
    recentHasMore.value = true;
    if (props.isLoggedIn) {
      await fetchUserUsedAgentList();
    } else {
      await fetchPublishedAgentList();
    }
    setTimeout(() => {
      refreshing.value = false;
    }, 500);
  }

  async function handleConversationRefresh() {
    if (refreshing.value) return;
    refreshing.value = true;
    lastId.value = null;
    convHasMore.value = true;
    await fetchConversationList(false);
    setTimeout(() => {
      refreshing.value = false;
    }, 500);
  }

  function handleRecentLoadMore() {
    if (recentHasMore.value && !recentLoading.value) {
      recentLoading.value = true;
      fetchUserUsedAgentList(currentPage.value + 1);
    }
  }

  function handleConversationLoadMore() {
    if (convHasMore.value && !convLoading.value) {
      convLoading.value = true;
      fetchConversationList(true);
    }
  }

  // 对外暴露：父页 onShow 时刷新当前 tab
  async function loadData() {
    if (activeTab.value == "recent") {
      await loadRecent();
    } else {
      await loadConversation();
    }
  }

  function changeContentTab(tab: string) {
    if (activeTab.value == tab) {
      return;
    }
    activeTab.value = tab;
    emit("tab-change", tab);
    // 切到对应 tab 时若还没数据则加载
    if (tab == "recent" && recentAgentList.value.length == 0) {
      loadRecent();
    } else if (tab == "history" && conversationList.value.length == 0) {
      loadConversation();
    }
  }

  function handleSwiperChange(e: UniSwiperChangeEvent): void {
    changeContentTab(e.detail.current == 1 ? "history" : "recent");
  }

  onMounted(() => {
    // 两侧数据并行预热，切换时只做原生位移动画，不临时发起首屏请求。
    loadRecent();
    loadConversation();
  });

  defineExpose({
    loadData: loadData as any,
    changeContentTab: changeContentTab as any,
  });
</script>

