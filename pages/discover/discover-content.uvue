<template>
  <view class="discover">
    <custom-nav-bar :title="t('Mobile.Nav.discover')" className="border-b" hasSafetyZone />
    <im-notice-bar />
    <scroll-view class="discover__scroll" direction="vertical" :show-scrollbar="false">
      <!-- <view class="discover__group">
        <view class="discover__row" @click="openTodo">
          <view class="discover__icon">
            <svg-icon name="icon-CheckSquareOutlined" size="20" unit="px" color="#1f2329" />
          </view>
          <text class="discover__title">{{ t("Mobile.Discover.todo") }}</text>
          <text class="discover__arrow">›</text>
        </view>
        <view class="discover__row" @click="openCalendar">
          <view class="discover__icon">
            <svg-icon name="icon-Calendar" size="20" unit="px" color="#1f2329" />
          </view>
          <text class="discover__title">{{ t("Mobile.Discover.calendar") }}</text>
          <text class="discover__arrow">›</text>
        </view>
      </view> -->

      <view class="discover__group">
        <view class="discover__row" @click="openApps">
          <view class="discover__icon">
            <svg-icon name="icon-Grid" size="20" unit="px" color="#1f2329" />
          </view>
          <text class="discover__title">{{ t("Mobile.Nav.app") }}</text>
          <text class="discover__arrow">›</text>
        </view>
        <!-- 工作商业版闸门：未授权时资料库行整行隐藏 -->
        <view v-if="!workRepoBlocked" class="discover__row" @click="openRepo">
          <view class="discover__icon">
            <svg-icon name="icon-book" size="20" unit="px" color="#1f2329" />
          </view>
          <text class="discover__title">{{ t("Mobile.Mine.repoLibrary") }}</text>
          <text class="discover__arrow">›</text>
        </view>
      </view>

      <view class="discover__group">
        <view class="discover__row" @click="openConnectors">
          <view class="discover__icon">
            <svg-icon name="icon-Puzzle" size="20" unit="px" color="#1f2329" />
          </view>
          <text class="discover__title">{{ t("Mobile.CreateHub.connector") }}</text>
          <text class="discover__arrow">›</text>
        </view>
        <view class="discover__row" @click="openExperts">
          <view class="discover__icon">
            <svg-icon name="icon-User" size="20" unit="px" color="#1f2329" />
          </view>
          <text class="discover__title">{{ t("Mobile.Nav.expert") }}</text>
          <text class="discover__arrow">›</text>
        </view>
      </view>

      <!-- 终端：原「我的」页智能终端入口。H5 / WEB 无原生终端，不展示；右侧台数为设备列表长度 -->
      <!-- #ifndef H5 || WEB -->
      <view v-if="isLoggedIn" class="discover__group">
        <view class="discover__row" @click="openTerminal">
          <view class="discover__icon">
            <image class="discover__terminal" src="/static/assets/icon_terminal.png" mode="aspectFit" />
          </view>
          <text class="discover__title">{{ t("Mobile.Nav.terminal") }}</text>
          <text v-if="terminalCountVisible" class="discover__count">{{ terminalCountText }}</text>
          <text class="discover__arrow">›</text>
        </view>
      </view>
      <!-- #endif -->
    </scroll-view>
    <auth-login-popup ref="loginPopupRef" />
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, type ComponentPublicInstance } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { REPO_LIBRARY_PAGE_PATH } from "@/constants/config";
  import { apiVoxDeviceList } from "@/servers/vox/voxDevice";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { addTicketAndJumpToWebview } from "@/utils/commonBusiness";
  import { goToLogin } from "@/utils/authNavigation";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { isWorkCommercialBlockedSync } from "@/utils/workCommercial";
  import { useMainTabLifecycle } from "@/hooks/useMainTabLifecycle";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import AuthLoginPopup from "@/components/auth-login-popup/auth-login-popup.uvue";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  // 工作商业版闸门：未授权时资料库行整行隐藏（onShow 每次同步复查，
  // 登录页/其他 Tab 刷新缓存后授权态翻转就地生效；缓存未定=放行，与伙伴页 fail-open 口径一致）
  const workRepoBlocked = ref<boolean>(false);
  const { loginPopupRef, hasToken } = useAuthInterceptor();
  const isLoggedIn = ref<boolean>(false);
  // ================================ 终端设备列表 ================================
  const terminalCount = ref<number>(0);
  const terminalCountVisible = ref<boolean>(false);
  const terminalCountText = computed((): string => {
    const m = new Map<string, string | number>();
    m.set("count", terminalCount.value);
    return translateFn("Mobile.Mine.terminalCount", toI18nParams(m), "");
  });
  const { onShow } = useMainTabLifecycle("/pages/discover/discover");

  /** 已登录时拉取终端台数，展示在「终端」行右侧 */
  async function fetchTerminalCount(): Promise<void> {
    if (isLoggedIn.value != true) {
      terminalCount.value = 0;
      terminalCountVisible.value = false;
      return;
    }
    terminalCountVisible.value = true;
    try {
      const res = await apiVoxDeviceList();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        terminalCount.value = arr.length;
      }
    } catch (_e) {
      // 静默失败，保留上次台数
    }
  }

  onShow(() => {
    // 资料库闸门同步复查（标题链异步写缓存，本 tick 可能读到旧值，下次 onShow 就地收敛）
    workRepoBlocked.value = isWorkCommercialBlockedSync();
    void refreshLoginState();
  });

  /** 与「我的」页一致：显示时用 hasToken 决定终端入口是否出现。 */
  async function refreshLoginState(): Promise<void> {
    isLoggedIn.value = await hasToken();
    fetchTerminalCount();
  }

  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) return;
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  /** 与「我的」页资料库一致：微信打开登录弹窗，其它端进入登录页。 */
  function handleLogin(): void {
    // #ifdef MP-WEIXIN
    callRefMethod(loginPopupRef.value, "open");
    // #endif
    // #ifdef H5 || WEB || APP
    goToLogin();
    // #endif
  }

  // 待办：进入待办列表（当前为设计稿示例数据）
  function openTodo(): void {
    uni.navigateTo({ url: "/pages/todo/todo" });
  }

  // 日程：进入月历页
  function openCalendar(): void {
    uni.navigateTo({ url: "/pages/schedule/schedule" });
  }

  // 应用：进入原应用页；iOS 文案仍为「场景」
  function openApps(): void {
    uni.navigateTo({ url: "/pages/app-dev/app-dev" });
  }

  // 资料库：站内 repo-web 首页，目标页需登录态——
  // 复用 _ticket 免登链路（同 conversation-search 的资料库文档跳法），在 webview 新页打开。
  async function openRepo(): Promise<void> {
    if (workRepoBlocked.value) {
      uni.showToast({ title: t("Mobile.Message.workCommercialRequired"), icon: "none" });
      return;
    }
    // 点击时用 hasToken 判断，与「我的」页资料库相同；不读进入页面时记下的登录标记。
    const loggedIn = await hasToken();
    if (loggedIn != true) {
      handleLogin();
      return;
    }
    addTicketAndJumpToWebview(REPO_LIBRARY_PAGE_PATH, "inner", t("Mobile.Mine.repoLibrary"));
  }

  // 连接器：需登录后进入连接器列表
  function openConnectors(): void {
    uni.navigateTo({ url: "/pages/connector-list/connector-list" });
  }

  // 专家：进入原专家列表，不要求登录
  function openExperts(): void {
    uni.navigateTo({ url: "/pages/expert-list/expert-list" });
  }

  // 点击终端，跳转原「我的终端」设备列表
  function openTerminal(): void {
    uni.navigateTo({ url: "/subpackages/pages/terminal/terminal" });
  }
</script>

<style scoped>
  .discover {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: #f7f7f8;
  }

  .discover__scroll {
    flex: 1;
  }

  .discover__group {
    margin: 12px 16px 0;
    background-color: #ffffff;
    border-radius: 12px;
    overflow: hidden;
  }

  .discover__row {
    height: 56px;
    padding: 0 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .discover__icon {
    width: 24px;
    height: 24px;
    margin-right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .discover__title {
    flex: 1;
    font-size: 16px;
    color: #1f2329;
  }

  .discover__count {
    font-size: 13px;
    color: #999999;
    margin-left: 8px;
  }

  .discover__arrow {
    font-size: 20px;
    color: #c9cdd4;
    margin-left: 8px;
  }

  .discover__terminal {
    width: 20px;
    height: 20px;
  }
</style>
