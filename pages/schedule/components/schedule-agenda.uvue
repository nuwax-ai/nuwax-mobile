<template>
  <scroll-view class="agenda" direction="vertical" :show-scrollbar="false">
    <view class="agenda__strip">
      <view v-for="(cell, index) in strip" :key="index" class="agenda__strip-cell" @click="onPickIso(cell.iso)">
        <text class="agenda__strip-wd">{{ cell.weekday }}</text>
        <view :class="cell.selected ? 'agenda__strip-day agenda__strip-day--on' : 'agenda__strip-day'">
          <text :class="cell.selected ? 'agenda__strip-num agenda__strip-num--on' : 'agenda__strip-num'">{{ cell.dayText }}</text>
        </view>
      </view>
    </view>

    <text class="agenda__month">{{ monthText }}</text>

    <view v-for="(week, weekIndex) in weeks" :key="weekIndex" class="agenda__week">
      <view class="agenda__week-head">
        <text class="agenda__week-no">{{ week.no }}</text>
        <text class="agenda__week-span">{{ week.span }}</text>
      </view>
      <view v-for="(day, dayIndex) in week.days" :key="dayIndex" class="agenda__day">
        <view class="agenda__label">
          <text class="agenda__wd">{{ day.weekday }}</text>
          <text class="agenda__num">{{ day.dayText }}</text>
        </view>
        <view class="agenda__chips">
          <view v-for="(chip, chipIndex) in day.chips" :key="chipIndex" class="agenda__chip" :style="chip.bgStyle" @click="onOpen(chip.id)">
            <text class="agenda__chip-title" :style="chip.inkStyle">{{ chip.title }}</text>
            <text class="agenda__chip-time">{{ chip.time }}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
  import { ref, watch } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { loadScheduleEvents } from "@/utils/scheduleStore";
  import { buildItems, dateKey, monthTitle, shiftDate, toIso, weekNoText, weekNumber, weekSpan, weekSunday } from "@/utils/scheduleBoard";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  class StripCell {
    iso: string = "";
    weekday: string = "";
    dayText: string = "";
    selected: boolean = false;
  }

  class AgendaChip {
    id: string = "";
    title: string = "";
    time: string = "";
    bgStyle: string = "";
    inkStyle: string = "";
  }

  class AgendaDay {
    weekday: string = "";
    dayText: string = "";
    chips: AgendaChip[] = [];
  }

  class AgendaWeek {
    no: string = "";
    span: string = "";
    days: AgendaDay[] = [];
  }

  const props = defineProps({
    year: { type: Number, default: 0 },
    month: { type: Number, default: 0 },
    day: { type: Number, default: 0 },
    markVersion: { type: Number, default: 0 },
  });

  const emit = defineEmits<{
    pick: [value: string];
    open: [id: string];
  }>();

  const weekdayKeys: string[] = [
    "Mobile.Discover.weekdaySun",
    "Mobile.Discover.weekdayMon",
    "Mobile.Discover.weekdayTue",
    "Mobile.Discover.weekdayWed",
    "Mobile.Discover.weekdayThu",
    "Mobile.Discover.weekdayFri",
    "Mobile.Discover.weekdaySat",
  ];

  const strip = ref<StripCell[]>([]);
  const weeks = ref<AgendaWeek[]>([]);
  const monthText = ref<string>("");

  function weekdayName(year: number, month: number, day: number): string {
    return t(weekdayKeys[new Date(year, month - 1, day).getDay()]);
  }

  function rebuild(): void {
    const year = props.year;
    const month = props.month;
    const day = props.day;
    if (year <= 0 || month <= 0 || day <= 0) {
      return;
    }
    const locals = loadScheduleEvents();
    const anchorIso = toIso(year, month, day);
    const sunday = weekSunday(year, month, day);
    const stripCells: StripCell[] = [];
    for (let i = 0; i < 7; i++) {
      const date = shiftDate(sunday[0], sunday[1], sunday[2], i);
      const cell = new StripCell();
      cell.iso = toIso(date[0], date[1], date[2]);
      cell.weekday = weekdayName(date[0], date[1], date[2]);
      cell.dayText = "" + date[2];
      cell.selected = cell.iso == anchorIso;
      stripCells.push(cell);
    }
    strip.value = stripCells;
    monthText.value = monthTitle(year, month);

    const lastDay = new Date(year, month, 0).getDate();
    const start = weekSunday(year, month, 1);
    const end = weekSunday(year, month, lastDay);
    const endKey = dateKey(end[0], end[1], end[2]);
    const built: AgendaWeek[] = [];
    let cursor = start;
    let guard = 0;
    while (dateKey(cursor[0], cursor[1], cursor[2]) <= endKey && guard < 8) {
      const week = new AgendaWeek();
      week.days = [] as AgendaDay[];
      const saturday = shiftDate(cursor[0], cursor[1], cursor[2], 6);
      const no = weekNumber(cursor[0], cursor[1], cursor[2]);
      week.no = weekNoText(no);
      week.span = weekSpan(cursor[1], cursor[2], saturday[1], saturday[2]);
      for (let i = 0; i < 7; i++) {
        const date = shiftDate(cursor[0], cursor[1], cursor[2], i);
        const iso = toIso(date[0], date[1], date[2]);
        const items = buildItems(iso, locals);
        if (items.length > 0) {
          const row = new AgendaDay();
          row.chips = [] as AgendaChip[];
          row.weekday = weekdayName(date[0], date[1], date[2]);
          row.dayText = "" + date[2];
          for (let j = 0; j < items.length; j++) {
            const chip = new AgendaChip();
            chip.id = items[j].id;
            chip.title = items[j].title;
            chip.time = items[j].timeStart;
            chip.bgStyle = "background-color:" + items[j].pastel;
            chip.inkStyle = "color:" + items[j].ink;
            row.chips.push(chip);
          }
          week.days.push(row);
        }
      }
      built.push(week);
      cursor = shiftDate(cursor[0], cursor[1], cursor[2], 7);
      guard++;
    }
    weeks.value = built;
  }

  function onPickIso(iso: string): void {
    emit("pick", iso);
  }

  function onOpen(id: string): void {
    emit("open", id);
  }

  watch((): string => {
    return props.year + "-" + props.month + "-" + props.day + "-" + props.markVersion;
  }, (_value: string): void => {
    rebuild();
  });

  rebuild();
</script>

<style scoped>
  .agenda {
    flex: 1;
  }

  .agenda__strip {
    margin: 4px 16px 0;
    padding: 10px 8px 12px;
    background-color: #ffffff;
    border-radius: 16px;
    display: flex;
    flex-direction: row;
  }

  .agenda__strip-cell {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .agenda__strip-wd {
    font-size: 12px;
    color: #86909c;
    line-height: 18px;
  }

  .agenda__strip-day {
    margin-top: 6px;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .agenda__strip-day--on {
    background-color: #5b4dff;
  }

  .agenda__strip-num {
    font-size: 15px;
    color: #1f2329;
  }

  .agenda__strip-num--on {
    color: #ffffff;
    font-weight: 600;
  }

  .agenda__month {
    margin: 18px 16px 8px;
    font-size: 18px;
    font-weight: 700;
    color: #1f2329;
  }

  .agenda__week {
    margin: 0 16px 8px;
  }

  .agenda__week-head {
    margin: 10px 0 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .agenda__week-no {
    font-size: 14px;
    font-weight: 600;
    color: #1f2329;
  }

  .agenda__week-span {
    margin-left: 8px;
    font-size: 13px;
    color: #86909c;
  }

  .agenda__day {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .agenda__label {
    width: 48px;
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .agenda__wd {
    font-size: 12px;
    color: #86909c;
    line-height: 16px;
  }

  .agenda__num {
    margin-top: 2px;
    font-size: 16px;
    font-weight: 600;
    color: #1f2329;
    line-height: 22px;
  }

  .agenda__chips {
    flex: 1;
  }

  .agenda__chip {
    min-height: 40px;
    margin-bottom: 8px;
    padding: 8px 12px;
    border-radius: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .agenda__chip-title {
    flex: 1;
    font-size: 15px;
    line-height: 22px;
  }

  .agenda__chip-time {
    margin-left: 8px;
    font-size: 13px;
    color: #86909c;
  }
</style>
