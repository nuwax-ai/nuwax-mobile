/** H5（包括离线包）适配器；与 App 脚本保持同一事务及校验规则。 */
export function applyEditorAtomicReplacementInWeb(quill: any | null, payload: UTSJSONObject): boolean {
  // #ifdef H5 || WEB
  if (quill == null) return false;
  let text = quill.getContents().ops.map((op: any): string => typeof op.insert == "string" ? op.insert : "\ufffc").join("");
  if (text.endsWith("\n")) text = text.substring(0, text.length - 1);
  if (text != payload["expected"]) return false;
  quill.history.cutoff();
  quill.updateContents(payload["change"], "user");
  quill.setSelection(payload["cursor"], 0, "silent");
  quill.history.cutoff();
  return true;
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

/** 在 editor 内部同一 JS 任务中替换触发区间；动态内容只作为 JSON 数据传入。 */
export function buildEditorAtomicReplacementScript(payload: UTSJSONObject): string {
  return `(function(p){
    var root=document.querySelector('.ql-container');
    var q=root&&(root.__quill||(window.Quill&&window.Quill.find(root)));
    if(!q)return;
    var text=q.getContents().ops.map(function(op){return typeof op.insert==='string'?op.insert:'\\ufffc';}).join('');
    if(text.slice(-1)==='\\n')text=text.slice(0,-1);
    if(text!==p.expected)return;
    q.history.cutoff();
    q.updateContents(p.change,'user');
    q.setSelection(p.cursor,0,'silent');
    q.history.cutoff();
  })(${JSON.stringify(payload)});`;
}
/** 根节点在新 SDK 中本身就是 ql-container；兼容旧版内层容器。 */
export function resolveWebComposerQuill(): any | null {
  // #ifdef H5 || WEB
  const root = document.querySelector("#chat-input-editor.ql-container, #chat-input-editor .ql-container") as any | null;
  if (root == null) return null;
  if (root.__quill != null) return root.__quill;
  const ctor = (window as any).Quill;
  if (ctor != null && ctor.find != null) return ctor.find(root);
  // #endif
  return null;
}
