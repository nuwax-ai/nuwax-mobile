<template>
  <view class="container relative flex flex-col">
    <custom-nav-bar :title="t('Mobile.Terminal.groupMembers')" className="border-b" hasSafetyZone showBack />

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <view class="tip-box">
        <text class="tip-text">{{ t("Mobile.Terminal.groupManageTip") }}</text>
      </view>

      <!-- 当前组员 -->
      <view class="field-label">{{ t("Mobile.Terminal.currentMembers") }}</view>
      <view class="card-group">
        <view class="row-item" v-for="member in memberList" :key="member.name">
          <view class="row-avatar">
            <text class="row-avatar-emoji">{{ member.icon }}</text>
          </view>
          <view class="row-info">
            <text class="row-title">{{ member.name }}</text>
            <text class="row-desc">{{ member.desc }}</text>
          </view>
          <view class="remove-btn" hover-class="remove-btn-active" @click="handleRemove(member.name)">
            <text class="remove-text">{{ t("Mobile.Terminal.remove") }}</text>
          </view>
        </view>
      </view>

      <!-- 添加智能体 -->
      <view class="field-label">{{ t("Mobile.Terminal.addAgent") }}</view>
      <view class="card-group">
        <view class="row-item" v-for="agent in candidateList" :key="agent.name" hover-class="row-item-active" @click="handleAdd(agent.name)">
          <view class="row-avatar row-avatar-add">
            <text class="row-avatar-plus">+</text>
          </view>
          <view class="row-info">
            <text class="row-title">{{ agent.name }}</text>
            <text class="row-desc">{{ agent.desc }}</text>
          </view>
          <text class="add-text">{{ t("Mobile.Terminal.add") }}</text>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- 完成（固定底部安全栏） -->
    <view class="done-footer">
      <view class="done-btn" hover-class="done-btn-active" @click="handleDone">
        <text class="done-text">{{ t("Mobile.Terminal.done") }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  class Member {
    name: string = "";
    desc: string = "";
    icon: string = "";
    constructor(name: string, desc: string, icon: string) {
      this.name = name;
      this.desc = desc;
      this.icon = icon;
    }
  }

  const memberList = ref<Member[]>([
    new Member("Backend-Agent", "后端API优化与性能调优", "⚙️"),
    new Member("UI-Agent", "前端组件库重构与设计系统", "🎨"),
    new Member("DB-Agent", "数据库迁移与连接池管理", "🗄️"),
    new Member("女娲助手", "通用对话与知识问答", "🔮"),
  ]);

  const candidateList = ref<Member[]>([
    new Member("Doc-Agent", "API文档自动生成与维护", "+"),
    new Member("DevOps-Agent", "CI/CD流水线与部署监控", "+"),
    new Member("Test-Agent", "集成测试与质量保障", "+"),
  ]);

  const handleRemove = (name: string) => {
    uni.showToast({ title: t("Mobile.Terminal.removed"), icon: "none" });
  };

  const handleAdd = (name: string) => {
    uni.showToast({ title: t("Mobile.Terminal.added"), icon: "none" });
  };

  const handleDone = () => {
    uni.navigateBack({ delta: 1 });
  };

  onLoad((options: any) => {
    setCurrentPageNavigationBarTitle();
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .tip-box {
    padding: 24rpx 32rpx 8rpx;
    display: flex;
    align-items: center;
    justify-content: center;

    .tip-text {
      font-size: 28rpx;
      color: #666666;
    }
  }

  .field-label {
    font-size: 24rpx;
    color: #666666;
    padding: 20rpx 32rpx 12rpx;
  }

  .card-group {
    background-color: #ffffff;
    border-radius: 16rpx;
    margin: 0 24rpx;
    overflow: hidden;
  }

  .row-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 24rpx 32rpx;
    border-bottom: 2rpx solid #f8f8f8;

    &:last-child {
      border-bottom-width: 0;
    }

    &-active {
      background-color: rgba(12, 20, 102, 0.04);
    }

    .row-avatar {
      width: 72rpx;
      height: 72rpx;
      border-radius: 12rpx;
      background-color: #fafafa;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 24rpx;

      .row-avatar-emoji {
        font-size: 36rpx;
      }

      &.row-avatar-add {
        .row-avatar-plus {
          font-size: 40rpx;
          color: #999999;
        }
      }
    }

    .row-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;

      .row-title {
        font-size: 30rpx;
        font-weight: 500;
        color: #1a1a1a;
      }

      .row-desc {
        font-size: 24rpx;
        color: #666666;
        margin-top: 4rpx;
      }
    }

    .remove-btn {
      padding: 8rpx 20rpx;
      border-radius: 24rpx;
      background-color: rgba(250, 81, 81, 0.08);

      &-active {
        opacity: 0.7;
      }

      .remove-text {
        font-size: 24rpx;
        color: #fa5151;
        font-weight: 500;
      }
    }

    .add-text {
      font-size: 24rpx;
      color: #07c160;
      font-weight: 500;
    }
  }

  /* 完成按钮固定底部安全栏 */
  .done-footer {
    flex-shrink: 0;
    padding: 16rpx 24rpx 56rpx;
    background-color: #f7f7f7;
  }

  .done-btn {
    padding: 26rpx 0;
    border-radius: 48rpx;
    background-color: #5147ff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, transform 0.15s ease;

    &-active {
      opacity: 0.85;
      transform: scale(0.98);
    }

    .done-text {
      font-size: 32rpx;
      color: #ffffff;
      font-weight: 600;
    }
  }

  .bottom-space {
    height: 40rpx;
  }
</style>
