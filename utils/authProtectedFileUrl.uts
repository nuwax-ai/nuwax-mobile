/**
 * 受保护文件 URL 鉴权拉取与打开
 * 对齐 nuwax Web 版 authProtectedFileUrl.ts
 * pathname 用字符串切分，避免 App/Kotlin 不支持 Web URL 与可选链。
 */
import { getApiBaseUrl } from "@/constants/config";
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { jumpToFilePreviewPage } from "@/utils/system.uts";

const AUTH_PROTECTED_MARKER: string = "/api/f/";

function isHttpUrl(url: string): boolean {
  const lower = url.toLowerCase();
  return lower.indexOf("http://") == 0 || lower.indexOf("https://") == 0;
}

function stripQueryAndHash(url: string): string {
  let path = url;
  const q = path.indexOf("?");
  if (q >= 0) {
    path = path.substring(0, q);
  }
  const h = path.indexOf("#");
  if (h >= 0) {
    path = path.substring(0, h);
  }
  return path;
}

/**
 * 从绝对或相对 URL 提取 pathname（不含 query/hash）。
 */
export function extractPathnameFromRemoteUrl(url: string): string {
  const cleaned = stripQueryAndHash(url);
  if (isHttpUrl(cleaned)) {
    const schemeEnd = cleaned.indexOf("://");
    if (schemeEnd >= 0) {
      const afterHost = cleaned.indexOf("/", schemeEnd + 3);
      if (afterHost >= 0) {
        return cleaned.substring(afterHost);
      }
      return "/";
    }
  }
  if (cleaned.indexOf("/") == 0) {
    return cleaned;
  }
  return `/${cleaned}`;
}

function containsAuthProtectedPath(url: string): boolean {
  return url.toLowerCase().indexOf(AUTH_PROTECTED_MARKER) >= 0;
}

function isHttpUrl(url: string): boolean {
  return url.indexOf("http://") == 0 || url.indexOf("https://") == 0;
}

/**
 * 从 URL 中提取 pathname（去掉协议、host、query、hash）。
 * 不依赖 Web URL API，兼容 App/Kotlin。
 */
function extractPathname(url: string): string {
  let path = url;
  const hashIdx = path.indexOf("#");
  if (hashIdx >= 0) {
    path = path.substring(0, hashIdx);
  }
  const queryIdx = path.indexOf("?");
  if (queryIdx >= 0) {
    path = path.substring(0, queryIdx);
  }
  if (isHttpUrl(path)) {
    const protoIdx = path.indexOf("://");
    const afterProto = path.substring(protoIdx + 3);
    const slashIdx = afterProto.indexOf("/");
    if (slashIdx >= 0) {
      return afterProto.substring(slashIdx);
    }
    return "/";
  }
  if (path.length == 0) {
    return "/";
  }
  if (path.indexOf("/") != 0) {
    return `/${path}`;
  }
  return path;
}

function extractFileNameFromUrl(url: string): string {
  const path = extractPathname(url);
  const lastSlash = path.lastIndexOf("/");
  if (lastSlash >= 0 && lastSlash < path.length - 1) {
    return path.substring(lastSlash + 1);
  }
  return "download";
}

/** 判断 URL 是否为需 Bearer 鉴权才能加载的文件地址。 */
export function isAuthProtectedFileUrl(url: string): boolean {
  if (url.length == 0) {
    return false;
  }
  const trimmed = url.trim();
  if (trimmed.length == 0) {
    return false;
  }
  return AUTH_PROTECTED_FILE_PATH_RE.test(extractPathname(trimmed));
}

/** 将相对或绝对文件 URL 规范化为可请求的完整地址。 */
export function resolveAuthProtectedFileFetchUrl(url: string): string {
  if (isHttpUrl(url)) {
    return url;
  }
  const normalizedPath = url.indexOf("/") == 0 ? url : `/${url}`;
  return `${getApiBaseUrl()}${normalizedPath}`;
}

function buildAuthHeaders(): UTSJSONObject {
  const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
  const token = tokenRaw != null ? `${tokenRaw}` : "";
  const header = {} as UTSJSONObject;
  if (token.length > 0) {
    header["Authorization"] = `Bearer ${token}`;
  }
  return header;
}

/** 从绝对 URL 提取 pathname，供 file-preview 使用。 */
export function extractPathnameFromRemoteUrl(url: string): string {
  return extractPathname(url);
}

/**
 * 拉取受保护文件并返回可用于 image 组件展示的本地/temp 地址。
 */
export function fetchAuthProtectedFileDisplayUrl(url: string): Promise<string> {
  const fetchUrl = resolveAuthProtectedFileFetchUrl(url);
  const header = buildAuthHeaders();

  return new Promise((resolve, reject) => {
    uni.downloadFile({
      url: fetchUrl,
      header: header,
      success: (res) => {
        const tempPath = res.tempFilePath;
        if (res.statusCode == 200 && tempPath != null && tempPath.length > 0) {
          resolve(tempPath);
          return;
        }
        reject(new Error("download failed"));
      },
      fail: (err) => {
        reject(err);
      },
    });
  });
}

/**
 * 解析可直接用于 image 的地址：公开图片原样返回，受保护图片携带 Bearer 下载到本地。
 * 受保护图片下载失败时保持 reject，由调用方决定使用默认图还是其他降级方案。
 */
export async function resolveAuthProtectedImageDisplayUrl(url: string): Promise<string> {
  if (!isAuthProtectedFileUrl(url)) return url;
  return await fetchAuthProtectedFileDisplayUrl(url);
}

/**
 * 打开或下载远程文件。
 * 受保护地址带 Bearer 下载；若提供 conversationId 则优先跳转预览页。
 */
export function openRemoteFileUrl(
  url: string,
  fileName: string | null = null,
  conversationId: string | number | null = null,
): Promise<void> {
  const resolvedName =
    fileName != null && fileName.length > 0
      ? fileName
      : extractFileNameFromUrl(url);

  if (conversationId != null && isAuthProtectedFileUrl(url)) {
    const path = extractPathnameFromRemoteUrl(url);
    jumpToFilePreviewPage(`${conversationId}`, path);
    return Promise.resolve();
  }

  if (isAuthProtectedFileUrl(url)) {
    const fetchUrl = resolveAuthProtectedFileFetchUrl(url);
    const header = buildAuthHeaders();
    uni.showLoading({ title: "" });
    return new Promise((resolve, reject) => {
      uni.downloadFile({
        url: fetchUrl,
        header: header,
        success: (res) => {
          uni.hideLoading();
          const tempPath = res.tempFilePath;
          if (res.statusCode == 200 && tempPath != null && tempPath.length > 0) {
            // #ifdef MP || APP-PLUS || APP-ANDROID || APP-IOS
            uni.openDocument({
              filePath: tempPath,
              showMenu: true,
              success: (_ok) => {
                resolve();
              },
              fail: (err) => {
                reject(err);
              },
            });
            // #endif
            // #ifdef H5 || WEB
            const link = document.createElement("a");
            link.href = tempPath;
            link.download = resolvedName;
            link.target = "_blank";
            link.click();
            resolve();
            // #endif
            return;
          }
          reject(new Error("download failed"));
        },
        fail: (err) => {
          uni.hideLoading();
          reject(err);
        },
      });
    });
  }

  return new Promise((resolve, reject) => {
    // #ifdef H5 || WEB
    try {
      window.open(url, "_blank");
      resolve();
    } catch (eOpen) {
      reject(eOpen);
    }
    // #endif
    // #ifdef MP-WEIXIN || APP
    uni.downloadFile({
      url: url,
      success: (res) => {
        const tempPath = res.tempFilePath;
        if (res.statusCode == 200 && tempPath != null && tempPath.length > 0) {
          uni.openDocument({
            filePath: tempPath,
            showMenu: true,
            success: (_ok) => {
              resolve();
            },
            fail: (err) => {
              reject(err);
            },
          });
        } else {
          reject(new Error("download failed"));
        }
      },
      fail: (err) => {
        reject(err);
      },
    });
    // #endif
  });
}
