/**
 * 伙伴页录音笔记接口，对齐资料库《录音 App 端对接文档》。
 */
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { getApiBaseUrl } from "@/constants/config";
import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
import { applyBearerAuthorization } from "@/utils/authSession";
import { applyXClientTypeHeader } from "@/utils/appWebViewDetect";
import request from "@/servers/useRequest";

function authHeader(): UTSJSONObject {
  const header = {} as UTSJSONObject;
  const token = uni.getStorageSync(ACCESS_TOKEN);
  applyBearerAuthorization(header, token != null ? `${token}` : null);
  applyXClientTypeHeader(header);
  return header;
}

function asApiRes(res: any | null): UTSJSONObject | null {
  if (res == null) {
    return null;
  }
  return res as UTSJSONObject;
}

function readDataString(data: any | null, key: string): string {
  if (data == null) return "";
  const obj = data as UTSJSONObject;
  const raw = obj[key];
  if (raw == null) return "";
  return `${raw}`;
}

/** 创建笔记会话，返回 noteId。title 可空，空则由服务端在转写后生成。 */
export async function apiVoiceNoteCreate(title: string): Promise<string> {
  const body = {} as UTSJSONObject;
  if (title.length > 0) body["title"] = title;
  let response: any | null = null;
  try {
    response = await request({
      url: "/api/voice/note/create",
      method: "POST",
      data: body,
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    throw new Error(apiResMessage(res));
  }
  const noteId = readDataString(apiResData<any>(res), "noteId");
  if (noteId.length == 0) {
    throw new Error("创建笔记未返回 noteId");
  }
  return noteId;
}

export async function apiVoiceNoteComplete(noteId: string, totalSegments: number): Promise<string> {
  const body = {} as UTSJSONObject;
  body["totalSegments"] = totalSegments;
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}/complete`,
      method: "POST",
      data: body,
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    throw new Error(apiResMessage(res));
  }
  const status = readDataString(apiResData<any>(res), "status");
  return status.length > 0 ? status : "PROCESSING";
}

/** 按当前状态重试：部分转写失败、文档失败或文档已删除。返回新的 status。历史页调用，不写入录音页日志。 */
export async function apiVoiceNoteReprocess(noteId: string): Promise<string> {
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}/reprocess`,
      method: "POST",
      data: {},
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    throw new Error(apiResMessage(res));
  }
  const status = readDataString(apiResData<any>(res), "status");
  return status.length > 0 ? status : "PROCESSING";
}

/** 回放音频列表。audioUrl 只在本次播放使用，不写入本地缓存。历史页调用，不写入录音页日志。 */
export async function apiVoiceNoteAudioFiles(noteId: string, page: number, pageSize: number): Promise<UTSJSONObject | null> {
  const safePage = page > 0 ? page : 1;
  const size = pageSize > 0 ? pageSize : 50;
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}/audio-files?page=${safePage}&pageSize=${size}`,
      method: "GET",
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    throw new Error(apiResMessage(res));
  }
  const data = apiResData<any>(res);
  if (data == null) return null;
  return data as UTSJSONObject;
}

export async function apiVoiceNoteDelete(noteId: string): Promise<void> {
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}/delete`,
      method: "POST",
      data: {},
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    throw new Error(apiResMessage(res));
  }
}

/**
 * 历史列表。首页不传 lastId；翻页传上一页最后一条 noteId。
 * data 按创建时间倒序：noteId、title、status、totalDurationMs、segmentCount、created。
 */
export async function apiVoiceNoteList(lastId: string, limit: number): Promise<UTSJSONObject[]> {
  const body = {} as UTSJSONObject;
  const size = limit > 0 ? limit : 20;
  body["limit"] = size > 100 ? 100 : size;
  if (lastId.length > 0) {
    const noteNumber = parseFloat(lastId);
    const digitsOnly = `${Math.floor(noteNumber)}` == lastId;
    if (!isNaN(noteNumber) && digitsOnly) {
      body["lastId"] = noteNumber;
    } else {
      body["lastId"] = lastId;
    }
  }
  let response: any | null = null;
  try {
    response = await request({
      url: "/api/voice/note/list",
      method: "POST",
      data: body,
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    throw new Error(apiResMessage(res));
  }
  const data = apiResData<any>(res);
  if (data == null || !Array.isArray(data)) {
    return [];
  }
  return data as UTSJSONObject[];
}

/**
 * 联动回放的转写帧。历史详情页使用，不写入录音页日志。
 * data 可能是帧数组，或带 frames / items / segments 的对象。
 */
export async function apiVoiceNoteTranscript(noteId: string): Promise<any | null> {
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}/transcript`,
      method: "GET",
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    throw new Error(apiResMessage(res));
  }
  return apiResData<any>(res);
}

export async function apiVoiceNoteDetail(noteId: string): Promise<UTSJSONObject | null> {
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}`,
      method: "GET",
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
