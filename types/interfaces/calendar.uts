/**
 * 日程 / 待办接口类型，对齐 /api/calendar/update、/api/calendar/reopen、/api/calendar/participant/*。
 *
 * 响应运行时恒为 UTSJSONObject，本文件的 interface 只作字段说明，禁止强转。
 * id、creatorId 为 int64，调用方按十进制字符串读写，避免经 number 丢精度。
 */

/**
 * 只按事件 ID 操作的入参，如重新打开、日程详情、删除、取消。
 * 后续取消、完成等接口若同样只传 id，继续复用这个类型。
 */
export class CalendarIdReq {
  /** 事件 ID（int64 十进制字符串） */
  id: string = "";
}

/**
 * 参与人操作入参，变更角色、回复邀请与移除参与人共用。
 * 变更角色仅创建者可调用，角色只在 EDITOR 与 VIEWER 之间切换。
 * 回复邀请时填写 replyStatus；拒绝后服务端不再发送该日程提醒。
 * eventId、userId 为 int64 十进制字符串；为 null 或非数字时不提交。
 */
export class CalendarParticipantOpReq {
  /** 事件 ID（int64 十进制字符串） */
  eventId: string | null = null;
  /** 参与人用户 ID（int64 十进制字符串） */
  userId: string | null = null;
  /** 角色，可用值 OWNER、EDITOR、VIEWER。null 表示不提交。 */
  role: string | null = null;
  /** 回复状态，可用值 NEED_ACTION、ACCEPTED、TENTATIVE、REFUSED。null 表示不提交。 */
  replyStatus: string | null = null;
}

/** 邀请时的单个参与人。userId 按十进制字符串提交，避免 int64 丢精度。 */
export class CalendarParticipantReq {
  /** 用户 ID（int64 十进制字符串） */
  userId: string | null = null;
  /** 角色，可用值 OWNER、EDITOR、VIEWER。null 表示不提交。 */
  role: string | null = null;
}

/**
 * 邀请参与人入参。仅创建者可调用，且限同租户用户。
 * participants 按人邀请；inviteGroupConvIds 按群整体邀请。null 表示不提交。
 */
export class CalendarInviteReq {
  /** 事件 ID（int64 十进制字符串） */
  eventId: string | null = null;
  /** 按人邀请的参与人。null 表示不提交。 */
  participants: CalendarParticipantReq[] | null = null;
  /** 按群邀请的会话 ID（int64 十进制字符串）。null 表示不提交。 */
  inviteGroupConvIds: string[] | null = null;
}

/**
 * 参与人完成自己份额的入参。
 * 多人待办由服务端按完成模式判定整体是否完成。
 * 日程要求提交内容时 fileKey 必传；否则保持 null。
 */
export class CalendarParticipantCompleteReq {
  /** 事件 ID（int64 十进制字符串） */
  eventId: string | null = null;
  /** 完成时提交的文件 key。未要求提交时保持 null。 */
  fileKey: string | null = null;
}

/**
 * 我的日程 / 待办查询入参。
 * 同时传 beginTime、endTime 时按日历窗口查询。
 * 都不传时，服务端返回未完成的全部，以及前后 90 天内已完成的日程。
 * 字段为 null 时不提交。
 */
export class CalendarEventQueryReq {
  /** 窗口开始时间，date-time。null 表示不提交。 */
  beginTime: string | null = null;
  /** 窗口结束时间，date-time。null 表示不提交。 */
  endTime: string | null = null;
  /** 分类，可用值 TODO、WORK。null 表示不提交。 */
  category: string | null = null;
  /** 状态列表，可用值 ACTIVE、COMPLETED、CANCELED。null 表示不提交。 */
  statuses: string[] | null = null;
  /** 关键词。null 表示不提交。 */
  keyword: string | null = null;
}

/**
 * 联系人工作日程查询入参。
 * 结果含该联系人自己的日程及其参与的日程。服务端会校验好友关系。
 * 字段为 null 时不提交。
 */
export class CalendarContactQueryReq {
  /** 窗口开始时间，date-time。null 表示不提交。 */
  beginTime: string | null = null;
  /** 窗口结束时间，date-time。null 表示不提交。 */
  endTime: string | null = null;
  /** 分类，可用值 TODO、WORK。null 表示不提交。 */
  category: string | null = null;
  /** 状态列表，可用值 ACTIVE、COMPLETED、CANCELED。null 表示不提交。 */
  statuses: string[] | null = null;
  /** 关键词。null 表示不提交。 */
  keyword: string | null = null;
  /** 联系人用户 ID（int64 十进制字符串） */
  contactUserId: string | null = null;
}

/**
 * 忙闲查询入参。
 * 不传 contactUserId 时查自己；传入时查该联系人。
 * 返回进行中工作日程的忙碌时段，包含其参与的日程。字段为 null 时不提交。
 */
export class CalendarBusyQueryReq {
  /** 联系人用户 ID（int64 十进制字符串）。null 表示查自己。 */
  contactUserId: string | null = null;
  /** 窗口开始时间，date-time。null 表示不提交。 */
  beginTime: string | null = null;
  /** 窗口结束时间，date-time。null 表示不提交。 */
  endTime: string | null = null;
}

/** 忙碌时段。 */
export interface CalendarBusySlotDto {
  /** 开始时间，date-time */
  startTime: string;
  /** 结束时间，date-time */
  endTime: string;
  /** 日程标题 */
  title: string;
}

/** 自定义字段。更新时随 extraFields 整表提交。 */
export class CalendarExtraField {
  /** 字段名 */
  key: string = "";
  /** 字段值 */
  value: string = "";
}

/**
 * 创建日程 / 待办入参。
 * 字段为 null 时不提交。participants 按人邀请，inviteGroupConvIds 按群整体邀请。
 */
export class CalendarEventCreateDto {
  /** 分类，可用值 TODO、WORK。null 表示不提交。 */
  category: string | null = null;
  /** 标题。null 表示不提交。 */
  title: string | null = null;
  /** 描述。null 表示不提交。 */
  description: string | null = null;
  /** 地点。null 表示不提交。 */
  location: string | null = null;
  /** 是否全天。null 表示不提交。 */
  allDay: boolean | null = null;
  /** 开始时间，date-time。null 表示不提交。 */
  startTime: string | null = null;
  /** 结束时间，date-time。null 表示不提交。 */
  endTime: string | null = null;
  /** 重要程度。null 表示不提交。 */
  priority: number | null = null;
  /** 是否开启提醒。null 表示不提交。 */
  remindEnabled: boolean | null = null;
  /** 提前多少分钟开始提醒。null 表示不提交。 */
  remindBeforeMinutes: number | null = null;
  /** 提醒方式，可用值 ONCE、REPEAT。null 表示不提交。 */
  remindType: string | null = null;
  /** 重复提醒间隔（分钟）。null 表示不提交。 */
  remindIntervalMinutes: number | null = null;
  /** 按人邀请的参与人。null 表示不提交。 */
  participants: CalendarParticipantReq[] | null = null;
  /** 按群邀请的会话 ID（int64 十进制字符串）。null 表示不提交。 */
  inviteGroupConvIds: string[] | null = null;
  /** 完成模式，可用值 ANY_ONE、BY_RATIO、ALL。null 表示不提交。 */
  completeMode: string | null = null;
  /** 按比例完成的阈值（0-100）。null 表示不提交。 */
  completeRatio: number | null = null;
  /** 完成时是否必须提交内容。null 表示不提交。 */
  requireSubmit: boolean | null = null;
  /** 自定义字段。null 表示不提交。 */
  extraFields: CalendarExtraField[] | null = null;
}

/**
 * 更新日程 / 待办入参。
 * 除 id 外，字段为 null 表示不修改；服务端收到 null 会保持原值。
 * 修改 startTime 或 endTime 时，服务端会按新时间重算提醒。
 */
export class CalendarEventUpdateDto {
  /** 事件 ID（int64 十进制字符串）。更新必填。 */
  id: string = "";
  /** 分类，可用值 TODO、WORK。null 表示不修改。 */
  category: string | null = null;
  /** 标题。null 表示不修改。 */
  title: string | null = null;
  /** 描述。null 表示不修改。 */
  description: string | null = null;
  /** 地点。null 表示不修改。 */
  location: string | null = null;
  /** 是否全天。null 表示不修改。 */
  allDay: boolean | null = null;
  /** 开始时间，date-time。null 表示不修改。 */
  startTime: string | null = null;
  /** 结束时间，date-time。null 表示不修改。 */
  endTime: string | null = null;
  /** 重要程度。null 表示不修改。 */
  priority: number | null = null;
  /** 是否开启提醒。null 表示不修改。 */
  remindEnabled: boolean | null = null;
  /** 提前多少分钟开始提醒。null 表示不修改。 */
  remindBeforeMinutes: number | null = null;
  /** 提醒方式，可用值 ONCE、REPEAT。null 表示不修改。 */
  remindType: string | null = null;
  /** 重复提醒间隔（分钟）。null 表示不修改。 */
  remindIntervalMinutes: number | null = null;
  /** 完成模式，可用值 ANY_ONE、BY_RATIO、ALL。null 表示不修改。 */
  completeMode: string | null = null;
  /** 按比例完成的阈值（0-100）。null 表示不修改。 */
  completeRatio: number | null = null;
  /** 完成时是否必须提交内容。null 表示不修改。 */
  requireSubmit: boolean | null = null;
  /** 自定义字段。null 表示不修改；传空数组表示清空。 */
  extraFields: CalendarExtraField[] | null = null;
}

/** 参与人。userId 为 int64，按十进制字符串读取。 */
export interface CalendarParticipantDto {
  /** 用户 ID（int64） */
  userId: string;
  /** 角色，可用值 OWNER、EDITOR、VIEWER */
  role: string;
  /** 回复状态，可用值 NEED_ACTION、ACCEPTED、TENTATIVE、REFUSED */
  replyStatus: string;
  /** 该参与人是否已完成 */
  completed: boolean;
  /** 参与人完成时间 */
  participantCompletedTime: string;
  /** 完成时提交的文件 key */
  submitFileKey: string;
}

/**
 * 更新成功后的日程 / 待办。
 * 运行时为 UTSJSONObject，用下标读取；id、creatorId、参与人 userId 按字符串取。
 */
export interface CalendarEventDto {
  /** 事件 ID（int64） */
  id: string;
  /** 分类，可用值 TODO、WORK */
  category: string;
  /** 标题 */
  title: string;
  /** 描述 */
  description: string;
  /** 地点 */
  location: string;
  /** 是否全天 */
  allDay: boolean;
  /** 开始时间，date-time */
  startTime: string;
  /** 结束时间，date-time */
  endTime: string;
  /** 重要程度 */
  priority: number;
  /** 状态，可用值 ACTIVE、COMPLETED、CANCELED */
  status: string;
  /** 是否开启提醒 */
  remindEnabled: boolean;
  /** 提前多少分钟开始提醒 */
  remindBeforeMinutes: number;
  /** 提醒方式，可用值 ONCE、REPEAT */
  remindType: string;
  /** 重复提醒间隔（分钟） */
  remindIntervalMinutes: number;
  /** 下一次提醒时间，date-time */
  nextRemindTime: string;
  /** 创建者用户 ID（int64） */
  creatorId: string;
  /** 创建时间，date-time */
  created: string;
  /** 参与人 */
  participants: CalendarParticipantDto[];
  /** 完成模式，可用值 ANY_ONE、BY_RATIO、ALL */
  completeMode: string;
  /** 按比例完成的阈值 */
  completeRatio: number;
  /** 完成时是否必须提交内容 */
  requireSubmit: boolean;
  /** 自定义字段 */
  extraFields: CalendarExtraField[];
}

/**
 * 待回复的日程邀请。
 * event 运行时为 UTSJSONObject，按 CalendarEventDto 读取，不要强转。
 */
export interface CalendarInvitationDto {
  /** 被邀请的日程 */
  event: CalendarEventDto;
  /** 我的回复状态，可用值 NEED_ACTION、ACCEPTED、TENTATIVE、REFUSED */
  myReplyStatus: string;
}
