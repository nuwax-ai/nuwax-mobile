import eventBus from "@/utils/eventBus";
export const VOIP_AUDIO_CLAIM = "voip_audio_claim";
let occupied = false;
export function isVoipAudioOccupied(): boolean { return occupied; }
export function claimVoipAudio(): void {
  if (occupied) return;
  occupied = true;
  eventBus.emit(VOIP_AUDIO_CLAIM, {});
}
export function releaseVoipAudio(): void { occupied = false; }
