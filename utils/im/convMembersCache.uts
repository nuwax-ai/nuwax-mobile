import { getImSessionStamp } from "./imSessionScope";
/**
 * 会话成员原始表缓存（convId → ConversationMemberDto 原始 records，App 进程内，
 * 页面销毁不丢）。
 *
 * 用途：@提及两入口共用一份数据——聊天页进页 loadMembers 全量拉取后写缓存，
 * 点输入框 @ 打开的选择成员页（at-select）优先读缓存免重拉（同接口同口径，
 * 省掉一次 3-5 个串行翻页请求）。写入口两处：chat.uvue / at-select.uvue 各自
 * 拉取成功后回写（谁先拉到谁写）。
 *
 * ★records 为共享引用：消费方只读（各自解析成页面行模型），勿改元素。
 * 失效：①随 IM 会话戳（token/origin/epoch 变化=换账号/登出）自动清空，不串账号
 * （contactRemarkCache 同款）；②TTL 5 分钟——成员增删/名片改名等漂移靠它兜底
 * （两页对名单实时性要求都低：聊天页自身 membersLoaded 后也不重拉）。
 */

const CONV_MEMBERS_TTL_MS = 5 * 60 * 1000;

class ConvMembersEntry {
  records: UTSJSONObject[] = [];
  savedAt: number = 0;
}

let cached: Map<string, ConvMembersEntry> | null = null;
let cacheSession = "";

function ensureCacheSession(): void {
  if (cacheSession != getImSessionStamp()) {
    cached = null;
    cacheSession = getImSessionStamp();
  }
}

/** 写缓存（convId 空/records 空不写——空群缓存无意义，重拉一次也无妨）。 */
export function setCachedConvMembers(convId: string, records: UTSJSONObject[]): void {
  ensureCacheSession();
  if (convId.length == 0 || records.length == 0) {
    return;
  }
  // 模块级可空变量不做方法调用（UTS→Kotlin smart cast 不传导）：局部承接再回写
  let map = cached;
  if (map == null) {
    map = new Map<string, ConvMembersEntry>();
    cached = map;
  }
  const entry = new ConvMembersEntry();
  entry.records = records;
  entry.savedAt = Date.now();
  map.set(convId, entry);
}

/** 取缓存；未缓存/过期返回 null（过期即删，防同键反复判过期）。 */
export function getCachedConvMembers(convId: string): UTSJSONObject[] | null {
  ensureCacheSession();
  const map = cached;
  if (map == null || convId.length == 0) {
    return null;
  }
  const entry = map.get(convId);
  if (entry == null) {
    return null;
  }
  if (Date.now() - entry.savedAt > CONV_MEMBERS_TTL_MS) {
    map.delete(convId);
    return null;
  }
  return entry.records;
}

/** 失效（成员增删等使快照变脏时调用；取用方下次 miss 自会重拉新数据）。
 *  写入方：群成员页删人成功、群设置页加人成功（本页只拉首页 100 条，无法回写
 *  新的全量快照，只能失效）；群成员页全量到账走 set 回写保鲜，不经此函数。 */
export function invalidateCachedConvMembers(convId: string): void {
  ensureCacheSession();
  const map = cached;
  if (map == null || convId.length == 0) {
    return;
  }
  map.delete(convId);
}
