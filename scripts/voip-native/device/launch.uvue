<template>
  <view class="launch-page">
    <view v-if="showPrivacy" class="privacy-card">
      <text class="privacy-title">{{ t("Mobile.Auth.firstLaunchTitle") }}</text>
      <scroll-view class="privacy-scroll" :scroll-y="true"><text class="privacy-text">{{ privacyPolicySummary }}</text></scroll-view>
      <button open-type="agreePrivacyAuthorization" @click="agree">{{ t("Mobile.Common.agree") }}</button>
      <button @click="decline">{{ t("Mobile.Common.disagree") }}</button>
    </view>
  </view>
</template>
<script setup lang="uts">
import { ref } from "vue";
import { onReady, onUnload } from "@dcloudio/uni-app";
import { prepareAppPrivacyConsent, completeAppPrivacyConsent } from "@/utils/appPrivacyConsent";
import { APP_PRIVACY_POLICY_SUMMARY } from "@/constants/appPrivacyPolicySummary";
import { localText } from "@/utils/i18nLocalText";
const t = (key: string): string => localText(key);
const showPrivacy = ref(false);
const privacyPolicySummary = APP_PRIVACY_POLICY_SUMMARY;
let accepting = false, routed = false;
let privacyListener = 0;
function enter(): void { if (routed) return; routed = true; uni.reLaunch({ url: "/subpackages/pages/voip-dev/voip-dev" }); }
function decline(): void { uni.exit(); }
function agree(): void {
  if (accepting || routed) return; accepting = true;
  setTimeout(() => { completeAppPrivacyConsent((accepted: boolean) => { accepting = false; if (accepted) enter(); else uni.showToast({ title: t("Mobile.Auth.pleaseAgreeProtocol"), icon: "none" }); }); }, 0);
}
onReady(() => {
  // #ifdef APP-ANDROID
  privacyListener = uni.onPrivacyAuthorizationChange((res) => { if (!res.needAuthorization) agree(); });
  // #endif
  prepareAppPrivacyConsent((accepted: boolean) => { if (accepted) enter(); else showPrivacy.value = true; });
});
onUnload(() => {
  // #ifdef APP-ANDROID
  if (privacyListener > 0) uni.offPrivacyAuthorizationChange(privacyListener);
  // #endif
});
</script>
<style scoped>
.launch-page { flex: 1; padding: 32px 20px; background-color: #f5f6fa; justify-content: center; }
.privacy-card { height: 88%; padding: 18px; border-radius: 14px; background-color: #ffffff; }
.privacy-title { font-size: 20px; font-weight: 600; margin-bottom: 12px; }
.privacy-scroll { flex: 1; }
.privacy-text { font-size: 13px; line-height: 21px; color: #333333; white-space: pre-wrap; }
</style>
