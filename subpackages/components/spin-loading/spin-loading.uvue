<template>
  <!--
    App 端 CSS @keyframes / image animation 常无效；
    用 transition + setInterval 自驱动旋转，避免 transitionend 在父级重渲染中途改响应式触发 CME。
    每次 tick 一次转 CYCLES_PER_TICK 圈（默认 4 圈），JS→native 更新频率降为 1/N，
    中间过渡完全由原生渲染层完成，缓解 App 端逐帧桥接造成的卡顿。
  -->
  <view
    class="spin-loading"
    :style="boxStyle"
  ></view>
</template>

<script setup lang="uts">
  import { ref, computed, onMounted, onUnmounted } from "vue";

  const props = withDefaults(
    defineProps<{
      /** 尺寸，如 14px / 24px */
      size?: string;
      /** 环颜色 */
      color?: string;
      /** 一圈时长（ms），默认 1000 对齐 H5 */
      durationMs?: number;
    }>(),
    {
      size: "16px",
      color: "#3283ff",
      durationMs: 1000,
    },
  );

  const times = ref<number>(0);
  let spinTimer: number = 0;
  let startTimer: number = 0;

  /** 单次 JS 驱动转动的圈数：>1 成倍降低 setInterval 触发频率，
      中间过渡完全由原生 transition 完成，视觉与匀速单圈一致。
      App 端每触发一次 JS→native 更新都有桥接开销，降低频率是消除卡顿的关键。 */
  const CYCLES_PER_TICK = 4;

  /** 单次过渡持续时长 = 圈数 × 单圈时长（与目标角度同步变化，保证角速度不变） */
  const tickDurationMs = computed((): number => {
    const period =
      props.durationMs != null && props.durationMs > 0
        ? props.durationMs
        : 1000;
    return period * CYCLES_PER_TICK;
  });

  const boxStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    style["width"] = props.size;
    style["height"] = props.size;
    style["borderTopColor"] = props.color;
    style["borderRightColor"] = props.color;
    style["transform"] = `rotate(${times.value * 360}deg)`;
    style["transitionDuration"] = `${tickDurationMs.value}ms`;
    return style;
  });

  function clearSpinTimers(): void {
    if (spinTimer != 0) {
      clearInterval(spinTimer);
      spinTimer = 0;
    }
    if (startTimer != 0) {
      clearTimeout(startTimer);
      startTimer = 0;
    }
  }

  onMounted(() => {
    // 等节点就绪后再启动，避免首帧 transition 不触发
    startTimer = setTimeout(() => {
      startTimer = 0;
      times.value = CYCLES_PER_TICK;
      spinTimer = setInterval(() => {
        // 角度单调递增不取模：rotate 目标值必须大于起始值 transition 才会转动，
        // 大角度对渲染无影响（同余），float64 精度足够
        times.value = times.value + CYCLES_PER_TICK;
      }, tickDurationMs.value);
    }, 50);
  });

  onUnmounted(() => {
    clearSpinTimers();
  });
</script>

<style lang="scss" scoped>
  .spin-loading {
    box-sizing: border-box;
    border-radius: 100px;
    border-top-width: 2px;
    border-top-style: solid;
    border-right-width: 2px;
    border-right-style: solid;
    border-bottom-width: 2px;
    border-bottom-style: solid;
    border-bottom-color: transparent;
    border-left-width: 2px;
    border-left-style: solid;
    border-left-color: transparent;
    transition-property: transform;
    transition-timing-function: linear;
    transform: rotate(0deg);
  }
</style>
