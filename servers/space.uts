import request from "./useRequest";
import { RequestResponse } from "@/types/interfaces/request";

/** 用户空间列表（对齐 PC apiSpaceList）：首页空间选择器数据源。 */
export async function apiSpaceList(): Promise<RequestResponse<any>> {
  const res = await request({
    url: "/api/space/list",
    method: "GET",
  });
  return res;
}
