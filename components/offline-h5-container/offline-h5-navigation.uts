/** uni-app x H5 适配：用 Vue Router 的公开实例导航，不修改 DCloud 桥全局。 */
// #ifdef H5 || WEB
import { nextTick } from 'vue';

export function registerOfflineH5Navigation(router: any): void {
  const bridge = (window as any).OfflineH5Bridge;
  if (bridge == null || router == null) return;
  bridge.registerNavigator(async (route: string, requestId: string, isCurrent: () => boolean): Promise<void> => {
    const debug = (code: string): void => { bridge.debug(requestId, code); };
    if (!route.startsWith('/') || route.startsWith('//')) throw new Error('invalid offline route');
    debug('nav-start');
    // 先经过轻量路由，确保同一页面不同 query 也重新挂载，旧组件保留自己的 requestId。
    await router.replace('/pages/offline-h5-bootstrap/offline-h5-bootstrap?transition=1');
    debug('nav-transition-done');
    await nextTick();
    if (!isCurrent()) { debug('nav-superseded'); return; }
    await router.replace(route);
    debug('nav-target-done');
  });
}
// #endif
