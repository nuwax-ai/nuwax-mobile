/**
 * 项目收藏（2026-09-13 契约：collect/unCollect 双路径独立接口；
 * projectType 必传 query，后端归属校验同 conversation/create 口径）。
 */
export async function apiUserProjectCollect(id: number, projectType: string): Promise<VoidRequestResponse> {
  const res = await request({
    url: `/api/user-project/collect/${id}?projectType=${encodeURIComponent(projectType)}`,
    method: "POST",
