<template>
  <view class="provision-entry">
    <custom-nav-bar :title="t('Mobile.Provision.Entry.title')" :show-back="true" :has-safety-zone="true" />

    <view class="provision-entry__body">
      <!-- 重配提示 -->
      <text v-if="isReprovision" class="provision-entry__reprovision-tip">{{ t('Mobile.Provision.Entry.reprovisionTip') }}</text>

      <!-- 扫码配网 -->
      <view class="entry-card" hover-class="entry-card--hover" @tap="handleScanQr">
        <view class="entry-card__icon entry-card__icon--primary">
          <text class="entry-card__emoji">📷</text>
        </view>
        <view class="entry-card__info">
          <text class="entry-card__title">{{ t('Mobile.Provision.Entry.scanQr') }}</text>
          <text class="entry-card__desc">{{ t('Mobile.Provision.Entry.scanQrDesc') }}</text>
        </view>
        <text class="entry-card__arrow">›</text>
      </view>

      <!-- 手动蓝牙配网 -->
      <view class="entry-card" hover-class="entry-card--hover" @tap="handleManualBle">
        <view class="entry-card__icon">
          <text class="entry-card__emoji">📡</text>
        </view>
        <view class="entry-card__info">
          <text class="entry-card__title">{{ t('Mobile.Provision.Entry.manualBle') }}</text>
          <text class="entry-card__desc">{{ t('Mobile.Provision.Entry.manualBleDesc') }}</text>
        </view>
        <text class="entry-card__arrow">›</text>
      </view>

      <!-- 提示 -->
      <text class="provision-entry__tip">{{ t('Mobile.Provision.Entry.tip') }}</text>

      <!-- 临时 debug：直通配网 Mock 调试页（模拟器/无相机时模拟扫码验解析） -->
      <text class="provision-entry__debug" @tap="goDebug">🛠 调试页 test-provision</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { orEmpty } from "@/utils/utsCoalesce.uts";
  import { setReprovisionTarget, ReprovisionTarget, setQrPayload } from "@/utils/provisionSession";
  import { useEspProvisioning } from "@/hooks/useEspProvisioning";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const controller = useEspProvisioning();
  const isReprovision = ref<boolean>(false);

  /**
   * 扫码失败提示：正式文案 + 稳定错误码（不含原始 QR / PoP）。
   * 开发包额外把 errorCode 打进 toast，方便 Android 真机一眼定位。
   */
  const showQrInvalid = (errorCode: string) => {
    console.warn(`[provision-entry] QR parse failed: ${errorCode}`);
    let title = t("Mobile.Provision.Entry.qrInvalid");
    // NOTE: 自定义基座打包时 process.env.NODE_ENV 非 development，门控不生效；
    //       调试期始终把稳定错误码拼进 toast，便于真机一眼定位。正式发布前恢复门控。
    if (errorCode != "") {
      title = `${title} (${errorCode})`;
    }
    uni.showToast({ title: title, icon: "none", duration: 3000 });
  };

  const handleScanQr = () => {
    // #ifdef APP || MP-WEIXIN
    uni.scanCode({
      onlyFromCamera: false,
      success: (res: ScanCodeSuccess) => {
        const scanType = res.scanType != null ? res.scanType : "";
        const raw = res.result != null ? res.result : "";
        // 脱敏诊断：只看结构特征，不打 PoP / 全文
        const firstChar = raw.length > 0 ? raw.substring(0, 1) : "";
        const hasName = raw.indexOf('"name"') >= 0;
        const hasProv = raw.indexOf('PROV_') >= 0;
        const hasSecurity = raw.indexOf('"security"') >= 0;
        console.log(`[provision-entry] scan raw: type=${scanType} len=${raw.length} first="${firstChar}" hasName=${hasName} hasProv=${hasProv} hasSecurity=${hasSecurity}`);
        if (raw == "") {
          showQrInvalid("QR_EMPTY");
          return;
        }
        const parseResult = controller.configureFromQr(raw);
        console.log(`[provision-entry] parse: name=${parseResult.payload != null ? parseResult.payload.name : "null"} code=${parseResult.errorCode}`);
        if (parseResult.payload == null) {
          const code = parseResult.errorCode != "" ? parseResult.errorCode : "QR_UNKNOWN";
          showQrInvalid(code);
          return;
        }
        setQrPayload(parseResult.payload);
        uni.navigateTo({ url: "/subpackages/pages/provision/provision-connect/provision-connect" });
      },
      fail: (_res: ScanCodeFail) => {
        // 用户取消扫码，不提示
      },
    });
    // #endif
    // #ifndef APP
    // #ifndef MP-WEIXIN
    uni.showToast({ title: t("Mobile.Provision.Entry.qrInvalid"), icon: "none" });
    // #endif
    // #endif
  };

  const handleManualBle = () => {
    uni.navigateTo({ url: "/subpackages/pages/provision/provision-scan/provision-scan" });
  };

  // 临时 debug：直通配网 Mock 调试页（test-provision），联调完删除
  const goDebug = () => {
    uni.navigateTo({ url: "/pages/test-provision/test-provision" });
  };

  onLoad((options: any) => {
    if (options != null) {
      const optObj = options as UTSJSONObject;
      const deviceIdVal = optObj["deviceId"];
      const nameVal = optObj["name"];
      if (deviceIdVal != null && `${deviceIdVal}`.length > 0) {
        const deviceId = orEmpty(decodeURIComponent(`${deviceIdVal}`));
        const name = nameVal != null ? orEmpty(decodeURIComponent(`${nameVal}`)) : "";
        setReprovisionTarget(new ReprovisionTarget(deviceId, name));
        isReprovision.value = true;
      }
    }
  });
</script>

<style lang="scss" scoped>
  .provision-entry {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;

    &__body {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 32rpx;
    }

    &__reprovision-tip {
      font-size: 26rpx;
      color: #5147ff;
      background-color: rgba(81, 71, 255, 0.08);
      border-radius: 12rpx;
      padding: 20rpx 24rpx;
      margin-bottom: 24rpx;
      text-align: center;
    }

    &__tip {
      font-size: 24rpx;
      color: #999;
      text-align: center;
      margin-top: 40rpx;
    }

    &__debug {
      font-size: 26rpx;
      color: #5147ff;
      text-align: center;
      margin-top: 24rpx;
    }
  }

  .entry-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: #ffffff;
    border-radius: 20rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;

    &--hover {
      background-color: #f1f1f1;
    }

    &__icon {
      width: 96rpx;
      height: 96rpx;
      border-radius: 20rpx;
      background-color: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 24rpx;

      &--primary {
        background-color: rgba(81, 71, 255, 0.1);
      }
    }

    &__emoji {
      font-size: 48rpx;
    }

    &__info {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    &__title {
      font-size: 32rpx;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 8rpx;
    }

    &__desc {
      font-size: 24rpx;
      color: #999;
      line-height: 1.4;
    }

    &__arrow {
      font-size: 40rpx;
      color: #c0c0c0;
      font-weight: 300;
      line-height: 1;
    }
  }
</style>
