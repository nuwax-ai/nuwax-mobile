/** 连接器列表数据源；与 PC ConnectorListView 一致。 */
export type ConnectorListSourceType = "connected" | "system" | "team" | "search";

/** default 对齐 PC list；simple 对齐 PC list + simple。 */
export type ConnectorListVariant = "default" | "simple";

/** 连接器列表统一条目；接口差异在组件内部归一化。 */
export class ConnectorListItem {
  key: string = "";
  rawId: string = "";
  connectionId: number = 0;
  spaceId: number = 0;
  name: string = "";
  description: string = "";
  category: string = "";
  icon: string = "";
  authType: string = "";
  connected: boolean = false;
  connectionEnabled: boolean = false;
}

/** 动态凭证输入项。 */
export class ConnectorCredentialField {
  name: string = "";
  label: string = "";
  placeholder: string = "";
  secret: boolean = true;
  value: string = "";
}
