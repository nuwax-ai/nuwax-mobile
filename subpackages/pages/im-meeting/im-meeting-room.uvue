    flex-direction: column;
  }

  .mr-member {
    padding: 8px 0;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  /* 会中成员行：上排是身份，下排是主持人操作（竖排容器） */
  .mr-member--tile {
    flex-direction: column;
    align-items: stretch;
    padding: 10px 0;
    border-bottom: 1px solid #f2f1f7;
  }

  .mr-member__line {
    display: flex;
    flex-direction: row;
    align-items: center;
