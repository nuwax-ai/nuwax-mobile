<template>
  <uni-modal-popup
    ref="popup"
    :title="t('Mobile.Common.loginRegister')"
    position="bottom"
    height="50%"
    :enable-swipe-close="false"
    :body-scroll="false"
  >
    <view class="login-popup-container">
      <view class="login-popup-content">
        <!-- 微信小程序登录 -->
        <view
          class="weixin-login-form"
          v-if="!loading && tenantConfigInfo != null"
        >
          <view class="sub-title-wrapper">
            <text class="sub-title">{{ t("Mobile.Auth.welcomeUse") }}</text>
          </view>

          <!-- 登录区域 -->
          <view class="login-section">
            <!-- 协议勾选 -->
            <agreement-checkbox v-model="agreeTerms" />

            <!-- 登录按钮 -->
            <button class="login-btn" @tap="onLoginClick">
              {{ t("Mobile.Auth.oneClickLogin") }}
            </button>
          </view>

          <!-- 手机号登录链接 -->
          <view class="phone-login-link" @tap="goToPhoneLogin">
            {{ t("Mobile.Auth.phoneLoginRegister") }}
          </view>
        </view>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { ref, type ComponentPublicInstance } from "vue";
  import { apiTenantConfig, apiWechatLogin } from "@/servers/account";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import { WechatLoginParams } from "@/types/interfaces/login";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import AgreementCheckbox from "@/components/agreement-checkbox/agreement-checkbox.uvue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import { getCurrentPagePath } from "@/utils/commonBusiness";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const _params = emptyI18nParams();
  const t = (key: string): string => translateFn(key, _params, "");

  const emit = defineEmits(["login-success"]);

  const popup = ref<any | null>(null);
  // UTS: `null as any` 等价于 `null as Any`(非空)，setup 阶段即抛 NPE。改为可空具体类型。
  const tenantConfigInfo = ref<any | null>(null);
  const loading = ref(false);
  const agreeTerms = ref(false);

  /** Android：Gen* 组件 ref 禁止 as UTSJSONObject，用 $callMethod 调 uni-modal-popup */
  const callPopupMethod = (methodName: string): void => {
    const refVal = popup.value;
    if (refVal == null) {
      return;
    }
    const proxy = refVal as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  };

  // 打开弹窗
  const open = async () => {
    await fetchTenantConfig();
    callPopupMethod("open");
  };

  // 关闭弹窗
  const close = () => {
    callPopupMethod("close");
  };

  // 获取租户配置
  const fetchTenantConfig = async () => {
    try {
      loading.value = true;
      const res = await apiTenantConfig();
      if (apiResCode(res) == SUCCESS_CODE) {
        tenantConfigInfo.value = apiResData<any>(res);
      }
    } finally {
      loading.value = false;
    }
  };

  // 点击登录按钮
  const onLoginClick = () => {
    if (!agreeTerms.value) {
      uni.showModal({
        title: t("Mobile.Common.tip"),
        content: t("Mobile.Auth.pleaseAgreeProtocol"),
        confirmText: t("Mobile.Common.agree"),
        cancelText: t("Mobile.Common.disagree"),
        success: function (res) {
          if (res.confirm) {
            agreeTerms.value = true;
          }
        },
      });
    }
  };

  // 跳转到手机号登录页面
  const goToPhoneLogin = () => {
    const currentUrl = getCurrentPagePath();
    const url = `/subpackages/pages/login/login?redirect=${encodeURIComponent(currentUrl)}`;
    uni.navigateTo({ url });
    close();
  };

  // 登录成功处理
  const handleLoginSuccess = (code: string, data: any, message: string) => {
    // 4. 登录成功
    if (code == SUCCESS_CODE) {
      const dataObj = data != null ? (data as UTSJSONObject) : null;
      const token = dataObj != null ? dataObj["token"] : null;
      if (token != null) {
        // #ifdef H5 || WEB
        if (process.env.NODE_ENV === "development") {
          uni.setStorageSync(ACCESS_TOKEN, token as string);
        }
        // #endif

        // #ifdef MP-WEIXIN
        uni.setStorageSync(ACCESS_TOKEN, token as string);
        // #endif

        // #ifdef APP
        uni.setStorageSync(ACCESS_TOKEN, token as string);
        // #endif
      }

      uni.showToast({
        title: t("Mobile.Auth.loginSuccess"),
        icon: "success",
      });
      setTimeout(() => {
        close();
        uni.reLaunch({
          url: "/pages/index/index",
        });
      }, 1000);
    } else {
      uni.showToast({
        title: message.length > 0 ? message : t("Mobile.Auth.loginFailed"),
        icon: "none",
      });
    }
  };

  // 微信一键登录
  // #ifndef APP
  const onGetPhoneNumber = async (event: any) => {
    // 1. 检查用户是否取消授权
    if (
      event == null ||
      event.detail == null ||
      event.detail.errMsg !== "getPhoneNumber:ok"
    ) {
      uni.showToast({
        title: t("Mobile.Auth.userCancelAuthorize"),
        icon: "none",
      });
      return;
    }

    // 2. 微信新版返回的 phoneCode
    const phoneCode = event.detail.code;

    try {
      uni.showLoading({ title: t("Mobile.Page.loading") });
      // 3. 请求后端登录接口
      const loginParams = new WechatLoginParams();
      loginParams.code = phoneCode;
      const loginRes = await apiWechatLogin(loginParams);
      const loginCode =
        apiResCode(loginRes) != null ? apiResCode(loginRes)! : "";
      handleLoginSuccess(
        loginCode,
        apiResData<any>(loginRes),
        apiResMessage(loginRes),
      );
    } finally {
      uni.hideLoading();
    }
  };
  // #endif

  // 暴露方法给父组件调用
  defineExpose({
    open: open as any,
    close: close as any,
    popup,
  });
</script>

<style lang="scss" scoped>
  .login-popup-container {
    width: 100%;
    background: #fff;
    overflow: hidden;
  }

  .login-popup-content {
    padding: 0 32rpx 64rpx;
  }

  .weixin-login-form {
    display: flex;
    flex-direction: column;
  }

  .sub-title-wrapper {
    margin-top: 40rpx;
    margin-bottom: 80rpx;
    text-align: center;
  }

  .sub-title {
    color: #000;
    text-align: center;
    font-size: 40rpx;
    font-style: normal;
    font-weight: 600;
    line-height: 56rpx;
  }

  .login-section {
    margin-bottom: 40rpx;
  }

  .login-btn {
    margin-top: 20rpx;
    width: 100%;
    border-radius: 16rpx;
    padding: 25rpx 24rpx;
    font-size: 32rpx;
    font-weight: 400;
    margin-bottom: 32rpx;
    line-height: 48rpx;
    text-align: center;
    background: #5147ff;
    color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .phone-login-link {
    width: 100%;
    text-align: center;
    font-size: 32rpx;
    color: rgba(21, 23, 31, 0.5);
    margin-top: 20rpx;
    /* #ifndef APP */
    cursor: pointer;
    /* #endif */
  }
</style>
