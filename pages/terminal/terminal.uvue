<template>
  <view class="container relative flex flex-col">
    <!-- 顶部导航栏 -->
    <custom-nav-bar :title="t('Mobile.Nav.terminal')" className="border-b" hasSafetyZone />

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <!-- 设备列表 -->
      <view class="card-group">
        <view v-if="deviceLoading" class="empty-box">
          <text class="empty-text">{{ t("Mobile.Terminal.loading") }}</text>
        </view>
        <view v-else-if="deviceLoadError && isLoggedIn" class="empty-box" hover-class="row-item-active" @tap="fetchDeviceList(false)">
          <text class="empty-text empty-text-link">{{ t("Mobile.Terminal.fetchDevicesFailedRetry") }}</text>
        </view>
        <view
          v-for="device in deviceList"
          :key="device.bindingId != '' ? device.bindingId : device.deviceId"
          class="row-item"
          hover-class="row-item-active"
          @click="handleDeviceClick(device)"
        >
          <view class="row-avatar">
            <text class="row-avatar-emoji">{{ device.icon }}</text>
          </view>
          <view class="row-info">
            <text class="row-title">{{ device.name }}</text>
            <text class="row-desc">{{ device.desc }}</text>
          </view>
          <view class="row-status">
            <view :class="['status-dot', deviceStatusDotClass(device)]"></view>
            <text :class="['status-text', deviceStatusTextClass(device)]">
              {{ deviceStatusText(device) }}
            </text>
          </view>
          <!-- 只有已绑定但离线的设备允许重新配网 -->
          <view v-if="device.bindingStatus == 'BOUND' && !device.online" class="reprovision-btn" @tap.stop="handleReprovision(device)">
            <text class="reprovision-btn-text">{{ t("Mobile.Terminal.reprovision") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>

        <!-- 已登录但无绑定设备 -->
        <view v-if="!deviceLoading && deviceList.length == 0 && isLoggedIn" class="empty-box">
          <text class="empty-text">{{ t("Mobile.Terminal.noDevices") }}</text>
        </view>
        <!-- 未登录引导 -->
        <view v-if="!deviceLoading && !isLoggedIn" class="empty-box" hover-class="row-item-active" @click="handleLogin">
          <text class="empty-text empty-text-link">{{ t("Mobile.Terminal.loginTip") }}</text>
        </view>
      </view>

      <!-- 我的电脑入口：已隐藏（独立页 terminal-my-computer 暂不在此暴露） -->

      <!-- 添加搭子灵珠 -->
      <!-- #ifdef APP-IOS || APP-ANDROID || APP-HARMONY -->
      <view class="add-card" hover-class="add-card-active" @click="handleAddDevice">
        <view class="add-icon">
          <text class="add-icon-plus">+</text>
        </view>
        <view class="add-info">
          <text class="add-title">{{ t("Mobile.Terminal.addDevice") }}</text>
          <text class="add-desc">{{ t("Mobile.Terminal.addDeviceDesc") }}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <!-- #endif -->

      <!-- 产品购买卡（数据源：GET /api/app/device-goods；未登录/失败回退静态默认） -->
      <view class="product-card">
        <view class="product-icon">
          <image v-if="product.imageUrl" class="product-icon-img" :src="product.imageUrl" mode="aspectFill" />
          <text v-else class="product-icon-emoji">🔮</text>
        </view>
        <text class="product-name">{{ product.title }}</text>
        <text class="product-sub">{{ product.subtitle }}</text>
        <text class="product-price">¥{{ productPriceText }}</text>

        <view class="product-features">
          <view class="feature-item" v-for="(feature, index) in product.highlights" :key="index">
            <view class="feature-icon">
              <text class="feature-check">✓</text>
            </view>
            <text class="feature-text">{{ feature }}</text>
          </view>
        </view>

        <view class="buy-btn" hover-class="buy-btn-active" @click="handleBuy">
          <text class="buy-btn-text">{{ product.buttonText }}</text>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <desk-buddy-order-modal ref="orderFormModalRef" />

    <!-- 登录弹窗（仅微信小程序） -->
    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  // 合并双方改动：设备列表/消息鉴权（HEAD）+ 订单弹窗（feat-app-zhuoda）
  import { ref, computed, type ComponentPublicInstance } from "vue";
  import { onLoad, onShow, onHide } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle, formatNumber } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiVoxDeviceList, apiVoxListGoods } from "@/servers/vox/voxDevice";
  import { apiResCode, apiResData, apiResMessage, getCurrentPageFullPath } from "@/utils/common";
  import { SUCCESS_CODE, USER_NO_LOGIN, REDIRECT_LOGIN } from "@/constants/codes.constants";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import DeskBuddyOrderModal from "./components/desk-buddy-order-modal.uvue";
  import { goToLogin } from "@/utils/authNavigation";

  // #ifdef MP-WEIXIN
  import AuthLoginPopup from "@/components/auth-login-popup/auth-login-popup.uvue";
  // #endif

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const { hasToken, checkAuthAndShowPopup, loginPopupRef } = useAuthInterceptor();

  // 终端设备（来自网关绑定列表）
  class TerminalDevice {
    // 设备绑定记录 ID：进入详情页后用于 GET /devices/bindings/{id}。
    bindingId: string = "";
    deviceId: string = "";
    name: string = "";
    desc: string = "";
    icon: string = "";
    online: boolean = false;
    // BOUND（已绑定）/ PENDING_CONFIRM（待设备确认）/ UNBOUND（已解绑）。
    bindingStatus: string = "UNBOUND";
    constructor(bindingId: string, deviceId: string, name: string, desc: string, icon: string, online: boolean, bindingStatus: string) {
      this.bindingId = bindingId;
      this.deviceId = deviceId;
      this.name = name;
      this.desc = desc;
      this.icon = icon;
      this.online = online;
      this.bindingStatus = bindingStatus;
    }
  }

  const deviceStatusText = (device: TerminalDevice): string => {
    if (device.bindingStatus == "BOUND") {
      return device.online ? t("Mobile.Terminal.connected") : t("Mobile.Terminal.disconnected");
    }
    if (device.bindingStatus == "PENDING_CONFIRM") return t("Mobile.Terminal.devicePendingConfirm");
    if (device.bindingStatus == "UNBOUND") return t("Mobile.Terminal.deviceUnbound");
    return t("Mobile.Terminal.statusUnknown");
  };

  const deviceStatusDotClass = (device: TerminalDevice): string => {
    if (device.bindingStatus == "BOUND") return device.online ? "" : "status-dot-off";
    if (device.bindingStatus == "PENDING_CONFIRM") return "status-dot-pending";
    return "status-dot-unbound";
  };

  const deviceStatusTextClass = (device: TerminalDevice): string => {
    if (device.bindingStatus == "BOUND") return device.online ? "" : "status-text-off";
    if (device.bindingStatus == "PENDING_CONFIRM") return "status-text-pending";
    return "status-text-unbound";
  };

  const deviceList = ref<TerminalDevice[]>([]);
  const deviceLoading = ref<boolean>(true);
  const deviceLoadError = ref<boolean>(false);
  const isLoggedIn = ref<boolean>(true);

  // 产品购买卡视图（由 listGoods 下发；未登录/拉取失败回退静态默认）
  class ProductCardView {
    goodsId: string = "";
    title: string = "";
    subtitle: string = "";
    priceYuan: number = 0;
    currency: string = "CNY";
    imageUrl: string = "";
    highlights: string[] = [];
    buttonText: string = "";
  }

  // 静态回退：接口未就绪 / 未登录 / 拉取失败时展示
  const FALLBACK_PRODUCT_HIGHLIGHTS: string[] = [
    "五色石设计 · 桌面玩偶形态",
    "语音唤醒 · 调度全部智能体",
    "2.8英寸表情屏幕 · 20+动态表情",
    "蓝牙/WiFi双模 · 48h续航",
  ];
  const buildFallbackProduct = (): ProductCardView => {
    const c = new ProductCardView();
    c.title = t("Mobile.Terminal.productName");
    c.subtitle = t("Mobile.Terminal.productSub");
    c.priceYuan = 299;
    c.currency = "CNY";
    c.buttonText = t("Mobile.Terminal.buyNow");
    c.highlights = FALLBACK_PRODUCT_HIGHLIGHTS;
    return c;
  };
  const product = ref<ProductCardView>(buildFallbackProduct());
  // 价格展示文案（uvue 模板不能直接调用导入函数，用 computed 包一层；formatNumber 规避 Double 显示 "299.0"）
  const productPriceText = computed<string>((): string => formatNumber(product.value.priceYuan, 0));
  // Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject 或直接点方法；用 $callMethod 调 defineExpose 方法
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // 登录
  const handleLogin = () => {
    // #ifdef MP-WEIXIN
    callRefMethod(loginPopupRef.value, "open");
    // #endif

    // #ifdef H5 || WEB || APP
    goToLogin();
    // #endif
  };
  const fetchDeviceList = async (silent: boolean) => {
    if (!(await hasToken())) {
      isLoggedIn.value = false;
      if (!silent) deviceLoading.value = false;
      deviceList.value = [];
      return;
    }
    isLoggedIn.value = true;
    if (!silent) {
      deviceLoading.value = true;
      deviceLoadError.value = false;
    }
    try {
      const res = await apiVoxDeviceList();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        const list: TerminalDevice[] = [];
        for (let i = 0; i < arr.length; i++) {
          const item = arr[i];
          const bindingIdVal = item["id"];
          const deviceIdVal = item["deviceId"];
          const nameVal = item["deviceName"];
          const onlineVal = item["online"];
          const bindingStatusVal = item["bindingStatus"];
          const bindingStatus = bindingStatusVal != null ? `${bindingStatusVal}` : "UNBOUND";
          list.push(new TerminalDevice(
            bindingIdVal != null ? `${bindingIdVal}` : "",
            deviceIdVal != null ? `${deviceIdVal}` : "",
            nameVal != null ? `${nameVal}` : "",
            t("Mobile.Terminal.lingzhuTerminal"),
            "🔮",
            onlineVal != null ? (onlineVal as boolean) : false,
            bindingStatus,
          ));
        }
        deviceList.value = list;
      } else if (apiResCode(res) != USER_NO_LOGIN && apiResCode(res) != REDIRECT_LOGIN) {
        if (!silent) {
          deviceLoadError.value = true;
          const msg = apiResMessage(res);
          uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.fetchDevicesFailed"), icon: "none" });
        }
      }
    } catch (e) {
      if (!silent) deviceLoadError.value = true;
      console.error("fetchDeviceList error", e);
    } finally {
      if (!silent) deviceLoading.value = false;
    }
  };

  // 拉取设备商品（产品购买卡数据源）；未登录 / 失败回退静态默认，不阻断页面、不弹错误
  const fetchGoods = async () => {
    if (!(await hasToken())) return;
    try {
      const res = await apiVoxListGoods();
      if (apiResCode(res) != SUCCESS_CODE) return;
      const raw = apiResData<any>(res);
      const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
      if (arr.length == 0) return;
      const g = arr[0];
      const card = new ProductCardView();
      card.goodsId = g["goodsId"] != null ? `${g["goodsId"]}` : "";
      card.title = g["title"] != null ? `${g["title"]}` : product.value.title;
      card.subtitle = g["subtitle"] != null ? `${g["subtitle"]}` : product.value.subtitle;
      const priceVal = g["priceYuan"];
      card.priceYuan = priceVal != null ? (priceVal as number) : product.value.priceYuan;
      card.currency = g["currency"] != null ? `${g["currency"]}` : "CNY";
      card.imageUrl = g["imageUrl"] != null ? `${g["imageUrl"]}` : "";
      card.buttonText = g["buttonText"] != null ? `${g["buttonText"]}` : product.value.buttonText;
      // highlights：缺省/空数组时保留回退卖点
      card.highlights = product.value.highlights;
      const hlRaw = g["highlights"];
      if (hlRaw != null) {
        const hl = hlRaw as string[];
        if (hl.length > 0) card.highlights = hl;
      }
      product.value = card;
    } catch (e) {
      console.error("fetchGoods error", e);
    }
  };

  // 设备列表轮询：状态/数量定时静默刷新；切出终端 tab 或 App 切后台由 onHide 停止
  const POLL_INTERVAL = 10000;
  let pollTimer = 0;
  const stopDevicePolling = () => {
    if (pollTimer != 0) {
      clearInterval(pollTimer);
      pollTimer = 0;
    }
  };
  const startDevicePolling = () => {
    stopDevicePolling();
    if (!isLoggedIn.value) return;
    pollTimer = setInterval(() => { fetchDeviceList(true); }, POLL_INTERVAL);
  };

  // 点击设备，进入设备详情
  const handleDeviceClick = (device: TerminalDevice) => {
    if (device.bindingId == "") {
      uni.showToast({ title: t("Mobile.Terminal.deviceInfoFailedRetry"), icon: "none" });
      return;
    }
    uni.navigateTo({
      url: `/subpackages/pages/terminal/terminal-device-detail?bindingId=${encodeURIComponent(device.bindingId)}`,
    });
  };

  // 添加搭子灵珠，跳配网入口页（扫码/手动蓝牙并列）
  const handleAddDevice = async () => {
    const authed = await checkAuthAndShowPopup();
    if (!authed) {
      handleLogin();
      return;
    }
    uni.navigateTo({
      url: "/subpackages/pages/provision/provision-entry/provision-entry",
    });
  };

  // 离线设备：重新配网（换 WiFi）
  const handleReprovision = async (device: TerminalDevice) => {
    const authed = await checkAuthAndShowPopup();
    if (!authed) return;
    uni.navigateTo({
      url: `/subpackages/pages/provision/provision-entry/provision-entry?bindingId=${encodeURIComponent(device.bindingId)}&deviceId=${encodeURIComponent(device.deviceId)}&name=${encodeURIComponent(device.name)}`,
    });
  };



  // 订单弹窗 ref：立即购买时调用子组件 open（带 goodsId）
  const orderFormModalRef = ref<any | null>(null);

  // 立即购买：打开桌面搭子订单弹窗，把当前商品 goodsId 传入以便下单回传
  const handleBuy = async () => {
    const authed = await checkAuthAndShowPopup();
    if (!authed) {
      handleLogin();
      return;
    }
    const modal = orderFormModalRef.value;
    if (modal != null) {
      // Android：组件 ref 是 Gen* 类，用 $callMethod 调 defineExpose 方法并带参
      (modal as ComponentPublicInstance).$callMethod("open", product.value.goodsId);
    }
  };

  onLoad((options: any) => {
    setCurrentPageNavigationBarTitle();
  });

  onShow(() => {
    // 已有数据则静默刷新（避免切回 tab 闪 loading 占位），首次进入带 loading
    fetchDeviceList(deviceList.value.length > 0);
    fetchGoods();
    startDevicePolling();
  });

  onHide(() => {
    // 切出终端 tab 或 App 切后台 → 停止轮询；切回 / 回前台由 onShow 重启
    stopDevicePolling();
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }



  .empty-box {
    padding: 48rpx 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;

    .empty-text {
      font-size: 26rpx;
      color: #999999;
    }

    .empty-text-link {
      color: #5147ff;
    }
  }

  /* 卡片组 */
  .card-group {
    background-color: #ffffff;
    border-radius: 24rpx;
    margin: 24rpx 24rpx 0;
    overflow: hidden;
  }

  /* 行项 */
  .row-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 28rpx 32rpx;
    border-bottom: 2rpx solid #f5f5f5;
&:last-child {
      border-bottom-width: 0;
    }

    &-active {
      background-color: rgba(12, 20, 102, 0.04);
    }

    .row-avatar {
      width: 80rpx;
      height: 80rpx;
      border-radius: 16rpx;
      background-color: #fafafa;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 24rpx;

      .row-avatar-emoji {
        font-size: 40rpx;
      }
    }

    .row-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;

      .row-title {
        font-size: 30rpx;
        font-weight: 600;
        color: #1a1a1a;
        lines: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .row-desc {
        font-size: 26rpx;
        color: #666666;
        margin-top: 4rpx;
      }
    }

    .row-status {
      display: flex;
      flex-direction: row;
      align-items: center;
      margin-right: 8rpx;

      .status-dot {
        width: 12rpx;
        height: 12rpx;
        border-radius: 50%;
        background-color: #07c160;
        margin-right: 8rpx;

        &.status-dot-off {
          background-color: #c0c0c0;
        }

        &.status-dot-pending {
          background-color: #fa8c16;
        }

        &.status-dot-unbound {
          background-color: #f04b4b;
        }
      }

      .status-text {
        font-size: 24rpx;
        color: #07c160;

        &.status-text-off {
          color: #999999;
        }

        &.status-text-pending {
          color: #fa8c16;
        }

        &.status-text-unbound {
          color: #f04b4b;
        }
      }
    }

    .row-arrow {
      font-size: 40rpx;
      color: #c0c0c0;
      font-weight: 300;
      line-height: 1;
      padding-left: 8rpx;
    }
  }

  /* 离线设备：重新配网按钮 */
  .reprovision-btn {
    padding: 8rpx 20rpx;
    border-radius: 24rpx;
    background-color: rgba(81, 71, 255, 0.1);
    margin-left: 12rpx;

    &-text {
      font-size: 24rpx;
      color: #5147ff;
      font-weight: 600;
    }
  }

  /* 添加设备卡 */
  .add-card {
    background-color: #ffffff;
    border: 4rpx dashed #e0e0e0;
    border-radius: 24rpx;
    margin: 24rpx 24rpx 0;
    padding: 28rpx 32rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    transition: border-color 0.2s ease, transform 0.15s ease;
&-active {
      border-color: #5147ff;
      transform: scale(0.99);
    }

    .add-icon {
      width: 80rpx;
      height: 80rpx;
      border-radius: 16rpx;
      background-color: #fafafa;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 24rpx;

      .add-icon-plus {
        font-size: 44rpx;
        color: #999999;
        line-height: 1;
      }
    }

    .add-info {
      flex: 1;
      display: flex;
      flex-direction: column;

      .add-title {
        font-size: 30rpx;
        font-weight: 600;
        color: #1a1a1a;
      }

      .add-desc {
        font-size: 24rpx;
        color: #666666;
        margin-top: 4rpx;
      }
    }

    .row-arrow {
      font-size: 40rpx;
      color: #c0c0c0;
      font-weight: 300;
      line-height: 1;
      padding-left: 8rpx;
    }
  }

  /* 产品购买卡 */
  .product-card {
    background-color: #ffffff;
    border-radius: 24rpx;
    margin: 24rpx 24rpx 0;
    padding: 40rpx 32rpx;
    display: flex;
    flex-direction: column;
    align-items: center;

    .product-icon {
      width: 140rpx;
      height: 140rpx;
      border-radius: 36rpx;
      background-color: #5147ff;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24rpx;

      .product-icon-emoji {
        font-size: 72rpx;
      }

      .product-icon-img {
        width: 140rpx;
        height: 140rpx;
        border-radius: 36rpx;
      }
    }

    .product-name {
      font-size: 40rpx;
      font-weight: 700;
      color: #1a1a1a;
    }

    .product-sub {
      font-size: 26rpx;
      color: #666666;
      margin-top: 8rpx;
    }

    .product-price {
      font-size: 52rpx;
      font-weight: 700;
      color: #5147ff;
      margin: 24rpx 0;
    }

    .product-features {
      width: 100%;
      margin-bottom: 32rpx;

      .feature-item {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 16rpx 0;
        border-bottom: 2rpx solid #f8f8f8;

        &:last-child {
          border-bottom-width: 0;
        }

        .feature-icon {
          width: 36rpx;
          height: 36rpx;
          border-radius: 50%;
          background-color: rgba(81, 71, 255, 0.1);
          display: flex;
          align-items: center;
          justify-content: center;
          margin-right: 16rpx;
          margin-top: 4rpx;

          .feature-check {
            font-size: 22rpx;
            color: #5147ff;
          }
        }

        .feature-text {
          flex: 1;
          font-size: 28rpx;
          color: #1a1a1a;
          line-height: 1.4;
        }
      }
    }

    .buy-btn {
      width: 100%;
      padding: 26rpx 0;
      border-radius: 20rpx;
      background-color: #5147ff;
      display: flex;
      align-items: center;
      justify-content: center;

      &-active {
        opacity: 0.85;
      }

      .buy-btn-text {
        font-size: 32rpx;
        font-weight: 600;
        color: #ffffff;
      }
    }
  }

  .bottom-space {
    height: 40rpx;
  }

  
</style>
