<template>
  <view class="provision-progress">
    <custom-nav-bar :title="t('Mobile.Provision.Progress.title')" :show-back="true" :has-safety-zone="true" />

    <view class="provision-progress__body">
      <!-- 进行中 -->
      <view v-if="!isSuccess && !isFailed" class="progress">
        <!-- 呼吸雷达动效 -->
        <view class="radar">
          <view class="radar__ring radar__ring--1"></view>
          <view class="radar__ring radar__ring--2"></view>
          <view class="radar__ring radar__ring--3"></view>
          <view class="radar__core">
            <text class="radar__core-icon">📡</text>
          </view>
        </view>

        <view class="stages">
          <view
            v-for="(stage, index) in stages"
            :key="index"
            class="stage"
          >
            <view class="stage__rail">
              <view v-if="index > 0" :class="['stage__line stage__line--top', stage.state != 'pending' ? 'stage__line--done' : '']"></view>
              <view class="stage__dot" :class="`stage__dot--${stage.state}`">
                <text v-if="stage.state == 'done'" class="stage__dot-icon">✓</text>
                <text v-else-if="stage.state == 'fail'" class="stage__dot-icon">✕</text>
                <view v-else-if="stage.state == 'active'" class="stage__dot-pulse"></view>
              </view>
              <view v-if="index < stages.length - 1" :class="['stage__line stage__line--bottom', stage.state == 'done' ? 'stage__line--done' : '']"></view>
            </view>
            <text class="stage__text" :class="{ 'stage__text--active': stage.state == 'active', 'stage__text--done': stage.state == 'done' }">{{ stage.label }}</text>
          </view>
        </view>
      </view>

      <!-- 成功 -->
      <view v-if="isSuccess" class="result">
        <view class="result__badge result__badge--success">
          <text class="result__badge-icon">✓</text>
        </view>
        <text class="result__title">{{ t('Mobile.Provision.Result.successTitle') }}</text>
        <text class="result__desc">{{ successDesc }}</text>
        <text v-if="deviceOnline" class="result__online result__online--ok">✓ {{ t('Mobile.Provision.Result.deviceOnline') }}</text>
        <text v-else class="result__online">{{ t('Mobile.Provision.Result.checkingOnline') }} ({{ onlineCountdown }}s)</text>
        <view class="result__btn result__btn--primary" hover-class="result__btn--hover" @tap="onDone">
          <text class="result__btn-text result__btn-text--primary">{{ t('Mobile.Provision.Result.done') }}</text>
        </view>
      </view>

      <!-- 失败 -->
      <view v-if="isFailed" class="result">
        <view class="result__badge result__badge--fail">
          <text class="result__badge-icon">✕</text>
        </view>
        <text class="result__title">{{ t('Mobile.Provision.Result.failTitle') }}</text>
        <text class="result__desc">{{ failReason }}</text>
        <view class="result__btn-group">
          <view v-if="retryable" class="result__btn result__btn--primary" hover-class="result__btn--hover" @tap="onRetry">
            <text class="result__btn-text result__btn-text--primary">{{ t('Mobile.Provision.Result.retry') }}</text>
          </view>
          <view class="result__btn result__btn--plain" hover-class="result__btn--hover" @tap="onReprovision">
            <text class="result__btn-text result__btn-text--plain">{{ t('Mobile.Provision.Result.reprovision') }}</text>
          </view>
          <view class="result__btn result__btn--plain" hover-class="result__btn--hover" @tap="onResetDevice">
            <text class="result__btn-text result__btn-text--plain">{{ t('Mobile.Provision.Result.resetDevice') }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { computed, watch, onUnmounted } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { useI18n, toI18nParams, emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { useEspProvisioning, releaseEspProvisioning } from "@/hooks/useEspProvisioning";
  import { getProvisionDevice, getProvisionCredentials, clearProvisionSession, getReprovisionTarget, getQrPayload } from "@/utils/provisionSession";
  import { EspProvisioningPhaseEnum } from "@/types/enums/espProvisioning";
  import { apiVoxDeviceDetail } from "@/servers/vox/voxDevice";
  import { apiResCode, apiResData } from "@/utils/common";
  import { SUCCESS_CODE } from "@/constants/codes.constants";

  // 本地 t 包装（composable 的 t 在模板中解析有坑，与主包页面一致）
  const t = (key: string, params?: Record<string, string | number>): string =>
    translateFn(key, params != null ? params : emptyI18nParams(), "");

  class StageItem {
    label: string;
    state: string; // 'pending' | 'active' | 'done' | 'fail'
    constructor(label: string, state: string) {
      this.label = label;
      this.state = state;
    }
  }

  const controller = useEspProvisioning();
  const phase = controller.phase;
  const error = controller.error;
  const connectedSsid = controller.connectedSsid;

  const isSuccess = computed((): boolean => phase.value == EspProvisioningPhaseEnum.SUCCESS);
  const isFailed = computed((): boolean => phase.value == EspProvisioningPhaseEnum.FAILED);
  const retryable = computed((): boolean => error.value != null && error.value!!.retryable);
  const successDesc = computed((): string => {
    const m = new Map<string, string | number>();
    m.set("ssid", connectedSsid.value);
    const isReprovision = getReprovisionTarget() != null;
    const baseKey = isReprovision ? "Mobile.Provision.Result.reprovisionSuccessDesc" : "Mobile.Provision.Result.successDesc";
    return t(baseKey, toI18nParams(m));
  });

  const failReason = computed((): string => {
    const e = error.value;
    if (e == null) return t("Mobile.Provision.Error.unknown");
    return t(e.i18nKey);
  });

  // 进度步骤条
  const stages = computed((): StageItem[] => {
    const p = phase.value;
    const order = [
      EspProvisioningPhaseEnum.CONNECTING,
      EspProvisioningPhaseEnum.ESTABLISHING_SESSION,
      EspProvisioningPhaseEnum.BINDING_DEVICE,
      EspProvisioningPhaseEnum.SENDING_CREDENTIALS,
      EspProvisioningPhaseEnum.CHECKING_STATUS,
    ] as EspProvisioningPhaseEnum[];
    const labels = [
      t("Mobile.Provision.Progress.stageConnect"),
      t("Mobile.Provision.Progress.stageSecureSession"),
      t("Mobile.Provision.Progress.stageBind"),
      t("Mobile.Provision.Progress.stageWrite"),
      t("Mobile.Provision.Progress.stageWait"),
    ] as string[];
    // 当前阶段在 order 中的下标（绑定+下发须在 WiFi 之前：Security 2 会话活着才能下发）
    let activeIdx = 0;
    if (p == EspProvisioningPhaseEnum.CONNECTING || p == EspProvisioningPhaseEnum.DISCOVERING) activeIdx = 0;
    else if (p == EspProvisioningPhaseEnum.ESTABLISHING_SESSION || p == EspProvisioningPhaseEnum.READING_DEVICE_INFO || p == EspProvisioningPhaseEnum.READY) activeIdx = 1;
    else if (p == EspProvisioningPhaseEnum.BINDING_DEVICE) activeIdx = 2;
    else if (p == EspProvisioningPhaseEnum.SENDING_CREDENTIALS || p == EspProvisioningPhaseEnum.APPLYING_CONFIG) activeIdx = 3;
    else if (p == EspProvisioningPhaseEnum.CHECKING_STATUS) activeIdx = 4;
    else if (p == EspProvisioningPhaseEnum.SUCCESS) activeIdx = 5; // 全部完成
    else activeIdx = 0;

    const result = [] as StageItem[];
    for (let i = 0; i < order.length; i++) {
      let state = 'pending';
      if (p == EspProvisioningPhaseEnum.FAILED) {
        state = i < activeIdx ? 'done' : (i == activeIdx ? 'fail' : 'pending');
      } else if (p == EspProvisioningPhaseEnum.SUCCESS) {
        state = 'done';
      } else {
        state = i < activeIdx ? 'done' : (i == activeIdx ? 'active' : 'pending');
      }
      result.push(new StageItem(labels[i], state));
    }
    return result;
  });

  const run = async () => {
    const cred = getProvisionCredentials();
    if (cred == null) {
      // 参数缺失，回扫描页
      uni.navigateBack({ delta: 2 });
      return;
    }
    const isFromQr = getQrPayload() != null;
    // 手动扫描链路：在 progress 页一次性 connect → READY；扫码直连链路已在 connect 页 READY
    if (!isFromQr) {
      const device = getProvisionDevice();
      if (device == null) {
        uni.navigateBack({ delta: 2 });
        return;
      }
      // 连接失败时仍保留本次内存凭据，用户点击重试可完成 reconnect → provision。
      const ok = await controller.selectAndPrepare(device, cred.ssid, cred.password);
      if (!ok) return;
    }
    // WiFi 前：绑定 App 账号并下发 vox-config（Security 2 会话活着才能下发；
    //   WiFi 成功后 SDK 清理会话，再下发会 SECURITY_AUTH_FAILED）。失败进失败页。
    const delivered = await controller.bindAndDeliverSecret("");
    if (!delivered) return;
    // WiFi set/apply/status
    await controller.provision(cred.ssid, cred.password);
  };

  const onRetry = async () => {
    await controller.retry();
  };

  const onReprovision = () => {
    releaseEspProvisioning();
    clearProvisionSession();
    uni.navigateBack({ delta: 1 });
  };

  const onResetDevice = async () => {
    const ok = await controller.resetDevice();
    if (ok) await controller.retry();
  };

  // ===== 成功后轮询检测设备上线（最长 30s，到时或检测到上线自动跳回列表）=====
  const ONLINE_TIMEOUT_SEC = 30;
  const onlineCountdown = ref<number>(ONLINE_TIMEOUT_SEC);
  const deviceOnline = ref<boolean>(false);
  const pollingOnline = ref<boolean>(false);
  let pollTimerId = 0;
  let pollTick = 0;

  const stopOnlinePolling = () => {
    if (pollTimerId != 0) {
      clearInterval(pollTimerId);
      pollTimerId = 0;
    }
    pollingOnline.value = false;
  };

  let hasDone = false;
  const onDone = () => {
    if (hasDone) return;
    hasDone = true;
    stopOnlinePolling();
    releaseEspProvisioning();
    clearProvisionSession();
    uni.navigateBack({ delta: 3 });
  };

  const checkDeviceOnline = async () => {
    const info = controller.deviceInfo.value;
    if (info == null || info.serialNumber == "") return;
    try {
      const res = await apiVoxDeviceDetail(info.serialNumber);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          const onlineVal = d["online"];
          if (onlineVal != null && (onlineVal as boolean)) {
            deviceOnline.value = true;
            stopOnlinePolling();
            // 检测到上线，稍作停留让用户看到，再自动跳回列表
            setTimeout(() => { onDone(); }, 1500);
          }
        }
      }
    } catch (e) {
      console.error("checkDeviceOnline error", e);
    }
  };

  const startOnlinePolling = () => {
    stopOnlinePolling();
    onlineCountdown.value = ONLINE_TIMEOUT_SEC;
    deviceOnline.value = false;
    pollingOnline.value = true;
    pollTick = 0;
    pollTimerId = setInterval(() => {
      pollTick = pollTick + 1;
      onlineCountdown.value = onlineCountdown.value - 1;
      // 每 2 个 tick（约 2s）探测一次
      if (pollTick % 2 == 0) {
        checkDeviceOnline();
      }
      // 倒计时到 0：自动跳回列表
      if (onlineCountdown.value <= 0) {
        stopOnlinePolling();
        onDone();
      }
    }, 1000);
  };

  watch(isSuccess, (val: boolean) => {
    if (val) startOnlinePolling();
  });

  onUnmounted(() => {
    stopOnlinePolling();
  });

  onLoad((_options: OnLoadOptions) => {
    run();
  });
</script>

<style lang="scss" scoped>
  .provision-progress {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;

    &__body {
      flex: 1;
      padding: 48rpx 32rpx;
    }
  }

  .progress {
    display: flex;
    flex-direction: column;
  }

  /* ===== 呼吸雷达动效 ===== */
  .radar {
    width: 320rpx;
    height: 320rpx;
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 40rpx;

    &__ring {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 240rpx;
      height: 240rpx;
      border-radius: 50%;
      border: 2rpx solid rgba(81, 71, 255, 0.5);
      transform: translate(-50%, -50%) scale(0.5);
      opacity: 0;
&--2 {
}

      &--3 {
}
    }

    &__core {
      width: 160rpx;
      height: 160rpx;
      border-radius: 50%;
      background-color: rgba(81, 71, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
}

    &__core-icon {
      font-size: 72rpx;
    }
  }

  

  

  /* ===== 步骤条（带连接线） ===== */
  .stages {
    display: flex;
    flex-direction: column;
  }

  .stage {
    display: flex;
    flex-direction: row;
    align-items: stretch;

    &__rail {
      width: 48rpx;
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-right: 24rpx;
    }

    &__line {
      width: 4rpx;
      flex: 1;
      min-height: 20rpx;
      background-color: #e0e0e0;
      transition: background-color 0.3s ease;

      &--done {
        background-color: #5147ff;
      }
    }

    &__dot {
      width: 48rpx;
      height: 48rpx;
      border-radius: 50%;
      background-color: #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background-color 0.3s ease, transform 0.3s ease;

      &--active {
        background-color: #5147ff;
        transform: scale(1.1);
      }

      &--done {
        background-color: #4cd964;
      }

      &--fail {
        background-color: #dd524d;
      }
    }

    &__dot-pulse {
      width: 20rpx;
      height: 20rpx;
      border-radius: 50%;
      background-color: #ffffff;
}

    &__dot-icon {
      color: #ffffff;
      font-size: 28rpx;
    }

    &__text {
      font-size: 30rpx;
      color: #999;
      padding: 28rpx 0;
      transition: color 0.3s ease;

      &--active {
        color: #333;
        font-weight: 600;
      }

      &--done {
        color: #666;
      }
    }
  }

  

  /* ===== 结果（成功/失败） ===== */
  .result {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 60rpx;

    &__badge {
      width: 160rpx;
      height: 160rpx;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 32rpx;
&--success {
        background-color: rgba(76, 217, 100, 0.12);
      }

      &--fail {
        background-color: rgba(221, 82, 77, 0.1);
      }
    }

    &__badge-icon {
      font-size: 72rpx;
      font-weight: 600;

      .result__badge--success & {
        color: #4cd964;
      }

      .result__badge--fail & {
        color: #dd524d;
      }
    }

    &__title {
      font-size: 40rpx;
      font-weight: 600;
      color: #333;
      margin-bottom: 16rpx;
    }

    &__desc {
      font-size: 28rpx;
      color: #999;
      text-align: center;
      margin-bottom: 48rpx;
      line-height: 1.5;
    }

    &__online {
      font-size: 26rpx;
      color: #999999;
      text-align: center;
      margin-top: 0;
      margin-bottom: 40rpx;

      &--ok {
        color: #07c160;
        font-weight: 500;
      }
    }

    &__btn-group {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    &__btn {
      width: 80%;
      padding: 28rpx 0;
      border-radius: 48rpx;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24rpx;
      transition: opacity 0.2s ease, transform 0.15s ease;

      &--primary {
        background-color: #5147ff;
      }

      &--plain {
        background-color: #ffffff;
        border: 1rpx solid #5147ff;
      }

      &--hover {
        opacity: 0.85;
        transform: scale(0.98);
      }
    }

    &__btn-text {
      font-size: 32rpx;

      &--primary {
        color: #ffffff;
      }

      &--plain {
        color: #5147ff;
      }
    }
  }

  
</style>
