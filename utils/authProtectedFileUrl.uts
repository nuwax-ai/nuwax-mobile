/**
 * 受保护文件 URL 鉴权拉取与打开
 * 对齐 nuwax Web 版 authProtectedFileUrl.ts（UTS 兼容实现，勿用 URL / 可选链）
 */
import { getApiBaseUrl } from "@/constants/config";
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { jumpToFilePreviewPage } from "@/utils/system.uts";

const AUTH_PROTECTED_MARKER: string = "/api/f/";

function isHttpUrl(url: string): boolean {
  const lower = url.toLowerCase();
  return lower.indexOf("http://") == 0 || lower.indexOf("https://") == 0;
}

function stripQueryAndHash(url: string): string {
  let path = url;
  const q = path.indexOf("?");
  if (q >= 0) {
    path = path.substring(0, q);
  }
  const h = path.indexOf("#");
  if (h >= 0) {
    path = path.substring(0, h);
  }
  return path;
}

/**
 * 从绝对或相对 URL 提取 pathname（不含 query/hash）。
 */
export function extractPathnameFromRemoteUrl(url: string): string {
  const cleaned = stripQueryAndHash(url);
  if (isHttpUrl(cleaned)) {
    const schemeEnd = cleaned.indexOf("://");
    if (schemeEnd >= 0) {
      const afterHost = cleaned.indexOf("/", schemeEnd + 3);
      if (afterHost >= 0) {
        return cleaned.substring(afterHost);
      }
      return "/";
    }
  }
  if (cleaned.indexOf("/") == 0) {
    return cleaned;
  }
  return `/${cleaned}`;
}

function containsAuthProtectedPath(url: string): boolean {
  return url.toLowerCase().indexOf(AUTH_PROTECTED_MARKER) >= 0;
}

/** 判断 URL 是否为需 Bearer 鉴权才能加载的文件地址。 */
export function isAuthProtectedFileUrl(url: string | null): boolean {
  if (url == null) {
    return false;
  }
  const trimmed = url.trim();
  if (trimmed.length == 0) {
    return false;
  }
  try {
    const pathname = extractPathnameFromRemoteUrl(trimmed);
    return containsAuthProtectedPath(pathname);
  } catch (_e) {
    return containsAuthProtectedPath(trimmed);
  }
}

/** 将相对或绝对文件 URL 规范化为可请求的完整地址。 */
export function resolveAuthProtectedFileFetchUrl(url: string): string {
  if (isHttpUrl(url)) {
    return url;
  }
  const normalizedPath = url.indexOf("/") == 0 ? url : `/${url}`;
  return `${getApiBaseUrl()}${normalizedPath}`;
}

function buildAuthHeaders(): UTSJSONObject {
  const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
  const token = tokenRaw != null ? `${tokenRaw}` : "";
  const header = new UTSJSONObject();
  if (token.length > 0) {
    header["Authorization"] = `Bearer ${token}`;
  }
  return header;
}

function resolveDownloadFileName(url: string, fileName: string | null): string {
  if (fileName != null && fileName.length > 0) {
    return fileName;
  }
  const cleaned = stripQueryAndHash(url);
  const parts = cleaned.split("/");
  for (let i = parts.length - 1; i >= 0; i--) {
    const part = parts[i];
    if (part != null && part.length > 0) {
      return part;
    }
  }
  return "download";
}

/**
 * 拉取受保护文件并返回可用于 image 组件展示的本地/temp 地址。
 */
export function fetchAuthProtectedFileDisplayUrl(url: string): Promise<string> {
  const fetchUrl = resolveAuthProtectedFileFetchUrl(url);
  const header = buildAuthHeaders();

  return new Promise((resolve, reject) => {
    uni.downloadFile({
      url: fetchUrl,
      header: header,
      success: (res) => {
        const path = res.tempFilePath;
        if (res.statusCode == 200 && path != null && `${path}`.length > 0) {
          resolve(`${path}`);
          return;
        }
        reject(new Error("download failed"));
      },
      fail: (err) => {
        reject(err);
      },
    });
  });
}

/**
 * 打开或下载远程文件。
 * 受保护地址带 Bearer 下载；若提供 conversationId 则优先跳转预览页。
 */
export function openRemoteFileUrl(
  url: string,
  fileName: string | null = null,
  conversationId: string | number | null = null,
): Promise<void> {
  const resolvedName = resolveDownloadFileName(url, fileName);
  const hasConversationId =
    conversationId != null && `${conversationId}`.length > 0;

  if (hasConversationId && isAuthProtectedFileUrl(url)) {
    const path = extractPathnameFromRemoteUrl(url);
    jumpToFilePreviewPage(`${conversationId}`, path);
    return Promise.resolve();
  }

  if (isAuthProtectedFileUrl(url)) {
    const fetchUrl = resolveAuthProtectedFileFetchUrl(url);
    const header = buildAuthHeaders();
    uni.showLoading({ title: "" });
    return new Promise((resolve, reject) => {
      uni.downloadFile({
        url: fetchUrl,
        header: header,
        success: (res) => {
          uni.hideLoading();
          const path = res.tempFilePath;
          if (res.statusCode == 200 && path != null && `${path}`.length > 0) {
            // #ifdef MP-WEIXIN || APP
            uni.openDocument({
              filePath: `${path}`,
              showMenu: true,
              success: (_ok) => {
                resolve();
              },
              fail: (err) => {
                reject(err);
              },
            });
            // #endif
            // #ifdef H5 || WEB
            try {
              const link = document.createElement("a");
              link.href = `${path}`;
              link.download = resolvedName;
              link.target = "_blank";
              link.click();
              resolve();
            } catch (eH5) {
              reject(eH5);
            }
            // #endif
            return;
          }
          reject(new Error("download failed"));
        },
        fail: (err) => {
          uni.hideLoading();
          reject(err);
        },
      });
    });
  }

  return new Promise((resolve, reject) => {
    // #ifdef H5 || WEB
    try {
      window.open(url, "_blank");
      resolve();
    } catch (eOpen) {
      reject(eOpen);
    }
    // #endif
    // #ifdef MP-WEIXIN || APP
    uni.downloadFile({
      url: url,
      success: (res) => {
        const path = res.tempFilePath;
        if (res.statusCode == 200 && path != null && `${path}`.length > 0) {
          uni.openDocument({
            filePath: `${path}`,
            showMenu: true,
            success: (_ok) => {
              resolve();
            },
            fail: (err) => {
              reject(err);
            },
          });
        } else {
          reject(new Error("download failed"));
        }
      },
      fail: (err) => {
        reject(err);
      },
    });
    // #endif
  });
}
