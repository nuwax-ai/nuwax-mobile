<template>
  <!--
    消息列表下移时从顶部逐步露出的轻量会话背层。
    这里只画会话页首屏顶部骨架，不挂消息列表、WS 或输入框状态；达到阈值后由
    message-content 用 openDialogPage 无动画切到真实 chat 页面，避免拖动期间双挂会话页。
  -->
  <view id="partner-agent-pull-preview" class="pull-chat-preview">
    <safety-zone />
    <view class="pull-chat-preview__header">
      <view class="pull-chat-preview__side">
        <view class="pull-chat-preview__back" />
      </view>
      <text class="pull-chat-preview__title text-ellipsis">{{ displayName }}</text>
      <view class="pull-chat-preview__side pull-chat-preview__more">
        <view class="pull-chat-preview__more-dot" />
        <view class="pull-chat-preview__more-dot" />
        <view class="pull-chat-preview__more-dot" />
      </view>
    </view>
    <view class="pull-chat-preview__tabs">
      <view class="pull-chat-preview__tab pull-chat-preview__tab--active">
        <text class="pull-chat-preview__tab-text pull-chat-preview__tab-text--active">{{ t("Mobile.Message.chatTabMessages") }}</text>
      </view>
      <view class="pull-chat-preview__tab">
        <text class="pull-chat-preview__tab-text">{{ t("Mobile.Message.chatTabPin") }}</text>
      </view>
      <view class="pull-chat-preview__tab">
        <text class="pull-chat-preview__tab-text">{{ t("Mobile.Message.chatTabFiles") }}</text>
      </view>
    </view>
    <view class="pull-chat-preview__body">
      <view class="pull-chat-preview__messages">
        <view
          v-for="(item, index) in messages"
          :key="index"
          class="pull-chat-preview__message-row"
          :class="item.fromAgent ? 'pull-chat-preview__message-row--agent' : 'pull-chat-preview__message-row--mine'"
        >
          <view
            class="pull-chat-preview__bubble"
            :class="item.fromAgent ? 'pull-chat-preview__bubble--agent' : 'pull-chat-preview__bubble--mine'"
          >
            <text class="pull-chat-preview__message-text">{{ item.text }}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="pull-chat-preview__dock">
      <view class="pull-chat-preview__input" />
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { PullAgentPreviewMessage } from "@/utils/im/pullAgentTransition";

  const props = withDefaults(
    defineProps<{
      agentName: string;
      messages: PullAgentPreviewMessage[];
    }>(),
    {
      agentName: "",
      messages: [] as PullAgentPreviewMessage[],
    },
  );

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const displayName = computed((): string => props.agentName.length > 0 ? props.agentName : t("Mobile.Message.defaultAgentName"));
</script>

<style lang="scss" scoped>
