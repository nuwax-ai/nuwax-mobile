/**
 * 从网络层返回的 Map / UTSJSONObject 安全读取字段。
 * 放在主包 utils，避免主包模块反向依赖 subpackages。
 */
export function readRawField(raw: any | null, key: string): any | null {
  if (raw == null || key.length == 0) {
    return null;
  }

  // 快速分派：instanceof 一次判型直读。下方 try/catch 多路探测以异常做类型判断，
  // H5 上每字段抛 2 次异常，是大会话加载的主线程热点（见 perf trace）。
  if (raw instanceof UTSJSONObject) {
    return (raw as UTSJSONObject)[key];
  }
  // 基本类型（枚举值 / 字符串 / 数字）无字段可读，直接短路。
  if (typeof raw != "object") {
    return null;
  }
  if (raw instanceof Map<string, any | null>) {
    // has 不可靠的实现里 get 兜底；缺失键两种情况都返回 null，直接 get 等价。
    return (raw as Map<string, any | null>).get(key);
  }

  try {
    const map = raw as Map<string, any | null>;
    if (map.has(key)) {
      return map.get(key);
    }
    const mapValue = map.get(key);
    if (mapValue != null) {
      return mapValue;
    }
  } catch (_mapError) {
    // 非 Map，继续尝试 UTSJSONObject。
  }

  try {
    const object = raw as UTSJSONObject;
    const value = object[key];
    if (value != null) {
      return value;
    }
  } catch (_objectError) {
    // 非 UTSJSONObject。
  }

  return null;
}
