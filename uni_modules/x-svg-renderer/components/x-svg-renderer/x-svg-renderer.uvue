<template>
  <native-view
    class="x-svg-renderer__native"
    @init="onViewInit"
  ></native-view>
</template>

<script setup lang="uts">
import { NativeSvgRenderer } from '@/uni_modules/x-svg-renderer'

/**
 * Keep this component deliberately runtime-neutral:
 * - no render functions / h()
 * - no VNode inspection
 * - no getCurrentInstance() renderer internals
 * - no compiler-mode-specific DOM assumptions
 *
 * This lets the same component work in both uni-app x VDOM and Vapor modes.
 */
const props = withDefaults(defineProps<{
  svg: string
  fit?: string
}>(), {
  svg: '',
  fit: 'contain'
})

const emit = defineEmits<{
  (e: 'load'): void
  (e: 'error', message: string): void
}>()

let renderer: NativeSvgRenderer | null = null
let initialized = false

function renderCurrent() {
  if (!initialized || renderer == null) return

  renderer?.setFit(props.fit)

  if (props.svg.length == 0) {
    renderer?.clear()
    return
  }

  renderer?.setSvg(props.svg)
}

function onViewInit(e: UniNativeViewInitEvent) {
  renderer = new NativeSvgRenderer(e.detail.element)
  initialized = true

  renderer?.setListener((message: string | null) => {
    if (message == null) {
      emit('load')
    } else {
      emit('error', message)
    }
  })

  renderCurrent()
}

watch(() => props.svg, () => {
  renderCurrent()
})

watch(() => props.fit, (value: string) => {
  if (!initialized) return
  renderer?.setFit(value)
})

onUnmounted(() => {
  initialized = false
  renderer?.destroy()
  renderer = null
})
</script>

<style>
.x-svg-renderer__native {
  width: 100%;
  height: 100%;
}
</style>
