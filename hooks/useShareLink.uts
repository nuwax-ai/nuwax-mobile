/**
 * 通用分享 Hook
 *
 * 从 file-preview-page 抽出的分享交互逻辑，统一：
 * - H5/WEB：展开自绘底部面板，仅「复制链接」
 * - App：直接唤起系统分享面板（uni.shareWithSystem），失败兜底复制链接
 * - MP-WEIXIN：不适用本 Hook，小程序分享统一走原生 onShareAppMessage / onAddToFavorites，
 *   调用方无需（也不应）在小程序端渲染分享按钮
 *
 * 分享链接怎么来（是否需要网络请求、是否需要缓存）由调用方通过 getShareUrl 决定，
 * Hook 本身只负责交互层：面板开合、系统分享调起、防重、复制成功/失败提示。
 *
 * 使用方式（与仓库内其它 hooks 一致的“hook 出状态 + 页面持有同名变量供模板 ref 绑定”模式）：
 * 入参须 `new ShareLinkOptions()` 后逐字段赋值，不能传内联对象字面量（见 ShareLinkOptions 注释）。
 *
 *   const shareOptions = new ShareLinkOptions();
 *   shareOptions.getShareTitle = () => pageTitle.value;
 *   shareOptions.getShareUrl = async () => buildShareUrl();
 *   const share = useShareLink(shareOptions);
 *   const sharePopupRef = share.sharePopupRef;
 *   const handleShare = share.handleShare;
 *   const closeShareSheet = share.closeShareSheet;
 *   const handleCopyLink = share.handleCopyLink;
 *
 * 模板：
 *   导航栏右侧分享入口 —— <svg-icon name="icon-ShareAltOutlined" size="48" @click="handleShare" />
 *   H5/WEB 专用底部面板（App 不渲染此层，点击分享直接唤起系统面板）：
 *     <!-- #ifdef H5 || WEB -->
 *     <uni-modal-popup ref="sharePopupRef" ...>
 *       ... @tap="handleCopyLink" ... @tap="closeShareSheet"
 *     </uni-modal-popup>
 *     <!-- #endif -->
 */
import { ref, type ComponentPublicInstance, type Ref } from "vue";
import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

const _params = emptyI18nParams();
const t = (key: string): string => translateFn(key, _params, "");

/**
 * 分享防重：基于「面板打开时间戳」的节流窗口（毫秒），距离上次面板打开不足窗口期的点击直接忽略。
 * 刻意不依赖系统面板回调解锁：Android 端 shareWithSystem 的 complete 可能在面板刚打开时就回调，
 * 不能作为「面板已关闭」的可靠信号（曾因此连点复现多面板）。
 * 时间戳只在「面板真正打开前」刷新：App 在 launchSystemShare 调用 shareWithSystem 前；
 * H5 在 openShareSheet 前（同步，等价于打开时刻）。
 */
const SHARE_DEBOUNCE_WINDOW_MS = 1000;

/**
 * 入参（class 而非 interface + 对象字面量）：Android UTS 编译器对「接口类型参数 + 内联对象字面量」
 * 的实参会误推导成 UTSJSONObject（kotlin 编译报"参数类型不匹配"，见 uts 编译已知问题 error17），
 * 与仓库内 subpackages/hooks/usePageResume.uts 的 PageResumeOptions 同一避坑写法：
 * 调用方需 `new ShareLinkOptions()` 后逐字段赋值，不能直接传 `{ getShareTitle: ..., getShareUrl: ... }`。
 */
export class ShareLinkOptions {
  /** 分享标题（系统分享面板 summary 等） */
  getShareTitle: () => string = (): string => "";
  /**
   * 获取分享链接。是否需要网络请求、是否缓存由调用方自行实现（如按 shareKey 请求结果做页面级缓存），
   * Hook 内部不做缓存，只负责交互与失败兜底。
   */
  getShareUrl: () => Promise<string> = (): Promise<string> => Promise.resolve("");
}

/** Hook 返回值（class 避免 UTS interface 对象字面量限制，与仓库内其它 hooks 一致） */
export class ShareLinkResult {
  /** H5/WEB 底部分享面板（uni-modal-popup）ref；App 端不使用，但统一声明便于调用方模板绑定 */
  sharePopupRef: Ref<any | null>;
  /** 导航栏分享按钮点击入口：H5/WEB 展开底部面板；App 直接唤起系统分享 */
  handleShare: () => void;
  /** 关闭 H5/WEB 分享面板 */
  closeShareSheet: () => void;
  /** H5/WEB 面板内「复制链接」选项 */
  handleCopyLink: () => Promise<void>;

  constructor(
    sharePopupRef: Ref<any | null>,
    handleShare: () => void,
    closeShareSheet: () => void,
    handleCopyLink: () => Promise<void>,
  ) {
    this.sharePopupRef = sharePopupRef;
    this.handleShare = handleShare;
    this.closeShareSheet = closeShareSheet;
    this.handleCopyLink = handleCopyLink;
  }
}

export function useShareLink(options: ShareLinkOptions): ShareLinkResult {
  const getShareTitle = options.getShareTitle;
  const getShareUrl = options.getShareUrl;

  let lastSharePanelOpenAt = 0;

  /** H5/WEB 自绘分享面板 ref；App/小程序不使用，统一声明避免调用方按平台分支取值 */
  const sharePopupRef = ref<any | null>(null);

  /** 复制分享链接到剪贴板：H5/WEB 的分享主路径，App 端系统分享失败时的兜底 */
  const copyShareLinkToClipboard = (url: string, successTitle: string): void => {
    uni.setClipboardData({
      data: url,
      success: () => {
        uni.showToast({
          title: successTitle,
          icon: "none",
          duration: 2000,
        });
      },
      fail: () => {
        uni.showToast({
          title: t("Mobile.Share.shareFailed"),
          icon: "none",
          duration: 2000,
        });
      },
    });
  };

  // #ifdef H5 || WEB
  /** Android：Gen* 组件 ref 禁止 as UTSJSONObject，用 $callMethod 调 uni-modal-popup */
  const callSharePopupMethod = (methodName: string): void => {
    const refVal = sharePopupRef.value as any | null;
    if (refVal == null) {
      return;
    }
    try {
      const proxy = refVal as ComponentPublicInstance;
      proxy.$callMethod(methodName);
    } catch (_e) {
      // ignore
    }
  };

  const openShareSheet = (): void => {
    callSharePopupMethod("open");
  };

  const closeShareSheet = (): void => {
    callSharePopupMethod("close");
  };

  const handleCopyLink = async (): Promise<void> => {
    closeShareSheet();
    try {
      const shareUrlValue = await getShareUrl();
      copyShareLinkToClipboard(shareUrlValue, t("Mobile.Share.shareSuccess"));
    } catch (error) {
      console.error("复制链接失败:", error);
      uni.showToast({
        title: t("Mobile.Share.shareFailed"),
        icon: "none",
        duration: 2000,
      });
    }
  };
  // #endif
  // #ifndef H5 || WEB
  const closeShareSheet = (): void => {};
  const handleCopyLink = async (): Promise<void> => {};
  // #endif

  // #ifdef APP
  /**
   * 系统分享：直接唤起系统分享面板，把链接分享到设备上已安装的任意 App。
   * 面板操作区自带「复制」按钮（Android 10+ 分享面板 / iOS 拷贝 / 鸿蒙 COPY_TO_PASTEBOARD
   * 均为系统内置能力，默认展示，无需也无法由 API 注入）。
   * uni.shareWithSystem 为内置 API（Android/iOS 4.33+，鸿蒙 4.61+ 走系统 Share Kit），
   * 无需 manifest 配置、无需重打基座。Android 分享到微信为纯文本（微信自动识别 URL）。
   */
  const launchSystemShare = async (): Promise<void> => {
    try {
      const shareUrlValue = await getShareUrl();
      // 面板打开前去重：并发流程（多次连点穿过入口检查）在此收敛为一次；
      // 通过后刷新时间戳，面板展示期间（SHARE_DEBOUNCE_WINDOW_MS 内）的点击都会被入口拦截。
      const nowMs = Date.now();
      if (nowMs - lastSharePanelOpenAt < SHARE_DEBOUNCE_WINDOW_MS) {
        return;
      }
      lastSharePanelOpenAt = nowMs;
      uni.shareWithSystem({
        type: "text",
        summary: getShareTitle(),
        href: shareUrlValue,
        fail: (res: ShareWithSystemFail) => {
          // 1310600 = 用户主动取消分享，静默返回
          if (res.errCode == 1310600) return;
          // 系统分享不可用（面板唤起失败等）→ 兜底复制链接到剪贴板
          console.warn("[useShareLink] shareWithSystem failed:", res);
          copyShareLinkToClipboard(shareUrlValue, t("Mobile.Share.shareFallbackCopied"));
        },
      });
    } catch (error) {
      console.error("系统分享失败:", error);
      uni.showToast({
        title: t("Mobile.Share.shareFailed"),
        icon: "none",
        duration: 2000,
      });
    }
  };
  // #endif

  // 分享：H5/WEB 展开底部面板（复制链接）；App 直接唤起系统分享面板
  const handleShare = (): void => {
    // 节流入口：距上次面板打开不足窗口期的连点直接忽略（不依赖任何回调解锁）
    if (Date.now() - lastSharePanelOpenAt < SHARE_DEBOUNCE_WINDOW_MS) return;

    // #ifdef H5 || WEB
    // 面板未挂载时不刷新时间戳，用户可稍后重试
    if ((sharePopupRef.value as any | null) == null) return;
    // 打开是同步操作，此处刷新等价于「面板打开时刻」
    lastSharePanelOpenAt = Date.now();
    openShareSheet();
    // #endif

    // #ifdef APP
    launchSystemShare();
    // #endif
  };

  return new ShareLinkResult(sharePopupRef, handleShare, closeShareSheet, handleCopyLink);
}

export default useShareLink;
