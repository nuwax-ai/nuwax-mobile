import { ref, type Ref } from "vue";
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { apiNotifyMessageUnreadCount } from "@/servers/message";
import { apiResCode, apiResData } from "@/utils/apiResponse";

const MINE_TAB_INDEX = 3;

/** 系统消息未读数响应式变量，供 TabBar Badge 与“我的”等页面同步渲染。 */
export const systemMessageUnreadCount: Ref<number> = ref<number>(0);

/** TabBar 页面路由（与 pages.json tabBar.list 保持一致）。 */
function isTabBarRoute(route: string): boolean {
  return (
    route == "pages/index/index" ||
    route == "pages/agent-union-record/agent-union-record" ||
    route == "pages/agent-list/agent-list" ||
    route == "pages/mine/mine"
  );
}

/**
 * TabBar API 要求当前栈顶为 Tab 页，且 TabBar 已挂载。
 * errCode 100 = TabBar 不存在（非 Tab 页 / 启动过早都会触发）。
 */
function canUpdateTabBarBadge(): boolean {
  const pages = getCurrentPages();
  if (pages.length == 0) {
    return false;
  }
  // UTS：Page 实例勿 as any，否则访问 .route 会报「找不到名称 route」
  const currentPage = pages[pages.length - 1];
  if (currentPage == null) {
    return false;
  }
  return isTabBarRoute(`${currentPage.route}`);
}

function clearBadge(): void {
  if (!canUpdateTabBarBadge()) {
    return;
  }
  try {
    uni.removeTabBarBadge({
      index: MINE_TAB_INDEX,
      fail: (_err) => {
        // TabBar 未就绪时忽略
      },
    });
  } catch (_e) {
    // uni-app x 部分端会以异常抛出 UniError
  }
}

function setBadge(count: number): void {
  if (!canUpdateTabBarBadge()) {
    return;
  }
  try {
    uni.setTabBarBadge({
      index: MINE_TAB_INDEX,
      text: count > 99 ? "99+" : `${count}`,
      fail: (_err) => {
        // TabBar 未就绪时忽略，进入 Tab 页后再刷新
      },
    });
  } catch (_e) {
    // uni-app x 部分端会以异常抛出 UniError
  }
}

/** 刷新“我的”Tab 的系统消息未读徽标。 */
export async function refreshSystemMessageBadge(): Promise<void> {
  const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
  const token = tokenRaw != null ? `${tokenRaw}` : "";
  if (token.length == 0) {
    systemMessageUnreadCount.value = 0;
    clearBadge();
    return;
  }

  try {
    const response = await apiNotifyMessageUnreadCount();
    if (apiResCode(response) != SUCCESS_CODE) {
      return;
    }
    const countRaw = apiResData<any>(response);
    const count = countRaw != null ? parseInt(`${countRaw}`) : 0;
    const finalCount = !isNaN(count) && count > 0 ? count : 0;
    systemMessageUnreadCount.value = finalCount;
    if (finalCount <= 0) {
      clearBadge();
      return;
    }
    setBadge(finalCount);
  } catch (_error) {
    // 未读数刷新失败时保留上一次徽标，避免网络抖动导致视觉闪烁。
  }
}

/** 系统消息已全部置为已读后立即移除徽标。 */
export function clearSystemMessageBadge(): void {
  systemMessageUnreadCount.value = 0;
  clearBadge();
}
