<template>
  <view class="skill-tags-wrapper" v-if="selectedSkills.length > 0 || selectedDocs.length > 0">
    <view class="skill-tags-list">
      <view v-for="(skill, index) in selectedSkills" :key="skill.id" class="skill-chip">
        <agent-icon v-if="skill.icon.length > 0" :icon="skill.icon" :alt="skill.name" :size="34" :margin-right="8" />
        <text class="skill-chip-name">{{ skill.name }}</text>
        <view class="skill-chip-remove" @click="handleRemove(index)">
          <view class="skill-chip-remove-line skill-chip-remove-line--left" />
          <view class="skill-chip-remove-line skill-chip-remove-line--right" />
        </view>
      </view>
      <view v-for="(doc, index) in selectedDocs" :key="`doc-${doc.slugId}`" class="skill-chip">
        <svg-icon name="icon-a-Filetext" size="32" customClass="skill-chip-doc-icon" />
        <text class="skill-chip-name">{{ doc.title }}</text>
        <view class="skill-chip-remove" @click="handleRemoveDoc(index)">
          <view class="skill-chip-remove-line skill-chip-remove-line--left" />
          <view class="skill-chip-remove-line skill-chip-remove-line--right" />
        </view>
      </view>
      <view class="skill-chip-add" @click="handleAdd">
        <svg-icon name="icon-Plus" size="30" />
      </view>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import AgentIcon from '@/components/agent-icon/agent-icon.uvue';
  import { SkillInfoForAt } from '@/types/interfaces/skill';
  import { SelectedDocInfo } from '@/types/interfaces/knowledgeList';

  withDefaults(defineProps<{
    selectedSkills: SkillInfoForAt[];
    selectedDocs?: SelectedDocInfo[];
  }>(), {
    selectedDocs: () => [] as SelectedDocInfo[],
  });

  const emit = defineEmits<{
    (e: 'onRemove', index: number): void;
    (e: 'onAdd'): void;
    (e: 'onRemoveDoc', index: number): void;
  }>();

  const handleRemove = (index: number) => {
    emit('onRemove', index);
  };

  const handleAdd = () => {
    emit('onAdd');
  };

  const handleRemoveDoc = (index: number) => {
    emit('onRemoveDoc', index);
  };
</script>

<style lang="scss" scoped>
  .skill-tags-wrapper {
    width: 100%;
    margin-top: 14rpx;
    padding: 0 18rpx;
    box-sizing: border-box;

    .skill-tags-list {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;

      /* 胶囊与专家回显 pill 同款：全圆角 + 浅灰底 + 头像/图标 + 名称 + 叉号 */
      .skill-chip {
        display: flex;
        flex-direction: row;
        align-items: center;
        height: 52rpx;
        max-width: 100%;
        margin: 0 12rpx 12rpx 0;
        padding: 0 12rpx 0 8rpx;
        border-radius: 999rpx;
        background-color: #f2f1f6;
        box-sizing: border-box;
      }

      .skill-chip-doc-icon {
        margin-right: 8rpx;
      }

      .skill-chip-name {
        max-width: 300rpx;
        color: #34343d;
        font-size: 22rpx;
        lines: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .skill-chip-remove {
        position: relative;
        flex-shrink: 0;
        width: 32rpx;
        height: 32rpx;
        margin-left: 6rpx;
      }

      .skill-chip-remove-line {
        position: absolute;
        left: 8rpx;
        top: 15rpx;
        width: 16rpx;
        height: 3rpx;
        border-radius: 999rpx;
        background-color: #8d8d97;
      }

      .skill-chip-remove-line--left { transform: rotate(45deg); }
      .skill-chip-remove-line--right { transform: rotate(-45deg); }

      .skill-chip-add {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52rpx;
        height: 52rpx;
        margin: 0 0 12rpx 0;
        border-radius: 999rpx;
        background-color: #f2f1f6;
      }
    }
  }
</style>
