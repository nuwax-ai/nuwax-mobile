<template>
  <view v-if="callAvailable" class="return-to-call" :style="{ top: topOffset + 'px' }" hover-class="return-to-call-pressed" @click.stop="restoreCall">
    <image class="return-to-call-icon" src="/static/voip/call-icons/phone-white.png" mode="aspectFit" />
    <text class="return-to-call-label">{{ returnLabel }}</text>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import { getVoipSnapshot, restoreVoipCall, voipRevision } from "@/features/voip/callManager";
  import { getStatusBarHeight } from "@/utils/system";
  import { emptyI18nParams, t } from "@/utils/i18n";

  // Anchor inside the page below the status bar and the chat header/tabs.
  const topOffset = computed((): number => getStatusBarHeight() + 104);
  const returnLabel = computed((): string => t("Mobile.Voip.return", emptyI18nParams(), ""));
  const callAvailable = computed((): boolean => {
    voipRevision.value;
    const call = getVoipSnapshot();
    return call != null && call.state != "ended";
  });
  function restoreCall(): void { restoreVoipCall(); }
</script>

<style scoped>
  .return-to-call { position: absolute; right: 16px; z-index: 56; height: 44px; padding: 0 14px; border-radius: 22px; background-color: #202827; flex-direction: row; align-items: center; }
  .return-to-call-pressed { opacity: 0.8; }
  .return-to-call-icon { width: 18px; height: 18px; margin-right: 8px; pointer-events: none; }
  .return-to-call-label { color: #ffffff; font-size: 13px; font-weight: 500; pointer-events: none; }
</style>
