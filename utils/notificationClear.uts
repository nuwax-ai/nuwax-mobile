// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
import { clearAppNotifications } from "@/uni_modules/nuwax-notification-clear";
// #endif
// #ifdef APP-HARMONY
import { hasNativeVoipCall } from "@/features/voip/integration";
// #endif

/**
 * 清空系统通知栏 / 通知中心里本 App 已展示的推送通知（产品要求：打开 App 即清空）。
 *
 * 为什么需要单独一个插件：uni-app x 的 uni-push 只暴露
 * getPushClientId / onPushMessage / offPushMessage / createPushMessage /
 * setAppBadgeNumber，**没有清除通知的 API**（旧版 uni-app 的 uni.removePushMessage
 * 在 uni-app x 里不存在）。三端分别走原生调用，见
 * uni_modules/nuwax-notification-clear。
 *
 * 调用时机（App.uvue）：
 * - onShow：冷启动与「从后台回到前台」都会触发，是「打开 App」的主口径；
 *   用户点推送通知进 App 时系统会自动消掉被点的那条，这里把**其余**一并清掉；
 * - initializeApplication 末尾：Android 首启协议弹窗期间 onShow 已提前返回，
 *   用户同意后不会再有第二次 onShow，需在同意后的初始化里补一次。
 *   冷启动时两处都会调一次，cancelAll 幂等，无副作用。
 *
 * 不处理图标角标：角标口径是 IM 未读总数（utils/appIconBadge.uts），
 * 与通知条数无关，清通知时不能顺手清零，否则未读数会被「已读」误伤。
 *
 * H5 / 小程序无对应能力，函数体为空（条件编译整段剔除），调用方不必再加平台判断。
 */
export function clearNotificationsOnAppOpen(): void {
  // #ifdef APP-HARMONY
  // Keep the system call / VoIP background-task notice, including a native cold-start answer.
  try { if (hasNativeVoipCall()) return; } catch (_e) { /* Base without VoIP: preserve normal App startup. */ }
  // #endif
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    clearAppNotifications();
  } catch (e) {
    // 基座未含该插件（标准基座）/ 原生调用异常：静默降级，绝不影响启动
    console.error("[NotificationClear] fail:", e);
  }
  // #endif
}
