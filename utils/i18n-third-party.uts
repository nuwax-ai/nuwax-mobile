import { reactive } from "vue";
import { DEFAULT_LANG } from "@/constants/i18n.constants";
import { getLocalFallback, toBundleKey } from "@/constants/i18n.local.constants";
import { orString } from "@/utils/utsCoalesce.uts";

/**
 * uni-load-more 文案对象
 * UTS: 需 class 构造，不支持 interface 对象字面量
 */
export class UniLoadMoreContentText {
  contentdown: string = "";
  contentrefresh: string = "";
  contentnomore: string = "";
}

class ThirdPartyLocaleState {
  currentLang: string = DEFAULT_LANG;
}

/**
 * 第三方库语言状态适配层。
 * 这里不维护独立词典，只缓存当前项目语言，确保所有第三方入口都跟随主 i18n 状态。
 */
export const thirdPartyLocaleState = reactive(new ThirdPartyLocaleState());

const normalizeThirdPartyLang = (lang: string): string => {
  return toBundleKey(lang);
};

/**
 * 同步第三方库当前语言。
 * 目前先作为统一收口点，后续新增 dayjs / markdown / UI 库时只需要继续往这里扩展。
 */
export const syncThirdPartyLocales = (lang: string) => {
  thirdPartyLocaleState.currentLang = normalizeThirdPartyLang(lang);
};

/**
 * 获取 `uni-load-more` 组件所需的文案对象。
 * 通过显式传入 `content-text`，避免组件内部继续使用自己的默认语言逻辑。
 * @param contentdown 覆盖「上拉加载更多」文案，空字符串则用本地兜底
 * @param contentrefresh 覆盖「加载中」文案，空字符串则用本地兜底
 * @param contentnomore 覆盖「没有更多」文案，空字符串则用本地兜底
 */
export function getUniLoadMoreContentText(
  contentdown: string = "",
  contentrefresh: string = "",
  contentnomore: string = "",
): UniLoadMoreContentText {
  const lang = normalizeThirdPartyLang(thirdPartyLocaleState.currentLang);
  const text = new UniLoadMoreContentText();
  text.contentdown = orString(
    contentdown,
    getLocalFallback(lang, "Mobile.Common.loadMore"),
  );
  text.contentrefresh = orString(
    contentrefresh,
    getLocalFallback(lang, "Mobile.Page.loadingMore"),
  );
  text.contentnomore = orString(
    contentnomore,
    getLocalFallback(lang, "Mobile.Common.noMoreData"),
  );
  return text;
}
