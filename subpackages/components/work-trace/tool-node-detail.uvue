<template>
  <!--
    V2 工具行内联展开详情（对齐 PC ToolNodeDetail）。
    类型分派互斥 if-return：todo / terminal / file-read / file-edit / search·browser / skill / generic。
    纯展示不可点（PC 2026-09-14 定调：文件路径跳转关闭）。
  -->
  <view class="tool-detail">
    <!-- todo（Plan 步骤清单） -->
    <view v-if="detail.kind == 'todo'" class="tool-detail-steps">
      <view v-for="(step, index) in detail.steps" :key="index" class="tool-detail-step">
        <text
          class="iconfont tool-detail-step-icon"
          :class="stepIconClass(step.status)"
        />
        <text class="tool-detail-step-text">{{ step.content }}</text>
      </view>
    </view>

    <!-- terminal -->
    <view v-else-if="detail.kind == 'terminal'" class="tool-panel" :class="{ 'is-failed': detail.failed }">
      <view class="tool-terminal-header">
        <text class="tool-terminal-shell">Shell</text>
        <view class="tool-terminal-status">
          <view v-if="detail.running" class="tool-terminal-status-run">
            <text class="iconfont icon-Loader tool-terminal-spinner" />
            <text class="tool-terminal-status-text">{{
              t("Mobile.Chat.WorkTrace.detailRunning")
            }}</text>
          </view>
          <view v-else-if="detail.failed" class="tool-terminal-status-run">
            <text class="iconfont icon-waring tool-terminal-failed-icon" />
            <text class="tool-terminal-status-text tool-terminal-status-failed">{{
              detail.exitCode != -9999
                ? t("Mobile.Chat.WorkTrace.detailExitCode", { code: detail.exitCode } as any)
                : t("Mobile.Chat.WorkTrace.detailFailed")
            }}</text>
          </view>
          <view v-else class="tool-terminal-status-run">
            <text class="iconfont icon-Check tool-terminal-ok-icon" />
            <text class="tool-terminal-status-text">{{
              detail.exitCode != -9999
                ? t("Mobile.Chat.WorkTrace.detailExitCode", { code: detail.exitCode } as any)
                : t("Mobile.Chat.WorkTrace.detailSucceeded")
            }}</text>
          </view>
        </view>
      </view>
      <text v-if="detail.description.length > 0" class="tool-detail-description">{{
        detail.description
      }}</text>
      <view v-if="detail.command.length > 0" class="tool-detail-command">
        <text class="tool-detail-command-dollar">$</text>
        <text class="tool-detail-text is-command">{{ detail.command }}</text>
      </view>
      <text v-if="detail.output.length > 0" class="tool-detail-text is-output" :class="{ 'is-failed-output': detail.failed }">{{
        detail.output
      }}</text>
    </view>

    <!-- file-read -->
    <view v-else-if="detail.kind == 'file-read'" class="tool-panel">
      <view class="tool-file-header">
        <view class="tool-file-link">
          <text class="tool-file-badge">{{ fileBadgeLabel }}</text>
          <text class="tool-file-name">{{ fileBadgeName }}</text>
          <text v-if="fileDir.length > 0" class="tool-file-dir">{{ fileDir }}/</text>
        </view>
        <text v-if="detail.lineStart > 0" class="tool-file-lines">{{
          t("Mobile.Chat.WorkTrace.detailLineRange", {
            start: detail.lineStart,
            end: detail.lineEnd > 0 ? detail.lineEnd : detail.lineStart,
          } as any)
        }}</text>
      </view>
      <text v-if="detail.output.length > 0" class="tool-detail-text">{{ detail.output }}</text>
    </view>

    <!-- file-edit（diff 红绿整块） -->
    <view v-else-if="detail.kind == 'file-edit' && detail.diffs.length > 0" class="tool-panel">
      <view class="tool-diff-summary">
        <text class="tool-diff-summary-text">{{
          t("Mobile.Chat.WorkTrace.detailFilesChanged", { count: detail.diffs.length } as any)
        }}</text>
        <text class="tool-diff-added">+{{ detail.additions }}</text>
        <text class="tool-diff-removed">-{{ detail.deletions }}</text>
      </view>
      <view v-for="(diff, index) in detail.diffs" :key="index" class="tool-detail-diff">
        <view class="tool-file-link">
          <text class="tool-file-badge">{{ diffBadgeLabel(diff.path) }}</text>
          <text class="tool-file-name">{{ diffName(diff.path) }}</text>
        </view>
        <text v-if="diff.oldText.length > 0" class="tool-detail-diff-pre is-removed">{{
          prefixMinus(diff.oldText)
        }}</text>
        <text v-if="diff.newText.length > 0" class="tool-detail-diff-pre is-added">{{
          prefixPlus(diff.newText)
        }}</text>
      </view>
    </view>

    <!-- search / browser -->
    <view
      v-else-if="detail.kind == 'search' || detail.kind == 'browser'"
      class="tool-result-view"
    >
      <text v-if="detail.query.length > 0" class="tool-detail-query">{{ detail.query }}</text>
      <text v-if="detail.resultTitle.length > 0" class="tool-result-title">{{
        detail.resultTitle
      }}</text>
      <text v-if="detail.url.length > 0" class="tool-file-plain">{{ detail.url }}</text>
      <text v-if="detail.resultSummary.length > 0" class="tool-result-summary">{{
        detail.resultSummary
      }}</text>
      <text
        v-if="detail.resultSummary.length == 0 && detail.output.length > 0"
        class="tool-detail-text"
        >{{ detail.output }}</text
      >
    </view>

    <!-- skill（markdown 正文） -->
    <mp-html
      v-else-if="detail.kind == 'skill' && detail.skillContent.length > 0"
      :content="detail.skillContent"
      :markdown="true"
      :selectable="true"
      :container-style="'width: 100%;'"
    />

    <!-- generic 兜底（输入 / 结果） -->
    <view v-else>
      <text v-if="detail.description.length > 0" class="tool-detail-description">{{
        detail.description
      }}</text>
      <text v-if="detail.filePath.length > 0" class="tool-file-plain">{{ detail.filePath }}</text>
      <view v-if="detail.inputText.length > 0" class="tool-detail-section">
        <text class="tool-detail-section-label">{{ t("Mobile.Chat.WorkTrace.detailInput") }}</text>
        <text class="tool-detail-text is-input">{{ detail.inputText }}</text>
      </view>
      <view v-if="detail.output.length > 0" class="tool-detail-section">
        <text class="tool-detail-section-label">{{ t("Mobile.Chat.WorkTrace.detailResult") }}</text>
        <text class="tool-detail-text">{{ detail.output }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import type { TraceToolRow } from "@/subpackages/components/ai-msg/conversationTrace.uts";
  import {
    normalizeToolNodeDetail,
    prefixDiffLines,
    type ToolNodeDetailData,
  } from "@/subpackages/components/work-trace/toolNodeDetail.uts";
  import {
    getFileTypeInfo,
    splitFilePath,
  } from "@/subpackages/components/work-trace/toolFilePresentation.uts";
  // #ifdef H5 || MP-WEIXIN
  import mpHtml from "@/subpackages/uni_modules/mp-html/components/mp-html/mp-html.vue";
  // #endif
  import { useI18n } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  // i18n 插值命名参数（H5 运行时）；组件内包一层避免模板多次调用
  function t(key: string, params?: Record<string, string | number>): string {
    return tFn(key, params, "");
  }

  const props = withDefaults(
    defineProps<{
      /** 投影产出的工具行数据 */
      row?: TraceToolRow | null;
    }>(),
    {
      row: null,
    },
  );

  /** 详情归一化（行组件粒度 computed 缓存，避免模板函数每帧重算） */
  const detail = computed((): ToolNodeDetailData => {
    const row = props.row;
    if (row == null || row!.processing == null) {
      return normalizeToolNodeDetail("generic", null, row == null ? "" : row!.status);
    }
    return normalizeToolNodeDetail(row!.kind, row!.processing, row!.status);
  });

  const fileParts = computed(() => splitFilePath(detail.value.filePath));
  const fileBadgeLabel = computed((): string => getFileTypeInfo(fileParts.value.name).label);
  const fileBadgeName = computed((): string => fileParts.value.name);
  const fileDir = computed((): string => fileParts.value.dir);

  function diffParts(path: string) {
    return splitFilePath(path);
  }
  function diffBadgeLabel(path: string): string {
    return getFileTypeInfo(diffParts(path).name).label;
  }
  function diffName(path: string): string {
    return diffParts(path).name;
  }
  function prefixMinus(text: string): string {
    return prefixDiffLines(text, "- ");
  }
  function prefixPlus(text: string): string {
    return prefixDiffLines(text, "+ ");
  }

  function stepIconClass(status: string): string {
    if (status == "completed") return "icon-CheckSquareOutlined";
    if (status == "in_progress") return "icon-HourglassOutlined";
    if (status == "failed") return "icon-CloseSquareOutlined";
    return "icon-BorderOutlined";
  }
</script>

<style lang="scss" scoped>
  // 对齐 PC hairline 色板（colorBorderSecondary ≈ rgba(5,5,5,8%)）与 12px→24rpx 详情字号体系
  $hairline: rgba(5, 5, 5, 0.08);
  $fill: rgba(5, 5, 5, 0.02);
  $fill-hover: rgba(5, 5, 5, 0.04);
  $text-main: rgba(0, 0, 0, 0.88);
  $text-secondary: rgba(5, 5, 5, 0.65);
  $text-tertiary: rgba(5, 5, 5, 0.45);
  $color-error: #ff4d4f;
  $color-success: #52c41a;
  $color-primary: #6a5af9;
  $mono: "Monaco", "Menlo", "Ubuntu Mono", monospace;

  .tool-detail {
    display: flex;
    flex-direction: column;
    gap: 14rpx;
    min-width: 0;
    font-size: 24rpx;
    line-height: 1.55;
    color: $text-main;
  }

  // 承载面板（terminal / file-preview / diff-view 三处）：1px hairline + 填充底 + 8px→16rpx 圆角
  .tool-panel {
    display: flex;
    flex-direction: column;
    gap: 14rpx;
    min-width: 0;
    padding: 20rpx 24rpx;
    border: 1px solid $hairline;
    border-radius: 16rpx;
    background-color: $fill;
    overflow: hidden;
  }

  .tool-terminal-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
    min-width: 0;
    padding-bottom: 12rpx;
    color: $text-secondary;
    font-family: $mono;
  }

  .tool-terminal-shell {
    font-size: 24rpx;
    line-height: 36rpx;
  }

  .tool-terminal-status {
    display: flex;
    align-items: center;
  }

  .tool-terminal-status-run {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10rpx;
  }

  .tool-terminal-spinner {
    font-size: 24rpx;
    color: $color-primary;
    animation: tool-detail-spin 1s linear infinite;
  }

  .tool-terminal-failed-icon {
    font-size: 24rpx;
    color: #ffcb00;
  }

  .tool-terminal-ok-icon {
    font-size: 24rpx;
    color: $color-success;
  }

  .tool-terminal-status-text {
    font-size: 24rpx;
    line-height: 36rpx;
    color: $text-secondary;
  }

  .tool-terminal-status-failed {
    color: $color-error;
  }

  .tool-detail-description {
    color: $text-tertiary;
  }

  // $ + 命令块：上下 hairline 分隔
  .tool-detail-command {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 12rpx;
    padding: 14rpx 0;
    border-top: 1px solid $hairline;
    border-bottom: 1px solid $hairline;
    color: $text-tertiary;
  }

  .tool-detail-command-dollar {
    flex-shrink: 0;
    width: 24rpx;
    font-family: $mono;
    font-size: 24rpx;
    line-height: 37rpx;
  }

  // 命令/输出/输入通用 pre：填充底 + 限高内滚
  .tool-detail-text {
    min-width: 0;
    max-height: 200rpx;
    margin: 0;
    padding: 14rpx 18rpx;
    overflow: auto;
    border-radius: 10rpx;
    white-space: pre-wrap;
    word-break: break-all;
    color: $text-main;
    background-color: $fill-hover;
    font-family: $mono;
    font-size: 24rpx;
    line-height: 1.55;

    &.is-command {
      flex: 1;
      min-width: 0;
      padding: 0;
      background-color: transparent;
    }

    &.is-input {
      color: $text-secondary;
    }

    &.is-failed-output {
      border-left: 4rpx solid $color-error;
    }
  }

  .tool-file-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 16rpx;
    min-width: 0;
    color: $text-secondary;

    .tool-file-lines {
      font-size: 24rpx;
      color: $text-tertiary;
    }
  }

  .tool-diff-summary {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 16rpx;
    min-width: 0;
    padding-bottom: 12rpx;
    color: $text-tertiary;
  }

  .tool-diff-summary-text {
    font-size: 24rpx;
  }

  .tool-diff-added {
    font-family: $mono;
    font-size: 24rpx;
    color: $color-success;
  }

  .tool-diff-removed {
    font-family: $mono;
    font-size: 24rpx;
    color: $color-error;
  }

  .tool-detail-diff {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
    padding-top: 14rpx;
    border-top: 1px solid $hairline;
  }

  .tool-detail-diff-pre {
    max-height: 200rpx;
    margin: 0;
    padding: 10rpx 16rpx;
    overflow: auto;
    white-space: pre-wrap;
    font-family: $mono;
    font-size: 24rpx;
    line-height: 1.5;

    &.is-removed {
      background-color: rgba(255, 77, 79, 0.08);
    }

    &.is-added {
      background-color: rgba(82, 196, 26, 0.08);
    }
  }

  .tool-result-view {
    display: flex;
    flex-direction: column;
    gap: 10rpx;
    padding: 10rpx 0;
  }

  .tool-result-title {
    font-size: 26rpx;
    font-weight: 600;
    color: $text-main;
    line-height: 38rpx;
  }

  .tool-result-summary {
    font-size: 24rpx;
    color: $text-secondary;
    line-height: 1.55;
  }

  .tool-detail-query {
    width: fit-content;
    max-width: 100%;
    padding: 6rpx 14rpx;
    overflow: hidden;
    border-radius: 10rpx;
    color: $text-secondary;
    background-color: $fill-hover;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 24rpx;
  }

  .tool-detail-section {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
  }

  .tool-detail-section-label {
    font-size: 22rpx;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: $text-tertiary;
  }

  // todo 步骤清单
  .tool-detail-steps {
    display: flex;
    flex-direction: column;
    gap: 10rpx;
  }

  .tool-detail-step {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 14rpx;
  }

  .tool-detail-step-icon {
    flex-shrink: 0;
    font-size: 30rpx;
    color: #8c8c8c;
    line-height: 38rpx;
  }

  .tool-detail-step-text {
    flex: 1;
    min-width: 0;
    font-size: 26rpx;
    color: $text-main;
    line-height: 40rpx;
  }

  // 文件三段式（徽标+文件名+目录），纯展示不可点
  .tool-file-link {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10rpx;
    min-width: 0;
    max-width: 100%;
  }

  .tool-file-badge {
    flex-shrink: 0;
    padding: 0 8rpx;
    border-radius: 6rpx;
    background-color: #8a8f98;
    color: #ffffff;
    font-family: $mono;
    font-weight: 600;
    font-size: 20rpx;
    line-height: 32rpx;
  }

  .tool-file-name {
    flex-shrink: 0;
    color: $text-main;
    font-family: $mono;
    font-size: 24rpx;
    line-height: 36rpx;
  }

  .tool-file-dir {
    min-width: 0;
    overflow: hidden;
    color: $text-tertiary;
    font-family: $mono;
    font-size: 24rpx;
    line-height: 36rpx;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  // 非沙箱路径 / URL 整串普通色
  .tool-file-plain {
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    color: $text-main;
    font-family: $mono;
    font-size: 24rpx;
    line-height: 36rpx;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @keyframes tool-detail-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
</style>
