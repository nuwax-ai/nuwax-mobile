/**
 * MCP Ask schema and tool input helpers (nuwax.interaction.v2).
 * Keeps SSE, history hydration, resume formatting, and card rendering aligned.
 *
 * v2:表单为有序自描述数组 ui.fields[];不再有 schema/uiSchema/ui:widget/enum。
 */
import {
  InteractionUiOptions,
  InteractionUiSchema,
  InteractionUiStep,
  McpAskInteraction,
  McpAskPresentation,
  McpAskWidget,
  MCP_ASK_TOOL_NAME,
  MCP_ASK_WIDGET_TYPES,
} from "@/types/intervention";
import { firstNullableString, orEmpty, orString } from "@/utils/utsCoalesce";

export const MCP_ASK_SCHEMA_VERSION = "nuwax.mcp_ask.v2";
export const INTERACTION_UI_SCHEMA_VERSION = "nuwax.interaction.v2";
export { MCP_ASK_TOOL_NAME };

/**
 * 解析后的字段:形状对齐渲染层(mcp-ask-question-card.uvue 的 toParsedField)读取路径。
 * property 为从 v2 McpAskFormField 重建的 JsonSchema 约束视图。
 * UTS: 需 class 构造
 */
export class ParsedMcpAskField {
  name: string = "";
  property: any | null = null;
  widget: McpAskWidget = "text";
  required: boolean = false;
  options: InteractionUiOptions = new InteractionUiOptions();
  enumValues: string[] = [];
  enumLabels: string[] = [];
  isInteger: boolean = false;
}

/**
 * Android：Record 编译为 Map，UTSJSONObject as Record 会 ClassCastException。
 * 统一返回 UTSJSONObject，禁止 as Record/Map。
 */
function asRecord(value: any | null): UTSJSONObject | null {
  if (value == null || typeof value != "object") {
    return null;
  }
  if (Array.isArray(value)) {
    return null;
  }
  return value as UTSJSONObject;
}

function readField(obj: UTSJSONObject | null, key: string): any | null {
  if (obj == null) {
    return null;
  }
  // Android：缺失字段为 null，禁止 as any
  const val = obj[key];
  if (val == null) {
    return null;
  }
  return val;
}

function maybeParseRawInput(raw: any): any | null {
  if (typeof raw !== "string") {
    return raw as any;
  }
  try {
    return JSON.parse(raw) as any;
  } catch (_) {
    return null;
  }
}

/** Android：表单字段/选项是 UTSJSONObject，禁止 as interface 后点号访问 */
function readFormValue(raw: any | null, key: string): any | null {
  if (raw == null) {
    return null;
  }
  try {
    const o = raw as UTSJSONObject;
    const val = o[key];
    if (val == null) {
      return null;
    }
    return val;
  } catch (_e) {
    return null;
  }
}

function isFieldOption(opt: any): boolean {
  if (opt == null || typeof opt != "object") {
    return false;
  }
  const value = readFormValue(opt, "value");
  const label = readFormValue(opt, "label");
  return typeof value == "string" && typeof label == "string";
}

function isKnownWidget(widget: string): boolean {
  for (let i = 0; i < MCP_ASK_WIDGET_TYPES.length; i++) {
    if (MCP_ASK_WIDGET_TYPES[i] == widget) {
      return true;
    }
  }
  return false;
}

/** 把 v2 字段重建为 JsonSchema 约束视图(toParsedField 读 minimum/maximum/type/title)。 */
function buildProperty(fieldRaw: any): UTSJSONObject {
  const property = new UTSJSONObject();
  property["type"] = readFormValue(fieldRaw, "type");
  property["title"] = readFormValue(fieldRaw, "title");
  property["description"] = readFormValue(fieldRaw, "description");
  property["minimum"] = readFormValue(fieldRaw, "minimum");
  property["maximum"] = readFormValue(fieldRaw, "maximum");
  property["multipleOf"] = readFormValue(fieldRaw, "multipleOf");
  property["minLength"] = readFormValue(fieldRaw, "minLength");
  property["maxLength"] = readFormValue(fieldRaw, "maxLength");
  return property;
}

function buildOptions(fieldRaw: any): InteractionUiOptions {
  const options = new InteractionUiOptions();
  const placeholder = readFormValue(fieldRaw, "placeholder");
  if (placeholder != null) {
    options.placeholder = `${placeholder}`;
  }
  const allowCustom = readFormValue(fieldRaw, "allowCustom");
  if (allowCustom == true) {
    options.allowCustom = true;
  } else if (allowCustom == false) {
    options.allowCustom = false;
  }
  const otherValue = readFormValue(fieldRaw, "otherValue");
  if (otherValue != null) {
    options.otherValue = `${otherValue}`;
  }
  const otherField = readFormValue(fieldRaw, "otherField");
  if (otherField != null) {
    options.otherField = `${otherField}`;
  }
  const accept = readFormValue(fieldRaw, "accept");
  if (accept != null) {
    options.accept = `${accept}`;
  }
  const multiple = readFormValue(fieldRaw, "multiple");
  if (multiple == true) {
    options.multiple = true;
  } else if (multiple == false) {
    options.multiple = false;
  }
  return options;
}

function parseField(fieldRaw: any): ParsedMcpAskField {
  const optionsRaw = readFormValue(fieldRaw, "options");
  const rawOptions = Array.isArray(optionsRaw) ? (optionsRaw as any[]) : [];
  const enumValues: string[] = [];
  const enumLabels: string[] = [];
  for (let i = 0; i < rawOptions.length; i++) {
    const opt = rawOptions[i];
    if (isFieldOption(opt)) {
      enumValues.push(`${readFormValue(opt, "value")}`);
      enumLabels.push(`${readFormValue(opt, "label")}`);
    }
  }
  const widgetRaw = readFormValue(fieldRaw, "widget");
  const widgetStr = widgetRaw != null ? `${widgetRaw}` : "text";
  const widget = isKnownWidget(widgetStr)
    ? (widgetStr as McpAskWidget)
    : ("text" as McpAskWidget);
  const parsed = new ParsedMcpAskField();
  parsed.name = orEmpty(readFormValue(fieldRaw, "name"));
  parsed.property = buildProperty(fieldRaw);
  parsed.widget = widget;
  parsed.required = readFormValue(fieldRaw, "required") == true;
  parsed.options = buildOptions(fieldRaw);
  parsed.enumValues = enumValues;
  parsed.enumLabels = enumLabels;
  parsed.isInteger = getJsonSchemaPrimaryType(buildProperty(fieldRaw)) == "integer";
  return parsed;
}

function parseUiSteps(raw: any | null): InteractionUiStep[] | null {
  if (raw == null || Array.isArray(raw) == false) {
    return null;
  }
  const arr = raw as any[];
  const result: InteractionUiStep[] = [];
  for (let i = 0; i < arr.length; i++) {
    const item = arr[i];
    if (item == null) continue;
    const step = new InteractionUiStep();
    step.id = orEmpty(readFormValue(item, "id"));
    step.title = orEmpty(readFormValue(item, "title"));
    const desc = readFormValue(item, "description");
    if (desc != null) {
      step.description = `${desc}`;
    }
    const fieldsRaw = readFormValue(item, "fields");
    const names: string[] = [];
    if (fieldsRaw != null && Array.isArray(fieldsRaw)) {
      const fieldArr = fieldsRaw as any[];
      for (let j = 0; j < fieldArr.length; j++) {
        const n = fieldArr[j];
        if (n != null) {
          names.push(`${n}`);
        }
      }
    }
    step.fields = names;
    result.push(step);
  }
  return result;
}

/**
 * Android：禁止 UTSJSONObject as InteractionUiSchema，必须 class 逐字段构造。
 */
export function createInteractionUiSchemaFromAny(
  raw: any | null,
): InteractionUiSchema | null {
  const obj = asRecord(raw);
  if (obj == null) {
    return null;
  }
  const ui = new InteractionUiSchema();
  ui.version = orString(readField(obj, "version"), "");
  const presentation = readField(obj, "presentation");
  if (typeof presentation == "string") {
    if (
      presentation == "modal" ||
      presentation == "inline" ||
      presentation == "wizard"
    ) {
      ui.presentation = presentation as McpAskPresentation;
    }
  }
  ui.title = orString(readField(obj, "title"), "");
  const description = readField(obj, "description");
  if (description != null) {
    ui.description = `${description}`;
  }
  const fields = readField(obj, "fields");
  if (fields != null && Array.isArray(fields)) {
    ui.fields = fields as any[];
  }
  ui.steps = parseUiSteps(readField(obj, "steps"));
  const submitLabel = readField(obj, "submitLabel");
  if (submitLabel != null) {
    ui.submitLabel = `${submitLabel}`;
  }
  const cancelLabel = readField(obj, "cancelLabel");
  if (cancelLabel != null) {
    ui.cancelLabel = `${cancelLabel}`;
  }
  const allowSkip = readField(obj, "allowSkip");
  if (allowSkip == true) {
    ui.allowSkip = true;
  } else if (allowSkip == false) {
    ui.allowSkip = false;
  }
  const skipLabel = readField(obj, "skipLabel");
  if (skipLabel != null) {
    ui.skipLabel = `${skipLabel}`;
  }
  ui.fallback = readField(obj, "fallback");
  return ui;
}

/**
 * 解析 v2 表单字段:遍历 ui.fields[],数组顺序即展示顺序。
 * 传入 fieldNames(wizard 步骤)时按其顺序与名称过滤。
 */
export function parseInteractionFields(
  ui: InteractionUiSchema,
  fieldNames: string[] | null = null,
): ParsedMcpAskField[] {
  const rawFields = ui.fields != null && Array.isArray(ui.fields) ? ui.fields : [];
  if (fieldNames == null || fieldNames.length == 0) {
    const result: ParsedMcpAskField[] = [];
    for (let i = 0; i < rawFields.length; i++) {
      result.push(parseField(rawFields[i]));
    }
    return result;
  }
  const result: ParsedMcpAskField[] = [];
  for (let n = 0; n < fieldNames.length; n++) {
    const name = fieldNames[n];
    for (let i = 0; i < rawFields.length; i++) {
      const field = rawFields[i];
      if (orEmpty(readFormValue(field, "name")) == name) {
        result.push(parseField(field));
        break;
      }
    }
  }
  return result;
}

export function getInteractionSteps(
  ui: InteractionUiSchema,
): InteractionUiStep[] {
  if (ui.steps != null && ui.steps.length > 0) return ui.steps;

  const rawFields = ui.fields != null && Array.isArray(ui.fields) ? ui.fields : [];
  if (rawFields.length == 0) return [];

  const fieldNames: string[] = [];
  for (let i = 0; i < rawFields.length; i++) {
    fieldNames.push(orEmpty(readFormValue(rawFields[i], "name")));
  }
  const step = new InteractionUiStep();
  step.id = "default";
  step.title = ui.title;
  if (ui.description != null) {
    step.description = ui.description;
  }
  step.fields = fieldNames;
  return [step];
}

export function isWizardPresentation(ui: InteractionUiSchema): boolean {
  return ui.presentation === "wizard" || (ui.steps != null && ui.steps.length > 1);
}

/** 是否允许跳过:v2 由 ui.allowSkip 顶层字段控制(旧 v1 的 uiSchema.ui:options.allowSkip 已移除)。 */
export function isSkipAllowed(ui: InteractionUiSchema): boolean {
  return ui.allowSkip === true;
}

export function getSkipLabel(ui: InteractionUiSchema): string | null {
  const label = ui.skipLabel;
  if (label == null) return null;
  return label;
}

/** JSON Schema 主类型(忽略 null 联合)。parseField 用于判断 integer。 */
export function getJsonSchemaPrimaryType(property: any): string {
  const propertyObj = property as UTSJSONObject | null;
  if (propertyObj == null) {
    return "string";
  }
  const typeValue = propertyObj["type"];
  if (Array.isArray(typeValue)) {
    const types = typeValue as string[];
    for (let i = 0; i < types.length; i++) {
      if (types[i] !== "null") {
        return types[i];
      }
    }
    return "string";
  }
  return orString(typeValue as any, "string");
}

export function extractMcpAskStructuredInputFromResult(
  result: any,
): UTSJSONObject | null {
  if (result == null || typeof result != "object") {
    return null;
  }
  const resultObj = result as UTSJSONObject;
  const data = resultObj["data"];
  if (!Array.isArray(data)) return null;

  for (let i = 0; i < data.length; i++) {
    const item = data[i];
    if (item == null || typeof item != "object") continue;
    const itemObj = item as UTSJSONObject;
    const contentRaw = itemObj["content"];
    if (contentRaw == null || typeof contentRaw != "object") continue;
    const content = contentRaw as UTSJSONObject;
    if (content["type"] != "text") continue;
    const text = content["text"];
    if (typeof text != "string") continue;

    const trimmed = text.trim();
    if (!trimmed.startsWith("{")) continue;

    try {
      const parsed = JSON.parse(text) as UTSJSONObject;
      const input = parsed["input"];
      if (input != null && typeof input == "object" && Array.isArray(input) == false) {
        const inputObj = input as UTSJSONObject;
        const keys = UTSJSONObject.keys(inputObj);
        if (keys.length > 0) {
          return inputObj;
        }
      }
    } catch (_) {
      // 非 JSON,跳过
    }
  }
  return null;
}

/**
 * 仅支持 v2:优先 schemaVersion,其次 ui.version 推断。非 v2 返回 null。
 */
function resolveSchemaVersion(record: UTSJSONObject): string | null {
  const schemaVersion = readField(record, "schemaVersion");
  if (
    typeof schemaVersion == "string" &&
    schemaVersion == MCP_ASK_SCHEMA_VERSION
  ) {
    return schemaVersion;
  }

  const uiRaw = readField(record, "ui");
  const ui = uiRaw != null ? asRecord(uiRaw) : null;
  const uiVersion = readField(ui, "version");
  if (
    typeof uiVersion == "string" &&
    uiVersion == INTERACTION_UI_SCHEMA_VERSION
  ) {
    return MCP_ASK_SCHEMA_VERSION;
  }

  const uiFields = readField(ui, "fields");
  const uiSchema = readField(ui, "schema");
  if (ui != null && Array.isArray(uiFields) && uiSchema == null) {
    return MCP_ASK_SCHEMA_VERSION;
  }

  return null;
}

export function parseMcpAskToolInput(raw: any): any | null {
  const parsedRaw = maybeParseRawInput(raw) as any;
  const recordObj = asRecord(parsedRaw);
  if (recordObj == null) return null;

  const schemaVersion = resolveSchemaVersion(recordObj);
  if (schemaVersion == null || schemaVersion.length == 0) return null;

  const toolName = orString(readField(recordObj, "toolName"), MCP_ASK_TOOL_NAME);
  if (toolName != MCP_ASK_TOOL_NAME) {
    return null;
  }

  const uiRaw = readField(recordObj, "ui");
  const ui = uiRaw != null ? asRecord(uiRaw) : null;
  const requestId = readField(recordObj, "requestId");
  if (
    typeof requestId != "string" ||
    requestId.length == 0 ||
    ui == null
  ) {
    return null;
  }

  const sessionId = readField(recordObj, "sessionId");
  if (sessionId != null && typeof sessionId != "string") {
    return null;
  }

  const revision = readField(recordObj, "revision");
  if (revision != null) {
    if (typeof revision != "number") {
      return null;
    }
    const revisionNum = revision as number;
    if (revisionNum <= 0) {
      return null;
    }
    if (Math.floor(revisionNum) != revisionNum) {
      return null;
    }
  }

  const title = readField(recordObj, "title");
  if (title != null && typeof title != "string") {
    return null;
  }

  const uiFields = readField(ui, "fields");
  const uiSteps = readField(ui, "steps");
  const hasFields = Array.isArray(uiFields) && uiFields.length > 0;
  const hasSteps = Array.isArray(uiSteps) && uiSteps.length > 0;
  if (hasFields == false && hasSteps == false) return null;

  recordObj["schemaVersion"] = schemaVersion;
  recordObj["toolName"] = toolName;
  return recordObj;
}

export function createMcpAskInteractionFromToolInput(
  rawInput: any,
  toolCallId: string | null = null,
): McpAskInteraction | null {
  const input = parseMcpAskToolInput(rawInput);
  if (input == null) return null;

  const inputObj = input as UTSJSONObject;
  // Android：禁止 UTSJSONObject as InteractionUiSchema
  const ui = createInteractionUiSchemaFromAny(readField(inputObj, "ui"));
  if (ui == null) {
    return null;
  }
  const interaction = new McpAskInteraction();
  interaction.toolName = orString(readField(inputObj, "toolName"), MCP_ASK_TOOL_NAME);
  interaction.schemaVersion = orString(
    readField(inputObj, "schemaVersion"),
    MCP_ASK_SCHEMA_VERSION,
  );
  interaction.requestId = orString(readField(inputObj, "requestId"), "");
  const revision = readField(inputObj, "revision");
  if (typeof revision == "number") {
    interaction.revision = revision;
  }
  interaction.sessionId = orEmpty(readField(inputObj, "sessionId"));
  interaction.toolCallId = toolCallId;
  const titleCandidates: (any | null)[] = [];
  titleCandidates.push(readField(inputObj, "title"));
  titleCandidates.push(ui.title);
  interaction.title = firstNullableString(titleCandidates);
  const description = readField(inputObj, "description");
  if (description != null && `${description}`.length > 0) {
    interaction.description = `${description}`;
  } else if (ui.description != null && `${ui.description}`.length > 0) {
    interaction.description = `${ui.description}`;
  } else {
    interaction.description = "";
  }
  interaction.ui = ui;
  interaction.responseStatus = "pending";
  interaction.triggeredAt = Date.now();
  return interaction;
}
