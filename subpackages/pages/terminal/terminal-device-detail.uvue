    padding: 8rpx 32rpx 0;
  }

  /* 模式选择 */
  .mode-row {
    display: flex;
    flex-direction: row;
    margin: 0 24rpx;

    .mode-btn {
      flex: 1;
      padding: 20rpx 0;
      border-radius: 16rpx;
      background-color: #ffffff;
      border: 2rpx solid #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 12rpx;
      transition: border-color 0.2s ease, background-color 0.2s ease;

      &:last-child {
        margin-right: 0;
      }

      &.mode-btn-on {
        border-color: #5147ff;
        background-color: rgba(81, 71, 255, 0.08);
      }

      .mode-btn-text {
        font-size: 26rpx;
        font-weight: 500;
        color: #666666;
        transition: color 0.2s ease;

        &.mode-btn-text-on {
          color: #5147ff;
          font-weight: 600;
        }
      }
    }
  }

  /* 记录入口 */
  .record-row {
    display: flex;
    flex-direction: row;
    margin: 24rpx 24rpx 0;

    .record-btn {
      flex: 1;
      padding: 20rpx 0;
      border-radius: 16rpx;
      background-color: #ffffff;
      border: 2rpx solid #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 16rpx;

      &:last-child {
        margin-right: 0;
      }

      &-active {
