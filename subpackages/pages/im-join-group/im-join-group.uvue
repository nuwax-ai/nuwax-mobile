<template>
  <!--
    加入群组页（原底部弹窗改整页，搜索页同款交互）：
    - 「群号：」前缀固定在输入框内左侧（不可编辑），输入区纯数字、数字键盘
    - 申请附言选填 ≤64 字（服务端上限），计数贴附言框内右下
    - 申请加入：POST /conversations/join {groupNo, remark}（PC 端同款）：
      免审批群直接入群，需审批群等群主同意；成功 toast 后返回——消息页 onShow
      会静默刷新会话列表（免审批群立即出现，替代原弹窗 joined 事件）
    - 入参 ?groupNo=：扫群名片码拉起时预填 19 位群号（仍可编辑，用户确认提交）
    - 非 tabBar 页：无需隐藏/恢复原生 tabBar，底部安全区由 footerStyle 内联兜底
  -->
  <view class="jg-page">
    <safety-zone />

    <!-- 顶部：返回 + 标题（群成员页同款页头） -->
    <view class="jg-header">
      <view class="jg-header__btn" hover-class="jg-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="jg-header__title-wrap">
        <text class="jg-header__title">{{ t("Mobile.Message.joinGroupTitle") }}</text>
      </view>
      <view class="jg-header__btn jg-header__btn--ghost" />
    </view>

    <view class="jg-body">
      <!-- 群号输入框：前缀固定框内左侧，输入区吃剩余宽 -->
      <view class="jg-no-box">
        <text class="jg-no-prefix">{{ t("Mobile.Message.joinGroupNoPrefix") }}</text>
        <input
          class="jg-no-input"
          v-model="groupNo"
          type="number"
          :maxlength="32"
          :placeholder="t('Mobile.Message.joinGroupNoPlaceholder')"
          placeholder-class="jg-ph"
        />
      </view>

      <view class="jg-label-row">
        <text class="jg-label">{{ t("Mobile.Message.joinGroupRemarkLabel") }}</text>
      </view>
      <!-- 附言框：计数贴框内右下，textarea 底部留出计数位 -->
      <view class="jg-remark-box">
        <textarea
          class="jg-remark-input"
          v-model="remark"
          :maxlength="64"
          :placeholder="t('Mobile.Message.joinGroupRemarkPlaceholder')"
          placeholder-class="jg-ph"
        />
        <text class="jg-remark-count">{{ remark.length }} / 64</text>
      </view>
    </view>

    <!-- 底部按钮：取消=返回，申请加入=提交后返回 -->
    <view class="jg-footer" :style="footerStyle">
      <view class="jg-btn" hover-class="jg-btn-cancel--active" @click="handleBack">
        <text class="jg-btn-text jg-btn-text--cancel">{{ t("Mobile.Common.cancel") }}</text>
      </view>
      <view
        class="jg-btn jg-btn--ok"
        :class="{ 'jg-btn--disabled': busy }"
        hover-class="jg-btn-ok--active"
        @click="handleSubmit"
      >
        <text class="jg-btn-text jg-btn-text--ok">{{ t("Mobile.Message.joinGroupSubmit") }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiResCode } from "@/utils/apiResponse";
  import { apiImJoinGroup } from "@/servers/im";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 群号（纯数字，契约 19 位；契约按字符串传输） */
  const groupNo = ref<string>("");
  /** 申请附言（选填 ≤64 字，服务端上限） */
  const remark = ref<string>("");
  /** 提交防重 */
  const busy = ref<boolean>(false);

  /**
   * 底部安全距离（同原底部弹窗版）：App 端样式表 env(safe-area-inset-bottom)
   * 不可靠，内联把底部内边距改为 24rpx 基础 + 系统安全区（px），按钮避开
   * iPhone home 条；H5/小程序走样式表 env()，不叠加。
   */
  const footerStyle = computed((): string => {
    let style = "";
    // #ifdef APP
    try {
      const win = uni.getWindowInfo();
      const scale = win.windowWidth / 750;
      const basePx = scale > 0 ? Math.round(24 * scale) : 24;
      style = `padding-bottom: ${basePx + win.safeAreaInsets.bottom}px;`;
    } catch (_e) {
      style = "";
    }
    // #endif
    return style;
  });

  /** 页面入参读取（容错解码：扫码预填的关键字可能带中文/特殊字符）。 */
  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  /** 群号格式：4~32 位纯数字（契约 19 位，测试环境可能更短；不用正则，手动循环保 Android 编译安全）。 */
  function isGroupNoValid(no: string): boolean {
    if (no.length < 4 || no.length > 32) {
      return false;
    }
    for (let i = 0; i < no.length; i++) {
      const c = no.charAt(i);
      if (c < "0" || c > "9") {
        return false;
      }
    }
    return true;
  }

  /**
   * 申请加入：校验群号后提交，成功 toast + 返回（消息页 onShow 静默刷新会话列表，
   * 免审批群立即出现——替代原弹窗的 joined 事件链路）。
   */
  async function handleSubmit(): Promise<void> {
    if (busy.value) {
      return;
    }
    const no = groupNo.value.trim();
    if (no.length == 0) {
      uni.showToast({ title: t("Mobile.Message.joinGroupNoRequired"), icon: "none" });
      return;
    }
    if (isGroupNoValid(no) != true) {
      uni.showToast({ title: t("Mobile.Message.joinGroupNoInvalid"), icon: "none" });
      return;
    }
    busy.value = true;
    try {
      const res = await apiImJoinGroup(no, remark.value.trim());
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.joinGroupFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Message.joinGroupSubmitted"), icon: "none" });
      uni.navigateBack({ delta: 1 });
    } catch (e) {
      uni.showToast({ title: t("Mobile.Message.joinGroupFailed"), icon: "none" });
    } finally {
      busy.value = false;
    }
  }

  function handleBack(): void {
    // 刷新后栈底保护：同搜索页，无页可退时切回消息 tab，避免整页重载死循环
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      uni.switchTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    // 扫群名片码预填：群号仍可编辑，用户确认后提交
    const no = readOption(options, "groupNo");
    if (no.length > 0) {
      groupNo.value = no;
    }
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架（白底，表单视觉与原底部弹窗一致） ===== */
  .jg-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #ffffff;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  .jg-header {
    flex-shrink: 0;
    height: 104rpx;
    padding: 0 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-bottom: 2rpx solid #eceaf1;
  }

  .jg-header__btn {
    width: 72rpx;
    height: 72rpx;
    border-radius: 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .jg-header__btn--active {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .jg-header__btn--ghost {
    background-color: rgba(0, 0, 0, 0);
  }

  .jg-header__title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .jg-header__title {
    max-width: 460rpx;
    font-size: 33rpx;
    line-height: 46rpx;
    font-weight: 600;
    color: #17171a;
  }

  .jg-body {
    flex: 1;
    min-height: 0;
    padding: 8rpx 32rpx 0;
  }

  /* 群号输入框：灰底圆角容器，「群号：」前缀固定框内左侧（不可编辑），输入区吃剩余宽 */
  .jg-no-box {
    margin-top: 20rpx;
    height: 80rpx;
    border-radius: 20rpx;
    background-color: #f6f5f8;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
  }

  .jg-no-prefix {
    margin: 0 12rpx 0 24rpx;
    color: #4b4b52;
    font-size: 28rpx;
    line-height: 40rpx;
    font-weight: 500;
    flex-shrink: 0;
  }

  .jg-no-input {
    flex: 1;
    height: 80rpx;
    padding-right: 24rpx;
    font-size: 28rpx;
    color: #1c1b20;
  }

  .jg-label-row {
    margin-top: 20rpx;
    margin-bottom: 12rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .jg-label {
    color: #4b4b52;
    font-size: 26rpx;
    line-height: 36rpx;
    font-weight: 500;
  }

  .jg-remark-box {
    position: relative;
  }

  /* 高度 160rpx：App 端原生 textarea 行盒偏高，120rpx 内容区仅 64rpx 会裁 placeholder 底部 */
  .jg-remark-input {
    width: 100%;
    height: 160rpx;
    padding: 16rpx 24rpx 40rpx;
    border-radius: 20rpx;
    background-color: #f6f5f8;
    font-size: 28rpx;
    color: #1c1b20;
    box-sizing: border-box;
  }

  .jg-remark-count {
    position: absolute;
    right: 24rpx;
    bottom: 12rpx;
    color: #b7b7be;
    font-size: 22rpx;
    line-height: 32rpx;
  }

  .jg-ph {
    color: #b7b7be;
    font-size: 26rpx;
  }

  /* ===== 底部按钮（按钮规范同原弹窗：取消=浅灰填充、主操作=品牌紫，无描边） ===== */
  .jg-footer {
    flex-shrink: 0;
    padding: 16rpx 32rpx 24rpx;
    /* #ifdef H5 || MP-WEIXIN */
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    /* #endif */
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
  }

  .jg-btn {
    min-width: 192rpx;
    height: 88rpx;
    padding: 0 32rpx;
    border-radius: 24rpx;
    background-color: #f2f1f7;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .jg-btn-cancel--active {
    background-color: #e8e7f0;
  }

  .jg-btn--ok {
    margin-left: 24rpx;
    background-color: #5147ff;
  }

  .jg-btn-ok--active {
    background-color: #4239e8;
  }

  .jg-btn--disabled {
    opacity: 0.55;
  }

  .jg-btn-text {
    font-size: 30rpx;
    line-height: 42rpx;
    font-weight: 500;
  }

  .jg-btn-text--cancel {
    color: #4b4b52;
  }

  .jg-btn-text--ok {
    color: #ffffff;
  }
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  /* #endif */
</style>
