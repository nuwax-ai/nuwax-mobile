/**
 * 数学公式渲染统一入口（uni-ai-x 插件）
 *
 * 把公式渲染的「模式开关 / action 选择 / 缓存 key / 单条渲染」收敛到插件，
 * 业务层（appMarkdownFallback 等）共享此模块，不再各自硬编码。
 *
 * 双轨：
 * - 'katex'   默认。katex + html2canvas 截 PNG（现有链路，全平台稳）
 * - 'mathjax' mathjax tex2svg → SVG data URI（矢量，省 html2canvas；App 端 native <image> 对 SVG 的支持需验证）
 *
 * 仅 App 端按 mode 切换；H5 始终走 katex resultHtml（DOM 直渲，无截图痛点）。
 */
import proxyWeb from './proxy-web.uts'

/** 公式渲染模式常量 */
export const MATH_MODE_KATEX = 'katex'
export const MATH_MODE_MATHJAX = 'mathjax'

/**
 * 公式渲染配置（单例）。切换模式只需改 mathRenderConfig.mode，运行时亦可切。
 */
export class MathRenderConfig {
  /**
   * 当前渲染模式：MATH_MODE_KATEX(默认) | MATH_MODE_MATHJAX
   */
  mode: string = MATH_MODE_KATEX
}
export const mathRenderConfig = new MathRenderConfig()

/** 当前是否 SVG(mathjax) 模式 */
export function isMathSvgMode(): boolean {
  return mathRenderConfig.mode == MATH_MODE_MATHJAX
}

/**
 * 选取公式渲染 action：App 按 mode 切换；H5 恒为 katex。
 * 与 proxy-web.html 的 onMessage 分发（katexRender / mathjaxSvgRender）一一对应。
 */
export function resolveMathAction(): string {
  // #ifdef APP
  if (isMathSvgMode()) {
    return 'mathjaxSvgRender'
  }
  // #endif
  return 'katexRender'
}

/**
 * 公式缓存 key 前缀：SVG(mathjax) 与 PNG(katex) 隔离，避免互相命中坏图。
 * mathjax → 'mjs'，katex → 'v2d'（与磁盘缓存 V3 对齐）。
 */
export function mathCacheKeyPrefix(): string {
  return isMathSvgMode() ? 'mjs' : 'v2d'
}

/**
 * 单条公式渲染入口：按 mathRenderConfig.mode 自动选 katex/mathjax，经 proxy-web 桥渲染。
 *
 * @param latex      纯 LaTeX 文本（勿预先折叠 \\）
 * @param displayMode true=块级(独占行)，false=行内
 * @param callback   收到 UTSJSONObject 结果：
 *                     App(katex): { imageDataURL: pngDataUrl, width, height }
 *                     App(mathjax): { imageDataURL: svgDataUrl, width, height }
 *                     H5:          { resultHtml: katexHtml }
 *                   失败时含 error 字段。
 */
export function renderMath(
  latex: string,
  displayMode: boolean,
  callback: (res: UTSJSONObject) => void,
): void {
  const param = new UTSJSONObject()
  param['action'] = resolveMathAction()
  param['pureMathText'] = latex
  param['displayMode'] = displayMode
  proxyWeb.callMethod(param, callback)
}
