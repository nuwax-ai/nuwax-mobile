/** Android 隐私授权：框架真实同意状态与协议版本必须同时满足。 */
// #ifdef APP-ANDROID
import { APP_PRIVACY_POLICY_VERSION } from "@/constants/appPrivacyPolicy";
export const APP_PRIVACY_VERSION = APP_PRIVACY_POLICY_VERSION;
// #endif
// #ifndef APP-ANDROID
export const APP_PRIVACY_VERSION = "";
// #endif
export const APP_PRIVACY_STORAGE_KEY = "nuwax_privacy_consent_version";
export const APP_PRIVACY_GRANTED_EVENT = "nuwax:privacy-consent-granted";

type AppPrivacyPreparedCallback = (accepted: boolean) => void;

let privacyGranted = false;
let privacyPrepared = false;
let privacyPreparing = false;
let privacyPreparedCallbacks: Array<AppPrivacyPreparedCallback> = [];

export function hasAppPrivacyConsent(): boolean {
  // #ifdef APP-ANDROID
  return privacyGranted;
  // #endif
  // #ifndef APP-ANDROID
  return true;
  // #endif
}

/** 首启/协议实质变更重新确认；普通版本升级、退出登录不清除授权。 */
function finishAppPrivacyPreparation(accepted: boolean): void {
  privacyGranted = accepted;
  privacyPrepared = true;
  privacyPreparing = false;
  const callbacks = privacyPreparedCallbacks;
  privacyPreparedCallbacks = [];
  for (let i = 0; i < callbacks.length; i++) {
    callbacks[i](accepted);
  }
}

/** 尽早查询框架真实授权状态；App.onLaunch 中的 prepare 调用会触发预热。 */
export function warmupAppPrivacyConsent(): void {
  // #ifdef APP-ANDROID
  if (privacyPrepared || privacyPreparing) return;
  privacyPreparing = true;
  const saved = uni.getStorageSync(APP_PRIVACY_STORAGE_KEY);
  const current = saved != null && `${saved}` == APP_PRIVACY_VERSION;
  if (!current) uni.resetPrivacyAuthorization();
  uni.getPrivacySetting({
    success: (res) => {
      finishAppPrivacyPreparation(current && !res.needAuthorization);
    },
    fail: (_err: any) => {
      finishAppPrivacyPreparation(false);
    },
  });
  // #endif
  // #ifndef APP-ANDROID
  finishAppPrivacyPreparation(true);
  // #endif
}

/** 首启/协议实质变更重新确认；普通版本升级、退出登录不清除授权。 */
export function prepareAppPrivacyConsent(done: (accepted: boolean) => void): void {
  // #ifdef APP-ANDROID
  if (privacyPrepared) {
    done(privacyGranted);
    return;
  }
  privacyPreparedCallbacks.push(done);
  warmupAppPrivacyConsent();
  // #endif
  // #ifndef APP-ANDROID
  done(true);
  // #endif
}

/** 仅在原生 agreePrivacyAuthorization 按钮触发真实授权之后记录。 */
export function completeAppPrivacyConsent(done: (accepted: boolean) => void): void {
  // #ifdef APP-ANDROID
  uni.getPrivacySetting({
    success: (res) => {
      if (res.needAuthorization) {
        done(false);
        return;
      }
      uni.setStorageSync(APP_PRIVACY_STORAGE_KEY, APP_PRIVACY_VERSION);
      finishAppPrivacyPreparation(true);
      done(true);
      uni.$emit(APP_PRIVACY_GRANTED_EVENT);
    },
    fail: (_err: any) => { done(false); },
  });
  // #endif
  // #ifndef APP-ANDROID
  done(true);
  // #endif
}
