<template>
  <view class="msg-root">
    <text v-if="msg.error_msg != null && msg.error_msg.length > 0" class="error-msg">
      {{ msg.error_msg }}
    </text>
    <template v-else>
      <!-- V2 整轮工作轨迹：思考 + 过程正文 + 工具组（折叠状态机见 setup trace* 段） -->
      <work-trace-container
        v-if="tracePresentation.hasTrace"
        :expanded="traceExpanded"
        :header-text="traceHeaderText"
        :running="traceRunning"
        :failed="tracePresentation.metrics.failed"
        @toggle="toggleTraceExpanded"
      >
        <view class="think-container" v-if="thinkContent.length > 0">
          <view class="think-header">
            <view class="think-header-left" @tap="changeThinkContent">
              <svg-icon name="icon-BulbOutlined" customClass="thinking-icon" />
              <text
                class="thinking-title"
                :class="{ 'shimmer-text': !isThinkingFinished }"
              >
                {{
                  isThinkingFinished
                    ? t("Mobile.Chat.thought")
                    : t("Mobile.Chat.thinking")
                }}
              </text>
              <!-- 完成态：思考时长（有锚才显示，历史消息无时长）；运行态：首行内容 ticker 贴尾跟随 -->
              <text
                v-if="isThinkingFinished && thinkDurationText.length > 0"
                class="think-duration"
              >· {{ thinkDurationText }}</text>
              <view
                v-else-if="!isThinkingFinished && thinkTickerText.length > 0"
                class="think-ticker"
              >
                <text class="think-ticker-dot">·</text>
                <scroll-view
                  class="think-ticker-scroll"
                  scroll-x
                  :scroll-left="thinkTickerScrollLeft"
                  scroll-with-animation
                >
                  <text class="think-ticker-text">{{ thinkTickerText }}</text>
                </scroll-view>
              </view>
              <text
                class="iconfont think-caret"
                :class="{ 'think-caret-open': !hideThinkContent }"
              >&#xe647;</text>
            </view>
          </view>
          <view
            v-if="shouldRenderThinkContent"
            class="think-content"
            :class="{ 'hide-think-content': hideThinkContent }"
          >
            <view class="text-box">
              <text
                v-if="thinkDisplayText.length > 0"
                class="think-plain-text"
                :selectable="true"
              >{{ thinkDisplayText }}</text>
            </view>
          </view>
        </view>
        <view
          v-for="renderItem in traceRenderItems"
          :key="renderItem.item.id"
        >
          <!-- #ifdef H5 || MP-WEIXIN -->
          <mp-html
            v-if="
              renderItem.item.kind == 'narration' ||
              renderItem.item.kind == 'openui'
            "
            :content="renderItem.content"
            :processing-list="renderProcessingList"
            :is-current-streaming="false"
            :conversation-id="mpHtmlConversationId"
            :markdown="true"
            :selectable="true"
            :container-style="'width: 100%;'"
            :tag-style="mpHtmlTagStyle"
            :scroll-table="true"
            :copy-link="false"
            @linktap="handleMpHtmlLinkTap"
          />
          <!-- #endif -->
          <!-- #ifdef APP -->
          <app-trace-markdown
            v-if="
              renderItem.item.kind == 'narration' ||
              renderItem.item.kind == 'openui'
            "
            :content="renderItem.content"
            :processing-list="renderProcessingList"
            :conversation-id="mpHtmlConversationId"
            :is-current-streaming="false"
            :is-app-details="isAppDetails"
          />
          <!-- #endif -->
          <tool-trace-group
            v-else-if="renderItem.item.kind == 'tool-group'"
            :rows-json="traceGroupRowsJson(renderItem.item)"
            :title="traceGroupTitle(renderItem.item)"
            :first-kind="traceGroupFirstKind(renderItem.item)"
            :status="renderItem.item.status"
            :expanded="traceGroupIsExpanded(renderItem.item, groupExpandedVersion)"
            :node-expanded-ids="traceExpandedNodeIds"
            @toggle="toggleTraceGroup(renderItem.item)"
            @toggle-node="toggleTraceNodeById"
          />
          <plan-trace-row
            v-else-if="renderItem.item.kind == 'plan'"
            :row="traceRowForChild(renderItem.item.row)"
            :expanded="traceNodeIsExpanded(renderItem.item.row)"
            @toggle="toggleTraceNode(renderItem.item.row)"
          />
          <tool-trace-row
            v-else-if="renderItem.item.kind == 'tool-row'"
            :row="traceRowForChild(renderItem.item.row)"
            :expanded="traceNodeIsExpanded(renderItem.item.row)"
            @toggle="toggleTraceNode(renderItem.item.row)"
          />
        </view>
      </work-trace-container>
      <!-- OpenUI 产物常显（对齐 PC OpenUiTraceNode）：轨迹收起态仍保持显示 -->
      <view
        v-if="tracePresentation.hasTrace && traceExpanded != true && openuiRenderItems.length > 0"
        class="openui-persistent"
      >
        <view v-for="renderItem in openuiRenderItems" :key="renderItem.item.id">
          <!-- #ifdef H5 || MP-WEIXIN -->
          <mp-html
            :content="renderItem.content"
            :processing-list="renderProcessingList"
            :is-current-streaming="false"
            :conversation-id="mpHtmlConversationId"
            :markdown="true"
            :selectable="true"
            :container-style="'width: 100%;'"
            :tag-style="mpHtmlTagStyle"
            :scroll-table="true"
            :copy-link="false"
            @linktap="handleMpHtmlLinkTap"
          />
          <!-- #endif -->
          <!-- #ifdef APP -->
          <app-trace-markdown
            :content="renderItem.content"
            :processing-list="renderProcessingList"
            :conversation-id="mpHtmlConversationId"
            :is-current-streaming="false"
            :is-app-details="isAppDetails"
          />
          <!-- #endif -->
        </view>
      </view>
      <!-- V2 最终回答：终态 outputText / 运行态实时末段正文，始终独立可见 -->
      <view class="answer-container">
        <!-- #ifdef H5 || MP-WEIXIN -->
        <mp-html
          v-if="finalAnswerContent.length > 0"
          :content="finalAnswerContent"
          :processing-list="renderProcessingList"
          :is-current-streaming="traceRunning"
          :conversation-id="mpHtmlConversationId"
          :markdown="true"
          :selectable="true"
          :container-style="'width: 100%;'"
          :tag-style="mpHtmlTagStyle"
          :scroll-table="true"
          :copy-link="false"
          @linktap="handleMpHtmlLinkTap"
        />
        <!-- #endif -->
        <!-- #ifdef APP -->
        <app-trace-markdown
          v-if="finalAnswerContent.length > 0"
          :content="finalAnswerContent"
          :processing-list="renderProcessingList"
          :is-current-streaming="traceRunning"
          :conversation-id="mpHtmlConversationId"
          :is-app-details="isAppDetails"
        />
        <!-- #endif -->
      </view>
    </template>
    <!-- APP：CSS animation 对 image 无效，用 transition 自转（1s/圈，对齐 H5） -->
    <!-- #ifdef APP -->
    <view v-if="showLoadingIcon" class="icon-loading-wrap">
      <spin-loading size="48rpx" color="#3bb346" :duration-ms="800" />
    </view>
    <!-- #endif -->
    <!-- #ifndef APP -->
    <image
      v-if="showLoadingIcon"
      class="icon-loading-image icon-loading-spin"
      src="@/static/assets/icon_loading.svg"
      :show-menu-by-longpress="false"
      @longtap.stop.prevent
      @contextmenu.stop.prevent="true"
      mode="widthFix"
    />
    <!-- #endif -->
    <msg-tool-bar
      v-if="shouldShowMsgToolBar"
      :msg="msg"
      :is-last-msg="isLastMsg"
      :speak-text="resolveSpeakableBodyText()"
      :enable-voice="enableVoice"
    />
  </view>
</template>

<script lang="uts" setup>
  import { MsgItem } from "@/types/interfaces/ai-msg";
  import type { UniAiMarkdownElItem } from "@/uni_modules/uni-ai-x/types.uts";
  import { ChatDataAdapter } from "@/utils/chatDataAdapter.uts";
  import msgToolBar from "@/subpackages/components/msg-tool-bar/msg-tool-bar.uvue";
  // #ifdef H5 || MP-WEIXIN
  import mpHtml from "@/subpackages/uni_modules/mp-html/components/mp-html/mp-html.vue";
  // #endif
  import {
    stripOpenUiActionIdMarker,
  } from "@/utils/openUiSchema.uts";
  // #ifdef APP
  import SpinLoading from "@/subpackages/components/spin-loading/spin-loading.uvue";
  import AppTraceMarkdown from "@/subpackages/components/ai-msg/app-trace-markdown.uvue";
  // #endif
  import { AiMsgMarkdownParser } from "@/subpackages/components/ai-msg/aiMsgMarkdownParser.uts";
  import { TaskStatus } from "@/types/enums/agent";
  import { useI18n, emptyI18nParams, toI18nParams } from "@/utils/i18n";
  import { groupMarkdownContainers } from "@/utils/markdown.uts";
  import { syncOpenUiProcessTagsWithProcessingList } from "@/utils/openUiMarkdown.uts";
  // #ifdef H5 || MP-WEIXIN
  import { replaceMathBracket } from "@/utils/markdown.uts";
  import { handleExternalLink } from "@/utils/system.uts";
  // #endif
  import { stripIncompleteCustomMarkupTail, stripOrphanCustomProcessGroupCloseTags } from "@/utils/markdownCustomProcess.uts";
  // #ifdef H5 || MP-WEIXIN
  import { replaceConversationDetailTags } from "@/utils/markdownCustomProcess.uts";
  // #endif
  import {
    stripMarkdownImages,
  } from "@/subpackages/components/ai-msg/markdownImage.uts";
  import {
    stripAgentInfoTags,
    stripAdaptedAgentInfoHtml,
  } from "@/subpackages/components/ai-msg/agentInfoTag.uts";
  import { onUnmounted } from "vue";
  // #ifdef APP
  import { perfRecordSseUi } from "@/utils/perfProbe.uts";
  // #endif
  import { toolCallProcessingListFingerprint } from "@/subpackages/utils/containerHelper.uts";
  import { applyThinkIncremental } from "@/subpackages/components/ai-msg/thinkIncrementalDisplay.uts";
  import {
    projectTurnTrace,
    formatElapsedParts,
    formatElapsedClock,
    TurnTraceInput,
    TraceItem,
    getRowsGroupStatus,
    toolGroupCountI18nKey,
    toolTraceActionI18nKey,
    type TurnTracePresentation,
  } from "@/subpackages/components/ai-msg/conversationTrace.uts";
  import WorkTraceContainer from "@/subpackages/components/work-trace/work-trace-container.uvue";
  import ToolTraceGroup from "@/subpackages/components/work-trace/tool-trace-group.uvue";
  import ToolTraceRow from "@/subpackages/components/work-trace/tool-trace-row.uvue";
  import PlanTraceRow from "@/subpackages/components/work-trace/plan-trace-row.uvue";
  import type { TraceToolRow } from "@/subpackages/components/ai-msg/conversationTrace.uts";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      /** 兼容开场白等旧调用；会话列表改走下方基础字段。 */
      msg?: any;
      /** 消息基础字段，避免模板热路径反复 MessageInfo → MsgItem。 */
      messageId?: string;
      messageStatus?: any;
      processingList?: any[];
      initialMarkdownElList?: any[];
      conversationId?: string;
      messageTime?: string;
      /** App 可靠通道：直接传字符串，避免 MsgItem 类实例 prop 丢字段 */
      bodyText?: string;
      thinkText?: string;
      /**
       * 会话 FINAL_RESULT（V2 轨迹投影用：最终回答 / 耗时 / 失败态）。
       * MessageInfo.finalResult 透传；流式中为空。
       */
      finalResult?: any;
      /**
       * 本轮用户消息时间（V2 轨迹运行耗时锚点，对齐 PC 1fa82c7433：
       * 与会话状态条同一起点=用户发送时刻；父层取 assistant 消息前最近 USER 消息 time）。
       */
      userMessageTime?: string;
      /**
       * 预计算可播报正文（MessageInfo.speakableText）。
       * 非空时工具栏直接播报，不再二次过滤。
       */
      speakableText?: string;
      // 会话是否正在进行中（有消息正在处理）
      isConversationActive?: boolean;
      taskStatus?: TaskStatus;
      // 是否是最后一条消息
      isLastMsg?: boolean;
      /** 是否显示复制、语音播报等消息工具栏。 */
      showToolBar?: boolean;
      /** 当前是否为应用详情会话，决定任务详情跳转页。 */
      isAppDetails?: boolean;
      /** 是否启用语音播报按钮（仅 App web-view 内嵌页为 true）。 */
      enableVoice?: boolean;
      /**
       * 历史消息懒解析：为 true 时挂载不立刻解析 markdown，
       * 等滚近视口（IntersectionObserver）再解析。仅 H5/WEB 生效。
       * 流式末条 / 非 H5 端不受影响（恒立即解析）。
       */
      deferParse?: boolean;
      /** 懒解析定位 key：对应父级消息包裹元素 id 后缀（`${id}_${index}`）。 */
      deferKey?: string;
    }>(),
    {
      msg: null,
      messageId: "",
      processingList: (): any[] => [] as any[],
      initialMarkdownElList: (): any[] => [] as any[],
      conversationId: "",
      messageTime: "",
      bodyText: "",
      thinkText: "",
      finalResult: null,
      userMessageTime: "",
      speakableText: "",
      showToolBar: true,
      isAppDetails: false,
      enableVoice: true,
      deferParse: false,
      deferKey: "",
    },
  );

  const emit = defineEmits<{
    changeThinkContent: [hideThinkContent: boolean];
  }>();

  /** 克隆 MsgItem（UTS 不支持 class spread；须先于 sync 定义） */
  function cloneMsgItem(source: MsgItem): MsgItem {
    const next = new MsgItem();
    next._id = source._id;
    next.body = source.body;
    next.thinkContent = source.thinkContent;
    next.from_uid = source.from_uid;
    next.state = source.state;
    next.create_time = source.create_time;
    next.about_msg_id = source.about_msg_id;
    next.chat_id = source.chat_id;
    next.markdownElList = source.markdownElList.slice();
    next.error_msg = source.error_msg;
    next.rendered = source.rendered;
    next.processingList = source.processingList;
    next.openuiArtifactId = source.openuiArtifactId;
    next.openuiTitle = source.openuiTitle;
    return next;
  }

  /** 将 patch 合并到 MsgItem（UTS 不支持 class 对象 spread） */
  function applyMsgPatch(target: MsgItem, patch: any): void {
    if (patch == null) return;
    const p = patch as UTSJSONObject;

    const bodyVal = p["body"];
    if (bodyVal != null) {
      target.body = `${bodyVal}`;
    } else {
      const textVal = p["text"];
      if (textVal != null) {
        target.body = `${textVal}`;
      }
    }

    const thinkVal = p["think"];
    if (thinkVal != null) {
      target.thinkContent = `${thinkVal}`;
    }
    const thinkContentVal = p["thinkContent"];
    if (thinkContentVal != null) {
      target.thinkContent = `${thinkContentVal}`;
    }

    const processingListVal = p["processingList"];
    if (processingListVal != null) {
      target.processingList = processingListVal as any[];
    }

    const stateVal = p["state"];
    if (stateVal != null) {
      target.state = stateVal as number;
    }
    const statusVal = p["status"];
    if (statusVal != null) {
      target.state = ChatDataAdapter.mapStatusToMsgState(statusVal);
    }
    const finishedVal = p["finished"];
    if (finishedVal == true) {
      target.state = 3;
    }

    const errorMsgVal = p["error_msg"];
    if (errorMsgVal != null) {
      target.error_msg = `${errorMsgVal}`;
    }

    const markdownElListVal = p["markdownElList"];
    if (markdownElListVal != null) {
      const converted = JSON.parseArray<UniAiMarkdownElItem>(
        JSON.stringify(markdownElListVal),
      );
      if (converted != null && converted.length > 0) {
        target.markdownElList = converted;
      }
    }

    const renderedVal = p["rendered"];
    if (renderedVal != null) {
      target.rendered = renderedVal as boolean;
    }

    const openuiArtifactIdVal = p["openuiArtifactId"];
    if (openuiArtifactIdVal != null) {
      target.openuiArtifactId = `${openuiArtifactIdVal}`;
    }
    const openuiTitleVal = p["openuiTitle"];
    if (openuiTitleVal != null) {
      target.openuiTitle = `${openuiTitleVal}`;
    }
  }

  // 内部响应式副本；App 上必须 watch props.msg，否则历史消息 body 可能一直为空
  const msg = ref<MsgItem>(new MsgItem());
  /** App 流式：强制触发正文 markdown / UniAiXMsgRender 失效 */
  const streamRevision = ref<number>(0);

  function mergeMsgFromProps(incoming: MsgItem): void {
    const cur = msg.value;
    if (incoming.body.length > cur.body.length) {
      cur.body = incoming.body;
    }
    if (incoming.thinkContent.length > cur.thinkContent.length) {
      cur.thinkContent = incoming.thinkContent;
    }
    cur.state = incoming.state;
    cur.processingList = incoming.processingList;
    if (incoming.openuiArtifactId.length > 0) {
      cur.openuiArtifactId = incoming.openuiArtifactId;
      cur.openuiTitle = incoming.openuiTitle;
    }
    if (incoming.error_msg.length > 0) {
      cur.error_msg = incoming.error_msg;
    }
    if (incoming.markdownElList.length > 0) {
      cur.markdownElList = incoming.markdownElList.slice();
    }
  }

  function syncMsgFromProps(source: any | null): void {
    if (source == null) {
      return;
    }
    const incoming = source as MsgItem;
    const incomingId = incoming._id;
    const sameId = incomingId.length > 0 && incomingId == msg.value._id;
    if (sameId) {
      mergeMsgFromProps(incoming);
    } else {
      msg.value = cloneMsgItem(incoming);
    }
  }

  /**
   * 合并 prop 与内部 msg 文本。
   * SSE 流式场景下 updateMessage 会先写入 msg.body，父级 bodyText prop 可能滞后；
   * 取较长者以保证打字机效果不被旧 prop 挡住。
   */
  function resolveBodyText(): string {
    const propText =
      props.bodyText != null && `${props.bodyText}`.length > 0
        ? `${props.bodyText}`
        : "";
    const msgBody =
      msg.value.body != null && `${msg.value.body}`.length > 0
        ? `${msg.value.body}`
        : "";
    if (msgBody.length >= propText.length) {
      return msgBody;
    }
    return propText.length > 0 ? propText : msgBody;
  }

  /** 工具标签规范化；未闭合自定义标签只剥真尾巴，完整图片留在原位。
   * OpenUI：同 executeId 去重，status 以 processingList（componentExecutedList）为最终态。
   */
  function resolveRenderableBodyText(): string {
    const grouped = groupMarkdownContainers(resolveBodyText());
    const list =
      msg.value.processingList != null
        ? (msg.value.processingList as any[])
        : null;
    const withOpenUiSync = syncOpenUiProcessTagsWithProcessingList(
      grouped,
      list,
    );
    return stripOpenUiActionIdMarker(
      stripMarkdownImages(
        stripAdaptedAgentInfoHtml(
          stripAgentInfoTags(
            stripOrphanCustomProcessGroupCloseTags(
              stripIncompleteCustomMarkupTail(withOpenUiSync),
            ),
          ),
        ),
      ),
    );
  }

  /**
   * 工具栏播报文本：优先 MessageInfo.speakableText（已清洗）。
   * 为空时返回 ""，由工具栏回落 body 再过滤一次。
   */
  function resolveSpeakableBodyText(): string {
    if (
      props.speakableText != null &&
      `${props.speakableText}`.trim().length > 0
    ) {
      return `${props.speakableText}`;
    }
    return "";
  }

  function resolveThinkText(): string {
    const propThink =
      props.thinkText != null && `${props.thinkText}`.length > 0
        ? `${props.thinkText}`
        : "";
    const msgThink =
      msg.value.thinkContent != null && `${msg.value.thinkContent}`.length > 0
        ? `${msg.value.thinkContent}`
        : "";
    if (msgThink.length >= propThink.length) {
      return msgThink;
    }
    return propThink.length > 0 ? propThink : msgThink;
  }

  const isLastMsg = computed((): boolean => props.isLastMsg == true);
  const isConversationActive = computed((): boolean => props.isConversationActive == true);
  const showToolBar = computed((): boolean => props.showToolBar == true);

  /**
   * 传给 mp-html / uni-ai-x-msg 的会话 ID。
   * 优先 msg.chat_id（conversationId watch 已写回），否则回退 props 并补 chat- 前缀，
   * 避免 openui-card 点击时 cid 为空 toast「无法打开 OpenUI」。
   */
  const mpHtmlConversationId = computed((): string => {
    const fromMsg =
      msg.value.chat_id != null && `${msg.value.chat_id}`.length > 0
        ? `${msg.value.chat_id}`
        : "";
    if (fromMsg.length > 0) {
      return fromMsg;
    }
    const fromProp =
      props.conversationId != null ? `${props.conversationId}` : "";
    if (fromProp.length == 0) {
      return "";
    }
    return fromProp.startsWith("chat-") ? fromProp : "chat-" + fromProp;
  });

  const showLoadingIcon = computed((): boolean => {
    // 会话级终态是 loading 的硬门禁。跨设备停止 / sub 断开时，
    // 父级 active 会先变 false，子组件内部 state 可能仍短暂停在 1；
    // 若 state=1 优先，就会在输入框已恢复后仍永久显示 loading。
    if (isConversationActive.value != true) {
      return false;
    }
    // 只有当前轮最后一条助手消息可显示 loading；
    // 避免新一轮开始时，历史上残留 state=1 的消息重新转圈。
    return isLastMsg.value == true;
  });

  /**
   * 流式 Markdown 解析：
   * - 纯文本：20ms 合并（对齐服务层 STREAM_UI_COALESCE_MS，接近逐字）
   * - 含公式/代码/表/工具：自适应合并窗（正文越长间隔越大）
   *   旧固定 80ms 对长 SSE 做全量 O(n) fallback → 累计 O(n²) 打满主线程后「卡顿停更」
   */
  const STREAM_MD_TEXT_INTERVAL_MS: number = 20;
  const STREAM_MD_STRUCT_INTERVAL_BASE_MS: number = 280;
  let streamMdParseTimer: number = 0;
  let streamMdParsePending: boolean = false;

  function clearStreamMdParseTimer(): void {
    if (streamMdParseTimer != 0) {
      clearTimeout(streamMdParseTimer);
      streamMdParseTimer = 0;
    }
    streamMdParsePending = false;
  }

  function bodyHasStructuralMarkup(body: string): boolean {
    return (
      body.indexOf("markdown-custom-process") >= 0 ||
      body.indexOf(":::container") >= 0 ||
      body.indexOf("<task-result") >= 0 ||
      body.indexOf("$") >= 0 ||
      body.indexOf("|") >= 0 ||
      body.indexOf("![") >= 0 ||
      body.indexOf("```") >= 0 ||
      body.indexOf("mermaid") >= 0
    );
  }

  /**
   * 结构化内容解析合并窗：随正文变长加大，压低全量 fallback 频率。
   * 含 `$` 公式时基线更高（Android KaTeX/WebView 桥极贵）。
   * 阈值：小于 2k→280ms；小于 8k→400ms；小于 20k→560ms；更长→720ms
   */
  function resolveStructParseIntervalMs(bodyLen: number): number {
    if (bodyLen < 2000) {
      return STREAM_MD_STRUCT_INTERVAL_BASE_MS;
    }
    if (bodyLen < 8000) {
      return 400;
    }
    if (bodyLen < 20000) {
      return 560;
    }
    return 720;
  }

  // 思考内容是否隐藏（默认隐藏）
  const hideThinkContent = ref<boolean>(true);

  /**
   * H5/小程序保留节点并通过动态 class 过渡；
   * App 原生端隐藏时卸载，避免 iOS 无法从 height: 0 恢复自动高度。
   */
  const shouldRenderThinkContent = computed((): boolean => {
    // #ifdef APP
    return !hideThinkContent.value;
    // #endif
    // #ifndef APP
    return true;
    // #endif
  });

  /** componentExecutedList 经历史适配后保存为 processingList，由工具调用组件渲染。 */
  const renderProcessingList = computed((): any[] => {
    // MsgItem 是 UTS class，Android 上替换 class 字段不一定被 Vue 深层追踪；
    // updateMessage/watch 每次都会递增 revision，以此显式使 PROCESSING 终态列表失效重算。
    const _rev = streamRevision.value;
    const list = msg.value.processingList;
    return list != null ? list : [] as any[];
  });

  const hasBodyOrText = computed((): boolean => {
    return resolveBodyText().trim().length > 0;
  });

  /**
   * 底部工具栏显隐。
   * 不以 msg.state / messageStatus 为准：SSE 中间段 CHAT 也可能 finished→complete，
   * 整轮结束以父组件 isConversationActive=false 为准（FINAL_RESULT / 流完成 / 停止 / 超时）。
   * - 历史消息（非最后一条）：有正文即显示
   * - 当前最后一条：仅会话结束后显示
   */
  const shouldShowMsgToolBar = computed((): boolean => {
    if (showToolBar.value != true) {
      return false;
    }
    if (hasBodyOrText.value != true) {
      return false;
    }
    // 流式输出 / loading 中不显示复制、语音播报
    if (showLoadingIcon.value == true) {
      return false;
    }
    if (isLastMsg.value == true && isConversationActive.value == true) {
      return false;
    }
    return true;
  });

  // 思考是否已完成：如果正文已经有内容，或者会话已结束，或者不是最后一条消息，则认为思考已完成
  const isThinkingFinished = computed((): boolean => {
    return (
      resolveBodyText().trim().length > 0 ||
      !isConversationActive.value ||
      !isLastMsg.value
    );
  });

  const markdownParser = new AiMsgMarkdownParser(
    msg,
    streamRevision,
    resolveRenderableBodyText,
    (): boolean => isConversationActive.value,
    (): boolean => isLastMsg.value,
  );

  function runBodyMarkdownParseNow(forceDone: boolean): void {
    clearStreamMdParseTimer();
    // App：始终立即 parse。磁盘缓存命中可直接出图，不必再等 proxyWeb（历史长公式页可省约 1s）；
    // 未命中公式由 flushMathJobs 在 proxy 就绪后再截图，占位过渡即可。
    // 注意：parser.applyAppFallback / bumpRevision 已会抬 streamRevision，此处勿再 bump，
    // 避免一次 parse 触发 2～3 次整树失效。
    markdownParser.runMarkdownParse(forceDone);
  }

  // #ifdef H5 || WEB
  /**
   * 历史消息懒解析：deferParse 消息挂载时先不解析，等滚近视口（含 300px 提前量）
   * 再解析。大历史会话首屏只解析视口内消息，避免全量 markdown 解析阻塞主线程。
   * 实现：模块级注册表 + document scroll 捕获监听 + getBoundingClientRect 判可见
   * （不用 IntersectionObserver，规避 UTS 对浏览器构造器类型的依赖）。
   */
  interface LazyMarkdownEntry {
    el: any;
    done: boolean;
    cb: () => void;
  }
  const LAZY_VIEWPORT_BUFFER: number = 300;
  let lazyMarkdownRegistry: LazyMarkdownEntry[] = [] as LazyMarkdownEntry[];
  let lazyScrollBound = false;
  let lazyCheckTimer: number = 0;
  /** 懒解析已完成（含兜底立即解析），避免 body 未变时反复注册。 */
  let lazyMarkdownDone = false;
  /** 本组件是否已注册（卸载时按此移除）。 */
  let lazyMarkdownRegistered = false;
  let lazyMarkdownRegisteredEl: any = null;

  function checkLazyMarkdownVisibility(): void {
    const w = window as any;
    const vh = w != null && w.innerHeight != null ? (w.innerHeight as number) : 800;
    const remaining: LazyMarkdownEntry[] = [] as LazyMarkdownEntry[];
    const list = lazyMarkdownRegistry;
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      if (item == null || item.done == true || item.el == null) {
        continue;
      }
      try {
        const rect = item.el.getBoundingClientRect() as any;
        if (rect != null && rect.top < vh + LAZY_VIEWPORT_BUFFER && rect.bottom > -LAZY_VIEWPORT_BUFFER) {
          item.done = true;
          item.cb();
        } else {
          remaining.push(item);
        }
      } catch (_eRect) {
        item.done = true;
        item.cb();
      }
    }
    lazyMarkdownRegistry = remaining;
  }

  function onLazyMarkdownScroll(): void {
    if (lazyCheckTimer != 0) {
      return;
    }
    lazyCheckTimer = setTimeout((): void => {
      lazyCheckTimer = 0;
      checkLazyMarkdownVisibility();
    }, 60) as number;
  }

  function ensureLazyMarkdownScrollListener(): void {
    if (lazyScrollBound == true) {
      return;
    }
    lazyScrollBound = true;
    try {
      const w = window as any;
      if (w != null && w.document != null && w.document.addEventListener != null) {
        // capture=true：捕获到任意滚动容器（含消息 scroll-view）的 scroll 事件
        w.document.addEventListener("scroll", onLazyMarkdownScroll, true);
      }
    } catch (_eBound) {
      // ignore
    }
  }

  function teardownLazyMarkdownParse(): void {
    if (lazyMarkdownRegistered == true) {
      const el = lazyMarkdownRegisteredEl;
      const list = lazyMarkdownRegistry;
      const next: LazyMarkdownEntry[] = [] as LazyMarkdownEntry[];
      for (let i = 0; i < list.length; i++) {
        const item = list[i];
        if (item == null || item.el == el) {
          continue;
        }
        next.push(item);
      }
      lazyMarkdownRegistry = next;
      lazyMarkdownRegistered = false;
      lazyMarkdownRegisteredEl = null;
    }
  }

  function finishLazyMarkdownParse(): void {
    lazyMarkdownDone = true;
    teardownLazyMarkdownParse();
    runBodyMarkdownParseNow(true);
  }

  function setupLazyMarkdownParse(): void {
    if (lazyMarkdownRegistered == true) {
      return;
    }
    try {
      const w = window as any;
      if (w == null || w.document == null || w.document.getElementById == null) {
        finishLazyMarkdownParse();
        return;
      }
      const key = `${props.deferKey}`;
      if (key.length == 0) {
        finishLazyMarkdownParse();
        return;
      }
      const rootEl = w.document.getElementById(`msg-wrapper-${key}`);
      if (rootEl == null) {
        // 包裹元素未就绪：立即解析兜底，避免消息一直空白
        finishLazyMarkdownParse();
        return;
      }
      lazyMarkdownRegisteredEl = rootEl;
      lazyMarkdownRegistered = true;
      lazyMarkdownRegistry.push({
        el: rootEl,
        done: false,
        cb: (): void => finishLazyMarkdownParse(),
      } as LazyMarkdownEntry);
      ensureLazyMarkdownScrollListener();
      // 已可见的消息（如首屏底部几条）立即解析，不必等滚动
      checkLazyMarkdownVisibility();
    } catch (_eObs) {
      finishLazyMarkdownParse();
    }
  }
  // #endif

  /** 合并高频 chunk 后解析：intervalMs 合并窗内多次调用只解析一次 */
  function scheduleMergedParse(intervalMs: number): void {
    streamMdParsePending = true;
    if (streamMdParseTimer != 0) {
      return;
    }
    streamMdParseTimer = setTimeout(() => {
      streamMdParseTimer = 0;
      if (streamMdParsePending == false) {
        return;
      }
      streamMdParsePending = false;
      markdownParser.runMarkdownParse(false);
    }, intervalMs);
  }

  /** 流式：合并高频 chunk 后再解析；非流式：立即解析；首帧无结果时立即解析 */
  function scheduleBodyMarkdownParse(): void {
    // #ifdef APP
    // App 已由 V2 分段渲染器解析轨迹与最终回答，避免旧整段解析器重复工作。
    return;
    // #endif
    const streaming =
      isConversationActive.value == true && isLastMsg.value == true;
    if (streaming == false) {
      runBodyMarkdownParseNow(true);
      return;
    }
    // 首帧立刻出字，避免空白等节流
    if (markdownParser.resolveRenderList().length == 0) {
      runBodyMarkdownParseNow(false);
      return;
    }
    const body = resolveRenderableBodyText();
    if (bodyHasStructuralMarkup(body) == true) {
      scheduleMergedParse(resolveStructParseIntervalMs(body.length));
      return;
    }
    scheduleMergedParse(STREAM_MD_TEXT_INTERVAL_MS);
  }

  const renderMarkdownElList = computed((): UniAiMarkdownElItem[] => {
    const _rev = streamRevision.value;
    return markdownParser.resolveRenderList();
  });

  // #ifdef H5 || MP-WEIXIN
  /**
   * H5/小程序：mp-html 渲染正文（对齐 dev 的 markdown-msg / uni-ai-x-msg 做法）。
   * 复用 resolveRenderableBodyText 清洗链路（剥 agent-info、未闭合自定义标记尾部，
   * 保留完整图片语法交由 mp-html 原位渲染），再 replaceMathBracket 把 \\( \\) \\[ \\]
   * 公式定界符转成 $ / $$，供 mp-html 的 latex 插件解析。
   */
  /**
   * 工具卡 name 属性值内的换行清洗（仅 H5/mp-html 渲染前）：
   * name 常含 `$(cat <<'EOF'\n...` 等多行命令，换行/空行会让 markdown-it 把
   * 属性值中间的 \n\n 当段落分隔、注入 <p> 破坏 HTML 标签闭合 → 该卡之后
   * （总结文本/表格/task-result）全部被 mp-html 解析吞掉。换行统一压成空格。
   */
  function sanitizeMpHtmlProcessNameNewlines(html: string): string {
    if (html.length == 0 || html.indexOf("<markdown-custom-process") < 0) {
      return html;
    }
    const re = /<markdown-custom-process\s([^>]*?)\bname="([^"]*)"([^>]*)>/g;
    return html.replace(
      re,
      (
        match: string,
        beforeName: string,
        name: string,
        afterName: string,
      ): string => {
        const cleaned = name.replace(/\n+/g, " ").replace(/\r/g, "").trim();
        return `<markdown-custom-process ${beforeName}name="${cleaned}"${afterName}>`;
      },
    );
  }

  /** 会话详情页路径：应用智能体与普通智能体的历史会话入口不同。 */
  const conversationDetailPagePath = (): string => {
    return props.isAppDetails == true
      ? "/subpackages/pages/app-details/app-details"
      : "/subpackages/pages/agent-detail/agent-detail";
  };

  const mpHtmlContent = computed((): string => {
    const _rev = streamRevision.value;
    // mp-html 的 trustTags 不含 conversation，未转链接会被降级成空 span 而整段丢失
    const withConversationLink = replaceConversationDetailTags(
      resolveRenderableBodyText(),
      conversationDetailPagePath(),
      t("Mobile.Chat.viewTaskDetails"),
    );
    return replaceMathBracket(
      sanitizeMpHtmlProcessNameNewlines(withConversationLink),
    );
  });
  // #endif

  // =========================================================================
  // V2 整轮工作轨迹（对齐 PC presentation-v2）：
  // 投影（conversationTrace.uts 纯函数）→ 折叠状态机（本组件托管）→ work-trace 组件树。
  // =========================================================================

  /** V2 轨迹渲染项：trace item + 平台渲染器共用的预清洗 content。 */
  class TraceRenderItem {
    item: TraceItem = new TraceItem();
    content: string = "";
  }

  /** 当前轮是否流式运行中（与旧链路 isCurrentStreaming 同门控）。 */
  const traceRunning = computed((): boolean => {
    return isConversationActive.value == true && isLastMsg.value == true;
  });

  const tracePresentation = computed((): TurnTracePresentation => {
    const _rev = streamRevision.value;
    const input = new TurnTraceInput();
    input.bodyText = resolveBodyText();
    input.thinkText = resolveThinkText();
    input.processingList = msg.value.processingList;
    input.finalResult = props.finalResult;
    input.running = traceRunning.value;
    input.messageKey =
      msg.value._id.length > 0 ? msg.value._id : "msg";
    return projectTurnTrace(input);
  });

  /** 段级清洗：与旧 mpHtmlContent 同链，但不做 groupMarkdownContainers（投影已消费分组）。 */
  function sanitizeTraceSegment(raw: string): string {
    const withOpenUiSync = syncOpenUiProcessTagsWithProcessingList(
      raw,
      msg.value.processingList != null
        ? (msg.value.processingList as any[])
        : null,
    );
    const cleaned = stripOpenUiActionIdMarker(
      stripMarkdownImages(
        stripAdaptedAgentInfoHtml(
          stripAgentInfoTags(
            stripOrphanCustomProcessGroupCloseTags(
              stripIncompleteCustomMarkupTail(withOpenUiSync),
            ),
          ),
        ),
      ),
    );
    // #ifdef H5 || MP-WEIXIN
    const withConversationLink = replaceConversationDetailTags(
      cleaned,
      conversationDetailPagePath(),
      t("Mobile.Chat.viewTaskDetails"),
    );
    return replaceMathBracket(
      sanitizeMpHtmlProcessNameNewlines(withConversationLink),
    );
    // #endif
    // #ifdef APP
    return cleaned;
    // #endif
  }

  /**
   * 预计算渲染项（避免模板函数每帧重算）。
   * 运行态末段正文已被提升为实时回答区，轨迹内 narration / openui 段均为稳定段
   * （content 不再变化，mp-html 不重复解析）。
   */
  const traceRenderItems = computed((): TraceRenderItem[] => {
    const items = tracePresentation.value.items;
    const out: TraceRenderItem[] = [] as TraceRenderItem[];
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      const render = new TraceRenderItem();
      render.item = item;
      if (item.kind == "narration" || item.kind == "openui") {
        render.content = sanitizeTraceSegment(item.text);
      }
      out.push(render);
    }
    return out;
  });

  /** 最终回答区（终态 outputText / 运行态实时末段正文）。 */
  const finalAnswerContent = computed((): string => {
    const raw = tracePresentation.value.finalAnswerText;
    if (raw.length == 0) return "";
    return sanitizeTraceSegment(raw);
  });

  // ---- 折叠状态机（对齐 PC WorkTraceDisclosure，全部托管在本组件实例）----

  /** 未手动干预时跟随默认（运行展开 / 终态收起）；UTS 无 ref<boolean|null>，拆双值。 */
  const traceManualTouched = ref<boolean>(false);
  const traceManualExpandedValue = ref<boolean>(false);
  /** 轨迹收起态常显的 OpenUI 产物（对齐 PC OpenUiTraceNode：收起态保持显示）。 */
  const openuiRenderItems = computed((): TraceRenderItem[] => {
    const items = traceRenderItems.value;
    const out: TraceRenderItem[] = [] as TraceRenderItem[];
    for (let i = 0; i < items.length; i++) {
      if (items[i].item.kind == "openui") {
        out.push(items[i]);
      }
    }
    return out;
  });

  const traceExpanded = computed((): boolean => {
    return traceManualTouched.value
      ? traceManualExpandedValue.value
      : traceRunning.value;
  });

  function toggleTraceExpanded(): void {
    traceManualTouched.value = true;
    traceManualExpandedValue.value = traceExpanded.value != true;
  }

  const traceNow = ref<number>(Date.now());
  let traceTimerId: number = 0;
  /** 无任何工具 startTime 时的运行锚点兜底（首次进入 running 记录）。 */
  let traceAnchorFallback: number = 0;

  function startTraceTimer(): void {
    if (traceTimerId != 0) return;
    traceTimerId = setInterval((): void => {
      traceNow.value = Date.now();
    }, 1000) as number;
  }

  function stopTraceTimer(): void {
    if (traceTimerId != 0) {
      clearInterval(traceTimerId);
      traceTimerId = 0;
    }
  }

  watch(
    (): boolean => traceRunning.value,
    (running: boolean) => {
      if (running == true) {
        if (traceAnchorFallback <= 0) {
          traceAnchorFallback = Date.now();
        }
        startTraceTimer();
      } else {
        stopTraceTimer();
        // 运行 → 终态：自动收起一次；用户此后可手动展开并保持
        traceManualTouched.value = false;
        traceManualExpandedValue.value = false;
      }
    },
    { immediate: true },
  );

  onUnmounted(() => {
    stopTraceTimer();
  });

  /** 组展开状态 map：无值 = 跟随默认（活动组展开）；version 驱动模板重算。 */
  const groupExpandedVersion = ref<number>(0);
  let groupExpandedMap: Map<string, boolean> = new Map();
  let previousActiveGroups: Set<string> = new Set();
  let autoCollapsedGroups: Set<string> = new Set();

  const activeGroupKey = computed((): string => {
    const items = tracePresentation.value.items;
    let key = "";
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      if (item.kind == "tool-group" && item.active) {
        key = key.length == 0 ? item.id : key + "|" + item.id;
      }
    }
    return key;
  });

  /** 旧活动组失去 active 时自动收起一次；用户手动重开后不再被强制关闭。 */
  watch(
    (): string => activeGroupKey.value,
    (key: string) => {
      const current: Set<string> = new Set();
      if (key.length > 0) {
        const parts = key.split("|");
        for (let i = 0; i < parts.length; i++) {
          current.add(parts[i]);
        }
      }
      let changed = false;
      previousActiveGroups.forEach((groupId: string) => {
        if (
          current.has(groupId) != true &&
          autoCollapsedGroups.has(groupId) != true
        ) {
          groupExpandedMap.set(groupId, false);
          autoCollapsedGroups.add(groupId);
          changed = true;
        }
      });
      previousActiveGroups = current;
      if (changed) {
        groupExpandedVersion.value = groupExpandedVersion.value + 1;
      }
    },
  );

  function traceGroupIsExpanded(item: TraceItem, _version: number = groupExpandedVersion.value): boolean {
    const manual = groupExpandedMap.get(item.id);
    return manual != null ? manual : item.active;
  }

  function toggleTraceGroup(item: TraceItem): void {
    const current = traceGroupIsExpanded(item);
    groupExpandedMap.set(item.id, !current);
    groupExpandedVersion.value = groupExpandedVersion.value + 1;
  }

  // 行内联详情展开（第三层，对齐 PC nodeExpanded）：默认收起，点击行展开；
  // 版本号驱动模板重算；外层收起不清空（组件实例托管）。
  // 待办卡（kind=todo）例外（对齐 PC TodoTraceNode）：运行中默认展开、
  // 结束自动收起一次、历史收起——默认值随行运行态，手动值优先。
  let nodeExpandedMap: Map<string, boolean> = new Map();
  const nodeExpandedVersion = ref<number>(0);
  let previousRunningTodoNodes: Set<string> = new Set();
  let autoCollapsedTodoNodes: Set<string> = new Set();

  function traceNodeIsExpanded(row: TraceToolRow | null): boolean {
    const _v = nodeExpandedVersion.value;
    if (row == null) return false;
    const manual = nodeExpandedMap.get(row.id);
    if (manual != null) return manual;
    return row.kind == "todo" && row.status == "running";
  }

  function toggleTraceNode(row: TraceToolRow | null): void {
    if (row == null) return;
    const current = traceNodeIsExpanded(row);
    nodeExpandedMap.set(row.id, !current);
    nodeExpandedVersion.value = nodeExpandedVersion.value + 1;
  }

  /**
   * Android UTS 的跨组件 class props 会丢失字段元数据；序列化成 plain
   * UTSJSONObject 再交给纯展示子组件，避免 TraceItem/TraceToolRow 强转崩溃。
   */
  function traceRowDto(row: TraceToolRow): UTSJSONObject {
    const dto = new UTSJSONObject();
    dto["id"] = row.id;
    dto["kind"] = row.kind;
    dto["status"] = row.status;
    dto["name"] = row.name;
    dto["componentType"] = row.componentType;
    dto["processing"] = row.processing;
    dto["target"] = row.target;
    dto["meta"] = row.meta;
    dto["isCreate"] = row.isCreate;
    dto["fileCount"] = row.fileCount;
    dto["files"] = row.files;
    dto["planSteps"] = row.planSteps;
    return dto;
  }

  function traceGroupRowsJson(item: TraceItem): string {
    const rows: UTSJSONObject[] = [] as UTSJSONObject[];
    for (let i = 0; i < item.rows.length; i++) {
      rows.push(traceRowDto(item.rows[i]));
    }
    return JSON.stringify(rows);
  }

  function traceGroupFirstKind(item: TraceItem): string {
    return item.rows.length > 0 ? item.rows[0].kind : "generic";
  }

  function traceGroupTitle(item: TraceItem): string {
    const rows = item.rows;
    const kinds: string[] = [] as string[];
    for (let i = 0; i < rows.length; i++) {
      if (kinds.indexOf(rows[i].kind) < 0) kinds.push(rows[i].kind);
    }
    let title = "";
    for (let i = 0; i < kinds.length; i++) {
      const kind = kinds[i];
      const matching: TraceToolRow[] = [] as TraceToolRow[];
      let allCreate = true;
      for (let j = 0; j < rows.length; j++) {
        if (rows[j].kind == kind) {
          matching.push(rows[j]);
          if (rows[j].isCreate != true) allCreate = false;
        }
      }
      if (matching.length == 0) continue;
      const status = getRowsGroupStatus(matching);
      let label = "";
      if (status == "running") {
        label = t(toolTraceActionI18nKey(kind, status, kind == "file-edit" && allCreate));
      } else {
        const params = new Map<string, string | number>();
        params.set("count", matching.length);
        label = tFn(
          toolGroupCountI18nKey(kind, kind == "file-edit" && allCreate),
          toI18nParams(params),
          "",
        );
      }
      if (label.length > 0) title = title.length == 0 ? label : title + " · " + label;
    }
    return title.length > 0 ? title : t("Mobile.ThirdParty.MpHtml.toolCall");
  }

  function traceRowForChild(row: TraceToolRow | null): UTSJSONObject | null {
    if (row == null) return null;
    return JSON.parseObject(JSON.stringify(traceRowDto(row)));
  }

  const traceExpandedNodeIds = computed((): string => {
    const _v = nodeExpandedVersion.value;
    let ids = "|";
    const items = tracePresentation.value.items;
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      if (item.row != null && traceNodeIsExpanded(item.row)) {
        ids = ids + item.row!.id + "|";
      }
      for (let j = 0; j < item.rows.length; j++) {
        if (traceNodeIsExpanded(item.rows[j])) {
          ids = ids + item.rows[j].id + "|";
        }
      }
    }
    return ids;
  });

  function toggleTraceNodeById(id: string): void {
    const current = nodeExpandedMap.get(id);
    nodeExpandedMap.set(id, current == null ? true : !current);
    nodeExpandedVersion.value = nodeExpandedVersion.value + 1;
  }

  const runningTodoKey = computed((): string => {
    const items = tracePresentation.value.items;
    let key = "";
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      const row = item.row;
      if (
        item.kind == "plan" &&
        row != null &&
        row!.kind == "todo" &&
        row!.status == "running"
      ) {
        key = key.length == 0 ? row!.id : key + "|" + row!.id;
      }
      for (let j = 0; j < item.rows.length; j++) {
        const child = item.rows[j];
        if (child.kind == "todo" && child.status == "running") {
          key = key.length == 0 ? child.id : key + "|" + child.id;
        }
      }
    }
    return key;
  });

  /** 待办卡运行结束自动收起一次（对齐 PC TodoTraceNode useEffect）。 */
  watch(
    (): string => runningTodoKey.value,
    (key: string) => {
      const current: Set<string> = new Set();
      if (key.length > 0) {
        const parts = key.split("|");
        for (let i = 0; i < parts.length; i++) {
          current.add(parts[i]);
        }
      }
      let changed = false;
      previousRunningTodoNodes.forEach((rowId: string) => {
        if (
          current.has(rowId) != true &&
          autoCollapsedTodoNodes.has(rowId) != true
        ) {
          nodeExpandedMap.set(rowId, false);
          autoCollapsedTodoNodes.add(rowId);
          changed = true;
        }
      });
      previousRunningTodoNodes = current;
      if (changed) {
        nodeExpandedVersion.value = nodeExpandedVersion.value + 1;
      }
    },
  );

  /** 消息切换（复用组件实例）时重置全部轨迹状态。 */
  function resetTraceFoldState(): void {
    traceManualTouched.value = false;
    traceManualExpandedValue.value = false;
    groupExpandedMap = new Map();
    previousActiveGroups = new Set();
    autoCollapsedGroups = new Set();
    groupExpandedVersion.value = groupExpandedVersion.value + 1;
    nodeExpandedMap = new Map();
    previousRunningTodoNodes = new Set();
    autoCollapsedTodoNodes = new Set();
    nodeExpandedVersion.value = nodeExpandedVersion.value + 1;
    traceAnchorFallback = 0;
    traceNow.value = Date.now();
    stopTraceTimer();
  }

  function formatTraceElapsed(ms: number): string {
    const parts = formatElapsedParts(ms);
    if (parts.length == 0) return "";
    return parts
      .replace("{h}", t("Mobile.Chat.WorkTrace.timeHour"))
      .replace("{m}", t("Mobile.Chat.WorkTrace.timeMinute"))
      .replace("{s}", t("Mobile.Chat.WorkTrace.timeSecond"));
  }

  /** 运行耗时时钟（MM:SS，对齐 PC formatElapsedClock / V1 状态条形态）。 */
  function formatTraceClock(ms: number): string {
    return formatElapsedClock(ms);
  }

  /** 解析本轮用户消息时间 prop（无效/未传返回 0）。 */
  function resolveUserMessageTimeMs(): number {
    const raw = props.userMessageTime;
    if (raw == null) return 0;
    const text = `${raw}`.trim();
    if (text.length == 0) return 0;
    const parsed = new Date(text).getTime();
    // NaN 判定（UTS 无 isNaN）
    if (parsed != parsed) return 0;
    return parsed as number;
  }

  /**
   * 运行态耗时（锚点对齐 PC 1fa82c7433）：本轮用户消息时间 > 工具最早开始时间 > 首次进入 running 的本地时间。
   * 终态文案不变（finalResult start/end 或工具 min/max）。
   */
  const traceElapsedText = computed((): string => {
    const metrics = tracePresentation.value.metrics;
    if (traceRunning.value == true) {
      const userTimeMs = resolveUserMessageTimeMs();
      let anchor = -1;
      if (userTimeMs > 0) {
        anchor = userTimeMs;
      } else if (metrics.elapsedAnchorMs > 0) {
        anchor = metrics.elapsedAnchorMs;
      } else {
        anchor = traceAnchorFallback;
      }
      if (anchor > 0) {
        return formatTraceClock(traceNow.value - anchor);
      }
      return "";
    }
    if (metrics.elapsedMs >= 0) {
      return formatTraceElapsed(metrics.elapsedMs);
    }
    return "";
  });

  /** 轨迹头：运行「工作中 T」；终态「N 次工具调用 · 已工作 T」；无指标兜底「执行过程」。 */
  const traceHeaderText = computed((): string => {
    if (traceRunning.value == true) {
      if (traceElapsedText.value.length == 0) {
        return t("Mobile.Chat.WorkTrace.traceTitleProcessOnly");
      }
      const p = new Map<string, string | number>();
      p.set("time", traceElapsedText.value);
      return tFn("Mobile.Chat.WorkTrace.traceMetricRunning", toI18nParams(p), "");
    }
    const metrics = tracePresentation.value.metrics;
    let text = "";
    if (metrics.toolCount > 0) {
      const p = new Map<string, string | number>();
      p.set("count", metrics.toolCount);
      text = tFn("Mobile.Chat.WorkTrace.traceMetricTools", toI18nParams(p), "");
    }
    if (traceElapsedText.value.length > 0) {
      const p = new Map<string, string | number>();
      p.set("time", traceElapsedText.value);
      const elapsedText = tFn(
        "Mobile.Chat.WorkTrace.traceMetricElapsed",
        toI18nParams(p),
        "",
      );
      text = text.length > 0 ? text + " · " + elapsedText : elapsedText;
    }
    if (text.length == 0) {
      return t("Mobile.Chat.WorkTrace.traceTitleProcessOnly");
    }
    return text;
  });
  // #ifdef H5 || MP-WEIXIN
  /** 长文本换行，避免 mp-html 内 p/li/div/span 换行失效（对齐 dev tag-style）。 */
  const mpHtmlTagStyle = {
    p: "word-break: break-all; overflow-wrap: break-word;",
    li: "word-break: break-all; overflow-wrap: break-word;",
    div: "word-break: break-all; overflow-wrap: break-word;",
    span: "word-break: break-all; overflow-wrap: break-word;",
  };

  /** 从 linktap 事件或 event.detail 读取字符串字段。 */
  const readLinkTapField = (eventObj: UTSJSONObject, key: string): string => {
    const detailRaw = eventObj["detail"];
    if (detailRaw != null) {
      const detailObj = detailRaw as UTSJSONObject;
      const inDetail = detailObj[key];
      if (inDetail != null) {
        const text = `${inDetail}`.trim();
        if (text.length > 0) {
          return text;
        }
      }
    }
    const direct = eventObj[key];
    if (direct != null) {
      const text = `${direct}`.trim();
      if (text.length > 0) {
        return text;
      }
    }
    return "";
  };

  /** mp-html 链接点击：外部链接统一跳转（对齐 dev markdown-msg handleLinkTap）。 */
  const handleMpHtmlLinkTap = (event: any): void => {
    if (event == null) {
      return;
    }
    const eventObj = event as UTSJSONObject;
    const href = readLinkTapField(eventObj, "href");
    if (href.length == 0) {
      return;
    }
    // 会话详情链接是站内路由，mp-html 内部已 navigateTo，勿再走 webview
    if (
      href.indexOf("/subpackages/pages/agent-detail/agent-detail") == 0 ||
      href.indexOf("/subpackages/pages/app-details/app-details") == 0
    ) {
      return;
    }
    handleExternalLink(href, readLinkTapField(eventObj, "innerText"));
  };
  // #endif

  /** 仅驱动思考区 rich-text，与正文 streamRevision 解耦，避免 THINK 流空刷答案树 */
  const thinkStreamRevision = ref<number>(0);

  const thinkContent = computed((): string => {
    // Android：MsgItem 字段变更不一定被深层追踪；think 用独立 revision，勿绑 streamRevision
    const _rev = thinkStreamRevision.value;
    return resolveThinkText();
  });

  // 思考时长锚点（对齐 PC 投影层锚点语义：首见思考内容打点、翻完成收口；
  // 历史消息首见即终态，无锚不臆造时长）
  let thinkAnchorStartMs: number = 0;
  const thinkDurationSec = ref<number>(-1);

  // 运行中 ticker：思考内容首行贴尾跟随（对齐 PC「正在思考 · <内容>」滚动）
  const thinkTickerText = ref<string>("");
  const thinkTickerScrollLeft = ref<number>(0);

  watch(
    (): string => thinkContent.value,
    (content: string) => {
      if (content.length > 0) {
        if (thinkAnchorStartMs == 0 && isThinkingFinished.value != true) {
          thinkAnchorStartMs = Date.now();
        }
        if (isThinkingFinished.value != true) {
          const idx = content.indexOf("\n");
          const line = idx >= 0 ? content.substring(0, idx) : content;
          thinkTickerText.value = line.trim();
          // 贴尾：内容增长时持续滚到最右（scroll-with-animation 平滑）
          thinkTickerScrollLeft.value = thinkTickerScrollLeft.value + 1000;
        }
      }
    },
    { immediate: true },
  );

  watch(
    (): boolean => isThinkingFinished.value,
    (finished: boolean) => {
      if (finished && thinkAnchorStartMs > 0 && thinkDurationSec.value < 0) {
        const sec = Math.round((Date.now() - thinkAnchorStartMs) / 1000);
        thinkDurationSec.value = sec > 0 ? sec : 1;
        thinkAnchorStartMs = 0;
      }
    },
  );

  const thinkDurationText = computed((): string => {
    const sec = thinkDurationSec.value;
    if (sec < 0) return "";
    const params = new Map<string, string | number>();
    params.set("count", sec);
    return tFn("Mobile.Chat.WorkTrace.thinkDuration", toI18nParams(params), "");
  });

  /**
   * 思考区增量缓冲：frozen/live 仅内部维护；模板绑 thinkDisplayText（规避 UTS v-for ref 数组）。
   * 流式默认折叠：折叠时只缓存 pending，不 paint；用户展开后再渲染。
   */
  const THINK_TEXT_THROTTLE_MS: number = 50;
  const thinkDisplayText = ref<string>("");
  let thinkFrozenParts: string[] = [] as string[];
  let thinkLivePart: string = "";
  let thinkPaintedRaw: string = "";
  let thinkTextPending: string = "";
  let thinkTextThrottleTimer: number | null = null;

  const joinThinkPaint = (frozen: string[], live: string): string => {
    let out = "";
    for (let i = 0; i < frozen.length; i++) {
      out += frozen[i];
    }
    return out + live;
  };

  const resetThinkPaintState = () => {
    thinkFrozenParts = [] as string[];
    thinkLivePart = "";
    thinkPaintedRaw = "";
    thinkDisplayText.value = "";
  };

  const paintThinkIncremental = (raw: string) => {
    const painted = applyThinkIncremental(
      thinkPaintedRaw,
      thinkFrozenParts,
      thinkLivePart,
      raw,
    );
    thinkFrozenParts = painted.frozenParts;
    thinkLivePart = painted.livePart;
    thinkPaintedRaw = raw;
    thinkDisplayText.value = joinThinkPaint(
      thinkFrozenParts,
      thinkLivePart,
    );
  };

  const flushThinkTextDisplay = (immediate: boolean) => {
    if (thinkTextThrottleTimer != null) {
      clearTimeout(thinkTextThrottleTimer!);
      thinkTextThrottleTimer = null;
    }
    if (immediate == true) {
      paintThinkIncremental(thinkTextPending);
      return;
    }
    thinkTextThrottleTimer = setTimeout(() => {
      thinkTextThrottleTimer = null;
      // 定时器触发时若已重新折叠，丢弃本次 paint
      if (hideThinkContent.value == true) {
        return;
      }
      paintThinkIncremental(thinkTextPending);
    }, THINK_TEXT_THROTTLE_MS) as number;
  };

  const scheduleThinkTextPaint = (raw: string) => {
    thinkTextPending = raw;
    // 折叠：不渲染思考正文（省掉增量拼接与 text layout）
    if (hideThinkContent.value == true) {
      if (thinkTextThrottleTimer != null) {
        clearTimeout(thinkTextThrottleTimer!);
        thinkTextThrottleTimer = null;
      }
      return;
    }
    if (
      isConversationActive.value != true ||
      isLastMsg.value != true
    ) {
      flushThinkTextDisplay(true);
      return;
    }
    if (thinkTextThrottleTimer != null) {
      return;
    }
    flushThinkTextDisplay(false);
  };

  watch(
    (): string => thinkContent.value,
    (v: string) => {
      scheduleThinkTextPaint(v);
    },
    { immediate: true },
  );

  watch(
    (): boolean => isConversationActive.value,
    (active: boolean) => {
      // 会话结束且已展开时定稿；折叠仍不 paint，展开时再刷
      if (active != true && hideThinkContent.value != true) {
        thinkTextPending = resolveThinkText();
        flushThinkTextDisplay(true);
      }
    },
  );

  const changeThinkContent = () => {
    const nextHide = !hideThinkContent.value;
    hideThinkContent.value = nextHide;
    if (nextHide != true) {
      // 用户展开：立刻用当前缓存/消息全文渲染
      thinkTextPending = resolveThinkText();
      if (thinkTextPending.length == 0) {
        thinkTextPending = thinkContent.value;
      }
      flushThinkTextDisplay(true);
    } else {
      // 收起：卸载展示态，释放 layout；原文仍在 msg / pending
      if (thinkTextThrottleTimer != null) {
        clearTimeout(thinkTextThrottleTimer!);
        thinkTextThrottleTimer = null;
      }
      resetThinkPaintState();
    }
    emit("changeThinkContent", hideThinkContent.value);
  };

  const updateMessage = (newData: any) => {
    try {
      if (newData != null) {
        const bodyBefore = resolveBodyText();
        const thinkBefore = resolveThinkText();
        const procBefore = toolCallProcessingListFingerprint(
          msg.value.processingList != null
            ? (msg.value.processingList as any[])
            : ([] as any[]),
        );
        applyMsgPatch(msg.value, newData);
        const bodyAfter = resolveBodyText();
        const thinkAfter = resolveThinkText();
        const procAfter = toolCallProcessingListFingerprint(
          msg.value.processingList != null
            ? (msg.value.processingList as any[])
            : ([] as any[]),
        );
        const bodyChanged = bodyBefore != bodyAfter;
        const thinkChanged = thinkBefore != thinkAfter;
        const procChanged = procBefore != procAfter;
        // #ifdef APP
        try {
          if (bodyChanged == true || thinkChanged == true || procChanged == true) {
            perfRecordSseUi(
              bodyAfter.length,
              `rev=${streamRevision.value} thinkRev=${thinkStreamRevision.value} think=${thinkAfter.length}`,
            );
          }
        } catch (_eStall) {
          // ignore
        }
        // #endif
        // THINK：勿 bump streamRevision（否则连带正文 UniAiXMsgRender 整树失效）。
        // 流式默认折叠：折叠时只写入 msg，不抬 revision（避免驱动 thinkContent watch → paint）；
        // 仅「空→有」抬一次以便显示思考标题栏；展开后才持续抬 revision 驱动渲染。
        if (thinkChanged == true) {
          if (hideThinkContent.value == true) {
            thinkTextPending = thinkAfter;
            if (thinkBefore.length == 0 && thinkAfter.length > 0) {
              thinkStreamRevision.value = thinkStreamRevision.value + 1;
            }
          } else {
            thinkStreamRevision.value = thinkStreamRevision.value + 1;
          }
        }
        if (bodyChanged == true || procChanged == true) {
          streamRevision.value = streamRevision.value + 1;
          if (bodyChanged == true) {
            scheduleBodyMarkdownParse();
          }
        }
      }
    } catch (error) {
      console.error("updateMessage 执行失败:", error);
    }
  };

  watch(
    (): any | null => (props.msg != null ? props.msg : null),
    (newVal: any | null) => {
      syncMsgFromProps(newVal);
    },
    { deep: true, immediate: true },
  );

  watch(
    (): string => props.messageId != null ? props.messageId : "",
    (messageId: string) => {
      if (messageId.length == 0) return;
      if (msg.value._id != messageId) {
        const next = new MsgItem();
        next._id = messageId;
        next.from_uid = "assistant";
        msg.value = next;
      }
    },
    { immediate: true },
  );

  watch(
    (): any | null =>
      props.messageStatus != null ? props.messageStatus : null,
    (status: any | null) => {
      if (status != null) {
        msg.value.state = ChatDataAdapter.mapStatusToMsgState(status);
      }
    },
    { immediate: true },
  );

  let lastProcessingListFp: string = "";
  watch(
    (): any[] => props.processingList != null
      ? props.processingList
      : [] as any[],
    (list: any[]) => {
      const fp = toolCallProcessingListFingerprint(list);
      msg.value.processingList = list;
      if (fp == lastProcessingListFp) {
        return;
      }
      lastProcessingListFp = fp;
      streamRevision.value = streamRevision.value + 1;
      // 历史消息：工具卡靠 processingList + revision 刷新即可，勿强制全量 markdown
      if (isLastMsg.value != true) {
        return;
      }
      scheduleBodyMarkdownParse();
    },
    { immediate: true },
  );

  watch(
    (): string => props.conversationId != null ? props.conversationId : "",
    (conversationId: string) => {
      if (conversationId.length > 0) {
        msg.value.chat_id = conversationId.startsWith("chat-")
          ? conversationId
          : "chat-" + conversationId;
      }
    },
    { immediate: true },
  );

  watch(
    (): string => props.messageTime != null ? props.messageTime : "",
    (messageTime: string) => {
      if (messageTime.length > 0) {
        msg.value.create_time = new Date(messageTime).getTime();
      }
    },
    { immediate: true },
  );

  watch(
    (): any[] => props.initialMarkdownElList != null
      ? props.initialMarkdownElList
      : [] as any[],
    (list: any[]) => {
      if (list.length == 0) return;
      const converted = JSON.parseArray<UniAiMarkdownElItem>(
        JSON.stringify(list),
      );
      if (converted != null && converted.length > 0) {
        msg.value.markdownElList = converted;
        msg.value.rendered = true;
      }
    },
    { immediate: true },
  );

  watch(
    (): string => (props.bodyText != null ? `${props.bodyText}` : ""),
    (v: string) => {
      msg.value.body = v;
      // 流式最后一条：由 scheduleBodyMarkdownParse（200ms）驱动渲染，
      // 避免每字 bump streamRevision 导致 App 端整树重绘卡顿。
      if (isConversationActive.value == true && isLastMsg.value == true) {
        return;
      }
      streamRevision.value = streamRevision.value + 1;
    },
    { immediate: true },
  );

  watch(
    (): string =>
      resolveThinkText() +
      "|" +
      `${isConversationActive.value}` +
      "|" +
      `${hideThinkContent.value}`,
    () => {
      const v = resolveThinkText();
      // 已由 updateMessage patch 过则勿再 bump，避免 THINK 每帧 double 刷新
      if (msg.value.thinkContent == v) {
        return;
      }
      msg.value.thinkContent = v;
      thinkStreamRevision.value = thinkStreamRevision.value + 1;
    },
    { immediate: true },
  );

  watch(
    (): string => msg.value._id,
    () => {
      markdownParser.resetForNewMessage();
      thinkFrozenParts = [] as string[];
      thinkLivePart = "";
      thinkPaintedRaw = "";
      thinkTextPending = "";
      thinkDisplayText.value = "";
      thinkAnchorStartMs = 0;
      thinkDurationSec.value = -1;
      thinkTickerText.value = "";
      thinkTickerScrollLeft.value = 0;
      // 新消息默认折叠思考区
      hideThinkContent.value = true;
      resetTraceFoldState();
    },
  );

  /** 合并正文解析触发条件，避免多个 watch 对同一正文重复解析。 */
  watch(
    (): string =>
      resolveBodyText() + "|" + `${msg.value.state}` + "|" + `${isLastMsg.value}`,
    () => {
      if (isLastMsg.value == true && isConversationActive.value == true) {
        scheduleBodyMarkdownParse();
        return;
      }
      // #ifdef H5 || WEB
      // 历史 / 非流式末条：deferParse 历史消息先懒解析（滚近视口再解析），
      // 大历史会话避免首屏全量 markdown 解析阻塞主线程。
      if (props.deferParse == true && lazyMarkdownDone == false) {
        setupLazyMarkdownParse();
        return;
      }
      // #endif
      // 历史 / 非流式末条：定稿解析（runMarkdownParse 内部会跳过正文未变）
      runBodyMarkdownParseNow(true);
    },
    { immediate: true },
  );

  /** 仅末条关心会话 active：开始→节流解析；结束→立刻定稿。历史消息忽略 active 抖动。 */
  watch(
    (): boolean => isConversationActive.value,
    (active: boolean) => {
      if (isLastMsg.value != true) {
        return;
      }
      if (active == true) {
        scheduleBodyMarkdownParse();
      } else {
        runBodyMarkdownParseNow(true);
      }
    },
  );

  onUnmounted(() => {
    clearStreamMdParseTimer();
    // #ifdef H5 || WEB
    teardownLazyMarkdownParse();
    // #endif
    if (thinkTextThrottleTimer != null) {
      clearTimeout(thinkTextThrottleTimer!);
      thinkTextThrottleTimer = null;
    }
  });

  defineExpose({
    updateMessage,
  });
</script>

<style lang="scss">
  .msg-root {
    display: flex;
    flex-direction: column;
    width: 100%;
    // #ifndef APP
    user-select: text;
    -webkit-user-select: text;
    // #endif
    padding: 0 32rpx;
    min-height: 90rpx;
    box-sizing: border-box;

    .think-container {
      width: 100%;

      .think-header {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 8rpx 0;

        .think-header-left {
          display: flex;
          flex-direction: row;
          align-items: center;

          /* 已思考行=PC ProcessNodeRow 行体系一员：标题与工具行标题同款（26rpx/500/主文字色），图标同 kind-icon（28rpx 四级灰） */
          .thinking-icon {
            font-size: 28rpx;
            line-height: 40rpx;
            color: rgba(5, 5, 5, 0.45);
            margin-right: 12rpx;
          }

          .thinking-title {
            color: rgba(0, 0, 0, 0.88);
            font-size: 26rpx;
            line-height: 40rpx;
            font-weight: 500;
          }

          /* 箭头与工具行完全一致（tool-trace-row node-disclosure 同规格：20rpx 四级灰、-90°收起/0°展开） */
          .think-caret {
    flex-shrink: 0;
    margin-left: 12rpx;
    color: rgba(5, 5, 5, 0.25);
    font-size: 20rpx;
    line-height: 20rpx;
    transform: rotate(-90deg);
    transition: transform 0.18s ease, color 0.18s ease;
  }

          .think-caret-open {
            transform: rotate(0deg);
            color: rgba(5, 5, 5, 0.65);
          }

          /* 完成态思考时长（有锚才显示，历史消息无） */
          .think-duration {
            margin-left: 8rpx;
            color: rgba(5, 5, 5, 0.45);
            font-size: 26rpx;
            line-height: 40rpx;
          }

          /* 运行中 ticker：首行内容贴尾跟随（对齐 PC「正在思考 · <内容>」） */
          .think-ticker {
            flex: 1 1 auto;
            min-width: 0;
            display: flex;
            flex-direction: row;
            align-items: center;
            overflow: hidden;
          }

          .think-ticker-dot {
            flex-shrink: 0;
            color: rgba(5, 5, 5, 0.45);
            font-size: 26rpx;
          }

          .think-ticker-scroll {
            flex: 1 1 auto;
            min-width: 0;
            height: 40rpx;
          }

          .think-ticker-text {
            display: flex;
            white-space: nowrap;
            font-size: 26rpx;
            color: rgba(5, 5, 5, 0.45);
            line-height: 40rpx;
          }
        }
      }

      .think-content {
        overflow: hidden;
        transition: all 0.3s ease;
        padding-top: 8rpx;

        /* #ifndef APP */
        /* 展开态限高内滚（对齐工具详情的紧凑策略；收起态 height:0 不受影响）。
           注意：style 块内禁用 // 注释——dev 管线按纯 CSS 跑 postcss 会报 Unknown word，
           导致整个样式模块加载失败（已思考标题因此丢字号）。 */
        max-height: 400rpx;
        overflow-y: auto;

        &.hide-think-content {
          height: 0;
          padding-top: 0;
          opacity: 0;
        }
        /* #endif */

        .text-box {
          border-left: 4rpx solid #efefef;
          padding-left: 20rpx;
          background-color: rgba(245, 245, 245, 0.3);
          border-radius: 0 8rpx 8rpx 0;
          padding-top: 8rpx;
          padding-bottom: 8rpx;

          /* 思考正文：原生 text 可吃 class 字号颜色；保留换行 */
          .think-plain-text {
            width: 100%;
            font-size: 28rpx;
            color: #888888;
            line-height: 1.4;
            white-space: pre-wrap;
          }
        }
      }
    }

    /* OpenUI 产物常显区（轨迹收起态）：仅布局容器 */
    .openui-persistent {
      width: 100%;
    }

    .answer-container {
      /* 仅布局。App 禁止在 view 写 color/font-size/line-height。
       * AI 答复正文样式在 UniAiXMsg 的 text 上（非用户气泡 .user-msg-text）：
