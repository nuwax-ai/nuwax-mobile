<template>
	<view class="nkx-page page-container">
		<view class="nkx-header">
			<text class="nkx-title">nuwax-katex 公式渲染 Demo</text>
			<text class="nkx-sub">H5=v-html / 小程序=rich-text / App=web-view，均为实时渲染（非截图）</text>
		</view>

		<scroll-view class="nkx-scroll" direction="vertical">
			<!-- 1. 基础公式 -->
			<view class="nkx-case">
				<text class="nkx-case-title">1. 行内公式</text>
				<view class="nkx-inline-row">
					<text class="nkx-text">勾股定理：</text>
					<nuwax-katex :tex="'a^2 + b^2 = c^2'" />
					<text class="nkx-text">，欧拉公式：</text>
					<nuwax-katex :tex="'e^{i\\pi} + 1 = 0'" />
				</view>
			</view>

			<view class="nkx-case">
				<text class="nkx-case-title">2. 块级公式（displayMode）</text>
				<scroll-view class="nkx-block-scroll" scroll-x="true" :show-scrollbar="false">
					<view class="nkx-block-wrap">
						<nuwax-katex
							:tex="'\\frac{-b \\pm \\sqrt{b^2-4ac}}{2a}'"
							:display-mode="true"
						/>
					</view>
				</scroll-view>
				<scroll-view class="nkx-block-scroll" scroll-x="true" :show-scrollbar="false">
					<view class="nkx-block-wrap">
						<nuwax-katex
							:tex="'\\sum_{i=1}^{n} x_i^2 + \\int_0^\\infty e^{-x^2} dx = \\frac{\\sqrt{\\pi}}{2}'"
							:display-mode="true"
						/>
					</view>
				</scroll-view>
			</view>

			<!-- 3. 流式打字机 -->
			<view class="nkx-case">
				<text class="nkx-case-title">3. 流式逐字更新（实时重渲染）</text>
				<scroll-view class="nkx-block-scroll" scroll-x="true" :show-scrollbar="false">
					<view class="nkx-block-wrap">
						<nuwax-katex :tex="streamTex" :display-mode="true" />
					</view>
				</scroll-view>
				<view class="nkx-btn-row">
					<view class="nkx-btn" @click="startStream"><text>开始流式</text></view>
					<view class="nkx-btn nkx-btn-plain" @click="resetStream"><text>重置</text></view>
				</view>
			</view>

			<!-- 4. 字号 / 颜色 -->
			<view class="nkx-case">
				<text class="nkx-case-title">4. 自定义字号 / 颜色</text>
				<view class="nkx-inline-row">
					<text class="nkx-text">默认：</text>
					<nuwax-katex :tex="'\\alpha + \\beta = \\gamma'" />
				</view>
				<view class="nkx-inline-row">
					<text class="nkx-text">18px / 蓝：</text>
					<nuwax-katex :tex="'\\alpha + \\beta = \\gamma'" :font-size="18" color="#2563eb" />
				</view>
			</view>

			<!-- 5. 正文混排（splitMathSegments） -->
			<view class="nkx-case">
				<text class="nkx-case-title">5. 正文 $…$ / $$…$$ 混排</text>
				<view class="nkx-paragraph" v-for="(seg, i) in mixedSegs" :key="i">
					<text v-if="seg.type == 'text'" class="nkx-text">{{ seg.content }}</text>
					<nuwax-katex
						v-else-if="seg.type == 'inline'"
						:tex="seg.content"
					/>
					<scroll-view v-else class="nkx-block-scroll" scroll-x="true" :show-scrollbar="false">
						<view class="nkx-block-wrap">
							<nuwax-katex :tex="seg.content" :display-mode="true" />
						</view>
					</scroll-view>
				</view>
			</view>

			<!-- 6. 错误公式兜底 -->
			<view class="nkx-case">
				<text class="nkx-case-title">6. 错误公式（throwOnError:false 兜底）</text>
				<nuwax-katex :tex="'\\frac{1}{' " />
			</view>

			<!-- 7. 矩阵 / 方程组 -->
			<view class="nkx-case">
				<text class="nkx-case-title">7. 矩阵 / 方程组</text>
				<scroll-view class="nkx-block-scroll" scroll-x="true" :show-scrollbar="false">
					<view class="nkx-block-wrap">
						<nuwax-katex
							:tex="'\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix} \\begin{pmatrix} x \\\\ y \\end{pmatrix}'"
							:display-mode="true"
						/>
					</view>
				</scroll-view>
			</view>
		</scroll-view>
	</view>
</template>

<script lang="uts" setup>
	import { onMounted, ref } from 'vue'
	import { splitMathSegments } from '@/uni_modules/nuwax-katex/js_sdk/tex-splitter.uts'
	import type { MathSegment } from '@/uni_modules/nuwax-katex/utssdk/interface.uts'
	import NuwaxKatex from '@/uni_modules/nuwax-katex/components/nuwax-katex/nuwax-katex.uvue'

	const streamTex = ref('')
	const mixedSegs = ref<MathSegment[]>([])

	let streamTimer: number | null = null
	const STREAM_FULL = 'T_{\\text{resize}}(n) = m + 2m + 4m + \\cdots + 2^{\\lfloor \\log_2(n/m) \\rfloor} m = O(n)'

	/** 停止流式并清空（Kotlin 闭包捕获变量不能智能转换，先拷到局部再判空） */
	function resetStream(): void {
		const t = streamTimer
		if (t != null) {
			clearInterval(t)
			streamTimer = null
		}
		streamTex.value = ''
	}

	function startStream(): void {
		resetStream()
		let len = 0
		streamTimer = setInterval(() => {
			len += 1
			if (len > STREAM_FULL.length) {
				const t = streamTimer
				if (t != null) {
					clearInterval(t)
					streamTimer = null
				}
				return
			}
			streamTex.value = STREAM_FULL.substring(0, len)
		}, 40) as number
	}

	onMounted(() => {
		mixedSegs.value = splitMathSegments(
			'设 $x > 0$，且满足 $$\\int_0^1 x\\,dx = \\frac{1}{2}$$，则 $f(x)=x^2$ 在 $[0,1]$ 上可积。',
		)
	})
</script>

<style lang="scss">
	.nkx-page {
		width: 100%;
		background-color: #f5f5f5;
		flex-direction: column;
		/* 高度由全局 .page-container 提供（H5 用 --vh，App/小程序 100%） */
	}
	.nkx-header {
		padding: 24rpx;
		background-color: #fff;
		border-bottom: 1px solid #eee;
	}
	.nkx-title {
		font-size: 34rpx;
		font-weight: 600;
		color: #333;
		display: block;
	}
	.nkx-sub {
		font-size: 24rpx;
		color: #999;
		margin-top: 8rpx;
		display: block;
	}
	.nkx-scroll {
		flex: 1;
		/* App 端 flex 子项需 min-height:0 才能被父级约束高度，否则 scroll-view 撑开内容无法滚动 */
		min-height: 0;
	}
	.nkx-case {
		background-color: #fff;
		margin: 16rpx;
		padding: 24rpx;
		border-radius: 12rpx;
		border: 1px solid #eee;
	}
	.nkx-case-title {
		font-size: 26rpx;
		color: #0066cc;
		margin-bottom: 16rpx;
		display: block;
	}
	.nkx-inline-row {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}
	.nkx-text {
		font-size: 30rpx;
		color: #404040;
	}
	.nkx-block-wrap {
		margin: 8rpx 0;
		width: 100%;
		min-width: 100%;
	}
	/* 块级公式横向滚动：窄公式居中，超宽时撑开滚动（与聊天页 msg-root-math-scroll 一致） */
	.nkx-block-scroll {
		width: 100%;
		flex-direction: row;
	}
	.nkx-btn-row {
		flex-direction: row;
		margin-top: 16rpx;
	}
	.nkx-btn {
		background-color: #2563eb;
		border-radius: 8rpx;
		padding: 12rpx 32rpx;
		margin-right: 16rpx;
	}
	.nkx-btn text {
		color: #fff;
		font-size: 26rpx;
	}
	.nkx-btn-plain {
		background-color: #e5e7eb;
	}
	.nkx-btn-plain text {
		color: #333;
	}
	.nkx-paragraph {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}
</style>
