<template>
  <!-- APP 平台（iOS/Android）：原生不支持 CSS :before，优先通过 unicode 文本渲染单个图标，支持颜色设置 -->
  <!-- #ifdef APP -->
  <text
    v-if="unicodeChar.length > 0"
    class="iconfont"
    :class="appTextClasses"
    :style="iconStyle"
    @click="handleClick"
  >{{ unicodeChar }}</text>
  <image
    v-else
    :src="svgSrc"
    mode="aspectFit"
    :style="imageStyle"
    class="svg-icon"
    :class="props.customClass"
    @click="handleClick"
  />
  <!-- #endif -->

  <!-- 非 APP 平台（H5 / MP-WEIXIN）：使用 CSS :before 伪元素渲染单个字体图标 -->
  <!-- #ifndef APP -->
  <text
    class="iconfont"
    :class="textClasses"
    :style="iconStyle"
    @click="handleClick"
  ></text>
  <!-- #endif -->
</template>

<script lang="uts" setup>
  import { computed } from "vue";
  import { getIconUnicode } from "@/constants/iconfont.constants";

  /**
   * 通用图标组件
   * - APP 平台：原生不支持 CSS :before，优先通过 iconfont unicode 文本渲染单个图标，支持颜色设置
   * - 非 APP 平台（H5 / 小程序）：使用 CSS :before 伪元素标准渲染单个字体图标
   */
  const props = withDefaults(
    defineProps<{
      /** 图标名称，如 "icon-Search"、"icon-Star" */
      name: string;
      /**
       * 图标大小（单位 rpx）。
       * Android：props 运行时可能是 String，禁止声明为 number（会 ClassCastException）
       */
      size?: any | null;
      /** 图标颜色（支持 #ffffff 等，通过 text color 在所有端一致生效） */
      color?: string;
      /** 额外的 CSS 类名 */
      customClass?: string;
    }>(),
    {
      size: 32 as any,
      color: "",
      customClass: "",
    },
  );

  const emit = defineEmits<{
    (e: "click", event: any): void;
  }>();

  /** 获取 unicode 字符 */
  const unicodeChar = computed((): string => {
    return getIconUnicode(props.name);
  });

  /** PNG 文件路径（APP 降级使用） */
  const svgSrc = `/static/images/${props.name}.png`;

  /** 将 size 安全转为 number（兼容 string / number） */
  function resolveSize(raw: any | null): number {
    if (raw == null) {
      return 32;
    }
    if (typeof raw == "number") {
      const n = raw as number;
      return n != n ? 32 : n;
    }
    const s = `${raw}`;
    if (s.length == 0) {
      return 32;
    }
    const parsed = parseFloat(s);
    return parsed != parsed ? 32 : parsed;
  }

  const sizeNum = computed((): number => {
    return resolveSize(props.size);
  });

  /** APP 图片宽高与着色样式 */
  const imageStyle = computed((): string => {
    const s = sizeNum.value;
    let style = "width: " + s.toString() + "rpx; height: " + s.toString() + "rpx;";
    if (props.color != null && props.color.length > 0) {
      style += " tint-color: " + props.color + ";";
    }
    return style;
  });

  /** 非 APP 平台的 text 元素类名（包含 prop.name 用于匹配 CSS :before） */
  const textClasses = computed((): string => {
    let cls = props.name;
    if (props.customClass.length > 0) {
      cls = cls + " " + props.customClass;
    }
    return cls;
  });

  /** APP 平台的 text 元素类名（仅包含 customClass，不含 prop.name） */
  const appTextClasses = computed((): string => {
    return props.customClass;
  });

  /** 字体图标大小与颜色 */
  const iconStyle = computed((): string => {
    // vapor styleIsolation 2.0 不把全局 .iconfont{font-family} 透传进组件，内联保证命中字体
    let style = "font-family: iconfont; font-size: " + sizeNum.value.toString() + "rpx;";
    if (props.color != null && props.color.length > 0) {
      style += " color: " + props.color + ";";
    }
    return style;
  });

  /** 处理点击事件 */
  const handleClick = (event: any) => {
    emit("click", event);
  };
</script>

<style scoped>
  /* #ifdef APP */
  .svg-icon {
    /* uvue 仅支持 display: flex | none */
    display: flex;
  }
  /* #endif */
</style>
