/** 剪贴板探测结果回调。hasImage=是否含图片；fingerprint=内容指纹（iOS=changeCount、
 *  Android=clip 时间戳），供调用方「同一份内容只提示一次」去重；空串=无法取指纹
 *  （鸿蒙），不去重、每次聚焦都提示。探测只读元数据，不触发系统粘贴提示/Toast。 */
export type ClipboardProbeCallback = (hasImage: boolean, fingerprint: string) => void;

/** 读图成功：path=已写好的缓存图片文件绝对路径（jpg/png，可直接入暂存条上传）。 */
export type ClipboardImageSuccessCallback = (path: string) => void;

/** 读图失败。code：EMPTY=剪贴板无图片（iOS 用户拒绝系统粘贴弹窗同归此码）；
 *  PERM=剪贴板读取权限被拒（鸿蒙 READ_PASTEBOARD 未授权）；
 *  READ/DECODE=读取或解码失败；WRITE=写缓存文件失败。 */
export type ClipboardImageFailureCallback = (code: string, message: string) => void;

/** 探测剪贴板是否含图片（不读取内容、不弹任何系统提示）。 */
export type ProbeClipboardImageApi = (onResult: ClipboardProbeCallback) => void;

/** 读取剪贴板图片写入缓存文件后回传路径（须在用户点击手势内调用；
 *  iOS 16+ 读取时系统弹「允许粘贴」，Android 13+ 读取时系统弹读取 Toast，均为平台常态）。 */
export type ReadClipboardImageApi = (
  success: ClipboardImageSuccessCallback,
  fail: ClipboardImageFailureCallback,
) => void;
