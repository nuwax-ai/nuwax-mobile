<!-- 智能体卡片组件 -->
<template>
  <view
    class="card-container"
    hover-class="card-container-active"
    @click.prevent="handleClick"
  >
    <agent-icon :icon="icon" :alt="name != null ? name : altIcon" />
    <view class="info-box">
      <view class="agent-info">
        <text class="agent-name">{{ name }}</text>
        <image
          v-if="currentAvatar.length > 0"
          class="avatar"
          :src="currentAvatar"
          :alt="altAvatar"
          @error="handleError"
        />
        <view v-else class="avatar"></view>
        <text class="agent-creator">{{ displayUserName }}</text>
      </view>
      <text class="agent-description text-ellipsis">{{ description }}</text>
      <view class="agent-stats">
        <view class="stat-item">
          <image :src="iconUser" class="stat-icon" alt="" />
          <text class="stat-value">{{ userCount != null ? userCount : 0 }}</text>
        </view>
        <view class="stat-item">
          <image :src="iconMessage" class="stat-icon" alt="" />
          <text class="stat-value">{{ convCount != null ? convCount : 0 }}</text>
        </view>
        <view class="stat-item" hover-class="stat-item-active" @click.stop.prevent="handleCollect">
          <svg-icon name="icon-Star" customClass="stat-icon" v-if="!collect" />
          <svg-icon name="icon-Star-fill" customClass="stat-icon" v-else />
          <text class="stat-value">{{ collectCount != null ? collectCount : 0 }}</text>
        </view>
        <view class="flex-1"></view>
        <view class="status-tags" v-if="paymentRequired">
          <text v-if="subscribed" class="status-tag status-active">{{ tagSubscribed }}</text>
          <text v-else class="status-tag status-warning">{{ tagPaymentRequired }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { computed, ref, watch } from "vue";
  import iconUser from "@/static/assets/icon_user.png";
  import iconMessage from "@/static/assets/icon_message.png";
  import defaultAvatar from "@/static/assets/avatar.png";
  import AgentIcon from "@/components/agent-icon/agent-icon.uvue";
  import { resolveAppSvgUrl } from "@/utils/remoteSvgImage";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const _params = emptyI18nParams();
  const altIcon = translateFn("Mobile.Common.agentIconAlt", _params, "");
  const altAvatar = translateFn("Mobile.Common.avatarAlt", _params, "");
  const tagSubscribed = translateFn("Mobile.AgentList.subscribedTag", _params, "");
  const tagPaymentRequired = translateFn("Mobile.AgentList.paymentRequiredTag", _params, "");

  interface AgentComponentProps {
    // 图标
    icon: string;
    // 头像
    avatar: string;
    // 名称
    name: string;
    // 发布人
    userName: string;
    // 描述
    description: string;
    // 用户数
    userCount: number;
    // 对话数
    convCount: number;
    // 收藏数
    collectCount: number;
    // 收藏状态
    collect: boolean;
    // 是否要求订阅
    paymentRequired?: boolean;
    // 是否已订阅
    subscribed?: boolean;
  }

  const props = defineProps<AgentComponentProps>();

  /**
   * 发布人名称按「显示宽度」在脚本里截断，而不是交给 CSS 限宽。
   *
   * iOS 原生 flex 下，<text> 的截断宽度取自布局过程中分到的可用宽度，最终绘制的框却可能更宽
   * （max-width 不参与 flex 尺寸计算、flex-shrink 收缩后也不会重新截断），两者对不上就会出现
   * 「用户名右侧一段空白」——名字长到需要截断的行才有，短名字的行正常，正是该现象的成因。
   * 这里让发布人始终按内容宽度排版（flex-shrink: 0），宽度由字符数上限保证，绘制宽度 == 排版宽度。
   *
   * CJK 记 1 个单位、其余记 0.5 个单位，11 个单位 ≈ 原先 300rpx 的上限。
   */
  const MAX_CREATOR_UNITS = 11.0;

  const clampUserName = (raw : string) : string => {
    let units = 0.0;
    for (let i = 0; i < raw.length; i++) {
      // UTS: charCodeAt 返回 Number?，需先解包
      const codeRaw = raw.charCodeAt(i);
      const code = codeRaw != null ? codeRaw : 0;
      units += code > 0x2e80 ? 1.0 : 0.5;
      if (units > MAX_CREATOR_UNITS) return raw.substring(0, i) + "…";
    }
    return raw;
  };

  const displayUserName = computed<string>(() : string => {
    return clampUserName(props.userName);
  });

  // 当前显示的头像。发布人头像可能是远程 SVG，App 端 <image> 直接渲染会尺寸错乱，
  // 需按容器尺寸（32rpx）走 resolveAppSvgUrl 解析为 data URL（与个人头像同一处理）。
  // 解析完成前不给 <image> 任何 src（初始为空串）：iOS 端替换 src 会取消上一张的在途请求并补发一次 error，
  // 事件无法区分是哪个 src 失败，handleError 会把刚解析好的头像误判为加载失败而换回默认头像。
  // 详见 components/agent-icon/agent-icon.uvue 的同类说明。
  const currentAvatar = ref<string>("");
  // 异步解析竞态序号：list-view 复用 / 发布人信息异步补齐时，过期结果不覆盖新目标
  let resolveSeq = 0;

  const applyAvatar = (avatar : string) : void => {
    const raw = avatar.length > 0 ? avatar : defaultAvatar;
    const seq = ++resolveSeq;
    resolveAppSvgUrl(raw, 32, 32).then((resolved : string) => {
      if (seq == resolveSeq) {
        currentAvatar.value = resolved;
      }
    });
  };
  applyAvatar(props.avatar);

  watch(
    () : string => props.avatar,
    (avatar : string) => {
      applyAvatar(avatar);
    },
  );

  const emit = defineEmits(["click", "collect"]);

  // 头像加载错误时触发，切换为默认图片
  const handleError = () => {
    // 尚未给出 src（解析中）时收到的 error 一定不属于当前头像，忽略
    if (currentAvatar.value.length == 0) return;
    resolveSeq++;
    currentAvatar.value = defaultAvatar;
  };

  const handleClick = () => {
    emit("click");
  };

  const handleCollect = (e: UniPointerEvent) => {
    // 阻止冒泡到卡片 @click，避免收藏时进入详情
    e.stopPropagation();
    emit("collect");
  };
</script>

<style scoped lang="scss">
  /* vapor styleIsolation2.0：后代选择器运行时丢弃，反嵌套为顶层单类。
     伪类 &:hover(#ifdef WEB)/&:last-child 按 R6 原样保留（APP 编译期剔除或不命中，H5 仍需）。 */
  .card-container {
    display: flex;
    flex-direction: row;
    padding: 24rpx 32rpx;
    // #ifndef APP
    cursor: pointer;
    // #endif
    transform: translateZ(0);
    border-radius: 8rpx;
    transition: background-color 0.3s ease;

    // #ifdef WEB
    &:hover {
      background-color: rgba(12, 20, 102, 0.04);
    }
    // #endif
  }

  .card-container-active {
    background-color: rgba(12, 20, 102, 0.04);
  }

  .info-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .agent-info {
    display: flex;
    align-items: center;
    flex-direction: row;
    margin-bottom: 8rpx;
  }

  .agent-name {
    flex: 1;
    line-height: 48rpx;
    font-size: 32rpx;
    font-weight: 600;
    color: #15171f;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 8rpx;
  }

  .avatar {
    width: 32rpx;
    height: 32rpx;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    margin-right: 8rpx;
  }

  .agent-creator {
    // 按内容宽度排版、不参与收缩：宽度上限由脚本里的 clampUserName 保证（见组件内注释）。
    // 用 max-width / flex-shrink 限宽会让 iOS 的文字截断宽度与绘制宽度不一致，在名字右侧留白。
    flex-shrink: 0;
    line-height: 48rpx;
    font-size: 24rpx;
    color: rgba(21, 23, 31, 0.5);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .agent-description {
    font-size: 28rpx;
    color: rgba(21, 23, 31, 0.7);
    line-height: 44rpx;
    font-weight: 400;
    margin-bottom: 8rpx;
  }

  .agent-stats {
    display: flex;
    align-items: center;
    flex-direction: row;
  }

  .stat-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: row;
    height: 48rpx;
    padding: 0 16rpx;
    border-radius: 8rpx;
    margin-right: 20rpx;

    &:last-child {
      margin-right: 0;
    }
  }

  .stat-item-active {
    background-color: rgba(12, 20, 102, 0.04);
  }

  .stat-icon,
  .iconfont {
    margin-right: 8rpx;
  }

  .stat-icon {
    width: 32rpx;
    height: 32rpx;
  }

  .iconfont {
    font-size: 32rpx;
    color: rgba(21, 23, 31, 0.5);
  }

  .icon-Star-fill {
    color: #faad14;
  }

  .stat-value {
    font-size: 28rpx;
    color: rgba(21, 23, 31, 0.5);
    font-weight: 400;
  }

  .flex-1 {
    margin-right: 20rpx;
  }

  .status-tags {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .status-tag {
    padding: 2rpx 12rpx;
    border-radius: 6rpx;
    font-size: 20rpx;
    font-weight: 500;
    line-height: 1.5;
  }

  .status-active {
    background-color: rgba(82, 196, 26, 0.1);
    color: #52c41a;
  }

  .status-warning {
    border: 2rpx solid rgba(0, 122, 255, 0.4);
    color: #007aff;
    background-color: rgba(0, 122, 255, 0.08);
  }
</style>
