<template>
  <view class="gm-page">
    <safety-zone />

    <!-- 顶部：返回 + 群成员 + 添加 -->
    <view class="gm-header">
      <view class="gm-header__btn" hover-class="gm-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="gm-header__title-wrap">
        <text class="gm-header__title">{{ t("Mobile.Message.groupMembersLabel") }}</text>
      </view>
      <view
        v-if="canAdd"
        class="gm-header__add"
        hover-class="gm-header__add--active"
        @click="openAddMember"
      >
        <text class="gm-header__add-text">{{ t("Mobile.Message.groupAddEntry") }}</text>
      </view>
      <view v-else class="gm-header__btn gm-header__btn--ghost" />
    </view>

    <!-- 搜索（客户端过滤：群名片/昵称/姓名/userId，过滤出的行同样支持长按操作气泡） -->
    <view class="gm-search">
      <view class="gm-search__icon">
        <svg-icon name="icon-Search" size="28" color="#9a9aa2" />
      </view>
      <input
        class="gm-search__input"
        v-model="query"
        :placeholder="t('Mobile.Message.searchGroupMembers')"
        placeholder-class="gm-search__ph"
      />
    </view>

    <!-- 成员列表（长按浮层期间锁滚动 direction=none；页面级触摸收浮层 + 吞击守卫，消息列表同款） -->
    <scroll-view
      class="gm-body"
      :direction="rowMenuVisible ? 'none' : 'vertical'"
      :show-scrollbar="false"
      @scroll="handleListScroll"
      @touchstart="handlePageTouchStart($event)"
      @touchend="handlePageTouchEnd($event)"
      @touchcancel="handlePageTouchCancel($event)"
    >
      <view v-if="loading" class="gm-state">
        <text class="gm-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view v-else-if="loadFailed" class="gm-state" @click="handleRetry">
        <text class="gm-state__text">{{ t("Mobile.Message.loadFailed") }}</text>
      </view>
      <view v-else>
        <!--
          行内容（消息列表同款长按弹操作气泡：行原位浅灰高亮 + 行旁锚定气泡，无蒙层）：
          操作项按行权限生成（设·撤管理员/添加到智联录/删除），点击经 handleRowMenuAct 分发。
          ★key 只用 userId：旧复合键（含 role/contactState）是给左滑按钮区宽度重建用的，已废。
        -->
        <view v-for="m in filteredMembers" :key="m.userId">
          <view
            :id="`row-${m.userId}`"
            class="gm-row"
            :class="[pressedRowCls(m.userId), rowMenuOnCls(m.userId)]"
            @click="handleRowTap(m)"
            @longpress="handleMemberRowLongPress(m)"
            @touchstart="handleRowTouchStart(m.userId, $event)"
            @touchmove="handleRowTouchMove($event)"
            @touchend="handleRowTouchEnd($event)"
            @touchcancel="handleRowTouchCancel"
          >
            <view
              v-if="m.avatar.length > 0 && m.avatarFailed != true"
              class="gm-ava gm-ava--clip"
            >
              <image
                class="gm-ava__img"
                :src="m.avatar"
                mode="aspectFill"
                @error="handleAvatarError(m)"
              />
            </view>
            <view v-else class="gm-ava" :style="{ backgroundImage: avatarGradient(m.token) }">
              <text class="gm-ava-letter">{{ avatarLetter(m.token) }}</text>
            </view>
            <view class="gm-col">
              <view class="gm-name-row">
                <text class="gm-name text-ellipsis">{{ m.token }}</text>
                <view v-if="m.role == 3" class="gm-tag gm-tag--owner">
                  <text class="gm-tag__text">{{ t("Mobile.Message.groupOwner") }}</text>
                </view>
                <view v-else-if="m.role == 2" class="gm-tag">
                  <text class="gm-tag__text">{{ t("Mobile.Message.roleManager") }}</text>
                </view>
              </view>
              <text v-if="m.nickName.length > 0 && m.nickName != m.token" class="gm-sub text-ellipsis">{{ m.nickName }}</text>
            </view>
          </view>
        </view>
        <view v-if="filteredMembers.length == 0" class="gm-state">
          <text class="gm-state__text">{{ t("Mobile.AgentSearch.emptyResult") }}</text>
        </view>
        <view class="gm-tail" />
      </view>
    </scroll-view>

    <!-- 长按行操作浮层（无蒙层，消息列表 message.uvue 同款）：长按行原位浅灰高亮 + 行旁
         锚定浅灰纵向气泡（操作项=图标+文案，按成员权限生成）；页面任意触摸即收起（气泡根
         touchstart/touchend/touchcancel 三阶段断冒泡，气泡内不算点外），同手势补发的 click
         全吞防误触；Android 返回先关浮层（popupBackRegistry）；浮层期间列表锁滚动 -->
    <template v-if="rowMenuVisible">
      <view
        class="gm-menu-pop"
        :style="rowMenuPopStyle"
        @touchstart.stop="swallowRowMenuTouch"
        @touchend.stop="swallowRowMenuTouch"
        @touchcancel.stop="swallowRowMenuTouch"
        @click.stop="handleRowMenuPopTap"
      >
        <view
          v-for="(act, index) in rowMenuActs"
          :key="index"
          class="gm-menu-act"
          hover-class="gm-menu-act--active"
          @click="handleRowMenuAct(index)"
        >
          <view class="gm-menu-act__icon">
            <svg-icon :name="act.icon" size="32" color="#5a5966" />
          </view>
          <text class="gm-menu-act__text">{{ act.label }}</text>
        </view>
      </view>
    </template>

    <!-- 紧凑确认弹窗（撤销管理员二次确认，替代系统 showModal 样式） -->
    <confirm-modal ref="confirmModalRef" @confirm="handleRevokeManagerConfirm" />

    <!-- 添加成员：复用添加伙伴弹窗（群模式：隐藏附言/发消息，走 convAddMembers） -->
    <add-buddy-sheet ref="addBuddySheetRef" @added="handleMemberAdded" />
  </view>
</template>

<script setup lang="uts">
  import { switchMainTab } from "@/utils/mainTabNavigation";

  import { computed, getCurrentInstance, ref, watch, type ComponentPublicInstance } from "vue";
  import { onHide, onLoad, onShow } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { imAvatarDisplayUrl, resolveImAvatarDisplay } from "@/utils/imAvatarDisplay";
  import {
    apiImAddContact,
    apiImContacts,
    apiImConvDetail,
    apiImConvMembers,
    apiImGroupRemoveMember,
    apiImGroupSetMemberRole,
  } from "@/servers/im";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import ConfirmModal from "@/components/confirm-modal/confirm-modal.uvue";
  import AddBuddySheet from "@/components/add-buddy-sheet/add-buddy-sheet.uvue";
  import { registerPopupClose, unregisterPopupClose } from "@/utils/popupBackRegistry";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 头像字母底色渐变板（与群信息页同款）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  /**
   * 成员行（ConversationMemberDto 投影）。
   * ★role 对齐服务端 ImConstants：1=普通成员 2=管理员 3=群主（缺省按 1）；
   *   self=是否我自己（服务端算好）；
   *   contactState=智联录关系（""=无 1=已互加 2=对方申请中 3=我已申请，见 apiImContacts）。
   */
  class GmMember {
    userId: string = "";
    name: string = "";
    nickName: string = "";
    avatarRaw: string = "";
    avatar: string = "";
    token: string = "";
    role: number = 1;
    self: boolean = false;
    avatarFailed: boolean = false;
    contactState: string = "";
  }

  // ===== 页面入参 =====
  const convId = ref<string>("");

  // ===== 列表状态 =====
  const members = ref<GmMember[]>([]);
  const query = ref<string>("");
  /** 我的角色：1=普通成员 2=管理员 3=群主（缺省按普通成员=最小权限，服务端兜底）。 */
  const myRole = ref<number>(1);
  const loading = ref<boolean>(false);
  const loadFailed = ref<boolean>(false);
  const removing = ref<boolean>(false);
  const roleChanging = ref<boolean>(false);
  const contactAdding = ref<boolean>(false);
  let inited = false;
  /** allowMemberInvite 三态：""=缺省(允许) / "true" / "false"。 */
  let allowInviteRaw = "";

  const canAdd = computed((): boolean => myRole.value >= 2 || allowInviteRaw != "false");

  /** 客户端搜索：群名片/昵称/姓名/userId 包含匹配（同 @面板口径）。 */
  const filteredMembers = computed((): GmMember[] => {
    const q = query.value.trim();
    if (q.length == 0) {
      return members.value;
    }
    const out: GmMember[] = [];
    const all = members.value;
    for (let i = 0; i < all.length; i++) {
      const m = all[i];
      if (
        m.token.indexOf(q) >= 0 ||
        m.nickName.indexOf(q) >= 0 ||
        m.name.indexOf(q) >= 0 ||
        m.userId.indexOf(q) >= 0
      ) {
        out.push(m);
      }
    }
    return out;
  });

  // ===== 长按行操作浮层 / 页面触摸守卫（消息列表 message.uvue 同款，声明顺序满足
  //       UTS 先声明后调用；操作分发 handleRowMenuAct 定义在各操作处理器之后）=====
  /** 气泡操作项：key=分发标识（role/contact/remove）+ 文案 + iconfont 图标名。 */
  class GmRowMenuAct {
    key: string = "";
    label: string = "";
    icon: string = "";
    constructor(key: string, label: string, icon: string) {
      this.key = key;
      this.label = label;
      this.icon = icon;
    }
  }

  /** 长按操作浮层是否展开（无蒙层：行浅灰高亮 + 行旁锚定气泡）。 */
  const rowMenuVisible = ref<boolean>(false);
  /** 浮层指向的成员行（气泡操作分发取用）。 */
  const rowMenuMember = ref<GmMember | null>(null);
  /** 气泡操作项（按行权限生成：文案+图标，点击按 key 分发 handleRowMenuAct）。 */
  const rowMenuActs = ref<GmRowMenuAct[]>([]);
  /** 气泡定位（页面坐标系 px 样式串，长按时 createSelectorQuery 测行矩形后拼装）。 */
  const rowMenuPopStyle = ref<string>("");
  /** 长按浮层指向的行 id（rowMenuOnCls 同键：成员=userId）。 */
  let rowMenuRowId = "";
  /** 测量中转：长按落定的成员行（exec 回调取用拼装浮层）。 */
  let rowMenuPendingMember: GmMember | null = null;
  /** 页面实例（createSelectorQuery .in 锚定，message.uvue 同款）。 */
  const pageInstance = getCurrentInstance();

  // 吞击位：长按弹浮层后部分端抬手仍补发一次 click，吞掉避免误收浮层/误触行。
  // ★带时效（同 message.uvue）：Android 长按抬手通常不补发 click，flag 会一直挂着——
  //   若不过期，之后第一次点行会被白吞一次。
  let suppressNextSwipeClick = false;
  let suppressSwipeClickUntil = 0;

  /** 长按浮层行高亮 class：浮层开着且为指向行 → 浅灰底（无蒙层后的原位高亮）。 */
  function rowMenuOnCls(rowId: string): string {
    return rowMenuVisible.value && rowMenuRowId == rowId ? "gm-row--menu-on" : "";
  }

  /** 收起长按浮层（页面任意触摸/滚动/操作分发/离开页面）。 */
  function closeRowMenu(): void {
    if (rowMenuVisible.value != true) {
      return;
    }
    rowMenuVisible.value = false;
    rowMenuMember.value = null;
    rowMenuActs.value = [];
    rowMenuRowId = "";
  }

  // ===== 行点按闪亮（消息列表 message-content 同款）：按住不亮——此刻还区分不了
  //      点击/滑动；手指真实抬起（touchend）且落点位移 ≤6px = 判定为点击，此刻才挂
  //      激活底色 ~300ms（handleRowTap 的 flashRowPressed 重置计时覆盖页面转场）。
  //      位移超 6px 判滑动、触摸被取消（touchcancel，Android 滚动接管）一律不闪。
  //      ★不用 hover-class：Android 触摸被滚动接管后按压底色会粘住不灭。 =====
  const pressedRowId = ref<string>("");
  let pressedRowTimer = 0;
  /** 待判定行（touchstart 记入；位移超 6px 判滑动即清，抬手仍非空 = 点击）。 */
  let touchingRowPending = "";
  let rowTouchStartX = 0;
  let rowTouchStartY = 0;
  /** 列表滚动中（scroll 置位、160ms 静止复位）：惯性滚动中点停列表的抬手不闪。 */
  const listScrolling = ref<boolean>(false);
  let listScrollIdleTimer = 0;

  /** 行点按闪亮 class：点按判定成立后挂激活底色。 */
  function pressedRowCls(rowId: string): string {
    return pressedRowId.value == rowId ? "gm-row--active" : "";
  }

  /** 轻点行：挂激活底色 ~300ms（页面转场期间仍可见）；重复点按重置计时。 */
  function flashRowPressed(rowId: string): void {
    pressedRowId.value = rowId;
    if (pressedRowTimer != 0) {
      clearTimeout(pressedRowTimer);
    }
    pressedRowTimer = setTimeout(() => {
      pressedRowTimer = 0;
      pressedRowId.value = "";
    }, 300);
  }

  /** 清行触摸判定态（任何触摸结束路径都调它，杜绝粘滞）。 */
  function clearRowTouch(): void {
    touchingRowPending = "";
  }

  /** 行触摸开始：记起点与待判定行（按住不点亮，点亮推迟到抬手判定为点击时）。 */
  function handleRowTouchStart(rowId: string, eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    rowTouchStartX = e.touches[0].clientX;
    rowTouchStartY = e.touches[0].clientY;
    touchingRowPending = rowId;
  }

  /** 行触摸移动：位移超 6px = 判定为滑动（滚动/长按拖动），清判定态（全程无灰底）。
   *  阈值须低于 Android touchslop(≈8px)：原生滚动拦截后子视图 touchmove 断流，
   *  6px 能赶在拦截前清掉。 */
  function handleRowTouchMove(eventValue: Any): void {
    if (touchingRowPending.length == 0) {
      return;
    }
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    const dx = e.touches[0].clientX - rowTouchStartX;
    const dy = e.touches[0].clientY - rowTouchStartY;
    if (Math.abs(dx) > 6 || Math.abs(dy) > 6) {
      clearRowTouch();
    }
  }

  /** 行触摸结束：判定态仍非空 + 落点位移 ≤6px = 点击，挂激活底色 ~300ms。不闪：
   *  滚动中抬手（点停惯性滚动）；长按操作浮层开着（含长按弹层后的抬手）；
   *  落点位移复检不过（Android 滚动接管可断流、行上一个 >6px 的 move 都没送达）。
   *  点击动作仍由紧随的 click 派发（handleRowTap）。 */
  function handleRowTouchEnd(eventValue: Any): void {
    if (
      touchingRowPending.length > 0 &&
      listScrolling.value != true &&
      rowMenuVisible.value != true
    ) {
      const e = eventValue as UniTouchEvent;
      if (e.changedTouches != null && e.changedTouches.length > 0) {
        const dx = e.changedTouches[0].clientX - rowTouchStartX;
        const dy = e.changedTouches[0].clientY - rowTouchStartY;
        if (Math.abs(dx) <= 6 && Math.abs(dy) <= 6) {
          flashRowPressed(touchingRowPending);
        }
      }
    }
    clearRowTouch();
  }

  /** 触摸被取消（Android 滚动接管/系统打断）：绝不是点击，只清判定态、不闪。
   *  ★必须与 touchend 分开绑：接管 cancel 可能先于首个滚动事件到达（此刻
   *  listScrolling 仍 false），并入 touchend 会把刚起步的滚动误判为点击闪灰。 */
  function handleRowTouchCancel(): void {
    clearRowTouch();
  }

  /** 列表滚动：手势已被原生滚动接管——清行触摸判定态（防抬手误判点击闪灰；
   *  Android 子视图 touchmove 在 touchslop 拦截后断流，滚动事件是兜底清路），
   *  置滚动中标记（160ms 静止复位），并收起长按浮层（浮层开着时 direction 已锁
   *  none，实际触发多为开浮层瞬间的惯性尾巴）。 */
  function handleListScroll(): void {
    clearRowTouch();
    if (listScrolling.value != true) {
      listScrolling.value = true;
    }
    if (rowMenuVisible.value) {
      closeRowMenu();
    }
    if (listScrollIdleTimer != 0) {
      clearTimeout(listScrollIdleTimer);
    }
    listScrollIdleTimer = setTimeout(() => {
      listScrollIdleTimer = 0;
      listScrolling.value = false;
    }, 160);
  }

  // ===== 页面级触摸：吞击守卫 + 浮层点外收起（message.uvue 同款简版）=====
  let pageTouchStartX = 0;
  let pageTouchStartY = 0;
  /** 滑动 touchup 派生 click 守卫（Android）：位移 >10px 置位，50ms 后自动失效。 */
  let pageTouchSwallowed = false;
  let pageTouchResetTimer = 0;
  /** 浮层点外收起手势的吞击位：同手势稍后补发的 click 全吞（新 touchstart 复位）。 */
  let rowMenuTouchSwallowed = false;

  function handlePageTouchStart(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    pageTouchStartX = e.touches[0].clientX;
    pageTouchStartY = e.touches[0].clientY;
    rowMenuTouchSwallowed = false;
    // 长按浮层：任意页面触摸即收起（气泡内触摸已被气泡根 @touchstart.stop 阻断冒泡，
    // 必在气泡外）；同手势稍后补发的 click 全吞——点外只关浮层，不穿透进操作/入口
    if (rowMenuVisible.value) {
      closeRowMenu();
      rowMenuTouchSwallowed = true;
    }
  }

  /** 页面触摸结束：位移超阈值 = 滑动手势，短暂置吞击位（Android 滑动 touchup 可能
   *  派生 click）。★须先于 handlePageTouchEnd/Cancel 声明（UTS 不提升）。 */
  function finishPageTouch(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    if (e.changedTouches == null || e.changedTouches.length == 0) {
      return;
    }
    const tc = e.changedTouches[0];
    const dx = tc.clientX - pageTouchStartX;
    const dy = tc.clientY - pageTouchStartY;
    if (Math.abs(dx) <= 10 && Math.abs(dy) <= 10) {
      return;
    }
    pageTouchSwallowed = true;
    if (pageTouchResetTimer != 0) {
      clearTimeout(pageTouchResetTimer);
    }
    pageTouchResetTimer = setTimeout(() => {
      pageTouchResetTimer = 0;
      pageTouchSwallowed = false;
    }, 50);
  }

  function handlePageTouchEnd(eventValue: Any): void {
    finishPageTouch(eventValue);
  }

  function handlePageTouchCancel(eventValue: Any): void {
    finishPageTouch(eventValue);
  }

  /** click 入口守卫：true=本次 click 由滑动 touchup 派生、或「浮层点外收起」手势产生，应吞掉。 */
  function pageTapSwallowed(): boolean {
    return pageTouchSwallowed || rowMenuTouchSwallowed;
  }

  /** 行点击守卫：长按浮层开着时点任意行=收浮层并吞掉本次点击；长按抬手补发的 click
   *  只吞不关（浮层刚弹出须保持）。返回 true 表示调用方直接 return。 */
  function rowClickIntercept(): boolean {
    if (pageTapSwallowed()) {
      suppressNextSwipeClick = false;
      return true;
    }
    if (suppressNextSwipeClick) {
      suppressNextSwipeClick = false;
      // 时效内的 click 视为长按抬手补发：只吞不关；超时才到的是真实点击，落到收浮层分支
      if (Date.now() <= suppressSwipeClickUntil) {
        return true;
      }
    }
    if (rowMenuVisible.value) {
      closeRowMenu();
      return true;
    }
    return false;
  }

  /** 行点击：浮层开着时只收起/吞击（见 rowClickIntercept）；否则进成员资料页（微信式，
   *  姓名/头像传原始值——勿传解析出的 blob: 地址，资料页自行解析用户名与联系人状态；
   *  不带 fromConvId：群会话 ≠ 成员单聊会话，「发消息」建的新 P2P 会话须 redirectTo）。 */
  function handleRowTap(m: GmMember): void {
    if (rowClickIntercept()) {
      return;
    }
    // 重置闪亮计时：覆盖 navigateTo 页面转场期间行保持激活底色（微信式）
    flashRowPressed(m.userId);
    uni.navigateTo({
      url:
        `/subpackages/pages/im-user-info/im-user-info?userId=${m.userId}` +
        `&name=${encodeURIComponent(m.token)}&avatar=${encodeURIComponent(m.avatarRaw)}`,
    });
  }

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  function handleAvatarError(m: GmMember): void {
    m.avatarFailed = true;
  }

  /** 批量解析头像展示地址（/api/f/ 受保护与远程 SVG；H5 裸连 <img> 会被 ORB 拦）。
   * ★须在 members.value 赋值后调、行取自 ref 数组（响应式代理实例），异步写回才会
   * 触发渲染刷新——建行期 new 出的裸实例上写回不刷新（message.uvue resolveConvRowsIcons 同款）。 */
  function resolveRowAvatars(): void {
    const live = members.value;
    for (let i = 0; i < live.length; i++) {
      const row = live[i];
      const raw = row.avatarRaw;
      if (raw.length == 0 || row.avatar.length > 0) {
        continue;
      }
      resolveImAvatarDisplay(raw, 72).then((resolved: string) => {
        if (resolved != raw && resolved != row.avatar) {
          row.avatar = resolved;
          row.avatarFailed = false; // 首帧失败可能已标死字母兜底，解析成功救回
        }
      });
    }
  }

  // ===== 行级权限（对齐 PC lib/memberList：服务端才是权威，这里只控入口） =====

  /** 删除：群主可删管理员+普通成员；管理员只能删普通成员；谁都不能删自己/群主。 */
  function canRemoveOf(m: GmMember): boolean {
    if (m.self || m.role == 3) {
      return false;
    }
    if (myRole.value == 3) {
      return true;
    }
    if (myRole.value == 2) {
      return m.role <= 1;
    }
    return false;
  }

  /** 设/撤管理员：★仅群主（requireOwner），不能对自己、不能对群主。 */
  function canRoleOf(m: GmMember): boolean {
    return myRole.value == 3 && m.self != true && m.role != 3;
  }

  /** 添加到智联录：非本人，且当前无任何联系人关系（已互加/申请中都不再给按钮）。 */
  function canContactOf(m: GmMember): boolean {
    return m.self != true && m.contactState.length == 0;
  }

  /** 设置群名片：与删除同口径（服务端 canManage：群主>管理员>普通成员，同级不可
   *  互管；不能给自己——本人走群设置的 members/me，群主无人可管）。 */
  function canCardOf(m: GmMember): boolean {
    return canRemoveOf(m);
  }

  // ===== 长按行操作浮层：定位与入口（行矩形测量 → 气泡几何拼装，message.uvue 同款）=====

  /** 行矩形测量回调（具名函数：深层箭头块会触发 UTS 截断编译）。测行 + .gm-page 两矩形，
   *  视口坐标换算页面坐标（浮层 absolute 挂 .gm-page 布局流）；测不到行矩形则放弃弹层。 */
  function onRowMenuRectsMeasured(results: Array<any>): void {
    let rowTopPx = -1;
    let rowBottomPx = -1;
    let rowLeftPx = -1;
    if (results.length > 0) {
      const raw = results[0];
      if (raw != null) {
        const rect = raw as NodeInfo;
        if (rect.top != null) {
          rowTopPx = parseFloat(`${rect.top}`);
        }
        if (rect.bottom != null) {
          rowBottomPx = parseFloat(`${rect.bottom}`);
        }
        if (rect.left != null) {
          rowLeftPx = parseFloat(`${rect.left}`);
        }
      }
    }
    if (rowTopPx < 0 || rowBottomPx <= rowTopPx) {
      console.log("[GmRowMenu] measure failed, skip open");
      return;
    }
    // .gm-page 原点与高度（视口系）：浮层页面坐标 = 视口坐标 - 页面原点；高度供气泡
    // 上下空间判定（下方余量 = 页高 - 行底）；测不到按铺满视口兜底
    let pageTopPx = 0;
    let pageLeftPx = 0;
    let pageHpx = 0;
    if (results.length > 1) {
      const pageRaw = results[1];
      if (pageRaw != null) {
        const pageRect = pageRaw as NodeInfo;
        if (pageRect.top != null) {
          pageTopPx = parseFloat(`${pageRect.top}`);
        }
        if (pageRect.left != null) {
          pageLeftPx = parseFloat(`${pageRect.left}`);
        }
        if (pageRect.height != null) {
          pageHpx = parseFloat(`${pageRect.height}`);
        }
      }
    }
    const holeTop = rowTopPx - pageTopPx;
    const holeBottom = rowBottomPx - pageTopPx;
    const holeLeft = rowLeftPx - pageLeftPx;
    // 操作项按行权限生成（危险操作删除排末位，同消息列表气泡排序）；
    // 图标取 iconfont 既有字形（svg-icon 32rpx，同尺寸不同形）
    const m = rowMenuPendingMember;
    const acts: GmRowMenuAct[] = [];
    if (m != null) {
      if (canRoleOf(m)) {
        acts.push(
          new GmRowMenuAct(
            "role",
            m.role == 2 ? t("Mobile.Message.revokeManager") : t("Mobile.Message.setAsManager"),
            "icon-User",
          ),
        );
      }
      if (canCardOf(m)) {
        acts.push(new GmRowMenuAct("card", t("Mobile.Message.setGroupCard"), "icon-Edit"));
      }
      if (canContactOf(m)) {
        acts.push(new GmRowMenuAct("contact", t("Mobile.Message.addToDirectory"), "icon-a-Pluscircle"));
      }
      if (canRemoveOf(m)) {
        acts.push(new GmRowMenuAct("remove", t("Mobile.Common.delete"), "icon-a-trashcan"));
      }
    }
    if (acts.length == 0) {
      return;
    }
    rowMenuMember.value = m;
    rowMenuActs.value = acts;
    rowMenuRowId = m != null ? m.userId : "";
    // 气泡几何与样式表对齐：宽 300rpx 固定（CSS；比消息列表宽，「添加到智联录」不截断），
    // 高 = 项高 88rpx×N + 垂直内边距 8rpx×2；
    // 上下空间实测判定：上方余量够（含 10rpx 间距）弹行上方，否则下方，两侧都不够挑空间
    // 大的一侧并钳回页面内；左对齐行内容（32rpx 行内边距），右缘越屏则钳到距右缘 12px
    const win = uni.getWindowInfo();
    const scale = win.windowWidth / 750;
    if (pageHpx <= 0) {
      pageHpx = win.windowHeight - pageTopPx;
    }
    const popWpx = 300 * scale;
    const popHpx = (acts.length * 88 + 16) * scale;
    const gapPx = 10 * scale;
    const spaceAbovePx = holeTop;
    const spaceBelowPx = pageHpx - holeBottom;
    let popTop = -1;
    if (spaceAbovePx >= popHpx + gapPx) {
      popTop = holeTop - gapPx - popHpx;
    } else if (spaceBelowPx >= popHpx + gapPx) {
      popTop = holeBottom + gapPx;
    } else {
      popTop = spaceAbovePx >= spaceBelowPx ? holeTop - gapPx - popHpx : holeBottom + gapPx;
      const maxTop = pageHpx - popHpx - 6;
      if (popTop > maxTop) {
        popTop = maxTop < 6 ? 6 : maxTop;
      }
      if (popTop < 6) {
        popTop = 6;
      }
    }
    let popLeft = holeLeft + 32 * scale;
    const maxLeft = win.windowWidth - 12 - popWpx;
    if (popLeft > maxLeft) {
      popLeft = maxLeft < 12 ? 12 : maxLeft;
    }
    rowMenuPopStyle.value = "top: " + popTop.toString() + "px; left: " + popLeft.toString() + "px;";
    rowMenuVisible.value = true;
  }

  /** 长按弹操作浮层入口：记中转数据并测量行矩形（回调里定位气泡并展开）。
   *  置吞击位：部分端长按抬手仍补发一次 click，rowClickIntercept 只吞不关（浮层保持）。 */
  function openRowMenu(m: GmMember): void {
    suppressNextSwipeClick = true;
    suppressSwipeClickUntil = Date.now() + 600;
    rowMenuPendingMember = m;
    const pageProxy = pageInstance != null ? pageInstance.proxy : null;
    if (pageProxy == null) {
      return;
    }
    uni.createSelectorQuery()
      .in(pageProxy)
      .select("#row-" + m.userId)
      .boundingClientRect()
      .select(".gm-page")
      .boundingClientRect()
      .exec(onRowMenuRectsMeasured);
  }

  /** 成员行长按：无任何可用操作（自己/群主行/普通成员视角看别人等）不弹浮层。 */
  function handleMemberRowLongPress(m: GmMember): void {
    if (!canRemoveOf(m) && !canRoleOf(m) && !canCardOf(m) && !canContactOf(m)) {
      return;
    }
    openRowMenu(m);
  }

  // Android 返回先关浮层（popupBackRegistry，同消息列表）——所有收起路径
  // （closeRowMenu/页面任意触摸/滚动/onHide）都改 rowMenuVisible，必经此 watch 注册/注销
  let rowMenuBackId = 0;
  watch(rowMenuVisible, (val: boolean) => {
    if (val == true) {
      if (rowMenuBackId == 0) {
        rowMenuBackId = registerPopupClose(closeRowMenu);
      }
    } else if (rowMenuBackId != 0) {
      unregisterPopupClose(rowMenuBackId);
      rowMenuBackId = 0;
    }
  });

  /** 气泡根吞 touchstart/touchend/touchcancel（.stop 阻断冒泡）：页面级「点外收起」
   *  不把气泡内触摸当点外。★touchend 也必须断：页面根的 finishPageTouch 拿不到本手势
   *  起点（仍是长按手势的旧坐标），气泡点击落点与旧起点位移 >10px 会被误判「滑动派生
   *  click」置吞击位，紧随的 item click 在 handleRowMenuAct 首行被 pageTapSwallowed
   *  白吞（message.uvue 已踩过：全部操作按钮点了没反应的根因）。 */
  function swallowRowMenuTouch(): void {}

  /** 气泡根节点吞点击：点在气泡空白区不落穿到下方行/入口。 */
  function handleRowMenuPopTap(): void {}

  /** 把 apiImContacts 的关系状态写到成员行（1/2/3 之外一律当无关系）。 */
  async function markContacts(rows: GmMember[]): Promise<void> {
    try {
      const res = await apiImContacts();
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj == null) {
        return;
      }
      const itemsRaw = dataObj["items"];
      if (itemsRaw == null) {
        return;
      }
      const items = itemsRaw as UTSJSONObject[];
      for (let i = 0; i < items.length; i++) {
        const id = readString(items[i], "userId");
        const st = readString(items[i], "status");
        if (id.length == 0 || (st != "1" && st != "2" && st != "3")) {
          continue;
        }
        for (let j = 0; j < rows.length; j++) {
          if (rows[j].userId == id) {
            rows[j].contactState = st;
          }
        }
      }
    } catch (_error) {
      // 静默
    }
  }

  /** 详情（myRole/邀请开关）+ 成员列表 + 智联录关系标记。 */
  async function loadAll(): Promise<void> {
    if (convId.value.length == 0 || loading.value) {
      return;
    }
    loading.value = true;
    loadFailed.value = false;
    try {
      const res = await apiImConvDetail(convId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj != null) {
          myRole.value = readNumber(dataObj, "myRole", 1);
          const inviteRaw = dataObj["allowMemberInvite"];
          allowInviteRaw = inviteRaw == null ? "" : `${inviteRaw}`;
        }
      }
      const mres = await apiImConvMembers(convId.value);
      if (apiResCode(mres) != SUCCESS_CODE) {
        loading.value = false;
        loadFailed.value = true;
        return;
      }
      const mdataRaw = apiResData<any>(mres);
      const mdataObj = mdataRaw != null ? (mdataRaw as UTSJSONObject) : null;
      const out: GmMember[] = [];
      if (mdataObj != null) {
        const recordsRaw = mdataObj["records"];
        if (recordsRaw != null) {
          const records = recordsRaw as UTSJSONObject[];
          for (let i = 0; i < records.length; i++) {
            const m = new GmMember();
            m.userId = readString(records[i], "userId");
            m.name = readString(records[i], "name");
            m.nickName = readString(records[i], "nickName");
            m.avatarRaw = readString(records[i], "avatar");
            m.avatar = imAvatarDisplayUrl(m.avatarRaw, 72);
            m.role = readNumber(records[i], "role", 1);
            m.self = readBool(records[i], "self");
            m.token = m.nickName.length > 0
              ? m.nickName
              : m.name.length > 0
                ? m.name
                : `用户${m.userId}`;
            if (m.userId.length > 0) {
              out.push(m);
            }
          }
        }
      }
      // 群主(3)→管理员(2)→普通成员(1) 端上稳定分区排序：服务端 listMembers 走
      // ORDER BY user_id（cursor 分页语义绑 user_id 序，后端不能随意改排序），
      // 无角色分区；稳定排序保持同级内原 user_id 序
      out.sort((a: GmMember, b: GmMember): number => b.role - a.role);
      members.value = out;
      resolveRowAvatars();
      loading.value = false;
      inited = true;
      // 智联录关系标记（决定「添加到智联录」按钮显隐）；失败静默=当无关系处理
      await markContacts(out);
    } catch (_error) {
      loading.value = false;
      loadFailed.value = true;
    }
  }

  function handleRetry(): void {
    if (loadFailed.value) {
      loadAll();
    }
  }

  // ===== 成员操作：删除（★不做二次确认，用户拍板） =====
  async function removeMember(m: GmMember): Promise<void> {
    if (removing.value) {
      return;
    }
    removing.value = true;
    try {
      const res = await apiImGroupRemoveMember(convId.value, m.userId);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.groupRemoveSuccess"), icon: "none" });
        const rows = members.value;
        for (let i = 0; i < rows.length; i++) {
          if (rows[i].userId == m.userId) {
            rows.splice(i, 1);
            break;
          }
        }
      } else {
        uni.showToast({ title: apiResMessage(res), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
    removing.value = false;
  }

  function handleDeleteTap(m: GmMember): void {
    removeMember(m);
  }

  // ===== 成员操作：设/撤管理员（撤管理员二次确认；设管理员直接执行） =====
  async function setMemberRole(m: GmMember, role: number): Promise<void> {
    if (roleChanging.value || convId.value.length == 0) {
      return;
    }
    roleChanging.value = true;
    try {
      const res = await apiImGroupSetMemberRole(convId.value, m.userId, role);
      if (apiResCode(res) == SUCCESS_CODE) {
        // data=false：已是目标角色没写库（DEV-39），提示没变化即可
        const dataRaw = apiResData<any>(res);
        const changed = dataRaw != null && `${dataRaw}` == "true";
        if (changed) {
          uni.showToast({
            title: role == 2 ? t("Mobile.Message.setManagerDone") : t("Mobile.Message.revokeManagerDone"),
            icon: "none",
          });
          // ★服务端会向全群广播 SYSTEM 消息：这里只刷新列表，勿在本地补造通知
          await loadAll();
        } else {
          uni.showToast({ title: t("Mobile.Message.memberRoleNoChange"), icon: "none" });
        }
      } else {
        uni.showToast({ title: apiResMessage(res), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
    roleChanging.value = false;
  }

  // ===== 紧凑确认弹窗（撤销管理员二次确认）=====
  const confirmModalRef = ref<any | null>(null);
  /** 待撤销管理员的成员行（确认回调取用；取消由下次打开覆盖）。 */
  let pendingRevokeMember: GmMember | null = null;

  function handleRoleTap(m: GmMember): void {
    if (roleChanging.value) {
      return;
    }
    if (m.role == 2) {
      // 撤销管理员：紧凑确认弹窗
      pendingRevokeMember = m;
      const params = new Map<string, string | number>();
      params.set("name", m.token);
      const proxy = confirmModalRef.value as ComponentPublicInstance | null;
      if (proxy == null) {
        return;
      }
      proxy.$callMethod(
        "open",
        t("Mobile.Message.revokeManager"),
        translateFn("Mobile.Message.revokeManagerTip", toI18nParams(params), ""),
        t("Mobile.Message.revokeManagerConfirm"),
      );
    } else {
      setMemberRole(m, 2);
    }
  }

  /** 撤销管理员确认：降为普通成员（弹窗组件负责关闭自身）。 */
  function handleRevokeManagerConfirm(): void {
    const m = pendingRevokeMember;
    pendingRevokeMember = null;
    if (m != null) {
      setMemberRole(m, 1);
    }
  }


  // ===== 成员操作：添加到智联录（不传 direct：走申请/对方同意链路） =====
  async function handleContactTap(m: GmMember): Promise<void> {
    if (m.contactState.length > 0 || contactAdding.value) {
      return;
    }
    contactAdding.value = true;
    try {
      const res = await apiImAddContact(m.userId, "");
      if (apiResCode(res) == SUCCESS_CODE) {
        // ContactAddResult：accepted 决定文案；alreadyContact=早已是联系人
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        let accepted = false;
        let already = false;
        if (dataObj != null) {
          accepted = readBool(dataObj, "accepted");
          already = readBool(dataObj, "alreadyContact");
        }
        if (already) {
          m.contactState = "1";
          uni.showToast({ title: t("Mobile.Message.alreadyContact"), icon: "none" });
        } else if (accepted) {
          m.contactState = "1";
          uni.showToast({ title: t("Mobile.Message.contactAdded"), icon: "none" });
        } else {
          m.contactState = "3";
          uni.showToast({ title: t("Mobile.Message.contactRequestSent"), icon: "none" });
        }
      } else {
        uni.showToast({ title: apiResMessage(res), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Message.addContactFailed"), icon: "none" });
    }
    contactAdding.value = false;
  }

  // ===== 成员操作：设置群名片（跳 im-group-nickname 页给他人流程；保存后返回本页
  //       onShow 整表刷新，卡片名/搜索口径随之更新） =====
  function handleCardTap(m: GmMember): void {
    // 标题取行上展示名 token（名片>姓名，与列表所见一致）；★勿取 m.name——那是
    // 平台账号名（如 nuwax），长按「邱超」弹「设置 nuwax 的群名片」会认不出人
    uni.navigateTo({
      url:
        `/subpackages/pages/im-group-nickname/im-group-nickname?convId=${convId.value}` +
        `&userId=${m.userId}&name=${encodeURIComponent(m.token)}` +
        `&nick=${encodeURIComponent(m.nickName)}`,
    });
  }

  /**
   * 气泡操作分发（按 act.key，拼装顺序见 onRowMenuRectsMeasured）：先取行数据再收浮层——
   * closeRowMenu 会清 rowMenuMember；收完再执行，确认弹窗不被气泡挡住。气泡内点击是
   * 明确意图：清吞击位，避免后续入口的 rowClickIntercept 白吞。
   */
  function handleRowMenuAct(index: number): void {
    if (pageTapSwallowed()) {
      return;
    }
    const acts = rowMenuActs.value;
    if (index < 0 || index >= acts.length) {
      return;
    }
    const actKey = acts[index].key;
    const m = rowMenuMember.value;
    closeRowMenu();
    suppressNextSwipeClick = false;
    if (m == null) {
      return;
    }
    if (actKey == "role") {
      handleRoleTap(m);
    } else if (actKey == "card") {
      handleCardTap(m);
    } else if (actKey == "contact") {
      handleContactTap(m);
    } else if (actKey == "remove") {
      handleDeleteTap(m);
    }
  }

  // ===== 添加成员（复用添加伙伴弹窗的群模式） =====
  const addBuddySheetRef = ref<any | null>(null);

  function openAddMember(): void {
    // 头部入口在 scroll-view 外（点外收起触摸够不到）：开弹窗前先收长按浮层
    closeRowMenu();
    const proxy = addBuddySheetRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("openForGroup", convId.value);
  }

  /** 弹窗内添加成功：刷新成员列表（含 myRole/关系标记整套）。 */
  function handleMemberAdded(_conv: string): void {
    loadAll();
  }

  function handleBack(): void {
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      switchMainTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    loadAll();
  });

  // 搜索过滤会整表重排（气泡锚定的行矩形失效）：输入即收浮层
  watch(query, (_val: string) => {
    closeRowMenu();
  });

  onShow(() => {
    // 从群设置/公告等子页返回：刷新列表（角色/成员可能已变）
    if (inited) {
      loadAll();
    }
  });

  onHide(() => {
    // 跳转/切后台收起长按浮层，返回时不残留
    closeRowMenu();
  });
</script>

