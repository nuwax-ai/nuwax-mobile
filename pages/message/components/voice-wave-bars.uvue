<template>
  <!--
    语音气泡声波条（行级局部渲染组件）：4 根 bar，播放中 150ms 一跳
    （高度 = 基线 + 随机抖动模拟音量，按住说话浮层同款手法）。
    ★跳动 tick 只在本组件内写：原页面级 voiceTick 每 150ms 触发整页重渲染，
    iOS 上会连带 textarea 绑定重放到原生 UITextView、打断拼音组字
    （2026-10-20 真机：播放语音时中文打不进去、英文正常；Android 不受影响）。
    抽组件后每拍只重渲染本组件 4 根 bar。播放态由页面比对 playingAudioId
    传入 boolean prop（原始类型，避开类实例 prop 模板推断 any 坑）。
  -->
  <view class="voice-bars">
    <view
      class="voice-bars__bar"
      :class="playing ? 'voice-bars__bar--playing' : ''"
      :style="{ height: barH(0, tick) + 'px' }"
    />
    <view
      class="voice-bars__bar"
      :class="playing ? 'voice-bars__bar--playing' : ''"
      :style="{ height: barH(1, tick) + 'px' }"
    />
    <view
      class="voice-bars__bar"
      :class="playing ? 'voice-bars__bar--playing' : ''"
      :style="{ height: barH(2, tick) + 'px' }"
    />
    <view
      class="voice-bars__bar"
      :class="playing ? 'voice-bars__bar--playing' : ''"
      :style="{ height: barH(3, tick) + 'px' }"
    />
  </view>
</template>

<script setup lang="uts">
  import { onUnmounted, ref, watch } from "vue";

  const props = defineProps<{
    /** 该条语音是否播放中（页面：msg.msgId == playingAudioId）。 */
    playing: boolean;
  }>();

  /** 声波条静态高度 px（两侧低中间高）。 */
  const VOICE_BAR_BASE: number[] = [7, 14, 10, 5];

  /** 本组件私有跳动 tick（150ms +1）。模板绑定以尾参直读它——App-Android
   * 方法调用绑定不收集方法体内依赖（页面 voiceBarH 同款规约随迁）。 */
  const tick = ref<number>(0);
  let tickTimer = 0;

  function barH(index: number, _tick: number): number {
    const base = VOICE_BAR_BASE[index];
    if (!props.playing) {
      return base;
    }
    return base + Math.random() * 6;
  }

  function startTick(): void {
    if (tickTimer != 0) {
      return;
    }
    tickTimer = setInterval((): void => {
      tick.value = tick.value + 1;
    }, 150);
  }

  function stopTick(): void {
    if (tickTimer != 0) {
      clearInterval(tickTimer);
      tickTimer = 0;
    }
  }

  // 起停由 prop 驱动：页面 playingAudioId 起播/停播各翻转一次、页面各重渲染一次，
  // 与既有行为等价；immediate 兜住「挂载即播放中」（列表增量行进场的边角）
  watch(
    (): boolean => props.playing,
    (on: boolean): void => {
      if (on) {
        startTick();
      } else {
        stopTick();
      }
    },
    { immediate: true },
  );

  onUnmounted((): void => {
    stopTick();
  });
</script>

<style>
  /* 高度定死 20px（= 最高条 14+6）：条高逐拍变，容器不变免得条随内容
     逐帧重排（原页面 .chat-voice 定高 26px 垂直居中同思路，本层兜跳动） */
  .voice-bars {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 20px;
  }

  .voice-bars__bar {
    width: 3px;
    margin: 0 1.5px;
    border-radius: 1.5px;
    background-color: #22212a;
  }

  /* 播放中：换主题色（高度由本组件 tick 驱动跳动；App 端无 height 过渡，逐帧跳即动画） */
  .voice-bars__bar--playing {
    background-color: #5147ff;
  }
</style>
