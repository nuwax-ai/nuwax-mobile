      padding-left: 8rpx;
    }

    .pill-on {
      padding: 8rpx 24rpx;
      border-radius: 28rpx;
      background-color: rgba(81, 71, 255, 0.1);

      .pill-on-text {
        font-size: 24rpx;
        color: #5147ff;
        font-weight: 600;
      }
    }

    .pill-off {
      padding: 8rpx 24rpx;
      border-radius: 28rpx;
      background-color: #f0f0f0;

      .pill-off-text {
        font-size: 24rpx;
        color: #999999;
        font-weight: 600;
      }
    }

    .volume-box {
      display: flex;
      flex-direction: row;
      align-items: center;

      .volume-label {
        font-size: 24rpx;
        color: #666666;
      }

      .volume-slider {
        width: 200rpx;
        margin: 0 12rpx;
      }
    }

    .tool-status {
      font-size: 24rpx;
      color: #999999;
      margin-right: 8rpx;

      &.tool-status-on {
        color: #07c160;
      }
    }
  }

  /* 底部固定操作栏：两按钮一行两栏 */
  .bottom-actions {
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    padding: 20rpx 24rpx;
    padding-bottom: 40rpx;
    background-color: #ffffff;
    border-top: 2rpx solid #f5f5f8;
  }

  .reprovision-btn {
    flex: 1;
    margin-right: 12rpx;
    padding: 26rpx 0;
    border-radius: 20rpx;
    background-color: rgba(81, 71, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;

    &-active {
      opacity: 0.7;
    }

    .reprovision-btn-text {
      font-size: 30rpx;
      color: #5147ff;
      font-weight: 600;
    }
  }

  .unbind-btn {
    flex: 1;
    margin-left: 12rpx;
    padding: 26rpx 0;
