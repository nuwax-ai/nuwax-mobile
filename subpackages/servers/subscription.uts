export async function apiCreateCreditOrder(data: CreateCreditOrderRequest): Promise<RequestResponse<any>> {
  const res = await request({
    url: `/api/credit/order/create?packageId=${data.packageId}&payMode=${data.payMode}`,
    method: "POST",
  });
  return res;
}

/** 创建桌搭（灵珠）订单；后端要求 application/x-www-form-urlencoded。 */
export async function apiCreateDeskBuddyOrder(
  data: CreateDeskBuddyOrderRequest,
): Promise<RequestResponse<any>> {
  const payMode = `${data.payMode}`;
  let formData = `name=${encodeURIComponent(data.name)}&phone=${encodeURIComponent(data.phone)}&address=${encodeURIComponent(data.address)}&payMode=${encodeURIComponent(payMode)}`;
  // goodsId 非空才带（后端未启用时忽略多余字段，保证旧链路不变）
  if (data.goodsId != null && data.goodsId != "") {
    formData += `&goodsId=${encodeURIComponent(data.goodsId)}`;
  }
  const header = new UTSJSONObject();
  header["Content-Type"] = "application/x-www-form-urlencoded";
  const res = await request({
    url: "/api/bill/order/desk-buddy/create",
    method: "POST",
    data: formData,
    header,
  });
  return res;
}

