<template>
  <!-- 中转启动页：不渲染任何业务内容，视觉上与 splash / 登录页同为白底，无可见跳变 -->
  <view class="launch-page"></view>
</template>

<script setup lang="uts">
  import { switchMainTab } from "@/utils/mainTabNavigation";
  import { onReady } from "@dcloudio/uni-app";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import { routeClipboardShare, routeIncomingShare } from "@/utils/appShare";
  import { routeIncomingQrLogin } from "@/utils/qrLoginNavigation";
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  import { scheduleImPushAfterLogin } from "@/utils/im/imPushClient";
  // #endif

  /**
   * App（Android / iOS / 鸿蒙）冷启动分流页，pages.json 中以 `#ifdef APP` 置于首位。
   *
   * 为什么需要它：uni-app x 的启动页在 App.onLaunch 之后仍会被创建并渲染，
   * 在 onLaunch 里 reLaunch 登录页只能“先进首页再跳登录页”——首页会闪一下，
   * 且首页挂载即发起的接口随后返回 4010，会再次踢登录页，把登录页重建一遍。
   * 因此把启动页换成这个空白中转页：未登录直接进登录页，首页根本不会被创建。
   *
   * ★首启协议弹窗已于 2026-11-04 移除（应用市场自动审核要求：同意隐私政策前不得
   *   初始化第三方 SDK / 申请权限 / 采集设备标识 / 发网络请求）。现在：
   *   - 冷启动直接分流，不再有任何拦路卡片；
   *   - 隐私告知由登录页的协议勾选框承担（login-form 未勾选不允许登录）；
   *   - 推送 SDK 初始化与通知权限申请都挪到「登录成功之后」（见 scheduleImPushAfterLogin）。
   *   历史实现（协议卡片 / 点通知进入时收卡片）已删，utils/firstLaunchAgreement.uts
   *   保留未删：老用户的「已同意」标记仍在 storage 里，后续要彻底清理再单独处理。
   *
   * 依赖保持最小（只引分流/分享/i18n 无关的轻量模块），避免为分流拉起整条请求链拖慢冷启动。
   * H5 / 小程序不走本页（条件编译已排除），其登录态由各自路由与拦截逻辑处理。
   */
  const HOME_PAGE_PATH = "/pages/message/message";
  const LOGIN_PAGE_PATH = "/subpackages/pages/login/login";

  /** 无分享意图时的常规分流：未登录进登录页，否则创建常驻主界面（默认伙伴 Tab）。 */
  function continueByAuth(token: string): void {
    if (token.length == 0) {
      uni.reLaunch({ url: LOGIN_PAGE_PATH });
      return;
    }
    // 创建常驻主界面，默认进入伙伴 Tab。
    switchMainTab({ url: HOME_PAGE_PATH });
  }

  /**
   * 启动分流：先看有没有分享意图（分享回本机 / 剪贴板待处理链接），都没有才走常规分流。
   */
  function routeByAuthState(): void {
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    const token = tokenRaw != null ? `${tokenRaw}`.trim() : "";
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    // 已登录冷启动不会触发 IM_SESSION_READY（那是「本次进程内登录」才发的事件），
    // 这里补一次：uni-push 初始化 + 通知权限申请都等登录态成立后才做，
    // 首次安装未登录时不初始化任何推送 SDK（应用市场审核要求）。
    if (token.length > 0) {
      scheduleImPushAfterLogin();
    }
    // #endif
    if (routeIncomingQrLogin(token.length > 0, "", true)) return;
    if (routeIncomingShare(token.length > 0, "")) {
      return;
    }
    routeClipboardShare(token.length > 0, (opened: boolean) => {
      if (opened) return;
      continueByAuth(token);
    });
  }

  // 后续若接入推送 / 深链唤起，需在此透传目标路径（登录态满足时直达目标页）
  onReady(() => {
    routeByAuthState();
  });
</script>

<style lang="scss" scoped>
  .launch-page {
    flex: 1;
    background-color: #ffffff;
  }
</style>
