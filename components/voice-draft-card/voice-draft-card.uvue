<template>
  <!--
    语音识别编辑卡（liveAsr 松手后的文字编辑区）：淡蓝底黑字输入卡。
    ★从 chat.uvue 抽出组件的动因：编辑卡高度须随内容行数变化（封顶滚动），若在
    chat.uvue 模板加 :style 顶层引用会顶破渲染 lambda 255 参数硬限（R8 桩
    VerifyError 整页加载失败，2026-11-03 实测）——高度计算收进本组件，
    父页模板引用数净减（加 UI 一律抽组件的仓库规约）。
    高度不启用 textarea auto-height：Android/鸿蒙原生自撑测高失准（同主输入
    chatInputAutoHeight 坑），三端统一 JS 估行驱动固定高，超封顶框内滚动。
  -->
  <view class="vd-wrap">
    <view class="vd-card" @click="handleCardTap">
      <textarea
        class="vd-card__input"
        :value="modelValue"
        :focus="focus"
        :maxlength="2000"
        :style="heightStyle"
        @input="handleInput"
        @focus="handleFocus"
        @blur="handleBlur"
      />
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";

  const props = defineProps<{
    /** 识别文本草稿（父页 v-model） */
    modelValue: string;
    /** 轻触卡片拉键盘（父页 voiceDraftFocus：true 变化触发聚焦） */
    focus: boolean;
  }>();

  const emit = defineEmits<{
    (e: "update:modelValue", value: string): void;
    (e: "focus"): void;
    (e: "blur"): void;
    (e: "cardtap"): void;
  }>();

  /** 行数估算（20px 字号：全宽≈20/半宽≈10；卡内宽=窗口−edit inset 24×2−卡 padding 14×2） */
  function estimateLines(text: string): number {
    if (text.length == 0) {
      return 1;
    }
    const w = uni.getWindowInfo().windowWidth;
    const contentWidthPx = (w != null ? w : 375) - 76;
    const segments = text.split("\n");
    let lines = 0;
    for (let sIdx = 0; sIdx < segments.length; sIdx++) {
      const seg = segments[sIdx];
      let widthPx = 0;
      for (let cIdx = 0; cIdx < seg.length; cIdx++) {
        // UTS charCodeAt 越界返回 null：先落局部判空再比较（同页面 estimateChatInputLines）
        const codeRaw = seg.charCodeAt(cIdx);
        if (codeRaw != null && codeRaw > 0x2e80) {
          widthPx += 20;
        } else {
          widthPx += 10;
        }
      }
      lines += Math.max(1, Math.ceil(widthPx / contentWidthPx));
    }
    return lines;
  }

  /** 高度样式：随内容行数 32px/行，封顶 6 行=192px（超出框内滚动） */
  const VOICE_DRAFT_LINE_PX = 32;
  const VOICE_DRAFT_MAX_LINES = 6;
  const heightStyle = computed(
    (): string => {
      const lines = estimateLines(props.modelValue);
      const clamped = Math.min(Math.max(lines, 1), VOICE_DRAFT_MAX_LINES);
      return `height: ${VOICE_DRAFT_LINE_PX * clamped}px`;
    },
  );

  function handleInput(event: UniInputEvent): void {
    emit("update:modelValue", event.detail.value);
  }

  function handleFocus(): void {
    emit("focus");
  }

  function handleBlur(): void {
    emit("blur");
  }

  function handleCardTap(): void {
    emit("cardtap");
  }
</script>

<style>
  .vd-wrap {
    display: flex;
    flex-direction: column;
  }

  /* 编辑卡：淡蓝底 + 黑字（深蒙层上的浅色输入卡）；高度随内容（textarea 内联 style 驱动） */
  .vd-card {
    background-color: #e9f2ff;
    border-radius: 12px;
    padding: 12px 14px;
  }

  /* 字号 20（较初版 15 增大 1/3），行高 32；高度由 heightStyle 内联驱动 */
  .vd-card__input {
    width: 100%;
    font-size: 20px;
    line-height: 32px;
    color: #111827;
    background-color: transparent;
  }
</style>
