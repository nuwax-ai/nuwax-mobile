<template>
  <view class="call-page">
    <safety-zone />
    <view class="call-header" @click="leave"><text class="call-back">‹</text><text class="call-back-label">{{ t("Mobile.Voip.minimize") }}</text></view>
    <view v-if="showVideo" class="call-video">
      <!-- #ifndef APP-HARMONY -->
      <nuwax-voip-video :local="false" />
      <!-- Harmony hosts both tracks in its persistent ArkWeb media view. -->
      <!-- #ifndef APP-HARMONY -->
      <view class="call-self"><nuwax-voip-video :local="true" /></view>
      <!-- #endif -->
      <!-- #endif -->
      <!-- #ifdef APP-HARMONY -->
      <button class="call-button" @click="showMedia()">{{ t("Mobile.Voip.return") }}</button>
      <!-- #endif -->
    </view>
    <view v-else class="call-avatar"><text class="call-avatar-text">{{ peerName.slice(0, 1) }}</text></view>
    <text class="call-name">{{ peerName }}</text>
    <text class="call-state">{{ status }}</text>
    <text v-if="error.length > 0" class="call-error">{{ t("Mobile.Voip.operationFailed") }}</text>
    <text v-if="phase == 'ended' && reason.length > 0" class="call-reason">{{ reason }}</text>
    <view v-if="phase == 'incoming'" class="call-controls">
      <button class="call-button call-end" @click="endVoipCall()">{{ t("Mobile.Voip.reject") }}</button>
      <button class="call-button call-answer" @click="answerVoipCall('audio')">{{ t("Mobile.Voip.answerAudio") }}</button>
      <button v-if="video" class="call-button call-answer" @click="answerVoipCall('video')">{{ t("Mobile.Voip.answerVideo") }}</button>
    </view>
    <view v-else-if="phase != 'ended' && phase != 'idle'" class="call-controls-wrap">
      <view class="call-controls">
        <button class="call-button" @click="setVoipMicrophone(!voipMicrophone)">{{ voipMicrophone ? t("Mobile.Voip.mute") : t("Mobile.Voip.unmute") }}</button>
        <button class="call-button" @click="setVoipSpeaker(!voipSpeaker)">{{ voipSpeaker ? t("Mobile.Voip.earpiece") : t("Mobile.Voip.speaker") }}</button>
        <button v-if="video" class="call-button" @click="setVoipCamera(!voipCamera)">{{ voipCamera ? t("Mobile.Voip.cameraOff") : t("Mobile.Voip.cameraOn") }}</button>
        <button v-if="video" class="call-button" @click="switchVoipCamera()">{{ t("Mobile.Voip.switchCamera") }}</button>
      </view>
      <button class="call-button call-end" @click="endVoipCall()">{{ t("Mobile.Voip.hangup") }}</button>
    </view>
    <button v-else class="call-button" @click="leave">{{ t("Mobile.Voip.close") }}</button>
    <view class="call-bottom" />
  </view>
</template>
<script setup lang="uts">
  import { ref, computed, onMounted, onUnmounted } from "vue";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  import { getVoipSnapshot, getVoipPhase, getVoipPeerName, voipRevision, voipError, voipMicrophone, voipCamera, voipSpeaker,
    answerVoipCall as answerCall, endVoipCall as endCall, setVoipMicrophone as microphone, setVoipCamera as camera, setVoipSpeaker as speaker, switchVoipCamera as flipCamera } from "@/features/voip/callManager";
  import { showNativeVoipMedia } from "@/features/voip/callManager";
  function showMedia(): void { showNativeVoipMedia(); }
  function answerVoipCall(mode: string): void { answerCall(mode); }
  function endVoipCall(): void { endCall(); }
  function setVoipMicrophone(enabled: boolean): void { microphone(enabled); }
  function setVoipCamera(enabled: boolean): void { camera(enabled); }
  function setVoipSpeaker(enabled: boolean): void { speaker(enabled); }
  function switchVoipCamera(): void { flipCamera(); }
  const now = ref(Date.now()); let timer = 0;
  const phase = computed((): string => { voipRevision.value; return getVoipPhase(); });
  const peerName = computed((): string => { voipRevision.value; return getVoipPeerName(); });
  const video = computed((): boolean => { voipRevision.value; return getVoipSnapshot()?.mediaType == "video"; });
  const showVideo = computed((): boolean => video.value && phase.value != "incoming" && phase.value != "dialing" && phase.value != "ended");
  const error = computed((): string => voipError.value);
  const reason = computed((): string => {
    voipRevision.value; const value = getVoipSnapshot()?.reason ?? "";
    if (value == "answeredElsewhere") return t("Mobile.Voip.answeredElsewhere");
    if (value == "rejected") return t("Mobile.Voip.rejected");
    if (value == "timeout") return t("Mobile.Voip.timeout");
    if (value == "cancelled") return t("Mobile.Voip.cancelled");
    return "";
  });
  const status = computed((): string => {
    if (phase.value == "active") {
      const start = getVoipSnapshot()?.connectedAt ?? 0;
      const seconds = Math.max(0, Math.floor((now.value - start) / 1000));
      return `${Math.floor(seconds / 60)}`.padStart(2, "0") + ":" + `${seconds % 60}`.padStart(2, "0");
    }
    if (phase.value == "dialing") return t("Mobile.Voip.dialing");
    if (phase.value == "incoming") return t("Mobile.Voip.incoming");
    if (phase.value == "connecting") return t("Mobile.Voip.connecting");
    if (phase.value == "reconnecting") return t("Mobile.Voip.reconnecting");
    return t("Mobile.Voip.ended");
  });
  function leave(): void {
    if (getCurrentPages().length > 1) uni.navigateBack();
    else uni.switchTab({ url: "/pages/message/message" });
  }
  onMounted(() => { timer = setInterval((): void => { now.value = Date.now(); }, 1000); });
  onUnmounted(() => { if (timer != 0) clearInterval(timer); });
</script>
<style scoped>
  .call-page { flex: 1; background-color: #151d2c; align-items: center; }
  .call-header { width: 100%; height: 48px; flex-direction: row; align-items: center; padding-left: 20px; }
  .call-back { font-size: 34px; color: #ffffff; }.call-back-label { color: #dde4f3; font-size: 14px; margin-left: 8px; }
  .call-avatar { width: 96px; height: 96px; margin-top: 65px; border-radius: 48px; background-color: #435774; align-items: center; justify-content: center; }
  .call-avatar-text { font-size: 40px; color: #ffffff; }
  .call-name { color: #ffffff; font-size: 26px; margin-top: 24px; }.call-state { color: #b4c2d8; font-size: 16px; margin-top: 14px; }
  .call-error { color: #ffb5ac; font-size: 13px; margin-top: 14px; }.call-reason { color: #b4c2d8; font-size: 14px; margin-top: 10px; }
  .call-controls-wrap { align-items: center; margin-top: auto; }.call-controls { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 40px; }
  .call-button { color: #ffffff; background-color: #35445e; font-size: 13px; border-radius: 24px; margin: 8px; padding: 4px 18px; }
  .call-end { background-color: #d83949; }.call-answer { background-color: #19844f; }.call-bottom { height: 50px; }
  .call-video { width: 100%; height: 280px; position: relative; }.call-self { position: absolute; right: 12px; top: 12px; width: 90px; height: 130px; }
</style>
