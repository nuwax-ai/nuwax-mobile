/**
 * 会话页语音 Socket 预热：进入页面预连 ASR/TTS，离开断开。
 * 页内业务（录音 / 播报）应复用已连 socket，仅在对端/网关掐断后补连。
 *
 * 注意：不要在短暂 onHide（权限弹窗等）里 teardown，否则点击时会再次 connectSocket。
 */
import { asrWebSocketClient } from "./asrWebSocketClient";
import { ttsWebSocketPlayer } from "./ttsWebSocketPlayer";

export class SpeechSocketWarmup {
  private active: boolean = false;

  /** 是否处于页面预热生命周期内 */
  isActive(): boolean {
    return this.active;
  }

  /** 进入会话页：预连 ASR + TTS（失败仅打日志，业务侧 ensure 会重试） */
  warmup(): void {
    this.active = true;
    console.log("[SpeechWarmup] warmup start");
    asrWebSocketClient.enableWarmupAndConnect();
    ttsWebSocketPlayer.enableWarmupAndConnect();
  }

  /** 离开会话页（unmount）：停止预热并断开 */
  teardown(): void {
    this.active = false;
    console.log("[SpeechWarmup] teardown");
    asrWebSocketClient.disableWarmupAndDisconnect();
    ttsWebSocketPlayer.disableWarmupAndDisconnect();
  }
}

/** 全局单例：会话页 mount/unmount 调用 */
export const speechSocketWarmup = new SpeechSocketWarmup();
