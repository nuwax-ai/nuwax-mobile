<template>
  <uni-popup ref="popupRef" :is-mask-click="maskClick">
    <view
      class="modal-wrapper"
      @touchstart="handleTouchStart"
      @touchmove="handleTouchMove"
      @touchend="handleTouchEnd"
    >
      <view
        class="modal-content"
        :class="{ 'modal-show': visible }"
        :style="contentStyle"
      >
        <view class="head-box" v-if="showHeader">
          <view class="title">
            <text class="text-ellipsis">{{ displayTitle }}</text>
          </view>
          <slot name="header-extra"></slot>
          <view class="close-btn" @tap="close" v-if="showCloseBtn">
            <svg-icon name="icon-X" />
          </view>
        </view>
        <view class="content-box">
          <slot></slot>
        </view>
      </view>
      <view class="modal-mask" @tap="close" @touchmove.stop.prevent=""></view>
    </view>
  </uni-popup>
</template>

<script setup lang="uts">
  import { ref, computed, nextTick, onUnmounted, type ComponentPublicInstance } from "vue";
  import { translateText } from "@/utils/i18n";

  const props = defineProps({
    title: {
      type: String,
      default: "",
    },
    width: {
      type: String,
      default: "80vw",
    },
    maskClick: {
      type: Boolean,
      default: true,
    },
    showHeader: {
      type: Boolean,
      default: true,
    },
    showCloseBtn: {
      type: Boolean,
      default: true,
    },
    enableSwipeClose: {
      type: Boolean,
      default: true,
    },
  });

  const emit = defineEmits(["update-visible"]);
  // Android 的 uni-popup 为生成组件实例，不能声明为自定义接口后直接调用。
  const popupRef = ref<any | null>(null);

  const visible = ref(false);
  const displayTitle = computed(() => translateText(props.title));

  const callPopupMethod = (methodName: string): void => {
    const popup = popupRef.value;
    if (popup == null) return;
    const proxy = popup as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  };

  // 滑动关闭相关状态
  const touchStartX = ref<number>(0);
  const touchStartY = ref<number>(0);
  const isSwiping = ref<boolean>(false);
  const swipeOffset = ref<number>(0);
  const swipeThreshold = 50; // 灵敏度保持与优化后的一致

  // 关闭弹窗（需在触摸回调之前定义，UTS 不提升 const 函数）
  const close = () => {
    // #ifdef H5 || WEB
    document.body.style.overflow = "";
    // #endif

    visible.value = false;
    // 等待平滑消失动画
    setTimeout(() => {
      callPopupMethod("close");
    }, 200);
    emit("update-visible", false);
  };

  const handleTouchStart = (e: UniTouchEvent) => {
    if (props.enableSwipeClose == false) return;
    if (e == null || e.touches == null || e.touches.length == 0) return;
    touchStartX.value = e.touches[0].clientX;
    touchStartY.value = e.touches[0].clientY;
    isSwiping.value = false;
    swipeOffset.value = 0;
  };

  const handleTouchMove = (e: UniTouchEvent) => {
    if (props.enableSwipeClose == false) return;
    if (e == null || e.touches == null || e.touches.length == 0) return;
    const currentX = e.touches[0].clientX;
    const currentY = e.touches[0].clientY;
    const diffX = Math.abs(currentX - touchStartX.value);
    const diffY = Math.abs(currentY - touchStartY.value);

    // 水平位移大于垂直位移且超过最小阈值，判定为水平滑动
    if (diffX > diffY && diffX > 5) {
      isSwiping.value = true;
      swipeOffset.value = currentX - touchStartX.value;
      // 仅在水平滑动时阻止默认行为
      e.preventDefault();
    }
  };

  const handleTouchEnd = (_e: UniTouchEvent) => {
    if (props.enableSwipeClose == false || isSwiping.value == false) return;

    if (Math.abs(swipeOffset.value) > swipeThreshold) {
      close();
    }

    isSwiping.value = false;
    swipeOffset.value = 0;
  };

  const contentStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    style["width"] = props.width;
    return style;
  });

  // 打开弹窗
  const open = () => {
    // #ifdef H5 || WEB
    document.body.style.overflow = "hidden";
    // #endif

    if (popupRef.value == null) {
      // 容错处理：若 popupRef 暂未就绪（如微信小程序首次渲染宏任务未跑完），则微延时重试
      setTimeout(() => {
        if (popupRef.value != null) {
          callPopupMethod("open");
          emit("update-visible", true);
          setTimeout(() => {
            visible.value = true;
          }, 20);
        }
      }, 50);
      return;
    }

    callPopupMethod("open");
    emit("update-visible", true);

    setTimeout(() => {
      visible.value = true;
    }, 20);
  };

  onUnmounted(() => {
    // #ifdef H5 || WEB
    document.body.style.overflow = "";
    // #endif
  });

  defineExpose({
    open: open as any,
    close: close as any,
    popupRef,
    visible,
  });
</script>

<style scoped lang="scss">
  @import "./modal-popup.scss";
</style>
