// #ifdef APP-HARMONY
/**
 * nuwax-uni-math 鸿蒙（HarmonyOS NEXT / ArkTS）后端 —— SVG 位图路径骨架。
 *
 * ★ 当前状态：STUB（未实现，回调固定回 { error }）。Core 收到 error 后会自动兜底回
 *   proxyWebBackend（隐藏 web-view + KaTeX），故鸿蒙端数学渲染现状 = WebView 链路，
 *   不会因缺本后端而崩。本 stub 的意义：把契约与接线占住，鸿蒙端 renderMathAsync
 *   真机/HV 验证通过后只需填充 ensureLoaded/renderSvg/rasterize 三块，无需改 Core/Backend 接线。
 *
 * ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 *  契约（与 app-android/index.uts、app-ios/index.uts 严格对齐）
 *  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 *  export function renderMathAsync(
 *      latex: string, display: boolean, dpiScale: number, color: string,
 *      onResult: (res: UTSJSONObject) => void
 *  ): void
 *  onResult 回 UTSJSONObject：
 *      成功 → { imageDataURL: "data:image/png;base64,...", width, height, svg }
 *      失败 → { error: "..." }  （Core 兜底回 proxyWebBackend）
 *
 *  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 *  鸿蒙插件结构（已对齐 uni-cmark/utssdk/app-harmony 先例 + DCloud 鸿蒙 UTS 文档）
 *  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 *  utssdk/app-harmony/
 *    ├── config.json   { "minApiLevel": "9", "dependencies": { ...未来 vendor .har } }
 *    ├── index.uts     本文件 —— UTS 编译为 ArkTS（.ets）
 *    ├── *.ets         原生 ArkTS 文件（混合编译，原样拷贝；未来 rasterize/engine 放这）
 *    ├── libs/*.har    本地鸿蒙归档（ohpm 本地依赖；如 vendor SVG/JS 引擎）
 *    └── module.json5  （需要权限/设备声明时再加；纯函数式插件可省，类 uni-cmark）
 *
 *  UTS→ArkTS 要点：any 禁用（→Object）；对象字面量自动 as UTSJSONObject；
 *     原生 API 经 @kit.* / @ohos.* 命名空间 import。
 *
 *  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 *  实现规划（待真机/HV 验证 —— 用户负责鸿蒙真机/HV 构建）
 *  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 *  SVG 位图路径在鸿蒙上分两步，各步可行性见顶部研究报告，要点摘录：
 *
 *  ① LaTeX → SVG（跑同一份 1.78MB DOM-free MathJax tex-svg bundle）
 *     方案：@ohos.vm（JSVM-API，华为稳定 ABI）建独立 JS 引擎，evaluateJS 跑 bundle，
 *           调 globalThis.renderLatexToSvg(latex, display) → SVG 字符串。
 *     可行性：HIGH —— 鸿蒙标准系统 JS 引擎历史即 QuickJS（Android 端已验证 bundle 兼容），
 *           JSVM 提供与 Android QuickJSContext 等价的 eval + 函数调用能力。
 *     待验证：JSVM 跑 1.78MB bundle 的内存峰值 / 首次 load 耗时；JSVM 是否需 NAPI 封装
 *           （UTS 能否直接 import @ohos.vm，还是要在 .ets/NAPI .so 里包一层）。
 *
 *  ② SVG → 位图（UTSJSONObject { imageDataURL, width, height }）
 *     方案 A（首选，零 vendor）：@kit.ImageKit 的 image.createImageSource(svgData).createPixelMap()
 *           → 系统自带 SvgDecoder。ArkUI <Image> 原生支持 SVG（标签 svg/rect/circle/ellipse/
 *           path/line/polyline/polygon；API 21+ supportSvg2 增强）。
 *     风险：MathJax SVG 重度使用 <defs>/<use href>/<g>（fontCache:'local' 字形内嵌 + 复用），
 *           系统解析器对 <use> 引用的支持未在公开文档列全 —— ★ 必须真机拿真实 MathJax SVG
 *           实测；若只渲染出部分字形 / 缺符号，回退方案 B。
 *     方案 B（确定 fallback，需 native build）：vendor lunasvg/nanosvg 编 .so，经 NAPI 暴露
 *           rasterize(svg, w, h) → PixelMap。本仓已有 ESP 等 NAPI/原生构建流水线可复用。
 *     位图格式：PNG（鸿蒙无原生 WebP 编码 API 的明确文档；PNG 安全）。
 *
 *  ③ 线程：JSVM 单引擎实例非线程安全 → 同 Android/iOS，专用串行 TaskPool 或 worker 串行 eval，
 *     PixelMap 栅格化同线程；结果经回主线程回调（Core.dispatchCallback 会再切主线程，故本处
 *     回调线程不强要求，但建议主线程以与 iOS 对齐）。
 *
 *  ④ bundle 路径：同 Android，uni-app x 把 uni_modules/<m>/static/ 镜像进鸿蒙包；确切子目录
 *     待 HV 验证（参照 iOS MathSvgBridge.readBundle 的多候选 + 兜底策略）。
 *
 *  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 *  native-view（原生数学排版）路径 —— 鸿蒙上暂不可行，DEFER
 *  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 *  鸿蒙 uni-app x 嵌原生组件的机制与 Android/iOS 完全不同：
 *    - 用 defineNativeEmbed('tag', { builder }) 在 .ets 里注册 ArkUI @Component；
 *    - 前端用 <embed tag="x-native-math" :options="...">（不是 <native-view>）；
 *    - HBuilderX 4.62+ 支持；要求组件定义在 .ets 中。
 *  ⇒ 现有 components/x-native-math/x-native-math.uvue（用 <native-view> + bindAndroidView）
 *    不能直接在鸿蒙复用，需要单独的 <embed> 变体组件。
 *  ⇒ 更关键的阻塞：鸿蒙 NEXT 目前【没有】AndroidMath/iosMath 的等价数学排版库
 *    （社区 ArkTS Markdown+LaTeX 方案对含数学段落也是退回 WebView，仅纯文本段做
 *    LaTeX-to-Unicode fallback）。即便写好 <embed> 壳，也无引擎可填。
 *  ⇒ 结论：native-view 鸿蒙路径无限期搁置，等鸿蒙出现原生数学排版库（或自研 TeX→ArkUI Path
 *    渲染器，工程量大不进当前范围）。SVG 位图路径是鸿蒙上唯一可工程化的原生路径。
 */

/**
 * 鸿蒙端数学渲染 stub：立即回调 { error }，由 Core 兜底回 proxyWebBackend。
 *
 * 真机/HV 验证通过后，把本函数体替换为：JSVM 跑 MathJax → SVG → ImageKit/lunasvg 栅格化 →
 * UTSJSONObject { imageDataURL, width, height, svg }，签名与注释契约保持不变。
 */
export function renderMathAsync(
	latex: string,
	display: boolean,
	dpiScale: number,
	color: string,
	onResult: (res: UTSJSONObject) => void,
): void {
	const res = new UTSJSONObject()
	res["error"] = "harmony_not_implemented"
	onResult(res)
}
// #endif
