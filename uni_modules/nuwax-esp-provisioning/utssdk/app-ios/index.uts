import type {
  NativeEspDeviceCallback,
  NativeEspFailureCallback,
  NativeEspLogCallback,
  NativeEspProgressCallback,
  NativeEspSuccessCallback,
} from '../interface.uts';

// iOS 混编：同目录 EspProvisioningBridge.swift 中的 public 类对 UTS 直接可见（无需 import，
// Swift 同编译单元符号全局可见，见 uts-plugin-hybrid 文档）。这里直接以其静态方法 + UTS 闭包调用。

export function initializeNativeEspProvisioning(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  // iOS 蓝牙无需运行时授权弹窗由系统在使用时触发；初始化仅置位，真正的状态校验在扫描时回调
  success('');
}

/**
 * 注册原生日志 sink，把 [EspBridge] 诊断行转发到 UTS（调用方负责 console.log 到 HBuilderX）。
 * @UTSJS.keepAlive：sink 会被原生层多次调用（每次 fwd 诊断行），必须保活，否则首次调用后被自动回收。
 */
@UTSJS.keepAlive
export function setNativeEspLog(cb: NativeEspLogCallback): void {
  EspProvisioningBridge.setLog(cb);
}

@UTSJS.keepAlive
export function startNativeEspScan(
  prefix: string,
  serviceUuid: string,
  onDevice: NativeEspDeviceCallback,
  fail: NativeEspFailureCallback,
): void {
  EspProvisioningBridge.startScan(prefix, serviceUuid, onDevice, fail);
}

export function stopNativeEspScan(): void {
  EspProvisioningBridge.stopScan();
}

export function connectNativeEspDevice(
  deviceId: string,
  serviceUuid: string,
  username: string,
  proofOfPossession: string,
  timeoutMs: number,
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  EspProvisioningBridge.connect(
    deviceId,
    serviceUuid,
    username,
    proofOfPossession,
    timeoutMs,
    success,
    fail,
  );
}

export function getNativeEspCapabilities(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  EspProvisioningBridge.getCapabilities(success, fail);
}

export function getNativeEspDeviceInfo(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  EspProvisioningBridge.getDeviceInfo(success, fail);
}

/** 向固件自定义 endpoint 写数据（payload 为 JSON 字符串），成功回调返回设备响应 JSON 字符串 */
export function sendNativeEspCustomData(
  endpoint: string,
  payload: string,
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  EspProvisioningBridge.sendCustomData(endpoint, payload, success, fail);
}

export function scanNativeEspNetworks(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  EspProvisioningBridge.scanNetworks(success, fail);
}

@UTSJS.keepAlive
export function provisionNativeEspDevice(
  ssid: string,
  password: string,
  timeoutMs: number,
  progress: NativeEspProgressCallback,
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  EspProvisioningBridge.provision(ssid, password, timeoutMs, progress, success, fail);
}

export function disconnectNativeEspDevice(): void {
  EspProvisioningBridge.disconnect();
}

export function disposeNativeEspProvisioning(): void {
  EspProvisioningBridge.dispose();
}
