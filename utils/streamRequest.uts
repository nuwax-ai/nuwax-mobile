import { StreamRequestConfig, StreamChunk } from "@/types/interfaces/chat";
import { createSSEConnection } from "@/servers/useRequest.uts";
import { utf8ArrayToString } from "@/utils/utf8.uts";
import { t } from "@/utils/i18n";
import { readRawField } from "@/subpackages/utils/messageInfoClass.uts";

/** onChunkReceived 回调结果（Android 为原生 RequestTaskOnChunkReceivedListenerResult） */
interface ChunkReceivedResult {
  data: ArrayBuffer | null;
}

/**
 * 合并两个 Uint8Array。
 * UTS 中 Uint8Array.set 不支持带偏移写入另一数组，因此用循环拼接。
 * @param first 前一段字节
 * @param second 后一段字节
 * @returns 合并后的新数组
 */
function mergeUint8Arrays(first: Uint8Array, second: Uint8Array): Uint8Array {
  const merged = new Uint8Array(first.length + second.length);
  for (let i = 0; i < first.length; i++) {
    merged[i] = first[i];
  }
  for (let j = 0; j < second.length; j++) {
    merged[first.length + j] = second[j];
  }
  return merged;
}

/**
 * 构建 HTTP 错误提示文案。
 * UTS 中 i18n 插值参数需使用 Map，不能传对象字面量。
 * @param statusCode HTTP 状态码
 * @returns 本地化后的错误信息
 */
function buildHttpErrorMessage(statusCode: number): string {
  const params = new Map<string, string | number>();
  params.set("code", statusCode);
  return t("Mobile.Stream.httpErrorWithCode", params as Record<string, string | number>);
}

/**
 * 创建流式内容块。
 * UTS 中 StreamChunk 为 class，不能用对象字面量初始化。
 * @param data SSE 数据内容
 * @returns 类型为 content 的 StreamChunk 实例
 */
function createContentChunk(data: string): StreamChunk {
  const chunk = new StreamChunk();
  chunk.type = "content";
  chunk.data = data;
  return chunk;
}

/**
 * 判断 SSE 载荷是否表示流已结束。
 * Android：completed 可能是 boolean / 字符串 / 数字，禁止仅判断 == true。
 */
function isCompletedPayload(data: any): boolean {
  if (data == null) {
    return false;
  }
  const completedRaw = readRawField(data, "completed");
  if (completedRaw == true) {
    return true;
  }
  const completedStr = completedRaw != null ? `${completedRaw}` : "";
  return completedStr == "true" || completedStr == "1";
}

/** 心跳包，不含 data */
function isSseHeartBeatPayload(data: any): boolean {
  const eventTypeRaw = readRawField(data, "eventType");
  return eventTypeRaw != null && `${eventTypeRaw}` == "HEART_BEAT";
}

/** 不应下发给业务 onChunk 的 SSE 载荷（无 data 的完成包 / 心跳等） */
function shouldSkipSsePayloadEmit(data: any): boolean {
  if (data == null) {
    return true;
  }
  if (isCompletedPayload(data)) {
    return true;
  }
  if (isSseHeartBeatPayload(data)) {
    return true;
  }
  return readRawField(data, "data") == null;
}

/**
 * 判断错误是否为用户主动中止请求（AbortError）。
 * @param error 捕获到的错误对象
 * @returns 是 AbortError 时返回 true
 */
function isAbortError(error: any): boolean {
  if (error == null) {
    return false;
  }
  const errorObj = error as UTSJSONObject;
  const name = errorObj["name"];
  return name != null && `${name}` === "AbortError";
}

/**
 * 安全读取错误对象的 message 字段。
 * @param error 捕获到的错误对象
 * @returns 错误信息字符串，无 message 时返回空字符串
 */
function getErrorMessage(error: any): string {
  if (error == null) {
    return "";
  }
  const errorObj = error as UTSJSONObject;
  const message = errorObj["message"];
  return message != null ? `${message}` : "";
}

/**
 * 从 onChunkReceived 回调参数中提取 ArrayBuffer。
 * 官方文档为 { data: ArrayBuffer }；APP 端部分运行时直接传入 ArrayBuffer。
 * @param chunkResult onChunkReceived 回调参数
 * @returns 分块字节数据，无法识别时返回 null
 */
function extractChunkArrayBuffer(chunkResult: any): ArrayBuffer | null {
  if (chunkResult == null) {
    return null;
  }

  // Android APP：原生 RequestTaskOnChunkReceivedListenerResult，禁止 as UTSJSONObject
  try {
    const listener = chunkResult as ChunkReceivedResult;
    const listenerData = listener.data;
    if (listenerData != null) {
      return listenerData;
    }
  } catch (_eListener) {
    // 非 listener result，继续尝试其他格式
  }

  // 小程序 / UTSJSONObject / Map
  const dataField = readRawField(chunkResult, "data");
  if (dataField != null) {
    return dataField as ArrayBuffer;
  }

  // success 回调中 res.data 可能直接是 ArrayBuffer
  try {
    const maybeBuffer = chunkResult as ArrayBuffer;
    const byteLength = maybeBuffer.byteLength;
    if (byteLength != null && byteLength >= 0) {
      return maybeBuffer;
    }
  } catch (_eBuffer) {
    // ignore
  }

  return null;
}

// 全局错误处理 - 捕获未处理的 AbortError
// #ifdef H5
if (typeof window !== "undefined") {
  window.addEventListener("unhandledrejection", (event) => {
    if (event.reason != null && event.reason.name === "AbortError") {
      console.log("捕获到未处理的 AbortError，已静默处理");
      event.preventDefault(); // 阻止默认的错误处理
    }
  });
}
// #endif

// 流式请求工具类
export class StreamRequest {
  private requestTask: RequestTask | null = null;
  private isAborted: boolean = false;
  private abortController: any | null = null;
  private buffer: string = ""; // 用于缓存不完整的 SSE 消息（以 \n\n 为完整标记）
  private pendingBytes: Uint8Array = new Uint8Array(0); // 用于缓存不完整的 UTF-8 字节序列

  // 微信小程序数据流超时监控
  private lastChunkReceivedTime: number = 0; // 最后一次接收数据的时间戳
  private timeoutCheckTimer: number | null = null;
  private readonly TIMEOUT_DURATION: number = 60000; // 超时时长 60 秒
  private timeoutCallback: (() => void) | null = null; // 超时回调

  /** App：SSE 消息分帧队列，避免同一事件循环内批量 onChunk 导致 iOS UI 只在结束时刷新 */
  private sseDispatchQueue: string[] = [];
  private sseDispatchRunning: boolean = false;
  private sseDispatchConfig: StreamRequestConfig | null = null;
  private sseDispatchOnComplete: (() => void) | null = null;
  private readonly SSE_DISPATCH_INTERVAL_MS: number = 16;

  // 发起流式请求
  async request(config: StreamRequestConfig): Promise<void> {
    this.isAborted = false;
    this.buffer = ""; // 重置缓冲区
    this.pendingBytes = new Uint8Array(0); // 重置字节缓冲区
    this.resetSseDispatchQueue();

    // #ifdef H5
    // 只在 H5 环境中创建 AbortController
    this.abortController = new AbortController();
    // #endif

    // 清除可能存在的旧定时器（重要：避免定时器泄漏）
    console.log("[超时监控] 新请求开始，清除旧定时器");
    this.clearTimeoutMonitor();
    // 保存超时回调
    this.timeoutCallback = config.onTimeout != null ? config.onTimeout : null;

    try {
      // #ifdef H5 || WEB
      await this.requestH5(config);
      // #endif

      // #ifdef MP-WEIXIN
      await this.requestWeapp(config);
      // #endif

      // #ifdef APP
      // uni-app x APP：uni.request 返回 RequestTask（非 Promise），需独立实现 chunked 流式接收
      await this.requestAppX(config);
      // #endif

      // #ifdef APP-PLUS
      await this.requestApp(config);
      // #endif
    } catch (error) {
      // 如果是用户主动中止，不触发错误回调
      // #ifdef H5
      if (isAbortError(error) || this.isAborted) {
        console.log("请求已被中止");
        return;
      }
      // #endif

      // #ifdef MP-WEIXIN || APP-PLUS || APP
      if (this.isAborted) {
        console.log("请求已被中止");
        return;
      }
      // #endif

      config.onError?.(error);
    }
  }

  // H5环境下的流式请求
  private async requestH5(config: StreamRequestConfig): Promise<void> {
    try {
      // 关键修复：在创建 requestTask 后立即启动超时监控
      // 因为 onChunkReceived 可能比 success 回调更早触发
      console.log("[请求] requestTask 已创建，立即启动超时监控");
      this.startTimeoutMonitor();
      console.log("[请求] 超时监控启动完成");

      await createSSEConnection<any>({
        url: config.url,
        method: config.method,
        headers: config.headers,
        body: config.body,
        abortController: this.abortController,
        onMessage: (data: any) => {
          if (this.isAborted) return;
          // 更新最后接收数据的时间
          this.updateLastChunkTime();

          try {
            // 检查是否完成
            if (isCompletedPayload(data)) {
              console.log("[SSE] 收到完成标记 completed");

              // 清除超时监控
              console.log(
                "[SSE] completed 标记触发，准备清除定时器，当前 timer ID:",
                this.timeoutCheckTimer,
              );
              this.clearTimeoutMonitor();
              console.log("[SSE] completed 标记处理完成，定时器已清除");

              config.onComplete?.();
              return;
            }

            if (shouldSkipSsePayloadEmit(data)) {
              return;
            }

            // 处理数据块
            const chunk = createContentChunk(
              data != null ? JSON.stringify(data) : "",
            );
            config.onChunk?.(chunk);
          } catch (e) {
            console.error("Parse chunk error:", e);
          }
        },
        onError: (error: any) => {
          // 清除超时监控
          this.clearTimeoutMonitor();
          // 如果是中止错误，不触发错误回调
          if (isAbortError(error) || this.isAborted) {
            console.log("SSE连接已被中止");
            return;
          }
          config.onError?.(error);
        },
        onOpen: (response: any) => {
          console.log("SSE连接已建立:", response);
        },
        onClose: () => {
          console.log("SSE连接已关闭");
          // 调用超时回调-关闭loading状态以及恢复停止按钮
          config.onTimeout?.();
        },
      });
    } catch (error) {
      // 捕获所有可能的错误，包括 AbortError
      if (
        getErrorMessage(error) === "Connection aborted by user" ||
        isAbortError(error) ||
        this.isAborted
      ) {
        console.log("SSE连接已被中止");
        return;
      }
      // 只有真正的错误才触发错误回调
      config.onError?.(error);
      throw error; // 重新抛出非中止错误
    }
  }

  /**
   * 将解码后的 SSE 文本追加到缓冲区，并处理完整消息块。
   * @param text 新接收的 UTF-8 文本
   * @param config 流式请求配置
   * @param onStreamComplete 流结束时的回调（[DONE] / completed）
   */
  private resetSseDispatchQueue(): void {
    this.sseDispatchQueue = [];
    this.sseDispatchRunning = false;
    this.sseDispatchConfig = null;
    this.sseDispatchOnComplete = null;
  }

  /**
   * App 端将 SSE 消息逐帧派发，让 iOS 有机会在 chunk 之间渲染打字机效果。
   */
  private enqueueSseMessage(
    content: string,
    config: StreamRequestConfig,
    onStreamComplete: () => void,
  ): void {
    this.sseDispatchQueue.push(content);
    this.sseDispatchConfig = config;
    this.sseDispatchOnComplete = onStreamComplete;
    if (this.sseDispatchRunning == false) {
      this.pumpSseDispatchQueue();
    }
  }

  private pumpSseDispatchQueue(): void {
    if (this.isAborted) {
      this.resetSseDispatchQueue();
      return;
    }
    if (this.sseDispatchQueue.length == 0) {
      this.sseDispatchRunning = false;
      return;
    }

    this.sseDispatchRunning = true;
    const content = this.sseDispatchQueue.shift() as string;
    const config = this.sseDispatchConfig as StreamRequestConfig;
    const onComplete = this.sseDispatchOnComplete as () => void;
    this.processSSEMessage(content, config, onComplete);

    setTimeout(() => {
      this.pumpSseDispatchQueue();
    }, this.SSE_DISPATCH_INTERVAL_MS);
  }

  private waitForSseDispatchIdle(onIdle: () => void): void {
    if (this.sseDispatchRunning == false && this.sseDispatchQueue.length == 0) {
      onIdle();
      return;
    }
    setTimeout(() => {
      this.waitForSseDispatchIdle(onIdle);
    }, this.SSE_DISPATCH_INTERVAL_MS);
  }

  private appendAndProcessSSEText(
    text: string,
    config: StreamRequestConfig,
    onStreamComplete: () => void,
    yieldBetweenMessages: boolean = false,
  ): void {
    if (text.length === 0) {
      return;
    }

    this.buffer += text;
    const messages = this.buffer.split("\n\n");
    const pendingMessage = messages.pop();
    this.buffer = pendingMessage != null ? pendingMessage : "";

    for (const message of messages) {
      if (!message.trim()) {
        continue;
      }

      const lines = message.split("\n");
      let dataContent = "";

      for (const line of lines) {
        if (line.startsWith("data:")) {
          const content = line.slice(5).trim();
          if (dataContent.length > 0) {
            dataContent += "\n" + content;
          } else {
            dataContent = content;
          }
        }
      }

      if (dataContent.length > 0) {
        if (yieldBetweenMessages) {
          this.enqueueSseMessage(dataContent, config, onStreamComplete);
        } else {
          this.processSSEMessage(dataContent, config, onStreamComplete);
        }
      }
    }
  }

  // 处理完整的 SSE 消息
  private processSSEMessage(
    content: string,
    config: StreamRequestConfig,
    onStreamComplete: () => void,
  ): void {
    // 检查是否完成
    if (content === "[DONE]") {
      console.log("[SSE] 收到完成标记 [DONE]");

      // 清除超时监控
      console.log(
        "[SSE] [DONE] 标记触发，准备清除定时器，当前 timer ID:",
        this.timeoutCheckTimer,
      );
      this.finalizeCompletedStream();
      console.log("[SSE] [DONE] 标记处理完成，定时器已清除");

      config.onComplete?.();
      onStreamComplete();
      return;
    }

    // 检查是否看起来像 JSON (以 { 或 [ 开头)
    const looksLikeJSON = content.startsWith("{") || content.startsWith("[");

    if (looksLikeJSON) {
      // 尝试解析 JSON 数据
      try {
        const data = JSON.parse(content) as UTSJSONObject;
        if (isCompletedPayload(data)) {
          console.log("[SSE] 收到完成标记 completed");

          // 清除超时监控
          console.log(
            "[SSE] completed 标记触发，准备清除定时器，当前 timer ID:",
            this.timeoutCheckTimer,
          );
          this.finalizeCompletedStream();
          console.log("[SSE] completed 标记处理完成，定时器已清除");

          config.onComplete?.();
          onStreamComplete();
          return;
        }

        if (shouldSkipSsePayloadEmit(data)) {
          return;
        }

        // 处理数据块
        const chunk = createContentChunk(content);
        console.log("[SSE-Stream] emit chunk len=", content.length);
        config.onChunk?.(chunk);
      } catch (e) {
        console.log("[SSE] JSON 解析失败，内容:", content);
      }
    } else {
      // 不是 JSON 格式，直接作为内容处理
      const chunk = createContentChunk(content);
      config.onChunk?.(chunk);
    }
  }

  // 启动超时监控
  private startTimeoutMonitor(): void {
    console.log(
      "[超时监控] 准备启动超时监控，当前 timer ID:",
      this.timeoutCheckTimer,
    );

    // 记录初始时间
    this.lastChunkReceivedTime = Date.now();

    // 先清除可能存在的旧定时器
    const existingTimerId = this.timeoutCheckTimer;
    if (existingTimerId !== null) {
      console.log(
        "[超时监控] 发现旧定时器，先清除，ID:",
        existingTimerId,
      );
      clearInterval(existingTimerId);
      this.timeoutCheckTimer = null;
    }

    // 每 10 秒检查一次是否超时
    const timerId = setInterval(() => {
      const now = Date.now();
      const timeSinceLastChunk = now - this.lastChunkReceivedTime;

      console.log(
        `[超时监控] 检查中... 距离上次接收数据: ${timeSinceLastChunk}ms，定时器 ID: ${this.timeoutCheckTimer}`,
      );

      if (timeSinceLastChunk >= this.TIMEOUT_DURATION) {
        console.log(
          `[超时监控] 数据流超时: ${timeSinceLastChunk}ms 未收到数据`,
        );
        this.handleTimeout();
      }
    }, 10000);

    this.timeoutCheckTimer = timerId;
    console.log("[超时监控] 定时器已创建，新 ID:", this.timeoutCheckTimer);
  }

  // 清除超时监控
  private clearTimeoutMonitor(): void {
    console.log("[超时监控] 尝试清除，当前 timer ID:", this.timeoutCheckTimer);

    const timerId = this.timeoutCheckTimer;
    if (timerId !== null) {
      console.log("[超时监控] 清除超时监控，timer ID:", timerId);
      clearInterval(timerId);
      this.timeoutCheckTimer = null;
    } else {
      console.log("[超时监控] 定时器 ID 为空，无需清除");
    }
  }

  // 更新最后接收数据的时间
  private updateLastChunkTime(): void {
    this.lastChunkReceivedTime = Date.now();
  }

  /**
   * 释放 requestTask 引用。
   * uni-app x 在请求实例已销毁后调用 abort 会抛错，需 try-catch 并先置空引用。
   */
  private releaseRequestTask(attemptAbort: boolean = true): void {
    const task = this.requestTask;
    this.requestTask = null;
    if (task == null || attemptAbort == false) {
      return;
    }
    try {
      task.abort();
    } catch (error) {
      console.log(
        "[StreamRequest] requestTask abort ignored:",
        getErrorMessage(error),
      );
    }
  }

  /** SSE 正常结束时仅清理引用，避免对已销毁实例再次 abort。 */
  private finalizeCompletedStream(): void {
    this.clearTimeoutMonitor();
    this.releaseRequestTask(false);
  }

  // 处理超时
  private handleTimeout(): void {
    console.log("[超时监控] 触发超时处理");

    this.clearTimeoutMonitor();
    this.isAborted = true;
    this.releaseRequestTask(true);

    // 显示轻提示
    uni.showToast({
      title: t("Mobile.Stream.timeoutDisconnected"),
      icon: "none",
      duration: 2000,
    });

    // 调用超时回调
    const timeoutCallback = this.timeoutCallback;
    if (timeoutCallback != null) {
      timeoutCallback();
    }
  }

  // 处理 UTF-8 字节流，处理分片造成的字符截断问题
  private decodeUTF8(chunk: ArrayBuffer): string {
    const newBytes = new Uint8Array(chunk);
    let combined = newBytes;

    if (this.pendingBytes.length > 0) {
      combined = mergeUint8Arrays(this.pendingBytes, newBytes);
      this.pendingBytes = new Uint8Array(0);
    }

    if (combined.length === 0) return "";

    // 寻找最后一个安全的字节边界
    let safeEnd = combined.length;
    let i = combined.length - 1;
    let backtrack = 0;

    // 向前回溯，检查末尾是否被截断
    // UTF-8 最大字符长度为 4 字节
    while (backtrack < 4 && i >= 0) {
      const b = combined[i];

      // ASCII (0xxxxxxx) - 字符结束，且是单字节，安全
      if ((b & 0x80) === 0) {
        // 如果我们是回溯过程中遇到的 ASCII，说明之前回溯过的字节（在 ASCII 之后）是孤立的或不完整的？
        // 比如 [ASCII, Cont, Cont]，我们在 Cont 回溯。
        // 遇到 ASCII，说明后面的 Cont 没有 Start byte，是无效的。
        // 但如果是 [ASCII]，backtrack=0，safeEnd=length。
        // 这里的逻辑：遇到 ASCII，说明前面的序列都结束了。
        // 那么从 i+1 到 length 的字节就是我们回溯过的“剩余字节”。
        safeEnd = combined.length - backtrack;
        break;
      }

      // Start byte (11xxxxxx)
      if ((b & 0xc0) === 0xc0) {
        let need = 2;
        if ((b & 0xe0) === 0xe0) need = 3;
        else if ((b & 0xf0) === 0xf0) need = 4;

        const have = combined.length - i;
        if (have < need) {
          // 不完整，需要保留从 i 开始的所有字节
          safeEnd = i;
        } else {
          // 完整
          safeEnd = combined.length;
        }
        break;
      }

      i--;
      backtrack++;
    }

    // 如果 safeEnd 小于总长度，保存剩余字节
    if (safeEnd < combined.length) {
      this.pendingBytes = combined.slice(safeEnd);
      return utf8ArrayToString(combined.slice(0, safeEnd));
    }

    return utf8ArrayToString(combined);
  }

  // 微信小程序环境下的流式请求
  private async requestWeapp(config: StreamRequestConfig): Promise<void> {
    return new Promise((resolve, reject) => {
      this.requestTask = uni.request({
        url: config.url,
        method: config.method,
        header: config.headers,
        data: config.body,
        enableChunked: true, // 启用分块传输
        responseType: "arraybuffer", // 响应类型
        timeout: 1000 * 60 * 60 * 12, // 设置超时时间为 12小时
        success: (res) => {
          console.log("[请求] success 回调触发，statusCode:", res.statusCode);
          if (res.statusCode === 200) {
            // 流式数据通过 onChunkReceived 接收，success 仅表示请求建立成功
            // 实际的流式数据处理在 onChunkReceived 回调中
            config.onOpen?.(res);

            resolve(); // 请求成功建立连接后即可 resolve
          } else {
            console.log("[请求] 请求失败，statusCode:", res.statusCode);
            this.finalizeCompletedStream();
            reject(new Error(buildHttpErrorMessage(res.statusCode)));
          }
        },
        fail: (err) => {
          this.finalizeCompletedStream();

          if (!this.isAborted) {
            // 忽略超时错误，因为对于长连接流式请求，超时是预期内的行为
            // 只要 connection 还在接收数据，就不应该视为真正的错误
            const errMsgText = err.errMsg;
            if (
              errMsgText != null &&
              (errMsgText.includes("time out") ||
                errMsgText.includes("timeout"))
            ) {
              console.log("请求超时警告（流式请求正常现象）:", err);
              // 不 reject，也不触发 onError，保持连接继续接收数据
              return;
            }

            config.onError?.(err);
            reject(err);
          }
        },
      });

      // 关键修复：在创建 requestTask 后立即启动超时监控
      // 因为 onChunkReceived 可能比 success 回调更早触发
      console.log("[请求] requestTask 已创建，立即启动超时监控");
      this.startTimeoutMonitor();
      console.log("[请求] 超时监控启动完成");

      // 监听分块数据接收
      const requestTask = this.requestTask;
      if (requestTask != null) {
        const onWeappStreamComplete = (): void => {
          resolve();
        };
        requestTask.onChunkReceived((res) => {
          if (this.isAborted) return;

          this.updateLastChunkTime();

          try {
            const chunkBuffer = extractChunkArrayBuffer(res);
            if (chunkBuffer == null) {
              return;
            }
            const str = this.decodeUTF8(chunkBuffer);
            this.appendAndProcessSSEText(str, config, onWeappStreamComplete);
          } catch (error) {
            console.error("处理分块数据失败:", error);
            if (!this.isAborted) {
              config.onError?.(error);
            }
          }
        });
      }
    });
  }

  /**
   * uni-app x APP 端流式 SSE 请求。
   * 官方文档：uni.request 返回 RequestTask（非 Promise），需 enableChunked + onChunkReceived + responseType arraybuffer。
   * @see https://doc.dcloud.net.cn/uni-app-x/api/request.html
   */
  private requestAppX(config: StreamRequestConfig): Promise<void> {
    return new Promise((resolve, reject) => {
      let isStreamFinished = false;
      let hasReceivedChunk = false;

      const finishStream = (): void => {
        if (isStreamFinished) {
          return;
        }
        this.waitForSseDispatchIdle(() => {
          if (isStreamFinished) {
            return;
          }
          isStreamFinished = true;
          this.finalizeCompletedStream();
          resolve();
        });
      };

      const failStream = (error: any): void => {
        if (isStreamFinished || this.isAborted) {
          return;
        }
        isStreamFinished = true;
        this.finalizeCompletedStream();
        reject(error);
      };

      const handleChunkBuffer = (chunkBuffer: ArrayBuffer | null): void => {
        if (chunkBuffer == null || this.isAborted) {
          return;
        }
        hasReceivedChunk = true;
        this.updateLastChunkTime();
        try {
          const text = this.decodeUTF8(chunkBuffer);
          this.appendAndProcessSSEText(text, config, finishStream, true);
        } catch (error) {
          console.error("[SSE-APP] 处理分块数据失败:", error);
          if (!this.isAborted) {
            config.onError?.(error);
          }
        }
      };

      console.log("[SSE-APP] 创建 RequestTask 流式请求");
      this.startTimeoutMonitor();

      // APP 端 uni.request 同步返回 RequestTask，不可当作 Promise 使用
      const requestTask = uni.request<ArrayBuffer>({
        url: config.url,
        method: config.method,
        header: config.headers,
        data: config.body,
        enableChunked: true,
        responseType: "arraybuffer",
        dataType: "text",
        timeout: 1000 * 60 * 60 * 12,
        success: (res) => {
          console.log(
            "[SSE-APP] success 回调，statusCode:",
            res.statusCode,
          );
          if (res.statusCode !== 200) {
            failStream(new Error(buildHttpErrorMessage(res.statusCode)));
            return;
          }

          config.onOpen?.(res);

          // 兜底：未收到 onChunkReceived 时，尝试处理 success 中的完整响应体
          const responseData = res.data;
          if (!hasReceivedChunk && responseData != null) {
            const fallbackBuffer = extractChunkArrayBuffer(responseData);
            handleChunkBuffer(fallbackBuffer);
          }
        },
        fail: (err) => {
          console.log("[SSE-APP] fail 回调:", err.errMsg);
          this.finalizeCompletedStream();

          if (this.isAborted) {
            return;
          }

          if (
            err.errMsg != null &&
            (err.errMsg.includes("time out") || err.errMsg.includes("timeout"))
          ) {
            console.log("[SSE-APP] 超时警告（流式请求可能仍在进行）:", err);
            return;
          }

          config.onError?.(err);
          failStream(err);
        },
        complete: () => {
          console.log("[SSE-APP] complete 回调");
          if (!isStreamFinished && !this.isAborted) {
            config.onComplete?.();
            finishStream();
          } else {
            this.releaseRequestTask(false);
          }
        },
      });

      this.requestTask = requestTask;

      requestTask.onChunkReceived((result) => {
        if (this.isAborted) {
          return;
        }
        const chunkBuffer = extractChunkArrayBuffer(result);
        handleChunkBuffer(chunkBuffer);
      });
    });
  }

  // App环境下的流式请求
  private async requestApp(config: StreamRequestConfig): Promise<void> {
    // #ifdef APP-PLUS
    return new Promise((resolve, reject) => {
      this.requestTask = uni.request({
        url: config.url,
        method: config.method,
        header: config.headers,
        data: config.body,
        success: (res) => {
          if (res.statusCode === 200) {
            // 处理流式响应
            this.handleStreamResponse(res.data as string, config);
            resolve();
          } else {
            reject(new Error(buildHttpErrorMessage(res.statusCode)));
          }
        },
        fail: (err) => {
          if (!this.isAborted) {
            reject(err);
          }
        },
      });
    });
    // #endif
  }

  // 处理流式响应数据
  private handleStreamResponse(
    data: string,
    config: StreamRequestConfig,
  ): void {
    console.log("[SSE-APP] 处理流式响应数据, 长度:", data.length);
    const lines = data.split("\n");

    for (const line of lines) {
      if (line.trim() === "") continue;

      if (line.startsWith("data:")) {
        const content = line.slice(5).trim();

        // 跳过空内容
        if (content.length == 0) {
          console.log("[SSE-APP] 跳过空内容行");
          continue;
        }

        console.log("[SSE-APP] 处理数据行:", content);

        // 检查是否完成
        if (content === "[DONE]") {
          console.log("[SSE-APP] 收到完成标记 [DONE]");
          config.onComplete?.();
          return;
        }

        // 检查是否看起来像 JSON (以 { 或 [ 开头)
        const looksLikeJSON =
          content.startsWith("{") || content.startsWith("[");

        if (looksLikeJSON) {
          // 尝试解析 JSON 数据
          try {
            const parseData = JSON.parse(content) as UTSJSONObject;
            if (isCompletedPayload(parseData)) {
              console.log("[SSE-APP] 收到完成标记 completed");
              config.onComplete?.();
              return;
            }
            if (shouldSkipSsePayloadEmit(parseData)) {
              return;
            }
          } catch (e) {
            // JSON 解析失败，继续处理为普通数据
            console.log("[SSE-APP] JSON 解析失败，作为普通内容处理");
          }
        } else {
          console.log("[SSE-APP] 非 JSON 格式，直接处理");
        }

        // 处理数据块
        try {
          const chunk = createContentChunk(content);
          config.onChunk?.(chunk);
        } catch (e) {
          console.error("[SSE-APP] 处理数据块失败:", e);
        }
      }
    }
  }

  // 中止请求
  abort(): void {
    this.isAborted = true;
    this.buffer = ""; // 清空缓冲区
    this.resetSseDispatchQueue();

    // 清除超时监控（所有平台都需要）
    this.clearTimeoutMonitor();

    // #ifdef H5
    // 中止 H5 的 SSE 连接
    const abortController = this.abortController;
    if (abortController != null) {
      abortController.abort();
      this.abortController = null;
    }
    // #endif

    // #ifdef MP-WEIXIN || APP || APP-PLUS
    this.releaseRequestTask(true);
    // #endif
  }
}

// 创建流式请求实例
export const streamRequest = new StreamRequest();
