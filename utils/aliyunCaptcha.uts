/**
 * 阿里云验证码 web-view 回传参数解析。
 *
 * uni-app x 的 `__uniapp_x_` 桥会把 H5 侧 postMessage 的 payload 放进
 * `event.detail.data` 数组；不同运行时版本还可能再包一层 `data` / `arg`，
 * 因此这里统一递归取 `captchaVerifyParam`，供页内弹层与独立验证码页共用，
 * 避免两条链路各写一份解析逻辑而行为不一致。
 */
/** H5 验证码回调要等业务接口结果，再告诉阿里云这次参数是否被接受。 */
export const H5_CAPTCHA_SETTLE_EVENT = "h5_aliyun_captcha_settle";

export function extractCaptchaVerifyParam(value: any): string {
  if (typeof value == "string") {
    return value as string;
  }
  if (value == null) {
    return "";
  }
  const payload = value as UTSJSONObject;
  const directParam = payload["captchaVerifyParam"];
  if (directParam != null) {
    return `${directParam}`;
  }
  const data = payload["data"];
  if (data != null) {
    const dataParam = extractCaptchaVerifyParam(data);
    if (dataParam.length > 0) {
      return dataParam;
    }
  }
  const arg = payload["arg"];
  return arg != null ? extractCaptchaVerifyParam(arg) : "";
}
