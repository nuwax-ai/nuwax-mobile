/**
 * 事件常量
 * 用于事件订阅和发布时的类型安全引用
 *
 * 与 PC 端 @/constants/event.constants.tsx 保持一致。
 * ★值必须是纯字符串字面量（snake_case，与 types/enums/event.uts 的 EventTypeEnum
 * raw 值一致），不能引用枚举成员：App-Android 上模板字符串 `${EventTypeEnum.X}`
 * 把枚举串化成「成员名」(camelCase)，iOS 串化出 rawValue (snake_case)——两端键名
 * 分裂，Android 上订阅/发布永不相交（IM 实时链路全程零分发的最终根因；真机日志
 * 实锤：on ImMessageReceived 注册 vs emit im_message_received → 0 listeners）。
 * 纯字符串两端恒一致。
 */
export const EVENT_TYPE = {
  // ---- 现有：5s 事件总线 + 通知 ----
  NewNotifyMessage: 'new_notify_message', // 新通知消息
  RefreshChatMessage: 'refresh_chat_message', // 刷新会话
  RefreshFileList: 'refresh_file_list', // 刷新文件列表
  ChatFinished: 'chat_finished', // 会话结束

  // ---- 新增：IM WebSocket 帧事件 ----
  ImMessageReceived: 'im_message_received', // MSG_RECV：收到一条新消息（按 msgId 去重）
  ImMessageRevoked: 'im_message_revoked', // MSG_REVOKE：消息被撤回
  ImMessageEdited: 'im_message_edited', // MSG_EDIT：消息被编辑
  ImConversationUpdated: 'im_conversation_updated', // CONV_UPDATE（reason=PROFILE/DISBANDED/...）
  ImConversationUnread: 'im_conversation_unread', // CONV_UNREAD（驱动 TabBar 角标与单行更新）
  ImReadNotified: 'im_read_notified', // READ_NOTIFY / READ_NOTIFY_AGG 已读回执
  ImAgentStatus: 'im_agent_status', // MSG_AGENT_STATUS 智能体消息状态
  ImCustomEvent: 'im_custom_event', // MSG_CUSTOM_EVENT（不进消息列表）
  ImContactUpdated: 'im_contact_updated', // CONTACT_UPDATE（触发 GET /contacts 重拉）
  ImKicked: 'im_kicked', // KICK（payload.stopReconnect=true 时跳登录）
  ImError: 'im_error', // ERROR 帧（连接通常仍活着）
  ImConnectionState: 'im_connection_state', // connecting/open/reconnecting/failed/closed
  ImAuthInvalid: 'im_auth_invalid', // CONNECT_REJECT 非重试 / KICK.stopReconnect，App.uvue 监听后 stop + 跳登录
};
