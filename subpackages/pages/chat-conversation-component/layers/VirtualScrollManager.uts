import { ref, type Ref } from "vue";
import AgentDetailData from "./AgentDetailData.uts";
import ScrollManager from "./ScrollManager.uts";
import { readRawField } from "@/subpackages/utils/messageInfoClass.uts";
import type { MessageInfo } from "@/types/interfaces/conversationInfo";

/**
 * 手动虚拟滚动（windowing）管理器。
 *
 * scroll-view 为唯一容器后，长会话（H=100+ mixed）全量 v-for 常驻数千 View，主线程卡顿严重。
 * 本管理器在 scroll-view 之上做手动窗口化：仅渲染视口附近（含 overscan）+ 流式末条为真实元素，
 * 视口外消息渲染为高度占位 spacer（保留实测/估算高度，不挂真实子树），大幅降低常驻 View 数。
 *
 * 数据流：
 *  - messageList fingerprint watch（长度/首/末 key 变化）→ rebuildAll()（保留实测高度，增量估算新项）
 *  - @scroll 32ms → onScroll(scrollTop,viewportH)：二分 offsets 平移窗口（含 overscan + 迟滞），
 *    流式期 forceIncludeLast 保证末条恒在切片内（leafDirectPatch 能到达）
 *  - onUpdated 实测循环：对窗口内未实测项 + 流式末条读 offsetHeight 喂 onItemMeasured，
 *    修正视口上方累计 pendingCorrection（手势停下后无感纠偏 scrollTop）
 *  - 顶部加载更多：onItemsPrepended(newItems) 返回 insertedPx → scrollManager.compensatePrepend
 *    写 scrollToBottomAnchor = oldScrollTop + insertedPx（替代锚点 scroll-into-view，虚拟化下锚点可能未挂载）
 *
 * 保留约定（勿破坏）：
 *  - C2 通道（scrollToBottomAnchor + HI/LO pulse + scroll-view :scroll-top）：pendingCorrection /
 *    prepend 补偿都复用这条数值 scroll-top 通道。
 *  - last-msg 哨兵恒挂载（在 spacer 之外）：scroll-into-view 跟底原样工作，流式 bottomSpacer≈0。
 *  - C1（ComponentManager 流式缺 el 跳过整表刷新）：离屏 item 无 ref 由其兜底。
 */
export default class VirtualScrollManager {
  private data: AgentDetailData;
  private scrollManager: ScrollManager | null = null;

  /** key=`${id}_${index}` → 当前已知高度（实测优先，否则估算） */
  private heights: Map<string, number> = new Map<string, number>();
  /** 已实测高度项的 key 集合（区分实测与估算） */
  private measured: Set<string> = new Set<string>();
  /** 前缀和：offsets[i] = 前 i 条总高，offsets[length] = 总高；列表/高度变化时重建 */
  private offsets: number[] = [] as number[];
  /** 估算高度上限（避免单条估算过大导致窗口过窄） */
  private readonly ESTIMATE_CAP_PX: number = 6000;

  /** 窗口起止（含 overscan），半开 [winStart, winEnd[ */
  winStart: Ref<number> = ref<number>(0);
  winEnd: Ref<number> = ref<number>(0);
  /** 实际渲染的切片（visibleSlice == messageList.slice(winStart, winEnd)） */
  visibleSlice: Ref<MessageInfo[]> = ref<MessageInfo[]>([] as MessageInfo[]);
  /** 顶/底占位高度（实测/估算的视口外总高） */
  topSpacerPx: Ref<number> = ref<number>(0);
  bottomSpacerPx: Ref<number> = ref<number>(0);
  /** 虚拟滚动总开关（perf 浮层 A/B 切换；默认开） */
  enabled: Ref<boolean> = ref<boolean>(true);

  /** 视口上方未消费的高度修正（实测 vs 估算差值），手势停下后批量写 scrollToBottomAnchor 纠偏 */
  private pendingCorrection: number = 0;
  /** 视口高度缓存（由 ScrollManager.viewportH() 提供，500ms 缓存） */
  private cachedViewportH: number = 0;
  private cachedViewportAtMs: number = 0;
  private readonly VIEWPORT_CACHE_MS: number = 200;
  /** 上次窗口的上/下边界 offset，用于 fling 迟滞（避免快速滚动时窗口频繁收缩导致 mount 抖动） */
  private lastTopBoundaryPx: number = 0;
  private lastBottomBoundaryPx: number = 0;
  /**
   * forceInclude 单条 key（scrollToMessage 目标，确保挂载后再 scroll-into-view）。
   * 注：messageList fingerprint 短路（防 24ms flush 重算风暴）由组件 watch getter 负责
   *（Vue 仅在指纹字符串变化时调 rebuildAll），故本类不持有 lastFingerprint。
   */
  private forceIncludeKey: string = "";

  /** overscan：视口上下额外渲染的像素缓冲 */
  private readonly OVERSCAN_PX: number = 1200;
  /** fling 迟滞：窗口边界只在超出旧边界该距离时才收缩 */
  private readonly FLING_HYSTERESIS_PX: number = 600;
  /** pendingCorrection 应用阈值：<4px 忽略（避免微抖） */
  private readonly MIN_DELTA_CORRECT_PX: number = 4;
  /** 极小列表阈值：估算总高 < 2 屏则全量渲染（等价现状） */
  private readonly SMALL_LIST_SCREENS: number = 2;

  constructor(data: AgentDetailData) {
    this.data = data;
  }

  /** 注入 ScrollManager（setter 防止构造期循环引用） */
  setScrollManager(sm: ScrollManager): void {
    this.scrollManager = sm;
  }

  /** 取 item 的稳定 key（与模板 `${item.id}_${item.index}` 一致） */
  private keyOf(item: MessageInfo): string {
    const idRaw = readRawField(item, "id");
    const idxRaw = readRawField(item, "index");
    const id = idRaw != null ? `${idRaw}` : "";
    const idx = idxRaw != null ? `${idxRaw}` : "";
    return `${id}_${idx}`;
  }

  /** 当前视口高度（200ms 缓存，避免每帧 getElementById） */
  viewportHeight(): number {
    const now = Date.now();
    if (
      this.cachedViewportH > 0 &&
      now - this.cachedViewportAtMs < this.VIEWPORT_CACHE_MS
    ) {
      return this.cachedViewportH;
    }
    let h = 600;
    if (this.scrollManager != null) {
      const sm = this.scrollManager as ScrollManager;
      const v = sm.viewportH();
      if (v > 0) h = v;
    }
    this.cachedViewportH = h;
    this.cachedViewportAtMs = now;
    return h;
  }

  /**
   * 估算单条消息高度（未实测时使用）。
   * 启发式：基础 56px + 文本行（24px/28字）+ think 折叠 44 + 工具卡 96/个 + 块级元素 + 附件 80/个。
   * 阴影模式校准后可调；估算误差由视口上方 pendingCorrection 二次修正收敛。
   */
  private estimateHeight(item: MessageInfo): number {
    let h = 56;
    const textRaw = readRawField(item, "text");
    const text = textRaw != null ? `${textRaw}` : "";
    if (text.length > 0) {
      const charsPerLine = 28;
      const lines = Math.ceil(text.length / charsPerLine);
      h += lines * 24;
    }
    const thinkRaw = readRawField(item, "think");
    if (thinkRaw != null && `${thinkRaw}`.length > 0) {
      h += 44;
    }
    const procRaw = readRawField(item, "processingList");
    if (procRaw != null && Array.isArray(procRaw)) {
      const arr = procRaw as any[];
      h += arr.length * 96;
    }
    const mdRaw = readRawField(item, "markdownElList");
    if (mdRaw != null && Array.isArray(mdRaw)) {
      const arr = mdRaw as any[];
      for (let i = 0; i < arr.length; i++) {
        const el = arr[i];
        const typeRaw = readRawField(el, "type");
        const t = typeRaw != null ? `${typeRaw}` : "";
        if (t == "code") h += 160;
        else if (t == "formula" || t == "math") h += 140;
        else if (t == "table") h += 180;
        else if (t == "image") h += 220;
        else if (t == "mermaid") h += 280;
        else h += 96;
      }
    }
    const attachRaw = readRawField(item, "attachments");
    if (attachRaw != null && Array.isArray(attachRaw)) {
      const arr = attachRaw as any[];
      h += arr.length * 80;
    }
    if (h > this.ESTIMATE_CAP_PX) h = this.ESTIMATE_CAP_PX;
    return h;
  }

  /** 取第 index 条当前已知高度（实测优先 → 估算，惰性写入 heights map） */
  private heightOf(index: number): number {
    const list = this.data.messageList.value;
    if (index < 0 || index >= list.length) return 0;
    const item = list[index];
    const key = this.keyOf(item);
    const cached = this.heights.get(key);
    if (cached != null) return cached as number;
    const est = this.estimateHeight(item);
    this.heights.set(key, est);
    return est;
  }

  /** 重建前缀和 offsets（O(n)；测量/列表变化时调用） */
  private rebuildOffsets(): void {
    const list = this.data.messageList.value;
    const n = list.length;
    const offsets = [] as number[];
    let acc = 0;
    for (let i = 0; i < n; i++) {
      offsets.push(acc);
      acc += this.heightOf(i);
    }
    offsets.push(acc);
    this.offsets = offsets;
  }

  /** 二分：找最小的 i 使 offsets[i+1] > target（即 target 落在第 i 条内部或之前） */
  private findIndexAtOffset(target: number): number {
    const offsets = this.offsets;
    const itemCount = offsets.length - 1; // offsets 长度 = n+1
    if (itemCount <= 0) return 0;
    if (target <= 0) return 0;
    let lo = 0;
    let hi = itemCount - 1;
    while (lo < hi) {
      const mid = lo + Math.floor((hi - lo) / 2);
      if (offsets[mid + 1] > target) {
        hi = mid;
      } else {
        lo = mid + 1;
      }
    }
    return lo;
  }

  /**
   * 全量重算：messageList fingerprint 变化（长度/首/末 key 变）时调用。
   * 保留已实测高度（key 仍存在的项），新项惰性估算；清理失效 key 防 Map 无界增长。
   */
  rebuildAll(): void {
    const list = this.data.messageList.value;
    const n = list.length;
    if (n == 0) {
      this.heights.clear();
      this.measured.clear();
      this.offsets = [0] as number[];
      this.winStart.value = 0;
      this.winEnd.value = 0;
      this.visibleSlice.value = [] as MessageInfo[];
      this.topSpacerPx.value = 0;
      this.bottomSpacerPx.value = 0;
      this.lastTopBoundaryPx = 0;
      this.lastBottomBoundaryPx = 0;
      this.pendingCorrection = 0;
      return;
    }
    // 注：失效 key 清理（新会话 id 全变）省略——key=`${id}_${index}` 全局唯一不会撞，
    // measured/heights 仅随实测项增长（有界），换取避免 Map.keys() 迭代的 UTS 不确定性。
    // 列表项若 key 仍在则实测高度保留（prepend/状态更新受益）；新项惰性估算。
    this.rebuildOffsets();
    const scrollTop = this.data.scrollTop.value;
    this.recomputeWindow(scrollTop);
  }

  /**
   * 根据当前 scrollTop 重算窗口 [winStart, winEnd[ 与 spacers。
   * 含 overscan 缓冲 + fling 迟滞（窗口边界仅在超出旧边界 HYSTERESIS 时收缩）。
   * 流式期 forceIncludeLast 保证末条在切片内。
   */
  private recomputeWindow(scrollTop: number): void {
    const list = this.data.messageList.value;
    const n = list.length;
    if (n == 0) {
      this.winStart.value = 0;
      this.winEnd.value = 0;
      this.visibleSlice.value = [] as MessageInfo[];
      this.topSpacerPx.value = 0;
      this.bottomSpacerPx.value = 0;
      return;
    }
    const offsets = this.offsets;
    const totalH = offsets[n];
    const vp = this.viewportHeight();

    // 极小列表：估算总高 < 2 屏 → 全量渲染，spacer=0（等价未虚拟化）
    if (totalH < vp * this.SMALL_LIST_SCREENS) {
      this.winStart.value = 0;
      this.winEnd.value = n;
      this.visibleSlice.value = list.slice(0, n);
      this.topSpacerPx.value = 0;
      this.bottomSpacerPx.value = 0;
      this.lastTopBoundaryPx = 0;
      this.lastBottomBoundaryPx = totalH;
      return;
    }

    const upper = scrollTop - this.OVERSCAN_PX;
    const lower = scrollTop + vp + this.OVERSCAN_PX;
    let start = this.findIndexAtOffset(upper > 0 ? upper : 0);
    let end = this.findIndexAtOffset(lower) + 1;
    if (end > n) end = n;
    if (start < 0) start = 0;
    if (end < start + 1) end = start + 1;

    // fling 迟滞：仅在超出旧边界 HYSTERESIS 时才收缩，减少快速滚动 mount/unmount 抖动
    const newTopBoundaryPx = offsets[start];
    const newBottomBoundaryPx = offsets[end];
    if (this.lastBottomBoundaryPx - newBottomBoundaryPx < this.FLING_HYSTERESIS_PX) {
      // 下边界收缩不足迟滞 → 保持旧下边界对应的 end（不收缩）
      const keepEnd = this.findIndexAtOffset(this.lastBottomBoundaryPx) + 1;
      if (keepEnd > end) end = keepEnd;
      if (end > n) end = n;
    }
    if (newTopBoundaryPx - this.lastTopBoundaryPx < this.FLING_HYSTERESIS_PX) {
      const keepStart = this.findIndexAtOffset(this.lastTopBoundaryPx);
      if (keepStart < start) start = keepStart;
      if (start < 0) start = 0;
    }

    // 流式期：末条恒在切片内（leafDirectPatch 需到达末条；scroll-into-view 跟底）
    if (this.data.isConversationActive.value == true) {
      if (end < n) end = n;
    }

    // forceInclude 单条（scrollToMessage 目标）
    if (this.forceIncludeKey.length > 0) {
      for (let i = start; i < end; i++) {
        if (this.keyOf(list[i]) == this.forceIncludeKey) {
          this.forceIncludeKey = "";
          break;
        }
      }
      if (this.forceIncludeKey.length > 0) {
        for (let i = 0; i < n; i++) {
          if (this.keyOf(list[i]) == this.forceIncludeKey) {
            if (i < start) start = i;
            if (i + 1 > end) end = i + 1;
            break;
          }
        }
        this.forceIncludeKey = "";
      }
    }

    this.winStart.value = start;
    this.winEnd.value = end;
    this.visibleSlice.value = list.slice(start, end);
    this.topSpacerPx.value = offsets[start];
    this.bottomSpacerPx.value = offsets[n] - offsets[end];
    this.lastTopBoundaryPx = offsets[start];
    this.lastBottomBoundaryPx = offsets[end];
  }

  /**
   * @scroll 处理：根据 scrollTop 平移窗口。
   * @returns 窗口是否发生变化（用于上游决定是否触发测量）
   */
  onScroll(scrollTop: number, viewportH: number): boolean {
    if (viewportH > 0) {
      this.cachedViewportH = viewportH;
      this.cachedViewportAtMs = Date.now();
    }
    const prevStart = this.winStart.value;
    const prevEnd = this.winEnd.value;
    this.recomputeWindow(scrollTop);
    return this.winStart.value != prevStart || this.winEnd.value != prevEnd;
  }

  /**
   * 实测回调：可见项挂载后读 offsetHeight 喂入。
   * index < winStart（视口上方）时累计 pendingCorrection（手势停下后无感纠偏）。
   * 重测同 key（流式末条每 flush 增高）时只更新后缀 offsets + bottomSpacer。
   */
  onItemMeasured(key: string, realH: number, index: number): void {
    if (realH <= 0) return; // 未布局完，下 tick 重试
    const list = this.data.messageList.value;
    if (index < 0 || index >= list.length) return;
    const item = list[index];
    if (this.keyOf(item) != key) return; // 列表已换，丢弃过期测量
    const prev = this.heights.get(key);
    const prevH = prev != null ? (prev as number) : this.estimateHeight(item);
    this.heights.set(key, realH);
    this.measured.add(key);
    const delta = realH - prevH;
    if (delta != 0) {
      this.rebuildOffsets();
      // 视口上方项高度变化 → 累计纠偏（用户视角不应跳动）
      if (index < this.winStart.value) {
        this.pendingCorrection += delta;
      }
      // 流式末条在切片末尾，重算 bottom spacer（一般≈0）
      const scrollTop = this.data.scrollTop.value;
      this.recomputeWindow(scrollTop);
    }
  }

  /**
   * 顶部加载更多 prepend：估算新插入项总高，返回 insertedPx 供 scrollManager 补偿。
   * 保留旧项实测高度，新项惰性估算；重建 offsets 后按预期新 scrollTop（oldScrollTop + insertedPx）
   * 重算窗口，使旧首条仍落在视口内。
   */
  onItemsPrepended(newItems: MessageInfo[]): number {
    if (newItems.length == 0) return 0;
    let insertedPx = 0;
    for (let i = 0; i < newItems.length; i++) {
      const it = newItems[i];
      const key = this.keyOf(it);
      const cached = this.heights.get(key);
      const est = cached != null ? (cached as number) : this.estimateHeight(it);
      if (cached == null) {
        this.heights.set(key, est);
      }
      insertedPx += est;
    }
    this.rebuildOffsets();
    // 预期 scrollTop 被 scrollManager 置为 oldScrollTop + insertedPx；按此重算窗口
    const expectedScrollTop = this.data.scrollTop.value + insertedPx;
    this.recomputeWindow(expectedScrollTop);
    return insertedPx;
  }

  /** 流式强制包含末条（发布草稿后调用，确保 leafDirectPatch 可达） */
  forceIncludeLast(): void {
    if (this.data.messageList.value.length == 0) return;
    const scrollTop = this.data.scrollTop.value;
    this.recomputeWindow(scrollTop);
  }

  /** 强制将某 key 项纳入切片（scrollToMessage 调，确保 scroll-into-view 目标已挂载） */
  forceInclude(key: string): void {
    if (key.length == 0) return;
    this.forceIncludeKey = key;
    const scrollTop = this.data.scrollTop.value;
    this.recomputeWindow(scrollTop);
  }

  /**
   * 视口上方累计修正应用：手势停下（scrolling==false）且 |pendingCorrection| >= 阈值时，
   * 写 scrollToBottomAnchor（复用 C2 数值 scroll-top 通道，scrollWithAnimation=false）无感纠偏。
   */
  applyPendingCorrection(): void {
    if (this.enabled.value != true) return;
    if (this.data.scrolling.value == true) return;
    const delta = this.pendingCorrection;
    if (Math.abs(delta) < this.MIN_DELTA_CORRECT_PX) {
      this.pendingCorrection = 0;
      return;
    }
    this.pendingCorrection = 0;
    if (this.scrollManager != null) {
      const sm = this.scrollManager as ScrollManager;
      sm.applyScrollTopDelta(delta);
    }
  }

  /** virtualEnabled 翻转时全量重算（开→切窗口；关→全量 slice） */
  onEnabledToggle(): void {
    this.rebuildOffsets();
    const scrollTop = this.data.scrollTop.value;
    this.recomputeWindow(scrollTop);
  }

  /** 调试快照（logcat [VScroll]） */
  snapshotDebug(): string {
    const list = this.data.messageList.value;
    const totalH =
      this.offsets.length > 0
        ? this.offsets[this.offsets.length - 1]
        : 0;
    return `[VScroll] n=${list.length} win=[${this.winStart.value},${this.winEnd.value}] ` +
      `top=${this.topSpacerPx.value} bottom=${this.bottomSpacerPx.value} ` +
      `total=${totalH} measured=${this.measured.size} pending=${this.pendingCorrection} ` +
      `scrollTop=${this.data.scrollTop.value} enabled=${this.enabled.value}`;
  }

  /**
   * 测量当前切片内项的真实高度（组件 onUpdated 调）。
   * 用同步 uni.getElementById().offsetHeight（已由 ScrollManager.resolveOffsetHeight 验证可用）。
   * - 窗口内未实测项：读 offsetHeight，喂 onItemMeasured（guard 0：未布局完跳过，下 tick 重试）
   * - 流式末条（恒在切片内）：每 flush 重测（高度随 token 增长），保 offsets/spacer 跟上
   * 仅 virtualEnabled 时调用（组件侧守卫）。
   */
  measureNow(): void {
    const list = this.data.messageList.value;
    const n = list.length;
    if (n == 0) return;
    const start = this.winStart.value;
    const end = this.winEnd.value;
    if (end <= start) return;
    // 微信小程序无同步 getElementById offsetHeight：跳过实测（估算/spacer 仍工作）
    // #ifdef MP-WEIXIN
    return;
    // #endif
    // #ifndef MP-WEIXIN
    this.measureSlice(list, n, start, end);
    // #endif
  }

  // #ifndef MP-WEIXIN
  private measureSlice(
    list: MessageInfo[],
    n: number,
    start: number,
    end: number,
  ): void {
    const isActive = this.data.isConversationActive.value;
    for (let i = start; i < end; i++) {
      if (i >= n) break;
      const item = list[i];
      const key = this.keyOf(item);
      const idRaw = readRawField(item, "id");
      const idxRaw = readRawField(item, "index");
      if (idRaw == null) continue;
      const idStr = `${idRaw}`;
      const idxStr = idxRaw != null ? `${idxRaw}` : "";
      const el = uni.getElementById(`msg-wrapper-${idStr}_${idxStr}`);
      const h = el?.offsetHeight ?? 0;
      if (h <= 0) continue; // 未布局完，下 tick 重试
      // 未实测项 OR 流式末条（重测，高度随 token 增长）
      const isLast = i == n - 1;
      const needRemeasure = isLast && isActive;
      if (this.measured.has(key) != true || needRemeasure) {
        this.onItemMeasured(key, h, i);
      }
    }
  }
  // #endif
}
