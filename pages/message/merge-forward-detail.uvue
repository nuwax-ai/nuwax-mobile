<template>
  <view class="mfd-page">
    <safety-zone />

    <!-- 顶部：返回 + 标题（与引用详情页同款双段头） -->
    <view class="mfd-header">
      <view class="mfd-header__btn" hover-class="mfd-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="mfd-header__title-wrap">
        <text class="mfd-header__title">{{ displayTitle }}</text>
      </view>
      <view class="mfd-header__btn mfd-header__btn--ghost" />
    </view>

    <!-- 记录列表：头像 + 发送者/时间 + 内容 -->
    <scroll-view class="mfd-body" direction="vertical" :show-scrollbar="false">
      <view v-for="(it, i) in items" :key="i" class="mfd-row">
        <view class="mfd-row__avatar" :style="{ backgroundImage: avatarGradient(it.senderName) }">
          <text class="mfd-row__avatar-letter">{{ avatarLetter(it.senderName) }}</text>
        </view>
        <view class="mfd-row__rest">
          <view class="mfd-row__title-row">
            <text class="mfd-row__name text-ellipsis">{{ senderNameOf(it) }}</text>
            <text class="mfd-row__time">{{ formatRecordTime(it.sendTime) }}</text>
          </view>
          <!-- 正文（原始文本，非占位归一值；图文混排快照文本与图片并列展示） -->
          <text v-if="it.text.length > 0" class="mfd-row__text">{{ it.text }}</text>
          <!-- 图片附件（kind=image 快照）：缩略图网格，点击全屏预览；受保护 /api/f/
               地址 onLoad 异步解析回填后整表重建出图（chat.uvue resolveRowMedia 同款） -->
          <view v-if="it.images.length > 0" class="mfd-media">
            <image
              v-for="(img, k) in it.images"
              :key="k"
              class="mfd-media__img"
              :src="img.url"
              mode="aspectFill"
              @click="handleImageTap(img)"
              @error="handleImageRenderError(img)"
            />
          </view>
          <!-- 视频附件（kind=video / kind=file 实为视频）：内联原生 <video>（chat.uvue 同款
               预载策略——onLoad 解析可播地址回填 playUrl ⇒ 常驻播放器首帧即封面，交给系统
               播放键点播；未预载/失败回落深色占位卡：进度文案 / ▶ 手动重试）。
               ★playUrl/videoLoadingId/videoLoadPercent 须在模板表达式直读（App-Android
               方法调用绑定不收集方法体内依赖）；预载挂载后手势归原生控件。
               ★iOS 勿往 <video> 挂子组件（全屏切换子节点销毁闪退 #22070） -->
          <view v-for="(v, k) in it.videos" :key="'v' + k" class="mfd-video" @click="handleVideoTap(v)">
            <video
              v-if="v.playUrl.length > 0"
              :id="'mfdVideoPlayer-' + v.uid"
              class="mfd-video__player"
              :src="v.playUrl"
              :controls="true"
              :show-fullscreen-btn="true"
              :title="fileDisplayNameOf(v)"
              object-fit="contain"
              @ended="handleVideoEnded(v.uid)"
              @error="handleVideoError(v)"
              @fullscreenchange="handleVideoFullscreenChange"
            >
              <!-- #ifdef APP-ANDROID -->
              <!-- Android 控制条实测无全屏键，video 子组件层补显式入口（chat.uvue 同款；
                   iOS 勿用——#22070 闪退） -->
              <view v-if="videoFullscreen != true" class="mfd-video__fs" @tap.stop="requestMfdVideoFullscreen(v.uid)">
                <view class="mfd-video__fs-corner mfd-video__fs-corner--tl" />
                <view class="mfd-video__fs-corner mfd-video__fs-corner--tr" />
                <view class="mfd-video__fs-corner mfd-video__fs-corner--bl" />
                <view class="mfd-video__fs-corner mfd-video__fs-corner--br" />
              </view>
              <!-- #endif -->
            </video>
            <view v-else class="mfd-video__poster">
              <!-- 预载中只显进度；未预载/失败显 ▶ 可点重试（成功即被 <video> 首帧顶替） -->
              <text v-if="v.uid == videoLoadingId && videoLoadPercent >= 0" class="mfd-video__hint">{{ t("Mobile.FileTree.downloading") }} {{ videoLoadPercent }}%</text>
              <text v-else-if="v.uid == videoLoadingId" class="mfd-video__hint">{{ t("Mobile.FileTree.downloading") }}</text>
              <view v-else class="mfd-video__play">
                <image class="mfd-video__play-icon" src="/static/images/icon-video-play.png" mode="aspectFit" />
              </view>
            </view>
          </view>
          <!-- 语音附件（kind=audio）：声波气泡，点按播放/再点停止（chat.uvue 同款——页面级
               单一播放实例，播放中声波跳动换主题色；快照无时长字段，首播后回填真值） -->
          <view
            v-for="(a, k) in it.audios"
            :key="'a' + k"
            class="mfd-voice"
            :class="a.uid == playingAudioId ? 'mfd-voice--playing' : ''"
            @click="handleAudioTap(a)"
          >
            <view class="mfd-voice__bar" :style="{ height: voiceBarH(a, 0, voiceTick) + 'px' }" />
            <view class="mfd-voice__bar" :style="{ height: voiceBarH(a, 1, voiceTick) + 'px' }" />
            <view class="mfd-voice__bar" :style="{ height: voiceBarH(a, 2, voiceTick) + 'px' }" />
            <view class="mfd-voice__bar" :style="{ height: voiceBarH(a, 3, voiceTick) + 'px' }" />
            <text v-if="a.duration > 0" class="mfd-voice__dur">{{ audioDurationLabelOf(a) }}</text>
          </view>
          <!-- 文件附件（kind=file 真文件）：文件卡片，点击路由同聊天页链接卡片
               （受保护文档→文件预览页；zip/apk→下载；外链→webview） -->
          <view
            v-for="(f, k) in it.files"
            :key="'f' + k"
            class="mfd-file"
            hover-class="mfd-file--active"
            @click="handleFileTap(f)"
          >
            <view class="mfd-file__icon">
              <svg-icon name="icon-a-Filetext" size="40" color="#5147ff" />
            </view>
            <text class="mfd-file__name text-ellipsis">{{ fileDisplayNameOf(f) }}</text>
          </view>
          <!-- 无文本且无媒体：类型占位兜底 -->
          <text
            v-if="it.text.length == 0 && it.images.length == 0 && it.videos.length == 0 && it.audios.length == 0 && it.files.length == 0"
            class="mfd-row__text"
          >{{ it.preview }}</text>
        </view>
      </view>
      <view v-if="items.length == 0" class="mfd-state">
        <text class="mfd-state__text">{{ t("Mobile.Message.imSearchEmpty") }}</text>
      </view>
      <view class="mfd-bottom-space" />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { onHide, onLoad, onUnload } from "@dcloudio/uni-app";
  import { ImMergeItem, ImMergeMedia } from "@/types/interfaces/imMergeItem";
  import { takeImMergeRecord } from "@/utils/im/imMergeRecordSession";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { resolveDisplayImageUrl } from "@/utils/remoteSvgImage";
  import {
    buildAuthProtectedFileHeaders,
    extractFileNameFromUrl,
    fetchAuthProtectedFileAkUrl,
    fetchAuthProtectedFileDisplayUrl,
    isAuthProtectedFileUrl,
    openAuthProtectedLinkUrl,
    openRemoteFileUrl,
    releaseDisplayImageUrl,
    resolveAuthProtectedFileFetchUrl,
  } from "@/utils/authProtectedFileUrl";
  import { previewImageCompat } from "@/utils/appWebViewImagePreview";
  import { extOf, urlExtOf } from "@/utils/imChatAttachments";
  import { handleExternalLink } from "@/utils/system";
  // #ifdef APP
  import { downloadFileInApp } from "@/subpackages/utils/fileTree";
  // #endif

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ===== 记录数据（onLoad 从暂存会话取：title + convId + 全量条目） =====
  const title = ref<string>("");
  /** 源会话 id（承载 merge_forward 消息的会话；文件点击跳预览页带它，同聊天气泡路由）。 */
  const convId = ref<string>("");
  const items = ref<ImMergeItem[]>([] as ImMergeItem[]);

  // ===== 媒体解析态（受保护 /api/f/ 缩略图回填）=====
  let pageDisposed = false;
  let mediaRefreshTimer = 0;
  /** 已解析出的独占展示地址（blob/临时文件），onUnload 统一释放。 */
  const resolvedMediaUrls: string[] = [];
  /** 缩略图显示边长 rpx（与 .mfd-media__img 尺寸对齐，喂给解析器出图）。 */
  const MERGE_IMG_DISPLAY_RPX = 240;

  /** 浅拷贝整表（Android 不追踪 ref 数组内实例属性的原地变更，回填后须整表重建赋值）。 */
  function copyItems(rows: ImMergeItem[]): ImMergeItem[] {
    const out: ImMergeItem[] = [];
    for (let i = 0; i < rows.length; i++) {
      out.push(rows[i]);
    }
    return out;
  }

  /** 50ms 去抖整表重建（多张图并发解析回填合并成一次重渲，chat.uvue scheduleChatMediaRefresh 同款）。 */
  function scheduleMediaTableRefresh(): void {
    if (mediaRefreshTimer != 0) {
      return;
    }
    mediaRefreshTimer = setTimeout(() => {
      mediaRefreshTimer = 0;
      if (pageDisposed) {
        return;
      }
      items.value = copyItems(items.value);
    }, 50);
  }

  /** 全量条目图片附件解析（受保护地址换可展示地址；失败保留原地址交给 <image> 兜底）。 */
  function resolveMergeMedia(): void {
    const rows = items.value;
    for (let i = 0; i < rows.length; i++) {
      const imgs = rows[i].images;
      for (let j = 0; j < imgs.length; j++) {
        const img = imgs[j];
        const url = img.url;
        if (url.length == 0) {
          continue;
        }
        resolveDisplayImageUrl(url, MERGE_IMG_DISPLAY_RPX, MERGE_IMG_DISPLAY_RPX)
          .then((resolved: string): void => {
            if (pageDisposed) {
              return;
            }
            // 解析失败会回退原地址（与 rawUrl 相同）：不当成功，保留原地址由 <image> 兜底
            if (resolved.length > 0 && resolved != url) {
              img.url = resolved;
              resolvedMediaUrls.push(resolved);
              scheduleMediaTableRefresh();
            }
          })
          .catch((_e: any | null): void => {
            // 静默：真实失败由 @error 落日志
          });
      }
    }
  }

  /** 可入滑动预览列表的图：空地址与未解析的 /api/f/ 受保护直链剔除（带不了 Bearer）。 */
  function isPreviewableMediaImage(url: string): boolean {
    return url.length > 0 && isAuthProtectedFileUrl(url) != true;
  }

  /** 全记录可预览图片（升序 = 视觉顺序，跨条目连续滑动）。 */
  function collectPreviewImages(): string[] {
    const urls: string[] = [];
    const rows = items.value;
    for (let i = 0; i < rows.length; i++) {
      const imgs = rows[i].images;
      for (let j = 0; j < imgs.length; j++) {
        if (isPreviewableMediaImage(imgs[j].url)) {
          urls.push(imgs[j].url);
        }
      }
    }
    return urls;
  }

  /** 缩略图点击：全屏放大（全记录多图滑动；被剔除的未解析受保护图回落单张旧路径）。 */
  function handleImageTap(img: ImMergeMedia): void {
    if (img.url.length == 0) {
      return;
    }
    const urls = collectPreviewImages();
    if (urls.indexOf(img.url) >= 0) {
      previewImageCompat(urls, img.url);
    } else {
      previewImageCompat([img.url], img.url);
    }
  }

  function handleImageRenderError(img: ImMergeMedia): void {
    console.error("[MergeImg] 缩略图渲染失败 src=" + img.url);
  }

  // ===== 语音附件播放（chat.uvue 语音块同款移植：页面级单一 InnerAudioContext，
  // 点气泡播放/再点停止复位；条目寻址用 onLoad 编好的 media.uid 顶替 msgId） =====

  /** 正在播放的语音 uid（空=无；模板直读它切 --playing 态）。 */
  const playingAudioId = ref<string>("");
  /** 声波跳动 tick（播放中 150ms +1；模板绑定以尾参直读它——App-Android 方法调用绑定不收集方法体内依赖）。 */
  const voiceTick = ref<number>(0);
  let mfdAudioCtx: InnerAudioContext | null = null;
  let voiceTickTimer = 0;
  /** 原始 url → 已解析可播地址缓存（重放免二次解析）。 */
  const audioResolved = new Map<string, string>();
  /** 在途解析去重（同 url 并发点按共享同一次解析）。 */
  const audioRequests = new Map<string, Promise<string>>();

  /** 声波条静态高度 px（两侧低中间高）；播放态叠随机抖动模拟音量（chat.uvue 同款手法）。 */
  const VOICE_BAR_BASE: number[] = [7, 14, 10, 5];

  function voiceBarH(a: ImMergeMedia, index: number, _tick: number): number {
    const base = VOICE_BAR_BASE[index];
    if (a.uid != playingAudioId.value) {
      return base;
    }
    return base + Math.random() * 6;
  }

  /** 时长文案：秒 → N"（<=0 不展示，等首播回填）。 */
  function audioDurationLabelOf(a: ImMergeMedia): string {
    if (a.duration <= 0) {
      return "";
    }
    return `${Math.round(a.duration)}"`;
  }

  function startVoiceTickTimer(): void {
    if (voiceTickTimer != 0) {
      clearInterval(voiceTickTimer);
    }
    voiceTickTimer = setInterval((): void => {
      voiceTick.value = voiceTick.value + 1;
    }, 150);
  }

  function stopVoiceTickTimer(): void {
    if (voiceTickTimer != 0) {
      clearInterval(voiceTickTimer);
      voiceTickTimer = 0;
    }
  }

  /** 首播回填时长：快照契约无 duration 字段，播放器拿到真实时长后写回媒体对象
   *  （Android 原地属性变更不触发视图，走整表重建调度）。 */
  function backfillAudioDuration(sec: number): void {
    const id = playingAudioId.value;
    if (id.length == 0 || sec <= 0 || sec > 36000) {
      return;
    }
    const rows = items.value;
    for (let i = 0; i < rows.length; i++) {
      const auds = rows[i].audios;
      for (let j = 0; j < auds.length; j++) {
        if (auds[j].uid == id && auds[j].duration <= 0) {
          auds[j].duration = Math.round(sec);
          scheduleMediaTableRefresh();
          return;
        }
      }
    }
  }

  function ensureMfdAudioCtx(): InnerAudioContext {
    const existed = mfdAudioCtx;
    if (existed != null) {
      return existed;
    }
    const ctx = uni.createInnerAudioContext();
    ctx.onEnded(() => {
      playingAudioId.value = "";
      stopVoiceTickTimer();
    });
    ctx.onError((err) => {
      console.error("[MfdAudio] play failed", err);
      playingAudioId.value = "";
      stopVoiceTickTimer();
      uni.showToast({ title: t("Mobile.Message.audioPlayFailed"), icon: "none" });
    });
    ctx.onTimeUpdate(() => {
      if (playingAudioId.value.length == 0) {
        return;
      }
      const dur = ctx.duration;
      if (dur > 0) {
        backfillAudioDuration(dur);
      }
    });
    mfdAudioCtx = ctx;
    return ctx;
  }

  /** 停止当前播放（复位到头；播放态与跳动 timer 一并收）。 */
  function stopMfdAudio(): void {
    const ctx = mfdAudioCtx;
    if (ctx != null) {
      ctx.stop();
    }
    playingAudioId.value = "";
    stopVoiceTickTimer();
  }

  /** 页面卸载销毁（InnerAudioContext 用完必须 destroy 释放资源）。 */
  function destroyMfdAudio(): void {
    const ctx = mfdAudioCtx;
    if (ctx != null) {
      ctx.stop();
      ctx.destroy();
      mfdAudioCtx = null;
    }
    stopVoiceTickTimer();
  }

  /** 语音可播地址：CDN 直链原样；受保护地址换 blob/temp（缓存 + 在途去重，
   *  chat.uvue resolveChatAudioUrl 同款）。 */
  async function resolveMfdAudioUrl(url: string): Promise<string> {
    if (isAuthProtectedFileUrl(url) != true) {
      return url;
    }
    const cached = audioResolved.get(url);
    if (cached != null) {
      return cached;
    }
    const existing = audioRequests.get(url);
    if (existing != null) {
      return await existing;
    }
    const task = fetchAuthProtectedFileDisplayUrl(url);
    audioRequests.set(url, task);
    try {
      const resolved = await task;
      if (pageDisposed) {
        releaseDisplayImageUrl(resolved);
        return url;
      }
      audioResolved.set(url, resolved);
      resolvedMediaUrls.push(resolved);
      return resolved;
    } finally {
      audioRequests.delete(url);
    }
  }

  // ===== 视频附件预载/播放（chat.uvue 视频块同款移植） =====

  /** 受保护地址解析中的 uid（占位卡显示「下载中」，模板直读）。 */
  const videoLoadingId = ref<string>("");
  /** 解析进度百分比（-1=不确定，无进度回调的平台只显「下载中」；模板直读）。 */
  const videoLoadPercent = ref<number>(-1);
  /** 任一视频是否全屏（fullscreenchange 回写；模板直读控制 Android 全屏兜底按钮显隐）。 */
  const videoFullscreen = ref<boolean>(false);
  /** 原始 url → 已解析 src 缓存（重放免二次下载）。 */
  const videoResolved = new Map<string, string>();
  /** 在途解析去重（同 url 并发触发共享同一次解析）。 */
  const videoRequests = new Map<string, Promise<string>>();
  /** 播放报错已自动重解析过的 uid（每页会话至多一次：ak 过期自愈够用，坏文件不无限循环）。 */
  const videoRetryIds = new Set<string>();
  /** 正在播放的 uid（@play/@pause 回写：轻触切播放/暂停要按它判方向）。 */
  const playingVideoIds = new Set<string>();
  /** 批量预载防重入。 */
  let videoPreloadBusy = false;

  /** 指定条目的 <video> 元素（每条独立 id：预载后多条常驻，非单实例）。 */
  function getMfdVideoElement(uid: string): UniVideoElement | null {
    return uni.getElementById(`mfdVideoPlayer-${uid}`) as UniVideoElement | null;
  }

  /** 暂停所有已挂载视频（页面隐藏 / 播语音互斥；不清 src——回来仍停在该帧）。 */
  function pauseMfdVideos(): void {
    const rows = items.value;
    for (let i = 0; i < rows.length; i++) {
      const vids = rows[i].videos;
      for (let j = 0; j < vids.length; j++) {
        if (vids[j].playUrl.length > 0) {
          const el = getMfdVideoElement(vids[j].uid);
          if (el != null) {
            el.pause();
          }
        }
      }
    }
  }

  /** 语音气泡点按：播放/停止（chat.uvue handleAudioMsgTap 同款——再点停止复位，换条
   *  从头播；播视频先停视频，音视频互斥。解析期间即显播放态，再点同条=停止）。 */
  async function handleAudioTap(a: ImMergeMedia): Promise<void> {
    pauseMfdVideos();
    if (a.uid == playingAudioId.value) {
      stopMfdAudio();
      return;
    }
    const ctx = ensureMfdAudioCtx();
    ctx.stop();
    playingAudioId.value = a.uid;
    startVoiceTickTimer();
    let src = a.url;
    try {
      src = await resolveMfdAudioUrl(a.url);
    } catch (_e) {
      console.error("[MfdAudio] resolve failed url=" + a.url);
      stopMfdAudio();
      uni.showToast({ title: t("Mobile.Message.audioPlayFailed"), icon: "none" });
      return;
    }
    if (a.uid != playingAudioId.value || pageDisposed) {
      return;
    }
    ctx.src = src;
    ctx.play();
  }

  // App 端：页面内 downloadFile 薄封装（与 fetchAuthProtectedFileDisplayUrl 同鉴权头），
  // 额外拿 DownloadTask.onProgressUpdate 驱动占位卡百分比
  // #ifdef APP
  function fetchMfdVideoProtectedUrl(
    url: string,
    onProgress: ((percent: number) => void) | null,
  ): Promise<string> {
    return new Promise<string>((resolve, reject) => {
      const fetchUrl = resolveAuthProtectedFileFetchUrl(url);
      const task = uni.downloadFile({
        url: fetchUrl,
        header: buildAuthProtectedFileHeaders(),
        success: (res) => {
          const tempPath = res.tempFilePath;
          if (res.statusCode == 200 && tempPath != null && tempPath.length > 0) {
            resolve(tempPath);
            return;
          }
          console.error(`[MfdVideo] downloadFile statusCode=${res.statusCode} url=${fetchUrl}`);
          reject(new Error(`download statusCode ${res.statusCode}`));
        },
        fail: (err) => {
          console.error(`[MfdVideo] downloadFile fail url=${fetchUrl}`, err);
          reject(new Error(err.errMsg != null ? err.errMsg : "download fail"));
        },
      });
      task.onProgressUpdate((res) => {
        if (onProgress != null) {
          onProgress(res.progress);
        }
      });
    });
  }
  // #endif
  // 非 App 端：复用通用受保护文件拉取（H5 换 blob；小程序换 temp），无进度回调
  // #ifndef APP
  function fetchMfdVideoProtectedUrl(
    url: string,
    _onProgress: ((percent: number) => void) | null,
  ): Promise<string> {
    return fetchAuthProtectedFileDisplayUrl(url);
  }
  // #endif

  /** 受保护视频取址：allowAk 时首选 /api/file/ak/refresh 换流式直链（播放器自行跟
   *  302 渐进拉流，预载只花一次轻量 JSON 请求）；接口不可用/失败走整段下载路径。 */
  async function resolveMfdVideoProtected(
    url: string,
    onProgress: ((percent: number) => void) | null,
    allowAk: boolean,
  ): Promise<string> {
    if (allowAk) {
      try {
        return await fetchAuthProtectedFileAkUrl(url);
      } catch (_e) {
        console.error(`[MfdVideo] ak 直链解析失败，回落整段下载 url=${url}`);
      }
    }
    return await fetchMfdVideoProtectedUrl(url, onProgress);
  }

  /** 解析视频可播地址：CDN 直链原样；受保护地址先换 ak 流式直链、失败回落整段下载
   *  temp/blob（缓存与在途去重；ak 播放报错的自愈路径见 handleVideoError）。 */
  async function resolveMfdVideo(
    url: string,
    onProgress: ((percent: number) => void) | null,
    allowAk: boolean,
  ): Promise<string> {
    if (isAuthProtectedFileUrl(url) != true) {
      return url;
    }
    const cached = videoResolved.get(url);
    if (cached != null) {
      return cached;
    }
    const existing = videoRequests.get(url);
    if (existing != null) {
      return await existing;
    }
    const task = resolveMfdVideoProtected(url, onProgress, allowAk);
    videoRequests.set(url, task);
    try {
      const resolved = await task;
      if (pageDisposed) {
        releaseDisplayImageUrl(resolved);
        return url;
      }
      videoResolved.set(url, resolved);
      resolvedMediaUrls.push(resolved);
      return resolved;
    } finally {
      videoRequests.delete(url);
    }
  }

  /** 单条视频预载：解析可播地址并回填 playUrl（非空 ⇒ 模板挂 <video> 显首帧）。
   *  ★本页 items 只做浅拷贝重建（copyItems 不换实例），直接写媒体对象即安全；
   *  Android 原地属性变更不触发行重渲，回填后整表重建调度出首帧（同图片回填）。 */
  async function preloadMfdVideoRow(v: ImMergeMedia, allowAk: boolean): Promise<void> {
    videoLoadingId.value = v.uid;
    videoLoadPercent.value = -1;
    try {
      const src = await resolveMfdVideo(v.url, (percent: number): void => {
        // 进度只归属于当前等待的那条（快速换点另一条时旧回调静默）
        if (videoLoadingId.value == v.uid) {
          videoLoadPercent.value = percent;
        }
      }, allowAk);
      if (pageDisposed) {
        return;
      }
      v.playUrl = src;
      scheduleMediaTableRefresh();
    } catch (_e) {
      console.error("[MfdVideo] 预载失败 uid=" + v.uid + " url=" + v.url);
    } finally {
      if (videoLoadingId.value == v.uid) {
        videoLoadingId.value = "";
        videoLoadPercent.value = -1;
      }
    }
  }

  /** 批量预载（onLoad 解析图片后调用）：从上往下逐条顺序预载（顺序下载避免多视频
   *  并发抢带宽；缓存命中零成本回填）。 */
  async function preloadMfdVideos(): Promise<void> {
    if (videoPreloadBusy) {
      return;
    }
    videoPreloadBusy = true;
    try {
      const rows = items.value;
      for (let i = 0; i < rows.length; i++) {
        const vids = rows[i].videos;
        for (let j = 0; j < vids.length; j++) {
          const v = vids[j];
          if (v.url.length > 0 && v.playUrl.length == 0) {
            if (pageDisposed) {
              return;
            }
            await preloadMfdVideoRow(v, true);
          }
        }
      }
    } finally {
      videoPreloadBusy = false;
    }
  }

  /** 占位卡点按（仅预载未完成/失败行可见）：手动触发该条预载；已挂载行手势归原生控件。 */
  function handleVideoTap(v: ImMergeMedia): void {
    if (v.playUrl.length > 0 || v.url.length == 0) {
      return;
    }
    if (v.uid == videoLoadingId.value) {
      return;
    }
    // 音视频互斥（语音侧见 handleAudioTap 开头）
    stopMfdAudio();
    preloadMfdVideoRow(v, true);
  }

  /** 播放结束：seek(0) 定格首帧当封面（原生控制条可直接重播）；全屏态播完先退全屏。 */
  function handleVideoEnded(uid: string): void {
    const el = getMfdVideoElement(uid);
    if (el == null) {
      return;
    }
    if (videoFullscreen.value) {
      el.exitFullScreen();
      videoFullscreen.value = false;
    }
    el.seek(0);
  }

  /** 播放器报错：ak 流式直链可能过期或该端播放器不跟 302——作废该条解析缓存并自动
   *  重解析一次，且直接走整段下载兜底（重换 ak 无意义）；已重试过维持日志 + toast。 */
  function handleVideoError(v: ImMergeMedia): void {
    console.error("[MfdVideo] 播放器报错 uid=" + v.uid);
    if (!videoRetryIds.has(v.uid) && isAuthProtectedFileUrl(v.url) && v.playUrl.length > 0) {
      videoRetryIds.add(v.uid);
      videoResolved.delete(v.url);
      v.playUrl = "";
      scheduleMediaTableRefresh();
      preloadMfdVideoRow(v, false);
      return;
    }
    uni.showToast({ title: t("Mobile.Message.videoPlayFailed"), icon: "none" });
  }

  /** 全屏状态变化：只回写标记（任一视频全屏时隐藏 Android 兜底按钮）；退全屏不清播放状态。 */
  function handleVideoFullscreenChange(event: UniVideoFullScreenChangeEvent): void {
    videoFullscreen.value = event.detail.fullScreen;
  }

  /** Android 全屏入口（video 子组件层按钮，按 uid 寻址）：requestFullScreen 传
   *  null = 按视频宽高比自动定方向（chat.uvue 同款）。 */
  function requestMfdVideoFullscreen(uid: string): void {
    const el = getMfdVideoElement(uid);
    if (el == null) {
      return;
    }
    el.requestFullScreen(null);
  }

  /** 无预览意义、PC 端点击即下载的二进制扩展名（chat.uvue 同清单）。 */
  const DOWNLOAD_ONLY_EXTS: string[] = [
    "zip", "rar", "7z", "tar", "gz", "bz2", "xz",
    "apk", "ipa", "exe", "msi", "dmg", "pkg", "iso", "jar",
    "tmp",
  ];

  function isDownloadOnlyAttachment(fileName: string, url: string): boolean {
    const fileExt = extOf(fileName);
    if (fileExt.length > 0 && DOWNLOAD_ONLY_EXTS.indexOf(fileExt) >= 0) {
      return true;
    }
    const remoteExt = urlExtOf(url);
    return remoteExt.length > 0 && DOWNLOAD_ONLY_EXTS.indexOf(remoteExt) >= 0;
  }

  /**
   * 无可预览二进制：App 走 downloadFileInApp（受保护地址带 Bearer 拉取后拷入公共
   * Download 目录），H5/小程序走 openRemoteFileUrl（chat.uvue handleBinaryUrlDownload 同款）。
   */
  function handleBinaryUrlDownload(url: string, fileName: string): void {
    const name = fileName.length > 0 ? fileName : extractFileNameFromUrl(url);
    // #ifdef APP
    const protectedFile = isAuthProtectedFileUrl(url);
    const downloadUrl = protectedFile ? resolveAuthProtectedFileFetchUrl(url) : url;
    downloadFileInApp(downloadUrl, name, protectedFile).catch((_e: any | null): void => {
      // downloadFileInApp 内部已 toast 失败原因，这里只吞未处理拒绝
    });
    // #endif
    // #ifndef APP
    openRemoteFileUrl(url, name).catch((_e: any | null): void => {
      uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
    });
    // #endif
  }

  /** 文件卡片展示名（快照 fileName 优先，缺省从 URL 提取）。 */
  function fileDisplayNameOf(f: ImMergeMedia): string {
    return f.fileName.length > 0 ? f.fileName : extractFileNameFromUrl(f.url);
  }

  /** 文件/视频卡片点击（路由同聊天页 handleLinkAttTap：视频直下、受保护文档跳预览页、外链走 webview）。 */
  function handleFileTap(f: ImMergeMedia): void {
    if (f.url.length == 0) {
      return;
    }
    // 视频快照：文件预览页 shareKey 不认 IM convId，与聊天页视频链接卡片同款走下载兜底
    if (f.kind == "video") {
      handleBinaryUrlDownload(f.url, fileDisplayNameOf(f));
      return;
    }
    if (isAuthProtectedFileUrl(f.url)) {
      if (isDownloadOnlyAttachment(f.fileName, f.url)) {
        handleBinaryUrlDownload(f.url, f.fileName);
        return;
      }
      openAuthProtectedLinkUrl(f.url, f.fileName, convId.value).catch((_e: any | null): void => {
        uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
      });
      return;
    }
    handleExternalLink(f.url, fileDisplayNameOf(f));
  }

  /** 头像字母底色渐变板（与聊天页 AVATAR_GRADIENTS / 搜索页同款六色系）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #f59a9a, #e05f5f)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  const displayTitle = computed((): string => {
    return title.value.length > 0 ? title.value : t("Mobile.Message.mergeForwardFallbackTitle");
  });

  function senderNameOf(it: ImMergeItem): string {
    return it.senderName.length > 0 ? it.senderName : t("Mobile.Message.imSearchUnknownUser");
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  function pad2(n: number): string {
    return n < 10 ? `0${n}` : `${n}`;
  }

  /** 同自然日判断（chat.uvue isSameChatDay 同款）。 */
  function isSameDay(a: Date, b: Date): boolean {
    return a.getFullYear() == b.getFullYear() && a.getMonth() == b.getMonth() && a.getDate() == b.getDate();
  }

  /** 记录行时间（语义化，对齐聊天页 formatMsgTime）：今天 HH:mm / 昨天 HH:mm / 同年 M月D日 HH:mm / 跨年带年。 */
  function formatRecordTime(ts: number): string {
    if (ts <= 0) {
      return "";
    }
    const date = new Date(ts);
    const hm = pad2(date.getHours()) + ":" + pad2(date.getMinutes());
    const now = new Date();
    if (isSameDay(date, now)) {
      return hm;
    }
    const yesterday = new Date(now.getTime() - 86400000);
    if (isSameDay(date, yesterday)) {
      return t("Mobile.Message.yesterday") + " " + hm;
    }
    if (date.getFullYear() == now.getFullYear()) {
      return `${date.getMonth() + 1}月${date.getDate()}日 ${hm}`;
    }
    return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日 ${hm}`;
  }

  function handleBack(): void {
    // 刷新后栈底保护：同 chat.uvue，无页可退时切回消息 tab，避免整页重载死循环
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      uni.switchTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((_options: any) => {
    const session = takeImMergeRecord();
    if (session != null) {
      title.value = session!!.title;
      convId.value = session!!.convId;
      items.value = session!!.items;
      // 音视频条目编稳定 uid（快照无 msgId；播放态/预载态模板直读比对全靠它寻址）
      const rows = items.value;
      for (let i = 0; i < rows.length; i++) {
        const vids = rows[i].videos;
        for (let j = 0; j < vids.length; j++) {
          vids[j].uid = "v" + i + "-" + j;
        }
        const auds = rows[i].audios;
        for (let j2 = 0; j2 < auds.length; j2++) {
          auds[j2].uid = "a" + i + "-" + j2;
        }
      }
      resolveMergeMedia();
      preloadMfdVideos();
    }
  });

  onHide((): void => {
    // 进子页/切后台停播（chat.uvue 同款：语音停、视频只暂停不清首帧）
    stopMfdAudio();
    pauseMfdVideos();
  });

  onUnload((): void => {
    pageDisposed = true;
    destroyMfdAudio();
    pauseMfdVideos();
    if (mediaRefreshTimer != 0) {
      clearTimeout(mediaRefreshTimer);
      mediaRefreshTimer = 0;
    }
    for (let i = 0; i < resolvedMediaUrls.length; i++) {
      releaseDisplayImageUrl(resolvedMediaUrls[i]);
    }
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架：浅灰底（文件页 gf-page 同底色） ===== */
  .mfd-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #f2f3f5;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  /* ===== 顶部：返回 + 标题（引用详情页同款双段头） ===== */
  .mfd-header {
    flex-shrink: 0;
    height: 96rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    /* 底部分割线（文件页 gf-header 同款灰线） */
    border-bottom: 2rpx solid #e5e6eb;
  }

  .mfd-header__btn {
    width: 96rpx;
    height: 96rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mfd-header__btn--active {
    opacity: 0.7;
  }

  .mfd-header__title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mfd-header__title {
    font-size: 34rpx;
    line-height: 48rpx;
    font-weight: 600;
    color: #141416;
    lines: 1;
    text-overflow: ellipsis;
  }

  .mfd-header__btn--ghost {
    /* 占位平衡标题居中（与引用详情页同款） */
  }

  /* ===== 记录列表 ===== */
  .mfd-body {
    flex: 1;
    min-height: 0;
  }

  .mfd-row {
    padding: 26rpx 32rpx;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }

  /* 头像整数 px + 半径取半（同搜索页：rpx 亚像素 + 圆角在 iOS 会随机切边） */
  .mfd-row__avatar {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-right: 22rpx;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: #ecebf1;
  }

  .mfd-row__avatar-letter {
    font-size: 40rpx;
    line-height: 48rpx;
    font-weight: 600;
    color: #ffffff;
  }

  .mfd-row__rest {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .mfd-row__title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .mfd-row__name {
    flex: 1;
    min-width: 0;
    font-size: 31rpx;
    line-height: 44rpx;
    font-weight: 600;
    color: #141416;
  }

  .mfd-row__time {
    margin-left: 16rpx;
    flex-shrink: 0;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #94929c;
  }

  /* 记录正文：全文展示（不截断，转发快照本就是短消息合集） */
  .mfd-row__text {
    margin-top: 4rpx;
    font-size: 28rpx;
    line-height: 44rpx;
    color: #33323d;
  }

  /* ===== 媒体附件（转发快照）===== */
  /* 图片缩略图网格（240rpx 方图，自动换行；多图快照横向铺开） */
  .mfd-media {
    margin-top: 8rpx;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .mfd-media__img {
    width: 240rpx;
    height: 240rpx;
    margin: 4rpx 12rpx 4rpx 0;
    border-radius: 12rpx;
    background-color: #ecebf1;
  }

  /* ===== 视频附件（chat.uvue chat-video 同款）===== */
  /* 深色圆角占位卡 ↔ 播放器同尺寸（400×300 4:3）：切换不引起列表布局跳动；竖版视频 contain 黑边 */
  .mfd-video {
    margin-top: 12rpx;
    align-self: flex-start;
    width: 400rpx;
    height: 300rpx;
    border-radius: 12rpx;
    background-color: #1c1b20;
    overflow: hidden;
  }

  .mfd-video__player {
    width: 400rpx;
    height: 300rpx;
    background-color: #000000;
  }

  /* 全屏兜底按钮（仅 APP-ANDROID：控制条实测无全屏键）：56rpx 半透明黑圆 + 四角括号
     纯 view 绘制；全屏态由 v-if 卸载（iOS 勿用——#22070 闪退） */
  .mfd-video__fs {
    position: absolute;
    top: 12rpx;
    right: 12rpx;
    width: 56rpx;
    height: 56rpx;
    border-radius: 28rpx;
    background-color: rgba(0, 0, 0, 0.45);
  }

  .mfd-video__fs-corner {
    position: absolute;
    width: 12rpx;
    height: 12rpx;
    border-color: #ffffff;
    border-style: solid;
  }

  .mfd-video__fs-corner--tl {
    top: 16rpx;
    left: 16rpx;
    border-top-width: 3rpx;
    border-left-width: 3rpx;
  }

  .mfd-video__fs-corner--tr {
    top: 16rpx;
    right: 16rpx;
    border-top-width: 3rpx;
    border-right-width: 3rpx;
  }

  .mfd-video__fs-corner--bl {
    bottom: 16rpx;
    left: 16rpx;
    border-bottom-width: 3rpx;
    border-left-width: 3rpx;
  }

  .mfd-video__fs-corner--br {
    bottom: 16rpx;
    right: 16rpx;
    border-bottom-width: 3rpx;
    border-right-width: 3rpx;
  }

  .mfd-video__poster {
    width: 400rpx;
    height: 300rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .mfd-video__play {
    width: 88rpx;
    height: 88rpx;
    border-radius: 44rpx;
    background-color: rgba(255, 255, 255, 0.18);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* PNG 内已做光学居中（bbox 中心右移 14/512），再整体右移 4rpx——chat.uvue 真机校准同款 */
  .mfd-video__play-icon {
    width: 60rpx;
    height: 60rpx;
    margin-left: 4rpx;
  }

  .mfd-video__hint {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.72);
  }

  /* ===== 语音附件（chat.uvue chat-voice 同款声波条 + 时长；本页无气泡，白底圆角行内卡）===== */
  .mfd-voice {
    margin-top: 12rpx;
    align-self: flex-start;
    padding: 0 20rpx;
    /* 高度定死：播放中声波条 150ms 一跳（最高 14+6=20px），高度自适应会逐帧回流抖动 */
    height: 52rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-radius: 12rpx;
    background-color: #ffffff;
  }

  .mfd-voice__bar {
    width: 6rpx;
    margin: 0 3rpx;
    border-radius: 3rpx;
    background-color: #22212a;
  }

  /* 播放中：换主题色（高度由 voiceTick 驱动跳动；App 端无 height 过渡，逐帧跳即动画） */
  .mfd-voice--playing .mfd-voice__bar {
    background-color: #5147ff;
  }

  .mfd-voice__dur {
    margin: 0 8rpx;
    font-size: 26rpx;
    line-height: 36rpx;
    color: #22212a;
  }

  /* 文件/视频卡片（白底行卡：icon-a-Filetext + 文件名，im-group-files 同款观感） */
  .mfd-file {
    margin-top: 12rpx;
    padding: 18rpx 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: #ffffff;
    border-radius: 14rpx;
  }

  .mfd-file--active {
    background-color: #f2f1f7;
  }

  .mfd-file__icon {
    width: 56rpx;
    height: 56rpx;
    margin-right: 14rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mfd-file__name {
    flex: 1;
    min-width: 0;
    font-size: 28rpx;
    line-height: 40rpx;
    color: #1c1b20;
  }

  .mfd-state {
    padding: 200rpx 48rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mfd-state__text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #9a98a5;
  }

  .mfd-bottom-space {
    height: 40rpx;
    /* #ifdef H5 || WEB */
    height: calc(40rpx + env(safe-area-inset-bottom, 0px));
    /* #endif */
  }
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
