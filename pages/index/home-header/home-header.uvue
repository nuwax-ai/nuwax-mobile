<template>
  <view class="home-header" id="home-header-root">
    <!-- 欢迎语 -->
    <view class="welcome" v-if="isLoggedIn">
      <text class="welcome-text">{{ welcomeText }}</text>
    </view>

    <!-- 消息输入框：首页登录态由外层注入完整会话输入组件，未登录保留搜索入口。 -->
    <slot name="input">
      <!-- <view class="search-box" hover-class="search-box-active" @click="handleInputClick">
        <text class="search-icon">💬</text>
        <text class="search-placeholder">{{ t("Mobile.Home.inputPlaceholder") }}</text>
        <view class="mic-btn">
          <text class="mic-icon">🎤</text>
        </view>
      </view> -->
    </slot>

    <!-- 官方推荐：每行最多展示两个智能体标签。 -->
    <view class="agent-grid" v-if="recommendList.length > 0">
      <view
        v-for="item in recommendList"
        :key="item.targetId"
        class="agent-card"
        hover-class="agent-card-active"
        @click="handleAgentClick(item)"
      >
        <image
          class="agent-icon"
          :src="getImageSrc(item.targetId, item.icon)"
          mode="aspectFit"
          :alt="item.name"
          @error="handleImageError(item.targetId)"
        />
        <view class="agent-info">
          <text class="agent-name text-ellipsis">{{ item.name }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, watch } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiDisplayRecommendList } from "@/servers/agentDev";
  import { CategoryItemInfo } from "@/types/interfaces/agentConfig";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import agentImage from "@/static/assets/agent_image.png";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  interface HomeHeaderProps {
    userInfo: any | null;
    isLoggedIn: boolean;
  }
  const props = defineProps<HomeHeaderProps>();

  const emit = defineEmits<{
    (e: "agent-click", item: CategoryItemInfo): void;
    (e: "input-click"): void;
  }>();

  // 官方推荐列表
  const recommendList = ref<CategoryItemInfo[]>([]);

  // 记录加载失败的图片ID
  const failedImageIds = new Set<number>();

  // 从 props.userInfo 读取昵称（Android：禁 as UserInfo 后点属性，走 JSON 中转）
  const readNameFromUserInfo = (info: any | null): string => {
    if (info == null) {
      return "";
    }
    const jsonStr = JSON.stringify(info);
    if (jsonStr == null || jsonStr.length == 0) {
      return "";
    }
    const parsed = JSON.parse(jsonStr) as UTSJSONObject | null;
    if (parsed == null) {
      return "";
    }
    const nickName = parsed["nickName"];
    if (nickName != null && `${nickName}`.length > 0) {
      return `${nickName}`;
    }
    const userName = parsed["userName"];
    return userName != null ? `${userName}` : "";
  };

  // 欢迎语
  const welcomeText = computed((): string => {
    const name = readNameFromUserInfo(props.userInfo);
    if (name.length == 0) {
      return t("Mobile.Home.welcomeGeneric");
    }
    return t("Mobile.Home.welcomePrefix") + " " + name + "，" + t("Mobile.Home.welcomeSuffix");
  });

  const getImageSrc = (id: number, originalIcon: string): string => {
    if (failedImageIds.has(id) || originalIcon.length == 0) {
      return agentImage;
    }
    return originalIcon;
  };

  const handleImageError = (id: number) => {
    failedImageIds.add(id);
  };

  // 获取官方推荐（GET /api/display/recommend/list?forApp=true，取 recChatBoxNav.Agent 列表）
  const fetchRecommendList = async () => {
    try {
      const response = await apiDisplayRecommendList();
      const code = apiResCode(response);
      if (code != SUCCESS_CODE) {
        return;
      }
      const dataRaw = apiResData<any>(response);
      if (dataRaw == null) {
        return;
      }
      const dataObj = dataRaw as UTSJSONObject;
      const recChatBoxNavRaw = dataObj["recChatBoxNav"];
      if (recChatBoxNavRaw == null) {
        return;
      }
      const recChatBoxNavObj = recChatBoxNavRaw as UTSJSONObject;
      const agentListRaw = recChatBoxNavObj["Agent"];
      if (agentListRaw == null) {
        return;
      }
      const agentArrayStr = JSON.stringify(agentListRaw);
      if (agentArrayStr == null || agentArrayStr.length == 0) {
        return;
      }
      const parsedList = JSON.parse(agentArrayStr);
      if (parsedList == null || !Array.isArray(parsedList)) {
        return;
      }
      const rawItems = parsedList as any[];
      const items: CategoryItemInfo[] = [];
      for (let i = 0; i < rawItems.length; i++) {
        const raw = rawItems[i];
        if (raw == null) continue;
        const obj = raw as UTSJSONObject;
        const targetIdVal = obj["targetId"];
        const idVal = obj["id"];
        const targetIdNum = targetIdVal != null ? (targetIdVal as number) : (idVal != null ? (idVal as number) : 0);
        const labelVal = obj["label"];
        const nameVal = obj["name"];
        const nameStr = labelVal != null && `${labelVal}`.length > 0 ? `${labelVal}` : (nameVal != null ? `${nameVal}` : "");
        const iconVal = obj["icon"];
        const iconStr = iconVal != null ? `${iconVal}` : "";
        const descVal = obj["description"];
        const descStr = descVal != null ? `${descVal}` : "";

        const item = new CategoryItemInfo();
        item.targetId = targetIdNum;
        item.name = nameStr;
        item.icon = iconStr;
        item.description = descStr;
        items.push(item);
      }
      // 宫格最多展示 4 个
      recommendList.value = items.slice(0, 4);
    } catch (e) {
      console.error("获取首页推荐智能体列表失败", e);
    }
  };

  const handleAgentClick = (item: CategoryItemInfo) => {
    emit("agent-click", item);
  };

  const handleInputClick = () => {
    emit("input-click");
  };

  // 登录后加载官方推荐
  watch(
    (): boolean => props.isLoggedIn,
    (loggedIn: boolean) => {
      if (loggedIn) {
        // TODO: 暂时不需要官方推荐
        // fetchRecommendList();
      } else {
        recommendList.value = [] as CategoryItemInfo[];
      }
    },
    { immediate: true },
  );
</script>

<style lang="scss" scoped>
  .home-header {
    padding: 8rpx 24rpx 0;
  }

  /* 欢迎语 */
  .welcome {
    padding: 48rpx 8rpx 24rpx;
    display: flex;
    justify-content: center;
  }

  .welcome-text {
    text-align: center;
    font-size: 44rpx;
    font-weight: 700;
    color: #1a1a1a;
  }

  /* 消息输入框 */
  .search-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: #ffffff;
    border-radius: 40rpx;
    padding: 20rpx 28rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  }

  .search-box-active {
    background-color: #f5f5f5;
  }

  .search-icon {
    font-size: 32rpx;
    margin-right: 16rpx;
  }

  .search-placeholder {
    flex: 1;
    font-size: 28rpx;
    color: #c0c0c0;
  }

  .mic-btn {
    width: 48rpx;
    height: 48rpx;
    border-radius: 24rpx;
    background-color: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mic-icon {
    font-size: 24rpx;
  }

  /* 智能体标签：每行最多两个 */
  .agent-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
    margin: 8rpx 0 16rpx;
  }

  .agent-card {
    width: 48%;
    height: 64rpx;
    padding: 0 20rpx;
    margin-bottom: 12rpx;
    box-sizing: border-box;
    background-color: #f7f7f9;
    border-radius: 16rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .agent-card-active {
    background-color: #eeeef2;
  }

  .agent-icon {
    width: 36rpx;
    height: 36rpx;
    border-radius: 8rpx;
    margin-right: 12rpx;
    background-color: #ebedf2;
  }

  .agent-info {
    flex: 1;
    overflow: hidden;
  }

  .agent-name {
    max-width: 200rpx;
    font-size: 26rpx;
    font-weight: 700;
    color: #5f636d;
  }
</style>
