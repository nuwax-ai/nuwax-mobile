<template>
  <view class="create-hub">
    <safety-zone />

    <view class="create-hub__nav">
      <view class="create-hub__back" hover-class="create-hub__back--pressed" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#111111" />
      </view>
    </view>

    <view class="create-hub__hero">
      <text class="create-hub__title">{{ t("Mobile.CreateHub.heroTitle") }}</text>
      <text class="create-hub__subtitle">{{ t("Mobile.CreateHub.heroSubtitle") }}</text>
      <view class="create-hub__modes">
        <view
          class="create-hub__mode"
          :class="{ 'create-hub__mode--on': currentMode == 'chat' }"
          @click="handleModeChange('chat')"
        >
          <text
            class="create-hub__mode-text"
            :class="{ 'create-hub__mode-text--on': currentMode == 'chat' }"
          >{{ t("Mobile.CreateHub.modeChat") }}</text>
        </view>
        <view
          class="create-hub__mode"
          :class="{ 'create-hub__mode--on': currentMode == 'project' }"
          @click="handleModeChange('project')"
        >
          <text
            class="create-hub__mode-text"
            :class="{ 'create-hub__mode-text--on': currentMode == 'project' }"
          >{{ t("Mobile.CreateHub.modeProject") }}</text>
        </view>
      </view>
    </view>

    <view class="create-hub__bottom">
      <create-conversation-input
        :agent-id="defaultAgentId"
        :agent-type="defaultAgentType"
        :is-task-agent="isTaskAgent"
        :enable-voice="true"
        :is-conversation-active="false"
        :has-permission="true"
        @onSendMessage="handleSendMessage"
      />
    </view>

    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { onShow } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
  import { apiTenantConfig } from "@/servers/account";
  import { apiPublishedAgentInfo } from "@/servers/agentDev";
  import { apiAgentConversationCreate } from "@/servers/conversation";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { jumpNavigateBack } from "@/utils/common";
  import { jumpToAgentDetailPage, syncNativeTabBarState } from "@/utils/commonBusiness";
  import { goToLogin } from "@/utils/authNavigation";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import { emptyI18nParams, useI18n } from "@/utils/i18n";
  import { PendingChatDraft } from "@/types/interfaces/pendingChatDraft";
  import { savePendingChatDraft } from "@/utils/pendingChatDraft";
  import { AgentSelectedComponentInfo } from "@/types/interfaces/agent";
  import { AgentComponentTypeEnum } from "@/types/enums/agent";
  import CreateConversationInput from "./components/create-conversation-input/create-conversation-input.uvue";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  type CreateHubMode = "chat" | "project";

  const currentMode = ref<CreateHubMode>("chat");
  const sending = ref<boolean>(false);

  const defaultAgentId = ref<number>(0);
  const defaultAgentName = ref<string>("");
  const defaultAgentType = ref<string>("ChatBot");

  const { loginPopupRef, checkAuthAndShowPopup, hasToken } = useAuthInterceptor();

  const isTaskAgent = computed((): boolean => {
    return defaultAgentType.value == "TaskAgent";
  });

  function applyDefaultAgentConfig(raw: any | null): number {
    if (raw == null) {
      return 0;
    }
    const obj = raw as UTSJSONObject;
    const idRaw = obj["defaultAgentId"];
    const id = idRaw != null ? (idRaw as number) : 0;
    defaultAgentId.value = id;
    return id;
  }

  async function loadDefaultAgentEntry(): Promise<void> {
    try {
      let agentId = 0;
      const cachedRaw = uni.getStorageSync(TENANT_CONFIG_INFO);
      if (cachedRaw != null && `${cachedRaw}`.length > 0) {
        try {
          const cached = JSON.parse<UTSJSONObject>(`${cachedRaw}`);
          agentId = applyDefaultAgentConfig(cached);
        } catch (_e) {
          agentId = 0;
        }
      }

      const configRes = await apiTenantConfig();
      if (apiResCode(configRes) == SUCCESS_CODE) {
        const configData = apiResData<any>(configRes);
        if (configData != null) {
          uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(configData));
          agentId = applyDefaultAgentConfig(configData);
        }
      }

      if (agentId > 0) {
        const detailRes = await apiPublishedAgentInfo(agentId, false);
        if (apiResCode(detailRes) == SUCCESS_CODE) {
          const detailRaw = apiResData<any>(detailRes);
          if (detailRaw != null) {
            const detail = detailRaw as UTSJSONObject;
            const nameRaw = detail["name"];
            const typeRaw = detail["type"];
            defaultAgentName.value = nameRaw != null ? `${nameRaw}` : t("Mobile.Common.appName");
            defaultAgentType.value = typeRaw != null ? `${typeRaw}` : "ChatBot";
          }
        }
      }
    } catch (error) {
      console.error("加载创建页默认智能体失败", error);
    }
  }

  onShow(() => {
    loadDefaultAgentEntry();
  });

  function handleBack(): void {
    // #ifdef APP-IOS
    syncNativeTabBarState();
    // #endif
    jumpNavigateBack();
  }

  function handleModeChange(mode: string): void {
    currentMode.value = mode == "project" ? "project" : "chat";
  }

  async function ensureLoggedIn(): Promise<boolean> {
    const loggedIn = await hasToken();
    if (loggedIn == true) {
      return true;
    }
    // #ifdef MP-WEIXIN
    await checkAuthAndShowPopup();
    return false;
    // #endif
    // #ifndef MP-WEIXIN
    goToLogin(true);
    return false;
    // #endif
  }

  function resolveAgentType(): "ChatBot" | "PageApp" | "TaskAgent" {
    const rawType = defaultAgentType.value;
    if (rawType == "PageApp") {
      return "PageApp";
    }
    if (rawType == "TaskAgent") {
      return "TaskAgent";
    }
    return "ChatBot";
  }

  function parseConversationId(raw: any | null): number {
    if (raw == null) {
      return 0;
    }
    const jsonStr = JSON.stringify(raw);
    if (jsonStr == null || jsonStr.length == 0) {
      return 0;
    }
    const parsed = JSON.parse(jsonStr) as UTSJSONObject | null;
    if (parsed == null) {
      return 0;
    }
    const idRaw = parsed["id"];
    if (idRaw == null) {
      return 0;
    }
    if (typeof idRaw == "number") {
      return idRaw as number;
    }
    const parsedId = parseInt(`${idRaw}`, 10);
    return parsedId != parsedId ? 0 : parsedId;
  }

  function collectDraftAttachments(raw: any | null): UTSJSONObject[] {
    const result: UTSJSONObject[] = [];
    if (raw == null) {
      return result;
    }
    const list = raw as UTSJSONObject[];
    for (let i = 0; i < list.length; i++) {
      const file = list[i];
      const item: UTSJSONObject = {} as UTSJSONObject;
      const urlRaw = file["url"];
      const typeRaw = file["type"];
      const nameRaw = file["name"];
      const keyRaw = file["key"];
      const sizeRaw = file["size"];
      item["fileUrl"] = urlRaw != null ? `${urlRaw}` : "";
      item["mimeType"] = typeRaw != null ? `${typeRaw}` : "";
      item["fileName"] = nameRaw != null ? `${nameRaw}` : "";
      item["fileKey"] = keyRaw != null ? `${keyRaw}` : "";
      item["fileSize"] = sizeRaw != null ? (sizeRaw as number) : 0;
      result.push(item);
    }
    return result;
  }

  function collectSkillIds(raw: any | null): number[] {
    const result: number[] = [];
    if (raw == null) {
      return result;
    }
    const list = raw as number[];
    for (let i = 0; i < list.length; i++) {
      result.push(list[i]);
    }
    return result;
  }

  async function handleSendMessage(data: any): Promise<void> {
    if (sending.value == true) {
      return;
    }
    const obj = data as UTSJSONObject;
    const messageRaw = obj["messageInfo"];
    const message = messageRaw != null ? `${messageRaw}`.trim() : "";
    const attachments = collectDraftAttachments(obj["files"]);
    if (message.length == 0 && attachments.length == 0) {
      return;
    }
    const loggedIn = await ensureLoggedIn();
    if (loggedIn != true) {
      return;
    }
    const agentId = defaultAgentId.value;
    if (agentId <= 0) {
      uni.showToast({
        title: t("Mobile.CreateHub.noDefaultAgent"),
        icon: "none",
      });
      return;
    }

    sending.value = true;
    uni.showLoading({ title: t("Mobile.Page.loading"), mask: true });
    try {
      const conversationParams: UTSJSONObject = {
        agentId: agentId,
        devMode: false,
      };
      const res = await apiAgentConversationCreate(conversationParams);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({
          title: apiResMessage(res).length > 0 ? apiResMessage(res) : t("Mobile.CreateHub.sendFailed"),
          icon: "none",
        });
        return;
      }
      const convId = parseConversationId(apiResData<any>(res));
      if (convId <= 0) {
        uni.showToast({
          title: t("Mobile.CreateHub.sendFailed"),
          icon: "none",
        });
        return;
      }
      const draft = new PendingChatDraft();
      draft.createdAt = Date.now();
      draft.agentId = agentId;
      draft.conversationId = convId;
      draft.message = message;
      draft.attachments = attachments;
      draft.skillIds = collectSkillIds(obj["skillIds"]);
      const selectedRaw = obj["selectedComponents"];
      if (selectedRaw != null) {
        const selectedList = selectedRaw as UTSJSONObject[];
        for (let i = 0; i < selectedList.length; i++) {
          const item = selectedList[i];
          const idRaw = item["id"];
          const id = idRaw != null ? (idRaw as number) : 0;
          const typeRaw = item["type"];
          const type = typeRaw != null ? (typeRaw as AgentComponentTypeEnum) : AgentComponentTypeEnum.Plugin;
          draft.selectedComponents.push(new AgentSelectedComponentInfo(id, type));
        }
      }
      const agentModeRaw = obj["agentMode"];
      const agentMode = agentModeRaw != null ? `${agentModeRaw}` : "";
      if (agentMode == "ask" || agentMode == "yolo") {
        draft.agentMode = agentMode;
      }
      savePendingChatDraft(draft);
      await jumpToAgentDetailPage(agentId, convId, resolveAgentType(), defaultAgentName.value);
    } catch (error) {
      console.error("创建会话失败", error);
      uni.showToast({
        title: t("Mobile.CreateHub.sendFailed"),
        icon: "none",
      });
    } finally {
      sending.value = false;
      uni.hideLoading();
    }
  }
</script>

<style lang="scss" scoped>
  .create-hub {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #ffffff;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  .create-hub__nav {
    padding: 12rpx 32rpx 0;
  }

  .create-hub__back {
    width: 72rpx;
    height: 72rpx;
    border-radius: 50%;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  }

  .create-hub__back--pressed {
    opacity: 0.7;
  }

  .create-hub__hero {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 48rpx 40rpx;
  }

  .create-hub__title {
    font-size: 52rpx;
    font-weight: 700;
    line-height: 72rpx;
    color: #111111;
    text-align: center;
  }

  .create-hub__subtitle {
    margin-top: 16rpx;
    font-size: 28rpx;
    line-height: 40rpx;
    color: #8a8a8a;
    text-align: center;
  }

  .create-hub__modes {
    margin-top: 48rpx;
    width: 480rpx;
    max-width: 100%;
    padding: 8rpx;
    border-radius: 999rpx;
    background-color: #f3f3f3;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .create-hub__mode {
    flex: 1;
    height: 72rpx;
    border-radius: 999rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .create-hub__mode--on {
    background-color: #ffffff;
    box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  }

  .create-hub__mode-text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #8a8a8a;
  }

  .create-hub__mode-text--on {
    color: #111111;
    font-weight: 600;
  }

  .create-hub__bottom {
    flex-shrink: 0;
  }
</style>

<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  /* #endif */
</style>
