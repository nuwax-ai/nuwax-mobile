/**
 * 会议媒体适配。Android 和 iOS 使用 LiveKit 原生 SDK，鸿蒙隔离测试包使用 ArkWeb。
 * 各端复用服务端令牌和会议协议，每次只管理本端的一场会议。插件未就绪时只展示会议信息。
 */

import { SUCCESS_CODE } from "@/constants/codes.constants";
import { apiImMeetingIssueToken, apiImMeetingPublicRoomSafe, apiImMeetingTakeShareHolder, apiImMeetingGuestReleaseShareHolder, meetingShareReleaseEndpoint } from "@/servers/imMeeting";
import { apiResCode, apiResData } from "@/utils/apiResponse";
// 会议媒体状态变更广播走仓内 eventBus（App-Android 上 uni.$on 的订阅者有零触发前科）
import eventBus from "@/utils/eventBus";
// #ifdef APP-ANDROID
import { rememberMeetingResumeState, restoreMeetingResumeState, acknowledgeMeetingRestoreRequest } from "@/uni_modules/nuwax-livekit";
// #endif

// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
import {
  connect as livekitConnect,
  disconnect as livekitDisconnect,
  isConnected as livekitIsConnected,
  isSupported as livekitIsSupported,
  sdkVersion as livekitSdkVersion,
  lastError as livekitLastError,
  localAudioLevel as livekitLocalAudioLevel,
  localHandRaised as livekitLocalHandRaised,
  participantCount as livekitParticipantCount,
  roomMetadata as livekitRoomMetadata,
  setCameraEnabled as livekitSetCamera,
  setHandRaised as livekitSetHandRaised,
  setMicEnabled as livekitSetMic,
  setSpeakerEnabled as livekitSetSpeaker,
  switchCamera as livekitSwitchCamera,
  sendMeetingMessage as livekitSendMeetingMessage,
  drainMeetingMessages as livekitDrainMeetingMessages,
  remoteSpeakingIdentity as livekitRemoteSpeakingIdentity,
  requestScreenShare as livekitRequestScreenShare,
  stopScreenShare as livekitStopScreenShare,
  isScreenShareOn as livekitIsScreenShareOn,
  screenShareError as livekitScreenShareError,
  configureBackgroundSession as livekitConfigureBackgroundSession,
  releaseMeetingPageViews as livekitReleaseMeetingPageViews,
  isScreenShareStopping as livekitIsScreenShareStopping,
  setMeetingPresentation as livekitSetMeetingPresentation,
  consumeMeetingRestoreRequest as livekitConsumeMeetingRestoreRequest,
} from "@/uni_modules/nuwax-livekit";
// #endif

// #ifdef APP-IOS
import { isMicEnabled as livekitIsMicEnabled, isSpeakerEnabled as livekitIsSpeakerEnabled } from "@/uni_modules/nuwax-livekit";
// #endif

// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
import { remoteVideoIdentities as livekitRemoteVideoIdentities } from "@/uni_modules/nuwax-livekit";
// #endif
// #ifdef APP-HARMONY
import { hasNativeVoipCall } from "@/uni_modules/nuwax-voip";
import {
  isMicEnabled as livekitMicEnabled,
  isCameraEnabled as livekitCameraEnabled,
  isSpeakerEnabled as livekitSpeakerEnabled,
  isRemoteScreenVisible as livekitRemoteScreenVisible,
  isScreenCaptureSupported as livekitScreenCaptureSupported,
  isAwaitingScreenCapture as livekitAwaitingScreenCapture,
  prepareScreenCapture as livekitPrepareScreenCapture,
  consumeMeetingControlError as livekitConsumeControlError,
  disconnectConfirmed as livekitDisconnectConfirmed,
} from "@/uni_modules/nuwax-livekit";
// #endif

/** 媒体状态变更（连接/断开、麦克风/摄像头/扬声器切换）。载荷为空对象。 */
export const MEETING_MEDIA_CHANGED_EVENT = "im-meeting-media-changed";

/** 媒体会话的连接参数（令牌由服务端签发，客户端不自己算地址）。 */
export class MeetingMediaOptions {
  /** 会议号（= LiveKit 房间名）。 */
  room: string = "";
  /** 我自己的展示名（进 LiveKit participant name，不落库）。 */
  displayName: string = "";
  /** 入会密码（会议设了才传；服务端据此校验）。 */
  passcode: string = "";
}

/** 媒体会话快照（对外只读；调用方拿到的是拷贝，改不动内部状态）。 */
export class MeetingMediaState {
  /** 是否已连上房间。 */
  connected: boolean = false;
  /** 正在连接（点了没反应的那段时间要能显示 loading）。 */
  connecting: boolean = false;
  /** 本地麦克风是否在采集。 */
  micOn: boolean = false;
  /** 本地摄像头是否在采集（默认关，与 PC「语音开局」口径一致）。 */
  cameraOn: boolean = false;
  /** 是否走扬声器（否则听筒/耳机）。 */
  speakerOn: boolean = true;
  /** 房间内人数（含本端；0 = 未知/未连接）。 */
  peopleCount: number = 0;
  /** 会议时长上限（秒；0 = 服务端没给，界面上不显示"限时"）。来源：令牌接口 `plannedDurationSec`。 */
  plannedDurationSec: number = 0;
  /** 服务端记录的真实开会时刻（epoch ms）；中途入会也据此计算剩余时长。 */
  meetingStartedAtMs: number = 0;
  /** 最近一次失败的简短原因（页面可直出，不需要 i18n 时留空）。 */
  errorText: string = "";
  // #ifdef APP-HARMONY
  visualMedia: boolean = false;
  // #endif
}

/** LiveKit 房间 metadata 快照；字段与 PC `RoomSettings` 保持一致。 */
export class MeetingRoomMetadata {
  muteAll: boolean = false;
  danmaku: boolean = true;
  hostUserId: string = "";
  shareSlug: string = "";
  shareHolder: string = "";
  shareHolderName: string = "";
  shareSince: number = 0;
}

// ---------------------------------------------------------------- 内部状态

let state = new MeetingMediaState();
let activeRoom = "";
// 仅内存中保存入会凭据，禁止写 storage/日志或广播扩展共享目录。
let activeMeetingToken = "";
let resumeURL = "";
let minimized = false;
let sessionPollTimer = -1;
let shareRequested = false;
let shareObservedOn = false;
let shareAttemptStartedAt = 0;
let shareGeneration = 0;
let shareNativeRequested = false;
let shareRequestInFlight = false;
let shareStopping = false;
let connectGeneration = 0;
// 后台扩展是独立能力。旧基座普通入会仍可用，不能因新增导出缺失误报连接失败。
let backgroundSessionReady = false;
let meetingPageVisible = true;
let appForeground = true;
let nativePresentationReady = false;
let resumeNavigating = false;
let resumeRequested = false;
let resumeRetryAfter = 0;
let resumePollTimer = -1;
let presentedRoute = "";
let nativeResumeAllowed = true;
let navigationObserversInstalled = false;
const MEETING_ROOM_ROUTE = "subpackages/pages/im-meeting/im-meeting-room";

function readStr(obj: UTSJSONObject, key: string): string {
  const value = obj[key];
  return value != null ? `${value}` : "";
}

function readBool(obj: UTSJSONObject, key: string): boolean {
  const value = obj[key];
  if (value == null) {
    return false;
  }
  if (typeof value == "boolean") {
    return value as boolean;
  }
  return `${value}` == "true";
}

function readNumOr(obj: UTSJSONObject, key: string, fallback: number): number {
  const value = obj[key];
  if (value == null) {
    return fallback;
  }
  if (typeof value == "number") {
    const n = value as number;
    return n != n ? fallback : n;
  }
  const parsed = parseFloat(`${value}`);
  return parsed != parsed ? fallback : parsed;
}

function changed(): void {
  eventBus.emit(MEETING_MEDIA_CHANGED_EVENT, {});
}

function resetState(): void {
  state = new MeetingMediaState();
  activeRoom = "";
  activeMeetingToken = "";
  backgroundSessionReady = false;
  nativePresentationReady = false;
  meetingPageVisible = true;
  resumeNavigating = false;
  resumeRequested = false;
  resumeRetryAfter = 0;
  presentedRoute = "";
  nativeResumeAllowed = false;
  if (resumePollTimer != -1) { clearInterval(resumePollTimer); resumePollTimer = -1; }
  resumeURL = "";
  minimized = false;
  shareRequested = false;
  shareNativeRequested = false;
  shareObservedOn = false;
  shareAttemptStartedAt = 0;
  if (sessionPollTimer != -1) {
    clearInterval(sessionPollTimer);
    sessionPollTimer = -1;
  }
}

/** 连接结果轮询句柄（-1 = 没在轮询）。 */
let connectPollTimer = -1;

function stopConnectPoll(): void {
  if (connectPollTimer != -1) {
    clearInterval(connectPollTimer);
    connectPollTimer = -1;
  }
}

/** 原生确认入会后再配置后台能力；Android connect 内部也会清理旧会话配置。 */
function configureConnectedBackgroundSession(): void {
  backgroundSessionReady = false;
  // #ifdef APP-ANDROID || APP-IOS
  try {
    livekitConfigureBackgroundSession(meetingShareReleaseEndpoint(activeRoom), activeMeetingToken);
    backgroundSessionReady = true;
  } catch (_error) {
    // 不输出异常原文：跨桥调用参数可能含 JWT。真实基座标记由既有 diag 提供。
    console.error("[Meeting] background session unavailable; native connection remains active. Check installed custom base probe.");
  }
  // #endif
  syncMeetingPresentation();
  rememberNativeResumeState();
  startMeetingResumePoll();
}

function rememberNativeResumeState(): void {
  // 仅原生内存：Activity/业务运行时重建后复用仍存活的 Room，绝不把令牌落盘。
  // #ifdef APP-ANDROID
  if (state.connected && resumeURL.length > 0 && activeMeetingToken.length > 0) {
    try { rememberMeetingResumeState(activeRoom, resumeURL, activeMeetingToken); } catch (_e) {}
  }
  // #endif
}

function restoreNativeResumeState(): void {
  // #ifdef APP-ANDROID
  if (!nativeResumeAllowed || activeRoom.length > 0) return;
  try {
    const raw = restoreMeetingResumeState();
    if (raw.length == 0) return;
    const saved = JSON.parseObject(raw);
    if (saved == null) return;
    const room = readStr(saved, "room");
    const url = readStr(saved, "url");
    const token = readStr(saved, "token");
    if (room.length == 0 || token.length == 0 || !url.startsWith("/" + MEETING_ROOM_ROUTE + "?")) return;
    activeRoom = room;
    activeMeetingToken = token;
    resumeURL = url;
    nativeResumeAllowed = false;
    state.connected = true;
    state.micOn = readBool(saved, "mic");
    state.cameraOn = readBool(saved, "camera");
    state.speakerOn = readBool(saved, "speaker");
    minimized = true;
    meetingPageVisible = false;
    connectGeneration += 1;
    configureConnectedBackgroundSession();
    changed();
  } catch (_e) {}
  // #endif
}

/** 全局导航成功后同步，手势返回和原生宿主切换由轻量轮询兜底。 */
export function installMeetingNavigationObservers(): void {
  if (navigationObserversInstalled) return;
  navigationObserversInstalled = true;
  const methods = ["navigateTo", "navigateBack", "redirectTo", "reLaunch", "switchTab"];
  for (let i = 0; i < methods.length; i++) {
    uni.addInterceptor(methods[i], {
      success: (_res: any): void => { meetingMediaPageDidShow(); },
    } as AddInterceptorOptions);
  }
}

/** 不依赖每个业务页面单独挂载浮窗组件。 */
export function meetingMediaPageDidShow(): void {
  if (!state.connected) return;
  syncMeetingRoute();
  pollMeetingResume();
}

function syncMeetingRoute(): void {
  if (!appForeground || !state.connected) return;
  const pages = getCurrentPages();
  if (pages.length == 0) return;
  const route = pages[pages.length - 1].route;
  const wasVisible = meetingPageVisible;
  const wasMinimized = minimized;
  meetingPageVisible = route == MEETING_ROOM_ROUTE;
  minimized = !meetingPageVisible;
  if (route != presentedRoute || wasVisible != meetingPageVisible || wasMinimized != minimized) {
    presentedRoute = route;
    syncMeetingPresentation();
    changed();
  }
}

function startMeetingResumePoll(): void {
  if (!appForeground || !state.connected || resumePollTimer != -1) return;
  // 原生入口点击只查询轻量标记，不重复拉接口或读取媒体轨道。
  resumePollTimer = setInterval(() => { pollMeetingResume(); }, 250);
}

function pollMeetingResume(): void {
  if (!appForeground || !state.connected) return;
  syncMeetingRoute();
  // 返回请求独立于浮窗配置结果，避免新宿主尚未挂窗时丢失通知/PiP 返回。
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    if (livekitConsumeMeetingRestoreRequest()) {
      if (!resumeRequested) resumeRetryAfter = 0;
      resumeRequested = true;
    }
  } catch (_e) {}
  // #endif
  flushMeetingResume();
}

function syncMeetingPresentation(): void {
  if (!state.connected) return;
  // #ifdef APP-ANDROID || APP-IOS
  try {
    livekitSetMeetingPresentation(meetingPageVisible && !minimized, appForeground);
    nativePresentationReady = true;
  } catch (_e) {
    // 旧基座继续使用 App 内返回会议提示，不牵连聊天、举手和原有共享。
    nativePresentationReady = false;
  }
  // #endif
}

export function meetingMediaSetPageVisible(visible: boolean): void {
  meetingPageVisible = visible;
  if (visible) minimized = false;
  syncMeetingPresentation();
  changed();
}
/** 只由实际会议页 onShow 确认，不能在 App.onShow 或导航成功回调中提前消费。 */
export function meetingMediaConfirmPageVisible(room: string): void {
  if (!state.connected || room != activeRoom) return;
  meetingMediaSetPageVisible(true);
  resumeRequested = false;
  resumeRetryAfter = 0;
  // #ifdef APP-ANDROID
  try { acknowledgeMeetingRestoreRequest(); } catch (_e) {}
  // #endif
  console.error("[MeetingResume] confirmed meeting page visible");
}
export function meetingMediaSetAppForeground(foreground: boolean): void {
  appForeground = foreground;
  // #ifdef APP-HARMONY
  try { livekitSetMeetingPresentation(meetingPageVisible && !minimized, foreground); } catch (_error) {}
  // #endif
  if (!foreground && resumePollTimer != -1) { clearInterval(resumePollTimer); resumePollTimer = -1; }
  syncMeetingPresentation();
  if (foreground) startMeetingResumePoll();
}
export function meetingMediaHasNativeWindow(): boolean { return nativePresentationReady; }

/**
 * 连接结果轮询：每 500ms 问一次原生层「连上了吗/出错了吗」，最多约 20 秒。
 * ★为什么不用回调：UTS 函数类型跨到 Swift 会变成 `UTSCallback`，iOS 编译直接报
 *   `'UTSCallback' is unavailable`；改成状态查询后三端接口完全一致。
 */
function startConnectPoll(): void {
  stopConnectPoll();
  let ticks = 0;
  connectPollTimer = setInterval(() => {
    ticks = ticks + 1;
    let connected = false;
    let err = "";
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    try {
      connected = livekitIsConnected();
      err = livekitLastError();
    } catch (_e) {
      err = "exception";
    }
    // #endif
    if (connected) {
      stopConnectPoll();
      state.connected = true;
      state.connecting = false;
      state.errorText = "";
      // 入会默认设备状态（麦克风关、摄像头关），与 connect 入参一致
      state.micOn = false;
      state.cameraOn = false;
      configureConnectedBackgroundSession();
      meetingMediaReconcile();
      changed();
      return;
    }
    if (err.length > 0) {
      stopConnectPoll();
      state.connected = false;
      state.connecting = false;
      state.errorText = err;
      changed();
      return;
    }
    if (ticks > 40) {
      stopConnectPoll();
      // 超时后不能让原生稍后再连成一个无人管理的后台会议。
      // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
      try { livekitDisconnect(); } catch (_e) {}
      // #endif
      state.connecting = false;
      state.errorText = "connect";
      changed();
    }
  }, 500);
}

// ---------------------------------------------------------------- 能力查询

/**
 * 本端能不能真正收发音视频。
 * ★false 时调用方不要发令牌请求、不要显示开关态，只如实说明能力未就绪。
 * ★能力由插件自己报（`nuwax-livekit` 的 isSupported）：SDK 随基座后它返回 true，
 *   业务层无需改任何判断。
 */
export function meetingMediaSupported(): boolean {
  let supported = false;
  // #ifdef APP-ANDROID || APP-IOS
  try {
    supported = livekitIsSupported();
    console.error(`[Meeting] isSupported returned ${supported}`);
  } catch (_e) {
    // 标准基座不含插件 / 原生调用异常：一律按不支持处理
    // ★必须把异常本身打出来：iOS 上「基座里没有原生类」就表现为调用抛错，
    //   只打 false 会把「没打进基座」误判成「插件说本端不支持」。
    console.error(`[Meeting] isSupported threw: ${_e}`);
    supported = false;
  }
  // #endif
  // #ifdef APP-IOS
  // 与能力结果分开捕获：诊断调用失败不能把已可用的媒体能力改成 false。
  try {
    console.error(`[Meeting] iOS base probe ${livekitSdkVersion()}`);
  } catch (_e) {
    console.error(`[Meeting] iOS base probe threw: ${_e}`);
  }
  // #endif
  // #ifdef APP-HARMONY
  try {
    supported = livekitIsSupported();
    console.error(`[Meeting] Harmony isSupported returned ${supported}`);
  } catch (_error) {
    console.error(`[Meeting] Harmony isSupported threw: ${_error}`);
    supported = false;
  }
  // #endif
  return supported;
}

/** 当前平台名（排查用；与 identity 里的 platform 段同一词表）。 */
export function meetingMediaPlatform(): string {
  let platform = "other";
  // #ifdef APP-ANDROID
  platform = "android";
  // #endif
  // #ifdef APP-IOS
  platform = "ios";
  // #endif
  // #ifdef APP-HARMONY
  platform = "harmonyos";
  // #endif
  return platform;
}

// #ifdef APP-IOS
function refreshNativeAudioState(): boolean {
  const mic = livekitIsMicEnabled();
  const speaker = livekitIsSpeakerEnabled();
  const audioChanged = state.micOn != mic || state.speakerOn != speaker;
  state.micOn = mic;
  state.speakerOn = speaker;
  return audioChanged;
}
// #endif

export function meetingMediaState(): MeetingMediaState {
  const copy = new MeetingMediaState();
  copy.connected = state.connected;
  copy.connecting = state.connecting;
  copy.micOn = state.micOn;
  copy.cameraOn = state.cameraOn;
  copy.speakerOn = state.speakerOn;
  // #ifdef APP-IOS
  if (state.connected) {
    try {
      copy.micOn = livekitIsMicEnabled();
      copy.speakerOn = livekitIsSpeakerEnabled();
    } catch (_e) {}
  }
  // #endif
  copy.peopleCount = state.peopleCount;
  copy.plannedDurationSec = state.plannedDurationSec;
  copy.meetingStartedAtMs = state.meetingStartedAtMs;
  copy.errorText = state.errorText;
  // #ifdef APP-HARMONY
  copy.visualMedia = state.visualMedia;
  // #endif
  // 已连接时以插件实时人数为准（会中人员进出由 RoomEvent 更新，这里再兜一道）
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    const live = livekitParticipantCount();
    if (live > 0) {
      copy.peopleCount = live;
    }
  } catch (_e) {
  }
  // #endif
  return copy;
}

export function meetingMediaActiveRoom(): string { return state.connected || state.connecting ? activeRoom : ""; }
export function meetingMediaIsMinimized(): boolean { return minimized && state.connected; }
export function meetingMediaSetResumeURL(url: string): void { resumeURL = url; rememberNativeResumeState(); }
export function meetingMediaSetMinimized(on: boolean): void {
  minimized = on;
  meetingPageVisible = !on;
  syncMeetingPresentation();
  changed();
}
export function meetingMediaResume(): void {
  if (!state.connected) return;
  if (!resumeRequested) resumeRetryAfter = 0;
  resumeRequested = true;
  flushMeetingResume();
}
function flushMeetingResume(): void {
  if (!resumeRequested || !appForeground || resumeURL.length == 0 || !state.connected || resumeNavigating) return;
  // #ifdef APP-HARMONY
  if (hasNativeVoipCall()) {
    resumeRequested = false;
    resumeRetryAfter = 0;
    return;
  }
  // #endif
  const pages = getCurrentPages();
  if (pages.length == 0) return;
  if (pages[pages.length - 1].route == MEETING_ROOM_ROUTE) {
    resumeRequested = false;
    return;
  }
  // complete 可能先于原生 Activity 切换结束；避免 250ms 轮询反复叠加导航。
  if (Date.now() < resumeRetryAfter) return;
  resumeRetryAfter = Date.now() + 1000;
  const generation = connectGeneration;
  resumeNavigating = true;
  // 点击回会只能向前打开会议。后台/任务重建后的页面列表可能残留旧会议页，
  // 不能按它计算 navigateBack(delta)：原生栈不一致时会退掉当前宿主甚至退到桌面。
  // meetingMediaConnect 已按 activeRoom 复用原生 Room，不会重复签票或新增参会席位。
  console.error(`[MeetingResume] navigate depth=${pages.length}`);
  uni.navigateTo({ url: resumeURL,
    // navigateTo 成功不代表会议页已经显示。保留请求，直到顶部路由确认是会议。
    fail: (_res) => {
      if (generation != connectGeneration || pages.length < 10) return;
      uni.redirectTo({ url: resumeURL });
    },
    complete: (_res) => { if (generation == connectGeneration) resumeNavigating = false; },
  });
}
export function meetingMediaReleasePageViews(): void {
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try { livekitReleaseMeetingPageViews(); } catch (_e) {}
  // #endif
}

// ---------------------------------------------------------------- 连接 / 断开

/**
 * 入会：签发令牌 → 交给原生插件连房。
 * ★只连接、不建房：查不到会议就失败返回，绝不因连不上而创建同号空房（方案 §4.1-3）。
 * ★加入前先断开上一场：模块只管理一场会议（方案 §4.1-7）。
 */
export async function meetingMediaConnect(options: MeetingMediaOptions): Promise<boolean> {
  if (state.connected) {
    if (activeRoom == options.room) return true;
    // 最小化后也只允许一场会议，不能把旧 Room 当作新会议的连接成功。
    return false;
  }
  if (state.connecting) {
    return false;
  }
  if (!meetingMediaSupported()) {
    // 插件未随包：不发请求、不改状态，交给页面显示「接入中」
    return false;
  }
  state.connecting = true;
  nativeResumeAllowed = false;
  backgroundSessionReady = false;
  activeRoom = options.room;
  connectGeneration += 1;
  const generation = connectGeneration;
  state.errorText = "";
  changed();
  try {
    // ★★连接前先问服务端"这场会走到哪一步了"：LiveKit 允许连不存在的房间（会顺手建房），
    //   不预检就会在"房间早没了、列表还挂着进行中"的脏状态下凭空造出一间同号空房。
    //   ★预检请求本身失败（网络/500）时放行连接：宁可偶尔多一次连接尝试，也不要把
    //     刚建好的会议挡在门外。
    const pre = await apiImMeetingPublicRoomSafe(options.room);
    if (generation != connectGeneration) return false;
    if (apiResCode(pre) == "IM_50001" || apiResCode(pre) == "IM_50002") {
      state.connecting = false;
      state.errorText = "ended";
      changed();
      return false;
    }
    if (apiResCode(pre) == SUCCESS_CODE) {
      const preRaw = apiResData<any>(pre);
      const preObj = preRaw != null ? (preRaw as UTSJSONObject) : null;
      if (preObj != null && !readBool(preObj, "active")) {
        // 只拦**明确**的三种「进不去」；status 拿不到（老房间/记录查不到）时放行，
        // 避免刚建完房的竞态被误判成「已结束」
        const preStatus = readNumOr(preObj, "status", -1);
        const earlyJoin = readBool(preObj, "allowEarlyJoin");
        if (preStatus == 3) {
          state.connecting = false;
          state.errorText = "cancelled";
          changed();
          return false;
        }
        if (preStatus == 0 && !earlyJoin) {
          state.connecting = false;
          state.errorText = "notStarted";
          changed();
          return false;
        }
        if (preStatus == 2) {
          state.connecting = false;
          state.errorText = "ended";
          changed();
          return false;
        }
      }
    }

    const res = await apiImMeetingIssueToken(options.room, options.displayName, "", options.passcode);
    if (generation != connectGeneration) return false;
    if (apiResCode(res) != SUCCESS_CODE) {
      state.connecting = false;
      // ★按错误码给人话：被移出/密码错如果只说「连接失败」，用户会一直重试
      //   IM_50006 = 已被移出该会议；IM_50008 = 入会密码不正确
      const failCode = apiResCode(res);
      if (failCode == "IM_50006") {
        state.errorText = "banned";
      } else if (failCode == "IM_50008") {
        state.errorText = "passcode";
      } else if (failCode == "IM_50001" || failCode == "IM_50002") {
        state.errorText = "ended";
      } else if (failCode == "IM_50003") {
        state.errorText = "full";
      } else {
        state.errorText = "token";
      }
      console.error(`[Meeting] issueToken failed code=${failCode} -> ${state.errorText}`);
      changed();
      return false;
    }
    const data = apiResData<any>(res);
    const obj = data != null ? (data as UTSJSONObject) : null;
    const wsUrl = obj != null ? readStr(obj, "wsUrl") : "";
    const token = obj != null ? readStr(obj, "token") : "";
    // 会议时长上限（毫秒？不，后端是秒）：PC 端「限时 2 小时」用的就是令牌里的这个字段
    state.plannedDurationSec = obj != null ? readNumOr(obj, "plannedDurationSec", 0) : 0;
    state.meetingStartedAtMs = obj != null ? readNumOr(obj, "meetingStartedAt", 0) : 0;
    // #ifdef APP-HARMONY
    // ArkWeb 首次建页/连房比原生 SDK 慢，令牌时长先到就先刷新顶部限时提示。
    changed();
    // #endif
    if (wsUrl.length == 0 || token.length == 0) {
      state.connecting = false;
      state.errorText = "token";
      changed();
      return false;
    }

    // 排查用：把服务端下发的地址打出来（鸿蒙真机看不到 console.log，统一用 error）
    console.error(`[Meeting] token ok room=${options.room} wsUrl=${wsUrl}`);

    // ---------------------------------------------------------------- 交给原生插件
    // Android/iOS：nuwax-livekit 里包 LiveKit 官方 SDK；SDK 未随基座时插件回报
    // `livekit_sdk_missing` 且不置 connected（见插件文件头）。
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    // 状态经回调持续回报（连上/断开/人数变化），这里不等同步结果
    // 入会默认：**麦克风关**（由用户主动点开）、摄像头关
    // ★不传回调（UTS 回调跨到 Swift 会变成 UTSCallback 编不过），改为轮询状态
    activeMeetingToken = token;
    livekitConnect(wsUrl, token, options.room, options.displayName, false, false);
    startConnectPoll();
    // #endif

    return state.connected;
  } catch (_error) {
    if (generation != connectGeneration) return false;
    console.error("[Meeting] connect setup failed before polling; check token response and native bridge availability");
    state.connecting = false;
    state.errorText = "exception";
    changed();
    return false;
  }
}

/**
 * 离开会议：只断自己，不删房（对齐 PC「仅退出」；结束会议是主持人动作，走服务端删房）。
 */
export async function meetingMediaDisconnect(): Promise<boolean> {
  connectGeneration += 1;
  // 停掉连接结果轮询，避免退房后还把状态改回 connected
  stopConnectPoll();
  if (shareRequested || shareObservedOn) {
    void meetingMediaStopScreenShare(activeRoom);
  }
  // Android/iOS：交给插件退房（停采集、停前台服务/通知、归还音频会话）
  // #ifdef APP-ANDROID || APP-IOS
  try {
    livekitDisconnect();
  } catch (_e) {
    // 基座不含插件时静默：本来也没连上
  }
  // #endif
  // #ifdef APP-HARMONY
  let leaving = Promise.resolve(false);
  try { leaving = livekitDisconnectConfirmed(); } catch (_error) {}
  // #endif
  resetState();
  changed();
  // #ifdef APP-HARMONY
  return await leaving;
  // #endif
  // #ifndef APP-HARMONY
  return true;
  // #endif
}

// ---------------------------------------------------------------- 设备开关

/** 麦克风开关（未连接时忽略，避免留下"以为开了其实没连"的状态）。 */
export function meetingMediaSetMic(on: boolean): void {
  if (!state.connected) {
    return;
  }
  // #ifdef APP-ANDROID || APP-IOS
  console.error(`[Meeting] setMic ${on} -> native`);
  try {
    livekitSetMic(on);
  } catch (_e) {
    console.error(`[Meeting] setMic throw: ${_e}`);
  }
  console.error(`[Meeting] setMic ${on} <- native`);
  // #endif
  // #ifndef APP-IOS || APP-HARMONY
  state.micOn = on;
  changed();
  // #endif
  // #ifdef APP-HARMONY
  try {
    if (!on || !hasNativeVoipCall()) livekitSetMic(on);
  } catch (_error) {}
  // #endif
}

/** 摄像头开关（默认关；关闭时**不保留最后一帧**，由插件侧销毁渲染）。 */
export function meetingMediaSetCamera(on: boolean): void {
  if (!state.connected) {
    return;
  }
  // #ifdef APP-ANDROID || APP-IOS
  console.error(`[Meeting] setCamera ${on} -> native`);
  try {
    livekitSetCamera(on);
  } catch (_e) {
    console.error(`[Meeting] setCamera throw: ${_e}`);
  }
  console.error(`[Meeting] setCamera ${on} <- native`);
  state.cameraOn = on;
  changed();
  // #endif
  // #ifdef APP-HARMONY
  try {
    if (!on || !hasNativeVoipCall()) livekitSetCamera(on);
  } catch (_error) {}
  // #endif
}

/** 扬声器 / 听筒切换（iOS 需要 AVAudioSession 路由，Android 走 AudioManager 路由）。 */
export function meetingMediaSetSpeaker(on: boolean): void {
  if (!state.connected) {
    return;
  }
  // #ifdef APP-ANDROID || APP-IOS
  try {
    livekitSetSpeaker(on);
  } catch (_e) {
  }
  // #endif
  // #ifndef APP-IOS || APP-HARMONY
  state.speakerOn = on;
  changed();
  // #endif
  // #ifdef APP-HARMONY
  try {
    if (!hasNativeVoipCall()) livekitSetSpeaker(on);
  } catch (_error) {}
  // #endif
}

/**
 * 本机麦克风音量（0..1）：页面按 ~250ms 拉取画"说话音波"。
 * ★没连上/未开麦恒 0，避免画面上一直跳动。
 */
export function meetingMediaLocalAudioLevel(): number {
  let level = 0.0;
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    level = livekitLocalAudioLevel();
  } catch (_e) {
    level = 0;
  }
  // #endif
  if (!state.connected || !state.micOn) {
    return 0;
  }
  if (level < 0) {
    return 0;
  }
  return level > 1 ? 1 : level;
}

/**
 * 已订阅到视频的远端成员 identity 列表（逗号解析成数组）。
 * ★空数组 = 没人开视频；页面据此决定哪些宫格格子换成视频画面。
 */
export function meetingMediaRemoteVideoIdentities(): string[] {
  const out: string[] = [];
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  if (state.connected) {
    try {
      const raw = livekitRemoteVideoIdentities();
      if (raw.length > 0) {
        const parts = raw.split(",");
        for (let i = 0; i < parts.length; i++) {
          const one = parts[i].trim();
          if (one.length > 0) {
            out.push(one);
          }
        }
      }
    } catch (_e) {
    }
  }
  // #endif
  return out;
}

/**
 * 房间 metadata 权威快照。缺键 / 解析失败按 PC 口径回退：muteAll=false、danmaku=true。
 */
export function meetingMediaRoomMetadata(): MeetingRoomMetadata {
  const out = new MeetingRoomMetadata();
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  if (state.connected) {
    try {
      const raw = livekitRoomMetadata();
      if (raw.length > 0) {
        const parsed = JSON.parse(raw);
        if (parsed != null) {
          const obj = parsed as UTSJSONObject;
          out.muteAll = readBool(obj, "muteAll");
          const danmakuRaw = obj["danmaku"];
          out.danmaku = danmakuRaw == null ? true : readBool(obj, "danmaku");
          out.hostUserId = readStr(obj, "hostUserId");
          out.shareSlug = readStr(obj, "shareSlug").trim();
          out.shareHolder = readStr(obj, "shareHolder").trim();
          out.shareHolderName = readStr(obj, "shareHolderName").trim();
          out.shareSince = readNumOr(obj, "shareSince", 0);
        }
      }
    } catch (_e) {
      return new MeetingRoomMetadata();
    }
  }
  // #endif
  return out;
}

/** 举手 / 放下手（LiveKit participant attributes.handRaised）。 */
export function meetingMediaSetHandRaised(on: boolean): void {
  if (!state.connected) {
    return;
  }
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    livekitSetHandRaised(on);
  } catch (_e) {
  }
  // #endif
}

/**
 * 当前正在说话的远端成员 identity（空串 = 没有人在说）。
 * 给「演讲者」布局挑大图用：页面在演讲者布局下按秒轮询。
 */
export function meetingMediaRemoteSpeakingIdentity(): string {
  if (!state.connected) {
    return "";
  }
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    return livekitRemoteSpeakingIdentity();
  } catch (_e) {
  }
  // #endif
  return "";
}

/** 查询本端举手状态；用于跨端变更后的轮询校准。 */
export function meetingMediaLocalHandRaised(): boolean {
  if (!state.connected) {
    return false;
  }
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    return livekitLocalHandRaised();
  } catch (_e) {
  }
  // #endif
  return false;
}

/** Send a reliable PC-compatible chat/danmaku packet in the active room.
 *  ★不限长度：120 字是历史口径、并非服务端限制；硬上限只有 LiveKit 数据包大小。 */
export function meetingMediaSendMessage(text: string, displayName: string, asDanmaku: boolean): void {
  if (!state.connected || text.trim().length == 0) return;
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try { livekitSendMeetingMessage(text.trim(), displayName, asDanmaku); } catch (_e) {}
  // #endif
}

/** Messages queued by the native DataChannel listener, serialized as a JSON array. */
export function meetingMediaDrainMessages(): string {
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try { return livekitDrainMeetingMessages(); } catch (_e) { return "[]"; }
  // #endif
  return "[]";
}

/** 屏幕上一次「抢共享占位」失败的原因（空 = 成功 / 还没试过）。页面据此给出准确提示。 */
let lastShareStartError = "";

/** 读一次最近一次启动共享失败的原因：`busy` / `platform` / `disconnected` / `http:IM_xxx` / `threw`。 */
export function meetingMediaScreenShareStartError(): string {
  return lastShareStartError;
}

/** Acquire server ownership before prompting the platform screen-capture consent UI. */
export async function meetingMediaStartScreenShare(room: string, label: string = "", cancelLabel: string = ""): Promise<boolean> {
  lastShareStartError = "";
  if (!state.connected) {
    lastShareStartError = "disconnected";
    return false;
  }
  // #ifndef APP-HARMONY
  if (meetingMediaPlatform() != "android" && meetingMediaPlatform() != "ios") {
    lastShareStartError = "platform";
    return false;
  }
  // #endif
  // #ifdef APP-HARMONY
  if (activeRoom != room) {
    lastShareStartError = "disconnected";
    return false;
  }
  if (!livekitScreenCaptureSupported() || label.length == 0 || cancelLabel.length == 0) {
    lastShareStartError = "platform";
    return false;
  }
  if (livekitIsScreenShareStopping()) {
    lastShareStartError = "busy";
    return false;
  }
  // #endif
  // 后台整屏共享是新增能力；旧基座仍走原有 requestScreenShare，不能禁用已验证的应用内共享。
  if (shareRequested || shareRequestInFlight || shareStopping) {
    lastShareStartError = "busy";
    return false;
  }
  // #ifdef APP-ANDROID || APP-IOS
  if (backgroundSessionReady) {
    try {
      if (livekitIsScreenShareStopping()) {
        lastShareStartError = "busy";
        return false;
      }
    } catch (_e) {}
  }
  // #endif
  shareRequestInFlight = true;
  shareGeneration += 1;
  const attempt = shareGeneration;
  const generation = connectGeneration;
  const seatToken = activeMeetingToken;
  shareRequested = true;
  shareAttemptStartedAt = Date.now();
  try {
    const response = await apiImMeetingTakeShareHolder(room, meetingMediaPlatform());
    if (generation != connectGeneration || activeRoom != room || attempt != shareGeneration) {
      // 申请占位过程中退出，迟到的成功结果也要归还原席位。
      lastShareStartError = "left";
      if (apiResCode(response) == SUCCESS_CODE && seatToken.length > 0) {
        // #ifdef APP-HARMONY
        try { await apiImMeetingGuestReleaseShareHolder(room, seatToken); } catch (_error) {}
        // #endif
        // #ifndef APP-HARMONY
        void apiImMeetingGuestReleaseShareHolder(room, seatToken);
        // #endif
      }
      return false;
    }
    if (apiResCode(response) != SUCCESS_CODE) {
      // 共享失败定位口：服务端拒绝（限流/权限）与端上授权失败要能分开
      const failCode = apiResCode(response);
      lastShareStartError = `http:${failCode}`;
      console.error(`[Meeting] takeShareHolder failed code=${failCode} platform=${meetingMediaPlatform()}`);
      shareRequested = false;
      return false;
    }
    // #ifdef APP-ANDROID || APP-IOS
    console.error(`[Meeting] takeShareHolder ok, request native capture platform=${meetingMediaPlatform()}`);
    livekitRequestScreenShare();
    shareNativeRequested = true;
    // #endif
    // #ifdef APP-HARMONY
    shareNativeRequested = livekitPrepareScreenCapture(label, cancelLabel, meetingShareReleaseEndpoint(room), seatToken);
    if (!shareNativeRequested) {
      lastShareStartError = "platform";
      shareRequested = false;
      try { await apiImMeetingGuestReleaseShareHolder(room, seatToken); } catch (_error) {}
      return false;
    }
    // #endif
    return true;
  } catch (_e) {
    lastShareStartError = "threw";
    if (generation == connectGeneration) {
      shareRequested = false;
      if (seatToken.length > 0) {
        // #ifdef APP-HARMONY
        try { await apiImMeetingGuestReleaseShareHolder(room, seatToken); } catch (_error) {}
        // #endif
        // #ifndef APP-HARMONY
        void apiImMeetingGuestReleaseShareHolder(room, seatToken);
        // #endif
      }
    }
    console.error(`[Meeting] takeShareHolder threw: ${_e}`);
    return false;
  } finally {
    shareRequestInFlight = false;
  }
}

/** Stop local capture first even if releasing server ownership fails. */
export async function meetingMediaStopScreenShare(room: string): Promise<void> {
  if (shareStopping) return;
  // #ifdef APP-HARMONY
  if (activeRoom != room || room.length == 0) return;
  // #endif
  shareStopping = true;
  // #ifndef APP-HARMONY
  const seatToken = activeMeetingToken;
  // #endif
  shareGeneration += 1;
  shareRequested = false;
  shareNativeRequested = false;
  shareObservedOn = false;
  shareAttemptStartedAt = 0;
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try { livekitStopScreenShare(); } catch (_e) {}
  // #endif
  // #ifndef APP-HARMONY
  // 使用席位凭据仅释放自己，主持人也不能误释放刚接管共享的其他成员。
  if (seatToken.length > 0 && room.length > 0) {
    try { await apiImMeetingGuestReleaseShareHolder(room, seatToken); } catch (_e) {}
  }
  // #endif
  shareStopping = false;
}

/** 页面最小化后仍在应用级校准；真正后台采集/接管/停止由原生负责。 */
export function meetingMediaReconcile(expectedRoom: string = ""): void {
  restoreNativeResumeState();
  // 仅恢复本次仍持有的会话。主动离会已清空 room/token，绝不能把迟到状态当成重新入会。
  if (activeRoom.length == 0 || activeMeetingToken.length == 0) return;
  if (expectedRoom.length > 0 && activeRoom != expectedRoom) return;
  let restored = false;
  // #ifdef APP-ANDROID || APP-IOS
  try {
    if (!livekitIsConnected()) {
      if (state.connected) void meetingMediaDisconnect();
      return;
    }
    // 原生已连接而业务状态落成 exception：按真实连接恢复，不重新签票、断会或重建 Room。
    if (!state.connected) {
      stopConnectPoll();
      state.connected = true;
      state.connecting = false;
      state.errorText = "";
      configureConnectedBackgroundSession();
      restored = true;
    }
    // #ifdef APP-IOS
    try { if (refreshNativeAudioState()) restored = true; } catch (_e) {}
    // #endif
    const on = livekitIsScreenShareOn();
    const error = livekitScreenShareError();
    if (on) shareObservedOn = true;
    else if (shareObservedOn || (shareNativeRequested && error.length > 0) ||
      (shareRequested && shareAttemptStartedAt > 0 && Date.now() - shareAttemptStartedAt > 65000)) {
      void meetingMediaStopScreenShare(activeRoom);
    }
  } catch (_e) {}
  // #endif
  // #ifdef APP-HARMONY
  try {
    if (!state.connected) return;
    if (!livekitIsConnected()) {
      void meetingMediaDisconnect();
      return;
    }
    const mic = livekitMicEnabled();
    const camera = livekitCameraEnabled();
    const speaker = livekitSpeakerEnabled();
    const visual = camera || livekitAwaitingScreenCapture() ||
      livekitRemoteScreenVisible() || livekitRemoteVideoIdentities().length > 0;
    const sharing = livekitIsScreenShareOn();
    if (sharing) shareObservedOn = true;
    else if (shareObservedOn || (shareNativeRequested && livekitScreenShareError().length > 0) ||
      (shareRequested && shareAttemptStartedAt > 0 && Date.now() - shareAttemptStartedAt > 65000)) {
      void meetingMediaStopScreenShare(activeRoom);
    }
    const deviceChanged = mic != state.micOn || camera != state.cameraOn ||
      speaker != state.speakerOn || visual != state.visualMedia;
    state.micOn = mic;
    state.cameraOn = camera;
    state.speakerOn = speaker;
    state.visualMedia = visual;
    if (deviceChanged) changed();
  } catch (_error) {}
  // #endif
  if (sessionPollTimer == -1) sessionPollTimer = setInterval(() => { meetingMediaReconcile(); }, 2000);
  startMeetingResumePoll();
  pollMeetingResume();
  if (restored) changed();
}

export function meetingMediaScreenShareOn(): boolean {
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try { return livekitIsScreenShareOn(); } catch (_e) { return false; }
  // #endif
  return false;
}

export function meetingMediaScreenShareError(): string {
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try { return livekitScreenShareError(); } catch (_e) { return ""; }
  // #endif
  return "";
}

/** 切换前后摄像头（默认前置）。 */
export function meetingMediaSwitchCamera(): void {
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    // #ifdef APP-HARMONY
    if (hasNativeVoipCall()) return;
    // #endif
    livekitSwitchCamera();
  } catch (_e) {
  }
  // #endif
}

/**
 * 一行式诊断（页面每 3 秒打一次，仅排查用）。
 *
 * <p>闪退拿不到堆栈时，靠这一行定位卡在哪一步：前半段是本层状态（`mic/cam` 是我们
 * 以为的开关态），`native[...]` 是直接问原生层的实时值
 * （`people` 原生人数 / `level` 原生音量 / `remotes` 已订阅到视频的远端 / `err` 原生错误）。</p>
 *
 * <p>★不加插件新导出：`?uts-proxy` 只认插件现有导出表，新增导出会报
 * `is not exported by ...?uts-proxy`（2026-11-15 实测），所以这里只用已有接口拼；
 * 更细的原生值（授权状态 / 渲染视图 / 摄像头轨道 / 音频会话 category）在
 * iOS 侧以 `NSLog("[MeetingBridge] …")` 打在控制台。</p>
 */
export function meetingMediaDebugLine(): string {
  let nativeConnected = false;
  let nativePeople = 0;
  let nativeLevel = 0.0;
  let nativeErr = "";
  let nativeRemotes = "";
  let nativeDiag = "";
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    nativeConnected = livekitIsConnected();
    nativePeople = livekitParticipantCount();
    nativeLevel = livekitLocalAudioLevel();
    nativeErr = livekitLastError();
    nativeRemotes = livekitRemoteVideoIdentities();
  } catch (_e) {
    nativeErr = "throw";
  }
  // #endif
  // #ifdef APP-ANDROID
  try {
    nativeDiag = livekitSdkVersion();
  } catch (_e) {
    nativeDiag = "probe_throw";
  }
  // #endif
  // #ifdef APP-IOS
  // 单独查询基座标记：前面的状态调用失败时，仍尽量显示实际安装的原生版本。
  try {
    nativeDiag = livekitSdkVersion();
  } catch (_e) {
    nativeDiag = `probe_throw:${_e}`;
  }
  // #endif
  return `connected=${state.connected} connecting=${state.connecting} mic=${state.micOn} cam=${state.cameraOn} people=${state.peopleCount} err=${state.errorText} native[connected=${nativeConnected} people=${nativePeople} level=${nativeLevel} remotes=${nativeRemotes} err=${nativeErr} diag=${nativeDiag}]`;
}

/** 页面卸载/换会时调用：丢弃残留状态（不触发请求）。 */
export function meetingMediaReset(): void {
  resetState();
}

// #ifdef APP-HARMONY
export function meetingMediaCanCaptureScreen(): boolean {
  try { return livekitScreenCaptureSupported(); } catch (_error) { return false; }
}
export function meetingMediaConsumeDeviceError(): string {
  try { return livekitConsumeControlError(); } catch (_error) { return ""; }
}
// #endif
