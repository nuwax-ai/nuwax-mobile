/**
 * Nuwax Harmony Native Pay（App-Harmony）
 *
 * 与 uni_modules/nuwax-android-native-pay 的 app-android/index.uts 接口完全一致：
 * - launchAnxinfuMiniProgramNative(userName, path)：拉起安心付微信小程序
 * - openPayUrlNative(url)：打开支付宝收银台（alipays:// scheme 或 https 链接）
 *
 * 微信侧走鸿蒙版微信开放 SDK（ohpm `@tencent/wechat_open_sdk`，版本见同目录
 * config.json）。若开放平台鸿蒙应用尚未注册通过，可按 README.md 切到 scheme
 * 兜底实现（launchAnxinfuMiniProgramBySchemeNative）。
 *
 * 注意：不要调用 WXApi.isWXAppInstalled()——它内部走 bundleManager.canOpenLink
 * ("weixin://")，未在 entry 模块声明 querySchemes 时会失败并误报“未安装”。
 */
import { Want } from '@kit.AbilityKit';
import { BusinessError } from '@kit.BasicServicesKit';
import { LaunchMiniProgramReq, WXApi, WXAPIFactory } from '@tencent/wechat_open_sdk';

/** 微信开放平台“移动应用” AppID，与 Android 端及鸿蒙工程 entry 的 WX_APPID 一致。 */
const WECHAT_OPEN_APP_ID = 'wxe2a12018505241ba';

/** 小程序类型：0-正式版 1-开发版 2-体验版，与 Android 端保持一致。 */
const MINI_PROGRAM_TYPE_RELEASE = 0;

let wxApi: WXApi | null = null;

function getWxApi(): WXApi {
  if (wxApi == null) {
    wxApi = WXAPIFactory.createWXAPI(WECHAT_OPEN_APP_ID);
  }
  return wxApi!;
}

/** 用系统 want 打开外部链接；目标应用未安装时由 catch 转成 reject。 */
function startViewDataAbility(url: string, okMsg: string): Promise<any> {
  return new Promise<any>((resolve, reject) => {
    const context = UTSHarmony.getUIAbilityContext();
    const want: Want = {
      action: 'ohos.want.action.viewData',
      entities: ['entity.system.browsable'],
      uri: url,
    };
    context.startAbility(want)
      .then(() => {
        resolve({ errMsg: okMsg } as UTSJSONObject);
      })
      .catch((e: BusinessError) => {
        reject(new Error(`startAbility failed: ${e.code} ${e.message}`));
      });
  });
}

/** 使用微信鸿蒙开放 SDK 拉起安心付小程序。 */
export function launchAnxinfuMiniProgramNative(
  userName: string,
  path: string,
): Promise<any> {
  return new Promise<any>((resolve, reject) => {
    try {
      const context = UTSHarmony.getUIAbilityContext();
      const request = new LaunchMiniProgramReq();
      request.userName = userName;
      request.path = path;
      request.miniprogramType = MINI_PROGRAM_TYPE_RELEASE;
      console.log('userName', userName);
      console.log('path', path);

      const onAccepted = (accepted: boolean) => {
        if (accepted) {
          resolve({ errMsg: 'launchMiniProgram:ok' } as UTSJSONObject);
        } else {
          reject(new Error('WeChat rejected the mini-program launch request'));
        }
      };

      // sendReq 声明为 boolean | Promise<boolean>：link 通路返回 Promise，
      // want 通路在部分版本上同步返回，两种都要处理。
      const sent = getWxApi().sendReq(context, request);
      if (typeof sent === 'boolean') {
        onAccepted(sent);
      } else {
        sent.then(onAccepted).catch((e: BusinessError) => {
          reject(new Error(`WeChat sendReq failed: ${e.code} ${e.message}`));
        });
      }
    } catch (error) {
      reject(error);
    }
  });
}

/**
 * scheme 兜底：直接把网关返回的 weixin://dl/business/?... 交给系统打开。
 * 不依赖开放平台注册，代价是拉起失败时拿不到微信侧的明确错误码。
 */
export function launchAnxinfuMiniProgramBySchemeNative(
  redirectUrl: string,
): Promise<any> {
  return startViewDataAbility(redirectUrl, 'launchMiniProgram:ok');
}

/** 打开后端提供的支付宝收银台 URL（alipays:// 或 https 链接均可）。 */
export function openPayUrlNative(url: string): Promise<any> {
  return startViewDataAbility(url, 'openUrl:ok');
}
