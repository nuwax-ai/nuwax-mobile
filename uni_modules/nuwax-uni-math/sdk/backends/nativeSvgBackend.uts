// #ifdef APP-ANDROID
import { renderMathAsync } from "@/uni_modules/nuwax-uni-math"
import utils from "@/uni_modules/uni-ai-x/sdk/utils.uts"

/**
 * Phase2 数学渲染后端（Android）：原生 QuickJS + MathJax(tex-svg) → AndroidSVG 高清位图。
 *
 * 不再过隐藏 proxy web-view → 根除数学渲染的 evalJS 桥死锁；公式原生生成 SVG（可导出），
 * 再 rasterize 成 WebP dataURL 走 <image> 显示（缓存后可回收，适配 list 50~100 公式密度）。
 *
 * 线程模型：QuickJS 单 context 非线程安全 → 渲染（eval + rasterize）在插件内的
 *   Executors.newSingleThreadExecutor 上串行（不依赖 uni-app x 命名 dispatcher 的线程模型）。
 *   完成后这里切回主线程触发 callback（与 proxyWebBackend / Core.dispatchCallback 同模式）。
 *
 * 契约：回包 UTSJSONObject { imageDataURL, width, height, svg }（svg 供导出）；失败回 { error }，
 *   由 MathRendererCore.renderViaBackend 兜底回 proxyWebBackend（隐藏 web-view KaTeX）。
 *
 * 颜色 / DPI：当前固定近黑 + 2.5x（高 DPI 清晰）。暗色主题与字号随主题接入是后续 TODO。
 */
export function nativeSvgBackend(
	latex: string,
	displayMode: boolean,
	callback: (res: UTSJSONObject) => void,
): void {
	const dpiScale: number = 2.5
	// 近黑（非纯黑，视觉更柔和）；暗色模式 TODO：从主题取反色
	const color: string = "#1A1A1A"
	renderMathAsync(latex, displayMode, dpiScale, color, (res: UTSJSONObject): void => {
		const errField = res["error"]
		if (errField != null) {
			console.log("[MATHSVG] native render err=" + `${errField}`)
		} else {
			const svgLen = res["svg"]
			const w = res["width"]
			const h = res["height"]
			let svgLenStr = "0"
			if (svgLen != null) {
				svgLenStr = `${svgLen}`
			}
			console.log("[MATHSVG] native render ok svgLen=" + svgLenStr.length + " w=" + `${w}` + " h=" + `${h}`)
		}
		utils.uniGetDispatcher("main", (): void => {
			callback(res)
		})
	})
}
// #endif
