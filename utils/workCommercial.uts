import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { getApiBaseUrl } from "@/constants/config";
import { apiTenantConfig } from "@/servers/account";
import { apiResCode, apiResData } from "@/utils/apiResponse";

/**
 * 工作商业版授权闸门（伙伴/资料库，对齐 PC nuwax 的 utils/commercialEdition.ts +
 * WorkCommercialRouteBoundary）：/api/tenant/config 的 workCommercialEdition === true
 * 才放行——显式 false 算未授权（PC getCommercialEdition 同口径，不兼容 truthy）。
 * ★缺键不直接定罪：缓存可能来自旧版本后端 / 登录页游客态（skipAuth）拉取，视为
 * 「未定」交给异步闸门带登录态重拉核实，重拉仍缺键才按 PC 口径（缺键=未授权）拦。
 *
 * 租户配置整包缓存在 TENANT_CONFIG_INFO（登录页 onMounted / 各 Tab 页 onShow 的
 * setCurrentPageNavigationBarTitle 在缓存缺失时都会拉取写回），闸门只读该缓存，
 * 不另立存储。未授权时：伙伴页整页提示不发 IM 请求、WS 不连、未读角标清零。
 */

/**
 * 读缓存判定：true=已授权 false=未授权（显式 false）null=未定（无缓存/损坏/缺键）。
 * 缺键归入未定而非未授权：旧版本后端 / 游客态拉取写下的缓存没有该键，直接定罪会把
 * 已授权租户晾在授权提示后面且永不自愈（缓存命中不再重拉）；交给异步闸门重拉核实。
 */
export function readCachedWorkCommercialEdition(): boolean | null {
  const cached = uni.getStorageSync(TENANT_CONFIG_INFO);
  if (cached == null || cached == "") {
    return null;
  }
  try {
    const obj = JSON.parse<UTSJSONObject>(cached as string);
    if (obj == null) {
      return null;
    }
    const raw = obj["workCommercialEdition"];
    if (raw == null) {
      return null;
    }
    return `${raw}` == "true";
  } catch (_e) {
    return null;
  }
}

/** 同步闸门（WS connect / 未读角标等高频路径用）：缓存显式未授权才拦；缺键=未定放行。 */
export function isWorkCommercialBlockedSync(): boolean {
  const cached = readCachedWorkCommercialEdition();
  return cached != null && cached == false;
}

/**
 * 异步闸门（页面 onLoad 用）：缓存优先；无缓存拉一次 /api/tenant/config 并写回。
 * 拉取失败放行（fail-open）：网络抖动不该把已授权租户拦在授权提示后面——
 * 真断网时列表接口自会失败出错误态 + 重试，语义更诚实。
 */
export async function resolveWorkCommercialBlocked(): Promise<boolean> {
  const cached = readCachedWorkCommercialEdition();
  if (cached != null) {
    return cached == false;
  }
  try {
    const res = await apiTenantConfig();
    const code = apiResCode(res);
    const dataRaw = apiResData<any>(res);
    if (code == SUCCESS_CODE && dataRaw != null) {
      uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(dataRaw));
      const obj = dataRaw as UTSJSONObject;
      const raw = obj["workCommercialEdition"];
      const blocked = !(raw != null && `${raw}` == "true");
      if (blocked) {
        // 环境诊断：区分「后端缺键（旧版本/私有部署）」与「显式 false（真未授权）」。
        // 模拟器/测试站误拦时据此定位连的是哪个域、配置返回了什么。
        const rawText = raw == null ? "<missing>" : `${raw}`;
        const domain = getApiBaseUrl();
        console.log(`[WorkGate] blocked: domain=${domain} workCommercialEdition=${rawText}`);
      }
      return blocked;
    }
  } catch (_e) {
    // 网络失败：放行（见函数注释）
  }
  return false;
}
