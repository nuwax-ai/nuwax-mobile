# 拷贝为 local-secrets.env（已 gitignore），填本机值。scripts/local-base-env.sh 会自动 source。
#   cp scripts/local-secrets.env.example scripts/local-secrets.env
#
# DCLOUD_APPKEY：DCloud 离线打包 AppKey（团队共享，通过受控渠道获取，勿提交）
# IOS_DEVELOPMENT_TEAM：你的 Apple Developer Team ID
# IOS_PROVISIONING_PROFILE_UUID：你的描述文件 UUID（用自动签名可留空）
export DCLOUD_APPKEY=
export IOS_DEVELOPMENT_TEAM=
export IOS_PROVISIONING_PROFILE_UUID=
