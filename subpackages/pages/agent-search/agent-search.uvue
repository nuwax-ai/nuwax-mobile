    display: flex;
    align-items: center;
  }

  /* #ifndef APP */
  .loading-text::before {
    content: "";
    width: 32rpx;
    height: 32rpx;
    border: 4rpx solid #e8e8e8;
    border-top: 4rpx solid #8b5cf6;
    border-radius: 16rpx;
    animation: spin 1s linear infinite;
    margin-right: 16rpx;
  }
  /* #endif */

  /* #ifndef APP */
  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  /* #endif */

  /* 没有更多数据状态 */
  .no-more-state {
