/**
 * Nuwax Stream PCM Player（App-Android）
 *
 * 基于 Android AudioTrack（MODE_STREAM）的流式 PCM16 播放器：
 * TTS 推来的 PCM 帧主线程仅入队，**AudioTrack.write 全部在后台线程执行**，
 * 彻底解放主线程（WS 帧回调只做一次队列 put）。
 *
 * 用法：
 *   const player = new StreamPcmPlayer();
 *   player.init(16000);            // 16kHz mono PCM16
 *   player.push(frame);            // 每帧 Uint8Array（PCM16 LE），主线程快速入队
 *   player.ensurePlaying();        // 攒够起始缓冲后 play()
 *   player.isDrained();            // 已写入的 PCM 是否全部播完
 *   player.release();              // 结束释放（唤醒并 join 后台线程）
 */
import AudioTrack from 'android.media.AudioTrack'
import ByteBuffer from 'java.nio.ByteBuffer'
import Thread from 'java.lang.Thread'
import LinkedBlockingQueue from 'java.util.concurrent.LinkedBlockingQueue'
import AtomicLong from 'java.util.concurrent.atomic.AtomicLong'

/** 开始播放前的最小缓冲（音频 ms）：略攒一点再播，减少开局 underrun */
const START_PLAY_MS = 150

// Android AudioTrack 常量（Java 静态字段在 UTS 互操作中不可直接引用，用稳定字面量）
const AUDIO_STREAM_MUSIC = 3
const AUDIO_CHANNEL_OUT_MONO = 4
const AUDIO_ENCODING_PCM_16BIT = 2
const AUDIO_MODE_STREAM = 1
/** 后台线程用阻塞写：线程自己等 AudioTrack 缓冲腾出空间，主线程不受影响 */
const AUDIO_WRITE_BLOCKING = 1

export class StreamPcmPlayer {
  private track: AudioTrack | null = null
  private sampleRate: number = 16000
  /** 后台写入线程（从队列取帧 → 写 AudioTrack） */
  private writerThread: Thread | null = null
  /** 待写 PCM 帧队列（无界，主线程 put 不阻塞） */
  private queue: LinkedBlockingQueue<any> | null = null
  private running: boolean = false
  /** 后台线程已成功写入的字节数（线程安全计数） */
  private writtenBytes: AtomicLong | null = null
  private started: boolean = false

  /**
   * 创建 AudioTrack（MODE_STREAM，16bit mono），缓冲取 getMinBufferSize 与「1s 容量」较大者；
   * 启动后台写入线程。
   */
  init(sampleRate: number): void {
    this.release()
    this.sampleRate = sampleRate > 0 ? sampleRate : 16000
    let minBuf = 0
    try {
      minBuf = AudioTrack.getMinBufferSize(
        this.sampleRate.toInt(),
        AUDIO_CHANNEL_OUT_MONO.toInt(),
        AUDIO_ENCODING_PCM_16BIT.toInt(),
      )
    } catch (_eMin) {
      minBuf = 0
    }
    let bufSize = this.sampleRate * 2
    if (bufSize < minBuf) {
      bufSize = minBuf
    }
    try {
      this.track = new AudioTrack(
        AUDIO_STREAM_MUSIC.toInt(),
        this.sampleRate.toInt(),
        AUDIO_CHANNEL_OUT_MONO.toInt(),
        AUDIO_ENCODING_PCM_16BIT.toInt(),
        bufSize.toInt(),
        AUDIO_MODE_STREAM.toInt(),
      )
    } catch (eInit: any) {
      console.error('[StreamPcmPlayer] init failed', eInit)
      this.track = null
    }
    this.writtenBytes = new AtomicLong(0)
    this.started = false
    this.queue = new LinkedBlockingQueue()
    this.running = true
    const q = this.queue
    const track = this.track
    this.writerThread = new Thread((): void => {
      while (this.running) {
        if (q == null || track == null) {
          break
        }
        let item: any
        try {
          item = q.take()
        } catch (_eTake) {
          break
        }
        if (item == null) {
          break
        }
        const u8 = item as Uint8Array
        // 空帧 = release 哨兵
        if (u8 == null || u8.length == 0) {
          break
        }
        try {
          const src = u8.buffer != null ? u8.buffer!.toByteBuffer() : null
          if (src != null) {
            const len = u8.byteLength.toInt()
            const bb = ByteBuffer.allocate(len)
            bb.put(src)
            bb.rewind()
            const written = track.write(
              bb,
              len,
              AUDIO_WRITE_BLOCKING.toInt(),
            )
            if (written > 0) {
              this.writtenBytes!.addAndGet(written.toLong())
            }
          }
        } catch (eWrite: any) {
          console.warn('[StreamPcmPlayer] write failed', eWrite)
        }
      }
    })
    this.writerThread!.start()
  }

  /** 推入一帧 PCM16 LE 字节（主线程仅入队，不阻塞） */
  push(chunk: Uint8Array): void {
    const q = this.queue
    if (
      this.running != true ||
      q == null ||
      chunk == null ||
      chunk.length == 0
    ) {
      return
    }
    try {
      q.put(chunk)
    } catch (_ePut) {
      // ignore
    }
    this.ensurePlaying()
  }

  /** 后台线程持续消费队列，无需额外冲刷 */
  flushPending(): void {
    // no-op
  }

  /** 攒够起始缓冲后开始播放（幂等） */
  ensurePlaying(): void {
    if (this.started == true) {
      return
    }
    if (this.getWrittenMs() < START_PLAY_MS) {
      return
    }
    this.playNow()
  }

  /** 立即开始播放（幂等；输入结束时强制用，避免短音频不出声） */
  playNow(): void {
    const track = this.track
    if (track == null || this.started == true) {
      return
    }
    this.started = true
    try {
      track.play()
    } catch (ePlay: any) {
      console.warn('[StreamPcmPlayer] play failed', ePlay)
      this.started = false
    }
  }

  /** 静音开关：音量 0 / 1 */
  setMuted(muted: boolean): void {
    const track = this.track
    if (track == null) {
      return
    }
    try {
      const vol = muted == true ? 0 : 1
      track.setVolume(vol.toFloat())
    } catch (_eVol) {
      // ignore
    }
  }

  /** 后台线程已写入的 PCM 时长（ms） */
  getWrittenMs(): number {
    const wb = this.writtenBytes
    if (wb == null) {
      return 0
    }
    return Math.floor((wb.get().toDouble() * 1000) / (this.sampleRate * 2))
  }

  /** 已播放的 PCM 时长（ms）——基于播放头位置（线程安全） */
  getPlayedMs(): number {
    const track = this.track
    if (track == null) {
      return 0
    }
    try {
      return Math.floor(
        (track.getPlaybackHeadPosition() * 1000) / this.sampleRate,
      )
    } catch (_ePos) {
      return 0
    }
  }

  /** 写入的音频是否已全部播完（排空判定用；留 50ms 容差） */
  isDrained(): boolean {
    return this.getPlayedMs() + 50 >= this.getWrittenMs()
  }

  /** 是否仍有未排空的音频 */
  hasPendingAudio(): boolean {
    return this.getWrittenMs() > this.getPlayedMs() + 50
  }

  /** 停止后台线程并释放 AudioTrack（幂等） */
  release(): void {
    this.running = false
    const q = this.queue
    if (q != null) {
      // 唤醒阻塞中的 take()：塞空帧哨兵
      try {
        q.put(new Uint8Array(0))
      } catch (_ePut) {
        // ignore
      }
    }
    const t = this.writerThread
    this.writerThread = null
    if (t != null) {
      try {
        t.join(500)
      } catch (_eJoin) {
        // ignore
      }
    }
    this.queue = null
    const track = this.track
    this.track = null
    this.writtenBytes = null
    this.started = false
    if (track != null) {
      try {
        track.stop()
      } catch (_eStop) {
        // ignore
      }
      try {
        track.release()
      } catch (_eRel) {
        // ignore
      }
    }
  }
}
