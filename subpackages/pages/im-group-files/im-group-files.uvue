<template>
  <view class="gf-page">
    <safety-zone />

    <!-- 顶部：返回 + 标题（入参决定：单聊文件按钮传「文件」，群信息页缺省「群文件」） -->
    <view class="gf-header">
      <view class="gf-header__btn" hover-class="gf-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="20" unit="px" color="#141416" />
      </view>
      <view class="gf-header__title-wrap">
        <text class="gf-header__title">{{ titleText }}</text>
      </view>
      <view class="gf-header__btn gf-header__btn--ghost" />
    </view>

    <!-- 分类 tab：全部/图片/文件/视频/音频（对齐 PC 端 ChatFilesPanel） -->
    <view class="gf-tabs">
      <view
        v-for="k in kindTabs"
        :key="k.id"
        class="gf-tab"
        :class="activeKind == k.id ? 'gf-tab--on' : ''"
        hover-class="gf-tab--hover"
        @click="switchKind(k.id)"
      >
        <text
          class="gf-tab__text"
          :class="activeKind == k.id ? 'gf-tab__text--on' : ''"
        >{{ k.label }}</text>
      </view>
    </view>

    <!-- 横滑切页（directional-pager，已读状态页/全局搜索同款）：禁 swiper 原生跟手
         拖动、由 tracker 判向整页跳一档，避免与列表纵向滚动抢手势（斜滑不劫持）。
         懒挂载：首次点击或横拖预览（@preview）时才挂对应 pane，各 tab 滚动位置
         独立保留。pane 抽组件（im-file-pane）：activeKind 提交只重渲页头 tab 栏，
         行列表是组件缓存粒度、props 不变整体跳过，不再全量重执行——伙伴页横滑
         卡顿（切页动画窗内数百行内联 v-for 重跑冻住动画）的教训。 -->
    <directional-pager
      class="gf-body"
      :current="activeKindIndex"
      :count="kindTabs.length"
      @change="handlePagerChange"
      @preview="handlePagerPreview"
    >
      <swiper-item>
        <im-file-pane
          v-if="kindMounted('all')"
          :files="paneFiles[0]"
          :loading="filesLoading"
          :error="filesError"
          :has-more="filesHasMore"
          :auto-stopped="filesAutoStopped"
          @rowtap="handleFileTap"
          @preview="handlePreview"
          @download="handleDownload"
          @loadolder="loadOlderFromUi"
          @resolved="onThumbResolved"
        />
      </swiper-item>
      <swiper-item>
        <im-file-pane
          v-if="kindMounted('image')"
          :files="paneFiles[1]"
          :loading="filesLoading"
          :error="filesError"
          :has-more="filesHasMore"
          :auto-stopped="filesAutoStopped"
          @rowtap="handleFileTap"
          @preview="handlePreview"
          @download="handleDownload"
          @loadolder="loadOlderFromUi"
          @resolved="onThumbResolved"
        />
      </swiper-item>
      <swiper-item>
        <im-file-pane
          v-if="kindMounted('file')"
          :files="paneFiles[2]"
          :loading="filesLoading"
          :error="filesError"
          :has-more="filesHasMore"
          :auto-stopped="filesAutoStopped"
          @rowtap="handleFileTap"
          @preview="handlePreview"
          @download="handleDownload"
          @loadolder="loadOlderFromUi"
          @resolved="onThumbResolved"
        />
      </swiper-item>
      <swiper-item>
        <im-file-pane
          v-if="kindMounted('video')"
          :files="paneFiles[3]"
          :loading="filesLoading"
          :error="filesError"
          :has-more="filesHasMore"
          :auto-stopped="filesAutoStopped"
          @rowtap="handleFileTap"
          @preview="handlePreview"
          @download="handleDownload"
          @loadolder="loadOlderFromUi"
          @resolved="onThumbResolved"
        />
      </swiper-item>
      <swiper-item>
        <im-file-pane
          v-if="kindMounted('audio')"
          :files="paneFiles[4]"
          :loading="filesLoading"
          :error="filesError"
          :has-more="filesHasMore"
          :auto-stopped="filesAutoStopped"
          @rowtap="handleFileTap"
          @preview="handlePreview"
          @download="handleDownload"
          @loadolder="loadOlderFromUi"
          @resolved="onThumbResolved"
        />
      </swiper-item>
    </directional-pager>
  </view>
</template>

<script setup lang="uts">
  import { switchMainTab } from "@/utils/mainTabNavigation";

  import { ref, computed } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import {
    classifyKind,
    extOf,
    isUsableUrl,
    isValidKind,
    readNumber,
    readString,
    urlExtOf,
  } from "@/utils/imChatAttachments";
  import { apiImConvFiles } from "@/servers/im";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import DirectionalPager from "@/components/directional-pager/directional-pager.uvue";
  import { GfFile, gfCanPreviewUrl } from "@/components/im-file-pane/gf-models";
  import {
    fetchAuthProtectedFileAkUrl,
    isAuthProtectedFileUrl,
    openAuthProtectedLinkUrl,
    openRemoteFileUrl,
    resolveAuthProtectedFileFetchUrl,
  } from "@/utils/authProtectedFileUrl";
  import { getApiBaseUrl } from "@/constants/config";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /**
   * 文件行模型 GfFile 与预览口径 gfCanPreviewUrl 已抽至
   * components/im-file-pane/gf-models.uts（页面与列表面组件共用同一类型）。
   */

  /** 分类 tab（全部 + 图片/文件/视频/音频，顺序对齐 PC ATTACHMENT_KINDS）。 */
  class GfKindTab {
    id: string = "all";
    label: string = "";
  }

  // ===== 页面入参 =====
  const convId = ref<string>("");
  /** 标题：入参 title 优先（单聊「文件」tab 传入），缺省回落「群文件」（群信息页入口）。 */
  const titleText = ref<string>("");

  // ===== 状态 =====
  const files = ref<GfFile[]>([]);
  const activeKind = ref<string>("all");
  /**
   * 缩略图组件上抛的解析结果（原始 url → 可展示地址）：只被事件处理器读取
   * （点行放大预览），不做模板绑定，无需响应式。
   */
  const resolvedThumbs = new Map<string, string>();

  function onThumbResolved(url: string, src: string): void {
    resolvedThumbs.set(url, src);
  }

  function makeKindTab(id: string, labelKey: string): GfKindTab {
    const k = new GfKindTab();
    k.id = id;
    k.label = t(labelKey);
    return k;
  }

  const kindTabs = ref<GfKindTab[]>([
    makeKindTab("all", "Mobile.Common.all"),
    makeKindTab("image", "Mobile.Message.filesTabImage"),
    makeKindTab("file", "Mobile.Message.filesTabFile"),
    makeKindTab("video", "Mobile.Message.filesTabVideo"),
    makeKindTab("audio", "Mobile.Message.filesTabAudio"),
  ]);

  /** 五个 tab 的文件分组（下标与 kindTabs 顺序一一对应；all = 不筛）。
   *  绑定直接读 computed 数组下标（paneFiles[i]），非方法调用——Android 方法调用
   *  绑定不收集依赖的坑位。 */
  const paneFiles = computed<GfFile[][]>((): GfFile[][] => {
    const all = files.value;
    const tabs = kindTabs.value;
    const out: GfFile[][] = [];
    for (let i = 0; i < tabs.length; i++) {
      const kind = tabs[i].id;
      if (kind == "all") {
        out.push(all);
        continue;
      }
      const bucket: GfFile[] = [];
      for (let j = 0; j < all.length; j++) {
        if (all[j].kind == kind) {
          bucket.push(all[j]);
        }
      }
      out.push(bucket);
    }
    return out;
  });

  /** 当前 tab 在 pager 里的页码（kindTabs 下标）。 */
  const activeKindIndex = computed((): number => {
    const tabs = kindTabs.value;
    for (let i = 0; i < tabs.length; i++) {
      if (tabs[i].id == activeKind.value) {
        return i;
      }
    }
    return 0;
  });

  // ===== pane 懒挂载（conversation-search 同款）：首访/横拖预览时才挂对应 tab 的
  // 列表面，挂后常驻（切回直接显示、滚动位置独立保留）。整体替换数组写入。 =====
  const visitedKinds = ref<string[]>(["all"] as string[]);

  function kindMounted(kind: string): boolean {
    return visitedKinds.value.indexOf(kind) >= 0;
  }

  function markKindVisited(kind: string): void {
    if (visitedKinds.value.indexOf(kind) >= 0) {
      return;
    }
    const next = [] as string[];
    for (let i = 0; i < visitedKinds.value.length; i++) {
      next.push(visitedKinds.value[i]);
    }
    next.push(kind);
    visitedKinds.value = next;
  }

  /** 横拖预览（directional-pager @preview）：提前挂目标页内容，滑过去不空屏。 */
  function handlePagerPreview(index: number): void {
    if (index >= 0 && index < kindTabs.value.length) {
      markKindVisited(kindTabs.value[index].id);
    }
  }

  /** 横滑落定（directional-pager @change）：页码映射回 tab，走统一提交。 */
  function handlePagerChange(index: number): void {
    if (index < 0 || index >= kindTabs.value.length) {
      return;
    }
    const kind = kindTabs.value[index].id;
    markKindVisited(kind);
    activeKind.value = kind;
  }

  /** tab 点击：立即落定 activeKind（pager :current 随之滑向目标页）。 */
  function switchKind(id: string): void {
    markKindVisited(id);
    activeKind.value = id;
  }

  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  // ===== 展示辅助（分类/后缀判断已挪 utils/imChatAttachments，与聊天页共用） =====

  /** 文件大小展示：B / KB / MB / GB（一位小数，<1KB 直接给字节数）。 */
  function formatSize(size: number): string {
    if (size <= 0) {
      return "";
    }
    if (size < 1024) {
      return `${size} B`;
    }
    const kb = size / 1024;
    if (kb < 1024) {
      return `${kb.toFixed(1)} KB`;
    }
    const mb = kb / 1024;
    if (mb < 1024) {
      return `${mb.toFixed(1)} MB`;
    }
    const gb = mb / 1024;
    return `${gb.toFixed(1)} GB`;
  }

  /** 时间展示：MM-DD HH:mm（跨年补年份）。 */
  function formatTime(ms: number): string {
    if (ms <= 0) {
      return "";
    }
    const d = new Date(ms);
    const now = new Date();
    const pad = (n: number): string => (n < 10 ? `0${n}` : `${n}`);
    const md = `${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
    if (d.getFullYear() != now.getFullYear()) {
      return `${d.getFullYear()}-${md}`;
    }
    return md;
  }

  /** 次行左段：发送人 · 大小（缺失项自动跳过；过长由 UI 省略，不挤右侧时间）。 */
  function buildSub(senderName: string, size: number): string {
    const parts: string[] = [];
    if (senderName.length > 0) {
      parts.push(senderName);
    }
    const sizeText = formatSize(size);
    if (sizeText.length > 0) {
      parts.push(sizeText);
    }
    return parts.join(" · ");
  }

  // ===== 数据源：服务端全量分页（对齐 PC ChatFilesPanel / DEV-300） =====
  // 此前聚合聊天页「已加载消息」的窗口附件缓存（要找更早的文件得先回消息往上翻），
  // 现改走 GET /conversations/{convId}/files：服务端按会话检索附件行（新→旧），
  // 首屏拉一页、滚到底自动翻更早，覆盖会话全部消息。

  /** 每页拉多少条原始消息（服务端 clamp 到 [20,100]；附件行可能多于消息数）。 */
  const PAGE_SIZE = 20;
  /**
   * 空页自动续拉保险丝：「空页 + hasMore=true」合法（整页消息全被撤回/清空过滤），
   * 须续拉但要有上限，否则游标不推进的服务端 bug 会把端上变成请求泵；
   * 50 页 = 至少 1000 条消息无一附件才触顶，触顶后如实给「继续查找」入口。
   */
  const MAX_AUTO_PAGES = 50;

  const filesLoading = ref<boolean>(false);
  const filesError = ref<boolean>(false);
  /** 初始 true：首屏失败后的「点击重试」靠它放行（同 PC 无缓存先给 true 的理由）。 */
  const filesHasMore = ref<boolean>(true);
  const filesAutoStopped = ref<boolean>(false);

  /** 翻页游标 = 上一页 nextCursor（本页最小 seq 的字符串形态）；空串 = 首页。只被请求链读写，不绑模板。 */
  let filesCursor = "";
  /** 请求在途闸门（scrolltolower/重试点按会连发）。非 reactive，模板不绑。 */
  let filesInflight = false;

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  /**
   * 服务端附件行（ConvFileDto）→ 面板行 GfFile。口径与 PC convFileItemsOf 对齐：
   * url 过 isUsableUrl 闸门（服务端透传 ≠ 可信，不合法不入列）；kind 认不出按
   * mime/扩展名重分类（比 PC 归 file 更准，与聊天页收集路径同款）；key = msgId#index。
   */
  function toGfFile(rec: UTSJSONObject): GfFile | null {
    const url = readString(rec, "url");
    if (!isUsableUrl(url)) {
      return null;
    }
    const kindRaw = readString(rec, "kind");
    const f = new GfFile();
    f.key = `${readString(rec, "msgId")}#${readNumber(rec, "index", 0)}`;
    // kind=file 再按扩展名重判（视频发送契约修正前的老消息 kind=file 的 .mp4/.mp3
    // 归位 video/audio，行图标与 tab 分组一致）；image/video/audio 尊重服务端 kind
    f.kind = isValidKind(kindRaw) && kindRaw != "file" ? kindRaw : classifyKind("", url);
    f.url = url;
    f.fileName = readString(rec, "fileName");
    f.size = readNumber(rec, "size", 0);
    f.senderName = readString(rec, "senderName");
    f.sendTime = readNumber(rec, "sendTime", 0);
    f.subText = buildSub(f.senderName, f.size);
    f.timeText = formatTime(f.sendTime);
    return f;
  }

  /**
   * 从当前游标往更早翻，直到拿到非空一页 / 翻完 / 触 MAX_AUTO_PAGES 保险丝。
   * 兼任三条路径：首屏（onLoad，游标空串）、滚到底续翻、失败重试（含首屏失败——
   * hasMore 初始 true 放行）。列表新→旧为服务端 seq DESC 原序，只追加不排序。
   */
  async function loadOlder(): Promise<void> {
    if (convId.value.length == 0 || filesInflight || !filesHasMore.value) {
      return;
    }
    filesInflight = true;
    filesLoading.value = true;
    filesError.value = false;
    filesAutoStopped.value = false;
    let pages = 0;
    try {
      while (pages < MAX_AUTO_PAGES) {
        pages += 1;
        const res = await apiImConvFiles(convId.value, filesCursor, PAGE_SIZE);
        if (apiResCode(res) != SUCCESS_CODE) {
          throw new Error("convFiles api error");
        }
        const dataRaw = apiResData<any>(res);
        if (dataRaw == null) {
          throw new Error("convFiles empty data");
        }
        const dataObj = dataRaw as UTSJSONObject;
        filesHasMore.value = readBool(dataObj, "hasMore");
        filesCursor = readString(dataObj, "nextCursor");
        const recordsRaw = dataObj["records"];
        const records = recordsRaw != null ? (recordsRaw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        // 追加去重（key=msgId#index，防服务端边界重叠），整表替换数组写入
        const seen = new Set<string>();
        const next = [] as GfFile[];
        for (let i = 0; i < files.value.length; i++) {
          seen.add(files.value[i].key);
          next.push(files.value[i]);
        }
        let appended = 0;
        for (let i = 0; i < records.length; i++) {
          const f = toGfFile(records[i]);
          if (f == null || seen.has(f.key)) {
            continue;
          }
          seen.add(f.key);
          next.push(f);
          appended += 1;
        }
        files.value = next;
        // 空页 + hasMore：合法形态，自动续拉；拿到非空页或翻完即停
        if (appended > 0 || !filesHasMore.value) {
          break;
        }
      }
      if (pages >= MAX_AUTO_PAGES && filesHasMore.value) {
        filesAutoStopped.value = true;
      }
    } catch (_e) {
      filesError.value = true;
    } finally {
      filesInflight = false;
      filesLoading.value = false;
    }
  }

  /** 模板事件入口（pane scrolltolower / 失败重试 / 继续查找点按）：转异步不等待。 */
  function loadOlderFromUi(): void {
    loadOlder();
  }

  // ===== 预览（站内 webview 打开平台预览网关页，对齐 Web 端「开新窗预览」语义） =====
  // 按钮显隐口径（PREVIEWABLE_EXTS / gfCanPreviewUrl）在 gf-models.uts，
  // 由 im-file-pane 行内直接调用。

  /** 站内 webview 打开预览网关页：fileUrl 为网关渲染目标（ak 直链或普通地址）。 */
  function openPreviewInWebview(targetUrl: string, title: string): void {
    const gateway = `${getApiBaseUrl()}/static/file-preview.html?fileUrl=${encodeURIComponent(targetUrl)}`;
    let url =
      `/subpackages/pages/webview/webview?url=${encodeURIComponent(gateway)}` +
      `&noTicket=1&hideShare=1`;
    if (title.length > 0) {
      url += `&title=${encodeURIComponent(title)}`;
    }
    uni.navigateTo({ url });
  }

  /**
   * 预览按钮：受保护 /api/f/ 地址 webview 带不了 Bearer，先换 ak 匿名直链
   * （同图片/视频流播链路）；普通地址直接进网关。ak 失败 toast，不回落下载
   * （用户点的是「预览」，静默变成下载会更困惑）。
   */
  function handlePreview(f: GfFile): void {
    if (f.url.length == 0) {
      return;
    }
    const title = f.fileName.length > 0 ? f.fileName : t("Mobile.Message.filesPreview");
    if (!isAuthProtectedFileUrl(f.url)) {
      openPreviewInWebview(resolveAuthProtectedFileFetchUrl(f.url), title);
      return;
    }
    uni.showLoading({ title: "" });
    fetchAuthProtectedFileAkUrl(f.url)
      .then((akUrl: string) => {
        uni.hideLoading();
        openPreviewInWebview(akUrl, title);
      })
      .catch((_e: any | null) => {
        uni.hideLoading();
        uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
      });
  }

  // ===== 下载（★真下载语义，不再是「打开资源」） =====

  /**
   * 下载文件名（对齐 PC media.ts downloadNameOf 的关键规则）：
   * 名字里的 / \ 压平（带分隔符时浏览器会静默忽略 download 属性）；
   * 没后缀时从 URL 借一个，都取不到给通用兜底。
   */
  function downloadNameOf(f: GfFile): string {
    let raw = f.fileName.trim();
    while (
      raw.length > 0 &&
      (raw.charAt(0) == "/" || raw.charAt(0) == "\\" || raw.charAt(0) == ".")
    ) {
      raw = raw.substring(1);
    }
    raw = raw.split("/").join("_").split("\\").join("_");
    if (raw.length > 0 && extOf(raw).length > 0) {
      return raw;
    }
    const ext = urlExtOf(f.url);
    if (raw.length == 0) {
      return ext.length > 0 ? `file.${ext}` : "file";
    }
    return ext.length > 0 ? `${raw}.${ext}` : raw;
  }

  // #ifdef H5 || WEB
  /**
   * H5 普通地址下载：拉字节转 blob（octet-stream 强制走下载而非导航），
   * CORS 不放行或请求失败时退回新页打开（与旧行为一致，不让用户点了没反应）。
   */
  function downloadNormalUrlOnH5(url: string, name: string): void {
    uni.request({
      url,
      method: "GET",
      responseType: "arraybuffer",
      // 默认 dataType=json 会尝试 JSON.parse，二进制会失败
      dataType: "text",
      success: (res) => {
        if (res.statusCode == 200 && res.data != null) {
          const blob = new Blob([res.data as ArrayBuffer], { type: "application/octet-stream" });
          const objectUrl = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = objectUrl;
          link.download = name;
          link.click();
          setTimeout(() => {
            URL.revokeObjectURL(objectUrl);
          }, 60000);
          return;
        }
        window.open(url, "_blank");
      },
      fail: (_err) => {
        window.open(url, "_blank");
      },
    });
  }
  // #endif

  /** 下载按钮：受保护地址走 openRemoteFileUrl（H5 带 Bearer 拉 blob+保存；App 下载后交系统查看器）。 */
  function handleDownload(f: GfFile): void {
    if (f.url.length == 0) {
      return;
    }
    const name = downloadNameOf(f);
    if (isAuthProtectedFileUrl(f.url)) {
      openRemoteFileUrl(f.url, name).catch((_e: any | null) => {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
      return;
    }
    // #ifdef H5 || WEB
    downloadNormalUrlOnH5(f.url, name);
    // #endif
    // #ifndef H5 || WEB
    openRemoteFileUrl(f.url, name).catch((_e: any | null) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
    // #endif
  }

  /**
   * 行点击（整卡可点，与右缘两个按钮并行的快捷入口）：
   * - 图片 → 放大预览（优先用缩略图组件已解析的展示地址）；
   * - 预览网关支持的类型 → 走「预览」按钮同一链路；
   * - 其余（zip/doc 等网关不认的）→ 走「下载」按钮同一链路。
   * ★不再走「受保护直开页面 / 外链打开」旧路径——那条链路在真机上常无可见反馈，
   *   用户感知就是「条目点不动」；统一到按钮同款动作后每次点击都有明确响应。
   * ★定义在 handleDownload 之后：UTS→Kotlin 先用后定义会报「找不到名称」（error18）。
   */
  function handleFileTap(f: GfFile): void {
    if (f.url.length == 0) {
      return;
    }
    if (f.kind == "image") {
      const resolved = resolvedThumbs.get(f.url);
      if (resolved != null && resolved.length > 0) {
        uni.previewImage({ urls: [resolved], current: resolved });
        return;
      }
      // 缩略图还没解析出来（解析中/失败）：退回带凭证「打开页面」看原图
      if (isAuthProtectedFileUrl(f.url)) {
        openAuthProtectedLinkUrl(f.url).catch((_e: any | null) => {
          uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
        });
        return;
      }
      uni.previewImage({ urls: [f.url], current: f.url });
      return;
    }
    if (gfCanPreviewUrl(f.url)) {
      handlePreview(f);
      return;
    }
    handleDownload(f);
  }

  function handleBack(): void {
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      switchMainTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    const title = readOption(options, "title");
    titleText.value = title.length > 0 ? title : t("Mobile.Message.groupFiles");
    loadOlderFromUi();
  });
</script>

