<template>
  <view class="login-lang-wrapper" v-if="langList.length > 1">
    <view class="login-lang-switcher" @tap="handleOpen">
      <svg-icon name="icon-Globe" />
      <text class="lang-text">{{ currentLanguageName }}</text>
      <svg-icon name="icon-a-Chevrondown" />
    </view>
  </view>

  <radio-list-drawer
    :visible="visible"
    :title="t('Mobile.Profile.selectLanguage')"
    :list="languageOptions"
    :current-value="localCurrentLang"
    @onClose="handleClose"
    @onChange="handleLanguageChange"
  />
</template>

<script setup lang="uts">
  import { useI18n, normalizeLang, emptyI18nParams } from "@/utils/i18n";
  import { RadioListItem } from "@/types/interfaces/radio";
  import RadioListDrawer from "@/components/radio-list-drawer/radio-list-drawer.uvue";
  import { ref, computed } from "vue";

  const { t: tFn, currentLang, langList, setLanguage } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const visible = ref(false);
  const localCurrentLang = ref("");

  const languageOptions = computed((): RadioListItem[] => {
    const list = langList.value;
    const result: RadioListItem[] = [];
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      result.push(new RadioListItem(item.name, normalizeLang(item.lang), "", "", item.status == 0));
    }
    return result;
  });

  const currentLanguageName = computed((): string => {
    const list = langList.value;
    // 优先显示用户当前选择的语言。
    const normCurrent = normalizeLang(currentLang.value);
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      if (normalizeLang(item.lang) == normCurrent) {
        return item.name.length > 0 ? item.name : item.lang;
      }
    }
    // 当前语言未命中列表时，再使用服务端默认项兜底。
    for (let i = 0; i < list.length; i++) {
      if (list[i].isDefault == 1) {
        return list[i].name;
      }
    }
    return "Language";
  });

  const handleOpen = () => {
    localCurrentLang.value = normalizeLang(currentLang.value);
    visible.value = true;
  };

  const handleClose = () => {
    visible.value = false;
  };

  const handleLanguageChange = async (targetLang: string) => {
    if (targetLang.length == 0 || targetLang == currentLang.value) return;

    uni.showLoading({
      title: t("Mobile.Common.switching"),
    });
    try {
      const ok = await setLanguage(targetLang);
      if (!ok) {
        uni.showToast({
          title: t("Mobile.Common.switchFailed"),
          icon: "none",
        });
        return;
      }

      uni.showToast({
        title: t("Mobile.Common.switchSuccess"),
        icon: "success",
      });

      // 切换语言后刷新页面，确保全局语言包生效
      setTimeout(() => {
        // #ifdef H5
        window.location.reload();
        // #endif
        // #ifdef MP-WEIXIN || APP
        uni.reLaunch({
          url: "/subpackages/pages/login/login",
        });
        // #endif
      }, 500);
    } finally {
      uni.hideLoading();
      visible.value = false;
    }
  };
</script>

<style lang="scss" scoped>
  .login-lang-wrapper {
    position: absolute;
    top: 0;
    right: 32rpx;
    height: 152rpx;
    z-index: 999;
    display: flex;
    flex-direction: row;
    align-items: center;

    .login-lang-switcher {
      /* #ifdef H5 */
      width: fit-content;
      /* #endif */
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 12rpx 24rpx;
      background-color: transparent;
      border-radius: 100rpx;
      border: 0;
      /* #ifndef APP */
      cursor: pointer;
      /* #endif */

      .icon-Globe,
      .lang-text {
        margin-right: 8rpx;
      }

      /* 确保点击态响应 */
      &:active {
        opacity: 0.8;
        background-color: rgba(81, 71, 255, 0.08);
      }

      .iconfont {
        font-size: 32rpx;
        color: #17191f;
      }

      .lang-text {
        font-size: 26rpx;
        color: #17191f;
        font-weight: 500;
      }

      .icon-a-Chevrondown {
        font-size: 24rpx;
        opacity: 0.8;
      }
    }
  }
</style>
