/**
 * 新建日程里的参与者名单。
 * 目前是设计稿上的固定人选；选中顺序保留，用来生成「最后选中的人 等 N 人」。
 */
import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

export class SchedulePerson {
  id: string = "";
  name: string = "";
  badge: string = "";
  color: string = "";
}

function person(id: string, name: string, badge: string, color: string): SchedulePerson {
  const item = new SchedulePerson();
  item.id = id;
  item.name = name;
  item.badge = badge;
  item.color = color;
  return item;
}

/** 参与者候选，顺序与选择弹窗一致。 */
export function schedulePeople(): SchedulePerson[] {
  const list: SchedulePerson[] = [];
  list.push(person("chen", "陈设计师", "陈", "#5B67F5"));
  list.push(person("may", "阿May", "阿", "#3CBF8A"));
  list.push(person("zhou", "老周", "老", "#F0A04B"));
  list.push(person("bai", "白露", "白", "#F2B56B"));
  list.push(person("feng", "冯诗媛", "冯", "#E8893A"));
  return list;
}

function personName(id: string): string {
  const list = schedulePeople();
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == id) {
      return list[i].name;
    }
  }
  return "";
}

/**
 * 按选中顺序列出名字。
 * 1 到 2 人用顿号连起来；满 3 人起只留最后选中的那位，并接上「等 N 人」。
 * @param ids 选中顺序，先选的在前
 */
export function participantSummary(ids: string[]): string {
  const names: string[] = [];
  for (let i = 0; i < ids.length; i++) {
    const name = personName(ids[i]);
    if (name.length > 0) {
      names.push(name);
    }
  }
  if (names.length == 0) {
    return "";
  }
  if (names.length < 3) {
    let text = names[0];
    for (let i = 1; i < names.length; i++) {
      text = text + "、" + names[i];
    }
    return text;
  }
  const params = new Map<string, string | number>();
  params.set("name", names[names.length - 1]);
  params.set("count", names.length);
  return translateFn("Mobile.Discover.schedulePeopleEtc", toI18nParams(params), "");
}

/** 把存储里的逗号分隔 id 还原成选中顺序。 */
export function splitPeopleIds(text: string): string[] {
  const result: string[] = [];
  if (text.length == 0) {
    return result;
  }
  const parts = text.split(",");
  for (let i = 0; i < parts.length; i++) {
    const id = parts[i].trim();
    if (id.length > 0 && personName(id).length > 0) {
      result.push(id);
    }
  }
  return result;
}
