export async function mockVoxMessageList(unreadOnly: boolean, limit: number): Promise<RequestResponse<any>> {
  await delay(200);
  const arr: UTSJSONObject[] = [];
  for (let i = 0; i < mockMessageTable.length && arr.length < limit; i++) {
    const m = mockMessageTable[i];
    const readVal = m.getBoolean("read");
    if (unreadOnly && readVal != null && readVal) continue;
    arr.push(m);
  }
  return okEnvelope(arr);
}

export async function mockVoxUnreadCount(): Promise<RequestResponse<any>> {
  await delay(100);
  let count = 0;
  for (let i = 0; i < mockMessageTable.length; i++) {
    const readVal = mockMessageTable[i].getBoolean("read");
    if (readVal == null || !readVal) count++;
  }
  const view = new UTSJSONObject();
  view["unreadCount"] = count;
  return okEnvelope(view);
}

export async function mockVoxMarkMessageRead(id: number): Promise<RequestResponse<any>> {
  await delay(100);
  for (let i = 0; i < mockMessageTable.length; i++) {
    if ((mockMessageTable[i]["id"] as number) == id) {
      mockMessageTable[i]["read"] = true;
      return okEnvelope(null);
    }
  }
  return errEnvelope("3004", "消息不存在");
}
