/**
 * 「安装级」storage 键：语义是「这台设备装了这个 App 之后就成立」的状态，
 * 与登录态、业务缓存无关。
 *
 * ★为什么单独拎出来：退出登录 / token 失效走的都是
 *   `clearStoragePreservingApiBaseUrl()`（内部 `uni.clearStorageSync()`，见 constants/config.uts），
 *   会把全部 storage 清空。首启协议同意标记与通知授权「已问过」标记若被一起清掉，
 *   用户登出再打开（或 token 过期被踢）就会重新弹协议弹窗 / 通知授权框——
 *   2026-10-30 实测：鸿蒙真机上这两个键都被清掉过，导致「杀掉 App 点推送」时
 *   又弹出首启协议卡片，压在推送跳转上。
 *
 * 新增此类标记时，把键名加进 INSTALL_SCOPED_STORAGE_KEYS，清理时自动保留。
 * 这些标记都是短字符串，快照按「与键表同下标的字符串数组」传递，不用 UTSJSONObject
 * 动态键（UTS 里对参数类型的 UTSJSONObject 调 keys() 会报 error18 找不到名称）。
 */

/** 首启协议同意标记（值为同意时的 App 版本号，见 utils/firstLaunchAgreement.uts）。 */
export const FIRST_LAUNCH_AGREEMENT_KEY = "app_agreement_accepted_version";
/** 旧版布尔标记：保留原值，避免本次升级后已同意过的用户被再问一次。 */
export const FIRST_LAUNCH_AGREEMENT_LEGACY_KEY = "app_agreement_accepted_v1";
/** 通知授权「已问过」标记（见 utils/im/imPushClient.uts）。 */
export const NOTIFY_PERMISSION_ASKED_KEY = "im_notify_permission_asked";

const INSTALL_SCOPED_STORAGE_KEYS: Array<string> = [
  FIRST_LAUNCH_AGREEMENT_KEY,
  FIRST_LAUNCH_AGREEMENT_LEGACY_KEY,
  NOTIFY_PERMISSION_ASKED_KEY,
];

/**
 * 清理业务缓存前调用：按 INSTALL_SCOPED_STORAGE_KEYS 的顺序取出原值。
 * 不存在的键记为空串（这些标记本身不会存空串），恢复时跳过。
 */
export function snapshotInstallScopedStorage(): Array<string> {
  const values: Array<string> = [];
  for (let i = 0; i < INSTALL_SCOPED_STORAGE_KEYS.length; i++) {
    const key = INSTALL_SCOPED_STORAGE_KEYS[i];
    let text = "";
    try {
      const value = uni.getStorageSync(key);
      if (value != null) text = `${value}`;
    } catch (_e) {
      // 单个键读取异常不影响其余键与清理流程
    }
    values.push(text);
  }
  return values;
}

/** 清理完成后调用：把快照按下标写回。 */
export function restoreInstallScopedStorage(values: Array<string>): void {
  for (let i = 0; i < INSTALL_SCOPED_STORAGE_KEYS.length; i++) {
    if (i >= values.length) return;
    const text = values[i];
    if (text.length == 0) continue;
    try {
      uni.setStorageSync(INSTALL_SCOPED_STORAGE_KEYS[i], text);
    } catch (_e) {
      // 写回失败最坏结果是下次启动再问一次，不影响功能
    }
  }
}
