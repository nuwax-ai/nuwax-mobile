/**
 * 会中弹幕队列（模块级，非响应式）。
 *
 * ★为什么单独一个队列 + 独立组件：[meeting-danmaku] 用定时器驱动横向位移
 *   （uvue App 端跑不了 `@keyframes`，见 chat-view 的同类结论），
 *   位置每帧都在变，若把列表挂在会议页上会让整页跟着重渲。队列在这里、
 *   动画状态在子组件里，会议页只在收到消息时 push 一条，不参与逐帧渲染。
 */

/** 一条待飘屏的弹幕。 */
export class MeetingDanmakuMessage {
  name: string = "";
  text: string = "";
}

const queue: MeetingDanmakuMessage[] = [];

/** 最大积压：弹幕只做即时展示，积压太多逐条飘完要很久，直接丢最旧的。 */
const MAX_QUEUE = 20;

/** 收到一条弹幕（自己发的也会走这里，native 回传 self 消息后由 drain 调用方 push）。 */
export function pushMeetingDanmaku(name: string, text: string): void {
  const body = text.trim();
  if (body.length == 0) {
    return;
  }
  const item = new MeetingDanmakuMessage();
  item.name = name.trim();
  item.text = body;
  queue.push(item);
  while (queue.length > MAX_QUEUE) {
    queue.shift();
  }
}

/** 取走当前队列（组件每帧调用；返回空数组表示没有新弹幕）。 */
export function drainMeetingDanmaku(): MeetingDanmakuMessage[] {
  const out: MeetingDanmakuMessage[] = [];
  while (queue.length > 0) {
    const item = queue.shift();
    if (item != null) {
      out.push(item);
    }
  }
  return out;
}

/** 退会/断开时清空：避免下次进会先飘上一场的旧弹幕。 */
export function resetMeetingDanmaku(): void {
  while (queue.length > 0) {
    queue.shift();
  }
}
