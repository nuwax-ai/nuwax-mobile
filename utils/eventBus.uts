/**
 * 事件总线封装
 *
 * 对外提供与 PC 端一致的 API：on / off / emit / once
 * ★内部不再走 uni.$on/$emit，改为纯 UTS 自有订阅表：
 * App-Android 上经本封装注册的订阅者在 uni.$emit 后不被调用（IM 实时链路
 * 真机两轮实锤：调用点展开与显式单实参两种调用形态均零触发，页面级与
 * App 级订阅一致失效；同仓库裸 uni.$on/$emit 的单实参用法正常）。自有表
 * 分发为纯 UTS 逻辑，iOS/Android/H5 三端行为一致：同步分发、注册序调用、
 * 单载荷传参——与 iOS 已验证行为完全一致。裸 uni.$on 直用的监听名与本总线
 * 事件名无交集，两套互不受影响。
 *
 * 参考文档：https://doc.dcloud.net.cn/uni-app-x/api/event-bus.html
 */

type EventCallback = (...args: any[]) => void;

/**
 * 事件总线类
 */
class EventBus {
  /** 订阅表：eventName → 回调列表（注册序）。 */
  private listeners = new Map<string, EventCallback[]>();
  /** once 标记：触发前先注销（Kotlin 不支持闭包自引用，用标记表实现）。 */
  private onceFlags = new Set<EventCallback>();

  /**
   * 订阅事件
   * @param eventName 事件名称
   * @param callback 回调函数
   */
  on(eventName: string, callback: EventCallback): void {
    const list = this.listeners.get(eventName);
    if (list != null) {
      list.push(callback);
      return;
    }
    const arr: EventCallback[] = [];
    arr.push(callback);
    this.listeners.set(eventName, arr);
  }

  /**
   * 取消订阅
   * @param eventName 事件名称
   * @param callback 回调函数（须与 on 时同一引用）
   */
  off(eventName: string, callback: EventCallback): void {
    this.onceFlags.delete(callback);
    const list = this.listeners.get(eventName);
    if (list == null) {
      return;
    }
    const idx = list.indexOf(callback);
    if (idx < 0) {
      return;
    }
    list.splice(idx, 1);
    if (list.length == 0) {
      this.listeners.delete(eventName);
    }
  }

  /**
   * 发布事件
   * @param eventName 事件名称
   * @param args 参数（仓库内调用方均为单载荷）
   */
  emit(eventName: string, ...args: any[]): void {
    const list = this.listeners.get(eventName);
    if (list == null || list.length == 0) {
      return;
    }
    // 快照遍历：回调内 off（自身或其他订阅）不影响本轮已入快照的分发
    const snapshot: EventCallback[] = [];
    for (let i = 0; i < list.length; i++) {
      snapshot.push(list[i]);
    }
    // 单载荷传参：与原 uni.$emit 路径在 iOS 上实际送达的形态一致
    // 无载荷时补空对象：Kotlin 侧形参为非空 Any，传 null 会编译失败
    let payload: any = {};
    if (args.length > 0) {
      payload = args[0];
    }
    for (let i = 0; i < snapshot.length; i++) {
      const cb = snapshot[i];
      if (this.onceFlags.has(cb)) {
        this.onceFlags.delete(cb);
        this.off(eventName, cb);
      }
      cb(payload);
    }
  }

  /**
   * 一次性订阅事件（触发一次后自动取消）
   * @param eventName 事件名称
   * @param callback 回调函数
   */
  once(eventName: string, callback: EventCallback): void {
    this.onceFlags.add(callback);
    this.on(eventName, callback);
  }
}

// 创建全局事件总线实例
const eventBus = new EventBus();

export default eventBus;

// 定义常用的事件名称常量（与 PC 端保持一致）
export const EVENT_NAMES = {
  // 发送聊天消息事件
  SEND_CHAT_MESSAGE: 'send_chat_message',
  // 清空聊天输入框事件
  CLEAR_CHAT_INPUT: 'clear_chat_input',
} as const;
