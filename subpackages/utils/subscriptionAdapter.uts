import type {
  CreditBatchExtra,
  CreditBatchItem,
  MySubscriptionItem,
  MySubscriptionPlanInfo,
  SystemSubscriptionPlan,
  SystemSubscriptionPlanGroup,
  SystemSubscriptionPlanItem,
} from "@/subpackages/types/interfaces/subscription";

export type SubscriptionPlanInfoView = MySubscriptionPlanInfo;
export type SubscriptionItemView = MySubscriptionItem;
export type CreditBatchExtraView = CreditBatchExtra;
export type CreditBatchItemView = CreditBatchItem;
export type SubscriptionPlanItemView = SystemSubscriptionPlanItem;
export type SubscriptionPlanGroupView = SystemSubscriptionPlanGroup;
export type SubscriptionPlanView = SystemSubscriptionPlan;

/**
 * Android 请求层会把 JSON 数组元素保留为 UTSJSONObject。不能只用 `as Model`
 * 断言，否则 uvue 模板遍历时会将其强转为 Model 并抛出 ClassCastException。
 */
const getValue = (raw: any | null, key: string): any | null => {
  if (raw == null) return null;
  try {
    return (raw as UTSJSONObject)[key];
  } catch (_e) {
    try {
      return (raw as Map<string, any | null>).get(key);
    } catch (_mapError) {
      return null;
    }
  }
};

export const getSubscriptionResponseValue = (raw: any, key: string): any | null =>
  getValue(raw, key);

const toStringValue = (value: any | null): string =>
  value != null ? `${value}` : "";

const toNumberValue = (value: any | null): number =>
  value != null && typeof value === "number" ? (value as number) : 0;

const toBooleanValue = (value: any | null): boolean =>
  value != null && typeof value === "boolean" ? (value as boolean) : false;

const toNullableString = (value: any | null): string | null =>
  value != null ? `${value}` : null;

const toNullableNumber = (value: any | null): number | null =>
  value != null && typeof value === "number" ? (value as number) : null;

const normalizePlanInfo = (raw: any | null): SubscriptionPlanInfoView => ({
  id: toNumberValue(getValue(raw, "id")),
  name: toStringValue(getValue(raw, "name")),
  description: toNullableString(getValue(raw, "description")),
  price: toNumberValue(getValue(raw, "price")),
  firstPrice: toNumberValue(getValue(raw, "firstPrice")),
  period: toStringValue(getValue(raw, "period")),
  creditAmount: toNumberValue(getValue(raw, "creditAmount")),
  callLimitCount: toNullableNumber(getValue(raw, "callLimitCount")),
  functionOnly: getValue(raw, "functionOnly") != null
    ? toBooleanValue(getValue(raw, "functionOnly"))
    : null,
  dailyGiftCreditAmount: toNullableNumber(getValue(raw, "dailyGiftCreditAmount")),
  isHot: getValue(raw, "isHot") != null ? toBooleanValue(getValue(raw, "isHot")) : null,
});

export const normalizeMySubscriptionItem = (raw: any): SubscriptionItemView => ({
  id: toNullableNumber(getValue(raw, "id")),
  planId: toNumberValue(getValue(raw, "planId")),
  planName: toStringValue(getValue(raw, "planName")),
  bizType: toNullableString(getValue(raw, "bizType")),
  bizId: toNullableNumber(getValue(raw, "bizId")),
  bizName: toNullableString(getValue(raw, "bizName")),
  icon: toNullableString(getValue(raw, "icon")),
  period: toNullableString(getValue(raw, "period")),
  startTime: toNullableString(getValue(raw, "startTime")),
  endTime: toNullableString(getValue(raw, "endTime")),
  status: toStringValue(getValue(raw, "status")),
  plan: normalizePlanInfo(getValue(raw, "plan")),
  callUsedCount: toNullableNumber(getValue(raw, "callUsedCount")),
  nextResetTime: toNullableString(getValue(raw, "nextResetTime")),
  created: toNullableString(getValue(raw, "created")),
  modified: toNullableString(getValue(raw, "modified")),
});

export const normalizeMySubscriptionList = (raw: any | null): SubscriptionItemView[] => {
  const result = [] as SubscriptionItemView[];
  if (!Array.isArray(raw)) return result;
  for (let i = 0; i < raw.length; i++) result.push(normalizeMySubscriptionItem(raw[i]));
  return result;
};

export const normalizeCreditBatchList = (raw: any | null): CreditBatchItemView[] => {
  const result = [] as CreditBatchItemView[];
  if (!Array.isArray(raw)) return result;
  for (let i = 0; i < raw.length; i++) {
    const item = raw[i];
    const extraRaw = getValue(item, "extra");
    const extra: CreditBatchExtraView | null = extraRaw != null
      ? { price: toNumberValue(getValue(extraRaw, "price")) }
      : null;
    result.push({
      id: toNumberValue(getValue(item, "id")),
      batchNo: toStringValue(getValue(item, "batchNo")),
      creditType: toStringValue(getValue(item, "creditType")),
      totalAmount: toNumberValue(getValue(item, "totalAmount")),
      usedAmount: toNumberValue(getValue(item, "usedAmount")),
      remainAmount: toNumberValue(getValue(item, "remainAmount")),
      expireTime: toStringValue(getValue(item, "expireTime")),
      expired: toBooleanValue(getValue(item, "expired")),
      remark: toStringValue(getValue(item, "remark")),
      extra,
      created: toStringValue(getValue(item, "created")),
    });
  }
  return result;
};

const normalizePlanItem = (raw: any): SubscriptionPlanItemView => ({
  name: toStringValue(getValue(raw, "name")),
  description: toStringValue(getValue(raw, "description")),
  icon: toStringValue(getValue(raw, "icon")),
  selected: toBooleanValue(getValue(raw, "selected")),
});

const normalizePlanGroup = (raw: any): SubscriptionPlanGroupView => {
  const items = [] as SubscriptionPlanItemView[];
  const itemsRaw = getValue(raw, "items");
  if (Array.isArray(itemsRaw)) {
    for (let i = 0; i < itemsRaw.length; i++) items.push(normalizePlanItem(itemsRaw[i]));
  }
  return {
    name: toStringValue(getValue(raw, "name")),
    description: toStringValue(getValue(raw, "description")),
    groupType: toStringValue(getValue(raw, "groupType")),
    items,
  };
};

export const normalizeSystemSubscriptionPlanList = (raw: any | null): SubscriptionPlanView[] => {
  const result = [] as SubscriptionPlanView[];
  if (!Array.isArray(raw)) return result;
  for (let i = 0; i < raw.length; i++) {
    const item = raw[i];
    const itemGroups = [] as SubscriptionPlanGroupView[];
    const groupsRaw = getValue(item, "itemGroups");
    if (Array.isArray(groupsRaw)) {
      for (let j = 0; j < groupsRaw.length; j++) itemGroups.push(normalizePlanGroup(groupsRaw[j]));
    }
    result.push({
      id: toNumberValue(getValue(item, "id")),
      name: toStringValue(getValue(item, "name")),
      description: toStringValue(getValue(item, "description")),
      price: toNumberValue(getValue(item, "price")),
      firstPrice: toNumberValue(getValue(item, "firstPrice")),
      period: toStringValue(getValue(item, "period")),
      creditAmount: toNumberValue(getValue(item, "creditAmount")),
      callLimitCount: toNumberValue(getValue(item, "callLimitCount")),
      functionOnly: toBooleanValue(getValue(item, "functionOnly")),
      dailyGiftCreditAmount: toNumberValue(getValue(item, "dailyGiftCreditAmount")),
      isHot: toBooleanValue(getValue(item, "isHot")),
      status: toNumberValue(getValue(item, "status")),
      sort: toNumberValue(getValue(item, "sort")),
      itemGroups,
    });
  }
  return result;
};
