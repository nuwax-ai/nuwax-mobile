import { AuthIdpProvider, AuthIdpList, AuthIdentity } from "@/types/interfaces/authIdp";

export const MOBILE_LOGIN_PATH = "/subpackages/pages/login/login";
export const IDP_RETURN_PATH = "/subpackages/pages/auth/idp-return";
export const IDENTITY_PAGE_PATH = "/subpackages/pages/account-identity/account-identity";
export const AUTH_HOME_PATH = "/pages/message/message";

function field(obj: UTSJSONObject, key: string): string {
  const value = obj[key];
  return value != null ? `${value}` : "";
}

export function isAuthId(value: string): boolean {
  return /^[1-9][0-9]*$/.test(value);
}

export function parseAuthIdpList(raw: any | null): AuthIdpList {
  const result = new AuthIdpList();
  if (raw == null || typeof raw != "object" || Array.isArray(raw)) return result;
  const obj = raw as UTSJSONObject;
  const itemsRaw = obj["items"];
  if (!Array.isArray(itemsRaw)) return result;
  const items = itemsRaw as any[];
  for (let i = 0; i < items.length; i++) {
    const item = items[i];
    if (item == null || typeof item != "object" || Array.isArray(item)) return result;
    const source = item as UTSJSONObject;
    const provider = new AuthIdpProvider();
    provider.id = field(source, "id");
    if (!isAuthId(provider.id)) return result;
    provider.type = field(source, "type");
    provider.name = field(source, "name");
    provider.icon = field(source, "icon");
    provider.wechatMode = field(source, "wechatMode");
    if (!result.items.some((p: AuthIdpProvider): boolean => p.id == provider.id)) result.items.push(provider);
  }
  result.autoRedirectIdpId = field(obj, "autoRedirectIdpId");
  result.valid = true;
  return result;
}

/** null 表示响应异常；[] 才表示已成功读取且没有绑定。 */
export function parseAuthIdentities(raw: any | null): AuthIdentity[] | null {
  if (!Array.isArray(raw)) return null;
  const items = raw as any[];
  const result: AuthIdentity[] = [];
  for (let i = 0; i < items.length; i++) {
    if (items[i] == null || typeof items[i] != "object" || Array.isArray(items[i])) return null;
    const source = items[i] as UTSJSONObject;
    const item = new AuthIdentity();
    item.id = field(source, "id");
    item.idpId = field(source, "idpId");
    if (!isAuthId(item.id) || !isAuthId(item.idpId)) return null;
    item.providerName = field(source, "providerName");
    item.externalUserName = field(source, "externalUserName");
    item.externalIdMasked = field(source, "externalIdMasked");
    result.push(item);
  }
  return result;
}

/** 原生 SDK 会话交换尚未有接口合同。当前仅同源、非内嵌的浏览器 H5 开放。 */
export function availableAuthProviders(items: AuthIdpProvider[], browserSupported: boolean, userAgent: string): AuthIdpProvider[] {
  if (!browserSupported) return [];
  const inWechat = userAgent.toLowerCase().includes("micromessenger");
  return items.filter((p: AuthIdpProvider): boolean => {
    if (p.type == "WECHAT") return p.wechatMode == (inWechat ? "OA" : "QRCODE");
    return p.type == "CAS" || p.type == "OAUTH2";
  });
}

export function autoAuthProviderId(items: AuthIdpProvider[], configured: string, local: boolean, error: string, agreed: boolean): string {
  if (local || error.length > 0 || !agreed) return "";
  return items.some((p: AuthIdpProvider): boolean => p.id == configured) ? configured : "";
}

/** 拒绝浏览器会解释为其他 origin 的路径及多层编码绕过。 */
function safeRelative(value: string): boolean {
  if (!value.startsWith("/") || value.startsWith("//")) return false;
  let decoded = value;
  for (let i = 0; i < 4; i++) {
    if (decoded.startsWith("//") || /[\\\u0000-\u0020\u007f]/.test(decoded)) return false;
    try {
      const next = decodeURIComponent(decoded);
      if (next == null) return false;
      if (next == decoded) return true;
      decoded = next;
    } catch (_error) {
      return false;
    }
  }
  return false;
}

export function decodeAuthQuery(value: string): string {
  try {
    const decoded = decodeURIComponent(value);
    return decoded != null ? decoded : "";
  } catch (_error) { return ""; }
}

/** 接受本站 /m/#/ 路由或 App 内部页面；不允许返回登录、启动和认证回调页。 */
export function resolveMobileAuthReturn(value: string, origin: string = ""): string {
  let target = value;
  if (origin.length > 0 && target.startsWith(origin + "/")) target = target.substring(origin.length);
  if (target.startsWith("/m/#/")) target = target.substring(4);
  if (!safeRelative(target)) return AUTH_HOME_PATH;
  const path = target.split("?")[0];
  if (!/^\/(pages|subpackages\/pages)\/[a-zA-Z0-9_/-]+$/.test(path)) return AUTH_HOME_PATH;
  if (path.includes("//") || path.includes("/login") || path.includes("/auth/") ||
      path.includes("/launch/") || path.includes("/offline-h5-bootstrap/")) return AUTH_HOME_PATH;
  if (path == "/subpackages/pages/temporary-session/temporary-session") return AUTH_HOME_PATH;
  return target;
}

/** 认证续接只放行后端 pending 页面，不将所有 /auth 或 /api URL 当作可信页面。 */
export function resolvePendingAuthReturn(value: string, origin: string): string {
  let target = value;
  if (origin.length > 0 && target.startsWith(origin + "/")) target = target.substring(origin.length);
  if (!safeRelative(target) || target.includes("#")) return "";
  if (target.split("?")[0] != "/auth/bind-or-register") return "";
  const query = target.split("?");
  if (query.length != 2) return "";
  const fields = query[1].split("&");
  let hasToken = false;
  let hasBind = false;
  for (let i = 0; i < fields.length; i++) {
    if (fields[i].startsWith("token=") && fields[i].length > 6 && !hasToken) hasToken = true;
    else if (fields[i] == "bind=1" && !hasBind) hasBind = true;
    else return "";
  }
  return hasToken ? target : "";
}

export function mobileAuthWebReturn(value: string, origin: string): string {
  return "/m/#" + resolveMobileAuthReturn(value, origin);
}

export function buildIdpAuthorizePath(providerId: string, returnPath: string): string {
  if (!isAuthId(providerId) || !safeRelative(returnPath)) return "";
  return "/api/auth/idp/authorize?provider=" + providerId + "&redirect=" + encodeURIComponent(returnPath);
}

export function buildIdentityBindPath(providerId: string, returnPath: string): string {
  if (!isAuthId(providerId) || !safeRelative(returnPath)) return "";
  return "/api/user/identity/bind/" + providerId + "?redirect=" + encodeURIComponent(returnPath);
}

/** 把旧请求、切域后响应和卸载后的回调挡在 UI/会话变更之前。 */
export class AuthLoadScope {
  private revision: number = 0;
  begin(): number { this.revision += 1; return this.revision; }
  invalidate(): void { this.revision += 1; }
  accepts(revision: number, requestedOrigin: string, currentOrigin: string): boolean {
    return revision == this.revision && requestedOrigin == currentOrigin;
  }
}
