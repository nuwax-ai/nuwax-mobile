// uni-app x / Android 网络响应运行时恒为 UTSJSONObject。
//
// 【核心规则】RequestResponse 必须别名到 UTSJSONObject，禁止 interface / 对象字面量 type：
//   - interface → Gson 无法实例化 + ClassCastException
//   - { code, data, ... } → Kotlin 生成独立 RequestResponse 类 → ClassCastException
//   - UTSJSONObject 别名 → Promise<RequestResponse<T>> 运行时就是 UTSJSONObject，无强转
//
// 泛型 T 仅标注 res.data 的业务类型（编译期提示），不参与 Android 运行时转换。
// 读取字段请用 apiResCode / apiResData<T> / apiResMessage（@/utils/common），勿 res.code 强转。
export type RequestResponse<T = any> = UTSJSONObject;

/** 无业务 data 的 API 响应 */
export type VoidRequestResponse = RequestResponse<any>;

/**
 * 响应体字段说明（仅文档/IDE，勿用于 Promise 返回类型）
 * { code, displayCode, message, data, success, tid }
 */
export type RequestResponseShape<T = any> = {
  code: string;
  data: T;
  message: string;
  displayCode: string;
  success: boolean;
  tid: string;
};

/** HTTP 请求配置（供 useRequest 使用；命名避开 uni.request 内置 RequestOptions，防止 Android 类型冲突） */
export interface ApiRequestOptions {
  url: string;
  method?: string;
  data?: any;
  timeout?: number | null;
}

// 排序字段信息,可空,一般没有默认为创建时间排序
export interface Sort {

  column: string;
  asc: boolean;
}

// 分页响应数据
export interface Page<T> {
  records: T[];
  total: number;
  size: number;
  current: number;
  pages: number;
  orders: Sort[];
  optimizeCountSql: boolean;
  searchCount: boolean;
  optimizeJoinOfCountSql: boolean;
  maxLimit: number;
  countId: string;
}

// 表格列扩展配置
export interface TableExtInfo {

  // 列固定位置
  fixed: string;
  // 是否可见
  visible: boolean;
  // 子标签
  subLabel: string;
  // 列宽度
  width: string;
  // 最小宽度
  minWidth: string;
  // 是否可设置
  settable: boolean;
  // 对齐方式
  align: string;
  // 格式化器
  formatter: string;
  // 提示信息
  tips: string;
  // 是否省略
  ellipsis: boolean;
}

// 表格列信息
export interface SuperTableColumn {

  // 序号
  serialNumber: number;
  // 列标签
  label: string;
  // 列名称
  name: string;
  // 是否可排序
  sortable: boolean;
  // 提示信息
  tips: string;
  // 扩展配置
  ext: TableExtInfo;
}

/** 表格列筛选条件 */
export interface TablePageFilter {
  column: string;
  operator: string;
  value: object;
}

/** 表格分页请求列信息 */
export interface TablePageColumn {
  serialNumber: number;
  label: string;
  name: string;
  sortable: boolean;
  tips: string;
  ext: TableExtInfo;
  children: SuperTableColumn[];
}

// table分页请求基础信息
export interface TablePageRequest<T> {
  queryFilter: T;
  // 当前页,示例值(1)
  current: number;
  // 分页pageSize,示例值(10)
  pageSize: number;
  // 排序字段信息,可空,一般没有默认为创建时间排序
  orders: Sort[];
  // 列的筛选条件,可空
  filters: TablePageFilter[];
  // 表格的列信息,可空
  columns: TablePageColumn[];
}
