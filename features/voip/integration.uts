/** Host lifecycle and invitation entry points. Keep call rules inside this feature. */
import { readVoipDevSession } from "@/servers/voip";
import { isVoipBusinessEnabled, isVoipPlatformAccepted } from "./callManager";

export { bootstrapVoip, clearVoipSession, setVoipBackground, handleVoipInvitation, startVoipCall } from "./callManager";
export { getVoipChatEndKey, voipRevision } from "./callManager";
// #ifdef APP-IOS
export { prepareIosVoipLogout } from "./callManager";
// #endif

/** 原生 IM WS 与应用内收到同一条单聊邀请，只由当前启用的链路处理。 */
export function isNativeImVoipEnabled(): boolean {
  return (isVoipBusinessEnabled() || isVoipPlatformAccepted()) && readVoipDevSession() == null;
}

// #ifdef APP-HARMONY
import { hasNativeVoipCall as nativeCallActive } from "@/uni_modules/nuwax-voip";

export function hasNativeVoipCall(): boolean { return nativeCallActive(); }
// #endif
