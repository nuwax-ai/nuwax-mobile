  // 	})
  // 	data.processingList.value = newProcessingList
  // }

  /**
   * 将 UTSJSONObject 安全地转换为 StringAnyRecord
   * Android 上 UTSJSONObject 不能直接 cast 为 Map（Record 的 Java 映射），
   * 需通过 new Map() 逐字段拷贝来绕过 ClassCastException
   */
  static utsObjToRecord(obj: UTSJSONObject | null): StringAnyRecord {
    const result = new Map<string, any>();
    if (obj != null) {
      const keys = UTSJSONObject.keys(obj);
      if (keys != null) {
        for (let i = 0; i < keys.length; i++) {
          result.set(keys[i], obj[keys[i]]!);
        }
      }
    }
    return result as any as StringAnyRecord;
  }

  /**
   * 将发送消息入参转为 UTSJSONObject。
   * Android 上 ChatSendMessageData 等 class 实例禁止 as UTSJSONObject（ClassCastException），
   * 且 JSON.stringify(class) 常得到 "{}"，导致 messageInfo 丢失。
   */
  static toSendMessageParamsObject(input: any): UTSJSONObject {
    if (input == null) {
      return {} as UTSJSONObject;
    }

    const result = new UTSJSONObject();
    let fieldCount = 0;

    for (let i = 0; i < SEND_MESSAGE_PARAM_KEYS.length; i++) {
      const key = SEND_MESSAGE_PARAM_KEYS[i];
      const val = readRawField(input, key);
      if (val != null) {
        result[key] = val;
        fieldCount++;
      }
    }

    // Android：class 实例 bracket / stringify 可能读不到，直接读 ChatSendMessageData 属性
    if (result["messageInfo"] == null) {
      try {
        const sendData = input as ChatSendMessageData;
        const msgText = sendData.messageInfo;
        if (msgText != null && msgText.length > 0) {
          result["messageInfo"] = msgText;
          fieldCount++;
        }
        if (result["files"] == null && sendData.files.length > 0) {
          result["files"] = sendData.files;
          fieldCount++;
        }
        if (result["selectedComponents"] == null && sendData.selectedComponents.length > 0) {
          result["selectedComponents"] = sendData.selectedComponents;
          fieldCount++;
        }
        if (result["skillIds"] == null && sendData.skillIds.length > 0) {
          result["skillIds"] = sendData.skillIds;
          fieldCount++;
        }
      } catch (_eClass) {
        // 非 ChatSendMessageData，忽略
      }
    }

    if (fieldCount > 0) {
      return result;
    }

    try {
      const jsonStr = JSON.stringify(input);
      if (jsonStr != null && jsonStr.length > 2 && jsonStr != "null" && jsonStr != "{}") {
        return JSON.parse(jsonStr) as UTSJSONObject;
      }
    } catch (e) {
      console.error("[AgentDetailUtils] toSendMessageParamsObject failed:", e);
    }

    return result;
  }
}
