/** 待发媒体必须保留选择器返回的类型，不能从无扩展名的本地 URI 推断。 */
export class ChatStagedMedia {
  id: string = "";
  localPath: string = "";
  kind: string = "image";
  poster: string = "";
}

export function stagedMediaName(media: ChatStagedMedia): string {
  const parts = media.localPath.split("?")[0].split("/");
  let name = parts[parts.length - 1];
  if (name.length == 0) name = "media";
  if (name.indexOf(".") < 0) name += media.kind == "video" ? ".mp4" : ".jpg";
  return name;
}

export function stagedMediaMime(media: ChatStagedMedia, uploadedMime: string): string {
  if (uploadedMime.startsWith(`${media.kind}/`)) return uploadedMime;
  if (media.kind == "video") {
    const name = stagedMediaName(media).toLowerCase();
    if (name.endsWith(".mov")) return "video/quicktime";
    if (name.endsWith(".webm")) return "video/webm";
    if (name.endsWith(".3gp")) return "video/3gpp";
    if (name.endsWith(".mkv")) return "video/x-matroska";
    if (name.endsWith(".mpg") || name.endsWith(".mpeg")) return "video/mpeg";
    if (name.endsWith(".m4v")) return "video/x-m4v";
    return "video/mp4";
  }
  const name = stagedMediaName(media).toLowerCase();
  if (name.endsWith(".png")) return "image/png";
  if (name.endsWith(".gif")) return "image/gif";
  if (name.endsWith(".webp")) return "image/webp";
  if (name.endsWith(".heic")) return "image/heic";
  return "image/jpeg";
}

export function serializeStagedMedia(media: ChatStagedMedia[]): UTSJSONObject[] {
  const result: UTSJSONObject[] = [];
  for (let i = 0; i < media.length; i++) {
    const item = new UTSJSONObject();
    item["path"] = media[i].localPath;
    item["kind"] = media[i].kind;
    item["poster"] = media[i].poster;
    result.push(item);
  }
  return result;
}

/**
 * 待发媒体本地路径「可展示化」。
 *
 * 鸿蒙相册插件（nuwax-harmony-album-picker）落沙箱时直接用媒体库 URI 末段做文件名，
 * 而 URI 是 URL 编码的（中文/空格/引号 → %XX / +），磁盘上真实文件名就带
 * `%E5%B9%B4` 这类字面量。文件系统按字面名能读到（getFileInfo 的 size 正常），
 * 但 `<image>` 与预览页会把 src 当 URL 解析、先解码 %XX，拼出的中文名磁盘上没有
 * → 真机 2026-11-09 实证：thumb mounted 后 @error 立即触发，点缩略图预览同样打不开。
 *
 * 修法：检测到文件名含 `%` 就解码（解码后残留的 `%` 再清成 `_`）并异步复制一份到
 * 同目录，缩略图/预览/上传统一用副本路径；复制失败回落原路径（至少上传还能用）。
 * 不加前缀/后缀——视频展示名取自路径末段，加前后缀会污染用户可见文件名。
 *
 * ★只对鸿蒙生效（Android/iOS/H5/小程序走 `#ifndef APP-HARMONY` 直返原路径）：
 * 该文件名问题只出在鸿蒙相册插件按 URI 末段落盘这一处，其它端临时路径不含 %XX，
 * 不能因为这条兜底改变它们原有的同步入队时序。
 */
export function ensureStagedPathDisplayable(path: string): Promise<string> {
  // #ifdef APP-HARMONY
  return new Promise<string>((resolve) => {
    if (path.length == 0 || path.indexOf("%") < 0) {
      resolve(path);
      return;
    }
    const cut = path.indexOf("?");
    const pure = cut >= 0 ? path.substring(0, cut) : path;
    const slash = pure.lastIndexOf("/");
    const dir = slash >= 0 ? pure.substring(0, slash + 1) : "";
    const rawName = slash >= 0 ? pure.substring(slash + 1) : pure;
    if (rawName.length == 0) {
      resolve(path);
      return;
    }
    let decoded = rawName;
    try {
      decoded = decodeURIComponent(rawName);
    } catch (_e) {
      decoded = rawName;
    }
    // 解码后仍残留的 %（原文件名本身带百分号）依旧会被 <image> 当转义引导符，替换掉
    let safeName = "";
    for (let i = 0; i < decoded.length; i++) {
      const ch = decoded.substring(i, i + 1);
      safeName += ch == "%" ? "_" : ch;
    }
    if (safeName == rawName) {
      resolve(path);
      return;
    }
    const dest = `${dir}${safeName}`;
    uni.getFileSystemManager().copyFile({
      srcPath: path,
      destPath: dest,
      success: (_res) => {
        resolve(dest);
      },
      fail: (_err) => {
        resolve(path);
      },
    });
  });
  // #endif
  // #ifndef APP-HARMONY
  return Promise.resolve(path);
  // #endif
}

export function readStagedMedia(raw: any | null): ChatStagedMedia[] {
  const result: ChatStagedMedia[] = [];
  if (raw == null || !Array.isArray(raw)) return result;
  const items = raw as UTSJSONObject[];
  for (let i = 0; i < items.length && result.length < 9; i++) {
    const item = items[i];
    if (item == null || item["path"] == null || `${item["path"]}`.length == 0) continue;
    const media = new ChatStagedMedia();
    media.localPath = `${item["path"]}`;
    media.kind = item["kind"] == "video" ? "video" : "image";
    media.poster = item["poster"] != null ? `${item["poster"]}` : "";
    result.push(media);
  }
  return result;
}
