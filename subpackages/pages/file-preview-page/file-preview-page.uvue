<template>
  <view class="container page-container">
    <!-- 导航栏 -->
    <!-- #ifdef H5 || WEB || MP-WEIXIN || APP-->
    <custom-nav-bar :title="fileName" show-back hasSafetyZone>
      <template v-slot:right>
        <!-- #ifdef H5 || WEB || APP -->
        <svg-icon
          name="icon-ShareAltOutlined"
          size="48"
          @click="handleShare"
        />
        <!-- #endif -->
      </template>
    </custom-nav-bar>
    <!-- #endif -->

    <view class="file-preview-content">
      <!-- 加载中 -->
      <!-- <template v-if="isLoading">
        <view class="loading-box">
          <image
            class="icon-loading-image"
            src="@/static/assets/icon_loading.svg"
            mode="widthFix"
          />
        </view>
      </template> -->

      <!-- Web-View 预览 -->
      <template v-if="previewUrl">
        <!-- #ifdef H5 || WEB -->
        <iframe
          class="w-full h-full"
          frameborder="0"
          :src="previewUrl"
        ></iframe>
        <!-- #endif -->

        <!-- #ifdef MP-WEIXIN || APP -->
        <web-view
          class="w-full h-full"
          :src="previewUrl"
          id="webview"
          @message="onWebViewMessage"
        ></web-view>
        <!-- #endif -->
      </template>

    </view>

    <!-- 分享面板：复制链接 / 分享到微信 -->
    <uni-modal-popup
      ref="sharePopupRef"
      position="bottom"
      height="430rpx"
      :show-header="false"
      :show-close-btn="false"
      :round="true"
      :body-scroll="false"
      :enable-swipe-close="true"
      @update-visible="onShareSheetVisible"
    >
      <view class="share-sheet">
        <view class="share-sheet-title">
          <text class="share-sheet-title-text">{{ t("Mobile.FilePreview.shareTitle") }}</text>
        </view>
        <view class="share-sheet-options">
          <view class="share-sheet-option" @tap="handleCopyLink">
            <view class="share-option-icon share-option-icon--link">
              <svg-icon name="icon-Link" size="44" color="#ffffff" />
            </view>
            <text class="share-option-label">{{ t("Mobile.FilePreview.copyLink") }}</text>
          </view>
          <!-- #ifdef APP -->
          <view class="share-sheet-option" @tap="handleShareToWechat">
            <view class="share-option-icon share-option-icon--wechat">
              <image
                class="share-option-img"
                src="@/static/assets/icon-wechat.svg"
                mode="aspectFit"
                alt=""
              />
            </view>
            <text class="share-option-label">{{ t("Mobile.FilePreview.shareToWechat") }}</text>
          </view>
          <!-- #endif -->
        </view>
        <view class="share-sheet-cancel" @tap="closeShareSheet">
          <text class="share-sheet-cancel-text">{{ t("Mobile.Common.cancel") }}</text>
        </view>
      </view>
    </uni-modal-popup>
  </view>
</template>

<script setup lang="uts">
  import { ref, onMounted, onUnmounted, type ComponentPublicInstance } from 'vue';
  import { onLoad } from "@dcloudio/uni-app";
  // #ifndef APP-ANDROID
  import { onShareAppMessage, onAddToFavorites } from "@dcloudio/uni-app";
  // #endif
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import {
    parseUrlInfo,
    getFileName,
  } from "@/subpackages/utils/parseUrlInfo";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import { firstString } from "@/utils/utsCoalesce";
  import {
    extractOpenUiArtifactIdFromText,
    parseOpenUiActionData,
  } from "@/utils/openUiSchema.uts";
  import { buildOpenUiResumeMessage } from "@/utils/openUiResumeMessage.uts";
  import { savePendingOpenUiAction } from "@/utils/pendingOpenUiAction.uts";

  // 模板内嵌 t(...) 时须包装成单参函数（类字段 t 的 params/fallback 为可选参，
  // 模板编译产物不传默认值，Kotlin 报 No value passed for parameter）
  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  // 请求工具
  import {
    apiUserTicketCreate,
    apiAgentConversationShare,
  } from "@/servers/agentDev";
  import { AgentConversationShareParams } from "@/types/interfaces/agent";
  import { SUCCESS_CODE } from "@/constants/codes.constants";

  // 环境配置
  import { getApiBaseUrl } from "@/constants/config";

  const previewUrl = ref<string>(""); // 预览地址
  const fileName = ref<string>(""); // 文件名
  const pageTitle = ref<string>(""); // 页面标题
  const fileType = ref<string>(""); // 文件类型

  const isLoading = ref<boolean>(true); // 是否加载中
  const conversationId = ref<string | null>(null); // 会话ID
  const fileProxyUrl = ref<string>(""); // 文件路径
  const sk = ref<string>(""); // sk 微信小程序中需要 sk 查询参数
  /** web-view 可能重复派发同一个 action；页面生命周期内只接受第一次有效提交。 */
  let hasHandledOpenUiAction = false;
  // #ifdef H5 || WEB
  const isDev = process.env.NODE_ENV == "development";
  // #endif
  // #ifndef H5 || WEB
  const isDev = false;
  // #endif

  const getShareTitle = (): string => {
    return firstString([pageTitle.value, fileName.value]);
  };

  let baseUrl = "";
  // #ifdef H5 || WEB
  baseUrl = isDev ? getApiBaseUrl() : (window != null && window.location != null ? window.location.origin : getApiBaseUrl());
  // #endif

  // #ifdef MP-WEIXIN || APP
  baseUrl = getApiBaseUrl();
  // #endif

  /**
   * 获取 shareKey
   */
  async function getConversationShareKey(conversationId: string, content: string): Promise<string> {
    const params = new AgentConversationShareParams();
    params.conversationId = conversationId;
    params.type = "CONVERSATION";
    params.content = content;

    const res = await apiAgentConversationShare(params);
    const code = res.code;
    const data = res.data;

    const dataObj = data != null ? (data as UTSJSONObject) : null;
    const shareKey = dataObj != null ? dataObj["shareKey"] : null;
    if (code != SUCCESS_CODE || shareKey == null) {
      throw new Error(t("Mobile.FilePreview.getShareKeyFailed"));
    }

    return `${shareKey}`;
  }

  /**
   * 分享/外链地址不得携带会话内预览标记 mode=preview。当前分享链接由 shareKey 独立拼接、
   * 本不含该标记；此处作兜底过滤，防止日后误把带标记的 previewUrl 用于分享场景。
   */
  const stripPreviewMode = (url: string): string => {
    if (url.indexOf("mode=preview") < 0) return url;
    let s = url.replace("&mode=preview", "");
    s = s.replace("?mode=preview&", "?");
    s = s.replace("?mode=preview", "");
    return s;
  };

  /** 复制分享链接到剪贴板：H5/WEB 的分享主路径，App 端系统分享失败时的兜底 */
  const copyShareLinkToClipboard = (url: string, successTitle: string): void => {
    uni.setClipboardData({
      data: url,
      success: () => {
        uni.showToast({
          title: successTitle,
          icon: "none",
          duration: 2000,
        });
      },
      fail: () => {
        uni.showToast({
          title: t("Mobile.FilePreview.shareFailed"),
          icon: "none",
          duration: 2000,
        });
      },
    });
  };

  /**
   * 分享流程守卫：从发起（含 getConversationShareKey 网络请求）到系统分享面板关闭期间
   * 忽略重复点击，防止连点重复唤起多个分享面板。
   */
  let isSharing = false;

  // 分享文件
  const handleShare = async () => {
    // 连点守卫：上一次分享尚未结束（分享链接请求中 / 系统面板未关闭）时直接忽略
    if (isSharing) return;

    if (baseUrl.length == 0) {
      throw new Error(t("Mobile.FilePreview.shareDomainMissing"));
    }
    const cIdVal = conversationId.value != null ? (conversationId.value as string) : "";
    const shareKey = await getConversationShareKey(
      cIdVal,
      fileProxyUrl.value != null ? fileProxyUrl.value : "",
    );
    const previewUrlValue = stripPreviewMode(
      `${baseUrl}/static/file-preview.html?sk=${shareKey}`,
    );
    shareUrlCache = previewUrlValue;
    return previewUrlValue;
  };

  /** Android：Gen* 组件 ref 禁止 as UTSJSONObject，用 $callMethod 调 uni-modal-popup */
  const callSharePopupMethod = (methodName: string): void => {
    const refVal = sharePopupRef.value as any | null;
    if (refVal == null) {
      return;
    }

    isSharing = true;

    try {
      const proxy = refVal as ComponentPublicInstance;
      proxy.$callMethod(methodName);
    } catch (_e) {
      // ignore
    }
  };

  const openShareSheet = (): void => {
    callSharePopupMethod("open");
  };

      // #ifdef APP
      // App 端（Android / iOS / 鸿蒙）：唤起系统分享面板，把链接分享到设备上已安装的 App。
      // uni.shareWithSystem 为内置 API（Android/iOS 4.33+，鸿蒙 4.61+ 走系统 Share Kit），
      // 无需 manifest 配置分享模块、也无需重打自定义基座。
      // Android 分享到微信时链接以纯文本呈现（微信会自动识别 URL），iOS 可生成链接卡片。
      uni.shareWithSystem({
        type: "text",
        summary: getShareTitle(),
        href: previewUrlValue,
        fail: (res: ShareWithSystemFail) => {
          // 1310600 = 用户主动取消分享，静默返回
          if (res.errCode == 1310600) return;
          // 系统分享不可用（面板唤起失败等）→ 兜底复制链接到剪贴板
          console.warn("[FilePreview] shareWithSystem failed:", res);
          copyShareLinkToClipboard(previewUrlValue, t("Mobile.FilePreview.shareFallbackCopied"));
        },
        // 面板关闭（送出/取消/失败均触发 complete）后解除连点守卫
        complete: (_res: any) => {
          isSharing = false;
        },
      });
      // #endif

      // #ifndef APP
      // H5/WEB：无系统分享面板，保持复制链接到剪贴板
      copyShareLinkToClipboard(previewUrlValue, t("Mobile.FilePreview.shareSuccess"));
      isSharing = false;
      // #endif
    } catch (error) {
      // shareKey 请求失败等异常：解除守卫，允许用户重试
      isSharing = false;
      console.error("分享失败:", error);
      uni.showToast({
        title: t("Mobile.FilePreview.shareFailed"),
        icon: "none",
        duration: 2000,
      });
    }
  };

  // #ifdef APP
  // 分享到微信：uni.share 图文卡片，聊天场景
  const handleShareToWechat = async (): Promise<void> => {
    closeShareSheet();
    try {
      const previewUrlValue = await getShareUrl();
      const shareTitle = getShareTitle();
      uni.share({
        provider: "weixin",
        scene: "WXSceneSession",
        type: 0,
        title: shareTitle,
        summary: shareTitle,
        href: previewUrlValue,
        imageUrl: "/static/logo.png",
        success: (_res: ShareSuccess) => {
          uni.showToast({
            title: t("Mobile.FilePreview.shareWechatSuccess"),
            icon: "none",
            duration: 2000,
          });
        },
        fail: (err: ShareFail) => {
          console.error("微信分享失败:", err);
          uni.showToast({
            title: t("Mobile.FilePreview.shareFailed"),
            icon: "none",
            duration: 2000,
          });
        },
      });
    } catch (error) {
      console.error("微信分享失败:", error);
      uni.showToast({
        title: t("Mobile.FilePreview.shareFailed"),
        icon: "none",
        duration: 2000,
      });
    }
  };
  // #endif

  // 获取 ticket
  const getTicket = async (): Promise<string> => {
    try {
      const res = await apiUserTicketCreate();
      const code = res.code;
      const data = res.data;
      if (code != SUCCESS_CODE || data == null) {
        console.warn(`[FilePreview] apiUserTicketCreate failed: code=${code}`);
        return "";
      }
      return `${data}`;
    } catch (e) {
      console.warn("[FilePreview] apiUserTicketCreate error:", e);
      return "";
    }
  };

  // 设置 html 文件标题
  const setHtmlTitle = (url: string) => {
    uni.request({
      url: url,
      method: "GET",
      success: (res) => {
        // #ifdef H5 || WEB
        const data = res.data;
        const html = data as string;
        const title = extractTitleFromHtml(html);
        if (title != null && title.length > 0) {
          pageTitle.value = title;
          uni.setNavigationBarTitle({
            title: title,
          });
        }
        // #endif
      },
      fail: (err) => {
        console.error("获取 html 失败", err);
      },
    });
  };

  // 从 html 中提取 <title> 内容（H5/WEB 专用）
  // #ifdef H5 || WEB
  function extractTitleFromHtml(html: string): string {
    const startTag = "<title";
    const startIdx = html.toLowerCase().indexOf(startTag);
    if (startIdx < 0) {
      return "";
    }
    const closeStart = html.indexOf(">", startIdx);
    if (closeStart < 0) {
      return "";
    }
    const endTag = "</title>";
    const endIdx = html.toLowerCase().indexOf(endTag, closeStart + 1);
    if (endIdx < 0) {
      return "";
    }
    const raw = html.substring(closeStart + 1, endIdx);
    return raw.trim();
  }
  // #endif

  async function runOnLoad(options: any): Promise<void> {
    const opts = options as UTSJSONObject;
    const cId = opts["cId"] as string;
    const fileProxyUrlValue = opts["fileProxyUrl"] as string;

    if (cId == null || cId.length == 0 || fileProxyUrlValue == null || fileProxyUrlValue.length == 0) {
      uni.showToast({
        title: t("Mobile.FilePreview.invalidParams"),
        icon: "none",
      });
      isLoading.value = false;
      return;
    }

    const decodedUrl = decodeURIComponent(fileProxyUrlValue);
    if (decodedUrl == null) {
      uni.showToast({
        title: t("Mobile.FilePreview.invalidParams"),
        icon: "none",
      });
      isLoading.value = false;
      return;
    }

    const urlInfo = parseUrlInfo(decodedUrl as string);
    const path = urlInfo.path;
    const query = urlInfo.query;

    fileProxyUrl.value = path;

    // 得到文件名
    const fileNameValue = getFileName(path);
    conversationId.value = cId;
    fileName.value = fileNameValue;

    uni.setNavigationBarTitle({ title: fileNameValue });

    // 得到文件类型
    const parts = fileNameValue.split(".");
    const fileTypeValue = parts.length > 0 ? parts[parts.length - 1] : "";
    fileType.value = fileTypeValue;
    try {
      const skValue = query["sk"];
      if (skValue != null && skValue.length > 0) {
        // 有 sk 参数，直接使用
        sk.value = skValue;
        previewUrl.value = `${baseUrl}/static/file-preview.html?sk=${skValue}`;
        // 设置 html 文件标题
        setHtmlTitle(baseUrl + fileProxyUrl.value + "?sk=" + skValue);
      } else {
        // 没有 sk 参数，需要获取 shareKey 和 _ticket
        // 1. 获取 shareKey 用于后续分享功能
        let shareKey = await getConversationShareKey(cId, path);
        sk.value = shareKey;
        // 服务端 _ticket 分支要求 fileUrl 为「完整绝对 URL」；网关页 getQueryParams 仅单次 decode。
        // 故先拼绝对地址，再只对值做一次 encodeURIComponent（不要在 baseUrl 之后二次编码）。
        const fileUrl = encodeURIComponent(`${baseUrl}${fileProxyUrl.value}`);

        // H5 / App / 小程序会话内预览统一走 _ticket（isChat=true，OpenUI 可提交）。
        // _sk 用于下载；ticket 失败时回退顶层 sk（分享只读，表单不可回写会话）。
        const _ticket = await getTicket();
        if (_ticket.length > 0) {
          previewUrl.value = `${baseUrl}/static/file-preview.html?fileUrl=${fileUrl}&_ticket=${_ticket}&_sk=${shareKey}`;
        } else {
          // ticket 签发失败（如 /api/user/ticket/create 返回 0001）→ 统一回退顶层 ?sk=。
          // 网关 startPreview 只在 _ticket 分支才读 params.fileUrl（file-preview.js:351）；
          // fileUrl+_sk 无对应分支，且 _sk 仅用于 _ticket 分支的下载地址、不参与访问校验 →
          // 走 fileUrl+_sk 网关会报 "File URL not provided"。顶层 sk 经 /share/detail/{sk}
          // 校验访问并定位资源，是渲染的前提，故 OpenUI/非 OpenUI 一律用 sk。
          // 但 sk 也是分享链接用的参数，单凭 sk 网关/后端无法区分「会话内预览」与「外部分享」，
          // 故额外带 mode=preview 打标预览态。分享按钮（handleShare / 微信 onShareAppMessage）
          // 独立拼 ?sk=、不读 previewUrl，天然不带此标记（_ticket 主分支自带 _ticket，亦无需此标记）。
          // 代价：sk 为分享只读态，OpenUI 表单不能提交回会话（isChat=!!_ticket=false）；
          // 待后端修复 ticket 接口、能拿到 _ticket 后自动恢复可提交的 _ticket 主分支。
          console.warn(`[FilePreview] ticket empty, fallback to sk share preview. cId=${cId}`);
          previewUrl.value = `${baseUrl}/static/file-preview.html?sk=${shareKey}&mode=preview`;
        }
        // #ifdef MP-WEIXIN || APP
        // 设置 html 文件标题
        setHtmlTitle(baseUrl + fileProxyUrl.value + "?sk=" + shareKey);
        // #endif
      }
    } catch (error) {
      console.error("构建预览URL失败:", error);
    } finally {
      isLoading.value = false;
    }
  }

  /**
   * 处理已解析的 OpenUI action：校验契约与 artifact → 构建续作消息 → 暂存并返回会话页。
   * App/小程序走 web-view @message；H5 走 iframe parent postMessage，共用本函数。
   */
  const handleOpenUiAction = (action: UTSJSONObject): void => {
    if (hasHandledOpenUiAction) return;
    if (
      `${action["type"]}` != "nuwax.openui-action" ||
      `${action["schemaVersion"]}` != "nuwax.openui-action/v1"
    ) {
      return;
    }
    const expectedArtifactId = extractOpenUiArtifactIdFromText(
      fileProxyUrl.value,
    );
    if (
      expectedArtifactId.length > 0 &&
      (`${action["artifactId"]}` != expectedArtifactId ||
        `${action["artifactPath"]}` !=
          `data/${expectedArtifactId}.openui.json`)
    ) {
      return;
    }
    const cIdStr = conversationId.value;
    if (cIdStr == null) return;
    const cid = parseInt(cIdStr, 10);
    if (!(cid > 0)) return;
    const message = buildOpenUiResumeMessage(
      action,
      fileName.value.length > 0 ? fileName.value : "OpenUI",
    );
    if (message.trim().length == 0) return;
    hasHandledOpenUiAction = true;
    savePendingOpenUiAction(cid, message);
    // storage 为同步写入；返回会话页后 onShow 消费并复用 ask-question 同款发送入口。
    uni.navigateBack({ delta: 1 });
  };

  // <web-view> @message：收到 OpenUI 表单提交（OPENUI_ACTION）→ 构建续作消息并按 cId 暂存。
  const onWebViewMessage = (e: UniWebViewMessageEvent): void => {
    // UniWebViewMessageEvent 是原生强类型对象，Android 上不可整体强转 UTSJSONObject；
    // 直接读取其公开字段，再交给跨平台解析器处理消息数组。
    const action = parseOpenUiActionData(e.detail.data);
    if (action == null) return;
    handleOpenUiAction(action);
  };

  // #ifdef H5 || WEB
  /**
   * H5 iframe：file-preview-openui.js 经 notifyParent → window.parent.postMessage
   * 投递 { type: 'OPENUI_ACTION', event }，与 App web-view 桥接语义对齐。
   */
  const onH5OpenUiMessage = (event: any): void => {
    try {
      // H5 MessageEvent：与 uni-ai-x proxy-web 相同，直接读 event.data / event.origin
      if (event == null || event.data == null) return;
      const origin = event.origin != null ? `${event.origin}` : "";
      // 限制来源为本站预览网关（dev 下 baseUrl=API；prod 下为 location.origin）
      if (
        origin.length > 0 &&
        baseUrl.length > 0 &&
        origin.indexOf(baseUrl) != 0 &&
        origin != window.location.origin
      ) {
        return;
      }
      const action = parseOpenUiActionData(event.data);
      if (action == null) return;
      handleOpenUiAction(action);
    } catch (_e) {
      // ignore malformed postMessage
    }
  };

  onMounted(() => {
    window.addEventListener("message", onH5OpenUiMessage);
  });

  onUnmounted(() => {
    window.removeEventListener("message", onH5OpenUiMessage);
  });
  // #endif

  onLoad((options: any) => {
    runOnLoad(options);
  });

  // #ifdef MP-WEIXIN
  // 转发给朋友
  // 分享到首页，由首页自动跳转到文件预览页面，解决分享后无返回按钮问题
  onShareAppMessage(() => {
    return {
      title: getShareTitle(),
      path:
        "/pages/index/index?cId=" +
        conversationId.value +
        "&fileProxyUrl=" +
        encodeURIComponent(`${fileProxyUrl.value}?sk=${sk.value}`),
    };
  });

  // 收藏
  onAddToFavorites(() => {
    return {
      title: getShareTitle(),
      path:
        "/pages/index/index?cId=" +
        conversationId.value +
        "&fileProxyUrl=" +
        encodeURIComponent(`${fileProxyUrl.value}?sk=${sk.value}`),
    };
  });
  // #endif
</script>

<style scoped lang="scss">
  .container {
    height: 100%;
    display: flex;
    flex-direction: column;

    .file-preview-content {
      flex: 1;
      overflow: hidden;
    }

    /* 分享底部面板 */
    .share-sheet {
      width: 100%;
      flex: 1;
      min-height: 0;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      padding: 28rpx 0 24rpx;

      .share-sheet-title {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 30rpx 24rpx;

        .share-sheet-title-text {
          font-size: 28rpx;
          color: rgba(0, 0, 0, 0.45);
        }
      }

      .share-sheet-options {
        width: 100%;
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        justify-content: center;
        padding: 8rpx 0 24rpx;

        .share-sheet-option {
          width: 200rpx;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;

          .share-option-icon {
            width: 96rpx;
            height: 96rpx;
            border-radius: 24rpx;
            display: flex;
            align-items: center;
