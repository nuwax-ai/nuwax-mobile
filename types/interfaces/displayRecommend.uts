/**
 * 首页/对话框推荐位信息（对齐 PC types/interfaces/displayRecommend.ts）
 * 数据源：GET /api/display/recommend/list → data.recChatBoxNav.Agent
 */
export class DisplayRecommendInfo {
  id: number = 0;
  targetType: string = "";
  targetId: number = 0;
  /** 功能类型：AgentDev/PageAppDev/SkillDev/PluginDev/UserAppDev/NormalProjectDev/Chat；空 = 未配置 */
  functionType: string = "";
  label: string = "";
  icon: string = "";
  placeholder: string = "";
  /** 所属分类 key（对应 ChatBox 分类 pill）；空归入第一个分类 */
  category: string = "";
  sort: number = 0;
}

/** 推荐位功能类型 → 项目类型映射键（对齐 PC DisplayRecommendFunctionTypeEnum） */
export function getProjectTypeByFunctionType(functionType: string): string {
  if (functionType == "AgentDev") return "Agent";
  if (functionType == "PageAppDev") return "PageApp";
  if (functionType == "SkillDev") return "Skill";
  if (functionType == "PluginDev") return "Plugin";
  if (functionType == "UserAppDev") return "UserApp";
  if (functionType == "NormalProjectDev") return "NormalProject";
  return "";
}

/** 选中项目类推荐时按任务智能体形态生效（对齐 PC TASK_AGENT_FUNCTION_TYPES） */
export function isTaskAgentFunctionType(functionType: string): boolean {
  return functionType == "AgentDev"
    || functionType == "SkillDev"
    || functionType == "PluginDev"
    || functionType == "UserAppDev"
    || functionType == "NormalProjectDev";
}

/** 需要展示空间选择器的功能类型（对齐 PC SPACE_SELECTOR_FUNCTION_TYPES） */
export function showSpaceSelectorForFunctionType(functionType: string): boolean {
  return functionType == "AgentDev"
    || functionType == "PageAppDev"
    || functionType == "SkillDev"
    || functionType == "PluginDev"
    || functionType == "UserAppDev"
    || functionType == "NormalProjectDev";
}

/** 首页项目上框信息（对齐 PC PinnedProjectInfo；抽屉「＋新建会话」→ 首页 pin） */
export class PinnedProjectInfo {
  /** 项目 ID（UserApp/NormalProject 即 app_id） */
  projectId: number = 0;
  /** 项目类型（UserApp=全栈 / NormalProject=常规；PageApp 不上框） */
  projectType: string = "";
  /** 项目名称（上框 chip 展示） */
  name: string = "";
  /** 项目图标（可能为空） */
  icon: string = "";
  /** 项目沙箱 ID（会话创建优先携带；云端项目为哨兵 -1） */
  sandboxId: number = -1;
  /** 项目绑定的调试智能体 ID（全栈默认命中用；缺失走类型兜底/手选） */
  devAgentId: number = 0;
}

/** 项目类型 → 允许的推荐位功能类型（上框期间只能切换同类型智能体；对齐 PC） */
function getAllowedFunctionType(projectType: string): string {
  if (projectType == "UserApp") return "UserAppDev";
  if (projectType == "NormalProject") return "NormalProjectDev";
  return "";
}

/**
 * 上框期间单项推荐是否可选（对齐 PC isAgentSelectable）：
 * 无上框（projectType 空）= 全量可选；有上框 = 仅同类型可选，其余置灰。
 */
export function isRecommendSelectable(functionType: string, projectType: string): boolean {
  const allowed = getAllowedFunctionType(projectType);
  return allowed.length == 0 || functionType == allowed;
}

/** 上框默认命中：仅全栈且带 devAgentId 时按 targetId 精确命中（对齐 PC findDefaultAgent） */
export function findDefaultAgent(list: DisplayRecommendInfo[], projectType: string, devAgentId: number): DisplayRecommendInfo | null {
  if (projectType != "UserApp" || devAgentId <= 0) return null;
  for (let i = 0; i < list.length; i++) {
    if (list[i].targetId == devAgentId) return list[i];
  }
  return null;
}

/** 类型兜底命中：同类型推荐唯一时自动选中（多个无法猜测 → null 手选，对齐 PC findTypeFallbackAgent） */
export function findTypeFallbackAgent(list: DisplayRecommendInfo[], projectType: string): DisplayRecommendInfo | null {
  const allowed = getAllowedFunctionType(projectType);
  if (allowed.length == 0) return null;
  let matched: DisplayRecommendInfo | null = null;
  let count = 0;
  for (let i = 0; i < list.length; i++) {
    if (list[i].functionType == allowed) {
      matched = list[i];
      count++;
    }
  }
  return count == 1 ? matched : null;
}

/** 项目类型 × 个人电脑/自定义目录能力（对齐 PC getWorkspaceDirPolicy；UserApp/PageApp 仅云端） */
export class WorkspaceDirPolicy {
  personalComputer: boolean = true;
  customDir: boolean = true;
}

export function getWorkspaceDirPolicy(projectType: string): WorkspaceDirPolicy {
  const policy = new WorkspaceDirPolicy();
  if (projectType == "UserApp" || projectType == "PageApp") {
    policy.personalComputer = false;
    policy.customDir = false;
  }
  return policy;
}

/** 自定义工作目录仅个人电脑沙箱生效（云电脑/未选电脑不带；对齐 PC resolvePersonalWorkspacePath） */
export function resolvePersonalWorkspacePath(computerId: string, workspacePath: string): string {
  if (computerId.length > 0 && computerId != "-1" && workspacePath.length > 0) {
    return workspacePath;
  }
  return "";
}
