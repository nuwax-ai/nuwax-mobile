/** ESP-IDF Unified/Network Provisioning 客户端枚举。 */

/** 与乐鑫客户端 SecurityType 对齐。生产环境禁止使用 SECURITY_0。 */
export enum EspProvisioningSecurityEnum {
  SECURITY_0 = 0,
  SECURITY_1 = 1,
  SECURITY_2 = 2,
}

/** APP 侧可观察的安全配网阶段。 */
export enum EspProvisioningPhaseEnum {
  IDLE = 'IDLE',
  SCANNING = 'SCANNING',
  CONNECTING = 'CONNECTING',
  DISCOVERING = 'DISCOVERING',
  ESTABLISHING_SESSION = 'ESTABLISHING_SESSION',
  READING_DEVICE_INFO = 'READING_DEVICE_INFO',
  READY = 'READY',
  SENDING_CREDENTIALS = 'SENDING_CREDENTIALS',
  APPLYING_CONFIG = 'APPLYING_CONFIG',
  CHECKING_STATUS = 'CHECKING_STATUS',
  /** WiFi 配网成功后：绑定 App 账号并向设备下发 vox-config（deviceSecret + gatewayUrl） */
  BINDING_DEVICE = 'BINDING_DEVICE',
  SUCCESS = 'SUCCESS',
  FAILED = 'FAILED',
}

/** 统一错误码；平台原始错误放入 EspProvisioningError.detail。 */
export enum EspProvisioningErrorCodeEnum {
  BLUETOOTH_OFF = 'BLUETOOTH_OFF',
  NO_PERMISSION = 'NO_PERMISSION',
  SCAN_FAILED = 'SCAN_FAILED',
  DEVICE_NOT_FOUND = 'DEVICE_NOT_FOUND',
  CONNECT_FAILED = 'CONNECT_FAILED',
  DISCONNECTED = 'DISCONNECTED',
  SERVICE_MISMATCH = 'SERVICE_MISMATCH',
  SECURITY_MISMATCH = 'SECURITY_MISMATCH',
  INVALID_POP = 'INVALID_POP',
  SECURITY_AUTH_FAILED = 'SECURITY_AUTH_FAILED',
  SESSION_FAILED = 'SESSION_FAILED',
  SEND_CONFIG_FAILED = 'SEND_CONFIG_FAILED',
  APPLY_CONFIG_FAILED = 'APPLY_CONFIG_FAILED',
  AUTH_FAILED = 'AUTH_FAILED',
  WIFI_AUTH_FAILED = 'WIFI_AUTH_FAILED',
  NETWORK_NOT_FOUND = 'NETWORK_NOT_FOUND',
  STATUS_TIMEOUT = 'STATUS_TIMEOUT',
  PROVISIONING_WINDOW_EXPIRED = 'PROVISIONING_WINDOW_EXPIRED',
  /** Security 2 后 device-info.serialNumber 与 QR username 不一致，禁止下发凭据 */
  DEVICE_ID_MISMATCH = 'DEVICE_ID_MISMATCH',
  /** 另一 BLE 操作占用，串行重试 */
  BUSY = 'BUSY',
  /** vox-config 字段或设备身份非法，设备拒绝动态云配置 */
  VOX_CONFIG_INVALID = 'VOX_CONFIG_INVALID',
  /** vox-config 动态配置无法写入设备 NVS */
  VOX_CONFIG_PERSIST_FAILED = 'VOX_CONFIG_PERSIST_FAILED',
  UNSUPPORTED = 'UNSUPPORTED',
  UNKNOWN = 'UNKNOWN',
}
