/**
 * TTS 语音合成服务：文本 → 音频地址
 * 接口未最终确定：voiceConfig.ttsMock = true 时走 mock 流程（见 voiceConfig.uts）
 */
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { voiceConfig, VoiceConfig } from "./voiceConfig";
import { AudioQueueItem } from "./voiceTypes";
import { synthesizeSpeechToSrc } from "./ttsWebSocketPlayer";

export class TtsService {
  private config: VoiceConfig;

  constructor(config: VoiceConfig | null = null) {
    this.config = config != null ? config! : voiceConfig;
  }

  /**
   * 合成单句文本
   * @returns AudioQueueItem（失败时 src 为空，播放器会自动跳过该句）
   */
  async synthesize(text: string, messageId: string, segmentIndex: number): Promise<AudioQueueItem> {
    const item = new AudioQueueItem();
    item.messageId = messageId;
    item.segmentIndex = segmentIndex;
    item.text = text;

    if (text.trim().length == 0) {
      return item;
    }

    if (this.config.ttsMock) {
      // mock 模式：返回配置的测试音频地址（为空则播放器跳过，仅跑通流程）
      item.src = this.config.mockAudioUrl;
      return item;
    }

    try {
      // 优先走与工具栏一致的 TTS WebSocket，产出可播放 wav src
      item.src = await synthesizeSpeechToSrc(text);
    } catch (e: any) {
      console.warn("[TtsService] synthesize via ws failed, fallback http", e);
      try {
        const audioUrl = await this.requestTts(text);
        item.src = audioUrl;
      } catch (e2: any) {
        console.warn("[TtsService] synthesize failed", e2);
      }
    }
    return item;
  }

  /** 请求 TTS 接口，返回音频 URL */
  private async requestTts(text: string): Promise<string> {
    return new Promise<string>((resolve, reject) => {
      const accessToken = uni.getStorageSync(ACCESS_TOKEN);
      const header = {} as UTSJSONObject;
      header["Content-Type"] = "application/json";
      if (accessToken != null && `${accessToken}` != "") {
        header["Authorization"] = `Bearer ${accessToken}`;
      }
      const body = {} as UTSJSONObject;
      body["text"] = text;
      body["voice"] = this.config.ttsVoice;
      body["format"] = this.config.ttsFormat;
      body["speed"] = this.config.ttsSpeed;

      uni.request<UTSJSONObject>({
        url: this.config.ttsUrl,
        method: "POST",
        header: header,
        data: body as any,
        timeout: this.config.ttsTimeout,
        success: (res) => {
          try {
            const data = res.data;
            if (data == null) {
              reject(new Error("TTS 响应为空"));
              return;
            }
            const code = data["code"];
            if (code == SUCCESS_CODE) {
              const dataObj = data["data"] as UTSJSONObject | null;
              const audioUrl = dataObj != null ? dataObj!["audioUrl"] : null;
              if (audioUrl != null && `${audioUrl}`.length > 0) {
                resolve(`${audioUrl}`);
              } else {
                reject(new Error("TTS 响应缺少 audioUrl"));
              }
            } else {
              reject(new Error(`TTS 请求失败: ${code}`));
            }
          } catch (e: any) {
            reject(new Error("TTS 响应解析失败"));
          }
        },
        fail: (err) => {
          const errMsg = err.errMsg != null ? err.errMsg! : "TTS 网络请求失败";
          reject(new Error(errMsg));
        },
      });
    });
  }
}

/** 全局 TTS 服务单例 */
export const ttsService = new TtsService();
