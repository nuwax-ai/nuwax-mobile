<template>
  <!--
    V2 轨迹紧凑工具事件行（H5/MP-WEIXIN 专用，仅在 ai-msg H5 分支挂载）。
    一行表达：类型图标 + 动作短语 + 目标摘要 + 局部状态；详情走全屏弹窗
    （uni.$emit("page_preview_detail")，与 mp-html container.vue 同通道）。
  -->
  <view class="tool-trace-row" :class="{ 'is-failed': isFailed }" @tap="onTapRow">
    <text class="iconfont tool-trace-row__kind-icon" :class="kindIconClass" />
    <text class="tool-trace-row__action">{{ actionText }}</text>
    <!-- 文件类动作：灰徽标 + 文件名链（对齐 PC FileResourceLink inline）；多文件先显计数 -->
    <template v-if="fileBadgeViews.length > 0">
      <text v-if="fileBadgeViews.length > 1" class="tool-trace-row__target">{{
        targetText
      }}</text>
      <view class="tool-trace-row__file-links">
        <view
          v-for="(fileView, fileIndex) in fileBadgeViews"
          :key="fileIndex"
          class="tool-file-link"
        >
          <text class="tool-file-badge">{{ fileView.label }}</text>
          <text class="tool-file-name">{{ fileView.name }}</text>
        </view>
      </view>
    </template>
    <text v-else-if="targetText.length > 0" class="tool-trace-row__target">{{
      targetText
    }}</text>
    <text v-if="row.meta.length > 0" class="tool-trace-row__meta">{{
      row.meta
    }}</text>
    <view v-if="isRunning" class="tool-trace-row__status">
      <text class="iconfont icon-Loader tool-trace-row__spinner" />
    </view>
    <text
      v-else-if="isFailed"
      class="iconfont icon-waring tool-trace-row__failed-icon"
    />
    <view
      v-if="isPageType"
      class="tool-trace-row__page-action"
      @tap.stop.prevent="openPreviewPage"
    >
      <text class="iconfont icon-eye-open" />
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    toolTraceActionI18nKey,
    type TraceToolRow,
  } from "@/subpackages/components/ai-msg/conversationTrace.uts";
  import {
    buildFileBadgeViews,
    type ToolFileBadgeView,
  } from "@/subpackages/components/work-trace/toolFilePresentation.uts";
  import { useI18n, toI18nParams } from "@/utils/i18n";
  import {
    getFileProxyUrlByConversationIdAndFilePath,
    jumpToFilePreviewPage,
  } from "@/utils/system.uts";
  import { getCurrentPageParams } from "@/utils/common";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, undefined, "");

  const props = withDefaults(
    defineProps<{
      /** 投影产出的工具行数据。 */
      row?: TraceToolRow | null;
    }>(),
    {
      row: null,
    },
  );

  const isRunning = computed((): boolean => props.row != null && props.row!.status == "running");
  const isFailed = computed((): boolean => props.row != null && props.row!.status == "failed");

  const kindIconClass = computed((): string => {
    const row = props.row;
    const kind = row == null ? "generic" : row!.kind;
    if (kind == "terminal") return "icon-keyboard";
    if (kind == "file-read") return "icon-a-Filetext";
    if (kind == "file-edit") return "icon-Edit";
    if (kind == "search") return "icon-Search";
    if (kind == "browser") return "icon-Globe";
    if (kind == "skill") return "icon-skill";
    if (kind == "todo") return "icon-task";
    return "icon-wrench";
  });

  const actionText = computed((): string => {
    const row = props.row;
    if (row == null) return "";
    return t(toolTraceActionI18nKey(row!.kind, row!.status, row!.isCreate));
  });

  /** 多文件编辑显示「N 个文件」，其余显示行目标摘要。 */
  const targetText = computed((): string => {
    const row = props.row;
    if (row == null) return "";
    if (row!.kind == "file-edit" && row!.fileCount > 1) {
      const params = new Map<string, string | number>();
      params.set("count", row!.fileCount);
      return tFn(
        "Mobile.Chat.WorkTrace.toolTargetFiles",
        toI18nParams(params),
        "",
      );
    }
    return row!.target;
  });

  /** 文件徽标链视图（预计算，避免模板函数每帧重算）；非文件类动作为空走原 target。 */
  const fileBadgeViews = computed((): ToolFileBadgeView[] => {
    const row = props.row;
    if (row == null) return [] as ToolFileBadgeView[];
    const files = row!.files;
    if (files == null || files.length == 0) {
      return [] as ToolFileBadgeView[];
    }
    return buildFileBadgeViews(files);
  });

  const isPageType = computed((): boolean => {
    const row = props.row;
    return row != null && row!.componentType == "Page";
  });

  /** 详情弹窗载荷：processing 优先，兜底标签合成（对齐 container.vue getRenderData 形态）。 */
  function resolveToolCallPayload(): any | null {
    const row = props.row;
    if (row == null) return null;
    if (row!.processing != null) {
      return row!.processing;
    }
    const fallback = new UTSJSONObject();
    fallback["executeId"] = row!.id;
    fallback["type"] = row!.componentType;
    fallback["status"] = row!.status == "running"
      ? "EXECUTING"
      : row!.status == "failed"
        ? "FAILED"
        : "FINISHED";
    fallback["name"] = row!.name;
    return fallback;
  }

  function openPreviewPage(): void {
    const payload = resolveToolCallPayload();
    if (payload != null) {
      uni.$emit("page_preview_executing", payload);
    }
  }

  function onTapRow(): void {
    const row = props.row;
    if (row == null) return;
    const payload = resolveToolCallPayload();
    if (payload == null) return;
    const result = (payload as UTSJSONObject)["result"];
    const resultObj = result == null || typeof result != "object"
      ? null
      : result as UTSJSONObject;

    // 文件编辑：优先跳文件预览（对齐 container.vue toggleExpanded 对 kind=edit 的行为）
    if (resultObj != null && resultObj["kind"] == "edit") {
      jumpToEditedFilePreview(resultObj);
      return;
    }

    if (resultObj == null) {
      uni.showToast({
        icon: "none",
        title: t("Mobile.ThirdParty.MpHtml.emptyResult"),
      });
      return;
    }

    const input = resultObj["input"];
    const data = resultObj["data"];
    const detailData = new UTSJSONObject();
    detailData["params"] = input != null && typeof input == "object"
      ? input
      : new UTSJSONObject();
    detailData["response"] = data != null ? data : null;
    uni.$emit("page_preview_detail", payload, detailData);
  }

  function jumpToEditedFilePreview(resultObj: UTSJSONObject): void {
    const input = resultObj["input"];
    const filePath = input != null && typeof input == "object"
      ? `${(input as UTSJSONObject)["file_path"] ?? ""}`
      : "";
    if (filePath.length == 0) {
      uni.showToast({
        icon: "none",
        title: t("Mobile.ThirdParty.MpHtml.emptyResult"),
      });
      return;
    }
    const params = getCurrentPageParams();
    const conversationId = params == null
      ? ""
      : `${(params as UTSJSONObject)["conversationId"] ?? ""}`;
    getFileProxyUrlByConversationIdAndFilePath(
      conversationId,
      filePath,
    ).then((fileProxyUrl: string): void => {
      jumpToFilePreviewPage(conversationId, fileProxyUrl);
    });
  }
</script>

<style lang="scss" scoped>
  .tool-trace-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10rpx;
    min-height: 60rpx;
    padding: 6rpx 4rpx;

    &.is-failed {
      .tool-trace-row__action,
      .tool-trace-row__target {
        color: #cf222e;
      }
    }

    &__kind-icon {
      flex-shrink: 0;
      font-size: 26rpx;
      color: #8b8e96;
      line-height: 34rpx;
    }

    &__action {
      flex-shrink: 0;
      font-size: 26rpx;
      color: #33363d;
      line-height: 38rpx;
    }

    &__target {
      flex: 1;
      min-width: 0;
      font-size: 24rpx;
      color: #8b8e96;
      line-height: 34rpx;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;
    }

    &__meta {
      flex-shrink: 0;
      font-size: 22rpx;
      line-height: 30rpx;
      color: #1a7f37;
      font-weight: 600;
      font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;
    }

    &__status {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32rpx;
      height: 32rpx;
    }

    &__spinner {
      font-size: 26rpx;
      color: #1890ff;
      animation: tool-trace-spin 1s linear infinite;
    }

    &__failed-icon {
      flex-shrink: 0;
      font-size: 26rpx;
      color: #ffcb00;
      line-height: 34rpx;
    }

    &__page-action {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44rpx;
      height: 44rpx;

      .iconfont {
        font-size: 28rpx;
        color: #8b8e96;
      }
    }

    // ===== 文件路径徽标链（对齐 PC FileResourceLink inline：灰徽标+文件名，不可点）=====
    &__file-links {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      row-gap: 4rpx;
    }
  }

  .tool-file-link {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-right: 12rpx;
    max-width: 100%;
  }

  .tool-file-badge {
    flex-shrink: 0;
    padding: 0 8rpx;
    margin-right: 6rpx;
    border-radius: 6rpx;
    background-color: rgba(28, 31, 40, 0.08);
    color: #6b6e76;
    font-size: 20rpx;
    line-height: 30rpx;
    font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;
    font-weight: 600;
  }

  .tool-file-name {
    min-width: 0;
    font-size: 24rpx;
    color: #8b8e96;
    line-height: 34rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;
  }

  @keyframes tool-trace-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
</style>
