/**
 * 弹层内可靠点按判定（三星 One UI / 鸿蒙系 Android 运行时统一封装）。
 *
 * 背景：page-container 原生弹层内子视图的 click 合成按厂商安卓运行时分化——
 * 三星 One UI 触控灵敏，按压触下瞬间带微移即被原生层判为手势、不合成 click
 * （按钮点了没反应，微移还可能触发原生下滑手势让面板闪动）；鸿蒙系手机
 * touchstart 的 touches 可能为空（坐标只在 changedTouches），且原生下滑/
 * 滚动手势抢占触摸后抬手收到的是 touchcancel 而非 touchend（click 也不再
 * 合成）。
 *
 * 用法：可点视图绑四路事件，判定收敛到本类实例（500ms 防重窗保证 touchend
 * 主通道与随后合成的 click 只生效一次）：
 *
 *   const xxxTap = new ReliableTap(12);  // 位移阈值 px（不设默认参：UTS 陷阱）
 *   @tap="onXxxTap"                       ← H5 桌面/无触摸兜底
 *   @touchstart="onXxxTouchStart($event)"
 *   @touchend="onXxxTouchEnd($event)"     ← 主通道（touchcancel 绑同一 handler）
 *
 *   const onXxxTouchStart = (e: Any): void => { xxxTap.touchStart(e); };
 *   const onXxxTouchEnd = (e: Any): void => { if (xxxTap.touchEnd(e)) doXxx(); };
 *   const onXxxTap = (): void => { if (xxxTap.clickFallback()) doXxx(); };
 */
const TAP_DEDUPE_MS = 500;

export class ReliableTap {
  /** 本轮起点（touchstart 记录；每轮 touchEnd 后清零，防残留旧坐标毒化下一轮）。 */
  startX: number;
  startY: number;
  /** 静点按位移阈值（px）：横滚/下滑关闭手势的位移都超阈值，不会误派发。 */
  slopPx: number;
  /** 上次派发时刻：touchend 与随后合成的 click 经防重窗去重，双通道只生效一次。 */
  lastFireMs: number;

  constructor(slopPx: number) {
    this.startX = 0;
    this.startY = 0;
    this.slopPx = slopPx;
    this.lastFireMs = 0;
  }

  /** 记起点：touches 优先、changedTouches 兜底（鸿蒙系 touches 可能为空）。 */
  touchStart(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    if (e.touches.length > 0) {
      this.startX = e.touches[0].clientX;
      this.startY = e.touches[0].clientY;
      return;
    }
    if (e.changedTouches != null && e.changedTouches.length > 0) {
      this.startX = e.changedTouches[0].clientX;
      this.startY = e.changedTouches[0].clientY;
    }
  }

  /** touchend/touchcancel 共用：静点按（位移 ≤ slop）且出防重窗返回 true（并置窗）。
   *  被手势认领的位移超阈值不派发（按滚动/下滑手势吞掉）。 */
  touchEnd(eventValue: Any): boolean {
    const tap = this.isStaticTap(eventValue);
    this.startX = 0;
    this.startY = 0;
    if (tap) {
      return this.markFiredOnce();
    }
    return false;
  }

  /** click/tap 兜底通道（H5 桌面无触摸；App 上紧随 touchend 的合成 click 由
   *  防重窗吞掉）。 */
  clickFallback(): boolean {
    return this.markFiredOnce();
  }

  /** 清防重窗（弹层重新 open 时调用：上一轮收面板手势的防重态不再吞本轮首点）。 */
  reset(): void {
    this.startX = 0;
    this.startY = 0;
    this.lastFireMs = 0;
  }

  /** 落点位移判定：changedTouches 优先、touches 兜底（与起点互补读取，防单侧
   *  为空的运行时；两侧皆空按非点按处理，起点已清零时位移必超阈值、安全拒绝）。 */
  isStaticTap(eventValue: Any): boolean {
    const e = eventValue as UniTouchEvent;
    if (e.changedTouches != null && e.changedTouches.length > 0) {
      const dx = e.changedTouches[0].clientX - this.startX;
      const dy = e.changedTouches[0].clientY - this.startY;
      return Math.abs(dx) <= this.slopPx && Math.abs(dy) <= this.slopPx;
    }
    if (e.touches.length > 0) {
      const dx = e.touches[0].clientX - this.startX;
      const dy = e.touches[0].clientY - this.startY;
      return Math.abs(dx) <= this.slopPx && Math.abs(dy) <= this.slopPx;
    }
    return false;
  }

  /** 防重窗：500ms 内已派发过返回 false，否则置窗返回 true。 */
  markFiredOnce(): boolean {
    const now = Date.now();
    if (now - this.lastFireMs < TAP_DEDUPE_MS) {
      return false;
    }
    this.lastFireMs = now;
    return true;
  }
}
