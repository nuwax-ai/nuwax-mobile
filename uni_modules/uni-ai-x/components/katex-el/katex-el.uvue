<template>
    <view
        class="katex-el"
        :class="[`ui-theme-${uiTheme}`, inline == true ? 'katex-el-inline' : '']"
        :style="rootStyle"
        @longpress="onLongPress"
    >
        <!-- #ifdef WEB -->
        <view class="katex" v-if="html != null && html.length > 0" v-html="html"></view>
        <!-- #endif -->
        <image
            v-if="href != null && href.length > 0"
            :src="href"
            class="katex-el-katex-image"
            :class="inline == true ? 'katex-el-katex-image-inline' : ''"
            :mode="imageMode"
            :style="imageStyle"
        />
        <!-- #ifdef APP -->
        <!-- App 截图较慢：空白占位；H5 直接吃 resultHtml，无需占位 -->
        <view
            v-if="showPlaceholder == true"
            class="katex-el-placeholder"
            :class="inline == true ? 'katex-el-placeholder-inline' : ''"
            :style="placeholderStyle"
        />
        <!-- #endif -->
    </view>
</template>

<script lang="uts" setup>
    import {uiTheme} from '@/uni_modules/uni-ai-x/sdk'

    const props = defineProps<{
        html?: string
        href?: string
        width?: number
        height?: number
        /** 表格单元格等场景：按内容宽度收缩，避免撑满一行 */
        inline?: boolean
        /**
         * 保持截图原始尺寸（不缩小字号）。
         * 表格内公式用 true：宽度不足时由表格横向滚动，而不是压扁公式。
         */
        preserveSize?: boolean
    }>()

    /** 根 view 上的原生 longpress 向上 emit，供父级（如 <x-math>）做导出/复制。
     *  uvue 自定义组件边界不自动冒泡原生手势，故在此显式转发。 */
    const emit = defineEmits(['longpress'])
    const onLongPress = (): void => {
        emit('longpress')
    }

    /**
     * 行内公式目标高度（约等于正文 15~16px 字号下的 KaTeX 行盒）。
     * 标题等场景若回传物理像素/大画布尺寸，按此高度等比缩小。
     */
    const INLINE_TARGET_HEIGHT = 20
    /** 超过该高度视为异常偏大（物理像素或截到了大容器），需要缩放 */
    const INLINE_OVERSIZE_HEIGHT = 36

    /** App 占位高度：贴近常见单行公式，过大易留白、过小抖动更明显 */
    let appBlockMinHeight = ''
    let appInlineMinHeight = ''
    // #ifdef APP
    appBlockMinHeight = '48rpx'
    appInlineMinHeight = '32rpx'
    // #endif

    // #ifdef APP
    const showPlaceholder = computed((): boolean => {
        const htmlLen = props.html != null ? props.html!.length : 0
        const hrefLen = props.href != null ? props.href!.length : 0
        return htmlLen == 0 && hrefLen == 0
    })

    /** 占位：优先用已知 height（缓存预填），减少出图后高度跳动 */
    const placeholderStyle = computed((): string => {
        const knownH = props.height ?? 0
        if (props.inline == true) {
            if (knownH > 0) {
                return 'width:120rpx;height:' + knownH + 'px;background-color:transparent;'
            }
            return 'width:120rpx;min-height:' + appInlineMinHeight + ';background-color:transparent;'
        }
        if (knownH > 0) {
            return 'width:100%;height:' + knownH + 'px;background-color:transparent;'
        }
        return 'width:100%;min-height:' + appBlockMinHeight + ';background-color:transparent;'
    })
    // #endif

    /** 计算行内公式最终展示宽高（拆成两个 number，规避 UTS 对象字面量限制） */
    function resolveInlineDisplayWidth(): number {
        const rawW = props.width ?? 0
        const rawH = props.height ?? 0
        if (props.preserveSize == true) {
            return rawW > 0 ? rawW : 0
        }
        if (rawW <= 0 || rawH <= 0) {
            return 0
        }
        if (rawH <= INLINE_OVERSIZE_HEIGHT) {
            const maxH = 32
            if (rawH > maxH) {
                return Math.max(8, Math.ceil(rawW * (maxH / rawH)))
            }
            return rawW
        }
        return Math.max(8, Math.ceil(rawW * (INLINE_TARGET_HEIGHT / rawH)))
    }

    function resolveInlineDisplayHeight(): number {
        const rawW = props.width ?? 0
        const rawH = props.height ?? 0
        if (props.preserveSize == true) {
            return rawH > 0 ? rawH : 0
        }
        if (rawW <= 0 || rawH <= 0) {
            return INLINE_TARGET_HEIGHT
        }
        if (rawH <= INLINE_OVERSIZE_HEIGHT) {
            return rawH > 32 ? 32 : rawH
        }
        return INLINE_TARGET_HEIGHT
    }

    /** 块级公式展示高度兜底（width/height 缺失时）。 */
    const BLOCK_MIN_DISPLAY_HEIGHT = 44

    /**
     * 块级公式显示宽度上限（逻辑像素）。nuwax-uni-math 原生后端返回的 width/height 是
     * MathJax SVG viewBox 像素值，单条公式可能宽达数百~上千 px（如 800px），直接当显示
     * 尺寸会把 ~360dp 手机屏撑到不可用。这里按「窗口宽 - 两侧气泡内边距」封顶，高度等比
     * 缩放；位图本身是 dpiScale(2.5x) 高清 rasterize，缩小后依旧清晰。取一次即可（公式
     * 场景不关心旋转后微调）；取不到返回 0 = 不封顶，交由 image 的 max-width:100% 兜底。
     */
    let cachedBlockMaxWidth = -1
    function blockMaxWidth(): number {
        if (cachedBlockMaxWidth >= 0) {
            return cachedBlockMaxWidth
        }
        let w = 0
        // #ifdef APP
        const info = uni.getWindowInfo()
        const ww = info.windowWidth
        if (ww > 0) {
            w = Math.floor(ww) - 32
            if (w < 120) {
                w = 120
            }
        }
        // #endif
        cachedBlockMaxWidth = w
        return w
    }

    /**
     * 块级公式显示高度上限（逻辑像素）。竖向公式（如 \frac{1}{2}，h>w）仅按 width 等比缩放后
     * height 仍可能极大（如 rawH=640 缩到 maxW 后仍 ~500px）→ 撑爆页面。取屏高 40% 封顶，
     * 与 blockMaxWidth 双向取严，保证竖向公式不失控。取不到返回 0 = 不封顶。
     */
    let cachedBlockMaxHeight = -1
    function blockMaxHeight(): number {
        if (cachedBlockMaxHeight >= 0) {
            return cachedBlockMaxHeight
        }
        let h = 0
        // #ifdef APP
        const info = uni.getWindowInfo()
        const wh = info.windowHeight
        if (wh > 0) {
            h = Math.floor(wh * 0.4)
            if (h < 160) {
                h = 160
            }
        }
        // #endif
        cachedBlockMaxHeight = h
        return h
    }

    /**
     * 块级公式等比缩放因子：同时尊重宽度上限和高度上限，取更严（更小）的那个。
     * resolveBlockDisplayWidth / resolveBlockDisplayHeight 共用此因子 → 宽高同比例，
     * aspectFit 不变形。preserveSize（表格单元格）跳过 → 返回 1（原尺寸，外层 scroll-view 横滚）。
     */
    function blockScale(): number {
        const rawW = props.width ?? 0
        const rawH = props.height ?? 0
        if (rawW <= 0 || rawH <= 0) {
            return 1
        }
        if (props.preserveSize == true) {
            return 1
        }
        let scale = 1
        const maxW = blockMaxWidth()
        if (maxW > 0 && rawW > maxW) {
            scale = Math.min(scale, maxW / rawW)
        }
        const maxH = blockMaxHeight()
        if (maxH > 0 && rawH > maxH) {
            scale = Math.min(scale, maxH / rawH)
        }
        return scale
    }

    /** 块级公式最终展示高度：与宽度共用 blockScale 等比缩放（双向封顶，aspectFit 不变形）。
     *  preserveSize（表格单元格等）保持自然尺寸，由外层 scroll-view 横滚，不缩放。 */
    function resolveBlockDisplayHeight(): number {
        const rawH = props.height ?? 0
        if (rawH <= 0) {
            return BLOCK_MIN_DISPLAY_HEIGHT
        }
        const rawW = props.width ?? 0
        if (rawW <= 0 || props.preserveSize == true) {
            return rawH
        }
        return Math.max(1, Math.round(rawH * blockScale()))
    }
    /** 块级公式最终展示宽度：与高度共用 blockScale 等比缩放，双向封顶防撑爆页面。 */
    function resolveBlockDisplayWidth(): number {
        const rawW = props.width ?? 0
        const rawH = props.height ?? 0
        if (rawW <= 0 || rawH <= 0) {
            return 0
        }
        if (props.preserveSize == true) {
            return rawW
        }
        return Math.max(1, Math.round(rawW * blockScale()))
    }

    /** 是否已有可展示的公式图（出图后不再保留占位 min-height） */
    function hasFormulaImage(): boolean {
        return props.href != null && props.href!.length > 0
    }

    const rootStyle = computed((): string => {
        if (props.inline != true) {
            // App：仅占位阶段占高；优先用已知 height，出图后收起避免底部留白
            if (hasFormulaImage() == false) {
                const knownH = props.height ?? 0
                if (knownH > 0) {
                    return (
                        'height:' +
                        knownH +
                        'px;display:flex;flex-direction:column;align-items:center;justify-content:center;'
                    )
                }
                if (appBlockMinHeight.length > 0) {
                    return (
                        'min-height:' +
                        appBlockMinHeight +
                        ';display:flex;flex-direction:column;align-items:center;justify-content:center;'
                    )
                }
            }
            // 块级公式已有图：按内容宽度（width:auto），由外层 scroll-view 负责居中/横滚，不再铺满 100%
            return 'width:auto;'
        }
        const w = resolveInlineDisplayWidth()
        const h = resolveInlineDisplayHeight()
        // 行内：同样只在未出图时用占位高度
        const useAppMin = appInlineMinHeight.length > 0 && hasFormulaImage() == false
        // 表格保持原尺寸：禁止 max-width:100%，否则会在窄单元格里被压扁
        if (props.preserveSize == true) {
            if (w > 0 && h > 0) {
                if (useAppMin == true) {
                    return 'width:' + w + 'px;min-height:' + appInlineMinHeight + ';height:auto;'
                }
                return 'width:' + w + 'px;height:' + h + 'px;'
            }
            if (useAppMin == true) {
                return 'width:auto;min-height:' + appInlineMinHeight + ';'
            }
            return 'width:auto;height:auto;'
        }
        if (w > 0) {
            if (useAppMin == true) {
                return 'width:' + w + 'px;min-height:' + appInlineMinHeight + ';height:auto;max-width:100%;'
            }
            return 'width:' + w + 'px;height:' + h + 'px;max-width:100%;'
        }
        if (useAppMin == true) {
            return 'width:auto;min-height:' + appInlineMinHeight + ';max-width:100%;'
        }
        // H5：有真实 DOM，行内公式高度由 KaTeX 内容自适应，不写死 20px（避免分数等高公式被压/裁）；
        // App：仍需 20px 占位行高防截图前塌陷。
        // #ifdef WEB
        return 'width:auto;height:auto;max-width:100%;'
        // #endif
        // #ifndef WEB
        return 'width:auto;height:' + INLINE_TARGET_HEIGHT + 'px;max-width:100%;'
        // #endif
    })

    const imageStyle = computed((): string => {
        if (props.inline != true) {
            // 块级：按封顶屏宽后的等比尺寸渲染（aspectFit 保比例不变形；max-width:100% 兜底防溢出容器）
            const bw = resolveBlockDisplayWidth()
            const bh = resolveBlockDisplayHeight()
            if (bw > 0) {
                return 'width:' + bw + 'px;height:' + bh + 'px;max-width:100%;'
            }
            return 'width:100%;height:auto;'
        }
        const w = resolveInlineDisplayWidth()
        const h = resolveInlineDisplayHeight()
        if (props.preserveSize == true) {
            if (w > 0 && h > 0) {
                return 'width:' + w + 'px;height:' + h + 'px;'
            }
            return 'width:auto;height:auto;'
        }
        if (w > 0) {
            return 'width:' + w + 'px;height:' + h + 'px;'
        }
        return 'width:auto;height:' + INLINE_TARGET_HEIGHT + 'px;'
    })

    /** image 渲染模式：块级有自然尺寸时 aspectFit（不失真），未知时 widthFix 兜底；行内 aspectFit */
    const imageMode = computed((): string => {
        if (props.inline == true) {
            return 'aspectFit'
        }
        return resolveBlockDisplayWidth() > 0 ? 'aspectFit' : 'widthFix'
    })
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
    // #ifdef WEB
    @import './katex.min.scss';
    // 与会话正文一致：白底 + #404040，不跟随 dark theme
    .katex {
        color: #404040 !important;
        // KaTeX 斜体末字右倾，避免被 overflow 裁掉
        padding-right: 0.35em;
        overflow: visible;
    }
    .katex-html {
        overflow: visible;
    }
    .katex-el-inline .katex {
        font-size: 16px;
        line-height: 1.25;
    }
    /* ---- H5 公式换行修复（仅 WEB，不动 App 截图路径） ---- */
    // 块级公式：恢复 display 不换行（d8896b12 注释掉 nowrap 导致整公式因宽度换行/内部折断）。
    // 注意：.katex-display / .katex-html 是 v-html 注入的 DOM（无 scoped data-v 属性），
    // 必须用 ::v-deep 穿透 scoped 样式才能命中（否则编译成 .katex[data-v-xxx] 匹配失败、nowrap 失效）。
    // 横向滚动由 uni-ai-x-msg 外层 .msg-root-math-scroll（scroll-view）统一负责，
    // 此处 .katex-display 不做 overflow-x（避免双层滚动条/宽度误差），宽度取内容供外层判断超宽。
    .katex-el:not(.katex-el-inline) .katex {
        // 块级 v-html 容器：宽度取公式内容宽，供外层 .msg-root-math-inner（min-width:100%）判断窄居中/宽撑开
        display: block;
        width: max-content;
        max-width: none;
    }
    // v-html 注入内容统一 ::v-deep 穿透
    .katex-el ::v-deep .katex-display {
        // 抹掉 display 自带的 1em 上下外边距（多余空行）；段间距由外层消息项统一负责
        margin: 0;
        // 宽度=公式内容宽（供外层 scroll-view 判断超宽横滚）；不做 overflow-x（外层统一滚）
        display: block;
        width: max-content;
        max-width: none;
        text-align: center;
        /* 移动端块级公式整体缩小：改容器 font-size（KaTeX .katex 以 1.21em 相对缩放），
           不直接改 .katex 的 font-size/line-height，避免破坏公式内部上下标/分数的 em 基准与行高 */
        font-size: 13px;
    }
    .katex-el ::v-deep .katex-display > .katex {
        // 公式不换行（防内部折断）；左对齐供外层横滚时从公式开头看
        display: inline-block;
        text-align: left;
        white-space: nowrap;
    }
    // 行内公式：纠为 inline-block 与文字同行、不内部折断
    .katex-el-inline .katex {
        display: inline-block;
        white-space: nowrap;
    }
    /* H5 行内公式根：inline-flex 嵌入文本流（内部仍 flex 居中），与文字同行不挤断行（对齐 mp-html inline-block 混排） */
    .katex-el-inline {
        display: inline-flex;
        vertical-align: middle;
        width: auto;
    }
    // #endif
    .katex-el {
        width: 100%;
        background-color: #ffffff;
        overflow: visible;
        /* 块级公式：占位/出图后在 min-height 内垂直居中 */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .katex-el-inline {
        width: auto;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        background-color: transparent;
        overflow: visible;
        padding-right: 2px;
        box-sizing: content-box;
        flex-shrink: 0;
    }

    .katex-el-katex-image {
        width: 100%;
        background-color: #ffffff;
    }

    .katex-el-katex-image-inline {
        background-color: transparent;
        flex-shrink: 0;
    }

    /* #ifdef APP */
    .katex-el-placeholder {
        width: 100%;
        min-height: 48rpx;
        background-color: transparent;
    }

    .katex-el-placeholder-inline {
        min-width: 120rpx;
        min-height: 32rpx;
        flex-shrink: 0;
        background-color: transparent;
    }
    /* #endif */
</style>
