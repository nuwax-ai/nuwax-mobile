/**
 * 系统级遮罩活动（相册 / 拍照 / 选文件 / 权限弹窗 / 系统设置）。
 *
 * 这类操作会触发页面 onHide，但不应走「暂停会话轮询 / 长隐藏会话恢复」。
 * ASR/TTS 已按需连接，不再经本模块保活或跳过挂起。
 * 调用约定：在调起系统 UI 之前 begin(reason)，在 complete / 回前台 时 end。
 */
export class PageSystemOverlay {
  private depth: number = 0;
  /** 本轮 hide 因 overlay 被忽略，对应 show 也不跑前后台重逻辑 */
  private ignoredHide: boolean = false;
  /** 无 complete 回调的系统页（如 Android 权限设置）：下一次 show 时清掉 overlay */
  private endOnNextShow: boolean = false;
  /** 最近一次「本轮 hide→show」是否算真实回前台 */
  private lastShowWasReal: boolean = true;
  /** hide 代数：同一轮 hide 的多次 noteShow 只消费一次 */
  private hideGeneration: number = 0;
  private showConsumedGeneration: number = -1;
  /** 已处理过 hide、尚未 show：重复 noteHide 不再 bump generation */
  private hidePending: boolean = false;
  /** 本轮 hidePending 下 noteHide 的返回值（重复调用复用） */
  private lastHideShouldRunBg: boolean = true;

  /**
   * 即将打开系统相册/权限等。
   * @param reason 调用标识（如 chooseImage / recordPermission）
   * @param endOnNextShow 无 complete 回调时传 true，回前台自动 end
   */
  begin(_reason: string = "overlay", endOnNextShow: boolean = false): void {
    this.depth = this.depth + 1;
    if (endOnNextShow == true) {
      this.endOnNextShow = true;
    }
  }

  /** 系统 UI 关闭（chooseImage complete / authorize 结束等） */
  end(): void {
    if (this.depth > 0) {
      this.depth = this.depth - 1;
    }
    if (this.depth == 0) {
      this.endOnNextShow = false;
      // complete 晚于 onShow 时：show 已按 depth>0 跳过，清掉残留 ignoredHide，避免污染下一轮
      if (this.hidePending == false) {
        this.ignoredHide = false;
      }
    }
  }

  isActive(): boolean {
    return this.depth > 0;
  }

  /**
   * 页面 onHide：是否应执行真实「进后台」逻辑。
   * overlay 期间返回 false；同一轮重复 noteHide 幂等。
   */
  noteHide(): boolean {
    if (this.hidePending == true) {
      return this.lastHideShouldRunBg;
    }
    this.hidePending = true;
    this.hideGeneration = this.hideGeneration + 1;
    if (this.depth > 0) {
      this.ignoredHide = true;
      this.lastHideShouldRunBg = false;
      return false;
    }
    this.ignoredHide = false;
    this.lastHideShouldRunBg = true;
    return true;
  }

  /**
   * 页面回前台（任意时长）：是否应执行真实「回前台」重逻辑。
   * 同一轮 hide 的多次调用只判定一次。
   */
  noteShow(): boolean {
    if (this.showConsumedGeneration == this.hideGeneration) {
      return this.lastShowWasReal;
    }
    this.showConsumedGeneration = this.hideGeneration;
    this.hidePending = false;

    if (this.endOnNextShow == true && this.depth > 0) {
      this.depth = 0;
      this.endOnNextShow = false;
      this.ignoredHide = false;
      this.lastShowWasReal = false;
      return false;
    }
    if (this.ignoredHide == true) {
      this.ignoredHide = false;
      this.lastShowWasReal = false;
      return false;
    }
    if (this.depth > 0) {
      // show 已消费本轮 hide；ignored 语义落到 lastShowWasReal，避免 end 晚到时状态粘滞
      this.ignoredHide = false;
      this.lastShowWasReal = false;
      return false;
    }
    this.lastShowWasReal = true;
    return true;
  }

  /** onResume（长隐藏）前调用：是否允许 handleSessionResume */
  wasLastShowReal(): boolean {
    return this.lastShowWasReal;
  }
}

export const pageSystemOverlay = new PageSystemOverlay();
