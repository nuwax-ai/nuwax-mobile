        color: #1a1a1a;
      }

      .add-desc {
        font-size: 24rpx;
        color: #666666;
        margin-top: 4rpx;
      }
    }

    .row-arrow {
      font-size: 40rpx;
      color: #c0c0c0;
      font-weight: 300;
      line-height: 1;
      padding-left: 8rpx;
    }
  }

  /* 产品购买卡 */
  .product-card {
    background-color: #ffffff;
    border-radius: 24rpx;
    margin: 24rpx 24rpx 0;
    padding: 40rpx 32rpx;
