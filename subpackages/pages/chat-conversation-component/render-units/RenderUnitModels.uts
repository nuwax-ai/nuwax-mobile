/** RenderUnit 内容类型。使用字符串而非 enum，避免跨端序列化差异。 */
export type RenderUnitKind =
  "user" | "thinking" | "markdown" | "table" | "code" |
  "formula" | "mermaid" | "image" | "tool" | "toolbar";

export type RenderUnitPosition = "single" | "first" | "middle" | "last";
export type RenderUnitLayoutState =
  "unknown" | "estimated" | "measuring" | "committed" | "dirty";
export type RenderUnitAsyncState = "none" | "pending" | "settled";

/**
 * 高度缓存的有效域。宽度、字体、平台或 renderer 变化后，旧 committedHeight 不可复用。
 */
export class RenderUnitLayoutSignature {
  viewportWidth: number = 0;
  fontScale: number = 1;
  platform: string = "";
  rendererVersion: string = "";
  expandedState: string = "";

  cacheKey(): string {
    return `${this.viewportWidth}|${this.fontScale}|${this.platform}|${this.rendererVersion}|${this.expandedState}`;
  }
}

/** AI 长会话的最小渲染、测高和窗口化单元。 */
export class RenderUnit {
  key: string = "";
  messageId: string = "";
  messageGroupKey: string = "";
  /** 对应消息 markdownElList 下标；非 Markdown 正文 Unit 为 -1。 */
  sourceIndex: number = -1;
  kind: RenderUnitKind = "markdown";
  position: RenderUnitPosition = "single";
  frozen: boolean = false;
  contentVersion: number = 0;
  layoutVersion: number = 0;
  layoutState: RenderUnitLayoutState = "unknown";
  asyncState: RenderUnitAsyncState = "none";
  estimatedHeight: number = 72;
  committedHeight: number = 0;
  layoutSignatureKey: string = "";

  effectiveHeight(): number {
    if (this.layoutState == "committed" && this.committedHeight > 0) {
      return this.committedHeight;
    }
    return Math.max(24, this.estimatedHeight);
  }

  canReuseCommittedHeight(signature: RenderUnitLayoutSignature): boolean {
    return (
      this.layoutState == "committed" &&
      this.committedHeight > 0 &&
      this.layoutSignatureKey == signature.cacheKey()
    );
  }

  invalidateLayout(): void {
    this.layoutVersion = this.layoutVersion + 1;
    this.layoutState = this.committedHeight > 0 ? "dirty" : "estimated";
  }
}

/** 锚点用 Unit key + Unit 内偏移表达，不依赖易变化的数组 index。 */
export class RenderUnitAnchor {
  key: string = "";
  offsetInUnit: number = 0;
}

export class RenderUnitRange {
  start: number = 0;
  end: number = 0;
  topPlaceholder: number = 0;
  bottomPlaceholder: number = 0;
  totalHeight: number = 0;
}

/** 单条消息内部 Markdown Unit 的挂载窗口。 */
export class MessageRenderUnitWindow {
  enabled: boolean = false;
  start: number = 0;
  end: number = 0;
  topPlaceholder: number = 0;
  bottomPlaceholder: number = 0;
  mountedCount: number = 0;
  totalCount: number = 0;
}
