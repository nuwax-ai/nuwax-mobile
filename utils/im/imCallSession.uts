/** App 端 VoIP 会话状态与 WS 路由。 */
import eventBus from "@/utils/eventBus";
import { EVENT_TYPE } from "@/constants/event.constants";
import { apiImMeetingInviteHandled } from "@/servers/imMeeting";
import { isNativeImVoipEnabled } from "@/features/voip/integration";
import { isAppInBackground } from "@/utils/appLifecycle.uts";
import { hideHandledMeetingInviteBanner, showMeetingInviteBanner } from "@/utils/im/meetingInviteBanner";
import { getMyUserIdSync } from "@/utils/imNoticeBar";
// #ifdef APP-HARMONY
import { getNativeMeetingInviteState } from "@/uni_modules/nuwax-voip";
// #endif

export const IM_CALL_CHANGED_EVENT = "im-call-changed";

export class ImCallSession {
  phase: string = "idle";
  direction: string = "";
  callId: string = "";
  msgId: string = "";
  convId: string = "";
  mediaType: string = "audio";
  roomName: string = "";
  peerName: string = "";
  peerAvatar: string = "";
  startedAt: number = 0;
  detail: string = "";
}

let bound = false;
let session = new ImCallSession();
const heard = new Set<string>();
const heardMeetingInvites = new Set<string>();
// #ifdef APP-HARMONY
let pendingHarmonyMeetingInvite: UTSJSONObject | null = null;
let pendingHarmonyMeetingSentAt = 0;
let harmonyMeetingRetryTimer = 0;

function clearPendingHarmonyMeetingInvite(): void {
  pendingHarmonyMeetingInvite = null;
  pendingHarmonyMeetingSentAt = 0;
  if (harmonyMeetingRetryTimer != 0) {
    clearTimeout(harmonyMeetingRetryTimer);
    harmonyMeetingRetryTimer = 0;
  }
}

export function resumeHarmonyMeetingInvite(): void {
  if (isAppInBackground()) return;
  const pending = pendingHarmonyMeetingInvite;
  if (pending == null) return;
  if (!isNativeImVoipEnabled() || Date.now() >= parseFloat(readString(pending, "expiresAt"))) {
    clearPendingHarmonyMeetingInvite();
    return;
  }
  let nativeState = "";
  try { nativeState = getNativeMeetingInviteState(readString(pending, "msgId")); } catch (_error) {}
  if (nativeState == "pending") {
    // 原生可能仍在核实消息。卡片上报失败时，仍有机会在原有效期内显示 WS 备用邀请。
    if (harmonyMeetingRetryTimer == 0) {
      harmonyMeetingRetryTimer = setTimeout(() => {
        harmonyMeetingRetryTimer = 0;
        resumeHarmonyMeetingInvite();
      }, 500);
    }
    return;
  }
  clearPendingHarmonyMeetingInvite();
  if (nativeState != "handled") showMeetingInviteBanner(pending);
}
// #endif

function readString(obj: UTSJSONObject, key: string): string {
  const raw = obj[key];
  return raw == null ? "" : "" + raw;
}

/**
 * 多端去重：A 多处登录时给 B 拨号/发会议邀请，服务端扇出只排除发起端，
 * 会送到 A 的其它设备。发送者＝我且对端不是我自己 ⇒ 是我自己别的设备发出的回声。
 * 自呼（对端＝我）保留响铃；信息不足时保守放行。
 */
export function isIncomingCallForMe(senderId: string, myUserId: string, peerUserId: string): boolean {
  if (senderId.length == 0 || myUserId.length == 0) return true;
  if (senderId != myUserId) return true;
  return peerUserId.length > 0 && peerUserId == myUserId;
}

function copySession(): ImCallSession {
  const out = new ImCallSession();
  out.phase = session.phase;
  out.direction = session.direction;
  out.callId = session.callId;
  out.msgId = session.msgId;
  out.convId = session.convId;
  out.mediaType = session.mediaType;
  out.roomName = session.roomName;
  out.peerName = session.peerName;
  out.peerAvatar = session.peerAvatar;
  out.startedAt = session.startedAt;
  out.detail = session.detail;
  return out;
}

function changed(): void {
  eventBus.emit(IM_CALL_CHANGED_EVENT, copySession());
}

function isCallPageOpen(): boolean {
  const pages = getCurrentPages();
  if (pages.length == 0) return false;
  // UTS：Page 实例勿 as any，否则访问 .route 会报「找不到名称 route」
  const last = pages[pages.length - 1];
  if (last == null) return false;
  return `${last.route}` == "subpackages/pages/im-call/im-call";
}

function openCallPage(): void {
  if (!isCallPageOpen()) uni.navigateTo({ url: "/subpackages/pages/im-call/im-call" });
}

function parseBody(raw: any | null): UTSJSONObject | null {
  if (raw == null) return null;
  if (typeof raw == "string") {
    try {
      const parsed = JSON.parse(raw);
      return parsed != null ? (parsed as UTSJSONObject) : null;
    } catch (_e) {
      return null;
    }
  }
  return raw as UTSJSONObject;
}

const onMessageReceived = (payload: any): void => {
  if (payload == null) return;
  const obj = payload as UTSJSONObject;
  const msgType = readString(obj, "msgType");
  if (msgType == "meeting_invite") {
    const invite = parseBody(obj["body"]);
    if (invite == null || readString(invite, "silent") == "true") return;
    // 自己其它设备发出的会议邀请回声不展示邀请条（聊天卡片仍在）。
    if (!isIncomingCallForMe(readString(obj, "senderId"), getMyUserIdSync(), "")) return;
    const inviteId = readString(invite, "inviteId");
    const room = readString(invite, "roomName");
    const title = readString(invite, "title");
    const media = readString(invite, "mediaType") == "video" ? "video" : "audio";
    if (inviteId.length == 0 || room.length == 0 || heardMeetingInvites.has(inviteId)) return;
    heardMeetingInvites.add(inviteId);
    // ★会议邀请不再受 1v1 通话态门控：会议和通话是两件事，一条悬挂的 voip 会话
    //   不该把会议邀请条吞掉（真机反馈：前台收不到参会提醒）。
    const convId = readString(obj, "convId");
    const msgId = readString(obj, "msgId");
    const sender = readString(obj, "senderName");
    const senderAvatar = readString(obj, "senderAvatar");
    // #ifndef APP-HARMONY
    // 后台/熄屏交给原生会议来电通道；前台展示应用内邀请条。
    if (isNativeImVoipEnabled() && isAppInBackground()) return;
    // #endif
    const banner = new UTSJSONObject();
    banner["inviteId"] = inviteId;
    banner["convId"] = convId;
    banner["msgId"] = msgId;
    banner["roomName"] = room;
    banner["title"] = title;
    banner["senderName"] = sender;
    banner["senderAvatar"] = senderAvatar;
    banner["mediaType"] = media;
    banner["passcode"] = readString(invite, "passcode");
    // #ifdef APP-HARMONY
    if (isNativeImVoipEnabled()) {
      const now = Date.now();
      const sentAt = obj["sendTime"];
      if (typeof sentAt != "number" || !Number.isSafeInteger(sentAt) || sentAt <= 0 || sentAt > now + 5000) return;
      const expiresAt = Math.min(sentAt, now) + 60_000;
      if (expiresAt <= now) return;
      banner["expiresAt"] = expiresAt;
      // 系统卡片与 WS 备用提示共用消息坐标，优先由已接管的原生卡片处理。
      if (sentAt >= pendingHarmonyMeetingSentAt) {
        pendingHarmonyMeetingInvite = banner;
        pendingHarmonyMeetingSentAt = sentAt;
        resumeHarmonyMeetingInvite();
      }
      return;
    }
    // #endif
    console.error(`[MeetingInvite] banner show inviteId=${inviteId} room=${room} sender=${sender}`);
    showMeetingInviteBanner(banner);
    return;
  }
  if (msgType != "voip" || isNativeImVoipEnabled()) return;
  const body = parseBody(obj["body"]);
  if (body == null) return;
  // 自己其它设备拨出的通话回声不弹来电页；原生通道已按 sender==user 过滤。
  if (!isIncomingCallForMe(readString(obj, "senderId"), getMyUserIdSync(), "")) return;
  const callId = readString(body, "callId");
  const roomName = readString(body, "roomName");
  const mediaType = readString(body, "mediaType").toLowerCase();
  if (callId.length == 0 || roomName.length == 0 || (mediaType != "audio" && mediaType != "video")) return;
  if (heard.has(callId) || session.callId == callId) return;
  heard.add(callId);
  if (session.phase != "idle" && session.phase != "ended") return;
  session = new ImCallSession();
  session.phase = "incoming";
  session.direction = "in";
  session.callId = callId;
  session.msgId = readString(obj, "msgId");
  session.convId = readString(obj, "convId");
  session.mediaType = mediaType;
  session.roomName = roomName;
  session.peerName = readString(obj, "senderName");
  session.peerAvatar = readString(obj, "senderAvatar");
  session.startedAt = Date.now();
  changed();
  openCallPage();
};

const onCustomEvent = (payload: any): void => {
  if (payload == null) return;
  const obj = payload as UTSJSONObject;
  const eventType = readString(obj, "eventType");
  if (eventType == "meeting:invite-handled") {
    const handled = parseBody(obj["payload"]);
    if (handled != null) {
      const msgId = readString(handled, "msgId");
      const inviteId = readString(handled, "inviteId");
      hideHandledMeetingInviteBanner(msgId, inviteId);
      // #ifdef APP-HARMONY
      const pending = pendingHarmonyMeetingInvite;
      if (pending != null && ((msgId.length > 0 && readString(pending, "msgId") == msgId) ||
        (inviteId.length > 0 && readString(pending, "inviteId") == inviteId))) {
        clearPendingHarmonyMeetingInvite();
      }
      // #endif
    }
    return;
  }
  if (session.callId.length == 0) return;
  if (eventType != "voip:answered" && eventType != "voip:cancel" && eventType != "voip:timeout" && eventType != "voip:decline") return;
  const body = parseBody(obj["payload"]);
  if (body == null || readString(body, "callId") != session.callId) return;
  if (eventType == "voip:answered") {
    // answered 只用于让被叫自己的其它设备停铃；主叫靠 LiveKit 远端入会转 active。
    if (session.direction == "in" && session.phase == "incoming") {
      session.phase = "ended";
      session.detail = "已在其他设备接听";
      changed();
    }
    return;
  }
  session.phase = "ended";
  if (eventType == "voip:decline") session.detail = session.direction == "out" ? "对方已拒绝" : "已在其他设备拒绝";
  else if (eventType == "voip:timeout") session.detail = "无人接听";
  else if (eventType == "voip:cancel") session.detail = session.direction == "in" ? "对方已取消" : "已取消";
  changed();
};

export function bindImCallEvents(): void {
  if (bound) return;
  bound = true;
  eventBus.on("" + EVENT_TYPE.ImMessageReceived, onMessageReceived);
  eventBus.on("" + EVENT_TYPE.ImCustomEvent, onCustomEvent);
}

export function getImCallSession(): ImCallSession { return copySession(); }

export function startOutgoingImCall(convId: string, peerName: string, peerAvatar: string, mediaType: string): boolean {
  if (session.phase != "idle" && session.phase != "ended") {
    uni.showToast({ title: "你正在通话中", icon: "none" });
    return false;
  }
  const now = Date.now();
  const rand = Math.floor(Math.random() * 100000000).toString(36);
  session = new ImCallSession();
  session.phase = "outgoing";
  session.direction = "out";
  session.callId = "call-" + now.toString(36) + "-" + rand;
  session.convId = convId;
  session.mediaType = mediaType == "video" ? "video" : "audio";
  session.roomName = "im-" + convId.substring(0, 32) + "-" + now.toString(36) + "-" + rand;
  session.peerName = peerName;
  session.peerAvatar = peerAvatar;
  session.startedAt = now;
  changed();
  openCallPage();
  return true;
}

export function patchImCallSession(phase: string, msgId: string = "", detail: string = ""): void {
  if (phase.length > 0) session.phase = phase;
  if (msgId.length > 0) session.msgId = msgId;
  session.detail = detail;
  changed();
}

export function finishImCall(detail: string = ""): void {
  session.phase = "ended";
  session.detail = detail;
  changed();
}

export function clearImCallSession(): void {
  // #ifdef APP-HARMONY
  clearPendingHarmonyMeetingInvite();
  heardMeetingInvites.clear();
  // #endif
  session = new ImCallSession();
  changed();
}
