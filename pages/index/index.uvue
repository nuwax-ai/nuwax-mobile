  }

  .create-hub__recommend-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 36rpx;
  }

  .create-hub__recommend-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: none;
    min-height: 72rpx;
    max-width: 100%;
    margin-bottom: 20rpx;
    padding: 0 24rpx;
    box-sizing: border-box;
    border: 2rpx solid #e5e6eb;
    border-radius: 24rpx;
    background-color: #ffffff;
    /* #ifndef APP-HARMONY */
    box-shadow: 0 2rpx 8rpx rgba(27, 31, 43, 0.05);
