<template>
  <!--
    消息页右上角「+」锚定气泡：创建群组 / 加入群组 / 添加伙伴 / 扫一扫（H5 不渲染）
    - 无遮罩实现：气泡本体 absolute 挂在 .im-page 布局流内（本组件根节点即气泡），
      贴页面右缘（与加号右缘对齐，留小间距），顶部在加号下方。
      不用 fixed：App-Android 对 fixed 元素定位/命中不稳（本仓库 uni-modal-popup 同教训，
      Android 一律留在布局流）；也不用全屏透明承接层（命中测试落穿，已弃用）
    - 点气泡外任意处关闭由页面级事件承接（message.uvue 在 root/scroll-view 的
      touchstart 冒泡里调 closeAddDrawerOnOutsideTouch）
    - 气泡根节点阻断 touch/tap 冒泡：点气泡自身不触发页面级关闭
    - 安卓返回先关气泡（popupBackRegistry）
  -->
  <view
    v-if="visible"
    class="add-pop"
    :style="popStyle"
    @touchstart.stop="handleBubbleTouch"
    @touchend.stop="handleBubbleTouch"
    @touchcancel.stop="handleBubbleTouch"
    @tap.stop="handlePopTap"
  >
    <view
      class="add-pop__item"
      hover-class="add-pop__item--active"
      @tap="handleCreateGroup"
    >
      <image class="add-pop__icon" :src="iconCreateGroup" mode="aspectFit" />
      <text class="add-pop__label">{{ t("Mobile.Message.createGroup") }}</text>
    </view>
    <view
      class="add-pop__item"
      hover-class="add-pop__item--active"
      @tap="handleJoinGroup"
    >
      <image class="add-pop__icon" :src="iconJoinGroup" mode="aspectFit" />
      <text class="add-pop__label">{{ t("Mobile.Message.joinGroup") }}</text>
    </view>
    <view
      class="add-pop__item"
      hover-class="add-pop__item--active"
      @tap="handleAddBuddy"
    >
      <image class="add-pop__icon" :src="iconAddBuddy" mode="aspectFit" />
      <text class="add-pop__label">{{ t("Mobile.Message.addBuddy") }}</text>
    </view>
    <!-- 扫一扫：H5 无 uni.scanCode，入口不渲染（组件内另有兜底提示） -->
    <!-- #ifndef H5 -->
    <view
      class="add-pop__item"
      hover-class="add-pop__item--active"
      @tap="handleScan"
    >
      <image class="add-pop__icon" :src="iconScan" mode="aspectFit" />
      <text class="add-pop__label">{{ t("Mobile.Message.scan") }}</text>
    </view>
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { computed, onUnmounted, ref, watch } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import {
    registerPopupClose,
    unregisterPopupClose,
    registerBackInterceptionGlobals,
  } from "@/utils/popupBackRegistry";
  import iconCreateGroup from "@/static/icons/group_set.svg";
  import iconJoinGroup from "@/static/icons/join_group.svg";
  import iconAddBuddy from "@/static/icons/add_buddy.svg";
  import iconScan from "@/static/icons/scan.svg";

  // 事件名须 kebab-case：App-Android 模板监听会把 camelCase 转小写导致收不到（.cursorrules 规约）
  const emit = defineEmits<{
    "create-group": [];
    "join-group": [];
    "add-buddy": [];
    "scan-tap": [];
    /** 关闭后触发，页面借此串行接续下一个弹窗 */
    closed: [];
  }>();

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const visible = ref<boolean>(false);
  /** 锚定值（px，页面坐标系，由 message.uvue 测量换算后传入）；-1 表示测量失败，用兜底位置 */
  const anchorBottomPx = ref<number>(-1);
  /** 加号右缘距页面右缘的间距（气泡 right 偏移直接用它） */
  const anchorRightGapPx = ref<number>(-1);

  /** 气泡位置（absolute，相对 .im-page）：顶部在加号下缘 + 6px；右缘与加号右缘对齐。
   *  数值与旧「承接层 flex + margin」锚定一致，视觉位置不变。 */
  const popStyle = computed((): string => {
    const top = anchorBottomPx.value > 0 ? anchorBottomPx.value + 6 : 56;
    const rightGap = anchorRightGapPx.value > 0 ? anchorRightGapPx.value : 16;
    return "top: " + top.toString() + "px; right: " + rightGap.toString() + "px;";
  });

  /** 打开气泡（页面测量并换算成页面坐标后传入：加号下缘 bottom、加号右缘距页面右缘间距）。 */
  function open(anchorBottom: number, anchorRightGap: number): void {
    anchorBottomPx.value = anchorBottom;
    anchorRightGapPx.value = anchorRightGap;
    visible.value = true;
  }

  /** 关闭气泡（无动画版，v-if 直摘）。 */
  function close(): void {
    if (visible.value == false) {
      return;
    }
    visible.value = false;
    emit("closed");
  }

  /** App web-view 内嵌 H5：Android 返回手势先关气泡。 */
  registerBackInterceptionGlobals();
  let popupRegistryId: number = 0;
  watch(
    visible,
    (val: boolean) => {
      if (val == true) {
        if (popupRegistryId == 0) {
          popupRegistryId = registerPopupClose(close);
        }
      } else if (popupRegistryId != 0) {
        unregisterPopupClose(popupRegistryId);
        popupRegistryId = 0;
      }
    },
    { immediate: true },
  );
  onUnmounted(() => {
    if (popupRegistryId != 0) {
      unregisterPopupClose(popupRegistryId);
      popupRegistryId = 0;
    }
  });

  /** 阻断气泡内触摸/点击冒泡到页面（页面级 touchstart 会收起气泡；行点击各自处理）。 */
  function handleBubbleTouch(): void {}

  function handlePopTap(): void {}

  function handleCreateGroup(): void {
    emit("create-group");
    close();
  }

  function handleJoinGroup(): void {
    emit("join-group");
    close();
  }

  function handleAddBuddy(): void {
    emit("add-buddy");
    close();
  }

  function handleScan(): void {
    emit("scan-tap");
    close();
  }

  defineExpose({
    open: open as any,
    close: close as any,
  });
</script>

<style lang="scss" scoped>
  /* 无遮罩：气泡 absolute 挂 .im-page 布局流（App-Android fixed 定位/命中不稳，
     与 uni-modal-popup「Android 留在布局流」同款结论）。点外关闭由页面级 touchstart 冒泡承接。 */
  .add-pop {
    position: absolute;
    /* 低于 uni-modal-popup 默认 zIndex 999：串行弹出的底部表单在气泡之上 */
    z-index: 998;
    width: 320rpx;
    padding: 12rpx 0;
    background-color: #ffffff;
    border-radius: 20rpx;
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
  }

  .add-pop__item {
    height: 96rpx;
    padding: 0 32rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .add-pop__item--active {
    background-color: #f4f3f8;
  }

  .add-pop__icon {
    width: 44rpx;
    height: 44rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
  }

  .add-pop__label {
    font-size: 28rpx;
    line-height: 40rpx;
    font-weight: 500;
    color: #1c1b20;
  }
</style>
