/**
 * 桌宠配件初始化配置（BLE WiFi 配网）领域接口定义
 */
import type { ProvStatusEnum, ProvisionPhaseEnum, ProvisionRetryActionEnum } from '@/types/enums/provision';

/**
 * 设备信息（由 DEVICE_INFO 特征解析得到）
 * 注：DEVICE_INFO 具体格式待与固件确认，先按「UTF-8 分隔符串 sn|model|firmware」解析。
 */
export interface ProvisionDeviceInfo {
  /** 设备序列号 SN */
  sn: string;
  /** 设备型号 */
  model: string;
  /** 固件版本 */
  firmware: string;
  /** 原始字符串（解析失败时兜底展示） */
  raw: string;
}

/** 扫描到待选中的配网目标设备（合并 BLE 广播信息与可选设备信息） */
export interface ProvisionTargetDevice {
  /** 平台设备标识 */
  deviceId: string;
  /** 广播名 */
  name: string;
  /** 信号强度 */
  rssi: number;
}

/** WiFi 凭据（仅存内存，不落盘） */
export interface WifiCredentials {
  ssid: string;
  password: string;
}

/** 配网进度步骤条中的一个阶段（UI 用） */
export interface ProvisionStage {
  /** 对应状态机阶段 */
  phase: ProvisionPhaseEnum;
  /** 该阶段展示状态 */
  state: 'pending' | 'active' | 'done' | 'fail';
}

/** 配网状态解码结果（PROV_STATUS 3 字节解析） */
export interface ProvStatusResult {
  /** byte0 状态码 */
  status: ProvStatusEnum;
  /** byte1-2 错误详情码（无则 0） */
  errorDetail: number;
}

/**
 * 配网错误（上屏文案走 i18nKey，技术细节进 detail 仅供日志/客服）
 */
export interface ProvisionError {
  /** Mobile.Provision.Error.* 文案 key，直接上屏 */
  i18nKey: string;
  /** 技术细节（日志/客服，不上屏） */
  detail: string;
  /** 是否展示「重试」按钮 */
  retryable: boolean;
  /** 重试动作（决定 retry() 行为） */
  retryAction: ProvisionRetryActionEnum;
}
