/**
 * OpenUI artifact SSE 适配器。
 *
 * 对齐 subpackages/utils/interventionAdapter.uts 的写法：从 SSE chunk 中识别
 * nuwax_render_openui 工具结果，提取 {artifactId, title}。供聊天层在 PROCESSING 分支调用，
 * 命中后渲染 openui-card（点击 → 全屏 webview）。
 *
 * 注：nuwax-mobile 仓库内暂无 OpenUI 工具结果的真实报文样例，工具名/result 字段位置
 * 按多候选兼容（data.name / result.name / blockSource.name 等）。请在 HBuilderX 用真实
 * 报文核对一次命中字段。
 *
 * UTS（编译到 Kotlin）：动态字段访问一律走 UTSJSONObject["key"]（readField），
 * 不使用 (x as any).field；可空返回值先判空。
 */
import { firstNullableString } from "@/utils/utsCoalesce";
import {
  extractOpenUiArtifactInfo,
  isOpenUiRenderToolName,
  OpenUiArtifactInfo,
} from "@/utils/openUiSchema.uts";

function asRecord(value: any | null): UTSJSONObject | null {
  if (value == null || typeof value != "object") {
    return null;
  }
  if (Array.isArray(value)) {
    return null;
  }
  return value as UTSJSONObject;
}

function readField(obj: UTSJSONObject | null, key: string): any | null {
  if (obj == null) {
    return null;
  }
  const val = obj[key];
  return val != null ? val : null;
}

/**
 * 从 SSE chunk 中提取 OpenUI 产物信息；非 OpenUI 渲染工具返回 null。
 * 调用方：AgentDetailService.uts 的 PROCESSING 分支（收到工具结果时）。
 */
export function extractOpenUiArtifactFromChunk(chunk: any): OpenUiArtifactInfo | null {
  const chunkObj = asRecord(chunk);
  if (chunkObj == null) {
    return null;
  }

  // envelope：chunk.data 可能再包一层事件信封。
  let envelope = chunkObj;
  const nested = asRecord(readField(chunkObj, "data"));
  if (
    nested != null &&
    (readField(nested, "eventType") != null ||
      readField(nested, "messageType") != null ||
      readField(nested, "subType") != null)
  ) {
    envelope = nested;
  }

  const dataObj = asRecord(readField(envelope, "data"));
  const data = dataObj != null ? dataObj : envelope;
  const result = asRecord(readField(data, "result"));
  const blockSource = asRecord(readField(data, "blockSource"));

  // 工具名候选：跨 backend 字段位置兼容（readField 返回 Any?，用 firstNullableString）。
  const toolName = firstNullableString([
    readField(data, "name"),
    readField(result, "name"),
    readField(blockSource, "name"),
    readField(chunkObj, "name"),
  ]);
  if (isOpenUiRenderToolName(toolName) == false) {
    return null;
  }

  // 产物 ref 候选载荷：优先 result.data / structuredContent，再回退整块 result/data/chunk。
  const candidates: any[] = [];
  const add = (v: any | null): void => {
    if (v != null) {
      candidates.push(v);
    }
  };
  add(readField(result, "data"));
  add(readField(data, "structuredContent"));
  add(readField(data, "structured_content"));
  add(readField(data, "rawOutput"));
  add(readField(data, "raw_output"));
  add(readField(result, "rawOutput"));
  if (result != null) {
    candidates.push(result);
  }
  if (data != null) {
    candidates.push(data);
  }
  candidates.push(chunkObj);

  for (let i = 0; i < candidates.length; i++) {
    // 数组下标返回 any?，判空。
    const c = candidates[i];
    if (c == null) {
      continue;
    }
    const info = extractOpenUiArtifactInfo(c);
    if (info != null) {
      return info;
    }
  }
  return null;
}
