/**
 * H5 剪贴板图片粘贴（聊天页输入框专用，与 App 端 nuwax-clipboard-image 插件分工）：
 * - 桌面：observeChatInputPaste 监听 textarea paste 事件直取 clipboardData.files
 *   （Ctrl+V 图文混贴：图片入暂存条、文字仍走 v-model，免任何弹窗）
 * - 触屏/提示条盲贴：readWebClipboardImage 走 navigator.clipboard.read()
 *   （需 HTTPS + 用户点击手势，浏览器弹安全确认；无法静默探测，故提示条为盲贴入口）
 * 返回的 blob: URL 与 uni.chooseImage(H5) 的 tempFilePath 同形态，可直接入暂存条上传。
 */

/** 当前环境能否走 navigator.clipboard.read（HTTPS 安全上下文 + API 存在）。 */
export function canReadWebClipboard(): boolean {
  // #ifdef H5 || WEB
  const clip = (navigator as any).clipboard;
  return (
    typeof window != "undefined" &&
    window.isSecureContext == true &&
    clip != null &&
    typeof clip.read == "function"
  );
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

/**
 * 读取剪贴板图片（须在用户点击手势内调用，浏览器会弹安全确认）。
 * onImage 回传 blob: URL；无图/拒绝/不支持分别回 EMPTY/DENIED/UNSUPPORTED。
 */
export function readWebClipboardImage(onImage: (url: string) => void, onFail: (code: string, message: string) => void): void {
  // #ifdef H5 || WEB
  const clip = (navigator as any).clipboard;
  if (clip == null || typeof clip.read != "function") {
    onFail("UNSUPPORTED", "navigator.clipboard.read unavailable");
    return;
  }
  clip.read().then((items: any[]): void => {
    const first: any = items != null && items.length > 0 ? items[0] : null;
    if (first == null) {
      onFail("EMPTY", "clipboard empty");
      return;
    }
    // ClipboardItem.types 里找首个 image/*
    const types: string[] = first.types;
    let picked = "";
    if (types != null) {
      for (let i = 0; i < types.length; i++) {
        const ty = types[i];
        if (ty != null && `${ty}`.indexOf("image/") == 0) {
          picked = `${ty}`;
          break;
        }
      }
    }
    if (picked == "") {
      onFail("EMPTY", "clipboard has no image");
      return;
    }
    first.getType(picked).then((blob: any): void => {
      onImage(URL.createObjectURL(blob));
    }).catch((_e: any): void => {
      onFail("READ", "getType failed");
    });
  }).catch((e: any): void => {
    // 用户拒绝浏览器确认框/权限被拒/非手势上下文 → NotAllowedError
    onFail("DENIED", `${e}`);
  });
  // #endif
  // #ifndef H5 || WEB
  onFail("UNSUPPORTED", "web only");
  // #endif
}

/**
 * 监听指定 id 输入框（uni-app x H5 渲染为 uni-textarea 组件，事件 target 可能为内层
 * 真实 textarea，沿 parent 链向上找 targetId 命中）的 paste 事件：
 * clipboardData.files 里的图片逐张 onImage（blob: URL），取到图片时 preventDefault
 * 阻止把文件名当文本贴入；纯文本粘贴不受影响。返回解绑函数。
 */
export function observeChatInputPaste(targetId: string, onImage: (url: string) => void): () => void {
  // #ifdef H5 || WEB
  const handler = (ev: any): void => {
    let node: any = ev.target;
    let hit = false;
    for (let hop = 0; hop < 4 && node != null; hop++) {
      if (node.id == targetId) {
        hit = true;
        break;
      }
      node = node.parentElement;
    }
    if (!hit) {
      return;
    }
    const files = ev.clipboardData != null ? ev.clipboardData.files : null;
    if (files == null || files.length == 0) {
      return;
    }
    let took = false;
    for (let i = 0; i < files.length; i++) {
      const f = files[i];
      if (f != null && `${f.type}`.indexOf("image/") == 0) {
        took = true;
        onImage(URL.createObjectURL(f));
      }
    }
    if (took) {
      ev.preventDefault();
    }
  };
  document.addEventListener("paste", handler, false);
  return (): void => {
    document.removeEventListener("paste", handler, false);
  };
  // #endif
  // #ifndef H5 || WEB
  return (): void => {};
  // #endif
}
