import { type CustomTabSlotKind } from "@/constants/customTabBar.constants";

/** 自绘底栏单个槽的描述（图片本体由组件按 iconName 逻辑名映射到 @/static/assets/icon_<name>.png）。 */
export type CustomTabSlotConfig = {
  kind: CustomTabSlotKind;
  /** 视觉序号：0 对话 / 1 终端或智联录 / 2 ➕ / 3 智能体 / 4 我的 */
  visualIndex: number;
  /** 页面路径（仅实槽；plus 槽为空串） */
  pagePath: string;
  /** 文案 i18n key（仅实槽） */
  i18nKey: string;
  /** 默认图标逻辑名，对应 static/assets/icon_<name>.png */
  iconName: string;
  /** 选中图标逻辑名 */
  activeIconName: string;
};

/** 自绘底栏 5 槽。槽 1 的平台差异与 pages.json tabBar.list、utils/i18n.uts TAB_BAR_I18N_ITEMS 同源规则。 */
export function getCustomTabSlots(): Array<CustomTabSlotConfig> {
  const slots: Array<CustomTabSlotConfig> = [];
  // 槽 0：对话（首页）
  slots.push({
    kind: "index",
    visualIndex: 0,
    pagePath: "/pages/index/index",
    i18nKey: "Mobile.Nav.chat",
    iconName: "home",
    activeIconName: "home_active",
  });
  // 槽 1：H5/WEB 为「智联录」，其余平台为「终端」
  // #ifdef H5 || WEB
  slots.push({
    kind: "union",
    visualIndex: 1,
    pagePath: "/pages/agent-union-record/agent-union-record",
    i18nKey: "Mobile.Nav.unionRecord",
    iconName: "union_record",
    activeIconName: "union_record_active",
  });
  // #endif
  // #ifndef H5 || WEB
  slots.push({
    kind: "terminal",
    visualIndex: 1,
    pagePath: "/pages/terminal/terminal",
    i18nKey: "Mobile.Nav.terminal",
    iconName: "terminal",
    activeIconName: "terminal_active",
  });
  // #endif
  // 槽 2：➕ 动作槽（无页面）
  slots.push({
    kind: "plus",
    visualIndex: 2,
    pagePath: "",
    i18nKey: "",
    iconName: "",
    activeIconName: "",
  });
  // 槽 3：智能体
  slots.push({
    kind: "agent",
    visualIndex: 3,
    pagePath: "/pages/agent-list/agent-list",
    i18nKey: "Mobile.Nav.agent",
    iconName: "agent",
    activeIconName: "agent_active",
  });
  // 槽 4：我的
  slots.push({
    kind: "mine",
    visualIndex: 4,
    pagePath: "/pages/mine/mine",
    i18nKey: "Mobile.Nav.mine",
    iconName: "mine",
    activeIconName: "mine_active",
  });
  return slots;
}
