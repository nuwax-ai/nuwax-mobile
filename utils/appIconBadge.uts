/**
 * App 桌面图标数字角标（三端统一入口）。
 *
 * ★口径：与离线推送 payload 里的 `badge` 完全同源 —— `/api/instant-message/unread-total`
 *   的 `total`（后端 ImUnreadCounter 已排除免打扰会话）。服务端下发离线推送时由系统把
 *   badge 直接写到图标上；端上只用同一个数做「读完后减少」和「在线收消息」的校准，
 *   两边同一口径才不会互相覆盖跳变。
 *   ★不要叠加站内「系统消息」未读（`systemMessageUnreadCount`，挂「我的」Tab 那条链路）：
 *     混算会和服务端推来的 badge 对不上，图标数字会在两者之间来回跳。
 *
 * ★为什么端上还要再设一次：服务端只在下发离线推送那一刻设角标。用户进 App 读完消息后
 *   没有任何推送事件，系统不会自己把数字减下来 —— 必须端上按最新 total 主动重设。
 *
 * ★★关键分工：后台收推送那一刻，端上这段代码**根本不会执行**（Android 进程被冻结），
 *   角标只能由云函数 push-send 下发的 `badge` 经厂商通道直接写到图标上。
 *   ⇒ 排查「退后台收到推送但桌面没数字」时，先分清是两条链路里的哪一条：
 *     · 进 App 后出现数字  → 端上 API 正常，问题在推送 badge 的厂商通道落地
 *     · 进 App 后也没有数字 → 端上调用/权限/系统开关的问题（见下面各平台清单）
 *   ⇒ 官方对推送 badge 的限制：华为 Android 的 uni-app x 应用「暂不支持」顶层 `badge`
 *     （api.md 原文）。本仓已改走 `options.android.HW` 直通华为 Push Kit 原生
 *     `/message/android/notification/badge/{class,set_num}`，见
 *     uniCloud-alipay/cloudfunctions/push-send/index.js 的 VENDOR_BADGE_ADAPTERS；
 *     小米/OPPO/vivo 无数字角标 API，离线时只能靠本文件兜底。
 *   ⇒ 本文件的 setAppBadgeNumber 只覆盖「App 正在运行」；进程被杀时一行都不执行。
 *
 * ===== 排查「调用正常，但桌面图标没有数字」时，按平台逐项确认 =====
 *
 * 【iOS】
 * - 通知权限必须包含「标记（Badge）」。用户只允许了横幅/声音、关掉标记时，本 API
 *   静默无效（不报错）。路径：设置 → 通知 → <App> → 标记。
 * - 角标实际由 APNs 的 `aps.badge` 承载：服务端推送里的 badge 会覆盖端上设的值。
 *
 * 【Android】数字角标不是系统能力，由桌面 Launcher 实现，各家 ROM 差异极大：
 * - 前提：必须有通知权限（Android 13+ 的 POST_NOTIFICATIONS），否则通知与角标都不显示。
 * - 华为 / 荣耀：设置 → 通知 → 应用 → 「应用图标角标」需打开；未上架华为应用市场的包
 *   存在不显示的情况（华为官方口径）。
 * - 小米 MIUI：数字角标挂在通知中心的应用通知上，需传 options（title/content）让通知中心
 *   保留一条通知，并在「桌面角标」开关里允许。★本仓 manifest.json 的 uni-push 模块目前
 *   只勾了 hms/oppo/vivo/honor，没有 xiaomi —— 小米通道待应用市场上架审核通过后再补。
 * - OPPO / vivo / 三星（含国行）：多数机型不保证数字角标，部分需要厂商推送权益或桌面包支持。
 * - 原生 Android（Pixel 等）：系统只支持通知圆点（badge dot），没有数字角标，调了也看不到。
 *
 * 【鸿蒙】
 * - 设置 → 通知和状态栏 → 应用 → 「桌面图标角标」需打开，且要选「数字角标」（只开圆点
 *   不显示数字）。
 * - 设置自身角标不需要额外权限（ohos.permission.NOTIFICATION_CONTROLLER 是管他人通知的
 *   受限权限，这里用不到）。
 *
 * @param count 未读总数；<= 0 表示清除角标
 */
let appIconBadgeSuppressed = false;

function writeAppIconBadge(count: number): void {
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  const value = count > 0 ? count : 0;
  try {
    uni.setAppBadgeNumber(value);
  } catch (_e) {
    // 基座未含 uni-push 模块 / 平台不支持：静默降级，不影响业务
  }
  // #endif
}

/** 前台期间不显示桌面角标；后台重新允许推送角标落地。 */
export function setAppIconBadgeSuppressed(suppressed: boolean): void {
  if (suppressed) writeAppIconBadge(0);
  appIconBadgeSuppressed = suppressed;
}

/** 清除桌面角标，同时保留后台推送重新设置角标的能力。 */
export function clearAppIconBadge(): void {
  writeAppIconBadge(0);
}

export function syncAppIconBadge(count: number): void {
  if (appIconBadgeSuppressed) return;
  writeAppIconBadge(count);
}
