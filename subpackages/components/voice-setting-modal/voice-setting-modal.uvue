<template>
  <uni-modal-popup
    ref="modal"
    :title="t('Mobile.Voice.settingsTitle')"
    position="center"
    :enable-swipe-close="false"
  >
    <view class="voice-settings">
      <!-- 播报设置 -->
      <text class="section-title">{{ t("Mobile.Voice.playbackSection") }}</text>

      <view class="setting-item" @tap="toggleField('autoPlay')">
        <view class="setting-info">
          <text class="setting-label">{{ t("Mobile.Voice.autoPlay") }}</text>
          <text class="setting-desc">{{ t("Mobile.Voice.autoPlayDesc") }}</text>
        </view>
        <view class="switch" :class="{ 'switch-on': settings.autoPlay }">
          <view class="switch-dot"></view>
        </view>
      </view>

      <!-- 内容过滤 -->
      <text class="section-title">{{ t("Mobile.Voice.filterSection") }}</text>

      <view class="setting-item" @tap="toggleField('includeThinkContent')">
        <view class="setting-info">
          <text class="setting-label">{{ t("Mobile.Voice.includeThinkContent") }}</text>
          <text class="setting-desc">{{ t("Mobile.Voice.includeThinkContentDesc") }}</text>
        </view>
        <view class="switch" :class="{ 'switch-on': settings.includeThinkContent }">
          <view class="switch-dot"></view>
        </view>
      </view>

      <view class="setting-item" @tap="toggleField('includeCodeBlocks')">
        <view class="setting-info">
          <text class="setting-label">{{ t("Mobile.Voice.includeCodeBlocks") }}</text>
          <text class="setting-desc">{{ t("Mobile.Voice.includeCodeBlocksDesc") }}</text>
        </view>
        <view class="switch" :class="{ 'switch-on': settings.includeCodeBlocks }">
          <view class="switch-dot"></view>
        </view>
      </view>

      <view class="setting-item" @tap="toggleField('includeLinkUrl')">
        <view class="setting-info">
          <text class="setting-label">{{ t("Mobile.Voice.includeLinkUrl") }}</text>
          <text class="setting-desc">{{ t("Mobile.Voice.includeLinkUrlDesc") }}</text>
        </view>
        <view class="switch" :class="{ 'switch-on': settings.includeLinkUrl }">
          <view class="switch-dot"></view>
        </view>
      </view>

      <view class="setting-item" @tap="toggleField('keepEmoji')">
        <view class="setting-info">
          <text class="setting-label">{{ t("Mobile.Voice.keepEmoji") }}</text>
          <text class="setting-desc">{{ t("Mobile.Voice.keepEmojiDesc") }}</text>
        </view>
        <view class="switch" :class="{ 'switch-on': settings.keepEmoji }">
          <view class="switch-dot"></view>
        </view>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script lang="uts" setup>
  import { ref, onMounted, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import {
    VoiceSettings,
    cloneVoiceSettings,
    loadVoiceSettings,
    saveVoiceSettings,
  } from "@/subpackages/utils/voice/voiceTypes";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const emit = defineEmits<{
    change: [settings: VoiceSettings];
  }>();

  // 内部自管理设置（App 上 class prop 传值不可靠，不走 props）
  const settings = ref<VoiceSettings>(new VoiceSettings());

  const modal = ref<any | null>(null);

  /** Android：Gen* 组件 ref 禁止 as UTSJSONObject，用 $callMethod 调 uni-modal-popup */
  const callRefMethod = (refVal: any | null, methodName: string): void => {
    if (refVal == null) {
      return;
    }
    const proxy = refVal as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  };

  function open(): void {
    // 每次打开重新读取，保证与外部一致
    settings.value = loadVoiceSettings();
    callRefMethod(modal.value, "open");
  }

  function close(): void {
    callRefMethod(modal.value, "close");
  }

  /** 切换开关字段（uts class 无动态字段访问，显式分支） */
  function toggleField(field: string): void {
    const s = settings.value;
    if (field == "autoPlay") {
      s.autoPlay = !s.autoPlay;
    } else if (field == "includeThinkContent") {
      s.includeThinkContent = !s.includeThinkContent;
    } else if (field == "includeCodeBlocks") {
      s.includeCodeBlocks = !s.includeCodeBlocks;
    } else if (field == "includeLinkUrl") {
      s.includeLinkUrl = !s.includeLinkUrl;
    } else if (field == "keepEmoji") {
      s.keepEmoji = !s.keepEmoji;
    }
    saveVoiceSettings(s);
    // 重新赋值触发响应式更新
    settings.value = cloneVoiceSettings(s);
    emit("change", settings.value);
  }

  onMounted(() => {
    settings.value = loadVoiceSettings();
  });

  defineExpose({ open, close });
</script>

<style lang="scss" scoped>
  .voice-settings {
    display: flex;
    flex-direction: column;
    padding: 8rpx 0 24rpx 0;
  }

  .section-title {
    font-size: 26rpx;
    color: rgba(0, 0, 0, 0.45);
    margin: 24rpx 0 8rpx 0;
    font-weight: 400;
  }

  .setting-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 24rpx 0;
    border-bottom-width: 1rpx;
    border-bottom-color: rgba(0, 0, 0, 0.06);
    border-bottom-style: solid;
  }

  .setting-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-right: 24rpx;
  }

  .setting-label {
    font-size: 30rpx;
    color: #000;
    font-weight: 500;
  }

  .setting-desc {
    font-size: 24rpx;
    color: rgba(0, 0, 0, 0.45);
    margin-top: 6rpx;
  }

  .switch {
    width: 88rpx;
    height: 48rpx;
    border-radius: 24rpx;
    background-color: #d9d9d9;
    padding: 4rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
  }

  // vapor: 原 &.switch-on 复合选择器提为顶层单类（模板与 .switch 同元素出现）
  .switch-on {
    background-color: rgb(108, 101, 244);
    justify-content: flex-end;
  }

  .switch-dot {
    width: 40rpx;
    height: 40rpx;
    border-radius: 20rpx;
    background-color: #fff;
  }
</style>
