<template>
  <view v-if="visible" class="device-profile-mask" @tap="close">
    <view class="device-profile-popup" @tap.stop>
      <view class="device-profile-header">
        <text class="device-profile-title">{{ t("Mobile.Terminal.deviceProfileEditTitle") }}</text>
        <view class="device-profile-close" @tap="close"><text class="device-profile-close-text">×</text></view>
      </view>
      <view class="device-profile-body">
        <view class="device-profile-item">
          <view class="device-profile-label-row">
            <text class="device-profile-label">{{ t("Mobile.Terminal.deviceProfileName") }}</text>
            <text class="device-profile-count">{{ formDeviceName.length }}/50</text>
          </view>
          <input class="device-profile-input" v-model="formDeviceName" maxlength="50" :placeholder="t('Mobile.Terminal.deviceNamePlaceholder')" placeholder-class="device-profile-placeholder" />
        </view>
        <view class="device-profile-item">
          <view class="device-profile-label-row">
            <text class="device-profile-label">{{ t("Mobile.Terminal.deviceRole") }}</text>
            <text class="device-profile-count">{{ formDeviceRole.length }}/50</text>
          </view>
          <input class="device-profile-input" v-model="formDeviceRole" maxlength="50" :placeholder="t('Mobile.Terminal.deviceRolePlaceholder')" placeholder-class="device-profile-placeholder" />
        </view>
        <view class="device-profile-item">
          <view class="device-profile-label-row">
            <text class="device-profile-label">{{ t("Mobile.Terminal.wakeWord") }}</text>
            <text class="device-profile-count">{{ formWakeWord.length }}/50</text>
          </view>
          <input class="device-profile-input" v-model="formWakeWord" maxlength="50" :placeholder="t('Mobile.Terminal.wakeWordPlaceholder')" placeholder-class="device-profile-placeholder" />
        </view>
        <view class="device-profile-actions">
          <view class="device-profile-btn device-profile-btn-cancel" @tap="close">
            <text class="device-profile-btn-cancel-text">{{ t("Mobile.Common.cancel") }}</text>
          </view>
          <view :class="['device-profile-btn', 'device-profile-btn-confirm', submitting ? 'device-profile-btn-disabled' : '']" @tap="submit">
            <text class="device-profile-btn-confirm-text">{{ submitting ? t("Mobile.Common.saving") : t("Mobile.Common.save") }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, watch } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      visible: boolean;
      deviceName: string;
      deviceRole: string;
      wakeWord: string;
      submitting?: boolean;
    }>(),
    {
      visible: false,
      deviceName: "",
      deviceRole: "",
      wakeWord: "",
      submitting: false,
    },
  );

  const emit = defineEmits<{
    (e: "close"): void;
    (e: "save", deviceName: string, deviceRole: string, wakeWord: string): void;
  }>();

  const formDeviceName = ref<string>("");
  const formDeviceRole = ref<string>("");
  const formWakeWord = ref<string>("");

  watch(
    () => props.visible,
    (visible: boolean) => {
      if (!visible) return;
      formDeviceName.value = props.deviceName.substring(0, 50);
      formDeviceRole.value = props.deviceRole.substring(0, 50);
      formWakeWord.value = props.wakeWord.substring(0, 50);
    },
  );

  const close = (): void => {
    if (props.submitting) return;
    emit("close");
  };

  const submit = (): void => {
    if (props.submitting) return;
    emit(
      "save",
      formDeviceName.value.trim().substring(0, 50),
      formDeviceRole.value.trim().substring(0, 50),
      formWakeWord.value.trim().substring(0, 50),
    );
  };
</script>

<style lang="scss" scoped>
  .device-profile-mask {
    position: fixed;
    z-index: 1000;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;

    .device-profile-popup {
      width: 80%;
      background-color: #ffffff;
      border-radius: 20rpx;
      overflow: hidden;

      .device-profile-header {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 30rpx;
        border-bottom: 2rpx solid #f0f0f0;

        .device-profile-title {
          flex: 1;
          font-size: 32rpx;
          font-weight: 600;
          color: #15171f;
        }

        .device-profile-close {
          width: 48rpx;
          height: 48rpx;
          display: flex;
          align-items: center;
          justify-content: center;

          .device-profile-close-text {
            font-size: 52rpx;
            line-height: 1;
            color: #333333;
          }
        }
      }

      .device-profile-body {
        display: flex;
        flex-direction: column;
        padding: 30rpx;

        .device-profile-item {
          display: flex;
          flex-direction: column;
          margin-bottom: 24rpx;

          .device-profile-label-row {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12rpx;

            .device-profile-label {
              font-size: 28rpx;
              font-weight: 500;
              color: #1a1a1a;
            }

            .device-profile-count {
              color: #86909c;
              font-size: 22rpx;
            }
          }

          .device-profile-input {
            box-sizing: border-box;
            width: 100%;
            height: 80rpx;
            border: 2rpx solid #e5e6eb;
            border-radius: 12rpx;
            background-color: #f7f8fa;
            color: #1d2129;
            font-size: 28rpx;
            padding: 20rpx 24rpx;
          }
        }

        .device-profile-placeholder {
          color: #c0c0c0;
        }

        .device-profile-actions {
          display: flex;
          flex-direction: row;
          margin-top: 8rpx;

          .device-profile-btn {
            flex: 1;
            height: 80rpx;
            border-radius: 12rpx;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 16rpx;

            &.device-profile-btn-cancel {
              background-color: #f2f3f5;

              .device-profile-btn-cancel-text {
                font-size: 28rpx;
                font-weight: 600;
                color: #4e5969;
              }
            }

            &.device-profile-btn-confirm {
              background-color: #5147ff;

              .device-profile-btn-confirm-text {
                font-size: 28rpx;
                font-weight: 600;
                color: #ffffff;
              }
            }

            &.device-profile-btn-disabled {
              opacity: 0.6;
            }
          }
        }
      }
    }
  }
</style>
