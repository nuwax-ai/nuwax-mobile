<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="uts.sdk.modules.nuwaxNativeAuth">
  <queries><intent><action android:name="android.intent.action.VIEW"/><data android:scheme="https"/></intent></queries>
  <application>
    <activity android:name="com.nuwax.nativeauth.NativeAuthCallbackActivity" android:exported="true" android:excludeFromRecents="true" android:noHistory="true" android:theme="@android:style/Theme.NoDisplay">
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="com.nuwax.app.auth" android:host="oauth" android:path="/callback"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
