/**
 * 前台会议邀请条：App 在前台收到 meeting_invite 时，在全局顶部展示一条可加入/忽略的邀请。
 *
 * 设计要点：
 * - 后台/熄屏/进程被杀不依赖这里，交给原生来电通道；
 * - 模块级 ref + Set 去重，页面只挂一个零绑定组件，不把状态塞进 chat.uvue（模板参数上限）；
 * - 加入/忽略后由组件回写 meeting-invite-handled，并保留 inviteId 去重，避免 WS/推送重复弹。
 */
import { ref } from "vue";

export const meetingInviteBanner = ref<UTSJSONObject | null>(null);

const seen = new Set<string>();

/** inviteId 为空的邀请不展示；同一条邀请只展示一次；已有条时先到先得。 */
export function showMeetingInviteBanner(value: UTSJSONObject): void {
  const inviteId = `${value["inviteId"] ?? ""}`;
  if (inviteId.length == 0 || seen.has(inviteId)) return;
  seen.add(inviteId);
  // 先到先得：已有邀请条时只记去重，不打断当前这条。
  if (meetingInviteBanner.value != null) return;
  meetingInviteBanner.value = value;
}

/** 不传 inviteId 时直接收起当前条；传入时只在同一条邀请上生效。 */
export function hideMeetingInviteBanner(inviteId: string = ""): void {
  const current = meetingInviteBanner.value;
  if (current == null) return;
  if (inviteId.length > 0 && `${current["inviteId"] ?? ""}` != inviteId) return;
  meetingInviteBanner.value = null;
}

/** 登出/切换账号时清理当前条；去重集合由 resetMeetingInviteBannerSeen 单独重置。 */
export function clearMeetingInviteBanner(): void {
  meetingInviteBanner.value = null;
}

export function resetMeetingInviteBannerSeen(): void {
  seen.clear();
}
