{
  "module": {
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:voip_microphone_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility",
            "NuwaxVoipMediaAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:voip_camera_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility",
            "NuwaxVoipMediaAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      }
    ]
  }
}
