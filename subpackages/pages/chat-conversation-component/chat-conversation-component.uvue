<template>
  <view ref="msgListContentRef" class="agent-detail-container page-container">
    <!-- 导航栏 -->
    <!-- 临时会话不显示Logo, 显示标题`和xxx开始会话` -->
    <custom-nav-bar
      :title="headerTitle"
      :show-back="!isAppDetails"
      :icon="headerIcon"
      hasSafetyZone
    >
      <template v-slot:left>
        <!-- #ifdef MP-WEIXIN -->
        <!-- 小程序右侧有胶囊，更多入口放左侧（原 menu-dropdown 位置） -->
        <view
          v-if="!isAppDetails"
          class="icon-box"
          hover-class="icon-box-hover"
          @tap="handleMorePopup"
        >
          <svg-icon name="icon-Menu" size="44" />
        </view>
        <!-- #endif -->

        <!-- 应用详情页显示菜单按钮 -->
        <!-- #ifdef MP-WEIXIN || H5 || WEB -->
        <svg-icon
          v-if="isAppDetails"
          name="icon-Menu"
          size="44"
          @tap="onMenuClick"
        />
        <!-- #endif -->

        <!-- #ifdef H5 || WEB -->
        <svg-icon
          v-if="isShowWebView"
          name="icon-Home"
          size="44"
          @tap="handleBackHome"
        />
        <!-- #endif -->
      </template>

      <template v-slot:right>
        <!-- #ifdef H5 || WEB || APP -->
        <view class="right-buttons">
          <view
            class="icon-box"
            hover-class="icon-box-hover"
            @tap="handleMorePopup"
            v-if="!isTempChat && !isAppDetails"
          >
            <svg-icon name="icon-More" size="44" />
          </view>
          <template v-if="showNavCreateConversation">
            <!-- 创建新会话 -->
            <view
              v-if="!isDeviceAgent"
              class="icon-box"
              hover-class="icon-box-hover"
              @tap="handleCreateNewConversation"
            >
              <svg-icon name="icon-message-add" size="44" />
            </view>
            <!-- 自动播报开/关（关：SSE 不播报；工具栏手动播放仍可用） -->
            <view
              class="icon-box"
              hover-class="icon-box-hover"
              @tap="handleToggleVoiceAutoPlay"
            >
              <uni-icons
                v-if="voiceAutoPlayOff"
                type="micoff"
                size="44rpx"
                color="#333333"
              />
              <svg-icon v-else name="icon-voice-1" size="44" />
            </view>
          </template>
        </view>
        <!-- #endif -->
      </template>
    </custom-nav-bar>

    <!-- 默认展开扩展页面区域，且隐藏聊天区域 -->
    <template v-if="isShowWebView">
      <web-view
        class="w-full"
        v-if="pageHomeUrl?.length"
        :src="pageHomeUrl + (ticket.length > 0 ? '?_ticket=' + ticket : '')"
        id="webview"
      ></web-view>
    </template>
    <template v-else>
      <view class="chat-container">
        <!-- 聊天内容 -->
        <view class="scroll-view-box">
          <scroll-view
            direction="vertical"
            class="msg-list"
            :scroll-into-view="scrollIntoView"
            id="msg-list"
            :scroll-with-animation="scrollWithAnimation"
            :upper-threshold="50"
            @scrolltoupper="handleScrollToUpper"
            @scroll="onScroll"
            @touchstart="handleTouchStart"
            @touchend="handleTouchEnd"
            @touchcancel="handleTouchEnd"
          >
            <!-- 加载更多历史消息提示 -->
            <view class="loading-more-tip" v-if="isLoadingMoreMessages">
              <uni-load-more
                status="loading"
                :content-text="historyLoadMoreContentText"
              />
            </view>
            <new-conversation-set
              ref="newConversationSetRef"
              :variables="variables"
              :user-fill-variables="userFillVariables"
              :disabled="isSendMessageRef"
              @toggleWholeDisabled="handleToggleWholeDisabled"
            />
            <view class="msg-list-content" v-if="messageList?.length">
              <template
                v-for="(item, listIndex) in messageList"
                :key="`${item.id}_${item.index}`"
              >
                <view
                  class="msg-list-item"
                  :class="isLastMessage(listIndex) ? 'msg-list-item--last' : ''"
                  :id="`msg-wrapper-${item.id}_${item.index}`"
                >
                  <!-- 智能体会话消息 -->
                  <UniAiXMsg
                    v-if="isAssistantMessage(item)"
                    :message-id="`${item.id}`"
                    :body-text="resolveAssistantBodyText(item, listIndex)"
                    :think-text="getAssistantThinkText(item)"
                    :speakable-text="getAssistantSpeakableText(item)"
                    :message-status="item.status"
                    :processing-list="getAssistantProcessingList(item)"
                    :initial-markdown-el-list="getAssistantMarkdownElList(item)"
                    :conversation-id="`${conversationId}`"
                    :is-app-details="isAppDetails"
                    :message-time="item.time"
                    :is-last-msg="isLastMessage(listIndex)"
                    :is-conversation-active="isConversationActive"
                    :show-tool-bar="!(isConversationActive && isLastMessage(listIndex))"
                    :task-status="conversationTaskStatus"
                    @longpress="onlongTapMsg(item)"
                    @changeThinkContent="changeThinkContent"
                    :id="`msg-item-${item.id}_${item.index}`"
                    :ref="(el: any) => setMessageRef(el, `${item.id}_${item.index}`)"
                  ></UniAiXMsg>
                  <!-- 用户消息 -->
                  <template v-else>
                    <!-- 图片以及文件（Android：attachments 元素多为 UTSJSONObject，禁止当 AttachmentFile 用） -->
                    <scroll-view
                      class="files-container"
                      v-if="hasMessageAttachments(item)"
                      direction="horizontal"
                      :scroll-with-animation="true"
                      :show-scrollbar="false"
                    >
                      <view class="files-list">
                        <view
                          class="files-box"
                          :class="getFileBoxClassName(getAttachmentMimeType(file))"
                          v-for="(file, fileIndex) in getMessageAttachments(item)"
                          :key="getAttachmentFileKey(file, fileIndex)"
                          @click="onPreview(file, getMessageAttachments(item))"
                        >
                          <image
                            class="image"
                            v-if="isImageMimeType(getAttachmentMimeType(file))"
                            :src="getAttachmentFileUrl(file)"
                            mode="aspectFill"
                            :alt="getUploadImageAlt(getAttachmentFileName(file))"
                          />
                          <!-- 文件 -->
                          <template v-else>
                            <image
                              class="doc-image"
                              :src="docImage"
                              mode="aspectFill"
                              :alt="tt('Mobile.Chat.uploadFileAlt')"
                            />
                            <view class="doc-info-container">
                              <view class="doc-name text-ellipsis">{{
                                getAttachmentFileName(file)
                              }}</view>
                              <text class="doc-size text-ellipsis">{{
                                formatFileSize(file)
                              }}</text>
                            </view>
                          </template>
                        </view>
                      </view>
                    </scroll-view>
                    <!-- App：rich-text 对纯文本 nodes(string) 常不渲染，H5 正常；用户消息用 text -->
                    <view
                      class="user-msg"
                      v-if="hasUserMessageText(item)"
                      :id="`msg-item-${item.id}_${item.index}`"
                    >
                      <text class="user-msg-text" selectable="true">{{
                        getUserMessageText(item)
                      }}</text>
                    </view>
                  </template>
                </view>
              </template>
              <view
                class="content"
                v-if="!isConversationActive && chatSuggestList.length > 0"
              >
                <button-wrapper
                  button-align="flex-start"
                  :chat-suggest-list="chatSuggestList"
                  @button-click="handleButtonClick"
                />
              </view>

              <!-- 智能体任务执行中，显示加载中图标 -->
              <image
                v-if="isTaskExecuting"
                class="icon-loading-image"
                src="@/static/assets/icon_loading.svg"
                alt=""
                :show-menu-by-longpress="false"
                @longtap.stop.prevent
                @contextmenu.stop.prevent="true"
                mode="widthFix"
              />
            </view>

            <!-- 空状态内容 -->
            <view class="content" v-else>
              <view class="title-section">
                <UniAiXMsg
                  v-if="openingChatBody.length > 0"
                  message-id="opening-chat-message"
                  :body-text="openingChatBody"
                  message-status="complete"
                  :conversation-id="`${conversationId}`"
                  :is-last-msg="false"
                  :is-conversation-active="false"
                  :show-tool-bar="false"
                />
              </view>
              <button-wrapper
                v-if="!isConversationActive && chatSuggestList.length > 0"
                :chat-suggest-list="chatSuggestList"
                @button-click="handleButtonClick"
              />
            </view>

            <!-- 滚底锚点：保留极小高度保证 scroll-into-view 稳定，避免底部大块空白 -->
            <view style="height: 12px" id="last-msg"></view>
          </scroll-view>

          <!-- 滚动到底部按钮 -->
          <view
            :style="{ visibility: scrollInBottom ? 'hidden' : 'visible' }"
            class="scroll-to-bottom"
            @click="scrollToLastMsg(true)"
          >
            <svg-icon name="icon-a-Chevrondown" />
          </view>
        </view>
        <voice-conversation-panel
          v-if="isRenderInputPhone && voiceConversationEnabled"
          :assistant-msg-id="assistantMsgId"
          :stream-text="assistantStreamText"
          :think-text="assistantThinkText"
          :stream-status="assistantStreamStatus"
          :is-conversation-active="isConversationActive"
          :conversation-key="voiceConversationKey"
        />
        <!-- 输入框 -->
        <chat-input-phone
          v-if="isRenderInputPhone"
          key="agent-details-chat-input"
          ref="agentDetailInputPhoneRef"
          :page-home-index="inputPageHomeIndex"
          :expand-page-area="inputExpandPageArea"
          :whole-disabled="wholeDisabled"
          :manual-components="inputManualComponents"
          :default-selected-components="selectedComponents"
          :is-conversation-active="isConversationActive"
          :is-stopping-conversation="isStoppingConversation"
          @onSendMessage="handleSendMessage"
          @onStopConversation="handleStopConversation"
          @onOpenPagePreview="(uri:string)=>openPagePreviewByUri(uri)"
          :is-task-agent="isTaskAgentType"
          @onOpenFileTree="handleOpenFileTree"
          :sandbox-list="sandboxList"
          :current-sandbox-id="currentSandboxId"
          :is-sandbox-switch-disabled="isSandboxLocked"
          :is-sandbox-unavailable="isSandboxUnavailable"
          :sandbox-disabled-text="sandboxDisabledText"
          :readonly="inputReadonlySandbox"
          :enable-skill-at="inputEnableSkillAt"
          :is-temp-chat="isTempChat"
          @onSandboxChange="(id: string) => handleSelectSandbox(id)"
          :has-permission="inputHasPermission"
          :allow-other-model="inputAllowOtherModel"
          :current-model-id="inputCurrentModelId"
          :current-model-name="inputCurrentModelName"
          :agent-id="agentId"
          :agent-type="inputAgentTypeStr"
          :allow-choose-mode="inputAllowChooseMode"
          :subscription-required="subscriptionRequired"
          @onModelChange="(id: number, name: string) => handleSelectModel(id, name)"
          @onOpenSubscription="handleOpenSubscription"
        />
      </view>
    </template>

    <more-popup
      v-if="!isTempChat"
      ref="refMorePopup"
      :agent-info="agentInfo"
      :is-task-agent="isTaskAgentType"
      :has-history="messageList.length > 0"
      :current-sandbox-id="currentSandboxId"
      :conversation-id="conversationId != null ? conversationId : 0"
      :is-app-details="isAppDetails"
      @collect="handleCollect"
      @restartAgent="handleRestartAgent"
      @restartSandbox="handleRestartSandbox"
      @mySubscription="handleOpenSubscription"
    />
    <template v-else>
      <!-- #ifdef H5 || WEB-->
      <view>
        <button :id="buttonId" type="button" class="captcha-button" />
        <aliyun-captcha-h5
          :config="tenantConfigInfo"
          :element-id="buttonId"
          @doAction="handleCaptchaDoAction"
          @onReady="handleCaptchaReady"
        />
      </view>
      <!-- #endif -->
      <!-- #ifndef H5 || WEB-->
      <view />
      <!-- #endif -->
    </template>

    <!-- 页面预览 -->
    <page-preview-iframe
      ref="pagePreviewIframeRef"
      @update-visible="updateVisible"
    />
    <!-- 文件树 -->
    <file-tree
      ref="fileTreeRef"
      v-if="isTaskAgentType"
      :cId="conversationId"
      :files="fileList"
      :is-loading="isLoadingFiles"
      @update-visible="updatePopupFileTreeVisible"
    />
    <!-- 工具详情弹窗 -->
    <tool-details-modal
      ref="toolDetailsModalRef"
      :title="toolDetailTitle"
      :detail-data="toolDetailData"
    />

    <!-- 订阅套餐弹窗 -->
    <agent-subscription-modal
      ref="refSubscriptionModal"
      v-if="agentInfo"
      :agent-id="agentId"
      :current-plan-id="agentInfoField('planId')"
      :current-plan-price="agentInfoField('price')"
      :called-trial-count="localCalledTrialCount"
      :trial-count="agentInfoField('trialCount')"
      :is-need-subscription="subscriptionRequired"
      @purchase-success="handlePurchaseSuccess"
      @update-visible="handleUpdateModalVisible"
    />
    <!-- uni-ai-x 在 App 上通过隐藏 WebView 将数学公式渲染为图片 -->
    <!-- #ifndef MP-WEIXIN -->
    <web-view
      class="markdown-proxy-web"
      id="markdown-proxy-web"
      src="/uni_modules/uni-ai-x/static/proxy-web/proxy-web.html"
      @message="handleMarkdownProxyMessage"
    ></web-view>
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  // ==================== 导入模块 ====================
  // 分层架构
  import { nextTick, type ComponentPublicInstance } from "vue";
  import { onLoad, onHide, onShow } from "@dcloudio/uni-app";
  import { consumePendingOpenUiAction } from "@/utils/pendingOpenUiAction.uts";
  import AgentDetailData from "./layers/AgentDetailData.uts";
  import AgentDetailService, {
    HandleSendMessageData,
    parseManualComponents,
    parseEventBindConfig,
  } from "./layers/AgentDetailService.uts";
  import ComponentManager from "./layers/ComponentManager.uts";
  import { readRawField } from "@/subpackages/utils/messageInfoClass.uts";
  import ScrollManager from "./layers/ScrollManager.uts";
  import AgentDetailUtils from "./layers/AgentDetailUtils.uts";
  import { ttsWebSocketPlayer } from "@/subpackages/utils/voice/ttsWebSocketPlayer";
  import { audioPlayerManager } from "@/subpackages/utils/voice/audioPlayerManager";
  import { voiceStreamSpeaker } from "@/subpackages/utils/voice/voiceStreamSpeaker";
  import { speechSocketWarmup, CHAT_PAGE_LONG_HIDE_MS } from "@/subpackages/utils/voice/speechSocketWarmup";
  import { pageSystemOverlay } from "@/subpackages/utils/pageSystemOverlay.uts";
  import { stopAllSpeechPlayback } from "@/subpackages/utils/voice/stopAllSpeechPlayback";
  import {
    loadVoiceSettings,
    saveVoiceSettings,
    cloneVoiceSettings,
  } from "@/subpackages/utils/voice/voiceTypes";

  // 类型定义
  import {
    MessageTypeEnum,
    AssistantRoleEnum,
  } from "@/types/enums/agent";
  import type { ChatInputPhoneRef } from "@/types/interfaces/chat.uts";
  import type { MessageInfo } from "@/types/interfaces/conversationInfo.uts";
  import type { UploadFileStatus } from "@/types/enums/common.uts";
  import type { TenantConfigInfo } from "@/types/interfaces/login";
  import {
    AttachmentFile,
    OpenAppParams,
    ConversationChatResponse,
    ConversationInfo,
  } from "@/types/interfaces/conversationInfo.uts";
  import { RequestResponse } from "@/types/interfaces/request.uts";
  import {
    EventBindConfig,
    EventConfig,
    EventArg,
    AgentManualComponentInfo,
    AgentSelectedComponentInfo,
  } from "@/types/interfaces/agent";
  import type { ShowPagePreviewOptions } from "@/types/interfaces/agent";
  import { MessageStatusEnum, ProcessingEnum } from "@/types/enums/common.uts";
  import { TaskStatus, EventBindResponseActionEnum } from "@/types/enums/agent";
  import { UploadFileInfo } from "@/types/interfaces/common";

  // 组件
  import MorePopup from "./components/more-popup/more-popup.uvue";
  import AgentSubscriptionModal from "./components/agent-subscription-modal/agent-subscription-modal.uvue";
  import ChatInputPhone from "@/subpackages/components/chat-input-phone/chat-input-phone.uvue";
  import NewConversationSet from "./components/new-conversation-set/new-conversation-set.uvue";
  import FileTree from "./components/file-tree/file-tree.uvue";
  import ToolDetailsModal from "./components/tool-details-modal/tool-details-modal.uvue";
  // 显式导入 uni-ai-x-msg 组件（H5 上 easycom 扫描不到 uni_modules/uni-ai-x，需手动注册）
  import UniAiXMsg from "@/subpackages/components/ai-msg/ai-msg.uvue";
  import VoiceConversationPanel from "@/subpackages/components/voice-conversation-panel/voice-conversation-panel.uvue";
  import { voiceConfig } from "@/subpackages/utils/voice/voiceConfig";
  import proxyWeb from "@/uni_modules/uni-ai-x/sdk/proxy-web.uts";

  // 常量
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import {
    TEMP_CONVERSATION_UID,
    TEMP_CHAT_KEY,
  } from "@/constants/common.constants";
  import docImage from "@/static/assets/doc_image.png";
  import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
  import { API_BASE_URL } from "@/constants/config";
  import { EVENT_TYPE } from "@/subpackages/constants/event.constants";

  // ==================== API ====================
  import { apiAgentConversation } from "@/servers/conversation";
  import { apiTenantConfig } from "@/servers/account";
  import { apiUserTicketCreate } from "@/servers/agentDev";
  import {
    useMessageEventDelegate,
    handleMessageEventClick,
    EventDedupManager,
  } from "@/subpackages/hooks/useMessageEventDelegate.uts";
  import { usePageResume, PageResumeOptions } from "@/subpackages/hooks/usePageResume.uts";
  import {
    startConversationPolling,
    stopConversationPolling,
    resumeConversationPolling,
    pauseConversationPolling,
    destroyConversationPolling,
  } from "@/subpackages/hooks/useConversationStatusPolling.uts";
  import {
    isTurnUserReadyFromRawMessageList,
    isTurnUserReadyFromMessageInfoList,
  } from "@/subpackages/utils/subResumeGate.uts";

  // ==================== 工具方法 ====================
  import { formatBytes } from "@/utils/byteConverter.uts";
  import { objectToQueryString } from "@/utils/common";
  import { chatService } from "@/utils/chatService";
  import { handleExternalLink } from "@/utils/system.uts";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system.uts";
  import eventBus from "@/utils/eventBus";
  import { throttle } from "@/subpackages/utils/functionUtils";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import { getUniLoadMoreContentText, UniLoadMoreContentText } from "@/utils/i18n-third-party";
  import { hasUploadErrorInFiles } from "@/subpackages/components/chat-input-phone/chatInputActions.uts";
  import {
    getExpandPageAreaFlag,
    getHideChatAreaFlag,
    isAgentTypeTaskAgent,
    isDefaultSelectedNo,
    isDefaultSelectedYes,
    readAgentInfoField,
    readAgentStringField,
    readAgentTypeString,
  } from "@/subpackages/utils/agentInfoField.uts";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { consumePendingChatDraft } from "@/utils/pendingChatDraft";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
  const historyLoadMoreContentText = computed((): UniLoadMoreContentText =>
    getUniLoadMoreContentText(
      "",
      t("Mobile.Conversation.loadingHistory"),
      "",
    ),
  );

  /** 文件树弹窗组件引用 */
  interface FileTreePopupRef {
    open: any;
    close: any;
  }

  // 接收组件属性，设置默认值
  const props = withDefaults(
    defineProps<{
      isTempChat?: boolean;
      isAppDetails?: boolean; // 是否是应用智能体页面
    }>(),
    {
      isTempChat: false,
      isAppDetails: false,
    },
  );

  // 定义 emits
  const emit = defineEmits<{
    // 菜单按钮点击事件
    (e: "menu-click"): void;
  }>();

  // 菜单按钮点击事件
  const onMenuClick = () => {
    emit("menu-click");
  };

  // 创建防重复触发管理器（可选）
  const dedupManager = new EventDedupManager(1000);

  // 定义 chat-input-phone 组件的引用
  const agentDetailInputPhoneRef = ref<any | null>(null);
  const newConversationSetRef = ref<any | null>(null);

  /**
   * 读取 new-conversation-set 暴露的变量参数。
   * Android：Gen* 组件禁止 as UTSJSONObject，须用 $callMethod 调 defineExpose 方法。
   */
  const getConvSetVariableParams = (): any | null => {
    const convSet = newConversationSetRef.value as any | null;
    if (convSet == null) {
      return null;
    }
    try {
      const proxy = convSet as ComponentPublicInstance;
      const result = proxy.$callMethod("getVariableParams");
      return result;
    } catch (_e) {
      return null;
    }
  };

  /**
   * 读取 chat-input-phone 附件 / 已选组件。
   * Android：禁止对 Gen* 组件 as UTSJSONObject 读 expose 的 ref。
   */
  const getInputPhoneGuidePayload = (): UTSJSONObject => {
    const payload: UTSJSONObject = {
      "files": [] as any[],
      "selectedComponents": [] as any[],
      "existErrorFile": false,
    };
    const inputPhoneRef = agentDetailInputPhoneRef.value as any | null;
    if (inputPhoneRef == null) {
      return payload;
    }
    try {
      const proxy = inputPhoneRef as ComponentPublicInstance;
      const filesResult = proxy.$callMethod("getFiles");
      const compsResult = proxy.$callMethod("getSelectedComponents");
      const filesArr =
        filesResult != null ? (filesResult as UTSJSONObject[]) : ([] as UTSJSONObject[]);
      payload["files"] = filesArr;
      payload["selectedComponents"] =
        compsResult != null ? compsResult : ([] as any[]);
      payload["existErrorFile"] = hasUploadErrorInFiles(filesArr);
    } catch (_e) {
      // ignore
    }
    return payload;
  };
  // 聊天内容区域引用用于绑定自定义事件代理
  const msgListContentRef = ref<any | null>(null);
  // 事件绑定配置
  const eventBindConfig = ref<EventBindConfig | null>(null);
  // 阿里云验证码按钮id
  const buttonId = ref<string>("aliyun-captcha-id");
  // 租户配置信息
  const tenantConfigInfo = ref<any | null>(null);
  // 页面预览iframe引用
  const pagePreviewIframeRef = ref<any | null>(null);
  // 页面预览是否可见
  const pagePreviewVisible = ref(false);
  const msgListRef = ref<any | null>(null);
  // 用户临时票据
  const ticket = ref<string>("");
  /** 关闭自动播报时为 true（持久化于 VoiceSettings.autoPlay） */
  const voiceAutoPlayOff = ref<boolean>(loadVoiceSettings().autoPlay != true);
  /**
   * 是否渲染输入框组件， 进入页面后渲染，离开页面后卸载组件
   * 出现一个bug，当从智能体详情页面返回首页时，录音后发送消息事件触发的是智能体详情页绑定的消息事件，而不是首页绑定的消息事件
   * 所以需要卸载输入框组件，重新渲染输入框组件
   */
  const isRenderInputPhone = ref<boolean>(false);

  // 文件树弹窗是否可见
  const popupFileTreeVisible = ref<boolean>(false);

  // 文件树引用
  const fileTreeRef = ref<FileTreePopupRef | null>(null);

  // 工具详情弹窗引用
  const toolDetailsModalRef = ref<any | null>(null);
  const toolDetailData = ref<any | null>(null);
  const toolDetailTitle = ref<string>("");

  // 处理返回首页
  const handleBackHome = () => {
    uni.switchTab({
      url: "/pages/index/index",
    });
  };

  const updateVisible = (value: boolean) => {
    pagePreviewVisible.value = value;
  };

  // 处理文件树弹窗可见性变化
  const updatePopupFileTreeVisible = (value: boolean) => {
    popupFileTreeVisible.value = value;
  };
  // ==================== 初始化分层架构 ====================
  // 创建各层实例
  const data = new AgentDetailData();
  data.isTempChat.value = props.isTempChat;
  const service = new AgentDetailService(data);
  const componentManager = new ComponentManager(data);
  const scrollManager = new ScrollManager(data);

  /** 非空字符串兜底 */
  const coalesceNonEmptyString = (
    value: string | null | undefined,
    fallback: string,
  ): string => {
    if (value != null) {
      const text = value as string;
      if (text.length > 0) {
        return text;
      }
    }
    return fallback;
  };

  /** 是否应自动滚动到底部 */
  const shouldAutoScrollToLast = (): boolean => {
    if (data.scrollTouch.value == true) {
      return false;
    }
    return data.autoToLastMsg.value == true;
  };

  // ==================== 暴露方法给模板 ====================

  // 数据层
  const {
    agentId,
    agentName,
    agentInfo,
    pageHomeUrl,
    conversationId,
    messageList,
    streamingAssistantText,
    streamingAssistantMessageId,
    chatSuggestList,
    requestId,
    isTempChat,
    messageIdRef,
    captchaVerifyParam,
    chatKey,
    conversationUid,
    conversationInfo,
    needUpdateTopicRef,
    manualComponents,
    selectedComponents,
    variables,
    userFillVariables,
    processingList,
    scrollIntoView,
    scrollInBottom,
    scrollWithAnimation,
    scrollTouch,
    scrolling,
    keyboardHeight,
    refMorePopup,
    refSubscriptionModal,
    isStoppingConversation,
    isConversationActive,
    isSendMessageRef,
    wholeDisabled,
    fileList,
    isLoadingFiles,
    sandboxList,
    currentSandboxId,
    isSandboxSwitchDisabled,
    isSandboxUnavailable,
    sandboxDisabledText,
    isLoadingMoreMessages,
    hasMoreMessages,
    currentModelId,
    currentModelName,
    modelSelectVisible,
    subscriptionRequired,
    subscriptionModalVisible,
    localCalledTrialCount,
  } = data;

  /**
   * 将开场白中的常见 HTML 转为 Markdown。
   * 仅使用 RegExp + 固定替换字符串，避免 Android UTS 不支持 replace 回调。
   */
  function normalizeOpeningChatHtml(source: string): string {
    let result = source;
    result = result.replace(/<!--[\s\S]*?-->/g, "");
    result = result.replace(/<script[^>]*>[\s\S]*?<\/script>/gi, "");
    result = result.replace(/<style[^>]*>[\s\S]*?<\/style>/gi, "");
    result = result.replace(/<br\s*\/?>/gi, "\n");
    result = result.replace(/<hr\s*\/?>/gi, "\n\n---\n\n");
    result = result.replace(/<h1[^>]*>([\s\S]*?)<\/h1>/gi, "\n# $1\n");
    result = result.replace(/<h2[^>]*>([\s\S]*?)<\/h2>/gi, "\n## $1\n");
    result = result.replace(/<h3[^>]*>([\s\S]*?)<\/h3>/gi, "\n### $1\n");
    result = result.replace(/<(strong|b)[^>]*>([\s\S]*?)<\/(strong|b)>/gi, "**$2**");
    result = result.replace(/<(em|i)[^>]*>([\s\S]*?)<\/(em|i)>/gi, "*$2*");
    result = result.replace(/<code[^>]*>([\s\S]*?)<\/code>/gi, "`$1`");
    result = result.replace(/<li[^>]*>([\s\S]*?)<\/li>/gi, "\n- $1");
    result = result.replace(/<(div|p)[^>]*>([\s\S]*?)<\/(div|p)>/gi, "\n$2\n");
    result = result.replace(/<\/?(ul|ol)[^>]*>/gi, "\n");
    result = result.replace(/<a[^>]*href=["']([^"']*)["'][^>]*>([\s\S]*?)<\/a>/gi, "[$2]($1)");
    result = result.replace(/<[^>]+>/g, "");
    result = result.replace(/&nbsp;/g, " ");
    result = result.replace(/&lt;/g, "<");
    result = result.replace(/&gt;/g, ">");
    result = result.replace(/&quot;/g, '"');
    result = result.replace(/&#39;|&apos;/g, "'");
    result = result.replace(/&amp;/g, "&");
    result = result.replace(/\n{3,}/g, "\n\n");
    return result.trim();
  }

  /**
   * 转换普通 HTML，同时原样保留 task-result 自定义块供消息解析器处理。
   */
  function normalizeOpeningChatContent(source: string): string {
    const regex =
      /<task-result\b[^>]*>[\s\S]*?<\/task-result>/gi;
    const fragments = [] as string[];
    let cursor = 0;
    let match = regex.exec(source);
    while (match != null) {
      const before = source.substring(cursor, match.index);
      if (before.length > 0) {
        fragments.push(normalizeOpeningChatHtml(before));
      }
      const taskBlock = match[0] != null ? match[0]! : "";
      if (taskBlock.length > 0) {
        fragments.push(taskBlock);
      }
      cursor = regex.lastIndex;
      match = regex.exec(source);
    }
    const after = source.substring(cursor);
    if (after.length > 0) {
      fragments.push(normalizeOpeningChatHtml(after));
    }
    return fragments.join("\n\n").trim();
  }

  /** 开场白统一转换为 UniAiXMsg 可解析的 Markdown。 */
  const openingChatBody = computed((): string => {
    const source = readAgentStringField(agentInfo.value, "openingChatMsg");
    if (source.trim().length == 0) {
      return "";
    }
    const hasHtmlTag = /<\/?[a-zA-Z][^>]*>/.test(source);
    return hasHtmlTag ? normalizeOpeningChatContent(source) : source;
  });

  // 是否显示webview（须位于 data 解构之后，showNavCreateConversation 之前）
  const isShowWebView = computed((): boolean => {
    const info = agentInfo.value;
    if (info == null) {
      return false;
    }
    const expandYes = getExpandPageAreaFlag(info) == 1;
    const hideChat = getHideChatAreaFlag(info) == 1;
    if (expandYes == true) {
      if (hideChat == true) {
        return true;
      }
    }
    return false;
  });

  /**
   * 模板：消息附件列表。
   * Android 上元素是 UTSJSONObject，禁止 as AttachmentFile[]。
   * 须先于 hasMessageAttachments 声明（UTS const 箭头不可前向引用）。
   */
  const getMessageAttachments = (item: any | null): any[] => {
    const raw = readRawField(item, "attachments");
    if (raw == null) {
      return [] as any[];
    }
    try {
      const list = raw as any[];
      if (list != null && list.length >= 0) {
        return list;
      }
    } catch (_e) {
      // ignore
    }
    return [] as any[];
  };

  /** 消息是否含附件（Android：attachments 为 UTSJSONObject[]，勿强转 AttachmentFile） */
  const hasMessageAttachments = (item: any | null): boolean => {
    return getMessageAttachments(item).length > 0;
  };

  /** 安全读取附件字段字符串。 */
  const readAttachmentString = (file: any | null, key: string): string => {
    const raw = readRawField(file, key);
    return raw != null ? `${raw}` : "";
  };

  /** 模板：附件 mimeType */
  const getAttachmentMimeType = (file: any | null): string => {
    return readAttachmentString(file, "mimeType");
  };

  /** 模板：附件 fileUrl */
  const getAttachmentFileUrl = (file: any | null): string => {
    return readAttachmentString(file, "fileUrl");
  };

  /** 模板：附件 fileName */
  const getAttachmentFileName = (file: any | null): string => {
    return readAttachmentString(file, "fileName");
  };

  /** 模板：附件列表 key */
  const getAttachmentFileKey = (file: any | null, index: number): string => {
    const key = readAttachmentString(file, "fileKey");
    return key.length > 0 ? key : `att-${index}`;
  };

  /**
   * 是否助手消息。
   * Android：枚举 toString 可能是带 value 的对象描述，用 indexOf 兜底。
   */
  function isAssistantMessage(item: any | null): boolean {
    if (item == null) {
      return false;
    }
    const msg = item as MessageInfo;
    if (msg.messageType == MessageTypeEnum.ASSISTANT) {
      return true;
    }
    if (msg.role == AssistantRoleEnum.ASSISTANT) {
      return true;
    }
    const typeStr = `${msg.messageType}`;
    const roleStr = `${msg.role}`;
    if (typeStr == "ASSISTANT" || roleStr == "ASSISTANT") {
      return true;
    }
    if (typeStr.indexOf("ASSISTANT") >= 0 || roleStr.indexOf("ASSISTANT") >= 0) {
      return true;
    }
    // 明确排除 USER，避免误判
    if (msg.messageType == MessageTypeEnum.USER || msg.role == AssistantRoleEnum.USER) {
      return false;
    }
    if (typeStr.indexOf("USER") >= 0 || roleStr.indexOf("USER") >= 0) {
      return false;
    }
    return false;
  }

  /**
   * 安全读取用户消息文本（Android：勿依赖模板 item?.text）
   * UTS：const 箭头函数不能互相按名调用，须用 function 声明
   */
  function getUserMessageText(item: any | null): string {
    if (item == null) {
      return "";
    }
    const textRaw = readRawField(item, "text");
    if (textRaw != null && `${textRaw}`.length > 0) {
      return `${textRaw}`;
    }
    return "";
  }

  /** 助手正文（字符串通道，App 勿只依赖 MsgItem prop） */
  function getAssistantBodyText(item: any | null): string {
    return getUserMessageText(item);
  }

  /**
   * 流式会话中最后一条助手消息优先走 streamingAssistantText，
   * 避免 iOS / H5 上 MessageInfo 批量更新或 Markdown 打字机导致气泡不刷新。
   * 服务端可能改写助手 id，故不能仅做严格 id 相等；新一轮发送前会 clear 通道防串文。
   */
  function resolveAssistantBodyText(item: any | null, listIndex: number): string {
    if (isConversationActive.value) {
      const list = messageList.value;
      if (list.length - 1 == listIndex) {
        const streamText = streamingAssistantText.value;
        if (streamText.length > 0) {
          const streamMsgId = streamingAssistantMessageId.value;
          const itemIdRaw = readRawField(item, "id");
          const itemId = itemIdRaw != null ? `${itemIdRaw}` : "";
          if (
            streamMsgId.length == 0 ||
            itemId.length == 0 ||
            itemId == streamMsgId
          ) {
            return streamText;
          }
          // id 已被服务端改写，但流式正文不短于列表项：仍走打字机通道
          const itemText = getAssistantBodyText(item);
          if (streamText.length >= itemText.length) {
            return streamText;
          }
        }
      }
    }
    return getAssistantBodyText(item);
  }

  /** 助手思考内容 */
  function getAssistantThinkText(item: any | null): string {
    if (item == null) {
      return "";
    }
    const thinkRaw = readRawField(item, "think");
    if (thinkRaw != null && `${thinkRaw}`.length > 0) {
      return `${thinkRaw}`;
    }
    return "";
  }

  /** 预计算的可播报正文（工具栏优先使用，避免点击时再过滤） */
  function getAssistantSpeakableText(item: any | null): string {
    if (item == null) {
      return "";
    }
    const speakableRaw = readRawField(item, "speakableText");
    if (speakableRaw != null && `${speakableRaw}`.length > 0) {
      return `${speakableRaw}`;
    }
    return "";
  }

  const emptyAssistantProcessingList = [] as any[];
  const emptyAssistantMarkdownElList = [] as any[];

  /** 助手工具调用数据直接透传，避免先构造 MsgItem。 */
  function getAssistantProcessingList(item: any | null): any[] {
    if (item == null) return emptyAssistantProcessingList;
    const raw = readRawField(item, "processingList");
    return raw != null && Array.isArray(raw)
      ? raw as any[]
      : emptyAssistantProcessingList;
  }

  /** 接口若已携带 Markdown 元素则直接透传，由消息组件按需规范化。 */
  function getAssistantMarkdownElList(item: any | null): any[] {
    if (item == null) return emptyAssistantMarkdownElList;
    const raw = readRawField(item, "markdownElList");
    return raw != null && Array.isArray(raw)
      ? raw as any[]
      : emptyAssistantMarkdownElList;
  }

  /** 用户消息是否有可展示文本 */
  function hasUserMessageText(item: any | null): boolean {
    return getUserMessageText(item).length > 0;
  }

  const lastAssistantMessage = computed((): MessageInfo | null => {
    const list = messageList.value;
    for (let i = list.length - 1; i >= 0; i--) {
      const item = list[i];
      if (isAssistantMessage(item)) {
        return item;
      }
    }
    return null;
  });

  const assistantMsgId = computed((): string => {
    const msg = lastAssistantMessage.value;
    if (msg == null) return "";
    const index = msg.index != null ? `${msg.index}` : "0";
    return `${msg.id}_${index}`;
  });
  /** 边生成边播报 / 语音面板：会话进行中优先用 streamingAssistantText */
  const assistantStreamText = computed((): string => {
    if (isConversationActive.value == true) {
      const streamText = streamingAssistantText.value;
      if (streamText.length > 0) {
        return streamText;
      }
    }
    return getAssistantBodyText(lastAssistantMessage.value);
  });
  const assistantThinkText = computed((): string => getAssistantThinkText(lastAssistantMessage.value));
  const assistantStreamStatus = computed((): string => {
    const msg = lastAssistantMessage.value;
    if (msg == null || msg.status == null) return "";
    if (msg.status == MessageStatusEnum.Loading) return "loading";
    if (msg.status == MessageStatusEnum.Incomplete) return "incomplete";
    if (msg.status == MessageStatusEnum.Complete) return "complete";
    if (msg.status == MessageStatusEnum.Failed) return "error";
    return `${msg.status}`;
  });
  const voiceConversationKey = computed((): string => `${conversationId.value}`);
  // 语音会话功能总开关（见 voiceConfig.enableVoiceConversation，便于调试原会话页时关闭）
  const voiceConversationEnabled = computed((): boolean => voiceConfig.enableVoiceConversation);

  /** 当前无面板时的无头边生成边播报会话 id（避免与面板重复 begin） */
  let headlessStreamSpeakId: string = "";
  /** 最近一次 SSE 喂入的正文 / 消息 id（结束冲刷尾句用） */
  let feedSpeakBodyText: string = "";
  let feedSpeakMsgId: string = "";
  /**
   * 硬停止后为 false：忽略 abort/seal 迟到的 streamSpeakFeed，避免停会话后又 begin 播报，
   * 导致工具栏一直 isSpeaking。发新消息前须 resumeStreamSpeakAllowance()。
   */
  let streamSpeakAllowed: boolean = true;
  /** TTS 喂入合并定时器（仅节流 onStreamChunk，不影响 UI 刷新） */
  let feedSpeakTimer: number = 0;
  /** TTS 喂入合并窗口（ms）：降低长回复上 cleanText/分句频率 */
  const FEED_SPEAK_COALESCE_MS: number = 100;

  function resumeStreamSpeakAllowance(): void {
    streamSpeakAllowed = true;
  }

  function clearFeedSpeakTimer(): void {
    if (feedSpeakTimer != 0) {
      clearTimeout(feedSpeakTimer);
      feedSpeakTimer = 0;
    }
  }

  /** 仅停播并清空喂入状态，不改 streamSpeakAllowed */
  function interruptStreamSpeakPlayback(): void {
    clearFeedSpeakTimer();
    headlessStreamSpeakId = "";
    feedSpeakBodyText = "";
    feedSpeakMsgId = "";
    stopAllSpeechPlayback();
  }

  function stopAllStreamSpeech(hardStop: boolean): void {
    clearFeedSpeakTimer();
    headlessStreamSpeakId = "";
    const tailBody = feedSpeakBodyText;
    feedSpeakBodyText = "";
    feedSpeakMsgId = "";
    if (hardStop == true) {
      // 用户点停止 / 离页：禁止迟到 feed 再 begin
      streamSpeakAllowed = false;
      stopAllSpeechPlayback();
    } else {
      // 正常结束：冲刷尾句，已入队音频继续播完
      const body =
        tailBody.length > 0 ? tailBody : assistantStreamText.value;
      voiceStreamSpeaker.onStreamChunk(body, "", true);
    }
  }

  /** 服务层发送新消息：只停播，保持本轮可播额度 */
  function handleStreamSpeakInterrupt(_data: any): void {
    interruptStreamSpeakPlayback();
    streamSpeakAllowed = true;
  }

  /**
   * 开启无头实时播报（App / H5 / 小程序统一）。
   * 优先使用 SSE 事件带入的 messageId / bodyText，避免依赖 watch。
   * - 同消息已在播：不二次 begin（避免长 SSE 清队列只剩一句）
   * - 异消息 / 工具栏旧播报 / 续接新流：先 stop 再 begin
   * TTS 异常由 voiceStreamSpeaker / stopAllSpeechPlayback 内部兜底，此处不加 try/catch（uvue setup 易被 UTS 截断）。
   */
  function ensureHeadlessStreamSpeak(
    preferMsgId: string = "",
    preferBody: string = "",
  ): void {
    if (voiceConversationEnabled.value == true) {
      // 面板已接管，避免双重 begin
      return;
    }
    if (streamSpeakAllowed != true) {
      return;
    }
    const settings = loadVoiceSettings();
    // 关闭自动播报：SSE 不 begin/feed；工具栏手动播报不受影响
    if (settings.autoPlay != true) {
      return;
    }
    let msgId = preferMsgId;
    if (msgId.length == 0) {
      msgId = streamingAssistantMessageId.value;
    }
    if (msgId.length == 0) {
      const last = lastAssistantMessage.value;
      if (last != null && last.id != null) {
        msgId = `${last.id}`;
      }
    }
    if (msgId.length == 0) {
      return;
    }
    const busy = voiceStreamSpeaker.isBusy() == true;
    const busyId = busy ? voiceStreamSpeaker.getMessageId() : "";
    // 本轮同消息已在播：只同步 tracking，禁止二次 begin
    if (busy == true && busyId == msgId) {
      headlessStreamSpeakId = msgId;
      return;
    }
    if (busy != true && headlessStreamSpeakId == msgId) {
      return;
    }
    // 续接 / 新流 / 工具栏旧播报：先停再播目标消息
    stopAllSpeechPlayback();
    headlessStreamSpeakId = msgId;
    audioPlayerManager.setMuted(settings.muted == true);
    const speakSettings = cloneVoiceSettings(settings);
    voiceStreamSpeaker.begin(msgId, speakSettings);
    // begin/stop 会拆掉「按下录音」时的 TTS 预热；立刻重建，避免首句合成卡在建连上被 SSE 饿死
    ttsWebSocketPlayer.enableWarmupAndConnect();
    // preferMsgId 已指定时：正文以 preferBody 为准（可空），禁止回落到上一条助手全文
    let body = assistantStreamText.value;
    if (preferMsgId.length > 0) {
      body = preferBody;
    } else if (preferBody.length > 0) {
      body = preferBody;
    }
    if (body.length > 0) {
      voiceStreamSpeaker.onStreamChunk(body, "", false);
    }
  }

  function feedHeadlessStreamSpeak(
    finished: boolean,
    bodyText: string = "",
  ): void {
    if (voiceConversationEnabled.value == true) {
      return;
    }
    if (streamSpeakAllowed != true) {
      return;
    }
    const body = bodyText.length > 0 ? bodyText : feedSpeakBodyText;
    // 统一走 ensure：同消息不打断；异消息 / 续接新流先停再播
    ensureHeadlessStreamSpeak(
      feedSpeakMsgId.length > 0 ? feedSpeakMsgId : "",
      body,
    );
    if (headlessStreamSpeakId.length == 0) {
      return;
    }
    if (body.length == 0 && finished != true) {
      return;
    }
    voiceStreamSpeaker.onStreamChunk(body, "", finished);
  }

  /**
   * 喂播报：更新最新正文快照；流式中合并推送，结束时立刻冲刷尾句。
   * 合并只作用于 TTS，不影响 messageList / Markdown UI。
   */
  function feedHeadlessStreamSpeakNow(
    finished: boolean,
    bodyText: string = "",
    messageId: string = "",
  ): void {
    if (bodyText.length > 0) {
      feedSpeakBodyText = bodyText;
    }
    if (messageId.length > 0) {
      feedSpeakMsgId = messageId;
    }
    // 流结束必须立刻冲刷，避免尾句被合并窗口截断
    if (finished == true) {
      clearFeedSpeakTimer();
      feedHeadlessStreamSpeak(true, feedSpeakBodyText);
      return;
    }
    if (feedSpeakTimer != 0) {
      return;
    }
    feedSpeakTimer = setTimeout((): void => {
      feedSpeakTimer = 0;
      feedHeadlessStreamSpeak(false, feedSpeakBodyText);
    }, FEED_SPEAK_COALESCE_MS);
  }

  /**
   * SSE 成功输出驱动播报（AgentDetailService → streamSpeakFeed）。
   * TTS 与渲染解耦：异常由 .uts 侧 safeEmit / onStreamChunk 兜底。
   */
  function handleStreamSpeakFeed(data: any): void {
    if (voiceConversationEnabled.value == true) {
      return;
    }
    if (data == null) {
      return;
    }
    const obj = data as UTSJSONObject;
    const messageId =
      obj["messageId"] != null ? `${obj["messageId"]}` : "";
    const bodyText =
      obj["bodyText"] != null ? `${obj["bodyText"]}` : "";
    const finished = obj["finished"] == true;
    // 有正文/终态喂入时兜底恢复额度（防止发送路径漏 resume）
    if (streamSpeakAllowed != true) {
      if (bodyText.length == 0 && finished != true) {
        return;
      }
      streamSpeakAllowed = true;
    }
    if (finished == true) {
      ensureHeadlessStreamSpeak(messageId, bodyText);
      feedHeadlessStreamSpeakNow(true, bodyText, messageId);
      return;
    }
    if (bodyText.length == 0) {
      return;
    }
    ensureHeadlessStreamSpeak(messageId, bodyText);
    feedHeadlessStreamSpeakNow(false, bodyText, messageId);
  }

  /** 是否消息列表最后一条（模板辅助，避免模板中做 nullable 算术） */
  const isLastMessage = (listIndex: number): boolean => {
    const list = messageList.value;
    return list.length - 1 == listIndex;
  };

  /** Android：API 返回字符串，禁止 string as TaskStatus；const 箭头函数不可递归 */
  const parseTaskStatus = (val: any | null): TaskStatus | null => {
    if (val == null) {
      return null;
    }
    let raw: any | null = val;
    try {
      const obj = val as UTSJSONObject;
      const nested = obj["value"];
      if (nested != null) {
        raw = nested;
      }
    } catch (_e) {
      // not object
    }
    const s = `${raw}`;
    if (s == "CREATE") return TaskStatus.CREATE;
    if (s == "CANCEL") return TaskStatus.CANCEL;
    if (s == "EXECUTING") return TaskStatus.EXECUTING;
    if (s == "COMPLETE") return TaskStatus.COMPLETE;
    if (s == "FAILED") return TaskStatus.FAILED;
    return null;
  };

  /** 当前会话 taskStatus（模板辅助，避免 optional 链与 dot 访问编译失败） */
  const conversationTaskStatus = computed((): TaskStatus | null => {
    const info = conversationInfo.value;
    if (info == null) {
      return null;
    }
    const obj = info as UTSJSONObject;
    return parseTaskStatus(obj["taskStatus"]);
  });

  /** 会话任务是否执行中（模板辅助，避免模板中引用枚举类与 ===） */
  const isTaskExecuting = computed((): boolean => {
    return conversationTaskStatus.value == TaskStatus.EXECUTING;
  });

  /** 是否图片 MIME */
  const isImageMimeType = (mimeType: string | null | undefined): boolean => {
    if (mimeType == null) {
      return false;
    }
    return (mimeType as string).indexOf("image/") >= 0;
  };

  /** 附件卡片样式类名 */
  const getFileBoxClassName = (mimeType: string | null | undefined): string => {
    if (isImageMimeType(mimeType) == true) {
      return "files-box-image";
    }
    return "files-box-file";
  };

  /** 上传图片 alt 文案 */
  const getUploadImageAlt = (fileName: string | null | undefined): string => {
    return coalesceNonEmptyString(fileName, tFn("Mobile.Chat.uploadImageAlt", emptyI18nParams(), ""));
  };

  /** 模板中调用 t 的便捷包装（UTS 不允许模板里调用带默认参数的方法） */
  const tt = (key: string): string => t(key);

  /** 模板中安全读取文件大小（UTS 不允许模板里把 nullable 传给非空参数） */
  const safeFileSize = (file: any): number => {
    const sizeVal = readRawField(file, "fileSize");
    if (sizeVal != null) {
      const n = parseFloat(`${sizeVal}`);
      if (isNaN(n) == false) {
        return n;
      }
    }
    return 0;
  };

  /** 模板中安全格式化文件大小（合并读取与格式化，避免模板里嵌套调用） */
  const formatFileSize = (file: any): string => {
    return formatBytes(safeFileSize(file));
  };

  /** 模板中读取 agentInfo 字段（UTSJSONObject 用 bracket） */
  const agentInfoField = (key: string): any | null => {
    const info = agentInfo.value;
    if (info == null) {
      return null;
    }
    return info[key];
  };

  /** 导航栏是否显示「新建会话」 */
  const showNavCreateConversation = computed((): boolean => {
    return isShowWebView.value == false;
  });

  /** 输入框 pageHomeIndex */
  const inputPageHomeIndex = computed((): string => {
    return readAgentStringField(agentInfo.value, "pageHomeIndex");
  });

  /** 输入框 expandPageArea（Android：readRawField + 枚举字符串比较） */
  const inputExpandPageArea = computed((): number => {
    return getExpandPageAreaFlag(agentInfo.value);
  });

  /** 输入框 manualComponents */
  const inputManualComponents = computed((): AgentManualComponentInfo[] => {
    const info = agentInfo.value;
    if (info == null) {
      return [];
    }
    const comps = info["manualComponents"];
    if (comps != null) {
      return parseManualComponents(comps);
    }
    return [];
  });

  /** 输入框 hasPermission */
  const inputHasPermission = computed((): boolean => {
    const info = agentInfo.value;
    if (info == null) {
      return true;
    }
    if (info["hasPermission"] == true) {
      return true;
    }
    return false;
  });

  /** 是否任务型智能体 */
  const isTaskAgentType = computed((): boolean => {
    return isAgentTypeTaskAgent(agentInfo.value);
  });

  /** 是否设备智能体 (deviceAgent == 1) */
  const isDeviceAgent = computed((): boolean => {
    const raw = readAgentInfoField(agentInfo.value, "deviceAgent");
    return raw == 1 || raw == "1";
  });

  /** 是否允许 @ 技能 */
  const inputEnableSkillAt = computed((): boolean => {
    return isDefaultSelectedYes(readAgentInfoField(agentInfo.value, "allowAtSkill"));
  });

  /** 是否允许切换模型 */
  const inputAllowOtherModel = computed((): boolean => {
    return isDefaultSelectedYes(readAgentInfoField(agentInfo.value, "allowOtherModel"));
  });

  /** 是否允许切换自动/审批模式（Android 模板传参使用数值） */
  const inputAllowChooseMode = computed((): number => {
    return isDefaultSelectedYes(readAgentInfoField(agentInfo.value, "allowChooseMode"))
      ? 1
      : 0;
  });

  /** 沙盒只读 */
  const inputReadonlySandbox = computed((): boolean => {
    return isDefaultSelectedNo(readAgentInfoField(agentInfo.value, "allowPrivateSandbox"));
  });

  /** 当前模型 ID / 名称（Android 模板传参用 computed） */
  const inputCurrentModelId = computed((): number => {
    const id = currentModelId.value;
    if (id == null) {
      return 0;
    }
    return id;
  });

  const inputCurrentModelName = computed((): string => {
    const name = currentModelName.value;
    if (name == null) {
      return "";
    }
    return `${name}`;
  });

  const inputAgentTypeStr = computed((): string => {
    const typeStr = readAgentTypeString(agentInfo.value);
    if (typeStr.length == 0) {
      return "ChatBot";
    }
    return typeStr;
  });

  // 处理禁用发送按钮
  const handleToggleWholeDisabled = (disabled: boolean) => {
    data.wholeDisabled.value = disabled;
  };

  // 服务层 - 使用箭头函数保持this上下文
  const handleQueryConversation = (result: RequestResponse<ConversationInfo>) =>
    service.handleQueryConversation(result);
  const handleChangeMessageList = (
    res: ConversationChatResponse,
    currentMessageId: string,
  ) => service.handleChangeMessageList(res, currentMessageId);

  // 停止会话：掐断 SSE + 停止播报；已输出正文保留并由 Markdown 终态渲染
  const handleStopConversation = () => {
    stopAllStreamSpeech(true);
    service.handleStopConversation(props.isTempChat);
  };
  const createNewConversation = (isAppDetails: boolean) =>
    service.createNewConversation(isAppDetails);
  function getPublishedAgentInfo(appParams: OpenAppParams | null) {
    // Android：禁止 null as OpenAppParams；服务层参数改为可空
    service.getPublishedAgentInfo(appParams);
  }
  const handleCollect = () => service.handleCollect();

  // 重启智能体
  const handleRestartAgent = () => service.handleRestartAgent();

  // 重启沙箱
  const handleRestartSandbox = () =>
    service.handleRestartSandbox(data.currentSandboxId.value == "-1");
  // 清空会话数据
  const clearConversationData = (isTempChat: boolean) =>
    service.clearConversationData(isTempChat);

  // 触发打开订阅/升级计划模态框
  const handleOpenSubscription = () => {
    subscriptionModalVisible.value = true;
    nextTick(() => {
      const subRef = refSubscriptionModal.value as any | null;
      if (subRef != null) {
        const proxy = subRef as ComponentPublicInstance;
        proxy.$callMethod("open");
      } else {
        setTimeout(() => {
          const subRefLater = refSubscriptionModal.value as any | null;
          if (subRefLater != null) {
            const proxyLater = subRefLater as ComponentPublicInstance;
            proxyLater.$callMethod("open");
          }
        }, 50);
      }
    });
  };

  // 订阅/购买套餐成功回调
  const handlePurchaseSuccess = (plan: any) => {
    service.handleCheckSubscriptionLimit();
  };

  // 弹窗可见性回调
  const handleUpdateModalVisible = (visible: boolean) => {
    subscriptionModalVisible.value = visible;
  };

  // 监听订阅弹窗的显示状态，唤起或关闭组件
  watch(subscriptionModalVisible, (visible: boolean) => {
    if (visible) {
      nextTick(() => {
        const subRef = refSubscriptionModal.value as any | null;
        if (subRef != null) {
          const proxy = subRef as ComponentPublicInstance;
          proxy.$callMethod("open");
        } else {
          // 如果首次 nextTick 还没挂载完（常见于小程序首屏自动弹窗），则在小延时后重试
          setTimeout(() => {
            const subRefLater = refSubscriptionModal.value as any | null;
            if (subRefLater != null) {
              const proxyLater = subRefLater as ComponentPublicInstance;
              proxyLater.$callMethod("open");
            }
          }, 100);
        }
      });
    } else {
      const subRef = refSubscriptionModal.value as any | null;
      if (subRef != null) {
        const proxy = subRef as ComponentPublicInstance;
        proxy.$callMethod("close");
      }
    }
  });

  // 临时会话
  const queryTempConversation = (conversationUid: string) =>
    service.queryTempConversation(conversationUid);
  const createTempChatConversation = (captchaVerifyParam: string) =>
    service.createTempChatConversation(captchaVerifyParam);

  // 获取文件树列表
  const fetchFileList = (cId: number) => service.fetchFileList(cId);

  const handleSelectSandbox = (sandboxId: string) =>
    service.handleSelectSandbox(sandboxId);

  // 模型相关
  const handleSelectModel = (modelId: number, modelName: string) =>
    service.handleSelectModel(modelId, modelName);

    // 组件管理层 - 使用箭头函数保持this上下文；卸载时 el 可能为 null
    const setMessageRef = (el: any | null, messageId: string) =>
      componentManager.setMessageRef(el, messageId);
  const removeMessageRef = (messageId: string) =>
    componentManager.removeMessageRef(messageId);
  const updateMessageComponent = (messageId: string, newData: any) =>
    componentManager.updateMessageComponent(messageId, newData);
  // 滚动管理层 - 使用箭头函数保持this上下文
  const scrollToLastMsg = (userClick: boolean) =>
    scrollManager.scrollToLastMsg(userClick);
  /** 历史会话首屏加载后延迟无动画滚底 */
  const scrollToLastMsgAfterHistoryLoad = () =>
    scrollManager.scrollToLastMsgAfterHistoryLoad();
  /** 发送后（气泡已入列表）滚底，含 iOS 语音发送补滚 */
  const scrollToLastMsgAfterSend = () =>
    scrollManager.scrollToLastMsgAfterSend();
  const setIsInScrollBottom = (e: UniScrollEvent) =>
    scrollManager.setIsInScrollBottom(e);
  const lockAutoToLastMsg = () => scrollManager.lockAutoToLastMsg();
  const onScroll = (e: UniScrollEvent) => {
    // #ifdef MP-WEIXIN
    // 微信小程序中，由于使用 scrollIntoView 等机制，可能导致系统内部 scrolltoupper 的触发状态机未复位
    // 表现为“必须先下滑一点，再上滑才能触发”。我们在此加入滚动高度探测做双重保障。
    if (e != null) {
      const detail = e.detail;
      if (detail != null) {
        if (detail.scrollTop <= 100) {
          const notLoading = data.isLoadingMoreMessages.value == false;
          const hasMore = data.hasMoreMessages.value == true;
          if (notLoading == true) {
            if (hasMore == true) {
              handleScrollToUpper();
            }
          }
        }
      }
    }
    // #endif
    scrollManager.onScroll(e);
  };
  const scrollToMessage = (messageId: string | number) =>
    scrollManager.scrollToMessage(messageId);

  // 加载更多历史消息
  const handleLoadMoreMessages = () => service.handleLoadMoreMessages();

  /**
   * 处理上滑到顶部事件，加载更多历史消息
   */
  const handleScrollToUpper = async () => {
    const canLoadMore = hasMoreMessages.value == true;
    const isLoading = isLoadingMoreMessages.value == true;
    const listEmpty = messageList.value.length == 0;
    if (canLoadMore == false) {
      return;
    }
    if (isLoading == true) {
      return;
    }
    if (listEmpty == true) {
      return;
    }

    // 记录当前第一条可见消息的 ID 和 游标，用于加载完成后保持滚动位置
    const firstMessage = messageList.value[0];
    let firstVisibleMessageId = "";
    if (firstMessage != null) {
      firstVisibleMessageId = `${firstMessage.id}_${firstMessage.index}`;
    }

    // 临时禁用自动滚动，避免加载更多时触发自动滚动到底部
    const previousAutoToLastMsg = data.autoToLastMsg.value;
    data.autoToLastMsg.value = false;

    await handleLoadMoreMessages();

    // 加载完成后，滚动到之前的第一条消息位置，保持用户视角不变
    if (firstVisibleMessageId.length > 0) {
      await nextTick();
      scrollToMessage(firstVisibleMessageId);
    }

    // 恢复自动滚动状态
    data.autoToLastMsg.value = previousAutoToLastMsg;
  };

  // ==================== 视图层方法 (原ViewManager逻辑) ====================

  const handleCaptchaReady = () => {
    const el = document.getElementById(buttonId.value);
    if (el != null) {
      el.click();
    }
  };

  // ChatFinished 事件处理函数（带节流）
  // 注意：须位于 handleSendMessage 等引用之前（UTS 无提升）
  // 他端点停止也会推此事件：需掐断本端 SSE/sub，并复位播报图标
  const handleChatFinishedInternal = (event: any) => {
    const eventConvIdStr = `${(event as UTSJSONObject)["conversationId"]}`;
    if (conversationId.value == parseInt(eventConvIdStr, 10)) {
      throttle(() => {
        // 仍在收 live/sub：他端停止或任务结束，强制收尾并停播报
        const stillReceiving =
          chatService.isCurrentlyStreaming == true ||
          service.isSubConversationSubscribed == true;
        if (stillReceiving == true) {
          chatService.abort();
          service.abortSubConversation();
          stopAllStreamSpeech(true);
          data.isConversationActive.value = false;
        } else if (data.isConversationActive.value == true) {
          // 流已断但会话态未清：只清态；若仍在播报则停（避免误伤「正常结束后的尾句播报」）
          data.isConversationActive.value = false;
          if (voiceStreamSpeaker.isBusy() == true) {
            stopAllStreamSpeech(true);
          }
        }

        const convId = conversationId.value;
        const isNotTemp = props.isTempChat == false;
        if (convId != null) {
          if (convId != 0) {
            if (isNotTemp == true) {
              apiAgentConversation(convId as number).then((res) => {
                // Android：res 是 UTSJSONObject，禁止 res.code（点号读不到）
                if (apiResCode(res) == SUCCESS_CODE) {
                  handleQueryConversation(res);
                }
              });
            }
          }
        }
      }, 500)();
    }
  };

  // 发送消息
  const handleSendMessage = (_data: any) => {
    // 停上一轮播报，但保持本轮可播（勿 hardStop，否则 streamSpeakFeed 会被吞掉）
    interruptStreamSpeakPlayback();
    streamSpeakAllowed = true;

    // 与 dev 一致：一点击发送就清空问题建议，避免会话进行中仍展示
    data.chatSuggestList.value = [] as any[];

    // 先卸旧监听，发送后再挂上，以便本轮他端停止能收到 ChatFinished
    eventBus.off(`${EVENT_TYPE.ChatFinished}`, handleChatFinishedInternal);

    data.autoToLastMsg.value = true;
    data.needSetLockAutoToLastMsg.value = true;
    // 发送过消息,则禁用变量参数
    data.isSendMessageRef.value = true;

    // 滚底挪到 handleSendMessage 写入气泡之后（见下方 scrollToLastMsgAfterSend）
    // 此处立刻滚只会打到旧 last-msg；流式期 list watch 又跳过，iOS 语音发送后易不跟底

    let params: UTSJSONObject = {} as UTSJSONObject;

    const urlOtherParams = data.urlOtherParams.value as any | null;
    if (urlOtherParams != null) {
      const urlObj = urlOtherParams as UTSJSONObject;
      let otherAttachments: AttachmentFile[] = [];
      const otherAttVal = urlObj["attachments"];
      if (otherAttVal != null) {
        otherAttachments = otherAttVal as AttachmentFile[];
      }

      const otherAttachmentsFiles: UTSJSONObject[] = [];
      const attachLen = otherAttachments.length;
      for (let i = 0; i < attachLen; i++) {
        const item = otherAttachments[i];
        let fileName = "";
        let fileKey = "";
        if (item.fileName != null) {
          fileName = item.fileName as string;
        }
        if (item.fileKey != null) {
          fileKey = item.fileKey as string;
        }
        const fileObj: UTSJSONObject = {
          url: item.fileUrl,
          type: item.mimeType,
          name: fileName,
          key: fileKey,
        };
        otherAttachmentsFiles.push(fileObj);
      }

      let otherFiles: UploadFileInfo[] = [];
      const otherFilesVal = urlObj["files"];
      if (otherFilesVal != null) {
        otherFiles = otherFilesVal as UploadFileInfo[];
      }
      let _selectedComponents: AgentSelectedComponentInfo[] = [];
      const otherSelVal = urlObj["selectedComponents"];
      if (otherSelVal != null) {
        _selectedComponents = otherSelVal as AgentSelectedComponentInfo[];
      }
      let otherSkillIds: number[] = [];
      const otherSkillVal = urlObj["skillIds"];
      if (otherSkillVal != null) {
        otherSkillIds = otherSkillVal as number[];
      }
      const otherModelId = urlObj["modelId"];
      const otherSandboxId = urlObj["sandboxId"];

      const dataObj = AgentDetailUtils.toSendMessageParamsObject(_data);
      let dataFiles: UploadFileInfo[] = [];
      const dataFilesVal = dataObj["files"];
      if (dataFilesVal != null) {
        dataFiles = dataFilesVal as UploadFileInfo[];
      }
      let dataSelected: AgentSelectedComponentInfo[] = [];
      const dataSelectedVal = dataObj["selectedComponents"];
      if (dataSelectedVal != null) {
        dataSelected = dataSelectedVal as AgentSelectedComponentInfo[];
      }
      let dataSkillIds: number[] = [];
      const dataSkillIdsVal = dataObj["skillIds"];
      if (dataSkillIdsVal != null) {
        dataSkillIds = dataSkillIdsVal as number[];
      }
      const variableParams = getConvSetVariableParams();
      let modelId = dataObj["modelId"];
      if (modelId == null) {
        modelId = otherModelId;
      }
      let sandboxId = dataObj["sandboxId"];
      if (sandboxId == null) {
        sandboxId = otherSandboxId;
      }

      const mergedFiles: UTSJSONObject[] = [];
      for (let f = 0; f < otherFiles.length; f++) {
        mergedFiles.push(otherFiles[f] as UTSJSONObject);
      }
      for (let g = 0; g < otherAttachmentsFiles.length; g++) {
        mergedFiles.push(otherAttachmentsFiles[g]);
      }
      for (let h = 0; h < dataFiles.length; h++) {
        mergedFiles.push(dataFiles[h] as UTSJSONObject);
      }

      const mergedSelected: AgentSelectedComponentInfo[] = [];
      for (let sc = 0; sc < _selectedComponents.length; sc++) {
        mergedSelected.push(_selectedComponents[sc]);
      }
      for (let dc = 0; dc < dataSelected.length; dc++) {
        mergedSelected.push(dataSelected[dc]);
      }
      const mergedSkillIds: number[] = [];
      for (let sk = 0; sk < otherSkillIds.length; sk++) {
        mergedSkillIds.push(otherSkillIds[sk]);
      }
      for (let dk = 0; dk < dataSkillIds.length; dk++) {
        mergedSkillIds.push(dataSkillIds[dk]);
      }

      const paramsObj: UTSJSONObject = {};
      // 复制 _data 的原始字段
      const dataKeys = UTSJSONObject.keys(dataObj);
      const dataKeysLen = dataKeys.length;
      for (let dk2 = 0; dk2 < dataKeysLen; dk2++) {
        const k = dataKeys[dk2] as string;
        paramsObj[k] = dataObj[k];
      }
      paramsObj["variableParams"] = variableParams;
      paramsObj["files"] = mergedFiles;
      paramsObj["selectedComponents"] = mergedSelected;
      paramsObj["skillIds"] = mergedSkillIds;
      paramsObj["modelId"] = modelId;
      paramsObj["sandboxId"] = sandboxId;
      params = paramsObj;
    } else {
      const variableParamsElse = getConvSetVariableParams();
      const paramsObjElse = AgentDetailUtils.toSendMessageParamsObject(_data);
      paramsObjElse["variableParams"] = variableParamsElse;
      params = paramsObjElse;
    }

    // 本地发送前中断 sub 流恢复（避免 live + sub 双流）
    service.abortSubConversation();

    service.handleSendMessage(params, props.isTempChat, () => {
      // 软断流 / 超时收尾：只复位按钮态。
      // 不要在这里 abort——streamRequest 软收尾前还要排空 MESSAGE 队列；
      // abort 会 reset 队列，导致已收到但未派发的正文 delta 丢失（iOS 语音后常见只剩末尾几字）。
      data.isConversationActive.value = false;
      data.isStoppingConversation.value = false;
    });
    // 用户/助手气泡已入列表后再滚底（含短时补滚，覆盖 iOS 布局晚到）
    data.autoToLastMsg.value = true;
    scrollToLastMsgAfterSend();
    // 发送手势同步链路内开启本轮流式播报（空正文，禁止回放上一条）
    // H5 需用户手势解锁音频；真实正文由 streamSpeakFeed 喂入
    resumeStreamSpeakAllowance();
    const newSpeakId = streamingAssistantMessageId.value;
    if (newSpeakId.length > 0) {
      ensureHeadlessStreamSpeak(newSpeakId, "");
    }
    // 本轮会话进行中监听结束/他端停止（与进页 EXECUTING 续接时的订阅一致）
    eventBus.on(`${EVENT_TYPE.ChatFinished}`, handleChatFinishedInternal);
  };

  /**
   * 切换 SSE 自动播报。
   * - 关闭：停止当前流式自动播报；后续 SSE 不再 begin/feed（录音仍预热 TTS）
   * - 开启：若本轮 SSE 仍在进行则立刻续播当前助手正文；已结束则不补播
   * 工具栏手动播放不受此开关影响（始终可出声）。
   */
  const handleToggleVoiceAutoPlay = (): void => {
    const settings = loadVoiceSettings();
    const nextAutoPlay = settings.autoPlay != true;
    settings.autoPlay = nextAutoPlay;
    saveVoiceSettings(settings);
    voiceAutoPlayOff.value = nextAutoPlay != true;
    if (nextAutoPlay != true) {
      // 只停播，保留 feed 快照，便于中途再打开时续播
      clearFeedSpeakTimer();
      headlessStreamSpeakId = "";
      stopAllSpeechPlayback();
    } else if (isConversationActive.value == true) {
      // SSE 未结束：用当前流式正文立刻 begin（后续仍由 streamSpeakFeed 续喂）
      let msgId = streamingAssistantMessageId.value;
      if (msgId.length == 0) {
        msgId = feedSpeakMsgId;
      }
      let body = feedSpeakBodyText;
      if (body.length == 0) {
        body = assistantStreamText.value;
      }
      ensureHeadlessStreamSpeak(msgId, body);
    }
    uni.showToast({
      title: nextAutoPlay
        ? t("Mobile.Voice.autoPlayOn")
        : t("Mobile.Voice.autoPlayOff"),
      icon: "none",
      duration: 1500,
    });
  };

  /**
   * 处理创建新会话
   */
  const handleCreateNewConversation = (): void => {
    // 中止当前 SSE / sub 连接
    chatService.abort();
    service.abortSubConversation();
    stopConversationPolling();
    // 注意：创建新会话时不调用停止接口，只中止 SSE 连接
    // 停止接口只应该由用户手动点击停止按钮时调用

    // 重置按钮状态（按钮变为发送按钮）
    data.isConversationActive.value = false;
    data.isStoppingConversation.value = false;

    // 取消订阅 ChatFinished 事件（防止旧会话的事件影响新会话）
    eventBus.off(`${EVENT_TYPE.ChatFinished}`, handleChatFinishedInternal);

    // 清空本地缓存中的临时会话uid
    uni.removeStorageSync(TEMP_CONVERSATION_UID);
    if (props.isTempChat) {
      // 清空会话数据
      clearConversationData(true);

      // 创建临时会话
      createTempChatConversation(data.captchaVerifyParam.value);
    } else {
      createNewConversation(props.isAppDetails);
    }
  };

  /**
   * 处理更多弹窗
   */
  const handleMorePopup = (): void => {
    // #ifdef MP-WEIXIN
    // 小程序原 menu-dropdown 打开时会同步租户配置，保证订阅入口实时
    initTenantConfig();
    // #endif
    const morePopup = data.refMorePopup.value as any | null;
    if (morePopup != null) {
      nextTick(() => {
        try {
          const proxy = morePopup as ComponentPublicInstance;
          proxy.$callMethod("open");
        } catch (_e) {
          // ignore
        }
      });
    }
  };

  /**
   * 处理功能按钮点击
   */
  const handleButtonClick = (guideQuestion: string): void => {
    if (data.wholeDisabled.value == true) {
      uni.showToast({
        title: t("Mobile.Chat.fillRequiredParams"),
        icon: "none",
        duration: 2000,
      });
      return;
    }
    const guidePayload = getInputPhoneGuidePayload();
    if (guidePayload["existErrorFile"] == true) {
      uni.showToast({
        title: t("Mobile.Chat.removeUploadFailed"),
        icon: "none",
        duration: 1500,
      });
      return;
    }
    const params: UTSJSONObject = {
      "messageInfo": guideQuestion,
      "files": guidePayload["files"],
      "selectedComponents": guidePayload["selectedComponents"],
    };

    handleSendMessage(params);
  };

  // 预览图片（Android：file / attachments 为 UTSJSONObject，勿当 AttachmentFile）
  const onPreview = (file: any, attachments: any[]): void => {
    const mime = getAttachmentMimeType(file);
    if (mime.indexOf("image/") < 0) {
      uni.showToast({
        title: t("Mobile.Chat.previewTypeUnsupported"),
        icon: "none",
        duration: 1500,
      });
      return;
    }
    const urls: string[] = [];
    const attachLen = attachments.length;
    for (let i = 0; i < attachLen; i++) {
      const item = attachments[i];
      if (getAttachmentMimeType(item).indexOf("image/") >= 0) {
        const url = getAttachmentFileUrl(item);
        if (url.length > 0) {
          urls.push(url);
        }
      }
    }
    const currentUrl = getAttachmentFileUrl(file);
    if (urls.length > 0 && currentUrl.length > 0) {
      uni.previewImage({
        urls,
        current: currentUrl,
      });
    }
  };

  /**
   * 长按消息处理
   */
  const onlongTapMsg = (item: any): void => {
    // 显示操作菜单
  };

  /**
   * 思考内容变化处理
   */
  const changeThinkContent = (hideThinkContent: boolean): void => {
    // 注意：不要在这里调用 setIsInScrollBottom()，因为没有事件参数会导致状态错误
    if (shouldAutoScrollToLast() == true) {
      nextTick(() => {
        if (shouldAutoScrollToLast() == true) {
          scrollToLastMsg(false);
        }
      });
    }
  };

  /**
   * 键盘高度变化处理
   */
  const onKeyboardheightchange = (
    res: UniInputKeyboardHeightChangeEvent,
  ): void => {
    data.keyboardHeight.value = res.detail.height;
  };

  // ==================== 计算属性 ====================
  const lastMessage = computed((): MessageInfo | null => {
    const list = data.messageList.value;
    const listLen = list.length;
    if (listLen == 0) {
      return null;
    }
    return list[listLen - 1];
  });
  // 标题
  const headerTitle = computed((): string => {
    const info = agentInfo.value;
    let agentName = "";
    if (info != null) {
      const nameRaw = info["name"];
      if (nameRaw != null) {
        agentName = `${nameRaw}`;
      }
    }
    if (props.isTempChat == true) {
      if (agentName.length > 0) {
        const nameMap = new Map<string, string | number>();
        nameMap.set("name", agentName);
        return tFn("Mobile.Conversation.startWithAgent", nameMap as Record<string, string | number>, "");
      }
    }
    return agentName;
  });

  /** 非临时会话始终显示图标；接口未配置图标时使用默认智能体图标。 */
  const headerIcon = computed((): string => {
    if (props.isTempChat == true) {
      return "";
    }
    const info = agentInfo.value;
    if (info != null) {
      const iconRaw = info["icon"];
      if (iconRaw != null && `${iconRaw}`.length > 0) {
        return `${iconRaw}`;
      }
    }
    return "";
  });

  // 沙盒是否锁定 (综合判断: 服务层限制 || 已发送消息 || 存在历史消息)
  const isSandboxLocked = computed((): boolean => {
    if (data.isSandboxSwitchDisabled.value == true) {
      return true;
    }
    if (data.isSendMessageRef.value == true) {
      return true;
    }
    if (data.messageList.value.length > 0) {
      return true;
    }
    return false;
  });

  // ==================== 页面加载处理 ====================
  /**
   * 滚到底部。
   * @param fromListWatch true 表示由 messageList / lastMessage 监听触发；
   *   流式进行中交给 streamMessageUpdate，避免与 deep watch 叠加重置 scroll-into-view。
   * 注意：Android UTS 对 async 箭头函数默认参数支持不稳，故不使用默认值，调用方显式传参。
   */
  const handleScrollToLastMsg = async (fromListWatch: boolean) => {
    // 注意：不要在这里调用 setIsInScrollBottom()，因为没有事件参数会导致状态错误
    if (fromListWatch == true && isConversationActive.value == true) {
      return;
    }
    lockAutoToLastMsg();
    if (shouldAutoScrollToLast() == true) {
      await nextTick();
      setTimeout(() => {
        if (shouldAutoScrollToLast() == true) {
          scrollToLastMsg(false);
        }
      }, 100);
    }
  };

  /** 列表监听触发的滚底（流式期跳过） */
  const handleScrollToLastMsgFromListWatch = () => {
    handleScrollToLastMsg(true);
  };

  // 最后一条消息内容变化（非流式：状态更新 / 历史落库等）；流式期跳过
  watch(lastMessage, handleScrollToLastMsgFromListWatch, { deep: true });

  // 仅监听条数变化，避免对整表 deep watch 遍历嵌套字段
  watch(
    (): number => data.messageList.value.length,
    handleScrollToLastMsgFromListWatch,
  );

  /**
   * 流式打字机正文变化：实时跟底（不依赖 40ms messageList 冲刷）。
   * 上滑打断仍由 shouldAutoScrollToLast（scrollTouch / autoToLastMsg）守卫。
   */
  watch(
    (): string => streamingAssistantText.value,
    (newText: string) => {
      if (newText.length == 0) {
        return;
      }
      if (isConversationActive.value != true) {
        return;
      }
      if (shouldAutoScrollToLast() != true) {
        return;
      }
      scrollToLastMsg(false);
    },
  );

  // 问题建议列表变化处理
  watch(
    chatSuggestList,
    (newVal: any[]) => {
      if (newVal != null) {
        if ((newVal as any[]).length > 0) {
          handleScrollToLastMsg(false);
        }
      }
    },
    { deep: true },
  );

  // 无头边生成边播报改由 SSE streamSpeakFeed 事件驱动（见 handleStreamSpeakFeed）

  watch(
    conversationId,
    async (newVal: number | null) => {
      const hasConfig = eventBindConfig.value != null;
      const hasConvId = newVal != null;
      const isNotTempChat = props.isTempChat == false;
      if (hasConfig == false) {
        if (hasConvId == true) {
          if (isNotTempChat == true) {
            const res = await apiAgentConversation(newVal as number);
            if (apiResCode(res) == SUCCESS_CODE) {
              const resData = apiResData<any>(res);
              if (resData != null) {
                const resDataObj = resData as UTSJSONObject;
                const agent = resDataObj["agent"];
                if (agent != null) {
                  eventBindConfig.value = parseEventBindConfig((agent as UTSJSONObject)["eventBindConfig"]);
                }
              }
            }
          }
        }
      }
    },
    { deep: true },
  );

  // 监听键盘高度变化
  watch(data.keyboardHeight, (newVal: number) => {
    if (newVal > 0) {
      handleScrollToLastMsg(false);
    }
  });

  // 记录上一次成功获取租户配置的时间戳，避免首屏加载与 onShow 唤醒时并发重复请求
  let lastTenantConfigFetchTime: number = 0;

  /**
   * 初始化并更新租户配置，同步 enableSubscription 状态
   */
  const initTenantConfig = async (): Promise<void> => {
    const now = Date.now();
    // 2秒防抖时间窗口：如果距离上次成功获取配置的时间不足2秒，则直接跳过，防止并发快速重复拉取
    const withinDebounce = now - lastTenantConfigFetchTime < 2000;
    const hasSubscription = data.enableSubscription.value != null;
    if (withinDebounce == true) {
      if (hasSubscription == true) {
        return;
      }
    }

    try {
      const res = await apiTenantConfig();
      const codeOk = apiResCode(res) == SUCCESS_CODE;
      const resDataRaw = apiResData<any>(res);
      const hasData = resDataRaw != null;
      if (codeOk == true) {
        if (hasData == true) {
          const resData = resDataRaw as UTSJSONObject;
          let enableSub = 0;
          const enableSubRaw = resData["enableSubscription"];
          if (enableSubRaw != null) {
            enableSub = enableSubRaw as number;
          }
          data.enableSubscription.value = enableSub;
          tenantConfigInfo.value = resData;
          uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(resDataRaw));
          lastTenantConfigFetchTime = Date.now();
        }
      } else {
        const info = uni.getStorageSync(TENANT_CONFIG_INFO);
        if (info != null) {
          const cachedConfig = JSON.parse(info as string) as UTSJSONObject;
          let enableSub = 0;
          const enableSubRaw = cachedConfig["enableSubscription"];
          if (enableSubRaw != null) {
            enableSub = enableSubRaw as number;
          }
          data.enableSubscription.value = enableSub;
          tenantConfigInfo.value = cachedConfig;
        }
      }
    } catch (e) {
      console.error("初始化租户配置失败:", e);
      const info = uni.getStorageSync(TENANT_CONFIG_INFO);
      if (info != null) {
        const cachedConfig = JSON.parse(info as string) as UTSJSONObject;
        let enableSub = 0;
        const enableSubRaw = cachedConfig["enableSubscription"];
        if (enableSubRaw != null) {
          enableSub = enableSubRaw as number;
        }
        data.enableSubscription.value = enableSub;
        tenantConfigInfo.value = cachedConfig;
      }
    }
  };

  // ==================== 页面唤醒恢复逻辑 ====================
  /**
   * 启动会话状态轮询（sub 恢复）：轮询发现 EXECUTING → handleSubConversation；
   * sub 关闭 → 再启轮询。
   * 须用 function 声明：UTS 嵌套回调内无法引用同作用域 const（error18）。
   */
  /**
   * 本地忙：会话进行中（发消息 / live SSE / sub 续流）。
   * 不含 TTS：App 开会话后 H5 续接时，即使本端正在语音播报也要继续轮询状态。
   */
  function isLocalConversationBusy(): boolean {
    if (data.isConversationActive.value == true) {
      return true;
    }
    if (chatService.isCurrentlyStreaming == true) {
      return true;
    }
    if (service.isSubConversationSubscribed == true) {
      return true;
    }
    return false;
  }

  function startResumePolling(): void {
    const cid = data.conversationId.value;
    if (cid == null || cid == 0) {
      return;
    }
    startConversationPolling(
      cid,
      (executingCid: number) => {
        // 页面正在会话中：不续接，等结束后下一轮 poll 再判断
        if (isLocalConversationBusy() == true) {
          return;
        }
        service.handleSubConversation(executingCid, (): void => {
          startResumePolling();
        });
      },
      (): boolean => {
        // 轮询门禁：仅会话进行中跳过；语音播报不挡轮询
        return isLocalConversationBusy();
      },
      (): boolean => {
        return service.isSubConversationSubscribed;
      },
    );
  }

  /**
   * 处理会话恢复
   * 当页面从后台恢复时，检测并恢复会话状态
   */
  async function handleSessionResume(): Promise<void> {
    // 页面切回前台时，同步并更新最新的租户配置
    await initTenantConfig();

    // 检查会话ID是否存在
    const convId = conversationId.value;
    if (convId == null) {
      return;
    }
    if (convId == 0) {
      return;
    }

    // 重新获取会话订阅与限制状态，确保在支付返回后能够实时同步状态与解锁输入框
    await service.handleCheckSubscriptionLimit();

    // 本地已在会话中：不抢续接，只保持轮询（会话结束后可再续）
    if (isLocalConversationBusy() == true) {
      startResumePolling();
      return;
    }

    // 调用服务层的恢复方法
    const needResume = await service.resumeConversationState();

    if (needResume) {
      // await 期间可能已进入本地会话
      if (isLocalConversationBusy() == true) {
        startResumePolling();
        return;
      }
      // EXECUTING：本轮用户已就绪才立刻开 sub；否则只靠轮询（四端同一门禁）
      console.log("[PageResume] 会话状态已恢复,检查是否可订阅 sub");
      const resumeCid = data.conversationId.value;
      if (
        resumeCid != null &&
        resumeCid != 0 &&
        isTurnUserReadyFromMessageInfoList(data.messageList.value) == true
      ) {
        service.handleSubConversation(resumeCid, (): void => {
          startResumePolling();
        });
      } else {
        console.log("[PageResume] EXECUTING 但本轮用户未就绪，先轮询再续接");
      }
      // 兜底轮询：与 handlePageLoad 同理，确保 live stream 结束后有轮询能续上 sub
      startResumePolling();
    } else {
      // 非执行中：恢复轮询
      resumeConversationPolling();
    }
  }

  // 使用页面唤醒检测 Hook
  // H5: visibilitychange；App/小程序: 页面 onShow/onHide → triggerHide/Resume
  // ASR/TTS 按需连接：前后台 / 相册不再做任何 socket 挂起、保活或重连
  // pageSystemOverlay 仅过滤轮询暂停 / 长隐藏会话恢复
  function onChatPageResume(): void {
    // 长隐藏后的会话恢复；系统相册/权限等触发的 hide 不跑
    if (pageSystemOverlay.wasLastShowReal() == true) {
      handleSessionResume();
    }
  }
  function onChatPageForeground(): void {
    const realShow = pageSystemOverlay.noteShow();
    if (realShow == true) {
      resumeConversationPolling();
    }
  }
  function onChatPageHide(): void {
    if (pageSystemOverlay.noteHide() == true) {
      pauseConversationPolling();
    }
  }
  const pageResumeOptions = new PageResumeOptions();
  pageResumeOptions.onResume = onChatPageResume;
  pageResumeOptions.onForeground = onChatPageForeground;
  pageResumeOptions.onHide = onChatPageHide;
  pageResumeOptions.minHiddenDuration = CHAT_PAGE_LONG_HIDE_MS;
  const pageResumeResult = usePageResume(pageResumeOptions);
  const isPageHidden = pageResumeResult.isHidden;

  /**
   * UTS error18：onHide/onShow 嵌套回调不能引用同作用域 const。
   * Android/Kotlin 类属性函数用 .invoke()；iOS/H5/小程序直接 () 调用。
   */
  function invokeTriggerHide(): void {
    // #ifdef APP-ANDROID
    pageResumeResult.triggerHide.invoke();
    // #endif
    // #ifndef APP-ANDROID
    pageResumeResult.triggerHide();
    // #endif
  }
  function invokeTriggerResume(): void {
    // #ifdef APP-ANDROID
    pageResumeResult.triggerResume.invoke();
    // #endif
    // #ifndef APP-ANDROID
    pageResumeResult.triggerResume();
    // #endif
  }

  // App/小程序：统一走 triggerHide/Resume（与 pageResume 回调同一条链路）
  // H5/WEB 只靠 visibilitychange，避免与页面 onShow/onHide 双触发
  // #ifndef H5 || WEB
  onHide((): void => {
    invokeTriggerHide();
  });

  /**
   * OpenUI 表单提交续作：从 file-preview-page 返回时，消费按 conversationId 暂存的一次性
   * 续作消息，复用既有发送链路发出（与 pendingChatDraft 同一 storage-and-consume 模式）。
   */
  const handlePendingOpenUiAction = (): void => {
    const cid = data.conversationId.value;
    if (cid == null) return;
    const message = consumePendingOpenUiAction(cid);
    if (message.length == 0) return;
    const sendPayload: UTSJSONObject = {
      messageInfo: message,
      selectedComponents: data.selectedComponents.value,
      modelId: data.currentModelId.value,
      sandboxId: data.currentSandboxId.value,
    };
    nextTick(() => {
      handleSendMessage(sendPayload);
    });
  };

  onShow((): void => {
    invokeTriggerResume();
    handlePendingOpenUiAction();
  });
  // #endif

  /**
   * 处理页面加载
   */
  const handlePageLoad = async (options: any): Promise<void> => {
    // 智能体id
    const idVal = (options as UTSJSONObject)["id"];
    if (idVal != null) {
      data.agentId.value = parseInt(idVal as string, 10);
    } else {
      data.agentId.value = null;
    }

    // 如果存在会话id，则初始化ParseMarkdown，查询历史会话信息
    const convIdVal = (options as UTSJSONObject)["conversationId"];
    if (convIdVal != null) {
      const id = parseInt(convIdVal as string, 10);
      // 先设置一个临时值，防止 watch(conversationId) 触发时重复调用接口
      eventBindConfig.value = parseEventBindConfig({} as UTSJSONObject);
      data.conversationId.value = id;

      if (props.isTempChat) return;

      // 查询历史会话信息(接口返回数据中包含智能体详情信息, 所以不在需要单独查询智能体详情信息了)
      const res = await apiAgentConversation(id);
      // Android：res 是 UTSJSONObject，res.code / res.data 点号访问失败 → 不会进 handleQueryConversation → messageList 空
      if (apiResCode(res) == SUCCESS_CODE) {
        const resData = apiResData<any>(res);
        if (resData != null) {
          const resDataObj = resData as UTSJSONObject;
          const agent = resDataObj["agent"];
          if (agent != null) {
            eventBindConfig.value = parseEventBindConfig((agent as UTSJSONObject)["eventBindConfig"]);
          }
        }
        await handleQueryConversation(res);
        // 历史消息首屏布局完成后再无动画滚到底（watch 可能早于 DOM 就绪）
        if (data.messageList.value.length > 0) {
          scrollToLastMsgAfterHistoryLoad();
        }

        // 首页会话框会先创建会话，再以 conversationId 为键保存一次性草稿。
        // 会话详情初始化完成后复用既有发送链路，避免首页重复实现流式聊天。
        const currentAgentId = data.agentId.value;
        if (currentAgentId != null) {
          const draft = consumePendingChatDraft(id, currentAgentId);
          if (draft != null) {
            if (draft.modelId != null && draft.modelId != 0) {
              data.currentModelId.value = draft.modelId;
            }
            if (draft.sandboxId != null && draft.sandboxId.length > 0) {
              data.currentSandboxId.value = draft.sandboxId;
            }
            const draftFiles: UTSJSONObject[] = [];
            for (let attachmentIndex = 0; attachmentIndex < draft.attachments.length; attachmentIndex++) {
              const attachment = draft.attachments[attachmentIndex];
              draftFiles.push({
                url: attachment["fileUrl"],
                type: attachment["mimeType"],
                name: attachment["fileName"],
                key: attachment["fileKey"],
                size: attachment["fileSize"],
              });
            }
            const sendPayload: UTSJSONObject = {
              messageInfo: draft.message,
              files: draftFiles,
              selectedComponents: draft.selectedComponents,
              skillIds: draft.skillIds,
              modelId: draft.modelId,
              sandboxId: draft.sandboxId,
              agentMode: draft.agentMode,
            };
            // 等待消息列表和输入组件完成首轮渲染，避免 App 首屏丢失首条消息。
            nextTick(() => {
              handleSendMessage(sendPayload);
            });
          }
        }

        if (resData != null) {
          const resDataObj = resData as UTSJSONObject;
          // 切换会话：先停止旧会话的状态轮询
          stopConversationPolling();
          // Android：taskStatus 为字符串，禁止依赖 string==枚举隐式强转
          if (parseTaskStatus(resDataObj["taskStatus"]) == TaskStatus.EXECUTING) {
            // 本轮用户已进列表才立刻开 sub；否则只靠轮询（与 H5/App/小程序同一门禁）
            if (
              isTurnUserReadyFromRawMessageList(resDataObj["messageList"]) ==
              true
            ) {
              data.isConversationActive.value = true;
              service.handleSubConversation(id, () => {
                startResumePolling();
              });
            } else {
              console.log("[PageLoad] EXECUTING 但本轮用户未就绪，先轮询再续接");
            }
            // 兜底轮询：abortSub 不触发 onSubClose，需提前启动
            startResumePolling();
            // 订阅 ChatFinished 事件
            eventBus.on(`${EVENT_TYPE.ChatFinished}`, handleChatFinishedInternal);
          } else {
            // 非执行中：启动轮询，检测会话变为 EXECUTING
            startResumePolling();
          }
        }
      }
    } else {
      let paramsData: OpenAppParams | null = null;
      const paramsFromUrl = (options as UTSJSONObject)["params"];
      if (paramsFromUrl != null) {
        paramsData = JSON.parse(paramsFromUrl as string) as OpenAppParams;
      }

      // 查询智能体详情信息，并初始化会话id
      getPublishedAgentInfo(paramsData);
    }
  };

  /**
   * 使用chatKey、captchaVerifyParam创建临时会话
   * chatKey: 链接key
   * captchaVerifyParam: 验证码参数 (可选)
   */
  const handleCreateTempChat = async (captchaVerifyParam: any) => {
    // 验证码参数
    const verifyParam = captchaVerifyParam != null ? `${captchaVerifyParam}` : "";
    data.captchaVerifyParam.value = verifyParam;
    data.isLoadingConversation.value = true;
    const uid = uni.getStorageSync(TEMP_CONVERSATION_UID);
    if (uid != null) {
      const uidStr = uid as string;
      if (uidStr.length > 0) {
        data.conversationUid.value = uidStr;
        queryTempConversation(uidStr);
      } else {
        createTempChatConversation(verifyParam);
      }
    } else {
      createTempChatConversation(verifyParam);
    }
  };

  /**
   * 处理临时会话页面加载
   */
  const handleTempChatPageLoad = async (options: any) => {
    // 临时会话key
    const chatKeyVal = (options as UTSJSONObject)["chatKey"] as string;
    data.chatKey.value = chatKeyVal;
    // 是否存在缓存的chatKey值
    const _cacheChatKey = uni.getStorageSync(TEMP_CHAT_KEY);

    /**
     * 如果缓存的chatKey值存在且与当前的chatKey值不一致，则清空缓存的临时会话uid
     * (防止用户手动修改url地址中的chatKey值后刷新页面，因为缓存TEMP_CONVERSATION_UID的值与chatKey值不匹配，导致后面查询会话详情时提示会话ID不存在的bug)
     */
    if (_cacheChatKey != null) {
      const cacheKey = _cacheChatKey as string;
      if (cacheKey.length > 0) {
        if (chatKeyVal != cacheKey) {
          uni.removeStorageSync(TEMP_CONVERSATION_UID);
        }
      }
    }
    // 缓存chatKey
    uni.setStorageSync(TEMP_CHAT_KEY, chatKeyVal);

    const _tenantConfigInfo = tenantConfigInfo.value;
    if (_tenantConfigInfo != null) {
      const configObj = _tenantConfigInfo as UTSJSONObject;
      const captchaSceneId = configObj["captchaSceneId"];
      const captchaPrefix = configObj["captchaPrefix"];
      const openCaptcha = configObj["openCaptcha"];
      let isNeedCaptcha = false;
      if (captchaSceneId != null) {
        if (captchaPrefix != null) {
          if ((openCaptcha as number) != 0) {
            isNeedCaptcha = true;
          }
        }
      }
      if (isNeedCaptcha == false) {
        handleCreateTempChat("");
      }
    }
  };

  // 验证码 doAction 回调包装（避免模板内联箭头触发 UTS 泛型 E 推断失败）
  const handleCaptchaDoAction = (captchaVerifyParam: string) => {
    handleCreateTempChat(captchaVerifyParam);
  };

  const handlePagePreviewDetail = (toolCall: any, detailData: any) => {
    let toolName: string | null = null;
    if (toolCall != null) {
      try {
        const nameVal = (toolCall as UTSJSONObject)["name"];
        if (nameVal != null) {
          toolName = `${nameVal}`;
        }
      } catch (e) {
        toolName = null;
      }
    }
    const rawTitle = coalesceNonEmptyString(
      toolName,
      t("Mobile.ThirdParty.MpHtml.executionPlan"),
    );
    const title = rawTitle.replace(/&quot;/g, '"');
    // 数据经 openWith 写入弹窗内部，避免改父页 toolDetail* 触发消息列表 patch NPE
    // Android：Gen* 组件禁止 as UTSJSONObject，须 $callMethod
    const modalRef = toolDetailsModalRef.value as any | null;
    if (modalRef != null) {
      const proxy = modalRef as ComponentPublicInstance;
      proxy.$callMethod("openWith", title, detailData);
    } else {
      toolDetailTitle.value = title;
      toolDetailData.value = detailData != null ? detailData : null;
    }
  };

  /**
   * 打开页面预览
   * @param uri 页面URI
   * @param method 请求方法 (默认: browser_open_page)
   * @param data_type 数据类型 (默认: html)
   * @param request_id 请求ID (默认: '')
   */
  // 注意：须位于 handlePagePreviewExecuting 等调用方之前（UTS 无提升）
  const handleOpenPagePreview = async (opts: UTSJSONObject) => {
    // 由于 UTS 解构默认值受限，这里在函数体内手动兜底
    let uri = opts.uri;
    const uriVal = (opts as UTSJSONObject)["uri"];
    if (uriVal != null) {
      uri = uriVal as string;
    }
    let method = "browser_open_page";
    const methodVal = (opts as UTSJSONObject)["method"];
    if (methodVal != null) {
      method = methodVal as string;
    }
    let data_type = "html";
    const dataTypeVal = (opts as UTSJSONObject)["data_type"];
    if (dataTypeVal != null) {
      data_type = dataTypeVal as string;
    }
    let request_id = "";
    const reqIdVal = (opts as UTSJSONObject)["request_id"];
    if (reqIdVal != null) {
      request_id = reqIdVal as string;
    }
    // 打开页面首页
    // #ifdef H5 || WEB
    const iframeRef = pagePreviewIframeRef.value as any | null;
    if (iframeRef != null) {
      const handlePageOpenFn = (iframeRef as UTSJSONObject)["handlePageOpen"] as ((opts: UTSJSONObject) => void) | null;
      if (handlePageOpenFn != null) {
        const optsObj: UTSJSONObject = {
          uri: `${API_BASE_URL}${uri}`,
          method: method,
          data_type: data_type,
          request_id: request_id,
        };
        handlePageOpenFn(optsObj);
      }
    }
    // #endif

    // #ifdef MP-WEIXIN
    const { code, data } = await apiUserTicketCreate();
    const ticketOk = code == SUCCESS_CODE;
    const hasTicket = data != null;
    if (ticketOk == true) {
      if (hasTicket == true) {
        const ticketData = data as string;
        if (uri.indexOf("?") >= 0) {
          uri = uri + "&_ticket=" + ticketData;
        } else {
          uri = uri + "?_ticket=" + ticketData;
        }
      }
    }
    const pageHomeTitle = encodeURIComponent(t("Mobile.Common.pageHome"));
    handleExternalLink(
      `${API_BASE_URL}${uri}&jump_type=inner&title=${pageHomeTitle}&method=${method}&data_type=${data_type}&request_id=${request_id}`,
    );
    // #endif
  };

  /** 模板中触发打开页面预览（避免在模板里构造接口对象字面量） */
  const openPagePreviewByUri = (uri: string): void => {
    const opts: UTSJSONObject = {
      uri: uri,
      method: "browser_open_page",
      data_type: "html",
      request_id: "",
    };
    handleOpenPagePreview(opts);
  };

  const handlePagePreviewExecuting = (execData: any) => {
    const execObj = execData as UTSJSONObject;
    let input: any | null = null;
    const result = execObj["result"] as any | null;
    if (result != null) {
      input = (result as UTSJSONObject)["input"] as any | null;
    }
    if (input == null) {
      return;
    }
    const inputObj = input as UTSJSONObject;
    if (inputObj["uri_type"] == null) {
      inputObj["uri_type"] = "Page";
    }
    const argumentsString = objectToQueryString(inputObj["arguments"]);
    let queryString = "";
    if (argumentsString.length > 0) {
      queryString = "?" + argumentsString;
    }

    if (inputObj["uri_type"] == "Link") {
      // #ifdef H5 || WEB
      if (execObj["status"] == ProcessingEnum.FINISHED) {
        const pageUrl = `${inputObj["uri"]}${queryString}`;
        window.open(pageUrl, "_blank");
      }
      // #endif
      return;
    }

    if (inputObj["uri_type"] == "Page") {
      const fullUri = `${inputObj["uri"]}${queryString}`;

      if (execObj["status"] == ProcessingEnum.FINISHED) {
        const previewOpts: UTSJSONObject = {
          uri: fullUri,
          method: "browser_open_page",
          data_type: "html",
          request_id: "",
        };
        handleOpenPagePreview(previewOpts);
        return;
      }

      if (execObj["status"] == ProcessingEnum.EXECUTING) {
        const previewOpts2: UTSJSONObject = {
          uri: fullUri,
          method: inputObj["method"] as string,
          data_type: inputObj["data_type"] as string,
          request_id: inputObj["request_id"] as string,
        };
        handleOpenPagePreview(previewOpts2);
        return;
      }
    }
  };

  // 事件代理
  useMessageEventDelegate(
    msgListContentRef,
    eventBindConfig,
    (data: ShowPagePreviewOptions) => {
      // 打开引导问题页面弹窗
      const previewOpts: UTSJSONObject = {
        uri: data.uri,
        method: "browser_open_page",
        data_type: "html",
        request_id: "",
      };
      handleOpenPagePreview(previewOpts);
    },
  );

  // ==================== 生命周期 ====================
  // 内部异步逻辑包装为同步回调，避免 Promise 类型不匹配
  const runOnLoadAsync = async (options: any): Promise<void> => {
    // 获取并更新租户配置，初始化 enableSubscription
    await initTenantConfig();

    // 设置当前页面导航栏标题
    setCurrentPageNavigationBarTitle();
    const ticketVal = (options as UTSJSONObject)["_ticket"];
    if (ticketVal != null) {
      ticket.value = ticketVal as string;
    } else {
      ticket.value = "";
    }
    // 进入页面后渲染输入框组件
    isRenderInputPhone.value = true;

    // 微信小程序事件绑定
    // #ifdef MP-WEIXIN
    uni.$on("message-event-delegate", (data: any) => {
      const dataObj = data as UTSJSONObject;
      const attrsObj = dataObj["attrs"] as UTSJSONObject;
      const eventType = attrsObj["event-type"];
      const dataStr = attrsObj["data"];
      if (eventType != null) {
        if (dataStr != null) {
          handleMessageEventClick(
            eventType,
            dataStr,
            eventBindConfig.value,
            handleOpenPagePreview,
            dedupManager,
          );
        } else {
          const warnObj: UTSJSONObject = {
            eventType: eventType,
            dataStr: dataStr,
          };
          console.warn("[Event Delegate] 缺少必要属性", warnObj);
        }
      }
    });
    // #endif

    // 判断是否是临时会话
    if (props.isTempChat) {
      await handleTempChatPageLoad(options);
    } else {
      await handlePageLoad(options);
    }
  };
  onLoad((options: any) => {
    runOnLoadAsync(options);
  });

  // 刷新文件列表
  const onRefreshFileList = () => {
    // 如果智能体类型为任务型智能体，并且会话id存在,并且文件树弹窗可见，则获取文件树列表
    const info = agentInfo.value;
    const isTaskAgent = isAgentTypeTaskAgent(info);
    const convId = conversationId.value;
    let hasConvId = false;
    if (convId != null) {
      if (convId != 0) {
        hasConvId = true;
      }
    }
    const treeVisible = popupFileTreeVisible.value == true;
    if (isTaskAgent == true) {
      if (hasConvId == true) {
        if (treeVisible == true) {
          fetchFileList(convId as number);
        }
      }
    }
  };

  // 处理消息组件更新事件
  const handleUpdateMessageComponent = (eventData: any) => {
    const edObj = eventData as UTSJSONObject;
    const dataVal = edObj["data"] as any;
    updateMessageComponent(edObj["messageId"] as string, dataVal);
  };

  // 触摸结束延迟计时器
  let touchEndTimer: number = 0;

  // 触摸开始处理
  const handleTouchStart = () => {
    // 清除触摸结束延迟计时器，确保触摸开始时立即生效
    if (touchEndTimer != 0) {
      clearTimeout(touchEndTimer);
      touchEndTimer = 0;
    }
    data.scrollTouch.value = true;
  };

  // 触摸结束处理 - 延迟重置 scrollTouch
  const handleTouchEnd = () => {
    // 清除之前的计时器
    if (touchEndTimer != 0) {
      clearTimeout(touchEndTimer);
    }
    // 延迟 300ms 后才重置 scrollTouch
    // 这样在用户快速滑动时，自动滚动不会在手指抬起的瞬间抢占
    touchEndTimer = setTimeout(() => {
      data.scrollTouch.value = false;
      touchEndTimer = 0;
      // 仅 SSE/会话进行中才在松手后尝试恢复跟底。
      // 空闲浏览时若仍调用，会把「上滑一点点」又强行拉回底部。
      if (isConversationActive.value == true) {
        handleScrollToLastMsg(false);
      }
    }, 300);
  };

  const handleStreamMessageUpdate = () => {
    // 流式 UI 已冲刷；跟底节流交给 ScrollManager，不再叠加 30ms，
    // 避免与 STREAM_UI_COALESCE / SCROLL_THROTTLE 错拍造成 Android 跳跃跟底。
    if (shouldAutoScrollToLast() == true) {
      scrollToLastMsg(false);
    }
  };

  // #ifdef H5
  /** H5 滚轮监听：与 onUnmounted removeEventListener 共用同一引用 */
  const handleH5Wheel = (_e: WheelEvent): void => {
    data.mouseScroll.value = true;
    let clear: number = 0;
    clear = setTimeout(() => {
      data.mouseScroll.value = false;
      clearTimeout(clear);
    }, 1000);
  };
  // #endif

  // 设置事件监听器
  // 内部异步逻辑包装为同步回调，避免 Promise 类型不匹配
  const runOnMountedAsync = async (): Promise<void> => {
    // 监听流式消息更新事件，触发自动滚动到底部
    // 兼容微信小程序和 H5
    uni.$on("streamMessageUpdate", handleStreamMessageUpdate);
    uni.$on("streamSpeakFeed", handleStreamSpeakFeed);
    uni.$on("streamSpeakInterrupt", handleStreamSpeakInterrupt);

    uni.$on("refreshFileList", onRefreshFileList);
    uni.$on("updateMessageComponent", handleUpdateMessageComponent);
    // #ifdef H5
    window.addEventListener("wheel", handleH5Wheel);
    // #endif

    uni.$on("page_preview_executing", handlePagePreviewExecuting);
    uni.$on("page_preview_detail", handlePagePreviewDetail);
  };
  const handleMarkdownProxyMessage = (event: UniWebViewMessageEvent): void => {
    // #ifdef APP
    proxyWeb.ensureAppContext("markdown-proxy-web");
    // #endif
    proxyWeb.onWebMsg(event);
  };

  // #ifdef WEB
  const bindMarkdownProxyWeb = (): void => {
    const el = document.getElementById("markdown-proxy-web");
    proxyWeb.init(el as any, "markdown-proxy-web");
  };
  // #endif

  // #ifdef APP
  // 用 setInterval 重试，避免 UTS 中 const 自调用「找不到名称」
  const bindMarkdownProxyWeb = (): void => {
    let attempt = 0;
    const tryOnce = (): boolean => {
      const ctx = uni.createWebviewContext("markdown-proxy-web");
      if (ctx != null) {
        proxyWeb.init(ctx, "markdown-proxy-web");
        return true;
      }
      return false;
    };
    if (tryOnce()) {
      return;
    }
    let timer: number = 0;
    timer = setInterval((): void => {
      attempt = attempt + 1;
      if (tryOnce() || attempt >= 20) {
        clearInterval(timer);
      }
    }, 300);
  };
  // #endif

  onMounted(() => {
    // 仅标记会话页活跃；ASR/TTS 改为按录音预热 / 合成时建连（不再进页预连）
    speechSocketWarmup.warmup();
    // #ifdef APP || WEB
    bindMarkdownProxyWeb();
    // #endif
    runOnMountedAsync();
  });

  // 清理事件监听器
  onUnmounted(() => {
    speechSocketWarmup.teardown();
    stopAllStreamSpeech(true);
    chatService.abort();
    service.abortSubConversation();
    destroyConversationPolling();
    scrollManager.dispose();

    if (touchEndTimer != 0) {
      clearTimeout(touchEndTimer);
      touchEndTimer = 0;
    }
    clearFeedSpeakTimer();

    // #ifdef H5
    window.removeEventListener("wheel", handleH5Wheel);
    // #endif

    // #ifdef APP
    proxyWeb.reset();
    // #endif

    uni.$off("streamMessageUpdate", handleStreamMessageUpdate);
    uni.$off("streamSpeakFeed", handleStreamSpeakFeed);
    uni.$off("streamSpeakInterrupt", handleStreamSpeakInterrupt);
    uni.$off("refreshFileList", onRefreshFileList);
    uni.$off("updateMessageComponent", handleUpdateMessageComponent);
    uni.$off("page_preview_executing", handlePagePreviewExecuting);
    // #ifdef MP-WEIXIN
    uni.$off("message-event-delegate");
    // #endif
    isRenderInputPhone.value = false;
    eventBus.off(`${EVENT_TYPE.ChatFinished}`, handleChatFinishedInternal);
  });

  const handleOpenFileTree = () => {
    popupFileTreeVisible.value = true;
    const treeRef = fileTreeRef.value as any | null;
    if (treeRef != null) {
      try {
        const proxy = treeRef as ComponentPublicInstance;
        proxy.$callMethod("open");
      } catch (_e) {
        // ignore
      }
    }
    onRefreshFileList();
  };

  const exposedGetAgentInfo = (): any => {
    return agentInfo.value as any;
  };

  defineExpose({
    triggerResume: invokeTriggerResume as any,
    triggerHide: invokeTriggerHide as any,
    getAgentInfo: exposedGetAgentInfo as any,
  });
</script>

<style lang="scss" scoped>
  @import "./styles/index.scss";

  .captcha-button {
    position: absolute;
    left: 10px;
    top: 10px;
    visibility: hidden;
    opacity: 0;
  }

  /*
   * iOS WKWebView：需保留「在屏内」才能 html2canvas 回调；
   * 宽高过小会把公式压成细条；过窄会截断长公式。用较宽画布 + 极低透明度隐藏。
   */
  .markdown-proxy-web {
    position: fixed;
    left: 0;
    top: 0;
    width: 2000px;
    height: 800px;
    opacity: 0.01;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }

  .icon-loading-image {
    width: 48rpx;
    height: 48rpx;
    margin-left: 32rpx;
    /* #ifndef APP */
    -webkit-touch-callout: none !important;
    -webkit-user-select: none !important;
    user-select: none !important;
    /* #endif */
  }

  .loading-more-tip {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24rpx 0;
  }
</style>
