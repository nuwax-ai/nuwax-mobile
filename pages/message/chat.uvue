  }

  .chat-status {
    margin-top: 8rpx;
    font-size: 22rpx;
    line-height: 30rpx;
    color: #9a98a5;
  }

  .chat-status--fail {
    color: #ff4d4f;
  }

  /* ===== 撤回 / 系统提示行 ===== */
  .chat-sys {
    margin-bottom: 28rpx;
