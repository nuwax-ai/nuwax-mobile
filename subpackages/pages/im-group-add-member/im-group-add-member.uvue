    color: #17171a;
  }

  /* ===== 双 tab（人 / 智能体） ===== */
  .ga-tabs {
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    padding: 20rpx 32rpx 0;
  }

  .ga-tab {
    flex: 1;
    height: 80rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 24rpx 24rpx 0 0;
    background-color: rgba(255, 255, 255, 0.45);
  }

  .ga-tab--on {
    background-color: #ffffff;
  }

  .ga-tab--active {
    opacity: 0.8;
  }

  .ga-tab__text {
    max-width: 320rpx;
    font-size: 26rpx;
    line-height: 36rpx;
    color: #6b6976;
