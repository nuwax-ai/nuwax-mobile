  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #f2f3f5;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #f2f3f5;
  }
  /* #endif */
</style>
