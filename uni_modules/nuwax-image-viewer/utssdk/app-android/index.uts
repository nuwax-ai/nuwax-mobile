/**
 * Android 原生全屏图片查看器（UTS 薄桥）。
 * 实现=SubsamplingScaleImageView 分块按需解码（libs/subsampling-scale-image-view-androidx），
 * 3 万 px 长图 / 80MP 巨图均不整张解码，深放文字不糊、内存恒定——替代 uni.previewImage
 * （按一屏解码必糊）与 uni-app x `<image>` 自绘路线（~36MP 以上静默死）。
 * 取图经 onFetchFile 由上层 uni.downloadFile 落临时文件（原生直连 TLS/UA/相对路径有坑）；
 * 交互：单击关、长按弹「保存图片」确认（onSave 走上层鉴权保存）、双指/双击/图内平移内建、
 * 最小缩放档横滑连播（邻居屏外常驻预取）。
 */
import { UTSAndroid } from "io.dcloud.uts";
import ImageViewerBridge from 'com.nuwax.imageviewer.ImageViewerBridge';
import SaveRequestCallback from 'com.nuwax.imageviewer.SaveRequestCallback';
import ViewerFileProvider from 'com.nuwax.imageviewer.ViewerFileProvider';
import FileResultCallback from 'com.nuwax.imageviewer.FileResultCallback';
import type {
  NativeViewerFileFetcher,
  NativeViewerSaveHandler,
} from '../interface.uts';

/** 桥接保存回调：把 Kotlin 侧长按保存请求转发给上层 lambda。 */
class SaveCallbackAdapter implements SaveRequestCallback {
  private handler: NativeViewerSaveHandler;

  constructor(handler: NativeViewerSaveHandler) {
    super();
    this.handler = handler;
  }

  override onSaveRequested(url: string): void {
    this.handler(url);
  }
}

/** 桥接取图：上层 fetcher（uni.downloadFile → 临时文件）→ Kotlin FileResultCallback。 */
class FileProviderAdapter implements ViewerFileProvider {
  private fetcher: NativeViewerFileFetcher;

  constructor(fetcher: NativeViewerFileFetcher) {
    super();
    this.fetcher = fetcher;
  }

  override fetchFile(url: string, cb: FileResultCallback): void {
    this.fetcher(
      url,
      (path: string): void => {
        cb.onFileReady(url, path);
      },
      (message: string): void => {
        cb.onFileFailed(url, message);
      },
    );
  }
}

/**
 * 打开原生图片查看器。
 * @param list 本次连播图集（应已剔除 SVG 等不可预览项）
 * @param index 起点下标
 * @param originX 缩略图落点左上角 x（视口 px，供关闭转场缩回原位；传 0 宽度即退化为淡出）
 * @param originY 缩略图落点左上角 y（视口 px）
 * @param originW 缩略图落点宽（px，<=0 表示未测到）
 * @param originH 缩略图落点高（px）
 * @param onFetchFile 取图：url → 本地临时文件路径（file:// 前缀可带）
 * @param onSave 长按保存确认后的回调（上层负责鉴权下载 + 存相册 + toast）
 * @returns 是否真的用原生查看器打开；false（如标准基座缺分块解码 aar）时上层应回退 previewImage
 */
export function openNativeImageViewer(
  list: string[],
  index: number,
  originX: number,
  originY: number,
  originW: number,
  originH: number,
  onFetchFile: NativeViewerFileFetcher,
  onSave: NativeViewerSaveHandler,
): boolean {
  if (list.length == 0) {
    return false;
  }
  const act = UTSAndroid.getUniActivity();
  if (act == null) {
    return false;
  }
  const bridge = new ImageViewerBridge(
    act,
    list,
    index,
    originX,
    originY,
    originW,
    originH,
    new FileProviderAdapter(onFetchFile),
    new SaveCallbackAdapter(onSave),
  );
  const opened: boolean = bridge.show();
  return opened;
}
