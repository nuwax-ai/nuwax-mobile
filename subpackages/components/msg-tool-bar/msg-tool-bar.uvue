<template>
	<view class="tool-bar-container">
		<view
			class="tool-btn"
			hover-class="tool-btn-hover"
			:hover-start-time="20"
			:hover-stay-time="70"
			@click="copy"
		>
			<svg-icon name="icon-Copy" size="36" />
		</view>
		<view
			class="tool-btn"
			:class="{
				'tool-btn--active': isSpeaking,
				'tool-btn--pulse': isSpeaking && speechFrame,
			}"
			hover-class="tool-btn-hover"
			:hover-start-time="20"
			:hover-stay-time="70"
			@click.stop.prevent="toggleSpeech"
		>
			<svg-icon name="icon-voice-1" size="36" />
		</view>
		<text class="time">{{createTime}}</text>
	</view>
</template>

<script lang="uts" setup>
	import { ref, computed, onMounted, onUnmounted } from "vue";
	import { MsgItem } from '@/types/interfaces/ai-msg';
	import { formatTimeAgo } from '@/utils/common';
	import { useI18n, emptyI18nParams } from '@/utils/i18n';
	import { cleanTextForSpeech } from "@/subpackages/utils/voice/textFilter";
	import {
		loadVoiceSettings,
		cloneVoiceSettings,
	} from "@/subpackages/utils/voice/voiceTypes";
	import {
		ttsWebSocketPlayer,
		type TtsPlaybackState,
	} from "@/subpackages/utils/voice/ttsWebSocketPlayer";
	import { audioPlayerManager } from "@/subpackages/utils/voice/audioPlayerManager";
	import { voiceStreamSpeaker } from "@/subpackages/utils/voice/voiceStreamSpeaker";
	import type { AudioPlayerState } from "@/subpackages/utils/voice/voiceTypes";

	const { t: tFn } = useI18n();
	const t = (key: string): string => tFn(key, emptyI18nParams(), "");

	// 使用 ref 来存储时间，自动更新时间
	const createTime = ref<string>('')
	const isSpeaking = ref<boolean>(false)
	const speechFrame = ref<boolean>(false)
	let ttsListenerId: number = 0
	let audioListenerId: number = 0
	let speechAnimationTimer: number | null = null

	const props = withDefaults(defineProps<{
		msg: MsgItem
		speakText?: string
	}>(), {
		speakText: "",
	})

	const msg = computed<MsgItem>(() => props.msg as MsgItem)

	// 更新时间的函数
	const updateTime = () => {
		const ts = msg.value.create_time;
		if (ts <= 0) {
			createTime.value = '';
			return;
		}
		createTime.value = formatTimeAgo(new Date(ts).toISOString());
	}

	// 定时器 ID（ref 避免 closure smart cast 问题）
	const timerId = ref<number | null>(null)

	// 启动定时器，每分钟更新一次
	const startTimer = () => {
		updateTime()
		timerId.value = setInterval(() => {
			updateTime()
		}, 60000) as number
	}

	// 停止定时器
	const stopTimer = () => {
		const id = timerId.value
		if (id != null) {
			clearInterval(id)
			timerId.value = null
		}
	}

	const startSpeechAnimation = (): void => {
		if (speechAnimationTimer != null) {
			return
		}
		speechFrame.value = true
		speechAnimationTimer = setInterval(() => {
			speechFrame.value = !speechFrame.value
		}, 420) as number
	}

	const stopSpeechAnimation = (): void => {
		const timer = speechAnimationTimer
		if (timer != null) {
			clearInterval(timer)
			speechAnimationTimer = null
		}
		speechFrame.value = false
	}

	/** TTS fail/结束时强制退出本条消息的播报 UI */
	const clearSpeakingUi = (): void => {
		isSpeaking.value = false
		speechFrame.value = false
		stopSpeechAnimation()
	}

	/** 工具栏播报中：工具栏 TTS WebSocket，或该消息的流式播报 */
	const refreshSpeakingUi = (): void => {
		const messageId = msg.value._id
		const ttsState = ttsWebSocketPlayer.getState()
		const ttsMessageId = ttsWebSocketPlayer.getMessageId()
		// error / idle / paused / 无 messageId：一律未播报
		if (
			ttsState == "error" ||
			ttsState == "idle" ||
			ttsState == "paused" ||
			ttsMessageId.length == 0
		) {
			const streamSpeaking =
				voiceStreamSpeaker.getMessageId() == messageId &&
				voiceStreamSpeaker.isBusy()
			if (streamSpeaking != true) {
				clearSpeakingUi()
				return
			}
		}
		const ttsSpeaking =
			ttsMessageId == messageId &&
			(ttsState == "connecting" ||
				ttsState == "synthesizing" ||
				ttsState == "playing")
		const streamSpeaking =
			voiceStreamSpeaker.getMessageId() == messageId &&
			voiceStreamSpeaker.isBusy()
		const speaking = ttsSpeaking || streamSpeaking
		isSpeaking.value = speaking
		if (speaking) {
			startSpeechAnimation()
		} else {
			stopSpeechAnimation()
		}
	}

	onMounted(() => {
		startTimer()
		ttsListenerId = ttsWebSocketPlayer.subscribe(
			(state: TtsPlaybackState, eventMessageId: string): void => {
				// 失败/结束：按消息匹配后强制清 UI，不再走 refresh（避免又算回 true）
				if (state == "error" || state == "idle") {
					if (
						eventMessageId.length == 0 ||
						eventMessageId == msg.value._id
					) {
						clearSpeakingUi()
						return
					}
				}
				refreshSpeakingUi()
			},
		)
		audioListenerId = audioPlayerManager.subscribe(
			(_state: AudioPlayerState, _messageId: string): void => {
				refreshSpeakingUi()
			},
		)
		refreshSpeakingUi()
	})

	onUnmounted(() => {
		stopTimer()
		stopSpeechAnimation()
		if (ttsListenerId > 0) {
			ttsWebSocketPlayer.unsubscribe(ttsListenerId)
			ttsListenerId = 0
		}
		if (audioListenerId > 0) {
			audioPlayerManager.unsubscribe(audioListenerId)
			audioListenerId = 0
		}
	})

	const copy = () => {
		const text = msg.value.body
		if (text.length == 0) {
			uni.showToast({
				title: t('Mobile.ThirdParty.UniAiX.invalidMessageContent'),
				icon: 'none',
			})
			return
		}
		uni.setClipboardData({
			data: text,
			success: () => {
				uni.showToast({
					title: t('Mobile.Common.copySuccess'),
					icon: 'success',
				})
			},
			fail: () => {
				uni.showToast({
					title: t('Mobile.Common.copyFailed'),
					icon: 'none',
				})
			}
		})
	}

	/** 当前消息是否正被流式播报占用 */
	const isStreamSpeakingThisMsg = (): boolean => {
		const messageId = msg.value._id
		return (
			voiceStreamSpeaker.getMessageId() == messageId &&
			voiceStreamSpeaker.isBusy()
		)
	}

	/** 播报或停止当前 AI 消息。 */
	const toggleSpeech = async (): Promise<void> => {
		const messageId = msg.value._id
		// 停止：工具栏 TTS 或本条流式续播
		if (isSpeaking.value) {
			const ttsMatch = ttsWebSocketPlayer.getMessageId() == messageId
			const streamMatch = isStreamSpeakingThisMsg()
			if (ttsMatch || streamMatch) {
				ttsWebSocketPlayer.stop()
				voiceStreamSpeaker.stop()
				audioPlayerManager.stop()
				refreshSpeakingUi()
				return
			}
		}
		// 优先用服务层预计算的 speakableText（经 speak-text 传入）；为空再对 body 过滤一次
		let speakableText = ""
		if (props.speakText.length > 0) {
			speakableText = props.speakText
		} else {
			const filterSettings = cloneVoiceSettings(loadVoiceSettings())
			filterSettings.includeThinkContent = false
			filterSettings.includeCodeBlocks = false
			// UTS/Android：须显式传第三参，默认参数不会生成二参重载
			speakableText = cleanTextForSpeech(
				msg.value.body,
				filterSettings,
				true,
			)
		}
		if (speakableText.length == 0) {
			uni.showToast({
				title: t("Mobile.Voice.noSpeakableContent"),
				icon: "none",
			})
			return
		}
		try {
			// 先停掉当前流式/工具栏播报，再开本轮分段 TTS
			// （speakPrepared→begin 内也会 stop，此处显式打断，避免两路抢音频）
			voiceStreamSpeaker.stop()
			ttsWebSocketPlayer.stop()
			audioPlayerManager.stop()
			const speakSettings = cloneVoiceSettings(loadVoiceSettings())
			speakSettings.autoPlay = true
			speakSettings.includeThinkContent = false
			speakSettings.includeCodeBlocks = false
			// 静音时仍可播（音量 0）；取消静音后 setMuted(false) 会立刻出声
			const mutedNow = speakSettings.muted == true
			audioPlayerManager.setMuted(mutedNow)
			ttsWebSocketPlayer.setMuted(mutedNow)
			voiceStreamSpeaker.speakPrepared(messageId, speakSettings, speakableText)
			refreshSpeakingUi()
		} catch (error: any) {
			console.error("[TTS] start failed", error)
			clearSpeakingUi()
		}
	}
</script>

<style lang="scss">
	.tool-bar-container {
		width: 100%;
		// padding: 8rpx 0;
		margin-top: 16rpx;
		display: flex;
		flex-direction: row;
		align-items: center;

		.tool-btn {
			width: 72rpx;
			height: 72rpx;
			margin-right: 20rpx;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 16rpx;
			// #ifndef APP
			cursor: pointer;
			// #endif
		}

		.tool-btn--active {
			background-color: rgba(12, 20, 102, 0.06);
		}

		.tool-btn--pulse {
			opacity: 0.55;
		}

		.time {
			margin-left: auto;
			font-size: 28rpx;
			color: rgba(0, 0, 0, 0.45);
			font-weight: 400;
		}
	}

	/* App：hover-class 用独立顶层类名，避免 iOS 默认黑底闪一下 */
	.tool-btn-hover {
		background-color: #f2f3f7 !important;
	}
</style>
