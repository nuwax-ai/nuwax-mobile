/**
 * 语音会话模块配置
 * ASR / TTS 接口地址、音频参数、mock 开关集中管理。
 * 后端接口未最终确定，联调时只需修改本文件。
 */
import { API_BASE_URL } from "@/constants/config";

export class VoiceConfig {
  // ==================== TTS 语音合成 ====================
  /** TTS 合成接口地址 */
  ttsUrl: string = API_BASE_URL + "/api/audio/tts";
  /** 音色 */
  ttsVoice: string = "default";
  /** 音频格式 */
  ttsFormat: string = "mp3";
  /** 语速 */
  ttsSpeed: number = 1.0;
  /** 请求超时（ms） */
  ttsTimeout: number = 30000;

  // ==================== 流式 ASR 语音识别 ====================
  /** 流式语音输入功能开关：false 时回退到整段录音按钮 */
  streamingAsrEnabled: boolean = true;
  /** 创建识别会话 */
  asrSessionUrl: string = API_BASE_URL + "/api/audio/asr/session";
  /** 上传音频分片 */
  asrChunkUrl: string = API_BASE_URL + "/api/audio/asr/chunk";
  /** 结束识别 */
  asrFinishUrl: string = API_BASE_URL + "/api/audio/asr/finish";
  /** 采样率 */
  asrSampleRate: number = 16000;
  /** 音频格式（分片上传，App/小程序建议 pcm） */
  asrFormat: string = "pcm";
  /** 录音帧大小（KB，onFrameRecorded 回调粒度） */
  asrFrameSize: number = 4;
  /** 识别语言 */
  asrLanguage: string = "zh-CN";
  /** 分片上传间隔（ms） */
  asrChunkInterval: number = 2000;
  /** mock 模式下流式吐字的预设文本 */
  asrMockStreamText: string = "你好，这是一段流式语音识别的模拟文本，松开手指后可以继续编辑再发送。";

  // ==================== mock 开关（接口未就绪时使用） ====================
  /** TTS mock 开关：true 时不请求接口，走 mock 流程 */
  ttsMock: boolean = true;
  /** ASR mock 开关：true 时不请求接口，走 mock 流程 */
  asrMock: boolean = true;
  /**
   * mock 模式下使用的测试音频地址。
   * 为空字符串时播放器自动跳过实际播放，仅跑通"分句→合成→入队→播放状态"流转。
   */
  mockAudioUrl: string = "";

  // ==================== 播放 ====================
  /** 单条消息最大朗读句数（防止异常长文占用过多资源） */
  maxSentencesPerMessage: number = 60;
}

/** 全局默认配置单例（运行期可修改字段） */
export const voiceConfig = new VoiceConfig();
