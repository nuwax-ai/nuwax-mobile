/**
 * 项目会话首条提示词：若名称尚未定制（nameDefined=false），用 AI 生成并回写项目信息。
 * 常规项目按当前会话详情识别，包含个人电脑指定目录隐式创建的项目；全栈应用按路由 pType=UserApp 识别。
 * 全栈应用 query.id 即应用 id；常规项目 query.id 为 agentId，项目 id 由会话详情 devTargetId 传入。
 */
import { SUCCESS_CODE } from "@/constants/codes.constants";
import {
  apiAgentGenerateInfo,
  apiNormalProjectGetById,
  apiNormalProjectUpdate,
  apiUserAppGetById,
  apiUserAppUpdate,
} from "@/servers/project";
import {
  UserAppUpdateParams,
  UserProjectUpdateParams,
} from "@/types/interfaces/projectInfo";
import { apiResCode, apiResData } from "@/utils/apiResponse";
import { delegateTitleBootstrap } from "@/utils/titleBootstrapBridge";
import { getImSessionStamp } from "@/utils/im/imSessionScope";
import { captureDrawerTitleContext, publishDrawerTitleChange } from "@/utils/drawerTitleSync";

const ensureInFlightKeys = new Set<string>();
// 已生成的名称/图标与写回分开：写回失败只重试保存，不重新生成图标。
const generatedProjectInfo = new Map<string, UTSJSONObject>();
let ensuredSession = "";
const ensuredKeys: string[] = [] as string[];

function readQueryString(options: UTSJSONObject, key: string): string {
  const raw = options[key];
  return raw != null ? `${raw}` : "";
}

function readQueryNumber(options: UTSJSONObject, key: string): number {
  const raw = options[key];
  if (raw == null) {
    return 0;
  }
  const parsed = parseFloat(`${raw}`);
  return parsed != parsed ? 0 : parsed;
}

function isSupportedProjectType(pType: string): boolean {
  return pType == "NormalProject" || pType == "UserApp";
}

function normalizeProjectChatType(pType: string): string {
  return isSupportedProjectType(pType) ? pType : "";
}

function pickQueryValue(url: string, key: string): string {
  const needle = `${key}=`;
  const from = url.indexOf(needle);
  if (from < 0) {
    return "";
  }
  const start = from + needle.length;
  let end = url.indexOf("&", start);
  if (end < 0) {
    end = url.indexOf("#", start);
  }
  if (end < 0) {
    end = url.length;
  }
  return url.substring(start, end);
}

function isNameDefined(raw: any | null): boolean {
  if (raw == true) {
    return true;
  }
  const text = `${raw}`;
  return text == "true" || text == "1" || text == "Yes";
}

function isNameUndefined(raw: any | null): boolean {
  if (raw == false) {
    return true;
  }
  const text = `${raw}`;
  return text == "false" || text == "0" || text == "No";
}

function projectEnsureKey(pType: string, projectId: number): string {
  return `${pType}:${projectId}`;
}

function hasEnsured(key: string): boolean {
  for (let i = 0; i < ensuredKeys.length; i++) {
    if (ensuredKeys[i] == key) {
      return true;
    }
  }
  return false;
}

function markEnsured(key: string): void {
  if (hasEnsured(key) != true) {
    ensuredKeys.push(key);
  }
}

/**
 * 从页面 options 读取项目类型（仅 NormalProject / UserApp）。
 */
export function readProjectChatType(options: UTSJSONObject): string {
  return normalizeProjectChatType(readQueryString(options, "pType"));
}

/**
 * 从页面 options 读取项目 id。仅全栈应用路由里 id 是应用 id；常规项目不要用这个值。
 */
export function readProjectChatId(options: UTSJSONObject): number {
  if (readProjectChatType(options).length == 0) {
    return 0;
  }
  return readQueryNumber(options, "id");
}

/**
 * 从完整 URL 中抽出 pType（NormalProject / UserApp）。
 */
export function readProjectChatTypeFromUrl(url: string): string {
  if (url.length == 0) {
    return "";
  }
  return normalizeProjectChatType(pickQueryValue(url, "pType"));
}

function readGeneratedString(obj: UTSJSONObject, key: string): string {
  const raw = obj[key];
  return raw != null ? `${raw}` : "";
}

/**
 * 名称未定制时：按当前提示词生成项目信息并按类型回写。
 * 失败不打断发消息；同一项目只尝试一次成功回写。
 */
export async function ensureProjectNameFromPrompt(
  pType: string,
  projectId: number,
  prompt: string,
): Promise<void> {
  if (isSupportedProjectType(pType) != true || projectId <= 0) {
    return;
  }
  const trimmed = prompt.trim();
  if (trimmed.length == 0) {
    return;
  }
  const session = getImSessionStamp();
  if (ensuredSession != session) {
    ensureInFlightKeys.clear();
    generatedProjectInfo.clear();
    ensuredKeys.splice(0, ensuredKeys.length);
    ensuredSession = session;
  }
  const key = projectEnsureKey(pType, projectId);
  if (hasEnsured(key) == true || ensureInFlightKeys.has(key)) {
    return;
  }
  if (delegateTitleBootstrap("project", projectId, trimmed, pType)) return;
  ensureInFlightKeys.add(key);
  try {
    for (let attempt = 0; attempt < 3; attempt++) {
      if (attempt > 0) {
        await new Promise<void>((resolve) => { setTimeout(() => { resolve(); }, attempt == 1 ? 1000 : 3000); });
      }
      if (session != getImSessionStamp()) return;
      await tryEnsureProjectName(pType, projectId, trimmed, key);
      if (hasEnsured(key)) return;
    }
  } finally {
    if (session == getImSessionStamp()) ensureInFlightKeys.delete(key);
  }
}

async function tryEnsureProjectName(pType: string, projectId: number, trimmed: string, key: string): Promise<void> {
  const titleContext = captureDrawerTitleContext();
  const session = titleContext.session;
  try {
    const detailRes =
      pType == "UserApp"
        ? await apiUserAppGetById(projectId)
        : await apiNormalProjectGetById(projectId);
    if (session != getImSessionStamp()) return;
    if (apiResCode(detailRes) != SUCCESS_CODE) {
      return;
    }
    const detailRaw = apiResData<any>(detailRes);
    if (detailRaw == null) {
      return;
    }
    const detailObj = detailRaw as UTSJSONObject;
    if (isNameDefined(detailObj["nameDefined"]) == true) {
      markEnsured(key);
      const existingName = readGeneratedString(detailObj, "name").trim();
      if (existingName.length > 0) publishDrawerTitleChange("project", projectId, existingName, pType, titleContext);
      return;
    }
    if (isNameUndefined(detailObj["nameDefined"]) != true) {
      return;
    }

    let generateObj = generatedProjectInfo.get(key);
    if (generateObj == null) {
      const generateRes = await apiAgentGenerateInfo(trimmed);
      if (session != getImSessionStamp()) return;
      if (apiResCode(generateRes) != SUCCESS_CODE) return;
      const generateRaw = apiResData<any>(generateRes);
      if (generateRaw == null) return;
      generateObj = generateRaw as UTSJSONObject;
      if (readGeneratedString(generateObj, "name").trim().length == 0) return;
      generatedProjectInfo.set(key, generateObj);
    }
    const name = readGeneratedString(generateObj, "name").trim();
    const description = readGeneratedString(generateObj, "description");
    const icon = readGeneratedString(generateObj, "iconUrl");
    let updateOk = false;

    // 全栈应用更新
    if (pType == "UserApp") {
      const params = new UserAppUpdateParams();
      params.id = projectId;
      params.name = name;
      if (description.length > 0) {
        params.description = description;
      }
      if (icon.length > 0) {
        params.icon = icon;
      }

      // 更新项目信息
      const updateRes = await apiUserAppUpdate(params);
      updateOk = apiResCode(updateRes) == SUCCESS_CODE;
    } else {
      // 常规项目更新
      const params = new UserProjectUpdateParams();
      params.id = projectId;
      params.name = name;
      if (description.length > 0) {
        params.description = description;
      }
      if (icon.length > 0) {
        params.icon = icon;
      }
      const updateRes = await apiNormalProjectUpdate(params);
      updateOk = apiResCode(updateRes) == SUCCESS_CODE;
    }
    if (session != getImSessionStamp()) return;
    if (updateOk == true) {
      markEnsured(key);
      generatedProjectInfo.delete(key);
      publishDrawerTitleChange("project", projectId, name, pType, titleContext);
    }
  } catch (_error) {
    // 后台生成失败交给外层退避重试，不阻断聊天。
  }
}
