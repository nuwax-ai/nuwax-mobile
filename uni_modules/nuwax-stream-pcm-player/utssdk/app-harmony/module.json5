{
  "module": {
    "requestPermissions": [
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:nuwax_microphone_reason",
        "usedScene": {
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:nuwax_background_audio_reason",
        "usedScene": {
          "when": "always"
        }
      }
    ]
  }
}
