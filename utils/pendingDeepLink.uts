/**
 * 一次性「业务深链」（外部唤起）跨生命周期传递。
 *
 * 冷启动 / 热启动经 uni.getLaunchOptionsSync() / uni.getEnterOptionsSync() 拿到
 * appScheme / appLink 后，若为业务深链则暂存到 storage；登录态就绪后由 App.onShow
 * 消费并跳转。对齐 utils/pendingOpenUiAction.uts 的 storage-and-consume 模式
 * （App 内无事件总线，跨生命周期数据走 storage）。
 *
 * 设计要点：
 * - 冷启动未登录会 reLaunch 登录页（App.uvue），reLaunch 会丢 launch options，
 *   因此必须「先落盘 pending，再 reLaunch」，pending 存在 storage 里跨页面/跨重启存活。
 * - consume 即删，保证幂等（同一条深链不会被消费两次）；TTL 10min 对齐 pendingOpenUiAction。
 *
 * 与支付同域 path 分流：/open/* 为业务（本模块管），/wechat/*、pay.nuwax.com 为支付
 * （支付线后续接入入站，本模块只处理业务 —— 见 utils/deepLinkRouter.uts 的 extractBusinessUrl）。
 */
const PREFIX = "pendingDeepLink:";
/** 唯一暂存键（业务深链一次只关心最新一条）。 */
const LATEST_KEY = PREFIX + "latest";
const TTL_MS = 10 * 60 * 1000;

function parsePendingPayload(raw: any | null): UTSJSONObject | null {
  if (raw == null || `${raw}`.length == 0) {
    return null;
  }
  try {
    return JSON.parse<UTSJSONObject>(`${raw}`);
  } catch (_e) {
    return null;
  }
}

/** 暂存一条业务深链 URL（覆盖最新一条）。空串忽略。 */
export function savePendingDeepLink(url: string): void {
  if (url.length == 0) {
    return;
  }
  const payload = {} as UTSJSONObject;
  payload["url"] = url;
  payload["createdAt"] = Date.now();
  uni.setStorageSync(LATEST_KEY, JSON.stringify(payload));
}

/**
 * 读取并删除暂存的业务深链 URL；超时（10min）或空返回 ""。
 * 消费即删 —— 保证幂等，同一条深链不会被跳两次。
 */
export function consumePendingDeepLink(): string {
  const raw = uni.getStorageSync(LATEST_KEY);
  const parsed = parsePendingPayload(raw);
  try {
    uni.removeStorageSync(LATEST_KEY);
  } catch (_e) {
    // ignore
  }
  if (parsed == null) {
    return "";
  }
  const createdAt = (parsed["createdAt"] as number | null) ?? 0;
  const url = `${(parsed["url"] as string | null) ?? ""}`;
  if (Date.now() - createdAt > TTL_MS) {
    return "";
  }
  return url;
}

/** 只读不删（调试 / 判断当前是否有待消费深链）。 */
export function peekPendingDeepLink(): string {
  const raw = uni.getStorageSync(LATEST_KEY);
  const parsed = parsePendingPayload(raw);
  if (parsed == null) {
    return "";
  }
  const createdAt = (parsed["createdAt"] as number | null) ?? 0;
  const url = `${(parsed["url"] as string | null) ?? ""}`;
  if (Date.now() - createdAt > TTL_MS) {
    return "";
  }
  return url;
}
