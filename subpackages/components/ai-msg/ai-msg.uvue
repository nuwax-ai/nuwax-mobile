<template>
  <view class="msg-root">
    <text v-if="msg.error_msg != null && msg.error_msg.length > 0" class="error-msg">
      {{ msg.error_msg }}
    </text>
    <template v-else>
      <!-- AI 思考模式 -->
      <view class="think-container" v-if="thinkContent.length > 0">
        <view class="think-header">
          <view class="think-header-left" @tap="changeThinkContent">
            <svg-icon name="icon-BulbOutlined" customClass="thinking-icon" />
            <text class="thinking-title">
              {{
                isThinkingFinished
                  ? t("Mobile.Chat.thought")
                  : t("Mobile.Chat.thinking")
              }}
            </text>
            <text
              class="iconfont icon-a-Chevrondown expand-icon"
              :class="{ 'is-expanded': !hideThinkContent }"
            ></text>
          </view>
        </view>
        <view
          class="think-content"
          :class="{ 'hide-think-content': hideThinkContent }"
        >
          <view class="text-box">
            <mp-html
              :content="thinkContent"
              :markdown="true"
              :selectable="true"
              :container-style="`font-size: 28rpx; color: #888; line-height: 1.6;`"
            />
          </view>
        </view>
      </view>

      <!-- AI 答复内容 -->
      <view class="answer-container">
        <!-- #ifdef APP -->
        <!-- App：优先字符串正文，避免 MsgItem/mp-html 链路空白；markdown 容器后续再增强 -->
        <text
          v-if="appBodyText.length > 0"
          class="answer-fallback"
          selectable="true"
        >{{ appBodyText }}</text>
        <mp-html
          v-else-if="processedText.length > 0"
          :content="processedText"
          :processing-list="msg.processingList"
          :conversation-id="msg.chat_id"
          :markdown="true"
          :selectable="true"
          :container-style="`width: 100%;`"
          :tag-style="tagStyle"
          :scroll-table="true"
        />
        <!-- #endif -->
        <!-- #ifndef APP -->
        <mp-html
          v-if="processedText.length > 0"
          :content="processedText"
          :processing-list="msg.processingList"
          :conversation-id="msg.chat_id"
          :markdown="true"
          :selectable="true"
          :container-style="`width: 100%;`"
          :tag-style="tagStyle"
          :scroll-table="true"
        />
        <!-- #endif -->
      </view>
    </template>
    <image
      v-if="showLoadingIcon"
      class="icon-loading-image"
      src="@/static/assets/icon_loading.svg"
      :show-menu-by-longpress="false"
      @longtap.stop.prevent
      @contextmenu.stop.prevent="true"
      mode="widthFix"
    />
    <msg-tool-bar
      v-if="
        ((!isConversationActive || !isLastMsg) && hasBodyOrText) ||
        msg.state === 3
      "
      :msg="msg"
      :is-speaking="isSpeaking"
      @play="handlePlay"
      @stop="handleStop"
    />
  </view>
</template>

<script lang="uts" setup>
  import { MsgItem, type markdownElItem } from "@/types/interfaces/ai-msg";
  import msgToolBar from "@/subpackages/components/msg-tool-bar/msg-tool-bar.uvue";
  import mpHtml from "@/subpackages/uni_modules/mp-html/components/mp-html/mp-html.uvue";
  import {
    replaceMathBracket,
    groupMarkdownContainers,
  } from "@/utils/markdown.uts";
  import { TaskStatus } from "@/types/enums/agent";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      /** App：父组件传入时编译器常推成 Any，内部再 as MsgItem */
      msg: any;
      /** App 可靠通道：直接传字符串，避免 MsgItem 类实例 prop 丢字段 */
      bodyText?: string;
      thinkText?: string;
      // 会话是否正在进行中（有消息正在处理）
      isConversationActive?: boolean;
      taskStatus?: TaskStatus;
      // 是否是最后一条消息
      isLastMsg?: boolean;
      /** 当前正在语音播报的消息 ID（用于播放按钮状态） */
      speakingMessageId?: string;
    }>(),
    {
      bodyText: "",
      thinkText: "",
      speakingMessageId: "",
    },
  );

  /** 克隆 MsgItem（UTS 不支持 class spread；须先于 sync 定义） */
  function cloneMsgItem(source: MsgItem): MsgItem {
    const next = new MsgItem();
    next._id = source._id;
    next.body = source.body;
    next.thinkContent = source.thinkContent;
    next.from_uid = source.from_uid;
    next.state = source.state;
    next.create_time = source.create_time;
    next.about_msg_id = source.about_msg_id;
    next.chat_id = source.chat_id;
    next.markdownElList = source.markdownElList;
    next.error_msg = source.error_msg;
    next.rendered = source.rendered;
    next.processingList = source.processingList;
    return next;
  }

  /** 将 patch 合并到 MsgItem（UTS 不支持 class 对象 spread） */
  function applyMsgPatch(target: MsgItem, patch: any): void {
    if (patch == null) return;
    const p = patch as UTSJSONObject;

    const bodyVal = p["body"];
    if (bodyVal != null) {
      target.body = `${bodyVal}`;
    } else {
      const textVal = p["text"];
      if (textVal != null) {
        target.body = `${textVal}`;
      }
    }

    const thinkVal = p["think"];
    if (thinkVal != null) {
      target.thinkContent = `${thinkVal}`;
    }
    const thinkContentVal = p["thinkContent"];
    if (thinkContentVal != null) {
      target.thinkContent = `${thinkContentVal}`;
    }

    const processingListVal = p["processingList"];
    if (processingListVal != null) {
      target.processingList = processingListVal as any[];
    }

    const stateVal = p["state"];
    if (stateVal != null) {
      target.state = stateVal as number;
    }

    const errorMsgVal = p["error_msg"];
    if (errorMsgVal != null) {
      target.error_msg = `${errorMsgVal}`;
    }

    const markdownElListVal = p["markdownElList"];
    if (markdownElListVal != null) {
      target.markdownElList = markdownElListVal as markdownElItem[];
    }

    const renderedVal = p["rendered"];
    if (renderedVal != null) {
      target.rendered = renderedVal as boolean;
    }
  }

  // 内部响应式副本；App 上必须 watch props.msg，否则历史消息 body 可能一直为空
  const msg = ref<MsgItem>(new MsgItem());
  function syncMsgFromProps(source: any | null): void {
    if (source == null) {
      msg.value = new MsgItem();
      return;
    }
    msg.value = cloneMsgItem(source as MsgItem);
  }
  syncMsgFromProps(props.msg);
  watch(
    (): any => props.msg,
    (newVal: any) => {
      syncMsgFromProps(newVal);
    },
    { deep: true },
  );

  /** 优先用字符串 prop（App 可靠），再回退 msg 字段 */
  function resolveBodyText(): string {
    if (props.bodyText != null && `${props.bodyText}`.length > 0) {
      return `${props.bodyText}`;
    }
    const body = msg.value.body;
    if (body != null && `${body}`.length > 0) {
      return `${body}`;
    }
    return "";
  }

  function resolveThinkText(): string {
    if (props.thinkText != null && `${props.thinkText}`.length > 0) {
      return `${props.thinkText}`;
    }
    const think = msg.value.thinkContent;
    if (think != null && `${think}`.length > 0) {
      return `${think}`;
    }
    return "";
  }

  // 字符串 prop 变化时写入内部 msg，保证工具栏等依赖 body 的逻辑一致
  watch(
    (): string => (props.bodyText != null ? `${props.bodyText}` : ""),
    (v: string) => {
      if (v.length > 0) {
        msg.value.body = v;
      }
    },
    { immediate: true },
  );
  watch(
    (): string => (props.thinkText != null ? `${props.thinkText}` : ""),
    (v: string) => {
      if (v.length > 0) {
        msg.value.thinkContent = v;
      }
    },
    { immediate: true },
  );

  const isLastMsg = computed((): boolean => props.isLastMsg == true);
  const isConversationActive = computed((): boolean => props.isConversationActive == true);
  const showLoadingIcon = computed((): boolean => {
    return (
      isConversationActive.value &&
      isLastMsg.value &&
      props.taskStatus != TaskStatus.EXECUTING
    );
  });

  // 思考内容是否隐藏（默认隐藏）
  const hideThinkContent = ref<boolean>(true);

  const thinkContent = computed((): string => {
    return resolveThinkText();
  });

  const hasBodyOrText = computed((): boolean => {
    return resolveBodyText().trim().length > 0;
  });

  // 思考是否已完成：如果正文已经有内容，或者会话已结束，或者不是最后一条消息，则认为思考已完成
  const isThinkingFinished = computed((): boolean => {
    return (
      resolveBodyText().trim().length > 0 ||
      !isConversationActive.value ||
      !isLastMsg.value
    );
  });

  // 标签自定义样式，解决长文本换行问题
  // #ifndef APP
  const tagStyle = {
    p: "word-break: break-all; overflow-wrap: break-word;",
    li: "word-break: break-all; overflow-wrap: break-word;",
    div: "word-break: break-all; overflow-wrap: break-word;",
    span: "word-break: break-all; overflow-wrap: break-word;",
  };
  // #endif
  // #ifdef APP
  const tagStyle = {
    p: "",
    li: "",
    div: "",
    span: "",
  };
  // #endif

  const emit = defineEmits<{
    changeThinkContent: [hideThinkContent: boolean];
    playMessage: [msg: MsgItem];
    stopMessage: [];
  }>();

  /** 本条消息是否正在播报 */
  const isSpeaking = computed((): boolean => {
    const sid = props.speakingMessageId;
    if (sid == null || `${sid}`.length == 0) {
      return false;
    }
    return msg.value._id.length > 0 && msg.value._id == `${sid}`;
  });

  function handlePlay(): void {
    // 确保工具栏拿到的 body 为最新正文（字符串 prop 为 App 可靠通道）
    msg.value.body = resolveBodyText();
    emit("playMessage", msg.value);
  }

  function handleStop(): void {
    emit("stopMessage");
  }

  const changeThinkContent = () => {
    hideThinkContent.value = !hideThinkContent.value;
    emit("changeThinkContent", hideThinkContent.value);
  };

  // 添加updateMessage方法，支持动态更新消息内容
  const updateMessage = (newData: any) => {
    try {
      if (newData != null) {
        const next = cloneMsgItem(msg.value);
        applyMsgPatch(next, newData);
        msg.value = next;
      }
    } catch (error) {
      console.error("updateMessage 执行失败:", error);
    }
  };
  // 处理文本内容，应用数学公式格式转换及组件合并
  const processedText = computed((): string => {
    const bodyText = resolveBodyText();
    if (bodyText.trim().length == 0) {
      return "";
    }
    try {
      const groupedText = groupMarkdownContainers(bodyText);
      return replaceMathBracket(groupedText);
    } catch (e) {
      console.error("processedText failed:", e);
      return bodyText;
    }
  });

  /** App：直接展示字符串正文（最可靠） */
  const appBodyText = computed((): string => {
    return resolveBodyText();
  });

  // 暴露方法给父组件
  defineExpose({
    updateMessage,
  });
</script>

<style lang="scss">
  .msg-root {
    display: flex;
    flex-direction: column;
    width: 100%;
    // #ifndef APP
    user-select: text;
    -webkit-user-select: text;
    // #endif
    padding: 0 32rpx;
    min-height: 90rpx;
    box-sizing: border-box;

    .think-container {
      width: 100%;

      .think-header {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 8rpx 0;

        .think-header-left {
          display: flex;
          flex-direction: row;
          align-items: center;

          .thinking-icon {
            font-size: 36rpx;
            color: #999;
            margin-right: 12rpx;
          }

          .thinking-title {
            color: #999;
            font-size: 28rpx;
          }

          .expand-icon {
            margin-left: 12rpx;
            font-size: 28rpx;
            color: #999;
            transition: transform 0.3s ease;

            &.is-expanded {
              transform: rotate(180deg);
            }
          }
        }
      }

      .think-content {
        overflow: hidden;
        transition: all 0.3s ease;
        padding-top: 8rpx;

        &.hide-think-content {
          height: 0;
          padding-top: 0;
          opacity: 0;
        }

        .text-box {
          border-left: 4rpx solid #efefef;
          padding-left: 20rpx;
          background-color: rgba(245, 245, 245, 0.3);
          border-radius: 0 8rpx 8rpx 0;
          padding-top: 8rpx;
          padding-bottom: 8rpx;

          .text {
            font-size: 28rpx;
            color: #888;
            line-height: 1.6;
            white-space: pre-wrap;
            /* #ifndef APP */
            word-break: break-all;
            /* #endif */
          }
        }
      }
    }

    .answer-container {
      width: 100%;
    }

    .answer-fallback {
      width: 100%;
      font-size: 28rpx;
      color: #15171f;
      line-height: 1.6;
      // #ifdef APP
      /* App text 组件换行 */
      /* #endif */
    }

    .error-msg {
      color: #ff4d4f;
      font-size: 28rpx;
      line-height: 52rpx;
    }

    .loging-icon {
      margin-top: 16rpx;
      width: 32rpx;
      height: 32rpx;
    }
    .stop-text {
      color: #aaa;
      font-size: 28rpx;
      padding: 16rpx 0;
    }
    .need-try {
      color: #ff4d4f;
      font-size: 28rpx;
      padding: 16rpx;
    }
    .error-msg,
    .stop-text,
    .need-try {
      text-align: left;
      width: 100%;
    }
  }

  .text {
    color: #15171f;
    font-weight: 400;
    line-height: 56rpx;
    white-space: pre-wrap;
    /* #ifndef APP */
    word-break: break-all;
    overflow-wrap: anywhere;
    max-width: 100%;
    /* #endif */
  }
  .strong {
    font-weight: bold;
  }

  .em {
    font-style: italic;
  }

  .del {
    /* #ifndef APP */
    text-decoration-line: line-through;
    /* #endif */
    color: #999;
  }

  .space {
    height: 10px;
  }
  .link {
    color: #0066cc !important;
    /* #ifndef APP */
    word-break: break-all;
    overflow-wrap: anywhere;
    /* #endif */
    // #ifndef APP
    cursor: pointer;
    &:hover {
      opacity: 0.8;
    }
    // #endif
  }

  .paragraph-box {
    /* #ifndef APP */
    display: block;
    /* #endif */
    .text {
      font-size: 32rpx;
      font-weight: 400;
      line-height: 56rpx;
      // 自动换行并显示 \n
      white-space: pre-wrap;
      /* #ifndef APP */
      word-break: break-all;
      overflow-wrap: anywhere;
      max-width: 100%;
      /* #endif */
      /* #ifdef H5 */
      width: auto;
      word-break: break-all;
      /* #endif */
    }
  }
  .image-box {
    width: 100%;
  }
  .blockquote-box {
    padding: 5px;
    background: #f5f5f5;
    border-left: 4px solid #ddd;
  }
  .container-box {
    width: 100%;
  }
  .heading-box {
    .text {
      color: #15171f;
      font-size: 40rpx;
      font-weight: 600;
      line-height: 56rpx;
    }
    .depth-1 {
      font-size: 50rpx;
      line-height: 60rpx;
    }

    .depth-2 {
      font-size: 42rpx;
      line-height: 56rpx;
    }

    .depth-3 {
      font-size: 34rpx;
      line-height: 56rpx;
    }

    .depth-4 {
      font-size: 30rpx;
      line-height: 56rpx;
    }

    .depth-5 {
      font-size: 26rpx;
      line-height: 56rpx;
    }

    .depth-6 {
      font-size: 24rpx;
      color: #999;
      line-height: 56rpx;
    }
  }

  .hr {
    height: 2rpx;
    background: #ddd;
    margin: 20rpx 0;
  }
  .br {
    width: 100%;
    /* #ifndef APP */
    display: block;
    /* #endif */
  }

  .list-box {
    padding-left: 10rpx;
    .list-content {
      width: 100%;
    }
    .text {
      line-height: 56rpx;
    }
    .list-item-content-box {
      flex: 1;
      .list {
        margin-top: 0;
      }
    }
    .list-item-br {
      width: 100%;
    }
    .list-item-index {
      width: 40rpx;
      &.unordered {
        font-size: 28rpx;
        color: #000;
      }
      &.task {
        font-size: 28rpx;
        color: #666;
      }
    }
  }
  .list-inline-image-box {
    /* #ifndef APP */
    max-width: 100%;
    display: block;
    /* #endif */
    .list-content {
      width: 100%;
    }
    .text {
      line-height: 56rpx;
    }
    .list-item-content-box {
      flex: 1;
      .list {
        margin-top: 0;
      }
    }
    .list-item-br {
      width: 100%;
    }
    .list-item-index {
      width: 40rpx;
      &.unordered {
        font-size: 28rpx;
        color: #000;
      }
      &.task {
        font-size: 28rpx;
        color: #666;
      }
    }
  }

  .hr-box {
    background-color: #ddd;
    height: 2rpx;
  }

  .tool-call-box {
    width: 100%;
    margin: 10rpx 0;
  }

  .table-box,
  .code-box,
  .hr-box,
  .paragraph-box,
  .blockquote-box,
  .heading-box,
  .list-box,
  .loging-icon,
  .math-box {
    width: 100%;
    margin: 10rpx 0;
  }
  .paragraph-box {
    margin-top: 0;
    margin-bottom: 0;
  }

  .space-box {
