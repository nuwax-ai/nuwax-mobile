// #ifdef APP-ANDROID
import ViewConfiguration from "android.view.ViewConfiguration";
// #endif

/** 只过滤设备认为仍属按下抖动的位移；方向由横纵累计位移比较决定。 */
export function gestureTouchSlop(): number {
  // #ifdef APP-ANDROID
  const context = UTSAndroid.getAppContext();
  if (context != null) {
    // Android 原生容差是物理像素，UniTouch 的坐标是逻辑像素。
    return ViewConfiguration.get(context).getScaledTouchSlop() / uni.getWindowInfo().pixelRatio;
  }
  // #endif
  return 0;
}
