<template>
  <view class="app-square">
    <view v-if="squareBooting" class="app-square__boot">
      <view class="app-square__boot-spinner"></view>
      <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
    </view>
    <!-- App：官方 nested-scroll，上滑先收最近使用，再滚当前分类；左右滑仍是一层 swiper。 -->
    <!-- #ifdef APP -->
    <scroll-view
      class="app-square__list"
      type="nested"
      direction="vertical"
      :bounces="false"
      :show-scrollbar="false"
      :refresher-enabled="true"
      :refresher-triggered="currentRefreshing"
      @refresherrefresh="handleRefresh"
    >
      <nested-scroll-header>
        <recent-app-section
          :pages="recentPages"
          :current="recentSwiperCurrent"
          @change="handleRecentSectionChange"
          @indicator-click="handleRecentIndicatorClick"
          @item-click="handleAgentClick"
        />
      </nested-scroll-header>
      <nested-scroll-body>
        <view class="app-square__body">
          <view class="category-nav border-b">
            <scroll-view
              class="category-scroll"
              direction="horizontal"
              :scroll-x="true"
              :scroll-y="false"
              :scroll-with-animation="true"
              :scroll-into-view="scrollIntoView"
              :show-scrollbar="false"
            >
              <view class="category-scroll-content">
                <view
                  :id="category.key"
                  v-for="(category, index) in categories"
                  :key="category.key"
                  :class="activeCategory == category.key ? 'category-item active' : 'category-item'"
                  @click="handleCategoryClick(category.key, index)"
                >
                  <text
                    :class="activeCategory == category.key ? 'category-text category-text-active' : 'category-text'"
                  >{{
                    translate(category.label)
                  }}</text>
                </view>
              </view>
            </scroll-view>
          </view>
          <swiper
            class="app-square__swiper"
            :current="activeSwiperIndex"
            @change="handleSwiperChange"
            :indicator-dots="false"
            :circular="false"
            :duration="280"
            easing-function="easeOut"
          >
            <template v-for="(category, index) in categories" :key="category.key">
              <swiper-item>
                <scroll-view
                  v-if="shouldRenderCategory(index)"
                  class="app-square__pane-scroll"
                  direction="vertical"
                  :scroll-y="true"
                  :bounces="false"
                  :show-scrollbar="false"
                  associative-container="nested-scroll-view"
                  @scrolltolower="handleLoadMore"
                >
                  <published-app-category-pane
                    :agents="categoryAgents(category.key)"
                    :loading="isCategoryLoading(category.key)"
                    :refreshing="isCategoryRefreshing(category.key)"
                    :has-more="isCategoryHasMore(category.key)"
                    :enable-subscription="enableSubscription"
                    @agent-click="handleAgentClick"
                    @collect="handlePaneCollect"
                  />
                </scroll-view>
              </swiper-item>
            </template>
          </swiper>
        </view>
      </nested-scroll-body>
    </scroll-view>
    <!-- #endif -->

    <!-- H5 / 小程序：nested-scroll 不支持 Web。swiper 高度只跟当前分类内容走，避免底部空白。 -->
    <!-- #ifndef APP -->
    <list-view
      class="app-square__list"
      direction="vertical"
      :bounces="false"
      :show-scrollbar="false"
      :refresher-enabled="true"
      :refresher-triggered="currentRefreshing"
      @refresherrefresh="handleRefresh"
      @scrolltolower="handleLoadMore"
    >
      <list-item :type="1">
        <recent-app-section
          :pages="recentPages"
          :current="recentSwiperCurrent"
          @change="handleRecentSectionChange"
          @indicator-click="handleRecentIndicatorClick"
          @item-click="handleAgentClick"
        />
      </list-item>
      <sticky-section>
        <sticky-header>
          <view class="category-nav border-b">
            <scroll-view
              class="category-scroll"
              direction="horizontal"
              :scroll-x="true"
              :scroll-y="false"
              :scroll-with-animation="true"
              :scroll-into-view="scrollIntoView"
              :show-scrollbar="false"
            >
              <view class="category-scroll-content">
                <view
                  :id="category.key"
                  v-for="(category, index) in categories"
                  :key="category.key"
                  :class="activeCategory == category.key ? 'category-item active' : 'category-item'"
                  @click="handleCategoryClick(category.key, index)"
                >
                  <text
                    :class="activeCategory == category.key ? 'category-text category-text-active' : 'category-text'"
                  >{{
                    translate(category.label)
                  }}</text>
                </view>
              </view>
            </scroll-view>
          </view>
        </sticky-header>
        <list-item :type="10">
          <swiper
            class="app-square__swiper"
            :style="categorySwiperStyle"
            :current="activeSwiperIndex"
            @change="handleSwiperChange"
            :indicator-dots="false"
            :circular="false"
            :duration="280"
            easing-function="easeOut"
          >
            <template v-for="(category, index) in categories" :key="category.key">
              <swiper-item class="app-square__swiper-item">
                <view v-if="shouldRenderCategory(index)" :id="'h5-pane-' + index" class="h5-pane-measure">
                  <published-app-category-pane
                    :agents="categoryAgents(category.key)"
                    :loading="isCategoryLoading(category.key)"
                    :refreshing="isCategoryRefreshing(category.key)"
                    :has-more="isCategoryHasMore(category.key)"
                    :enable-subscription="enableSubscription"
                    @agent-click="handleAgentClick"
                    @collect="handlePaneCollect"
                  />
                </view>
              </swiper-item>
            </template>
          </swiper>
        </list-item>
      </sticky-section>
    </list-view>
    <!-- #endif -->

    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>


<script setup lang="uts">
  import { ref, computed, onMounted, onUnmounted, watch, getCurrentInstance, nextTick, type ComponentPublicInstance } from 'vue';
  // #ifdef MP-WEIXIN
  import { onShow, onUnload } from "@dcloudio/uni-app";
  // #endif
  import { CONST_ALL } from "@/constants/common.constants";
  import { SquarePublishedListParams } from "@/types/interfaces/square";
  import { SquarePublishedItemInfo } from "@/types/interfaces/square";
  import { RequestResponse, Page } from "@/types/interfaces/request";
  import { apiPublishedCategoryList, apiPublishedAppList } from "@/servers/square";
  import { SUCCESS_CODE, USER_NO_LOGIN, REDIRECT_LOGIN } from "@/constants/codes.constants";
  import RecentAppSection from "./recent-app-section.uvue";
  import PublishedAppCategoryPane from "./published-app-category-pane.uvue";
  import { RecentAppPage } from "@/types/interfaces/recentAppPage";
  import { dispatchPublishedAppClick, isPublishedPageApp, readPublishedAppProjectId, readPublishedAppProjectType } from "@/utils/publishedAppJump";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import { goToLogin } from "@/utils/authNavigation";
  import { apiUserProjectCollect, apiUserProjectUnCollect } from "@/servers/project";
  import { apiUnCollectAgent, apiCollectAgent } from "@/servers/agentDev";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  // #ifdef MP-WEIXIN
  import AuthLoginPopup from "@/components/auth-login-popup/auth-login-popup.uvue";
  // #endif
  import { t as translateFn, translateText, emptyI18nParams } from "@/utils/i18n";

  const translate = (text : string) : string => {
    return translateText(text);
  };

  const _i18nParams = emptyI18nParams();
  const t = (key: string): string => translateFn(key, _i18nParams, "");

  const props = withDefaults(
    defineProps<{
      isOfficial?: boolean;
      recentPages?: RecentAppPage[];
    }>(),
    {
      isOfficial: true,
      recentPages: [] as RecentAppPage[],
    },
  );

  // 使用登录拦截 composable
  const authInterceptor = useAuthInterceptor();
  const loginPopupRef = authInterceptor.loginPopupRef;
  const baseHandleAgentClick = authInterceptor.handleAgentClick as (info : any) => void;
  const hasToken = authInterceptor.hasToken as () => Promise<boolean>;

  // 登录态
  const isLoggedIn = ref<boolean>(false);
  /** 最近使用 swiper 当前页，各分类列表共用，左右滑时顶部保持一致 */
  const recentSwiperCurrent = ref<number>(0);

  function handleRecentSectionChange(index: number): void {
    recentSwiperCurrent.value = index;
  }

  function handleRecentIndicatorClick(index: number): void {
    recentSwiperCurrent.value = index;
  }

  watch(
    (): number => props.recentPages.length,
    (nextLen: number, prevLen: number) => {
      if (nextLen != prevLen) {
        recentSwiperCurrent.value = 0;
      }
    },
  );

  // Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject 或直接点方法；用 $callMethod 调 defineExpose 方法
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // 登录
  const handleLogin = () => {
    // #ifdef MP-WEIXIN
    callRefMethod(loginPopupRef.value, "open");
    // #endif

    // #ifdef H5 || WEB || APP
    goToLogin();
    // #endif
  };

  // 当前分类
  const activeCategory = ref<string>(CONST_ALL);
  // 当前swiper索引
  const activeSwiperIndex = ref<number>(0);

  class PublishedCategoryItem {
    key : string = "";
    label : string = "";
    active : boolean = false;
    constructor(key : string, label : string, active : boolean) {
      this.key = key;
      this.label = label;
      this.active = active;
    }
  }
  // 分类列表
  const categories = ref<PublishedCategoryItem[]>([]);
  // 智能体列表
  // Android: use UTSJSONObject[] because JSON.parse returns UTSJSONObject trees (not typed interface instances).
  // Bracket notation works on UTSJSONObject; `any["key"]` would compile to String.get in Kotlin.
  const agentListMap = ref<Record<string, UTSJSONObject[]>>({} as Record<string, UTSJSONObject[]>);
  // 加载状态
  const loadingMap = ref<Record<string, boolean>>({} as Record<string, boolean>);
  // 刷新状态
  const refreshingMap = ref<Record<string, boolean>>({} as Record<string, boolean>);
  // 页码
  const pageMap = ref<Record<string, number>>({} as Record<string, number>);
  // 是否还有更多
  const hasMoreMap = ref<Record<string, boolean>>({} as Record<string, boolean>);
  /** 「全部」分类首屏官方列表为空后，后续请求改走 official=false */
  const officialFallbackMap = ref<Record<string, boolean>>({} as Record<string, boolean>);
  /** 列表 Map 原地改 key 时强制模板重读 */
  const listEpoch = ref(0);
  /** 首次进页：分类和列表都未就绪时盖住「全部应用」空标题 */
  const squareBooting = ref<boolean>(true);
  const fetchGenMap: Record<string, number> = {} as Record<string, number>;
  // 搜索关键词
  const searchKeyword = ref<string>("");
  // 滚动到对应的分类标签
  const scrollIntoView = ref<string>("");
  // 搜索定时器
  const searchTimeoutRef = ref<number>(0);

  const enableSubscription = computed((): number => 0);

  function bumpListEpoch(): void {
    listEpoch.value = listEpoch.value + 1;
  }

  const EMPTY_AGENTS: UTSJSONObject[] = [] as UTSJSONObject[];

  const currentRefreshing = computed((): boolean => {
    const _tick = listEpoch.value;
    return refreshingMap.value[activeCategory.value] == true;
  });

  function categoryAgents(key: string): UTSJSONObject[] {
    const _tick = listEpoch.value;
    const raw = agentListMap.value[key];
    return raw != null ? raw : EMPTY_AGENTS;
  }

  function isCategoryLoading(key: string): boolean {
    const _tick = listEpoch.value;
    return loadingMap.value[key] == true;
  }

  function isCategoryRefreshing(key: string): boolean {
    const _tick = listEpoch.value;
    return refreshingMap.value[key] == true;
  }

  function isCategoryHasMore(key: string): boolean {
    const _tick = listEpoch.value;
    return hasMoreMap.value[key] == true;
  }

  function shouldRenderCategory(index: number): boolean {
    return Math.abs(index - activeSwiperIndex.value) <= 1;
  }

  // #ifndef APP
  const h5SwiperHeightPx = ref<number>(0);
  const h5MeasureProxy = getCurrentInstance();
  let h5SwipeTimer = 0;
  let h5PendingIndex = -1;
  let h5IgnoreChange = false;

  function estimatePaneHeightPx(count: number): number {
    const info = uni.getWindowInfo();
    const winW = info.windowWidth != null ? info.windowWidth : 375;
    if (count <= 0) {
      return Math.floor((480 * winW) / 750);
    }
    let extra = 0;
    if (count > 6) {
      extra = (80 * winW) / 750;
    }
    return Math.floor(count * ((196 * winW) / 750) + extra);
  }

  function readRectHeight(rect: NodeInfo | null): number {
    if (rect == null || rect.height == null) {
      return 0;
    }
    const h = parseFloat(`${rect.height}`);
    if (Number.isNaN(h) == true) {
      return 0;
    }
    return h;
  }

  function measureH5PaneHeight(attempt: number): void {
    if (h5MeasureProxy == null || h5MeasureProxy.proxy == null) {
      return;
    }
    const sel = "#h5-pane-" + activeSwiperIndex.value;
    uni.createSelectorQuery()
      .in(h5MeasureProxy.proxy)
      .select(sel)
      .boundingClientRect()
      .exec((results: Array<any>) => {
        const h = results.length > 0 ? readRectHeight(results[0] as NodeInfo) : 0;
        if (h > 1) {
          const nextH = Math.ceil(h);
          if (h5SwiperHeightPx.value == nextH) {
            return;
          }
          h5IgnoreChange = true;
          h5SwiperHeightPx.value = nextH;
          setTimeout(() => {
            h5IgnoreChange = false;
          }, 360);
          return;
        }
        if (attempt < 4) {
          setTimeout(() => {
            measureH5PaneHeight(attempt + 1);
          }, 80);
        }
      });
  }

  function scheduleMeasureH5Pane(): void {
    nextTick(() => {
      setTimeout(() => {
        measureH5PaneHeight(0);
      }, 50);
    });
  }

  const categorySwiperStyle = computed((): string => {
    const _tick = listEpoch.value;
    if (h5SwiperHeightPx.value > 0) {
      return `height:${h5SwiperHeightPx.value}px;`;
    }
    const raw = agentListMap.value[activeCategory.value];
    const n = raw != null ? raw.length : 0;
    return `height:${estimatePaneHeightPx(n)}px;`;
  });

  watch(
    (): number => listEpoch.value,
    () => {
      if (loadingMap.value[activeCategory.value] == true) {
        return;
      }
      scheduleMeasureH5Pane();
    },
  );
  // #endif

  function hasCategoryData(key: string): boolean {
    const raw = agentListMap.value[key];
    return raw != null && raw.length > 0;
  }

  // 获取分类列表
  const fetchCategories = async () => {
    const response = await apiPublishedCategoryList();
    if (apiResCode(response) == SUCCESS_CODE) {
      // Same pattern as fetchAgentList: `pageData["records"] as UTSJSONObject[]`
      // On Android: res["data"] returns UTSArray for JSON array. Casting UTSArray to
      // UTSJSONObject[] works (array→array cast). Casting to UTSJSONObject would fail.
      const dataRaw = apiResData<any>(response);
      // apiResData 返回 any，须显式收窄类型
      const rawArray: UTSJSONObject[] =
        dataRaw != null ? (dataRaw as UTSJSONObject[]) : ([] as UTSJSONObject[]);

      // IMPORTANT: On Android (Kotlin) SquareAgentTypeEnum.Agent is an enum instance, not "Agent" string.
      // Comparing `item["type"]` (String from JSON) with enum fails: String.equals(Enum) always false.
      // Use string literal for cross-platform comparison (H5/iOS: "Agent" == "Agent", Android: "Agent" == "Agent").
      const filterTypeStr: string = "PageApp";

      const categoryData: PublishedCategoryItem[] = [];
      for (let i = 0; i < rawArray.length; i++) {
        const item = rawArray[i];
        //#ifdef MP-WEIXIN
        if (`${item["type"]}` == "PageApp" && item["children"] != null) {
          const children: UTSJSONObject[] = item["children"] as UTSJSONObject[];
          item["children"] = children.filter((child: UTSJSONObject): boolean => {
            return child["key"] !== "Game";
          });
        }
        //#endif
        if (`${item["type"]}` == filterTypeStr) {
          const children: UTSJSONObject[] = item["children"] != null ? (item["children"] as UTSJSONObject[]) : ([] as UTSJSONObject[]);
          for (let j = 0; j < children.length; j++) {
            const child = children[j];
            categoryData.push(new PublishedCategoryItem(`${child["key"]}`, `${child["label"]}`, false));
          }
          break;
        }
      }

      categories.value = [
        new PublishedCategoryItem(CONST_ALL, "Mobile.Common.all", true),
        ...categoryData,
      ];

      // 保持当前选中的 activeCategory 对应 activeSwiperIndex 和 scrollIntoView 同步
      if (categories.value.length > 0) {
        let foundIndex = -1;
        for (let i = 0; i < categories.value.length; i++) {
          if (categories.value[i].key == activeCategory.value) {
            foundIndex = i;
            break;
          }
        }
        if (foundIndex >= 0) {
          activeSwiperIndex.value = foundIndex;
          scrollIntoView.value = activeCategory.value;
        } else {
          activeCategory.value = CONST_ALL;
          activeSwiperIndex.value = 0;
          scrollIntoView.value = CONST_ALL;
        }
      }
    } else if (apiResCode(response) != USER_NO_LOGIN && apiResCode(response) != REDIRECT_LOGIN) {
      uni.showToast({
        title: t("Mobile.AgentList.fetchCategoryFailed"),
        icon: "error",
      });
    }
  };

  /** 获取发布列表项的稳定身份，兼容接口同时存在 id / targetId 的情况。 */
  const getPublishedAgentKey = (item: UTSJSONObject): string => {
    const id = item["id"];
    if (id != null) return `id:${id}`;
    const targetId = item["targetId"];
    return targetId != null ? `target:${targetId}` : "";
  };

  /**
   * 自动刷新只更新业务数据，不更新已有图片 src。
   * 上传图片经对象存储/鉴权代理后，签名 query 可能随请求变化；Android Fresco
   * 会将新 URL 当作新资源并短暂清空旧 Drawable，表现为切换分类 Tab 时闪烁。
   */
  const stabilizePublishedImageUrls = (
    category: string,
    incoming: UTSJSONObject[],
    refreshExistingImages: boolean,
  ): UTSJSONObject[] => {
    if (refreshExistingImages) return incoming;
    const rawExisting = agentListMap.value[category];
    const existing = rawExisting != null ? rawExisting : ([] as UTSJSONObject[]);
    if (existing.length == 0) return incoming;

    for (let i = 0; i < incoming.length; i++) {
      const nextItem = incoming[i];
      const nextKey = getPublishedAgentKey(nextItem);
      if (nextKey.length == 0) continue;

      let oldItem: UTSJSONObject | null = null;
      for (let j = 0; j < existing.length; j++) {
        if (getPublishedAgentKey(existing[j]) == nextKey) {
          oldItem = existing[j];
          break;
        }
      }
      if (oldItem == null) continue;

      const oldIcon = oldItem["icon"];
      if (oldIcon != null && `${oldIcon}`.length > 0) {
        nextItem["icon"] = oldIcon;
      }
      const oldCover = oldItem["coverImg"];
      if (oldCover != null && `${oldCover}`.length > 0) {
        nextItem["coverImg"] = oldCover;
      }

      const oldPublisherRaw = oldItem["publishUser"];
      const nextPublisherRaw = nextItem["publishUser"];
      if (oldPublisherRaw != null && nextPublisherRaw != null) {
        const oldPublisher = oldPublisherRaw as UTSJSONObject;
        const nextPublisher = nextPublisherRaw as UTSJSONObject;
        const oldAvatar = oldPublisher["avatar"];
        if (oldAvatar != null && `${oldAvatar}`.length > 0) {
          nextPublisher["avatar"] = oldAvatar;
        }
      }
    }
    return incoming;
  };

  /**
   * 解析列表 data：应用接口可能直接返回数组，智能体接口返回分页 { records, pages }。
   */
  function parseSquareListRecords(dataRaw: any | null): UTSJSONObject[] {
    const result: UTSJSONObject[] = [];
    if (dataRaw == null) {
      return result;
    }
    const jsonStr = JSON.stringify(dataRaw);
    if (jsonStr == null || jsonStr.length == 0) {
      return result;
    }
    if (jsonStr.charAt(0) == "[") {
      const list = JSON.parse(jsonStr) as UTSJSONObject[] | null;
      if (list != null) {
        for (let i = 0; i < list.length; i++) {
          result.push(list[i]);
        }
      }
      return result;
    }
    const pageData = JSON.parse(jsonStr) as UTSJSONObject | null;
    if (pageData == null) {
      return result;
    }
    const records = pageData["records"];
    if (records != null) {
      const list = records as UTSJSONObject[];
      for (let i = 0; i < list.length; i++) {
        result.push(list[i]);
      }
    }
    return result;
  }

  function readSquareListHasMore(dataRaw: any | null, pageNum: number, fetchedCount: number, pageSize: number): boolean {
    if (dataRaw == null) {
      return false;
    }
    const jsonStr = JSON.stringify(dataRaw);
    if (jsonStr != null && jsonStr.length > 0 && jsonStr.charAt(0) == "[") {
      return fetchedCount >= pageSize;
    }
    const pageData = dataRaw as UTSJSONObject;
    const pagesRaw = pageData["pages"];
    if (pagesRaw != null) {
      const pages = pagesRaw as number;
      return pages > pageNum;
    }
    return fetchedCount >= pageSize;
  }

  /**
   * 请求广场发布列表（应用 / 智能体）。
   */
  async function requestPublishedList(params: SquarePublishedListParams): Promise<RequestResponse<Page<SquarePublishedItemInfo>>> {
    params.targetTypes = ["Agent", "UserApp", "ThirdApp"];
    params.targetSubTypes = ["PageApp", "UserApp", "ThirdApp"];
    params.scope = "Tenant";
    return await apiPublishedAppList(params);
  }

  // 获取智能体列表
  const fetchAgentList = async (
    category: string,
    pageNum: number,
    keyword: string,
    refreshExistingImages: boolean,
  ) => {
    if (pageNum > 1 && loadingMap.value[category] == true) {
      return;
    }
    if (pageNum == 1 && loadingMap.value[category] == true) {
      return;
    }
    const prevGen = fetchGenMap[category];
    const gen = (prevGen != null ? prevGen : 0) + 1;
    fetchGenMap[category] = gen;
    loadingMap.value[category] = true;
    try {
      if (pageNum == 1 && category == CONST_ALL) {
        officialFallbackMap.value[category] = false;
      }
      const params = new SquarePublishedListParams();
      params.page = pageNum;
      params.pageSize = 20;
      params.category = category === CONST_ALL ? "" : category;
      params.kw = keyword;
      params.official = props.isOfficial == true && officialFallbackMap.value[category] != true;
      let response = await requestPublishedList(params);
      if (fetchGenMap[category] != gen) {
        return;
      }
      // 成功
      if (apiResCode(response) == SUCCESS_CODE) {
        let pageDataRaw = apiResData<any>(response);
        let records = parseSquareListRecords(pageDataRaw);
        if (pageNum == 1 && category == CONST_ALL && records.length == 0 && props.isOfficial == true) {
          officialFallbackMap.value[category] = true;
          params.official = false;
          params.page = 1;
          const retryRes = await requestPublishedList(params);
          if (fetchGenMap[category] != gen) {
            return;
          }
          if (apiResCode(retryRes) == SUCCESS_CODE) {
            pageDataRaw = apiResData<any>(retryRes);
            records = parseSquareListRecords(pageDataRaw);
          }
        }
        //#ifdef MP-WEIXIN
        const newList: UTSJSONObject[] = records.filter((item: UTSJSONObject) : boolean => {
          return item["category"] !== "Game";
        });
        //#endif
        //#ifndef MP-WEIXIN
        const newList: UTSJSONObject[] = records;
        //#endif
        if (pageNum > 1) {
          const raw = agentListMap.value[category];
          const existingList: UTSJSONObject[] = raw != null ? raw : ([] as UTSJSONObject[]);
          agentListMap.value[category] = [...existingList, ...newList];
        } else {
          agentListMap.value[category] = stabilizePublishedImageUrls(
            category,
            newList,
            refreshExistingImages,
          );
        }
        hasMoreMap.value[category] = readSquareListHasMore(pageDataRaw, pageNum, newList.length, 10);
        pageMap.value[category] = pageNum;
        bumpListEpoch();
      } else if (apiResCode(response) != USER_NO_LOGIN && apiResCode(response) != REDIRECT_LOGIN) {
        const msg = apiResMessage(response);
        uni.showToast({
          title: msg != null && msg != "" ? msg : t("Mobile.AgentList.fetchAgentFailed"),
          icon: "error",
        });
      }
    } catch (e) {
      console.error("fetchAgentList error", e);
    } finally {
      if (fetchGenMap[category] == gen) {
        loadingMap.value[category] = false;
        if (squareBooting.value == true) {
          squareBooting.value = false;
        }
        bumpListEpoch();
      }
    }
  };

  function prefetchNeighborCategories(index: number): void {
    // Android nested-scroll 下同时挂左右分类整表会拖垮主线程
    // #ifdef APP-ANDROID
    return;
    // #endif
    const neighbors: number[] = [index - 1, index + 1];
    for (let i = 0; i < neighbors.length; i++) {
      const n = neighbors[i];
      if (n < 0 || n >= categories.value.length) {
        continue;
      }
      const key = categories.value[n].key;
      if (hasCategoryData(key) == true) {
        continue;
      }
      if (loadingMap.value[key] == true) {
        continue;
      }
      fetchAgentList(key, 1, searchKeyword.value, false);
    }
  }

  const initData = async () => {
    isLoggedIn.value = await hasToken();
    await fetchCategories();
  };

  /**
   * 切回 Tab：分类已有则不再请求分类接口，只静默刷新当前分类列表。
   * 首次进入仍走 initData（含分类）。page onShow 与 onMounted 可能连打，400ms 内合并。
   */
  let lastRefreshAt = 0;
  const refreshData = () => {
    const now = Date.now();
    if (now - lastRefreshAt < 400) {
      return;
    }
    lastRefreshAt = now;
    if (categories.value.length == 0) {
      initData();
    } else {
      hasToken().then((logged: boolean) => {
        isLoggedIn.value = logged;
      });
    }
    const currentCat = activeCategory.value != "" ? activeCategory.value : CONST_ALL;
    fetchAgentList(currentCat, 1, searchKeyword.value, false);
  };

  // #ifdef MP-WEIXIN
  onShow(() => {
    refreshData();
  });

  onUnload(() => {
    if (searchTimeoutRef.value != 0) {
      clearTimeout(searchTimeoutRef.value);
    }
    // #ifndef APP
    if (h5SwipeTimer != 0) {
      clearTimeout(h5SwipeTimer);
      h5SwipeTimer = 0;
    }
    // #endif
  });
  // #endif

  // #ifndef MP-WEIXIN
  onMounted(() => {
    refreshData();
  });

  onUnmounted(() => {
    if (searchTimeoutRef.value != 0) {
      clearTimeout(searchTimeoutRef.value);
    }
    // #ifndef APP
    if (h5SwipeTimer != 0) {
      clearTimeout(h5SwipeTimer);
      h5SwipeTimer = 0;
    }
    // #endif
  });
  // #endif

  defineExpose({
    refreshData,
    initData,
    fetchAgentList,
  });

  function applyCategory(key: string, index: number): void {
    activeCategory.value = key;
    activeSwiperIndex.value = index;
    scrollIntoView.value = key;
    if (hasCategoryData(key) != true) {
      pageMap.value[key] = 1;
      hasMoreMap.value[key] = true;
      fetchAgentList(key, 1, searchKeyword.value, false);
    }
    // 仅 App 预取左右页。H5 改高度会连跳 change，预取会把后面几个分类一起打出来。
    // #ifdef APP
    prefetchNeighborCategories(index);
    // #endif
  }

  const handleCategoryClick = (key: string, index: number) => {
    if (activeCategory.value == key && activeSwiperIndex.value == index) {
      return;
    }
    applyCategory(key, index);
  };

  // #ifndef APP
  function commitH5SwiperIndex(index: number): void {
    h5SwipeTimer = 0;
    if (index < 0 || index >= categories.value.length) {
      h5IgnoreChange = false;
      return;
    }
    const key = categories.value[index].key;
    activeCategory.value = key;
    activeSwiperIndex.value = index;
    scrollIntoView.value = key;
    if (hasCategoryData(key) != true && loadingMap.value[key] != true) {
      pageMap.value[key] = 1;
      hasMoreMap.value[key] = true;
      fetchAgentList(key, 1, searchKeyword.value, false);
    } else {
      scheduleMeasureH5Pane();
    }
    setTimeout(() => {
      h5IgnoreChange = false;
    }, 520);
  }
  // #endif

  const handleSwiperChange = (e: UniSwiperChangeEvent) => {
    const index = e.detail.current;
    const category = categories.value[index];
    if (category == null) {
      return;
    }
    // #ifndef APP
    if (h5IgnoreChange == true) {
      return;
    }
    if (category.key == activeCategory.value && activeSwiperIndex.value == index) {
      return;
    }
    activeCategory.value = category.key;
    activeSwiperIndex.value = index;
    scrollIntoView.value = category.key;
    h5PendingIndex = index;
    h5IgnoreChange = true;
    if (h5SwipeTimer != 0) {
      clearTimeout(h5SwipeTimer);
    }
    h5SwipeTimer = setTimeout(() => {
      commitH5SwiperIndex(h5PendingIndex);
    }, 160);
    // #endif
    // #ifdef APP
    if (category.key == activeCategory.value && activeSwiperIndex.value == index) {
      return;
    }
    applyCategory(category.key, index);
    // #endif
  };

  function jumpPublishedAgent(info: UTSJSONObject): void {
    const payload = {} as UTSJSONObject;
    payload["targetId"] = info["targetId"];
    payload["name"] = info["name"];
    payload["agentType"] = info["agentType"];
    payload["targetType"] = info["targetType"];
    payload["targetSubType"] = info["targetSubType"];
    payload["icon"] = info["icon"];
    payload["description"] = info["description"];
    baseHandleAgentClick(payload);
  }

  const handleAgentClick = (info: UTSJSONObject) => {
    if (!isLoggedIn.value) {
      handleLogin();
      return;
    }
    dispatchPublishedAppClick(info, jumpPublishedAgent);
  };

  const getNestedObj = (info: UTSJSONObject, key: string): UTSJSONObject | null => {
    const raw = info[key];
    if (raw == null) {
      return null;
    }
    return raw as UTSJSONObject;
  };

  // 处理收藏与取消收藏
  const handleToggleCollect = async (
    info: UTSJSONObject,
    category: string,
  ) => {
    const targetId = info["targetId"] as number;
    const collect = info["collect"] == true;
    // 获取当前分类列表
    const rawList = agentListMap.value[category];
    const existingList: UTSJSONObject[] = rawList != null ? rawList : [];
    // 更新列表收藏状态，并更新统计信息
    const updatedList = existingList.map((item: UTSJSONObject): UTSJSONObject => {
      if (item["targetId"] === targetId) {
        const statistics = getNestedObj(item, "statistics");
        const collectCount = statistics != null && statistics["collectCount"] != null ? (statistics["collectCount"] as number) : 0;
        const newCollectCount = collect ? collectCount - 1 : collectCount + 1;
        item["collect"] = collect != true;
        if (statistics != null) {
          statistics["collectCount"] = newCollectCount;
        }
      }
      return item;
    });
    agentListMap.value[category] = updatedList;
    // 网页应用与专家列表一样走智能体收藏；全栈应用、三方应用仍走项目收藏
    if (isPublishedPageApp(info) == true) {
      if (collect == true) {
        const unCollectRes = await apiUnCollectAgent(targetId);
        if (apiResCode(unCollectRes) != SUCCESS_CODE) {
          agentListMap.value[category] = existingList;
          uni.showToast({
            title: t("Mobile.AgentList.unCollectFailed"),
            icon: "none",
          });
        }
      } else {
        const collectRes = await apiCollectAgent(targetId);
        if (apiResCode(collectRes) != SUCCESS_CODE) {
          agentListMap.value[category] = existingList;
          uni.showToast({
            title: t("Mobile.AgentList.collectFailed"),
            icon: "none",
          });
        }
      }
      return;
    }
    const projectId = readPublishedAppProjectId(info);
    const projectType = readPublishedAppProjectType(info);
    if (projectId <= 0 || projectType.length == 0) {
      agentListMap.value[category] = existingList;
      uni.showToast({
        title: t("Mobile.Common.operationFailed"),
        icon: "none",
      });
      return;
    }
    // 全栈应用、三方应用走项目收藏
    if (collect == true) {
      const unCollectRes = await apiUserProjectUnCollect(projectId, projectType);
      if (apiResCode(unCollectRes) != SUCCESS_CODE) {
        agentListMap.value[category] = existingList;
        uni.showToast({
          title: t("Mobile.AgentList.unCollectFailed"),
          icon: "none",
        });
      }
    } else {
      const collectRes = await apiUserProjectCollect(projectId, projectType);
      if (apiResCode(collectRes) != SUCCESS_CODE) {
        agentListMap.value[category] = existingList;
        uni.showToast({
          title: t("Mobile.AgentList.collectFailed"),
          icon: "none",
        });
      }
    }
  };

  function handlePaneCollect(info: UTSJSONObject): void {
    handleToggleCollect(info, activeCategory.value);
  }

  // 下拉刷新
  const handleRefresh = () => {
    const currentCategory = activeCategory.value;
    if (refreshingMap.value[currentCategory] == true) {
      return;
    }
    refreshingMap.value[currentCategory] = true;
    bumpListEpoch();
    pageMap.value[currentCategory] = 1;
    hasMoreMap.value[currentCategory] = true;
    fetchAgentList(currentCategory, 1, searchKeyword.value, true).finally(() => {
      // 添加延迟，让loading效果更明显
      setTimeout(() => {
        refreshingMap.value[currentCategory] = false;
        bumpListEpoch();
      }, 500);
    });
  };

  // 加载更多
  const handleLoadMore = () => {
    const currentPage : number = pageMap.value[activeCategory.value] != null ? pageMap.value[activeCategory.value] as number : 1;
    const currentHasMore = hasMoreMap.value[activeCategory.value] != false;
    const currentLoading = loadingMap.value[activeCategory.value];

    if (currentHasMore && currentLoading != true) {
      fetchAgentList(activeCategory.value, currentPage + 1, searchKeyword.value, false);
    }
  };
</script>

<style lang="scss" scoped>
  .app-square {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: #fff;
    height: 100%;
    min-height: 0;
    /* #ifdef H5 */
    width: 100%;
    max-height: 100%;
    overscroll-behavior: none;
    /* #endif */
    /* #ifdef MP-WEIXIN || APP */
    padding-bottom: env(safe-area-inset-bottom);
    /* #endif */
  }

  .app-square__list {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .app-square__boot {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 20;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .app-square__boot-spinner {
    width: 32rpx;
    height: 32rpx;
    border: 4rpx solid #e8e8e8;
    border-top: 4rpx solid #8b5cf6;
    border-radius: 50%;
    margin-right: 16rpx;
    animation: square-boot-spin 1s linear infinite;
  }

  .app-square__boot .loading-text {
    font-size: 28rpx;
    color: #666666;
  }

  @keyframes square-boot-spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .app-square__body {
    flex: 1;
    width: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: #ffffff;
  }

  .app-square__swiper {
    width: 100%;
    /* #ifdef APP */
    flex: 1;
    min-height: 0;
    /* #endif */
    /* #ifndef APP */
    flex: none;
    flex-shrink: 0;
    /* #endif */
  }

  .app-square__pane-scroll {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  /* #ifndef APP */
  .app-square__swiper-item {
    height: auto;
  }

  .h5-pane-measure {
    width: 100%;
    height: auto;
  }
  /* #endif */

  .category-nav {
    width: 100%;
    flex-shrink: 0;
    padding: 16rpx 32rpx;
    background-color: #ffffff;
  }

  .category-scroll {
    width: 100%;
    height: 80rpx;
    flex-direction: row;
  }

  .category-scroll-content {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    /* #ifdef H5 */
    width: max-content;
    /* #endif */
  }

  .category-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 80rpx;
    padding: 0 32rpx;
    border-radius: 16rpx;
    color: #5e6470;
    font-size: 32rpx;
    font-weight: 400;

    &.active {
      background-color: #f2f2ff;
    }
  }

  .category-text {
    font-size: 32rpx;
    font-weight: 400;
    color: #5e6470;
    white-space: nowrap;
  }

  .category-text-active {
    color: #5147ff;
  }
</style>

