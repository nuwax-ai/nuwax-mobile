<template>
  <view class="im-page">
    <safety-zone />

    <!-- 顶部：消息 / 智联录 tab + 搜索、添加占位入口 -->
    <view class="im-header">
      <view class="im-tab-row">
        <view class="im-tab" @click="switchTab('chat')">
          <text
            class="im-tab__text"
            :class="{ 'im-tab__text--on': activeTab == 'chat' }"
          >{{ t("Mobile.Nav.message") }}</text>
          <view class="im-tab__bar" :class="{ 'im-tab__bar--on': activeTab == 'chat' }" />
        </view>
        <view class="im-tab" @click="switchTab('contact')">
          <text
            class="im-tab__text"
            :class="{ 'im-tab__text--on': activeTab == 'contact' }"
          >{{ t("Mobile.Nav.unionRecord") }}</text>
          <view class="im-tab__bar" :class="{ 'im-tab__bar--on': activeTab == 'contact' }" />
        </view>
        <view class="im-tab-spacer" />
        <view class="im-action" @click="handlePlaceholderTap">
          <svg-icon name="icon-Search" size="44" color="#1c1b20" />
        </view>
        <view class="im-action im-action--plus" @click="openAddDrawer">
          <svg-icon name="icon-Plus" size="44" color="#1c1b20" />
        </view>
      </view>
      <view class="im-header-line" />
    </view>

    <!-- 消息 tab：会话列表 -->
    <scroll-view
      v-if="activeTab == 'chat'"
      class="im-body"
      direction="vertical"
      :show-scrollbar="false"
      @scrolltolower="handleConvScrollLower"
    >
      <view v-if="convLoading && conversations.length == 0" class="im-state">
        <text class="im-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view
        v-else-if="conversations.length == 0"
        class="im-state"
        @click="handleConvRetry"
      >
        <text class="im-state__text">{{
          convFailed ? t("Mobile.Message.loadFailed") : t("Mobile.Message.emptyMessages")
        }}</text>
      </view>
      <template v-else>
        <view v-for="(conv, index) in conversations" :key="conv.convId">
          <!-- 左滑操作（微信同款：内容行不动，按钮层从右滑入盖住时间/名称右侧） -->
          <view
            class="chat-swipe"
            @touchstart="onSwipeTouchStart($event, conv.convId, conv)"
            @touchmove="onSwipeTouchMove($event, conv.convId, conv, 420)"
            @touchend="onSwipeTouchEnd($event, conv.convId, conv, 420)"
          >
            <view
              class="chat-item"
              hover-class="chat-item--active"
              @click="handleConvClick(conv)"
            >
              <view class="chat-item__avatar-wrap">
                <image
                  v-if="conv.avatarUrl.length > 0 && conv.avatarFailed != true"
                  class="chat-item__avatar"
                  :src="conv.avatarUrl"
                  mode="aspectFill"
                  @error="handleConvAvatarError(conv)"
                />
                <view
                  v-else
                  class="chat-item__avatar"
                  :style="{ backgroundImage: avatarGradient(conv.displayName) }"
                >
                  <text class="chat-item__avatar-letter">{{ avatarLetter(conv.displayName) }}</text>
                </view>
                <view v-if="conv.unreadCount > 0" class="chat-item__badge">
                  <text class="chat-item__badge-text">{{ formatUnread(conv.unreadCount) }}</text>
                </view>
              </view>
              <view class="chat-item__body">
                <view class="chat-item__title-row">
                  <image
                    v-if="conv.topFlag"
                    class="chat-item__mark"
                    :src="iconPin"
                    mode="aspectFit"
                  />
                  <image
                    v-if="conv.dnd"
                    class="chat-item__mark"
                    :src="iconMute"
                    mode="aspectFit"
                  />
                  <text class="chat-item__title text-ellipsis">{{ displayConvName(conv) }}</text>
                  <text class="chat-item__time">{{ formatConvTime(conv.lastMsgAt) }}</text>
                </view>
                <text class="chat-item__sub text-ellipsis">{{ displayConvDigest(conv) }}</text>
              </view>
            </view>
            <view class="chat-swipe__acts" :style="actsSwipeStyle(conv, 420)">
              <view class="chat-swipe__act chat-swipe__act--blue" @click="handleConvPin(conv)">
                <text class="chat-swipe__act-text">{{
                  conv.topFlag ? t("Mobile.Conversation.unpin") : t("Mobile.Conversation.pin")
                }}</text>
              </view>
              <view class="chat-swipe__act chat-swipe__act--amber" @click="handleConvDnd(conv)">
                <text class="chat-swipe__act-text">{{
                  conv.dnd ? t("Mobile.Message.unmute") : t("Mobile.Message.mute")
                }}</text>
              </view>
              <view
                class="chat-swipe__act chat-swipe__act--danger"
                @click="handleConvRemove(conv)"
              >
                <text class="chat-swipe__act-text">{{
                  t("Mobile.Common.delete")
                }}</text>
              </view>
            </view>
          </view>
          <view v-if="index < conversations.length - 1" class="chat-divider" />
        </view>
        <view v-if="convLoadingMore" class="im-foot">
          <text class="im-foot__text">{{ t("Mobile.Page.loadingMore") }}</text>
        </view>
        <view v-else-if="convHasMore != true" class="im-foot">
          <text class="im-foot__text">{{ t("Mobile.Message.noMore") }}</text>
        </view>
      </template>
    </scroll-view>

    <!-- 智联录 tab：通讯录列表 -->
    <scroll-view v-else class="im-body" direction="vertical" :show-scrollbar="false">
      <view v-if="contactLoading && contactTotal == 0" class="im-state">
        <text class="im-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view
        v-else-if="contactTotal == 0"
        class="im-state"
        @click="handleContactRetry"
      >
        <text class="im-state__text">{{
          contactFailed ? t("Mobile.Message.loadFailed") : t("Mobile.Message.emptyContact")
        }}</text>
      </view>
      <template v-else>
        <!-- 新的伙伴申请：对方申请了我，等我同意 -->
        <view v-if="pendingInContacts.length > 0" class="contact-group">
          <text class="contact-group__title">{{ t("Mobile.Message.newRequests") }}</text>
          <view v-for="(contact, index) in pendingInContacts" :key="`in-${contact.userId}`">
            <view class="chat-item" hover-class="chat-item--active" @click="handlePendingInTap(contact)">
              <view class="chat-item__avatar-wrap">
                <image
                  v-if="contact.avatarUrl.length > 0 && contact.avatarFailed != true"
                  class="chat-item__avatar"
                  :src="contact.avatarUrl"
                  mode="aspectFill"
                  @error="handleContactAvatarError(contact)"
                />
                <view
                  v-else
                  class="chat-item__avatar"
                  :style="{ backgroundImage: avatarGradient(contact.displayName) }"
                >
                  <text class="chat-item__avatar-letter">{{ avatarLetter(contact.displayName) }}</text>
                </view>
              </view>
              <view class="chat-item__body">
                <view class="chat-item__title-row">
                  <text class="chat-item__title text-ellipsis">{{ contact.displayName }}</text>
                  <view class="contact-tag contact-tag--warn">
                    <text class="contact-tag__text contact-tag__text--warn">{{ t("Mobile.Message.statusWaitConfirm") }}</text>
                  </view>
                </view>
              </view>
            </view>
            <view
              v-if="index < pendingInContacts.length - 1"
              class="chat-divider"
            />
          </view>
        </view>

        <!-- 已申请：我申请了对方，等对方同意 -->
        <view v-if="pendingOutContacts.length > 0" class="contact-group">
          <text class="contact-group__title">{{ t("Mobile.Message.sentRequests") }}</text>
          <view v-for="(contact, index) in pendingOutContacts" :key="`out-${contact.userId}`">
            <!-- 左滑操作：撤回申请（无确认，直接调接口） -->
            <view
              class="chat-swipe"
              @touchstart="onSwipeTouchStart($event, `ct-${contact.userId}`, contact)"
              @touchmove="onSwipeTouchMove($event, `ct-${contact.userId}`, contact, 220)"
              @touchend="onSwipeTouchEnd($event, `ct-${contact.userId}`, contact, 220)"
            >
              <view class="chat-item" hover-class="chat-item--active" @click="handlePendingOutTap(contact)">
                <view class="chat-item__avatar-wrap">
                  <image
                    v-if="contact.avatarUrl.length > 0 && contact.avatarFailed != true"
                    class="chat-item__avatar"
                    :src="contact.avatarUrl"
                    mode="aspectFill"
                    @error="handleContactAvatarError(contact)"
                  />
                  <view
                    v-else
                    class="chat-item__avatar"
                    :style="{ backgroundImage: avatarGradient(contact.displayName) }"
                  >
                    <text class="chat-item__avatar-letter">{{ avatarLetter(contact.displayName) }}</text>
                  </view>
                </view>
                <view class="chat-item__body">
                  <view class="chat-item__title-row">
                    <text class="chat-item__title text-ellipsis">{{ contact.displayName }}</text>
                    <view class="contact-tag contact-tag--muted">
                      <text class="contact-tag__text contact-tag__text--muted">{{ t("Mobile.Message.statusWaitAccept") }}</text>
                    </view>
                  </view>
                </view>
              </view>
              <view class="chat-swipe__acts" :style="actsSwipeStyle(contact, 220)">
                <view
                  class="chat-swipe__act chat-swipe__act--wide chat-swipe__act--danger"
                  @click="handleContactWithdraw(contact)"
                >
                  <text class="chat-swipe__act-text">{{ t("Mobile.Message.withdrawRequest") }}</text>
                </view>
              </view>
            </view>
            <view
              v-if="index < pendingOutContacts.length - 1"
              class="chat-divider"
            />
          </view>
        </view>

        <!-- 我的群组：折叠分类（含已从会话列表删除但仍在群内的群），点行进群聊；置于联系人上方 -->
        <view v-if="groupsLoaded && groupTotal > 0" class="contact-group">
          <view class="group-header" hover-class="group-header--active" @click="toggleGroups">
            <image class="group-header__icon" :src="iconGroupSet" mode="aspectFit" />
            <text class="group-header__title">{{ t("Mobile.Message.myGroups") }}</text>
            <text class="group-header__count">{{ groupTotal }}</text>
            <view class="group-header__spacer" />
            <svg-icon
              :name="groupsExpanded ? 'icon-a-Chevrondown' : 'icon-a-Chevronright'"
              size="28"
              color="#c0bec8"
            />
          </view>
          <view v-if="groupsExpanded">
            <view v-for="(group, index) in myGroups" :key="`grp-${group.convId}`">
              <!-- 左滑操作：打开会话 / 解散群聊（群主）/ 退出群聊（非群主） -->
              <view
                class="chat-swipe"
                @touchstart="onSwipeTouchStart($event, `grp-${group.convId}`, group)"
                @touchmove="onSwipeTouchMove($event, `grp-${group.convId}`, group, 280)"
                @touchend="onSwipeTouchEnd($event, `grp-${group.convId}`, group, 280)"
              >
                <view class="chat-item" hover-class="chat-item--active" @click="handleConvClick(group)">
                  <view class="chat-item__avatar-wrap">
                    <image
                      v-if="group.avatarUrl.length > 0 && group.avatarFailed != true"
                      class="chat-item__avatar"
                      :src="group.avatarUrl"
                      mode="aspectFill"
                      @error="handleConvAvatarError(group)"
                    />
                    <view
                      v-else
                      class="chat-item__avatar"
                      :style="{ backgroundImage: avatarGradient(group.displayName) }"
                    >
                      <text class="chat-item__avatar-letter">{{ avatarLetter(group.displayName) }}</text>
                    </view>
                  </view>
                  <view class="chat-item__body">
                    <view class="chat-item__title-row">
                      <text class="chat-item__title text-ellipsis">{{ displayConvName(group) }}</text>
                      <view v-if="group.myRole == 3" class="contact-tag contact-tag--owner">
                        <text class="contact-tag__text contact-tag__text--owner">{{ t("Mobile.Message.groupOwner") }}</text>
                      </view>
                      <text class="chat-item__time">{{ formatConvTime(group.lastMsgAt) }}</text>
                    </view>
                    <text class="group-row__count">{{ groupMemberLabel(group) }}</text>
                  </view>
                </view>
                <view class="chat-swipe__acts" :style="actsSwipeStyle(group, 280)">
                  <view class="chat-swipe__act chat-swipe__act--blue" @click="handleGroupOpen(group)">
                    <text class="chat-swipe__act-text">{{ t("Mobile.Message.groupOpenChat") }}</text>
                  </view>
                  <view
                    v-if="group.myRole == 3"
                    class="chat-swipe__act chat-swipe__act--danger"
                    @click="handleGroupDissolve(group)"
                  >
                    <text class="chat-swipe__act-text">{{ t("Mobile.Message.dissolveGroupConfirm") }}</text>
                  </view>
                  <view
                    v-else
                    class="chat-swipe__act chat-swipe__act--danger"
                    @click="handleGroupLeave(group)"
                  >
                    <text class="chat-swipe__act-text">{{ t("Mobile.Message.leaveGroupConfirm") }}</text>
                  </view>
                </view>
              </view>
              <view
                v-if="index < myGroups.length - 1"
                class="chat-divider"
              />
            </view>
          </view>
        </view>

        <!-- 正常联系人：专家（智能体）/ 用户 -->
        <view v-if="acceptedContacts.length > 0" class="contact-group">
          <text class="contact-group__title">{{ t("Mobile.Message.contactsTitle") }}</text>
          <view v-for="(contact, index) in acceptedContacts" :key="`ok-${contact.userId}`">
            <!-- 左滑操作：发消息 / 修改备注 / 删除联系人 -->
            <view
              class="chat-swipe"
              @touchstart="onSwipeTouchStart($event, `ct-${contact.userId}`, contact)"
              @touchmove="onSwipeTouchMove($event, `ct-${contact.userId}`, contact, 420)"
              @touchend="onSwipeTouchEnd($event, `ct-${contact.userId}`, contact, 420)"
            >
              <view class="chat-item" hover-class="chat-item--active" @click="openContactChat(contact)">
                <view class="chat-item__avatar-wrap">
                  <image
                    v-if="contact.avatarUrl.length > 0 && contact.avatarFailed != true"
                    class="chat-item__avatar"
                    :src="contact.avatarUrl"
                    mode="aspectFill"
                    @error="handleContactAvatarError(contact)"
                  />
                  <view
                    v-else
                    class="chat-item__avatar"
                    :style="{ backgroundImage: avatarGradient(contact.displayName) }"
                  >
                    <text class="chat-item__avatar-letter">{{ avatarLetter(contact.displayName) }}</text>
                  </view>
                </view>
                <view class="chat-item__body">
                  <view class="chat-item__title-row">
                    <text class="chat-item__title text-ellipsis">{{ contact.displayName }}</text>
                    <view
                      class="contact-tag"
                      :class="isExpertContact(contact) ? 'contact-tag--expert' : 'contact-tag--user'"
                    >
                      <text
                        class="contact-tag__text"
                        :class="isExpertContact(contact) ? 'contact-tag__text--expert' : 'contact-tag__text--user'"
                      >{{
                        isExpertContact(contact)
                          ? t("Mobile.Message.contactExpert")
                          : t("Mobile.Message.contactUser")
                      }}</text>
                    </view>
                  </view>
                </view>
              </view>
              <view class="chat-swipe__acts" :style="actsSwipeStyle(contact, 420)">
                <view
                  class="chat-swipe__act chat-swipe__act--blue"
                  @click="handleContactMessage(contact)"
                >
                  <text class="chat-swipe__act-text">{{ t("Mobile.Message.sendMessage") }}</text>
                </view>
                <view
                  class="chat-swipe__act chat-swipe__act--amber"
                  @click="handleContactRemark(contact)"
                >
                  <text class="chat-swipe__act-text">{{ t("Mobile.Message.editRemark") }}</text>
                </view>
                <view
                  class="chat-swipe__act chat-swipe__act--danger"
                  @click="handleContactRemove(contact)"
                >
                  <text class="chat-swipe__act-text">{{ t("Mobile.Message.removeContactTitle") }}</text>
                </view>
              </view>
            </view>
            <view
              v-if="index < acceptedContacts.length - 1"
              class="chat-divider"
            />
          </view>
        </view>

        <!-- 降级 / 截断提示（语义不同：缺人 vs 截断，都要读） -->
        <view v-if="contactDegraded || contactTruncated" class="im-foot">
          <text class="im-foot__text">{{
            contactDegraded
              ? t("Mobile.Message.contactDegraded")
              : t("Mobile.Message.contactTruncated")
          }}</text>
        </view>
      </template>
    </scroll-view>

    <!-- 右上角「+」锚定气泡：创建群组 / 加入群组 / 添加伙伴 -->
    <add-menu-drawer
      ref="addDrawerRef"
      @createGroup="handleCreateGroupTap"
      @joinGroup="handleJoinGroupTap"
      @addBuddy="handleAddBuddyTap"
      @closed="handleAddDrawerClosed"
    />
    <!-- 创建群组底部弹窗（表单内容待设计稿） -->
    <create-group-sheet ref="createGroupSheetRef" />
    <!-- 加入群组底部弹窗（按群号） -->
    <join-group-sheet ref="joinGroupSheetRef" @joined="handleJoinedGroup" />
    <!-- 添加伙伴底部弹窗（人 / 智能体 双 tab） -->
    <add-buddy-sheet ref="addBuddySheetRef" />
    <!-- 修改备注底部弹窗（留空保存 = 清除备注） -->
    <remark-sheet ref="remarkSheetRef" @saved="handleRemarkSaved" />
  </view>
</template>

<script setup lang="uts">
  import { computed, getCurrentInstance, ref, type ComponentPublicInstance } from "vue";
  import { onLoad, onShow } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import AddMenuDrawer from "./components/add-menu-drawer.uvue";
  import CreateGroupSheet from "./components/create-group-sheet.uvue";
  import JoinGroupSheet from "./components/join-group-sheet.uvue";
  import AddBuddySheet from "./components/add-buddy-sheet.uvue";
  import RemarkSheet from "./components/remark-sheet.uvue";
  import {
    apiImContactAccept,
    apiImContactReject,
    apiImContactRemove,
    apiImContacts,
    apiImConversations,
    apiImConvRemove,
    apiImConvSetDnd,
    apiImConvSetTop,
    apiImCreateP2pConversation,
    apiImGroupDisband,
    apiImGroupLeave,
    apiImMyGroups,
  } from "@/servers/im";
  import type { RequestResponse } from "@/types/interfaces/request";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { refreshImUnreadBadge } from "@/utils/imUnreadBadge";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import iconGroupSet from "@/static/icons/group_set.svg";
  import iconPin from "@/static/icons/pin.svg";
  import iconMute from "@/static/icons/mute.svg";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 会话列表页大小（服务端 clamp 到 [1,100]）。 */
  const CONV_PAGE_SIZE = 50;

  /** 头像字母底色渐变板（对齐参考设计六色系：紫/绿/黄/红/蓝/橙）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #f59a9a, #e05f5f)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  /** 可左滑行的手势状态（会话行 / 联系人行共用）：内容行不动，按钮层从右缘滑入。 */
  class SwipeRowState {
    // 按钮层横向偏移（px，闭合=0）
    swipeX: number = 0;
    // 松手吸附动画开关（200ms 过渡）
    swipeAnim: boolean = false;
  }

  /** 会话行（仅保留列表展示所需字段；convId 雪花号存字符串防 JS 精度丢失）。 */
  class ImConvRow extends SwipeRowState {
    convId: string = "";
    convType: number = 1;
    displayName: string = "";
    avatarUrl: string = "";
    unreadCount: number = 0;
    lastMsgAt: number = 0;
    lastMsgDigest: string = "";
    memberCount: number = 0;
    // 我在本群的角色：1=成员 2=管理员 3=群主（ImMemberRole，智联录群组行展示群主徽章）
    myRole: number = 1;
    // 置顶 / 消息免打扰（我的会话设置，PUT members/me）；名称前分别显示 pin / 免打扰图标
    topFlag: boolean = false;
    dnd: boolean = false;
    avatarFailed: boolean = false;
  }

  /** 联系人行（status：1=已互为联系人 2=对方申请待我确认 3=我已申请待对方同意）。 */
  class ImContactRow extends SwipeRowState {
    userId: string = "";
    subjectType: number = 1;
    displayName: string = "";
    avatarUrl: string = "";
    status: number = 1;
    // 我给他设的备注（修改备注弹窗预填；displayName 服务端已按 remark > nick > name 算好）
    remark: string = "";
    avatarFailed: boolean = false;
  }

  const activeTab = ref<string>("chat");

  // ===== 会话列表状态 =====
  const conversations = ref<ImConvRow[]>([]);
  const convLoading = ref<boolean>(false);
  const convLoaded = ref<boolean>(false);
  const convFailed = ref<boolean>(false);
  const convHasMore = ref<boolean>(false);
  const convLoadingMore = ref<boolean>(false);
  const nextCursor = ref<string>("");

  // ===== 通讯录状态 =====
  const acceptedContacts = ref<ImContactRow[]>([]);
  const pendingInContacts = ref<ImContactRow[]>([]);
  const pendingOutContacts = ref<ImContactRow[]>([]);
  const contactLoading = ref<boolean>(false);
  const contactLoaded = ref<boolean>(false);
  const contactFailed = ref<boolean>(false);
  const contactDegraded = ref<boolean>(false);
  const contactTruncated = ref<boolean>(false);

  const contactTotal = computed<number>(
    (): number =>
      acceptedContacts.value.length +
      pendingInContacts.value.length +
      pendingOutContacts.value.length,
  );

  // ===== 我的群组状态（智联录内折叠分类，与通讯录同生命周期）=====
  const myGroups = ref<ImConvRow[]>([]);
  const groupTotal = ref<number>(0);
  const groupsExpanded = ref<boolean>(false);
  const groupsLoading = ref<boolean>(false);
  const groupsLoaded = ref<boolean>(false);

  // ===== 右上角「+」锚定气泡 / 创建群组・添加伙伴弹窗 =====
  const pageInstance = getCurrentInstance();
  const addDrawerRef = ref<any | null>(null);
  const createGroupSheetRef = ref<any | null>(null);
  const joinGroupSheetRef = ref<any | null>(null);
  const addBuddySheetRef = ref<any | null>(null);
  const remarkSheetRef = ref<any | null>(null);
  /** 气泡关闭后待打开的弹窗：串行接续，避免两层弹层叠在一起 */
  let pendingSheetAfterDrawer = "";

  function hasAccessToken(): boolean {
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    return tokenRaw != null && `${tokenRaw}`.length > 0;
  }

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  function readConvRow(obj: UTSJSONObject): ImConvRow {
    const row = new ImConvRow();
    row.convId = readString(obj, "convId");
    row.convType = readNumber(obj, "convType", 1);
    const name = readString(obj, "name");
    const peerName = readString(obj, "peerName");
    const avatar = readString(obj, "avatar");
    const peerAvatar = readString(obj, "peerAvatar");
    // 单聊 name 恒为 null（服务端约定），展示名用 peerName；群聊用 name。
    if (row.convType == 1) {
      row.displayName = peerName.length > 0 ? peerName : name;
      row.avatarUrl = peerAvatar.length > 0 ? peerAvatar : avatar;
    } else {
      row.displayName = name.length > 0 ? name : peerName;
      row.avatarUrl = avatar;
    }
    // unreadCount：服务端没算时键整个不存在（非 0），整表刷新下只能按 0 展示。
    row.unreadCount = readNumber(obj, "unreadCount", 0);
    row.lastMsgAt = readNumber(obj, "lastMsgAt", 0);
    // memberCount：群聊行在智联录「我的群组」里展示
    row.memberCount = readNumber(obj, "memberCount", 0);
    // myRole：1=成员 2=管理员 3=群主；仅群聊行有意义（群主徽章）
    row.myRole = readNumber(obj, "myRole", 1);
    row.lastMsgDigest = readString(obj, "lastMsgDigest");
    row.topFlag = readBool(obj, "topFlag");
    row.dnd = readBool(obj, "dnd");
    return row;
  }

  function readContactRow(obj: UTSJSONObject): ImContactRow {
    const row = new ImContactRow();
    row.userId = readString(obj, "userId");
    row.subjectType = readNumber(obj, "subjectType", 1);
    row.status = readNumber(obj, "status", 1);
    // displayName 服务端已按 remark > nickName > userName 算好，仅在缺键时逐级回落。
    const display = readString(obj, "displayName");
    const nickName = readString(obj, "nickName");
    row.displayName = display.length > 0 ? display : nickName;
    row.avatarUrl = readString(obj, "avatar");
    row.remark = readString(obj, "remark");
    return row;
  }

  function parseConvRecords(res: RequestResponse<any>): ImConvRow[] {
    const rows: ImConvRow[] = [];
    const dataRaw = apiResData<any>(res);
    const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
    if (dataObj == null) {
      return rows;
    }
    const recordsRaw = dataObj["records"];
    if (recordsRaw != null) {
      const records = recordsRaw as UTSJSONObject[];
      for (let i = 0; i < records.length; i++) {
        rows.push(readConvRow(records[i]));
      }
    }
    const cursorRaw = dataObj["nextCursor"];
    nextCursor.value = cursorRaw != null ? `${cursorRaw}` : "";
    // 置顶稳定分区：置顶行整体提前、组内保持服务端顺序（可多条置顶，最先置顶的在最上面）
    const pinned: ImConvRow[] = [];
    const normal: ImConvRow[] = [];
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].topFlag) {
        pinned.push(rows[i]);
      } else {
        normal.push(rows[i]);
      }
    }
    const merged: ImConvRow[] = [];
    for (let i = 0; i < pinned.length; i++) {
      merged.push(pinned[i]);
    }
    for (let i = 0; i < normal.length; i++) {
      merged.push(normal[i]);
    }
    return merged;
  }

  /**
   * 群组分页解析：★cursor 语义与 /conversations 不同（可见集不同，不能混用），
   * 故不复用 parseConvRecords。服务端 total 实测返回 -1（未统计），分组头计数回落到本页条数。
   */
  function parseGroupRecords(res: RequestResponse<any>): ImConvRow[] {
    const rows: ImConvRow[] = [];
    const dataRaw = apiResData<any>(res);
    const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
    if (dataObj == null) {
      return rows;
    }
    const recordsRaw = dataObj["records"];
    if (recordsRaw != null) {
      const records = recordsRaw as UTSJSONObject[];
      for (let i = 0; i < records.length; i++) {
        rows.push(readConvRow(records[i]));
      }
    }
    const totalRaw = readNumber(dataObj, "total", 0);
    // 实测 dev 环境返回 total:-1（未统计），此时以本页条数计数（单页 limit=100 足够覆盖）。
    groupTotal.value = totalRaw > 0 ? totalRaw : rows.length;
    return rows;
  }

  async function loadConversations(): Promise<void> {
    if (convLoading.value) {
      return;
    }
    if (!hasAccessToken()) {
      convLoaded.value = true;
      return;
    }
    convLoading.value = true;
    convFailed.value = false;
    try {
      const res = await apiImConversations("", CONV_PAGE_SIZE);
      convLoading.value = false;
      if (apiResCode(res) != SUCCESS_CODE) {
        convFailed.value = true;
        return;
      }
      conversations.value = parseConvRecords(res);
      convHasMore.value = nextCursor.value.length > 0;
      convLoaded.value = true;
    } catch (_error) {
      convLoading.value = false;
      convFailed.value = true;
    }
  }

  async function loadMoreConversations(): Promise<void> {
    if (convHasMore.value != true || convLoadingMore.value) {
      return;
    }
    if (nextCursor.value.length == 0) {
      return;
    }
    convLoadingMore.value = true;
    try {
      const res = await apiImConversations(nextCursor.value, CONV_PAGE_SIZE);
      convLoadingMore.value = false;
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const rows = parseConvRecords(res);
      for (let i = 0; i < rows.length; i++) {
        conversations.value.push(rows[i]);
      }
      convHasMore.value = nextCursor.value.length > 0;
    } catch (_error) {
      convLoadingMore.value = false;
    }
  }

  async function loadContacts(): Promise<void> {
    if (contactLoading.value) {
      return;
    }
    if (!hasAccessToken()) {
      contactLoaded.value = true;
      return;
    }
    contactLoading.value = true;
    contactFailed.value = false;
    try {
      const res = await apiImContacts();
      contactLoading.value = false;
      if (apiResCode(res) != SUCCESS_CODE) {
        contactFailed.value = true;
        return;
      }
      const accepted: ImContactRow[] = [];
      const pendingIn: ImContactRow[] = [];
      const pendingOut: ImContactRow[] = [];
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        contactDegraded.value = readBool(dataObj, "degraded");
        contactTruncated.value = readBool(dataObj, "truncated");
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const row = readContactRow(items[i]);
            if (row.status == 2) {
              pendingIn.push(row);
            } else if (row.status == 3) {
              pendingOut.push(row);
            } else {
              accepted.push(row);
            }
          }
        }
      }
      acceptedContacts.value = accepted;
      pendingInContacts.value = pendingIn;
      pendingOutContacts.value = pendingOut;
      contactLoaded.value = true;
    } catch (_error) {
      contactLoading.value = false;
      contactFailed.value = true;
    }
  }

  /** 群组页大小：服务端 clamp 到 [1,100]，智联录分类单页拉满，免分页 UI（群组数超 100 再补分页）。 */
  const GROUP_PAGE_SIZE = 100;

  async function loadGroups(): Promise<void> {
    if (groupsLoading.value) {
      return;
    }
    if (!hasAccessToken()) {
      groupsLoaded.value = true;
      return;
    }
    groupsLoading.value = true;
    try {
      const res = await apiImMyGroups("", GROUP_PAGE_SIZE);
      groupsLoading.value = false;
      if (apiResCode(res) != SUCCESS_CODE) {
        // 失败静默：分类不展示，下次切入智联录自动重试
        return;
      }
      myGroups.value = parseGroupRecords(res);
      groupsLoaded.value = true;
    } catch (_error) {
      groupsLoading.value = false;
    }
  }

  function switchTab(tab: string): void {
    if (activeTab.value == tab) {
      return;
    }
    activeTab.value = tab;
    // 智联录懒加载：首次切入时拉取（联系人 + 我的群组计数）
    if (tab == "contact") {
      if (contactLoaded.value != true) {
        loadContacts();
      }
      if (groupsLoaded.value != true) {
        loadGroups();
      }
    }
  }

  /** subjectType：1=人（用户标签），其余值为智能体（专家标签）。 */
  function isExpertContact(contact: ImContactRow): boolean {
    return contact.subjectType != 1;
  }

  function displayConvName(conv: ImConvRow): string {
    if (conv.displayName.length > 0) {
      return conv.displayName;
    }
    // 缺名兜底区分会话类型：群聊给群组语义，单聊沿用通用文案
    return conv.convType == 2
      ? t("Mobile.Message.unnamedGroup")
      : t("Mobile.Common.conversations");
  }

  /**
   * 会话摘要：无消息的会话（lastMsgSeq=0，服务端整个省略 lastMsgDigest/lastMsgAt 键）
   * 显示「暂无消息」占位，避免摘要行空白。
   */
  function displayConvDigest(conv: ImConvRow): string {
    if (conv.lastMsgDigest.length > 0) {
      return conv.lastMsgDigest;
    }
    return t("Mobile.Message.emptyMessages");
  }

  /** 展开/折叠我的群组（默认折叠，对齐 PC 端智联录交互）。 */
  function toggleGroups(): void {
    groupsExpanded.value = !groupsExpanded.value;
  }

  /** 群组成员数标签："{count} 人"。 */
  function groupMemberLabel(conv: ImConvRow): string {
    const params = new Map<string, string | number>();
    params.set("count", conv.memberCount);
    return translateFn(
      "Mobile.Message.groupMemberCount",
      toI18nParams(params),
      `${conv.memberCount}`,
    );
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  function formatUnread(count: number): string {
    return count > 99 ? "99+" : `${count}`;
  }

  function pad2(value: number): string {
    return value < 10 ? `0${value}` : `${value}`;
  }

  function isSameDay(a: Date, b: Date): boolean {
    return (
      a.getFullYear() == b.getFullYear() &&
      a.getMonth() == b.getMonth() &&
      a.getDate() == b.getDate()
    );
  }

  /** 列表时间：今天 HH:mm / 昨天 / 同年 M月D日 / 跨年 YYYY年M月D日（首版对齐参考设计中文格式）。 */
  function formatConvTime(ts: number): string {
    if (ts <= 0) {
      return "";
    }
    const date = new Date(ts);
    const now = new Date();
    if (isSameDay(date, now)) {
      return pad2(date.getHours()) + ":" + pad2(date.getMinutes());
    }
    const yesterday = new Date(now.getTime() - 86400000);
    if (isSameDay(date, yesterday)) {
      return t("Mobile.Message.yesterday");
    }
    if (date.getFullYear() == now.getFullYear()) {
      return `${date.getMonth() + 1}月${date.getDate()}日`;
    }
    return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;
  }

  function handleConvScrollLower(): void {
    loadMoreConversations();
  }

  function handleConvRetry(): void {
    if (convFailed.value) {
      loadConversations();
    }
  }

  function handleContactRetry(): void {
    if (contactFailed.value) {
      loadContacts();
    }
  }

  /** 搜索 / 添加占位：后续接搜索页与添加菜单。 */
  function handlePlaceholderTap(): void {
    uni.showToast({ title: t("Mobile.Common.comingSoon"), icon: "none" });
  }

  // ===== 右上角「+」锚定气泡 =====

  /** 点击「+」：测量加号位置，弹出锚定气泡（贴右缘、顶部在加号下方）。 */
  function openAddDrawer(): void {
    const pageProxy = pageInstance != null ? pageInstance.proxy : null;
    if (pageProxy == null) {
      return;
    }
    uni.createSelectorQuery()
      .in(pageProxy)
      .select(".im-action--plus")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        let bottomPx = -1;
        let rightPx = -1;
        if (results.length > 0) {
          const raw = results[0];
          if (raw != null) {
            const rect = raw as NodeInfo;
            if (rect.bottom != null) {
              bottomPx = parseFloat(`${rect.bottom}`);
            }
            if (rect.right != null) {
              rightPx = parseFloat(`${rect.right}`);
            }
          }
        }
        const proxy = addDrawerRef.value as ComponentPublicInstance | null;
        if (proxy != null) {
          proxy.$callMethod("open", bottomPx, rightPx);
        }
      });
  }

  /** 气泡 - 创建群组：记录待开弹窗，等气泡关闭（closed）再串行打开。 */
  function handleCreateGroupTap(): void {
    pendingSheetAfterDrawer = "create-group";
  }

  /** 气泡 - 加入群组：记录待开弹窗，等气泡关闭（closed）再串行打开。 */
  function handleJoinGroupTap(): void {
    pendingSheetAfterDrawer = "join-group";
  }

  /** 气泡 - 添加伙伴：记录待开弹窗，等气泡关闭（closed）再串行打开。 */
  function handleAddBuddyTap(): void {
    pendingSheetAfterDrawer = "add-buddy";
  }

  /** 加入群组申请已提交：静默刷新会话列表（免审批群会立即出现）。 */
  function handleJoinedGroup(): void {
    loadConversations();
  }

  /** 气泡关闭后：接续打开 pending 的弹窗。 */
  function handleAddDrawerClosed(): void {
    if (pendingSheetAfterDrawer == "create-group") {
      pendingSheetAfterDrawer = "";
      const proxy = createGroupSheetRef.value as ComponentPublicInstance | null;
      if (proxy == null) {
        return;
      }
      proxy.$callMethod("open");
      return;
    }
    if (pendingSheetAfterDrawer == "join-group") {
      pendingSheetAfterDrawer = "";
      const proxy = joinGroupSheetRef.value as ComponentPublicInstance | null;
      if (proxy == null) {
        return;
      }
      proxy.$callMethod("open");
      return;
    }
    if (pendingSheetAfterDrawer == "add-buddy") {
      pendingSheetAfterDrawer = "";
      const proxy = addBuddySheetRef.value as ComponentPublicInstance | null;
      if (proxy == null) {
        return;
      }
      proxy.$callMethod("open");
    }
  }

  /** 进入消息详情页：携带会话基础信息（名称/头像 encodeURIComponent，详情页容错解码）。 */
  function openConversation(conv: ImConvRow): void {
    uni.navigateTo({
      url:
        `/pages/message/chat?convId=${conv.convId}&convType=${conv.convType}` +
        `&name=${encodeURIComponent(displayConvName(conv))}` +
        `&avatar=${encodeURIComponent(conv.avatarUrl)}`,
    });
  }

  // ===== 左滑手势核心（会话行 / 联系人行共用：置顶免打扰删除、发消息备注删人、撤回申请）=====

  /** 手势状态：同一时刻仅一行在拖拽（rowId 唯一标识当前行）。 */
  let swipeActiveId = "";
  let swipeStartX = 0;
  let swipeStartY = 0;
  let swipeBaseX = 0;
  // 轴锁定：0=未判定 1=横向（左滑）2=纵向（让位列表滚动）
  let swipeAxis = 0;
  // 横向滑动松手后 H5 仍会补发一次 click，吞掉避免误触行点击
  let suppressNextSwipeClick = false;

  /** 左滑操作区宽度（px）：actsRpx 为按钮区总宽（rpx，按行类型 420=3×140 / 220=单宽钮）。 */
  function swipeActsWidthPx(actsRpx: number): number {
    return (uni.getWindowInfo().windowWidth / 750) * actsRpx;
  }

  /** 按钮层平移：内容行不动，按钮层从右缘滑入（swipeX∈[-W,0] 映射到 [0,+W]），松手吸附带 200ms 过渡。 */
  function actsSwipeStyle(state: SwipeRowState, actsRpx: number): string {
    const width = swipeActsWidthPx(actsRpx);
    let style = `transform: translateX(${state.swipeX + width}px);`;
    if (state.swipeAnim) {
      style += "transition-property: transform; transition-duration: 200ms;";
    }
    return style;
  }

  /** 单开策略：按下一行时收起其它已展开的行（跨会话 / 联系人两类行）。 */
  function closeOtherSwipes(exceptId: string): void {
    const convs = conversations.value;
    for (let i = 0; i < convs.length; i++) {
      const row = convs[i];
      if (row.convId != exceptId && row.swipeX != 0) {
        row.swipeAnim = true;
        row.swipeX = 0;
      }
    }
    const accepted = acceptedContacts.value;
    for (let i = 0; i < accepted.length; i++) {
      const row = accepted[i];
      if (`ct-${row.userId}` != exceptId && row.swipeX != 0) {
        row.swipeAnim = true;
        row.swipeX = 0;
      }
    }
    const pending = pendingOutContacts.value;
    for (let i = 0; i < pending.length; i++) {
      const row = pending[i];
      if (`ct-${row.userId}` != exceptId && row.swipeX != 0) {
        row.swipeAnim = true;
        row.swipeX = 0;
      }
    }
    const groups = myGroups.value;
    for (let i = 0; i < groups.length; i++) {
      const row = groups[i];
      if (`grp-${row.convId}` != exceptId && row.swipeX != 0) {
        row.swipeAnim = true;
        row.swipeX = 0;
      }
    }
  }

  function onSwipeTouchStart(e: UniTouchEvent, rowId: string, state: SwipeRowState): void {
    swipeActiveId = rowId;
    swipeStartX = e.touches[0].clientX;
    swipeStartY = e.touches[0].clientY;
    swipeBaseX = state.swipeX;
    swipeAxis = 0;
    suppressNextSwipeClick = false;
    closeOtherSwipes(rowId);
  }

  function onSwipeTouchMove(
    e: UniTouchEvent,
    rowId: string,
    state: SwipeRowState,
    actsRpx: number,
  ): void {
    if (swipeActiveId != rowId) {
      return;
    }
    const dx = e.touches[0].clientX - swipeStartX;
    const dy = e.touches[0].clientY - swipeStartY;
    const adx = dx < 0 ? -dx : dx;
    const ady = dy < 0 ? -dy : dy;
    // 轴锁定：位移超 8px 才判定方向，|dx|>|dy| 为横向，否则让位纵向滚动
    if (swipeAxis == 0) {
      if (adx < 8 && ady < 8) {
        return;
      }
      swipeAxis = adx > ady ? 1 : 2;
    }
    if (swipeAxis != 1) {
      return;
    }
    let next = swipeBaseX + dx;
    const width = swipeActsWidthPx(actsRpx);
    if (next < -width) {
      next = -width;
    }
    if (next > 0) {
      next = 0;
    }
    state.swipeAnim = false;
    state.swipeX = next;
  }

  function onSwipeTouchEnd(
    _e: UniTouchEvent,
    rowId: string,
    state: SwipeRowState,
    actsRpx: number,
  ): void {
    if (swipeActiveId != rowId) {
      return;
    }
    swipeActiveId = "";
    if (swipeAxis != 1) {
      return;
    }
    suppressNextSwipeClick = true;
    // 过半展开、不足半收回
    const width = swipeActsWidthPx(actsRpx);
    state.swipeAnim = true;
    state.swipeX = state.swipeX < -width / 2 ? -width : 0;
  }

  /** 行点击的左滑处理：已展开先收起、滑动补发的 click 吞掉；返回 true 表示调用方直接 return。 */
  function handleSwipeRowClick(state: SwipeRowState): boolean {
    if (suppressNextSwipeClick) {
      suppressNextSwipeClick = false;
      return true;
    }
    if (state.swipeX != 0) {
      state.swipeAnim = true;
      state.swipeX = 0;
      return true;
    }
    return false;
  }

  /** 收起某行左滑菜单（点操作按钮时先收起）。 */
  function closeSwipe(state: SwipeRowState): void {
    suppressNextSwipeClick = false;
    state.swipeAnim = true;
    state.swipeX = 0;
  }

  /** 会话行点击：左滑展开时先收起；否则进消息详情页。 */
  function handleConvClick(conv: ImConvRow): void {
    if (handleSwipeRowClick(conv)) {
      return;
    }
    openConversation(conv);
  }

  /** 置顶/取消置顶（topFlag）：成功后整表刷新，顺序以服务端为准（最先置顶的在最上面）。 */
  async function handleConvPin(conv: ImConvRow): Promise<void> {
    closeSwipe(conv);
    const pin = !conv.topFlag;
    try {
      const res = await apiImConvSetTop(conv.convId, pin);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({
        title: pin
          ? t("Mobile.Conversation.pinSuccess")
          : t("Mobile.Conversation.unpinSuccess"),
        icon: "none",
      });
      loadConversations();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /** 消息免打扰开关（dnd）：不影响列表排序，本地即时生效。 */
  async function handleConvDnd(conv: ImConvRow): Promise<void> {
    closeSwipe(conv);
    const mute = !conv.dnd;
    try {
      const res = await apiImConvSetDnd(conv.convId, mute);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      conv.dnd = mute;
      uni.showToast({
        title: mute ? t("Mobile.Message.muteSuccess") : t("Mobile.Message.unmuteSuccess"),
        icon: "none",
      });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /** 删除会话（visible=false 仅移出我的消息列表）：按会话类型给不同确认文案。 */
  function handleConvRemove(conv: ImConvRow): void {
    closeSwipe(conv);
    uni.showModal({
      title: t("Mobile.Message.removeConvTitle"),
      content:
        conv.convType == 2
          ? t("Mobile.Message.removeConvGroupTip")
          : t("Mobile.Message.removeConvP2pTip"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.delete"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm == true) {
          removeConversation(conv);
        }
      },
    });
  }

  /** 删除成功：本地移除该行，并刷新 tab 未读角标（GET unread-total）。 */
  async function removeConversation(conv: ImConvRow): Promise<void> {
    try {
      const res = await apiImConvRemove(conv.convId);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      const next: ImConvRow[] = [];
      const list = conversations.value;
      for (let i = 0; i < list.length; i++) {
        if (list[i].convId != conv.convId) {
          next.push(list[i]);
        }
      }
      conversations.value = next;
      refreshImUnreadBadge();
      uni.showToast({ title: t("Mobile.Message.removeConvSuccess"), icon: "none" });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  // ===== 智联录交互 =====

  /** 联系人点击防重入：p2p 会话创建是一次网络往返，期间忽略连点。 */
  let contactChatOpening = false;

  /**
   * 点击正式联系人：get-or-create 单聊（幂等，同一对人永远同一 convId）后进详情页。
   * convId 取响应原文（请求层 parseJsonKeepInt64 保证雪花号精确）；名称/头像用
   * 联系人行的展示值，与会话列表入口的参数结构保持一致。
   */
  async function openContactChat(contact: ImContactRow): Promise<void> {
    // 左滑展开时点击 = 收起菜单；滑动松手补发的 click 吞掉
    if (handleSwipeRowClick(contact)) {
      return;
    }
    if (contactChatOpening) {
      return;
    }
    contactChatOpening = true;
    try {
      const res = await apiImCreateP2pConversation(contact.userId);
      contactChatOpening = false;
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      const convId = dataObj != null ? readString(dataObj, "convId") : "";
      if (apiResCode(res) != SUCCESS_CODE || convId.length == 0) {
        uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
        return;
      }
      uni.navigateTo({
        url:
          `/pages/message/chat?convId=${convId}&convType=1` +
          `&name=${encodeURIComponent(contact.displayName)}` +
          `&avatar=${encodeURIComponent(contact.avatarUrl)}`,
      });
    } catch (_error) {
      contactChatOpening = false;
      uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
    }
  }

  /** 同意/拒绝好友申请：成功后整表刷新（状态迁移以服务端为准，不做本地搬移）。 */
  async function resolveContactRequest(
    contact: ImContactRow,
    accept: boolean,
  ): Promise<void> {
    try {
      const res = accept
        ? await apiImContactAccept(contact.userId)
        : await apiImContactReject(contact.userId);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({
        title: accept
          ? t("Mobile.Message.contactAccepted")
          : t("Mobile.Message.contactRejected"),
        icon: "none",
      });
      loadContacts();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /** 点击「新的伙伴申请」：action sheet 同意/拒绝；取消即关闭，不产生副作用。 */
  function handlePendingInTap(contact: ImContactRow): void {
    uni.showActionSheet({
      itemList: [
        t("Mobile.Message.contactAccept"),
        t("Mobile.Message.contactReject"),
      ],
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.tapIndex == 0) {
          resolveContactRequest(contact, true);
        } else {
          resolveContactRequest(contact, false);
        }
      },
    });
  }

  /** 点击「已申请」：等待对方处理，仅提示。 */
  function handlePendingOutTap(contact: ImContactRow): void {
    // 左滑展开时点击 = 收起菜单；滑动松手补发的 click 吞掉
    if (handleSwipeRowClick(contact)) {
      return;
    }
    uni.showToast({ title: t("Mobile.Message.requestPendingTip"), icon: "none" });
  }

  // ===== 联系人行左滑操作（发消息 / 修改备注 / 删除联系人 / 撤回申请）=====

  /** 左滑-发消息：与点行同路径（get-or-create 单聊后进详情页）。 */
  function handleContactMessage(contact: ImContactRow): void {
    closeSwipe(contact);
    openContactChat(contact);
  }

  /** 左滑-修改备注：打开底部弹窗（预填现有备注，留空保存=清除）。 */
  function handleContactRemark(contact: ImContactRow): void {
    closeSwipe(contact);
    const proxy = remarkSheetRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("open", contact.userId, contact.displayName, contact.remark);
  }

  /** 备注保存成功：刷新联系人列表（displayName = remark > nick > name 随之更新）。 */
  function handleRemarkSaved(): void {
    loadContacts();
  }

  /** 左滑-删除联系人：二次确认（★双向删除：对方那边也会失去我）后调 DELETE。 */
  function handleContactRemove(contact: ImContactRow): void {
    closeSwipe(contact);
    uni.showModal({
      title: t("Mobile.Message.removeContactTitle"),
      content: t("Mobile.Message.removeContactTip"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.delete"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm == true) {
          removeContact(contact);
        }
      },
    });
  }

  /** 删除成功：整表刷新（以服务端为准）。 */
  async function removeContact(contact: ImContactRow): Promise<void> {
    try {
      const res = await apiImContactRemove(contact.userId);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Message.removeContactSuccess"), icon: "none" });
      loadContacts();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /**
   * 左滑-撤回申请：★无确认直接调（与「拒绝申请」同一端点：删掉两行，幂等）。
   * 成功后整表刷新（status=3 的行随之消失）。
   */
  async function handleContactWithdraw(contact: ImContactRow): Promise<void> {
    closeSwipe(contact);
    try {
      const res = await apiImContactReject(contact.userId);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Message.withdrawSuccess"), icon: "none" });
      loadContacts();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  // ===== 群组行左滑操作（打开会话 / 解散群聊（群主）/ 退出群聊（非群主））=====

  /** 左滑-打开会话：与点行同路径（群聊直接带 convId 进详情页）。 */
  function handleGroupOpen(group: ImConvRow): void {
    closeSwipe(group);
    openConversation(group);
  }

  /** 左滑-解散群聊（仅群主）：二次确认后 DELETE 会话（群整体消失，不可恢复）。 */
  function handleGroupDissolve(group: ImConvRow): void {
    closeSwipe(group);
    // 标题/正文含群名与人数（设计稿：解散群「xxx」？/ 群里 N 人的会话都会消失…）
    const params = new Map<string, string | number>();
    params.set("name", displayConvName(group));
    params.set("count", group.memberCount);
    uni.showModal({
      title: translateFn("Mobile.Message.dissolveGroupTitle", toI18nParams(params), "解散群聊"),
      content: translateFn("Mobile.Message.dissolveGroupTip", toI18nParams(params), ""),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Message.dissolveGroupConfirm"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm == true) {
          dissolveGroup(group);
        }
      },
    });
  }

  /** 解散成功：群组 + 会话列表整表刷新，并同步 tab 未读角标。 */
  async function dissolveGroup(group: ImConvRow): Promise<void> {
    try {
      const res = await apiImGroupDisband(group.convId);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Message.dissolveGroupSuccess"), icon: "none" });
      loadGroups();
      loadConversations();
      refreshImUnreadBadge();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /**
   * 左滑-退出群聊（非群主）：二次确认后 POST leave。
   * 群主不会看到该入口（服务端同样禁止群主直接退群，需先转让）。
   */
  function handleGroupLeave(group: ImConvRow): void {
    closeSwipe(group);
    // 标题含群名（对齐解散弹窗：退出群「xxx」？）；按钮为固定文案「退出群聊」
    const params = new Map<string, string | number>();
    params.set("name", displayConvName(group));
    uni.showModal({
      title: translateFn("Mobile.Message.leaveGroupTitle", toI18nParams(params), "退出群聊"),
      content: t("Mobile.Message.leaveGroupTip"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Message.leaveGroupConfirm"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm == true) {
          leaveGroup(group);
        }
      },
    });
  }

  /** 退群成功：群组 + 会话列表整表刷新，并同步 tab 未读角标。 */
  async function leaveGroup(group: ImConvRow): Promise<void> {
    try {
      const res = await apiImGroupLeave(group.convId);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Message.leaveGroupSuccess"), icon: "none" });
      loadGroups();
      loadConversations();
      refreshImUnreadBadge();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  function handleConvAvatarError(conv: ImConvRow): void {
    conv.avatarFailed = true;
  }

  function handleContactAvatarError(contact: ImContactRow): void {
    contact.avatarFailed = true;
  }

  onLoad((_options: any) => {
    loadConversations();
  });

  // 首次 onShow 与 onLoad 重合，跳过避免重复请求；之后每次回页静默刷新
  let hasShownOnce = false;
  onShow(() => {
    refreshImUnreadBadge();
    if (!hasShownOnce) {
      hasShownOnce = true;
      return;
    }
    if (convLoaded.value) {
      loadConversations();
    }
    if (contactLoaded.value) {
      loadContacts();
    }
    if (groupsLoaded.value) {
      loadGroups();
    }
  });
</script>

<style lang="scss" scoped>
  .im-page {
    display: flex;
