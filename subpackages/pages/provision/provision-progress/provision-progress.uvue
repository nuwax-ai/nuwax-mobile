<template>
  <view class="provision-progress">
    <custom-nav-bar :title="t('Mobile.Provision.Progress.title')" :show-back="true" :has-safety-zone="true" />

    <view class="provision-progress__body">
      <!-- 进行中 -->
      <view v-if="!isSuccess && !isFailed" class="progress">
        <view
          v-for="(stage, index) in stages"
          :key="index"
          class="stage"
        >
          <view class="stage__dot" :class="`stage__dot--${stage.state}`">
            <text v-if="stage.state == 'done'" class="stage__dot-icon">✓</text>
            <text v-else-if="stage.state == 'fail'" class="stage__dot-icon">✕</text>
          </view>
          <text class="stage__text" :class="{ 'stage__text--active': stage.state == 'active' }">{{ stage.label }}</text>
        </view>
      </view>

      <!-- 成功 -->
      <view v-if="isSuccess" class="result">
        <text class="result__icon result__icon--success">🎉</text>
        <text class="result__title">{{ t('Mobile.Provision.Result.successTitle') }}</text>
        <text class="result__desc">{{ successDesc }}</text>
        <view class="result__btn result__btn--primary" @tap="onDone">
          <text class="result__btn-text result__btn-text--primary">{{ t('Mobile.Provision.Result.done') }}</text>
        </view>
      </view>

      <!-- 失败 -->
      <view v-if="isFailed" class="result">
        <text class="result__icon result__icon--fail">⚠️</text>
        <text class="result__title">{{ t('Mobile.Provision.Result.failTitle') }}</text>
        <text class="result__desc">{{ failReason }}</text>
        <view class="result__btn-group">
          <view v-if="retryable" class="result__btn result__btn--primary" @tap="onRetry">
            <text class="result__btn-text result__btn-text--primary">{{ t('Mobile.Provision.Result.retry') }}</text>
          </view>
          <view class="result__btn result__btn--plain" @tap="onReprovision">
            <text class="result__btn-text result__btn-text--plain">{{ t('Mobile.Provision.Result.reprovision') }}</text>
          </view>
          <view class="result__btn result__btn--plain" @tap="onResetDevice">
            <text class="result__btn-text result__btn-text--plain">{{ t('Mobile.Provision.Result.resetDevice') }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { ref, computed } from "vue";
  import { onLoad, onUnload } from "@dcloudio/uni-app";
  import { useI18n, toI18nParams } from "@/utils/i18n";
  import { useProvision } from "@/hooks/useProvision";
  import { getProvisionDevice, getProvisionCredentials, clearProvisionSession } from "@/utils/provisionSession";
  import { ProvisionPhaseEnum } from "@/types/enums/provision";

  const { t } = useI18n();

  interface StageItem {
    label: string;
    state: 'pending' | 'active' | 'done' | 'fail';
  }

  const controller = useProvision();
  const phase = controller.phase;
  const error = controller.error;
  const connectedSsid = controller.connectedSsid;

  const isSuccess = computed((): boolean => phase.value == ProvisionPhaseEnum.SUCCESS);
  const isFailed = computed((): boolean => phase.value == ProvisionPhaseEnum.FAILED);
  const retryable = computed((): boolean => error.value != null && error.value!!.retryable);

  const successDesc = computed((): string => {
    const m = new Map<string, string | number>();
    m.set("ssid", connectedSsid.value);
    return t("Mobile.Provision.Result.successDesc", toI18nParams(m));
  });

  const failReason = computed((): string => {
    const e = error.value;
    if (e == null) return t("Mobile.Provision.Error.unknown");
    return t(e.i18nKey);
  });

  // 进度步骤条
  const stages = computed((): StageItem[] => {
    const p = phase.value;
    const order = [
      ProvisionPhaseEnum.CONNECTING,
      ProvisionPhaseEnum.READING_INFO,
      ProvisionPhaseEnum.WRITING_SSID,
      ProvisionPhaseEnum.WAITING_RESULT,
    ] as ProvisionPhaseEnum[];
    const labels = [
      t("Mobile.Provision.Progress.stageConnect"),
      t("Mobile.Provision.Progress.stageReadInfo"),
      t("Mobile.Provision.Progress.stageWrite"),
      t("Mobile.Provision.Progress.stageWait"),
    ] as string[];
    // 当前阶段在 order 中的下标（写入密码也归入"下发凭据"）
    let activeIdx = 0;
    if (p == ProvisionPhaseEnum.CONNECTING || p == ProvisionPhaseEnum.SUBSCRIBING) activeIdx = 0;
    else if (p == ProvisionPhaseEnum.READING_INFO) activeIdx = 1;
    else if (p == ProvisionPhaseEnum.WRITING_SSID || p == ProvisionPhaseEnum.WRITING_PASSWORD) activeIdx = 2;
    else if (p == ProvisionPhaseEnum.WAITING_RESULT) activeIdx = 3;
    else if (p == ProvisionPhaseEnum.SUCCESS) activeIdx = 4; // 全部完成
    else activeIdx = 0;

    const result = [] as StageItem[];
    for (let i = 0; i < order.length; i++) {
      let state = 'pending' as 'pending' | 'active' | 'done' | 'fail';
      if (p == ProvisionPhaseEnum.FAILED) {
        state = i < activeIdx ? 'done' : (i == activeIdx ? 'fail' : 'pending');
      } else if (p == ProvisionPhaseEnum.SUCCESS) {
        state = 'done';
      } else {
        state = i < activeIdx ? 'done' : (i == activeIdx ? 'active' : 'pending');
      }
      result.push({ label: labels[i], state } as StageItem);
    }
    return result;
  });

  const run = async () => {
    const device = getProvisionDevice();
    const cred = getProvisionCredentials();
    if (device == null || cred == null) {
      // 参数缺失，回扫描页
      uni.navigateBack({ delta: 2 });
      return;
    }
    const ok = await controller.selectAndPrepare(device.deviceId);
    if (ok) {
      await controller.provision(cred.ssid, cred.password);
    }
  };

  const onRetry = async () => {
    await controller.retry();
  };

  const onReprovision = () => {
    controller.dispose();
    clearProvisionSession();
    uni.navigateBack({ delta: 1 });
  };

  const onResetDevice = async () => {
    await controller.resetDevice();
    await controller.retry();
  };

  const onDone = () => {
    controller.dispose();
    clearProvisionSession();
    uni.navigateBack({ delta: 3 });
  };

  onLoad(() => {
    run();
  });

  onUnload(() => {
    controller.dispose();
  });
</script>

<style lang="scss" scoped>
  .provision-progress {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;

    &__body {
      flex: 1;
      padding: 48rpx 32rpx;
    }
  }

  .progress {
    display: flex;
    flex-direction: column;
  }

  .stage {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 28rpx 16rpx;

    &__dot {
      width: 48rpx;
      height: 48rpx;
      border-radius: 50%;
      background-color: #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 24rpx;

      &--active {
        background-color: #5147ff;
      }

      &--done {
        background-color: #4cd964;
      }

      &--fail {
        background-color: #dd524d;
      }
    }

    &__dot-icon {
      color: #ffffff;
      font-size: 28rpx;
    }

    &__text {
      font-size: 30rpx;
      color: #999;

      &--active {
        color: #333;
        font-weight: 500;
      }
    }
  }

  .result {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 80rpx;

    &__icon {
      font-size: 100rpx;
      margin-bottom: 32rpx;
    }

    &__title {
      font-size: 40rpx;
      font-weight: 600;
      color: #333;
      margin-bottom: 16rpx;
    }

    &__desc {
      font-size: 28rpx;
      color: #999;
      text-align: center;
      margin-bottom: 48rpx;
      line-height: 1.5;
    }

    &__btn-group {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    &__btn {
      width: 80%;
      padding: 28rpx 0;
      border-radius: 48rpx;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24rpx;

      &--primary {
        background-color: #5147ff;
      }

      &--plain {
        background-color: #ffffff;
        border: 1rpx solid #5147ff;
      }
    }

    &__btn-text {
      font-size: 32rpx;

      &--primary {
        color: #ffffff;
      }

      &--plain {
        color: #5147ff;
      }
    }
  }
</style>
