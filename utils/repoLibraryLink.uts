/**
 * 会话里的资料库链接。
 *
 * 路径中包含 `/repo/doc/` 或 `/repo/share/` 即视为资料库。
 * 移动端不按 PC 那样嵌 iframe、也不校验外链源站：一律改写成
 * 「当前请求域名 + 链接路径」，并带上只看正文的查询参数，再交给站内 webview 打开。
 */
import { getApiBaseUrl } from "@/constants/config";
import { isAppWebViewEmbedded } from "@/utils/appWebViewDetect";
import {
  navigateToPageOnce,
  navigateViaWebViewSdk,
  navigateViaWxMiniProgram,
} from "@/utils/system.uts";

/** 资料库路径：文档与分享都算资料库。 */
const REPO_LIBRARY_PATHS: string[] = ["/repo/doc/", "/repo/share/"];

/** 嵌入时只展示文档正文，并收起资料库侧栏表格。 */
const REPO_DOC_EMBED_QUERY_KEYS: string[] = ["just_show_content", "hide_sheet"];

const INNER_WEBVIEW_PAGE_PATH = "/subpackages/pages/webview/webview";

/**
 * 路径是否包含资料库段。
 * @param pathname 不含 query / hash 的路径
 */
export function isRepoLibraryPath(pathname: string): boolean {
  for (let i = 0; i < REPO_LIBRARY_PATHS.length; i++) {
    if (pathname.indexOf(REPO_LIBRARY_PATHS[i]) >= 0) {
      return true;
    }
  }
  return false;
}

function trimTrailingSlash(value: string): string {
  let result = value;
  while (result.length > 0 && result.charAt(result.length - 1) == "/") {
    result = result.substring(0, result.length - 1);
  }
  return result;
}

/**
 * 资料库页要拼到的请求域名。
 * App 内嵌离线包以 storage 里的 API 域名为准；浏览器 H5 生产环境接口走同源，域名回退当前页 origin。
 */
function resolveRepoRequestOrigin(): string {
  const base = trimTrailingSlash(getApiBaseUrl().trim());
  if (base.length > 0) {
    return base;
  }
  // #ifdef H5 || WEB
  try {
    const origin = window.location.origin;
    if (origin != null && `${origin}`.length > 0) {
      return trimTrailingSlash(`${origin}`);
    }
  } catch (_e) {
    return "";
  }
  // #endif
  return "";
}

/**
 * 从相对路径或绝对地址里取出 path / query / hash。
 * 非 http(s)、锚点、无路径的地址返回空路径。
 */
function extractRepoLinkParts(raw: string): string[] {
  const empty: string[] = ["", "", ""];
  let value = raw.trim();
  if (value.length == 0 || value.charAt(0) == "#") {
    return empty;
  }
  if (value.indexOf("//") == 0) {
    value = `https:${value}`;
  }
  const lower = value.toLowerCase();
  if (
    lower.indexOf("javascript:") == 0 ||
    lower.indexOf("mailto:") == 0 ||
    lower.indexOf("data:") == 0
  ) {
    return empty;
  }

  let path = value;
  if (lower.indexOf("http://") == 0 || lower.indexOf("https://") == 0) {
    const protoIdx = value.indexOf("://");
    const afterProto = value.substring(protoIdx + 3);
    const slashIdx = afterProto.indexOf("/");
    if (slashIdx < 0) {
      return empty;
    }
    path = afterProto.substring(slashIdx);
  } else if (value.indexOf("://") >= 0) {
    return empty;
  } else if (value.charAt(0) != "/") {
    return empty;
  }

  let hash = "";
  const hashIdx = path.indexOf("#");
  if (hashIdx >= 0) {
    hash = path.substring(hashIdx);
    path = path.substring(0, hashIdx);
  }
  let query = "";
  const queryIdx = path.indexOf("?");
  if (queryIdx >= 0) {
    query = path.substring(queryIdx + 1);
    path = path.substring(0, queryIdx);
  }
  const parts: string[] = [path, query, hash];
  return parts;
}

/** 写入或覆盖一个查询参数，保留链接上已有的其它参数。 */
function upsertQueryParam(query: string, key: string, value: string): string {
  const pieces = query.length == 0 ? ([] as string[]) : query.split("&");
  const kept: string[] = [];
  let replaced = false;
  for (let i = 0; i < pieces.length; i++) {
    const piece = pieces[i];
    if (piece.length == 0) {
      continue;
    }
    const eq = piece.indexOf("=");
    const pieceKey = eq >= 0 ? piece.substring(0, eq) : piece;
    if (pieceKey == key) {
      if (replaced == false) {
        kept.push(`${key}=${value}`);
        replaced = true;
      }
    } else {
      kept.push(piece);
    }
  }
  if (replaced == false) {
    kept.push(`${key}=${value}`);
  }
  return kept.join("&");
}

/**
 * 把资料库链接解析成可打开的绝对地址。
 * @param href 锚点上的原始地址，可以是相对路径或绝对 URL
 * @returns `{请求域名}{路径}?just_show_content=true&hide_sheet=true`；不是资料库链接时返回空串
 */
export function resolveRepoLibraryPreviewUrl(href: string): string {
  const parts = extractRepoLinkParts(href);
  const path = parts[0];
  if (path.length == 0 || isRepoLibraryPath(path) == false) {
    return "";
  }
  const origin = resolveRepoRequestOrigin();
  if (origin.length == 0) {
    return "";
  }
  let query = parts[1];
  for (let i = 0; i < REPO_DOC_EMBED_QUERY_KEYS.length; i++) {
    query = upsertQueryParam(query, REPO_DOC_EMBED_QUERY_KEYS[i], "true");
  }
  return `${origin}${path}?${query}${parts[2]}`;
}

/**
 * 浏览器 H5 且目标与当前页不同源时，不能放进 web-view 的 iframe。
 * 资料库页会读 `window.parent.__repoEmbedSeed`，父页面跨域会抛 SecurityError 把文档打挂。
 * 新开顶层页后 `window.parent === window`，这段读取会直接跳过。
 */
function shouldOpenRepoAsTopLevel(target: string): boolean {
  // #ifdef H5 || WEB
  if (isAppWebViewEmbedded() == true) {
    return false;
  }
  try {
    const pageOrigin = `${window.location.origin}`;
    const protoIdx = target.indexOf("://");
    if (protoIdx < 0 || pageOrigin.length == 0) {
      return true;
    }
    const afterProto = target.substring(protoIdx + 3);
    let hostEnd = afterProto.length;
    const slashIdx = afterProto.indexOf("/");
    if (slashIdx >= 0 && slashIdx < hostEnd) {
      hostEnd = slashIdx;
    }
    const queryIdx = afterProto.indexOf("?");
    if (queryIdx >= 0 && queryIdx < hostEnd) {
      hostEnd = queryIdx;
    }
    const targetOrigin = target.substring(0, protoIdx + 3) + afterProto.substring(0, hostEnd);
    return targetOrigin != pageOrigin;
  } catch (_e) {
    return true;
  }
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

/** 以顶层文档打开资料库，避免跨域 iframe 读取父窗口。 */
function openRepoAsTopLevel(target: string): boolean {
  // #ifdef H5 || WEB
  try {
    const opened = window.open(target, "_blank");
    if (opened != null) {
      return true;
    }
  } catch (_e) {
    // 弹窗被拦截时改走当前页跳转
  }
  try {
    window.location.href = target;
    return true;
  } catch (_e2) {
    return false;
  }
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

/**
 * 打开资料库链接：站内 webview 加载解析后的绝对地址。
 * App / 小程序由 webview 页补 `_ticket`；不是资料库链接时返回 false，调用方继续走普通外链。
 * 浏览器里若资料库域名和当前页不同源，改为新开顶层页，避免 iframe 跨域读取父窗口。
 */
export function openRepoLibraryPreview(href: string, title: string = ""): boolean {
  const target = resolveRepoLibraryPreviewUrl(href);
  if (target.length == 0) {
    return false;
  }
  if (shouldOpenRepoAsTopLevel(target)) {
    return openRepoAsTopLevel(target);
  }
  // iOS 内嵌页 uni.webView.navigateTo 会先 decodeURI 整段路由。
  // 只编码一次时，%3F / %26 会被还原成 ? / &，资料库地址被拆碎，
  // web-view 实际打开应用首页，标题参数仍能留下。编码两次，解码一次后仍是完整地址。
  const encodedOnce = encodeURIComponent(target);
  const onceText = encodedOnce != null ? encodedOnce : "";
  const encodedTwice = onceText.length > 0 ? encodeURIComponent(onceText) : "";
  const encodedUrl = encodedTwice != null ? encodedTwice : "";
  if (encodedUrl.length == 0) {
    return false;
  }
  let pageUrl = `${INNER_WEBVIEW_PAGE_PATH}?url=${encodedUrl}`;
  if (title.length > 0) {
    const encodedTitle = encodeURIComponent(title);
    if (encodedTitle != null && encodedTitle.length > 0) {
      pageUrl = `${pageUrl}&title=${encodedTitle}`;
    }
  }
  if (isAppWebViewEmbedded() == true && navigateViaWebViewSdk(pageUrl)) {
    return true;
  }
  if (navigateViaWxMiniProgram(pageUrl)) {
    return true;
  }
  return navigateToPageOnce(pageUrl);
}
