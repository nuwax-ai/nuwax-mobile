<template>
  <!--
    消息 tab 会话列表（组件化 Stage 4 从 message-content 抽出，模板/样式原样迁移）：
    scroll-view + 加载/空态/会话行 v-for。纯展示组件——全部状态经 props 下发
    （单一事实源在页面），交互经 emit 上抛（守卫/判定/导航全在页面处理器）。
    - 行 class 三态（按压闪亮/长按菜单高亮/置顶常驻底）改内联表达式读 props：
      App-Android 方法调用式 class 绑定不保证重估（群已读 v-if 同款坑），内联
      属性访问表达式随 props 变更稳定重渲染；互斥逻辑与原 pinnedRowCls 一致
    - 手势链冒泡序保持：行 touchstart → scroll-view（pane-touch*）→ 页面根
      touchstart，与抽离前同序（页面 handlePageTouchStart 依赖行 touchstart
      先记 touchingRowPending，40ms 去重双派发语义不变）
    - ★行测量协议：行节点在本组件内，页面查不到——measureRow(domId) 组件作用域
      自测（$callMethod 调起），矩形原始数字经 row-rect 上抛（im-header-tabs
      measurePlus 同机制）
  -->
  <scroll-view
    class="im-pane"
    :direction="menuVisible ? 'none' : 'vertical'"
    :show-scrollbar="false"
    :scroll-into-view="scrollAnchor"
    @scroll="emitScroll"
    @scrolltolower="emitScrollLower"
    @touchstart="emitPaneTouchStart($event)"
    @touchend="emitPaneTouchEnd($event)"
    @touchcancel="emitPaneTouchCancel($event)"
  >
    <view v-if="loading && conversations.length == 0" class="im-state">
      <text class="im-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
    </view>
    <view
      v-else-if="conversations.length == 0"
      class="im-state"
      @click="emitRetry"
    >
      <text class="im-state__text">{{
        failed ? t("Mobile.Message.loadFailed") : t("Mobile.Message.emptyMessages")
      }}</text>
    </view>
    <template v-else>
      <view v-for="(conv, index) in conversations" :key="conv.convId">
        <!-- 行内容（长按弹操作气泡：行原位浅灰高亮 + 行旁锚定气泡，无蒙层）；
             置顶行常驻浅底（比按压态再浅一档，微信式置顶标识） -->
        <view
          :id="`row-${conv.convId}`"
          class="chat-item"
          :class="[
            pressedRowId == conv.convId ? 'chat-item--active' : '',
            menuVisible && menuRowId == conv.convId ? 'chat-item--menu-on' : '',
            pressedRowId == conv.convId || (menuVisible && menuRowId == conv.convId)
              ? ''
              : conv.topFlag
                ? 'chat-item--pinned'
                : '',
          ]"
          @click="emitRowClick(conv)"
          @touchstart="emitRowTouchStart(conv, $event)"
          @touchmove="emitRowTouchMove($event)"
          @touchend="emitRowTouchEnd(conv, $event)"
          @touchcancel="emitRowTouchCancel"
        >
          <view class="chat-item__avatar-wrap" :style="avatarBoxStyle">
            <!-- 名称取字兜底（飞书规则）：个人=名末 2 字（赵立坤→立坤）、群=前 4 字
                 两行 2+2（智能体平台研发组→智能/体平，同列表缩写去重）；拼名群
                 （用户a，用户b 式）走蓝底默认群剪影。真图 @load 后整层退场；@error 回场 -->
            <view
              v-if="conv.avatarLoaded != true || conv.avatarFailed == true"
              :class="conv.fallbackMerged ? 'chat-item__avatar chat-item__avatar--solid' : 'chat-item__avatar'"
              :style="{ backgroundImage: conv.fallbackMerged ? 'none' : avatarGradient(conv.displayName) }"
            >
              <image
                v-if="conv.fallbackMerged"
                class="chat-item__avatar-glyph"
                :src="avatarDefaultGroup"
                mode="aspectFit"
              />
              <view v-else class="chat-item__avatar-fallback">
                <text :class="conv.fallbackLine2.length > 0 ? 'chat-item__avatar-fallback-text chat-item__avatar-fallback-text--sm' : 'chat-item__avatar-fallback-text'">{{ conv.fallbackLine1 }}</text>
                <text v-if="conv.fallbackLine2.length > 0" class="chat-item__avatar-fallback-text chat-item__avatar-fallback-text--sm">{{ conv.fallbackLine2 }}</text>
              </view>
            </view>
            <view
              v-if="conv.avatarDisplay.length > 0 && conv.avatarFailed != true"
              class="chat-item__avatar-clip"
            >
              <image
                class="chat-item__avatar chat-item__avatar--img"
                :src="conv.avatarDisplay"
                mode="aspectFill"
                :fade-show="false"
                @load="emitAvatarLoaded(conv)"
                @error="emitAvatarError(conv)"
              />
            </view>
            <view v-if="conv.unreadCount > 0" :class="convBadgeCls(conv)">
              <text class="chat-item__badge-text">{{ formatUnread(conv.unreadCount) }}</text>
            </view>
          </view>
          <view class="chat-item__body">
            <view class="chat-item__title-row">
              <text class="chat-item__title text-ellipsis">{{ displayConvName(conv) }}</text>
              <text class="chat-item__time">{{ formatConvTime(conv.lastMsgAt) }}</text>
            </view>
            <view class="chat-item__sub-row">
              <!-- 草稿优先于末条消息摘要（微信式）；[草稿]前缀独立红字节点（text 无法局部染色） -->
              <text v-if="convDraft(conv).length > 0" class="chat-item__draft">{{
                t("Mobile.Message.draftPrefix")
              }}</text>
              <text
                v-if="convDraft(conv).length > 0"
                class="chat-item__sub text-ellipsis"
              >{{ convDraft(conv) }}</text>
              <text v-else class="chat-item__sub text-ellipsis">{{ displayConvDigest(conv) }}</text>
              <image
                v-if="conv.dnd"
                class="chat-item__mark"
                :src="iconMute"
                mode="aspectFit"
              />
            </view>
          </view>
        </view>
      </view>
      <view v-if="loadingMore" class="im-foot">
        <text class="im-foot__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view v-else-if="hasMore != true" class="im-foot">
        <text class="im-foot__text">{{ t("Mobile.Message.noMore") }}</text>
      </view>
    </template>
  </scroll-view>
</template>

<script setup lang="uts">
  import { getCurrentInstance } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import iconMute from "@/static/icons/mute.png";
  import avatarDefaultGroup from "@/static/images/avatar-default-group.png";
  import { ImConvRow } from "./im-row-models.uts";
  import {
    avatarBoxStyle as avatarBoxStyleOf,
    avatarGradient as avatarGradientOf,
    convBadgeCls as convBadgeClsOf,
    convDraft as convDraftOf,
    displayConvDigest as displayConvDigestOf,
    displayConvName as displayConvNameOf,
    formatConvTime as formatConvTimeOf,
    formatUnread as formatUnreadOf,
  } from "./im-row-helpers.uts";

  // 事件名须 kebab-case：App-Android 模板监听会把 camelCase 转小写导致收不到（add-menu-drawer 同规约）。
  // 触摸载荷 UniTouchEvent 与页面处理器形参 Any 兼容（Any 为根类型）；页面侧再 as UniTouchEvent。
  const emit = defineEmits<{
    /** 空态点击重试（页面 handleConvRetry）。 */
    retry: [];
    /** 列表滚动（页面 handleListScroll：滚动收浮层+清触摸判定+手势门控计时）。 */
    scroll: [];
    /** 滚到底部分页加载（页面 handleConvScrollLower）。 */
    "scroll-lower": [];
    /** scroll-view 层页面触摸三件套（冒泡到页面根之前先到这，40ms 去重语义在页面）。 */
    "pane-touchstart": [e: UniTouchEvent];
    "pane-touchend": [e: UniTouchEvent];
    "pane-touchcancel": [e: UniTouchEvent];
    /** 会话行 click 兜底通道（页面 handleConvRowClick：防重窗）。 */
    "row-click": [conv: ImConvRow];
    /** 会话行 touchstart（页面 handleConvRowTouchStart：公共判定+装填长按）。 */
    "row-touchstart": [conv: ImConvRow, e: UniTouchEvent];
    /** 行 touchmove（页面 handleRowTouchMove：位移>6px 清判定态）。 */
    "row-touchmove": [e: UniTouchEvent];
    /** 会话行 touchend 主通道（页面 handleConvRowTouchEnd：三星微移点按派发）。 */
    "row-touchend": [conv: ImConvRow, e: UniTouchEvent];
    /** 行 touchcancel（页面 handleRowTouchCancel：只清判定态）。 */
    "row-touchcancel": [];
    /** 头像真图 @load/@error（页面记已渲染缓存/负缓存+整表重建）。 */
    "avatar-loaded": [conv: ImConvRow];
    "avatar-error": [conv: ImConvRow];
    /** 行矩形测量结果（视口 px 原始数字；页面拼长按浮层气泡/蒙层）。 */
    "row-rect": [top: number, bottom: number, left: number];
  }>();

  withDefaults(
    defineProps<{
      /** 会话行数组（页面 conversations 直发；整表替换驱动重渲染）。 */
      conversations: ImConvRow[];
      /** 首次加载中（空表时显示加载态）。 */
      loading: boolean;
      /** 加载失败（空表时显示失败文案，点击重试）。 */
      failed: boolean;
      /** 分页加载中（列表尾 loading 条）。 */
      loadingMore: boolean;
      /** 还有更多分页数据（false 时列表尾「没有更多」）。 */
      hasMore: boolean;
      /** scroll-into-view 锚点（双击 tab 定位首未读行；页面写 `row-${convId}`）。 */
      scrollAnchor: string;
      /** 长按浮层展开（锁滚动 direction=none + 行高亮判定）。 */
      menuVisible: boolean;
      /** 长按浮层指向行 id（convId；高亮判定）。 */
      menuRowId: string;
      /** 按压闪亮行 id（convId；300ms 闪灰）。 */
      pressedRowId: string;
    }>(),
    {
      conversations: [] as ImConvRow[],
      loading: false,
      failed: false,
      loadingMore: false,
      hasMore: true,
      scrollAnchor: "",
      menuVisible: false,
      menuRowId: "",
      pressedRowId: "",
    },
  );

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ★uvue 模板不能直接调用导入函数（invoke 解析失败）——本地 const 包装（Stage 1 同款）
  const avatarBoxStyle = avatarBoxStyleOf;
  const avatarGradient = (name: string): string => avatarGradientOf(name);
  const convBadgeCls = (conv: ImConvRow): string => convBadgeClsOf(conv);
  const convDraft = (conv: ImConvRow): string => convDraftOf(conv);
  const displayConvDigest = (conv: ImConvRow): string => displayConvDigestOf(conv);
  const displayConvName = (conv: ImConvRow): string => displayConvNameOf(conv);
  const formatConvTime = (ts: number): string => formatConvTimeOf(ts);
  const formatUnread = (count: number): string => formatUnreadOf(count);

  const componentInstance = getCurrentInstance();

  /** createSelectorQuery.exec 回调（具名函数：深层箭头块会触发 UTS 截断编译，
      message-content 同款约束）。矩形解析后原始数字直发页面（视口坐标系）。 */
  function onRowRectMeasured(results: Array<any>): void {
    let topPx = -1;
    let bottomPx = -1;
    let leftPx = -1;
    if (results.length > 0) {
      const raw = results[0];
      if (raw != null) {
        const rect = raw as NodeInfo;
        if (rect.top != null) {
          topPx = parseFloat(`${rect.top}`);
        }
        if (rect.bottom != null) {
          bottomPx = parseFloat(`${rect.bottom}`);
        }
        if (rect.left != null) {
          leftPx = parseFloat(`${rect.left}`);
        }
      }
    }
    emit("row-rect", topPx, bottomPx, leftPx);
  }

  /** 组件作用域测行矩形（页面 openRowMenu 经 $callMethod 调起；boundingClientRect
      为视口坐标系，与页面侧 .im-page 矩形同系，挖洞/锚定数学不变）。 */
  function measureRow(domId: string): void {
    const proxy = componentInstance != null ? componentInstance.proxy : null;
    if (proxy == null) {
      return;
    }
    uni.createSelectorQuery()
      .in(proxy)
      .select("#" + domId)
      .boundingClientRect()
      .exec(onRowRectMeasured);
  }

  defineExpose({
    measureRow: measureRow as any,
  });

  // ===== 事件上抛薄包装（模板边界 $event 为 Any，进入前 as UniTouchEvent）=====

  function emitRetry(): void {
    emit("retry");
  }

  function emitScroll(): void {
    emit("scroll");
  }

  function emitScrollLower(): void {
    emit("scroll-lower");
  }

  function emitPaneTouchStart(eventValue: Any): void {
    emit("pane-touchstart", eventValue as UniTouchEvent);
  }

  function emitPaneTouchEnd(eventValue: Any): void {
    emit("pane-touchend", eventValue as UniTouchEvent);
  }

  function emitPaneTouchCancel(eventValue: Any): void {
    emit("pane-touchcancel", eventValue as UniTouchEvent);
  }

  function emitRowClick(conv: ImConvRow): void {
    emit("row-click", conv);
  }

  function emitRowTouchStart(conv: ImConvRow, eventValue: Any): void {
    emit("row-touchstart", conv, eventValue as UniTouchEvent);
  }

  function emitRowTouchMove(eventValue: Any): void {
    emit("row-touchmove", eventValue as UniTouchEvent);
  }

  function emitRowTouchEnd(conv: ImConvRow, eventValue: Any): void {
    emit("row-touchend", conv, eventValue as UniTouchEvent);
  }

  function emitRowTouchCancel(): void {
    emit("row-touchcancel");
  }

  function emitAvatarLoaded(conv: ImConvRow): void {
    emit("avatar-loaded", conv);
  }

  function emitAvatarError(conv: ImConvRow): void {
    emit("avatar-error", conv);
  }
</script>

<style lang="scss" scoped>
  /* ★本样式块与 contact-list-pane 各持一份 .chat-item 全族（App 端 scoped 样式按
     组件解析，跨组件不生效）——改任一份必须同步另一份（R5 同步注释）。 */

  /* swiper-item 内列表：撑满页高（swiper-item 自身随 swiper 拉伸，子级须显式 100%） */
  .im-pane {
    height: 100%;
  }

  .im-state {
    padding: 100px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .im-state__text {
    font-size: 14px;
    line-height: 20px;
    color: #94929c;
  }

  .im-foot {
    padding: 14px 0 22px;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .im-foot__text {
    font-size: 12px;
    line-height: 17px;
    color: #c0bec8;
  }

  /* ===== 会话 / 联系人通用行 ===== */
  .chat-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 10.5px 16px;
  }

  /* 置顶会话行常驻底色：与按压态拉开可感差距（浅 11/12/8）；激活期间由
     行 class 内联表达式在 JS 层退场（App 原生端同特异性 class 覆盖不保证按样式表序） */
  .chat-item--pinned {
    background-color: #f7f6fb;
  }

  .chat-item--active {
    background-color: #eceaf3;
  }

  /* 头像盒：46px 定值（px 化后与内联 avatarBoxStyle 同值；历史 iOS 小数 pt 削边问题
     随整数 px 消失——子层 100% 跟随 wrap，勿再重写尺寸） */
  .chat-item__avatar-wrap {
    position: relative;
    width: 46px;
    height: 46px;
    margin-right: 14px;
    flex-shrink: 0;
  }

  /* 宽高 100% 随 wrap 实际布局帧（尺寸真源只在 wrap，子层勿再重写 rpx/px） */
  .chat-item__avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* 头像真图覆盖层：绝对定位于裁切容器内（真图 @load 后剪影兜底整层退场，仅加载期/失败期垫底）。
     100% 随 clip 实际帧（尺寸真源唯一，见 wrap 注释） */
  .chat-item__avatar--img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  /* 真图裁切容器：app-android 上 <image> 自身 border-radius 对个别渲染路径（SVG
     data URL / 本地临时文件）不生效，真机方形透出（H5 是背景图恒被裁，故正常）——
     独立容器 border-radius+overflow 兜底裁切。不裁整个 avatar-wrap 是为避开未读
     角标（位于圆外的方形角区，会被圆形裁切削掉）。z-index 1 同原覆盖层，低于角标 2。
     宽高 100% 随 wrap 实际帧（wrap 已内联整 pt，见其注释——勿在此重写尺寸）。 */
  .chat-item__avatar-clip {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    z-index: 1;
  }

  /* 头像兜底取字（飞书规则）：个人=名末 2 字（单行）、群=前 4 字两行 2+2（同列表去重），
     底色沿用五色渐变板（avatarGradient，红色与未读角标同色易混淆已移除）；「用户a，用户b」式拼名群无语义词可取 →
     蓝底默认群剪影（--solid，backgroundImage 置 none 露出底色） */
  .chat-item__avatar--solid {
    background-color: #337eff;
  }

  /* 取字容器：两行 column 居中（个人单行时只有 line1） */
  .chat-item__avatar-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .chat-item__avatar-fallback-text {
    font-size: 16px;
    line-height: 20px;
    font-weight: 600;
    color: #ffffff;
  }

  /* 两行（群 2+2）字号收小：17px×2 落在 46px 圈内不贴边 */
  .chat-item__avatar-fallback-text--sm {
    font-size: 13px;
    line-height: 17px;
  }

  /* 默认群剪影 PNG：白色实心（透明底），28px 约占 46px 头像 6 成 */
  .chat-item__avatar-glyph {
    width: 28px;
    height: 28px;
  }

  .chat-item__badge {
    position: absolute;
    /* 全平台统一落在头像容器内：App（Android/iOS）原生渲染按父容器边界裁剪越界子元素，
       负偏移角标被 avatar-wrap 削平顶/右边；H5 浏览器实测同样裁右侧负偏移（悬浮式不成立）。
       贴头像右上内缘保证完整圆形，跨端一致。 */
    top: 0;
    right: 0;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border-radius: 50%;
    background-color: #ff4d4f;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    z-index: 2;
  }

  /* 免打扰会话的行内未读：红数字→灰数字（对齐飞书；tabBar 角标仍计入总数） */
  .chat-item__badge--dnd {
    background-color: #94929c;
  }

  .chat-item__badge-text {
    font-size: 11px;
    line-height: 13px;
    font-weight: 600;
    color: #ffffff;
  }

  .chat-item__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .chat-item__title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .chat-item__title {
    flex: 1;
    font-size: 17px;
    line-height: 20.5px;
    font-weight: 400;
    color: #141416;
  }

  .chat-item__time {
    margin-left: 8px;
    flex-shrink: 0;
    font-size: 13.5px;
    line-height: 18px;
    color: #8f959e;
  }

  /* 摘要行：摘要(flex 收缩截断) + 行尾状态图标（免打扰，对齐时间下方） */
  .chat-item__sub-row {
    margin-top: 4px;
    display: flex;
    flex-direction: row;
    /* 图标在容器中垂直居中 */
    align-items: center;
  }

  .chat-item__sub {
    flex: 1;
    min-width: 0;
    font-size: 14px;
    line-height: 17.5px;
    color: #8f959e;
  }

  /* 草稿前缀（微信式红字，未读角标同色）：与摘要同行，固定宽不参与截断 */
  .chat-item__draft {
    margin-right: 4px;
    flex-shrink: 0;
    font-size: 14px;
    line-height: 17.5px;
    color: #ff4d4f;
  }

  /* 长按浮层行高亮：取按压态同色（#eceaf3，状态一致优先）；气泡/蒙层样式在
     row-menu-pop 组件（Stage 2），几何约束见其注释 */
  .chat-item--menu-on {
    background-color: #eceaf3;
  }

  /* 免打扰状态图标（摘要行右端，容器中垂直居中；置顶不再展示角标）。
     盒子取摘要字号（14px）同大：素材为透明底铃铛（占画布 92%），
     实际可见约 13px；H5 端可见层是 uni-image 内层 div 的 background（contain），
