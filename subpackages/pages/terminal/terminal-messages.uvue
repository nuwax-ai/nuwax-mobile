<template>
  <view class="container relative flex flex-col">
    <custom-nav-bar :title="t('Mobile.Terminal.messages')" className="border-b" hasSafetyZone showBack />

    <!-- 未读筛选 -->
    <view class="filter-row">
      <view :class="['filter-chip', !unreadOnly ? 'filter-chip-on' : '']" @click="switchUnreadOnly(false)">
        <text :class="['filter-chip-text', !unreadOnly ? 'filter-chip-text-on' : '']">{{ t("Mobile.Terminal.allMessages") }}</text>
      </view>
      <view :class="['filter-chip', unreadOnly ? 'filter-chip-on' : '']" @click="switchUnreadOnly(true)">
        <text :class="['filter-chip-text', unreadOnly ? 'filter-chip-text-on' : '']">{{ t("Mobile.Terminal.unreadOnly") }}</text>
      </view>
    </view>

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <view class="msg-list">
        <view
          class="msg-card"
          v-for="item in messageList"
          :key="item.id"
          hover-class="msg-card-active"
          @click="handleMessageClick(item)"
        >
          <view class="msg-icon">
            <text class="msg-icon-emoji">{{ item.messageType == 'meeting_summary' ? '📝' : '🔔' }}</text>
          </view>
          <view class="msg-body">
            <view class="msg-head">
              <text :class="['msg-title text-ellipsis', !item.read ? 'msg-title-unread' : '']">{{ item.title }}</text>
              <text class="msg-time">{{ formatTime(item.createdAt) }}</text>
            </view>
            <text class="msg-text">{{ item.body }}</text>
          </view>
          <view v-if="!item.read" class="msg-dot"></view>
        </view>

        <view class="empty-box" v-if="!loading && messageList.length == 0">
          <text class="empty-text">{{ t("Mobile.Terminal.noMessages") }}</text>
        </view>
        <view class="empty-box" v-if="loading">
          <text class="empty-text">{{ t("Mobile.Terminal.loading") }}</text>
        </view>
      </view>
      <view class="bottom-space"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad, onShow } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiVoxMessageList, apiVoxMarkMessageRead } from "@/servers/vox/voxMessage";
  import { AppPushMessageListParams } from "@/types/interfaces/voxMessage";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import { SUCCESS_CODE, USER_NO_LOGIN, REDIRECT_LOGIN } from "@/constants/codes.constants";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  class PushMessage {
    id: number = 0;
    messageType: string = "";
    refId: number = 0;
    title: string = "";
    body: string = "";
    read: boolean = false;
    createdAt: string = "";
    constructor(id: number, messageType: string, refId: number, title: string, body: string, read: boolean, createdAt: string) {
      this.id = id;
      this.messageType = messageType;
      this.refId = refId;
      this.title = title;
      this.body = body;
      this.read = read;
      this.createdAt = createdAt;
    }
  }

  const messageList = ref<PushMessage[]>([]);
  const loading = ref<boolean>(false);
  const unreadOnly = ref<boolean>(false);

  const formatTime = (iso: string): string => {
    if (iso.length < 16) return iso;
    return `${iso.substring(5, 10)} ${iso.substring(11, 16)}`;
  };

  const fetchMessages = async () => {
    if (loading.value) return;
    loading.value = true;
    try {
      const params = new AppPushMessageListParams();
      params.unreadOnly = unreadOnly.value;
      params.limit = 50;
      const res = await apiVoxMessageList(params);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        const list: PushMessage[] = [];
        for (let i = 0; i < arr.length; i++) {
          const m = arr[i];
          const idVal = m["id"];
          const typeVal = m["messageType"];
          const refVal = m["refId"];
          const titleVal = m["title"];
          const bodyVal = m["body"];
          const readVal = m["read"];
          const timeVal = m["createdAt"];
          list.push(new PushMessage(
            idVal != null ? (idVal as number) : 0,
            typeVal != null ? `${typeVal}` : "",
            refVal != null ? (refVal as number) : 0,
            titleVal != null ? `${titleVal}` : "",
            bodyVal != null ? `${bodyVal}` : "",
            readVal != null ? (readVal as boolean) : false,
            timeVal != null ? `${timeVal}` : "",
          ));
        }
        messageList.value = list;
      } else if (apiResCode(res) != USER_NO_LOGIN && apiResCode(res) != REDIRECT_LOGIN) {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.fetchMessagesFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchMessages error", e);
    } finally {
      loading.value = false;
    }
  };

  const switchUnreadOnly = (next: boolean) => {
    if (next == unreadOnly.value) return;
    unreadOnly.value = next;
    fetchMessages();
  };

  const handleMessageClick = async (item: PushMessage) => {
    if (!item.read) {
      item.read = true; // 乐观更新
      try {
        const res = await apiVoxMarkMessageRead(item.id);
        if (apiResCode(res) != SUCCESS_CODE) {
          item.read = false;
        }
      } catch (e) {
        item.read = false;
        console.error("handleMessageClick markRead error", e);
      }
    }
    if (item.messageType == "meeting_summary" && item.refId > 0) {
      uni.navigateTo({ url: `/subpackages/pages/terminal/terminal-meeting-detail?id=${item.refId}` });
    }
  };

  onLoad((options: any) => {
    setCurrentPageNavigationBarTitle();
  });

  onShow(() => {
    fetchMessages();
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .filter-row {
    display: flex;
    flex-direction: row;
    padding: 24rpx 24rpx 0;

    .filter-chip {
      padding: 12rpx 32rpx;
      border-radius: 28rpx;
      background-color: #ffffff;
      margin-right: 16rpx;

      .filter-chip-text {
        font-size: 26rpx;
        color: #666666;
      }
    }

    .filter-chip-on {
      background-color: rgba(81, 71, 255, 0.1);

      .filter-chip-text-on {
        color: #5147ff;
        font-weight: 600;
      }
    }
  }

  .msg-list {
    padding: 24rpx;
  }

  .msg-card {
    background-color: #ffffff;
    border-radius: 24rpx;
    padding: 28rpx 32rpx;
    margin-bottom: 20rpx;
    display: flex;
    flex-direction: row;
    align-items: flex-start;

    &-active {
      background-color: rgba(12, 20, 102, 0.04);
    }

    .msg-icon {
      width: 72rpx;
      height: 72rpx;
      border-radius: 16rpx;
      background-color: #fafafa;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 20rpx;
      flex-shrink: 0;

      .msg-icon-emoji {
        font-size: 36rpx;
      }
    }

    .msg-body {
      flex: 1;
      overflow: hidden;

      .msg-head {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8rpx;

        .msg-title {
          flex: 1;
          font-size: 28rpx;
          color: #1a1a1a;
          margin-right: 16rpx;
        }

        .msg-title-unread {
          font-weight: 600;
        }

        .msg-time {
          font-size: 22rpx;
          color: #999999;
          flex-shrink: 0;
        }
      }

      .msg-text {
        font-size: 26rpx;
        color: #666666;
        line-height: 1.5;
      }
    }

    .msg-dot {
      width: 16rpx;
      height: 16rpx;
      border-radius: 50%;
      background-color: #dd524d;
      margin-left: 12rpx;
      margin-top: 8rpx;
      flex-shrink: 0;
    }
  }

  .empty-box {
    padding: 80rpx 0;
    display: flex;
    align-items: center;
    justify-content: center;

    .empty-text {
      font-size: 28rpx;
      color: #999999;
    }
  }

  .bottom-space {
    height: 40rpx;
  }
</style>
