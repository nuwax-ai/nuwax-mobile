// #ifdef APP-ANDROID
import ViewTreeObserver from "android.view.ViewTreeObserver";
import View from "android.view.View";
// #endif

/**
 * 翻页头部插入的阅读位置守卫（微信式锚定）：数据 merge 前安装，锚点行视口相对位置恒定。
 * 校正时机与滚动读写按平台分流：
 * - Android：onPreDraw 绘制前原生补偿（零闪烁）。原生视图 UniScrollerView 系 DCloud
 *   NestedScrollView（标准 mScrollY 滚动），getScrollY/scrollTo 同帧同步生效；勿改回
 *   uni 元素 scrollTop 属性读写（桥接异步，曾致补偿打折、视口落在加载页中间）。
 * - iOS：16ms timer 帧循环 + 元素 scrollTop。原生通道（UIScrollView.contentOffset
 *   直读写）在 HX 5.15 uts→Swift 编译下不可达：CGFloat↔number(NSNumber) 无桥接、
 *   带标签调用/构造（CGPoint(x:y:)、setContentOffset(_:animated:)）报 missing
 *   argument label，插件三轮编译实锤（2026-10-24），已弃。元素写桥接异步落位由
 *   settling 循环等待 readY 追平，天然容忍。
 * - H5/WEB：rAF 轮询 + 元素 scrollTop。
 * - 鸿蒙：元素级 scrollTo/scrollTop 无实现且页面模板捕获已顶 255 硬限（不可绑
 *   scroll-top 属性），返回 null 由调用方走 scroll-into-view settle 兜底（顶部对齐，
 *   误差≤upper-threshold；后续若放开捕获预算可升级 getHarmonyController 原生通道）。
 * 收工=measurement-driven 三条件（见过布局变化+drift 两拍稳+高度三拍稳，见
 * startFrameAnchorLoop），覆盖图片/文件等异步高度变化；静默看门狗+5s 绝对兜底。
 */

// #ifdef APP-ANDROID
/** 在原生布局完成、第一帧绘制之前补偿头部插入，避免先显示新页再跳回。 */
class PrependDrawAnchor implements ViewTreeObserver.OnPreDrawListener {
  body: UniElement;
  anchor: UniElement;
  view: View;
  observer: ViewTreeObserver;
  offset0: number;
  timer: number = 0;
  stopped: boolean = false;
  done: ((reason: string) => void) | null = null;

  constructor(body: UniElement, anchor: UniElement, view: View, observer: ViewTreeObserver) {
    this.body = body;
    this.anchor = anchor;
    this.view = view;
    this.observer = observer;
    // 锚点内容偏移基线（原生 scrollY 为当前真值，读取同步）。
    this.offset0 = this.anchorTop() + this.view.getScrollY();
  }

  /** 锚点距视口顶偏移（不含滚动量）。 */
  anchorTop(): number {
    return this.anchor.getBoundingClientRect().top - this.body.getBoundingClientRect().top;
  }

  stop(): void {
    if (this.stopped) return;
    this.stopped = true;
    if (this.observer.isAlive()) this.observer.removeOnPreDrawListener(this);
    if (this.timer != 0) {
      clearTimeout(this.timer);
      this.timer = 0;
    }
    const cb = this.done;
    if (cb != null) cb("android");
  }

  override onPreDraw(): boolean {
    if (this.stopped) return true;
    const cur = this.anchorTop() + this.view.getScrollY();
    const delta = cur - this.offset0;
    if (Math.abs(delta) < 0.5) return true;
    // 基线重定到实测值：补偿后内容偏移即为其，后续绘制 delta 归零（用户滚动不改变
    // 内容偏移，不会被对抗；只有布局变化才会）。原生 scrollTo 同帧生效，下次绘制
    // 直接呈现保留的位置。提示浮层与消息插入可能分两次布局，持续到窗口结束。
    this.offset0 = cur;
    this.view.scrollTo(0, Math.max(0, this.view.getScrollY() + delta).toInt());
    this.view.invalidate();
    return false;
  }
}
// #endif

/**
 * 帧循环守卫（iOS/H5 共用，业务算法与 Android onPreDraw 分支同构）：
 * 不变量=锚点「内容偏移」（anchorTop + 滚动值）——用户滚动不改变内容偏移故不与用户对抗，
 * 头部插入等布局变化使其抬升即触发校正（滚动值 += 抬升量，锚点回到原视口位置）。
 * 统一测量快照：每 tick 每个量只读一次、顺序固定（bodyRect→anchorRect→contentHeight→
 * scrollTop），杜绝同拍内新旧快照混算（bTop 理论恒定，参与 anchorTop 计算）。
 * 收工三条件（measurement-driven，非时间驱动）：已观测到布局变化（内容高变或
 * drift 越阈——纯滚动两值皆不变故不误置）+ drift 连续两拍 <0.5 + 锚点高/内容高
 * 连续三拍 <0.5 且非 settling。
 * ★停摆感知（2026-10-25 iOS 日志实锤：20 行 prepend 布局阻塞主线程 ~1s，1000ms
 * 硬窗在校正开始前被吃光=「有时准有时不准」主因）：改静默看门狗——sawLayout 后
 * 1s 无任何活动（测量无变化且非 settling）才收工；停摆恢复首拍见变化即重置。
 * ★补拍风暴过滤：主线程停摆积压的 timer 恢复后连发（实测 3 tick/1ms），同拍冻结
 * 快照会凑出假稳定（GIF 回落等迟到布局被漏补 ~40px）——相邻 tick 间隔 <8ms 不
 * 累计 stable/heightStable，写入/settling 照常。绝对兜底 5s（防泄漏保险，非方案）。
 * 写入落位等待（settling）：写后须等 readY 追上写入值才能继续判漂移/判稳，防桥接
 * 异步生效窗口内重复补偿。
 * 调度层适配（本函数唯一平台差异）：iOS uts 模块上下文无 requestAnimationFrame
 * （官方支持表 uniUtsPlugin:"x"，2026-10-24 真机安装期抛错实锤）⇒ 16ms setTimeout
 * 自链（iOS 4.11 起可用）；H5/WEB 维持 rAF（对齐重绘时机）。
 */
function startFrameAnchorLoop(
  body: UniElement,
  anchor: UniElement,
  readY: () => number,
  writeY: (y: number) => void,
  onDone: ((reason: string) => void) | null,
): () => void {
  // 安装期快照（prepend 前真值，基线）。
  const bodyRect0 = body.getBoundingClientRect();
  const anchorRect0 = anchor.getBoundingClientRect();
  const aTop0 = anchorRect0.top - bodyRect0.top;
  const aH0 = anchorRect0.height;
  const cH0 = body.scrollHeight;
  const y0 = readY();
  let target = aTop0 + y0;
  const startAt = Date.now();
  let lastTickAt = startAt;
  let lastActivityAt = startAt;
  let taskId = 0;
  let stable = 0;
  let heightStable = 0;
  let sawLayout = false;
  let settling = false;
  let lastWriteY = 0;
  let stopped = false;
  let prevAH = aH0;
  let prevCH = cH0;
  let prevY = y0;
  // 调度器默认 timer 自链（iOS 通道）；H5/WEB 覆写为 rAF。均为「下一拍」语义，业务无感。
  let scheduleTick: (fn: () => void) => number = (fn: () => void): number => {
    return setTimeout(fn, 16);
  };
  let cancelTick: (id: number) => void = (id: number): void => {
    if (id != 0) clearTimeout(id);
  };
  // #ifdef H5 || WEB
  scheduleTick = (fn: () => void): number => {
    return requestAnimationFrame(fn);
  };
  cancelTick = (id: number): void => {
    if (id != 0) cancelAnimationFrame(id);
  };
  // #endif
  const stop = (reason: string): void => {
    if (stopped) return;
    stopped = true;
    cancelTick(taskId);
    taskId = 0;
    if (onDone != null) onDone(reason);
  };
  const tick = (): void => {
    if (stopped) return;
    // 统一快照：每量单读、序固定，本拍全部运算只用这份。
    const now = Date.now();
    const burst = now - lastTickAt < 8;
    lastTickAt = now;
    const bTop = body.getBoundingClientRect().top;
    const aRect = anchor.getBoundingClientRect();
    const aTop = aRect.top - bTop;
    const aH = aRect.height;
    const cH = body.scrollHeight;
    const y = readY();
    const cur = aTop + y;
    const drift = cur - target;
    if (!sawLayout && (Math.abs(cH - cH0) >= 0.5 || Math.abs(drift) >= 0.5)) {
      sawLayout = true;
    }
    // 补拍风暴（<8ms 积压连发）测的是同拍冻结快照，不计稳定拍；变化照常归零。
    const heightSame = Math.abs(aH - prevAH) < 0.5 && Math.abs(cH - prevCH) < 0.5;
    if (heightSame) {
      if (!burst) heightStable++;
    } else {
      heightStable = 0;
    }
    const changed = !heightSame || Math.abs(y - prevY) >= 0.5;
    prevAH = aH;
    prevCH = cH;
    prevY = y;
    if (changed || settling) {
      lastActivityAt = now;
    }
    // 静默看门狗/绝对兜底（先测后判：停摆恢复首拍若见变化已在上面重置看门狗）。
    if (now - startAt >= 5000) {
      stop("abs");
      return;
    }
    if (sawLayout && settling != true && now - lastActivityAt >= 1000) {
      stop("idle");
      return;
    }
    if (settling) {
      // 上次写入尚未被滚动回调反映：等落位（期间不判漂移，防重复补偿）。
      if (Math.abs(y - lastWriteY) >= 0.5) {
        stable = 0;
        taskId = scheduleTick(tick);
        return;
      }
      settling = false;
    }
    if (Math.abs(drift) < 0.5) {
      // 收工须三条件齐备：见过布局变化（防布局前误判稳）+ drift 两拍稳（真拍）+ 高度三拍稳。
      if (!burst) stable++;
      if (sawLayout && stable >= 2 && heightStable >= 3) {
        stop("stable");
        return;
      }
    } else {
      stable = 0;
      settling = true;
      // 基线重定到写入后的内容偏移；写入目标 = 当前滚动 + 抬升量。
      target = cur;
      lastWriteY = Math.max(0, y + drift);
      writeY(lastWriteY);
      lastActivityAt = Date.now();
    }
    taskId = scheduleTick(tick);
  };
  taskId = scheduleTick(tick);
  setTimeout((): void => {
    stop("abs");
  }, 5000);
  // 外部取消也归一走 stop（onDone 恰好一次，stopped 幂等守卫）。
  return (): void => {
    stop("cancel");
  };
}

/**
 * 强制把目标行落到滚动区顶部（仅 Android 原生通道；其它端返回 false，由调用方继续
 * 依赖 scroll-into-view 重设）。
 *
 * ★为什么需要：`scroll-into-view` 依赖框架属性下发 + 原生布局，页面「从子页返回」
 * 的时序里会被框架恢复的旧滚动位置吃掉（命中日志正常、列表一动不动）。这里按两元素
 * 的 rect 差换算成原生 scrollY 直接落位（同 PrependDrawAnchor 的通道：UniScrollerView
 * 系 NestedScrollView，getScrollY/scrollTo 同帧同步生效），一发到位且不依赖模板
 * `scroll-top` 绑定（页面捕获已顶 255 硬限）。
 */
export function forceScrollToElement(bodyId: string, targetId: string): boolean {
  // #ifdef APP-ANDROID
  const body = uni.getElementById(bodyId);
  const target = uni.getElementById(targetId);
  if (body == null || target == null) return false;
  const view = body.getAndroidView();
  if (view == null) return false;
  const delta = target.getBoundingClientRect().top - body.getBoundingClientRect().top;
  const y = view.getScrollY() + delta;
  view.scrollTo(0, Math.max(0, y).toInt());
  view.invalidate();
  return true;
  // #endif
  // #ifndef APP-ANDROID
  return false;
  // #endif
}

export function preserveImPrependAnchor(
  bodyId: string,
  anchorId: string,
  onDone: ((reason: string) => void) | null = null,
): (() => void) | null {
  // #ifdef APP-ANDROID
  const body = uni.getElementById(bodyId);
  const anchor = uni.getElementById(anchorId);
  if (body == null || anchor == null) return null;
  const view = body.getAndroidView();
  if (view == null) return null;
  const observer = view.getViewTreeObserver();
  const guard = new PrependDrawAnchor(body, anchor, view, observer);
  guard.done = onDone;
  observer.addOnPreDrawListener(guard);
  // 无新增记录、请求结果重复等路径同样释放监听。
  guard.timer = setTimeout((): void => {
    guard.stop();
  }, 1000);
  return (): void => {
    guard.stop();
  };
  // #endif
  // #ifdef APP-IOS || H5 || WEB
  const scBody = uni.getElementById(bodyId);
  const scAnchor = uni.getElementById(anchorId);
  if (scBody != null && scAnchor != null) {
    // iOS/H5 同一元素 scrollTop 通道（差异仅在调度器：iOS timer / H5 rAF，见
    // startFrameAnchorLoop）。iOS 元素 scrollTop 与原生 contentOffset 双向同步，
    // 写入经桥接异步落位——settling 循环等 readY 追平写入值再判漂移，天然容忍。
    return startFrameAnchorLoop(
      scBody,
      scAnchor,
      (): number => scBody.scrollTop,
      (y: number): void => {
        scBody.scrollTop = y;
      },
      onDone,
    );
  }
  // #endif
  return null;
}
