<template>
  <!-- 智能体单聊合规提示：输入坞下居中小字，随坞一起让位平移（不入消息流）。
       零绑定挂载——状态读模块级 ref（im-notice-bar 同款写法），原因见 utils/chatAiHint.uts。
       高度 0 → 22px 带 180ms 过渡：对端是否智能体要等异步回包，文案晚到时以滑出代替硬顶，
       且非智能体会话高度恒为 0、不多占一行。 -->
  <view class="chat-ai-hint" :class="{ 'chat-ai-hint--on': visible }">
    <text class="chat-ai-hint__text">{{ t("Mobile.Message.aiContentHint") }}</text>
  </view>
</template>

<script lang="uts" setup>
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { aiContentHintVisible } from "@/utils/chatAiHint.uts";

  /** 模块级 ref 直接取别名（勿包 computed）：im-notice-bar 已验证「模板直读模块 ref、
     页面侧写入即重渲」，多套一层 computed 无收益且多一条待验路径。 */
  const visible = aiContentHintVisible;
  /** 文案在模板里逐渲染取（与 chat.uvue 的 t 同款），不缓存：语言包/文案更新即刻生效。 */
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
</script>

<style lang="scss" scoped>
  /* 槽高 22 = 文字行高 16 + 上下呼吸 6（与原 padding 2/4 的视觉一致）。
     收起态 height: 0 + overflow: hidden 把文字裁掉，节点常驻才能走高度过渡。 */
  .chat-ai-hint {
    height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition-property: height;
    transition-duration: 180ms;
    transition-timing-function: cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  .chat-ai-hint--on {
    height: 22px;
  }

  /* 与 foot__text 同灰的小字 */
  .chat-ai-hint__text {
    text-align: center;
    font-size: 11px;
    line-height: 16px;
    color: #b0aebc;
  }
</style>
