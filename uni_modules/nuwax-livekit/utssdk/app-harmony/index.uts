import { buildMeetingMount, MeetingStageMount, MeetingStageSession, meetingAsset } from "./MeetingStage.ets";
export { EntryVoipBackgroundTask } from "./EntryVoipBackgroundTask.ets";
import { Want } from "@kit.AbilityKit";

export function isSupported(): boolean {
  try {
    const context = UTSHarmony.getUIAbilityContext();
    return context != null && context.resourceManager.getRawFileContentSync(meetingAsset).length > 0;
  } catch (_error) {
    return false;
  }
}

export function bindMeetingStage(element: UniNativeViewElement, pipLabel: string): number {
  const context = UTSHarmony.getUIAbilityContext();
  if (context == null || !isSupported()) return 0;
  const mount = MeetingStageSession.attach(context, pipLabel);
  element.bindHarmonyWrappedBuilder(wrapBuilder<[MeetingStageMount]>(buildMeetingMount), mount);
  return mount.id;
}

export function releaseMeetingStage(id: number): boolean {
  return MeetingStageSession.releaseView(id);
}

export function connect(serverUrl: string, token: string, _room: string, _displayName: string, _micOn: boolean, _cameraOn: boolean): void {
  MeetingStageSession.connect(serverUrl, token);
}

export function disconnectConfirmed(): Promise<boolean> {
  const leaving = MeetingStageSession.disconnect();
  MeetingStageSession.releaseIdleHost();
  return leaving;
}

export function disconnect(): void { void disconnectConfirmed(); }
export function lastError(): string { return MeetingStageSession.error; }
export function isConnected(): boolean { return MeetingStageSession.isConnected(); }
export function setMicEnabled(on: boolean): void { MeetingStageSession.control("mic", on); }
export function setCameraEnabled(on: boolean): void { MeetingStageSession.control("camera", on); }
export function setSpeakerEnabled(on: boolean): void { MeetingStageSession.control("speaker", on); }
export function switchCamera(): void { MeetingStageSession.control("flip"); }
export function isMicEnabled(): boolean { return MeetingStageSession.mic; }
export function isCameraEnabled(): boolean { return MeetingStageSession.camera; }
export function isSpeakerEnabled(): boolean { return MeetingStageSession.speaker; }
export function isRemoteScreenVisible(): boolean { return MeetingStageSession.shared; }
export function isScreenCaptureSupported(): boolean { return MeetingStageSession.host?.screenSupported == true; }
export function isAwaitingScreenCapture(): boolean { return MeetingStageSession.awaitingCapture; }
export function consumeMeetingControlError(): string {
  const error = MeetingStageSession.controlError;
  MeetingStageSession.controlError = "";
  return error;
}
export function remoteVideoIdentities(): string { return MeetingStageSession.videos; }
export function localAudioLevel(): number { return MeetingStageSession.level; }
export function sdkVersion(): string { return "arkweb-livekit-js"; }
export function participantCount(): number { return MeetingStageSession.people; }
export function roomMetadata(): string { return MeetingStageSession.metadata; }
export function setHandRaised(on: boolean): void { MeetingStageSession.control("hand", on); }
export function localHandRaised(): boolean { return MeetingStageSession.raised; }
export function sendMeetingMessage(text: string, displayName: string, danmaku: boolean): void {
  MeetingStageSession.sendMessage(text, displayName, danmaku);
}
export function drainMeetingMessages(): string {
  return JSON.stringify(MeetingStageSession.messages.splice(0));
}
// 会议页单独按挂载 ID 释放自己的视图，避免旧页面卸载时影响已经恢复的会场。
export function releaseMeetingPageViews(): void {}

// 应用内最小化复用 ArkWeb 节点，系统浮窗接口保留给对应平台。
export function configureBackgroundSession(_releaseURL: string, _token: string): void {}
export function setMeetingPresentation(_pageVisible: boolean, foreground: boolean): void {
  MeetingStageSession.setAppForeground(foreground);
}
export function handleMeetingBackgroundWant(want: Want): void {
  MeetingStageSession.handleBackgroundWant(want);
}
export function consumeMeetingRestoreRequest(): boolean { return MeetingStageSession.consumeRestoreRequest(); }
export function isScreenShareStopping(): boolean { return MeetingStageSession.isShareReleaseRunning(); }
export function requestScreenShare(): void {}
export function prepareScreenCapture(label: string, cancelLabel: string, releaseURL: string, seatToken: string): boolean {
  return MeetingStageSession.prepareShare(label, cancelLabel, releaseURL, seatToken);
}
export function stopScreenShare(): void { MeetingStageSession.stopShare(); }
export function isScreenShareOn(): boolean { return MeetingStageSession.sharing; }
export function screenShareError(): string { return MeetingStageSession.shareError; }

// 鸿蒙使用单个 ArkWeb 舞台，Android/iOS 的独立视频视图接口仍保留。
export function createVideoView(): any { return null; }
export function attachLocalVideo(): void {}
export function releaseVideoView(): void {}
export function createRemoteVideoView(_identity: string): any { return null; }
