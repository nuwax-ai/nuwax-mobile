<template>
  <view class="tool-call-group">
    <view class="tool-call-group__header" @tap="toggleExpanded">
      <text class="tool-call-group__title">{{ title }}</text>
      <view class="tool-call-group__summary">
        <text class="tool-call-group__count">{{ visibleCount }} 项</text>
        <svg-icon
          name="icon-a-Chevrondown"
          size="24"
          :customClass="isExpanded ? 'tool-call-group__arrow tool-call-group__arrow--expanded' : 'tool-call-group__arrow'"
        />
      </view>
    </view>
    <view v-if="isExpanded" class="tool-call-group__content">
      <slot />
    </view>
  </view>
</template>

<script setup lang="uts">
  const props = withDefaults(
    defineProps<{
      /** 分组内解析后的工具标签。 */
      items?: any[];
      /** 分组标题。 */
      title?: string;
    }>(),
    {
      items: (): any[] => [] as any[],
      title: "工具调用",
    },
  );

  const isExpanded = ref<boolean>(false);

  /** 排除不展示的 Event 类型后计算数量。 */
  const visibleCount = computed((): number => {
    let count = 0;
    const list = props.items;
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      if (item == null) continue;
      const obj = item as UTSJSONObject;
      const type = obj["type"];
      if (type == null || `${type}` != "Event") {
        count++;
      }
    }
    return count;
  });

  function toggleExpanded(): void {
    isExpanded.value = !isExpanded.value;
  }
</script>

<style lang="scss" scoped>
  .tool-call-group {
    width: 100%;
    margin: 16rpx 0;
    border: 1rpx solid rgba(28, 31, 40, 0.1);
    border-radius: 16rpx;
    background-color: #ffffff;
    overflow: hidden;

    &__header {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      // 与 tool-call-card__main / plan-header 同高
      min-height: 72rpx;
      padding: 0 20rpx;
      box-sizing: border-box;
      background-color: rgba(18, 23, 43, 0.018);
    }

    &__title {
      color: #33363d;
      font-size: 28rpx;
      line-height: 40rpx;
    }

    &__summary {
      display: flex;
      flex-direction: row;
      align-items: center;
    }

    &__count {
      margin-right: 10rpx;
      color: #8b8e96;
      font-size: 24rpx;
      line-height: 34rpx;
    }

    &__arrow {
      color: #8b8e96;
      font-size: 24rpx;
      transition: transform 0.2s ease;

      &--expanded {
        transform: rotate(180deg);
      }
    }

    &__content {
      padding: 10rpx 20rpx 14rpx;
      border-top: 1rpx solid rgba(28, 31, 40, 0.07);
      box-sizing: border-box;
    }
  }
</style>
