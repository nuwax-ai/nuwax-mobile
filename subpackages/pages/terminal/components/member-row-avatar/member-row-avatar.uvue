<template>
  <view :class="isCandidate ? 'row-avatar row-avatar-add' : 'row-avatar'">
    <image
      v-if="displaySrc.length > 0"
      class="row-avatar-img"
      :src="displaySrc"
      mode="aspectFill"
      :fade-show="false"
    />
    <text v-else-if="isCandidate && !hasIconUrl" class="row-avatar-plus">+</text>
    <text v-else-if="!hasIconUrl" class="row-avatar-emoji">{{ icon != "" ? icon : "🤖" }}</text>
  </view>
</template>

<script setup lang="uts">
  import { ref, watch } from "vue";
  import { resolveAppSvgUrl } from "@/utils/remoteSvgImage";

  /**
   * 组员 / 候选行头像。
   *
   * 单独抽成组件是为了「按需解析」：远程 SVG 在 App 端需按容器尺寸解析为 data URL
   * （见 utils/remoteSvgImage），若在页面里一次性 await 全量解析，列表数据量大时会
   * 发出成百上千个请求并阻塞列表渲染。放到行组件内解析后，配合 list-view 的可见区
   * 复用，只有真正出现在屏幕上的行才会触发解析。
   */

  const ICON_RPX = 72;

  interface MemberRowAvatarProps {
    /** 原始 icon：可能是图片 URL，也可能是 emoji / 空串 */
    icon : string;
    /** 候选行（非组员）：无图片时展示「+」而非 emoji */
    isCandidate : boolean;
  }

  const props = defineProps<MemberRowAvatarProps>();

  /** icon 是否为图片 URL（否则按 emoji / 占位文本渲染） */
  const isIconUrl = (icon : string) : boolean => {
    if (icon == "") return false;
    return icon.indexOf("http://") == 0 || icon.indexOf("https://") == 0 || icon.indexOf("/") == 0;
  };

  /** 远程 SVG 需解析后才能正确显示，解析前不给 src，避免先渲染出被裁切放大的原图 */
  const isSvgUrl = (icon : string) : boolean => {
    const lower = icon.toLowerCase();
    return lower.endsWith(".svg") || lower.includes(".svg?");
  };

  const hasIconUrl = ref<boolean>(isIconUrl(props.icon));
  const displaySrc = ref<string>("");
  /** 异步解析竞态序号：列表复用时旧解析结果不得覆盖新目标 */
  let resolveSeq = 0;

  const applyIcon = (icon : string) : void => {
    const seq = ++resolveSeq;
    hasIconUrl.value = isIconUrl(icon);
    if (!hasIconUrl.value) {
      displaySrc.value = "";
      return;
    }
    displaySrc.value = isSvgUrl(icon) ? "" : icon;
    resolveAppSvgUrl(icon, ICON_RPX, ICON_RPX).then((resolved : string) => {
      if (seq == resolveSeq) {
        displaySrc.value = resolved;
      }
    });
  };

  applyIcon(props.icon);

  watch(
    () : string => props.icon,
    (icon : string) => {
      applyIcon(icon);
    },
  );
</script>

<style lang="scss" scoped>
  .row-avatar {
    width: 72rpx;
    height: 72rpx;
    border-radius: 12rpx;
    background-color: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 24rpx;
    flex-shrink: 0;
    overflow: hidden;
  }

  .row-avatar-img {
    width: 72rpx;
    height: 72rpx;
  }

  .row-avatar-emoji {
    font-size: 36rpx;
  }

  .row-avatar-plus {
    font-size: 40rpx;
    color: #999999;
  }
</style>
