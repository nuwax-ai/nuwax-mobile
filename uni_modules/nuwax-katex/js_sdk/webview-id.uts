/**
 * nuwax-katex：web-view 唯一 id 分配器。
 *
 * 背景：组件 <script setup> 里的顶层 let 是「每实例重新初始化」的（编译为 setup 函数内的局部变量），
 * 若在组件里直接 `let seq = 0; webviewId = 'nk-katex-' + (++seq)`，每个实例都会得到 'nk-katex-1'，
 * 所有公式的 web-view 共用同一个 id → uni.createWebviewContext(id) 永远只命中其中一个 web-view，
 * evalJS 更新会串台（tex 变化时其它公式不更新 / 更新错位）。
 *
 * 这里把计数器放到 uts 模块顶层：模块顶层状态是应用级单例（编译为 Kotlin 顶层变量），
 * 跨组件实例递增，保证每个公式的 web-view id 唯一。
 */
let seq = 0

/** 生成下一个唯一 web-view id */
export function nextWebviewId(): string {
	seq = seq + 1
	return 'nk-katex-' + seq
}
