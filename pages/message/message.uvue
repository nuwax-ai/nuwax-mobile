  page {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  /* #endif */
  /* #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || MP-LARK || MP-KUAISHOU || MP-JD */
