/**
 * SSE 干预数据适配器
 * 从 SSE chunk 中提取 ACP Permission 和 MCP Ask 数据
 * 对齐 nuwax Web 版 applyAcpPermissionSseEvent + applyMcpAskToolCallSseEvent
 */
import {
  AcpPermissionInteraction,
  AcpPermissionOption,
  AcpPermissionOptionKind,
  AcpPermissionRequest,
  AcpToolCallInfo,
  McpAskInteraction,
} from "@/types/intervention";
import {
  createMcpAskInteractionFromToolInput,
  extractMcpAskStructuredInputFromResult,
  parseMcpAskToolInput,
} from "@/utils/mcpAskSchema.uts";
import {
  firstNullableString,
  orEmpty,
  orString,
} from "@/utils/utsCoalesce.uts";
import { readRawField } from "@/utils/readRawField.uts";

/** SSE 事件 data 载荷（仅文档说明；运行时实际是 UTSJSONObject，禁止 as 强转，一律 readRawField 读取）
 * 字段参考：id / ext
 * SSE chunk 结构参考：messageType / message_type / subType / sub_type / eventType / data
 */

function nonEmpty(value: any | null): any | null {
  if (
    value != null &&
    typeof value == "object" &&
    !Array.isArray(value)
  ) {
    return value;
  }
  return null;
}

function firstValue(value: any | null, fallback: any | null): any | null {
  return value != null ? value : fallback;
}

function getMcpAskRawInput(chunk: any): any | null {
  const rawData = chunk as any;
  const envelope = parseSseEventEnvelope(chunk);
  const data = extractEventData(envelope, chunk);
  const ext = readRawField(data, "ext");
  const result = firstValue(
    readRawField(data, "result"),
    readRawField(rawData, "result"),
  );
  const candidates = [
    result != null ? extractMcpAskStructuredInputFromResult(result) : null,
    readRawField(data, "rawInput"),
    readRawField(data, "raw_input"),
    readRawField(ext, "rawInput"),
    readRawField(ext, "raw_input"),
    readRawField(result, "input"),
    readRawField(result, "rawInput"),
    readRawField(result, "raw_input"),
    readRawField(rawData, "rawInput"),
    readRawField(rawData, "raw_input"),
  ];
  for (let i = 0; i < candidates.length; i++) {
    const value = nonEmpty(candidates[i]);
    if (value != null) {
      return value;
    }
  }
  return null;
}

function parseSseEventEnvelope(chunk: any): any {
  const nested = readRawField(chunk, "data");
  if (
    nested != null &&
    typeof nested == "object" &&
    (readRawField(nested, "messageType") != null ||
      readRawField(nested, "message_type") != null ||
      readRawField(nested, "subType") != null ||
      readRawField(nested, "sub_type") != null ||
      readRawField(nested, "subEventType") != null)
  ) {
    return nested;
  }
  return chunk;
}

function extractEventData(envelope: any, fallback: any): any {
  const inner = readRawField(envelope, "data");
  if (inner != null && typeof inner == "object") return inner;
  const fallbackData = readRawField(fallback, "data");
  if (fallbackData != null && typeof fallbackData == "object") return fallbackData;
  return fallback;
}

function getToolCallId(chunk: any): string {
  const rawData = chunk as any;
  const envelope = parseSseEventEnvelope(chunk);
  const data = extractEventData(envelope, chunk);
  const result = firstValue(
    readRawField(data, "result"),
    readRawField(rawData, "result"),
  );
  return firstNullableString([
    readRawField(data, "tool_call_id"),
    readRawField(data, "toolCallId"),
    readRawField(data, "executeId"),
    readRawField(result, "executeId"),
    readRawField(result, "toolCallId"),
    readRawField(result, "tool_call_id"),
    readRawField(rawData, "tool_call_id"),
    readRawField(rawData, "toolCallId"),
    readRawField(rawData, "executeId"),
  ]);
}

/**
 * 判断是否为 ACP Permission 事件
 * 对齐 backend SandboxAgentClient.isAcpPermissionEvent() 的识别逻辑
 */
export function isAcpPermissionEvent(chunk: any): boolean {
  const envelope = parseSseEventEnvelope(chunk);
  const messageType = firstNullableString([
    readRawField(envelope, "messageType"),
    readRawField(envelope, "message_type"),
  ]);
  const subType = firstNullableString([
    readRawField(envelope, "subType"),
    readRawField(envelope, "sub_type"),
  ]);
  const eventType = firstNullableString([
    readRawField(chunk, "eventType"),
    readRawField(envelope, "eventType"),
  ]);
  const data = extractEventData(envelope, chunk);
  const result = readRawField(data, "result");
  const processingInput = readRawField(result, "input");

  if (eventType == "ACP_REQUEST_PERMISSION") {
    return true;
  }
  if (
    eventType == "PROCESSING" &&
    (readRawField(data, "subEventType") == "REQUEST_PERMISSION" ||
      readRawField(processingInput, "request_permission_request") != null)
  ) {
    return true;
  }

  // 直接匹配 messageType
  if (messageType == "acpRequestPermission") {
    return true;
  }
  // 匹配 subType
  if (subType == "request_permission" || subType == "AcpRequestPermission") {
    return true;
  }
  return false;
}

/**
 * 判断是否为 MCP Ask tool_call 事件
 * 对齐 nuwax Web 版 applyMcpAskToolCallSseEvent 的识别逻辑
 */
export function isMcpAskToolCallEvent(chunk: any): boolean {
  const envelope = parseSseEventEnvelope(chunk);
  const subType = firstNullableString([
    readRawField(envelope, "subType"),
    readRawField(envelope, "sub_type"),
  ]);
  const messageType = firstNullableString([
    readRawField(envelope, "messageType"),
    readRawField(envelope, "message_type"),
  ]);
  const eventType = firstNullableString([
    readRawField(chunk, "eventType"),
    readRawField(envelope, "eventType"),
  ]);
  const data = extractEventData(envelope, chunk);
  const result = readRawField(data, "result");
  const isToolCallLike =
    subType == "tool_call" ||
    subType == "tool_call_update" ||
    messageType == "tool_call" ||
    readRawField(data, "tool_call_id") != null ||
    readRawField(data, "toolCallId") != null ||
    readRawField(data, "executeId") != null ||
    readRawField(result, "executeId") != null;

  // 对齐 Web applyMcpAskToolCallSseEvent：Sandbox PROCESSING ToolCall 事件
  const isProcessingToolCallEvent =
    eventType == "PROCESSING" &&
    (readRawField(data, "executeId") != null ||
      readRawField(result, "executeId") != null ||
      readRawField(result, "input") != null ||
      (result != null && extractMcpAskStructuredInputFromResult(result) != null));

  // 识别 subEventType=ASK_QUESTION 的 PROCESSING 事件。
  // 此类事件 result.executeId/input 均为 null，MCP Ask 数据在 result.data 中。
  // 对齐 PC：另兼容 name=Backend.Sandbox.Event.AskQuestion / AskQuestion（含 snake_case）。
  const eventSubType = firstNullableString([
    readRawField(data, "subEventType"),
    readRawField(data, "sub_event_type"),
    readRawField(envelope, "subEventType"),
    readRawField(envelope, "sub_event_type"),
  ]);
  const eventName = firstNullableString([
    readRawField(data, "name"),
    readRawField(result, "name"),
  ]);
  const isAskQuestionEvent =
    eventType == "PROCESSING" &&
    (eventSubType == "ASK_QUESTION" ||
      eventName == "Backend.Sandbox.Event.AskQuestion" ||
      eventName == "AskQuestion");

  if (!isToolCallLike && !isProcessingToolCallEvent && !isAskQuestionEvent) {
    return false;
  }

  // ASK_QUESTION 事件：直接从 result.data 提取 MCP Ask 数据
  const resultData = readRawField(result, "data");
  if (isAskQuestionEvent && resultData != null && typeof resultData == "object") {
    return parseMcpAskToolInput(resultData) != null;
  }

  const rawInput = getMcpAskRawInput(chunk);
  if (rawInput == null) return false;

  return parseMcpAskToolInput(rawInput) != null;
}

/**
 * 把 ACP interaction 规范为 UTSJSONObject（bracket / readRawField 可读）。
 *
 * Android 上若直接把 class 实例塞进 MessageInfo，readRawField 读不到字段
 * （表现为 respond 日志 id=/tc= 全空、status matched=0、API toolId=""）。
 * 挂载与审批前必须走本函数。
 */
export function normalizeAcpPermissionInteraction(
  interaction: any,
): UTSJSONObject {
  // 已是可读 UTSJSONObject：有 id 或 toolCallId 则直接深拷贝
  const existingId = orString(readRawField(interaction, "id"), "");
  const existingReq = readRawField(interaction, "request");
  const existingTc = readRawField(existingReq, "toolCall");
  const existingTcId = orString(readRawField(existingTc, "toolCallId"), "");
  if (existingId.length > 0 || existingTcId.length > 0) {
    try {
      return JSON.parse(JSON.stringify(interaction)) as UTSJSONObject;
    } catch (_e) {
      // fallthrough 手工抄字段
    }
  }

  // class 实例路径：as class 包在 try 里（已是 UTSJSONObject 时会 CCE，不能裸转）
  try {
    const typed = interaction as AcpPermissionInteraction;
    const id = orString(typed.id, "");
    if (id.length > 0) {
      const out = new UTSJSONObject();
      out["id"] = id;
      out["responseStatus"] = orString(typed.responseStatus, "pending");
      if (typed.executeId != null && `${typed.executeId}`.length > 0) {
        out["executeId"] = typed.executeId;
      }
      if (typed.triggeredAt != null) {
        out["triggeredAt"] = typed.triggeredAt;
      }
      if (typed.selectedOptionId != null) {
        out["selectedOptionId"] = typed.selectedOptionId;
      }
      if (typed.errorMessage != null) {
        out["errorMessage"] = typed.errorMessage;
      }
      const req = typed.request;
      const reqObj = new UTSJSONObject();
      reqObj["sessionId"] = req != null ? orString(req.sessionId, "") : "";
      const tc = req != null ? req.toolCall : null;
      const tcObj = new UTSJSONObject();
      tcObj["toolCallId"] = tc != null ? orString(tc.toolCallId, "") : "";
      if (tc != null && tc.title != null) {
        tcObj["title"] = tc.title;
      }
      if (tc != null && tc.kind != null) {
        tcObj["kind"] = tc.kind;
      }
      if (tc != null && tc.rawInput != null) {
        tcObj["rawInput"] = tc.rawInput;
      }
      reqObj["toolCall"] = tcObj;
      const optList: UTSJSONObject[] = [];
      const options = req != null ? req.options : null;
      if (options != null) {
        for (let i = 0; i < options.length; i++) {
          const opt = options[i];
          const optObj = new UTSJSONObject();
          optObj["optionId"] = orString(opt.optionId, "");
          optObj["kind"] = orString(opt.kind, "allow_once");
          optObj["name"] = orString(opt.name, "");
          optList.push(optObj);
        }
      }
      reqObj["options"] = optList;
      out["request"] = reqObj;
      return out;
    }
  } catch (_castErr) {
    // 非 class，继续
  }

  // 最后兜底：JSON 深拷贝或空壳
  try {
    const parsed = JSON.parse(JSON.stringify(interaction));
    if (parsed != null) {
      return parsed as UTSJSONObject;
    }
  } catch (_jsonErr) {
    // ignore
  }
  const fallback = new UTSJSONObject();
  fallback["responseStatus"] = "pending";
  if (existingReq != null) {
    fallback["request"] = existingReq;
  }
  return fallback;
}

/**
 * 从 ACP Permission SSE 事件中提取交互数据
 */
export function extractAcpPermissionInteraction(
  chunk: any,
): AcpPermissionInteraction | null {
  if (!isAcpPermissionEvent(chunk)) return null;

  const envelope = parseSseEventEnvelope(chunk);
  const data = extractEventData(envelope, chunk);
  const result = readRawField(data, "result");
  const processingInput = readRawField(result, "input");
  const requestMeta = firstValue(
    readRawField(processingInput, "_meta"),
    readRawField(data, "_meta"),
  );
  const intervention = firstValue(
    readRawField(data, "_intervention"),
    firstValue(
      readRawField(data, "interventionRequest"),
      readRawField(data, "intervention"),
    ),
  );
  const requestPermission = firstValue(
    readRawField(data, "request_permission_request"),
    firstValue(
      readRawField(processingInput, "request_permission_request"),
      readRawField(data, "requestPermissionRequest"),
    ),
  );
  const acp = readRawField(intervention, "acp");
  const request = firstValue(
    requestPermission,
    firstValue(
      readRawField(acp, "request"),
      firstValue(
        readRawField(intervention, "request"),
        firstValue(readRawField(data, "request"), data),
      ),
    ),
  );
  const toolCall = firstValue(
    readRawField(request, "tool_call"),
    firstValue(readRawField(request, "toolCall"), new UTSJSONObject()),
  );
  const optionsRaw = readRawField(request, "options");
  const options = Array.isArray(optionsRaw) ? (optionsRaw as any[]) : ([] as any[]);
  const sessionId = firstNullableString([
    readRawField(request, "session_id"),
    readRawField(request, "sessionId"),
    readRawField(intervention, "sessionId"),
    readRawField(data, "session_id"),
    readRawField(data, "sessionId"),
  ]);
  const toolCallId = firstNullableString([
    readRawField(data, "tool_call_id"),
    readRawField(processingInput, "tool_call_id"),
    readRawField(data, "toolCallId"),
    readRawField(request, "tool_call_id"),
    readRawField(request, "toolCallId"),
    readRawField(toolCall, "tool_call_id"),
    readRawField(toolCall, "toolCallId"),
  ]);
  const executeId = firstNullableString([
    readRawField(data, "executeId"),
    readRawField(result, "executeId"),
    readRawField(processingInput, "executeId"),
  ]);
  // 原始工具输入：用于提取 MCP Ask requestId，对齐 PC readMcpAskRequestId 的双路抑制逻辑
  const toolCallRawInput = firstValue(
    readRawField(toolCall, "rawInput"),
    firstValue(
      readRawField(toolCall, "raw_input"),
      firstValue(
        readRawField(request, "rawInput"),
        firstValue(
          readRawField(request, "raw_input"),
          firstValue(readRawField(request, "input"), processingInput),
        ),
      ),
    ),
  );

  // 稳定 toolCallId：优先真实 tool_call_id，否则回退 executeId。
  // 禁止 Date.now / Math.random —— live 与 sub/PROCESSING 形态若各自生成随机 id，
  // 挂载只按 id 去重会失败，导致同一权限在 FIFO 里出现两次，并长期双路抑制 MCP Ask。
  let stableToolCallId = toolCallId;
  if (stableToolCallId.length == 0 && executeId.length > 0) {
    stableToolCallId = executeId;
  }
  if (stableToolCallId.length == 0) {
    console.warn(
      "[ITV] acp.extract WARN missing toolCallId/executeId；去重与双路抑制可能失效",
    );
  }

  const mappedOptions: AcpPermissionOption[] = [];
  for (let oi = 0; oi < options.length; oi++) {
    const opt = options[oi];
    const optionItem = new AcpPermissionOption();
    optionItem.optionId = firstNullableString([
      readRawField(opt, "option_id"),
      readRawField(opt, "optionId"),
      readRawField(opt, "id") != null ? `${readRawField(opt, "id")}` : "",
    ]);
    optionItem.kind = orString(readRawField(opt, "kind"), "allow_once") as AcpPermissionOptionKind;
    optionItem.name = firstNullableString([
      readRawField(opt, "name"),
      readRawField(opt, "label"),
      readRawField(opt, "kind"),
    ]);
    mappedOptions.push(optionItem);
  }

  const toolCallInfo = new AcpToolCallInfo();
  // 业务字段写入稳定非空值（可为空仅当事件完全缺 tc/executeId）
  toolCallInfo.toolCallId = stableToolCallId;
  toolCallInfo.title = firstNullableString([
    readRawField(request, "title"),
    readRawField(toolCall, "title"),
  ]);
  toolCallInfo.kind = firstNullableString([
    readRawField(request, "kind"),
    readRawField(toolCall, "kind"),
  ]);
  if (toolCallRawInput != null) {
    toolCallInfo.rawInput = toolCallRawInput;
  }

  const permissionRequest = new AcpPermissionRequest();
  permissionRequest.sessionId = sessionId;
  permissionRequest.toolCall = toolCallInfo;
  permissionRequest.options = mappedOptions;

  // id 优先后端真实 intervention id；fallback 用稳定 toolCallId（及可选 session），
  // 不再掺入时间戳/随机串，保证 live 与 sub 重放生成同一逻辑键。
  const serverInterventionId = firstNullableString([
    readRawField(intervention, "id"),
    readRawField(requestMeta, "nuwaclaw_intervention_id"),
    readRawField(request, "id"),
  ]);
  let resolvedId = serverInterventionId;
  if (resolvedId.length == 0) {
    if (stableToolCallId.length > 0) {
      const sessionPart = sessionId.length > 0 ? sessionId : "nosession";
      resolvedId = `itv_${sessionPart}_${stableToolCallId}`;
    } else {
      console.warn(
        "[ITV] acp.extract WARN missing intervention id 且无 toolCallId；无法生成稳定 id",
      );
      resolvedId = "itv_unknown";
    }
  }

  const interaction = new AcpPermissionInteraction();
  interaction.id = resolvedId;
  interaction.request = permissionRequest;
  interaction.responseStatus = "pending";
  // 与 MCP Ask 一致：写 triggeredAt，FIFO 按触发时间排序（避免仅靠扫描序号抖动）
  interaction.triggeredAt = Date.now();
  if (typeof executeId == "string" && executeId.length > 0) {
    interaction.executeId = executeId;
  }
  return interaction;
}

/**
 * 从 MCP Ask tool_call 事件中提取交互数据
 */
export function extractMcpAskInteraction(
  chunk: any,
): McpAskInteraction | null {
  if (!isMcpAskToolCallEvent(chunk)) return null;

  const envelope = parseSseEventEnvelope(chunk);
  const eventType = firstNullableString([
    readRawField(chunk, "eventType"),
    readRawField(envelope, "eventType"),
  ]);

  const data = extractEventData(envelope, chunk);
  const result = readRawField(data, "result");
  // ASK_QUESTION 事件：MCP Ask 数据在 result.data 中，toolCallId 用 result.data.requestId
  // 与 isMcpAskToolCallEvent 同一套 name/subEventType 识别（含 snake_case）
  const eventSubType = firstNullableString([
    readRawField(data, "subEventType"),
    readRawField(data, "sub_event_type"),
    readRawField(envelope, "subEventType"),
    readRawField(envelope, "sub_event_type"),
  ]);
  const eventName = firstNullableString([
    readRawField(data, "name"),
    readRawField(result, "name"),
  ]);
  const isAskQuestion =
    eventType == "PROCESSING" &&
    (eventSubType == "ASK_QUESTION" ||
      eventName == "Backend.Sandbox.Event.AskQuestion" ||
      eventName == "AskQuestion");
  if (isAskQuestion) {
    const resultData = readRawField(result, "data");
    if (resultData != null && typeof resultData == "object") {
      const requestId = orEmpty(readRawField(resultData, "requestId"));
      const toolCallId =
        requestId.length > 0 ? requestId : getToolCallId(chunk);
      return createMcpAskInteractionFromToolInput(resultData, toolCallId);
    }
  }

  const rawInput = getMcpAskRawInput(chunk);
  if (rawInput == null) return null;

  return createMcpAskInteractionFromToolInput(rawInput, getToolCallId(chunk));
}
