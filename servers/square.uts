import { Page, RequestResponse } from '../types/interfaces/request';
import { SquarePublishedListParams, SquarePublishedItemInfo, SquareCategoryInfo } from '../types/interfaces/square';
import { SquareAgentTypeEnum } from '../types/enums/square';
import request from './useRequest';
import { AgentDetailDto } from '../types/interfaces/agent';
import { SUCCESS_CODE } from '../constants/codes.constants';
import { apiResCode, apiResData } from '../utils/apiResponse';

function putNonEmptyString(body: UTSJSONObject, key: string, value: string): void {
  if (value != null && value != "") {
    body[key] = value;
  }
}

function putStringArray(body: UTSJSONObject, key: string, list: string[]): void {
  if (list == null || list.length == 0) {
    return;
  }
  // Android：同一数组引用赋给多个字段时，JSON.stringify 会把后写的字段收成 null，必须拷贝
  const copied: string[] = [] as string[];
  for (let i = 0; i < list.length; i++) {
    copied.push(list[i]);
  }
  body[key] = copied;
}

/**
 * Android：UTS class 经 JSON.stringify 可能丢字段，显式拼 UTSJSONObject。
 */
function buildSquarePublishedListBody(
  data: SquarePublishedListParams,
): UTSJSONObject {
  const body = new UTSJSONObject();
  putNonEmptyString(body, "targetType", data.targetType);
  putStringArray(body, "targetTypes", data.targetTypes);
  putNonEmptyString(body, "targetSubType", data.targetSubType);
  putStringArray(body, "targetSubTypes", data.targetSubTypes);
  putNonEmptyString(body, "scope", data.scope);
  putStringArray(body, "agentTypes", data.agentTypes);
  body["page"] = data.page;
  if (data.lastTimestamp > 0) {
    body["lastTimestamp"] = data.lastTimestamp;
  }
  body["pageSize"] = data.pageSize;
  putNonEmptyString(body, "category", data.category);
  putNonEmptyString(body, "kw", data.kw);
  if (data.spaceId > 0) {
    body["spaceId"] = data.spaceId;
  }
  if (data.justReturnSpaceData == true) {
    body["justReturnSpaceData"] = true;
  }
  if (data.accessControl > 0) {
    body["accessControl"] = data.accessControl;
  }
  if (data.official == true) {
    body["official"] = true;
  }
  putStringArray(body, "usageScenarios", data.usageScenarios);
  const spaceIds = data.spaceIds;
  if (spaceIds != null && spaceIds.length > 0) {
    body["spaceIds"] = spaceIds;
  }
  return body;
}

// 广场-已发布智能体列表接口
export async function apiPublishedAgentList(
  data: SquarePublishedListParams,
): Promise<RequestResponse<Page<SquarePublishedItemInfo>>> {
  const res = await request({
    url: '/api/published/agent/list',
    method: 'POST',
    data: buildSquarePublishedListBody(data),
  });
  return res;
}

