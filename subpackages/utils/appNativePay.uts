import {
  AppNativePayBridge,
  registerAppNativePayBridge,
} from "@/subpackages/utils/paymentUtils.uts";

// #ifdef APP-ANDROID
import {
  launchAnxinfuMiniProgramNative,
  openPayUrlNative,
} from "@/uni_modules/nuwax-android-native-pay";

class AndroidAppNativePayBridge implements AppNativePayBridge {
  launchAnxinfuMiniProgram(options: UTSJSONObject): Promise<any> {
    return launchAnxinfuMiniProgramNative(
      options.getString("userName") ?? "",
      options.getString("path") ?? "",
    );
  }

  openPayUrl(url: string): Promise<any> {
    return openPayUrlNative(url);
  }
}
// #endif

// #ifdef APP-IOS
// uts 编译为 Swift 时 UIKit/Foundation 由引擎自动 import，直接用全局类即可。
// 参考：https://doc.dcloud.net.cn/uni-app-x/plugin/uts-plugin.html

/**
 * iOS 原生支付桥。
 * - 微信支付：当前通过 openURL 兜底（weixin:// scheme），后续接入 WXLaunchMiniProgramReq 后替换。
 * - 支付宝：系统打开后端返回的 redirectUrl（alipays:// 或收银台 https 链接）。
 */
class IosAppNativePayBridge implements AppNativePayBridge {
  launchAnxinfuMiniProgram(options: UTSJSONObject): Promise<any> {
    return new Promise((resolve, reject) => {
      const path = options.getString("path") ?? "";
      const urlStr = `weixin://${path}`;
      const url = NSURL.URLWithString(urlStr);
      if (url == null) {
        reject(new Error("invalid weixin mini-program url"));
        return;
      }
      UIApplication.shared.open(
        url,
        new Map<string, any>(),
        (success: boolean) => {
          if (success) {
            resolve({ errMsg: "openUrl:ok" });
          } else {
            reject(new Error("weixin is not installed or url is blocked"));
          }
        },
      );
    });
  }

  openPayUrl(url: string): Promise<any> {
    return new Promise((resolve, reject) => {
      const target = NSURL.URLWithString(url);
      if (target == null) {
        reject(new Error("invalid alipay url"));
        return;
      }
      UIApplication.shared.open(
        target,
        new Map<string, any>(),
        (success: boolean) => {
          if (success) {
            resolve({ errMsg: "openUrl:ok" });
          } else {
            reject(new Error("alipay is not installed or url is blocked"));
          }
        },
      );
    });
  }
}
// #endif

/** 注册当前 App 平台的原生支付桥，App 启动时调用一次。 */
export function bootstrapAppNativePay(): void {
  // #ifdef APP-ANDROID
  registerAppNativePayBridge(new AndroidAppNativePayBridge());
  // #endif
  // #ifdef APP-IOS
  registerAppNativePayBridge(new IosAppNativePayBridge());
  // #endif
}
