/**
 * 终端设备关联智能体配置 — 群组成员接口
 * 主站 API（API_BASE_URL），非 Vox 设备网关
 *
 * - GET  /api/terminal/agent/group-member/list?agentId=
 * - POST /api/terminal/agent/group-member/add
 */
import request from "@/servers/useRequest";
import type { RequestResponse, VoidRequestResponse } from "@/types/interfaces/request";
import type { GroupMemberAddParams, GroupMemberDto } from "@/types/interfaces/terminalGroupMember";

/**
 * 查询设备宿主智能体下的群组成员列表
 * @param agentId 设备对应的 agentId（宿主）
 */
export async function apiGetGroupMembers(agentId: number): Promise<RequestResponse<GroupMemberDto[]>> {
  const res = await request({
    url: `/api/terminal/agent/group-member/list?agentId=${agentId}`,
    method: "GET",
  });
  return res;
}

/**
 * Android 上自定义 class 序列化会丢字段，显式构造 body
 * @param data 新增参数
 */
function buildAddBody(data: GroupMemberAddParams): UTSJSONObject {
  const body = new UTSJSONObject();
  body["agentId"] = data.agentId;
  body["targetAgentId"] = data.targetAgentId;
  return body;
}

/**
 * 新增群组成员并发布
 * @param data agentId=宿主；targetAgentId=要加入的智能体
 */
export async function apiAddGroupMember(data: GroupMemberAddParams): Promise<VoidRequestResponse> {
  const res = await request({
    url: "/api/terminal/agent/group-member/add",
    method: "POST",
    data: buildAddBody(data),
  });
  return res;
}
