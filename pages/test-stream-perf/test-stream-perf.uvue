<template>
  <view class="tsp-page">
    <view class="tsp-header">
      <text class="tsp-title">会话流式渲染性能测试</text>
      <text class="tsp-sub">复用真实会话详情页（agent-detail），Mock 数据驱动流式，排除网络抖动。开始后在会话页手动发一条消息触发流式；或设 H>0 测长历史冷开/滚动。fps/maxGap 见会话页浮层 + logcat [PerfProbe]/[SseStall]。</text>
    </view>

    <view class="tsp-row">
      <text class="tsp-label">mdType</text>
      <view class="tsp-types">
        <text
          v-for="(t, i) in mdTypes"
          :key="t"
          class="tsp-type-chip"
          :class="i == mdTypeIndex ? 'tsp-type-chip-active' : ''"
          @click="onSelectType(i)"
        >{{ t }}</text>
      </view>
    </view>

    <view class="tsp-row">
      <text class="tsp-label">预置历史 H</text>
      <input class="tsp-num" type="number" :value="historyStr" @input="onHistoryInput" />
    </view>
    <view class="tsp-row">
      <text class="tsp-label">流式字符 L</text>
      <input class="tsp-num" type="number" :value="streamLenStr" @input="onStreamLenInput" />
    </view>
    <view class="tsp-row">
      <text class="tsp-label">chunk 间隔 ms</text>
      <input class="tsp-num" type="number" :value="intervalStr" @input="onIntervalInput" />
    </view>
    <view class="tsp-row">
      <text class="tsp-label">chunk 字符</text>
      <input class="tsp-num" type="number" :value="chunkStr" @input="onChunkInput" />
    </view>

    <button class="tsp-start" type="primary" @click="onStart">开始测试</button>
    <button class="tsp-clear" @click="onClear">清除 Mock 开关</button>
  </view>
</template>

<script lang="uts" setup>
  import { ref } from "vue";
  import {
    applyStreamPerfConfig,
    clearStreamPerfMock,
    PERF_MOCK_MDTYPES,
    PERF_MOCK_DEFAULT_MDTYPE,
    PERF_MOCK_DEFAULT_HISTORY,
    PERF_MOCK_DEFAULT_STREAMLEN,
    PERF_MOCK_DEFAULT_INTERVAL_MS,
    PERF_MOCK_DEFAULT_CHUNK,
  } from "@/subpackages/pages/chat-conversation-component/layers/mockStreamPerf.uts";

  const mdTypes = PERF_MOCK_MDTYPES;

  // UTS：function 须先声明后使用（不提升），mdIndex/parseNum 放到引用前。
  function mdIndex(md: string): number {
    for (let i = 0; i < mdTypes.length; i++) {
      if (mdTypes[i] == md) {
        return i;
      }
    }
    return mdTypes.length - 1;
  }

  function parseNum(s: string, fallback: number): number {
    if (s.length == 0) return fallback;
    const n = parseFloat(s);
    if (n != n) return fallback; // NaN
    return n;
  }

  const mdTypeIndex = ref<number>(mdIndex(PERF_MOCK_DEFAULT_MDTYPE));
  const historyStr = ref<string>(`${PERF_MOCK_DEFAULT_HISTORY}`);
  const streamLenStr = ref<string>(`${PERF_MOCK_DEFAULT_STREAMLEN}`);
  const intervalStr = ref<string>(`${PERF_MOCK_DEFAULT_INTERVAL_MS}`);
  const chunkStr = ref<string>(`${PERF_MOCK_DEFAULT_CHUNK}`);

  const onSelectType = (i: number) => {
    if (i >= 0 && i < mdTypes.length) {
      mdTypeIndex.value = i;
    }
  };

  const onHistoryInput = (e: any) => {
    const detail = (e as UTSJSONObject)["detail"] as UTSJSONObject;
    historyStr.value = `${detail["value"]}`;
  };
  const onStreamLenInput = (e: any) => {
    const detail = (e as UTSJSONObject)["detail"] as UTSJSONObject;
    streamLenStr.value = `${detail["value"]}`;
  };
  const onIntervalInput = (e: any) => {
    const detail = (e as UTSJSONObject)["detail"] as UTSJSONObject;
    intervalStr.value = `${detail["value"]}`;
  };
  const onChunkInput = (e: any) => {
    const detail = (e as UTSJSONObject)["detail"] as UTSJSONObject;
    chunkStr.value = `${detail["value"]}`;
  };

  const onStart = () => {
    const md = mdTypes[mdTypeIndex.value];
    applyStreamPerfConfig(
      md,
      parseNum(historyStr.value, PERF_MOCK_DEFAULT_HISTORY),
      parseNum(streamLenStr.value, PERF_MOCK_DEFAULT_STREAMLEN),
      parseNum(intervalStr.value, PERF_MOCK_DEFAULT_INTERVAL_MS),
      parseNum(chunkStr.value, PERF_MOCK_DEFAULT_CHUNK),
    );
    uni.navigateTo({
      url: "/subpackages/pages/agent-detail/agent-detail?id=perf&conversationId=0",
    });
  };

  const onClear = () => {
    clearStreamPerfMock();
    uni.showToast({ title: "已清除 Mock 开关", icon: "none" });
  };
</script>

<style lang="scss" scoped>
  .tsp-page {
    padding: 24rpx;
  }
  .tsp-header {
    margin-bottom: 24rpx;
  }
  .tsp-title {
    font-size: 36rpx;
    font-weight: 700;
  }
  .tsp-sub {
    font-size: 24rpx;
    color: #888;
    margin-top: 8rpx;
  }
  .tsp-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 20rpx;
  }
  .tsp-label {
    width: 200rpx;
    font-size: 28rpx;
  }
  .tsp-types {
    flex: 1;
    flex-direction: row;
    flex-wrap: wrap;
  }
  .tsp-type-chip {
    padding: 8rpx 20rpx;
    margin: 6rpx 10rpx 6rpx 0;
    font-size: 26rpx;
    color: #555;
    background: #f0f0f0;
    border-radius: 24rpx;
  }
  .tsp-type-chip-active {
    background: #007aff;
    color: #fff;
  }
  .tsp-num {
    flex: 1;
    padding: 12rpx 16rpx;
    background: #f5f5f5;
    border-radius: 8rpx;
    font-size: 28rpx;
  }
  .tsp-start {
    margin-top: 40rpx;
  }
  .tsp-clear {
    margin-top: 20rpx;
  }
</style>
