<template>
  <modal-popup ref="modal" :title="title" :enable-swipe-close="false">
    <template #header-extra>
      <view class="copy-btn" @tap="copy">
        <svg-icon name="icon-CopyOutlined" />
      </view>
    </template>
    <view class="details-content">
      <diff-list-view v-if="diffFiles.length > 0" :files="diffFiles" />
      <template v-else>
        <!-- #ifndef APP -->
        <mp-html
          :content="formattedDetailData"
          :markdown="true"
          :show-header="false"
        ></mp-html>
        <!-- #endif -->
        <!-- #ifdef APP -->
        <text class="details-plain-text">{{ appPlainDetailText }}</text>
        <!-- #endif -->
      </template>
    </view>
  </modal-popup>
</template>

<script lang="uts" setup>
  import { ref, computed } from "vue";
  import { t } from "@/utils/i18n";
  import modalPopup from "@/components/modal-popup/modal-popup.uvue";
  // #ifndef APP
  import mpHtml from "@/subpackages/uni_modules/mp-html/components/mp-html/mp-html.uvue";
  // #endif
  import DiffListView from "@/components/diff-list-view/diff-list-view.uvue";

  // 定义组件属性
  const props = withDefaults(
    defineProps<{
      title?: string;
      detailData?: any;
    }>(),
    {
      title: "",
      detailData: null,
    },
  );

  // 引用子组件
  const modal = ref<any | null>(null);

  const callRefMethod = (refVal: any | null, methodName: string): void => {
    if (refVal == null) {
      return;
    }
    const fn = (refVal as UTSJSONObject)[methodName];
    if (fn != null) {
      (fn as () => void)();
    }
  };

  /** App 端 plain text 展示 JSON */
  const appPlainDetailText = computed((): string => {
    const data = props.detailData;
    if (data == null) {
      return "";
    }
    try {
      return JSON.stringify(data, null, 2);
    } catch (e) {
      return `${data}`;
    }
  });

  // 计算属性：格式化详情展示（H5 / 小程序 mp-html）
  const formattedDetailData = computed((): string => {
    return `\`\`\`json\n${appPlainDetailText.value}\n\`\`\``;
  });

  const diffFiles = computed((): any[] => {
    const data = props.detailData;
    if (data != null && Array.isArray((data as UTSJSONObject)["__diffFiles"])) {
      return (data as UTSJSONObject)["__diffFiles"] as any[];
    }
    return [];
  });

  /**
   * 复制数据到剪贴板
   */
  const copy = () => {
    const data =
      diffFiles.value.length > 0 ? diffFiles.value : props.detailData;
    if (data == null) {
      return;
    }
    let content = "";
    try {
      content = JSON.stringify(data, null, 2);
    } catch (e) {
      content = `${data}`;
    }

    uni.setClipboardData({
      data: content,
      success: () => {
        uni.showToast({
          title: t("Mobile.Common.copySuccess"),
          icon: "none",
        });
      },
      fail: () => {
        uni.showToast({
          title: t("Mobile.Common.copyFailed"),
          icon: "none",
        });
      },
    });
  };

  /**
   * 打开弹窗
   */
  const open = () => {
    callRefMethod(modal.value, "open");
  };

  /**
   * 关闭弹窗
   */
  const close = () => {
    callRefMethod(modal.value, "close");
  };

  // 暴露组件方法
  defineExpose({
    open,
    close,
  });
</script>

<style lang="scss" scoped>
  .copy-btn {
    margin: 0 25rpx;
    .iconfont {
      color: #333;
      font-size: 32rpx;
    }
  }

  .details-content {
    /* 可以在这里添加额外的样式 */
  }

  .details-plain-text {
    width: 100%;
    font-size: 24rpx;
    color: #15171f;
    line-height: 1.6;
    white-space: pre-wrap;
  }
</style>
