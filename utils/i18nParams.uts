/** UTSJSONObject 参数先构造成真实 Map，避免 App 强转失败及 H5 缺少 forEach。 */
export function objectI18nParams(
  values: UTSJSONObject,
): Record<string, string | number> {
  const result = new Map<string, string | number>();
  const keys = UTSJSONObject.keys(values);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const value = values[key];
    result.set(key, value != null ? `${value}` : "");
  }
  return result as any as Record<string, string | number>;
}
