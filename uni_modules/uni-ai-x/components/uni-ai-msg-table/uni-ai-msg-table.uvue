<template>
	<view class="uni-ai-msg-table" :class="[`ui-theme-${uiTheme}`]">
		<view class="uni-ai-msg-table-card">
			<view class="uni-ai-msg-table-toolbar">
				<text class="uni-ai-msg-table-toolbar-title">表格</text>
				<view class="uni-ai-msg-table-toolbar-actions">
					<view class="uni-ai-msg-table-action" @click="copyTable">
						<uni-ai-icon class="uni-ai-msg-table-action-icon" code="e60c" size="12" color="#666666" />
						<text class="uni-ai-msg-table-action-text">复制</text>
					</view>
					<view class="uni-ai-msg-table-action" @click="downloadTable">
						<text class="uni-ai-msg-table-action-text">下载</text>
					</view>
				</view>
			</view>
			<scroll-view
				class="uni-ai-msg-table-table-box"
				direction="horizontal"
				:show-scrollbar="isHorizontalScroll"
				:style="{width: tableWrapperWidth + 'px'}"
			>
				<!-- 显式内容宽：避免 iOS scroll-view 把行压进视口导致左列/公式被裁 -->
				<view class="uni-ai-msg-table-table-content" :style="{width: tableWidth + 'px'}">
					<view
						v-for="(row, rowIndex) in tableData"
						:key="rowIndex"
						class="uni-ai-msg-table-table-row"
						:style="{width: tableWidth + 'px'}"
					>
						<template v-for="(cell, cellIndex) in row.tokens" :key="cellIndex">
							<view
								class="uni-ai-msg-table-cell"
								:class="{
									'uni-ai-msg-table-cell-first': cellIndex == 0,
									'uni-ai-msg-table-cell-header': hasTableHeader && rowIndex == 0
								}"
								:style="{width: getColumnWidth(cellIndex) + 'px', 'justify-content': getTableJustify(cellIndex)}"
							>
								<template v-for="(cellItem, cellItemIndex) in cell.tokens" :key="cellItemIndex">
									<nuwa-math
										v-if="cellItem.type == 'math'"
										class="uni-ai-msg-table-cell-math"
										:latex="cellItem.text ?? ''"
										:inline="true"
										:key="'cell-math-' + cellItemIndex + '-' + mathRenderKey(cellItem)"
									/>
									<text
										v-else
										:class="(hasTableHeader && rowIndex == 0 ? 'uni-ai-msg-table-header-text' : 'uni-ai-msg-table-cell-text') + (cellItem.type != null ? ' uni-ai-msg-table-cell-text-' + cellItem.type : '')"
										:key="'cell-text-' + cellItemIndex + '-' + mathRenderKey(cellItem)"
									>{{ mathFallbackText(cellItem) }}</text>
								</template>
							</view>
						</template>
					</view>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script lang="uts" setup>
	import { uiTheme } from '@/uni_modules/uni-ai-x/sdk';
	// 数学公式统一出口：App/H5 走 nuwax-uni-math（x-math）；MP 保留 nuwax-katex rich-text
	import NuwaMath from '@/uni_modules/uni-ai-x/components/nuwa-math/nuwa-math.uvue'
	import { MarkdownToken, Align } from '@/uni_modules/uni-cmark'
	const props = defineProps<{ tableNode : MarkdownToken }>()
	const MIN_COLUMN_WIDTH = 66
	
	const tableAligns = computed(() : Align[] => {
		return (props.tableNode as MarkdownToken)?.align ?? ['left', 'left', 'left']
	})

	const columnWidths = ref<number[]>([])
	// 表格数据
	const tableData = ref<MarkdownToken[]>([])
	/** 是否存在有效表头（占位空表头如 `| |` 会被去掉，此时为 false） */
	const hasTableHeader = ref<boolean>(true)
	// 计算表格总宽度（像素值）
	const tableWidth = ref<number>(0)

	/** 获取安全列宽，避免数据和计算结果更新不同步时原生数组越界。 */
	function getColumnWidth(columnIndex: number): number {
		if (columnIndex >= 0 && columnIndex < columnWidths.value.length) {
			return columnWidths.value[columnIndex]
		}
		return MIN_COLUMN_WIDTH
	}

	/** 单元格 key：nuwa-math 由 latex 变化驱动重渲（MathRendererCore 缓存/去重），稳定 key 即可。 */
	function mathRenderKey(token: MarkdownToken): string {
		if (token.type != 'math') {
			return 't'
		}
		return 'm'
	}

	/** 未渲染完成时先展示 latex，避免单元格空白。 */
	function mathFallbackText(token: MarkdownToken): string {
		if (token.type == 'math') {
			return token.text ?? ''
		}
		return token.text ?? ''
	}

	/** 获取安全对齐方式；部分 Markdown 表格的 align 数量少于实际列数。 */
	function getTableAlign(columnIndex: number): Align {
		const aligns = tableAligns.value
		if (columnIndex >= 0 && columnIndex < aligns.length) {
			return aligns[columnIndex]
		}
		return 'left'
	}

	/** view 单元格用 justify-content 对齐内容。 */
	function getTableJustify(columnIndex: number): string {
		const align = getTableAlign(columnIndex)
		if (align == 'center') return 'center'
		if (align == 'right') return 'flex-end'
		return 'flex-start'
	}

	/** H5/小程序的文字测量可能返回 0，按字符数提供稳定的跨端兜底宽度。 */
	function estimateCellWidth(cell: MarkdownToken, isHeader: boolean): number {
		const tokens = cell.tokens ?? []
		let textLength = 0
		let mathWidth = 0
		for (let i = 0; i < tokens.length; i++) {
			const token = tokens[i]
			if (token.type == 'math') {
				const renderedWidth = token.width ?? 0
				if (renderedWidth > 0) {
					// 表格公式不缩小：列宽按截图原始宽度，不够时横向滚动
					mathWidth += renderedWidth + 24
				} else {
					const latex = token.text ?? ''
					mathWidth += Math.max(80, latex.length * 10 + 32)
				}
				continue
			}
			const text = token.text ?? ''
			textLength += text.length
		}
		const measuredWidth = cell.width ?? 0
		const estimatedWidth = textLength * (isHeader ? 16 : 14) + 32 + mathWidth
		return Math.max(MIN_COLUMN_WIDTH, measuredWidth + 16, estimatedWidth)
	}

	/** 是否为 Markdown 表格对齐分隔单元格，如 ---、:---:、---:。 */
	function isSeparatorCell(cell: MarkdownToken): boolean {
		const tokens = cell.tokens ?? []
		let text = ''
		for (let i = 0; i < tokens.length; i++) {
			text += tokens[i].text ?? ''
		}
		text = text.trim()
		if (text.length == 0) return false
		let dashCount = 0
		for (let i = 0; i < text.length; i++) {
			const char = text.charAt(i)
			if (char == '-') {
				dashCount++
			} else if (char != ':' && char != ' ' && char != '\t') {
				return false
			}
		}
		return dashCount > 0
	}

	/** App 解析器可能将 Markdown 分隔行保留为普通 table_row。 */
	function isSeparatorRow(row: MarkdownToken): boolean {
		const cells = row.tokens ?? []
		if (cells.length == 0) return false
		for (let i = 0; i < cells.length; i++) {
			if (!isSeparatorCell(cells[i])) {
				return false
			}
		}
		return true
	}

	/** 单元格无可见文本（模型常输出占位空表头 `| |` / `| | |`）。 */
	function isEmptyCell(cell: MarkdownToken): boolean {
		const tokens = cell.tokens ?? []
		if (tokens.length == 0) {
			return true
		}
		for (let i = 0; i < tokens.length; i++) {
			const token = tokens[i]
			if (token.type == 'math') {
				const latex = token.text ?? ''
				if (latex.trim().length > 0) return false
				continue
			}
			const text = token.text ?? ''
			if (text.trim().length > 0) return false
		}
		return true
	}

	/** 整行单元格皆为空。 */
	function isEmptyRow(row: MarkdownToken): boolean {
		const cells = row.tokens ?? []
		if (cells.length == 0) {
			return true
		}
		for (let i = 0; i < cells.length; i++) {
			if (isEmptyCell(cells[i]) != true) {
				return false
			}
		}
		return true
	}

	/** 取单元格纯文本（公式用 latex 原文）。 */
	function cellPlainText(cell: MarkdownToken): string {
		const tokens = cell.tokens ?? []
		let text = ''
		for (let i = 0; i < tokens.length; i++) {
			const token = tokens[i]
			if (token.type == 'math') {
				const latex = token.text ?? ''
				if (latex.length > 0) {
					text += '$' + latex + '$'
				}
			} else {
				text += token.text ?? ''
			}
		}
		return text.trim()
	}

	/** 导出 Markdown 表格文本。 */
	function buildMarkdownTable(): string {
		const rows = tableData.value
		if (rows.length == 0) return ''
		let columnCount = 0
		for (let i = 0; i < rows.length; i++) {
			columnCount = Math.max(columnCount, (rows[i].tokens ?? []).length)
		}
		if (columnCount == 0) return ''
		const lines = [] as string[]
		for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
			const cells = rows[rowIndex].tokens ?? []
			const parts = [] as string[]
			for (let c = 0; c < columnCount; c++) {
				parts.push(c < cells.length ? cellPlainText(cells[c]) : '')
			}
			lines.push('| ' + parts.join(' | ') + ' |')
			if (rowIndex == 0 && hasTableHeader.value == true) {
				const seps = [] as string[]
				for (let c = 0; c < columnCount; c++) {
					seps.push('---')
				}
				lines.push('| ' + seps.join(' | ') + ' |')
			}
		}
		return lines.join('\n')
	}

	function copyTable() {
		const content = buildMarkdownTable()
		if (content.length == 0) {
			uni.showToast({ title: '表格为空', icon: 'none' })
			return
		}
		uni.setClipboardData({
			data: content,
			success: () => {
				uni.showToast({ title: '表格已复制', icon: 'none' })
			},
			fail: () => {
				uni.showToast({ title: '复制失败', icon: 'none' })
			}
		})
	}

	function downloadTable() {
		const content = buildMarkdownTable()
		if (content.length == 0) {
			uni.showToast({ title: '表格为空', icon: 'none' })
			return
		}
		// #ifdef H5
		try {
			const blob = new Blob([content], { type: 'text/markdown;charset=utf-8' })
			const url = URL.createObjectURL(blob)
			const a = document.createElement('a')
			a.href = url
			a.download = 'table.md'
			a.click()
			URL.revokeObjectURL(url)
			uni.showToast({ title: '已下载', icon: 'none' })
		} catch (e) {
			uni.setClipboardData({
				data: content,
				success: () => {
					uni.showToast({ title: '已复制表格内容', icon: 'none' })
				}
			})
		}
		// #endif
		// #ifndef H5
		uni.setClipboardData({
			data: content,
			success: () => {
				uni.showToast({ title: '已复制，可粘贴保存', icon: 'none' })
			},
			fail: () => {
				uni.showToast({ title: '下载失败', icon: 'none' })
			}
		})
		// #endif
	}

	/** 用渲染后的 math 尺寸刷新列宽的签名，驱动 watch 重算。 */
	function mathLayoutSignature(tableNode: MarkdownToken): string {
		const rows = tableNode.tokens ?? []
		let sign = ''
		for (let r = 0; r < rows.length; r++) {
			const cells = rows[r].tokens ?? []
			for (let c = 0; c < cells.length; c++) {
				const tokens = cells[c].tokens ?? []
				for (let t = 0; t < tokens.length; t++) {
					const token = tokens[t]
					if (token.type == 'math') {
						sign +=
							(token.width ?? 0) +
							'x' +
							(token.height ?? 0) +
							':' +
							((token.href ?? '').length) +
							';'
					}
				}
			}
		}
		return sign
	}

	/**
	 * 表格内容签名：行数 + 每行单元格数 + 每行文本总长。
	 * 流式解析新增行时 uniqueId 与 mathLayoutSignature 都不变（无公式表格），
	 * 仅此签名变化才能触发下方 watch 重建 tableData，否则表格停在首批行数。
	 */
	function tableContentSignature(tableNode: MarkdownToken): string {
		const rows = tableNode.tokens ?? []
		let sign = 'r' + rows.length
		for (let r = 0; r < rows.length; r++) {
			const cells = rows[r].tokens ?? []
			let textLen = 0
			for (let c = 0; c < cells.length; c++) {
				const tokens = cells[c].tokens ?? []
				for (let t = 0; t < tokens.length; t++) {
					textLen += (tokens[t].text ?? '').length
				}
			}
			sign += ';' + cells.length + ':' + textLen
		}
		return sign
	}

	watch(
		() : string => {
			const node = props.tableNode as MarkdownToken
			const id = node.uniqueId ?? ''
			return (
				id +
				'|' +
				tableContentSignature(node) +
				'|' +
				mathLayoutSignature(node)
			)
		},
		(_ : string) => {
			const tableNode = props.tableNode as MarkdownToken
			const sourceRows = tableNode.tokens ?? []
			const rows = [] as MarkdownToken[]
			let skippedEmptyHeader = false
			for (let i = 0; i < sourceRows.length; i++) {
				if (i > 0 && isSeparatorRow(sourceRows[i])) {
					continue
				}
				// 去掉 Markdown 必填但内容为空的首行表头，避免渲染出空白行
				if (rows.length == 0 && isEmptyRow(sourceRows[i]) == true) {
					skippedEmptyHeader = true
					continue
				}
				rows.push(sourceRows[i])
			}
			hasTableHeader.value = skippedEmptyHeader != true
			// 拿到所有表格宽度
			const _columnWidths : number[] = []
			// 以所有行的最大列数为准，兼容缺列或多列的不规则表格。
			let columnCount = 0
			for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
				const rowTokens = rows[rowIndex].tokens ?? []
				columnCount = Math.max(columnCount, rowTokens.length)
			}
			for (let i = 0; i < columnCount; i++) {
				let columnWidth = MIN_COLUMN_WIDTH
				for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
					const rowTokens = rows[rowIndex].tokens ?? []
					if (i >= 0 && i < rowTokens.length) {
						const cell = rowTokens[i]
						const asHeader = hasTableHeader.value == true && rowIndex == 0
						columnWidth = Math.max(
							columnWidth,
							estimateCellWidth(cell, asHeader),
						)
					}
				}
				// 不硬性压窄公式列，宽度不足时由 scroll-view 横向滚动
				_columnWidths.push(columnWidth)
			}
			columnWidths.value = _columnWidths
			tableWidth.value = columnWidths.value.reduce((sum, width) => sum + width, 0)
			tableData.value = rows
		},
		{ immediate: true }
	)

	const maxTableWidth = ref(0)
	onMounted(() => {
		const proxy = getCurrentInstance()?.proxy
		function setMaxTableWidth() {
			uni.createSelectorQuery().in(proxy).select('.uni-ai-msg-table')
				.boundingClientRect().exec((ret) => {
					if (ret.length == 0) return
					maxTableWidth.value = (ret[0] as NodeInfo).width!
				})
		}
		// 设置表格最大宽度
		setMaxTableWidth()
		//#ifdef H5
		window.addEventListener('resize', () => { setMaxTableWidth() })
		//#endif
	})
	// 是否需要横向滚动
	const isHorizontalScroll = computed(() => {
		return tableWidth.value > maxTableWidth.value
	})
	// table-box 的宽度，如果tableWidth大于屏幕宽度，则设置为屏幕宽度，否则设置为tableWidth
	const tableWrapperWidth = computed(() => {
		return isHorizontalScroll.value ? maxTableWidth.value : tableWidth.value
	})
</script>

<style lang="scss">
	// 引用scss
	@import '@/uni_modules/uni-ai-x/components/uni-ai-text-md/uni-ai-text-md.scss';
	/* 蒸汽模式：仅单层 class */
	.uni-ai-msg-table {
		width: 100% !important;
		margin-bottom: 10px;
	}

	.uni-ai-msg-table-card {
		width: 100%;
		border: 1px solid #e8e8e8;
		border-radius: 10px;
		/* 仅裁圆角；内容区交给横向 scroll，避免公式被裁切 */
		overflow: hidden;
		background-color: #ffffff;
		margin: 12px 0;
	}

	.uni-ai-msg-table-toolbar {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 10px 12px;
		background-color: #f5f5f5;
		border-bottom: 1px solid #ebebeb;
	}

	.uni-ai-msg-table-toolbar-title {
		font-size: 13px;
		color: #666666;
		font-weight: 500;
	}

	.uni-ai-msg-table-toolbar-actions {
		flex-direction: row;
		align-items: center;
	}

	.uni-ai-msg-table-action {
		flex-direction: row;
		align-items: center;
		margin-left: 16px;
	}

	.uni-ai-msg-table-action-icon {
		margin-right: 4px;
	}

	.uni-ai-msg-table-action-text {
		font-size: 12px;
		color: #666666;
	}

	.uni-ai-msg-table-table-box {
		width: 100% !important;
		box-sizing: border-box;
		background-color: #ffffff;
	}

	.uni-ai-msg-table-table-content {
		flex-direction: column;
		align-items: flex-start;
	}

	.uni-ai-msg-table-table-row {
		flex-direction: row;
		border-bottom: 1px solid #e8e8e8;
		background-color: #ffffff;
		align-self: flex-start;
		justify-content: flex-start;
		align-items: stretch;
		flex-shrink: 0;
	}

	.uni-ai-msg-table-cell {
		flex-shrink: 0;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: center;
		box-sizing: border-box;
		/* 紧凑行高：原 padding 12px/min-height 48px 过高，压到 6px/34px；含公式行仍由内容撑高 */
		padding: 6px 12px 6px 10px;
		min-height: 34px;
		border-right: 1px solid #eeeeee;
		overflow: visible;
	}

	.uni-ai-msg-table-cell-first {
		border-left-width: 0;
	}

	.uni-ai-msg-table-cell-header {
		background-color: #fafafa;
	}

	.uni-ai-msg-table-header-text {
		font-size: 14px;
		font-weight: bold;
		color: #333333;
	}

	.uni-ai-msg-table-cell-text {
		font-size: 13px;
		color: #666666;
	}

	.uni-ai-msg-table-cell-text-code {
		padding: 1px 5px;
		border-radius: 10px;
	}

	.uni-ai-msg-table-cell-math {
		flex-shrink: 0;
		overflow: visible;
		padding-right: 4px;
	}
</style>
