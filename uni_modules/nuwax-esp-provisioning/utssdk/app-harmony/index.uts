/**
 * Nuwax ESP Provisioning（App-Harmony）
 *
 * 包装同目录 EspProvisioningBridge.ets（底层为 esp/ 吸收的 esp-idf-provisioning-harmony）：
 * UTS 接口与 app-android / app-ios 完全一致，utils/provisioning/harmonyEspProvisioningClient.uts
 * 以平台条件编译引用同一模块。
 *
 * 鸿蒙混编：同目录 EspProvisioningBridge.ets 的 export class 对 UTS 直接可见
 * （import 指向 .ets 文件；uts 依赖 ets，ets 不引用 uts——DCloud 官方鸿蒙混编约束）。
 * ArkTS 与 UTS 同语言编译，无跨桥 GC 问题，不需要 @UTSJS.keepAlive。
 */
import { EspProvisioningBridge } from './EspProvisioningBridge.ets'
import { abilityAccessCtrl, Permissions, PermissionRequestResult } from '@kit.AbilityKit'
import { BusinessError } from '@kit.BasicServicesKit'
import type {
  NativeEspDeviceCallback,
  NativeEspFailureCallback,
  NativeEspLogCallback,
  NativeEspProgressCallback,
  NativeEspSuccessCallback,
} from '../interface.uts';

let nativeBridge: EspProvisioningBridge | null = null;

function bridge(): EspProvisioningBridge {
  if (nativeBridge == null) {
    nativeBridge = new EspProvisioningBridge();
  }
  return nativeBridge!;
}

/**
 * 申请蓝牙运行时权限（ohos.permission.ACCESS_BLUETOOTH 为 user_grant）。
 * 供配网入口页预请求：BLE 弹窗先于相机弹窗完成，避免扫码成功跳转后权限请求被系统延后。
 */
export function ensureNativeEspPermissions(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  const context = UTSHarmony.getUIAbilityContext();
  const perms: Permissions[] = ['ohos.permission.ACCESS_BLUETOOTH'] as Permissions[];
  abilityAccessCtrl.createAtManager().requestPermissionsFromUser(context, perms)
    .then((result: PermissionRequestResult) => {
      // authResults 与申请列表按索引平行：全部为 0（已授权）才放行
      let allGranted = result.authResults.length === perms.length;
      for (let i = 0; i < result.authResults.length; i++) {
        if (result.authResults[i] !== 0) {
          allGranted = false;
          break;
        }
      }
      if (allGranted) {
        success('');
      } else {
        fail('NO_PERMISSION', 'Bluetooth permission was not granted');
      }
    })
    .catch((e: BusinessError) => {
      fail('NO_PERMISSION', `Permission request failed: ${e.code}`);
    });
}

/** 蓝牙权限申请 + 初始化原生桥（fastble BleManager.init）。 */
export function initializeNativeEspProvisioning(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  ensureNativeEspPermissions(
    (_value: string) => {
      bridge().init();
      success('');
    },
    fail,
  );
}

/** iOS 专用日志通道：鸿蒙 console.info 直接进 HBuilderX 控制台，空实现以对齐插件接口。 */
export function setNativeEspLog(_cb: NativeEspLogCallback): void {}

export function startNativeEspScan(
  prefix: string,
  serviceUuid: string,
  onDevice: NativeEspDeviceCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().startScan(prefix, serviceUuid, onDevice, fail);
}

export function stopNativeEspScan(): void {
  if (nativeBridge != null) nativeBridge!!.stopScan();
}

export function connectNativeEspDevice(
  deviceId: string,
  serviceUuid: string,
  username: string,
  proofOfPossession: string,
  timeoutMs: number,
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().connect(deviceId, serviceUuid, username, proofOfPossession, timeoutMs, success, fail);
}

export function getNativeEspCapabilities(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().getCapabilities(success, fail);
}

export function getNativeEspDeviceInfo(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().getDeviceInfo(success, fail);
}

/** 向固件自定义 endpoint 写数据（payload 为 JSON 字符串），成功回调返回设备响应 JSON 字符串 */
export function sendNativeEspCustomData(
  endpoint: string,
  payload: string,
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().sendCustomData(endpoint, payload, success, fail);
}

export function scanNativeEspNetworks(
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().scanNetworks(success, fail);
}

export function provisionNativeEspDevice(
  ssid: string,
  password: string,
  timeoutMs: number,
  progress: NativeEspProgressCallback,
  success: NativeEspSuccessCallback,
  fail: NativeEspFailureCallback,
): void {
  bridge().provision(ssid, password, timeoutMs, progress, success, fail);
}

export function disconnectNativeEspDevice(): void {
  if (nativeBridge != null) nativeBridge!!.disconnect();
}

export function disposeNativeEspProvisioning(): void {
  if (nativeBridge != null) nativeBridge!!.dispose();
  nativeBridge = null;
}
