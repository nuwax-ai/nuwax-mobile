<template>
  <view class="vtl-page page-container">
    <custom-nav-bar
      title="虚拟滚动列表"
      :show-back="true"
      hasSafetyZone
    >
    </custom-nav-bar>
    <view class="vtl-bar">
      <view class="vtl-switches">
        <text
          class="vtl-chip"
          :class="virtualScroll ? 'vtl-chip-active' : ''"
          @click="toggleVirtualScroll"
        >虚拟滚动: {{ virtualScroll ? '开' : '关' }}</text>
        <text
          class="vtl-chip"
          :class="nativeList ? 'vtl-chip-active' : ''"
          @click="toggleNativeList"
        >App原生list-view: {{ nativeList ? '开' : '关' }}</text>
        <text
          class="vtl-chip"
          :class="followBottom ? 'vtl-chip-active' : ''"
          @click="toggleFollowBottom"
        >底部跟随: {{ followBottom ? '开' : '关' }}</text>
        <text
          class="vtl-chip"
          :class="initBottom ? 'vtl-chip-active' : ''"
          @click="toggleInitBottom"
        >初始滚底(重进生效): {{ initBottom ? '开' : '关' }}</text>
        <text
          class="vtl-chip"
          :class="splitEnabled ? 'vtl-chip-active' : ''"
          @click="toggleSplit"
        >长文本拆分(500字): {{ splitEnabled ? '开' : '关' }}</text>
      </view>
      <view class="vtl-btns">
        <text class="vtl-btn" @click="onAppend">追加</text>
        <text class="vtl-btn" @click="onPrepend">前插</text>
        <text class="vtl-btn" @click="onAddLongMsg">生成长文本</text>
        <text class="vtl-btn" @click="onGrowLast">长高最后一项</text>
        <text class="vtl-btn" @click="onRefreshSizes">refreshSizes</text>
        <text class="vtl-btn" @click="onReload">reload</text>
        <text class="vtl-btn" @click="onTop">滚顶</text>
        <text class="vtl-btn" @click="onBottom">滚底</text>
        <text class="vtl-btn" @click="onIndex">滚到#1000</text>
      </view>
      <view class="vtl-info">
        <text class="vtl-info-text">count {{ list.length }} · visible {{ visibleText }} · scrollTop {{ scrollTopText }}px · window高 {{ viewportText }}px</text>
      </view>
    </view>

    <view class="vtl-body">
      <nuwax-virtual-list
        ref="listRef"
        :data="list"
        :item-height="56"
        :buffer-count="10"
        list-id="vtl-list"
        key-field="key"
        :virtual-scroll="virtualScroll"
        :native-list="nativeList"
        :follow-bottom="followBottom"
        :load-more-enabled="true"
        :load-more-loading="loadMoreLoading"
        :init-scroll-to-bottom="initBottom"
        :enable-split="splitEnabled"
        :split-max-chars="500"
        split-text-field="desc"
        @scroll="onScroll"
        @visible-change="onVisibleChange"
        @loadmore="onLoadMore"
      >
        <template #item="sp">
          <view class="vtl-item" :class="itemClass(sp.index)">
            <view class="vtl-item-head">
              <text class="vtl-index">{{ sp.index }}</text>
              <text class="vtl-title">{{ field(sp.item, 'title') }}</text>
              <text class="vtl-part" v-if="sp.partIndex >= 0">[拆分段 {{ sp.partIndex }}]</text>
            </view>
            <text
              class="vtl-desc"
              v-if="sp.partIndex >= 0 ? sp.partText.length > 0 : hasDesc(sp.item)"
            >{{ sp.partIndex >= 0 ? sp.partText : field(sp.item, 'desc') }}</text>
          </view>
        </template>
      </nuwax-virtual-list>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  import NuwaxVirtualList from "@/uni_modules/nuwax-virtual-list/components/nuwax-virtual-list/nuwax-virtual-list.uvue";

  const listRef = ref<any | null>(null);

  // ==================== 模板辅助（UTS 函数声明不提升，须先定义） ====================
  function readField(item: any | null, key: string): string {
    if (item == null) return "";
    try {
      const obj = item as UTSJSONObject;
      const v = obj[key];
      if (v != null) return `${v}`;
    } catch (_e) {
      // ignore
    }
    return "";
  }

  function field(item: any | null, key: string): string {
    return readField(item, key);
  }

  function hasDesc(item: any | null): boolean {
    return readField(item, "desc").length > 0;
  }

  /** 内容行数（决定高度），按 index 确定性分布，附带少量"偶发长块" */
  function blockMode(index: number): number {
    if (index % 23 == 0) return 4;
    if (index % 11 == 0) return 2;
    if (index % 5 == 0) return 1;
    return 0;
  }

  function itemClass(index: number): string {
    const m = index % 4;
    if (m == 0) return "vtl-item-c0";
    if (m == 1) return "vtl-item-c1";
    if (m == 2) return "vtl-item-c2";
    return "vtl-item-c3";
  }

  // ==================== 开关 ====================
  const virtualScroll = ref<boolean>(true);
  const nativeList = ref<boolean>(false);
  const followBottom = ref<boolean>(true);
  /** 初始滚底（仅首次进入页面生效，切换后需重新进入页面） */
  const initBottom = ref<boolean>(true);
  /** 长文本拆分（enableSplit）：单条 desc 超过 500 字时拆分为多条子项渲染 */
  const splitEnabled = ref<boolean>(false);

  // ==================== 数据 ====================
  /** 生成一项：title 固定、desc 长度随 index 变化 → 不同高度 */
  function makeItem(index: number, version: number): UTSJSONObject {
    const descLines = (index % 7) + 1;
    let desc = "";
    for (let l = 0; l < descLines; l++) {
      desc += `第 ${l + 1} 行：这是一条随内容长度变化高度的演示数据，index=${index} 的 desc 有 ${descLines} 行。`;
    }
    return {
      "key": `item-${index}-v${version}`,
      "title": `Title #${index} (v${version})`,
      "desc": desc,
    } as UTSJSONObject;
  }

  let dataVersion = 0;
  let nextIndex = 0;
  const list = ref<Array<UTSJSONObject>>([] as Array<UTSJSONObject>);

  function build(count: number): Array<UTSJSONObject> {
    const out: Array<UTSJSONObject> = [];
    for (let i = 0; i < count; i++) {
      out.push(makeItem(nextIndex, dataVersion));
      nextIndex++;
    }
    return out;
  }

  // 初始 5000 条
  list.value = build(5000);

  // ==================== 数据操作 ====================
  function onAppend(): void {
    dataVersion++;
    list.value = [...list.value, makeItem(nextIndex, dataVersion)];
    nextIndex++;
  }

  // ==================== 触底分页加载（模拟后端分页：滚到底自动追加 20 条） ====================
  const loadMoreLoading = ref<boolean>(false);
  function onLoadMore(): void {
    if (loadMoreLoading.value) return;
    loadMoreLoading.value = true;
    setTimeout(() => {
      dataVersion++;
      const batch = [] as Array<UTSJSONObject>;
      for (let i = 0; i < 20; i++) {
        batch.push(makeItem(nextIndex, dataVersion));
        nextIndex++;
      }
      list.value = [...list.value, ...batch];
      loadMoreLoading.value = false;
    }, 400);
  }

  function onPrepend(): void {
    dataVersion++;
    const fresh = [] as Array<UTSJSONObject>;
    fresh.push(makeItem(nextIndex, dataVersion));
    nextIndex++;
    list.value = [...fresh, ...list.value];
  }

  /** 原地长高最后一项：替换数组引用触发 watch，验证动态高度 + 底部跟随 */
  function onGrowLast(): void {
    if (list.value.length == 0) return;
    dataVersion++;
    const last = list.value[list.value.length - 1];
    const key = field(last, "key");
    const title = field(last, "title");
    let desc = field(last, "desc");
    for (let l = 0; l < 3; l++) {
      desc = desc + " 长高后追加的内容行，模拟流式回复增长。";
    }
    const copy: UTSJSONObject = {
      "key": key,
      "title": title,
      "desc": desc,
    } as UTSJSONObject;
    const newList = [...list.value] as Array<UTSJSONObject>;
    newList[newList.length - 1] = copy;
    list.value = newList;
  }

  // ==================== 列表方法（Android：$callMethod 须在 ComponentPublicInstance 上调用） ====================
  function listProxy(): ComponentPublicInstance | null {
    const ref = listRef.value as any | null;
    if (ref == null) return null;
    try {
      return ref as ComponentPublicInstance;
    } catch (_e) {
      return null;
    }
  }

  function onRefreshSizes(): void {
    const p = listProxy();
    if (p != null) p.$callMethod("refreshSizes");
  }

  function onReload(): void {
    const p = listProxy();
    if (p != null) p.$callMethod("reload");
  }

  function onTop(): void {
    const p = listProxy();
    if (p != null) p.$callMethod("scrollToTop", false);
  }

  function onBottom(): void {
    const p = listProxy();
    if (p != null) p.$callMethod("scrollToBottom", true);
  }

  function onIndex(): void {
    const p = listProxy();
    if (p != null) p.$callMethod("scrollToIndex", 1000, true);
  }

  // ==================== 状态展示 ====================
  const visibleText = ref<string>("-");
  const scrollTopText = ref<string>("0");
  const viewportText = ref<string>("-");

  function onVisibleChange(e: any): void {
    const payload = e != null ? (e as UTSJSONObject) : null;
    if (payload != null) {
      visibleText.value = `${payload["start"]} ~ ${payload["end"]}`;
    }
  }

  function onScroll(e: any): void {
    if (e != null) {
      try {
        const detail = (e as UTSJSONObject)["detail"] as UTSJSONObject;
        if (detail != null) {
          const st = detail["scrollTop"];
          if (st != null) scrollTopText.value = `${st}`;
        }
      } catch (_err) {
        // ignore
      }
    }
  }

  function toggleVirtualScroll(): void {
    virtualScroll.value = !virtualScroll.value;
  }

  function toggleNativeList(): void {
    nativeList.value = !nativeList.value;
  }

  function toggleFollowBottom(): void {
    followBottom.value = !followBottom.value;
  }

  function toggleInitBottom(): void {
    initBottom.value = !initBottom.value;
  }

  function toggleSplit(): void {
    splitEnabled.value = !splitEnabled.value;
  }

  /** 生成一条超长消息（含代码块/表格/图片/长文本），验证拆分时模块完整性 */
  function onAddLongMsg(): void {
    dataVersion++;
    let longText = "";
    for (let i = 0; i < 25; i++) {
      longText += `这是第 ${i} 段普通长文本内容，用于演示虚拟列表拆分能力，确保单条超长不会导致渲染压力。`;
    }
    longText += "\n\n```python\n# 完整代码块：拆分时不得从中切断\ndef hello():\n    print('hello')\n    for i in range(10):\n        print(i)\n```\n\n";
    longText += "| 列1 | 列2 | 列3 |\n|---|---|---|\n| A | 1 | x |\n| B | 2 | y |\n| C | 3 | z |\n\n";
    longText += "![示例图片](https://example.com/img.png)\n\n";
    for (let j = 0; j < 8; j++) {
      longText += `结尾普通文本 ${j}，验证模块后文本继续拆分。`;
    }
    list.value = [...list.value, {
      "key": `long-${nextIndex}-v${dataVersion}`,
      "title": `超长消息 #${nextIndex}`,
      "desc": longText,
    } as UTSJSONObject];
    nextIndex++;
  }
</script>

<style lang="scss" scoped>
  .vtl-page {
    display: flex;
    flex-direction: column;
    background-color: #f5f6f7;
  }

  .vtl-bar {
    padding: 12rpx 24rpx 12rpx;
    background-color: #ffffff;
    border-bottom-width: 1px;
    border-bottom-color: #e5e6e7;
    flex-shrink: 0;
  }

  .vtl-switches {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
  }

  .vtl-chip {
    font-size: 22rpx;
    color: #666;
    background-color: #f0f1f2;
    border-radius: 20rpx;
    padding: 8rpx 20rpx;
    margin: 4rpx;
  }

  .vtl-chip-active {
    color: #ffffff;
    background-color: #3bb346;
  }

  .vtl-btns {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    margin-top: 12rpx;
  }

  .vtl-btn {
    font-size: 22rpx;
    color: #2b6ef2;
    background-color: #eef4ff;
    border-radius: 16rpx;
    padding: 8rpx 20rpx;
    margin: 4rpx;
  }

  .vtl-info {
    margin-top: 12rpx;
  }

  .vtl-info-text {
    font-size: 20rpx;
    color: #999;
  }

  .vtl-body {
    flex: 1;
    min-height: 0;
  }

  .vtl-item {
    margin: 8rpx 24rpx;
    border-radius: 16rpx;
    padding: 20rpx 24rpx;
    background-color: #ffffff;
  }

  .vtl-item-c0 {
    border-left-width: 8rpx;
    border-left-color: #3bb346;
  }

  .vtl-item-c1 {
    border-left-width: 8rpx;
    border-left-color: #2b6ef2;
  }

  .vtl-item-c2 {
    border-left-width: 8rpx;
    border-left-color: #f2a03b;
  }

  .vtl-item-c3 {
    border-left-width: 8rpx;
    border-left-color: #c05bf2;
  }

  .vtl-item-head {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .vtl-index {
    font-size: 20rpx;
    color: #999;
    margin-right: 16rpx;
  }

  .vtl-title {
    font-size: 28rpx;
    color: #222;
    font-weight: bold;
  }

  .vtl-part {
    font-size: 20rpx;
    color: #b26b00;
    background-color: #fff7e6;
    border-radius: 8rpx;
    padding: 2rpx 12rpx;
    margin-left: 16rpx;
  }

  .vtl-desc {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #555;
    line-height: 1.6;
  }

  .vtl-block {
    margin-top: 12rpx;
    background-color: #fff7e6;
    border-radius: 12rpx;
    padding: 16rpx;
  }

  .vtl-block-text {
    font-size: 22rpx;
    color: #b26b00;
  }
</style>
