<template>
	<view class="uni-code-msg-root" :class="['ui-theme-dark', language == 'mermaid' ? 'uni-code-msg-root-mermaid' : '']">
		<view class="uni-code-msg-code-header">
			<view class="uni-code-msg-mermaid-switch" v-if="language == 'mermaid'">
				<text class="uni-code-msg-mermaid-item" :class="showMermaidImage ? 'uni-code-msg-mermaid-item-active' : ''" @click="showMermaidImage = true">图表</text>
				<text class="uni-code-msg-mermaid-item" :class="!showMermaidImage ? 'uni-code-msg-mermaid-item-active' : ''" @click="showMermaidImage = false">代码</text>
			</view>
			<template v-if="!showMermaidImage">
				<text class="uni-code-msg-language">{{language}}</text>
				<view class="uni-code-msg-copy-btn" @click="copyCode">
					<uni-ai-icon class="uni-code-msg-copy-icon" code="e60c" size="12" color="var(--text-primary)"/>
					<text class="uni-code-msg-copy-text">复制代码</text>
				</view>
			</template>
		</view>
		<view v-if="language == 'mermaid' && showMermaidImage" class="uni-code-msg-mermaid-image-box" :style="mermaidBoxStyle">
			<!-- #ifdef uniVersion < 4.81 && APP-IOS || MP-WEIXIN -->
				<!-- #ifdef MP-WEIXIN -->
				<text class="uni-code-msg-not-support-tip">小程序端不支持图表渲染</text>
				<!-- #endif -->
				<!-- #ifndef MP-WEIXIN -->
				<text class="uni-code-msg-not-support-tip">当前 HBuilderX 版本低于 4.81，暂不支持图表渲染</text>
				<!-- #endif -->
			<!-- #endif -->
			<!-- mermaid 渲染失败：href 始终为空时给提示并可切代码 Tab，不渲染破图 -->
			<view v-if="mermaidFailed" class="uni-code-msg-mermaid-failed">
				<text class="uni-code-msg-not-support-tip">图表渲染失败，可切换到「代码」查看源码</text>
			</view>
			<template v-for="(mermaidInfo, i) in mermaidInfos" :key="i">
				<image @click="previewMermaidImage" class="uni-code-msg-mermaid-image" mode="widthFix"
					v-if="mermaidInfo.renderd" :src="mermaidInfo.href" :style="{opacity: mermaidInfo.show ? 1 : 0}"
				/>
			</template>
		</view>
		<scroll-view v-else class="uni-code-msg-code-scroll-view" direction="horizontal">
			<text v-if="props.codeTokens.length == 0" class="uni-code-msg-origin-code" :style="{width: maxLineWidth}">{{ safeCodeText }}</text>
			<text v-else class="uni-code-msg-line" v-for="(tokens,index) in props.codeTokens" :key="index" :style="{width: maxLineWidth}">
				<text v-for="token in tokens" :key="token.uniqueId" :class="'uni-code-msg-line-code uni-code-msg-code-' + (token.className ?? '')">{{token.text}}</text>
			</text>
		</scroll-view>
	</view>
</template>

<script lang="uts" setup>
import { MarkdownToken as IToken } from '@/uni_modules/uni-cmark'
import {uiTheme} from '@/uni_modules/uni-ai-x/sdk';
import proxyWeb from '@/uni_modules/uni-ai-x/sdk/proxy-web.uts'

type UniAiMsgCodeProps = {
	codeText?: string
	codeTokens?: IToken[][]
	language?: string
	href?: string
	/** mermaid 出图真实宽高（renderMermaid 回传），用于容器自适应 */
	width?: number
	height?: number
}

const props = withDefaults(defineProps<UniAiMsgCodeProps>(), {
	codeText: `
	import App from './App.uvue'
	// 注释：这是注释的内容
	import { createSSRApp } from 'vue'
	export function createApp() {
		const app = createSSRApp(App)
		return {
			app
		}
	}
`,
	codeTokens: () => [] as IToken[][],
	language: 'text',
	href: null,
	width: 0,
	height: 0
})

type Mermaid = {
	href: string
	show: boolean
	renderd: boolean
}
const mermaidInfos = reactive<Mermaid[]>([])
watch((): string | null => props.href, (href: string | null) => {
	if (href == null) return
	if (`${href}`.length == 0) return
	// vapor: 直接改 reactive 数组元素属性（.show/.renderd）不触发重渲染（uts class[]/对象元素限制），
	// 流式多次回填会堆叠多张图且最新张 opacity 卡 0。改为只保留最新一张，splice 整体替换保证重渲染。
	const next: Mermaid = {
		href,
		renderd: true,
		show: true,
	}
	if (mermaidInfos.length > 0) {
		mermaidInfos.splice(0, mermaidInfos.length, next)
	} else {
		mermaidInfos.push(next)
	}
}, {immediate: true})

// vapor: 父组件 token.href 在回调里后写，reactive 元素属性变更不触发 prop 更新（下游 watch 收不到）。
// 组件自带 codeText，自己拉 mermaid 图，splice 填 mermaidInfos 保证上屏（不依赖父 prop）。
// ⚠ trailing debounce：流式每 chunk 都改 codeText，逐 chunk 调 proxy 会灌满串行 mermaidQueue
// → CPU 峰值 + 半截图闪烁。改为 codeText 停止变化 400ms 后渲染一次（最终完整图），保证上屏。
// 改动 mermaid 渲染触发逻辑，需 vapor 真机复核（确认图仍正常上屏）。
const mermaidRenderTimer = ref<number>(-1)
watch((): string => props.codeText, (codeText: string) => {
	if (props.language != 'mermaid') return
	if (codeText == null) return
	if (codeText.length == 0) return
	if (mermaidRenderTimer.value != -1) clearTimeout(mermaidRenderTimer.value)
	mermaidRenderTimer.value = setTimeout((): void => {
		mermaidRenderTimer.value = -1
		const param = new UTSJSONObject()
		param["action"] = "renderMermaid"
		param["mermaidText"] = codeText
		proxyWeb.callMethod(param, (res: UTSJSONObject): void => {
			const img = res["imageDataURL"]
			if (img != null && `${img}`.length > 0) {
				const next: Mermaid = {
					href: `${img}`,
					renderd: true,
					show: true,
				}
				if (mermaidInfos.length > 0) {
					mermaidInfos.splice(0, mermaidInfos.length, next)
				} else {
					mermaidInfos.push(next)
				}
			}
		})
	}, 400)
}, {immediate: true})
onUnmounted(() => {
	if (mermaidRenderTimer.value != -1) {
		clearTimeout(mermaidRenderTimer.value)
		mermaidRenderTimer.value = -1
	}
})

const tokens = ref<Array<IToken>>([])
const tokensLines = ref<IToken[][]>([])
const maxLineWidth = ref<string>('')
const showMermaidImage = ref<boolean>(false)

/** 避免 null codeText 导致 split / 渲染异常 */
const safeCodeText = computed<string>(() => {
	const text = props.codeText
	if (text == null) return ''
	return text
})

/** mermaid 容器自适应：按真实宽高比给高度（widthFix 下高度随宽度自适应），超高图限最大高，可点击放大 */
const mermaidBoxStyle = computed<string>(() => {
	// widthFix 模式下 image 高度随宽度按宽高比自适应，容器无需写死高；仅在有宽高时给一个最小高避免塌陷
	const w = props.width ?? 0
	const h = props.height ?? 0
	if (w > 0 && h > 0) {
		// 宽高比过大（超宽图）或超高图，给最小高；实际高度由 widthFix 按比例撑开
		return 'min-height:80px;'
	}
	return 'min-height:120px;'
})

/** mermaid 渲染失败/未出图：图表 Tab 下没有任何成功出图（href 为空），显示提示而非破图 */
const mermaidFailed = computed<boolean>(() => {
	if (props.language != 'mermaid') return false
	// 已有任何一张出图则不算失败
	for (let i = 0; i < mermaidInfos.length; i++) {
		if (mermaidInfos[i].renderd == true) return false
	}
	// href 有值但尚未进入 mermaidInfos（watch 尚未触发）也不算失败
	const href = props.href
	if (href != null && `${href}`.length > 0) return false
	return true
})

watch((): string => props.language, (language: string) => {
	showMermaidImage.value = language == 'mermaid'
	//#ifdef uniVersion < 4.81 && APP-IOS || MP-WEIXIN
	showMermaidImage.value = false
	//#endif
}, {immediate: true})

/**
 * 按最长行估算内容宽度，供 horizontal scroll-view 产生横向溢出。
 * H5 纯文本路径必须算宽；App 高亮路径在 4.81+ 可用 auto。
 */
function updateMaxLineWidthFromText(codeText: string) {
	const text = codeText != null ? codeText : ''
	const codeTextLines = text.split('\n')
	let lastMaxLineSize = 0
	for (let i = 0; i < codeTextLines.length; i++) {
		const lineSize = codeTextLines[i].length
		if (lastMaxLineSize < lineSize) {
			lastMaxLineSize = lineSize
		}
	}
	// 14px 等宽约 8.5~9px/字，取 9 保证略宽于实际以便横向滚动
	maxLineWidth.value = lastMaxLineSize > 0 ? `${lastMaxLineSize * 9}px` : '100%'
}

//#ifdef uniVersion < 4.81
let lastDiffLineIndex = 0
let lastMaxLineSize = 0
watch((): string => props.codeText, (codeText: string) => {
	let isAndroidOrWeb: boolean = false
	// #ifdef APP-ANDROID || WEB
	isAndroidOrWeb = true
	// #endif
	const text = codeText != null ? codeText : ''
	if (!isAndroidOrWeb || (props.codeTokens.length == 0 && text.length > 0)) {
		const codeTextLines = text.split('\n')
		for (let i = lastDiffLineIndex; i < codeTextLines.length; i++) {
			const lineSize = codeTextLines[i].length
			if (maxLineWidth.value == '' || lastMaxLineSize < lineSize) {
				lastMaxLineSize = lineSize
				maxLineWidth.value = `${lastMaxLineSize * 16}px`
			}
		}
		lastDiffLineIndex = codeTextLines.length - 1
	}
	tokensLines.value = props.codeTokens
}, {immediate: true})
// #endif
// #ifdef uniVersion >= 4.81 || MP-WEIXIN
// #ifdef WEB
// H5 走纯文本：必须显式宽度，width:auto 时内容被压进视口，无法横向滚动
watch((): string => safeCodeText.value, (codeText: string) => {
	updateMaxLineWidthFromText(codeText)
}, {immediate: true})
// #endif
// #ifndef WEB
maxLineWidth.value = 'auto'
// #endif
// #endif

const copyCode = () => {
	uni.setClipboardData({
		data: safeCodeText.value,
		success: () => {
			uni.showToast({
				title: '代码已复制到剪贴板',
				icon: 'success'
			})
		},
		fail: () => {
			uni.showToast({
				title: '复制失败',
				icon: 'none'
			})
		}
	})
}

const previewMermaidImage = () => {
	// mermaid 图由组件自拉进 mermaidInfos（props.href 在 vapor 下恒空），取当前渲染那张的 href 预览
	let src = ''
	for (let i = 0; i < mermaidInfos.length; i++) {
		if (mermaidInfos[i].renderd == true && mermaidInfos[i].href.length > 0) {
			src = mermaidInfos[i].href
			break
		}
	}
	// 兜底：父组件若传了 href
	if (src.length == 0 && props.href != null) {
		src = `${props.href}`
	}
	if (src.length > 0) {
		uni.previewImage({
			urls: [src]
		})
	}
}
</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
@font-face {
	// #ifdef WEB
	font-display: swap;
	// #endif
	font-family: CodeFontFamily;
	// #ifndef MP-WEIXIN
	src: url('/uni_modules/uni-ai-x/static/font/FiraCode-Regular.ttf') format('truetype');
	// #endif
}
// 浅色主题类
.ui-theme-light {
  /* 代码高亮颜色 - 浅色主题 */
  --code-keyword: #1a237e;
  --code-string: #b71c1c;
  --code-comment: #757575;
  --code-meta: #ad1457;
  --code-storage: #1976d2;
  --code-entity: #00897b;
  --code-support: #00897b;
  --code-constant: #388e3c;
  --code-variable: #1565c0;
  --code-punctuation: #333;
  --code-function: #fbc02d;
}

// 深色主题类
.ui-theme-dark {
  /* 代码高亮颜色 - 深色主题 */
  --code-keyword: #4fc1ff;
  --code-string: #ff8a80;
  --code-comment: #81c784;
  --code-meta: #e1bee7;
  --code-storage: #4fc1ff;
  --code-entity: #80deea;
  --code-support: #80deea;
  --code-constant: #81d4fa;
  --code-variable: #b3e5fc;
  --code-punctuation: #f5f5f5;
  --code-function: #fff59d;
}
.uni-code-msg-root {
	width: 100%;
	margin-bottom: 5px;
	background-color: var(--bg-secondary);
	border-radius: 6px;
	border: 1px solid var(--border-color);
}

.uni-code-msg-code-header {
	width: 100%;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 4px 10px;
	background-color: var(--bg-tertiary);
}

.uni-code-msg-mermaid-switch {
	flex-direction: row;
	border-radius: 6px;
	padding: 2px 0;
	background-color: var(--border-color);
}

.uni-code-msg-mermaid-item {
	padding: 4px 10px;
	margin: 0 1px;
	border-radius: 6px;
	font-size: 12px;
	color: var(--text-secondary);
}

.uni-code-msg-mermaid-item-active {
	background-color: var(--bg-primary);
	color: var(--text-primary);
}

.uni-code-msg-language {
	font-size: 12px;
	color: var(--text-primary);
}

.uni-code-msg-copy-btn {
	flex-direction: row;
	align-items: center;
	padding: 2px 4px;
	border-radius: 4px;
}

.uni-code-msg-copy-text {
	font-size: 10px;
	color: var(--text-primary);
	margin-left: 2px;
}

.uni-code-msg-mermaid-image-box {
	/* 去 400px 写死：随 widthFix 图片按真实宽高比自适应；超高图由最大高限高，可点击放大 */
	background-color: #FFF;
	align-items: center;
	max-height: 600px;
	overflow: hidden;
}

.uni-code-msg-not-support-tip {
	font-size: 12px;
	color: var(--warning-color);
	margin-top: 10px;
}

.uni-code-msg-mermaid-failed {
	padding: 24px 16px;
	align-items: center;
}

.uni-code-msg-mermaid-image {
	/* widthFix：宽度铺满，高度按宽高比自适应 */
	width: 100%;
}

.uni-code-msg-code-scroll-view {
	padding: 16rpx 0;
	height: auto;
	/* 内容自适应高度：min-height 兜底，避免 App 端 scroll-view 高度塌陷 */
	min-height: 72rpx;
	width: 100%;
	transition: height 0.2s linear;
}

.uni-code-msg-line,
.uni-code-msg-origin-code {
	padding: 0 15px;
}

.uni-code-msg-line {
	height: 22px;
	/* pre：保留代码缩进/空格（nowrap 会折叠连续空格导致代码左排列）；配合外层 horizontal scroll-view 横向滚动 */
	white-space: pre;
	align-self: flex-start;
}

.uni-code-msg-line-code {
	/* pre：保留 token 内缩进/空格，避免代码格式化丢失 */
	white-space: pre;
	font-family: CodeFontFamily;
	font-size: 14px;
	color: var(--text-primary);
}

.uni-code-msg-code-keyword { color: var(--code-keyword); }
.uni-code-msg-code-string { color: var(--code-string); }
.uni-code-msg-code-comment { color: var(--code-comment); }
.uni-code-msg-code-meta { color: var(--code-meta); }
.uni-code-msg-code-storage { color: var(--code-storage); }
.uni-code-msg-code-entity { color: var(--code-entity); }
.uni-code-msg-code-support { color: var(--code-support); }
.uni-code-msg-code-constant { color: var(--code-constant); }
.uni-code-msg-code-variable { color: var(--code-variable); }
.uni-code-msg-code-punctuation { color: var(--code-punctuation); }
.uni-code-msg-code-function { color: var(--code-function); }

.uni-code-msg-origin-code {
	color: var(--text-primary);
	height: 100%;
	font-size: 14px;
	align-self: flex-start;
	line-height: 22px;
	font-family: CodeFontFamily;
	overflow: visible;
	/* #ifdef H5 || WEB */
	/* H5 text 默认折叠换行；pre 才能多行展示并撑开横向滚动宽度 */
	white-space: pre;
	display: block;
	/* #endif */
}

</style>
