    background-color: #eceaf1;
  }

  .im-body {
    flex: 1;
    min-height: 0;
  }

  .im-state {
    padding: 200rpx 48rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .im-state__text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #94929c;
  }

  .im-foot {
    padding: 28rpx 0 44rpx;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .im-foot__text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #c0bec8;
  }

  /* ===== 会话 / 联系人通用行 ===== */
  .chat-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 38rpx 32rpx;
  }

  .chat-item--active {
    background-color: #f4f3f8;
  }

  .chat-item__avatar-wrap {
    position: relative;
    width: 112rpx;
    height: 112rpx;
    margin-right: 28rpx;
    flex-shrink: 0;
  }

  .chat-item__avatar {
    width: 112rpx;
    height: 112rpx;
    border-radius: 56rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-item__avatar-letter {
    font-size: 48rpx;
    line-height: 56rpx;
    font-weight: 600;
    color: #ffffff;
  }

  .chat-item__badge {
    position: absolute;
    top: -8rpx;
    right: -10rpx;
    min-width: 38rpx;
    height: 38rpx;
    padding: 0 10rpx;
    border-radius: 20rpx;
    background-color: #ff4d4f;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-item__badge-text {
    font-size: 22rpx;
    line-height: 26rpx;
    font-weight: 600;
    color: #ffffff;
  }

  .chat-item__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .chat-item__title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .chat-item__title {
    flex: 1;
    font-size: 34rpx;
    line-height: 44rpx;
    font-weight: 600;
    color: #141416;
  }

  .chat-item__time {
    margin-left: 16rpx;
    flex-shrink: 0;
    font-size: 27rpx;
    line-height: 36rpx;
    color: #94929c;
  }

  .chat-item__sub {
    margin-top: 12rpx;
    font-size: 29rpx;
    line-height: 40rpx;
    color: #94929c;
  }

  .chat-divider {
    height: 2rpx;
    margin-left: 172rpx;
    background-color: #f0eff4;
  }

  /* ===== 会话行左滑操作（置顶 / 免打扰 / 删除，微信同款：按钮层盖在行内容上方）===== */
  .chat-swipe {
    position: relative;
    overflow: hidden;
  }

  .chat-swipe__acts {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: row;
  }

  .chat-swipe__act {
    width: 140rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* 按钮底色（蓝=主操作、橙=次操作、红=危险操作，取自头像渐变同色系；
     会话行蓝=置顶/橙=免打扰/红=删除，联系人行蓝=发消息/橙=修改备注/红=删除或撤回） */
  .chat-swipe__act--blue {
    background-color: #4a7fd9;
  }

  .chat-swipe__act--amber {
    background-color: #e0942e;
  }

  .chat-swipe__act--danger {
    background-color: #e05f5f;
  }

  /* 单按钮行（撤回申请）：整行一个宽按钮 */
  .chat-swipe__act--wide {
    width: 220rpx;
  }

  .chat-swipe__act-text {
    font-size: 26rpx;
    line-height: 36rpx;
    font-weight: 500;
    color: #ffffff;
  }

  /* 置顶 / 免打扰状态图标（名称前） */
  .chat-item__mark {
    width: 28rpx;
    height: 28rpx;
    margin-right: 8rpx;
    flex-shrink: 0;
  }

  /* ===== 智联录分组 ===== */
  .contact-group {
    display: flex;
    flex-direction: column;
  }

  .contact-group__title {
    padding: 24rpx 32rpx 8rpx;
    font-size: 26rpx;
    line-height: 36rpx;
    color: #94929c;
  }

  /* ===== 我的群组折叠分类 ===== */
  .group-header {
    padding: 24rpx 32rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .group-header--active {
    background-color: #f4f3f8;
  }

  .group-header__icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 12rpx;
    flex-shrink: 0;
  }

  .group-header__title {
    font-size: 28rpx;
    line-height: 40rpx;
    font-weight: 600;
    color: #1c1b20;
  }

  .group-header__count {
    margin-left: 12rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #94929c;
  }

  .group-header__spacer {
    flex: 1;
  }

  .group-row__count {
    margin-top: 12rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #94929c;
  }

  .contact-tag {
    margin-left: 16rpx;
    padding: 4rpx 16rpx;
    border-radius: 10rpx;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .contact-tag__text {
    font-size: 22rpx;
    line-height: 30rpx;
  }

  .contact-tag--expert {
    background-color: #eef0ff;
  }

  .contact-tag__text--expert {
    color: #5a67d9;
  }

  .contact-tag--user {
    background-color: #f0eff4;
  }

  .contact-tag__text--user {
    color: #94929c;
  }

  .contact-tag--warn {
    background-color: #fff3e9;
  }

  .contact-tag__text--warn {
    color: #e0942e;
  }

  .contact-tag--muted {
    background-color: #f0eff4;
  }

  .contact-tag__text--muted {
    color: #94929c;
  }

  /* 群主徽章：蓝紫色调，对齐 PC 端智联录群组列表 */
  .contact-tag--owner {
    background-color: #eef0ff;
  }

  .contact-tag__text--owner {
    color: #5a67d9;
  }
</style>

