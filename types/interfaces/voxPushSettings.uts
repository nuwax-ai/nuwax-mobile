/**
 * Nuwax Vox 设备语音网关 - 会议推送设置接口类型
 * 接口文档: GET/PUT /api/app/meeting/push-settings
 */

/** 会议推送设置（渠道开关 + 推送策略） */
export interface IAppMeetingPushSettingsView {
  appEnabled: boolean;
  emailEnabled: boolean;
  feishuEnabled: boolean;
  wecomEnabled: boolean;
  dingtalkEnabled: boolean;
  // 推送策略，目前仅支持 AFTER_EACH_MEETING
  pushStrategy: string;
}

/**
 * 更新会议推送设置请求（PUT；未传字段保持原值）
 * 用 class：Android 上需显式 build body，避免序列化出多余的 null 字段
 */
export class AppMeetingPushSettingsUpdateParams {
  appEnabled: boolean | null = null;
  emailEnabled: boolean | null = null;
  feishuEnabled: boolean | null = null;
  wecomEnabled: boolean | null = null;
  dingtalkEnabled: boolean | null = null;
  pushStrategy: string | null = null;
}
