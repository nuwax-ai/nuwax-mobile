import { MsgItem, markdownElItem } from '@/types/interfaces/ai-msg'
import { MessageInfo } from '@/types/interfaces/conversationInfo'
import { AssistantRoleEnum, MessageModeEnum, MessageTypeEnum } from '@/types/enums/agent'
import { MessageStatusEnum } from '@/types/enums/common'
import { defaultString } from '@/utils/common'

/**
 * SSE data 载荷
 */
export interface SSEChunkData {
  id: string;
  role: string;
  type: string;
  text: string;
  time: string | null;
  attachments: any[] | null;
  think: string | null;
  quotedText: string | null;
  ext: any[] | null;
  finished: boolean;
  executeId: string | null;
  messageType: string;
}

/**
 * SSE数据块接口 - 匹配实际返回的数据结构
 */
export interface SSEChunk {
  requestId: string;
  messageType?: string;
  message_type?: string;
  subType?: string;
  sub_type?: string;
  eventType: string;
  error: string | null;
  data: SSEChunkData;
  completed: boolean;
}

/**
 * 聊天数据适配器
 * 用于将MessageInfo格式转换为uni-ai-x期望的MsgItem格式
 */
export class ChatDataAdapter {
  private static buildMsgItem(
    _id: string,
    from_uid: string,
    body: string,
    create_time: number,
    state: number,
    chat_id: string,
    markdownElList: markdownElItem[],
    processingList: any[],
  ): MsgItem {
    const msgItem = new MsgItem()
    msgItem._id = _id
    msgItem.from_uid = from_uid
    msgItem.body = body
    msgItem.create_time = create_time
    msgItem.state = state
    msgItem.chat_id = chat_id
    msgItem.markdownElList = markdownElList
    msgItem.processingList = processingList
    msgItem.rendered = false
    return msgItem
  }

  /**
   * 判断SSE数据块是否可以按聊天文本消息渲染
   */
  static isRenderableSSEChunk(chunk: SSEChunk): boolean {
    const chunkAny = chunk as UTSJSONObject
    const messageType = defaultString(
      chunkAny["messageType"] != null ? chunkAny["messageType"] : chunkAny["message_type"],
      "",
    )
    if (messageType === 'acpRequestPermission') {
      return false
    }

    const data = chunkAny["data"]
    if (data == null || typeof data !== 'object') {
      return false
    }

    const dataObj = data as UTSJSONObject
    const idVal = dataObj["id"]
    return typeof idVal === 'string' && idVal.length > 0
  }
  
  /**
   * 将SSE数据块转换为MsgItem
   * @param chunk SSE数据块
   * @param chatId 聊天ID
   * @returns uni-ai-x的MsgItem格式
   */
  static convertSSEChunkToMsgItem(chunk: SSEChunk, chatId: string): MsgItem {
    console.log(`Converting SSE chunk to MsgItem:`, chunk)
    const chunkAny = chunk as UTSJSONObject
    const dataRaw = chunkAny["data"]
    const data = dataRaw != null ? (dataRaw as UTSJSONObject) : (new UTSJSONObject())

    const idVal = data["id"]
    const finishedVal = data["finished"]
    const msgItem = this.buildMsgItem(
      idVal != null ? `${idVal}` : this.generateId(),
      this.getFromUidFromRole(defaultString(data["role"], 'ASSISTANT')),
      defaultString(data["text"], ''),
      this.parseTime(data["time"] as string | null),
      finishedVal == true ? 3 : 2,
      chatId,
      [] as markdownElItem[],
      [],
    )
    
    console.log(`Converted MsgItem:`, msgItem)
    return msgItem
  }
  
  /**
   * 将MessageInfo转换为MsgItem
   * @param messageInfo 消息信息
   * @returns uni-ai-x的MsgItem格式
   */
  static convertToMsgItem(messageInfo: MessageInfo): MsgItem {
    const markdownElListVal = messageInfo.markdownElList
    const markdownElList =
      markdownElListVal != null ? markdownElListVal as markdownElItem[] : [] as markdownElItem[]
    const processingListVal = messageInfo.processingList
    const processingList =
      processingListVal != null ? processingListVal as any[] : [] as any[]
    const msgItem = this.buildMsgItem(
      defaultString(messageInfo.id?.toString(), ''),
      this.getFromUid(messageInfo.role),
      defaultString(messageInfo.text, ''),
      this.parseTime(messageInfo.time),
      this.getMsgState(messageInfo.status),
      '',
      markdownElList,
      processingList,
    )

    return msgItem
  }
  
  /**
   * 将MsgItem转换为MessageInfo
   * @param msgItem uni-ai-x的MsgItem格式
   * @returns MessageInfo格式
   */
  static convertToMessageInfo(msgItem: MsgItem): MessageInfo {
    const messageInfo = new UTSJSONObject()
    messageInfo["id"] = msgItem._id as any
    messageInfo["role"] = this.getAssistantRole(msgItem.from_uid) as any
    messageInfo["type"] = this.getMessageMode(msgItem.from_uid) as any
    messageInfo["text"] = msgItem.body as any
    messageInfo["think"] = defaultString(msgItem.thinkContent, '') as any
    messageInfo["time"] = new Date(msgItem.create_time).toISOString() as any
    messageInfo["attachments"] = [] as any[]
    messageInfo["ext"] = [] as any[]
    messageInfo["finished"] = false as any
    messageInfo["metadata"] = null as any
    messageInfo["messageType"] = MessageTypeEnum.USER as any
    messageInfo["status"] = this.getMessageStatus(msgItem.state) as any
    messageInfo["markdownElList"] =
      (msgItem.markdownElList != null ? msgItem.markdownElList : [] as markdownElItem[]) as any
    messageInfo["processingList"] = [] as any[]
    messageInfo["finalResult"] = null as any
    messageInfo["requestId"] = '' as any

    return messageInfo as MessageInfo
  }
  
  /**
   * 批量转换MessageInfo数组为MsgItem数组
   * @param messageList 消息列表
   * @param chatId 聊天ID
   * @returns MsgItem数组
   */
  static convertMessageListToMsgItems(messageList: MessageInfo[], chatId: string = ''): MsgItem[] {
    return messageList.map(message => {
      const msgItem = this.convertToMsgItem(message)
      msgItem.chat_id = chatId
      return msgItem
    })
  }
  
  /**
   * 批量转换MsgItem数组为MessageInfo数组
   * @param msgItems 消息项数组
   * @returns MessageInfo数组
   */
  static convertMsgItemsToMessageList(msgItems: MsgItem[]): MessageInfo[] {
    return msgItems.map(msgItem => this.convertToMessageInfo(msgItem))
  }
  
  /**
   * 处理SSE流式数据，累积文本内容
   * @param chunks SSE数据块数组
   * @param chatId 聊天ID
   * @returns 处理后的MsgItem数组
   */
  static processSSEChunks(chunks: SSEChunk[], chatId: string): MsgItem[] {
    const messageMap = new Map<string, MsgItem>()
    
    chunks.forEach(chunk => {
      if (!this.isRenderableSSEChunk(chunk)) {
        return
      }

      const messageId = chunk.data.id
      
      if (!messageMap.has(messageId)) {
        // 创建新消息
        const msgItem = this.convertSSEChunkToMsgItem(chunk, chatId)
        messageMap.set(messageId, msgItem)
      } else {
        // 累积文本内容
        const existingMsg = messageMap.get(messageId)!
        existingMsg.body += defaultString(chunk.data.text, '')
        
        // 更新状态
        if (chunk.data.finished) {
          existingMsg.state = 3 // 完成状态
        }
      }
    })
    
    // 兼容性处理：将Map值转换为数组
    const result: MsgItem[] = []
    messageMap.forEach((value, _key) => {
      result.push(value)
    })
    
    return result
  }
  
  /**
   * 根据角色获取from_uid
   * @param role 角色
   * @returns from_uid
   */
  private static getFromUid(role: AssistantRoleEnum): string {
    switch (role) {
      case AssistantRoleEnum.USER:
        return 'user'
      case AssistantRoleEnum.ASSISTANT:
        return 'uni-ai'
      case AssistantRoleEnum.SYSTEM:
        return 'system'
      case AssistantRoleEnum.FUNCTION:
        return 'tool'
      default:
        return 'user'
    }
  }
  
  /**
   * 根据角色字符串获取from_uid
   * @param role 角色字符串
   * @returns from_uid
   */
  private static getFromUidFromRole(role: string): string {
    switch (role) {
      case 'USER':
        return 'user'
      case 'ASSISTANT':
        return 'uni-ai'
      case 'SYSTEM':
        return 'system'
      case 'FUNCTION':
        return 'tool'
      default:
        return 'user'
    }
  }
  
  /**
   * 根据from_uid获取角色
   * @param fromUid from_uid
   * @returns 角色
   */
  private static getAssistantRole(fromUid: string): AssistantRoleEnum {
    switch (fromUid) {
      case 'user':
        return AssistantRoleEnum.USER
      case 'uni-ai':
        return AssistantRoleEnum.ASSISTANT
      case 'system':
        return AssistantRoleEnum.SYSTEM
      case 'tool':
        return AssistantRoleEnum.FUNCTION
      default:
        return AssistantRoleEnum.USER
    }
  }
  
  /**
   * 根据from_uid获取消息模式
   * @param fromUid from_uid
   * @returns 消息模式
   */
  private static getMessageMode(fromUid: string): MessageModeEnum {
    switch (fromUid) {
      case 'user':
        return MessageModeEnum.CHAT
      case 'uni-ai':
        return MessageModeEnum.ANSWER
      case 'system':
        return MessageModeEnum.GUID
      case 'tool':
        return MessageModeEnum.CHAT
      default:
        return MessageModeEnum.CHAT
    }
  }
  
  /**
   * 根据消息状态获取MsgItem状态
   * @param status 消息状态
   * @returns MsgItem状态
   */
  private static getMsgState(status?: MessageStatusEnum | null): number {
    if (status == MessageStatusEnum.Loading) {
      return 1 // 加载中
    }
    if (status == MessageStatusEnum.Incomplete) {
      return 2 // 未完成
    }
    if (status == MessageStatusEnum.Complete) {
      return 3 // 完成
    }
    if (status == ('error' as MessageStatusEnum)) {
      return 4 // 错误
    }
    return 3 // 默认完成
  }
  
  /**
   * 根据MsgItem状态获取消息状态
   * @param state MsgItem状态
   * @returns 消息状态
   */
  private static getMessageStatus(state: number): MessageStatusEnum | null {
    if (state == 1) {
      return MessageStatusEnum.Loading
    }
    if (state == 2) {
      return MessageStatusEnum.Incomplete
    }
    if (state == 3) {
      return MessageStatusEnum.Complete
    }
    if (state == 4) {
      return 'error' as MessageStatusEnum
    }
    return null
  }
  
  /**
   * 解析时间字符串为时间戳
   * @param timeStr 时间字符串
   * @returns 时间戳
   */
  private static parseTime(timeStr: string | null): number {
    if (timeStr == null || timeStr.length == 0) return Date.now()
    
    try {
      return new Date(timeStr).getTime()
    } catch (error) {
      return Date.now()
    }
  }
  
  /**
   * 创建新的用户消息
   * @param content 消息内容
   * @param chatId 聊天ID
   * @param attachments 附件
   * @returns 新的MsgItem
   */
  static createUserMessage(content: string, chatId: string): MsgItem {
    return this.buildMsgItem(
      this.generateId(),
      'user',
      content,
      Date.now(),
      3,
      chatId,
      [] as markdownElItem[],
      [],
    )
  }
  
  /**
   * 创建新的AI消息
   * @param content 消息内容
   * @param chatId 聊天ID
   * @param markdownElements markdown元素
   * @returns 新的MsgItem
   */
  static createAIMessage(content: string, chatId: string, markdownElements: markdownElItem[]): MsgItem {
    const elements = markdownElements != null ? markdownElements : [] as markdownElItem[]
    return this.buildMsgItem(
      this.generateId(),
      'uni-ai',
      content,
      Date.now(),
      2,
      chatId,
      elements,
      [],
    )
  }
  
  /**
   * 生成唯一ID
   * @returns 唯一ID
   */
  private static generateId(): string {
    // #ifdef MP-WEIXIN
    // 微信小程序中，uni.getRandomValues返回Promise，这里简化处理
    return Date.now().toString() + Math.random().toString(36).substring(2, 11)
    // #endif
    
    // #ifdef H5
    // 这里需要导入uuid库
    return Date.now().toString() + Math.random().toString(36).substring(2, 11)
    // #endif
    
    // 默认返回值
    return Date.now().toString() + Math.random().toString(36).substring(2, 11)
  }
}

// 导出适配器实例
export const chatDataAdapter = new ChatDataAdapter()

