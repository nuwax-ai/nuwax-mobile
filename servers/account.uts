import request from "./useRequest";
import { RequestResponse } from "../types/interfaces/request";
import type {
  BindEmailParams,
  CodeLogin,
  ILoginResult,
  LoginFieldType,
  ResetPasswordParams,
  SendCode,
  SetPasswordParams,
  TenantConfigInfo,
  UserInfo,
  UserUpdateParams,
  WechatLoginParams,
  IWechatLoginResult,
} from "@/types/interfaces/login";

// 租户配置信息查询接口
export async function apiTenantConfig(): Promise<RequestResponse<TenantConfigInfo>> {
  const res = await request({
    url: "/api/tenant/config",
    method: "GET",
  });
  return res as RequestResponse<TenantConfigInfo>;
}

// 查询当前登录用户信息
export async function apiUserInfo(): Promise<RequestResponse<UserInfo>> {
  const res = await request({
    url: "/api/user/getLoginInfo",
    method: "GET",
  });
  return res as RequestResponse<UserInfo>;
}

// 微信登录
export async function apiWechatLogin(data: WechatLoginParams): Promise<RequestResponse<IWechatLoginResult>> {
  const res = await request({
    url: "/api/user/mp/codeLogin",
    method: "POST",
    data,
  });
  return res as RequestResponse<IWechatLoginResult>;
}

// 账号密码登录
export async function apiLogin(data: LoginFieldType): Promise<RequestResponse<ILoginResult>> {
  const res = await request({
    url: "/api/user/passwordLogin",
    method: "POST",
    data,
  });
  return res as RequestResponse<ILoginResult>;
}

// 发送验证码
export async function apiSendCode(data: SendCode): Promise<RequestResponse<null>> {
  const res = await request({
    url: "/api/user/code/send",
    method: "POST",
    data,
  });
  return res as RequestResponse<null>;
}

// 验证码登录/注册接口
export async function apiLoginCode(data: CodeLogin): Promise<RequestResponse<ILoginResult>> {
  const res = await request({
    url: "/api/user/codeLogin",
    method: "POST",
    data,
  });
  return res as RequestResponse<ILoginResult>;
}

// 首次登录设置密码
export async function apiSetPassword(data: SetPasswordParams): Promise<RequestResponse<null>> {
  const res = await request({
    url: "/api/user/password/set",
    method: "POST",
    data,
  });
  return res as RequestResponse<null>;
}

// 退出登录接口
export async function apiLogout(): Promise<RequestResponse<null>> {
  const res = await request({
    url: "/api/user/logout",
    method: "GET",
  });
  return res as RequestResponse<null>;
}

// 获取动态认证码
export async function apiUserDynamicCode(): Promise<RequestResponse<string>> {
  const res = await request({
    url: "/api/user/dynamicCode",
    method: "GET",
  });
  return res as RequestResponse<string>;
}
