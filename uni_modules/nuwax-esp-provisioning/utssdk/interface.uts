export type NativeEspSuccessCallback = (value: string) => void;
export type NativeEspFailureCallback = (code: string, message: string) => void;
export type NativeEspDeviceCallback = (
  deviceId: string,
  name: string,
  rssi: number,
  serviceUuid: string,
) => void;
export type NativeEspProgressCallback = (stage: string) => void;
/** 原生桥诊断日志回调（把 [EspBridge] 行转发到 UTS console.log，iOS 26 下 NSLog 不进 HBuilderX）。 */
export type NativeEspLogCallback = (message: string) => void;
