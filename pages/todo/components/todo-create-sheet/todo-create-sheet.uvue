<template>
  <uni-modal-popup
    ref="popupRef"
    position="bottom"
    :height="sheetHeight"
    :show-header="false"
    :body-scroll="false"
    :mask-click="true"
    @afterleave="resetForm"
  >
    <view class="todo-create">
      <view class="todo-create__header">
        <text class="todo-create__title">{{ t("Mobile.Discover.todoCreateTitle") }}</text>
        <view class="todo-create__close" @click="close">
          <svg-icon name="icon-X" size="18" unit="px" color="#1f2329" />
        </view>
      </view>

      <scroll-view
        class="todo-create__scroll"
        direction="vertical"
        :show-scrollbar="false"
        :bounces="false"
        :scroll-top="fieldScrollTop"
        :scroll-with-animation="true"
        :style="scrollStyle"
      >
        <text class="todo-create__label">{{ t("Mobile.Discover.todoContent") }}</text>
        <textarea
          class="todo-create__textarea"
          v-model="content"
          :maxlength="500"
          :placeholder="t('Mobile.Discover.todoContentPlaceholder')"
          placeholder-style="color: #c9cdd4; font-size: 15px;"
        />

        <view class="todo-create__label-row">
          <text class="todo-create__label todo-create__label--inline">{{ t("Mobile.Discover.todoAssignee") }}</text>
          <text class="todo-create__hint">{{ t("Mobile.Discover.todoAssigneeHint") }}</text>
        </view>
        <view class="todo-create__assignee-wrap">
          <view class="todo-create__assignee">
            <view class="todo-create__avatar">
              <svg-icon name="icon-User" size="14" unit="px" color="#ffffff" />
            </view>
            <text class="todo-create__assignee-name">{{ t("Mobile.Discover.todoAssigneeMe") }}</text>
          </view>
        </view>

        <text class="todo-create__label">{{ t("Mobile.Discover.todoDueDate") }}</text>
        <picker mode="date" :value="pickerDate" @change="onDueChange">
          <view class="todo-create__date">
            <svg-icon name="icon-Calendar" size="16" unit="px" color="#c9cdd4" />
            <text class="todo-create__date-text" :class="dueDate.length == 0 ? 'todo-create__date-text--placeholder' : ''">{{
              dueDate.length == 0 ? t("Mobile.Discover.todoDueDatePlaceholder") : dueDate
            }}</text>
          </view>
        </picker>

        <view class="todo-create__label-row">
          <text class="todo-create__label todo-create__label--inline">{{ t("Mobile.Discover.todoPriority") }}</text>
          <text class="todo-create__hint">{{ t("Mobile.Discover.todoPriorityHint") }}</text>
        </view>
        <view class="todo-create__seg">
          <view class="todo-create__seg-item" :class="priority == 'low' ? 'todo-create__seg-item--on' : ''" @click="setPriority('low')">
            <text class="todo-create__seg-text" :class="priority == 'low' ? 'todo-create__seg-text--on' : ''">{{ t("Mobile.Discover.todoPriorityLow") }}</text>
          </view>
          <view class="todo-create__seg-item" :class="priority == 'mid' ? 'todo-create__seg-item--on' : ''" @click="setPriority('mid')">
            <text class="todo-create__seg-text" :class="priority == 'mid' ? 'todo-create__seg-text--on' : ''">{{ t("Mobile.Discover.todoPriorityMid") }}</text>
          </view>
          <view class="todo-create__seg-item" :class="priority == 'high' ? 'todo-create__seg-item--on' : ''" @click="setPriority('high')">
            <text class="todo-create__seg-text" :class="priority == 'high' ? 'todo-create__seg-text--on' : ''">{{ t("Mobile.Discover.todoPriorityHigh") }}</text>
          </view>
        </view>
        <view v-if="priority == 'high'" class="todo-create__priority-warn">
          <text class="todo-create__priority-warn-text">{{ t("Mobile.Discover.todoPriorityHighWarn") }}</text>
        </view>

        <text class="todo-create__label">{{ t("Mobile.Discover.todoCompleteMode") }}</text>
        <view class="todo-create__seg">
          <view class="todo-create__seg-item" :class="completeMode == 'single' ? 'todo-create__seg-item--on' : ''" @click="setCompleteMode('single')">
            <text class="todo-create__seg-text" :class="completeMode == 'single' ? 'todo-create__seg-text--on' : ''">{{ t("Mobile.Discover.todoCompleteSingle") }}</text>
          </view>
          <view class="todo-create__seg-item" :class="completeMode == 'ratio' ? 'todo-create__seg-item--on' : ''" @click="setCompleteMode('ratio')">
            <text class="todo-create__seg-text" :class="completeMode == 'ratio' ? 'todo-create__seg-text--on' : ''">{{ t("Mobile.Discover.todoCompleteRatio") }}</text>
          </view>
          <view class="todo-create__seg-item" :class="completeMode == 'all' ? 'todo-create__seg-item--on' : ''" @click="setCompleteMode('all')">
            <text class="todo-create__seg-text" :class="completeMode == 'all' ? 'todo-create__seg-text--on' : ''">{{ t("Mobile.Discover.todoCompleteAll") }}</text>
          </view>
        </view>
        <view v-if="completeMode == 'ratio'" class="todo-create__ratio">
          <text class="todo-create__ratio-text">{{ t("Mobile.Discover.todoCompleteRatioLead") }}</text>
          <input class="todo-create__ratio-input" type="number" v-model="completeRatio" maxlength="3" />
          <text class="todo-create__ratio-text">{{ t("Mobile.Discover.todoCompleteRatioTail") }}</text>
        </view>

        <text class="todo-create__label">{{ t("Mobile.Discover.todoRemind") }}</text>
        <view class="todo-create__seg">
          <view class="todo-create__seg-item" :class="remind == 'due' ? 'todo-create__seg-item--on' : ''" @click="setRemind('due')">
            <text class="todo-create__seg-text" :class="remind == 'due' ? 'todo-create__seg-text--on' : ''">{{ t("Mobile.Discover.todoRemindDue") }}</text>
          </view>
          <view class="todo-create__seg-item" :class="remind == 'early' ? 'todo-create__seg-item--on' : ''" @click="setRemind('early')">
            <text class="todo-create__seg-text" :class="remind == 'early' ? 'todo-create__seg-text--on' : ''">{{ t("Mobile.Discover.todoRemindEarly") }}</text>
          </view>
        </view>
        <view v-if="remind == 'early'" class="todo-create__remind">
          <view class="todo-create__remind-row">
            <text class="todo-create__remind-text">{{ t("Mobile.Discover.todoRemindLead") }}</text>
            <input class="todo-create__remind-input" type="number" v-model="remindLead" maxlength="3" />
            <view class="todo-create__unit">
              <view class="todo-create__unit-item" :class="remindLeadUnit == 'minute' ? 'todo-create__unit-item--on' : ''" @click="setRemindLeadUnit('minute')">
                <text class="todo-create__unit-text" :class="remindLeadUnit == 'minute' ? 'todo-create__unit-text--on' : ''">{{ t("Mobile.Discover.todoRemindMinute") }}</text>
              </view>
              <view class="todo-create__unit-item" :class="remindLeadUnit == 'hour' ? 'todo-create__unit-item--on' : ''" @click="setRemindLeadUnit('hour')">
                <text class="todo-create__unit-text" :class="remindLeadUnit == 'hour' ? 'todo-create__unit-text--on' : ''">{{ t("Mobile.Discover.todoRemindHour") }}</text>
              </view>
            </view>
            <text class="todo-create__remind-text">{{ t("Mobile.Discover.todoRemindStart") }}</text>
          </view>
          <view class="todo-create__remind-row todo-create__remind-row--gap">
            <text class="todo-create__remind-text">{{ t("Mobile.Discover.todoRemindEvery") }}</text>
            <input class="todo-create__remind-input" type="number" v-model="remindEvery" maxlength="3" />
            <view class="todo-create__unit">
              <view class="todo-create__unit-item" :class="remindEveryUnit == 'minute' ? 'todo-create__unit-item--on' : ''" @click="setRemindEveryUnit('minute')">
                <text class="todo-create__unit-text" :class="remindEveryUnit == 'minute' ? 'todo-create__unit-text--on' : ''">{{ t("Mobile.Discover.todoRemindMinute") }}</text>
              </view>
              <view class="todo-create__unit-item" :class="remindEveryUnit == 'hour' ? 'todo-create__unit-item--on' : ''" @click="setRemindEveryUnit('hour')">
                <text class="todo-create__unit-text" :class="remindEveryUnit == 'hour' ? 'todo-create__unit-text--on' : ''">{{ t("Mobile.Discover.todoRemindHour") }}</text>
              </view>
            </view>
            <text class="todo-create__remind-text">{{ t("Mobile.Discover.todoRemindOnce") }}</text>
          </view>
        </view>

        <text class="todo-create__label">{{ t("Mobile.Discover.todoRequirements") }}</text>
        <view class="todo-create__switch-row">
          <view class="todo-create__switch-copy">
            <text class="todo-create__switch-title">{{ t("Mobile.Discover.todoRequireSubmit") }}</text>
            <text class="todo-create__switch-desc">{{ t("Mobile.Discover.todoRequireSubmitHint") }}</text>
          </view>
          <switch class="todo-create__switch" :checked="requireSubmit" color="#1f2329" @change="onRequireSubmitChange" />
        </view>

        <view class="todo-create__label-row">
          <text class="todo-create__label todo-create__label--inline">{{ t("Mobile.Discover.todoOtherFields") }}</text>
          <text class="todo-create__hint">{{ t("Mobile.Discover.todoOtherFieldsHint") }}</text>
        </view>
        <view v-for="field in extraFields" :key="field.id" class="todo-create__field">
          <input
            class="todo-create__field-name"
            v-model="field.name"
            :placeholder="t('Mobile.Discover.todoFieldName')"
            placeholder-style="color: #c9cdd4; font-size: 14px;"
          />
          <input
            class="todo-create__field-value"
            v-model="field.valueText"
            :placeholder="t('Mobile.Discover.todoFieldValue')"
            placeholder-style="color: #c9cdd4; font-size: 14px;"
          />
          <view class="todo-create__field-remove" @click="removeExtraField(field.id)">
            <text class="todo-create__field-remove-text">×</text>
          </view>
        </view>
        <view class="todo-create__add-field" @click="addExtraField">
          <text class="todo-create__add-field-text">+ {{ t("Mobile.Discover.todoAddField") }}</text>
        </view>
      </scroll-view>

      <view class="todo-create__footer">
        <view class="todo-create__submit" @click="submit">
          <text class="todo-create__submit-text">{{ t("Mobile.Discover.todoAddMine") }}</text>
        </view>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { computed, nextTick, ref, type ComponentPublicInstance } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const emit = defineEmits<{
    submit: [content: string];
  }>();

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  class TodoExtraField {
    id: number = 0;
    name: string = "";
    valueText: string = "";

    constructor(id: number) {
      this.id = id;
    }
  }

  const popupRef = ref<any | null>(null);
  /** 按窗口高度写死，避免百分比在 page-container 里失效后把页面撑高。 */
  const sheetHeight = ref<string>("92%");
  const scrollStyle = ref<string>("");
  const fieldScrollTop = ref<number>(0);
  const content = ref<string>("");
  const dueDate = ref<string>("");
  const priority = ref<string>("mid");
  const completeMode = ref<string>("single");
  const completeRatio = ref<string>("50");
  const remind = ref<string>("due");
  /** 提前多次提醒：提前量、间隔，单位为 minute / hour。 */
  const remindLead = ref<string>("15");
  const remindLeadUnit = ref<string>("minute");
  const remindEvery = ref<string>("30");
  const remindEveryUnit = ref<string>("minute");
  const requireSubmit = ref<boolean>(false);
  const extraFields = ref<TodoExtraField[]>([]);
  let extraFieldSeq = 0;

  const pickerDate = computed((): string => {
    if (dueDate.value.length > 0) {
      return dueDate.value;
    }
    const now = new Date();
    const month = now.getMonth() + 1;
    const day = now.getDate();
    const monthText = month < 10 ? "0" + `${month}` : `${month}`;
    const dayText = day < 10 ? "0" + `${day}` : `${day}`;
    return `${now.getFullYear()}-${monthText}-${dayText}`;
  });

  function measureSheet(): void {
    let windowHeight = 0;
    try {
      const info = uni.getSystemInfoSync();
      const raw = info.windowHeight;
      if (raw != null && raw > 0) {
        windowHeight = raw;
      }
    } catch (_e) {
      windowHeight = 0;
    }
    if (windowHeight <= 0) {
      sheetHeight.value = "92%";
      scrollStyle.value = "";
      return;
    }
    const sheet = Math.floor(windowHeight * 0.92);
    sheetHeight.value = `${sheet}px`;
    // 标题 56、底部按钮区约 80，其余留给表单滚动。
    let scroll = sheet - 136;
    if (scroll < 160) {
      scroll = 160;
    }
    scrollStyle.value = "height: " + `${scroll}` + "px;";
  }

  function callPopupMethod(methodName: string): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(methodName);
  }

  function resetForm(): void {
    content.value = "";
    dueDate.value = "";
    priority.value = "mid";
    completeMode.value = "single";
    completeRatio.value = "50";
    remind.value = "due";
    remindLead.value = "15";
    remindLeadUnit.value = "minute";
    remindEvery.value = "30";
    remindEveryUnit.value = "minute";
    requireSubmit.value = false;
    extraFields.value = [];
    fieldScrollTop.value = 0;
  }

  /** 新字段画出来后再滚到底，避免被底部按钮挡住。每次加大数值，重复添加也会再次滚动。 */
  function scrollFieldsToEnd(): void {
    nextTick(() => {
      setTimeout(() => {
        fieldScrollTop.value = fieldScrollTop.value + 100000;
      }, 50);
    });
  }

  function addExtraField(): void {
    extraFieldSeq++;
    const next: TodoExtraField[] = [];
    const current = extraFields.value;
    for (let i = 0; i < current.length; i++) {
      next.push(current[i]);
    }
    next.push(new TodoExtraField(extraFieldSeq));
    extraFields.value = next;
    scrollFieldsToEnd();
  }

  function removeExtraField(id: number): void {
    const next: TodoExtraField[] = [];
    const current = extraFields.value;
    for (let i = 0; i < current.length; i++) {
      if (current[i].id != id) {
        next.push(current[i]);
      }
    }
    extraFields.value = next;
  }

  /** 打开新建待办弹层，并清空上一次填写。 */
  function open(): void {
    resetForm();
    measureSheet();
    callPopupMethod("open");
  }

  function close(): void {
    callPopupMethod("close");
  }

  function setPriority(value: string): void {
    priority.value = value;
  }

  function setCompleteMode(value: string): void {
    completeMode.value = value;
  }

  function setRemind(value: string): void {
    remind.value = value;
  }

  function setRemindLeadUnit(value: string): void {
    remindLeadUnit.value = value;
  }

  function setRemindEveryUnit(value: string): void {
    remindEveryUnit.value = value;
  }

  function onDueChange(event: UniPickerChangeEvent): void {
    const raw = event.detail.value;
    if (typeof raw == "string") {
      dueDate.value = raw;
    }
  }

  function onRequireSubmitChange(event: UniSwitchChangeEvent): void {
    requireSubmit.value = event.detail.value;
  }

  function submit(): void {
    const text = content.value.trim();
    if (text.length == 0) {
      uni.showToast({
        title: t("Mobile.Discover.todoContentRequired"),
        icon: "none",
      });
      return;
    }
    emit("submit", text);
    close();
  }

  defineExpose({
    open: open as any,
    close: close as any,
  });
</script>

