/** 聊天业务适配：只组装会话路由，加载与回退交给 offline-h5-container。 */
import { getStatusBarHeight } from '@/utils/system.uts';
import { buildProjectOfflineH5Request, OFFLINE_H5_BOOTSTRAP_ROUTE } from '@/utils/offlineH5/projectOfflineH5';

export function createChatOfflineH5Request(agentId: string, conversationId: string): UTSJSONObject {
  let route = `/subpackages/pages/agent-detail/agent-detail?id=${encodeURIComponent(agentId)}`;
  if (conversationId.length > 0) route = `${route}&conversationId=${encodeURIComponent(conversationId)}`;
  route = `${route}&statusBarHeight=${getStatusBarHeight()}`;
  return buildProjectOfflineH5Request(route, `chat:${agentId}:${conversationId}`);
}

export function createChatWarmupRequest(): UTSJSONObject {
  return buildProjectOfflineH5Request(OFFLINE_H5_BOOTSTRAP_ROUTE, 'warmup');
}

export function getChatH5EntryUrl(agentId: string, conversationId: string): string {
  const request = createChatOfflineH5Request(agentId, conversationId);
  const key = request['preferLocal'] == true ? 'localUrl' : 'remoteUrl';
  return `${request[key]}`;
}
