// #ifdef APP-ANDROID
import ViewTreeObserver from "android.view.ViewTreeObserver";

/** 在原生布局完成、第一帧绘制之前补偿头部插入，避免先显示新页再跳回。 */
class PrependDrawAnchor implements ViewTreeObserver.OnPreDrawListener {
  body: UniElement;
  anchor: UniElement;
  observer: ViewTreeObserver;
  contentTop: number;
  timer: number = 0;
  stopped: boolean = false;

  constructor(body: UniElement, anchor: UniElement, observer: ViewTreeObserver) {
    this.body = body;
    this.anchor = anchor;
    this.observer = observer;
    this.contentTop = anchor.getBoundingClientRect().top - body.getBoundingClientRect().top + body.scrollTop;
  }

  stop(): void {
    if (this.stopped) return;
    this.stopped = true;
    if (this.observer.isAlive()) this.observer.removeOnPreDrawListener(this);
    if (this.timer != 0) {
      clearTimeout(this.timer);
      this.timer = 0;
    }
  }

  override onPreDraw(): boolean {
    if (this.stopped) return true;
    const contentTop = this.anchor.getBoundingClientRect().top - this.body.getBoundingClientRect().top + this.body.scrollTop;
    const delta = contentTop - this.contentTop;
    if (Math.abs(delta) < 0.5) return true;
    // 提示行移除与消息插入可能分两次布局；持续到本次短窗口结束。
    this.contentTop = contentTop;
    this.body.scrollTop = Math.max(0, this.body.scrollTop + delta);
    // 本次只修正偏移，下次绘制直接呈现保留的位置。
    this.body.getAndroidView()?.invalidate();
    return false;
  }
}
// #endif

export function preserveImPrependAnchor(bodyId: string, anchorId: string): (() => void) | null {
  // #ifdef APP-ANDROID
  const body = uni.getElementById(bodyId);
  const anchor = uni.getElementById(anchorId);
  if (body == null || anchor == null) return null;
  const view = body.getAndroidView();
  if (view == null) return null;
  const observer = view.getViewTreeObserver();
  const guard = new PrependDrawAnchor(body, anchor, observer);
  observer.addOnPreDrawListener(guard);
  // 无新增记录、请求结果重复等路径同样释放监听。
  guard.timer = setTimeout(() => { guard.stop(); }, 1000);
  return (): void => { guard.stop(); };
  // #endif
  // #ifndef APP-ANDROID
  return null;
  // #endif
}
