import { RequestResponse, VoidRequestResponse } from "@/types/interfaces/request";
import {
  ConversationChatSuggestParams,
  ConversationInfo,
  ConversationListParams,
  ConversationMessageListParams,
  MessageInfo,
  ConversationChatResponse,
} from "@/types/interfaces/conversationInfo";
import { AgentConversationUpdateParams } from "@/types/interfaces/agent";
import {
  TempConversationQueryDto,
  TempConversationCreateDto,
  TempChatCompletionsParams,
} from "@/types/interfaces/tempChat";
import request from "@/servers/useRequest";

// 查询会话
export async function apiAgentConversation(conversationId: number): Promise<RequestResponse<ConversationInfo>> {
  const res = await request({
    url: `/api/agent/conversation/${conversationId}`,
    method: "POST",
  });
  return res;
}

// 停止会话
export async function apiAgentConversationChatStop(conversationId: string): Promise<VoidRequestResponse> {
  const res = await request({
    url: `/api/agent/conversation/chat/stop/${conversationId}`,
    method: "POST",
  });
  return res;
}

/**
 * Android：UTS class 经 JSON.stringify 可能丢字段，显式拼 UTSJSONObject。
 */
function buildAgentConversationUpdateBody(
  data: AgentConversationUpdateParams,
): UTSJSONObject {
  const body = new UTSJSONObject();
  body["id"] = data.id;
  body["firstMessage"] = data.firstMessage;
  body["topic"] = data.topic;
  return body;
}

/**
 * Android：UTS class 经 JSON.stringify 可能丢字段，显式拼 UTSJSONObject。
 */
function buildConversationListBody(
  data: ConversationListParams,
): UTSJSONObject {
  const body = new UTSJSONObject();
  if (data.agentId != null && (data.agentId as number) > 0) {
    body["agentId"] = data.agentId;
  } else {
    body["agentId"] = null;
  }
  if (data.lastId != null && (data.lastId as number) > 0) {
    body["lastId"] = data.lastId;
  } else {
    body["lastId"] = null;
  }
  body["limit"] = data.limit;
  if (data.topic != null && (data.topic as string).length > 0) {
    body["topic"] = data.topic;
  } else {
    body["topic"] = null;
  }
  return body;
}

// 根据用户消息更新会话主题
export async function apiAgentConversationUpdate(
  data: AgentConversationUpdateParams,
): Promise<RequestResponse<ConversationInfo>> {
  const res = await request({
    url: "/api/agent/conversation/update",
    method: "POST",
    data: buildAgentConversationUpdateBody(data),
  });
  return res;
}

// 查询用户历史会话
export async function apiAgentConversationList(data: ConversationListParams): Promise<RequestResponse<ConversationInfo[]>> {
  const res = await request({
    url: "/api/agent/conversation/list",
    method: "POST",
    data: buildConversationListBody(data),
  });
  return res;
}

// 删除会话
export async function apiAgentConversationDelete(conversationId: number): Promise<VoidRequestResponse> {
  const res = await request({
    url: `/api/agent/conversation/delete/${conversationId}`,
    method: "POST",
  });
  return res;
}

// 创建会话
export async function apiAgentConversationCreate(
  data: any,
): Promise<RequestResponse<ConversationInfo>> {
  const res = await request({
    url: "/api/agent/conversation/create",
    method: "POST",
    data,
  });
  return res;
}

/**
 * Android：UTS class 经 JSON.stringify 可能丢字段，显式拼 UTSJSONObject。
 */
function buildConversationChatSuggestBody(
  data: ConversationChatSuggestParams,
): UTSJSONObject {
  const body = new UTSJSONObject();
  body["conversationId"] = data.conversationId;
  body["message"] = data.message;
  body["debug"] = data.debug;
  if (data.variableParams != null) {
    body["variableParams"] = data.variableParams;
  }
  if (data.attachments != null && data.attachments.length > 0) {
    body["attachments"] = data.attachments as any;
  }
  if (data.selectedComponents != null && data.selectedComponents.length > 0) {
    body["selectedComponents"] = data.selectedComponents as any;
  }
  if (data.sandboxId != null && data.sandboxId.length > 0) {
    body["sandboxId"] = data.sandboxId;
  }
  if (data.skillIds != null && data.skillIds.length > 0) {
    body["skillIds"] = data.skillIds as any;
  }
  if (data.agentMode != null) {
    body["agentMode"] = data.agentMode;
  }
  return body;
}

// 智能体会话问题建议
export async function apiAgentConversationChatSuggest(
  data: ConversationChatSuggestParams,
): Promise<RequestResponse<string[]>> {
  const res = await request({
    url: "/api/agent/conversation/chat/suggest",
    method: "POST",
    data: buildConversationChatSuggestBody(data),
  });
  return res;
}

