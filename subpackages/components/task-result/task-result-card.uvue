<template>
  <view class="task-result-card">
    <text v-if="displayText.length > 0" class="task-result-card__title">{{ displayText }}</text>
    <view
      v-for="(name, index) in fileNames"
      :key="index"
      class="task-result-card__file"
      @tap="handleClickFile(name)"
    >
      <view class="task-result-card__icon">
        <svg-icon name="icon-a-Filetext" size="32" />
      </view>
      <text class="task-result-card__name">{{ fileLabel(name) }}</text>
      <view class="task-result-card__arrow">
        <svg-icon name="icon-a-Chevronright" size="24" />
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    getFileProxyUrlByConversationIdAndFilePath,
    FILE_PREVIEW_SOURCE_ARTIFACT,
    jumpToFilePreviewPage,
  } from "@/utils/system.uts";

  const props = withDefaults(
    defineProps<{
      /** 解析后的 task-result 数据。 */
      taskResultData: any;
      /** 当前会话 ID，可带 chat- 前缀。 */
      conversationId?: string;
    }>(),
    {
      conversationId: "",
    },
  );

  function readDataField(key: string): string {
    const source = props.taskResultData;
    if (source == null) return "";
    const obj = source as UTSJSONObject;
    const value = obj[key];
    return value != null ? `${value}` : "";
  }

  const description = computed((): string => readDataField("description"));
  const fileNames = computed((): string[] => {
    const joined = readDataField("files");
    const result = [] as string[];
    if (joined.length > 0) {
      const parts = joined.split("\n");
      for (let i = 0; i < parts.length; i++) {
        const name = parts[i].trim();
        if (name.length > 0) {
          result.push(name);
        }
      }
    }
    if (result.length == 0) {
      const single = readDataField("file");
      if (single.length > 0) {
        result.push(single);
      }
    }
    return result;
  });
  const displayText = computed((): string => {
    if (description.value.length > 0) return description.value;
    return "";
  });

  /** 卡片上只展示文件名，打开时仍使用完整相对路径。 */
  function fileLabel(filePath: string): string {
    const normalized = filePath.trim();
    const slash = normalized.lastIndexOf("/");
    if (slash >= 0 && slash < normalized.length - 1) {
      return normalized.substring(slash + 1);
    }
    return normalized;
  }

  /** 打开指定任务产物；无会话时交给页面事件处理。 */
  async function handleClickFile(fileName: string): Promise<void> {
    let conversationId = props.conversationId;
    if (conversationId.startsWith("chat-")) {
      conversationId = conversationId.substring(5);
    }
    if (conversationId.length == 0 || fileName.length == 0) {
      const payload = new UTSJSONObject();
      payload["data"] = props.taskResultData;
      payload["fileName"] = fileName;
      payload["description"] = description.value;
      uni.$emit("task_result_click", payload);
      return;
    }
    try {
      const parts = fileName.split(conversationId + "/");
      const fileId = parts.length > 0 ? parts[parts.length - 1] : fileName;
      const proxyUrlRaw =
        await getFileProxyUrlByConversationIdAndFilePath(
          conversationId,
          fileId,
        );
      const proxyUrl = proxyUrlRaw != null ? `${proxyUrlRaw}` : "";
      if (proxyUrl.length == 0) {
        uni.showToast({ title: "打开文件失败", icon: "none" });
        return;
      }
      jumpToFilePreviewPage(conversationId, proxyUrl, FILE_PREVIEW_SOURCE_ARTIFACT);
    } catch (error) {
      console.error("[TaskResult] 打开任务结果失败:", error);
      uni.showToast({ title: "打开文件失败", icon: "none" });
    }
  }
</script>

<style lang="scss" scoped>
  .task-result-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    margin: 16rpx 0;
    box-sizing: border-box;

    &__title {
      color: #17191f;
      font-size: 28rpx;
      font-weight: 600;
      line-height: 40rpx;
      margin-bottom: 16rpx;
    }

    &__file {
      display: flex;
      flex-direction: row;
      align-items: center;
      width: 100%;
      margin-bottom: 16rpx;
      padding: 22rpx 24rpx;
      border-radius: 16rpx;
      background-color: #ffffff;
      border: 1rpx solid #eceef2;
      box-sizing: border-box;
    }

    &__icon,
    &__arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    &__icon {
      width: 40rpx;
      height: 40rpx;
      margin-right: 16rpx;
    }

    &__name {
      flex: 1;
      min-width: 0;
      color: #17191f;
      font-size: 28rpx;
      line-height: 40rpx;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &__arrow {
      width: 32rpx;
      height: 32rpx;
      margin-left: 12rpx;
    }
  }
</style>
