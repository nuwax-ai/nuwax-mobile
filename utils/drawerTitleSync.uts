import eventBus from "@/utils/eventBus";
import { recordDrawerTitle } from "@/utils/drawerTitleState";
import { getImSessionStamp } from "@/utils/im/imSessionScope";
import { postAppWebViewMessage } from "@/utils/system";

export const DRAWER_TITLE_CHANGED = "drawer_title_changed";
export const DRAWER_TITLE_BRIDGE = "app-drawer-title-changed";

export class DrawerTitleContext {
  session: string = "";
  scope: string = "";
}

function readEmbeddedTitleScope(): string {
  // #ifdef H5 || WEB
  try {
    const query = window.location.hash.split("?").slice(1).join("?");
    const scope = new URLSearchParams(query).get("drawerTitleScope");
    return scope != null ? scope : "";
  } catch (_error) {}
  // #endif
  return "";
}

// 新建会话会 replaceState 精简 hash；文档启动时先保存宿主作用域，软导航仍可复用。
let embeddedTitleScope = readEmbeddedTitleScope();

/** 在异步写请求前捕获，避免换账号后把旧结果交给新会话。 */
export function captureDrawerTitleContext(): DrawerTitleContext {
  const context = new DrawerTitleContext();
  context.session = getImSessionStamp();
  const scope = readEmbeddedTitleScope();
  if (scope.length > 0) embeddedTitleScope = scope;
  context.scope = embeddedTitleScope;
  return context;
}

/** 本运行时的所有列表按 ID 就地更新；不改变排序、分页游标或展开态。 */
function acceptDrawerTitleChange(payload: UTSJSONObject): void {
  const kind = payload["kind"] != null ? `${payload["kind"]}` : "";
  const id = payload["id"] != null ? parseFloat(`${payload["id"]}`) : 0;
  const title = payload["title"] != null ? `${payload["title"]}` : "";
  const projectType = payload["projectType"] != null ? `${payload["projectType"]}` : "";
  if (recordDrawerTitle(kind, id, title, projectType)) eventBus.emit(DRAWER_TITLE_CHANGED, payload);
}

export function publishDrawerTitleChange(kind: string, id: number, title: string, projectType: string, context: DrawerTitleContext): void {
  if (context.session != getImSessionStamp()) return;
  const payload: UTSJSONObject = { type: DRAWER_TITLE_BRIDGE, kind: kind, id: id, title: title, projectType: projectType, scopeKey: context.scope };
  acceptDrawerTitleChange(payload);
  // #ifdef H5 || WEB
  if (context.scope.length > 0) postAppWebViewMessage(payload);
  // #endif
}

/** 宿主只接受当前账号/服务的 H5 消息，允许同账号上一会话稍晚完成命名。 */
export function receiveDrawerTitleChange(payload: UTSJSONObject, scope: string): void {
  if (scope.length == 0 || payload["scopeKey"] != scope) return;
  acceptDrawerTitleChange(payload);
}
