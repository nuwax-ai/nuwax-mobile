<template>
  <view class="container relative flex flex-col">
    <custom-nav-bar :title="t('Mobile.Terminal.meetingRecords')" className="border-b" hasSafetyZone showBack />

    <!-- 搜索 + 时间筛选 -->
    <view class="search-row">
      <view class="search-box">
        <input class="search-input" v-model="keyword" :placeholder="searchPlaceholder" placeholder-class="search-placeholder" @confirm="handleSearch" />
      </view>
      <view class="filter-btn" hover-class="filter-btn-active" @click="handleFilter">
        <text class="filter-text">{{ currentFilterLabel }}</text>
      </view>
    </view>

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false" @scrolltolower="handleLoadMore">
      <view class="record-list">
        <view
          class="record-card"
          v-for="item in recordList"
          :key="item.id"
          hover-class="record-card-active"
          @click="handleDetail(item)"
        >
          <view class="record-head">
            <text class="record-title text-ellipsis">{{ item.title != '' ? item.title : t('Mobile.Terminal.untitledMeeting') }}</text>
            <text class="record-date">{{ formatDate(item.startedAt) }}</text>
          </view>
          <view class="record-meta">
            <text class="record-count" v-if="item.participantCount > 0">👥 {{ item.participantCount }}{{ t("Mobile.Terminal.peopleUnit") }}</text>
            <text v-if="item.fileAsrStatus == 'FAILED' || item.summaryStatus == 'FAILED'" class="record-status-fail">{{ t("Mobile.Terminal.processFailed") }}</text>
            <text v-else-if="item.fileAsrStatus == 'PENDING' || item.summaryStatus == 'PENDING'" class="record-status-pending">{{ t("Mobile.Terminal.processing") }}</text>
          </view>
          <text v-if="item.briefSummary != ''" class="record-summary">{{ item.briefSummary }}</text>
          <view class="record-actions" @tap.stop="">
            <view v-if="item.hasAudio" class="action-btn" hover-class="action-btn-active" @click="handleReplay(item)">
              <text class="action-text">▶ {{ t("Mobile.Terminal.replay") }}</text>
            </view>
            <view v-if="item.hasAudio" :class="['action-btn', item.downloading ? 'action-btn--busy' : '']" hover-class="action-btn-active" @click="handleDownload(item)">
              <text class="action-text">{{ item.downloading ? "… " : "⬇ " }}{{ item.downloading ? t("Mobile.Terminal.downloading") : t("Mobile.Terminal.download") }}</text>
            </view>
            <view v-if="item.fileAsrStatus == 'FAILED' || item.summaryStatus == 'FAILED'" class="action-btn" hover-class="action-btn-active" @click="handleReprocess(item)">
              <text class="action-text">↻ {{ t("Mobile.Terminal.reprocess") }}</text>
            </view>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-box" v-if="!loading && recordList.length == 0">
          <text class="empty-text">{{ t("Mobile.Terminal.noMeetingRecords") }}</text>
        </view>
        <!-- 加载更多 -->
        <view class="empty-box" v-if="loading">
          <text class="empty-text">{{ t("Mobile.Terminal.loading") }}</text>
        </view>
        <view class="empty-box" v-if="!loading && !hasMore && recordList.length > 0">
          <text class="empty-text">{{ t("Mobile.Terminal.noMore") }}</text>
        </view>
      </view>
      <view class="bottom-space"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad, onShow } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { orEmpty } from "@/utils/utsCoalesce.uts";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiVoxMeetingList, apiVoxMeetingReprocess, apiVoxMeetingAudioUrl } from "@/servers/vox/voxMeeting";
  import { AppMeetingListParams } from "@/types/interfaces/voxMeeting";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import { SUCCESS_CODE, USER_NO_LOGIN, REDIRECT_LOGIN } from "@/constants/codes.constants";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const keyword = ref<string>("");
  const searchPlaceholder = ref<string>(t("Mobile.Terminal.searchMeeting"));
  // 从设备详情带入的 deviceId（后端列表暂未支持过滤，先透传）
  const deviceId = ref<string>("");

  class MeetingRecord {
    id: number = 0;
    title: string = "";
    briefSummary: string = "";
    participantCount: number = 0;
    summaryStatus: string = "";
    fileAsrStatus: string = "";
    hasAudio: boolean = false;
    startedAt: string = "";
    downloading: boolean = false;
    constructor(id: number, title: string, brief: string, count: number, summaryStatus: string, fileAsrStatus: string, hasAudio: boolean, startedAt: string) {
      this.id = id;
      this.title = title;
      this.briefSummary = brief;
      this.participantCount = count;
      this.summaryStatus = summaryStatus;
      this.fileAsrStatus = fileAsrStatus;
      this.hasAudio = hasAudio;
      this.startedAt = startedAt;
    }
  }

  const recordList = ref<MeetingRecord[]>([]);
  const loading = ref<boolean>(false);
  const page = ref<number>(1);
  const pageSize = 10;
  const total = ref<number>(0);
  const hasMore = ref<boolean>(false);

  // 时间筛选（timeRange）
  class FilterOption {
    value: string = "";
    label: string = "";
    constructor(value: string, label: string) {
      this.value = value;
      this.label = label;
    }
  }
  const timeRange = ref<string>("ALL");
  const currentFilterLabel = ref<string>(t("Mobile.Terminal.allTime"));
  const filterOptions = [
    new FilterOption("ALL", t("Mobile.Terminal.allTime")),
    new FilterOption("TODAY", t("Mobile.Terminal.rangeToday")),
    new FilterOption("THIS_WEEK", t("Mobile.Terminal.rangeThisWeek")),
    new FilterOption("THIS_MONTH", t("Mobile.Terminal.rangeThisMonth")),
  ];

  // ISO 时间 → MM-DD HH:mm 展示
  const formatDate = (iso: string): string => {
    if (iso.length < 16) return iso;
    return `${iso.substring(5, 10)} ${iso.substring(11, 16)}`;
  };

  const fetchList = async (reset: boolean) => {
    if (loading.value) return;
    loading.value = true;
    if (reset) {
      page.value = 1;
    }
    try {
      const params = new AppMeetingListParams();
      params.keyword = keyword.value.trim();
      params.timeRange = timeRange.value;
      params.page = page.value;
      params.pageSize = pageSize;
      params.deviceId = deviceId.value;
      const res = await apiVoxMeetingList(params);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const obj = raw != null ? (raw as UTSJSONObject) : null;
        const itemsVal = obj != null ? obj["items"] : null;
        const items = itemsVal != null ? (itemsVal as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        const list: MeetingRecord[] = [];
        for (let i = 0; i < items.length; i++) {
          const m = items[i];
          const idVal = m["id"];
          const titleVal = m["title"];
          const briefVal = m["briefSummary"];
          const countVal = m["participantCount"];
          const ssVal = m["summaryStatus"];
          const asrVal = m["fileAsrStatus"];
          const audioVal = m["audioFileUrl"];
          const startVal = m["startedAt"];
          list.push(new MeetingRecord(
            idVal != null ? (idVal as number) : 0,
            titleVal != null ? `${titleVal}` : "",
            briefVal != null ? `${briefVal}` : "",
            countVal != null ? (countVal as number) : 0,
            ssVal != null ? `${ssVal}` : "",
            asrVal != null ? `${asrVal}` : "",
            audioVal != null && `${audioVal}` != "",
            startVal != null ? `${startVal}` : "",
          ));
        }
        if (reset) {
          recordList.value = list;
        } else {
          recordList.value = recordList.value.concat(list);
        }
        const totalVal = obj != null ? obj["total"] : null;
        total.value = totalVal != null ? (totalVal as number) : 0;
        hasMore.value = recordList.value.length < total.value;
      } else if (apiResCode(res) != USER_NO_LOGIN && apiResCode(res) != REDIRECT_LOGIN) {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.fetchMeetingsFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchList error", e);
    } finally {
      loading.value = false;
    }
  };

  const handleSearch = () => {
    fetchList(true);
  };

  const handleFilter = () => {
    const labels: string[] = [];
    const values: string[] = [];
    for (let i = 0; i < filterOptions.length; i++) {
      labels.push(filterOptions[i].label);
      values.push(filterOptions[i].value);
    }
    uni.showActionSheet({
      itemList: labels,
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        const next = values[res.tapIndex];
        if (next != timeRange.value) {
          timeRange.value = next;
          currentFilterLabel.value = labels[res.tapIndex];
          fetchList(true);
        }
      },
    });
  };

  const handleLoadMore = () => {
    if (!hasMore.value || loading.value) return;
    page.value = page.value + 1;
    fetchList(false);
  };

  const handleReplay = (item: MeetingRecord) => {
    uni.navigateTo({ url: `/subpackages/pages/terminal/terminal-meeting-detail?id=${item.id}&autoplay=1` });
  };

  /**
   * 真实下载：先拉临时播放地址，再 uni.downloadFile 存本地。
   * 临时地址约 24h 有效，下载完成即持久化到本地文件，不再依赖地址有效期。
   */
  const handleDownload = async (item: MeetingRecord) => {
    if (item.downloading) return;
    item.downloading = true;
    try {
      const res = await apiVoxMeetingAudioUrl(item.id);
      if (apiResCode(res) != SUCCESS_CODE) {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.downloadFailed"), icon: "none" });
        return;
      }
      const raw = apiResData<any>(res);
      const obj = raw != null ? (raw as UTSJSONObject) : null;
      const urlVal = obj != null ? obj["url"] : null;
      const url = urlVal != null ? `${urlVal}` : "";
      if (url == "") {
        uni.showToast({ title: t("Mobile.Terminal.downloadFailed"), icon: "none" });
        return;
      }
      uni.downloadFile({
        url: url,
        success: (dl) => {
          if (dl.statusCode == 200) {
            // 下载默认落在 app 沙箱缓存（文件管理器不可见）。直接用系统应用打开，
            // 用户可经系统应用右上角菜单另存到下载/分享。
            uni.openDocument({
              filePath: dl.tempFilePath,
              success: () => {
                uni.showToast({ title: t("Mobile.Terminal.downloadDone"), icon: "none" });
              },
              fail: () => {
                uni.showToast({ title: t("Mobile.Terminal.downloadOpenFailed"), icon: "none" });
              },
            });
          } else {
            uni.showToast({ title: t("Mobile.Terminal.downloadFailed"), icon: "none" });
          }
        },
        fail: (_e) => {
          uni.showToast({ title: t("Mobile.Terminal.downloadFailed"), icon: "none" });
        },
      });
    } catch (e) {
      console.error("handleDownload error", e);
      uni.showToast({ title: t("Mobile.Terminal.downloadFailed"), icon: "none" });
    } finally {
      item.downloading = false;
    }
  };

  const handleReprocess = async (item: MeetingRecord) => {
    try {
      const res = await apiVoxMeetingReprocess(item.id);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Terminal.reprocessStarted"), icon: "none" });
        item.summaryStatus = "PENDING";
        item.fileAsrStatus = "PENDING";
      } else {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.reprocessFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("handleReprocess error", e);
    }
  };

  const handleDetail = (item: MeetingRecord) => {
    uni.navigateTo({ url: `/subpackages/pages/terminal/terminal-meeting-detail?id=${item.id}` });
  };

  onLoad((options: any) => {
    setCurrentPageNavigationBarTitle();
    if (options != null) {
      const optObj = options as UTSJSONObject;
      const id = optObj["deviceId"];
      if (id != null && `${id}`.length > 0) {
        deviceId.value = orEmpty(decodeURIComponent(`${id}`));
      }
    }
  });

  onShow(() => {
    fetchList(true);
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .search-row {
    display: flex;
    flex-direction: row;
    padding: 24rpx 24rpx 0;

    .search-box {
      flex: 1;
      background-color: #ffffff;
      border-radius: 16rpx;
      padding: 20rpx 28rpx;
      margin-right: 16rpx;

      .search-input {
        width: 100%;
        font-size: 28rpx;
        color: #1a1a1a;
      }

      .search-placeholder {
        color: #c0c0c0;
      }
    }

    .filter-btn {
      padding: 20rpx 28rpx;
      border-radius: 16rpx;
      background-color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;

      &-active {
        background-color: rgba(12, 20, 102, 0.04);
      }

      .filter-text {
        font-size: 26rpx;
        color: #666666;
      }
    }
  }

  .record-list {
    padding: 24rpx;
  }

  .record-card {
    background-color: #ffffff;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 20rpx;
&-active {
      background-color: rgba(12, 20, 102, 0.04);
    }

    .record-head {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 16rpx;

      .record-title {
        flex: 1;
        font-size: 30rpx;
        font-weight: 600;
        color: #1a1a1a;
        margin-right: 16rpx;
      }

      .record-date {
        font-size: 22rpx;
        color: #999999;
        flex-shrink: 0;
      }
    }

    .record-meta {
      display: flex;
      flex-direction: row;
      align-items: center;
      margin-bottom: 16rpx;

      .record-count {
        font-size: 22rpx;
        color: #666666;
        margin-right: 16rpx;
      }

      .record-status-fail {
        font-size: 22rpx;
        color: #dd524d;
      }

      .record-status-pending {
        font-size: 22rpx;
        color: #f0a020;
      }
    }

    .record-summary {
      font-size: 26rpx;
      color: #1a1a1a;
      line-height: 1.5;
      margin-bottom: 20rpx;
    }

    .record-actions {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;

      .action-btn {
        padding: 12rpx 24rpx;
        border-radius: 12rpx;
        border: 2rpx solid #e0e0e0;
        margin-right: 16rpx;
        margin-bottom: 8rpx;

        &-active {
          background-color: rgba(12, 20, 102, 0.04);
        }

        &--busy {
          opacity: 0.6;
        }

        .action-text {
          font-size: 24rpx;
          color: #666666;
        }
      }
    }
  }

  .empty-box {
    padding: 80rpx 0;
    display: flex;
    align-items: center;
    justify-content: center;

    .empty-text {
      font-size: 28rpx;
      color: #999999;
    }
  }

  .bottom-space {
    height: 40rpx;
  }
  
</style>
