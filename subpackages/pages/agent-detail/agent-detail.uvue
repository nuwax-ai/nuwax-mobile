<template>
	<!-- #ifndef APP -->
	<!-- 非 App 端（H5 / 小程序）：原生渲染聊天会话组件 -->
	<chat-conversation-component ref="chatConversationComponentRef" />
	<!-- #endif -->
	<!-- #ifdef APP -->
	<!-- App 聊天已迁至首页常驻 web-view 壳（resident-chat-shell）。
	     若仍有旧链接 navigateTo 本页，则转开常驻壳并回到首页 Tab，避免再创建/销毁 WKWebView。 -->
	<view class="app-redirect-placeholder"></view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import ChatConversationComponent from '@/subpackages/pages/chat-conversation-component/chat-conversation-component.uvue'
	import { ref, getCurrentInstance, type ComponentPublicInstance } from 'vue'
	import { getCurrentPageFullPath } from '@/utils/common'
	import { onAddToFavorites, onShow, onHide, onShareAppMessage } from '@dcloudio/uni-app'
	import { useI18n, emptyI18nParams } from '@/utils/i18n'
	// #ifdef APP
	import { onLoad } from '@dcloudio/uni-app'
	import { openResidentChat } from '@/utils/residentChatShell'
	// #endif

	const instance = getCurrentInstance()
	const chatConversationComponentRef = ref<any | null>(null)

	const { t: tFn } = useI18n()
	const t = (key: string): string => tFn(key, emptyI18nParams(), "")
	const name = t('Mobile.Common.appName')

	// #ifdef APP
	onLoad((options: any) => {
		const optionsObj = options as UTSJSONObject
		const idRaw = optionsObj['id']
		const convRaw = optionsObj['conversationId']
		const agentIdText = idRaw != null ? `${idRaw}` : ''
		if (agentIdText.length == 0) {
			uni.switchTab({ url: '/pages/index/index' })
			return
		}
		let agentIdNum = 0
		try {
			agentIdNum = parseInt(agentIdText)
			if (agentIdNum != agentIdNum) {
				agentIdNum = 0
			}
		} catch (_e) {
			agentIdNum = 0
		}
		if (agentIdNum <= 0) {
			uni.switchTab({ url: '/pages/index/index' })
			return
		}
		let conversationId: number | null = null
		if (convRaw != null && `${convRaw}`.length > 0) {
			try {
				const c = parseInt(`${convRaw}`)
				if (c == c && c > 0) {
					conversationId = c
				}
			} catch (_eConv) {
				conversationId = null
			}
		}
		// openResidentChat：已在首页则 emit；否则内部 switchTab 回首页。
		// 此处禁止再调一次 switchTab（Android 会 NPE）。
		openResidentChat(agentIdNum, conversationId)
	})
	// #endif

	/** Android：Gen* 组件禁止 as UTSJSONObject，用 $callMethod */
	function callChatMethod(methodName: string): void {
		const comp = chatConversationComponentRef.value
		if (comp == null) {
			return
		}
		const proxy = comp as ComponentPublicInstance
		proxy.$callMethod(methodName)
	}

	onShow(() => {
		// #ifndef MP-WEIXIN
		callChatMethod('triggerResume')
		// #endif
		// #ifdef MP-WEIXIN
		const proxy: any = instance?.proxy
		const componentRef = proxy?.$refs?.chatConversationComponentRef
			? proxy?.$refs?.chatConversationComponentRef
			: proxy?.chatConversationComponentRef
		if (Boolean(componentRef)) {
			;(componentRef as any).triggerResume?.()
		}
		// #endif
	})

	onHide(() => {
		// #ifndef MP-WEIXIN
		callChatMethod('triggerHide')
		// #endif
		// #ifdef MP-WEIXIN
		const proxy: any = instance?.proxy
		const componentRef = proxy?.$refs?.chatConversationComponentRef
			? proxy?.$refs?.chatConversationComponentRef
			: proxy?.chatConversationComponentRef
		if (Boolean(componentRef)) {
			;(componentRef as any).triggerHide?.()
		}
		// #endif
	})

	// #ifdef MP-WEIXIN
	onShareAppMessage(() => {
		const proxy: any = instance?.proxy
		const componentRef = proxy?.$refs?.chatConversationComponentRef
			? proxy?.$refs?.chatConversationComponentRef
			: proxy?.chatConversationComponentRef
		const agentTitle = componentRef?.getAgentInfo()?.name ?? name
		return {
			title: agentTitle != null ? `${agentTitle}` : '',
			path: getCurrentPageFullPath(),
		}
	})

	onAddToFavorites(() => {
		const proxy: any = instance?.proxy
		const componentRef = proxy?.$refs?.chatConversationComponentRef
			? proxy?.$refs?.chatConversationComponentRef
			: proxy?.chatConversationComponentRef
		const agentTitle = componentRef?.getAgentInfo()?.name ?? name
		return {
			title: agentTitle != null ? `${agentTitle}` : '',
		}
	})
	// #endif
</script>

<style lang="scss" scoped>
	.app-redirect-placeholder {
		width: 1px;
		height: 1px;
		opacity: 0;
	}
</style>
