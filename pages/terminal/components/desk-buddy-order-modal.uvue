<template>
  <view v-if="visible" class="order-modal-mask" @tap="close">
    <view class="order-modal-content" @tap.stop>
      <view class="order-modal-header">
        <text class="order-modal-title">{{ t("Mobile.Terminal.orderDeviceInfo") }}</text>
      </view>
      <!-- Android uvue 命中测试按父容器裁剪：关闭按钮须整体留在 content 盒内，不能负偏移伸出 header -->
      <view class="order-modal-close" @tap.stop="close">
        <svg-icon name="icon-X" size="36"  />
      </view>

      <view class="order-product">
        <view class="order-product-head">
          <view class="order-product-face">
            <image v-if="props.productImageUrl != ''" class="order-product-image" :src="props.productImageUrl" mode="aspectFit" />
            <template v-else>
            <view class="face-eyes">
              <view class="face-eye"></view>
              <view class="face-eye"></view>
            </view>
            <view class="face-smile"></view>
            </template>
          </view>
          <view class="order-product-info">
            <view class="order-product-title-row">
              <text class="order-product-name">{{ props.productTitle }}</text>
              <text class="order-product-price">¥{{ props.productPriceText }}</text>
            </view>
            <text class="order-product-desc">{{ props.productSubtitle }}</text>
          </view>
        </view>
        <view class="order-feature-list">
          <view v-for="(highlight, index) in props.productHighlights" :key="index" class="order-feature">
            <text v-if="highlightTitle(highlight) != ''" class="order-feature-title">{{ highlightTitle(highlight) }}</text>
            <text class="order-feature-desc">{{ highlightDescription(highlight) }}</text>
          </view>
        </view>
      </view>

      <view class="order-form">
        <view class="order-form-item">
          <input class="order-form-input" v-model="receiverName" maxlength="30" :placeholder="t('Mobile.Terminal.receiverNamePlaceholder')" />
        </view>
        <view class="order-form-item">
          <input class="order-form-input" v-model="receiverPhone" type="number" maxlength="11" :placeholder="t('Mobile.Terminal.receiverPhonePlaceholder')" />
        </view>
        <view class="order-form-item order-form-address-item">
          <textarea
            class="order-form-textarea"
            v-model="receiverAddress"
            maxlength="200"
            :auto-height="true"
            :placeholder="t('Mobile.Terminal.receiverAddressPlaceholder')"
          />
        </view>
        <text v-if="formError.length > 0" class="order-form-error">{{ formError }}</text>
        <view :class="['order-form-submit', submitting ? 'order-form-submit-disabled' : '']" @tap="submit">
          <text class="order-form-submit-text">{{ submitting ? t("Mobile.Terminal.orderSubmitting") : t("Mobile.Terminal.orderPay") }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { SUCCESS_CODE } from "@/constants/codes.constants.uts";
  import { apiCreateDeskBuddyOrder } from "@/subpackages/servers/subscription";
  import { getPayMode } from "@/subpackages/utils/paymentUtils";
  import { apiResCode, apiResData } from "@/utils/apiResponse";

  import { useSubscriptionPurchase } from "@/subpackages/pages/my-subscriptions/hooks/useSubscriptionPurchase";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  interface DeskBuddyOrderModalProps {
    productTitle: string;
    productSubtitle: string;
    productPriceText: string;
    productImageUrl: string;
    productHighlights: string[];
  }

  const props = withDefaults(defineProps<DeskBuddyOrderModalProps>(), {
    productTitle: "",
    productSubtitle: "",
    productPriceText: "0",
    productImageUrl: "",
    productHighlights: [],
  });

  const highlightSeparator = (value: string): string => {
    if (value.indexOf("｜") >= 0) return "｜";
    if (value.indexOf("|") >= 0) return "|";
    if (value.indexOf("：") >= 0) return "：";
    if (value.indexOf(": ") >= 0) return ": ";
    if (value.indexOf(" · ") >= 0) return " · ";
    return "";
  };

  const highlightTitle = (value: string): string => {
    const separator = highlightSeparator(value);
    if (separator == "") return "";
    const index = value.indexOf(separator);
    return index > 0 ? value.substring(0, index).trim() : "";
  };

  const highlightDescription = (value: string): string => {
    const separator = highlightSeparator(value);
    if (separator == "") return value;
    const index = value.indexOf(separator);
    const offset = separator.length;
    return index >= 0 ? value.substring(index + offset).trim() : value;
  };

  const visible = ref(false);
  const receiverName = ref("");
  const receiverPhone = ref("");
  const receiverAddress = ref("");
  const formError = ref("");
  const submitting = ref(false);
  const resetForm = (): void => {
    receiverName.value = "";
    receiverPhone.value = "";
    receiverAddress.value = "";
    formError.value = "";
  };
  const purchase = useSubscriptionPurchase(() => {
    resetForm();
  });
  // 当前商品 ID（由终端产品卡 open 时传入，随下单回传）
  const goodsId = ref("");

  const open = (id: string): void => {
    resetForm();
    // 防止上次支付链路卡住（submitting 未复位）时弹框无法关闭/无法再次提交
    submitting.value = false;
    goodsId.value = id;
    visible.value = true;
  };

  const close = (): void => {
    visible.value = false;
    formError.value = "";
  };

  const allCharsAreDigits = (value: string): boolean => {
    if (value.length == 0) return false;
    for (let i = 0; i < value.length; i++) {
      const code = value.charCodeAt(i);
      if (code == null) return false;
      if (code < 48 || code > 57) return false;
    }
    return true;
  };

  const validateForm = (): boolean => {
    const name = receiverName.value.trim();
    const phone = receiverPhone.value.trim();
    const address = receiverAddress.value.trim();
    if (name.length == 0) {
      formError.value = "请输入收货人姓名";
      return false;
    }
    if (phone.length == 0) {
      formError.value = "请输入手机号";
      return false;
    }
    if (phone.length != 11 || phone.charAt(0) != "1" || !allCharsAreDigits(phone)) {
      formError.value = "请输入正确的 11 位手机号";
      return false;
    }
    if (address.length == 0) {
      formError.value = "请输入详细收货地址";
      return false;
    }
    formError.value = "";
    return true;
  };

  const readOrderId = (response: UTSJSONObject): number => {
    const data = apiResData<any>(response);
    if (data == null) return 0;
    try {
      const rawId = (data as UTSJSONObject)["id"];
      return rawId != null ? parseInt(`${rawId}`) : 0;
    } catch (_e) {
      return 0;
    }
  };

  const submit = async (): Promise<void> => {
    if (submitting.value || !validateForm()) return;
    submitting.value = true;
    try {
      const response = await apiCreateDeskBuddyOrder({
        goodsId: goodsId.value,
        name: receiverName.value.trim(),
        phone: receiverPhone.value.trim(),
        address: receiverAddress.value.trim(),
        payMode: getPayMode(),
      });
      if (apiResCode(response) != SUCCESS_CODE) {
        formError.value = "订单创建失败，请稍后重试";
        return;
      }
      const orderId = readOrderId(response);
      if (orderId <= 0) {
        formError.value = "订单创建失败，请稍后重试";
        return;
      }
      visible.value = false;
      await purchase.handlePayExistingOrder(orderId);
    } catch (_e) {
      formError.value = "订单创建失败，请检查网络后重试";
    } finally {
      submitting.value = false;
    }
  };

  defineExpose({ open: open as any, close: close as any });
</script>

<style lang="scss" scoped>
  .order-modal-mask {
    position: fixed;
    z-index: 1000;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
