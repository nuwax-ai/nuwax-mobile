<template>
  <view class="home-content-wrapper flex-1">
    <swiper
      class="home-content-swiper flex-1"
      :current="activeTabIndex"
      :indicator-dots="false"
      :circular="false"
      :duration="260"
      easing-function="easeOut"
      @change="handleSwiperChange"
    >
      <!-- 最近使用：独立列表常驻，避免切换时销毁重建造成卡顿。 -->
      <swiper-item>
        <!-- #ifdef APP-IOS -->
        <!-- iOS 不用 list-view：覆盖层返回后复用单元格会丢掉上方行高，向上滑就是空白。 -->
        <scroll-view
          v-if="recentListMounted"
          :key="recentListKey"
          ref="recentListRef"
          class="home-content"
          direction="vertical"
          :lower-threshold="50"
          :refresher-enabled="true"
          :refresher-triggered="recentRefreshing"
          :show-scrollbar="false"
          :scroll-top="recentScrollTop"
          :scroll-into-view="recentScrollIntoView"
          :scroll-with-animation="false"
          @scroll="handleRecentScroll"
          @scrollend="handleRecentScroll"
          @scrolltolower="handleRecentLoadMore"
          @refresherrefresh="handleRecentRefresh"
          @refresherrestore="resetRecentRefresher"
          @refresherabort="resetRecentRefresher"
        >
          <view v-if="recentAgentList.length > 0">
            <view
              v-for="(info, index) in recentAgentList"
              :id="recentItemDomId(info.agentId)"
              :key="info.agentId"
              class="recent-item"
              style="height: 150rpx"
            >
              <view class="recent-item-inner" @click="handleRecentClick(info, index)" @longpress="handleRecentLongPress(info)">
                <agent-icon
                  :icon="info.icon"
                  :alt="info.name != null && info.name != '' ? info.name : agentIconAltLabel"
                />
                <view class="recent-info">
                  <view class="recent-info-main">
                    <view class="recent-name-row">
                      <text class="recent-name">{{ info.name }}</text>
                      <text v-if="isLoggedIn && info.modifiedTimeText != ''" class="recent-time">{{ info.modifiedTimeText }}</text>
                    </view>
                    <view
                      v-if="info.description != '' || (info.paymentRequired && enableSubscription == 1)"
                      class="recent-desc-row"
                    >
                      <text class="recent-desc">{{ info.description }}</text>
                      <view v-if="info.paymentRequired && enableSubscription == 1" class="recent-status-tags">
                        <text v-if="info.subscribed" class="recent-status-tag recent-status-tag--active">{{ subscribedTagLabel }}</text>
                        <text v-else class="recent-status-tag recent-status-tag--warning">{{ paymentRequiredTagLabel }}</text>
                      </view>
                    </view>
                  </view>
                  <view class="recent-info-line"></view>
                </view>
              </view>
            </view>
          </view>
          <view v-else-if="!recentLoading && !recentRefreshing" class="state-item">
            <view class="empty-state">
              <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
              <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
            </view>
          </view>
          <view v-else-if="!recentRefreshing" class="state-item">
            <view class="loading-state">
              <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
            </view>
          </view>
          <view v-if="recentShowNoMore" class="state-item">
            <view class="no-more-state">
              <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
            </view>
          </view>
        </scroll-view>
        <!-- #endif -->
        <!-- #ifndef APP-IOS -->
        <list-view
          v-if="recentListMounted"
          :key="recentListKey"
          ref="recentListRef"
          class="home-content"
          direction="vertical"
          :lower-threshold="50"
          :refresher-enabled="true"
          :refresher-triggered="recentRefreshing"
          :show-scrollbar="false"
          :scroll-top="recentScrollTop"
          :scroll-into-view="recentScrollIntoView"
          :scroll-with-animation="false"
          @scroll="handleRecentScroll"
          @scrollend="handleRecentScroll"
          @scrolltolower="handleRecentLoadMore"
          @refresherrefresh="handleRecentRefresh"
          @refresherrestore="resetRecentRefresher"
          @refresherabort="resetRecentRefresher"
        >
          <template v-if="recentAgentList.length > 0">
            <list-item
              v-for="(info, index) in recentAgentList"
              :id="recentItemDomId(info.agentId)"
              :key="info.agentId"
              :item-key="recentItemDomId(info.agentId)"
              :type="recentRowType(info)"
              class="recent-item"
              style="height: 150rpx"
            >
              <view class="recent-item-inner" @click="handleRecentClick(info, index)" @longpress="handleRecentLongPress(info)">
                <agent-icon
                  :icon="info.icon"
                  :alt="info.name != null && info.name != '' ? info.name : agentIconAltLabel"
                />
                <view class="recent-info">
                  <view class="recent-info-main">
                    <view class="recent-name-row">
                      <text class="recent-name">{{ info.name }}</text>
                      <text v-if="isLoggedIn && info.modifiedTimeText != ''" class="recent-time">{{ info.modifiedTimeText }}</text>
                    </view>
                    <view
                      v-if="info.description != '' || (info.paymentRequired && enableSubscription == 1)"
                      class="recent-desc-row"
                    >
                      <text class="recent-desc">{{ info.description }}</text>
                      <view v-if="info.paymentRequired && enableSubscription == 1" class="recent-status-tags">
                        <text v-if="info.subscribed" class="recent-status-tag recent-status-tag--active">{{ subscribedTagLabel }}</text>
                        <text v-else class="recent-status-tag recent-status-tag--warning">{{ paymentRequiredTagLabel }}</text>
                      </view>
                    </view>
                  </view>
                  <view class="recent-info-line"></view>
                </view>
              </view>
            </list-item>
          </template>
          <list-item v-else-if="!recentLoading && !recentRefreshing" :type="93" class="state-item">
            <view class="empty-state">
              <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
              <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
            </view>
          </list-item>
          <list-item v-else-if="!recentRefreshing" :type="94" class="state-item">
            <view class="loading-state">
              <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
            </view>
          </list-item>
          <list-item v-if="recentShowNoMore" :type="95" class="state-item">
            <view class="no-more-state">
              <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
            </view>
          </list-item>
        </list-view>
        <!-- #endif -->
      </swiper-item>

      <!-- 会话记录：与最近使用并列常驻，由原生 swiper 负责跟手动画。 -->
      <swiper-item>
        <!-- #ifdef APP-IOS -->
        <scroll-view
          v-if="conversationListMounted"
          :key="conversationListKey"
          ref="conversationListRef"
          class="home-content"
          direction="vertical"
          :lower-threshold="50"
          :refresher-enabled="true"
          :refresher-triggered="convRefreshing"
          :show-scrollbar="false"
          :scroll-top="convScrollTop"
          :scroll-into-view="convScrollIntoView"
          :scroll-with-animation="false"
          @scroll="handleConversationScroll"
          @scrollend="handleConversationScroll"
          @scrolltolower="handleConversationLoadMore"
          @refresherrefresh="handleConversationRefresh"
          @refresherrestore="resetConversationRefresher"
          @refresherabort="resetConversationRefresher"
        >
          <view v-if="convRowList.length > 0">
            <view
              v-for="(row, index) in convRowList"
              :id="convItemDomId(row.id)"
              :key="row.id"
              class="conv-item"
              style="height: 140rpx"
            >
              <view class="conv-item-inner" @click="handleConvClick(index)" @longpress="handleConvLongPress(index)">
                <view class="title-row">
                  <text class="conversation-title">{{ row.topic }}</text>
                  <text class="time-label">{{ row.timeLabel }}</text>
                </view>
                <view class="bottom-row">
                  <text class="agent-name">{{ row.agentName }}</text>
                  <view v-if="row.showExecuting" class="status-tag">
                    <text class="status-text">{{ t("Mobile.Conversation.executing") }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view v-else-if="!convLoading && !convRefreshing" class="state-item">
            <view class="empty-state">
              <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
              <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
            </view>
          </view>
          <view v-else-if="!convRefreshing" class="state-item">
            <view class="loading-state">
              <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
            </view>
          </view>
          <view v-if="convShowNoMore" class="state-item">
            <view class="no-more-state">
              <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
            </view>
          </view>
        </scroll-view>
        <!-- #endif -->
        <!-- #ifndef APP-IOS -->
        <list-view
          v-if="conversationListMounted"
          :key="conversationListKey"
          ref="conversationListRef"
          class="home-content"
          direction="vertical"
          :lower-threshold="50"
          :refresher-enabled="true"
          :refresher-triggered="convRefreshing"
          :show-scrollbar="false"
          :scroll-top="convScrollTop"
          :scroll-into-view="convScrollIntoView"
          :scroll-with-animation="false"
          @scroll="handleConversationScroll"
          @scrollend="handleConversationScroll"
          @scrolltolower="handleConversationLoadMore"
          @refresherrefresh="handleConversationRefresh"
          @refresherrestore="resetConversationRefresher"
          @refresherabort="resetConversationRefresher"
        >
          <template v-if="convRowList.length > 0">
            <list-item
              v-for="(row, index) in convRowList"
              :id="convItemDomId(row.id)"
              :key="row.id"
              :item-key="convItemDomId(row.id)"
              :type="2"
              class="conv-item"
              style="height: 140rpx"
            >
              <view class="conv-item-inner" @click="handleConvClick(index)" @longpress="handleConvLongPress(index)">
                <view class="title-row">
                  <text class="conversation-title">{{ row.topic }}</text>
                  <text class="time-label">{{ row.timeLabel }}</text>
                </view>
                <view class="bottom-row">
                  <text class="agent-name">{{ row.agentName }}</text>
                  <view v-if="row.showExecuting" class="status-tag">
                    <text class="status-text">{{ t("Mobile.Conversation.executing") }}</text>
                  </view>
                </view>
              </view>
            </list-item>
          </template>
          <list-item v-else-if="!convLoading && !convRefreshing" :type="90" class="state-item">
            <view class="empty-state">
              <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
              <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
            </view>
          </list-item>
          <list-item v-else-if="!convRefreshing" :type="91" class="state-item">
            <view class="loading-state">
              <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
            </view>
          </list-item>
          <list-item v-if="convShowNoMore" :type="92" class="state-item">
            <view class="no-more-state">
              <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
            </view>
          </list-item>
        </list-view>
        <!-- #endif -->
      </swiper-item>
    </swiper>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, watch, nextTick, onMounted, onUnmounted } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants.uts";
  import eventBus from "@/utils/eventBus";
  import { EVENT_TYPE } from "@/constants/event.constants";
  import {
    apiUserUsedAgentList,
    apiUserUsedAgentDelete,
    apiHomeCategoryList,
  } from "@/servers/agentDev";
  import { apiPublishedAgentList } from "@/servers/square";
  import { SquarePublishedListParams } from "@/types/interfaces/square";
  import {
    apiAgentConversationList,
    apiAgentConversationUpdate,
    apiAgentConversationDelete,
  } from "@/servers/conversation";
  import { ConversationListParams } from "@/types/interfaces/conversationInfo";
  import {
    AgentConversationUpdateParams,
    AgentListItem,
    AgentRecentConversationListItem,
  } from "@/types/interfaces/agent";
  import { apiTenantConfig } from "@/servers/account";
  import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
  import { ListParams } from "@/types/interfaces/common";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { USER_NO_LOGIN, REDIRECT_LOGIN } from "@/constants/codes.constants";
  import { formatTimeAgo } from "@/utils/common";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import AgentIcon from "@/components/agent-icon/agent-icon.uvue";
  import noData from "@/static/assets/no_data.png";
  // #ifdef APP-IOS
  import { RESIDENT_CHAT_EVENT } from "@/utils/residentChatShell";
  // #endif

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const agentIconAltLabel = computed((): string => t("Mobile.Common.agentIconAlt"));
  const subscribedTagLabel = computed((): string => t("Mobile.AgentList.subscribedTag"));
  const paymentRequiredTagLabel = computed((): string => t("Mobile.AgentList.paymentRequiredTag"));

  interface HomeContentProps {
    isLoggedIn: boolean;
  }
  const props = defineProps<HomeContentProps>();

  const emit = defineEmits<{
    (e: "agent-click", info: any): void;
    (e: "conversation-click", item: any): void;
    (e: "tab-change", tab: string): void;
  }>();

  // ===== tab 状态（最近使用在左，会话记录在右） =====
  const activeTab = ref<string>("recent");
  const activeTabIndex = computed((): number => activeTab.value == "history" ? 1 : 0);
  // 两个原生 list-view 必须各自持有刷新状态，避免 Tab 切换时互相污染。
  const recentRefreshing = ref<boolean>(false);
  const convRefreshing = ref<boolean>(false);
  // Android 会在 Activity/调试资源重载时恢复 list-view 的原生刷新位移。
  // 首帧延后创建列表，刷新结束时重建原生节点，确保遗留刷新层被真正销毁。
  const recentListMounted = ref<boolean>(false);
  const conversationListMounted = ref<boolean>(false);
  const recentListKey = ref<number>(0);
  const conversationListKey = ref<number>(0);
  const recentListRef = ref<UniElement | null>(null);
  const conversationListRef = ref<UniElement | null>(null);
  const recentScrollTop = ref<number>(0);
  const convScrollTop = ref<number>(0);
  const recentScrollIntoView = ref<string>("");
  const convScrollIntoView = ref<string>("");
  let recentSavedScrollTop = 0;
  let convSavedScrollTop = 0;
  let recentFrozenScrollTop = 0;
  let convFrozenScrollTop = 0;
  let recentAnchorIndex = 0;
  let convAnchorIndex = 0;
  let recentRestorePending = false;
  let convRestorePending = false;
  let recentScrollFrozen = false;
  let convScrollFrozen = false;
  let recentRefreshInFlight = false;
  let convRefreshInFlight = false;
  const NORMAL_PAGE_SIZE = 20;
  const SILENT_HEAD_SIZE = 10;
  const RECENT_ITEM_RPX = 150;
  const CONV_ITEM_RPX = 140;

  function rpxToPx(rpx: number): number {
    const info = uni.getWindowInfo();
    const w = info.windowWidth;
    if (w <= 0) {
      return rpx / 2;
    }
    return w / 750 * rpx;
  }

  function recentItemDomId(agentId: number): string {
    return "ru-" + agentId;
  }

  function convItemDomId(id: number): string {
    return "cv-" + id;
  }

  function readListScrollTop(inst: UniElement | null): number {
    if (inst == null) {
      return 0;
    }
    try {
      const top = inst.scrollTop;
      if (top == top && top > 0) {
        return top;
      }
    } catch (_e) {
      return 0;
    }
    return 0;
  }

  function clampListIndex(index: number, length: number): number {
    if (length <= 0) {
      return 0;
    }
    if (index < 0) {
      return 0;
    }
    if (index >= length) {
      return length - 1;
    }
    return index;
  }

  // ============================================================
  // 最近使用（agent-list-content 逻辑移植）
  // ============================================================
  const recentAgentList = ref<AgentListItem[]>([] as AgentListItem[]);
  const recentLoading = ref<boolean>(false);
  const recentHasMore = ref<boolean>(false);
  const currentPage = ref<number>(1);
  const tenantConfigInfo = ref<any | null>(null);
  let recentRequestGeneration = 0;
  let recentRequestPromise: Promise<any> | null = null;
  let recentSilentRequestPending = false;
  let recentRefreshPending = false;
  const resumeRecentLoadMorePending = ref<boolean>(false);
  let resumeRecentListLength = 0;
  let conversationRefreshPending = false;
  const refreshDrainTick = ref<number>(0);

  const enableSubscription = computed((): number => {
    const tc = tenantConfigInfo.value;
    if (tc != null) {
      const obj = tc as UTSJSONObject;
      const sub = obj["enableSubscription"];
      if (sub != null) {
        return sub as number;
      }
    }
    return 0;
  });

  /** 描述行显隐布局不同，必须分 type，否则 iOS 复用单元格会留下空白。 */
  // #ifndef APP-IOS
  function recentRowType(info: AgentListItem): number {
    if (info.description != "" || (info.paymentRequired && enableSubscription.value == 1)) {
      return 4;
    }
    return 3;
  }
  // #endif

  const recentShowNoMore = computed((): boolean => {
    const rl = recentAgentList.value;
    const rlLen = rl != null ? rl.length : 0;
    return !recentLoading.value && !recentHasMore.value && rlLen > 8;
  });

  function readStr(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }
  function readNum(obj: UTSJSONObject, key: string): number {
    const raw = obj[key];
    return raw != null ? (raw as number) : 0;
  }
  function readBool(obj: UTSJSONObject, key: string): boolean {
    return obj[key] == true;
  }

  function mapToAgentListItem(src: UTSJSONObject, agentIdFromTargetId: boolean): AgentListItem {
    const item = new AgentListItem();
    item.id = readNum(src, "id");
    item.agentId = agentIdFromTargetId ? readNum(src, "targetId") : readNum(src, "agentId");
    item.lastConversationId = readNum(src, "lastConversationId");
    item.name = readStr(src, "name");
    item.icon = readStr(src, "icon");
    item.description = readStr(src, "description");
    item.modified = readStr(src, "modified");
    // 预计算"xx前"文案：拉取时算一次，模板直接读 modifiedTimeText，避免每渲染每 cell 调 formatTimeAgo
    const modifiedAgo = formatTimeAgo(item.modified);
    item.modifiedTimeText = modifiedAgo != null ? modifiedAgo : "";
    item.agentType = readStr(src, "agentType");
    item.paymentRequired = readBool(src, "paymentRequired");
    item.subscribed = readBool(src, "subscribed");
    const conversationListRaw = src["conversationList"];
    const conversations = conversationListRaw != null && Array.isArray(conversationListRaw)
      ? (conversationListRaw as any[])
      : ([] as any[]);
    const mappedConversations = [] as AgentRecentConversationListItem[];
    for (let i = 0; i < conversations.length; i++) {
      const conversationRaw = conversations[i];
      if (conversationRaw == null) continue;
      const conversationObj = conversationRaw as UTSJSONObject;
      const conversation = new AgentRecentConversationListItem();
      conversation.id = readStr(conversationObj, "id");
      conversation.topic = readStr(conversationObj, "topic");
      conversation.taskStatus = readStr(conversationObj, "taskStatus");
      mappedConversations.push(conversation);
    }
    item.conversationList = mappedConversations;
    return item;
  }

  /**
   * 更新已有列表项但保留对象身份。
   * Android 原生 list-view 会复用 list-item；用新对象整体替换列表时，即使 icon URL
   * 没有变化，也可能重新绑定 image 并在解码期间短暂清空已显示的纹理。
   */
  function updateRecentAgentItem(
    target: AgentListItem,
    source: AgentListItem,
  ): void {
    if (target.id != source.id) target.id = source.id;
    if (target.lastConversationId != source.lastConversationId) target.lastConversationId = source.lastConversationId;
    if (target.name != source.name) target.name = source.name;
    // 图标 URL 可能由后端动态生成，不能通过 URL 结构判断资源是否变化。
    // 始终同步接口新值；agent-icon 会先在隐藏层加载完成，再无闪烁切换。
    if (target.icon != source.icon) {
      target.icon = source.icon;
    }
    if (target.description != source.description) target.description = source.description;
    // modified 未变化时不因“xx小时前”的自然流逝刷新整行，避免 Android list-item
    // 在页面恢复时重新绑定内部 image。真正产生新会话时再同步时间文案。
    if (target.modified != source.modified) {
      target.modified = source.modified;
      target.modifiedTimeText = source.modifiedTimeText;
    }
    if (target.agentType != source.agentType) target.agentType = source.agentType;
    if (target.paymentRequired != source.paymentRequired) target.paymentRequired = source.paymentRequired;
    if (target.subscribed != source.subscribed) target.subscribed = source.subscribed;
    // conversationList 当前不参与最近使用列表渲染；不要用每次请求生成的新数组
    // 覆盖它，否则会让所有 list-item 在页面恢复时都被判定为已更新。
  }

  /** 按 agentId 原位协调列表，避免刷新时销毁并重建所有原生图片节点。 */
  function reconcileRecentAgentList(incoming: AgentListItem[]): void {
    const current = recentAgentList.value;
    for (let i = 0; i < incoming.length; i++) {
      const source = incoming[i];
      let target: AgentListItem | null = null;

      if (i < current.length && current[i].agentId == source.agentId) {
        target = current[i];
      } else {
        let existingIndex = -1;
        for (let j = 0; j < current.length; j++) {
          if (current[j].agentId == source.agentId) {
            existingIndex = j;
            break;
          }
        }
        if (existingIndex >= 0) {
          target = current[existingIndex];
          current.splice(existingIndex, 1);
          current.splice(i, 0, target);
        } else {
          current.splice(i, 0, source);
          target = source;
        }
      }

      if (target != null && target !== source) {
        updateRecentAgentItem(target, source);
      }
    }

    if (current.length > incoming.length) {
      current.splice(incoming.length, current.length - incoming.length);
    }
  }

  /** 将静默查询到的头部数据置顶，并保留之前已经加载的分页数据。 */
  function mergeRecentAgentHead(incoming: AgentListItem[]): void {
    const current = recentAgentList.value != null ? recentAgentList.value : ([] as AgentListItem[]);
    const merged = [] as AgentListItem[];

    for (let i = 0; i < incoming.length; i++) {
      const source = incoming[i];
      let target: AgentListItem | null = null;
      for (let j = 0; j < current.length; j++) {
        if (current[j].agentId == source.agentId) {
          target = current[j];
          break;
        }
      }
      if (target != null) {
        updateRecentAgentItem(target, source);
      } else {
        target = source;
      }

      let duplicated = false;
      for (let k = 0; k < merged.length; k++) {
        if (merged[k].agentId == target.agentId) {
          duplicated = true;
          break;
        }
      }
      if (!duplicated) merged.push(target);
    }

    for (let i = 0; i < current.length; i++) {
      const candidate = current[i];
      let duplicated = false;
      for (let j = 0; j < merged.length; j++) {
        if (merged[j].agentId == candidate.agentId) {
          duplicated = true;
          break;
        }
      }
      if (!duplicated) merged.push(candidate);
    }
    recentAgentList.value = merged;
  }

  function toRecentPayload(info: AgentListItem): UTSJSONObject {
    const obj = new UTSJSONObject();
    obj["id"] = info.id;
    obj["agentId"] = info.agentId;
    obj["lastConversationId"] = info.lastConversationId;
    obj["name"] = info.name;
    obj["icon"] = info.icon;
    obj["description"] = info.description;
    obj["modified"] = info.modified;
    obj["agentType"] = info.agentType;
    obj["paymentRequired"] = info.paymentRequired;
    obj["subscribed"] = info.subscribed;
    return obj;
  }

  async function fetchUserUsedAgentList(
    page: number = 1,
    pageSize: number = NORMAL_PAGE_SIZE,
  ): Promise<any> {
    // 正常加载请求优先于静默刷新；用于丢弃并发静默请求的过期响应。
    recentRequestGeneration = recentRequestGeneration + 1;
    try {
      const params = new ListParams();
      params.pageIndex = page;
      params.size = pageSize;
      const res = await apiUserUsedAgentList(params);
      const code = apiResCode(res);
      const dataRaw = apiResData<any>(res);
      if (code == SUCCESS_CODE) {
        const rawList = dataRaw != null ? (dataRaw as any[]) : ([] as any[]);
        const newList = [] as AgentListItem[];
        for (let j = 0; j < rawList.length; j++) {
          newList.push(mapToAgentListItem(rawList[j] as UTSJSONObject, false));
        }
        if (page > 1) {
          const existing = recentAgentList.value != null ? recentAgentList.value : ([] as AgentListItem[]);
          const combined = [] as AgentListItem[];
          for (let i = 0; i < existing.length; i++) {
            combined.push(existing[i]);
          }
          for (let k = 0; k < newList.length; k++) {
            const candidate = newList[k];
            let duplicated = false;
            for (let m = 0; m < combined.length; m++) {
              if (combined[m].agentId == candidate.agentId) {
                duplicated = true;
                break;
              }
            }
            if (!duplicated) combined.push(candidate);
          }
          // Android 原生 list-view 对数据源引用变化响应更稳定，追加后显式回写新数组。
          recentAgentList.value = combined;
        } else {
          reconcileRecentAgentList(newList);
        }
        // 后端可能在仍有下一页时返回不足 pageSize 条；仅空页可确认已经到底。
        recentHasMore.value = newList.length > 0;
        currentPage.value = page;
        return dataRaw;
      }
      return false;
    } catch (error) {
      console.error("fetchUserUsedAgentList error:", error);
      return false;
    }
  }

  async function fetchPublishedAgentList(): Promise<any> {
    try {
      const params = new SquarePublishedListParams();
      params.targetType = "Agent";
      params.targetSubType = "ChatBot";
      params.page = 1;
      params.pageSize = 10;
      params.category = "";
      params.kw = "";
      const res = await apiPublishedAgentList(params);
      const code = apiResCode(res);
      if (code == SUCCESS_CODE) {
        const pageDataRaw = apiResData<any>(res);
        const pageObj = pageDataRaw != null ? (pageDataRaw as UTSJSONObject) : null;
        const recordsRaw = pageObj != null ? pageObj["records"] : null;
        const records = recordsRaw != null ? (recordsRaw as any[]) : ([] as any[]);
        const agentList = [] as AgentListItem[];
        for (let i = 0; i < records.length; i++) {
          agentList.push(mapToAgentListItem(records[i] as UTSJSONObject, true));
        }
        reconcileRecentAgentList(agentList);
        recentHasMore.value = false;
        currentPage.value = 1;
        return agentList;
      }
    } catch (error) {
      console.error("fetchPublishedAgentList error:", error);
      return false;
    }
  }

  async function deleteUserUsedAgent(agentId: number): Promise<void> {
    const res = await apiUserUsedAgentDelete(agentId);
    const code = apiResCode(res);
    const message = apiResMessage(res);
    if (code == SUCCESS_CODE) {
      const current = recentAgentList.value != null ? recentAgentList.value : ([] as AgentListItem[]);
      const filtered = [] as AgentListItem[];
      for (let i = 0; i < current.length; i++) {
        if (current[i].agentId != agentId) {
          filtered.push(current[i]);
        }
      }
      recentAgentList.value = filtered;
    } else if (code != USER_NO_LOGIN && code != REDIRECT_LOGIN) {
      uni.showToast({
        title: message.length > 0 ? message : t("Mobile.AgentList.deleteFailed"),
        icon: "none",
      });
    }
  }

  function handleRecentLongPress(info: AgentListItem) {
    if (!props.isLoggedIn) {
      return;
    }
    uni.showModal({
      title: t("Mobile.AgentList.confirmDeleteAgent"),
      content: info.name,
      success: (res) => {
        if (res.confirm) {
          deleteUserUsedAgent(info.agentId);
        }
      },
    });
  }

  function markRecentLoadMoreForResume(): void {
    if (!recentHasMore.value || resumeRecentLoadMorePending.value) return;
    resumeRecentLoadMorePending.value = true;
    resumeRecentListLength = recentAgentList.value.length;
  }

  function handleRecentClick(info: AgentListItem, index: number) {
    snapshotRecentListPosition(index);
    if (index == recentAgentList.value.length - 1) {
      markRecentLoadMoreForResume();
    }
    emit("agent-click", toRecentPayload(info));
  }

  async function fetchTenantConfig() {
    const res = await apiTenantConfig();
    if (apiResCode(res) == SUCCESS_CODE) {
      const data = apiResData<any>(res);
      tenantConfigInfo.value = data;
      if (data != null) {
        uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(data));
      }
    }
  }

  async function initTenantConfig() {
    const tenantConfigInfoString = uni.getStorageSync(TENANT_CONFIG_INFO) as string;
    if (tenantConfigInfoString != null && tenantConfigInfoString.length > 0) {
      const parsed = JSON.parse(tenantConfigInfoString);
      if (parsed != null) {
        tenantConfigInfo.value = parsed;
      }
    }
    await fetchTenantConfig();
  }

  async function executeRecentRequest(
    page: number,
    pageSize: number,
    shouldInitTenantConfig: boolean,
  ): Promise<any> {
    if (shouldInitTenantConfig) {
      await initTenantConfig();
    }
    if (props.isLoggedIn) {
      return await fetchUserUsedAgentList(page, pageSize);
    }
    return await fetchPublishedAgentList();
  }

  /**
   * 最近使用的首屏、分页和手动刷新统一走单飞入口。
   * 冷启动预加载尚未结束时，刷新会先等待原请求收口，避免两个第一页响应交叉覆盖。
   */
  async function requestRecentList(
    page: number,
    pageSize: number = NORMAL_PAGE_SIZE,
    shouldInitTenantConfig: boolean = false,
  ): Promise<any> {
    const pending = recentRequestPromise;
    if (pending != null) {
      return await pending;
    }

    recentLoading.value = true;
    const requestPromise = executeRecentRequest(page, pageSize, shouldInitTenantConfig);
    recentRequestPromise = requestPromise;
    try {
      return await requestPromise;
    } finally {
      recentRequestPromise = null;
      recentLoading.value = false;
      refreshDrainTick.value = refreshDrainTick.value + 1;
    }
  }

  async function loadRecent() {
    if (recentAgentList.value.length > 0) return;
    await requestRecentList(1, NORMAL_PAGE_SIZE, true);
  }

  // ============================================================
  // 历史会话（conversation-list-content 逻辑移植）
  // ============================================================
  class ConversationRowView {
    id: number = 0;
    topic: string = "";
    timeLabel: string = "";
    agentName: string = "";
    showExecuting: boolean = false;
  }

  const conversationList = ref<UTSJSONObject[]>([]);
  const convInitialLoading = ref<boolean>(false);
  const convLoadingMore = ref<boolean>(false);
  const convHasMore = ref<boolean>(false);
  const lastId = ref<number | null>(null);
  const pageVisible = ref<boolean>(true);
  const resumeConversationLoadMorePending = ref<boolean>(false);
  let resumeConversationListLength = 0;
  let conversationRequestPromise: Promise<boolean> | null = null;
  let conversationRequestGeneration = 0;
  let conversationSilentRequestPending = false;

  const convLoading = computed((): boolean => {
    return convInitialLoading.value || convLoadingMore.value;
  });

  function toNum(v: any | null, fallback: number = 0): number {
    if (v == null) {
      return fallback;
    }
    if (typeof v == "number") {
      const n = v as number;
      return n != n ? fallback : n;
    }
    const parsed = parseFloat(`${v}`);
    return parsed != parsed ? fallback : parsed;
  }
  function toStr(v: any | null, fallback: string = ""): string {
    if (v == null) {
      return fallback;
    }
    return `${v}`;
  }

  function normalizeList(raw: any | null): UTSJSONObject[] {
    const result: UTSJSONObject[] = [];
    if (raw == null) {
      return result;
    }
    let items: any[] = [];
    if (Array.isArray(raw)) {
      items = raw as any[];
    } else {
      try {
        const jsonStr = JSON.stringify(raw);
        if (jsonStr != null && jsonStr.length > 0) {
          const parsed = JSON.parse(jsonStr);
          if (Array.isArray(parsed)) {
            items = parsed as any[];
          }
        }
      } catch (_e) {
        return result;
      }
    }
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      if (item == null) {
        continue;
      }
      try {
        const jsonStr = JSON.stringify(item);
        if (jsonStr != null && jsonStr.length > 0) {
          const obj = JSON.parse(jsonStr) as UTSJSONObject | null;
          if (obj != null) {
            const agentRaw = obj["agent"];
            let agentName = "";
            if (agentRaw != null) {
              try {
                const agentStr = JSON.stringify(agentRaw);
                if (agentStr != null && agentStr.length > 0) {
                  const agentObj = JSON.parse(agentStr) as UTSJSONObject | null;
                  if (agentObj != null) {
                    agentName = toStr(agentObj["name"], "");
                  }
                }
              } catch (_3) {
                agentName = "";
              }
            }
            obj["_agentName"] = agentName;
            result.push(obj);
          }
        }
      } catch (_e2) {
        // skip
      }
    }
    return result;
  }

  const convRowList = computed((): ConversationRowView[] => {
    const raw = conversationList.value;
    const result: ConversationRowView[] = [];
    if (raw == null) {
      return result;
    }
    const unnamed = t("Mobile.Conversation.unnamed");
    const unknownAgent = t("Mobile.Conversation.unknownAgent");
    for (let i = 0; i < raw.length; i++) {
      const item = raw[i];
      if (item == null) {
        continue;
      }
      const row = new ConversationRowView();
      row.id = toNum(item["id"], 0);
      const topic = toStr(item["topic"], "");
      row.topic = topic.length > 0 ? topic : unnamed;
      const modified = toStr(item["modified"], "");
      const ago = formatTimeAgo(modified);
      row.timeLabel = ago != null ? ago : "";
      const agentName = toStr(item["_agentName"], "");
      row.agentName = agentName.length > 0 ? agentName : unknownAgent;
      const statusStr = toStr(item["taskStatus"], "");
      row.showExecuting = statusStr == "EXECUTING";
      result.push(row);
    }
    return result;
  });

  const convShowNoMore = computed((): boolean => {
    const cl = conversationList.value;
    const clLen = cl != null ? cl.length : 0;
    return !convLoading.value && !convHasMore.value && clLen > 8;
  });

  /** 静默查询“最近使用”头部 10 条，置顶去重且保留已加载分页数据。 */
  async function silentFetchRecentList(force: boolean = false): Promise<void> {
    if ((!force && !pageVisible.value) || recentAgentList.value.length == 0 || recentLoading.value || recentSilentRequestPending) return;
    recentSilentRequestPending = true;
    const requestGeneration = recentRequestGeneration;
    try {
      if (props.isLoggedIn) {
        const params = new ListParams();
        params.pageIndex = 1;
        params.size = SILENT_HEAD_SIZE;
        const res = await apiUserUsedAgentList(params);
        const code = apiResCode(res);
        const dataRaw = apiResData<any>(res);
        // 分页请求已开始时丢弃旧静默响应，避免第一页结果覆盖追加后的列表。
        if (code == SUCCESS_CODE && requestGeneration == recentRequestGeneration) {
          const rawList = dataRaw != null ? (dataRaw as any[]) : ([] as any[]);
          const newList = [] as AgentListItem[];
          for (let j = 0; j < rawList.length; j++) {
            newList.push(mapToAgentListItem(rawList[j] as UTSJSONObject, false));
          }
          mergeRecentAgentHead(newList);
        }
      } else {
        const params = new SquarePublishedListParams();
        params.targetType = "Agent";
        params.targetSubType = "ChatBot";
        params.page = 1;
        params.pageSize = SILENT_HEAD_SIZE;
        params.category = "";
        params.kw = "";
        const res = await apiPublishedAgentList(params);
        const code = apiResCode(res);
        if (code == SUCCESS_CODE) {
          const pageDataRaw = apiResData<any>(res);
          const pageObj = pageDataRaw != null ? (pageDataRaw as UTSJSONObject) : null;
          const recordsRaw = pageObj != null ? pageObj["records"] : null;
          const records = recordsRaw != null ? (recordsRaw as any[]) : ([] as any[]);
          const newList = [] as AgentListItem[];
          for (let i = 0; i < records.length; i++) {
            newList.push(mapToAgentListItem(records[i] as UTSJSONObject, true));
          }
          mergeRecentAgentHead(newList);
        }
      }
    } catch (error) {
      console.error("silentFetchRecentList error:", error);
    } finally {
      recentSilentRequestPending = false;
      refreshDrainTick.value = refreshDrainTick.value + 1;
    }
  }

  function updateConversationItem(target: UTSJSONObject, source: UTSJSONObject): void {
    const topic = source["topic"];
    if (topic != null) {
      target["topic"] = topic;
    }
    const modified = source["modified"];
    if (modified != null) {
      target["modified"] = modified;
    }
    const taskStatus = source["taskStatus"];
    if (taskStatus != null) {
      target["taskStatus"] = taskStatus;
    }
    const agentName = source["_agentName"];
    if (agentName != null) {
      target["_agentName"] = agentName;
    }
    const agentId = source["agentId"];
    if (agentId != null) {
      target["agentId"] = agentId;
    }
  }

  /** 将会话头部增量置顶去重，保留原列表尾部及其分页游标。 */
  function mergeConversationHead(incoming: UTSJSONObject[]): void {
    const current = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
    const merged: UTSJSONObject[] = [];

    for (let i = 0; i < incoming.length; i++) {
      const source = incoming[i];
      const sourceId = toNum(source["id"], 0);
      let target: UTSJSONObject | null = null;
      for (let j = 0; j < current.length; j++) {
        if (toNum(current[j]["id"], 0) == sourceId) {
          target = current[j];
          break;
        }
      }
      if (target != null) {
        updateConversationItem(target, source);
      } else {
        target = source;
      }
      let duplicated = false;
      for (let k = 0; k < merged.length; k++) {
        if (toNum(merged[k]["id"], 0) == sourceId) {
          duplicated = true;
          break;
        }
      }
      if (!duplicated) merged.push(target);
    }

    for (let i = 0; i < current.length; i++) {
      const candidate = current[i];
      const candidateId = toNum(candidate["id"], 0);
      let duplicated = false;
      for (let j = 0; j < merged.length; j++) {
        if (toNum(merged[j]["id"], 0) == candidateId) {
          duplicated = true;
          break;
        }
      }
      if (!duplicated) merged.push(candidate);
    }
    conversationList.value = merged;
  }

  /** 静默查询会话头部 10 条，保留已加载列表、末尾游标和分页状态。 */
  async function silentFetchConversationList(): Promise<void> {
    if (!props.isLoggedIn || conversationList.value.length == 0 || conversationRequestPromise != null || conversationSilentRequestPending) return;
    conversationSilentRequestPending = true;
    const requestGeneration = conversationRequestGeneration;
    try {
      const params = new ConversationListParams();
      params.agentId = null;
      params.lastId = null;
      params.limit = SILENT_HEAD_SIZE;
      const res = await apiAgentConversationList(params);
      if (apiResCode(res) == SUCCESS_CODE && requestGeneration == conversationRequestGeneration) {
        const newList = normalizeList(apiResData<any>(res));
        mergeConversationHead(newList);
      }
    } catch (error) {
      console.error("silentFetchConversationList error:", error);
    } finally {
      conversationSilentRequestPending = false;
      refreshDrainTick.value = refreshDrainTick.value + 1;
    }
  }

  /** 仅将当前打开的 Tab 加入静默刷新队列。 */
  function queueActiveTabSilentRefresh(): void {
    if (activeTab.value == "recent") {
      recentRefreshPending = true;
      conversationRefreshPending = false;
    } else {
      recentRefreshPending = false;
      conversationRefreshPending = true;
    }
    refreshDrainTick.value = refreshDrainTick.value + 1;
  }

  // #ifdef APP-IOS
  let homeListRebuildSeq = 0;

  function releaseFrozenScroll(): void {
    // 不要在返回时写 scroll-top：覆盖层后读到的 scrollTop 经常是 0，
    // 强行跳回去会把上方单元格高度缓存清掉，一往上滑就是空白。
    recentRestorePending = false;
    recentScrollFrozen = false;
    convRestorePending = false;
    convScrollFrozen = false;
  }

  /**
   * 返回首页：列表保持可见，静默拉头部数据并更新。iOS 用 scroll-view，可安全重排。
   */
  function scheduleHomeListRebuild(): void {
    homeListRebuildSeq = homeListRebuildSeq + 1;
    const seq = homeListRebuildSeq;
    setTimeout((): void => {
      if (seq != homeListRebuildSeq) {
        return;
      }
      rebuildHomeLists(seq);
    }, 80);
  }

  async function rebuildHomeLists(seq: number): Promise<void> {
    if (seq != homeListRebuildSeq) {
      return;
    }
    pageVisible.value = true;
    recentRefreshPending = false;
    conversationRefreshPending = false;
    releaseFrozenScroll();
    if (seq != homeListRebuildSeq) {
      return;
    }
    if (activeTab.value == "recent") {
      await silentFetchRecentList(true);
    } else {
      await silentFetchConversationList();
    }
    if (seq != homeListRebuildSeq) {
      return;
    }
    recentRefreshPending = false;
    conversationRefreshPending = false;
  }
  // #endif

  /**
   * 消费全局 batch 轮询分发的 ChatFinished。
   * 移动端没有 PC 端的 EXECUTING 乐观写入链路，因此必须常驻订阅；否则事件会在首页订阅前被 clear。
   * 仅静默更新当前打开的首页 Tab；页面隐藏时保留标记，返回首页后再刷新。
   */
  function handleChatFinishedEvent(_data: any | null): void {
    // #ifdef APP-IOS
    if (pageVisible.value) {
      queueActiveTabSilentRefresh();
    }
    // #endif
    // #ifndef APP-IOS
    queueActiveTabSilentRefresh();
    // #endif
  }

  async function fetchConversationList(isLoadMore: boolean = false): Promise<boolean> {
    if (!props.isLoggedIn) {
      if (isLoadMore) {
        convLoadingMore.value = false;
      } else {
        convInitialLoading.value = false;
      }
      return false;
    }
    // 用户主动刷新/分页优先，令并发的旧静默响应失效。
    conversationRequestGeneration = conversationRequestGeneration + 1;
    try {
      const params = new ConversationListParams();
      params.agentId = null;
      params.lastId = isLoadMore ? lastId.value : null;
      params.limit = NORMAL_PAGE_SIZE;
      const res = await apiAgentConversationList(params);
      if (apiResCode(res) == SUCCESS_CODE) {
        const newList = normalizeList(apiResData<any>(res));
        if (isLoadMore) {
          const existing = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
          const combined: UTSJSONObject[] = [];
          for (let i = 0; i < existing.length; i++) {
            combined.push(existing[i]);
          }
          for (let j = 0; j < newList.length; j++) {
            const candidate = newList[j];
            const candidateId = toNum(candidate["id"], 0);
            let duplicated = false;
            for (let k = 0; k < combined.length; k++) {
              if (toNum(combined[k]["id"], 0) == candidateId) {
                duplicated = true;
                break;
              }
            }
            if (!duplicated) combined.push(candidate);
          }
          conversationList.value = combined;
        } else {
          conversationList.value = newList;
        }
        if (newList.length > 0) {
          const last = newList[newList.length - 1];
          lastId.value = toNum(last["id"], 0);
          // 接口可能返回不足 20 条但仍存在下一页，只有空页才能确认到底。
          convHasMore.value = true;
        } else {
          convHasMore.value = false;
        }
        return true;
      }
      return false;
    } catch (error) {
      console.error("fetchConversationList error:", error);
      return false;
    } finally {
      if (isLoadMore) {
        convLoadingMore.value = false;
      } else {
        convInitialLoading.value = false;
      }
    }
  }

  async function requestConversationList(isLoadMore: boolean): Promise<boolean> {
    const pending = conversationRequestPromise;
    if (pending != null) {
      return await pending;
    }

    if (isLoadMore) {
      if (!convHasMore.value) {
        return false;
      }
      convLoadingMore.value = true;
    } else {
      convInitialLoading.value = true;
    }

    const requestPromise = fetchConversationList(isLoadMore);
    conversationRequestPromise = requestPromise;
    try {
      return await requestPromise;
    } finally {
      // 单飞入口保证同一时刻只有这一笔会话列表请求。
      conversationRequestPromise = null;
      refreshDrainTick.value = refreshDrainTick.value + 1;
    }
  }

  async function loadConversation() {
    if (conversationList.value.length > 0) return;
    await requestConversationList(false);
  }

  function getConvItemByIndex(index: number): UTSJSONObject | null {
    const list = conversationList.value;
    if (list == null || index < 0 || index >= list.length) {
      return null;
    }
    return list[index];
  }

  function markConversationLoadMoreForResume(): void {
    if (!convHasMore.value || resumeConversationLoadMorePending.value) return;
    resumeConversationLoadMorePending.value = true;
    resumeConversationListLength = conversationList.value.length;
  }

  function handleConvClick(index: number) {
    snapshotConversationListPosition(index);
    const item = getConvItemByIndex(index);
    if (item != null) {
      if (index == conversationList.value.length - 1) {
        markConversationLoadMoreForResume();
      }
      emit("conversation-click", item);
    }
  }

  async function performRenameSubmit(item: UTSJSONObject, newName: string): Promise<void> {
    if (newName.length == 0) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleEmpty"), icon: "none" });
      return;
    }
    if (newName.length > 50) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleTooLong"), icon: "none" });
      return;
    }
    try {
      const updateParams = new AgentConversationUpdateParams();
      updateParams.id = toNum(item["id"], 0);
      updateParams.topic = newName;
      const updateRes = await apiAgentConversationUpdate(updateParams);
      if (apiResCode(updateRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameSuccess"), icon: "success" });
        item["topic"] = newName;
        const list = conversationList.value;
        conversationList.value = list != null ? list.slice(0) : ([] as UTSJSONObject[]);
      } else {
        const errorMessage = apiResMessage(updateRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  async function performDeleteSubmit(item: UTSJSONObject): Promise<void> {
    try {
      const id = toNum(item["id"], 0);
      const deleteRes = await apiAgentConversationDelete(id);
      if (apiResCode(deleteRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.deleteSuccess"), icon: "success" });
        const current = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
        const next: UTSJSONObject[] = [];
        for (let i = 0; i < current.length; i++) {
          const c = current[i];
          if (toNum(c["id"], -1) != id) {
            next.push(c);
          }
        }
        conversationList.value = next;
      } else {
        const errorMessage = apiResMessage(deleteRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  function handleConvRename(item: UTSJSONObject): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.renameModalTitle"),
      editable: true,
      placeholderText: t("Mobile.Components.HistoryConversationList.renamePlaceholder"),
      content: toStr(item["topic"], ""),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      success: (res) => {
        if (res.confirm) {
          const rawContent = res.content;
          const newName = rawContent != null ? rawContent.trim() : "";
          performRenameSubmit(item, newName);
        }
      },
    });
  }

  function handleConvDelete(item: UTSJSONObject): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.deleteModalTitle"),
      content: t("Mobile.Components.HistoryConversationList.deleteModalContent"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm) {
          performDeleteSubmit(item);
        }
      },
    });
  }

  function handleConvLongPress(index: number) {
    const item = getConvItemByIndex(index);
    if (item == null) {
      return;
    }
    const options = [
      t("Mobile.Components.HistoryConversationList.rename"),
      t("Mobile.Components.HistoryConversationList.delete"),
    ];
    uni.showActionSheet({
      itemList: options,
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.tapIndex == 0) {
          handleConvRename(item);
        } else if (res.tapIndex == 1) {
          handleConvDelete(item);
        }
      },
    });
  }

  // ============================================================
  // 刷新 / 加载更多（两个常驻列表各自处理，避免后台页误触发当前页请求）
  // ============================================================
  /**
   * 部分 Android ROM 不响应 refresher-triggered 的 true→false，原生刷新层会永久停留。
   * 更新 key 会在同一渲染批次原位替换 list-view：销毁原生刷新状态，但不先清空页面。
   */
  async function releaseRecentRefresher(): Promise<void> {
    recentRefreshing.value = false;
    recentListKey.value = recentListKey.value + 1;
    await nextTick();
  }

  async function releaseConversationRefresher(): Promise<void> {
    convRefreshing.value = false;
    conversationListKey.value = conversationListKey.value + 1;
    await nextTick();
  }

  async function performRecentRefresh(): Promise<void> {
    try {
      // 确保 true 先独立提交给原生，再开始等待冷启动预加载或刷新请求。
      await nextTick();
      const pending = recentRequestPromise;
      if (pending != null) {
        await pending;
      }
      resumeRecentLoadMorePending.value = false;
      currentPage.value = 1;
      recentHasMore.value = true;
      await requestRecentList(1, NORMAL_PAGE_SIZE);
    } catch (error) {
      console.error("performRecentRefresh error:", error);
    } finally {
      recentRefreshInFlight = false;
      await releaseRecentRefresher();
    }
  }

  async function performConversationRefresh(): Promise<void> {
    try {
      await nextTick();
      // 会话列表是单飞入口：有在途请求时先等它收口，否则 requestConversationList
      // 会直接复用旧 promise 返回，下拉刷新等于没刷。
      const pending = conversationRequestPromise;
      if (pending != null) {
        await pending;
      }
      resumeConversationLoadMorePending.value = false;
      lastId.value = null;
      convHasMore.value = true;
      await requestConversationList(false);
    } catch (error) {
      console.error("performConversationRefresh error:", error);
    } finally {
      convRefreshInFlight = false;
      await releaseConversationRefresher();
    }
  }

  function resetRecentRefresher(): void {
    recentRefreshing.value = false;
  }

  function resetConversationRefresher(): void {
    convRefreshing.value = false;
  }

  // 模板事件回调保持同步；异步工作由内部任务负责，finally 必定结束原生刷新态。
  function handleRecentRefresh(): void {
    if (recentRefreshInFlight) {
      releaseRecentRefresher();
      return;
    }
    recentRefreshing.value = true;
    recentRefreshInFlight = true;
    performRecentRefresh();
  }

  function handleConversationRefresh(): void {
    if (convRefreshInFlight) {
      releaseConversationRefresher();
      return;
    }
    convRefreshing.value = true;
    convRefreshInFlight = true;
    performConversationRefresh();
  }

  function handleRecentLoadMore(): void {
    if (recentHasMore.value && recentRequestPromise == null) {
      requestRecentList(currentPage.value + 1);
    }
  }

  function handleConversationLoadMore(): void {
    if (convHasMore.value && conversationRequestPromise == null) {
      requestConversationList(true);
    }
  }

  /**
   * Android list-view 返回页面时可能仍处于 lower-threshold 内，不会重新派发
   * scrolltolower。若点击末项后分页没有成功追加，则在所有冲突请求结束后主动补偿一次。
   */
  function drainResumeLoadMore(): void {
    if (!pageVisible.value) return;

    if (activeTab.value == "recent" && resumeRecentLoadMorePending.value) {
      if (recentAgentList.value.length > resumeRecentListLength || !recentHasMore.value) {
        resumeRecentLoadMorePending.value = false;
      } else if (!recentLoading.value && !recentSilentRequestPending) {
        resumeRecentLoadMorePending.value = false;
        handleRecentLoadMore();
      }
    }

    if (activeTab.value == "history" && resumeConversationLoadMorePending.value) {
      if (conversationList.value.length > resumeConversationListLength || !convHasMore.value) {
        resumeConversationLoadMorePending.value = false;
      } else if (conversationRequestPromise == null && !conversationSilentRequestPending) {
        resumeConversationLoadMorePending.value = false;
        handleConversationLoadMore();
      }
    }
  }

  // UTS/Kotlin 不支持此处依赖的函数前向引用，须在所有回调定义完成后注册 watcher。
  watch(refreshDrainTick, (_tick: number) => {
    if (!pageVisible.value) return;
    if (recentRefreshPending && !recentLoading.value && !recentSilentRequestPending) {
      recentRefreshPending = false;
      silentFetchRecentList();
    }
    if (conversationRefreshPending) {
      if (!props.isLoggedIn) {
        conversationRefreshPending = false;
      } else if (conversationRequestPromise == null && !conversationSilentRequestPending) {
        conversationRefreshPending = false;
        silentFetchConversationList();
      }
    }
    drainResumeLoadMore();
  });

  // 对外保留手动加载入口；页面恢复使用 resumeData，避免覆盖分页数据。
  async function loadData() {
    if (activeTab.value == "recent") {
      await loadRecent();
    } else {
      await loadConversation();
    }
  }

  /** 页面离开前记录分页是否被导航打断。 */
  function pauseData(): void {
    pageVisible.value = false;
    snapshotRecentListPosition(-1);
    snapshotConversationListPosition(-1);
    if (activeTab.value == "recent" && recentLoading.value) {
      markRecentLoadMoreForResume();
    }
    if (convLoadingMore.value) {
      markConversationLoadMoreForResume();
    }
  }

  function freezeScrollY(currentY: number, frozenY: number, savedY: number): number {
    if (currentY > 1) {
      return currentY;
    }
    if (frozenY > 1) {
      return frozenY;
    }
    if (savedY > 1) {
      return savedY;
    }
    return 0;
  }

  function snapshotRecentListPosition(clickedIndex: number): void {
    const list = recentAgentList.value;
    const len = list != null ? list.length : 0;
    if (len <= 0) {
      return;
    }
    // 点击时已冻结过，后续 pause/onHide 不要用覆盖后的 0 覆盖真实偏移。
    if (recentScrollFrozen && recentFrozenScrollTop > 1) {
      return;
    }
    const fromEl = readListScrollTop(recentListRef.value);
    recentFrozenScrollTop = freezeScrollY(fromEl, recentFrozenScrollTop, recentSavedScrollTop);
    if (recentFrozenScrollTop > 1) {
      recentSavedScrollTop = recentFrozenScrollTop;
    }
    recentScrollFrozen = true;
    const itemPx = rpxToPx(RECENT_ITEM_RPX);
    let firstIndex = recentAnchorIndex;
    if (itemPx > 1 && recentFrozenScrollTop > 1) {
      firstIndex = Math.floor(recentFrozenScrollTop / itemPx) as number;
    } else if (clickedIndex > 0) {
      firstIndex = clickedIndex;
    }
    recentAnchorIndex = clampListIndex(firstIndex, len);
  }

  function snapshotConversationListPosition(clickedIndex: number): void {
    const list = conversationList.value;
    const len = list != null ? list.length : 0;
    if (len <= 0) {
      return;
    }
    if (convScrollFrozen && convFrozenScrollTop > 1) {
      return;
    }
    const fromEl = readListScrollTop(conversationListRef.value);
    convFrozenScrollTop = freezeScrollY(fromEl, convFrozenScrollTop, convSavedScrollTop);
    if (convFrozenScrollTop > 1) {
      convSavedScrollTop = convFrozenScrollTop;
    }
    convScrollFrozen = true;
    const itemPx = rpxToPx(CONV_ITEM_RPX);
    let firstIndex = convAnchorIndex;
    if (itemPx > 1 && convFrozenScrollTop > 1) {
      firstIndex = Math.floor(convFrozenScrollTop / itemPx) as number;
    } else if (clickedIndex > 0) {
      firstIndex = clickedIndex;
    }
    convAnchorIndex = clampListIndex(firstIndex, len);
  }

  function handleRecentScroll(e: UniScrollEvent): void {
    if (e == null || e.detail == null) return;
    const y = e.detail.scrollTop;
    if (recentScrollFrozen || recentRestorePending || !pageVisible.value) {
      return;
    }
    recentSavedScrollTop = y;
    recentFrozenScrollTop = y;
    const list = recentAgentList.value;
    const len = list != null ? list.length : 0;
    const itemPx = rpxToPx(RECENT_ITEM_RPX);
    if (itemPx > 1 && len > 0) {
      recentAnchorIndex = clampListIndex(Math.floor(recentSavedScrollTop / itemPx) as number, len);
    }
  }

  function handleConversationScroll(e: UniScrollEvent): void {
    if (e == null || e.detail == null) return;
    const y = e.detail.scrollTop;
    if (convScrollFrozen || convRestorePending || !pageVisible.value) {
      return;
    }
    convSavedScrollTop = y;
    convFrozenScrollTop = y;
    const list = conversationList.value;
    const len = list != null ? list.length : 0;
    const itemPx = rpxToPx(CONV_ITEM_RPX);
    if (itemPx > 1 && len > 0) {
      convAnchorIndex = clampListIndex(Math.floor(convSavedScrollTop / itemPx) as number, len);
    }
  }

  function scrollToTopRecent(): void {
    recentSavedScrollTop = 0;
    recentFrozenScrollTop = 0;
    recentAnchorIndex = 0;
    recentScrollFrozen = false;
    recentRestorePending = false;
    recentScrollIntoView.value = "";
    recentScrollTop.value = 1;
    nextTick(() => {
      recentScrollTop.value = 0;
    });
  }

  function scrollToTopConv(): void {
    convSavedScrollTop = 0;
    convFrozenScrollTop = 0;
    convAnchorIndex = 0;
    convScrollFrozen = false;
    convRestorePending = false;
    convScrollIntoView.value = "";
    convScrollTop.value = 1;
    nextTick(() => {
      convScrollTop.value = 0;
    });
  }

  async function refreshRecent(): Promise<void> {
    const pending = recentRequestPromise;
    if (pending != null) {
      await pending;
    }
    resumeRecentLoadMorePending.value = false;
    currentPage.value = 1;
    recentHasMore.value = true;
    await requestRecentList(1, NORMAL_PAGE_SIZE, true);
  }

  async function refreshHistory(): Promise<void> {
    if (conversationRequestPromise != null) return;
    resumeConversationLoadMorePending.value = false;
    lastId.value = null;
    convHasMore.value = true;
    await requestConversationList(false);
  }

  /**
   * 重新拉取当前激活 Tab 的最新数据（第一页），并将滚动条置顶。
   */
  async function refreshCurrentTab(): Promise<void> {
    pageVisible.value = true;
    // #ifdef APP-IOS
    // 从聊天/网页应用返回时 onShow 会连打；第二次若走整页刷新会丢掉已加载的分页，滚动也无法还原。
    const recentLen = recentAgentList.value != null ? recentAgentList.value.length : 0;
    const convLen = conversationList.value != null ? conversationList.value.length : 0;
    if (activeTab.value == "recent" && recentLen > 0) {
      scheduleHomeListRebuild();
      return;
    }
    if (activeTab.value == "history" && convLen > 0) {
      scheduleHomeListRebuild();
      return;
    }
    // #endif
    if (activeTab.value == "recent") {
      scrollToTopRecent();
      await refreshRecent();
    } else {
      scrollToTopConv();
      await refreshHistory();
    }
  }

  /**
   * 从会话/详情页返回首页时保留滚动位置，并静默更新当前打开的 Tab。
   * 统一进入待刷新队列；若分页请求尚未结束，会在请求完成后自动补刷。
   */
  async function resumeData(): Promise<void> {
    // #ifdef APP-IOS
    // 关壳 / 从网页应用返回会连打 onShow，合并成一次静默刷新，列表保持可见。
    scheduleHomeListRebuild();
    // #endif
    // #ifndef APP-IOS
    pageVisible.value = true;
    recentScrollFrozen = false;
    convScrollFrozen = false;
    recentRestorePending = false;
    convRestorePending = false;
    queueActiveTabSilentRefresh();
    if (activeTab.value == "recent") {
      if (recentAgentList.value.length == 0 && !recentLoading.value) {
        await loadRecent();
      }
    } else if (conversationList.value.length == 0 && conversationRequestPromise == null) {
      await loadConversation();
    }
    // #endif
  }

  function changeContentTab(tab: string) {
    if (activeTab.value == tab) {
      return;
    }
    activeTab.value = tab;
    emit("tab-change", tab);
    // Tab 切换保留各自已加载的数据、分页游标和滚动位置，仅静默合并头部 10 条。
    // 首次切到尚无数据的 Tab 时仍按正常首屏规格查询 20 条；若预热请求正在进行，
    // 待请求结束后 refreshDrainTick 会自动补一次静默头部刷新。
    queueActiveTabSilentRefresh();
    if (activeTab.value == "recent") {
      if (recentAgentList.value.length == 0 && !recentLoading.value) {
        loadRecent();
      }
    } else if (conversationList.value.length == 0 && conversationRequestPromise == null) {
      loadConversation();
    }
  }

  function handleSwiperChange(e: UniSwiperChangeEvent): void {
    changeContentTab(e.detail.current == 1 ? "history" : "recent");
  }

  // #ifdef APP-IOS
  /**
   * 常驻壳打开时暂停静默刷新并冻结滚动；关壳后与 onShow 共用静默刷新，不重建列表。
   */
  function onResidentChatHomeEvent(raw: any): void {
    const obj = raw as UTSJSONObject;
    const action = obj["action"] != null ? `${obj["action"]}` : "";
    if (action == "open") {
      snapshotRecentListPosition(-1);
      snapshotConversationListPosition(-1);
      pageVisible.value = false;
      return;
    }
    if (action != "hide" && action != "teardown") {
      return;
    }
    scheduleHomeListRebuild();
  }
  // #endif

  async function mountListsAfterFirstRender(): Promise<void> {
    await nextTick();
    recentListMounted.value = true;
    conversationListMounted.value = true;
  }

  onMounted(() => {
    eventBus.on(`${EVENT_TYPE.ChatFinished}`, handleChatFinishedEvent);
    // #ifdef APP-IOS
    uni.$on(RESIDENT_CHAT_EVENT, onResidentChatHomeEvent);
    // #endif
    mountListsAfterFirstRender();
    // 两侧数据并行预热，切换时只做原生位移动画，不临时发起首屏请求。
    loadRecent();
    loadConversation();
  });

  onUnmounted(() => {
    eventBus.off(`${EVENT_TYPE.ChatFinished}`, handleChatFinishedEvent);
    // #ifdef APP-IOS
    uni.$off(RESIDENT_CHAT_EVENT, onResidentChatHomeEvent);
    // #endif
    recentRefreshing.value = false;
    convRefreshing.value = false;
    recentListMounted.value = false;
    conversationListMounted.value = false;
  });

  defineExpose({
    loadData: loadData as any,
    pauseData: pauseData as any,
    resumeData: resumeData as any,
    refreshCurrentTab: refreshCurrentTab as any,
    silentFetchRecentList: silentFetchRecentList as any,
    silentFetchConversationList: silentFetchConversationList as any,
    changeContentTab: changeContentTab as any,
  });
</script>

<style lang="scss" scoped>
  .home-content-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .home-content {
    height: 100%;
    width: 100%;
    min-height: 0;
    background: #ffffff;
  }

  .home-content-swiper {
    width: 100%;
    min-height: 0;
  }

  /* 历史会话项 */
  .conv-item {
    background: #fff;

    .conv-item-inner {
      padding: 24rpx 32rpx;
      border-bottom: 2rpx solid #f0f0f0;

      .title-row {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16rpx;

        .conversation-title {
          flex: 1;
          font-size: 30rpx;
          font-weight: 600;
          color: #333;
          line-height: 42rpx;
          margin-right: 16rpx;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .time-label {
          flex-shrink: 0;
          font-size: 24rpx;
          color: #999;
          line-height: 42rpx;
        }
      }

      .bottom-row {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;

        .agent-name {
          flex: 1;
          font-size: 26rpx;
          color: #999;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .status-tag {
          flex-shrink: 0;
          padding: 4rpx 0;
          margin-left: 16rpx;

          .status-text {
            font-size: 22rpx;
            color: rgba(0, 0, 0, 0.45);
            line-height: 28rpx;
          }
        }
      }
    }
  }

  .recent-item {
    background: #fff;
    height: 150rpx;
    overflow: hidden;

    .recent-item-inner {
      height: 150rpx;
      padding: 0 32rpx;
      box-sizing: border-box;
      display: flex;
      flex-direction: row;
      align-items: center;
    }

    .recent-info {
      flex: 1;
      align-self: stretch;
      min-width: 0;
      position: relative;
    }

    .recent-info-main {
      height: 100%;
      min-width: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .recent-info-line {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 1px;
      height: 2rpx;
      background-color: #f0f0f0;
    }

    .recent-name-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      height: 44rpx;
    }

    .recent-name {
      flex: 1;
      min-width: 0;
      font-size: 32rpx;
      font-weight: 600;
      color: #15171f;
      line-height: 44rpx;
      margin-right: 8rpx;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .recent-time {
      flex-shrink: 0;
      width: 180rpx;
      font-size: 24rpx;
      font-weight: 400;
      color: rgba(21, 23, 31, 0.5);
      line-height: 44rpx;
      text-align: right;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .recent-desc-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      height: 44rpx;
      margin-top: 8rpx;
    }

    .recent-desc {
      flex: 1;
      min-width: 0;
      height: 44rpx;
      font-size: 28rpx;
      color: rgba(21, 23, 31, 0.7);
      line-height: 44rpx;
      font-weight: 400;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .recent-status-tags {
      display: flex;
      flex-direction: row;
      align-items: center;
      flex-shrink: 0;
      margin-left: 12rpx;
    }

    .recent-status-tag {
      padding: 2rpx 12rpx;
      border-radius: 6rpx;
      font-size: 20rpx;
      font-weight: 500;
      line-height: 1.5;
    }

    .recent-status-tag--active {
      background-color: rgba(82, 196, 26, 0.1);
      color: #52c41a;
    }

    .recent-status-tag--warning {
      border: 2rpx solid rgba(0, 122, 255, 0.4);
      color: #007aff;
      background-color: rgba(0, 122, 255, 0.08);
    }
  }

  /* #ifdef APP-IOS */
  /* 固定行高：避免 iOS list-view 复用时行高缓存错乱出现空白间隙（仅 iOS；Android/鸿蒙保持自动高度） */
  .conv-item {
    height: 140rpx;
    overflow: hidden;

    .conv-item-inner {
      height: 140rpx;
      box-sizing: border-box;
      overflow: hidden;

      .title-row {
        height: 42rpx;
        margin-bottom: 16rpx;

        .conversation-title {
          line-height: 42rpx;
          height: 42rpx;
        }

