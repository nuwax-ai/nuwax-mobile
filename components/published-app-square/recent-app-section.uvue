<template>
  <view
    class="recent-app-section"
    @touchstart.stop
    @touchmove.stop
    @touchend.stop
  >
    <view v-if="pages.length > 0" class="recent-section">
      <text class="section-title">{{ t("Mobile.Common.recentUsed") }}</text>
      <swiper
        v-if="pages.length > 1"
        class="recent-swiper"
        :style="recentHeightStyle"
        :current="current"
        :indicator-dots="false"
        :circular="false"
        :duration="300"
        @change="handleSwiperChange"
      >
        <swiper-item v-for="page in pages" :key="page.key">
          <view class="recent-grid recent-grid--fill">
            <view
              v-for="item in page.items"
              :key="getRecentItemKey(item)"
              class="recent-item"
              @click="handleItemClick(item)"
            >
              <recent-app-icon :info="item" :size="46" :iconRadius="14" />
              <text class="recent-name text-ellipsis">{{ getRecentItemName(item) }}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view v-else class="recent-grid" :style="recentHeightStyle">
        <view
          v-for="item in firstPageItems"
          :key="getRecentItemKey(item)"
          class="recent-item"
          @click="handleItemClick(item)"
        >
          <recent-app-icon :info="item" :size="46" :iconRadius="14" />
          <text class="recent-name text-ellipsis">{{ getRecentItemName(item) }}</text>
        </view>
      </view>
      <view v-if="pages.length > 1" class="custom-indicator">
        <view
          v-for="(page, pageIndex) in pages"
          :key="page.key"
          class="custom-indicator-item"
          @click="handleIndicatorClick(pageIndex)"
        >
          <view
            class="custom-indicator-dot"
            :class="{ 'custom-indicator-dot--on': current == pageIndex }"
          ></view>
        </view>
      </view>
    </view>
    <view class="source-row">
      <text
        :class="listScope == 'team' ? 'source-item' : 'source-item source-item--on'"
        @click="handleScopeClick('official')"
      >{{ t("Mobile.AppDev.officialRecommend") }}</text>
      <text
        :class="listScope == 'team' ? 'source-item source-item--on' : 'source-item'"
        @click="handleScopeClick('team')"
      >{{ t("Mobile.AppDev.teamPublish") }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import { RecentAppPage } from "@/types/interfaces/recentAppPage";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import RecentAppIcon from "./recent-app-icon.uvue";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      pages: RecentAppPage[];
      current: number;
      /** official：官方推荐；team：团队发布 */
      listScope?: string;
    }>(),
    {
      pages: [] as RecentAppPage[],
      current: 0,
      listScope: "official",
    },
  );

  const emit = defineEmits<{
    change: [index: number];
    indicatorClick: [index: number];
    itemClick: [item: UTSJSONObject];
    scopeChange: [scope: string];
  }>();

  function handleScopeClick(scope: string): void {
    if (props.listScope == scope) {
      return;
    }
    emit("scopeChange", scope);
  }

  const firstPageItems = computed((): UTSJSONObject[] => {
    if (props.pages.length == 0) {
      return [] as UTSJSONObject[];
    }
    return props.pages[0].items;
  });

  /** 一行四列。当前页超过 4 个才占两行，避免末页不足一行时留白。 */
  const RECENT_ROW_SIZE = 4;

  function itemCountAt(index: number): number {
    if (index < 0 || index >= props.pages.length) {
      return 0;
    }
    return props.pages[index].items.length;
  }

  const showTwoRows = computed((): boolean => {
    const index = props.pages.length > 1 ? props.current : 0;
    return itemCountAt(index) > RECENT_ROW_SIZE;
  });

  const recentHeightStyle = computed((): string => {
    // px 定值：宽屏/折叠屏展开不随屏宽放大
    return showTwoRows.value ? "height:180px" : "height:92px";
  });

  function getRecentItemKey(item: UTSJSONObject): string {
    const idRaw = item["id"];
    if (idRaw != null) {
      return `${idRaw}`;
    }
    const targetRaw = item["targetId"];
    return targetRaw != null ? `${targetRaw}` : "";
  }

  function getRecentItemName(item: UTSJSONObject): string {
    const nameRaw = item["name"];
    return nameRaw != null ? `${nameRaw}` : "";
  }

  function handleSwiperChange(e: UniSwiperChangeEvent): void {
    emit("change", e.detail.current);
  }

  function handleIndicatorClick(index: number): void {
    emit("indicatorClick", index);
  }

  function handleItemClick(item: UTSJSONObject): void {
    emit("itemClick", item);
  }
</script>

<style lang="scss" scoped>
  .section-title {
    padding: 12px 16px 4px;
    color: #111111;
    font-size: 17px;
    font-weight: 600;
    line-height: 22px;
  }

  .source-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 12px 16px 4px;
  }

  .source-item {
    margin-right: 18px;
    color: #8b8a93;
    font-size: 17px;
    font-weight: 400;
  }

  .source-item--on {
    color: #141416;
    font-weight: 700;
  }

  .recent-section {
    flex-shrink: 0;
  }

  .recent-swiper {
    width: 100%;
  }

  .custom-indicator {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 4px 0 0;
  }

  .custom-indicator-item {
    height: 8px;
    padding: 0 3px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .custom-indicator-dot {
    width: 5px;
    height: 5px;
    border-radius: 5px;
    background-color: #e6e6e6;
  }

  .custom-indicator-dot--on {
    width: 14px;
    background-color: #d0d0d0;
  }

  .recent-grid {
    width: 100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px 8px 0;
    box-sizing: border-box;
  }

  .recent-grid--fill {
    height: 100%;
  }

  .recent-item {
    width: 25%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 4px 4px;
    box-sizing: border-box;
  }

  .recent-name {
    width: 100%;
    margin-top: 6px;
    color: #333333;
    font-size: 14px;
    line-height: 17px;
    text-align: center;
  }
</style>
