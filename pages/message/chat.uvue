  }

  .chat-mention-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 12rpx 16rpx;
    border-radius: 16rpx;
  }

  .chat-mention-row--active {
    background-color: #f3f1fb;
  }

  .chat-mention-ava {
    width: 64rpx;
    height: 64rpx;
    border-radius: 32rpx;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-mention-ava-letter {
    font-size: 28rpx;
    line-height: 36rpx;
    font-weight: 600;
    color: #ffffff;
  }

  .chat-mention-name {
    flex: 1;
    min-width: 0;
    margin-left: 20rpx;
    font-size: 29rpx;
    line-height: 40rpx;
    color: #22212a;
  }

  .chat-mention-empty {
    padding: 60rpx 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .chat-mention-empty__text {
    font-size: 26rpx;
    line-height: 36rpx;
    color: #9a98a5;
  }

  /* ===== 字体面板（Markdown 标记对 chips） ===== */
  .chat-font-row {
    min-height: 380rpx;
    padding: 12rpx 8rpx;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
  }

  .chat-font-chip {
    width: 33.3%;
    padding: 20rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .chat-font-chip--active {
    opacity: 0.7;
  }

  .chat-font-chip__glyph {
    width: 96rpx;
    height: 96rpx;
    border-radius: 24rpx;
    background-color: #f3f1fb;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    font-size: 34rpx;
    line-height: 46rpx;
    color: #4a4860;
  }

  .chat-font-chip__glyph--b {
    font-weight: 700;
  }

  .chat-font-chip__glyph--i {
    font-style: italic;
  }

  .chat-font-chip__glyph--s {
    text-decoration-line: line-through;
  }

  .chat-font-chip__glyph--u {
    text-decoration-line: underline;
  }

  .chat-font-chip__glyph--c {
    font-size: 26rpx;
    background-color: rgba(27, 31, 35, 0.06);
  }

  .chat-font-chip__label {
    margin-top: 12rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #55535f;
  }

  /* ===== 富文本气泡渲染（嵌套 text 分段；样式能力对齐 uni-ai-text-md 已验证集） ===== */
  .chat-rich {
    align-self: stretch;
    display: flex;
    flex-direction: column;
  }

  .chat-rl {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .chat-rl--code {
    align-self: stretch;
    margin: 6rpx 0;
    padding: 14rpx 18rpx;
    background-color: #f3f1fb;
    border-radius: 12rpx;
  }

  .chat-rl--code-mine {
    background-color: #f3f1fb;
  }

  .chat-rl--quote {
    align-self: stretch;
    margin: 6rpx 0;
    padding: 4rpx 0 4rpx 18rpx;
    border-left: 6rpx solid #c9c5e8;
  }

  .chat-rl--quote-mine {
    border-left: 6rpx solid rgba(255, 255, 255, 0.4);
  }

  /* 行内段基础（颜色不设：继承外层 chat-bubble__text 的我方白/对方深） */
  .chat-md {
    font-size: 30rpx;
    line-height: 46rpx;
  }

  /* 标题行（# / ## / ###） */
  .chat-md--h1 {
    font-size: 34rpx;
    line-height: 50rpx;
    font-weight: 700;
  }

  .chat-md--h2 {
    font-size: 32rpx;
    line-height: 48rpx;
    font-weight: 700;
  }

  .chat-md--h3 {
    font-size: 30rpx;
    line-height: 46rpx;
    font-weight: 600;
  }

  /* 行内段标记类 */
  .chat-md--b {
    font-weight: 700;
  }

  .chat-md--i {
    font-style: italic;
  }

  .chat-md--s {
    text-decoration-line: line-through;
  }

  .chat-md--u {
    text-decoration-line: underline;
  }

  .chat-md--c {
    font-size: 27rpx;
    background-color: rgba(27, 31, 35, 0.06);
    border-radius: 8rpx;
  }

  /* 行内代码（我方，无气泡底色后与常规版一致） */
  .chat-md--c-mine {
    background-color: rgba(27, 31, 35, 0.06);
  }

  /* 代码块整行（text 存多行原文，字号略小；不在 bubble__text 内需自带颜色） */
  .chat-md--block {
    font-size: 26rpx;
    line-height: 40rpx;
    color: #22212a;
  }

  .chat-md--block-mine {
    color: #22212a;
  }

  /* @提及高亮（对方蓝 / 我方紫底气泡内浅蓝，与链接色同系） */
  .chat-md--at {
    color: #5147ff;
    font-weight: 600;
  }

  .chat-md--at-mine {
    color: #cfd6ff;
    font-weight: 600;
  }

  /* ===== 全屏长文编辑器（⤢ 展开，飞书长文输入样式：白底通栏大输入区） ===== */
  .chat-expand-overlay {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 999;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
  }

  .chat-expand__head {
    flex-shrink: 0;
    height: 108rpx;
    padding: 0 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: #ffffff;
  }

  .chat-expand__close {
    width: 72rpx;
    height: 72rpx;
    border-radius: 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chat-expand__close--active {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .chat-expand__title {
    flex: 1;
    min-width: 0;
    margin: 0 16rpx;
    text-align: center;
    font-size: 33rpx;
    line-height: 46rpx;
    font-weight: 600;
    color: #17171a;
  }

  .chat-expand__body {
    flex: 1;
    padding: 24rpx 32rpx 12rpx;
    display: flex;
    flex-direction: column;
  }

  /* 飞书长文输入：通栏白底无卡片边框，字号略大于坞内输入 */
  .chat-expand__input {
    flex: 1;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 32rpx;
    line-height: 52rpx;
    color: #17171a;
  }

  /* 长文页内嵌面板（表情/@成员/字体），复用主坞面板的内容类 */
  .chat-expand__panel {
    flex-shrink: 0;
    padding: 16rpx 16rpx 12rpx;
    background-color: #ffffff;
  }

  /* 底部工具栏（飞书长文页同款）：浅灰条 + 左侧工具键 + 右端发送箭头 */
  .chat-expand__bar {
    flex-shrink: 0;
    padding: 10rpx 20rpx;
    /* #ifdef H5 || WEB */
    padding-bottom: calc(10rpx + env(safe-area-inset-bottom, 0px));
    /* #endif */
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: #f4f4f8;
  }

  .chat-expand__tools {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .chat-expand__tool {
    width: 76rpx;
    height: 76rpx;
    border-radius: 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-expand__tool--active {
    background-color: #e9e8f0;
  }

  .chat-expand__tool--on {
    background-color: rgba(81, 71, 255, 0.12);
  }

  .chat-expand__tool-text {
    font-size: 34rpx;
    line-height: 46rpx;
    font-weight: 600;
    color: #6b6976;
  }

  .chat-expand__tool-text--aa {
    font-size: 30rpx;
  }

  .chat-expand__tool-text--on {
    color: #5147ff;
  }

  /* 发送箭头：无内容灰态，有内容渐变亮起（对齐飞书右下发送位） */
  .chat-expand__sendbtn {
    width: 72rpx;
    height: 72rpx;
    border-radius: 36rpx;
    background-color: #e6e5ee;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 8rpx;
  }

  .chat-expand__sendbtn--ready {
    background-image: linear-gradient(135deg, #6a5cff 0%, #4436e8 100%);
  }

  .chat-expand__sendbtn--active {
    opacity: 0.85;
  }

  /* 自绘清单 icon（项目 icon 库无对应资源）：有序=方条+线 / 无序=圆点+线 */
  .chat-ex-li {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .chat-ex-li-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin: 3rpx 0;
  }

  .chat-ex-li-dot {
    width: 8rpx;
    height: 8rpx;
    border-radius: 4rpx;
    background-color: #6b6976;
    margin-right: 8rpx;
  }

  .chat-ex-li-bar {
    width: 8rpx;
    height: 12rpx;
    border-radius: 3rpx;
    background-color: #6b6976;
    margin-right: 8rpx;
  }

  .chat-ex-li-line {
    width: 26rpx;
    height: 4rpx;
    border-radius: 2rpx;
    background-color: #9a98a5;
  }
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  /* #endif */
  /* #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || MP-LARK || MP-KUAISHOU || MP-JD */
  page {
    height: 100%;
  }
  /* #endif */
</style>
