<template>
  <view class="recent-app-icon" :style="wrapStyle">
    <image
      v-if="src.length > 0"
      class="recent-app-icon__img"
      :src="src"
      mode="aspectFill"
      :fade-show="false"
      :alt="altText"
      @error="handleImageError"
    />
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, watch } from "vue";
  import { resolveDisplayImageUrl } from "@/utils/remoteSvgImage";
  import defaultAgentIcon from "@/static/assets/agent_image.png";

  const props = withDefaults(
    defineProps<{
      info: UTSJSONObject;
      /** 图标边长（px，密度定值：宽屏/折叠屏展开不放大） */
      size?: number;
      /** 圆角（px） */
      iconRadius?: number;
    }>(),
    {
      size: 56,
      iconRadius: 14,
    },
  );

  const src = ref<string>("");
  const rawIcon = ref<string>("");
  let resolveSeq = 0;

  const wrapStyle = computed((): string => {
    return `width:${props.size}px;height:${props.size}px;border-radius:${props.iconRadius}px;`;
  });

  /**
   * App 端 SVG 光栅化接口按 rpx 口径换算物理像素（×windowWidth/750）。
   * 本组件 size 是 px 口径，须折回 rpx 等价值（cssPx × 750/windowWidth），保证光栅尺寸与 CSS 盒一致。
   */
  function rasterSize(css: number): number {
    let win = 375;
    try {
      const w = uni.getWindowInfo().windowWidth;
      if (w > 0) {
        win = w;
      }
    } catch (_e) {
      // 保持兜底 375
    }
    return (css * 750) / win;
  }

  function readIcon(): string {
    const info = props.info as UTSJSONObject;
    const raw = info["icon"];
    return raw != null ? `${raw}` : "";
  }

  const altText = computed((): string => {
    const info = props.info as UTSJSONObject;
    const raw = info["name"];
    return raw != null ? `${raw}` : "";
  });

  function showDefaultIcon(): void {
    src.value = defaultAgentIcon;
  }

  function applyIcon(): void {
    const icon = readIcon();
    rawIcon.value = icon;
    src.value = "";
    if (icon.length == 0) {
      showDefaultIcon();
      return;
    }
    const seq = ++resolveSeq;
    resolveDisplayImageUrl(icon, rasterSize(props.size), rasterSize(props.size)).then((resolved: string) => {
      if (seq != resolveSeq) {
        return;
      }
      src.value = resolved.length > 0 ? resolved : defaultAgentIcon;
    }, (_err: any | null) => {
      if (seq != resolveSeq) {
        return;
      }
      showDefaultIcon();
    });
  }

  applyIcon();

  watch(
    (): string => readIcon(),
    (): void => {
      applyIcon();
    },
  );

  /**
   * data URL 失败先回退原地址；原地址仍失败再显示默认图标（避免只剩灰底）。
   */
  function handleImageError(): void {
    const current = src.value;
    if (current.length == 0 || current == defaultAgentIcon) {
      return;
    }
    const origin = rawIcon.value;
    if (origin.length > 0 && current != origin && current.indexOf("data:") == 0) {
      src.value = origin;
      return;
    }
    showDefaultIcon();
  }
</script>

<style scoped lang="scss">
  .recent-app-icon {
    flex-shrink: 0;
    overflow: hidden;
    background-color: #f5f5f7;

    &__img {
      width: 100%;
      height: 100%;
    }
  }
</style>
