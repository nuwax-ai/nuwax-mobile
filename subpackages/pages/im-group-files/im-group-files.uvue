<template>
  <view class="gf-page">
    <safety-zone />

    <!-- 顶部：返回 + 标题（入参决定：单聊文件按钮传「文件」，群信息页缺省「群文件」） -->
    <view class="gf-header">
      <view class="gf-header__btn" hover-class="gf-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="gf-header__title-wrap">
        <text class="gf-header__title">{{ titleText }}</text>
      </view>
      <view class="gf-header__btn gf-header__btn--ghost" />
    </view>

    <!-- 分类 tab：全部/图片/文件/视频/音频（对齐 PC 端 ChatFilesPanel） -->
    <view class="gf-tabs">
      <view
        v-for="k in kindTabs"
        :key="k.id"
        class="gf-tab"
        :class="activeKind == k.id ? 'gf-tab--on' : ''"
        hover-class="gf-tab--hover"
        @click="switchKind(k.id)"
      >
        <text
          class="gf-tab__text"
          :class="activeKind == k.id ? 'gf-tab__text--on' : ''"
        >{{ k.label }}</text>
      </view>
    </view>

    <!-- 数据范围说明：文件只来自本窗口已加载的消息（产品语义，见 utils/imChatAttachments） -->
    <view class="gf-hint">
      <text class="gf-hint__text">{{ t("Mobile.Message.filesLoadedHint") }}</text>
    </view>

    <!-- ★padding 放内层容器：iOS 上 scroll-view 的水平 padding 不参与子元素宽度计算，
         文件行会伸进右侧 padding 区被裁掉右边框（Android 正常，iOS 兼容问题） -->
    <scroll-view class="gf-body" direction="vertical" :show-scrollbar="false">
      <view class="gf-list">
        <view
          v-for="f in filteredFiles"
          :key="f.key"
          class="gf-row"
          hover-class="gf-row--active"
          @click="handleFileTap(f)"
        >
          <view class="gf-icon">
            <image
              v-if="f.kind == 'image' && f.thumbUrl.length > 0 && !f.thumbFailed"
              class="gf-thumb"
              :src="f.thumbUrl"
              mode="aspectFill"
              @error="onThumbError(f)"
            />
            <svg-icon v-else name="icon-a-Filetext" size="40" color="#5147ff" />
          </view>
          <view class="gf-col">
            <text class="gf-name text-ellipsis">{{ f.fileName.length > 0 ? f.fileName : f.url }}</text>
            <text class="gf-sub text-ellipsis">
              {{ f.metaText }}
            </text>
          </view>
          <view class="gf-dl" hover-class="gf-dl--active" @click.stop="handleDownload(f)">
            <text class="gf-dl__text">{{ t("Mobile.Terminal.download") }}</text>
          </view>
        </view>
        <view v-if="filteredFiles.length == 0" class="gf-state">
          <text class="gf-state__text">{{ t("Mobile.Message.filesEmpty") }}</text>
        </view>
        <view class="gf-tail" />
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { extOf, getChatAttachments, urlExtOf } from "@/utils/imChatAttachments";
  import {
    isAuthProtectedFileUrl,
    openAuthProtectedLinkUrl,
    openRemoteFileUrl,
  } from "@/utils/authProtectedFileUrl";
  import { handleExternalLink } from "@/utils/system";
  import { resolveDisplayImageUrl } from "@/utils/remoteSvgImage";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /**
   * 文件行（渲染模型：聊天窗口已加载附件的投影 + 页面 UI 态）。
   * ★数据不自取：只显示本窗口已加载消息里的附件（聊天页翻页时写入共享缓存，
   *   见 utils/imChatAttachments）；要找更早的文件，先回「消息」往上翻再回来。
   */
  class GfFile {
    key: string = "";
    kind: string = "file";
    url: string = "";
    fileName: string = "";
    size: number = 0;
    senderName: string = "";
    sendTime: number = 0;
    metaText: string = "";
    /** 缩略图展示地址：普通地址=url；受保护 /api/f/ 先留空，等 Bearer 解析换 blob/临时文件。 */
    thumbUrl: string = "";
    thumbFailed: boolean = false;
  }

  /** 分类 tab（全部 + 图片/文件/视频/音频，顺序对齐 PC ATTACHMENT_KINDS）。 */
  class GfKindTab {
    id: string = "all";
    label: string = "";
  }

  // ===== 页面入参 =====
  const convId = ref<string>("");
  /** 标题：入参 title 优先（单聊「文件」tab 传入），缺省回落「群文件」（群信息页入口）。 */
  const titleText = ref<string>("");

  // ===== 状态 =====
  const files = ref<GfFile[]>([]);
  const activeKind = ref<string>("all");

  function makeKindTab(id: string, labelKey: string): GfKindTab {
    const k = new GfKindTab();
    k.id = id;
    k.label = t(labelKey);
    return k;
  }

  const kindTabs = ref<GfKindTab[]>([
    makeKindTab("all", "Mobile.Common.all"),
    makeKindTab("image", "Mobile.Message.filesTabImage"),
    makeKindTab("file", "Mobile.Message.filesTabFile"),
    makeKindTab("video", "Mobile.Message.filesTabVideo"),
    makeKindTab("audio", "Mobile.Message.filesTabAudio"),
  ]);

  /** 当前 tab 下的文件（all = 不筛）。 */
  const filteredFiles = computed<GfFile[]>((): GfFile[] => {
    if (activeKind.value == "all") {
      return files.value;
    }
    return files.value.filter((f: GfFile): boolean => f.kind == activeKind.value);
  });

  function switchKind(id: string): void {
    activeKind.value = id;
  }

  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  // ===== 展示辅助（分类/后缀判断已挪 utils/imChatAttachments，与聊天页共用） =====

  /** 文件大小展示：B / KB / MB / GB（一位小数，<1KB 直接给字节数）。 */
  function formatSize(size: number): string {
    if (size <= 0) {
      return "";
    }
    if (size < 1024) {
      return `${size} B`;
    }
    const kb = size / 1024;
    if (kb < 1024) {
      return `${kb.toFixed(1)} KB`;
    }
    const mb = kb / 1024;
    if (mb < 1024) {
      return `${mb.toFixed(1)} MB`;
    }
    const gb = mb / 1024;
    return `${gb.toFixed(1)} GB`;
  }

  /** 时间展示：MM-DD HH:mm（跨年补年份）。 */
  function formatTime(ms: number): string {
    if (ms <= 0) {
      return "";
    }
    const d = new Date(ms);
    const now = new Date();
    const pad = (n: number): string => (n < 10 ? `0${n}` : `${n}`);
    const md = `${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
    if (d.getFullYear() != now.getFullYear()) {
      return `${d.getFullYear()}-${md}`;
    }
    return md;
  }

  /** 次行说明：发送人 · 大小 · 时间（缺失项自动跳过）。 */
  function buildMeta(senderName: string, size: number, sendTime: number): string {
    const parts: string[] = [];
    if (senderName.length > 0) {
      parts.push(senderName);
    }
    const sizeText = formatSize(size);
    if (sizeText.length > 0) {
      parts.push(sizeText);
    }
    const timeText = formatTime(sendTime);
    if (timeText.length > 0) {
      parts.push(timeText);
    }
    return parts.join(" · ");
  }

  /**
   * 图片缩略图展示地址（同聊天页 resolveRowMedia）：
   * 受保护 /api/f/ 地址 <image> 带不了 Bearer（H5 被 ORB 拦 401），
   * 先留空占位（渲染文件图标），Bearer 拉取成功后原位换成 blob/临时文件地址；
   * 普通地址直接展示。解析失败维持空占位，行点击仍可走「打开页面」看原图。
   */
  function resolveThumbs(list: GfFile[]): void {
    for (let i = 0; i < list.length; i++) {
      const f = list[i];
      if (f.kind != "image") {
        continue;
      }
      if (!isAuthProtectedFileUrl(f.url)) {
        f.thumbUrl = f.url;
        continue;
      }
      const url = f.url;
      resolveDisplayImageUrl(url, 72, 72)
        .then((resolved: string) => {
          if (resolved != url && resolved.length > 0) {
            f.thumbUrl = resolved;
          }
        })
        .catch((_e: any | null) => {
          // 留空占位：点行仍可经 openAuthProtectedLinkUrl 带凭证打开
        });
    }
  }

  /**
   * 读聊天窗口已加载消息的附件快照（同步、无网络请求）：聊天页首屏 + 往上翻过的
   * 每一页都会写入共享缓存（utils/imChatAttachments），这里按 convId 取投影渲染；
   * 缓存非本会话（如 H5 刷新后直达本页）返回空数组 → 空态。
   */
  function loadFiles(): void {
    const atts = getChatAttachments(convId.value);
    const out: GfFile[] = [];
    for (let i = 0; i < atts.length; i++) {
      const a = atts[i];
      const f = new GfFile();
      f.key = a.key;
      f.kind = a.kind;
      f.url = a.url;
      f.fileName = a.fileName;
      f.size = a.size;
      f.senderName = a.senderName;
      f.sendTime = a.sendTime;
      f.metaText = buildMeta(a.senderName, a.size, a.sendTime);
      out.push(f);
    }
    files.value = out;
    // ★必须经 files.value（响应式代理）取元素再改：直接改 out 里的裸对象不触发视图更新
    resolveThumbs(files.value);
  }

  function onThumbError(f: GfFile): void {
    f.thumbFailed = true;
  }

  /** 行点击：图片放大预览（同聊天页，用解析后的展示地址），其余 /api/f/ 受保护链接「打开页面」，普通链接统一外链打开。 */
  function handleFileTap(f: GfFile): void {
    if (f.url.length == 0) {
      return;
    }
    if (f.kind == "image") {
      if (f.thumbUrl.length > 0) {
        uni.previewImage({ urls: [f.thumbUrl], current: f.thumbUrl });
        return;
      }
      // 缩略图没解析出来（受保护地址拉取失败）：退回带凭证「打开页面」看原图
      if (isAuthProtectedFileUrl(f.url)) {
        openAuthProtectedLinkUrl(f.url).catch((_e: any | null) => {
          uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
        });
        return;
      }
      uni.previewImage({ urls: [f.url], current: f.url });
      return;
    }
    if (isAuthProtectedFileUrl(f.url)) {
      openAuthProtectedLinkUrl(f.url).catch((_e: any | null) => {
        uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
      });
      return;
    }
    handleExternalLink(f.url, f.fileName);
  }

  // ===== 下载（★真下载语义，不再是「打开资源」） =====

  /**
   * 下载文件名（对齐 PC media.ts downloadNameOf 的关键规则）：
   * 名字里的 / \ 压平（带分隔符时浏览器会静默忽略 download 属性）；
   * 没后缀时从 URL 借一个，都取不到给通用兜底。
   */
  function downloadNameOf(f: GfFile): string {
    let raw = f.fileName.trim();
    while (
      raw.length > 0 &&
      (raw.charAt(0) == "/" || raw.charAt(0) == "\\" || raw.charAt(0) == ".")
    ) {
      raw = raw.substring(1);
    }
    raw = raw.split("/").join("_").split("\\").join("_");
    if (raw.length > 0 && extOf(raw).length > 0) {
      return raw;
    }
    const ext = urlExtOf(f.url);
    if (raw.length == 0) {
      return ext.length > 0 ? `file.${ext}` : "file";
    }
    return ext.length > 0 ? `${raw}.${ext}` : raw;
  }

  // #ifdef H5 || WEB
  /**
   * H5 普通地址下载：拉字节转 blob（octet-stream 强制走下载而非导航），
   * CORS 不放行或请求失败时退回新页打开（与旧行为一致，不让用户点了没反应）。
   */
  function downloadNormalUrlOnH5(url: string, name: string): void {
    uni.request({
      url,
      method: "GET",
      responseType: "arraybuffer",
      // 默认 dataType=json 会尝试 JSON.parse，二进制会失败
      dataType: "text",
      success: (res) => {
        if (res.statusCode == 200 && res.data != null) {
          const blob = new Blob([res.data as ArrayBuffer], { type: "application/octet-stream" });
          const objectUrl = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = objectUrl;
          link.download = name;
          link.click();
          setTimeout(() => {
            URL.revokeObjectURL(objectUrl);
          }, 60000);
          return;
        }
        window.open(url, "_blank");
      },
      fail: (_err) => {
        window.open(url, "_blank");
      },
    });
  }
  // #endif

  /** 下载按钮：受保护地址走 openRemoteFileUrl（H5 带 Bearer 拉 blob+保存；App 下载后交系统查看器）。 */
  function handleDownload(f: GfFile): void {
    if (f.url.length == 0) {
      return;
    }
    const name = downloadNameOf(f);
    if (isAuthProtectedFileUrl(f.url)) {
      openRemoteFileUrl(f.url, name).catch((_e: any | null) => {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
      return;
    }
    // #ifdef H5 || WEB
    downloadNormalUrlOnH5(f.url, name);
    // #endif
    // #ifndef H5 || WEB
    openRemoteFileUrl(f.url, name).catch((_e: any | null) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
    // #endif
  }

  function handleBack(): void {
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      uni.switchTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    const title = readOption(options, "title");
    titleText.value = title.length > 0 ? title : t("Mobile.Message.groupFiles");
    loadFiles();
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架：浅灰底（与 Pin 页同底色，白卡浮起） ===== */
  .gf-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #f2f3f5;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  .gf-header {
    flex-shrink: 0;
    height: 108rpx;
    padding: 0 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-bottom: 2rpx solid #e5e6eb;
  }

  .gf-header__btn {
    width: 72rpx;
    height: 72rpx;
    border-radius: 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gf-header__btn--active {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .gf-header__btn--ghost {
    background-color: rgba(0, 0, 0, 0);
  }

  .gf-header__title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .gf-header__title {
    font-size: 33rpx;
    line-height: 46rpx;
    font-weight: 600;
    color: #17171a;
  }

  /* ===== 分类 tab ===== */
  .gf-tabs {
    flex-shrink: 0;
    padding: 20rpx 32rpx 4rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .gf-tab {
    padding: 10rpx 26rpx;
    margin-right: 14rpx;
    border-radius: 30rpx;
    background-color: #ffffff;
    border: 2rpx solid #ecebf1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .gf-tab--on {
    background-color: rgba(81, 71, 255, 0.1);
    border: 2rpx solid rgba(81, 71, 255, 0.28);
  }

  .gf-tab--hover {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .gf-tab__text {
    font-size: 26rpx;
    line-height: 36rpx;
    color: #6b6878;
  }

  .gf-tab__text--on {
    color: #5147ff;
    font-weight: 600;
  }

  /* ===== 数据范围说明（灰小字左对齐，tab 行与列表之间） ===== */
  .gf-hint {
    flex-shrink: 0;
    padding: 8rpx 32rpx 0;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
  }

  .gf-hint__text {
    font-size: 22rpx;
    line-height: 32rpx;
    color: #9a98a5;
    text-align: left;
  }

  .gf-body {
    flex: 1;
    min-height: 0;
  }

  /* 内层容器承担左右留白（勿挪回 .gf-body：iOS 上 scroll-view 的水平 padding
     不参与子元素宽度计算，文件行右边框会被裁） */
  .gf-list {
    padding: 16rpx 32rpx;
  }

  .gf-state {
    padding: 200rpx 48rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .gf-state__text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #9a98a5;
  }

  /* ===== 文件行 ===== */
  .gf-row {
    margin-bottom: 16rpx;
    padding: 20rpx 24rpx;
    background-color: #ffffff;
    border: 2rpx solid #ecebf1;
    border-radius: 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .gf-row--active {
    background-color: #f7f6fb;
  }

  .gf-icon {
    width: 72rpx;
    height: 72rpx;
    border-radius: 18rpx;
    background-color: rgba(81, 71, 255, 0.08);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .gf-thumb {
    width: 72rpx;
    height: 72rpx;
  }

  .gf-col {
    flex: 1;
    min-width: 0;
    margin-left: 20rpx;
    margin-right: 8rpx;
    display: flex;
    flex-direction: column;
  }

  .gf-name {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #22212a;
  }

  .gf-sub {
    margin-top: 4rpx;
    font-size: 22rpx;
    line-height: 32rpx;
    color: #9a98a5;
  }

  /* ===== 下载按钮 ===== */
  .gf-dl {
    flex-shrink: 0;
    padding: 12rpx 26rpx;
    border-radius: 30rpx;
    background-color: rgba(81, 71, 255, 0.1);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .gf-dl--active {
    background-color: rgba(81, 71, 255, 0.2);
  }

  .gf-dl__text {
    font-size: 24rpx;
    line-height: 34rpx;
    font-weight: 600;
    color: #5147ff;
  }

  .gf-tail {
    height: 40rpx;
  }
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #f2f3f5;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #f2f3f5;
  }
  /* #endif */
</style>
