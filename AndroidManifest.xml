<?xml version="1.0" encoding="utf-8"?>
<!--
  uni-app x 自定义 Android 清单（云端打包时与基座清单合并）。
  uni-app x 的 manifest.json 不提供 Android 权限配置（app-plus.distribute.android.permissions
  是老 uni-app 的 schema，云打包不读），自定义权限统一写在本文件 manifest 节点下。
  注意：本文件改动需重新云打包（自定义调试基座）才生效。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.nuwax.app">

    <!-- 聊天附件下载 apk 后拉起系统安装器：Android 8+ 必须声明此权限，否则安装器无反应 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 读取音频类附件（Android 13+ 分区媒体权限，模块默认模板未包含） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

</manifest>
