import { orObject } from "@/utils/utsCoalesce.uts";

export type AgentMode = "ask" | "yolo";

export const AGENT_MODE_STORAGE_KEY = "nuwax_agent_mode_cache";

export class AgentModeCacheObject {
  version?: number;
  defaultMode?: AgentMode;
  agents?: Record<string, AgentMode>;
}

const isAgentMode = (mode: unknown): boolean =>
  mode === "yolo" || mode === "ask";

const normalizeAgentModeCacheAgentId = (
  agentId?: number | string | null,
): string | null => {
  if (agentId === undefined || agentId === null) {
    return null;
  }
  const normalized = String(agentId).trim();
  return normalized.length > 0 ? normalized : null;
};

const parseAgentModeCache = (
  raw: string | null,
): any | null => {
  if (raw == null || `${raw}`.length === 0) {
    return null;
  }
  if (isAgentMode(raw)) {
    return raw;
  }
  try {
    const parsed = JSON.parse(raw);
    if (parsed != null && typeof parsed === "object") {
      return parsed;
    }
  } catch (e) {
    // ignore invalid cache
  }
  return null;
};

export const readAgentModeCache = (
  agentId?: number | string | null,
): AgentMode | null => {
  const agentKey = normalizeAgentModeCacheAgentId(agentId);
  const raw = uni.getStorageSync(AGENT_MODE_STORAGE_KEY) as string;
  const parsed = parseAgentModeCache(raw);

  if (isAgentMode(parsed)) {
    return parsed as AgentMode;
  }

  if (parsed == null) {
    return null;
  }

  const cacheObj = parsed as AgentModeCacheObject;
  const agentMode =
    agentKey != null && cacheObj.agents != null
      ? cacheObj.agents[agentKey]
      : undefined;
  if (isAgentMode(agentMode)) {
    return agentMode;
  }

  if (isAgentMode(cacheObj.defaultMode)) {
    return cacheObj.defaultMode as AgentMode;
  }

  return null;
};

export const writeAgentModeCache = (
  mode: AgentMode,
  agentId?: number | string | null,
) => {
  const agentKey = normalizeAgentModeCacheAgentId(agentId);
  const raw = uni.getStorageSync(AGENT_MODE_STORAGE_KEY) as string;
  const parsed = parseAgentModeCache(raw);

  const nextCache = new AgentModeCacheObject();
  if (parsed != null && !isAgentMode(parsed)) {
    const existing = parsed as AgentModeCacheObject;
    nextCache.version = existing.version;
    nextCache.defaultMode = existing.defaultMode;
    nextCache.agents = { ...orObject(existing.agents, {}) };
  } else {
    nextCache.version = 1;
    nextCache.defaultMode = isAgentMode(parsed)
      ? (parsed as AgentMode)
      : undefined;
    nextCache.agents = {};
  }

  if (agentKey != null) {
    if (nextCache.agents == null) {
      nextCache.agents = {};
    }
    nextCache.agents[agentKey] = mode;
  } else {
    nextCache.defaultMode = mode;
  }

  uni.setStorageSync(AGENT_MODE_STORAGE_KEY, JSON.stringify(nextCache));

  uni.$emit("NuwaxAgentModeChanged", { agentId: agentKey, mode });
};
