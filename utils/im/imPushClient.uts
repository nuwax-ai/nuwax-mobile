// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { apiImDeviceRegister } from "@/servers/im";
import { isAppInBackground } from "@/utils/appLifecycle.uts";
import { NOTIFY_PERMISSION_ASKED_KEY } from "@/utils/installScopedStorage";
// #ifdef APP-HARMONY
// ★勿改成 @kit.NotificationKit 具名导入：基座 JS 运行时模块表不提供 notificationManager
//   具名导出（SyntaxError，2026-10-22 真机实锤），必须默认导入（官方 runtime 同款）。
import notificationManager from "@ohos.notificationManager";
// #endif
// #ifdef APP-ANDROID
import Build from "android.os.Build";
// #endif

/**
 * uni-push 2.0 客户端（离线推送）：cid 获取/上报 + 通知点击进会话。
 *
 * 分工：
 * - cid 获取：uni.getPushClientId() → 落 storage + 模块缓存
 * - cid 上报：走现有 POST /api/instant-message/devices 的 pushToken 字段（后端 DEV-422 已接受并落库，
 *   与 Web Push endpoint 共用 push_token 列）——不新增接口
 * - 离线发送：后端取设备 pushToken(cid) 调 uniCloud 云函数 push-send，由 DCloud 转厂商通道
 *   （后端不接触华为服务账号密钥）
 * - 点击通知：onPushMessage(type=click) → 按 payload.convId/convType 打开会话
 * - 初始化与授权时机：**登录成功之后**（scheduleImPushAfterLogin）。见下。
 *
 * ★2026-11-04 合规调整（应用市场自动审核被拒）：uni-push 官方要求
 *   「弹出隐私框之前不得调用 getPushClientId / onPushMessage」——调用即初始化个推 SDK。
 *   本文件原先由 App.onLaunch 无条件调用这两个 API，发生在协议弹窗之前，属于
 *   「同意前初始化第三方 SDK / 取设备标识 / 发网络请求」，是审核的主要命中项。
 *   现在改为：
 *     - App.onLaunch 只绑 WS/横幅事件，**不碰 uni-push**；
 *     - 登录成功（IM_SESSION_READY）或已登录冷启动（launch 页分流）后，
 *       经 scheduleImPushAfterLogin 延迟初始化：先取 cid，再申请通知权限。
 *   ⇒ 首次安装、未登录期间没有任何推送 SDK 初始化、权限申请与 cid 上报。
 *   ⇒ 鸿蒙「启动就弹通知窗」随之消失——它本来就由我们自己提前调 getPushClientId 触发，
 *     旧注释里「SDK 自己弹、端上拦不住」的结论已更正。
 *
 * 平台范围：Android / iOS / 鸿蒙（manifest 三端均已勾 uni-push 模块）。未勾模块的平台
 * 调用会失败，故整文件条件编译，调用点同样条件编译。
 *
 * ★失败一律静默：标准基座、未开通 uni-push、厂商通道未配置、用户拒授权时
 * getPushClientId 都会失败，绝不能影响启动与 IM 主链路。
 */

/** cid 本地缓存键（跨启动复用，冷启动页面栈未就绪时也能带 cid 注册设备）。 */
const PUSH_CID_STORAGE_KEY = "im_push_client_id";
/** 点击通知首次延迟：冷启动时登录态/页面栈尚未就绪（原生事件栈不补绘帧，见 harmony 三修记忆）。 */
const PUSH_CLICK_NAV_DELAY_MS = 300;
/** 页面栈/启动页未就绪时最长重试次数（每次 300ms，合计约 6s）。 */
const PUSH_CLICK_NAV_MAX_RETRY = 20;
/** 冷启动中转页：它的 onReady 会 reLaunch 到主 Tab，此期间跳会话会被冲掉，需等它走完。 */
const LAUNCH_PAGE_ROUTE = "pages/launch/launch";
/** 登录页：未登录时跳过去，此时不跳会话（登录后落首页，会话上下文已无意义）。 */
const LOGIN_PAGE_ROUTE = "subpackages/pages/login/login";

/**
 * 本次进程启动后是否收到过「通知点击」（含冷启动由推送唤起）。
 *
 * 历史用途是「点通知进来时不弹首启协议卡片」，协议闸门已于 2026-11-04 移除，
 * 现在仅作为排查状态保留（日志/后续深链分流可用），不再影响任何 UI。
 */
let pushClickReceived = false;

/** 是否已收到通知点击（见 pushClickReceived 注释）。 */
export function hasPushClickSinceLaunch(): boolean {
  return pushClickReceived;
}

/** 防重复绑定（App 生命周期内只绑一次）。 */
let pushBound = false;
/** cid 模块缓存（空 = 尚未取到）。 */
let cachedPushCid = "";

/** 当前 uni-push cid（空 = 未取到：标准基座/未开通/未授权）。 */
export function getImPushCid(): string {
  if (cachedPushCid.length > 0) {
    return cachedPushCid;
  }
  try {
    const raw = uni.getStorageSync(PUSH_CID_STORAGE_KEY);
    if (raw != null && typeof raw == "string") {
      cachedPushCid = `${raw}`;
    }
  } catch (_e) {
    // storage 异常：保持空，不影响注册
  }
  return cachedPushCid;
}

/**
 * iOS 后台在线透传兜底：把 receive 到的消息补成一条本地通知。
 *
 * ★2026-11-04 真机实证：manifest 里 app-ios.distribute.UIBackgroundModes=["audio"]，
 *   App 退后台后进程仍存活、个推长连接不断 ⇒ 服务端判定「在线」，推送以在线透传方式
 *   直接回调到 JS（日志 `[ImPush] onPushMessage type=receive`），iOS **不会**为在线
 *   透传消息弹通知栏，用户因此「退后台收不到通知条」（同一时刻 Android 正常，
 *   走的是厂商通道通知栏）。
 *   进程被系统挂起/杀掉后才走 APNs 离线通道，那条由系统自己展示，不需要这里补。
 *   ⇒ 只在 iOS + App 在后台时补；前台 App 内已有 WS 消息与页内提示，再弹是重复打扰。
 *   （uni.createPushMessage 自 HBuilderX 4.18 起支持 iOS。）
 */
function showLocalNoticeForReceive(data: UTSJSONObject | null): void {
  if (data == null || !isAppInBackground()) {
    return;
  }
  const content = pushPayloadField(data, "content");
  if (content.length == 0) {
    return;
  }
  try {
    uni.createPushMessage({
      title: pushPayloadField(data, "title"),
      content: content,
      payload: data,
      sound: "system",
    });
  } catch (e) {
    console.error("[ImPush] createPushMessage fail:", e);
  }
}

/**
 * 绑定推送消息监听（登录后由 scheduleImPushAfterLogin 调；已登录冷启动还会经
 * bindImPushClientIfLoggedIn 在 onLaunch 提前绑一次，保证点通知进来的 click 不丢。幂等。）
 * ★不要无条件放回 App.onLaunch：onPushMessage 会初始化个推 SDK，属于「同意前初始化第三方 SDK」。
 * receive 前台不处理（WS 链路负责）；iOS 退后台时进程可能仍存活，需本地通知兜底，
 * 见 showLocalNoticeForReceive。
 */
export function bindImPushClient(): void {
  if (pushBound) {
    return;
  }
  pushBound = true;
  // ★ 云打包开关：uni-app x 按「代码用到的 API」自动引入 uni-push 模块，DCloud 后台未开通
  //   uni-push 2.0 时云打包会报「使用了 uni-push 模块但尚未开通」——此时把下面 try 块注释掉
  //   并从 manifest 移除 uni-push 模块即可（本地自定义基座不受影响）。
  try {
    uni.onPushMessage((res: OnPushMessageCallbackResult): void => {
      if (res.type != "click") {
        // #ifdef APP-IOS
        // 退后台仍存活时收到的是在线透传，系统不弹通知栏 → 本地通知补一条。
        showLocalNoticeForReceive(res.data);
        // #endif
        return;
      }
      pushClickReceived = true;
      const data = res.data;
      if (data == null) {
        return;
      }
      const convId = pushPayloadField(data, "convId");
      if (convId.length == 0) {
        // 无会话参数的推送（如系统公告）交给默认行为：仅拉起 App
        return;
      }
      openConvWithRetry(
        convId,
        pushPayloadField(data, "convType"),
        pushPayloadField(data, "name"),
        pushPayloadField(data, "avatar"),
        0,
      );
    });
  } catch (e) {
    console.error("[ImPush] onPushMessage bind fail:", e);
  }
}

/**
 * 取 cid 并上报（登录后由 scheduleImPushAfterLogin 调；fail 只落日志，不重试不弹窗）。
 * ★不要放回 App.onLaunch：getPushClientId 会初始化个推 SDK（且是鸿蒙启动弹通知窗的
 *   真正来源），属于「同意前初始化第三方 SDK / 取设备标识」。
 * ★这里**不**申请通知权限：申请由 requestImNotifyPermission 单独负责（同在登录后）。
 */
export function syncImPushClientId(): void {
  // ★ 云打包开关：同 bindImPushClient。
  try {
    uni.getPushClientId({
      success: (res: GetPushClientIdSuccess): void => {
        applyPushCid(res.cid);
      },
      fail: (err: UniError): void => {
        // 常见原因：基座未含 uni-push 模块 / uni-push 未开通 / 厂商通道未配置 / 通知未授权
        console.error(`[ImPush] getPushClientId fail: ${err.errMsg}`);
      },
    });
  } catch (e) {
    console.error("[ImPush] getPushClientId threw:", e);
  }
}

/**
 * 确保拿到推送 cid：已有缓存立即返回，否则触发一次 getPushClientId 并轮询等待。
 * ★用于「用户打开推送开关」时：servers/im.uts 的 registerImDeviceNow 在 cid 为空时
 *   会把 pushEnabled 强制置为 false，即使用户刚打开开关——服务端因此继续按「关闭」
 *   过滤本设备的离线推送。所以开启前必须先确保 cid 就绪（拿不到则调用方回弹并提示）。
 */
export function ensureImPushCid(timeoutMs: number = 3000): Promise<string> {
  const existing = getImPushCid();
  if (existing.length > 0) {
    return Promise.resolve(existing);
  }
  return new Promise<string>((resolve) => {
    syncImPushClientId();
    let waited = 0;
    // ★必须 let 先声明再赋值：`const timer = setInterval(() => clearInterval(timer))`
    //   会让回调里看不到 timer（UTS error18 / Kotlin 找不到名称）。
    let timer = 0;
    timer = setInterval((): void => {
      waited += 250;
      const cid = getImPushCid();
      if (cid.length > 0) {
        clearInterval(timer);
        resolve(cid);
        return;
      }
      if (waited >= timeoutMs) {
        clearInterval(timer);
        console.error(`[ImPush] ensureImPushCid timeout after ${waited}ms`);
        resolve("");
      }
    }, 250);
  });
}

/**
 * 通知授权「已问过」的持久化标记（跨启动生效）。
 * 系统给的机会本来就少（Android 13+ 最多两次、iOS/鸿蒙一次），
 * 加上产品要求「不是每次登录都弹」，所以整个安装周期只真正申请一次。
 * ★键名定义在 utils/installScopedStorage.uts：退出登录的缓存清理会保留它。
 *
 * ★标记时机（2026-11-04）：asked 只在**拿到系统响应后**落，不再「先落再弹」。
 *   旧实现会把技术性失败（Activity 未就绪、API 抛异常）也算成「已问过」，
 *   永久吃掉用户本来还有的机会。现在：
 *     - 技术性失败 → asked 不落，下次登录可再试（当次防重入靠 notifyAskInFlight）；
 *     - 系统真的弹了（用户允许或拒绝）→ 落 asked，本安装周期不再问。
 */
function notifyAskedBefore(): boolean {
  try {
    const raw = uni.getStorageSync(NOTIFY_PERMISSION_ASKED_KEY);
    return raw != null && `${raw}` == "1";
  } catch (_e) {
    // 键不存在时 iOS 可能抛错：按「没问过」处理
    return false;
  }
}

function markNotifyAsked(): void {
  try {
    uni.setStorageSync(NOTIFY_PERMISSION_ASKED_KEY, "1");
  } catch (_e) {
    // 落盘失败最多导致下次登录再问一次，不影响功能
  }
}

/**
 * 授权申请在途标记（仅内存）：防同一次登录里 init 与权限申请两拍重复发起。
 * ★不落盘：进程被杀时系统弹窗也已消失，下次启动重来才是正确的。
 */
let notifyAskInFlight = false;

/**
 * 系统通知权限状态（getImNotifyPermissionState 的返回值）。
 * ★用字符串常量而不是字面量联合类型：联合类型跨端（iOS/Android/鸿蒙）支持不一致，
 *   页面侧也比较常量更好读、不会写错拼写。
 */
export const IM_NOTIFY_PERMISSION_GRANTED = "granted";
export const IM_NOTIFY_PERMISSION_DENIED = "denied";
export const IM_NOTIFY_PERMISSION_UNDETERMINED = "undetermined";
export const IM_NOTIFY_PERMISSION_UNKNOWN = "unknown";

// #ifdef APP-ANDROID
/**
 * 系统是否把「通知」当作可授权权限管理（决定要不要查状态 / 发起申请）。
 *
 * 基线规则是 Android 13+（API 33）才有 POST_NOTIFICATIONS，12 及以下通知默认开启。
 * ★但华为 HarmonyOS 4.x / EMUI 在 Android 12 基线上**反移植**了这条权限：
 *   2026-11-04 在 ELS-AN00（HarmonyOS 4.2.0，SDK 31）实测
 *     - `dumpsys package` 里 `POST_NOTIFICATIONS: granted=false`（真实生效）
 *     - logcat `PackageParsing: com.nuwax.app: compat added android.permission.POST_NOTIFICATIONS`
 *   若只按 `SDK_INT < 33` 短路成「已授权」，设置页会恒显示「已开启」，
 *   实际没授权时用户永远看不到「去设置」入口。
 * ⇒ SDK < 33 时按厂商判：华为/荣耀按真实状态走，其余（真 Android 12 及以下）维持「默认开启」。
 *   更通用的做法是探测 PackageManager.getPermissionInfo 是否抛 NameNotFoundException，
 *   项目暂无先例（有 UTS→Kotlin 编译风险），先用厂商判断兜住实际场景。
 */
function androidNotifyPermissionAvailable(): boolean {
  if (Build.VERSION.SDK_INT >= 33) {
    return true;
  }
  const manufacturer = `${Build.MANUFACTURER}`.toLowerCase();
  const brand = `${Build.BRAND}`.toLowerCase();
  return manufacturer.indexOf("huawei") >= 0 || brand.indexOf("huawei") >= 0 ||
    manufacturer.indexOf("honor") >= 0 || brand.indexOf("honor") >= 0;
}

/**
 * Android 通知权限状态。
 * ★Android 没有 iOS 的 "not determined"：未授权时系统层面无法区分「从未问过」与
 *   「问过且被永久拒绝」（项目未用 shouldShowRequestPermissionRationale），
 *   只能靠我们自己的 asked 标记补齐：
 *     asked=false ⇒ undetermined（系统窗还能弹）
 *     asked=true  ⇒ denied（系统窗不会再出现，只能引导去系统设置）
 * ★系统不把通知当权限管理的机型（真 Android 12 及以下）⇒ 按 granted 处理。
 *   这些机型上用户在系统设置里手动关掉通知的情形此接口查不到，属已知局限。
 */
function androidNotifyPermissionState(): string {
  try {
    if (!androidNotifyPermissionAvailable()) {
      return IM_NOTIFY_PERMISSION_GRANTED;
    }
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) {
      return IM_NOTIFY_PERMISSION_UNKNOWN;
    }
    const permissions = ["android.permission.POST_NOTIFICATIONS"] as string[];
    if (UTSAndroid.checkSystemPermissionGranted(activity, permissions)) {
      return IM_NOTIFY_PERMISSION_GRANTED;
    }
    return notifyAskedBefore() ? IM_NOTIFY_PERMISSION_DENIED : IM_NOTIFY_PERMISSION_UNDETERMINED;
  } catch (_e) {
    return IM_NOTIFY_PERMISSION_UNKNOWN;
  }
}
// #endif

// #ifdef APP-IOS
/**
 * iOS 通知权限状态：notificationAuthorized 本身就是三态字符串
 * （authorized / denied / not determined），不需要额外标记。
 */
function iosNotifyPermissionState(): string {
  try {
    const raw = `${uni.getAppAuthorizeSetting().notificationAuthorized}`;
    if (raw == "authorized") {
      return IM_NOTIFY_PERMISSION_GRANTED;
    }
    if (raw == "denied") {
      return IM_NOTIFY_PERMISSION_DENIED;
    }
    if (raw == "not determined") {
      return IM_NOTIFY_PERMISSION_UNDETERMINED;
    }
    // "config error"：info.plist 缺少描述等配置问题，无法判断
    return IM_NOTIFY_PERMISSION_UNKNOWN;
  } catch (_e) {
    return IM_NOTIFY_PERMISSION_UNKNOWN;
  }
}
// #endif

// #ifdef APP-HARMONY
/**
 * 鸿蒙通知状态：isNotificationEnabled 只回答「现在能不能发通知」，不回答「问没问过」，
 * 未开启时同样用 asked 标记区分「还没问过」与「问过被拒」。
 * ★读状态失败（技术性问题）返回 UNKNOWN，不落任何标记。
 */
function harmonyNotifyPermissionState(): Promise<string> {
  return new Promise<string>((resolve) => {
    try {
      notificationManager
        .isNotificationEnabled()
        .then((enabled: boolean): void => {
          if (enabled) {
            resolve(IM_NOTIFY_PERMISSION_GRANTED);
            return;
          }
          resolve(notifyAskedBefore() ? IM_NOTIFY_PERMISSION_DENIED : IM_NOTIFY_PERMISSION_UNDETERMINED);
        })
        .catch((_e: any | null): void => {
          resolve(IM_NOTIFY_PERMISSION_UNKNOWN);
        });
    } catch (_e) {
      resolve(IM_NOTIFY_PERMISSION_UNKNOWN);
    }
  });
}
// #endif

/**
 * 查询系统层通知权限状态（设置页「系统通知权限」行用），返回 IM_NOTIFY_PERMISSION_* 之一。
 *
 * ★与业务开关（readImPushEnabled）是**两件事**，不要混用：
 *   - 权限状态：系统允许不允许这台设备展示通知（用户在系统设置里控）；
 *   - 业务开关：我们要不要给这台设备下发离线推送（用户在账号管理里控）。
 *   系统权限关掉时业务开关仍可能是开着的（表现为「开关绿了但收不到」），
 *   所以设置页要分别展示，并在开关打开时联动引导。
 *
 * 任何异常都返回 UNKNOWN：调用方按「未知」静默展示，不阻塞页面。
 */
export function getImNotifyPermissionState(): Promise<string> {
  // #ifdef APP-ANDROID
  return new Promise<string>((resolve) => {
    resolve(androidNotifyPermissionState());
  });
  // #endif
  // #ifdef APP-IOS
  return new Promise<string>((resolve) => {
    resolve(iosNotifyPermissionState());
  });
  // #endif
  // #ifdef APP-HARMONY
  return harmonyNotifyPermissionState();
  // #endif
}

/**
 * 打开系统通知设置（设置页权限行点击 / 业务开关联动引导用）。
 * - Android 13+ / 华为·荣耀（反移植）：直接落到本应用的通知权限页；
 * - 真 Android 12 及以下：没有该运行时权限，退化为应用详情页（可在此关/开通知）；
 * - iOS：落到本应用设置页；
 * - 鸿蒙：跳系统授权管理页（uni.openAppAuthorizeSetting，鸿蒙 4.61+ 支持）。
 *   ★2026-11-04 修正：原来调 requestEnableNotification，但用户已经拒绝过后该 API
 *     只会静默 reject、不弹窗也不跳转 —— 表现就是「点去设置，弹窗关了却毫无反应」。
 *     首次申请仍走 requestImNotifyPermission（那里的 requestEnableNotification 才会弹系统窗）。
 */
export function openImNotifyPermissionSettings(): void {
  // #ifdef APP-ANDROID
  try {
    const activity = UTSAndroid.getUniActivity();
    if (androidNotifyPermissionAvailable() && activity != null) {
      UTSAndroid.gotoSystemPermissionActivity(activity, ["android.permission.POST_NOTIFICATIONS"] as string[]);
      return;
    }
  } catch (e) {
    console.error("[ImPush][android] gotoSystemPermissionActivity threw:", e);
  }
  uni.openAppAuthorizeSetting({});
  // #endif
  // #ifdef APP-IOS
  uni.openAppAuthorizeSetting({});
  // #endif
  // #ifdef APP-HARMONY
  try {
    // 用户已拒绝过通知时 requestEnableNotification 只会 reject「Notification disabled」，
    // 既不弹窗也不跳转（真机日志实证）——所以这里必须跳系统授权管理页。
    markNotifyAsked();
    uni.openAppAuthorizeSetting({});
  } catch (e) {
    console.error("[ImPush][hm] openImNotifyPermissionSettings threw:", e);
  }
  // #endif
}

// #ifdef APP-ANDROID
/**
 * Android 13+（API 33）通知运行时权限。
 * ★登录成功后由 requestImNotifyPermission 调（见 scheduleImPushAfterLogin）。
 * 系统不把通知当权限管理的机型（真 Android 12 及以下）直接跳过（通知默认开启）；
 * 华为/荣耀反移植场景仍会申请（见 androidNotifyPermissionAvailable）。
 */
function requestAndroidNotifyPermission(attempt: number = 0): void {
  if (notifyAskedBefore() || notifyAskInFlight) {
    return;
  }
  try {
    if (!androidNotifyPermissionAvailable()) {
      markNotifyAsked();
      return;
    }
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) {
      // 登录回调早期 Activity 可能尚未就绪：延后重试，别把机会丢掉（不落标记）
      if (attempt < 6) {
        setTimeout((): void => {
          requestAndroidNotifyPermission(attempt + 1);
        }, 500);
      } else {
        console.error("[ImPush][android] activity 未就绪，本次放弃申请（下次登录再试）");
      }
      return;
    }
    const permissions = ["android.permission.POST_NOTIFICATIONS"] as string[];
    if (UTSAndroid.checkSystemPermissionGranted(activity, permissions)) {
      // 已授权（老版本装过 / 用户手动开过）：不再打扰
      markNotifyAsked();
      return;
    }
    // ★标记在系统响应之后落（见 notifyAskedBefore 注释）：
    //   这里只置内存在途位，避免「Activity 还没就绪」等技术性失败吃掉唯一机会。
    notifyAskInFlight = true;
    UTSAndroid.requestSystemPermission(
      activity,
      permissions,
      (allGranted: boolean, _granted: string[]): void => {
        notifyAskInFlight = false;
        markNotifyAsked();
        console.error(`[ImPush][android] notification permission granted=${allGranted}`);
      },
      (_doNotAskAgain: boolean, _denied: string[]): void => {
        // 拒绝：不阻塞使用，推送到达后系统静默丢弃，等用户去设置手动开
        notifyAskInFlight = false;
        markNotifyAsked();
        console.error("[ImPush][android] notification permission denied");
      },
    );
  } catch (e) {
    notifyAskInFlight = false;
    console.error("[ImPush][android] requestAndroidNotifyPermission threw:", e);
  }
}
// #endif

// #ifdef APP-HARMONY
/**
 * 鸿蒙通知授权：未授权则弹系统窗，已授权/被拒都静默（被拒只能去设置手动开）。
 * ★鸿蒙系统弹窗每应用只弹一次，所以同样只在登录后申请一次。
 * ★标记在 promise 落地后落：isNotificationEnabled 本身失败（读不到状态）不算「问过」，
 *   下次登录还能再试。
 */
function requestHarmonyNotifyPermission(): void {
  if (notifyAskedBefore() || notifyAskInFlight) {
    return;
  }
  try {
    const context = UTSHarmony.getUIAbilityContext();
    notificationManager
      .isNotificationEnabled()
      .then((enabled: boolean): void => {
        if (enabled) {
          markNotifyAsked();
          return;
        }
        notifyAskInFlight = true;
        notificationManager
          .requestEnableNotification(context)
          .then((): void => {
            notifyAskInFlight = false;
            markNotifyAsked();
            console.error("[ImPush][hm] notification granted");
          })
          .catch((e: any | null): void => {
            // 用户拒绝 / 系统弹窗已用尽 / 开关被关：不阻塞使用，推送到时系统仍会静默丢弃。
            // 调用已有明确响应，视为「已问过」，不重复打扰。
            notifyAskInFlight = false;
            markNotifyAsked();
            console.error(`[ImPush][hm] notification not enabled: ${e}`);
          });
      })
      .catch((_e: any | null): void => {
        // 读不到通知状态：技术性失败，不落标记
        notifyAskInFlight = false;
        console.error("[ImPush][hm] isNotificationEnabled fail（下次登录再试）");
      });
  } catch (e) {
    notifyAskInFlight = false;
    console.error("[ImPush][hm] requestHarmonyNotifyPermission threw:", e);
  }
}
// #endif

/**
 * 申请通知权限（**登录成功后** 调，入口统一走 scheduleImPushAfterLogin；
 * 本安装内只真正申请一次）。
 *
 * 时机理由（2026-11-04 调整）：应用市场自动审核要求「同意隐私政策前不得申请权限」。
 * 首启协议弹窗已移除，同意动作落在登录页协议勾选上，因此权限申请必须排在登录成功之后。
 *
 * 平台差异：
 * - Android 13+：这里是唯一的弹窗时机（12 及以下无此权限，直接跳过）。
 * - 鸿蒙：requestEnableNotification 弹系统窗；此时 getPushClientId 已在登录后调过，
 *   不会再有「启动就弹」的副作用。
 * - iOS：系统授权窗由 uni-push 模块在 getPushClientId/onPushMessage 初始化时申请，
 *   而这两个 API 现在也在登录后才调，所以 iOS 的弹窗时机随之落到登录后
 *   （若实测仍是启动首帧，说明是原生模块自注册，端上无法改，见文档记录）。
 *
 * 幂等：已授权、已问过（无论用户当时选了什么）都直接返回，重复调用不会重复弹窗。
 */
export function requestImNotifyPermission(): void {
  // #ifdef APP-ANDROID
  requestAndroidNotifyPermission();
  // #endif
  // #ifdef APP-HARMONY
  requestHarmonyNotifyPermission();
  // #endif
  // #ifdef APP-IOS
  // iOS 没有独立的「申请通知权限」API：系统授权窗由 uni-push 模块在**初始化时**申请。
  // 所以只在「尚未询问过」时补一次 getPushClientId 触发它（设置页权限行点开时用）；
  // 已授权/已拒绝时系统都不会再弹，不必重复触发。
  if (iosNotifyPermissionState() == IM_NOTIFY_PERMISSION_UNDETERMINED) {
    syncImPushClientId();
  }
  // #endif
}

/** cid 落地：变化才重报；未登录跳过（CONNECT_ACK 设备注册会带上缓存的 cid）。 */
function applyPushCid(cid: string): void {
  if (cid.length == 0) {
    return;
  }
  const previous = getImPushCid();
  cachedPushCid = cid;
  try {
    uni.setStorageSync(PUSH_CID_STORAGE_KEY, cid);
  } catch (_e) {
    // 落盘失败仅影响下次冷启动提前带 cid，不影响本次上报
  }
  if (cid == previous) {
    return;
  }
  // 未登录时不上报：登录后的 CONNECT_ACK 设备注册会带上缓存 cid。
  if (isLoggedIn()) {
    reportPushCid(cid);
  }
}

/** 登录态判定：Bearer token 非空（与 authSession 的 storage 口径一致）。 */
function isLoggedIn(): boolean {
  try {
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    return tokenRaw != null && `${tokenRaw}`.length > 0;
  } catch (_e) {
    return false;
  }
}

/** cid 初始化延迟：让登录页 → 主界面的切换与首屏请求先落地，避免和切 Tab 动画抢帧。 */
const PUSH_INIT_AFTER_LOGIN_DELAY_MS = 1000;
/** 通知授权再晚一拍：确保 cid 已就绪、页面已稳定，弹窗不会压在登录成功的瞬间。 */
const PUSH_ASK_AFTER_LOGIN_DELAY_MS = 1800;

/** 防止同一登录流程里重复排期（两个入口：IM_SESSION_READY / 已登录冷启动）。 */
let pushInitScheduled = false;
let notifyAskScheduled = false;

/**
 * 已登录冷启动时**尽早**绑定点击监听（App.onLaunch 调，未登录直接返回）。
 *
 * 为什么要单独一个入口：点通知拉起 App 时，click 回调可能早于「登录后延迟初始化」
 * 到达；绑晚了这次点击就丢了（用户点通知却停在伙伴页）。
 * ★合规边界：只在**已有 token**（= 此前已登录 ⇒ 已同意隐私政策）时绑定。
 *   首次安装未登录期间不碰 uni-push，所以不会命中「同意前初始化 SDK」。
 */
export function bindImPushClientIfLoggedIn(): void {
  if (!isLoggedIn()) {
    return;
  }
  bindImPushClient();
}

/**
 * 登录后启动推送（**唯一入口**，幂等）。
 *
 * 调用点（都在登录态成立之后）：
 * - App.uvue 的 IM_SESSION_READY 监听 → 本次进程内登录成功；
 * - pages/launch/launch.uvue routeByAuthState → 已登录冷启动（不发 IM_SESSION_READY）。
 *
 * 顺序：先初始化（onPushMessage + getPushClientId），再申请通知权限。
 * ★为什么不在 App.onLaunch 做：那会把个推 SDK 初始化、cid 采集、通知权限申请
 *   全部提前到「用户同意隐私政策之前」，是应用市场自动审核的直接命中项（见文件头）。
 *
 * 首次安装未登录期间：本函数不会被调用 ⇒ 零推送 SDK 初始化、零网络请求。
 */
export function scheduleImPushAfterLogin(): void {
  if (!isLoggedIn()) {
    return;
  }
  if (!pushInitScheduled) {
    pushInitScheduled = true;
    setTimeout((): void => {
      pushInitScheduled = false;
      if (!isLoggedIn()) return;
      bindImPushClient();
      syncImPushClientId();
    }, PUSH_INIT_AFTER_LOGIN_DELAY_MS);
  }
  // 已问过就不再排期（含「用户已允许」与「用户已拒绝」两种情况）
  if (notifyAskScheduled || notifyAskedBefore()) {
    return;
  }
  notifyAskScheduled = true;
  setTimeout((): void => {
    notifyAskScheduled = false;
    if (!isLoggedIn()) return;
    requestImNotifyPermission();
  }, PUSH_ASK_AFTER_LOGIN_DELAY_MS);
}

/**
 * 单独上报（设备注册 UPSERT 幂等，重复调无副作用）。
 * 失败不重试：下次 CONNECT_ACK 的设备注册会带缓存 cid 补报。
 */
async function reportPushCid(cid: string): Promise<void> {
  try {
    await apiImDeviceRegister(cid);
  } catch (_e) {
    // 网络失败：下次 CONNECT_ACK 的设备注册会带缓存 cid 补报
  }
}

/** 推送 payload 取值统一转字符串（数字 convType 也能转）。 */
function pushField(payload: UTSJSONObject, key: string): string {
  const value = payload[key];
  if (value == null) {
    return "";
  }
  return `${value}`;
}

/**
 * 从 uni-push 的 click/receive 回调 `res.data` 里取业务字段。
 *
 * ★`res.data` 是 uni-push 的**通知信封**，不是我们发的 payload 本身：
 *   ```json
 *   { "title":"群名", "content":"xxx: 内容", "unipush_version":"2.0",
 *     "appid":"__UNI__8BF05E4", "payload": { "convId":"...", "convType":2 } }
 *   ```
 *   业务字段在 `data.payload` 里。只在顶层找会命中 `click without convId → app only`，
 *   表现为「点通知只拉起 App 停在伙伴页、进不了会话」——这是 2026-10-30 华为真机
 *   多台复现的根因。
 *   顶层也一并兜一下：兼容透传消息与历史格式（老版本没有信封包裹）。
 */
function pushPayloadField(data: UTSJSONObject, key: string): string {
  const direct = pushField(data, key);
  if (direct.length > 0) {
    return direct;
  }
  const inner = data["payload"];
  if (inner != null && typeof inner == "object" && !Array.isArray(inner)) {
    return pushField(inner as UTSJSONObject, key);
  }
  return "";
}

/**
 * 点击通知打开会话：等页面栈与登录态就绪后再跳。
 * - 未登录直接丢弃：登录流程会落首页，此时续跳会话无意义（且可能撞未授权接口）
 * - 页面栈为空 / 栈顶是冷启动中转页（pages/launch/launch）：此时跳转会被它随后的
 *   reLaunch 冲掉，必须等它落到主 Tab 再跳（最多等 6s）
 * - 栈顶已是会话页 → redirectTo 换会话，不堆叠重页（chat 页实例很重）
 */
function openConvWithRetry(
  convId: string,
  convType: string,
  name: string,
  avatar: string,
  attempt: number,
): void {
  setTimeout((): void => {
    if (!isLoggedIn()) {
      console.error("[ImPush] click dropped: not logged in");
      return;
    }
    const pages = getCurrentPages();
    const top = pages.length > 0 ? pages[pages.length - 1] : null;
    const topRoute = top != null ? `${top.route}` : "";
    const notReady = pages.length == 0 || topRoute == LAUNCH_PAGE_ROUTE || topRoute == LOGIN_PAGE_ROUTE;
    if (notReady && attempt < PUSH_CLICK_NAV_MAX_RETRY) {
      openConvWithRetry(convId, convType, name, avatar, attempt + 1);
      return;
    }
    if (topRoute == LOGIN_PAGE_ROUTE) {
      console.error("[ImPush] click dropped: still on login page");
      return;
    }
    const type = convType.length > 0 ? convType : "1";
    let url = `/pages/message/chat?convId=${encodeURIComponent(convId)}&convType=${type}`;
    if (name.length > 0) {
      url += `&name=${encodeURIComponent(name)}`;
    }
    if (avatar.length > 0) {
      url += `&avatar=${encodeURIComponent(avatar)}`;
    }
    const failHandler = (_err: any): void => {
      // 冷启动落在启动页/登录跳转中：navigateTo 可能失败，不再重试（避免重复开页）
    };
    if (topRoute == "pages/message/chat") {
      uni.redirectTo({ url: url, fail: failHandler });
      return;
    }
    uni.navigateTo({ url: url, fail: failHandler });
  }, attempt == 0 ? PUSH_CLICK_NAV_DELAY_MS : 300);
}
// #endif
