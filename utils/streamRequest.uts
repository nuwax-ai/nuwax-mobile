import { StreamRequestConfig, StreamChunk } from "@/types/interfaces/chat";
import { createSSEConnection } from "@/servers/useRequest.uts";
import { utf8ArrayToString } from "@/utils/utf8.uts";
import { t } from "@/utils/i18n";
import { readRawField } from "@/utils/readRawField.uts";

/**
 * 合并两个 Uint8Array。
 * UTS 的 Uint8Array.set 只支持 set(index, element)，不支持整段拷贝。
 * @param first 前一段字节
 * @param second 后一段字节
 * @returns 合并后的新数组
 */
function mergeUint8Arrays(first: Uint8Array, second: Uint8Array): Uint8Array {
  const merged = new Uint8Array(first.length + second.length);
  for (let i = 0; i < first.length; i++) {
    merged[i] = first[i];
  }
  for (let j = 0; j < second.length; j++) {
    merged[first.length + j] = second[j];
  }
  return merged;
}

/** App residual 全量解码上限：超出只保留尾部，防止 success.data 整包打满主线程 */
const SSE_RESIDUAL_MAX_BYTES: number = 512 * 1024;
/** 已收过 chunk 且 residual 无新增字节时，仅扫描末尾是否含终态标记 */
const SSE_RESIDUAL_TERMINAL_SCAN_BYTES: number = 8192;

/**
 * 从 ArrayBuffer 尾部取出一段并解码为文本（用于终态探测，避免整包 UTF-8）。
 */
function decodeArrayBufferTail(data: ArrayBuffer, maxBytes: number): string {
  const total = data.byteLength;
  if (total <= 0) {
    return "";
  }
  const take = total > maxBytes ? maxBytes : total;
  const offset = total - take;
  const view = new Uint8Array(data);
  // 尽量对齐到 UTF-8 字符边界，减少尾部截断乱码
  let start = offset;
  if (start > 0) {
    let guard = 0;
    while (start < total && guard < 4 && (view[start] & 0xc0) == 0x80) {
      start += 1;
      guard += 1;
    }
  }
  if (start >= total) {
    return "";
  }
  return utf8ArrayToString(view.slice(start));
}

/**
 * 文本中是否含 SSE 终态（[DONE] 或 completed 事件）。
 */
function sseTextLooksTerminal(text: string): boolean {
  if (text.length == 0) {
    return false;
  }
  if (text.indexOf("[DONE]") >= 0) {
    return true;
  }
  const lower = text.toLowerCase();
  // 与 isCompletedPayload 对齐：看 completed 字段，避免正文里碰巧出现 completed 误判
  if (lower.indexOf("\"completed\":true") >= 0) {
    return true;
  }
  if (lower.indexOf("\"completed\":\"true\"") >= 0) {
    return true;
  }
  if (lower.indexOf("\"completed\":1") >= 0) {
    return true;
  }
  if (lower.indexOf("\"completed\":\"1\"") >= 0) {
    return true;
  }
  return false;
}

/**
 * 构建 HTTP 错误提示文案。
 * UTS 中 i18n 插值参数需使用 Map，不能传对象字面量。
 * @param statusCode HTTP 状态码
 * @returns 本地化后的错误信息
 */
function buildHttpErrorMessage(statusCode: number): string {
  const params = new Map<string, string | number>();
  params.set("code", statusCode);
  return t("Mobile.Stream.httpErrorWithCode", params as Record<string, string | number>);
}

/**
 * 创建流式内容块。
 * UTS 中 StreamChunk 为 class，不能用对象字面量初始化。
 * @param data SSE 数据内容
 * @returns 类型为 content 的 StreamChunk 实例
 */
function createContentChunk(data: string): StreamChunk {
  const chunk = new StreamChunk();
  chunk.type = "content";
  chunk.data = data;
  return chunk;
}

/**
 * 判断 SSE 载荷是否表示流已结束。
 * Android：completed 可能是 boolean / 字符串 / 数字，禁止仅判断 == true。
 */
function isCompletedPayload(data: any): boolean {
  if (data == null) {
    return false;
  }
  const completedRaw = readRawField(data, "completed");
  if (completedRaw == true) {
    return true;
  }
  const completedStr = completedRaw != null ? `${completedRaw}` : "";
  return completedStr == "true" || completedStr == "1";
}

/** 心跳包，不含 data */
function isSseHeartBeatPayload(data: any): boolean {
  const eventTypeRaw = readRawField(data, "eventType");
  return eventTypeRaw != null && `${eventTypeRaw}` == "HEART_BEAT";
}

/** 不应下发给业务 onChunk 的 SSE 载荷（无 data 的完成包 / 心跳等） */
function shouldSkipSsePayloadEmit(data: any): boolean {
  if (data == null) {
    return true;
  }
  if (isCompletedPayload(data)) {
    return true;
  }
  if (isSseHeartBeatPayload(data)) {
    return true;
  }
  return readRawField(data, "data") == null;
}

/**
 * 从 SSE data 帧里粗提取 eventType（避免 enqueue 时全量 JSON.parse）。
 */
function peekSseEventType(content: string): string {
  if (content.length == 0) {
    return "";
  }
  const key = "\"eventType\"";
  const keyIdx = content.indexOf(key);
  if (keyIdx < 0) {
    return "";
  }
  const afterKey = content.substring(keyIdx + key.length);
  const colonIdx = afterKey.indexOf(":");
  if (colonIdx < 0) {
    return "";
  }
  let i = colonIdx + 1;
  while (i < afterKey.length) {
    const ch = afterKey.charAt(i);
    if (ch == " " || ch == "\t" || ch == "\n" || ch == "\r") {
      i += 1;
      continue;
    }
    break;
  }
  if (i >= afterKey.length || afterKey.charAt(i) != "\"") {
    return "";
  }
  i += 1;
  const end = afterKey.indexOf("\"", i);
  if (end < 0) {
    return "";
  }
  return afterKey.substring(i, end);
}

/**
 * 从 PROCESSING 帧粗提取 executeId。
 * 队列合并只能覆盖同一次工具调用；不同 executeId 的连续帧必须全部保留，
 * 否则 renderUI 的 FINISHED/result 可能被后续工具帧吞掉，直到重进历史才恢复。
 */
function peekSseProcessingExecuteId(content: string): string {
  if (content.length == 0) {
    return "";
  }
  const key = "\"executeId\"";
  const keyIdx = content.indexOf(key);
  if (keyIdx < 0) {
    return "";
  }
  const afterKey = content.substring(keyIdx + key.length);
  const colonIdx = afterKey.indexOf(":");
  if (colonIdx < 0) {
    return "";
  }
  let i = colonIdx + 1;
  while (i < afterKey.length) {
    const ch = afterKey.charAt(i);
    if (ch == " " || ch == "\t" || ch == "\n" || ch == "\r") {
      i += 1;
      continue;
    }
    break;
  }
  if (i >= afterKey.length || afterKey.charAt(i) != "\"") {
    return "";
  }
  i += 1;
  const end = afterKey.indexOf("\"", i);
  if (end < 0) {
    return "";
  }
  return afterKey.substring(i, end);
}

/** 仅同一工具调用的连续 PROCESSING 帧可合并。 */
function canCoalesceProcessingFrames(previous: string, next: string): boolean {
  if (
    peekSseEventType(previous) != "PROCESSING" ||
    peekSseEventType(next) != "PROCESSING"
  ) {
    return false;
  }
  const previousId = peekSseProcessingExecuteId(previous);
  const nextId = peekSseProcessingExecuteId(next);
  return previousId.length > 0 && previousId == nextId;
}

/**
 * 从原始 SSE 文本块中提取 data: 载荷（可能多行）。
 */
function extractSseDataContent(message: string): string {
  if (message.length == 0) {
    return "";
  }
  const lines = message.split("\n");
  let dataContent = "";
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (line.startsWith("data:")) {
      const content = line.slice(5).trim();
      if (dataContent.length > 0) {
        dataContent += "\n" + content;
      } else {
        dataContent = content;
      }
    }
  }
  return dataContent;
}

/**
 * 判断错误是否为用户主动中止请求（AbortError）。
 * @param error 捕获到的错误对象
 * @returns 是 AbortError 时返回 true
 */
function isAbortError(error: any): boolean {
  if (error == null) {
    return false;
  }
  const errorObj = error as UTSJSONObject;
  const name = errorObj["name"];
  return name != null && `${name}` === "AbortError";
}

/**
 * 汇总 errMsg / message / cause.message，便于识别 iOS 嵌套错误文案。
 */
function collectRequestErrorText(error: any): string {
  if (error == null) {
    return "";
  }
  let out = "";
  try {
    const obj = error as UTSJSONObject;
    const errMsg = obj["errMsg"];
    if (errMsg != null && `${errMsg}`.length > 0) {
      out = out + `${errMsg} `;
    }
    const message = obj["message"];
    if (message != null && `${message}`.length > 0) {
      out = out + `${message} `;
    }
    const cause = obj["cause"];
    if (cause != null) {
      try {
        const causeObj = cause as UTSJSONObject;
        const causeMsg = causeObj["message"];
        if (causeMsg != null && `${causeMsg}`.length > 0) {
          out = out + `${causeMsg} `;
        }
      } catch (_eCause) {
        // ignore
      }
    }
    const errCode = obj["errCode"];
    if (errCode != null) {
      out = out + `errCode=${errCode} `;
    }
    const code = obj["code"];
    if (code != null) {
      out = out + `code=${code} `;
    }
  } catch (_eObj) {
    // ignore
  }
  if (out.length == 0) {
    out = `${error}`;
  }
  return out.toLowerCase();
}

/**
 * iOS enableChunked 常见：服务端关连接 / 录音或 TTS 后短暂断网时，
 * fail 报「网络连接已中断」(600003)，并不等于业务失败。
 * 已有 chunk 或即将走 complete 冲刷时，应软收尾（onTimeout → 回补/sub），禁止 onError。
 */
function isNetworkConnectionLostError(error: any): boolean {
  const text = collectRequestErrorText(error);
  if (text.length == 0) {
    return false;
  }
  if (text.indexOf("网络连接已中断") >= 0) {
    return true;
  }
  if (text.indexOf("network connection was lost") >= 0) {
    return true;
  }
  if (text.indexOf("nsurlerrornetworkconnectionlost") >= 0) {
    return true;
  }
  if (text.indexOf("errcode=600003") >= 0 || text.indexOf("code=600003") >= 0) {
    return true;
  }
  return false;
}

/**
 * 安全读取错误对象的 message 字段。
 * @param error 捕获到的错误对象
 * @returns 错误信息字符串，无 message 时返回空字符串
 */
function getErrorMessage(error: any): string {
  if (error == null) {
    return "";
  }
  const errorObj = error as UTSJSONObject;
  const message = errorObj["message"];
  return message != null ? `${message}` : "";
}

/**
 * 从 onChunkReceived 回调参数中提取 ArrayBuffer。
 * Android 上必须用官方 RequestTaskOnChunkReceivedListenerResult 访问 .data；
 * 自定义 interface / UTSJSONObject 强转绑不到 Kotlin getData()，会得到 null（日志里仍能 toString 出 data=…）。
 * @param chunkResult onChunkReceived 回调参数
 * @returns 分块字节数据，无法识别时返回 null
 */
function extractChunkArrayBuffer(chunkResult: any): ArrayBuffer | null {
  if (chunkResult == null) {
    return null;
  }

  // 官方类型（与 uni_modules/uni-ai-x/sdk/requestAiWorker.uts 一致）
  try {
    const listener = chunkResult as RequestTaskOnChunkReceivedListenerResult;
    const listenerData = listener.data;
    if (listenerData != null) {
      return listenerData as ArrayBuffer;
    }
  } catch (_eListener) {
    // 非官方 listener result，继续尝试其他格式
  }

  // 小程序 / UTSJSONObject / Map（禁止对 Android 原生 listener 走这条，会 ClassCastException）
  try {
    const dataField = readRawField(chunkResult, "data");
    if (dataField != null) {
      return dataField as ArrayBuffer;
    }
  } catch (_eField) {
    // ignore
  }

  // success 回调中 res.data 可能直接是 ArrayBuffer
  try {
    const maybeBuffer = chunkResult as ArrayBuffer;
    const byteLength = maybeBuffer.byteLength;
    if (byteLength != null && byteLength >= 0) {
      return maybeBuffer;
    }
  } catch (_eBuffer) {
    // ignore
  }

  return null;
}

// 全局错误处理 - 捕获未处理的 AbortError
// #ifdef H5
if (typeof window !== "undefined") {
  window.addEventListener("unhandledrejection", (event) => {
    if (event.reason != null && event.reason.name === "AbortError") {
      event.preventDefault(); // 阻止默认的错误处理
    }
  });
}
// #endif

// 流式请求工具类
export class StreamRequest {
  private requestTask: RequestTask | null = null;
  private isAborted: boolean = false;
  private abortController: any | null = null;
  private buffer: string = ""; // 用于缓存不完整的 SSE 消息（以 \n\n 为完整标记）
  private pendingBytes: Uint8Array = new Uint8Array(0); // 用于缓存不完整的 UTF-8 字节序列
  /** 是否已收到 completed / [DONE] 终态标记（用于判断 HTTP complete 是否过早） */
  private receivedTerminalMarker: boolean = false;

  // 流式空闲超时监控（无数据到达则断开）
  private lastChunkReceivedTime: number = 0;
  private timeoutCheckTimer: number | null = null;
  /** H5 / 小程序：事件较密，60s 无数据即可判超时 */
  private readonly TIMEOUT_DURATION_DEFAULT: number = 60000;
  /**
   * APP：onChunkReceived 可能长时间不回调（工具/生图计算、系统缓冲），
   * 空闲阈值需更宽，避免误杀仍在进行的长连接。
   */
  private readonly TIMEOUT_DURATION_APP: number = 180000;
  private timeoutCallback: (() => void) | null = null;
  /** 当前请求使用的空闲超时（ms） */
  private activeTimeoutDuration: number = 60000;

  /** App：SSE 消息分帧队列，避免同一事件循环内批量 onChunk 导致 iOS UI 只在结束时刷新 */
  private sseDispatchQueue: string[] = [];
  private sseDispatchRunning: boolean = false;
  private sseDispatchConfig: StreamRequestConfig | null = null;
  private sseDispatchOnComplete: (() => void) | null = null;
  /** 轻负载时帧间隔；积压时会降为 0 并加大 batch */
  private readonly SSE_DISPATCH_INTERVAL_MS: number = 16;
  /** 大包异步入队尚未完成（防止 complete 误判队列空闲） */
  private sseBurstEnqueuePending: boolean = false;
  private sseBurstTimer: number | null = null;
  /** burst 入队剩余帧与游标（UTS 不支持嵌套函数自引用，须挂实例） */
  private sseBurstRest: string[] | null = null;
  private sseBurstOffset: number = 0;
  private readonly SSE_BURST_SLICE: number = 80;
  /** App：已通过 onChunkReceived 解码的原始字节数，用于 residual 只吃增量尾包 */
  private decodedChunkBytes: number = 0;

  // 发起流式请求
  async request(config: StreamRequestConfig): Promise<void> {
    this.isAborted = false;
    this.buffer = ""; // 重置缓冲区
    this.pendingBytes = new Uint8Array(0); // 重置字节缓冲区
    this.receivedTerminalMarker = false;
    this.decodedChunkBytes = 0;
    this.resetSseDispatchQueue();

    // #ifdef H5
    // 只在 H5 环境中创建 AbortController
    this.abortController = new AbortController();
    // #endif

    // 清除可能存在的旧定时器（重要：避免定时器泄漏）
    this.clearTimeoutMonitor();
    // 保存超时回调
    this.timeoutCallback = config.onTimeout != null ? config.onTimeout : null;

    try {
      // #ifdef H5 || WEB
      await this.requestH5(config);
      // #endif

      // #ifdef MP-WEIXIN
      await this.requestWeapp(config);
      // #endif

      // #ifdef APP
      // uni-app x APP：uni.request 返回 RequestTask（非 Promise），需独立实现 chunked 流式接收
      await this.requestAppX(config);
      // #endif

      // #ifdef APP-PLUS
      await this.requestApp(config);
      // #endif
    } catch (error) {
      // 如果是用户主动中止，不触发错误回调
      // #ifdef H5
      if (isAbortError(error) || this.isAborted) {
        return;
      }
      // #endif

      // #ifdef MP-WEIXIN || APP-PLUS || APP
      if (this.isAborted) {
        return;
      }
      // #endif

      config.onError?.(error);
    }
  }

  // H5环境下的流式请求
  private async requestH5(config: StreamRequestConfig): Promise<void> {
    try {
      // 关键修复：在创建 requestTask 后立即启动超时监控
      // 因为 onChunkReceived 可能比 success 回调更早触发
      this.startTimeoutMonitor();

      await createSSEConnection<any>({
        url: config.url,
        method: config.method,
        headers: config.headers,
        body: config.body,
        abortController: this.abortController,
        onMessage: (data: any) => {
          if (this.isAborted) return;
          // 更新最后接收数据的时间
          this.updateLastChunkTime();

          try {
            // 检查是否完成
            if (isCompletedPayload(data)) {
              // 与 App 对齐：标记终态，避免随后 onClose 误触发 onTimeout
              this.receivedTerminalMarker = true;

              // 清除超时监控
              console.log(
                "[SSE] completed 标记触发，准备清除定时器，当前 timer ID:",
                this.timeoutCheckTimer,
              );
              this.clearTimeoutMonitor();

              config.onComplete?.();
              return;
            }

            if (shouldSkipSsePayloadEmit(data)) {
              return;
            }

            // 处理数据块
            const chunk = createContentChunk(
              data != null ? JSON.stringify(data) : "",
            );
            config.onChunk?.(chunk);
          } catch (e) {
            console.error("Parse chunk error:", e);
          }
        },
        onError: (error: any) => {
          // 清除超时监控
          this.clearTimeoutMonitor();
          // 如果是中止错误，不触发错误回调
          if (isAbortError(error) || this.isAborted) {
            console.log("SSE连接已被中止");
            return;
          }
          config.onError?.(error);
        },
        onOpen: (response: any) => {
          console.log("SSE连接已建立:", response);
        },
        onClose: () => {
          console.log("SSE连接已关闭");
          // 正常 completed 后 EventSource 也会 onClose；勿再当超时/异常断流
          if (this.isAborted == true || this.receivedTerminalMarker == true) {
            return;
          }
          // 无终态的异常关闭：恢复停止按钮 / 触发回补
          config.onTimeout?.();
        },
      });
    } catch (error) {
      // 捕获所有可能的错误，包括 AbortError
      if (
        getErrorMessage(error) === "Connection aborted by user" ||
        isAbortError(error) ||
        this.isAborted
      ) {
        console.log("SSE连接已被中止");
        return;
      }
      // 只有真正的错误才触发错误回调
      config.onError?.(error);
      throw error; // 重新抛出非中止错误
    }
  }

  /**
   * 将解码后的 SSE 文本追加到缓冲区，并处理完整消息块。
   * @param text 新接收的 UTF-8 文本
   * @param config 流式请求配置
   * @param onStreamComplete 流结束时的回调（[DONE] / completed）
   */
  private resetSseDispatchQueue(): void {
    this.sseDispatchQueue = [];
    this.sseDispatchRunning = false;
    this.sseDispatchConfig = null;
    this.sseDispatchOnComplete = null;
    this.sseBurstEnqueuePending = false;
    this.sseBurstRest = null;
    this.sseBurstOffset = 0;
    if (this.sseBurstTimer != null) {
      clearTimeout(this.sseBurstTimer!);
      this.sseBurstTimer = null;
    }
  }

  /**
   * App 端入队。
   * - PROCESSING：连续帧可合并为最新一帧（工具状态洪峰），避免堵住后续 MESSAGE。
   * - MESSAGE：禁止合并。正文是增量 delta，合并会丢掉中间字，表现为气泡只剩末尾几个字。
   */
  private enqueueSseMessage(
    content: string,
    config: StreamRequestConfig,
    onStreamComplete: () => void,
  ): void {
    this.sseDispatchConfig = config;
    this.sseDispatchOnComplete = onStreamComplete;
    const eventType = peekSseEventType(content);
    if (eventType == "PROCESSING" && this.sseDispatchQueue.length > 0) {
      const last = this.sseDispatchQueue[this.sseDispatchQueue.length - 1];
      if (canCoalesceProcessingFrames(last, content)) {
        this.sseDispatchQueue[this.sseDispatchQueue.length - 1] = content;
        if (this.sseDispatchRunning == false) {
          this.pumpSseDispatchQueue();
        }
        return;
      }
    }
    this.sseDispatchQueue.push(content);
    if (this.sseDispatchRunning == false) {
      this.pumpSseDispatchQueue();
    }
  }

  /**
   * 按积压深度自适应批量派发：队列越深，单次处理越多、间隔越短，尽快追上网络进度。
   */
  private pumpSseDispatchQueue(): void {
    if (this.isAborted) {
      this.resetSseDispatchQueue();
      return;
    }
    if (this.sseDispatchQueue.length == 0) {
      this.sseDispatchRunning = false;
      return;
    }

    this.sseDispatchRunning = true;
    const config = this.sseDispatchConfig as StreamRequestConfig;
    const onComplete = this.sseDispatchOnComplete as () => void;
    const qLen = this.sseDispatchQueue.length;
    let batchSize = 1;
    if (qLen > 200) {
      batchSize = 40;
    } else if (qLen > 50) {
      batchSize = 16;
    } else if (qLen > 10) {
      batchSize = 5;
    } else if (qLen > 1) {
      batchSize = 2;
    }

    for (let i = 0; i < batchSize; i++) {
      if (this.sseDispatchQueue.length == 0) {
        break;
      }
      if (this.isAborted) {
        break;
      }
      const content = this.sseDispatchQueue.shift() as string;
      this.processSSEMessage(content, config, onComplete);
      if (this.receivedTerminalMarker == true) {
        // 终态已在 processSSEMessage 内尽量排空 burst；此处只停泵，勿再丢弃未入队帧
        this.sseDispatchQueue = [];
        break;
      }
    }

    if (this.isAborted || this.receivedTerminalMarker == true) {
      this.sseDispatchRunning = false;
      return;
    }
    if (
      this.sseDispatchQueue.length == 0 &&
      this.sseBurstEnqueuePending != true
    ) {
      this.sseDispatchRunning = false;
      return;
    }
    if (this.sseDispatchQueue.length == 0) {
      // burst 还在往队列塞，稍后由 burst 回调再泵
      this.sseDispatchRunning = false;
      return;
    }

    const remain = this.sseDispatchQueue.length;
    const delay =
      remain > 20 ? 0 : this.SSE_DISPATCH_INTERVAL_MS;
    setTimeout(() => {
      this.pumpSseDispatchQueue();
    }, delay);
  }

  private waitForSseDispatchIdle(onIdle: () => void): void {
    if (
      this.sseDispatchRunning == false &&
      this.sseDispatchQueue.length == 0 &&
      this.sseBurstEnqueuePending != true
    ) {
      onIdle();
      return;
    }
    setTimeout(() => {
      this.waitForSseDispatchIdle(onIdle);
    }, this.SSE_DISPATCH_INTERVAL_MS);
  }

  /**
   * 大包分帧入队（保持 MESSAGE delta 全局顺序）。
   *
   * 历史坑（Android 语音后长文常见）：
   * 1) 队列非空时同步 process 首帧 → 插队，正文错位（如两行新闻互相嵌套）
   * 2) burst 未入队完时把新包直接 push 进 dispatch 队列 → 与 rest 交错，同样乱序
   * 因此：有积压时只追加到 burstRest / 派发队列；仅完全空闲时才首帧同步上屏。
   */
  private enqueueSseFramesWithFirstPaint(
    frames: string[],
    config: StreamRequestConfig,
    onStreamComplete: () => void,
  ): void {
    if (frames.length == 0) {
      return;
    }
    this.sseDispatchConfig = config;
    this.sseDispatchOnComplete = onStreamComplete;

    // burst 进行中：追加到 rest 末尾，禁止与 dispatch 队列交错
    const burstRest = this.sseBurstRest;
    if (burstRest != null) {
      for (let i = 0; i < frames.length; i++) {
        burstRest.push(frames[i]);
      }
      return;
    }
    if (this.sseBurstEnqueuePending == true) {
      for (let i = 0; i < frames.length; i++) {
        this.enqueueSseMessage(frames[i], config, onStreamComplete);
      }
      return;
    }

    // 派发未空闲：禁止首帧插队
    if (
      this.sseDispatchRunning == true ||
      this.sseDispatchQueue.length > 0
    ) {
      for (let i = 0; i < frames.length; i++) {
        this.enqueueSseMessage(frames[i], config, onStreamComplete);
      }
      return;
    }

    // 完全空闲：首帧同步上屏，其余 burst 入队
    this.processSSEMessage(frames[0], config, onStreamComplete);
    if (frames.length == 1 || this.receivedTerminalMarker == true) {
      return;
    }

    const rest: string[] = [];
    for (let i = 1; i < frames.length; i++) {
      rest.push(frames[i]);
    }

    this.sseBurstEnqueuePending = true;
    this.sseBurstRest = rest;
    this.sseBurstOffset = 0;
    this.sseBurstTimer = setTimeout(() => {
      this.pumpSseBurstEnqueue();
    }, 0);
  }

  /**
   * 把尚未入队的 burst 剩余帧一次性进入派发队列（终态前调用，防止丢尾部 MESSAGE）。
   */
  private materializeBurstRestToQueue(
    config: StreamRequestConfig,
    onStreamComplete: () => void,
  ): void {
    if (this.sseBurstTimer != null) {
      clearTimeout(this.sseBurstTimer!);
      this.sseBurstTimer = null;
    }
    const rest = this.sseBurstRest;
    if (rest == null) {
      this.sseBurstEnqueuePending = false;
      this.sseBurstOffset = 0;
      return;
    }
    const offset = this.sseBurstOffset;
    for (let i = offset; i < rest.length; i++) {
      this.enqueueSseMessage(rest[i], config, onStreamComplete);
    }
    this.sseBurstRest = null;
    this.sseBurstOffset = 0;
    this.sseBurstEnqueuePending = false;
  }

  /**
   * 终态前同步排空派发队列中的非终态帧（MESSAGE/PROCESSING 等）。
   */
  private flushQueuedNonTerminalBeforeComplete(
    config: StreamRequestConfig,
    onStreamComplete: () => void,
  ): void {
    while (this.sseDispatchQueue.length > 0) {
      const content = this.sseDispatchQueue.shift() as string;
      if (content === "[DONE]") {
        // 终态交给调用方统一处理
        this.sseDispatchQueue.unshift(content);
        break;
      }
      const looksLikeJSON =
        content.startsWith("{") || content.startsWith("[");
      if (looksLikeJSON) {
        try {
          const data = JSON.parse(content) as UTSJSONObject;
          if (isCompletedPayload(data)) {
            this.sseDispatchQueue.unshift(content);
            break;
          }
        } catch (_e) {
          // fallthrough 当普通 chunk
        }
      }
      // 临时清除终态标记干扰，按普通消息处理
      this.processSSEMessage(content, config, onStreamComplete);
      if (this.receivedTerminalMarker == true) {
        // processSSEMessage 不应在此路径再次 complete；若误触则停
        break;
      }
    }
  }

  /**
   * 分片把大包剩余帧入队（实例方法，避免 UTS 嵌套函数自引用编译失败）。
   * PROCESSING 可合并；MESSAGE 禁止合并（delta 丢失会表现为 Android 少字）。
   */
  private pumpSseBurstEnqueue(): void {
    this.sseBurstTimer = null;
    if (this.isAborted) {
      this.sseBurstEnqueuePending = false;
      this.sseBurstRest = null;
      this.sseBurstOffset = 0;
      return;
    }
    const rest = this.sseBurstRest;
    if (rest == null) {
      this.sseBurstEnqueuePending = false;
      return;
    }
    const offset = this.sseBurstOffset;
    const sliceSize = this.SSE_BURST_SLICE;
    const end =
      offset + sliceSize < rest.length ? offset + sliceSize : rest.length;
    for (let i = offset; i < end; i++) {
      const content = rest[i];
      const eventType = peekSseEventType(content);
      // 仅 PROCESSING 合并；MESSAGE 必须逐帧入队
      if (eventType == "PROCESSING" && this.sseDispatchQueue.length > 0) {
        const last = this.sseDispatchQueue[this.sseDispatchQueue.length - 1];
        if (canCoalesceProcessingFrames(last, content)) {
          this.sseDispatchQueue[this.sseDispatchQueue.length - 1] = content;
          continue;
        }
      }
      this.sseDispatchQueue.push(content);
    }
    this.sseBurstOffset = end;
    if (end < rest.length) {
      this.sseBurstTimer = setTimeout(() => {
        this.pumpSseBurstEnqueue();
      }, 0);
      if (this.sseDispatchRunning == false) {
        this.pumpSseDispatchQueue();
      }
      return;
    }
    this.sseBurstRest = null;
    this.sseBurstOffset = 0;
    this.sseBurstEnqueuePending = false;
    if (this.sseDispatchRunning == false) {
      this.pumpSseDispatchQueue();
    }
  }

  /**
   * 将 decodeUTF8 残留的不完整 UTF-8 字节强制刷入文本 buffer（流结束时调用）。
   */
  private flushPendingUtf8Bytes(): void {
    if (this.pendingBytes.length == 0) {
      return;
    }
    const leftover = this.pendingBytes;
    this.pendingBytes = new Uint8Array(0);
    const text = utf8ArrayToString(leftover);
    if (text.length > 0) {
      this.buffer += text;
    }
  }

  private appendAndProcessSSEText(
    text: string,
    config: StreamRequestConfig,
    onStreamComplete: () => void,
    yieldBetweenMessages: boolean = false,
  ): void {
    if (text.length === 0) {
      return;
    }

    this.buffer += text;
    const messages = this.buffer.split("\n\n");
    const pendingMessage = messages.pop();
    this.buffer = pendingMessage != null ? pendingMessage : "";

    if (yieldBetweenMessages != true) {
      for (let mi = 0; mi < messages.length; mi++) {
        const message = messages[mi];
        if (!message.trim()) {
          continue;
        }
        const dataContent = extractSseDataContent(message);
        if (dataContent.length > 0) {
          this.processSSEMessage(dataContent, config, onStreamComplete);
        }
      }
      return;
    }

    // App：先收集 data 帧；多帧时首帧同步上屏，其余异步入队（MESSAGE 不合并）
    const frames: string[] = [];
    for (let mi = 0; mi < messages.length; mi++) {
      const message = messages[mi];
      if (!message.trim()) {
        continue;
      }
      const dataContent = extractSseDataContent(message);
      if (dataContent.length > 0) {
        frames.push(dataContent);
      }
    }
    if (frames.length == 0) {
      return;
    }
    if (frames.length <= 3) {
      for (let fi = 0; fi < frames.length; fi++) {
        this.enqueueSseMessage(frames[fi], config, onStreamComplete);
      }
      return;
    }
    this.enqueueSseFramesWithFirstPaint(frames, config, onStreamComplete);
  }

  // 处理完整的 SSE 消息
  private processSSEMessage(
    content: string,
    config: StreamRequestConfig,
    onStreamComplete: () => void,
  ): void {
    // 检查是否完成
    if (content === "[DONE]") {
      // 终态前先排空 burst + 队列里尚未派发的 MESSAGE，避免 Android 少字
      this.materializeBurstRestToQueue(config, onStreamComplete);
      this.flushQueuedNonTerminalBeforeComplete(config, onStreamComplete);
      this.receivedTerminalMarker = true;

      // 清除超时监控
      this.finalizeCompletedStream();

      config.onComplete?.();
      onStreamComplete();
      return;
    }

    // 检查是否看起来像 JSON (以 { 或 [ 开头)
    const looksLikeJSON = content.startsWith("{") || content.startsWith("[");

    if (looksLikeJSON) {
      // 尝试解析 JSON 数据
      try {
        const data = JSON.parse(content) as UTSJSONObject;
        if (isCompletedPayload(data)) {
          this.materializeBurstRestToQueue(config, onStreamComplete);
          this.flushQueuedNonTerminalBeforeComplete(config, onStreamComplete);
          this.receivedTerminalMarker = true;

          // 清除超时监控
          this.finalizeCompletedStream();

          config.onComplete?.();
          onStreamComplete();
          return;
        }

        if (shouldSkipSsePayloadEmit(data)) {
          return;
        }

        // 处理数据块
        const chunk = createContentChunk(content);
        config.onChunk?.(chunk);
      } catch (e) {
      }
    } else {
      // 不是 JSON 格式，直接作为内容处理
      const chunk = createContentChunk(content);
      config.onChunk?.(chunk);
    }
  }

  /** 按平台返回空闲超时时长。 */
  private resolveTimeoutDuration(): number {
    // #ifdef APP
    return this.TIMEOUT_DURATION_APP;
    // #endif
    // #ifndef APP
    return this.TIMEOUT_DURATION_DEFAULT;
    // #endif
  }

  // 启动超时监控
  private startTimeoutMonitor(): void {
    this.activeTimeoutDuration = this.resolveTimeoutDuration();

    // 记录初始时间
    this.lastChunkReceivedTime = Date.now();

    // 先清除可能存在的旧定时器
    const existingTimerId = this.timeoutCheckTimer;
    if (existingTimerId !== null) {
      clearInterval(existingTimerId);
      this.timeoutCheckTimer = null;
    }

    // 每 15 秒检查一次
    const timerId = setInterval(() => {
      const now = Date.now();
      const timeSinceLastChunk = now - this.lastChunkReceivedTime;
      const limit = this.activeTimeoutDuration;

      if (timeSinceLastChunk >= limit) {
        this.handleTimeout();
      }
    }, 15000);

    this.timeoutCheckTimer = timerId;
  }

  // 清除超时监控
  private clearTimeoutMonitor(): void {
    const timerId = this.timeoutCheckTimer;
    if (timerId !== null) {
      clearInterval(timerId);
      this.timeoutCheckTimer = null;
    }
  }

  // 更新最后接收数据的时间
  private updateLastChunkTime(): void {
    this.lastChunkReceivedTime = Date.now();
  }

  /**
   * 释放 requestTask 引用。
   * uni-app x 在请求实例已销毁后调用 abort 会抛错，需 try-catch 并先置空引用。
   */
  private releaseRequestTask(attemptAbort: boolean = true): void {
    const task = this.requestTask;
    this.requestTask = null;
    if (task == null || attemptAbort == false) {
      return;
    }
    try {
      task.abort();
    } catch (error) {
    }
  }

  /** SSE 正常结束时仅清理引用，避免对已销毁实例再次 abort。 */
  private finalizeCompletedStream(): void {
    this.clearTimeoutMonitor();
    this.releaseRequestTask(false);
  }

  // 处理超时
  private handleTimeout(): void {

    this.clearTimeoutMonitor();
    this.isAborted = true;
    this.releaseRequestTask(true);

    // 显示轻提示
    uni.showToast({
      title: t("Mobile.Stream.timeoutDisconnected"),
      icon: "none",
      duration: 2000,
    });

    // 调用超时回调
    const timeoutCallback = this.timeoutCallback;
    if (timeoutCallback != null) {
      timeoutCallback();
    }
  }

  // 处理 UTF-8 字节流，处理分片造成的字符截断问题
  private decodeUTF8(chunk: ArrayBuffer): string {
    const newBytes = new Uint8Array(chunk);
    let combined = newBytes;

    if (this.pendingBytes.length > 0) {
      combined = mergeUint8Arrays(this.pendingBytes, newBytes);
      this.pendingBytes = new Uint8Array(0);
    }

    if (combined.length === 0) return "";

    // 寻找最后一个安全的字节边界
    let safeEnd = combined.length;
    let i = combined.length - 1;
    let backtrack = 0;

    // 向前回溯，检查末尾是否被截断
    // UTF-8 最大字符长度为 4 字节
    while (backtrack < 4 && i >= 0) {
      const b = combined[i];

      // ASCII (0xxxxxxx) - 字符结束，且是单字节，安全
      if ((b & 0x80) === 0) {
        // 如果我们是回溯过程中遇到的 ASCII，说明之前回溯过的字节（在 ASCII 之后）是孤立的或不完整的？
        // 比如 [ASCII, Cont, Cont]，我们在 Cont 回溯。
        // 遇到 ASCII，说明后面的 Cont 没有 Start byte，是无效的。
        // 但如果是 [ASCII]，backtrack=0，safeEnd=length。
        // 这里的逻辑：遇到 ASCII，说明前面的序列都结束了。
        // 那么从 i+1 到 length 的字节就是我们回溯过的“剩余字节”。
        safeEnd = combined.length - backtrack;
        break;
      }

      // Start byte (11xxxxxx)
      if ((b & 0xc0) === 0xc0) {
        let need = 2;
        if ((b & 0xe0) === 0xe0) need = 3;
        else if ((b & 0xf0) === 0xf0) need = 4;

        const have = combined.length - i;
        if (have < need) {
          // 不完整，需要保留从 i 开始的所有字节
          safeEnd = i;
        } else {
          // 完整
          safeEnd = combined.length;
        }
        break;
      }

      i--;
      backtrack++;
    }

    // 如果 safeEnd 小于总长度，保存剩余字节
    if (safeEnd < combined.length) {
      this.pendingBytes = combined.slice(safeEnd);
      return utf8ArrayToString(combined.slice(0, safeEnd));
    }

    return utf8ArrayToString(combined);
  }

  // 微信小程序环境下的流式请求
  private async requestWeapp(config: StreamRequestConfig): Promise<void> {
    return new Promise((resolve, reject) => {
      this.requestTask = uni.request({
        url: config.url,
        method: config.method,
        header: config.headers,
        data: config.body,
        enableChunked: true, // 启用分块传输
        responseType: "arraybuffer", // 响应类型
        timeout: 1000 * 60 * 60 * 12, // 设置超时时间为 12小时
        success: (res) => {
          if (res.statusCode === 200) {
            // 流式数据通过 onChunkReceived 接收，success 仅表示请求建立成功
            // 实际的流式数据处理在 onChunkReceived 回调中
            config.onOpen?.(res);

            resolve(); // 请求成功建立连接后即可 resolve
          } else {
            this.finalizeCompletedStream();
            reject(new Error(buildHttpErrorMessage(res.statusCode)));
          }
        },
        fail: (err) => {
          this.finalizeCompletedStream();

          if (!this.isAborted) {
            // 忽略超时错误，因为对于长连接流式请求，超时是预期内的行为
            // 只要 connection 还在接收数据，就不应该视为真正的错误
            const errMsgText = err.errMsg;
            if (
              errMsgText != null &&
              (errMsgText.includes("time out") ||
                errMsgText.includes("timeout"))
            ) {
              // 不 reject，也不触发 onError，保持连接继续接收数据
              return;
            }

            config.onError?.(err);
            reject(err);
          }
        },
      });

      // 关键修复：在创建 requestTask 后立即启动超时监控
      // 因为 onChunkReceived 可能比 success 回调更早触发
      this.startTimeoutMonitor();

      // 监听分块数据接收
      const requestTask = this.requestTask;
      if (requestTask != null) {
        const onWeappStreamComplete = (): void => {
          resolve();
        };
        requestTask.onChunkReceived((res: RequestTaskOnChunkReceivedListenerResult) => {
          if (this.isAborted) return;

          this.updateLastChunkTime();

          try {
            // 优先走官方类型 .data；extractChunkArrayBuffer 作兜底
            let chunkBuffer: ArrayBuffer | null = null;
            const typedData = res.data;
            if (typedData != null) {
              chunkBuffer = typedData as ArrayBuffer;
            } else {
              chunkBuffer = extractChunkArrayBuffer(res);
            }
            if (chunkBuffer == null) {
              return;
            }
            const str = this.decodeUTF8(chunkBuffer);
            this.appendAndProcessSSEText(str, config, onWeappStreamComplete);
          } catch (error) {
            console.error("处理分块数据失败:", error);
            if (!this.isAborted) {
              config.onError?.(error);
            }
          }
        });
      }
    });
  }

  /**
   * uni-app x APP 端流式 SSE 请求。
   * 官方文档：uni.request 返回 RequestTask（非 Promise），需 enableChunked + onChunkReceived + responseType arraybuffer。
   * @see https://doc.dcloud.net.cn/uni-app-x/api/request.html
   */
  private requestAppX(config: StreamRequestConfig): Promise<void> {
    return new Promise((resolve, reject) => {
      let isStreamFinished = false;
      let hasReceivedChunk = false;

      const finishStream = (): void => {
        if (isStreamFinished) {
          return;
        }
        this.waitForSseDispatchIdle(() => {
          if (isStreamFinished) {
            return;
          }
          isStreamFinished = true;
          this.finalizeCompletedStream();
          resolve();
        });
      };

      const failStream = (error: any): void => {
        if (isStreamFinished || this.isAborted) {
          return;
        }
        isStreamFinished = true;
        this.finalizeCompletedStream();
        reject(error);
      };

      const handleChunkBuffer = (chunkBuffer: ArrayBuffer | null): void => {
        if (chunkBuffer == null || this.isAborted) {
          return;
        }
        hasReceivedChunk = true;
        this.decodedChunkBytes = this.decodedChunkBytes + chunkBuffer.byteLength;
        this.updateLastChunkTime();
        try {
          const text = this.decodeUTF8(chunkBuffer);
          this.appendAndProcessSSEText(text, config, finishStream, true);
        } catch (error) {
          console.error("[SSE-APP] 处理分块数据失败:", error);
          if (!this.isAborted) {
            config.onError?.(error);
          }
        }
      };

      this.startTimeoutMonitor();

      // APP 端 uni.request 同步返回 RequestTask，不可当作 Promise 使用
      const requestTask = uni.request<ArrayBuffer>({
        url: config.url,
        method: config.method,
        header: config.headers,
        data: config.body,
        enableChunked: true,
        responseType: "arraybuffer",
        dataType: "text",
        timeout: 1000 * 60 * 60 * 12,
        success: (res) => {
          if (this.isAborted) {
            return;
          }
          if (res.statusCode !== 200) {
            failStream(new Error(buildHttpErrorMessage(res.statusCode)));
            return;
          }

          // 连接已建立也算活跃（部分机型首包很晚才到 onChunkReceived）
          this.updateLastChunkTime();
          config.onOpen?.(res);

          // iOS：工具调用后 MESSAGE/completed 可能只出现在 success.data。
          // success.data 有两种形态：
          // 1) 整包回放（byteLength >= decodedChunkBytes）→ 只解析增量，防 ANR
          // 2) 仅尾包（byteLength < decodedChunkBytes）→ 必须整段解析，否则丢终态正文
          const responseData = res.data;
          if (responseData != null && this.receivedTerminalMarker != true) {
            const byteLength = responseData.byteLength;
            if (byteLength != null && byteLength > 0) {
              if (hasReceivedChunk == true) {
                if (byteLength > this.decodedChunkBytes) {
                  // 整包回放：只解码尚未经 chunk 路径的尾部字节
                  let takeStart = this.decodedChunkBytes;
                  const view = new Uint8Array(responseData);
                  let guard = 0;
                  while (
                    takeStart < byteLength &&
                    guard < 4 &&
                    (view[takeStart] & 0xc0) == 0x80
                  ) {
                    takeStart += 1;
                    guard += 1;
                  }
                  if (byteLength - takeStart > SSE_RESIDUAL_MAX_BYTES) {
                    takeStart = byteLength - SSE_RESIDUAL_MAX_BYTES;
                    guard = 0;
                    while (
                      takeStart < byteLength &&
                      guard < 4 &&
                      (view[takeStart] & 0xc0) == 0x80
                    ) {
                      takeStart += 1;
                      guard += 1;
                    }
                  }
                  if (takeStart < byteLength) {
                    const residualText = utf8ArrayToString(
                      view.slice(takeStart),
                    );
                    if (residualText.length > 0) {
                      this.appendAndProcessSSEText(
                        residualText,
                        config,
                        finishStream,
                        true,
                      );
                    }
                  }
                } else if (byteLength < this.decodedChunkBytes) {
                  // 仅尾包：与改前一致，整段入队（仍做 512KB 上限保护）
                  let takeStart = 0;
                  if (byteLength > SSE_RESIDUAL_MAX_BYTES) {
                    takeStart = byteLength - SSE_RESIDUAL_MAX_BYTES;
                  }
                  const view = new Uint8Array(responseData);
                  if (takeStart > 0) {
                    let guard = 0;
                    while (
                      takeStart < byteLength &&
                      guard < 4 &&
                      (view[takeStart] & 0xc0) == 0x80
                    ) {
                      takeStart += 1;
                      guard += 1;
                    }
                  }
                  const residualText = utf8ArrayToString(view.slice(takeStart));
                  if (residualText.length > 0) {
                    this.appendAndProcessSSEText(
                      residualText,
                      config,
                      finishStream,
                      true,
                    );
                  }
                } else if (this.receivedTerminalMarker != true) {
                  // 等长整包回放且无新增：只扫尾部终态，禁止重解析
                  const tailText = decodeArrayBufferTail(
                    responseData,
                    SSE_RESIDUAL_TERMINAL_SCAN_BYTES,
                  );
                  if (sseTextLooksTerminal(tailText)) {
                    this.receivedTerminalMarker = true;
                    this.finalizeCompletedStream();
                    config.onComplete?.();
                    finishStream();
                  }
                }
              } else {
                // 未收过 chunk：整包兜底，但仍限长只吃尾部
                let takeStart = 0;
                if (byteLength > SSE_RESIDUAL_MAX_BYTES) {
                  takeStart = byteLength - SSE_RESIDUAL_MAX_BYTES;
                }
                const view = new Uint8Array(responseData);
                if (takeStart > 0) {
                  let guard = 0;
                  while (
                    takeStart < byteLength &&
                    guard < 4 &&
                    (view[takeStart] & 0xc0) == 0x80
                  ) {
                    takeStart += 1;
                    guard += 1;
                  }
                }
                const residualText = utf8ArrayToString(view.slice(takeStart));
                if (residualText.length > 0) {
                  hasReceivedChunk = true;
                  this.appendAndProcessSSEText(
                    residualText,
                    config,
                    finishStream,
                    true,
                  );
                } else {
                  handleChunkBuffer(responseData);
                }
              }
            }
          }
        },
        fail: (err) => {
          this.finalizeCompletedStream();

          if (this.isAborted || isStreamFinished) {
            return;
          }

          // 忽略超时错误（长连接预期行为）
          const errMsgText = err.errMsg;
          if (
            errMsgText != null &&
            (errMsgText.includes("time out") || errMsgText.includes("timeout"))
          ) {
            return;
          }

          // 已收到 SSE 终态：关连接时常再报 fail，忽略即可
          if (this.receivedTerminalMarker == true) {
            console.warn(
              "[SSE-APP] ignore fail after terminal marker:",
              collectRequestErrorText(err),
            );
            finishStream();
            return;
          }

          // iOS：录音/TTS/服务端关连后常报「网络连接已中断」。
          // 软收尾：先冲刷 residual，再走 onTimeout（hydrate/sub），禁止 onError 双回调清会话。
          if (isNetworkConnectionLostError(err) == true) {
            console.warn(
              "[SSE-APP] connection lost soft-close hasChunk=" +
                `${hasReceivedChunk}` +
                " " +
                collectRequestErrorText(err),
            );
            this.flushPendingUtf8Bytes();
            if (this.buffer.trim().length > 0) {
              this.appendAndProcessSSEText("\n\n", config, finishStream, true);
            }
            this.waitForSseDispatchIdle(() => {
              if (isStreamFinished || this.isAborted) {
                return;
              }
              if (this.receivedTerminalMarker == true) {
                finishStream();
                return;
              }
              this.clearTimeoutMonitor();
              config.onTimeout?.();
              finishStream();
            });
            return;
          }

          // 真正失败：只 reject，由 request() catch 统一调一次 onError（避免双次 finalize）
          failStream(err);
        },
        complete: () => {
          if (isStreamFinished || this.isAborted) {
            this.releaseRequestTask(false);
            return;
          }
          // iOS enableChunked：complete 可能早于分发队列排空，也可能是真结束但 completed 卡在 buffer（缺尾部 \n\n）。
          // 流程：冲刷 UTF-8 残留 → 等队列空 → 冲刷 buffer → 再等队列空。
          // 与 H5 对齐：仅当已有 SSE 终态（completed/[DONE]）才算成功；否则走 onTimeout，不当 onComplete。
          this.flushPendingUtf8Bytes();
          this.waitForSseDispatchIdle(() => {
            if (isStreamFinished || this.isAborted) {
              this.releaseRequestTask(false);
              return;
            }
            if (this.buffer.trim().length > 0) {
              // 补一个分隔符，强制解析残留帧（常见含 completed）
              this.appendAndProcessSSEText("\n\n", config, finishStream, true);
            }
            this.waitForSseDispatchIdle(() => {
              if (isStreamFinished || this.isAborted) {
                this.releaseRequestTask(false);
                return;
              }
              if (this.receivedTerminalMarker == true) {
                // 终态帧可能刚被 flush 出来，但 processSSEMessage 已调过 onComplete；此处只收尾
                finishStream();
                return;
              }

              this.clearTimeoutMonitor();
              config.onTimeout?.();
              finishStream();
            });
          });
        },
      });

      this.requestTask = requestTask;

      // 必须标注官方类型：Android 上自定义 interface 读不到 getData()
      requestTask.onChunkReceived((result: RequestTaskOnChunkReceivedListenerResult) => {
        if (this.isAborted) {
          return;
        }
        // 回调一到就刷新空闲计时（即使 buffer 解析失败也不误杀）
        this.updateLastChunkTime();
        let chunkBuffer: ArrayBuffer | null = null;
        const typedData = result.data;
        if (typedData != null) {
          chunkBuffer = typedData as ArrayBuffer;
        } else {
          chunkBuffer = extractChunkArrayBuffer(result);
        }
        if (chunkBuffer == null) {
          console.warn("[SSE-APP] onChunkReceived 无法解析 ArrayBuffer，已刷新空闲计时", result);
          return;
        }
        handleChunkBuffer(chunkBuffer);
      });
    });
  }

  // App环境下的流式请求
  private async requestApp(config: StreamRequestConfig): Promise<void> {
    // #ifdef APP-PLUS
    return new Promise((resolve, reject) => {
      this.requestTask = uni.request({
        url: config.url,
        method: config.method,
        header: config.headers,
        data: config.body,
        success: (res) => {
          if (res.statusCode === 200) {
            // 处理流式响应
            this.handleStreamResponse(res.data as string, config);
            resolve();
          } else {
            reject(new Error(buildHttpErrorMessage(res.statusCode)));
          }
        },
        fail: (err) => {
          if (!this.isAborted) {
            reject(err);
          }
        },
      });
    });
    // #endif
  }

  // 处理流式响应数据
  private handleStreamResponse(
    data: string,
    config: StreamRequestConfig,
  ): void {
    const lines = data.split("\n");

    for (const line of lines) {
      if (line.trim() === "") continue;

      if (line.startsWith("data:")) {
        const content = line.slice(5).trim();

        // 跳过空内容
        if (content.length == 0) {
          continue;
        }

        // 检查是否完成
        if (content === "[DONE]") {
          config.onComplete?.();
          return;
        }

        // 检查是否看起来像 JSON (以 { 或 [ 开头)
        const looksLikeJSON =
          content.startsWith("{") || content.startsWith("[");

        if (looksLikeJSON) {
          // 尝试解析 JSON 数据
          try {
            const parseData = JSON.parse(content) as UTSJSONObject;
            if (isCompletedPayload(parseData)) {
              config.onComplete?.();
              return;
            }
            if (shouldSkipSsePayloadEmit(parseData)) {
              return;
            }
          } catch (e) {
            // JSON 解析失败，继续处理为普通数据
          }
        }

        // 处理数据块
        try {
          const chunk = createContentChunk(content);
          config.onChunk?.(chunk);
        } catch (e) {
          console.error("[SSE-APP] 处理数据块失败:", e);
        }
      }
    }
  }

  // 中止请求
  abort(): void {
    this.isAborted = true;
    this.buffer = ""; // 清空缓冲区
    this.resetSseDispatchQueue();

    // 清除超时监控（所有平台都需要）
    this.clearTimeoutMonitor();

    // #ifdef H5
    // 中止 H5 的 SSE 连接
    const abortController = this.abortController;
    if (abortController != null) {
      abortController.abort();
      this.abortController = null;
    }
    // #endif

    // #ifdef MP-WEIXIN || APP || APP-PLUS
    this.releaseRequestTask(true);
    // #endif
  }
}

// 创建流式请求实例
export const streamRequest = new StreamRequest();
