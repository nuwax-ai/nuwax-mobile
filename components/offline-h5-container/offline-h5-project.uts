/** 项目适配：资源包入口与账号作用域。通用容器不依赖这些 storage key。 */
import { getApiBaseUrl, clearStoragePreservingApiBaseUrl } from '@/constants/config';
import { ACCESS_TOKEN, ACCESS_TOKEN_ORIGIN } from '@/constants/home.constants';
import { redirectToLoginOnce } from '@/utils/authNavigation';

export const OFFLINE_H5_ENTRY: string = '/static/app/offline-h5/index.html';
export const OFFLINE_H5_BOOTSTRAP_ROUTE: string = '/pages/offline-h5-bootstrap/offline-h5-bootstrap';
let lastToken = '';
let lastServer = '';
let scopeRevision = 0;

export function getOfflineH5AccessToken(): string {
  const origin = uni.getStorageSync(ACCESS_TOKEN_ORIGIN);
  if (origin != null && `${origin}` != getApiBaseUrl()) return '';
  const raw = uni.getStorageSync(ACCESS_TOKEN);
  return raw != null ? `${raw}` : '';
}

export function getOfflineH5ScopeKey(): string {
  const token = getOfflineH5AccessToken();
  const server = getApiBaseUrl();
  if (token != lastToken || server != lastServer) {
    scopeRevision += 1;
    lastToken = token;
    lastServer = server;
  }
  // 不把 Token 或用户信息放进日志/事件用的作用域标识。
  return `account-scope-${scopeRevision}`;
}

/** 只接受当前账号的已验证容器事件，旧 WebView 不能清理新账号的登录态。 */
export function handleProjectOfflineH5AuthRequired(info: UTSJSONObject): void {
  if (info['scopeKey'] != getOfflineH5ScopeKey()) return;
  const token = getOfflineH5AccessToken();
  if (token.length > 0) {
    uni.setStorageSync(ACCESS_TOKEN, '');
    clearStoragePreservingApiBaseUrl();
  }
  redirectToLoginOnce();
}

export function isOfflineH5Enabled(): boolean {
  // 保留已有紧急开关值兼容已安装的客户端。
  const disabled = uni.getStorageSync('NUWAX_LOCAL_CHAT_H5_DISABLE');
  return disabled == null || `${disabled}` != '1';
}

export function buildProjectOfflineH5Request(route: string, requestKey: string): UTSJSONObject {
  const server = getApiBaseUrl();
  const token = getOfflineH5AccessToken();
  const separator = route.includes('?') ? '&' : '?';
  // 显式能力标记：新 H5 回退到旧 App 宿主时仍使用远程 H5 自身的登录路由。
  const target = `${route}${separator}appEmbedded=1&appNativeLogin=1&accessToken=${encodeURIComponent(token)}`;
  return {
    requestKey: requestKey,
    scopeKey: getOfflineH5ScopeKey(),
    localUrl: `${OFFLINE_H5_ENTRY}?apiBase=${encodeURIComponent(server)}#${target}`,
    remoteUrl: `${server}/m/#${target}`,
    preferLocal: isOfflineH5Enabled(),
    // 线上旧 H5 尚未发布协议时保留可访问性；仅本地 PAGE_READY 允许后续软导航。
    remoteReadyPolicy: 'document',
  };
}
