/** Stable protocol errors are internal codes; UI renders localized messages. */
export function callFailure(code: string): Error { return new Error(code); }

export function isIncomingPresentationError(code: string): boolean {
  return code == "CALL_SYSTEM_FOCUS_FILTERED" || code == "CALL_SYSTEM_BLOCKED" || code == "CALL_SYSTEM_RESTRICTED" || code == "CALL_SYSTEM_UNAVAILABLE";
}

export function callErrorTranslationKey(code: string): string {
  if (code == "CALL_SYSTEM_FOCUS_FILTERED") return "Mobile.Voip.focusFiltered";
  if (code == "CALL_SYSTEM_BLOCKED") return "Mobile.Voip.callBlocked";
  if (code == "CALL_SYSTEM_RESTRICTED") return "Mobile.Voip.callRestricted";
  if (code == "CALL_SYSTEM_UNAVAILABLE") return "Mobile.Voip.systemUnavailable";
  if (code == "CALL_PERMISSION_REQUIRED") return "Mobile.Voip.permissionRequired";
  if (code == "CALL_SESSION_EXPIRED") return "Mobile.Voip.sessionExpired";
  if (code == "CALL_AUDIO_ROUTE_UNAVAILABLE") return "Mobile.Voip.audioRouteUnavailable";
  return "Mobile.Voip.operationFailed";
}

export function callEndTranslationKey(reason: string): string {
  if (reason == "busy") return "Mobile.Voip.busy";
  if (reason == "answeredElsewhere") return "Mobile.Voip.answeredElsewhere";
  if (reason == "rejected") return "Mobile.Voip.rejected";
  if (reason == "timeout") return "Mobile.Voip.timeout";
  if (reason == "cancel" || reason == "cancelled" || reason == "remoteCancelled") return "Mobile.Voip.cancelled";
  if (reason == "systemFocusFiltered") return "Mobile.Voip.focusFiltered";
  if (reason == "systemBlocked") return "Mobile.Voip.callBlocked";
  if (reason == "systemRestricted") return "Mobile.Voip.callRestricted";
  if (reason == "systemUnavailable" || reason == "systemFailed") return "Mobile.Voip.systemUnavailable";
  if (reason == "permissionDenied" || reason == "permissionRequired") return "Mobile.Voip.permissionRequired";
  if (reason == "sessionExpired" || reason == "sessionReplaced") return "Mobile.Voip.sessionExpired";
  if (reason == "reconnectTimeout" || reason == "connectionTimeout") return "Mobile.Voip.connectionTimeout";
  if (reason == "processInterrupted" || reason == "audioReset" || reason == "systemReset") return "Mobile.Voip.interruptedEnd";
  return "";
}
