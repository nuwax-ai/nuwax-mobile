/** 乐鑫 Provisioning 二维码解析与生产安全校验。 */
import {
  EspProvisioningQrParseResult,
  EspProvisioningQrPayload,
} from '@/types/interfaces/espProvisioning';
import { EspProvisioningSecurityEnum } from '@/types/enums/espProvisioning';

function stringField(obj: UTSJSONObject, key: string): string {
  const value = obj[key];
  return value != null ? `${value}` : '';
}

/**
 * 清洗扫码原始文本：按码点过滤 BOM / 零宽 / 格式字符 / 控制字符 + 首尾空白。
 * Android 部分机型 scanCode 会在 JSON 里注入 U+FEFF、零宽连接符(U+200C/D)、NBSP(U+A0)、
 * 字连接符(U+2060) 等不可见字符，导致 JSON.parse 直接失败（iOS 同一 QR 不受影响）。
 * ESP QR 取值均为 ASCII，按码点剥掉这些不可见/控制字符是安全的。
 */
function sanitizeQrRaw(raw: string): string {
  let out = '';
  for (let i = 0; i < raw.length; i++) {
    const c = raw.charCodeAt(i);
    if (c < 0x20) continue;                       // 控制字符（\r\n\t 等）
    if (c == 0xfeff) continue;                    // BOM / 零宽非断空格
    if (c == 0xa0) continue;                      // 不间断空格 NBSP
    if (c >= 0x200b && c <= 0x200f) continue;     // 零宽空格/非连接/连接 + 方向标记
    if (c >= 0x2028 && c <= 0x202e) continue;     // 行/段分隔 + 方向覆盖
    if (c >= 0x2060 && c <= 0x2064) continue;     // 字连接符 + 不可见数学运算符
    out += raw.charAt(i);
  }
  return out.trim();
}

/**
 * 解析二维码。失败只返回稳定错误码，不回传原始文本，避免调用方误写敏感日志。
 */
export function parseEspProvisioningQr(raw: string, allowSecurity0: boolean = false): EspProvisioningQrParseResult {
  const cleaned = sanitizeQrRaw(raw);
  if (cleaned == '') return new EspProvisioningQrParseResult(null, 'QR_EMPTY');
  try {
    const obj = JSON.parse(cleaned) as UTSJSONObject;
    const version = stringField(obj, 'ver');
    // 契约要求大写；扫码/贴纸偶发小写 hex，归一化后再校验与下游使用
    const name = stringField(obj, 'name').toUpperCase();
    const transport = stringField(obj, 'transport').toLowerCase();
    const network = stringField(obj, 'network').toLowerCase();
    const username = stringField(obj, 'username');
    const pop = stringField(obj, 'pop');
    const securityRaw = stringField(obj, 'security');
    const securityNumber = securityRaw != '' ? parseInt(securityRaw) : 2;

    if (version != 'v1') return new EspProvisioningQrParseResult(null, 'QR_VERSION_UNSUPPORTED');
    if (name == '') return new EspProvisioningQrParseResult(null, 'QR_NAME_REQUIRED');
    // 冻结契约 §2：设备名必须 PROV_ + STA MAC 后三字节大写十六进制（PROV_XXXXXX）
    const namePattern = new RegExp('^PROV_[0-9A-F]{6}$');
    if (!namePattern.test(name)) return new EspProvisioningQrParseResult(null, 'QR_NAME_INVALID');
    if (transport != 'ble') return new EspProvisioningQrParseResult(null, 'QR_TRANSPORT_UNSUPPORTED');
    if (network != '' && network != 'wifi') return new EspProvisioningQrParseResult(null, 'QR_NETWORK_UNSUPPORTED');
    // securityRaw 非空但 parseInt 失败时，UTS/JS 可能得到 NaN；NaN 与自身比较恒为 false
    if (securityNumber != securityNumber || securityNumber < 0 || securityNumber > 2) {
      return new EspProvisioningQrParseResult(null, 'QR_SECURITY_UNSUPPORTED');
    }
    if (securityNumber == 0 && !allowSecurity0) {
      return new EspProvisioningQrParseResult(null, 'QR_SECURITY0_FORBIDDEN');
    }
    if (securityNumber == 1 && pop == '') {
      return new EspProvisioningQrParseResult(null, 'QR_POP_REQUIRED');
    }
    if (securityNumber == 2 && (username == '' || pop == '')) {
      return new EspProvisioningQrParseResult(null, 'QR_SECURITY2_CREDENTIALS_REQUIRED');
    }

    return new EspProvisioningQrParseResult(
      new EspProvisioningQrPayload(
        version,
        name,
        transport,
        network != '' ? network : 'wifi',
        securityNumber as EspProvisioningSecurityEnum,
        username,
        pop,
      ),
    );
  } catch (e) {
    // 仅记错误信息 + 结构特征，不回打 QR 全文（含 PoP）
    console.warn(`[EspQr] JSON.parse failed; cleaned len=${cleaned.length} first="${cleaned.length > 0 ? cleaned.substring(0, 1) : ""}" last="${cleaned.length > 0 ? cleaned.substring(cleaned.length - 1) : ""}"`, e);
    return new EspProvisioningQrParseResult(null, 'QR_JSON_INVALID');
  }
}

/** 设备 ID 日志脱敏：仅保留首尾各 2 个字符。 */
export function maskProvisioningDeviceId(deviceId: string): string {
  if (deviceId.length <= 4) return '****';
  return `${deviceId.substring(0, 2)}***${deviceId.substring(deviceId.length - 2)}`;
}
