<template>
  <view class="directional-pager" @touchstart="handleTouchStart" @touchend="handleTouchEnd" @touchcancel="handleTouchCancel">
    <swiper class="directional-pager-inner" :current="current" :disable-touch="true" :circular="false" :duration="220">
      <slot />
    </swiper>
  </view>
</template>

<script setup lang="uts">
  import { nextTick } from "vue";
  import { HorizontalTabSwipeTracker } from "@/utils/horizontalTabSwipe";

  const props = withDefaults(defineProps<{ current: number; count: number; enabled?: boolean }>(), { enabled: true });
  const emit = defineEmits<{
    (e: "change", index: number): void;
    (e: "preview", index: number): void;
  }>();
  const swipeTracker = new HorizontalTabSwipeTracker();

  function handleTouchStart(event: UniTouchEvent): void {
    if (props.enabled) swipeTracker.begin(event);
  }

  function handleTouchEnd(event: UniTouchEvent): void {
    if (!props.enabled) return;
    const direction = swipeTracker.finish(event);
    const next = props.current + direction;
    if (direction == 0 || next < 0 || next >= props.count) return;
    emit("preview", next);
    nextTick((): void => {
      if (props.enabled && props.current != next && next < props.count) emit("change", next);
    });
  }

  function handleTouchCancel(_event: UniTouchEvent): void {
    swipeTracker.cancel();
  }
</script>

<style scoped>
  .directional-pager { flex: 1; width: 100%; height: 0; min-height: 0; }
  .directional-pager-inner { flex: 1; width: 100%; height: 100%; }
</style>
