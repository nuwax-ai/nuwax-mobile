<template>
  <view class="nav-root">
    <view
      class="layout"
      :class="[(className != null ? className : ''), fixed == true ? 'layout-fixed' : '']"
      :style="{
        backgroundColor: transparentBackground == true ? 'transparent' : backgroundColor,
      }"
    >
      <!-- 微信安全区 -->
      <safety-zone v-if="hasSafetyZone"></safety-zone>
      <view :class="['nav-bar', leftWide == true ? 'nav-bar-left-wide' : '']">
        <!-- 左侧菜单按钮 -->
        <view :class="['left-box', titleAlign == 'left' ? 'left-box-compact' : '']">
          <view class="menu-btn">
            <view v-if="showBack" class="back-btn" @click="onBackClick">
              <svg-icon name="icon-a-Chevronleft" size="44" />
            </view>
            <slot name="left"></slot>
          </view>
        </view>

        <!-- 中间 logo + 名称 -->
        <view class="logo-wrap">
          <view class="title-box" :class="titleAlign == 'left' ? 'title-box-left' : ''">
            <!-- 图标 -->
            <view class="logo" v-if="icon != null && icon != ''">
              <image
                class="image"
                :src="currentIcon"
                mode="aspectFill"
                :alt="displayTitle != null && displayTitle != '' ? displayTitle : t('Mobile.Common.agentIconAlt')"
                @error="handleImageError"
              ></image>
            </view>
            <!-- 标题 -->
            <text
              class="title text-ellipsis"
              :class="icon != null && icon != '' ? 'title-exist-icon' : 'title-no-icon'"
              >{{ displayTitle }}</text
            >
          </view>
        </view>

        <!-- 右侧插槽 -->
        <view class="right-box">
          <slot name="right"></slot>
        </view>

        <!-- 微信胶囊按钮功能区 -->
        <!-- #ifdef MP-WEIXIN -->
        <view
          v-if="false"
          class="right-safety"
          :style="{
            width: clientRect.width + 'px',
            height: clientRect.height + 'px',
          }"
        ></view>
        <!-- #endif -->
      </view>
    </view>

    <!-- fixed 模式占位：导航 position:fixed 脱离文档流后，同高占位在文档流中顶开下方内容，
         结构镜像导航内部（safety-zone 状态栏 + 同高导航条），导航栏高度变化占位自动跟随 -->
    <!-- #ifdef H5 -->
    <view v-if="fixed == true" class="layout-placeholder">
      <safety-zone v-if="hasSafetyZone"></safety-zone>
      <view class="nav-bar-placeholder"></view>
    </view>
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from "vue";
import { chatService } from "@/utils/chatService";
import agentImage from "@/static/assets/agent_image.png";
import { translateText, t as translateFn, emptyI18nParams } from "@/utils/i18n";
import { isAppWebViewEmbedded } from "@/utils/system.uts";
const _params = emptyI18nParams();
const t = (key: string): string => translateFn(key, _params, "");

// #ifdef MP-WEIXIN
const clientRect = uni.getMenuButtonBoundingClientRect();
// #endif

const props = defineProps({
  title: String,
  icon: String,
  showBack: Boolean,
  className: String,
  hasSafetyZone: Boolean,
  transparentBackground: Boolean,
  backgroundColor: String,
  interceptBack: Boolean,
  leftWide: Boolean,
  // 标题对齐方式：'center'（默认，居中）| 'left'（左侧）
  titleAlign: String,
  // 固定定位（H5 生效）：键盘弹出浏览器自动滚动文档时导航栏不随文档滚走；状态栏高度由内部 safety-zone 自取
  fixed: Boolean,
});
const emit = defineEmits(["back"]);

const displayTitle = computed<string>(() => {
  return translateText(props.title != null ? props.title : "");
});

// 当前显示的图标（用于处理加载失败时使用默认图片）
const currentIcon = ref<string>(props.icon != null && props.icon != "" ? props.icon : agentImage);

const onBackClick = () => {
  if (props.interceptBack == true) {
    emit("back");
    return;
  }
  // 中止当前会话
  chatService.abort();
  // #ifdef H5 || WEB
  // App web-view 内嵌：导航以原生栈为准 —— 返回直接经 uni.webView.navigateBack
  // 弹掉 webview 所在原生页（agent-detail），回到 App 首页；
  // 不做 H5 栈内返回（那只在 webview 内跳转，App 端体验不对）。
  if (isAppWebViewEmbedded() == true) {
    try {
      const w = window as any;
      if (
        w != null &&
        w.uni != null &&
        w.uni.webView != null &&
        w.uni.webView.navigateBack != null
      ) {
        w.uni.webView.navigateBack({ delta: 1 });
        return;
      }
    } catch (_e) {
      // ignore
    }
    // JSSDK 不可用兜底：回 H5 首页（浏览器语义）
    uni.reLaunch({
      url: "/pages/index/index",
    });
    return;
  }
  // #endif
  // 获取当前页面栈
  const pages = getCurrentPages();
  // 如果页面栈中有多个页面，正常返回
  if (pages.length > 1) {
    uni.navigateBack({
      delta: 1,
    });
    return;
  }
  // 如果页面栈只有一个页面（浏览器刷新后），使用浏览器历史记录返回 如果没有历史记录，跳转到首页
  uni.reLaunch({
    url: "/pages/index/index",
  });
};

/**
 * 图片加载失败处理
 * 当图片加载失败时，使用默认图片
 */
const handleImageError = () => {
  currentIcon.value = agentImage;
};

// 监听 props.icon 变化，更新当前图标
watch(
  () : string | null => props.icon as string | null,
  (newIcon : string | null) => {
    currentIcon.value = newIcon != null && newIcon != "" ? newIcon : agentImage;
  },
  { immediate: true },
);
</script>

<style lang="scss" scoped>
@import "@/styles/nav-bar-size.scss";

/* 根容器：普通模式只包导航；fixed 模式下导航脱离文档流，由内部占位撑起同高空间。
   导航不可被压缩（H5 flex 默认 shrink 1，显式禁止；native 默认即 0） */
.nav-root {
  flex-shrink: 0;
}

/* #ifdef H5 */
/* 固定定位（fixed prop 启用）：聊天页键盘弹出时浏览器自动滚动文档，导航栏固定在视口顶部不随文档滚走。
   状态栏/刘海高度由组件内部 safety-zone 依据注入值自行占位，无需外部传入。
   背景用不透明白色（勿用 var(--background-color-content)：uni-app x 运行时未配置 backgroundColorContent
   时该变量默认为 transparent，兜底 #fff 不生效，滚动时内容会透过导航栏）；!important 压过根 :style
   的 backgroundColor 绑定（未传时为 undefined）。 */
.layout-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #ffffff !important;
}

/* 固定模式占位：结构镜像导航（safety-zone 状态栏 + 同高导航条），高度随导航变化自动跟随 */
.layout-placeholder {
  width: 100%;
}

.nav-bar-placeholder {
  /* 与 .nav-bar 的 H5 高度共用 $nav-bar-height-h5（styles/nav-bar-size.scss 一处定义） */
  height: $nav-bar-height-h5;
}
/* #endif */

.layout {
  .nav-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    /* H5 高度与聊天页固定导航占位共用 $nav-bar-height-h5（改此处高度须同步 styles/nav-bar-size.scss） */
    height: $nav-bar-height-h5;
    /* #ifndef H5 */
    /* 64rpx 图标加上下 20rpx 内边距，避免 Android 父容器裁切标题区域。 */
    height: 104rpx;
    /* #endif */
    padding: 24rpx 32rpx;
    box-sizing: border-box;

    .left-box {
      /* #ifdef H5 */
      min-width: 30%;
      /* #endif */
      /* #ifndef H5 */
      /* Android 屏宽为 750rpx，225rpx 两侧预留会挤压中间标题。 */
      min-width: 180rpx;
      /* #endif */
      align-items: flex-start;

      /* 标题左对齐时无需为居中预留空间，让标题紧贴返回按钮 */
      &.left-box-compact {
        min-width: 0;
      }

      .menu-btn {
        // margin-right: 12rpx;
        width: 100%;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        min-width: 0;

        .back-btn {
          display: flex;
          flex-direction: row;
          align-items: center;
          justify-content: center;
          min-width: 64rpx;
          height: 64rpx;
          padding: 10rpx;
          margin-left: -10rpx;
          // margin-right: 8rpx;
          /* #ifdef H5 */
          cursor: pointer;
          /* #endif */
        }

        .iconfont.icon-a-Chevronleft {
          margin-right: 20rpx;
        }
      }
    }

    .logo-wrap {
      flex: 1;
      min-width: 0;
      overflow: hidden;

      .title-box {
        width: 100%;
        margin: 0 auto;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        min-width: 0;
        overflow: hidden;

        /* 标题左对齐：容器从左侧排布，文字也左对齐（有/无图标都生效） */
        &.title-box-left {
          justify-content: flex-start;

          .title {
            text-align: left;
          }
        }

        .logo {
          margin-right: 12rpx;
          width: 64rpx;
          height: 64rpx;
          border-radius: 50%;
          overflow: hidden;
          position: relative;
          flex-shrink: 0;

          .image {
            position: absolute;
            left: -3%;
            top: -3%;
            width: 106%;
            height: 106%;
          }
        }

        .title {
          flex: 1;
          min-width: 0;
          font-size: 32rpx;
          font-weight: 600;
          line-height: 48rpx;
          color: rgba(21, 23, 31, 1);
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;

          &-exist-icon {
            /* #ifdef H5 */
            max-width: calc(100% - 64rpx - 12rpx);
            /* #endif */
            text-align: left;
          }

          &-no-icon {
            text-align: center;
          }
        }
      }
    }

    .right-box {
      /* #ifdef H5 */
      min-width: 30%;
      /* #endif */
      /* #ifndef H5 */
      min-width: 180rpx;
      /* #endif */
      display: flex;
      flex-direction: row;
      align-items: center;
      /* App 端 slot 容器默认从起始位排列，需明确整体靠右 */
      justify-content: flex-end;
      align-content: flex-end;
    }

    &.nav-bar-left-wide {
      .left-box {
        flex: 1;
        min-width: 0;
      }

      .logo-wrap {
        display: none;
      }
    }
  }
}
</style>
