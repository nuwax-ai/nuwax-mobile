<template>
  <view>
    <view class="guide-header" @click="toggleGuide">
      <view class="guide-icon">
        <svg-icon name="icon-bell" size="20" unit="px" />
      </view>
      <text class="guide-title">{{ t("Mobile.Voip.setupTitle") }}</text>
      <text class="guide-arrow">{{ expanded ? "⌄" : "›" }}</text>
    </view>

    <view v-if="expanded" class="guide-body">
      <text class="guide-note">{{ t("Mobile.Voip.setupIntro") }}</text>
      <text v-if="props.pushDisabled" class="guide-note">{{ t("Mobile.Voip.setupPushOff") }}</text>
      <view v-for="step in steps" :key="step.id" class="guide-step">
        <view class="guide-step-copy">
          <text class="guide-step-title">{{ t(step.title) }}</text>
          <text class="guide-note">{{ t(step.description) }}</text>
          <text v-if="step.ready == null" class="guide-note">{{ t("Mobile.PushBackground.statusUnknown") }}</text>
        </view>
        <text v-if="step.ready == true" class="guide-status">{{ t("Mobile.PushBackground.optimized") }}</text>
        <button
          v-else
          class="guide-action"
          :class="{ 'guide-next': step.id == nextStep }"
          :disabled="working || inCall || (step.id == 'camera' && microphone != 'authorized')"
          @click="openStep(step.id)"
        >{{ t(step.id == nextStep ? "Mobile.Voip.setupNext" : "Mobile.Voip.openSettings") }}</button>
      </view>
      <!-- #ifdef APP-ANDROID -->
      <text v-if="noticeKey.length > 0" class="guide-note guide-footer">{{ t(noticeKey) }}</text>
      <!-- #endif -->
      <!-- #ifdef APP-IOS -->
      <view class="guide-service">
        <text class="guide-step-title">{{ t("Mobile.Voip.setupService") }}</text>
        <text class="guide-status">{{ t(registrationLabel) }}</text>
      </view>
      <!-- #endif -->
      <text class="guide-note guide-footer">{{ t("Mobile.Voip.setupVerify") }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, onUnmounted, ref, watch } from "vue";
  import { appForegroundRevision, isAppInBackground } from "@/utils/appLifecycle";
  import { emptyI18nParams, t as translate } from "@/utils/i18n";
  import { getImSessionStamp } from "@/utils/im/imSessionScope";
  import { isVoipBusy, voipRevision } from "@/features/voip/callManager";
  import { ensureVoipPermissions, openVoipAppSettings } from "@/uni_modules/nuwax-voip";
  // #ifdef APP-ANDROID
  import { getVoipPresentationStatus, openVoipAlertSettings } from "@/uni_modules/nuwax-voip";
  // #endif
  // #ifdef APP-IOS
  import { voipPushRegistration } from "@/features/voip/callManager";
  // #endif

  type PermissionStep = { id: string, title: string, description: string, ready: boolean | null };

  const props = defineProps<{ pushDisabled: boolean }>();
  const expanded = ref<boolean>(false);
  const working = ref<boolean>(false);
  const microphone = ref<string>("");
  const camera = ref<string>("");
  // #ifdef APP-ANDROID
  const androidStatus = ref<UTSJSONObject | null>(null);
  // #endif
  const t = (key: string): string => translate(key, emptyI18nParams(), "");

  const inCall = computed((): boolean => { voipRevision.value; return isVoipBusy(); });

  function authorizationReady(status: string): boolean | null {
    if (status == "authorized") return true;
    if (status == "denied" || status == "not determined") return false;
    return null;
  }

  // #ifdef APP-ANDROID
  function androidFlag(key: string): boolean | null {
    const status = androidStatus.value;
    const value = status == null ? null : status[key];
    if (value === true) return true;
    if (value === false) return false;
    return null;
  }
  // #endif

  const steps = computed((): PermissionStep[] => {
    const result = [] as PermissionStep[];
    // #ifdef APP-ANDROID
    const status = androidStatus.value;
    const knownChannel = status != null && parseFloat(`${status["channelImportance"] ?? -1}`) >= 0;
    const channelAudible = androidFlag("channelSoundEnabled");
    result.push(
      { id: "notifications", title: "Mobile.Profile.systemNotificationPermission", description: "Mobile.Voip.setupNotifications", ready: androidFlag("notificationsAllowed") } as PermissionStep,
      {
        id: "channel", title: "Mobile.Voip.notificationIncoming",
        description: knownChannel && channelAudible == false ? "Mobile.Voip.setupChannelMuted" : "Mobile.Voip.setupChannel",
        ready: knownChannel ? androidFlag("channelEnabled") == true && channelAudible == true : null,
      } as PermissionStep,
      { id: "overlay", title: "Mobile.Voip.setupOverlayTitle", description: "Mobile.Voip.setupOverlay", ready: androidFlag("overlayAllowed") } as PermissionStep,
    );
    if (androidFlag("fullScreenPermissionChecked") == true) {
      result.push({ id: "fullScreen", title: "Mobile.Voip.setupFullScreenTitle", description: "Mobile.Voip.setupFullScreen", ready: androidFlag("fullScreenAllowed") } as PermissionStep);
    }
    if (androidFlag("presentedChannelExists") == true) {
      result.push({ id: "presentedChannel", title: "Mobile.Voip.setupPresentedTitle", description: "Mobile.Voip.setupPresented", ready: androidFlag("presentedChannelAudible") } as PermissionStep);
    }
    // #endif
    result.push(
      { id: "microphone", title: "Mobile.Voip.setupMicTitle", description: "Mobile.Voip.setupMic", ready: authorizationReady(microphone.value) } as PermissionStep,
      { id: "camera", title: "Mobile.Voip.setupCameraTitle", description: microphone.value == "authorized" ? "Mobile.Voip.setupCamera" : "Mobile.Voip.setupCameraAfterMic", ready: authorizationReady(camera.value) } as PermissionStep,
    );
    return result;
  });

  const nextStep = computed((): string => {
    for (const step of steps.value) {
      if (step.ready != true && (step.id != "camera" || microphone.value == "authorized")) return step.id;
    }
    return "";
  });

  // #ifdef APP-ANDROID
  const noticeKey = computed((): string => {
    if (androidFlag("doNotDisturbActive") == true) return "Mobile.Voip.setupDnd";
    if (androidFlag("ringerAudible") == false) return "Mobile.Voip.setupRinger";
    return "";
  });
  // #endif

  // #ifdef APP-IOS
  const registrationLabel = computed((): string => {
    const state = voipPushRegistration.value["state"];
    if (state == "registered") return "Mobile.Voip.setupRegistered";
    if (state == "registering") return "Mobile.PushBackground.checking";
    if (state == "unknown") return "Mobile.Voip.testUnchecked";
    return "Mobile.Voip.setupUnavailable";
  });
  // #endif

  function refresh(): void {
    try {
      const permissions = uni.getAppAuthorizeSetting();
      microphone.value = permissions.microphoneAuthorized;
      camera.value = permissions.cameraAuthorized;
    } catch (_e) {
      microphone.value = "";
      camera.value = "";
    }
    // #ifdef APP-ANDROID
    try {
      const status = JSON.parse(getVoipPresentationStatus()) as UTSJSONObject;
      androidStatus.value = status["supported"] === true ? status : null;
    } catch (_e) {
      androidStatus.value = null;
    }
    // #endif
  }

  function toggleGuide(): void {
    expanded.value = !expanded.value;
    if (expanded.value) refresh();
  }

  watch(appForegroundRevision, () => { if (expanded.value) refresh(); });
  onUnmounted(() => { expanded.value = false; });

  async function openStep(id: string): Promise<void> {
    if (working.value || isVoipBusy() || isAppInBackground()) return;
    // #ifdef APP-ANDROID
    if (id != "microphone" && id != "camera") {
      try {
        if (openVoipAlertSettings(id)) return;
      } catch (_e) {
        // A custom base without the settings bridge may still have the VoIP client.
      }
      uni.showToast({ title: t("Mobile.Voip.setupOpenFailed"), icon: "none" });
      return;
    }
    // #endif
    if (id == "camera" && microphone.value != "authorized") return;
    // #ifdef APP-IOS
    if ((id == "microphone" ? microphone.value : camera.value) == "denied") {
      openVoipAppSettings();
      return;
    }
    // #endif
    const stamp = getImSessionStamp();
    working.value = true;
    let granted = false;
    try {
      granted = await ensureVoipPermissions(id == "camera" ? "video" : "audio");
    } catch (_e) {
      // The app settings entry also covers a permanent denial.
    } finally {
      working.value = false;
      if (expanded.value) refresh();
    }
    if (granted || !expanded.value || stamp != getImSessionStamp() || isVoipBusy() || isAppInBackground()) return;
    uni.showModal({
      title: t(id == "camera" ? "Mobile.Voip.setupCameraTitle" : "Mobile.Voip.setupMicTitle"),
      content: t("Mobile.Voip.setupMediaDenied"),
      confirmText: t("Mobile.Voip.openSettings"),
      cancelText: t("Mobile.Common.cancel"),
      success: (result: ShowModalSuccess) => {
        if (result.confirm && expanded.value && stamp == getImSessionStamp() && !isVoipBusy()) openVoipAppSettings();
      },
    });
  }
</script>

<style scoped>
  .guide-header, .guide-step, .guide-service { flex-direction: row; align-items: center; }
  .guide-header { padding: 14px 16px; }
  .guide-icon { width: 28px; height: 28px; margin-right: 12px; align-items: center; justify-content: center; }
  .guide-title { flex: 1; font-size: 16px; color: #1f2329; }
  .guide-arrow { font-size: 20px; color: #878b93; }
  .guide-body { padding: 0 16px 14px; }
  .guide-step, .guide-service { padding-top: 12px; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #f0f0f3; }
  .guide-step-copy { flex: 1; padding-right: 12px; }
  .guide-step-title { color: #1f2329; font-size: 14px; font-weight: 500; }
  .guide-note { color: #646a73; font-size: 13px; margin-top: 4px; }
  .guide-status { margin-left: 8px; font-size: 13px; color: #4d5560; }
  .guide-service { justify-content: space-between; }
  .guide-action { margin: 0; padding: 0 10px; min-height: 44px; font-size: 13px; color: #383087; background-color: #f2effe; border-radius: 8px; }
  .guide-next { color: #ffffff; background-color: #5548d4; }
  .guide-footer { margin-top: 10px; }
</style>
