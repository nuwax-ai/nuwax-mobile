/**
 * MCP Ask 跨端 resume 检测（UTS 安全轻量版）。
 *
 * 临时替代 @/subpackages/utils/mcpAskResumeMessage.uts —— 该文件为 PC 端 TS 直搬
 * （687 行，含 interface 数组 push 对象字面量 / `| undefined` / `?.` / `unknown` 等
 * UTS 不支持写法），暂未通过 Android UTS 编译。待其完成 UTS 适配后，本文件可删除、
 * 各调用方改回 import 完整实现。
 *
 * 与完整版的差异：完整版另含 requestId HTML marker、同 title 多次询问的 ordinal 配对；
 * 此处仅按「我已填写/取消/跳过/已超时「title」」文本签名判定，覆盖绝大多数单问场景。
 */
import type { MessageInfo } from "@/types/interfaces/conversationInfo.uts";
import type {
  McpAskInteraction,
  McpAskRespondPayload,
} from "@/types/intervention";
import { orArray, orString } from "@/utils/utsCoalesce.uts";
import { emptyI18nParams, toI18nParams, useI18n } from "@/utils/i18n";
import { readRawField } from "@/utils/readRawField.uts";

const { t } = useI18n();
const emptyParams = emptyI18nParams();

/** 取交互卡片标题（优先 ui.title，回退 interaction.title；兼容 UTSJSONObject） */
function getMcpAskResumeTitle(interaction: any): string {
  const ui = readRawField(interaction, "ui");
  const uiTitle = readRawField(ui, "title");
  const title = readRawField(interaction, "title");
  return orString(title, orString(uiTitle, ""));
}

/** 各 action 的 resume 文本签名（含简繁/英文变体） */
function collectResumeMessageSignatures(
  title: string,
  action: string,
): string[] {
  const signatures: string[] = [];
  if (action == "submit") {
    signatures.push(`我已填写「${title}」`);
    signatures.push(`我已填寫「${title}」`);
    signatures.push(`I filled out "${title}"`);
  } else if (action == "cancel") {
    signatures.push(`我取消了「${title}」`);
    signatures.push(`I cancelled "${title}"`);
  } else if (action == "skip") {
    signatures.push(`我跳过了「${title}」`);
    signatures.push(`我跳過了「${title}」`);
    signatures.push(`I skipped "${title}"`);
  } else if (action == "timeout") {
    signatures.push(`「${title}」已超时`);
    signatures.push(`「${title}」已逾時`);
    signatures.push(`"${title}" timed out`);
  }
  return signatures;
}

/** 从 resume 文本解析动作状态；无匹配返回 null */
export function resolveMcpAskResumeStatus(
  text: string | null,
  interaction: any,
): string | null {
  if (text == null || text.length == 0) {
    return null;
  }
  const title = getMcpAskResumeTitle(interaction);
  if (title.length == 0) {
    return null;
  }
  const textStr = text as string;
  const actions = ["submit", "cancel", "skip", "timeout"];
  for (let a = 0; a < actions.length; a++) {
    const action = actions[a];
    const signatures = collectResumeMessageSignatures(title, action);
    for (let s = 0; s < signatures.length; s++) {
      if (textStr.includes(signatures[s])) {
        return action;
      }
    }
  }
  return null;
}

/** 会话消息里是否已存在该交互的 resume 文本（PC 端答复同步） */
export function hasMcpAskResumeMessage(
  messages: MessageInfo[],
  interaction: any,
): boolean {
  const list = orArray<MessageInfo>(messages);
  for (let i = 0; i < list.length; i++) {
    const msg = list[i];
    const textRaw = msg.text;
    if (textRaw == null) {
      continue;
    }
    if (resolveMcpAskResumeStatus(`${textRaw}`, interaction) != null) {
      return true;
    }
  }
  return false;
}

/**
 * 从 interaction.ui.fields 建 name→title 映射（title 缺失回退 name）。
 * resume 文案要用字段标题（如「你的名字」）而非 key（如「username」）。
 */
function buildFieldLabelMap(interaction: any): Map<string, string> {
  const map = new Map<string, string>();
  const ui = readRawField(interaction, "ui");
  const fieldsRaw = readRawField(ui, "fields");
  if (fieldsRaw == null || Array.isArray(fieldsRaw) == false) {
    return map;
  }
  const fields = fieldsRaw as any[];
  for (let i = 0; i < fields.length; i++) {
    const f = fields[i];
    const name = orString(readRawField(f, "name"), "");
    if (name.length == 0) continue;
    const title = orString(readRawField(f, "title"), "");
    map.set(name, title.length > 0 ? title : name);
  }
  return map;
}

/**
 * 构建 MCP Ask 提交后的 resume 文本（对齐 PC，作为用户消息发回会话续作）。
 * 轻量版：cancel/skip/timeout 用 i18n 模板；submit 用 i18n 头 + 表单字段「key：value」逐行。
 * 注：表单值未做枚举/文件字段的美化（完整版在 mcpAskResumeMessage.uts，UTS 适配后可换回）。
 */
export function buildMcpAskResumeMessage(
  interaction: any,
  payload: McpAskRespondPayload,
): string {
  const action = payload.action;
  const title = getMcpAskResumeTitle(interaction);
  const titleMap = new Map<string, string | number>();
  titleMap.set("0", title);
  const titleParams = toI18nParams(titleMap);

  if (action == "cancel") {
    return t("Mobile.Intervention.McpAsk.resumeCancelled", titleParams, "");
  }
  if (action == "skip") {
    return t("Mobile.Intervention.McpAsk.resumeSkipped", titleParams, "");
  }
  if (action == "timeout") {
    return t("Mobile.Intervention.McpAsk.resumeTimeout", titleParams, "");
  }

  const header = t("Mobile.Intervention.McpAsk.resumeSubmitted", titleParams, "");
  const formData = payload.formData;
  if (formData == null) {
    return `${header}\n\n${t("Mobile.Intervention.McpAsk.emptyFormContent", emptyParams, "")}`;
  }
  const labelSeparator = t("Mobile.Intervention.McpAsk.labelSeparator", emptyParams, "");
  // label 用字段标题（title），而非 key（字段名）
  const labelMap = buildFieldLabelMap(interaction);
  const lines: string[] = [];
  const formObject = formData as UTSJSONObject;
  const keys = UTSJSONObject.keys(formObject);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const mapped = labelMap.get(key);
    const label = mapped != null ? (mapped as string) : key;
    const value = readRawField(formData, key);
    if (value == null) {
      lines.push(`${label}${labelSeparator}${t("Mobile.Intervention.McpAsk.notFilled", emptyParams, "")}`);
    } else if (typeof value == "object") {
      // 数组/对象（如文件、多选）简单 JSON 化，避免 [object Object]
      const json = JSON.stringify(value);
      lines.push(`${label}${labelSeparator}${json != null ? json : `${value}`}`);
    } else {
      lines.push(`${label}${labelSeparator}${value}`);
    }
  }
  if (lines.length == 0) {
    return `${header}\n\n${t("Mobile.Intervention.McpAsk.emptyFormContent", emptyParams, "")}`;
  }
  return `${header}\n\n${lines.join("\n")}`;
}
