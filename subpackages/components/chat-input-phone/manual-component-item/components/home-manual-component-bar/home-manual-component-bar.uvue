<template>
  <view class="home-manual-wrapper">
    <view class="home-manual-container">
      <!-- 自动/审批模式选择 -->
      <view
        v-if="props.isTaskAgentVal && props.allowChooseModeVal"
        class="manual-box manual-select"
        :class="{ disabled: props.readonlyVal }"
        @click="emit('openAgentModeDrawer')"
      >
        <text class="text text-ellipsis">{{ props.currentAgentModeLabel }}</text>
        <text class="icon iconfont icon-arrow-down"></text>
      </view>

      <!-- 沙盒选择 -->
      <view v-if="props.isTaskAgentVal && props.readonlyVal == false" class="manual-group">
        <view
          v-if="props.isSandboxUnavailableVal == false && props.currentSandboxName.length > 0"
          class="manual-box manual-select"
          @click="emit('openSandboxDrawer')"
        >
          <text class="text text-ellipsis">{{ props.currentSandboxName }}</text>
          <text class="icon iconfont icon-arrow-down"></text>
        </view>
        <view v-else class="manual-box manual-select disabled">
          <text class="text text-ellipsis">{{ props.sandboxDisabledTextVal }}</text>
        </view>
      </view>

      <!-- 模型选择 -->
      <view
        v-if="props.allowOtherModelVal"
        class="manual-box manual-select"
        @click="emit('openModelSelect')"
      >
        <text class="text text-ellipsis">{{ props.modelSelectLabelVal }}</text>
        <text class="icon iconfont icon-arrow-down"></text>
      </view>

      <view
        v-for="item in props.manualComponentsVal"
        :key="item.id"
        class="manual-box"
        :class="{ active: isSelected(item) }"
        @click="handleSelectComponent(item)"
      >
        <text class="text text-ellipsis">{{ item.name }}</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { AgentManualComponentInfo, AgentSelectedComponentInfo } from "@/types/interfaces/agent";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      isTaskAgentVal?: boolean;
      allowChooseModeVal?: boolean;
      readonlyVal?: boolean;
      currentAgentModeLabel?: string;
      isSandboxUnavailableVal?: boolean;
      currentSandboxName?: string;
      sandboxDisabledTextVal?: string;
      allowOtherModelVal?: boolean;
      modelSelectLabelVal?: string;
      manualComponentsVal?: AgentManualComponentInfo[];
      selectedComponents?: AgentSelectedComponentInfo[];
    }>(),
    {
      isTaskAgentVal: false,
      allowChooseModeVal: false,
      readonlyVal: false,
      currentAgentModeLabel: "",
      isSandboxUnavailableVal: false,
      currentSandboxName: "",
      sandboxDisabledTextVal: "",
      allowOtherModelVal: false,
      modelSelectLabelVal: "",
      manualComponentsVal: () => [],
      selectedComponents: () => [],
    },
  );

  const emit = defineEmits<{
    (e: "onOpenPagePreview"): void;
    (e: "onOpenFileTree"): void;
    (e: "openAgentModeDrawer"): void;
    (e: "openSandboxDrawer"): void;
    (e: "openModelSelect"): void;
    (e: "handleSelectComponent", item: AgentManualComponentInfo): void;
  }>();

  const handleSelectComponent = (item: AgentManualComponentInfo) => {
    emit("handleSelectComponent", item);
  };

  const isSelected = (item: AgentManualComponentInfo): boolean => {
    const list = props.selectedComponents;
    const len = list.length;
    for (let i = 0; i < len; i++) {
      if (list[i].id == item.id) {
        return true;
      }
    }
    return false;
  };

</script>

<style lang="scss" scoped>
  .home-manual-wrapper {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: 76rpx;
    align-items: center;

    .home-manual-container {
      display: flex;
      flex-direction: row;
      width: 100%;
      height: 76rpx;
      align-items: center;
      justify-content: flex-start;
    }
  }

  .manual-group {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    margin-right: 12rpx;
  }

  .manual-box {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    height: 76rpx;
    max-width: 220rpx;
    padding: 16rpx 20rpx;
    margin-right: 12rpx;
    border-radius: 16rpx;
    border: 2rpx solid #f0f0f0;
    transition: all 0.3s ease;
    box-sizing: border-box;

    &:last-child {
      margin-right: 0;
    }

    .icon {
      font-size: 28rpx;
      color: #6b7280;
      transition: color 0.3s ease;
      margin-right: 4rpx;
      flex-shrink: 0;
    }

    &.active {
      background: #f2f2ff;
      border-color: #f2f2ff;

      .icon {
        color: #4f46e5;
      }

      .text {
        color: #5147ff;
      }
    }

    .text {
      flex: 1;
      min-width: 0;
      flex-shrink: 1;
      color: rgba(21, 23, 31, 0.7);
      font-size: 26rpx;
      font-weight: 400;
      text-align: center;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      lines: 1;
    }

    &.manual-select {
      border-color: #eeeeee;
      max-width: 220rpx;
      flex-shrink: 0;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: row;
      align-items: center;

      .text {
        flex: 1;
        min-width: 0;
        flex-shrink: 1;
        text-align: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        lines: 1;
      }

      .icon-arrow-down {
        font-size: 20rpx;
        margin-left: 2rpx;
        color: rgba(21, 23, 31, 0.4);
        flex-shrink: 0;
      }

      &.disabled {
        opacity: 0.6;
        background: #f5f5f5;
        pointer-events: auto;

        .text {
          color: rgba(21, 23, 31, 0.7);
        }
      }
    }

    &.disabled {
      opacity: 0.6;
      background: #f5f5f5;
      pointer-events: none;

      .text {
        color: rgba(21, 23, 31, 0.7);
      }
    }
  }
</style>
