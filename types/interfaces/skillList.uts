export type SkillListSourceType = "enabled" | "system" | "team" | "convenient" | "search";

/** default 对齐 PC list；simple 对齐 PC list + simple。 */
export type SkillListVariant = "default" | "simple";

export class SkillListItem {
  key: string = "";
  rawId: number = 0;
  targetId: number = 0;
  name: string = "";
  description: string = "";
  icon: string = "";
  category: string = "";
  paymentRequired: boolean = false;
  subscribed: boolean = false;
  enabled: boolean = false;
}
