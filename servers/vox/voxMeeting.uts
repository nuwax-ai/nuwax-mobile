/**
 * Nuwax Vox 设备语音网关 - App 会议接口
 * 列表/详情/录音临时地址/重处理；mock 开关见 mockVoxData.uts
 */
import request from "@/servers/useRequest";
import { VOX_BASE_URL } from "@/constants/config";
import { requestVoxAudioFiles } from "./voxAudioFiles";
import type { RequestResponse, VoidRequestResponse } from "@/types/interfaces/request";
import type {
  AppMeetingListParams,
  IAppMeetingAudioUrlView,
  IAppMeetingAudioFilesView,
  IAppMeetingDetailView,
  IAppMeetingPageView,
} from "@/types/interfaces/voxMeeting";
import {
  isVoxMockEnabled,
  mockVoxMeetingAudioUrl,
  mockVoxMeetingAudioFiles,
  mockVoxMeetingDetail,
  mockVoxMeetingList,
  mockVoxMeetingReprocess,
} from "./mockVoxData";

/** 会议列表（分页；keyword 匹配标题/摘要；timeRange=ALL|TODAY|THIS_WEEK|THIS_MONTH） */
export async function apiVoxMeetingList(data: AppMeetingListParams): Promise<RequestResponse<IAppMeetingPageView>> {
  if (isVoxMockEnabled()) {
    return mockVoxMeetingList(data.keyword, data.timeRange, data.page, data.pageSize);
  }
  const res = await request({
    url: `/api/app/meetings?agentId=${data.agentId}&keyword=${encodeURIComponent(data.keyword)}&timeRange=${data.timeRange}&page=${data.page}&pageSize=${data.pageSize}`,
    method: "GET",
    baseUrl: VOX_BASE_URL,
  });
  return res;
}

/** 会议详情（含转写分段与 Markdown 纪要） */
export async function apiVoxMeetingDetail(id: number): Promise<RequestResponse<IAppMeetingDetailView>> {
  if (isVoxMockEnabled()) {
    return mockVoxMeetingDetail(id);
  }
  const res = await request({ url: `/api/app/meetings/${id}`, method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 录音临时播放地址（有效期约 24h，勿持久化）
 *  @deprecated NW-269 播放接口变更：后端已废弃单文件口径，新代码一律用
 *  apiVoxMeetingAudioFiles；本函数仅存量下载链路未切完前保留。 */
export async function apiVoxMeetingAudioUrl(id: number): Promise<RequestResponse<IAppMeetingAudioUrlView>> {
  if (isVoxMockEnabled()) {
    return mockVoxMeetingAudioUrl(id);
  }
  const res = await request({ url: `/api/app/meetings/${id}/audio-url`, method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 录音分段列表（NW-269 新口径：items 按 segmentIndex 升序连播，播完一段取下一段地址）
 *  audioUrl 为预签名地址（24h 有效），勿持久化，每次进页面重新请求；
 *  total=1 即整场单文件（无卡现状，播放器无需特殊处理）；total=0 表示无音频。 */
export async function apiVoxMeetingAudioFiles(id: number, page: number, pageSize: number): Promise<RequestResponse<IAppMeetingAudioFilesView>> {
  if (isVoxMockEnabled()) {
    return mockVoxMeetingAudioFiles(id, page, pageSize);
  }
  return await requestVoxAudioFiles("meetings", id, page, pageSize);
}

/** 重新处理会议（对 ASR/总结失败的已结束会议异步重跑） */
export async function apiVoxMeetingReprocess(id: number): Promise<RequestResponse<IAppMeetingDetailView>> {
  if (isVoxMockEnabled()) {
    return mockVoxMeetingReprocess(id);
  }
  const res = await request({ url: `/api/app/meetings/${id}/reprocess`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}

/** 删除会议录音（POST /meetings/{id}/delete） */
export async function apiVoxMeetingDelete(id: number): Promise<VoidRequestResponse> {
  const res = await request({ url: `/api/app/meetings/${id}/delete`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}
