<template>
  <view class="tk-page">
    <!-- 隐藏 web-view：App 公式截图代理（imageDataURL + width/height） -->
    <web-view
      class="markdown-proxy-web"
      id="markdown-proxy-web"
      src="/uni_modules/uni-ai-x/static/proxy-web/proxy-web.html"
      @message="onProxyMsg"
    ></web-view>

    <view class="tk-header">
      <text class="tk-title">APP 数学公式渲染调试（App 专用）</text>
      <view class="tk-header-row">
        <text class="tk-sub">proxy: {{ proxyReady ? "就绪" : "未就绪" }}</text>
        <text class="tk-btn" @click="renderAll">重新渲染</text>
      </view>
      <text class="tk-tip">块级公式 = 最小高度渲染 + 超宽横滚 + 点击放大。每条标注 proxy 回传的自然宽高（用于调 katex-el 的 BLOCK_MIN_DISPLAY_HEIGHT）。</text>
    </view>

    <scroll-view class="tk-scroll" scroll-y="true">
      <!-- 1. 短块级（基线：不应被拉得过大） -->
      <view class="tk-case">
        <text class="tk-case-title">1. 短块级 $$E=mc^2$$（基线）</text>
        <scroll-view class="tk-math-scroll" scroll-x="true" scroll-y="false" @click="preview(block1.href)">
          <view class="tk-math-inner">
            <katex-el :html="block1.html" :href="block1.href" :width="block1.width" :height="block1.height" />
          </view>
        </scroll-view>
        <text class="tk-meta">natural {{ block1.width }} × {{ block1.height }}</text>
      </view>

      <!-- 2. 宽扁公式（重点：原 widthFix 压得很矮；现最小高度 + 横滚 + 点击放大） -->
      <view class="tk-case">
        <text class="tk-case-title">2. 宽扁长公式（应最小高度可读 / 超宽横滚 / 点击放大）</text>
        <scroll-view class="tk-math-scroll" scroll-x="true" scroll-y="false" @click="preview(block2.href)">
          <view class="tk-math-inner">
            <katex-el :html="block2.html" :href="block2.href" :width="block2.width" :height="block2.height" />
          </view>
        </scroll-view>
        <text class="tk-meta">natural {{ block2.width }} × {{ block2.height }}</text>
      </view>

      <!-- 3. 多行 aligned（确认高度足够、不截断） -->
      <view class="tk-case">
        <text class="tk-case-title">3. 多行 aligned（确认高度足够、不截断）</text>
        <scroll-view class="tk-math-scroll" scroll-x="true" scroll-y="false" @click="preview(block3.href)">
          <view class="tk-math-inner">
            <katex-el :html="block3.html" :href="block3.href" :width="block3.width" :height="block3.height" />
          </view>
        </scroll-view>
        <text class="tk-meta">natural {{ block3.width }} × {{ block3.height }}</text>
      </view>

      <!-- 4. 含中文块级 -->
      <view class="tk-case">
        <text class="tk-case-title">4. 含中文块级（T_resize 同款）</text>
        <scroll-view class="tk-math-scroll" scroll-x="true" scroll-y="false" @click="preview(block4.href)">
          <view class="tk-math-inner">
            <katex-el :html="block4.html" :href="block4.href" :width="block4.width" :height="block4.height" />
          </view>
        </scroll-view>
        <text class="tk-meta">natural {{ block4.width }} × {{ block4.height }}</text>
      </view>

      <!-- 5. 分数+上下标（内部结构） -->
      <view class="tk-case">
        <text class="tk-case-title">5. 分数 + 上下标（内部结构应正常）</text>
        <scroll-view class="tk-math-scroll" scroll-x="true" scroll-y="false" @click="preview(block5.href)">
          <view class="tk-math-inner">
            <katex-el :html="block5.html" :href="block5.href" :width="block5.width" :height="block5.height" />
          </view>
        </scroll-view>
        <text class="tk-meta">natural {{ block5.width }} × {{ block5.height }}</text>
      </view>

      <!-- 6. 行内混排（参考：App 生产环境已改为原文；此处仍用图片观察 flex 布局） -->
      <view class="tk-case">
        <text class="tk-case-title">6. 行内混排（参考 flex 布局；App 生产走原文）</text>
        <view class="tk-inline-row">
          <text class="tk-inline-text">设容量初始为 </text>
          <katex-el :html="inline1.html" :href="inline1.href" :width="inline1.width" :height="inline1.height" :inline="true" />
          <text class="tk-inline-text"> ，倍增因子为 2，则 </text>
          <katex-el :html="inline2.html" :href="inline2.href" :width="inline2.width" :height="inline2.height" :inline="true" />
          <text class="tk-inline-text"> 次插入。</text>
        </view>
        <text class="tk-meta">inline natural {{ inline1.width }}×{{ inline1.height }} / {{ inline2.width }}×{{ inline2.height }}</text>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts" setup>
import { onMounted, ref } from "vue";
import proxyWeb from "@/uni_modules/uni-ai-x/sdk/proxy-web.uts";

/** 一条公式的渲染产物（App: href 图片；H5: html v-html） */
class MathImg {
  href: string = ""
  width: number = 0
  height: number = 0
  html: string = ""
}

const proxyReady = ref(false)
const block1 = ref(new MathImg())
const block2 = ref(new MathImg())
const block3 = ref(new MathImg())
const block4 = ref(new MathImg())
const block5 = ref(new MathImg())
const inline1 = ref(new MathImg())
const inline2 = ref(new MathImg())

function onProxyMsg(e: UniWebViewMessageEvent) {
  proxyWeb.onWebMsg(e);
}

/** 调 proxy 渲染一条公式，回写 href/width/height/html */
function renderMath(latex: string, displayMode: boolean, target: Ref<MathImg>) {
  const param = new UTSJSONObject();
  param["action"] = "katexRender";
  param["pureMathText"] = latex;
  param["displayMode"] = displayMode;
  proxyWeb.callMethod(param, (res: UTSJSONObject): void => {
    const img = new MathImg();
    const href = res["imageDataURL"];
    const w = res["width"];
    const h = res["height"];
    const html = res["resultHtml"];
    img.href = href != null ? `${href}` : "";
    img.width = w != null ? (w as number) : 0;
    img.height = h != null ? (h as number) : 0;
    img.html = html != null ? `${html}` : "";
    target.value = img;
  });
}

function preview(href: string): void {
  if (href.length == 0) return;
  uni.previewImage({ urls: [href] });
}

function renderAll() {
  renderMath("E=mc^2", true, block1);
  // 宽扁长公式：原 widthFix 会被压得很矮
  renderMath(
    "f(x)=a_0+a_1x+a_2x^2+a_3x^3+a_4x^4+a_5x^5+a_6x^6+a_7x^7+a_8x^8+a_9x^9=\\sum_{n=0}^{9}a_n x^n",
    true,
    block2,
  );
  // 多行 aligned
  renderMath(
    "\\begin{aligned} \\frac{\\partial \\mathcal{L}}{\\partial \\theta} &= \\frac{1}{N}\\sum_{i=1}^{N} \\nabla_\\theta \\log p(y_i|x_i;\\theta) \\\\ &= \\frac{1}{N}\\sum_{i=1}^{N} \\frac{\\nabla_\\theta p(y_i|x_i;\\theta)}{p(y_i|x_i;\\theta)} \\end{aligned}",
    true,
    block3,
  );
  // 含中文
  renderMath(
    "T_{\\text{resize}}(n) = m + 2m + 4m + \\cdots + 2^{\\lfloor \\log_2(n/m) \\rfloor} m = O(n)",
    true,
    block4,
  );
  // 分数 + 上下标
  renderMath(
    "x = \\frac{-b \\pm \\sqrt{b^2-4ac}}{2a} + \\sum_{i=1}^{n} x_i^2",
    true,
    block5,
  );
  // 行内
  renderMath("m", false, inline1);
  renderMath("n/m", false, inline2);
}

onMounted(() => {
  // #ifndef WEB
  proxyWeb.ensureAppContext("markdown-proxy-web");
  // #endif
  // #ifdef WEB
  const el = document.getElementById("markdown-proxy-web");
  proxyWeb.init(el as any, "markdown-proxy-web");
  // #endif
  proxyWeb.whenReady((): void => {
    proxyReady.value = true;
    renderAll();
  });
});
</script>

<style lang="scss">
.tk-page {
  width: 100%;
  flex: 1;
  background-color: #f5f5f5;
  flex-direction: column;
}
.markdown-proxy-web {
  width: 0;
  height: 0;
  position: absolute;
  left: -9999px;
  top: -9999px;
}
.tk-header {
  padding: 24rpx;
  background-color: #fff;
  border-bottom: 1px solid #eee;
}
.tk-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}
.tk-header-row {
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
}
.tk-sub {
  font-size: 24rpx;
  color: #999;
  flex: 1;
}
.tk-btn {
  font-size: 26rpx;
  color: #fff;
  background-color: #5147ff;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
}
.tk-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}
.tk-scroll {
  flex: 1;
}
.tk-case {
  background-color: #fff;
  margin: 16rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 1px solid #eee;
}
.tk-case-title {
  font-size: 26rpx;
  color: #0066cc;
  margin-bottom: 16rpx;
}
/* 与生产一致：scroll-view 横滚 + inner 居中 */
.tk-math-scroll {
  width: 100%;
  flex-direction: row;
  background-color: #fff;
}
.tk-math-inner {
  min-width: 100%;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.tk-meta {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}
.tk-inline-row {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}
.tk-inline-text {
  font-size: 32rpx;
  color: #404040;
}
</style>
