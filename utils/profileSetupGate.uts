/**
 * 「登录后才做新用户引导判定」的一次性闸门（storage 布尔标记）。
 *
 * 置位：authSession.saveAccessToken 在 token 变化（= 登录/换号成功）时写入——
 *       覆盖密码/验证码/微信/弹窗登录全部路径，登录页代码零改动。
 * 清除：① App onLaunch（冷启动一律视为「不是刚登录」，不弹）；
 *       ② 引导判定完成（拿到用户信息、无论弹否，profileSetupPrompt 消费）。
 *       拉取失败不清——下次 onShow 重试。
 *
 * 独立成最小模块（不 import authSession/servers）是刻意的：authSession 要
 * 依赖它置位，若反向依赖会成环。
 */

const PROFILE_SETUP_PENDING_KEY = "profile_setup_pending";

/** 登录成功路径调用（saveAccessToken 内 token 变化时）。存字符串：与读侧模板串比对同型，避开 number 装箱差异。 */
export function markLoginCheckPending(): void {
  uni.setStorageSync(PROFILE_SETUP_PENDING_KEY, "1");
}

/** 是否有待做的引导判定（只读不清）。 */
export function peekLoginCheckPending(): boolean {
  const raw = uni.getStorageSync(PROFILE_SETUP_PENDING_KEY);
  return raw != null && `${raw}` == "1";
}

/** 清除待判定标记（冷启动 / 判定完成）。 */
export function clearLoginCheckPending(): void {
  uni.removeStorageSync(PROFILE_SETUP_PENDING_KEY);
}
