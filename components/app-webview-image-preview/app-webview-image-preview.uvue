<template>
  <!-- App 内嵌 H5：自绘全屏预览，对齐 uni.previewImage（计数 + 左右滑切图 + 点击关闭）。
       系统返回 / 边缘侧滑走 popupBackRegistry，只关预览不退出聊天。 -->
  <view
    v-if="visible"
    class="app-wv-image-preview"
    @tap="onOverlayTap"
    @touchstart="onTouchStart"
    @touchmove.stop.prevent="onTouchMove"
    @touchend="onTouchEnd"
  >
    <text v-if="showIndicator" class="app-wv-image-preview__indicator">
      {{ indicatorText }}
    </text>
    <!-- 与正文 mp-html 一样用原生 img：Android 上 uni <image> 会把 /api 解析到 /m/api 且不带 Cookie -->
    <img
      class="app-wv-image-preview__img"
      :src="currentUrl"
      @tap.stop="onOverlayTap"
      @touchstart="onTouchStart"
      @touchmove.stop.prevent="onTouchMove"
      @touchend="onTouchEnd"
    />
  </view>
</template>

<script setup lang="uts">
  import { computed, onUnmounted, ref, watch } from "vue";
  import {
    installAppWebViewImagePreviewHook,
    setAppWebViewImagePreviewHost,
    uninstallAppWebViewImagePreviewHook,
  } from "@/utils/appWebViewImagePreview.uts";
  import {
    registerBackInterceptionGlobals,
    registerPopupClose,
    unregisterPopupClose,
  } from "@/utils/popupBackRegistry";

  const visible = ref<boolean>(false);
  const previewUrls = ref<string[]>([] as string[]);
  const currentIndex = ref<number>(0);
  let popupRegistryId: number = 0;
  let touchStartX: number = 0;
  let touchStartY: number = 0;
  let didSwipe: boolean = false;
  const SWIPE_THRESHOLD: number = 50;

  const currentUrl = computed((): string => {
    const list = previewUrls.value;
    const idx = currentIndex.value;
    if (idx >= 0 && idx < list.length) {
      return list[idx];
    }
    return "";
  });

  const showIndicator = computed((): boolean => {
    return previewUrls.value.length > 0;
  });

  const indicatorText = computed((): string => {
    const total = previewUrls.value.length;
    if (total == 0) {
      return "";
    }
    return `${currentIndex.value + 1} / ${total}`;
  });

  const close = (): void => {
    visible.value = false;
  };

  const onOverlayTap = (): void => {
    if (didSwipe == true) {
      didSwipe = false;
      return;
    }
    close();
  };

  const openPreview = (urls: string[], current: string): void => {
    const list: string[] = [] as string[];
    const urlLen = urls.length;
    for (let i = 0; i < urlLen; i++) {
      const item = urls[i];
      if (item != null && item.length > 0) {
        list.push(item);
      }
    }
    if (list.length == 0 && current.length > 0) {
      list.push(current);
    }
    let idx = 0;
    if (current.length > 0) {
      for (let i = 0; i < list.length; i++) {
        if (list[i] == current) {
          idx = i;
          break;
        }
      }
    }
    didSwipe = false;
    previewUrls.value = list;
    currentIndex.value = idx;
    visible.value = true;
  };

  const onTouchStart = (e: UniTouchEvent): void => {
    if (e == null || e.touches == null || e.touches.length == 0) {
      return;
    }
    didSwipe = false;
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  };

  const onTouchMove = (e: UniTouchEvent): void => {
    if (e == null || e.touches == null || e.touches.length == 0) {
      return;
    }
    const dx = Math.abs(e.touches[0].clientX - touchStartX);
    const dy = Math.abs(e.touches[0].clientY - touchStartY);
    if (dx > dy && dx > 10) {
      didSwipe = true;
    }
  };

  const onTouchEnd = (e: UniTouchEvent): void => {
    if (
      e == null ||
      e.changedTouches == null ||
      e.changedTouches.length == 0
    ) {
      return;
    }
    const touch = e.changedTouches[0];
    const deltaX = touch.clientX - touchStartX;
    const deltaY = touch.clientY - touchStartY;
    if (Math.abs(deltaX) <= SWIPE_THRESHOLD) {
      return;
    }
    if (Math.abs(deltaX) <= Math.abs(deltaY)) {
      return;
    }
    didSwipe = true;
    const total = previewUrls.value.length;
    if (total <= 1) {
      return;
    }
    const idx = currentIndex.value;
    if (deltaX < 0) {
      if (idx < total - 1) {
        currentIndex.value = idx + 1;
      }
      return;
    }
    if (idx > 0) {
      currentIndex.value = idx - 1;
    }
  };

  registerBackInterceptionGlobals();
  setAppWebViewImagePreviewHost(openPreview);
  installAppWebViewImagePreviewHook();
  watch(
    visible,
    (val: boolean) => {
      if (val == true) {
        if (popupRegistryId == 0) {
          popupRegistryId = registerPopupClose(close);
        }
      } else if (popupRegistryId != 0) {
        unregisterPopupClose(popupRegistryId);
        popupRegistryId = 0;
      }
    },
    { immediate: true },
  );

  onUnmounted(() => {
    setAppWebViewImagePreviewHost(null);
    uninstallAppWebViewImagePreviewHook();
    if (popupRegistryId != 0) {
      unregisterPopupClose(popupRegistryId);
      popupRegistryId = 0;
    }
    visible.value = false;
  });
</script>

<style lang="scss" scoped>
  .app-wv-image-preview {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 10050;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    /* #ifdef H5 */
    touch-action: none;
    /* #endif */
  }

  .app-wv-image-preview__indicator {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding-top: calc(24rpx + env(safe-area-inset-top, 0px));
    text-align: center;
    color: #ffffff;
    font-size: 28rpx;
    line-height: 40rpx;
    z-index: 1;
    pointer-events: none;
  }

  .app-wv-image-preview__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
