<template>
  <view class="provision-wifi">
    <custom-nav-bar :title="t('Mobile.Provision.Wifi.title')" :show-back="true" :has-safety-zone="true" />

    <scroll-view class="provision-wifi__scroll" :scroll-y="true" :scroll-into-view="scrollTarget">
      <view class="provision-wifi__inner">
      <!-- 目标设备 -->
      <view v-if="deviceName != ''" class="provision-wifi__device">
        <text class="provision-wifi__device-name">{{ deviceName }}</text>
      </view>

      <!-- 重配提示 -->
      <text v-if="isReprovision" class="provision-wifi__reprovision-tip">{{ t('Mobile.Provision.Wifi.reprovisionTip') }}</text>

      <!-- 设备发现的 WiFi 列表 -->
      <view v-if="showDeviceNetworks" class="network-section">
        <text class="network-section__label">{{ t('Mobile.Provision.Wifi.selectWifi') }}</text>
        <view v-if="networksLoading" class="network-loading">
          <view class="network-loading__dot"></view>
          <text class="network-loading__text">{{ t('Mobile.Provision.Wifi.scanning') }}</text>
        </view>
        <view v-else-if="networkState == 'error'" class="network-loading">
          <text class="network-loading__text">{{ t('Mobile.Provision.Wifi.scanFailed') }}</text>
          <view class="network-loading__retry" @tap="retryNetworkScan">
            <text class="network-loading__retry-text">{{ t('Mobile.Provision.Wifi.scanRetry') }}</text>
          </view>
        </view>
        <view v-else-if="networkState == 'empty'" class="network-loading">
          <text class="network-loading__text">{{ t('Mobile.Provision.Wifi.noNetworks') }}</text>
        </view>
        <template v-else>
          <view
            v-for="network in deviceNetworks"
            :key="network.ssid"
            :id="'wifi-' + network.ssid"
            :class="['network-item', selectedSsid == network.ssid ? 'network-item--selected' : '']"
            hover-class="network-item--hover"
            @tap="selectNetwork(network)"
          >
            <view class="network-item__row">
              <view class="network-item__info">
                <text class="network-item__ssid">{{ network.ssid }}</text>
                <view class="network-item__meta">
                  <text v-if="network.security != 0" class="network-item__lock">🔒</text>
                  <text :class="['network-item__rssi', network.rssi < -70 ? 'network-item__rssi--weak' : '']">
                    {{ network.rssi < -70 ? t('Mobile.Provision.Scan.signalWeak') : '📶' }}
                  </text>
                </view>
              </view>
              <view v-if="selectedSsid == network.ssid" class="network-item__check">
                <text class="network-item__check-icon">✓</text>
              </view>
            </view>

            <!-- 选中后密码输入就地内联展开在该项下方 -->
            <view v-if="selectedSsid == network.ssid" class="network-item__pwd" @tap.stop="">
              <view class="network-item__pwd-box">
                <input
                  class="network-item__pwd-input"
                  v-model="password"
                  :password="!showPassword"
                  :placeholder="t('Mobile.Provision.Wifi.passwordPlaceholder')"
                  placeholder-class="network-item__pwd-placeholder"
                  :focus="pwdFocus"
                  confirm-type="done"
                  @confirm="startProvision"
                />
                <text class="network-item__pwd-eye" @tap.stop="showPassword = !showPassword">{{ showPassword ? '🙈' : '👁' }}</text>
              </view>
              <text v-if="errorTip != ''" class="network-item__pwd-error">{{ errorTip }}</text>
            </view>
          </view>
        </template>
      </view>

      <!-- 手动输入区（无设备列表或用户选择手动时显示） -->
      <view v-if="!showDeviceNetworks" class="form">
        <view class="form__field">
          <text class="form__label">{{ t('Mobile.Provision.Wifi.ssidLabel') }}</text>
          <input
            class="form__input"
            v-model="ssid"
            :placeholder="t('Mobile.Provision.Wifi.ssidPlaceholder')"
            placeholder-class="form__placeholder"
          />
        </view>

        <view class="form__field">
          <text class="form__label">{{ t('Mobile.Provision.Wifi.passwordLabel') }}</text>
          <view class="form__pwd">
            <input
              class="form__input form__input--pwd"
              v-model="password"
              :password="!showPassword"
              :placeholder="t('Mobile.Provision.Wifi.passwordPlaceholder')"
              placeholder-class="form__placeholder"
            />
            <text class="form__eye" @tap="showPassword = !showPassword">{{ showPassword ? '🙈' : '👁' }}</text>
          </view>
        </view>

        <!-- 使用当前 WiFi -->
        <view class="form__current" @tap="useCurrentWifi">
          <text class="form__current-text">{{ t('Mobile.Provision.Wifi.useCurrent') }}</text>
        </view>

        <text v-if="currentFailed" class="form__warn">{{ t('Mobile.Provision.Wifi.currentFailed') }}</text>
      </view>

      <!-- 手动输入切换链接（有设备列表且扫描完成时显示；扫描中不露，引导等列表） -->
      <view v-if="showDeviceNetworks && !networksLoading && selectedSsid == ''" class="manual-link" @tap="switchToManual">
        <text class="manual-link__text">{{ t('Mobile.Provision.Wifi.manualInput') }}</text>
      </view>

      <text class="form__band-tip">{{ t('Mobile.Provision.Wifi.bandTip') }}</text>
      <text v-if="!showDeviceNetworks && errorTip != ''" class="form__error">{{ errorTip }}</text>
      </view>
    </scroll-view>

    <!-- 开始配网（固定底部，不随列表滚动） -->
    <view class="provision-wifi__footer">
      <view
        :class="['provision-wifi__start', !canStart ? 'provision-wifi__start--disabled' : '']"
        hover-class="provision-wifi__start--hover"
        @tap="startProvision"
      >
        <text class="provision-wifi__start-text">{{ submitting ? t('Mobile.Provision.Wifi.submitting') : t('Mobile.Provision.Wifi.start') }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { ref, computed } from "vue";
  import { onLoad, onShow, onUnload } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { getProvisionDevice, setProvisionCredentials, getReprovisionTarget, clearProvisionSession } from "@/utils/provisionSession";
  import { WifiCredentials } from "@/types/interfaces/provision";
  import { getCurrentWifiSsid } from "@/utils/wifiInfo";
  import { validateSsid, validatePassword } from "@/utils/provisionProtocol";
  import { useEspProvisioning, releaseEspProvisioning } from "@/hooks/useEspProvisioning";
  import { EspWifiNetwork } from "@/types/interfaces/espProvisioning";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const controller = useEspProvisioning();

  const ssid = ref<string>("");
  const password = ref<string>("");
  const showPassword = ref<boolean>(false);
  const currentFailed = ref<boolean>(false);
  const errorTip = ref<string>("");
  const deviceName = ref<string>("");
  const isReprovision = ref<boolean>(false);

  // 设备端 WiFi 列表
  const deviceNetworks = ref<EspWifiNetwork[]>([]);
  const networksLoading = ref<boolean>(true);
  const selectedSsid = ref<string>("");
  // 选中后滚动目标（该项卡片）+ 密码框自动聚焦
  const scrollTarget = ref<string>("");
  const pwdFocus = ref<boolean>(false);
  const forceManual = ref<boolean>(false);
  const networkState = ref<string>("loading"); // loading | ready | empty | error | unsupported
  const submitting = ref<boolean>(false);
  // 设备端扫描/配网串行锁：开始配网前必须等当前 prov-scan 释放（契约 §5，不得并发）
  const scanPromise = ref<Promise<void> | null>(null);

  // 有设备列表、或正在扫描（展示 loading，避免先露出手动输入）、且未强制手动时，显示设备列表区
  const showDeviceNetworks = computed((): boolean => {
    return !forceManual.value && networkState.value != "unsupported";
  });

  const canStart = computed((): boolean => {
    if (submitting.value || networksLoading.value || networkState.value == "error" || networkState.value == "empty") return false;
    if (showDeviceNetworks.value) {
      return selectedSsid.value != "" && validatePassword(password.value);
    }
    return ssid.value.trim().length > 0 && validatePassword(password.value);
  });

  const loadDeviceNetworks = async () => {
    networksLoading.value = true;
    networkState.value = "loading";
    const caps = controller.capabilities.value;
    if (caps == null || !caps.has("wifi_scan")) {
      networksLoading.value = false;
      networkState.value = "unsupported";
      return;
    }
    try {
      const list = await controller.scanDeviceNetworks();
      // 过滤空 SSID，按信号降序
      const filtered: EspWifiNetwork[] = [];
      for (let i = 0; i < list.length; i++) {
        if (list[i].ssid.trim() != "") {
          filtered.push(list[i]);
        }
      }
      filtered.sort((a: EspWifiNetwork, b: EspWifiNetwork): number => b.rssi - a.rssi);
      deviceNetworks.value = filtered;
      networkState.value = controller.error.value != null ? "error" : (filtered.length > 0 ? "ready" : "empty");
    } catch (e) {
      console.error("loadDeviceNetworks error", e);
      deviceNetworks.value = [];
      networkState.value = "error";
    } finally {
      networksLoading.value = false;
    }
  };

  const retryNetworkScan = () => {
    if (networksLoading.value) return;
    scanPromise.value = loadDeviceNetworks();
  };

  const selectNetwork = (network: EspWifiNetwork) => {
    // 再次点击已选中项：收起密码框
    if (selectedSsid.value == network.ssid) {
      selectedSsid.value = "";
      pwdFocus.value = false;
      errorTip.value = "";
      return;
    }
    selectedSsid.value = network.ssid;
    ssid.value = "";
    errorTip.value = "";
    // 滚动到该项（展开后输入框在卡片内部，滚到卡片即可见）
    scrollTarget.value = "";
    setTimeout(() => {
      scrollTarget.value = `wifi-${network.ssid}`;
    }, 30);
    // 展开后自动聚焦密码框，直接弹起键盘
    pwdFocus.value = false;
    setTimeout(() => {
      pwdFocus.value = true;
    }, 260);
  };

  const switchToManual = () => {
    forceManual.value = true;
    selectedSsid.value = "";
    pwdFocus.value = false;
    ssid.value = "";
    errorTip.value = "";
  };

  const useCurrentWifi = async () => {
    currentFailed.value = false;
    const current = await getCurrentWifiSsid();
    if (current != "") {
      ssid.value = current;
    } else {
      currentFailed.value = true;
    }
  };

  const startProvision = async () => {
    if (submitting.value) return;
    errorTip.value = "";
    // 契约 §5：prov-scan 与配网不得并发，开始配网前等当前扫描释放
    const pendingScan = scanPromise.value;
    if (networksLoading.value && pendingScan != null) {
      await pendingScan;
    }
    const finalSsid = showDeviceNetworks.value && selectedSsid.value != "" ? selectedSsid.value : ssid.value.trim();
    if (!validateSsid(finalSsid)) {
      errorTip.value = t("Mobile.Provision.Wifi.ssidInvalid");
      return;
    }
    if (!validatePassword(password.value)) {
      errorTip.value = t("Mobile.Provision.Wifi.passwordInvalid");
      return;
    }
    submitting.value = true;
    // 凭据经内存态传递（不走 URL query）
    setProvisionCredentials(new WifiCredentials(finalSsid, password.value));
    uni.navigateTo({
      url: "/subpackages/pages/provision/provision-progress/provision-progress",
      fail: () => {
        submitting.value = false;
      },
    });
  };

  onLoad((_options: OnLoadOptions) => {
    const device = getProvisionDevice();
    // 扫码链路 session 无 device，从 controller 的 deviceInfo 取 serialNumber
    if (device != null) {
      deviceName.value = device.name != "" ? device.name : device.deviceId;
    } else {
      const info = controller.deviceInfo.value;
      deviceName.value = info != null && info.productModel != "" ? info.productModel : (info != null ? info.serialNumber : "");
    }
    isReprovision.value = getReprovisionTarget() != null;
    // 重配场景不预填当前 WiFi（让用户从设备列表选新的）
    if (!isReprovision.value) {
      useCurrentWifi();
    }
    scanPromise.value = loadDeviceNetworks();
  });

  onShow(() => {
    submitting.value = false;
  });

  onUnload(() => {
    // 正常 navigateTo progress 时本页仍在栈中，不触发 unload；用户返回入口时在此释放旧 GATT。
    releaseEspProvisioning();
    clearProvisionSession();
  });
</script>

<style lang="scss" scoped>
  .provision-wifi {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;

    &__scroll {
      flex: 1;
    }

    &__inner {
      display: flex;
      flex-direction: column;
      padding: 32rpx;
    }

    &__device {
      margin-bottom: 24rpx;
    }

    &__device-name {
      font-size: 26rpx;
      color: #999;
    }

    &__reprovision-tip {
      font-size: 26rpx;
      color: #5147ff;
      background-color: rgba(81, 71, 255, 0.08);
      border-radius: 12rpx;
      padding: 20rpx 24rpx;
      margin-bottom: 24rpx;
      text-align: center;
    }

    &__footer {
      padding: 24rpx 32rpx 64rpx;
      background-color: #f8f8f8;
    }

    &__start {
      background-color: #5147ff;
      border-radius: 48rpx;
      padding: 28rpx 0;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.2s ease, transform 0.15s ease;

      &--disabled {
        opacity: 0.4;
      }

      &--hover {
        opacity: 0.85;
        transform: scale(0.98);
      }
    }

    &__start-text {
      color: #ffffff;
      font-size: 32rpx;
      font-weight: 500;
    }
  }

  .network-section {
    margin-bottom: 24rpx;

    &__label {
      font-size: 26rpx;
      color: #999;
      margin-bottom: 16rpx;
      display: flex;
    }
  }

  .network-loading {
    background-color: #ffffff;
    border-radius: 20rpx;
    padding: 60rpx 32rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;

    &__dot {
      width: 16rpx;
      height: 16rpx;
      border-radius: 50%;
      background-color: #5147ff;
      margin-right: 16rpx;
}

    &__text {
      font-size: 28rpx;
      color: #999;
    }

    &__retry {
      margin-left: 20rpx;
      padding: 12rpx 20rpx;
      border-radius: 28rpx;
      background-color: rgba(81, 71, 255, 0.1);
    }

    &__retry-text {
      color: #5147ff;
      font-size: 26rpx;
    }
  }

  

  .network-item {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    border-radius: 16rpx;
    padding: 28rpx 32rpx;
    margin-bottom: 16rpx;
    border: 2rpx solid transparent;
    transition: border-color 0.2s ease, background-color 0.2s ease;

    &--hover {
      background-color: #f5f5f5;
    }

    &--selected {
      border-color: #5147ff;
      background-color: rgba(81, 71, 255, 0.04);
    }

    &__row {
      display: flex;
      flex-direction: row;
      align-items: center;
    }

    &__info {
      flex: 1;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    &__ssid {
      font-size: 30rpx;
      color: #1a1a1a;
      font-weight: 500;
    }

    &__meta {
      display: flex;
      flex-direction: row;
      align-items: center;
    }

    &__lock {
      font-size: 24rpx;
      margin-right: 12rpx;
    }

    &__rssi {
      font-size: 24rpx;
      color: #4cd964;

      &--weak {
        color: #f0ad4e;
      }
    }

    &__check {
      width: 40rpx;
      height: 40rpx;
      border-radius: 50%;
      background-color: #5147ff;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-left: 16rpx;
    }

    &__check-icon {
      color: #ffffff;
      font-size: 24rpx;
    }

    /* 内联展开的密码输入区 */
    &__pwd {
      margin-top: 24rpx;
      padding-top: 24rpx;
      border-top: 1rpx solid #eeeeee;
}

    &__pwd-box {
      display: flex;
      flex-direction: row;
      align-items: center;
      height: 80rpx;
      border-bottom: 1rpx solid #e0e0e0;
    }

    &__pwd-input {
      flex: 1;
      font-size: 32rpx;
      color: #333;
      height: 80rpx;
    }

    &__pwd-placeholder {
      color: #c0c0c0;
      font-size: 32rpx;
    }

    &__pwd-eye {
      font-size: 32rpx;
      padding: 0 8rpx;
    }

    &__pwd-error {
      font-size: 24rpx;
      color: #dd524d;
      margin-top: 12rpx;
      display: flex;
    }
  }

  

  .manual-link {
    padding: 24rpx 0;
    display: flex;
    align-items: center;
    justify-content: center;

    &__text {
      font-size: 26rpx;
      color: #5147ff;
    }
  }

  .form {
    background-color: #ffffff;
    border-radius: 20rpx;
    padding: 32rpx;

    &--inline {
      margin-top: 16rpx;
    }

    &__field {
      margin-bottom: 32rpx;

      &:last-child {
        margin-bottom: 0;
      }
    }

    &__label {
      font-size: 26rpx;
      color: #999;
      margin-bottom: 16rpx;
      display: flex;
    }

    &__input {
      font-size: 32rpx;
      color: #333;
      height: 72rpx;
      border-bottom: 1rpx solid #eee;

      &--pwd {
        flex: 1;
        border-bottom: none;
      }
    }

    &__placeholder {
      color: #c0c0c0;
      font-size: 32rpx;
    }

    &__pwd {
      display: flex;
      flex-direction: row;
      align-items: center;
      border-bottom: 1rpx solid #eee;
      height: 72rpx;
    }

    &__eye {
      font-size: 32rpx;
      padding: 0 8rpx;
    }

    &__current {
      margin-top: 24rpx;
    }

    &__current-text {
      font-size: 26rpx;
      color: #5147ff;
    }

    &__warn {
      font-size: 24rpx;
      color: #f0ad4e;
      margin-top: 16rpx;
      display: flex;
    }

    &__band-tip {
      font-size: 24rpx;
      color: #999;
      margin-top: 24rpx;
      line-height: 1.5;
      display: flex;
    }

    &__error {
      font-size: 26rpx;
      color: #dd524d;
      margin-top: 16rpx;
      display: flex;
    }
  }
</style>
