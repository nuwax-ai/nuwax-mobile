import { getImSessionStamp } from "./imSessionScope";
import { ImMergeItem } from "@/types/interfaces/imMergeItem";

/**
 * 合并转发聊天记录详情暂存（chat.uvue → merge-forward-detail 页的跨页数据传递）。
 *
 * 记录载荷（title + 全量 items）远超 URL query 承载量，eventBus 又是即发即逝
 * （详情页 onLoad 晚于 emit 就丢帧），同 imForwardSession 用模块级暂存：
 * chat.uvue set 后 uni.navigateTo，详情页 onLoad take（取出即清，返回重进
 * 不会拿到上一次的旧载荷）。
 */

/** 一次记录查看会话：标题 + 全量条目。 */
export class ImMergeRecordSession {
  /** 记录标题（body.title 原样；空由详情页兜底「聊天记录」）。 */
  title: string = "";
  /** 全量条目（body.items 已归一：senderName + sendTime + preview）。 */
  items: ImMergeItem[] = [];
}

let mergeRecordStamp = "";
let mergeRecordSession: ImMergeRecordSession | null = null;

/** 写入记录载荷并跳转详情页（调用方已保证 items 非空）。 */
export function openImMergeRecord(session: ImMergeRecordSession): void {
  mergeRecordStamp = getImSessionStamp();
  mergeRecordSession = session;
  uni.navigateTo({ url: "/pages/message/merge-forward-detail" });
}

/** 详情页 onLoad 取载荷（一次性：取出即清空）。 */
export function takeImMergeRecord(): ImMergeRecordSession | null {
  const s = mergeRecordStamp == getImSessionStamp() ? mergeRecordSession : null;
  mergeRecordSession = null;
  return s;
}

export function clearImMergeRecord(): void {
  mergeRecordSession = null;
}
