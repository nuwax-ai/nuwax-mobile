<template>
  <!--
    项目/任务抽屉（App v3 新交互）：左滑抽屉承载「项目」分组 +「任务」（会话历史）列表。
    容器复用 uni-modal-popup position=left（滑入动画/遮罩/Android 返回拦截，
    与 app-details 历史会话抽屉同款）。
    职责边界：本组件 = 抽屉容器（滚动/下拉刷新/生命周期）+ 项目分组业务；
    任务（会话历史）列表为独立可复用组件 conversation-history-list，
    由本组件在其 scroll-view 内组装，触底/下拉/静默刷新经 expose 入口触发。
    设计稿（2026-09-21）：项目行 = 名称 + 类型标签 + ＋（无文件夹图标）；子会话行 = 状态点 + 名称 + 相对时间；
    任务行 = 状态角标 + 标题 + 相对时间；区头无计数。
    项目列表为完整接口（2026-09-21 契约，对齐 PC toProjectItem）：回包行自带
    conversations 直接映射子会话，展开/收起为纯本地切换，无逐项目会话补拉。
  -->
  <uni-modal-popup
    ref="popupRef"
    position="left"
    width="85%"
    :internal-side-overlay="true"
    :show-header="false"
    :body-scroll="false"
    @update-visible="handlePopupVisible"
  >
    <view class="drawer-wrap">
      <!-- 全端主路径（09-21 起 Android/鸿蒙并入）：scroll-view + @scroll + 顶部浮动吸顶头。
           原 Android list-view + sticky-section 路径废弃——引擎在首帧布局后向前序 section
           增删/改动单元格时内容流错乱（项目区整区渲染到任务区后，真机两轮复现）；
           iOS 避 list-view 复用丢行高、微信无 sticky 组件、H5 list-view 图标渲染不完整（09-16）。
           至此全端统一走官方复杂列表指南方案。 -->
      <scroll-view
        v-if="listMounted"
        :key="listKey"
        id="drawer-sticky-scroll"
        class="drawer-scroll"
        direction="vertical"
        :show-scrollbar="false"
        :refresher-enabled="true"
        :refresher-triggered="refreshing"
        @scroll="handleStickyScroll"
        @scrolltolower="handleScrollTolower"
        @refresherrefresh="handleRefresh"
        @refresherrestore="resetRefresher"
        @refresherabort="resetRefresher"
      >
        <view id="project-section-header" class="section-header" @click="toggleProjectSection">
          <view class="header-title-row">
            <text class="section-title-text">{{ sectionProjectTitle }}</text>
            <svg-icon
              :name="projectSectionCollapsed ? 'icon-a-Chevronright' : 'icon-a-Chevrondown'"
              size="24"
              color="#8b8e96"
              customClass="section-arrow"
            />
            <!-- 全部展开/收起项目下会话（对齐 PC section-tool：上下双 chevron 图标按钮） -->
            <view
              v-if="projectToggleAllVisible"
              class="header-toggle-all-btn"
              @click.stop="toggleAllProjectChildren"
            >
              <view class="toggle-all-chevrons">
                <svg-icon name="icon-a-Chevronup" size="20" color="#8b8e96" />
                <svg-icon name="icon-a-Chevrondown" size="20" color="#8b8e96" />
              </view>
            </view>
          </view>
          <view class="header-search-btn" @click.stop="handleSearch">
            <svg-icon name="icon-Search" size="40" />
          </view>
        </view>
        <template v-if="!projectSectionCollapsed && visibleProjectGroups.length > 0">
          <view v-for="group in visibleProjectGroups" :key="group.id" class="project-block">
            <view
              class="project-row"
              @click="toggleProjectExpand(group.id)"
              @longpress="handleProjectLongPress(group.id)"
            >
              <image v-if="group.pinned" :src="pinIcon" class="project-flag-image" mode="aspectFit" />
              <image v-if="!group.owner" :src="teamIcon" class="project-team-image" mode="aspectFit" />
              <text class="project-name">
                {{ group.name }}
              </text>
              <!-- 类型标签（2026-09-21 设计稿恢复展示：常规项目/网页应用/全栈项目；未知类型文案为空串不渲染） -->
              <text v-if="projectTypeTag(group.projectType).length > 0" class="project-type-tag">{{ projectTypeTag(group.projectType) }}</text>
              <view class="project-row-flex" />
              <view class="project-add-btn" @click.stop="handleAddConversation(group.id)">
                <text class="project-add-icon">＋</text>
              </view>
            </view>
            <view v-if="group.expanded">
              <view
                v-for="child in group.children"
                :key="child.id"
                class="project-child-row"
                @click="handleProjectChildClick(group.id, child.id)"
                @longpress="handleProjectChildLongPress(group.id, child.id)"
              >
                <!-- 状态点仅在有状态时占位（对齐设计稿：无状态子项与项目名左对齐） -->
                <view v-if="child.taskStatus == 'EXECUTING' || child.taskStatus == 'FAILED'" class="child-status">
                  <svg-icon v-if="child.taskStatus == 'EXECUTING'" name="icon-Loader" size="24" color="#8b8e96" customClass="status-running" />
                  <svg-icon v-else name="icon-waring" size="24" color="#e54d4d" />
                </view>
                <text class="child-name">{{ child.name }}</text>
                <text class="child-time">{{ child.timeLabel }}</text>
              </view>
              <!-- 子会话随列表回包（完整接口契约）：无会话仅显示空态文案，无在途/失败态 -->
              <view v-if="group.children.length == 0" class="project-child-empty">
                <text class="project-child-empty-text">{{ t("Mobile.Project.noConversation") }}</text>
              </view>
            </view>
          </view>
        </template>
        <view v-else-if="!projectSectionCollapsed && !projectLoading" class="empty-state">
          <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
          <text class="empty-text">{{ t("Mobile.Conversation.projectEmpty") }}</text>
        </view>
        <!-- #ifndef H5 || WEB -->
        <!-- 项目区「查看更多」入口（09-21 非 H5 端需求，对齐 PC load-more-entry）：
             H5 沿触底加载保持现状，不展示入口 -->
        <view
          v-if="!projectSectionCollapsed && projectLoadMoreVisible"
          class="project-load-more"
          @click="handleProjectLoadMore"
        >
          <text class="project-load-more-text">{{ projectLoadMoreText }}</text>
        </view>
        <!-- #endif -->

        <view id="task-section-header" class="section-header task-section-header" @click="toggleTaskSection">
          <view class="header-title-row">
            <text class="section-title-text">{{ sectionTaskTitle }}</text>
            <svg-icon
              :name="taskSectionCollapsed ? 'icon-a-Chevronright' : 'icon-a-Chevrondown'"
              size="24"
              color="#8b8e96"
              customClass="section-arrow"
            />
          </view>
        </view>
        <!-- 折叠用 v-show 不用 v-if：组件实例持有已加载数据，v-if 销毁重建会清空
             conversationList 且 loadIfEmpty 不会再触发（首载仅抽屉打开时调）→ 永久空态 -->
        <conversation-history-list
          v-show="!taskSectionCollapsed"
          ref="taskListRef"
          :is-logged-in="isLoggedIn"
          @conversation-click="relayConversationClick"
          @count-change="handleTaskCountChange"
        />
      </scroll-view>
      <!-- 浮动吸顶头：钉在滚动区顶部，任务区到达后顶替项目头（对齐 PC 互顶行为）；点击同样折叠/展开当前分组 -->
      <view v-if="showFloatingHeader" class="floating-section-header">
        <view
          class="section-header"
          @click="floatingHeaderKey == 'task' ? toggleTaskSection() : toggleProjectSection()"
        >
          <view class="header-title-row">
            <text class="section-title-text">{{ floatingHeaderTitle }}</text>
            <svg-icon
              :name="floatingCollapsed ? 'icon-a-Chevronright' : 'icon-a-Chevrondown'"
              size="24"
              color="#8b8e96"
              customClass="section-arrow"
            />
            <!-- 吸顶浮头与自然位同款「全部展开/收起」入口 -->
            <view
              v-if="floatingHeaderKey != 'task' && projectToggleAllVisible"
              class="header-toggle-all-btn"
              @click.stop="toggleAllProjectChildren"
            >
              <view class="toggle-all-chevrons">
                <svg-icon name="icon-a-Chevronup" size="20" color="#8b8e96" />
                <svg-icon name="icon-a-Chevrondown" size="20" color="#8b8e96" />
              </view>
            </view>
          </view>
          <view v-if="floatingHeaderKey != 'task'" class="header-search-btn" @click.stop="handleSearch">
            <svg-icon name="icon-Search" size="40" />
          </view>
        </view>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, computed, watch, nextTick, onMounted, onUnmounted, getCurrentInstance, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import ConversationHistoryList from "@/components/conversation-history-list/conversation-history-list.uvue";
  import { SUCCESS_CODE } from "@/constants/codes.constants.uts";
  import eventBus from "@/utils/eventBus";
  import { EVENT_TYPE } from "@/constants/event.constants";
  import {
    apiAgentConversationUpdate,
    apiAgentConversationDelete,
  } from "@/servers/conversation";
  import { AgentConversationUpdateParams } from "@/types/interfaces/agent";
  import { PinnedProjectInfo } from "@/types/interfaces/displayRecommend";
  import {
    apiUserProjectTabPageQuery,
    apiNormalProjectUpdate,
    apiUserProjectDelete,
    apiUserAppUpdate,
    apiUserAppDelete,
    apiUserProjectPin,
    apiUserProjectArchive,
    apiUserProjectCollect,
    apiUserProjectUnCollect,
  } from "@/servers/project";
  import {
    UserProjectUpdateParams,
    UserAppUpdateParams,
  } from "@/types/interfaces/projectInfo";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { formatListTimeAgo, getCurrentPagePath } from "@/utils/common";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { clearConversationFlags } from "@/utils/conversationLocalFlags.uts";
  import { clearProjectFlags } from "@/utils/projectLocalFlags.uts";
  import { migrateProjectFavorites } from "@/utils/favoritesMigration.uts";
  import {
    ProjectChildView,
    ProjectGroupView,
    mapProjectTabResponse,
    mapProjectTotalPages,
    mapProjectTotalCount,
    remainingProjectCount,
    appendProjectGroupsDedup,
    reconcileProjectGroups,
    computeProjectHasMore,
    needsProjectChase,
    projectTypeLabelKey,
    PROJECT_PAGE_SIZE,
    MIN_VISIBLE_PROJECTS,
    MAX_PROJECT_CHASE_PAGES,
  } from "@/utils/projectGroupProjection.uts";
  import noData from "@/static/assets/no_data.png";
  import pinIcon from "@/static/icons/pin.svg";
  import teamIcon from "@/static/icons/team.svg";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  interface ProjectTaskDrawerProps {
    isLoggedIn: boolean;
  }
  const props = defineProps<ProjectTaskDrawerProps>();

  const emit = defineEmits<{
    (e: "conversation-click", item: any): void;
    (e: "pin-project", project: PinnedProjectInfo): void;
  }>();

  const popupRef = ref<any | null>(null);
  const drawerVisible = ref<boolean>(false);

  /** Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject；用 $callMethod 调 defineExpose 方法 */
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // ============================================================
  // 项目分组（真实接口 /api/user-project/tab/page-query）
  // UTS class 深层追踪不可靠（Android）：可变数据放普通数组，版本号驱动 computed。
  // 标记读侧：服务端字段回读打标（2026-09-13 后端化）；写侧走接口成功后改字段。
  // ============================================================
  let projectGroupsData: ProjectGroupView[] = [] as ProjectGroupView[];
  const projectVersion = ref<number>(0);
  const projectLoading = ref<boolean>(false);
  let projectLoadedOnce = false;
  let projectRequestPromise: Promise<boolean> | null = null;
  let projectFavoritesMigrationTriggered = false;
  // 分页游标（对齐 PC ProjectList 2026-09-20：pageSize=20 + 触底加载 + 刷新追拉）
  let projectNextPage = 1;
  let projectHasMore = false;
  let projectTotalPagesCache = 0;
  let projectLoadingMore = false;
  // 「查看更多」入口（09-21 非 H5 端需求）：hasMore/loadingMore/total 为普通 let，
  // 模板需响应式镜像；projectTotalCountCache 供剩余数计算
  let projectTotalCountCache = 0;
  const projectHasMoreView = ref<boolean>(false);
  const projectLoadingMoreView = ref<boolean>(false);
  const projectRemainingView = ref<number>(0);

  /** 项目行视图模型（2026-09-21 设计稿恢复类型标签：常规/网页应用/全栈） */
  class ProjectRowView {
    id: number = 0;
    name: string = "";
    projectType: string = "";
    expanded: boolean = true;
    pinned: boolean = false;
    /** 非创建者项目标「团队」tag（2026-09-20 契约：owner 严格 === false 才标） */
    owner: boolean = true;
    children: ProjectChildView[] = [] as ProjectChildView[];
  }

  /** 列表投影（对齐 PC ProjectPanel）：隐藏归档项、置顶排前、稳定顺序。 */
  const visibleProjectGroups = computed((): ProjectRowView[] => {
    const _v = projectVersion.value;
    const pinnedRows: ProjectRowView[] = [] as ProjectRowView[];
    const normalRows: ProjectRowView[] = [] as ProjectRowView[];
    for (let i = 0; i < projectGroupsData.length; i++) {
      const group = projectGroupsData[i];
      if (group == null || group.archived) {
        continue;
      }
      const row = new ProjectRowView();
      row.id = group.id;
      row.name = group.name;
      row.projectType = group.projectType;
      row.expanded = group.expanded;
      row.pinned = group.pinned;
      row.owner = group.owner;
      row.children = group.children;
      if (group.pinned) {
        pinnedRows.push(row);
      } else {
        normalRows.push(row);
      }
    }
    const rows: ProjectRowView[] = pinnedRows;
    for (let i = 0; i < normalRows.length; i++) {
      rows.push(normalRows[i]);
    }
    return rows;
  });

  function findProjectGroup(groupId: number): ProjectGroupView | null {
    for (let i = 0; i < projectGroupsData.length; i++) {
      if (projectGroupsData[i].id == groupId) {
        return projectGroupsData[i];
      }
    }
    return null;
  }

  function formatTimeLabel(targetTime: string): string {
    const ago = formatListTimeAgo(targetTime);
    return ago != null ? ago : "";
  }

  /** 类型标签文案（projectTypeLabelKey 未知类型返回空串 = 不展示标签） */
  function projectTypeTag(projectType: string): string {
    const key = projectTypeLabelKey(projectType);
    return key.length > 0 ? t(key) : "";
  }

  /**
   * 子会话随项目列表回包（2026-09-21 完整接口契约，对齐 PC toProjectItem
   * 直接消费 record.conversations）：展开/收起纯本地切换已就位数据，
   * 不再调用 /api/user-project/conversations 逐项目补拉。
   */

  /** 统计累计数据中非归档项目数（chase 判定的「可见行」口径，对齐 visibleProjectGroups 过滤） */
  function countVisibleProjects(groups: ProjectGroupView[]): number {
    let count = 0;
    for (let i = 0; i < groups.length; i++) {
      const group = groups[i];
      if (group != null && group.archived != true) {
        count++;
      }
    }
    return count;
  }

  /** 同步「查看更多」入口响应式镜像（剩余数 = total - 已加载可见行，钳 0） */
  function syncProjectLoadMoreState(): void {
    projectHasMoreView.value = projectHasMore;
    projectRemainingView.value = remainingProjectCount(projectTotalCountCache, countVisibleProjects(projectGroupsData));
  }

  /** 「查看更多」入口可见性：还有下一页且当前有可见项目行（H5 走触底加载不展示，模板条件编译控制） */
  const projectLoadMoreVisible = computed((): boolean => {
    return projectHasMoreView.value == true && visibleProjectGroups.value.length > 0;
  });

  /** 「查看更多」文案：加载中 / 查看更多 (剩余数)（对齐 PC load-more-entry；total 未回读时不带计数） */
  const projectLoadMoreText = computed((): string => {
    if (projectLoadingMoreView.value == true) {
      return t("Mobile.Page.loadingMore");
    }
    const base = t("Mobile.Project.viewMore");
    const remaining = projectRemainingView.value;
    return remaining > 0 ? `${base} (${remaining})` : base;
  });

  /**
   * 拉一页项目并投影；返回 null=请求失败（调用方决定保留/中止），空数组=成功但无行。
   * 同时回写 projectTotalPagesCache。
   */
  async function fetchProjectPage(page: number): Promise<ProjectGroupView[] | null> {
    const res = await apiUserProjectTabPageQuery(page, PROJECT_PAGE_SIZE);
    if (apiResCode(res) != SUCCESS_CODE) {
      return null;
    }
    const data = apiResData<any>(res);
    projectTotalPagesCache = mapProjectTotalPages(data);
    projectTotalCountCache = mapProjectTotalCount(data);
    // 子会话随列表行回包直接映射；空主题兜底与任务列表「未命名会话」口径一致
    return mapProjectTabResponse(data, formatTimeLabel, t("Mobile.Conversation.unnamed"));
  }

  async function fetchProjects(): Promise<boolean> {
    try {
      // 刷新：页码 1 起，前端过滤（归档）后可见行不足 MIN_VISIBLE_PROJECTS 时继续追拉
      // （归档项回包含但被过滤，单页可能稀疏；对齐 PC loadData(isRefresh) + chase）
      let page = 1;
      let acc: ProjectGroupView[] = [] as ProjectGroupView[];
      let lastCount = 0;
      let visibleCount = 0;
      let successCount = 0;
      for (let fetched = 0; fetched < MAX_PROJECT_CHASE_PAGES; fetched++) {
        if (
          fetched > 0 &&
          !needsProjectChase(visibleCount, MIN_VISIBLE_PROJECTS, page - 1, projectTotalPagesCache, lastCount, PROJECT_PAGE_SIZE)
        ) {
          break;
        }
        const groups = await fetchProjectPage(page);
        if (groups == null) {
          // 中途失败：已有数据则保留展示，仅停止追拉
          break;
        }
        successCount++;
        lastCount = groups.length;
        acc = appendProjectGroupsDedup(acc, groups);
        visibleCount = countVisibleProjects(acc);
        page++;
      }
      // 整轮一页未成功：不动现有数据、维持「未加载过」，下次打开自动重拉（对齐原单发语义）
      if (successCount == 0) {
        return false;
      }
      projectGroupsData = acc;
      projectNextPage = page;
      projectHasMore = computeProjectHasMore(page - 1, projectTotalPagesCache, lastCount, PROJECT_PAGE_SIZE);
      syncProjectLoadMoreState();
      // 默认全展开（对齐 PC：collapsedIds 初始为空）；子会话随列表回包一并就位
      projectVersion.value = projectVersion.value + 1;
      projectLoadedOnce = true;
      // 首次加载成功后触发本地项目收藏一次性迁移（幂等，未完成前重试）
      if (projectFavoritesMigrationTriggered != true) {
        projectFavoritesMigrationTriggered = true;
        migrateProjectFavorites();
      }
      return true;
    } catch (error) {
      console.error("fetchProjects error:", error);
      return false;
    }
  }

  async function requestProjects(): Promise<boolean> {
    const pending = projectRequestPromise;
    if (pending != null) {
      return await pending;
    }
    projectLoading.value = true;
    const requestPromise = fetchProjects();
    projectRequestPromise = requestPromise;
    try {
      return await requestPromise;
    } finally {
      projectRequestPromise = null;
      projectLoading.value = false;
    }
  }

  /**
   * 抽屉再次打开时后台对账：重取当前已加载页数，但不进入 loading、不清空列表，
   * 并按项目 id 保留展开态与已加载子会话。用户看到的是原内容就地更新。
   */
  async function silentRefreshProjects(): Promise<boolean> {
    if (!projectLoadedOnce || projectRequestPromise != null) return false;
    const loadedPages = projectNextPage > 1 ? projectNextPage - 1 : 1;
    const run = async (): Promise<boolean> => {
      let acc: ProjectGroupView[] = [] as ProjectGroupView[];
      let lastCount = 0;
      for (let page = 1; page <= loadedPages; page++) {
        const groups = await fetchProjectPage(page);
        if (groups == null) return false;
        lastCount = groups.length;
        acc = appendProjectGroupsDedup(acc, groups);
      }
      projectGroupsData = reconcileProjectGroups(projectGroupsData, acc);
      projectNextPage = loadedPages + 1;
      projectHasMore = computeProjectHasMore(loadedPages, projectTotalPagesCache, lastCount, PROJECT_PAGE_SIZE);
      syncProjectLoadMoreState();
      projectVersion.value = projectVersion.value + 1;
      return true;
    };
    const requestPromise = run();
    projectRequestPromise = requestPromise;
    try {
      return await requestPromise;
    } catch (error) {
      console.error("silentRefreshProjects error:", error);
      return false;
    } finally {
      projectRequestPromise = null;
    }
  }

  function toggleProjectExpand(groupId: number): void {
    const group = findProjectGroup(groupId);
    if (group == null) return;
    group.expanded = group.expanded != true;
    projectVersion.value = projectVersion.value + 1;
  }

// 抽屉容器关闭（声明前置：UTS/Kotlin 前向引用 error18，handleAddConversation 需先可用）
  function close(): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) return;
    proxy.$callMethod("close");
  }

  /** 项目「＋」新建会话：上框到首页（对齐 PC ProjectPanel pin → /home）；PageApp 不上框。 */
  function handleAddConversation(groupId: number): void {
    const group = findProjectGroup(groupId);
    if (group == null) return;
    if (group.projectType == "PageApp") {
      uni.showToast({ title: t("Mobile.Project.addConversationPending"), icon: "none" });
      return;
    }
    const pinned = new PinnedProjectInfo();
    pinned.projectId = group.id;
    pinned.projectType = group.projectType;
    pinned.name = group.name;
    pinned.icon = group.icon;
    pinned.sandboxId = group.sandboxId;
    pinned.devAgentId = group.devAgentId;
    close();
    emit("pin-project", pinned);
  }

  /** 抽屉搜索（设计稿右上角放大镜）：跳会话搜索页（任务=会话历史）。 */
  function handleSearch(): void {
    uni.navigateTo({
      url:
        "/subpackages/pages/conversation-search/conversation-search?backUrl=" +
        encodeURIComponent(getCurrentPagePath()),
    });
  }

  // ============================================================
  // 项目长按操作：六项（对齐 PC ProjectPanel 2026-09-13 服务端化）
  // 置顶/归档/收藏：NormalProject/UserApp 走真实接口（pin/archive 传目标态 +
  // projectType 必传 query、collect/unCollect 双路径带 projectType），成功才更新字段；PageApp 契约未覆盖暂本地。
  // 重命名/删除按 projectType 路由真实接口；新建会话 = 占位提示（PC 亦未接入）。
  // ============================================================
  /** PageApp 无标记接口：本地直接改字段（对齐 PC） */
  function projectFlagsUseRealApi(projectType: string): boolean {
    return projectType == "NormalProject" || projectType == "UserApp";
  }

  function applyProjectFlag(group: ProjectGroupView, field: string, value: boolean): void {
    group.pinned = field == "pinned" ? value : group.pinned;
    group.archived = field == "archived" ? value : group.archived;
    group.collected = field == "collected" ? value : group.collected;
    projectVersion.value = projectVersion.value + 1;
  }

  function performProjectPinToggle(group: ProjectGroupView, successTitleOn: string, successTitleOff: string): void {
    const next = group.pinned != true;
    if (projectFlagsUseRealApi(group.projectType) != true) {
      applyProjectFlag(group, "pinned", next);
      uni.showToast({ title: next ? successTitleOn : successTitleOff, icon: "none" });
      return;
    }
    apiUserProjectPin(group.id, next, group.projectType).then((res) => {
      if (apiResCode(res) == SUCCESS_CODE) {
        applyProjectFlag(group, "pinned", next);
        uni.showToast({ title: next ? successTitleOn : successTitleOff, icon: "none" });
      } else {
        uni.showToast({ title: apiResMessage(res).length > 0 ? apiResMessage(res) : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  function performProjectArchiveToggle(group: ProjectGroupView, successTitleOn: string, successTitleOff: string): void {
    const next = group.archived != true;
    if (projectFlagsUseRealApi(group.projectType) != true) {
      applyProjectFlag(group, "archived", next);
      uni.showToast({ title: next ? successTitleOn : successTitleOff, icon: "none" });
      return;
    }
    apiUserProjectArchive(group.id, next, group.projectType).then((res) => {
      if (apiResCode(res) == SUCCESS_CODE) {
        applyProjectFlag(group, "archived", next);
        uni.showToast({ title: next ? successTitleOn : successTitleOff, icon: "none" });
      } else {
        uni.showToast({ title: apiResMessage(res).length > 0 ? apiResMessage(res) : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  /** 归档行内二次确认（对齐 PC 09-19/20 定调）：归档方向需确认，取消归档直接切换 */
  function confirmProjectArchiveToggle(group: ProjectGroupView, successTitleOn: string, successTitleOff: string): void {
    if (group.archived != true) {
      uni.showModal({
        title: t("Mobile.Conversation.archive"),
        content: t("Mobile.Conversation.archiveConfirm"),
        cancelText: t("Mobile.Common.cancel"),
        confirmText: t("Mobile.Common.confirm"),
        success: (res) => {
          if (res.confirm) {
            performProjectArchiveToggle(group, successTitleOn, successTitleOff);
          }
        },
      });
      return;
    }
    performProjectArchiveToggle(group, successTitleOn, successTitleOff);
  }

  function performProjectCollectToggle(group: ProjectGroupView, successTitleOn: string, successTitleOff: string): void {
    const next = group.collected != true;
    if (projectFlagsUseRealApi(group.projectType) != true) {
      applyProjectFlag(group, "collected", next);
      uni.showToast({ title: next ? successTitleOn : successTitleOff, icon: "none" });
      return;
    }
    // projectType 为后端必传 query（归属校验，同 conversation/create 口径）
    const request = next
      ? apiUserProjectCollect(group.id, group.projectType)
      : apiUserProjectUnCollect(group.id, group.projectType);
    request.then((res) => {
      if (apiResCode(res) == SUCCESS_CODE) {
        applyProjectFlag(group, "collected", next);
        uni.showToast({ title: next ? successTitleOn : successTitleOff, icon: "none" });
      } else {
        uni.showToast({ title: apiResMessage(res).length > 0 ? apiResMessage(res) : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  function performProjectRenameSubmit(group: ProjectGroupView, newName: string): Promise<void> {
    if (newName.length == 0) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleEmpty"), icon: "none" });
      return Promise.resolve();
    }
    if (newName.length > 50) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleTooLong"), icon: "none" });
      return Promise.resolve();
    }
    // PageApp 契约未覆盖改名（对齐 PC）：仅本地改名
    if (group.projectType != "NormalProject" && group.projectType != "UserApp") {
      group.name = newName;
      projectVersion.value = projectVersion.value + 1;
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameSuccess"), icon: "success" });
      return Promise.resolve();
    }
    const applyLocal = (): void => {
      group.name = newName;
      projectVersion.value = projectVersion.value + 1;
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameSuccess"), icon: "success" });
    };
    if (group.projectType == "UserApp") {
      const params = new UserAppUpdateParams();
      params.id = group.id;
      params.name = newName;
      return apiUserAppUpdate(params).then((updateRes) => {
        if (apiResCode(updateRes) == SUCCESS_CODE) {
          applyLocal();
        } else {
          const errorMessage = apiResMessage(updateRes);
          uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
        }
      }).catch((_e) => {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
    }
    const projectParams = new UserProjectUpdateParams();
    projectParams.id = group.id;
    projectParams.name = newName;
    return apiNormalProjectUpdate(projectParams).then((updateRes) => {
      if (apiResCode(updateRes) == SUCCESS_CODE) {
        applyLocal();
      } else {
        const errorMessage = apiResMessage(updateRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  function handleProjectRename(group: ProjectGroupView): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.renameModalTitle"),
      editable: true,
      placeholderText: t("Mobile.Components.HistoryConversationList.renamePlaceholder"),
      content: group.name,
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      success: (res) => {
        if (res.confirm) {
          const rawContent = res.content;
          const newName = rawContent != null ? rawContent.trim() : "";
          performProjectRenameSubmit(group, newName);
        }
      },
    });
  }

  function performProjectDeleteSubmit(group: ProjectGroupView): Promise<void> {
    const request = group.projectType == "UserApp"
      ? apiUserAppDelete(group.id)
      : apiUserProjectDelete(group.id);
    return request.then((deleteRes) => {
      if (apiResCode(deleteRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.deleteSuccess"), icon: "success" });
        clearProjectFlags(group.id);
        const next: ProjectGroupView[] = [] as ProjectGroupView[];
        for (let i = 0; i < projectGroupsData.length; i++) {
          if (projectGroupsData[i].id != group.id) {
            next.push(projectGroupsData[i]);
          }
        }
        projectGroupsData = next;
        projectVersion.value = projectVersion.value + 1;
      } else {
        const errorMessage = apiResMessage(deleteRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  function handleProjectDelete(group: ProjectGroupView): void {
    uni.showModal({
      title: t("Mobile.Project.deleteModalTitle"),
      content: t("Mobile.Project.deleteModalContent"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm) {
          performProjectDeleteSubmit(group);
        }
      },
    });
  }

  function handleProjectLongPress(groupId: number): void {
    const group = findProjectGroup(groupId);
    if (group == null) {
      return;
    }
    // PageApp 契约未覆盖删除（对齐 PC）：不挂删除项
    const canDelete = group.projectType == "NormalProject" || group.projectType == "UserApp";
    const options: string[] = [];
    options.push(group.pinned ? t("Mobile.Conversation.unpin") : t("Mobile.Conversation.pin"));
    options.push(group.archived ? t("Mobile.Conversation.unarchive") : t("Mobile.Conversation.archive"));
    options.push(group.collected ? t("Mobile.Conversation.unfavorite") : t("Mobile.Conversation.favorite"));
    options.push(t("Mobile.Components.HistoryConversationList.rename"));
    if (canDelete) {
      options.push(t("Mobile.Components.HistoryConversationList.delete"));
    }
    options.push(t("Mobile.Conversation.newConversation"));
    uni.showActionSheet({
      itemList: options,
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.tapIndex == 0) {
          performProjectPinToggle(
            group,
            t("Mobile.Conversation.pinSuccess"),
            t("Mobile.Conversation.unpinSuccess"),
          );
        } else if (res.tapIndex == 1) {
          confirmProjectArchiveToggle(
            group,
            t("Mobile.Conversation.archiveSuccess"),
            t("Mobile.Conversation.unarchiveSuccess"),
          );
        } else if (res.tapIndex == 2) {
          performProjectCollectToggle(
            group,
            t("Mobile.Conversation.favoriteSuccess"),
            t("Mobile.Conversation.unfavoriteSuccess"),
          );
        } else if (res.tapIndex == 3) {
          handleProjectRename(group);
        } else if (res.tapIndex == 4 && canDelete) {
          handleProjectDelete(group);
        } else {
          handleAddConversation(group.id);
        }
      },
    });
  }

  // ============================================================
  // 项目子会话长按操作：两项（重命名/删除；PC 定调子项不做置顶）
  // ============================================================
  function performChildRenameSubmit(group: ProjectGroupView, child: ProjectChildView, newName: string): Promise<void> {
    if (newName.length == 0) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleEmpty"), icon: "none" });
      return Promise.resolve();
    }
    if (newName.length > 50) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleTooLong"), icon: "none" });
      return Promise.resolve();
    }
    const updateParams = new AgentConversationUpdateParams();
    updateParams.id = child.id;
    updateParams.topic = newName;
    return apiAgentConversationUpdate(updateParams).then((updateRes) => {
      if (apiResCode(updateRes) == SUCCESS_CODE) {
        child.name = newName;
        projectVersion.value = projectVersion.value + 1;
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameSuccess"), icon: "success" });
      } else {
        const errorMessage = apiResMessage(updateRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  function performChildDeleteSubmit(group: ProjectGroupView, child: ProjectChildView): Promise<void> {
    return apiAgentConversationDelete(child.id).then((deleteRes) => {
      if (apiResCode(deleteRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.deleteSuccess"), icon: "success" });
        clearConversationFlags(child.id);
        const next: ProjectChildView[] = [] as ProjectChildView[];
        for (let i = 0; i < group.children.length; i++) {
          if (group.children[i].id != child.id) {
            next.push(group.children[i]);
          }
        }
        group.children = next;
        projectVersion.value = projectVersion.value + 1;
      } else {
        const errorMessage = apiResMessage(deleteRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  function handleProjectChildLongPress(groupId: number, childId: number): void {
    const group = findProjectGroup(groupId);
    if (group == null) return;
    let child: ProjectChildView | null = null;
    for (let i = 0; i < group.children.length; i++) {
      if (group.children[i].id == childId) {
        child = group.children[i];
        break;
      }
    }
    if (child == null) return;
    const options = [
      t("Mobile.Components.HistoryConversationList.rename"),
      t("Mobile.Components.HistoryConversationList.delete"),
    ];
    uni.showActionSheet({
      itemList: options,
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.tapIndex == 0) {
          uni.showModal({
            title: t("Mobile.Components.HistoryConversationList.renameModalTitle"),
            editable: true,
            placeholderText: t("Mobile.Components.HistoryConversationList.renamePlaceholder"),
            content: child!.name,
            cancelText: t("Mobile.Common.cancel"),
            confirmText: t("Mobile.Common.confirm"),
            success: (modalRes) => {
              if (modalRes.confirm) {
                const rawContent = modalRes.content;
                const newName = rawContent != null ? rawContent.trim() : "";
                performChildRenameSubmit(group, child!, newName);
              }
            },
          });
        } else if (res.tapIndex == 1) {
          uni.showModal({
            title: t("Mobile.Components.HistoryConversationList.deleteModalTitle"),
            content: t("Mobile.Components.HistoryConversationList.deleteModalContent"),
            cancelText: t("Mobile.Common.cancel"),
            confirmText: t("Mobile.Common.confirm"),
            confirmColor: "#ff4d4f",
            success: (modalRes) => {
              if (modalRes.confirm) {
                performChildDeleteSubmit(group, child!);
              }
            },
          });
        }
      },
    });
  }

  // ============================================================
  // 点击跳转
  // ============================================================
  function handleProjectChildClick(groupId: number, childId: number): void {
    const group = findProjectGroup(groupId);
    if (group == null) return;
    let child: ProjectChildView | null = null;
    for (let i = 0; i < group.children.length; i++) {
      if (group.children[i].id == childId) {
        child = group.children[i];
        break;
      }
    }
    if (child == null) return;
    if (child.agentId <= 0) {
      uni.showToast({ title: t("Mobile.Conversation.agentIdMissing"), icon: "none" });
      return;
    }
    const payload = new UTSJSONObject();
    // 应用ID
    payload["id"] = group.id;
    // 会话ID
    payload["conversationId"] = child.id;
    // 智能体ID
    payload["agentId"] = child.agentId;
    // 会话主题
    payload["topic"] = child.name;
    // 项目类型
    payload["pType"] = group.projectType;
    emit("conversation-click", payload);
  }

  /** 任务列表（子组件）点击透传给页面层跳转 */
  function relayConversationClick(item: any): void {
    emit("conversation-click", item);
  }

  // ============================================================
  // 区头标题（2026-09-21 设计稿定调：无计数）；taskCount 与子组件 count-change
  // 上报链路保留，仅标题不再拼接，便于后续恢复计数
  // ============================================================
  const taskCount = ref<number>(0);

  /** 子组件可见行数上报（分页/长按归档删除等都覆盖） */
  function handleTaskCountChange(count: number): void {
    taskCount.value = count;
  }

  const sectionProjectTitle = computed((): string => {
    return t("Mobile.Common.projects");
  });

  const sectionTaskTitle = computed((): string => {
    return t("Mobile.Common.tasks");
  });

  /** 分组折叠态（对齐 PC：点击分组头折叠/展开整个分组，计数保留） */
  const projectSectionCollapsed = ref<boolean>(false);
  const taskSectionCollapsed = ref<boolean>(false);

  // ============================================================
  // 抽屉生命周期 / 刷新（滚动与下拉刷新在此，经 expose 入口驱动子组件）
  // ============================================================
  const taskListRef = ref<any | null>(null);
  const listMounted = ref<boolean>(false);
  const refreshing = ref<boolean>(false);
  const listKey = ref<number>(0);
  let refreshInFlight = false;

  // 全端（09-21 Android/鸿蒙并入 scroll-view 路径）
  // ============================================================
  // 浮动吸顶头（sticky 组件降级端 iOS/微信，见模板注释）：
  // 监听滚动 + 容器顶部固定浮头；任务头锚点越过滚动区顶后浮头切「任务」，否则「项目」。
  // ============================================================
  const floatingHeaderKey = ref<string>(""); // ""=隐藏（项目头在自然位） / "project" / "task"
  let stickyLastScrollTop = 0;
  /** 任务头在滚动内容坐标的偏移（px），<=0 表示尚未测到（不切换） */
  let taskHeaderContentOffset = -1;
  const STICKY_TRIGGER_EPS = 1;

  const showFloatingHeader = computed((): boolean => {
    return floatingHeaderKey.value.length > 0 && refreshing.value != true;
  });

  const floatingHeaderTitle = computed((): string => {
    return floatingHeaderKey.value == "task" ? sectionTaskTitle.value : sectionProjectTitle.value;
  });

  const floatingCollapsed = computed((): boolean => {
    return floatingHeaderKey.value == "task" ? taskSectionCollapsed.value : projectSectionCollapsed.value;
  });

  function updateFloatingHeader(scrollTop: number): void {
    if (taskHeaderContentOffset > 0 && scrollTop + STICKY_TRIGGER_EPS >= taskHeaderContentOffset) {
      if (floatingHeaderKey.value != "task") {
        floatingHeaderKey.value = "task";
      }
    } else if (scrollTop > STICKY_TRIGGER_EPS) {
      if (floatingHeaderKey.value != "project") {
        floatingHeaderKey.value = "project";
      }
    } else if (floatingHeaderKey.value.length != 0) {
      floatingHeaderKey.value = "";
    }
  }

  function handleStickyScroll(e: UniScrollEvent): void {
    const st = e.detail.scrollTop;
    stickyLastScrollTop = st;
    updateFloatingHeader(st);
  }

  /** 测任务头锚点相对滚动区的内容偏移；项目区高度变化（版本 bump）与刷新重建后需重测 */
  function measureStickyAnchors(): void {
    if (drawerVisible.value != true) return;
    const inst = getCurrentInstance();
    if (inst == null) return;
    const proxy = inst.proxy;
    if (proxy == null) return;
    uni.createSelectorQuery()
      .in(proxy)
      .select("#drawer-sticky-scroll")
      .boundingClientRect()
      .select("#task-section-header")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        if (results.length < 2) return;
        const scrollRaw = results[0];
        const taskRaw = results[1];
        if (scrollRaw == null || taskRaw == null) return;
        const scrollRect = scrollRaw as NodeInfo;
        const taskRect = taskRaw as NodeInfo;
        // NodeInfo.top 可空（Android Kotlin 禁可空接收者运算），按仓内惯例 parseFloat 归一
        const taskTop = taskRect.top != null ? parseFloat(`${taskRect.top}`) : 0;
        const scrollViewportTop = scrollRect.top != null ? parseFloat(`${scrollRect.top}`) : 0;
        // 两 rect 同帧测得（viewport 坐标），差值 + 当前 scrollTop = 内容坐标偏移
        taskHeaderContentOffset = taskTop - scrollViewportTop + stickyLastScrollTop;
        updateFloatingHeader(stickyLastScrollTop);
      });
  }

  function scheduleMeasureStickyAnchors(delayMs: number): void {
    setTimeout(() => {
      measureStickyAnchors();
    }, delayMs);
  }

  // 项目区高度变化（展开/收起/子会话懒加载/标记增删）后重测锚点
  watch(projectVersion, (_v: number) => {
    scheduleMeasureStickyAnchors(120);
  });

  /** 点击分组头折叠/展开整个分组（PC 同款）；折叠改变内容高度，降级端需重测任务头锚点 */
  function toggleProjectSection(): void {
    projectSectionCollapsed.value = projectSectionCollapsed.value != true;
    // 全端（09-21 Android/鸿蒙并入 scroll-view 路径）
    scheduleMeasureStickyAnchors(160);
  }

  function toggleTaskSection(): void {
    taskSectionCollapsed.value = taskSectionCollapsed.value != true;
    // 全端（09-21 Android/鸿蒙并入 scroll-view 路径）
    scheduleMeasureStickyAnchors(160);
  }

  // ============================================================
  // 项目区头「全部展开/收起」按钮（对齐 PC section-tool → ProjectPanel.toggleAll）
  // ============================================================
  /** 可见（非归档）项目是否全部处于展开态 */
  const projectChildrenAllExpanded = computed((): boolean => {
    const rows = visibleProjectGroups.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].expanded != true) {
        return false;
      }
    }
    return true;
  });

  /** 无可见项目时隐藏入口（对齐 PC 空列表 disabled 语义） */
  const projectToggleAllVisible = computed((): boolean => {
    return visibleProjectGroups.value.length > 0;
  });

  /** 全部展开/收起项目下会话：全展开 → 全收起，否则 → 全展开；项目区被分组折叠时先展开分组 */
  function toggleAllProjectChildren(): void {
    if (projectToggleAllVisible.value != true) return;
    const collapse = projectChildrenAllExpanded.value;
    for (let i = 0; i < projectGroupsData.length; i++) {
      const group = projectGroupsData[i];
      if (group == null || group.archived == true) continue;
      group.expanded = collapse != true;
    }
    if (projectSectionCollapsed.value) {
      projectSectionCollapsed.value = false;
      scheduleMeasureStickyAnchors(160);
    }
    projectVersion.value = projectVersion.value + 1;
  }

  function handlePopupVisible(visible: boolean): void {
    drawerVisible.value = visible == true;
  }

  function open(): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) return;
    proxy.$callMethod("open");
    if (!props.isLoggedIn) return;
    // 首次打开拉全量；再次打开仅静默补差
    if (!projectLoadedOnce && projectRequestPromise == null) {
      requestProjects();
    }
    // 任务列表首载在 watch(drawerVisible) 里做：page-container 关闭态不挂载子组件，
    // 此刻 taskListRef 尚未绑定，直接调会被 null 守卫吞掉（首开空白、二开才有的根因）
  }

  /** 首页 onShow resume：抽屉开着时静默补差（任务头部 + 项目全量）。 */
  function resumeData(): void {
    if (drawerVisible.value != true || !props.isLoggedIn) return;
    callRefMethod(taskListRef.value, "silentRefresh");
    if (projectRequestPromise == null) {
      silentRefreshProjects();
    }
  }

  /** 对外：创建项目后强制刷新项目列表（无论抽屉是否打开，下次打开即见新项目）。 */
  function refreshProjects(): void {
    if (!props.isLoggedIn) return;
    if (projectRequestPromise == null) {
      if (projectLoadedOnce) silentRefreshProjects();
      else requestProjects();
    }
  }

  /**
   * 任务列表首载兜底：page-container 打开后 slot 子组件的挂载可能晚于 nextTick
   * （ref 短暂为 null），带短重试直到 ref 绑定。
   * 注意：UTS 顶层声明顺序敏感，本函数必须声明在 releaseRefresher 之前
   * （下拉刷新重建滚动容器后也要调它重挂首载）。
   */
  function ensureTaskListLoaded(retries: number): void {
    if (drawerVisible.value != true) return;
    const inst = taskListRef.value;
    if (inst != null) {
      callRefMethod(inst, "loadIfEmpty");
      callRefMethod(inst, "silentRefresh");
      return;
    }
    if (retries <= 0) return;
    setTimeout(() => {
      ensureTaskListLoaded(retries - 1);
    }, 120);
  }

  async function releaseRefresher(): Promise<void> {
    refreshing.value = false;
    listKey.value = listKey.value + 1;
    await nextTick();
    // listKey 重建滚动容器 = 任务列表子组件换成了全新实例：必须重挂首载钩子，
    // 否则新实例没人管（loadIfEmpty 只在抽屉打开的 watch 里调过一次）——
    // 缓存有数据 → silentRefresh 轻量对账；缓存空 → loadIfEmpty 拉首屏。
    // 漏掉这步就是「下拉刷新后任务区暂无数据」且不自恢复（09-21 复现修复）。
    ensureTaskListLoaded(8);
    // 全端（09-21 Android/鸿蒙并入 scroll-view 路径）
    // listKey 重建滚动容器后节点全新，重测吸顶锚点
    scheduleMeasureStickyAnchors(120);
  }

  function resetRefresher(): void {
    refreshing.value = false;
  }

  async function performRefresh(): Promise<void> {
    try {
      await nextTick();
      // 任务列表刷新即发即忘（子组件内已做在途收口与单飞）；容器等待项目刷新完成后收起刷新层
      callRefMethod(taskListRef.value, "refresh");
      await requestProjects();
    } catch (error) {
      console.error("performRefresh error:", error);
    } finally {
      refreshInFlight = false;
      await releaseRefresher();
    }
  }

  function handleRefresh(): void {
    if (refreshInFlight) {
      releaseRefresher();
      return;
    }
    refreshing.value = true;
    refreshInFlight = true;
    performRefresh();
  }

  /** 触底加载项目下一页（对齐 PC loadData 翻页语义：拉一页、去重追加、保留展开态不重置）。 */
  async function loadMoreProjects(): Promise<void> {
    if (projectHasMore != true || projectLoadingMore || projectRequestPromise != null) {
      return;
    }
    projectLoadingMore = true;
    projectLoadingMoreView.value = true;
    try {
      const groups = await fetchProjectPage(projectNextPage);
      if (groups == null || groups.length == 0) {
        // 失败/空页：置停触底重试（下拉刷新恢复），避免触底风暴
        projectHasMore = false;
        return;
      }
      const lastCount = groups.length;
      projectGroupsData = appendProjectGroupsDedup(projectGroupsData, groups);
      projectNextPage = projectNextPage + 1;
      projectHasMore = computeProjectHasMore(projectNextPage - 1, projectTotalPagesCache, lastCount, PROJECT_PAGE_SIZE);
      projectVersion.value = projectVersion.value + 1;
    } catch (error) {
      console.error("loadMoreProjects error:", error);
      projectHasMore = false;
    } finally {
      projectLoadingMore = false;
      projectLoadingMoreView.value = false;
      syncProjectLoadMoreState();
    }
  }

  /** 「查看更多」入口点击：复用触底加载下一页逻辑（自带防重入/无更多守卫） */
  function handleProjectLoadMore(): void {
    loadMoreProjects();
  }

  /** 容器触底：项目未加载完先拉项目下一页，完了交任务列表加载下一页。 */
  function handleScrollTolower(): void {
    if (projectHasMore == true) {
      loadMoreProjects();
      return;
    }
    callRefMethod(taskListRef.value, "loadMore");
  }

  // 抽屉每次变为可见且子组件挂载完成后再触发任务列表首载（见 open() 注释）
  watch(drawerVisible, (visible: boolean) => {
    if (visible != true || props.isLoggedIn != true) return;
    nextTick(() => {
      ensureTaskListLoaded(8);
    });
    if (projectLoadedOnce && projectRequestPromise == null) {
      silentRefreshProjects();
    }
    // 全端（09-21 Android/鸿蒙并入 scroll-view 路径）
    // 弹层动画（page-container ~300ms）结束后测锚点；数据到位后 projectVersion watch 会再补测
    scheduleMeasureStickyAnchors(400);
  });

  /**
   * 消费全局 batch 轮询分发的 ChatFinished：抽屉开着时静默刷新任务头部与项目列表，
   * 保证执行中/已完成状态及时更新。
   */
  function handleChatFinishedEvent(_data: any | null): void {
    if (drawerVisible.value != true) return;
    callRefMethod(taskListRef.value, "silentRefresh");
    if (projectRequestPromise == null) {
      silentRefreshProjects();
    }
  }

  onMounted(() => {
    eventBus.on(`${EVENT_TYPE.ChatFinished}`, handleChatFinishedEvent);
    nextTick(() => {
      listMounted.value = true;
    });
  });

  onUnmounted(() => {
    eventBus.off(`${EVENT_TYPE.ChatFinished}`, handleChatFinishedEvent);
    refreshing.value = false;
    listMounted.value = false;
  });

  defineExpose({
    open: open as any,
    close: close as any,
    resumeData: resumeData as any,
    refreshProjects: refreshProjects as any,
  });
</script>

<style lang="scss" scoped>
  .drawer-wrap {
    position: relative;
    width: 100%;
    /* 高度链用 flex 而非 height:100%（iOS 上百分比高度对 flex 计算父级会断裂） */
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    background-color: #ffffff;
    /* #ifdef APP */
    padding-top: 120rpx;
    /* #endif */
    /* #ifdef APP-IOS */
    /* 抽屉面板 fixed 锚到物理屏底（含 home 指示条区域），底部内容留出安全区 */
    padding-bottom: env(safe-area-inset-bottom);
    /* #endif */
  }

  .drawer-scroll {
    width: 100%;
    flex: 1;
    min-height: 0;
  }

  /* 吸顶/浮头场景下分组头必须不透明（PC 同款防穿帮：滚动内容不得从头后透出） */
  .section-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 32rpx 8rpx;
    background-color: #ffffff;

    .section-title-text {
      font-size: 26rpx;
      font-weight: 600;
      color: #8b8e96;
      line-height: 36rpx;
    }

    .header-search-btn {
      flex-shrink: 0;
      width: 56rpx;
      height: 56rpx;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: -8rpx;
    }
  }

  /* 分组头文案行：标题 + 紧随的折叠箭头（对齐 PC：chevron 跟在 label 文案旁） */
  .header-title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  /* 分组折叠箭头（与项目行箭头同视觉） */
  .section-arrow {
    flex-shrink: 0;
    font-size: 24rpx;
    color: #8b8e96;
    margin-left: 8rpx;
  }

  /* 项目区头「全部展开/收起」图标按钮（对齐 PC section-tool：上下双 chevron，
     与 header-search-btn 同命中区域） */
  .header-toggle-all-btn {
    flex-shrink: 0;
    width: 56rpx;
    height: 56rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-left: 8rpx;
  }

  .toggle-all-chevrons {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* 任务分组头：与项目区的间距并入 padding-top（吸顶条整块不透明，不用 margin 防透缝） */
  .task-section-header {
    padding-top: 32rpx;
  }

  /* 浮动吸顶头（iOS/微信降级端）：钉在滚动区顶部，top 与 drawer-wrap 的 APP 状态栏让位对齐 */
  .floating-section-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    background-color: #ffffff;
    /* #ifdef APP */
    top: 120rpx;
    /* #endif */
  }

  // ===== 项目分组（对齐设计稿：无分割线，留白分组） =====
  /* .project-block 仅剩 scroll-view 分支的分组间距；行样式提升到顶层，
     供 Android 扁平行（list-item 直挂行 view）与 scroll-view 分支共用 */
  .project-block {
    padding-bottom: 16rpx;
  }

  .project-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 20rpx 32rpx;

      .project-flag-image {
        flex-shrink: 0;
        width: 22rpx;
        height: 22rpx;
        margin-right: 8rpx;
      }

      /* 类型标签（2026-09-21 设计稿恢复：常规项目/网页应用/全栈项目，灰底小圆角 pill） */
      .project-type-tag {
        flex-shrink: 0;
        margin-left: 12rpx;
        padding: 2rpx 12rpx;
        border-radius: 8rpx;
        background-color: #f2f3f7;
        font-size: 20rpx;
        color: #6b6e76;
        line-height: 30rpx;
      }

      /* 弹性占位：项目名/标签贴左，＋钉在行右缘 */
      .project-row-flex {
        flex: 1;
      }

      .project-team-image {
        flex-shrink: 0;
        width: 22rpx;
        height: 22rpx;
        margin-right: 8rpx;
      }

      .project-name {
        flex-shrink: 1;
        min-width: 0;
        font-size: 30rpx;
        font-weight: 600;
        color: #15171f;
        line-height: 42rpx;
        margin-right: 12rpx;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* ＋按钮（2026-09-21 设计稿：纯＋号无底色，保留 48rpx 命中区域） */
      .project-add-btn {
        flex-shrink: 0;
        width: 48rpx;
        height: 48rpx;
        display: flex;
        align-items: center;
        justify-content: center;

        .project-add-icon {
          font-size: 36rpx;
          color: #5147ff;
          line-height: 40rpx;
        }
      }
    }

    .project-child-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 14rpx 32rpx 14rpx 72rpx;

      .child-status {
        flex-shrink: 0;
        height: 32rpx;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12rpx;

        .status-running {
          color: #5147ff;
        }

        .status-failed {
          font-size: 24rpx;
          color: #e54d4d;
        }
      }

      .child-name {
        flex: 1;
        min-width: 0;
        font-size: 28rpx;
        color: #33363d;
        line-height: 40rpx;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .child-time {
        flex-shrink: 0;
        font-size: 22rpx;
        color: #999;
        line-height: 32rpx;
        margin-left: 12rpx;
      }
    }

    .project-child-empty {
      padding: 12rpx 32rpx 20rpx 72rpx;

      .project-child-empty-text {
        font-size: 24rpx;
        color: #b3b6bd;
        line-height: 34rpx;
      }
    }

  // ===== 空态 =====
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60rpx 0;

    .empty-image {
      width: 150rpx;
      height: 150rpx;
    }

    .empty-text {
      font-size: 28rpx;
      color: #999;
      margin-top: 24rpx;
    }
  }

  /* 项目区「查看更多」入口（对齐 PC load-more-entry：小号居中次级文字） */
  .project-load-more {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 16rpx 24rpx;

    .project-load-more-text {
      font-size: 24rpx;
      color: #8b8e96;
      line-height: 34rpx;
    }
  }
</style>
