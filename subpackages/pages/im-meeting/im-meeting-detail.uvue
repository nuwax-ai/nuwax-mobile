<template>
  <view class="page">
    <custom-nav-bar
      :title="t('Mobile.Meeting.detailTitle')"
      className="border-b"
      hasSafetyZone
      showBack
    >
      <template #right>
        <view class="nav-refresh" :class="{ 'nav-refresh--busy': loading }" @click="handleRefresh">
          <text class="nav-refresh__text">↻</text>
        </view>
      </template>
    </custom-nav-bar>

    <view v-if="loading && !ready" class="state">
      <text class="state__text">{{ t("Mobile.Common.loading") }}</text>
    </view>
    <view v-else-if="failed && !ready" class="state">
      <text class="state__text">{{ errorText }}</text>
      <view class="state__button" hover-class="state__button--active" @click="handleRefresh">
        <text class="state__button-text">{{ t("Mobile.Common.retry") }}</text>
      </view>
    </view>
    <view v-else-if="ready && !hasMeeting" class="state">
      <text class="state__text">{{ t("Mobile.Meeting.detailMissing") }}</text>
    </view>

    <scroll-view
      v-else-if="ready"
      class="scroll"
      direction="vertical"
      :show-scrollbar="false"
    >
      <view class="card info-card">
        <view class="title-row">
          <text class="meeting-title" :lines="2">{{ meetingTitle }}</text>
          <view :class="statusClass">
            <text :class="statusTextClass">{{ recordBadgeText }}</text>
          </view>
        </view>

        <view class="facts">
          <view class="fact">
            <text class="fact__label">{{ t("Mobile.Meeting.roomNoLabel") }}</text>
            <text class="fact__value">{{ roomLabel }}</text>
          </view>
          <view class="fact">
            <text class="fact__label">{{ t("Mobile.Meeting.statusLabel") }}</text>
            <text class="fact__value">{{ meetingStatusText }}</text>
          </view>
          <view class="fact">
            <text class="fact__label">{{ t("Mobile.Meeting.detailStartTime") }}</text>
            <text class="fact__value">{{ startText }}</text>
          </view>
          <view class="fact">
            <text class="fact__label">{{ t("Mobile.Meeting.detailEndTime") }}</text>
            <text class="fact__value">{{ endText }}</text>
          </view>
          <view class="fact">
            <text class="fact__label">{{ t("Mobile.Meeting.detailDuration") }}</text>
            <text class="fact__value">{{ durationText }}</text>
          </view>
        </view>

        <view class="members-block">
          <text class="block-label">{{ membersHeading }}</text>
          <view v-if="members.length > 0" class="members">
            <view v-for="member in members" :key="member.key" class="member">
              <text class="member__name">{{ member.name }}</text>
              <text v-if="member.host" class="member__host">{{ t("Mobile.Meeting.hostBadge") }}</text>
            </view>
          </view>
          <text v-else class="empty-inline">{{ t("Mobile.Meeting.membersEmpty") }}</text>
        </view>
      </view>

      <view class="section-head">
        <text class="section-head__title">{{ t("Mobile.Meeting.detailReplay") }}</text>
      </view>
      <view class="card replay-card">
        <view v-if="replayLocked" class="empty-box">
          <text class="empty-box__title">{{ t("Mobile.Meeting.replayUnavailable") }}</text>
          <text class="empty-box__hint">{{ replayLockedHint }}</text>
        </view>
        <view v-else-if="files.length == 0" class="empty-box">
          <text class="empty-box__title">{{ t("Mobile.Meeting.replayEmpty") }}</text>
        </view>
        <template v-else>
          <view class="file-list">
            <view
              v-for="file in files"
              :key="file.id"
              class="file-row"
              :class="{ 'file-row--selected': file.id == selectedFileId, 'file-row--off': file.status != 2 }"
              @click="handleFileClick(file)"
            >
              <view class="file-row__main">
                <text class="file-row__name" :lines="1">{{ file.name }}</text>
                <text class="file-row__meta">{{ file.meta }}</text>
              </view>
              <view v-if="file.status == 2 && host" class="file-download"
                :class="{ 'file-download--busy': downloadBusy }" hover-class="file-download--active"
                @click.stop="handleDownload(file)">
                <text class="file-download__text">{{ downloadBusy && downloadingFileId == file.id ? t("Mobile.Terminal.downloading") : t("Mobile.Terminal.download") }}</text>
              </view>
              <text v-else-if="file.status != 2" class="file-row__state">{{ file.stateText }}</text>
            </view>
          </view>

          <view v-if="selectedReady" class="player">
            <view class="player__top">
              <view class="play-button" hover-class="play-button--active" @click="handlePlayToggle">
                <text class="play-button__text">{{ playing ? "Ⅱ" : "▶" }}</text>
              </view>
              <text class="player__time">{{ currentTimeText }} / {{ totalTimeText }}</text>
              <text v-if="audioLoading" class="player__loading">{{ t("Mobile.Common.loading") }}</text>
            </view>
            <slider
              v-if="!selectedVideo"
              class="player__slider"
              :value="sliderValue"
              :min="0"
              :max="sliderMax"
              :step="1"
              :block-size="14"
              activeColor="#5147ff"
              backgroundColor="#e7e5ef"
              @change="handleSeek"
            />
          </view>
        </template>
      </view>

      <view class="section-head">
        <text class="section-head__title">{{ t("Mobile.Meeting.detailTranscript") }}</text>
        <text v-if="transcriptStatusText.length > 0" class="section-head__note">{{ transcriptStatusText }}</text>
      </view>
      <view class="card transcript-card">
        <view v-if="replayLocked" class="empty-box">
          <text class="empty-box__title">{{ t("Mobile.Meeting.transcriptUnavailable") }}</text>
        </view>
        <view v-else-if="selectedTranscriptLines.length == 0" class="empty-box">
          <text class="empty-box__title">{{ transcriptEmptyText }}</text>
        </view>
        <view v-else class="transcript-list">
          <view
            v-for="line in selectedTranscriptLines"
            :key="line.key"
            class="transcript-line"
            hover-class="transcript-line--active"
            @click="handleTranscriptClick(line)"
          >
            <view class="transcript-line__head">
              <text class="transcript-line__speaker">{{ line.speaker }}</text>
              <text class="transcript-line__time">{{ line.timeText }}</text>
            </view>
            <text class="transcript-line__text">{{ line.text }}</text>
          </view>
        </view>
      </view>

      <view class="bottom-space" />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { onLoad, onUnload } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiImMeetingRecordDetail, apiImMeetingRecordFileUrl } from "@/servers/imMeeting";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { formatMeetingId, meetingDisplayTitle } from "@/utils/meeting/meetingLink";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { MeetingReplayFile as DetailFile, meetingReplayKind, visibleMeetingReplayFiles, meetingReplayVideoRoute, meetingReplaySignedUrl } from "@/utils/meeting/meetingReplay";
  import { saveVideoToAlbumInApp } from "@/utils/appWebViewImagePreview";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  class DetailMember {
    key: string = "";
    name: string = "";
    host: boolean = false;
  }

  class TranscriptLine {
    key: string = "";
    fileId: string = "";
    beginMs: number = 0;
    speaker: string = "";
    timeText: string = "";
    text: string = "";
  }

  class TranscriptBlock {
    fileId: string = "";
    status: number = 0;
    statusText: string = "";
    lines: TranscriptLine[] = [] as TranscriptLine[];
  }

  const meetingId = ref<string>("");
  const fallbackTitle = ref<string>("");
  const loading = ref<boolean>(false);
  const ready = ref<boolean>(false);
  const failed = ref<boolean>(false);
  const errorText = ref<string>("");
  const hasMeeting = ref<boolean>(false);
  const meetingTitle = ref<string>("");
  const roomName = ref<string>("");
  const meetingStatus = ref<number>(-1);
  const meetingStatusText = ref<string>("—");
  const startText = ref<string>("—");
  const endText = ref<string>("—");
  const durationSec = ref<number>(0);
  const recordStatus = ref<number>(0);
  const host = ref<boolean>(false);
  const replayVisible = ref<boolean>(true);
  const replayShared = ref<boolean>(false);
  const members = ref<DetailMember[]>([]);
  const files = ref<DetailFile[]>([]);
  const transcriptBlocks = ref<TranscriptBlock[]>([]);
  const selectedFileId = ref<string>("");
  const playing = ref<boolean>(false);
  const audioLoading = ref<boolean>(false);
  const downloadBusy = ref<boolean>(false);
  const downloadingFileId = ref<string>("");
  let pageAlive = true;
  const currentSec = ref<number>(0);
  const audioDurationSec = ref<number>(0);
  let audioCtx: InnerAudioContext | null = null;
  let audioLoadedFileId = "";
  let pendingSeekSec = -1;
  let pollTimer = 0;

  function readStr(obj: UTSJSONObject, key: string): string {
    const value = obj[key];
    return value != null ? `${value}` : "";
  }

  function readNum(obj: UTSJSONObject, key: string, fallback: number): number {
    const value = obj[key];
    if (value == null) {
      return fallback;
    }
    if (typeof value == "number") {
      const numberValue = value as number;
      return numberValue == numberValue ? numberValue : fallback;
    }
    const parsed = parseFloat(`${value}`);
    return parsed == parsed ? parsed : fallback;
  }

  function readBool(obj: UTSJSONObject, key: string, fallback: boolean): boolean {
    const value = obj[key];
    if (value == null) {
      return fallback;
    }
    if (typeof value == "boolean") {
      return value as boolean;
    }
    return `${value}` == "true";
  }

  function formatTime(raw: string): string {
    const text = raw.trim();
    if (text.length == 0) {
      return "—";
    }
    let normalized = text.replaceAll("T", " " );
    const dot = normalized.indexOf(".");
    if (dot > 0) {
      normalized = normalized.substring(0, dot);
    }
    return normalized.length >= 19 ? normalized.substring(0, 19) : normalized;
  }

  function pad2(value: number): string {
    return value < 10 ? `0${value}` : `${value}`;
  }

  function formatDuration(sec: number): string {
    const total = Math.max(0, Math.floor(sec));
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    if (h > 0) {
      return `${h}:${pad2(m)}:${pad2(s)}`;
    }
    return `${m}:${pad2(s)}`;
  }

  function formatTimeline(ms: number): string {
    return formatDuration(Math.floor(Math.max(0, ms) / 1000));
  }

  function formatSize(bytes: number): string {
    if (bytes <= 0) {
      return "";
    }
    if (bytes >= 1048576) {
      return `${(bytes / 1048576).toFixed(1)} MB`;
    }
    return `${Math.max(1, Math.round(bytes / 1024))} KB`;
  }

  function meetingStatusFallback(status: number): string {
    if (status == 0) return t("Mobile.Meeting.tagPending");
    if (status == 1) return t("Mobile.Meeting.tagOngoing");
    if (status == 2) return t("Mobile.Meeting.detailEnded");
    if (status == 3) return t("Mobile.Meeting.detailCancelled");
    return "—";
  }

  function fileStateText(status: number, fallback: string): string {
    if (fallback.length > 0) return fallback;
    if (status == 1) return t("Mobile.Meeting.fileProcessing");
    if (status == 2) return t("Mobile.Meeting.fileReady");
    if (status == 3) return t("Mobile.Meeting.fileFailed");
    return "—";
  }

  function transcriptStateText(status: number, fallback: string): string {
    if (status >= 1 && status <= 4) return t("Mobile.Meeting.transcriptProcessing");
    if (status == 5) return t("Mobile.Meeting.transcriptDone");
    if (status == 6) return t("Mobile.Meeting.transcriptFailed");
    if (status == 7) return t("Mobile.Meeting.transcriptSkipped");
    return fallback;
  }

  function parseMembers(raw: UTSJSONObject[]): DetailMember[] {
    const list: DetailMember[] = [];
    for (let i = 0; i < raw.length; i++) {
      const item = raw[i];
      const member = new DetailMember();
      member.key = `${readStr(item, "userId")}-${i}`;
      const name = readStr(item, "displayName");
      member.name = name.length > 0 ? name : t("Mobile.Meeting.unnamedMember");
      member.host = readNum(item, "role", 1) == 2;
      list.push(member);
    }
    return list;
  }

  function parseFiles(raw: UTSJSONObject[]): DetailFile[] {
    const list: DetailFile[] = [];
    for (let i = 0; i < raw.length; i++) {
      const item = raw[i];
      const file = new DetailFile();
      file.id = readStr(item, "id");
      const filename = readStr(item, "filename");
      file.name = filename.length > 0 ? filename : `${t("Mobile.Meeting.recording")} ${i + 1}`;
      const contentType = readStr(item, "contentType").toLowerCase();
      const kind = readStr(item, "kind").toLowerCase();
      file.contentType = contentType;
      const mediaKind = meetingReplayKind(file.name, contentType);
      file.isVideo = mediaKind == "video" || (mediaKind.length == 0 && kind == "video");
      file.status = Math.floor(readNum(item, "status", 1));
      file.stateText = fileStateText(file.status, readStr(item, "statusText"));
      file.durationSec = readNum(item, "durationSec", 0);
      file.sizeBytes = readNum(item, "sizeBytes", 0);
      const metaParts: string[] = [];
      if (file.durationSec > 0) metaParts.push(formatDuration(file.durationSec));
      const sizeText = formatSize(file.sizeBytes);
      if (sizeText.length > 0) metaParts.push(sizeText);
      file.meta = metaParts.join(" · " );
      list.push(file);
    }
    return list;
  }

  function parseSpeakerName(names: UTSJSONObject | null, speakerId: number): string {
    if (speakerId >= 0 && names != null) {
      const value = names[`${speakerId}`];
      if (value != null) {
        const nameObj = value as UTSJSONObject;
        const name = readStr(nameObj, "name");
        if (name.length > 0) return name;
      }
    }
    if (speakerId < 0) return t("Mobile.Meeting.speakerUnknown");
    const params = new Map<string, string | number>();
    params.set("number", speakerId + 1);
    return translateFn("Mobile.Meeting.speakerNumber", toI18nParams(params), "");
  }

  function parseTranscripts(raw: UTSJSONObject[]): TranscriptBlock[] {
    const blocks: TranscriptBlock[] = [];
    for (let i = 0; i < raw.length; i++) {
      const item = raw[i];
      const block = new TranscriptBlock();
      block.fileId = readStr(item, "sourceFileId");
      block.status = Math.floor(readNum(item, "status", 0));
      block.statusText = transcriptStateText(block.status, readStr(item, "statusText"));
      const namesRaw = item["speakerNames"];
      const names = namesRaw != null ? (namesRaw as UTSJSONObject) : null;
      const segmentsRaw = item["segments"];
      const segments = segmentsRaw != null ? (segmentsRaw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
      const lines: TranscriptLine[] = [];
      if (block.status == 5) {
        for (let j = 0; j < segments.length; j++) {
          const segment = segments[j];
          const text = readStr(segment, "text").trim();
          if (text.length == 0) continue;
          const line = new TranscriptLine();
          line.key = `${block.fileId}-${j}`;
          line.fileId = block.fileId;
          line.beginMs = readNum(segment, "beginMs", 0);
          const speakerId = Math.floor(readNum(segment, "speakerId", -1));
          line.speaker = parseSpeakerName(names, speakerId);
          line.timeText = formatTimeline(line.beginMs);
          line.text = text;
          lines.push(line);
        }
      }
      block.lines = lines;
      blocks.push(block);
    }
    return blocks;
  }

  function findFile(fileId: string): DetailFile | null {
    const list = files.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].id == fileId) return list[i];
    }
    return null;
  }

  function firstReadyFileId(list: DetailFile[]): string {
    for (let i = 0; i < list.length; i++) {
      if (list[i].status == 2) return list[i].id;
    }
    return list.length > 0 ? list[0].id : "";
  }

  function ensureAudioContext(): InnerAudioContext {
    const existing = audioCtx;
    if (existing != null) return existing;
    const ctx = uni.createInnerAudioContext();
    ctx.onCanplay((): void => {
      audioLoading.value = false;
      if (ctx.duration > 0) audioDurationSec.value = ctx.duration;
      if (pendingSeekSec >= 0) {
        ctx.seek(pendingSeekSec);
        pendingSeekSec = -1;
      }
    });
    ctx.onPlay((): void => {
      playing.value = true;
      audioLoading.value = false;
    });
    ctx.onPause((): void => { playing.value = false; });
    ctx.onStop((): void => { playing.value = false; });
    ctx.onEnded((): void => {
      playing.value = false;
      currentSec.value = 0;
    });
    ctx.onTimeUpdate((): void => {
      currentSec.value = ctx.currentTime;
      if (ctx.duration > 0) audioDurationSec.value = ctx.duration;
    });
    ctx.onError((error): void => {
      console.error("[MeetingDetail] audio failed", error);
      playing.value = false;
      audioLoading.value = false;
      uni.showToast({ title: t("Mobile.Meeting.audioPlayFailed"), icon: "none" });
    });
    audioCtx = ctx;
    return ctx;
  }

  function stopAudio(): void {
    const ctx = audioCtx;
    if (ctx != null) ctx.stop();
    playing.value = false;
    currentSec.value = 0;
  }

  function destroyAudio(): void {
    const ctx = audioCtx;
    if (ctx != null) {
      ctx.stop();
      ctx.destroy();
      audioCtx = null;
    }
    playing.value = false;
  }

  async function loadAudio(fileId: string, seekSec: number, autoplay: boolean): Promise<void> {
    const file = findFile(fileId);
    if (file == null || file.status != 2 || file.id.length == 0) return;
    selectedFileId.value = fileId;
    const ctx = ensureAudioContext();
    if (audioLoadedFileId == fileId && ctx.src.length > 0) {
      if (seekSec >= 0) ctx.seek(seekSec);
      if (autoplay) ctx.play();
      return;
    }
    audioLoading.value = true;
    try {
      const res = await apiImMeetingRecordFileUrl(meetingId.value, fileId);
      if (apiResCode(res) != SUCCESS_CODE) {
        audioLoading.value = false;
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Meeting.audioPlayFailed"), icon: "none" });
        return;
      }
      const raw = apiResData<any>(res);
      const data = raw != null ? (raw as UTSJSONObject) : null;
      if (data == null) {
        audioLoading.value = false;
        return;
      }
      let url = readStr(data, "playUrl");
      if (url.length == 0) url = readStr(data, "url");
      if (url.length == 0) {
        audioLoading.value = false;
        const reason = readStr(data, "reason");
        uni.showToast({ title: reason.length > 0 ? reason : t("Mobile.Meeting.fileProcessing"), icon: "none" });
        return;
      }
      stopAudio();
      audioLoadedFileId = fileId;
      pendingSeekSec = seekSec;
      audioDurationSec.value = file.durationSec;
      ctx.src = url;
      if (autoplay) ctx.play();
    } catch (error) {
      console.error("[MeetingDetail] file url failed", error);
      audioLoading.value = false;
      uni.showToast({ title: t("Mobile.Meeting.audioPlayFailed"), icon: "none" });
    }
  }

  async function resolveFileUrl(file: DetailFile, download: boolean): Promise<string> {
    const res = await apiImMeetingRecordFileUrl(meetingId.value, file.id, download);
    if (apiResCode(res) != SUCCESS_CODE) {
      const message = apiResMessage(res);
      uni.showToast({ title: message.length > 0 ? message : t("Mobile.Meeting.audioPlayFailed"), icon: "none" });
      return "";
    }
    const raw = apiResData<any>(res);
    const data = raw != null ? (raw as UTSJSONObject) : null;
    if (data == null) return "";
    const url = meetingReplaySignedUrl(data, download);
    if (url.length == 0) {
      const reason = readStr(data, "reason");
      uni.showToast({ title: reason.length > 0 ? reason : t("Mobile.Meeting.fileProcessing"), icon: "none" });
    }
    return url;
  }

  function openVideoFile(file: DetailFile, seekSec: number = 0): void {
    if (!file.isVideo || file.status != 2 || file.id.length == 0 || replayLocked.value) return;
    stopAudio();
    uni.navigateTo({ url: meetingReplayVideoRoute(meetingId.value, file.id, seekSec) });
  }

  function openDownloadedFile(tempFilePath: string): Promise<void> {
    return new Promise<void>((resolve, _reject) => {
      // uni-app x Android 当前不支持持久化保存 API；沿用项目录音下载方案，
      // 下载到临时文件后交给系统应用打开，用户可在系统页面另存或分享。
      uni.openDocument({
        filePath: tempFilePath,
        success: () => {
          uni.showToast({ title: t("Mobile.Terminal.downloadDone"), icon: "none" });
          resolve();
        },
        fail: (_error) => {
          uni.showToast({ title: t("Mobile.Terminal.downloadOpenFailed"), icon: "none" });
          resolve();
        },
      });
    });
  }

  async function handleDownload(file: DetailFile): Promise<void> {
    if (downloadBusy.value || !host.value || replayLocked.value || file.status != 2 || file.id.length == 0) return;
    downloadBusy.value = true;
    downloadingFileId.value = file.id;
    try {
      const url = await resolveFileUrl(file, true);
      if (url.length == 0 || !pageAlive) return;
      // 视频下载必须保存到相册，不能用只支持文档类型的 openDocument 打开 MP4。
      // #ifdef APP || MP-WEIXIN
      if (file.isVideo) {
        // 共用保存方法已处理权限引导和错误提示，避免外层再次覆盖具体提示。
        try { await saveVideoToAlbumInApp(url); } catch (_saveError) {}
        return;
      }
      // #endif
      // #ifdef H5 || WEB
      const anchor = document.createElement("a");
      anchor.href = url;
      anchor.download = file.name;
      anchor.rel = "noopener";
      anchor.click();
      return;
      // #endif
      await new Promise<void>((resolve, _reject) => {
        uni.downloadFile({
          url,
          success: (result) => {
            const temp = result.tempFilePath != null ? `${result.tempFilePath}` : "";
            if (result.statusCode != 200 || temp.length == 0) {
              uni.showToast({ title: t("Mobile.Terminal.downloadFailed"), icon: "none" });
              resolve();
              return;
            }
            openDownloadedFile(temp).then((): void => { resolve(); });
          },
          fail: (_error) => {
            uni.showToast({ title: t("Mobile.Terminal.downloadFailed"), icon: "none" });
            resolve();
          },
        });
      });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Terminal.downloadFailed"), icon: "none" });
    } finally {
      downloadBusy.value = false;
      downloadingFileId.value = "";
    }
  }

  function applyDetail(data: UTSJSONObject): void {
    const meetingRaw = data["meeting"];
    if (meetingRaw == null) {
      hasMeeting.value = false;
      return;
    }
    const meeting = meetingRaw as UTSJSONObject;
    hasMeeting.value = true;
    roomName.value = readStr(meeting, "roomName");
    if (roomName.value.length == 0) roomName.value = readStr(data, "roomName");
    meetingTitle.value = meetingDisplayTitle(readStr(meeting, "title"), roomName.value);
    if (meetingTitle.value.length == 0) meetingTitle.value = fallbackTitle.value;
    meetingStatus.value = Math.floor(readNum(meeting, "status", -1));
    const statusText = readStr(meeting, "statusText");
    meetingStatusText.value = statusText.length > 0 ? statusText : meetingStatusFallback(meetingStatus.value);
    startText.value = formatTime(readStr(meeting, "startTime"));
    endText.value = formatTime(readStr(meeting, "endTime"));
    durationSec.value = readNum(meeting, "durationSec", 0);
    recordStatus.value = Math.floor(readNum(meeting, "recordStatus", 0));
    host.value = readBool(meeting, "host", false);
    replayVisible.value = readBool(data, "replayVisible", true);
    replayShared.value = readBool(data, "replayShared", false);
    const membersRaw = data["members"];
    members.value = membersRaw != null ? parseMembers(membersRaw as UTSJSONObject[]) : ([] as DetailMember[]);
    const filesRaw = data["files"];
    const allFiles = filesRaw != null ? parseFiles(filesRaw as UTSJSONObject[]) : ([] as DetailFile[]);
    const nextFiles = visibleMeetingReplayFiles(allFiles);
    files.value = nextFiles;
    const transcriptsRaw = data["transcripts"];
    const nextBlocks = transcriptsRaw != null
      ? parseTranscripts(transcriptsRaw as UTSJSONObject[])
      : ([] as TranscriptBlock[]);
    if (allFiles.length == 1) {
      for (let i = 0; i < nextBlocks.length; i++) {
        if (nextBlocks[i].fileId.length == 0) nextBlocks[i].fileId = nextFiles[0].id;
      }
    }
    transcriptBlocks.value = nextBlocks;
    if (findFile(selectedFileId.value) == null) {
      selectedFileId.value = firstReadyFileId(nextFiles);
    }
    const selected = findFile(selectedFileId.value);
    if (selected != null && audioDurationSec.value <= 0) audioDurationSec.value = selected.durationSec;
  }

  async function fetchDetail(silent: boolean): Promise<void> {
    if (meetingId.value.length == 0 || loading.value) return;
    loading.value = true;
    if (!silent) {
      failed.value = false;
      errorText.value = "";
    }
    try {
      const res = await apiImMeetingRecordDetail(meetingId.value, silent);
      if (apiResCode(res) != SUCCESS_CODE) {
        if (!silent) {
          failed.value = true;
          const message = apiResMessage(res);
          errorText.value = message.length > 0 ? message : t("Mobile.Meeting.loadFailed");
        }
        return;
      }
      const raw = apiResData<any>(res);
      const data = raw != null ? (raw as UTSJSONObject) : null;
      if (data == null) {
        if (!silent) {
          failed.value = true;
          errorText.value = t("Mobile.Meeting.loadFailed");
        }
        return;
      }
      applyDetail(data);
      ready.value = true;
      failed.value = false;
    } catch (error) {
      console.error("[MeetingDetail] load failed", error);
      if (!silent) {
        failed.value = true;
        errorText.value = t("Mobile.Meeting.loadFailed");
      }
    } finally {
      loading.value = false;
    }
  }

  function handleRefresh(): void {
    if (!loading.value) fetchDetail(false);
  }

  function handleFileClick(file: DetailFile): void {
    selectedFileId.value = file.id;
    if (file.status == 2) {
      if (file.isVideo) {
        void openVideoFile(file);
        return;
      }
      if (audioLoadedFileId != file.id) {
        stopAudio();
        audioDurationSec.value = file.durationSec;
      }
      return;
    }
    uni.showToast({ title: file.stateText, icon: "none" });
  }

  function handlePlayToggle(): void {
    const file = findFile(selectedFileId.value);
    if (file == null || file.status != 2) return;
    if (file.isVideo) {
      void openVideoFile(file);
      return;
    }
    const ctx = ensureAudioContext();
    if (playing.value && audioLoadedFileId == file.id) {
      ctx.pause();
      return;
    }
    loadAudio(file.id, -1, true);
  }

  function handleSeek(event: UniSliderChangeEvent): void {
    const value = event.detail.value;
    const seconds = typeof value == "number" ? (value as number) : parseFloat(`${value}`);
    if (seconds != seconds) return;
    currentSec.value = seconds;
    const ctx = audioCtx;
    if (audioLoadedFileId == selectedFileId.value && ctx != null) {
      ctx.seek(seconds);
    }
  }

  function handleTranscriptClick(line: TranscriptLine): void {
    const file = findFile(line.fileId);
    if (file == null) return;
    if (file.isVideo) {
      openVideoFile(file, Math.max(0, line.beginMs / 1000));
      return;
    }
    loadAudio(line.fileId, Math.max(0, line.beginMs / 1000), true);
  }

  const roomLabel = computed((): string => {
    const formatted = formatMeetingId(roomName.value);
    return formatted.length > 0 ? formatted : "—";
  });

  const durationText = computed((): string => durationSec.value > 0 ? formatDuration(durationSec.value) : "—");

  const membersHeading = computed((): string => {
    const params = new Map<string, string | number>();
    params.set("count", members.value.length);
    return translateFn("Mobile.Meeting.detailMembers", toI18nParams(params), "");
  });

  const replayLocked = computed((): boolean => !host.value && replayVisible.value == false);

  const replayLockedHint = computed((): string => replayShared.value
    ? t("Mobile.Meeting.replayNotSharedToMe")
    : t("Mobile.Meeting.replayNotShared"));

  const selectedVideo = computed((): boolean => {
    const file = findFile(selectedFileId.value);
    return file != null && file.isVideo;
  });

  const selectedReady = computed((): boolean => {
    const file = findFile(selectedFileId.value);
    return file != null && file.status == 2;
  });

  const selectedTranscriptBlock = computed((): TranscriptBlock | null => {
    const blocks = transcriptBlocks.value;
    for (let i = 0; i < blocks.length; i++) {
      if (blocks[i].fileId == selectedFileId.value) return blocks[i];
    }
    return null;
  });

  const selectedTranscriptLines = computed((): TranscriptLine[] => {
    const block = selectedTranscriptBlock.value;
    return block != null ? block.lines : ([] as TranscriptLine[]);
  });

  const transcriptStatusText = computed((): string => {
    const block = selectedTranscriptBlock.value;
    return block != null ? block.statusText : "";
  });

  const transcriptEmptyText = computed((): string => {
    const block = selectedTranscriptBlock.value;
    if (block == null) return t("Mobile.Meeting.transcriptEmpty");
    if (block.status >= 1 && block.status <= 4) return t("Mobile.Meeting.transcriptProcessingHint");
    if (block.status == 6) return t("Mobile.Meeting.transcriptFailedHint");
    if (block.status == 7) return t("Mobile.Meeting.transcriptSkippedHint");
    return t("Mobile.Meeting.transcriptEmpty");
  });

  const needsPolling = computed((): boolean => {
    const fileList = files.value;
    for (let i = 0; i < fileList.length; i++) {
      if (fileList[i].status == 1) return true;
    }
    const blocks = transcriptBlocks.value;
    for (let i = 0; i < blocks.length; i++) {
      if (blocks[i].status >= 1 && blocks[i].status <= 4) return true;
    }
    return false;
  });

  const recordBadgeText = computed((): string => {
    if (recordStatus.value == 1) return t("Mobile.Meeting.tagRecording");
    if (recordStatus.value == 3) return t("Mobile.Meeting.tagRecordFailed");
    if (recordStatus.value == 2 && needsPolling.value) return t("Mobile.Meeting.tagRecordingTranscribing");
    if (recordStatus.value == 2) return t("Mobile.Meeting.tagRecorded");
    return t("Mobile.Meeting.tagNoRecording");
  });

  const statusTone = computed((): string => {
    if (recordStatus.value == 1 || (recordStatus.value == 2 && needsPolling.value)) return "running";
    if (recordStatus.value == 2) return "ok";
    if (recordStatus.value == 3) return "failed";
    return "none";
  });

  const statusClass = computed((): string => `status status--${statusTone.value}`);
  const statusTextClass = computed((): string => `status__text status__text--${statusTone.value}`);
  const sliderMax = computed((): number => Math.max(1, Math.floor(audioDurationSec.value)));
  const sliderValue = computed((): number => Math.min(sliderMax.value, Math.floor(currentSec.value)));
  const currentTimeText = computed((): string => formatDuration(currentSec.value));
  const totalTimeText = computed((): string => formatDuration(audioDurationSec.value));

  function startPolling(): void {
    if (pollTimer != 0) clearInterval(pollTimer);
    pollTimer = setInterval((): void => {
      if (needsPolling.value && !loading.value) fetchDetail(true);
    }, 5000);
  }

  function stopPolling(): void {
    if (pollTimer != 0) {
      clearInterval(pollTimer);
      pollTimer = 0;
    }
  }

  onLoad((options: any): void => {
    if (options != null) {
      const params = options as UTSJSONObject;
      meetingId.value = readStr(params, "id");
      fallbackTitle.value = readStr(params, "title");
    }
    setCurrentPageNavigationBarTitle();
    if (meetingId.value.length == 0) {
      failed.value = true;
      errorText.value = t("Mobile.Meeting.detailMissing");
      return;
    }
    fetchDetail(false);
    startPolling();
  });

  onUnload((): void => {
    pageAlive = false;
    stopPolling();
    destroyAudio();
  });
</script>

<style lang="scss" scoped>
  .page {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #f5f6f8;
  }

  .scroll {
    flex: 1;
    min-height: 0;
  }

  .nav-refresh {
    width: 72rpx;
    height: 72rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-refresh--busy { opacity: 0.45; }
  .nav-refresh__text { font-size: 40rpx; color: #5147ff; }

  .state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48rpx;
  }

  .state__text { font-size: 28rpx; color: #85818d; text-align: center; }
  .state__button { margin-top: 28rpx; padding: 16rpx 36rpx; border-radius: 18rpx; background: #5147ff; }
  .state__button--active { opacity: 0.8; }
  .state__button-text { font-size: 26rpx; color: #ffffff; font-weight: 600; }

  .card {
    margin: 24rpx 24rpx 0;
    padding: 30rpx;
    border-radius: 24rpx;
    background: #ffffff;
  }

  .title-row { display: flex; flex-direction: row; align-items: flex-start; }
  .meeting-title { flex: 1; min-width: 0; font-size: 36rpx; line-height: 48rpx; color: #23212a; font-weight: 700; }

  .status { margin-left: 16rpx; padding: 7rpx 14rpx; border-radius: 999rpx; background: #f1f0f5; }
  .status--running { background: #fff4df; }
  .status--ok { background: #eaf8f0; }
  .status--failed { background: #fff0f0; }
  .status__text { font-size: 22rpx; color: #77727f; }
  .status__text--running { color: #bd7100; }
  .status__text--ok { color: #18874c; }
  .status__text--failed { color: #c33b3b; }

  .facts { margin-top: 26rpx; padding-top: 18rpx; border-top: 2rpx solid #f1f1f4; }
  .fact { min-height: 52rpx; display: flex; flex-direction: row; align-items: center; }
  .fact__label { width: 160rpx; flex-shrink: 0; font-size: 25rpx; color: #97939d; }
  .fact__value { flex: 1; font-size: 26rpx; color: #43404a; text-align: right; }

  .members-block { margin-top: 22rpx; padding-top: 20rpx; border-top: 2rpx solid #f1f1f4; }
  .block-label { font-size: 26rpx; color: #55515d; font-weight: 600; }
  .members { margin-top: 14rpx; display: flex; flex-direction: row; flex-wrap: wrap; }
  .member { margin-right: 12rpx; margin-bottom: 12rpx; padding: 9rpx 14rpx; border-radius: 12rpx; background: #f5f4f8; display: flex; flex-direction: row; align-items: center; }
  .member__name { font-size: 24rpx; color: #4b4752; }
  .member__host { margin-left: 8rpx; font-size: 20rpx; color: #5147ff; }
  .empty-inline { margin-top: 14rpx; font-size: 24rpx; color: #aaa6b0; }

  .section-head { margin: 32rpx 28rpx 0; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
  .section-head__title { font-size: 29rpx; color: #34313a; font-weight: 700; }
  .section-head__note { margin-left: 16rpx; font-size: 23rpx; color: #9b96a2; }
  .replay-card, .transcript-card { margin-top: 14rpx; }

  .empty-box { min-height: 120rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20rpx; }
  .empty-box__title { font-size: 27rpx; color: #85818d; text-align: center; }
  .empty-box__hint { margin-top: 12rpx; font-size: 23rpx; line-height: 34rpx; color: #aaa6b0; text-align: center; }

  .file-row { min-height: 94rpx; display: flex; flex-direction: row; align-items: center; padding: 0 16rpx; border-radius: 16rpx; border: 2rpx solid transparent; }
  .file-row + .file-row { margin-top: 8rpx; }
  .file-row--selected { border-color: #d8d4ff; background: #f7f6ff; }
  .file-row--off { opacity: 0.7; }
  .file-row__main { flex: 1; min-width: 0; }
  .file-row__name { font-size: 26rpx; color: #403c47; }
  .file-row__meta { margin-top: 5rpx; font-size: 22rpx; color: #aaa6b0; }
  .file-row__state { margin-left: 16rpx; font-size: 23rpx; color: #a17a35; }
  .file-row__state--ready { color: #18874c; }

  .player { margin-top: 22rpx; padding-top: 22rpx; border-top: 2rpx solid #f1f1f4; }
  .player__top { display: flex; flex-direction: row; align-items: center; }
  .play-button { width: 72rpx; height: 72rpx; border-radius: 36rpx; background: #5147ff; display: flex; align-items: center; justify-content: center; }
  .play-button--active { opacity: 0.8; }
  .play-button__text { position: relative; left: 3rpx; font-size: 36rpx; line-height: 40rpx; color: #ffffff; }
  .player__time { margin-left: 20rpx; font-size: 25rpx; color: #5c5863; }
  .player__loading { margin-left: auto; font-size: 23rpx; color: #9994a1; }
  .file-download { margin-left: 16rpx; flex-shrink: 0; min-width: 96rpx; height: 56rpx; padding: 0 18rpx; border-radius: 28rpx; background: #17171a; display: flex; align-items: center; justify-content: center; }
  .file-download--busy { opacity: 0.55; }
  .file-download--active { opacity: 0.75; }
  .file-download__text { font-size: 23rpx; color: #ffffff; }
  .player__slider { margin: 18rpx 0 0; }

  .transcript-list { width: 100%; }
  .transcript-line { padding: 18rpx 12rpx; border-radius: 14rpx; }
  .transcript-line + .transcript-line { border-top: 2rpx solid #f4f3f6; }
  .transcript-line--active { background: #f7f6ff; }
  .transcript-line__head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
  .transcript-line__speaker { font-size: 24rpx; color: #5147ff; font-weight: 600; }
  .transcript-line__time { font-size: 22rpx; color: #aaa6b0; }
  .transcript-line__text { margin-top: 10rpx; font-size: 27rpx; line-height: 42rpx; color: #4b4752; }

  .bottom-space { height: 60rpx; }
</style>
