import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import type { RequestResponse } from "@/types/interfaces/request";

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

/**
 * 会议与监控录音共用的下载处理。
 * 调用方只负责提供各自的临时地址请求，并维护行内 downloading 状态。
 */
export async function downloadVoxRecording(
  audioUrlRequest: Promise<RequestResponse<any>>,
): Promise<void> {
  const res = await audioUrlRequest;
  if (apiResCode(res) != SUCCESS_CODE) {
    const msg = apiResMessage(res);
    uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.downloadFailed"), icon: "none" });
    return;
  }
  const raw = apiResData<any>(res);
  const obj = raw != null ? (raw as UTSJSONObject) : null;
  const urlVal = obj != null ? obj["url"] : null;
  const url = urlVal != null ? `${urlVal}` : "";
  if (url == "") {
    uni.showToast({ title: t("Mobile.Terminal.downloadFailed"), icon: "none" });
    return;
  }
  await new Promise<void>((resolve, _reject) => {
    uni.downloadFile({
      url: url,
      success: (dl) => {
        if (dl.statusCode != 200) {
          uni.showToast({ title: t("Mobile.Terminal.downloadFailed"), icon: "none" });
          resolve();
          return;
        }
        // App 沙箱缓存通常不在文件管理器中展示，交给系统应用打开后可另存或分享。
        uni.openDocument({
          filePath: dl.tempFilePath,
          success: () => {
            uni.showToast({ title: t("Mobile.Terminal.downloadDone"), icon: "none" });
            resolve();
          },
          fail: () => {
            uni.showToast({ title: t("Mobile.Terminal.downloadOpenFailed"), icon: "none" });
            resolve();
          },
        });
      },
      fail: (_e) => {
        uni.showToast({ title: t("Mobile.Terminal.downloadFailed"), icon: "none" });
        resolve();
      },
    });
  });
}
