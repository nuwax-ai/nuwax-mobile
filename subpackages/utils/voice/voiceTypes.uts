/**
 * 语音会话模块类型定义。
 * UTS/Android 兼容：需要构造的类型一律用 class，不用 interface 字面量。
 */

/** 播放队列项 */
export class AudioQueueItem {
  /** 音频地址（远程 URL 或本地路径），为空时播放器自动跳过 */
  src: string = "";
  /** 所属消息 ID */
  messageId: string = "";
  /** 分段序号 */
  segmentIndex: number = 0;
  /** 对应文本（调试/日志用） */
  text: string = "";
}

/** 播放器状态 */
export type AudioPlayerState = "idle" | "playing" | "error";

/** 播放状态变化回调 */
export type OnPlayerStateChange = (state: AudioPlayerState, messageId: string) => void;

/** 语音播报设置（含内容过滤项），持久化到 storage */
export class VoiceSettings {
  /** 全局自动播报：开启后所有 AI 回复边生成边播报 */
  autoPlay: boolean = false;
  /** 语音输入的轮次自动播报（不需要打开全局开关） */
  voiceRoundAutoPlay: boolean = true;
  /** 朗读思考内容（thinkContent） */
  includeThinkContent: boolean = false;
  /** 朗读代码块内容（关闭时整段跳过） */
  includeCodeBlocks: boolean = false;
  /** 朗读链接地址（关闭时只读链接文字，不读 URL） */
  includeLinkUrl: boolean = false;
  /** 保留 emoji（关闭时过滤） */
  keepEmoji: boolean = false;
}

/** 语音设置持久化 key */
export const VOICE_SETTINGS_STORAGE_KEY = "VOICE_SETTINGS";

/** 克隆设置（uts 不支持 class spread；用于触发响应式更新） */
export function cloneVoiceSettings(source: VoiceSettings): VoiceSettings {
  const next = new VoiceSettings();
  next.autoPlay = source.autoPlay;
  next.voiceRoundAutoPlay = source.voiceRoundAutoPlay;
  next.includeThinkContent = source.includeThinkContent;
  next.includeCodeBlocks = source.includeCodeBlocks;
  next.includeLinkUrl = source.includeLinkUrl;
  next.keepEmoji = source.keepEmoji;
  return next;
}

/** 持久化语音设置 */
export function saveVoiceSettings(settings: VoiceSettings): void {
  const obj = {} as UTSJSONObject;
  obj["autoPlay"] = settings.autoPlay;
  obj["voiceRoundAutoPlay"] = settings.voiceRoundAutoPlay;
  obj["includeThinkContent"] = settings.includeThinkContent;
  obj["includeCodeBlocks"] = settings.includeCodeBlocks;
  obj["includeLinkUrl"] = settings.includeLinkUrl;
  obj["keepEmoji"] = settings.keepEmoji;
  uni.setStorageSync(VOICE_SETTINGS_STORAGE_KEY, JSON.stringify(obj));
}

/** 读取持久化的语音设置（Android 兼容：bracket 取值 + 字符串化判 true） */
export function loadVoiceSettings(): VoiceSettings {
  const settings = new VoiceSettings();
  const raw = uni.getStorageSync(VOICE_SETTINGS_STORAGE_KEY);
  if (raw == null) {
    return settings;
  }
  const text = `${raw}`;
  if (text.length == 0) {
    return settings;
  }
  try {
    const obj = JSON.parse<UTSJSONObject>(text);
    if (obj == null) {
      return settings;
    }
    const autoPlay = obj["autoPlay"];
    if (autoPlay != null) {
      settings.autoPlay = `${autoPlay}` == "true";
    }
    const voiceRound = obj["voiceRoundAutoPlay"];
    if (voiceRound != null) {
      settings.voiceRoundAutoPlay = `${voiceRound}` == "true";
    }
    const think = obj["includeThinkContent"];
    if (think != null) {
      settings.includeThinkContent = `${think}` == "true";
    }
    const code = obj["includeCodeBlocks"];
    if (code != null) {
      settings.includeCodeBlocks = `${code}` == "true";
    }
    const link = obj["includeLinkUrl"];
    if (link != null) {
      settings.includeLinkUrl = `${link}` == "true";
    }
    const emoji = obj["keepEmoji"];
    if (emoji != null) {
      settings.keepEmoji = `${emoji}` == "true";
    }
  } catch (e: any) {
    console.warn("[VoiceSettings] load failed", e);
  }
  return settings;
}

/** 流式识别文本回调：text 为当前累计识别文本（非增量） */
export type OnAsrText = (text: string, isFinal: boolean) => void;

/** 分句提取结果（流式场景） */
export class SentenceDrainResult {
  /** 已完结的句子 */
  sentences: string[] = [];
  /** 未完结的剩余文本（留待下次处理） */
  remainder: string = "";
}
