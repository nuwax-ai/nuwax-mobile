/**
 * nuwax-harmony-album-picker 接口（仅 app-harmony）。
 *
 * 背景：uni-app x 鸿蒙运行时的 uni.chooseMedia 在 mediaType 为图+视频混选（非
 * 单值 image/video）时无视 sourceType:["album"]，先弹自家「拍摄/从相册选择」
 * action sheet，与业务侧已有的二选一弹窗叠成双层。本插件直开系统
 * PhotoViewPicker（IMAGE_VIDEO_TYPE），等价运行时的相册分支
 * （isPhotoTakingSupported=false，不出拍摄入口），绕开该 sheet。
 */

/**
 * 成功：用户确认选择。paths 与 isVideos 等长一一对应；path 为 **cacheDir 下的沙箱
 * 副本**（媒体库 URI 的读授权只在本会话可靠，草稿回显/跨页预览要长期可读，故插件内
 * 已复制；复制失败回退原媒体库 URI），文件名保留媒体库原名，可直接入上传/预览/播放链路；
 * isVideo=true 走视频入队（无扩展名时调用方补 .mp4），false 走图片暂存。
 */
export type HarmonyAlbumSuccessCallback = (paths: string[], isVideos: boolean[]) => void;

/**
 * 失败。code：CANCEL=用户取消（部分版本以空结果 resolve、部分以 reject 返回，
 * 插件内统一归此码）；ERROR=拉起选择器异常。选择器为系统安全控件、无需媒体
 * 权限，故无权限类错误码。
 */
export type HarmonyAlbumFailCallback = (code: string, message: string) => void;

/** 直开鸿蒙系统相册选择器（图+视频混选，无拍摄入口）。count=可选条数上限。 */
export type PickHarmonyAlbumMediaApi = (
  count: number,
  success: HarmonyAlbumSuccessCallback,
  fail: HarmonyAlbumFailCallback,
) => void;
