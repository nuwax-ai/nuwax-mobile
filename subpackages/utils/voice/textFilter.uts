/**
 * 朗读文本过滤器：Markdown → 可朗读纯文本，以及按句切分。
 * 注意：uts 正则编译为 Kotlin Regex——不使用 \u{...} 与 m 标志（行锚点用 (?:^|\n) 替代）。
 */
import { VoiceSettings, SentenceDrainResult } from "./voiceTypes";

/** 句末标点（换行视为停顿） */
const SENTENCE_END_CHARS = "。！？!?；;\n";

/** 单句最大长度，超过强制切分（流式场景防积压） */
const MAX_SENTENCE_LENGTH = 120;

/**
 * 仅保留可朗读正文：去掉 think / 工具调用 / agent-info 等非正文结构。
 * 供工具栏手动播报与流式播报共用，避免合成超长无效文本导致「图标在转、迟迟无声」。
 */
export function stripNonSpeakableMarkup(raw: string): string {
  if (raw.length == 0) {
    return "";
  }
  let text = raw;

  // think / 推理块（含未闭合）
  text = text.replace(/<think\b[^>]*>[\s\S]*?<\/think>/gi, " ");
  text = text.replace(/<think\b[^>]*>[\s\S]*$/gi, " ");
  text = text.replace(/<\/?think\b[^>]*>/gi, " ");

  // 工具调用 HTML（group / 单标签 / 自闭合）
  text = text.replace(
    /<markdown-custom-process-group\b[^>]*>[\s\S]*?<\/markdown-custom-process-group>/gi,
    " ",
  );
  text = text.replace(
    /<markdown-custom-process\b[^>]*>[\s\S]*?<\/markdown-custom-process>/gi,
    " ",
  );
  text = text.replace(/<markdown-custom-process\b[^>]*\/>/gi, " ");
  text = text.replace(/<\/?markdown-custom-process\b[^>]*>/gi, " ");

  // :::container 整块（属性行 + 下一行 :::）
  text = text.replace(
    /(?:^|\n)[ \t]*:::container\b[^\n]*\n[ \t]*:::[ \t]*(?=\n|$)/gi,
    "\n",
  );
  // 残余 ::: 指令行
  text = text.replace(/(?:^|\n)[ \t]*:::[^\n]*/g, "\n");

  // task-result
  text = text.replace(/<task-result\b[^>]*>[\s\S]*?<\/task-result>/gi, " ");
  text = text.replace(/<task-result\b[^>]*>[\s\S]*$/gi, " ");

  // agent-info / agent
  text = text.replace(/<agent-info\b[^>]*>[\s\S]*?<\/agent-info>/gi, " ");
  text = text.replace(/<agent-info\b[^>]*\/>/gi, " ");
  text = text.replace(/<agent\b[^>]*>[\s\S]*?<\/agent>/gi, " ");
  text = text.replace(/<agent\b[^>]*\/>/gi, " ");

  // 其他带连字符业务自定义元素
  text = text.replace(
    /<([a-zA-Z][a-zA-Z0-9]*-[a-zA-Z0-9-]+)\b[^>]*>[\s\S]*?<\/\1>/g,
    " ",
  );
  text = text.replace(
    /<[a-zA-Z][a-zA-Z0-9]*-[a-zA-Z0-9-]+\b[^>]*\/>/g,
    " ",
  );

  return text;
}

/**
 * 将 Markdown 文本清洗为可朗读的纯文本
 * @param raw 原始文本
 * @param settings 过滤设置，为空时按默认（过滤代码块/链接URL/emoji）
 */
export function cleanTextForSpeech(raw: string, settings: VoiceSettings | null = null): string {
  if (raw.length == 0) {
    return "";
  }
  const opts = settings != null ? settings! : new VoiceSettings();
  // 先剥离 think / 工具调用等，再做通用 Markdown 清洗
  let text = stripNonSpeakableMarkup(raw);

  // 1. fenced 代码块 ```...```
  if (opts.includeCodeBlocks) {
    // 保留代码内容，仅去掉围栏标记与语言标识
    text = text.replace(/```[a-zA-Z0-9+#-]*/g, "\n");
  } else {
    // 整段移除（含未闭合的流式中间态）
    text = text.replace(/```[\s\S]*?```/g, "\n");
    text = text.replace(/```[\s\S]*$/g, "\n");
  }

  // 2. 行内代码
  if (opts.includeCodeBlocks) {
    text = text.replace(/`([^`]*)`/g, "$1");
  } else {
    text = text.replace(/`[^`\n]*`/g, " ");
  }

  // 3. 图片 ![alt](url) —— 不可朗读，直接移除
  text = text.replace(/!\[[^\]]*\]\([^)]*\)/g, " ");

  // 4. 链接 [text](url)
  if (opts.includeLinkUrl) {
    text = text.replace(/\[([^\]]*)\]\(([^)]*)\)/g, "$1，$2");
  } else {
    // 只保留链接文字
    text = text.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1");
    // 裸 URL 移除
    text = text.replace(/https?:\/\/[^\s)\]>"]+/g, " ");
  }

  // 5. 剩余普通 HTML 标签仅剥离标签，保留用户可见正文。
  text = text.replace(/<[^>\n]+>/g, " ");

  // 6. 表格：分隔行整行移除；数据行竖线转为停顿
  text = text.replace(/(?:^|\n)[|:\- \t]+-{2,}[|:\- \t]*(?=\n|$)/g, "\n");
  text = text.replace(/\|/g, "，");

  // 7. 标题 / 引用 / 列表标记
  text = text.replace(/(?:^|\n)#{1,6}[ \t]+/g, "\n");
  text = text.replace(/(?:^|\n)[ \t]*>[ \t]?/g, "\n");
  text = text.replace(/(?:^|\n)[ \t]*[-*+][ \t]+/g, "\n");
  text = text.replace(/(?:^|\n)[ \t]*\d+\.[ \t]+/g, "\n");

  // 8. 加粗 / 斜体 / 删除线标记
  text = text.replace(/\*\*([^*]+)\*\*/g, "$1");
  text = text.replace(/\*([^*\n]+)\*/g, "$1");
  text = text.replace(/__([^_]+)__/g, "$1");
  text = text.replace(/~~([^~]+)~~/g, "$1");

  // 9. emoji
  if (!opts.keepEmoji) {
    // 增补平面 emoji（代理对）
    text = text.replace(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g, "");
    // BMP 符号（箭头、杂项符号、变体选择符等）
    text = text.replace(/[\u2190-\u27BF\u2B00-\u2BFF\uFE0F]/g, "");
  }

  // 10. 空白规整
  text = text.replace(/[ \t]+/g, " ");
  text = text.replace(/\n[ \t]+/g, "\n");
  text = text.replace(/\n{3,}/g, "\n\n");

  return text.trim();
}

/**
 * 将完整文本切分为可朗读的句子（用于整段播放）
 */
export function extractSpeakableSentences(text: string, maxLength: number = MAX_SENTENCE_LENGTH): string[] {
  const sentences: string[] = [];
  let buffer = "";
  for (let i = 0; i < text.length; i++) {
    const ch = text.charAt(i);
    buffer += ch;
    if (SENTENCE_END_CHARS.indexOf(ch) >= 0 || buffer.length >= maxLength) {
      const sentence = buffer.trim();
      if (sentence.length > 0) {
        sentences.push(sentence);
      }
      buffer = "";
    }
  }
  const tail = buffer.trim();
  if (tail.length > 0) {
    sentences.push(tail);
  }
  return sentences;
}

/**
 * 流式场景：从缓冲区提取"已完结"的句子，未完结部分留作 remainder。
 * @param buffer 待处理文本（通常为上次的 remainder + 本次增量）
 * @param flush 为 true 时（流结束）剩余文本全部作为句子输出
 */
export function drainCompleteSentences(buffer: string, flush: boolean): SentenceDrainResult {
  const result = new SentenceDrainResult();
  let current = "";
  for (let i = 0; i < buffer.length; i++) {
    const ch = buffer.charAt(i);
    current += ch;
    if (SENTENCE_END_CHARS.indexOf(ch) >= 0) {
      const sentence = current.trim();
      if (sentence.length > 0) {
        result.sentences.push(sentence);
      }
      current = "";
    }
  }
  if (flush) {
    const tail = current.trim();
    if (tail.length > 0) {
      result.sentences.push(tail);
    }
    result.remainder = "";
  } else if (current.length >= MAX_SENTENCE_LENGTH) {
    // 超长未完结文本强制切出，避免无限积压
    const sentence = current.trim();
    if (sentence.length > 0) {
      result.sentences.push(sentence);
    }
    result.remainder = "";
  } else {
    result.remainder = current;
  }
  return result;
}
