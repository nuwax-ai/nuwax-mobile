import { AgentComponentTypeEnum } from '../enums/agent';

// 智能体分类信息
// UTS Android: Gson 无法实例化 interface，须用 class
export class CategoryInfo {
  name: string = "";
  type: string = "";
  categoryType: string = "";
}

// 智能体分类项详细信息
// UTS Android: Gson 无法实例化 interface，须用 class
// statistics/publishUser 用 any 避免 Gson 解析嵌套 interface 崩溃
export class CategoryItemInfo {
  targetType: AgentComponentTypeEnum = AgentComponentTypeEnum.Plugin;
  targetId: number = 0;
  name: string = "";
  description: string = "";
  icon: string = "";
  // App 端远程 SVG 按显示尺寸解析后的地址（H5/小程序与 icon 相同）；导航跳转仍使用原始 icon
  resolvedIcon: string = "";
  statistics: any | null = null;
  publishUser: any | null = null;
  collect: boolean = false;
}

// 主页智能体分类列表
export class HomeAgentCategoryInfo {
  // 首页分类
  categories: CategoryInfo[] = [] as CategoryInfo[];
  // 首页分类数据列表
  categoryItems: Record<string, CategoryItemInfo[]> = new Map<string, CategoryItemInfo[]>() as Record<string, CategoryItemInfo[]>;
}

/**
 * 静态文件相关类型定义
 */
export interface StaticFileInfo {

  // 文件ID(自定义文件ID)
  fileId?: string;
  // 文件名称
  name: string;
  // 是否为二进制文件
  binary: boolean;
  // 文件大小是否超过限制
  sizeExceeded: boolean;
  // 文件内容
  contents: string;
  // 文件代理URL
  fileProxyUrl: string;
  // 是否为目录
  isDir: boolean;
}

// 静态文件列表
export interface StaticFileListResponse {

  // 文件列表
  files: StaticFileInfo[];
}

/** 下载全部静态文件接口返回（H5 为 Blob，其他平台 data 可为 null） */
export interface DownloadAllFilesResult {
  data: any;
  headers: any;
}