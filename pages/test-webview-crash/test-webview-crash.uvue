<template>
  <view class="page">
    <text class="title">iOS 26 webview 崩溃最小复现</text>
    <text class="status">场景: {{ scenario }}</text>
    <text class="status">进度: {{ progress }}</text>
    <text class="status">最近日志: {{ lastLog }}</text>
    <button class="btn" @click="runChurn">A: 纯建销 ×20</button>
    <button class="btn" @click="runPushStateStorm">B: pushState 风暴 ×200</button>
    <button class="btn" @click="runMixed">C: 混合（建销+风暴）</button>
    <text class="tip">崩了不用管，看 HX 控制台最后一行日志定位场景</text>

    <!-- 被测 webview：v-if 控制建销；加载真实 H5（与 agent-detail 同款负载） -->
    <web-view
      v-if="wvAlive"
      id="crash-test-wv"
      class="test-wv"
      :src="wvSrc"
      @load="onWvLoad"
    />
  </view>
</template>

<script setup lang="uts">
  import { ref, getCurrentInstance } from "vue";

  // 与 agent-detail 相同的数据面：完整 H5 应用（hash 路由，加载即有 BFL 流量）
  const WV_SRC = "https://testagent.xspaceagi.com/m/";

  const scenario = ref<string>("待启动");
  const progress = ref<string>("-");
  const lastLog = ref<string>("-");
  const wvAlive = ref<boolean>(false);
  const wvSrc = ref<string>(WV_SRC);
  let wvLoaded = false;
  let seq = 0;

  const instance = getCurrentInstance();

  function log(msg: string): void {
    seq = seq + 1;
    const line = `#${seq} ${msg}`;
    lastLog.value = line;
    console.log(`[wv-crash-test] ${line}`);
  }

  function onWvLoad(_e: UniWebViewLoadEvent): void {
    wvLoaded = true;
    log("web-view @load 到达");
  }

  function sleep(ms: number): Promise<void> {
    return new Promise<void>((resolve, _reject) => {
      setTimeout(() => {
        resolve();
      }, ms);
    });
  }

  /** 对当前存活 webview 执行一次 pushState（每条 = 一次 BFL 更新回传 UI 进程） */
  function pushStateOnce(i: number): void {
    try {
      const ctx = uni.createWebviewContext("crash-test-wv", instance?.proxy);
      ctx.evalJS(`try{history.pushState({},'',location.pathname+'#t${i}')}catch(e){}`);
    } catch (e) {
      log(`pushState evalJS 异常(忽略): ${e}`);
    }
  }

  /** 等待 @load（带超时；H5 冷加载可能较慢） */
  async function waitLoaded(timeoutMs: number): Promise<void> {
    const start = Date.now();
    while (wvLoaded == false) {
      if (Date.now() - start > timeoutMs) {
        log(`等待 @load 超时 ${timeoutMs}ms，继续`);
        return;
      }
      await sleep(100);
    }
  }

  /** A: 纯建销 —— 只挂载/卸载，无脚本干预 */
  async function runChurn(): Promise<void> {
    scenario.value = "A 纯建销";
    const TOTAL = 20;
    for (let i = 1; i <= TOTAL; i++) {
      wvLoaded = false;
      log(`A cycle${i}/${TOTAL} mount`);
      wvAlive.value = true;
      await waitLoaded(6000);
      await sleep(800);
      log(`A cycle${i}/${TOTAL} unmount`);
      wvAlive.value = false;
      await sleep(400);
      progress.value = `${i}/${TOTAL}`;
    }
    log("A 纯建销完成，未崩");
  }

  /** B: 单 webview 常驻 + pushState 风暴（无建销，纯 BFL 流量） */
  async function runPushStateStorm(): Promise<void> {
    scenario.value = "B pushState 风暴";
    wvLoaded = false;
    log("B mount（一次性）");
    wvAlive.value = true;
    await waitLoaded(8000);
    const TOTAL = 200;
    for (let i = 1; i <= TOTAL; i++) {
      if (i % 20 == 1) {
        log(`B pushState ${i}/${TOTAL}`);
      }
      pushStateOnce(i);
      await sleep(30);
      progress.value = `${i}/${TOTAL}`;
    }
    log("B pushState 风暴完成，未崩（webview 保持挂载）");
  }

  /** C: 混合 —— 建销 + 每周期若干 pushState（最接近 agent-detail 来回切换 + H5 hash 路由） */
  async function runMixed(): Promise<void> {
    scenario.value = "C 混合";
    const TOTAL = 10;
    for (let i = 1; i <= TOTAL; i++) {
      wvLoaded = false;
      log(`C cycle${i}/${TOTAL} mount`);
      wvAlive.value = true;
      await waitLoaded(6000);
      for (let p = 1; p <= 10; p++) {
        log(`C cycle${i} pushState ${p}/10`);
        pushStateOnce(p);
        await sleep(50);
      }
      log(`C cycle${i}/${TOTAL} unmount`);
      wvAlive.value = false;
      await sleep(300);
      progress.value = `${i}/${TOTAL}`;
    }
    log("C 混合完成，未崩");
  }
</script>

<style lang="scss" scoped>
  .page {
    padding: 40rpx;
    display: flex;
    flex-direction: column;
  }

  .title {
    font-size: 36rpx;
    font-weight: 700;
    margin-bottom: 24rpx;
  }

  .status {
    font-size: 26rpx;
    color: #333333;
    margin-bottom: 8rpx;
  }

  .btn {
    margin-top: 24rpx;
    margin-bottom: 8rpx;
  }

  .tip {
    margin-top: 24rpx;
    font-size: 24rpx;
    color: #999999;
  }

  /* 被测 webview 占位（页面下方 1px 高，不干扰操作；真实加载与全屏一致） */
  .test-wv {
    width: 100%;
    height: 2rpx;
  }
</style>
