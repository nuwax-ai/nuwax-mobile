<template>
  <view v-if="providers.length > 0 || errorText.length > 0" class="idp-login">
    <text v-if="errorText.length > 0" class="idp-error">{{ errorText }}</text>
    <text v-if="providers.length > 0" class="idp-title">{{ t('Mobile.Auth.externalLogin') }}</text>
    <view class="idp-buttons">
      <button v-for="provider in providers" :key="provider.id" class="idp-button"
        :disabled="busy || disabled" :loading="busy && activeId == provider.id"
        @click="login(provider.id, false)">
        <image v-if="provider.icon.length > 0" class="idp-icon" :src="provider.icon" mode="aspectFit" />
        <text class="idp-name">{{ provider.name.length > 0 ? provider.name : t('Mobile.Auth.externalLogin') }}</text>
      </button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted, onUnmounted } from 'vue';
import { AuthIdpProvider } from '@/types/interfaces/authIdp';
import { MOBILE_IDP_ENABLED_TYPES, MOBILE_IDP_ALLOWED_IDS } from '@/constants/authIdp';
import { apiAuthIdpLoginList } from '@/servers/authIdp';
import { apiResCode, apiResData } from '@/utils/apiResponse';
import { SUCCESS_CODE } from '@/constants/codes.constants';
import { getApiBaseUrl } from '@/constants/config';
import { AuthLoadScope, parseAuthIdpList, availableAuthProviders, autoAuthProviderId } from '@/utils/authIdp';
import { canUseBrowserIdp, authBrowserOrigin, authBrowserQuery, authBrowserUserAgent, beginBrowserIdp } from '@/utils/idpNavigation';
import { useI18n, emptyI18nParams } from '@/utils/i18n';

const props = defineProps<{ agreed: boolean, disabled: boolean, redirectUrl: string, allowAutomatic: boolean }>();
const emit = defineEmits(['agreed', 'busy']);
const { t: translate } = useI18n();
const t = (key: string): string => translate(key, emptyI18nParams(), '');
const providers = ref<AuthIdpProvider[]>([]);
const errorText = ref<string>('');
const busy = ref<boolean>(false);
const activeId = ref<string>('');
const scope = new AuthLoadScope();
let loadedOrigin = '';
let loadedRevision = 0;
let local = false;

function setBusy(value: boolean): void {
  busy.value = value;
  emit('busy', value);
}

/** 同一提供方五分钟内只自动发起一次，覆盖 IdP 失败回 PC 登录页再回移动站的情形。 */
function reserveAutomaticAttempt(id: string): boolean {
  // #ifdef H5 || WEB
  try {
    const key = 'NUWAX_IDP_AUTO:' + authBrowserOrigin() + ':' + id;
    const previous = sessionStorage.getItem(key);
    const timestamp = previous != null ? parseFloat(previous) : 0;
    if (timestamp > 0 && Date.now() - timestamp < 300000) return false;
    sessionStorage.setItem(key, `${Date.now()}`);
    return true;
  } catch (_error) { return false; }
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

function login(id: string, automatic: boolean): void {
  if (busy.value || props.disabled || !scope.accepts(loadedRevision, loadedOrigin, getApiBaseUrl())) return;
  if (!canUseBrowserIdp() || !providers.value.some((p: AuthIdpProvider): boolean => p.id == id)) return;
  activeId.value = id;
  setBusy(true);
  const start = (): void => {
    if (!scope.accepts(loadedRevision, loadedOrigin, getApiBaseUrl())) return;
    if (!beginBrowserIdp(id, props.redirectUrl, automatic)) {
      setBusy(false);
      errorText.value = t('Mobile.Auth.idpUnavailable');
    }
  };
  // 租户配置的自动认证先同步勾选状态，直接继续；手动入口仍由用户确认协议。
  if (automatic && !props.agreed) emit('agreed');
  if (automatic || props.agreed) {
    start();
    return;
  }
  uni.showModal({
    title: t('Mobile.Common.tip'),
    content: t('Mobile.Auth.pleaseAgreeProtocol'),
    confirmText: t('Mobile.Common.agree'),
    cancelText: t('Mobile.Common.disagree'),
    success: (res) => {
      if (!scope.accepts(loadedRevision, loadedOrigin, getApiBaseUrl())) return;
      if (res.confirm == true) {
        emit('agreed');
        start();
      } else setBusy(false);
    },
    fail: (_error) => {
      if (scope.accepts(loadedRevision, loadedOrigin, getApiBaseUrl())) setBusy(false);
    },
  });
}

// #ifdef H5 || WEB
function restoreFromBrowser(event: PageTransitionEvent): void {
  if (event.persisted) { setBusy(false); local = true; }
}
// #endif

onMounted(async () => {
  if (!canUseBrowserIdp()) return;
  const error = authBrowserQuery('idpError');
  errorText.value = error != null ? error.substring(0, 500) : '';
  local = authBrowserQuery('local') != null || error != null;
  // #ifdef H5 || WEB
  window.addEventListener('pageshow', restoreFromBrowser);
  // #endif
  const revision = scope.begin();
  const origin = getApiBaseUrl();
  try {
    const response = await apiAuthIdpLoginList();
    if (!scope.accepts(revision, origin, getApiBaseUrl()) || apiResCode(response) != SUCCESS_CODE) return;
    const list = parseAuthIdpList(apiResData<any>(response));
    loadedOrigin = origin;
    loadedRevision = revision;
    providers.value = availableAuthProviders(list.items, MOBILE_IDP_ENABLED_TYPES, MOBILE_IDP_ALLOWED_IDS, authBrowserUserAgent());
    const automatic = autoAuthProviderId(providers.value, list.autoRedirectIdpId, local, error != null);
    if (props.allowAutomatic && automatic.length > 0 && reserveAutomaticAttempt(automatic)) login(automatic, true);
  } catch (_error) {
    // 列表失败、超时或旧后端不支持时，普通登录仍然可用。
  }
});

onUnmounted(() => {
  scope.invalidate();
  emit('busy', false);
  // #ifdef H5 || WEB
  window.removeEventListener('pageshow', restoreFromBrowser);
  // #endif
});
</script>

<style scoped>
.idp-login { width: 100%; margin-top: 24px; }
.idp-title { color: #777777; font-size: 13px; text-align: center; margin-bottom: 12px; }
.idp-error { color: #b42318; font-size: 13px; margin-bottom: 12px; }
.idp-buttons { display: flex; flex-direction: column; }
.idp-button { display: flex; flex-direction: row; align-items: center; justify-content: center; width: 100%; min-height: 42px; background-color: #ffffff; color: #111111; border: 1px solid #dddddd; border-radius: 7px; margin-bottom: 10px; }
.idp-button::after { border-width: 0; }
.idp-icon { width: 20px; height: 20px; margin-right: 8px; }
.idp-name { font-size: 14px; line-height: 22px; }
</style>
