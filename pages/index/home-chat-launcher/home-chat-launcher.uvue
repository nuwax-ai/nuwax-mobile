<template>
  <view v-if="ready" class="home-chat-launcher">
    <chat-input-phone
      :manual-components="manualComponents"
      :default-selected-components="defaultSelectedComponents"
      :is-task-agent="isTaskAgent"
      :sandbox-list="sandboxList"
      :current-sandbox-id="currentSandboxId"
      :is-sandbox-switch-disabled="sandboxSwitchDisabled"
      :is-sandbox-unavailable="sandboxUnavailable"
      :sandbox-disabled-text="sandboxDisabledText"
      :has-permission="hasPermission"
      :readonly="sandboxSwitchDisabled"
      :enable-skill-at="allowAtSkill"
      :allow-other-model="allowOtherModel"
      :current-model-id="currentModelId"
      :current-model-name="currentModelName"
      :agent-id="agentId"
      :agent-type="agentType"
      :allow-choose-mode="allowChooseMode"
      :whole-disabled="submitting"
      :is-home-launcher="true"
      @onSendMessage="handleSend"
      @onSandboxChange="handleSandboxChange"
      @onModelChange="handleModelChange"
    />
  </view>
</template>

<script setup lang="uts">
  import { computed, onMounted, ref } from "vue";
  import ChatInputPhone from "@/subpackages/components/chat-input-phone/chat-input-phone.uvue";
  import { apiPublishedAgentInfo } from "@/servers/agentDev";
  import { apiGetSandboxList, apiUpdateSelectedSandbox } from "@/servers/sandbox";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { AgentComponentTypeEnum, DefaultSelectedEnum } from "@/types/enums/agent";
  import { AgentSelectedComponentInfo, type AgentManualComponentInfo } from "@/types/interfaces/agent";
  import type { SandboxInfo } from "@/types/interfaces/sandbox";

  class ManualComponent implements AgentManualComponentInfo {
    id: number = 0;
    name: string = "";
    icon: string = "";
    description: string = "";
    type: AgentComponentTypeEnum = AgentComponentTypeEnum.Plugin;
    defaultSelected: DefaultSelectedEnum = DefaultSelectedEnum.No;
  }

  class HomeSandbox implements SandboxInfo {
    sandboxId: string = "";
    name: string = "";
    description: string = "";
  }

  const props = withDefaults(defineProps<{ agentId?: number; submitting?: boolean }>(), {
    agentId: 2837,
    submitting: false,
  });
  const emit = defineEmits<{
    (e: "submit", data: any): void;
    (e: "unavailable"): void;
  }>();

  const ready = ref(false);
  const agentType = ref("ChatBot");
  const manualComponents = ref<AgentManualComponentInfo[]>([]);
  const sandboxList = ref<SandboxInfo[]>([]);
  const currentSandboxId = ref("");
  const sandboxSwitchDisabled = ref(false);
  const sandboxUnavailable = ref(false);
  const sandboxDisabledText = ref("");
  const currentModelId = ref(0);
  const currentModelName = ref("");
  const allowOtherModel = ref(false);
  const allowAtSkill = ref(false);
  const allowChooseMode = ref(0);
  const hasPermission = ref(true);
  const isTaskAgent = computed((): boolean => agentType.value == "TaskAgent");
  const defaultSelectedComponents = computed((): AgentSelectedComponentInfo[] => {
    const result: AgentSelectedComponentInfo[] = [];
    for (let i = 0; i < manualComponents.value.length; i++) {
      const item = manualComponents.value[i];
      if (item.defaultSelected == DefaultSelectedEnum.Yes) {
        result.push(new AgentSelectedComponentInfo(item.id, item.type));
      }
    }
    return result;
  });

  const parseManualComponents = (raw: any): AgentManualComponentInfo[] => {
    const result: AgentManualComponentInfo[] = [];
    const list = raw as UTSJSONObject[] | null;
    if (list == null) return result;
    for (let i = 0; i < list.length; i++) {
      const obj = list[i];
      const item = new ManualComponent();
      item.id = obj["id"] as number | null ?? 0;
      item.name = obj["name"] as string | null ?? "";
      item.icon = obj["icon"] as string | null ?? "";
      item.description = obj["description"] as string | null ?? "";
      item.type = obj["type"] as AgentComponentTypeEnum | null ?? AgentComponentTypeEnum.Plugin;
      item.defaultSelected = obj["defaultSelected"] as DefaultSelectedEnum | null ?? DefaultSelectedEnum.No;
      result.push(item);
    }
    return result;
  };

  const parseSandboxes = (raw: any): SandboxInfo[] => {
    const result: SandboxInfo[] = [];
    const list = raw as UTSJSONObject[] | null;
    if (list == null) return result;
    for (let i = 0; i < list.length; i++) {
      const obj = list[i];
      const item = new HomeSandbox();
      item.sandboxId = `${obj["sandboxId"] as string | null ?? ""}`;
      item.name = `${obj["name"] as string | null ?? ""}`;
      item.description = `${obj["description"] as string | null ?? ""}`;
      result.push(item);
    }
    return result;
  };

  const loadConfig = async (): Promise<void> => {
    const detailRes = await apiPublishedAgentInfo(props.agentId, false);
    if (apiResCode(detailRes) != SUCCESS_CODE) {
      emit("unavailable");
      return;
    }
    const data = apiResData<any>(detailRes) as UTSJSONObject | null;
    if (data == null) {
      emit("unavailable");
      return;
    }
    agentType.value = `${data["type"] as string | null ?? "ChatBot"}`;
    manualComponents.value = parseManualComponents(data["manualComponents"]);
    allowOtherModel.value = data["allowOtherModel"] == DefaultSelectedEnum.Yes || data["allowOtherModel"] == 1;
    allowAtSkill.value = data["allowAtSkill"] == DefaultSelectedEnum.Yes || data["allowAtSkill"] == 1;
    allowChooseMode.value = data["allowChooseMode"] == DefaultSelectedEnum.Yes || data["allowChooseMode"] == 1 ? 1 : 0;
    hasPermission.value = data["hasPermission"] != false;
    currentModelId.value = data["modelId"] as number | null ?? 0;
    currentModelName.value = `${data["modelName"] as string | null ?? ""}`;
    const fixedSandbox = `${data["sandboxId"] as string | null ?? ""}`;
    const sandboxRes = await apiGetSandboxList();
    if (apiResCode(sandboxRes) == SUCCESS_CODE) {
      const sandboxData = apiResData<any>(sandboxRes) as UTSJSONObject | null;
      if (sandboxData != null) {
        const sandboxesRaw = sandboxData["sandboxes"];
        sandboxList.value = sandboxesRaw != null
          ? parseSandboxes(sandboxesRaw)
          : [] as SandboxInfo[];
        const selected = sandboxData["agentSelected"] as UTSJSONObject | null;
        if (fixedSandbox.length > 0) {
          currentSandboxId.value = fixedSandbox;
          sandboxSwitchDisabled.value = true;
        } else if (selected != null && selected[`${props.agentId}`] != null) {
          currentSandboxId.value = `${selected[`${props.agentId}`]}`;
        } else if (sandboxList.value.length > 0) {
          currentSandboxId.value = sandboxList.value[0].sandboxId;
        }
      }
    }
    ready.value = true;
  };

  const handleSandboxChange = async (sandboxId: string): Promise<void> => {
    if (sandboxSwitchDisabled.value) return;
    await apiUpdateSelectedSandbox(`${props.agentId}`, sandboxId);
    currentSandboxId.value = sandboxId;
  };

  const handleModelChange = (id: number, name: string): void => {
    currentModelId.value = id;
    currentModelName.value = name;
  };

  const handleSend = (data: any): void => {
    const payload = data as UTSJSONObject;
    payload["agentId"] = props.agentId;
    payload["sandboxId"] = currentSandboxId.value;
    payload["modelId"] = currentModelId.value;
    emit("submit", payload);
  };

  onMounted(() => { loadConfig(); });
</script>

<style lang="scss" scoped>
  .home-chat-launcher {
    width: 100%;
    padding: 16rpx 0 20rpx;
    box-sizing: border-box;
  }
</style>
