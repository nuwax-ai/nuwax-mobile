<template>
  <!-- 输入框 placeholder 轮播白纱：与输入 pill 同色的一层铺满 textarea 文字区，
       盖上=旧文案淡出、揭开=新文案淡入（原生 hint 无法单独做 opacity 过渡）。
       零绑定挂载——显隐/取色读模块级 ref（chat-locate-loading 同款）；chat.uvue
       模板不能再新增 setup 顶层引用（Android 渲染 lambda 255 捕获上限）。
       定位锚是父级 .chat-input-content（position: relative）。 -->
  <view
    class="chat-input-veil"
    :class="{ 'chat-input-veil--on': veilOn }"
    :style="{ backgroundColor: veilColor }"
  />
</template>

<script lang="uts" setup>
  import { chatInputVeilOn, chatInputVeilColor } from "@/utils/chatInputVeil.uts";

  /** 模块级 ref 直接取别名（勿包 computed）：模板直读模块 ref、页面侧写入即重渲。 */
  const veilOn = chatInputVeilOn;
  const veilColor = chatInputVeilColor;
</script>

<style lang="scss" scoped>
  /* 铺满文字区、与 pill 同色，盖上/揭开就是文案的淡出/淡入；absolute 零布局位移
     （多行增高时一并铺满，不影响 pill 高度）。
     pointer-events:none 不抢 textarea 的点击与聚焦；right:28px 让开右侧展开键
     （22px 图标 + 6px 余量）不跟着闪。 */
  .chat-input-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 28px;
    bottom: 0;
    opacity: 0;
    pointer-events: none;
    /* ★0.5s 与 chat.uvue 的 PLACEHOLDER_VEIL_FADE_MS 同步（淡入淡出同速）；
       ease-in-out 让盖上与揭开两端都更柔和。 */
    transition: opacity 0.5s ease-in-out;
  }

  .chat-input-veil--on {
    opacity: 1;
  }
</style>
