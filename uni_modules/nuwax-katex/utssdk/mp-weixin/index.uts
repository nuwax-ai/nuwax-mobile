/**
 * nuwax-katex 微信小程序实现：内置 KaTeX → HTML → 关键 CSS 内联 → rich-text 渲染。
 */
import type { KatexRenderOptions, KatexRenderRes } from '../interface.uts'
export * from '../interface.uts'

// 内置 KaTeX 桥（JS：renderToString + CSS 内联）
import katexMp from './katex-mp.js'

/**
 * 渲染 LaTeX 公式为 HTML（小程序：rich-text :nodes 使用）
 */
export function renderLatex(tex: string, options: KatexRenderOptions): KatexRenderRes {
	try {
		const html = katexMp.renderToRichTextHtml(tex, options.displayMode, options.errorColor) as string
		const res: KatexRenderRes = {
			html: html,
			errMsg: '',
		}
		return res
	} catch (e) {
		const msg = e instanceof Error ? e.message : `${e}`
		const res: KatexRenderRes = {
			html: '',
			errMsg: msg,
		}
		return res
	}
}
