<template>
  <view class="language-row" v-if="langList.length > 1" @tap="handleOpen">
    <view class="language-row__icon">
      <svg-icon name="icon-Globe" size="20" unit="px" />
    </view>
    <text class="language-row__title">{{ t("Mobile.Profile.language") }}</text>
    <text class="language-row__value text-ellipsis">{{ currentLanguageName }}</text>
    <text class="language-row__arrow">›</text>
  </view>

  <radio-list-drawer
    :visible="visible"
    :title="t('Mobile.Profile.selectLanguage')"
    :list="languageOptions"
    :current-value="localCurrentLang"
    @onClose="handleClose"
    max-height="40%"
    @onChange="handleLanguageChange"
  />
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { useI18n, normalizeLang, emptyI18nParams } from "@/utils/i18n";
  import { RadioListItem } from "@/types/interfaces/radio";
  import RadioListDrawer from "@/components/radio-list-drawer/radio-list-drawer.uvue";

  const { t: tFn, currentLang, langList, setLanguage } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const visible = ref(false);
  const localCurrentLang = ref("");

  const languageOptions = computed((): RadioListItem[] => {
    const list = langList.value;
    const result: RadioListItem[] = [];
    if (list == null) {
      return result;
    }
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      if (item == null) {
        continue;
      }
      const name = item.name != null ? item.name : "";
      const lang = item.lang != null ? item.lang : "";
      result.push(
        new RadioListItem(name, normalizeLang(lang), "", "", item.status == 0),
      );
    }
    return result;
  });

  const currentLanguageName = computed((): string => {
    const normCurrent = normalizeLang(currentLang.value);
    const list = langList.value;
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      if (normalizeLang(item.lang) == normCurrent) {
        if (item.name.length > 0) {
          return item.name;
        }
        return item.lang;
      }
    }
    return t("Mobile.Profile.languagePlaceholder");
  });

  const handleOpen = () => {
    localCurrentLang.value = normalizeLang(currentLang.value);
    visible.value = true;
  };

  const handleClose = () => {
    visible.value = false;
  };

  const handleLanguageChange = async (targetLang: string) => {
    if (targetLang.length == 0 || targetLang == currentLang.value) return;

    uni.showLoading({
      title: t("Mobile.Common.switching"),
    });
    try {
      const ok = await setLanguage(targetLang);
      if (!ok) {
        uni.showToast({
          title: t("Mobile.Common.switchFailed"),
          icon: "none",
        });
        return;
      }

      uni.showToast({
        title: t("Mobile.Common.switchSuccess"),
        icon: "success",
      });

      // 成功切换后回到首页，确保全局语言包和底栏文案一起生效。
      setTimeout(() => {
        // #ifdef H5
        window.location.replace("/");
        // #endif
        // #ifndef H5
        uni.reLaunch({
          url: "/pages/message/message",
        });
        // #endif
      }, 500);
    } finally {
      uni.hideLoading();
      visible.value = false;
    }
  };
</script>

<style lang="scss" scoped>
  .language-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid #f5f5f5;
  }

  .language-row__icon {
    width: 28px;
    height: 28px;
    margin-right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .language-row__title {
    flex: 1;
    font-size: 15px;
    font-weight: 500;
    color: #1a1a1a;
  }

  .language-row__value {
    max-width: 130px;
    margin-left: 8px;
    font-size: 13px;
    color: #999999;
    text-align: right;
  }

  .language-row__arrow {
    font-size: 20px;
    color: #c0c0c0;
    font-weight: 300;
    line-height: 1;
    padding-left: 4px;
  }
</style>
