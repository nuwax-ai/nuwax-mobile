<template>
  <view class="icon-text">
    <!-- #ifndef APP -->
    <text class="iconfont" :class="icon"><slot /></text>
    <!-- #endif -->
    <!-- #ifdef APP -->
    <text class="iconfont">{{ glyph }}</text>
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { computed } from 'vue';
  import { getIconUnicode } from '@/constants/iconfont.constants.uts';

  interface Props {
    /** iconfont 类名，如 icon-a-Chevronright */
    icon: string;
  }

  const props = defineProps<Props>();

  const glyph = computed((): string => {
    return getIconUnicode(props.icon);
  });
</script>

<style scoped>
.icon-text {
  display: flex;
  flex-direction: row;
  align-items: center;
}
</style>
