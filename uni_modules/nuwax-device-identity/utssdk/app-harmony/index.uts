/**
 * nuwax-device-identity · app-harmony
 *
 * IM deviceId 的 baseId 稳定来源：ODID（OpenHarmony Developer ID，开发者维度的
 * 设备标识）。API 12+，同步只读常量，无需权限。
 *
 * 已知边界：
 *  - 未同意隐私政策 / 部分调试场景下为空串 → 本函数返回 null，调用方回落
 *    generateUUID + storage 的现有路径（接受一次性固化，下次重装有机会切到 ODID）；
 *  - 恢复出厂设置后 ODID 变化，等同新设备。
 * 若编译报 deviceInfo.ODID 类型缺失（DCloud 声明文件滞后），改从
 * '@ohos.deviceInfo' 直接 import 或与 HX 版本对齐后再验。
 */
import { deviceInfo } from '@kit.BasicServicesKit';

/**
 * 读 ODID；为空或异常返回 null（调用方回落，不抛异常——本函数在 IM 发送热路径上）。
 * 典型值为 64 位 hex，天然满足服务端 ImProtocol.isValidDeviceId 的字符白名单。
 */
export function getStableDeviceBaseId(): string | null {
  try {
    const s = `${deviceInfo.ODID}`.trim();
    return s.length > 0 ? s : null;
  } catch (e) {
    return null;
  }
}
