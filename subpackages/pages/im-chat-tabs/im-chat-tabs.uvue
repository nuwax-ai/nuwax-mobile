<template>
  <view class="ctp-page">
    <safety-zone />

    <!-- 顶部：返回 + 标题（列表态恒为「标签管理」，只有链接表单态换标题） -->
    <view class="ctp-header">
      <view class="ctp-header__btn" hover-class="ctp-header__btn--active" @click="handleBack">
        <back-chevron :size="20" color="#141416" />
      </view>
      <view class="ctp-header__title-wrap">
        <text class="ctp-header__title">{{ titleText }}</text>
      </view>
      <view class="ctp-header__btn ctp-header__btn--ghost" />
    </view>

    <!-- ============ 标签管理（本页即列表，链接表单是它的下一层） ============ -->
    <scroll-view
      v-if="mode == 'manage'"
      class="ctp-body"
      direction="vertical"
      :show-scrollbar="false"
    >
      <text class="ctp-hint">{{ t("Mobile.Message.chatTabManageHint") }}</text>
      <text class="ctp-section">{{ t("Mobile.Message.chatTabBuiltinSection") }}</text>
      <view class="ctp-group">
        <view v-for="row in builtinRows" :key="row.key" class="ctp-row">
          <image class="ctp-row__png" :src="row.icon" mode="aspectFit" />
          <!-- ★「（会话本体，不可移出）」紧跟文案同一行（用户要求），
               不占第二行高度：内置页签最多 4 行，多一行说明会把列表撑散 -->
          <view class="ctp-row__main ctp-row__main--inline">
            <text class="ctp-row__title">{{ row.label }}</text>
            <text v-if="!row.removable" class="ctp-row__note">
              {{ t("Mobile.Message.chatTabAnchorNote") }}
            </text>
          </view>
          <!-- ★不可移除项渲染成「勾不动」的开关（灰底 + 实心点），
               而不是点了没反应 —— 用外观说明白「这一项不归你管」 -->
          <view
            class="ctp-switch"
            :class="row.enabled ? 'ctp-switch--on' : ''"
            :style="row.removable ? '' : 'opacity:0.45;'"
            @click="toggleBuiltin(row)"
          >
            <view class="ctp-knob" :class="row.enabled ? 'ctp-knob--on' : ''" />
          </view>
        </view>
      </view>

      <!-- 自定义链接
           ★编辑者恒渲染整段（否则加链接就没有入口了）；只读用户只在真有链接时出现
           ★「添加」放在分组标题右侧而不是底部：链接上限 100，排在列表末尾等于要先滚到底 -->
      <template v-if="links.length > 0 || canEditLinks">
        <view class="ctp-section-row">
          <text class="ctp-section-row__text">{{ linksSectionText }}</text>
          <view
            v-if="canEditLinks"
            class="ctp-section-row__action"
            hover-class="ctp-section-row__action--active"
            @click="startAddLink"
          >
            <svg-icon name="icon-Plus" size="12" unit="px" color="#5147ff" />
            <text class="ctp-section-row__action-text">
              {{ t("Mobile.Message.chatTabLinkAddAction") }}
            </text>
          </view>
        </view>
        <view class="ctp-group">
          <!-- 空态：留下这条引导句，比一个空卡片清楚 -->
          <view v-if="links.length == 0" class="ctp-row">
            <text class="ctp-row__hint">{{ t("Mobile.Message.chatTabLinksEmpty") }}</text>
          </view>
          <view v-for="(link, index) in links" :key="link.id" class="ctp-row ctp-row--link">
            <!-- 图标：服务端 icon 是用户可编辑的 emoji（PC 端 / 本页表单都能设），
                 非空走 <text> 字形；空串回落链条 PNG（与页签行同一套判据）。 -->
            <text v-if="link.icon.length > 0" class="ctp-row__emoji">{{ link.icon }}</text>
            <image v-else class="ctp-row__png" src="/static/images/icon-tab-link.png" mode="aspectFit" />
            <view class="ctp-row__main">
              <text class="ctp-row__title text-ellipsis">{{ link.name }}</text>
              <text class="ctp-row__sub text-ellipsis">{{ link.url }}</text>
            </view>
            <!-- ★编辑/排序/删除一套权限闸门（canEditLinks）；首末行的移动键置灰不隐藏：
                 位置固定更好点，也把「已经到头了」这个信息显示出来 -->
            <template v-if="canEditLinks">
              <view
                class="ctp-mini"
                :class="index == 0 ? 'ctp-mini--off' : ''"
                hover-class="ctp-mini--active"
                @click="moveLink(link.id, -1)"
              >
                <svg-icon name="icon-a-Chevronup" size="14" unit="px" color="#4b4b52" />
              </view>
              <view
                class="ctp-mini"
                :class="index == links.length - 1 ? 'ctp-mini--off' : ''"
                hover-class="ctp-mini--active"
                @click="moveLink(link.id, 1)"
              >
                <svg-icon name="icon-a-Chevrondown" size="14" unit="px" color="#4b4b52" />
              </view>
              <view class="ctp-mini" hover-class="ctp-mini--active" @click="startEditLink(link.id)">
                <svg-icon name="icon-Edit" size="14" unit="px" color="#4b4b52" />
              </view>
              <view class="ctp-mini" hover-class="ctp-mini--active" @click="confirmRemoveLink(link.id)">
                <svg-icon name="icon-a-trashcan" size="14" unit="px" color="#e5484d" />
              </view>
            </template>
          </view>
        </view>
      </template>

      <!-- 说明只在「有链接可管」时出现：无改链接权限的人看不到链接段，
           这条讲共享/权限的话就成了悬空的噪音 -->
      <text v-if="links.length > 0 || canEditLinks" class="ctp-hint ctp-hint--foot">
        {{ canEditLinks
          ? t("Mobile.Message.chatTabLinksSharedHint")
          : t("Mobile.Message.chatTabLinksReadonlyHint") }}
      </text>
    </scroll-view>

    <!-- ============ 添加 / 编辑自定义链接 ============ -->
    <view v-else class="ctp-form">
      <text class="ctp-label">{{ t("Mobile.Message.chatTabLinkNameLabel") }}</text>
      <view class="ctp-field">
        <input
          class="ctp-input"
          v-model="draftName"
          :maxlength="maxName"
          :placeholder="t('Mobile.Message.chatTabLinkNamePlaceholder')"
          placeholder-class="ctp-ph"
        />
      </view>
      <!-- 图标（对齐 PC AddLinkTabModal：名称 → 图标 → 网址）
           ★「默认」= 空串，标签显示链条图标（与加这个字段之前一模一样）；
             预设 emoji 一键选，输入框仍允许自己粘一个（上限 16 UTF-16 码元，与 PC 同口径）。 -->
      <text class="ctp-label">{{ t("Mobile.Message.chatTabLinkIconLabel") }}</text>
      <view class="ctp-icon-row">
        <view
          class="ctp-icon-btn"
          :class="draftIcon.length == 0 ? 'ctp-icon-btn--on' : ''"
          hover-class="ctp-icon-btn--hover"
          @click="pickIcon('')"
        >
          <image class="ctp-icon-btn__default" src="/static/images/icon-tab-link.png" mode="aspectFit" />
        </view>
        <view
          v-for="preset in iconPresets"
          :key="preset"
          class="ctp-icon-btn"
          :class="draftIcon == preset ? 'ctp-icon-btn--on' : ''"
          hover-class="ctp-icon-btn--hover"
          @click="pickIcon(preset)"
        >
          <text class="ctp-icon-btn__emoji">{{ preset }}</text>
        </view>
        <view class="ctp-icon-input-wrap">
          <input
            class="ctp-icon-input"
            v-model="draftIcon"
            :maxlength="maxIcon"
            :placeholder="t('Mobile.Message.chatTabLinkIconPlaceholder')"
            placeholder-class="ctp-ph"
          />
        </view>
      </view>
      <text class="ctp-label">{{ t("Mobile.Message.chatTabLinkUrlLabel") }}</text>
      <view class="ctp-field">
        <input
          class="ctp-input"
          v-model="draftUrl"
          :maxlength="2048"
          :placeholder="t('Mobile.Message.chatTabLinkUrlPlaceholder')"
          placeholder-class="ctp-ph"
        />
      </view>
      <!-- ★错误显示在表单里、不用 toast：用户此刻正盯着输入框要改 -->
      <text v-if="errorText.length > 0" class="ctp-error">{{ errorText }}</text>

      <view class="ctp-actions">
        <view class="ctp-btn" hover-class="ctp-btn--active" @click="backFromLink">
          <text class="ctp-btn__text">{{ t("Mobile.Common.cancel") }}</text>
        </view>
        <view
          class="ctp-btn ctp-btn--primary"
          :class="busy ? 'ctp-btn--disabled' : ''"
          hover-class="ctp-btn--primary-active"
          @click="submitLink"
        >
          <text class="ctp-btn__text ctp-btn__text--primary">
            {{ editingId.length > 0
              ? t("Mobile.Common.save")
              : t("Mobile.Message.chatTabLinkAddAction") }}
          </text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { computed, ref } from "vue";
  import { onBackPress, onLoad, onShow, onUnload } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import {
    ChatSubpageTabDef,
    CHAT_SUBPAGE_TAB_DEFS,
    CHAT_TAB_LIBRARY,
    isChatTabAllowedIn,
  } from "@/utils/im/chatSubpageTabs";
  import {
    CustomLinkTab,
    MAX_CUSTOM_TAB_ICON,
    MAX_CUSTOM_TAB_NAME,
  } from "@/utils/im/chatCustomTabs";
  import {
    addChatLink,
    bindChatTabsContext,
    ChatTabsContext,
    chatCustomLinks,
    chatCustomLinksConvId,
    chatLinkOf,
    chatTabsText,
    isChatTabEnabled,
    loadChatLinks,
    moveChatLink,
    removeChatLink,
    setChatTabEnabled,
    unbindChatTabsContext,
    updateChatLink,
  } from "@/utils/im/chatTabsStore";

  /**
   * 「添加标签页 / 管理标签页 / 自定义链接表单」（对齐 PC nuwax-im-web 的 + 菜单、
   * ManageTabsModal 与 AddLinkTabModal）。
   *
   * <h2>为什么是独立页而不是底部弹层</h2>
   * 弹层形态受高度与键盘挤压限制（链接表单里两个输入框 + 错误行经常被键盘顶掉），
   * 而管理列表天生是「一屏放不下、要滚动、要多次操作」的长列表 —— 页面形态让返回键、
   * 滚动、键盘都交给系统处理。
   *
   * <h2>★页面本体就是列表，没有「添加标签页」中间层</h2>
   * 早期是「+ → 菜单（自定义链接… / 可加页签 / 管理标签页）→ 列表」两层。现在合并成
   * 一层：内置页签的加/删由开关承担，「添加自定义链接」放在「自定义链接」分组标题右侧。
   * 理由：菜单对无改链接权限的人只剩一项，等于白点一次；对有权限的人，加链接在标题右侧
   * （链接上限 100，排在列表末尾要先滚到底）比藏在二级菜单里更快。
   * 只剩两种视图：manage（列表本体）与 link（链接表单）。
   *
   * <h2>★本页是「第二个上下文持有者」</h2>
   * 数据层（utils/im/chatTabsStore）用「谁最后 bind 谁生效」的模块级上下文来判权限。
   * 进本页时聊天页会 onHide（把上下文摘掉），所以本页必须自己拿着入参重新 bind，
   * 否则链接列表拉取（晚归守卫比 convId）、增删改（读 chatTabsConvId）全部落空。
   * <ul>
   *   <li>token 用 {@code tabspage:<convId>}，与聊天页的裸 convId **必须不同**：
   *       返回时两个页面的生命周期先后不定，同名 token 会互相清掉对方刚注册的上下文；</li>
   *   <li>onUnload 只 {@code unbindChatTabsContext}（摘上下文），**不要**
   *       {@code releaseChatTabsForToken} —— 那会连链接列表一起清掉，返回聊天页又得重拉一次；</li>
   *   <li>权限/适用性全部从入参快照来（聊天页点「+」时按当时状态拼好），本页不重算业务判据。</li>
   * </ul>
   */
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  // 页内文案统一走 store 的取法（与聊天页/管理逻辑同一套 key）
  const tt = (key: string): string => chatTabsText(key);

  const maxName = MAX_CUSTOM_TAB_NAME;
  const maxIcon = MAX_CUSTOM_TAB_ICON;

  /**
   * 图标预设（★与 PC {@code AddLinkTabModal.ICON_PRESETS} 逐字一致，改这里必须同步 PC）。
   *
   * <p>为什么是 emoji 而不是再压一套 PNG：服务端 icon 字段本来就是 emoji / 短字符
   * （PC 端可以自由粘贴），预置位图只能覆盖固定 9 个，用户从 PC 设的其它 emoji 仍然要渲染。
   * 端上统一走 `<text>` 字形 —— 三端由系统彩色 emoji 字体渲染，不经过 `<image>` 那条
   * 「鸿蒙首帧建节点不上屏」的链路（该坑只对位图成立，文本字形正常）。
   */
  const iconPresets: string[] = ["📄", "📊", "📁", "🌐", "🤖", "⭐", "📌", "💬", "📚"];

  // ===== 页面入参 =====
  const convId = ref<string>("");
  const isGroup = ref<boolean>(false);
  const isAgentP2p = ref<boolean>(false);
  const isSystemConv = ref<boolean>(false);
  /** 我能否改本会话的自定义链接（群聊普通成员 = false，只读）。 */
  const canEditLinks = ref<boolean>(true);
  /** 本会话能不能用「资料库」（与上一条正交，见 ChatTabsContext 注释）。 */
  const canShowLibrary = ref<boolean>(false);

  /** 本页在 chatTabsStore 里的上下文 token。 */
  let pageToken: string = "";

  /** manage=标签列表（本页本体） | link=链接表单（唯一的下层） */
  const mode = ref<string>("manage");
  /** 表单态：正在编辑的链接 id（空串 = 添加模式） */
  const editingId = ref<string>("");
  const draftName = ref<string>("");
  /** 图标草稿：空串 = 默认链条图标（与 PC「默认」按钮同语义）。 */
  const draftIcon = ref<string>("");
  const draftUrl = ref<string>("");
  const errorText = ref<string>("");
  const busy = ref<boolean>(false);

  /** 点一个图标预设：只改草稿不改高亮用的第二份状态，归一化留给提交校验统一做。 */
  function pickIcon(icon: string): void {
    draftIcon.value = icon;
    errorText.value = "";
  }

  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  // ★整页只有一个标题「标签管理」：列表态与表单态之间的切换只是内容变化，
  //   不是换了一级页面（用户口径，勿再按旧「添加标签页 / 管理标签页」分名）。
  const titleText = computed((): string => {
    if (mode.value == "link") {
      return editingId.value.length > 0
        ? tt("Mobile.Message.chatTabLinkEditTitle")
        : tt("Mobile.Message.chatTabLinkAddTitle");
    }
    return tt("Mobile.Message.chatTabTitle");
  });

  /** 自定义链接列表（模板直接吃这个，重拉后自动重渲；按会话过滤防串页）。 */
  const links = computed((): CustomLinkTab[] => {
    if (chatCustomLinksConvId.value != convId.value) {
      return [] as CustomLinkTab[];
    }
    return chatCustomLinks.value;
  });

  const linksSectionText = computed((): string => {
    const params = new Map<string, string | number>();
    params.set("count", links.value.length);
    // 计数走 i18n 模板（{count}），不手拼字符串 —— 别的语言里语序不一样
    return translateFn("Mobile.Message.chatTabLinksSection", toI18nParams(params), "");
  });

  /** 权限与适用性快照（本页入参恒定，取一次即可）。 */
  function ctxAllowed(def: ChatSubpageTabDef): boolean {
    if (def.key == CHAT_TAB_LIBRARY && !canShowLibrary.value) {
      return false;
    }
    return isChatTabAllowedIn(def, isGroup.value, isAgentP2p.value, isSystemConv.value);
  }

  /** 管理列表的一行。★enabled 在 computed 里算好，模板不做方法调用绑定
   *  （Android 上模板 fnOf(x) 不收集方法体内依赖，数据变了界面不刷新）。 */
  class BuiltinRow {
    key: string = "";
    label: string = "";
    icon: string = "";
    enabled: boolean = false;
    removable: boolean = true;
  }

  function buildRows(): BuiltinRow[] {
    const out: BuiltinRow[] = [];
    for (let i = 0; i < CHAT_SUBPAGE_TAB_DEFS.length; i++) {
      const def = CHAT_SUBPAGE_TAB_DEFS[i];
      if (!ctxAllowed(def)) {
        continue;
      }
      const row = new BuiltinRow();
      row.key = def.key;
      row.label = tt(def.labelKey);
      row.icon = def.icon;
      row.enabled = isChatTabEnabled(def.key);
      row.removable = def.removable;
      out.push(row);
    }
    return out;
  }

  /** 本会话适用的全部内置页签（开关即「加/删」，不再有单独的添加列表）。 */
  const builtinRows = computed((): BuiltinRow[] => buildRows());

  // ===== 上下文绑定 =====

  function bindPageContext(): void {
    const token = `tabspage:${convId.value}`;
    pageToken = token;
    bindChatTabsContext(token, (): ChatTabsContext => {
      const ctx = new ChatTabsContext();
      ctx.convId = convId.value;
      ctx.isGroup = isGroup.value;
      ctx.isAgentP2p = isAgentP2p.value;
      ctx.isSystemConv = isSystemConv.value;
      ctx.canEditLinks = canEditLinks.value;
      ctx.canShowLibrary = canShowLibrary.value;
      return ctx;
    });
  }

  // ===== 导航 =====

  /** 表单「取消」/返回：一律回列表（本页只有列表与表单两层）。
   *  ★必须定义在 handleBack 之前：UTS 同作用域函数不能前向引用。 */
  function backFromLink(): void {
    errorText.value = "";
    busy.value = false;
    mode.value = "manage";
  }

  /** 返回键：表单回列表，列表态才是真的退页。 */
  function handleBack(): void {
    if (mode.value == "link") {
      backFromLink();
      return;
    }
    uni.navigateBack({});
  }

  // ===== 内置页签 =====

  /** 列表里的开关；锚点（不可移除）点了不生效，双击也不该有反应。 */
  function toggleBuiltin(row: BuiltinRow): void {
    if (!row.removable) {
      return;
    }
    setChatTabEnabled(row.key, !row.enabled);
  }

  // ===== 自定义链接 =====

  /** 本会话里按 id 找一条；列表还没归属到本会话时一律当「没有」，防串页误改误删。 */
  function linkOfMine(linkId: string): CustomLinkTab | null {
    if (chatCustomLinksConvId.value != convId.value) {
      return null;
    }
    return chatLinkOf(linkId);
  }

  function startAddLink(): void {
    editingId.value = "";
    draftName.value = "";
    draftIcon.value = "";
    draftUrl.value = "";
    errorText.value = "";
    mode.value = "link";
  }

  function startEditLink(linkId: string): void {
    const target = linkOfMine(linkId);
    if (target == null) {
      // 别人刚把它删了：列表马上会被 3007 重拉刷新，这里只提示一句
      uni.showToast({ title: tt("Mobile.Message.chatTabLinkMissing"), icon: "none" });
      return;
    }
    editingId.value = linkId;
    draftName.value = target.name;
    // 预填服务端 icon（PC 设过的也要带进表单，否则「点开编辑再保存」会把它抹掉）
    draftIcon.value = target.icon;
    draftUrl.value = target.url;
    errorText.value = "";
    mode.value = "link";
  }

  async function submitLink(): Promise<void> {
    if (busy.value) {
      return;
    }
    busy.value = true;
    errorText.value = "";
    const editing = editingId.value;
    // ★分支里各自 await（不写三元表达式：UTS→Kotlin 对「await 出现在三元分支」的
    //   转译不可靠，写成 if/else 最稳）
    let err = "";
    if (editing.length > 0) {
      err = await updateChatLink(editing, draftName.value, draftIcon.value, draftUrl.value);
    } else {
      err = await addChatLink(draftName.value, draftIcon.value, draftUrl.value);
    }
    busy.value = false;
    if (err.length > 0) {
      errorText.value = err;
      return;
    }
    // 成功：回管理列表（用户接着还能排序或再添一条）
    mode.value = "manage";
  }

  async function moveLink(linkId: string, delta: number): Promise<void> {
    const err = await moveChatLink(linkId, delta);
    if (err.length > 0) {
      uni.showToast({ title: err, icon: "none" });
    }
  }

  async function doRemoveLink(linkId: string): Promise<void> {
    const err = await removeChatLink(linkId);
    if (err.length > 0) {
      uni.showToast({ title: err, icon: "none" });
      return;
    }
    uni.showToast({ title: tt("Mobile.Message.chatTabLinkDeleted"), icon: "none" });
  }

  /** 删除前二次确认：删掉之后要重新手输网址，而且这是会话级共享数据，误点代价不对称。 */
  function confirmRemoveLink(linkId: string): void {
    const target = linkOfMine(linkId);
    if (target == null) {
      return;
    }
    uni.showModal({
      title: tt("Mobile.Message.chatTabLinkDeleteConfirm"),
      content: target.name,
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.delete"),
      confirmColor: "#e5484d",
      success: (res) => {
        if (res.confirm) {
          doRemoveLink(linkId);
        }
      },
    });
  }

  // ===== 生命周期 =====

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    isGroup.value = readOption(options, "isGroup") == "1";
    isAgentP2p.value = readOption(options, "isAgentP2p") == "1";
    isSystemConv.value = readOption(options, "isSystemConv") == "1";
    canEditLinks.value = readOption(options, "canEditLinks") != "0";
    canShowLibrary.value = readOption(options, "canShowLibrary") == "1";
    bindPageContext();
    // 聊天页通常已经拉过；缺了才补（聊天页 onShow 也会按同一条件补拉）
    if (chatCustomLinksConvId.value != convId.value) {
      loadChatLinks(convId.value, false);
    }
  });

  onShow(() => {
    // 被更上层页面盖住再回来：重新指回自己（模块里只存一份，见文件头）
    bindPageContext();
  });

  onUnload(() => {
    // ★只摘上下文、不清列表（见文件头）；token 不同，不会误清聊天页刚注册的那份
    unbindChatTabsContext(pageToken);
  });

  // 安卓物理返回键 / 手势返回：表单态先回列表，避免直接退出整个流程
  onBackPress((_options: OnBackPressOptions): boolean => {
    // 列表态就是本页第一层 → 交回系统退页；表单态才由本页吃掉这次返回
    if (mode.value == "manage") {
      return false;
    }
    handleBack();
    return true;
  });
</script>

<style lang="scss" scoped>
