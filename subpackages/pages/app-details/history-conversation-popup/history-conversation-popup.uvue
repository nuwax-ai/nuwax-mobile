<template>
  <view class="sidebar">
    <!-- 用户信息（固定顶部） -->
    <view class="user-info">
      <image :src="userAvatar" class="avatar" mode="aspectFill" :alt="t('Mobile.Common.avatarAlt')"></image>
      <view class="user-meta">
        <text class="nickname text-ellipsis">{{ userNickname }}</text>
        
        <!-- 积分展示（iOS 上架版仅展示，无增购入口） -->
        <view v-if="props.isSubscriptionEnabled" class="credits-show" @click="handleGoSubscriptions">
          <text class="credits-label">{{ t('Mobile.MySubscriptions.totalCredits') }}</text>
          <text class="credits-value">{{ formatCredit(props.totalCredit) }}</text>
          <!-- #ifndef APP-IOS -->
          <view class="credits-action">
            <text class="action-text">{{ t('Mobile.MySubscriptions.addPurchase') }}</text>
            <svg-icon name="icon-Chevronright-1" />
          </view>
          <!-- #endif -->
        </view>
      </view>
    </view>
 
    <!-- 会话记录（弹性撑满并局部滚动） -->
    <view class="session-recording">
      <!-- 头部固定 -->
      <view class="section-header">
        <view class="section-title">{{ t('Mobile.Common.conversationHistory') }}</view>
        
        <!-- 订阅按钮（iOS 上架版隐藏：无应用内购买渠道） -->
        <!-- #ifndef APP-IOS -->
        <view v-if="props.isSubscriptionEnabled && getIsPaymentRequired()" class="subscription-btn" @click="handleOpenSubscription">
          <svg-icon name="icon-member" customClass="subscription-icon" />
          <text class="subscription-text">{{ t('Mobile.MySubscriptions.subscribeNow') }}</text>
        </view>
        <!-- #endif -->
      </view>
      
      <!-- 会话历史列表（局部滚动，带滚动条） -->
      <scroll-view class="content-scroll" scroll-y="true" :show-scrollbar="true">
        <custom-nav-bar-speak :chat-list="props.chatList" :is-app-details="true" />
      </scroll-view>
    </view>
 
    <!-- 退出 -->
    <view class="logout">
      <view class="logout-item" @click="handleLogout">
        <svg-icon name="icon-Exit" />
        <text class="logout-text">{{ t('Mobile.Header.logout') }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import type { ConversationInfo} from '@/types/interfaces/conversationInfo';
import { apiLogout } from '@/servers/account';
import { t as translateFn, emptyI18nParams } from '@/utils/i18n';
import CustomNavBarSpeak from '@/components/custom-nav-bar/custom-nav-bar-speak/custom-nav-bar-speak.uvue'
import { formatNumber } from "@/utils/system";
import { clearStoragePreservingApiBaseUrl } from "@/constants/config";

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

class HistoryPopupUser {
  avatar: string = ""
  nickname: string = ""
}

// 定义props
const props = defineProps<{
  user: HistoryPopupUser,
  chatList: ConversationInfo[],
  totalCredit: number | null,
  isSubscriptionEnabled: boolean,
  isPaymentRequired?: boolean
}>()

const readUserField = (key: string): string => {
  const u = props.user as UTSJSONObject
  const v = u[key]
  return v != null ? `${v}` : ""
}

const userAvatar = computed((): string => readUserField("avatar"))
const userNickname = computed((): string => readUserField("nickname"))

// 可选布尔 prop 取值（uvue 下可选 prop + withDefaults 会触发 override 类型冲突）
const getIsPaymentRequired = (): boolean => props.isPaymentRequired == true;

// 定义 emits
const emit = defineEmits<{
  (e: "open-subscription"): void
}>()

const handleOpenSubscription = () => {
  emit("open-subscription")
}

const formatCredit = (value: number | null): string => {
  if (value == null) {
    return "--";
  }
  return (value % 1) == 0 ? formatNumber(value, 0) : formatNumber(value, 2);
};

// 对象转 query 字符串（必须在 handleGoSubscriptions 之前定义，UTS 不提升函数声明）
function objectToQuery(obj: UTSJSONObject): string {
  const keysArr = UTSJSONObject.keys(obj);
  let result = "";
  for (let i = 0; i < keysArr.length; i++) {
    const k = keysArr[i] as string;
    const v = obj[k];
    if (i > 0) {
      result = result + "&";
    }
    result = result + k + "=" + encodeURIComponent(v as string);
  }
  return result;
}

const handleGoSubscriptions = () => {
  // #ifndef APP-IOS
  // iOS 上架版无增购入口（credits-action 已在模板层隐藏），此跳转不编译
  const pages = getCurrentPages();
  const current = pages[pages.length - 1];
  const optObj = current.options as UTSJSONObject;
  const keysArr = UTSJSONObject.keys(optObj);
  let currentPath = "/" + current.route;
  if (keysArr.length > 0) {
    currentPath = currentPath + "?" + objectToQuery(optObj);
  }

  // 将返回路径安全存储到本地缓存，避免 URL 参数过长或被改写
  uni.setStorageSync("SUB_BACK_URL", currentPath);

  uni.navigateTo({
    url: "/subpackages/pages/my-subscriptions/my-subscriptions"
  });
  // #endif
};

// 获取当前页面信息（仅 H5 / 小程序使用，Android 端整段剥离）
// #ifndef APP-ANDROID
function getCurrentPageInfo(): string {
  // #ifdef H5 || WEB
  /**
   * 此处获取完整路径，因为H5端页面跳转redirectTo方法中需要完整路径
   */
  return window.location.href;
  // #endif

  // #ifdef MP-WEIXIN
  const pages = getCurrentPages();
  if (pages.length == 0) return '';
  // 获取当前页面
  const current = pages[pages.length - 1];

  // 判断参数对象是否为空
  const optObj = current.options as UTSJSONObject;
  const isEmptyObject = optObj.keys().length == 0;
  // current.route 页面路径，如 pages/index/index
  // current.options 参数对象，如 {id: "123", conversationId: "456"}
  // fullPath 完整路径，如 /pages/index/index?id=123&conversationId=456
  return isEmptyObject ? "/" + current.route : "/" + current.route + "?" + objectToQuery(optObj);
  // #endif
}
// #endif

// 退出登录
// 本地优先：服务端注销只是 best-effort，域名不可达时也必须清本地态回登录页，避免锁死登录态（与 mine.uvue 一致）
const handleLogout = async ()=>{

  try {
    await apiLogout()
  } catch (error) {
    console.error('服务端注销失败，继续本地退出:', error)
  }

  uni.showToast({
    title: t('Mobile.Header.logoutSuccess'),
    icon: 'success'
  })

  clearStoragePreservingApiBaseUrl()
  // 获取当前页面完整路径
  // #ifdef H5 || WEB
  const fullPath = getCurrentPageInfo();
  const url = "/subpackages/pages/login/login?redirect=" + encodeURIComponent(fullPath);
  uni.reLaunch({ url: url });
  // #endif

  // #ifdef MP-WEIXIN
  const fullPathMP = getCurrentPageInfo();
  uni.reLaunch({ url: "/subpackages/pages/login-weixin/login-weixin?redirect=" + encodeURIComponent(fullPathMP) });
  // #endif

  // #ifdef APP-ANDROID
  uni.reLaunch({ url: "/subpackages/pages/login/login" });
  // #endif

  // #ifdef APP-IOS
  uni.reLaunch({ url: "/subpackages/pages/login/login" });
  // #endif
}

</script>

<style lang="scss" scoped>
  @import "./history-conversation-popup.scss";
</style>
