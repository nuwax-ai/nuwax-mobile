<template>
  <agent-subscription-modal
    v-if="expert != null"
    ref="modalRef"
    :agent-id="agentId"
    :is-need-subscription="true"
    :expert-name="expertName"
    :expert-icon="expertIcon"
    :expert-description="expertDescription"
    :expert-user-count="expertUserCount"
    @summon="handleSummon"
  />
</template>

<script setup lang="uts">
  import { nextTick, ref, type ComponentPublicInstance } from "vue";
  import AgentSubscriptionModal from "@/subpackages/pages/chat-conversation-component/components/agent-subscription-modal/agent-subscription-modal.uvue";

  const emit = defineEmits<{
    (e: "summon", item: UTSJSONObject): void;
  }>();

  const expert = ref<UTSJSONObject | null>(null);
  const agentId = ref<number>(0);
  const expertName = ref<string>("");
  const expertIcon = ref<string>("");
  const expertDescription = ref<string>("");
  const expertUserCount = ref<number>(0);
  const modalRef = ref<any | null>(null);

  function readString(item: UTSJSONObject, key: string): string {
    const raw = item[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(item: UTSJSONObject, key: string): number {
    const raw = item[key];
    const value = raw != null ? parseFloat(`${raw}`) : 0;
    return isNaN(value) ? 0 : value;
  }

  async function open(item: UTSJSONObject): Promise<void> {
    const id = readNumber(item, "targetId");
    if (id <= 0) return;
    expert.value = item;
    agentId.value = id;
    expertName.value = readString(item, "name");
    expertIcon.value = readString(item, "icon");
    expertDescription.value = readString(item, "description");
    expertUserCount.value = readNumber(item, "userCount");
    await nextTick();
    if (modalRef.value != null) (modalRef.value as ComponentPublicInstance).$callMethod("open");
  }

  function handleSummon(subscribed: boolean): void {
    const item = expert.value;
    if (item == null) return;
    item["subscribed"] = subscribed;
    emit("summon", item);
  }

  defineExpose({ open: open as any });
</script>
