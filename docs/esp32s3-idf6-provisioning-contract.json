{
  "contractVersion": "1.0-first-integration",
  "status": "FIRMWARE_IMPLEMENTED_FIRST_INTEGRATION",
  "releaseScope": {
    "primaryTransport": "ble",
    "bleRequired": true,
    "softApSupported": false,
    "fallbackTransport": "none"
  },
  "hardware": {
    "chip": "ESP32-S3",
    "module": "ESP32-S3-N16R8",
    "chipRevision": "recorded_from_runtime_esp_chip_info_per_test_device"
  },
  "firmware": {
    "espIdfVersion": "6.0",
    "espIdfTagOrCommit": "v6.0 / 662a3be354759d9487bf4b1a629fadb766cb1800",
    "component": "espressif/network_provisioning",
    "componentVersion": "1.2.4",
    "componentRepositoryCommit": "2de4980640bbe3d2d69473d7251640039e185b92",
    "bleHost": "NimBLE",
    "keySdkconfig": [
      "CONFIG_BT_NIMBLE_ENABLED=y",
      "CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y",
      "CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y",
      "CONFIG_BT_NIMBLE_GATT_SERVER=y",
      "CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1",
      "CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256",
      "CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=y",
      "CONFIG_NETWORK_PROV_BLE_NOTIFY=y"
    ]
  },
  "transport": {
    "type": "ble",
    "primaryServiceUuid": "0000ffff-0000-1000-8000-00805f9b34fb",
    "primaryServiceUuidStatus": "CONFIRMED_BY_FIRMWARE",
    "serviceNamePrefix": "PROV_",
    "serviceNamePrefixStatus": "CONFIRMED_BY_FIRMWARE",
    "serviceNameFormat": "PROV_ plus final three STA MAC bytes in uppercase hexadecimal",
    "manufacturerId": null,
    "manufacturerDataFormat": "none",
    "advertisingTimeoutSeconds": 300,
    "attMtu": "PREFERRED_256_NEGOTIATED",
    "keepBleAfterProvisioning": "15000_ms_after_GOT_IP_then_stop",
    "maximumConnections": 1,
    "bdAddressPolicy": "scan-session locator only; never use BLE address as permanent device identity"
  },
  "security": {
    "version": 2,
    "status": "CONFIRMED_SECURITY_2_NO_DOWNGRADE",
    "usernameSource": "device UID printed by development firmware; production QR or device label",
    "proofOfPossessionSource": "development fixed PoP; production per-device QR or device label",
    "perDeviceSecretRequired": true,
    "security0AllowedInProduction": false,
    "developmentPoP": "<REDACTED>",
    "productionCredentialStorage": {
      "namespace": "nuwax_factory",
      "saltKey": "sec2_salt",
      "verifierKey": "sec2_verifier",
      "plaintextPoPStoredOnDevice": false
    },
    "qrPayloadExample": {
      "ver": "v1",
      "name": "PROV_A1B2C3",
      "transport": "ble",
      "network": "wifi",
      "security": 2,
      "username": "NX-A1B2-C3D4-E5F6",
      "pop": "PER_DEVICE_RANDOM_POP"
    }
  },
  "officialEndpoints": {
    "capabilityQueryRequired": true,
    "networkScanRequired": false,
    "setConfigRequired": true,
    "applyConfigRequired": true,
    "getStatusRequired": true,
    "authoritativeStatusEndpoint": "prov-ctrl",
    "capabilities": ["wifi_prov", "wifi_scan"]
  },
  "customEndpoints": [
    {
      "name": "device-info",
      "required": true,
      "requestFormat": "UTF-8 JSON object {}",
      "responseFormat": "UTF-8 JSON object",
      "fields": [
        "protocolVersion",
        "serialNumber",
        "productModel",
        "hardwareVersion",
        "firmwareVersion",
        "capabilities",
        "lastProvisioningOutcome",
        "lastProvisioningReason"
      ],
      "lastOutcomeValues": ["none", "success", "auth_failed", "network_not_found", "timeout", "internal_error", "stopped"]
    }
  ],
  "successCriteria": {
    "level": "DHCP_GOT_IP",
    "firmwareEvent": "IP_EVENT_STA_GOT_IP",
    "cloudOnlineRequired": false,
    "statusTimeoutMs": 30000,
    "recommendedAppStatusTimeoutMs": 35000,
    "firmwareMustExposeLastStatusAfterReconnect": true,
    "reconnectStatusScope": "while the 300-second provisioning window or 15-second post-success window remains active"
  },
  "failureMapping": {
    "securityAuthFailed": "PROTOCOMM_SECURITY_SESSION_CREDENTIALS_MISMATCH",
    "authFailed": "NETWORK_PROV_WIFI_STA_AUTH_ERROR",
    "networkNotFound": "NETWORK_PROV_WIFI_STA_AP_NOT_FOUND",
    "dhcpFailed": "NO_DISTINCT_NATIVE_CODE_MAP_TO_TIMEOUT",
    "timeout": "FIRMWARE_CREDENTIAL_OBSERVATION_TIMEOUT_OR_APP_GUARD_TIMEOUT",
    "internalError": "UNKNOWN_WIFI_REASON_OR_PROTOCOMM_OR_LOCAL_ESP_ERR"
  },
  "lifecycle": {
    "firstBootStartsProvisioning": "when ESP-IDF Wi-Fi provisioned marker is absent",
    "physicalEntryAction": "open local Wi-Fi detail page and hold without moving for at least 5 seconds",
    "physicalEntryFeedback": "show BLE provisioning restart status, clear ESP-IDF Wi-Fi configuration, then reboot",
    "configuredDeviceAdvertisingPolicy": "do not advertise provisioning BLE during normal boot",
    "failedProvisioningKeepsBleConnected": "yes, only while the 300-second provisioning window remains active",
    "resetCommandOrEndpoint": "local physical Wi-Fi detail 5-second hold only; no remote reset endpoint",
    "resetRequiresPhysicalPresence": true,
    "postSuccessBleWindowMs": 15000,
    "postWindowFailureBehavior": "stop BLE and require device restart to open a new first-boot window"
  },
  "logging": {
    "firmwareSerialBaudRate": 115200,
    "passwordLoggingAllowed": false,
    "popLoggingAllowed": false,
    "rawSecurityMaterialLoggingAllowed": false
  },
  "owners": {
    "app": "nuwax-mobile Android team",
    "firmware": "nuwax-ai-partner firmware team",
    "hardware": "Nuwax ESP32-S3 desktop hardware team",
    "test": "Nuwax desktop integration test team"
  }
}
