import { apiPublishedAgentInfo } from "@/servers/agentDev";
import { HideChatAreaEnum, ExpandPageAreaEnum } from "@/types/enums/agent";
import { getApiBaseUrl } from "@/constants/config";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { apiUserTicketCreate } from "@/servers/agentDev";
import { getCurrentPageFullPath } from "@/utils/common";
import { apiResCode, apiResData } from "@/utils/apiResponse";
import { isAppWebViewEmbedded, navigateViaWebViewSdk } from "@/utils/system";
import { t } from "@/utils/i18n";
import { orEmpty } from "@/utils/utsCoalesce";

/**
 * 获取ticket
 */
export const getTicket = async (): Promise<string> => {
  const ticketResult = await apiUserTicketCreate();
  let _ticket: string = "";
  const ticketData = apiResData<any>(ticketResult);
  if (apiResCode(ticketResult) == SUCCESS_CODE && ticketData != null && `${ticketData}` != "") {
    _ticket = `${ticketData}`;
  }
  return _ticket;
};

/**
 * 判断是否是根页面或id页面
 * @param str
 * @returns
 */
export const isRootOrId = (str: string) => {
  return str === "/" || /^\/\?id=\d+$/.test(str);
};

/**
 * 获取当前页面地址不包含url参数 H5 || WEB
 */
export const getCurrentPagePath = () => {
  // #ifdef H5 || WEB
  const currentUrl = orEmpty(getCurrentPageFullPath()?.split("#")?.[1]);
  return currentUrl === "/" ? "/pages/index/index" : currentUrl;
  // #endif

  // #ifdef MP-WEIXIN || APP
  return getCurrentPageFullPath();
  // #endif
};

/**
 * 构造带 ticket 的 webview 目标地址（已 encodeURIComponent，可直接作为 webview 页 url 参数值）。
 *
 * 注意：本函数与两个 jump 包装函数保持「各自独立、参数固定」的形态，不要合并成一个带
 * 可选参数的导出函数。UTS→Kotlin 的默认参数会把形参个数编译进方法签名，给已被主包/分包
 * 多处引用的导出函数增删参数，会在增量编译的旧 dex 上触发
 * NoSuchMethodError: No static method addTicketAndJumpToWebview(...)。
 */
async function buildTicketWebviewUrl(
  url: string,
  jump_type: string,
  title: string,
): Promise<string> {
  const resolvedTitle = title != null && title != "" ? title : t("Mobile.Common.appName");
  const andStr = url.includes("?") ? "&" : "?";
  const baseWebviewUrl = `${getApiBaseUrl()}${url}${andStr}title=${resolvedTitle}`;
  let webviewUrl = "";
  // #ifdef H5 || WEB
  // 当前页面地址
  const backUrl = orEmpty(getCurrentPageFullPath()?.split("#")?.[1]);
  // 保存需要返回的地址在storage中
  uni.setStorageSync("backUrl", backUrl);
  const encodedH5 = encodeURIComponent(baseWebviewUrl);
  webviewUrl = encodedH5 != null ? encodedH5 : "";
  // #endif

  // #ifdef MP-WEIXIN || APP
  const _ticket = await getTicket();
  const encodedApp = encodeURIComponent(
    baseWebviewUrl + `&_ticket=${_ticket}&jump_type=${jump_type}`,
  );
  webviewUrl = encodedApp != null ? encodedApp : "";
  // #endif

  return webviewUrl;
}

/**
 * 将ticket添加到url并跳转至webview页面
 * @param url
 * @param jump_type
 * @returns
 */
export async function addTicketAndJumpToWebview(
  url: string,
  jump_type: "inner" | "outer" = "inner",
  title: string = "",
): Promise<void> {
  const webviewUrl = await buildTicketWebviewUrl(url, jump_type, title);
  uni.hideLoading();
  uni.navigateTo({
    url: `/subpackages/pages/webview/webview?url=${webviewUrl}`,
  });
}

/**
 * 同 addTicketAndJumpToWebview，但隐藏 webview 导航栏右侧的分享按钮（纯展示页用）。
 * hideShare 挂在 webview 页自身的路由参数上，不进目标网页 URL，避免污染业务页 query。
 */
export async function addTicketAndJumpToWebviewWithoutShare(
  url: string,
  jump_type: "inner" | "outer" = "inner",
  title: string = "",
): Promise<void> {
  const webviewUrl = await buildTicketWebviewUrl(url, jump_type, title);
  uni.hideLoading();
  uni.navigateTo({
    url: `/subpackages/pages/webview/webview?url=${webviewUrl}&hideShare=1`,
  });
}

// 跳转至智能体详情页面
export async function jumpToAgentDetailPage(
  agentId: number,
  conversationId: number | null = null,
  agentType: "ChatBot" | "PageApp" | "TaskAgent" = "ChatBot",
  title: string = "",
): Promise<void> {
  const resolvedTitle = title != null && title != "" ? title : t("Mobile.Common.appName");
  let url = `/subpackages/pages/agent-detail/agent-detail?id=${agentId}`;
  if (conversationId != null) {
    url = url + "&conversationId=" + conversationId;
  }

  // 问答型智能体、任务型智能体直接跳转至智能体详情页面
  if (agentType == "ChatBot" || agentType == "TaskAgent") {
    // App web-view 内嵌 H5：走 JSSDK 推原生页（与 jumpToFilePreviewPage 同模式）。
    // 内嵌时 uni.navigateTo 只是 H5 SPA hash 路由跳转，原生栈不增长，
    // 旧页弹窗残留登记会令 onBackPress 拦截返回（返回按钮无效 / 安卓多次滑动才回首页）。
    if (isAppWebViewEmbedded() && navigateViaWebViewSdk(url)) {
      return;
    }
    uni.navigateTo({ url });
    return;
  }

  if (agentType == "PageApp") {
    try {
      uni.showLoading({ title: t("Mobile.Page.loading") });
      const res = await apiPublishedAgentInfo(agentId);
      const dataRaw = apiResData<any>(res);
      if (apiResCode(res) == SUCCESS_CODE && dataRaw != null) {
        // Android：data 为 UTSJSONObject/Map，禁止 as AgentDetailDto
        let pageHomeIndex = "";
        try {
          const dataObj = dataRaw as UTSJSONObject;
          const pageHomeIndexRaw = dataObj["pageHomeIndex"];
          if (pageHomeIndexRaw != null) {
            pageHomeIndex = `${pageHomeIndexRaw}`;
          }
        } catch (_eObj) {
          try {
            const m = dataRaw as Map<string, any | null>;
            const pageHomeIndexRaw = m.get("pageHomeIndex");
            if (pageHomeIndexRaw != null) {
              pageHomeIndex = `${pageHomeIndexRaw}`;
            }
          } catch (_eMap) {
            // ignore
          }
        }
        if (pageHomeIndex != "") {
          await addTicketAndJumpToWebview(
            pageHomeIndex,
            "inner",
            resolvedTitle,
          );
        }
      }
    } finally {
      uni.hideLoading();
    }
  }
}

// 判断当前页面是否是tab页面
export const isTabPage = (url: string) => {
  const tabPageList = [
    "/pages/index/index", // 对话（首页）
    "/pages/agent-union-record/agent-union-record", // 智联录
    "/pages/agent-list/agent-list", // 智能体
    "/pages/mine/mine", // 我的
  ];
  return tabPageList.includes(url);
};
