/**
 * nuwax-ratex Android 原生后端（UTS）。
 * LaTeX → Rust parse+layout → DisplayList → Android Canvas → Bitmap → WebP base64。
 */
import { RaTeXBridge } from 'io.ratex'
import Exception from 'java.lang.Exception'
import Log from 'android.util.Log'
import ExecutorService from 'java.util.concurrent.ExecutorService'
import Executors from 'java.util.concurrent.Executors'
import Handler from 'android.os.Handler'
import Looper from 'android.os.Looper'
export * from '../interface.uts'
import { RatexRenderOptions, RatexRenderResult } from '../interface.uts'

/** 渲染一条 LaTeX → WebP dataURL + 逻辑宽高（同步）。 */
export function renderLatex(tex: string, opts: RatexRenderOptions): RatexRenderResult {
	if (tex.length == 0) {
		return { imageDataURL: '', width: 0, height: 0, errMsg: 'empty_tex' }
	}
		try {
			const ctx = UTSAndroid.getAppContext()
			if (ctx == null) {
				return { imageDataURL: '', width: 0, height: 0, errMsg: 'no_context' }
			}
			const fontSizePx = opts.fontSize.toFloat()
			console.log('[RaTeX] render start: ' + tex.substring(0, 20))
			Log.d('RaTeX', 'render start: ' + tex.substring(0, 30))
			// RaTeXBridge 返回 "data:image/webp;base64,<b64>|<w>|<h>" 或 "ERR:<msg>"
			const raw = RaTeXBridge.renderToWebpDataUrl(tex, opts.displayMode, fontSizePx, opts.color, ctx!)
			Log.d('RaTeX', 'render done: len=' + raw.length + ' err=' + (raw.startsWith('ERR:') ? raw.substring(4) : 'OK'))
			if (raw.startsWith('ERR:')) {
				return { imageDataURL: '', width: 0, height: 0, errMsg: raw.substring(4) }
			}
		const firstPipe = raw.indexOf('|')
		const lastPipe = raw.lastIndexOf('|')
		if (firstPipe < 0 || lastPipe <= firstPipe) {
			return { imageDataURL: '', width: 0, height: 0, errMsg: 'bad_format' }
		}
		return {
			imageDataURL: raw.substring(0, firstPipe),
			width: parseInt(raw.substring(firstPipe + 1, lastPipe)),
			height: parseInt(raw.substring(lastPipe + 1)),
			errMsg: '',
		}
	} catch (e: Exception) {
		return { imageDataURL: '', width: 0, height: 0, errMsg: 'ratex_exception' }
	}
}

// 异步版本（多线程并行 executor + 主线程回调）
// RaTeX Rust 引擎无状态，可安全并行；与 KaTeX 多 WebView 并行对等
const ratexExecutor: ExecutorService = Executors.newFixedThreadPool(4)
const mainHandler = new Handler(Looper.getMainLooper())

export function renderLatexAsync(
	tex: string,
	opts: RatexRenderOptions,
	onResult: (res: RatexRenderResult) => void,
): void {
	ratexExecutor.execute((): void => {
		const res = renderLatex(tex, opts)
		mainHandler.post((): void => {
			onResult(res)
		})
	})
}
