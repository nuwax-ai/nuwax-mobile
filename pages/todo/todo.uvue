<template>
  <view class="todo">
    <custom-nav-bar :title="t('Mobile.Discover.todo')" className="border-b" hasSafetyZone :show-back="true">
      <template #right>
        <view class="todo__add" @click="onAdd">
          <svg-icon name="icon-Plus" size="22" unit="px" color="#1f2329" />
        </view>
      </template>
    </custom-nav-bar>
    <view class="todo__tabs">
      <view class="todo__tab" @click="selectTab(0)">
        <text class="todo__tab-text" :class="pageIndex == 0 ? 'todo__tab-text--on' : ''">{{ mineTabText }}</text>
        <view class="todo__tab-bar" :class="pageIndex == 0 ? 'todo__tab-bar--on' : ''"></view>
      </view>
      <view class="todo__tab" @click="selectTab(1)">
        <text class="todo__tab-text" :class="pageIndex == 1 ? 'todo__tab-text--on' : ''">{{ createdTabText }}</text>
        <view class="todo__tab-bar" :class="pageIndex == 1 ? 'todo__tab-bar--on' : ''"></view>
      </view>
    </view>
    <swiper class="todo__swiper" :current="pageIndex" :duration="280" @change="onSwiperChange">
      <swiper-item>
        <scroll-view
          class="todo__scroll"
          direction="vertical"
          :show-scrollbar="false"
          :refresher-enabled="true"
          :refresher-triggered="mineRefreshing"
          @refresherrefresh="onMineRefresh"
          @refresherrestore="onMineRefreshEnd"
          @refresherabort="onMineRefreshEnd"
        >
          <view v-if="mineLoaded && mineItems.length == 0" class="todo__empty">
            <text class="todo__empty-text">{{ t("Mobile.Discover.todoEmpty") }}</text>
          </view>
          <view v-for="item in mineItems" :key="item.id" class="todo__row" @click="openDetail(item.id)">
            <view class="todo__main">
              <text class="todo__name">{{ item.title }}</text>
              <view v-if="item.dueText.length > 0 || item.important" class="todo__tags">
                <view v-if="item.dueText.length > 0" class="todo__tag">
                  <text class="todo__tag-text">{{ item.dueText }}</text>
                </view>
                <view v-if="item.important" class="todo__tag todo__tag--hot">
                  <text class="todo__tag-text todo__tag-text--hot">{{ t("Mobile.Discover.todoImportant") }}</text>
                </view>
              </view>
            </view>
            <view
              class="todo__check"
              :class="item.completed ? 'todo__check--on' : ''"
              @click.stop="openComplete(item)"
            ></view>
          </view>
        </scroll-view>
      </swiper-item>
      <swiper-item>
        <scroll-view
          class="todo__scroll"
          direction="vertical"
          :show-scrollbar="false"
          :refresher-enabled="true"
          :refresher-triggered="createdRefreshing"
          @refresherrefresh="onCreatedRefresh"
          @refresherrestore="onCreatedRefreshEnd"
          @refresherabort="onCreatedRefreshEnd"
        >
          <view v-if="createdLoaded && createdItems.length == 0" class="todo__empty">
            <text class="todo__empty-text">{{ t("Mobile.Discover.todoEmpty") }}</text>
          </view>
          <view v-for="item in createdItems" :key="item.id" class="todo__row" @click="openDetail(item.id)">
            <view class="todo__main">
              <text class="todo__name">{{ item.title }}</text>
              <view v-if="item.dueText.length > 0 || item.important" class="todo__tags">
                <view v-if="item.dueText.length > 0" class="todo__tag">
                  <text class="todo__tag-text">{{ item.dueText }}</text>
                </view>
                <view v-if="item.important" class="todo__tag todo__tag--hot">
                  <text class="todo__tag-text todo__tag-text--hot">{{ t("Mobile.Discover.todoImportant") }}</text>
                </view>
              </view>
            </view>
            <view
              class="todo__check"
              :class="item.completed ? 'todo__check--on' : ''"
              @click.stop="openComplete(item)"
            ></view>
          </view>
        </scroll-view>
      </swiper-item>
    </swiper>
    <todo-create-sheet ref="createSheetRef" @submit="onCreateSubmit" @open-due="onOpenDue" />
    <todo-due-picker ref="duePickerRef" @confirm="onDueConfirm" />
    <todo-complete-sheet ref="completeSheetRef" @done="onCompleteDone" />
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, type ComponentPublicInstance } from "vue";
  import { onShow } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiErrorMessage, apiResCode, apiResData } from "@/utils/apiResponse";
  import { apiCalendarListMyCreated, apiCalendarListMyParticipated } from "@/servers/calendar/calendar.uts";
  import { CalendarEventQueryReq } from "@/types/interfaces/calendar";
  import { CalendarCategoryEnum, CalendarEventStatusEnum } from "@/types/enums/calendar";
  import { getMyUserIdSync } from "@/utils/imNoticeBar";
  import TodoCreateSheet from "./components/todo-create-sheet/todo-create-sheet.uvue";
  import TodoDuePicker from "./components/todo-due-picker/todo-due-picker.uvue";
  import TodoCompleteSheet from "./components/todo-complete-sheet/todo-complete-sheet.uvue";

  class TodoRow {
    id: string = "";
    title: string = "";
    dueText: string = "";
    important: boolean = false;
    completed: boolean = false;
    creator: boolean = false;
    assigneeLine: string = "";
  }

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  function dueChip(when: string): string {
    const params = new Map<string, string | number>();
    params.set("when", when);
    return translateFn("Mobile.Discover.todoDueLabel", toI18nParams(params), "");
  }

  /** 0=我负责的，1=我创建的。与 swiper 当前页一致。 */
  const pageIndex = ref<number>(0);
  const mineItems = ref<TodoRow[]>([]);
  const createdItems = ref<TodoRow[]>([]);
  const mineLoaded = ref<boolean>(false);
  const createdLoaded = ref<boolean>(false);
  const mineRefreshing = ref<boolean>(false);
  const createdRefreshing = ref<boolean>(false);
  const mineTabText = computed((): string => {
    const label = t("Mobile.Discover.todoMine");
    if (!mineLoaded.value) {
      return label;
    }
    return label + " " + `${mineItems.value.length}`;
  });
  const createdTabText = computed((): string => {
    const label = t("Mobile.Discover.todoCreated");
    if (!createdLoaded.value) {
      return label;
    }
    return label + " " + `${createdItems.value.length}`;
  });

  const createSheetRef = ref<any | null>(null);
  const duePickerRef = ref<any | null>(null);
  const completeSheetRef = ref<any | null>(null);
  let mineToken = 0;
  let createdToken = 0;

  function readText(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const text = `${raw}`.trim();
    if (text == "null" || text == "undefined") {
      return "";
    }
    return text;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    if (raw == true) {
      return true;
    }
    return raw != null && `${raw}` == "true";
  }

  function asRecordList(raw: any | null): UTSJSONObject[] {
    const list: UTSJSONObject[] = [];
    if (raw == null) {
      return list;
    }
    try {
      const text = JSON.stringify(raw);
      if (text == null || text.length == 0 || text.charAt(0) != "[") {
        return list;
      }
      const parsed = JSON.parse(text) as UTSJSONObject[] | null;
      if (parsed == null) {
        return list;
      }
      for (let i = 0; i < parsed.length; i++) {
        const row = parsed[i];
        if (row != null) {
          list.push(row);
        }
      }
    } catch (_error) {
      return list;
    }
    return list;
  }

  function pad2(value: number): string {
    if (value < 10) {
      return `0${value}`;
    }
    return `${value}`;
  }

  function formatDay(date: Date): string {
    return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}`;
  }

  function datePart(raw: string): string {
    if (raw.length < 10) {
      return "";
    }
    return raw.substring(0, 10);
  }

  function timePart(raw: string): string {
    if (raw.length < 16) {
      return "";
    }
    const separator = raw.charAt(10);
    if (separator != "T" && separator != " ") {
      return "";
    }
    return raw.substring(11, 16);
  }

  function weekdayText(day: string): string {
    const parts = day.split("-");
    if (parts.length < 3) {
      return "";
    }
    const year = parseInt(parts[0]);
    const month = parseInt(parts[1]);
    const date = parseInt(parts[2]);
    if (year <= 0 || month <= 0 || date <= 0) {
      return "";
    }
    const parsed = new Date(year, month - 1, date);
    const index = parsed.getDay();
    if (index == 1) {
      return t("Mobile.Discover.weekdayMon");
    }
    if (index == 2) {
      return t("Mobile.Discover.weekdayTue");
    }
    if (index == 3) {
      return t("Mobile.Discover.weekdayWed");
    }
    if (index == 4) {
      return t("Mobile.Discover.weekdayThu");
    }
    if (index == 5) {
      return t("Mobile.Discover.weekdayFri");
    }
    if (index == 6) {
      return t("Mobile.Discover.weekdaySat");
    }
    return t("Mobile.Discover.weekdaySun");
  }

  function dueWhen(due: string, clock: string, todayText: string, tomorrowText: string, weekStartText: string, weekEndText: string, nextWeekEndText: string): string {
    if (due.length == 0) {
      return "";
    }
    let label = "";
    if (due == todayText) {
      label = t("Mobile.Discover.scheduleToday");
    } else if (due == tomorrowText) {
      label = t("Mobile.Discover.todoTomorrow");
    } else if (due >= weekStartText && due <= weekEndText) {
      label = weekdayText(due);
    } else if (due > weekEndText && due <= nextWeekEndText) {
      label = t("Mobile.Discover.todoNextWeek") + weekdayText(due);
    } else if (due.length >= 10) {
      label = due.substring(5);
    }
    if (label.length == 0) {
      return "";
    }
    if (clock.length > 0) {
      label = label + " " + clock;
    }
    return dueChip(label);
  }

  function personName(row: UTSJSONObject, myId: string): string {
    const userId = readText(row, "userId");
    if (myId.length > 0 && userId == myId) {
      return t("Mobile.Discover.todoAssigneeMe");
    }
    const name = readText(row, "name");
    if (name.length > 0) {
      return name;
    }
    const nick = readText(row, "nickName");
    if (nick.length > 0) {
      return nick;
    }
    return readText(row, "userName");
  }

  function buildAssigneeLine(record: UTSJSONObject): string {
    const myId = getMyUserIdSync();
    const creatorId = readText(record, "creatorId");
    const participants = asRecordList(record["participants"]);
    const names: string[] = [];
    for (let i = 0; i < participants.length; i++) {
      const name = personName(participants[i], myId);
      if (name.length == 0) {
        continue;
      }
      let duplicated = false;
      for (let j = 0; j < names.length; j++) {
        if (names[j] == name) {
          duplicated = true;
          break;
        }
      }
      if (!duplicated) {
        names.push(name);
      }
    }
    let namesText = "";
    for (let i = 0; i < names.length; i++) {
      if (i > 0) {
        namesText += "、";
      }
      namesText += names[i];
    }
    if (namesText.length == 0 && myId.length > 0 && creatorId == myId) {
      namesText = t("Mobile.Discover.todoAssigneeMe");
    }
    const params = new Map<string, string | number>();
    params.set("names", namesText);
    let line = translateFn("Mobile.Discover.todoCompleteAssignee", toI18nParams(params), "");
    if (myId.length > 0 && creatorId == myId) {
      line = line + " · " + t("Mobile.Discover.todoCompleteCreatorHint");
    }
    return line;
  }

  function mapRows(raw: any | null): TodoRow[] {
    const rows: TodoRow[] = [];
    const now = new Date();
    const todayText = formatDay(now);
    const tomorrow = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
    const tomorrowText = formatDay(tomorrow);
    const weekday = now.getDay();
    const mondayOffset = weekday == 0 ? 6 : weekday - 1;
    const weekStart = new Date(now.getFullYear(), now.getMonth(), now.getDate() - mondayOffset);
    const weekEnd = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() + 6);
    const nextWeekEnd = new Date(weekEnd.getFullYear(), weekEnd.getMonth(), weekEnd.getDate() + 7);
    const weekStartText = formatDay(weekStart);
    const weekEndText = formatDay(weekEnd);
    const nextWeekEndText = formatDay(nextWeekEnd);
    const records = asRecordList(raw);
    for (let i = 0; i < records.length; i++) {
      const record = records[i];
      const row = new TodoRow();
      row.id = readText(record, "id");
      row.title = readText(record, "title");
      if (row.title.length == 0) {
        row.title = readText(record, "description");
      }
      if (row.id.length == 0) {
        row.id = `todo-${i}`;
      }
      row.important = readText(record, "priority") == "3";
      row.completed = readText(record, "status") == `${CalendarEventStatusEnum.COMPLETED}`;
      const myId = getMyUserIdSync();
      const creatorId = readText(record, "creatorId");
      row.creator = myId.length > 0 && creatorId == myId;
      row.assigneeLine = buildAssigneeLine(record);
      const endTime = readText(record, "endTime");
      const startTime = readText(record, "startTime");
      const source = endTime.length > 0 ? endTime : startTime;
      const due = datePart(source);
      let clock = "";
      if (!readBool(record, "allDay")) {
        clock = timePart(source);
      }
      row.dueText = dueWhen(due, clock, todayText, tomorrowText, weekStartText, weekEndText, nextWeekEndText);
      rows.push(row);
    }
    return rows;
  }

  async function fetchList(participated: boolean): Promise<TodoRow[] | null> {
    try {
      const query = new CalendarEventQueryReq();
      query.category = `${CalendarCategoryEnum.TODO}`;
      if (participated) {
        const res = await apiCalendarListMyParticipated(query);
        if (apiResCode(res) != SUCCESS_CODE) {
          return null;
        }
        return mapRows(apiResData<any>(res));
      }
      const created = await apiCalendarListMyCreated(query);
      if (apiResCode(created) != SUCCESS_CODE) {
        return null;
      }
      return mapRows(apiResData<any>(created));
    } catch (error) {
      const message = apiErrorMessage(error);
      if (message.length > 0) {
        uni.showToast({ title: message, icon: "none" });
      }
      return null;
    }
  }

  /** 只拉指定一页。未加载过时才请求；force 用于下拉刷新和新建成功。 */
  async function loadTab(participated: boolean, force: boolean): Promise<void> {
    if (participated) {
      if (mineLoaded.value && !force) {
        return;
      }
      mineToken++;
      const token = mineToken;
      const rows = await fetchList(true);
      if (token != mineToken) {
        return;
      }
      mineRefreshing.value = false;
      if (rows != null) {
        mineItems.value = rows;
      }
      mineLoaded.value = true;
      return;
    }
    if (createdLoaded.value && !force) {
      return;
    }
    createdToken++;
    const token = createdToken;
    const rows = await fetchList(false);
    if (token != createdToken) {
      return;
    }
    createdRefreshing.value = false;
    if (rows != null) {
      createdItems.value = rows;
    }
    createdLoaded.value = true;
  }

  function selectTab(index: number): void {
    if (pageIndex.value == index) {
      return;
    }
    pageIndex.value = index;
    loadTab(index == 0, false);
  }

  function onSwiperChange(e: UniSwiperChangeEvent): void {
    const nextIndex = e.detail.current;
    if (nextIndex == pageIndex.value) {
      return;
    }
    pageIndex.value = nextIndex;
    loadTab(nextIndex == 0, false);
  }

  function onMineRefresh(): void {
    mineRefreshing.value = true;
    loadTab(true, true);
  }

  function onMineRefreshEnd(): void {
    mineRefreshing.value = false;
  }

  function onCreatedRefresh(): void {
    createdRefreshing.value = true;
    loadTab(false, true);
  }

  function onCreatedRefreshEnd(): void {
    createdRefreshing.value = false;
  }

  onShow(() => {
    const proxy = createSheetRef.value as ComponentPublicInstance | null;
    if (proxy != null) {
      proxy.$callMethod("resumeAfterAssignees");
    }
    loadTab(pageIndex.value == 0, true);
  });

  function openDetail(id: string): void {
    if (id.length == 0) {
      return;
    }
    uni.navigateTo({ url: "/pages/todo/todo-detail?id=" + id });
  }

  function openComplete(item: TodoRow): void {
    if (item.completed || item.id.length == 0) {
      return;
    }
    const proxy = completeSheetRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    const payload =
      `{"id":${JSON.stringify(item.id)},"title":${JSON.stringify(item.title)},"line":${JSON.stringify(item.assigneeLine)},"creator":${item.creator ? "true" : "false"}}`;
    proxy.$callMethod("open", payload);
  }

  function onCompleteDone(): void {
    loadTab(pageIndex.value == 0, true);
  }

  function onAdd(): void {
    const proxy = createSheetRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("open");
  }

  function onOpenDue(payload: string): void {
    const proxy = duePickerRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("open", payload);
  }

  function onDueConfirm(payload: string): void {
    const proxy = createSheetRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("applyDue", payload);
  }

  function onCreateSubmit(_content: string): void {
    uni.showToast({ title: t("Mobile.Discover.todoAdded"), icon: "none" });
    loadTab(pageIndex.value == 0, true);
    if (pageIndex.value != 0 && mineLoaded.value) {
      loadTab(true, true);
    }
    if (pageIndex.value != 1 && createdLoaded.value) {
      loadTab(false, true);
    }
  }
</script>

<style scoped>
  .todo {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
  }

  .todo__add {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .todo__tabs {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    padding: 4px 16px 0;
    background-color: #ffffff;
  }

  .todo__tab {
    margin-right: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .todo__tab-text {
    padding-top: 8px;
    font-size: 16px;
    line-height: 22px;
    color: #8f959e;
  }

  .todo__tab-text--on {
    color: #1f2329;
    font-weight: 600;
  }

  .todo__tab-bar {
    width: 28px;
    height: 3px;
    margin-top: 8px;
    border-radius: 2px;
    background-color: transparent;
  }

  .todo__tab-bar--on {
    background-color: #1f2329;
  }

  .todo__swiper {
    flex: 1;
    height: 0;
  }

  .todo__scroll {
    height: 100%;
  }

  .todo__empty {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .todo__empty-text {
    font-size: 14px;
    color: #86909c;
  }

  .todo__row {
    padding: 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: #f2f3f5;
  }

  .todo__main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .todo__name {
    font-size: 16px;
    line-height: 22px;
    color: #1f2329;
  }

  .todo__tags {
    margin-top: 8px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }

  .todo__tag {
    margin-right: 6px;
    padding: 2px 6px;
    border-radius: 4px;
    background-color: #f2f3f5;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .todo__tag--hot {
    background-color: #fff1f0;
  }

  .todo__tag-text {
    font-size: 12px;
    line-height: 18px;
    color: #646a73;
  }

  .todo__tag-text--hot {
    color: #f54a45;
  }

  .todo__check {
    width: 22px;
    height: 22px;
    margin-left: 12px;
    border-width: 1.5px;
    border-style: solid;
    border-color: #c9cdd4;
    border-radius: 11px;
    flex-shrink: 0;
  }

  .todo__check--on {
    background-color: #1f2329;
    border-color: #1f2329;
  }
</style>
