<template>
  <view class="nav-root">
    <view
      class="layout"
      :class="[(className != null ? className : ''), fixed == true ? 'layout-fixed' : '']"
      :style="layoutStyle"
    >
      <!-- 微信安全区 -->
      <safety-zone v-if="hasSafetyZone"></safety-zone>
      <view :class="['nav-bar', leftWide == true ? 'nav-bar-left-wide' : '']">
        <!-- 左侧菜单按钮 -->
        <view :class="['left-box', titleAlign == 'left' ? 'left-box-compact' : '', leftWide == true ? 'left-box-wide' : '']">
          <view class="menu-btn">
            <view v-if="showBack" class="back-btn" @click="onBackClick">
              <svg-icon name="icon-a-Chevronleft" size="44" />
            </view>
            <slot name="left"></slot>
          </view>
        </view>

        <!-- 中间 logo + 名称 -->
        <view :class="leftWide == true ? 'logo-wrap-hidden' : 'logo-wrap'">
          <view class="title-box" :class="titleAlign == 'left' ? 'title-box-left' : ''">
            <!-- 图标 -->
            <view class="logo" v-if="icon != null && icon != ''">
              <image
                v-if="currentIcon.length > 0"
                class="logo__image"
                :src="currentIcon"
                mode="aspectFill"
                :alt="displayTitle != null && displayTitle != '' ? displayTitle : t('Mobile.Common.agentIconAlt')"
                @error="handleImageError"
              ></image>
            </view>
            <!-- 标题 -->
            <text
              class="title text-ellipsis"
              :class="[icon != null && icon != '' ? 'title-exist-icon' : 'title-no-icon', titleAlign == 'left' ? 'title-text-left' : '']"
              >{{ displayTitle }}</text
            >
          </view>
        </view>

        <!-- 右侧插槽 -->
        <view class="right-box">
          <slot name="right"></slot>
        </view>

        <!-- 微信胶囊按钮功能区 -->
        <!-- #ifdef MP-WEIXIN -->
        <view
          v-if="false"
          class="right-safety"
          :style="{
            width: clientRect.width + 'px',
            height: clientRect.height + 'px',
          }"
        ></view>
        <!-- #endif -->
      </view>
    </view>

    <!-- fixed 模式占位：导航 position:fixed 脱离文档流后，同高占位在文档流中顶开下方内容，
         结构镜像导航内部（safety-zone 状态栏 + 同高导航条），导航栏高度变化占位自动跟随 -->
    <!-- #ifdef H5 -->
    <view v-if="fixed == true" class="layout-placeholder">
      <safety-zone v-if="hasSafetyZone"></safety-zone>
      <view class="nav-bar-placeholder"></view>
    </view>
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
// vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
defineOptions({ styleIsolation: 'app' });

import { computed, ref, watch, onMounted, onUnmounted } from "vue";
import { chatService } from "@/utils/chatService";
import agentImage from "@/static/assets/agent_image.png";
import { translateText, t as translateFn, emptyI18nParams } from "@/utils/i18n";
import { isAppWebViewEmbedded } from "@/utils/system.uts";
import { resolveAppSvgUrl } from "@/utils/remoteSvgImage";
import {
  dumpKeyboardDiag,
  resolveNavKeyboardOffset,
} from "@/utils/appWebViewKeyboardChrome.uts";
const _params = emptyI18nParams();
const t = (key: string): string => translateFn(key, _params, "");

// #ifdef MP-WEIXIN
const clientRect = uni.getMenuButtonBoundingClientRect();
// #endif

const props = defineProps({
  title: String,
  icon: String,
  showBack: Boolean,
  className: String,
  hasSafetyZone: Boolean,
  transparentBackground: Boolean,
  backgroundColor: String,
  interceptBack: Boolean,
  leftWide: Boolean,
  // 标题对齐方式：'center'（默认，居中）| 'left'（左侧）
  titleAlign: String,
  // 固定定位（H5 生效）：键盘弹出浏览器自动滚动文档时导航栏不随文档滚走；状态栏高度由内部 safety-zone 自取
  fixed: Boolean,
});
const emit = defineEmits(["back"]);

const displayTitle = computed<string>(() => {
  return translateText(props.title != null ? props.title : "");
});

// #ifdef H5 || WEB
/**
 * iOS / 鸿蒙：cover-lock 下导航不做 translateY（navOff 恒 0）；
 * Android：offsetTop 多为 0。保留监听仅用于诊断。
 */
const visualViewportOffsetTop = ref<number>(0);
/** 导航补偿日志节流 */
let lastNavDiagAt: number = 0;
let lastNavDiagTop: number = -1;

function syncVisualViewportOffset(): void {
  if (props.fixed != true) {
    visualViewportOffsetTop.value = 0;
    return;
  }
  const next = resolveNavKeyboardOffset();
  visualViewportOffsetTop.value = next;
  const now = Date.now();
  if (next != lastNavDiagTop || now - lastNavDiagAt > 400) {
    lastNavDiagTop = next;
    lastNavDiagAt = now;
    const navLog =
      "[kb-diag] nav-bar fixed=" +
      `${props.fixed == true}` +
      " navOff=" +
      `${next}` +
      " transform=none";
    console.log(navLog);
    dumpKeyboardDiag("nav-bar-sync", -1, -1);
  }
}

function onNavKeyboardHeightChange(_evt: any): void {
  syncVisualViewportOffset();
}

function bindVisualViewportSync(): void {
  try {
    window.addEventListener("scroll", syncVisualViewportOffset, true);
    const vv = window.visualViewport;
    if (vv != null) {
      vv.addEventListener("resize", syncVisualViewportOffset);
      vv.addEventListener("scroll", syncVisualViewportOffset);
    }
    window.addEventListener(
      "nuwax:keyboardHeightChange",
      onNavKeyboardHeightChange,
    );
  } catch (_e) {
    // ignore
  }
}

function unbindVisualViewportSync(): void {
  try {
    window.removeEventListener("scroll", syncVisualViewportOffset, true);
    const vv = window.visualViewport;
    if (vv != null) {
      vv.removeEventListener("resize", syncVisualViewportOffset);
      vv.removeEventListener("scroll", syncVisualViewportOffset);
    }
    window.removeEventListener(
      "nuwax:keyboardHeightChange",
      onNavKeyboardHeightChange,
    );
  } catch (_e) {
    // ignore
  }
}

onMounted((): void => {
  if (props.fixed == true) {
    bindVisualViewportSync();
    syncVisualViewportOffset();
  }
});

onUnmounted((): void => {
  unbindVisualViewportSync();
});

watch(
  (): boolean => props.fixed == true,
  (enabled: boolean): void => {
    if (enabled == true) {
      bindVisualViewportSync();
      syncVisualViewportOffset();
    } else {
      unbindVisualViewportSync();
      visualViewportOffsetTop.value = 0;
    }
  },
);
// #endif

/** 导航栏内联样式：仅背景色。
 * H5 fixed 的 visualViewport 补偿改由 appWebViewKeyboardChrome
 * 每帧直接写 DOM transform（!important），避免 Vue :style 滞后造成「先顶走再弹回」。
 */
const layoutStyle = computed((): UTSJSONObject => {
  const style: UTSJSONObject = {
    backgroundColor:
      props.transparentBackground == true ? "transparent" : props.backgroundColor,
  } as UTSJSONObject;
  return style;
});

// 当前显示的图标（用于处理加载失败时使用默认图片）
// App 端 <image> 渲染远程 SVG 时按声明尺寸 1:1 光栅化，CSS 宽高/mode 缩放失效（显示为裁切或过小），
// 需按容器尺寸走 resolveAppSvgUrl 解析为 data URL（H5/小程序原样透传，不产生额外请求）。
// 尺寸取 .logo 容器 64rpx × .image 的 106%（overscan）≈ 68rpx，保证 1:1 绘制正好铺满。
const NAV_ICON_RPX = 68;
// 解析完成前不给 <image> 任何 src（初始为空串）：iOS 端替换 src 会取消上一张的在途请求并补发一次 error，
// 事件无法区分是哪个 src 失败，handleImageError 会把刚解析好的图标误判为加载失败而换回默认图。
// 详见 components/agent-icon/agent-icon.uvue 的同类说明。
const currentIcon = ref<string>("");
// 解析竞态序号：图标连续变化时，过期的异步解析结果不得覆盖新目标
let iconResolveSeq = 0;

/**
 * 是否需要等待 resolveAppSvgUrl 解析后再显示。
 * App 端远程 SVG 直接塞给 <image> 会显示成裁切/超小图，解析前先占位默认头像，避免闪一帧异常图；
 * 其余情况（非 App 端、PNG/JPG、已是 data URL）立即显示，无占位闪烁。
 */
function needsSvgResolve(url: string): boolean {
  // #ifdef APP
  const lower = url.toLowerCase();
  if (lower.startsWith("data:image/svg")) return false;
  return lower.endsWith(".svg") || lower.includes(".svg?");
  // #endif
  // #ifndef APP
  return false;
  // #endif
}

const onBackClick = () => {
  if (props.interceptBack == true) {
    emit("back");
    return;
  }
  // 中止当前会话
  chatService.abort();
  // #ifdef H5 || WEB
  // App web-view 内嵌：勿用 uni.webView.navigateBack——JSSDK 在 JavaBridge 线程调原生
  // navigateBack，Android 上常出现 getCurrentPages 为空 → errCode=4 未捕获 Promise。
  // 改为 postMessage，由承载页（agent-detail）在原生主路径按页面栈安全 pop / switchTab。
  if (isAppWebViewEmbedded() == true) {
    try {
      const w = window as any;
      if (
        w != null &&
        w.uni != null &&
        w.uni.webView != null &&
        w.uni.webView.postMessage != null
      ) {
        w.uni.webView.postMessage({
          data: { "type": "app-nav-back" } as UTSJSONObject,
        });
        return;
      }
    } catch (_e) {
      // ignore
    }
    // JSSDK 不可用兜底：回 H5 首页（浏览器语义）
    uni.reLaunch({
      url: "/pages/index/index",
    });
    return;
  }
  // #endif
  // 获取当前页面栈
  const pages = getCurrentPages();
  // 如果页面栈中有多个页面，正常返回
  if (pages.length > 1) {
    uni.navigateBack({
      delta: 1,
    });
    return;
  }
  // 如果页面栈只有一个页面（浏览器刷新后），使用浏览器历史记录返回 如果没有历史记录，跳转到首页
  uni.reLaunch({
    url: "/pages/index/index",
  });
};

/**
 * 图片加载失败处理
 * 当图片加载失败时，使用默认图片
 */
const handleImageError = () => {
  // 尚未给出 src（解析中）时收到的 error 一定不属于当前图标，忽略
  if (currentIcon.value.length == 0) return;
  // 作废进行中的解析，避免过期结果把兜底图重新覆盖回加载失败的地址
  iconResolveSeq++;
  currentIcon.value = agentImage;
};

// 监听 props.icon 变化，更新当前图标
watch(
  () : string | null => props.icon as string | null,
  (newIcon : string | null) => {
    const nextIcon = newIcon != null && newIcon != "" ? newIcon : agentImage;
    // App 端远程 SVG 解析完成前不给 src（给了会先闪一帧裁切图，且换 src 时会触发 iOS 的假 error）；其余情况立即显示
    currentIcon.value = needsSvgResolve(nextIcon) ? "" : nextIcon;
    const seq = ++iconResolveSeq;
    resolveAppSvgUrl(nextIcon, NAV_ICON_RPX, NAV_ICON_RPX).then((resolved : string) => {
      if (seq == iconResolveSeq) {
        currentIcon.value = resolved;
      }
    });
  },
  { immediate: true },
);
</script>

<style lang="scss" scoped>
@import "@/styles/nav-bar-size.scss";

/* vapor styleIsolation 2.0：全部扁平单类（后代/复合选择器会被丢弃）。
   特性来自主线：fixed 定位 + 占位镜像 + $nav-bar-height-h5 统一高度 + titleAlign。 */

.nav-root {
  flex-shrink: 0;
}

/* #ifdef H5 */
/* 固定定位（fixed prop 启用）：聊天页键盘弹出时导航栏钉在屏顶。
   Android：对抗文档自动滚动；iOS / 鸿蒙：配合 visualViewport translateY 补偿与文档滚动锁。
   状态栏/刘海高度由组件内部 safety-zone 依据注入值自行占位，无需外部传入。
   背景用不透明白色（勿用 var(--background-color-content)：uni-app x 运行时未配置 backgroundColorContent
   时该变量默认为 transparent，兜底 #fff 不生效，滚动时内容会透过导航栏）；!important 压过根 :style
   的 backgroundColor 绑定（未传时为 undefined）。 */
.layout-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #ffffff !important;
  /* cover-lock：不做 vv translateY；transform 保持 none */
  transform: none !important;
  transition: none !important;
}

.layout-placeholder {
  width: 100%;
}

.nav-bar-placeholder {
  height: $nav-bar-height-h5;
}
/* #endif */

.nav-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: $nav-bar-height-h5;
  /* #ifndef H5 */
  /* 64rpx 图标加上下 20rpx 内边距，避免 Android 父容器裁切标题区域。 */
  height: 104rpx;
  /* #endif */
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.left-box {
  /* #ifdef H5 */
  min-width: 30%;
  /* #endif */
  /* #ifndef H5 */
  min-width: 180rpx;
  /* #endif */
  align-items: flex-start;
}

.left-box-compact {
  min-width: 0;
}

/* leftWide 模式：左侧占满、隐藏中间标题（原后代规则扁平化） */
.left-box-wide {
  flex: 1;
  min-width: 0;
}

.logo-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.logo-wrap-hidden {
  display: none;
}

.menu-btn {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
}

.back-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 64rpx;
  padding: 10rpx;
  margin-left: -10rpx;
  /* #ifdef H5 */
  cursor: pointer;
  /* #endif */
}

.title-box {
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-width: 0;
  overflow: hidden;
}

.title-box-left {
  justify-content: flex-start;
}

.logo {
  margin-right: 12rpx;
  width: 64rpx;
  height: 64rpx;
  /* vapor: 原 border-radius:50% 不被支持，元素为 64rpx 方形，等价 32rpx */
  border-radius: 32rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.logo__image {
  position: absolute;
  left: -3%;
  top: -3%;
  width: 106%;
  height: 106%;
}

.title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
  color: rgba(21, 23, 31, 1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.title-exist-icon {
  /* #ifdef H5 */
  max-width: calc(100% - 64rpx - 12rpx);
  /* #endif */
  text-align: left;
}

.title-no-icon {
  text-align: center;
}

.title-text-left {
  text-align: left;
}

.right-box {
  /* #ifdef H5 */
  min-width: 30%;
  /* #endif */
  /* #ifndef H5 */
  min-width: 180rpx;
  /* #endif */
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  align-content: flex-end;
}
</style>
