/**
 * 朗读文本过滤器：Markdown → 可朗读纯文本，以及按句切分。
 * 注意：uts 正则编译为 Kotlin Regex——不使用 \u{...} 与 m 标志（行锚点用 (?:^|\n) 替代）。
 */
import { VoiceSettings, SentenceDrainResult } from "./voiceTypes";

/** 强句末：优先按完整句切分 */
const SENTENCE_END_CHARS = "。！？!?";

/**
 * 软停顿：流式未出强句末时，达到最短长度后可按逗号/顿号/分号/换行提前切出，
 * 让 TTS 更早开播，缩短相对 SSE 的滞后。
 */
const SOFT_BREAK_CHARS = "，,、；;\n";

/** 软切分最短字数：尽早切出，配合「有字即播」 */
const MIN_SOFT_DRAIN_CHARS = 1;

/** 单句最大长度：过碎会导致句间等合成空窗，过长则首包慢 */
const MAX_SENTENCE_LENGTH = 16;

/**
 * 仅保留可朗读正文：去掉 think / 工具调用 / agent-info / conversation 等非正文结构。
 * 供工具栏手动播报与流式播报共用，避免合成超长无效文本导致「图标在转、迟迟无声」。
 */
export function stripNonSpeakableMarkup(raw: string): string {
  if (raw.length == 0) {
    return "";
  }
  let text = raw;

  // think / 推理块（含未闭合）
  text = text.replace(/<think\b[^>]*>[\s\S]*?<\/think>/gi, " ");
  text = text.replace(/<think\b[^>]*>[\s\S]*$/gi, " ");
  text = text.replace(/<\/?think\b[^>]*>/gi, " ");

  // 工具调用 HTML（group / 单标签 / 自闭合）
  text = text.replace(
    /<markdown-custom-process-group\b[^>]*>[\s\S]*?<\/markdown-custom-process-group>/gi,
    " ",
  );
  text = text.replace(
    /<markdown-custom-process\b[^>]*>[\s\S]*?<\/markdown-custom-process>/gi,
    " ",
  );
  text = text.replace(/<markdown-custom-process\b[^>]*\/>/gi, " ");
  text = text.replace(/<\/?markdown-custom-process\b[^>]*>/gi, " ");

  // :::container 整块（属性行 + 下一行 :::）
  text = text.replace(
    /(?:^|\n)[ \t]*:::container\b[^\n]*\n[ \t]*:::[ \t]*(?=\n|$)/gi,
    "\n",
  );
  // 残余 ::: 指令行
  text = text.replace(/(?:^|\n)[ \t]*:::[^\n]*/g, "\n");

  // task-result
  text = text.replace(/<task-result\b[^>]*>[\s\S]*?<\/task-result>/gi, " ");
  text = text.replace(/<task-result\b[^>]*>[\s\S]*$/gi, " ");

  // agent-info / agent（含流式未闭合：开标签到文末 / 残缺开标签）
  text = text.replace(/<agent-info\b[^>]*>[\s\S]*?<\/agent-info>/gi, " ");
  text = text.replace(/<agent-info\b[^>]*\/>/gi, " ");
  text = text.replace(/<agent-info\b[^>]*>[\s\S]*$/gi, " ");
  text = text.replace(/<agent-info\b[^>]*$/gi, " ");
  text = text.replace(/<agent\b[^>]*>[\s\S]*?<\/agent>/gi, " ");
  text = text.replace(/<agent\b[^>]*\/>/gi, " ");
  text = text.replace(/<agent\b[^>]*>[\s\S]*$/gi, " ");
  text = text.replace(/<agent\b[^>]*$/gi, " ");

  // conversation（关联会话卡片，无连字符，需单独剥离）
  text = text.replace(/<conversation\b[^>]*>[\s\S]*?<\/conversation>/gi, " ");
  text = text.replace(/<conversation\b[^>]*\/>/gi, " ");
  text = text.replace(/<conversation\b[^>]*>[\s\S]*$/gi, " ");
  text = text.replace(/<conversation\b[^>]*$/gi, " ");

  // 其他带连字符业务自定义元素
  text = text.replace(
    /<([a-zA-Z][a-zA-Z0-9]*-[a-zA-Z0-9-]+)\b[^>]*>[\s\S]*?<\/\1>/g,
    " ",
  );
  text = text.replace(
    /<[a-zA-Z][a-zA-Z0-9]*-[a-zA-Z0-9-]+\b[^>]*\/>/g,
    " ",
  );
  text = text.replace(
    /<[a-zA-Z][a-zA-Z0-9]*-[a-zA-Z0-9-]+\b[^>]*>[\s\S]*$/g,
    " ",
  );
  text = text.replace(/<[a-zA-Z][a-zA-Z0-9]*-[a-zA-Z0-9-]+\b[^>]*$/g, " ");

  return text;
}

/**
 * 流式场景：去掉已闭合的不可朗读块；若仍有未闭合的 agent-info/agent/conversation 等，截断到开标签前。
 * 避免「整段 hold 到 SSE 结束」——闭合后正文增量可立即进入分句。
 */
export function speakableRawForStreaming(raw: string): string {
  if (raw.length == 0) {
    return "";
  }
  // 纯正文快路径：避免 SSE 每帧对全文跑十几条正则（Android 上会堵死主线程，TTS 要等会话结束才出声）
  if (raw.indexOf("<") < 0 && raw.indexOf(":::") < 0) {
    return raw;
  }
  let text = raw;

  // 先去掉已闭合块（与 stripNonSpeakableMarkup 对齐的关键结构）
  text = text.replace(/<think\b[^>]*>[\s\S]*?<\/think>/gi, " ");
  text = text.replace(
    /<markdown-custom-process-group\b[^>]*>[\s\S]*?<\/markdown-custom-process-group>/gi,
    " ",
  );
  text = text.replace(
    /<markdown-custom-process\b[^>]*>[\s\S]*?<\/markdown-custom-process>/gi,
    " ",
  );
  text = text.replace(/<markdown-custom-process\b[^>]*\/>/gi, " ");
  text = text.replace(/<task-result\b[^>]*>[\s\S]*?<\/task-result>/gi, " ");
  text = text.replace(/<agent-info\b[^>]*>[\s\S]*?<\/agent-info>/gi, " ");
  text = text.replace(/<agent-info\b[^>]*\/>/gi, " ");
  text = text.replace(/<agent\b[^>]*>[\s\S]*?<\/agent>/gi, " ");
  text = text.replace(/<agent\b[^>]*\/>/gi, " ");
  text = text.replace(/<conversation\b[^>]*>[\s\S]*?<\/conversation>/gi, " ");
  text = text.replace(/<conversation\b[^>]*\/>/gi, " ");
  // 已闭合工具卡片 fence，避免正文增量被 container 夹断
  text = text.replace(
    /(?:^|\n)[ \t]*:::container\b[^\n]*\n[ \t]*:::[ \t]*(?=\n|$)/gi,
    "\n",
  );

  // 未闭合开标签 / 未闭合 :::container：截断到开标签前（内部留给后续 chunk）
  const lower = text.toLowerCase();
  let cut = -1;
  const openTokens = [
    "<agent-info",
    "<agent",
    "<think",
    "<task-result",
    "<markdown-custom-process",
    "<conversation",
    ":::container",
  ];
  for (let i = 0; i < openTokens.length; i++) {
    const token = openTokens[i];
    let from = 0;
    while (from < lower.length) {
      const idx = lower.indexOf(token, from);
      if (idx < 0) {
        break;
      }
      // <agent 勿误伤 <agent-info（已用更长 token 优先）
      if (token == "<agent") {
        const after = lower.substring(idx, idx + 11);
        if (after.indexOf("<agent-info") == 0) {
          from = idx + 1;
          continue;
        }
      }
      if (cut < 0 || idx < cut) {
        cut = idx;
      }
      break;
    }
  }
  if (cut >= 0) {
    text = text.substring(0, cut);
  }
  return text;
}

/**
 * 是否可能含 Markdown / HTML / 公式标记（无则走空白规整快路径）。
 * 流式 TTS 增量路径也用它：有标记时必须全量 clean，禁止只洗 delta。
 */
export function looksLikeMarkup(raw: string): boolean {
  return (
    raw.indexOf("<") >= 0 ||
    raw.indexOf("`") >= 0 ||
    raw.indexOf("#") >= 0 ||
    raw.indexOf("[") >= 0 ||
    raw.indexOf("]") >= 0 ||
    raw.indexOf("*") >= 0 ||
    raw.indexOf("_") >= 0 ||
    raw.indexOf("|") >= 0 ||
    raw.indexOf(">") >= 0 ||
    raw.indexOf("~") >= 0 ||
    raw.indexOf("$") >= 0 ||
    raw.indexOf("\\") >= 0 ||
    raw.indexOf(":::") >= 0
  );
}

/**
 * 是否含未闭合的 Markdown 代码围栏（``` 出现奇数次）。
 */
export function hasUnclosedCodeFence(raw: string): boolean {
  if (raw.indexOf("```") < 0) {
    return false;
  }
  let count = 0;
  let from = 0;
  while (from < raw.length) {
    const idx = raw.indexOf("```", from);
    if (idx < 0) {
      break;
    }
    count += 1;
    from = idx + 3;
  }
  return count % 2 == 1;
}

/**
 * 是否含未闭合块级公式（$$ / \[ / \(）。
 * 未闭合时后续 LaTeX 正文会像代码一样泄漏进增量播报。
 */
export function hasUnclosedMath(raw: string): boolean {
  if (raw.length == 0) {
    return false;
  }
  // $$ 奇数次
  let dollarBlock = 0;
  let from = 0;
  while (from < raw.length) {
    const idx = raw.indexOf("$$", from);
    if (idx < 0) {
      break;
    }
    dollarBlock += 1;
    from = idx + 2;
  }
  if (dollarBlock % 2 == 1) {
    return true;
  }
  // \[ 多于 \]
  let openBracket = 0;
  let closeBracket = 0;
  from = 0;
  while (from < raw.length) {
    const idx = raw.indexOf("\\[", from);
    if (idx < 0) {
      break;
    }
    openBracket += 1;
    from = idx + 2;
  }
  from = 0;
  while (from < raw.length) {
    const idx = raw.indexOf("\\]", from);
    if (idx < 0) {
      break;
    }
    closeBracket += 1;
    from = idx + 2;
  }
  if (openBracket > closeBracket) {
    return true;
  }
  // \( 多于 \)
  let openParen = 0;
  let closeParen = 0;
  from = 0;
  while (from < raw.length) {
    const idx = raw.indexOf("\\(", from);
    if (idx < 0) {
      break;
    }
    openParen += 1;
    from = idx + 2;
  }
  from = 0;
  while (from < raw.length) {
    const idx = raw.indexOf("\\)", from);
    if (idx < 0) {
      break;
    }
    closeParen += 1;
    from = idx + 2;
  }
  return openParen > closeParen;
}

/**
 * 是否含未闭合 Markdown 图片 `![...](...`。
 */
export function hasUnclosedImage(raw: string): boolean {
  const start = raw.lastIndexOf("![");
  if (start < 0) {
    return false;
  }
  const after = raw.substring(start);
  // 完整形：![alt](url)
  if (/^!\[[^\]]*\]\([^)]*\)/.test(after) == true) {
    return false;
  }
  return true;
}

/**
 * 流式 TTS：出现结构标记或未闭合结构时必须全量 clean。
 */
export function needsFullSpeechClean(raw: string): boolean {
  if (looksLikeMarkup(raw) == true) {
    return true;
  }
  if (hasUnclosedCodeFence(raw) == true) {
    return true;
  }
  if (hasUnclosedMath(raw) == true) {
    return true;
  }
  if (hasUnclosedImage(raw) == true) {
    return true;
  }
  return false;
}

/**
 * 剥离数学公式（块级 / 行内），避免朗读 LaTeX。
 * 货币 `$100`：单 $ 后紧跟数字时保留，不当作公式。
 */
function stripMathForSpeech(text: string): string {
  let out = text;
  // 块级 $$...$$（含未闭合到文末）
  out = out.replace(/\$\$[\s\S]*?\$\$/g, " ");
  out = out.replace(/\$\$[\s\S]*$/g, " ");
  // \[...\] / \(...\)（含未闭合）
  out = out.replace(/\\\[[\s\S]*?\\\]/g, " ");
  out = out.replace(/\\\[[\s\S]*$/g, " ");
  out = out.replace(/\\\([\s\S]*?\\\)/g, " ");
  out = out.replace(/\\\([\s\S]*$/g, " ");
  // 行内 $...$：跳过 $123 / $1,234.56 货币形态
  let result = "";
  let i = 0;
  while (i < out.length) {
    if (out.charAt(i) != "$") {
      result = result + out.charAt(i);
      i += 1;
      continue;
    }
    // 货币：$ + 数字
    if (i + 1 < out.length) {
      const next = out.charAt(i + 1);
      if (next >= "0" && next <= "9") {
        result = result + "$";
        i += 1;
        continue;
      }
    }
    // 寻找闭合 $
    const close = out.indexOf("$", i + 1);
    if (close < 0 || close == i + 1) {
      // 未闭合或空：丢掉起始 $，避免朗读美元符碎片
      i += 1;
      continue;
    }
    // 中间含换行则不当行内公式（可能是半截块）
    const inner = out.substring(i + 1, close);
    if (inner.indexOf("\n") >= 0) {
      result = result + "$";
      i += 1;
      continue;
    }
    // 跳过整段 $...$（不朗读公式内容）
    i = close + 1;
  }
  return result;
}

/**
 * 剥离图片语法；未闭合的 `![` 截断到开标记前，避免读半截 URL。
 */
function stripImagesForSpeech(text: string): string {
  let out = text.replace(/!\[[^\]]*\]\([^)]*\)/g, " ");
  // 未闭合：![... 或 ![...](... 
  out = out.replace(/!\[[^\]]*\]\([^)]*$/g, " ");
  out = out.replace(/!\[[^\]]*$/g, " ");
  const dangling = out.indexOf("![");
  if (dangling >= 0) {
    out = out.substring(0, dangling);
  }
  return out;
}

/**
 * 将 Markdown 文本清洗为可朗读的纯文本。
 * 注意（UTS/Android）：调用方必须显式传齐三参，勿依赖默认参数重载（否则 NoSuchMethodError）。
 * @param raw 原始文本
 * @param settings 过滤设置，为空时按默认（过滤代码块/链接URL/emoji）
 * @param trimResult 是否 trim 首尾；增量拼接时应为 false，避免吃掉边界空白语义
 */
export function cleanTextForSpeech(
  raw: string,
  settings: VoiceSettings | null,
  trimResult: boolean,
): string {
  if (raw.length == 0) {
    return "";
  }
  const opts = settings != null ? settings! : new VoiceSettings();
  // 纯诗/纯中文等：跳过十几条正则，只做空白规整（流式高频路径）
  if (looksLikeMarkup(raw) != true) {
    let plain = raw.replace(/[ \t]+/g, " ");
    plain = plain.replace(/\n[ \t]+/g, "\n");
    plain = plain.replace(/\n{3,}/g, "\n\n");
    if (opts.keepEmoji != true) {
      plain = plain.replace(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g, "");
      plain = plain.replace(/[\u2190-\u27BF\u2B00-\u2BFF\uFE0F]/g, "");
    }
    if (trimResult == true) {
      return plain.trim();
    }
    return plain;
  }
  // 先剥离 think / 工具调用等，再做通用 Markdown 清洗
  let text = stripNonSpeakableMarkup(raw);

  // 1. fenced 代码块 ```...```
  if (opts.includeCodeBlocks) {
    // 保留代码内容，仅去掉围栏标记与语言标识
    text = text.replace(/```[a-zA-Z0-9+#-]*/g, "\n");
  } else {
    // 整段移除（含未闭合的流式中间态）
    text = text.replace(/```[\s\S]*?```/g, "\n");
    text = text.replace(/```[\s\S]*$/g, "\n");
  }

  // 2. 行内代码
  if (opts.includeCodeBlocks) {
    text = text.replace(/`([^`]*)`/g, "$1");
  } else {
    text = text.replace(/`[^`\n]*`/g, " ");
  }

  // 3. 图片 ![alt](url)（含流式未闭合，截断到 ![ 前）
  text = stripImagesForSpeech(text);

  // 3.5 数学公式（$$ / \[ \] / \( \) / 行内 $...$；保留 $100 货币）
  text = stripMathForSpeech(text);

  // 4. 链接 [text](url)
  if (opts.includeLinkUrl) {
    text = text.replace(/\[([^\]]*)\]\(([^)]*)\)/g, "$1，$2");
  } else {
    // 只保留链接文字
    text = text.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1");
    // 裸 URL 移除
    text = text.replace(/https?:\/\/[^\s)\]>"]+/g, " ");
  }

  // 5. 剩余普通 HTML 标签仅剥离标签，保留用户可见正文。
  text = text.replace(/<[^>\n]+>/g, " ");

  // 6. 表格：分隔行整行移除；数据行竖线转为停顿
  text = text.replace(/(?:^|\n)[|:\- \t]+-{2,}[|:\- \t]*(?=\n|$)/g, "\n");
  text = text.replace(/\|/g, "，");

  // 7. 标题 / 引用 / 列表标记（模型常输出 ##标题 无空格，不能强制要求空白）
  text = text.replace(/(?:^|\n)#{1,6}(?=[ \t]|$|[^#\s])/g, "\n");
  text = text.replace(/(?:^|\n)[ \t]*>[ \t]?/g, "\n");
  text = text.replace(/(?:^|\n)[ \t]*[-*+][ \t]+/g, "\n");
  text = text.replace(/(?:^|\n)[ \t]*\d+\.[ \t]+/g, "\n");

  // 8. 加粗 / 斜体 / 删除线标记
  text = text.replace(/\*\*([^*]+)\*\*/g, "$1");
  text = text.replace(/\*([^*\n]+)\*/g, "$1");
  text = text.replace(/__([^_]+)__/g, "$1");
  text = text.replace(/~~([^~]+)~~/g, "$1");
  // 流式未闭合的 ** / __ / ~~ 残留，勿朗读（保留单个 * 以免误伤乘号）
  text = text.replace(/\*\*/g, "");
  text = text.replace(/__/g, "");
  text = text.replace(/~~/g, "");

  // 9. emoji
  if (!opts.keepEmoji) {
    // 增补平面 emoji（代理对）
    text = text.replace(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g, "");
    // BMP 符号（箭头、杂项符号、变体选择符等）
    text = text.replace(/[\u2190-\u27BF\u2B00-\u2BFF\uFE0F]/g, "");
  }

  // 10. 空白规整
  text = text.replace(/[ \t]+/g, " ");
  text = text.replace(/\n[ \t]+/g, "\n");
  text = text.replace(/\n{3,}/g, "\n\n");

  if (trimResult == true) {
    return text.trim();
  }
  return text;
}

/**
 * 助手消息 → 工具栏/缓存用可播报纯文本。
 * 与工具栏播报策略一致：不含 think、不含代码块。
 * UTS/Android：cleanTextForSpeech 须显式传齐三参。
 */
export function buildAssistantSpeakableText(raw: string): string {
  if (raw.length == 0) {
    return "";
  }
  const settings = new VoiceSettings();
  settings.includeThinkContent = false;
  settings.includeCodeBlocks = false;
  settings.includeLinkUrl = false;
  settings.keepEmoji = false;
  return cleanTextForSpeech(raw, settings, true);
}

/**
 * 将完整文本切分为可朗读的句子（用于整段播放）
 */
export function extractSpeakableSentences(text: string, maxLength: number = MAX_SENTENCE_LENGTH): string[] {
  const sentences: string[] = [];
  let buffer = "";
  for (let i = 0; i < text.length; i++) {
    const ch = text.charAt(i);
    buffer += ch;
    if (SENTENCE_END_CHARS.indexOf(ch) >= 0 || buffer.length >= maxLength) {
      const sentence = buffer.trim();
      if (sentence.length > 0) {
        sentences.push(sentence);
      }
      buffer = "";
    }
  }
  const tail = buffer.trim();
  if (tail.length > 0) {
    sentences.push(tail);
  }
  return sentences;
}

/**
 * 流式场景：从缓冲区提取"已完结"的句子，未完结部分留作 remainder。
 * @param buffer 待处理文本（通常为上次的 remainder + 本次增量）
 * @param flush 为 true 时（流结束）剩余文本全部作为句子输出
 */
export function drainCompleteSentences(buffer: string, flush: boolean): SentenceDrainResult {
  const result = new SentenceDrainResult();
  let current = "";
  for (let i = 0; i < buffer.length; i++) {
    const ch = buffer.charAt(i);
    current += ch;
    if (SENTENCE_END_CHARS.indexOf(ch) >= 0) {
      const sentence = current.trim();
      if (sentence.length > 0) {
        result.sentences.push(sentence);
      }
      current = "";
    }
  }
  if (flush) {
    // 流结束仍按上限切段，避免整段数百字一次 TTS（首包合成慢 + 播放超时）
    let tail = current.trim();
    while (tail.length > MAX_SENTENCE_LENGTH) {
      let cut = MAX_SENTENCE_LENGTH;
      for (let k = MAX_SENTENCE_LENGTH - 1; k >= MIN_SOFT_DRAIN_CHARS; k--) {
        if (SOFT_BREAK_CHARS.indexOf(tail.charAt(k)) >= 0) {
          cut = k + 1;
          break;
        }
      }
      const piece = tail.substring(0, cut).trim();
      if (piece.length > 0) {
        result.sentences.push(piece);
      }
      tail = tail.substring(cut).trim();
    }
    if (tail.length > 0) {
      result.sentences.push(tail);
    }
    result.remainder = "";
  } else if (current.length >= MAX_SENTENCE_LENGTH) {
    // 超长未完结文本强制切出，避免无限积压
    const sentence = current.trim();
    if (sentence.length > 0) {
      result.sentences.push(sentence);
    }
    result.remainder = "";
  } else {
    // 软切：尽早吐出可读片段，减少「字已出但等句号才播」
    let softCut = -1;
    for (let j = 0; j < current.length; j++) {
      if (SOFT_BREAK_CHARS.indexOf(current.charAt(j)) < 0) {
        continue;
      }
      if (j + 1 >= MIN_SOFT_DRAIN_CHARS) {
        softCut = j;
        break;
      }
    }
    if (softCut >= 0) {
      const head = current.substring(0, softCut + 1).trim();
      if (head.length > 0) {
        result.sentences.push(head);
      }
      result.remainder = current.substring(softCut + 1);
    } else {
      result.remainder = current;
    }
  }
  return result;
}
