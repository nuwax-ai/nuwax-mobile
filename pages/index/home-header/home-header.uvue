<template>
  <view class="home-header" id="home-header-root">
    <!-- 欢迎语 -->
    <view class="welcome">
      <text class="welcome-text">{{ welcomeText }}</text>
    </view>

    <!-- 消息输入框 -->
    <view class="search-box" hover-class="search-box-active" @click="handleInputClick">
      <text class="search-icon">💬</text>
      <text class="search-placeholder">{{ t("Mobile.Home.inputPlaceholder") }}</text>
      <view class="mic-btn">
        <text class="mic-icon">🎤</text>
      </view>
    </view>

    <!-- 官方推荐宫格 -->
    <view class="agent-grid" v-if="recommendList.length > 0">
      <view
        v-for="item in recommendList"
        :key="item.targetId"
        class="agent-card"
        hover-class="agent-card-active"
        @click="handleAgentClick(item)"
      >
        <image
          class="agent-icon"
          :src="getImageSrc(item.targetId, item.icon)"
          mode="aspectFill"
          :alt="item.name"
          @error="handleImageError(item.targetId)"
        />
        <view class="agent-info">
          <text class="agent-name text-ellipsis">{{ item.name }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, watch } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiHomeCategoryList } from "@/servers/agentDev";
  import { CategoryItemInfo } from "@/types/interfaces/agentConfig";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import agentImage from "@/static/assets/agent_image.png";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  interface HomeHeaderProps {
    userInfo: any | null;
    isLoggedIn: boolean;
  }
  const props = defineProps<HomeHeaderProps>();

  const emit = defineEmits<{
    (e: "agent-click", item: CategoryItemInfo): void;
    (e: "input-click"): void;
  }>();

  // 官方推荐列表
  const recommendList = ref<CategoryItemInfo[]>([]);

  // 记录加载失败的图片ID
  const failedImageIds = new Set<number>();

  // 从 props.userInfo 读取昵称（Android：禁 as UserInfo 后点属性，走 JSON 中转）
  const readNameFromUserInfo = (info: any | null): string => {
    if (info == null) {
      return "";
    }
    const jsonStr = JSON.stringify(info);
    if (jsonStr == null || jsonStr.length == 0) {
      return "";
    }
    const parsed = JSON.parse(jsonStr) as UTSJSONObject | null;
    if (parsed == null) {
      return "";
    }
    const nickName = parsed["nickName"];
    if (nickName != null && `${nickName}`.length > 0) {
      return `${nickName}`;
    }
    const userName = parsed["userName"];
    return userName != null ? `${userName}` : "";
  };

  // 欢迎语
  const welcomeText = computed((): string => {
    const name = readNameFromUserInfo(props.userInfo);
    if (name.length == 0) {
      return t("Mobile.Home.welcomeGeneric");
    }
    return t("Mobile.Home.welcomePrefix") + " " + name + "，" + t("Mobile.Home.welcomeSuffix");
  });

  const getImageSrc = (id: number, originalIcon: string): string => {
    return failedImageIds.has(id) ? agentImage : originalIcon;
  };

  const handleImageError = (id: number) => {
    failedImageIds.add(id);
  };

  // 获取官方推荐（GET /api/home/list，取 AGENT_RECOMMEND 分类，与 web 首页官方推荐同接口）
  const fetchRecommendList = async () => {
    const response = await apiHomeCategoryList();
    const code = apiResCode(response);
    if (code != SUCCESS_CODE) {
      return;
    }
    const dataRaw = apiResData<any>(response);
    if (dataRaw == null) {
      return;
    }
    const dataObj = dataRaw as UTSJSONObject;
    const categoryItemsRaw = dataObj["categoryItems"];
    if (categoryItemsRaw == null) {
      return;
    }
    const itemsObj = categoryItemsRaw as UTSJSONObject;
    // Android UTS：取官方推荐分类，key 比较用 ==
    const recommendRaw = itemsObj["AGENT_RECOMMEND"];
    if (recommendRaw == null) {
      return;
    }
    const parsed = JSON.parse<CategoryItemInfo[]>(JSON.stringify(recommendRaw));
    const items = parsed != null ? parsed : ([] as CategoryItemInfo[]);
    // 宫格最多展示 4 个
    recommendList.value = items.slice(0, 4);
  };

  const handleAgentClick = (item: CategoryItemInfo) => {
    emit("agent-click", item);
  };

  const handleInputClick = () => {
    emit("input-click");
  };

  // 登录后加载官方推荐
  watch(
    (): boolean => props.isLoggedIn,
    (loggedIn: boolean) => {
      if (loggedIn) {
        fetchRecommendList();
      } else {
        recommendList.value = [] as CategoryItemInfo[];
      }
    },
    { immediate: true },
  );
</script>

<style lang="scss" scoped>
  .home-header {
    padding: 8rpx 24rpx 0;
  }

  /* 欢迎语 */
  .welcome {
    padding: 24rpx 8rpx 20rpx;

    .welcome-text {
      font-size: 44rpx;
      font-weight: 700;
      color: #1a1a1a;
    }
  }

  /* 消息输入框 */
  .search-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: #ffffff;
    border-radius: 40rpx;
    padding: 20rpx 28rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);

    &-active {
      background-color: #f5f5f5;
    }

    .search-icon {
      font-size: 32rpx;
      margin-right: 16rpx;
    }

    .search-placeholder {
      flex: 1;
      font-size: 28rpx;
      color: #c0c0c0;
    }

    .mic-btn {
      width: 48rpx;
      height: 48rpx;
      border-radius: 50%;
      background-color: #fafafa;
      display: flex;
      align-items: center;
      justify-content: center;

      .mic-icon {
        font-size: 24rpx;
      }
    }
  }

  /* 智能体宫格 */
  .agent-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 8rpx;

    .agent-card {
      width: 48%;
      background-color: #ffffff;
      border-radius: 20rpx;
      padding: 20rpx 24rpx;
      margin-bottom: 16rpx;
      display: flex;
      flex-direction: row;
      align-items: center;
      box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);

      &-active {
        background-color: rgba(12, 20, 102, 0.04);
      }

      .agent-icon {
        width: 56rpx;
        height: 56rpx;
        border-radius: 12rpx;
        margin-right: 16rpx;
        background-color: #f5f5f5;
      }

      .agent-info {
        flex: 1;
        overflow: hidden;

        .agent-name {
          font-size: 28rpx;
          font-weight: 600;
          color: #1a1a1a;
        }
      }
    }
  }
</style>
