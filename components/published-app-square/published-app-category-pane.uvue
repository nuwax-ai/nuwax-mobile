<template>
  <view class="app-category-pane">
    <published-app-agent-item
      v-for="info in agents"
      :key="getRowKey(info)"
      :info="info"
      :enable-subscription="enableSubscription"
      @click="emit('agentClick', info)"
      @collect="emit('collect', info)"
    />
    <view
      v-if="agents.length == 0 && loading != true && refreshing != true"
      class="empty-state"
    >
      <image :src="noData" class="empty-image" :fade-show="false" :alt="t('Mobile.Common.noDataImageAlt')" />
      <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
    </view>
    <view v-if="agents.length == 0 && loading == true" class="loading-state">
      <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
    </view>
    <view
      v-if="loading != true && hasMore != true && agents.length > 6"
      class="no-more-state"
    >
      <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import noData from "@/static/assets/no_data.png";
  import PublishedAppAgentItem from "./published-app-agent-item.uvue";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      agents: UTSJSONObject[];
      loading?: boolean;
      refreshing?: boolean;
      hasMore?: boolean;
      enableSubscription?: number;
    }>(),
    {
      agents: [] as UTSJSONObject[],
      loading: false,
      refreshing: false,
      hasMore: true,
      enableSubscription: 0,
    },
  );

  const emit = defineEmits<{
    agentClick: [info: UTSJSONObject];
    collect: [info: UTSJSONObject];
  }>();

  function getRowKey(info: UTSJSONObject): string {
    const id = info["id"];
    if (id != null) {
      return `id:${id}`;
    }
    const targetId = info["targetId"];
    return targetId != null ? `target:${targetId}` : "";
  }
</script>

<style lang="scss" scoped>
  .app-category-pane {
    width: 100%;
    /* #ifndef APP */
    padding-bottom: 24rpx;
    box-sizing: border-box;
    /* #endif */
  }

  .empty-state,
  .loading-state {
    min-height: 480rpx;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80rpx 0;
    box-sizing: border-box;
  }

  .empty-image {
    width: 172rpx;
    height: 172rpx;
  }

  .empty-text {
    font-size: 28rpx;
    color: #999;
    margin-top: 32rpx;
  }

  .loading-text {
    font-size: 28rpx;
    color: #666;
  }

  .no-more-state {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40rpx;
  }

  .no-more-text {
    font-size: 24rpx;
    color: #999;
  }
</style>
