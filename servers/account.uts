import request from "./useRequest";
import { RequestResponse, VoidRequestResponse } from "../types/interfaces/request";
import type {
  BindEmailParams,
  CodeLogin,
  ILoginResult,
  LoginFieldType,
  ResetPasswordParams,
  SendCode,
  SetPasswordParams,
  TenantConfigInfo,
  UserInfo,
  UserUpdateParams,
  WechatLoginParams,
} from "@/types/interfaces/login";

// 租户配置信息查询接口
export async function apiTenantConfig(): Promise<RequestResponse<TenantConfigInfo>> {
  return apiTenantConfigWithUrl(null);
}

// 租户配置信息查询接口（支持指定 baseUrl）
export async function apiTenantConfigWithUrl(baseUrl: string | null): Promise<RequestResponse<TenantConfigInfo>> {
  const res = await request({
    url: "/api/tenant/config",
    method: "GET",
    baseUrl,
    skipAuth: baseUrl != null,
  });
  return res;
}

// 查询当前登录用户信息
export async function apiUserInfo(): Promise<RequestResponse<UserInfo>> {
  const res = await request({
    url: "/api/user/getLoginInfo",
    method: "GET",
  });
  return res;
}

// 更新当前登录用户信息（头像、用户名、昵称等）。
// Android 端请求体必须使用 UTSJSONObject，避免 interface 序列化后字段丢失。
export async function apiUserUpdate(data: UTSJSONObject): Promise<VoidRequestResponse> {
  const res = await request({
    url: "/api/user/update",
    method: "POST",
    data,
  });
  return res;
}

// 微信登录
export async function apiWechatLogin(data: WechatLoginParams): Promise<RequestResponse<ILoginResult>> {
  const res = await request({
    url: "/api/user/mp/codeLogin",
    method: "POST",
    data,
  });
  return res;
}

/**
 * 构建密码登录请求体。
 * Android 上 LoginFieldType 等 UTS class 经 JSON.stringify 后字段可能丢失，
 * 后端收不到 emailOrPhone/phoneOrEmail；显式 UTSJSONObject 保证各端一致。
 */
function buildPasswordLoginBody(data: LoginFieldType): UTSJSONObject {
  const phoneOrEmailVal = data.phoneOrEmail;
  const body = new UTSJSONObject();
  body["phoneOrEmail"] = phoneOrEmailVal;
  body["emailOrPhone"] = phoneOrEmailVal;
  body["areaCode"] = data.areaCode;
  const passwordVal = data.password;
  body["password"] = passwordVal != null ? passwordVal : "";
  const captchaVal = data.captchaVerifyParam;
  body["captchaVerifyParam"] = captchaVal != null ? captchaVal : "";
  return body;
}

// 账号密码登录
export async function apiLogin(data: LoginFieldType): Promise<RequestResponse<ILoginResult>> {
  const res = await request({
    url: "/api/user/passwordLogin",
    method: "POST",
    data: buildPasswordLoginBody(data),
  });
  return res;
}

/**
 * 构建发送验证码请求体。
 * Android：UTS class 直接作 data 时 type 等字段序列化后可能丢失（后端报 type is null），
 * 须显式写入 UTSJSONObject。
 */
function buildSendCodeBody(data: SendCode): UTSJSONObject {
  const body = new UTSJSONObject();
  body["type"] = data.type;
  const captchaVal = data.captchaVerifyParam;
  body["captchaVerifyParam"] = captchaVal != null ? captchaVal : "";
  const phoneVal = data.phone;
  if (phoneVal != null && phoneVal.length > 0) {
    body["phone"] = phoneVal;
  }
  const emailVal = data.email;
  if (emailVal != null && emailVal.length > 0) {
    body["email"] = emailVal;
  }
  const ticketVal = data.ticket;
  if (ticketVal != null && ticketVal.length > 0) {
    body["ticket"] = ticketVal;
  }
  return body;
}

function buildCodeLoginBody(data: CodeLogin): UTSJSONObject {
  const body = new UTSJSONObject();
  if (data.phone.length > 0) body["phone"] = data.phone;
  if (data.email.length > 0) body["email"] = data.email;
  body["phoneOrEmail"] = data.phoneOrEmail;
  body["code"] = data.code;
  body["captchaVerifyParam"] = data.captchaVerifyParam;
  return body;
}

// 发送验证码
export async function apiSendCode(data: SendCode): Promise<VoidRequestResponse> {
  const res = await request({
    url: "/api/user/code/send",
    method: "POST",
    data: buildSendCodeBody(data),
  });
  return res;
}

// 验证码登录/注册接口
export async function apiLoginCode(data: CodeLogin): Promise<RequestResponse<ILoginResult>> {
  const res = await request({
    url: "/api/user/codeLogin",
    method: "POST",
    data: buildCodeLoginBody(data),
  });
  return res;
}

