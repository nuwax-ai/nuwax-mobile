<template>
  <view class="recent-app-icon" :style="wrapStyle">
    <image
      v-if="src.length > 0"
      class="recent-app-icon__img"
      :src="src"
      mode="aspectFill"
      :fade-show="false"
      :alt="altText"
      @error="handleImageError"
    />
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, watch } from "vue";
  import { resolveDisplayImageUrl } from "@/utils/remoteSvgImage";
  import defaultAgentIcon from "@/static/assets/agent_image.png";

  const props = withDefaults(
    defineProps<{
      info: UTSJSONObject;
      size?: number;
      iconRadius?: number;
    }>(),
    {
      size: 112,
      iconRadius: 28,
    },
  );

  const src = ref<string>("");
  const rawIcon = ref<string>("");
  let resolveSeq = 0;

  const wrapStyle = computed((): string => {
    return `width:${props.size}rpx;height:${props.size}rpx;border-radius:${props.iconRadius}rpx;`;
  });

  function readIcon(): string {
    const info = props.info as UTSJSONObject;
    const raw = info["icon"];
    return raw != null ? `${raw}` : "";
  }

  const altText = computed((): string => {
    const info = props.info as UTSJSONObject;
    const raw = info["name"];
    return raw != null ? `${raw}` : "";
  });

  function showDefaultIcon(): void {
    src.value = defaultAgentIcon;
  }

  function applyIcon(): void {
    const icon = readIcon();
    rawIcon.value = icon;
    src.value = "";
    if (icon.length == 0) {
      showDefaultIcon();
      return;
    }
    const seq = ++resolveSeq;
    resolveDisplayImageUrl(icon, props.size, props.size).then((resolved: string) => {
      if (seq != resolveSeq) {
        return;
      }
      src.value = resolved.length > 0 ? resolved : defaultAgentIcon;
    }, (_err: any | null) => {
      if (seq != resolveSeq) {
        return;
      }
      showDefaultIcon();
    });
  }

  applyIcon();

  watch(
    (): string => readIcon(),
    (): void => {
      applyIcon();
    },
  );

  /**
   * data URL 失败先回退原地址；原地址仍失败再显示默认图标（避免只剩灰底）。
   */
  function handleImageError(): void {
    const current = src.value;
    if (current.length == 0 || current == defaultAgentIcon) {
      return;
    }
    const origin = rawIcon.value;
    if (origin.length > 0 && current != origin && current.indexOf("data:") == 0) {
      src.value = origin;
      return;
    }
    showDefaultIcon();
  }
</script>

<style scoped lang="scss">
  .recent-app-icon {
    flex-shrink: 0;
    overflow: hidden;
    background-color: #f5f5f7;

    &__img {
      width: 100%;
      height: 100%;
    }
  }
</style>
