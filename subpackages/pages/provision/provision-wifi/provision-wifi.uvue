<template>
  <view class="provision-wifi">
    <custom-nav-bar :title="t('Mobile.Provision.Wifi.title')" :show-back="true" :has-safety-zone="true" />

    <view class="provision-wifi__body">
      <!-- 目标设备 -->
      <view v-if="deviceName != ''" class="provision-wifi__device">
        <text class="provision-wifi__device-name">{{ deviceName }}</text>
      </view>

      <!-- 表单 -->
      <view class="form">
        <view class="form__field">
          <text class="form__label">{{ t('Mobile.Provision.Wifi.ssidLabel') }}</text>
          <input
            class="form__input"
            v-model="ssid"
            :placeholder="t('Mobile.Provision.Wifi.ssidPlaceholder')"
            placeholder-class="form__placeholder"
          />
        </view>

        <view class="form__field">
          <text class="form__label">{{ t('Mobile.Provision.Wifi.passwordLabel') }}</text>
          <view class="form__pwd">
            <input
              class="form__input form__input--pwd"
              v-model="password"
              :password="!showPassword"
              :placeholder="t('Mobile.Provision.Wifi.passwordPlaceholder')"
              placeholder-class="form__placeholder"
            />
            <text class="form__eye" @tap="showPassword = !showPassword">{{ showPassword ? '🙈' : '👁' }}</text>
          </view>
        </view>

        <!-- 使用当前 WiFi -->
        <view class="form__current" @tap="useCurrentWifi">
          <text class="form__current-text">{{ t('Mobile.Provision.Wifi.useCurrent') }}</text>
        </view>

        <text v-if="currentFailed" class="form__warn">{{ t('Mobile.Provision.Wifi.currentFailed') }}</text>
        <text class="form__band-tip">{{ t('Mobile.Provision.Wifi.bandTip') }}</text>
        <text v-if="errorTip != ''" class="form__error">{{ errorTip }}</text>
      </view>

      <!-- 开始配网 -->
      <view class="provision-wifi__footer">
        <view class="provision-wifi__start" :class="{ 'provision-wifi__start--disabled': !canStart }" @tap="startProvision">
          <text class="provision-wifi__start-text">{{ t('Mobile.Provision.Wifi.start') }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { ref, computed } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { useI18n } from "@/utils/i18n";
  import { getProvisionDevice, setProvisionCredentials } from "@/utils/provisionSession";
  import { getCurrentWifiSsid } from "@/utils/wifiInfo";
  import { validateSsid, validatePassword } from "@/utils/provisionProtocol";

  const { t } = useI18n();

  const ssid = ref<string>("");
  const password = ref<string>("");
  const showPassword = ref<boolean>(false);
  const currentFailed = ref<boolean>(false);
  const errorTip = ref<string>("");
  const deviceName = ref<string>("");

  const canStart = computed((): boolean => {
    return ssid.value.trim().length > 0;
  });

  const useCurrentWifi = async () => {
    currentFailed.value = false;
    const current = await getCurrentWifiSsid();
    if (current != "") {
      ssid.value = current;
    } else {
      currentFailed.value = true;
    }
  };

  const startProvision = () => {
    errorTip.value = "";
    const s = ssid.value.trim();
    if (!validateSsid(s)) {
      errorTip.value = t("Mobile.Provision.Wifi.ssidInvalid");
      return;
    }
    if (!validatePassword(password.value)) {
      errorTip.value = t("Mobile.Provision.Wifi.passwordInvalid");
      return;
    }
    // 凭据经内存态传递（不走 URL query）
    setProvisionCredentials({ ssid: s, password: password.value });
    uni.navigateTo({ url: "/subpackages/pages/provision/provision-progress/provision-progress" });
  };

  onLoad(() => {
    const device = getProvisionDevice();
    deviceName.value = device != null && device.name != "" ? device.name : (device != null ? device.deviceId : "");
    // 进入自动尝试填当前 WiFi
    useCurrentWifi();
  });
</script>

<style lang="scss" scoped>
  .provision-wifi {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;

    &__body {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 32rpx;
    }

    &__device {
      margin-bottom: 24rpx;
    }

    &__device-name {
      font-size: 26rpx;
      color: #999;
    }

    &__footer {
      padding: 32rpx 0;
    }

    &__start {
      background-color: #5147ff;
      border-radius: 48rpx;
      padding: 28rpx 0;
      display: flex;
      align-items: center;
      justify-content: center;

      &--disabled {
        opacity: 0.4;
      }
    }

    &__start-text {
      color: #ffffff;
      font-size: 32rpx;
      font-weight: 500;
    }
  }

  .form {
    background-color: #ffffff;
    border-radius: 20rpx;
    padding: 32rpx;

    &__field {
      margin-bottom: 32rpx;
    }

    &__label {
      font-size: 26rpx;
      color: #999;
      margin-bottom: 16rpx;
      display: block;
    }

    &__input {
      font-size: 32rpx;
      color: #333;
      height: 72rpx;
      border-bottom: 1rpx solid #eee;

      &--pwd {
        flex: 1;
        border-bottom: none;
      }
    }

    &__placeholder {
      color: #c0c0c0;
      font-size: 32rpx;
    }

    &__pwd {
      display: flex;
      flex-direction: row;
      align-items: center;
      border-bottom: 1rpx solid #eee;
      height: 72rpx;
    }

    &__eye {
      font-size: 32rpx;
      padding: 0 8rpx;
    }

    &__current {
      margin-top: 8rpx;
    }

    &__current-text {
      font-size: 26rpx;
      color: #5147ff;
    }

    &__warn {
      font-size: 24rpx;
      color: #f0ad4e;
      margin-top: 16rpx;
      display: block;
    }

    &__band-tip {
      font-size: 24rpx;
      color: #999;
      margin-top: 24rpx;
      display: block;
      line-height: 1.5;
    }

    &__error {
      font-size: 26rpx;
      color: #dd524d;
      margin-top: 16rpx;
      display: block;
    }
  }
</style>
