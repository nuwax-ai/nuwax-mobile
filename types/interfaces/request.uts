// uni-app x: SDK 严格反序列化要求所有【声明】字段必须存在（无视 `?` 可选标记）。
// 实测后端响应恒为 {code, displayCode, message, data, tid, success} 六字段——
// 从无 debugInfo。故移除 debugInfo（否则缺该字段即 errCode=100003）。
// data 保留强类型 T 以免全库 res.data.xxx 访问级联；错误响应 data:null 会 100003→
// reject(属鉴权失败，需先登录)，成功响应 data 为 T 结构正常反序列化。
export interface RequestResponse<T = any> {
  code: string;
  data: T;
  message: string;
  displayCode: string;
  success: boolean;
  tid: string;
}

/** HTTP 请求配置（供 useRequest 使用，避免 UTSJSONObject 导致类型推断失败） */
export interface RequestOptions {
  url: string;
  method?: string;
  data?: any;
  timeout?: number | null;
}

// 排序字段信息,可空,一般没有默认为创建时间排序
export interface Sort {

  column: string;
  asc: boolean;
}

// 分页响应数据
export interface Page<T> {
  records: T[];
  total: number;
  size: number;
  current: number;
  pages: number;
  orders: Sort[];
  optimizeCountSql: boolean;
  searchCount: boolean;
  optimizeJoinOfCountSql: boolean;
  maxLimit: number;
  countId: string;
}

// 表格列扩展配置
export interface TableExtInfo {

  // 列固定位置
  fixed: string;
  // 是否可见
  visible: boolean;
  // 子标签
  subLabel: string;
  // 列宽度
  width: string;
  // 最小宽度
  minWidth: string;
  // 是否可设置
  settable: boolean;
  // 对齐方式
  align: string;
  // 格式化器
  formatter: string;
  // 提示信息
  tips: string;
  // 是否省略
  ellipsis: boolean;
}

// 表格列信息
export interface SuperTableColumn {

  // 序号
  serialNumber: number;
  // 列标签
  label: string;
  // 列名称
  name: string;
  // 是否可排序
  sortable: boolean;
  // 提示信息
  tips: string;
  // 扩展配置
  ext: TableExtInfo;
}

/** 表格列筛选条件 */
export interface TablePageFilter {
  column: string;
  operator: string;
  value: object;
}

/** 表格分页请求列信息 */
export interface TablePageColumn {
  serialNumber: number;
  label: string;
  name: string;
  sortable: boolean;
  tips: string;
  ext: TableExtInfo;
  children: SuperTableColumn[];
}

// table分页请求基础信息
export interface TablePageRequest<T> {
  queryFilter: T;
  // 当前页,示例值(1)
  current: number;
  // 分页pageSize,示例值(10)
  pageSize: number;
  // 排序字段信息,可空,一般没有默认为创建时间排序
  orders: Sort[];
  // 列的筛选条件,可空
  filters: TablePageFilter[];
  // 表格的列信息,可空
  columns: TablePageColumn[];
}
