/**
 * 项目 tab 接口响应 → 抽屉视图模型映射（纯函数，供单测与抽屉组件复用）。
 *
 * 对齐 PC ProjectPanel 的数据结构：项目行（分组头）+ 项目下会话（子项）。
 * 字段全部可选容错：后端字段缺失时兜底，不抛错。
 * 时间文案由调用方注入 formatter（依赖 i18n 的 formatTimeAgo 留在组件层，
 * 本模块保持无 uni/i18n 依赖以便 node 单测）。
 */

/** 项目下会话（子项）视图模型 */
export class ProjectChildView {
  /** 会话 id */
  id: number = 0;
  /** 所属智能体 id（跳会话用，可能缺失 → 0） */
  agentId: number = 0;
  name: string = "";
  timeLabel: string = "";
  /** 会话任务状态：EXECUTING / FAILED / COMPLETE...（空串 = 无） */
  taskStatus: string = "";
  pinned: boolean = false;
}

/** 项目（分组）视图模型 */
export class ProjectGroupView {
  id: number = 0;
  name: string = "";
  /** NormalProject / PageApp / UserApp（决定改名/删除路由） */
  projectType: string = "";
  expanded: boolean = true;
  children: ProjectChildView[] = [] as ProjectChildView[];
  /** 子会话是否已懒加载过（统一列表接口不回 conversations，展开时经懒加载接口补拉） */
  childrenLoaded: boolean = false;
  /** 服务端标记（2026-09-13 列表回读打标；PageApp 契约未覆盖时本地兜底） */
  pinned: boolean = false;
  archived: boolean = false;
  collected: boolean = false;
  /** 项目图标（上框 chip 展示；回包缺失为空） */
  icon: string = "";
  /** 项目沙箱 ID（上框会话创建优先携带；云端项目为 -1，缺失也置 -1 勿按 0） */
  sandboxId: number = -1;
  /** 项目绑定的调试智能体 ID（全栈上框默认命中用；回包缺失为 0 走类型兜底/手选） */
  devAgentId: number = 0;
  /** 当前用户是否项目创建者（2026-09-20 契约：回包缺失=不标团队；严格 === false 才算参与者/标团队） */
  owner: boolean = true;
}

function toNum(v: any | null, fallback: number = 0): number {
  if (v == null) {
    return fallback;
  }
  const parsed = parseFloat(`${v}`);
  // parsed != parsed 判 NaN
  return parsed != parsed ? fallback : parsed;
}

function toStr(v: any | null, fallback: string = ""): string {
  if (v == null) {
    return fallback;
  }
  return `${v}`;
}

/** 项目类型 → 类型标签 i18n key（未知类型返回空串 = 不展示标签） */
export function projectTypeLabelKey(projectType: string): string {
  if (projectType == "NormalProject") return "Mobile.Project.typeNormal";
  if (projectType == "PageApp") return "Mobile.Project.typePageApp";
  if (projectType == "UserApp") return "Mobile.Project.typeUserApp";
  return "";
}

/** 解析单个项目下会话（conversations 数组项） */
function mapProjectChild(raw: UTSJSONObject, formatTime: (s: string) => string): ProjectChildView {
  const child = new ProjectChildView();
  child.id = toNum(raw["id"], 0);
  child.agentId = toNum(raw["agentId"], 0);
  const topic = toStr(raw["topic"], "");
  child.name = topic;
  const modified = toStr(raw["modified"], "");
  child.timeLabel = modified.length > 0 ? formatTime(modified) : "";
  child.taskStatus = toStr(raw["taskStatus"], "");
  return child;
}

/** 解析单个项目行（records 数组项）。2026-09-14 统一接口不回 conversations，children 经懒加载填充。 */
function mapProjectGroup(raw: UTSJSONObject, formatTime: (s: string) => string): ProjectGroupView {
  const group = new ProjectGroupView();
  // 统一接口主键字段名为 projectId（对齐 PC UserProjectTabItem）
  group.id = toNum(raw["projectId"], toNum(raw["id"], 0));
  group.name = toStr(raw["name"], "");
  group.projectType = toStr(raw["projectType"], "");
  // 服务端标记回读打标（2026-09-13 起回包；字段缺失 = false）
  group.pinned = raw["pinned"] == true;
  group.archived = raw["archived"] == true;
  group.collected = raw["collected"] == true;
  // 上框链路字段（对齐 PC PinnedProjectInfo；回包缺失时 icon=""、sandboxId=-1、devAgentId=0）
  group.icon = toStr(raw["icon"], "");
  group.sandboxId = toNum(raw["sandboxId"], -1);
  group.devAgentId = toNum(raw["devAgentId"], 0);
  // owner 严格判定（对齐 PC：=== false 才算参与者标团队；undefined=未回包不标）
  group.owner = raw["owner"] != null ? raw["owner"] == true : true;
  return group;
}

/**
 * 懒加载：项目会话列表响应（ConversationInfo[]）→ 子项视图列表。
 * 兼容数组 / {data:[...]} 两种入参；行内字段容错。
 */
export function mapProjectChildren(
  raw: any | null,
  formatTime: (s: string) => string,
): ProjectChildView[] {
  const children: ProjectChildView[] = [] as ProjectChildView[];
  let items: any[] | null = null;
  if (raw != null && Array.isArray(raw)) {
    items = raw as any[];
  } else if (raw != null) {
    try {
      const jsonStr = JSON.stringify(raw);
      if (jsonStr != null && jsonStr.length > 0) {
        const parsed = JSON.parse(jsonStr);
        if (Array.isArray(parsed)) {
          items = parsed as any[];
        }
      }
    } catch (_e) {
      return children;
    }
  }
  if (items == null) {
    return children;
  }
  for (let i = 0; i < items.length; i++) {
    const item = items[i];
    if (item == null) continue;
    children.push(mapProjectChild(item as UTSJSONObject, formatTime));
  }
  return children;
}

/**
 * tab/page-query 响应 data（{ records: [...] }）→ 分组视图列表。
 * data 为空/结构不符时返回空数组。
 */
export function mapProjectTabResponse(
  data: any | null,
  formatTime: (s: string) => string,
): ProjectGroupView[] {
  const groups: ProjectGroupView[] = [] as ProjectGroupView[];
  if (data == null) {
    return groups;
  }
  let records: any[] | null = null;
  if (data instanceof UTSJSONObject) {
    const raw = (data as UTSJSONObject)["records"];
    if (raw != null && Array.isArray(raw)) {
      records = raw as any[];
    }
  } else if (typeof data == "object") {
    // H5 下响应可能是普通对象
    const obj = data as Record<string, any>;
    const raw = obj["records"];
    if (raw != null && Array.isArray(raw)) {
      records = raw as any[];
    }
  }
  if (records == null) {
    return groups;
  }
  for (let i = 0; i < records.length; i++) {
    const item = records[i];
    if (item == null) continue;
    groups.push(mapProjectGroup(item as UTSJSONObject, formatTime));
  }
  return groups;
}

// ============================================================
// 项目列表分页（对齐 PC ProjectList/projectHistoryRows 2026-09-20）：
// pageSize=20 页码分页 + 前端过滤追拉（归档项前端过滤后可见行不足时
// 继续翻页）+ 触底加载 + 按 id 去重追加（后端页间偶发重复行）。
// ============================================================

/** 单页拉取条数（对齐 PC PROJECT_PAGE_SIZE） */
export const PROJECT_PAGE_SIZE = 20;
/** 刷新时最少可见行数（对齐 PC MIN_VISIBLE_BATCH：追拉到非归档行够一屏） */
export const MIN_VISIBLE_PROJECTS = 10;
/** 单次刷新最多连续追拉页数（对齐 PC MAX_CHASE_PAGES，防稀疏数据打爆接口） */
export const MAX_PROJECT_CHASE_PAGES = 5;

/**
 * 是否还有下一页（对齐 PC computeHasMore）：
 * 回包 pages 回读优先（fetchedPage < pages），未回读时退「满页视为还有」。
 */
export function computeProjectHasMore(
  fetchedPage: number,
  totalPages: number,
  lastRecordCount: number,
  requestedSize: number,
): boolean {
  if (totalPages > 0) {
    return fetchedPage < totalPages;
  }
  return lastRecordCount >= requestedSize;
}

/** 前端过滤后可见行不足最小展示量时是否继续追拉下一页（对齐 PC needsChase）。 */
export function needsProjectChase(
  visibleCount: number,
  minVisible: number,
  fetchedPage: number,
  totalPages: number,
  lastRecordCount: number,
  requestedSize: number,
): boolean {
  if (visibleCount >= minVisible) {
    return false;
  }
  return computeProjectHasMore(fetchedPage, totalPages, lastRecordCount, requestedSize);
}

/** 追加项目页按 id 去重（对齐 PC appendProjectRowsDedup：同 id 保留先到）。 */
export function appendProjectGroupsDedup(
  base: ProjectGroupView[],
  incoming: ProjectGroupView[],
): ProjectGroupView[] {
  const merged: ProjectGroupView[] = [] as ProjectGroupView[];
  for (let i = 0; i < base.length; i++) {
    merged.push(base[i]);
  }
  for (let i = 0; i < incoming.length; i++) {
    const item = incoming[i];
    if (item == null) continue;
    let dup = false;
    for (let j = 0; j < merged.length; j++) {
      if (merged[j].id == item.id) {
        dup = true;
        break;
      }
    }
    if (!dup) {
      merged.push(item);
    }
  }
  return merged;
}

/**
 * 服务端最新项目范围与当前视图对账：
 * - 顺序、名称和服务端标记以 incoming 为准；
 * - 同 id 保留当前展开态、已加载子会话，避免抽屉打开/后台更新时整屏回弹；
 * - incoming 已覆盖调用方本次查询的全部页，因此不存在的旧行会被移除。
 */
export function reconcileProjectGroups(
  current: ProjectGroupView[],
  incoming: ProjectGroupView[],
): ProjectGroupView[] {
  const reconciled: ProjectGroupView[] = [] as ProjectGroupView[];
  for (let i = 0; i < incoming.length; i++) {
    const fresh = incoming[i];
    if (fresh == null) continue;
    let existing: ProjectGroupView | null = null;
    for (let j = 0; j < current.length; j++) {
      if (current[j].id == fresh.id) {
        existing = current[j];
        break;
      }
    }
    if (existing != null) {
      fresh.expanded = existing.expanded;
      fresh.childrenLoaded = existing.childrenLoaded;
      fresh.children = existing.children;
    } else {
      // 后台更新发现的新项目默认收起，避免打开抽屉时内容高度突跳。
      fresh.expanded = false;
    }
    reconciled.push(fresh);
  }
  return reconciled;
}

/** 解析回包 pages 总页数（0=未回读，退满页判定；兼容 UTSJSONObject/普通对象）。 */
export function mapProjectTotalPages(data: any | null): number {
  if (data == null) return 0;
  if (data instanceof UTSJSONObject) {
    const raw = (data as UTSJSONObject)["pages"];
    if (raw != null) {
      const parsed = parseFloat(`${raw}`);
      if (parsed != parsed) return 0;
      return parsed as number;
    }
    return 0;
  }
  if (typeof data == "object") {
    const obj = data as Record<string, any>;
    const raw = obj["pages"];
    if (raw != null) {
      const parsed = parseFloat(`${raw}`);
      if (parsed != parsed) return 0;
      return parsed as number;
    }
  }
  return 0;
}
