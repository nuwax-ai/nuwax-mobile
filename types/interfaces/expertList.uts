/** 数据视图类型；search 使用全局搜索口径（spaceId=-1）。 */
export type ExpertListSourceType = "used" | "system" | "team" | "convenient" | "search";

/** default 对齐 PC list；simple 对齐 PC list + simple。 */
export type ExpertListVariant = "default" | "simple";

/** ExpertListView 对外统一条目；各接口响应在组件内部归一化。 */
export class ExpertListItem {
  key: string = "";
  rawId: number = 0;
  targetId: number = 0;
  name: string = "";
  description: string = "";
  icon: string = "";
  paymentRequired: boolean = false;
  subscribed: boolean = false;
  usedTime: string = "";
  userCount: number = 0;
}
