import { getImSessionStamp } from "./imSessionScope";
/**
 * 联系人展示名索引（userId → displayName）模块级缓存（App 进程内，页面销毁不丢）。
 *
 * 用途：单聊会话行标题按「备注 > 昵称 > 账号」展示——/conversations 的 peerName
 * 只回对方资料昵称、不含我方备注，不覆写的话改完备注返回消息列表仍是旧名
 * （displayConvName 唯一读方，口径见 im-row-helpers）。
 *
 * 写入口两处：① 智联录 loadContacts 成功后的整表替换（applyCachedContactNames，
 * 调用方先判「确有变化」，值没变不要调——会白白 bump 版本号）；② 资料页
 * im-user-info 改/清完备注后的单条覆写（setCachedContactName，displayName 为
 * 服务端按 备注>昵称>账号 重算后的值；清备注传新昵称而非空串）。
 *
 * 版本号：任何一次「实际变化」自增。消息列表页隐藏前后各记一次，回页不一致就
 * 重建会话行——displayConvName 读模块级状态，conv-row-item 按 conv 对象身份跳过
 * 重渲染，索引变了但行身份没换的话标题不会重求值（Android 方法绑定同因）。
 *
 * 失效：随 IM 会话戳（token/origin/epoch 变化即换账号或登出）自动清空，与
 * contactRemarkCache / myInfoCache 同款机制——不会串账号。版本号单调不减（清空
 * 也不回绕）：跨页快照最多「多重建一次」，不会漏。
 */
let cached: Map<string, string> | null = null;
let cacheSession = "";
let revision = 0;

function ensureCacheSession(): void {
  if (cacheSession != getImSessionStamp()) {
    cached = null;
    cacheSession = getImSessionStamp();
  }
}

/** 会话失效校验（写入口内部已调；整表重建的比对前也调一次，避免拿上一个账号的
 *  索引做 diff）。★读路径 getCachedContactNames 刻意不调：渲染热路径每行一次，
 *  getImSessionStamp 要读两次 storage，且瞬时读失败会误清索引把单聊标题打回昵称。 */
export function ensureContactNameSession(): void {
  ensureCacheSession();
}

/** 取索引（共享引用，只读；未缓存/已失效返回 null）。不做会话戳校验，见上。 */
export function getCachedContactNames(): Map<string, string> | null {
  return cached;
}

/** 整表替换（调用方已判定确有变化）+ bump 版本号。 */
export function applyCachedContactNames(next: Map<string, string>): void {
  ensureCacheSession();
  cached = next;
  revision += 1;
}

/** 单条覆写：值与现有相同不写也不 bump；空值=摘除该条（回落会话自带 peerName）。 */
export function setCachedContactName(userId: string, displayName: string): void {
  if (userId.length == 0) {
    return;
  }
  ensureCacheSession();
  const existing = cached;
  if (existing != null) {
    if (displayName.length == 0) {
      if (existing.has(userId)) {
        existing.delete(userId);
        revision += 1;
      }
      return;
    }
    if (existing.get(userId) == displayName) {
      return;
    }
    existing.set(userId, displayName);
    revision += 1;
    return;
  }
  if (displayName.length == 0) {
    return;
  }
  const fresh = new Map<string, string>();
  fresh.set(userId, displayName);
  cached = fresh;
  revision += 1;
}

/** 索引内容版本号（读方：message-content 回页判断会话行标题是否需要重渲）。 */
export function contactNameCacheRevision(): number {
  return revision;
}
