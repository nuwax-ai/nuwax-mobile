/**
 * 扫一扫结果三路分发判定（纯函数、无 UI）：
 * - user：自家域名的用户名片码 —— https://{API域名}[/m]/u/{纯数字 userId}。
 *   host 必须与 getApiBaseUrl() 一致才认（防外部任意 /u/ 链接伪造加好友弹窗）；
 *   /m 为 H5 部署路径前缀，用户名片页将来落在 {domain}/m/u/{id}。
 * - url：其余 http(s) 链接（打开前由 UI 层做域名确认）
 * - text：所有其他内容原样展示
 */

import { getApiBaseUrl } from "@/constants/config";

/** 扫码内容的分发判定结果（kind: "user" | "url" | "text"，纯字符串避免枚举串化分歧）。 */
export class ScanRoute {
  kind: string = "text";
  /** url 路由：完整链接（保持原文，不做编码/解码） */
  url: string = "";
  /** user 路由：目标 userId（字符串化雪花号；纯数字，apiImAddContact 按数字字面量拼 JSON） */
  userId: string = "";
  /** text 路由：trim 后原文 */
  text: string = "";
}

/** 是否 http(s) 链接（前缀大小写不敏感）。 */
export function isHttpUrl(raw: string): boolean {
  const lower = raw.toLowerCase();
  return lower.indexOf("http://") == 0 || lower.indexOf("https://") == 0;
}

/** 提取小写 host（scheme:// 之后到首个 / ? # 之前）；无法解析返回空串。 */
export function extractUrlHost(url: string): string {
  const lower = url.toLowerCase();
  // UTS：String.length 推导 Int，indexOf 返回 Number——统一显式 number 防混型赋值报错
  const len: number = url.length;
  let start: number = -1;
  if (lower.indexOf("https://") == 0) {
    start = 8;
  } else if (lower.indexOf("http://") == 0) {
    start = 7;
  }
  if (start < 0 || len <= start) {
    return "";
  }
  let end: number = len;
  const slashAt = url.indexOf("/", start);
  if (slashAt >= 0 && slashAt < end) {
    end = slashAt;
  }
  const queryAt = url.indexOf("?", start);
  if (queryAt >= 0 && queryAt < end) {
    end = queryAt;
  }
  const hashAt = url.indexOf("#", start);
  if (hashAt >= 0 && hashAt < end) {
    end = hashAt;
  }
  if (end <= start) {
    return "";
  }
  return url.substring(start, end).toLowerCase();
}

/** 纯数字判定（雪花 userId 字符串；apiImAddContact 按数字字面量拼 JSON，必须全数字）。 */
function isAllDigits(raw: string): boolean {
  if (raw.length == 0) {
    return false;
  }
  for (let i = 0; i < raw.length; i++) {
    const c = raw.charAt(i);
    if (c < "0" || c > "9") {
      return false;
    }
  }
  return true;
}

/**
 * 用户名片码匹配：host 与 API 域名一致，路径（忽略 /m 前缀与尾斜杠）形如 /u/{纯数字}。
 * 命中返回 userId，否则返回空串。API 域名未配置（如 H5 同源生产）时不命中——
 * 宁可按普通链接打开，不做无域名校验的加好友。
 */
export function matchUserCardUrl(url: string): string {
  const apiHost = extractUrlHost(getApiBaseUrl());
  if (apiHost.length == 0) {
    return "";
  }
  if (extractUrlHost(url) != apiHost) {
    return "";
  }
  // 取 path：host 结束（首个 / ? #）到 ? / # 之前
  const lower = url.toLowerCase();
  const schemeEnd: number = lower.indexOf("://") + 3;
  let pathStart: number = schemeEnd;
  const len: number = url.length;
  while (pathStart < len) {
    const c = url.charAt(pathStart);
    if (c == "/" || c == "?" || c == "#") {
      break;
    }
    pathStart++;
  }
  let pathEnd: number = len;
  const queryAt = url.indexOf("?", pathStart);
  if (queryAt >= 0 && queryAt < pathEnd) {
    pathEnd = queryAt;
  }
  const hashAt = url.indexOf("#", pathStart);
  if (hashAt >= 0 && hashAt < pathEnd) {
    pathEnd = hashAt;
  }
  let path = url.substring(pathStart, pathEnd);
  if (path.length == 0) {
    path = "/";
  }
  while (path.length > 1 && path.charAt(path.length - 1) == "/") {
    path = path.substring(0, path.length - 1);
  }
  // 忽略 H5 部署前缀 /m（严格匹配 /m 或 /m/ 开头，不影响 /mu/ 这类路径）
  if (path == "/m" || path.indexOf("/m/") == 0) {
    path = path.substring(2);
  }
  if (path.indexOf("/u/") != 0) {
    return "";
  }
  const userId = path.substring(3);
  return isAllDigits(userId) ? userId : "";
}

/** 扫码原文 → 三路分发（trim 后判定）。 */
export function parseScanContent(raw: string): ScanRoute {
  const route = new ScanRoute();
  const trimmed = raw.trim();
  if (isHttpUrl(trimmed)) {
    const userId = matchUserCardUrl(trimmed);
    if (userId.length > 0) {
      route.kind = "user";
      route.userId = userId;
      return route;
    }
    route.kind = "url";
    route.url = trimmed;
    return route;
  }
  route.kind = "text";
  route.text = trimmed;
  return route;
}
