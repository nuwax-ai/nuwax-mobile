<template>
  <view class="test-page">
    <custom-nav-bar
      :title="t('Mobile.Intervention.Test.pageTitle')"
      :show-back="true"
    />

    <scroll-view
      class="test-scroll"
      direction="vertical"
      :show-scrollbar="false"
    >
      <view class="test-container">
      <view class="section">
        <text class="section-title">{{
          t("Mobile.Intervention.Test.acpSection")
        }}</text>
        <view class="card-list">
          <view
            v-for="acp in acpMocks"
            :key="acp.id"
            class="card-list-item"
          >
            <intervention-card
              kind="acp_permission"
              :acp-interaction="readableAcp(acp)"
              @respond-acp="createAcpRespondHandler(acp)"
            />
          </view>
        </view>
      </view>

      <view class="section">
        <text class="section-title">{{
          t("Mobile.Intervention.Test.mcpSection")
        }}</text>
        <view class="card-list">
          <view
            v-for="mcp in mcpMocks"
            :key="`${mcp.requestId}:${getMcpRevision(mcp.revision)}`"
            class="card-list-item"
          >
            <intervention-card
              kind="mcp_ask"
              :mcp-interaction="readableMcp(mcp)"
              @respond-mcp="createMcpRespondHandler(mcp)"
            />
          </view>
        </view>
      </view>

      <view class="actions">
        <button class="btn" @tap="resetAll">
          {{ t("Mobile.Intervention.Test.resetAll") }}
        </button>
      </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  /**
   * 干预卡片集成演示页（ACP 权限审批 + MCP Ask 结构化提问）
   *
   * 路由  /pages/test-intervention/test-intervention
   * H5    {域名}/m/#/pages/test-intervention/test-intervention
   *
   * 模块文档：components/agent-intervention/README.md
   * Mock 数据：utils/mockInterventionData.uts
   */
  import { ref, onMounted } from "vue";
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import InterventionCard from "@/components/agent-intervention/intervention-card/intervention-card.uvue";
  import { asReadableMcp } from "@/subpackages/pages/chat-conversation-component/utils/mcpAskInterventionState.uts";
  import { normalizeAcpPermissionInteraction } from "@/subpackages/utils/interventionAdapter";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { orNumber } from "@/utils/utsCoalesce.uts";
  import {
    mockAcpPermissionSimple,
    mockAcpPermissionMultiOption,
    mockAcpPermissionNetwork,
    mockMcpAskSurvey,
    mockMcpAskSelectForm,
    mockMcpAskSimple,
    mockMcpAskWithFile,
    mockMcpAskWithList,
    mockMcpAskWizard,
  } from "@/utils/mockInterventionData";
  import type {
    AcpPermissionInteraction,
    AcpPermissionResponse,
    McpAskInteraction,
    McpAskRespondPayload,
  } from "@/types/intervention";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // Mock 是 class 实例；卡片内部 readRawField 需要 UTSJSONObject（Android 不能把 class as UTSJSONObject，
  // 会 CCE）。渲染前转成与生产链路一致的 readable UTSJSONObject；mock 列表仍保留 class 供 respond 处理用点访问。
  const readableMcp = (m: McpAskInteraction): UTSJSONObject => asReadableMcp(m);
  const readableAcp = (a: AcpPermissionInteraction): UTSJSONObject =>
    normalizeAcpPermissionInteraction(a);

  const acpMocks = ref<AcpPermissionInteraction[]>([]);
  const mcpMocks = ref<McpAskInteraction[]>([]);

  const getMcpRevision = (revision: number | null | undefined): number => {
    return orNumber(revision, 1);
  };

  const initMocks = () => {
    acpMocks.value = [
      mockAcpPermissionSimple(),
      mockAcpPermissionMultiOption(),
      mockAcpPermissionNetwork(),
    ];
    mcpMocks.value = [
      mockMcpAskSurvey(),
      mockMcpAskSelectForm(),
      mockMcpAskSimple(),
      mockMcpAskWithFile(),
      mockMcpAskWithList(),
      mockMcpAskWizard(),
    ];
  };

  const resetAll = () => {
    initMocks();
    uni.showToast({
      title: t("Mobile.Intervention.Test.resetDone"),
      icon: "none",
    });
  };

  const onAcpRespond = (
    interaction: AcpPermissionInteraction,
    response: AcpPermissionResponse,
  ) => {
    console.log("[ACP Respond]", interaction.id, response);
    const idx = acpMocks.value.findIndex((i) => i.id === interaction.id);
    if (idx >= 0) {
      const item = acpMocks.value[idx];
      item.responseStatus = "submitting";
      if (response.outcome.outcome === "selected") {
        item.selectedOptionId = response.outcome.optionId;
      }
    }

    setTimeout(() => {
      const idx2 = acpMocks.value.findIndex((i) => i.id === interaction.id);
      if (idx2 >= 0) {
        acpMocks.value[idx2].responseStatus = "submitted";
      }
      uni.showToast({
        title: `已${response.outcome.outcome === "selected" ? "批准" : "拒绝"}: ${interaction.request.toolCall.title}`,
        icon: "none",
        duration: 2000,
      });
    }, 1000);
  };

  const onMcpRespond = (
    interaction: McpAskInteraction,
    payload: McpAskRespondPayload,
  ) => {
    console.log("[MCP Respond]", interaction.requestId, payload);
    const idx = mcpMocks.value.findIndex(
      (i) => i.requestId === interaction.requestId,
    );
    if (idx >= 0) {
      const item = mcpMocks.value[idx];
      if (payload.action === "cancel") {
        item.responseStatus = "cancelled";
      } else if (payload.action === "skip") {
        item.responseStatus = "skipped";
      } else {
        item.responseStatus = "submitted";
      }
      item.formData = payload.formData;
    }
    uni.showToast({
      title: `${interaction.title}: ${payload.action}`,
      icon: "none",
      duration: 2000,
    });
  };

  const createAcpRespondHandler = (
    acp: AcpPermissionInteraction,
  ): ((resp: AcpPermissionResponse) => void) => {
    return (resp: AcpPermissionResponse): void => {
      onAcpRespond(acp, resp);
    };
  };

  const createMcpRespondHandler = (
    mcp: McpAskInteraction,
  ): ((payload: McpAskRespondPayload) => void) => {
    return (payload: McpAskRespondPayload): void => {
      onMcpRespond(mcp, payload);
    };
  };

  onMounted(() => {
    initMocks();
  });
</script>

<style lang="scss" scoped>
  .test-page {
    display: flex;
    flex-direction: column;
    /* #ifdef H5 || WEB */
    height: 100vh;
    /* #endif */
    /* #ifndef H5 || WEB */
    flex: 1;
    height: 100%;
    /* #endif */
    background-color: #f5f5f5;
  }

  /* uvue：普通 view 不滚动；内容需 scroll-view，并给确定高度（flex:1 撑满 nav-bar 之外）才肯滚 */
  .test-scroll {
    flex: 1;
  }

  .test-container {
    padding: 24rpx;
  }

  .section {
    margin-bottom: 40rpx;
  }

  .section-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 20rpx;
  }

  .card-list {
    display: flex;
    flex-direction: column;
    /* #ifdef H5 || WEB */
    gap: 20rpx;
    /* #endif */
  }

  /* #ifndef H5 || WEB */
  .card-list-item {
    margin-bottom: 20rpx;
  }
  /* #endif */

  .actions {
    margin-top: 40rpx;
    padding: 20rpx 0;
    display: flex;
    flex-direction: column;
    /* #ifdef H5 || WEB */
    gap: 16rpx;
    /* #endif */
  }

  .btn-secondary {
    background-color: #fff;
    color: #1677ff;
    border: 2rpx solid #1677ff;
  }

  .btn {
    background-color: #1677ff;
    color: #fff;
    border: none;
    border-radius: 12rpx;
    padding: 24rpx 40rpx;
    font-size: 30rpx;
    font-weight: 500;
  }

  .btn:active {
    opacity: 0.8;
  }
</style>
