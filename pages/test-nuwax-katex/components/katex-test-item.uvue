<template>
	<view class="kti-root">
		<view class="kti-head" v-if="showIndex || desc.length > 0">
			<text class="kti-index" v-if="showIndex">#{{ index }}</text>
			<text class="kti-desc" v-if="desc.length > 0">{{ desc }}</text>
			<text class="kti-status" :class="statusClass">{{ statusText }}</text>
		</view>
		<view class="kti-body" :class="block ? 'kti-body-block' : 'kti-body-inline'">
			<nuwax-katex
				:tex="tex"
				:display-mode="block"
				@load="onLoad"
				@error="onError"
			/>
		</view>
		<text class="kti-size" v-if="showSize">{{ sizeText }}</text>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import NuwaxKatex from '@/uni_modules/nuwax-katex/components/nuwax-katex/nuwax-katex.uvue'

	const props = withDefaults(
		defineProps<{
			index: number
			tex: string
			block: boolean
			desc?: string
			showIndex?: boolean
			showSize?: boolean
		}>(),
		{
			desc: '',
			showIndex: false,
			showSize: true,
		}
	)

	const emit = defineEmits<{
		(e: 'report', detail: UTSJSONObject): void
	}>()

	const status = ref<string>('loading')
	const statusText = ref<string>('加载中')
	const sizeText = ref<string>('--')
	let lastW = 0
	let lastH = 0
	/** 只上报一次（nuwax-katex 的 load 会随字体/尺寸多次触发） */
	let reported = false

	const statusClass = computed((): string => {
		if (status.value == 'error') return 'kti-st-err'
		if (status.value == 'ok') return 'kti-st-ok'
		return 'kti-st-loading'
	})

	function sendReport(st: string): void {
		if (reported) return
		reported = true
		const d = new UTSJSONObject()
		d['index'] = props.index
		d['status'] = st
		d['w'] = lastW
		d['h'] = lastH
		emit('report', d)
	}

	function onLoad(detail: UTSJSONObject | null): void {
		if (detail == null) return
		const w = detail['width'] as number
		const h = detail['height'] as number
		if (w != null && w > 0) {
			lastW = w
		}
		if (h != null && h > 0) {
			lastH = h
		}
		sizeText.value = '' + lastW + '×' + lastH
		status.value = 'ok'
		statusText.value = 'OK'
		sendReport('ok')
		// 尺寸异常（宽高为 0 / 超界）：记录到日志便于批量排查
		if (lastW <= 0 || lastH <= 0 || lastH > 600 || lastW > 2000) {
			console.log('[nkx-test] item#' + props.index + ' SIZE-ANOMALY w=' + lastW + ' h=' + lastH + ' tex=' + props.tex)
		}
	}

	function onError(detail: UTSJSONObject | null): void {
		status.value = 'error'
		statusText.value = 'ERR'
		sizeText.value = 'ERR'
		sendReport('error')
		console.log('[nkx-test] item#' + props.index + ' RENDER-ERROR tex=' + props.tex)
	}
</script>

<style lang="scss" scoped>
	.kti-root {
		width: 100%;
	}

	.kti-head {
		flex-direction: row;
		align-items: center;
		height: 36rpx;
		margin-bottom: 4rpx;
	}

	.kti-index {
		font-size: 20rpx;
		color: #5147ff;
		margin-right: 12rpx;
		font-weight: bold;
	}

	.kti-desc {
		font-size: 20rpx;
		color: #999;
		flex: 1;
	}

	.kti-status {
		font-size: 20rpx;
	}

	.kti-st-loading {
		color: #b0b0b0;
	}

	.kti-st-ok {
		color: #2ea44f;
	}

	.kti-st-err {
		color: #cc0000;
	}

	.kti-body {
		border-radius: 8rpx;
		padding: 4rpx 0;
		min-height: 32rpx;
	}

	/* 加载中：灰色虚线边框；OK：绿色细边框；ERR：红色边框 */
	.kti-body.kti-st-loading {
		border: 2rpx dashed #d0d0d0;
	}

	.kti-body.kti-st-ok {
		border: 2rpx solid #c9f0d1;
	}

	.kti-body.kti-st-err {
		border: 2rpx solid #f5c2c2;
	}

	.kti-body-block {
		flex-direction: row;
		justify-content: center;
		align-items: center;
		width: 100%;
	}

	.kti-body-inline {
		flex-direction: row;
		align-items: center;
		/* 行内公式按内容宽度收缩，不撑满 */
		align-self: flex-start;
	}

	.kti-size {
		font-size: 20rpx;
		color: #999;
		margin-top: 4rpx;
	}
</style>
