<script lang="uts">
import { bootstrapVoip, setVoipBackground } from "@/features/voip/integration";
import { hasAppPrivacyConsent } from "@/utils/appPrivacyConsent";
import { setAppInBackground } from "@/utils/appLifecycle";
export default {
  onShow() { setAppInBackground(false); if (hasAppPrivacyConsent()) bootstrapVoip().then(() => { setVoipBackground(false); }).catch((_e) => {}); },
  onHide() { setAppInBackground(true); setVoipBackground(true); }
};
</script>
