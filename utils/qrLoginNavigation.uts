import {
  isQrLoginLink,
  currentQrLoginOrigin,
  parseQrLoginLink,
  qrLoginPageUrl,
} from '@/utils/qrLogin';
import { LOGIN_PAGE_PATH, isOnLoginPage, redirectToLoginOnce } from '@/utils/authNavigation';
import { mobileLoginDestination } from '@/utils/authIdp';

let lastRaw = '';
let lastAt = 0;
let lastOrigin = '';

function enterQrLoginLink(): string {
  // #ifdef APP
  try {
    const options = uni.getEnterOptionsSync() as UTSJSONObject;
    const scheme = options['appScheme'];
    if (scheme != null && isQrLoginLink(`${scheme}`)) return `${scheme}`;
    const link = options['appLink'];
    if (link != null && isQrLoginLink(`${link}`)) return `${link}`;
  } catch (_error) {
    return '';
  }
  // #endif
  return '';
}

/** 只消费明确的扫码登录意图；普通回前台不重放上一次唤起参数。 */
export function routeIncomingQrLogin(
  hasToken: boolean,
  raw: string,
  coldStart: boolean = false,
): boolean {
  const incoming = raw.length > 0 ? raw : coldStart ? enterQrLoginLink() : '';
  if (!isQrLoginLink(incoming)) return false;
  const origin = currentQrLoginOrigin();
  const now = Date.now();
  if (incoming == lastRaw && lastOrigin == origin && now - lastAt < 2000)
    return true;
  lastRaw = incoming;
  lastAt = now;
  lastOrigin = origin;
  const target = parseQrLoginLink(incoming, origin);
  // 异域或畸形意图只打开错误页，不登录、不向二维码指定地址发请求。
  if (target == null) {
    uni.reLaunch({ url: qrLoginPageUrl('', '') });
    return true;
  }
  const url = qrLoginPageUrl(target.sceneId, target.origin);
  if (!hasToken) {
    // 用户明确打开新二维码时，已有登录页也要续接本次确认目标。
    if (isOnLoginPage()) {
      uni.reLaunch({ url: mobileLoginDestination(LOGIN_PAGE_PATH, url, origin) });
    } else redirectToLoginOnce(LOGIN_PAGE_PATH, url);
  } else uni.reLaunch({ url: url });
  return true;
}
