<template>
	<!-- #ifdef APP -->
	<!-- App 常驻聊天壳：web-view 首次打开后永不 v-if 销毁，仅用可见性覆盖层 show/hide -->
	<view
		class="resident-chat-shell"
		:class="shellVisible ? 'resident-chat-shell--visible' : 'resident-chat-shell--hidden'"
	>
		<web-view
			v-if="shellCreated"
			id="resident-chat-webview"
			class="webview-fill"
			:src="agentDetailWebUrl"
			@load="handleWebViewLoad"
			@message="handleWebViewMessage"
			:bounces="false"
			:android-nested-scroll="'none'"
		/>
		<!-- Android：兄弟占位，避免单节点走全屏原生层导致 createWebviewContext 失败 -->
		<view v-if="shellCreated" class="webview-node-placeholder" />
		<!-- 换会话遮罩：勿把动态 class 绑在 web-view 上（易触发 setSrc；且 @message 在 JavaBridge） -->
		<view v-if="shellCreated && !shellContentReady" class="resident-chat-shell__mask" />
	</view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { ref, onUnmounted, onMounted, getCurrentInstance } from 'vue'
	import { onShow, onHide } from '@dcloudio/uni-app'
	import { useI18n, emptyI18nParams } from '@/utils/i18n'
	// #ifdef APP
	import { getApiBaseUrl } from '@/constants/config'
	import { ACCESS_TOKEN } from '@/constants/home.constants'
	import { getUploadFileAction } from '@/constants/common.constants'
	import { consumeLatestPendingOpenUiAction } from '@/utils/pendingOpenUiAction.uts'
	import { openExternalLinkPage } from '@/utils/system.uts'
	import {
		acknowledgeAppNativePayResult,
		beginAppNativePaySession,
		checkActiveAppPayResult,
		getStoredAppNativePayResult,
		launchAppNativePayRedirect,
		requestAppNativePayRedirect,
		storeAppNativePayResult,
	} from '@/subpackages/utils/paymentUtils.uts'
	// App web-view 内嵌页原生语音：录音（RecorderManager + 流式 ASR 转写）与 TTS 播报
	import { voiceStreamSpeaker } from '@/subpackages/utils/voice/voiceStreamSpeaker'
	import {
		ttsWebSocketPlayer,
		type TtsPlaybackState,
	} from '@/subpackages/utils/voice/ttsWebSocketPlayer'
	import { audioPlayerManager } from '@/subpackages/utils/voice/audioPlayerManager'
	import { stopAllSpeechPlayback } from '@/subpackages/utils/voice/stopAllSpeechPlayback'
	import { VoiceSettings } from '@/subpackages/utils/voice/voiceTypes'
	// 流式 ASR（与 TTS 同一套 WS 基建）：内嵌页录音走 PCM→WS 转写，不再 HTTP 上传音频文件
	import {
		asrWebSocketClient,
		ASR_SAMPLE_RATE,
	} from '@/subpackages/utils/voice/asrWebSocketClient'
	import { streamLocalAudioFileToAsrFrom } from '@/subpackages/utils/voice/pcmStreamRecorder'
	// 实时推流管道（边说边传）：VAD + 预滚 + packetizer + sentBytes
	import { NativeStreamAsrPipeline } from '@/subpackages/utils/voice/nativeStreamAsrPipeline'
	// 文件树「下载全部」：内嵌 H5 改走原生下载（下载到系统公共目录）
	import { downloadFileInApp } from '@/subpackages/utils/fileTree'
	// Android 内嵌 H5 字体放大修复：强制 webview textZoom = 100%
	import { fixAppWebviewTextZoom } from '@/subpackages/utils/webviewTextZoom'
	import { RESIDENT_CHAT_EVENT, setResidentChatVisibleFlag, setResidentChatCoverActive, rememberResidentChatSession, isResidentChatVisible, hideResidentChat, navigateAfterResidentChatHidden } from '@/utils/residentChatShell'
	// App 三端原生录音：StreamPcmRecorder（原生采集 + 写文件 + 实时帧转发，边说边传 ASR）
	import { StreamPcmRecorder } from '@/uni_modules/nuwax-stream-pcm-player'
	// #endif
	// #ifdef APP-IOS
	import { IosMediaPermission } from '@/uni_modules/nuwax-stream-pcm-player'
	// #endif
	// #ifdef APP-HARMONY
	// 鸿蒙专属：录音权限被永久拒绝时跳转应用权限设置页
	import { openHarmonyMicPermissionSettings } from '@/uni_modules/nuwax-stream-pcm-player'
	// #endif

	const { t: tFn } = useI18n()
	const t = (key: string): string => tFn(key, emptyI18nParams(), "")

	// #ifdef APP
	const instance = getCurrentInstance()

	/** 内嵌 H5 地址：仅首次挂载写入 :src；之后换会话不改此 ref，避免 setSrc */
	const agentDetailWebUrl = ref<string>("")
	/** 当前会话文档 URL（含 _rs，可与业务会话不一致；会话同一性看 currentAgentId） */
	let currentChatUrl: string = ""
	/** 壳内已加载的智能体 / 会话（忽略 URL _rs 时间戳） */
	let currentAgentId: string = ""
	let currentConversationId: string = ""
	/** 首次打开后置 true，之后永不回 false（杜绝 WKWebView 建销） */
	const shellCreated = ref<boolean>(false)
	/** 覆盖层是否可见（隐藏时 web-view 仍挂载） */
	const shellVisible = ref<boolean>(false)
	/** 当前文档是否已加载到目标会话；false 时盖白遮罩 */
	const shellContentReady = ref<boolean>(false)
	/**
	 * 换会话时先保持壳隐藏，等目标文档就绪再揭开（Android 原生 web-view 盖不住，遮罩挡不住旧页）。
	 * 勿用 about:blank 清屏：部分机型会把 blank 交给系统浏览器开新页签。
	 */
	let pendingRevealAfterLoad: boolean = false
	/** 期望揭开的智能体 id（与 H5 app-chat-ready 对齐；无信号时靠 @load 兜底） */
	let pendingRevealAgentId: string = ""
	/** 揭开兜底定时器（@load / ready 均未到时避免卡死） */
	let revealFallbackTimer: number = 0
	/** 系统相册/文件选择等会触发页面 onHide：避免误判 */
	let suppressHideUnmount: boolean = false
	/** @load 后注入短轮询定时器 / 次数 / 成功上报标记 */
	let appWebViewBridgeTimer: number = 0
	let appWebViewBridgeAttempts: number = 0
	let appWebViewBridgeReported: boolean = false
	/** 已创建的 webview context 缓存：原生语音桥 evalJS 回传与注入共用 */
	let appWebViewBridgeContext: WebviewContext | null = null
	/** H5 内嵌页是否正有弹窗打开（由 H5 postMessage 同步，onBackPress 拦截用） */
	let appWebViewPopupOpen: boolean = false
	/** 原生侧键盘高度监听 id（onKeyboardHeightChange 返回值），桥接给内嵌 H5 */
	let appKeyboardHeightListenerId: number = 0
	/** 最近一次键盘高度：webview 未就绪时随注入轮询补发（默认 0 = 键盘收起） */
	let latestInjectedKeyboardHeight: number = 0
	/** 底部手势条/导航条高度（safeAreaInsets.bottom）：onKeyboardHeightChange 兜底值归一化为完整 IME 时使用 */
	let latestInjectedSafeAreaBottom: number = 0
	/** 防止多次 onShow 并发核对同一笔支付订单。 */
	let nativePayResultChecking: boolean = false



	function stopWebViewBridge(): void {
		if (appWebViewBridgeTimer != 0) {
			clearInterval(appWebViewBridgeTimer)
			appWebViewBridgeTimer = 0
		}
		// 保留 appWebViewBridgeContext：同会话再次打开只揭开壳，不必重建 context
		appWebViewBridgeReported = false
		appWebViewBridgeAttempts = 0
	}

	function showTabBarSafe(): void {
		try {
			uni.showTabBar({ animation: false })
		} catch (_e) {
			// ignore
		}
	}

	function hideTabBarSafe(): void {
		try {
			uni.hideTabBar({ animation: false })
		} catch (_e) {
			// ignore
		}
	}

	/**
	 * Android：web-view @message / @load 常在 JavaBridge 线程回调；改 :src / 显隐必须回到主线程，
	 * 否则 loadUrl 抛 “WebView method was called on thread 'JavaBridge'”。
	 */
	function runOnMainThread(fn: () => void): void {
		// #ifdef APP-ANDROID
		try {
			const activity = UTSAndroid.getUniActivity()
			if (activity != null) {
				activity.runOnUiThread((): void => {
					fn()
				})
				return
			}
		} catch (_eMain) {
			// fall through
		}
		// #endif
		fn()
	}

	function clearRevealFallbackTimer(): void {
		if (revealFallbackTimer != 0) {
			clearTimeout(revealFallbackTimer)
			revealFallbackTimer = 0
		}
	}

	/** 揭开常驻壳（换会话完成后 / 兜底）。桥注入由调用方在 startAppWebViewBridge 声明后触发。 */
	function revealChatShellOnMain(): void {
		clearRevealFallbackTimer()
		pendingRevealAfterLoad = false
		pendingRevealAgentId = ""
		shellVisible.value = true
		shellContentReady.value = true
		setResidentChatCoverActive(false)
		fixAppWebviewTextZoom()
		// 进页清掉残留键盘高度，避免 disclaimer / keyboard-cover 幽灵垫高
		latestInjectedKeyboardHeight = 0
		try {
			const ctx = appWebViewBridgeContext
			if (ctx != null) {
				ctx.evalJS(
					"try{window.__nuwaxKeyboardHeight=0;window.dispatchEvent(new CustomEvent('nuwax:keyboardHeightChange',{detail:{height:0,safeAreaBottom:window.__nuwaxSafeAreaBottom||0}}));}catch(e){}",
				)
			}
		} catch (_eKbClear) {
			// ignore
		}
	}

	function scheduleRevealFallback(ms: number): void {
		clearRevealFallbackTimer()
		revealFallbackTimer = setTimeout((): void => {
			revealFallbackTimer = 0
			runOnMainThread((): void => {
				if (!pendingRevealAfterLoad) {
					return
				}
				revealChatShellOnMain()
			})
		}, ms) as number
	}

	/**
	 * 换会话：先把当前文档刷成白底，再 location.replace。
	 * 避免在遮罩缝隙 / 原生层合成时仍画出上一会话。
	 */
	function navigateWebViewToUrl(url: string): void {
		try {
			let ctx = appWebViewBridgeContext
			if (ctx == null) {
				ctx = uni.createWebviewContext("resident-chat-webview", instance?.proxy)
				appWebViewBridgeContext = ctx
			}
			if (ctx != null) {
				const literal = JSON.stringify(url)
				ctx.evalJS(
					"try{document.documentElement.style.background='#fff';var b=document.body;if(b){b.style.background='#fff';b.style.minHeight='100vh';b.innerHTML='';}}catch(_c){}try{location.replace(" +
						literal +
						")}catch(_n){}",
				)
				return
			}
		} catch (_eNav) {
			// fall through
		}
		// 改 :src 易在加载中触发 setSrc / 重绑崩溃：推迟到事件栈外
		const nextUrl = url
		setTimeout((): void => {
			runOnMainThread((): void => {
				agentDetailWebUrl.value = nextUrl
			})
		}, 0)
	}

	/**
	 * 打开/切换会话。
	 * - 同会话：直接揭开（内容已是目标，勿重载）
	 * - 异会话：白遮罩盖住壳 → 页内刷白 + replace → 等 app-chat-ready / @load 再揭开
	 *   （勿先 shellVisible=false：Android 原生 web-view 常无视 CSS 显隐，反而会露出旧画）。
	 */
	function openChatOnMain(agentId: string, conversationId: string, url: string): void {
		if (agentId.length == 0) {
			return
		}
		if (url.length == 0) {
			return
		}
		const alreadyCreated = shellCreated.value
		const sameSession =
			alreadyCreated &&
			currentAgentId == agentId &&
			currentConversationId == conversationId
		setResidentChatVisibleFlag(true)
		hideTabBarSafe()

		if (!alreadyCreated) {
			// 首次：先盖白，等首屏 @load / ready 再揭，避免空 web-view 闪一下
			setResidentChatCoverActive(true)
			shellContentReady.value = false
			pendingRevealAfterLoad = true
			pendingRevealAgentId = agentId
			clearRevealFallbackTimer()
			agentDetailWebUrl.value = url
			shellCreated.value = true
			currentChatUrl = url
			currentAgentId = agentId
			currentConversationId = conversationId
			rememberResidentChatSession(agentId, conversationId)
			shellVisible.value = true
			fixAppWebviewTextZoom()
			scheduleRevealFallback(5000)
			return
		}

		if (sameSession) {
			pendingRevealAfterLoad = false
			pendingRevealAgentId = ""
			clearRevealFallbackTimer()
			shellContentReady.value = true
			shellVisible.value = true
			setResidentChatCoverActive(false)
			fixAppWebviewTextZoom()
			// 同会话再开不重载 H5：须主动清掉可能残留的键盘垫高
			latestInjectedKeyboardHeight = 0
			try {
				const ctx = appWebViewBridgeContext
				if (ctx != null) {
					ctx.evalJS(
						"try{window.__nuwaxKeyboardHeight=0;window.dispatchEvent(new CustomEvent('nuwax:keyboardHeightChange',{detail:{height:0,safeAreaBottom:window.__nuwaxSafeAreaBottom||0}}));}catch(e){}",
					)
				}
			} catch (_eKbClearSame) {
				// ignore
			}
			return
		}

		// 换会话：遮罩必须先盖住，再刷白 + 导航；壳保持 visible
		setResidentChatCoverActive(true)
		shellContentReady.value = false
		shellVisible.value = true
		pendingRevealAfterLoad = true
		pendingRevealAgentId = agentId
		currentChatUrl = url
		currentAgentId = agentId
		currentConversationId = conversationId
		rememberResidentChatSession(agentId, conversationId)
		stopWebViewBridge()
		appWebViewBridgeReported = false
		navigateWebViewToUrl(url)
		fixAppWebviewTextZoom()
		scheduleRevealFallback(5000)
	}

	function openChat(agentId: string, conversationId: string, url: string): void {
		runOnMainThread((): void => {
			openChatOnMain(agentId, conversationId, url)
		})
	}

	function hideChatShellOnMain(restoreTabBar: boolean): void {
		pendingRevealAfterLoad = false
		pendingRevealAgentId = ""
		clearRevealFallbackTimer()
		latestInjectedKeyboardHeight = 0
		const shouldRestoreTab =
			restoreTabBar == true &&
			(shellVisible.value == true || isResidentChatVisible() == true)
		shellVisible.value = false
		shellContentReady.value = false
		setResidentChatVisibleFlag(false)
		stopWebViewBridge()
		try {
			stopAllSpeechPlayback()
		} catch (_eStop) {
			// ignore
		}
		if (shouldRestoreTab) {
			showTabBarSafe()
		}
	}

	/** 隐藏壳：不停销毁 web-view，停语音；按需恢复 TabBar */
	function hideChatShell(restoreTabBar: boolean = true): void {
		runOnMainThread((): void => {
			hideChatShellOnMain(restoreTabBar)
		})
	}

	function onResidentChatEvent(raw: any): void {
		const obj = raw as UTSJSONObject
		const action = obj["action"] != null ? `${obj["action"]}` : ""
		if (action == "hide") {
			const restoreRaw = obj["restoreTabBar"]
			const restoreTabBar = restoreRaw == null || restoreRaw == true
			hideChatShell(restoreTabBar)
			return
		}
		if (action == "open") {
			const agentId = obj["agentId"] != null ? `${obj["agentId"]}` : ""
			const conversationId = obj["conversationId"] != null ? `${obj["conversationId"]}` : ""
			const url = obj["url"] != null ? `${obj["url"]}` : ""
			openChat(agentId, conversationId, url)
		}
	}



	/**
	 * 直接读 WindowInsets 的 IME 高度（device px → css px）。
	 * 本环境实测：uni.onKeyboardHeightChange 恒 0、H5 innerHeight/visualViewport 不随键盘变化——
	 * 键盘以覆盖层形式出现且不被任何 resize 反映，WindowInsets 的 IME insets 在 API 30+ 上
	 * 与 softInputMode 无关地派发，是唯一可靠读数。
	 */
	function readAndroidImeHeight(): number {
		try {
			const activity = UTSAndroid.getUniActivity()
			if (activity == null) {
				return 0
			}
			const win = activity.getWindow()
			if (win == null) {
				return 0
			}
			const decor = win.getDecorView()
			if (decor == null) {
				return 0
			}
			const insets = decor.getRootWindowInsets()
			if (insets == null) {
				return 0
			}
			// WindowInsets.Type.ime() = 1 << 3 = 8（API 30+）；返回值是 Insets，取 bottom 字段
			const ime = insets.getInsets(8)
			if (ime == null) {
				return 0
			}
			const px = ime.bottom
			if (px <= 0) {
				return 0
			}
			// device px → css px（与 uni-app x 键盘监听一致的换算）
			const css = UTSAndroid.devicePX2px(px)
			return css > 0 ? css : 0
		} catch (_eIme) {
			// ignore
		}
		return 0
	}

	/**
	 * 读取原生底部安全区（手势条）。全平台通用；H5 env() 在鸿蒙 WebView/模拟器不可靠。
	 */
	function readNativeSafeAreaBottom(): number {
		let bottom = 0
		try {
			const sysInfo = uni.getSystemInfoSync()
			const safeInset = sysInfo.safeAreaInsets
			if (safeInset != null && safeInset.bottom != null) {
				bottom = safeInset.bottom as number
			}
		} catch (_eInset) {
			// ignore
		}
		return bottom > 0 ? bottom : 0
	}

	/**
	 * 读取 Android 底部手势条/导航条高度（safe-area-inset-bottom）。
	 * 全屏 webview 下 H5 无法可靠读取（env() 通常为 0），由原生侧读取并注入。
	 */
	function readAndroidSafeAreaBottom(): number {
		return readNativeSafeAreaBottom()
	}

	/**
	 * 幂等注入脚本：uni.webview JSSDK（网页 → 原生 postMessage 桥）+ ticket cookie
	 * + localStorage 的 ACCESS_TOKEN + 内嵌标记方法。
	 * JSSDK 与既有 uni-app H5 运行时会合并（保留现有 uni 全局），仅内嵌 App web-view 时生效。
	 * 脚本随 H5 构建发布在 static/ 下（相对路径 ./static/... 按文档 base 解析，
	 * 部署在 /m/ 或根路径都能命中），不依赖线上 nginx 根 /static/ 目录。
	 */
	function buildBridgeCode(tokenLiteral: string): string {
		return `try{if(!window.uni||!uni.webView){var s=document.createElement('script');s.src='./static/uni.webview.1.5.5.js';document.head.appendChild(s);}}catch(e){}try{document.cookie='ticket='+${tokenLiteral}+'; path=/';}catch(e){} try{localStorage.setItem('ACCESS_TOKEN',${tokenLiteral});}catch(e){} window.__nuwaxSetAppEmbedded && window.__nuwaxSetAppEmbedded();`
	}

	/**
	 * 生成键盘高度注入脚本（字符串拼接，避免 UTS 模板字符串误解析 {}）。
	 * @param withDomFix iOS/鸿蒙为 true 时：安装 focus 跟手抬升 + 用桥接终值校正；
	 *   桥接轮询传 false（仍安装 focus 预测逻辑，但不按终值改 cover，避免刷屏）。
	 */
	function buildKeyboardHeightInjectCode(
		h: number,
		safeBottom: number,
		withDomFix: boolean,
	): string {
		const heightNum = `${Math.round(h)}`
		const safeBottomNum = `${Math.round(safeBottom)}`
		let cachedLastH = 0
		try {
			const raw = uni.getStorageSync("NUWAX_KB_LAST_H")
			if (raw != null) {
				const n = parseFloat(`${raw}`)
				if (!isNaN(n) && n > 0) {
					cachedLastH = n
				}
			}
		} catch (_eCache) {
			// ignore
		}
		if (cachedLastH <= 0 && latestInjectedKeyboardHeight > 0) {
			cachedLastH = latestInjectedKeyboardHeight
		}
		const cachedLastNum = `${Math.round(cachedLastH)}`
		let platform = "unknown"
		// #ifdef APP-ANDROID
		platform = "android"
		// #endif
		// #ifdef APP-IOS
		platform = "ios"
		// #endif
		// #ifdef APP-HARMONY
		platform = "harmony"
		// #endif

		// 基础：写全局 + CSS 变量（H5 env(safe-area-inset-bottom) 在鸿蒙 WebView/模拟器常虚高）
		// + 派发事件
		let code =
			"(function(){try{window.__nuwaxKeyboardHeight=" +
			heightNum +
			";window.__nuwaxSafeAreaBottom=" +
			safeBottomNum +
			";try{document.documentElement.style.setProperty('--nuwax-safe-area-bottom','" +
			safeBottomNum +
			"px');}catch(_css){}window.__nuwaxKbPlatform='" +
			platform +
			"';window.dispatchEvent(new CustomEvent('nuwax:keyboardHeightChange',{detail:{height:" +
			heightNum +
			",safeAreaBottom:" +
			safeBottomNum +
			",platform:'" +
			platform +
			"'}}));}catch(e){}"

		// #ifdef APP-IOS || APP-HARMONY
		// 首次：无缓存时系统可能先 pan（整页跟键盘），桥接终值再垫 cover →「底部晚出现」。
		// 再次：有 LastH，focusin 立刻抬 cover+锁滚，不再依赖系统 pan。
		// 此处：尽早恢复 LastH；桥接终值若 cover 仍为 0 则瞬间校正（禁止晚到的 0→h 动画）。
		code =
			code +
			"try{window.__nuwaxKbCoverTrans='height 0.25s cubic-bezier(0.2,0.9,0.2,1)';try{if(!(window.__nuwaxKbLastH>0)){var __ls=localStorage.getItem('__nuwaxKbLastH');if(__ls){var __ln=parseFloat(__ls);if(!isNaN(__ln)&&__ln>0)window.__nuwaxKbLastH=__ln;}}}catch(_ls){}if(!(window.__nuwaxKbLastH>0)&&" +
			cachedLastNum +
			">0){window.__nuwaxKbLastH=" +
			cachedLastNum +
