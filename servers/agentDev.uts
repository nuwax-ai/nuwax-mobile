// 创建用户临时票据
export async function apiUserTicketCreate(): Promise<RequestResponse<string>> {
  const accessTokenRaw = uni.getStorageSync(ACCESS_TOKEN);
  const accessToken = accessTokenRaw != null ? `${accessTokenRaw}` : "";
  const res = await request({
    url: "/api/user/ticket/create",
    method: "POST",
    data: {
      token: accessToken,
    },
  });
  return res;
}

// 查询文件列表。Android Gson 无法实例化 UTS interface，响应必须按动态对象读取。
export async function apiGetStaticFileList(cId: number): Promise<RequestResponse<any>> {
  const res = await request({
    url: "/api/computer/static/file-list",
    method: "GET",
    data: {
      cId,
    },
  });
  return res;
}

// 分享文件
export async function apiAgentConversationShare(data: AgentConversationShareParams): Promise<RequestResponse<ShareFileInfo>> {
  const res = await request({
    url: "/api/agent/conversation/share",
    method: "POST",
    data,
  });
  return res;
}

// 下载全部文件
export async function apiDownloadAllFiles(cId: number): Promise<DownloadAllFilesResult> {
  // #ifdef H5 || WEB
  // H5 环境：直接使用 uni.request 获取完整响应
  const accessToken = uni.getStorageSync(ACCESS_TOKEN);
  const header: any = {
    // ...COMMON_HEADERS,
  };
  if (Boolean(accessToken)) {
    header["Authorization"] = `Bearer ${accessToken}`;
  }

  return new Promise((resolve, reject) => {
    uni.request({
      url: API_BASE_URL + `/api/computer/static/download-all-files`,
      method: "GET",
      header,
      responseType: "arraybuffer", // H5 使用 arraybuffer
      data: {
        cId,
      },
      success: (res) => {
        if (res.statusCode === 200) {
          // 将 ArrayBuffer 转换为 Blob
          const blob = new Blob([res.data as ArrayBuffer], {
            type: "application/zip",
          });
          const resHeaders = res.header;
          resolve({
            data: blob,
            headers: resHeaders != null ? resHeaders : {},
          });
        } else {
          reject(
            new Error(
              t("Mobile.AgentDev.downloadFailedWithCode", {
                code: String(res.statusCode),
              }),
            ),
          );
        }
      },
      fail: (err) => {
        reject(err);
      },
    });
  });
  // #endif

  // #ifndef H5 || WEB
  // 小程序环境：返回下载 URL（实际下载由调用方处理）
  return Promise.resolve({
    data: null as any,
    headers: {},
  });
  // #endif
}
// 智能体会话可选模型列表
export async function apiGetAgentModelOptions(agentId: number): Promise<RequestResponse<AgentModelOption[]>> {
  const res = await request({
    url: `/api/agent/conversation/model/options/${agentId}`,
    method: "GET",
  });
  return res;
}
