/**
 * BLE 通讯适配层 —— 平台无关契约（核心接口）
 *
 * 设计目标：
 *  - 平台无关：配网逻辑（useProvision）只面向本接口编程，不感知 uni.*BLE* / 鸿蒙 API。
 *  - Promise 化：一次性请求/响应用 Promise；事件流（扫到设备/notify/连接态）用注册式回调。
 *  - 可替换：Uni(Android/iOS) / Harmony(鸿蒙原生插件) / Mock 三实现同构，由工厂注入。
 */
import type {
  BleDeviceInfo,
  BleServiceInfo,
  BleCharacteristicInfo,
  BleNotifyCallback,
  BleConnectionStateCallback,
  BleDeviceFoundCallback,
} from '@/utils/ble/bleTypes';

/** 扫描配置 */
export class BleAdapterConfig {
  /** 扫描超时（毫秒） */
  scanTimeoutMs: number;
  /** 只扫描含该 service 的设备（占位 UUID，见 constants） */
  serviceUuidFilter: string;
  constructor(scanTimeoutMs: number, serviceUuidFilter: string) {
    this.scanTimeoutMs = scanTimeoutMs;
    this.serviceUuidFilter = serviceUuidFilter;
  }
}

/** 平台无关 BLE 契约 */
export interface BleAdapter {
  /** 打开/初始化蓝牙适配器；蓝牙关闭或无权限时 reject BleError */
  openAdapter(): Promise<void>;
  /** 关闭适配器并释放资源（页面销毁时调用） */
  closeAdapter(): Promise<void>;

  /** 开始扫描；发现的设备通过 onDeviceFound 回调逐个上报 */
  startScan(config: BleAdapterConfig): Promise<void>;
  /** 停止扫描（超时或手动） */
  stopScan(): Promise<void>;
  /** 注册扫描发现设备回调 */
  onDeviceFound(cb: BleDeviceFoundCallback): void;

  /** 连接设备（内部含连接超时）；失败 reject BleError(CONNECT_FAIL) */
  connect(deviceId: string, timeoutMs: number): Promise<void>;
  /** 断开连接 */
  disconnect(deviceId: string): Promise<void>;
  /** 注册连接状态变化回调 */
  onConnectionStateChange(cb: BleConnectionStateCallback): void;

  /** 发现服务（连接后调用一次） */
  discoverServices(deviceId: string): Promise<BleServiceInfo[]>;
  /** 发现某服务下的特征（用于防御性校验特征是否齐全） */
  discoverCharacteristics(deviceId: string, serviceUuid: string): Promise<BleCharacteristicInfo[]>;

  /** 订阅特征 notify（PROV_STATUS） */
  notify(deviceId: string, serviceUuid: string, charUuid: string, enable: boolean): Promise<void>;
  /** 注册 notify/read 数据回调 */
  onNotify(cb: BleNotifyCallback): void;

  /** 写特征（WIFI_SSID / WIFI_PASSWORD / COMMAND），value 为 UTF-8 字节或命令字节 */
  write(
    deviceId: string,
    serviceUuid: string,
    charUuid: string,
    value: ArrayBuffer,
    writeNoResponse: boolean,
  ): Promise<void>;
  /** 读特征（DEVICE_INFO / PROV_STATUS 主动读） */
  read(deviceId: string, serviceUuid: string, charUuid: string): Promise<ArrayBuffer>;
}
