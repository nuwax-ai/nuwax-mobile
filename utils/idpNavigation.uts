import { getApiBaseUrl } from "@/constants/config";
import { isAppWebViewEmbedded } from "@/utils/appWebViewDetect";
import { buildIdpAuthorizePath, mobileAuthWebReturn, resolvePendingAuthReturn, MOBILE_LOGIN_PATH } from "@/utils/authIdp";

/** 浏览器同源 Cookie 会话；原生容器和跨域开发环境保留原有登录。 */
export function canUseBrowserIdp(): boolean {
  // #ifdef H5 || WEB
  const base = getApiBaseUrl();
  return !isAppWebViewEmbedded() && (base.length == 0 || base == window.location.origin);
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

export function authBrowserOrigin(): string {
  // #ifdef H5 || WEB
  return window.location.origin;
  // #endif
  // #ifndef H5 || WEB
  return "";
  // #endif
}

export function authBrowserUserAgent(): string {
  // #ifdef H5 || WEB
  return navigator.userAgent;
  // #endif
  // #ifndef H5 || WEB
  return "";
  // #endif
}

/** null 表示不存在；hash 参数优先，读取参数不决定是否自动认证。 */
export function authBrowserQuery(name: string): string | null {
  // #ifdef H5 || WEB
  const hash = window.location.hash;
  const query = hash.includes("?") ? hash.substring(hash.indexOf("?") + 1).split("#")[0] : "";
  const hashQuery = new URLSearchParams(query);
  if (hashQuery.has(name)) return hashQuery.get(name);
  return new URLSearchParams(window.location.search).get(name);
  // #endif
  // #ifndef H5 || WEB
  return null;
  // #endif
}

export function beginBrowserIdp(providerId: string, requestedReturn: string, replace: boolean): boolean {
  if (!canUseBrowserIdp()) return false;
  const path = buildIdpAuthorizePath(providerId, requestedReturn, authBrowserOrigin());
  if (path.length == 0) return false;
  // #ifdef H5 || WEB
  try {
    if (replace) window.location.replace(path);
    else window.location.assign(path);
  } catch (_error) { return false; }
  // #endif
  return true;
}

/**
 * 只放行后端指定的首次关联页。站内 Tab / 业务页返回 false，由 redirectTo 按容器页分流。
 * @param requestedReturn 登录回跳地址
 * @returns 是否已经用浏览器跳转到关联页
 */
export function finishBrowserLogin(requestedReturn: string): boolean {
  if (!canUseBrowserIdp()) return false;
  const pending = resolvePendingAuthReturn(requestedReturn, authBrowserOrigin());
  if (pending.length == 0) return false;
  // #ifdef H5 || WEB
  window.location.replace(pending);
  // #endif
  return true;
}

/** 返回登录入口后继续按服务端自动认证配置处理。 */
export function idpLoginEntryUrl(requestedReturn: string): string {
  return MOBILE_LOGIN_PATH + "?redirect=" + encodeURIComponent(mobileAuthWebReturn(requestedReturn, authBrowserOrigin()));
}
