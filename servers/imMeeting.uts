/**
 * IM 实时会议请求层（对齐 PC `nuwax-im-web/src/api/index.ts` 的 meetingApi /
 * meetingPublicApi / meetingRecordApi，分支 feat-video-meeting）。
 *
 * ★为什么单独一个模块而不塞进 servers/im.uts：im.uts 已近 2000 行，会议是独立业务面，
 * 混进去后「会议 RTC 是否开启」这类开关判断会污染 IM 主链路。契约见
 * docs/integration/im-meeting-app-plan.md §7。
 *
 * ★★三条必读约束：
 * 1. **整组 rtc 端点由服务端开关 `im.meeting.enabled` 控制是否注册**——没开时是 **404**，
 *    调用方必须当成「音视频服务未开启」，不是网络错误（用 suppressNotFoundToast 静默探测）。
 * 2. **返回里的 token 是 LiveKit JWT**：只交给 SDK 的 connect，绝不 console.log、不上报、
 *    不写 storage（PC 侧同样纪律）。
 * 3. **所有 id 传字符串**（雪花号），路径参数一律 encodeURIComponent。
 */
import request from "./useRequest";
import { getImDeviceId, imDevicePlatform } from "./im";
import type { RequestResponse } from "@/types/interfaces/request";

/**
 * 会议数据变更广播（走 {@link eventBus}，**不要**改成 uni.$emit/$on）：
 * 发起/预约页保存成功后发一条，伙伴页「会议」tab 收到后静默重拉列表；消息页回页
 * （子包页退栈后）也补发一条。
 * ★用仓内 eventBus 而不是 uni 事件机制：App-Android 上经 uni.$on 注册的订阅者
 *   有「零触发」前科（见 utils/eventBus.uts 文件头的真机实证），而这里正是最需要
 *   可靠送达的一条广播——它决定「保存完回来能不能看到刚建的预约」。
 * ★走广播而不是「打开详情时传回调」——入口会越来越多（会话内会议卡片、邀请弹层），
 *   回调只能覆盖一条入口，漏掉的那条就留下「改了但列表没变」。
 */
export const IM_MEETING_CHANGED_EVENT = "im-meeting-changed";

const MEETING_RTC_BASE = "/api/instant-message/meetings/rtc";
const MEETING_PUBLIC_BASE = "/api/instant-message/meetings/public";
const MEETING_RECORD_BASE = "/api/instant-message/meetings";

function enc(value: string): string {
  // ★Kotlin 侧 encodeURIComponent 返回 String?：不补 !! 会报「返回类型不匹配」
  return encodeURIComponent(value)!!;
}

// ============================================================================
// 房间与令牌
// ============================================================================

/**
 * 创建会议房间（房主建房）。
 *
 * ★★origin=1 才在建房时落一条 im_meeting —— 这是「会议结束后会议记录里什么都没有」的修复开关；
 * 不传则与 1v1 通话房间一致（不落库）。会议栏发起一律传 1。
 * ★allowGuest 必须显式传：服务端缺省 true，不传等于对所有人开放游客入会。
 * ★shareSlug 预先在家生成（[a-z0-9]{8,32}）：建房前用户就能点「复制邀请」，
 * 那时没有 metadata 可读，链接里必须已经是最终值。
 */
export async function apiImMeetingCreateRoom(
  body: UTSJSONObject,
  suppressErrorToast: boolean = false,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms`,
    method: "POST",
    data: body,
    suppressErrorToast,
  });
}

/**
 * 结束会议（删房）：房内所有人立即被踢出，服务端同时停掉进行中的云端录制。
 *
 * ★★两种调用者都合法：主持人任何时候可结束；普通参会人**只有在房内已经没人时**才行
 * （这是「最后一人退出 ⇒ 会议自动结束」的实现）。所以自动散会必须在本地退房之后调。
 * ★房间已不存在返回 404，按「会议已结束」处理，不要弹错误。
 */
export async function apiImMeetingDeleteRoom(
  room: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}`,
    method: "DELETE",
    suppressErrorToast: true,
    suppressNotFoundToast: true,
  });
}

/**
 * 给自己签发入会令牌。platform 必填（identity=tenant:user:platform），
 * 同账号同平台同房间只有一个席位，后入者顶掉先入者——不要试图绕开。
 */
export async function apiImMeetingIssueToken(
  room: string,
  displayName: string,
  deviceId: string = "",
  passcode: string = "",
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/tokens`,
    method: "POST",
    data: {
      platform: imDevicePlatform(),
      deviceId: deviceId.length > 0 ? deviceId : getImDeviceId(),
      displayName,
      // ★设了密码才校验：无密码会议传空串无害，有密码会议不传会被服务端 401。
      passcode,
    },
  });
}

/** 续签令牌（长会 + 短 TTL 时用；断线重连优先重签而不是复用旧 token）。 */
export async function apiImMeetingRefreshToken(
  room: string,
  displayName: string = "",
  deviceId: string = "",
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/tokens/refresh`,
    method: "POST",
    data: {
      platform: imDevicePlatform(),
      deviceId: deviceId.length > 0 ? deviceId : getImDeviceId(),
      displayName,
    },
  });
}

// ============================================================================
// 会中成员与治理（服务端判权，客户端只控显隐）
// ============================================================================

/**
 * 在线成员列表（房主或在会成员都能看）。
 * ★实时数据不是快照：会中需要轮询兜底（LiveKit 事件为主，轮询为辅），
 * 但不要以轮询代替事件。
 */
export async function apiImMeetingParticipants(
  room: string,
  suppressErrorToast: boolean = true,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/participants`,
    method: "GET",
    suppressErrorToast,
  });
}

/**
 * 移出成员（仅房主）。不带 platform ⇒ 踢掉该用户全部平台席位。
 * ★幂等：目标已离开返回 kickedCount=0，不是错误。
 * ★游客没有 userId，target 传完整 identity。
 */
export async function apiImMeetingKick(
  room: string,
  target: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/participants/${enc(target)}`,
    method: "DELETE",
    suppressErrorToast: true,
  });
}

/**
 * 静音/取消静音（仅房主）。**轨道级**：只把对方当前音轨置 muted，
 * 对方可以自己重新开麦。要「禁止再说话」得改麦克风发布源权限。
 */
export async function apiImMeetingMuteParticipant(
  room: string,
  target: string,
  muted: boolean,
  source: string = "audio",
  trackSid: string = "",
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/participants/${enc(target)}/mute`,
    method: "POST",
    suppressErrorToast: true,
    data: {
      trackSid,
      source,
      muted,
    },
  });
}

/**
 * 全员静音（仅房主）：把除主持人外所有人（含游客）的麦克风静音。
 * ★语义同单点静音——只静音已发布轨道，对方仍可自行重开麦。
 * 需要「开不了麦」用 updateRoomSettings({ muteAll: true })。
 */
export async function apiImMeetingMuteAll(
  room: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/mute-all`,
    method: "POST",
  });
}

/** 改成员发布/订阅权限（仅房主），只覆盖传入的非 null 字段。 */
export async function apiImMeetingUpdatePermissions(
  room: string,
  target: string,
  body: UTSJSONObject,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/participants/${enc(target)}/permissions`,
    method: "PATCH",
    suppressErrorToast: true,
    data: body,
  });
}

/**
 * 会中开关（仅房主）：全员禁言 / 弹幕。只覆盖传入的非 null 字段。
 * 服务端写入房间 metadata ⇒ 房内全员立刻收到 RoomMetadataChanged，无需轮询。
 */
export async function apiImMeetingUpdateRoomSettings(
  room: string,
  muteAll: boolean | null,
  danmaku: boolean | null,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/settings`,
    method: "PATCH",
    data: {
      muteAll,
      danmaku,
    },
  });
}

// ============================================================================
// 云端录制（LiveKit Egress，仅房主）
// ============================================================================

/** 发起录制。同一房间同时只允许一个进行中录制。 */
export async function apiImMeetingStartRecording(
  room: string,
  body: UTSJSONObject,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/recordings`,
    method: "POST",
    data: body,
  });
}

/** 停止录制。★异步：返回时可能仍是 EGRESS_ACTIVE，必须轮询 getRecording 到 EGRESS_COMPLETE。 */
export async function apiImMeetingStopRecording(
  room: string,
  egressId: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/recordings/${enc(egressId)}`,
    method: "DELETE",
  });
}

/** 查询录制任务（房主或在会成员）。 */
export async function apiImMeetingGetRecording(
  room: string,
  egressId: string,
  suppressErrorToast: boolean = true,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/recordings/${enc(egressId)}`,
    method: "GET",
    suppressErrorToast,
  });
}

/** 列出房间下的录制任务。 */
export async function apiImMeetingListRecordings(
  room: string,
  suppressErrorToast: boolean = true,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/recordings`,
    method: "GET",
    suppressErrorToast,
  });
}

// ============================================================================
// 访客（免登录，/meetings/public —— 未登录也能调）
// ============================================================================

/** 入会前看一眼房间还在不在、几个人。★已结束返回 active=false，不是错误。 */
export async function apiImMeetingPublicRoom(
  room: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_PUBLIC_BASE}/rooms/${enc(room)}`,
    method: "GET",
  });
}

/** 凭昵称换访客令牌（identity=guest-{uuid}，platform=guest）。设了密码的会议必须带 passcode。 */
export async function apiImMeetingGuestToken(
  room: string,
  nickname: string,
  passcode: string = "",
  deviceId: string = "",
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_PUBLIC_BASE}/rooms/${enc(room)}/guest-token`,
    method: "POST",
    data: {
      nickname,
      deviceId: deviceId.length > 0 ? deviceId : getImDeviceId(),
      passcode,
    },
  });
}

/**
 * 同 publicRoom，但 **401/过期不触发全局登出**（suppressAuthRedirect）。
 * ★给会议卡片和会中状态轮询使用：展示「已结束」不需要登录态，
 * 若因一次 401 广播 auth-expired，用户会被从聊天里踢去登录。
 * ★查询失败时调用方保持原样（照旧显示"点击加入"），不编造状态。
 */
export async function apiImMeetingPublicRoomSafe(
  room: string,
): Promise<RequestResponse<any>> {
  return await request({
    suppressAuthRedirect: true,
    url: `${MEETING_PUBLIC_BASE}/rooms/${enc(room)}`,
    method: "GET",
    suppressErrorToast: true,
  });
}

// ============================================================================
// 共享占位（A10 抢占式投屏）
// ============================================================================

/**
 * ★★抢占共享占位（登录态）。语义是「我要接管」，**没有拒绝分支**——已有人在共享也照样夺锁。
 *
 * ★调用顺序必须是「先抢占成功、再开屏幕采集」：服务端默认把 screen_share 从发布源摘掉了，
 * 不先拿到 holder 身份就开采集，只会收到 NotAllowed（画面采到了却推不出去）。
 * ★失败 IM_30004 = 限流/正在切换（每人每 10 秒最多接管一次）→ 提示「正在切换共享，请再点一次」，
 * 不要当故障。
 */
export async function apiImMeetingTakeShareHolder(
  room: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/share-holder`,
    method: "POST",
  });
}

/** 释放共享占位（holder 本人或主持人）。★失败只 warn，本地仍要停采集——不能让网络抖动把用户卡在「共享中」。 */
export async function apiImMeetingReleaseShareHolder(
  room: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RTC_BASE}/rooms/${enc(room)}/share-holder`,
    method: "DELETE",
    suppressErrorToast: true,
  });
}

/**
 * 抢占共享占位（游客）。body 带游客入会令牌验签（游客没有 Cookie 登录态）。
 * ★必须静默鉴权失败：游客本就不需要登录，401 若广播 auth-expired 会把他踢去登录页。
 */
export async function apiImMeetingGuestTakeShareHolder(
  room: string,
  meetingToken: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_PUBLIC_BASE}/rooms/${enc(room)}/share-holder`,
    method: "POST",
    data: {
      token: meetingToken,
    },
    suppressErrorToast: true,
  });
}

/** 释放共享占位（游客）。★路径与方法为服务端定死：POST .../share-holder/release + body 带令牌。 */
export async function apiImMeetingGuestReleaseShareHolder(
  room: string,
  meetingToken: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_PUBLIC_BASE}/rooms/${enc(room)}/share-holder/release`,
    method: "POST",
    data: {
      token: meetingToken,
    },
    suppressErrorToast: true,
  });
}

// ============================================================================
// 会议记录（含通话录音）：客户端只能创建预约、取消预约、删除自己的关系
// ============================================================================

/**
 * 我的会议列表（口径=我参与过，被叫方也在内）。
 * ★beforeId 游标分页：传上一页最后一条的 id，首页不传。
 * ★不能只拉第一页就宣称历史齐全（PC 组件默认只取 30 条）。
 */
export async function apiImMeetingRecords(
  beforeId: string = "",
  limit: number = 20,
  suppressErrorToast: boolean = false,
): Promise<RequestResponse<any>> {
  return await request({
    url: MEETING_RECORD_BASE,
    method: "GET",
    data: {
      beforeId,
      limit,
    },
    suppressErrorToast,
  });
}

/** 会议详情（参会人才能看，服务端校验）。 */
export async function apiImMeetingRecordDetail(
  meetingId: string,
  suppressErrorToast: boolean = false,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/${enc(meetingId)}`,
    method: "GET",
    suppressErrorToast,
  });
}

/**
 * 现签录音地址（每次重新校验参会人身份、现签 10 分钟）。
 * ★expiresIn===0 是正常返回（生成中/失败/未配置存储），按 reason 展示「处理中」。
 */
export async function apiImMeetingRecordFileUrl(
  meetingId: string,
  fileId: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/${enc(meetingId)}/files/${enc(fileId)}/url`,
    method: "GET",
  });
}

/** 创建预约（落 im_meeting，status=0）。★没有时长字段，服务端统一写入。 */
export async function apiImMeetingSchedule(
  body: UTSJSONObject,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/schedules`,
    method: "POST",
    data: body,
  });
}

/** 取消预约（仅主持人，且仅未开始）。 */
export async function apiImMeetingCancelSchedule(
  meetingId: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/schedules/${enc(meetingId)}`,
    method: "DELETE",
  });
}

/**
 * 删除一条会议记录。
 * ★语义是删关系：主持人删的是会议本身（所有人都不再看到），其他参会人只删自己与记录的关系。
 * ★进行中的会议不允许删除——先「结束会议」。
 */
export async function apiImMeetingRemoveRecord(
  meetingId: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/${enc(meetingId)}`,
    method: "DELETE",
  });
}

// ============================================================================
// 入会设置（提前进入 / 入会密码，仅主持人）
// ============================================================================

/**
 * 修改入会设置。
 * ★joinPasscode 不传=不改密码，传空串=取消密码——只改开关时千万不要带它。
 */
export async function apiImMeetingUpdateJoinPolicy(
  meetingId: string,
  allowEarlyJoin: boolean | null,
  joinPasscode: string | null,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/${enc(meetingId)}/join-policy`,
    method: "POST",
    data: {
      allowEarlyJoin,
      joinPasscode,
    },
  });
}

/**
 * 查看入会密码明文（仅主持人）。按需拉取，不随列表/详情批量下发。
 * ★拿到空 passcode 不等于没设密码：看 requiresPasscode 区分「没设」与「还原不出来」。
 * ★失败一律静默：这是锦上添花的展示，不该因权限/网络把用户踢去登录页。
 */
export async function apiImMeetingPasscode(
  meetingId: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/${enc(meetingId)}/passcode`,
    method: "GET",
    suppressErrorToast: true,
  });
}

/** 同上，按房间名取（会中面板手里只有 roomName，没有 meetingId）。 */
export async function apiImMeetingPasscodeByRoom(
  room: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/rooms/${enc(room)}/passcode`,
    method: "GET",
    suppressErrorToast: true,
  });
}

// ============================================================================
// 回放分享（2026-11-09 起回放接口要求登录；令牌只决定「能打开哪场会」）
// ============================================================================

/** 查当前回放分享（仅主持人）。★没分享过是 normal 返回（token 空、active=false），不是 404。 */
export async function apiImMeetingGetReplayShare(
  meetingId: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/${enc(meetingId)}/replay-share`,
    method: "GET",
    suppressErrorToast: true,
  });
}

/**
 * 生成回放分享链接（仅主持人，会议须已结束且有可播录制）。
 * ★有效期变了会重新生成、旧链接立即失效；有效期相同则幂等返回同一 token。
 */
export async function apiImMeetingCreateReplayShare(
  meetingId: string,
  body: UTSJSONObject,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/${enc(meetingId)}/replay-share`,
    method: "POST",
    data: body,
  });
}

/** 撤销回放分享（仅主持人）。★撤销后已发出的链接立刻不可用。 */
export async function apiImMeetingRevokeReplayShare(
  meetingId: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/${enc(meetingId)}/replay-share`,
    method: "DELETE",
  });
}

/**
 * 回放页元信息（标题/时间/时长/可播文件/分句转写）。
 * ★需要登录；失效/过期统一按 MEETING_NOT_FOUND 处理。
 */
export async function apiImMeetingPublicReplay(
  token: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_PUBLIC_BASE}/replays/${enc(token)}`,
    method: "GET",
    suppressErrorToast: true,
  });
}

/**
 * 现签回放文件地址。download=false 走 inline（页面内播放），true 走 attachment（落盘）。
 * ★expiresIn===0 是正常返回（生成中/存储未配置），按 reason 提示「处理中」。
 * ★分享链接是「可以看」不是「可以拿走」：服务端只在 download=1 且有权时给 downloadUrl。
 */
export async function apiImMeetingPublicReplayFileUrl(
  token: string,
  fileId: string,
  download: boolean = false,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_PUBLIC_BASE}/replays/${enc(token)}/files/${enc(fileId)}/url`,
    method: "GET",
    data: download ? { download: 1 } : { download: 0 },
    suppressErrorToast: true,
  });
}

// ============================================================================
// 说话人识别
// ============================================================================

/** 人工确认「说话人 N 是谁」（仅主持人，整体替换；空数组=清空，退回自动预填/「说话人 N」）。 */
export async function apiImMeetingSetSpeakerNames(
  meetingId: string,
  body: UTSJSONObject,
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/${enc(meetingId)}/transcript/speakers`,
    method: "PUT",
    data: body,
  });
}

/** 手动重试失败的转写（仅主持人）。transcriptId 可省略——本场只有一条失败记录时服务端自动选中。 */
export async function apiImMeetingRetryTranscript(
  meetingId: string,
  transcriptId: string = "",
): Promise<RequestResponse<any>> {
  const qs = transcriptId.length > 0 ? `?transcriptId=${enc(transcriptId)}` : "";
  return await request({
    url: `${MEETING_RECORD_BASE}/${enc(meetingId)}/transcript/retry${qs}`,
    method: "POST",
  });
}

/**
 * 会中「我什么时候说了话」批量上报（每 8 秒一批）。
 * ★按 roomName 定位会议（入会时只有房间名）；重复上报由服务端唯一键幂等过滤，失败可安全忽略。
 */
export async function apiImMeetingReportSpeakerEvents(
  roomName: string,
  events: UTSJSONObject[],
): Promise<RequestResponse<any>> {
  return await request({
    url: `${MEETING_RECORD_BASE}/speaker-events`,
    method: "POST",
    data: {
      roomName,
      events,
    },
    suppressErrorToast: true,
  });
}

// ============================================================================
// 会议邀请跨端已处理
// ============================================================================

/**
 * 会议邀请「忽略 / 已加入」的跨端同步。
 * ★路径在 /calls/ 前缀下（历史原因），语义只是「通知自己的其余设备收起邀请面板」，
 * 邀请人收不到。不要因为路径叫 calls 就把通话模块拉进会议范围。
 */
export async function apiImMeetingInviteHandled(
  convId: string,
  msgId: string,
  inviteId: string = "",
  roomName: string = "",
  suppressErrorToast: boolean = true,
): Promise<RequestResponse<any>> {
  return await request({
    url: "/api/instant-message/calls/meeting-invite-handled",
    method: "POST",
    data: {
      convId,
      msgId,
      inviteId,
      roomName,
    },
    suppressErrorToast,
  });
}
