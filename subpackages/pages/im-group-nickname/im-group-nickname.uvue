<template>
  <view class="gnick-page">
    <safety-zone />

    <!-- 顶部：返回 + 标题 + 保存 -->
    <view class="gnick-header">
      <view class="gnick-header__btn" hover-class="gnick-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="gnick-header__title-wrap">
        <text class="gnick-header__title">{{ t("Mobile.Message.myGroupNickLabel") }}</text>
      </view>
      <!-- 右槽放保存胶囊（替代群管理页的 ghost 占位） -->
      <view class="gnick-save" hover-class="gnick-save--active" @click="handleSave">
        <text class="gnick-save__text">{{ saving ? t("Mobile.Page.loadingMore") : t("Mobile.Common.save") }}</text>
      </view>
    </view>

    <scroll-view class="gnick-body" direction="vertical" :show-scrollbar="false">
      <!-- 昵称编辑：预填当前值；留空保存=清除（回落平台昵称，与群名「空串报错」语义相反） -->
      <view class="gnick-card">
        <input
          class="gnick-input"
          v-model="draft"
          :maxlength="64"
          :placeholder="t('Mobile.Message.myGroupNickPlaceholder')"
          placeholder-style="color:#b0aebc"
        />
      </view>
      <view class="gnick-tail" />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { switchMainTab } from "@/utils/mainTabNavigation";

  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiImConvSetMyNickName } from "@/servers/im";
  import { apiResCode, apiResMessage } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ===== 页面入参 =====
  const convId = ref<string>("");
  /** 编辑草稿（初值=入参 nick 预填当前值，免一次详情请求）。 */
  const draft = ref<string>("");

  // ===== 页面态 =====
  const saving = ref<boolean>(false);

  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  /** 保存并返回：trim 后整串提交（纯空格=清除回落平台昵称）；data=false 值没变仍是成功码。 */
  async function handleSave(): Promise<void> {
    if (saving.value || convId.value.length == 0) {
      return;
    }
    saving.value = true;
    try {
      const res = await apiImConvSetMyNickName(convId.value, draft.value.trim());
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Profile.saveSuccess"), icon: "none" });
        // 等 toast 露出再退（设置页 onShow 静默刷新 cell 值）；成功分支不复位 saving 防胶囊闪回
        setTimeout(() => {
          uni.navigateBack({ delta: 1 });
        }, 300);
        return;
      }
      uni.showToast({ title: apiResMessage(res), icon: "none" });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
    saving.value = false;
  }

  function handleBack(): void {
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      switchMainTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    draft.value = readOption(options, "nick");
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架 ===== */
  .gnick-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #f6f5fb;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  .gnick-header {
    flex-shrink: 0;
    height: 108rpx;
    padding: 0 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(250, 249, 253, 0.92);
    border-bottom: 2rpx solid rgba(81, 71, 255, 0.1);
  }

  .gnick-header__btn {
    width: 72rpx;
    height: 72rpx;
    border-radius: 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gnick-header__btn--active {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .gnick-header__title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .gnick-header__title {
    font-size: 33rpx;
    line-height: 46rpx;
    font-weight: 600;
    color: #17171a;
  }

  /* ===== 保存胶囊（照抄群管理页 gs-save 三件套） ===== */
  .gnick-save {
    flex-shrink: 0;
    padding: 8rpx 20rpx;
    border-radius: 24rpx;
    background-color: rgba(81, 71, 255, 0.08);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .gnick-save--active {
    background-color: rgba(81, 71, 255, 0.16);
  }

  .gnick-save__text {
    font-size: 25rpx;
    line-height: 36rpx;
    font-weight: 600;
    color: #5147ff;
  }

  .gnick-body {
    flex: 1;
    min-height: 0;
    padding: 28rpx 32rpx;
  }

  .gnick-card {
    padding: 0 28rpx;
    background-color: #ffffff;
    border: 2rpx solid #ecebf1;
    border-radius: 20rpx;
    display: flex;
    flex-direction: column;
  }

  /* 昵称输入框：逐字照抄群管理页 gs-name-input（height 与 line-height 成对，无条件编译） */
  .gnick-input {
    height: 92rpx;
    padding: 0;
    font-size: 30rpx;
    line-height: 42rpx;
    color: #22212a;
  }

  .gnick-tail {
    height: 40rpx;
  }
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
