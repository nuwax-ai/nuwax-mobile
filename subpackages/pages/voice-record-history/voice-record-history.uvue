<template>
  <view class="vh-page">
    <safety-zone />
    <view class="vh-nav">
      <view class="vh-nav__side" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="22" unit="px" color="#1a1a1a" />
      </view>
      <text class="vh-nav__title">历史记录</text>
      <view class="vh-nav__side"></view>
    </view>
    <scroll-view class="vh-list" scroll-y="true">
      <view v-for="item in records" :key="item.id" class="vh-card">
        <view class="vh-card__head">
          <text class="vh-card__title">{{ item.title }}</text>
          <view class="vh-card__download" @click="handleDownload(item)">
            <svg-icon name="icon-msg-download" size="20" unit="px" color="#5b4dff" />
          </view>
        </view>
        <text class="vh-card__meta">时长 {{ item.duration }} · {{ item.recordedAt }}</text>
        <view class="vh-card__file">
          <svg-icon name="icon-a-Filetext" size="16" unit="px" color="#7a78e6" />
          <text class="vh-card__path">{{ item.detail }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
/**
 * 录音历史。数据来自本机缓存的语音笔记（noteId、分段路径、上传状态）。
 * 转写成功后点卡片打开资料库文档。
 */
import { listCachedVoiceNotes } from "@/utils/voiceNoteEngine.uts";
import { VoiceNoteRecord } from "@/utils/voiceNoteStore.uts";

type VoiceRecordHistoryItem = {
  id: string;
  title: string;
  duration: string;
  recordedAt: string;
  detail: string;
  docUrl: string;
};

const records = ref<VoiceRecordHistoryItem[]>([]);

function pad2(n: number): string {
  if (n < 10) return "0" + n.toString();
  return n.toString();
}

function formatDuration(ms: number): string {
  const safe = ms < 0 ? 0 : ms;
  const totalSec = Math.floor(safe / 1000);
  const sec = totalSec % 60;
  const min = Math.floor(totalSec / 60);
  return pad2(min) + ":" + pad2(sec);
}

function formatClock(ts: number): string {
  if (ts <= 0) return "";
  const d = new Date(ts);
  return (
    d.getFullYear() +
    "-" +
    pad2(d.getMonth() + 1) +
    "-" +
    pad2(d.getDate()) +
    " " +
    pad2(d.getHours()) +
    ":" +
    pad2(d.getMinutes())
  );
}

function phaseLabel(record: VoiceNoteRecord): string {
  if (record.phase == "recording") return "录音中";
  if (record.phase == "uploading") return "上传中";
  if (record.phase == "processing") return "转写中";
  if (record.phase == "success") return "已完成";
  if (record.phase == "failed") return "失败";
  if (record.phase == "stopped") return "已停止";
  return record.phase;
}

function detailOf(record: VoiceNoteRecord): string {
  let uploaded = 0;
  const total = record.segments.length;
  let path = "";
  for (let i = 0; i < total; i++) {
    const row = record.segments[i];
    if (row.uploadStatus == "uploaded") uploaded = uploaded + 1;
    if (path.length == 0 && row.filePath.length > 0) path = row.filePath;
  }
  let text = phaseLabel(record) + " · " + uploaded + "/" + total + " 段已上传";
  if (record.noteId.length > 0) text = text + " · noteId " + record.noteId;
  if (record.docUrl.length > 0) text = text + " · " + record.docUrl;
  if (path.length > 0) text = text + " · " + path;
  if (record.error.length > 0) text = text + " · " + record.error;
  return text;
}

function loadRecords(): void {
  const rows = listCachedVoiceNotes();
  const next: VoiceRecordHistoryItem[] = [];
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    const title = row.title.length > 0 ? row.title : "语音笔记 " + formatClock(row.startedAt);
    const item: VoiceRecordHistoryItem = {
      id: row.localId,
      title: title,
      duration: formatDuration(row.elapsedMs),
      recordedAt: formatClock(row.startedAt),
      detail: detailOf(row),
      docUrl: row.docUrl,
    };
    next.push(item);
  }
  records.value = next;
}

function handleBack(): void {
  uni.navigateBack({ delta: 1 });
}

function handleDownload(item: VoiceRecordHistoryItem): void {
  if (item.docUrl.length == 0) {
    uni.showToast({ title: "文档还未生成", icon: "none" });
    return;
  }
  uni.navigateTo({
    url: "/subpackages/pages/webview/webview?url=" + encodeURIComponent(item.docUrl) + "&title=" + encodeURIComponent(item.title),
  });
}

onShow(() => {
  loadRecords();
});
</script>

<style lang="scss" scoped>
.vh-page {
  flex: 1;
  background-color: #f4f5f7;
}

.vh-nav {
  height: 88rpx;
  flex-direction: row;
  align-items: center;
  padding: 0 8rpx;
}

.vh-nav__side {
  width: 88rpx;
  height: 88rpx;
  justify-content: center;
  padding-left: 16rpx;
}

.vh-nav__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.vh-list {
  flex: 1;
  padding: 8rpx 24rpx 32rpx 24rpx;
}

.vh-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.vh-card__head {
  flex-direction: row;
  align-items: flex-start;
}

.vh-card__title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  lines: 2;
}

.vh-card__download {
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.vh-card__meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9a9aa2;
}

.vh-card__file {
  margin-top: 20rpx;
  flex-direction: row;
  align-items: center;
  background-color: #f3f2fb;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}

.vh-card__path {
  flex: 1;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #6a68b8;
  lines: 1;
}
</style>
