import { nextTick } from 'vue'
import { MessageInfo } from '@/types/interfaces/conversationInfo'
import { MsgItem } from '@/types/interfaces/ai-msg'
import { StringAnyRecord } from '@/types/interfaces/common'
import AgentDetailData from './AgentDetailData.uts'
import { ChatDataAdapter } from '@/utils/chatDataAdapter.uts'
import { orArray, orEmpty } from '@/utils/utsCoalesce.uts'

/**
 * 组件管理层：负责组件的引用管理和更新
 * Android：StringAnyRecord 运行时是 Map，禁止 as UTSJSONObject / UTSJSONObject.keys
 */
export default class ComponentManager {
	private data: AgentDetailData;
	constructor(data: AgentDetailData) {
		this.data = data;
	}

	/** 将 messageRefs 规范为 Map（Android Record = Map） */
	private refsAsMap(): Map<string, any | null> {
		const refs = this.data.messageRefs.value
		try {
			const m = refs as Map<string, any | null>
			if (m != null) {
				return m
			}
		} catch (_e) {
			// fallthrough
		}
		// 非 Map 时迁移到新 Map，避免后续 keys/as UTSJSONObject
		const next = new Map<string, any | null>()
		this.data.messageRefs.value = next as any as StringAnyRecord
		return next
	}

	/**
	 * 设置消息组件引用
	 * Vue ref 回调在卸载时会传 null；Android 上 el 必须声明为可空，否则进方法前 NPE
	 */
	setMessageRef(el: any | null, messageId: string): void {
		if (messageId == null || messageId.length == 0) {
			return
		}
		if (el == null) {
			this.removeMessageRef(messageId)
			return
		}
		this.refsAsMap().set(messageId, el)
	}

	/**
	 * 移除消息组件引用
	 */
	removeMessageRef(messageId: string): void {
		const m = this.refsAsMap()
		if (m.get(messageId) == null) {
			return
		}
		m.delete(messageId)
	}

	private triggerMessageListRefresh(): void {
		this.data.messageList.value = [...this.data.messageList.value]
	}

	/**
	 * 更新消息组件
	 * Android：组件实例不能 as UTSJSONObject，统一走列表刷新
	 */
	async updateMessageComponent(messageId: string, newData: any): Promise<void> {
		if (this.refsAsMap().get(messageId) == null) {
			return
		}
		try {
			await nextTick()
			this.triggerMessageListRefresh()
		} catch (error) {
			console.error(`更新消息组件 ${messageId} 失败:`, error)
		}
	}

	/**
	 * 将MessageInfo转换为MsgItem格式
	 */
	convertMessageInfoToMsgItem(messageInfo: MessageInfo): MsgItem {
		const msgItem = ChatDataAdapter.convertToMsgItem(messageInfo)
		msgItem.chat_id = 'chat-' + this.data.conversationId.value
		msgItem.thinkContent = orEmpty(messageInfo.think)
		msgItem.processingList = orArray<any>(messageInfo.processingList)
		return msgItem
	}
}
