    justify-content: center;

    &-active {
      opacity: 0.7;
    }

    .unbind-btn-text {
      font-size: 30rpx;
      color: #dd524d;
      font-weight: 600;
    }
  }

  /* 监控内容编辑弹窗 */
  .content-popup-mask {
    position: fixed;
    z-index: 1000;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .content-popup {
    width: 80%;
    background-color: #ffffff;
    border-radius: 20rpx;
    overflow: hidden;
  }

  .content-popup-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 30rpx;
    border-bottom: 2rpx solid #f0f0f0;
  }

  .content-popup-title {
    flex: 1;
    font-size: 32rpx;
    font-weight: 600;
    color: #15171f;
  }

  .content-popup-close {
    width: 48rpx;
