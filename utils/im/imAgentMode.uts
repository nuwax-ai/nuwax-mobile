/**
 * 群内智能体的「衔接模式」（服务端 DEV-271，本文件对齐 PC nuwax-im-web
 * src/lib/agentMode.ts）—— **纯逻辑**，页面只拿它判「渲染哪一态 / 调哪个端点」。
 *
 * ┃模式 ┃IM 什么时候把群消息发给它 ┃它的回复从哪来
 * ┃1 唤起（默认）┃只有 @ 了它（或 @所有人）的那一条 ┃智能体自己调 IM 内部 RPC 发回群
 * ┃2 监听 ┃群里**每一条**消息 ┃同上（IM 不代发）
 *
 * ★★2（监听）是一个**花钱开关**：群里每一条消息都会触发一次平台模型调用。所以：
 *   ① 缺省值恒为「唤起」（与服务端缺省同源）；
 *   ② 切到监听必须有确认说明（见群成员页的二次确认弹窗）；
 *   ③ 任何「待提交的模式」在换会话/关弹窗时必须复位成默认——添加弹窗
 *      （add-buddy-sheet）的 openForGroup 即按此复位。
 *
 * ★★「这一行是不是智能体」的唯一判据 = 服务端下发了 agentMode。
 *   ConversationMemberDto **没有** subjectType，而本仓硬纪律是「判是不是智能体只认
 *   服务端字段、绝不按 id 段位猜」。服务端把 agentMode 做成了二值标记：
 *   **智能体行恒有值**（1 或 2）、**真人行键不出现**（non_null ⇒ 端上读到空）。
 *   ⇒ 判据只能写 `mode > 0`，**不能**写 `mode == 1`（后者把「处于唤起的智能体」
 *   和真人判成同一类，真人行会因此拿到一个服务端会拒（IM_90001）的控件）。
 */

/** 唤起：被 @ 时才发给它（默认，省成本）。 */
export const AGENT_MODE_MENTION: number = 1;
/** 监听：群里每一条消息都发给它 ⇒ 每条一次真实模型调用。 */
export const AGENT_MODE_LISTEN: number = 2;
/** 非智能体行（服务端未下发 agentMode）。仅端内行模型的缺省值，**不是**服务端取值。 */
export const AGENT_MODE_NONE: number = 0;

/** 默认模式 = 唤起（添加弹窗初值 / 读到意外值时归一都走它，勿各写一个 1）。 */
export const AGENT_MODE_DEFAULT: number = AGENT_MODE_MENTION;

/** 这一行是不是群内智能体（判据见文件头第二节）。 */
export function isAgentMemberMode(mode: number): boolean {
  return mode > 0;
}

/**
 * 归一成合法模式（1/2）：非智能体行恒按默认「唤起」；意外值（服务端将来加第三值）
 * 也归到唤起 —— 那是**不花钱**的一侧。真出现第三值时本文件与界面必须一起改，
 * 那是契约变更，不是这里能兜住的。
 */
export function normalizeAgentMode(mode: number): number {
  return mode == AGENT_MODE_LISTEN ? AGENT_MODE_LISTEN : AGENT_MODE_MENTION;
}

/** 模式的 i18n 文案键（标签与切换项共用，勿在页面另写一份文案）。 */
export function agentModeLabelKey(mode: number): string {
  return normalizeAgentMode(mode) == AGENT_MODE_LISTEN
    ? "Mobile.Message.agentModeListen"
    : "Mobile.Message.agentModeMention";
}

/**
 * 我能不能改这个智能体的衔接模式（与服务端 setAgentMode 判据逐字对齐，三选一）：
 *   ① 群主 / 管理员（myRole >= 2）；
 *   ② **把这个智能体拉进群的人**（agentInviterId == 我）——需求点名的可配置者，
 *      而他可能既不是群主也不是管理员；
 *   ③ 其余一律 false（服务端报 IM_30001）。
 *
 * ★agentInviterId 为空有两种含义：真人行（前面 isAgentMemberMode 已挡住）；
 *   或**存量智能体的绑定行是懒补出来的**、不知道是谁拉的 —— 后者只剩群主/管理员能改，
 *   这是诚实的降级（编一个 inviter 出来会让普通成员拿到一个服务端会拒的控件）。
 *
 * ★这里只决定**给不给控件**，服务端才是权限权威：判错在「多给」会被服务端挡住并
 *   toast；判错在「少给」则**无声**（用户只是看不到这个选项），所以宁可按服务端口径。
 */
export function canSetAgentMode(
  mode: number,
  myRole: number,
  agentInviterId: string,
  viewerId: string,
): boolean {
  if (!isAgentMemberMode(mode)) {
    return false;
  }
  if (myRole >= 2) {
    return true;
  }
  // 雪花号一律字符串比较（>$2^53 不能进 number；服务端已按字符串读出）
  if (viewerId.length == 0 || agentInviterId.length == 0) {
    return false;
  }
  return agentInviterId == viewerId;
}
