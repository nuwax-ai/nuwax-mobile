import { localText } from "@/utils/i18nLocalText";
/**
 * 受保护文件 URL 鉴权拉取与打开
 * 对齐 nuwax Web 版 authProtectedFileUrl.ts
 * pathname 用字符串切分，避免 App/Kotlin 不支持 Web URL 与可选链。
 */
import { getApiBaseUrl } from "@/constants/config";
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { jumpToFilePreviewPage } from "@/utils/system.uts";
import { applyXClientTypeHeader, isAppWebViewEmbedded, readAppWebViewHostPlatform } from "@/utils/appWebViewDetect";
import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

const AUTH_PROTECTED_FILE_PATH_RE = /\/api\/f\//i;

function isHttpUrl(url: string): boolean {
  return url.indexOf("http://") == 0 || url.indexOf("https://") == 0;
}

/**
 * 从 URL 中提取 pathname（去掉协议、host、query、hash）。
 * 不依赖 Web URL API，兼容 App/Kotlin。
 */
function extractPathname(url: string): string {
  let path = url;
  const hashIdx = path.indexOf("#");
  if (hashIdx >= 0) {
    path = path.substring(0, hashIdx);
  }
  const queryIdx = path.indexOf("?");
  if (queryIdx >= 0) {
    path = path.substring(0, queryIdx);
  }
  if (isHttpUrl(path)) {
    const protoIdx = path.indexOf("://");
    const afterProto = path.substring(protoIdx + 3);
    const slashIdx = afterProto.indexOf("/");
    if (slashIdx >= 0) {
      return afterProto.substring(slashIdx);
    }
    return "/";
  }
  if (path.length == 0) {
    return "/";
  }
  if (path.indexOf("/") != 0) {
    return `/${path}`;
  }
  return path;
}

export function extractFileNameFromUrl(url: string): string {
  const path = extractPathname(url);
  const lastSlash = path.lastIndexOf("/");
  if (lastSlash >= 0 && lastSlash < path.length - 1) {
    return path.substring(lastSlash + 1);
  }
  return "download";
}

/** 判断 URL 是否为需 Bearer 鉴权才能加载的文件地址。 */
export function isAuthProtectedFileUrl(url: string): boolean {
  if (url.length == 0) {
    return false;
  }
  const trimmed = url.trim();
  if (trimmed.length == 0) {
    return false;
  }
  return AUTH_PROTECTED_FILE_PATH_RE.test(extractPathname(trimmed));
}

/** 将相对或绝对文件 URL 规范化为可请求的完整地址。 */
export function resolveAuthProtectedFileFetchUrl(url: string): string {
  if (isHttpUrl(url)) {
    return url;
  }
  const normalizedPath = url.indexOf("/") == 0 ? url : `/${url}`;
  return `${getApiBaseUrl()}${normalizedPath}`;
}

function buildProtectedFileHeaders(includeClientType: boolean): UTSJSONObject {
  const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
  const token = tokenRaw != null ? `${tokenRaw}` : "";
  const header = {} as UTSJSONObject;
  if (token.length > 0) {
    header["Authorization"] = `Bearer ${token}`;
  }
  if (includeClientType == true) applyXClientTypeHeader(header);
  return header;
}

/** header 键名小写副本（鸿蒙 downloadFile 专用，见 buildAuthProtectedFileHeaders）。 */
function lowerCaseHeaderKeys(header: UTSJSONObject): UTSJSONObject {
  const out = {} as UTSJSONObject;
  const keys = UTSJSONObject.keys(header);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const value = header[key];
    if (value != null) {
      out[`${key}`.toLowerCase()] = `${value}`;
    }
  }
  return out;
}

/** 构造受保护文件请求所需的 Bearer 头（供 downloadFile / request 复用）。 */
export function buildAuthProtectedFileHeaders(): UTSJSONObject {
  const header = buildProtectedFileHeaders(true);
  // #ifdef APP-HARMONY
  // 鸿蒙 uni.downloadFile 未像 runtime request 那样把 header 键名 toLowerCase
  //（runtime uni-network/index.ets：downloadFile 直接把 header 交给
  // http.requestInStream，而 request 实现里有显式小写化）。鸿蒙
  // http.HttpRequestOptions.header 要求键名小写，大写 Authorization /
  // X-Client-Type 会被忽略 → 受保护 /api/f/ 文件 401 → 图片整段下载必失败
  //（<image> 只剩灰块，2026-11-02 真机排查确认下载链路为本端唯一出入）。
  // 下载专用 header 一律小写；HTTP 头名大小写不敏感，其他端行为不变。
  return lowerCaseHeaderKeys(header);
  // #endif
  // #ifndef APP-HARMONY
  return header;
  // #endif
}

/** 从绝对 URL 提取 pathname，供 file-preview 使用。 */
export function extractPathnameFromRemoteUrl(url: string): string {
  return extractPathname(url);
}

/**
 * 受保护文件换 ak 流式直链（对齐 PC 端 /api/file/ak/refresh 契约）：
 * GET {base}/api/file/ak/refresh?url=<encodeURIComponent(pathname)> →
 * data = 原地址 + ?ak=<临时签名>。访问该地址 302 到对象存储（s3p）流输出，
 * Range 206 已验证——可直接喂 <video>/<audio> 渐进播放，免去整段下载。
 * 接口匿名可调（ak 即短期凭证），仍带 Bearer 兼容后续收紧鉴权。
 * 非 200 / 非 0000 / data 非法一律 reject，由调用方自行回落旧下载路径。
 */
export function fetchAuthProtectedFileAkUrl(url: string): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    const encodedPath = encodeURIComponent(extractPathname(url));
    const fetchUrl = `${getApiBaseUrl()}/api/file/ak/refresh?url=${encodedPath}`;
    uni.request({
      url: fetchUrl,
      method: "GET",
      header: buildProtectedFileHeaders(false),
      success: (res) => {
        if (res.statusCode != 200) {
          console.error(`[AkUrl] refresh statusCode=${res.statusCode} url=${fetchUrl}`);
          reject(new Error(localText("Mobile.Error.fileAuthStatus").replaceAll("{status}", `${res.statusCode}`)));
          return;
        }
        // App 端 uni.request 会把 JSON 预解析成 UTSJSONObject；万一按文本返回
        // （对齐 useRequest 口径：Android Gson 对非 JSON 抛异常 UTS catch 拦不住，
        // 先按首字符预检再 parse），本响应无 int64，无精度问题。
        let body: any | null = res.data as any | null;
        if (typeof body == "string") {
          const text = `${body}`.trim();
          if (text.length == 0 || !(text.indexOf("{") == 0 || text.indexOf("[") == 0)) {
            console.error(`[AkUrl] refresh 非JSON正文 url=${fetchUrl}`);
            reject(new Error(localText("Mobile.Error.fileAuthNotJson")));
            return;
          }
          body = JSON.parse(text);
        }
        const obj = body as UTSJSONObject | null;
        const code = obj != null ? obj["code"] : null;
        const dataVal = obj != null ? obj["data"] : null;
        const akUrl = dataVal != null ? `${dataVal}` : "";
        if (code != null && `${code}` == "0000" && (akUrl.indexOf("https://") == 0 || akUrl.indexOf("http://") == 0)) {
          resolve(akUrl);
          return;
        }
        console.error(`[AkUrl] refresh 响应非法 code=${code != null ? `${code}` : ""} url=${fetchUrl}`);
        reject(new Error(localText("Mobile.Error.fileAuthInvalid")));
      },
      fail: (err) => {
        console.error(`[AkUrl] refresh fail url=${fetchUrl}`, err);
        reject(new Error(err.errMsg != null ? err.errMsg : "ak refresh fail"));
      },
    });
  });
}

// #ifdef H5 || WEB
let protectedImageRequestSeq = 0;
const protectedImageCallbacks = new Map<string, (url: string) => void>();

/** Android WebView 的 fetch 会把 Bearer 转发到 302 后的对象存储，必须由原生侧读取 Location。 */
function fetchAndroidProtectedImageRedirect(url: string): Promise<string> {
  return new Promise((resolve, reject) => {
    protectedImageRequestSeq += 1;
    const requestId = `${Date.now()}-${protectedImageRequestSeq}`;
    const w = window as any;
    w.__nuwaxProtectedImageResult = (result: any): void => {
      const obj = result as UTSJSONObject;
      const idRaw = obj["requestId"];
      const id = idRaw != null ? `${idRaw}` : "";
      const callback = protectedImageCallbacks.get(id);
      if (callback != null) callback(obj["url"] != null ? `${obj["url"]}` : "");
    };
    let attempts = 0;
    let postTimer = 0;
    const timeout = setTimeout((): void => {
      protectedImageCallbacks.delete(requestId);
      if (postTimer != 0) clearTimeout(postTimer);
      reject(new Error(localText("Mobile.Error.imageRedirectTimeout")));
    }, 12000);
    protectedImageCallbacks.set(requestId, (directUrl: string): void => {
      protectedImageCallbacks.delete(requestId);
      clearTimeout(timeout);
      if (postTimer != 0) clearTimeout(postTimer);
      if (directUrl.indexOf('https://') == 0) resolve(directUrl);
      else reject(new Error(localText("Mobile.Error.imageRedirectFailed")));
    });
    const post = (): void => {
      const payload = { "data": { "type": "protected-image-url", "requestId": requestId, "url": url } };
      try {
        const uniGlobal = w.uni;
        if (uniGlobal != null && uniGlobal.webView != null && uniGlobal.webView.postMessage != null) {
          uniGlobal.webView.postMessage(payload);
          return;
        }
        if (w.__uniapp_x_postMessage != null) {
          w.__uniapp_x_postMessage(payload);
          return;
        }
        if (w.__uniapp_x_ != null && w.__uniapp_x_.postMessage != null) {
          w.__uniapp_x_.postMessage(JSON.stringify(payload));
          return;
        }
      } catch (_e) {
        // JSSDK 尚未就绪时重试。
      }
      attempts += 1;
      if (attempts < 30) postTimer = setTimeout(post, 100);
    };
    post();
  });
}

/**
 * H5 用 arraybuffer + blob URL，避免 uni.downloadFile 读取 Content-Disposition。
 * 该头不在 CORS 白名单，跨域未 Expose 时浏览器会报 Refused to get unsafe header。
 */
function resolveHeaderMimeType(headers: any | null): string {
  if (headers == null) {
    return "application/octet-stream";
  }
  const obj = headers as UTSJSONObject;
  let ct = obj["content-type"];
  if (ct == null) {
    ct = obj["Content-Type"];
  }
  if (ct != null && `${ct}`.length > 0) {
    return `${ct}`;
  }
  return "application/octet-stream";
}

function fetchAuthProtectedFileAsObjectUrl(
  fetchUrl: string,
  header: UTSJSONObject,
): Promise<string> {
  return new Promise((resolve, reject) => {
    uni.request({
      url: fetchUrl,
      method: "GET",
      header,
      responseType: "arraybuffer",
      // 默认 dataType=json 会尝试 JSON.parse，二进制封面会失败
      dataType: "text",
      success: (res) => {
        if (res.statusCode == 200 && res.data != null) {
          const mimeType = resolveHeaderMimeType(res.header);
          const blob = new Blob([res.data as ArrayBuffer], { type: mimeType });
          resolve(URL.createObjectURL(blob));
          return;
        }
        reject(new Error());
      },
      fail: (err) => {
        reject(err);
      },
    });
  });
}
// #endif

// #ifndef H5 || WEB
/**
 * App 端受保护图片下载防护三件套（2026-10-07 半截图标事故）：
 * 1) 同 URL 并发去重：冷启动列表会对同一头像并发发起多次 downloadFile，
 *    实测运行时并发落盘出过恰好 8KB 整块倍数的截断/垃圾尾文件；
 * 2) 落盘完整性校验：PNG 必须以 IEND 结尾、JPG 尾部须有 EOI、GIF 尾 0x3B——
 *    截断 PNG 会被 image 组件增量解码只画上半截且不触发 @error，必须绑定前拦下；
 * 3) 校验失败删临时文件重下（至多 3 次、间隔 300ms），当次会话内自愈，不必等重启。
 * 网络失败保持单次语义不在此重试，由调用方原有重试机制兜底。
 */
const PROTECTED_IMAGE_MAX_DOWNLOAD_ATTEMPTS = 3;
const PROTECTED_IMAGE_RETRY_DELAY_MS = 300;
const protectedImageInflight = new Map<string, Promise<string>>();

function delayProtectedImageRetry(ms: number): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    setTimeout((): void => {
      resolve(true);
    }, ms);
  });
}

function unlinkTempQuiet(filePath: string): void {
  try {
    uni.getFileSystemManager().unlink({
      filePath: filePath,
      fail: (_e) => {},
    });
  } catch (_eUnlink) {
    // 尽力删除，失败不影响重下
  }
}

/** PNG 尾 8 字节必须是 IEND 块类型 + CRC：49 45 4E 44 AE 42 60 82。 */
function isPngTailIntact(bytes: Uint8Array): boolean {
  const len = bytes.length;
  if (len < 12) {
    return false;
  }
  return (
    bytes[len - 8] == 0x49 &&
    bytes[len - 7] == 0x45 &&
    bytes[len - 6] == 0x4e &&
    bytes[len - 5] == 0x44 &&
    bytes[len - 4] == 0xae &&
    bytes[len - 3] == 0x42 &&
    bytes[len - 2] == 0x60 &&
    bytes[len - 1] == 0x82
  );
}

/** JPG 整段倒扫查 FF D9（EOI）；整段都没有 = 落盘被截断，交给重下。
 *
 *  ★不能只看尾 64 字节（2026-11-02 真机）：鸿蒙相机出的是「动态照片」，主图 EOI 之后
 *  还附了几百 KB 的副数据（MPF/运动照片段），尾 64 字节里根本没有 EOI → 被误判成半截
 *  图反复删掉重下，表现为「拍照发送必灰块、相册图正常」。整段倒扫不会误判：JPEG 熵编码
 *  数据做了字节填充（0xFF 后必是 0x00），FF D9 只可能是真正的 EOI 标记。 */
function isJpgTailIntact(bytes: Uint8Array): boolean {
  const len = bytes.length;
  if (len < 4) {
    return false;
  }
  let i = len - 2;
  while (i >= 0) {
    if (bytes[i] == 0xff && bytes[i + 1] == 0xd9) {
      return true;
    }
    i--;
  }
  return false;
}

/** GIF 尾 0x3B。 */
function isGifTailIntact(bytes: Uint8Array): boolean {
  const len = bytes.length;
  if (len < 6) {
    return false;
  }
  return bytes[len - 1] == 0x3b;
}

/** 读落盘文件做头/尾完整性校验；识别不了的一律放行保持旧行为。 */
function isLocalImageFileIntact(filePath: string): boolean {
  try {
    const data = uni.getFileSystemManager().readFileSync(filePath, null);
    if (data instanceof ArrayBuffer) {
      const bytes = new Uint8Array(data as ArrayBuffer);
      const len = bytes.length;
      if (len == 0) {
        return false;
      }
      if (len >= 4 && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4e && bytes[3] == 0x47) {
        return isPngTailIntact(bytes);
      }
      if (len >= 2 && bytes[0] == 0xff && bytes[1] == 0xd8) {
        return isJpgTailIntact(bytes);
      }
      if (len >= 4 && bytes[0] == 0x47 && bytes[1] == 0x49 && bytes[2] == 0x46 && bytes[3] == 0x38) {
        return isGifTailIntact(bytes);
      }
    }
    return true;
  } catch (_e) {
    // 读不出来不拦截，维持旧的失败链路
    return true;
  }
}

function downloadProtectedFileOnce(fetchUrl: string, header: UTSJSONObject): Promise<string> {
  return new Promise((resolve, reject) => {
    let settled = false;
    // #ifdef APP-HARMONY
    // 鸿蒙 downloadFile 偶发 success/fail 都不回调（promise 悬挂，2026-10-27 头像链
    // 实测；2026-11-02 真机复现「发送图片灰块、点按预览失败」）。挂空闲看门狗：
    // 8s 无进度无回调视为悬挂，abort 掉任务——abort 会触发 fail 回调、promise 正常
    // reject，inflight 登记随之释放，外层重试才能拿到全新下载；abort 后运行时仍
    // 不回调的极端情形再兜底 reject，promise 不许永久悬挂。
    let downloadTask: DownloadTask | null = null;
    let watchdogTimer = 0;
    const settle = (): void => {
      if (watchdogTimer != 0) {
        clearTimeout(watchdogTimer);
        watchdogTimer = 0;
      }
    };
    const armWatchdog = (): void => {
      settle();
      watchdogTimer = setTimeout((): void => {
        if (settled) return;
        if (downloadTask != null) {
          try {
            downloadTask.abort();
          } catch (_eAbort) {
            // abort 抛异常也继续走兜底 reject
          }
        }
        // abort 应触发 fail 回调；500ms 后仍无回调则直接兜底 reject
        setTimeout((): void => {
          if (settled) return;
          settled = true;
          reject(new Error("downloadFile watchdog abort (no callback)"));
        }, 500);
      }, 8000);
    };
    armWatchdog();
    // #endif
    const task = uni.downloadFile({
      url: fetchUrl,
      header,
      success: (res) => {
        if (settled) return;
        settled = true;
        // #ifdef APP-HARMONY
        settle();
        // #endif
        const tempPath = res.tempFilePath;
        if (res.statusCode == 200 && tempPath != null && tempPath.length > 0) {
          resolve(tempPath);
          return;
        }
        // 非 200（如 302→对象存储带 Bearer 被拒的 4xx）：logcat 抓 [ChatImg] 定位
        console.error(
          `[ChatImg] downloadFile statusCode=${res.statusCode} temp=${tempPath != null ? tempPath : ""} url=${fetchUrl}`,
        );
        reject(new Error());
      },
      fail: (err) => {
        if (settled) return;
        settled = true;
        // #ifdef APP-HARMONY
        settle();
        // #endif
        console.error(
          `[ChatImg] downloadFile fail: ${err.errMsg != null ? err.errMsg : ""} url=${fetchUrl}`,
        );
        reject(err);
      },
    });
    // #ifdef APP-HARMONY
    downloadTask = task;
    // 进度事件即活性信号：重置看门狗，慢网大图不会被误杀，只有真悬挂才 abort
    task.onProgressUpdate((_res) => {
      if (settled) return;
      armWatchdog();
    });
    // #endif
  });
}

async function downloadProtectedImageWithIntegrityCheck(
  fetchUrl: string,
  header: UTSJSONObject,
): Promise<string> {
  for (let attempt = 1; attempt <= PROTECTED_IMAGE_MAX_DOWNLOAD_ATTEMPTS; attempt++) {
    if (attempt > 1) {
      await delayProtectedImageRetry(PROTECTED_IMAGE_RETRY_DELAY_MS);
    }
    const tempPath = await downloadProtectedFileOnce(fetchUrl, header);
    if (isLocalImageFileIntact(tempPath)) {
      return tempPath;
    }
    console.warn(
      "[ChatImg] integrity check fail, will retry attempt=" + attempt + " path=" + tempPath + " url=" + fetchUrl,
    );
    unlinkTempQuiet(tempPath);
  }
  throw new Error("protected image download corrupt after retries url=" + fetchUrl);
}

// #ifdef APP-HARMONY
/**
 * 鸿蒙受保护文件取址：ak 直链 + 无鉴权下载。
 *
 * 为什么不直接 Bearer 下载 /api/f/…：该地址会 302 到对象存储，鸿蒙 http 跟随
 * 重定向时把原请求头（含 Authorization: Bearer …）一并转发到对象存储，S3 见到
 * 非 SigV4 的 Authorization 直接回 400 Bad Request——2026-11-02 真机日志实证：
 * `downloadFile statusCode=400`，三次重试全 400（其他端 OkHttp/NSURLSession 在
 * 跨主机重定向时会丢掉鉴权头，故不受影响；鸿蒙 App 端图片恒为灰块）。
 * 改走 ak：/api/file/ak/refresh 换出带临时签名的 ?ak= 直链（uni.request 走 runtime
 * 的小写化实现，鉴权正常），再用**不带鉴权头**的 downloadFile 拉取——302 到对象
 * 存储时凭的是预签名参数，S3 认签名即可。
 * 返回空串 = 失败，由调用方回落原址下载（兼容不 302 私服部署）。
 */
function fetchProtectedDisplayUrlViaAkOnHarmony(url: string): Promise<string> {
  return new Promise<string>((resolve) => {
    fetchAuthProtectedFileAkUrl(url).then((akUrl: string): void => {
      uni.downloadFile({
        url: akUrl,
        // ★不传任何鉴权头：重定向后请求头同样被转发，Bearer 正是 400 的直接原因
        header: {} as UTSJSONObject,
        success: (res) => {
          const tempPath = res.tempFilePath;
          if (res.statusCode == 200 && tempPath != null && tempPath.length > 0) {
            // 落盘不完整（动态照片等格式带附加数据已由整段倒扫兼容）时放弃这份，
            // 由调用方回落原址下载重取
            if (isLocalImageFileIntact(tempPath)) {
              resolve(tempPath);
              return;
            }
          }
          resolve("");
        },
        fail: (_err) => {
          resolve("");
        },
      });
    }).catch((_e: any | null): void => {
      resolve("");
    });
  });
}
// #endif

function fetchProtectedImageDisplayUrlOnApp(fetchUrl: string, header: UTSJSONObject): Promise<string> {
  // #ifdef APP-HARMONY
  // 先走 ak 无鉴权下载（见 fetchProtectedDisplayUrlViaAkOnHarmony），失败再回落原址整段下载。
  // 同 URL 并发共享一次任务（10-07 截断事故的同一个护栏：并发落盘竞争会互相覆盖）
  const inflightAk = protectedImageInflight.get(fetchUrl);
  if (inflightAk != null) {
    return inflightAk;
  }
  const akTask = fetchProtectedDisplayUrlViaAkOnHarmony(fetchUrl).then(
    (tempPath: string): Promise<string> => {
      if (tempPath.length > 0) {
        return Promise.resolve(tempPath);
      }
      return downloadProtectedImageWithIntegrityCheck(fetchUrl, header);
    },
  );
  protectedImageInflight.set(fetchUrl, akTask);
  akTask.then((_path: string) => {
    protectedImageInflight.delete(fetchUrl);
  }).catch((_err) => {
    protectedImageInflight.delete(fetchUrl);
  });
  return akTask;
  // #endif
  // #ifndef APP-HARMONY
  const inflight = protectedImageInflight.get(fetchUrl);
  if (inflight != null) {
    return inflight;
  }
  const task = downloadProtectedImageWithIntegrityCheck(fetchUrl, header);
  protectedImageInflight.set(fetchUrl, task);
  // 结束后移除登记；期间同 URL 的并发请求共享同一任务，不再重复落盘
  task.then((_path: string) => {
    protectedImageInflight.delete(fetchUrl);
  }).catch((_err) => {
    protectedImageInflight.delete(fetchUrl);
  });
  return task;
  // #endif
}
// #endif

/**
 * 拉取受保护文件并返回可用于 image 组件展示的本地/temp 地址。
 */
export function fetchAuthProtectedFileDisplayUrl(url: string): Promise<string> {
  const fetchUrl = resolveAuthProtectedFileFetchUrl(url);
  // #ifdef H5 || WEB
  if (isAppWebViewEmbedded() == true && readAppWebViewHostPlatform() == 'android') {
    return fetchAndroidProtectedImageRedirect(fetchUrl);
  }
  // /api/f/ 图片会重定向到对象存储，其 CORS 白名单不含 X-Client-Type。
  // 保留 Bearer 鉴权，避免浏览器把额外请求头带到重定向目标导致预检失败。
  const header = buildProtectedFileHeaders(false);
  // #endif
  // #ifndef H5 || WEB
  const header = buildAuthProtectedFileHeaders();
  // #endif

  // #ifdef H5 || WEB
  return fetchAuthProtectedFileAsObjectUrl(fetchUrl, header);
  // #endif

  // #ifndef H5 || WEB
  return fetchProtectedImageDisplayUrlOnApp(fetchUrl, header);
  // #endif
}

// 注：不要再新增「先 downloadFile 再交给 SVG 处理」的组合助手——受保护 SVG 落成本地
// file:// 后无法再取文本，Android / iOS 会退回原生 1:1 光栅化导致显示异常。
// 需要同时处理受保护文件与远程 SVG 时，请用 utils/remoteSvgImage 的 resolveDisplayImageUrl。

/**
 * 下载非 200 后回捞后端失败原因：uni.downloadFile 不暴露响应体，用同 URL
 * 同请求头以默认 JSON 模式重发一次，读错误体 message 字段（后端错误体口径
 * {code, message}，fileTree 小程序分支同款）；非 JSON 体（网关 HTML 错误页）、
 * 网络挂、无 message 一律返回空串，由调用方落兜底文案。
 */
function fetchRemoteFailReason(fetchUrl: string, header: UTSJSONObject): Promise<string> {
  return new Promise<string>((resolve) => {
    uni.request({
      url: fetchUrl,
      method: "GET",
      header,
      success: (res) => {
        let reason = "";
        try {
          if (res.data != null) {
            const obj = res.data as UTSJSONObject;
            const msg = obj["message"];
            if (msg != null) {
              reason = `${msg}`;
            }
          }
        } catch (_e) {
          // 非 JSON 错误体（网关 HTML 错误页等）：无后端原因可取
        }
        resolve(reason);
      },
      fail: (_err) => {
        resolve("");
      },
    });
  });
}

/** 下载失败 toast：有后端原因优先展示原因，否则兜底「下载失败，请重试」。 */
function toastDownloadFail(reason: string): void {
  uni.showToast({
    title: reason.length > 0 ? reason : t("Mobile.Terminal.downloadFailed"),
    icon: "none",
    duration: 3000,
  });
}

/** 文件打开失败 toast（下载已成功、系统查看器打不开，与下载失败区分）。 */
function toastOpenFileFail(): void {
  uni.showToast({
    title: t("Mobile.Intervention.McpAsk.openFileFailed"),
    icon: "none",
    duration: 3000,
  });
}

/**
 * 打开或下载远程文件。
 * 受保护地址带 Bearer 下载；若提供 conversationId 则跳转预览页（附 source=im）。
 * 预览页按 source=im 走「只预览文件」路径、不调智能体域 /api/agent/conversation/share
 * （IM convId 在该接口必报 conversation not found）——改造落地前的过渡期会白屏+报错。
 * failToast=true 时失败提示由本函数内部弹出（downloadFileInApp 同款约定）：
 * 非 200 回捞后端 message 优先、无原因兜底「下载失败，请重试」；调用方不必再 toast。
 */
export function openRemoteFileUrl(
  url: string,
  fileName: string = "",
  conversationId: string = "",
  failToast: boolean = false,
): Promise<void> {
  const resolvedName =
    fileName.length > 0 ? fileName : extractFileNameFromUrl(url);

  if (conversationId.length > 0 && isAuthProtectedFileUrl(url)) {
    const path = extractPathnameFromRemoteUrl(url);
    jumpToFilePreviewPage(`${conversationId}`, path, "im");
    return Promise.resolve();
  }

  if (isAuthProtectedFileUrl(url)) {
    const fetchUrl = resolveAuthProtectedFileFetchUrl(url);
    const header = buildAuthProtectedFileHeaders();
    uni.showLoading({ title: "" });

    // #ifdef H5 || WEB
    return new Promise((resolve, reject) => {
      fetchAuthProtectedFileAsObjectUrl(fetchUrl, header)
        .then((objectUrl: string) => {
          uni.hideLoading();
          const link = document.createElement("a");
          link.href = objectUrl;
          link.download = resolvedName;
          link.target = "_blank";
          link.click();
          resolve();
        })
        .catch((err) => {
          uni.hideLoading();
          if (failToast) {
            fetchRemoteFailReason(fetchUrl, header).then((reason: string) => {
              toastDownloadFail(reason);
            });
          }
          reject(err);
        });
    });
    // #endif

    // #ifndef H5 || WEB
    return new Promise((resolve, reject) => {
      uni.downloadFile({
        url: fetchUrl,
        header,
        success: (res) => {
          uni.hideLoading();
          const tempPath = res.tempFilePath;
          if (res.statusCode == 200 && tempPath != null && tempPath.length > 0) {
            uni.openDocument({
              filePath: tempPath,
              success: () => {
                resolve();
              },
              fail: (err) => {
                if (failToast) {
                  toastOpenFileFail();
                }
                reject(err);
              },
            });
            return;
          }
          // 非 200：downloadFile 不暴露响应体，补一发 JSON 请求回捞后端 message
          fetchRemoteFailReason(fetchUrl, header).then((reason: string) => {
            if (failToast) {
              toastDownloadFail(reason);
            }
            reject(new Error(reason));
          });
        },
        fail: (err) => {
          uni.hideLoading();
          if (failToast) {
            toastDownloadFail("");
          }
          reject(err);
        },
      });
    });
    // #endif
  }

  return new Promise((resolve, reject) => {
    // #ifdef H5 || WEB
    window.open(url, "_blank");
    resolve();
    // #endif
    // #ifdef MP || APP-PLUS || APP-ANDROID || APP-IOS
    uni.downloadFile({
      url,
      success: (res) => {
        const tempPath = res.tempFilePath;
        if (res.statusCode == 200 && tempPath != null && tempPath.length > 0) {
          uni.openDocument({
            filePath: tempPath,
            success: () => {
              resolve();
            },
            fail: (err) => {
              if (failToast) {
                toastOpenFileFail();
              }
              reject(err);
            },
          });
        } else {
          // 非 200：同 URL 补发 JSON 请求回捞后端 message（非受保护地址多为
          // 网关/对象存储直链，错误体常为 XML/HTML，取不到自然落兜底文案）
          fetchRemoteFailReason(url, new UTSJSONObject()).then((reason: string) => {
            if (failToast) {
              toastDownloadFail(reason);
            }
            reject(new Error(reason));
          });
        }
      },
      fail: (err) => {
        if (failToast) {
          toastDownloadFail("");
        }
        reject(err);
      },
    });
    // #endif
  });
}

/**
 * 打开受保护链接（聊天里的链接/文件附件点击）：期望「打开页面」而非「下载」。
 * 带 conversationId（会话内点击）且为 /api/f/ 受保护文件时，优先跳文件预览页
 *   （与聊天文件树一致）——系统文档查看器打不开 .md 等纯文本类文件，预览页
 *   才是会话内文件的统一渲染面，H5 / App 同此路由。跳转附 source=im 标记，
 *   预览页据此走「只预览文件」路径、不调智能体域 /api/agent/conversation/share
 *   换 shareKey（IM convId 在该接口必报 conversation not found）——预览页侧
 *   改造落地前的过渡期此处会白屏+报错，属已知状态。
 * H5：点击手势内同步先开空白新页（异步 fetch 后再 window.open 会被当弹窗拦截），
 *   带 Bearer 拉取成功后把新页指向 blob 地址——浏览器可渲染的类型（html/pdf/txt…）
 *   直接展示，不可渲染的（zip 等）由浏览器自然回落为下载；新页被拦截时退回下载。
 * App：维持 openRemoteFileUrl 语义（下载后交系统文档查看器打开）。
 */
export function openAuthProtectedLinkUrl(
  url: string,
  fileName: string = "",
  conversationId: string = "",
): Promise<void> {
  if (conversationId.length > 0 && isAuthProtectedFileUrl(url)) {
    const path = extractPathnameFromRemoteUrl(url);
    jumpToFilePreviewPage(`${conversationId}`, path, "im");
    return Promise.resolve();
  }

  // #ifndef H5 || WEB
  return openRemoteFileUrl(url, fileName, conversationId);
  // #endif

  // #ifdef H5 || WEB
  const fetchUrl = resolveAuthProtectedFileFetchUrl(url);
  const header = buildAuthProtectedFileHeaders();
  uni.showLoading({ title: "" });
  return new Promise((resolve, reject) => {
    // 同步先占住新页：保住用户手势，避免异步 fetch 后开页被浏览器拦截
    const opened = window.open("", "_blank");
    fetchAuthProtectedFileAsObjectUrl(fetchUrl, header)
      .then((objectUrl: string) => {
        uni.hideLoading();
        if (opened != null) {
          opened.location.href = objectUrl;
        } else {
          // 新页被拦截：退回下载语义
          const link = document.createElement("a");
          link.href = objectUrl;
          link.download = extractFileNameFromUrl(url);
          link.click();
        }
        resolve();
      })
      .catch((err) => {
        uni.hideLoading();
        if (opened != null) {
          opened.close();
        }
        reject(err);
      });
  });
  // #endif
}

/** 释放调用方独占的 H5 图片对象地址；普通 URL/App 临时路径不处理。 */
export function releaseDisplayImageUrl(url: string): void {
  // #ifdef H5 || WEB
  if (url.startsWith("blob:")) URL.revokeObjectURL(url);
  // #endif
}
