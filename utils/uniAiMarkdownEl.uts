import type { UniAiMarkdownElItem } from '@/uni_modules/uni-ai-x/types.uts'
import type { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'

/**
 * 将任意 markdown 元素转为 UniAiMarkdownElItem。
 * Android 上项目 markdownElItem 与 UniAiMarkdownElItem 是不同 class，不能互 cast。
 */
export function toUniAiMarkdownElItem(raw: any): UniAiMarkdownElItem {
  const o = raw as UTSJSONObject
  const uniqueIdVal = o['uniqueId']
  const typeVal = o['type']
  const datasListVal = o['datasList']
  const datasList =
    datasListVal != null ? (datasListVal as MarkdownToken[][]) : ([] as MarkdownToken[][])
  const item: UniAiMarkdownElItem = {
    uniqueId: uniqueIdVal != null ? `${uniqueIdVal}` : '',
    type: typeVal != null ? `${typeVal}` : '',
    datasList: datasList,
  }
  return item
}

/** 批量转为 UniAiMarkdownElItem[]，供 uni-ai-x-msg 渲染 */
export function toUniAiMarkdownElList(raw: any | null): UniAiMarkdownElItem[] {
  if (raw == null) {
    return [] as UniAiMarkdownElItem[]
  }
  const list = raw as any[]
  if (list.length == 0) {
    return [] as UniAiMarkdownElItem[]
  }
  const result = [] as UniAiMarkdownElItem[]
  for (let i = 0; i < list.length; i++) {
    result.push(toUniAiMarkdownElItem(list[i]))
  }
  return result
}
