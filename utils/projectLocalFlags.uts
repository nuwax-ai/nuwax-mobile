/**
 * 项目本地标记（置顶 / 归档 / 收藏）——过渡方案，对齐：
 * - PC ProjectPanel（置顶/归档/收藏后端接口开发中，组件内本地 state）
 * - 移动端既有 utils/conversationLocalFlags.uts 的存储结构。
 *
 * 后端项目字段（isPinned / isArchived / isCollected）就绪后，
 * 在本模块单点替换为服务端字段读写，调用方（抽屉列表层）无需改动。
 *
 * 存储：uni storage key `project_local_flags`；
 * 结构 {version:1, pinned:number[], archived:number[], collected:number[]}。
 * 项目 id 一律归一为 number。
 */
import { ProjectGroupView } from "@/utils/projectGroupProjection.uts";

const PROJECT_LOCAL_FLAGS_KEY = "project_local_flags";
const PROJECT_LOCAL_FLAGS_VERSION = 1;

export const PROJECT_FLAG_PINNED = "pinned";
export const PROJECT_FLAG_ARCHIVED = "archived";
export const PROJECT_FLAG_COLLECTED = "collected";

export class ProjectLocalFlags {
  pinned: number[] = [] as number[];
  archived: number[] = [] as number[];
  collected: number[] = [] as number[];
}

function readIdList(source: UTSJSONObject | null, key: string): number[] {
  const out: number[] = [] as number[];
  if (source == null) return out;
  const raw = source[key];
  if (raw == null || Array.isArray(raw) != true) return out;
  const arr = raw as any[];
  for (let i = 0; i < arr.length; i++) {
    const value = arr[i];
    if (value == null) continue;
    const n = parseFloat(`${value}`);
    // n != n 判 NaN（UTS 无 isNaN）
    if (n != n) continue;
    out.push(n as number);
  }
  return out;
}

/** 读取本地标记（解析失败/无数据返回空标记，不抛错）。 */
export function loadProjectFlags(): ProjectLocalFlags {
  const flags = new ProjectLocalFlags();
  try {
    const raw = uni.getStorageSync(PROJECT_LOCAL_FLAGS_KEY);
    if (raw == null) return flags;
    const text = `${raw}`;
    if (text.length == 0) return flags;
    const parsed = JSON.parse(text);
    if (parsed == null || typeof parsed != "object") return flags;
    const obj = parsed as UTSJSONObject;
    flags.pinned = readIdList(obj, "pinned");
    flags.archived = readIdList(obj, "archived");
    flags.collected = readIdList(obj, "collected");
  } catch (_e) {
    // 容错：坏数据当空处理
  }
  return flags;
}

function saveProjectFlags(flags: ProjectLocalFlags): void {
  try {
    const obj = new UTSJSONObject();
    obj["version"] = PROJECT_LOCAL_FLAGS_VERSION;
    obj["pinned"] = flags.pinned;
    obj["archived"] = flags.archived;
    obj["collected"] = flags.collected;
    uni.setStorageSync(PROJECT_LOCAL_FLAGS_KEY, JSON.stringify(obj));
  } catch (_e) {
    // 写失败静默（本地标记非关键数据）
  }
}

function flagListOf(flags: ProjectLocalFlags, kind: string): number[] {
  if (kind == PROJECT_FLAG_ARCHIVED) return flags.archived;
  if (kind == PROJECT_FLAG_COLLECTED) return flags.collected;
  return flags.pinned;
}

export function hasProjectFlag(
  kind: string,
  id: number,
  flags: ProjectLocalFlags | null = null,
): boolean {
  const target = flags != null ? flags : loadProjectFlags();
  const list = flagListOf(target, kind);
  for (let i = 0; i < list.length; i++) {
    if (list[i] == id) return true;
  }
  return false;
}

/**
 * 切换标记并持久化。
 * @return 切换后的状态（true = 已开启该标记）
 */
export function toggleProjectFlag(kind: string, id: number): boolean {
  const flags = loadProjectFlags();
  const list = flagListOf(flags, kind);
  let exists = false;
  const next: number[] = [] as number[];
  for (let i = 0; i < list.length; i++) {
    if (list[i] == id) {
      exists = true;
      continue;
    }
    next.push(list[i]);
  }
  if (exists != true) {
    next.push(id);
  }
  if (kind == PROJECT_FLAG_ARCHIVED) {
    flags.archived = next;
  } else if (kind == PROJECT_FLAG_COLLECTED) {
    flags.collected = next;
  } else {
    flags.pinned = next;
  }
  saveProjectFlags(flags);
  return exists != true;
}

/** 删除项目时清理三组标记中的残留 id。 */
export function clearProjectFlags(id: number): void {
  const flags = loadProjectFlags();
  const hadAny =
    flags.pinned.indexOf(id) >= 0 ||
    flags.archived.indexOf(id) >= 0 ||
    flags.collected.indexOf(id) >= 0;
  if (hadAny != true) return;
  const filterIds = (list: number[]): number[] => {
    const next: number[] = [] as number[];
    for (let i = 0; i < list.length; i++) {
      if (list[i] != id) {
        next.push(list[i]);
      }
    }
    return next;
  };
  flags.pinned = filterIds(flags.pinned);
  flags.archived = filterIds(flags.archived);
  flags.collected = filterIds(flags.collected);
  saveProjectFlags(flags);
}

// ---------------------------------------------------------------------------
// 列表 selector（供抽屉 computed 与单测复用；输入列表保持原相对顺序）
// ---------------------------------------------------------------------------

/** 默认视图：过滤掉已归档项目（保持原顺序）。 */
export function filterActiveProjects(
  list: ProjectGroupView[],
  flags: ProjectLocalFlags,
): ProjectGroupView[] {
  const out: ProjectGroupView[] = [] as ProjectGroupView[];
  for (let i = 0; i < list.length; i++) {
    if (flags.archived.indexOf(list[i].id) >= 0) continue;
    out.push(list[i]);
  }
  return out;
}

/** 已归档视图：只保留已归档项目（保持原顺序）。 */
export function filterArchivedProjects(
  list: ProjectGroupView[],
  flags: ProjectLocalFlags,
): ProjectGroupView[] {
  const out: ProjectGroupView[] = [] as ProjectGroupView[];
  for (let i = 0; i < list.length; i++) {
    if (flags.archived.indexOf(list[i].id) >= 0) {
      out.push(list[i]);
    }
  }
  return out;
}

/**
 * 置顶稳定排序：置顶项目置前，组内保持原相对顺序
 * （双数组拼接实现，规避 UTS sort 稳定性问题，对齐 conversationLocalFlags）。
 */
export function sortProjectsByPinned(
  list: ProjectGroupView[],
  flags: ProjectLocalFlags,
): ProjectGroupView[] {
  const pinned: ProjectGroupView[] = [] as ProjectGroupView[];
  const normal: ProjectGroupView[] = [] as ProjectGroupView[];
  for (let i = 0; i < list.length; i++) {
    if (flags.pinned.indexOf(list[i].id) >= 0) {
      pinned.push(list[i]);
    } else {
      normal.push(list[i]);
    }
  }
  const out: ProjectGroupView[] = pinned;
  for (let i = 0; i < normal.length; i++) {
    out.push(normal[i]);
  }
  return out;
}

export function countArchivedProjects(
  list: ProjectGroupView[],
  flags: ProjectLocalFlags,
): number {
  let count = 0;
  for (let i = 0; i < list.length; i++) {
    if (flags.archived.indexOf(list[i].id) >= 0) {
      count++;
    }
  }
  return count;
}
