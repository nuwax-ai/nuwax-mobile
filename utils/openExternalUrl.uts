// #ifdef APP-ANDROID
import { openPayUrlNative } from "@/uni_modules/nuwax-android-native-pay";
// #endif

// #ifdef APP-HARMONY
import type { Want } from "@kit.AbilityKit";
// #endif

// #ifdef APP-IOS
import { openIosExternalUrl } from "@/uni_modules/nuwax-ios-open-url";
// #endif

/**
 * 更新地址是否允许打开。
 * Android、鸿蒙只接受 http(s)。iOS 的租户配置已直接下发 itms-apps://，不再从网页地址改写。
 */
export function isOpenableExternalUrl(url: string): boolean {
  if (url.startsWith("https://") || url.startsWith("http://")) {
    return true;
  }
  // #ifdef APP-IOS
  if (url.startsWith("itms-apps://")) {
    return true;
  }
  // #endif
  return false;
}

/**
 * 使用系统打开外部链接。更新地址由租户配置下发，按平台原样打开。
 */
export function openExternalUrl(url: string): Promise<void> {
  if (isOpenableExternalUrl(url) != true) {
    return Promise.reject(new Error());
  }

  // #ifdef APP-ANDROID
  return openPayUrlNative(url).then((): void => {});
  // #endif

  // #ifdef APP-IOS
  // 业务 uts 在 iOS 上编成 JavaScript，没有 URL / UIApplication。系统打开放在 iOS 插件里。
  if (openIosExternalUrl(url) != true) {
    return Promise.reject(new Error());
  }
  return Promise.resolve();
  // #endif

  // #ifdef APP-HARMONY
  const context = UTSHarmony.getUIAbilityContext();
  const want: Want = {
    action: "ohos.want.action.viewData",
    entities: ["entity.system.browsable"],
    uri: url,
  };
  return context.startAbility(want);
  // #endif

  // #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
  return Promise.reject(new Error());
  // #endif
}
