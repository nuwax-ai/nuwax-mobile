<template>
  <view class="acp-permission-card" v-if="interaction && !isSubmitted">
    <!-- 标题区 -->
    <view class="card-header">
      <view class="card-title-wrap">
        <text class="card-eyebrow">{{ eyebrowText }}</text>
        <text class="card-title">{{ title }}</text>
      </view>
    </view>

    <!-- 失败状态标签；提交成功后整张卡片直接关闭 -->
    <view
      v-if="isFailed"
      class="status-tag status-failed"
    >
      <svg-icon name="icon-waring" customClass="status-icon status-icon-failed" />
      <text class="status-tag-text">{{
        statusErrorMessage
      }}</text>
    </view>

    <!-- 文件写入/编辑预览：对齐 PC 端，审批前展示路径与代码差异 -->
    <view v-if="permissionDiffItems.length > 0" class="permission-diff-block">
      <view class="permission-diff-summary">
        <text class="permission-diff-path">{{
          primaryPermissionDiffPath
        }}</text>
        <view class="permission-diff-stats">
          <text class="permission-diff-added"
            >+{{ permissionDiffAdded }}</text
          >
          <text class="permission-diff-removed"
            >-{{ permissionDiffRemoved }}</text
          >
        </view>
      </view>
      <scroll-view
        class="permission-diff-preview"
        direction="vertical"
        :show-scrollbar="false"
      >
        <diff-content-view :diffLinesList="primaryPermissionDiffLines" />
      </scroll-view>
    </view>

    <!-- 选项区（单击选中，不直接提交）-->
    <view
      class="card-actions"
      v-if="showActionArea"
    >
      <view
        v-for="(option, index) in visibleOptions"
        :key="option.optionId"
        class="card-action-item"
        :class="{ 'item-active': activeIndex === index }"
        @tap="setActiveIndex(index)"
      >
        <view class="option-index">
          <text class="option-index-text">{{ index + 1 }}</text>
        </view>
        <text class="option-label">{{ getOptionLabel(option) }}</text>
      </view>
    </view>

    <!-- Footer：取消 + 确认（对齐 PC 端两步流程）-->
    <view
      class="card-footer"
      v-if="showActionArea"
    >
      <l-button
        class="footer-cancel-btn"
        type="default"
        variant="light"
        size="small"
        radius="16rpx"
        :disabled="isCancelDisabled"
        :loading="isCancelLoading"
        @click="handleCancel"
      >
        {{ rejectOnceText }}
      </l-button>
      <l-button
        class="footer-confirm-btn"
        type="primary"
        size="small"
        radius="16rpx"
        :disabled="isConfirmDisabled"
        :loading="isConfirmLoading"
        @click="handleConfirm"
      >
        {{ confirmText }}
      </l-button>
    </view>
  </view>
</template>

<script lang="uts">
  /**
   * ACP 权限审批卡片
   *
   * 详见 components/agent-intervention/README.md
   */
  import { t } from "@/utils/i18n.uts";
  import { readRawField } from "@/utils/readRawField.uts";
  import { orString } from "@/utils/utsCoalesce.uts";
  import {
    AcpPermissionOutcome,
    AcpPermissionResponse,
  } from "@/types/intervention";
  import DiffContentView from "@/components/diff-list-view/components/diff-content-view/diff-content-view.uvue";
  import {
    normalizeFileDiffItems,
    getFileDiffTotalStats,
    getFileDiffLines,
    FileDiffLineStats,
    NormalizedFileDiffItem,
    FileDiffLineItem,
  } from "@/utils/fileChangeDiff.uts";

  const HIDDEN_OPTION_KINDS = new Set(["reject_always"]);

  function compareShortcutOrder(orderA: string, orderB: string): number {
    if (orderA < orderB) return -1;
    if (orderA > orderB) return 1;
    return 0;
  }

  /** 禁止 as AcpPermissionInteraction：prop 实为 UTSJSONObject，强转会 CCE */
  function readInteractionStatus(interaction: any | null): string {
    if (interaction == null) return "pending";
    const status = orString(readRawField(interaction, "responseStatus"), "pending");
    if (status == "submitted") return "submitted";
    if (status == "failed") return "failed";
    if (status == "submitting") return "submitting";
    if (status == "cancelled") return "cancelled";
    if (status == "skipped") return "skipped";
    if (status == "timeout") return "timeout";
    return "pending";
  }

  function readSelectedOptionId(interaction: any | null): string | null {
    if (interaction == null) return null;
    const selectedId = readRawField(interaction, "selectedOptionId");
    return selectedId != null && `${selectedId}`.length > 0
      ? `${selectedId}`
      : null;
  }

  function readRequest(interaction: any | null): any | null {
    return readRawField(interaction, "request");
  }

  function readToolCall(interaction: any | null): any | null {
    return readRawField(readRequest(interaction), "toolCall");
  }

  /** 把 options 规范为 UTSJSONObject[]，模板用 option.optionId 可读 */
  function readNormalizedOptions(interaction: any | null): UTSJSONObject[] {
    const optionsRaw = readRawField(readRequest(interaction), "options");
    if (optionsRaw == null || !Array.isArray(optionsRaw)) {
      return [];
    }
    const list = optionsRaw as any[];
    const out: UTSJSONObject[] = [];
    for (let i = 0; i < list.length; i++) {
      const opt = list[i];
      const item = new UTSJSONObject();
      item["optionId"] = orString(readRawField(opt, "optionId"), "");
      item["kind"] = orString(readRawField(opt, "kind"), "allow_once");
      item["name"] = orString(readRawField(opt, "name"), "");
      out.push(item);
    }
    return out;
  }

  function createSelectedResponse(optionId: string): AcpPermissionResponse {
    const outcome = new AcpPermissionOutcome();
    outcome.outcome = "selected";
    outcome.optionId = optionId;
    const response = new AcpPermissionResponse();
    response.outcome = outcome;
    return response;
  }

  function kindToCamelCase(kind: string): string {
    const parts = kind.split("_");
    if (parts.length <= 1) return kind;
    let result = parts[0];
    for (let i = 1; i < parts.length; i++) {
      const part = parts[i];
      if (part.length === 0) continue;
      const firstChar = part.charAt(0);
      const rest = part.length > 1 ? part.substring(1) : "";
      result += firstChar.toUpperCase() + rest;
    }
    return result;
  }

  function getAcpPermissionShortcutHint(kind: string): string {
    if (kind === "allow_once") return "1";
    if (kind === "allow_always") return "2";
    if (kind === "reject_once") return "3";
    return "9";
  }

  function writeSelectedOptionId(interaction: any | null, optionId: string): void {
    if (interaction == null) return;
    try {
      const obj = interaction as UTSJSONObject;
      obj["selectedOptionId"] = optionId;
    } catch (_e) {
      // ignore
    }
  }

  export default {
    name: "AcpPermissionCard",
    components: {
      DiffContentView,
    },
    props: {
      // Android：interaction 实为 UTSJSONObject，禁止 class 类型 prop / as class（CCE）。
      // 用宽松 Object，内部一律 readRawField 读字段。
      interaction: {
        type: Object,
        required: true,
      },
    },
    emits: ["respond"],
    data() {
      return {
        activeIndex: 0,
      };
    },
    watch: {
      // interaction 切换时重置选中项（对齐 PC 端 useEffect activeIndex=0）
      interaction: {
        handler() {
          this.activeIndex = 0;
        },
        deep: false,
      },
    },
    computed: {
      eyebrowText(): string {
        return t("Mobile.Intervention.AcpPermission.eyebrow");
      },
      rejectOnceText(): string {
        return t("Mobile.Intervention.AcpPermission.rejectOnce");
      },
      confirmText(): string {
        return t("Mobile.Intervention.AcpPermission.confirm");
      },
      responseStatus(): string {
        return readInteractionStatus(this.interaction);
      },
      isSubmitted(): boolean {
        return this.responseStatus === "submitted";
      },
      isFailed(): boolean {
        return this.responseStatus === "failed";
      },
      isPending(): boolean {
        return this.responseStatus === "pending";
      },
      isSubmitting(): boolean {
        return this.responseStatus === "submitting";
      },
      showActionArea(): boolean {
        return this.isPending || this.isSubmitting;
      },
      isCancelDisabled(): boolean {
        return !this.isPending || this.rejectOption == null;
      },
      isConfirmDisabled(): boolean {
        return !this.isPending;
      },
      isCancelLoading(): boolean {
        const reject = this.rejectOption;
        const rejectId =
          reject != null ? orString(readRawField(reject, "optionId"), "") : "";
        const selectedId = readSelectedOptionId(this.interaction);
        return (
          this.isSubmitting &&
          rejectId.length > 0 &&
          selectedId != null &&
          selectedId === rejectId
        );
      },
      isConfirmLoading(): boolean {
        const reject = this.rejectOption;
        const rejectId =
          reject != null ? orString(readRawField(reject, "optionId"), "") : "";
        const selectedId = readSelectedOptionId(this.interaction);
        return (
          this.isSubmitting &&
          selectedId != null &&
          selectedId.length > 0 &&
          selectedId !== rejectId
        );
      },
      title(): string {
        const toolCall = readToolCall(this.interaction);
        const rawInput = readRawField(toolCall, "rawInput");
        if (rawInput != null && typeof rawInput === "object") {
          const cmd = readRawField(rawInput, "command");
          if (typeof cmd === "string" && cmd.length > 0) {
            return cmd;
          }
        }
        const toolTitle = readRawField(toolCall, "title");
        if (toolTitle != null && typeof toolTitle === "string" && toolTitle.length > 0) {
          return toolTitle;
        }
        return t("Mobile.Intervention.AcpPermission.defaultTitle");
      },
      statusErrorMessage(): string {
        const message = readRawField(this.interaction, "errorMessage");
        if (message != null && typeof message === "string" && message.length > 0) {
          return message;
        }
        return t("Mobile.Intervention.AcpPermission.failed");
      },
      primaryPermissionDiffPath(): string {
        const file = this.primaryPermissionDiff;
        if (file == null) return "";
        return file.path;
      },
      visibleOptions(): UTSJSONObject[] {
        const options = readNormalizedOptions(this.interaction);
        const filtered: UTSJSONObject[] = [];
        for (let i = 0; i < options.length; i++) {
          const opt = options[i];
          const kind = orString(readRawField(opt, "kind"), "");
          const optionId = orString(readRawField(opt, "optionId"), "");
          // Android：Set.has / === 在 UTS 上不稳；改直接字符串 ==（只隐藏 reject_always 一种）
          if (kind == "reject_always") continue;
          if (optionId == "accept_execpolicy_amendment") continue;
          filtered.push(opt);
        }
        filtered.sort((a: UTSJSONObject, b: UTSJSONObject): number => {
          const orderA = getAcpPermissionShortcutHint(
            orString(readRawField(a, "kind"), ""),
          );
          const orderB = getAcpPermissionShortcutHint(
            orString(readRawField(b, "kind"), ""),
          );
          return compareShortcutOrder(orderA, orderB);
        });
        return filtered;
      },
      rejectOption(): UTSJSONObject | null {
        const options = readNormalizedOptions(this.interaction);
        for (let i = 0; i < options.length; i++) {
          const kind = orString(readRawField(options[i], "kind"), "");
          if (kind.indexOf("reject") == 0) {
            return options[i];
          }
        }
        return null;
      },
      permissionDiffItems(): NormalizedFileDiffItem[] {
        const toolCall = readToolCall(this.interaction);
        const rawInput = readRawField(toolCall, "rawInput");
        return normalizeFileDiffItems({
          input: rawInput,
          rawInput,
          toolCall,
        });
      },
      primaryPermissionDiff(): NormalizedFileDiffItem | null {
        if (this.permissionDiffItems.length == 0) return null;
        return this.permissionDiffItems[0];
      },
      permissionDiffStats(): FileDiffLineStats {
        return getFileDiffTotalStats(this.permissionDiffItems);
      },
      permissionDiffAdded(): number {
        const stats = this.permissionDiffStats;
        return stats.added;
      },
      permissionDiffRemoved(): number {
        const stats = this.permissionDiffStats;
        return stats.removed;
      },
      primaryPermissionDiffLines(): FileDiffLineItem[] {
        const file = this.primaryPermissionDiff;
        if (file == null) return [];
        return getFileDiffLines(file);
      },
    },
    methods: {
      setActiveIndex(index: number) {
        if (this.responseStatus !== "pending") return;
        this.activeIndex = index;
      },
      handleConfirm() {
        if (this.responseStatus !== "pending") return;
        const activeOption = this.visibleOptions[this.activeIndex];
        if (activeOption == null) return;
        const optionId = orString(readRawField(activeOption, "optionId"), "");
        if (optionId.length == 0) return;
        const response = createSelectedResponse(optionId);
        writeSelectedOptionId(this.interaction, optionId);
        this.$emit("respond", response);
      },
      handleCancel() {
        if (this.responseStatus !== "pending") return;
        const reject = this.rejectOption;
        if (reject == null) return;
        const optionId = orString(readRawField(reject, "optionId"), "");
        if (optionId.length == 0) return;
        const response = createSelectedResponse(optionId);
        writeSelectedOptionId(this.interaction, optionId);
        this.$emit("respond", response);
      },
      getOptionLabel(option: any): string {
        const kind = orString(readRawField(option, "kind"), "");
        const camelCaseKind = kindToCamelCase(kind);
        const i18nKey = `Mobile.Intervention.AcpPermission.${camelCaseKind}`;
        const translated = t(i18nKey);
        if (translated !== i18nKey) {
          return translated;
        }
        const name = orString(readRawField(option, "name"), "");
        if (name.length > 0) {
          return name;
        }
        return orString(readRawField(option, "optionId"), "");
      },
    },
  };
</script>

<style lang="scss" scoped>
  // 卡片容器及公共样式
  $card-bg-color: #fff;
  $card-border-radius: 16rpx;
  $card-padding: 24rpx;
  $card-margin: 8rpx;
  $card-box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);

  // 基础颜色
  $primary-color: #1677ff;
  $danger-color: #ff4d4f;

  // 字体颜色及字号
  $text-color-primary: #1a1a1a;
  $text-color-secondary: #666;
  $font-size-title: 30rpx;
  $font-size-status: 24rpx;

  // 按钮样式
  $button-border-radius: 16rpx;
  $button-border-radius-double: 32rpx;

  .acp-permission-card {
    background-color: $card-bg-color;
    border-radius: $card-border-radius;
    padding: $card-padding;
    margin: $card-margin;
    box-shadow: $card-box-shadow;

    .card-header {
      display: flex;
      flex-direction: row;
      align-items: center;
      margin-bottom: 20rpx;

      .card-title-wrap {
        flex: 1;

        .card-eyebrow {
          font-size: 22rpx;
          font-weight: 500;
          color: $primary-color;
          margin-bottom: 6rpx;
        }

        .card-title {
          font-size: $font-size-title;
          font-weight: 600;
          color: $text-color-primary;
        }
      }
    }

    .status-tag {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 8rpx 16rpx;
      border-radius: 8rpx;
      margin-bottom: 16rpx;

      &.status-failed {
        background-color: #fff2f0;
      }

      .status-icon {
        font-size: 28rpx;
        margin-right: 8rpx;

        &.status-icon-failed {
          color: $danger-color;
        }
      }

      .status-tag-text {
        font-size: $font-size-status;
      }
    }

    .permission-diff-block {
      border: 1rpx solid #e8eaed;
      border-radius: 12rpx;
      overflow: hidden;
      margin-bottom: 18rpx;
      background-color: #fff;

      .permission-diff-summary {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 14rpx 18rpx;
        background-color: #f7f8fa;
        /* #ifdef H5 || WEB */
        gap: 14rpx;
        /* #endif */
      }

      .permission-diff-path {
        flex: 1;
        min-width: 0;
        color: #333;
        font-size: 24rpx;
        line-height: 34rpx;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .permission-diff-stats {
        flex-shrink: 0;
        display: flex;
        flex-direction: row;
        align-items: center;
        /* #ifdef H5 || WEB */
        gap: 10rpx;
        /* #endif */
      }

      .permission-diff-added {
        color: #1a7f37;
        font-size: 22rpx;
        line-height: 30rpx;
        font-weight: 600;
        /* #ifndef H5 || WEB */
        margin-right: 10rpx;
        /* #endif */
      }

      .permission-diff-removed {
        color: #cf222e;
        font-size: 22rpx;
        line-height: 30rpx;
        font-weight: 600;
      }

      .permission-diff-preview {
        max-height: 360rpx;
        background-color: #fff;
      }
    }

    .card-actions {
      display: flex;
      flex-direction: column;
      /* #ifdef H5 || WEB */
      gap: 8rpx;
      /* #endif */
      margin-top: 8rpx;
      margin-bottom: 16rpx;

      .card-action-item {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 16rpx 20rpx;
        border-radius: 12rpx;
        background-color: #f7f8fa;
        /* #ifndef H5 || WEB */
        margin-bottom: 8rpx;
        /* #endif */
        /* #ifdef H5 || WEB */
        gap: 16rpx;
        /* #endif */

        &.item-active {
          background-color: #e8f0fe;

          .option-index {
            background-color: $primary-color;

            .option-index-text {
              color: #fff;
            }
          }

          .option-label {
            color: $primary-color;
            font-weight: 600;
          }
        }

        .option-index {
          flex-shrink: 0;
          width: 36rpx;
          height: 36rpx;
          border-radius: 50%;
          background-color: #e0e0e0;
          display: flex;
          align-items: center;
          justify-content: center;
          /* #ifndef H5 || WEB */
          margin-right: 16rpx;
          /* #endif */

          .option-index-text {
            font-size: 22rpx;
            font-weight: 700;
            color: $text-color-secondary;
            line-height: 1;
          }
        }

        .option-label {
          flex: 1;
          font-size: 28rpx;
          color: $text-color-primary;
        }
      }
    }

    .card-footer {
      display: flex;
      flex-direction: row;
      justify-content: flex-end;
      align-items: center;
      /* #ifdef H5 || WEB */
      gap: 16rpx;
      /* #endif */
      padding-top: 16rpx;
      border-top: 2rpx solid #f0f0f0;

      .footer-cancel-btn {
        flex-shrink: 0;
      }

      .footer-confirm-btn {
        flex-shrink: 0;
        /* #ifndef H5 || WEB */
        margin-left: 16rpx;
        /* #endif */
      }
    }

    /* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
    ::v-deep .l-button {
      border: 0 !important;
      border-radius: $button-border-radius !important;
      overflow: visible !important;
    }
    ::v-deep .l-button::after {
      border-radius: $button-border-radius-double !important;
    }
    /* #endif */
  }
</style>
