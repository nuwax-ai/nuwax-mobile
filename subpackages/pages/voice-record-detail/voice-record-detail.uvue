<template>
  <view class="container relative flex flex-col">
    <custom-nav-bar title="录音详情" className="border-b" hasSafetyZone showBack />

    <view class="top-fixed">
      <view class="head-card">
        <text class="head-title">{{ title.length > 0 ? title : "语音笔记" }}</text>
        <view class="meeting-facts">
          <view class="meeting-fact-row">
            <text class="meeting-fact-label">时间</text>
            <text class="meeting-fact-value">{{ recordedAt.length > 0 ? recordedAt : "—" }}</text>
          </view>
          <view class="meeting-fact-row">
            <text class="meeting-fact-label">时长</text>
            <text class="meeting-fact-value">{{ durationMs > 0 ? formatMs(durationMs) : "—" }}</text>
          </view>
          <view class="meeting-fact-row">
            <text class="meeting-fact-label">状态</text>
            <text class="meeting-fact-value">{{ statusText.length > 0 ? statusText : "—" }}</text>
          </view>
        </view>
        <view v-if="statusFailed" class="head-status-row">
          <text class="head-status-fail">{{ statusText }}</text>
          <view class="head-reprocess-btn" hover-class="head-reprocess-active" @click="handleReprocess">
            <text class="head-reprocess-text">↻ 重试</text>
          </view>
        </view>
      </view>
    </view>

    <voice-note-player
      v-if="detailReady && noteId.length > 0"
      class="player-host flex-1"
      :note-id="noteId"
      :audio-parts="audioParts"
      :segments="segments"
      :duration-ms="durationMs"
      :has-audio="hasAudio"
      :autoplay="false"
      :show-transcript="true"
      :visible="true"
    />
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { apiVoiceNoteDetail, apiVoiceNoteReprocess, apiVoiceNoteTranscript } from "@/servers/voiceNote.uts";
  import { VoiceNoteAudioPart, VoiceNoteTranscriptFrame } from "@/components/voice-note-player/types.uts";

  const noteId = ref<string>("");
  const detailReady = ref<boolean>(false);
  const title = ref<string>("");
  const recordedAt = ref<string>("");
  const status = ref<string>("");
  const durationMs = ref<number>(0);
  const hasAudio = ref<boolean>(false);
  const segments = ref<VoiceNoteTranscriptFrame[]>([]);
  const audioParts = ref<VoiceNoteAudioPart[]>([]);

  const statusFailed = computed((): boolean => {
    return status.value == "ASR_PARTIAL_FAILED" || status.value == "DOC_FAILED" || status.value == "DOC_REMOVED";
  });

  const statusText = computed((): string => {
    if (status.value == "UPLOADING") return "上传中";
    if (status.value == "PROCESSING") return "转写中";
    if (status.value == "ASR_PARTIAL_FAILED") return "部分转写失败";
    if (status.value == "DOC_FAILED") return "文档生成失败";
    if (status.value == "SUCCESS") return "已完成";
    if (status.value == "DOC_REMOVED") return "文档已删除";
    return status.value;
  });

  function pad2(n: number): string {
    if (n < 10) return "0" + n.toString();
    return n.toString();
  }

  function formatMs(ms: number): string {
    const totalSec = Math.floor(ms / 1000);
    const min = Math.floor(totalSec / 60);
    const sec = totalSec % 60;
    const secStr = sec < 10 ? "0" + sec.toString() : sec.toString();
    return min.toString() + ":" + secStr;
  }

  function formatClock(ts: number): string {
    if (ts <= 0) return "";
    const d = new Date(ts);
    return (
      d.getFullYear().toString() +
      "-" +
      pad2(d.getMonth() + 1) +
      "-" +
      pad2(d.getDate()) +
      " " +
      pad2(d.getHours()) +
      ":" +
      pad2(d.getMinutes())
    );
  }

  function formatCreated(raw: string): string {
    if (raw.length == 0) return "";
    const value = parseFloat(raw);
    const digitsOnly = !isNaN(value) && `${Math.floor(value)}` == raw;
    if (digitsOnly && value > 1000000000000) return formatClock(value);
    if (digitsOnly && value > 1000000000) return formatClock(value * 1000);
    const parsed = new Date(raw).getTime();
    if (!isNaN(parsed) && parsed > 0) return formatClock(parsed);
    return "";
  }

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    if (raw == null) return "";
    return `${raw}`;
  }

  function readNumber(obj: UTSJSONObject, key: string): number {
    const raw = obj[key];
    if (raw == null) return -1;
    const value = parseFloat(`${raw}`);
    if (isNaN(value)) return -1;
    return value;
  }

  function firstString(obj: UTSJSONObject, keys: string[]): string {
    for (let i = 0; i < keys.length; i++) {
      const text = readString(obj, keys[i]);
      if (text.length > 0) return text;
    }
    return "";
  }

  function firstNumber(obj: UTSJSONObject, keys: string[]): number {
    for (let i = 0; i < keys.length; i++) {
      const value = readNumber(obj, keys[i]);
      if (value >= 0) return value;
    }
    return -1;
  }

  function objectRows(raw: any | null): UTSJSONObject[] {
    if (raw == null || !Array.isArray(raw)) {
      return [] as UTSJSONObject[];
    }
    return raw as UTSJSONObject[];
  }

  function frameRows(data: any | null): UTSJSONObject[] {
    if (data == null) return [] as UTSJSONObject[];
    if (Array.isArray(data)) return data as UTSJSONObject[];
    const obj = data as UTSJSONObject;
    const direct = objectRows(obj["frames"]);
    if (direct.length > 0) return direct;
    const items = objectRows(obj["items"]);
    if (items.length > 0) return items;
    const segs = objectRows(obj["segments"]);
    if (segs.length > 0) return segs;
    const utterances = objectRows(obj["utterances"]);
    if (utterances.length > 0) return utterances;
    return objectRows(obj["transcripts"]);
  }

  function pushSentence(list: VoiceNoteTranscriptFrame[], sentence: UTSJSONObject, seq: number): number {
    const text = firstString(sentence, ["text", "content", "transcript"]);
    if (text.length == 0) {
      return seq;
    }
    let startMs = firstNumber(sentence, ["beginMs", "startMs", "timeMs"]);
    let endMs = firstNumber(sentence, ["endMs", "stopMs"]);
    if (startMs < 0) {
      startMs = 0;
    }
    if (endMs < startMs) {
      endMs = startMs;
    }
    list.push(new VoiceNoteTranscriptFrame(
      seq,
      firstString(sentence, ["speaker", "speakerName", "role"]),
      text,
      startMs,
      endMs,
      "",
    ));
    return seq + 1;
  }

  /** segments[].sentences 才是转写帧。beginMs / endMs 已经是整段录音上的时间。 */
  function parseFrames(data: any | null): VoiceNoteTranscriptFrame[] {
    const rows = frameRows(data);
    const list: VoiceNoteTranscriptFrame[] = [];
    let seq = 0;
    for (let i = 0; i < rows.length; i++) {
      const sentences = objectRows(rows[i]["sentences"]);
      if (sentences.length > 0) {
        for (let j = 0; j < sentences.length; j++) {
          seq = pushSentence(list, sentences[j], seq);
        }
        continue;
      }
      seq = pushSentence(list, rows[i], seq);
    }
    return list;
  }

  function parseAudioParts(data: any | null): VoiceNoteAudioPart[] {
    const rows = frameRows(data);
    const list: VoiceNoteAudioPart[] = [];
    for (let i = 0; i < rows.length; i++) {
      const url = firstString(rows[i], ["audioUrl"]);
      if (url.length == 0) {
        continue;
      }
      const duration = firstNumber(rows[i], ["durationMs"]);
      const indexValue = firstNumber(rows[i], ["segmentIndex"]);
      const index = indexValue >= 0 ? Math.floor(indexValue) : i;
      const part = new VoiceNoteAudioPart(url, duration > 0 ? duration : 0, index);
      let pos = list.length;
      while (pos > 0 && list[pos - 1].segmentIndex > part.segmentIndex) {
        pos = pos - 1;
      }
      list.splice(pos, 0, part);
    }
    return list;
  }

  function applyTranscript(data: any | null): void {
    if (data != null && !Array.isArray(data)) {
      const total = readNumber(data as UTSJSONObject, "totalDurationMs");
      if (total > durationMs.value) {
        durationMs.value = total;
      }
    }
    audioParts.value = parseAudioParts(data);
    segments.value = parseFrames(data);
    if (segments.value.length > 0 || audioParts.value.length > 0) {
      hasAudio.value = true;
    }
  }

  function applyDetail(detail: UTSJSONObject | null): void {
    if (detail == null) return;
    const titleVal = readString(detail, "title");
    title.value = titleVal.length > 0 ? titleVal : "语音笔记";
    recordedAt.value = formatCreated(firstString(detail, ["created", "startedAt", "recordedAt"]));
    status.value = readString(detail, "status");
    const duration = firstNumber(detail, ["totalDurationMs", "durationMs", "audioDurationMs"]);
    durationMs.value = duration > 0 ? duration : 0;
    const count = firstNumber(detail, ["segmentCount"]);
    hasAudio.value = status.value == "SUCCESS" || count > 0 || durationMs.value > 0;
  }

  async function loadDetail(): Promise<void> {
    if (noteId.value.length == 0) return;
    try {
      const detail = await apiVoiceNoteDetail(noteId.value);
      applyDetail(detail);
    } catch (_error) {
      uni.showToast({ title: "录音详情加载失败", icon: "none" });
    }
    try {
      const transcript = await apiVoiceNoteTranscript(noteId.value);
      applyTranscript(transcript);
    } catch (_error) {
      uni.showToast({ title: "转写加载失败", icon: "none" });
    }
    detailReady.value = true;
  }

  async function handleReprocess(): Promise<void> {
    if (noteId.value.length == 0) return;
    try {
      const next = await apiVoiceNoteReprocess(noteId.value);
      status.value = next;
      uni.showToast({ title: "已重新处理", icon: "none" });
    } catch (_error) {
      uni.showToast({ title: "重试失败", icon: "none" });
    }
  }

  onLoad((options: any) => {
    if (options != null) {
      const optObj = options as UTSJSONObject;
      const idVal = optObj["noteId"];
      if (idVal != null) {
        noteId.value = `${idVal}`;
      }
    }
    setCurrentPageNavigationBarTitle();
    void loadDetail();
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .top-fixed {
    flex-shrink: 0;
  }

  .player-host {
    min-height: 0;
    width: 100%;
  }

  .head-card {
    background-color: #ffffff;
    border-radius: 24rpx;
    margin: 24rpx 24rpx 0;
    padding: 32rpx;
  }

  .head-title {
    font-size: 34rpx;
    font-weight: 700;
    color: #1a1a1a;
  }

  .meeting-facts {
    margin-top: 22rpx;
    padding-top: 18rpx;
    border-top: 2rpx solid #f1f2f4;
  }

  .meeting-fact-row {
    min-height: 44rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .meeting-fact-label {
    flex-shrink: 0;
    margin-right: 16rpx;
    font-size: 24rpx;
    line-height: 36rpx;
    color: #969aa1;
  }

  .meeting-fact-value {
    flex: 1;
    font-size: 25rpx;
    line-height: 36rpx;
    color: #4c5057;
    font-weight: 500;
    text-align: right;
  }

  .head-status-row {
    margin-top: 16rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .head-status-fail {
    font-size: 24rpx;
    color: #dd524d;
    margin-right: 16rpx;
  }

  .head-reprocess-btn {
    padding: 8rpx 20rpx;
    border-radius: 12rpx;
    border: 2rpx solid #111111;
  }

  .head-reprocess-active {
    background-color: rgba(0, 0, 0, 0.06);
  }

  .head-reprocess-text {
    font-size: 22rpx;
    color: #111111;
  }
</style>
