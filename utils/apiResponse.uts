import type { RequestResponse } from "@/types/interfaces/request";
import { SUCCESS_CODE } from "@/constants/codes.constants";

/** API 响应：读取 code（Android 运行时 res 为 UTSJSONObject） */
export function apiResCode(res: RequestResponse<any> | null): string | null {
  if (res == null) {
    return null;
  }
  const code = res["code"];
  return code != null ? `${code}` : null;
}

/**
 * API 响应：读取 data。
 * Android：data 运行时多为 UTSJSONObject/Map，禁止 as Interface/DTO（会 ClassCastException）。
 * 泛型 T 仅作调用处文档提示，返回值一律按 any 使用，用 bracket / readRawField 读字段。
 */
export function apiResData<T = any>(res: RequestResponse<any> | null): any | null {
  if (res == null) {
    return null;
  }
  return res["data"];
}

/** API 响应：读取 message */
export function apiResMessage(res: RequestResponse<any> | null): string {
  if (res == null) {
    return "";
  }
  const msg = res["message"];
  return msg != null ? `${msg}` : "";
}

/** 从原生请求异常或 JSON 字符串中提取服务端 message。未知异常不展示运行时错误文本。 */
function readParsedErrorMessage(value: any | null, depth: number): string {
  if (value == null || depth > 3) return "";
  if (typeof value == "string") {
    try {
      return readParsedErrorMessage(JSON.parse(`${value}`), depth + 1);
    } catch (_error) {
      const text = `${value}`.trim();
      return depth > 0 && !text.startsWith("request:fail") && !text.startsWith("<") ? text : "";
    }
  }
  if (Array.isArray(value) || typeof value != "object") return "";
  const obj = value as UTSJSONObject;
  const messageRaw = obj["message"];
  const directMessage = messageRaw != null ? `${messageRaw}`.trim() : "";
  // 业务响应的顶层 message 是权威文案；请求异常包装则先检查内层响应体。
  if (obj["code"] != null && directMessage.length > 0) return directMessage;
  const responseMessage = readParsedErrorMessage(obj["response"], depth + 1);
  if (responseMessage.length > 0) return responseMessage;
  const dataMessage = readParsedErrorMessage(obj["data"], depth + 1);
  if (dataMessage.length > 0) return dataMessage;
  const bodyMessage = readParsedErrorMessage(obj["body"], depth + 1);
  if (bodyMessage.length > 0) return bodyMessage;
  const responseTextMessage = readParsedErrorMessage(obj["responseText"], depth + 1);
  if (responseTextMessage.length > 0) return responseTextMessage;
  const nestedErrorMessage = readParsedErrorMessage(obj["error"], depth + 1);
  if (nestedErrorMessage.length > 0) return nestedErrorMessage;
  if (directMessage.length > 0 && !directMessage.startsWith("request:fail")) return directMessage;
  return readParsedErrorMessage(obj["errMsg"], depth + 1);
}

export function apiErrorMessage(error: any | null): string {
  if (error == null) return "";
  try {
    const json = typeof error == "string" ? `${error}` : JSON.stringify(error);
    if (json == null || json.length == 0) return "";
    return readParsedErrorMessage(JSON.parse(json), 0);
  } catch (_error) {
    return "";
  }
}

/** API 响应：是否成功（默认 SUCCESS_CODE） */
export function isApiSuccess(res: RequestResponse<any> | null, successCode: string = SUCCESS_CODE): boolean {
  return apiResCode(res) == successCode;
}
