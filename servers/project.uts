/**
 * 项目相关接口 —— 对齐 PC 端 ProjectPanel / SpaceProjectManage
 * （nuwax src/pages/AppDevPro/services/appDevPro.ts）。
 *
 * Android：body 显式拼 UTSJSONObject（UTS class 经 JSON.stringify 可能丢字段）。
 * PageApp 契约未覆盖改名/删除（对齐 PC：仅本地改名、不挂删除菜单）。
 */
import { RequestResponse, VoidRequestResponse } from "@/types/interfaces/request";
import {
  UserProjectUpdateParams,
  UserAppUpdateParams,
  UserAppInfo,
  UserNormalProjectInfo,
} from "@/types/interfaces/projectInfo";
import request from "@/servers/useRequest";

/** 侧栏场景一把拉全量（PC ProjectPanel 同款 pageSize=100） */
const TAB_PAGE_SIZE = 100;

/** 云电脑沙箱哨兵值：后端默认分配云端沙箱（对齐 PC CLOUD_SANDBOX_ID） */
const CLOUD_SANDBOX_ID = -1;

/**
 * 侧栏「项目」列表（2026-09-14 统一接口，tab/page-query 已下线）：
 * 同款行结构（projectId 主键 + pinned/archived/collected 打标）；差异两点：
 * ① 回包包含已归档项目（消费侧按打标前端过滤）；② 不附带 conversations
 * （子会话展开时经 apiUserProjectConversations 懒加载）。
 * spaceId 移动端无空间路由暂不传，由后端按用户默认空间处理。
 */
export async function apiUserProjectTabPageQuery(): Promise<RequestResponse<any>> {
  const queryFilter = new UTSJSONObject();
  const body = new UTSJSONObject();
  body["queryFilter"] = queryFilter;
  body["current"] = 1;
  body["pageSize"] = TAB_PAGE_SIZE;
  // 空数组字面量无法推断元素类型（Kotlin），显式声明
  const emptyList: any[] = [] as any[];
  body["orders"] = emptyList;
  body["filters"] = emptyList;
  body["columns"] = emptyList;
  const res = await request({
    url: "/api/user-project/page-query",
    method: "POST",
    data: body,
  });
  return res;
}

/**
 * 查询项目会话列表（统一接口不随列表回包 conversations，展开项目时懒加载）。
 * 会话行按 ConversationInfo 消费（agent 等字段防御式可选访问）。
 * projectType 为必传 query（归属校验）。
 */
export async function apiUserProjectConversations(
  projectId: number,
  projectType: string,
): Promise<RequestResponse<any>> {
  const res = await request({
    url: `/api/user-project/conversations/${projectId}?projectType=${encodeURIComponent(projectType)}`,
    method: "GET",
  });
  return res;
}

function buildUserProjectUpdateBody(data: UserProjectUpdateParams): UTSJSONObject {
  const body = new UTSJSONObject();
  body["id"] = data.id;
  body["name"] = data.name;
  if (data.description != null) {
    body["description"] = data.description;
  }
  if (data.icon != null) {
    body["icon"] = data.icon;
  }
  return body;
}

/** 根据提示词生成项目名称 / 描述 / 图标。 */
export async function apiAgentGenerateInfo(
  prompt: string,
): Promise<RequestResponse<any>> {
  const body = new UTSJSONObject();
  body["prompt"] = prompt;
  const res = await request({
    url: "/api/agent/generate-info",
    method: "POST",
    data: body,
  });
  return res;
}

/**
 * 常规项目重命名（wiki 2026-09-11：常规项目 CRUD 换 /api/normal-project/*，
 * 与旧 user-project/update 入参语义一致）。
 */
export async function apiNormalProjectUpdate(
  data: UserProjectUpdateParams,
): Promise<RequestResponse<any>> {
  const res = await request({
    url: "/api/normal-project/update",
    method: "POST",
    data: buildUserProjectUpdateBody(data),
  });
  return res;
}

/** 常规项目删除（wiki 2026-09-11 新契约） */
export async function apiUserProjectDelete(id: number): Promise<VoidRequestResponse> {
  const res = await request({
    url: `/api/normal-project/delete/${id}`,
    method: "POST",
  });
  return res;
}

function buildUserAppUpdateBody(data: UserAppUpdateParams): UTSJSONObject {
  const body = new UTSJSONObject();
  body["id"] = data.id;
  if (data.name != null) {
    body["name"] = data.name;
  }
  if (data.description != null) {
    body["description"] = data.description;
  }
  if (data.icon != null) {
    body["icon"] = data.icon;
  }
  return body;
}

/** 按ID查询常规项目详情 */
export async function apiNormalProjectGetById(
  id: number,
): Promise<RequestResponse<UserNormalProjectInfo>> {
  const res = await request({
    url: `/api/normal-project/get/${id}`,
    method: "GET",
  });
  return res;
}

/** 按应用ID查询（主键 id 即 app_id） */
export async function apiUserAppGetById(
  id: number,
): Promise<RequestResponse<UserAppInfo>> {
  const res = await request({
    url: `/api/userapp/get/${id}`,
    method: "GET",
  });
  return res;
}

/** 全栈应用重命名 */
export async function apiUserAppUpdate(
  data: UserAppUpdateParams,
): Promise<RequestResponse<any>> {
  const res = await request({
    url: "/api/userapp/update",
    method: "POST",
    data: buildUserAppUpdateBody(data),
  });
  return res;
}

/** 全栈应用删除 */
export async function apiUserAppDelete(id: number): Promise<VoidRequestResponse> {
  const res = await request({
    url: `/api/userapp/delete/${id}`,
    method: "POST",
  });
  return res;
}

