<template>
  <view class="todo">
    <custom-nav-bar :title="t('Mobile.Discover.todo')" className="border-b" hasSafetyZone :show-back="true">
      <template #right>
        <view class="todo__add" @click="onAdd">
          <svg-icon name="icon-Plus" size="22" unit="px" color="#5b4dff" />
        </view>
      </template>
    </custom-nav-bar>
    <view v-if="showEmpty" class="todo__empty">
      <text class="todo__empty-text">{{ t("Mobile.Discover.todoEmpty") }}</text>
    </view>
    <scroll-view v-else class="todo__scroll" direction="vertical" :show-scrollbar="false">
      <text v-if="todayItems.length > 0" class="todo__section">{{ todayTitle }}</text>
      <view class="todo__card" v-for="item in todayItems" :key="item.id">
        <view class="todo__check"></view>
        <view class="todo__body">
          <text class="todo__name">{{ item.title }}</text>
          <text v-if="item.meta.length > 0" class="todo__meta">{{ item.meta }}</text>
        </view>
        <text v-if="item.time.length > 0" class="todo__time">{{ item.time }}</text>
      </view>

      <text v-if="weekItems.length > 0" class="todo__section">{{ weekTitle }}</text>
      <view class="todo__card" v-for="item in weekItems" :key="item.id">
        <view class="todo__check"></view>
        <view class="todo__body">
          <text class="todo__name">{{ item.title }}</text>
          <text v-if="item.meta.length > 0" class="todo__meta">{{ item.meta }}</text>
        </view>
        <text v-if="item.time.length > 0" class="todo__time">{{ item.time }}</text>
      </view>

      <text v-if="otherItems.length > 0" class="todo__section">{{ otherTitle }}</text>
      <view class="todo__card" v-for="item in otherItems" :key="item.id">
        <view class="todo__check"></view>
        <view class="todo__body">
          <text class="todo__name">{{ item.title }}</text>
          <text v-if="item.meta.length > 0" class="todo__meta">{{ item.meta }}</text>
        </view>
        <text v-if="item.time.length > 0" class="todo__time">{{ item.time }}</text>
      </view>
    </scroll-view>
    <todo-create-sheet ref="createSheetRef" @submit="onCreateSubmit" @open-due="onOpenDue" />
    <todo-due-picker ref="duePickerRef" @confirm="onDueConfirm" />
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, type ComponentPublicInstance } from "vue";
  import { onShow } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiErrorMessage, apiResCode, apiResData } from "@/utils/apiResponse";
  import { apiCalendarListMy } from "@/servers/calendar/calendar.uts";
  import { CalendarEventQueryReq } from "@/types/interfaces/calendar";
  import { CalendarCategoryEnum, CalendarEventStatusEnum } from "@/types/enums/calendar";
  import TodoCreateSheet from "./components/todo-create-sheet/todo-create-sheet.uvue";
  import TodoDuePicker from "./components/todo-due-picker/todo-due-picker.uvue";

  class TodoRow {
    id: string = "";
    title: string = "";
    meta: string = "";
    time: string = "";
  }

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  function countText(key: string, count: number): string {
    const m = new Map<string, string | number>();
    m.set("count", count);
    return translateFn(key, toI18nParams(m), "");
  }

  const todayItems = ref<TodoRow[]>([]);
  const weekItems = ref<TodoRow[]>([]);
  const otherItems = ref<TodoRow[]>([]);
  const loaded = ref<boolean>(false);
  const showEmpty = computed((): boolean => {
    return loaded.value && todayItems.value.length == 0 && weekItems.value.length == 0 && otherItems.value.length == 0;
  });
  const todayTitle = computed((): string => countText("Mobile.Discover.todoToday", todayItems.value.length));
  const weekTitle = computed((): string => countText("Mobile.Discover.todoWeek", weekItems.value.length));
  const otherTitle = computed((): string => countText("Mobile.Discover.todoOther", otherItems.value.length));

  const createSheetRef = ref<any | null>(null);
  const duePickerRef = ref<any | null>(null);
  let loadToken = 0;

  function readText(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const text = `${raw}`.trim();
    if (text == "null" || text == "undefined") {
      return "";
    }
    return text;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    if (raw == true) {
      return true;
    }
    return raw != null && `${raw}` == "true";
  }

  function asRecordList(raw: any | null): UTSJSONObject[] {
    const list: UTSJSONObject[] = [];
    if (raw == null) {
      return list;
    }
    try {
      const text = JSON.stringify(raw);
      if (text == null || text.length == 0 || text.charAt(0) != "[") {
        return list;
      }
      const parsed = JSON.parse(text) as UTSJSONObject[] | null;
      if (parsed == null) {
        return list;
      }
      for (let i = 0; i < parsed.length; i++) {
        const row = parsed[i];
        if (row != null) {
          list.push(row);
        }
      }
    } catch (_error) {
      return list;
    }
    return list;
  }

  function pad2(value: number): string {
    if (value < 10) {
      return `0${value}`;
    }
    return `${value}`;
  }

  function formatDay(date: Date): string {
    return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}`;
  }

  function datePart(raw: string): string {
    if (raw.length < 10) {
      return "";
    }
    return raw.substring(0, 10);
  }

  function timePart(raw: string): string {
    if (raw.length < 16) {
      return "";
    }
    const separator = raw.charAt(10);
    if (separator != "T" && separator != " ") {
      return "";
    }
    return raw.substring(11, 16);
  }

  function weekdayText(day: string): string {
    const parts = day.split("-");
    if (parts.length < 3) {
      return "";
    }
    const year = parseInt(parts[0]);
    const month = parseInt(parts[1]);
    const date = parseInt(parts[2]);
    if (year <= 0 || month <= 0 || date <= 0) {
      return "";
    }
    const parsed = new Date(year, month - 1, date);
    const index = parsed.getDay();
    if (index == 1) {
      return t("Mobile.Discover.weekdayMon");
    }
    if (index == 2) {
      return t("Mobile.Discover.weekdayTue");
    }
    if (index == 3) {
      return t("Mobile.Discover.weekdayWed");
    }
    if (index == 4) {
      return t("Mobile.Discover.weekdayThu");
    }
    if (index == 5) {
      return t("Mobile.Discover.weekdayFri");
    }
    if (index == 6) {
      return t("Mobile.Discover.weekdaySat");
    }
    return t("Mobile.Discover.weekdaySun");
  }

  function priorityText(raw: string): string {
    if (raw == "1") {
      return t("Mobile.Discover.todoPriorityLow");
    }
    if (raw == "2") {
      return t("Mobile.Discover.todoPriorityMid");
    }
    if (raw == "3") {
      return t("Mobile.Discover.todoPriorityHigh");
    }
    return "";
  }

  function applyTodoList(raw: any | null): void {
    const today: TodoRow[] = [];
    const week: TodoRow[] = [];
    const other: TodoRow[] = [];
    const now = new Date();
    const todayText = formatDay(now);
    const weekday = now.getDay();
    const mondayOffset = weekday == 0 ? 6 : weekday - 1;
    const weekStart = new Date(now.getFullYear(), now.getMonth(), now.getDate() - mondayOffset);
    const weekEnd = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() + 6);
    const weekStartText = formatDay(weekStart);
    const weekEndText = formatDay(weekEnd);
    const records = asRecordList(raw);
    for (let i = 0; i < records.length; i++) {
      const record = records[i];
      const row = new TodoRow();
      row.id = readText(record, "id");
      row.title = readText(record, "title");
      if (row.title.length == 0) {
        row.title = readText(record, "description");
      }
      if (row.id.length == 0) {
        row.id = `todo-${i}`;
      }
      row.meta = priorityText(readText(record, "priority"));
      const endTime = readText(record, "endTime");
      const startTime = readText(record, "startTime");
      const due = datePart(endTime.length > 0 ? endTime : startTime);
      const allDay = readBool(record, "allDay");
      if (due == todayText) {
        if (!allDay) {
          row.time = timePart(endTime.length > 0 ? endTime : startTime);
        }
        today.push(row);
      } else if (due.length > 0 && due >= weekStartText && due <= weekEndText) {
        row.time = weekdayText(due);
        week.push(row);
      } else {
        if (due.length >= 10) {
          row.time = due.substring(5);
        }
        other.push(row);
      }
    }
    todayItems.value = today;
    weekItems.value = week;
    otherItems.value = other;
    loaded.value = true;
  }

  async function loadTodos(): Promise<void> {
    loadToken++;
    const token = loadToken;
    try {
      const query = new CalendarEventQueryReq();
      // 待办列表固定查 TODO，工作日程才用 WORK。
      query.category = `${CalendarCategoryEnum.TODO}`;
      const statuses: string[] = [];
      statuses.push(`${CalendarEventStatusEnum.ACTIVE}`);
      query.statuses = statuses;
      const res = await apiCalendarListMy(query);
      if (token != loadToken) {
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        loaded.value = true;
        return;
      }
      applyTodoList(apiResData<any>(res));
    } catch (error) {
      if (token != loadToken) {
        return;
      }
      loaded.value = true;
      const message = apiErrorMessage(error);
      if (message.length > 0) {
        uni.showToast({ title: message, icon: "none" });
      }
    }
  }

  onShow(() => {
    const proxy = createSheetRef.value as ComponentPublicInstance | null;
    if (proxy != null) {
      proxy.$callMethod("resumeAfterAssignees");
    }
    loadTodos();
  });

  function onAdd(): void {
    const proxy = createSheetRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("open");
  }

  function onOpenDue(payload: string): void {
    const proxy = duePickerRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("open", payload);
  }

  function onDueConfirm(payload: string): void {
    const proxy = createSheetRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("applyDue", payload);
  }

  function onCreateSubmit(_content: string): void {
    uni.showToast({ title: t("Mobile.Discover.todoAdded"), icon: "none" });
    loadTodos();
  }
</script>

<style scoped>
  .todo {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: #f7f7f8;
  }

  .todo__add {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .todo__scroll {
    flex: 1;
  }

  .todo__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .todo__empty-text {
    font-size: 14px;
    color: #86909c;
  }

  .todo__section {
    margin: 16px 16px 8px;
    font-size: 16px;
    font-weight: 600;
    color: #1f2329;
  }

  .todo__card {
    margin: 0 16px 10px;
    padding: 14px 14px;
    background-color: #ffffff;
    border-radius: 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .todo__check {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    border-width: 1.5px;
    border-style: solid;
    border-color: #c9cdd4;
    border-radius: 10px;
  }

  .todo__body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .todo__name {
    font-size: 16px;
    color: #1f2329;
  }

  .todo__meta {
    margin-top: 4px;
    font-size: 13px;
    color: #86909c;
  }

  .todo__time {
    margin-left: 12px;
    font-size: 13px;
    color: #86909c;
  }
</style>
