<template>
  <!--
    加入群组底部弹窗（按群号）：
    - 群号 19 位数字（「群设置」页可复制），数字键盘、超长拦截
    - 申请附言选填 ≤64 字（服务端上限），实时计数
    - 申请加入：POST /conversations/join {groupNo, remark}（PC 端同款）
      免审批群直接入群，需审批群等群主同意；成功后关弹窗并通知页面刷新会话列表
  -->
  <uni-modal-popup
    ref="popupRef"
    position="bottom"
    height="55%"
    :show-header="false"
    :body-scroll="false"
    :enable-swipe-close="true"
    @afterleave="handleAfterLeave"
  >
    <view class="join-sheet">
      <view class="join-sheet__header">
        <text class="join-sheet__title">{{ t("Mobile.Message.joinGroupTitle") }}</text>
        <view class="join-sheet__close" @click="close">
          <svg-icon name="icon-X" size="36" color="#8a8a8a" />
        </view>
      </view>

      <text class="join-sheet__tip">{{ t("Mobile.Message.joinGroupNoTip") }}</text>

      <view class="join-sheet__form">
        <view class="join-sheet__label-row">
          <text class="join-sheet__label">{{ t("Mobile.Message.joinGroupNoLabel") }}</text>
        </view>
        <input
          class="join-sheet__no-input"
          v-model="groupNo"
          type="number"
          :maxlength="19"
          :placeholder="t('Mobile.Message.joinGroupNoPlaceholder')"
          placeholder-class="join-sheet__ph"
        />

        <!-- 附言无单独标签：placeholder 已说明（选填、上限），对齐设计稿 -->
        <textarea
          class="join-sheet__remark-input"
          v-model="remark"
          :maxlength="64"
          :placeholder="t('Mobile.Message.joinGroupRemarkPlaceholder')"
          placeholder-class="join-sheet__ph"
        />
        <text class="join-sheet__remark-count">
          {{ remark.length }} / 64 {{ t("Mobile.Message.joinGroupWordUnit") }}
        </text>
      </view>

      <view class="join-sheet__footer">
        <view
          class="join-sheet__btn join-sheet__btn--outline"
          hover-class="join-sheet__btn-outline--active"
          @click="close"
        >
          <text class="join-sheet__btn-text join-sheet__btn-text--cancel">
            {{ t("Mobile.Message.joinGroupClose") }}
          </text>
        </view>
        <view
          class="join-sheet__btn join-sheet__btn--ok"
          :class="{ 'join-sheet__btn--disabled': busy }"
          hover-class="join-sheet__btn-ok--active"
          @click="handleSubmit"
        >
          <text class="join-sheet__btn-text join-sheet__btn-text--ok">
            {{ t("Mobile.Message.joinGroupSubmit") }}
          </text>
        </view>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { onUnmounted, ref, type ComponentPublicInstance } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiResCode } from "@/utils/apiResponse";
  import { apiImJoinGroup } from "@/servers/im";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const emit = defineEmits<{
    /** 申请提交成功（页面借此刷新会话列表，免审批群会立即出现） */
    joined: [];
  }>();

  const popupRef = ref<any | null>(null);
  const tabBarHiddenBySheet = ref<boolean>(false);
  /** 群号（19 位数字；契约按字符串传输） */
  const groupNo = ref<string>("");
  /** 申请附言（选填 ≤64 字，服务端上限） */
  const remark = ref<string>("");
  /** 提交防重 */
  const busy = ref<boolean>(false);

  function callPopupMethod(methodName: string): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(methodName);
  }

  /** 打开加入群组弹窗：重置表单。 */
  function open(): void {
    groupNo.value = "";
    remark.value = "";
    busy.value = false;
    // 系统 TabBar 是独立原生层，页面内弹窗无法用 z-index 覆盖，先隐藏、关闭时恢复。
    // ★非 tabBar 页（如子包搜索页）hide 会失败：仅成功时置位，关闭才不会误调 showTabBar
    uni.hideTabBar({
      animation: false,
      success: () => {
        tabBarHiddenBySheet.value = true;
      },
      complete: () => {
        callPopupMethod("open");
      },
    });
  }

  function close(): void {
    callPopupMethod("close");
  }

  function restoreTabBar(): void {
    if (tabBarHiddenBySheet.value != true) {
      return;
    }
    tabBarHiddenBySheet.value = false;
    // complete 兜底：页面已切换等场景 show 可能失败，避免未处理的 Promise 拒绝噪音
    uni.showTabBar({
      animation: false,
      complete: () => {},
    });
  }

  /** 群号格式：19 位纯数字（不用正则，手动循环保 Android 编译安全）。 */
  function isGroupNoValid(no: string): boolean {
    if (no.length != 19) {
      return false;
    }
    for (let i = 0; i < no.length; i++) {
      const c = no.charAt(i);
      if (c < "0" || c > "9") {
        return false;
      }
    }
    return true;
  }

  /** 申请加入：校验群号后提交，成功关弹窗并通知页面刷新会话列表。 */
  async function handleSubmit(): Promise<void> {
    if (busy.value) {
      return;
    }
    const no = groupNo.value.trim();
    if (no.length == 0) {
      uni.showToast({ title: t("Mobile.Message.joinGroupNoRequired"), icon: "none" });
      return;
    }
    if (isGroupNoValid(no) != true) {
      uni.showToast({ title: t("Mobile.Message.joinGroupNoInvalid"), icon: "none" });
      return;
    }
    busy.value = true;
    try {
      const res = await apiImJoinGroup(no, remark.value.trim());
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.joinGroupFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Message.joinGroupSubmitted"), icon: "none" });
      emit("joined");
      close();
    } catch (e) {
      uni.showToast({ title: t("Mobile.Message.joinGroupFailed"), icon: "none" });
    } finally {
      busy.value = false;
    }
  }

  /** 弹窗完全收起：恢复 tabBar。 */
  function handleAfterLeave(): void {
    restoreTabBar();
  }

  defineExpose({
    open: open as any,
    close: close as any,
  });

  onUnmounted(() => {
    restoreTabBar();
  });
</script>

<style lang="scss" scoped>
  .join-sheet {
    width: 100%;
    height: 100%;
    padding: 32rpx 32rpx 24rpx;
    /* #ifdef H5 */
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    /* #endif */
    background-color: #ffffff;
    border-radius: 32rpx 32rpx 0 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .join-sheet__header {
    height: 52rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .join-sheet__title {
    color: #111111;
    font-size: 32rpx;
    line-height: 44rpx;
    font-weight: 600;
  }

  .join-sheet__close {
    width: 56rpx;
    height: 56rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .join-sheet__tip {
    margin-top: 12rpx;
    color: #9a9aa2;
    font-size: 24rpx;
    line-height: 34rpx;
    flex-shrink: 0;
  }

  .join-sheet__form {
    flex: 1;
    min-height: 0;
  }

  .join-sheet__label-row {
    margin-top: 28rpx;
    margin-bottom: 16rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .join-sheet__label {
    color: #4b4b52;
    font-size: 26rpx;
    line-height: 36rpx;
    font-weight: 500;
  }

  .join-sheet__no-input {
    width: 100%;
    height: 80rpx;
    padding: 0 24rpx;
    border-radius: 20rpx;
    background-color: #f6f5f8;
    font-size: 28rpx;
    color: #1c1b20;
    box-sizing: border-box;
  }

  .join-sheet__remark-input {
    margin-top: 44rpx;
    width: 100%;
    height: 150rpx;
    padding: 20rpx 24rpx;
    border-radius: 20rpx;
    background-color: #f6f5f8;
    font-size: 28rpx;
    color: #1c1b20;
    box-sizing: border-box;
  }

  .join-sheet__remark-count {
    margin-top: 8rpx;
    color: #b7b7be;
    font-size: 22rpx;
    line-height: 32rpx;
  }

  .join-sheet__ph {
    color: #b7b7be;
    font-size: 26rpx;
  }

  .join-sheet__footer {
    flex-shrink: 0;
    padding-top: 20rpx;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
  }

  .join-sheet__btn {
    min-width: 180rpx;
    height: 88rpx;
    padding: 0 32rpx;
    border-radius: 24rpx;
    background-color: #ffffff;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .join-sheet__btn--outline {
    border: 2rpx solid #d9d9de;
  }

  .join-sheet__btn-outline--active {
    background-color: #f7f6fb;
  }

  .join-sheet__btn--ok {
    margin-left: 20rpx;
    background-color: #5147ff;
  }

  .join-sheet__btn-ok--active {
    background-color: #4239e8;
  }

  .join-sheet__btn--disabled {
    opacity: 0.55;
  }

  .join-sheet__btn-text {
    font-size: 30rpx;
    line-height: 42rpx;
    font-weight: 500;
  }

  .join-sheet__btn-text--cancel {
    color: #4b4b52;
  }

  .join-sheet__btn-text--ok {
    color: #ffffff;
  }
</style>
