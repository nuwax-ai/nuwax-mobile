<template>
  <uni-modal-popup ref="popupRef" position="bottom" height="50%" :show-header="false" :body-scroll="false" @update-visible="handleVisibleChange">
    <view class="sheet" :class="{ 'sheet--avoid-tab-bar': avoidTabBar }">
      <view class="sheet-handle" />
      <text class="sheet-title">{{ t("Mobile.CreateHub.selectComputer") }}</text>
      <scroll-view class="computer-list" direction="vertical" :show-scrollbar="false">
        <view v-if="loading" class="sheet-state"><text class="sheet-state-text">{{ t("Mobile.Page.loading") }}</text></view>
        <view v-else-if="computers.length == 0" class="sheet-state"><text class="sheet-state-text">{{ t("Mobile.Terminal.noComputer") }}</text></view>
        <view
          v-for="item in computers"
          :key="item.sandboxId"
          class="computer-row"
          :class="{ 'computer-row--active': currentValue == item.sandboxId }"
          @click="selectItem(item)"
        >
          <svg-icon
            :name="item.sandboxId == '-1' ? 'icon-Globe' : 'icon-layout'"
            size="40"
            :color="currentValue == item.sandboxId ? '#5147ff' : '#858590'"
          />
          <view class="computer-main">
            <text class="computer-name" :class="{ 'computer-name--active': currentValue == item.sandboxId }">{{ item.name }}</text>
            <text v-if="item.description.length > 0" class="computer-status">{{ item.description }}</text>
          </view>
          <svg-icon v-if="currentValue == item.sandboxId" name="icon-Check" size="36" color="#5147ff" />
        </view>
      </scroll-view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, watch, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import { apiGetSandboxList, apiUpdateSelectedSandbox } from "@/servers/sandbox";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { SandboxInfo } from "@/types/interfaces/sandbox";
  import { t as tRaw, emptyI18nParams } from "@/utils/i18n";
  import { resolveHomeComputerId } from "../conversationInputOptions.uts";

  const t = (key: string): string => tRaw(key, emptyI18nParams(), "");

  const props = withDefaults(defineProps<{
    visible: boolean;
    currentValue?: string;
    agentId?: number;
    avoidTabBar?: boolean;
  }>(), {
    visible: false,
    currentValue: "",
    agentId: 0,
    avoidTabBar: false,
  });

  const emit = defineEmits<{
    (e: "close"): void;
    (e: "select", value: string, name: string): void;
    (e: "sync", value: string, name: string): void;
  }>();

  const popupRef = ref<any | null>(null);
  const loading = ref<boolean>(false);
  const computers = ref<SandboxInfo[]>([]);
  let agentSelected = new UTSJSONObject();
  let loadSequence = 0;
  let loadedAgentId = -1;

  function callPopup(method: string): void {
    if (popupRef.value == null) return;
    (popupRef.value as ComponentPublicInstance).$callMethod(method);
  }

  function parseAgentSelected(raw: any | null): UTSJSONObject {
    if (raw == null) return new UTSJSONObject();
    const jsonStr = JSON.stringify(raw);
    if (jsonStr == null || jsonStr.length <= 2) return new UTSJSONObject();
    const parsed = JSON.parse<UTSJSONObject>(jsonStr);
    return parsed != null ? parsed : new UTSJSONObject();
  }

  function syncSelection(): void {
    const ids: string[] = [];
    for (let i = 0; i < computers.value.length; i++) ids.push(computers.value[i].sandboxId);
    const savedRaw = props.agentId > 0 ? agentSelected[`${props.agentId}`] : null;
    const savedId = savedRaw != null ? `${savedRaw}` : "";
    const selectedId = resolveHomeComputerId(savedId, ids);
    if (selectedId.length == 0) return;
    const selected = computers.value.find((item: SandboxInfo): boolean => item.sandboxId == selectedId);
    if (selected != null) emit("sync", selected.sandboxId, selected.name);
  }

  async function loadComputers(): Promise<void> {
    loadSequence = loadSequence + 1;
    const requestSequence = loadSequence;
    const agentId = props.agentId;
    loading.value = true;
    try {
      const res = await apiGetSandboxList();
      if (requestSequence != loadSequence) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        computers.value = [];
        return;
      }
      const raw = apiResData<any>(res);
      if (raw == null) {
        computers.value = [];
        return;
      }
      const obj = raw as UTSJSONObject;
      const listRaw = obj["sandboxes"];
      computers.value = listRaw != null ? (listRaw as SandboxInfo[]) : ([] as SandboxInfo[]);
      agentSelected = parseAgentSelected(obj["agentSelected"]);
      loadedAgentId = agentId;
      syncSelection();
    } catch (error) {
      if (requestSequence == loadSequence) console.error("[conversation-input] load computers failed", error);
    } finally {
      if (requestSequence == loadSequence) loading.value = false;
    }
  }

  async function selectItem(item: SandboxInfo): Promise<void> {
    if (item.sandboxId == props.currentValue) {
      callPopup("close");
      return;
    }
    emit("select", item.sandboxId, item.name);
    callPopup("close");
    if (props.agentId <= 0) return;
    agentSelected[`${props.agentId}`] = item.sandboxId;
    try {
      await apiUpdateSelectedSandbox(`${props.agentId}`, item.sandboxId);
    } catch (error) {
      console.error("[conversation-input] save selected computer failed", error);
      uni.showToast({ title: t("Mobile.Sandbox.switchFailed"), icon: "none" });
    }
  }

  function handleVisibleChange(value: boolean): void {
    if (value != true) emit("close");
  }

  watch((): boolean => props.visible, (value: boolean): void => {
    if (value) {
      callPopup("open");
      if (loadedAgentId != props.agentId && loading.value != true) loadComputers();
    } else {
      callPopup("close");
    }
  });

  watch((): number => props.agentId, (): void => {
    loadSequence = loadSequence + 1;
    loadedAgentId = -1;
    computers.value = [];
    agentSelected = new UTSJSONObject();
    loadComputers();
  }, { immediate: true });
</script>

<style lang="scss" scoped>
  .sheet { display: flex; flex-direction: column; height: 100%; padding: 18rpx 32rpx 0; background: #fff; box-sizing: border-box; }
  /* #ifdef APP */
  .sheet--avoid-tab-bar { padding-bottom: 100rpx; }
  /* #endif */
  /* #ifdef H5 */
  .sheet--avoid-tab-bar { padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
  /* #endif */
  .sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 34rpx; border-radius: 999rpx; background: #dedee8; }
  .sheet-title { margin: 0 8rpx 20rpx; color: #17171c; font-size: 34rpx; line-height: 48rpx; font-weight: 700; }
  .computer-list { flex: 1; min-height: 0; }
  .computer-row { min-height: 86rpx; padding: 12rpx 20rpx; border-radius: 22rpx; display: flex; flex-direction: row; align-items: center; box-sizing: border-box; }
  .computer-row--active { background: #f3f1ff; }
  .computer-main { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; }
  .computer-name { flex: 1; min-width: 0; margin-left: 20rpx; color: #292930; font-size: 30rpx; lines: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .computer-name--active { color: #5147ff; }
  .computer-status { max-width: 220rpx; color: #aaaab3; font-size: 22rpx; lines: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sheet-state { height: 220rpx; display: flex; align-items: center; justify-content: center; }
  .sheet-state-text { color: #9999a4; font-size: 26rpx; }
</style>
