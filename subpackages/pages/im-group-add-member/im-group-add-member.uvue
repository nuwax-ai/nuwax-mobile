  }

  .ga-bar__btn-text--ready {
    color: #ffffff;
  }
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #f3f0fc;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #f3f0fc;
  }
