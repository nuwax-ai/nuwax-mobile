/**
 * 聊天详情页子页签行（chat-subpage-tabs）的标签项。
 *
 * 单聊（个人-个人 / 个人-专家）标题下方的「消息 / Pin / 资料库 / 文件」按钮行；
 * 群聊与群设置后续复用同一组件（群可自行拼装更多标签，如群公告）。
 *
 * UTS: 使用 class，interface 对象字面量初始化会报 UTS110111163（同 chat.uts 约定）。
 */
export class ChatSubpageTab {
  /** 标签标识："messages" 恒为当前消息页（选中态），其余为子页入口。 */
  id: string = "";
  /** 展示文案（调用方走 i18n 取好再传入）。 */
  label: string = "";
  /**
   * 彩色实心图标地址（/static/images/...）。
   * ★选中态【不变图标颜色】（对齐 PC nuwax-im-web DEV-187：选中只改文字色 + 胶囊底色，
   * 图标保持参考图的蓝/青绿/黄饱和色），因此这里用多色 PNG 而非 iconfont 单色图标。
   */
  icon: string = "";
}
