    margin-top: 12rpx;
  }

  .order-feature-title {
    flex-shrink: 0;
    color: #4e53e8;
    font-size: 24rpx;
    font-weight: 600;
    margin-right: 16rpx;
  }

  .order-feature-desc {
    flex: 1;
