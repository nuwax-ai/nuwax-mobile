/**
 * App 分享出去 / 分享进来。
 *
 * 出去：系统分享面板发出 HTTPS 中转页（微信内先打开网页，提示用浏览器打开；
 * 浏览器里再通过 nuwax:// 拉起已安装的 App）。
 * 进来：解析启动参数或中转页回流，落到 pages/share-receive。
 */
import { getApiBaseUrl } from "@/constants/config";
import { hasLoginSession } from "@/utils/authSession";
import { redirectToLoginOnce } from "@/utils/authNavigation";
import { openShareIntoChat } from "@/utils/im/imForwardSession";
import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
import { isQrLoginLink } from "@/utils/qrLogin";

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

const PENDING_KEY = "nuwax_share_pending";
/** 冷启动时 onShow 先拿到的协议，交给启动页进入对应页面。 */
let coldStartScheme = "";

/**
 * 是否启用尚未验收的新分享。
 *
 * false（当前默认）：直接系统分享或复制，不弹出「分享到女娲 / 其他」。
 * true：分享先弹出「分享到女娲 / 其他」。
 * 文件预览、网页预览的外链始终是 `{域名}/m/static/share-open.html`：
 * 微信内点「打开 App」只提示用浏览器打开；其它应用里先看页面内容，再点按钮用 nuwax:// 唤起 App。
 */
export const USE_NEW_ARTIFACT_SHARE = false;

export class ShareTarget {
  kind: string = "";
  id: string = "";
  title: string = "";
  text: string = "";
  sk: string = "";
  filePath: string = "";
  /** 外部分享要直接展示的 http(s) 页面。文件产物留空，中转页按 sk 打开预览。 */
  pageUrl: string = "";
}

function queryValue(raw: string, key: string): string {
  const mark = raw.indexOf("?");
  const query = mark >= 0 ? raw.substring(mark + 1) : raw;
  const parts = query.split("&");
  const prefix = key + "=";
  for (let i = 0; i < parts.length; i++) {
    const part = parts[i];
    if (part.indexOf(prefix) == 0) {
      try {
        const decoded = decodeURIComponent(part.substring(prefix.length));
        return decoded != null ? decoded : part.substring(prefix.length);
      } catch (_e) {
        return part.substring(prefix.length);
      }
    }
  }
  return "";
}

function appendQuery(url: string, key: string, value: string): string {
  if (value.length == 0) return url;
  const join = url.indexOf("?") >= 0 ? "&" : "?";
  return url + join + key + "=" + encodeURIComponent(value);
}

/**
 * 中转页所在站点。
 * App 用当前服务域名；H5 生产环境接口走相对路径、服务域名为空时，用页面自己的 origin。
 */
function sharePageOrigin(): string {
  const api = getApiBaseUrl();
  if (api.length > 0) return api;
  // #ifdef H5 || WEB
  try {
    const origin = window.location.origin;
    const text = origin != null ? `${origin}` : "";
    if (text.length > 0 && text.indexOf("file:") != 0) return text;
  } catch (_e) {
    return "";
  }
  // #endif
  return "";
}

/** 微信 / 浏览器可打开的 HTTPS 中转页。域名缺失时返回空串，调用方不要把相对路径分享出去。 */
export function buildShareOpenUrl(target: ShareTarget): string {
  const base = sharePageOrigin();
  if (base.length == 0) return "";
  let url = base + "/m/static/share-open.html?kind=" + encodeURIComponent(target.kind);
  url = appendQuery(url, "id", target.id);
  url = appendQuery(url, "title", target.title);
  url = appendQuery(url, "sk", target.sk);
  url = appendQuery(url, "text", target.text.length > 180 ? target.text.substring(0, 180) : target.text);
  url = appendQuery(url, "url", target.pageUrl);
  return url;
}

export function buildAppScheme(target: ShareTarget): string {
  let url = "nuwax://open?kind=" + encodeURIComponent(target.kind);
  url = appendQuery(url, "id", target.id);
  url = appendQuery(url, "title", target.title);
  url = appendQuery(url, "sk", target.sk);
  url = appendQuery(url, "text", target.text.length > 180 ? target.text.substring(0, 180) : target.text);
  url = appendQuery(url, "url", target.pageUrl);
  return url;
}

export function parseShareUrl(raw: string): ShareTarget | null {
  if (raw.length == 0) return null;
  // 登录确认有独立的同服务域校验，不能被 query 中的 kind 当成普通分享消费。
  if (isQrLoginLink(raw)) return null;
  const lower = raw.toLowerCase();
  const isScheme = lower.indexOf("nuwax://") >= 0;
  const isPage = lower.indexOf("share-open.html") >= 0 || lower.indexOf("kind=") >= 0;
  if (isScheme != true && isPage != true) return null;
  const target = new ShareTarget();
  target.kind = queryValue(raw, "kind");
  target.id = queryValue(raw, "id");
  target.title = queryValue(raw, "title");
  target.sk = queryValue(raw, "sk");
  target.text = queryValue(raw, "text");
  target.filePath = queryValue(raw, "file");
  const pageTo = queryValue(raw, "to");
  target.pageUrl = pageTo.length > 0 ? pageTo : queryValue(raw, "url");
  if (target.kind.length == 0) return null;
  return target;
}

function readEnterRaw(): string {
  let raw = "";
  // #ifdef APP
  try {
    const enter = uni.getEnterOptionsSync();
    if (enter != null) {
      raw = schemeFromEnterOptions(enter as UTSJSONObject);
    }
  } catch (_e) {
    raw = "";
  }
  // #endif
  return raw;
}

/** uni-app x 把自定义协议放在 appScheme，通用链接放在 appLink，不在 path 里。 */
function schemeFromEnterOptions(enter: UTSJSONObject): string {
  const appScheme = enter["appScheme"] != null ? `${enter["appScheme"]}` : "";
  if (appScheme.indexOf("nuwax://") >= 0) return appScheme;
  const appLink = enter["appLink"] != null ? `${enter["appLink"]}` : "";
  if (appLink.indexOf("share-open.html") >= 0 || appLink.indexOf("nuwax://") >= 0) return appLink;
  const query = enter["query"] as UTSJSONObject | null;
  if (query != null) {
    const link = query["link"] != null ? `${query["link"]}` : "";
    const kind = query["kind"] != null ? `${query["kind"]}` : "";
    if (link.length > 0) return link;
    if (kind.length > 0) return "nuwax://open?kind=" + kind;
  }
  const path = enter["path"] != null ? `${enter["path"]}` : "";
  if (path.indexOf("nuwax") >= 0 || path.indexOf("kind=") >= 0) return path;
  return "";
}

export function saveShareTarget(target: ShareTarget): void {
  const obj = new UTSJSONObject();
  obj["kind"] = target.kind;
  obj["id"] = target.id;
  obj["title"] = target.title;
  obj["text"] = target.text;
  obj["sk"] = target.sk;
  obj["filePath"] = target.filePath;
  obj["pageUrl"] = target.pageUrl;
  uni.setStorageSync(PENDING_KEY, JSON.stringify(obj));
}

export function peekShareTarget(): ShareTarget | null {
  const raw = uni.getStorageSync(PENDING_KEY);
  if (raw == null || `${raw}`.length == 0) return null;
  try {
    const obj = JSON.parse(`${raw}`) as UTSJSONObject;
    const target = new ShareTarget();
    target.kind = obj["kind"] != null ? `${obj["kind"]}` : "";
    target.id = obj["id"] != null ? `${obj["id"]}` : "";
    target.title = obj["title"] != null ? `${obj["title"]}` : "";
    target.text = obj["text"] != null ? `${obj["text"]}` : "";
    target.sk = obj["sk"] != null ? `${obj["sk"]}` : "";
    target.filePath = obj["filePath"] != null ? `${obj["filePath"]}` : "";
    target.pageUrl = obj["pageUrl"] != null ? `${obj["pageUrl"]}` : "";
    if (target.kind.length == 0) return null;
    return target;
  } catch (_e) {
    return null;
  }
}

export function consumeShareTarget(): ShareTarget | null {
  const target = peekShareTarget();
  uni.removeStorageSync(PENDING_KEY);
  return target;
}

let rememberedAgentId = "";
let rememberedAgentTitle = "";

export function rememberShareAgent(id: string, title: string): void {
  rememberedAgentId = id;
  rememberedAgentTitle = title;
}

export function shareRememberedAgent(): void {
  if (rememberedAgentId.length == 0) {
    uni.showToast({ title: t("Mobile.Share.noAgent"), icon: "none" });
    return;
  }
  const target = new ShareTarget();
  target.kind = "agent";
  target.id = rememberedAgentId;
  target.title = rememberedAgentTitle.length > 0 ? rememberedAgentTitle : "女娲智能体";
  const url = buildShareOpenUrl(target);
  chooseShareTarget(target.title, target.title + "\n" + url, () => {
    shareTarget(target);
  });
}

/**
 * 新分享先选去向：分享到女娲（选会话发文本），或交给调用方继续系统分享 / 复制链接。
 * 开关关闭时不弹选择面板，直接走调用方原来的系统分享或复制。
 * 智能体、网页、会话菜单、会话消息、文件预览都从这里出去。
 */
export function chooseShareTarget(title: string, body: string, shareOutside: () => void): void {
  if (USE_NEW_ARTIFACT_SHARE != true) {
    shareOutside();
    return;
  }
  uni.showActionSheet({
    itemList: [t("Mobile.Share.toNuwax"), t("Mobile.Share.toOther")],
    cancelText: t("Mobile.Common.cancel"),
    success: (res) => {
      if (res.tapIndex == 0) {
        if (hasLoginSession() != true) {
          uni.showToast({ title: t("Mobile.Share.loginRequired"), icon: "none" });
          redirectToLoginOnce();
          return;
        }
        const text = body.length > 0 ? body : title;
        openShareIntoChat(title.length > 0 ? title : t("Mobile.Share.appName"), text);
        return;
      }
      shareOutside();
    },
  });
}

/** 唤起系统分享面板，把中转页发给微信等。 */
export function shareTarget(target: ShareTarget): void {
  const url = buildShareOpenUrl(target);
  const title = target.title.length > 0 ? target.title : t("Mobile.Share.appName");
  // #ifdef APP
  uni.shareWithSystem({
    type: "text",
    summary: "【" + title + "】",
    href: url,
    fail: (res: ShareWithSystemFail) => {
      if (res.errCode == 1310600) return;
      uni.setClipboardData({
        data: url,
        success: () => {
          uni.showToast({ title: t("Mobile.Share.linkCopied"), icon: "none" });
        },
      });
    },
  });
  // #endif
  // #ifndef APP
  uni.setClipboardData({
    data: url,
    success: () => {
      uni.showToast({ title: t("Mobile.Share.linkCopied"), icon: "none" });
    },
  });
  // #endif
}

/** 智能体、文件、网页直接进对应页面；其余仍进分享接收页。 */
function openTargetUrl(target: ShareTarget): string {
  if (target.kind == "agent" && target.id.length > 0) {
    return "/subpackages/pages/agent-detail/agent-detail?id=" + encodeURIComponent(target.id);
  }
  const previewUrl = filePreviewUrl(target);
  if (previewUrl.length > 0) {
    return webviewRoute(previewUrl, target.title, true);
  }
  if (isHttpPageUrl(target.pageUrl)) {
    return webviewRoute(target.pageUrl, target.title, isSameApiHost(target.pageUrl) != true);
  }
  return receiveUrl(target);
}

/** 文件分享优先打开带 sk 的预览地址，避免只剩标题时落到「没有可读文本」。 */
function filePreviewUrl(target: ShareTarget): string {
  const pointedAtFile = isHttpPageUrl(target.pageUrl) && target.pageUrl.indexOf("file-preview.html") >= 0;
  if (pointedAtFile) return target.pageUrl;
  if (target.sk.length == 0) return "";
  if (target.kind != "file" && target.kind != "page") return "";
  // 普通网页自己有地址时，不拿 sk 覆盖。
  if (target.kind == "page" && isHttpPageUrl(target.pageUrl)) return "";
  const base = sharePageOrigin();
  if (base.length == 0) return "";
  return base + "/static/file-preview.html?sk=" + encodeURIComponent(target.sk);
}

function webviewRoute(raw: string, title: string, noTicket: boolean): string {
  let page = "/subpackages/pages/webview/webview?url=" + encodeURIComponent(raw);
  if (noTicket) {
    page = page + "&noTicket=1";
  }
  if (title.length > 0) {
    page = page + "&title=" + encodeURIComponent(title);
  }
  return page;
}

function isHttpPageUrl(raw: string): boolean {
  const lower = raw.toLowerCase();
  return lower.indexOf("https://") == 0 || lower.indexOf("http://") == 0;
}

/** 站内页回到 App 后仍走 webview 自己的登录票据；外站不要把 _ticket 拼到别人的域名上。 */
function isSameApiHost(raw: string): boolean {
  const api = getApiBaseUrl().toLowerCase();
  if (api.length == 0) return true;
  return raw.toLowerCase().indexOf(api) == 0;
}

function receiveUrl(target: ShareTarget): string {
  let url = "/pages/share-receive/share-receive?kind=" + encodeURIComponent(target.kind);
  url = appendQuery(url, "id", target.id);
  url = appendQuery(url, "title", target.title);
  url = appendQuery(url, "sk", target.sk);
  url = appendQuery(url, "text", target.text);
  url = appendQuery(url, "file", target.filePath);
  url = appendQuery(url, "to", target.pageUrl);
  url = appendQuery(url, "sk", target.sk);
  return url;
}

/**
 * 冷启动时 onShow 先拿到协议。启动页再取走，避免这次地址被丢掉后进入首页。
 */
export function rememberColdStartScheme(raw: string): void {
  if (raw.length == 0) return;
  coldStartScheme = raw;
}

/** 取走冷启动协议。没有则返回空串，调用方再读本次启动参数。 */
export function takeColdStartScheme(): string {
  const raw = coldStartScheme;
  coldStartScheme = "";
  return raw;
}

/**
 * 冷启动或回前台时按外部链接进入对应页面。
 * 不记录「已经打开过」：每次唤起都进入该页面。
 * 连点由中转页在 App 还没起来时挡住。
 * 智能体 / 文件可未登录打开；文本图片进来需已登录，否则先记下再去登录。
 */
export function routeIncomingShare(hasToken: boolean, schemeFromShow: string): boolean {
  const fromShow = schemeFromShow.length > 0 ? schemeFromShow : "";
  const raw = fromShow.length > 0 ? fromShow : readEnterRaw();
  const target = parseShareUrl(raw);
  if (target == null) return false;
  // 文件和网页靠 sk / 页面地址就能看，不要求先登录。文本、图片、会话摘要仍要登录。
  const inbound = target.kind == "text" || target.kind == "image" || target.kind == "message";
  if (inbound && hasToken != true) {
    saveShareTarget(target);
    return false;
  }
  uni.reLaunch({ url: openTargetUrl(target) });
  return true;
}

export function routePendingAfterLogin(): void {
  const target = peekShareTarget();
  if (target == null) return;
  consumeShareTarget();
  uni.reLaunch({ url: openTargetUrl(target) });
}
