/**
 * 音频转写播放器 - 分段类型
 * 会议详情 / 监控列表等场景共用；字段与 IAppMeetingSegmentView 时间轴对齐
 */

/** 单条转写分段（一句 / 一轮说话） */
export class AudioTranscriptSegment {
  seq: number = 0;
  speaker: string = "";
  text: string = "";
  /** 片段起始毫秒（相对录音开始） */
  startMs: number = 0;
  /** 片段结束毫秒（相对录音开始） */
  endMs: number = 0;

  constructor(seq: number, speaker: string, text: string, startMs: number, endMs: number) {
    this.seq = seq;
    this.speaker = speaker;
    this.text = text;
    this.startMs = startMs;
    this.endMs = endMs;
  }
}
