<template>
  <view class="nkx-demo-page page-container">
    <custom-nav-bar
      title="数学公式渲染测试"
      :show-back="true"
      hasSafetyZone
    >
    </custom-nav-bar>
    <scroll-view class="nkx-scroll" :show-scrollbar="false" direction="vertical">
      <view class="nkx-section" v-for="(g, gi) in groups" :key="gi">
        <text class="nkx-section-title">{{ g.title }}</text>
        <view class="nkx-formula" v-for="(it, ii) in g.items" :key="ii">
          <text class="nkx-formula-desc">{{ it.desc }}</text>
          <view
            class="nkx-formula-body"
            :class="it.block ? 'nkx-formula-block' : 'nkx-formula-inline'"
          >
            <nuwax-katex :tex="it.tex" :display-mode="it.block" />
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import NuwaxKatex from "@/uni_modules/nuwax-katex/components/nuwax-katex/nuwax-katex.uvue";

  /** 公式项 */
  class FormulaItem {
    desc: string = "";
    tex: string = "";
    block: boolean = false;
    constructor(desc: string, tex: string, block: boolean) {
      this.desc = desc;
      this.tex = tex;
      this.block = block;
    }
  }

  /** 分组 */
  class FormulaGroup {
    title: string = "";
    items: Array<FormulaItem> = [];
    constructor(title: string, items: Array<FormulaItem>) {
      this.title = title;
      this.items = items;
    }
  }

  const groups = ref<Array<FormulaGroup>>([
    new FormulaGroup("基础代数", [
      new FormulaItem("勾股定理（行内）", "a^2 + b^2 = c^2", false),
      new FormulaItem("一元二次方程求根公式（块级）", "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}", true),
      new FormulaItem("完全平方公式（行内）", "(a + b)^2 = a^2 + 2ab + b^2", false),
    ]),
    new FormulaGroup("微积分", [
      new FormulaItem("定积分（块级）", "\\int_0^1 x^2 \\, dx = \\frac{1}{3}", true),
      new FormulaItem("指数函数求导（行内）", "\\frac{d}{dx} e^x = e^x", false),
      new FormulaItem("重要极限（块级）", "\\lim_{x \\to 0} \\frac{\\sin x}{x} = 1", true),
    ]),
    new FormulaGroup("矩阵", [
      new FormulaItem("2×2 矩阵（块级）", "\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix}", true),
      new FormulaItem("单位矩阵（块级）", "\\begin{bmatrix} 1 & 0 \\\\ 0 & 1 \\end{bmatrix}", true),
    ]),
    new FormulaGroup("求和与乘积", [
      new FormulaItem("等差数列求和（块级）", "\\sum_{i=1}^{n} i = \\frac{n(n+1)}{2}", true),
      new FormulaItem("阶乘（块级）", "\\prod_{k=1}^{n} k = n!", true),
    ]),
    new FormulaGroup("希腊字母", [
      new FormulaItem("字母组合（行内）", "\\alpha + \\beta + \\gamma = \\delta", false),
      new FormulaItem("字母与运算符（行内）", "\\epsilon \\cdot \\theta \\cdot \\lambda \\cdot \\pi", false),
    ]),
    new FormulaGroup("分数与根号", [
      new FormulaItem("分数通分（块级）", "\\frac{a}{b} + \\frac{c}{d} = \\frac{ad + bc}{bd}", true),
      new FormulaItem("三次根号（行内）", "\\sqrt[3]{x + 1}", false),
    ]),
    new FormulaGroup("上下标与特殊公式", [
      new FormulaItem("欧拉公式（块级）", "e^{i\\pi} + 1 = 0", true),
      new FormulaItem("神经网络激活（块级）", "\\hat{y} = \\sigma(Wx + b)", true),
    ]),
    new FormulaGroup("方程组", [
      new FormulaItem("分段函数/方程组（块级）", "\\begin{cases} x + y = 1 \\\\ x - y = 2 \\end{cases}", true),
    ]),
    new FormulaGroup("物理公式", [
      new FormulaItem("质能方程（行内）", "E = mc^2", false),
      new FormulaItem("万有引力定律（块级）", "F = G\\frac{m_1 m_2}{r^2}", true),
      new FormulaItem("牛顿第二定律（行内）", "\\vec{F} = m\\vec{a}", false),
    ]),
    new FormulaGroup("统计与概率", [
      new FormulaItem("样本均值（块级）", "\\bar{x} = \\frac{1}{n}\\sum_{i=1}^{n} x_i", true),
      new FormulaItem("标准差（块级）", "\\sigma = \\sqrt{\\frac{1}{n}\\sum_{i=1}^{n}(x_i - \\bar{x})^2}", true),
    ]),
    new FormulaGroup("集合与三角", [
      new FormulaItem("集合运算（行内）", "A \\cap B \\cup C", false),
      new FormulaItem("三角恒等式（块级）", "\\sin^2\\theta + \\cos^2\\theta = 1", true),
      new FormulaItem("正切定义（行内）", "\\tan\\theta = \\frac{\\sin\\theta}{\\cos\\theta}", false),
    ]),
  ]);
</script>

