<template>
  <view class="tool-call-group">
    <view class="tool-call-group__header" @tap="toggleExpanded">
      <text class="tool-call-group__title">{{ title }}</text>
      <view class="tool-call-group__summary">
        <text class="tool-call-group__count">{{ visibleCount }} 项</text>
        <text
          class="iconfont icon-a-Chevrondown tool-call-group__arrow"
          :class="{ 'tool-call-group__arrow--expanded': isExpanded }"
        ></text>
      </view>
    </view>
    <view v-if="isExpanded" class="tool-call-group__content">
      <slot />
    </view>
  </view>
</template>

<script setup lang="uts">
  const props = withDefaults(
    defineProps<{
      /** 分组内解析后的工具标签。 */
      items?: any[];
      /** 分组标题。 */
      title?: string;
      /** 当前实时分组内存在执行中的工具时自动展开，结束后自动收起。 */
      autoExpanded?: boolean;
    }>(),
    {
      items: (): any[] => [] as any[],
      title: "工具调用",
      autoExpanded: false,
    },
  );

  const isExpanded = ref<boolean>(false);

  watch(
    (): boolean => props.autoExpanded,
    (expanded: boolean) => {
      isExpanded.value = expanded;
    },
    { immediate: true },
  );

  /** 排除不展示的 Event 类型后计算数量。 */
  const visibleCount = computed((): number => {
    let count = 0;
    const list = props.items;
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      if (item == null) continue;
      const obj = item as UTSJSONObject;
      const type = obj["type"];
      if (type == null || `${type}` != "Event") {
        count++;
      }
    }
    return count;
  });

  function toggleExpanded(): void {
    isExpanded.value = !isExpanded.value;
  }
</script>

<style lang="scss" scoped>
  .tool-call-group {
    width: 100%;
    margin: 8px 0;
    border: 1px solid rgba(28, 31, 40, 0.1);
    border-radius: 8px;
    background-color: #ffffff;
    overflow: hidden;

    &__header {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      // 与 tool-call-card__main / plan-header 同高
      min-height: 36px;
      padding: 0 10px;
      box-sizing: border-box;
      background-color: rgba(18, 23, 43, 0.018);
    }

    &__title {
      color: #33363d;
      font-size: 14px;
      line-height: 20px;
    }

    &__summary {
      display: flex;
      flex-direction: row;
      align-items: center;
    }

    &__count {
      margin-right: 5px;
      color: #8b8e96;
      font-size: 12px;
      line-height: 17px;
    }

    &__arrow {
      color: #8b8e96;
      font-size: 12px;
      transition: transform 0.2s ease;

      &--expanded {
        transform: rotate(180deg);
      }
    }

    &__content {
      padding: 5px 10px 7px;
      border-top: 1px solid rgba(28, 31, 40, 0.07);
      box-sizing: border-box;
    }
  }
</style>
