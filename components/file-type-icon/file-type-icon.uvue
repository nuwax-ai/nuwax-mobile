<template>
  <view class="fti" :style="boxStyle">
    <image class="fti__sheet" :style="boxStyle" :src="sheetSrc" mode="aspectFit" />
    <text class="fti__label" :style="labelStyle">{{ label }}</text>
  </view>
</template>

<script lang="uts" setup>
  import { computed } from "vue";
  import { fileTypeColorOf, fileTypeLabelOf, fileSheetSrc, isUnknownFileType } from "@/utils/imFileCard";

  /**
   * 微信式文件类型图标：纸面 SVG（白底折角文档 / 未知类型灰蓝）+ 叠加彩色类型字
   * （PDF/DOC/XLS/PPT/ZIP/TXT，未知 "?"）。字母不进 SVG，由平台字体渲染保证字形清晰。
   * 类型判定：文件名后缀优先、URL 后缀兜底（口径见 utils/imFileCard）。
   */
  const props = withDefaults(
    defineProps<{
      /** 文件名（含后缀；后缀判定优先用它） */
      fileName?: string;
      /** 文件地址（fileName 无后缀时兜底取 URL 后缀） */
      url?: string;
      /** 图标边长（单位见 unit）。Android：props 运行时可能是 String，故声明 any（svg-icon 同款） */
      size?: any | null;
      /** size 单位：缺省 rpx（随屏缩放）；"px" 供 px 化页面用（宽屏不放大，svg-icon 同口径） */
      unit?: string;
    }>(),
    {
      fileName: "",
      url: "",
      size: 96 as any,
      unit: "rpx",
    },
  );

  /** size 安全转 number（兼容 string / number / NaN） */
  function resolveSize(raw: any | null): number {
    if (raw == null) {
      return 96;
    }
    if (typeof raw == "number") {
      const n = raw as number;
      return n != n ? 96 : n;
    }
    const s = `${raw}`;
    if (s.length == 0) {
      return 96;
    }
    const parsed = parseFloat(s);
    return parsed != parsed ? 96 : parsed;
  }

  const sizeNum = computed((): number => resolveSize(props.size));
  /** size 单位（仅认 "px"，其余一律 rpx——svg-icon 同款） */
  const sizeUnit = computed((): string => (props.unit == "px" ? "px" : "rpx"));

  const label = computed((): string => fileTypeLabelOf(props.fileName, props.url));
  const unknown = computed((): boolean => isUnknownFileType(props.fileName, props.url));
  const sheetSrc = computed((): string => fileSheetSrc(unknown.value));

  /** 容器与纸面同尺寸（正方形） */
  const boxStyle = computed((): string => {
    const s = sizeNum.value;
    return `width: ${s}${sizeUnit.value}; height: ${s}${sizeUnit.value};`;
  });

  /** 类型字：叠在纸面下部居中；未知 "?" 白字放大居中偏上 */
  const labelStyle = computed((): string => {
    const s = sizeNum.value;
    const fs = unknown.value ? Math.round(s * 0.38) : Math.round(s * 0.21);
    const top = unknown.value ? Math.round(s * 0.3) : Math.round(s * 0.55);
    const color = fileTypeColorOf(props.fileName, props.url);
    return `position: absolute; left: 0; right: 0; top: ${top}${sizeUnit.value}; text-align: center; font-size: ${fs}${sizeUnit.value}; line-height: ${fs}${sizeUnit.value}; font-weight: 600; color: ${color};`;
  });
</script>

<style scoped>
  .fti {
    position: relative;
  }

  .fti__sheet {
    display: flex;
  }
</style>
