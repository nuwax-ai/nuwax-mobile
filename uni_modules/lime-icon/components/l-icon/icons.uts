// #ifndef APP-ANDROID || APP-HARMONY
import iconList from '../../static/icons.json';
export const icons = ref<Map<string, any | null>>((iconList as UTSJSONObject).toMap())
// #endif
// #ifdef APP-ANDROID || APP-HARMONY
import { getInlineIcons } from './icons-inline'
export const icons = ref<Map<string, any | null>>(new Map<string, any | null>())

if (icons.value.size == 0) {
	uni.getFileSystemManager().readFile({
		// #ifdef APP-HARMONY
		filePath: '/uni_modules/lime-icon/static/icons.json',
		// #endif
		// #ifndef APP-HARMONY
		filePath: 'uni_modules/lime-icon/static/icons.json',
		// #endif
		encoding: 'utf-8',
		success: (res) => {
			const obj = JSON.parseObject(res.data as string)
			if (obj != null) {
				icons.value = obj!.toMap()
			} else {
				// 文件读到但解析为空：兜底内联（理论上不应发生，保持健壮）
				icons.value = getInlineIcons()
			}
		},
		fail: (err) => {
			// debug/assembleDebug 基座 www 在 apk assets 不落盘 /storage → FileNotFound(1300002)。
			// 此时图标会全方框；正式包 readFile 成功走上面的分支。debug 基座用内联兜底保证图标显示。
			console.log('[lime-icon] readFile fail, fallback to inline icons', err)
			icons.value = getInlineIcons()
		}
	} as ReadFileOptions);
}
// #endif