/**
 * IM 附件展示公用工具：类型分类（kind/扩展名）与 URL 闸门。
 *
 * 消费方：聊天页（发送/收件分类）、会话文件页（im-group-files，服务端附件行
 * 映射时的 kind 兜底与 url 闸门）。★文件页数据源已改服务端分页（apiImConvFiles，
 * 对齐 PC DEV-300），原先「聊天窗口已加载消息」的附件快照缓存已随之下线。
 */

// ===== 类型分类（对齐 PC attachment.ts 的扩展名集合；聊天页与文件页共用） =====

const VIDEO_EXTS: string[] = ["mp4", "mov", "m4v", "webm", "mkv", "avi", "wmv", "flv", "mpeg", "mpg", "3gp"];
const AUDIO_EXTS: string[] = ["mp3", "wav", "m4a", "aac", "flac", "ogg", "opus", "wma", "amr", "aiff"];
const IMAGE_EXTS: string[] = ["png", "jpg", "jpeg", "gif", "webp", "bmp", "svg", "heic", "avif"];

/** UTSJSONObject 字段读取（字符串/数字，null 安全）：文件页服务端行映射等共用。 */
export function readString(obj: UTSJSONObject, key: string): string {
  const raw = obj[key];
  return raw != null ? `${raw}` : "";
}

export function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
  const raw = obj[key];
  if (raw == null) {
    return fallback;
  }
  const parsed = parseFloat(`${raw}`);
  return isNaN(parsed) ? fallback : parsed;
}

/** 文件名后缀（小写、无点；没有点或点在末尾时返回空串）。 */
export function extOf(name: string): string {
  const lower = name.toLowerCase();
  const dot = lower.lastIndexOf(".");
  if (dot <= 0 || dot == lower.length - 1) {
    return "";
  }
  return lower.substring(dot + 1);
}

/** URL 路径末段的后缀（先剥 query/hash 与 scheme://host，避免 ?x=.png、裸域名 TLD 误判）。 */
export function urlExtOf(url: string): string {
  let path = url;
  const hashIdx = path.indexOf("#");
  if (hashIdx >= 0) {
    path = path.substring(0, hashIdx);
  }
  const queryIdx = path.indexOf("?");
  if (queryIdx >= 0) {
    path = path.substring(0, queryIdx);
  }
  // 剥掉协议与 host（含 //host 协议相对形态）：裸域名（https://a.b.com）无路径，
  // TLD（.com/.cn）不是文件后缀，否则会被 isFileUrlByExt 判成文件直接下载
  let hasAuthority = false;
  const schemeIdx = path.indexOf("://");
  if (schemeIdx >= 0) {
    path = path.substring(schemeIdx + 3);
    hasAuthority = true;
  } else if (path.indexOf("//") == 0) {
    path = path.substring(2);
    hasAuthority = true;
  }
  if (hasAuthority) {
    const authorityEnd = path.indexOf("/");
    if (authorityEnd < 0) {
      return "";
    }
    path = path.substring(authorityEnd);
  }
  const slashIdx = path.lastIndexOf("/");
  const seg = slashIdx >= 0 ? path.substring(slashIdx + 1) : path;
  return extOf(seg);
}

/** mime/扩展名兜底分类：image | video | audio | file。 */
export function classifyKind(mime: string, url: string): string {
  if (mime.indexOf("image/") == 0) {
    return "image";
  }
  if (mime.indexOf("video/") == 0) {
    return "video";
  }
  if (mime.indexOf("audio/") == 0) {
    return "audio";
  }
  const ext = urlExtOf(url);
  if (ext.length > 0) {
    if (VIDEO_EXTS.indexOf(ext) >= 0) {
      return "video";
    }
    if (AUDIO_EXTS.indexOf(ext) >= 0) {
      return "audio";
    }
    if (IMAGE_EXTS.indexOf(ext) >= 0) {
      return "image";
    }
  }
  return "file";
}

/** 附件 kind 字段是否可认（认不出按 mime/扩展名重分类，比 PC 直接归 file 更准）。 */
export function isValidKind(kind: string): boolean {
  return (
    kind == "image" || kind == "file" || kind == "video" || kind == "audio"
  );
}

/** URL 是否可用（http(s) 绝对地址或 / 开头的相对地址；其余如 data: 一律不入列）。 */
export function isUsableUrl(url: string): boolean {
  if (url.length == 0) {
    return false;
  }
  return (
    url.indexOf("http://") == 0 ||
    url.indexOf("https://") == 0 ||
    url.indexOf("/") == 0
  );
}
