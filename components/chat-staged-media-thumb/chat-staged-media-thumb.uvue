<template>
  <view class="thumb" @click="emit('preview')">
    <chat-staged-spinner v-if="kind != 'video'" />
    <image v-if="kind != 'video'" class="cover" :src="path" mode="aspectFill" />
    <image v-else-if="poster.length > 0" class="cover" :src="poster" mode="aspectFill" />
    <view v-if="kind == 'video'" class="play"><text class="play-text">▶</text></view>
  </view>
</template>

<script setup lang="uts">
  defineProps({
    path: { type: String, default: "" },
    kind: { type: String, default: "image" },
    poster: { type: String, default: "" },
  });
  const emit = defineEmits<{ (e: "preview"): void }>();
</script>

<style lang="scss" scoped>
  .thumb { width: 70px; height: 70px; position: relative; background-color: #f2f3f5; border-radius: 4px; overflow: hidden; }
  .cover { width: 70px; height: 70px; position: relative; }
  .play { position: absolute; left: 20px; top: 20px; width: 30px; height: 30px; border-radius: 15px; background-color: rgba(0, 0, 0, 0.5); align-items: center; justify-content: center; }
  .play-text { color: #ffffff; font-size: 16px; }
</style>
