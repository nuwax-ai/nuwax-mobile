/** ESP-IDF 6.0 network_provisioning 跨页面单一会话 Controller。 */
import { ref, type Ref } from 'vue';
import type { EspProvisioningClient } from '@/utils/provisioning/espProvisioningClient';
import {
  createEspProvisioningClient,
  hasEspProvisioningClientProvider,
} from '@/utils/provisioning/espProvisioningClientFactory';
import { MockEspProvisioningClient } from '@/utils/provisioning/mockEspProvisioningClient';
import { UnavailableEspProvisioningClient } from '@/utils/provisioning/unavailableEspProvisioningClient';
import { isUsingMock } from '@/utils/ble/bleAdapterFactory';
import {
  EspProvisioningCapabilities,
  EspProvisioningConfig,
  EspProvisioningDevice,
  EspProvisioningDeviceInfo,
  EspProvisioningError,
  EspProvisioningProgress,
  EspProvisioningQrParseResult,
  EspWifiNetwork,
} from '@/types/interfaces/espProvisioning';
import {
  EspProvisioningErrorCodeEnum,
  EspProvisioningPhaseEnum,
  EspProvisioningSecurityEnum,
} from '@/types/enums/espProvisioning';
import { ProvisionError } from '@/types/interfaces/provision';
import { ProvisionRetryActionEnum } from '@/types/enums/provision';
import {
  ESP_PROV_CONNECT_TIMEOUT_MS,
  ESP_PROV_DEFAULT_DEVICE_PREFIX,
  ESP_PROV_DEFAULT_SERVICE_UUID,
  ESP_PROV_SCAN_TIMEOUT_MS,
  ESP_PROV_STATUS_TIMEOUT_MS,
  ESP_PROV_REQUIRED_CAPABILITY,
  ESP_PROV_OPTIONAL_SCAN_CAPABILITY,
} from '@/constants/espProvisioning.constants';
import { validatePassword, validateSsid } from '@/utils/provisionProtocol';
import { parseEspProvisioningQr } from '@/utils/provisioning/espProvisioningQr';
import { getQrPayload } from '@/utils/provisionSession';
import { apiVoxBindDevice } from '@/servers/vox/voxDevice';
import { AppDeviceBindParams } from '@/types/interfaces/voxDevice';
import { apiResCode, apiResData, apiResMessage } from '@/utils/common';
import { SUCCESS_CODE } from '@/constants/codes.constants';

/** 固件接收 vox 配置的自定义 endpoint（deviceSecret + gatewayUrl） */
const VOX_CONFIG_ENDPOINT = 'vox-config';

export class EspProvisioningController {
  phase: Ref<EspProvisioningPhaseEnum>;
  failedPhase: Ref<EspProvisioningPhaseEnum>;
  scannedDevices: Ref<EspProvisioningDevice[]>;
  error: Ref<ProvisionError | null>;
  connectedSsid: Ref<string>;
  capabilities: Ref<EspProvisioningCapabilities | null>;
  deviceInfo: Ref<EspProvisioningDeviceInfo | null>;
  busy: Ref<boolean>;

  private client: EspProvisioningClient;
  private initialized = false;
  private disposed = false;
  private currentDevice: EspProvisioningDevice | null = null;
  private pendingSsid = '';
  private pendingPassword = '';
  private retryAction: ProvisionRetryActionEnum = ProvisionRetryActionEnum.NONE;
  // 仅当本次 WiFi 下发已开始、等待结果时发生断连，才允许重连后恢复设备终态。
  // 用户修改 WiFi 后发起的是新尝试，不能消费 device-info 中上一次遗留的失败结果。
  private recoverOutcomeOnReconnect = false;
  // 本次配网会话内已绑定设备的缓存：RECONNECT 重连后跳过二次 bind，复用已下发密钥，
  // 避免后端对已绑设备返错（mock 1002）或重置 secret。仅内存持有，dispose 清空。
  private boundDeviceId = '';
  private boundSecret = '';
  private boundWebsocketUrl = '';
  private config: EspProvisioningConfig;

  constructor() {
    this.client = isUsingMock()
      ? new MockEspProvisioningClient()
      : (hasEspProvisioningClientProvider() ? createEspProvisioningClient() : new UnavailableEspProvisioningClient());
    this.phase = ref<EspProvisioningPhaseEnum>(EspProvisioningPhaseEnum.IDLE);
    this.failedPhase = ref<EspProvisioningPhaseEnum>(EspProvisioningPhaseEnum.IDLE);
    this.scannedDevices = ref<EspProvisioningDevice[]>([] as EspProvisioningDevice[]);
    this.error = ref<ProvisionError | null>(null);
    this.connectedSsid = ref<string>('');
    this.capabilities = ref<EspProvisioningCapabilities | null>(null);
    this.deviceInfo = ref<EspProvisioningDeviceInfo | null>(null);
    this.busy = ref<boolean>(false);
    this.config = this.createDefaultConfig();

    this.client.onDeviceFound((device: EspProvisioningDevice) => this.handleDeviceFound(device));
    this.client.onProgress((progress: EspProvisioningProgress) => this.handleProgress(progress));
    this.client.onLog((level: string, event: string, detail: string) => {
      console.log(`[EspProvisioning][${level}] ${event} ${detail}`);
    });
  }

  /** 二维码解析完成后覆盖默认安全参数，仅保存在当前 Controller 内存。 */
  configureSecurity(
    security: EspProvisioningSecurityEnum,
    username: string,
    proofOfPossession: string,
    deviceNamePrefix: string,
  ): void {
    this.config.security = security;
    this.config.username = username;
    this.config.proofOfPossession = proofOfPossession;
    if (deviceNamePrefix != '') this.config.deviceNamePrefix = deviceNamePrefix;
  }

  /** 生产扫码入口：解析后只把 Security 2 材料保存在当前内存会话。 */
  configureFromQr(raw: string): EspProvisioningQrParseResult {
    const result = parseEspProvisioningQr(raw, false);
    const payload = result.payload;
    if (payload != null) {
      this.configureSecurity(
        payload.security,
        payload.username,
        payload.proofOfPossession,
        payload.name,
      );
    }
    return result;
  }

  async startScan(): Promise<void> {
    this.ensureActive();
    this.error.value = null;
    this.scannedDevices.value = [] as EspProvisioningDevice[];
    this.busy.value = true;
    try {
      if (!this.initialized) {
        await this.client.initialize(this.config);
        this.initialized = true;
      }
      this.phase.value = EspProvisioningPhaseEnum.SCANNING;
      await this.client.startScan();
    } catch (e) {
      this.fail(this.asEspError(e), ProvisionRetryActionEnum.RESCAN);
    } finally {
      this.busy.value = false;
    }
  }

  stopScan(): void {
    this.client.stopScan().catch(() => {});
    if (this.phase.value == EspProvisioningPhaseEnum.SCANNING) {
      this.phase.value = EspProvisioningPhaseEnum.IDLE;
    }
  }

  async selectAndPrepare(
    device: EspProvisioningDevice,
    ssid: string = '',
    password: string = '',
  ): Promise<boolean> {
    const recoverPreviousOutcome = this.recoverOutcomeOnReconnect;
    this.recoverOutcomeOnReconnect = false;
    this.ensureActive();
    this.stopScan();
    this.currentDevice = device;
    if (ssid != '') {
      this.pendingSsid = ssid;
      this.pendingPassword = password;
    }
    this.error.value = null;
    this.busy.value = true;
    let lastError = null as EspProvisioningError | null;

    if (!isUsingMock() && (this.config.username == '' || this.config.proofOfPossession == '')) {
      this.fail(new EspProvisioningError(
        EspProvisioningErrorCodeEnum.SECURITY_AUTH_FAILED,
        '缺少 Security 2 username 或 PoP',
        'Security 2 credentials must come from QR or controlled integration input',
        0,
        false,
      ), ProvisionRetryActionEnum.NONE);
      return false;
    }

    try {
      if (!this.initialized) {
        await this.client.initialize(this.config);
        this.initialized = true;
      }
    } catch (e) {
      this.fail(this.asEspError(e), ProvisionRetryActionEnum.RECONNECT);
      return false;
    }

    for (let attempt = 0; attempt < 3; attempt++) {
      try {
        await this.client.connect(device);
        const capabilities = await this.client.getCapabilities();
        if (capabilities.securityVersion != 2) {
          this.fail(new EspProvisioningError(
            EspProvisioningErrorCodeEnum.SECURITY_MISMATCH,
            '固件没有启用 Security 2',
            `sec_ver=${capabilities.securityVersion}`,
            0,
            false,
          ), ProvisionRetryActionEnum.NONE);
          return false;
        }
        if (!capabilities.has(ESP_PROV_REQUIRED_CAPABILITY)) {
          this.fail(new EspProvisioningError(
            EspProvisioningErrorCodeEnum.SERVICE_MISMATCH,
            '固件缺少 wifi_prov capability',
            capabilities.capabilities.join(','),
            0,
            false,
          ), ProvisionRetryActionEnum.NONE);
          return false;
        }
        this.capabilities.value = capabilities;
        this.phase.value = EspProvisioningPhaseEnum.ESTABLISHING_SESSION;
        const info = await this.client.getDeviceInfo();
        if (info.serialNumber == '') {
          this.fail(new EspProvisioningError(
            EspProvisioningErrorCodeEnum.SERVICE_MISMATCH,
            'device-info 缺少 serialNumber',
            '',
            0,
            false,
          ), ProvisionRetryActionEnum.NONE);
          return false;
        }
        // 冻结契约 §3：username 非空时校验 device-info.serialNumber == username（手动链路 username 来自受控输入）
        if (this.config.username != '' && info.serialNumber != this.config.username) {
          this.fail(new EspProvisioningError(
            EspProvisioningErrorCodeEnum.DEVICE_ID_MISMATCH,
            '设备身份不匹配，已停止配网',
            'device-info.serialNumber != username',
            0,
            false,
          ), ProvisionRetryActionEnum.NONE);
          return false;
        }
        this.deviceInfo.value = info;
        // lastProvisioningOutcome 是设备保存的最近一次终态。仅断连恢复当前尝试时消费；
        // 新凭据尝试若无条件消费，会被上一次 auth_failed 提前中止，导致新密码根本没有下发。
        if (recoverPreviousOutcome && this.applyRecoveredOutcome(info)) return false;
        this.phase.value = EspProvisioningPhaseEnum.READY;
        this.busy.value = false;
        return true;
      } catch (e) {
        lastError = this.asEspError(e);
        if (attempt < 2) await this.sleep(1000 * (attempt + 1));
      }
    }

    if (lastError == null) {
      lastError = new EspProvisioningError(
        EspProvisioningErrorCodeEnum.CONNECT_FAILED,
        'BLE 连接失败',
      );
    }
    this.fail(lastError!!, ProvisionRetryActionEnum.RECONNECT);
    return false;
  }

  /**
   * 扫码直连的准备流程：用 QR 凭据配置安全参数，按 QR name 直连设备，
   * 后续校验 capabilities / 读 device-info 与 selectAndPrepare 一致。成功 phase=READY。
   */
  async selectAndPrepareFromQr(): Promise<boolean> {
    const recoverPreviousOutcome = this.recoverOutcomeOnReconnect;
    this.recoverOutcomeOnReconnect = false;
    this.ensureActive();
    const qr = getQrPayload();
    if (qr == null) {
      this.fail(new EspProvisioningError(
        EspProvisioningErrorCodeEnum.SECURITY_AUTH_FAILED,
        '缺少二维码凭据，无法直连',
        'QR payload missing from session',
        0,
        false,
      ), ProvisionRetryActionEnum.NONE);
      return false;
    }
    this.configureSecurity(qr.security, qr.username, qr.proofOfPossession, qr.name);
    this.error.value = null;
    this.busy.value = true;

    try {
      if (!this.initialized) {
        await this.client.initialize(this.config);
        this.initialized = true;
      }
    } catch (e) {
      this.fail(this.asEspError(e), ProvisionRetryActionEnum.RECONNECT);
      return false;
    }

    let lastError = null as EspProvisioningError | null;
    for (let attempt = 0; attempt < 3; attempt++) {
      try {
        await this.client.connectFromQr(qr);
        const capabilities = await this.client.getCapabilities();
        if (capabilities.securityVersion != 2) {
          this.fail(new EspProvisioningError(
            EspProvisioningErrorCodeEnum.SECURITY_MISMATCH,
            '固件没有启用 Security 2',
            `sec_ver=${capabilities.securityVersion}`,
            0,
            false,
          ), ProvisionRetryActionEnum.NONE);
          return false;
        }
        if (!capabilities.has(ESP_PROV_REQUIRED_CAPABILITY)) {
          this.fail(new EspProvisioningError(
            EspProvisioningErrorCodeEnum.SERVICE_MISMATCH,
            '固件缺少 wifi_prov capability',
            capabilities.capabilities.join(','),
            0,
            false,
          ), ProvisionRetryActionEnum.NONE);
          return false;
        }
        this.capabilities.value = capabilities;
        this.phase.value = EspProvisioningPhaseEnum.ESTABLISHING_SESSION;
        const info = await this.client.getDeviceInfo();
        if (info.serialNumber == '') {
          this.fail(new EspProvisioningError(
            EspProvisioningErrorCodeEnum.SERVICE_MISMATCH,
            'device-info 缺少 serialNumber',
            '',
            0,
            false,
          ), ProvisionRetryActionEnum.NONE);
          return false;
        }
        // 冻结契约 §3：Security 2 后必须校验 device-info.serialNumber == QR username，
        // 不一致禁止下发 Wi-Fi 凭据。
        if (qr.username != '' && info.serialNumber != qr.username) {
          this.fail(new EspProvisioningError(
            EspProvisioningErrorCodeEnum.DEVICE_ID_MISMATCH,
            '设备身份不匹配，已停止配网',
            'device-info.serialNumber != qr.username',
            0,
            false,
          ), ProvisionRetryActionEnum.NONE);
          return false;
        }
        this.deviceInfo.value = info;
        // 与手动扫描链路一致：新尝试忽略历史终态，仅断连恢复当前尝试时消费。
        if (recoverPreviousOutcome && this.applyRecoveredOutcome(info)) return false;
        this.phase.value = EspProvisioningPhaseEnum.READY;
        this.busy.value = false;
        return true;
      } catch (e) {
        lastError = this.asEspError(e);
        // 未发现设备或扫描器启动失败时，重复完整的 30 秒发现窗口只会放大等待时间，
        // 还可能触发 Android BLE 扫描频率限制；仅真实连接/握手失败才进入重试。
        if (
          lastError!!.code == EspProvisioningErrorCodeEnum.DEVICE_NOT_FOUND ||
          lastError!!.code == EspProvisioningErrorCodeEnum.SCAN_FAILED ||
          lastError!!.code == EspProvisioningErrorCodeEnum.BLUETOOTH_OFF ||
          lastError!!.code == EspProvisioningErrorCodeEnum.NO_PERMISSION
        ) break;
        if (attempt < 2) await this.sleep(1000 * (attempt + 1));
      }
    }

    if (lastError == null) {
      lastError = new EspProvisioningError(
        EspProvisioningErrorCodeEnum.CONNECT_FAILED,
        'BLE 连接失败',
      );
    }
    this.fail(lastError!!, ProvisionRetryActionEnum.RECONNECT);
    return false;
  }

  /**
   * 让设备扫描它附近的可用 AP。设备不支持 wifi_scan 能力时返回空数组（页面降级为手动输入）。
   */
  async scanDeviceNetworks(): Promise<EspWifiNetwork[]> {
    this.ensureActive();
    const caps = this.capabilities.value;
    if (caps == null || !caps.has(ESP_PROV_OPTIONAL_SCAN_CAPABILITY)) {
      return [] as EspWifiNetwork[];
    }
    this.error.value = null;
    if (this.phase.value == EspProvisioningPhaseEnum.FAILED) {
      this.phase.value = EspProvisioningPhaseEnum.READY;
    }
    try {
      return await this.client.scanNetworks();
    } catch (e) {
      this.fail(this.asEspError(e), ProvisionRetryActionEnum.RECONNECT);
      return [] as EspWifiNetwork[];
    }
  }

  async provision(ssid: string, password: string): Promise<void> {
    this.ensureActive();
    if (!validateSsid(ssid)) {
      this.fail(new EspProvisioningError(
        EspProvisioningErrorCodeEnum.SEND_CONFIG_FAILED,
        'SSID 长度非法',
        '',
        0,
        false,
      ), ProvisionRetryActionEnum.NONE);
      return;
    }
    if (!validatePassword(password)) {
      this.fail(new EspProvisioningError(
        EspProvisioningErrorCodeEnum.SEND_CONFIG_FAILED,
        'WiFi 密码长度非法',
        '',
        0,
        false,
      ), ProvisionRetryActionEnum.NONE);
      return;
    }

    this.pendingSsid = ssid;
    this.pendingPassword = password;
    this.error.value = null;
    this.busy.value = true;
    this.recoverOutcomeOnReconnect = false;
    try {
      await this.client.provision(ssid, password);
      this.connectedSsid.value = ssid;
      this.phase.value = EspProvisioningPhaseEnum.SUCCESS;
      this.retryAction = ProvisionRetryActionEnum.NONE;
    } catch (e) {
      const err = this.asEspError(e);
      this.recoverOutcomeOnReconnect = err.code == EspProvisioningErrorCodeEnum.DISCONNECTED;
      const action = err.code == EspProvisioningErrorCodeEnum.DISCONNECTED
        ? ProvisionRetryActionEnum.RECONNECT
        : ProvisionRetryActionEnum.REWRITE;
      this.fail(err, action);
    } finally {
      this.busy.value = false;
    }
  }

  async retry(): Promise<void> {
    if (this.error.value == null || !this.error.value!!.retryable) return;
    if (this.retryAction == ProvisionRetryActionEnum.RESCAN) {
      await this.startScan();
      return;
    }
    if (this.retryAction == ProvisionRetryActionEnum.RECONNECT) {
      const device = this.currentDevice;
      const ok = device != null
        ? await this.selectAndPrepare(device)
        : (getQrPayload() != null ? await this.selectAndPrepareFromQr() : false);
      if (!ok) {
        // gap B 修复：selectAndPrepare 失败若因 applyRecoveredOutcome 命中设备上次失败终态
        //（auth_failed/network_not_found/timeout 等），retryAction 已被置 REWRITE，而 BLE 会话
        // 实际已就绪 → 清失败态 fall-through 继续 provision，避免「重新连接」要点两次才生效。
        if (this.retryAction == ProvisionRetryActionEnum.REWRITE) {
          this.error.value = null;
          this.phase.value = EspProvisioningPhaseEnum.READY;
          this.busy.value = true;
          console.log('[ProvisionRetry] RECONNECT 命中设备上次失败终态，fall-through 直接 provision');
        } else {
          if (device == null && getQrPayload() == null) {
            this.fail(new EspProvisioningError(
              EspProvisioningErrorCodeEnum.CONNECT_FAILED,
              '设备未连接，请重新选择设备后配网',
              'retry RECONNECT without device or QR payload',
              0,
              false,
            ), ProvisionRetryActionEnum.NONE);
          }
          console.warn('[ProvisionRetry] selectAndPrepare 未就绪，失败态已由内部 fail 设置');
          return;
        }
      }
      // 重连后 Security 2 会话重建，须在 provision 前重新下发 vox-config；
      // bindAndDeliverSecret 内部对已绑定设备复用缓存密钥，跳过二次 bind。
      const delivered = await this.bindAndDeliverSecret("");
      if (!delivered) {
        console.warn('[ProvisionRetry] bindAndDeliverSecret 未成功，失败态已由内部 fail 设置');
        return;
      }
    }
    await this.provision(this.pendingSsid, this.pendingPassword);
  }

  /** 当前官方协议尚未冻结 reset custom endpoint，先明确返回 false。 */
  resetDevice(): Promise<boolean> {
    return Promise.resolve(false);
  }

  /**
   * WiFi 配网前调用：绑定设备到 App 账号并把 deviceSecret + gatewayUrl
   * 经加密会话下发到固件 vox-config 端点。必须在 provision 之前（Security 2 会话还活着），
   * WiFi 一成功 SDK 会清理会话，之后再 sendCustomData 会 SECURITY_AUTH_FAILED。
   * 失败进失败页（fail），由 retry 重做整个流程。
   */
  async bindAndDeliverSecret(displayName: string): Promise<boolean> {
    this.ensureActive();
    const info = this.deviceInfo.value;
    if (info == null || info.serialNumber == '') {
      this.fail(new EspProvisioningError(
        EspProvisioningErrorCodeEnum.SEND_CONFIG_FAILED,
        '缺少 serialNumber，无法绑定设备',
        'device-info missing serialNumber',
        0,
        true,
      ), ProvisionRetryActionEnum.RECONNECT);
      return false;
    }
    this.phase.value = EspProvisioningPhaseEnum.BINDING_DEVICE;
    const deviceId = info.serialNumber;
    // 三字段来源：
    //   deviceId     = device-info.serialNumber
    //   deviceSecret = bind 接口返回的最新值（不生成/不改写/不写死）
    //   gatewayUrl   = bind 接口返回的 websocketUrl（不在前端拼接）
    // 任一来源失败即停止，不得继续下发 Wi-Fi 凭据。
    let secret = '';
    let websocketUrl = '';
    // RECONNECT 重连后：同一设备本次会话已绑定过则复用密钥，跳过二次 bind，
    // 避免后端对已绑设备返错（mock 1002）或重置 secret。
    if (this.boundDeviceId == deviceId && this.boundSecret != '' && this.boundWebsocketUrl != '') {
      secret = this.boundSecret;
      websocketUrl = this.boundWebsocketUrl;
      console.log(`[VoxBind] 复用本次会话已下发密钥，跳过二次 bind deviceId=${deviceId}`);
    } else {
      const params = new AppDeviceBindParams();
      params.deviceId = deviceId;
      params.displayName = displayName != '' ? displayName : deviceId;
      try {
        const res = await apiVoxBindDevice(params);
        if (apiResCode(res) != SUCCESS_CODE) {
          this.fail(new EspProvisioningError(
            EspProvisioningErrorCodeEnum.SEND_CONFIG_FAILED,
            '设备绑定失败',
            `bind code=${apiResCode(res)} msg=${apiResMessage(res)}`,
            0,
            true,
          ), ProvisionRetryActionEnum.RECONNECT);
          return false;
        }
        const raw = apiResData<any>(res);
        const data = raw != null ? (raw as UTSJSONObject) : null;
        const secretVal = data != null ? data['deviceSecret'] : null;
        const websocketUrlVal = data != null ? data['websocketUrl'] : null;
        secret = secretVal != null ? `${secretVal}` : '';
        websocketUrl = websocketUrlVal != null ? `${websocketUrlVal}` : '';
      } catch (e) {
        const err = this.asEspError(e);
        console.error(`[VoxBind] bind 异常 deviceId=${deviceId} | code=${err.code} | detail=${err.detail} | nativeCode=${err.nativeCode}`);
        this.fail(err, ProvisionRetryActionEnum.RECONNECT);
        return false;
      }
      if (secret == '') {
        this.fail(new EspProvisioningError(
          EspProvisioningErrorCodeEnum.SEND_CONFIG_FAILED,
          '绑定响应缺少 deviceSecret',
          'bind response missing deviceSecret',
          0,
          true,
        ), ProvisionRetryActionEnum.RECONNECT);
        return false;
      }
      if (websocketUrl == '') {
        this.fail(new EspProvisioningError(
          EspProvisioningErrorCodeEnum.SEND_CONFIG_FAILED,
          '绑定响应缺少 websocketUrl',
          'bind response missing websocketUrl',
          0,
          true,
        ), ProvisionRetryActionEnum.RECONNECT);
        return false;
      }
      // 缓存绑定结果供本次会话 RECONNECT 复用（仅内存，不落盘）
      this.boundDeviceId = deviceId;
      this.boundSecret = secret;
      this.boundWebsocketUrl = websocketUrl;
    }
    // 扁平 payload：仅 deviceId/gatewayUrl/deviceSecret，无 op/bundle/credentialId/signature。
    // deviceSecret 仅内存持有，随 payload 下发后即弃，勿写 storage / 日志。
    const payload = new UTSJSONObject();
    payload['deviceId'] = deviceId;
    payload['gatewayUrl'] = websocketUrl;
    payload['deviceSecret'] = secret;
    const payloadJson = JSON.stringify(payload);
    console.log(`[VoxBind] 下发 vox-config deviceId=${deviceId} gatewayUrl=${websocketUrl}`);
    try {
      const resp = await this.client.sendCustomData(VOX_CONFIG_ENDPOINT, payloadJson);
      // 响应必须为 {ok:true,state:'active',deviceId}，且不得回显 deviceSecret
      let parsed = null as UTSJSONObject | null;
      try {
        parsed = JSON.parse(resp) as UTSJSONObject;
      } catch (e) {
        this.fail(new EspProvisioningError(
          EspProvisioningErrorCodeEnum.VOX_CONFIG_INVALID,
          'vox-config 响应解析失败',
          'non-JSON response',
          0,
          true,
        ), ProvisionRetryActionEnum.RECONNECT);
        return false;
      }
      const respObj = parsed!!;
      const okVal = respObj['ok'];
      const ok = okVal != null && `${okVal}` == 'true';
      const stateVal = respObj['state'];
      const state = stateVal != null ? `${stateVal}` : '';
      const respDeviceIdVal = respObj['deviceId'];
      const respDeviceId = respDeviceIdVal != null ? `${respDeviceIdVal}` : '';
      if (!ok || state != 'active' || respDeviceId != deviceId) {
        const errVal = respObj['error'];
        const errStr = errVal != null ? `${errVal}` : `ok=${ok} state=${state} deviceId=${respDeviceId}`;
        // 设备报告写 NVS 失败 → PERSIST_FAILED，其余字段/身份非法 → INVALID
        const lower = errStr.toLowerCase();
        const isPersist = lower.indexOf('persist') >= 0 || lower.indexOf('nvs') >= 0;
        this.fail(new EspProvisioningError(
          isPersist
            ? EspProvisioningErrorCodeEnum.VOX_CONFIG_PERSIST_FAILED
            : EspProvisioningErrorCodeEnum.VOX_CONFIG_INVALID,
          isPersist ? '设备保存配置失败' : 'vox-config 被设备拒绝',
          errStr,
          0,
          true,
        ), ProvisionRetryActionEnum.RECONNECT);
        return false;
      }
      console.log(`[VoxBind] vox-config 下发成功 deviceId=${deviceId} state=${state}`);
      return true;
    } catch (e) {
      const err = this.asEspError(e);
      // err.message = 原生 ESPSessionError.description（sessionNotEstablished/securityMismatch/encryptionError/sendDataError）
      console.error(`[VoxBind] vox-config 下发异常 deviceId=${deviceId} | code=${err.code} | msg=${err.message} | detail=${err.detail} | nativeCode=${err.nativeCode}`);
      this.fail(err, ProvisionRetryActionEnum.RECONNECT);
      return false;
    }
  }

  async disconnect(): Promise<void> {
    await this.client.disconnect();
    this.phase.value = EspProvisioningPhaseEnum.IDLE;
  }

  dispose(): void {
    if (this.disposed) return;
    this.disposed = true;
    this.client.dispose();
    this.pendingSsid = '';
    this.pendingPassword = '';
    this.recoverOutcomeOnReconnect = false;
    this.currentDevice = null;
    this.boundDeviceId = '';
    this.boundSecret = '';
    this.boundWebsocketUrl = '';
  }

  private createDefaultConfig(): EspProvisioningConfig {
    return new EspProvisioningConfig(
      ESP_PROV_DEFAULT_SERVICE_UUID,
      ESP_PROV_DEFAULT_DEVICE_PREFIX,
      EspProvisioningSecurityEnum.SECURITY_2,
      isUsingMock() ? 'mock-user' : '',
      isUsingMock() ? 'mock-pop' : '',
      ESP_PROV_SCAN_TIMEOUT_MS,
      ESP_PROV_CONNECT_TIMEOUT_MS,
      ESP_PROV_STATUS_TIMEOUT_MS,
    );
  }

  private handleDeviceFound(device: EspProvisioningDevice): void {
    const list = this.scannedDevices.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].deviceId == device.deviceId) {
        list[i].rssi = device.rssi;
        return;
      }
    }
    list.push(device);
  }

  private handleProgress(progress: EspProvisioningProgress): void {
    this.phase.value = progress.phase;
  }

  /** 断连重连后用 device-info 恢复最近终态；prov-ctrl 实时回调仍是首次判定权威。 */
  private applyRecoveredOutcome(info: EspProvisioningDeviceInfo): boolean {
    const outcome = info.lastProvisioningOutcome;
    if (outcome == '' || outcome == 'none') return false;
    if (outcome == 'success') {
      this.connectedSsid.value = this.pendingSsid;
      this.retryAction = ProvisionRetryActionEnum.NONE;
      this.phase.value = EspProvisioningPhaseEnum.SUCCESS;
      this.busy.value = false;
      return true;
    }
    if (outcome == 'auth_failed') {
      this.fail(new EspProvisioningError(
        EspProvisioningErrorCodeEnum.WIFI_AUTH_FAILED,
        '设备报告 WiFi 认证失败',
        info.lastProvisioningReason,
      ), ProvisionRetryActionEnum.REWRITE);
      return true;
    }
    if (outcome == 'network_not_found') {
      this.fail(new EspProvisioningError(
        EspProvisioningErrorCodeEnum.NETWORK_NOT_FOUND,
        '设备报告找不到 WiFi',
        info.lastProvisioningReason,
      ), ProvisionRetryActionEnum.REWRITE);
      return true;
    }
    if (outcome == 'timeout') {
      this.fail(new EspProvisioningError(
        EspProvisioningErrorCodeEnum.STATUS_TIMEOUT,
        '设备报告配网超时',
        info.lastProvisioningReason,
      ), ProvisionRetryActionEnum.REWRITE);
      return true;
    }
    if (outcome == 'stopped') {
      this.fail(new EspProvisioningError(
        EspProvisioningErrorCodeEnum.PROVISIONING_WINDOW_EXPIRED,
        '设备配网窗口已结束',
        info.lastProvisioningReason,
        0,
        false,
      ), ProvisionRetryActionEnum.NONE);
      return true;
    }
    if (outcome == 'internal_error') {
      this.fail(new EspProvisioningError(
        EspProvisioningErrorCodeEnum.UNKNOWN,
        '设备内部配网错误',
        info.lastProvisioningReason,
      ), ProvisionRetryActionEnum.RECONNECT);
      return true;
    }
    return false;
  }

  private fail(err: EspProvisioningError, retryAction: ProvisionRetryActionEnum): void {
    if (this.phase.value != EspProvisioningPhaseEnum.FAILED) {
      this.failedPhase.value = this.phase.value;
    }
    this.retryAction = retryAction;
    this.error.value = new ProvisionError(
      this.errorI18nKey(err.code),
      `${err.code}: ${err.detail != '' ? err.detail : err.message}`,
      err.retryable,
      retryAction,
    );
    this.phase.value = EspProvisioningPhaseEnum.FAILED;
    this.busy.value = false;
  }

  private errorI18nKey(code: EspProvisioningErrorCodeEnum): string {
    if (code == EspProvisioningErrorCodeEnum.BLUETOOTH_OFF) return 'Mobile.Provision.Error.bluetoothOff';
    if (code == EspProvisioningErrorCodeEnum.NO_PERMISSION) return 'Mobile.Provision.Scan.noPermission';
    if (code == EspProvisioningErrorCodeEnum.SCAN_FAILED) return 'Mobile.Provision.Error.scanFailed';
    if (code == EspProvisioningErrorCodeEnum.UNSUPPORTED) return 'Mobile.Provision.Error.serviceUnavailable';
    if (code == EspProvisioningErrorCodeEnum.DEVICE_NOT_FOUND) return 'Mobile.Provision.Error.deviceNotFound';
    if (code == EspProvisioningErrorCodeEnum.CONNECT_FAILED) return 'Mobile.Provision.Error.connectFailed';
    if (code == EspProvisioningErrorCodeEnum.DISCONNECTED) return 'Mobile.Provision.Error.disconnected';
    if (code == EspProvisioningErrorCodeEnum.AUTH_FAILED || code == EspProvisioningErrorCodeEnum.WIFI_AUTH_FAILED) return 'Mobile.Provision.Error.wrongPassword';
    if (code == EspProvisioningErrorCodeEnum.INVALID_POP || code == EspProvisioningErrorCodeEnum.SECURITY_AUTH_FAILED || code == EspProvisioningErrorCodeEnum.SESSION_FAILED) return 'Mobile.Provision.Error.securityAuthFailed';
    if (code == EspProvisioningErrorCodeEnum.NETWORK_NOT_FOUND) return 'Mobile.Provision.Error.apNotFound';
    if (code == EspProvisioningErrorCodeEnum.STATUS_TIMEOUT) return 'Mobile.Provision.Error.timeout';
    if (code == EspProvisioningErrorCodeEnum.PROVISIONING_WINDOW_EXPIRED) return 'Mobile.Provision.Error.windowExpired';
    if (code == EspProvisioningErrorCodeEnum.DEVICE_ID_MISMATCH) return 'Mobile.Provision.Error.deviceIdMismatch';
    if (code == EspProvisioningErrorCodeEnum.BUSY) return 'Mobile.Provision.Error.busy';
    if (code == EspProvisioningErrorCodeEnum.SERVICE_MISMATCH) return 'Mobile.Provision.Error.firmwareMismatch';
    if (code == EspProvisioningErrorCodeEnum.SEND_CONFIG_FAILED) return 'Mobile.Provision.Error.writeFailed';
    if (code == EspProvisioningErrorCodeEnum.VOX_CONFIG_INVALID) return 'Mobile.Provision.Error.voxConfigInvalid';
    if (code == EspProvisioningErrorCodeEnum.VOX_CONFIG_PERSIST_FAILED) return 'Mobile.Provision.Error.voxConfigPersistFailed';
    return 'Mobile.Provision.Error.unknown';
  }

  private asEspError(value: any): EspProvisioningError {
    if (value instanceof EspProvisioningError) return value;
    return new EspProvisioningError(
      EspProvisioningErrorCodeEnum.UNKNOWN,
      '未知配网错误',
      `${value}`,
    );
  }

  private ensureActive(): void {
    if (this.disposed) throw new Error('ESP_PROVISIONING_SESSION_DISPOSED');
  }

  private sleep(ms: number): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      setTimeout(() => resolve(), ms);
    });
  }
}

let activeController: EspProvisioningController | null = null;

/** 获取跨 scan/wifi/progress 页面共享的单一 Controller。 */
export function useEspProvisioning(): EspProvisioningController {
  if (activeController == null) activeController = new EspProvisioningController();
  return activeController!!;
}

/** 完成或取消整个流程时释放；普通 navigateTo/navigateBack 不调用。 */
export function releaseEspProvisioning(): void {
  if (activeController != null) activeController!!.dispose();
  activeController = null;
}
