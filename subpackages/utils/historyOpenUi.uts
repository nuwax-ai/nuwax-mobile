/**
 * 历史消息 OpenUI 适配（从 historyMessageAdapter 抽出）。
 * - Event → ToolCall
 * - openui-ref 提升到 result.data
 * - 正文缺失过程标签时按 processingList 补插
 */

import { AgentComponentTypeEnum } from "@/types/enums/agent";
import {
  toMarkdownCustomProcessHtml,
} from "@/utils/markdownCustomProcess.uts";
import {
  isOpenUiRenderToolName,
  extractOpenUiArtifactInfo,
} from "@/utils/openUiSchema.uts";

/**
 * OpenUI 历史项强制 ToolCall（后端常为 Event）。
 */
export function coerceOpenUiHistoryComponentType(
  itemName: string,
  parsedType: any,
): any {
  if (isOpenUiRenderToolName(itemName)) {
    return AgentComponentTypeEnum.ToolCall;
  }
  return parsedType;
}

/**
 * 把 openui-ref 提升到 result.data；无产物则返回原 dataRaw。
 */
export function liftOpenUiRefIntoResultData(
  itemName: string,
  item: any,
  result: any,
  dataRaw: any,
): any {
  if (isOpenUiRenderToolName(itemName) != true) {
    return dataRaw;
  }
  const artifactFromResult = extractOpenUiArtifactInfo(result, itemName);
  const artifact =
    artifactFromResult != null
      ? artifactFromResult
      : extractOpenUiArtifactInfo(item, itemName);
  if (artifact == null || artifact.artifactId.length == 0) {
    return dataRaw;
  }
  const refObj = new UTSJSONObject();
  refObj["type"] = "nuwax.openui-ref";
  refObj["artifactId"] = artifact.artifactId;
  refObj["title"] = artifact.title.length > 0 ? artifact.title : "OpenUI";
  if (artifact.mode.length > 0) {
    const presentation = new UTSJSONObject();
    presentation["mode"] = artifact.mode;
    refObj["presentation"] = presentation;
  }
  return refObj;
}

/**
 * 过程标签 type=Event 的 OpenUI 改为 ToolCall（就地改 tag）。
 */
export function coerceOpenUiProcessTagType(tag: any): void {
  if (tag == null) {
    return;
  }
  if (isOpenUiRenderToolName(tag.name) && tag.type == "Event") {
    tag.type = "ToolCall";
  }
}

/**
 * 正文缺 OpenUI 过程标签时，按 processingList 补插扁平 HTML。
 */
export function ensureOpenUiProcessTagsInBody(
  adaptedText: string,
  processingList: any[],
): string {
  let text = adaptedText;
  for (let pi = 0; pi < processingList.length; pi++) {
    const proc = processingList[pi];
    if (proc == null) {
      continue;
    }
    let procObj: UTSJSONObject | null = null;
    try {
      procObj = JSON.parse(JSON.stringify(proc)) as UTSJSONObject;
    } catch (_e) {
      continue;
    }
    if (procObj == null) {
      continue;
    }
    const pNameRaw = procObj["name"];
    const pName = pNameRaw != null ? `${pNameRaw}` : "";
    if (isOpenUiRenderToolName(pName) != true) {
      continue;
    }
    const resultObj =
      procObj["result"] != null && typeof procObj["result"] == "object"
        ? (procObj["result"] as UTSJSONObject)
        : null;
    const pExecRaw =
      procObj["executeId"] != null
        ? procObj["executeId"]
        : resultObj != null
          ? resultObj["executeId"] != null
            ? resultObj["executeId"]
            : resultObj["id"]
          : null;
    let pExec = pExecRaw != null ? `${pExecRaw}`.trim() : "";
    if (pExec.length == 0) {
      const artifactInfo = extractOpenUiArtifactInfo(procObj);
      if (artifactInfo != null && artifactInfo.artifactId.length > 0) {
        pExec = artifactInfo.artifactId;
      }
    }
    if (pExec.length == 0) {
      continue;
    }
    if (
      text.indexOf(`executeid="${pExec}"`) >= 0 ||
      text.indexOf(`executeId="${pExec}"`) >= 0
    ) {
      continue;
    }
    const pStatusRaw = procObj["status"];
    const pStatus = pStatusRaw != null ? `${pStatusRaw}` : "FINISHED";
    text =
      text +
      "\n\n" +
      toMarkdownCustomProcessHtml(pExec, "ToolCall", pStatus, pName) +
      "\n\n";
  }
  return text;
}
