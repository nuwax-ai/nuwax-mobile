<template>
  <view
    class="button-wrapper"
    :style="{ 'justify-content': resolvedButtonAlign }"
  >
    <!-- 循环渲染按钮列表 -->
    <view
      v-for="(item, index) in chatSuggestList"
      :key="index"
      class="button-item"
      hover-class="hover-class"
      @click="handleButtonClick(item as Any)"
    >
      <image
        v-if="getGuidIcon(item) != null"
        :src="getGuidIcon(item)"
        class="default-icon"
        mode="scaleToFill"
        alt=""
      />
      <!-- 按钮文本，支持省略号显示 -->
      <text class="button-text">{{ getGuidText(item) }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import {
    checkPathParams,
    fillPathParams,
    objectToQueryString,
  } from "@/utils/common";
  import { handleExternalLink } from "@/utils/system";
  import { toAnyRecord } from "@/utils/common";
  import { readRawField } from "@/utils/readRawField.uts";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const props = withDefaults(
    defineProps<{
      buttonAlign?: string;
      chatSuggestList?: any[];
    }>(),
    {
      buttonAlign: "center",
      chatSuggestList: (): any[] => [] as any[],
    },
  );

  const resolvedButtonAlign = computed((): string => {
    const align = props.buttonAlign;
    if (align != null && align.length > 0) {
      return align;
    }
    return "center";
  });

  const emit = defineEmits<{
    buttonClick: [guideQuestionInfo: string];
    /** 页面地址。相对路径由父页面用服务域名拼接；已是 http(s) 则原样打开。 */
    onOpenPagePreview: [uri: string];
  }>();
  const _params = emptyI18nParams();
  const t = (key: string): string => translateFn(key, _params, "");

  /** 已是完整 http(s) 地址时不再拼域名。 */
  function isAbsoluteHttpUrl(value: string): boolean {
    return value.indexOf("http://") == 0 || value.indexOf("https://") == 0;
  }

  const handleShowPage = (obj: UTSJSONObject, argsRaw: any | null) => {
    // 提取参数（从 data 中获取）
    const pathParams = new Map<string, any | null>();
    const params = new Map<string, any | null>();
    if (argsRaw != null) {
      const argsArr = argsRaw as UTSJSONObject[];
      for (let i = 0; i < argsArr.length; i++) {
        const arg = argsArr[i] as UTSJSONObject;
        const inputTypeVal = arg["inputType"] as string | null;
        const nameVal = arg["name"] as string | null;
        if (inputTypeVal != null && inputTypeVal == "Path" && nameVal != null) {
          pathParams.set(nameVal, arg["bindValue"] as any);
        }
        if (inputTypeVal != null && inputTypeVal == "Query" && nameVal != null && arg["bindValue"] != null) {
          params.set(nameVal, arg["bindValue"] as any);
        }
      }
    }

    const pageUrlVal = obj["pageUrl"];
    // 检查路径模板中的变量是否在 data 中存在且值有效
    if (pageUrlVal != null && checkPathParams(`${pageUrlVal}`, toAnyRecord(pathParams))) {
      const pageUrl = fillPathParams(
        `${pageUrlVal}`,
        toAnyRecord(pathParams),
      );

      // 构建完整的页面 URL
      let webviewUrl : string = "";
      // 如果没有参数，直接返回 uri
      if (params.size === 0) {
        webviewUrl = pageUrl;
      } else {
        // 拼接 query 参数
        const queryString = objectToQueryString(toAnyRecord(params));
        webviewUrl = `${pageUrl}?${queryString}`;
      }

      // 不要用 window.location.origin：App 内嵌离线 H5 的 origin 是 file://，
      // 会打开 file:///page/...。交给父页面按服务域名拼接，完整 http(s) 不再拼接。
      emit("onOpenPagePreview", webviewUrl);
    } else {
      uni.showToast({
        title: t("Mobile.ButtonWrapper.pagePathParamConfigError"),
        icon: "none",
      });
    }
  };

  /** 安全获取 GuidQuestionDto 图标（readRawField：字符串项安全返回 null，Android 不抛 ClassCastException） */
  const getGuidIcon = (item: Any): string | null => {
    if (item == null) return null;
    const iconVal = readRawField(item, "icon");
    const typeVal = readRawField(item, "type");
    if (iconVal != null && typeVal != null) {
      return iconVal as string;
    }
    return null;
  }
  /** 安全获取 GuidQuestionDto 显示文本 */
  const getGuidText = (item: Any): string => {
    if (item == null) return "";
    const typeVal = readRawField(item, "type");
    if (typeVal != null) {
      const infoVal = readRawField(item, "info");
      if (infoVal != null) return `${infoVal}`;
    }
    return `${item}`;
  }

  // 点击引导问题建议按钮事件
  const handleButtonClick = (item : Any) => {
    if (item == null) {
      return;
    }
    // 字符串项 / 对象项兼容：readRawField 对字符串安全返回 null，不抛 ClassCastException
    const typeVal = readRawField(item, "type");
    if (typeVal != null) {
      const typeStr = `${typeVal}`;
      if (typeStr == "Question") {
        const infoVal = readRawField(item, "info");
        emit("button-click", infoVal != null ? `${infoVal}` : "");
      }
      // 内置页面
      else if (typeStr == "Page") {
        const pageUrlVal = readRawField(item, "pageUrl");
        if (pageUrlVal == null || `${pageUrlVal}` == "") {
          uni.showToast({
            title: t("Mobile.ButtonWrapper.pagePathConfigError"),
            icon: "none",
          });
          return;
        }
        // 打开页面
        const argsRaw = readRawField(item, "args");
        handleShowPage(item as UTSJSONObject, argsRaw);
      }
      // 外部页面
      else if (typeStr == "Link") {
        const urlVal = readRawField(item, "url");
        if (urlVal != null) {
          const linkUrl = `${urlVal}`;
          if (isAbsoluteHttpUrl(linkUrl)) {
            handleExternalLink(linkUrl);
          } else if (linkUrl.length > 0) {
            emit("onOpenPagePreview", linkUrl);
          }
        }
      }
    } else {
      // Treat as string
      emit("button-click", item as string);
    }
  };
</script>

<style lang="scss" scoped>
  /* 按钮包装器 - 使用flex布局实现居中和换行 */
  .button-wrapper {
    display: flex; /* 弹性布局 */
    flex-direction: row; /* 水平排列 */
    flex-wrap: wrap; /* 允许换行 */
    justify-content: center; /* 默认居中；可由 buttonAlign 覆盖为 flex-start */
    margin: -10rpx -10rpx 0 0;
    // padding: 0 20rpx; /* 左右内边距 */
    overflow: hidden;
    max-height: 235rpx;

    /* 单个按钮样式 */
    .button-item {
      margin: 10rpx 10rpx 0 0;
      padding: 10rpx 15rpx; /* 内边距 */
      background-color: rgba(12, 20, 102, 0.04); /* 浅灰色背景 */
      border-radius: 16rpx; /* 圆角 */
      min-width: 200rpx; /* 最小宽度 */
      max-width: 670rpx; /* 最大宽度 */
      flex-shrink: 0; /* 不允许收缩 */
      transition: all 0.3s ease; /* 过渡动画 */
      display: flex;
      flex-direction: row;
      align-items: center;

      &.hover-class {
        background-color: rgba(12, 20, 102, 0.08);
      }

      .default-icon {
        width: 28rpx;
        height: 28rpx;
        border-radius: 4rpx;
        margin-right: 8rpx;
      }

      /* 按钮文本样式 */
      .button-text {
        font-size: 28rpx; /* 字体大小 */
        color: rgba(21, 23, 31, 0.7); /* 文字颜色 */
        text-align: center; /* 文字居中 */
        line-height: 44rpx; /* 行高 */
        white-space: nowrap; /* 不换行 */
        overflow: hidden; /* 隐藏溢出 */
        text-overflow: ellipsis; /* 显示省略号 */
        flex: 1; /* 占据剩余空间，使省略号生效 */
        min-width: 0; /* 允许 flex 子元素缩小到内容以下 */
      }
    }
  }
</style>
