/** 在 editor 内部同一 JS 任务中替换触发区间；动态内容只作为 JSON 数据传入。 */
export function buildEditorAtomicReplacementScript(payload: UTSJSONObject): string {
  return `(function(p){
    var root=document.querySelector('.ql-container');
    var q=root&&root.__quill;
    if(!q)return;
    var text=q.getContents().ops.map(function(op){return typeof op.insert==='string'?op.insert:'\\ufffc';}).join('');
    if(text.slice(-1)==='\\n')text=text.slice(0,-1);
    if(text!==p.expected)return;
    q.history.cutoff();
    q.updateContents(p.change,'user');
    q.setSelection(p.cursor,0,'silent');
    q.history.cutoff();
  })(${JSON.stringify(payload)});`;
}
