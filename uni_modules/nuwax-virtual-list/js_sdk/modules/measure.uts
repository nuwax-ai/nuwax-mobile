/**
 * nuwax-virtual-list 跨平台元素测量
 *
 * - H5/WEB：uni-app x 在 H5 编译为真实 DOM，用 document.getElementById().offsetHeight 同步测量
 * - 其他端（App-Android/iOS、微信小程序）：uni.createSelectorQuery().in(context).selectAll().
 *   boundingClientRect().exec() 批量异步测量（与 uni-ai-msg-table 同一套写法）
 */

import { type ComponentPublicInstance } from "vue";

/**
 * 批量测量可见列表项高度。
 * @param context 组件实例代理（createSelectorQuery().in() 的作用域，保证多实例互不串）
 * @param selector 列表项 class 选择器（如 .nvwl-item），配合 .in(context) 只命中本实例
 * @param ids 与渲染顺序一致的节点 id 数组（H5 用 DOM 同步测量；其他端仅作占位对齐）
 * @returns 与 ids 同序的高度数组，未测到为 0
 */
export function measureItemHeights(
  context: ComponentPublicInstance | null,
  selector: string,
  ids: string[],
): Promise<number[]> {
  // #ifdef H5 || WEB
  const out: number[] = []
  const len = ids.length
  for (let i = 0; i < len; i++) {
    const el = document.getElementById(ids[i])
    if (el != null) {
      const anyEl = el as any
      const h = anyEl.offsetHeight
      out.push(h != null && h > 0 ? h : 0)
    } else {
      out.push(0)
    }
  }
  return Promise.resolve(out)
  // #endif
  // #ifndef H5 || WEB
  return new Promise<number[]>((resolve) => {
    if (context == null) {
      resolve([])
      return
    }
    uni
      .createSelectorQuery()
      .in(context)
      .selectAll(selector)
      .boundingClientRect()
      .exec((ret) => {
        const out: number[] = []
        if (ret != null && ret.length > 0) {
          // selectAll + exec 的返回形态：Android 为 [NodeInfo[]]（ret[0] 是数组，逐条 query 一个元素），
          // 部分端直接返回 NodeInfo[]。用 Array.isArray(ret[0]) 区分两种形态。
          const firstAny = ret[0] as any
          if (Array.isArray(firstAny)) {
            const list = firstAny as any[]
            const n = list.length
            for (let i = 0; i < n; i++) {
              const info = list[i] as NodeInfo
              let h = 0
              if (info != null && info.height != null) {
                h = info.height
              }
              out.push(h > 0 ? h : 0)
            }
          } else {
            const n = ret.length
            for (let i = 0; i < n; i++) {
              const info = ret[i] as NodeInfo
              let h = 0
              if (info != null && info.height != null) {
                h = info.height
              }
              out.push(h > 0 ? h : 0)
            }
          }
        }
        resolve(out)
      })
  })
  // #endif
}

/**
 * 测量滚动容器可视高度（px）。
 * @param context 组件实例代理
 * @param listId 滚动容器节点 id
 */
export function measureViewportHeight(
  context: ComponentPublicInstance | null,
  listId: string,
): Promise<number> {
  // #ifdef H5 || WEB
  let h = 0
  if (listId.length > 0) {
    const el = document.getElementById(listId)
    if (el != null) {
      const anyEl = el as any
      h = anyEl.clientHeight != null ? anyEl.clientHeight : 0
      if (h <= 0) {
        h = anyEl.offsetHeight != null ? anyEl.offsetHeight : 0
      }
    }
  }
  return Promise.resolve(h > 0 ? h : 0)
  // #endif
  // #ifndef H5 || WEB
  return new Promise<number>((resolve) => {
    if (context == null || listId.length == 0) {
      resolve(0)
      return
    }
    uni
      .createSelectorQuery()
      .in(context)
      .select("#" + listId)
      .boundingClientRect()
      .exec((ret) => {
        let h = 0
        if (ret != null && ret.length > 0) {
          const firstAny = ret[0] as any
          if (Array.isArray(firstAny)) {
            // 极端形态 [NodeInfo[]]：取数组第一项
            const list = firstAny as any[]
            if (list.length > 0) {
              const info = list[0] as NodeInfo
              if (info != null && info.height != null) {
                h = info.height
              }
            }
          } else {
            const info = ret[0] as NodeInfo
            if (info != null && info.height != null) {
              h = info.height
            }
          }
        }
        resolve(h > 0 ? h : 0)
      })
  })
  // #endif
}
