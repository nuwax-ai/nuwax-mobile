<template>
  <button class="call-control" :class="{ 'call-control--large': large, 'call-control--dense': dense }" hover-class="call-control--pressed" @click="activate()">
    <view class="call-control__disc" :class="{ 'call-control__disc--selected': selected && tone == 'default', 'call-control__disc--danger': tone == 'danger', 'call-control__disc--success': tone == 'success', 'call-control__disc--large': large }">
      <image class="call-control__icon" :src="iconSource" mode="aspectFit" />
    </view>
    <text class="call-control__label text-ellipsis-2" :class="{ 'call-control__label--dense': dense }">{{ label }}</text>
  </button>
</template>
<script setup lang="uts">
  import { computed } from "vue";
  const props = defineProps({
    icon: { type: String, default: "phone" },
    label: { type: String, default: "" },
    tone: { type: String, default: "default" },
    selected: { type: Boolean, default: false },
    large: { type: Boolean, default: false },
    dense: { type: Boolean, default: false },
  });
  const emit = defineEmits<{ (event: "press"): void }>();
  const iconSource = computed((): string => "/static/voip/call-icons/" + props.icon + (props.selected && props.tone == "default" ? "-ink.png" : "-white.png"));
  function activate(): void { emit("press"); }
</script>
<style scoped>
  .call-control { width: 88px; height: 114px; padding: 0; border-width: 0; border-radius: 0; background-color: transparent; flex-direction: column; align-items: center; justify-content: flex-start; flex-shrink: 0; }
  .call-control--large { width: 96px; height: 114px; }
  .call-control--dense { width: 72px; }
  .call-control--pressed { opacity: 0.65; }
  .call-control__disc { width: 62px; height: 62px; border-radius: 31px; background-color: rgba(255, 255, 255, 0.14); align-items: center; justify-content: center; }
  .call-control__disc--large { width: 72px; height: 72px; border-radius: 36px; }
  .call-control__disc--selected { background-color: #ffffff; }
  .call-control__disc--danger { background-color: #ee4d5a; }
  .call-control__disc--success { background-color: #16b866; }
  .call-control__icon { width: 30px; height: 30px; }
  .call-control__label { width: 100%; margin-top: 12px; color: #ffffff; font-size: 13px; line-height: 18px; text-align: center; }
  .call-control__label--dense { font-size: 12px; line-height: 17px; }
  /* #ifdef H5 */
  .call-control::after { border: none; }
  /* #endif */
</style>
