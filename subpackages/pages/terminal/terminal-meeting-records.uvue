<template>
  <view class="container relative flex flex-col">
    <custom-nav-bar :title="t('Mobile.Terminal.meetingRecords')" className="border-b" hasSafetyZone showBack />

    <!-- 搜索 + 筛选 -->
    <view class="search-row">
      <view class="search-box">
        <input class="search-input" v-model="keyword" :placeholder="searchPlaceholder" placeholder-class="search-placeholder" />
      </view>
      <view class="filter-btn" hover-class="filter-btn-active" @click="handleFilter">
        <text class="filter-text">{{ currentFilter }}</text>
      </view>
    </view>

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <view class="record-list">
        <view class="record-card" v-for="item in filteredList" :key="item.title">
          <view class="record-head">
            <text class="record-title text-ellipsis">{{ item.title }}</text>
            <text class="record-date">{{ item.date }}</text>
          </view>
          <view class="record-meta">
            <text class="record-count">👥 {{ item.count }}{{ t("Mobile.Terminal.peopleUnit") }}</text>
          </view>
          <text class="record-summary">{{ item.summary }}</text>
          <view class="record-actions">
            <view class="action-btn" hover-class="action-btn-active" @click="handleAction(t('Mobile.Terminal.replay'))">
              <text class="action-text">▶ {{ t("Mobile.Terminal.replay") }}</text>
            </view>
            <view class="action-btn" hover-class="action-btn-active" @click="handleAction(t('Mobile.Terminal.download'))">
              <text class="action-text">⬇ {{ t("Mobile.Terminal.download") }}</text>
            </view>
            <view class="action-btn action-btn-primary" hover-class="action-btn-active" @click="handleDetail(item.title)">
              <text class="action-text-primary">{{ t("Mobile.Terminal.viewDetail") }}</text>
            </view>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-box" v-if="filteredList.length == 0">
          <text class="empty-text">{{ t("Mobile.Terminal.noMeetingRecords") }}</text>
        </view>
      </view>
      <view class="bottom-space"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const keyword = ref<string>("");
  const currentFilter = ref<string>(t("Mobile.Terminal.allTime"));
  const searchPlaceholder = ref<string>(t("Mobile.Terminal.searchMeeting"));

  class MeetingRecord {
    title: string = "";
    count: number = 0;
    date: string = "";
    summary: string = "";
    constructor(title: string, count: number, date: string, summary: string) {
      this.title = title;
      this.count = count;
      this.date = date;
      this.summary = summary;
    }
  }

  const recordList = ref<MeetingRecord[]>([
    new MeetingRecord("Q3产品规划评审", 12, "07-18 14:30", "讨论了Q3产品路线图，确定了3个核心Feature的优先级排序"),
    new MeetingRecord("API架构升级讨论", 8, "07-17 10:00", "确认微服务迁移方案，决定采用逐步灰度策略降低风险"),
    new MeetingRecord("前端组件库周会", 6, "07-16 16:00", "评审Button/Card/Modal组件重构进度，UI-Agent完成80%"),
    new MeetingRecord("数据库迁移方案", 5, "07-15 11:00", "制定MySQL→TiDB迁移计划，预估停机时间<30分钟"),
    new MeetingRecord("安全漏洞应急会议", 15, "07-14 09:30", "紧急处理Log4j漏洞，全团队排查受影响服务"),
  ]);

  // 前端过滤
  const filteredList = computed((): MeetingRecord[] => {
    const kw = keyword.value;
    if (kw.length == 0) return recordList.value;
    const result: MeetingRecord[] = [] as MeetingRecord[];
    recordList.value.forEach((item: MeetingRecord) => {
      if (item.title.indexOf(kw) >= 0) {
        result.push(item);
      }
    });
    return result;
  });

  const handleFilter = () => {
    uni.showToast({ title: currentFilter.value, icon: "none" });
  };

  const handleAction = (action: string) => {
    uni.showToast({ title: action, icon: "none" });
  };

  const handleDetail = (title: string) => {
    uni.showToast({ title: title, icon: "none" });
  };

  onLoad((options: any) => {
    setCurrentPageNavigationBarTitle();
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .search-row {
    display: flex;
    flex-direction: row;
    padding: 24rpx 24rpx 0;

    .search-box {
      flex: 1;
      background-color: #ffffff;
      border-radius: 16rpx;
      padding: 20rpx 28rpx;
      margin-right: 16rpx;

      .search-input {
        width: 100%;
        font-size: 28rpx;
        color: #1a1a1a;
      }

      .search-placeholder {
        color: #c0c0c0;
      }
    }

    .filter-btn {
      padding: 20rpx 28rpx;
      border-radius: 16rpx;
      background-color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;

      &-active {
        background-color: rgba(12, 20, 102, 0.04);
      }

      .filter-text {
        font-size: 26rpx;
        color: #666666;
      }
    }
  }

  .record-list {
    padding: 24rpx;
  }

  .record-card {
    background-color: #ffffff;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 20rpx;

    .record-head {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 16rpx;

      .record-title {
        flex: 1;
        font-size: 30rpx;
        font-weight: 600;
        color: #1a1a1a;
        margin-right: 16rpx;
      }

      .record-date {
        font-size: 22rpx;
        color: #999999;
        flex-shrink: 0;
      }
    }

    .record-meta {
      margin-bottom: 16rpx;

      .record-count {
        font-size: 22rpx;
        color: #666666;
      }
    }

    .record-summary {
      font-size: 26rpx;
      color: #1a1a1a;
      line-height: 1.5;
      margin-bottom: 20rpx;
    }

    .record-actions {
      display: flex;
      flex-direction: row;

      .action-btn {
        padding: 12rpx 24rpx;
        border-radius: 12rpx;
        border: 2rpx solid #e0e0e0;
        margin-right: 16rpx;

        &-active {
          background-color: rgba(12, 20, 102, 0.04);
        }

        .action-text {
          font-size: 24rpx;
          color: #666666;
        }

        &.action-btn-primary {
          border-color: #5147ff;
          background-color: rgba(81, 71, 255, 0.08);

          .action-text-primary {
            font-size: 24rpx;
            color: #5147ff;
          }
        }
      }
    }
  }

  .empty-box {
    padding: 80rpx 0;
    display: flex;
    align-items: center;
    justify-content: center;

    .empty-text {
      font-size: 28rpx;
      color: #999999;
    }
  }

  .bottom-space {
    height: 40rpx;
  }
</style>
