<template>
  <view class="container page-container">
    <!-- #ifdef H5 -->
     <!-- 语言切换组件 -->
    <login-lang-switcher />
    <!-- #endif -->
     
    <safety-zone />
    <!-- #ifdef MP-WEIXIN -->
    <custom-nav-bar
      v-if="showNavBarVal"
      :show-back="showBackVal"
      :has-safety-zone="false"
      :transparent-background="true"
    />
    <!-- #endif -->
    <view class="content-weixin">
      <view class="header-content">
        <image
          v-if="logoVal.length > 0"
          class="icon"
          :src="logoVal"
          mode="aspectFill"
          :alt="t('Mobile.Common.appLogoAlt')"
        />
        <view class="title"> {{ titleVal }} </view>
      </view>
      <!-- #ifdef APP -->
      <view
        class="form-content"
        style="background-color: #ffffff; width: 100%;"
      >
        <view class="form-content-body" style="background-color: #ffffff; width: 100%;">
          <slot name="default"></slot>
        </view>
      </view>
      <!-- #endif -->
      <!-- #ifndef APP -->
      <view class="form-content">
        <view class="form-content-body">
          <slot name="default"></slot>
        </view>
      </view>
      <!-- #endif -->
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import LoginLangSwitcher from "../login-lang-switcher/login-lang-switcher.uvue";
  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
  // uvue 模板中直接调用 t() 会报 invoke 解析失败，这里包一层单参版本

  // 定义组件props
  // uvue: 可选 prop 配合 withDefaults 会触发 override 类型不匹配，这里不使用 withDefaults
  interface LoginLayoutProps {
    title?: string;
    logo?: string;
    showNavBar?: boolean;
    showBack?: boolean;
  }

  const props = defineProps<LoginLayoutProps>();

  // 通过 computed 读取默认值，规避 uvue 可选 prop + withDefaults 的 override 不匹配
  const titleVal = computed((): string => props.title != null ? props.title : "");
  const logoVal = computed((): string => props.logo != null ? props.logo : "");
  const showNavBarVal = computed((): boolean => props.showNavBar == true);
  const showBackVal = computed((): boolean => props.showBack == true);
</script>

<style lang="scss" scoped>
  .container {
    width: 100%;
    display: flex;
    flex-direction: column;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100vh;
    background: linear-gradient(180deg, rgb(150, 136, 230) 0%, #f8b1c5 100%);
    /* #endif */
    /* #ifdef MP-WEIXIN */
    height: 100%;
    background: linear-gradient(180deg, rgb(150, 136, 230) 0%, #f8b1c5 100%);
    /* #endif */
    /* #ifdef APP */
    flex: 1;
    height: 100%;
    /* App 仅支持三参数：direction + 起始色 + 结束色，不支持 180deg / 百分比停点 */
    background-image: linear-gradient(to bottom, rgb(150, 136, 230), #f8b1c5);
    /* #endif */

    .content-weixin {
      flex: 1;
      min-height: 0; /* 允许收缩 */
      /* #ifdef H5 */
      overflow: auto;
      /* #endif */
      /* #ifndef H5 */
      overflow: hidden;
      /* #endif */
      padding: 16rpx;
      /* 隐藏滚动条 */
      /* #ifndef APP */
      scrollbar-width: none; /* Firefox */
      /* #endif */
      /* #ifndef APP */
      -ms-overflow-style: none; /* IE and Edge */
      &::-webkit-scrollbar {
        display: none; /* Chrome, Safari, Opera */
      }
      /* #endif */

      .header-content {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        height: 256rpx;

        .icon {
          width: 96rpx;
          height: 96rpx;
          border-radius: 32rpx;
        }

        .title {
          margin-left: 20rpx;
          font-weight: 600;
          font-size: 32rpx;
          /* #ifdef H5 || MP-WEIXIN */
          leading-trim: NONE;
          /* #endif */
          line-height: 48rpx;
          letter-spacing: 0rpx;
          /* #ifndef APP */
          vertical-align: middle;
          /* #endif */
          color: rgba(255, 255, 255, 1);
        }
      }

      .form-content {
        position: relative;
        flex-shrink: 0; /* 防止内容被压缩 */
        width: 100%;
        padding: 48rpx;
        border-radius: 32rpx;
        overflow: hidden;
        /* #ifndef APP */
        background-color: rgba(255, 255, 255, 0.95);
        /* #endif */
      }

      .form-content-body {
        position: relative;
        width: 100%;
      }
    }
  }
</style>
