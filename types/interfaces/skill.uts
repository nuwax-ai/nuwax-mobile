import { orEmpty } from '@/utils/utsCoalesce.uts';

/** Android JSON 数字可能是 number 或 string */
function readSkillNumber(obj: UTSJSONObject, key: string): number {
  const v = obj[key];
  if (v == null) {
    return 0;
  }
  if (typeof v == 'number') {
    const n = v as number;
    if (Number.isNaN(n)) {
      return 0;
    }
    return n;
  }
  const parsed = parseFloat(`${v}`);
  if (Number.isNaN(parsed)) {
    return 0;
  }
  return parsed;
}

/**
 * 已收藏/全部技能列表请求参数（文档用）。
 * Android：禁止 `UTSJSONObject as SkillListForAtParams`，请求层请传 UTSJSONObject / any。
 */
export interface SkillListForAtParams {
  /*目标类型，Agent,Plugin,Workflow,可用值:Agent,Plugin,Workflow,Knowledge,Table,Skill */
  targetType?: string;

  /*子类型,可用值:Multi,Single,WorkflowChat,ChatBot,TaskAgent,Agent,PageApp */
  targetSubType?: string;

  /*页码 */
  page?: number;

  /*每页数量 */
  pageSize?: number;

  /*分类名称 */
  category?: string;

  /*关键字搜索 */
  kw?: string;

  /*空间ID（可选）需要通过空间过滤时有用 */
  spaceId?: number;

  /*只返回空间的组件 */
  justReturnSpaceData?: boolean;

  /*访问控制过滤，0 无需过滤，1 过滤出需要权限管控的内容 */
  accessControl?: number;

  /*是否只返回官方标识的内容 */
  official?: boolean;

  /*使用场景过滤，如 TaskAgent */
  usageScenarios?: string[];
}

/**
 * 技能信息（@ 技能选择）。
 * Android：响应体是 UTSJSONObject，须用 parseSkillInfoForAt 构造 class，禁止 as SkillInfoForAt。
 */
export class SkillInfoForAt {
  id: number = 0;
  tenantId: number = 0;
  spaceId: number = 0;
  targetType: string = '';
  targetId: number = 0;
  name: string = '';
  description: string = '';
  icon: string = '';
  remark: string = '';
  modified: string = '';
  created: string = '';
  category: string = '';
  allowCopy: number = 0;
  accessControl: number = 0;
  pluginType: string = '';
  agentType: string = '';
  coverImg: string = '';
  coverImgSourceType: string = '';
  collect: boolean = false;
}

/**
 * 从接口原始项解析技能（Android 安全：bracket 读字段）。
 */
export function parseSkillInfoForAt(raw: any | null): SkillInfoForAt {
  const item = new SkillInfoForAt();
  if (raw == null) {
    return item;
  }
  const obj = raw as UTSJSONObject;
  item.id = readSkillNumber(obj, 'id');
  item.tenantId = readSkillNumber(obj, 'tenantId');
  item.spaceId = readSkillNumber(obj, 'spaceId');
  item.targetType = orEmpty(obj['targetType']);
  item.targetId = readSkillNumber(obj, 'targetId');
  item.name = orEmpty(obj['name']);
  item.description = orEmpty(obj['description']);
  item.icon = orEmpty(obj['icon']);
  item.remark = orEmpty(obj['remark']);
  item.modified = orEmpty(obj['modified']);
  item.created = orEmpty(obj['created']);
  item.category = orEmpty(obj['category']);
  item.allowCopy = readSkillNumber(obj, 'allowCopy');
  item.accessControl = readSkillNumber(obj, 'accessControl');
  item.pluginType = orEmpty(obj['pluginType']);
  item.agentType = orEmpty(obj['agentType']);
  item.coverImg = orEmpty(obj['coverImg']);
  item.coverImgSourceType = orEmpty(obj['coverImgSourceType']);
  const collectRaw = obj['collect'];
  item.collect = collectRaw == true;
  return item;
}

/**
 * 解析技能数组；非数组返回空列表。
 */
export function parseSkillInfoForAtList(raw: any | null): SkillInfoForAt[] {
  const list: SkillInfoForAt[] = [];
  if (raw == null || Array.isArray(raw) == false) {
    return list;
  }
  const arr = raw as any[];
  for (let i = 0; i < arr.length; i++) {
    list.push(parseSkillInfoForAt(arr[i]));
  }
  return list;
}
