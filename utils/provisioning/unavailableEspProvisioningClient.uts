/** 真实平台实现尚未注册时的可控失败客户端，避免页面构造阶段崩溃。 */
import type {
  EspProvisioningClient,
  EspProvisioningDeviceFoundCallback,
  EspProvisioningLogCallback,
  EspProvisioningProgressCallback,
} from '@/utils/provisioning/espProvisioningClient';
import type {
  EspProvisioningConfig,
  EspProvisioningDevice,
  EspWifiNetwork,
} from '@/types/interfaces/espProvisioning';
import { EspProvisioningError } from '@/types/interfaces/espProvisioning';
import { EspProvisioningErrorCodeEnum } from '@/types/enums/espProvisioning';

export class UnavailableEspProvisioningClient implements EspProvisioningClient {
  private rejected<T>(): Promise<T> {
    return new Promise<T>((resolve, reject) => {
      reject(new EspProvisioningError(
        EspProvisioningErrorCodeEnum.UNSUPPORTED,
        '真实 ESP Provisioning 客户端尚未接入',
        'Android UTS provider is not registered',
        0,
        false,
      ));
    });
  }

  initialize(config: EspProvisioningConfig): Promise<void> { return this.rejected<void>(); }
  startScan(): Promise<void> { return this.rejected<void>(); }
  stopScan(): Promise<void> { return Promise.resolve(); }
  onDeviceFound(cb: EspProvisioningDeviceFoundCallback): void {}
  connect(device: EspProvisioningDevice): Promise<void> { return this.rejected<void>(); }
  getCapabilities(): Promise<string[]> { return this.rejected<string[]>(); }
  scanNetworks(): Promise<EspWifiNetwork[]> { return this.rejected<EspWifiNetwork[]>(); }
  provision(ssid: string, password: string): Promise<void> { return this.rejected<void>(); }
  onProgress(cb: EspProvisioningProgressCallback): void {}
  onLog(cb: EspProvisioningLogCallback): void {}
  disconnect(): Promise<void> { return Promise.resolve(); }
  dispose(): void {}
}
