  .perf-page {
    display: flex;
    flex-direction: column;
    /* #ifdef H5 || WEB */
    height: 100vh;
    /* #endif */
    /* #ifndef H5 || WEB */
    flex: 1;
    height: 100%;
    /* #endif */
    background-color: #f5f5f5;
  }

  .control-panel {
    padding: 20rpx 24rpx;
    background-color: #fff;
    border-bottom: 1rpx solid #eee;
  }

  .ctrl-row {
    margin-bottom: 12rpx;
  }

  .ctrl-label {
    font-size: 26rpx;
    color: #333;
  }

  .ctrl-slider {
    flex: 1;
  }

  .ctrl-toggles {
    display: flex;
    flex-direction: row;
  }

  .toggle {
    padding: 12rpx 20rpx;
    background-color: #f0f0f0;
    border-radius: 8rpx;
    margin-right: 16rpx;
  }

  .toggle-active {
    background-color: #1677ff;
  }

  .toggle-active .toggle-text {
    color: #fff;
  }

  .toggle-text {
    font-size: 26rpx;
    color: #1677ff;
  }

  .ctrl-btns {
    display: flex;
    flex-direction: row;
  }

  .btn {
    padding: 16rpx 32rpx;
    font-size: 28rpx;
    border-radius: 12rpx;
    margin-right: 16rpx;
    background-color: #f0f0f0;
    color: #333;
    border: none;
  }

  .btn-primary {
    background-color: #1677ff;
    color: #fff;
  }

  .metrics {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8rpx;
  }

  .metric-text {
    font-size: 24rpx;
    color: #52c41a;
    margin-right: 24rpx;
    font-weight: 600;
  }

  .metric-bad {
    color: #ff4d4f;
  }

  .card-slot {
    padding: 12rpx 24rpx;
    background-color: #fffbe6;
    border-bottom: 1rpx solid #ffe58f;
  }

  .msg-scroll {
    flex: 1;
  }

  .msg-list {
    padding: 24rpx;
  }

  .msg-item {
    margin-bottom: 20rpx;
  }
</style>
