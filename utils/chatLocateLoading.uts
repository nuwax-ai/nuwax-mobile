import { ref, type Ref } from "vue";

/**
 * 「正在定位消息」等待遮罩显隐（模块级状态，不放 chat.uvue 的 setup state）。
 *
 * 为什么不放页面：chat.uvue 的渲染 lambda 捕获参数已顶到 255 上限，模板每新增一个
 * setup 顶层符号引用就多一个捕获参数，R8 转发桩超限 → Android
 * `VerifyError: Verifier rejected class GenPagesMessageChat` → 整页加载失败
 * （见 utils/chatAiHint.uts 同款说明）。所以遮罩抽成零绑定组件
 * （components/chat-locate-loading）挂载，显隐经模块级 ref 传递。
 *
 * 场景：带定位目标进聊天页（搜索命中 / 引用详情 / 置顶跳转）时，列表全程 veiled
 * （视觉隐藏但参与 scroll-into-view 布局）等 seq 直达取页 + 揭幕——其间页面是纯白
 * 空白，没有任何反馈。遮罩在「开始定位且尚未揭幕」期间显示，揭幕即收。
 *
 * ★跨页残留：模块级 ref 跨页实例存活，聊天页 onHide/onUnload 必须复位 false
 * （见 chat.uvue），否则下一个聊天页首帧可能先按旧值画出遮罩。
 */
export const chatLocateLoadingVisible: Ref<boolean> = ref(false);

/**
 * 轻量形态：**只在「目标行已在当前窗口内」时用**（Pin/引用命中当前页附近，只滚一小段），
 * 居中的半透明胶囊（转圈 + 同一句文案），不遮阅读。
 *
 * ★会话内搜索命中远早于已加载窗口时**不要**用轻量形态（2026-10-29 改）：目标行不在窗口内
 * 要先直达取页，插入的页 + 长距离 scroll-into-view + 落定核验重试会让列表在底下连滚好几屏，
 * 胶囊不遮内容，露出来就是「点完搜索结果，内容区域自己不断滚动」。那种情况与进页遮蔽同款，
 * 走铺满的不透明白底（白屏 + 正在定位消息），收口后一次揭开——同全局搜索进页、伙伴页搜索跳转。
 * 显隐与形态同为模块级 ref（零绑定）。
 */
export const chatLocateLoadingInline: Ref<boolean> = ref(false);

/** 写入显隐（同值不触发，避免无谓重渲）。 */
export function setChatLocateLoadingVisible(visible: boolean): void {
  if (chatLocateLoadingVisible.value != visible) {
    chatLocateLoadingVisible.value = visible;
  }
}

/** 写入形态（同值不触发）。 */
export function setChatLocateLoadingInline(inline: boolean): void {
  if (chatLocateLoadingInline.value != inline) {
    chatLocateLoadingInline.value = inline;
  }
}
