<template>
  <view class="schedule">
    <custom-nav-bar :title="t('Mobile.Discover.calendar')" className="border-b" hasSafetyZone :show-back="true">
      <template #right>
        <view class="schedule__today" @click="onToday">
          <text class="schedule__today-text">{{ t("Mobile.Discover.scheduleToday") }}</text>
        </view>
      </template>
    </custom-nav-bar>

    <view class="schedule__seg">
      <view class="schedule__seg-item" :class="mode == 'month' ? 'schedule__seg-item--on' : ''" @click="setMode('month')">
        <text :class="mode == 'month' ? 'schedule__seg-text schedule__seg-text--on' : 'schedule__seg-text'">{{ t("Mobile.Discover.scheduleViewMonth") }}</text>
      </view>
      <view class="schedule__seg-item" :class="mode == 'week' ? 'schedule__seg-item--on' : ''" @click="setMode('week')">
        <text :class="mode == 'week' ? 'schedule__seg-text schedule__seg-text--on' : 'schedule__seg-text'">{{ t("Mobile.Discover.scheduleViewWeek") }}</text>
      </view>
      <view class="schedule__seg-item" :class="mode == 'day' ? 'schedule__seg-item--on' : ''" @click="setMode('day')">
        <text :class="mode == 'day' ? 'schedule__seg-text schedule__seg-text--on' : 'schedule__seg-text'">{{ t("Mobile.Discover.scheduleViewDay") }}</text>
      </view>
      <view class="schedule__seg-item" :class="mode == 'list' ? 'schedule__seg-item--on' : ''" @click="setMode('list')">
        <text :class="mode == 'list' ? 'schedule__seg-text schedule__seg-text--on' : 'schedule__seg-text'">{{ t("Mobile.Discover.scheduleViewList") }}</text>
      </view>
    </view>

    <view v-if="mode == 'month'" class="schedule__body">
      <scroll-view class="schedule__scroll" direction="vertical" :show-scrollbar="false">
        <view class="schedule__calendar">
          <month-calendar
            :focus-year="selectedYear"
            :focus-month="selectedMonth"
            :focus-day="selectedDay"
            :mark-version="markVersion"
            @select="onSelect"
          />
        </view>
        <view class="schedule__date-bar">
          <text class="schedule__date">{{ dateLine }}</text>
          <text v-if="showingToday" class="schedule__date-today">{{ t("Mobile.Discover.scheduleToday") }}</text>
        </view>
        <view v-if="monthItems.length == 0" class="schedule__empty">
          <view class="schedule__empty-icon">
            <svg-icon name="icon-Calendar" size="22" unit="px" color="#c9cdd4" />
          </view>
          <text class="schedule__empty-text">{{ emptyText }}</text>
          <view class="schedule__create" @click="onCreate">
            <text class="schedule__create-text">+ {{ t("Mobile.Discover.scheduleCreate") }}</text>
          </view>
        </view>
        <view v-for="(item, index) in monthItems" :key="index" class="schedule__card" @click="onOpen(item.id)">
          <view class="schedule__card-bar" :style="'background-color:' + item.solid"></view>
          <view class="schedule__card-body">
            <text class="schedule__card-title">{{ item.title }}</text>
            <text class="schedule__card-time">{{ item.timeRange }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <schedule-grid
      v-if="mode == 'week'"
      :year="selectedYear"
      :month="selectedMonth"
      :day="selectedDay"
      :single="false"
      :mark-version="markVersion"
      @shift="onShift"
      @pick="onSelect"
      @open="onOpen"
    />
    <schedule-grid
      v-if="mode == 'day'"
      :year="selectedYear"
      :month="selectedMonth"
      :day="selectedDay"
      :single="true"
      :mark-version="markVersion"
      @shift="onShift"
      @pick="onSelect"
      @open="onOpen"
    />
    <schedule-agenda
      v-if="mode == 'list'"
      :year="selectedYear"
      :month="selectedMonth"
      :day="selectedDay"
      :mark-version="markVersion"
      @pick="onSelect"
      @open="onOpen"
    />
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onShow } from "@dcloudio/uni-app";
  import MonthCalendar from "@/components/month-calendar/month-calendar.uvue";
  import ScheduleGrid from "./components/schedule-grid.uvue";
  import ScheduleAgenda from "./components/schedule-agenda.uvue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { ScheduleItem, dateLine as formatDateLine, itemsOnDate, shiftDate, toIso } from "@/utils/scheduleBoard";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const today = new Date();
  const selectedYear = ref<number>(today.getFullYear());
  const selectedMonth = ref<number>(today.getMonth() + 1);
  const selectedDay = ref<number>(today.getDate());
  const mode = ref<string>("month");
  const dateLine = ref<string>("");
  const emptyText = ref<string>("");
  const showingToday = ref<boolean>(false);
  const monthItems = ref<ScheduleItem[]>([]);
  const markVersion = ref<number>(0);

  const weekdayKeys: string[] = [
    "Mobile.Discover.weekdaySun",
    "Mobile.Discover.weekdayMon",
    "Mobile.Discover.weekdayTue",
    "Mobile.Discover.weekdayWed",
    "Mobile.Discover.weekdayThu",
    "Mobile.Discover.weekdayFri",
    "Mobile.Discover.weekdaySat",
  ];

  function refreshMonthLine(): void {
    const year = selectedYear.value;
    const month = selectedMonth.value;
    const day = selectedDay.value;
    const weekday = t(weekdayKeys[new Date(year, month - 1, day).getDay()]);
    dateLine.value = formatDateLine(year, month, day, weekday);
    const now = new Date();
    showingToday.value = year == now.getFullYear() && month == now.getMonth() + 1 && day == now.getDate();
    emptyText.value = showingToday.value ? t("Mobile.Discover.scheduleEmptyToday") : t("Mobile.Discover.scheduleEmptyDay");
    monthItems.value = itemsOnDate(toIso(year, month, day));
  }

  function applyParts(year: number, month: number, day: number): void {
    if (isNaN(year) || isNaN(month) || isNaN(day)) {
      return;
    }
    if (month < 1 || month > 12 || day < 1 || day > 31) {
      return;
    }
    selectedYear.value = year;
    selectedMonth.value = month;
    selectedDay.value = day;
    refreshMonthLine();
  }

  function onSelect(value: string): void {
    const parts = value.split("-");
    if (parts.length < 3) {
      return;
    }
    applyParts(parseInt(parts[0]), parseInt(parts[1]), parseInt(parts[2]));
  }

  function onShift(delta: number): void {
    const next = shiftDate(selectedYear.value, selectedMonth.value, selectedDay.value, delta);
    applyParts(next[0], next[1], next[2]);
  }

  function onToday(): void {
    const now = new Date();
    applyParts(now.getFullYear(), now.getMonth() + 1, now.getDate());
  }

  function setMode(next: string): void {
    mode.value = next;
  }

  function onOpen(id: string): void {
    if (id.length == 0) {
      return;
    }
    uni.navigateTo({
      url: "/pages/schedule/schedule-detail?id=" + id,
    });
  }

  function onCreate(): void {
    const year = selectedYear.value;
    const month = selectedMonth.value;
    const day = selectedDay.value;
    uni.navigateTo({
      url: "/pages/schedule/schedule-create?year=" + year + "&month=" + month + "&day=" + day,
    });
  }

  onShow(() => {
    markVersion.value = markVersion.value + 1;
    refreshMonthLine();
  });

  refreshMonthLine();
</script>

<style scoped>
  .schedule {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: #f7f7f8;
  }

  .schedule__today {
    height: 28px;
    padding: 0 12px;
    border-radius: 14px;
    background-color: #eeedfe;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .schedule__today-text {
    font-size: 14px;
    color: #5b4dff;
    font-weight: 600;
  }

  .schedule__seg {
    margin: 12px 16px 8px;
    height: 36px;
    padding: 3px;
    border-radius: 10px;
    background-color: #ececee;
    display: flex;
    flex-direction: row;
  }

  .schedule__seg-item {
    flex: 1;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .schedule__seg-item--on {
    background-color: #ffffff;
  }

  .schedule__seg-text {
    font-size: 14px;
    color: #86909c;
  }

  .schedule__seg-text--on {
    color: #1f2329;
    font-weight: 600;
  }

  .schedule__body {
    flex: 1;
  }

  .schedule__scroll {
    flex: 1;
  }

  .schedule__calendar {
    margin: 4px 16px 0;
  }

  .schedule__date-bar {
    padding: 16px 16px 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .schedule__date {
    font-size: 16px;
    font-weight: 600;
    color: #1f2329;
  }

  .schedule__date-today {
    margin-left: 8px;
    font-size: 14px;
    color: #5b4dff;
  }

  .schedule__empty {
    margin: 0 16px 24px;
    padding: 28px 16px 24px;
    background-color: #ffffff;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .schedule__empty-icon {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: #f2f3f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .schedule__empty-text {
    margin-top: 12px;
    font-size: 14px;
    color: #86909c;
  }

  .schedule__create {
    margin-top: 20px;
    height: 44px;
    padding: 0 28px;
    border-radius: 22px;
    background-color: #5b4dff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .schedule__create-text {
    font-size: 16px;
    color: #ffffff;
    font-weight: 600;
  }

  .schedule__card {
    margin: 0 16px 10px;
    padding: 14px 14px 14px 0;
    background-color: #ffffff;
    border-radius: 12px;
    display: flex;
    flex-direction: row;
    align-items: stretch;
  }

  .schedule__card-bar {
    width: 3px;
    margin: 2px 12px 2px 0;
    border-radius: 2px;
  }

  .schedule__card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .schedule__card-title {
    font-size: 16px;
    font-weight: 600;
    color: #1f2329;
