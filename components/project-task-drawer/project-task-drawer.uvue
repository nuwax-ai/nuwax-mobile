<template>
  <!--
    项目/任务抽屉（App v3 新交互）：左滑抽屉承载「项目」分组 +「任务」（会话历史）列表。
    容器复用 uni-modal-popup position=left（滑入动画/遮罩/Android 返回拦截，
    与 app-details 历史会话抽屉同款）。
    设计稿：项目行 = 名称 + 类型标签 + ＋；子会话行 = 状态点 + 名称 + 相对时间；
    任务行 = 标题 + 智能体名 + 时间 + 执行中徽标。
  -->
  <uni-modal-popup
    ref="popupRef"
    position="left"
    width="78%"
    :show-header="false"
    :body-scroll="false"
    @update-visible="handlePopupVisible"
  >
    <view class="drawer-wrap">
      <scroll-view
        v-if="listMounted"
        :key="listKey"
        class="drawer-scroll"
        direction="vertical"
        :show-scrollbar="false"
        :refresher-enabled="true"
        :refresher-triggered="refreshing"
        @scrolltolower="handleTaskLoadMore"
        @refresherrefresh="handleRefresh"
        @refresherrestore="resetRefresher"
        @refresherabort="resetRefresher"
      >
        <!-- ===== 项目 ===== -->
        <view class="section-title">
          <text class="section-title-text">{{ t("Mobile.Common.projects") }}</text>
        </view>
        <view v-if="projectShowArchivedEntry" class="archived-entry" @click="toggleProjectArchivedView">
          <text class="iconfont icon-order archived-entry-icon" />
          <text class="archived-entry-text">{{
            showProjectArchivedView
              ? t("Mobile.Auth.back")
              : t("Mobile.Project.archivedProjects") + " (" + projectArchivedCount + ")"
          }}</text>
        </view>
        <template v-if="visibleProjectGroups.length > 0">
          <view v-for="group in visibleProjectGroups" :key="group.id" class="project-block">
            <view
              class="project-row"
              @click="toggleProjectExpand(group.id)"
              @longpress="handleProjectLongPress(group.id)"
            >
              <text v-if="group.pinned" class="iconfont icon-order project-flag-icon" />
              <text class="project-name">{{ group.name }}</text>
              <text
                v-if="group.typeLabelKey.length > 0"
                class="project-type-tag"
              >{{ t(group.typeLabelKey) }}</text>
              <text
                class="iconfont project-arrow"
                :class="group.expanded ? 'icon-a-Chevrondown' : 'icon-a-Chevronright'"
              />
              <view class="project-add-btn" @click.stop="handleAddConversation(group.id)">
                <text class="project-add-icon">＋</text>
              </view>
            </view>
            <view v-if="group.expanded">
              <view
                v-for="child in group.children"
                :key="child.id"
                class="project-child-row"
                @click="handleProjectChildClick(group.id, child.id)"
                @longpress="handleProjectChildLongPress(group.id, child.id)"
              >
                <view class="child-status">
                  <view v-if="child.taskStatus == 'EXECUTING'" class="status-dot status-dot-running" />
                  <text v-else-if="child.taskStatus == 'FAILED'" class="iconfont icon-waring status-failed" />
                </view>
                <text class="child-name">{{ child.name }}</text>
                <text class="child-time">{{ child.timeLabel }}</text>
              </view>
              <view v-if="group.children.length == 0" class="project-child-empty">
                <text class="project-child-empty-text">{{ t("Mobile.Project.noConversation") }}</text>
              </view>
            </view>
          </view>
        </template>
        <view v-else-if="!projectLoading" class="empty-state">
          <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
          <text class="empty-text">{{ t("Mobile.Conversation.projectEmpty") }}</text>
        </view>

        <!-- ===== 任务（会话历史） ===== -->
        <view class="section-title section-title-gap">
          <text class="section-title-text">{{ t("Mobile.Common.tasks") }}</text>
        </view>
        <view v-if="taskShowArchivedEntry" class="archived-entry" @click="toggleTaskArchivedView">
          <text class="iconfont icon-order archived-entry-icon" />
          <text class="archived-entry-text">{{
            showTaskArchivedView
              ? t("Mobile.Auth.back")
              : t("Mobile.Conversation.archivedConversations") + " (" + taskArchivedCount + ")"
          }}</text>
        </view>
        <view v-if="taskRows.length > 0">
          <view
            v-for="(row, index) in taskRows"
            :key="row.id"
            class="task-row"
            @click="handleTaskClick(index)"
            @longpress="handleTaskLongPress(index)"
          >
            <view class="task-title-row">
              <text v-if="row.pinned" class="iconfont icon-order task-flag-icon" />
              <text v-if="row.collected" class="iconfont icon-star task-flag-icon task-flag-icon-star" />
              <text class="task-title">{{ row.topic }}</text>
              <text class="task-time">{{ row.timeLabel }}</text>
            </view>
            <view class="task-bottom-row">
              <text class="task-agent">{{ row.agentName }}</text>
              <view v-if="row.showExecuting" class="task-status-tag">
                <text class="task-status-text">{{ t("Mobile.Conversation.executing") }}</text>
              </view>
            </view>
          </view>
        </view>
        <view v-else-if="!taskLoading" class="empty-state">
          <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
          <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
        </view>
        <view v-if="taskShowNoMore" class="no-more-state">
          <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
        </view>
      </scroll-view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, computed, nextTick, onMounted, onUnmounted, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import { SUCCESS_CODE } from "@/constants/codes.constants.uts";
  import eventBus from "@/utils/eventBus";
  import { EVENT_TYPE } from "@/constants/event.constants";
  import {
    apiAgentConversationList,
    apiAgentConversationUpdate,
    apiAgentConversationDelete,
  } from "@/servers/conversation";
  import { ConversationListParams } from "@/types/interfaces/conversationInfo";
  import { AgentConversationUpdateParams } from "@/types/interfaces/agent";
  import {
    apiUserProjectTabPageQuery,
    apiUserProjectUpdate,
    apiUserProjectDelete,
    apiUserAppUpdate,
    apiUserAppDelete,
  } from "@/servers/project";
  import {
    UserProjectUpdateParams,
    UserAppUpdateParams,
  } from "@/types/interfaces/projectInfo";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { formatTimeAgo } from "@/utils/common";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import {
    CONVERSATION_FLAG_ARCHIVED,
    CONVERSATION_FLAG_COLLECTED,
    CONVERSATION_FLAG_PINNED,
    clearConversationFlags,
    countArchivedConversations,
    filterActiveConversations,
    filterArchivedConversations,
    hasConversationFlag,
    loadConversationFlags,
    sortConversationsByPinned,
    toggleConversationFlag,
  } from "@/utils/conversationLocalFlags.uts";
  import {
    ProjectChildView,
    ProjectGroupView,
    mapProjectTabResponse,
    projectTypeLabelKey,
  } from "@/utils/projectGroupProjection.uts";
  import {
    PROJECT_FLAG_ARCHIVED,
    PROJECT_FLAG_COLLECTED,
    PROJECT_FLAG_PINNED,
    clearProjectFlags,
    countArchivedProjects,
    filterActiveProjects,
    filterArchivedProjects,
    hasProjectFlag,
    loadProjectFlags,
    sortProjectsByPinned,
    toggleProjectFlag,
  } from "@/utils/projectLocalFlags.uts";
  import noData from "@/static/assets/no_data.png";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  interface ProjectTaskDrawerProps {
    isLoggedIn: boolean;
  }
  const props = defineProps<ProjectTaskDrawerProps>();

  const emit = defineEmits<{
    (e: "conversation-click", item: any): void;
  }>();

  const popupRef = ref<any | null>(null);
  const drawerVisible = ref<boolean>(false);

  const TASK_PAGE_SIZE = 20;
  const SILENT_HEAD_SIZE = 10;

  // ============================================================
  // 项目分组（真实接口 /api/user-project/tab/page-query）
  // UTS class 深层追踪不可靠（Android）：可变数据放普通数组，版本号驱动 computed
  // ============================================================
  let projectGroupsData: ProjectGroupView[] = [] as ProjectGroupView[];
  const projectVersion = ref<number>(0);
  const projectFlagsVersion = ref<number>(0);
  const projectLoading = ref<boolean>(false);
  const showProjectArchivedView = ref<boolean>(false);
  let projectLoadedOnce = false;
  let projectRequestPromise: Promise<boolean> | null = null;

  /** 视图模型补充渲染字段（typeLabelKey / pinned），避免模板里反复查 storage */
  class ProjectRowView {
    id: number = 0;
    name: string = "";
    projectType: string = "";
    typeLabelKey: string = "";
    expanded: boolean = true;
    pinned: boolean = false;
    archived: boolean = false;
    children: ProjectChildView[] = [] as ProjectChildView[];
  }

  const visibleProjectGroups = computed((): ProjectRowView[] => {
    const _v = projectVersion.value;
    const _fv = projectFlagsVersion.value;
    const flags = loadProjectFlags();
    const scoped = showProjectArchivedView.value
      ? filterArchivedProjects(projectGroupsData, flags)
      : filterActiveProjects(projectGroupsData, flags);
    const ordered = sortProjectsByPinned(scoped, flags);
    const rows: ProjectRowView[] = [] as ProjectRowView[];
    for (let i = 0; i < ordered.length; i++) {
      const group = ordered[i];
      const row = new ProjectRowView();
      row.id = group.id;
      row.name = group.name;
      row.projectType = group.projectType;
      row.typeLabelKey = projectTypeLabelKey(group.projectType);
      row.expanded = group.expanded;
      row.pinned = hasProjectFlag(PROJECT_FLAG_PINNED, group.id, flags);
      row.archived = hasProjectFlag(PROJECT_FLAG_ARCHIVED, group.id, flags);
      row.children = group.children;
      rows.push(row);
    }
    return rows;
  });

  const projectArchivedCount = computed((): number => {
    const _v = projectVersion.value;
    const _fv = projectFlagsVersion.value;
    return countArchivedProjects(projectGroupsData, loadProjectFlags());
  });

  const projectShowArchivedEntry = computed((): boolean => {
    return projectArchivedCount.value > 0 || showProjectArchivedView.value;
  });

  function findProjectGroup(groupId: number): ProjectGroupView | null {
    for (let i = 0; i < projectGroupsData.length; i++) {
      if (projectGroupsData[i].id == groupId) {
        return projectGroupsData[i];
      }
    }
    return null;
  }

  function formatTimeLabel(targetTime: string): string {
    const ago = formatTimeAgo(targetTime);
    return ago != null ? ago : "";
  }

  async function fetchProjects(): Promise<boolean> {
    try {
      const res = await apiUserProjectTabPageQuery();
      if (apiResCode(res) == SUCCESS_CODE) {
        projectGroupsData = mapProjectTabResponse(apiResData<any>(res), formatTimeLabel);
        // 空主题兜底，与任务列表「未命名会话」口径一致
        const unnamed = t("Mobile.Conversation.unnamed");
        for (let g = 0; g < projectGroupsData.length; g++) {
          const children = projectGroupsData[g].children;
          for (let c = 0; c < children.length; c++) {
            if (children[c].name.length == 0) {
              children[c].name = unnamed;
            }
          }
        }
        projectVersion.value = projectVersion.value + 1;
        projectLoadedOnce = true;
        return true;
      }
      return false;
    } catch (error) {
      console.error("fetchProjects error:", error);
      return false;
    }
  }

  async function requestProjects(): Promise<boolean> {
    const pending = projectRequestPromise;
    if (pending != null) {
      return await pending;
    }
    projectLoading.value = true;
    const requestPromise = fetchProjects();
    projectRequestPromise = requestPromise;
    try {
      return await requestPromise;
    } finally {
      projectRequestPromise = null;
      projectLoading.value = false;
    }
  }

  function toggleProjectExpand(groupId: number): void {
    const group = findProjectGroup(groupId);
    if (group == null) return;
    group.expanded = group.expanded != true;
    projectVersion.value = projectVersion.value + 1;
  }

  function toggleProjectArchivedView(): void {
    showProjectArchivedView.value = showProjectArchivedView.value != true;
  }

  /** 项目「＋」新建会话：后端接口未就绪，占位提示（对齐 PC ProjectPanel）。 */
  function handleAddConversation(groupId: number): void {
    uni.showToast({ title: t("Mobile.Project.addConversationPending"), icon: "none" });
  }

  // ============================================================
  // 任务（会话历史，逻辑自 home-content 任务栏迁入）
  // ============================================================
  class TaskRowView {
    id: number = 0;
    topic: string = "";
    timeLabel: string = "";
    agentName: string = "";
    showExecuting: boolean = false;
    /** 原始列表项引用：列表经置顶排序/归档过滤后 index 不再等于原始下标，交互一律走 row.item */
    item: UTSJSONObject | null = null;
    pinned: boolean = false;
    collected: boolean = false;
  }

  const conversationList = ref<UTSJSONObject[]>([]);
  const taskInitialLoading = ref<boolean>(false);
  const taskLoadingMore = ref<boolean>(false);
  const taskHasMore = ref<boolean>(false);
  const lastId = ref<number | null>(null);
  const taskFlagsVersion = ref<number>(0);
  const showTaskArchivedView = ref<boolean>(false);
  let conversationRequestPromise: Promise<boolean> | null = null;

  const taskLoading = computed((): boolean => {
    return taskInitialLoading.value || taskLoadingMore.value;
  });

  function toNum(v: any | null, fallback: number = 0): number {
    if (v == null) {
      return fallback;
    }
    const parsed = parseFloat(`${v}`);
    return parsed != parsed ? fallback : parsed;
  }
  function toStr(v: any | null, fallback: string = ""): string {
    if (v == null) {
      return fallback;
    }
    return `${v}`;
  }

  function normalizeList(raw: any | null): UTSJSONObject[] {
    const result: UTSJSONObject[] = [];
    if (raw == null) {
      return result;
    }
    let items: any[] = [];
    if (Array.isArray(raw)) {
      items = raw as any[];
    } else {
      try {
        const jsonStr = JSON.stringify(raw);
        if (jsonStr != null && jsonStr.length > 0) {
          const parsed = JSON.parse(jsonStr);
          if (Array.isArray(parsed)) {
            items = parsed as any[];
          }
        }
      } catch (_e) {
        return result;
      }
    }
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      if (item == null) {
        continue;
      }
      try {
        const jsonStr = JSON.stringify(item);
        if (jsonStr != null && jsonStr.length > 0) {
          const obj = JSON.parse(jsonStr) as UTSJSONObject | null;
          if (obj != null) {
            const agentRaw = obj["agent"];
            let agentName = "";
            if (agentRaw != null) {
              try {
                const agentStr = JSON.stringify(agentRaw);
                if (agentStr != null && agentStr.length > 0) {
                  const agentObj = JSON.parse(agentStr) as UTSJSONObject | null;
                  if (agentObj != null) {
                    agentName = toStr(agentObj["name"], "");
                  }
                }
              } catch (_3) {
                agentName = "";
              }
            }
            obj["_agentName"] = agentName;
            result.push(obj);
          }
        }
      } catch (_e2) {
        // skip
      }
    }
    return result;
  }

  function updateConversationItem(target: UTSJSONObject, source: UTSJSONObject): void {
    const topic = source["topic"];
    if (topic != null) {
      target["topic"] = topic;
    }
    const modified = source["modified"];
    if (modified != null) {
      target["modified"] = modified;
    }
    const taskStatus = source["taskStatus"];
    if (taskStatus != null) {
      target["taskStatus"] = taskStatus;
    }
    const agentName = source["_agentName"];
    if (agentName != null) {
      target["_agentName"] = agentName;
    }
    const agentId = source["agentId"];
    if (agentId != null) {
      target["agentId"] = agentId;
    }
  }

  /** 将会话头部增量置顶去重，保留原列表尾部及其分页游标。 */
  function mergeConversationHead(incoming: UTSJSONObject[]): void {
    const current = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
    const merged: UTSJSONObject[] = [];

    for (let i = 0; i < incoming.length; i++) {
      const source = incoming[i];
      const sourceId = toNum(source["id"], 0);
      let target: UTSJSONObject | null = null;
      for (let j = 0; j < current.length; j++) {
        if (toNum(current[j]["id"], 0) == sourceId) {
          target = current[j];
          break;
        }
      }
      if (target != null) {
        updateConversationItem(target, source);
      } else {
        target = source;
      }
      let duplicated = false;
      for (let k = 0; k < merged.length; k++) {
        if (toNum(merged[k]["id"], 0) == sourceId) {
          duplicated = true;
          break;
        }
      }
      if (!duplicated) merged.push(target);
    }

    for (let i = 0; i < current.length; i++) {
      const candidate = current[i];
      const candidateId = toNum(candidate["id"], 0);
      let duplicated = false;
      for (let j = 0; j < merged.length; j++) {
        if (toNum(merged[j]["id"], 0) == candidateId) {
          duplicated = true;
          break;
        }
      }
      if (!duplicated) merged.push(candidate);
    }
    conversationList.value = merged;
  }

  /** 静默查询任务头部 10 条，保留已加载列表、末尾游标和分页状态。 */
  async function silentFetchTasks(): Promise<void> {
    if (!props.isLoggedIn || conversationList.value.length == 0 || conversationRequestPromise != null) return;
    try {
      const params = new ConversationListParams();
      params.agentId = null;
      params.lastId = null;
      params.limit = SILENT_HEAD_SIZE;
      const res = await apiAgentConversationList(params);
      if (apiResCode(res) == SUCCESS_CODE) {
        const newList = normalizeList(apiResData<any>(res));
        mergeConversationHead(newList);
      }
    } catch (error) {
      console.error("silentFetchTasks error:", error);
    }
  }

  async function fetchTasks(isLoadMore: boolean): Promise<boolean> {
    if (!props.isLoggedIn) {
      if (isLoadMore) {
        taskLoadingMore.value = false;
      } else {
        taskInitialLoading.value = false;
      }
      return false;
    }
    try {
      const params = new ConversationListParams();
      params.agentId = null;
      params.lastId = isLoadMore ? lastId.value : null;
      params.limit = TASK_PAGE_SIZE;
      const res = await apiAgentConversationList(params);
      if (apiResCode(res) == SUCCESS_CODE) {
        const newList = normalizeList(apiResData<any>(res));
        if (isLoadMore) {
          const existing = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
          const combined: UTSJSONObject[] = [];
          for (let i = 0; i < existing.length; i++) {
            combined.push(existing[i]);
          }
          for (let j = 0; j < newList.length; j++) {
            const candidate = newList[j];
            const candidateId = toNum(candidate["id"], 0);
            let duplicated = false;
            for (let k = 0; k < combined.length; k++) {
              if (toNum(combined[k]["id"], 0) == candidateId) {
                duplicated = true;
                break;
              }
            }
            if (!duplicated) combined.push(candidate);
          }
          conversationList.value = combined;
        } else {
          conversationList.value = newList;
        }
        if (newList.length > 0) {
          const last = newList[newList.length - 1];
          lastId.value = toNum(last["id"], 0);
          // 接口可能返回不足一页但仍存在下一页，只有空页才能确认到底。
          taskHasMore.value = true;
        } else {
          taskHasMore.value = false;
        }
        return true;
      }
      return false;
    } catch (error) {
      console.error("fetchTasks error:", error);
      return false;
    } finally {
      if (isLoadMore) {
        taskLoadingMore.value = false;
      } else {
        taskInitialLoading.value = false;
      }
    }
  }

  async function requestTasks(isLoadMore: boolean): Promise<boolean> {
    const pending = conversationRequestPromise;
    if (pending != null) {
      return await pending;
    }
    if (isLoadMore) {
      if (!taskHasMore.value) {
        return false;
      }
      taskLoadingMore.value = true;
    } else {
      taskInitialLoading.value = true;
    }
    const requestPromise = fetchTasks(isLoadMore);
    conversationRequestPromise = requestPromise;
    try {
      return await requestPromise;
    } finally {
      // 单飞入口保证同一时刻只有这一笔任务列表请求。
      conversationRequestPromise = null;
    }
  }

  const taskRows = computed((): TaskRowView[] => {
    const _fv = taskFlagsVersion.value;
    const raw = conversationList.value;
    const result: TaskRowView[] = [];
    if (raw == null) {
      return result;
    }
    const flags = loadConversationFlags();
    const scoped = showTaskArchivedView.value
      ? filterArchivedConversations(raw, flags)
      : filterActiveConversations(raw, flags);
    const ordered = sortConversationsByPinned(scoped, flags);
    const unnamed = t("Mobile.Conversation.unnamed");
    const unknownAgent = t("Mobile.Conversation.unknownAgent");
    for (let i = 0; i < ordered.length; i++) {
      const item = ordered[i];
      if (item == null) {
        continue;
      }
      const row = new TaskRowView();
      row.id = toNum(item["id"], 0);
      const topic = toStr(item["topic"], "");
      row.topic = topic.length > 0 ? topic : unnamed;
      const modified = toStr(item["modified"], "");
      const ago = formatTimeAgo(modified);
      row.timeLabel = ago != null ? ago : "";
      const agentName = toStr(item["_agentName"], "");
      row.agentName = agentName.length > 0 ? agentName : unknownAgent;
      const statusStr = toStr(item["taskStatus"], "");
      row.showExecuting = statusStr == "EXECUTING";
      row.item = item;
      row.pinned = hasConversationFlag(CONVERSATION_FLAG_PINNED, row.id, flags);
      row.collected = hasConversationFlag(CONVERSATION_FLAG_COLLECTED, row.id, flags);
      result.push(row);
    }
    return result;
  });

  const taskArchivedCount = computed((): number => {
    const _fv = taskFlagsVersion.value;
    const raw = conversationList.value;
    if (raw == null) {
      return 0;
    }
    return countArchivedConversations(raw, loadConversationFlags());
  });

  const taskShowArchivedEntry = computed((): boolean => {
    return taskArchivedCount.value > 0 || showTaskArchivedView.value;
  });

  const taskShowNoMore = computed((): boolean => {
    const cl = conversationList.value;
    const clLen = cl != null ? cl.length : 0;
    return !taskLoading.value && !taskHasMore.value && clLen > 8;
  });

  function getTaskItemByIndex(index: number): UTSJSONObject | null {
    const rows = taskRows.value;
    if (index < 0 || index >= rows.length) {
      return null;
    }
    return rows[index].item;
  }

  function handleTaskLoadMore(): void {
    if (taskHasMore.value && conversationRequestPromise == null) {
      requestTasks(true);
    }
  }

  function toggleTaskArchivedView(): void {
    showTaskArchivedView.value = showTaskArchivedView.value != true;
  }

  // ============================================================
  // 点击跳转
  // ============================================================
  function handleProjectChildClick(groupId: number, childId: number): void {
    const group = findProjectGroup(groupId);
    if (group == null) return;
    let child: ProjectChildView | null = null;
    for (let i = 0; i < group.children.length; i++) {
      if (group.children[i].id == childId) {
        child = group.children[i];
        break;
      }
    }
    if (child == null) return;
    if (child.agentId <= 0) {
      uni.showToast({ title: t("Mobile.Conversation.agentIdMissing"), icon: "none" });
      return;
    }
    const payload = new UTSJSONObject();
    payload["id"] = child.id;
    payload["agentId"] = child.agentId;
    payload["topic"] = child.name;
    emit("conversation-click", payload);
  }

  function handleTaskClick(index: number): void {
    const item = getTaskItemByIndex(index);
    if (item != null) {
      emit("conversation-click", item);
    }
  }

  // ============================================================
  // 长按操作：任务五项（对齐 PC ConversationContextMenu）
  // ============================================================
  function performTaskFlagToggle(kind: string, id: number, successTitleOn: string, successTitleOff: string): void {
    const enabled = toggleConversationFlag(kind, id);
    taskFlagsVersion.value = taskFlagsVersion.value + 1;
    uni.showToast({
      title: enabled ? successTitleOn : successTitleOff,
      icon: "none",
    });
    if (kind == CONVERSATION_FLAG_ARCHIVED && enabled != true && showTaskArchivedView.value) {
      if (taskArchivedCount.value <= 0) {
        showTaskArchivedView.value = false;
      }
    }
  }

  async function performTaskRenameSubmit(item: UTSJSONObject, newName: string): Promise<void> {
    if (newName.length == 0) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleEmpty"), icon: "none" });
      return;
    }
    if (newName.length > 50) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleTooLong"), icon: "none" });
      return;
    }
    try {
      const updateParams = new AgentConversationUpdateParams();
      updateParams.id = toNum(item["id"], 0);
      updateParams.topic = newName;
      const updateRes = await apiAgentConversationUpdate(updateParams);
      if (apiResCode(updateRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameSuccess"), icon: "success" });
        item["topic"] = newName;
        const list = conversationList.value;
        conversationList.value = list != null ? list.slice(0) : ([] as UTSJSONObject[]);
      } else {
        const errorMessage = apiResMessage(updateRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  async function performTaskDeleteSubmit(item: UTSJSONObject): Promise<void> {
    try {
      const id = toNum(item["id"], 0);
      const deleteRes = await apiAgentConversationDelete(id);
      if (apiResCode(deleteRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.deleteSuccess"), icon: "success" });
        clearConversationFlags(id);
        taskFlagsVersion.value = taskFlagsVersion.value + 1;
        const current = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
        const next: UTSJSONObject[] = [];
        for (let i = 0; i < current.length; i++) {
          const c = current[i];
          if (toNum(c["id"], -1) != id) {
            next.push(c);
          }
        }
        conversationList.value = next;
        if (showTaskArchivedView.value && taskArchivedCount.value <= 0) {
          showTaskArchivedView.value = false;
        }
      } else {
        const errorMessage = apiResMessage(deleteRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  function handleTaskRename(item: UTSJSONObject): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.renameModalTitle"),
      editable: true,
      placeholderText: t("Mobile.Components.HistoryConversationList.renamePlaceholder"),
      content: toStr(item["topic"], ""),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      success: (res) => {
        if (res.confirm) {
          const rawContent = res.content;
          const newName = rawContent != null ? rawContent.trim() : "";
          performTaskRenameSubmit(item, newName);
        }
      },
    });
  }

  function handleTaskDelete(item: UTSJSONObject): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.deleteModalTitle"),
      content: t("Mobile.Components.HistoryConversationList.deleteModalContent"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm) {
          performTaskDeleteSubmit(item);
        }
      },
    });
  }

  function handleTaskLongPress(index: number): void {
    const item = getTaskItemByIndex(index);
    if (item == null) {
      return;
    }
    const id = toNum(item["id"], 0);
    const flags = loadConversationFlags();
    const pinned = hasConversationFlag(CONVERSATION_FLAG_PINNED, id, flags);
    const archived = hasConversationFlag(CONVERSATION_FLAG_ARCHIVED, id, flags);
    const collected = hasConversationFlag(CONVERSATION_FLAG_COLLECTED, id, flags);
    const options = [
      pinned ? t("Mobile.Conversation.unpin") : t("Mobile.Conversation.pin"),
      archived ? t("Mobile.Conversation.unarchive") : t("Mobile.Conversation.archive"),
      collected ? t("Mobile.Conversation.unfavorite") : t("Mobile.Conversation.favorite"),
      t("Mobile.Components.HistoryConversationList.rename"),
      t("Mobile.Components.HistoryConversationList.delete"),
    ];
    uni.showActionSheet({
      itemList: options,
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.tapIndex == 0) {
          performTaskFlagToggle(
            CONVERSATION_FLAG_PINNED,
            id,
            t("Mobile.Conversation.pinSuccess"),
            t("Mobile.Conversation.unpinSuccess"),
          );
        } else if (res.tapIndex == 1) {
          performTaskFlagToggle(
            CONVERSATION_FLAG_ARCHIVED,
            id,
            t("Mobile.Conversation.archiveSuccess"),
            t("Mobile.Conversation.unarchiveSuccess"),
          );
        } else if (res.tapIndex == 2) {
          performTaskFlagToggle(
            CONVERSATION_FLAG_COLLECTED,
            id,
            t("Mobile.Conversation.favoriteSuccess"),
            t("Mobile.Conversation.unfavoriteSuccess"),
          );
        } else if (res.tapIndex == 3) {
          handleTaskRename(item);
        } else if (res.tapIndex == 4) {
          handleTaskDelete(item);
        }
      },
    });
  }

  // ============================================================
  // 长按操作：项目行六项（对齐 PC ProjectPanel 全功能菜单）
  // 置顶/归档/收藏 = 本地标记过渡；重命名/删除按 projectType 路由真实接口；
  // 新建会话 = 占位提示（PC 亦未接入）。
  // ============================================================
  function performProjectFlagToggle(kind: string, id: number, successTitleOn: string, successTitleOff: string): void {
    const enabled = toggleProjectFlag(kind, id);
    projectFlagsVersion.value = projectFlagsVersion.value + 1;
    uni.showToast({
      title: enabled ? successTitleOn : successTitleOff,
      icon: "none",
    });
    if (kind == PROJECT_FLAG_ARCHIVED && enabled != true && showProjectArchivedView.value) {
      if (projectArchivedCount.value <= 0) {
        showProjectArchivedView.value = false;
      }
    }
  }

  function performProjectRenameSubmit(group: ProjectGroupView, newName: string): Promise<void> {
    if (newName.length == 0) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleEmpty"), icon: "none" });
      return Promise.resolve();
    }
    if (newName.length > 50) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleTooLong"), icon: "none" });
      return Promise.resolve();
    }
    // PageApp 契约未覆盖改名（对齐 PC）：仅本地改名
    if (group.projectType != "NormalProject" && group.projectType != "UserApp") {
      group.name = newName;
      projectVersion.value = projectVersion.value + 1;
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameSuccess"), icon: "success" });
      return Promise.resolve();
    }
    const applyLocal = (): void => {
      group.name = newName;
      projectVersion.value = projectVersion.value + 1;
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameSuccess"), icon: "success" });
    };
    if (group.projectType == "UserApp") {
      const params = new UserAppUpdateParams();
      params.id = group.id;
      params.name = newName;
      return apiUserAppUpdate(params).then((updateRes) => {
        if (apiResCode(updateRes) == SUCCESS_CODE) {
          applyLocal();
        } else {
          const errorMessage = apiResMessage(updateRes);
          uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
        }
      }).catch((_e) => {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
    }
    const projectParams = new UserProjectUpdateParams();
    projectParams.id = group.id;
    projectParams.name = newName;
    return apiUserProjectUpdate(projectParams).then((updateRes) => {
      if (apiResCode(updateRes) == SUCCESS_CODE) {
        applyLocal();
      } else {
        const errorMessage = apiResMessage(updateRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  function handleProjectRename(group: ProjectGroupView): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.renameModalTitle"),
      editable: true,
      placeholderText: t("Mobile.Components.HistoryConversationList.renamePlaceholder"),
      content: group.name,
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      success: (res) => {
        if (res.confirm) {
          const rawContent = res.content;
          const newName = rawContent != null ? rawContent.trim() : "";
          performProjectRenameSubmit(group, newName);
        }
      },
    });
  }

  function performProjectDeleteSubmit(group: ProjectGroupView): Promise<void> {
    const request = group.projectType == "UserApp"
      ? apiUserAppDelete(group.id)
      : apiUserProjectDelete(group.id);
    return request.then((deleteRes) => {
      if (apiResCode(deleteRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.deleteSuccess"), icon: "success" });
        clearProjectFlags(group.id);
        const next: ProjectGroupView[] = [] as ProjectGroupView[];
        for (let i = 0; i < projectGroupsData.length; i++) {
          if (projectGroupsData[i].id != group.id) {
            next.push(projectGroupsData[i]);
          }
        }
        projectGroupsData = next;
        projectVersion.value = projectVersion.value + 1;
        if (showProjectArchivedView.value && projectArchivedCount.value <= 0) {
          showProjectArchivedView.value = false;
        }
      } else {
        const errorMessage = apiResMessage(deleteRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  function handleProjectDelete(group: ProjectGroupView): void {
    uni.showModal({
      title: t("Mobile.Project.deleteModalTitle"),
      content: t("Mobile.Project.deleteModalContent"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm) {
          performProjectDeleteSubmit(group);
        }
      },
    });
  }

  function handleProjectLongPress(groupId: number): void {
    const group = findProjectGroup(groupId);
    if (group == null) {
      return;
    }
    const flags = loadProjectFlags();
    const pinned = hasProjectFlag(PROJECT_FLAG_PINNED, group.id, flags);
    const archived = hasProjectFlag(PROJECT_FLAG_ARCHIVED, group.id, flags);
    const collected = hasProjectFlag(PROJECT_FLAG_COLLECTED, group.id, flags);
    // PageApp 契约未覆盖删除（对齐 PC）：不挂删除项
    const canDelete = group.projectType == "NormalProject" || group.projectType == "UserApp";
    const options: string[] = [];
    options.push(pinned ? t("Mobile.Conversation.unpin") : t("Mobile.Conversation.pin"));
    options.push(archived ? t("Mobile.Conversation.unarchive") : t("Mobile.Conversation.archive"));
    options.push(collected ? t("Mobile.Conversation.unfavorite") : t("Mobile.Conversation.favorite"));
    options.push(t("Mobile.Components.HistoryConversationList.rename"));
    if (canDelete) {
      options.push(t("Mobile.Components.HistoryConversationList.delete"));
    }
    options.push(t("Mobile.Conversation.newConversation"));
    uni.showActionSheet({
      itemList: options,
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.tapIndex == 0) {
          performProjectFlagToggle(
            PROJECT_FLAG_PINNED,
            group.id,
            t("Mobile.Conversation.pinSuccess"),
            t("Mobile.Conversation.unpinSuccess"),
          );
        } else if (res.tapIndex == 1) {
          performProjectFlagToggle(
            PROJECT_FLAG_ARCHIVED,
            group.id,
            t("Mobile.Conversation.archiveSuccess"),
            t("Mobile.Conversation.unarchiveSuccess"),
          );
        } else if (res.tapIndex == 2) {
          performProjectFlagToggle(
            PROJECT_FLAG_COLLECTED,
            group.id,
            t("Mobile.Conversation.favoriteSuccess"),
            t("Mobile.Conversation.unfavoriteSuccess"),
          );
        } else if (res.tapIndex == 3) {
          handleProjectRename(group);
        } else if (res.tapIndex == 4 && canDelete) {
          handleProjectDelete(group);
        } else {
          handleAddConversation(group.id);
        }
      },
    });
  }

  // ============================================================
  // 长按操作：项目子会话两项（重命名/删除；PC 定调子项不做置顶）
  // ============================================================
  function performChildRenameSubmit(group: ProjectGroupView, child: ProjectChildView, newName: string): Promise<void> {
    if (newName.length == 0) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleEmpty"), icon: "none" });
      return Promise.resolve();
    }
    if (newName.length > 50) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleTooLong"), icon: "none" });
      return Promise.resolve();
    }
    const updateParams = new AgentConversationUpdateParams();
    updateParams.id = child.id;
    updateParams.topic = newName;
    return apiAgentConversationUpdate(updateParams).then((updateRes) => {
      if (apiResCode(updateRes) == SUCCESS_CODE) {
        child.name = newName;
        projectVersion.value = projectVersion.value + 1;
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameSuccess"), icon: "success" });
      } else {
        const errorMessage = apiResMessage(updateRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  function performChildDeleteSubmit(group: ProjectGroupView, child: ProjectChildView): Promise<void> {
    return apiAgentConversationDelete(child.id).then((deleteRes) => {
      if (apiResCode(deleteRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.deleteSuccess"), icon: "success" });
        clearConversationFlags(child.id);
        const next: ProjectChildView[] = [] as ProjectChildView[];
        for (let i = 0; i < group.children.length; i++) {
          if (group.children[i].id != child.id) {
            next.push(group.children[i]);
          }
        }
        group.children = next;
        projectVersion.value = projectVersion.value + 1;
      } else {
        const errorMessage = apiResMessage(deleteRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  function handleProjectChildLongPress(groupId: number, childId: number): void {
    const group = findProjectGroup(groupId);
    if (group == null) return;
    let child: ProjectChildView | null = null;
    for (let i = 0; i < group.children.length; i++) {
      if (group.children[i].id == childId) {
        child = group.children[i];
        break;
      }
    }
    if (child == null) return;
    const options = [
      t("Mobile.Components.HistoryConversationList.rename"),
      t("Mobile.Components.HistoryConversationList.delete"),
    ];
    uni.showActionSheet({
      itemList: options,
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.tapIndex == 0) {
          uni.showModal({
            title: t("Mobile.Components.HistoryConversationList.renameModalTitle"),
            editable: true,
            placeholderText: t("Mobile.Components.HistoryConversationList.renamePlaceholder"),
            content: child!.name,
            cancelText: t("Mobile.Common.cancel"),
            confirmText: t("Mobile.Common.confirm"),
            success: (modalRes) => {
              if (modalRes.confirm) {
                const rawContent = modalRes.content;
                const newName = rawContent != null ? rawContent.trim() : "";
                performChildRenameSubmit(group, child!, newName);
              }
            },
          });
        } else if (res.tapIndex == 1) {
          uni.showModal({
            title: t("Mobile.Components.HistoryConversationList.deleteModalTitle"),
            content: t("Mobile.Components.HistoryConversationList.deleteModalContent"),
            cancelText: t("Mobile.Common.cancel"),
            confirmText: t("Mobile.Common.confirm"),
            confirmColor: "#ff4d4f",
            success: (modalRes) => {
              if (modalRes.confirm) {
                performChildDeleteSubmit(group, child!);
              }
            },
          });
        }
      },
    });
  }

  // ============================================================
  // 抽屉生命周期 / 刷新
  // ============================================================
  const listMounted = ref<boolean>(false);
  const refreshing = ref<boolean>(false);
  const listKey = ref<number>(0);
  let refreshInFlight = false;

  function handlePopupVisible(visible: boolean): void {
    drawerVisible.value = visible == true;
  }

  function open(): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) return;
    proxy.$callMethod("open");
    if (!props.isLoggedIn) return;
    // 首次打开拉全量；再次打开仅静默补差
    if (!projectLoadedOnce && projectRequestPromise == null) {
      requestProjects();
    }
    if (conversationList.value.length == 0 && conversationRequestPromise == null) {
      requestTasks(false);
    }
  }

  function close(): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) return;
    proxy.$callMethod("close");
  }

  /** 首页 onShow resume：抽屉开着时静默补差（任务头部 + 项目全量）。 */
  function resumeData(): void {
    if (drawerVisible.value != true || !props.isLoggedIn) return;
    silentFetchTasks();
    if (projectRequestPromise == null) {
      requestProjects();
    }
  }

  async function releaseRefresher(): Promise<void> {
    refreshing.value = false;
    listKey.value = listKey.value + 1;
    await nextTick();
  }

  function resetRefresher(): void {
    refreshing.value = false;
  }

  async function performRefresh(): Promise<void> {
    try {
      await nextTick();
      const pending = conversationRequestPromise;
      if (pending != null) {
        await pending;
      }
      lastId.value = null;
      taskHasMore.value = true;
      await requestProjects();
      await requestTasks(false);
    } catch (error) {
      console.error("performRefresh error:", error);
    } finally {
      refreshInFlight = false;
      await releaseRefresher();
    }
  }

  function handleRefresh(): void {
    if (refreshInFlight) {
      releaseRefresher();
      return;
    }
    refreshing.value = true;
    refreshInFlight = true;
    performRefresh();
  }

  /**
   * 消费全局 batch 轮询分发的 ChatFinished：抽屉开着时静默刷新任务头部与项目列表，
   * 保证执行中/已完成状态及时更新。
   */
  function handleChatFinishedEvent(_data: any | null): void {
    if (drawerVisible.value != true) return;
    silentFetchTasks();
    if (projectRequestPromise == null) {
      requestProjects();
    }
  }

  onMounted(() => {
    eventBus.on(`${EVENT_TYPE.ChatFinished}`, handleChatFinishedEvent);
    nextTick(() => {
      listMounted.value = true;
    });
  });

  onUnmounted(() => {
    eventBus.off(`${EVENT_TYPE.ChatFinished}`, handleChatFinishedEvent);
    refreshing.value = false;
    listMounted.value = false;
  });

  defineExpose({
    open: open as any,
    close: close as any,
    resumeData: resumeData as any,
  });
</script>

<style lang="scss" scoped>
  .drawer-wrap {
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    /* #ifdef APP */
    padding-top: 120rpx;
    /* #endif */
  }

  .drawer-scroll {
    width: 100%;
    height: 100%;
  }

  .section-title {
    padding: 24rpx 32rpx 8rpx;

    .section-title-text {
      font-size: 26rpx;
      font-weight: 600;
      color: #8b8e96;
      line-height: 36rpx;
    }
  }

  .section-title-gap {
    padding-top: 40rpx;
  }

  // ===== 归档入口（对齐任务栏既有形态） =====
  .archived-entry {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 16rpx 32rpx;

    .archived-entry-icon {
      font-size: 26rpx;
      color: #8b8e96;
      margin-right: 10rpx;
    }

    .archived-entry-text {
      font-size: 26rpx;
      color: #5147ff;
      line-height: 36rpx;
    }
  }

  // ===== 项目分组 =====
  .project-block {
    border-bottom: 2rpx solid #f5f5f7;

    .project-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 24rpx 32rpx;

      .project-flag-icon {
        flex-shrink: 0;
        font-size: 22rpx;
        color: #8b8e96;
        margin-right: 8rpx;
      }

      .project-name {
        flex-shrink: 1;
        min-width: 0;
        font-size: 30rpx;
        font-weight: 600;
        color: #15171f;
        line-height: 42rpx;
        margin-right: 12rpx;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .project-type-tag {
        flex-shrink: 0;
        padding: 2rpx 12rpx;
        border-radius: 6rpx;
        background-color: rgba(81, 71, 255, 0.08);
        color: #5147ff;
        font-size: 20rpx;
        line-height: 32rpx;
        margin-right: 12rpx;
      }

      .project-arrow {
        flex-shrink: 0;
        font-size: 24rpx;
        color: #8b8e96;
        margin-right: 16rpx;
      }

      .project-add-btn {
        flex-shrink: 0;
        width: 48rpx;
        height: 48rpx;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: rgba(81, 71, 255, 0.08);

        .project-add-icon {
          font-size: 32rpx;
          color: #5147ff;
          line-height: 36rpx;
        }
      }
    }

    .project-child-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 18rpx 32rpx 18rpx 72rpx;

      .child-status {
        flex-shrink: 0;
        width: 32rpx;
        height: 32rpx;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 14rpx;

        .status-dot {
          width: 16rpx;
          height: 16rpx;
          border-radius: 50%;
        }

        .status-dot-running {
          background-color: #52c41a;
        }

        .status-failed {
          font-size: 26rpx;
          color: #ffcb00;
        }
      }

