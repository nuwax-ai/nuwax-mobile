<template>
  <view class="container relative flex flex-col">
    <custom-nav-bar :title="t('Mobile.Terminal.monitorRecords')" className="border-b" hasSafetyZone showBack />

    <!-- 搜索 + 筛选 -->
    <view class="search-row">
      <view class="search-box">
        <input class="search-input" v-model="keyword" :placeholder="searchPlaceholder" placeholder-class="search-placeholder" />
      </view>
      <view class="filter-btn" hover-class="filter-btn-active" @click="handleFilter">
        <text class="filter-text">{{ currentFilter }}</text>
      </view>
    </view>

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <view class="record-list">
        <view :class="['record-card', 'level-' + item.level]" v-for="item in filteredList" :key="item.time">
          <view class="record-head">
            <view class="keyword-tag">
              <text :class="['keyword-text', 'keyword-' + item.level]">{{ item.keyword }}</text>
            </view>
            <text class="record-date">{{ item.time }}</text>
          </view>
          <text class="record-summary">{{ item.summary }}</text>
          <view class="record-actions">
            <view class="action-btn" hover-class="action-btn-active" @click="handleAction(t('Mobile.Terminal.replay'))">
              <text class="action-text">▶ {{ t("Mobile.Terminal.replay") }}</text>
            </view>
            <view class="action-btn" hover-class="action-btn-active" @click="handleAction(t('Mobile.Terminal.download'))">
              <text class="action-text">⬇ {{ t("Mobile.Terminal.download") }}</text>
            </view>
            <view class="action-btn action-btn-primary" hover-class="action-btn-active" @click="handleDetail(item.keyword)">
              <text class="action-text-primary">{{ t("Mobile.Terminal.viewDetail") }}</text>
            </view>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-box" v-if="filteredList.length == 0">
          <text class="empty-text">{{ t("Mobile.Terminal.noMonitorRecords") }}</text>
        </view>
      </view>
      <view class="bottom-space"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const keyword = ref<string>("");
  const currentFilter = ref<string>(t("Mobile.Terminal.allTime"));
  const searchPlaceholder = ref<string>(t("Mobile.Terminal.searchKeyword"));

  class MonitorRecord {
    time: string = "";
    keyword: string = "";
    level: string = "";
    summary: string = "";
    constructor(time: string, keyword: string, level: string, summary: string) {
      this.time = time;
      this.keyword = keyword;
      this.level = level;
      this.summary = summary;
    }
  }

  const recordList = ref<MonitorRecord[]>([
    new MonitorRecord("07-18 15:22", "线上故障", "error", "检测到关键词挂了和500，触发告警，已通知DevOps-Agent排查"),
    new MonitorRecord("07-18 14:10", "紧急上线", "warn", "对话中出现紧急部署关键词，创建紧急上线任务单"),
    new MonitorRecord("07-18 11:45", "数据异常", "error", "检测到数据丢失关键词，手动确认后触发数据恢复流程"),
    new MonitorRecord("07-17 16:30", "安全风险", "warn", "对话中提到权限异常，安全检查已自动运行"),
    new MonitorRecord("07-17 09:15", "线上故障", "info", "预警关键词报错出现但上下文无故障特征，记录备查"),
  ]);

  // 前端过滤
  const filteredList = computed((): MonitorRecord[] => {
    const kw = keyword.value;
    if (kw.length == 0) return recordList.value;
    const result: MonitorRecord[] = [] as MonitorRecord[];
    recordList.value.forEach((item: MonitorRecord) => {
      if (item.keyword.indexOf(kw) >= 0 || item.summary.indexOf(kw) >= 0) {
        result.push(item);
      }
    });
    return result;
  });

  const handleFilter = () => {
    uni.showToast({ title: currentFilter.value, icon: "none" });
  };

  const handleAction = (action: string) => {
    uni.showToast({ title: action, icon: "none" });
  };

  const handleDetail = (kw: string) => {
    uni.showToast({ title: kw, icon: "none" });
  };

  onLoad((options: any) => {
    setCurrentPageNavigationBarTitle();
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .search-row {
    display: flex;
    flex-direction: row;
    padding: 24rpx 24rpx 0;

    .search-box {
      flex: 1;
      background-color: #ffffff;
      border-radius: 16rpx;
      padding: 20rpx 28rpx;
      margin-right: 16rpx;

      .search-input {
        width: 100%;
        font-size: 28rpx;
        color: #1a1a1a;
      }

      .search-placeholder {
        color: #c0c0c0;
      }
    }

    .filter-btn {
      padding: 20rpx 28rpx;
      border-radius: 16rpx;
      background-color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;

      &-active {
        background-color: rgba(12, 20, 102, 0.04);
      }

      .filter-text {
        font-size: 26rpx;
        color: #666666;
      }
    }
  }

  .record-list {
    padding: 24rpx;
  }

  .record-card {
    background-color: #ffffff;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 20rpx;
    border-left: 6rpx solid #c0c0c0;

    &.level-error {
      border-left-color: #fa5151;
    }

    &.level-warn {
      border-left-color: #ff9500;
    }

    &.level-info {
      border-left-color: #999999;
    }

    .record-head {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16rpx;

      .keyword-tag {
        display: flex;
        flex-direction: row;
        align-items: center;

        .keyword-text {
          font-size: 22rpx;
          padding: 4rpx 16rpx;
          border-radius: 8rpx;
          font-weight: 600;

          &.keyword-error {
            color: #fa5151;
          }

          &.keyword-warn {
            color: #ff9500;
          }

          &.keyword-info {
            color: #666666;
          }
        }
      }

      .record-date {
        font-size: 22rpx;
        color: #999999;
        flex-shrink: 0;
      }
    }

    .record-summary {
      font-size: 26rpx;
      color: #1a1a1a;
      line-height: 1.5;
      margin-bottom: 20rpx;
    }

    .record-actions {
      display: flex;
      flex-direction: row;

      .action-btn {
        padding: 12rpx 24rpx;
        border-radius: 12rpx;
        border: 2rpx solid #e0e0e0;
        margin-right: 16rpx;

        &-active {
          background-color: rgba(12, 20, 102, 0.04);
        }

        .action-text {
          font-size: 24rpx;
          color: #666666;
        }

        &.action-btn-primary {
          border-color: #5147ff;
          background-color: rgba(81, 71, 255, 0.08);

          .action-text-primary {
            font-size: 24rpx;
            color: #5147ff;
          }
        }
      }
    }
  }

  .empty-box {
    padding: 80rpx 0;
    display: flex;
    align-items: center;
    justify-content: center;

    .empty-text {
      font-size: 28rpx;
      color: #999999;
    }
  }

  .bottom-space {
    height: 40rpx;
  }
</style>
