<template>
  <view class="gn-page">
    <safety-zone />

    <!-- 顶部：返回 + 群公告 + 保存（管理员可编辑时） -->
    <view class="gn-header">
      <view class="gn-header__btn" hover-class="gn-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="gn-header__title-wrap">
        <text class="gn-header__title">{{ t("Mobile.Message.groupNotice") }}</text>
      </view>
      <view
        v-if="canGovern"
        class="gn-header__btn"
        hover-class="gn-header__btn--active"
        @click="handleSave"
      >
        <svg-icon name="icon-Check" size="40" :color="saving ? '#b0aebc' : '#5147ff'" />
      </view>
      <view v-else class="gn-header__btn gn-header__btn--ghost" />
    </view>

    <scroll-view class="gn-body" direction="vertical" :show-scrollbar="false">
      <view v-if="loading" class="gn-state">
        <text class="gn-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view v-else-if="loadFailed" class="gn-state" @click="handleRetry">
        <text class="gn-state__text">{{ t("Mobile.Message.loadFailed") }}</text>
      </view>
      <view v-else class="gn-card">
        <!-- 管理员：可编辑 textarea；普通成员：只读展示 -->
        <textarea
          v-if="canGovern"
          class="gn-input"
          v-model="draft"
          :maxlength="1024"
          :placeholder="t('Mobile.Message.noticeEditPlaceholder')"
          placeholder-style="color:#b0aebc"
          :show-confirm-bar="false"
          :disable-default-padding="true"
        />
        <text v-else class="gn-view">{{ draft.length > 0 ? draft : t("Mobile.Message.noticeUnset") }}</text>
        <view class="gn-meta" v-if="canGovern">
          <text class="gn-meta__count">{{ draft.length }}/1024</text>
        </view>
      </view>
      <view class="gn-tail" />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiImConvDetail, apiImGroupSetNotice } from "@/servers/im";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ===== 页面入参 =====
  const convId = ref<string>("");
  const groupName = ref<string>("");

  // ===== 状态 =====
  /** 编辑草稿（初值=服务端公告；管理员保存时整段提交，空串=清空公告）。 */
  const draft = ref<string>("");
  /** 我的角色：1=普通成员 2=管理员 3=群主（★对齐服务端 ImConstants；管理权限 = >=2）。 */
  const myRole = ref<number>(1);
  const loading = ref<boolean>(false);
  const loadFailed = ref<boolean>(false);
  const saving = ref<boolean>(false);

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  const canGovern = ref<boolean>(false);

  /** 详情：拿 notice 原文 + myRole（>=2 群主/管理员才给编辑）。 */
  async function loadAll(): Promise<void> {
    if (convId.value.length == 0 || loading.value) {
      return;
    }
    loading.value = true;
    loadFailed.value = false;
    try {
      const res = await apiImConvDetail(convId.value);
      if (apiResCode(res) != SUCCESS_CODE) {
        loading.value = false;
        loadFailed.value = true;
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        draft.value = readString(dataObj, "notice");
        myRole.value = readNumber(dataObj, "myRole", 1);
        canGovern.value = myRole.value >= 2;
        const name = readString(dataObj, "name");
        if (name.length > 0) {
          groupName.value = name;
        }
      }
      loading.value = false;
    } catch (_error) {
      loading.value = false;
      loadFailed.value = true;
    }
  }

  function handleRetry(): void {
    if (loadFailed.value) {
      loadAll();
    }
  }

  /**
   * 保存公告：★空串=清空（null 才是「不改」），与 PC 端一致；
   * data=false（值相同没写库）仍是成功码，勿当失败。
   */
  async function handleSave(): Promise<void> {
    if (saving.value || convId.value.length == 0) {
      return;
    }
    saving.value = true;
    try {
      const res = await apiImGroupSetNotice(convId.value, draft.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Profile.saveSuccess"), icon: "none" });
      } else {
        uni.showToast({ title: apiResMessage(res), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
    saving.value = false;
  }

  function handleBack(): void {
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      uni.switchTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    groupName.value = readOption(options, "name");
    loadAll();
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架 ===== */
  .gn-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #f6f5fb;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  .gn-header {
    flex-shrink: 0;
    height: 108rpx;
    padding: 0 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(250, 249, 253, 0.92);
    border-bottom: 2rpx solid rgba(81, 71, 255, 0.1);
  }

  .gn-header__btn {
    min-width: 72rpx;
    height: 72rpx;
    padding: 0 8rpx;
    border-radius: 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gn-header__btn--active {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .gn-header__btn--ghost {
    background-color: rgba(0, 0, 0, 0);
  }

  .gn-header__title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .gn-header__title {
    font-size: 33rpx;
    line-height: 46rpx;
    font-weight: 600;
    color: #17171a;
  }

  .gn-body {
    flex: 1;
    min-height: 0;
    padding: 28rpx 32rpx;
  }

  .gn-state {
    padding: 240rpx 48rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .gn-state__text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #9a98a5;
  }

  .gn-card {
    min-height: 520rpx;
    padding: 28rpx;
    background-color: #ffffff;
    border: 2rpx solid #ecebf1;
    border-radius: 20rpx;
    display: flex;
    flex-direction: column;
  }

  .gn-input {
    flex: 1;
    min-height: 420rpx;
    padding: 0;
    font-size: 30rpx;
    line-height: 48rpx;
    color: #22212a;
    background-color: rgba(0, 0, 0, 0);
  }

  .gn-view {
    flex: 1;
    font-size: 30rpx;
    line-height: 48rpx;
    color: #22212a;
  }

  .gn-meta {
    margin-top: 16rpx;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
  }

  .gn-meta__count {
    font-size: 22rpx;
    line-height: 32rpx;
    color: #b0aebc;
  }

  .gn-tail {
    height: 40rpx;
  }
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #f6f5fb;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #f6f5fb;
  }
  /* #endif */
</style>
