/**
 * 广场应用点击分流：ThirdApp 用 homepageUrl，UserApp 用生产域名，其余走默认跳转。
 */
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { apiUserAppDomainList, apiPublishedAppRecentlyUsedAdd } from "@/servers/project";
import { apiResCode, apiResData } from "@/utils/apiResponse";
import { jumpAbsoluteUrlToWebview } from "@/utils/commonBusiness";
import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

function readNumber(info: UTSJSONObject, key: string): number {
  const raw = info[key];
  if (raw == null) {
    return 0;
  }
  const parsed = parseFloat(`${raw}`);
  return parsed != parsed ? 0 : parsed;
}

function parseListRecords(dataRaw: any | null): UTSJSONObject[] {
  const result: UTSJSONObject[] = [] as UTSJSONObject[];
  if (dataRaw == null) {
    return result;
  }
  const jsonStr = JSON.stringify(dataRaw);
  if (jsonStr == null || jsonStr.length == 0) {
    return result;
  }
  if (jsonStr.charAt(0) == "[") {
    const list = JSON.parse(jsonStr) as UTSJSONObject[] | null;
    if (list != null) {
      for (let i = 0; i < list.length; i++) {
        result.push(list[i]);
      }
    }
    return result;
  }
  const pageData = JSON.parse(jsonStr) as UTSJSONObject | null;
  if (pageData == null) {
    return result;
  }
  const records = pageData["records"];
  if (records != null) {
    const list = records as UTSJSONObject[];
    for (let i = 0; i < list.length; i++) {
      result.push(list[i]);
    }
  }
  return result;
}

export function normalizePreviewUrl(raw: string): string {
  const text = raw.trim();
  if (text.length == 0) {
    return "";
  }
  if (text.indexOf("http://") == 0 || text.indexOf("https://") == 0) {
    return text;
  }
  if (text.indexOf("//") == 0) {
    return `https:${text}`;
  }
  return `https://${text}`;
}

/**
 * 广场应用项的项目 ID：优先 targetId（应用/项目主键），缺省回落发布记录 id。
 */
export function readPublishedAppProjectId(info: UTSJSONObject): number {
  let projectId = readNumber(info, "targetId");
  return projectId;
}

/**
 * 广场应用收藏所需 projectType（user-project collect 必传 query）。
 * 优先 targetType；网页应用常见 targetType=Agent + targetSubType=PageApp，改用子类型。
 */
export function readPublishedAppProjectType(info: UTSJSONObject): string {
  const typeRaw = info["targetType"];
  const targetType = typeRaw != null ? `${typeRaw}` : "";
  if (
    targetType == "UserApp" ||
    targetType == "ThirdApp" ||
    targetType == "PageApp" ||
    targetType == "NormalProject"
  ) {
    return targetType;
  }
  const subRaw = info["targetSubType"];
  const subType = subRaw != null ? `${subRaw}` : "";
  if (
    subType == "UserApp" ||
    subType == "ThirdApp" ||
    subType == "PageApp" ||
    subType == "NormalProject"
  ) {
    return subType;
  }
  if (subType.length > 0) {
    return subType;
  }
  return targetType;
}

export function pickProdDomain(dataRaw: any | null): string {
  const rows = parseListRecords(dataRaw);
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    const typeRaw = row["domainType"];
    const typeText = typeRaw != null ? `${typeRaw}` : "";
    if (typeText != "Prod") {
      continue;
    }
    const domainRaw = row["domain"];
    const domain = domainRaw != null ? `${domainRaw}` : "";
    const url = normalizePreviewUrl(domain);
    if (url.length > 0) {
      return url;
    }
  }
  return "";
}

export function openHomepagePreview(info: UTSJSONObject, previewUrl: string): void {
  if (previewUrl.length == 0) {
    uni.showToast({
      title: t("Mobile.AppDev.homepageUrlEmpty"),
      icon: "none",
    });
    return;
  }
  const nameRaw = info["name"];
  const title = nameRaw != null ? `${nameRaw}` : "";
  jumpAbsoluteUrlToWebview(previewUrl, title);
}

export async function openUserAppPreview(info: UTSJSONObject): Promise<void> {
  let appId = readNumber(info, "targetId");
  if (appId <= 0) {
    appId = readNumber(info, "id");
  }
  if (appId <= 0) {
    openHomepagePreview(info, "");
    return;
  }
  uni.showLoading({ title: t("Mobile.Page.loading"), mask: true });
  try {
    const res = await apiUserAppDomainList(appId);
    if (apiResCode(res) != SUCCESS_CODE) {
      openHomepagePreview(info, "");
      return;
    }
    openHomepagePreview(info, pickProdDomain(apiResData<any>(res)));
  } catch (error) {
    console.error("openUserAppPreview error", error);
    openHomepagePreview(info, "");
  } finally {
    uni.hideLoading();
  }
}

/**
 * UserApp / ThirdApp 点击时后台记最近使用，不 await，不挡住跳转。
 */
function trackPublishedAppRecentlyUsed(info: UTSJSONObject): void {
  const subRaw = info["targetSubType"];
  const projectType = subRaw != null ? `${subRaw}` : "";
  if (projectType == "PageApp" || (projectType != "UserApp" && projectType != "ThirdApp")) {
    return;
  }
  let projectId = readNumber(info, "targetId");
  if (projectId <= 0) {
    projectId = readNumber(info, "id");
  }
  if (projectId <= 0) {
    return;
  }
  apiPublishedAppRecentlyUsedAdd(projectId, projectType).then((_res: any | null) => {}, (error: any | null) => {
    console.error("apiPublishedAppRecentlyUsedAdd error", error);
  });
}

let publishedAppClickKey: string = "";
let publishedAppClickAt: number = 0;

function shouldSkipPublishedAppClick(info: UTSJSONObject): boolean {
  const id = readNumber(info, "targetId");
  const subRaw = info["targetSubType"];
  const subType = subRaw != null ? `${subRaw}` : "";
  const key = `${id}:${subType}`;
  const now = Date.now();
  if (key == publishedAppClickKey && now - publishedAppClickAt < 600) {
    return true;
  }
  publishedAppClickKey = key;
  publishedAppClickAt = now;
  return false;
}

/**
 * previewHomepage 分流：ThirdApp / UserApp 预览，其它类型走 onDefault（通常是 PageApp 详情）。
 */
export function dispatchPublishedAppClick(
  info: UTSJSONObject,
  onDefault: (item: UTSJSONObject) => void,
): void {
  if (shouldSkipPublishedAppClick(info)) {
    return;
  }
  trackPublishedAppRecentlyUsed(info);
  const typeRaw = info["targetType"];
  const targetType = typeRaw != null ? `${typeRaw}` : "";
  if (targetType == "ThirdApp") {
    const homepageRaw = info["homepageUrl"];
    const previewUrl = homepageRaw != null ? normalizePreviewUrl(`${homepageRaw}`) : "";
    openHomepagePreview(info, previewUrl);
    return;
  }
  if (targetType == "UserApp") {
    openUserAppPreview(info);
    return;
  }
  onDefault(info);
}
