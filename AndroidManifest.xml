<?xml version="1.0" encoding="utf-8"?>
<!--
  uni-app x 自定义 Android 清单（云端打包时与基座清单合并）。
  uni-app x 的 manifest.json 不提供 Android 权限配置（app-plus.distribute.android.permissions
  是老 uni-app 的 schema，云打包不读），自定义权限统一写在本文件 manifest 节点下。
  注意：本文件改动需重新云打包（自定义调试基座）才生效。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.nuwax.app">

    <!-- 聊天附件下载 apk 后拉起系统安装器：Android 8+ 必须声明此权限，否则安装器无反应 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 读取音频类附件（Android 13+ 分区媒体权限，模块默认模板未包含） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- 离线推送通知权限（Android 13+ 运行时权限）：缺它通知会被系统静默丢弃，
         但 pushEnabled 仍为 true，问题极难定位 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启动（normal 级安装时权限，无需运行时申请）：重启后接收 BOOT_COMPLETED 广播，
         供推送 SDK 重建长连接/离线通道。若推送 AAR 已自带该权限，合并时会自动去重，声明无害。
         注意：国产 ROM「自启动」开关是厂商私有限制，仍需用户在系统设置里手动放行。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ 包可见性：用于判断 Google Play Services 是否真实安装并启用，
         仅查询固定包名，不申请 QUERY_ALL_PACKAGES。 -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

</manifest>
