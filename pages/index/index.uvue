<template>
  <view class="h-full flex flex-col border-b">
    <!-- 页面级下拉层：固定在屏幕最顶部，覆盖导航栏展开。 -->
    <view
      v-if="defaultAgentId > 0 && defaultAgentPullDistance > 0"
      class="default-agent-top-layer"
      :style="'height: ' + defaultAgentLayerHeight + 'px;'"
    >
      <default-agent-pull-entry
        :agent-name="defaultAgentName"
        :agent-icon="defaultAgentIcon"
        :agent-description="defaultAgentDescription"
        :pull-distance="defaultAgentPullDistance"
        :trigger-distance="defaultAgentTriggerDistance"
      />
    </view>

    <!-- 顶部导航栏：仅此区域下拉时展开默认智能体入口。 -->
    <view
      class="home-nav-pull-zone"
      @touchstart="handleNavPullStart"
      @touchmove.stop="handleNavPullMove"
      @touchend="handleNavPullEnd"
      @touchcancel="handleNavPullCancel"
    >
    <custom-nav-bar className="border-b" hasSafetyZone :leftWide="isLoggedIn">
      <template v-slot:left>
        <view class="flex flex-row items-center">
          <view v-if="isLoggedIn" class="home-nav-tabs">
            <view class="home-nav-tab" @click="handleHomeTabChange('recent')">
              <text :class="['home-nav-tab-text', homeActiveTab == 'recent' ? 'home-nav-tab-text-on' : '']">{{ t("Mobile.Common.recentUsed") }}</text>
              <view v-if="homeActiveTab == 'recent'" class="home-nav-tab-line" />
            </view>
            <view class="home-nav-tab" @click="handleHomeTabChange('history')">
              <text :class="['home-nav-tab-text', homeActiveTab == 'history' ? 'home-nav-tab-text-on' : '']">{{ t("Mobile.Common.conversationHistory") }}</text>
              <view v-if="homeActiveTab == 'history'" class="home-nav-tab-line" />
            </view>
          </view>
          <!-- 登录、注册按钮 -->
          <!-- App：hover-class 对 scoped 嵌套选择器（如 &.active）常不生效；用独立类名 + touch 兜底 -->
          <view
            v-if="!isLoggedIn"
            class="login-btn-wrapper"
            :class="{ 'login-btn-hover': loginBtnPressed }"
            hover-class="login-btn-hover"
            :hover-start-time="0"
            @touchstart="onLoginBtnTouchStart"
            @touchend="onLoginBtnTouchEnd"
            @touchcancel="onLoginBtnTouchEnd"
            @click="handleLogin"
          >
            <text class="login-btn-text">{{
              t("Mobile.Common.loginRegister")
            }}</text>
          </view>
          <!-- #ifdef MP-WEIXIN -->
          <view v-if="isLoggedIn" class="icon-search-box" @click="handleSearch">
            <svg-icon name="icon-Search" size="48" />
          </view>
          <!-- #endif -->
        </view>
      </template>

      <!-- #ifdef H5 || WEB || APP -->
      <template v-slot:right>
        <view v-if="isLoggedIn" class="icon-search-box" @click="handleSearch">
          <svg-icon name="icon-Search" size="48" />
        </view>
        <text style="font-size: 36rpx; margin-left: 8rpx" @click="goPerfTest">⚡</text>
      </template>
      <!-- #endif -->
    </custom-nav-bar>
    </view>

    <!-- 小程序与 Android 使用原生布局，避免 uni-notice-bar 的 Vue 样式未编译导致错位。 -->
    <!-- #ifdef MP-WEIXIN -->
    <view v-if="!isLoggedIn && showExperienceNotice" class="experience-notice">
      <!-- #ifdef APP-ANDROID -->
      <view class="experience-notice-icon">
        <svg-icon name="icon-voice-1-notice" size="32" />
      </view>
      <!-- #endif -->
      <!-- #ifdef MP-WEIXIN -->
      <text class="iconfont icon-voice-1 experience-notice-icon"></text>
      <!-- #endif -->
      <text class="experience-notice-text">{{ t('Mobile.Common.noticeExperience') }}</text>
      <!-- #ifdef APP-ANDROID -->
      <view class="experience-notice-close" @click="closeExperienceNotice">
        <svg-icon name="icon-X-notice" size="32" />
      </view>
      <!-- #endif -->
      <!-- #ifdef MP-WEIXIN -->
      <text class="iconfont icon-X experience-notice-close" @click="closeExperienceNotice"></text>
      <!-- #endif -->
    </view>
    <!-- #endif -->

    <!-- 通知栏（APP-ANDROID 暂用 uni-notice-bar 的 .vue 样式不兼容，先隐藏） -->
    <!-- #ifndef APP-ANDROID -->
    <!-- #ifndef MP-WEIXIN -->
    <uni-notice-bar
      v-if="!isLoggedIn"
      single
      show-close
      show-icon
      :text="t('Mobile.Common.noticeExperience')"
    ></uni-notice-bar>
    <!-- #endif -->
    <!-- #endif -->

    <!-- 未登录时只显示智能体列表，不显示标签页 -->
    <agent-list-content
      v-if="!isLoggedIn"
      class="content-area"
      ref="agentListContentRef"
      :is-logged-in="isLoggedIn"
      @agent-click="handleAgentClick"
    >
      <!-- 头部随列表滚动，列表区吸顶 -->
      <home-header
        :user-info="userInfo"
        :is-logged-in="isLoggedIn"
        @agent-click="handleAgentClickLast"
        @input-click="handleSearch"
      />
    </agent-list-content>

    <!-- 登录后：标签栏固定在顶部，下方列表独立滚动 -->
    <home-content
      v-if="isLoggedIn"
      class="content-area"
      ref="homeContentRef"
      :is-logged-in="isLoggedIn"
      @agent-click="handleAgentClickLast"
      @conversation-click="handleConversationClick"
      @tab-change="handleHomeContentTabChange"
    />

    <!-- 登录弹窗（仅微信小程序） -->
    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, nextTick, type ComponentPublicInstance } from 'vue';
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiUserInfo, apiTenantConfig } from "@/servers/account";
  import { apiPublishedAgentInfo } from "@/servers/agentDev";
  import type { AgentInfo } from "@/types/interfaces/agent";
  import HomeHeader from "./home-header/home-header.uvue";
  import HomeContent from "./home-content/home-content.uvue";
  import AgentListContent from "./agent-list-content/agent-list-content.uvue";
  import DefaultAgentPullEntry from "./default-agent-pull-entry/default-agent-pull-entry.uvue";
  import { UserInfo } from "@/types/interfaces/login";
  import { onHide, onLoad, onShow } from "@dcloudio/uni-app";
  // #ifdef MP-WEIXIN
  import { onShareAppMessage, onAddToFavorites } from "@dcloudio/uni-app";
  // #endif
  import { getCurrentPagePath, jumpToAgentDetailPage } from "@/utils/commonBusiness";
  import { goToLogin } from "@/utils/authNavigation";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  // #ifdef MP-WEIXIN
  import AuthLoginPopup from "@/components/auth-login-popup/auth-login-popup.uvue";
  // #endif
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import { EVENT_POLLING_DEBUG } from "@/hooks/useEventPolling";
  import { getStatusBarHeight, setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
  import { useI18n, applyTabBarI18n, emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { orEmpty } from "@/utils/utsCoalesce.uts";

  const { syncLanguageFromUser } = useI18n();
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const showExperienceNotice = ref<boolean>(true);
  const defaultAgentId = ref<number>(0);
  const defaultAgentName = ref<string>("");
  const defaultAgentIcon = ref<string>("");
  const defaultAgentDescription = ref<string>("");
  const defaultAgentType = ref<string>("ChatBot");
  const defaultAgentLoading = ref<boolean>(false);
  const defaultAgentPullDistance = ref<number>(0);
  // 下拉层完整高度 = 系统顶部安全区 + 卡片内容层。
  const defaultAgentTriggerDistance = getStatusBarHeight() + 140;
  const defaultAgentLayerHeight = computed((): number => {
    const distance = defaultAgentPullDistance.value;
    if (distance <= 0) {
      return 0;
    }
    return distance > defaultAgentTriggerDistance ? defaultAgentTriggerDistance : distance;
  });
  const navPullStartX = ref<number>(0);
  const navPullStartY = ref<number>(0);
  const navPullTracking = ref<boolean>(false);
  // 分享标题
  const shareTitle = ref<string>("");
  const fallbackShareTitle = computed<string>((): string => t("Mobile.Nav.home"));
  // App：hover-class 不稳时用 touch 驱动按压态
  const loginBtnPressed = ref<boolean>(false);
  const onLoginBtnTouchStart = () => {
    loginBtnPressed.value = true;
  };
  const onLoginBtnTouchEnd = () => {
    loginBtnPressed.value = false;
  };

  const closeExperienceNotice = () => {
    showExperienceNotice.value = false;
  };

  // 智能体列表组件ref（未登录）
  const agentListContentRef = ref<any | null>(null);
  // 首页内容组件ref（登录后：固定标签栏 + 独立滚动列表）
  const homeContentRef = ref<any | null>(null);
  const homeActiveTab = ref<string>("recent");

  function goPerfTest(): void {
    uni.navigateTo({ url: "/pages/test-stream-perf/test-stream-perf" });
  }

  function handleHomeTabChange(tab: string): void {
    homeActiveTab.value = tab;
    const inst = homeContentRef.value;
    if (inst == null) return;
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod("changeContentTab", tab);
  }

  function handleHomeContentTabChange(tab: string): void {
    homeActiveTab.value = tab;
  }

  function applyDefaultAgentConfig(raw: any | null): number {
    if (raw == null) {
      return 0;
    }
    const obj = raw as UTSJSONObject;
    const idRaw = obj["defaultAgentId"];
    const id = idRaw != null ? (idRaw as number) : 0;
    defaultAgentId.value = id;
    return id;
  }

  async function loadDefaultAgentEntry(): Promise<void> {
    if (defaultAgentLoading.value) {
      return;
    }
    defaultAgentLoading.value = true;
    try {
      let agentId = 0;
      const cachedRaw = uni.getStorageSync(TENANT_CONFIG_INFO);
      if (cachedRaw != null && `${cachedRaw}`.length > 0) {
        try {
          const cached = JSON.parse<UTSJSONObject>(`${cachedRaw}`);
          agentId = applyDefaultAgentConfig(cached);
        } catch (_e) {
          agentId = 0;
        }
      }

      // 每次进入首页以服务端租户配置为准；缓存只用于提前准备下拉入口。
      const configRes = await apiTenantConfig();
      if (apiResCode(configRes) == SUCCESS_CODE) {
        const configData = apiResData<any>(configRes);
        if (configData != null) {
          uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(configData));
          agentId = applyDefaultAgentConfig(configData);
        }
      }

      if (agentId > 0) {
        const detailRes = await apiPublishedAgentInfo(agentId, false);
        if (apiResCode(detailRes) == SUCCESS_CODE) {
          const detailRaw = apiResData<any>(detailRes);
          if (detailRaw != null) {
            const detail = detailRaw as UTSJSONObject;
            const nameRaw = detail["name"];
            const iconRaw = detail["icon"];
            const descriptionRaw = detail["description"];
            const typeRaw = detail["type"];
            defaultAgentName.value = nameRaw != null ? `${nameRaw}` : t("Mobile.Common.appName");
            defaultAgentIcon.value = iconRaw != null ? `${iconRaw}` : "";
            defaultAgentDescription.value = descriptionRaw != null ? `${descriptionRaw}` : "";
            defaultAgentType.value = typeRaw != null ? `${typeRaw}` : "ChatBot";
          }
        }
      }
    } catch (error) {
      console.error("加载首页默认智能体入口失败", error);
    } finally {
      defaultAgentLoading.value = false;
    }
  }

  function handleDefaultAgentOpen(): void {
    const agentId = defaultAgentId.value;
    if (agentId <= 0) {
      return;
    }
    const rawType = defaultAgentType.value;
    const agentType: "ChatBot" | "PageApp" | "TaskAgent" = rawType == "PageApp"
      ? "PageApp"
      : (rawType == "TaskAgent" ? "TaskAgent" : "ChatBot");
    jumpToAgentDetailPage(agentId, null, agentType, defaultAgentName.value);
  }

  function handleNavPullStart(e: UniTouchEvent): void {
    if (defaultAgentId.value <= 0 || e.touches == null || e.touches.length == 0) {
      return;
    }
    navPullStartX.value = e.touches[0].clientX;
    navPullStartY.value = e.touches[0].clientY;
    navPullTracking.value = true;
    defaultAgentPullDistance.value = 0;
  }

  function handleNavPullMove(e: UniTouchEvent): void {
    if (!navPullTracking.value || e.touches == null || e.touches.length == 0) {
      return;
    }
    const touch = e.touches[0];
    const deltaX = touch.clientX - navPullStartX.value;
    const deltaY = touch.clientY - navPullStartY.value;
    if (deltaY <= 0 || Math.abs(deltaX) > deltaY) {
      defaultAgentPullDistance.value = 0;
      return;
    }
    defaultAgentPullDistance.value = deltaY;
  }

  function finishNavPull(shouldOpen: boolean): void {
    navPullTracking.value = false;
    if (shouldOpen) {
      handleDefaultAgentOpen();
    }
    defaultAgentPullDistance.value = 0;
  }

  function handleNavPullEnd(): void {
    finishNavPull(defaultAgentPullDistance.value >= defaultAgentTriggerDistance);
  }

  function handleNavPullCancel(): void {
    finishNavPull(false);
  }

  // 使用登录拦截 composable
  const {
    loginPopupRef,
    handleAgentClick: baseHandleAgentClick,
    checkAuthAndShowPopup,
    hasToken,
  } = useAuthInterceptor();

  // Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject；用 $callMethod 调 defineExpose 方法
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // 处理会话项点击
  const handleConversationClick = (item: any) => {
    const obj = item as UTSJSONObject;
    jumpToAgentDetailPage(obj["agentId"] as number, obj["id"] as number);
  };

  // 处理登录点击
  const handleLogin = () => {
    // #ifdef MP-WEIXIN
    callRefMethod(loginPopupRef.value, "open");
    // #endif

    // #ifdef H5 || WEB || APP
    goToLogin();
    // #endif
  };




  // 最近使用
  const handleAgentClickLast = (info: any) => {
    const infoObj = info as UTSJSONObject;
    const lastConvRaw = infoObj["lastConversationId"];
    const agentIdRaw = infoObj["agentId"];
    const agentId = agentIdRaw != null ? (agentIdRaw as number) : 0;
    const lastConversationId = lastConvRaw != null ? (lastConvRaw as number) : 0;
    if (lastConversationId > 0) {
      jumpToAgentDetailPage(agentId, lastConversationId);
    } else {
      const nameRaw = infoObj["name"];
      const iconRaw = infoObj["icon"];
      const descRaw = infoObj["description"];
      const agentTypeRaw = infoObj["agentType"];
      baseHandleAgentClick({
        targetId: agentId,
        name: nameRaw != null ? `${nameRaw}` : "",
        agentType: agentTypeRaw != null ? `${agentTypeRaw}` : null,
        icon: iconRaw != null ? `${iconRaw}` : "",
        description: descRaw != null ? `${descRaw}` : "",
      });
    }
  };


  // 用户信息
  const userInfo = ref<UserInfo | null>(null);

  // 判断是否登录
  const isLoggedIn = ref<boolean>(false);

  // 包装 handleAgentClick 以适配 AgentInfo 类型
  const handleAgentClick = (info: any) => {
    // 检查登录状态，如果未登录则显示登录弹窗
    if (!isLoggedIn.value) {
      handleLogin();
      return;
    }
    const infoObj = info as UTSJSONObject;
    const agentIdRaw = infoObj["agentId"];
    const nameRaw = infoObj["name"];
    const iconRaw = infoObj["icon"];
    const descRaw = infoObj["description"];
    const agentTypeRaw = infoObj["agentType"];
    baseHandleAgentClick({
      targetId: agentIdRaw != null ? (agentIdRaw as number) : 0,
      name: nameRaw != null ? `${nameRaw}` : "",
      agentType: agentTypeRaw != null ? `${agentTypeRaw}` : null,
      icon: iconRaw != null ? `${iconRaw}` : "",
      description: descRaw != null ? `${descRaw}` : "",
    });
  };

  // 查询当前登录用户信息
  async function fetchUserInfo(): Promise<void> {
    const res = await apiUserInfo();
    if (res != null && apiResCode(res) == SUCCESS_CODE) {
      const rawData = apiResData<any>(res);
      userInfo.value = rawData != null ? new UserInfo(rawData as UTSJSONObject) : null;
      let lang = "";
      if (userInfo.value != null) {
        lang = userInfo.value.lang;
      }
      await syncLanguageFromUser(lang);
    }
  }

  // 设置分享标题
  async function setCurrentShareTitle(): Promise<void> {
    // 获取本地用户配置
    const tenantConfigRaw = uni.getStorageSync(TENANT_CONFIG_INFO);
    const tenantConfigInfoString = orEmpty(tenantConfigRaw);
    if (tenantConfigInfoString.length > 0) {
      try {
        const parsed = JSON.parse<UTSJSONObject>(tenantConfigInfoString);
        if (parsed != null) {
          const siteName = parsed["siteName"] as string | null;
          const siteDescription = parsed["siteDescription"] as string | null;
          let titleStr = "";
          if (siteName != null) {
            titleStr = siteName;
          }
          if (siteDescription != null) {
            titleStr = titleStr.length > 0
              ? titleStr + " " + siteDescription
              : siteDescription;
          }
          shareTitle.value = titleStr;
        }
      } catch (error) {
        console.error("获取本地用户配置失败:", error);
      }
    }
  }

  onLoad((options: any) => {
    // 检测是否为文件预览分享跳转
    // #ifdef MP-WEIXIN
    if (options?.cId && options?.fileProxyUrl) {
      // 跳转到文件预览页面
      // 注意：fileProxyUrl 在分享时已经被 encodeURIComponent 编码过了
      // 这里不需要再次编码，直接传递即可
      uni.navigateTo({
        url: `/subpackages/pages/file-preview-page/file-preview-page?cId=${options.cId}&fileProxyUrl=${encodeURIComponent(options.fileProxyUrl)}`,
      });
      return;
    }
    // #endif

    // 设置当前页面导航栏标题
    setCurrentPageNavigationBarTitle();

    // 设置分享标题
    setCurrentShareTitle();
    loadDefaultAgentEntry();
  });

  let onShowReloadCount = 0;
  // onShow 的异步逻辑抽出到命名函数，规避 async 回调返回 Promise 与 Unit 不匹配
  async function performOnShow(): Promise<void> {
    // 确保从新页面返回首页时清除残存的加载提示框
    uni.hideLoading();
    onShowReloadCount = onShowReloadCount + 1;
    if (EVENT_POLLING_DEBUG == true) {
      console.log(`[Home] onShow reload #${onShowReloadCount}`);
    }

    // 确保每次回到首页都刷新一次 TabBar 翻译，
    // 解决语言切换重载后 TabBar 对象可能未就绪导致 uni.setTabBarItem 失效的问题。
    applyTabBarI18n();

    const loggedIn = await hasToken();
    isLoggedIn.value = loggedIn;
    // 如果是登录状态，需要等待 home-content 初始化
    if (isLoggedIn.value) {
      await nextTick();
      fetchUserInfo();
      // 返回首页时保留现有分页数据与滚动位置，仅恢复被导航打断的加载状态。
      callRefMethod(homeContentRef.value, "resumeData");
    }
  }
  onShow(() => {
    performOnShow();
  });

  onHide(() => {
    callRefMethod(homeContentRef.value, "pauseData");
  });

  // 处理搜索（异步逻辑抽出，规避模板事件 handler 直接 async）
  async function performSearch(): Promise<void> {
    // 检查登录状态，如果未登录则显示登录弹窗
    const ok = await checkAuthAndShowPopup();
    if (!ok) {
      return;
    }
    const currentUrl = getCurrentPagePath();

    if (homeActiveTab.value == "history") {
      uni.navigateTo({
        url:
          "/subpackages/pages/conversation-search/conversation-search?backUrl=" +
          encodeURIComponent(currentUrl),
      });
    } else {
      uni.navigateTo({
        url:
          "/subpackages/pages/agent-search/agent-search?type=Home&backUrl=" +
          encodeURIComponent(currentUrl),
      });
    }
  }
  const handleSearch = () => {
    performSearch();
  };

  // #ifdef MP-WEIXIN
  // 转发给朋友
  onShareAppMessage(() => {
    return {
      title: shareTitle.value.length > 0 ? shareTitle.value : fallbackShareTitle.value,
      path: "/pages/index/index",
    };
  });

  // 收藏
  onAddToFavorites(() => {
    return {
      title: shareTitle.value.length > 0 ? shareTitle.value : fallbackShareTitle.value,
    };
  });
  // #endif

</script>

<style lang="scss" scoped>
  .default-agent-top-layer {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 999;
    overflow: hidden;
    background-color: #f2f0ff;
  }

  .home-nav-pull-zone {
    width: 100%;
    flex-shrink: 0;
  }

  /* #ifdef MP-WEIXIN || APP-ANDROID */
  .experience-notice {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 72rpx;
    padding: 16rpx 24rpx;
    box-sizing: border-box;
    background-color: #fff9ea;

    &-icon,
    &-close {
      flex-shrink: 0;
    }

    &-icon {
      margin-right: 12rpx;
    }

    &-close {
      margin-left: 16rpx;
      padding: 4rpx;
    }

    /* #ifdef MP-WEIXIN */
    &-icon,
    &-close {
      color: #ff9a43;
      font-size: 32rpx;
      line-height: 40rpx;
    }
    /* #endif */

    &-text {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      color: #ff9a43;
      font-size: 28rpx;
      line-height: 40rpx;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  }
  /* #endif */
</style>

<!-- 在微信小程序编译后，scoped 会把选择器变成类似 page[data-v-xxx]，而小程序根节点 page 不会带这个属性，所以匹配不到，样式就“无效” -->
<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 || MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || MP-LARK || MP-KUAISHOU || MP-JD */
  page {
    height: 100%;
  }
  /* #endif */
</style>

<style lang="scss" scoped>
  .h-full {
    height: 100%;
    background-color: #ffffff;
  }

  .w-full {
    width: 100%;
  }

  .content-area {
    flex: 1;
    min-height: 0;
    width: 100%;
  }

  .icon-search-box {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 12rpx;
  }

  .home-nav-tabs {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 64rpx;
  }

  .home-nav-tab {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64rpx;
