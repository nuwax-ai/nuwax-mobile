<template>
  <view class="app-card" @click="emit('click')">
    <agent-icon
      :icon="icon"
      :size="88"
      :iconRadius="28"
      :marginRight="20"
      :alt="name"
    />
    <view class="app-card__body">
      <view class="app-card__head">
        <text class="app-card__name">{{ name }}</text>
        <view class="app-card__views">
          <svg-icon name="icon-eye-open" :size="28" color="#b0b0b8" />
          <text class="app-card__count">{{ viewText }}</text>
        </view>
      </view>
      <text v-if="description.length > 0" class="app-card__desc">{{ description }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import AgentIcon from "@/components/agent-icon/agent-icon.uvue";

  const props = withDefaults(
    defineProps<{
      icon: string;
      name: string;
      description: string;
      /** 浏览人数，展示为 3.2k */
      viewCount?: number;
    }>(),
    {
      viewCount: 0,
    },
  );

  const emit = defineEmits<{
    click: [];
  }>();

  /**
   * 千位缩写：3200 → 3.2k，3000 → 3k。
   */
  function formatCompactCount(count: number): string {
    let value = count;
    if (value != value || value < 0) {
      value = 0;
    }
    if (value < 1000) {
      return `${Math.floor(value)}`;
    }
    let unit = "k";
    let scaled = value / 1000;
    if (value >= 1000000) {
      unit = "m";
      scaled = value / 1000000;
    }
    const tenths = Math.floor(scaled * 10 + 0.5);
    const whole = Math.floor(tenths / 10);
    const frac = tenths - whole * 10;
    if (frac == 0) {
      return `${whole}${unit}`;
    }
    return `${whole}.${frac}${unit}`;
  }

  const viewText = computed((): string => {
    return formatCompactCount(props.viewCount);
  });
</script>

