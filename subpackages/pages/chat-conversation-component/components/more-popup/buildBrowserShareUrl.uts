import { API_BASE_URL } from "@/constants/config";

/**
 * App / 小程序：拼浏览器可打开的 H5 分享地址。
 * H5 端直接用 window.location.href（见 more-popup handleShare）。
 */
export function buildBrowserShareUrl(
  agentId: number,
  conversationId: number,
  isAppDetails: boolean,
): string {
  let url = "";
  if (agentId <= 0 || API_BASE_URL.length == 0) {
    return url;
  }
  const pagePath =
    isAppDetails == true
      ? "/subpackages/pages/app-details/app-details"
      : "/subpackages/pages/agent-detail/agent-detail";
  let query = "id=" + agentId.toString();
  if (conversationId > 0) {
    query = query + "&conversationId=" + conversationId.toString();
  }
  const hashMark = String.fromCharCode(35);
  url = API_BASE_URL + "/m/" + hashMark + pagePath + "?" + query;
  return url;
}
