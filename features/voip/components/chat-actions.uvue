<template>
  <view v-if="enabled || busy" class="call-actions">
    <view v-if="busy" class="call-action" @click="openVoipPage()">
      <text class="call-icon">↗</text><text class="call-label">{{ t("Mobile.Voip.return") }}</text>
    </view>
    <view v-if="enabled && !busy" class="call-action" @click="dial('audio')">
      <text class="call-icon">☎</text><text class="call-label">{{ t("Mobile.Voip.audio") }}</text>
    </view>
    <view v-if="video && !busy" class="call-action" @click="dial('video')">
      <text class="call-icon">▣</text><text class="call-label">{{ t("Mobile.Voip.video") }}</text>
    </view>
  </view>
</template>
<script setup lang="uts">
  import { ref, computed, watch, onMounted } from "vue";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  import { voipCapabilities, startVoipCall, isVoipBusy, voipRevision, openVoipPage as openCallPage } from "@/features/voip/callManager";
  const props = defineProps({ convId: { type: String, default: "" } });
  const enabled = ref(false), video = ref(false), dialing = ref(false);
  let request = 0;
  const busy = computed((): boolean => { voipRevision.value; return isVoipBusy(); });
  async function refresh(): Promise<void> {
    if (process.env.NODE_ENV == "development") console.log("[VoipActions] capabilities checking");
    const run = ++request; enabled.value = false; video.value = false;
    if (props.convId.length == 0) return;
    const caps = await voipCapabilities(props.convId);
    if (run != request) return;
    enabled.value = caps["enabled"] === true && caps["audio"] === true;
    video.value = enabled.value && caps["video"] === true;
    if (process.env.NODE_ENV == "development") console.log("[VoipActions] enabled=" + enabled.value);
  }
  function openVoipPage(): void { openCallPage(); }
  async function dial(mode: string): Promise<void> {
    if (process.env.NODE_ENV == "development") console.log("[VoipActions] tapped");
    if (dialing.value) return;
    dialing.value = true;
    try { await startVoipCall(props.convId, mode); } finally { dialing.value = false; }
  }
  watch((): string => props.convId, (): void => { refresh(); });
  onMounted(() => { refresh(); });
</script>
<style scoped>
  .call-actions { flex-direction: row; }
  .call-action { width: 78px; align-items: center; margin-right: 12px; }
  .call-icon { width: 58px; height: 58px; border-radius: 14px; background-color: #ffffff; color: #3568cf; font-size: 28px; text-align: center; line-height: 58px; }
  .call-label { margin-top: 8px; font-size: 12px; color: #55565e; }
</style>
