export type MainTabSafeArea = { left: number; right: number; bottom: number };

/** 读取实际窗口 Insets，不按设备型号或屏幕高度猜测手势条尺寸。 */
export function readMainTabSafeArea(): MainTabSafeArea {
  // #ifdef APP
  const insets = uni.getWindowInfo().safeAreaInsets;
  return {
    left: Math.max(0, insets.left),
    right: Math.max(0, insets.right),
    bottom: Math.max(0, insets.bottom),
  };
  // #endif
  // #ifndef APP
  // Web 使用 CSS env 自动响应浏览器安全区和屏幕旋转。
  return { left: 0, right: 0, bottom: 0 };
  // #endif
}
