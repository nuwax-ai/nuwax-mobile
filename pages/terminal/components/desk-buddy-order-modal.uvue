      background-color: #5147ff;
    }

    .order-form-btn-disabled {
      opacity: 0.6;
    }

    .order-form-btn-cancel-text,
    .order-form-btn-confirm-text {
      font-size: 28rpx;
      font-weight: 600;
    }

    .order-form-btn-cancel-text {
      color: #4e5969;
    }

    .order-form-btn-confirm-text {
      color: #ffffff;
    }
  }

  /* 终端场景稿：底部设备信息与收货表单。 */
  .order-modal-mask {
    background-color: rgba(15, 17, 48, 0.55);
    align-items: center;
    justify-content: center;
  }

  .order-modal-content {
    position: relative;
    box-sizing: border-box;
    width: 686rpx;
    border-radius: 48rpx;
    padding: 24rpx 40rpx 40rpx;
    overflow: hidden;
  }

  .order-modal-header {
    position: relative;
    height: 68rpx;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-bottom-width: 0;
  }

  .order-modal-title {
    flex: none;
    color: #191c33;
    font-size: 30rpx;
    font-weight: 600;
    letter-spacing: 8rpx;
    text-align: center;
  }

  .order-modal-close {
    /* 相对 content（position: relative）定位，按钮整体落在 content 盒内：
       Android uvue 对绝对定位子元素按父容器边界裁剪命中区域，
       此前负偏移伸出 header（right:-30rpx/top:-10rpx）导致按钮大片区域点击无效 */
    position: absolute;
    top: 14rpx;
    right: 10rpx;
    z-index: 10;
    width: 88rpx;
    height: 88rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .order-product {
    display: flex;
    flex-direction: column;
    padding: 32rpx;
    margin: 32rpx 0;
    border-radius: 32rpx;
    background-color: #f8f9ff;
  }

  .order-product-head {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .order-product-face {
    position: relative;
    width: 88rpx;
    height: 88rpx;
    flex-shrink: 0;
    border-radius: 26rpx;
    background-color: #4e53e8;
    margin-right: 28rpx;
    overflow: hidden;

    .order-product-image {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      width: 88rpx;
      height: 88rpx;
      border-radius: 26rpx;
    }

    .face-eyes {
      position: absolute;
      top: 33rpx;
      left: 26rpx;
      right: 26rpx;
      display: flex;
      flex-direction: row;
      justify-content: space-between;

      .face-eye {
        width: 10rpx;
        height: 10rpx;
        border-radius: 50%;
        background-color: #ffffff;
      }
    }

    .face-smile {
      position: absolute;
      left: 28rpx;
