import ImageView from "android.widget.ImageView"
import View from "android.view.View"
import PictureDrawable from "android.graphics.drawable.PictureDrawable"
import { SVG } from "com.caverock.androidsvg"
import { UTSAndroid } from "io.dcloud.uts"

export class NativeSvgRenderer {
  private element: UniNativeViewElement
  private imageView: ImageView | null = null
  private listener: ((message: string | null) => void) | null = null
  private lastContent: string = ''
  private initError: string | null = null
  private destroyed: boolean = false

  constructor(element: UniNativeViewElement) {
    this.element = element
    const activity = UTSAndroid.getUniActivity()
    if (activity == null) {
      this.initError = 'Android activity is unavailable'
      return
    }

    const view = new ImageView(activity)
    view.setAdjustViewBounds(true)
    view.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
    view.setLayerType(View.LAYER_TYPE_SOFTWARE, null)
    this.imageView = view
    this.element.bindAndroidView(view)
  }

  setListener(listener: (message: string | null) => void): void {
    if (this.destroyed) return
    this.listener = listener
    if (this.initError != null) {
      this.listener?.invoke(this.initError)
    }
  }

  setFit(fit: string): void {
    if (this.destroyed) return
    const view = this.imageView
    if (view == null) return
    if (fit == 'cover') view.setScaleType(ImageView.ScaleType.CENTER_CROP)
    else if (fit == 'fill') view.setScaleType(ImageView.ScaleType.FIT_XY)
    else if (fit == 'center') view.setScaleType(ImageView.ScaleType.CENTER)
    else view.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
  }

  setSvg(content: string): void {
    if (this.destroyed) return
    const view = this.imageView
    if (view == null) {
      this.listener?.invoke(this.initError ?? 'Android native view is not initialized')
      return
    }

    if (content.trim().length == 0) {
      clear()
      return
    }

    if (content == this.lastContent) {
      this.listener?.invoke(null)
      return
    }

    try {
      const svg = SVG.getFromString(content)
      const drawable = new PictureDrawable(svg.renderToPicture())
      view.setImageDrawable(drawable)
      this.lastContent = content
      this.listener?.invoke(null)
    } catch (e) {
      view.setImageDrawable(null)
      this.lastContent = ''
      this.listener?.invoke(`failed to render SVG: ${e}`)
    }
  }

  clear(): void {
    this.imageView?.setImageDrawable(null)
    this.lastContent = ''
  }

  destroy(): void {
    if (this.destroyed) return
    this.destroyed = true
    clear()
    this.listener = null
    this.imageView = null
    this.initError = null
  }
}
