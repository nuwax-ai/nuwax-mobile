/** 页面预览数据（UTS 需 class 构造） */
export class PreviewData {
  uri: string = "";
  method: "browser_navigate_page" | "browser_open_page" = "browser_open_page";
  data_type: "html" | "markdown" = "html";
  request_id: string = "";
}

export function readPreviewData(raw: any): PreviewData {
  const data = new PreviewData();
  if (raw == null) {
    return data;
  }
  const obj = raw as UTSJSONObject;
  const uri = obj["uri"];
  if (uri != null) {
    data.uri = uri as string;
  }
  const method = obj["method"];
  if (method != null) {
    data.method = method as "browser_navigate_page" | "browser_open_page";
  }
  const dataType = obj["data_type"];
  if (dataType != null) {
    data.data_type = dataType as "html" | "markdown";
  }
  const requestId = obj["request_id"];
  if (requestId != null) {
    data.request_id = requestId as string;
  }
  return data;
}
