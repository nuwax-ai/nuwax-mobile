/**
 * SSE 干预数据适配器
 * 从 SSE chunk 中提取 ACP Permission 和 MCP Ask 数据
 * 对齐 nuwax Web 版 applyAcpPermissionSseEvent + applyMcpAskToolCallSseEvent
 */
import {
  AcpPermissionInteraction,
  AcpPermissionOption,
  AcpPermissionOptionKind,
  AcpPermissionRequest,
  AcpToolCallInfo,
  McpAskInteraction,
} from "@/types/intervention";
import {
  createMcpAskInteractionFromToolInput,
  extractMcpAskStructuredInputFromResult,
  parseMcpAskToolInput,
} from "@/utils/mcpAskSchema.uts";
import {
  firstString,
  orEmpty,
  orObject,
  orString,
} from "@/utils/utsCoalesce.uts";

/** SSE 事件 data 载荷 */
interface SSEEventPayload {
  id?: string;
  ext?: unknown;
}

/** SSE chunk 中的数据结构（与 chatDataAdapter.uts 中的 SSEChunk 兼容） */
interface SSEEventData {
  messageType?: string;
  message_type?: string;
  subType?: string;
  sub_type?: string;
  eventType?: string;
  data?: SSEEventPayload;
}

function nonEmpty(value: any): any | null {
  if (
    value != null &&
    typeof value === "object" &&
    Object.keys(value).length > 0
  ) {
    return value;
  }
  return null;
}

function getMcpAskRawInput(chunk: SSEEventData): any | null {
  const rawData = chunk as any;
  const envelope = parseSseEventEnvelope(chunk);
  const data = extractEventData(envelope, chunk);
  const ext = data?.ext;
  const result = orObject(data?.result, rawData?.result);
  const candidates = [
    extractMcpAskStructuredInputFromResult(result),
    data?.rawInput,
    data?.raw_input,
    ext?.rawInput,
    ext?.raw_input,
    result?.input,
    result?.rawInput,
    result?.raw_input,
    rawData?.rawInput,
    rawData?.raw_input,
  ];
  for (let i = 0; i < candidates.length; i++) {
    const value = nonEmpty(candidates[i]);
    if (value != null) {
      return value;
    }
  }
  return null;
}

function parseSseEventEnvelope(chunk: SSEEventData): SSEEventData {
  const nested = (chunk as any).data;
  if (
    nested != null &&
    typeof nested === "object" &&
    (nested.messageType != null ||
      nested.message_type != null ||
      nested.subType != null ||
      nested.sub_type != null ||
      nested.subEventType != null)
  ) {
    return nested as SSEEventData;
  }
  return chunk;
}

function extractEventData(envelope: SSEEventData, fallback: SSEEventData): any {
  const inner = (envelope as any).data;
  if (inner != null && typeof inner === "object") return inner;
  const fallbackData = (fallback as any).data;
  if (fallbackData != null && typeof fallbackData === "object") return fallbackData;
  return fallback as any;
}

function getToolCallId(chunk: SSEEventData): string {
  const rawData = chunk as any;
  const envelope = parseSseEventEnvelope(chunk);
  const data = extractEventData(envelope, chunk);
  const result = orObject(data?.result, rawData?.result);
  return firstString([
    data?.tool_call_id,
    data?.toolCallId,
    data?.executeId,
    result?.executeId,
    result?.toolCallId,
    result?.tool_call_id,
    rawData?.tool_call_id,
    rawData?.toolCallId,
    rawData?.executeId,
  ]);
}

/**
 * 判断是否为 ACP Permission 事件
 * 对齐 backend SandboxAgentClient.isAcpPermissionEvent() 的识别逻辑
 */
export function isAcpPermissionEvent(chunk: SSEEventData): boolean {
  const envelope = parseSseEventEnvelope(chunk);
  const messageType = firstString([
    envelope.messageType,
    (envelope as any).message_type,
  ]);
  const subType = firstString([envelope.subType, (envelope as any).sub_type]);
  const eventType = firstString([
    (chunk as any).eventType,
    (envelope as any).eventType,
  ]);
  const data = extractEventData(envelope, chunk);
  const result = data?.result;
  const processingInput = result?.input;

  if (eventType === "ACP_REQUEST_PERMISSION") {
    return true;
  }
  if (
    eventType === "PROCESSING" &&
    (data?.subEventType === "REQUEST_PERMISSION" ||
      !!processingInput?.request_permission_request)
  ) {
    return true;
  }

  // 直接匹配 messageType
  if (messageType === "acpRequestPermission") {
    return true;
  }
  // 匹配 subType
  if (subType === "request_permission" || subType === "AcpRequestPermission") {
    return true;
  }
  return false;
}

/**
 * 判断是否为 MCP Ask tool_call 事件
 * 对齐 nuwax Web 版 applyMcpAskToolCallSseEvent 的识别逻辑
 */
export function isMcpAskToolCallEvent(chunk: SSEEventData): boolean {
  const envelope = parseSseEventEnvelope(chunk);
  const subType = firstString([envelope.subType, (envelope as any).sub_type]);
  const messageType = firstString([
    envelope.messageType,
    (envelope as any).message_type,
  ]);
  const eventType = firstString([
    (chunk as any).eventType,
    (envelope as any).eventType,
  ]);
  const data = extractEventData(envelope, chunk);
  const result = data?.result;
  const isToolCallLike =
    subType === "tool_call" ||
    subType === "tool_call_update" ||
    messageType === "tool_call" ||
    !!data?.tool_call_id ||
    !!data?.toolCallId ||
    !!data?.executeId ||
    !!result?.executeId;

  // 对齐 Web applyMcpAskToolCallSseEvent：Sandbox PROCESSING ToolCall 事件
  const isProcessingToolCallEvent =
    eventType === "PROCESSING" &&
    !!(
      data?.executeId ||
      result?.executeId ||
      result?.input ||
      extractMcpAskStructuredInputFromResult(result)
    );

  // 识别 subEventType=ASK_QUESTION 的 PROCESSING 事件。
  // 此类事件 result.executeId/input 均为 null，MCP Ask 数据在 result.data 中。
  const isAskQuestionEvent =
    eventType === "PROCESSING" &&
    (envelope as any).subEventType === "ASK_QUESTION";

  if (!isToolCallLike && !isProcessingToolCallEvent && !isAskQuestionEvent) {
    return false;
  }

  // ASK_QUESTION 事件：直接从 result.data 提取 MCP Ask 数据
  if (isAskQuestionEvent && result?.data && typeof result.data === "object") {
    return parseMcpAskToolInput(result.data) !== null;
  }

  const rawInput = getMcpAskRawInput(chunk);
  if (rawInput == null) return false;

  return parseMcpAskToolInput(rawInput) !== null;
}

/**
 * 从 ACP Permission SSE 事件中提取交互数据
 */
export function extractAcpPermissionInteraction(
  chunk: SSEEventData,
): AcpPermissionInteraction | null {
  if (!isAcpPermissionEvent(chunk)) return null;

  const envelope = parseSseEventEnvelope(chunk);
  const data = extractEventData(envelope, chunk);
  const result = data?.result;
  const processingInput = result?.input;
  const requestMeta = orObject(processingInput?._meta, data?._meta);

  const intervention = orObject(
    data._intervention,
    orObject(data.interventionRequest, data.intervention),
  );
  const requestPermission = orObject(
    data.request_permission_request,
    orObject(
      processingInput?.request_permission_request,
      data.requestPermissionRequest,
    ),
  );
  const request = orObject(
    requestPermission,
    orObject(
      intervention?.acp?.request,
      orObject(intervention?.request, orObject(data.request, data)),
    ),
  );
  const toolCall = orObject(request.tool_call, orObject(request.toolCall, {}));
  const options = Array.isArray(request.options) ? request.options : [];
  const sessionId = firstString([
    request.session_id,
    request.sessionId,
    intervention?.sessionId,
    data.session_id,
    data.sessionId,
  ]);
  const toolCallId = firstString([
    data.tool_call_id,
    processingInput?.tool_call_id,
    data.toolCallId,
    request.tool_call_id,
    request.toolCallId,
    toolCall.tool_call_id,
    toolCall.toolCallId,
  ]);
  const executeId = firstString([
    data.executeId,
    result?.executeId,
    processingInput?.executeId,
  ]);
  // 原始工具输入：用于提取 MCP Ask requestId，对齐 PC readMcpAskRequestId 的双路抑制逻辑
  const toolCallRawInput = orObject(
    toolCall.rawInput,
    orObject(
      toolCall.raw_input,
      orObject(
        request.rawInput,
        orObject(
          request.raw_input,
          orObject(request.input, orObject(processingInput, null)),
        ),
      ),
    ),
  );

  const resolvedSessionId =
    sessionId.length > 0 ? sessionId : String(Date.now());
  const resolvedToolCallId =
    toolCallId.length > 0
      ? toolCallId
      : Math.random().toString(36).substring(2, 9);

  const mappedOptions: AcpPermissionOption[] = [];
  for (let oi = 0; oi < options.length; oi++) {
    const opt = options[oi];
    const optionItem = new AcpPermissionOption();
    optionItem.optionId = firstString([
      opt.option_id,
      opt.optionId,
      opt.id != null ? String(opt.id) : "",
    ]);
    optionItem.kind = orString(opt.kind, "allow_once") as AcpPermissionOptionKind;
    optionItem.name = firstString([opt.name, opt.label, opt.kind]);
    mappedOptions.push(optionItem);
  }

  const toolCallInfo = new AcpToolCallInfo();
  toolCallInfo.toolCallId = toolCallId;
  toolCallInfo.title = firstString([request.title, toolCall.title]);
  toolCallInfo.kind = firstString([request.kind, toolCall.kind]);
  toolCallInfo.rawInput = toolCallRawInput;

  const permissionRequest = new AcpPermissionRequest();
  permissionRequest.sessionId = sessionId;
  permissionRequest.toolCall = toolCallInfo;
  permissionRequest.options = mappedOptions;

  const interaction = new AcpPermissionInteraction();
  interaction.id = firstString(
    [
      intervention?.id,
      requestMeta?.nuwaclaw_intervention_id,
      request.id,
    ],
    `itv_${resolvedSessionId}_${resolvedToolCallId}`,
  );
  interaction.request = permissionRequest;
  interaction.responseStatus = "pending";
  if (typeof executeId === "string" && executeId.length > 0) {
    interaction.executeId = executeId;
  }
  return interaction;
}

/**
 * 从 MCP Ask tool_call 事件中提取交互数据
 */
export function extractMcpAskInteraction(
  chunk: SSEEventData,
): McpAskInteraction | null {
  if (!isMcpAskToolCallEvent(chunk)) return null;

  const envelope = parseSseEventEnvelope(chunk);
  const eventType = firstString([
    (chunk as any).eventType,
    (envelope as any).eventType,
  ]);

  // ASK_QUESTION 事件：MCP Ask 数据在 result.data 中，toolCallId 用 result.data.requestId
  if (
    eventType === "PROCESSING" &&
    (envelope as any).subEventType === "ASK_QUESTION"
  ) {
    const data = extractEventData(envelope, chunk);
    const result = data?.result;
    const resultData = result?.data;
    if (resultData && typeof resultData === "object") {
      const requestId = orEmpty(resultData.requestId);
      const toolCallId =
        requestId.length > 0 ? requestId : getToolCallId(chunk);
      return createMcpAskInteractionFromToolInput(resultData, toolCallId);
    }
  }

  const rawInput = getMcpAskRawInput(chunk);
  if (rawInput == null) return null;

  return createMcpAskInteractionFromToolInput(rawInput, getToolCallId(chunk));
}
