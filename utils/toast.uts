// #ifdef APP-HARMONY
import { showTextToast, hideTextToast } from '@/uni_modules/nuwax-toast';
// #endif

const TOAST_FONT_SIZE = 16;
const TOAST_SIDE_MARGIN = 16;
const TOAST_HORIZONTAL_PADDING = 20;
let installed = false;

/** 按中英文宽度和换行估算阅读时间；调用方给出的更长时长继续保留。 */
export function toastReadingDuration(title: string, windowWidth: number, requested: number | null = null): number {
  const lineCapacity = Math.max(1, (windowWidth - TOAST_SIDE_MARGIN * 2 - TOAST_HORIZONTAL_PADDING * 2) / TOAST_FONT_SIZE);
  let units = 0;
  let lineUnits = 0;
  let lines = 0;
  for (let i = 0; i < title.length; i++) {
    const code = title.charCodeAt(i) ?? 0;
    if (code == 13) continue;
    if (code == 10) {
      lines += Math.max(1, Math.ceil(lineUnits / lineCapacity));
      lineUnits = 0;
      continue;
    }
    // UTF-16 代理对作为一个可见字符计算，避免 emoji 被重复计数。
    if (code >= 0xd800 && code <= 0xdbff && i + 1 < title.length) i += 1;
    const width = code <= 0x7f ? 0.5 : 1;
    units += width;
    lineUnits += width;
  }
  lines += Math.max(1, Math.ceil(lineUnits / lineCapacity));
  const readingTime = 2000 + Math.max(0, lines - 1) * 1000 + Math.max(0, units - 14) * 60;
  const suggested = Math.min(8000, Math.ceil(readingTime / 500) * 500);
  return Math.max(suggested, requested != null && requested > 0 ? requested : 0);
}

/**
 * 保留业务侧 uni.showToast 调用，统一补足阅读时间（含成功、失败、请求层提示）。
 * 普通业务不要传 position：Android 的系统 Toast 会忽略自定义 duration，并限制两行。
 * position 仅保留给退出 App、需要盖住原生全屏预览等系统级提示。
 */
export function installToastInterceptor(): void {
  if (installed) return;
  installed = true;
  uni.addInterceptor('showToast', {
    invoke: (options: ShowToastOptions): boolean => {
      const windowWidth = uni.getWindowInfo().windowWidth;
      options.duration = toastReadingDuration(options.title, windowWidth, options.duration ?? null);
      // #ifdef APP-HARMONY
      hideTextToast();
      // 显式 position 是系统级提示（用于盖住原生预览等）；图标、蒙层保持框架行为。
      if (options.icon == 'none' && options.position == null &&
          (options.image == null || options.image == '') && options.mask != true) {
        // 与框架连续 showToast 一样，替换上一次带图标的原生提示，避免两层叠加。
        uni.hideToast();
        const shown = showTextToast(options.title, Math.max(1, windowWidth - TOAST_SIDE_MARGIN * 2), options.duration!);
        if (shown) {
          const result = { errMsg: 'showToast:ok' } as ShowToastSuccess;
          options.success?.(result);
          options.complete?.(result);
          return false;
        }
      }
      // #endif
      return true;
    },
  } as AddInterceptorOptions);
  // #ifdef APP-HARMONY
  uni.addInterceptor('hideToast', {
    invoke: (): boolean => {
      hideTextToast();
      return true;
    },
  } as AddInterceptorOptions);
  uni.addInterceptor('showLoading', {
    invoke: (): boolean => {
      hideTextToast();
      return true;
    },
  } as AddInterceptorOptions);
  // #endif
}
