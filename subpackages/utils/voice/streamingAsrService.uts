/**
 * 流式语音识别服务：录音帧 → 分片上传 → 增量文本回调。
 *
 * 设计（接口未最终确定，见 voiceConfig.asrMock）：
 * - mock 模式：不请求接口，按定时器逐段吐出预设文本，跑通
 *   "录音 → 实时上屏 → 松手可编辑" 全链路；
 * - 真实模式：session/chunk/finish 三段式 HTTP 接口，帧数据 base64 按序串行上传，
 *   每片响应携带累计识别文本（与后端约定草案一致）。
 *
 * 帧数据由录音按钮通过 onFrameRecorded 采集（App/小程序 PCM 帧；
 * H5 MediaRecorder Blob 暂不推送，联调期再适配），统一转 base64 后 pushFrame。
 */
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { voiceConfig, VoiceConfig } from "./voiceConfig";
import { OnAsrText } from "./voiceTypes";

/** mock 吐字间隔（ms） */
const MOCK_EMIT_INTERVAL = 400;
/** mock 每次吐出的字符数 */
const MOCK_EMIT_STEP = 3;

/** 分片识别响应 */
class AsrChunkResult {
  text: string = "";
  isFinal: boolean = false;
}

export class StreamingAsrService {
  private config: VoiceConfig;
  private active: boolean = false;
  private sessionId: string = "";
  /** 分片序号 */
  private seq: number = 0;
  /** 待上传帧队列（base64） */
  private pendingFrames: string[] = [];
  /** 上传串行化标记 */
  private uploading: boolean = false;
  /** 增量文本回调 */
  private onText: OnAsrText | null = null;
  /** mock 吐字定时器 */
  private mockTimerId: number | null = null;
  /** mock 已吐出位置 */
  private mockPos: number = 0;
  /** 会话代次；用于丢弃 cancel/start 之后才返回的旧请求与旧定时器回调。 */
  private generation: number = 0;

  constructor(config: VoiceConfig | null = null) {
    this.config = config != null ? config! : voiceConfig;
  }

  isActive(): boolean {
    return this.active;
  }

  /**
   * 开始流式识别会话
   * @param onText 增量文本回调（text 为累计识别文本）
   * @returns 会话创建是否成功
   */
  async start(onText: OnAsrText): Promise<boolean> {
    if (this.active) {
      return false;
    }
    this.generation += 1;
    const expectedGeneration = this.generation;
    this.onText = onText;
    this.seq = 0;
    this.pendingFrames = [];
    this.uploading = false;
    if (this.config.asrMock) {
      this.sessionId = "mock-session";
      this.active = true;
      this.startMockEmit(expectedGeneration);
      return true;
    }
    try {
      const sessionId = await this.requestSession();
      if (expectedGeneration != this.generation) {
        return false;
      }
      this.sessionId = sessionId;
      this.active = true;
      return true;
    } catch (e: any) {
      console.warn("[StreamingAsr] create session failed", e);
      if (expectedGeneration == this.generation) {
        this.onText = null;
      }
      return false;
    }
  }

  /** 推入一帧音频（base64）；按序暂存、串行上传 */
  pushFrame(base64: string): void {
    if (!this.active) {
      return;
    }
    if (this.config.asrMock) {
      return;
    }
    if (base64.length == 0) {
      return;
    }
    this.pendingFrames.push(base64);
    this.flushNextChunk();
  }

  /** 结束识别：冲刷剩余帧并获取最终文本（通过 onText(text, true) 回调） */
  async stop(): Promise<void> {
    if (!this.active) {
      return;
    }
    const expectedGeneration = this.generation;
    if (this.config.asrMock) {
      this.stopMockEmit();
      const finalText = this.config.asrMockStreamText.substring(0, this.mockPos);
      this.active = false;
      this.emitText(finalText, true, expectedGeneration);
      this.onText = null;
      return;
    }
    // 真实模式：等待待传帧冲刷完成
    let waitRounds = 0;
    while ((this.pendingFrames.length > 0 || this.uploading) && waitRounds < 100) {
      await this.sleep(100);
      waitRounds += 1;
    }
    if (expectedGeneration != this.generation) {
      return;
    }
    try {
      const result = await this.requestFinish();
      if (expectedGeneration != this.generation) {
        return;
      }
      this.active = false;
      this.emitText(result.text, true, expectedGeneration);
    } catch (e: any) {
      console.warn("[StreamingAsr] finish failed", e);
      if (expectedGeneration != this.generation) {
        return;
      }
      this.active = false;
      this.emitText("", true, expectedGeneration);
    }
    if (expectedGeneration == this.generation) {
      this.onText = null;
    }
  }

  /** 取消识别（不上传 finish，直接关闭会话） */
  cancel(): void {
    this.generation += 1;
    this.stopMockEmit();
    this.active = false;
    this.pendingFrames = [];
    this.uploading = false;
    this.onText = null;
  }

  // ==================== mock ====================

  private startMockEmit(expectedGeneration: number): void {
    this.mockPos = 0;
    const full = this.config.asrMockStreamText;
    this.mockTimerId = setInterval(() => {
      if (!this.active || expectedGeneration != this.generation) {
        this.stopMockEmit();
        return;
      }
      this.mockPos += MOCK_EMIT_STEP;
      if (this.mockPos > full.length) {
        this.mockPos = full.length;
      }
      this.emitText(full.substring(0, this.mockPos), false, expectedGeneration);
      if (this.mockPos >= full.length) {
        this.stopMockEmit();
      }
    }, MOCK_EMIT_INTERVAL);
  }

  private stopMockEmit(): void {
    const timerId = this.mockTimerId;
    if (timerId != null) {
      clearInterval(timerId);
      this.mockTimerId = null;
    }
  }

  // ==================== 真实接口 ====================

  private emitText(text: string, isFinal: boolean, expectedGeneration: number): void {
    if (expectedGeneration != this.generation) {
      return;
    }
    const cb = this.onText;
    if (cb != null) {
      cb(text, isFinal);
    }
  }

  private sleep(ms: number): Promise<boolean> {
    return new Promise<boolean>((resolve, _reject) => {
      setTimeout(() => {
        resolve(true);
      }, ms);
    });
  }

  private buildHeader(): UTSJSONObject {
    const header = {} as UTSJSONObject;
    header["Content-Type"] = "application/json";
    const accessToken = uni.getStorageSync(ACCESS_TOKEN);
    if (accessToken != null && `${accessToken}` != "") {
      header["Authorization"] = `Bearer ${accessToken}`;
    }
    return header;
  }

  /** 创建识别会话，返回 sessionId */
  private async requestSession(): Promise<string> {
    return new Promise<string>((resolve, reject) => {
      const body = {} as UTSJSONObject;
      body["sampleRate"] = this.config.asrSampleRate;
      body["format"] = this.config.asrFormat;
      body["language"] = this.config.asrLanguage;
      uni.request<UTSJSONObject>({
        url: this.config.asrSessionUrl,
        method: "POST",
        header: this.buildHeader(),
        data: body as any,
        timeout: 15000,
        success: (res) => {
          const data = res.data;
          if (data == null) {
            reject(new Error("ASR 会话响应为空"));
            return;
          }
          const code = data["code"];
          if (code == SUCCESS_CODE) {
            const dataObj = data["data"] as UTSJSONObject | null;
            const sessionId = dataObj != null ? dataObj!["sessionId"] : null;
            if (sessionId != null && `${sessionId}`.length > 0) {
              resolve(`${sessionId}`);
            } else {
              reject(new Error("ASR 会话响应缺少 sessionId"));
            }
          } else {
            reject(new Error(`ASR 创建会话失败: ${code}`));
          }
        },
        fail: (err) => {
          const errMsg = err.errMsg != null ? err.errMsg! : "ASR 会话请求失败";
          reject(new Error(errMsg));
        },
      });
    });
  }

  /** 串行上传分片 */
  private async flushNextChunk(): Promise<void> {
    if (this.uploading) {
      return;
    }
    if (this.pendingFrames.length == 0) {
      return;
    }
    this.uploading = true;
    const expectedGeneration = this.generation;
    try {
      while (this.pendingFrames.length > 0 && this.active && expectedGeneration == this.generation) {
        const frame = this.pendingFrames.shift()!;
        const curSeq = this.seq;
        this.seq += 1;
        try {
          const result = await this.requestChunk(frame, curSeq, false);
          if (result.text.length > 0) {
            this.emitText(result.text, result.isFinal, expectedGeneration);
          }
        } catch (e: any) {
          console.warn("[StreamingAsr] chunk upload failed", e);
        }
      }
    } finally {
      if (expectedGeneration == this.generation) {
        this.uploading = false;
      }
    }
  }

  /** 上传单个音频分片，返回累计识别文本 */
  private async requestChunk(base64Audio: string, chunkSeq: number, isEnd: boolean): Promise<AsrChunkResult> {
    return new Promise<AsrChunkResult>((resolve, reject) => {
      const body = {} as UTSJSONObject;
      body["sessionId"] = this.sessionId;
      body["seq"] = chunkSeq;
      body["isEnd"] = isEnd;
      body["format"] = this.config.asrFormat;
      body["audio"] = base64Audio;
      uni.request<UTSJSONObject>({
        url: this.config.asrChunkUrl,
        method: "POST",
        header: this.buildHeader(),
        data: body as any,
        timeout: 15000,
        success: (res) => {
          const result = new AsrChunkResult();
          const data = res.data;
          if (data == null) {
            resolve(result);
            return;
          }
          const code = data["code"];
          if (code == SUCCESS_CODE) {
            const dataObj = data["data"] as UTSJSONObject | null;
            if (dataObj != null) {
              const text = dataObj!["text"];
              if (text != null) {
                result.text = `${text}`;
              }
              const isFinal = dataObj!["isFinal"];
              result.isFinal = isFinal != null && `${isFinal}` == "true";
            }
            resolve(result);
          } else {
            reject(new Error(`ASR 分片上传失败: ${code}`));
          }
        },
        fail: (err) => {
          const errMsg = err.errMsg != null ? err.errMsg! : "ASR 分片请求失败";
          reject(new Error(errMsg));
        },
      });
    });
  }

  /** 结束识别，返回最终文本 */
  private async requestFinish(): Promise<AsrChunkResult> {
    return new Promise<AsrChunkResult>((resolve, reject) => {
      const body = {} as UTSJSONObject;
      body["sessionId"] = this.sessionId;
      uni.request<UTSJSONObject>({
        url: this.config.asrFinishUrl,
        method: "POST",
        header: this.buildHeader(),
        data: body as any,
        timeout: 15000,
        success: (res) => {
          const result = new AsrChunkResult();
          const data = res.data;
          if (data == null) {
            resolve(result);
            return;
          }
          const code = data["code"];
          if (code == SUCCESS_CODE) {
            const dataObj = data["data"] as UTSJSONObject | null;
            if (dataObj != null) {
              const text = dataObj!["text"];
              if (text != null) {
                result.text = `${text}`;
              }
            }
            result.isFinal = true;
            resolve(result);
          } else {
            reject(new Error(`ASR 结束识别失败: ${code}`));
          }
        },
        fail: (err) => {
          const errMsg = err.errMsg != null ? err.errMsg! : "ASR 结束请求失败";
          reject(new Error(errMsg));
        },
      });
    });
  }
}

/** 全局流式识别单例（同时只允许一路录音识别） */
export const streamingAsrService = new StreamingAsrService();
