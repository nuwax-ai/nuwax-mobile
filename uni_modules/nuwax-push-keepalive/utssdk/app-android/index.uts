import Intent from 'android.content.Intent';

/**
 * nuwax-push-keepalive · app-android
 *
 * 推送保活锚点服务：进程被系统「划掉任务」杀掉后，由 AMS 因 START_STICKY 重新拉起
 * :pushservice 进程，并在进程里把个推的 UniPushService 重新 start，让长连接自己重连。
 *
 * 服务本体见 src/com/nuwax/pushkeepalive/PushKeepAliveService.kt
 * （UTS 里 extends Service 生成的父类声明不带构造调用，Release 编不过，所以用 Kotlin）。
 *
 * ★启用条件：只有「没有厂商推送通道」的设备（vendor == "none"）才调用本模块。
 *   判定见 utils/push/pushBackgroundStatus.uts 的 getPushBackgroundStatus()。
 *   厂商通道设备（华为/荣耀/小米/OPPO/vivo）不要启动，离线推送继续走厂商通道。
 */

const KEEPALIVE_SERVICE = "com.nuwax.pushkeepalive.PushKeepAliveService"

/**
 * 启动保活锚点（幂等：重复调用只是重新 startService）。
 * 建议在个推 SDK 初始化成功之后调用（bindImPushClient / getPushClientId 成功回调），
 * 不要在隐私弹窗同意之前调用。
 */
export function ensurePushKeepAlive(): void {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) return
  try {
    const intent = new Intent()
    intent.setClassName(activity, KEEPALIVE_SERVICE)
    activity.startService(intent)
  } catch (e) {
    console.warn(`[push-keepalive] start failed: ${e}`)
  }
}

/**
 * 停止保活锚点。
 * 正常业务不会用到（vendor 是设备属性，恒定不变），保留给联调与兜底场景。
 */
export function stopPushKeepAlive(): void {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) return
  try {
    const intent = new Intent()
    intent.setClassName(activity, KEEPALIVE_SERVICE)
    activity.stopService(intent)
  } catch (e) {
    console.warn(`[push-keepalive] stop failed: ${e}`)
  }
}
