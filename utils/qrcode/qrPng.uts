/**
 * QR 模块矩阵 → PNG data URL（纯函数、平台无关、零依赖）。
 *
 * 生成 1-bit 灰度 PNG（color type 0 / bit depth 1，白=1 黑=0），zlib 用 stored
 * block（无压缩，仅格式包裹）——QR 点阵不可压缩，stored 最简单且各端解码器均支持。
 * 全程 Array<number> 字节流，不碰 ArrayBuffer/Uint8Array（typed-array 跨端有坑）。
 *
 * 位运算跨端口径：CRC32/Adler32 值按 32 位补码参与运算（Android 端 Int 可能为负、
 * JS 端经 ToInt32 后位型一致），读取字节时一律 (v >> k) & 0xff 掩码，不依赖符号；
 * 禁用 >2^31 的位域字面量（-1 即 0xFFFFFFFF、CRC 多项式用补码十进制）。
 *
 * 留 PNG_BIT_DEPTH 常量：万一某端 image 组件不渲染 1-bit 灰度图，一键切 8-bit。
 *
 * 另有 qrLogoPngDataUrl：8-bit truecolor（color type 2）+ 中央 logo 像素合成，
 * 仅供「保存到相册」的含 logo 方图；屏幕显示层用 view 叠加 /static/logo.png，
 * 不做像素合成。
 */

import type { QrEncodeResult } from "./qrcodeEncoder";
import { QR_LOGO_PIXELS_B64, QR_LOGO_SIDE } from "./qrLogoPixels";

/** 1 或 8（灰度位深）。 */
const PNG_BIT_DEPTH = 1;

/** 32 位全 1（补码口径，等价 0xFFFFFFFF）。 */
const PNG_U32_MASK_ALL = -1;

/** CRC32 反射多项式 0xEDB88320 的 32 位补码表示（4294967296 - 3988292384）。 */
const PNG_CRC_POLY = -306674912;

const PNG_BASE64_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

/** CRC32 表（顶层惰性缓存，元素可能为负——按 32 位补码参与异或）。 */
let pngCrcTableCache: Array<number> | null = null;

function pngEnsureCrcTable(): Array<number> {
  if (pngCrcTableCache != null) {
    return pngCrcTableCache as Array<number>;
  }
  const table: Array<number> = [];
  for (let n = 0; n < 256; n++) {
    let c = n;
    for (let k = 0; k < 8; k++) {
      // 逻辑右移的无 >>> 写法；结果按 32 位补码参与后续异或（符号不参与语义）
      const shifted = (c >> 1) & 0x7fffffff;
      c = (c & 1) != 0 ? PNG_CRC_POLY ^ shifted : shifted;
    }
    table.push(c);
  }
  pngCrcTableCache = table;
  return table;
}

/** CRC32（对 bytes 的 [from, to) 区间）。 */
function pngCrc32(bytes: Array<number>, from: number, to: number): number {
  const table = pngEnsureCrcTable();
  let c = PNG_U32_MASK_ALL;
  for (let i = from; i < to; i++) {
    // (c >>> 8) 的补码安全写法：算术右移后掩掉符号扩展位
    c = table[(c ^ bytes[i]) & 0xff] ^ ((c >> 8) & 0xffffff);
  }
  return c ^ PNG_U32_MASK_ALL;
}

/** Adler-32（zlib 流尾校验；b<<16|a < 2^31，恒非负）。 */
function pngAdler32(bytes: Array<number>, from: number, to: number): number {
  let a = 1;
  let b = 0;
  for (let i = from; i < to; i++) {
    a = (a + bytes[i]) % 65521;
    b = (b + a) % 65521;
  }
  return (b << 16) | a;
}

/** 大端 4 字节（v 可能带符号——按补码取字节，& 0xff 后必非负）。 */
function pngPushU32BE(out: Array<number>, v: number): void {
  out.push((v >> 24) & 0xff);
  out.push((v >> 16) & 0xff);
  out.push((v >> 8) & 0xff);
  out.push(v & 0xff);
}

function pngPushU16LE(out: Array<number>, v: number): void {
  out.push(v & 0xff);
  out.push((v >> 8) & 0xff);
}

/** 追加 PNG 块：长度(BE) + 类型(ascii) + 数据 + CRC32(BE, 类型+数据)。 */
function pngAppendChunk(out: Array<number>, type: string, data: Array<number>): void {
  pngPushU32BE(out, data.length);
  const crcStart = out.length;
  for (let i = 0; i < 4; i++) {
    // UTS：charCodeAt 返回 Number?（i < 4 ≤ type.length 恒非空，as number 纯编译层安抚）
    out.push(type.charCodeAt(i) as number);
  }
  for (let i = 0; i < data.length; i++) {
    out.push(data[i]);
  }
  pngPushU32BE(out, pngCrc32(out, crcStart, out.length));
}

/** zlib 流（stored block：0x78 0x01 + ≤65535 字节分块 + adler32 大端）。 */
function pngAppendZlibStored(out: Array<number>, raw: Array<number>, from: number, to: number): void {
  out.push(0x78);
  out.push(0x01);
  let pos = from;
  while (pos < to) {
    const blockLen = Math.min(65535, to - pos);
    const isFinal = pos + blockLen >= to;
    out.push(isFinal ? 1 : 0); // BFINAL(bit0) + BTYPE=00(stored)
    pngPushU16LE(out, blockLen);
    pngPushU16LE(out, blockLen ^ 0xffff);
    for (let i = 0; i < blockLen; i++) {
      out.push(raw[pos + i]);
    }
    pos += blockLen;
  }
  pngPushU32BE(out, pngAdler32(raw, from, to));
}

/**
 * IDAT 块直写（免中间 idat 数组）：stored 流长度可预计算，zlib 字节直接进 out
 * 再补 CRC——与 pngAppendZlibStored(idat)+pngAppendChunk("IDAT", idat) 字节一致。
 * 保存图扫描线百万级字节，省掉整段拷贝（装箱 push 减半）。
 */
function pngAppendIdatStored(out: Array<number>, raw: Array<number>, from: number, to: number): void {
  let idatLen = 6; // zlib 头 2 + adler 尾 4
  let pos = from;
  while (pos < to) {
    const blockLen = Math.min(65535, to - pos);
    idatLen = idatLen + 5 + blockLen; // 每块：flag 1 + len 2 + ~len 2 + 数据
    pos += blockLen;
  }
  pngPushU32BE(out, idatLen);
  const crcStart = out.length;
  out.push(73); // I
  out.push(68); // D
  out.push(65); // A
  out.push(84); // T
  pngAppendZlibStored(out, raw, from, to);
  pngPushU32BE(out, pngCrc32(out, crcStart, out.length));
}

/** 手写 base64（查表 3→4 + padding；段数组 join，避免逐段 += 的 O(n²) 拼接）。 */
function pngBase64(bytes: Array<number>): string {
  const parts: Array<string> = [];
  const len = bytes.length;
  const full = Math.floor(len / 3) * 3;
  for (let i = 0; i < full; i += 3) {
    const n = bytes[i] << 16 | bytes[i + 1] << 8 | bytes[i + 2];
    parts.push(PNG_BASE64_ALPHABET.charAt((n >> 18) & 0x3f));
    parts.push(PNG_BASE64_ALPHABET.charAt((n >> 12) & 0x3f));
    parts.push(PNG_BASE64_ALPHABET.charAt((n >> 6) & 0x3f));
    parts.push(PNG_BASE64_ALPHABET.charAt(n & 0x3f));
  }
  const rest = len - full;
  if (rest == 1) {
    const n = bytes[full] << 16;
    parts.push(PNG_BASE64_ALPHABET.charAt((n >> 18) & 0x3f));
    parts.push(PNG_BASE64_ALPHABET.charAt((n >> 12) & 0x3f));
    parts.push("==");
  } else if (rest == 2) {
    const n = bytes[full] << 16 | bytes[full + 1] << 8;
    parts.push(PNG_BASE64_ALPHABET.charAt((n >> 18) & 0x3f));
    parts.push(PNG_BASE64_ALPHABET.charAt((n >> 12) & 0x3f));
    parts.push(PNG_BASE64_ALPHABET.charAt((n >> 6) & 0x3f));
    parts.push("=");
  }
  return parts.join("");
}

/** base64 → 字节数组（pngBase64 的逆运算，解码 logo 像素串；'=' 之后无数据）。 */
function pngBase64DecodeBytes(text: string): Array<number> {
  const sextets: Array<number> = [];
  for (let i = 0; i < text.length; i++) {
    const ch = text.charAt(i);
    if (ch == "=") {
      break;
    }
    const v = PNG_BASE64_ALPHABET.indexOf(ch);
    if (v >= 0) {
      sextets.push(v);
    }
  }
  const out: Array<number> = [];
  const full = Math.floor(sextets.length / 4) * 4;
  for (let i = 0; i < full; i += 4) {
    const s = sextets[i] << 18 | sextets[i + 1] << 12 | sextets[i + 2] << 6 | sextets[i + 3];
    out.push((s >> 16) & 0xff);
    out.push((s >> 8) & 0xff);
    out.push(s & 0xff);
  }
  const rest = sextets.length - full;
  if (rest == 2) {
    const s = sextets[full] << 18 | sextets[full + 1] << 12;
    out.push((s >> 16) & 0xff);
  } else if (rest == 3) {
    const s = sextets[full] << 18 | sextets[full + 1] << 12 | sextets[full + 2] << 6;
    out.push((s >> 16) & 0xff);
    out.push((s >> 8) & 0xff);
  }
  return out;
}

let qrLogoPixelsCache: Array<number> | null = null;

/** logo RGBA 像素（解码 QR_LOGO_PIXELS_B64；模块级缓存，一次性解码）。 */
export function getQrLogoPixels(): Array<number> {
  if (qrLogoPixelsCache != null) {
    return qrLogoPixelsCache as Array<number>;
  }
  const px = pngBase64DecodeBytes(QR_LOGO_PIXELS_B64);
  qrLogoPixelsCache = px;
  return px;
}

/**
 * QR 编码结果 → PNG data URL（含 border 模块静区，白底黑码）。
 * 返回 "data:image/png;base64,{...}"，可直接喂 <image> 与 uni.previewImage。
 */
export function qrPngDataUrl(result: QrEncodeResult, scale: number, border: number): string {
  const size = result.size;
  const safeScale = scale < 1 ? 1 : scale;
  const safeBorder = border < 0 ? 0 : border;
  const dim = (size + safeBorder * 2) * safeScale; // 输出图像宽高（方形）

  // 扫描线原始字节：每行 filter(0x00) + 位打包像素（1-bit：白=1；8-bit：白=255）
  const bytesPerLine = PNG_BIT_DEPTH == 1 ? Math.ceil(dim / 8) + 1 : dim + 1;
  const raw: Array<number> = [];
  for (let y = 0; y < dim; y++) {
    const my = Math.floor(y / safeScale) - safeBorder; // 模块坐标（含静区偏移）
    raw.push(0x00); // filter: None
    if (PNG_BIT_DEPTH == 1) {
      for (let bx = 0; bx < bytesPerLine - 1; bx++) {
        let b = 0;
        const x0 = bx * 8;
        for (let bit = 0; bit < 8; bit++) {
          const x = x0 + bit;
          const mx = Math.floor(x / safeScale) - safeBorder;
          const dark = mx >= 0 && mx < size && my >= 0 && my < size && result.modules[my * size + mx];
          b = b << 1 | (dark ? 0 : 1); // 1-bit 灰度：白=1 黑=0
        }
        raw.push(b);
      }
    } else {
      for (let x = 0; x < dim; x++) {
        const mx = Math.floor(x / safeScale) - safeBorder;
        const dark = mx >= 0 && mx < size && my >= 0 && my < size && result.modules[my * size + mx];
        raw.push(dark ? 0 : 255);
      }
    }
  }

  const png: Array<number> = [];
  // PNG 签名
  png.push(0x89);
  png.push(0x50);
  png.push(0x4e);
  png.push(0x47);
  png.push(0x0d);
  png.push(0x0a);
  png.push(0x1a);
  png.push(0x0a);
  // IHDR
  const ihdr: Array<number> = [];
  pngPushU32BE(ihdr, dim);
  pngPushU32BE(ihdr, dim);
  ihdr.push(PNG_BIT_DEPTH);
  ihdr.push(0); // color type: grayscale
  ihdr.push(0); // compression: deflate
  ihdr.push(0); // filter: adaptive
  ihdr.push(0); // interlace: none
  pngAppendChunk(png, "IHDR", ihdr);
  // IDAT（zlib stored 直写，省中间数组拷贝）
  pngAppendIdatStored(png, raw, 0, raw.length);
  // IEND
  pngAppendChunk(png, "IEND", []);

  return "data:image/png;base64," + pngBase64(png);
}

/**
 * QR 编码结果 → 含产品 logo 的 PNG data URL（「保存到相册」专用）。
 *
 * 与 qrPngDataUrl 的差异：IHDR 8-bit truecolor（color type 2，无 alpha——白垫保证
 * 中央不透明），扫描线每行 filter(0x00) + RGB 三通道；码区黑/白之外，中央按模块
 * 网格取整的边长铺白垫并最近邻采样 logo 像素（源：./qrLogoPixels，64×64 RGBA；
 * alpha<128 视为透明，保持垫白——圆角/透明边自然融入）。
 *
 * logo 覆盖 k = max(3, round(size*0.19)) 个模块（面积占比 ≈3.6%，远低于 ECL M
 * ~15% 纠错余量），且居中不碰三个 finder pattern，扫码率安全。
 * 性能/内存口径：页面保存用 scale=16/border=2 → dim=(size+4)×16（v4~v6 ≈592~720），
 * raw ≈ 1.0M~1.5M Number——调用方须惰性合成 + 缓存（点保存才生成，勿放渲染路径）；
 * 内部已做行模板复用 + IDAT 直写（真机实测 scale 20 全像素循环冻结 UI 数秒）。
 */
export function qrLogoPngDataUrl(result: QrEncodeResult, scale: number, border: number): string {
  const size = result.size;
  const safeScale = scale < 1 ? 1 : scale;
  const safeBorder = border < 0 ? 0 : border;
  const dim = (size + safeBorder * 2) * safeScale; // 输出图像宽高（方形）

  // 中央白垫+logo 几何（输出像素；总边长为奇数时中心区两侧差 1px，视觉可忽略）
  const k = Math.max(3, Math.round(size * 0.19)); // logo 覆盖的模块数
  const logoPx = k * safeScale;
  const padPx = Math.max(1, Math.floor(safeScale / 2)); // 白垫单边外扩
  const half = Math.floor((logoPx + padPx * 2) / 2);
  const cx = Math.floor(dim / 2);
  const cy = Math.floor(dim / 2);
  const padX0 = cx - half;
  const padX1 = cx + half;
  const padY0 = cy - half;
  const padY1 = cy + half;
  // logo 实际绘制范围（白垫内缩 padPx）
  const logoX0 = padX0 + padPx;
  const logoX1 = padX1 - padPx;
  const logoY0 = padY0 + padPx;
  const logoY1 = padY1 - padPx;
  const logoSpanX = logoX1 - logoX0 > 0 ? logoX1 - logoX0 : 1;
  const logoSpanY = logoY1 - logoY0 > 0 ? logoY1 - logoY0 : 1;

  // ★Android 端 16384 元素数组字面量的导入绑定退化成 Any?（.length 都找不到，
  //   error17/18 连环）→ 像素改 base64 串导出，这里运行时解码（模块级缓存一次性）
  const logoPixels = getQrLogoPixels();

  // 行模板（性能关键，真机实测同步合成冻结 UI 数秒）：同一模块行的码区行完全
  // 相同 → 每个唯一模块行只算一次 RGB 行模板，输出行取模板拷贝；白垫/logo 仅垫区
  // 行内叠加（sy 随 y 变不进模板）。纯计算从 dim² 降到 (size+2b)+垫区 行
  const rowCount = size + safeBorder * 2;
  const rowTplQR: Array<Array<number>> = [];
  for (let ri = 0; ri < rowCount; ri++) {
    const my = ri - safeBorder; // 模块坐标（含静区偏移）
    const row: Array<number> = [];
    for (let x = 0; x < dim; x++) {
      const mx = Math.floor(x / safeScale) - safeBorder;
      const dark = mx >= 0 && mx < size && my >= 0 && my < size && result.modules[my * size + mx];
      row.push(dark ? 0 : 255);
      row.push(dark ? 0 : 255);
      row.push(dark ? 0 : 255);
    }
    rowTplQR.push(row);
  }

  // 扫描线原始字节：每行 filter(0x00) + RGB 三通道
  const raw: Array<number> = [];
  for (let y = 0; y < dim; y++) {
    const tpl = rowTplQR[Math.floor(y / safeScale)];
    const inPadRow = y >= padY0 && y < padY1;
    raw.push(0x00); // filter: None
    if (!inPadRow) {
      // 码区行（绝大多数）：整行拷贝模板
      for (let c = 0; c < tpl.length; c++) {
        raw.push(tpl[c]);
      }
      continue;
    }
    // 垫区行：白垫覆盖二维码模块；logo 区最近邻采样（alpha<128 透明 → 保持垫白）。
    // 钳制不用 Math.min（返回装箱 Number 不能作下标）；下界无需钳——y/x ≥ 起点
    const inLogoRow = y >= logoY0 && y < logoY1;
    let sy = Math.floor(((y - logoY0) * QR_LOGO_SIDE) / logoSpanY);
    if (sy > QR_LOGO_SIDE - 1) {
      sy = QR_LOGO_SIDE - 1;
    }
    for (let x = 0; x < dim; x++) {
      // 显式 number：Kotlin 端字面量推断 Int，后面要接收 logo 像素（Double）赋值
      let r: number = 255;
      let g: number = 255;
      let b: number = 255;
      if (x < padX0 || x >= padX1) {
        // 垫外：回退码区模板
        r = tpl[x * 3];
        g = tpl[x * 3 + 1];
        b = tpl[x * 3 + 2];
      } else if (inLogoRow && x >= logoX0 && x < logoX1) {
        let sx = Math.floor(((x - logoX0) * QR_LOGO_SIDE) / logoSpanX);
        if (sx > QR_LOGO_SIDE - 1) {
          sx = QR_LOGO_SIDE - 1;
        }
        const pi = (sy * QR_LOGO_SIDE + sx) * 4;
        const pa = logoPixels[pi + 3];
        if (pa >= 128) {
          r = logoPixels[pi];
          g = logoPixels[pi + 1];
          b = logoPixels[pi + 2];
        }
      }
      raw.push(r);
      raw.push(g);
      raw.push(b);
    }
  }

  const png: Array<number> = [];
  // PNG 签名
  png.push(0x89);
  png.push(0x50);
  png.push(0x4e);
  png.push(0x47);
  png.push(0x0d);
  png.push(0x0a);
  png.push(0x1a);
  png.push(0x0a);
  // IHDR：8-bit truecolor
  const ihdr: Array<number> = [];
  pngPushU32BE(ihdr, dim);
  pngPushU32BE(ihdr, dim);
  ihdr.push(8); // bit depth
  ihdr.push(2); // color type: truecolor
  ihdr.push(0); // compression: deflate
  ihdr.push(0); // filter: adaptive
  ihdr.push(0); // interlace: none
  pngAppendChunk(png, "IHDR", ihdr);
  // IDAT（zlib stored 直写，省中间数组拷贝）
  pngAppendIdatStored(png, raw, 0, raw.length);
  // IEND
  pngAppendChunk(png, "IEND", []);

  return "data:image/png;base64," + pngBase64(png);
}
