<template>
  <radio-list-drawer
    :visible="visible"
    :title="t('Mobile.Chat.agentModeSelect')"
    :list="agentModeOptions"
    :current-value="currentAgentMode"
    :readonly="readonly"
    max-height="460rpx"
    @onClose="handleClose"
    @onChange="handleAgentModeChange"
  />
</template>

<script lang="uts" setup>
  import { RadioListItem } from "@/types/interfaces/radio";
  import RadioListDrawer from "@/components/radio-list-drawer/radio-list-drawer.uvue";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";

  type AgentMode = "ask" | "yolo";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      visible: boolean;
      currentAgentMode?: AgentMode;
      readonly?: boolean;
    }>(),
    {
      visible: false,
      currentAgentMode: "yolo",
      readonly: false,
    },
  );

  const emit = defineEmits<{
    onClose: () => void;
    onAgentModeChange: (mode: AgentMode) => void;
  }>();

  const agentModeOptions = computed((): RadioListItem[] => {
    return [
      new RadioListItem(
        t("Mobile.Chat.agentModeYoloLabel"),
        "yolo",
        t("Mobile.Chat.agentModeYoloDescription"),
      ),
      new RadioListItem(
        t("Mobile.Chat.agentModeAskLabel"),
        "ask",
        t("Mobile.Chat.agentModeAskDescription"),
      ),
    ];
  });

  const handleClose = () => {
    emit("onClose");
  };

  const handleAgentModeChange = (value: string) => {
    emit("onAgentModeChange", value as AgentMode);
  };
</script>

<style lang="scss" scoped>
</style>
