<template>
  <uni-modal-popup ref="popupRef" position="bottom" height="78%" :show-header="false" :body-scroll="false" @update-visible="handleVisibleChange">
    <view class="sheet" :class="avoidTabBar ? 'sheet--avoid-tab-bar' : ''">
      <view class="sheet-header">
        <view class="title-box">
          <text class="sheet-title">{{ t("Mobile.CreateHub.connector") }}</text>
          <text class="sheet-subtitle">{{ t("Mobile.ExpertList.capabilities") }}</text>
        </view>
        <view class="close-button" @click="close">
          <view class="close-line close-line--left" />
          <view class="close-line close-line--right" />
        </view>
      </view>

      <view class="tabs-row">
        <view class="tabs">
          <!-- 已连接页签（对齐 PC showConnectedTab：首拉完成且有已连接项才显示，防空闪/隐藏空态） -->
          <view
            v-if="showConnectedTab"
            class="tab"
            :class="source == 'connected' ? 'tab--active' : ''"
            @click="selectSource('connected')"
          >
            <text class="tab-text">{{ t("Mobile.ConnectorList.connectedTab") }}</text>
            <view v-if="source == 'connected'" class="tab-indicator" />
          </view>
          <view class="tab" :class="source == 'system' ? 'tab--active' : ''" @click="selectSource('system')">
            <text class="tab-text">{{ t("Mobile.ExpertList.system") }}</text>
            <view v-if="source == 'system'" class="tab-indicator" />
          </view>
          <view class="tab" :class="source == 'team' ? 'tab--active' : ''" @click="selectSource('team')">
            <text class="tab-text">{{ t("Mobile.ExpertList.team") }}</text>
            <view v-if="source == 'team'" class="tab-indicator" />
          </view>
        </view>
        <view class="search-toggle" @click="toggleSearch">
          <svg-icon name="icon-Search" size="38" color="#686878" />
        </view>
      </view>

      <view v-if="searchVisible" class="search-bar">
        <svg-icon name="icon-Search" size="32" color="#9999a3" />
        <input v-model="keyword" class="search-input" :placeholder="t('Mobile.ConnectorList.searchPlaceholder')" confirm-type="search" />
        <svg-icon v-if="keyword.length > 0" name="icon-X" size="28" color="#9999a3" @click="keyword = ''" />
      </view>

      <view class="sheet-list" :class="{ 'sheet-list--enter-next': swipeEnterDirection > 0, 'sheet-list--enter-prev': swipeEnterDirection < 0 }" @touchstart="handleSwipeStart" @touchend="handleSwipeEnd">
        <view v-if="visitedConnected" v-show="source == 'connected'" class="sheet-list-pane">
          <connector-list-view ref="connectedListRef" class="sheet-list-inner" type="connected" variant="default" :keyword="keyword" :page-size="20" @connected-change="handleConnectedChange" />
        </view>
        <view v-if="visitedSystem" v-show="source == 'system'" class="sheet-list-pane">
          <connector-list-view ref="systemListRef" class="sheet-list-inner" type="system" variant="default" :keyword="keyword" :page-size="20" @connected-change="handleConnectedChange" />
        </view>
        <view v-if="visitedTeam" v-show="source == 'team'" class="sheet-list-pane">
          <connector-list-view ref="teamListRef" class="sheet-list-inner" type="team" variant="default" :keyword="keyword" :page-size="20" @connected-change="handleConnectedChange" />
        </view>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, watch, computed, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import SvgIcon from "@/components/svg-icon/svg-icon.uvue";
  import ConnectorListView from "@/components/connector-list-view/connector-list-view.uvue";
  import { type ConnectorListSourceType } from "@/types/interfaces/connector";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { apiConnectorProviderList } from "@/servers/connector";
  import { apiResCode, apiResData } from "@/utils/apiResponse.uts";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { HorizontalTabSwipeTracker } from "@/utils/horizontalTabSwipe";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const props = withDefaults(defineProps<{ visible: boolean; avoidTabBar?: boolean; initialTab?: string }>(), {
    visible: false,
    avoidTabBar: false,
    initialTab: "system",
  });
  const emit = defineEmits<{ (e: "close"): void; }>();
  const popupRef = ref<any | null>(null);
  const connectedListRef = ref<any | null>(null);
  const systemListRef = ref<any | null>(null);
  const teamListRef = ref<any | null>(null);
  const source = ref<ConnectorListSourceType>("system");
  const visitedConnected = ref<boolean>(false);
  const visitedSystem = ref<boolean>(true);
  const visitedTeam = ref<boolean>(false);
  const searchVisible = ref<boolean>(false);
  const keyword = ref<string>("");
  const swipeTracker = new HorizontalTabSwipeTracker();
  const swipeEnterDirection = ref<number>(0);

  function playSwipeEnter(direction: number): void {
    swipeEnterDirection.value = direction;
    setTimeout((): void => { swipeEnterDirection.value = 0; }, 20);
  }

  function selectSource(nextSource: ConnectorListSourceType): void {
    if (nextSource == "connected") visitedConnected.value = true;
    else if (nextSource == "team") visitedTeam.value = true;
    else visitedSystem.value = true;
    source.value = nextSource;
  }

  // ── 「已连接」页签可见性（对齐 PC useConnectedConnectors/showConnectedTab）──
  const connectedCount = ref<number>(0);
  // 首拉完成标记：空列表区分「未加载」（不判定可见性，防空闪）与「确无连接」（隐藏页签）
  const connectedLoaded = ref<boolean>(false);
  let connectedOverviewSeq = 0;

  const showConnectedTab = computed((): boolean => connectedLoaded.value && connectedCount.value > 0);

  function handleSwipeStart(event: UniTouchEvent): void { swipeTracker.begin(event); }
  function handleSwipeEnd(event: UniTouchEvent): void {
    const direction = swipeTracker.finish(event);
    if (direction == 0) return;
    const ordered = showConnectedTab.value
      ? ["connected", "system", "team"]
      : ["system", "team"];
    const currentIndex = ordered.indexOf(source.value);
    const nextIndex = currentIndex + direction;
    if (currentIndex >= 0 && nextIndex >= 0 && nextIndex < ordered.length) {
      playSwipeEnter(direction);
      selectSource(ordered[nextIndex] as ConnectorListSourceType);
    }
  }

  /** 拉取已连接计数（connected=true 全量；响应兼容裸数组与 records 分页双壳） */
  async function refreshConnectedOverview(): Promise<void> {
    const seq = connectedOverviewSeq + 1;
    connectedOverviewSeq = seq;
    try {
      const res = await apiConnectorProviderList(0, 0, "", "true", "", "", 0);
      if (seq != connectedOverviewSeq) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        connectedLoaded.value = true;
        return;
      }
      const raw = apiResData<any>(res);
      let count = 0;
      if (raw != null && Array.isArray(raw)) {
        count = (raw as UTSJSONObject[]).length;
      } else if (raw != null) {
        const recRaw = (raw as UTSJSONObject)["records"];
        if (recRaw != null && Array.isArray(recRaw)) count = (recRaw as UTSJSONObject[]).length;
      }
      connectedCount.value = count;
      connectedLoaded.value = true;
      // 断开最后一项：已连接页签消失，凭空自动回落系统广场（对齐 PC）
      if (source.value == "connected" && count == 0) {
        selectSource("system");
      }
    } catch (_error) {
      connectedLoaded.value = true;
    }
  }

  function callMethod(inst: any | null, method: string): void {
    if (inst != null) (inst as ComponentPublicInstance).$callMethod(method);
  }

  /** 连接/断开成功（对齐 PC：经 connected-change 重拉，同步页签可见性与回落） */
  function handleConnectedChange(_item: UTSJSONObject, _connected: boolean): void {
    if (visitedConnected.value) callMethod(connectedListRef.value, "refresh");
    refreshConnectedOverview();
  }

  function close(): void { callMethod(popupRef.value, "close"); }

  function handleVisibleChange(value: boolean): void {
    if (!value) emit("close");
  }

  function toggleSearch(): void {
    searchVisible.value = !searchVisible.value;
    if (!searchVisible.value) keyword.value = "";
  }

  watch(
    (): boolean => props.visible,
    (value: boolean): void => {
      if (value) {
        // 对齐 PC：普通入口默认系统广场；头像组入口 initialTab='connected' 落「已连接」
        // 聚合页签（若确无已连接数据，refreshConnectedOverview 的回落逻辑会切回系统广场）
        selectSource(props.initialTab == "connected" ? "connected" : "system");
        keyword.value = "";
        searchVisible.value = false;
        callMethod(popupRef.value, "open");
        if (source.value == "connected") callMethod(connectedListRef.value, "refresh");
        else if (source.value == "team") callMethod(teamListRef.value, "refresh");
        else callMethod(systemListRef.value, "refresh");
        refreshConnectedOverview();
      } else {
        callMethod(popupRef.value, "close");
      }
    },
  );
</script>

<style scoped lang="scss">
  .sheet { display: flex; flex-direction: column; height: 100%; padding: 30rpx 32rpx 0; background-color: #ffffff; box-sizing: border-box; }
  /* #ifdef APP-ANDROID || APP-HARMONY */
  .sheet--avoid-tab-bar { padding-bottom: 100rpx; }
  /* #endif */
  /* #ifdef APP-IOS */
  /* iOS 窗口高度不含 tabBar（2026-09-19 真机实测），弹层无需避让，多留只会出现底部空白 */
  .sheet--avoid-tab-bar { padding-bottom: env(safe-area-inset-bottom); }
  /* #endif */
  /* #ifdef H5 */
  .sheet--avoid-tab-bar { padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
  /* #endif */
  .sheet-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 4rpx; }
  .title-box { display: flex; flex-direction: column; }
  .sheet-title { color: #17171d; font-size: 36rpx; font-weight: 700; line-height: 48rpx; }
  .sheet-subtitle { margin-top: 4rpx; color: #94949e; font-size: 25rpx; line-height: 34rpx; letter-spacing: 1rpx; }
  .close-button { position: relative; width: 58rpx; height: 58rpx; }
  .close-line { position: absolute; left: 13rpx; top: 28rpx; width: 34rpx; height: 4rpx; border-radius: 999rpx; background-color: #8b8b96; }
  .close-line--left { transform: rotate(45deg); }
  .close-line--right { transform: rotate(-45deg); }
  .tabs-row { display: flex; flex-direction: row; align-items: flex-end; height: 92rpx; margin-top: 12rpx; border-bottom: 2rpx solid #f1f1f4; }
  .tabs { flex: 1; display: flex; flex-direction: row; align-items: flex-end; height: 92rpx; min-width: 0; }
  .tab { position: relative; display: flex; align-items: center; justify-content: center; height: 92rpx; margin-right: 38rpx; }
  .tab-text { color: #92929c; font-size: 29rpx; font-weight: 600; white-space: nowrap; }
  .tab--active .tab-text { color: #202027; }
  .tab-indicator { position: absolute; left: 0; right: 0; bottom: -2rpx; height: 6rpx; border-radius: 999rpx; background-color: #5b46ff; }
  .search-toggle { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 92rpx; }
  .search-bar { flex-shrink: 0; display: flex; flex-direction: row; align-items: center; height: 70rpx; margin: 18rpx 0 6rpx; padding: 0 20rpx; border-radius: 18rpx; background-color: #f5f5f8; box-sizing: border-box; }
  .search-input { flex: 1; height: 70rpx; margin: 0 14rpx; color: #25252d; font-size: 27rpx; }
  .sheet-list { flex: 1; min-height: 0; display: flex; flex-direction: column; transition: transform 0.2s ease-out, opacity 0.2s ease-out; }
  .sheet-list--enter-next { transform: translateX(40rpx); opacity: 0.35; transition: none; }
  .sheet-list--enter-prev { transform: translateX(-40rpx); opacity: 0.35; transition: none; }
  .sheet-list-pane { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .sheet-list-inner { flex: 1; min-height: 0; }
</style>
