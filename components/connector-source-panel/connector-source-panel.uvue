<template>
  <view class="panel">
    <view class="tabs-row">
      <view class="tabs">
        <!-- 已连接页签（对齐 PC showConnectedTab：首拉完成且有已连接项才显示，防空闪/隐藏空态） -->
        <view
          v-if="showConnectedTab"
          class="tab"
          :class="source == 'connected' ? 'tab--active' : ''"
          @click="selectSource('connected')"
        >
          <text class="tab-text" :class="source == 'connected' ? 'tab-text--active' : ''">{{ t("Mobile.ConnectorList.connectedTab") }}</text>
          <view v-if="source == 'connected'" class="tab-indicator" />
        </view>
        <view class="tab" :class="source == 'system' ? 'tab--active' : ''" @click="selectSource('system')">
          <text class="tab-text" :class="source == 'system' ? 'tab-text--active' : ''">{{ t("Mobile.ExpertList.system") }}</text>
          <view v-if="source == 'system'" class="tab-indicator" />
        </view>
        <view class="tab" :class="source == 'team' ? 'tab--active' : ''" @click="selectSource('team')">
          <text class="tab-text" :class="source == 'team' ? 'tab-text--active' : ''">{{ t("Mobile.ExpertList.team") }}</text>
          <view v-if="source == 'team'" class="tab-indicator" />
        </view>
      </view>
      <view class="search-toggle" @click="toggleSearch">
        <svg-icon name="icon-Search" size="19" color="#686878" unit="px" />
      </view>
    </view>

    <view v-if="searchVisible" class="search-bar">
      <svg-icon name="icon-Search" size="16" color="#9999a3" unit="px" />
      <input v-model="keyword" class="search-input" :placeholder="t('Mobile.ConnectorList.searchPlaceholder')" confirm-type="search" />
      <svg-icon v-if="keyword.length > 0" name="icon-X" size="14" color="#9999a3" unit="px" @click="keyword = ''" />
    </view>

    <directional-pager class="sheet-list" :current="activePagerIndex" :count="sourceOrder.length" :enabled="pagerEnabled" @preview="preparePagerIndex" @change="applyPagerIndex">
      <swiper-item v-if="showConnectedTab">
        <view v-if="visitedConnected" class="sheet-list-pane">
          <connector-list-view ref="connectedListRef" class="sheet-list-inner" type="connected" variant="default" :keyword="keyword" :page-size="20" @connected-change="handleConnectedChange" />
        </view>
      </swiper-item>
      <swiper-item>
        <view v-if="visitedSystem" class="sheet-list-pane">
          <connector-list-view ref="systemListRef" class="sheet-list-inner" type="system" variant="default" :keyword="keyword" :page-size="20" @connected-change="handleConnectedChange" />
        </view>
      </swiper-item>
      <swiper-item>
        <view v-if="visitedTeam" class="sheet-list-pane">
          <connector-list-view ref="teamListRef" class="sheet-list-inner" type="team" variant="default" :keyword="keyword" :page-size="20" @connected-change="handleConnectedChange" />
        </view>
      </swiper-item>
    </directional-pager>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, watch, type ComponentPublicInstance } from "vue";
  import { onShow } from "@dcloudio/uni-app";
  import DirectionalPager from "@/components/directional-pager/directional-pager.uvue";
  import ConnectorListView from "@/components/connector-list-view/connector-list-view.uvue";
  import { type ConnectorListSourceType } from "@/types/interfaces/connector";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiConnectorProviderList } from "@/servers/connector";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { SUCCESS_CODE } from "@/constants/codes.constants";

  /**
   * 连接器页签区：已连接 / 系统广场 / 团队空间、搜索、左右滑动。
   * 会话弹层与发现页连接器页共用。弹层外壳不在这里。
   */
  const props = withDefaults(defineProps<{
    /** 弹层未打开时关掉滑动，避免在隐藏态响应手势 */
    pagerEnabled?: boolean;
    /** 页面 onShow 时重拉已连接计数。弹层自己在打开时激活，不跟页面 onShow */
    refreshOnShow?: boolean;
    /** 每次打开弹层递增，用来重置搜索并落到 initialTab */
    openToken?: number;
    initialTab?: string;
  }>(), {
    pagerEnabled: true,
    refreshOnShow: true,
    openToken: 0,
    initialTab: "system",
  });

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const connectedListRef = ref<any | null>(null);
  const systemListRef = ref<any | null>(null);
  const teamListRef = ref<any | null>(null);
  const source = ref<ConnectorListSourceType>("system");
  const visitedConnected = ref<boolean>(false);
  const visitedSystem = ref<boolean>(true);
  const visitedTeam = ref<boolean>(false);
  const searchVisible = ref<boolean>(false);
  const keyword = ref<string>("");

  function selectSource(nextSource: ConnectorListSourceType): void {
    if (nextSource == "connected") visitedConnected.value = true;
    else if (nextSource == "team") visitedTeam.value = true;
    else visitedSystem.value = true;
    source.value = nextSource;
  }

  // ── 「已连接」页签可见性（对齐 PC useConnectedConnectors/showConnectedTab）──
  const connectedCount = ref<number>(0);
  // 首拉完成标记：空列表区分「未加载」（不判定可见性，防空闪）与「确无连接」（隐藏页签）
  const connectedLoaded = ref<boolean>(false);
  let connectedOverviewSeq = 0;
  const showConnectedTab = computed((): boolean => connectedLoaded.value && connectedCount.value > 0);
  const sourceOrder = computed((): string[] => showConnectedTab.value ? ["connected", "system", "team"] : ["system", "team"]);
  const activePagerIndex = computed((): number => Math.max(0, sourceOrder.value.indexOf(source.value)));

  function preparePagerIndex(index: number): void {
    if (index < 0 || index >= sourceOrder.value.length) return;
    const next = sourceOrder.value[index];
    if (next == "connected") visitedConnected.value = true;
    else if (next == "team") visitedTeam.value = true;
    else visitedSystem.value = true;
  }

  function applyPagerIndex(index: number): void {
    if (index >= 0 && index < sourceOrder.value.length) selectSource(sourceOrder.value[index] as ConnectorListSourceType);
  }

  /** 拉取已连接计数（connected=true 全量；响应兼容裸数组与 records 分页双壳） */
  async function refreshConnectedOverview(): Promise<void> {
    const seq = connectedOverviewSeq + 1;
    connectedOverviewSeq = seq;
    try {
      const res = await apiConnectorProviderList(0, 0, "", "true", "", "", 0);
      if (seq != connectedOverviewSeq) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        connectedLoaded.value = true;
        return;
      }
      const raw = apiResData<any>(res);
      let count = 0;
      if (raw != null && Array.isArray(raw)) {
        count = (raw as UTSJSONObject[]).length;
      } else if (raw != null) {
        const recRaw = (raw as UTSJSONObject)["records"];
        if (recRaw != null && Array.isArray(recRaw)) count = (recRaw as UTSJSONObject[]).length;
      }
      connectedCount.value = count;
      connectedLoaded.value = true;
      // 断开最后一项：已连接页签消失，凭空自动回落系统广场（对齐 PC）
      if (source.value == "connected" && count == 0) selectSource("system");
    } catch (_error) {
      connectedLoaded.value = true;
    }
  }

  function callMethod(inst: any | null, method: string): void {
    if (inst != null) (inst as ComponentPublicInstance).$callMethod(method);
  }

  function refreshCurrentList(): void {
    if (source.value == "connected") callMethod(connectedListRef.value, "refreshSilent");
    else if (source.value == "team") callMethod(teamListRef.value, "refreshSilent");
    else callMethod(systemListRef.value, "refreshSilent");
  }

  /** 连接/断开成功（对齐 PC：经 connected-change 重拉，同步页签可见性与回落） */
  function handleConnectedChange(_item: UTSJSONObject, _connected: boolean): void {
    if (visitedConnected.value) callMethod(connectedListRef.value, "refreshSilent");
    refreshConnectedOverview();
  }

  function toggleSearch(): void {
    searchVisible.value = !searchVisible.value;
    if (!searchVisible.value) keyword.value = "";
  }

  /** 弹层打开：清空搜索，落到指定页签；页签没变时补一次静默刷新 */
  function activate(tab: string): void {
    // 对齐 PC：普通入口默认系统广场；头像组入口 initialTab='connected' 落「已连接」
    // 聚合页签（若确无已连接数据，refreshConnectedOverview 的回落逻辑会切回系统广场）
    const previousSource = source.value;
    selectSource(tab == "connected" ? "connected" : "system");
    keyword.value = "";
    searchVisible.value = false;
    if (source.value == previousSource) refreshCurrentList();
    refreshConnectedOverview();
  }

  watch(
    (): number => props.openToken,
    (token: number): void => {
      if (token > 0) activate(props.initialTab);
    },
  );

  onShow(() => {
    if (props.refreshOnShow) refreshConnectedOverview();
  });
</script>

<style scoped>
  .panel {
    flex: 1;
    height: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
  }

  .tabs-row {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    height: 46px;
    padding: 0 16px;
    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: #f1f1f4;
  }

  .tabs {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    height: 46px;
    min-width: 0;
  }

  .tab {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    margin-right: 19px;
  }

  .tab-text {
    color: #92929c;
    font-size: 14.5px;
    font-weight: 600;
  }

  .tab-text--active {
    color: #202027;
  }

  .tab-indicator {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    border-radius: 999px;
    background-color: #5b46ff;
  }

  .search-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 46px;
  }

  .search-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 35px;
    margin: 9px 16px 3px;
    padding: 0 10px;
    border-radius: 9px;
    background-color: #f5f5f8;
  }

  .search-input {
    flex: 1;
    height: 35px;
    margin: 0 7px;
    color: #25252d;
    font-size: 13.5px;
  }

  .sheet-list {
    flex: 1;
    height: 0;
    min-height: 0;
    width: 100%;
  }

  .sheet-list-pane {
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .sheet-list-inner {
    flex: 1;
    min-height: 0;
  }
</style>
