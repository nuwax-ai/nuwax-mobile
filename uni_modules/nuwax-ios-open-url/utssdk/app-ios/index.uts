import { UIApplication } from "UIKit"
import { URL } from "Foundation"

/**
 * 系统打开外部链接。成功返回 true。
 * 不返回 Promise：UTS 把 Promise<void> 编成 UTSPromise<Void>，
 * Promise.resolve()/reject() 却是 UTSPromise<Any>，iOS 云打包过不了。
 * 只传地址：三参数 open 的完成回调在这里会一直得到 false，系统其实没有跳转。
 */
export function openIosExternalUrl(url: string): boolean {
  const uri = new URL(string = url)
  if (uri == null) {
    return false
  }
  UIApplication.shared.open(uri!)
  return true
}
