<template>
  <view class="vh-page">
    <safety-zone />
    <view class="vh-nav">
      <view class="vh-nav__side" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="22" unit="px" color="#1a1a1a" />
      </view>
      <text class="vh-nav__title">历史记录</text>
      <view class="vh-nav__side"></view>
    </view>
    <scroll-view
      class="vh-list"
      scroll-y="true"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      @refresherrefresh="handleRefresh"
      @scrolltolower="loadMore"
    >
      <view v-for="item in records" :key="item.id" class="vh-card">
        <view class="vh-card__head">
          <text class="vh-card__title">{{ item.title }}</text>
        </view>
        <text class="vh-card__meta">时长 {{ item.duration }} · {{ item.recordedAt }}</text>
        <view class="vh-card__file">
          <svg-icon name="icon-a-Filetext" size="16" unit="px" color="#7a78e6" />
          <text class="vh-card__path">{{ item.detail }}</text>
        </view>
        <view class="vh-card__actions">
          <view v-if="item.status == 'SUCCESS'" class="vh-card__btn" @click="handlePlay(item)">
            <view v-if="playingId == item.id" class="vh-card__stop"></view>
            <svg-icon v-else name="icon-video-play" size="16" unit="px" color="#5b4dff" />
            <text class="vh-card__btn-text">{{ playingId == item.id ? '停止' : '播放' }}</text>
          </view>
          <view v-if="item.status == 'SUCCESS'" class="vh-card__btn" @click="handleDownload(item)">
            <svg-icon name="icon-msg-download" size="16" unit="px" color="#5b4dff" />
            <text class="vh-card__btn-text">文档</text>
          </view>
          <view v-if="item.status == 'ASR_PARTIAL_FAILED' || item.status == 'DOC_FAILED'" class="vh-card__btn" @click="handleReprocess(item)">
            <svg-icon name="icon-restart" size="16" unit="px" color="#5b4dff" />
            <text class="vh-card__btn-text">重试</text>
          </view>
          <view v-if="item.status == 'DOC_REMOVED'" class="vh-card__btn" @click="handleReprocess(item)">
            <svg-icon name="icon-restart" size="16" unit="px" color="#5b4dff" />
            <text class="vh-card__btn-text">重建文档</text>
          </view>
          <view class="vh-card__btn" @click="handleDelete(item)">
            <text class="vh-card__btn-text vh-card__btn-text--danger">删除</text>
          </view>
        </view>
      </view>
      <view v-if="records.length > 0" class="vh-footer">
        <text class="vh-footer__text">{{ footerText }}</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
/**
 * 录音历史。列表来自 POST /api/voice/note/list。
 * 转写成功后点下载，再查详情拿到 docUrl 打开文稿。
 */
import { apiVoiceNoteAudioFiles, apiVoiceNoteDelete, apiVoiceNoteDetail, apiVoiceNoteList, apiVoiceNoteReprocess } from "@/servers/voiceNote.uts";

type VoiceRecordHistoryItem = {
  id: string;
  title: string;
  duration: string;
  recordedAt: string;
  detail: string;
  status: string;
  segmentCount: number;
  docUrl: string;
};

const records = ref<VoiceRecordHistoryItem[]>([]);
const loading = ref<boolean>(false);
const refreshing = ref<boolean>(false);
const hasMore = ref<boolean>(true);
const lastId = ref<string>("");
const playingId = ref<string>("");
const pageSize = 20;
const footerText = computed((): string => {
  if (loading.value) return "加载中";
  if (!hasMore.value) return "没有更多了";
  return "上拉加载更多";
});

let player: InnerAudioContext | null = null;
let playToken = 0;
let playUrls: string[] = [];
let playIndex = 0;

function pad2(n: number): string {
  if (n < 10) return "0" + n.toString();
  return n.toString();
}

function formatDuration(ms: number): string {
  const safe = ms < 0 ? 0 : ms;
  const totalSec = Math.floor(safe / 1000);
  const sec = totalSec % 60;
  const min = Math.floor(totalSec / 60);
  return pad2(min) + ":" + pad2(sec);
}

function formatClock(ts: number): string {
  if (ts <= 0) return "";
  const d = new Date(ts);
  return (
    d.getFullYear() +
    "-" +
    pad2(d.getMonth() + 1) +
    "-" +
    pad2(d.getDate()) +
    " " +
    pad2(d.getHours()) +
    ":" +
    pad2(d.getMinutes())
  );
}

function readItemString(obj: UTSJSONObject, key: string): string {
  const raw = obj[key];
  if (raw == null) return "";
  return `${raw}`;
}

function readItemNumber(obj: UTSJSONObject, key: string): number {
  const raw = obj[key];
  if (raw == null) return 0;
  const value = parseFloat(`${raw}`);
  if (isNaN(value)) return 0;
  return value;
}

function statusLabel(status: string): string {
  if (status == "UPLOADING") return "传输中";
  if (status == "PROCESSING") return "转写中";
  if (status == "ASR_PARTIAL_FAILED") return "部分转写失败";
  if (status == "DOC_FAILED") return "文档生成失败";
  if (status == "SUCCESS") return "已完成";
  if (status == "DOC_REMOVED") return "文档已删除";
  return status;
}

function formatCreated(raw: string): string {
  if (raw.length == 0) return "";
  const value = parseFloat(raw);
  const digitsOnly = !isNaN(value) && `${Math.floor(value)}` == raw;
  if (digitsOnly && value > 1000000000000) return formatClock(value);
  if (digitsOnly && value > 1000000000) return formatClock(value * 1000);
  const text = raw.replace("T", " ");
  if (text.length > 16) return text.substring(0, 16);
  return text;
}

function mapHistoryItem(row: UTSJSONObject): VoiceRecordHistoryItem {
  const noteId = readItemString(row, "noteId");
  const titleRaw = readItemString(row, "title");
  const status = readItemString(row, "status");
  const segmentCount = readItemNumber(row, "segmentCount");
  const created = formatCreated(readItemString(row, "created"));
  const title = titleRaw.length > 0 ? titleRaw : "语音笔记";
  const item: VoiceRecordHistoryItem = {
    id: noteId,
    title: title,
    duration: formatDuration(readItemNumber(row, "totalDurationMs")),
    recordedAt: created,
    detail: statusLabel(status) + " · " + segmentCount.toString() + " 段",
    status: status,
    segmentCount: segmentCount,
    docUrl: "",
  };
  return item;
}

function applyStatus(item: VoiceRecordHistoryItem, status: string): void {
  item.status = status;
  item.detail = statusLabel(status) + " · " + item.segmentCount.toString() + " 段";
}

async function loadRecords(reset: boolean): Promise<void> {
  if (loading.value) {
    refreshing.value = false;
    return;
  }
  if (!reset && !hasMore.value) return;
  loading.value = true;
  const cursor = reset ? "" : lastId.value;
  try {
    const rows = await apiVoiceNoteList(cursor, pageSize);
    const next: VoiceRecordHistoryItem[] = [];
    for (let i = 0; i < rows.length; i++) {
      const item = mapHistoryItem(rows[i]);
      if (item.id.length > 0) next.push(item);
    }
    if (reset) {
      records.value = next;
    } else {
      const merged: VoiceRecordHistoryItem[] = [];
      for (let i = 0; i < records.value.length; i++) {
        merged.push(records.value[i]);
      }
      for (let i = 0; i < next.length; i++) {
        merged.push(next[i]);
      }
      records.value = merged;
    }
    if (next.length > 0) lastId.value = next[next.length - 1].id;
    hasMore.value = rows.length >= pageSize;
  } catch (_error) {
    uni.showToast({ title: "历史记录加载失败", icon: "none" });
  } finally {
    loading.value = false;
    refreshing.value = false;
  }
}

function loadMore(): void {
  void loadRecords(false);
}

function handleRefresh(): void {
  refreshing.value = true;
  void loadRecords(true);
}

function handleBack(): void {
  uni.navigateBack({ delta: 1 });
}

function openDoc(item: VoiceRecordHistoryItem, docUrl: string): void {
  uni.navigateTo({
    url: "/subpackages/pages/webview/webview?url=" + encodeURIComponent(docUrl) + "&title=" + encodeURIComponent(item.title),
  });
}

async function handleDownload(item: VoiceRecordHistoryItem): Promise<void> {
  if (item.status != "SUCCESS") {
    uni.showToast({ title: "文档还未生成", icon: "none" });
    return;
  }
  if (item.docUrl.length > 0) {
    openDoc(item, item.docUrl);
    return;
  }
  try {
    const detail = await apiVoiceNoteDetail(item.id);
    const docUrl = detail != null && detail["docUrl"] != null ? `${detail["docUrl"]}` : "";
    if (docUrl.length == 0) {
      uni.showToast({ title: "文档还未生成", icon: "none" });
      return;
    }
    item.docUrl = docUrl;
    openDoc(item, docUrl);
  } catch (_error) {
    uni.showToast({ title: "文档还未生成", icon: "none" });
  }
}

function stopPlayback(): void {
  playToken = playToken + 1;
  playingId.value = "";
  playUrls = [];
  playIndex = 0;
  const current = player;
  player = null;
  if (current != null) {
    current.stop();
    current.destroy();
  }
}

function playClipAt(noteId: string, index: number, token: number): void {
  if (token != playToken || index < 0 || index >= playUrls.length) {
    stopPlayback();
    return;
  }
  const previous = player;
  player = null;
  if (previous != null) {
    previous.stop();
    previous.destroy();
  }
  const audio = uni.createInnerAudioContext();
  player = audio;
  playIndex = index;
  audio.src = playUrls[index];
  audio.onEnded(() => {
    if (token != playToken) return;
    playClipAt(noteId, index + 1, token);
  });
  audio.onError((_err) => {
    if (token != playToken) return;
    stopPlayback();
    uni.showToast({ title: "播放失败", icon: "none" });
  });
  audio.play();
}

async function loadAudioUrls(noteId: string): Promise<string[]> {
  const urls: string[] = [];
  let page = 1;
  let total = 0;
  while (page < 20) {
    const data = await apiVoiceNoteAudioFiles(noteId, page, 50);
    if (data == null) break;
    total = readItemNumber(data, "total");
    const raw = data["items"];
    if (raw == null || !Array.isArray(raw)) break;
    const items = raw as UTSJSONObject[];
    for (let i = 0; i < items.length; i++) {
      const url = readItemString(items[i], "audioUrl");
      if (url.length > 0) urls.push(url);
    }
    if (items.length < 50 || (total > 0 && urls.length >= total)) break;
    page = page + 1;
  }
  return urls;
}

async function handlePlay(item: VoiceRecordHistoryItem): Promise<void> {
  if (playingId.value == item.id) {
    stopPlayback();
    return;
  }
  stopPlayback();
  try {
    const urls = await loadAudioUrls(item.id);
    if (urls.length == 0) {
      uni.showToast({ title: "没有可播放的录音", icon: "none" });
      return;
    }
    playUrls = urls;
    playingId.value = item.id;
    const token = playToken + 1;
    playToken = token;
    playClipAt(item.id, 0, token);
  } catch (_error) {
    stopPlayback();
    uni.showToast({ title: "播放失败", icon: "none" });
  }
}

async function handleReprocess(item: VoiceRecordHistoryItem): Promise<void> {
  try {
    const status = await apiVoiceNoteReprocess(item.id);
    applyStatus(item, status);
    uni.showToast({ title: "已开始重试", icon: "none" });
  } catch (error) {
    const message = `${error}`;
    uni.showToast({ title: message.length > 0 ? message : "重试失败", icon: "none" });
  }
}

function removeRecord(noteId: string): void {
  const next: VoiceRecordHistoryItem[] = [];
  for (let i = 0; i < records.value.length; i++) {
    if (records.value[i].id != noteId) next.push(records.value[i]);
  }
  records.value = next;
}

async function confirmDelete(item: VoiceRecordHistoryItem): Promise<void> {
  try {
    await apiVoiceNoteDelete(item.id);
    if (playingId.value == item.id) stopPlayback();
    removeRecord(item.id);
    uni.showToast({ title: "已删除", icon: "none" });
  } catch (_error) {
    uni.showToast({ title: "删除失败", icon: "none" });
  }
}

function handleDelete(item: VoiceRecordHistoryItem): void {
  uni.showModal({
    title: "删除录音",
    content: "删除后列表里不再显示，30 天后无法恢复。确定删除？",
    confirmText: "删除",
    cancelText: "取消",
    success: (res) => {
      if (res.confirm != true) return;
      confirmDelete(item);
    },
  });
}

onShow(() => {
  void loadRecords(true);
});

onUnload(() => {
  stopPlayback();
});
</script>

<style lang="scss" scoped>
.vh-page {
  flex: 1;
  background-color: #f4f5f7;
}

.vh-nav {
  height: 88rpx;
  flex-direction: row;
  align-items: center;
  padding: 0 8rpx;
}

.vh-nav__side {
  width: 88rpx;
  height: 88rpx;
  justify-content: center;
  padding-left: 16rpx;
}

.vh-nav__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.vh-list {
  flex: 1;
  padding: 8rpx 24rpx 32rpx 24rpx;
}

.vh-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.vh-card__head {
  flex-direction: row;
  align-items: flex-start;
}

.vh-card__title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  lines: 2;
}

.vh-card__actions {
  margin-top: 20rpx;
  flex-direction: row;
  flex-wrap: wrap;
}

.vh-card__btn {
  flex-direction: row;
  align-items: center;
  height: 56rpx;
  padding: 0 18rpx;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
  border-radius: 28rpx;
  background-color: #f3f2fb;
}

.vh-card__stop {
  width: 14rpx;
  height: 14rpx;
  border-radius: 3rpx;
  background-color: #5b4dff;
}

.vh-card__btn-text {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #5b4dff;
}

.vh-card__btn-text--danger {
  margin-left: 0;
  color: #e24b4b;
}

.vh-footer {
  padding: 8rpx 0 24rpx 0;
  align-items: center;
}

.vh-footer__text {
  font-size: 24rpx;
  color: #9a9aa2;
}

.vh-card__meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9a9aa2;
}

.vh-card__file {
  margin-top: 20rpx;
  flex-direction: row;
  align-items: center;
  background-color: #f3f2fb;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}

.vh-card__path {
  flex: 1;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #6a68b8;
  lines: 1;
}
</style>
