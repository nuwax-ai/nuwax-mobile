<template>
  <view class="test-provision">
    <custom-nav-bar :title="t('Mobile.Provision.Test.title')" :show-back="true" :has-safety-zone="true" />

    <scroll-view scroll-y class="test-provision__body">
      <!-- 模式切换 -->
      <view class="card">
        <view class="card__row">
          <text class="card__label">{{ t('Mobile.Provision.Test.mode') }}</text>
          <text class="card__value">{{ useMock ? t('Mobile.Provision.Test.modeMock') : t('Mobile.Provision.Test.modeReal') }}</text>
        </view>
        <view class="card__row">
          <text class="card__label">{{ t('Mobile.Provision.Test.useMock') }}</text>
          <switch :checked="useMock" @change="onToggleMock" color="#5147ff" />
        </view>
        <text class="card__platform">{{ platformText }}</text>
      </view>

      <!-- Vox 网关接口 Mock 开关（设备/会议/推送/消息四组 /api/app/** 接口） -->
      <view class="card">
        <view class="card__row">
          <text class="card__label">{{ t('Mobile.Provision.Test.voxMock') }}</text>
          <switch :checked="voxMock" @change="onToggleVoxMock" color="#5147ff" />
        </view>
        <text class="security-form__tip">{{ t('Mobile.Provision.Test.voxMockTip') }}</text>
      </view>

      <!-- 首轮真机联调凭据：仅内存，不写 storage、不输出日志 -->
      <view class="card" v-if="!useMock">
        <text class="card__section">Security 2 联调凭据</text>
        <text class="security-form__tip">从设备串口获取 username；PoP 通过受控渠道获取。本页不会持久化或打印凭据。</text>
        <input
          v-model="securityUsername"
          class="security-form__input"
          placeholder="设备 username / UID"
          placeholder-class="security-form__placeholder"
        />
        <input
          v-model="securityPop"
          class="security-form__input"
          password
          placeholder="开发 PoP"
          placeholder-class="security-form__placeholder"
        />
      </view>

      <!-- 场景选择 -->
      <view class="card" v-if="useMock">
        <text class="card__section">{{ t('Mobile.Provision.Test.scenario') }}</text>
        <view
          v-for="(opt, index) in scenarios"
          :key="index"
          class="scenario"
          @tap="selectScenario(opt.value)"
        >
          <view class="scenario__radio" :class="{ 'scenario__radio--on': currentScenario == opt.value }"></view>
          <view class="scenario__info">
            <text class="scenario__label">{{ opt.label }}</text>
            <text class="scenario__desc">{{ opt.desc }}</text>
          </view>
        </view>
      </view>

      <!-- 快捷入口 -->
      <view class="card">
        <view class="entry" @tap="gotoEntry">
          <text class="entry__text">{{ t('Mobile.Provision.Test.gotoEntry') }}</text>
        </view>
        <view class="entry" @tap="gotoScan">
          <text class="entry__text">{{ t('Mobile.Provision.Test.gotoScan') }}</text>
        </view>
        <view class="entry" @tap="gotoWifi">
          <text class="entry__text">{{ t('Mobile.Provision.Test.gotoWifi') }}</text>
        </view>
        <view class="entry" @tap="gotoProgress">
          <text class="entry__text">{{ t('Mobile.Provision.Test.gotoProgress') }}</text>
        </view>
      </view>

      <!-- 模拟扫码（无真机时验证扫码直连链路） -->
      <view class="card">
        <text class="card__section">{{ t('Mobile.Provision.Test.mockQrTitle') }}</text>
        <text class="security-form__tip">{{ t('Mobile.Provision.Test.mockQrTip') }}</text>
        <input
          v-model="mockQrJson"
          class="security-form__input"
          placeholder='{"ver":"v1","name":"PROV_A001","transport":"ble","username":"mock-user","pop":"mock-pop","security":2}'
          placeholder-class="security-form__placeholder"
        />
        <view class="entry" @tap="gotoMockQrConnect">
          <text class="entry__text">{{ t('Mobile.Provision.Test.mockQrParse') }}</text>
        </view>
      </view>

      <!-- 日志 -->
      <view class="card">
        <view class="card__row">
          <text class="card__section">{{ t('Mobile.Provision.Test.log') }}</text>
          <text class="card__clear" @tap="clearLog">{{ t('Mobile.Provision.Test.clearLog') }}</text>
        </view>
        <view class="log">
          <text v-for="(line, index) in logs" :key="index" class="log__line">{{ line }}</text>
          <text v-if="logs.length == 0" class="log__empty">—</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { useI18n, emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { isUsingMock, setUseMock } from "@/utils/ble/bleAdapterFactory";
  import { isVoxMockEnabled, setVoxMockEnabled } from "@/servers/vox/mockVoxData";
  import { mockScenarioOptions, getMockScenario, setMockScenario, type MockScenarioOption } from "@/utils/mockProvisionData";
  import { MockScenarioEnum } from "@/types/enums/provision";
  import { EspProvisioningSecurityEnum } from "@/types/enums/espProvisioning";
  import { WifiCredentials } from "@/types/interfaces/provision";
  import { EspProvisioningDevice } from "@/types/interfaces/espProvisioning";
  import { ESP_PROV_DEFAULT_SERVICE_UUID } from "@/constants/espProvisioning.constants";
  import { useEspProvisioning, releaseEspProvisioning } from "@/hooks/useEspProvisioning";
  import { setProvisionDevice, setProvisionCredentials, clearProvisionSession, setQrPayload } from "@/utils/provisionSession";

  // 与主包页面一致的本地单参 t 包装（composable 的 t 在主包模板中解析有坑）
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** switch 组件 change 事件（对齐内置 UniInputEvent 结构） */
  class SwitchChangeDetail {
    value: boolean = false;
  }
  class SwitchChangeEvent {
    detail: SwitchChangeDetail = new SwitchChangeDetail();
  }

  const useMock = ref<boolean>(true);
  const voxMock = ref<boolean>(true);
  const scenarios = ref<MockScenarioOption[]>([] as MockScenarioOption[]);
  const currentScenario = ref<MockScenarioEnum>(MockScenarioEnum.SUCCESS);
  const platformText = ref<string>("");
  const logs = ref<string[]>([] as string[]);
  const securityUsername = ref<string>("");
  const securityPop = ref<string>("");
  const mockQrJson = ref<string>("");

  const addLog = (msg: string) => {
    const time = `${new Date().getHours()}:${new Date().getMinutes()}:${new Date().getSeconds()}`;
    logs.value.unshift(`[${time}] ${msg}`);
    if (logs.value.length > 50) {
      logs.value = logs.value.slice(0, 50);
    }
  };

  const refreshState = () => {
    useMock.value = isUsingMock();
    voxMock.value = isVoxMockEnabled();
    currentScenario.value = getMockScenario();
  };

  const onToggleMock = (e: SwitchChangeEvent) => {
    const v = e.detail.value;
    setUseMock(v);
    releaseEspProvisioning();
    useMock.value = v;
    addLog(`切换模式: ${v ? 'Mock' : '真实BLE'}`);
  };

  const onToggleVoxMock = (e: SwitchChangeEvent) => {
    const v = e.detail.value;
    setVoxMockEnabled(v);
    voxMock.value = v;
    addLog(`Vox 接口: ${v ? 'Mock' : '真实网关'}`);
  };

  const selectScenario = (value: MockScenarioEnum) => {
    setMockScenario(value);
    currentScenario.value = value;
    addLog(`选择场景: ${value}`);
  };

  const clearLog = () => {
    logs.value = [] as string[];
  };

  const prepareRealSecurity = (): boolean => {
    if (useMock.value) return true;
    const username = securityUsername.value.trim();
    const pop = securityPop.value;
    if (username == "" || pop == "") {
      uni.showToast({ title: "请填写 Security 2 username 和 PoP", icon: "none" });
      return false;
    }
    const controller = useEspProvisioning();
    controller.configureSecurity(
      EspProvisioningSecurityEnum.SECURITY_2,
      username,
      pop,
      "PROV_",
    );
    return true;
  };

  // 直达配网入口页（扫码/手动并列）
  const gotoEntry = () => {
    releaseEspProvisioning();
    clearProvisionSession();
    uni.navigateTo({ url: "/subpackages/pages/provision/provision-entry/provision-entry" });
  };

  // 模拟扫码：解析 QR JSON 并直连
  const gotoMockQrConnect = () => {
    const raw = mockQrJson.value.trim();
    if (raw == "") {
      uni.showToast({ title: t("Mobile.Provision.Test.qrJsonRequired"), icon: "none" });
      return;
    }
    releaseEspProvisioning();
    clearProvisionSession();
    const controller = useEspProvisioning();
    const parseResult = controller.configureFromQr(raw);
    if (parseResult.payload == null) {
      uni.showToast({ title: `${t("Mobile.Provision.Test.qrParseFailed")}: ${parseResult.errorCode}`, icon: "none" });
      addLog(`QR parse failed: ${parseResult.errorCode}`);
      return;
    }
    setQrPayload(parseResult.payload);
    addLog(`QR parsed: ${parseResult.payload.name}`);
    uni.navigateTo({ url: "/subpackages/pages/provision/provision-connect/provision-connect" });
  };

  // 直达扫描页（正常入口）
  const gotoScan = () => {
    releaseEspProvisioning();
    clearProvisionSession();
    if (!prepareRealSecurity()) return;
    uni.navigateTo({ url: "/subpackages/pages/provision/provision-scan/provision-scan" });
  };

  // 直达凭据页（需先注入模拟选中设备）
  const gotoWifi = () => {
    if (!useMock.value) {
      uni.showToast({ title: "真实 BLE 请从扫描页选择设备", icon: "none" });
      return;
    }
    releaseEspProvisioning();
    setProvisionDevice(new EspProvisioningDevice("AA:BB:CC:DD:EE:01", "PROV_A001", -52, ESP_PROV_DEFAULT_SERVICE_UUID));
    uni.navigateTo({ url: "/subpackages/pages/provision/provision-wifi/provision-wifi" });
  };

  // 直达进度页（需注入模拟设备+凭据）
  const gotoProgress = () => {
    if (!useMock.value) {
      uni.showToast({ title: "真实 BLE 请从扫描页开始", icon: "none" });
      return;
    }
    releaseEspProvisioning();
    setProvisionDevice(new EspProvisioningDevice("AA:BB:CC:DD:EE:01", "PROV_A001", -52, ESP_PROV_DEFAULT_SERVICE_UUID));
    setProvisionCredentials(new WifiCredentials("TestWiFi", "12345678"));
    uni.navigateTo({ url: "/subpackages/pages/provision/provision-progress/provision-progress" });
  };

  onLoad((_options: OnLoadOptions) => {
    scenarios.value = mockScenarioOptions();
    refreshState();
    // 平台标识
    // #ifdef APP-ANDROID
    platformText.value = "Android";
    // #endif
    // #ifdef APP-IOS
    platformText.value = "iOS";
    // #endif
    // #ifdef APP-HARMONY
    platformText.value = "HarmonyOS";
    // #endif
    // #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
    platformText.value = "Other";
    // #endif
    addLog("进入配网 Mock 调试页");
  });
</script>

<style lang="scss" scoped>
  .test-provision {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;

    &__body {
      flex: 1;
      padding: 24rpx;
    }
  }

  .card {
    background-color: #ffffff;
    border-radius: 20rpx;
    padding: 28rpx;
    margin-bottom: 24rpx;

    &__row {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20rpx;
    }

    &__label {
      font-size: 30rpx;
      color: #333;
    }

    &__value {
      font-size: 30rpx;
      color: #5147ff;
      font-weight: 500;
    }

    &__platform {
      font-size: 24rpx;
      color: #999;
    }

    &__section {
      font-size: 28rpx;
      color: #333;
      font-weight: 500;
      margin-bottom: 16rpx;
    }

    &__clear {
      font-size: 26rpx;
      color: #5147ff;
    }
  }

  .scenario {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #f0f0f0;

    &__radio {
      width: 32rpx;
      height: 32rpx;
      border-radius: 50%;
      border: 2rpx solid #c0c0c0;
      margin-right: 20rpx;

      &--on {
        border-color: #5147ff;
        background-color: #5147ff;
      }
    }

    &__info {
      display: flex;
      flex-direction: column;
    }

    &__label {
      font-size: 30rpx;
      color: #333;
    }

    &__desc {
      font-size: 24rpx;
      color: #999;
    }
  }

  .security-form {
    &__tip {
      font-size: 24rpx;
      line-height: 1.5;
      color: #999;
      margin-bottom: 20rpx;
    }

    &__input {
      height: 76rpx;
      border-bottom: 1rpx solid #eeeeee;
      font-size: 28rpx;
      color: #333333;
    }

    &__placeholder {
      color: #b8b8b8;
    }
  }

  .entry {
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f0f0f0;

    &__text {
      font-size: 30rpx;
      color: #5147ff;
    }
  }

  .log {
    background-color: #1e1e1e;
    border-radius: 12rpx;
    padding: 20rpx;
    max-height: 400rpx;

    &__line {
      font-size: 22rpx;
      color: #4cd964;
      line-height: 1.6;
    }

    &__empty {
      font-size: 22rpx;
      color: #666;
    }
  }
</style>
