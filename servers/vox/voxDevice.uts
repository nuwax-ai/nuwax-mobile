/**
 * Nuwax Vox 设备语音网关 - App 设备接口
 * 绑定/解绑/改名/列表/会议模式开关；mock 开关见 mockVoxData.uts
 */
import request from "@/servers/useRequest";
import { VOX_BASE_URL } from "@/constants/config";
import type { RequestResponse, VoidRequestResponse } from "@/types/interfaces/request";
import type { AppDeviceBindParams, AppDeviceRenameParams, IAppDeviceView } from "@/types/interfaces/voxDevice";
import {
  isVoxMockEnabled,
  mockVoxBindDevice,
  mockVoxDeviceList,
  mockVoxMeetingModeSwitch,
  mockVoxRenameDevice,
  mockVoxUnbindDevice,
} from "./mockVoxData";

/** Android 上自定义 class 序列化会丢字段，显式构造 body */
function buildBindBody(data: AppDeviceBindParams): UTSJSONObject {
  const body = new UTSJSONObject();
  body["deviceId"] = data.deviceId;
  body["displayName"] = data.displayName;
  return body;
}

/** 绑定设备；deviceSecret 仅此接口返回，需下发给设备本地保存 */
export async function apiVoxBindDevice(data: AppDeviceBindParams): Promise<RequestResponse<IAppDeviceView>> {
  if (isVoxMockEnabled()) {
    return mockVoxBindDevice(data.deviceId, data.displayName);
  }
  const res = await request({ url: "/api/app/devices/bind", method: "POST", data: buildBindBody(data), baseUrl: VOX_BASE_URL });
  return res;
}

/** 解绑设备（deviceId 需 URL 编码） */
export async function apiVoxUnbindDevice(deviceId: string): Promise<VoidRequestResponse> {
  if (isVoxMockEnabled()) {
    return mockVoxUnbindDevice(deviceId);
  }
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/unbind`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}

/** 修改设备名称 */
export async function apiVoxRenameDevice(deviceId: string, data: AppDeviceRenameParams): Promise<RequestResponse<IAppDeviceView>> {
  if (isVoxMockEnabled()) {
    return mockVoxRenameDevice(deviceId, data.displayName);
  }
  const body = new UTSJSONObject();
  body["displayName"] = data.displayName;
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/rename`, method: "POST", data: body, baseUrl: VOX_BASE_URL });
  return res;
}

/** 当前用户已绑定设备列表（不含密钥） */
export async function apiVoxDeviceList(): Promise<RequestResponse<IAppDeviceView[]>> {
  if (isVoxMockEnabled()) {
    return mockVoxDeviceList();
  }
  const res = await request({ url: "/api/app/devices", method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 开启会议模式（向在线设备下发 set_audio_mode enabled，异步等 ack） */
export async function apiVoxMeetingModeStart(deviceId: string): Promise<VoidRequestResponse> {
  if (isVoxMockEnabled()) {
    return mockVoxMeetingModeSwitch(deviceId, true);
  }
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/meeting/start`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}

/** 关闭会议模式 */
export async function apiVoxMeetingModeStop(deviceId: string): Promise<VoidRequestResponse> {
  if (isVoxMockEnabled()) {
    return mockVoxMeetingModeSwitch(deviceId, false);
  }
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/meeting/stop`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}
