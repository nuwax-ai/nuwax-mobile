/**
 * 合并转发条目（msgType=merge_forward 的 body.items 单项，聊天记录详情页用）。
 *
 * chat.uvue 解析 body.items 全量存 ImMsgRow.mergeAllItems（气泡内只渲染 mergeItems
 * 前 2 条预览），点卡片经 imMergeRecordSession 暂存跳转详情页渲染全量。
 *
 * UTS: 使用 class，interface 对象字面量初始化会报 UTS110111163（同 msgActionItem 约定）。
 */
export class ImMergeItem {
  /** 发送者显示名（转发那一刻的快照值）。 */
  senderName: string = "";
  /** 发送时间 ms（快照值；详情页行首时间用）。 */
  sendTime: number = 0;
  /** 展示文案（解析时已按 msgType 归一：text 用原文，纯媒体按类型占位）。 */
  preview: string = "";
  /** 原始文本（未做占位归一；详情页正文用。有媒体渲染时不再重复显示 [图片] 类占位）。 */
  text: string = "";
  /** 图片附件（kind=image；详情页缩略图渲染，受保护地址 onLoad 异步解析）。 */
  images: ImMergeMedia[] = [];
  /** 视频附件（kind=video，含 kind=file 但实为视频文件的快照；详情页内联 <video> 渲染）。 */
  videos: ImMergeMedia[] = [];
  /** 语音附件（kind=audio；详情页声波气泡渲染，点按播放/停止）。 */
  audios: ImMergeMedia[] = [];
  /** 文件附件（kind=file 真文件；详情页文件卡片渲染，点击预览/下载）。 */
  files: ImMergeMedia[] = [];
}

/**
 * 合并转发条目内的媒体附件（body.items[].attachments 单项快照）。
 * 契约见 servers/im.uts apiImSendMergeForwardMsg：{kind, url, fileName, size?}。
 */
export class ImMergeMedia {
  /** 附件类型（发送侧快照原样："image" | "file" | "video" | "audio"）。 */
  kind: string = "";
  /** 附件地址（/api/f/ 受保护直链或外链原样）。 */
  url: string = "";
  /** 文件名（图片可空；文件/视频卡片展示与下载命名用）。 */
  fileName: string = "";
  /** 条目内稳定 id（详情页 onLoad 编 "v{i}-{j}"/"a{i}-{j}"；播放态/预载态模板直读比对用，
   *  快照本无 msgId，音视频互斥与行级状态都靠它寻址）。 */
  uid: string = "";
  /** 视频可播地址（受保护地址解析回填；空=未预载，模板挂占位卡）。 */
  playUrl: string = "";
  /** 语音时长秒（快照无此字段，首播由播放器回填）。 */
  duration: number = 0;
}
