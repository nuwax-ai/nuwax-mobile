<template>
  <!-- 数学公式统一出口组件。
       App（Android/iOS/Harmony）与 H5：走 nuwax-uni-math 的 <x-math>
         （App=native SVG 位图 / iosMath 原生矢量，H5=proxy-web KaTeX 实时渲染）；
       微信小程序：nuwax-uni-math 无 MP 实现（空壳），保留 nuwax-katex rich-text 兜底，
       避免 MP 公式空白。nuwax-katex 插件整体保留，供 MP 端继续使用。 -->
  <!-- #ifdef MP-WEIXIN -->
  <nuwax-katex :tex="latex" :display-mode="displayMode == true" />
  <!-- #endif -->
  <!-- #ifndef MP-WEIXIN -->
  <x-math :latex="latex" :display-mode="displayMode == true" :inline="inline" />
  <!-- #endif -->
</template>

<script lang="uts" setup>
// #ifdef MP-WEIXIN
import NuwaxKatex from '@/uni_modules/nuwax-katex/components/nuwax-katex/nuwax-katex.uvue'
// #endif
// #ifndef MP-WEIXIN
import XMath from '@/uni_modules/nuwax-uni-math/components/x-math/x-math.uvue'
// #endif

const props = defineProps<{
  /** LaTeX 源码（不含 $ / $$ 定界符） */
  latex: string
  /** true=块级公式（display），false/缺省=行内 */
  displayMode?: boolean
  /** 显式行内（覆盖 displayMode 推断；段落/列表/标题/引用/表格等混排场景传 true） */
  inline?: boolean
}>()
</script>
