    display: flex;
    flex-direction: row;
    align-items: center;
    height: 136rpx;
    padding: 0 28rpx;
    box-sizing: border-box;
    background-color: #ffffff;
  }

  .app-card__body {
    flex: 1;
    align-self: stretch;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1rpx solid #f5f5f7;
    box-sizing: border-box;
  }

  .app-card__head {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .app-card__name {
    flex: 1;
    min-width: 0;
    margin-right: 16rpx;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 42rpx;
    color: #17191f;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-card__views {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
  }

  .app-card__count {
    margin-left: 6rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #b0b0b8;
  }

  .app-card__desc {
    margin-top: 8rpx;
    font-size: 26rpx;
    line-height: 36rpx;
    color: #8b8a93;
    overflow: hidden;
    text-overflow: ellipsis;
