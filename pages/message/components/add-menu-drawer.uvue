<template>
  <!--
    消息页右上角「+」锚定气泡：创建群组 / 加入群组 / 添加伙伴 / 扫一扫（H5 不渲染）
    - 显隐由页面状态经 :visible 下发（单一事实源 message.uvue addDrawerVisible）：
      加号 toggle / 蒙层点外 / Android 返回 / onHide 任何路径页面置 false 即收起；
      锚定值经 props 下发（anchorBottom/anchorRightGap，视口坐标）、close() 只派发 closed 请求
    - 气泡本体 absolute 挂页面 fixed 全屏蒙层内（本组件根节点即气泡），贴屏幕右缘
      （与加号右缘对齐，留小间距），顶部在加号下方（视口坐标系，由页面测量直传）
    - 点外关闭=蒙层 @tap（iOS/H5 主路径）；★Android 蒙层触摸为事件黑洞（拦住不
      派发，2026-10-01 四轮真机日志暂缓），点外暂只能靠返回键/菜单项收起
    - 气泡根节点阻断 touch/tap 冒泡：点气泡自身不触发页面级关闭
    - 安卓返回先关气泡（popupBackRegistry → close → closed）
  -->
  <view
    v-if="visible"
    class="add-pop"
    :style="popStyle"
    @touchstart.stop="handleBubbleTouch"
    @touchend.stop="handleBubbleTouch"
    @touchcancel.stop="handleBubbleTouch"
    @tap.stop="handlePopTap"
  >
    <view
      class="add-pop__item"
      hover-class="add-pop__item--active"
      @tap="handleCreateGroup"
    >
      <image class="add-pop__icon" :src="iconCreateGroup" mode="aspectFit" />
      <text class="add-pop__label">{{ t("Mobile.Message.createGroup") }}</text>
    </view>
    <view
      class="add-pop__item"
      hover-class="add-pop__item--active"
      @tap="handleJoinGroup"
    >
      <image class="add-pop__icon" :src="iconJoinGroup" mode="aspectFit" />
      <text class="add-pop__label">{{ t("Mobile.Message.joinGroup") }}</text>
    </view>
    <view
      class="add-pop__item"
      hover-class="add-pop__item--active"
      @tap="handleAddBuddy"
    >
      <image class="add-pop__icon" :src="iconAddBuddy" mode="aspectFit" />
      <text class="add-pop__label">{{ t("Mobile.Message.addBuddy") }}</text>
    </view>
    <!-- 扫一扫：H5 无 uni.scanCode，入口不渲染（组件内另有兜底提示） -->
    <!-- #ifndef H5 -->
    <view
      class="add-pop__item"
      hover-class="add-pop__item--active"
      @tap="handleScan"
    >
      <image class="add-pop__icon" :src="iconScan" mode="aspectFit" />
      <text class="add-pop__label">{{ t("Mobile.Message.scan") }}</text>
    </view>
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { computed, onUnmounted, watch } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import {
    registerPopupClose,
    unregisterPopupClose,
    registerBackInterceptionGlobals,
  } from "@/utils/popupBackRegistry";
  import iconCreateGroup from "@/static/icons/group_set.svg";
  import iconJoinGroup from "@/static/icons/join_group.svg";
  import iconAddBuddy from "@/static/icons/add_buddy.svg";
  import iconScan from "@/static/icons/scan.svg";

  // 事件名须 kebab-case：App-Android 模板监听会把 camelCase 转小写导致收不到（.cursorrules 规约）
  const emit = defineEmits<{
    "create-group": [];
    "join-group": [];
    "add-buddy": [];
    "scan-tap": [];
    /** 关闭后触发，页面借此串行接续下一个弹窗 */
    closed: [];
  }>();

  const props = defineProps<{
    /** 气泡显隐（页面状态直发，单一事实源在 message.uvue；组件不自带显隐状态——
     *  页面与组件的模块实例不保证同份，跨文件共享 ref 不可靠）。 */
    visible: boolean;
    /** 加号下缘视口坐标 y（fixed 蒙层内气泡顶部锚定）；-1=未测到，用兜底位置。 */
    anchorBottom: number;
    /** 加号右缘距屏幕右缘间距（气泡 right 偏移）；-1=未测到，用兜底位置。 */
    anchorRightGap: number;
  }>();

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 气泡位置（absolute，挂页面 fixed 蒙层内=视口坐标）：顶部在加号下缘 + 6px；
   *  右缘与加号右缘对齐；-1=未测到用兜底位。 */
  const popStyle = computed((): string => {
    const top = props.anchorBottom > 0 ? props.anchorBottom + 6 : 56;
    const rightGap = props.anchorRightGap > 0 ? props.anchorRightGap : 16;
    return "top: " + top.toString() + "px; right: " + rightGap.toString() + "px;";
  });

  /** 请求关闭（Android 返回键 / 菜单项点击后）：只派发 closed，显隐由页面落定
   *  （handleAddDrawerClosed 收下 visible=false 并接续跳转）。 */
  function close(): void {
    if (props.visible == false) {
      return;
    }
    emit("closed");
  }

  /** App web-view 内嵌 H5：Android 返回手势先关气泡。 */
  registerBackInterceptionGlobals();
  let popupRegistryId: number = 0;
  watch(
    (): boolean => props.visible,
    (val: boolean) => {
      if (val == true) {
        if (popupRegistryId == 0) {
          popupRegistryId = registerPopupClose(close);
        }
      } else if (popupRegistryId != 0) {
        unregisterPopupClose(popupRegistryId);
        popupRegistryId = 0;
      }
    },
    { immediate: true },
  );
  onUnmounted(() => {
    if (popupRegistryId != 0) {
      unregisterPopupClose(popupRegistryId);
      popupRegistryId = 0;
    }
  });

  /** 阻断气泡内触摸/点击冒泡到页面（页面级 touchstart 会收起气泡；行点击各自处理）。 */
  function handleBubbleTouch(): void {}

  function handlePopTap(): void {}

  function handleCreateGroup(): void {
    emit("create-group");
    close();
  }

  function handleJoinGroup(): void {
    emit("join-group");
    close();
  }

  function handleAddBuddy(): void {
    emit("add-buddy");
    close();
  }

  function handleScan(): void {
    emit("scan-tap");
    close();
  }

  defineExpose({
    close: close as any,
  });
</script>

<style lang="scss" scoped>
  /* 气泡 absolute 挂页面 fixed 全屏蒙层内（视口坐标锚定，z-index 998 高于蒙层 997）。
     点外关闭=蒙层 @tap（iOS/H5）；Android 蒙层触摸为事件黑洞暂缓，见 message.uvue 注释。 */
  .add-pop {
    position: absolute;
    /* 低于 uni-modal-popup 默认 zIndex 999：串行弹出的底部表单在气泡之上 */
    z-index: 998;
    width: 320rpx;
    padding: 12rpx 0;
    background-color: #ffffff;
    border-radius: 20rpx;
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
  }

  .add-pop__item {
    height: 96rpx;
    padding: 0 32rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .add-pop__item--active {
    background-color: #f4f3f8;
  }

  .add-pop__icon {
    width: 44rpx;
    height: 44rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
  }

  .add-pop__label {
    font-size: 28rpx;
    line-height: 40rpx;
    font-weight: 500;
    color: #1c1b20;
  }
</style>
