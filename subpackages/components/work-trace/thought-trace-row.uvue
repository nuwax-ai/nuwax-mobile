<template>
  <view class="thought-row">
    <view class="thought-header" @tap="toggleExpanded">
      <svg-icon name="icon-BulbOutlined" customClass="thought-icon" />
      <text class="thought-title">{{ title }}</text>
      <text class="thought-summary">{{ summary }}</text>
      <text class="iconfont thought-caret" :class="{ 'thought-caret-open': expanded }">&#xe647;</text>
    </view>
    <view v-if="expanded" class="thought-body">
      <text class="thought-content" :selectable="true">{{ text }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  const props = defineProps<{ text: string; running: boolean }>();
  const { t } = useI18n();
  const expanded = ref(false);
  const title = computed((): string => t(props.running ? "Mobile.Chat.thinking" : "Mobile.Chat.WorkTrace.thoughtTitle", emptyI18nParams(), ""));
  const summary = computed((): string => props.text.replace(/\s+/g, " ").trim());
  function toggleExpanded(): void { expanded.value = !expanded.value; }
</script>

<style lang="scss" scoped>
  .thought-header { display: flex; flex-direction: row; align-items: center; padding: 10rpx 0; gap: 12rpx; }
  .thought-icon { width: 28rpx; height: 28rpx; color: #999; flex-shrink: 0; }
  .thought-title { font-size: 28rpx; color: #333; flex-shrink: 0; }
  .thought-summary { flex: 1; min-width: 0; font-size: 26rpx; color: #999; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .thought-caret { font-size: 22rpx; color: #999; flex-shrink: 0; }
  .thought-caret-open { transform: rotate(90deg); }
  .thought-body { padding: 12rpx 20rpx; margin: 6rpx 0 12rpx 40rpx; background-color: #f7f7f8; border-radius: 12rpx; }
  .thought-content { font-size: 26rpx; color: #777; line-height: 40rpx; }
</style>
