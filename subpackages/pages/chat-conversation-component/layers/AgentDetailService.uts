/** 字符串转 AgentComponentTypeEnum（JSON 返回的是 string，不能直接 as） */
function parseAgentComponentType(val: string | null): AgentComponentTypeEnum {
  if (val == null) return AgentComponentTypeEnum.Plugin;
  if (val == "Plugin") return AgentComponentTypeEnum.Plugin;
  if (val == "Workflow") return AgentComponentTypeEnum.Workflow;
  if (val == "Trigger") return AgentComponentTypeEnum.Trigger;
  if (val == "Knowledge") return AgentComponentTypeEnum.Knowledge;
  if (val == "Variable") return AgentComponentTypeEnum.Variable;
  if (val == "Table") return AgentComponentTypeEnum.Table;
  if (val == "Model") return AgentComponentTypeEnum.Model;
  if (val == "Agent") return AgentComponentTypeEnum.Agent;
  if (val == "Mcp") return AgentComponentTypeEnum.MCP;
  if (val == "Page") return AgentComponentTypeEnum.Page;
  if (val == "Event") return AgentComponentTypeEnum.Event;
  if (val == "Skill") return AgentComponentTypeEnum.Skill;
  if (val == "ToolCall") return AgentComponentTypeEnum.ToolCall;
  if (val == "Plan") return AgentComponentTypeEnum.Plan;
  return AgentComponentTypeEnum.Plugin;
}
/** number 转 DefaultSelectedEnum（JSON 返回的是 number，不能直接 as） */
function parseDefaultSelected(val: number | null): DefaultSelectedEnum {
  if (val == null) return DefaultSelectedEnum.No;
  if (val == 1) return DefaultSelectedEnum.Yes;
  return DefaultSelectedEnum.No;
}

/** Android：UTSJSONObject 不能存入 Interface[]（ClassCastException），通过 class 构造 */
class _ManualComponentInfo implements AgentManualComponentInfo {
  id: number = 0;
  name: string = "";
  icon: string = "";
  description: string = "";
  type: AgentComponentTypeEnum = AgentComponentTypeEnum.Plugin;
  defaultSelected: DefaultSelectedEnum = DefaultSelectedEnum.No;
  constructor(raw: UTSJSONObject) {
    this.id = raw["id"] as number | null ?? 0;
    this.name = raw["name"] as string | null ?? "";
    this.icon = raw["icon"] as string | null ?? "";
    this.description = raw["description"] as string | null ?? "";
    this.type = parseAgentComponentType(raw["type"] as string | null);
    this.defaultSelected = parseDefaultSelected(raw["defaultSelected"] as number | null);
  }
}

export function parseManualComponents(raw: any | null): AgentManualComponentInfo[] {
  if (raw == null) return [];
  const arr = raw as UTSJSONObject[];
  const result: AgentManualComponentInfo[] = [];
  for (let i = 0; i < arr.length; i++) {
    result.push(new _ManualComponentInfo(arr[i] as UTSJSONObject));
  }
  return result;
}

/** Android：UTSJSONObject 不能 as SandboxInfo，通过 class 构造 */
class _SandboxInfo implements SandboxInfo {
  sandboxId: string = "";
  name: string = "";
  description: string = "";
  constructor(raw: UTSJSONObject) {
    this.sandboxId = raw["sandboxId"] as string | null ?? "";
    this.name = raw["name"] as string | null ?? "";
    this.description = raw["description"] as string | null ?? "";
  }
}

/**
 * Android：messageList 项常为 Map，禁止 item as UTSJSONObject（字段全丢 → id/role/text 变默认值）。
 * 必须走 createMessageInfoFromAny（内部 Map.get 读已知键）。
 */
function parseMessageList(raw: any | null): MessageInfo[] {
  if (raw == null) return [];
  const result: MessageInfo[] = [];
  const arr = raw as any[];
  if (arr != null) {
    for (let i = 0; i < arr.length; i++) {
      const item = arr[i];
      if (item == null) continue;
      const msg = createMessageInfoFromAny(item);
      if (msg != null) {
        result.push(msg);
      }
    }
  }
  if (result.length > 0) {
    return result;
  }
  // iOS 等：messageList 偶发不是原生 Array，JSON 往返兜底（对齐 parseSandboxList）
  try {
    const jsonStr = JSON.stringify(raw);
    if (jsonStr == null || jsonStr.length <= 2) {
      return result;
    }
    const parsedAny = JSON.parse(jsonStr) as any | null;
    if (parsedAny == null) {
      return result;
    }
    const fallbackArr = parsedAny as any[];
    if (fallbackArr == null) {
      return result;
    }
    for (let j = 0; j < fallbackArr.length; j++) {
      const fallbackItem = fallbackArr[j];
      if (fallbackItem == null) continue;
      const msg2 = createMessageInfoFromAny(fallbackItem);
      if (msg2 != null) {
        result.push(msg2);
      }
    }
  } catch (_e) {
    // ignore
  }
  return result;
}

/** 安全解析沙盒列表 */
function parseSandboxList(raw: any | null): SandboxInfo[] {
  if (raw == null) return [];
  const result: SandboxInfo[] = [];
  // 优先直接遍历 native Array（Android 接口返回 Array<UTSJSONObject>）
  const nativeArr = raw as UTSJSONObject[];
  for (let i = 0; i < nativeArr.length; i++) {
    const item = nativeArr[i];
    if (item == null) continue;
    result.push(new _SandboxInfo(item as UTSJSONObject));
  }
  if (result.length > 0) return result;

  // JSON 往返兜底（禁止 JSON.parse<any[]>，Android 会抛 ClassCastException）
  const jsonStr = JSON.stringify(raw);
  if (jsonStr == null || jsonStr.length <= 2) return result;
  const parsedAny = JSON.parse(jsonStr) as any | null;
  if (parsedAny == null) return result;
  const fallbackArr = parsedAny as UTSJSONObject[];
  for (let j = 0; j < fallbackArr.length; j++) {
    const fallbackItem = fallbackArr[j];
    if (fallbackItem == null) continue;
    const itemStr = JSON.stringify(fallbackItem);
    if (itemStr == null || itemStr.length <= 2) continue;
    const itemObj = JSON.parse<UTSJSONObject>(itemStr);
    if (itemObj != null) {
      result.push(new _SandboxInfo(itemObj));
    }
  }
  return result;
}

/** Android：agentSelected 运行时是 UTSJSONObject，禁止 as Record<string,string> */
function parseAgentSelectedSandbox(raw: any | null): UTSJSONObject {
  if (raw == null) return new UTSJSONObject();
  const jsonStr = JSON.stringify(raw);
  if (jsonStr == null || jsonStr.length <= 2) return new UTSJSONObject();
  const parsed = JSON.parse<UTSJSONObject>(jsonStr);
  return parsed != null ? parsed : new UTSJSONObject();
}

function sandboxListContains(list: SandboxInfo[], sandboxId: string): boolean {
  for (let i = 0; i < list.length; i++) {
    if (list[i].sandboxId == sandboxId) return true;
  }
  return false;
}

/** Android：UTSJSONObject 不能 as EventBindConfig，通过 class 构造 */
class _EventArg implements EventArg {
  inputType: string | null = null;
  name: string | null = null;
  bindValue: any | null = null;
  constructor(raw: UTSJSONObject) {
    this.inputType = raw["inputType"] as string | null;
    this.name = raw["name"] as string | null;
    this.bindValue = raw["bindValue"] as any | null;
  }
}

class _EventConfig implements EventConfig {
  name: string = "";
  identification: string = "";
  type: EventBindResponseActionEnum = EventBindResponseActionEnum.Page;
  url: string | null = null;
  pageId: number | null = null;
  basePath: string | null = null;
  pageUri: string | null = null;
  pageUrl: string | null = null;
  args: EventArg[] | null = null;
  argJsonSchema: string | null = null;
  pageName: string | null = null;
  constructor(raw: UTSJSONObject) {
    this.name = raw["name"] as string | null ?? "";
    this.identification = raw["identification"] as string | null ?? "";
    const typeStr = raw["type"] as string | null;
    this.type = typeStr == "Link" ? EventBindResponseActionEnum.Link : EventBindResponseActionEnum.Page;
    this.url = raw["url"] as string | null;
    this.pageId = raw["pageId"] as number | null;
    this.basePath = raw["basePath"] as string | null;
    this.pageUri = raw["pageUri"] as string | null;
    this.pageUrl = raw["pageUrl"] as string | null;
    this.argJsonSchema = raw["argJsonSchema"] as string | null;
    this.pageName = raw["pageName"] as string | null;
    const argsRaw = raw["args"];
    if (argsRaw != null) {
      const argsArr = argsRaw as UTSJSONObject[];
      const parsedArgs: EventArg[] = [];
      for (let i = 0; i < argsArr.length; i++) {
        parsedArgs.push(new _EventArg(argsArr[i] as UTSJSONObject));
      }
      this.args = parsedArgs;
    }
  }
}

class _EventBindConfig implements EventBindConfig {
  eventConfigs: EventConfig[] = [];
  constructor(raw: UTSJSONObject) {
    const rawConfigs = raw["eventConfigs"];
    if (rawConfigs != null) {
      const arr = rawConfigs as UTSJSONObject[];
      const parsed: EventConfig[] = [];
      for (let i = 0; i < arr.length; i++) {
        parsed.push(new _EventConfig(arr[i] as UTSJSONObject));
      }
      this.eventConfigs = parsed;
    }
  }
}

export function parseEventBindConfig(raw: any | null): EventBindConfig | null {
  if (raw == null) return null;
  return new _EventBindConfig(raw as UTSJSONObject);
}

export default class AgentDetailService {
  private data: AgentDetailData;
  /** 流式会话代数：abort/新开流时递增，用于丢弃旧 SSE 回调 */
  private streamGeneration: number = 0;
  /**
   * SSE 流式期间的消息列表草稿：始终保存最新态，避免未 flush 时下一帧读到旧 list。
   * 对 messageList / updateMessageComponent 做短时合并，减轻主线程卡顿。
   */
  private streamListDraft: MessageInfo[] | null = null;
  private streamUiTimer: number | null = null;
  private pendingUiMessageId: string = "";
  private pendingUiMessage: MessageInfo | null = null;
  private pendingUiNeedScroll: boolean = false;
  /**
   * 流式 UI 合并窗。正文/公式路径略宽，避免 40ms 洪峰触发 Markdown+KaTeX 堵 SSE。
   *
   * 调参历史：200ms → 120ms（每秒约 5 → 8 次 flush）。200ms 时快速模型一个窗口能攒好几行
   * token 一次渲染，观感"一次多行"；120ms 削弱批次感、更接近逐字。
   *
   * 降窗 = 更频繁渲染 = 更高 GC 压力，此处可承受的依据：
   *  1) flushStreamUiPublish 有 contentUnchanged 短路——正文/think/工具态均未变直接 return，
   *     不碰 messageList，空窗零开销，仅在"有新 token"时承担整条 Markdown+KaTeX 重解析；
   *  2) SSE 解码侧 P0（appendAndProcessSSEText O(n²)→O(n)）+ P1（native TextDecoder）已落地，
   *     decode 路径不再产 GC，把预算腾给了渲染层。
   * 仍需真机验证 GC 不反弹（.diag/20260807-anr/ 对比），反弹则回退至 150~160ms。
   *
   * thinkOnly 用更长合并窗（见 THINK_UI_COALESCE_MS），且早退不 parse。
   */
  private readonly STREAM_UI_COALESCE_MS: number = 120;
  /** THINK-only 合并窗：默认折叠不渲染，仅低频同步标题栏/数据即可 */
  private readonly THINK_UI_COALESCE_MS: number = 500;
  /** 当前 streamUiTimer 使用的合并窗（正文短窗可打断 think 长窗） */
  private streamUiCoalesceMs: number = 120;
  /** 待冲刷的打字机正文（与 UI 同窗口合并，避免每 SSE 字触发父组件重绘） */
  private pendingStreamingText: string = "";
  private pendingStreamingMsgId: string = "";
  /** 待冲刷的 TTS 喂入（与 UI 同窗口合并） */
  private pendingSpeakId: string = "";
  private pendingSpeakBody: string = "";
  private pendingSpeakDirty: boolean = false;
  /** 上次已冲刷到 UI 的打字机正文（相同则跳过空刷） */
  private lastPublishedStreamText: string = "";
  private lastPublishedStreamMsgId: string = "";
  /** 上次已冲刷气泡的 processing 指纹 */
  private lastPublishedProcessingFp: string = "";
  /** 上次已冲刷的 think 长度（THINK 增量不改 body，必须单独判断） */
  private lastPublishedThinkLen: number = 0;
  /** sub 流恢复专用 StreamRequest（独立于 live chatService，避免互相 abort） */
  private subStreamRequest: StreamRequest | null = null;
  /** sub 是否已订阅（执行中） */
  private isSubscribed: boolean = false;
  /**
   * 退后台被系统掐断 live/sub 后待回前台续接。
   * 为 true 时不把本地 taskStatus 误标 COMPLETE/FAILED。
   */
  private pendingBackgroundReconnect: boolean = false;

  constructor(data: AgentDetailData) {
    this.data = data;
  }

  /** 是否有待回前台的后台断流续接 */
  get needsBackgroundReconnect(): boolean {
    return this.pendingBackgroundReconnect == true;
  }

  /** 清除后台续接标记（续接成功 / 确认已结束 / 用户停会话） */
  clearBackgroundReconnectPending(): void {
    this.pendingBackgroundReconnect = false;
  }

  /** 取得流式草稿列表（首次从 messageList 拷贝） */
  private getStreamListDraft(): MessageInfo[] {
    if (this.streamListDraft != null) {
      return this.streamListDraft as MessageInfo[];
    }
    const draft = [...this.data.messageList.value];
    this.streamListDraft = draft;
    return draft;
  }

  /**
   * 流式冲刷写入 messageList：只替换当前助手气泡，历史项沿用现有 list 引用。
   * 避免 `[...draft]` 整表换数组导致父级对所有历史气泡重算 props / 触发重绘。
   */
  private publishStreamDraftLastOnly(): void {
    if (this.streamListDraft == null) {
      return;
    }
    const draftList = this.streamListDraft as MessageInfo[];
    if (draftList.length == 0) {
      return;
    }
    const list = this.data.messageList.value;

    let targetIdx = -1;
    const pendingId = this.pendingUiMessageId;
    if (pendingId.length > 0) {
      targetIdx = findMessageIndexById(draftList, pendingId, null);
    }
    if (targetIdx < 0 && this.pendingUiMessage != null) {
      const rawId = readRawField(this.pendingUiMessage!, "id");
      const mid = rawId != null ? `${rawId}` : "";
      if (mid.length > 0) {
        targetIdx = findMessageIndexById(draftList, mid, null);
      }
    }
    if (targetIdx < 0) {
      for (let i = draftList.length - 1; i >= 0; i--) {
        if (draftList[i].messageType == MessageTypeEnum.ASSISTANT) {
          targetIdx = i;
          break;
        }
      }
    }
    if (targetIdx < 0) {
      targetIdx = draftList.length - 1;
    }

    let msgToWrite = draftList[targetIdx];
    if (this.pendingUiMessage != null) {
      msgToWrite = this.pendingUiMessage as MessageInfo;
    }

    const next: MessageInfo[] = [];
    for (let i = 0; i < draftList.length; i++) {
      if (i == targetIdx) {
        next.push(msgToWrite);
      } else if (i < list.length) {
        // 历史项：保留当前 messageList 引用，不换成 draft 里的同下标对象
        next.push(list[i]);
      } else {
        // 本轮新追加（如 user + 空助手占位）
        next.push(draftList[i]);
      }
    }
    this.data.messageList.value = next;
  }

  /** 冲刷挂起的流式 UI（messageList + 打字机 + 气泡组件 + 滚动 + TTS 喂入） */
  private flushStreamUiPublish(): void {
    if (this.streamUiTimer != null) {
      clearTimeout(this.streamUiTimer!);
      this.streamUiTimer = null;
    }

    const pendingMsg = this.pendingUiMessage;
    let processingFp = "";
    let thinkLen = 0;
    if (pendingMsg != null) {
      if (pendingMsg.processingList != null) {
        processingFp = toolCallProcessingListFingerprint(
          pendingMsg.processingList as any[],
        );
      }
      thinkLen = readMessageThink(pendingMsg).length;
    }
    const streamTextSame =
      this.pendingStreamingText == this.lastPublishedStreamText &&
      this.pendingStreamingMsgId == this.lastPublishedStreamMsgId;
    const processingSame = processingFp == this.lastPublishedProcessingFp;
    const thinkSame = thinkLen == this.lastPublishedThinkLen;
    const hasStreamPayload =
      this.pendingStreamingMsgId.length > 0 ||
      this.pendingStreamingText.length > 0;
    // 正文 / think / 工具态均未变才跳过（THINK 流不改 body，旧逻辑会把思考增量整段吞掉）
    const contentUnchanged =
      streamTextSame == true &&
      thinkSame == true &&
      (pendingMsg == null || processingSame == true);

    const thinkOnly =
      thinkSame != true &&
      streamTextSame == true &&
      (pendingMsg == null || processingSame == true);

    if (contentUnchanged == true) {
      // 仅滚动 / TTS，不碰 messageList 与气泡（避免历史消息被连带全量重解析）
      if (this.pendingUiNeedScroll == true) {
        uni.$emit("streamMessageUpdate");
      }
      if (this.pendingSpeakDirty == true) {
        const speakId = this.pendingSpeakId;
        const speakBody = this.pendingSpeakBody;
        this.pendingSpeakDirty = false;
        setTimeout(() => {
          this.safeEmitStreamSpeakFeed(speakId, speakBody, false);
        }, 0);
      }
      this.pendingUiMessage = null;
      this.pendingUiNeedScroll = false;
      return;
    }

    // THINK-only：默认折叠不渲染正文；首帧发一次抬头即可，之后只记长度，
    // 避免每 500ms 把数千字 think 经 updateMessageComponent 拷进气泡拖死主线程。
    // 完整 think 在 endStreamListDraft → publishStreamDraftLastOnly 落盘。
    if (thinkOnly == true && pendingMsg != null) {
      const isFirstThinkPublish = this.lastPublishedThinkLen == 0;
      this.lastPublishedThinkLen = thinkLen;
      if (isFirstThinkPublish == true && thinkLen > 0) {
        const thinkRaw = readMessageThink(pendingMsg);
        const emitData = {} as UTSJSONObject;
        emitData["think"] = thinkRaw;
        emitData["thinkContent"] = thinkRaw;
        // #ifdef APP
        try {
          perfRecordSseUi(
            readMessageText(pendingMsg).length,
            `msg=${this.pendingUiMessageId} think=${thinkLen} bodySame=true thinkSame=false thinkOnly=true`,
          );
        } catch (_eStall) {
          // ignore
        }
        // #endif
        uni.$emit("updateMessageComponent", {
          messageId: `${this.pendingUiMessageId}_${pendingMsg.index}`,
          data: emitData,
        });
      }
      this.pendingUiMessage = null;
      this.pendingUiNeedScroll = false;
      return;
    }

    if (this.streamListDraft != null) {
      this.publishStreamDraftLastOnly();
    }
    // 打字机通道与列表同频冲刷，避免每 token 触发 App 端整页重绘
    if (hasStreamPayload == true) {
      this.data.streamingAssistantText.value = this.pendingStreamingText;
      this.data.streamingAssistantMessageId.value = this.pendingStreamingMsgId;
      this.lastPublishedStreamText = this.pendingStreamingText;
      this.lastPublishedStreamMsgId = this.pendingStreamingMsgId;
    }
    if (pendingMsg != null) {
      this.lastPublishedProcessingFp = processingFp;
      this.lastPublishedThinkLen = thinkLen;
      const patchedText = readMessageText(pendingMsg);
      const emitData = messageToJsonObject(pendingMsg);
      emitData["body"] = handleMessageProcess(patchedText);
      // 显式带上 think，避免 Android 侧 patch 丢思考链
      const thinkRaw = readMessageThink(pendingMsg);
      if (thinkRaw.length > 0) {
        emitData["think"] = thinkRaw;
        emitData["thinkContent"] = thinkRaw;
      }
      // #ifdef APP
      try {
        perfRecordSseUi(
          patchedText.length,
          `msg=${this.pendingUiMessageId} think=${thinkLen} bodySame=${streamTextSame} thinkSame=${thinkSame}`,
        );
      } catch (_eStall) {
        // ignore
      }
      // #endif
      uni.$emit("updateMessageComponent", {
        messageId: `${this.pendingUiMessageId}_${pendingMsg.index}`,
        data: emitData,
      });
    } else if (hasStreamPayload == true) {
      // #ifdef APP
      try {
        perfRecordSseUi(
          this.pendingStreamingText.length,
          `msg=${this.pendingStreamingMsgId} think=${thinkLen}`,
        );
      } catch (_eStall) {
        // ignore
      }
      // #endif
    }
    if (this.pendingUiNeedScroll == true) {
      uni.$emit("streamMessageUpdate");
    }
    // TTS 与 UI 同窗口合并后延后一拍，避免挤占 SSE/渲染同栈
    if (this.pendingSpeakDirty == true) {
      const speakId = this.pendingSpeakId;
      const speakBody = this.pendingSpeakBody;
      this.pendingSpeakDirty = false;
      setTimeout(() => {
        this.safeEmitStreamSpeakFeed(speakId, speakBody, false);
      }, 0);
    }
    this.pendingUiMessage = null;
    this.pendingUiNeedScroll = false;
  }

  /**
   * 合并流式 UI 更新：打字机 / TTS / 列表按合并窗冲刷。
   * @param immediate true 时立刻冲刷（ERROR / 流结束 / 新发送）
   * @param thinkHeavy true 时用更长 THINK 合并窗（正文到达可打断为短窗）
   */
  private scheduleStreamUiPublish(
    messageId: string,
    message: MessageInfo | null,
    needScroll: boolean,
    immediate: boolean,
    thinkHeavy: boolean = false,
  ): void {
    if (message != null) {
      this.pendingUiMessageId = messageId;
      this.pendingUiMessage = message;
    }
    if (needScroll == true) {
      this.pendingUiNeedScroll = true;
    }
    if (immediate == true) {
      this.flushStreamUiPublish();
      return;
    }
    // 折叠态已发过 think 头：draft/pending 已持有最新 think，无需再开定时冲刷
    if (thinkHeavy == true && this.lastPublishedThinkLen > 0) {
      return;
    }
    const wantMs =
      thinkHeavy == true
        ? this.THINK_UI_COALESCE_MS
        : this.STREAM_UI_COALESCE_MS;
    if (this.streamUiTimer != null) {
      // 正文/工具等到达时，打断 think 长窗，尽快冲刷
      if (
        thinkHeavy != true &&
        this.streamUiCoalesceMs > this.STREAM_UI_COALESCE_MS
      ) {
        clearTimeout(this.streamUiTimer!);
        this.streamUiTimer = null;
        this.streamUiCoalesceMs = this.STREAM_UI_COALESCE_MS;
      } else {
        return;
      }
    } else {
      this.streamUiCoalesceMs = wantMs;
    }
    const coalesceMs = this.streamUiCoalesceMs;
    this.streamUiTimer = setTimeout(() => {
      this.streamUiTimer = null;
      this.flushStreamUiPublish();
    }, coalesceMs);
  }

  /**
   * 结束流式草稿：冲刷 UI，把 draft 落回 messageList，再丢弃草稿引用。
   * thinkOnly 冲刷只 patch 气泡、不写 messageList；若此处直接 null draft，
   * STREAM_COMPLETE 后晚到的 THINK 会从无 think 的 messageList 重建草稿，
   * 表现为 thinkLen 从上千骤降为个位数（日志里常见 think=1346 → think=1）。
   */
  private endStreamListDraft(): void {
    this.flushStreamUiPublish();
    // 落盘必须在 null 之前：只写回当前助手条，历史引用不变（与 flush 同策略）
    if (this.streamListDraft != null) {
      this.publishStreamDraftLastOnly();
      // 落盘后跟一次底，把 thinkOnly 期间节流掉的滚动补上
      uni.$emit("streamMessageUpdate");
    }
    this.streamListDraft = null;
    this.pendingUiMessage = null;
    this.pendingUiMessageId = "";
    this.pendingUiNeedScroll = false;
    this.pendingStreamingText = "";
    this.pendingStreamingMsgId = "";
    this.pendingSpeakId = "";
    this.pendingSpeakBody = "";
    this.pendingSpeakDirty = false;
    this.lastPublishedStreamText = "";
    this.lastPublishedStreamMsgId = "";
    this.lastPublishedProcessingFp = "";
    this.lastPublishedThinkLen = 0;
    this.streamUiCoalesceMs = this.STREAM_UI_COALESCE_MS;
  }

  /**
   * 外部（.uvue 审批提交）修改 messageList 干预状态后，必须同步 streamListDraft，
   * 否则下一次 flushStreamUiPublish 会用旧 draft（pending）覆盖 messageList（submitted），
   * 导致已审批卡片重复弹出。draft 保留流式 token，仅改对应 interaction 的 status。
   * 对照 nuwax PC（单 source messageList，无 draft 双缓冲）。
   */
  applyAcpPermissionStatus(
    interactionId: string,
    responseStatus: InterventionStatus,
    extras: UTSJSONObject | null,
  ): void {
    this.data.messageList.value = updateAcpPermissionInteractionStatusInMessageList(
      this.data.messageList.value,
      interactionId,
      responseStatus,
      extras,
    );
    if (this.streamListDraft != null) {
      this.streamListDraft = updateAcpPermissionInteractionStatusInMessageList(
        this.streamListDraft as MessageInfo[],
        interactionId,
        responseStatus,
        extras,
      );
    }
    // 通知会话页刷新；否则仅改 messageList 时部分端 Dock 计算属性不重算
    uni.$emit("streamMessageUpdate");
  }

  applyMcpAskStatus(
    interaction: any,
    responseStatus: InterventionStatus,
  ): void {
    this.data.messageList.value = updateMcpAskInteractionStatusInMessageList(
      this.data.messageList.value,
      interaction,
      responseStatus,
    );
    if (this.streamListDraft != null) {
      this.streamListDraft = updateMcpAskInteractionStatusInMessageList(
        this.streamListDraft as MessageInfo[],
        interaction,
        responseStatus,
      );
    }
  }

  /**
   * ACP 权限审批提交（放在 .uts 而非 .uvue）：
   * uvue script setup 内 async+try/catch 会被 UTS 截断，导致
   * 「Return statement is not allowed here」编译失败。
   *
   * @param interaction 队首 ACP interaction（Android 上为 UTSJSONObject）
   * @param selectedOptionId 选中的 optionId；取消/拒绝时也可传 reject 的 optionId
   * @param isSelected true=Selected 结果；false=Cancelled
   */
  async respondAcpPermission(
    interaction: any,
    selectedOptionId: string | null,
    isSelected: boolean,
  ): Promise<void> {
    // class 实例 → UTSJSONObject，否则 readRawField 读到空 id/tc（API toolId=""）
    const normalized = normalizeAcpPermissionInteraction(interaction);
    const interactionId = orString(readRawField(normalized, "id"), "");
    const request = readRawField(normalized, "request");
    const toolCall = readRawField(request, "toolCall");
    const toolCallId = orString(readRawField(toolCall, "toolCallId"), "");
    const sessionId = orString(readRawField(request, "sessionId"), "");
    const executeId = orString(readRawField(normalized, "executeId"), "");

    const statusExtras = new UTSJSONObject();
    if (selectedOptionId != null && selectedOptionId.length > 0) {
      statusExtras["selectedOptionId"] = selectedOptionId;
    }
    if (toolCallId.length > 0) {
      statusExtras["toolCallId"] = toolCallId;
    }
    if (executeId.length > 0) {
      statusExtras["executeId"] = executeId;
    }

    this.applyAcpPermissionStatus(interactionId, "submitting", statusExtras);

    let respondOk = false;
    let errorMsg = "";
    try {
      const selectedOutcome = new UTSJSONObject();
      if (isSelected && selectedOptionId != null) {
        const selectedBody = new UTSJSONObject();
        selectedBody["option_id"] = selectedOptionId;
        selectedOutcome["Selected"] = selectedBody;
      } else {
        selectedOutcome["Cancelled"] = null;
      }
      const permissionResponse = new UTSJSONObject();
      permissionResponse["outcome"] = selectedOutcome;
      const permissionRequest = new UTSJSONObject();
      permissionRequest["request_permission_response"] = permissionResponse;
      permissionRequest["session_id"] = sessionId;
      permissionRequest["tool_call_id"] = toolCallId;
      permissionRequest["save_rule"] = false;
      const apiParams = new UTSJSONObject();
      apiParams["interventionId"] = interactionId;
      apiParams["permission_resolve_request"] = permissionRequest;
      const convId = this.data.conversationId.value;
      if (convId != null) {
        apiParams["conversation_id"] = convId;
      }

      const resp = await apiAgentInterventionRespond(apiParams);
      const respCode = readRawField(resp, "code");
      if (resp == null || respCode == SUCCESS_CODE) {
        respondOk = true;
      } else {
        const respMessage = readRawField(resp, "message");
        const respMessageStr = respMessage != null ? `${respMessage}` : "";
        if (isIdempotentAcpPermissionResolveError(respMessageStr)) {
          respondOk = true;
        } else {
          errorMsg =
            respMessageStr.length > 0
              ? respMessageStr
              : t("Mobile.Intervention.AcpPermission.responseFailed");
        }
      }
    } catch (error) {
      const catchMsg =
        error instanceof Error
          ? error.message
          : t("Mobile.Intervention.AcpPermission.responseFailed");
      if (isIdempotentAcpPermissionResolveError(error)) {
        respondOk = true;
      } else {
        errorMsg = catchMsg;
      }
    }

    if (respondOk) {
      this.applyAcpPermissionStatus(interactionId, "submitted", statusExtras);
    } else {
      const failExtras = new UTSJSONObject();
      failExtras["errorMessage"] = errorMsg;
      if (toolCallId.length > 0) {
        failExtras["toolCallId"] = toolCallId;
      }
      if (executeId.length > 0) {
        failExtras["executeId"] = executeId;
      }
      this.applyAcpPermissionStatus(interactionId, "failed", failExtras);
      uni.showToast({ title: errorMsg, icon: "none" });
    }
  }

  /** Android：agent 接口数据统一为 UTSJSONObject，禁止 Interface 强转 */
  private toAgentJson(agent: any | null): UTSJSONObject | null {
    if (agent == null) {
      return null;
    }
    try {
      const parsed = JSON.parse(JSON.stringify(agent));
      if (parsed != null) {
        return parsed as UTSJSONObject;
      }
    } catch (_e) {
      // fallthrough
    }
    return null;
  }

  /** 读取当前 agentInfo 字段 */
  private agentField(key: string): any | null {
    const info = this.data.agentInfo.value;
    if (info == null) {
      return null;
    }
    return info[key];
  }

  /**
   * 任务执行中时，将本地 conversationInfo.taskStatus 更新为指定终态。
   * Android：conversationInfo 可能为 null / Map，禁止先 as UTSJSONObject。
   */
  private markConversationTaskStatusIfExecuting(nextStatus: TaskStatus): void {
    const stopConvInfo = this.data.conversationInfo.value;
    if (stopConvInfo == null) {
      return;
    }
    const taskStatusRaw = readRawField(stopConvInfo, "taskStatus");
    if (taskStatusRaw == null || `${taskStatusRaw}` != `${TaskStatus.EXECUTING}`) {
      return;
    }
    try {
      const jsonStr = JSON.stringify(stopConvInfo);
      if (jsonStr == null || jsonStr.length == 0 || jsonStr == "null") {
        return;
      }
      const convObj = JSON.parse(jsonStr) as UTSJSONObject | null;
      if (convObj == null) {
        return;
      }
      convObj["taskStatus"] = nextStatus;
      this.data.conversationInfo.value = convObj as any;
    } catch (_e) {
      // ignore
    }
  }

  /**
   * 任务执行中时，将本地 conversationInfo.taskStatus 标为 CANCEL。
   */
  private markConversationTaskCancelIfExecuting(): void {
    this.markConversationTaskStatusIfExecuting(TaskStatus.CANCEL);
  }

  /**
   * 流/sub 正常结束：本地 taskStatus 标 COMPLETE，关闭「任务执行中」Loading。
   * 跨端续接时 ChatFinished/详情刷新可能滞后或缺失，不能只靠 isConversationActive。
   */
  private markConversationTaskCompleteIfExecuting(): void {
    this.markConversationTaskStatusIfExecuting(TaskStatus.COMPLETE);
  }

  /**
   * 智能体切换或获取详情时同步已试用次数
   */
  syncCalledTrialCount(agent: any | null) {
    if (agent == null) return;
    const agentObj = agent as UTSJSONObject;
    const trialRaw = agentObj["trialCount"];
    const calledRaw = agentObj["calledTrialCount"];
    const agentIdRaw = agentObj["agentId"];
    const trialCount = trialRaw != null ? parseFloat(`${trialRaw}`) : 0;
    const calledTrialCount = calledRaw != null ? parseFloat(`${calledRaw}`) : 0;
    const agentIdNum = agentIdRaw != null ? parseFloat(`${agentIdRaw}`) : -1;

    // 切换至不同智能体：直接使用后端数据
    if (this.data.agentId.value != agentIdNum) {
      this.data.localCalledTrialCount.value = Math.min(calledTrialCount, trialCount);
      return;
    }

    // 同一智能体：取本地和后端的最大值，并对总数取最小值防止溢出
    const currentPrev = this.data.localCalledTrialCount.value;
    const resolved = Math.max(calledTrialCount, currentPrev);
    this.data.localCalledTrialCount.value = Math.min(resolved, trialCount);
  }

  /**
   * 处理查询会话
   */
  async handleQueryConversation(
    result: RequestResponse<ConversationInfo>,
  ): Promise<void> {
    this.data.isLoadingConversation.value = true;
    const responseDataRaw = apiResData<any>(result);
    if (responseDataRaw == null) {
      this.data.isLoadingConversation.value = false;
      return;
    }

    // Android: 通过 any 赋值跳过泛型运行时检查，避免 UTSJSONObject as ConversationInfo 异常
    this.data.conversationInfo.value = responseDataRaw as any;
    const responseObj = responseDataRaw as UTSJSONObject;
    const agentVal = this.toAgentJson(responseObj["agent"]);
    this.data.agentInfo.value = agentVal;
    if (agentVal != null) {
      this.syncCalledTrialCount(agentVal);
    }
    // 确保 agentId 被设置
    const agentIdRaw = responseObj["agentId"];
    if (agentIdRaw != null) {
      this.data.agentId.value = agentIdRaw as number;
    }
    // 确保会话ID被设置，临时会话加载历史记录同样需要该 ID
    const idRaw = responseObj["id"];
    if (idRaw != null) {
      this.data.conversationId.value = idRaw as number;
    }
    // 是否开启问题建议,可用值:Open,Close
    const agentRaw3 = responseObj["agent"];
    this.data.isSuggest.value =
      agentRaw3 != null ? (agentRaw3 as UTSJSONObject)["openSuggest"] as string == "Open" : false;
    // 可用组件列表
    let agentCompsRaw2: any | null = null;
    if (agentRaw3 != null) {
      agentCompsRaw2 = (agentRaw3 as UTSJSONObject)["manualComponents"];
    }
    const manualCompsArr: AgentManualComponentInfo[] =
      agentCompsRaw2 != null ? parseManualComponents(agentCompsRaw2) : [];
    this.data.manualComponents.value = manualCompsArr;
    // 初始化默认选中组件
    this.data.selectedComponents.value = manualCompsArr
      .filter(
        (item: AgentManualComponentInfo): boolean =>
          item.defaultSelected == DefaultSelectedEnum.Yes,
      )
      .map(
        (item: AgentManualComponentInfo): AgentSelectedComponentInfo =>
          new AgentSelectedComponentInfo(item.id, item.type),
      );
    // 如果变量参数存在,则禁用变量参数
    if (responseObj["variables"] != null) {
      this.data.isSendMessageRef.value = true;
    }
    // 变量参数（Android：保持 any[]，禁止 as BindConfigWithSub[]）
    let _variables: any[] = [];
    if (agentRaw3 != null) {
      const agentVarsRaw2 = (agentRaw3 as UTSJSONObject)["variables"];
      if (agentVarsRaw2 != null) {
        const varsArr = agentVarsRaw2 as any[];
        for (let vi = 0; vi < varsArr.length; vi++) {
          _variables.push(varsArr[vi]);
        }
      }
    }
    this.data.variables.value = _variables;
    // 用户填充变量
    const vars2 = responseObj["variables"];
    this.data.userFillVariables.value =
      vars2 != null ? AgentDetailUtils.utsObjToRecord(vars2 as UTSJSONObject) : (new Map<string, any>() as any as StringAnyRecord);
    // 消息列表（Android：UTSJSONObject[] 不能 as MessageInfo[]，通过 parseMessageList 转换）
    const rawMessageList = responseObj["messageList"];
    const _messageList = parseMessageList(rawMessageList);

    // 排除预置问题
    let msgRealCount = 0;
    for (let mi2 = 0; mi2 < _messageList.length; mi2++) {
      if (_messageList[mi2].id != null) {
        msgRealCount++;
      }
    }
    if (msgRealCount > 0) {
      const processedMessageList = _messageList.map((message: MessageInfo) => {
        const adaptedMessage = adaptHistoryMessage(message);
        let rawText = "";
        if (adaptedMessage.text != null) {
          // Android：text 可能非 String，禁止 as string
          rawText = `${adaptedMessage.text}`;
        }
        const text = handleMessageProcess(rawText);
        let id = generateUniqueId();
        if (adaptedMessage.id != null) {
          // Android：历史消息 id 常为 Integer，禁止 as string
          id = `${adaptedMessage.id}`;
        }
        adaptedMessage.text = text;
        adaptedMessage.id = id;
        return attachSpeakableTextToMessage(adaptedMessage);
      });

      this.data.autoToLastMsg.value = true;
      // 历史消息可能携带 pending 审批/提问：reconcile 后才进入可渲染队列（对齐 main）
      this.data.messageList.value =
        reconcileAcpPermissionStatusesInMessageList(processedMessageList);
      this.data.hasMoreMessages.value = msgRealCount > 0;

      // 处理问题建议
      const lastMessage = processedMessageList[msgRealCount - 1];
      const isQuestion = lastMessage.type == MessageModeEnum.QUESTION;
      const extLen = lastMessage.ext != null ? (lastMessage.ext as any[]).length : 0;
      if (isQuestion == true && extLen > 0) {
        const suggestList: any[] = [];
        const extList = lastMessage.ext as any[];
        for (let ei = 0; ei < extLen; ei++) {
          const extItem = extList[ei] as UTSJSONObject;
          const contentVal = extItem["content"];
          suggestList.push(contentVal != null ? `${contentVal}` : '');
        }
        this.data.chatSuggestList.value = suggestList;
      } else if (msgRealCount == 1) {
        const agentRaw4 = responseObj["agent"];
        if (agentRaw4 != null) {
          const agentObj2 = agentRaw4 as UTSJSONObject;
          const guidRaw = agentObj2["guidQuestionDtos"];
          if (guidRaw != null) {
            const dtos = guidRaw as UTSJSONObject[];
            const sliceLen = dtos.length < 5 ? dtos.length : 5;
            const sliced: any[] = [];
            for (let gi = 0; gi < sliceLen; gi++) {
              sliced.push(dtos[gi]);
            }
            this.data.chatSuggestList.value = sliced;
          }
        }
      }
    }
    this.data.isLoadingConversation.value = false;

    // 获取沙盒列表
    this.handleGetSandboxList();

    // 初始化当前模型ID
    const agentRaw5 = responseObj["agent"];
    if (agentRaw5 != null) {
      let modelId = 0;
      const modelIdRaw = responseObj["modelId"];
      if (modelIdRaw != null) {
        modelId = modelIdRaw as number;
      }
      if (modelId) {
        // 仅当获取到有效 modelId 时更新
        this.data.currentModelId.value = modelId;
      }
    }

    // 检查订阅限制
    const agentForSub = responseObj["agent"] as UTSJSONObject;
    if (agentForSub != null) {
      const paymentRequired = agentForSub["paymentRequired"] == true;
      const subscribed = agentForSub["subscribed"] == true;
      const overCallLimit = agentForSub["overCallLimit"] == true;

      // 是否弹出模态框：要求订阅且未订阅，或超出调用限制（已订阅时不主动弹窗）
      let shouldShowModal = false;
      if (paymentRequired == true) {
        if (subscribed == false) {
          shouldShowModal = true;
        } else if (overCallLimit == true) {
          if (subscribed == false) {
            shouldShowModal = true;
          }
        }
      }
      const subscriptionEnabled = this.data.enableSubscription.value == 1;
      if (shouldShowModal == true) {
        if (subscriptionEnabled == true) {
          this.data.subscriptionModalVisible.value = true;
        }
      }

      let shouldBlockInput = false;
      if (paymentRequired == true) {
        if (subscribed == false) {
          if (overCallLimit == true) {
            shouldBlockInput = true;
          }
        }
      }
      if (shouldBlockInput == true) {
        if (subscriptionEnabled == true) {
          this.data.subscriptionRequired.value = true;
        } else {
          this.data.subscriptionRequired.value = false;
        }
      } else {
        this.data.subscriptionRequired.value = false;
      }
    }
  }

  /**
   * 加载更多历史消息
   * 用户上滑到顶部时触发，向消息列表头部追加更多历史消息
   */
  async handleLoadMoreMessages(): Promise<void> {
    const conversationId = this.data.conversationId.value;

    // 前置校验
    if (conversationId == null) {
      return;
    }
    if (conversationId == 0) {
      return;
    }
    if (this.data.isLoadingMoreMessages.value == true) {
      return;
    }
    if (this.data.hasMoreMessages.value == false) {
      return;
    }
    if (this.data.messageList.value.length == 0) {
      return;
    }

    const firstMessage = this.data.messageList.value[0];
    let currentIndex = 0;
    if (firstMessage != null) {
      if (firstMessage.index != null) {
        currentIndex = firstMessage.index as number;
      }
    }

    // 如果 index 为 0，说明已经是最早的消息
    if (currentIndex <= 0) {
      this.data.hasMoreMessages.value = false;
      return;
    }

    this.data.isLoadingMoreMessages.value = true;

    try {
      const msgParams = new ConversationMessageListParams();
      msgParams.conversationId = conversationId;
      msgParams.index = currentIndex;
      msgParams.size = MESSAGE_LIST_SIZE;
      const res = await apiAgentConversationMessageList(msgParams);

      const codeOk = apiResCode(res) == SUCCESS_CODE;
      const dataRaw = apiResData<MessageInfo[]>(res);
      const hasData = dataRaw != null;
      if (codeOk == true) {
        if (hasData == true) {
          const olderMessages = parseMessageList(dataRaw);

          if (olderMessages.length > 0) {
            const processedMessages: MessageInfo[] = [];
            const olderLen = olderMessages.length;
            for (let oi = 0; oi < olderLen; oi++) {
              const message = olderMessages[oi];
              const adaptedMessage = adaptHistoryMessage(message);
              let rawText = "";
              if (adaptedMessage.text != null) {
                // Android：text 可能非 String，禁止 as string
                rawText = `${adaptedMessage.text}`;
              }
              const text = handleMessageProcess(rawText);
              let id = generateUniqueId();
              if (adaptedMessage.id != null) {
                // Android：历史消息 id 常为 Integer，禁止 as string
                id = `${adaptedMessage.id}`;
              }
              adaptedMessage.text = text;
              adaptedMessage.id = id;
              processedMessages.push(attachSpeakableTextToMessage(adaptedMessage));
            }

            // 前插到消息列表头部；加载更多可能引入历史 pending 审批/提问，需 reconcile
            this.data.messageList.value =
              reconcileAcpPermissionStatusesInMessageList([
                ...processedMessages,
                ...this.data.messageList.value,
              ]);

            // 判断是否还有更多消息
            this.data.hasMoreMessages.value =
              olderMessages.length >= MESSAGE_LIST_SIZE;
          } else {
            this.data.hasMoreMessages.value = false;
          }
        }
      }
    } catch (error) {
    } finally {
      this.data.isLoadingMoreMessages.value = false;
    }
  }

  /**
   * 修改消息列表
   */
  async handleChangeMessageList(
    res: any,
    currentMessageId: string,
  ): Promise<void> {
    // 添加空值检查
    if (res == null) {
      return;
    }

    const eventTypeRaw = readRawField(res, "eventType");
    const eventTypeStr = eventTypeRaw != null ? `${eventTypeRaw}` : "";

    // 忽略心跳包 (HEART_BEAT 不包含 data)
    if (eventTypeStr == "HEART_BEAT") {
      return;
    }

    // ACP Permission 权限审批事件拦截（在 data 校验 / PROCESSING 分支之前，命中即 return，不进 processingList）
    const isAcpEvt = isAcpPermissionEvent(res);
    if (isAcpEvt) {
      // #ifdef APP
      try {
        perfRecordSseEvent("ACP_PERMISSION", `msg=${currentMessageId}`);
      } catch (_eAcp) {
        // ignore
      }
      // #endif
      const interaction = extractAcpPermissionInteraction(res);
      if (interaction != null) {
        this.handleAcpPermissionEvent(interaction, currentMessageId);
      }
      return;
    }

    // MCP Ask 结构化提问事件拦截（同上，命中即 return）
    const isAskEvt = isMcpAskToolCallEvent(res);
    if (isAskEvt) {
      // #ifdef APP
      try {
        perfRecordSseEvent("MCP_ASK", `msg=${currentMessageId}`);
      } catch (_eAsk) {
        // ignore
      }
      // #endif
      const mcpInteraction = extractMcpAskInteraction(res);
      if (mcpInteraction != null) {
        this.handleMcpAskEvent(mcpInteraction, currentMessageId);
      }
      return;
    }

    const responseData = readRawField(res, "data");
    if (responseData == null) {
      if (shouldSkipSsePayloadWithoutData(res)) {
        return;
      }
      // #ifdef APP
      try {
        perfRecordSseEvent(
          eventTypeStr.length > 0 ? eventTypeStr : "UNKNOWN",
          `drop=no_data msg=${currentMessageId}`,
        );
      } catch (_eNd) {
        // ignore
      }
      // #endif
      return;
    }

    const requestIdRaw = readRawField(res, "requestId");
    const requestIdStr = requestIdRaw != null ? `${requestIdRaw}` : "";
    this.data.currentConversationRequestId.value = requestIdStr;

    if (this.data.messageList.value.length == 0) {
      // #ifdef APP
      try {
        perfRecordSseEvent(eventTypeStr, "drop=empty_messageList");
      } catch (_eEm) {
        // ignore
      }
      // #endif
      return;
    }

    const list = this.getStreamListDraft();
    const index = findMessageIndexById(
      list,
      currentMessageId,
      this.data.messageIdRef.value,
    );
    if (index < 0) {
      // #ifdef APP
      try {
        perfRecordSseEvent(
          eventTypeStr,
          `drop=msg_not_found currentId=${currentMessageId} ref=${this.data.messageIdRef.value}`,
        );
      } catch (_eIdx) {
        // ignore
      }
      // #endif
      return;
    }
    let arraySpliceAction = 1;
    const currentMessage = list[index];

    const currentTextSnapshot = readMessageText(currentMessage);
    const isNewConversation = currentTextSnapshot.length == 0;

    // 确保流式过程中消息始终可见
    if (currentMessage.status == MessageStatusEnum.Loading) {
      currentMessage.status = MessageStatusEnum.Incomplete;
    }

    let newMessage: MessageInfo | null = null;
    /** THINK 增量用更长 UI 合并窗；正文/工具到达会打断为短窗 */
    let thinkHeavyUi: boolean = false;

    // 处理不同的事件类型
    if (eventTypeStr == `${ConversationEventTypeEnum.PROCESSING}`) {
      // App：executeId/status 多在 result 内；必须提升到顶层，否则：
      // 1) 容器块只插入一次且 status 停在 EXECUTING
      // 2) processingList 无法按 executeId 匹配 FINISHED → 卡片一直显示「·」
      // OpenUI 使用独立 RENDER_UI 契约：先按最新 Web 接入结构标准化，再回退通用工具事件。
      const openUiBlockSource = normalizeRenderUiProcessingData(res, responseData);
      const blockSource = openUiBlockSource != null
        ? openUiBlockSource
        : normalizeToolCallProcessingData(responseData);
      const executeIdRaw = readRawField(blockSource, "executeId");
      const procToolTypeRaw = readRawField(blockSource, "type");
      const procToolStatusRaw = readRawField(blockSource, "status");
      // #ifdef APP
      try {
        perfRecordSseEvent(
          "PROCESSING",
          `msg=${currentMessageId} tool=${procToolTypeRaw != null ? `${procToolTypeRaw}` : ""} status=${procToolStatusRaw != null ? `${procToolStatusRaw}` : ""} execIdLen=${executeIdRaw != null ? `${executeIdRaw}`.length : 0} bodyLen=${currentTextSnapshot.length}`,
        );
      } catch (_eProc) {
        // ignore
      }
      // #endif

      const accumulatedText = getCustomBlock(
        currentTextSnapshot,
        blockSource,
      );

      let oldProcessingList: ProcessingInfo[] = [];
      if (currentMessage.processingList != null) {
        oldProcessingList = currentMessage.processingList as ProcessingInfo[];
      }

      // 按 executeId upsert，FINISHED/FAILED 覆盖 EXECUTING（对齐 PC）
      const nextProcessingList = upsertToolCallProcessingList(
        oldProcessingList as any[],
        blockSource,
      );
      const textUnchanged = accumulatedText == currentTextSnapshot;
      const processingUnchanged =
        nextProcessingList == (oldProcessingList as any[]) ||
        toolCallProcessingListFingerprint(oldProcessingList as any[]) ==
          toolCallProcessingListFingerprint(nextProcessingList);

      // 正文与工具卡展示态均无变化：跳过写消息 / 冲刷（FINISHED 重复事件会空刷 Android）
      if (textUnchanged != true || processingUnchanged != true) {
        const nmObj = messageToJsonObject(currentMessage);
        nmObj["text"] = accumulatedText;
        nmObj["status"] = MessageStatusEnum.Loading;
        if (executeIdRaw != null) {
          nmObj["executeId"] = executeIdRaw;
        }
        nmObj["processingList"] = nextProcessingList;
        newMessage = buildMessageInfoFromDraft(nmObj);
      }

      // 长任务型任务处理
      const conversationId = this.data.conversationId.value;

      // 长任务型任务处理(刷新文件树)
      const toolTypeRaw = readRawField(responseData, "type");
      if (
        `${toolTypeRaw}` == `${AgentComponentTypeEnum.ToolCall}` &&
        conversationId != null && conversationId != 0
      ) {
        CustomActionService.refreshFileList(`${conversationId}`);
      }
    }

    if (eventTypeStr == `${ConversationEventTypeEnum.MESSAGE}`) {
      const textRaw = readRawField(responseData, "text");
      let text = textRaw != null ? `${textRaw}` : "";
      // App：偶发正文在 content/delta（兼容兜底）
      if (text.length == 0) {
        const contentRaw = readRawField(responseData, "content");
        if (contentRaw != null) {
          text = `${contentRaw}`;
        }
      }
      if (text.length == 0) {
        const deltaRaw = readRawField(responseData, "delta");
        if (deltaRaw != null) {
          text = `${deltaRaw}`;
        }
      }
      const typeRaw = readRawField(responseData, "type");
      const type = typeRaw != null ? `${typeRaw}` : "";
      const extRaw = readRawField(responseData, "ext");
      const ext = extRaw != null ? (extRaw as MessageQuestionExtInfo[]) : null;
      const idRaw = readRawField(responseData, "id");
      const id = idRaw != null ? `${idRaw}` : "";
      const finishedRaw = readRawField(responseData, "finished");
      const finished = finishedRaw == true || `${finishedRaw}` == "true";
      // #ifdef APP
      try {
        const preview =
          text.length > 40 ? text.substring(0, 40).replace(/\n/g, "\\n") : text.replace(/\n/g, "\\n");
        perfRecordSseMessageChunk(text.length);
        const thinkSnap =
          type == `${MessageModeEnum.THINK}`
            ? readMessageThink(currentMessage).length + text.length
            : readMessageThink(currentMessage).length;
        perfRecordSseEvent(
          "MESSAGE",
          `msg=${currentMessageId} mode=${type} add=${text.length} bodyLen=${currentTextSnapshot.length} thinkLen=${thinkSnap} finished=${finished} dataId=${id} preview="${preview}"`,
        );
      } catch (_eMsgEvt) {
        // ignore
      }
      // #endif
      // 注意：中间段 CHAT 也可能带 finished=true（如仅下发 agent-info），
      // 不能据此结束整轮会话；整轮结束以 FINAL_RESULT / 流完成 / 用户停止为准。

      if (type == `${MessageModeEnum.THINK}`) {
        const m = cloneMessageInfoDraft(currentMessage);
        m["think"] = `${readMessageThink(currentMessage)}${text}`;
        m["status"] = MessageStatusEnum.Incomplete;
        newMessage = buildMessageInfoFromDraft(m);
        thinkHeavyUi = true;
      } else if (type == `${MessageModeEnum.QUESTION}`) {
        // 问题内容累积 - 新对话时从头开始，否则累积
        const accumulatedText = handleMessageProcess(
          isNewConversation ? text : `${currentTextSnapshot}${text}`,
        );
        const m = cloneMessageInfoDraft(currentMessage);
        m["text"] = accumulatedText;
        m["status"] = finished
          ? MessageStatusEnum.Complete
          : MessageStatusEnum.Incomplete;
        newMessage = buildMessageInfoFromDraft(m);

        if (ext != null && ext.length > 0) {
          const extSuggestList: any[] = [];
          for (let ei2 = 0; ei2 < ext.length; ei2++) {
            const eiItem = ext[ei2] as MessageQuestionExtInfo;
            extSuggestList.push(eiItem.content);
          }
          this.data.chatSuggestList.value = extSuggestList;
        }
      } else {
        // 工作流过程输出
        if (
          this.data.messageIdRef.value != null &&
          this.data.messageIdRef.value.length > 0 &&
          this.data.messageIdRef.value != id &&
          finished
        ) {
          const accumulatedText = handleMessageProcess(
            isNewConversation ? text : `${currentTextSnapshot}${text}`,
          );
          const m = cloneMessageInfoDraft(currentMessage);
          m["id"] = id;
          m["text"] = accumulatedText;
          attachSpeakableTextToDraft(m, accumulatedText);

          // 当前仍是未完成/占位泡：视为同一条回填服务端 id，原地替换，禁止 insert 双气泡
          const openBubble =
            currentMessage.status == MessageStatusEnum.Loading ||
            currentMessage.status == MessageStatusEnum.Incomplete ||
            currentTextSnapshot.length == 0;
          if (openBubble == true) {
            m["status"] = MessageStatusEnum.Incomplete;
            newMessage = buildMessageInfoFromDraft(m);
            arraySpliceAction = 1;
            const prevMsgRef = `${this.data.messageIdRef.value}`;
            this.data.messageIdRef.value = id;
            const streamId = this.data.streamingAssistantMessageId.value;
            if (
              streamId == currentMessageId ||
              streamId == prevMsgRef ||
              streamId.length == 0
            ) {
              this.data.streamingAssistantMessageId.value = id;
            }
          } else {
            m["status"] = MessageStatusEnum.Complete;
            newMessage = buildMessageInfoFromDraft(m);
            arraySpliceAction = 0;
          }
        } else {
          this.data.messageIdRef.value = id;
          // 新对话时从头开始，否则累积
          const accumulatedText = handleMessageProcess(
            isNewConversation ? text : `${currentTextSnapshot}${text}`,
          );
          // #ifdef APP
          try {
            sseStallLog(
              "sse_msg",
              `add=${text.length} bodyLen=${accumulatedText.length} delta=${accumulatedText.length - currentTextSnapshot.length}`,
            );
            if (text.length > 0 && accumulatedText.length == currentTextSnapshot.length) {
              console.warn(
                `[SseEvent] WARN msg_no_grow add=${text.length} bodyLen=${accumulatedText.length} (增量未写入气泡)`,
              );
            }
          } catch (_eMsg) {
            // ignore
          }
          // #endif

          const m = cloneMessageInfoDraft(currentMessage);
          m["text"] = accumulatedText;
          // 中间段 CHAT 也可能带 finished=true，不能标 Complete：
          // 否则 iOS 软断流后 recover 会因「已 Complete」跳过，气泡停在半截字。
          m["status"] = MessageStatusEnum.Incomplete;
          newMessage = buildMessageInfoFromDraft(m);
        }
      }
    }

    if (eventTypeStr == `${ConversationEventTypeEnum.FINAL_RESULT}`) {
      // #ifdef APP
      try {
        perfRecordSseEvent(
          "FINAL_RESULT",
          `msg=${currentMessageId} bodyLen=${currentTextSnapshot.length}`,
        );
      } catch (_eFr) {
        // ignore
      }
      // #endif
      const m = cloneMessageInfoDraft(currentMessage);
      m["status"] = MessageStatusEnum.Complete;
      m["finalResult"] = responseData;
      m["requestId"] = requestIdStr;
      const finalText = readMessageText(currentMessage);
      if (finalText.length > 0) {
        attachSpeakableTextToDraft(m, finalText);
      }
      newMessage = buildMessageInfoFromDraft(m);
      this.data.requestId.value = requestIdStr;
      // 终态事件先落本地 COMPLETE，避免跨端续接结束后 Loading 仍转（详情刷新可能滞后）
      this.markConversationTaskCompleteIfExecuting();
    }

    if (eventTypeStr == `${ConversationEventTypeEnum.ERROR}`) {
      // #ifdef APP
      try {
        perfRecordSseEvent("ERROR", `msg=${currentMessageId}`);
      } catch (_eErr) {
        // ignore
      }
      // #endif
      const m = cloneMessageInfoDraft(currentMessage);
      m["status"] = "error";
      newMessage = buildMessageInfoFromDraft(m);
      this.data.isConversationActive.value = false;
      this.markConversationTaskStatusIfExecuting(TaskStatus.FAILED);
    }

    // 更新消息列表草稿
    if (newMessage != null) {
      list.splice(index, arraySpliceAction, newMessage);
    }

    // 打字机 / TTS 先写入 pending，与 scheduleStreamUiPublish 同窗口冲刷。
    // 禁止 TTS 同步异常打断后续 scheduleStreamUiPublish（否则会出现「有 SSE 无渲染」）。
    if (newMessage != null) {
      const patchedText = readMessageText(newMessage);
      if (
        isAssistantMessageInfo(newMessage) == true &&
        patchedText.length > 0
      ) {
        // 固定为客户端气泡 id（currentMessageId），避免服务端改写 id 导致播报会话被 begin 重置
        this.pendingStreamingText = patchedText;
        this.pendingStreamingMsgId = currentMessageId;
        this.pendingSpeakId = currentMessageId;
        this.pendingSpeakBody = patchedText;
        this.pendingSpeakDirty = true;
      }
    }

    const needScroll = this.data.autoToLastMsg.value;
    const isErrorEvent = eventTypeStr == `${ConversationEventTypeEnum.ERROR}`;
    const uiMessage =
      newMessage != null && isAssistantMessageInfo(newMessage) == true
        ? newMessage
        : null;
    // 无实质消息变更时不排程冲刷（否则 autoToLastMsg 会让空 PROCESSING 每秒 [...list]）
    if (uiMessage != null || isErrorEvent == true) {
      this.scheduleStreamUiPublish(
        currentMessageId,
        uiMessage,
        needScroll,
        isErrorEvent,
        thinkHeavyUi,
      );
    }

    // 打开页面首页（与气泡更新解耦，保持即时）
    if (newMessage != null && isAssistantMessageInfo(newMessage) == true) {
      const pageStatusRaw = readRawField(responseData, "status");
      const pageTypeRaw = readRawField(responseData, "type");
      if (
        `${pageStatusRaw}` == `${ProcessingEnum.EXECUTING}` &&
        `${pageTypeRaw}` == "Page"
      ) {
        uni.$emit("page_preview_executing", responseData);
      }
    }
  }

  /**
   * ACP 权限审批事件：把 interaction 挂载到目标消息的 acpPermissionInteractions。
   * 走 messageToJsonObject draft 模式（Android Gson 对 class 直接设字段不可靠），
   * 写回后统一 reconcile，并 $emit 触发 UI 刷新。
   */
  handleAcpPermissionEvent(
    interaction: AcpPermissionInteraction,
    currentMessageId: string,
  ): void {
    const list = this.getStreamListDraft();
    const index = findMessageIndexById(
      list,
      currentMessageId,
      this.data.messageIdRef.value,
    );
    if (index < 0) {
      return;
    }
    const currentMessage = list[index];

    // 去重：live SSE 与 sub/PROCESSING 重放可能对「同一权限」生成不同 id。
    // 除同 id 外，还需按非空 toolCallId / executeId 判重，否则 FIFO 会出现两张审批卡，
    // 用户批掉一张后另一条仍 pending，继续双路抑制 MCP Ask（表现为 Ask 永远不展示）。
    // 先规范为 UTSJSONObject，再读字段 / 挂载（禁止直接塞 class 实例）
    const stored = normalizeAcpPermissionInteraction(interaction);
    const newReq = readRawField(stored, "request");
    const newTc = readRawField(newReq, "toolCall");
    const newTcId = orString(readRawField(newTc, "toolCallId"), "");
    const newExecuteId = orString(readRawField(stored, "executeId"), "");
    const newId = orString(readRawField(stored, "id"), "");

    for (let mi = 0; mi < list.length; mi++) {
      const msgInteractions = readRawField(list[mi], "acpPermissionInteractions");
      const msgArr = msgInteractions != null ? (msgInteractions as any[]) : [];
      for (let ii = 0; ii < msgArr.length; ii++) {
        const exist = msgArr[ii];
        const existId = orString(readRawField(exist, "id"), "");
        if (existId.length > 0 && existId == newId) {
          return;
        }
        const existReq = readRawField(exist, "request");
        const existTc = readRawField(existReq, "toolCall");
        const existTcId = orString(readRawField(existTc, "toolCallId"), "");
        if (newTcId.length > 0 && existTcId.length > 0 && existTcId == newTcId) {
          // 新事件若带更完整的后端 intervention id，覆盖旧条目 id，便于 respond 命中真实 id
          const existServerLike =
            existId.length > 0 && !existId.startsWith("itv_");
          const newServerLike = newId.length > 0 && !newId.startsWith("itv_");
          if (newServerLike && !existServerLike) {
            const patched = JSON.parse(JSON.stringify(exist)) as UTSJSONObject;
            patched["id"] = newId;
            if (newExecuteId.length > 0) {
              patched["executeId"] = newExecuteId;
            }
            msgArr[ii] = patched;
            const msgObj = messageToJsonObject(list[mi]);
            msgObj["acpPermissionInteractions"] = msgArr;
            const rebuilt = buildMessageInfoFromDraft(msgObj);
            if (rebuilt != null) {
              list.splice(mi, 1, rebuilt);
              this.data.messageList.value =
                reconcileAcpPermissionStatusesInMessageList([...list]);
              this.streamListDraft = [...this.data.messageList.value];
              uni.$emit("streamMessageUpdate");
            }
            return;
          }
          return;
        }
        const existExecuteId = orString(readRawField(exist, "executeId"), "");
        if (
          newExecuteId.length > 0 &&
          existExecuteId.length > 0 &&
          existExecuteId == newExecuteId
        ) {
          return;
        }
      }
    }

    const existingRaw = readRawField(currentMessage, "acpPermissionInteractions");
    const existing = existingRaw != null ? (existingRaw as any[]) : [];
    const nextInteractions = ([] as any[]).concat(existing);
    nextInteractions.push(stored);

    const nmObj = messageToJsonObject(currentMessage);
    nmObj["acpPermissionInteractions"] = nextInteractions;
    const newMessage = buildMessageInfoFromDraft(nmObj);
    if (newMessage == null) {
      return;
    }
    list.splice(index, 1, newMessage);

    this.data.messageList.value =
      reconcileAcpPermissionStatusesInMessageList([...list]);
    this.streamListDraft = [...this.data.messageList.value];
    uni.$emit("streamMessageUpdate");
  }

  /**
   * MCP Ask 结构化提问事件：把 interaction 挂载到目标消息的 mcpAskInteractions。
   * 按 requestId 去重，高 revision 覆盖低 revision。
   */
  handleMcpAskEvent(
    interaction: McpAskInteraction,
    currentMessageId: string,
  ): void {
    const list = this.getStreamListDraft();
    const index = findMessageIndexById(
      list,
      currentMessageId,
      this.data.messageIdRef.value,
    );
    if (index < 0) {
      return;
    }
    const currentMessage = list[index];

    const existingRaw = readRawField(currentMessage, "mcpAskInteractions");
    const existing = existingRaw != null ? (existingRaw as any[]) : [];
    const nextInteractions = ([] as any[]).concat(existing);

    // 跨消息去重：同一 requestId 已被挂载（live 与 sub 重放）时直接覆盖到既有位置，
    // 避免同一提问卡出现在两条消息里。先收集全列表中该 requestId 的最高 revision。
    let existIndex = -1;
    let globalMaxRev = 0;
    for (let mi = 0; mi < list.length; mi++) {
      const msgInteractions = readRawField(list[mi], "mcpAskInteractions");
      const msgArr = msgInteractions != null ? (msgInteractions as any[]) : [];
      for (let ii = 0; ii < msgArr.length; ii++) {
        const rid = readRawField(msgArr[ii], "requestId");
        if (rid != null && `${rid}` == interaction.requestId) {
          const rev = readRawField(msgArr[ii], "revision");
          const revNum = rev != null ? parseFloat(`${rev}`) : 1;
          if (revNum > globalMaxRev) globalMaxRev = revNum;
        }
      }
    }
    for (let i = 0; i < nextInteractions.length; i++) {
      const rid = readRawField(nextInteractions[i], "requestId");
      if (rid != null && `${rid}` == interaction.requestId) {
        existIndex = i;
        break;
      }
    }

    const newRev = interaction.revision != null ? interaction.revision! : 1;
    if (existIndex >= 0) {
      const existItem = nextInteractions[existIndex] as McpAskInteraction;
      const existRev = existItem.revision != null ? existItem.revision! : 1;
      if (newRev > existRev) {
        nextInteractions[existIndex] = interaction;
      } else {
        return;
      }
    } else if (globalMaxRev > 0 && newRev <= globalMaxRev) {
      // 已在别的消息挂载且 revision 不更高：丢弃，避免重复卡片
      return;
    } else {
      nextInteractions.push(interaction);
    }

    const nmObj = messageToJsonObject(currentMessage);
    nmObj["mcpAskInteractions"] = nextInteractions;
    const newMessage = buildMessageInfoFromDraft(nmObj);
    if (newMessage == null) {
      return;
    }
    list.splice(index, 1, newMessage);

    this.data.messageList.value =
      reconcileAcpPermissionStatusesInMessageList([...list]);
    this.streamListDraft = [...this.data.messageList.value];
    uni.$emit("streamMessageUpdate");
  }

  // 获取文件树列表
  async fetchFileList(cId: number): Promise<void> {
    try {
      this.data.isLoadingFiles.value = true;
      const result = await apiGetStaticFileList(cId);
      this.data.isLoadingFiles.value = false;
      const responseCode = apiResCode(result);
      if (responseCode == SUCCESS_CODE) {
        let files: any[] = [];
        const dataRaw = apiResData<any>(result);
        if (dataRaw != null) {
          const rdFiles = dataRaw as UTSJSONObject;
          const filesVal = rdFiles["files"];
          if (filesVal != null) {
            files = filesVal as any[];
          }
        }

        let treeData: FileNode[] = [];

        // 检查是否是新的扁平格式
        if (files.length > 0) {
          const firstFileRaw = files[0];
          const firstFile =
            firstFileRaw != null
              ? firstFileRaw as UTSJSONObject
              : new UTSJSONObject();
          const firstNameVal = firstFile["name"];
          if (firstNameVal != null && `${firstNameVal}`.length > 0) {
            treeData = transformFlatListToTree(files);
          } else {
            treeData = files as FileNode[];
          }
        } else {
          treeData = files as FileNode[];
        }

        this.data.fileList.value = treeData;
      }
    } catch (error) {
    } finally {
      this.data.isLoadingFiles.value = false;
    }
  }

  /**
   * 会话处理
   */
  async handleConversation(
    params: ConversationChatParams | TempConversationChatParams,
    currentMessageId: string,
    // 是否是临时会话
    isTempChat: boolean = false,
    onTimeout : NullableTimeoutCallback,
  ): Promise<void> {
    try {
      // 清空问题建议列表
      this.data.chatSuggestList.value = [];
      // 只清正文，保留本轮助手气泡 id，供发送手势内立刻 begin 流式播报
      this.data.streamingAssistantText.value = "";
      this.data.streamingAssistantMessageId.value = currentMessageId;

      // 标记是否已经更新过主题，确保只更新一次
      let hasUpdatedTopic = false;
      // 本轮流代数；abort / 新开流后旧回调直接丢弃
      this.streamGeneration = this.streamGeneration + 1;
      this.pendingBackgroundReconnect = false;
      this.endStreamListDraft();
      const streamGen = this.streamGeneration;
      // #ifdef APP
      try {
        perfResetSseEventCounters();
        perfRecordSseEvent(
          "STREAM_START",
          `msg=${currentMessageId} gen=${streamGen} temp=${isTempChat}`,
        );
      } catch (_eStart) {
        // ignore
      }
      // #endif

      // ===== 性能测试 Mock（默认关）=====
      // isStreamPerfMockEnabled 由 pages/test-stream-perf 启动页写 storage 打开。
      // 开启时用 startMockStream 把 Mock 正文按 chunk 喂给 handleChangeMessageList
      // （draft→coalesce→flush→render 全程不变，仅数据源换成可控 Mock，排除网络抖动），
      // 跳过真实 chatService.sendMessage。测完 clearStreamPerfMock() 即恢复正常。
      if (isStreamPerfMockEnabled()) {
        const mockCfg = getStreamPerfConfig();
        const mockOnChunk = (chunk: string): void => {
          if (streamGen != this.streamGeneration) {
            return;
          }
          try {
            perfRecordSseMessageChunk(chunk.length);
            const resultObj = JSON.parse(chunk);
            if (resultObj != null) {
              this.handleChangeMessageList(resultObj, currentMessageId);
            }
          } catch (_eMockChunk) {
            // ignore
          }
        };
        const mockOnComplete = (): void => {
          if (streamGen != this.streamGeneration) {
            return;
          }
          // #ifdef APP
          try {
            perfRecordSseEvent(
              "STREAM_COMPLETE",
              `msg=${currentMessageId} gen=${streamGen} mock=1`,
            );
          } catch (_eMockDone) {
            // ignore
          }
          // #endif
          this.endStreamListDraft();
          this.handleStreamComplete(params, isTempChat);
        };
        await startMockStream(
          mockOnChunk,
          mockOnComplete,
          mockCfg.mdType,
          mockCfg.streamLen,
          mockCfg.intervalMs,
          mockCfg.chunk,
        );
        return;
      }
      await chatService.sendMessage(
        params,
        // 处理流式数据
        (chunk: string) => {
          if (streamGen != this.streamGeneration) {
            // #ifdef APP
            try {
              console.warn(
                `[SseEvent] drop=stale_gen chunkLen=${chunk.length} gen=${streamGen} cur=${this.streamGeneration}`,
              );
            } catch (_eGen) {
              // ignore
            }
            // #endif
            return;
          }
          try {
            const result = JSON.parse(chunk);
            const resultObj = result;
            if (resultObj == null) {
              return;
            }
            // [临时诊断] 抓 ASK_QUESTION 原始载荷：PROCESSING 或含 AskQuestion/subEventType 一律打全量 JSON。
            // 干预事件（ACP 权限/ASK_QUESTION）字段常在 _intervention/result.data，
            // 顶层 data 可能为 null；须先放行给事件识别，再判缺 data 丢弃。
            const isInterventionChunk =
              isAcpPermissionEvent(resultObj) || isMcpAskToolCallEvent(resultObj);
            if (readRawField(resultObj, "data") == null && !isInterventionChunk) {
              if (shouldSkipSsePayloadWithoutData(resultObj)) {
                return;
              }
              // #ifdef APP
              try {
                const etRaw = readRawField(resultObj, "eventType");
                perfRecordSseEvent(
                  etRaw != null ? `${etRaw}` : "UNKNOWN",
                  `drop=chunk_no_data chunkLen=${chunk.length}`,
                );
              } catch (_eCd) {
                // ignore
              }
              // #endif
              return;
            }

            // 流式数据开始时，第一次收到数据时更新主题（只执行一次）
            const convInfo = this.data.conversationInfo.value;
            let topicUpdated = 0;
            if (convInfo != null) {
              const tuVal = readRawField(convInfo, "topicUpdated");
              if (tuVal != null) {
                topicUpdated = tuVal as number;
              }
            }
            if (
              !hasUpdatedTopic &&
              !isTempChat &&
              this.data.needUpdateTopicRef.value &&
              topicUpdated != 1 // 只有未更新过才会执行，避免重复修改标题
            ) {
              hasUpdatedTopic = true;
              const convIdRaw = readRawField(params, "conversationId");
              const messageRaw = readRawField(params, "message");
              const convIdStr = convIdRaw != null ? `${convIdRaw}` : "";
              const messageStr = messageRaw != null ? `${messageRaw}` : "";
              if (convIdStr.length > 0 && messageStr.length > 0) {
                this.handleUpdateTopic(convIdStr, messageStr);
              }
            }

            this.handleChangeMessageList(resultObj, currentMessageId);
          } catch (error) {
            console.error(
              "[SSE-Stream] 解析 SSE 数据失败:",
              error,
              "原始数据长度:",
              chunk?.length,
              "前100字符:",
              chunk?.substring(0, 100),
            );
          }
        },
        // 完成回调
        () => {
          if (streamGen != this.streamGeneration) {
            return;
          }
          // #ifdef APP
          try {
            perfRecordSseEvent(
              "STREAM_COMPLETE",
              `msg=${currentMessageId} gen=${streamGen}`,
            );
          } catch (_eDone) {
            // ignore
          }
          // #endif
          // 同步落盘 draft→messageList，再进 async 完成态。
          // UTS/JS 对 async 的调度可能导致 MESSAGE 晚于 STREAM_COMPLETE 才入队；
          // 若等 handleStreamComplete 才 endStream，thinkOnly 未写回的 think 会被丢掉。
          this.endStreamListDraft();
          this.handleStreamComplete(params, isTempChat);
        },
        // 错误回调
        (error: any) => {
          if (streamGen != this.streamGeneration) {
            return;
          }
          console.error(
            "[AgentDetailService] Chat stream error callback:",
            error,
          );
          this.finalizeStreamAbnormally(isTempChat, streamGen, onTimeout);
        },
        isTempChat,
        // 超时 / 连接异常关闭回调（H5 onClose、App 无 SSE 终态的 HTTP complete）
        () => {
          if (streamGen != this.streamGeneration) {
            return;
          }
          console.warn("[SSE-Stream] stream abnormal close / timeout");
          this.finalizeStreamAbnormally(isTempChat, streamGen, onTimeout);
        },
      );
    } catch (error) {
      console.error("[AgentDetailService] Chat handling failed:", error);
    }
  }

  /**
   * 性能测试：seed 预置 Mock 历史消息（仅 isStreamPerfMockEnabled 且 messageList 为空时生效，只 seed 一次）。
   * 由页面 onLoad 在 perfTest 模式调用，复刻长历史会话场景。
   */
  seedMockHistoryIfNeeded(): void {
    if (!isStreamPerfMockEnabled()) {
      return;
    }
    if (this.data.messageList.value.length > 0) {
      return;
    }
    const cfg = getStreamPerfConfig();
    if (cfg.history <= 0) {
      return;
    }
    this.data.messageList.value = buildMockMessageList(cfg.history, cfg.mdType);
    // 重置流式草稿，使其下次从新 messageList 重建
    this.streamListDraft = null;
    try {
      perfRecordSseEvent(
        "PERF_SEED_HISTORY",
        `history=${cfg.history} mdType=${cfg.mdType}`,
      );
    } catch (_e) {
      // ignore
    }
  }

  /**
   * 性能测试：自动发起一轮 Mock 流式（无需手动发送、无需 conversationId）。
   * 复刻 handleSendMessage 的消息构造（用户条 + 助手 Loading 占位 + 旧 Incomplete→Complete），
   * 然后直接喂 Mock chunk 给 handleChangeMessageList（draft→coalesce→flush→render 全程不变）。
   * 由页面 onLoad perfTest 分支调用 —— 用户在启动页点「开始测试」即自动流式，无需再发消息。
   * 终态走最小收尾（不走 handleStreamComplete，避免持久化/网络）。
   */
  async runMockPerfStream(): Promise<void> {
    if (!isStreamPerfMockEnabled()) {
      return;
    }
    const cfg = getStreamPerfConfig();
    // L<=0：纯历史场景，不流式 —— 不建占位气泡、不置 isConversationActive，
    // 对齐真实历史加载（接口批量返回、无 active stream）。
    if (cfg.streamLen <= 0) {
      return;
    }
    const chatMessageId = generateUniqueId();
    const currentMessageId = generateUniqueId();
    // 重置流代数 + 草稿 + 打字机通道
    this.streamGeneration = this.streamGeneration + 1;
    this.endStreamListDraft();
    this.clearStreamingAssistantText();
    this.data.chatSuggestList.value = [] as any[];

    const nowIso = new Date().toISOString();
    const chatMessage: UTSJSONObject = {
      role: AssistantRoleEnum.USER,
      type: MessageModeEnum.CHAT,
      text: "(perf test)",
      time: nowIso,
      id: chatMessageId,
      messageType: MessageTypeEnum.USER,
    };
    const currentMessage: UTSJSONObject = {
      role: AssistantRoleEnum.ASSISTANT,
      type: MessageModeEnum.CHAT,
      text: "",
      think: "",
      time: nowIso,
      id: currentMessageId,
      messageType: MessageTypeEnum.ASSISTANT,
      status: MessageStatusEnum.Loading,
    };

    const prev =
      this.data.messageList.value != null
        ? this.data.messageList.value
        : ([] as MessageInfo[]);
    const newMessageList: MessageInfo[] = [];
    for (let i = 0; i < prev.length; i++) {
      const it = prev[i];
      if (it.status == MessageStatusEnum.Incomplete) {
        it.status = MessageStatusEnum.Complete;
      }
      newMessageList.push(it);
    }
    const chatMsgInfo = createMessageInfoFromAny(chatMessage);
    const currentMsgInfo = createMessageInfoFromAny(currentMessage);
    if (chatMsgInfo != null) {
      newMessageList.push(chatMsgInfo);
    }
    if (currentMsgInfo != null) {
      newMessageList.push(currentMsgInfo);
    }
    this.data.messageIdRef.value = "";
    this.data.currentConversationRequestId.value = "";
    this.data.isConversationActive.value = true;
    this.data.messageList.value = newMessageList;
    this.data.streamingAssistantMessageId.value = currentMessageId;
    this.data.streamingAssistantText.value = "";

    const streamGen = this.streamGeneration;
    const mockOnChunk = (chunk: string): void => {
      if (streamGen != this.streamGeneration) {
        return;
      }
      try {
        perfRecordSseMessageChunk(chunk.length);
        const resultObj = JSON.parse(chunk);
        if (resultObj != null) {
          this.handleChangeMessageList(resultObj, currentMessageId);
        }
      } catch (_eMockChunk) {
        // ignore
      }
    };
    const mockOnComplete = (): void => {
      if (streamGen != this.streamGeneration) {
        return;
      }
      // #ifdef APP
      try {
        perfRecordSseEvent(
          "STREAM_COMPLETE",
          `msg=${currentMessageId} gen=${streamGen} mock=1`,
        );
      } catch (_eMockDone) {
        // ignore
      }
      // #endif
      this.endStreamListDraft();
      // 最小终态：Loading/Incomplete→Complete + 关闭会话激活（不走 handleStreamComplete，避免持久化/网络）
      const list = this.data.messageList.value;
      const next: MessageInfo[] = [];
      for (let j = 0; j < list.length; j++) {
        const m = list[j];
        if (
          m.status == MessageStatusEnum.Incomplete ||
          m.status == MessageStatusEnum.Loading
        ) {
          m.status = MessageStatusEnum.Complete;
        }
        next.push(m);
      }
      this.data.messageList.value = next;
      this.data.isConversationActive.value = false;
      this.clearStreamingAssistantText();
    };
    await startMockStream(
      mockOnChunk,
      mockOnComplete,
      cfg.mdType,
      cfg.streamLen,
      cfg.intervalMs,
      cfg.chunk,
    );
  }

  /**
   * 清空 App 流式打字机通道，避免上一轮正文串到新助手气泡。
   */
  private clearStreamingAssistantText(): void {
    this.pendingStreamingText = "";
    this.pendingStreamingMsgId = "";
    this.pendingSpeakId = "";
    this.pendingSpeakBody = "";
    this.pendingSpeakDirty = false;
    this.data.streamingAssistantText.value = "";
    this.data.streamingAssistantMessageId.value = "";
  }

  /**
   * 安全触发流式播报：TTS 侧任何异常不得冒泡到 SSE / UI 路径。
   */
  private safeEmitStreamSpeakFeed(
    messageId: string,
    bodyText: string,
    finished: boolean,
  ): void {
    try {
      uni.$emit("streamSpeakFeed", {
        messageId: messageId,
        bodyText: bodyText,
        finished: finished,
      });
    } catch (eSpeak) {
      console.warn("[AgentDetailService] streamSpeakFeed ignored (TTS must not break SSE)", eSpeak);
    }
  }

  /**
   * 断流 / 出错清打字机前：把 streamingAssistantText 落回 messageList，
   * 否则 App 渲染优先通道被清空后气泡会空白（正文只在 typewriter 里）。
   */
  private sealStreamingAssistantBeforeClear(): void {
    const speakMsgId = this.data.streamingAssistantMessageId.value;
    const speakBody = this.data.streamingAssistantText.value;
    try {
      if (speakBody.length > 0) {
        this.persistLastAssistantSpeakableText(speakBody);
        this.safeEmitStreamSpeakFeed(speakMsgId, speakBody, true);
      } else {
        this.persistLastAssistantSpeakableText("");
      }
    } catch (eSeal) {
      console.warn("[AgentDetailService] sealStreamingAssistant ignored", eSeal);
    }
  }

  /**
   * 流式异常收尾：冲刷草稿 → 落盘打字机正文 → 清通道 → 强制会话终态（触发全量 KaTeX）→ 回补。
   * Android 进后台杀 SSE 时：静默软收尾 + pendingBackgroundReconnect，不标本地 COMPLETE，
   * 等回前台 / scheduleRecover 用 sub 续流。
   */
  private finalizeStreamAbnormally(
    isTempChat: boolean,
    streamGen: number,
    onTimeout: NullableTimeoutCallback,
  ): void {
    this.endStreamListDraft();
    this.sealStreamingAssistantBeforeClear();
    this.clearStreamingAssistantText();

    const fromBackground = isAppInBackground() == true;
    if (fromBackground == true) {
      this.pendingBackgroundReconnect = true;
      // 保持「生成中」，便于回前台续接；不调 onTimeout（避免按钮态立刻变空闲）
      console.warn(
        "[SSE-Stream] soft finalize while background, pending reconnect gen=" +
          `${streamGen}`,
      );
      this.scheduleRecoverIfAssistantLoading(isTempChat, streamGen);
      return;
    }

    // 与正常 complete 对齐：延后 inactive，让 ai-msg 走 fallback_full + KaTeX 终态刷图
    const genAtAbnormal = this.streamGeneration;
    setTimeout(() => {
      if (genAtAbnormal != this.streamGeneration) {
        return;
      }
      this.data.isConversationActive.value = false;
      this.markConversationTaskCompleteIfExecuting();
    }, 150);
    this.scheduleRecoverIfAssistantLoading(isTempChat, streamGen);
    if (onTimeout != null) {
      (onTimeout as () => void)();
    }
  }

  /**
   * 将本轮最终可播报文写入最后一条助手消息的 speakableText。
   */
  private persistLastAssistantSpeakableText(preferBody: string): void {
    try {
      const list = this.data.messageList.value;
      if (list.length == 0) {
        return;
      }
      const last = list[list.length - 1];
      if (last == null || last.messageType != MessageTypeEnum.ASSISTANT) {
        return;
      }
      const body = preferBody.length > 0 ? preferBody : readMessageText(last);
      if (body.length == 0) {
        return;
      }
      const draft = messageToJsonObject(last);
      if (preferBody.length > 0) {
        draft["text"] = preferBody;
      }
      attachSpeakableTextToDraft(draft, body);
      const updated = buildMessageInfoFromDraft(draft);
      if (updated == null) {
        return;
      }
      const next: MessageInfo[] = [];
      for (let i = 0; i < list.length - 1; i++) {
        next.push(list[i]);
      }
      next.push(updated);
      this.data.messageList.value = next;
    } catch (ePersist) {
      console.warn(
        "[AgentDetailService] persistSpeakableText ignored (must not break SSE/UI)",
        ePersist,
      );
    }
  }

  /**
   * 流式会话完成处理（从 handleConversation 的完成回调中抽取，便于使用 async/await）
   */
  async handleStreamComplete(
    params: ConversationChatParams | TempConversationChatParams,
    isTempChat: boolean,
  ): Promise<void> {
    // 正常结束：清后台续接标记
    this.pendingBackgroundReconnect = false;
    // 完成回调里已同步 endStreamListDraft；此处再调一次幂等兜底（异常入口/竞态）
    this.endStreamListDraft();

    // 冲刷尾句：必须在 clearStreaming / inactive 之前，携带最终正文
    const speakMsgId = this.data.streamingAssistantMessageId.value;
    let speakBody = this.data.streamingAssistantText.value;
    if (speakBody.length == 0) {
      const list = this.data.messageList.value;
      if (list.length > 0) {
        const last = list[list.length - 1];
        if (
          last != null &&
          last.messageType == MessageTypeEnum.ASSISTANT
        ) {
          speakBody = readMessageText(last);
        }
      }
    }
    if (speakMsgId.length > 0 || speakBody.length > 0) {
      this.safeEmitStreamSpeakFeed(speakMsgId, speakBody, true);
    }
    // 会话结束：把最终可播报文写入消息字段，供工具栏直接播放
    this.persistLastAssistantSpeakableText(speakBody);
    // 延后 inactive：Android 上 success 扫尾 / 队列尾包可能在 onComplete 后仍派发 MESSAGE；
    // 若立刻 active=false，ai-msg 会 fallback_full 连扫堵死主线程（日志 fallback_full_reason）。
    const genAtComplete = this.streamGeneration;
    setTimeout(() => {
      if (genAtComplete != this.streamGeneration) {
        return;
      }
      this.data.isConversationActive.value = false;
      this.markConversationTaskCompleteIfExecuting();
      this.clearStreamingAssistantText();
    }, 150);

    // RENDER_UI 完成结果可能只在会话详情落库，live SSE 仅收到 EXECUTING。
    // 仅当最后一条消息仍有未决 OpenUI 时回补，避免所有普通会话额外请求。
    await this.hydrateCompletedOpenUiIfNeeded(isTempChat);

    // 如果不是临时会话,则处理问题建议，临时会话，不需要处理问题建议
    if (!isTempChat) {
      if (this.data.isSuggest.value) {
        const suggestParams = buildConversationChatSuggestParams(params);
        const responseData = await apiAgentConversationChatSuggest(suggestParams);
        // 更新问题建议列表
        const rd = responseData != null ? responseData.data : null;
        this.data.chatSuggestList.value = rd != null ? (rd as any[]) : [];
      }
    }
    // 会话完成后根据消息列表中的最后一条消息 判断是否存在 <task-result> 标签
    const lastMessage =
      this.data.messageList.value[this.data.messageList.value.length - 1];

    const lastText = lastMessage.text != null ? lastMessage.text : "";
    const taskResult = extractTaskResult(lastText);
    if (taskResult.hasTaskResult && taskResult.file != null && taskResult.file.length > 0) {
      try {
        const conversationId = this.data.conversationId.value;
        if (conversationId != null) {
          const cidStr = `${conversationId}`;
            const fileProxyUrl =
              await getFileProxyUrlByConversationIdAndFilePath(
                cidStr,
                taskResult.file,
              );
            if (fileProxyUrl != null) {
              jumpToFilePreviewPage(cidStr, fileProxyUrl);
            }
          }
      } catch (error) {
        console.error(
          "[AgentDetailService] Failed to parse <task-result> from last message:",
          error,
        );
      }
    }
    // 正常 onComplete 不做 recover；异常断流由 finalize → 详情回补，EXECUTING 由页面轮询开 sub
  }

  /** 用历史详情链路回补已完成但 live SSE 未携带 ref 的 OpenUI。 */
  private async hydrateCompletedOpenUiIfNeeded(isTempChat: boolean): Promise<void> {
    if (isTempChat) {
      return;
    }
    const conversationId = this.data.conversationId.value;
    if (conversationId == null || conversationId == 0) {
      return;
    }
    // RENDER_UI ref 由后端异步落库，实测可能晚于正文流结束数秒。
    const delays = [250, 750, 1500, 3000, 6000] as number[];
    for (let i = 0; i < delays.length; i++) {
      const currentList = this.data.messageList.value;
      const currentOpenUiMessage = findLatestOpenUiMessage(currentList);
      if (!hasUnresolvedOpenUi(currentOpenUiMessage)) {
        return;
      }
      await waitForOpenUiHydrate(delays[i]);
      // 用户已发起下一轮时，禁止旧完成回调覆盖新消息。
      if (this.data.isConversationActive.value || chatService.isCurrentlyStreaming) {
        return;
      }
      try {
        const res = await apiAgentConversation(conversationId);
        if (apiResCode(res) == SUCCESS_CODE) {
          await this.handleQueryConversation(res);
        }
      } catch (_e) {
        // 下一轮重试；最终失败时保留“界面生成中”，不阻断正常聊天完成流程。
      }
    }
  }

  /**
   * App：流异常中断后拉一次会话详情补终态；
   * 若后端仍为 EXECUTING，立刻开 sub 续流（不等页面轮询，避免「第一句后卡住、结束才整段出来」）。
   */
  private scheduleRecoverIfAssistantLoading(
    isTempChat: boolean,
    streamGenAtSchedule: number,
  ): void {
    // #ifdef APP
    if (isTempChat == true) {
      return;
    }
    let needRecover = false;
    const listForRecover = this.data.messageList.value;
    if (listForRecover.length > 0) {
      const lastForRecover = listForRecover[listForRecover.length - 1];
      if (
        lastForRecover != null &&
        lastForRecover.messageType == MessageTypeEnum.ASSISTANT
      ) {
        const status = lastForRecover.status;
        const textLen = readMessageText(lastForRecover).trim().length;
        const noFinal = lastForRecover.finalResult == null;
        if (
          noFinal == true &&
          (status == MessageStatusEnum.Loading ||
            status == MessageStatusEnum.Incomplete ||
            textLen == 0)
        ) {
          needRecover = true;
        }
      }
    }
    if (needRecover != true && this.pendingBackgroundReconnect != true) {
      return;
    }
    setTimeout(() => {
      if (streamGenAtSchedule != this.streamGeneration) {
        return;
      }
      // 已由 live/sub 接管则无需再拉
      if (this.isSubscribed == true || chatService.isCurrentlyStreaming) {
        return;
      }
      this.resumeConversationState().then((needSub: boolean) => {
        if (needSub != true) {
          // 后端已结束：清 pending，避免前台反复空转
          this.pendingBackgroundReconnect = false;
          return;
        }
        if (streamGenAtSchedule != this.streamGeneration) {
          return;
        }
        if (this.isSubscribed == true || chatService.isCurrentlyStreaming) {
          return;
        }
        const cid = this.data.conversationId.value;
        if (cid == null || cid == 0) {
          return;
        }
        this.handleSubConversation(cid, null);
      });
    }, 400);
    // #endif
  }

  /**
   * 订阅 sub 流恢复 EXECUTING 会话的流式输出（刷新/重进/断流回补/跨端续接）。
   *
   * 四端（H5 / iOS / Android / 微信小程序）同一路径：
   * 1) reload 会话详情 → 2) subResumeGate 确认本轮用户已在列表 →
   * 3) ensurePlaceholder（复用进行中助手或新建）→ 4) GET /chat/sub →
   * 5) handleChangeMessageList 写 UI + streamSpeakFeed（TTS）
   *
   * onSubClose: sub 关闭（完成/错误/超时）时回调，页面据此恢复轮询。
   */
  async handleSubConversation(
    conversationId: number,
    onSubClose: any | null = null,
  ): Promise<void> {
    // 防重 / live SSE 在跑时不订阅
    if (this.isSubscribed) {
      return;
    }
    if (chatService.isCurrentlyStreaming) {
      return;
    }

    // 先中断旧 sub，再标记订阅（abort 会置 isSubscribed=false，必须在标记前）
    this.abortSubConversation();
    this.isSubscribed = true;
    // 已接管续流：清 pending；若随后在后台再被掐断，softCleanup 会再置位
    this.pendingBackgroundReconnect = false;

    // 可变：复用历史助手时会改成已有 id
    let targetMessageId = generateUniqueId();
    let hasBoundTarget = false;
    /** 仅当新建了空占位时，cleanup 才允许删掉空泡 */
    let createdNewPlaceholder = false;

    const removeEmptyPlaceholder = (): void => {
      if (!createdNewPlaceholder) {
        return;
      }
      const list = this.data.messageList.value;
      const next: MessageInfo[] = [];
      for (let i = 0; i < list.length; i++) {
        const message = list[i];
        if (message == null) {
          continue;
        }
        const textEmpty =
          message.text == null || `${message.text}`.length == 0;
        const thinkEmpty =
          message.think == null || `${message.think}`.length == 0;
        const processingEmpty =
          message.processingList == null ||
          (message.processingList as any[]).length == 0;
        const noFinal = message.finalResult == null;
        if (
          message.id == targetMessageId &&
          textEmpty &&
          thinkEmpty &&
          processingEmpty &&
          noFinal
        ) {
          continue;
        }
        next.push(message);
      }
      this.data.messageList.value = next;
    };

    let isCleanedUp = false;
    const cleanupSub = (): void => {
      if (isCleanedUp) {
        return;
      }
      isCleanedUp = true;
      this.endStreamListDraft();
      if (this.subStreamRequest != null) {
        this.subStreamRequest!.abort();
        this.subStreamRequest = null;
      }
      this.isSubscribed = false;
      // 与 live SSE 完成对齐：先冲刷 TTS 终态，再关会话态（否则播报图标卡住）
      this.sealStreamingAssistantBeforeClear();
      this.data.isConversationActive.value = false;
      this.clearStreamingAssistantText();
      removeEmptyPlaceholder();
      if (onSubClose != null) {
        (onSubClose as () => void)();
      }
    };

    /** 后台被系统掐断 sub：清订阅、保留 pending，不标 FAILED / 不关生成中 */
    const softCleanupSubWhileBackground = (): void => {
      if (isCleanedUp) {
        return;
      }
      isCleanedUp = true;
      this.endStreamListDraft();
      if (this.subStreamRequest != null) {
        this.subStreamRequest!.abort();
        this.subStreamRequest = null;
      }
      this.isSubscribed = false;
      this.pendingBackgroundReconnect = true;
      console.warn(
        "[SSE-Sub] soft cleanup while background, pending reconnect",
      );
      if (onSubClose != null) {
        (onSubClose as () => void)();
      }
    };

    // 1. reload 历史（拿最新 messageList）
    try {
      const result = await apiAgentConversation(conversationId);
      if (apiResCode(result) != SUCCESS_CODE) {
        cleanupSub();
        return;
      }
      const dataRaw = apiResData<any>(result);
      if (dataRaw == null) {
        cleanupSub();
        return;
      }
      const dataObj = dataRaw as UTSJSONObject;
      const taskStatusRaw = dataObj["taskStatus"];
      const taskStatusStr =
        taskStatusRaw != null ? `${taskStatusRaw}` : "";
      // 轮询与详情之间任务可能已结束；此时不可再建立 sub 或插入占位
      if (taskStatusStr != `${TaskStatus.EXECUTING}`) {
        // 仍刷新一次列表，避免界面停在半截字
        await this.handleQueryConversation(result);
        cleanupSub();
        return;
      }
      const rawMessageList = dataObj["messageList"];
      const parsedList = parseMessageList(rawMessageList);
      if (parsedList.length > 0) {
        const processed: MessageInfo[] = [];
        for (let mi = 0; mi < parsedList.length; mi++) {
          const message = parsedList[mi];
          const adaptedMessage = adaptHistoryMessage(message);
          let rawText = "";
          if (adaptedMessage.text != null) {
            rawText = `${adaptedMessage.text}`;
          }
          const text = handleMessageProcess(rawText);
          let id = generateUniqueId();
          if (adaptedMessage.id != null) {
            id = `${adaptedMessage.id}`;
          }
          adaptedMessage.text = text;
          adaptedMessage.id = id;
          processed.push(attachSpeakableTextToMessage(adaptedMessage));
        }
        // sub 重载的历史可能携带 pending 审批/提问：reconcile 后才进入可渲染队列（对齐 main）
        this.data.messageList.value =
          reconcileAcpPermissionStatusesInMessageList(processed);
      }

      // 与轮询门禁共用 subResumeGate：本轮用户未进列表则不开 sub（四端一致）
      if (
        isTurnUserReadyFromMessageInfoList(this.data.messageList.value) !=
        true
      ) {
        cleanupSub();
        return;
      }

      this.data.isConversationActive.value = true;
    } catch (error) {
      console.error(
        "[AgentDetailService] handleSubConversation reload failed:",
        error,
      );
      cleanupSub();
      return;
    }

    /**
     * 绑定 sub 写入目标（四端同一套规则）：
     * - 最后一条是本轮进行中助手，且前一条是 USER → 复用（清空后按 delta 重放）
     * - 最后一条是用户 / 空 / 已完成助手 → 新建占位
     * - 禁止复用上轮 Complete/finished 助手（无 finalResult 也不能当软完成清空）
     */
    const ensurePlaceholder = (): void => {
      if (hasBoundTarget) {
        return;
      }
      hasBoundTarget = true;
      const list = this.data.messageList.value;
      if (list.length > 0) {
        const last = list[list.length - 1];
        const prev = list.length >= 2 ? list[list.length - 2] : null;
        const canReuse = canReuseAssistantOnSubResume(last, prev) == true;
        if (canReuse == true && last != null) {
          let reuseId = targetMessageId;
          if (last.id != null && `${last.id}`.length > 0) {
            reuseId = `${last.id}`;
          }
          targetMessageId = reuseId;
          // 清空后按空泡重放：sub 的 MESSAGE 是 delta，叠在已有全文上会糊字
          const draft = messageToJsonObject(last);
          draft["text"] = "";
          draft["think"] = "";
          draft["status"] = MessageStatusEnum.Loading;
          draft["finalResult"] = null;
          draft["finished"] = false;
          const resetMsg = createMessageInfoFromAny(draft);
          if (resetMsg != null) {
            const next: MessageInfo[] = [];
            for (let i = 0; i < list.length - 1; i++) {
              next.push(list[i]);
            }
            next.push(resetMsg);
            this.data.messageList.value = next;
          }
          this.data.messageIdRef.value = targetMessageId;
          this.data.streamingAssistantMessageId.value = targetMessageId;
          this.data.streamingAssistantText.value = "";
          return;
        }
      }

      createdNewPlaceholder = true;
      const placeholderObj: UTSJSONObject = {
        role: AssistantRoleEnum.ASSISTANT,
        type: MessageModeEnum.CHAT,
        text: "",
        think: "",
        time: new Date().toISOString(),
        id: targetMessageId,
        messageType: MessageTypeEnum.ASSISTANT,
        status: MessageStatusEnum.Loading,
      };
      const placeholder = createMessageInfoFromAny(placeholderObj);
      if (placeholder == null) {
        return;
      }
      const next: MessageInfo[] = [];
      for (let i = 0; i < list.length; i++) {
        next.push(list[i]);
      }
      next.push(placeholder);
      this.data.messageList.value = next;
      this.data.messageIdRef.value = targetMessageId;
      this.data.streamingAssistantMessageId.value = targetMessageId;
      this.data.streamingAssistantText.value = "";
    };

    // 3. 订阅 sub（GET SSE）—— 四端同一 URL / 同一 handleChangeMessageList 写 UI+TTS
    const token = uni.getStorageSync(ACCESS_TOKEN);
    const header = new UTSJSONObject(API_HEADERS as UTSJSONObject);
    // H5 / 小程序 / App 统一带 Bearer（与 live SSE 一致；H5 生产环境有 cookie 时多带也不影响）
    if (token != null && `${token}`.length > 0) {
      header["Authorization"] = `Bearer ${token}`;
    }

    this.subStreamRequest = new StreamRequest();
    const requestConfig = new StreamRequestConfig();
    requestConfig.url = `${getApiBaseUrl()}/api/agent/conversation/chat/sub/${conversationId}`;
    requestConfig.method = "GET";
    requestConfig.headers = header;
    requestConfig.onChunk = (chunk: StreamChunk) => {
      if (chunk.type != "content") {
        return;
      }
      try {
        const result = JSON.parse(chunk.data);
        if (result == null) {
          return;
        }
        const resultObj = result;
        // 干预事件字段常在 _intervention/result.data，顶层 data 可能为 null；先放行给事件识别
        const isInterventionChunk =
          isAcpPermissionEvent(resultObj) || isMcpAskToolCallEvent(resultObj);
        if (readRawField(resultObj, "data") == null && !isInterventionChunk) {
          if (shouldSkipSsePayloadWithoutData(resultObj)) {
            return;
          }
          return;
        }
        ensurePlaceholder();
        this.handleChangeMessageList(resultObj, targetMessageId);
        const eventTypeRaw = readRawField(resultObj, "eventType");
        const eventTypeStr =
          eventTypeRaw != null ? `${eventTypeRaw}` : "";
        if (eventTypeStr == `${ConversationEventTypeEnum.ERROR}`) {
          cleanupSub();
        }
      } catch (e) {
      }
    };
    requestConfig.onComplete = () => {
      // sub SSE 正常结束：立刻关掉 Loading（不等 ChatFinished / 详情回拉）
      this.pendingBackgroundReconnect = false;
      this.markConversationTaskCompleteIfExecuting();
      cleanupSub();
    };
    requestConfig.onError = (error: any) => {
      if (isAppInBackground() == true) {
        softCleanupSubWhileBackground();
        return;
      }
      this.pendingBackgroundReconnect = false;
      this.markConversationTaskStatusIfExecuting(TaskStatus.FAILED);
      cleanupSub();
    };
    requestConfig.onTimeout = () => {
      if (isAppInBackground() == true) {
        softCleanupSubWhileBackground();
        return;
      }
      this.pendingBackgroundReconnect = false;
      this.markConversationTaskStatusIfExecuting(TaskStatus.FAILED);
      cleanupSub();
    };

    try {
      await this.subStreamRequest!.request(requestConfig);
    } catch (error) {
      if (isAppInBackground() == true && isCleanedUp != true) {
        softCleanupSubWhileBackground();
      } else {
        cleanupSub();
      }
    }
  }

  /**
   * 中断 sub 流恢复连接
   */
  abortSubConversation(): void {
    if (this.subStreamRequest != null) {
      this.subStreamRequest!.abort();
      this.subStreamRequest = null;
    }
    this.isSubscribed = false;
  }

  /** sub 是否已订阅（执行中） */
  get isSubConversationSubscribed(): boolean {
    return this.isSubscribed;
  }

  /**
   * 停止会话
   * @param isTempChat 是否是临时会话
   */
  async handleStopConversation(isTempChat: boolean = false): Promise<void> {
    // 停止会话后，清空问题建议列表（对齐 PC handleClearSideEffect：停止即清空，防止旧建议残留）
    this.data.chatSuggestList.value = [];

    // 用户主动停止：取消后台续接
    this.pendingBackgroundReconnect = false;

    // 无论 UI 是否已标为结束，都先中止本地 SSE / sub，避免 chunk 回调继续跑
    this.streamGeneration = this.streamGeneration + 1;
    this.endStreamListDraft();
    chatService.abort();
    this.abortSubConversation();

    // 如果会话已经不活跃，说明会话已经结束，无需调用 stop 接口
    if (!this.data.isConversationActive.value) {
      this.clearStreamingAssistantText();
      this.data.isStoppingConversation.value = false;
      return;
    }

    // 如果普通会话，并且任务正在执行，则更新任务状态为 CANCEL
    this.markConversationTaskCancelIfExecuting();

    // 先结束会话态：保留 messageList 正文并触发 Markdown 终态渲染；
    // 再清打字机通道。停止只掐断 SSE/播报，不抹掉已输出内容。
    const stopSpeakBody = this.data.streamingAssistantText.value;
    this.persistLastAssistantSpeakableText(stopSpeakBody);
    this.data.isConversationActive.value = false;
    this.clearStreamingAssistantText();

    // 会话消息请求ID
    const requestId = this.data.currentConversationRequestId.value;

    // 对于临时会话，必须要有 requestId 才能停止
    if (isTempChat && (requestId == null || requestId.length == 0)) {
      this.data.isStoppingConversation.value = false;
      return;
    }

    // 对于普通会话，即使没有 requestId 也可以通过 conversationId 停止
    // 显示停止会话loading
    this.data.isStoppingConversation.value = true;
    let res: RequestResponse<any> | null = null;
    try {
      if (isTempChat) {
        res = await apiTempChatConversationStop(requestId);
      } else {
        res = await apiAgentConversationChatStop(
          `${this.data.conversationId.value}`,
        );
      }
      const code = res != null ? apiResCode(res) : null;
      const message = res != null ? apiResMessage(res) : "";
      this.data.isStoppingConversation.value = false;
      // 停止会话失败时提示
      if (code != SUCCESS_CODE) {
        uni.showToast({
          title: message != null ? message : "",
          icon: "none",
        });
      }
    } catch (error) {
      this.data.isStoppingConversation.value = false;
    }
  }

  /**
   * 将正在执行的工具调用状态更新为失败
   * 用于超时或异常中断时的状态更新
   */
  updateProcessingListToFailed(): void {

    const messageList = this.data.messageList.value;
    if (messageList == null || messageList.length == 0) {
      return;
    }

    // 查找正在处理中的消息（状态为 Loading 或 Incomplete）
    const updatedMessages = messageList.map((message: MessageInfo): MessageInfo => {
      // 只处理正在进行中的助手消息
      if (
        (message.status == MessageStatusEnum.Loading ||
          message.status == MessageStatusEnum.Incomplete) &&
        message.processingList != null &&
        message.processingList.length > 0
      ) {

        // 更新 processingList 中的状态
        const procList = message.processingList as ProcessingInfo[];
        const updatedProcessingList = procList.map(
          (processing: ProcessingInfo): ProcessingInfo => {
            // 将所有 EXECUTING 状态的工具调用改为 FAILED（兼容 status 在 result 内）
            const pObj = normalizeToolCallProcessingData(processing);
            const statusRaw = readRawField(pObj, "status");
            const statusStr = statusRaw != null ? `${statusRaw}` : "";
            if (statusStr == `${ProcessingEnum.EXECUTING}`) {
              pObj["status"] = ProcessingEnum.FAILED;
              return pObj as ProcessingInfo;
            }
            return processing;
          },
        );

        // 返回更新后的消息
        const mObj = JSON.parse(JSON.stringify(message)) as UTSJSONObject;
        mObj["processingList"] = updatedProcessingList;
        return mObj as MessageInfo;
      }

      return message;
    });

    // 更新消息列表
    this.data.messageList.value = updatedMessages;
  }

  /**
   * 获取沙盒列表 (严格模式 - 移动端重构 Phase 9)
   */
  async handleGetSandboxList(useAgentSelected: boolean = true): Promise<void> {
    if (this.data.isTempChat.value) return;
    try {
      const res = await apiGetSandboxList();

      const sandboxDataRaw = apiResData<any>(res);
      if (apiResCode(res) == SUCCESS_CODE && sandboxDataRaw != null) {
        const sandboxDataObj = sandboxDataRaw as UTSJSONObject;
        const sandboxesRaw = sandboxDataObj["sandboxes"];
        const agentSelectedRaw = sandboxDataObj["agentSelected"];
        const sandboxes = parseSandboxList(sandboxesRaw);
        const agentSelected = parseAgentSelectedSandbox(agentSelectedRaw);
        this.data.sandboxList.value = sandboxes;
        this.data.agentSelectedSandbox.value = useAgentSelected
          ? agentSelected
          : new UTSJSONObject();

        const sandboxList = this.data.sandboxList.value;
        const conversationInfo = this.data.conversationInfo.value;
        const agentInfo = this.data.agentInfo.value;
        // 优先使用 data.agentId，其次使用 agentInfo.agentId
        let agentId = "";
        if (this.data.agentId.value != null) {
          agentId = `${this.data.agentId.value}`;
        } else if (agentInfo != null) {
          const idRaw = agentInfo["agentId"];
          if (idRaw != null) {
            agentId = `${idRaw}`;
          }
        }

        // 2.1 权限判断 (UI层已处理置灰，这里主要处理状态)
        if (agentInfo != null && agentInfo["hasPermission"] == false) {
          this.data.isSandboxSwitchDisabled.value = true;
          // this.data.wholeDisabled.value = true;
          // 提示语由UI层 maskText 控制，或者在这里设置 disabledText?
          // 根据需求描述 "置灰对话框，提示：您无该智能体权限"
          // 查看 chat-input-phone 组件，maskText 可能是 prop，但这里好像没有直接控制 maskText 的变量？
          // 假设 UI 层 `chat-input-phone` 的 `has-permission` 属性已经控制了提示。
          // 我们主要确保 switch disabled
          return;
        }

        // 2.2.1 个人电脑 (Priority 1)
        const sandboxIdRaw = agentInfo != null ? agentInfo["sandboxId"] : null;
        const sandboxIdStr = sandboxIdRaw != null ? `${sandboxIdRaw}` : "";
        if (sandboxIdStr.length > 0) {
          const personalSandboxId = sandboxIdStr;
          const exists = sandboxListContains(
            sandboxList,
            personalSandboxId,
          );

          if (!exists) {
            // 2.2.1.1 不在列表中 -> 展示“个人电脑不可用”
            this.data.currentSandboxId.value = personalSandboxId; // 或者是空？通常显示名字需要ID匹配，或者UI显示"不可用"
            this.data.isSandboxSwitchDisabled.value = true;
            this.data.isSandboxUnavailable.value = true;
            this.data.sandboxDisabledText.value = t(
              "Mobile.Sandbox.unavailable",
            );
            // this.data.wholeDisabled.value = true;
          } else {
            // 2.2.1.2 在列表中 -> 展示对应的电脑名称且不可切换
            this.data.currentSandboxId.value = personalSandboxId;
            this.data.isSandboxSwitchDisabled.value = true;
            this.data.isSandboxUnavailable.value = false;
            this.data.sandboxDisabledText.value = "";
            // this.data.wholeDisabled.value = false;
          }
          return;
        }

        // 2.2.2 电脑列表为空 (Priority 2)
        if (sandboxList.length == 0) {
          this.data.currentSandboxId.value = "";
          this.data.isSandboxSwitchDisabled.value = true;
          this.data.isSandboxUnavailable.value = true;
          this.data.sandboxDisabledText.value = t(
            "Mobile.Sandbox.noneAvailable",
          );
          // this.data.wholeDisabled.value = true;
          return;
        }

        // 2.2.3 共享电脑 (Priority 3)
        let sharedSandboxId = "";
        if (conversationInfo != null) {
          const convObj = conversationInfo as UTSJSONObject;
          const serverIdRaw = convObj["sandboxServerId"];
          if (serverIdRaw != null) {
            sharedSandboxId = `${serverIdRaw}`;
          }
        }
        if (sharedSandboxId.length > 0) {
          const exists = sandboxListContains(
            sandboxList,
            sharedSandboxId,
          );

          if (!exists) {
            // 2.2.3.1 不在列表中 -> 展示“电脑不可用”
            this.data.currentSandboxId.value = sharedSandboxId;
            this.data.isSandboxSwitchDisabled.value = true;
            this.data.isSandboxUnavailable.value = true;
            this.data.sandboxDisabledText.value = t(
              "Mobile.Sandbox.unavailable",
            );
            // this.data.wholeDisabled.value = true;
          } else {
            // 2.2.3.2 在列表中 -> 展示对应的电脑名称且不可切换
            this.data.currentSandboxId.value = sharedSandboxId;
            this.data.isSandboxSwitchDisabled.value = true;
            this.data.isSandboxUnavailable.value = false;
            this.data.sandboxDisabledText.value = "";
            // this.data.wholeDisabled.value = false;
          }
          return;
        }

        // 2.2.4 默认选择 (Priority 4)
        // conversationInfo?.sandboxServerId 和 conversationInfo?.agent?.sandboxId 都为空
        this.data.isSandboxSwitchDisabled.value = false;
        this.data.isSandboxUnavailable.value = false;
        this.data.sandboxDisabledText.value = "";
        // this.data.wholeDisabled.value = false;

        let initialId = "";
        const selectedMap = this.data.agentSelectedSandbox.value as UTSJSONObject;
        const selectedId = selectedMap[agentId];
        if (selectedId != null) {
          const idStr = `${selectedId}`;
          if (idStr.length > 0) {
            // agentSelected 优先
            initialId = idStr;
            // 校验是否存在，不存在默认第一个
            if (!sandboxListContains(sandboxList, initialId)) {
              initialId = sandboxList[0].sandboxId;
            }
          } else {
            // 默认第一个
            initialId = sandboxList[0].sandboxId;
          }
        } else {
          // 默认第一个
          initialId = sandboxList[0].sandboxId;
        }
        this.data.currentSandboxId.value = initialId;
      }
    } catch (error) {
      console.error("[AgentDetailService] 获取沙盒列表失败:", error, `${error}`);
    }
  }

  /**
   * 切换沙盒
   */
  async handleSelectSandbox(sandboxId: string): Promise<void> {
    // 如果禁止切换，直接返回
    if (this.data.isSandboxSwitchDisabled.value) {
      return;
    }

    let agentId = "";
    if (this.data.agentId.value != null) {
      agentId = `${this.data.agentId.value}`;
    } else {
      const idRaw = this.agentField("agentId");
      if (idRaw != null) {
        agentId = `${idRaw}`;
      }
    }

    try {
      // 调用 API 更新选中记录
      await apiUpdateSelectedSandbox(agentId, sandboxId);

      // 更新本地状态
      this.data.currentSandboxId.value = sandboxId;
      const selectedMap = this.data.agentSelectedSandbox.value as UTSJSONObject;
      selectedMap[agentId] = sandboxId;
      this.data.agentSelectedSandbox.value = selectedMap;
    } catch (error) {
      console.error("[AgentDetailService] 切换沙盒失败:", error);
      uni.showToast({
        title: t("Mobile.Sandbox.switchFailed"),
        icon: "none",
      });
    }
  }

  /**
   * 切换模型
   */
  handleSelectModel(modelId: number, modelName: string = ""): void {
    this.data.currentModelId.value = modelId;
    if (modelName.length > 0) {
      this.data.currentModelName.value = modelName;
    }
    this.data.modelSelectVisible.value = false;
  }

  /**
   * 检测并恢复会话状态（回前台 / 断流回补）。
   *
   * 返回 true：后端仍为 EXECUTING，调用方应订阅 sub。
   * 覆盖：
   * - 本端 SSE 异常中断
   * - 其它端（如 Android）在同会话发了消息，本端（如 iOS）需续接
   *
   * @returns 是否需要订阅 sub（后端 EXECUTING）
   */
  async resumeConversationState(): Promise<boolean> {
    // 1. 检查会话ID
    const conversationId = this.data.conversationId.value;
    if ((conversationId == null || conversationId == 0) || this.data.isTempChat.value) {
      return false;
    }

    // 2. 用户正在主动停止 / 本地 live 或 sub 已在跑 → 不抢
    if (this.data.isStoppingConversation.value) {
      return false;
    }
    if (chatService.isCurrentlyStreaming || this.isSubscribed) {
      return false;
    }

    try {
      // 3. 始终拉一次详情：跨端时本地气泡可能已是 Complete，不能只靠「异常中断」判断
      const res = await apiAgentConversation(conversationId);
      if (apiResCode(res) != SUCCESS_CODE) {
        return false;
      }
      const convData = apiResData<ConversationInfo>(res);
      const convObj = convData != null ? (convData as UTSJSONObject) : null;
      let taskStatusStr = "";
      if (convObj != null) {
        const taskStatusRaw = convObj["taskStatus"];
        if (taskStatusRaw != null) {
          // App：可能是字符串或带 value 的对象
          try {
            const nested = (taskStatusRaw as UTSJSONObject)["value"];
            if (nested != null) {
              taskStatusStr = `${nested}`;
            } else {
              taskStatusStr = `${taskStatusRaw}`;
            }
          } catch (_e) {
            taskStatusStr = `${taskStatusRaw}`;
          }
        }
      }

      // 刷新消息列表（其它端新消息 / 半截字终态）
      await this.handleQueryConversation(res);

      if (taskStatusStr == `${TaskStatus.EXECUTING}`) {
        this.data.isConversationActive.value = true;
        return true;
      }
      this.pendingBackgroundReconnect = false;
      this.data.isConversationActive.value = false;
      return false;
    } catch (error) {
      console.error("[SessionResume] 恢复会话状态失败:", error);
      this.data.isConversationActive.value = false;
      return false;
    }
  }

  async handleSendMessage(
    data: HandleSendMessageData | any,
    isTempChat: boolean = false,
    onTimeout: NullableTimeoutCallback = null,
  ): Promise<void> {
    const dataObj = AgentDetailUtils.toSendMessageParamsObject(data);
    const messageInfo = dataObj["messageInfo"] as string | null;
    const files = dataObj["files"];
    const selectedComponents = dataObj["selectedComponents"];
    const variableParams = dataObj["variableParams"];
    // 安全检查：确保this.data存在
    if (this.data == null) {
      return;
    }

    // 与 dev 一致：发送开始即清空问题建议（早于组消息 / 发起 SSE）
    this.data.chatSuggestList.value = [] as any[];

    // 清空用户自带的url参数，只在第一次发送消息时使用，后续发送消息时不再使用
    this.data.urlOtherParams.value = null;

    const attachments: UTSJSONObject[] = [];
    if (files != null) {
      const filesArr = files as UTSJSONObject[];
      for (let i = 0; i < filesArr.length; i++) {
        const file = filesArr[i] as UTSJSONObject;
        const attObj: UTSJSONObject = {
          "fileKey": file["key"] as string | null ?? "",
          "fileUrl": file["url"] as string | null ?? "",
          "fileName": file["name"] as string | null ?? "",
          "mimeType": file["type"] as string | null ?? "",
          "fileSize": file["size"] as number | null ?? 0,
        };
        attachments.push(attObj);
      }
    }

    // 参数验证：消息文本为空且附件为空时不发送
    let hasMessage = false;
    if (messageInfo != null) {
      const trimmed = (messageInfo as string).trim();
      if (trimmed.length > 0) {
        hasMessage = true;
      }
    }
    if (hasMessage == false) {
      if (attachments.length == 0) {
        return;
      }
    }

    // 是否是临时会话
    if (isTempChat) {
      // 链接Key 或 会话唯一标识为空
      if (this.data.chatKey.value == null || this.data.chatKey.value.length == 0) {
        uni.showToast({
          title: t("Mobile.Conversation.chatKeyRequired"),
          icon: "none",
        });
        return;
      }
    } else {
      if (this.data.conversationId.value == null || this.data.conversationId.value == 0) {
        uni.showToast({
          title: t("Mobile.Conversation.idRequired"),
          icon: "none",
        });
        return;
      }
    }

    // 发送新消息前：打断上一条流式/工具栏/队列播报（H5 + App 统一）
    stopAllSpeechPlayback();
    uni.$emit("streamSpeakInterrupt", {});

    // #ifdef WEB || H5
    // 如果不是临时会话页面，并且url中不包含conversationId，则修改url
    if (!isTempChat && !location.href.includes("conversationId")) {
      let newUrl = "";

      // 如果是应用详情页，则跳转至应用详情页
      if (location.href.includes("app-details")) {
        newUrl = `/subpackages/pages/app-details/app-details?id=${this.data.agentId.value}&conversationId=${this.data.conversationId.value}`;
      } else {
        newUrl = `/subpackages/pages/agent-detail/agent-detail?id=${this.data.agentId.value}&conversationId=${this.data.conversationId.value}`;
      }

      // 修改url参数且不刷新页面
      const url = new URL(location.href);
      url.hash = newUrl; // 修改参数
      history.replaceState(null, "", url.toString()); // 替换当前历史记录
    }
    // #endif

    // 使用同步方法生成唯一ID（兼容所有平台）
    const chatMessageId = generateUniqueId();
    const currentMessageId = generateUniqueId();

    // 先掐断上一轮 SSE / sub / 打字机通道，再挂新气泡，避免旧正文串到空助手消息
    this.streamGeneration = this.streamGeneration + 1;
    this.endStreamListDraft();
    chatService.abort();
    this.abortSubConversation();
    this.clearStreamingAssistantText();

    // 构造消息
    const chatMessage: UTSJSONObject = {
      role: AssistantRoleEnum.USER,
      type: MessageModeEnum.CHAT,
      text: messageInfo,
      time: new Date().toISOString(),
      attachments,
      id: chatMessageId,
      messageType: MessageTypeEnum.USER,
    };

    // 当前助手信息
    const currentMessage: UTSJSONObject = {
      role: AssistantRoleEnum.ASSISTANT,
      type: MessageModeEnum.CHAT,
      text: "",
      think: "",
      time: new Date().toISOString(),
      id: currentMessageId,
      messageType: MessageTypeEnum.ASSISTANT,
      status: MessageStatusEnum.Loading,
    };

    // 将Incomplete状态的消息改为Complete状态，并清理旧的消息状态
    const completeMessageList =
      this.data.messageList.value != null
        ? this.data.messageList.value.map((item: MessageInfo) => {
          if (item.status == MessageStatusEnum.Incomplete) {
            item.status = MessageStatusEnum.Complete;
          }
          return item;
        })
        : [] as MessageInfo[];

    // 清理旧的消息状态，确保新对话开始时状态是干净的
    this.data.messageIdRef.value = "";
    this.data.currentConversationRequestId.value = "";

    // 用户发送消息后已试用次数 +1，不超过可试用总次数
    if (this.data.agentInfo.value != null) {
      const trialRaw = this.agentField("trialCount");
      const trialCount = trialRaw != null ? parseFloat(`${trialRaw}`) : 0;
      if (trialCount > 0) {
        this.data.localCalledTrialCount.value = Math.min(
          this.data.localCalledTrialCount.value + 1,
          trialCount
        );
      }
    }

    // 更新消息列表
    const newMessageList: MessageInfo[] = [];
    const cl = completeMessageList;
    if (cl != null) {
      for (let i = 0; i < cl.length; i++) {
        newMessageList.push(cl[i]);
      }
    }
    const chatMsgInfo = createMessageInfoFromAny(chatMessage);
    const currentMsgInfo = createMessageInfoFromAny(currentMessage);
    if (chatMsgInfo != null) {
      newMessageList.push(chatMsgInfo);
    }
    if (currentMsgInfo != null) {
      newMessageList.push(currentMsgInfo);
    }
    // AgentDetailUtils.checkConversationActive(newMessageList, this.data)
    this.data.isConversationActive.value = true;
    this.data.messageList.value = newMessageList;
    // 会话一开始就绑定流式播报目标（不等首包正文），H5/App 均可立刻 begin
    this.data.streamingAssistantMessageId.value = currentMessageId;
    this.data.streamingAssistantText.value = "";

    // 发送消息
    let params: any = {};
    if (isTempChat) {
      params = {
        chatKey: this.data.chatKey.value,
        conversationUid: this.data.conversationUid.value,
        variableParams: variableParams,
        message: messageInfo,
        attachments: attachments,
        selectedComponents: selectedComponents,
        skillIds: dataObj["skillIds"],
        agentMode: dataObj["agentMode"],
      };
    } else {
      params = {
        conversationId: this.data.conversationId.value,
        variableParams: variableParams,
        message: messageInfo,
        attachments: attachments,
        selectedComponents: selectedComponents,
        skillIds: dataObj["skillIds"],
        debug: false,
        sandboxId: (this.data.currentSandboxId.value != null && this.data.currentSandboxId.value.length > 0)
          ? this.data.currentSandboxId.value
          : dataObj["sandboxId"],
        modelId:
          (this.data.currentModelId.value != null && this.data.currentModelId.value != 0)
            ? this.data.currentModelId.value
            : (dataObj["modelId"] != null ? dataObj["modelId"] : 0),
        agentMode: dataObj["agentMode"],
      };
    }
    this.handleConversation(params, currentMessageId, isTempChat, onTimeout);
  }

  // 根据用户消息更新会话主题
  async handleUpdateTopic(
    conversationId: string,
    messageInfo: string,
  ): Promise<void> {
    const params = new AgentConversationUpdateParams();
    params.id = parseInt(conversationId);
    params.firstMessage = messageInfo;

    const res = await apiAgentConversationUpdate(params);
    const code = apiResCode(res);
    const responseData = apiResData<any>(res);
    const message = apiResMessage(res);
    if (code == SUCCESS_CODE) {
      const topicUpdatedRaw = responseData != null ? (responseData as UTSJSONObject)["topicUpdated"] : null;
      this.data.needUpdateTopicRef.value = topicUpdatedRaw != 1;
      // 更新会话主题
      const conv = this.data.conversationInfo.value;
      if (conv != null && responseData != null) {
        const convObj = JSON.parse(JSON.stringify(conv)) as UTSJSONObject;
        convObj["topic"] = (responseData as UTSJSONObject)["topic"];
        this.data.conversationInfo.value = convObj as any;
      }
    } else {
      uni.showToast({
        title: message != null ? message : "",
        icon: "none",
      });
    }
  }

  /**
   * 清空会话数据
   * @param isTempChat 是否是临时会话
   */
  clearConversationData(isTempChat: boolean = false): void {
    // 创建新会话后，问题建议列表改为空
    this.data.chatSuggestList.value = [];
    // 创建新会话后，是否正在加载会话改为false
    this.data.isLoadingConversation.value = false;
    // 创建新会话后，消息列表改为空
    this.data.messageList.value = [];
    // 创建新会话后，发送按钮禁用状态改为false
    this.data.wholeDisabled.value = false;
    // 创建新会话后，是否发送过消息改为false, 让对话设置框取消禁用状态
    this.data.isSendMessageRef.value = false;
    // 创建新会话后，用户填写变量参数改为空对象
    this.data.userFillVariables.value = new Map<string, any>() as any as StringAnyRecord;

    // 重新根据 manualComponents 初始化默认选中的组件
    this.data.selectedComponents.value = (
      this.data.manualComponents.value != null ? this.data.manualComponents.value : [] as AgentManualComponentInfo[]
    )
      .filter(
        (item: AgentManualComponentInfo): boolean =>
          item.defaultSelected == DefaultSelectedEnum.Yes,
      )
      .map(
        (item: AgentManualComponentInfo): AgentSelectedComponentInfo =>
          new AgentSelectedComponentInfo(item.id, item.type),
      );

    if (!isTempChat) {
      // 创建新会话后，需要更新会话主题
      this.data.needUpdateTopicRef.value = true;
    }
  }

  /**
   * 创建新会话
   */
  async createNewConversation(isAppDetails: boolean = false): Promise<void> {
    if (this.data.agentId.value == null || this.data.agentId.value == 0) {
      uni.showToast({
        title: t("Mobile.Conversation.agentIdMissing"),
        icon: "none",
      });
      return;
    }

    // 清空会话数据
    this.clearConversationData();

    // 如果普通会话，并且任务正在执行，则更新任务状态为 CANCEL
    this.markConversationTaskCancelIfExecuting();

    // 会话参数
    const conversationParams: UTSJSONObject = {
      agentId: this.data.agentId.value,
      devMode: false, // 开发模式, 只有智能体编排页才会设置为true
    };

    // 获取引导问题
    this.getGuidQuestion(this.data.agentId.value);

    const res = await apiAgentConversationCreate(conversationParams);
    const code = apiResCode(res);
    const responseDataRaw = apiResData<ConversationInfo>(res);
    const message = apiResMessage(res);
    const rdObj = responseDataRaw != null ? JSON.parse(JSON.stringify(responseDataRaw)) as UTSJSONObject : null;
    if (code == SUCCESS_CODE && rdObj != null) {
      const idVal = rdObj["id"];
      if (idVal != null && (idVal as number) != 0) {
        this.data.conversationId.value = idVal as number;

        // 更新会话信息
        this.data.conversationInfo.value = rdObj as any;
        const agentRawOuter = rdObj["agent"];
        if (agentRawOuter != null) {
          const agentDetail = this.toAgentJson(agentRawOuter);
          this.data.agentInfo.value = agentDetail;
          this.syncCalledTrialCount(agentDetail);
          const agentObj = agentRawOuter as UTSJSONObject;
          if (agentObj["manualComponents"] != null) {
            this.data.manualComponents.value =
              parseManualComponents(agentObj["manualComponents"]);
          }
        }
      }

      // 重新基于最新的 manualComponents 初始化默认选中的组件
      this.data.selectedComponents.value = (
        this.data.manualComponents.value != null ? this.data.manualComponents.value : [] as AgentManualComponentInfo[]
      )
        .filter(
          (item: AgentManualComponentInfo): boolean =>
            item.defaultSelected == DefaultSelectedEnum.Yes,
        )
        .map(
          (item: AgentManualComponentInfo): AgentSelectedComponentInfo =>
            new AgentSelectedComponentInfo(item.id, item.type),
        );

      // 重新获取沙盒列表以更新状态
      let allowPrivateSandbox = 0;
      if (rdObj["agent"] != null) {
        const raw = (rdObj["agent"] as UTSJSONObject)["allowPrivateSandbox"];
        allowPrivateSandbox = raw != null ? (raw as number) : 0;
      }
      this.handleGetSandboxList(allowPrivateSandbox == 1);

      let newUrl = "";

      // 如果是应用智能体页面，则跳转至应用智能体页面
      if (isAppDetails) {
        newUrl = `/subpackages/pages/app-details/app-details?id=${this.data.agentId.value}&conversationId=${rdObj["id"]}`;
      } else {
        // 新会话页面URL
        newUrl = `/subpackages/pages/agent-detail/agent-detail?id=${this.data.agentId.value}&conversationId=${rdObj["id"]}`;
      }

      // #ifdef WEB || H5
      // 修改rul参数且不刷新页面
      const url = new URL(location.href);
      url.hash = newUrl; // 修改参数
      history.replaceState(null, "", url.toString()); // 替换当前历史记录
      // #endif

      // #ifdef MP-WEIXIN
      uni.redirectTo({
        url: newUrl,
      });
      // #endif
    } else {
      uni.showToast({
        title: message != null ? message : "",
        icon: "none",
      });
    }
  }

  /**
   * 获取引导问题
   * @param agentId 智能体id
   */
  async getGuidQuestion(agentId: number): Promise<void> {
    const res = await apiPublishedAgentInfo(agentId);
    if (apiResCode(res) == SUCCESS_CODE) {
        const responseDataRaw = apiResData<any>(res);
      let guidSuggest: any[] = [];
      if (responseDataRaw != null) {
        // Android：禁止 as AgentDetailDto
        let guidRaw: any | null = null;
        try {
          const responseObj = responseDataRaw as UTSJSONObject;
          guidRaw = responseObj["guidQuestionDtos"];
        } catch (_eObj) {
          try {
            const m = responseDataRaw as Map<string, any | null>;
            guidRaw = m.get("guidQuestionDtos");
          } catch (_eMap) {
            guidRaw = null;
          }
        }
        if (guidRaw != null) {
          const parsed = JSON.parse<any[]>(JSON.stringify(guidRaw));
          guidSuggest = parsed != null ? parsed.slice(0, 5) : [];
        }
      }
      this.data.chatSuggestList.value = guidSuggest;
    }
  }

  /**
   * 获取基本信息
   * @param appParams 开放应用参数，来自开放应用URL参数params, 包含消息信息、文件信息、组件列表、变量参数等信息
   */
  async getPublishedAgentInfo(appParams: OpenAppParams | null = null): Promise<void> {
    // 查询已发布的智能体详情接口, 初始化会话id
    const agentIdVal = this.data.agentId.value;
    if (agentIdVal == null) {
      return;
    }
    const res = await apiPublishedAgentInfo(
      agentIdVal,
      true, // 开启获取初始化会话id
    );

    if (apiResCode(res) == SUCCESS_CODE) {
      const responseDataRaw = apiResData<any>(res);
      // Android：禁止 JSON.parse<Interface>（接口无法 Gson 实例化 → ClassCastException）
      let responseData: any | null = null;
      if (responseDataRaw != null) {
        try {
          responseData = JSON.parse(JSON.stringify(responseDataRaw));
        } catch (_e) {
          responseData = responseDataRaw;
        }
      }
      if (responseData == null) {
        return;
      }
      const responseObj = responseData as UTSJSONObject;
      this.data.agentInfo.value = responseObj;
      this.syncCalledTrialCount(responseData);
      // 初始化可用组件列表和默认选中组件
      this.data.manualComponents.value = parseManualComponents(responseObj["manualComponents"]);
      const manualComps = this.data.manualComponents.value;
      this.data.selectedComponents.value = manualComps
        .filter(
          (item: AgentManualComponentInfo): boolean =>
            item.defaultSelected == DefaultSelectedEnum.Yes,
        )
        .map(
          (item: AgentManualComponentInfo): AgentSelectedComponentInfo =>
            new AgentSelectedComponentInfo(item.id, item.type),
        );

      // 判断是否开启问题建议
      this.data.isSuggest.value = responseObj["openSuggest"] == OpenCloseEnum.Open;
      // 引导问题建议（兼容旧版）
      let suggestList: any[] = [];
      const guidQuestionDtos = responseObj["guidQuestionDtos"];
      if (guidQuestionDtos != null) {
        const dtos = guidQuestionDtos as any[];
        if (dtos.length > 0) {
          suggestList = dtos.slice(0, 5);
        }
      }
      const openingGuidQuestions = responseObj["openingGuidQuestions"];
      if (suggestList.length == 0 && openingGuidQuestions != null) {
        suggestList = (openingGuidQuestions as any[]).slice(0, 5);
      }
      this.data.chatSuggestList.value = suggestList;
      // 首页页面URL
      const pageHomeIdxRaw = responseObj["pageHomeIndex"];
      const pageHomeIdx = pageHomeIdxRaw != null ? `${pageHomeIdxRaw}` : "";
      const httpUrl = `${getApiBaseUrl()}${pageHomeIdx}`;
      // #ifdef H5 || WEB
      this.data.pageHomeUrl.value =
        process.env.NODE_ENV == "production"
          ? `${window.location.origin}${httpUrl}`
          : httpUrl;
      // #endif

      // #ifdef MP-WEIXIN || APP
      this.data.pageHomeUrl.value = httpUrl;
      // #endif

      // 变量参数（Android：保持 any[]，禁止 as BindConfigWithSub[]）
      const variablesRaw = responseObj["variables"];
      const _variables: any[] = [];
      if (variablesRaw != null) {
        const varsArr = variablesRaw as any[];
        for (let vi = 0; vi < varsArr.length; vi++) {
          _variables.push(varsArr[vi]);
        }
      }
      this.data.variables.value = _variables;
      // 获取会话ID
      const conversationIdRaw = responseObj["conversationId"];
      this.data.conversationId.value = conversationIdRaw != null
        ? parseFloat(`${conversationIdRaw}`)
        : null;

      // 获取沙盒列表
      this.handleGetSandboxList(responseObj["allowPrivateSandbox"] == DefaultSelectedEnum.Yes);

      // #ifdef H5 || WEB
      try {
        // 如果存在开放应用参数，则发送消息
        if (
          appParams != null &&
          typeof appParams == "object" &&
          Object.keys(appParams)?.length > 0
        ) {
          // 保存开放应用参数
          this.data.appParams.value = appParams;
          const newParams: OpenAppParams = {
            ...appParams,
          };
          // 如果存在会话ID，则删除会话唯一标识
          if (
            Object.prototype.hasOwnProperty.call(newParams, "conversationId")
          ) {
            delete newParams.conversationId;
          }
          const { message, variableParams, ...urlOtherParams } = newParams;
          // 如果存在其他参数，则保存到urlOtherParams中
          if (
            urlOtherParams != null &&
            typeof urlOtherParams == "object" &&
            Object.keys(urlOtherParams)?.length > 0
          ) {
            this.data.urlOtherParams.value = urlOtherParams;
          }
          // 如果存在变量参数，则保存变量参数
          if (
            variableParams != null &&
            typeof variableParams == "object" &&
            Object.keys(variableParams)?.length > 0
          ) {
            this.data.userFillVariables.value = variableParams as StringAnyRecord;
          }
          // 如果存在消息或文件，则发送消息
          if (message != null && message.trim().length > 0) {
            // 智能体必填变量参数 name 列表（排除系统变量）
            const requiredNames = _variables
              .filter((item: any) => item.systemVariable != true && item.require == true)
              .map((item: any) => item.name);

            // 用户自带的url参数中的变量参数对象
            const vp =
              variableParams != null &&
              typeof variableParams == "object" &&
              !Array.isArray(variableParams)
                ? (variableParams as Record<string, unknown>)
                : null;

            // 判断用户自带的url参数中的变量参数是否存在且不为空
            const variableValuePresent = (val: unknown): boolean => {
              if (val == null || val == undefined) return false;
              if (typeof val == "string") return val.trim() != "";
              if (typeof val == "number") return !Number.isNaN(val);
              if (typeof val == "boolean") return true;
              return false;
            };

            // 判断用户自带的url参数中的变量参数是否满足智能体必填变量参数要求
            const allRequiredInParams =
              requiredNames.length == 0 ||
              (vp != null &&
                requiredNames.every(
                  (name: string) =>
                    Object.prototype.hasOwnProperty.call(vp, name) &&
                    variableValuePresent(vp[name]),
                ));

            /**
             * 如果用户自带的url参数中的变量参数满足智能体必填变量参数要求，则发送消息，否则不发送消息
             */
            if (allRequiredInParams) {
              // 将消息信息转换为消息信息对象
              newParams.messageInfo = message;
              delete newParams.message; // 删除消息信息
              // 初始化会话时，发送消息
              this.handleSendMessage(newParams, false, null);
            }
          }
        }
      } catch (error) {
        console.error(
          "[AgentDetailService] Failed to get open app params:",
          error,
        );
      }
      // #endif

      // 检查订阅限制
      const respObj = responseData as UTSJSONObject;
      const paymentRequired = respObj["paymentRequired"] == true;
      const subscribed = respObj["subscribed"] == true;
      const overCallLimit = respObj["overCallLimit"] == true;

      // 是否弹出模态框：要求订阅且未订阅，或超出调用限制（已订阅时不主动弹窗）
      const shouldShowModal =
        paymentRequired && (!subscribed || overCallLimit) && !subscribed;
      if (shouldShowModal && this.data.enableSubscription.value == 1) {
        this.data.subscriptionModalVisible.value = true;
      } else {
        this.data.subscriptionModalVisible.value = false;
      }

      // 是否禁用输入框：要求订阅、且未订阅、且已超出调用限制
      const shouldBlockInput =
        paymentRequired && !subscribed && overCallLimit;
      if (shouldBlockInput && this.data.enableSubscription.value == 1) {
        this.data.subscriptionRequired.value = true;
      } else {
        this.data.subscriptionRequired.value = false;
      }
    }
  }

  /**
   * 收藏/取消收藏
   */
  async handleCollect(): Promise<void> {
    const info = this.data.agentInfo.value;
    if (info == null) return;

    const agentIdRaw = info["agentId"];
    if (agentIdRaw == null) return;
    const agentIdNum = parseFloat(`${agentIdRaw}`);

    if (info["collect"] == true) {
      const unCollectRes = await apiUnCollectAgent(agentIdNum);
      if (apiResCode(unCollectRes) == SUCCESS_CODE) {
        uni.showToast({
          title: t("Mobile.Conversation.unfavoriteSuccess"),
          icon: "success",
          duration: 2000,
        });
        info["collect"] = false;
      }
    } else {
      const collectRes = await apiCollectAgent(agentIdNum);
      if (apiResCode(collectRes) == SUCCESS_CODE) {
        uni.showToast({
          title: t("Mobile.Conversation.favoriteSuccess"),
          icon: "success",
          duration: 2000,
        });
        info["collect"] = true;
      }
    }
  }

  /**
   * 查询临时会话信息
   * conversationUid: 会话唯一标识 (可选)
   */
  async queryTempConversation(conversationUid: string) {
    // 链接Key为空
    if (this.data.chatKey.value == null || this.data.chatKey.value.length == 0) {
      uni.showToast({
        title: t("Mobile.Conversation.chatKeyRequired"),
        icon: "none",
      });
      return;
    }
    const queryObj: UTSJSONObject = {
      chatKey: this.data.chatKey.value,
      conversationUid: conversationUid,
    };
    const res = await apiTempChatConversationQuery(queryObj as TempConversationQueryDto);
    if (apiResCode(res) == SUCCESS_CODE) {
      const queryData = apiResData<ConversationInfo>(res);
      const queryObj2 = queryData != null ? (queryData as UTSJSONObject) : null;
      const agentRaw = queryObj2 != null ? queryObj2["agent"] : null;
      // 临时会话页, 设置导航栏标题
      if (agentRaw != null) {
        let agentName = "";
        const agent = agentRaw as UTSJSONObject;
        const nameRaw = agent["name"];
        if (nameRaw != null) {
          agentName = `${nameRaw}`;
        }
        const nameParams = new Map<string, string | number>();
        nameParams.set("name", agentName);
        uni.setNavigationBarTitle({
          title: t("Mobile.Conversation.startWithAgent", nameParams as Record<string, string | number>),
        });
      }

      // 处理消息列表
      this.handleQueryConversation(res);
    } else {
      this.data.isLoadingConversation.value = false;
      uni.showToast({
        title: apiResMessage(res),
        icon: "none",
        duration: 2000,
      });
    }
  }

  /**
   * 创建临时会话
   * chatKey 链接Key
   * @param captchaVerifyParam 验证码参数 (可选)
   */
  async createTempChatConversation(captchaVerifyParam: string) {
    // 链接Key为空
    if (this.data.chatKey.value == null || this.data.chatKey.value.length == 0) {
      uni.showToast({
        title: t("Mobile.Conversation.chatKeyRequired"),
        icon: "none",
      });
      return;
    }
    const createObj: UTSJSONObject = {
      chatKey: this.data.chatKey.value,
      captchaVerifyParam: captchaVerifyParam,
    };
    const res = await apiTempChatConversationCreate(createObj as TempConversationCreateDto);
    const resData = apiResData<any>(res);
    const code = apiResCode(res);
    const message = apiResMessage(res);
    // 创建临时会话成功
    if (code == SUCCESS_CODE && resData != null) {
      const resDataObj = resData as UTSJSONObject;
      const uidRaw = resDataObj["uid"];
      const uid = uidRaw != null ? `${uidRaw}` : "";
      this.data.conversationUid.value = uid;
      uni.setStorageSync(TEMP_CONVERSATION_UID, uid);
      // 查询临时会话详细
      this.queryTempConversation(uid);
    } else {
      this.data.isLoadingConversation.value = false;
      uni.showToast({
        title: message != null && message != "" ? message : "",
        icon: "none",
        duration: 2000,
      });
    }
  }

  /**
   * 重启智能体
   */
  async handleRestartAgent(): Promise<void> {
    const conversationId = this.data.conversationId.value;
    if (conversationId == null || conversationId == 0) return;

    uni.showLoading({
      title: t("Mobile.Common.restarting"),
      mask: true,
    });
    try {
      const res = await apiRestartAgent(conversationId);
      uni.hideLoading();
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({
          title: t("Mobile.Sandbox.restartAgentSuccess"),
          icon: "success",
        });
      } else {
        let failTitle = t("Mobile.Sandbox.restartAgentFailed");
        const msg = apiResMessage(res);
        if (msg != null) {
          const msgText = msg as string;
          if (msgText.length > 0) {
            failTitle = msgText;
          }
        }
        uni.showToast({
          title: failTitle,
          icon: "none",
        });
      }
    } catch (error) {
      uni.hideLoading();
      console.error("[AgentDetailService] 重启智能体失败:", error);
    }
  }

  /**
   * 重启容器/客户端
   * @param isCloudComp 是否是云电脑 (currentSandboxId == '-1')
   */
  async handleRestartSandbox(isCloudComp: boolean): Promise<void> {
    const conversationId = this.data.conversationId.value;
    if (conversationId == null || conversationId == 0) return;

    uni.showLoading({
      title: t("Mobile.Common.restarting"),
      mask: true,
    });
    try {
      const res = await apiRestartSandbox(conversationId);
      uni.hideLoading();
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({
          title: isCloudComp
            ? t("Mobile.Sandbox.restartCloudCompSuccess")
            : t("Mobile.Sandbox.restartClientSuccess"),
          icon: "success",
        });
      } else {
        let failTitle = t("Mobile.Common.operationFailed");
        const msg = apiResMessage(res);
        if (msg != null) {
          const msgText = msg as string;
          if (msgText.length > 0) {
            failTitle = msgText;
          }
        }
        uni.showToast({
          title: failTitle,
          icon: "none",
        });
      }
    } catch (error) {
      uni.hideLoading();
      console.error("[AgentDetailService] 重启容器失败:", error);
    }
  }

  /**
   * 刷新或重新查询会话订阅与限制状态
   */
  async handleCheckSubscriptionLimit(): Promise<void> {
    const id = this.data.conversationId.value;
    if (id != null && id != 0) {
      const res = await apiAgentConversation(id);
      const convRaw = apiResData<any>(res);
      if (apiResCode(res) == SUCCESS_CODE && convRaw != null) {
        // Android Gson 不能实例化 ConversationInfo interface，直接按 JSON 对象读取。
        const conv = this.toAgentJson(convRaw);
        const agentRaw = conv != null ? conv["agent"] : null;
        if (agentRaw != null) {
          const agentDetail = this.toAgentJson(agentRaw);
          if (agentDetail == null) {
            return;
          }
          this.data.agentInfo.value = agentDetail;
          this.syncCalledTrialCount(agentDetail);
          const paymentRequired = agentDetail["paymentRequired"] == true;
          const subscribed = agentDetail["subscribed"] == true;
          const overCallLimit = agentDetail["overCallLimit"] == true;

          // 是否弹出模态框：要求订阅且未订阅，或超出调用限制（已订阅时不主动弹窗）
          const shouldShowModal =
            paymentRequired && (!subscribed || overCallLimit) && !subscribed;
          if (shouldShowModal && this.data.enableSubscription.value == 1) {
            this.data.subscriptionModalVisible.value = true;
          } else {
            this.data.subscriptionModalVisible.value = false;
          }

          // 是否禁用输入框：要求订阅、且未订阅、且已超出调用限制
          const shouldBlockInput =
            paymentRequired && !subscribed && overCallLimit;
          if (shouldBlockInput && this.data.enableSubscription.value == 1) {
            this.data.subscriptionRequired.value = true;
          } else {
            this.data.subscriptionRequired.value = false;
          }
        }
      }
    }
  }
}
