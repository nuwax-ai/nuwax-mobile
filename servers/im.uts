import request from "./useRequest";
import { generateUUID } from "@/utils/common";
import type { RequestResponse } from "@/types/interfaces/request";

const IM_DEVICE_BASE_ID_STORAGE_KEY = "NUWAX_IM_DEVICE_BASE_ID";

let cachedImDeviceId = "";

/**
 * IM 协议 deviceId（nuwax-im ImProtocol.isValidDeviceId）：
 * 格式 {baseId}#{tabId}，字符仅 a-zA-Z0-9 与 - _ .，至多一个 #，总长 ≤128。
 * ★REST 发送必填：扇出按它【排除来源端】（nuwax-im 02 §6.5），缺失会报 IM_90001。
 * baseId 首次生成后落 storage 持久化；tabId 每次页面会话随机——H5 多标签各拿各的
 * tabId，自己其他标签页仍能收到自己发的消息，仅来源标签页被排除。
 */
export function getImDeviceId(): string {
  if (cachedImDeviceId.length > 0) {
    return cachedImDeviceId;
  }
  let baseId = "";
  try {
    const raw = uni.getStorageSync(IM_DEVICE_BASE_ID_STORAGE_KEY);
    if (raw != null) {
      baseId = `${raw}`;
    }
  } catch (_error) {
    baseId = "";
  }
  if (baseId.length == 0) {
    baseId = generateUUID();
    try {
      uni.setStorageSync(IM_DEVICE_BASE_ID_STORAGE_KEY, baseId);
    } catch (_error) {
      // 存储异常不阻断发送：本次会话退化为内存态 baseId
    }
  }
  let tabId = "";
  for (let i = 0; i < 12; i++) {
    tabId += Math.floor(Math.random() * 16).toString(16);
  }
  cachedImDeviceId = `${baseId}#${tabId}`;
  return cachedImDeviceId;
}

/**
 * IM 未读总数（App 角标）。
 *
 * 契约见 nuwax-im 仓库 docs/openapi/im-openapi.yaml（syncUnreadTotal）：
 * - 响应 data：total / dndTotal / unreadConvs / authoritative / serverTimeMs
 * - ★total 已包含 dndTotal，角标应展示 total - dndTotal（该提醒用户的数字）
 * - ★authoritative=false 表示服务端走了缓存/降级路径，客户端应降低轮询频率
 * - 接口承诺"永不 500"，可安全用于周期轮询
 */
export async function apiImUnreadTotal(): Promise<RequestResponse<any>> {
  return await request({
    url: "/api/instant-message/unread-total",
    method: "GET",
  });
}

/**
 * 我的会话列表（游标分页，首页 cursor 传空串）。
 *
 * 契约见 im-openapi.yaml（convList）：
 * - data = PageResult + records: ConversationSummaryDto[]
 * - nextCursor 缺键/为空 = 没有下一页（★勿用 records.length < limit 判断）
 * - convId 是雪花号（int64），H5 按 number 解析会丢精度，页面层统一转字符串保存
 * - unreadCount 服务端没算时【键整个不存在】（不是 0）
 */
export async function apiImConversations(
  cursor: string,
  limit: number,
): Promise<RequestResponse<any>> {
  return await request({
    url: "/api/instant-message/conversations",
    method: "GET",
    data: {
      cursor,
      limit,
    },
  });
}

/**
 * 我的群聊列表（convListMyGroups，游标分页，首页 cursor 传空串）。
 *
 * 契约见 im-openapi.yaml：
 * - 与 /conversations 的差异：含 visible=0（已从会话列表删除但仍在群内）的群
 * - ★cursor 不能与 /conversations 混用（两边可见集不同）
 * - data = PageResult：records: ConversationSummaryDto[]（convType=2），
 *   total = 符合条件的总数（智联录分组头计数用它，勿用 records.length）
 */
export async function apiImMyGroups(
  cursor: string,
  limit: number,
): Promise<RequestResponse<any>> {
  return await request({
    url: "/api/instant-message/conversations/groups",
    method: "GET",
    data: {
      cursor,
      limit,
    },
  });
}

/**
 * 创建或获取单聊会话（convCreateP2p，幂等）。
 *
 * 契约见 im-openapi.yaml：
 * - ★同一对用户重复调用返回同一个 convId，不会产生第二个会话——智联录点
 *   联系人进详情页的唯一入口，无需先去会话列表里找
 * - targetUserId == 自己 → IM_20106（一期不开放给自己发）
 * - 响应 data = ConversationSummaryDto；created 键仅创建类接口返回（本次是否真的新建）
 */
export async function apiImCreateP2pConversation(
  targetUserId: string,
): Promise<RequestResponse<any>> {
  // ★targetUserId 是 int64：以原始数字字面量拼 JSON 直传（同 apiImSendTextMsg 的
  //   convId），避免经 JS number 丢精度后建错/找不到会话
  return await request({
    url: "/api/instant-message/conversations/p2p",
    method: "POST",
    data: `{"targetUserId":${targetUserId}}`,
  });
}

/**
 * 通讯录列表（消息页「智联录」tab）。
 *
 * 契约见 im-openapi.yaml（contactList）：
 * - data = { items: ContactItem[], degraded, truncated }
 * - displayName 服务端已按 remark > nickName > userName 算好，直接用，不要重算
 * - status：1=已互为联系人 2=对方申请待我确认 3=我已申请待对方同意（2/3 勿渲染成正常联系人）
 * - subjectType：1=人（用户标签），其余值为智能体（专家标签）
 */
export async function apiImContacts(): Promise<RequestResponse<any>> {
  return await request({
    url: "/api/instant-message/contacts",
    method: "GET",
  });
}

/**
 * 接受好友申请（contactAccept，处理 status=2 的「新的伙伴申请」）。
 * ★幂等：只对"待接受"态生效，重复接受返回 data=false（仍是成功码，勿当失败重试）。
 */
export async function apiImContactAccept(
  userId: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `/api/instant-message/contacts/${userId}/accept`,
    method: "POST",
  });
}

/**
 * 拒绝好友申请（contactReject）。幂等语义同 accept：重复操作返回 false 不报错。
 */
export async function apiImContactReject(
  userId: string,
): Promise<RequestResponse<any>> {
  return await request({
    url: `/api/instant-message/contacts/${userId}/reject`,
    method: "POST",
  });
}

/**
 * 历史消息（向前翻页，消息详情页用）。
 *
 * 契约见 im-openapi.yaml（msgHistory）：
 * - ★beforeSeq 是【方向键】不是游标：beforeSeq<=0 不传 ⇒ 从最新往回取；
 *   传了 ⇒ 取 seq < beforeSeq 的那一页（翻更早把上一页最小 seq 传回来）
 * - 服务端按 seq 降序返回；hasMore 缺键/为空 = 没有更早消息（勿用 records.length 判断）
 * - 被撤回的消息【仍在列表里】（msgStatus=2、body=null），靠渲染区分，勿过滤
 * - convId 雪花号存字符串，拼 URL 原样直传防精度丢失
 */
export async function apiImMessages(
  convId: string,
  beforeSeq: number,
  limit: number,
): Promise<RequestResponse<any>> {
  const data = new UTSJSONObject();
  data["limit"] = limit;
  if (beforeSeq > 0) {
    data["beforeSeq"] = beforeSeq;
  }
  return await request({
    url: `/api/instant-message/conversations/${convId}/messages`,
    method: "GET",
    data,
  });
}

/**
 * 发送文本消息（msgSend）。
 *
 * ★convId 是 int64 雪花号：拼进 JSON 字符串以原始数字直传（request 支持字符串 body
 *   直通不反转义），避免经 JS number 精度丢失后发错会话。
 * ★clientMsgId 幂等键【每条必带】：不传服务端会兜底生成，此时幂等保护失效——
 *   弱网重试会真的发出两条。
 * ★deviceId【必填】（getImDeviceId 自动携带）：扇出按它排除来源端，REST 入口
 *   缺失直接被 IM_90001 拒绝。
 * 响应 data = SendMessageResult{ msgId, seq, sendTime, msgStatus, idempotent, digest }：
 * idempotent=true 表示重放，调用方应替换本地"发送中"占位而不是再插一条。
 */
export async function apiImSendTextMsg(
  convId: string,
  text: string,
  clientMsgId: string,
): Promise<RequestResponse<any>> {
  // 文本经 JSON.stringify 转义；clientMsgId/deviceId 是自家生成的安全字符，无需转义
  const payload =
    `{"convId":${convId},"msgType":"text","clientMsgId":"${clientMsgId}","deviceId":"${getImDeviceId()}","body":{"text":${JSON.stringify(text)}}}`;
  return await request({
    url: "/api/instant-message/messages",
    method: "POST",
    data: payload,
  });
}

/**
 * 上报已读水位（readReport）。
 *
 * ★readSeq 是"我已连续读到的最大 seq"水位（不是单条 seq），单调不回退：
 * 回退会被服务端 clamp（advanced=false / clamped=true 属正常，勿据此重试）。
 * deviceId 可选但建议携带：CONV_UNREAD 下行按它排除来源端（02 §7）。
 */
export async function apiImReadReport(
  convId: string,
  readSeq: number,
): Promise<RequestResponse<any>> {
  return await request({
    url: `/api/instant-message/conversations/${convId}/read`,
    method: "POST",
    data: `{"readSeq":${readSeq},"deviceId":"${getImDeviceId()}"}`,
  });
}
