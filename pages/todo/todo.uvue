<template>
  <view class="todo">
    <custom-nav-bar :title="t('Mobile.Discover.todo')" className="border-b" hasSafetyZone :show-back="true">
      <template #right>
        <view class="todo__add" @click="onAdd">
          <svg-icon name="icon-Plus" size="22" unit="px" color="#5b4dff" />
        </view>
      </template>
    </custom-nav-bar>
    <scroll-view class="todo__scroll" direction="vertical" :show-scrollbar="false">
      <text class="todo__section">{{ todayTitle }}</text>
      <view class="todo__card" v-for="(item, index) in todayItems" :key="index">
        <view class="todo__check"></view>
        <view class="todo__body">
          <text class="todo__name">{{ t(item.titleKey) }}</text>
          <text class="todo__meta">{{ t(item.metaKey) }}</text>
        </view>
        <text class="todo__time">{{ item.time }}</text>
      </view>

      <text class="todo__section">{{ weekTitle }}</text>
      <view class="todo__card" v-for="(item, index) in weekItems" :key="index">
        <view class="todo__check"></view>
        <view class="todo__body">
          <text class="todo__name">{{ t(item.titleKey) }}</text>
          <text class="todo__meta">{{ t(item.metaKey) }}</text>
        </view>
        <text class="todo__time">{{ t(item.timeKey) }}</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";

  class TodoTimeItem {
    titleKey: string = "";
    metaKey: string = "";
    time: string = "";

    constructor(titleKey: string, metaKey: string, time: string) {
      this.titleKey = titleKey;
      this.metaKey = metaKey;
      this.time = time;
    }
  }

  class TodoDayItem {
    titleKey: string = "";
    metaKey: string = "";
    timeKey: string = "";

    constructor(titleKey: string, metaKey: string, timeKey: string) {
      this.titleKey = titleKey;
      this.metaKey = metaKey;
      this.timeKey = timeKey;
    }
  }

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  function countText(key: string, count: number): string {
    const m = new Map<string, string | number>();
    m.set("count", count);
    return translateFn(key, toI18nParams(m), "");
  }

  const todayItems: TodoTimeItem[] = [
    new TodoTimeItem("Mobile.Discover.todoItem1Title", "Mobile.Discover.todoItem1Meta", "18:00"),
    new TodoTimeItem("Mobile.Discover.todoItem2Title", "Mobile.Discover.todoItem2Meta", "20:00"),
    new TodoTimeItem("Mobile.Discover.todoItem3Title", "Mobile.Discover.todoItem3Meta", "21:30"),
  ];

  const weekItems: TodoDayItem[] = [
    new TodoDayItem("Mobile.Discover.todoItem4Title", "Mobile.Discover.todoItem4Meta", "Mobile.Discover.todoThu"),
    new TodoDayItem("Mobile.Discover.todoItem5Title", "Mobile.Discover.todoItem5Meta", "Mobile.Discover.todoFri"),
  ];

  const todayTitle = countText("Mobile.Discover.todoToday", todayItems.length);
  const weekTitle = countText("Mobile.Discover.todoWeek", weekItems.length);

  /** 新建待办尚未接入，先提示即将上线 */
  function onAdd(): void {
    uni.showToast({ title: t("Mobile.Common.comingSoon"), icon: "none" });
  }
</script>

<style scoped>
  .todo {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: #f7f7f8;
  }

  .todo__add {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .todo__scroll {
    flex: 1;
  }

  .todo__section {
    margin: 16px 16px 8px;
    font-size: 16px;
    font-weight: 600;
    color: #1f2329;
  }

  .todo__card {
    margin: 0 16px 10px;
    padding: 14px 14px;
    background-color: #ffffff;
    border-radius: 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .todo__check {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    border-width: 1.5px;
    border-style: solid;
    border-color: #c9cdd4;
    border-radius: 10px;
  }

  .todo__body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .todo__name {
    font-size: 16px;
    color: #1f2329;
  }

  .todo__meta {
    margin-top: 4px;
    font-size: 13px;
    color: #86909c;
  }

  .todo__time {
    margin-left: 12px;
    font-size: 13px;
    color: #86909c;
  }
</style>
