  /* 分类标签常驻横滚；选择后在下方展示每组三条推荐。 */
  .create-hub__category-wrap {
    width: 100%;
    margin-top: 48rpx;
  }

  .create-hub__category-track,
  .create-hub__category-scroll {
    width: 100%;
  }

  .create-hub__category-list {
    display: flex;
    flex-direction: row;
