<template>
  <view class="account-management-container relative flex flex-col">
    <!-- 顶部导航栏 -->
    <custom-nav-bar :title="t('Mobile.AccountManagement.title')" className="border-b" hasSafetyZone showBack />
    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <view class="user-card">
        <avatar-uploader
          :avatar="currentAvatar"
          :alt="t('Mobile.Common.avatarAlt')"
          @update-avatar="handleAvatarUpdated"
        />
        <view class="user-info">
          <text class="user-name text-ellipsis">{{ userName }}</text>
          <text class="user-desc text-ellipsis">{{ nickNameDisplay }}</text>
        </view>
      </view>

      <view class="card-group">
        <!-- 编辑资料 -->
        <view class="profile-row profile-entry" @tap="handleEditProfile">
          <text class="label">{{ t("Mobile.Profile.editProfile") }}</text>
          <text class="row-arrow">›</text>
        </view>

        <!-- 重置密码 -->
        <view class="profile-row profile-entry" @tap="handleResetPassword">
          <text class="label">{{ t("Mobile.Profile.resetPassword") }}</text>
          <text class="row-arrow">›</text>
        </view>

        <!-- 手机号 -->
        <view class="profile-row">
          <text class="label">{{ t("Mobile.Profile.phone") }}</text>
          <text class="value">{{ phone }}</text>
        </view>

        <!-- 邮箱 -->
        <view class="profile-row">
          <text class="label">{{ t("Mobile.Profile.email") }}</text>
          <text class="value">{{ emailDisplay }}</text>
        </view>

        <!-- 语言切换 -->
        <LanguagePicker />

        <!-- 动态认证码 -->
        <view class="profile-row dynamic-code-row">
          <text class="label">{{ t("Mobile.Profile.dynamicCode") }}</text>
          <view class="dynamic-code-actions">
            <text class="value">{{ dynamicCodeDisplay }}</text>
            <view class="code-action" @tap="handleCopyDynamicCode">
              <svg-icon name="icon-CopyOutlined" size="32" />
            </view>
            <view class="code-action" @tap="fetchDynamicCode">
              <svg-icon name="icon-restart" size="32" />
            </view>
          </view>
        </view>
      </view>

      <!-- 注销账号（永久删除账号数据，iOS 审核 5.1.1(v) 必需；点击弹窗二次确认） -->
      <view class="card-group">
        <view class="profile-row" @tap="handleDeleteAccount">
          <text class="label danger-text">{{ t("Mobile.Header.deleteAccount") }}</text>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- 注销账号确认弹窗：微信小程序不支持 dialogPage，页面内自绘兜底（遮罩盖不住原生 tabBar） -->
    <!-- #ifdef MP-WEIXIN -->
    <delete-account-modal ref="deleteAccountModalRef" @confirm="performDeleteAccount" @cancel="noop" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, type ComponentPublicInstance } from 'vue';
  import { onLoad, onShow, onUnload } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiUserInfo, apiUserDynamicCode, apiDeleteAccount } from "@/servers/account";
  import { UserInfo } from "@/types/interfaces/login";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import defaultAvatar from "@/static/assets/avatar.png";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import { clearStoragePreservingApiBaseUrl } from "@/constants/config";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import LanguagePicker from "./language-picker/language-picker.uvue";
  import AvatarUploader from "./avatar-uploader.uvue";
  // #ifdef MP-WEIXIN
  import DeleteAccountModal from "@/pages/mine/components/delete-account-modal/delete-account-modal.uvue";
  // #endif
  import { DELETE_ACCOUNT_CONFIRM_EVENT } from "@/pages/mine/components/delete-account-modal/deleteAccountEvent";

  const { t: tFn, ensureLangList, loadI18n } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  // Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject 或直接点方法；用 $callMethod 调 defineExpose 方法
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // 用户信息
  const userInfo = ref<UserInfo | null>(null);

  // 动态认证码
  const dynamicCode = ref("");

  // userInfo 字段（uvue 模板不支持 ?.）
  const userName = computed((): string => {
    const u = userInfo.value;
    return u != null ? u.userName : "";
  });
  const nickNameDisplay = computed((): string => {
    const u = userInfo.value;
    if (u == null || u.nickName.length == 0) return "--";
    return u.nickName;
  });
  const dynamicCodeDisplay = computed((): string => {
    return dynamicCode.value.length > 0 ? dynamicCode.value : "--";
  });
  const phone = computed((): string => {
    const u = userInfo.value;
    return u != null ? u.phone : "";
  });
  const emailDisplay = computed((): string => {
    const u = userInfo.value;
    if (u != null && u.email.length > 0) {
      return u.email;
    }
    return t("Mobile.Profile.pendingBind");
  });
  // 当前显示的头像，默认使用传入的 avatar
  const currentAvatar = ref<string>(defaultAvatar);

  const handleAvatarUpdated = (avatar: string) => {
    currentAvatar.value = avatar;
    if (userInfo.value != null) {
      userInfo.value.avatar = avatar;
    }
  };

  const handleEditProfile = () => {
    uni.navigateTo({ url: "/subpackages/pages/account-management/edit-profile/edit-profile" });
  };

  const handleResetPassword = () => {
    uni.navigateTo({ url: "/subpackages/pages/account-management/reset-password/reset-password" });
  };

  // 查询当前登录用户信息
  const fetchUserInfo = async () => {
    const res = await apiUserInfo();
    if (res != null && apiResCode(res) == SUCCESS_CODE) {
      const rawData = apiResData<any>(res);
      userInfo.value = rawData != null ? new UserInfo(rawData as UTSJSONObject) : null;
      if (userInfo.value != null) {
        currentAvatar.value = userInfo.value.avatar.length > 0 ? userInfo.value.avatar : defaultAvatar;
      } else {
        currentAvatar.value = defaultAvatar;
      }
    }
  };

  // 获取动态认证码
  const fetchDynamicCode = async () => {
    try {
      const res = await apiUserDynamicCode();
      if (apiResCode(res) == SUCCESS_CODE) {
        const d = apiResData<string>(res);
        dynamicCode.value = d != null ? `${d}` : "";
      }
    } catch (e) {
      console.error("获取动态认证码失败", e);
    }
  };

  const handleCopyDynamicCode = () => {
    if (dynamicCode.value.length == 0) return;
    uni.setClipboardData({
      data: dynamicCode.value,
      success: () => {
        uni.showToast({ title: t("Mobile.Common.copySuccess"), icon: "none" });
      },
      fail: () => {
        uni.showToast({ title: t("Mobile.Common.copyFailed"), icon: "none" });
      },
    });
  };

  // 注销账号（永久删除账号数据）
  // 与退出登录不同：注销以接口成功为准才清本地态，失败保留登录态仅提示。
  const performDeleteAccount = async () => {
    try {
      const res = await apiDeleteAccount();
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.setStorageSync(ACCESS_TOKEN, ""); // 清空token【兼容鸿蒙系统】
        clearStoragePreservingApiBaseUrl(); // 清空业务缓存并保留企业域名
        loadI18n(false);
        uni.showToast({
          title: t("Mobile.Header.deleteAccountSuccess"),
          icon: "success",
        });
        setTimeout(() => {
          // #ifdef MP-WEIXIN
          uni.reLaunch({ url: "/subpackages/pages/login-weixin/login-weixin" });
          // #endif

          // 除微信小程序外（H5 / WEB / Android / iOS / 鸿蒙）统一回普通登录页，
          // 避免按平台枚举漏掉 APP-HARMONY 后鸿蒙端注销完停在原页面。
          // #ifndef MP-WEIXIN
          uni.reLaunch({ url: "/subpackages/pages/login/login" });
          // #endif
        }, 1000);
      } else {
        uni.showToast({
          title: t("Mobile.Header.deleteAccountFailed"),
          icon: "none",
        });
      }
    } catch (error) {
      console.error("注销账号接口失败:", error);
      uni.showToast({
        title: t("Mobile.Header.deleteAccountFailed"),
        icon: "none",
      });
    }
  };

  // 注销账号确认弹窗（组件内完成"输入确认短语"校验，校验通过才执行 performDeleteAccount）
  // #ifdef MP-WEIXIN
  const deleteAccountModalRef = ref<any | null>(null);
  /** 模板占位：小程序端取消弹窗无需额外处理 */
  const noop = () => {};
  // #endif

  // #ifndef MP-WEIXIN
  /** 弹窗页（dialogPage）确认回调；$on / $off 需传同一函数引用 */
  const onDeleteAccountConfirmed = () => {
    performDeleteAccount();
  };
  // #endif

  // 注销账号入口：弹窗内告知后果 + 手动输入确认短语，双重确认避免误操作
  const handleDeleteAccount = () => {
    // #ifdef MP-WEIXIN
    // 微信小程序不支持 dialogPage，退回页面内弹窗
    callRefMethod(deleteAccountModalRef.value, "open");
    // #endif

    // #ifndef MP-WEIXIN
    // dialogPage：独立弹窗页，遮罩可覆盖原生 tabBar 与导航栏
    uni.openDialogPage({
      url: "/pages/mine/components/delete-account-dialog/delete-account-dialog",
      animationType: "fade-in",
    });
    // #endif
  };

  onLoad((options: any) => {
    fetchDynamicCode();
    // 确保语言列表已加载，供 H5 端的语言切换功能使用
    ensureLangList();
    // 设置当前页面导航栏标题
    setCurrentPageNavigationBarTitle();
    // #ifndef MP-WEIXIN
    // 弹窗页（dialogPage）校验通过后回传，这里执行真正的注销
    uni.$on(DELETE_ACCOUNT_CONFIRM_EVENT, onDeleteAccountConfirmed);
    // #endif
  });

  // #ifndef MP-WEIXIN
  onUnload(() => {
    uni.$off(DELETE_ACCOUNT_CONFIRM_EVENT, onDeleteAccountConfirmed);
  });
  // #endif

  onShow(() => {
    fetchUserInfo();
  });
</script>

<style lang="scss" scoped>
  .account-management-container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .user-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 32rpx;
    margin: 24rpx 24rpx 0;
    border-radius: 24rpx;
    background-color: #ffffff;

    .avatar-uploader {
      width: 120rpx;
      height: 120rpx;
      margin-right: 24rpx;
    }

    .user-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;

      .user-name {
        margin-bottom: 8rpx;
        font-size: 36rpx;
        font-weight: 600;
        color: #1a1a1a;
      }

      .user-desc {
        font-size: 26rpx;
        color: #999999;
      }
    }
  }

  .card-group {
    margin: 24rpx 24rpx 0;
    background-color: #fff;
    border-radius: 24rpx;
    overflow: hidden;

    .profile-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 28rpx 32rpx;
      border-bottom: 2rpx solid #f5f5f5;

      .label {
        font-size: 30rpx;
        font-weight: 500;
        color: #1a1a1a;
      }

      &:last-child {
        border-bottom-width: 0;
      }

      .value {
        flex: 1;
        text-align: right;
        margin-left: 24rpx;
        font-size: 26rpx;
        color: #999999;
      }

      .dynamic-code-actions {
        flex: 1;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-end;
        margin-left: 24rpx;
        overflow: hidden;

        .value {
          flex: 1;
          margin-left: 0;
          overflow: hidden;
        }

        .code-action {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 48rpx;
          height: 48rpx;
          margin-left: 12rpx;
          flex-shrink: 0;

          .svg-icon {
            opacity: 0.4;
          }

          .iconfont {
            color: #999999;
          }
        }
      }

      &.dynamic-code-row {
        height: 112rpx;
        padding-top: 0;
        padding-bottom: 0;
      }

      &.profile-entry {
        justify-content: space-between;

        .row-arrow {
          padding-left: 8rpx;
          font-size: 40rpx;
          font-weight: 300;
          line-height: 1;
          color: #c0c0c0;
        }
      }
    }
  }

  /* 危险操作文案（注销账号）：提升层级，覆盖 .card-group .profile-row .label 的默认深色 */
  .card-group .profile-row .danger-text {
    color: #fa5151;
  }

  .bottom-space {
    height: 40rpx;
  }
</style>
