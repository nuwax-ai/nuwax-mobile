<template>
  <uni-modal-popup
    ref="modalPopupRef"
    position="bottom"
    :title="title"
    :height="resolvedHeight"
    :enable-swipe-close="false"
    :body-scroll="false"
    @update-visible="handleUpdateVisible"
  >
    <scroll-view
      class="drawer-content"
      :scroll-y="true"
      :show-scrollbar="false"
    >
      <view v-if="loading" class="loading-container">
        <text class="loading-text">...</text>
      </view>
      <radio-group v-else class="radio-group" @change="handleRadioChange">
        <view
          v-for="(row, index) in rowList"
          :key="index"
          :class="['radio-item', { disabled: row.disabled }]"
        >
          <view class="item-info">
            <view class="radio-label-box">
              <text class="radio-text">{{ row.label }}</text>
              <text v-if="row.tag.length > 0" class="radio-tag">{{ row.tag }}</text>
            </view>
            <text
              v-if="row.desc.length > 0"
              :class="['radio-desc', { 'warning-text': row.warningDesc }]"
            >{{ row.desc }}</text>
          </view>
          <view
            v-if="row.previewUrl.length > 0"
            :class="['preview-action', { 'preview-action-playing': row.value == previewingValueSafe }]"
            hover-class="preview-action-active"
            @tap.stop="handlePreview(row)"
          >
            <text class="preview-action-icon">{{ row.value == previewingValueSafe ? '■' : '▶' }}</text>
            <text class="preview-action-text">{{ row.value == previewingValueSafe ? stopPreviewText : previewText }}</text>
          </view>
          <radio
            :value="row.value"
            :checked="row.selected"
            color="#5147ff"
            class="radio-icon"
            :disabled="row.disabled"
          />
        </view>
      </radio-group>
    </scroll-view>
  </uni-modal-popup>
</template>

<script lang="uts" setup>
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { ref, computed, watch, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import { RadioListItem } from "@/types/interfaces/radio";

  class RadioListRow {
    label: string;
    value: string;
    desc: string;
    tag: string;
    disabled: boolean;
    warningDesc: boolean;
    selected: boolean;
    previewUrl: string;

    constructor(
      label: string,
      value: string,
      desc: string,
      tag: string,
      disabled: boolean,
      warningDesc: boolean,
      selected: boolean,
      previewUrl: string,
    ) {
      this.label = label;
      this.value = value;
      this.desc = desc;
      this.tag = tag;
      this.disabled = disabled;
      this.warningDesc = warningDesc;
      this.selected = selected;
      this.previewUrl = previewUrl;
    }
  }

  const props = withDefaults(
    defineProps<{
      visible: boolean;
      title: string;
      list: RadioListItem[];
      currentValue?: string;
      readonly?: boolean;
      maxHeight?: string;
      loading?: boolean;
      previewText?: string;
      stopPreviewText?: string;
      previewingValue?: string;
      previewUrlList?: string[];
    }>(),
    {
      visible: false,
      title: "",
      list: () => [] as RadioListItem[],
      currentValue: "",
      readonly: false,
      /* #ifdef H5 */
      maxHeight: "70vh",
      /* #endif */
      /* #ifndef H5 */
      maxHeight: "70%",
      /* #endif */
      loading: false,
      previewText: "Preview",
      stopPreviewText: "Stop",
      previewingValue: "",
      previewUrlList: () => [] as string[],
    },
  );

  const emit = defineEmits<{
    (e: "onClose"): void;
    (e: "onChange", value: string): void;
    (e: "onPreview", value: string, previewUrl: string): void;
  }>();

  const modalPopupRef = ref<any | null>(null);

  /** uni-modal-popup 无 auto-height，用 maxHeight 作为底部抽屉高度 */
  const resolvedHeight = computed((): string => {
    const h = props.maxHeight;
    if (h != null && h.length > 0) {
      return h;
    }
    // #ifdef H5
    return "70vh";
    // #endif
    // #ifndef H5
    return "70%";
    // #endif
  });

  const currentValueSafe = computed((): string => {
    const v = props.currentValue;
    return v != null ? `${v}` : "";
  });

  const previewingValueSafe = computed((): string => {
    const v = props.previewingValue;
    return v != null ? `${v}` : "";
  });

  /**
   * 模板只消费这一份行数据，避免 Android UTS 在 v-for 内按索引读取并行数组。
   */
  const rowList = computed((): RadioListRow[] => {
    const raw = props.list;
    const result: RadioListRow[] = [];
    if (raw == null) {
      return result;
    }
    const cur = currentValueSafe.value;
    for (let i = 0; i < raw.length; i++) {
      const src = raw[i];
      if (src == null) {
        result.push(new RadioListRow("", "", "", "", true, false, false, ""));
        continue;
      }
      const label = src.label != null ? `${src.label}` : "";
      const value = src.value != null ? `${src.value}` : "";
      const previewUrl = i < props.previewUrlList.length ? props.previewUrlList[i] : "";
      result.push(new RadioListRow(
        label,
        value,
        src.desc != null ? `${src.desc}` : "",
        src.tag != null ? `${src.tag}` : "",
        props.readonly == true || src.disabled == true,
        src.warningDesc == true,
        value == cur && value.length > 0,
        previewUrl != null ? `${previewUrl}` : "",
      ));
    }
    return result;
  });

  const valueList = computed((): string[] => {
    const raw = props.list;
    const result: string[] = [];
    if (raw == null) {
      return result;
    }
    for (let i = 0; i < raw.length; i++) {
      const src = raw[i];
      if (src == null) {
        result.push("");
        continue;
      }
      result.push(src.value != null ? `${src.value}` : "");
    }
    return result;
  });

  const disabledList = computed((): boolean[] => {
    const raw = props.list;
    const result: boolean[] = [];
    if (raw == null) {
      return result;
    }
    const readonly = props.readonly == true;
    for (let i = 0; i < raw.length; i++) {
      const src = raw[i];
      result.push(readonly || (src != null && src.disabled == true));
    }
    return result;
  });

  /** Android：Gen* 组件 ref 禁止 as UTSJSONObject，用 $callMethod */
  const callModalPopupMethod = (methodName: string): void => {
    const refVal = modalPopupRef.value as any | null;
    if (refVal == null) {
      return;
    }
    try {
      const proxy = refVal as ComponentPublicInstance;
      proxy.$callMethod(methodName);
    } catch (_e) {
      // ignore
    }
  };

  watch(
    (): boolean => props.visible,
    (newVal: boolean): void => {
      if (newVal) {
        callModalPopupMethod("open");
      } else {
        callModalPopupMethod("close");
      }
    },
  );

  const handleUpdateVisible = (val: boolean) => {
    if (val != true) {
      emit("onClose");
    }
  };

  /**
   * 使用原生 radio-group 接收 Android 的选择事件；普通 view 的 tap 在嵌套文本上
   * 不会稳定冒泡到行容器，导致模式切换回调丢失。
   */
  const handleRadioChange = (e: RadioGroupChangeEvent): void => {
    const value = e.detail.value as string;
    if (value.length == 0 || value == currentValueSafe.value) {
      return;
    }
    const disableds = disabledList.value;
    const values = valueList.value;
    for (let i = 0; i < values.length; i++) {
      if (values[i] == value && disableds[i] != true) {
        emit("onChange", value);
        emit("onClose");
        return;
      }
    }
  };

  const handlePreview = (row: RadioListRow): void => {
    if (row.disabled || row.previewUrl.length == 0) return;
    emit("onPreview", row.value, row.previewUrl);
  };
</script>

<style lang="scss" scoped>
  .drawer-content {
    height: 100%;
    padding: 0 40rpx;
    /* #ifdef H5 || MP-WEIXIN */
    overflow-y: auto;
    /* #endif */
    /* #ifdef APP */
    overflow: hidden;
    /* #endif */
    box-sizing: border-box;
  }

  .radio-group {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .radio-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx 0;
    border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
  }

  .radio-item:last-child {
    border-bottom: none;
  }

  /* vapor: 原 &.disabled hoist 为同层单类（disabled 由 :class 动态挂载到 .radio-item）*/
  .disabled {
    opacity: 0.6;
  }

  .item-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6rpx;
    margin-right: 20rpx;
    min-width: 0;
  }

  .radio-label-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12rpx;
  }

  .radio-text {
    font-size: 30rpx;
    color: #1a1a1a;
    font-weight: 400;
  }

  .radio-tag {
    padding: 8rpx 12rpx;
    border-radius: 12rpx;
    background-color: rgba(81, 71, 255, 0.1);
    color: #5147ff;
    font-size: 24rpx;
    font-weight: 500;
    line-height: 1;
  }

  .radio-desc {
    color: #9ea3af;
    font-size: 24rpx;
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* vapor: 原 &.warning-text hoist 为同层单类（warning-text 由 :class 动态挂载到 .radio-desc）*/
  .warning-text {
    color: #ffa39e;
  }

        .radio-icon {
          transform: scale(0.9);
        }

        .preview-action {
          display: flex;
          flex-direction: row;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
          min-width: 112rpx;
          margin-right: 18rpx;
          padding: 10rpx 16rpx;
          border-radius: 24rpx;
          background-color: rgba(81, 71, 255, 0.08);

          &-active {
            opacity: 0.7;
          }

          &-playing {
            background-color: rgba(81, 71, 255, 0.16);
          }

          .preview-action-icon {
            margin-right: 8rpx;
            color: #5147ff;
            font-size: 20rpx;
          }

          .preview-action-text {
            color: #5147ff;
            font-size: 24rpx;
          }
        }

  .loading-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 60rpx 0;
    width: 100%;
  }

  .loading-text {
    font-size: 28rpx;
    color: #999;
  }
</style>
