<template>
  <view class="diff-content-wrapper">
    <view class="diff-table">
      <view
        v-for="(line, index) in linesList"
        :key="index"
        :class="['diff-line', 'diff-line-' + line.type]"
      >
        <!-- 行号：移动端只展示一列，删除行取旧行号，其余取新行号 -->
        <text :class="['line-number', 'line-number-' + line.type]">{{ getDisplayLineNum(line) }}</text>
        <!-- 标志 (+ / - / 空) -->
        <text :class="['line-sign', 'line-sign-' + line.type]">{{
          line.type === "added" ? "+" : line.type === "removed" ? "-" : " "
        }}</text>
        <!-- 代码/文本内容 -->
        <text :class="['line-content', 'line-content-' + line.type]">{{ line.content }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { computed } from "vue";
  import { DiffLineItem } from "../../types";

  interface DiffContentViewProps {
    diffLinesList: DiffLineItem[];
  }
  const props = defineProps<DiffContentViewProps>();

  const linesList = computed((): DiffLineItem[] => {
    return props.diffLinesList as DiffLineItem[];
  });

  function getDisplayLineNum(line: DiffLineItem): string {
    if (line.type === "removed") {
      return line.oldLineNum;
    }
    return line.newLineNum;
  }
</script>

<style lang="scss" scoped>
  /* vapor R3 撞色：line-number/line-sign/line-content 在 added(绿)/removed(红) 下色不同，
     不能 hoist 合并 → BEM 改名（line-number-added 等）+ 模板 :class 拼 line.type。
     .diff-line.normal/added/removed 复合也拆单类；后代/复合在 vapor styleIsolation 2.0 全丢。 */
  .diff-content-wrapper {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
    width: 100%;
    background-color: #ffffff;
  }

  .diff-table {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
  }

  .diff-line {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    min-height: 40rpx;
    line-height: 40rpx;
    font-size: 24rpx;
    width: 100%;
    overflow: hidden;
  }

  /* 行号基类（灰底灰字）*/
  .line-number {
    width: 70rpx;
    text-align: right;
    padding-right: 12rpx;
    color: #8c959f;
    /* #ifdef H5 || WEB */
    user-select: none;
    /* #endif */
    font-family: monospace;
    font-size: 20rpx;
    background-color: #f6f8fa;
    border-right: 1rpx solid #d0d7de;
    flex-shrink: 0;
  }

  .line-sign {
    width: 36rpx;
    text-align: center;
    font-weight: bold;
    /* #ifdef H5 || WEB */
    user-select: none;
    /* #endif */
    font-family: monospace;
    font-size: 22rpx;
    flex-shrink: 0;
  }

  .line-content {
    padding-left: 12rpx;
    padding-right: 12rpx;
    font-family: monospace, Courier, monospace;
    white-space: pre-wrap;
    /* #ifdef H5 || WEB */
    word-break: break-all;
    overflow-wrap: anywhere;
    /* #endif */
    flex: 1;
    min-width: 0;
    font-size: 22rpx;
  }

  /* 变体 normal：基类白底，无需覆盖（模板仍挂 diff-line-normal 空类，无害）*/

  /* 变体 added（绿）*/
  .diff-line-added {
    background-color: rgba(46, 160, 67, 0.12);
  }
  .line-number-added {
    background-color: rgba(46, 160, 67, 0.22);
    color: #1a7f37;
  }
  .line-sign-added {
    color: #1a7f37;
  }
  .line-content-added {
    color: #1a7f37;
  }

  /* 变体 removed（红）*/
  .diff-line-removed {
    background-color: rgba(248, 81, 73, 0.12);
  }
  .line-number-removed {
    background-color: rgba(248, 81, 73, 0.22);
    color: #cf222e;
  }
  .line-sign-removed {
    color: #cf222e;
  }
  .line-content-removed {
    color: #cf222e;
  }
</style>
