<template><native-view class="voip-native-video" @init="initView" /></template>
<script setup lang="uts">
  import { onUnmounted } from "vue";
  import { VoipVideoBinding } from "@/uni_modules/nuwax-voip";
  const props = defineProps({ local: { type: Boolean, default: false } });
  let binding: VoipVideoBinding | null = null;
  function initView(event: UniNativeViewInitEvent): void { binding = new VoipVideoBinding(event.detail.element, props.local); }
  onUnmounted(() => { binding?.dispose(); binding = null; });
</script>
<style scoped>.voip-native-video { flex: 1; background-color: #11151c; }</style>
