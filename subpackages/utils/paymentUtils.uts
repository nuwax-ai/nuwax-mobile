const ANXINFU_MINIPROGRAM_USER_NAME = "gh_cd6acad9a40d";
const ANXINFU_MINIPROGRAM_PATH = "ipay/main";
const ACTIVE_APP_PAY_SESSION = "ACTIVE_APP_PAY_SESSION";
const APP_PAY_SESSION_TTL_MS = 30 * 60 * 1000;

/** H5 是否运行在 App 的内嵌 web-view 中。 */
export function isEmbeddedAppWebView(): boolean {
  // #ifdef H5 || WEB
  try {
    const w = window as any;
    const href = window.location.href;
    if (
      href.indexOf("appEmbedded=1") >= 0 ||
      href.indexOf("appEmbedded%3D1") >= 0
    ) {
      return true;
    }
    const uniGlobal = w.uni;
    if (
      w.__uniapp_x_postMessage != null ||
      w.__uniapp_x_ != null ||
      (uniGlobal != null && uniGlobal.webView != null)
    ) {
      return true;
    }
    return w.sessionStorage != null &&
      w.sessionStorage.getItem("__nuwax_app_webview") == "1";
  } catch (_error) {
    return false;
  }
  // #endif
  return false;
}

/** 从网关 weixin:// redirectUrl 中提取 query= 后的 Base64 原文。 */
export function parseAnxinfuMiniProgramParam(redirectUrl: string | null): string {
  if (redirectUrl == null || redirectUrl.length == 0) {
    return "";
  }
  const marker = "query=";
  const queryIndex = redirectUrl.indexOf(marker);
  if (queryIndex < 0) {
    return "";
  }
  const valueStart = queryIndex + marker.length;
  const ampIndex = redirectUrl.indexOf("&", valueStart);
  const encodedParam = ampIndex < 0
    ? redirectUrl.substring(valueStart)
    : redirectUrl.substring(valueStart, ampIndex);
  if (encodedParam.length == 0) {
    return "";
  }
  try {
    // 网关 URL 可能将 Base64 末尾的 = 编成 %3D；还原后直接传给小程序，禁止再次编码。
    const decodedParam = decodeURIComponent(encodedParam);
    return decodedParam ?? encodedParam;
  } catch (_error) {
    // 保留原始值，由支付端返回明确的参数错误，避免解析失败导致无法调起。
    return encodedParam;
  }
}

// ========== APP 原生支付桥 ===========
// #ifdef APP

export interface AppNativePayBridge {
  launchAnxinfuMiniProgram(options: UTSJSONObject): Promise<any>;
  openPayUrl(url: string): Promise<any>;
}

let appNativePayBridge: AppNativePayBridge | null = null;

/** 由 Android / iOS / HarmonyOS 宿主在初始化原生支付模块后注入。 */
export function registerAppNativePayBridge(bridge: AppNativePayBridge): void {
  appNativePayBridge = bridge;
}

/**
 * 调用宿主注入的 NativePay / wx.miniapp 桥拉起安心付微信小程序。
 * param 必须保持网关 Base64 原文，禁止 encodeURIComponent。
 */
export function launchAnxinfuMiniProgram(redirectUrl: string): Promise<any> {
  const param = parseAnxinfuMiniProgramParam(redirectUrl);
  if (param.length == 0) {
    return new Promise((_resolve, reject) => {
      reject(new Error("invalid anxinfu mini-program redirectUrl"));
    });
  }

  const options = {
    userName: ANXINFU_MINIPROGRAM_USER_NAME,
    path: ANXINFU_MINIPROGRAM_PATH + "?" + param,
    miniprogramType: 0,
    // 鸿蒙 scheme 兜底实现需要网关原始 redirectUrl，Android / iOS 不使用。
    redirectUrl: redirectUrl,
  } as UTSJSONObject;

  // #ifdef APP-ANDROID
  // 分包可能加载独立的 UTS 模块实例，Android 直接调用原生插件，避免依赖跨分包的桥注册状态。
  return launchAnxinfuMiniProgramNative(
    options.getString("userName") ?? "",
    options.getString("path") ?? "",
  );
  // #endif

  // #ifdef APP-HARMONY
  // 同 Android：鸿蒙也存在分包独立 UTS 模块实例的问题，直接调原生插件不依赖桥注册状态。
  return launchAnxinfuMiniProgramHarmony(
    options.getString("userName") ?? "",
    options.getString("path") ?? "",
  );
  // #endif

  // #ifndef APP-ANDROID || APP-HARMONY
  if (appNativePayBridge == null) {
    return new Promise((_resolve, reject) => {
      reject(new Error("native wx.miniapp bridge is unavailable"));
    });
  }
  return appNativePayBridge!.launchAnxinfuMiniProgram(options);
  // #endif
}

/** 支付宝 redirectUrl 交由宿主打开，避免在业务层绑定平台 SDK。 */
export function openAppPayUrl(url: string): Promise<any> {
  // #ifdef APP-ANDROID
  return openPayUrlNative(url);
  // #endif

  // #ifdef APP-HARMONY
  return openPayUrlHarmony(url);
  // #endif

  // #ifndef APP-ANDROID || APP-HARMONY
  if (appNativePayBridge == null) {
    return new Promise((_resolve, reject) => {
      reject(new Error("native pay url bridge is unavailable"));
    });
  }
  return appNativePayBridge!.openPayUrl(url);
  // #endif
}

function readAppPaySession(): UTSJSONObject | null {
  const raw = uni.getStorageSync(ACTIVE_APP_PAY_SESSION);
  const text = raw != null ? `${raw}` : "";
  if (text.length == 0) {
    return null;
  }
  try {
    const session = JSON.parse<UTSJSONObject>(text);
    if (session == null) {
      uni.removeStorageSync(ACTIVE_APP_PAY_SESSION);
      return null;
    }
    const createdAtRaw = session["createdAt"];
    const createdAt = createdAtRaw != null ? parseFloat(`${createdAtRaw}`) : 0;
    if (
      createdAt <= 0 ||
      Date.now() - createdAt > APP_PAY_SESSION_TTL_MS
    ) {
      uni.removeStorageSync(ACTIVE_APP_PAY_SESSION);
      return null;
    }
    return session;
  } catch (_error) {
    uni.removeStorageSync(ACTIVE_APP_PAY_SESSION);
    return null;
  }
}

function writeAppPaySession(session: UTSJSONObject): void {
  uni.setStorageSync(ACTIVE_APP_PAY_SESSION, JSON.stringify(session));
}

/** 原生收到 H5 请求时先持久化，重复 requestId 只确认、不重复拉起。 */
export function beginAppNativePaySession(
  orderId: number,
  requestId: string,
  payChannel: string,
): boolean {
  const current = readAppPaySession();
  if (
    current != null &&
    current["requestId"] != null &&
    `${current["requestId"]}` == requestId
  ) {
    return false;
  }
  const session = new UTSJSONObject();
  session["orderId"] = orderId as any;
  session["requestId"] = requestId;
  session["payChannel"] = payChannel;
  session["state"] = "REQUESTED";
  session["result"] = "";
  session["createdAt"] = Date.now() as any;
  writeAppPaySession(session);
  return true;
}

/** 记录可重放的终态结果；pending 继续保持为可查询会话。 */
export function storeAppNativePayResult(
  requestId: string,
  result: string,
): void {
  const session = readAppPaySession();
  if (session == null) {
    return;
  }
  const storedRequestId = session["requestId"] != null
    ? `${session["requestId"]}`
    : "";
  if (requestId.length > 0 && storedRequestId != requestId) {
    return;
  }
  if (result == "pending") {
    session["state"] = "LAUNCHED";
    session["result"] = "";
    writeAppPaySession(session);
    return;
  }
  session["state"] = "SETTLED";
  session["result"] = result;
  writeAppPaySession(session);
}

/** 获取已产生、但 H5 尚未确认消费的结果。 */
export function getStoredAppNativePayResult(): UTSJSONObject | null {
  const session = readAppPaySession();
  if (session == null) {
    return null;
  }
  const result = session["result"] != null ? `${session["result"]}` : "";
  if (result.length == 0) {
    return null;
  }
  return session;
}

/** H5 确认消费后清理；requestId 不匹配时禁止误删其他订单。 */
export function acknowledgeAppNativePayResult(requestId: string): void {
  const session = readAppPaySession();
  if (session == null) {
    return;
  }
  const storedRequestId = session["requestId"] != null
    ? `${session["requestId"]}`
    : "";
  if (storedRequestId == requestId) {
    uni.removeStorageSync(ACTIVE_APP_PAY_SESSION);
  }
}

/**
 * 请求 app-native 收银台参数并落盘 LAUNCHED，返回 redirectUrl。
 *
 * 与拉起动作拆开，是为了让调用方能在「网络请求」和「切到第三方 App」之间
 * 精确控制 loading：请求期间保持「支付处理中」遮罩，拿到参数后立刻撤掉。
 */
export async function requestAppNativePayRedirect(
  orderId: number,
  payChannelValue: string,
  requestId: string,
): Promise<string> {
  const effectiveRequestId = requestId.length > 0
    ? requestId
    : `native_${orderId}_${Date.now()}`;
  let current = readAppPaySession();
  const currentRequestId = current != null && current["requestId"] != null
    ? `${current["requestId"]}`
    : "";
  if (current == null || currentRequestId != effectiveRequestId) {
    beginAppNativePaySession(orderId, effectiveRequestId, payChannelValue);
    current = readAppPaySession();
  }
  const requestData = new UTSJSONObject();
  requestData["orderId"] = orderId as any;
  requestData["payChannel"] = payChannelValue as any;
  const payRes = await apiPayAppNative(requestData);
  const payData = apiResData<any>(payRes) as UTSJSONObject | null;
  if (apiResCode(payRes) != SUCCESS_CODE || payData == null) {
    throw new Error(orString(payRes["message"], "app-native pay failed"));
  }

  const redirectUrlRaw = payData["redirectUrl"];
  const redirectUrl = redirectUrlRaw != null ? `${redirectUrlRaw}` : "";
  if (redirectUrl.length == 0) {
    throw new Error("app-native redirectUrl is missing");
  }

  // 必须在切出 App 前落盘。部分原生插件会等第三方页面返回后才 resolve，
  // 若返回后再写，页面 onShow 会先执行并因状态仍是 REQUESTED 而漏掉查单。
  const latest = readAppPaySession();
  const latestRequestId = latest != null && latest["requestId"] != null
    ? `${latest["requestId"]}`
    : "";
  if (latest == null || latestRequestId != effectiveRequestId) {
    throw new Error("app-native pay session was superseded");
  }
  latest["state"] = "LAUNCHED";
  writeAppPaySession(latest);

  return redirectUrl;
}

/** 用已拿到的 redirectUrl 拉起第三方收银台（微信小程序 / 支付宝）。 */
export async function launchAppNativePayRedirect(
  payChannelValue: string,
  redirectUrl: string,
): Promise<void> {
  if (payChannelValue == "WxPay") {
    if (redirectUrl.indexOf("weixin://") != 0) {
      throw new Error("wechat app-native redirectUrl is invalid");
    }
    await launchAnxinfuMiniProgram(redirectUrl);
  } else {
    await openAppPayUrl(redirectUrl);
  }
}

/**
 * 按指定渠道请求 app-native 参数并拉起原生收银台。
 * 保留原签名给 web-view 宿主（agent-detail.uvue）调用，行为不变。
 */
export async function launchAppNativePayByChannel(
  orderId: number,
  payChannelValue: string,
  requestId: string = "",
): Promise<void> {
  const redirectUrl = await requestAppNativePayRedirect(
    orderId,
    payChannelValue,
    requestId,
  );
  await launchAppNativePayRedirect(payChannelValue, redirectUrl);
}

// #endif

// ========== H5 / WEB 工具函数 ==========
// #ifdef H5 || WEB

/** 同一次第三方回跳结果只提示一次，避免 pageshow / mounted 重复弹 Toast。 */
const alertedKeys = new Set<string>();

class EmbeddedAppPayContext {
  requestId: string;
  orderId: number;
  payChannel: string;
  processingId: Ref<number | null>;
  loading: Ref<boolean>;
  t: (key: string) => string;
  onSuccess: (() => void) | null;
  accepted: boolean = false;
  launched: boolean = false;
  attempts: number = 0;
  retryTimer: number = 0;
  launchTimer: number = 0;

  constructor(
    requestId: string,
    orderId: number,
    payChannel: string,
    processingId: Ref<number | null>,
    loading: Ref<boolean>,
    t: (key: string) => string,
    onSuccess?: () => void,
  ) {
    this.requestId = requestId;
    this.orderId = orderId;
    this.payChannel = payChannel;
    this.processingId = processingId;
    this.loading = loading;
    this.t = t;
    this.onSuccess = onSuccess != null ? onSuccess : null;
  }
}

class EmbeddedAppPayResultConsumer {
  id: string;
  processingId: Ref<number | null>;
  loading: Ref<boolean>;
  t: (key: string) => string;
  onSuccess: (() => void) | null;
  syncAttempts: number = 0;
  syncTimer: number = 0;

  constructor(
    id: string,
    processingId: Ref<number | null>,
    loading: Ref<boolean>,
    t: (key: string) => string,
    onSuccess?: () => void,
  ) {
    this.id = id;
    this.processingId = processingId;
    this.loading = loading;
    this.t = t;
    this.onSuccess = onSuccess != null ? onSuccess : null;
  }
}

const embeddedAppPayContexts = new Map<string, EmbeddedAppPayContext>();
const consumedEmbeddedAppPayRequestIds = new Set<string>();
let embeddedAppPayGlobalsInstalled = false;
let embeddedAppPayResultConsumer: EmbeddedAppPayResultConsumer | null = null;

/** H5 → App：优先 JSSDK，未注入完成时直接使用 uni-app x 底层桥。 */
function postEmbeddedAppPayMessage(payload: UTSJSONObject): boolean {
  try {
    const w = window as any;
    const uniGlobal = w.uni;
    if (
      uniGlobal != null &&
      uniGlobal.webView != null &&
      uniGlobal.webView.postMessage != null
    ) {
      uniGlobal.webView.postMessage({ "data": payload });
      return true;
    }
    const envelope = { "data": payload } as UTSJSONObject;
    if (w.__uniapp_x_postMessage != null) {
      w.__uniapp_x_postMessage(envelope);
      return true;
    }
    if (
      w.__uniapp_x_ != null &&
      w.__uniapp_x_.postMessage != null
    ) {
      w.__uniapp_x_.postMessage(JSON.stringify(envelope));
      return true;
    }
  } catch (error) {
    console.warn("[native-pay] postMessage failed", error);
  }
  return false;
}

function sendEmbeddedAppPayResultAck(requestId: string): void {
  postEmbeddedAppPayMessage({
    "type": "native-pay-result-ack",
    "requestId": requestId,
  } as UTSJSONObject);
}

function clearEmbeddedAppPayContext(context: EmbeddedAppPayContext): void {
  if (context.retryTimer != 0) {
    clearTimeout(context.retryTimer);
    context.retryTimer = 0;
  }
  if (context.launchTimer != 0) {
    clearTimeout(context.launchTimer);
    context.launchTimer = 0;
  }
  embeddedAppPayContexts.delete(context.requestId);
}

function failEmbeddedAppPayRequest(context: EmbeddedAppPayContext): void {
  clearEmbeddedAppPayContext(context);
  uni.hideLoading();
  context.loading.value = false;
  context.processingId.value = null;
  uni.showToast({
    title: context.t("Mobile.MySubscriptions.payFailed"),
    icon: "none",
  });
}

function consumeEmbeddedAppPayResult(
  result: string,
  processingId: Ref<number | null>,
  loading: Ref<boolean>,
  t: (key: string) => string,
  onSuccess: (() => void) | null,
): void {
  clearPayConfirmSession(0);
  uni.hideLoading();
  loading.value = false;
  processingId.value = null;
  if (onSuccess != null) {
    handlePayResultToast(result, t, onSuccess);
  } else {
    handlePayResultToast(result, t);
  }
}

function releaseEmbeddedAppPayLock(
  processingId: Ref<number | null>,
  loading: Ref<boolean>,
): void {
  uni.hideLoading();
  loading.value = false;
  processingId.value = null;
}

function stopEmbeddedAppPayResultSync(
  consumer: EmbeddedAppPayResultConsumer,
): void {
  if (consumer.syncTimer != 0) {
    clearTimeout(consumer.syncTimer);
    consumer.syncTimer = 0;
  }
}

function scheduleEmbeddedAppPayResultSync(
  consumer: EmbeddedAppPayResultConsumer,
): void {
  consumer.syncAttempts += 1;
  postEmbeddedAppPayMessage({
    "type": "native-pay-result-sync",
    "consumerId": consumer.id,
  } as UTSJSONObject);
  consumer.syncTimer = setTimeout((): void => {
    consumer.syncTimer = 0;
    const activeConsumer = embeddedAppPayResultConsumer;
    if (
      activeConsumer == null ||
      activeConsumer.id != consumer.id ||
      consumer.syncAttempts >= 10
    ) {
      return;
    }
    scheduleEmbeddedAppPayResultSync(consumer);
  }, 300) as number;
}

/** 旧版 App 壳不发 launched 时的兜底：最多压 8 秒遮罩就切确认框。 */
const EMBEDDED_LAUNCH_FALLBACK_MS = 8000;

/** 原生已拿到收银台参数、即将切走：撤遮罩、解锁、弹支付确认框。 */
function handleEmbeddedAppPayLaunched(requestId: string): void {
  const context = embeddedAppPayContexts.get(requestId);
  if (context == null || context.launched == true) {
    return;
  }
  context.launched = true;
  if (context.launchTimer != 0) {
    clearTimeout(context.launchTimer);
    context.launchTimer = 0;
  }
  // 解锁：用户可能只是在收银台取消，不该被锁到超时
  uni.hideLoading();
  context.loading.value = false;
  context.processingId.value = null;
  beginPayConfirmSession(context.orderId, context.payChannel);
  openPayAwaitConfirmDialog(
    context.orderId,
    context.payChannel,
    context.t,
    context.onSuccess,
  ).catch((): void => {});
}

function scheduleEmbeddedAppPayRequest(context: EmbeddedAppPayContext): void {
  if (context.accepted == true) {
    return;
  }
  context.attempts += 1;
  postEmbeddedAppPayMessage({
    "type": "native-pay",
    "requestId": context.requestId,
    "orderId": context.orderId,
    "payChannel": context.payChannel,
  } as UTSJSONObject);
  context.retryTimer = setTimeout((): void => {
    context.retryTimer = 0;
    if (context.accepted == true) {
      return;
    }
    if (context.attempts >= 10) {
      failEmbeddedAppPayRequest(context);
      return;
    }
    scheduleEmbeddedAppPayRequest(context);
  }, 300) as number;
}

function ensureEmbeddedAppPayGlobals(): void {
  if (embeddedAppPayGlobalsInstalled == true) {
    return;
  }
  embeddedAppPayGlobalsInstalled = true;
  const w = window as any;
  w.__nuwaxOnNativePayAccepted = (requestId: string): void => {
    const context = embeddedAppPayContexts.get(requestId);
    if (context == null) {
      return;
    }
    context.accepted = true;
    if (context.retryTimer != 0) {
      clearTimeout(context.retryTimer);
      context.retryTimer = 0;
    }
    // 原生只是「收到请求」，收银台参数还在请求中：继续压着「支付处理中」遮罩，
    // 等 launched 再切确认框，避免用户先看到确认框、几秒后才被切走。
    // 旧版 App 壳不发 launched（H5 会先于 App 发版），用看门狗兜底。
    context.launchTimer = setTimeout((): void => {
      context.launchTimer = 0;
      handleEmbeddedAppPayLaunched(context.requestId);
    }, EMBEDDED_LAUNCH_FALLBACK_MS) as number;
  };
  w.__nuwaxOnNativePayLaunched = (requestId: string): void => {
    handleEmbeddedAppPayLaunched(requestId);
  };
  w.__nuwaxOnNativePaySyncComplete = (consumerId: string): void => {
    const consumer = embeddedAppPayResultConsumer;
    if (consumer != null && consumer.id == consumerId) {
      stopEmbeddedAppPayResultSync(consumer);
    }
  };
  w.__nuwaxOnNativePayResult = (
    requestId: string,
    result: string,
  ): void => {
    if (consumedEmbeddedAppPayRequestIds.has(requestId)) {
      sendEmbeddedAppPayResultAck(requestId);
      return;
    }
    const context = embeddedAppPayContexts.get(requestId);
    if (result == "pending") {
      if (context != null) {
        clearEmbeddedAppPayContext(context);
        releaseEmbeddedAppPayLock(context.processingId, context.loading);
      } else if (embeddedAppPayResultConsumer != null) {
        const consumer = embeddedAppPayResultConsumer;
        releaseEmbeddedAppPayLock(consumer.processingId, consumer.loading);
      }
      // pending 只解除 H5 交互锁，原生会话继续保留供后续 onShow 查单。
      return;
    }
    const dialogOrderId = context != null
      ? context.orderId
      : getPayConfirmSessionOrderId();
    if (isPayConfirmDialogOpen() && dialogOrderId > 0) {
      // 用户正对着确认框：缓存终态并 ACK，等他点按钮时秒回结果
      storePayConfirmAutoResult(dialogOrderId, result);
      if (context != null) {
        clearEmbeddedAppPayContext(context);
      }
      consumedEmbeddedAppPayRequestIds.add(requestId);
      sendEmbeddedAppPayResultAck(requestId);
      return;
    }
    let consumed = false;
    if (context != null) {
      clearEmbeddedAppPayContext(context);
      try {
        consumeEmbeddedAppPayResult(
          result,
          context.processingId,
          context.loading,
          context.t,
          context.onSuccess,
        );
        consumed = true;
      } catch (error) {
        console.error("[native-pay] result consumer failed", error);
      }
    } else if (embeddedAppPayResultConsumer != null) {
      const consumer = embeddedAppPayResultConsumer;
      try {
        consumeEmbeddedAppPayResult(
          result,
          consumer.processingId,
          consumer.loading,
          consumer.t,
          consumer.onSuccess,
        );
        consumed = true;
      } catch (error) {
        console.error("[native-pay] recovered result consumer failed", error);
      }
    }
    // 只有页面已刷新/提示结果后才能确认消费；没有消费者时让原生继续保留并重放。
    if (consumed == true) {
      consumedEmbeddedAppPayRequestIds.add(requestId);
      sendEmbeddedAppPayResultAck(requestId);
    }
  };
}

/** 页面挂载即注册恢复消费者，并主动向原生请求重放未 ACK 的结果。 */
export function registerEmbeddedAppPayResultConsumer(
  processingId: Ref<number | null>,
  loading: Ref<boolean>,
  t: (key: string) => string,
  onSuccess?: () => void,
): string {
  if (isEmbeddedAppWebView() != true) {
    return "";
  }
  ensureEmbeddedAppPayGlobals();
  const previousConsumer = embeddedAppPayResultConsumer;
  if (previousConsumer != null) {
    stopEmbeddedAppPayResultSync(previousConsumer);
  }
  const consumerId = `app_pay_consumer_${Date.now()}_${Math.floor(Math.random() * 100000)}`;
  embeddedAppPayResultConsumer = new EmbeddedAppPayResultConsumer(
    consumerId,
    processingId,
    loading,
    t,
    onSuccess,
  );
  const registeredConsumer = embeddedAppPayResultConsumer;
  if (registeredConsumer != null) {
    scheduleEmbeddedAppPayResultSync(registeredConsumer);
  }
  return consumerId;
}

/** 只注销当前组件自己的消费者，避免旧组件卸载时清掉新页面注册项。 */
export function unregisterEmbeddedAppPayResultConsumer(consumerId: string): void {
  const consumer = embeddedAppPayResultConsumer;
  if (consumerId.length > 0 && consumer != null && consumer.id == consumerId) {
    stopEmbeddedAppPayResultSync(consumer);
    embeddedAppPayResultConsumer = null;
  }
}

export interface PayResultFromUrl {
  payResult: string;
  orderId: string;
}

export interface ClientEnvInfo {
  isWeChat: boolean;
  isAlipay: boolean;
  isMobile: boolean;
  isSystemBrowser: boolean;
}

/**
 * 清除 URL 中的 payResult / orderId 参数（search 和 hash 均处理）
 */
export function cleanUrlParams(): void {
  // 清空 window.location.search 中的参数
  const search = window.location.search;
  if (search !== "") {
    const params = new URLSearchParams(search);
    if (params.has("payResult") || params.has("orderId")) {
      params.delete("payResult");
      params.delete("orderId");
      const searchStr = params.toString();
      const newSearch = searchStr ? `?${searchStr}` : "";
      const newUrl =
        window.location.pathname + newSearch + window.location.hash;
      window.history.replaceState(null, "", newUrl);
    }
  }

  // 清空 window.location.hash 中的参数
  const hash = window.location.hash;
  const qIndex = hash.indexOf("?");
  if (qIndex !== -1) {
    const pathPart = hash.substring(0, qIndex);
    const hashSearch = hash.substring(qIndex);
    const params = new URLSearchParams(hashSearch);
    if (params.has("payResult") || params.has("orderId")) {
      params.delete("payResult");
      params.delete("orderId");
      const searchStr = params.toString();
      const newHash = pathPart + (searchStr ? `?${searchStr}` : "");
      const newUrl =
        window.location.pathname + window.location.search + newHash;
      window.history.replaceState(null, "", newUrl);
    }
  }
}

/**
 * 从 URL（search → hash）中解析 payResult 和 orderId
 */
export function parsePayResultFromUrl(): PayResultFromUrl {
  const hash = window.location.hash;
  const search = window.location.search;

  let payResult = "";
  let orderId = "";

  // 优先从 main search 上解析
  if (search !== "") {
    const searchParams = new URLSearchParams(search);
    payResult = orEmpty(searchParams.get("payResult"));
    orderId = orEmpty(searchParams.get("orderId"));
  }

  // 若无，从 hash search 中解析
  if (payResult === "") {
    const qIndex = hash.indexOf("?");
    if (qIndex !== -1) {
      const hashSearch = hash.substring(qIndex);
      const hashParams = new URLSearchParams(hashSearch);
      payResult = orEmpty(hashParams.get("payResult"));
      orderId = orEmpty(hashParams.get("orderId"));
    }
  }

  return { payResult, orderId };
}

/**
 * 检测浏览器环境（微信 / 支付宝 / 系统浏览器）
 */
export function detectClientEnv(): ClientEnvInfo {
  const ua = orEmpty(navigator.userAgent);
  const isWeChat = /MicroMessenger/i.test(ua);
  const isAlipay = /AlipayClient/i.test(ua);
  const isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(ua);

  return {
    isWeChat,
    isAlipay,
    isMobile,
    isSystemBrowser: isMobile && !isWeChat && !isAlipay,
  };
}

/**
 * 微信 JSAPI 支付唤起接口
 */
export function invokeJsapi(p: any): Promise<any> {
  const payload = {
    appId: p.appId,
    timeStamp: p.timeStamp,
    nonceStr: p.nonceStr,
    package: p.packageValue,
    signType: p.signType,
    paySign: p.paySign,
  };

  return new Promise((resolve) => {
    const doInvoke = () => {
      // @ts-ignore
      if (typeof WeixinJSBridge !== "undefined") {
        // @ts-ignore
        WeixinJSBridge.invoke("getBrandWCPayRequest", payload, (res) => {
          resolve(res);
        });
      } else {
        resolve({ err_msg: "get_brand_wcpay_request:fail" });
      }
    };
    // @ts-ignore
    if (typeof WeixinJSBridge === "undefined") {
      document.addEventListener("WeixinJSBridgeReady", doInvoke, {
        once: true,
      });
      // 超时保护
      setTimeout(() => {
        // @ts-ignore
        if (typeof WeixinJSBridge !== "undefined") {
          doInvoke();
        } else {
          resolve({ err_msg: "get_brand_wcpay_request:fail" });
        }
      }, 3000);
    } else {
      doInvoke();
    }
  });
}

/**
 * 清除 URL 中的 wechat code 和 state 参数（避免刷新重复发起支付）
 */
export function cleanWechatOaParams(): void {
  // 清空 window.location.search 中的参数
  const search = window.location.search;
  if (search !== "") {
    const params = new URLSearchParams(search);
    if (params.has("code") || params.has("state")) {
      params.delete("code");
      params.delete("state");
      const searchStr = params.toString();
      const newSearch = searchStr ? `?${searchStr}` : "";
      const newUrl =
        window.location.pathname + newSearch + window.location.hash;
      window.history.replaceState(null, "", newUrl);
    }
  }

  // 清空 window.location.hash 中的参数
  const hash = window.location.hash;
  const qIndex = hash.indexOf("?");
  if (qIndex !== -1) {
    const pathPart = hash.substring(0, qIndex);
    const hashSearch = hash.substring(qIndex);
    const params = new URLSearchParams(hashSearch);
    if (params.has("code") || params.has("state")) {
      params.delete("code");
      params.delete("state");
      const searchStr = params.toString();
      const newHash = pathPart + (searchStr ? `?${searchStr}` : "");
      const newUrl =
        window.location.pathname + window.location.search + newHash;
      window.history.replaceState(null, "", newUrl);
    }
  }
}

/**
 * 清除 URL 中的 h5OrderId 参数（避免刷新重复发起支付轮询）
 */
export function cleanH5Params(): void {
  const search = window.location.search;
  if (search !== "") {
    const params = new URLSearchParams(search);
    if (params.has("h5OrderId")) {
      params.delete("h5OrderId");
      const searchStr = params.toString();
      const newSearch = searchStr ? `?${searchStr}` : "";
      const newUrl =
        window.location.pathname + newSearch + window.location.hash;
      window.history.replaceState(null, "", newUrl);
    }
  }

  const hash = window.location.hash;
  const qIndex = hash.indexOf("?");
  if (qIndex !== -1) {
    const pathPart = hash.substring(0, qIndex);
    const hashSearch = hash.substring(qIndex);
    const params = new URLSearchParams(hashSearch);
    if (params.has("h5OrderId")) {
      params.delete("h5OrderId");
      const searchStr = params.toString();
      const newHash = pathPart + (searchStr ? `?${searchStr}` : "");
      const newUrl =
        window.location.pathname + window.location.search + newHash;
      window.history.replaceState(null, "", newUrl);
    }
  }
}

/**
 * 将 h5OrderId 拼接至指定的 URL 中（自动判定并解析 hash 或 search 参数位置）
 */
export function appendH5OrderIdToUrl(url: string, orderId: number): string {
  const hashIndex = url.indexOf("#");
  if (hashIndex !== -1) {
    const baseUrlPart = url.substring(0, hashIndex);
    const hashPart = url.substring(hashIndex);
    const qIndex = hashPart.indexOf("?");
    if (qIndex !== -1) {
      return baseUrlPart + hashPart + "&h5OrderId=" + orderId;
    } else {
      return baseUrlPart + hashPart + "?h5OrderId=" + orderId;
    }
  } else {
    const qIndex = url.indexOf("?");
    if (qIndex !== -1) {
      return url + "&h5OrderId=" + orderId;
    } else {
      return url + "?h5OrderId=" + orderId;
    }
  }
}

/**
 * 在 H5 端渲染微信支付二维码 Modal，并在后台发起结算状态轮询
 */
export async function renderQrCodeModal(
  qrCodeContent: string,
  orderId: number,
  t: (key: string) => string,
  onSuccess?: () => void,
  onClose?: () => void,
): Promise<void> {
  const overlay = document.createElement("div");
  overlay.id = "pay-qrcode-modal";
  overlay.style.position = "fixed";
  overlay.style.top = "0";
  overlay.style.left = "0";
  overlay.style.right = "0";
  overlay.style.bottom = "0";
  overlay.style.backgroundColor = "rgba(0, 0, 0, 0.65)";
  overlay.style.display = "flex";
  overlay.style.justifyContent = "center";
  overlay.style.alignItems = "center";
  overlay.style.zIndex = "999999";
  overlay.style.backdropFilter = "blur(4px)";
  overlay.style.transition = "opacity 0.2s ease";
  overlay.style.opacity = "0";

  const card = document.createElement("div");
  card.style.backgroundColor = "#ffffff";
  card.style.borderRadius = "16px";
  card.style.padding = "24px";
  card.style.display = "flex";
  card.style.flexDirection = "column";
  card.style.alignItems = "center";
  card.style.width = "280px";
  card.style.boxSizing = "border-box";
  card.style.position = "relative";
  card.style.boxShadow = "0 8px 30px rgba(0, 0, 0, 0.15)";
  card.style.transform = "scale(0.9)";
  card.style.transition = "transform 0.2s ease, opacity 0.2s ease";

  const closeBtn = document.createElement("span");
  closeBtn.innerHTML = "×";
  closeBtn.style.position = "absolute";
  closeBtn.style.top = "4px";
  closeBtn.style.right = "14px";
  closeBtn.style.fontSize = "28px";
  closeBtn.style.color = "#999999";
  closeBtn.style.cursor = "pointer";
  closeBtn.style.lineHeight = "1";

  const title = document.createElement("h3");
  title.innerHTML = t("Mobile.MySubscriptions.wechatPay");
  title.style.margin = "0 0 16px 0";
  title.style.fontSize = "16px";
  title.style.fontWeight = "600";
  title.style.color = "#111111";

  const img = document.createElement("img");
  const encodedData = encodeURIComponent(qrCodeContent);
  img.src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodedData}`;
  img.style.width = "200px";
  img.style.height = "200px";
  img.style.marginBottom = "16px";
  img.style.borderRadius = "8px";

  const desc = document.createElement("p");
  desc.innerHTML = t("Mobile.MySubscriptions.qrCodeUnsupported");
  desc.style.margin = "0";
  desc.style.fontSize = "13px";
  desc.style.color = "#666666";
  desc.style.textAlign = "center";
  desc.style.lineHeight = "1.5";

  card.appendChild(closeBtn);
  card.appendChild(title);
  card.appendChild(img);
  card.appendChild(desc);
  overlay.appendChild(card);
  document.body.appendChild(overlay);

  setTimeout(() => {
    overlay.style.opacity = "1";
    card.style.transform = "scale(1)";
  }, 10);

  const closeHandler = () => {
    card.style.transform = "scale(0.9)";
    overlay.style.opacity = "0";
    setTimeout(() => {
      if (document.body.contains(overlay)) {
        document.body.removeChild(overlay);
      }
    }, 200);
    onClose?.();
  };

  closeBtn.onclick = closeHandler;
  overlay.onclick = (e) => {
    if (e.target === overlay) {
      closeHandler();
    }
  };

  uni.showLoading({
    title: t("Mobile.MySubscriptions.payPending"),
    mask: true,
  });
  const payStatus = await pollPayResult(orderId);
  uni.hideLoading();

  closeHandler();
  handlePayResultToast(payStatus, t, onSuccess);
}

/**
 * 校验并提示 URL 中的支付结果（如第三方渠道回跳回来的结果）
 */
export function checkPayResult(
  t: (key: string) => string,
  onSuccess?: () => void,
): void {
  const { payResult, orderId } = parsePayResultFromUrl();
  if (payResult !== "") {
    const alertKey = `${orderId}_${payResult}`;
    if (alertedKeys.has(alertKey)) return;
    alertedKeys.add(alertKey);

    handlePayResultToast(payResult, t, onSuccess);
    cleanUrlParams();
  }
}

/**
 * 校验微信公众号授权回跳的支付流程与自动轮询状态
 */
export async function checkWechatOaPayCallback(
  processingId: Ref<number | null>,
  t: (key: string) => string,
  onSuccess?: () => void,
): Promise<void> {
  const search = window.location.search;
  const hash = window.location.hash;
  let code = "";
  let state = "";

  // 优先从 main search 中解析
  if (search !== "") {
    const searchParams = new URLSearchParams(search);
    code = orEmpty(searchParams.get("code"));
    state = orEmpty(searchParams.get("state"));
  }

  // 若无，从 hash search 中解析
  if (code === "") {
    const qIndex = hash.indexOf("?");
    if (qIndex !== -1) {
      const hashSearch = hash.substring(qIndex);
      const hashParams = new URLSearchParams(hashSearch);
      code = orEmpty(hashParams.get("code"));
      state = orEmpty(hashParams.get("state"));
    }
  }

  if (code !== "" && state !== "") {
    const orderId = parseInt(state);
    if (isNaN(orderId)) return;

    const lockKey = `wx_pay_lock_${orderId}_${code}`;
    if (uni.getStorageSync(lockKey) === "1") return;
    uni.setStorageSync(lockKey, "1");

    // 清除 URL 中的 wechat code 和 state 参数（避免刷新重复发起支付）
    cleanWechatOaParams();

    processingId.value = orderId;
    uni.showLoading({
      title: t("Mobile.MySubscriptions.payPending"),
      mask: true,
    });

    try {
      const payParamsRes = await apiPayWechatJsapi({
        wxOAuthCode: code,
        orderId: orderId,
      });

      const payParamsData = apiResData<any>(payParamsRes) as UTSJSONObject | null;
      const wxPayParams = payParamsData != null ? payParamsData["wxPayParams"] : null;
      if (
        apiResCode(payParamsRes) == SUCCESS_CODE &&
        wxPayParams != null
      ) {
        uni.hideLoading();

        // 调起微信 JSAPI 支付
        const payCallRes = (await invokeJsapi(wxPayParams)) as Record<
          string,
          any
        >;
        const errMsg = orEmpty(payCallRes["err_msg"] as string);

        if (errMsg.indexOf("ok") !== -1) {
          uni.showLoading({
            title: t("Mobile.MySubscriptions.payChecking"),
            mask: true,
          });
          // JSAPI 已回调成功，短轮询等结算回调（约 10s）
          const result = await pollPayResult(orderId, 5);
          uni.hideLoading();
          if (result == "pending") {
            // 结算回调迟到：交给确认框，由用户主动复查，不再长时间遮罩
            beginPayConfirmSession(orderId, "WxPay");
            processingId.value = null;
            await openPayAwaitConfirmDialog(
              orderId,
              "WxPay",
              t,
              onSuccess != null ? onSuccess : null,
            );
          } else {
            handlePayResultToast(result, t, onSuccess);
          }
        } else if (errMsg.indexOf("cancel") !== -1) {
          uni.showToast({
            title: t("Mobile.MySubscriptions.payCancelled"),
            icon: "none",
          });
        } else {
          uni.showToast({
            title: t("Mobile.MySubscriptions.payFailed"),
            icon: "none",
          });
        }
      } else {
        uni.hideLoading();
        uni.showToast({
          title: orString(
            payParamsRes.message,
            t("Mobile.MySubscriptions.payFailed"),
          ),
          icon: "none",
        });
      }
    } catch (e) {
      uni.hideLoading();
      uni.showToast({
        title: t("Mobile.MySubscriptions.payFailed"),
        icon: "none",
      });
    } finally {
      processingId.value = null;
    }
  }
}

/**
 * 校验 H5 网页微信支付回跳的支付流程与自动轮询状态
 */
export async function checkH5PayCallback(
  processingId: Ref<number | null>,
  t: (key: string) => string,
  onSuccess?: () => void,
): Promise<void> {
  const search = window.location.search;
  const hash = window.location.hash;
  let h5OrderIdStr = "";

  if (search !== "") {
    const searchParams = new URLSearchParams(search);
    h5OrderIdStr = orEmpty(searchParams.get("h5OrderId"));
  }

  if (h5OrderIdStr === "") {
    const qIndex = hash.indexOf("?");
    if (qIndex !== -1) {
      const hashSearch = hash.substring(qIndex);
      const hashParams = new URLSearchParams(hashSearch);
      h5OrderIdStr = orEmpty(hashParams.get("h5OrderId"));
    }
  }

  if (h5OrderIdStr !== "") {
    const orderId = parseInt(h5OrderIdStr);
    if (isNaN(orderId)) return;

    cleanH5Params();
    // 用户已手动关闭过该订单的确认框就不再重弹（含 bfcache 回退到带参历史条目）
    if (isPayConfirmDismissed(orderId)) {
      uni.removeStorageSync("ACTIVE_PAY_ORDER_ID");
      processingId.value = null;
      return;
    }
    // 支付回跳后不再阻塞式轮询（原实现最长遮罩 120s 且不可取消），
    // 改为解锁页面并弹出确认框，由用户主动点「我已支付」查单。
    uni.hideLoading();
    processingId.value = null;
    uni.removeStorageSync("ACTIVE_PAY_ORDER_ID");
    await openPayAwaitConfirmDialog(
      orderId,
      getPayConfirmSessionChannel(),
      t,
      onSuccess != null ? onSuccess : null,
    );
  }
}

/**
 * 双重保险：校验并触发当前正在支付的本地活跃订单轮询状态
 * 解决 H5/Chrome 唤起第三方 App 支付切回时 URL 没发生改变以及 bfcache 阻断 onMounted 的极端兼容性问题
 */
export async function checkActiveOrderCallback(
  processingId: Ref<number | null>,
  t: (key: string) => string,
  onSuccess?: () => void,
): Promise<void> {
  let orderId = 0;
  const activeOrderIdStr = uni.getStorageSync("ACTIVE_PAY_ORDER_ID");
  if (activeOrderIdStr) {
    const parsed = parseInt(activeOrderIdStr as string);
    if (!isNaN(parsed)) {
      orderId = parsed;
    }
    // 一旦提取成功，立即清除该订单的支付中缓存，避免重复拉起
    uni.removeStorageSync("ACTIVE_PAY_ORDER_ID");
  }
  if (orderId <= 0) {
    // 同一次支付里切出去又切回来（未走 URL 回跳）时，靠确认会话恢复
    orderId = getPayConfirmSessionOrderId();
  }
  if (orderId <= 0) {
    return;
  }
  // 用户已手动关闭过该订单的确认框：即便未支付也不再骚扰，
  // 需要复查请从订单列表重新发起支付（会重建会话并重置该标记）。
  if (isPayConfirmDismissed(orderId)) {
    return;
  }

  // 确保 URL 干净，清除可能存在的 H5 拼接参数
  cleanH5Params();

  // 不再上 h5_pay_lock：重复进入由 openPayAwaitConfirmDialog 的单例守卫
  // 与上面的 dismissed 判断共同拦截。
  uni.hideLoading();
  processingId.value = null;
  await openPayAwaitConfirmDialog(
    orderId,
    getPayConfirmSessionChannel(),
    t,
    onSuccess != null ? onSuccess : null,
  );
}

/**
 * 网页端（H5 / 微信公众号）支付流程统一处理入口
 */
export async function executeWebPayFlow(
  orderId: number,
  processingId: Ref<number | null>,
  loading: Ref<boolean>,
  t: (key: string) => string,
  onSuccess?: () => void,
): Promise<void> {
  if (isEmbeddedAppWebView()) {
    await executeEmbeddedAppPayFlow(
      orderId,
      processingId,
      loading,
      t,
      onSuccess,
    );
    return;
  }
  const clientEnv = detectClientEnv();
  if (clientEnv.isWeChat) {
    await executeWebWxPayFlow(orderId, processingId, loading, t);
  } else {
    await executeWebH5PayFlow(orderId, processingId, loading, t, onSuccess);
  }
}

/** App 内嵌 H5：选择渠道后把订单交给原生宿主，禁止在 WebView 内打开收银台。 */
async function executeEmbeddedAppPayFlow(
  orderId: number,
  processingId: Ref<number | null>,
  loading: Ref<boolean>,
  t: (key: string) => string,
  onSuccess?: () => void,
): Promise<void> {
  uni.hideLoading();

  uni.showActionSheet({
    itemList: [
      t("Mobile.MySubscriptions.wechatPay"),
      t("Mobile.MySubscriptions.alipay"),
    ],
    success: (res) => {
      const payChannel = res.tapIndex == 1 ? "AliPay" : "WxPay";
      const requestId = `app_pay_${orderId}_${Date.now()}_${Math.floor(Math.random() * 100000)}`;
      const context = new EmbeddedAppPayContext(
        requestId,
        orderId,
        payChannel,
        processingId,
        loading,
        t,
        onSuccess,
      );
      embeddedAppPayContexts.set(requestId, context);
      ensureEmbeddedAppPayGlobals();
      loading.value = true;
      // 遮罩一直压到原生 launched（收银台参数就位），再换成支付确认框
      uni.showLoading({
        title: t("Mobile.MySubscriptions.payPending"),
        mask: true,
      });
      scheduleEmbeddedAppPayRequest(context);
    },
    fail: () => {
      processingId.value = null;
    },
  });
}

/**
 * 微信公众号网页授权支付流程具体调起
 */
async function executeWebWxPayFlow(
  orderId: number,
  processingId: Ref<number | null>,
  loading: Ref<boolean>,
  t: (key: string) => string,
): Promise<void> {
  loading.value = true;
  try {
    const currentUrl = window.location.href;
    const urlObj = new URL(currentUrl);
    urlObj.searchParams.delete("code");
    urlObj.searchParams.delete("state");
    const frontReturnUrl = urlObj.toString();

    // 解决微信内置浏览器回调前端 hash 地址截断问题：先回调至后端中转，由后端重定向回 hash 页
    const callbackBase = `${window.location.origin}/api/wechat/oa/callback`;
    const redirectUri = `${callbackBase}?returnUrl=${encodeURIComponent(frontReturnUrl)}`;

    const oauthRes = await apiGetWechatOaOauthUrl({
      redirectUri,
      state: String(orderId),
    });

    const oauthData = apiResData<any>(oauthRes) as UTSJSONObject | null;
    const authorizeUrl = oauthData != null && oauthData["authorizeUrl"] != null ? `${oauthData["authorizeUrl"]}` : "";
    if (apiResCode(oauthRes) == SUCCESS_CODE && authorizeUrl != "") {
      uni.hideLoading();
      window.location.href = authorizeUrl;
      setTimeout(() => {
        processingId.value = null;
      }, 300);
    } else {
      uni.hideLoading();
      uni.showToast({
        title: orString(
          oauthRes.message,
          t("Mobile.MySubscriptions.payFailed"),
        ),
        icon: "none",
      });
      processingId.value = null;
    }
  } catch (e) {
    uni.hideLoading();
    uni.showToast({
      title: t("Mobile.MySubscriptions.payFailed"),
      icon: "none",
    });
    processingId.value = null;
  } finally {
    loading.value = false;
  }
}

/**
 * H5 网页端微信支付核心拉起逻辑（含 Form 表单自动提交、二维码展示、外部跳转）
 */
async function executeWebH5PayFlow(
  orderId: number,
  processingId: Ref<number | null>,
  loading: Ref<boolean>,
  t: (key: string) => string,
  onSuccess?: () => void,
): Promise<void> {
  uni.hideLoading();
  uni.showActionSheet({
    itemList: [
      t("Mobile.MySubscriptions.wechatPay"),
      t("Mobile.MySubscriptions.alipay"),
    ],
    success: async (res) => {
      let payChannel = PayChannel.WxPay;
      const payChannelValue = res.tapIndex === 1 ? "AliPay" : "WxPay";
      if (res.tapIndex === 1) {
        payChannel = PayChannel.AliPay;
      }

      loading.value = true;
      uni.showLoading({
        title: t("Mobile.MySubscriptions.payPending"),
        mask: true,
      });

      try {
        const frontNotifyUrl = appendH5OrderIdToUrl(
          window.location.href,
          orderId,
        );

        // 发起支付前，将正在支付的订单 ID 写入缓存，双重保障 Chrome 唤起 App 切回或 bfcache 恢复
        uni.setStorageSync("ACTIVE_PAY_ORDER_ID", String(orderId));
        // 同时登记支付确认会话：整页跳转回来后据此重建「我已支付」确认框
        beginPayConfirmSession(orderId, payChannelValue);

        const payRes = await apiPayH5Web({
          orderId,
          payChannel,
          frontNotifyUrl,
        });

        uni.hideLoading();

        const payData = apiResData<any>(payRes) as Record<string, any> | null;
        if (apiResCode(payRes) == SUCCESS_CODE && payData != null) {
          const invokeType = payData["invokeType"] != null ? `${payData["invokeType"]}` : "";
          const formHtml = payData["formHtml"] as string | null;
          const redirectUrl = payData["redirectUrl"] as string | null;
          const qrCodeContent = payData["qrCodeContent"] as string | null;

          if (invokeType === "FORM_HTML") {
            if (formHtml == null || formHtml === "") {
              throw new Error("formHtml is empty");
            }

            const isFullHtml =
              formHtml.indexOf("<html") !== -1 ||
              formHtml.indexOf("<HTML") !== -1 ||
              formHtml.indexOf("<!DOCTYPE") !== -1 ||
              formHtml.indexOf("<!doctype") !== -1;

            if (isFullHtml) {
              document.write(formHtml);
              document.close();
              const form = document.querySelector(
                "form",
              ) as HTMLFormElement | null;
              if (form != null) {
                form.submit();
              } else {
                throw new Error("formHtml has no valid form");
              }
            } else {
              const container = document.createElement("div");
              container.style.display = "none";
              container.innerHTML = formHtml;
              document.body.appendChild(container);
              const form = container.querySelector(
                "form",
              ) as HTMLFormElement | null;
              if (form != null) {
                form.submit();
              } else {
                throw new Error("formHtml has no valid form");
              }
            }
            setTimeout(() => {
              processingId.value = null;
            }, 300);
          } else if (invokeType === "REDIRECT_URL") {
            if (redirectUrl == null || redirectUrl === "") {
              throw new Error("redirectUrl is empty");
            }
            window.location.href = redirectUrl;
            setTimeout(() => {
              processingId.value = null;
            }, 300);
          } else if (invokeType === "QRCODE_FALLBACK") {
            // 扫码兜底不跳出页面，沿用二维码弹窗内的轮询，撤销确认会话
            clearPayConfirmSession(orderId);
            uni.removeStorageSync("ACTIVE_PAY_ORDER_ID");
            if (qrCodeContent != null && qrCodeContent !== "") {
              await renderQrCodeModal(
                qrCodeContent,
                orderId,
                t,
                onSuccess,
                () => {
                  processingId.value = null;
                },
              );
            } else {
              uni.showToast({
                title: t("Mobile.MySubscriptions.qrCodeUnsupported"),
                icon: "none",
              });
              processingId.value = null;
            }
          } else {
            throw new Error("unknown invokeType: " + invokeType);
          }
        } else {
          // 收银台参数请求失败：撤销刚登记的确认会话，避免回到页面弹出无效确认框
          clearPayConfirmSession(orderId);
          uni.removeStorageSync("ACTIVE_PAY_ORDER_ID");
          uni.showToast({
            title: orString(
              payRes.message,
              t("Mobile.MySubscriptions.payFailed"),
            ),
            icon: "none",
          });
          processingId.value = null;
        }
      } catch (e) {
        uni.hideLoading();
        clearPayConfirmSession(orderId);
        uni.removeStorageSync("ACTIVE_PAY_ORDER_ID");
        uni.showToast({
          title: t("Mobile.MySubscriptions.payFailed"),
          icon: "none",
        });
        processingId.value = null;
      } finally {
        loading.value = false;
      }
    },
    fail: () => {
      processingId.value = null;
    },
  });
}
// #endif

// ========== APP（Android / iOS / HarmonyOS）工具函数 ==========
// #ifdef APP

/**
 * App 原生支付流程：选择渠道 → app-native → 原生桥 → 服务端结算轮询。
 * 原生桥回调只代表客户端动作，业务成功始终以 settlement-status 为准。
 */
export async function executeAppNativePayFlow(
  orderId: number,
  processingId: Ref<number | null>,
  loading: Ref<boolean>,
  t: (key: string) => string,
  onSuccess?: () => void,
): Promise<void> {
  uni.hideLoading();

  const handleSelectedChannel = async (tapIndex: number): Promise<void> => {
    // 不要用 payChannel.value：UTS 枚举只在 Android/iOS（Kotlin/Swift）下带 value
    // 属性，鸿蒙编译为 TS string enum，成员本身即字符串，.value 取到 undefined，
    // 接口会报 "payChannel is required"。
    const payChannelValue = tapIndex == 1 ? "AliPay" : "WxPay";
    loading.value = true;
    uni.showLoading({
      title: t("Mobile.MySubscriptions.payPending"),
      mask: true,
    });

    try {
      // /pay/app-native 有可能耗时几秒，遮罩必须盖住整个请求窗口：
      // 早期实现在这里就 hideLoading，用户选完渠道会看到一段无反馈的空白。
      const redirectUrl = await requestAppNativePayRedirect(
        orderId,
        payChannelValue,
        "",
      );
      // 参数已就位，马上要切到第三方 App，先撤遮罩
      uni.hideLoading();
      beginPayConfirmSession(orderId, payChannelValue);
      await launchAppNativePayRedirect(payChannelValue, redirectUrl);

      // 拉起收银台后立即结束本流程：不再阻塞式轮询。
      // 用户在收银台取消并切回 App 时，若此处还占着 processingId / loading，
      // 会把再次发起支付锁死到轮询超时为止（H5 端早有 pageshow 重置，App 端缺失）。
      // 支付结果由用户在确认框主动查单判定，checkActiveAppPayOrder 做静默兜底。
      //
      // 部分原生插件要等第三方页面返回后才 resolve：此时 onShow 的静默查单可能
      // 已经出过终态并清掉会话，那就不该再弹确认框（否则重复提示一次）。
      if (getPayConfirmSessionOrderId() == orderId) {
        openPayAwaitConfirmDialog(
          orderId,
          payChannelValue,
          t,
          onSuccess != null ? onSuccess : null,
        ).catch((): void => {});
      }
    } catch (e) {
      uni.hideLoading();
      const failedSession = readAppPaySession();
      const failedRequestId = failedSession != null && failedSession["requestId"] != null
        ? `${failedSession["requestId"]}`
        : "";
      storeAppNativePayResult(failedRequestId, "failed");
      clearPayConfirmSession(orderId);
      console.error("App native payment flow error:", e);
      uni.showToast({
        title: t("Mobile.MySubscriptions.payFailed"),
        icon: "none",
      });
      if (failedRequestId.length > 0) {
        acknowledgeAppNativePayResult(failedRequestId);
      }
    } finally {
      // 拉起成功的会话留给 checkActiveAppPayOrder 在回前台时核对。
      loading.value = false;
      processingId.value = null;
    }
  };

  uni.showActionSheet({
    itemList: [
      t("Mobile.MySubscriptions.wechatPay"),
      t("Mobile.MySubscriptions.alipay"),
    ],
    success: (res) => {
      handleSelectedChannel(res.tapIndex);
    },
    fail: () => {
      processingId.value = null;
    },
  });
}

/** 回前台核对结算状态的轮询次数（约 2s × 8 = 16s，覆盖支付回调延迟）。 */
const APP_RETURN_POLL_ATTEMPTS = 8;

/** 读取并核对原生侧活跃支付会话；结果由 H5 ACK 或原生消费后清理。 */
export async function checkActiveAppPayResult(): Promise<UTSJSONObject | null> {
  const session = readAppPaySession();
  if (session == null) {
    return null;
  }
  const storedResult = session["result"] != null ? `${session["result"]}` : "";
  if (storedResult.length > 0) {
    return session;
  }
  const state = session["state"] != null ? `${session["state"]}` : "";
  if (state != "LAUNCHED") {
    return null;
  }
  const orderRaw = session["orderId"];
  const orderId = orderRaw != null ? parseInt(`${orderRaw}`) : 0;
  if (isNaN(orderId) || orderId <= 0) {
    uni.removeStorageSync(ACTIVE_APP_PAY_SESSION);
    return null;
  }

  const result = await pollPayResult(orderId, APP_RETURN_POLL_ATTEMPTS);
  const requestId = session["requestId"] != null ? `${session["requestId"]}` : "";
  if (result == "pending") {
    // pending 只是本轮查询超时，不是业务终态。保留空结果与可查询状态，
    // 后续 onShow / 主动同步仍可继续核对迟到的服务端结算结果。
    const latest = readAppPaySession();
    const latestRequestId = latest != null && latest["requestId"] != null
      ? `${latest["requestId"]}`
      : "";
    if (latest != null && latestRequestId == requestId) {
      latest["state"] = "LAUNCHED";
      latest["result"] = "";
      // 返回给当前调用方的 pending 仅用于解除 H5 锁，不持久化为可 ACK 结果。
      latest["result"] = "pending";
      return latest;
    }
    return null;
  }
  storeAppNativePayResult(requestId, result);
  const stored = readAppPaySession();
  const storedRequestId = stored != null && stored["requestId"] != null
    ? `${stored["requestId"]}`
    : "";
  return stored != null && storedRequestId == requestId ? stored : null;
}

/**
 * App 从收银台切回前台时调用。
 *
 * 两件事，顺序不能反：
 * 1. 无条件解除支付锁（用户可能只是取消支付返回），让用户能立刻重新发起；
 * 2. 若存在拉起过的活跃订单，后台短轮询核对结算状态——不上锁、不加遮罩。
 *
 * 对应 H5 端的 pageshow / visibilitychange 处理（见 useSubscriptionPurchase.uts）。
 */
export async function checkActiveAppPayOrder(
  processingId: Ref<number | null>,
  loading: Ref<boolean>,
  t: (key: string) => string,
  onSuccess?: () => void,
): Promise<void> {
  // 1. 先解锁，且不依赖后续查询是否成功
  uni.hideLoading();
  loading.value = false;
  processingId.value = null;

  // 2. 核对活跃订单
  const snapshot = await checkActiveAppPayResult();
  if (snapshot == null) {
    return;
  }
  const result = snapshot["result"] != null ? `${snapshot["result"]}` : "";
  const requestId = snapshot["requestId"] != null ? `${snapshot["requestId"]}` : "";
  if (result.length == 0) {
    return;
  }
  if (result == "pending") {
    // 交互锁已在函数开头解除；保留原生会话供后续 onShow 继续查单。
    return;
  }
  const orderRaw = snapshot["orderId"];
  const settledOrderId = orderRaw != null ? parseInt(`${orderRaw}`) : 0;
  if (
    isPayConfirmDialogOpen() &&
    !isNaN(settledOrderId) &&
    settledOrderId == getPayConfirmSessionOrderId()
  ) {
    // 用户正对着确认框：静默缓存结果，等他点「我已支付」时秒回，
    // 避免 Toast 与关不掉的系统弹窗叠在一起（uni.showModal 无法程序化关闭）。
    storePayConfirmAutoResult(settledOrderId, result);
    if (requestId.length > 0) {
      acknowledgeAppNativePayResult(requestId);
    }
    return;
  }
  clearPayConfirmSession(!isNaN(settledOrderId) ? settledOrderId : 0);
  handlePayResultToast(result, t, onSuccess);
  if (requestId.length > 0) {
    acknowledgeAppNativePayResult(requestId);
  }
}

// #endif

// ========== MP-WEIXIN 工具函数 ==========
// #ifdef MP-WEIXIN

/**
 * 获取微信登录码，每次支付前调用一次
 */
export function getWxLoginCode(): Promise<string> {
  return new Promise((resolve, reject) => {
    uni.login({
      provider: "weixin",
      success: (res) => {
        resolve(res.code);
      },
      fail: (err) => {
        reject(err);
      },
    });
  });
}

/**
 * 调起微信支付面板，返回是否支付成功
 * 取消支付和其他失败均 resolve(false)，不抛异常
 */
export function requestWxPayment(
  params: WxPayParams,
  t: (key: string) => string,
): Promise<boolean> {
  return new Promise((resolve) => {
    uni.requestPayment({
      provider: "wxpay",
      timeStamp: params.timeStamp,
      nonceStr: params.nonceStr,
      package: params.packageValue,
      signType: orString(params.signType, "RSA"),
      paySign: params.paySign,
      success: () => {
        resolve(true);
      },
      fail: (err) => {
        if (err.errCode === 700601 || err.errMsg?.includes("cancel")) {
          uni.showToast({
            title: t("Mobile.MySubscriptions.payCancelled"),
            icon: "none",
          });
        } else {
          uni.showToast({
            title: t("Mobile.MySubscriptions.payFailed"),
            icon: "none",
          });
          console.error("WeChat payment failed:", err);
        }
        resolve(false);
      },
    });
  });
}

/**
 * 小程序支付主流程封装：获取登录码 → 请求小程序支付参数 → 调起微信原生支付 → 后台轮询结果
 */
export async function executeMinipayFlow(
  orderId: number,
  processingId: Ref<number | null>,
  t: (key: string) => string,
  onSuccess?: () => void,
): Promise<void> {
  processingId.value = orderId;
  uni.showLoading({
    title: t("Mobile.MySubscriptions.payPending"),
    mask: true,
  });

  try {
    const wxLoginCode = await getWxLoginCode();

    const minipayRes = await apiPayMinipay({
      orderId,
      payChannel: PayChannel.WxPay,
      wxLoginCode,
    });

    const minipayData = apiResData<any>(minipayRes) as UTSJSONObject | null;
    const wxPayParams = minipayData != null ? minipayData["wxPayParams"] as WxPayParams | null : null;
    if (
      apiResCode(minipayRes) != SUCCESS_CODE ||
      minipayData == null ||
      wxPayParams == null
    ) {
      uni.hideLoading();
      uni.showToast({
        title: t("Mobile.MySubscriptions.payParamsFailed"),
        icon: "none",
      });
      return;
    }
    uni.hideLoading();

    const paySuccess = await requestWxPayment(wxPayParams, t);
    if (!paySuccess) return;

    uni.showLoading({
      title: t("Mobile.MySubscriptions.payPending"),
      mask: true,
    });

    const result = await pollPayResult(orderId);
    uni.hideLoading();
    handlePayResultToast(result, t, onSuccess);
  } catch (e) {
    uni.hideLoading();
    uni.showToast({
      title: t("Mobile.MySubscriptions.payFailed"),
      icon: "none",
    });
    console.error("Mini-program payment flow error:", e);
  } finally {
    processingId.value = null;
  }
}
// #endif

// ========== 通用工具函数 ==========

/**
 * 跨端统一支付执行分流入口（自动自适应小程序或 H5/Web 环境并分发执行流程）
 */
export async function executePayFlow(
  orderId: number,
  processingId: Ref<number | null>,
  loading: Ref<boolean>,
  t: (key: string) => string,
  onSuccess?: () => void,
): Promise<void> {
  // #ifdef MP-WEIXIN
  await executeMinipayFlow(orderId, processingId, t, onSuccess);
  // #endif
  // #ifdef H5 || WEB
  await executeWebPayFlow(orderId, processingId, loading, t, onSuccess);
  // #endif
  // #ifdef APP
  await executeAppNativePayFlow(orderId, processingId, loading, t, onSuccess);
  // #endif
}

/**
 * 轮询结算状态，最多 60 次，间隔 2 秒
 * @returns "success" | "failed" | "pending"
 */
export async function pollPayResult(
  orderId: number,
  attempts: number = 60,
): Promise<string> {
  const maxAttempts = attempts;
  for (let i = 0; i < maxAttempts; i++) {
    await new Promise<void>((resolve) => {
      setTimeout(() => {
        resolve();
      }, 2000);
    });
    // 判定规则集中在 fetchSettlementResult，手动查单与轮询共用一份
    const result = await fetchSettlementResult(orderId);
    if (result != "pending") {
      return result;
    }
  }
  return "pending";
}

/**
 * 支付结果 Toast 提示，根据结果调用 onSuccess 回调
 * @param result "success" | "failed" | "pending"
 */
export function handlePayResultToast(
  result: string,
  t: (key: string) => string,
  onSuccess?: () => void,
): void {
  if (result === "success") {
    uni.showToast({
      title: t("Mobile.MySubscriptions.paySuccess"),
      icon: "success",
    });
    onSuccess?.();
  } else if (result === "failed") {
    uni.showToast({
      title: t("Mobile.MySubscriptions.payFailed"),
      icon: "none",
    });
  } else if (result === "pending") {
    uni.showToast({
      title: t("Mobile.MySubscriptions.payPending"),
      icon: "none",
    });
  }
}

// 获取 payMode
export function getPayMode(): PayMode {
  // 默认是扫码
  let payMode = PayMode.scan;

  // 微信小程序
  // #ifdef MP-WEIXIN
  payMode = PayMode.minipay;
  // #endif

  // #ifdef H5 || WEB
  payMode = PayMode.h5;
  if (isEmbeddedAppWebView()) {
    payMode = PayMode.app;
  } else {
    const env = detectClientEnv();
    if (env.isWeChat) {
      payMode = PayMode.minipay;
    }
  }
  // #endif

  // Android / iOS / HarmonyOS 原生 App
  // #ifdef APP
  payMode = PayMode.app;
  // #endif

  return payMode;
}

// ========== 支付确认弹窗（跳转前提示 + 回来手动查单） ==========

/**
 * 支付确认会话：跨端共用，记录「已拉起收银台、等用户手动查单」的订单。
 * 与 APP 端的 ACTIVE_APP_PAY_SESSION 是两套：后者服务于原生拉起与结果重放，
 * 这里只服务于用户可见的确认框，H5 整页跳转回来后也能靠它重建弹窗。
 */
const PAY_CONFIRM_SESSION = "PAY_CONFIRM_SESSION";
const PAY_CONFIRM_SESSION_TTL_MS = 30 * 60 * 1000;

/** 确认框同一时刻只允许一个，避免 pageshow / visibilitychange / onShow 重复弹出。 */
let payConfirmDialogOpen = false;

/** 后台静默查单据此判断：弹窗开着就只缓存结果，不抢在用户点按钮前弹 Toast。 */
export function isPayConfirmDialogOpen(): boolean {
  return payConfirmDialogOpen;
}

function readPayConfirmSession(): UTSJSONObject | null {
  const raw = uni.getStorageSync(PAY_CONFIRM_SESSION);
  const text = raw != null ? `${raw}` : "";
  if (text.length == 0) {
    return null;
  }
  try {
    const session = JSON.parse<UTSJSONObject>(text);
    if (session == null) {
      uni.removeStorageSync(PAY_CONFIRM_SESSION);
      return null;
    }
    const createdAtRaw = session["createdAt"];
    const createdAt = createdAtRaw != null ? parseFloat(`${createdAtRaw}`) : 0;
    if (createdAt <= 0 || Date.now() - createdAt > PAY_CONFIRM_SESSION_TTL_MS) {
      uni.removeStorageSync(PAY_CONFIRM_SESSION);
      return null;
    }
    return session;
  } catch (_error) {
    uni.removeStorageSync(PAY_CONFIRM_SESSION);
    return null;
  }
}

function readPayConfirmSessionOrderIdOf(session: UTSJSONObject): number {
  const raw = session["orderId"];
  const orderId = raw != null ? parseInt(`${raw}`) : 0;
  return isNaN(orderId) ? 0 : orderId;
}

/** 拉起收银台成功后登记；用户回到页面时据此重建确认框。 */
export function beginPayConfirmSession(
  orderId: number,
  payChannelValue: string,
): void {
  const session = new UTSJSONObject();
  session["orderId"] = orderId as any;
  session["payChannel"] = payChannelValue;
  session["autoResult"] = "";
  // 每次重新发起支付都重置，用户上一轮点过「关闭」不影响新一轮弹窗
  session["dismissed"] = "";
  session["createdAt"] = Date.now() as any;
  uni.setStorageSync(PAY_CONFIRM_SESSION, JSON.stringify(session));
}

/**
 * 标记用户已手动关闭确认框。
 * 会话保留（TTL 内仍可承接后台查单结果），但不再自动重弹——
 * 用户主动关掉的弹窗，不该在他每次进入页面时又被推到脸上。
 */
export function markPayConfirmDismissed(orderId: number): void {
  const session = readPayConfirmSession();
  if (session == null) {
    return;
  }
  if (readPayConfirmSessionOrderIdOf(session) != orderId) {
    return;
  }
  session["dismissed"] = "1";
  uni.setStorageSync(PAY_CONFIRM_SESSION, JSON.stringify(session));
}

/** 该订单的确认框是否已被用户手动关闭过。 */
export function isPayConfirmDismissed(orderId: number): boolean {
  const session = readPayConfirmSession();
  if (session == null) {
    return false;
  }
  if (readPayConfirmSessionOrderIdOf(session) != orderId) {
    return false;
  }
  const raw = session["dismissed"];
  return raw != null && `${raw}` == "1";
}

/** 无活跃会话返回 0。 */
export function getPayConfirmSessionOrderId(): number {
  const session = readPayConfirmSession();
  if (session == null) {
    return 0;
  }
  return readPayConfirmSessionOrderIdOf(session);
}

/** 无活跃会话时回退到微信，仅用于弹窗文案。 */
export function getPayConfirmSessionChannel(): string {
  const session = readPayConfirmSession();
  if (session == null) {
    return "WxPay";
  }
  const raw = session["payChannel"];
  const channel = raw != null ? `${raw}` : "";
  return channel.length > 0 ? channel : "WxPay";
}

/** 后台静默查单命中终态时缓存；用户点「我已支付」即可秒回结果。 */
export function storePayConfirmAutoResult(orderId: number, result: string): void {
  const session = readPayConfirmSession();
  if (session == null) {
    return;
  }
  if (readPayConfirmSessionOrderIdOf(session) != orderId) {
    return;
  }
  session["autoResult"] = result;
  uni.setStorageSync(PAY_CONFIRM_SESSION, JSON.stringify(session));
}

/** 读取后台静默查单的终态缓存；无缓存返回空串。 */
export function readPayConfirmAutoResult(orderId: number): string {
  const session = readPayConfirmSession();
  if (session == null) {
    return "";
  }
  if (readPayConfirmSessionOrderIdOf(session) != orderId) {
    return "";
  }
  const resultRaw = session["autoResult"];
  return resultRaw != null ? `${resultRaw}` : "";
}

/** 终态已提示给用户后清理；orderId 不匹配时禁止误删其他订单的会话。 */
export function clearPayConfirmSession(orderId: number): void {
  const session = readPayConfirmSession();
  if (session == null) {
    return;
  }
  if (orderId > 0 && readPayConfirmSessionOrderIdOf(session) != orderId) {
    return;
  }
  uni.removeStorageSync(PAY_CONFIRM_SESSION);
}

function showPayModal(
  title: string,
  content: string,
  confirmText: string,
  cancelText: string,
  showCancel: boolean,
): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    uni.showModal({
      title: title,
      content: content,
      showCancel: showCancel,
      cancelText: cancelText,
      confirmText: confirmText,
      success: (res) => {
        resolve(res.confirm != null && res.confirm != false);
      },
      fail: () => {
        resolve(false);
      },
    });
  });
}

/** 单次结算查询，不做等待；判定规则与 pollPayResult 共用。 */
export async function fetchSettlementResult(orderId: number): Promise<string> {
  try {
    const requestData = new UTSJSONObject();
    requestData["orderId"] = orderId as any;
    const res = await apiGetSettlementStatus(requestData);
    const code = apiResCode(res);
    const data = apiResData<any>(res) as UTSJSONObject | null;
    if (code == SUCCESS_CODE && data != null) {
      const settled = data["settled"] == true || `${data["settled"]}` == "true";
      const orderStatus = data["orderStatus"] != null ? `${data["orderStatus"]}` : "";
      const payStatus = data["payStatus"] != null ? `${data["payStatus"]}` : "";
      const terminalFailed = data["terminalFailed"] == true || `${data["terminalFailed"]}` == "true";
      if (settled || orderStatus == "PAID" || payStatus == "SUCCESS") {
        return "success";
      }
      if (
        terminalFailed ||
        orderStatus == "CANCELLED" ||
        payStatus == "FAILED" ||
        payStatus == "CLOSED"
      ) {
        return "failed";
      }
    }
  } catch (_e) {
    // 网络异常按未出结果处理，交给调用方决定是否重试
  }
  return "pending";
}

/**
 * 用户主动查单：立刻查一次，未出终态再补两次（+1.5s / +3s）。
 * 不能直接用 pollPayResult —— 它是「先等 2 秒再请求」，手动点按钮会明显卡顿。
 */
export async function checkPayResultOnDemand(orderId: number): Promise<string> {
  for (let i = 0; i < 3; i++) {
    if (i > 0) {
      const wait = i == 1 ? 1500 : 3000;
      await new Promise<void>((resolve) => {
        setTimeout(() => {
          resolve();
        }, wait);
      });
    }
    const result = await fetchSettlementResult(orderId);
    if (result != "pending") {
      return result;
    }
  }
  return "pending";
}

function emitPayResultToast(
  result: string,
  t: (key: string) => string,
  onSuccess: (() => void) | null,
): void {
  // Android：UTS 不给可选参数生成重载，少传参会编译失败（error: No value passed
  // for parameter 'onSuccess'），无回调时传空实现而不是省略。
  if (onSuccess != null) {
    handlePayResultToast(result, t, onSuccess);
  } else {
    handlePayResultToast(result, t, (): void => {});
  }
}

/**
 * 支付确认框：拉起收银台后展示，用户支付完切回来点「我已支付」查单。
 *
 * - 未查到结果时换文案继续等待，用户可反复点「再查一次」；
 * - 点「关闭」只关闭弹窗，会话保留，后台静默查单仍会兜底；
 * - 关闭前若后台已查到终态（autoResult），直接提示，不让结果丢失。
 */
export async function openPayAwaitConfirmDialog(
  orderId: number,
  payChannelValue: string,
  t: (key: string) => string,
  onSuccess: (() => void) | null,
): Promise<void> {
  if (orderId <= 0 || payConfirmDialogOpen == true) {
    return;
  }
  payConfirmDialogOpen = true;
  try {
    const tipKey = payChannelValue == "AliPay"
      ? "Mobile.MySubscriptions.payConfirmTipAlipay"
      : "Mobile.MySubscriptions.payConfirmTipWechat";
    let title = t("Mobile.MySubscriptions.payConfirmTitle");
    let content = t(tipKey);
    let confirmText = t("Mobile.MySubscriptions.payConfirmDone");
    let cancelText = t("Mobile.MySubscriptions.payConfirmLater");

    while (true) {
      const confirmed = await showPayModal(
        title,
        content,
        confirmText,
        cancelText,
        true,
      );
      if (confirmed != true) {
        // 用户关掉弹窗：把后台已经查到的终态补提示出来，避免结果石沉大海。
        const cached = readPayConfirmAutoResult(orderId);
        if (cached.length > 0) {
          clearPayConfirmSession(orderId);
          emitPayResultToast(cached, t, onSuccess);
          return;
        }
        // 没有结果就是用户主动放弃本轮查单：记下来，后续进页面不再自动重弹
        markPayConfirmDismissed(orderId);
        return;
      }

      let result = readPayConfirmAutoResult(orderId);
      if (result.length == 0) {
        uni.showLoading({
          title: t("Mobile.MySubscriptions.payChecking"),
          mask: true,
        });
        result = await checkPayResultOnDemand(orderId);
        uni.hideLoading();
      }

      if (result == "success") {
        clearPayConfirmSession(orderId);
        emitPayResultToast("success", t, onSuccess);
        return;
      }
      if (result == "failed") {
        clearPayConfirmSession(orderId);
        await showPayModal(
          t("Mobile.MySubscriptions.payFailed"),
          t("Mobile.MySubscriptions.payClosedTip"),
          t("Mobile.MySubscriptions.payCloseDialog"),
          "",
          false,
        );
        return;
      }

      title = t("Mobile.MySubscriptions.payNotFoundTitle");
      content = t("Mobile.MySubscriptions.payNotFoundTip");
      confirmText = t("Mobile.MySubscriptions.payRetryCheck");
      cancelText = t("Mobile.MySubscriptions.payCloseDialog");
    }
  } finally {
    payConfirmDialogOpen = false;
  }
}
