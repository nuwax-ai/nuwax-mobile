import { readRawField } from "@/subpackages/utils/messageInfoClass.uts";
import {
  DefaultSelectedEnum,
  ExpandPageAreaEnum,
  HideChatAreaEnum,
} from "@/types/enums/agent.uts";

/**
 * 解析 Android 上枚举字段（含 { value: "TaskAgent" } 包装）。
 */
export function readAgentEnumString(raw: any | null): string {
  if (raw == null) {
    return "";
  }
  const nested = readRawField(raw, "value");
  if (nested != null) {
    return `${nested}`;
  }
  return `${raw}`;
}

/** 从 agentInfo（Map / UTSJSONObject）安全读字段 */
export function readAgentInfoField(info: any | null, key: string): any | null {
  return readRawField(info, key);
}

/** 读取 agentInfo 字符串字段 */
export function readAgentStringField(info: any | null, key: string): string {
  const raw = readRawField(info, key);
  if (raw == null) {
    return "";
  }
  return `${raw}`;
}

/** 读取 agentInfo.type 字符串 */
export function readAgentTypeString(info: any | null): string {
  return readAgentEnumString(readRawField(info, "type"));
}

/** 是否任务型智能体 */
export function isAgentTypeTaskAgent(info: any | null): boolean {
  if (info == null) {
    return false;
  }
  const typeStr = readAgentTypeString(info);
  return typeStr == "TaskAgent";
}

/** expandPageArea → 0/1（Android 禁止枚举 as number） */
export function getExpandPageAreaFlag(info: any | null): number {
  if (info == null) {
    return 0;
  }
  const raw = readRawField(info, "expandPageArea");
  if (raw == true) {
    return 1;
  }
  if (raw == ExpandPageAreaEnum.Yes || raw == 1) {
    return 1;
  }
  const s = readAgentEnumString(raw);
  if (s == "1" || s == "Yes") {
    return 1;
  }
  return 0;
}

/** hideChatArea → 0/1 */
export function getHideChatAreaFlag(info: any | null): number {
  if (info == null) {
    return 0;
  }
  const raw = readRawField(info, "hideChatArea");
  if (raw == true) {
    return 1;
  }
  if (raw == HideChatAreaEnum.Yes || raw == 1) {
    return 1;
  }
  const s = readAgentEnumString(raw);
  if (s == "1" || s == "Yes") {
    return 1;
  }
  return 0;
}

/** DefaultSelectedEnum.Yes / 1 / "Yes" */
export function isDefaultSelectedYes(raw: any | null): boolean {
  if (raw == null) {
    return false;
  }
  if (raw == true) {
    return true;
  }
  if (raw == DefaultSelectedEnum.Yes || raw == 1) {
    return true;
  }
  const s = readAgentEnumString(raw);
  return s == "1" || s == "Yes";
}

/** DefaultSelectedEnum.No / 0 / "No" */
export function isDefaultSelectedNo(raw: any | null): boolean {
  if (raw == null) {
    return false;
  }
  if (raw == false) {
    return true;
  }
  if (raw == DefaultSelectedEnum.No || raw == 0) {
    return true;
  }
  const s = readAgentEnumString(raw);
  return s == "0" || s == "No";
}
