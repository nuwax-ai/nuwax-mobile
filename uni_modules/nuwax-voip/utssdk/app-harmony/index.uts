import { abilityAccessCtrl, Permissions } from '@kit.AbilityKit'
import { VoipBridge } from './VoipBridge.ets'
export { VoipBridge } from './VoipBridge.ets'
export function executeVoip(command: string): void {
  VoipBridge.context = UTSHarmony.getUIAbilityContext()
  VoipBridge.execute(command)
}
export function drainVoipEvents(): string { return VoipBridge.drain() }
export function hasNativeVoipCall(): boolean { return VoipBridge.current != null }
export function ensureVoipPermissions(mediaType: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    const permissions: Permissions[] = ['ohos.permission.MICROPHONE']
    if (mediaType == 'video') permissions.push('ohos.permission.CAMERA')
    abilityAccessCtrl.createAtManager().requestPermissionsFromUser(UTSHarmony.getUIAbilityContext(), permissions)
      .then(result => { resolve(result.authResults.every(value => value == 0)) }).catch(() => { resolve(false) })
  })
}
/** Harmony renders both tracks in a separate native Ability, retained while the chat page changes. */
export class VoipVideoBinding {
  constructor(_element: UniNativeViewElement, _local: boolean) { VoipBridge.showMedia() }
  release(): void {}
}
