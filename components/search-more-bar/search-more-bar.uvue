<template>
  <view class="search-more-bar">
    <view v-if="showBack" class="search-more-bar__back" @click="goBack">
      <svg-icon name="icon-a-Chevronleft" size="22" unit="px" />
    </view>
    <view class="search-more-bar__box" @click="emit('search')">
      <svg-icon name="icon-Search" size="16" unit="px" color="rgba(21, 23, 31, 0.5)" />
      <text class="search-more-bar__placeholder">{{ placeholder }}</text>
    </view>
    <view class="search-more-bar__more" @click="emit('more')">
      <text class="search-more-bar__more-text">{{ moreText }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  interface SearchMoreBarProps {
    /** 搜索框占位文案 */
    placeholder: string;
    /** 右侧操作文案 */
    moreText: string;
    /**
     * 左侧返回。不传则不显示。
     * 可选 boolean 配合 withDefaults 会让接口保持 Boolean?、类属性变成 Boolean，Android kotlin 编译报 override 类型不匹配。
     */
    showBack?: boolean;
  }

  defineProps<SearchMoreBarProps>();

  const emit = defineEmits<{
    search: [];
    more: [];
  }>();

  function goBack(): void {
    uni.navigateBack({ delta: 1 });
  }
</script>

<style lang="scss" scoped>
  @import "@/styles/nav-bar-size.scss";

  .search-more-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    /* 与 custom-nav-bar .nav-bar 同高 */
    height: $nav-bar-height-h5;
    /* #ifndef H5 */
    /* px 定值（原 104rpx）：密度类不随屏宽缩放 */
    height: 52px;
    /* #endif */
    padding: 5px 0 5px 0;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .search-more-bar__back {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    /* 与 custom-nav-bar 返回按钮同一位置：导航栏左内边距 16px，再向左收 8px。 */
    width: 48px;
    height: 48px;
    margin-left: 8px;
    padding: 5px;
  }

  .search-more-bar__box {
    flex: 1;
    display: flex;
    align-items: center;
    flex-direction: row;
    height: 100%;
    padding: 0 12px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: rgba(12, 20, 102, 0.04);
  }

  .search-more-bar__placeholder {
    flex: 1;
    margin-left: 8px;
    color: rgba(21, 23, 31, 0.5);
    font-size: 14px;
    font-weight: 400;
  }

  .search-more-bar__more {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 100%;
    padding: 0 16px;
  }

  .search-more-bar__more-text {
    font-weight: 400;
    color: rgba(21, 23, 31, 0.5);
    font-size: 16px;
  }
</style>
