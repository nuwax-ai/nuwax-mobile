export class DiffInputFileItem {
  filePath: string = "";
  oldText: string = "";
  newText: string = "";
}

export function readDiffInputFile(raw: any): DiffInputFileItem {
  const item = new DiffInputFileItem();
  if (raw == null) {
    return item;
  }
  const obj = raw as UTSJSONObject;
  const filePath = obj["filePath"];
  if (filePath != null) {
    item.filePath = filePath as string;
  }
  const oldText = obj["oldText"];
  if (oldText != null) {
    item.oldText = oldText as string;
  }
  const newText = obj["newText"];
  if (newText != null) {
    item.newText = newText as string;
  }
  return item;
}

/** 单行 diff 展示项（UTS 需 class 构造） */
export class DiffLineItem {
  type: string = "";
  content: string = "";
  oldLineNum: string = "";
  newLineNum: string = "";
}

/** 单文件 diff 汇总（UTS 需 class 构造） */
export class DiffFileItem {
  filePath: string = "";
  addedCount: number = 0;
  removedCount: number = 0;
  diffLinesList: DiffLineItem[] = [];
  isExpanded: boolean = false;
}

export function createDiffLineItem(
  type: string,
  content: string,
  oldLineNum: string,
  newLineNum: string,
): DiffLineItem {
  const item = new DiffLineItem();
  item.type = type;
  item.content = content;
  item.oldLineNum = oldLineNum;
  item.newLineNum = newLineNum;
  return item;
}
