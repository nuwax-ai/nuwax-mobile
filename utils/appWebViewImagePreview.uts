/**
 * App web-view 内嵌 H5 的图片预览。
 *
 * uni.previewImage 在 H5 关闭时会 history.back / uni.navigateBack，
 * 内嵌 WebView 里会把承载页（agent-detail）一并弹掉，表现为回到首页。
 * H5（浏览器直开 + App 内嵌）统一走自绘遮罩，带计数、切图和下载。
 */
import { getApiBaseUrl } from "@/constants/config";
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { isAppWebViewEmbedded } from "@/utils/appWebViewDetect";
import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

type PreviewOpenHandler = (urls: string[], current: string) => void;

let previewHostOpen: PreviewOpenHandler | null = null;
let previewHookInstalled: boolean = false;

function isAlreadyAbsoluteMediaUrl(url: string): boolean {
  if (url.indexOf("http://") == 0 || url.indexOf("https://") == 0) {
    return true;
  }
  if (url.indexOf("data:") == 0 || url.indexOf("blob:") == 0) {
    return true;
  }
  if (
    url.indexOf("file://") == 0 ||
    url.indexOf("wxfile://") == 0 ||
    url.indexOf("content://") == 0
  ) {
    return true;
  }
  return false;
}

function isUsableHttpOrigin(origin: string): boolean {
  if (origin.length == 0 || origin == "null") {
    return false;
  }
  if (origin.indexOf("http://") == 0 || origin.indexOf("https://") == 0) {
    return true;
  }
  return false;
}

function resolvePageOrigin(): string {
  // #ifdef H5 || WEB
  try {
    const loc = window.location;
    if (loc != null) {
      const protocol = `${loc.protocol}`;
      const host = `${loc.host}`;
      // Android WebView 上 origin 偶发为 null / file://，host 仍可用
      if (
        protocol.length > 0 &&
        host.length > 0 &&
        protocol.indexOf("http") == 0
      ) {
        return `${protocol}//${host}`;
      }
      const origin = `${loc.origin}`;
      if (isUsableHttpOrigin(origin) == true) {
        return origin;
      }
    }
  } catch (_e) {
    // ignore
  }
  // #endif
  const apiBase = getApiBaseUrl();
  if (isUsableHttpOrigin(apiBase) == true) {
    return apiBase;
  }
  return "";
}

function extractHttpOrigin(url: string): string {
  if (url.indexOf("http://") != 0 && url.indexOf("https://") != 0) {
    return "";
  }
  const protoIdx = url.indexOf("://");
  if (protoIdx < 0) {
    return "";
  }
  const after = url.substring(protoIdx + 3);
  const slashIdx = after.indexOf("/");
  if (slashIdx < 0) {
    return url;
  }
  return url.substring(0, protoIdx + 3 + slashIdx);
}

/** 站点根路径（/api/...、/static/... 等）或当前页 / 接口同源地址。第三方 CDN 不算。 */
function isSameOriginPreviewUrl(url: string): boolean {
  if (url.indexOf("/") == 0 && url.indexOf("//") != 0) {
    return true;
  }
  const urlOrigin = extractHttpOrigin(url);
  if (urlOrigin.length == 0) {
    return false;
  }
  const pageOrigin = resolvePageOrigin();
  if (pageOrigin.length > 0 && urlOrigin == pageOrigin) {
    return true;
  }
  const apiBase = getApiBaseUrl();
  if (apiBase.length > 0 && urlOrigin == apiBase) {
    return true;
  }
  return false;
}

/**
 * 同源接口图依赖登录态。正文 <img> 会带 Cookie；Android 预览组件常不带，补 _ticket。
 * 不限定 /api/computer/static，任意站点根路径或同源地址都补；外链 CDN 不补。
 */
function withSameOriginTicket(url: string): string {
  if (isSameOriginPreviewUrl(url) != true) {
    return url;
  }
  if (url.indexOf("_ticket=") >= 0) {
    return url;
  }
  try {
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    const token = tokenRaw != null ? `${tokenRaw}` : "";
    if (token.length == 0) {
      return url;
    }
    const sep = url.indexOf("?") >= 0 ? "&" : "?";
    return `${url}${sep}_ticket=${encodeURIComponent(token)}`;
  } catch (_eToken) {
    return url;
  }
}

function toAbsolutePreviewUrl(url: string): string {
  if (url.length == 0) {
    return url;
  }
  if (isAlreadyAbsoluteMediaUrl(url) == true) {
    return url;
  }
  if (url.indexOf("//") == 0) {
    // #ifdef H5 || WEB
    try {
      const proto = window.location.protocol;
      if (proto != null && proto.length > 0) {
        return `${proto}${url}`;
      }
    } catch (_eProto) {
      // ignore
    }
    // #endif
    return `https:${url}`;
  }
  const path = url.indexOf("/") == 0 ? url : `/${url}`;
  const apiBase = getApiBaseUrl();
  if (path.indexOf("/api/") == 0 && isUsableHttpOrigin(apiBase) == true) {
    return `${apiBase}${path}`;
  }
  const origin = resolvePageOrigin();
  if (origin.length == 0) {
    return path;
  }
  return `${origin}${path}`;
}

/**
 * 预览必须用绝对 URL：页面内 img 可用 /api/... 等根路径，
 * uni.previewImage 会把根路径当成本地资源，出现黑底裂图（如 3/3 刷新图标）。
 */
export function normalizePreviewImageUrl(url: string): string {
  return withSameOriginTicket(toAbsolutePreviewUrl(url));
}

function normalizePreviewImageUrls(urls: string[]): string[] {
  const out: string[] = [];
  const len = urls.length;
  for (let i = 0; i < len; i++) {
    out.push(normalizePreviewImageUrl(urls[i]));
  }
  return out;
}

/**
 * 会话页预览遮罩挂载 / 卸载时登记。
 */
export function setAppWebViewImagePreviewHost(
  open: PreviewOpenHandler | null,
): void {
  previewHostOpen = open;
}

function toUrlList(raw: any): string[] {
  const urls: string[] = [];
  if (raw == null) {
    return urls;
  }
  try {
    const arr = raw as string[];
    const len = arr.length;
    for (let i = 0; i < len; i++) {
      const item = arr[i];
      if (item != null) {
        const text = `${item}`;
        if (text.length > 0) {
          urls.push(text);
        }
      }
    }
  } catch (_e) {
    // ignore
  }
  return urls;
}

function resolveCurrentUrl(urls: string[], currentRaw: any): string {
  if (urls.length == 0) {
    return "";
  }
  if (currentRaw == null) {
    return urls[0];
  }
  if (typeof currentRaw == "number") {
    const idx = currentRaw as number;
    if (idx >= 0 && idx < urls.length) {
      return urls[idx];
    }
    return urls[0];
  }
  const text = `${currentRaw}`;
  if (text.length == 0) {
    return urls[0];
  }
  for (let i = 0; i < urls.length; i++) {
    if (urls[i] == text) {
      return text;
    }
  }
  const asNum = parseFloat(text);
  if (!isNaN(asNum) && asNum >= 0 && asNum < urls.length) {
    const idx = asNum as number;
    return urls[idx];
  }
  return text;
}

function tryOpenHost(urls: string[], current: string): boolean {
  // #ifdef H5 || WEB
  const opener = previewHostOpen;
  if (opener == null) {
    return false;
  }
  if (current.length == 0 && urls.length == 0) {
    return false;
  }
  const next = current.length > 0 ? current : urls[0];
  opener(urls, next);
  return true;
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

/**
 * 解析 uni.previewImage 入参并尝试走内嵌遮罩。
 * 相对路径先转成绝对 URL，再交给遮罩。
 * @returns 已由遮罩承接时为 true
 */
export function tryOpenAppWebViewImagePreview(options: any): boolean {
  if (options == null) {
    return false;
  }
  const obj = options as UTSJSONObject;
  const rawUrls = toUrlList(obj["urls"]);
  const rawCurrent = resolveCurrentUrl(rawUrls, obj["current"]);
  const urls = normalizePreviewImageUrls(rawUrls);
  const current = normalizePreviewImageUrl(rawCurrent);
  return tryOpenHost(urls, current);
}

/**
 * 与 uni.previewImage 同语义；相对路径转为绝对地址后再预览。
 * H5 走自绘遮罩（含下载），其它端走官方预览。
 */
export function previewImageCompat(urls: string[], current: string): void {
  const absUrls = normalizePreviewImageUrls(urls);
  const absCurrent = normalizePreviewImageUrl(current);
  if (tryOpenHost(absUrls, absCurrent) == true) {
    return;
  }
  uni.previewImage({
    urls: absUrls,
    current: absCurrent,
  });
}

function previewWithNormalizedOptions(options: any): void {
  if (options == null) {
    return;
  }
  const obj = options as UTSJSONObject;
  const rawUrls = toUrlList(obj["urls"]);
  const rawCurrent = resolveCurrentUrl(rawUrls, obj["current"]);
  const absUrls = normalizePreviewImageUrls(rawUrls);
  const absCurrent = normalizePreviewImageUrl(rawCurrent);
  if (tryOpenHost(absUrls, absCurrent) == true) {
    return;
  }
  uni.previewImage({
    urls: absUrls,
    current: absCurrent,
  });
}

/**
 * 挂 window.__nuwaxPreviewImage，供 mp-html 走自绘遮罩。
 * 不改写 uni.previewImage。H5 会话页挂载遮罩后由此承接，带下载按钮。
 */
export function installAppWebViewImagePreviewHook(): void {
  // #ifdef H5 || WEB
  if (previewHookInstalled == true) {
    return;
  }
  try {
    const w = window as any;
    if (w == null) {
      return;
    }
    w.__nuwaxPreviewImage = (options: any): void => {
      previewWithNormalizedOptions(options);
    };
    previewHookInstalled = true;
  } catch (_e) {
    // ignore
  }
  // #endif
}

/** 页面卸载时去掉 hook，避免残留影响后续非内嵌页。 */
export function uninstallAppWebViewImagePreviewHook(): void {
  // #ifdef H5 || WEB
  if (previewHookInstalled != true) {
    return;
  }
  try {
    const w = window as any;
    if (w != null) {
      w.__nuwaxPreviewImage = null;
    }
  } catch (_e) {
    // ignore
  }
  previewHookInstalled = false;
  // #endif
}

function guessPreviewImageFileName(url: string): string {
  let path = url;
  const hashIdx = path.indexOf("#");
  if (hashIdx >= 0) {
    path = path.substring(0, hashIdx);
  }
  const queryIdx = path.indexOf("?");
  if (queryIdx >= 0) {
    path = path.substring(0, queryIdx);
  }
  const slashIdx = path.lastIndexOf("/");
  if (slashIdx >= 0 && slashIdx < path.length - 1) {
    const name = path.substring(slashIdx + 1);
    if (name.length > 0 && name.indexOf(".") >= 0) {
      return name;
    }
  }
  return `nuwax_image_${Date.now()}.jpg`;
}

function resolvePreviewDownloadMimeType(header: any | null): string {
  if (header == null) {
    return "image/jpeg";
  }
  const obj = header as UTSJSONObject;
  let ct = obj["content-type"];
  if (ct == null) {
    ct = obj["Content-Type"];
  }
  if (ct != null && `${ct}`.length > 0) {
    return `${ct}`;
  }
  return "image/jpeg";
}

// #ifdef H5 || WEB
function triggerBrowserImageDownload(blobUrl: string, fileName: string): void {
  try {
    const doc = document;
    const anchor = doc.createElement("a");
    anchor.href = blobUrl;
    anchor.download = fileName;
    anchor.style.display = "none";
    doc.body.appendChild(anchor);
    anchor.click();
    doc.body.removeChild(anchor);
  } catch (_e) {
    // ignore
  }
}

/**
 * 预览页 → 原生：保存当前图到相册。
 * 不走 nativeDownloadBridge（那是文件树 zip 下载桥）。
 */
function postPreviewSaveImageToNative(url: string, fileName: string): boolean {
  try {
    const w = window as any;
    if (w == null) {
      return false;
    }
    const uniGlobal = w.uni;
    if (
      uniGlobal == null ||
      uniGlobal.webView == null ||
      uniGlobal.webView.postMessage == null
    ) {
      return false;
    }
    uniGlobal.webView.postMessage({
      "data": {
        "type": "download",
        "action": "saveImage",
        "url": url,
        "filename": fileName,
      } as UTSJSONObject,
    });
    return true;
  } catch (_e) {
    return false;
  }
}
// #endif

/**
 * 预览页下载当前图片。
 * App 内嵌 H5：走原生保存相册（WebView 会忽略 a[download]）。
 * 浏览器直开：仍走 blob 下载。
 */
export function downloadPreviewImage(url: string): void {
  if (url.length == 0) {
    return;
  }
  // #ifdef H5 || WEB
  const fileName = guessPreviewImageFileName(url);

  if (
    isAppWebViewEmbedded() == true &&
    url.indexOf("data:") != 0 &&
    url.indexOf("blob:") != 0
  ) {
    if (postPreviewSaveImageToNative(url, fileName) == true) {
      return;
    }
  }

  uni.showLoading({ title: t("Mobile.FileTree.downloading"), mask: true });

  if (url.indexOf("data:") == 0 || url.indexOf("blob:") == 0) {
    triggerBrowserImageDownload(url, fileName);
    uni.hideLoading();
    uni.showToast({
      title: t("Mobile.FileTree.downloadComplete"),
      icon: "success",
    });
    return;
  }

  uni.request({
    url: url,
    method: "GET",
    responseType: "arraybuffer",
    dataType: "text",
    success: (res) => {
      uni.hideLoading();
      if (res.statusCode == 200 && res.data != null) {
        try {
          const mimeType = resolvePreviewDownloadMimeType(res.header);
          const blob = new Blob([res.data as ArrayBuffer], { type: mimeType });
          const objectUrl = URL.createObjectURL(blob);
          triggerBrowserImageDownload(objectUrl, fileName);
          setTimeout((): void => {
            URL.revokeObjectURL(objectUrl);
          }, 2000);
          uni.showToast({
            title: t("Mobile.FileTree.downloadComplete"),
            icon: "none",
          });
          return;
        } catch (_eBlob) {
          // fallthrough
        }
      }
      uni.showToast({
        title: t("Mobile.FileTree.downloadNetworkFailed"),
        icon: "none",
      });
    },
    fail: (_err) => {
      uni.hideLoading();
      uni.showToast({
        title: t("Mobile.FileTree.downloadNetworkFailed"),
        icon: "none",
      });
    },
  });
  // #endif
}

/**
 * APP 原生：下载预览图并保存到系统相册。
 * 仅由内嵌 WebView 壳在收到预览页 saveImage 消息后调用。
 */
// #ifdef APP
export function savePreviewImageToAlbumInApp(downloadUrl: string): Promise<void> {
  return new Promise<void>((resolve, reject) => {
    if (downloadUrl.length == 0) {
      reject(new Error(t("Mobile.FileTree.downloadNetworkFailed")));
      return;
    }
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    const token = tokenRaw != null ? `${tokenRaw}` : "";
    const header = new UTSJSONObject();
    // 对象存储 / CDN 图不能带业务 JWT：S3/MinIO 会直接 400 Bad Request
    const attachAuth = isSameOriginPreviewUrl(downloadUrl) == true && token.length > 0;
    if (attachAuth == true) {
      header.set("Authorization", `Bearer ${token}`);
    }

    uni.showLoading({ title: t("Mobile.FileTree.downloading"), mask: true });
    uni.downloadFile({
      url: downloadUrl,
      header: header,
      success: (res) => {
        const tempPath = res.tempFilePath;
        if (res.statusCode == 200 && tempPath != null && tempPath.length > 0) {
          uni.saveImageToPhotosAlbum({
            filePath: tempPath,
            success: (_saveRes) => {
              uni.hideLoading();
              uni.showToast({
                title: t("Mobile.ImagePreview.savedToAlbum"),
                icon: "success",
              });
              resolve();
            },
            fail: (saveErr) => {
              uni.hideLoading();
              console.error("保存预览图到相册失败:", saveErr);
              uni.showToast({
                title: t("Mobile.FileTree.saveFailed"),
                icon: "none",
              });
              reject(saveErr);
            },
          });
          return;
        }
        uni.hideLoading();
        uni.showToast({
          title: t("Mobile.FileTree.downloadNetworkFailed"),
          icon: "none",
        });
        reject(new Error(t("Mobile.FileTree.downloadNetworkFailed")));
      },
      fail: (err) => {
        uni.hideLoading();
        let errLog = "";
        try {
          errLog = JSON.stringify(err);
        } catch (_eErrLog) {
          errLog = `${err}`;
        }

        console.error("下载预览图失败:", err);
        uni.showToast({
          title: t("Mobile.FileTree.downloadNetworkFailed"),
          icon: "none",
        });
        reject(err);
      },
    });
  });
}
// #endif
