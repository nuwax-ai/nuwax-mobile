<template>
  <!--
    名片二维码独立页（我的页 / 群设置页共用，替代原 qr-card-popup 弹窗）：
    - 正面：名字 + 账号/群号副题 + 二维码（view 叠加中央「名字方块」，替代原 logo 白垫）+ tip 文案
    - 点导航栏右上角链接 icon → 白色内容卡片翻转 180°（页面/导航不动，按钮在卡外随面切换）：
      背面在原二维码位置展示「{name}申请添加你为联系人，点击链接处理」+ 链接（群=群号引导 + 群号）
    - 保存图片：屏外 canvas 按模块矩阵重绘码 + 同款名字方块（贪心折两行 + measureText 截断）
      → toDataURL 存相册；canvas 链路异常回退纯码图（qrPngDataUrl，无中央遮盖扫码率最优）
    - 二维码本地生成（encodeQr + qrPngDataUrl，纯 UTS 无网络依赖），内容按参数页内重建
      （buildUserCardUrl / buildGroupCardContent，与扫一扫 match 对称）
    - 翻转用两段式（0→90° 换面 → -90°→0°），规避 backface-visibility 跨端支持风险；
      rotateY 万一某端不生效则退化为硬切换面，功能不受损
  -->
  <view class="qs-page">
    <custom-nav-bar :title="navTitle" :show-back="true" :has-safety-zone="true">
      <template #right>
        <view v-if="state == 'done'" class="qs-nav-action" @click="toggleSide">
          <svg-icon
            :name="side == 'front' ? 'icon-Link' : 'icon-Qrcode'"
            size="40"
            color="#1c1b20"
          />
        </view>
      </template>
    </custom-nav-bar>

    <view class="qs-body">
      <!-- 翻转容器 = 整张白色内容卡片（用户口径：内容卡片翻转，非页面翻转）；
           transition 属性/曲线落 class，时长走内联（chat.uvue agentClockStyle 同款）。
           卡高固定 720rpx（正面内容高为最大面），两面均 absolute 铺满：换面时高度不跳 -->
      <view class="qs-card" :style="flipStyleText">
        <!-- 正面 -->
        <view v-show="side == 'front'" class="qs-card__face qs-card__face--front">
          <text class="qs-card__name">{{ cardName }}</text>
          <text class="qs-card__subtitle">{{ cardSubtitle }}</text>

          <view class="qs-qr-slot">
            <view v-if="state == 'loading'" class="qs-qr-state">
              <text class="qs-qr-state__text">{{ t("Mobile.Common.loading") }}</text>
            </view>
            <view v-else-if="state == 'failed'" class="qs-qr-state">
              <text class="qs-qr-state__text">{{ t("Mobile.Qr.generateFailed") }}</text>
            </view>
            <template v-else>
              <!-- 不挂 @click 放大：放大图不含名字胶囊且长按保存会失败，统一走下方保存按钮 -->
              <image
                class="qs-qr-image"
                :src="dataUrl"
                mode="aspectFit"
                :fade-show="false"
              />
              <!-- 中央名字方块（显示层叠加，替代原 logo 白垫）：白色圆角方块 + 名字最多两行省略；
                   边长 140rpx（遮盖 ~10% < ECL M 15% 纠错余量，且不碰 timing/定位/校正图形）；
                   名字为空不显示（保存图同步跳过）。保存图由屏外 canvas 等比重绘（drawSaveQr） -->
              <view v-if="cardName.length > 0" class="qs-qr-name-tile">
                <text class="qs-qr-name-text">{{ cardName }}</text>
              </view>
              <!-- 吞触摸蒙层：鸿蒙等端 image 原生长按会弹无名字的预览/保存菜单，
                   叠透明 view 让长按落不到 image 上（码图与方块都罩住），存图只走保存按钮 -->
              <view class="qs-qr-guard" />
            </template>
          </view>

          <text class="qs-card__tip">{{ cardTip }}</text>
        </view>

        <!-- 背面：名字/副题与正面同位；原二维码槽内换引导文案+链接（个人/群） -->
        <view v-show="side == 'back'" class="qs-card__face qs-card__face--back">
          <text class="qs-card__name">{{ cardName }}</text>
          <text class="qs-card__subtitle">{{ cardSubtitle }}</text>
          <view class="qs-qr-slot qs-back-area">
            <text class="qs-back-desc">{{ backDescText }}</text>
            <text class="qs-back-link">{{ backLinkText }}</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮（卡外，随面切换；单键占满行宽） -->
      <view v-if="side == 'front'" class="qs-actions">
        <view
          class="qs-btn qs-btn--plain"
          :class="saving ? 'qs-btn--saving' : ''"
          @click="handleSaveImage"
        >
          <text class="qs-btn__text qs-btn__text--plain">{{
            saving ? t("Mobile.Qr.saving") : t("Mobile.Qr.saveImage")
          }}</text>
        </view>
      </view>
      <view v-else class="qs-actions">
        <view class="qs-btn qs-btn--plain" @click="handleCopyLink">
          <text class="qs-btn__text qs-btn__text--plain">{{ t("Mobile.Scan.copy") }}</text>
        </view>
      </view>
    </view>

    <!-- 保存合成画布（屏外常驻）：点保存时按模块矩阵重绘码 + 中央名字方块 → toDataURL；
         width/height 组件属性 = 绘制缓冲区尺寸（App/Web 端再用 Element 强制对齐一遍，
         小程序端无同步 Element API 只能依赖该属性）；任何环节异常由调用方回退纯码图 -->
    <canvas
      id="qsSaveCanvas"
      type="2d"
      :width="saveCanvasPx"
      :height="saveCanvasPx"
      class="qs-save-canvas"
    />
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { encodeQr } from "@/utils/qrcode/qrcodeEncoder";
  import type { QrEncodeResult } from "@/utils/qrcode/qrcodeEncoder";
  import { qrPngDataUrl } from "@/utils/qrcode/qrPng";
  import { saveQrImageToAlbum, qrImageFileName } from "@/utils/qrImageSave";
  import { buildUserCardUrl, buildGroupCardContent } from "@/utils/scanRouter";
  import { writeClipboardText } from "@/utils/clipboard";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ===== 页面参数态（user | group；雪花号/群号/convId 全程字符串）=====
  const qrType = ref<string>("user");
  const cardName = ref<string>("");
  /** 账号（user）/ 群号（group），副题与背面链接共用 */
  const cardAccount = ref<string>("");
  const cardUserId = ref<string>("");
  const cardConvId = ref<string>("");

  // ===== 二维码生成态（loading | failed | done，纯字符串避免枚举串化平台分歧）=====
  const state = ref<string>("loading");
  const dataUrl = ref<string>("");
  /** 编码结果暂存（保存时 canvas 重绘用；模板不读，普通 let 即可） */
  let qrResult: QrEncodeResult | null = null;
  /** 码内容（个人=名片 URL，群=group#群号[#convId]；页面内重建不透传） */
  let qrContent = "";

  /** 保存合成画布边长（px）：与显示槽 440rpx 等比换算胶囊/字号（×800/440），
   *  清晰度高于屏幕显示且与原纯码保存图（592~720px）同量级；再大内存/耗时翻倍收益小 */
  const saveCanvasPx = 800;

  /** 纯码兜底图 scale（canvas 链路异常时用 qrPngDataUrl：v4~v6 ≈592~720px） */
  const SAVE_SCALE = 16;

  // ===== 翻转态 =====
  const side = ref<string>("front");
  const flipDeg = ref<number>(0);
  const flipDurationMs = ref<number>(0);
  const flipping = ref<boolean>(false);

  const saving = ref<boolean>(false);

  // ===== 派生（一律 computed：Android 模板 fn() 绑定不收集方法体内依赖）=====

  /** 导航标题：正面 我/群二维码；背面 我/群链接 */
  const navTitle = computed<string>(() => {
    if (side.value == "back") {
      return t(qrType.value == "group" ? "Mobile.Qr.groupLinkTitle" : "Mobile.Qr.myLinkTitle");
    }
    return t(qrType.value == "group" ? "Mobile.Qr.titleGroup" : "Mobile.Qr.titleUser");
  });

  /** 卡片翻转内联样式：基态显式 rotateY(0deg)（iOS 复位先例），时长内联驱动两段动画 */
  const flipStyleText = computed<string>(() => {
    return `transform: rotateY(${flipDeg.value}deg); transition-duration: ${flipDurationMs.value}ms;`;
  });

  /** 副题：账号：xxx / 群号：xxx（i18n 复用弹窗两个 label 键） */
  const cardSubtitle = computed<string>(() => {
    const params = new Map<string, string | number>();
    params.set(qrType.value == "group" ? "no" : "account", cardAccount.value);
    return translateFn(
      qrType.value == "group" ? "Mobile.Qr.groupNoLabel" : "Mobile.Qr.accountLabel",
      toI18nParams(params),
      cardAccount.value,
    );
  });

  /** 码下 tip（沿用弹窗两键） */
  const cardTip = computed<string>(() => {
    return t(qrType.value == "group" ? "Mobile.Qr.groupScanTip" : "Mobile.Qr.userScanTip");
  });

  /** 背面引导语：个人={name}申请添加你为联系人；群=搜索群号申请加入 */
  const backDescText = computed<string>(() => {
    if (qrType.value == "group") {
      return t("Mobile.Qr.joinGroupPrompt");
    }
    const params = new Map<string, string | number>();
    params.set("name", cardName.value);
    return translateFn("Mobile.Qr.linkRequestDesc", toI18nParams(params), "");
  });

  /** 背面链接文本：个人=名片 URL；群=群号 */
  const backLinkText = computed<string>(() => {
    return qrType.value == "group" ? cardAccount.value : qrContent;
  });

  // ===== 工具 =====

  /** 读页面参数（容错解码，im-join-group 同款） */
  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  /** 展示名截断（仅展示用，超长截 64 字符） */
  function truncateName(name: string): string {
    return name.length > 64 ? name.substring(0, 64) : name;
  }

  // ===== 生命周期与生成（generateQr 须先于 onLoad 声明：UTS 不提升）=====

  /** 生成展示用二维码（不含中央胶囊：显示层 view 叠加；参数沿用弹窗 scale=12/border=2） */
  function generateQr(): void {
    if (qrContent.length == 0) {
      state.value = "failed";
      return;
    }
    state.value = "loading";
    // 同步计算放下一帧：先渲 loading（v4~v5 毫秒级，仅为交互确定性，弹窗同款）
    setTimeout(() => {
      const res = encodeQr(qrContent);
      if (res == null) {
        state.value = "failed";
        return;
      }
      qrResult = res;
      dataUrl.value = qrPngDataUrl(res, 12, 2);
      state.value = "done";
    }, 0);
  }

  onLoad((options: any) => {
    qrType.value = readOption(options, "type") == "group" ? "group" : "user";
    cardName.value = truncateName(readOption(options, "name"));
    cardAccount.value = readOption(options, qrType.value == "group" ? "no" : "account");
    cardUserId.value = readOption(options, "userId");
    cardConvId.value = readOption(options, "convId");
    // 码内容页内重建（不透传）：与扫一扫 match 侧对称；空 host → build 返回空串 → failed 态
    qrContent = qrType.value == "group"
      ? buildGroupCardContent(cardAccount.value, cardConvId.value)
      : buildUserCardUrl(cardUserId.value, cardAccount.value);
    generateQr();
  });

  // ===== 翻转（两段式：0→90° 换面瞬移 -90° → 0°；规避 backface-visibility）=====

  function toggleSide(): void {
    if (flipping.value || state.value != "done") {
      return;
    }
    flipping.value = true;
    flipDurationMs.value = 180;
    flipDeg.value = 90;
    setTimeout(() => {
      side.value = side.value == "front" ? "back" : "front";
      flipDurationMs.value = 0;
      flipDeg.value = -90;
      setTimeout(() => {
        flipDurationMs.value = 180;
        flipDeg.value = 0;
        setTimeout(() => {
          flipping.value = false;
        }, 190);
      }, 30);
    }, 190);
  }

  // ===== 保存图合成（屏外 canvas：码矩阵重绘 + 中央名字方块）=====

  /** measureText 可用性探测（缺席的端走定长启发） */
  function ctxMeasurable(ctx: CanvasRenderingContext2D): boolean {
    try {
      ctx.measureText("测");
      return true;
    } catch (_e) {
      return false;
    }
  }

  /** 名字按宽度截断（measureText 逐字回退 + 补省略号；measure 缺席按 heuristicChars 定长截） */
  function fitNameToWidth(
    ctx: CanvasRenderingContext2D,
    name: string,
    maxWidth: number,
    heuristicChars: number,
  ): string {
    if (!ctxMeasurable(ctx)) {
      return name.length > heuristicChars ? name.substring(0, heuristicChars - 1) + "…" : name;
    }
    if (ctx.measureText(name).width <= maxWidth) {
      return name;
    }
    let txt = name;
    while (txt.length > 1) {
      txt = txt.substring(0, txt.length - 1);
      if (ctx.measureText(txt + "…").width <= maxWidth) {
        return txt + "…";
      }
    }
    return "…";
  }

  /** 贪心取第一行（宽度内最长前缀，至少 1 字符；measure 缺席按 heuristicChars 定长） */
  function greedyFirstLine(
    ctx: CanvasRenderingContext2D,
    name: string,
    maxWidth: number,
    heuristicChars: number,
  ): string {
    if (!ctxMeasurable(ctx)) {
      return name.length > heuristicChars ? name.substring(0, heuristicChars) : name;
    }
    let cur = "";
    for (let i = 0; i < name.length; i++) {
      const test = cur + name.charAt(i);
      if (ctx.measureText(test).width <= maxWidth) {
        cur = test;
      } else {
        break;
      }
    }
    if (cur.length == 0) {
      cur = name.charAt(0);
    }
    return cur;
  }

  /** 名字方块折行：单行装得下→1 行；否则贪心两行，尾行超宽复用 fitNameToWidth 截断（…） */
  function wrapNameForSquare(
    ctx: CanvasRenderingContext2D,
    name: string,
    maxWidth: number,
    heuristicChars: number,
  ): Array<string> {
    const lines: Array<string> = [];
    if (ctxMeasurable(ctx) && ctx.measureText(name).width <= maxWidth) {
      lines.push(name);
      return lines;
    }
    const line1 = greedyFirstLine(ctx, name, maxWidth, heuristicChars);
    const rest = name.substring(line1.length);
    if (rest.length == 0) {
      lines.push(line1);
      return lines;
    }
    lines.push(line1);
    lines.push(fitNameToWidth(ctx, rest, maxWidth, heuristicChars));
    return lines;
  }

  /** 圆角矩形路径（roundRect App 端不支持 → 四角 arc 手拼；显式 false 顺时针方向） */
  function roundRectPath(
    ctx: CanvasRenderingContext2D,
    x0: number,
    y0: number,
    w: number,
    h: number,
    r: number,
  ): void {
    ctx.beginPath();
    ctx.moveTo(x0 + r, y0);
    ctx.lineTo(x0 + w - r, y0);
    ctx.arc(x0 + w - r, y0 + r, r, (-Math.PI) / 2, 0, false);
    ctx.lineTo(x0 + w, y0 + h - r);
    ctx.arc(x0 + w - r, y0 + h - r, r, 0, Math.PI / 2, false);
    ctx.lineTo(x0 + r, y0 + h);
    ctx.arc(x0 + r, y0 + h - r, r, Math.PI / 2, Math.PI, false);
    ctx.lineTo(x0, y0 + r);
    ctx.arc(x0 + r, y0 + r, r, Math.PI, (Math.PI * 3) / 2, false);
    ctx.closePath();
  }

  /** 重绘保存图到 ctx：白底 + 模块矩阵（整数像素无毛边）+ 中央名字方块（与显示层 440rpx 槽等比）。
   *  W=绘制坐标空间边长：首遍=标称画布边长；若导出实测缓冲区更大/更小按实测值整幅重画 */
  function drawSaveQr(ctx: CanvasRenderingContext2D, res: QrEncodeResult, W: number): void {
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, W, W);

    // 码矩阵：整数模块像素居中（border=2 与显示/纯码兜底同口径）
    const size = res.size;
    const border = 2;
    const mpx = Math.floor(W / (size + border * 2));
    const codePx = mpx * (size + border * 2);
    const off = Math.floor((W - codePx) / 2);
    ctx.fillStyle = "#000000";
    for (let my = 0; my < size; my++) {
      for (let mx = 0; mx < size; mx++) {
        if (res.modules[my * size + mx]) {
          ctx.fillRect(off + (border + mx) * mpx, off + (border + my) * mpx, mpx, mpx);
        }
      }
    }

    // 中央名字方块：几何与显示层（440rpx 槽）等比——140rpx 方形 / 圆角 20rpx /
    // 内距 16rpx / 字号 24rpx / 文字区宽 108rpx（最多两行，对齐 lines:2）；
    // font 只写「字号 + 字族」最小形态（weight 前缀在 App 端解析有失败先例，宁缺毋滥）
    if (cardName.value.length == 0) {
      return;
    }
    const s = W / 440;
    const tile = Math.round(140 * s);
    const radius = Math.round(20 * s);
    const pad = Math.round(16 * s);
    const fontPx = Math.round(24 * s);
    const textW = tile - pad * 2;
    const heuristicChars = Math.max(1, Math.floor(textW / fontPx));
    ctx.font = `${fontPx}px sans-serif`;
    const lines = wrapNameForSquare(ctx, cardName.value, textW, heuristicChars);

    const cx = W / 2;
    roundRectPath(ctx, cx - tile / 2, cx - tile / 2, tile, tile, radius);
    ctx.fillStyle = "#ffffff";
    ctx.fill();

    // 文字：默认 alphabetic 基线 + 左对齐（不设 textAlign/textBaseline，规避端差异），
    // 水平按实测宽度居中，垂直基线 = cy ± 行高/2 + 0.35×字号（近似视觉居中）
    ctx.fillStyle = "#1c1b20";
    const lineH = fontPx * 1.42; // 对齐显示层 line-height 34/24
    if (lines.length == 1) {
      const tw = ctx.measureText(lines[0]).width;
      ctx.fillText(lines[0], cx - tw / 2, cx + fontPx * 0.35);
    } else {
      const baseTop = cx - lineH / 2 + fontPx * 0.35;
      for (let li = 0; li < lines.length; li++) {
        const tw = ctx.measureText(lines[li]).width;
        ctx.fillText(lines[li], cx - tw / 2, baseTop + li * lineH);
      }
    }
  }

  /** 读 PNG dataUrl 的 IHDR 宽高（护栏校验导出尺寸；返回 [w, h]，非 PNG/解析失败 [-1, -1]） */
  function pngSizeFromDataUrl(dataUrl: string): Array<number> {
    const prefix = "data:image/png;base64,";
    if (dataUrl.indexOf(prefix) != 0) {
      return [-1, -1];
    }
    const b64 = dataUrl.substring(prefix.length, prefix.length + 32); // 32 字符 → 24 字节
    const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    let buf = 0;
    let bits = 0;
    const bytes: Array<number> = [];
    for (let i = 0; i < b64.length; i++) {
      const v = alphabet.indexOf(b64.charAt(i));
      if (v < 0) {
        break;
      }
      buf = (buf << 6) | v;
      bits += 6;
      if (bits >= 8) {
        bits -= 8;
        bytes.push((buf >> bits) & 0xff);
        if (bytes.length >= 24) {
          break;
        }
      }
    }
    if (bytes.length < 24 || bytes[0] != 0x89 || bytes[12] != 0x49 || bytes[13] != 0x48) {
      return [-1, -1]; // 非 PNG 或结构异常（0x49/0x48 = "IH"）
    }
    // PNG 签名 8B + IHDR 长度 4B + "IHDR" 4B → 宽 BE32 位于 16..19、高 20..23
    const w = (bytes[16] << 24) | (bytes[17] << 16) | (bytes[18] << 8) | bytes[19];
    const h = (bytes[20] << 24) | (bytes[21] << 16) | (bytes[22] << 8) | bytes[23];
    return [w, h];
  }

  /** 屏外 canvas 合成保存图 → dataUrl（reject = 任一环节异常，调用方回退纯码图）。
   *  各失败点打 [QrSave] 探针日志（复验后移除）：真机 logcat grep QrSave 定位断点 */
  function composeSaveImage(res: QrEncodeResult): Promise<string> {
    return new Promise<string>((resolve, reject) => {
      // App/Web：先对齐缓冲区再取 context（小程序端无同步 Element API，依赖 :width/:height 属性）
      // #ifdef APP || H5 || WEB
      const el = uni.getElementById("qsSaveCanvas");
      if (el != null) {
        const cv = el as UniCanvasElement;
        cv.width = saveCanvasPx;
        cv.height = saveCanvasPx;
      } else {
        console.log("[QrSave] element miss (getElementById null)");
      }
      // #endif
      uni.createCanvasContextAsync({
        id: "qsSaveCanvas",
        success: (cctx) => {
          const ctx = cctx.getContext("2d");
          if (ctx == null) {
            console.log("[QrSave] ctx null");
            reject(new Error("canvas 2d context null"));
            return;
          }
          let exported = "";
          try {
            drawSaveQr(ctx, res, saveCanvasPx);
            exported = cctx.toDataURL();
          } catch (e) {
            console.log("[QrSave] draw/export err", e);
            reject(new Error("draw or export error"));
            return;
          }
          // ★自适应缓冲区：canvas 坐标=缓冲区像素（官方口径 offsetWidth×dpr + ctx.scale），
          // 各端缓冲区未必等于标称 800（dpr 缩放 / :width 属性未生效）。实测导出尺寸
          // 为方形且≠标称 → 按实测边长整幅重画一遍（坐标空间随之放大/缩小，几何等比不变）
          let dims = pngSizeFromDataUrl(exported);
          let w = dims[0];
          const h = dims[1];
          if (w > 0 && h > 0 && w == h && w != saveCanvasPx) {
            console.log(`[QrSave] buffer ${w} != ${saveCanvasPx}, redraw`);
            try {
              drawSaveQr(ctx, res, w);
              exported = cctx.toDataURL();
              dims = pngSizeFromDataUrl(exported);
              w = dims[0];
            } catch (e) {
              console.log("[QrSave] redraw err", e);
              reject(new Error("redraw error"));
              return;
            }
          }
          // 护栏：非方形缓冲区（如小程序默认 300×150）画不满整幅→残图，一律回退纯码；
          // 方形但 <400px 分辨率过低保名不保清晰，同样回退；PNG 解析不出（非 PNG 导出）
          // 则只靠长度护栏。全白空图经真压缩 base64 仅几 KB，正常码图在数百 KB 量级
          const sizeOk = (w < 0 || dims[1] < 0) || (w == dims[1] && w >= 400);
          if (exported.indexOf("data:image/") != 0 || !sizeOk || exported.length < 60000) {
            console.log(`[QrSave] export bad w=${w} h=${dims[1]} len=${exported.length}`);
            reject(new Error("canvas export suspicious"));
            return;
          }
          console.log(`[QrSave] ok w=${w} len=${exported.length}`);
          resolve(exported);
        },
        fail: (err) => {
          console.log("[QrSave] cca fail", err);
          reject(new Error("createCanvasContextAsync fail"));
        },
      });
    });
  }

  // ===== 操作 =====

  /** 保存图片：canvas 重绘含名字方块方图（异常回退纯码图）→ 跨端落相册 */
  async function handleSaveImage(): Promise<void> {
    if (saving.value || state.value != "done") {
      return;
    }
    const res = qrResult;
    if (res == null) {
      return;
    }
    saving.value = true;
    // ★让一帧给渲染：反馈只用按钮态（文案+半透明），不用 showLoading——
    // 遮罩的出现/消失在快操作下本身就是一次全屏闪动
    await new Promise<void>((resolve) => {
      setTimeout(() => {
        resolve();
      }, 50);
    });
    try {
      let dataUrlToSave = "";
      try {
        dataUrlToSave = await composeSaveImage(res);
      } catch (_e) {
        // canvas 链路异常（上下文拿不到/缓冲区口径不对/导出可疑）→ 纯码兜底
        dataUrlToSave = qrPngDataUrl(res, SAVE_SCALE, 2);
      }
      await saveQrImageToAlbum(dataUrlToSave, qrImageFileName(cardName.value));
    } catch (_e) {
      // 失败提示已由保存链路分类弹出（权限引导/失败 toast），此处仅复位态
    }
    saving.value = false;
  }

  /** 复制：个人=名片 URL，群=群号 */
  function handleCopyLink(): void {
    const text = qrType.value == "group" ? cardAccount.value : qrContent;
    writeClipboardText(
      text,
      () => {
        uni.showToast({ title: t("Mobile.Scan.copied"), icon: "none" });
      },
      () => {
        uni.showToast({ title: t("Mobile.Scan.copyFailed"), icon: "none" });
      },
    );
  }

</script>

