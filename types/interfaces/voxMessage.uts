/**
 * Nuwax Vox 设备语音网关 - App 推送消息接口类型（应用内消息中心，不走系统推送）
 * 接口文档: GET /api/app/push/messages 等
 */

/** 推送消息列表查询参数 */
export class AppPushMessageListParams {
  // 只看未读
  unreadOnly: boolean = false;
  // 最近条数，默认 20
  limit: number = 20;
}

/** 推送消息 */
export interface IAppPushMessageView {
  id: number;
  // 消息类型（如 meeting_summary），含义决定 refId 指向
  messageType: string;
  // 业务关联 ID，含义由 messageType 决定（如会议 ID）
  refId?: number | null;
  title: string;
  // 正文摘要
  body: string;
  read: boolean;
  // 创建时间 ISO-8601
  createdAt: string;
}

/** 未读推送数量（应用内角标） */
export interface IAppPushUnreadCountView {
  unreadCount: number;
}
