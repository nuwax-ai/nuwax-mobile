/**
 * App 分享出去。
 *
 * 直接发当前页面的真实 http(s) 地址。
 */
import { getApiBaseUrl } from "@/constants/config";
import { hasLoginSession } from "@/utils/authSession";
import { redirectToLoginOnce } from "@/utils/authNavigation";
import { openShareIntoChat } from "@/utils/im/imForwardSession";
import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

export class ShareTarget {
  kind: string = "";
  id: string = "";
  title: string = "";
  text: string = "";
  sk: string = "";
  filePath: string = "";
  /** 外部分享要直接展示的 http(s) 页面。 */
  pageUrl: string = "";
}

function queryValue(raw: string, key: string): string {
  const mark = raw.indexOf("?");
  const query = mark >= 0 ? raw.substring(mark + 1) : raw;
  const parts = query.split("&");
  const prefix = key + "=";
  for (let i = 0; i < parts.length; i++) {
    const part = parts[i];
    if (part.indexOf(prefix) == 0) {
      try {
        const decoded = decodeURIComponent(part.substring(prefix.length));
        return decoded != null ? decoded : part.substring(prefix.length);
      } catch (_e) {
        return part.substring(prefix.length);
      }
    }
  }
  return "";
}

/**
 * 分享地址所用站点。
 * App 用当前服务域名；H5 生产环境接口走相对路径、服务域名为空时，用页面自己的 origin。
 */
function sharePageOrigin(): string {
  const api = getApiBaseUrl();
  if (api.length > 0) return api;
  // #ifdef H5 || WEB
  try {
    const origin = window.location.origin;
    const text = origin != null ? `${origin}` : "";
    if (text.length > 0 && text.indexOf("file:") != 0) return text;
  } catch (_e) {
    return "";
  }
  // #endif
  return "";
}

/** 对外发出的链接。一律用当前页面真实地址，不再包进 share-open.html。 */
export function buildOutgoingShareUrl(target: ShareTarget): string {
  const page = target.pageUrl;
  if (page.indexOf("http://") != 0 && page.indexOf("https://") != 0) return "";
  return page;
}

let rememberedAgentId = "";
let rememberedAgentTitle = "";

export function rememberShareAgent(id: string, title: string): void {
  rememberedAgentId = id;
  rememberedAgentTitle = title;
}

export function shareRememberedAgent(): void {
  if (rememberedAgentId.length == 0) {
    uni.showToast({ title: t("Mobile.Share.noAgent"), icon: "none" });
    return;
  }
  const target = new ShareTarget();
  target.kind = "agent";
  target.id = rememberedAgentId;
  target.title = rememberedAgentTitle.length > 0 ? rememberedAgentTitle : "女娲智能体";
  const origin = sharePageOrigin();
  const url = origin.length > 0
    ? origin + "/m/#/subpackages/pages/agent-detail/agent-detail?id=" + encodeURIComponent(rememberedAgentId)
    : "";
  target.pageUrl = url;
  chooseShareTarget(target.title, url, () => {
    shareTarget(target);
  });
}

/**
 * 会话对外分享地址。直接返回当前页面真实地址。
 * @param title 分享标题（保留入参，调用方仍传入）
 * @param pageUrl 已去掉 token 等宿主参数的会话地址
 */
export function buildConversationTransferUrl(title: string, pageUrl: string): string {
  if (pageUrl.indexOf("http://") != 0 && pageUrl.indexOf("https://") != 0) return "";
  return pageUrl;
}

/**
 * 分享当前会话。对外链接是当前页面真实地址。
 * @param title 分享摘要标题
 * @param pageUrl 已去掉 token 等宿主参数的会话地址
 */
export function shareConversationLink(title: string, pageUrl: string): void {
  const name = title.length > 0 ? title : "女娲智能体";
  const openUrl = buildConversationTransferUrl(name, pageUrl);
  if (openUrl.length == 0) {
    shareRememberedAgent();
    return;
  }
  const target = new ShareTarget();
  target.kind = "page";
  target.title = name;
  target.pageUrl = pageUrl;
  chooseShareTarget(name, openUrl, () => {
    shareTarget(target);
  });
}

/** 分享面板入参。当前页的 share-sheet 组件读取，不单独开页面。 */
export class PendingShareSheet {
  title: string = "";
  /** 发进女娲会话的正文，通常是标题加链接。 */
  body: string = "";
  /** 可复制、可在浏览器打开的 http(s) 链接。 */
  url: string = "";
  /** 面板顶栏「此网页由 xxx 提供」。 */
  host: string = "";
}

/** 当前页挂上的分享面板。后挂的盖住先挂的，关闭时按 id 摘掉。 */
class ShareSheetBinding {
  id: number = 0;
  notify: () => void = (): void => {};
}

let pendingSheet: PendingShareSheet | null = null;
let pendingOutside: (() => void) | null = null;
/** 本次分享的「刷新」。网页预览、文件预览传入；没有则面板里点刷新只提示占位。 */
let pendingRefresh: (() => void) | null = null;
let shareSheetOpen = false;
let shareSheetBindings: ShareSheetBinding[] = [];
let shareSheetBindingSeq = 1;

function httpUrlIn(raw: string): string {
  const lines = raw.split("\n");
  for (let i = lines.length - 1; i >= 0; i--) {
    const line = lines[i].trim();
    if (line.indexOf("https://") == 0 || line.indexOf("http://") == 0) return line;
  }
  return "";
}

/** 中转页里的真实页面。没有 url/to 时保持原链接。 */
function unwrapSharedPageUrl(raw: string): string {
  if (raw.length == 0) return "";
  if (raw.toLowerCase().indexOf("share-open.html") < 0) return raw;
  const to = queryValue(raw, "to");
  if (to.length > 0) return to;
  const inner = queryValue(raw, "url");
  return inner.length > 0 ? inner : raw;
}

/** 转发到女娲、转发给朋友只用当前页面真实地址，不带中转页。 */
function bodyWithActualPage(body: string): string {
  const found = httpUrlIn(body);
  if (found.length == 0) return body;
  const actual = unwrapSharedPageUrl(found);
  if (actual.length == 0 || actual == found) return body;
  const at = body.indexOf(found);
  if (at < 0) return body;
  return body.substring(0, at) + actual + body.substring(at + found.length);
}

/** 分享出去一律用真实页面地址。若正文里仍是中转页，则取出其中的 url/to。 */
function outgoingHttpUrl(raw: string): string {
  if (raw.length == 0) return "";
  return unwrapSharedPageUrl(raw);
}

function hostOfHttp(raw: string): string {
  const scheme = raw.indexOf("://");
  const rest = scheme >= 0 ? raw.substring(scheme + 3) : raw;
  // indexOf 返回 number，end 显式标 number（length 是 Int，裸推断后赋值报 Number→Int）
  let end: number = rest.length;
  const slash = rest.indexOf("/");
  const question = rest.indexOf("?");
  const hash = rest.indexOf("#");
  if (slash >= 0 && slash < end) end = slash;
  if (question >= 0 && question < end) end = question;
  if (hash >= 0 && hash < end) end = hash;
  return rest.substring(0, end);
}

function clearPendingShare(): void {
  pendingSheet = null;
  pendingOutside = null;
  pendingRefresh = null;
}

function notifyTopShareSheet(): void {
  if (shareSheetBindings.length == 0) return;
  shareSheetBindings[shareSheetBindings.length - 1].notify();
}

/** 页面挂上分享面板时登记。返回 id，卸载时交给 unbindShareSheet。 */
export function bindShareSheet(notify: () => void): number {
  const item = new ShareSheetBinding();
  item.id = shareSheetBindingSeq;
  shareSheetBindingSeq += 1;
  item.notify = notify;
  shareSheetBindings.push(item);
  return item.id;
}

/** 页面卸载时摘掉自己的面板，避免关页后还通知到已销毁组件。 */
export function unbindShareSheet(id: number): void {
  const next: ShareSheetBinding[] = [];
  for (let i = 0; i < shareSheetBindings.length; i++) {
    if (shareSheetBindings[i].id != id) next.push(shareSheetBindings[i]);
  }
  shareSheetBindings = next;
}

export function isShareSheetOpen(): boolean {
  return shareSheetOpen;
}

/** 先收起当前页面板，再执行后续动作。 */
function closeShareSheetThen(action: (() => void) | null): void {
  let ran = false;
  const run = (): void => {
    if (ran) return;
    ran = true;
    if (action != null) action();
  };
  shareSheetOpen = false;
  notifyTopShareSheet();
  clearPendingShare();
  run();
}

function showLegacyShareSheet(title: string, body: string, shareOutside: () => void): void {
  uni.showActionSheet({
    itemList: [t("Mobile.Share.toNuwax"), t("Mobile.Share.toOther")],
    cancelText: t("Mobile.Common.cancel"),
    success: (res) => {
      if (res.tapIndex == 0) {
        if (hasLoginSession() != true) {
          uni.showToast({ title: t("Mobile.Share.loginRequired"), icon: "none" });
          redirectToLoginOnce();
          return;
        }
        const text = body.length > 0 ? body : title;
        openShareIntoChat(title.length > 0 ? title : t("Mobile.Share.appName"), text);
        return;
      }
      shareOutside();
    },
  });
}

export function peekShareSheet(): PendingShareSheet | null {
  return pendingSheet;
}

/** 分享到女娲：关掉面板后进入选会话页。 */
export function runShareToNuwax(): void {
  const sheet = pendingSheet;
  const title = sheet != null && sheet.title.length > 0 ? sheet.title : t("Mobile.Share.appName");
  const text = sheet != null && sheet.body.length > 0 ? sheet.body : title;
  closeShareSheetThen(() => {
    if (hasLoginSession() != true) {
      uni.showToast({ title: t("Mobile.Share.loginRequired"), icon: "none" });
      redirectToLoginOnce();
      return;
    }
    openShareIntoChat(title, text);
  });
}

/** 分享到其他应用：交给调用方原来的系统分享或复制。 */
export function runShareOutside(): void {
  const fn = pendingOutside;
  closeShareSheetThen(fn);
}

/**
 * 刷新当前页。调用方打开面板时传入了刷新函数才执行，否则返回 false 由面板提示占位。
 */
export function runShareRefresh(): boolean {
  const fn = pendingRefresh;
  if (fn == null) return false;
  closeShareSheetThen(() => {
    fn();
    uni.showToast({ title: t("Mobile.Share.refreshed"), icon: "none" });
  });
  return true;
}

/** 点遮罩或取消。 */
export function dismissShareSheet(): void {
  closeShareSheetThen(null);
}

/**
 * 新分享先打开当前页里的分享面板：转发给女娲会话，或交给调用方继续系统分享 / 复制链接。
 * 开关关闭时不弹面板，直接走调用方原来的系统分享或复制。
 * 页面需挂 components/share-sheet。当前页没挂时退回两项菜单。
 * 微信小程序仍用两项菜单。
 * @param onRefresh 网页 / 文件预览的刷新；没有可刷新内容时传 null
 */
export function chooseShareTarget(
  title: string,
  body: string,
  shareOutside: () => void,
  onRefresh: (() => void) | null = null,
): void {
  const sheet = new PendingShareSheet();
  sheet.title = title;
  const internalBody = bodyWithActualPage(body.length > 0 ? body : title);
  sheet.body = internalBody.length > 0 ? internalBody : title;
  const found = httpUrlIn(body.length > 0 ? body : title);
  sheet.url = outgoingHttpUrl(found);
  const nested = queryValue(sheet.url, "url");
  const hostSource =
    nested.indexOf("https://") == 0 || nested.indexOf("http://") == 0 ? nested : sheet.url;
  sheet.host = hostOfHttp(hostSource);
  pendingSheet = sheet;
  pendingOutside = shareOutside;
  pendingRefresh = onRefresh;
  // #ifdef MP-WEIXIN
  clearPendingShare();
  showLegacyShareSheet(title, sheet.body, shareOutside);
  return;
  // #endif
  if (shareSheetBindings.length == 0) {
    clearPendingShare();
    showLegacyShareSheet(title, sheet.body, shareOutside);
    return;
  }
  shareSheetOpen = true;
  notifyTopShareSheet();
}

/** 唤起系统分享面板，发出当前页面真实地址。 */
export function shareTarget(target: ShareTarget): void {
  const url = buildOutgoingShareUrl(target);
  const title = target.title.length > 0 ? target.title : t("Mobile.Share.appName");
  // #ifdef APP
  uni.shareWithSystem({
    type: "text",
    summary: "【" + title + "】",
    href: url,
    fail: (res: ShareWithSystemFail) => {
      if (res.errCode == 1310600) return;
      uni.setClipboardData({
        data: url,
        success: () => {
          uni.showToast({ title: t("Mobile.Share.linkCopied"), icon: "none" });
        },
      });
    },
  });
  // #endif
  // #ifndef APP
  uni.setClipboardData({
    data: url,
    success: () => {
      uni.showToast({ title: t("Mobile.Share.linkCopied"), icon: "none" });
    },
  });
  // #endif
}

