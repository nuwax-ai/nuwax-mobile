/**
 * 将本地 PCM/WAV 录音文件推给 ASR。
 * - 等每块 WebSocket send success 后再发下一块 / stop
 * - 按音频时长节流（逼近实时流），避免瞬间灌完被服务端判 no_speech
 * - 切帧必须独立拷贝 ArrayBuffer：Android UTS 上 ArrayBuffer.slice 送给 WS 易成静音 → no_speech
 */
import { ASR_FRAME_BYTES, ASR_SAMPLE_RATE } from "./asrWebSocketClient";

export type OnPcmChunkCallback = (frame: ArrayBuffer) => void;
/** 异步发送一帧，成功 resolve */
export type SendPcmAsync = (frame: ArrayBuffer) => Promise<boolean>;

/** ASR 推流硬上限：超过只取前段，避免超长录音整文件切帧打满主线程 */
const ASR_MAX_PUSH_MS: number = 60000;

/**
 * 读取录音临时文件为 ArrayBuffer。
 * 注意：勿在 Promise executor 内写 try/catch（UTS 易截断 setup）。
 */
export function readAudioFileBuffer(
  filePath: string,
  done: (buffer: ArrayBuffer | null) => void,
): void {
  const fs = uni.getFileSystemManager();
  fs.readFile({
    filePath: filePath,
    success: (res) => {
      const data = res.data;
      if (data == null) {
        done(null);
        return;
      }
      const asBuffer = data as ArrayBuffer;
      if (typeof asBuffer.byteLength == "number") {
        done(asBuffer);
        return;
      }
      done(null);
    },
    fail: (_err) => {
      console.warn("[ASR] readAudioFileBuffer fail path=" + filePath);
      done(null);
    },
  });
}

/**
 * 拷贝一段字节到新的独立 ArrayBuffer。
 * 禁止用 ArrayBuffer.slice：App 上 slice 视图经 WebSocket 发送常被当成空/静音，触发 no_speech。
 */
function copyBufferRange(
  buffer: ArrayBuffer,
  start: number,
  length: number,
): ArrayBuffer {
  const out = new ArrayBuffer(length);
  const src = new Uint8Array(buffer);
  const dst = new Uint8Array(out);
  for (let i = 0; i < length; i++) {
    dst[i] = src[start + i];
  }
  return out;
}

/** 若是 WAV，跳过 44 字节头，返回裸 PCM；否则原样返回 */
export function stripWavHeaderIfNeeded(buffer: ArrayBuffer): ArrayBuffer {
  if (buffer.byteLength < 44) {
    return buffer;
  }
  const view = new Uint8Array(buffer);
  if (
    view[0] == 0x52 &&
    view[1] == 0x49 &&
    view[2] == 0x46 &&
    view[3] == 0x46 &&
    view[8] == 0x57 &&
    view[9] == 0x41 &&
    view[10] == 0x56 &&
    view[11] == 0x45
  ) {
    const pcmLen = buffer.byteLength - 44;
    return copyBufferRange(buffer, 44, pcmLen);
  }
  return buffer;
}

/**
 * 切成不超过 maxChunkBytes 的块（默认 20ms@16k PCM16 = 640B，对齐协议帧）。
 */
export function splitPcmChunks(
  pcm: ArrayBuffer,
  maxChunkBytes: number,
): ArrayBuffer[] {
  const size = maxChunkBytes > 0 ? maxChunkBytes : ASR_FRAME_BYTES;
  const total = pcm.byteLength;
  const chunks: ArrayBuffer[] = [];
  if (total == 0) {
    return chunks;
  }
  let offset = 0;
  while (offset < total) {
    const remain = total - offset;
    const chunkLen = remain > size ? size : remain;
    chunks.push(copyBufferRange(pcm, offset, chunkLen));
    offset += chunkLen;
  }
  return chunks;
}

/** PCM16 mono 字节数 → 时长 ms */
function pcmBytesToMs(byteLength: number): number {
  const samples = byteLength / 2;
  const ms = (samples * 1000) / ASR_SAMPLE_RATE;
  if (ms < 1) {
    return 1;
  }
  return Math.floor(ms);
}

/** 按时长上限截取 PCM 前缀（16k mono PCM16） */
function truncatePcmForAsr(pcm: ArrayBuffer): ArrayBuffer {
  const maxBytes = Math.floor((ASR_SAMPLE_RATE * 2 * ASR_MAX_PUSH_MS) / 1000);
  if (pcm.byteLength <= maxBytes) {
    return pcm;
  }
  console.warn(
    "[ASR] pcm truncated for push len=" +
      pcm.byteLength.toString() +
      " max=" +
      maxBytes.toString(),
  );
  return copyBufferRange(pcm, 0, maxBytes);
}

/**
 * 读文件 → 去 WAV 头 → 按帧异步发送（success + 按时长节流）→ done。
 */
export function streamLocalAudioFileToAsr(
  filePath: string,
  sendFrameAsync: SendPcmAsync,
  done: (ok: boolean) => void,
): void {
  readAudioFileBuffer(filePath, (buffer: ArrayBuffer | null) => {
    if (buffer == null || buffer!.byteLength == 0) {
      done(false);
      return;
    }
    const pcmRaw = stripWavHeaderIfNeeded(buffer!);
    if (pcmRaw.byteLength == 0) {
      done(false);
      return;
    }
    const pcm = truncatePcmForAsr(pcmRaw);
    // 对齐协议 20ms 帧，便于服务端 VAD
    const chunks = splitPcmChunks(pcm, ASR_FRAME_BYTES);
    sendChunksSequentially(chunks, sendFrameAsync, 0, 0, done);
  });
}

function sendChunksSequentially(
  chunks: ArrayBuffer[],
  sendFrameAsync: SendPcmAsync,
  index: number,
  sentBytes: number,
  done: (ok: boolean) => void,
): void {
  if (index >= chunks.length) {
    done(true);
    return;
  }
  const frame = chunks[index];
  const paceMs = pcmBytesToMs(frame.byteLength);
  sendFrameAsync(frame).then(
    (ok: boolean) => {
      if (ok != true) {
        console.warn(
          "[ASR] stream send fail at chunk=" + index.toString(),
        );
        done(false);
        return;
      }
      const nextBytes = sentBytes + frame.byteLength;
      // 按帧时长节流，模拟实时推流（最后一帧不再额外等）
      if (index + 1 >= chunks.length) {
        sendChunksSequentially(
          chunks,
          sendFrameAsync,
          index + 1,
          nextBytes,
          done,
        );
        return;
      }
      setTimeout(() => {
        sendChunksSequentially(
          chunks,
          sendFrameAsync,
          index + 1,
          nextBytes,
          done,
        );
      }, paceMs);
    },
    (_e: any | null) => {
      console.warn("[ASR] stream send reject at chunk=" + index.toString());
      done(false);
    },
  );
}
