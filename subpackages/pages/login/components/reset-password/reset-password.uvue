<template>
    <view class="captcha-verify">
        <view class="captcha-verify-header">
            <!-- 返回按钮 -->
            <view class="back-box" @tap="handleBack">
                <svg-icon name="icon-a-Chevronleft" :size="32" customClass="back-icon" />
            </view>
        </view>
        <view class="captcha-verify-content">
            <view class="title">
                <text class="title-text">{{ t("Mobile.Auth.setPasswordTitle") }}</text>
            </view>
            <view class="phone-info">
                <text class="phone-info-text">{{ t("Mobile.Auth.setPasswordDesc") }}</text>
            </view>
        </view>
        <view class="password-input-wrapper" :class="{ 'password-input-wrapper--focus': pwdFocused }">
			<input class="password-input" password :placeholder="t('Mobile.Auth.inputPassword')" placeholder-class="login-input-placeholder" placeholder-style="color: #b9bbc5; font-size: 30rpx; font-weight: 400;" v-model="password"	cursor-color="#5147FF" @focus="pwdFocused = true" @blur="pwdFocused = false" />
			<view class="clear-btn" v-if="password.length > 0" @click="clearPassword">
				<svg-icon name="icon-a-Xcircle-fill" size="32" customClass="clear-icon" />
			</view>
		</view>
        <view class="password-input-wrapper" :class="{ 'password-input-wrapper--focus': confirmFocused }">
			<input class="password-input" password :placeholder="t('Mobile.Auth.inputPasswordAgain')" placeholder-class="login-input-placeholder" placeholder-style="color: #b9bbc5; font-size: 30rpx; font-weight: 400;" v-model="confirmPassword"	cursor-color="#5147FF" @focus="confirmFocused = true" @blur="confirmFocused = false" />
			<view class="clear-btn" v-if="confirmPassword.length > 0" @click="clearConfirmPassword">
			<svg-icon name="icon-a-Xcircle-fill" size="32" customClass="clear-icon" />
		</view>
		</view>

        <button class="reset-btn" :class="{ loading: loadingReset }" @click="handleReset" :disabled="loadingReset" :loading="loadingReset">
            <text class="reset-btn-text">{{ loadingReset ? t("Mobile.Auth.setting") : t("Mobile.Common.ok") }}</text>
        </button>
    </view>
</template>

<script lang="uts" setup>
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

    import { ref } from 'vue';
    import { apiSetPassword } from '@/servers/account'
    import { SUCCESS_CODE } from '@/constants/codes.constants'
    import { SetPasswordParams } from '@/types/interfaces/login'
    import { apiResCode, apiResMessage } from '@/utils/apiResponse'
    import { useI18n, emptyI18nParams } from "@/utils/i18n";

    const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
    // uvue 模板中直接调用 t() 会报 invoke 解析失败，这里包一层单参版本

    const props = defineProps({
        phoneNumber: {
            type: String,
            default: ''
        },
        verificationCode: {
            type: String,
            default: ''
        }
    })

    const emit = defineEmits(['reset-success', 'back'])

    // 密码
    const password = ref('')
    // 确认密码
    const confirmPassword = ref('')
    // 登录loading
    const loadingReset = ref(false)
    // vapor: :focus-within 伪类运行时丢弃，聚焦边框改 ref + 条件类
    const pwdFocused = ref(false)
    const confirmFocused = ref(false)

    // 清除密码
    const clearPassword = () => {
        password.value = ''
    }

    // 清除确认密码
    const clearConfirmPassword = () => {
        confirmPassword.value = ''
    }

    // 返回登录
    const handleBack = () => {
        emit('back')
    }

    // 密码验证
    const validatePassword = () => {
        const pass = password.value as string
        if (pass.length == 0) {
            uni.showToast({
                title: t("Mobile.Auth.inputPassword"),
                icon: 'none'
            })
            return false
        }

        if (password.value.length < 6) {
            uni.showToast({
                title: t("Mobile.Auth.passwordMinLength"),
                icon: 'none'
            })
            return false
        }

        const confirm = confirmPassword.value as string
        if (confirm.length == 0) {
            uni.showToast({
                title: t("Mobile.Auth.confirmPassword"),
                icon: 'none'
            })
            return false
        }

        if (password.value != confirmPassword.value) {
            uni.showToast({
                title: t("Mobile.Auth.passwordMismatch"),
                icon: 'none'
            })
            return false
        }

        return true
    }

    // 重置密码
    const handleReset = async () => {

        if (!validatePassword()) {
            return
        }

        try {
            loadingReset.value = true
            const params = new SetPasswordParams()
            params.password = password.value
            const res = await apiSetPassword(params)
            const code = apiResCode(res)
            const message = apiResMessage(res)

            if (code == SUCCESS_CODE) {
                uni.showToast({
                    title: t("Mobile.Auth.passwordSetSuccess"),
                    icon: 'success'
                })

                setTimeout(() => {
                    uni.reLaunch({
                        url: '/pages/index/index'
                    })
                }, 1000)
            } else {
                uni.showToast({
                    title: message.length > 0 ? message : t("Mobile.Auth.passwordSetFailed"),
                    icon: 'none'
                })
            }
        } catch (error) {
            uni.showToast({
                title: t("Mobile.Common.networkRetry"),
                icon: 'none'
            })
        } finally {
            loadingReset.value = false
        }
    }

</script>

<style lang="scss" scoped>
    // vapor: SCSS 反嵌套为顶层单类（后代/复合选择器在 vapor 被丢弃）
    .captcha-verify {
        width: 100%;
