  import { getSafeAreaBottom, handleExternalLink, openNativeHomeChatLink } from "@/utils/system";
  import { getApiBaseUrl } from "@/constants/config";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import VoiceRecorderButton from "@/components/conversation-input/voice-recorder-button/voice-recorder-button.uvue";
  import iconMd from "@/static/filetree/icon_md.svg";
  import ConfirmModal from "@/components/confirm-modal/confirm-modal.uvue";
  import MsgActionSheet from "./components/msg-action-sheet/msg-action-sheet.uvue";
  import MsgSelectCopySheet from "./components/msg-select-copy-sheet/msg-select-copy-sheet.uvue";
  import { ImMergeItem, ImMergeMedia } from "@/types/interfaces/imMergeItem";
  import { ImMergeRecordSession, openImMergeRecord } from "@/utils/im/imMergeRecordSession";
  // #ifdef APP-IOS
  import { pickIosFiles } from "@/uni_modules/nuwax-ios-file-picker";
  // #endif

  /** md 文档卡片图标（file-tree fileIconHelper 同款取法：H5 用打包资源、App 用静态路径）。 */
  // #ifdef H5 || WEB
  const mdAttIconSrc = iconMd;
  // #endif
  // #ifndef H5 || WEB
  const mdAttIconSrc = "/static/filetree/icon_md.svg";
  // #endif

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 带 count 参数的文案（多选已选 N 条 / 合并转发共 N 条等，同 at-select tCount）。 */
  const tCount = (key: string, count: number): string => {
    const m = new Map<string, string | number>();
    m.set("count", count);
    return translateFn(key, toI18nParams(m), "");
  };

  /** 历史消息单页条数（服务端上限 200，见 im-openapi LimitQueryDefault20）。 */
  const MSG_PAGE_SIZE = 20;

  /**
   * 表情面板字表（与 PC 端 nuwax-im-web lib/emoji.ts 的 EMOJIS 完全一致，
   * 两端面板同步维护）。11 行 × 8 列，飞书网格 12.5% 宽自适应。
   */
  const EMOJIS: string[] = [
    "😀", "😃", "😄", "😁", "😆", "😅", "🤣", "😂",
    "🙂", "🙃", "😉", "😊", "😇", "🥰", "😍", "🤩",
    "😘", "😗", "😋", "😛", "😜", "🤪", "🤗", "🤭",
    "🤫", "🤔", "🤐", "😐", "😑", "😶", "😏", "😒",
    "🙄", "😬", "😌", "😔", "😪", "😴", "😷", "🤒",
    "🤕", "🤢", "🥵", "🥶", "😵", "🤯", "🤠", "🥳",
    "😎", "🤓", "🧐", "😕", "😟", "🙁", "😮", "😲",
    "😳", "🥺", "😢", "😭", "😱", "😖", "😞", "😩",
    "😫", "😤", "😡", "🤬", "👍", "👎", "👌", "🙏",
    "👏", "🙌", "🤝", "💪", "✌️", "🤞", "❤️", "💔",
    "💯", "🎉", "✨", "🔥", "⭐", "✅", "❌", "⚠️",
  ];

  /** 表情网格列数（= PC 端 8 列同款；面板常用行的截断也用它——恒一行）。 */
  const EMOJI_COLS = 8;

  /**
   * 平铺字表按列数切二维行表：模板按行渲染（行内不换行），不再依赖 flex-wrap——
   * App 端 12.5% 宽的亚像素取整误差会把第 8 个 cell 挤到下一行（一排只显 7 个
   * 的根因）；分行后宽度余差由 cell 的 flex-shrink 吸收。
   */
  function chunkEmojiRows(src: string[], cols: number): string[][] {
    const rows: string[][] = [];
    for (let i = 0; i < src.length; i += cols) {
      const end = Math.min(i + cols, src.length);
      const row: string[] = [];
      for (let j = i; j < end; j++) {
        row.push(src[j]);
      }
      rows.push(row);
    }
    return rows;
  }

  /** 表情面板行表（EMOJIS 静态预切，88 个 = 11 行 × 8 列；模板嵌套 v-for 渲染）。 */
  const EMOJI_ROWS: string[][] = chunkEmojiRows(EMOJIS, EMOJI_COLS);

  /** 头像字母底色渐变板（与消息列表页同款五色系，红色已移除）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  /** rich_text 附件（kind=image 或图片后缀进图片缩略，其余按链接行展示）。 */
  class ImMsgAtt {
    url: string = "";
    fileName: string = "";
    mime: string = "";
  }

  /**
   * 待发图片（选图/拍照后先入暂存条，可与输入框文案合并成一条 rich_text 发出；
   * 单图无文字仍走 image 直发，形态判定见 handleSend）。id 供删除定位。
   */
  class StagedImage {
    id: string = "";
    localPath: string = "";
  }

  /**
   * 互动卡片动作（msgType=card 的按钮，入群审核卡的「同意/拒绝」）。
   * ★payload/actionType 是服务端写给自己看的（"通过还是拒绝"藏在 payload 里），
   *   客户端只回传 key，不读不回传 payload——点击语义由服务端从库里那条消息分发。
   */
  class ImCardAction {
    key: string = "";
    label: string = "";
    /** 只影响配色不影响语义：primary=主色 / danger=红 / 其余（含缺省）=default。 */
    style: string = "";
    /** 当前状态：pending/done/stale/forbidden；★空=服务端未回填，按 pending（可点）。 */
    state: string = "";
    /** 状态文案（done/stale/forbidden 时展示；★由服务端给定，不本地拼口径）。 */
    stateText: string = "";
  }

  /** 互动卡片字段行（label: value 键值对，纯展示）。 */
  class ImCardField {
    label: string = "";
    value: string = "";
  }

  /** "@所有人" 提及 token（与 PC 端硬编码字面量逐字一致，勿走 i18n）。 */
  const MENTION_ALL_TOKEN = "@所有人";

  /**
   * 群成员（@提及面板数据源，GET /conversations/{convId}/members）。
   * ★userId 是 int64 雪花号：经 `${raw}` 转字符串存用（Android 精确 / H5 请求层已保精度）。
   * token 是提及正文里用的显示名（插入与发送反扫必须字节一致，同 PC mentionOptions 口径）：
   * nickName || name || 用户${userId}。
   */
  class ImMember {
    userId: string = "";
    name: string = "";
    nickName: string = "";
    avatar: string = "";
    token: string = "";
  }

  /** 富文本行内段（Markdown 行内标记的组合态 + @提及高亮 + [标题](url) 链接）。 */
  class ImSeg {
    text: string = "";
    bold: boolean = false;
    italic: boolean = false;
    strike: boolean = false;
    underline: boolean = false;
    code: boolean = false;
    mention: boolean = false;
    /** 列表行首前缀段（蓝色序号 "N. " / 圆点 "· "）。 */
    listMark: boolean = false;
    /** [标题](url) 链接段：text=标题、url=跳转地址（段内不再解析标记/提及），点击打开。 */
    link: boolean = false;
    url: string = "";
  }

  /**
   * 富文本行（bodyText 按换行拆分后的渲染模型）。
   * kind：p=普通 / code=围栏代码块（text 存原文多行）/ quote=引用 / h1~h3=标题
   * / ol=有序列表 / ul=无序列表（listMarkText 存行首原前缀 "N. "，ul 恒 "· "）。
   */
  class ImRichLine {
    kind: string = "p";
    text: string = "";
    listMarkText: string = "";
    segs: ImSeg[] = [];
  }

  /** 发送时的提及扫描结果（对应 SendMessageRequest 顶层 mentionUserIds/mentionAll）。 */
  class ImMentionScan {
    ids: string[] = [];
    all: boolean = false;
  }

  /** 一条表情回复（reactions 快照元素；userId 是 int64 雪花号存字符串）。 */
  class ImReaction {
    emoji: string = "";
    userId: string = "";
    userName: string = "";
  }

  /** 合并转发卡片的预览行（senderName + 摘要；仅渲染用，转发时不回传）。 */
  class ImMergePreview {
    senderName: string = "";
    preview: string = "";
  }

  /**
   * 消息行（升序存于 messages）。
   * ★msgId/senderId 是 int64 雪花号：Android 经 `${raw}` 精确转字符串；
   *   H5 由请求层 parseJsonKeepInt64 保精度（snowflake 不丢位）。
   * status 是【客户端本地态】：0=发送中 1=已确认 2=发送失败（服务端只有 msgStatus 正常/撤回）。
   * msgType=text 走 bodyText；image 走 imageUrl；rich_text 走 bodyText + 附件
   * （图片附件进 imageAtts，文件/链接附件进 linkAtts）；replyId/reply* 为引用的原消息（服务端展开一层）。
   */
  class ImMsgRow {
    msgId: string = "";
    seq: number = 0;
    senderId: string = "";
    senderType: number = 1;
    senderName: string = "";
    senderAvatar: string = "";
    msgType: string = "text";
    bodyText: string = "";
    imageUrl: string = "";
    /** 语音消息（msgType=audio）：body.url（空=坏行不出语音条，回落 digest 系统行）。 */
    audioUrl: string = "";
    /** 语音时长秒：body.duration 可缺省（单位防御见 readMsgRow），缺失时首播后从播放器回填。 */
    audioDuration: number = 0;
    /** 视频消息（msgType=video，PC 端发出）：body.url 原样地址（多为 /api/f/ 相对路径，空=坏行回落 digest 系统行）。 */
    videoUrl: string = "";
    /** 视频文件名（body.fileName，日志与下载命名兜底用）。 */
    videoFileName: string = "";
    /** 视频大小字节（body.size，占位卡角标展示，0 不显示）。 */
    videoSize: number = 0;
    /** 可播地址（CDN 直链或受保护地址解析产物 temp/blob）：非空 ⇒ 模板挂原生 <video> 显首帧。
     *  ★须经 messages.value 代理实例回填（改原始对象不触发视图刷新）；
     *  行被快照整行替换会丢失，预载扫到后从缓存命中即时补回（换新实例重启到首帧）。 */
    videoPlayUrl: string = "";
    imageAtts: ImMsgAtt[] = [];
    linkAtts: ImMsgAtt[] = [];
    replyId: string = "";
    replySenderName: string = "";
    replyRevoked: boolean = false;
    replyIsImage: boolean = false;
    /** 引用的原消息是语音（引用预览出「[音频]」占位，同图片之「[图片]」）。 */
    replyIsAudio: boolean = false;
    /** 引用的原消息是视频（引用预览出「[视频]」占位）。 */
    replyIsVideo: boolean = false;
    replyText: string = "";
    digest: string = "";
    revoked: boolean = false;
    /** 服务端确认被编辑过（MessageDto.editTime 非空）⇒ 正文末尾显示「已编辑」。 */
    edited: boolean = false;
    revisionAt: number = 0;
    /** 撤回操作人 userId（管理员撤他人时 senderId≠revokeById，撤回文案判定用）。 */
    revokeById: string = "";
    sendTime: number = 0;
    status: number = 1;
    clientMsgId: string = "";
    local: boolean = false;
    /** 媒体占位行的本地文件路径（发送失败点击重试时重走上传）。 */
    localPath: string = "";
    /** @提及元数据（服务端 MessageDto 原样返回，本地占位行由 scanMentions 反扫得到）。 */
    mentionIds: string[] = [];
    mentionAll: boolean = false;
    /** 富文本渲染模型：正文含 Markdown 标记/提及 token 时才置 true（否则走纯文本路径零回归）。 */
    bodyFormatted: boolean = false;
    lines: ImRichLine[] = [];
    /** 互动卡片（msgType=card）：title 必填，空则不是卡片——回落 digest 系统行兜底。 */
    cardTitle: string = "";
    /** 卡片正文（desc 自足：digest= title+desc，未渲染卡片的端只看得到它）；subtitle 是 deprecated 等价旧名。 */
    cardDesc: string = "";
    cardFields: ImCardField[] = [];
    cardActions: ImCardAction[] = [];
    /** 卡片跳转链接（body.actionUrl）：底部「查看详情」蓝字，点击打开页面（对齐 PC InteractionCard）。 */
    cardActionUrl: string = "";
    /** 表情回复（MessageDto.reactions / WS 3008 全量快照；空数组=无人回复）。 */
    reactions: ImReaction[] = [];
    /** 智能体处理状态明细（拉路径 agentStatusDetail 与 3006 帧单调并入；空=没衔接智能体）。 */
    agentDetail: ImAgentStatusItem[] = [];
    /** 聚合后的智能体标记态：0=无明细（回落已读环）1未读 2处理中(转钟) 3失败 4完成；applyAgentStatusToRow 维护。 */
    agentStatus: number = 0;
    /** 合并转发卡片标题（body.title；空=接收端回落「聊天记录」）。 */
    mergeTitle: string = "";
    /** 合并转发预览条目（body.items 前 2 条渲染，其余收进「共 N 条」；空=非合并转发）。 */
    mergeItems: ImMergePreview[] = [];
    /** 合并转发条目总数（body.items.length；尾行「共 N 条」用它，≠ mergeItems.length）。 */
    mergeTotal: number = 0;
    /** 合并转发全量条目（点卡片拉起聊天记录详情侧栏看全量；气泡只渲染 mergeItems 前 2 条）。 */
    mergeAllItems: ImMergeItem[] = [];
    avatarFailed: boolean = false;
  }

  /** 气泡内容区末行表情组的渲染模型（按 emoji 聚合：emoji + 空格拼接的用户名 + 是否包含我）。 */
  class ImReactionChip {
    emoji: string = "";
    namesText: string = "";
    mine: boolean = false;
  }

  /**
   * 长按弹窗顶部表情快选条默认组（飞书同款一排；与 EMOJIS 全量表共存，展开键弹出
   * 完整网格）。★DEV-318 起快选条第一行 = 我的常用表情（GET /emojis/recent，服务端
   * 序不重排），本组降级为「兜底/补齐」：常用不足一排时依次补齐（跳过已出现），
   * 新用户（常用为空）完整显示本组——避免"刚进来一排空"以为功能坏了（对齐 PC
   * lib/emojiUsage quickEmojis 拍板）。条内出现过的 emoji 会高亮为已选。
   */
  const QUICK_EMOJIS: string[] = ["👍", "❤️", "😂", "😮", "😢", "🙏", "🎉"];

  // ===== 页面入参（由消息列表携带） =====
  const convId = ref<string>("");
  const convType = ref<number>(1);
  /** 群式会话：2=群聊 4=团队（空间会话，enter 进入）——群信息入口/发送者名/@提及按同一套渲染。 */
  const isGroupLike = computed((): boolean => {
    return convType.value == 2 || convType.value == 4;
  });
  const titleName = ref<string>("");
  const peerAvatar = ref<string>("");

  // ===== 子页签行（单聊标题下方：消息/Pin/资料库/文件；群聊后续复用同组件拼装） =====
  function makeSubpageTab(id: string, labelKey: string, icon: string): ChatSubpageTab {
    const tab = new ChatSubpageTab();
    tab.id = id;
    tab.label = t(labelKey);
    tab.icon = icon;
    return tab;
  }

  /** 彩色实心图标（与 PC nuwax-im-web DEV-187 同形状同配色，选中态不变色）。
      资料库页签暂隐藏（功能未上）：恢复时补回 makeSubpageTab("library", "Mobile.Message.chatTabLibrary", ...)。 */
  const subpageTabs = ref<ChatSubpageTab[]>([
    makeSubpageTab("messages", "Mobile.Message.chatTabMessages", "/static/images/icon-tab-messages.png"),
    makeSubpageTab("pin", "Mobile.Message.chatTabPin", "/static/images/icon-tab-pin.png"),
    makeSubpageTab("files", "Mobile.Message.chatTabFiles", "/static/images/icon-tab-files.png"),
  ]);

  // ===== 列表状态 =====
  const messages = ref<ImMsgRow[]>([]);
  // 待发图片暂存条（选图后不立即发，点发送时与文案合并 rich_text / 单图直发 image）
  const stagedImages = ref<StagedImage[]>([]);
  const loading = ref<boolean>(false);
  const loadFailed = ref<boolean>(false);
  const hasMore = ref<boolean>(false);
  const loadingOlder = ref<boolean>(false);
  const scrollAnchor = ref<string>("");
  // 进页定位遮蔽：首屏渲染后 scroll-into-view 跳底（含 150ms 稳定重定位）期间消息行
  // opacity:0 遮蔽（布局保留，锚点照常计算），定位稳定后揭幕——用户看到的第一帧
  // 就已在底部，消除「顶部→底部」跳变与二次跳变的可见闪动（飞书式进页观感）。
  // loading/失败/空态在 v-for 外不受遮蔽；后续 scrollToBottom（发消息/WS/键盘）时
  // listSettled 已为 true，行为与之前完全一致。
  const listSettled = ref<boolean>(false);
  let entryFollowLatest = true;

  // ===== 滑动吞击守卫 =====
  // Android 上滑动手势的 touchup 可能被判定为 click：快速滑动消息列表后手指落在
  // 底部工具键上会误拉表情/加号面板等。页面级记录触摸位移，超阈值时短暂置吞击标志，
  // 面板入口的 click 处理器首行用 pageTapSwallowed() 拦截（50ms 后自动失效，不影响后续正常点击）。
  let pageTouchStartX = 0;
  let pageTouchStartY = 0;
  let pageTouchSwallowed = false;
  let pageTouchResetTimer = 0;

  // ===== 长按吞击守卫 =====
  // 长按定时器触发（面板已拉起）后手指抬起，touchend 之后仍会派生一次 click：
  // 不拦的话图片消息会在面板弹出的同时又被 previewImage 全屏预览。此标志在长按
  // 真正触发时置位、下一次 touchstart（新手势）复位；★勿在 touchend 复位——
  // click 在 touchend 之后才派生，先复位就拦不住了。
  let rowPressFired = false;

  function handlePageTouchStart(eventValue: Any): void {
    entryFollowLatest = false;
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    pageTouchStartX = e.touches[0].clientX;
    pageTouchStartY = e.touches[0].clientY;
  }

  function handlePageTouchEnd(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    if (e.changedTouches == null || e.changedTouches.length == 0) {
      return;
    }
    const t = e.changedTouches[0];
    const dx = t.clientX - pageTouchStartX;
    const dy = t.clientY - pageTouchStartY;
    if (Math.abs(dx) <= 10 && Math.abs(dy) <= 10) {
      return;
    }
    pageTouchSwallowed = true;
    if (pageTouchResetTimer != 0) {
      clearTimeout(pageTouchResetTimer);
    }
    pageTouchResetTimer = setTimeout(() => {
      pageTouchResetTimer = 0;
      pageTouchSwallowed = false;
    }, 50);
  }

  /** 面板/工具键 click 入口守卫：true=本次 click 由滑动 touchup 派生，应吞掉。 */
  function pageTapSwallowed(): boolean {
    return pageTouchSwallowed;
  }

  // ===== 「定位到聊天位置」高亮（引用详情页跳回后背景快速切换） =====
  const highlightId = ref<string>("");
  let pendingJumpId = "";
  let pageVisible = false;
  let pageDisposed = false;
  const pageSessionStamp = getImSessionStamp();
  function isChatCurrent(): boolean {
    return !pageDisposed && pageSessionStamp == getImSessionStamp();
  }
  const deferredMediaIds = new Set<string>();
  let settleTimer = 0;
  let settleVersion = 0;
  let deferredAnchor = "";
  let cancelPrependAnchor: (() => void) | null = null;
  function releasePrependAnchor(): void {
    const cancel = cancelPrependAnchor;
    cancelPrependAnchor = null;
    if (cancel != null) cancel();
  }

  function isChatActive(): boolean {
    return isChatCurrent() && pageVisible && !isAppInBackground();
  }

  // ===== 当前用户（区分我方/对方消息） =====
  const myUserId = ref<string>("");
  const myDisplayName = ref<string>("");
  const myAvatar = ref<string>("");
  const myAvatarFailed = ref<boolean>(false);

  // ===== 输入坞 =====
  const inputText = ref<string>("");
  /** 输入方式（true=语音条）：App 三端按会话独立记忆——onLoad 拿到 convId 后读缓存覆写
   *  （渲染发生在 onLoad 后，无闪切；未记录过的会话默认语音）；其余端恒键盘。 */
  const voiceMode = ref<boolean>(false);

  /** 会话级输入方式缓存键：每个会话各自记忆语音/键盘，互不影响。 */
  function inputMethodKey(): string {
    return `${IM_CHAT_INPUT_METHOD}_${convId.value}`;
  }
  /** 面板态（飞书式）：“”=无 / "emoji"=表情 / "plus"=加号（两者与键盘互斥）；
   *  "font"=格式横条（B/I/S/U + 列表）——与系统键盘【共存】，Aa 键即聚焦拉键盘。 */
  const panelMode = ref<string>("");
  /** 输入框当前聚焦态（@focus/@blur 维护，Aa 键在未聚焦时主动拉起键盘；横条 icon 键盘态不动）。 */
  const inputFocused = ref<boolean>(false);
  /** textarea focus 属性驱动：false→true 变化触发聚焦（blur 后复位，可重复触发）。 */
  const focusRequest = ref<boolean>(false);
  /** @ 成员选择页选完待聚焦：事件先于 navigateBack 到达（本页仍隐藏），延迟到 onShow 后拉键盘。 */
  let pendingFocusAfterAtPick = false;
  /** 格式横条样式态（B/I/S/U 点击切背景，不插标记）：激活的样式在发送时按行包装正文，
   *  气泡按 Markdown 渲染出对应效果（textarea 控件无法在输入过程实时显示富文本样式）。 */
  const markBold = ref<boolean>(false);
  const markItalic = ref<boolean>(false);
  const markStrike = ref<boolean>(false);
  const markUnderline = ref<boolean>(false);
  /** 格式横条列表态（互斥）：""=无 / "ol"=有序 / "ul"=无序——与输入末行的列表前缀同步。 */
  const listKind = ref<string>("");
  // 底部安全区（home indicator）：iOS 初始化阶段可能取不到 safeAreaInsets
  // （同 getStatusBarHeight 的坑），onReady 再刷新一次
  const safeBottomPx = ref<number>(getSafeAreaBottom());
  /**
   * 系统键盘高度 px（App 三端/小程序监听；H5 不支持该 API 恒 0，浏览器自理）。
   * 配合 textarea adjust-position=false：让位由 .chat-main 刚体平移（liftPx）承担，
   * dock 不再垫高——列表视口尺寸不变，在底部天然贴底、看历史天然保位（微信/飞书式）。
   */
  const keyboardHeight = ref<number>(0);
  /** 上次真实键盘高度缓存（NUWAX_KB_LAST_H；iOS/鸿蒙 focus 预测预抬用，Android 不共享，见 applyKeyboardHeight）。 */
  let kbLastHCache = 0;
  /** 预测看门狗定时器（0=无）：iOS/鸿蒙 focus 预抬后 500ms 无真值回调则回落 0。 */
  let kbWatchdogTimer = 0;
  /** 看门狗标记：预抬后是否已有真值落地（任何 applyKeyboardHeight 均置 true）。 */
  let kbPredictConfirmed = false;
  /** onKeyboardHeightChange 监听 id（onLoad 注册、onUnload 按注销，防误伤全局其他监听）。 */
  let chatKeyboardListenerId = 0;

  function clearKbWatchdog(): void {
    if (kbWatchdogTimer != 0) {
      clearTimeout(kbWatchdogTimer);
      kbWatchdogTimer = 0;
    }
    kbPredictConfirmed = true;
  }

  /** iOS 键盘事件去抖定时器（0=无）：收敛升起/收起沿的多次派发到终值一次落地。 */
  let iosKbDebounceTimer = 0;

  function cancelIosKbDebounce(): void {
    if (iosKbDebounceTimer != 0) {
      clearTimeout(iosKbDebounceTimer);
      iosKbDebounceTimer = 0;
    }
  }

  /** iOS 较矮中间值的缓落地定时器（0=无）：见 scheduleIosKbApply 两段派发注释。 */
  let iosKbShortHoldTimer = 0;

  function cancelIosKbShortHold(): void {
    if (iosKbShortHoldTimer != 0) {
      clearTimeout(iosKbShortHoldTimer);
      iosKbShortHoldTimer = 0;
    }
  }

  /** rpx→px（message.uvue 同款换算；uni.rpx2px 仓库零使用不引入）；windowWidth 取一次缓存。 */
  let chatWindowWidthPx = 0;
  function chatRpx2px(rpx: number): number {
    if (chatWindowWidthPx <= 0) {
      chatWindowWidthPx = uni.getWindowInfo().windowWidth;
    }
    return (rpx * chatWindowWidthPx) / 750;
  }

  /** 表情卡片边框盒高 rpx（构成见 .chat-panel 样式注释）。 */
  const EMOJI_CARD_RPX = 448;
  /** 表情槽内容高 rpx：卡片 448 + 下间距 6px 的 rpx 等值与取整余量。 */
  const EMOJI_SLOT_CONTENT_RPX = EMOJI_CARD_RPX + 12;
  /** 加号槽内容高 rpx：面板/网格内边距 + 磁贴行（icon112+文14+上下内距）；改动磁贴需同步此值。 */
  const PLUS_SLOT_CONTENT_RPX = 240;
  /** 表情/加号槽总高 px：内容高 + 底部安全区（槽 paddingBottom 让开 home indicator）。 */
  const emojiSlotPx = computed<number>((): number => chatRpx2px(EMOJI_SLOT_CONTENT_RPX) + safeBottomPx.value);
  const plusSlotPx = computed<number>((): number => chatRpx2px(PLUS_SLOT_CONTENT_RPX) + safeBottomPx.value);
  /** 表情槽展开高 px（折叠动画目标值）：卡片 448rpx + 下间距 6 + 安全区；收起=0。 */
  const emojiSlotOpenPx = computed<number>((): number => chatRpx2px(EMOJI_CARD_RPX) + 6 + safeBottomPx.value);

  /**
   * 底部输入 pill 是否随内容自动增高。Android 上 auto-height 会让原生 EditText
   * 自身测高（实测 352px）远超固定 88rpx 输入坞可视区（141px），文字/光标被画进
   * 裁剪区域——表现为"能打字能发送但看不见内容"（Mate60P+/HarmonyOS 4.x 实测，
   * iOS/H5/展开大输入区均正常）。Android 关闭 auto-height 改固定高度+框内滚动。
   * 鸿蒙真机同病（2026-09-29 实测：auto-height 下 pill 下半被第二行工具栏遮住），
   * 与 Android 共用固定高度方案（.chat-input-box / .chat-input 的平台块）。
   */
  // #ifdef APP-ANDROID || APP-HARMONY
  const chatInputAutoHeight = false;
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  const chatInputAutoHeight = true;
  // #endif

  /** 估算行数（全平台共用：展开键贴行判断 + Android/鸿蒙高度同步兜底）：
   *  逐 \n 段加权宽折行，CJK 全宽 32rpx / 其余半宽 16rpx。
   *  单行可用宽 616rpx = 750 − 坞 16×2 − 框右 10 − 展开键 56 − 框左 28/右 8。 */
  function estimateChatInputLines(text: string): number {
    if (text.length == 0) {
      return 1;
    }
    const contentWidthRpx = 616;
    const segments = text.split("\n");
    let lines = 0;
    for (let sIdx = 0; sIdx < segments.length; sIdx++) {
      const seg = segments[sIdx];
      let widthRpx = 0;
      for (let cIdx = 0; cIdx < seg.length; cIdx++) {
        // UTS charCodeAt 返回 number|null（越界为 null）：先落局部判空再比较，
        // 否则 Kotlin 报「Operator call is prohibited on a nullable receiver」
        const codeRaw = seg.charCodeAt(cIdx);
        if (codeRaw != null && codeRaw > 0x2e80) {
          widthRpx += 32;
        } else {
          widthRpx += 16;
        }
      }
      lines += Math.max(1, Math.ceil(widthRpx / contentWidthRpx));
    }
    return lines;
  }

  /** 是否多行：展开键「贴输入框右上角」与「单行垂直居中」的切换依据（三端一致）。 */
  const chatInputMultiLine = computed(
    (): boolean => estimateChatInputLines(inputText.value) > 1,
  );

  /**
   * Android/鸿蒙固定高度方案下的输入框高度自适应（替代被禁用的 auto-height）：
   * 按内容行数以 JS 驱动 textarea/box 高度。Android 走原生 AppCompatEditText
   * .getLineCount() 精确取行（与 centerAndroidInputGravity 同款取视图）；
   * 鸿蒙无 getAndroidView 类 API，用上方估算折行。行高 50rpx、单行盒 72rpx
   * （= 固定方案 CSS 基线）、盒上下合 16rpx（box 88 − textarea 72），上限 4 行
   * （对齐 CSS max-height 220rpx，封顶后框内滚动）。
   * Android 另有「贴内容」微调：聚焦/键盘开合链路框架会把 gravity 异步重置回 top
   * （真机 3-5px 上跳，sweep 只能事后纠正、瞬态可见）；盒高收到与内容等高后
   * top 与 CENTER_VERTICAL 同位，重置不可见——单行内容高由原生实测、px 直写
   * （见 applyAndroidInputFitHeight），box 阶梯（88/138/188/238）不变、居中交给
   * .chat-input-box 的 align-items:center。
   */
  // #ifdef APP-ANDROID || APP-HARMONY
  const CHAT_INPUT_LINE_RPX = 50;
  const CHAT_INPUT_BASE_RPX = 22;
  const CHAT_INPUT_PAD_RPX = 16;
  const CHAT_INPUT_MAX_LINES = 4;
  /** Android 单行内容真实高（css px，0=未量得走 rpx 老基线）：由
   *  applyAndroidInputFitHeight 用原生 Layout.getHeight()+上下 padding 实测，
   *  贴内容根除聚焦 placeholder 上跳（slack≈0 → top/center 同位），px 直写
   *  免 rpx 往返取整残差。 */
  // #ifdef APP-ANDROID
  const androidInputFitCss = ref<number>(0);
  // #endif
  /** 当前输入行数（1 起步；模板 :style 消费）。 */
  const chatInputLines = ref<number>(1);
  const chatInputHeightStyle = computed(
    (): string => {
      // #ifdef APP-ANDROID
      if (androidInputFitCss.value > 0) {
        // 贴内容：单行 = 实测内容高，多行按 50rpx 行距追加（内容填满盒、gravity 无感）
        const lineCss = chatRpx2px(CHAT_INPUT_LINE_RPX);
        return `height: ${Math.round(androidInputFitCss.value + lineCss * (chatInputLines.value - 1))}px`;
      }
      // #endif
      return `height: ${CHAT_INPUT_LINE_RPX * chatInputLines.value + CHAT_INPUT_BASE_RPX}rpx`;
    },
  );
  const chatInputBoxHeightStyle = computed(
    (): string =>
      `height: ${CHAT_INPUT_LINE_RPX * chatInputLines.value + CHAT_INPUT_BASE_RPX + CHAT_INPUT_PAD_RPX}rpx`,
  );

  /** Android 精确行数：原生 EditText 行数（视图未挂/非 EditText 返回 0 走估算）。 */
  function readAndroidChatInputLineCount(): number {
    // #ifdef APP-ANDROID
    const el = uni.getElementById("chat-input-textarea");
    if (el == null) {
      return 0;
    }
    const host = el.getAndroidView();
    if (host instanceof AppCompatEditText) {
      return (host as AppCompatEditText).getLineCount();
    }
    // #endif
    return 0;
  }

  /** Android 原生垂直滚动条开关：只在钳制态（真实行数超上限、框内滚动）开启；
   *  ≤上限时关闭——换行增高的过渡窗口（内容暂高于旧高度）不再闪原生滚动条。 */
  function setAndroidInputScrollBar(enabled: boolean): void {
    // #ifdef APP-ANDROID
    const el = uni.getElementById("chat-input-textarea");
    if (el == null) {
      return;
    }
    const host = el.getAndroidView();
    if (host instanceof AppCompatEditText) {
      (host as AppCompatEditText).setVerticalScrollBarEnabled(enabled);
    }
    // #endif
  }

  /** 行数回写（钳 1..4）+ 滚动条开关：Android 精确值优先，取不到用估算。 */
  function syncChatInputLines(): void {
    let rawLines = readAndroidChatInputLineCount();
    if (rawLines <= 0) {
      rawLines = estimateChatInputLines(inputText.value);
    }
    // 滚动条按「未钳制前的真实行数」判断：>上限才开（框内滚动需要它）
    setAndroidInputScrollBar(rawLines > CHAT_INPUT_MAX_LINES);
    let lines = rawLines;
    if (lines < 1) {
      lines = 1;
    }
    if (lines > CHAT_INPUT_MAX_LINES) {
      lines = CHAT_INPUT_MAX_LINES;
    }
    chatInputLines.value = lines;
  }

  /** 高度同步去抖定时器（0=无待同步）。 */
  let chatInputSyncTimer = 0;

  // 所有 inputText 写入（键入/草稿恢复/插入@/发送清空）统一驱动；延一拍等原生值
  // 同步与折行布局完成再量（Android getLineCount 才准）
  watch(inputText, (_val: string) => {
    if (chatInputSyncTimer != 0) {
      clearTimeout(chatInputSyncTimer);
    }
    chatInputSyncTimer = setTimeout((): void => {
      chatInputSyncTimer = 0;
      syncChatInputLines();
    }, 50) as number;
  });
  // #endif

  // #ifndef APP-ANDROID || APP-HARMONY
  // iOS/H5 原生 auto-height 生效：box 侧空串占位保证模板 :style 绑定可编译。
  // iOS 行高分态（2026-10-01 真机）：单行 40rpx 是垂直居中 hack（50 会按
  // 「首行上方加 leading」处理：光标下沉、placeholder 按自然行高画，一低一高
  // 错位），但多行内容下 40rpx 行间距贴字（Android 50rpx 正常）——多行切回
  // 50rpx 与 Android 视觉一致；多行时无 placeholder，首行微沉无副作用。
  // 多行同时补上下内边距：shrink 盒纵向 padding 为 0（单行居中需要），
  // 多行时文字会贴 pill 上下缘（10rpx ≈ Android 盒侧 8+textarea 4 的视觉）。
  // H5 公共块本就 50rpx + 上下 10rpx，此覆盖无变化。
  const chatInputHeightStyle = computed(
    (): string =>
      chatInputMultiLine.value
        ? "line-height: 50rpx; padding-top: 10rpx; padding-bottom: 10rpx"
        : "",
  );
  const chatInputBoxHeightStyle = "";
  // #endif

  /**
   * 表情面板是否常驻预渲染（键盘↔面板切换时内容即时就绪，避免重渲闪烁）。
   * 鸿蒙上 absolute 槽位随平移显隐此前由 height 折叠承担时失效（漏表情，
   * 2026-09-29 真机实测），保守起见仍走 v-if 按需渲染（直出直收，正确性优先）。
   */
  // #ifdef APP-HARMONY
  const emojiPanelAlwaysRender = false;
  // #endif
  // #ifndef APP-HARMONY
  const emojiPanelAlwaysRender = true;
  // #endif

  // ===== 展开输入面板（⤢ 从底部拉起）=====
  const expanded = ref<boolean>(false);
  /** 展开面板内嵌面板（与键盘互斥）：“”=无 / "emoji"=表情网格 / "font"=格式行。 */
  const expandPanel = ref<string>("");
  /** 展开面板 textarea focus 驱动（false→true 变化触发聚焦，收起复位可重复触发）。 */
  const expandFocusRequest = ref<boolean>(false);
  /** 展开面板底部让位：键盘弹起=贴键盘正上方；平时=底部安全区（机制与主体 liftPx 独立，本面板自有 padding 让位）。 */
  const expandBottomPx = computed<number>(
    (): number => (keyboardHeight.value > 0 ? keyboardHeight.value : safeBottomPx.value),
  );
  /** 面板下滑收起手势：跟手下移位移 px（上移钳 0，松手超阈值收面板、不足弹回）。 */
  const sheetDragPx = ref<number>(0);
  /** 拖拽进行中：transform 不带过渡跟手即时，松手后由 snap 过渡弹回。 */
  const sheetDragging = ref<boolean>(false);
  let sheetStartY = 0;

  // ===== @提及（提及高亮 / 发送反扫的数据源；选择交互已独立成 at-select 页）=====
  const members = ref<ImMember[]>([]);
  let membersLoaded = false;

  /** 已上报的已读水位（单调递增，避免重复上报）。 */
  let reportedReadSeq: number = 0;

  // 有文案或有暂存图即可发（图文合并发送后，纯图也能点亮发送键）
  const canSend = computed((): boolean => inputText.value.trim().length > 0 || stagedImages.value.length > 0);

  // ===== 会话能力（长按菜单显隐 / 已读 icon 门控；权限权威永远在服务端，这里只做入口 UX） =====
  /** 我的角色：1=普通成员 2=管理员 3=群主（convDetail.myRole；管理权限 = >=2）。 */
  const myRole = ref<number>(1);
  /** 群已解散（convDetail.status=2）：输入区折叠为「该群已解散」，禁发消息（权威校验在服务端 IM_20105）。 */
  const convDisbanded = ref<boolean>(false);
  /** 群设置：允许普通成员置顶消息（缺省 true；群主/管理员不受限，p2p 无此约束）。 */
  let allowMemberPin = true;
  /** 群设置：已读回执开关（关闭 ⇒ 我发的消息不渲染已读 icon；单聊无此开关恒显示）。 */
  let readReceiptOn = true;
  /** 撤回时限秒数（whoami.revokeWindowSec 下发，缺省 24h）。 */
  let revokeWindowSec = 86400;
  /** 置顶信息（MessagePinDto：msgId + pinBy 置顶操作人，≤10；「置顶/取消置顶」文案切换、撤回联动刷新与署名行用）。 */
  class ImPinInfo {
    msgId: string = "";
    pinBy: string = "";
  }
  const pinnedPins = ref<ImPinInfo[]>([]);

  // ===== 长按消息操作弹窗 =====
  /** 当前操作目标，弹窗关闭后清空。 */
  const selectedId = ref<string>("");
  /** 弹窗动作列表（buildActionsFor 按消息状态/角色算好传入）。 */
  const sheetActions = ref<MsgActionItem[]>([]);
  const actionSheetRef = ref<any | null>(null);
  /** 选择复制弹层（长按面板「选择复制」动作）：正文剥标记后的纯文本 + 弹层实例。 */
  const selectCopyRef = ref<any | null>(null);
  const selectCopyText = ref<string>("");
  // 表情快选条数据（sheetQuickEmojis computed 定义在「表情回复 + 多选转发」
  // 块：依赖 canReactMsg，UTS→Kotlin 须先定义后引用）

  // ===== 删除消息二次确认（confirm-modal 全页一个实例；打开时记 pendingDeleteMsg，
  //       确认回调取它执行——同 message.uvue 确认弹窗模式） =====
  const confirmModalRef = ref<any | null>(null);
  /** 待删除消息（null=确认弹窗未挂着任何操作）。 */
  let pendingDeleteMsg: ImMsgRow | null = null;

  // ===== 引用 / 编辑（输入坞上方的 compose 条，两者互斥） =====
  /** 引用目标（占位行乐观渲染引用块用；发送成功后消费清除）。 */
  class QuoteTargetInfo {
    msgId: string = "";
    senderName: string = "";
    preview: string = "";
    isImage: boolean = false;
  }
  const quoteTarget = ref<QuoteTargetInfo | null>(null);
  /** 引用态自动带入的 @提及快照：取消引用且用户未再输入时回退输入框，防孤儿提及文本。 */
  let quoteMentionBefore = "";
  let quoteMentionAfter = "";

  function resetQuoteMentionSnapshot(): void {
    quoteMentionBefore = "";
    quoteMentionAfter = "";
  }
  /** 编辑目标（正文回填输入框，发送键变更为「保存」语义）。 */
  class EditTargetInfo {
    msgId: string = "";
    originText: string = "";
  }
  const editTarget = ref<EditTargetInfo | null>(null);
  const composePreviewText = computed((): string => {
    const editing = editTarget.value;
    if (editing != null) {
      return editing.originText;
    }
    const quoting = quoteTarget.value;
    if (quoting != null) {
      return quoting.preview;
    }
    return "";
  });
  /** 引用条整行文案：「回复 xx：引用内容」（前缀/冒号走 i18n，整行同色同字号）。 */
  const replyPreviewText = computed((): string => {
    const quoting = quoteTarget.value;
    if (quoting == null) {
      return "";
    }
    return t("Mobile.Message.replyBarPrefix") + quoting.senderName + t("Mobile.Message.replyBarSep") + quoting.preview;
  });

  // ===== 已读状态（我发的消息：群=计数圆点可点，单聊=已读圆点不可点） =====
  class ImReadInfo {
    msgId: string = "";
    readCount: number = 0;
    eligibleCount: number = 0;
    readAll: boolean = false;
  }
  const readInfos = ref<ImReadInfo[]>([]);
  /**
   * 已读数据「版本号」。★App-Android 的模板绑定不穿透方法体收集依赖：模板里
   * readInfoOf(msg) 这类方法调用绑定，重算时机只看表达式直接读到的响应式数据，
   * 方法内部读 readInfos 不算数——数据已更新、icon 停旧值（2026-09-29 Android 群
   * 已读不实时实锤，push/splice 均不触发；web 端 Vue3 深代理无此问题）。修法：
   * 绑定表达式把本 ref 作尾参显式传入（模板自动解包读值 → 建立依赖），
   * readInfos 每次变更后 bump 一次，触发全部已读绑定重算。
   */
  const readInfoTick = ref<number>(0);
  /** readInfos 变更统一收口：bump 版本号（见 readInfoTick 注释）。 */
  function bumpReadInfoTick(): void {
    readInfoTick.value = readInfoTick.value + 1;
  }
  /** 已读计数请求序号（旧响应晚归丢弃，防竞态覆盖新数据）。 */
  let readStatusSeq = 0;

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  /** URL 入参读取（列表页 encodeURIComponent 写入，这里容错解码）。 */
  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  /** 我方判定：本地占位恒为我方；服务端消息按 senderId 与当前用户比对。 */
  function isMine(msg: ImMsgRow): boolean {
    if (msg.local) {
      return true;
    }
    return myUserId.value.length > 0 && msg.senderId == myUserId.value;
  }

  function sysText(msg: ImMsgRow): string {
    if (msg.revoked) {
      // 管理员撤他人消息：senderId 不是我但 revokeById 是我 ⇒ 也算「你撤回了一条消息」
      const revokedByMe = isMine(msg) || (myUserId.value.length > 0 && msg.revokeById == myUserId.value);
      return revokedByMe ? t("Mobile.Message.msgRevokedByMe") : t("Mobile.Message.msgRevokedByPeer");
    }
    return msg.digest;
  }

  /** 消息当前置顶信息（命中返回 ImPinInfo，未置顶返回 null）。 */
  function pinInfoOf(msg: ImMsgRow): ImPinInfo | null {
    const pins = pinnedPins.value;
    for (let i = 0; i < pins.length; i++) {
      if (pins[i].msgId == msg.msgId) {
        return pins[i];
      }
    }
    return null;
  }

  function isPinnedMsg(msg: ImMsgRow): boolean {
    return pinInfoOf(msg) != null;
  }

  /**
   * pin 操作人署名：成员表 → 我 → p2p 对方 → 兜底「有人」。
   * ★仅模板调用（读 members/pinnedPins，成员表晚到时自动重渲染补正署名）。
   */
  function pinNameOf(pin: ImPinInfo): string {
    const by = pin.pinBy;
    if (by.length > 0) {
      if (myUserId.value.length > 0 && by == myUserId.value) {
        const mine = myDisplayName.value;
        if (mine.length > 0) {
          return mine;
        }
      }
      const ms = members.value;
      for (let i = 0; i < ms.length; i++) {
        if (ms[i].userId == by) {
          const nick = ms[i].nickName;
          if (nick.length > 0) {
            return nick;
          }
          if (ms[i].name.length > 0) {
            return ms[i].name;
          }
        }
      }
      if (isGroupLike.value != true && myUserId.value.length > 0 && by != myUserId.value) {
        const peer = titleName.value;
        if (peer.length > 0 && peer != t("Mobile.Common.conversations")) {
          return peer;
        }
      }
    }
    return t("Mobile.Message.pinnedByFallback");
  }

  /** Pin 署名行文案：群=「…对所有群成员可见」，p2p=短版。 */
  function pinInfoTextOf(msg: ImMsgRow): string {
    const pin = pinInfoOf(msg);
    if (pin == null) {
      return "";
    }
    const params = new Map<string, string | number>();
    params.set("name", pinNameOf(pin));
    const key = isGroupLike.value ? "Mobile.Message.msgPinnedByGroup" : "Mobile.Message.msgPinnedByP2p";
    return translateFn(key, toI18nParams(params), "");
  }

  /**
   * 消息外层 class：定位高亮（引用详情跳回）优先。
   * 被 pin 的淡黄底在行节点上（见 rowCls / chat-row--pinned）。
   * ★仅模板调用（模板绑定不受 UTS「先定义后使用」约束）。
   */
  function msgRowClass(msg: ImMsgRow): string {
    let cls = "";
    if (highlightId.value == msg.msgId) {
      cls = "chat-msg--flash";
    }
    // 进页定位遮蔽期：叠加 veiled（仅视觉隐藏，布局参与 scroll-into-view 定位）
    if (listSettled.value != true) {
      cls = cls.length > 0 ? `${cls} chat-msg--veiled` : "chat-msg--veiled";
    }
    return cls;
  }

  /**
   * 消息行节点 class：我方行翻转主轴 + 被 pin 的消息行铺淡黄底（全员可见标识）。
   * ★淡黄底挂行本体（chat-row）而非外层 chat-msg——外层会把 chat-row 的
   * margin-bottom（36rpx 行距空白）一起铺底，黄块比行内容高一截；行本体
   * 染色严格贴 [头像][气泡列] 内容。
   * ★仅模板调用（模板绑定不受 UTS「先定义后使用」约束）。
   */
  function rowCls(msg: ImMsgRow): string {
    let cls = isMine(msg) ? "chat-row--mine" : "";
    if (pinInfoOf(msg) != null) {
      cls = cls.length > 0 ? `${cls} chat-row--pinned` : "chat-row--pinned";
    }
    return cls;
  }

  /** URL 是否指向图片（按扩展名兜底，mime 缺失时用）。 */
  function isImageUrl(url: string): boolean {
    const lower = url.toLowerCase();
    return (
      lower.indexOf(".png") > 0 ||
      lower.indexOf(".jpg") > 0 ||
      lower.indexOf(".jpeg") > 0 ||
      lower.indexOf(".gif") > 0 ||
      lower.indexOf(".webp") > 0 ||
      lower.indexOf(".bmp") > 0
    );
  }

  /** 附件是图片：mime 以 image/ 开头，或 URL 是图片扩展名（与引用详情页同规则）。 */
  function isImageAtt(att: ImMsgAtt): boolean {
    if (att.mime.indexOf("image/") == 0) {
      return true;
    }
    return att.url.length > 0 && isImageUrl(att.url);
  }

  /** 附件是 markdown 文档：URL 以 .md/.markdown 结尾（去 query/hash、忽略大小写）或 mime 为 text/markdown。 */
  function isMarkdownAtt(att: ImMsgAtt): boolean {
    if (att.mime.toLowerCase() == "text/markdown") {
      return true;
    }
    const url = att.url;
    if (url.length == 0) {
      return false;
    }
    let path = url;
    const hashAt = path.indexOf("#");
    if (hashAt >= 0) {
      path = path.substring(0, hashAt);
    }
    const queryAt = path.indexOf("?");
    if (queryAt >= 0) {
      path = path.substring(0, queryAt);
    }
    const lower = path.toLowerCase();
    return lower.endsWith(".md") || lower.endsWith(".markdown");
  }

  /** md 卡片标题：优先附件 fileName；否则取 URL basename（去 query/hash，比整串裸链友好）。 */
  function mdAttTitle(att: ImMsgAtt): string {
    if (att.fileName.length > 0) {
      return att.fileName;
    }
    let path = att.url;
    const hashAt = path.indexOf("#");
    if (hashAt >= 0) {
      path = path.substring(0, hashAt);
    }
    const queryAt = path.indexOf("?");
    if (queryAt >= 0) {
      path = path.substring(0, queryAt);
    }
    const slashAt = path.lastIndexOf("/");
    const name = slashAt >= 0 ? path.substring(slashAt + 1) : path;
    return name.length > 0 ? name : att.url;
  }

  /** 提取链接的域名（无协议时原样截到首个 / 前止）。 */
  function hostOf(url: string): string {
    const marker = "://";
    const at = url.indexOf(marker);
    let rest = at >= 0 ? url.substring(at + marker.length) : url;
    const slash = rest.indexOf("/");
    if (slash >= 0) {
      rest = rest.substring(0, slash);
    }
    return rest;
  }

  /** 纯链接文本消息（整条就是一个 URL、无空格）：按微信同款蓝色链接字渲染。 */
  function isUrlMsg(msg: ImMsgRow): boolean {
    if (msg.msgType != "text") {
      return false;
    }
    const text = msg.bodyText.trim();
    return (
      (text.indexOf("http://") == 0 || text.indexOf("https://") == 0) &&
      text.indexOf(" ") < 0
    );
  }

  /** 引用块预览文案：撤回 > 图片 > 语音 > 视频 > 正文，兜底按文件（微信同款）。 */
  function quotePreview(msg: ImMsgRow): string {
    if (msg.replyRevoked) {
      return t("Mobile.Message.quoteRevoked");
    }
    if (msg.replyIsImage) {
      return t("Mobile.Message.quoteImage");
    }
    if (msg.replyIsAudio) {
      return t("Mobile.Message.previewAudio");
    }
    if (msg.replyIsVideo) {
      return t("Mobile.Message.previewVideo");
    }
    if (msg.replyText.length > 0) {
      return msg.replyText;
    }
    return t("Mobile.Message.quoteFile");
  }

  /** 气泡正文样式：我方白字；纯链接消息用链接蓝（我方气泡内用浅一档保对比度）。 */
  function textClassOf(msg: ImMsgRow): string {
    if (isMine(msg)) {
      return isUrlMsg(msg) ? "chat-bubble__text--link-mine" : "chat-bubble__text--mine";
    }
    return isUrlMsg(msg) ? "chat-bubble__text--link" : "";
  }

  // ===== 富文本渲染模型（PC 端 Markdown 存储格式的移动端渲染，嵌套 text 分段） =====

  /** token 是否命中已知成员昵称（提及高亮判定；成员列表未加载则恒 false）。 */
  function isKnownMentionToken(token: string): boolean {
    const all = members.value;
    for (let i = 0; i < all.length; i++) {
      if (all[i].token == token) {
        return true;
      }
    }
    return false;
  }

  function pushSeg(out: ImSeg[], text: string, bold: boolean, italic: boolean, strike: boolean, underline: boolean, code: boolean, mention: boolean): void {
    if (text.length == 0) {
      return;
    }
    const seg = new ImSeg();
    seg.text = text;
    seg.bold = bold;
    seg.italic = italic;
    seg.strike = strike;
    seg.underline = underline;
    seg.code = code;
    seg.mention = mention;
    out.push(seg);
  }

  /**
   * 行内 Markdown 标记解析（**粗** / *斜* / ~~删~~ / `码` / <u>下划</u>）。
   * 取最早出现且能闭合的标记对，前缀按当前样式入列、内部递归（可嵌套）、余下续扫；
   * 找不到完整标记对时整段按当前样式入列——与纯文本渲染结果一致，无副作用。
   */
  function parseInline(text: string, bold: boolean, italic: boolean, strike: boolean, underline: boolean, code: boolean, out: ImSeg[]): void {
    if (text.length == 0) {
      return;
    }
    // 各标记 [open, close]，同位置时长标记（**）优先
    const opens: string[] = ["**", "*", "~~", "`", "<u>"];
    const closes: string[] = ["**", "*", "~~", "`", "</u>"];
    let bestAt = -1;
    let bestIdx = -1;
    for (let i = 0; i < opens.length; i++) {
      const at = text.indexOf(opens[i]);
      if (at >= 0 && (bestAt < 0 || at < bestAt)) {
        bestAt = at;
        bestIdx = i;
      } else if (at >= 0 && at == bestAt && opens[i].length > opens[bestIdx].length) {
        // 同一起始位置：** 应压过 *（indexOf("*") ≤ indexOf("**")，补这一支防漏）
        bestIdx = i;
      }
    }
    if (bestIdx < 0) {
      pushSeg(out, text, bold, italic, strike, underline, code, false);
      return;
    }
    const open = opens[bestIdx];
    const close = closes[bestIdx];
    const innerAt = text.indexOf(close, bestAt + open.length);
    if (innerAt < 0 || innerAt == bestAt + open.length) {
      // 无闭合或空内容：这个 open 当普通字符——前缀连同 open 一次入列，从 open 右侧续扫
      // ★不能递归 substring(0, bestAt+open.length)：那段仍以 open 结尾，会再次命中同一 open 无限递归
      pushSeg(out, text.substring(0, bestAt + open.length), bold, italic, strike, underline, code, false);
      parseInline(text.substring(bestAt + open.length), bold, italic, strike, underline, code, out);
      return;
    }
    const inner = text.substring(bestAt + open.length, innerAt);
    parseInline(text.substring(0, bestAt), bold, italic, strike, underline, code, out);
    // 标记索引：0=** 粗 1=* 斜 2=~~ 删 3=` 行内码 4=<u> 下划（与 opens 数组一一对应）
    parseInline(inner, bold || bestIdx == 0, italic || bestIdx == 1, strike || bestIdx == 2, underline || bestIdx == 4, code || bestIdx == 3, out);
    parseInline(text.substring(innerAt + close.length), bold, italic, strike, underline, code, out);
  }

  /**
   * [标题](url) 链接拆分：命中整段按链接渲染（text=标题、url=地址，段内不再解析标记/提及）；
   * 接受非空标题 + http(s):// 完整地址或站内相对路径（"/"开头），未闭合/不合法的 "[" 按普通字符从其后续扫。
   */
  function splitLinkSegs(text: string): ImSeg[] {
    const out: ImSeg[] = [];
    let plainStart = 0;
    let i = 0;
    while (i < text.length) {
      const openAt = text.indexOf("[", i);
      if (openAt < 0) {
        break;
      }
      const closeAt = text.indexOf("]", openAt + 1);
      if (closeAt < 0 || closeAt == openAt + 1) {
        i = openAt + 1;
        continue;
      }
      if (closeAt + 1 >= text.length || text.charAt(closeAt + 1) != "(") {
        i = openAt + 1;
        continue;
      }
      const urlEnd = text.indexOf(")", closeAt + 2);
      if (urlEnd < 0) {
        i = openAt + 1;
        continue;
      }
      const url = text.substring(closeAt + 2, urlEnd);
      // http(s) 完整地址，或站内相对路径（"/"开头且非协议相对 "//"）——系统通知
      // 下发 /home/... 相对链接；点击时 handleSegTap 再用 getApiBaseUrl 补全域名
      const isHttp = url.indexOf("http://") == 0 || url.indexOf("https://") == 0;
      const isSiteRelative = url.indexOf("/") == 0 && url.indexOf("//") != 0;
      if (url.length == 0 || (!isHttp && !isSiteRelative)) {
        i = openAt + 1;
        continue;
      }
      pushSeg(out, text.substring(plainStart, openAt), false, false, false, false, false, false);
      const linkSeg = new ImSeg();
      linkSeg.text = text.substring(openAt + 1, closeAt);
      linkSeg.link = true;
      linkSeg.url = url;
      out.push(linkSeg);
      i = urlEnd + 1;
      plainStart = i;
    }
    pushSeg(out, text.substring(plainStart), false, false, false, false, false, false);
    return out;
  }

  /** 裸链接字符口径：ASCII 可见字符，排除空白/引号/尖括号/反引号/花括号/竖线/反斜杠/脱字符，>0x7f（CJK/emoji）截断。 */
  function isBareUrlChar(code: number | null): boolean {
    if (code == null || code <= 0x20 || code >= 0x7f) {
      return false;
    }
    if (code == 0x22 || code == 0x3c || code == 0x60 || code == 0x7b ||
        code == 0x7d || code == 0x7c || code == 0x5c || code == 0x5e) {
      return false;
    }
    return true;
  }

  /** 常见 HTML 实体还原（后端 body 里的 URL 常被转义成 &amp; 等，直接打开会 403/404）。 */
  function unescapeHtmlEntities(s: string): string {
    if (s.indexOf("&") < 0) {
      return s;
    }
    let out = s.split("&amp;").join("&");
    out = out.split("&lt;").join("<");
    out = out.split("&gt;").join(">");
    out = out.split("&quot;").join("\"");
    out = out.split("&#39;").join("'");
    return out;
  }

  /**
   * 裸超链接拆分：正文中无 [标题](url) 包装的 http(s):// 完整地址整段按链接渲染
   * （text=url=还原实体后的地址）。从协议头起吃 URL 字符，遇空白/CJK/引尖括号截断；
   * 末尾孤立标点（.,;:!?)]}'"）回退给正文；协议头后无主机字符不算链接。
   */
  function splitBareUrls(text: string): ImSeg[] {
    const out: ImSeg[] = [];
    let plainStart = 0;
    let i = 0;
    while (i < text.length) {
      const httpAt = text.indexOf("http://", i);
      const httpsAt = text.indexOf("https://", i);
      let start = -1;
      if (httpAt >= 0 && (httpsAt < 0 || httpAt <= httpsAt)) {
        start = httpAt;
      } else if (httpsAt >= 0) {
        start = httpsAt;
      }
      if (start < 0) {
        break;
      }
      const protoLen = text.charAt(start + 4) == "s" ? 8 : 7;
      let end = start;
      while (end < text.length) {
        if (!isBareUrlChar(text.charCodeAt(end))) {
          break;
        }
        end++;
      }
      while (end > start + protoLen) {
        const tail = text.charAt(end - 1);
        if (tail == "." || tail == "," || tail == ";" || tail == ":" || tail == "!" ||
            tail == "?" || tail == ")" || tail == "]" || tail == "}" || tail == "'" || tail == "\"") {
          end--;
        } else {
          break;
        }
      }
      if (end <= start + protoLen) {
        i = start + 1;
        continue;
      }
      pushSeg(out, text.substring(plainStart, start), false, false, false, false, false, false);
      const clean = unescapeHtmlEntities(text.substring(start, end));
      const linkSeg = new ImSeg();
      linkSeg.text = clean;
      linkSeg.link = true;
      linkSeg.url = clean;
      out.push(linkSeg);
      i = end;
      plainStart = i;
    }
    pushSeg(out, text.substring(plainStart), false, false, false, false, false, false);
    return out;
  }

  /**
   * 提及拆分 + 行内解析：先扫 "@token"（连续非空白非@字符，≤32，同 PC MENTION_RE 口径），
   * 命中已知成员/@所有人 的整段高亮（段内不再解析标记）；其余段交 parseInline。
   */
  function parseSegsInto(text: string, out: ImSeg[]): void {
    const raw: ImSeg[] = [];
    let i = 0;
    let plainStart = 0;
    while (i < text.length) {
      if (text.charAt(i) != "@") {
        i++;
        continue;
      }
      let j = i + 1;
      while (j < text.length && j - i <= 32) {
        const ch = text.charAt(j);
        if (ch == " " || ch == "@" || ch == "\n" || ch == "\t") {
          break;
        }
        j++;
      }
      const token = text.substring(i + 1, j);
      const hit = token.length > 0 && (token == "所有人" || isKnownMentionToken(token));
      if (hit) {
        pushSeg(raw, text.substring(plainStart, i), false, false, false, false, false, false);
        pushSeg(raw, text.substring(i, j), false, false, false, false, false, true);
        i = j;
        plainStart = i;
      } else {
        i++;
      }
    }
    pushSeg(raw, text.substring(plainStart), false, false, false, false, false, false);
    for (let k = 0; k < raw.length; k++) {
      const seg = raw[k];
      if (seg.mention) {
        out.push(seg);
      } else {
        parseInline(seg.text, false, false, false, false, false, out);
      }
    }
  }

  /** 行内段总入口：先拆 [标题](url) 链接段，再拆裸 http(s) 链接段（整段按链接渲染），
      其余文本走 提及+行内标记 管线。 */
  function parseSegs(text: string): ImSeg[] {
    const out: ImSeg[] = [];
    const chunks = splitLinkSegs(text);
    for (let k = 0; k < chunks.length; k++) {
      const chunk = chunks[k];
      if (chunk.link) {
        out.push(chunk);
        continue;
      }
      const bareChunks = splitBareUrls(chunk.text);
      for (let m = 0; m < bareChunks.length; m++) {
        const bare = bareChunks[m];
        if (bare.link) {
          out.push(bare);
        } else {
          parseSegsInto(bare.text, out);
        }
      }
    }
    return out;
  }

  /** 行首有序列表前缀长度（"N. "，N 为 1~2 位数字；0=无）。渲染与格式横条编辑共用。 */
  function olPrefixLen(line: string): number {
    let i = 0;
    while (i < line.length && i < 3 && line.charAt(i) >= "0" && line.charAt(i) <= "9") {
      i++;
    }
    if (i > 0 && i + 1 < line.length && line.charAt(i) == "." && line.charAt(i + 1) == " ") {
      return i + 2;
    }
    return 0;
  }

  /** 行首无序列表前缀长度（"- "）。 */
  function ulPrefixLen(line: string): number {
    if (line.length >= 2 && line.charAt(0) == "-" && line.charAt(1) == " ") {
      return 2;
    }
    return 0;
  }

  /** 单行解析：# 标题 / > 引用 / - * + 无序列表（蓝色圆点前缀）/ N. 有序列表（蓝色序号前缀）。 */
  function parseLine(raw: string): ImRichLine {
    const line = new ImRichLine();
    const t = raw.trim();
    if (t.length == 0) {
      return line;
    }
    let body = raw;
    if (t.charAt(0) == "#") {
      let level = 0;
      while (level < t.length && t.charAt(level) == "#" && level < 3) {
        level++;
      }
      if (level > 0 && t.length > level && t.charAt(level) == " ") {
        line.kind = `h${level}`;
        body = t.substring(level + 1);
      }
    } else if (t.charAt(0) == ">") {
      line.kind = "quote";
      body = t.substring(1);
      if (body.length > 0 && body.charAt(0) == " ") {
        body = body.substring(1);
      }
      body = body.trim();
    } else if (t.length > 2 && (t.charAt(0) == "-" || t.charAt(0) == "*" || t.charAt(0) == "+") && t.charAt(1) == " ") {
      // 无序列表：kind=ul，行首独立蓝色圆点前缀段（* 转掉避免与斜体标记打架）
      line.kind = "ul";
      line.listMarkText = "· ";
      body = t.substring(2);
    } else if (olPrefixLen(t) > 0 && t.length > olPrefixLen(t)) {
      // 有序列表：kind=ol，行首独立蓝色序号前缀段（保留原文 "N. "）
      line.kind = "ol";
      const cut = olPrefixLen(t);
      line.listMarkText = t.substring(0, cut);
      body = t.substring(cut);
    }
    line.segs = parseSegs(body);
    // 列表行的前缀独立成段（蓝色渲染，不参与行内标记解析）
    if (line.kind == "ul" || line.kind == "ol") {
      const mark = new ImSeg();
      mark.text = line.listMarkText;
      mark.listMark = true;
      line.segs.unshift(mark);
    }
    return line;
  }

  /** 整文 → 行模型：``` 围栏代码块合并为单行 kind=code（text 存多行原文）；空行跳过。 */
  function parseRichLines(text: string): ImRichLine[] {
    const out: ImRichLine[] = [];
    const rawLines = text.split("\n");
    let codeBuf: string[] | null = null;
    for (let i = 0; i < rawLines.length; i++) {
      const raw = rawLines[i];
      const t = raw.trim();
      if (codeBuf != null) {
        if (t.indexOf("```") == 0) {
          const code = new ImRichLine();
          code.kind = "code";
          code.text = codeBuf.join("\n");
          if (code.text.length > 0) {
            out.push(code);
          }
          codeBuf = null;
        } else {
          codeBuf.push(raw);
        }
        continue;
      }
      if (t.indexOf("```") == 0) {
        codeBuf = [];
        continue;
      }
      if (t.length == 0) {
        continue;
      }
      out.push(parseLine(raw));
    }
    if (codeBuf != null) {
      // 未闭合的围栏：按代码块收尾
      const code = new ImRichLine();
      code.kind = "code";
      code.text = codeBuf.join("\n");
      if (code.text.length > 0) {
        out.push(code);
      }
    }
    return out;
  }

  /** 正文是否含富文本特征（无特征不建模型，纯文本路径零回归）。 */
  function richNeeded(text: string): boolean {
    if (
      text.indexOf("**") >= 0 ||
      text.indexOf("*") >= 0 ||
      text.indexOf("~~") >= 0 ||
      text.indexOf("`") >= 0 ||
      text.indexOf("<u>") >= 0 ||
      text.indexOf("```") >= 0 ||
      // markdown 链接 [标题](url)："](" 是其必要特征（命中后 splitLinkSegs 再严格校验）
      text.indexOf("](") >= 0 ||
      // 裸超链接：http(s):// 完整地址（splitBareUrls 再严格校验，AI 回复常直接贴地址）
      text.indexOf("http://") >= 0 ||
      text.indexOf("https://") >= 0
    ) {
      return true;
    }
    // 行首块级标记（#/>/-/*/+）
    const rawLines = text.split("\n");
    for (let i = 0; i < rawLines.length; i++) {
      const t = rawLines[i].trim();
      if (t.length == 0) {
        continue;
      }
      const c0 = t.charAt(0);
      if (c0 == "#" || c0 == ">" || ((c0 == "-" || c0 == "+" || c0 == "*") && t.length > 1 && t.charAt(1) == " ")) {
        return true;
      }
      // 有序列表行首 "N. "（蓝色序号前缀渲染）
      if (olPrefixLen(t) > 0 && t.length > olPrefixLen(t)) {
        return true;
      }
    }
    // 提及 token（群聊=群成员 / 单聊=联系人，与 @面板同数据源）
    if (text.indexOf("@") >= 0 && members.value.length > 0) {
      if (text.indexOf(MENTION_ALL_TOKEN) >= 0) {
        return true;
      }
      const all = members.value;
      for (let i = 0; i < all.length; i++) {
        if (all[i].token.length > 0 && text.indexOf(`@${all[i].token}`) >= 0) {
          return true;
        }
      }
    }
    return false;
  }

  /** 建立行的富文本渲染模型（readMsgRow / 本地占位 / 成员列表到位后重建共用）。 */
  function applyRichToRow(row: ImMsgRow): void {
    row.lines = [];
    row.bodyFormatted = false;
    if (row.bodyText.length == 0 || richNeeded(row.bodyText) != true) {
      return;
    }
    row.lines = parseRichLines(row.bodyText);
    row.bodyFormatted = row.lines.length > 0;
  }

  // ===== 复制用纯文本提取（整段「复制」与「选择复制」弹层共用）=====
  // bodyText 存的是带 Markdown 标记的原文（applyActiveMarks 发送时包装），
  // 复制给用户看/选的应是气泡显示口径的纯文本（微信同款），此处复用渲染管线剥标记。

  /** 行内剥标记：走 parseSegs 同一管线——链接段取标题（裸链接 text 即还原实体后的地址）、
   *  其余段取原文（粗体、斜体、删除线、下划线、行内码的标记字符不出现在段 text 里）。 */
  function plainInlineForCopy(text: string): string {
    if (text.length == 0) {
      return "";
    }
    const segs = parseSegs(text);
    const parts: string[] = [];
    for (let i = 0; i < segs.length; i++) {
      parts.push(segs[i].text);
    }
    return parts.join("");
  }

  /** 单行剥标记：块级前缀判定与 parseLine 一一对应（# 标题/> 引用去前缀；无序列表
   *  "- * +" 按显示口径转 "· "，有序 "N. " 原样；空行原样保留不折叠）。 */
  function plainLineForCopy(raw: string): string {
    const t = raw.trim();
    if (t.length == 0) {
      return raw;
    }
    let body = raw;
    let prefix = "";
    if (t.charAt(0) == "#") {
      let level = 0;
      while (level < t.length && t.charAt(level) == "#" && level < 3) {
        level++;
      }
      if (level > 0 && t.length > level && t.charAt(level) == " ") {
        body = t.substring(level + 1);
      }
    } else if (t.charAt(0) == ">") {
      body = t.substring(1);
      if (body.length > 0 && body.charAt(0) == " ") {
        body = body.substring(1);
      }
      body = body.trim();
    } else if (t.length > 2 && (t.charAt(0) == "-" || t.charAt(0) == "*" || t.charAt(0) == "+") && t.charAt(1) == " ") {
      prefix = "· ";
      body = t.substring(2);
    } else if (olPrefixLen(t) > 0 && t.length > olPrefixLen(t)) {
      const cut = olPrefixLen(t);
      prefix = t.substring(0, cut);
      body = t.substring(cut);
    }
    return prefix + plainInlineForCopy(body);
  }

  /** 整文剥标记：``` 围栏行本身不出文案（内容原样保留、不再剥行内标记，未闭合围栏吃到尾）；
   *  无富文本特征（richNeeded 同口径）原文直返零变形。渲染与复制共用同一套解析器，剥法不漂移。 */
  function plainBodyForCopy(text: string): string {
    if (text.length == 0 || richNeeded(text) != true) {
      return text;
    }
    const rawLines = text.split("\n");
    const out: string[] = [];
    let inCode = false;
    for (let i = 0; i < rawLines.length; i++) {
      const raw = rawLines[i];
      const trimmed = raw.trim();
      if (trimmed.indexOf("```") == 0) {
        inCode = !inCode;
        continue;
      }
      if (inCode) {
        out.push(raw);
        continue;
      }
      out.push(plainLineForCopy(raw));
    }
    return out.join("\n");
  }

  /** 成员列表到位后：已渲染消息的提及高亮需要重建（richNeeded 依赖成员 token）。 */
  function rebuildRichAll(): void {
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].msgType == "text") {
        applyRichToRow(rows[i]);
      }
    }
  }

  /** 行容器样式（code/quote/h 的块级表现，我方紫底气泡用浅色变体保对比度）。 */
  function lineClassOf(ln: ImRichLine, mine: boolean): string {
    if (ln.kind == "code") {
      return mine ? "chat-rl chat-rl--code chat-rl--code-mine" : "chat-rl chat-rl--code";
    }
    if (ln.kind == "quote") {
      return mine ? "chat-rl chat-rl--quote chat-rl--quote-mine" : "chat-rl chat-rl--quote";
    }
    if (ln.kind == "h1" || ln.kind == "h2" || ln.kind == "h3") {
      const size = ln.kind == "h1" ? "chat-rl--h1" : ln.kind == "h2" ? "chat-rl--h2" : "chat-rl--h3";
      return `chat-rl ${size}`;
    }
    return "chat-rl";
  }

  /** 行内段样式：标记组合类 + 标题字号 + 提及蓝（我方气泡内浅一档）。 */
  function segClassOf(sg: ImSeg, mine: boolean, lineKind: string): string {
    let cls = "chat-md";
    if (lineKind == "h1" || lineKind == "h2" || lineKind == "h3") {
      cls += lineKind == "h1" ? " chat-md--h1" : lineKind == "h2" ? " chat-md--h2" : " chat-md--h3";
    }
    if (sg.bold) {
      cls += " chat-md--b";
    }
    if (sg.italic) {
      cls += " chat-md--i";
    }
    if (sg.strike) {
      cls += " chat-md--s";
    }
    if (sg.underline) {
      cls += " chat-md--u";
    }
    if (sg.code) {
      cls += mine ? " chat-md--c chat-md--c-mine" : " chat-md--c";
    }
    if (sg.mention) {
      cls += mine ? " chat-md--at-mine" : " chat-md--at";
    }
    if (sg.link) {
      cls += " chat-md--link";
    }
    if (sg.listMark) {
      cls += " chat-md--listmark";
    }
    return cls;
  }

  // ===== @提及（面板 / 插入 / 发送反扫） =====

  /**
   * @面板数据源加载（提及反扫/高亮同依据）：群聊/团队拉会话成员，单聊拉联系人
   * （@ 某人，飞书式；displayName 服务端已按备注>昵称>账号算好直接做 token）。
   * 失败静默：面板显示空态可重试。
   */
  async function loadMembers(): Promise<void> {
    if (convId.value.length == 0 || membersLoaded) {
      return;
    }
    try {
      const out: ImMember[] = [];
      if (isGroupLike.value) {
        const res = await apiImConvMembers(convId.value);
      if (!isChatCurrent()) return;
        if (apiResCode(res) != SUCCESS_CODE) {
          return;
        }
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj == null) {
          return;
        }
        const recordsRaw = dataObj["records"];
        if (recordsRaw == null) {
          return;
        }
        const records = recordsRaw as UTSJSONObject[];
        for (let i = 0; i < records.length; i++) {
          const m = new ImMember();
          m.userId = readString(records[i], "userId");
          m.name = readString(records[i], "name");
          m.nickName = readString(records[i], "nickName");
          m.avatar = readString(records[i], "avatar");
          m.token = m.nickName.length > 0
            ? m.nickName
            : m.name.length > 0
              ? m.name
              : `用户${m.userId}`;
          if (m.userId.length > 0) {
            out.push(m);
          }
        }
      } else {
        // 单聊：@ 某人 → 联系人（status=1 已互为联系人，申请中的不进面板）
        const res = await apiImContacts();
      if (!isChatCurrent()) return;
        if (apiResCode(res) != SUCCESS_CODE) {
          return;
        }
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj == null) {
          return;
        }
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const m = new ImMember();
            m.userId = readString(items[i], "userId");
            m.token = readString(items[i], "displayName");
            m.avatar = readString(items[i], "avatar");
            if (readNumber(items[i], "status", 1) == 1 && m.userId.length > 0 && m.token.length > 0) {
              out.push(m);
            }
          }
        }
      }
      members.value = out;
      membersLoaded = true;
      // 已渲染消息的 @提及高亮依赖成员 token，补扫一次
      rebuildRichAll();
    } catch (_error) {
      // 静默：面板空态可再点开重试
    }
  }

  /** 提及文本追加到输入末尾：前缀无空白时补一个空格（与既有正文隔开，PC replaceBeforeCaret 同语义）。 */
  function appendMentionText(token: string): void {
    const text = inputText.value;
    const needsSpace = text.length > 0 && text.charAt(text.length - 1) != " " && text.charAt(text.length - 1) != "\n";
    const insert = `${needsSpace ? " " : ""}@${token} `;
    const next = text + insert;
    inputText.value = next.substring(0, 2000);
  }

  /** 键盘敲 @ 检测用的输入快照：watch 跟随一切改写（发送清空/表情/提及回填/编辑等），
   *  input 事件里据此判「相对快照恰好多出一个尾部 @」；删除回退与编程改写不满足 +1 差值，不误触发。
   *  watch 为 pre-flush（input 处理器之后才跑），处理器内读到的恒是事件前值。 */
  let inputSnapshot = "";
  watch(inputText, (val: string) => {
    inputSnapshot = val;
  });

  /**
   * 键盘直接敲 @（打开键盘后从符号面板选择 @）：识别「恰好多出一个尾部 @」
   * （App 无程序化光标，同列表前缀只认末尾口径），命中则回退刚敲的 @ 并返回 true
   * （选中后由 appendMentionText 统一重插 "@token "，不留裸 @），调用方走 @ 键同款成员选择页。
   * 500ms 防重入：Android 原生 textarea 在程序化回写后可能重投一次 input，避免连续进两页。
   * ★须定义在 handleExpandInputTyped/handleInputTyped 之前（UTS→Kotlin 先用后定义会报「找不到名称」）。
   */
  let typedAtConsumedMs = 0;
  function consumeTypedAt(): boolean {
    const now = Date.now();
    const text = inputText.value;
    if (
      now - typedAtConsumedMs < 500 ||
      text.length != inputSnapshot.length + 1 ||
      text.charAt(text.length - 1) != "@"
    ) {
      return false;
    }
    typedAtConsumedMs = now;
    inputText.value = text.substring(0, text.length - 1);
    return true;
  }

  /**
   * at-select 页选完回填事件（payload 为 { tokens: string[] }，token 不带 @ 前缀）：
   * 逐个追加到输入框（多选按勾选顺序插入），与旧内嵌面板点选同语义。
   */
  function onAtPickEvent(data: any): void {
    const obj = data == null ? null : (data as UTSJSONObject);
    if (obj == null) {
      return;
    }
    const raw = obj["tokens"];
    if (raw == null) {
      return;
    }
    const tokens = raw as string[];
    for (let i = 0; i < tokens.length; i++) {
      const token = tokens[i] == null ? "" : `${tokens[i]}`;
      if (token.length > 0) {
        appendMentionText(token);
      }
    }
    // 选完即续写：标记待聚焦，返回本页 onShow 后拉起键盘（此刻页面还压在子页下，
    // 直接 focus 不生效；取消返回不置位，不打扰）
    if (tokens.length > 0) {
      pendingFocusAfterAtPick = true;
    }
  }

  /**
   * 发送前提及反扫（PC ChatWindow onSend 同契约）：正文含 "@昵称" → mentionUserIds，
   * 含 "@所有人" → mentionAll。token 与面板插入字节一致才命中。
   */
  function scanMentions(text: string): ImMentionScan {
    const scan = new ImMentionScan();
    if (isGroupLike.value != true) {
      return scan;
    }
    if (text.indexOf(MENTION_ALL_TOKEN) >= 0) {
      scan.all = true;
    }
    const all = members.value;
    for (let i = 0; i < all.length; i++) {
      const token = all[i].token;
      if (token.length > 0 && text.indexOf(`@${token}`) >= 0 && scan.ids.indexOf(all[i].userId) < 0) {
        scan.ids.push(all[i].userId);
      }
    }
    return scan;
  }

  // ===== Aa 键聚焦驱动 =====

  /** 未聚焦时拉起键盘：focus 属性 false→true 变化触发（blur 已复位 false）。
   *  仅 Aa 键调用（开格式横条时拉键盘）；格式横条 icon 一律不动键盘态。 */
  function focusChatInput(): void {
    if (inputFocused.value) {
      return;
    }
    focusRequest.value = false;
    nextTick(() => {
      focusRequest.value = true;
    });
  }

  /** MessageDto → 行（历史接口按 seq 降序返回，这里只做单行解析）。 */
  /** reactions 快照（MessageDto.reactions / WS 3008 / REST 响应同构）→ 渲染模型数组。 */
  function parseReactions(raw: any | null): ImReaction[] {
    const list: ImReaction[] = [];
    if (raw == null) {
      return list;
    }
    const arr = raw as any[];
    for (let i = 0; i < arr.length; i++) {
      const itemRaw = arr[i];
      if (itemRaw == null) {
        continue;
      }
      const item = itemRaw as UTSJSONObject;
      const r = new ImReaction();
      r.emoji = readString(item, "emoji");
      // userId int64：Android 经 `${raw}` 保精度转字符串（同 mentionIds 拼法）
      const uidRaw = item["userId"];
      if (uidRaw != null) {
        r.userId = `${uidRaw}`;
      }
      r.userName = readString(item, "userName");
      if (r.emoji.length > 0) {
        list.push(r);
      }
    }
    return list;
  }

  /** 合并转发条目摘要：纯媒体消息按类型给占位（与引用预览同文案）。 */
  function mergePreviewTextOf(msgType: string, text: string): string {
    if (text.length > 0) {
      return text;
    }
    if (msgType == "image") {
      return t("Mobile.Message.quoteImage");
    }
    if (msgType == "audio") {
      return t("Mobile.Message.previewAudio");
    }
    if (msgType == "video") {
      return t("Mobile.Message.previewVideo");
    }
    return t("Mobile.Message.quoteFile");
  }

  /** 按行内明细重算聚合标记态（明细/sendTime 变化后调用；HUNG 投影随当前时刻走）。 */
  function applyAgentStatusToRow(row: ImMsgRow): void {
    const view = aggregateAgentStatus(row.agentDetail, Date.now(), row.sendTime);
    row.agentStatus = view.has ? view.status : 0;
  }

  /**
   * 智能体状态明细单调并入目标行（3006 帧与 HTTP 快照共口）。
   * 返回是否引起聚合态变化（调用方据此决定是否触发重渲）。
   */
  function mergeRowAgentDetail(row: ImMsgRow, incoming: ImAgentStatusItem[]): boolean {
    if (incoming.length == 0) {
      return false;
    }
    const before = row.agentStatus;
    const merged = mergeAgentStatusItems(row.agentDetail, incoming);
    if (merged == null) {
      return false;
    }
    row.agentDetail = merged;
    applyAgentStatusToRow(row);
    return row.agentStatus != before;
  }

  function readMsgRow(obj: UTSJSONObject): ImMsgRow {
    const row = new ImMsgRow();
    row.msgId = readString(obj, "msgId");
    row.clientMsgId = readString(obj, "clientMsgId");
    row.seq = readNumber(obj, "seq", 0);
    row.senderId = readString(obj, "senderId");
    row.senderType = readNumber(obj, "senderType", 1);
    row.senderName = readString(obj, "senderName");
    row.senderAvatar = readString(obj, "senderAvatar");
    row.msgType = readString(obj, "msgType");
    // body=null（撤回/审核拦截）不出气泡；text 读 body.text，image 读 body.url，
    // rich_text 读 body.text + body.attachments（图片附件与文件/链接附件分开存）
    const bodyRaw = obj["body"];
    if (bodyRaw != null) {
      const body = bodyRaw as UTSJSONObject;
      row.bodyText = readString(body, "text");
      if (row.msgType == "image") {
        row.imageUrl = readString(body, "url");
      } else if (row.msgType == "file") {
        // 文件消息按链接卡片渲染（与 rich_text 附件同款，可点击打开=下载+系统查看器；
        // 不再落 digest 系统行）。视频文件（mime video/* 或视频扩展名）例外：转入视频消息
        // 渲染管线（内联 <video> + ak 直链预载，与 msgType=video 同款）——卡片点开只是下载
        // 兜底，内联播放体验更优。发送契约仍是 kind=file（PC 同款），只改端上渲染形态
        const fileUrl = readString(body, "url");
        const fileName = readString(body, "fileName");
        const fileMime = readString(body, "mime");
        if (fileUrl.length > 0 && classifyKind(fileMime, fileUrl) == "video") {
          row.videoUrl = fileUrl;
          row.videoFileName = fileName;
          row.videoSize = readNumber(body, "size", 0);
        } else {
          const att = new ImMsgAtt();
          att.url = fileUrl;
          att.fileName = fileName;
          att.mime = fileMime;
          if (att.url.length > 0) {
            row.linkAtts.push(att);
          }
        }
      } else if (row.msgType == "audio") {
        // 语音消息：body.url 即播放地址；duration 秒可缺省（>3600 按 ms 误传换算回秒，
        // 超出合理语音时长不展示，首播后由播放器回填真值）
        row.audioUrl = readString(body, "url");
        const dur = readNumber(body, "duration", 0);
        if (dur > 0 && dur <= 3600) {
          row.audioDuration = dur;
        } else if (dur > 3600 && dur <= 3600000) {
          row.audioDuration = Math.round(dur / 1000);
        }
      } else if (row.msgType == "video") {
        // 视频消息：body 顶层 {url, fileName, size, mime}（读取先例 utils/imChatAttachments.uts）；
        // url 空 = 坏行，videoUrl 留空 → 模板条件不命中，回落 digest 系统行（同 audio 口径）。
        // /api/f/ 受保护地址不在此解析（视频大，不做整页预解析），点击播放时懒解析（见 handleVideoMsgTap）
        row.videoUrl = readString(body, "url");
        row.videoFileName = readString(body, "fileName");
        row.videoSize = readNumber(body, "size", 0);
      } else if (row.msgType == "card") {
        // 互动卡片：title 必填（服务端结构化校验），缺失即数据坏——回落 digest 系统行，
        // 不渲染残卡（渲染一张没标题的卡比降级更糟）。actions 逐项过滤：缺 key 或缺
        // label 的按钮丢弃（点了必然 IM_10404 / 空白按钮），不让一条坏动作打挂整张卡。
        row.cardTitle = readString(body, "title");
        const desc = readString(body, "desc");
        row.cardDesc = desc.length > 0 ? desc : readString(body, "subtitle");
        const fieldsRaw = body["fields"];
        if (fieldsRaw != null) {
          const fields = fieldsRaw as UTSJSONObject[];
          for (let i = 0; i < fields.length; i++) {
            const label = readString(fields[i], "label");
            const value = readString(fields[i], "value");
            if (label.length > 0 || value.length > 0) {
              const f = new ImCardField();
              f.label = label;
              f.value = value;
              row.cardFields.push(f);
            }
          }
        }
        const actionsRaw = body["actions"];
        if (actionsRaw != null) {
          const actions = actionsRaw as UTSJSONObject[];
          for (let i = 0; i < actions.length; i++) {
            const key = readString(actions[i], "key");
            const label = readString(actions[i], "label");
            if (key.length == 0 || label.length == 0) {
              continue;
            }
            const a = new ImCardAction();
            a.key = key;
            a.label = label;
            a.style = readString(actions[i], "style");
            // state 整个对象可缺失（历史消息/纯展示卡服务端不回填）⇒ 按 pending（可点）
            const stateRaw = actions[i]["state"];
            if (stateRaw != null) {
              const stateObj = stateRaw as UTSJSONObject;
              a.state = readString(stateObj, "state");
              a.stateText = readString(stateObj, "text");
            }
            row.cardActions.push(a);
          }
        }
        // 跳转链接：展示卡（无 actions）靠它落「查看详情」；交互卡也可同时携带
        row.cardActionUrl = readString(body, "actionUrl");
      } else if (row.msgType == "merge_forward") {
        // 合并转发卡片：title 可缺省（渲染回落「聊天记录」）；预览只取前 2 条，
        // 其余收进「共 N 条」尾行（items 总数用 body.items 原始长度）
        row.mergeTitle = readString(body, "title");
        const itemsRaw = body["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          row.mergeTotal = items.length;
          for (let i = 0; i < items.length && i < 2; i++) {
            const p = new ImMergePreview();
            p.senderName = readString(items[i], "senderName");
            p.preview = mergePreviewTextOf(readString(items[i], "msgType"), readString(items[i], "text"));
            row.mergeItems.push(p);
          }
          // 全量条目给详情页（sendTime 快照给行首时间；text 存原文、preview 只作无媒体
          // 时的占位兜底——有附件的条目详情页直接渲染缩略图/视频/语音/文件卡片，不再
          // 显示 [图片] 类占位文案；attachments 契约同发送侧快照 {kind,url,fileName}）
          for (let i = 0; i < items.length; i++) {
            const it = new ImMergeItem();
            it.senderName = readString(items[i], "senderName");
            it.sendTime = readNumber(items[i], "sendTime", 0);
            it.text = readString(items[i], "text");
            it.preview = mergePreviewTextOf(readString(items[i], "msgType"), it.text);
            const mAttsRaw = items[i]["attachments"];
            if (mAttsRaw != null) {
              const mAtts = mAttsRaw as UTSJSONObject[];
              for (let j = 0; j < mAtts.length; j++) {
                const url = readString(mAtts[j], "url");
                if (url.length == 0) {
                  continue;
                }
                const media = new ImMergeMedia();
                media.kind = readString(mAtts[j], "kind");
                media.url = url;
                media.fileName = readString(mAtts[j], "fileName");
                if (media.kind == "image") {
                  it.images.push(media);
                } else if (media.kind == "audio") {
                  it.audios.push(media);
                } else if (media.kind == "video") {
                  it.videos.push(media);
                } else if (classifyKind("", url) == "video") {
                  // kind=file 但实为视频文件（文件消息视频端上按视频渲染，readMsgRow 同款
                  // classifyKind 重判）：详情页也走内联 <video>，不落文件卡片
                  it.videos.push(media);
                } else {
                  it.files.push(media);
                }
              }
            }
            row.mergeAllItems.push(it);
          }
        }
      }
      const attsRaw = body["attachments"];
      if (attsRaw != null) {
        const atts = attsRaw as UTSJSONObject[];
        for (let i = 0; i < atts.length; i++) {
          const att = new ImMsgAtt();
          att.url = readString(atts[i], "url");
          att.fileName = readString(atts[i], "fileName");
          att.mime = readString(atts[i], "mime");
          if (att.url.length == 0) {
            continue;
          }
          if (isImageAtt(att)) {
            row.imageAtts.push(att);
          } else if (row.videoUrl.length == 0 && classifyKind(att.mime, att.url) == "video") {
            // 内嵌视频附件（kind=video，PC 发送形态）：气泡内联播放（同 file 视频的
            // conversation-not-found 坑，不走链接卡片）；单行只承载一个播放器，
            // 第 2+ 条视频附件仍落链接卡片（点击走下载兜底，见 handleLinkAttTap）
            row.videoUrl = att.url;
            row.videoFileName = att.fileName;
            row.videoSize = readNumber(atts[i], "size", 0);
          } else {
            row.linkAtts.push(att);
          }
        }
      }
    }
    // 引用消息：服务端在 replyTo 里展开原消息（最多一层）
    row.replyId = readString(obj, "replyToMsgId");
    const replyRaw = obj["replyTo"];
    if (replyRaw != null) {
      const reply = replyRaw as UTSJSONObject;
      row.replySenderName = readString(reply, "senderName");
      row.replyRevoked = readNumber(reply, "msgStatus", 1) == 2;
      const replyType = readString(reply, "msgType");
      if (replyType == "image") {
        row.replyIsImage = true;
      } else if (replyType == "audio") {
        row.replyIsAudio = true;
      } else if (replyType == "video") {
        row.replyIsVideo = true;
      }
      const replyBodyRaw = reply["body"];
      if (replyBodyRaw != null) {
        const replyBody = replyBodyRaw as UTSJSONObject;
        row.replyText = readString(replyBody, "text");
      }
    }
    row.digest = readString(obj, "digest");
    row.revoked = readNumber(obj, "msgStatus", 1) == 2;
    row.edited = readNumber(obj, "editTime", 0) > 0;
    row.revisionAt = Math.max(readNumber(obj, "editTime", 0), readNumber(obj, "revokeTime", 0));
    row.revokeById = readString(obj, "revokeBy");
    // @提及元数据（int64 数组经 `${raw}` 保精度转字符串）
    const mentionIdsRaw = obj["mentionUserIds"];
    if (mentionIdsRaw != null) {
      const ids = mentionIdsRaw as any[];
      for (let i = 0; i < ids.length; i++) {
        if (ids[i] != null) {
          row.mentionIds.push(`${ids[i]}`);
        }
      }
    }
    row.mentionAll = readBool(obj, "mentionAll");
    // 表情回复快照（服务端只在非空时带 reactions 键；撤回消息 body 清空但 reactions 可能残留——
    // 撤回行不进气泡，chips 也就不渲染，无需在此过滤）
    row.reactions = parseReactions(obj["reactions"]);
    applyRichToRow(row);
    row.sendTime = readNumber(obj, "sendTime", 0);
    row.status = 1;
    // 智能体处理状态明细（读路径投影：仅发送者本人且衔接了智能体才有键；缺键=回落已读环）。
    // ★须在 sendTime 赋值后：HUNG 挂起投影以它作 updateTime 缺失时的时间锚
    row.agentDetail = parseAgentStatusDetail(obj["agentStatusDetail"]);
    applyAgentStatusToRow(row);
    return row;
  }

  /** SendMessageResult → 确认行（保留占位行的文本与 clientMsgId）。 */
  function buildConfirmedRow(dataObj: UTSJSONObject | null, placeholder: ImMsgRow): ImMsgRow {
    const row = new ImMsgRow();
    if (dataObj != null) {
      row.msgId = readString(dataObj, "msgId");
      row.seq = readNumber(dataObj, "seq", 0);
      row.sendTime = readNumber(dataObj, "sendTime", placeholder.sendTime);
    } else {
      row.msgId = placeholder.msgId;
      row.seq = placeholder.seq;
      row.sendTime = placeholder.sendTime;
    }
    row.senderId = placeholder.senderId;
    row.senderType = 1;
    row.bodyText = placeholder.bodyText;
    // 提及元数据与富文本渲染模型随占位行带过来（确认响应不含 body 明细）
    row.mentionIds = placeholder.mentionIds;
    row.mentionAll = placeholder.mentionAll;
    row.bodyFormatted = placeholder.bodyFormatted;
    row.lines = placeholder.lines;
    // 媒体占位行的类型与内容带过来（文本消息这些字段本就是默认值）
    row.msgType = placeholder.msgType;
    row.imageUrl = placeholder.imageUrl;
    row.imageAtts = placeholder.imageAtts;
    row.linkAtts = placeholder.linkAtts;
    // 引用元数据随占位行带过来（确认响应不含 replyTo 明细，不透传确认瞬间引用块会闪没）
    row.replyId = placeholder.replyId;
    row.replySenderName = placeholder.replySenderName;
    row.replyRevoked = placeholder.replyRevoked;
    row.replyIsImage = placeholder.replyIsImage;
    row.replyText = placeholder.replyText;
    row.sendTime = row.sendTime > 0 ? row.sendTime : placeholder.sendTime;
    row.status = 1;
    row.clientMsgId = placeholder.clientMsgId;
    row.local = true;
    return row;
  }

  // ===== 长按操作 / 已读状态 共用判定 =====

  /** 已被服务端确认的行（本地占位/发送中行 msgId 以 local- 开头，无服务端身份，不可 Pin/编辑/撤回/查已读）。 */
  function isConfirmedRow(msg: ImMsgRow): boolean {
    return msg.msgId.indexOf("local-") != 0;
  }

  // ===== 多选态总开关（表情 chip 的多选吞击要用，先于各分区声明） =====
  const multiSelectMode = ref<boolean>(false);

  /**
   * 主体刚体平移量 px：键盘 > 内嵌面板 > 0（多选态归零）。键盘与面板共用同一让位源，
   * 互切时 liftPx 单值过渡即为「键盘↔面板」连续动画（无二段跳变）。
   * （声明在 multiSelectMode 之后：UTS→Kotlin 闭包前向引用规避）
   */
  const liftPx = computed<number>((): number => {
    if (multiSelectMode.value) {
      return 0;
    }
    if (keyboardHeight.value > 0) {
      return keyboardHeight.value;
    }
    if (panelMode.value == "emoji") {
      return emojiSlotPx.value;
    }
    if (panelMode.value == "plus") {
      return plusSlotPx.value;
    }
    return 0;
  });
  /** 刚体平移样式（恒渲染含 0，升降动画由 .chat-main 的 transform 过渡承担）。 */
  const chatMainStyle = computed<string>((): string => "transform: translateY(-" + liftPx.value + "px)");
  /**
   * dock 底距：升起态（键盘/面板占住屏底）只留基础间距——安全区由键盘/填充带接管；
   * 静止态垫底部安全区+基础间距。34px 差随同曲线过渡（非让位机制，仅收安全区）。
   */
  const dockPadBottomPx = computed<number>((): number => (liftPx.value > 0 ? 6 : 6 + safeBottomPx.value));

  /** 多选态静默吞点击（气泡内子元素的入口用：点击会冒泡到气泡层由 multiGuard 统一切换，
   *  这里再切一次会双 toggle 抵消）。 */
  function multiSwallow(): boolean {
    return multiSelectMode.value;
  }

  // ===== 表情回复（长按弹窗快选条 + 气泡下 chips；协议/快照语义见 servers/im.uts 表情回复域） =====

  /** 可加表情：正常态、已确认的消息（撤回行/发送中行不可加；类型不限，权限权威在服务端）。 */
  function canReactMsg(msg: ImMsgRow): boolean {
    return msg.revoked != true && msg.status == 1 && isConfirmedRow(msg) && msg.sendTime > 0;
  }

  /** 当前用户已在消息上用过的 emoji 集合（快选条高亮用）。 */
  function myEmojisOf(msg: ImMsgRow): string[] {
    const out: string[] = [];
    const rs = msg.reactions;
    for (let i = 0; i < rs.length; i++) {
      if (rs[i].userId == myUserId.value && out.indexOf(rs[i].emoji) < 0) {
        out.push(rs[i].emoji);
      }
    }
    return out;
  }

  /** 单条 reaction 的展示名：userName 空兜底「未知用户」（与搜索页同文案键）。 */
  function reactionNameOf(r: ImReaction): string {
    return r.userName.length > 0 ? r.userName : t("Mobile.Message.imSearchUnknownUser");
  }

  /** 内容区末行 chips：按 emoji 首次出现顺序聚合（emoji + 用户名空格拼接 + 是否含我）。 */
  function reactionChipsOf(msg: ImMsgRow): ImReactionChip[] {
    const chips: ImReactionChip[] = [];
    const rs = msg.reactions;
    for (let i = 0; i < rs.length; i++) {
      const r = rs[i];
      let hit: ImReactionChip | null = null;
      for (let j = 0; j < chips.length; j++) {
        if (chips[j].emoji == r.emoji) {
          hit = chips[j];
          break;
        }
      }
      if (hit == null) {
        const c = new ImReactionChip();
        c.emoji = r.emoji;
        c.namesText = reactionNameOf(r);
        c.mine = r.userId == myUserId.value;
        chips.push(c);
      } else {
        hit.namesText = `${hit.namesText} ${reactionNameOf(r)}`;
        if (r.userId == myUserId.value) {
          hit.mine = true;
        }
      }
    }
    return chips;
  }

  // Android 不追踪 ref 数组内实例属性原地变更（ba6a72f18 message.uvue 同款平台缺陷）：
  // 表情回应三写口（乐观更新 / REST+WS 权威快照 / 失败回滚）与下方受保护图片/视频异步
  // 回填 row.imageUrl / att.url / row.videoPlayUrl 全是 rows[i].xxx 原地赋值，Android 的
  // v-for 行不重渲——「点表情 chip 不出现、触碰别处才冒出」与「进页图片空白」同根。
  // 写后去抖合并一次整表重建赋值强制重渲（key=msgId 稳定元素复用、不跳滚动，
  // iOS/H5 无副作用）。★须定义在 applyReactionSnapshot 与媒体回填调用点之前
  // （UTS 无提升，先声明后调用）。
  let chatMediaRefreshTimer = 0;

  function scheduleChatMediaRefresh(): void {
    if (chatMediaRefreshTimer != 0) return;
    chatMediaRefreshTimer = setTimeout(() => {
      chatMediaRefreshTimer = 0;
      if (pageDisposed || !isChatCurrent()) return;
      messages.value = messages.value.slice();
    }, 50);
  }

  // ===== 智能体「处理中」转钟驱动（对齐 PC 1.6s/圈；App 端 CSS animation 不可靠，
  // 用 transition 自转——spin-loading 同款：角度单调递增 + linear transition，
  // 每 tick 转 4 圈把 JS→原生桥频率降为 1/4）。deg 经模板参数传入建立响应依赖（readInfoTick 同款）。 =====
  const AGENT_CLOCK_PERIOD_MS: number = 1600;
  const AGENT_CLOCK_CYCLES_PER_TICK: number = 4;
  const agentClockDeg = ref<number>(0);
  let agentClockTimer = 0;
  let agentClockStartTimer = 0;

  /** 处理中钟面 inline style：transform + 本次过渡时长（property/timing-function 落在类上）。 */
  function agentClockStyle(deg: number): string {
    return `transform: rotate(${deg}deg);transition-duration: ${AGENT_CLOCK_PERIOD_MS * AGENT_CLOCK_CYCLES_PER_TICK}ms;`;
  }

  function clearAgentClockTimers(): void {
    if (agentClockTimer != 0) {
      clearInterval(agentClockTimer);
      agentClockTimer = 0;
    }
    if (agentClockStartTimer != 0) {
      clearTimeout(agentClockStartTimer);
      agentClockStartTimer = 0;
    }
  }

  /** 是否有「处理中」行：依赖 messages 整表重赋值（明细变更均伴随 mergeSyncedMessages/scheduleChatMediaRefresh）。 */
  const anyAgentProcessing = computed((): boolean => {
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].agentStatus == IM_AGENT_STATUS_PROCESSING) {
        return true;
      }
    }
    return false;
  });

  watch(
    (): boolean => anyAgentProcessing.value,
    (on: boolean) => {
      clearAgentClockTimers();
      if (on != true) {
        return;
      }
      agentClockDeg.value = 0;
      // 等节点就绪后先抬到整 tick 角度再起 interval（首帧 transition 才会转起来——spin-loading 同款）
      agentClockStartTimer = setTimeout(() => {
        agentClockStartTimer = 0;
        agentClockDeg.value = 360 * AGENT_CLOCK_CYCLES_PER_TICK;
        agentClockTimer = setInterval(() => {
          agentClockDeg.value = agentClockDeg.value + 360 * AGENT_CLOCK_CYCLES_PER_TICK;
        }, AGENT_CLOCK_PERIOD_MS * AGENT_CLOCK_CYCLES_PER_TICK);
      }, 50);
    },
    { immediate: true },
  );

  /** reactions 全量快照就地替换目标行（REST 响应与 WS 3008 同构：整体替换，无本地合并）。 */
  function applyReactionSnapshot(msgId: string, raw: any | null): void {
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].msgId == msgId) {
        rows[i].reactions = parseReactions(raw);
        scheduleChatMediaRefresh();
        return;
      }
    }
  }

  /**
   * 乐观更新：点表情瞬间按预期结果本地增删我的 reaction（换新数组触发渲染）。
   * 返回点击前快照（原数组不动，供失败回滚）；行未找到返回 null（未应用，无需回滚）。
   */
  function applyOptimisticReaction(msgId: string, add: boolean, emoji: string): ImReaction[] | null {
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      if (row.msgId != msgId) {
        continue;
      }
      const before = row.reactions;
      const next: ImReaction[] = [];
      const rs = row.reactions;
      for (let k = 0; k < rs.length; k++) {
        // 我的该 emoji 条目始终跳过：取消=删除；添加=防重（toggle 语义下正常不重）
        if (rs[k].userId == myUserId.value && rs[k].emoji == emoji) {
          continue;
        }
        next.push(rs[k]);
      }
      if (add == true) {
        const mine = new ImReaction();
        mine.emoji = emoji;
        mine.userId = myUserId.value;
        mine.userName = myDisplayName.value;
        next.push(mine);
      }
      row.reactions = next;
      scheduleChatMediaRefresh();
      return before;
    }
    return null;
  }

  /** 乐观更新失败回滚：恢复点击前快照（REST 失败路径；成功路径由权威快照覆盖）。 */
  function rollbackReaction(msgId: string, before: ImReaction[] | null): void {
    const snap = before;
    if (snap == null) {
      return;
    }
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].msgId == msgId) {
        rows[i].reactions = snap;
        scheduleChatMediaRefresh();
        return;
      }
    }
  }

  // ===== 常用表情（DEV-318 对齐 PC：长按面板第一行数据源 + 点表情记账） =====

  /** 常用表情上限（= 服务端 USER_EMOJI_RECENT_MAX=24：接口无分页，24 就是返回量上界）。 */
  const RECENT_EMOJI_MAX = 24;

  /** 我的常用表情（GET /emojis/recent 归一后的 emoji 串，服务端序：useCount 降 →
   *  lastUseTime 降 → id 降，★不重排；空 = 新用户或未拉到，快选条回落默认组）。
   *  用户级资源与会话无关：切会话不重拉不清空（无实时帧，跨端刚用的靠面板拉起时刷新）。 */
  const recentEmojis = ref<string[]>([]);

  /** /emojis/recent 的 data 归一（对齐 PC normalizeRecentEmojis）：丢 emoji 空行、
   *  按 emoji 去重保留首次、截 RECENT_EMOJI_MAX 防上限变更撑爆面板。 */
  function parseRecentEmojis(dataRaw: any | null): string[] {
    const out: string[] = [];
    if (dataRaw == null || Array.isArray(dataRaw) != true) {
      return out;
    }
    const rows = dataRaw as UTSJSONObject[];
    for (let i = 0; i < rows.length; i++) {
      if (out.length >= RECENT_EMOJI_MAX) {
        break;
      }
      const emoji = readString(rows[i], "emoji").trim();
      if (emoji.length > 0 && out.indexOf(emoji) < 0) {
        out.push(emoji);
      }
    }
    return out;
  }

  /** 拉常用表情（进页预热 + 每次长按面板拉起时刷新，PC 开面板重拉同款）。★失败静默
   *  保留旧值：写空会把"没拉到"伪装成"没有常用"，快选条闪回默认组。 */
  async function loadRecentEmojis(): Promise<void> {
    try {
      const res = await apiImRecentEmojis();
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        recentEmojis.value = parseRecentEmojis(apiResData<any>(res));
      }
    } catch (_error) {
      // 静默：回落默认组，下次长按再试
    }
  }

  /** 面板常用行（输入坞表情面板 + 展开面板共用的首行）：截一行 8 个【真实历史】，
   *  不补默认组（对齐 PC 带标题常用行的纪律——不掺假数据；空则整段隐藏不渲染）。 */
  const panelRecentEmojis = computed((): string[] => {
    const out: string[] = [];
    const recent = recentEmojis.value;
    for (let i = 0; i < recent.length && out.length < EMOJI_COLS; i++) {
      out.push(recent[i]);
    }
    return out;
  });

  /** 快选条列表：我的常用在前（服务端序）+ QUICK_EMOJIS 依次补齐至满排（跳过已出现；
   *  常用已满排则不补不截——条可横滚，24 条以内整排展示）。 */
  function buildQuickEmojis(): string[] {
    const out: string[] = [];
    const recent = recentEmojis.value;
    for (let i = 0; i < recent.length; i++) {
      if (out.indexOf(recent[i]) < 0) {
        out.push(recent[i]);
      }
    }
    for (let i = 0; i < QUICK_EMOJIS.length && out.length < QUICK_EMOJIS.length; i++) {
      if (out.indexOf(QUICK_EMOJIS[i]) < 0) {
        out.push(QUICK_EMOJIS[i]);
      }
    }
    return out;
  }

  /** 记一次「我用了这个表情」（POST /emojis/usage，PC 两入口同款：回应点选 +
   *  输入面板插入）。★计数器不幂等不重试；失败静默（服务端写失败也只回 data=false
   *  ——记账是附属动作，永不拖挂主流程）。 */
  async function recordEmojiUsage(emoji: string): Promise<void> {
    const clean = emoji.trim();
    if (clean.length == 0) {
      return;
    }
    try {
      await apiImRecordEmojiUsage(clean);
    } catch (_error) {
      // fire-and-forget：不弹错、不重试（重试一次=用户多用一次）
    }
  }

  /** 加/取消表情：我加过该 emoji ⇒ 取消，否则添加。点下瞬间先乐观本地增删（chips 即时变化，
      不等 REST 往返），REST 响应 / WS 3008 的全量快照随后权威覆盖；失败回滚并 toast。 */
  async function handleActionReact(msg: ImMsgRow, emoji: string): Promise<void> {
    if (convId.value.length == 0) {
      return;
    }
    // 记一次常用表情（PC doReact 同款落点：快选条/展开网格/chip 三入口都收敛到这里，
    // 点选即记账——与 toggle 方向、回应成败无关；不 await 不影响回应时序）
    recordEmojiUsage(emoji);
    const mine = myEmojisOf(msg).indexOf(emoji) >= 0;
    const before = applyOptimisticReaction(msg.msgId, mine != true, emoji);
    try {
      const res = mine
        ? await apiImMsgRemoveReaction(convId.value, msg.msgId, emoji)
        : await apiImMsgAddReaction(convId.value, msg.msgId, emoji);
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        applyReactionSnapshot(msg.msgId, dataObj == null ? null : dataObj["reactions"]);
      } else {
        rollbackReaction(msg.msgId, before);
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (_error) {
      rollbackReaction(msg.msgId, before);
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /** 点气泡下 chip：同 handleActionReact 的 toggle 语义（多选态吞掉，点气泡本体去选中）。 */
  function handleReactionChipTap(msg: ImMsgRow, chip: ImReactionChip): void {
    // rowPressFired：长按拉面板后抬手补发的 click 吞掉（三星等端长按抬手仍合成
    // click，不吞会反向 toggle 表情；同 handleBubbleTap 的守卫口径）
    if (rowPressFired || multiSwallow()) {
      return;
    }
    handleActionReact(msg, chip.emoji);
  }

  /** 表情快选条：可回复的正常消息才显示（撤回/发送中行不可加表情）；第一行 = 我的
   *  常用表情（buildQuickEmojis：常用在前 + 默认组补齐）。 */
  const sheetQuickEmojis = computed((): string[] => {
    const id = selectedId.value;
    if (id.length == 0) {
      return [] as string[];
    }
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].msgId == id) {
        return canReactMsg(rows[i]) ? buildQuickEmojis() : ([] as string[]);
      }
    }
    return [] as string[];
  });

  // ===== 多选 + 转发（飞书式：长按「多选」进选择态，底部工具条逐条/合并转发） =====

  /** 合并转发 items 上限（服务端 ImMergeForwardBodies MAX_ITEMS=50，超限拒绝不截断）。 */
  const MULTI_MERGE_MAX = 50;
  /** 合并快照单条 text 上限（码点；服务端拒绝不截断，构建侧必须截好）。 */
  const FORWARD_TEXT_MAX_CPS = 500;
  /** 可转发的六型白名单（PC lib/forward.ts FORWARDABLE_TYPES 同源；merge_forward 禁嵌套）。 */
  const FORWARDABLE_TYPES: string[] = ["text", "rich_text", "image", "file", "audio", "video"];

  /** 已选消息 msgId 集合（渲染按 messages 顺序，与点选顺序无关）。 */
  const multiSelectedIds = ref<string[]>([]);

  /** 可转发：六型白名单 + 正常态 + 已确认 + 有服务端时间戳（合并快照 sendTime 必填）。 */
  function canForwardMsg(msg: ImMsgRow): boolean {
    if (msg.revoked || msg.status != 1 || isConfirmedRow(msg) != true || msg.sendTime <= 0) {
      return false;
    }
    return FORWARDABLE_TYPES.indexOf(msg.msgType) >= 0;
  }

  function isMultiSelected(msg: ImMsgRow): boolean {
    return multiSelectedIds.value.indexOf(msg.msgId) >= 0;
  }

  /** 多选态勾选框样式：选中=主题色实心，可转未选=空心，不可转发=置灰。 */
  function multiCheckCls(msg: ImMsgRow): string {
    if (canForwardMsg(msg) != true) {
      return "chat-check--ban";
    }
    return isMultiSelected(msg) ? "chat-check--on" : "";
  }

  /** 进多选态：收键盘/面板（closeExpandSheet 体内联——其定义在后方，UTS 先用后定义会炸）；
   *  长按起点消息可转发则预选（微信/飞书同款）。 */
  function enterMultiSelect(msg: ImMsgRow): void {
    if (expanded.value) {
      expanded.value = false;
      expandPanel.value = "";
      expandFocusRequest.value = false;
    }
    if (panelMode.value.length > 0) {
      panelMode.value = "";
    }
    uni.hideKeyboard({ complete: () => {} });
    const ids: string[] = [];
    if (canForwardMsg(msg)) {
      ids.push(msg.msgId);
    }
    multiSelectedIds.value = ids;
    multiSelectMode.value = true;
  }

  function exitMultiSelect(): void {
    multiSelectMode.value = false;
    multiSelectedIds.value = [];
  }

  /** 多选态点行/点勾选框：切选中；不可转发的行提示后忽略（系统行不渲染勾选框，气泡行仍可点）。 */
  function toggleMultiSelect(msg: ImMsgRow): void {
    if (canForwardMsg(msg) != true) {
      uni.showToast({ title: t("Mobile.Message.multiNotForwardable"), icon: "none" });
      return;
    }
    const ids = multiSelectedIds.value;
    const idx = ids.indexOf(msg.msgId);
    if (idx >= 0) {
      ids.splice(idx, 1);
      multiSelectedIds.value = ids;
    } else {
      ids.push(msg.msgId);
      multiSelectedIds.value = ids;
    }
  }

  /** 多选态吞内容点击并切选中（气泡/图片消息等无父级 click 兜底的入口用；true=已处理）。 */
  function multiGuard(msg: ImMsgRow): boolean {
    if (multiSelectMode.value != true) {
      return false;
    }
    toggleMultiSelect(msg);
    return true;
  }

  // ---- 合并转发快照构建（契约见 servers/im.uts apiImSendMergeForwardMsg 注释） ----

  /** 取 src 第 i 个码点的 UTF-16 长度（代理对算 1 个码点占 2 个 char）。 */
  function cpLenAt(src: string, i: number): number {
    const code = src.charCodeAt(i) ?? -1;
    if (code >= 0xd800 && code <= 0xdbff && i + 1 < src.length) {
      const next = src.charCodeAt(i + 1) ?? -1;
      if (next >= 0xdc00 && next <= 0xdfff) {
        return 2;
      }
    }
    return 1;
  }

  function codePointCount(src: string): number {
    let n = 0;
    let i = 0;
    while (i < src.length) {
      i += cpLenAt(src, i);
      n++;
    }
    return n;
  }

  /** 按码点截断（代理对不劈开；超限时保留 max-1 个码点 + 「…」，输出 ≤ max，PC truncateCodePoints 同语义）。 */
  function truncateCodePoints(src: string, max: number): string {
    if (max <= 0) {
      return "";
    }
    if (codePointCount(src) <= max) {
      return src;
    }
    const keep = max - 1;
    let out = "";
    let i = 0;
    let n = 0;
    while (i < src.length && n < keep) {
      const l = cpLenAt(src, i);
      out += src.substring(i, i + l);
      i += l;
      n++;
    }
    return out + "…";
  }

  /** 单条消息的附件快照 JSON（[{kind,url,fileName}]；url 必填非空的项才收，size 可选缺省）。 */
  function buildForwardAttachmentsJson(m: ImMsgRow): string {
    let json = "[";
    let first = true;
    const push = (kind: string, url: string, fileName: string): void => {
      if (url.length == 0) {
        return;
      }
      if (first != true) {
        json += ",";
      }
      first = false;
      json += `{"kind":"${kind}","url":${JSON.stringify(url)},"fileName":${JSON.stringify(fileName)}}`;
    };
    if (m.msgType == "image" && m.imageUrl.length > 0) {
      push("image", m.imageUrl, "");
    }
    // 语音快照（kind=audio）：服务端只校验 url 非空不设 kind 白名单（ImMergeForwardBodies
    // 逐字核实），详情页按声波气泡播放；时长快照契约无字段，首播回填
    if (m.msgType == "audio" && m.audioUrl.length > 0) {
      push("audio", m.audioUrl, "");
    }
    if (m.videoUrl.length > 0) {
      // file 单附件视频端上按视频渲染，转发快照仍按原 file 契约；
      // rich_text 内嵌视频附件原本 kind=video，快照保真原 kind
      push(m.msgType == "file" ? "file" : "video", m.videoUrl, m.videoFileName);
    }
    for (let i = 0; i < m.imageAtts.length; i++) {
      push("image", m.imageAtts[i].url, m.imageAtts[i].fileName);
    }
    for (let i = 0; i < m.linkAtts.length; i++) {
      push("file", m.linkAtts[i].url, m.linkAtts[i].fileName);
    }
    json += "]";
    return json;
  }

  /** 一条消息 → 合并快照 item（★不带 senderId：int64 精度链路防丢；digest 仅转发页预览用）。 */
  function buildForwardItemOf(m: ImMsgRow): ImForwardItem {
    const item = new ImForwardItem();
    item.msgId = m.msgId;
    item.msgType = m.msgType;
    item.senderName = m.senderName.length > 0 ? m.senderName : t("Mobile.Message.imSearchUnknownUser");
    item.sendTime = m.sendTime;
    item.text = truncateCodePoints(m.bodyText, FORWARD_TEXT_MAX_CPS);
    item.attachmentsJson = buildForwardAttachmentsJson(m);
    item.digest = m.digest.length > 0 ? m.digest : mergePreviewTextOf(m.msgType, m.bodyText);
    return item;
  }

  /** 按列表顺序（seq 升序）构建已选消息快照；空选中返回空数组。 */
  function buildForwardItems(): ImForwardItem[] {
    const items: ImForwardItem[] = [];
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (multiSelectedIds.value.indexOf(rows[i].msgId) < 0) {
        continue;
      }
      if (canForwardMsg(rows[i]) != true) {
        continue;
      }
      items.push(buildForwardItemOf(rows[i]));
    }
    return items;
  }

  /** 多选工具条转发：mode="single" 逐条 / "merge" 合并；载荷走 imForwardSession 暂存跳转发页。 */
  function handleMultiForward(mode: string): void {
    const items = buildForwardItems();
    if (items.length == 0) {
      return;
    }
    if (mode == "merge" && items.length > MULTI_MERGE_MAX) {
      uni.showToast({ title: tCount("Mobile.Message.multiMergeLimit", MULTI_MERGE_MAX), icon: "none" });
      return;
    }
    const s = new ImForwardSession();
    s.mode = mode;
    s.sourceConvId = convId.value;
    s.items = items;
    exitMultiSelect();
    openImForward(s);
  }

  /** 长按单条「转发」：单消息逐条转发（目标多选/搜索在转发页）。 */
  function handleActionForward(msg: ImMsgRow): void {
    const s = new ImForwardSession();
    s.mode = "single";
    s.sourceConvId = convId.value;
    const item = buildForwardItemOf(msg);
    const items: ImForwardItem[] = [item];
    s.items = items;
    openImForward(s);
  }

  // ===== 互动卡片（msgType=card）动作按钮：状态判据 + 点击执行（判据对齐 PC lib/card.ts，有单测钉住）=====

  /** 服务端已定义的四个动作状态（openapi CardActionState.state）。 */
  const KNOWN_CARD_STATES: string[] = ["pending", "done", "stale", "forbidden"];

  /** 正在执行的卡片动作 key（防连点；★只存 key：按钮状态由消息 body 驱动，本地另存一份会出现两个真源）。 */
  const cardBusyKey = ref<string>("");

  // ===== 消息区按压态（触摸自驱，替代 hover-class；message.uvue 行按压同方案）=====
  // Android 上 hover-class 被滚动接管后按压底色粘住不灭：按住消息上下滑、松手后底色
  // 残留（值改 'none' 也清不掉已激活样式）。改为触摸自驱：按下 50ms 后仍在原位才点亮
  // （对齐 hover 默认延迟）、位移超 10px 立即熄灭、抬手/取消必灭。pressTouchId 是通用
  // 按压键：`b-${msgId}`=气泡 / `c-${msgId}-${key}`=卡片按钮 / `r-${msgId}`=已读徽标。
  const pressTouchId = ref<string>("");
  let pressTouchPending = "";
  let pressTouchTimer = 0;
  let pressTouchStartX = 0;
  let pressTouchStartY = 0;

  /** 点消息内容展开的时间行：当前展开时间的消息 msgId（空串=全收起；一次只展开一条，微信同款）。 */
  const timeRevealedId = ref<string>("");

  /** 清按压态（点亮与待点亮一起清，任何触摸结束路径都调它，杜绝粘滞）。 */
  function clearPressTouch(): void {
    pressTouchPending = "";
    if (pressTouchTimer != 0) {
      clearTimeout(pressTouchTimer);
      pressTouchTimer = 0;
    }
    if (pressTouchId.value.length > 0) {
      pressTouchId.value = "";
    }
  }

  /**
   * 气泡 class：我方右贴（微信式）+ 按压激活底色（替代 hover-class）。
   * ★字符串拼接返回（真机对象语法 :class 不响应式更新，同行内灰角标教训）。
   */
  function bubbleCls(msg: ImMsgRow): string {
    let cls = isMine(msg) ? "chat-bubble--mine" : "";
    if (pressTouchId.value == `b-${msg.msgId}`) {
      cls = cls.length > 0 ? `${cls} chat-bubble--active` : "chat-bubble--active";
    }
    return cls;
  }

  function isSameChatDay(a: Date, b: Date): boolean {
    return a.getFullYear() == b.getFullYear() && a.getMonth() == b.getMonth() && a.getDate() == b.getDate();
  }

  function pad2(v: number): string {
    return v < 10 ? `0${v}` : `${v}`;
  }

  /** 点消息内容展开的时间：今天 HH:mm:ss / 昨天 / 同年 M月D日 / 跨年带年（对齐列表页 formatConvTime 格式，带秒）。 */
  function formatMsgTime(ts: number): string {
    if (ts <= 0) {
      return "";
    }
    const date = new Date(ts);
    const hms = pad2(date.getHours()) + ":" + pad2(date.getMinutes()) + ":" + pad2(date.getSeconds());
    const now = new Date();
    if (isSameChatDay(date, now)) {
      return hms;
    }
    const yesterday = new Date(now.getTime() - 86400000);
    if (isSameChatDay(date, yesterday)) {
      return t("Mobile.Message.yesterday") + " " + hms;
    }
    if (date.getFullYear() == now.getFullYear()) {
      return `${date.getMonth() + 1}月${date.getDate()}日 ${hms}`;
    }
    return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日 ${hms}`;
  }

  /** 时间分割线阈值：飞书同款 5 分钟。 */
  const TIME_DIVIDER_GAP_MS = 5 * 60 * 1000;

  /** 时间分割线文案（飞书式分级，不带秒）：今天 HH:mm / 昨天 / 7 天内周X / 同年 M月D日 / 跨年带年。 */
  function formatDividerTime(ts: number): string {
    const date = new Date(ts);
    const hm = pad2(date.getHours()) + ":" + pad2(date.getMinutes());
    const now = new Date();
    if (isSameChatDay(date, now)) {
      return hm;
    }
    const yesterday = new Date(now.getTime() - 86400000);
    if (isSameChatDay(date, yesterday)) {
      return t("Mobile.Message.yesterday") + " " + hm;
    }
    if (now.getTime() - ts < 7 * 86400000) {
      return t(`Mobile.Message.weekday${date.getDay()}`) + " " + hm;
    }
    if (date.getFullYear() == now.getFullYear()) {
      return `${date.getMonth() + 1}月${date.getDate()}日 ${hm}`;
    }
    return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日 ${hm}`;
  }

  /** 行首时间分割线：首条 / 跨天 / 与上一条间隔超 5 分钟才出（上一条时间未知时保守出线锚定）。 */
  function dividerTimeOf(index: number): string {
    const rows = messages.value;
    if (index < 0 || index >= rows.length) {
      return "";
    }
    const cur = rows[index];
    if (cur.sendTime <= 0) {
      return "";
    }
    if (index > 0) {
      const prev = rows[index - 1];
      if (prev.sendTime > 0) {
        const sameDay = isSameChatDay(new Date(prev.sendTime), new Date(cur.sendTime));
        if (sameDay && cur.sendTime - prev.sendTime <= TIME_DIVIDER_GAP_MS) {
          return "";
        }
      }
    }
    return formatDividerTime(cur.sendTime);
  }

  /** 已读徽标按压 class（群聊可点徽标的点按反馈）。 */
  function pressedReadCls(msgId: string): string {
    return pressTouchId.value == `r-${msgId}` ? "chat-read--active" : "";
  }

  /**
   * 动作当前状态：state 缺失 ⇒ pending（可点——历史/纯展示卡服务端不回填，最常见，
   * 读成"不许点"会让线上所有按钮一夜变灰）；有值但不认识 ⇒ unknown（fail-closed
   * 不可点：给一个点了必报错的按钮是 UI 缺陷）。缺失=服务端没意见，未知=没听懂。
   */
  function cardActionStateOf(action: ImCardAction): string {
    if (action.state.length == 0) {
      return "pending";
    }
    return KNOWN_CARD_STATES.indexOf(action.state) >= 0 ? action.state : "unknown";
  }

  /** 只有 pending 能点（done/stale/forbidden/unknown 一律置灰；★别拿它猜业务，"过没过"只有服务端知道）。 */
  function cardActionClickable(action: ImCardAction): boolean {
    return cardActionStateOf(action) == "pending";
  }

  /**
   * 按钮区可见集：★整卡全部不可点（单据终态/失效/无权——服务端按单据给同卡
   * 按钮回填同一状态与文案）时只显示第一个，避免并排两个相同文案的置灰按钮；
   * 只要有按钮可点（含点击请求在途：另一按钮仍 pending）就全量展示。
   */
  function cardVisibleActions(msg: ImMsgRow): ImCardAction[] {
    const actions = msg.cardActions;
    if (actions.length == 0) {
      return actions;
    }
    let anyClickable = false;
    for (let i = 0; i < actions.length; i++) {
      if (cardActionClickable(actions[i])) {
        anyClickable = true;
        break;
      }
    }
    if (anyClickable) {
      return actions;
    }
    return [actions[0]];
  }

  /**
   * 按钮文字：pending=label（不看 stateText，万一有值也不能顶掉按钮名字）；
   * 其余优先服务端给定的 stateText（服务端改口径前端不发版），缺失按状态回落固定文案。
   */
  function cardActionText(action: ImCardAction): string {
    const state = cardActionStateOf(action);
    if (state == "pending") {
      return action.label;
    }
    const given = action.stateText.trim();
    if (given.length > 0) {
      return given;
    }
    if (state == "done") {
      return t("Mobile.Message.cardStateDone");
    }
    if (state == "stale") {
      return t("Mobile.Message.cardStateStale");
    }
    if (state == "forbidden") {
      return t("Mobile.Message.cardStateForbidden");
    }
    return t("Mobile.Message.cardStateUnknown");
  }

  /** 按钮配色：style 只影响配色不影响语义；未知取值按 default 画（服务端加配色不打挂老客户端）。 */
  function cardBtnClass(msg: ImMsgRow, action: ImCardAction): string {
    let cls = "";
    // 执行中（防连点）与不可点同用置灰观感，文字仍是 label（读作"处理中"）
    if (cardBusyKey.value == action.key || cardActionClickable(action) != true) {
      cls = "chat-card__btn chat-card__btn--disabled";
    } else if (action.style == "primary") {
      cls = "chat-card__btn chat-card__btn--primary";
    } else if (action.style == "danger") {
      cls = "chat-card__btn chat-card__btn--danger";
    } else {
      cls = "chat-card__btn chat-card__btn--default";
    }
    // 按压中给按压反馈（触摸自驱，替代 hover-class）
    if (pressTouchId.value == `c-${msg.msgId}-${action.key}`) {
      cls += " chat-card__btn--active";
    }
    return cls;
  }

  function cardBtnTextClass(action: ImCardAction): string {
    if (cardBusyKey.value == action.key || cardActionClickable(action) != true) {
      return "chat-card__btn-text chat-card__btn-text--disabled";
    }
    if (action.style == "primary") {
      return "chat-card__btn-text chat-card__btn-text--on";
    }
    return "chat-card__btn-text";
  }

  /**
   * 点击卡片动作按钮：POST msgRunAction（只回传 key；★不弹二次确认——卡片的存在
   * 意义就是"在通知里一步办完"，照微信/钉钉群邀请卡）。返回 CardActionState 就地
   * 合并回该按钮（不必重拉整条消息）；★forbidden/stale 是状态不是错误（HTTP 仍
   * 200），就地置灰不弹错——弹红条反而像"系统坏了"。成功也不 toast：按钮就地
   * 变成「已通过/已拒绝」本身就是最好的反馈。
   */
  async function handleCardActionTap(msg: ImMsgRow, action: ImCardAction): Promise<void> {
    if (pageTapSwallowed() || cardActionClickable(action) != true) {
      return;
    }
    if (cardBusyKey.value.length > 0 || isConfirmedRow(msg) != true) {
      return;
    }
    cardBusyKey.value = action.key;
    try {
      const res = await apiImMsgRunAction(msg.msgId, convId.value, action.key);
      if (!isChatCurrent()) return;
      cardBusyKey.value = "";
      if (apiResCode(res) != SUCCESS_CODE) {
        // 真失败（消息没了/不是卡片/网络）：与 PC 失败口径一致，toast 提示
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      // 200：就地合并新状态到被点按钮，并联动同卡其余 pending 按钮（服务端未给
      // state 字段时按空串存 ⇒ 判据回落 pending）。★联动的口径与读路径一致：
      // 服务端回填是按单据状态给整张卡的按钮同一终态文案（单子终态后同意/
      // 拒绝都显示「已通过该入群申请」），点击瞬间就地模拟同一结果——否则
      // 「点完同意拒绝还亮着」，用户再点虽被服务端幂等挡住无副作用，但界面该收口。
      const dataRaw = apiResData<any>(res);
      const stateObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      const newState = stateObj != null ? readString(stateObj, "state") : "";
      const newText = stateObj != null ? readString(stateObj, "text") : "";
      const actions = msg.cardActions;
      for (let i = 0; i < actions.length; i++) {
        if (actions[i].key == action.key || cardActionStateOf(actions[i]) == "pending") {
          actions[i].state = newState;
          actions[i].stateText = newText;
        }
      }
    } catch (_error) {
      cardBusyKey.value = "";
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  // ===== 会话能力加载（convDetail / pins / whoami；失败静默保留默认值） =====

  /** 群会话：拉 myRole 与治理开关（allowMemberPin/readReceiptOn 键缺省/null = 不限制）。 */
  async function loadConvInfo(): Promise<void> {
    if (isGroupLike.value != true || convId.value.length == 0) {
      return;
    }
    try {
      const res = await apiImConvDetail(convId.value);
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj != null) {
          myRole.value = readNumber(dataObj, "myRole", 1);
          // status：1=正常 2=已解散（服务端软状态，成员查询仍返回但带 status=2）
          convDisbanded.value = readNumber(dataObj, "status", 1) == 2;
          const pinRaw = dataObj["allowMemberPin"];
          allowMemberPin = pinRaw == null ? true : `${pinRaw}` == "true";
          const receiptRaw = dataObj["readReceiptOn"];
          readReceiptOn = receiptRaw == null ? true : `${receiptRaw}` == "true";
        }
      }
    } catch (_error) {
      // 静默：拿不到就按默认能力渲染，服务端仍兜底校验权限
    }
  }

  /** 拉当前置顶集（多人共享且无下行通知：进页/撤回后/Pin 后重拉自我纠正；含 pinBy 供署名行）。 */
  async function loadPinnedIds(): Promise<void> {
    if (convId.value.length == 0) {
      return;
    }
    try {
      const res = await apiImConvPins(convId.value);
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const arr = dataRaw != null ? (dataRaw as UTSJSONObject[]) : null;
        const pins: ImPinInfo[] = [];
        if (arr != null) {
          for (let i = 0; i < arr.length; i++) {
            const id = readString(arr[i], "msgId");
            if (id.length > 0) {
              const info = new ImPinInfo();
              info.msgId = id;
              info.pinBy = readString(arr[i], "pinBy");
              pins.push(info);
            }
          }
        }
        pinnedPins.value = pins;
      }
    } catch (_error) {
      // 失败保留旧集（仅影响菜单文案切换，服务端仍兜底校验）
    }
  }

  /** 拉撤回时限（whoami.revokeWindowSec；失败保留默认 24h）。 */
  async function loadRevokeWindow(): Promise<void> {
    try {
      const res = await apiImWhoami();
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj != null) {
          const windowSec = readNumber(dataObj, "revokeWindowSec", 0);
          if (windowSec > 0) {
            revokeWindowSec = windowSec;
          }
        }
      }
    } catch (_error) {
      // 静默：保留默认窗口
    }
  }

  // ===== 已读状态（read-status 批量查询，只查自己发的消息） =====

  const readInfoIndex = computed<Map<string, ImReadInfo>>((): Map<string, ImReadInfo> => {
    const index = new Map<string, ImReadInfo>();
    for (let i = 0; i < readInfos.value.length; i++) index.set(readInfos.value[i].msgId, readInfos.value[i]);
    return index;
  });

  function findReadInfo(msgId: string): ImReadInfo | null {
    return readInfoIndex.value.get(msgId) ?? null;
  }

  /** 按 msgId 对齐合并（结果可能少于请求——别人的消息静默消失，顺序不保证，勿按下标）。
   *  ★已有条目用 splice 整体替换、绝不就地改属性：App-Android 对 UTS class 实例的
   *  属性赋值不触发视图更新（web 端靠 ref 深代理才有响应）——2026-09-29 Android 群
   *  已读不更新实锤：merge 已拿到 readCount=1、icon 停旧值；push/ splice 数组变异
   *  才触发重渲染（同 messages.value 的 replaceByClientMsgId 口径）。
   *  ★★但数组变异只救「直接属性绑定」——已读 icon 的模板绑定是方法调用，App-Android
   *  连数组变异都不触发（同日实锤），变更后必须再 bumpReadInfoTick()（见 readInfoTick
   *  声明处注释），否则数据换新、视图照旧冻结。 */
  function mergeReadInfo(obj: UTSJSONObject): void {
    const msgId = readString(obj, "msgId");
    if (msgId.length == 0) {
      return;
    }
    const readCount = readNumber(obj, "readCount", 0);
    const eligibleCount = readNumber(obj, "eligibleCount", 0);
    const readAll = readBool(obj, "readAll");
    const infos = readInfos.value;
    for (let i = 0; i < infos.length; i++) {
      if (infos[i].msgId == msgId) {
        const updated = new ImReadInfo();
        updated.msgId = msgId;
        updated.readCount = readCount;
        updated.eligibleCount = eligibleCount;
        updated.readAll = readAll;
        infos.splice(i, 1, updated);
        bumpReadInfoTick();
        return;
      }
    }
    const info = new ImReadInfo();
    info.msgId = msgId;
    info.readCount = readCount;
    info.eligibleCount = eligibleCount;
    info.readAll = readAll;
    readInfos.value.push(info);
    bumpReadInfoTick();
  }

  /**
   * 该行是否渲染已读 icon：仅我发的、已确认、未撤回的正式消息；
   * 群聊关闭「已读回执」后不展示（单聊无此开关）。★「没查到」≠「未读」——
   * 无数据不渲染 icon（宁缺勿错），别拿 0/0 误导用户。
   * ★尾参 _tick（模板传 readInfoTick，脚本调用传 0，函数体不用）：只为让模板
   * 绑定表达式直接读响应式 ref 建立依赖，见 readInfoTick 声明处注释。
   */
  function readInfoOf(msg: ImMsgRow, _tick: number): ImReadInfo | null {
    if (isMine(msg) != true || msg.status != 1 || msg.revoked || isConfirmedRow(msg) != true) {
      return null;
    }
    if (isGroupLike.value && readReceiptOn != true) {
      return null;
    }
    return findReadInfo(msg.msgId);
  }

  /** 仅模板用：圆点实心判定（群=readAll；单聊同一语义，对方已读即 readAll）。 */
  function readAllOf(msg: ImMsgRow, _tick: number): boolean {
    const info = readInfoOf(msg, 0);
    return info != null && info.readAll;
  }

  /** 仅模板用：已读人数（单聊已读判定 readCount >= 1）。 */
  function readCountOf(msg: ImMsgRow, _tick: number): number {
    const info = readInfoOf(msg, 0);
    return info == null ? 0 : info.readCount;
  }

  /** 仅模板用：已读扇形度数（0~360，扇形面积=已读占比动态计算）。 */
  function readPieDegOf(msg: ImMsgRow, _tick: number): number {
    const info = readInfoOf(msg, 0);
    if (info == null || info.eligibleCount <= 0) {
      return 0;
    }
    const deg = Math.floor((360 * info.readCount) / info.eligibleCount);
    if (deg < 0) {
      return 0;
    }
    return deg > 360 ? 360 : deg;
  }

  /** 仅模板用：右半扇形旋转角（0~180° 顺时针，>180 固定满半）；渲染由 v-if 门控。 */
  function pieRightStyleOf(msg: ImMsgRow, _tick: number): string {
    const deg = readPieDegOf(msg, 0);
    const rot = deg > 180 ? 180 : deg;
    return `transform: rotate(${rot}deg);`;
  }

  /** 仅模板用：左半扇形旋转角（180° 起续转补足）；渲染由 v-if（deg > 180）门控。 */
  function pieLeftStyleOf(msg: ImMsgRow, _tick: number): string {
    const deg = readPieDegOf(msg, 0);
    return `transform: rotate(${deg - 180}deg);`;
  }

  /** 仅模板用：群聊点击已读计数 → 「消息阅读状态」页（单聊圆点不可点）。 */
  function handleReadTap(msg: ImMsgRow): void {
    if (pageTapSwallowed()) {
      return;
    }
    const info = readInfoOf(msg, 0);
    if (info == null || isGroupLike.value != true || convId.value.length == 0) {
      return;
    }
    uni.navigateTo({
      url:
        `/subpackages/pages/im-msg-read-status/im-msg-read-status?convId=${convId.value}` +
        `&msgId=${msg.msgId}&seq=${msg.seq}` +
        `&readCount=${info.readCount}&eligibleCount=${info.eligibleCount}`,
    });
  }

  /**
   * 批量刷新我发消息的已读计数（msgIds ≤200/批，超限服务端直接抛错不截断）：
   * 只查「无缓存 || 未 readAll」的增量集，按 seq 降序取最新 200——更早的行不渲染
   * icon（见 readInfoOf 注释），不做多批循环；请求序号防旧响应覆盖新数据。
   */
  async function refreshReadStatus(): Promise<void> {
    if (!isChatActive()) return;
    if (convId.value.length == 0 || myUserId.value.length == 0 || messages.value.length == 0) {
      return;
    }
    const candidates: ImMsgRow[] = [];
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      if (isMine(row) != true || row.status != 1 || row.revoked || isConfirmedRow(row) != true) {
        continue;
      }
      if (isGroupLike.value && readReceiptOn != true) {
        continue;
      }
      const cached = findReadInfo(row.msgId);
      if (cached != null && cached.readAll) {
        continue;
      }
      candidates.push(row);
    }
    if (candidates.length == 0) {
      return;
    }
    // rows 本身按时间升序：从尾部往前取即 seq 降序的最新 200 条
    const picked: string[] = [];
    for (let i = candidates.length - 1; i >= 0 && picked.length < 200; i--) {
      picked.push(candidates[i].msgId);
    }
    const seq = ++readStatusSeq;
    try {
      const res = await apiImReadStatus(convId.value, picked);
      if (!isChatCurrent()) return;
      if (!isChatCurrent() || seq != readStatusSeq) {
        return;
      }
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const arr = dataRaw != null ? (dataRaw as UTSJSONObject[]) : null;
        if (arr != null) {
          for (let i = 0; i < arr.length; i++) {
            mergeReadInfo(arr[i]);
          }
        }
      }
    } catch (_error) {
      // 静默：onShow/下次发送确认会再试
    }
  }

  /** READ_NOTIFY 帧触发的已读重查去抖定时器 + 「窗口期又来帧」尾随标记。 */
  let readRefreshTimer = 0;
  let readRefreshOwed = false;

  /**
   * 已读回执帧 → 去抖重查（PC lib/readRefreshScheduler.ts 同款：前沿 300ms 窗口 +
   * 尾随一轮）。群里每有一个人读到新位置就发一帧，「大家都读了」会连着来好几帧 ——
   * 逐帧都查一次 read-status 是把 O(1) 的界面更新放大成 O(人数) 的请求；窗口内
   * 只留一次，窗口期来过新帧则到点后补一轮（保证最后一帧之后必有一次为它发起的查询）。
   */
  function scheduleReadRefresh(): void {
    if (!isChatActive()) return;
    if (readRefreshTimer != 0) {
      readRefreshOwed = true;
      return;
    }
    readRefreshTimer = setTimeout(() => {
      readRefreshTimer = 0;
      const owed = readRefreshOwed;
      readRefreshOwed = false;
      refreshReadStatus();
      if (owed) {
        scheduleReadRefresh();
      }
    }, 300);
  }

  /** 「落定」重查定时器（见 scheduleReadSettle 注释）。 */
  let readSettleTimer = 0;

  /**
   * 已读回执「落定」重查兜底（2026-09-29 Android 群已读不实时排查期新增；根因实为
   * 模板绑定不收集方法体内依赖，已由 readInfoTick 修复，本重查保留为兜底）：4001 帧
   * 无存储转发，防抖尾随只覆盖「窗口期来帧」——若最后一次真实阅读发生在防抖查询之后
   * 且再无新帧（如读者侧聚合滞后），icon 会停旧值。READ_NOTIFY 后 1.5s 补一次重查；
   * 已有落定查询在途则不叠加（阅读帧 ms 级连发共享一次即可），onUnload 与防抖
   * 定时器一并清理。单聊走本地水位直推（无查询无滞后），不经此路径。
   */
  function scheduleReadSettle(): void {
    if (readSettleTimer != 0) {
      return;
    }
    readSettleTimer = setTimeout(() => {
      readSettleTimer = 0;
      refreshReadStatus();
    }, 1500);
  }

  function replaceByClientMsgId(confirmed: ImMsgRow): void {
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].clientMsgId.length > 0 && rows[i].clientMsgId == confirmed.clientMsgId) {
        rows.splice(i, 1, confirmed);
        return;
      }
    }
    // 占位已被清掉（如刷新重载）：幂等重放时补插，避免消息丢失
    rows.push(confirmed);
  }

  function markRowFailed(clientMsgId: string): void {
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].clientMsgId == clientMsgId) {
        rows[i].status = 2;
        return;
      }
    }
  }

  /**
   * 禁言拒发（IM_30002 我被禁言 / IM_30003 全员禁言中）：乐观行直接 splice 移除，
   * 不落失败态——失败态引导「点击重试」，禁言重试必再失败，留在列表里只会误导
   * （且服务端本就没落库，重进会话后也看不到这条）；toast 服务端消息说明原因。
   * 返回 true=已按禁言处理（调用方直接 return，勿再 markRowFailed）。
   */
  function handleMuteRejection(res: RequestResponse<any> | null, clientMsgId: string): boolean {
    const code = apiResCode(res);
    if (code != "IM_30002" && code != "IM_30003") {
      return false;
    }
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].clientMsgId == clientMsgId) {
        rows.splice(i, 1);
        break;
      }
    }
    const message = apiResMessage(res);
    uni.showToast({ title: message.length > 0 ? message : t("Mobile.Message.sendFailed"), icon: "none" });
    return true;
  }

  function findRowByClientMsgId(clientMsgId: string): ImMsgRow | null {
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].clientMsgId == clientMsgId) {
        return rows[i];
      }
    }
    return null;
  }

  function maxSeq(): number {
    let seq = 0;
    for (let i = 0; i < messages.value.length; i++) seq = Math.max(seq, messages.value[i].seq);
    return seq;
  }

  let readReportTimer = 0;
  let readReportRunning = false;
  let wantedReadSeq = 0;

  async function flushReadReport(): Promise<void> {
    if (!isChatActive() || readReportRunning) return;
    readReportRunning = true;
    try {
      while (isChatActive() && wantedReadSeq > reportedReadSeq) {
        const seq = wantedReadSeq;
        const res = await apiImReadReport(convId.value, seq);
        if (!isChatCurrent() || apiResCode(res) != SUCCESS_CODE) return;
        reportedReadSeq = Math.max(reportedReadSeq, seq);
        refreshImUnreadBadge();
      }
    } catch (_e) {
      // 失败不推进水位；下一次来消息/回前台会重试同一水位。
    } finally {
      readReportRunning = false;
    }
  }

  /** 合并相邻消息/补拉/页面恢复的水位；只有服务端成功才推进本地确认值。 */
  function reportReadIfNeeded(seq: number): void {
    if (!isChatActive() || seq <= reportedReadSeq || seq <= 0) return;
    wantedReadSeq = Math.max(wantedReadSeq, seq);
    if (readReportRunning || readReportTimer != 0) return;
    readReportTimer = setTimeout(() => {
      readReportTimer = 0;
      flushReadReport();
    }, 150);
  }

  /** 距底余量阈值（px）：离开时距底小于该值视为「在底部」，进页直接滚最新。 */
  const NEAR_BOTTOM_PX = 120;

  // ===== 「回到底部」浮钮（读历史时出现，点击滚到最新） =====
  // ★须定义在 scrollToAnchorWithSettle 之前（UTS 不提升声明，定位落定回调里要调
  //   scheduleJumpLatestCheck 校准浮钮；handleJumpLatest 因引用 scrollToBottom
  //   挪到其后定义）。
  const showJumpLatest = ref<boolean>(false);
  /** 贴底态（距底 ≤ NEAR_BOTTOM_PX）：WS 实时新消息到达仅在贴底时才自动滚底——
   *  在读历史不打扰（不拽走阅读位置，靠「回到底部」浮钮回最新）；与浮钮 200px
   *  亮钮阈值构成迟滞带，避免临界抖动。初值 true：进页即在底，首个探测前不误拦。 */
  const nearChatBottom = ref<boolean>(true);
  /** 触发展示阈值（px）：距底余量超过该值才算「在读历史」——略大于 NEAR_BOTTOM_PX，
   *  避免贴底微滚/回弹就闪钮。 */
  const JUMP_LATEST_TRIGGER_PX = 200;
  let jumpLatestCheckTimer = 0;

  /** 距底探测：与 saveScrollMemo 同款 boundingClientRect 方案——scrollOffset
   *  族查询真机实测 App 端拿不到值；键盘/面板展开时视口整体平移，两组矩形同处
   *  平移后坐标系，差值仍有效，照常探测。★须定义在 scheduleJumpLatestCheck 之前
   *  （UTS 不提升声明，error18：定时器回调体里的调用同样要求先定义）。 */
  function checkJumpLatest(): void {
    if (!isChatCurrent() || multiSelectMode.value || messages.value.length == 0 || listSettled.value != true) {
      return;
    }
    const query = uni.createSelectorQuery();
    query.select(".chat-body").boundingClientRect();
    query.select("#chat-bottom").boundingClientRect();
    query.exec((results: Array<any>) => {
      if (!isChatCurrent() || multiSelectMode.value) return;
      if (results.length < 2 || results[0] == null || results[1] == null) return;
      const bodyRect = results[0] as NodeInfo;
      const endRect = results[1] as NodeInfo;
      if (bodyRect.top == null || bodyRect.height == null || endRect.top == null) return;
      // 距底余量 = 底部锚点 top（视口坐标）- 滚动区可视底缘：在读历史为正，贴底 ≈ 0
      const distBottom = parseFloat(`${endRect.top}`) - (parseFloat(`${bodyRect.top}`) + parseFloat(`${bodyRect.height}`));
      showJumpLatest.value = distBottom > JUMP_LATEST_TRIGGER_PX;
      nearChatBottom.value = distBottom <= NEAR_BOTTOM_PX;
    });
  }

  /** 节流式排队一次距底探测（已有在途则不叠加）：长按滚动过程中也能周期性亮/灭浮钮，
   *  不是只等滚动停稳。 */
  function scheduleJumpLatestCheck(delay: number): void {
    if (jumpLatestCheckTimer != 0) return;
    jumpLatestCheckTimer = setTimeout(() => {
      jumpLatestCheckTimer = 0;
      checkJumpLatest();
    }, delay);
  }

  /**
   * 锚点定位 + 稳定重定位 + 揭幕（滚底 / 阅读位置恢复共用）。
   * App 端原生布局异步完成：一拍 nextTick 后 scroll-into-view 可能仍早于内容
   * 高度稳定（首屏整页消息/卡片渲染时定位失效，系统通知页全是卡片最明显）——
   * 再补一拍延时清空重设同一锚点，强制 scroll-view 重新定位。期间锚点被其它
   * 滚动逻辑改走（如翻页定位 msg-*）则不抢。遮蔽期（listSettled=false）内
   * 全部跳变不可见，定位稳定后揭幕。
   */
  function cancelSettle(): void {
    settleVersion += 1;
    if (settleTimer != 0) {
      clearTimeout(settleTimer);
      settleTimer = 0;
    }
  }

  function scrollToAnchorWithSettle(anchorId: string): void {
    cancelSettle();
    if (!isChatActive()) {
      deferredAnchor = anchorId;
      return;
    }
    deferredAnchor = "";
    const version = settleVersion;
    scrollAnchor.value = "";
    nextTick(() => {
      if (!isChatActive() || version != settleVersion) return;
      scrollAnchor.value = anchorId;
      settleTimer = setTimeout(() => {
        settleTimer = 0;
        if (!isChatActive() || version != settleVersion) return;
        if (scrollAnchor.value == anchorId) {
          scrollAnchor.value = "";
          nextTick(() => {
            if (!isChatActive() || version != settleVersion) return;
            scrollAnchor.value = anchorId;
            listSettled.value = true;
            // 程序化定位不必然派发 @scroll：落定后主动校准浮钮（滚底→藏，恢复历史位→亮）
            scheduleJumpLatestCheck(60);
          });
        } else {
          listSettled.value = true;
          scheduleJumpLatestCheck(60);
        }
      }, 150);
    });
  }

  function scrollToBottom(): void {
    scrollToAnchorWithSettle("chat-bottom");
  }

  /** 浮钮点击：滚到最新消息并藏钮（定位被抢/失败时滚动事件会再探测复位）。 */
  function handleJumpLatest(): void {
    if (pageTapSwallowed()) return;
    showJumpLatest.value = false;
    scrollToBottom();
  }

  // ===== Android 键盘高度兜底（WindowInsets 轮询） =====
  // 部分 Android 机型/自定义基座从子页（如 @ 成员选择）返回后 uni.onKeyboardHeightChange
  // 不再派发（conversation-input / agent-detail 同款已知问题）：表现为键盘弹出但输入坞
  // 不让位被盖住。聚焦/展开面板期间直接轮询 WindowInsets 的 IME 高度驱动同一套让位逻辑，
  // 读数归零即视为键盘已收（BACK 只收 IME 不失焦场景），与事件回调互为冗余、幂等无害。

  /** Android IME 轮询定时器（0=无待执行；非 Android 平台不启动）。 */
  let androidImePollTimer: number = 0;

  /** 直读 IME insets 高度（CSS px）；仅 APP-ANDROID 有实现，其余平台恒 0。 */
  function readAndroidImeHeight(): number {
    // #ifdef APP-ANDROID
    try {
      const activity = UTSAndroid.getUniActivity();
      if (activity == null) return 0;
      const win = activity.getWindow();
      if (win == null) return 0;
      const decor = win.getDecorView();
      if (decor == null) return 0;
      const insets = decor.getRootWindowInsets();
      if (insets == null) return 0;
      const ime = insets.getInsets(8);
      if (ime == null || ime.bottom <= 0) return 0;
      const height = UTSAndroid.devicePX2px(ime.bottom);
      return height > 0 ? height : 0;
    } catch (_error) {
      return 0;
    }
    // #endif
    return 0;
  }

  /**
   * 键盘高度落地（onKeyboardHeightChange / Android 轮询 / 预测驱动共用）：
   * 刚体平移让位（liftPx）+ 互斥面板切回键盘态。source："event"=系统回调/轮询真值
   * （iOS/鸿蒙回写缓存），"predict"=focus/blur/setPanel 等抢先落地（不回写，真值到达即校正）。
   */
  function applyKeyboardHeight(height: number, source: string): void {
    keyboardHeight.value = height;
    clearKbWatchdog();
    if (height > 0) {
      // 键盘升起覆盖面板（飞书式）：清互斥面板让 liftPx 立即切到键盘高度，表情/加号槽
      // 留在平移层底缘之下被键盘盖住而非卸载。格式横条与键盘共存不清；展开面板内嵌面板同样收掉。
      if (panelMode.value != "font") {
        panelMode.value = "";
      }
      if (expandPanel.value.length > 0) {
        expandPanel.value = "";
      }
      // 仅 iOS/鸿蒙回写缓存（agent-detail/resident-shell 的 Android 写入方会叠加 safeBottom，
      // 语义不一致不跨平台共享；Android 让位由 insets 轮询兜底已足够快）
      // #ifdef APP-IOS || APP-HARMONY
      if (source == "event") {
        kbLastHCache = height;
        try {
          // 存原值不取整：取整会让缓存与真值恒差零头，预抬后必触发一次校正微跳
          uni.setStorageSync("NUWAX_KB_LAST_H", height);
        } catch (_e) {
          // ignore
        }
      }
      // #endif
    }
  }

  /* ★armKbWatchdog / scheduleIosKbApply 声明在 applyKeyboardHeight 之后（UTS 不提升
     声明，error18）：两者回调体引用它；其调用点（focus 预测预抬 / iOS 键盘事件分发）
     均在本处之后，定义下移不影响绑定。 */
  function armKbWatchdog(): void {
    kbPredictConfirmed = false;
    if (kbWatchdogTimer != 0) {
      clearTimeout(kbWatchdogTimer);
    }
    kbWatchdogTimer = setTimeout((): void => {
      kbWatchdogTimer = 0;
      if (kbPredictConfirmed != true && keyboardHeight.value > 0) {
        // 预抬落空（外接键盘/焦点被抢且无键盘回调）：回落让位防幽灵空白。
        // 窗口须 > 真实事件延迟：iOS 终值事件实测在 focus-predict 后 +515~524ms 才派发
        //（含键盘动画+派发排队），500ms 会在终值前 20ms 抢跑回落 → 让位先落后弹（2026-10-01
        // 诊断浮屏实测）；取 900ms 留余量，外接键盘幽灵回落最多多等 400ms，可接受
        applyKeyboardHeight(0, "predict");
      }
    }, 900);
  }

  /**
   * iOS 键盘高度事件 70ms 尾随去抖：iOS 端 onKeyboardHeightChange 在动画沿可能逐次派发
   * 中间高度+终值（2026-10-01 真机实测「拉起后页面抖动一下」），逐次落地会让平移反复改向；
   * 收敛到终值一次性落地（起步同步由 focus 预测预抬承担，不受此延迟影响）。
   *
   * 升起沿还有「两段派发」：键盘动画早期帧的假高度先到（真机实测仅 75px），动画结束的
   * 终值后到，间隔可达 370ms——远超 70ms 去抖窗。预测预抬已按上次终值抬高，较矮中间值
   * 若直接落地 = 让位先落（下滚）再被终值抬回（上滚），真机「顶上去后下滚再上滚、
   * 终值正确」即此（2026-10-01 诊断浮屏实测：hold 260ms 到期落地 75，39ms 后终值 345 才到）。
   * 处置：升起态（双方均>0）收到比当前矮的值视为动画中间帧，缓 500ms 落地（>实测 370ms
   * 间隔留余量）；期间终值到达自然取代（相等值在事件入口去重分支撤缓、更高值走主路径
   * 撤缓）；缓期结束仍停在上次终值才落地矮值（键盘确实更矮，如切了键盘类型），单次平滑
   * 校正。真实事件到达即证明键盘存在：进缓时同步清预测看门狗（否则预测落地后到终值
   * 到达前无任何 apply，看门狗会把让位整个打回 0，反而制造更大弹跳）。
   */
  function scheduleIosKbApply(height: number): void {
    if (iosKbDebounceTimer != 0) {
      clearTimeout(iosKbDebounceTimer);
    }
    iosKbDebounceTimer = setTimeout((): void => {
      iosKbDebounceTimer = 0;
      if (height > 0 && keyboardHeight.value > 0 && height < keyboardHeight.value) {
        cancelIosKbShortHold();
        clearKbWatchdog();
        iosKbShortHoldTimer = setTimeout((): void => {
          iosKbShortHoldTimer = 0;
          // 仍高于缓存矮值 = 期间无终值落地（键盘确实只有这么矮）：此刻才落地
          if (keyboardHeight.value > height) {
            applyKeyboardHeight(height, "event");
          }
        }, 500);
        return;
      }
      cancelIosKbShortHold();
      if (height != keyboardHeight.value) {
        applyKeyboardHeight(height, "event");
      } else {
        clearKbWatchdog();
      }
    }, 70);
  }

  function stopAndroidImePolling(): void {
    if (androidImePollTimer != 0) {
      clearTimeout(androidImePollTimer);
      androidImePollTimer = 0;
    }
  }

  function pollAndroidImeHeight(): void {
    androidImePollTimer = 0;
    const height = readAndroidImeHeight();
    // 与事件回调读数一致时不动（事件正常的机型零开销）；不一致 = 事件丢了，轮询接管
    if (height != keyboardHeight.value) {
      applyKeyboardHeight(height, "event");
    }
    // 输入坞聚焦 / 展开面板开着 / 键盘 believed 开着（blur 后收起动画中）才持续轮询；
    // 恒 100ms 节拍兼顾收起沿检测（让位下落与键盘收起尽量同步），归零且无聚焦后下一拍自停
    if (inputFocused.value || expanded.value || keyboardHeight.value > 0) {
      const nextDelay = 100;
      androidImePollTimer = setTimeout((): void => {
        pollAndroidImeHeight();
      }, nextDelay);
    }
  }

  function startAndroidImePolling(): void {
    // #ifdef APP-ANDROID
    stopAndroidImePolling();
    // 聚焦瞬间先校准：IME 实际未开而残留旧值时清零，避免输入坞跳到上一轮高度
    if (keyboardHeight.value > 0 && readAndroidImeHeight() <= 0) {
      applyKeyboardHeight(0, "event");
    }
    androidImePollTimer = setTimeout((): void => {
      pollAndroidImeHeight();
    }, 60);
    // #endif
  }

  /** onShow 让位校准定时器（0=无待执行；仅 Android 使用）。 */
  let androidImeCalibTimer: number = 0;

  /**
   * Android 从子页返回后的残留让位校准（onShow 调，其余平台空实现）：
   * 点 @ 键走 hideKeyboard + navigateTo，blur 已停轮询，而收起沿的
   * onKeyboardHeightChange 在部分机型不派发（见上），keyboardHeight 残留旧值
   * 会让输入坞下方留出一块「键盘空白」。直读 insets：IME 实际已收则清零让位；
   * 仍在收起动画（读数 >0）时延迟一拍再校，读数归零即自终止。
   */
  function calibrateAndroidImeAfterShow(): void {
    // #ifdef APP-ANDROID
    // 已聚焦/展开面板时轮询链路接管让位，校准退位（@ 选完返回自动拉键盘场景防双驱）
    if (pageVisible != true || keyboardHeight.value <= 0 || inputFocused.value || expanded.value) {
      return;
    }
    if (readAndroidImeHeight() <= 0) {
      applyKeyboardHeight(0, "event");
      return;
    }
    if (androidImeCalibTimer == 0) {
      androidImeCalibTimer = setTimeout((): void => {
        androidImeCalibTimer = 0;
        calibrateAndroidImeAfterShow();
      }, 350);
    }
    // #endif
  }

  /**
   * 离开页面（返回/进子页/切后台）时记忆阅读位置：首可见行 msgId + 距底余量。
   * ★不依赖 scrollOffset/fields 取 scrollTop——真机实测该族查询在 App 端
   *   拿不到字段值；只用 boundingClientRect 的
   *   top/height（视口坐标实时值）判定首可见行，恢复侧直接锚定该行。
   * 键盘/面板展开时视口高度失真，跳过本次记忆（保留上次有效值）。
   */
  function saveScrollMemo(): void {
    if (!isChatCurrent() || convId.value.length == 0 || messages.value.length == 0 || listSettled.value != true) {
      return;
    }
    if (keyboardHeight.value > 0 || panelMode.value.length > 0 || expandPanel.value.length > 0) {
      return;
    }
    const query = uni.createSelectorQuery();
    query.select(".chat-body").boundingClientRect();
    query.select("#chat-bottom").boundingClientRect();
    query.selectAll(".chat-msg").boundingClientRect();
    query.exec((results: Array<any>) => {
      if (!isChatCurrent()) return;
      const msgs = messages.value;
      if (results.length < 3 || results[0] == null || results[2] == null || msgs.length == 0) {
        return;
      }
      const bodyRect = results[0] as NodeInfo;
      const endRect = results[1] != null ? (results[1] as NodeInfo) : null;
      const rows = results[2] as NodeInfo[];
      if (rows.length == 0) {
        return;
      }
      if (bodyRect.top == null || bodyRect.height == null) {
        return;
      }
      const bodyTop = parseFloat(`${bodyRect.top}`);
      const bodyBottom = bodyTop + parseFloat(`${bodyRect.height}`);
      // 距底余量 = 内容底（视口坐标）- 视口底：向上滑看历史时为正，在底部 ≈ 0
      // （★符号勿写反：写反会算出负数被 clamp 成 0，进页误判「上次在底部」直接滚底）
      // 回收列表中底部锚点可能尚未渲染，此时保守视为正在读历史。
      let distBottom = NEAR_BOTTOM_PX + 1;
      if (endRect != null && endRect.top != null) distBottom = parseFloat(`${endRect.top}`) - bodyBottom;
      if (distBottom < 0) {
        distBottom = 0;
      }
      // 首可见行 = 首个底边（top+height，视口坐标）超过视口顶的行；找不到兜底最旧行
      let anchorId = "";
      for (let i = 0; i < rows.length && i < msgs.length; i++) {
        const r = rows[i];
        if (r.top == null || r.height == null) {
          continue;
        }
        if (parseFloat(`${r.top}`) + parseFloat(`${r.height}`) > bodyTop + 2) {
          const nodeId = r.id;
          if (nodeId != null && nodeId.startsWith("msg-")) {
            anchorId = nodeId.substring(4);
            break;
          }
        }
      }
      if (anchorId.length == 0) return;
      const memo = new ChatScrollMemo();
      memo.anchorId = anchorId;
      memo.distBottom = distBottom;
      setCachedChatScroll(convId.value, memo);
    });
  }

  // ===== 列表滚动中抑制气泡按压态（message.uvue 同款节流方案） =====
  // 快速滑动（含惯性滚动）期间消息气泡不点亮按压底色（hover-class 已换触摸自驱，
  // 由 handlePressTouchStart 的定时器在点亮前检查），滚动停止 ~160ms 后恢复。
  const chatScrolling = ref<boolean>(false);
  let chatScrollIdleTimer = 0;
  // 滚动停稳后防抖记忆阅读位置（主记忆时机；onHide 兜底——返回销毁途中
  // selectorQuery 的 exec 回调可能不落地，光靠 onHide 会丢）
  let scrollMemoSaveTimer = 0;

  function handleChatScroll(): void {
    if (chatScrolling.value != true) {
      chatScrolling.value = true;
    }
    if (chatScrollIdleTimer != 0) {
      clearTimeout(chatScrollIdleTimer);
    }
    chatScrollIdleTimer = setTimeout(() => {
      chatScrollIdleTimer = 0;
      chatScrolling.value = false;
    }, 160);
    if (scrollMemoSaveTimer != 0) {
      clearTimeout(scrollMemoSaveTimer);
    }
    scrollMemoSaveTimer = setTimeout(() => {
      scrollMemoSaveTimer = 0;
      saveScrollMemo();
    }, 500);
    // 「回到底部」浮钮节流探测（在读历史→亮，滚回贴底→灭）
    scheduleJumpLatestCheck(250);
  }

  // ===== 消息区按压触摸处理（状态与 class 函数在 cardBusyKey 后；此处引用 chatScrolling）=====
  /** 按压触摸开始：空 id（不可点元素）不点亮；50ms 后仍在原位且不在滚动中才点亮。 */
  function handlePressTouchStart(pressId: string, eventValue: Any): void {
    if (pressId.length == 0) {
      return;
    }
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    pressTouchStartX = e.touches[0].clientX;
    pressTouchStartY = e.touches[0].clientY;
    pressTouchPending = pressId;
    if (pressTouchTimer != 0) {
      clearTimeout(pressTouchTimer);
    }
    pressTouchTimer = setTimeout(() => {
      pressTouchTimer = 0;
      if (pressTouchPending.length > 0 && chatScrolling.value != true) {
        pressTouchId.value = pressTouchPending;
      }
    }, 50);
  }

  /** 按压触摸移动：位移超 10px = 滑动（滚动/长按拖动），立即熄灭按压底色。 */
  function handlePressTouchMove(eventValue: Any): void {
    if (pressTouchPending.length == 0 && pressTouchId.value.length == 0) {
      return;
    }
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    const dx = e.touches[0].clientX - pressTouchStartX;
    const dy = e.touches[0].clientY - pressTouchStartY;
    if (Math.abs(dx) > 10 || Math.abs(dy) > 10) {
      clearPressTouch();
    }
  }

  /** 按压触摸结束（抬起/被滚动接管触发 cancel）：按压底色必灭。 */
  function handlePressTouchEnd(): void {
    clearPressTouch();
  }

  const chatImageUrls = new Set<string>();
  const chatImageRequests = new Map<string, Promise<string>>();

  async function resolveChatImage(url: string, size: number): Promise<string> {
    const key = `${size}:${url}`;
    const existing = chatImageRequests.get(key);
    if (existing != null) return await existing;
    const task = resolveDisplayImageUrl(url, size, size);
    chatImageRequests.set(key, task);
    try {
      const resolved = await task;
      if (!isChatCurrent()) {
        releaseDisplayImageUrl(resolved);
        return url;
      }
      if (resolved.startsWith("blob:")) chatImageUrls.add(resolved);
      return resolved;
    } finally {
      chatImageRequests.delete(key);
    }
  }

  // ===== 视频预载（msgType=video：进页/增量合并后自动解析地址回填行，首帧常驻 <video>） =====
  // /api/f/ 受保护地址 <video> src 带不了 Bearer：先经 /api/file/ak/refresh 换 ?ak= 流式
  // 直链（302→对象存储 Range 流输出，播放器渐进拉流，10-04 起首选）；换链失败才回落
  // 整段下载 temp（H5 blob）地址回填。
  // msg.videoPlayUrl ⇒ 模板按行挂 <video>（controls 自带播放键点播——不做任何自动起播：
  // iOS autoplay/延迟补调 play() 均不稳定，手点是唯一稳定路径，10-04 定稿）。
  // ★本块必须定义在 mergeSyncedMessages / insertMessageBySeq 之前（它们尾部要调
  //   preloadChatVideos，UTS 严格要求先定义后调用）；模板事件处理器在语音块之后。

  /** 受保护地址解析中的 msgId（占位卡显示「下载中」，模板直读）。 */
  const videoLoadingId = ref<string>("");
  /** 解析进度百分比（-1=不确定，无进度回调的平台只显「下载中」；模板直读）。 */
  const videoLoadPercent = ref<number>(-1);
  /** 任一视频是否全屏（fullscreenchange 回写；模板直读控制 Android 全屏兜底按钮显隐）。 */
  const videoFullscreen = ref<boolean>(false);
  /** 原始 url → 已解析 src 缓存（重放免二次下载；temp 文件由 OS 回收，这里只缓存路径）。 */
  const chatVideoResolved = new Map<string, string>();
  /** H5 blob 地址登记（onUnload 统一 revoke，对齐 chatImageUrls）。 */
  const chatVideoUrls = new Set<string>();
  /** 在途解析去重（同 url 并发触发共享同一次下载，对齐 chatImageRequests）。 */
  const chatVideoRequests = new Map<string, Promise<string>>();
  /** 批量预载防重入（在途轮次未结束时新触发直接放弃，漏行等下一轮合并/插入补扫）。 */
  let chatVideoPreloadBusy = false;
  /** 播放报错已自动重解析过的 msgId（每页会话至多一次：ak 过期自愈够用，坏文件不无限循环）。 */
  const videoRetryIds = new Set<string>();
  /** 正在播放的 msgId（@play/@pause 回写：轻触切播放/暂停要按它判方向）。 */
  const playingVideoIds = new Set<string>();

  /** 指定行的 <video> 元素（每行独立 id：预载后多行常驻，非单实例）。 */
  function getChatVideoElement(msgId: string): UniVideoElement | null {
    return uni.getElementById(`chatVideoPlayer-${msgId}`) as UniVideoElement | null;
  }

  /** 暂停所有已挂载视频（页面隐藏 / 播语音互斥；不清 src——回来仍停在该帧）。 */
  function pauseChatVideos(): void {
    for (let i = 0; i < messages.value.length; i++) {
      const row = messages.value[i];
      if (row.videoPlayUrl.length > 0) {
        const el = getChatVideoElement(row.msgId);
        if (el != null) {
          el.pause();
        }
      }
    }
  }

  // App 端：页面内 downloadFile 薄封装（与 fetchAuthProtectedFileDisplayUrl 同鉴权头），
  // 额外拿 DownloadTask.onProgressUpdate 驱动占位卡百分比
  // #ifdef APP
  function fetchChatVideoProtectedUrl(
    url: string,
    onProgress: ((percent: number) => void) | null,
  ): Promise<string> {
    return new Promise<string>((resolve, reject) => {
      const fetchUrl = resolveAuthProtectedFileFetchUrl(url);
      const task = uni.downloadFile({
        url: fetchUrl,
        header: buildAuthProtectedFileHeaders(),
        success: (res) => {
          const tempPath = res.tempFilePath;
          if (res.statusCode == 200 && tempPath != null && tempPath.length > 0) {
            resolve(tempPath);
            return;
          }
          console.error(`[ChatVideo] downloadFile statusCode=${res.statusCode} url=${fetchUrl}`);
          reject(new Error(`download statusCode ${res.statusCode}`));
        },
        fail: (err) => {
          console.error(`[ChatVideo] downloadFile fail url=${fetchUrl}`, err);
          reject(new Error(err.errMsg != null ? err.errMsg : "download fail"));
        },
      });
      task.onProgressUpdate((res) => {
        if (onProgress != null) {
          onProgress(res.progress);
        }
      });
    });
  }
  // #endif
  // 非 App 端：复用通用受保护文件拉取（H5 换 blob；小程序换 temp），无进度回调
  // #ifndef APP
  function fetchChatVideoProtectedUrl(
    url: string,
    _onProgress: ((percent: number) => void) | null,
  ): Promise<string> {
    return fetchAuthProtectedFileDisplayUrl(url);
  }
  // #endif

  /** 受保护视频取址：allowAk 时首选 /api/file/ak/refresh 换流式直链（播放器自行跟
   *  302 渐进拉流，预载只花一次轻量 JSON 请求，不再先下整段）；接口不可用/失败，
   *  或播放报错自愈重解析（ak 已被证伪：可能过期或该端播放器不跟 302）时，
   *  走整段下载路径（temp/blob，进度回调只在下载分支有意义）。 */
  async function resolveChatVideoProtected(
    url: string,
    onProgress: ((percent: number) => void) | null,
    allowAk: boolean,
  ): Promise<string> {
    if (allowAk) {
      try {
        return await fetchAuthProtectedFileAkUrl(url);
      } catch (_e) {
        console.error(`[ChatVideo] ak 直链解析失败，回落整段下载 url=${url}`);
      }
    }
    return await fetchChatVideoProtectedUrl(url, onProgress);
  }

  /** 解析视频可播地址：CDN 直链原样返回；受保护地址先换 ak 流式直链（302→对象存储
   *  Range 流输出，边下边播、免整段下载），换链失败回落整段下载 temp/blob
   *  （带缓存与在途去重；ak 播放报错的自愈路径见 handleVideoError——直接走下载兜底）。 */
  async function resolveChatVideo(
    url: string,
    onProgress: ((percent: number) => void) | null,
    allowAk: boolean = true,
  ): Promise<string> {
    if (isAuthProtectedFileUrl(url) != true) {
      return url;
    }
    const cached = chatVideoResolved.get(url);
    if (cached != null) {
      return cached;
    }
    const existing = chatVideoRequests.get(url);
    if (existing != null) {
      return await existing;
    }
    const task = resolveChatVideoProtected(url, onProgress, allowAk);
    chatVideoRequests.set(url, task);
    try {
      const resolved = await task;
      if (!isChatCurrent()) {
        releaseDisplayImageUrl(resolved);
        return url;
      }
      if (resolved.startsWith("blob:")) {
        chatVideoUrls.add(resolved);
      }
      chatVideoResolved.set(url, resolved);
      return resolved;
    } finally {
      chatVideoRequests.delete(url);
    }
  }

  /** 单条视频预载：解析可播地址并回填行字段（videoPlayUrl 非空 ⇒ 模板挂 <video> 显首帧）。
   *  ★await 期间行可能被快照整行替换：按 msgId 经 messages.value 重取代理实例再写
   *  （insertMessageBySeq 注释同款约束：改原始对象不触发视图刷新）。失败静默（占位卡
   *  ▶ 可再点重试）；同 url 并发由 chatVideoRequests 去重。 */
  async function preloadChatVideoRow(
    msgId: string,
    url: string,
    allowAk: boolean = true,
  ): Promise<void> {
    videoLoadingId.value = msgId;
    videoLoadPercent.value = -1;
    try {
      const src = await resolveChatVideo(url, (percent: number): void => {
        // 进度只归属于当前等待的那条（快速换点另一条时旧回调静默）
        if (videoLoadingId.value == msgId) {
          videoLoadPercent.value = percent;
        }
      }, allowAk);
      if (!isChatCurrent()) {
        return;
      }
      for (let i = 0; i < messages.value.length; i++) {
        const row = messages.value[i];
        if (row.msgId == msgId) {
          row.videoPlayUrl = src;
          break;
        }
      }
      // Android 原地属性变更不触发行重渲：整表重建调度出首帧（同下方图片回填）
      scheduleChatMediaRefresh();
    } catch (_e) {
      console.error(`[ChatVideo] 预载失败 msgId=${msgId} url=${url}`);
    } finally {
      if (videoLoadingId.value == msgId) {
        videoLoadingId.value = "";
        videoLoadPercent.value = -1;
      }
    }
  }

  /** 批量预载（进页合并 / 翻页 / 新消息插入后调用）：从最新往回扫，视频行且未挂载的
   *  逐条顺序预载（顺序下载避免多视频并发抢带宽；缓存命中零成本回填）。 */
  async function preloadChatVideos(): Promise<void> {
    if (chatVideoPreloadBusy) {
      return;
    }
    chatVideoPreloadBusy = true;
    try {
      for (let i = messages.value.length - 1; i >= 0; i--) {
        const row = messages.value[i];
        // videoUrl 即预载对象：msgType=video + file 视频文件 + rich_text 内嵌视频附件
        // （readMsgRow 三形态统一落入同一字段，渲染/预载/播放器全共用）
        if (row.videoUrl.length > 0 && row.videoPlayUrl.length == 0) {
          if (!isChatCurrent()) {
            return;
          }
          await preloadChatVideoRow(row.msgId, row.videoUrl);
        }
      }
    } finally {
      chatVideoPreloadBusy = false;
    }
  }

  /** 卸载释放：H5 blob 统一 revoke、缓存表清空（对齐 releaseChatImages）。 */
  function releaseChatVideos(): void {
    chatVideoUrls.forEach((url) => {
      releaseDisplayImageUrl(url);
    });
    chatVideoUrls.clear();
    chatVideoResolved.clear();
    chatVideoRequests.clear();
    videoRetryIds.clear();
  }

  // ===== 头像展示地址解析（与下方 resolveRowMedia 同理由）=====
  // /api/f/ 受保护头像与远程 SVG：<image> 带不了 Bearer（H5 被 ORB 拦成
  // net::ERR_BLOCKED_BY_ORB），经 resolveDisplayImageUrl 带 Bearer 拉取换可展示地址
  // （H5 blob / App 临时文件 / SVG 按尺寸 data URL），avatarSrcOf 渲染时查缓存替换；
  // 普通地址原样保留（真机直连可出图，不产生额外请求）。
  /** .chat-ava 展示尺寸（rpx），App 端 SVG 按此出物理像素图 */
  const AVATAR_DISPLAY_RPX = 76;
  /** 原始地址 → 已解析展示地址（avatarSrcOf 渲染时查表） */
  const avatarDisplayCache = new Map<string, string>();
  /** 已发起过解析的原始地址（含失败回退原地址的：不重试，对齐 SVG 负缓存语义） */
  const avatarAttemptedUrls = new Set<string>();
  /** H5 blob 地址登记：releaseChatImages 统一 revoke */
  const avatarBlobUrls = new Set<string>();
  /** 在途去重：同地址并发触发共享同一次解析 */
  const avatarRequests = new Set<string>();
  /** 头像解析版本号：App-Android 方法调用绑定不收集方法体内依赖（readInfoTick 先例），
   * 解析完成 bump 一次强制模板重算 avatarSrcOf。 */
  const avatarResolveTick = ref<number>(0);

  function resolveChatAvatarUrl(url: string): void {
    // ★仅浏览器 H5 生效：App 三端 <image> 原生加载器直连可用（无 ORB），保持原地址
    //   直连，不额外下载换 temp/SVG 地址（避开 temp/SVG 渲染路径裁圆不生效的坑）
    // #ifdef H5 || WEB
    if (url.length == 0) return;
    if (avatarDisplayCache.has(url) || avatarAttemptedUrls.has(url)) return;
    if (avatarRequests.has(url)) return;
    avatarAttemptedUrls.add(url);
    avatarRequests.add(url);
    resolveDisplayImageUrl(url, AVATAR_DISPLAY_RPX, AVATAR_DISPLAY_RPX)
      .then((resolved: string) => {
        avatarRequests.delete(url);
        // 普通地址 / 解析失败回退：保持原地址直连（真机可用，H5 交 @error 兜底字母头像）
        if (resolved == url) return;
        if (!isChatCurrent()) {
          // 会话已切换：blob 立即回收防泄漏（缓存随 releaseChatImages 清空）
          if (resolved.startsWith("blob:")) releaseDisplayImageUrl(resolved);
          return;
        }
        if (resolved.startsWith("blob:")) avatarBlobUrls.add(resolved);
        avatarDisplayCache.set(url, resolved);
        avatarResolveTick.value = avatarResolveTick.value + 1;
      })
      .catch((_e: any | null) => {
        avatarRequests.delete(url);
        // resolveDisplayImageUrl 内部已兜底回退原地址；防御异常路径即可
      });
    // #endif
  }

  function releaseChatImages(): void {
    chatImageUrls.forEach((url: string) => { releaseDisplayImageUrl(url); });
    chatImageUrls.clear();
    chatImageRequests.clear();
    // 头像解析产物一并回收：会话切换/页面卸载后 blob 已失效，缓存须清空防悬挂引用
    avatarBlobUrls.forEach((url: string) => { releaseDisplayImageUrl(url); });
    avatarBlobUrls.clear();
    avatarDisplayCache.clear();
    avatarAttemptedUrls.clear();
    avatarRequests.clear();
  }

  /**
   * /api/f/ 受保护媒体：<image> 带不了 Bearer（H5 会被 ORB 拦成 net::ERR_BLOCKED_BY_ORB），
   * 经 resolveDisplayImageUrl 带 Bearer 拉取换成可展示地址（H5 blob / App 临时文件），
   * 解析成功后原位替换；普通地址原样保留。
   */
  function resolveRowMedia(row: ImMsgRow): void {
    if (!isChatCurrent()) return;
    if (!isChatActive()) {
      deferredMediaIds.add(row.msgId);
      return;
    }
    deferredMediaIds.delete(row.msgId);
    // 头像同走受保护/SVG 解析（H5 ORB / App SVG 光栅化；attempted 去重，普通地址零成本）
    resolveChatAvatarUrl(row.senderAvatar);
    if (row.imageUrl.length > 0) {
      const url = row.imageUrl;
      resolveChatImage(url, 300)
        .then((resolved: string) => {
          if (isChatCurrent() && resolved != url) {
            row.imageUrl = resolved;
            // Android 原地属性变更不触发 v-for 行重渲：回填后整表重建调度出图
            scheduleChatMediaRefresh();
          }
        })
        .catch((_e: any | null) => {
          // 失败保留原地址：交给 <image> 兜底（如平台 Cookie 命中的场景）
          console.error(`[ChatImg] 受保护主图解析失败保留原地址 src=${url}`);
        });
    }
    for (let i = 0; i < row.imageAtts.length; i++) {
      const att = row.imageAtts[i];
      const url = att.url;
      resolveChatImage(url, 260)
        .then((resolved: string) => {
          if (isChatCurrent() && resolved != url) {
            att.url = resolved;
            // 同上：附件图回填后同样要整表重建才在 Android 出图
            scheduleChatMediaRefresh();
          }
        })
        .catch((_e: any | null) => {
          // 同上
          console.error(`[ChatImg] 受保护附件图解析失败保留原地址 src=${url}`);
        });
    }
  }

  /** 合并服务端快照：批内去重、按版本更新，保留已解析的未变消息。 */
  function mergeSyncedMessages(records: UTSJSONObject[]): boolean {
    if (!isChatCurrent()) return false;
    const rows = messages.value.slice();
    const indices = new Map<string, number>();
    const clientIndices = new Map<string, number>();
    const changed = new Set<string>();
    for (let i = 0; i < rows.length; i++) {
      indices.set(rows[i].msgId, i);
      if (rows[i].clientMsgId.length > 0) clientIndices.set(rows[i].clientMsgId, i);
    }
    for (let i = 0; i < records.length; i++) {
      const record = records[i];
      if (record == null || readString(record, "convId") != convId.value) continue;
      const msgId = readString(record, "msgId");
      if (msgId.length == 0) continue;
      let index = indices.get(msgId);
      if (index == null) index = clientIndices.get(readString(record, "clientMsgId"));
      const revision = Math.max(readNumber(record, "editTime", 0), readNumber(record, "revokeTime", 0));
      const revoked = readNumber(record, "msgStatus", 1) == 2;
      if (index != null) {
        const previous = rows[index];
        // 撤回不可复活；较旧 HTTP 快照不可覆盖已收到的编辑事件。
        if (previous.revoked && !revoked) continue;
        if (!previous.local && !(revoked && !previous.revoked) && revision <= previous.revisionAt) {
          // 版本守卫挡掉整行替换，但智能体明细是另一条时间线（读路径投影）：单调并入，
          // 旧 HTTP 快照才不会把 3006 帧推来的新状态盖回去
          const agentIncoming = parseAgentStatusDetail(record["agentStatusDetail"]);
          if (agentIncoming.length > 0 && mergeRowAgentDetail(previous, agentIncoming)) {
            changed.add(msgId);
          }
          continue;
        }
        const fresh = readMsgRow(record);
        // 本地已并入的 3006 帧状态可能领先 HTTP 快照：单调并入防回退（同 PC mergeAgentDetailList）
        const agentKeep = mergeAgentStatusItems(fresh.agentDetail, previous.agentDetail);
        if (agentKeep != null) {
          fresh.agentDetail = agentKeep;
          applyAgentStatusToRow(fresh);
        }
        rows[index] = fresh;
        indices.set(msgId, index);
      } else {
        indices.set(msgId, rows.length);
        const row = readMsgRow(record);
        if (row.clientMsgId.length > 0) clientIndices.set(row.clientMsgId, rows.length);
        rows.push(row);
      }
      changed.add(msgId);
    }
    if (changed.size == 0) return false;
    // 未确认的本地占位 seq=0，固定留在末尾。
    rows.sort((a: ImMsgRow, b: ImMsgRow): number => {
      if (a.local != b.local) return a.local ? 1 : -1;
      return a.seq - b.seq;
    });
    messages.value = rows;
    for (let i = 0; i < messages.value.length; i++) {
      const row = messages.value[i];
      if (changed.has(row.msgId)) resolveRowMedia(row);
    }
    // 视频预载：批量合并落库后扫一遍未挂载的视频行（缓存命中零成本，非视频行零开销）
    preloadChatVideos();
    reportReadIfNeeded(maxSeq());
    return true;
  }


  /** 首屏 + 向上翻页共用：beforeSeq<=0 取最新一页，否则取 seq<beforeSeq 的更早一页。 */
  async function loadHistory(beforeSeq: number, preserveAnchor: string = ""): Promise<void> {
    const res = await apiImMessages(convId.value, beforeSeq, MSG_PAGE_SIZE);
      if (!isChatCurrent()) return;
    if (apiResCode(res) != SUCCESS_CODE) {
      loadFailed.value = true;
      return;
    }
    const dataRaw = apiResData<any>(res);
    const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;

    if (dataObj != null) {
      hasMore.value = readBool(dataObj, "hasMore");
      const recordsRaw = dataObj["records"];
      if (recordsRaw != null) {
        const records = recordsRaw as UTSJSONObject[];
        // 翻页的消息与锚点同批提交，不能先渲染新增的顶部消息，再 nextTick 拉回。
        if (preserveAnchor.length > 0 && isChatActive()) {
          releasePrependAnchor();
          cancelPrependAnchor = preserveImPrependAnchor("im-chat-body", preserveAnchor);
          if (cancelPrependAnchor == null) scrollAnchor.value = preserveAnchor;
        }
        mergeSyncedMessages(records);
        // 附件缓存累积：文件页（文件/群文件）只读本窗口已加载消息里的附件
        collectChatAttachments(convId.value, records);
        // 首屏（beforeSeq<=0）成功后写消息缓存：下次进页先渲染再静默同步
        if (beforeSeq <= 0 && records.length > 0) {
          setCachedChatRecords(convId.value, records);
        }
      }
    }
    reportReadIfNeeded(maxSeq());
    refreshReadStatus();
  }

  async function handleLoadOlder(): Promise<void> {
    if (!isChatActive()) return;
    if (loading.value || loadingOlder.value || loadFailed.value) {
      return;
    }
    if (hasMore.value != true || messages.value.length == 0) {
      return;
    }
    // beforeSeq = 当前列表最小 seq；记录首行 id 供翻页后锚回原位
    const firstKey = messages.value[0].msgId;
    const oldestSeq = messages.value[0].seq;
    entryFollowLatest = false;
    cancelSettle();
    scrollAnchor.value = "";
    loadingOlder.value = true;
    try {
      await loadHistory(oldestSeq, `msg-${firstKey}`);
      if (!isChatCurrent()) return;
      loadingOlder.value = false;
    } catch (_error) {
      loadingOlder.value = false;
    }
  }

  /** 发送核心：占位行 → 置发送中 → 落库确认后原位替换（幂等键复用支持失败重试）。 */
  async function sendWithRow(row: ImMsgRow): Promise<void> {
    row.status = 0;
    try {
      const res = await apiImSendTextMsg(
        convId.value,
        row.bodyText,
        row.clientMsgId,
        row.mentionIds.length > 0 ? row.mentionIds : null,
        row.mentionAll,
        row.replyId.length > 0 ? row.replyId : "",
      );
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        replaceByClientMsgId(buildConfirmedRow(dataObj, row));
        quoteTarget.value = null;
        resetQuoteMentionSnapshot();
        reportReadIfNeeded(maxSeq());
        refreshReadStatus();
        scrollToBottom();
      } else {
        // 禁言拒发：乐观行移除（不留失败态），handleMuteRejection 内已 toast
        if (handleMuteRejection(res, row.clientMsgId)) return;
        markRowFailed(row.clientMsgId);
        // 群已解散被服务端拒（IM_20105）：切换输入坞为已解散灰条，提示用禁发文案
        if (apiResCode(res) == "IM_20105") {
          convDisbanded.value = true;
          uni.showToast({ title: t("Mobile.Message.groupDisbandedSendTip"), icon: "none" });
          return;
        }
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Message.sendFailed"), icon: "none" });
      }
    } catch (_error) {
      markRowFailed(row.clientMsgId);
      uni.showToast({ title: t("Mobile.Message.sendFailed"), icon: "none" });
    }
  }

  /**
   * 发送正文按格式横条激活的样式态逐行包装 Markdown 标记（B/I/S/U 点选后输入即属该样式；
   * textarea 无法在输入过程实时显示富文本，发送后气泡渲染出效果）。列表前缀不参与包装。
   * ★须定义在 handleSend 之前（UTS→Kotlin 先用后定义会报「找不到名称」）。
   */
  function applyActiveMarks(text: string): string {
    if (markBold.value != true && markItalic.value != true && markStrike.value != true && markUnderline.value != true) {
      return text;
    }
    const lines = text.split("\n");
    for (let i = 0; i < lines.length; i++) {
      const rawLine = lines[i];
      if (rawLine.trim().length == 0) {
        continue;
      }
      const olCut = olPrefixLen(rawLine);
      const ulCut = ulPrefixLen(rawLine);
      const cut = olCut > 0 ? olCut : ulCut;
      const prefix = rawLine.substring(0, cut);
      let l = rawLine.substring(cut);
      if (markUnderline.value) {
        l = `<u>${l}</u>`;
      }
      if (markStrike.value) {
        l = `~~${l}~~`;
      }
      if (markItalic.value) {
        l = `*${l}*`;
      }
      if (markBold.value) {
        l = `**${l}**`;
      }
      lines[i] = prefix + l;
    }
    return lines.join("\n");
  }

  // ===== 引用 / 编辑（compose 条目标管理；两者互斥，进入一方清另一方） =====

  /** 消息自身内容预览（引用条/占位行引用块用）：图片 > 视频 > 正文 > 文件，换行折叠为空格。 */
  function msgSelfPreview(msg: ImMsgRow): string {
    if (msg.msgType == "image" || msg.imageAtts.length > 0) {
      return t("Mobile.Message.quoteImage");
    }
    if (msg.msgType == "video" && msg.videoUrl.length > 0) {
      return t("Mobile.Message.previewVideo");
    }
    if (msg.bodyText.length > 0) {
      return msg.bodyText.split("\n").join(" ");
    }
    return t("Mobile.Message.quoteFile");
  }

  /** 引用回复自动 @被回复人（非自己时）：@昵称 追加到输入末尾，随正文携带提及发送。
   *  群聊优先取成员 token（与发送前提及反扫字节一致，确保 mentionUserIds 命中）；
   *  单聊/成员未命中（接口失败、已退群）退回引用条显示名，正文保留 @提及文案。 */
  async function autoMentionQuotedSender(msg: ImMsgRow): Promise<void> {
    if (isMine(msg) || msg.senderId.length == 0) {
      return;
    }
    await loadMembers();
    let token = "";
    const all = members.value;
    for (let i = 0; i < all.length; i++) {
      const member = all[i];
      if (member.userId == msg.senderId && member.token.length > 0) {
        token = member.token;
        break;
      }
    }
    if (token.length == 0) {
      const quoting = quoteTarget.value;
      token = quoting != null ? quoting.senderName : "";
    }
    // 已含同一 @时不重复追加（连续引用同一人的回复场景）
    if (token.length > 0 && inputText.value.indexOf(`@${token}`) < 0) {
      quoteMentionBefore = inputText.value;
      appendMentionText(token);
      quoteMentionAfter = inputText.value;
    }
  }

  /** 长按「引用」：记录目标并聚焦输入框（发送时随请求带 replyToMsgId）。 */
  function enterQuoteMode(msg: ImMsgRow): void {
    const target = new QuoteTargetInfo();
    target.msgId = msg.msgId;
    target.isImage = (msg.msgType == "image" && msg.imageUrl.length > 0) || msg.imageAtts.length > 0;
    target.senderName = isMine(msg)
      ? myDisplayName.value
      : msg.senderName.length > 0
        ? msg.senderName
        : titleName.value;
    target.preview = msgSelfPreview(msg);
    editTarget.value = null;
    quoteTarget.value = target;
    resetQuoteMentionSnapshot();
    // 自动 @被回复人仅群聊需要；单聊双方上下文明确，@ 冗余（产品要求不自动填）
    if (isGroupLike.value) {
      autoMentionQuotedSender(msg);
    }
    focusChatInput();
  }

  /** 长按「编辑」：原始正文（含既有 Markdown 标记）回填输入框，聚焦到末尾继续改。 */
  function enterEditMode(msg: ImMsgRow): void {
    const target = new EditTargetInfo();
    target.msgId = msg.msgId;
    target.originText = msg.bodyText;
    quoteTarget.value = null;
    resetQuoteMentionSnapshot();
    editTarget.value = target;
    inputText.value = msg.bodyText;
    focusChatInput();
  }

  /** compose 条 X：退出当前态（编辑态同时清空输入框，引用态保留已输入内容）。 */
  function handleComposeBarClose(): void {
    if (editTarget.value != null) {
      inputText.value = "";
    }
    // 引用态：自动带入的 @提及若用户未再输入则一并回退，避免遗留孤儿提及
    if (quoteTarget.value != null && quoteMentionAfter.length > 0 && inputText.value == quoteMentionAfter) {
      inputText.value = quoteMentionBefore;
    }
    editTarget.value = null;
    quoteTarget.value = null;
    resetQuoteMentionSnapshot();
  }

  /** 引用元数据写进占位行（乐观渲染引用块；确认行经 buildConfirmedRow 透传）。 */
  function applyQuoteToRow(row: ImMsgRow): void {
    const quoting = quoteTarget.value;
    if (quoting == null) {
      return;
    }
    row.replyId = quoting.msgId;
    row.replySenderName = quoting.senderName;
    row.replyIsImage = quoting.isImage;
    row.replyText = quoting.preview;
  }

  /**
   * 编辑保存（PUT /messages/{msgId}）：正文原样提交——★不走 applyActiveMarks
   * （回显正文已含 Markdown 标记，再包装会二次加粗/斜体）；返回编辑后的
   * MessageDto 按 msgId 原位替换（editTime 非空 ⇒ 自动带出「已编辑」）。
   */
  async function submitEdit(text: string): Promise<void> {
    const target = editTarget.value;
    if (target == null || convId.value.length == 0) {
      return;
    }
    if (text == target.originText.trim()) {
      // 未改动：直接退出编辑态（不发请求）
      editTarget.value = null;
      inputText.value = "";
      return;
    }
    try {
      const res = await apiImEditMsg(target.msgId, convId.value, text);
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj != null) {
          const editedRow = readMsgRow(dataObj);
          const rows = messages.value;
          for (let i = 0; i < rows.length; i++) {
            if (rows[i].msgId == editedRow.msgId) {
              rows.splice(i, 1, editedRow);
              break;
            }
          }
        }
        editTarget.value = null;
        inputText.value = "";
      } else {
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /**
   * 媒体发送核心（与 PC 端 sendAttachment 单附件链路对齐）：
   * uploadSingleFile 拿远端 url/size/mime → 按 mime 定 msgType（image/* → image，
   * 其余 file）→ apiImSendMediaMsg → 确认行按真实类型重建媒体字段后原位替换。
   */
  async function sendMediaWithRow(
    row: ImMsgRow,
    localPath: string,
    displayName: string,
  ): Promise<void> {
    row.status = 0;
    try {
      const up = await uploadSingleFile(localPath, row.clientMsgId, null, displayName);
      if (!isChatCurrent()) return;
      if (up.success != true || up.file == null) {
        markRowFailed(row.clientMsgId);
        const reason = up.error != null ? `${up.error}` : "";
        uni.showToast({
          title: reason.length > 0 ? reason : t("Mobile.Message.sendFailed"),
          icon: "none",
        });
        return;
      }
      const file = up.file;
      const kind = file.type.indexOf("image/") == 0 ? "image" : "file";
      const res = await apiImSendMediaMsg(
        convId.value,
        kind,
        file.url,
        file.name,
        file.size,
        file.type,
        row.clientMsgId,
        row.replyId.length > 0 ? row.replyId : "",
      );
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        const confirmed = buildConfirmedRow(dataObj, row);
        confirmed.msgType = kind;
        if (kind == "image") {
          confirmed.imageUrl = file.url;
          confirmed.linkAtts = [];
        } else if (file.type.indexOf("video/") == 0) {
          // 视频文件：确认行转视频渲染（readMsgRow 同口径；发送契约仍 kind=file），
          // 随后 preloadChatVideos 换 ak 直链挂播放器
          confirmed.imageUrl = "";
          confirmed.linkAtts = [];
          confirmed.videoUrl = file.url;
          confirmed.videoFileName = file.name;
          confirmed.videoSize = file.size;
        } else {
          const att = new ImMsgAtt();
          att.url = file.url;
          att.fileName = file.name;
          att.mime = file.type;
          confirmed.imageUrl = "";
          confirmed.linkAtts = [att];
        }
        replaceByClientMsgId(confirmed);
        quoteTarget.value = null;
        // /api/f/ 受保护地址解析：拿替换进列表后的代理实例改属性才会触发刷新
        const proxied = findRowByClientMsgId(confirmed.clientMsgId);
        if (proxied != null) {
          resolveRowMedia(proxied);
        }
        // 视频确认行预载（原占位是本地播放，确认后换远端地址重挂播放器）
        preloadChatVideos();
        reportReadIfNeeded(maxSeq());
        refreshReadStatus();
        scrollToBottom();
      } else {
        // 禁言拒发：乐观行移除（不留失败态），handleMuteRejection 内已 toast
        if (handleMuteRejection(res, row.clientMsgId)) return;
        markRowFailed(row.clientMsgId);
        const message = apiResMessage(res);
        uni.showToast({
          title: message.length > 0 ? message : t("Mobile.Message.sendFailed"),
          icon: "none",
        });
      }
    } catch (_error) {
      markRowFailed(row.clientMsgId);
      uni.showToast({ title: t("Mobile.Message.sendFailed"), icon: "none" });
    }
  }

  /**
   * 图文混排发送核心（与 PC 端 sendComposed 的 rich_text 分支对齐，DEV-159 契约）：
   * 逐张串行上传（PC 同款背压：并发多文件会撞服务端限流）→ 拼 attachments JSON →
   * apiImSendRichTextMsg → 确认行按真实 url/mime 重建 imageAtts 后原位替换。
   * 失败整行标失败，点击气泡全量重传（clientMsgId 幂等防重，部分已上传的 URL 不缓存）。
   */
  async function sendRichTextWithRow(row: ImMsgRow, localPaths: string[]): Promise<void> {
    row.status = 0;
    try {
      const files: UploadFileInfo[] = [];
      for (let i = 0; i < localPaths.length; i++) {
        // uid 加序号区分多张（与单文件上传的 clientMsgId 用法独立，仅作上传去重标识）
        const up = await uploadSingleFile(localPaths[i], `${row.clientMsgId}-${i}`, null, "");
        if (!isChatCurrent()) return;
        if (up.success != true || up.file == null) {
          markRowFailed(row.clientMsgId);
          const reason = up.error != null ? `${up.error}` : "";
          uni.showToast({
            title: reason.length > 0 ? reason : t("Mobile.Message.sendFailed"),
            icon: "none",
          });
          return;
        }
        const file = up.file;
        files.push(file);
      }
      // attachments JSON：url/fileName/mime 含用户可控字符，一律 JSON.stringify 转义
      // （buildMergeItemsJson 同款手法）；kind 恒 image（本链路只装图片）。
      let attsJson = "[";
      for (let i = 0; i < files.length; i++) {
        if (i > 0) {
          attsJson += ",";
        }
        const urlJson = JSON.stringify(files[i].url);
        const nameJson = JSON.stringify(files[i].name);
        const mimeJson = JSON.stringify(files[i].type);
        attsJson += `{"kind":"image","url":${urlJson},"fileName":${nameJson},"size":${files[i].size},"mime":${mimeJson}}`;
      }
      attsJson += "]";
      const res = await apiImSendRichTextMsg(
        convId.value,
        row.bodyText,
        attsJson,
        row.clientMsgId,
        row.mentionIds.length > 0 ? row.mentionIds : null,
        row.mentionAll,
        row.replyId.length > 0 ? row.replyId : "",
      );
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        const confirmed = buildConfirmedRow(dataObj, row);
        confirmed.msgType = "rich_text";
        confirmed.imageUrl = "";
        confirmed.linkAtts = [];
        // 远端真实 url/mime 覆盖乐观行的本地路径占位（readMsgRow 同款三字段）
        confirmed.imageAtts = [];
        for (let i = 0; i < files.length; i++) {
          const att = new ImMsgAtt();
          att.url = files[i].url;
          att.fileName = files[i].name;
          att.mime = files[i].type;
          confirmed.imageAtts.push(att);
        }
        replaceByClientMsgId(confirmed);
        quoteTarget.value = null;
        resetQuoteMentionSnapshot();
        // /api/f/ 受保护地址解析：拿替换进列表后的代理实例改属性才会触发刷新
        const proxied = findRowByClientMsgId(confirmed.clientMsgId);
        if (proxied != null) {
          resolveRowMedia(proxied);
        }
        reportReadIfNeeded(maxSeq());
        refreshReadStatus();
        scrollToBottom();
      } else {
        // 禁言拒发：乐观行移除（不留失败态），handleMuteRejection 内已 toast
        if (handleMuteRejection(res, row.clientMsgId)) return;
        markRowFailed(row.clientMsgId);
        // 群已解散被服务端拒（IM_20105）：切换输入坞为已解散灰条（sendWithRow 同款）
        if (apiResCode(res) == "IM_20105") {
          convDisbanded.value = true;
          uni.showToast({ title: t("Mobile.Message.groupDisbandedSendTip"), icon: "none" });
          return;
        }
        const message = apiResMessage(res);
        uni.showToast({
          title: message.length > 0 ? message : t("Mobile.Message.sendFailed"),
          icon: "none",
        });
      }
    } catch (_error) {
      markRowFailed(row.clientMsgId);
      uni.showToast({ title: t("Mobile.Message.sendFailed"), icon: "none" });
    }
  }

  /**
   * 媒体消息入队：先以本地内容乐观渲染（图片直接显本地路径，文件先出卡片占位），
   * 再走上传+发送。isImage：相册/拍摄恒 true（与 PC kindOf 口径一致）；
   * H5 文件入口传 false，上传后按返回 mime 判定最终类型。
   */
  function queueMediaRow(localPath: string, displayName: string, isImage: boolean): void {
    if (convId.value.length == 0 || localPath.length == 0) {
      return;
    }
    const clientMsgId = generateUUID();
    const row = new ImMsgRow();
    row.msgId = `local-${clientMsgId}`;
    row.clientMsgId = clientMsgId;
    row.local = true;
    row.localPath = localPath;
    row.sendTime = Date.now();
    row.status = 0;
    if (isImage) {
      row.msgType = "image";
      row.imageUrl = localPath;
    } else if (classifyKind("", displayName) == "video") {
      // 视频入队（相册视频入口 displayName 已保 .mp4 等扩展名）：本地路径直接挂
      // 播放器即时预览（videoPlayUrl=localPath），确认后换远端地址重新预载
      row.msgType = "file";
      row.videoUrl = localPath;
      row.videoPlayUrl = localPath;
      row.videoFileName = displayName;
    } else {
      row.msgType = "file";
      const att = new ImMsgAtt();
      att.url = "";
      att.fileName = displayName;
      row.linkAtts = [att];
    }
    applyQuoteToRow(row);
    // 多选媒体逐张入队：引用只挂在第一张上（飞书同款），随即消费掉
    quoteTarget.value = null;
    resetQuoteMentionSnapshot();
    messages.value.push(row);
    scrollToBottom();
    sendMediaWithRow(row, localPath, displayName);
  }

  /**
   * 暂存图消费（发送统一出口）：形态判定对齐 PC chooseMessageShape——
   * 单图无文字 → image 直发（摘要 [图片]，与存量行为逐字一致）；
   * 有文字或多图 → 一条 rich_text（body.text + attachments，PC sendComposed 同契约）。
   * 文字发送键（handleSend）与语音识别（handleVoiceStop）共用：
   * 语音模式下说完自动发送时，同样带上已选暂存图一起发。
   * @return true = 本次消费了暂存图并已发起发送（调用方直接 return）；
   *         false = 无暂存图，调用方走自己的纯文本路径
   */
  function dispatchStagedSend(text: string): boolean {
    if (stagedImages.value.length == 0) {
      return false;
    }
    const paths = [] as string[];
    for (let i = 0; i < stagedImages.value.length; i++) {
      paths.push(stagedImages.value[i].localPath);
    }
    stagedImages.value = [];
    if (text.length == 0 && paths.length == 1) {
      // 单图直发走既有队列（引用消费/乐观行/重试全在 queueMediaRow 链路内，零改动）；
      // 清掉残留的纯空白输入，与 rich_text 分支发送后清空输入框的口径一致
      inputText.value = "";
      queueMediaRow(paths[0], "", true);
      return true;
    }
    const richBody = applyActiveMarks(text);
    inputText.value = "";
    const clientMsgId = generateUUID();
    const row = new ImMsgRow();
    row.msgId = `local-${clientMsgId}`;
    row.clientMsgId = clientMsgId;
    row.local = true;
    row.msgType = "rich_text";
    row.bodyText = richBody;
    const scan = scanMentions(richBody);
    row.mentionIds = scan.ids;
    row.mentionAll = scan.all;
    applyRichToRow(row);
    applyQuoteToRow(row);
    for (let i = 0; i < paths.length; i++) {
      const att = new ImMsgAtt();
      att.url = paths[i];
      // mime 占位：isImageAtt 按 image/ 前缀判定，本地临时路径可能无扩展名，
      // 不占位会误进 linkAtts 渲染成链接卡片；确认行会被真实 mime 覆盖
      att.mime = "image/jpeg";
      row.imageAtts.push(att);
    }
    row.sendTime = Date.now();
    row.status = 0;
    messages.value.push(row);
    scrollToBottom();
    sendRichTextWithRow(row, paths);
    return true;
  }

  function handleSend(): void {
    if (pageTapSwallowed()) {
      return;
    }
    // 群已解散：入口禁发（服务端 IM_20105 兜底，这里挡住误触）
    if (convDisbanded.value) {
      uni.showToast({ title: t("Mobile.Message.groupDisbandedSendTip"), icon: "none" });
      return;
    }
    const text = inputText.value.trim();
    // 图文合并发送后：文案与暂存图均空才无内容可发
    if ((text.length == 0 && stagedImages.value.length == 0) || convId.value.length == 0) {
      return;
    }
    // 编辑态：正文原样提交（submitEdit 内不走 applyActiveMarks，见其注释）；
    // 编辑不带图——暂存条保留不动，退出编辑态后仍可图文一起发
    if (editTarget.value != null) {
      submitEdit(text);
      return;
    }
    // ===== 暂存图分支（语音/文字键共用的发送统一出口，见 dispatchStagedSend） =====
    if (dispatchStagedSend(text)) {
      return;
    }
    const body = applyActiveMarks(text);
    inputText.value = "";
    const clientMsgId = generateUUID();
    const row = new ImMsgRow();
    row.msgId = `local-${clientMsgId}`;
    row.clientMsgId = clientMsgId;
    row.local = true;
    row.bodyText = body;
    const scan = scanMentions(body);
    row.mentionIds = scan.ids;
    row.mentionAll = scan.all;
    applyRichToRow(row);
    applyQuoteToRow(row);
    row.sendTime = Date.now();
    row.status = 0;
    messages.value.push(row);
    scrollToBottom();
    sendWithRow(row);
  }

  // ===== 语音消息播放（msgType=audio：页面级单一 InnerAudioContext，点气泡播放/再点停止复位） =====
  // InnerAudioContext 全平台可用（uni-app x：Web 4.0+/Android 4.33+/iOS 4.41+），无需条件编译；
  // 同一时刻只播一条：换条/再点/离开页面（onHide 停播、onUnload 销毁）都从头来。

  /** 正在播放的语音 msgId（空=无；模板直读它切 --playing 态）。 */
  const playingAudioId = ref<string>("");
  /** 声波跳动 tick（播放中 150ms +1；模板绑定以尾参直读它——App-Android 方法调用绑定不收集方法体内依赖）。 */
  const voiceTick = ref<number>(0);
  let chatAudioCtx: InnerAudioContext | null = null;
  let voiceTickTimer = 0;

  /** 声波条静态高度 px（两侧低中间高）；播放态叠随机抖动模拟音量（按住说话浮层同款手法）。 */
  const VOICE_BAR_BASE: number[] = [7, 14, 10, 5];

  function voiceBarH(msg: ImMsgRow, index: number, _tick: number): number {
    const base = VOICE_BAR_BASE[index];
    if (msg.msgId != playingAudioId.value) {
      return base;
    }
    return base + Math.random() * 6;
  }

  /** 时长文案：秒 → N"（<=0 不展示，等首播回填）。 */
  function audioDurationLabelOf(msg: ImMsgRow): string {
    if (msg.audioDuration <= 0) {
      return "";
    }
    return `${Math.round(msg.audioDuration)}"`;
  }

  function startVoiceTickTimer(): void {
    if (voiceTickTimer != 0) {
      clearInterval(voiceTickTimer);
    }
    voiceTickTimer = setInterval((): void => {
      voiceTick.value = voiceTick.value + 1;
    }, 150);
  }

  function stopVoiceTickTimer(): void {
    if (voiceTickTimer != 0) {
      clearInterval(voiceTickTimer);
      voiceTickTimer = 0;
    }
  }

  /** 首播回填时长：body 无 duration 的消息，播放器拿到真实时长后写回行
   * （UTS class 就地赋值不触发视图，须 splice 整行替换）。 */
  function backfillAudioDuration(sec: number): void {
    const id = playingAudioId.value;
    if (id.length == 0 || sec <= 0 || sec > 36000) {
      return;
    }
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].msgId == id && rows[i].audioDuration <= 0) {
        const row = rows[i];
        row.audioDuration = Math.round(sec);
        rows.splice(i, 1, row);
        return;
      }
    }
  }

  function ensureChatAudioCtx(): InnerAudioContext {
    const existed = chatAudioCtx;
    if (existed != null) {
      return existed;
    }
    const ctx = uni.createInnerAudioContext();
    ctx.onEnded(() => {
      playingAudioId.value = "";
      stopVoiceTickTimer();
    });
    ctx.onError((err) => {
      console.error("[ChatAudio] play failed", err);
      playingAudioId.value = "";
      stopVoiceTickTimer();
      uni.showToast({ title: t("Mobile.Message.audioPlayFailed"), icon: "none" });
    });
    ctx.onTimeUpdate(() => {
      if (playingAudioId.value.length == 0) {
        return;
      }
      const dur = ctx.duration;
      if (dur > 0) {
        backfillAudioDuration(dur);
      }
    });
    chatAudioCtx = ctx;
    return ctx;
  }

  /** 停止当前播放（复位到头；播放态与跳动 timer 一并收）。 */
  function stopChatAudio(): void {
    const ctx = chatAudioCtx;
    if (ctx != null) {
      ctx.stop();
    }
    playingAudioId.value = "";
    stopVoiceTickTimer();
  }

  /** 页面卸载销毁（InnerAudioContext 用完必须 destroy 释放资源）。 */
  function destroyChatAudio(): void {
    const ctx = chatAudioCtx;
    if (ctx != null) {
      ctx.stop();
      ctx.destroy();
      chatAudioCtx = null;
    }
    playingAudioId.value = "";
    stopVoiceTickTimer();
  }

  /** onHide 停语音判后台延迟复检定时器（见 stopChatAudioOnHideIfNeeded）。 */
  let stopAudioOnHideTimer = 0;

  /** onHide 停语音前的后台判别：息屏/锁屏/切后台不打断播放（继续播完）；只有进子页
   *  （应用仍前台）才停。App.onHide 与 Page.onHide 触发先后不稳：先即查一次，不能
   *  定论再延迟 400ms 复检——届时 App.onHide 已落后台标记则放行续播。 */
  function stopChatAudioOnHideIfNeeded(): void {
    if (playingAudioId.value.length == 0) {
      return;
    }
    // 已后台：息屏/锁屏/切后台 → 继续播完，不停
    if (isAppInBackground()) {
      return;
    }
    const playingId = playingAudioId.value;
    if (stopAudioOnHideTimer != 0) {
      clearTimeout(stopAudioOnHideTimer);
    }
    stopAudioOnHideTimer = setTimeout((): void => {
      stopAudioOnHideTimer = 0;
      // 会话没换（未被手动停/换条）且届时仍前台 = 真导航进子页 → 停（微信同款）
      if (playingAudioId.value == playingId && isAppInBackground() != true) {
        stopChatAudio();
      }
    }, 400);
  }

  /** 清判后台复检定时器（onUnload 用：销毁后不得再触发 stopChatAudio）。 */
  function clearStopAudioOnHideTimer(): void {
    if (stopAudioOnHideTimer != 0) {
      clearTimeout(stopAudioOnHideTimer);
      stopAudioOnHideTimer = 0;
    }
  }

  // 受保护语音地址（/api/f/ 需 Bearer）解析：缓存 + 在途去重，机制同 resolveChatVideo。
  // iOS InnerAudioContext 裸播受保护地址不带鉴权头必失败（用户真机反馈「语音播放失败」），
  // 须先换 App tempPath / H5 blob 再喂 src；本地乐观行路径与非保护直链原样透传。
  const chatAudioResolved = new Map<string, string>();
  const chatAudioRequests = new Map<string, Promise<string>>();

  async function resolveChatAudioUrl(url: string): Promise<string> {
    if (isAuthProtectedFileUrl(url) != true) {
      return url;
    }
    const cached = chatAudioResolved.get(url);
    if (cached != null) {
      return cached;
    }
    const existing = chatAudioRequests.get(url);
    if (existing != null) {
      return await existing;
    }
    const task = fetchAuthProtectedFileDisplayUrl(url);
    chatAudioRequests.set(url, task);
    try {
      const resolved = await task;
      if (!isChatCurrent()) {
        releaseDisplayImageUrl(resolved);
        return url;
      }
      chatAudioResolved.set(url, resolved);
      return resolved;
    } finally {
      chatAudioRequests.delete(url);
    }
  }

  // ===== 视频消息模板事件处理器（预载状态与函数见本页前段「视频预载」块） =====
  // 按 msgId 寻址各自 <video>（每行常驻实例）；置于语音块之后：点按互斥需 stopChatAudio。

  /** 播放状态回写（video @play/@pause）：轻触切播放/暂停的方向依据。 */
  function handleVideoPlaying(msgId: string): void {
    playingVideoIds.add(msgId);
  }

  function handleVideoPaused(msgId: string): void {
    playingVideoIds.delete(msgId);
  }

  /** 播放结束：seek(0) 定格首帧当封面（原生控制条可直接重播）；全屏态播完先退全屏。 */
  function handleVideoEnded(msgId: string): void {
    playingVideoIds.delete(msgId);
    const el = getChatVideoElement(msgId);
    if (el == null) {
      return;
    }
    if (videoFullscreen.value) {
      el.exitFullScreen();
      videoFullscreen.value = false;
    }
    el.seek(0);
  }

  /** 播放器报错：ak 流式直链可能过期（页面停留久了再点播）或该端播放器不跟 302——
   *  作废该行解析缓存并自动重解析一次，且直接走整段下载兜底（重换 ak 无意义）；
   *  已重试过或非受保护行维持日志 + toast（保持挂载，系统播放键自带重试）。 */
  function handleVideoError(msgId: string): void {
    console.error(`[ChatVideo] 播放器报错 msgId=${msgId}`);
    if (!videoRetryIds.has(msgId)) {
      for (let i = 0; i < messages.value.length; i++) {
        const row = messages.value[i];
        if (row.msgId == msgId) {
          if (isAuthProtectedFileUrl(row.videoUrl) && row.videoPlayUrl.length > 0) {
            videoRetryIds.add(msgId);
            playingVideoIds.delete(msgId);
            chatVideoResolved.delete(row.videoUrl);
            row.videoPlayUrl = "";
            preloadChatVideoRow(msgId, row.videoUrl, false);
            return;
          }
          break;
        }
      }
    }
    uni.showToast({ title: t("Mobile.Message.videoPlayFailed"), icon: "none" });
  }

  /** 全屏状态变化：只回写标记（任一视频全屏时隐藏 Android 兜底按钮）；退全屏不清
   *  播放状态——<video> 原地继续内联播放（用户要求：关全屏回会话页原位续播）。 */
  function handleVideoFullscreenChange(event: UniVideoFullScreenChangeEvent): void {
    videoFullscreen.value = event.detail.fullScreen;
  }

  /** Android 全屏入口（video 子组件层按钮，按 msgId 寻址）：requestFullScreen 传
   *  null = 按视频宽高比自动定方向（横屏录屏转横屏；auto 判定 5.21 起修复，基座 5.26 可用）。 */
  function requestChatVideoFullscreen(msgId: string): void {
    const el = getChatVideoElement(msgId);
    if (el == null) {
      return;
    }
    el.requestFullScreen(null);
  }

  /** 视频区点按：已挂载=轻触整面切换播放/暂停（原生中央播放键只覆盖中心小区域，
   *  表面其余区域 5.13+ 基座不拦截触摸、会冒泡到本层——补齐微信同款整面轻触切换；
   *  中央键/控制条仍归原生，各自消费各自的触摸不会双触发）；未挂载=占位卡 ▶ 手动预载。 */
  function handleVideoMsgTap(msg: ImMsgRow): void {
    if (rowPressFired || pageTapSwallowed()) {
      return;
    }
    if (multiGuard(msg)) {
      return;
    }
    if (msg.videoUrl.length == 0) {
      return;
    }
    if (msg.videoPlayUrl.length > 0) {
      // 全屏态不接管：点按留给原生播放器弹左上角标题+返回顶栏（真机实测全屏触摸
      // 仍会冒泡到本层，我们再 play/pause 会把顶栏弹出时机顶掉，只剩播放/暂停）
      if (videoFullscreen.value) {
        return;
      }
      const el = getChatVideoElement(msg.msgId);
      if (el == null) {
        return;
      }
      // 音视频互斥（语音侧见 handleAudioMsgTap 开头）
      stopChatAudio();
      if (playingVideoIds.has(msg.msgId)) {
        el.pause();
      } else {
        el.play();
      }
      return;
    }
    if (msg.msgId == videoLoadingId.value) {
      return;
    }
    // 音视频互斥（语音侧见 handleAudioMsgTap 开头）
    stopChatAudio();
    preloadChatVideoRow(msg.msgId, msg.videoUrl);
  }

  /** 语音气泡点按：播放/停止（微信同款——再点停止复位，换条从头播；播视频先停视频，音视频互斥）。
   *  受保护地址先解析（见 resolveChatAudioUrl）：解析期间即显播放态，期间再点同条=停止，
   *  resolve 回来发现已停/换条则丢弃，不抢播。 */
  async function handleAudioMsgTap(msg: ImMsgRow): Promise<void> {
    pauseChatVideos();
    if (msg.msgId == playingAudioId.value) {
      stopChatAudio();
      return;
    }
    const ctx = ensureChatAudioCtx();
    ctx.stop();
    playingAudioId.value = msg.msgId;
    startVoiceTickTimer();
    let src = msg.audioUrl;
    try {
      src = await resolveChatAudioUrl(msg.audioUrl);
    } catch (_e) {
      console.error(`[ChatAudio] resolve failed url=${msg.audioUrl}`);
      stopChatAudio();
      uni.showToast({ title: t("Mobile.Message.audioPlayFailed"), icon: "none" });
      return;
    }
    if (msg.msgId != playingAudioId.value || !isChatCurrent()) {
      return;
    }
    ctx.src = src;
    ctx.play();
  }

  // ===== 合并转发聊天记录详情（点卡片进全页：载荷走 imMergeRecordSession 暂存，详情页 onLoad 取） =====
  function openMergeDetail(msg: ImMsgRow): void {
    if (msg.mergeAllItems.length == 0) {
      return;
    }
    const session = new ImMergeRecordSession();
    session.title = msg.mergeTitle.length > 0 ? msg.mergeTitle : t("Mobile.Message.mergeForwardFallbackTitle");
    session.convId = convId.value;
    session.items = msg.mergeAllItems;
    openImMergeRecord(session);
  }

  /** 失败行点击重试：复用同一 clientMsgId，服务端幂等保证不会发重（媒体行走上传重发）。 */
  function handleBubbleTap(msg: ImMsgRow): void {
    if (rowPressFired || pageTapSwallowed()) {
      return;
    }
    if (multiGuard(msg)) {
      return;
    }
    // 语音消息：点按=播放/停止（微信同款；不出时间行）
    if (msg.msgType == "audio" && msg.audioUrl.length > 0) {
      handleAudioMsgTap(msg);
      return;
    }
    // 合并转发卡片：点卡片拉起聊天记录详情侧栏（气泡内仅前 2 条预览）
    if (msg.msgType == "merge_forward" && msg.mergeItems.length > 0) {
      openMergeDetail(msg);
      return;
    }
    if (msg.status == 2 && msg.local) {
      // 图文混排行重试：imageAtts 里仍是本地路径（确认替换只发生在成功后），
      // 全量重传（部分已上传的 URL 不缓存；clientMsgId 幂等保证不会发重）
      if (msg.msgType == "rich_text" && msg.imageAtts.length > 0) {
        const retryPaths = [] as string[];
        for (let i = 0; i < msg.imageAtts.length; i++) {
          retryPaths.push(msg.imageAtts[i].url);
        }
        sendRichTextWithRow(msg, retryPaths);
        return;
      }
      if (msg.localPath.length > 0) {
        sendMediaWithRow(
          msg,
          msg.localPath,
          // 视频占位行无 linkAtts，展示名从 videoFileName 取（重传保原文件名）
          msg.linkAtts.length > 0 ? msg.linkAtts[0].fileName : msg.videoFileName,
        );
        return;
      }
      sendWithRow(msg);
    }
    // 微信同款：点消息内容切换显示/隐藏这条消息的时间（失败重发路径除外——那一下的重心是重发）
    timeRevealedId.value = timeRevealedId.value == msg.msgId ? "" : msg.msgId;
  }

  /** 图片可入滑动预览列表：空地址与未解析的 /api/f/ 受保护直链剔除（带不了 Bearer，进系统查看器必然空白）。 */
  function isPreviewableChatImage(url: string): boolean {
    return url.length > 0 && isAuthProtectedFileUrl(url) != true;
  }

  /** 会话内全部可预览图片（升序遍历 messages = 视觉顺序，含向上翻页加载的更早消息）：
   *  image 主图 + rich_text 的 imageAtts。被剔除的受保护未解析图由点击处回落单张预览（与旧行为一致）。 */
  function collectChatPreviewImages(): string[] {
    const urls: string[] = [];
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      if (row.msgType == "image" && isPreviewableChatImage(row.imageUrl)) {
        urls.push(row.imageUrl);
      }
      for (let j = 0; j < row.imageAtts.length; j++) {
        if (isPreviewableChatImage(row.imageAtts[j].url)) {
          urls.push(row.imageAtts[j].url);
        }
      }
    }
    return urls;
  }

  /** 图片消息点击：全屏放大预览（长按拉起面板后的那次 click 吞掉，不预览）。
   *  以本张为起点收集全会话图片走 previewImageCompat——App/自绘遮罩均支持左右滑动浏览其余图片。 */
  function handleImageMsgTap(msg: ImMsgRow): void {
    if (rowPressFired || pageTapSwallowed()) {
      return;
    }
    if (multiGuard(msg)) {
      return;
    }
    if (msg.imageUrl.length == 0) {
      return;
    }
    const urls = collectChatPreviewImages();
    if (urls.indexOf(msg.imageUrl) >= 0) {
      previewImageCompat(urls, msg.imageUrl);
    } else {
      // 本张是被剔除的未解析受保护图（缩略图本身也多在解析中/失败）：维持单张旧路径不劣化
      previewImageCompat([msg.imageUrl], msg.imageUrl);
    }
  }

  /** 图片渲染失败诊断（Q4：Android 不出图排查——logcat 抓 [ChatImg] 定位失败 src）。 */
  function handleImageRenderError(msg: ImMsgRow): void {
    console.error(`[ChatImg] 主图渲染失败 msgId=${msg.msgId} src=${msg.imageUrl}`);
  }

  function handleAttImageRenderError(att: ImMsgAtt): void {
    console.error(`[ChatImg] 附件图渲染失败 src=${att.url}`);
  }

  /** rich_text 图片附件点击：全屏放大预览（同主图：长按后的 click 吞掉；同样支持全会话多图滑动）。 */
  function handleAttImageTap(msg: ImMsgRow, att: ImMsgAtt): void {
    if (rowPressFired || pageTapSwallowed() || multiSwallow()) {
      return;
    }
    if (att.url.length == 0) {
      return;
    }
    const urls = collectChatPreviewImages();
    if (urls.indexOf(att.url) >= 0) {
      previewImageCompat(urls, att.url);
    } else {
      previewImageCompat([att.url], att.url);
    }
  }

  /** 无预览意义、PC 端点击即下载的二进制扩展名（小写）。tmp = 服务端未能识别类型的
   *  原始流（mime application/tmp）：预览页/查看器都无从渲染，只能下载。 */
  const DOWNLOAD_ONLY_EXTS: string[] = [
    "zip", "rar", "7z", "tar", "gz", "bz2", "xz",
    "apk", "ipa", "exe", "msi", "dmg", "pkg", "iso", "jar",
    "tmp",
  ];

  /** 文件名与 URL 任一命中下载扩展名即下载：服务端把未识别文件存成 .tmp（URL 是
   *  事实口径），文件名却可能保留 .pdf 等展示后缀——只看文件名会漏判。 */
  function isDownloadOnlyAttachment(fileName: string, url: string): boolean {
    const fileExt = extOf(fileName);
    if (fileExt.length > 0 && DOWNLOAD_ONLY_EXTS.indexOf(fileExt) >= 0) {
      return true;
    }
    const remoteExt = urlExtOf(url);
    return remoteExt.length > 0 && DOWNLOAD_ONLY_EXTS.indexOf(remoteExt) >= 0;
  }

  /** 网页类后缀：URL 带后缀但仍是网页地址（webview 可直接渲染），点击走外链打开而非下载。 */
  const WEB_PAGE_EXTS: string[] = ["html", "htm", "xhtml"];

  /** 链接地址本身带文件后缀（且非 html 等网页类）＝指向一个文件而非网页：文档类
   *  （pdf/docx…，含 zip/apk 与视频音频后缀；md/markdown 例外走预览页，见
   *  isMarkdownUrl）webview 打不开、文件预览页 shareKey 又不认 IM convId
   *  （conversation not found 白屏），点击统一直接下载（App 存 Download 目录
   *  +「打开」确认；H5 带 Bearer 拉 blob 下载），对齐 PC 点击即下载。 */
  function isFileUrlByExt(url: string): boolean {
    const ext = urlExtOf(url);
    return ext.length > 0 && WEB_PAGE_EXTS.indexOf(ext) < 0;
  }

  /** markdown 后缀（小写）：纯文本文档，系统查看器/下载后「打开」都渲染不了——
   *  受保护链接（/api/f/）走文件预览页渲染，外部地址走 webview（github blob 页
   *  站点自带渲染、raw 链接按纯文本展示），一律不进下载。 */
  const MARKDOWN_EXTS: string[] = ["md", "markdown"];

  function isMarkdownUrl(url: string): boolean {
    const ext = urlExtOf(url);
    return ext.length > 0 && MARKDOWN_EXTS.indexOf(ext) >= 0;
  }

  /**
   * 无可预览二进制（附件卡片与正文裸链共用，对齐 PC 点击即下载）：App 走 downloadFileInApp
   * （Android 拷入公共 Download 目录并弹「打开」确认；受保护 /api/f/ 带 Bearer、
   * s3p 裸直链不带——对象存储会把 Authorization 头当非法签名解析），H5/小程序走
   * openRemoteFileUrl（blob 下载/系统查看器）。不进文件预览页——预览页
   * shareKey 走智能体域 /api/agent/conversation/share，IM convId 会报
   * conversation not found；且 zip/apk 本就无可预览内容。
   */
  function handleBinaryUrlDownload(url: string, fileName: string): void {
    const name = fileName.length > 0 ? fileName : extractFileNameFromUrl(url);
    // #ifdef APP
    const protectedFile = isAuthProtectedFileUrl(url);
    const downloadUrl = protectedFile ? resolveAuthProtectedFileFetchUrl(url) : url;
    downloadFileInApp(downloadUrl, name, protectedFile).catch((_e: any | null): void => {
      // downloadFileInApp 内部已 toast 失败原因，这里只吞未处理拒绝
    });
    // #endif
    // #ifndef APP
    openRemoteFileUrl(url, name).catch((_e: any | null): void => {
      uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
    });
    // #endif
  }

  /** 文件/链接附件点击：链接地址带文件后缀（文档类，非普通网页地址）直接下载；
   *  无后缀的 /api/f/ 受保护链接跳文件预览页；普通网页链接走统一外链打开。
   *  rowPressFired：长按拉起面板后抬手补发的 click 吞掉——三星等端长按抬手仍合成 click，
   *  不吞会当场打开链接/预览页，webview 盖住刚弹的面板（真机表现即「长按链接拉不起菜单」）。 */
  function handleLinkAttTap(att: ImMsgAtt): void {
    if (rowPressFired || pageTapSwallowed() || multiSwallow()) {
      return;
    }
    if (att.url.length == 0) {
      return;
    }
    // md/markdown 纯文本：受保护链接（/api/f/）走文件预览页渲染（同无后缀文档类，
    // URL 附 source=im）；外部 md 地址（github blob 等）本质是网页/纯文本，webview
    // 直接可读——都不下载
    if (isMarkdownUrl(att.url)) {
      if (isAuthProtectedFileUrl(att.url)) {
        openAuthProtectedLinkUrl(att.url, att.fileName, convId.value).catch((_e: any | null) => {
          uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
        });
        return;
      }
      handleExternalLink(att.url, att.fileName);
      return;
    }
    // 链接地址带文件后缀（pdf/zip/mp4…）：文档类 webview/预览页都无出路，直接下载
    // （PC 同款点击即下载）；下方 zip/视频音频两支仅兜 mime 命中而 URL 无后缀的形态
    if (isFileUrlByExt(att.url)) {
      handleBinaryUrlDownload(att.url, att.fileName);
      return;
    }
    if (isAuthProtectedFileUrl(att.url)) {
      // zip/apk/.tmp 等无可预览二进制：直接下载（PC 同款），不跳文件预览页
      if (isDownloadOnlyAttachment(att.fileName, att.url)) {
        handleBinaryUrlDownload(att.url, att.fileName);
        return;
      }
      // 视频/音频链接卡片（rich_text 多视频的第 2+ 条等遗留形态）：文件预览页
      // shareKey 不认 IM convId（conversation not found），走下载兜底（H5 新标签
      // 浏览器直接播 / App 下载后系统播放器打开），不再进坏死页面
      if (classifyKind(att.mime, att.url) == "video" || classifyKind(att.mime, att.url) == "audio") {
        handleBinaryUrlDownload(att.url, att.fileName);
        return;
      }
      // 文档类：带 convId 跳文件预览页（URL 附 source=im）。预览页侧正在改造：IM 来源
      // 只预览文件、不调 /api/agent/conversation/share（IM convId 在该智能体域接口必报
      // conversation not found）；改造上线前此处会白屏+错误 toast，属已知过渡态。
      openAuthProtectedLinkUrl(att.url, att.fileName, convId.value).catch((_e: any | null) => {
        uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
      });
      return;
    }
    handleExternalLink(att.url, att.fileName);
  }

  /**
   * 富文本段点击：链接段打开链接（.stop 断气泡冒泡，路由同附件点击——地址带文件
   * 后缀直接下载、无后缀 /api/f/ 走预览页、外链走 webview）；其余段转交气泡点按，
   * 保住时间显示/失败重发语义。
   */
  function handleSegTap(msg: ImMsgRow, sg: ImSeg): void {
    // rowPressFired：长按拉面板后抬手补发的 click 吞掉（链接段尤其关键：不吞则当场
    // 打开链接盖住面板；非链接段交由下方 handleBubbleTap 的同款守卫，双保险）
    if (rowPressFired || pageTapSwallowed() || multiSwallow()) {
      return;
    }
    if (sg.link && sg.url.length > 0) {
      let url = sg.url;
      // 后端下发的链接可能带 HTML 实体（&amp; 等）：还原后才是真实地址，否则 403/404
      url = unescapeHtmlEntities(url);
      // 站内相对路径（系统通知的 /home/... 链接）：web-view/外链页只认完整地址，
      // 点击时补域名（与卡片 actionUrl 同款补全；PC 端也是渲染时才补域名）
      const base = getApiBaseUrl();
      if (url.indexOf("/") == 0 && url.indexOf("//") != 0 && base.length > 0) {
        url = base + url;
      }
      // zip/apk/.tmp 等无可预览二进制：与附件卡片同款直接下载（App 存 Download 目录
      // +「打开」确认）。原路径受保护 zip 走 openDocument 打不开、非受保护 s3p 直链
      // 走外链 webview 白屏，都无出路。
      if (isDownloadOnlyAttachment(sg.text, url)) {
        handleBinaryUrlDownload(url, sg.text);
        return;
      }
      // md/markdown 纯文本：同附件卡片——受保护链接（/api/f/）走文件预览页渲染，
      // 外部 md 地址走 webview（网页/纯文本可读），都不下载
      if (isMarkdownUrl(url)) {
        if (isAuthProtectedFileUrl(url)) {
          openAuthProtectedLinkUrl(url, sg.text, convId.value).catch((_e: any | null) => {
            uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
          });
          return;
        }
        handleExternalLink(url, sg.text);
        return;
      }
      // 链接地址带文件后缀（文档类，非普通网页地址）：同附件卡片直接下载——正文里
      // 的 pdf/docx 等外链 webview 渲不了、受保护的进预览页又白屏，都无出路
      if (isFileUrlByExt(url)) {
        handleBinaryUrlDownload(url, sg.text);
        return;
      }
      if (isAuthProtectedFileUrl(url)) {
        // 同附件点击：带 convId 跳预览页（URL 附 source=im，预览端只预览不调 share 接口）
        openAuthProtectedLinkUrl(url, sg.text, convId.value).catch((_e: any | null) => {
          uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
        });
        return;
      }
      handleExternalLink(url, sg.text);
      return;
    }
    handleBubbleTap(msg);
  }

  /** 卡片跳转链接（actionUrl）点击：飞书式——应用内 webview 页直接加载原始链接。
      web-view 里的页面若需登录，在 webview 里登录一次即可（cookie 留存，之后直达），
      应用侧不代填任何登录态（站内页不认 _ticket，拼了也无用）。
      受保护文件链接仍走「打开页面」预览流（webview/浏览器无 Bearer 打不开）。 */
  function handleCardLinkTap(msg: ImMsgRow): void {
    if (rowPressFired || pageTapSwallowed() || multiSwallow()) {
      return;
    }
    let url = msg.cardActionUrl.trim();
    if (url.length == 0) {
      return;
    }
    // 消息体的 actionUrl 可能是站内相对路径（如 /repo/doc/xxx，PC 端渲染时才补域名），
    // web-view 只能加载完整地址，不补全就是白屏（此前 iPhone 白屏的根因）
    const base = getApiBaseUrl();
    if (url.indexOf("/") == 0 && url.indexOf("//") != 0 && base.length > 0) {
      url = base + url;
    }
    // 站内会话详情链接直接跳原生 agent-detail（Android/鸿蒙；与链接段点击同理由）
    if (openNativeHomeChatLink(url)) {
      return;
    }
    if (isAuthProtectedFileUrl(url)) {
      openAuthProtectedLinkUrl(url).catch((_e: any | null) => {
        uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
      });
      return;
    }
    if (!url.startsWith("https://") && !url.startsWith("http://")) {
      // 非 http(s) 协议（mailto: 等）内嵌页加载不了，交外链逻辑兜底
      handleExternalLink(url, t("Mobile.Message.cardViewDetail"));
      return;
    }
    uni.navigateTo({
      url:
        `/subpackages/pages/webview/webview?url=${encodeURIComponent(url)}` +
        `&title=${encodeURIComponent(t("Mobile.Message.cardViewDetail"))}`,
    });
  }

  /** 纯链接文本点击：整条即链接，直接打开（微信交互）。rowPressFired 同链接附件：
   *  长按拉面板后抬手补发的 click 必须吞掉，否则链接打开盖住面板。 */
  function handleLinkTextTap(msg: ImMsgRow): void {
    if (rowPressFired || pageTapSwallowed() || multiSwallow()) {
      return;
    }
    if (isUrlMsg(msg)) {
      handleExternalLink(msg.bodyText.trim(), "");
    }
  }

  /** 引用块点击：进全屏引用详情页（左下角可「定位到聊天位置」跳回）。 */
  function handleQuoteTap(msg: ImMsgRow): void {
    if (rowPressFired || pageTapSwallowed() || multiSwallow()) {
      return;
    }
    if (msg.replyId.length == 0 || convId.value.length == 0) {
      return;
    }
    uni.navigateTo({
      url: `/pages/message/quote-detail?convId=${convId.value}&msgId=${msg.replyId}`,
    });
  }

  // ===== 「定位到聊天位置」：滚动定位 + 背景快速切换高亮 =====
  let flashTimers: number[] = [];

  function clearFlashTimers(): void {
    for (let i = 0; i < flashTimers.length; i++) {
      clearTimeout(flashTimers[i]);
    }
    flashTimers.splice(0, flashTimers.length);
    highlightId.value = "";
  }

  /** 高亮闪烁：亮 350ms → 灭 300ms → 再亮 350ms（参考微信的快速切换展示）。 */
  function flashHighlight(msgId: string): void {
    clearFlashTimers();
    highlightId.value = msgId;
    flashTimers.push(
      setTimeout(() => {
        highlightId.value = "";
      }, 350)
    );
    flashTimers.push(
      setTimeout(() => {
        highlightId.value = msgId;
      }, 650)
    );
    flashTimers.push(
      setTimeout(() => {
        highlightId.value = "";
      }, 1000)
    );
  }

  function findMsgById(msgId: string): ImMsgRow | null {
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].msgId == msgId) {
        return rows[i];
      }
    }
    return null;
  }

  /** 应用待定位：滚到目标行并闪烁高亮（幂等，消费 pendingJumpId）。 */
  function applyPendingJump(): void {
    const msgId = pendingJumpId;
    if (msgId.length == 0) {
      return;
    }
    if (findMsgById(msgId) == null) {
      return;
    }
    pendingJumpId = "";
    scrollAnchor.value = "";
    nextTick(() => {
      scrollAnchor.value = `msg-${msgId}`;
      listSettled.value = true;
      flashHighlight(msgId);
      // 引用/搜索跳转常落在中部历史区：落定后校准浮钮（亮）
      scheduleJumpLatestCheck(60);
    });
  }

  /**
   * 定位到某条消息：不在已加载区间则持续向前翻页（最多 15 页）。
   * ★滚动/高亮不在本函数直接做：emit 时本页还被 quote-detail 盖着，隐藏状态下
   *   scroll-into-view 不生效——统一延到 onShow（页面重新可见）后再应用。
   */
  async function jumpToMsg(msgId: string): Promise<void> {
    entryFollowLatest = false;
    cancelSettle();
    let pages = 0;
    while (findMsgById(msgId) == null && pages < 15) {
      if (loading.value || loadFailed.value || messages.value.length == 0 || hasMore.value != true) {
        break;
      }
      pages++;
      const oldestSeq = messages.value[0].seq;
      await loadHistory(oldestSeq);
    }
    if (findMsgById(msgId) == null) {
      // ES 全量命中的消息可能早于窗口可翻页到达的范围（15 页 × 20 条，与 Pin/引用详情同上限）：
      // 消费掉待定位并提示，避免回到聊天页后静默无操作、pendingJumpId 悬挂
      pendingJumpId = "";
      uni.showToast({ title: t("Mobile.Message.jumpOutOfRange"), icon: "none" });
      return;
    }
    if (pageVisible) {
      // 页面本就可见（数据补齐即可应用）：onShow 不会再触发，这里直接应用
      applyPendingJump();
    }
  }

  /** 引用详情页 emit 的跳转事件（payload 为目标 msgId 字符串）。 */
  function onJumpEvent(data: any): void {
    const msgId = data == null ? "" : `${data}`;
    if (msgId.length == 0) {
      return;
    }
    pendingJumpId = msgId;
    jumpToMsg(msgId);
  }

  // ===== 按住说话全屏蒙层（liveAsr 三阶段状态机）=====
  // idle=无 / recording=按住中（波形，蒙层不拦截触摸）/ processing=松手识别中 /
  // editing=识别完成可编辑（卡片+三按钮，蒙层拦截触摸）。
  // 显隐起点跟随 voice-recorder-button 的 onVisualActive（权限门控在子组件内）；
  // liveAsr 松手后流程由 onLiveProcessing/onLiveResult/onError 接管（onVisualActive(false)
  // 只结束 recording 态，不关 processing/editing——组件在等 asr_result 期间已复位视觉）。
  const voiceStage = ref<string>("idle");
  const recordWillCancel = ref<boolean>(false);
  const recordOverlayHint = computed((): string => {
    if (recordWillCancel.value == true) {
      return t("Mobile.CreateHub.releaseToCancel");
    }
    return t("Mobile.Voice.releaseToTranscribe");
  });
  /** editing：识别文本草稿（可编辑后发文本；空文本确认键置灰） */
  const voiceDraftText = ref<string>("");
  /** editing：轻触卡片才拉键盘（voiceDraftFocus 置 true 触发 textarea 聚焦） */
  const voiceDraftFocus = ref<boolean>(false);
  /** editing：本轮录音 PCM 文件（仅发语音用；路径空=元数据丢失，按钮隐藏） */
  const voicePcmPath = ref<string>("");
  const voicePcmDurationMs = ref<number>(0);
  const voicePcmFileSize = ref<number>(0);
  /** 仅发语音上传中（防重复点击；确认键同步置灰） */
  const voiceAudioSending = ref<boolean>(false);

  /** 波形条（高 px）；150ms 全量重算=跳动，App 端无 height 过渡，跳动即动画 */
  class ChatWaveformBar {
    height: number;
    constructor(height: number) {
      this.height = height;
    }
  }
  const waveformBars = ref<ChatWaveformBar[]>([] as ChatWaveformBar[]);
  let voiceWaveTimer = 0;

  /** 波形包络：中间高两侧低（1-dist²）叠随机抖动模拟音量起伏（参考实现同款参数）。 */
  function computeWaveBarHeight(index: number, numBars: number): number {
    const mid = (numBars - 1) / 2;
    const dist = Math.abs(index - mid) / mid;
    const envelope = 1 - dist * dist;
    const base = 4 + envelope * 26;
    const jitter = Math.random() * (4 + envelope * 8);
    return base + jitter;
  }

  function initWaveform(): void {
    const numBars = 42;
    const arr = [] as ChatWaveformBar[];
    for (let index = 0; index < numBars; index++) {
      arr.push(new ChatWaveformBar(computeWaveBarHeight(index, numBars)));
    }
    waveformBars.value = arr;
  }

  function updateWaveform(): void {
    const total = waveformBars.value.length;
    const arr = [] as ChatWaveformBar[];
    for (let index = 0; index < total; index++) {
      arr.push(new ChatWaveformBar(computeWaveBarHeight(index, total)));
    }
    waveformBars.value = arr;
  }

  function startVoiceWaveTimer(): void {
    if (voiceWaveTimer != 0) {
      clearInterval(voiceWaveTimer);
    }
    voiceWaveTimer = setInterval((): void => {
      updateWaveform();
    }, 150);
  }

  function stopVoiceWaveTimer(): void {
    if (voiceWaveTimer != 0) {
      clearInterval(voiceWaveTimer);
      voiceWaveTimer = 0;
    }
  }

  /** 按钮视觉激活态（按下且权限通过）：蒙层淡入进 recording + 波形起跳。
   *  active=false 只把 recording 收回 idle（轻触/上滑取消/权限失败）；
   *  processing/editing 不受影响——那是 liveAsr 松手后的流程态，收口事件是
   *  onLiveResult / onError。 */
  function handleVoiceVisualActive(active: boolean): void {
    if (active == true) {
      if (voiceStage.value == "idle") {
        voiceStage.value = "recording";
        if (waveformBars.value.length == 0) {
          initWaveform();
        }
        startVoiceWaveTimer();
      }
      return;
    }
    if (voiceStage.value == "recording") {
      voiceStage.value = "idle";
      recordWillCancel.value = false;
      stopVoiceWaveTimer();
    }
  }

  /** 上滑进/出取消区：文案切「松开取消」（蒙层不变红，气泡自身转红）。 */
  function handleVoiceCancelZone(active: boolean): void {
    recordWillCancel.value = active;
  }

  /** liveAsr 松手：蒙层保持，切「识别中」（结果经 onLiveResult / onError 收口）。 */
  function handleVoiceProcessing(): void {
    if (voiceStage.value == "recording") {
      voiceStage.value = "processing";
      recordWillCancel.value = false;
      stopVoiceWaveTimer();
    }
  }

  /** liveAsr 识别完成：文本入编辑卡，录音文件暂存（仅发语音用）。 */
  function handleVoiceLiveResult(text: string, pcmFilePath: string, durationMs: number, fileSize: number): void {
    voiceDraftText.value = text;
    voicePcmPath.value = pcmFilePath;
    voicePcmDurationMs.value = durationMs;
    voicePcmFileSize.value = fileSize;
    voiceStage.value = "editing";
    stopVoiceWaveTimer();
  }

  /** editing 收尾复位（取消/两路发送成功后调用）。 */
  function closeVoiceEdit(): void {
    uni.hideKeyboard({ complete: () => {} });
    voiceDraftFocus.value = false;
    voiceStage.value = "idle";
    recordWillCancel.value = false;
    voiceDraftText.value = "";
    voicePcmPath.value = "";
    voicePcmDurationMs.value = 0;
    voicePcmFileSize.value = 0;
    voiceAudioSending.value = false;
    stopVoiceWaveTimer();
  }

  /** 轻触编辑卡：拉键盘聚焦（首帧不自动聚焦，键盘不抢出场动画）。 */
  function handleVoiceCardTap(): void {
    if (voiceDraftFocus.value == true) {
      return;
    }
    // 先回 false 再下一帧置 true：focus 属性需要变化才触发聚焦
    voiceDraftFocus.value = false;
    setTimeout((): void => {
      if (voiceStage.value == "editing") {
        voiceDraftFocus.value = true;
      }
    }, 50);
  }

  function handleVoiceDraftFocus(): void {
    // 聚焦态占位（保持 focus 标记真实，供 handleVoiceCardTap 判重）
  }

  function handleVoiceDraftBlur(): void {
    voiceDraftFocus.value = false;
  }

  /** editing 取消：丢弃本轮识别文本与录音。 */
  function handleVoiceEditCancel(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (voiceAudioSending.value == true) {
      return;
    }
    closeVoiceEdit();
  }

  /**
   * 仅发语音发送核心（对齐 sendMediaWithRow 模式）：
   * 上传 WAV → audio 消息（body 带 duration 秒）→ 确认行替换（audioUrl 换服务端 url）。
   * 本地行 audioUrl 先用本地 WAV 路径（即时可播），确认替换后变远端 url。
   */
  async function sendVoiceAudioWithWav(wav: PcmToWavResult): Promise<void> {
    const clientMsgId = generateUUID();
    const row = new ImMsgRow();
    row.msgId = `local-${clientMsgId}`;
    row.clientMsgId = clientMsgId;
    row.local = true;
    row.msgType = "audio";
    row.audioUrl = wav.wavPath;
    row.audioDuration = wav.durationSec;
    row.sendTime = Date.now();
    row.status = 0;
    applyQuoteToRow(row);
    quoteTarget.value = null;
    resetQuoteMentionSnapshot();
    messages.value.push(row);
    scrollToBottom();
    closeVoiceEdit();
    try {
      const up = await uploadSingleFile(wav.wavPath, clientMsgId, null, `voice-${clientMsgId}.wav`);
      if (!isChatCurrent()) return;
      if (up.success != true || up.file == null) {
        markRowFailed(row.clientMsgId);
        const reason = up.error != null ? `${up.error}` : "";
        uni.showToast({
          title: reason.length > 0 ? reason : t("Mobile.Message.sendFailed"),
          icon: "none",
        });
        return;
      }
      const file = up.file;
      const res = await apiImSendMediaMsg(
        convId.value,
        "audio",
        file.url,
        file.name,
        file.size,
        file.type,
        row.clientMsgId,
        row.replyId.length > 0 ? row.replyId : "",
        wav.durationSec,
      );
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        const confirmed = buildConfirmedRow(dataObj, row);
        // readMsgRow 口径：audio 行读 body.url + body.duration（秒）；
        // 确认行显式回填（服务端 body 原样带回，双保险）
        confirmed.msgType = "audio";
        confirmed.audioUrl = file.url;
        confirmed.audioDuration = wav.durationSec;
        confirmed.linkAtts = [];
        replaceByClientMsgId(confirmed);
        reportReadIfNeeded(maxSeq());
        refreshReadStatus();
        scrollToBottom();
      } else {
        markRowFailed(row.clientMsgId);
        const message = apiResMessage(res);
        uni.showToast({
          title: message.length > 0 ? message : t("Mobile.Message.sendFailed"),
          icon: "none",
        });
      }
    } catch (_error) {
      if (isChatCurrent() == true) {
        markRowFailed(row.clientMsgId);
        uni.showToast({ title: t("Mobile.Message.sendFailed"), icon: "none" });
      }
    }
  }

  /** editing 仅发语音（🎤）：PCM→WAV→上传→audio 消息（不转文案，原生语音条可播）。
   *  位置须在 sendVoiceAudioWithWav 之后（UTS 先声明后使用）。 */
  function handleVoiceSendAudio(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (voiceAudioSending.value == true) {
      return;
    }
    const pcmPath = voicePcmPath.value;
    if (pcmPath.length == 0 || convId.value.length == 0) {
      return;
    }
    voiceAudioSending.value = true;
    pcmToWavFile(pcmPath, (wav: PcmToWavResult): void => {
      if (isChatCurrent() != true) {
        return;
      }
      if (wav.ok != true) {
        voiceAudioSending.value = false;
        uni.showToast({ title: t("Mobile.Voice.recordFailed"), icon: "none" });
        return;
      }
      sendVoiceAudioWithWav(wav);
    });
  }

  /** 语音/键盘切换：进语音态时收面板与键盘（语音条与面板互斥；
   *  hold-keyboard 后点话筒键不再自然失焦收键盘，需显式收）。
   *  App 三端按会话记忆本次选择，下次进该会话沿用（面板/长文等临时收语音不走这里，不改记忆）。 */
  function toggleVoiceMode(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (voiceMode.value != true) {
      if (panelMode.value.length > 0) {
        panelMode.value = "";
      }
      uni.hideKeyboard({ complete: () => {} });
    }
    voiceMode.value = voiceMode.value != true;
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    if (convId.value.length > 0) {
      uni.setStorageSync(inputMethodKey(), voiceMode.value ? "voice" : "input");
    }
    // #endif
  }

  /**
   * 语音识别文本发送（两个入口共用）：
   * ① liveAsr 编辑确认（handleVoiceEditConfirm）：蒙层编辑卡里改完的文本；
   * ② 非 live 端（H5/小程序/原生桥）onRecordStop 自动发送（无编辑环节）。
   * 有暂存图时与图合并发送（单图直发 image / 图文一条 rich_text，判定同 handleSend）。
   */
  function handleVoiceStop(result: string): void {
    const text = result.trim();
    if (text.length == 0 || convId.value.length == 0) {
      return;
    }
    // 语音说完自动发送：带上已选暂存图一起发（识别文本即文案；无暂存图走原纯文本路径）
    if (dispatchStagedSend(text)) {
      return;
    }
    const clientMsgId = generateUUID();
    const row = new ImMsgRow();
    row.msgId = `local-${clientMsgId}`;
    row.clientMsgId = clientMsgId;
    row.local = true;
    row.bodyText = text;
    const scan = scanMentions(text);
    row.mentionIds = scan.ids;
    row.mentionAll = scan.all;
    applyRichToRow(row);
    applyQuoteToRow(row);
    row.sendTime = Date.now();
    row.status = 0;
    messages.value.push(row);
    scrollToBottom();
    sendWithRow(row);
  }

  /** editing 确认（✓）：编辑后的文本按语音发送路径发出（暂存图合并同旧口径）。
   *  位置须在 handleVoiceStop 之后（UTS 先声明后使用）。 */
  function handleVoiceEditConfirm(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (voiceAudioSending.value == true) {
      return;
    }
    const text = voiceDraftText.value.trim();
    if (text.length == 0 || convId.value.length == 0) {
      return;
    }
    closeVoiceEdit();
    handleVoiceStop(text);
  }

  function handleVoiceError(error: any): void {
    // 识别失败收口：关蒙层（含 processing/editing 态——如按住中链路错误松手提示）
    if (voiceStage.value == "processing" || voiceStage.value == "editing") {
      closeVoiceEdit();
    }
    let message = "";
    try {
      const err = error as Error;
      if (err != null && err.message != null) {
        message = err.message;
      }
    } catch (_e) {
      // ignore
    }
    uni.showToast({ title: message.length > 0 ? message : t("Mobile.Message.sendFailed"), icon: "none" });
  }

  // ===== 飞书式内嵌面板（表情 / 加号），与系统键盘互斥 =====

  // ===== 工具键按压蓝色反馈（@/话筒/相册/Aa/加号/表情）=====
  // uvue App 端不支持后代选择器，父级 hover-class 改不了子图标内联色——图标级
  // 按压蓝由本状态驱动：touchstart 记键名 → 图标/字符/PNG 变蓝，release 延迟
  // ~250ms 回灰（click 紧随 touchend，蓝态覆盖跳转/面板切换的起始转场段）。
  const toolPressedKey = ref<string>("");
  let toolPressedTimer = 0;

  /** 工具键按下：记键名点亮蓝色（清待回灰计时，同键连按保持点亮）。 */
  function pressTool(key: string): void {
    toolPressedKey.value = key;
    if (toolPressedTimer != 0) {
      clearTimeout(toolPressedTimer);
      toolPressedTimer = 0;
    }
  }

  /** 工具键抬起/取消：延迟回灰（蓝色可见一小段再落回；跳转类键转场期间仍亮）。 */
  function releaseTool(): void {
    if (toolPressedTimer != 0) {
      clearTimeout(toolPressedTimer);
    }
    toolPressedTimer = setTimeout(() => {
      toolPressedTimer = 0;
      toolPressedKey.value = "";
    }, 250);
  }

  /** 开面板先收键盘（H5 上 hideKeyboard 可能被拒绝，complete 兜底防未处理 Promise）。 */
  function setPanel(mode: string): void {
    panelMode.value = mode;
    if (mode.length > 0) {
      uni.hideKeyboard({ complete: () => {} });
      // 键盘→面板一步直切：不等收起事件，liftPx 立即从键盘高切到面板高（单过渡动画）；
      // 事件/轮询晚到的 0 幂等；Android 若 hideKeyboard 失败由轮询把真实高度改回（单次回弹可接受）
      applyKeyboardHeight(0, "predict");
    }
  }

  /** 表情键：恒开表情面板（不切换收起）；收面板只能靠点输入框换回系统键盘。 */
  function toggleEmojiPanel(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (voiceMode.value) {
      voiceMode.value = false;
    }
    // 首开刷新常用行（已开重复点不重拉）；失败静默保留旧值（loadRecentEmojis 内部）
    if (panelMode.value != "emoji") {
      loadRecentEmojis();
    }
    setPanel("emoji");
  }

  function togglePlusPanel(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (voiceMode.value) {
      voiceMode.value = false;
    }
    setPanel(panelMode.value == "plus" ? "" : "plus");
  }

  /**
   * @键（主坞/长文页工具栏共用）：收面板/语音/键盘，进全屏成员选择页
   * （飞书式新页；选中经 IM_AT_PICK_EVENT 回填输入框，单聊=当前用户+对方，群聊=群成员）。
   */
  function handleMentionKeyTap(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (voiceMode.value) {
      voiceMode.value = false;
    }
    if (panelMode.value.length > 0) {
      panelMode.value = "";
    }
    uni.hideKeyboard({ complete: () => {} });
    uni.navigateTo({
      url:
        `/pages/message/at-select?convId=${convId.value}&convType=${convType.value}` +
        `&name=${encodeURIComponent(titleName.value)}&avatar=${encodeURIComponent(peerAvatar.value)}`,
    });
  }

  /**
   * Aa 键：开格式横条（与键盘共存，不走 setPanel 的收键盘路径）；
   * 已开时再点收起（键盘保留）。未聚焦则聚焦拉起系统键盘。
   */
  function handleAaKeyTap(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (voiceMode.value) {
      voiceMode.value = false;
    }
    if (panelMode.value == "font") {
      panelMode.value = "";
      return;
    }
    // emoji/plus 与键盘互斥，切横条前先收（panelMode 单值本身互斥，这里直接赋值）
    panelMode.value = "font";
    focusChatInput();
  }

  /** 横条右端蓝色下箭头：收横条（键盘保留，用户多半还在输入）。 */
  function collapseFontBar(): void {
    panelMode.value = "";
  }

  /** 收起展开面板：卸载大输入区并收键盘（焦点随 textarea 卸载自然丢失）。 */
  function closeExpandSheet(): void {
    expanded.value = false;
    expandPanel.value = "";
    expandFocusRequest.value = false;
    uni.hideKeyboard({ complete: () => {} });
  }

  // ===== 长按消息操作（动态显隐规则全在此；服务端永远是权限权威，这里只做入口 UX） =====

  /** 消息有可引用的内容（文本/图片/视频/附件任一非空）。 */
  function hasQuotableBody(msg: ImMsgRow): boolean {
    return (
      msg.bodyText.length > 0 || msg.imageUrl.length > 0 || msg.videoUrl.length > 0 ||
      msg.imageAtts.length > 0 || msg.linkAtts.length > 0
    );
  }

  /** 置顶入口：p2p 恒可；群聊默认全员可，allowMemberPin=false 后仅群主/管理员（myRole>=2）。 */
  function canPinMsg(): boolean {
    return isGroupLike.value != true || allowMemberPin || myRole.value >= 2;
  }

  /**
   * 编辑入口：仅本人、已确认、正常态的纯文本消息（rich_text 带附件不可编辑），
   * 且在编辑窗口内（服务端 EDIT_WINDOW_SEC_DEFAULT=300s，超窗 IM_40003——
   * 客户端只做显隐预判，权威在服务端）。
   */
  function canEditMsg(msg: ImMsgRow): boolean {
    if (isMine(msg) != true || msg.revoked || msg.status != 1 || isConfirmedRow(msg) != true) {
      return false;
    }
    const textLike =
      msg.msgType == "text" || (msg.msgType == "rich_text" && msg.imageAtts.length == 0 && msg.linkAtts.length == 0);
    if (textLike != true) {
      return false;
    }
    return Date.now() - msg.sendTime <= 300 * 1000;
  }

  /** 撤回入口：本人消息，或群聊管理员/群主撤他人；时限 whoami.revokeWindowSec（默认 24h）。 */
  function canRevokeMsg(msg: ImMsgRow): boolean {
    if (msg.revoked || msg.status != 1 || isConfirmedRow(msg) != true) {
      return false;
    }
    const governor = isMine(msg) || (isGroupLike.value && myRole.value >= 2);
    if (governor != true) {
      return false;
    }
    return Date.now() - msg.sendTime <= revokeWindowSec * 1000;
  }

  /** 删除入口：本人已确认消息（本地占位行无服务端身份，删无可删）。
   *  按人删除仅收敛自己的可见范围，无时限无权限差异，服务端幂等。 */
  function canDeleteMsg(msg: ImMsgRow): boolean {
    return isMine(msg) && isConfirmedRow(msg);
  }

  /** 动作列表；撤回=红色破坏性操作。 */
  function buildActionsFor(msg: ImMsgRow): MsgActionItem[] {
    const acts: MsgActionItem[] = [];
    if (msg.revoked) {
      return acts;
    }
    if (msg.bodyText.length > 0) {
      // 选择复制：二级弹层 textarea 系统选择手柄局部复制（框架不支持气泡内选择，见组件头注释）；
      // 原「复制」直达按钮已去——整段复制由弹层内「全选复制」按钮承接
      const selectCopy = new MsgActionItem();
      selectCopy.key = "selectCopy";
      selectCopy.label = t("Mobile.Message.actionSelectCopy");
      acts.push(selectCopy);
    }
    if (hasQuotableBody(msg)) {
      const quote = new MsgActionItem();
      quote.key = "quote";
      quote.label = t("Mobile.Message.actionQuote");
      quote.icon = "/static/images/icon-msg-quote-action.png";
      acts.push(quote);
    }
    // 转发 / 多选：六型白名单内正常消息（merge_forward 禁嵌套不出现这两项）
    if (canForwardMsg(msg)) {
      const forward = new MsgActionItem();
      forward.key = "forward";
      forward.label = t("Mobile.Message.actionForward");
      acts.push(forward);
      const multi = new MsgActionItem();
      multi.key = "multi";
      multi.label = t("Mobile.Message.actionMultiSelect");
      acts.push(multi);
    }
    // #ifdef APP
    // 视频专属：保存到系统相册（saveVideoToPhotosAlbum 仅 App 有意义；
    // H5 走浏览器另存、小程序保存需另行声明相册权限，均不出现该项）。
    // videoUrl 三形态统一：msgType=video / file 视频文件 / rich_text 内嵌视频附件
    if (msg.videoUrl.length > 0) {
      const download = new MsgActionItem();
      download.key = "download";
      download.label = t("Mobile.Message.actionDownloadVideo");
      download.icon = "/static/images/icon-msg-download-action.png";
      acts.push(download);
    }
    // #endif
    if (canPinMsg()) {
      const pin = new MsgActionItem();
      pin.key = isPinnedMsg(msg) ? "unpin" : "pin";
      // IM 消息面板用专属 key（PIN/取消PIN）；Mobile.Conversation.pin 是 AI 会话列表的「置顶」，勿共用
      pin.label = isPinnedMsg(msg) ? t("Mobile.Message.actionUnpin") : t("Mobile.Message.actionPin");
      pin.icon = "/static/images/icon-msg-pin-action.png";
      acts.push(pin);
    }
    if (canEditMsg(msg)) {
      const edit = new MsgActionItem();
      edit.key = "edit";
      edit.label = t("Mobile.Message.actionEdit");
      edit.icon = "/static/images/icon-msg-edit.png";
      acts.push(edit);
    }
    if (canRevokeMsg(msg)) {
      const revoke = new MsgActionItem();
      revoke.key = "revoke";
      revoke.label = t("Mobile.Message.actionRevoke");
      revoke.icon = "/static/images/icon-msg-revoke-action.png";
      acts.push(revoke);
    }
    // 删除（红色破坏性，置底同撤回）：仅自己的可见范围，二次确认在 handleSheetSelect
    if (canDeleteMsg(msg)) {
      const del = new MsgActionItem();
      del.key = "delete";
      del.label = t("Mobile.Message.actionDelete");
      del.danger = true;
      acts.push(del);
    }
    return acts;
  }

  /** 长按：撤回行及纯摘要系统行不响应；普通消息即使带 digest 也保留操作入口；
   *  合并转发卡片（mergeItems 非空）有 PIN 等入口，不算系统行；多选态长按吞掉。 */
  function handleMsgLongPress(msg: ImMsgRow): void {
    if (multiSelectMode.value) {
      return;
    }
    const hasBody = msg.bodyText.length > 0 || msg.imageUrl.length > 0 ||
      msg.audioUrl.length > 0 || msg.videoUrl.length > 0 ||
      msg.imageAtts.length > 0 || msg.linkAtts.length > 0;
    const systemRow = msg.mergeItems.length > 0 ? false : msg.revoked || (hasBody != true && msg.digest.length > 0);
    if (systemRow) {
      return;
    }
    if (hasQuotableBody(msg) != true && canPinMsg() != true && canEditMsg(msg) != true && canRevokeMsg(msg) != true && canDeleteMsg(msg) != true && canReactMsg(msg) != true && canForwardMsg(msg) != true) {
      return;
    }
    const acts = buildActionsFor(msg);
    if (acts.length == 0) {
      return;
    }
    if (expanded.value) {
      closeExpandSheet();
    }
    if (panelMode.value.length > 0) {
      panelMode.value = "";
    }
    uni.hideKeyboard({ complete: () => {} });
    selectedId.value = msg.msgId;
    sheetActions.value = acts;
    // 面板拉起即重拉常用表情（PC 开面板重拉同款：常用无实时帧，跨端/别处刚用的
    // 表情要靠这次 GET 才可见；面板先按旧值渲染，返回后第一行就地刷新，无闪烁态）
    loadRecentEmojis();
    const proxy = actionSheetRef.value as ComponentPublicInstance | null;
    if (proxy != null) {
      proxy.$callMethod("open");
    }
  }

  // ===== 消息行长按：定时器直接绑定消息行，不再按固定平均行高猜测命中消息。 =====
  let rowPressTimer = 0;
  let rowPressStartX = 0;
  let rowPressStartY = 0;
  let rowPressTarget: ImMsgRow | null = null;
  let avatarPressTimer = 0;
  let avatarPressStartX = 0;
  let avatarPressStartY = 0;
  let avatarPressTarget: ImMsgRow | null = null;

  // UTS→Kotlin 要求先定义后使用：须位于 handleAvatarPressStart 的闭包调用之前（勿移到其后）
  async function mentionMessageSender(msg: ImMsgRow): Promise<void> {
    if (msg.senderId.length == 0) {
      return;
    }
    await loadMembers();
    const all = members.value;
    for (let i = 0; i < all.length; i++) {
      if (all[i].userId == msg.senderId && all[i].token.length > 0) {
        if (expanded.value) {
          closeExpandSheet();
        }
        if (voiceMode.value) {
          voiceMode.value = false;
        }
        panelMode.value = "";
        appendMentionText(all[i].token);
        focusChatInput();
        return;
      }
    }
  }

  function handleAvatarPressStart(msg: ImMsgRow, eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    if (avatarPressTimer != 0) {
      clearTimeout(avatarPressTimer);
    }
    avatarPressStartX = e.touches[0].clientX;
    avatarPressStartY = e.touches[0].clientY;
    avatarPressTarget = msg;
    avatarPressTimer = setTimeout((): void => {
      avatarPressTimer = 0;
      const target = avatarPressTarget;
      avatarPressTarget = null;
      if (target != null) {
        mentionMessageSender(target);
      }
    }, 500);
  }

  function handleAvatarPressMove(eventValue: Any): void {
    if (avatarPressTimer == 0) {
      return;
    }
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    const dx = e.touches[0].clientX - avatarPressStartX;
    const dy = e.touches[0].clientY - avatarPressStartY;
    if (Math.abs(dx) > 10 || Math.abs(dy) > 10) {
      clearTimeout(avatarPressTimer);
      avatarPressTimer = 0;
      avatarPressTarget = null;
    }
  }

  function handleAvatarPressEnd(): void {
    if (avatarPressTimer != 0) {
      clearTimeout(avatarPressTimer);
      avatarPressTimer = 0;
      avatarPressTarget = null;
    }
  }

  function handleMsgTouchStart(msg: ImMsgRow, eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    rowPressStartX = e.touches[0].clientX;
    rowPressStartY = e.touches[0].clientY;
    rowPressFired = false;
    if (rowPressTimer != 0) {
      clearTimeout(rowPressTimer);
    }
    rowPressTarget = msg;
    rowPressTimer = setTimeout((): void => {
      rowPressTimer = 0;
      const target = rowPressTarget;
      rowPressTarget = null;
      if (target != null) {
        rowPressFired = true;
        handleMsgLongPress(target);
      }
    }, 500);
  }

  function handleMsgTouchMove(eventValue: Any): void {
    if (rowPressTimer == 0) {
      return;
    }
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    const dx = e.touches[0].clientX - rowPressStartX;
    const dy = e.touches[0].clientY - rowPressStartY;
    if (Math.abs(dx) > 10 || Math.abs(dy) > 10) {
      clearTimeout(rowPressTimer);
      rowPressTimer = 0;
      rowPressTarget = null;
    }
  }

  function handleMsgTouchEnd(): void {
    if (rowPressTimer != 0) {
      clearTimeout(rowPressTimer);
      rowPressTimer = 0;
      rowPressTarget = null;
    }
  }

  // ===== 气泡触摸 = 消息内容触摸 =====
  // 长按检测从整行下移到消息内容元素（气泡/图片消息）：按住气泡外的行内空白
  // （发送者名、气泡右侧空白、行尾状态列等）不再拉起长按弹窗。气泡上一个元素要
  // 同时驱动长按弹窗与按压态，这里做复合分发（★须位于 handleMsgTouch* 与
  // handlePressTouch* 之后：UTS→Kotlin 先用后定义会报「找不到名称」）。
  function handleBubbleTouchStart(msg: ImMsgRow, eventValue: Any): void {
    handleMsgTouchStart(msg, eventValue);
    handlePressTouchStart(`b-${msg.msgId}`, eventValue);
  }

  function handleBubbleTouchMove(eventValue: Any): void {
    handleMsgTouchMove(eventValue);
    handlePressTouchMove(eventValue);
  }

  function handleBubbleTouchEnd(): void {
    handleMsgTouchEnd();
    handlePressTouchEnd();
  }

  /** 面板完全收起后清理当前操作目标。 */
  function handleSheetClosed(): void {
    selectedId.value = "";
  }

  /** 选择复制弹层收起：清承接文本（弹层内 textarea 是本地副本，不受影响）。 */
  function handleSelectCopyClosed(): void {
    selectCopyText.value = "";
  }

  /** 置顶 / 取消置顶：幂等；成功后重拉 Pin 集（多人共享状态自我纠正）。 */
  async function handleActionPin(msg: ImMsgRow, pin: boolean): Promise<void> {
    if (convId.value.length == 0) {
      return;
    }
    try {
      const res = pin ? await apiImPinMsg(convId.value, msg.msgId) : await apiImUnpinMsg(convId.value, msg.msgId);
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        // 成功不 toast：气泡上 PIN 徽标 + Pin 面板即时刷新即反馈；失败仍提示
        loadPinnedIds();
      } else {
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /** 撤回：返回撤回后的 MessageDto 原位替换（body 清空 ⇒ 渲染为系统行）；撤回联动删 Pin 需重拉。 */
  async function handleActionRevoke(msg: ImMsgRow): Promise<void> {
    if (convId.value.length == 0) {
      return;
    }
    try {
      const res = await apiImRevokeMsg(msg.msgId, convId.value);
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj != null) {
          const revokedRow = readMsgRow(dataObj);
          const rows = messages.value;
          for (let i = 0; i < rows.length; i++) {
            if (rows[i].msgId == revokedRow.msgId) {
              rows.splice(i, 1, revokedRow);
              break;
            }
          }
        }
        loadPinnedIds();
      } else {
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /** 长按「删除」：弹紧凑确认（按人删除语义文案），确认后 handleActionDelete。 */
  function openDeleteConfirm(msg: ImMsgRow): void {
    pendingDeleteMsg = msg;
    const proxy = confirmModalRef.value as ComponentPublicInstance | null;
    if (proxy != null) {
      proxy.$callMethod("open", t("Mobile.Message.deleteMsgTitle"), t("Mobile.Message.deleteMsgTip"), t("Mobile.Common.delete"));
    }
  }

  /** 删除（按人删除，仅自己的可见范围）：成功后本地行直接移除（服务端历史对我已
   *  过滤，重拉也不再出现）；幂等——data=false 仍是成功码，同码处理不区分。 */
  async function handleActionDelete(msg: ImMsgRow): Promise<void> {
    if (convId.value.length == 0) {
      return;
    }
    try {
      const res = await apiImDeleteMsg(msg.msgId, convId.value);
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        // 成功不 toast：行消失即反馈；失败仍提示
        const rows = messages.value;
        for (let i = 0; i < rows.length; i++) {
          if (rows[i].msgId == msg.msgId) {
            rows.splice(i, 1);
            break;
          }
        }
      } else {
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /** 删除确认-确认：按打开时记下的消息执行（弹窗组件负责关闭自身）。 */
  function handleDeleteConfirmOk(): void {
    const msg = pendingDeleteMsg;
    pendingDeleteMsg = null;
    if (msg != null) {
      handleActionDelete(msg);
    }
  }

  /** 删除确认-取消/点遮罩：清待删消息（不产生副作用）。 */
  function handleDeleteConfirmCancel(): void {
    pendingDeleteMsg = null;
  }

  /** 长按「下载视频」：下载并保存到系统相册（仅 App——动作项在 buildActionsFor 内 #ifdef APP 收敛）。
   *  传原始 videoUrl（可能 /api/f/ 相对路径）而非解析产物：temp file:// 不能再 downloadFile，
   *  原始地址才能正确决定鉴权头（同源带 Bearer，CDN 直链不带）。 */
  function handleActionVideoDownload(msg: ImMsgRow): void {
    // #ifdef APP
    if (msg.videoUrl.length == 0) {
      return;
    }
    saveVideoToAlbumInApp(msg.videoUrl).catch((_e: any | null): void => {
      // 失败 toast 已在 saveVideoToAlbumInApp 内部，这里只吞未处理拒绝
    });
    // #endif
  }

  /** 弹窗点行动作分发；先取出消息对象，再清空弹窗操作目标。 */
  function handleSheetSelect(key: string): void {
    const msg = findMsgById(selectedId.value);
    selectedId.value = "";
    // 兜底再关一次面板：组件侧 handleSelect 已自带 close，但个别安卓运行时（鸿蒙系
    // 手机装 Android 版）原生弹层内 $callMethod 偶发不生效，点选后面板不收起。
    // uni-modal-popup.close 内有 visible 门卫，幂等，重复调用无副作用。
    const sheetProxy = actionSheetRef.value as ComponentPublicInstance | null;
    if (sheetProxy != null) {
      sheetProxy.$callMethod("close");
    }
    if (msg == null) {
      return;
    }
    if (key == "quote") {
      enterQuoteMode(msg);
    } else if (key == "selectCopy") {
      // 选择复制弹层：纯文本进 textarea，系统选择手柄局部复制（复制动作由系统菜单完成）；
      // 文案随 open 入参直传（$callMethod 同步执行，props.text 此刻可能尚未随赋值落地）
      const selectPlain = plainBodyForCopy(msg.bodyText);
      selectCopyText.value = selectPlain.length > 0 ? selectPlain : msg.bodyText;
      const selectProxy = selectCopyRef.value as ComponentPublicInstance | null;
      if (selectProxy != null) {
        selectProxy.$callMethod("open", selectCopyText.value);
      }
    } else if (key == "pin") {
      handleActionPin(msg, true);
    } else if (key == "unpin") {
      handleActionPin(msg, false);
    } else if (key == "edit") {
      enterEditMode(msg);
    } else if (key == "revoke") {
      handleActionRevoke(msg);
    } else if (key == "delete") {
      openDeleteConfirm(msg);
    } else if (key == "forward") {
      handleActionForward(msg);
    } else if (key == "multi") {
      enterMultiSelect(msg);
    } else if (key == "download") {
      handleActionVideoDownload(msg);
    } else if (key.indexOf("react:") == 0) {
      // 表情快选条：key = "react:" + emoji（toggle 语义在 handleActionReact）
      handleActionReact(msg, key.substring("react:".length));
    }
  }

  /**
   * ⤢ 展开键（输入框右侧 / 面板右上收起键）：从底部拉起展开输入面板
   * （大输入区 + 工具行，与输入坞共享 inputText）；已开时收起。
   * 开面板先收坞上面板/语音/键盘，焦点移入大输入区。
   */
  function toggleExpandPanel(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (expanded.value) {
      closeExpandSheet();
      return;
    }
    if (voiceMode.value) {
      voiceMode.value = false;
    }
    if (panelMode.value.length > 0) {
      panelMode.value = "";
    }
    uni.hideKeyboard({ complete: () => {} });
    expanded.value = true;
    expandPanel.value = "";
    expandFocusRequest.value = false;
    nextTick(() => {
      expandFocusRequest.value = true;
    });
    // 展开面板 textarea 无独立 focus 回调：面板开着即轮询（Android 键盘事件兜底同链路）
    startAndroidImePolling();
  }

  /** 展开面板发送：走统一 handleSend（格式态包装/提及反扫/滚动同链路），发完收面板。 */
  function handleExpandSend(): void {
    if (canSend.value != true) {
      return;
    }
    handleSend();
    closeExpandSheet();
  }

  /** 展开面板内嵌面板（表情/格式行，与键盘互斥）：开面板收键盘，再点收起。 */
  function setExpandPanel(mode: string): void {
    expandPanel.value = mode;
    if (mode.length > 0) {
      uni.hideKeyboard({ complete: () => {} });
    }
  }

  function toggleExpandEmoji(): void {
    // 首开刷新常用行（已开重复点不重拉），同 toggleEmojiPanel
    if (expandPanel.value != "emoji") {
      loadRecentEmojis();
    }
    setExpandPanel("emoji");
  }

  function toggleExpandFont(): void {
    setExpandPanel(expandPanel.value == "font" ? "" : "font");
  }

  /** 大输入区输入即回键盘态：收内嵌面板（键盘回调异常时的兜底）；键盘敲入尾部 @
   *  时收面板回坞走主坞 @ 链路（同 handleExpandMentionTap，进全屏成员选择页）。 */
  function handleExpandInputTyped(): void {
    if (expandPanel.value.length > 0) {
      expandPanel.value = "";
    }
    if (consumeTypedAt()) {
      closeExpandSheet();
      handleMentionKeyTap();
    }
  }

  /** 展开面板话筒键：收面板回坞后进语音态（同主坞话筒键交互，语音条替换输入 pill）。 */
  function handleExpandVoiceTap(): void {
    closeExpandSheet();
    toggleVoiceMode();
  }

  /**
   * 面板下滑收起手势：跟手下移（上移钳 0），松手位移超 ~90px 判定收面板、不足弹回。
   * 大输入区 textarea 为原生控件自消费触摸，拖拽热区为头部/内嵌面板/工具行。
   */
  function handleSheetTouchStart(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    sheetStartY = e.touches[0].clientY;
    sheetDragging.value = true;
  }

  function handleSheetTouchMove(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    const dy = e.touches[0].clientY - sheetStartY;
    sheetDragPx.value = dy > 0 ? dy : 0;
  }

  function handleSheetTouchEnd(_eventValue: Any): void {
    const dragged = sheetDragPx.value;
    sheetDragging.value = false;
    sheetDragPx.value = 0;
    if (dragged > 90) {
      closeExpandSheet();
    }
  }

  /** B/I/S/U 样式态切换：icon 背景亮/灭，输入框不插入标记；激活样式在发送时逐行包装。
   *  键盘态不动：textarea 已设 hold-keyboard，点横条 icon 不触发失焦收键盘，也不主动拉起。 */
  function handleMarkToggle(kind: string): void {
    if (kind == "bold") {
      markBold.value = !markBold.value;
    } else if (kind == "italic") {
      markItalic.value = !markItalic.value;
    } else if (kind == "strike") {
      markStrike.value = !markStrike.value;
    } else {
      markUnderline.value = !markUnderline.value;
    }
  }

  /** 列表态高亮与输入末行的前缀同步（手动删/改前缀后修正横条高亮）。★定义在 handleListTap 前。 */
  function syncListKind(): void {
    const lines = inputText.value.split("\n");
    const tail = lines.length > 0 ? lines[lines.length - 1] : "";
    if (olPrefixLen(tail) > 0) {
      listKind.value = "ol";
    } else if (ulPrefixLen(tail) > 0) {
      listKind.value = "ul";
    } else {
      listKind.value = "";
    }
  }

  /**
   * 格式横条列表键（作用于输入末行；App 无程序化光标，统一按末行处理）：
   * 有序——末行有序号则移除，否则替换既有前缀为递增序号 "N. "（N=上文连续列表行数+1）；
   * 无序——末行有 "- " 则移除，否则替换为 "- "。两种前缀互斥，listKind 同步高亮。
   *  键盘态不动（hold-keyboard 下点 icon 不失焦；亦不主动拉起）。
   */
  function handleListTap(kind: string): void {
    const lines = inputText.value.split("\n");
    const last = lines.length - 1;
    const line = lines[last];
    const olCut = olPrefixLen(line);
    const ulCut = ulPrefixLen(line);
    const cut = olCut > 0 ? olCut : ulCut;
    const rest = cut > 0 ? line.substring(cut) : line;
    if (kind == "ol") {
      if (olCut > 0) {
        // 已有序号：移除
        lines[last] = rest;
      } else {
        let n = 0;
        for (let i = last - 1; i >= 0; i--) {
          if (olPrefixLen(lines[i]) > 0 || ulPrefixLen(lines[i]) > 0) {
            n++;
          } else {
            break;
          }
        }
        lines[last] = `${n + 1}. ${rest}`;
      }
    } else {
      if (ulCut > 0) {
        // 已有圆点：移除
        lines[last] = rest;
      } else {
        lines[last] = `- ${rest}`;
      }
    }
    inputText.value = lines.join("\n").substring(0, 2000);
    syncListKind();
  }

  // ===== Android 输入框原生 gravity 垂直居中 =====
  // 多行 EditText 原生 gravity 默认 top：单行时文字/placeholder/光标都贴控件上沿，
  // CSS 够不到（placeholder-style 的 line-height 在 App 端也不生效）。textarea 挂在
  // v-if（语音态/解散态）下会重建原生视图，故 onReady/onShow 与每次聚焦都兜底重设。
  // 返回是否已生效（原生视图未挂载时拿不到 AppCompatEditText，返回 false 供重试判断）。

  /** Android 盒高贴内容（根除聚焦 placeholder 上跳的瞬态）：框架在聚焦/键盘开合
   *  链路会把 gravity 异步重置回 top，sweep 按拍纠正之间（≤240ms）top 态肉眼可见
   *  （2026-10-01 真机 3-5px）。盒高收到与内容等高（slack=0）后 top 与
   *  CENTER_VERTICAL 渲染同位，重置本身不可见。内容高不猜 CSS（padding/行高到
   *  原生的映射不透明），量「已布局文本」的真实高：Layout.getHeight() 含行距/
   *  includeFontPadding 等一切（getLineHeight() 只是理论行高，首版残差跳动即
   *  两者之差）+ 上下 padding，device px → css px 直存（px 直写免 rpx 往返取整）；
   *  异常量测（字体未就绪/布局未建等）不落地，维持 rpx 老基线。 */
  // #ifdef APP-ANDROID
  function applyAndroidInputFitHeight(edit: AppCompatEditText): void {
    const layout: Layout | null = edit.getLayout();
    if (layout == null) {
      return;
    }
    const fitDevicePx = layout.getHeight() + edit.getPaddingTop() + edit.getPaddingBottom();
    const fitCssPx = UTSAndroid.devicePX2px(fitDevicePx);
    // 单行内容 ≈ 25css 行高 + 上下 padding：合理区间 20~45，出界视为坏量测
    if (fitCssPx >= 20 && fitCssPx <= 45 && Math.abs(fitCssPx - androidInputFitCss.value) >= 0.5) {
      androidInputFitCss.value = fitCssPx;
    }
  }
  // #endif

  function centerAndroidInputGravity(): boolean {
    // #ifdef APP-ANDROID
    const el = uni.getElementById("chat-input-textarea");
    if (el == null) {
      return false;
    }
    const host = el.getAndroidView();
    if (host instanceof AppCompatEditText) {
      // 只给垂直位：水平回落默认 leading（左），与现有左对齐一致
      (host as AppCompatEditText).setGravity(Gravity.CENTER_VERTICAL);
      applyAndroidInputFitHeight(host as AppCompatEditText);
      // 顺带做一次行数/滚动条同步：挂载首拍就把原生垂直滚动条按行数关好
      // （默认开启会让 ≤4 行换行的增高过渡窗口闪滚动条），草稿多行高度也在此对齐
      syncChatInputLines();
      return true;
    }
    // #endif
    return false;
  }

  /** 带重试的 gravity 居中：进页首帧原生视图可能晚于 onReady 挂载（单次调用静默
   *  空转 → 进页未聚焦时 placeholder 偏上），约 120ms 一拍直至成功、上限约 1s。 */
  function centerAndroidInputGravityWithRetry(tries: number): void {
    // #ifdef APP-ANDROID
    if (centerAndroidInputGravity()) {
      return;
    }
    if (tries <= 1) {
      return;
    }
    setTimeout((): void => {
      centerAndroidInputGravityWithRetry(tries - 1);
    }, 120);
    // #endif
  }

  /** 失焦后按拍强制重设 gravity（不「成功即停」）：blur/收键盘链路里框架会把
   *  gravity 异步重置回 top（真机 2026-09-30：点输入框再点别处，placeholder 复
   *  偏上），重试版会停在被重置之前，须按拍覆盖收起动画与其后的重置窗口（~1.2s）。
   *  视图已卸载时逐拍安全空转。 */
  function sweepAndroidInputGravity(times: number): void {
    // #ifdef APP-ANDROID
    centerAndroidInputGravity();
    if (times <= 1) {
      return;
    }
    setTimeout((): void => {
      sweepAndroidInputGravity(times - 1);
    }, 240);
    // #endif
  }

  // 语音态 v-if 卸载 textarea、切回文字态重建：原生 gravity 随重建回默认 top，
  // 聚焦兜底要等用户点输入框才触发，这里切回即带重试重设（watch 回调先于重渲染，
  // 首拍多在挂载前，靠重试链兜住）
  watch(voiceMode, (val: boolean) => {
    if (!val) {
      centerAndroidInputGravityWithRetry(8);
    }
  });

  /**
   * 点输入框：聚焦拉起系统键盘。App 端面板不清——飞书式键盘升起覆盖住表情面板，
   * 面板卸载在键盘高度回调里与让位同帧做；H5 无键盘高度回调，focus 即收互斥面板。
   * 格式横条（font）与键盘共存：聚焦不清。
   */
  function handleInputFocus(): void {
    // Android：textarea 随 v-if 重建后 gravity 回默认 top；聚焦链路框架同样会把
    // gravity 异步重置回 top（与收起链路同源，2026-10-01 真机：拉起键盘瞬间
    // placeholder 上跳 = 单次重设落在框架重置之前）——按拍 sweep 盖住开键盘全程
    sweepAndroidInputGravity(6);
    inputFocused.value = true;
    // Android 兜底：部分机型从子页返回后键盘事件不派发，聚焦期间轮询 IME insets 接管让位
    startAndroidImePolling();
    // #ifdef APP-IOS || APP-HARMONY
    // 微信式预抬：聚焦瞬间用上次真实键盘高度先行让位（与键盘动画同帧起步），真值回调
    // 到达即校正；500ms 无任何真值则看门狗回落（外接键盘/焦点被抢防幽灵让位）
    if (keyboardHeight.value <= 0 && kbLastHCache > 0) {
      applyKeyboardHeight(kbLastHCache, "predict");
      armKbWatchdog();
    }
    // #endif
    // #ifdef H5 || WEB
    if (panelMode.value == "emoji" || panelMode.value == "plus") {
      panelMode.value = "";
    }
    // #endif
  }

  /** 失焦（键盘收起）：复位聚焦态与 focus 驱动位，Aa 键才能再次拉起键盘。 */
  function handleInputBlur(): void {
    inputFocused.value = false;
    focusRequest.value = false;
    // #ifdef APP-IOS
    // iOS blur 必收键盘：预测性先落 0 让让位下落与收起动画同步起步，事件到达幂等确认
    if (keyboardHeight.value > 0) {
      applyKeyboardHeight(0, "predict");
    }
    // #endif
    // Android：blur/收键盘链路框架会把 gravity 异步重置回 top（点输入框再点别处
    // placeholder 复偏上），按拍强制重设盖住重置窗口；鸿蒙走 CSS padding 不受影响
    sweepAndroidInputGravity(6);
    // 键盘还 believed 开着（收起动画中）不立停轮询：部分机型收起沿事件不派发，
    // 轮询直读 insets 归零是唯一清让位的链路；轮询条件含 keyboardHeight>0，
    // 归零后下一拍自停；键盘已收（height=0）则照常立停
    if (keyboardHeight.value <= 0) {
      stopAndroidImePolling();
    }
  }

  /** Android textarea 焦点常驻时 focus 可能不再触发：输入即视为回到键盘态（兜底，横条除外）；
   *  同时同步格式横条列表态高亮（手动删改末行前缀时修正）；键盘敲入尾部 @ 时走 @ 键
   *  同款成员选择页（consumeTypedAt 已回退该 @，选中后统一重插 "@token "）。 */
  function handleInputTyped(): void {
    if (panelMode.value == "emoji" || panelMode.value == "plus") {
      panelMode.value = "";
    }
    syncListKind();
    if (consumeTypedAt()) {
      handleMentionKeyTap();
    }
  }

  /**
   * 点消息区任意处：展开面板开着先收面板；否则收面板+收键盘（飞书式，
   * 面板无独立收起键，点聊天区即收；气泡/图片等子元素的点击会冒泡到此，同样触发收起）。
   */
  function handleBodyTap(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (expanded.value) {
      closeExpandSheet();
      return;
    }
    if (panelMode.value.length > 0) {
      panelMode.value = "";
    }
    // 点列表收键盘：预测性先落 0（让位下落与键盘收起同步起步），事件/轮询到达幂等确认
    if (keyboardHeight.value > 0) {
      applyKeyboardHeight(0, "predict");
    }
    uni.hideKeyboard({ complete: () => {} });
  }

  /** 表情点选：追加到输入末尾（与 textarea maxlength=2000 同口径截断）。
   *  顺带记一次常用表情（PC onUseEmoji 同款第二入口：面板点选插入即记账）。 */
  function handleEmojiTap(emo: string): void {
    recordEmojiUsage(emo);
    const next = inputText.value + emo;
    inputText.value = next.substring(0, 2000);
  }

  /**
   * 表情退格：按码点成对删，避免删半个 emoji。三类尾巴逐层剥离：
   * 变体选择符 U+FE0F（❤️/✌️/⚠️）→ 代理对高低位（😀 等）→ 基础字符；
   * 若剥完还剩 ZWJ（U+200D，👨‍👩‍👧 组合序列），连带再剥前一个码点。
   */
  function handleEmojiBackspace(): void {
    const text = inputText.value;
    if (text.length == 0) {
      return;
    }
    let cut = text.length;
    // 吞掉结尾的变体选择符
    if (cut > 0 && text.charCodeAt(cut - 1) == 0xfe0f) {
      cut--;
    }
    // 低位代理结尾：连带其高位代理（一个码点两个单元）
    if (cut > 0) {
      const tail = text.charCodeAt(cut - 1) ?? 0;
      if (tail >= 0xdc00 && tail <= 0xdfff && cut > 1) {
        const prev = text.charCodeAt(cut - 2) ?? 0;
        if (prev >= 0xd800 && prev <= 0xdbff) {
          cut--;
        }
      }
    }
    cut--;
    // ZWJ 结尾：组合 emoji 的连接符，连带再剥掉前一个码点（同样先吞 FE0F/代理对）
    if (cut > 0 && (text.charCodeAt(cut - 1) ?? -1) == 0x200d) {
      cut--;
      if (cut > 0 && (text.charCodeAt(cut - 1) ?? -1) == 0xfe0f) {
        cut--;
      }
      if (cut > 0) {
        const tail2 = text.charCodeAt(cut - 1) ?? 0;
        if (tail2 >= 0xdc00 && tail2 <= 0xdfff && cut > 1) {
          const prev2 = text.charCodeAt(cut - 2) ?? 0;
          if (prev2 >= 0xd800 && prev2 <= 0xdbff) {
            cut--;
          }
        }
      }
      cut--;
    }
    if (cut < 0) {
      cut = 0;
    }
    inputText.value = text.substring(0, cut);
  }

  /** 暂存图片张数上限（含已暂存量，与既有相册多选 count 同值）。 */
  const STAGED_IMAGE_MAX = 9;

  /** 暂存条删除单张（按 id 过滤重建数组，响应式安全）。 */
  function removeStagedImage(id: string): void {
    const kept = [] as StagedImage[];
    for (let i = 0; i < stagedImages.value.length; i++) {
      if (stagedImages.value[i].id != id) {
        kept.push(stagedImages.value[i]);
      }
    }
    stagedImages.value = kept;
  }

  // ===== 暂存条行宽实测写回（chat-upload-image / shared-home-tools 同款配方）=====
  // App 原生端内容 flex 行会被压成视口宽：scroll-view 开了横向却 0 滚动余量，
  // flex-shrink:0 的缩略图溢出行盒被裁掉（滚不动的根因）。逐项实测总宽，
  // 超宽时显式写回行宽内联样式制造滚动余量；未超宽走自然布局（0 = 不写 width）。
  const stagedRowWidthPx = ref<number>(0);

  const stagedRowStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    if (stagedRowWidthPx.value > 0) {
      style["width"] = `${stagedRowWidthPx.value}px`;
    }
    return style;
  });

  function stagedRpxToPx(rpx: number): number {
    const info = uni.getWindowInfo();
    const width = info.windowWidth != null ? info.windowWidth : 375;
    return (rpx * width) / 750;
  }

  /** 缩略图逐项实测（含 margin-right 16rpx 与行左右 padding 4rpx），总宽超滚动视口才写回行宽。 */
  function measureStagedRow(attempt: number): void {
    const query = uni.createSelectorQuery();
    query.select(".chat-staged__scroll").boundingClientRect();
    query.selectAll(".chat-staged__item").boundingClientRect();
    query.exec((results: Array<any>) => {
      const ready = results.length >= 2 && results[0] != null && results[1] != null && Array.isArray(results[1]);
      if (ready != true) {
        if (attempt < 2) setTimeout((): void => measureStagedRow(attempt + 1), 180);
        return;
      }
      const viewport = results[0] as NodeInfo;
      const boxes = results[1] as NodeInfo[];
      const viewportWidth = viewport.width != null ? parseFloat(`${viewport.width}`) : 0;
      let contentWidth = 0;
      for (let i = 0; i < boxes.length; i++) {
        const box = boxes[i];
        contentWidth += box.width != null ? parseFloat(`${box.width}`) : 0;
      }
      contentWidth += boxes.length * stagedRpxToPx(16);
      contentWidth += stagedRpxToPx(4 + 4);
      stagedRowWidthPx.value = contentWidth > viewportWidth + 1
        ? Math.ceil(contentWidth) + 2
        : 0;
    });
  }

  // 暂存增删即重量（盒宽固定，上传状态不影响宽度）；v-if 首现也由 0→n 驱动，延迟等渲染
  watch((): number => stagedImages.value.length, (_count: number) => {
    setTimeout((): void => measureStagedRow(0), 120);
  });

  /** 暂存缩略图点击：系统查看器预览（可滑到其余暂存张，微信同款）。 */
  function handleStagedImageTap(current: string): void {
    const urls = [] as string[];
    for (let i = 0; i < stagedImages.value.length; i++) {
      urls.push(stagedImages.value[i].localPath);
    }
    uni.previewImage({ urls, current });
  }

  /**
   * 相册 / 拍摄（图片键 action sheet）：选完先入暂存条（不再立即发送），
   * 可与输入框文案合并成一条 rich_text 发出（形态判定见 handleSend）。
   * 路径读取与 conversation-input 同款：tempFilePaths 优先、tempFiles.path 兜底。
   */
  function handlePickImage(source: string): void {
    const sourceTypes =
      source == "camera"
        ? (["camera"] as ("album" | "camera")[])
        : (["album"] as ("album" | "camera")[]);
    const room = STAGED_IMAGE_MAX - stagedImages.value.length;
    if (room <= 0) {
      uni.showToast({ title: tCount("Mobile.Chat.imageMaxSelect", STAGED_IMAGE_MAX), icon: "none" });
      return;
    }
    uni.chooseImage({
      sourceType: sourceTypes,
      sizeType: ["compressed"],
      count: source == "camera" ? 1 : room,
      success: (res) => {
        const pathList = [] as string[];
        const pathsFromApi = res.tempFilePaths;
        if (pathsFromApi != null) {
          for (let pi = 0; pi < pathsFromApi.length; pi++) {
            const p = pathsFromApi[pi];
            if (p != null && `${p}`.length > 0) {
              pathList.push(`${p}`);
            }
          }
        }
        const tempFiles = res.tempFiles;
        if (pathList.length == 0 && tempFiles != null) {
          for (let fi = 0; fi < tempFiles.length; fi++) {
            const f = tempFiles[fi];
            if (f != null && f.path != null && `${f.path}`.length > 0) {
              pathList.push(`${f.path}`);
            }
          }
        }
        // 逐张入暂存条（点发送时与文案合并 rich_text / 单图直发 image）
        for (let i = 0; i < pathList.length && i < room; i++) {
          const staged = new StagedImage();
          staged.id = generateUUID();
          staged.localPath = pathList[i];
          stagedImages.value.push(staged);
        }
        if (pathList.length > room) {
          uni.showToast({
            title: tCount("Mobile.Chat.imageMaxSelect", STAGED_IMAGE_MAX),
            icon: "none",
          });
        }
      },
      fail: (_err) => {
        // 用户取消选择：无需提示
      },
    });
  }

  /**
   * 视频入口（加号面板）：相册选一条视频，按文件链路上传发送
   * （mime video/* → kind "file"，与 PC 端单附件契约一致，气泡渲染文件卡片）。
   * ★须定义在 queueMediaRow 之后（UTS→Kotlin 先用后定义会报「找不到名称」）。
   */
  function handlePickVideo(): void {
    uni.chooseVideo({
      sourceType: ["album"],
      compressed: true,
      success: (res) => {
        const path = res.tempFilePath;
        if (path == null || path.length == 0) {
          return;
        }
        // 相册视频临时路径可能无扩展名（Android content 路径），补 .mp4 保上传 mime 可判
        let name = "";
        const segs = path.split("/");
        if (segs.length > 0 && segs[segs.length - 1].length > 0) {
          name = segs[segs.length - 1];
        }
        if (name.indexOf(".") < 0) {
          name = `${name}.mp4`;
        }
        queueMediaRow(path, name, false);
      },
      fail: (_err) => {
        // 用户取消选择：无需提示
      },
    });
  }

  /**
   * 图片键（主坞/长文页工具栏）：飞书式二选一——拍摄或从相册选择
   * （加号面板已改为视频/文件，相册与拍摄的唯一入口在此）。
   * ★须定义在 handlePickImage 之后（UTS→Kotlin 先用后定义会报「找不到名称」）。
   */
  function handleImageToolTap(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (panelMode.value.length > 0) {
      panelMode.value = "";
    }
    uni.hideKeyboard({ complete: () => {} });
    uni.showActionSheet({
      itemList: [t("Mobile.Chat.takePhoto"), t("Mobile.Chat.album")],
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        handlePickImage(res.tapIndex == 0 ? "camera" : "album");
      },
    });
  }

  /**
   * 文件入口（加号面板）：H5/Android/鸿蒙走 uni.chooseFile（kotlin/arkts 已实现、H5 原生支持）；
   * iOS 的 chooseFile 无 Swift 实现（modules.json swift=false），走 nuwax-ios-file-picker
   * 插件弹系统 UIDocumentPicker（含自定义基座）。选中文件按文件链路逐个上传发送。
   * ★须定义在 queueMediaRow 之后（UTS→Kotlin 先用后定义会报「找不到名称」）。
   */
  function handlePickFile(): void {
    // #ifdef APP-IOS
    pickIosFiles(
      (path: string, name: string): void => {
        if (path.length == 0) {
          return;
        }
        let resolvedName = name;
        if (resolvedName.length == 0) {
          const pathParts = path.split("/");
          if (pathParts.length > 0) {
            resolvedName = pathParts[pathParts.length - 1];
          }
        }
        queueMediaRow(path, resolvedName, false);
      },
      (_code: string, _message: string): void => {
        // 用户取消/无窗口：无需提示（与 uni.chooseFile 的 fail 同口径）
      },
    );
    return;
    // #endif
    // #ifdef H5 || WEB || APP-ANDROID || APP-HARMONY
    uni.chooseFile({
      type: "file",
      count: 5,
      success: (res) => {
        const tempFiles = res.tempFiles;
        if (tempFiles == null) {
          return;
        }
        for (let i = 0; i < tempFiles.length; i++) {
          const f = tempFiles[i];
          if (f == null || f.path == null || `${f.path}`.length == 0) {
            continue;
          }
          let resolvedName = "";
          if (f.name != null && `${f.name}`.length > 0) {
            resolvedName = `${f.name}`;
          } else {
            const pathParts = `${f.path}`.split("/");
            if (pathParts.length > 0) {
              resolvedName = pathParts[pathParts.length - 1];
            }
          }
          queueMediaRow(`${f.path}`, resolvedName, false);
        }
      },
      fail: (_err) => {
        // 用户取消选择：无需提示
      },
    });
    // #endif
  }

  /**
   * 展开面板 @ 键：收面板回坞后走主坞 @ 链路（进全屏成员选择页，选中回填共享输入框）。
   * ★须定义在 closeExpandSheet/handleMentionKeyTap 之后（UTS→Kotlin 先用后定义会报「找不到名称」）。
   */
  function handleExpandMentionTap(): void {
    closeExpandSheet();
    handleMentionKeyTap();
  }

  /**
   * 展开面板相册键：收面板回坞后走主坞图片键链路（拍摄/相册二选一 action sheet）。
   * ★须定义在 closeExpandSheet/handleImageToolTap 之后（UTS→Kotlin 先用后定义会报「找不到名称」）。
   */
  function handleExpandImageTap(): void {
    closeExpandSheet();
    handleImageToolTap();
  }

  function handleBack(): void {
    // 浏览器刷新后本页成为栈底（getCurrentPages 仅剩本页）：navigateBack 无页可退，
    // H5 会退化成整页重载当前 URL（表现为"一直退不出去、不停刷新"）——栈底直接切回消息 tab
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      switchMainTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  /** 「...」进群设置页（群概览/公告/成员/入群申请/群管理/会话设置，飞书式；
   *  群文件与资料库入口已移至本页子页签行）。 */
  function handleOpenGroupInfo(): void {
    if (convId.value.length == 0) {
      return;
    }
    uni.navigateTo({
      url: `/subpackages/pages/im-group-info/im-group-info?convId=${convId.value}&name=${encodeURIComponent(titleName.value)}`,
    });
  }

  /** 行尾搜索键：进「本会话内搜索」页（ES 服务端搜全量，与文件页只看已加载窗口的口径不同）。 */
  function handleSearchTap(): void {
    if (convId.value.length == 0) {
      return;
    }
    uni.navigateTo({
      url: `/subpackages/pages/im-chat-search/im-chat-search?convId=${convId.value}`,
    });
  }

  /**
   * 子页签点击（单聊与群聊共用，接口均按 convId 过滤）：
   * - messages：恒为选中（本页就是消息页），点击无动作；
   * - pin：从右侧进「Pin 消息」独立页（列表/取消Pin/跳转定位）；
   * - files：复用群文件页（翻历史消息聚合附件），入参带标题「文件」。
   */
  function handleSubpageSelect(id: string): void {
    if (id == "pin") {
      if (convId.value.length == 0) {
        return;
      }
      uni.navigateTo({
        url: `/subpackages/pages/im-chat-pins/im-chat-pins?convId=${convId.value}`,
      });
      return;
    }
    if (id == "files") {
      if (convId.value.length == 0) {
        return;
      }
      uni.navigateTo({
        url:
          `/subpackages/pages/im-group-files/im-group-files?convId=${convId.value}` +
          `&title=${encodeURIComponent(t("Mobile.Message.chatTabFiles"))}`,
      });
      return;
    }
  }

  // ===== 头像 =====
  /** H5：未解析的受保护地址先藏图（返回空，同消息列表——裸 <img> 请求必被 ORB 拦，
   * 还会触发 @error 标死字母兜底）；已解析/普通地址原样返回。App 端恒原样（不解析直连）。 */
  function h5HideUnresolvedProtected(url: string): string {
    // #ifdef H5 || WEB
    if (isAuthProtectedFileUrl(url)) return "";
    // #endif
    return url;
  }

  /** ★尾参 tick（App-Android 方法调用绑定不收集方法体内依赖，readInfoTick 先例）：
   * 头像异步解析完成后 bump avatarResolveTick 强制本绑定重算，换上可展示地址。 */
  function avatarSrcOf(msg: ImMsgRow, _tick: number = 0): string {
    if (msg.senderAvatar.length > 0) {
      const hit = avatarDisplayCache.get(msg.senderAvatar);
      if (hit != null) return hit;
      return h5HideUnresolvedProtected(msg.senderAvatar);
    }
    const raw = isMine(msg) ? myAvatar.value : peerAvatar.value;
    if (raw.length > 0) {
      const hit = avatarDisplayCache.get(raw);
      if (hit != null) return hit;
      return h5HideUnresolvedProtected(raw);
    }
    return raw;
  }

  function avatarFailedOf(msg: ImMsgRow): boolean {
    return isMine(msg) ? myAvatarFailed.value : false;
  }

  function handleAvatarError(msg: ImMsgRow): void {
    if (isMine(msg)) {
      myAvatarFailed.value = true;
    } else {
      msg.avatarFailed = true;
    }
    // App-Android 方法绑定不收集依赖：bump 通知上方 v-if 重算，切到字母渐变兜底
    avatarResolveTick.value = avatarResolveTick.value + 1;
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  // ==================== IM WebSocket 事件订阅 ====================
  // IM WS 在 App.uvue onLaunch 中启动。本页订阅下行事件做消息列表实时增量插入。
  // 设计原则：
  // - 仅当 payload.convId == 当前会话时处理（避免在 A 会话页收到 B 会话消息造成 UI 错位）
  // - 按 msgId 去重：已在 messages.value 中的跳过（重连重传 / HTTP /sync 兜底都可能重复）
  // - 按 seq 插入到正确位置：messages.value 是「老→新」升序，找到第一个 seq > row.seq 的位置
  // - MSG_RECV_ACK 由 ImWsClient 内部自动回，业务层不感知

  /**
   * 把 row 按 seq 升序插入到 messages.value 的正确位置（去重后）。
   * messages.value 是「老→新」升序：插入点 = 第一个 seq > row.seq 的索引；否则末尾追加。
   */
  /**
   * 按 msgId 去重 + seq 升序插入一条消息。
   * @param autoScroll true=实时消息插到末尾时滚到底（WS 下行）；false=静默同步不打断用户浏览
   */
  function insertMessageBySeq(row: ImMsgRow, autoScroll: boolean): void {
    const rows = messages.value;
    // 去重
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].msgId == row.msgId) {
        return;
      }
    }
    let insertAt = rows.length;
    for (let i = 0; i < rows.length; i++) {
      const s = rows[i].seq;
      if (typeof s === "number" && s > row.seq) {
        insertAt = i;
        break;
      }
    }
    rows.splice(insertAt, 0, row);
    messages.value = rows;
    // 经 messages.value 取代理实例再解析（loadHistory/sendMediaWithRow 同款约束）：
    // App 端改原始对象属性不触发视图刷新——否则受保护图片改写成可展示地址后
    // <image> 仍持旧地址，表现为「列表里图不显示、点击却能放大」（点击经代理
    // 读到的是新地址）。WS 实时消息与静默同步插入都走本函数。
    resolveRowMedia(messages.value[insertAt]);
    // 视频预载：新插入的视频行也自动挂首帧（非视频行扫描零成本）
    preloadChatVideos();
    // 滚动到底部：仅当 row 是新增且 seq 大于本地最大 seq（真正的实时消息）；
    // ★仅贴底时才滚（nearChatBottom 由浮钮探测维护）——在读历史时新消息到达
    //   不拽走阅读位置（微信式不打扰），靠右下角「回到底部」浮钮回最新
    if (isChatActive() && autoScroll && insertAt >= rows.length - 1 && nearChatBottom.value) {
      scrollToBottom();
    }
    // 上报已读
    reportReadIfNeeded(maxSeq());
  }


  function handleImMessagesSynced(payload: any): void {
    if (!isChatCurrent() || payload == null) {
      return;
    }
    const obj = payload as UTSJSONObject;
    const records = obj["records"];
    if (records != null && Array.isArray(records)) {
      if (mergeSyncedMessages(records as UTSJSONObject[])) {
        scheduleReadRefresh();
      }
    }
  }

  /**
   * 静默同步最新一页（Q2：页面停留/onShow 兜底刷新；不打 loading、不打断滚动）。
   * 与 WS 下行互补：断线重连期间漏的消息、WS 未连上时其他端发的消息都靠这里补。
   * 成功顺带刷新首屏缓存；失败完全静默（下次 onShow/WS 再试）。
   * ★定义在 insertMessageBySeq 之后、initHistory 之前（UTS→Kotlin 先用后定义报「找不到名称」）。
   */
  let latestSyncLoading = false;
  async function silentSyncLatest(): Promise<void> {
    if (!isChatCurrent() || latestSyncLoading || convId.value.length == 0) {
      return;
    }
    latestSyncLoading = true;
    try {
      const res = await apiImMessages(convId.value, 0, MSG_PAGE_SIZE);
      if (!isChatCurrent()) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj == null) {
        return;
      }
      const recordsRaw = dataObj["records"];
      if (recordsRaw == null) {
        return;
      }
      const records = recordsRaw as UTSJSONObject[];
      if (records.length > 0) {
        setCachedChatRecords(convId.value, records);
        collectChatAttachments(convId.value, records);
      }
      mergeSyncedMessages(records);
      scheduleReadRefresh();
    } catch (_error) {
      // 静默失败
    } finally {
      latestSyncLoading = false;
    }
  }

  /** 静默同步完成后：进页时在底部的场景补滚到真最新（同步可能追加了新消息）。 */
  async function settleAfterSync(needBottom: boolean): Promise<void> {
    await silentSyncLatest();
    if (!isChatCurrent()) return;
    if (needBottom && entryFollowLatest) {
      scrollToBottom();
    }
  }

  /**
   * onLoad 发起的 loadMyInfo 任务：冷启动首进（无缓存可用）时 initHistory
   * 等它落地再渲染首屏，保证我方消息首帧就在右侧（请求仍并行发出，只 gate 渲染）。
   */
  let myInfoPending: Promise<void> | null = null;

  async function initHistory(): Promise<void> {
    if (loading.value) {
      return;
    }
    // 冷启动 myUserId 未知：等用户信息返回（失败也放行，保持全左侧旧兜底）；
    // 暖会话 loadMyInfo 已同步回填缓存，此处零等待直落首屏
    const myInfoTask = myInfoPending;
    if (myUserId.value.length == 0 && myInfoTask != null) {
      myInfoPending = null;
      await myInfoTask;
      if (!isChatCurrent()) return;
    }
    // 附件缓存重置：文件页数据源只看本窗口已加载的消息（从首屏起重新累积）
    resetChatAttachments(convId.value);
    // 命中缓存：免网络立即渲染上次窗口并滚底，随后静默增量同步（Q3：重进不重新 load）
    const cached = getCachedChatRecords(convId.value);
    if (cached != null) {
      loading.value = false;
      loadFailed.value = false;
      messages.value = [];
      // 缓存即接口原文（降序 新→旧），与 loadHistory 同款逐条 unshift 后头部为最旧
      mergeSyncedMessages(cached);
      hasMore.value = cached.length >= MSG_PAGE_SIZE;
      collectChatAttachments(convId.value, cached);
      // 重新进入会话始终展示最新消息，不恢复上次阅读的历史位置。
      scrollToBottom();
      settleAfterSync(true);
      reportReadIfNeeded(maxSeq());
      refreshReadStatus();
      return;
    }
    loading.value = true;
    loadFailed.value = false;
    try {
      await loadHistory(0);
      loading.value = false;
      scrollToBottom();
    } catch (_error) {
      loading.value = false;
      loadFailed.value = true;
      // 异常路径没有走 scrollToBottom 的揭幕：直接揭，避免失败/空态被遮蔽卡住
      listSettled.value = true;
    }
  }

  function handleRetry(): void {
    if (loadFailed.value) {
      initHistory();
    }
  }

  /**
   * 智能体回复落地 ⇒ 该智能体的「处理中」行就地推到「完成」（乐观收口）。
   *
   * 依据后端时序（ImAgentChatService.settleAndForward）：⑥整批 settle（终态落库
   * + 推 3006 帧）严格先于 ⑦代发回复——回复消息能到达 ⟹ 库里已是 DONE。但 3006 走
   * 按发送者路由的广播管道、回复走消息扇出管道，两条管道延迟不同：回复都渲染了
   * 转钟还在转的窗口就是 3006 晚到/乱序。这里不等帧，回复落地立即收口。
   * - 代发消息 senderId == agentSubjectId（sendAgentReply 的 runAs 上下文），按它精确匹配；
   * - 只动该发送者 status==2 的明细：1=未读属于下一轮排队（回复对应的是已开跑的批），
   *   动了会把紧跟着发的新消息误标完成；
   * - 单调合并保证随后真 3006(4) 帧幂等；失败轮不代发（回复存在 ⟹ outcome.isOk），
   *   不会有 3 跟在回复后面被 4 挡掉。
   */
  function settleAgentProcessingOnReply(senderId: string): void {
    if (senderId.length == 0) {
      return;
    }
    const rows = messages.value;
    let touched = false;
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      if (row.agentStatus != IM_AGENT_STATUS_PROCESSING) {
        continue;
      }
      const detail = row.agentDetail;
      for (let j = 0; j < detail.length; j++) {
        if (
          detail[j].agentSubjectId == senderId &&
          detail[j].status == IM_AGENT_STATUS_PROCESSING
        ) {
          const done = new ImAgentStatusItem();
          done.agentSubjectId = senderId;
          done.status = IM_AGENT_STATUS_DONE;
          done.updateTime = Date.now();
          const incoming: ImAgentStatusItem[] = [done];
          if (mergeRowAgentDetail(row, incoming)) {
            touched = true;
          }
          break;
        }
      }
    }
    if (touched) {
      scheduleChatMediaRefresh();
    }
  }

  function handleImMessageReceived(payload: any): void {
    if (!isChatCurrent() || payload == null) {
      return;
    }
    // any 参数不能 .property 访问（Kotlin 后端）：转 UTSJSONObject 走 bracket 访问
    const obj = payload as UTSJSONObject;
    // HTTP 同步由批次事件消费，不能再次按实时消息触发滚动/已读。
    if (readString(obj, "reqId") == "sync-fallback") {
      return;
    }
    const msgConvId = readString(obj, "convId");
    if (msgConvId.length == 0 || msgConvId != convId.value) {
      return;
    }
    const raw = obj["raw"];
    if (raw == null || typeof raw !== "object") {
      return;
    }
    // 复用现有 readMsgRow（line 1801）从 MessageDto 构造 ImMsgRow
    const row = readMsgRow(raw as UTSJSONObject);
    if (row.msgId.length == 0) {
      return;
    }
    insertMessageBySeq(row, true);
    // 多端同步：同一账号在 PC 等其他端发的我方消息 ⇒ 落地即排一次已读查询，
    // icon 不必等 onShow/本端下次发送（refreshReadStatus 内部自筛候选，非我方消息空转）
    if (isMine(row)) {
      scheduleReadRefresh();
    } else {
      // 对方消息落地即乐观收口智能体转钟（人类 senderId 匹配不到任何明细，天然空转）
      settleAgentProcessingOnReply(row.senderId);
    }
  }

  /**
   * READ_NOTIFY 实时已读回执（语义对齐 PC store/chat.ts 的 onReadNotify/onReadNotifyAgg）：
   * - 4001 逐人帧 {userId, readSeq}：单聊读者只有对方 ⇒ readSeq 水位即答案，本地直推（即时）；
   *   群聊这帧推不出「几个人读了」⇒ 不猜数字，去抖后问服务端要真值。
   * - 4002 聚合帧（>500 人群）{counts:[{msgId,readCount}]}：命中缓存的就地补 readCount，
   *   无缓存（拿不到分母 eligibleCount）只能去抖重查。
   */
  function handleImReadNotified(payload: any): void {
    if (!isChatCurrent() || payload == null) {
      return;
    }
    const obj = payload as UTSJSONObject;
    const frameConvId = readString(obj, "convId");
    if (frameConvId.length == 0 || frameConvId != convId.value) {
      return;
    }
    if (readBool(obj, "aggregated")) {
      const countsRaw = obj["counts"];
      if (countsRaw == null) {
        return;
      }
      const counts = countsRaw as UTSJSONObject[];
      let miss = false;
      const infos = readInfos.value;
      for (let i = 0; i < counts.length; i++) {
        const one = counts[i];
        const msgId = readString(one, "msgId");
        if (msgId.length == 0) {
          continue;
        }
        let foundIdx = -1;
        for (let j = 0; j < infos.length; j++) {
          if (infos[j].msgId == msgId) {
            foundIdx = j;
            break;
          }
        }
        if (foundIdx < 0) {
          miss = true;
          continue;
        }
        // ★App-Android 就地改属性不触发视图（见 mergeReadInfo 注释）：splice 整体替换
        const old = infos[foundIdx];
        const readCount = readNumber(one, "readCount", old.readCount);
        const updated = new ImReadInfo();
        updated.msgId = msgId;
        updated.readCount = readCount;
        updated.eligibleCount = old.eligibleCount;
        updated.readAll = old.eligibleCount > 0 && readCount >= old.eligibleCount;
        infos.splice(foundIdx, 1, updated);
        bumpReadInfoTick();
      }
      if (miss) {
        scheduleReadRefresh();
        scheduleReadSettle();
      }
      return;
    }
    if (isGroupLike.value) {
      scheduleReadRefresh();
      scheduleReadSettle();
      return;
    }
    const readSeq = readNumber(obj, "readSeq", 0);
    if (readSeq <= 0) {
      return;
    }
    // 单聊本地推水位：我发的、已确认、未撤回且 seq ≤ readSeq 的行全部已读
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      if (isMine(row) != true || row.status != 1 || row.revoked || isConfirmedRow(row) != true) {
        continue;
      }
      if (row.seq > readSeq) {
        continue;
      }
      const infos = readInfos.value;
      let foundIdx = -1;
      for (let j = 0; j < infos.length; j++) {
        if (infos[j].msgId == row.msgId) {
          foundIdx = j;
          break;
        }
      }
      if (foundIdx < 0) {
        const added = new ImReadInfo();
        added.msgId = row.msgId;
        added.readCount = 1;
        added.eligibleCount = 1;
        added.readAll = true;
        readInfos.value.push(added);
        bumpReadInfoTick();
      } else {
        // ★App-Android 就地改属性不触发视图（见 mergeReadInfo 注释）：splice 整体替换
        const old = infos[foundIdx];
        const updated = new ImReadInfo();
        updated.msgId = row.msgId;
        updated.readCount = old.readCount < 1 ? 1 : old.readCount;
        updated.eligibleCount = old.eligibleCount < 1 ? 1 : old.eligibleCount;
        updated.readAll = true;
        infos.splice(foundIdx, 1, updated);
        bumpReadInfoTick();
      }
    }
  }

  /**
   * WS 重连补查（PC DEV-292 D4 同款）：断线期间的 READ_NOTIFY 帧不会补投（WS 无存储转发），
   * 重连成功后对当前会话排一次已读查询自愈，否则 icon 停在断线前的旧值。
   */
  function handleImConnectionState(payload: any): void {
    if (!isChatCurrent() || payload == null) {
      return;
    }
    const obj = payload as UTSJSONObject;
    if (readString(obj, "state") == "open") {
      scheduleReadRefresh();
    }
  }

  /**
   * CONV_UNREAD(6001)：同账号其他端（PC）读了本会话 ⇒ 后端给「自己的其他端」清未读并
   * 同步 readSeq。★READ_NOTIFY(4001) 的扇出按 userId 排除读者本人 ⇒ 同账号多端场景
   * 手机端收不到已读帧，只能借这条帧感知「我方账号在别处读到了新位置」——排一次
   * 已读重查（自己的阅读也计入 readCount，真值以服务端为准；PC 端正是靠进会话时的
   * 同一查询拿到的新值）。⑥号帧发自己全部设备−源端，收到即代表别端读过，无需水位判断。
   */
  function handleImConvUnread(payload: any): void {
    if (!isChatCurrent() || payload == null) {
      return;
    }
    const obj = payload as UTSJSONObject;
    const frameConvId = readString(obj, "convId");
    if (frameConvId.length == 0 || frameConvId != convId.value) {
      return;
    }
    scheduleReadRefresh();
    scheduleReadSettle();
  }

  /** MSG_REACTION(3008)：reactions 全量快照就地替换目标行（增/删同推；操作端
   *  自己也收——REST 响应已替换过一次，重复替换幂等无害）。 */
  function handleImMessageReaction(payload: any): void {
    if (!isChatCurrent() || payload == null) {
      return;
    }
    const obj = payload as UTSJSONObject;
    const frameConvId = readString(obj, "convId");
    if (frameConvId.length == 0 || frameConvId != convId.value) {
      return;
    }
    applyReactionSnapshot(readString(obj, "msgId"), obj["reactions"]);
  }

  function handleImMessageRevoked(payload: any): void {
    if (!isChatCurrent() || payload == null) {
      return;
    }
    const obj = payload as UTSJSONObject;
    const msgConvId = readString(obj, "convId");
    if (msgConvId.length == 0 || msgConvId != convId.value) {
      return;
    }
    const msgId = readString(obj, "msgId");
    if (msgId.length == 0) {
      return;
    }
    const revokeBy = readString(obj, "revokeBy");
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].msgId == msgId) {
        rows[i].revisionAt = Math.max(rows[i].revisionAt, readNumber(obj, "revokeTime", 0));
        rows[i].revoked = true;
        rows[i].revokeById = revokeBy;
        rows[i].bodyText = "";
        return;
      }
    }
  }

  function handleImMessageEdited(payload: any): void {
    if (!isChatCurrent() || payload == null) {
      return;
    }
    const obj = payload as UTSJSONObject;
    const msgConvId = readString(obj, "convId");
    if (msgConvId.length == 0 || msgConvId != convId.value) {
      return;
    }
    const msgId = readString(obj, "msgId");
    if (msgId.length == 0) {
      return;
    }
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].msgId == msgId) {
        const row = rows[i];
        const revision = readNumber(obj, "editTime", 0);
        if (row.revoked || revision < row.revisionAt) return;
        const bodyRaw = obj["body"];
        if (bodyRaw != null) {
          row.bodyText = readString(bodyRaw as UTSJSONObject, "text");
          row.edited = true;
          row.revisionAt = revision;
          applyRichToRow(row);
        }
        return;
      }
    }
  }

  /**
   * MSG_AGENT_STATUS(3006)：智能体对某条消息的处理状态推进（仅发送者本人收到；
   * 后端仅「处理中/终态」推帧——未读建行不推，PC 同款链路）。
   * P1 帧可丢可重可乱序 ⇒ 单调并入；行不在当前窗口（历史翻走了）= 安全忽略。
   */
  function handleImAgentStatus(payload: any): void {
    if (!isChatCurrent() || payload == null) {
      return;
    }
    const obj = payload as UTSJSONObject;
    const frameConvId = readString(obj, "convId");
    if (frameConvId.length == 0 || frameConvId != convId.value) {
      return;
    }
    const msgId = readString(obj, "msgId");
    if (msgId.length == 0) {
      return;
    }
    const item = parseAgentStatusObject(obj);
    if (item == null) {
      return;
    }
    const rows = messages.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].msgId == msgId) {
        const row = rows[i];
        const incoming: ImAgentStatusItem[] = [item];
        if (mergeRowAgentDetail(row, incoming)) {
          // Android 不追踪行内原地变更：整表去抖重建触发 v-for 重渲（表情回应同款）
          scheduleChatMediaRefresh();
        }
        return;
      }
    }
  }

  // ★App-Android(UTS→Kotlin) 裸函数引用传 eventBus.on 绑不上回调（订阅静默失效，
  // 聊天页不实时的直接原因；须箭头包装）；on/off 同一引用故存具名 const
  const onImMessagesSynced = (payload: any): void => { handleImMessagesSynced(payload); };
  const onImMessageReceived = (payload: any): void => { handleImMessageReceived(payload); };
  const onImMessageRevoked = (payload: any): void => { handleImMessageRevoked(payload); };
  const onImMessageEdited = (payload: any): void => { handleImMessageEdited(payload); };
  const onImReadNotified = (payload: any): void => { handleImReadNotified(payload); };
  const onImConnectionState = (payload: any): void => { handleImConnectionState(payload); };
  const onImConvUnread = (payload: any): void => { handleImConvUnread(payload); };
  const onImMessageReaction = (payload: any): void => { handleImMessageReaction(payload); };
  const onImAgentStatus = (payload: any): void => { handleImAgentStatus(payload); };

  /** 当前用户信息：区分我方/对方消息 + 我方头像昵称（IM senderId 即平台用户 id）。 */
  async function loadMyInfo(): Promise<void> {
    // ★先同步回填上次拉取的用户信息（会话戳失效，不串账号）：首屏消息缓存免网络
    //   立即渲染，若 myUserId 仍空，我方消息会先按对方侧渲染、接口返回后再翻到
    //   右侧（约一个网络往返的用户可感闪动）。resolveChatAvatarUrl 幂等可重复调
    const cachedInfo = getCachedMyInfo();
    if (cachedInfo != null && myUserId.value.length == 0) {
      myUserId.value = cachedInfo.userId;
      myDisplayName.value = cachedInfo.displayName;
      myAvatar.value = cachedInfo.avatar;
      resolveChatAvatarUrl(myAvatar.value);
    }
    try {
      const res = await apiUserInfo();
      if (!isChatCurrent()) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj != null) {
          myUserId.value = readString(dataObj, "id");
          const nickName = readString(dataObj, "nickName");
          const userName = readString(dataObj, "userName");
          myDisplayName.value = nickName.length > 0 ? nickName : userName;
          myAvatar.value = readString(dataObj, "avatar");
          resolveChatAvatarUrl(myAvatar.value);
          setCachedMyInfo(myUserId.value, myDisplayName.value, myAvatar.value);
        }
      }
    } catch (_error) {
      // 拉取失败时 myUserId 为空：全部按对方侧渲染，不影响收发
    }
  }

  const onImSessionCleared = (_payload: any): void => {
    releaseChatImages();
    messages.value = [];
    readInfos.value = [];
    deferredMediaIds.clear();
    cancelSettle();
    readStatusSeq += 1;
  };

  function clearChatUiTimers(): void {
    cancelSettle();
    // 按住说话波形 timer 一并停（页面隐藏/卸载后不再跳动；蒙层三阶段态一并复位，
    // editing 草稿丢弃——在途上传不中断，行照发，voiceAudioSending 解除防重）
    stopVoiceWaveTimer();
    voiceStage.value = "idle";
    recordWillCancel.value = false;
    voiceAudioSending.value = false;
    if (readReportTimer != 0) clearTimeout(readReportTimer);
    readReportTimer = 0;
    if (chatScrollIdleTimer != 0) clearTimeout(chatScrollIdleTimer);
    if (pressTouchTimer != 0) clearTimeout(pressTouchTimer);
    if (pageTouchResetTimer != 0) clearTimeout(pageTouchResetTimer);
    if (jumpLatestCheckTimer != 0) clearTimeout(jumpLatestCheckTimer);
    chatScrollIdleTimer = 0;
    pressTouchTimer = 0;
    pageTouchResetTimer = 0;
    jumpLatestCheckTimer = 0;
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    // App 三端：按会话恢复上次输入方式（"input"=键盘，未记录/语音=语音条）；渲染在 onLoad 后，无闪切
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    if (convId.value.length > 0) {
      voiceMode.value = uni.getStorageSync(inputMethodKey()) != "input";
    }
    // #endif
    const convTypeRaw = readOption(options, "convType");
    const parsedType = parseFloat(convTypeRaw);
    convType.value = isNaN(parsedType) ? 1 : parsedType;
    const name = readOption(options, "name");
    titleName.value = name.length > 0 ? name : t("Mobile.Common.conversations");
    peerAvatar.value = readOption(options, "avatar");
    resolveChatAvatarUrl(peerAvatar.value);
    // 搜索页带来的定位消息：历史首屏就绪后翻页查找并滚动高亮（onShow 兜底应用）
    const jumpMsgId = readOption(options, "jumpMsgId");
    if (convId.value.length > 0) {
      myInfoPending = loadMyInfo();
      // 进页即拉 @ 数据源（群聊=群成员 / 单聊=联系人；@面板与提及高亮依据，不阻塞首屏）
      loadMembers();
      // 长按操作的能力依据（群治理开关/我的角色、置顶集、撤回时限），不阻塞首屏
      loadConvInfo();
      loadPinnedIds();
      loadRevokeWindow();
      // 常用表情预热（长按面板第一行数据源；用户级资源，失败回落默认组，不阻塞首屏）
      loadRecentEmojis();
      initHistory().then((): void => {
        if (jumpMsgId.length > 0) {
          pendingJumpId = jumpMsgId;
          jumpToMsg(jumpMsgId);
        }
      });
    } else {
      loadFailed.value = true;
    }
    // 引用详情页「定位到聊天位置」：跳回本页后滚动定位并闪烁高亮目标消息
    uni.$on(IM_CHAT_JUMP_EVENT, onJumpEvent);
    // at-select 页 @成员选完：回填 "@token " 到输入框（可连选多个）
    uni.$on(IM_AT_PICK_EVENT, onAtPickEvent);
    eventBus.on(IM_SESSION_CLEARED, onImSessionCleared);
    // 订阅 IM WS 实时下行事件（按 convId 过滤；消息去重+按 seq 插入由 handleImMessageReceived 处理）
    eventBus.on(`${EVENT_TYPE.ImMessagesSynced}`, onImMessagesSynced);
    eventBus.on(`${EVENT_TYPE.ImMessageReceived}`, onImMessageReceived);
    eventBus.on(`${EVENT_TYPE.ImMessageRevoked}`, onImMessageRevoked);
    eventBus.on(`${EVENT_TYPE.ImMessageEdited}`, onImMessageEdited);
    // 已读回执实时更新（4001 单聊本地推/群聊去抖重查；4002 聚合补丁）+ 重连补查
    eventBus.on(`${EVENT_TYPE.ImReadNotified}`, onImReadNotified);
    eventBus.on(`${EVENT_TYPE.ImConnectionState}`, onImConnectionState);
    // 同账号其他端（PC）读本会话 ⇒ 4001 按 userId 排除本人收不到，借 6001 触发重查
    eventBus.on(`${EVENT_TYPE.ImConversationUnread}`, onImConvUnread);
    // 表情回复实时同步（op 3008 全量快照，本会话内按 msgId 就地替换）
    eventBus.on(`${EVENT_TYPE.ImMessageReaction}`, onImMessageReaction);
    // 智能体处理状态实时推进（op 3006：处理中转钟 → 终态蓝勾/红叹，仅发送者收到）
    eventBus.on(`${EVENT_TYPE.ImAgentStatus}`, onImAgentStatus);
    // #ifndef H5 || WEB
    // 键盘高度监听（App 三端/小程序；H5 不支持该 API）：驱动 liftPx 刚体平移让位。
    // 保存监听 id 精确注销（无参 off 会清掉全局所有监听，殃及 conversation-input 等组件）；
    // Android 上事件可能不派发（子页返回后），由 startAndroidImePolling 轮询兜底
    chatKeyboardListenerId = uni.onKeyboardHeightChange((res) => {
      // 相同高度的重复回调忽略（收起时可能补发多次 0），避免无谓重排；
      // 但预抬后同高回调 = 真值确认，须清看门狗防误回落；同高确认也证明当前值即终值，
      // 必须同时撤销缓落地的矮中间值（否则 500ms 后落地矮值 = 让位先落后弹）
      if (res.height == keyboardHeight.value) {
        clearKbWatchdog();
        cancelIosKbShortHold();
        return;
      }
      // #ifdef APP-IOS
      // iOS 动画沿多次派发（中间高度+终值），去抖收敛到终值一次落地防抖动
      scheduleIosKbApply(res.height);
      // #endif
      // #ifndef APP-IOS
      applyKeyboardHeight(res.height, "event");
      // #endif
    });
    // #endif
    // #ifdef APP-IOS || APP-HARMONY
    // 上次真实键盘高度缓存（与 agent-detail/resident-shell 同 key；iOS/鸿蒙写入方为裸
    // 事件高度语义一致）：focus 预测预抬用（仅聚焦时采信，防「幽灵空白」）
    try {
      const rawKb = uni.getStorageSync("NUWAX_KB_LAST_H");
      if (rawKb != null) {
        const cachedKb = parseFloat(`${rawKb}`);
        if (!isNaN(cachedKb) && cachedKb > 60 && cachedKb < 800) {
          kbLastHCache = cachedKb;
        }
      }
    } catch (_eKb) {
      // ignore
    }
    // #endif
  });

  onUnload(() => {
    releasePrependAnchor();
    clearChatUiTimers();
    if (chatMediaRefreshTimer != 0) {
      clearTimeout(chatMediaRefreshTimer);
      chatMediaRefreshTimer = 0;
    }
    clearStopAudioOnHideTimer();
    destroyChatAudio();
    eventBus.off(IM_SESSION_CLEARED, onImSessionCleared);
    pageDisposed = true;
    releaseChatImages();
    releaseChatVideos();
    // onUnload 时原生退场动画可能仍在绘制本页；保留最后一帧数据，
    // 随页面实例销毁回收，避免清空数组触发“暂无聊天消息”闪烁。
    pageVisible = false;
    readStatusSeq += 1;
    cancelSettle();
    deferredMediaIds.clear();
    // #ifndef H5 || WEB
    if (chatKeyboardListenerId != 0) {
      uni.offKeyboardHeightChange(chatKeyboardListenerId);
      chatKeyboardListenerId = 0;
    }
    // #endif
    stopAndroidImePolling();
    if (androidImeCalibTimer != 0) {
      clearTimeout(androidImeCalibTimer);
      androidImeCalibTimer = 0;
    }
    if (kbWatchdogTimer != 0) {
      clearTimeout(kbWatchdogTimer);
      kbWatchdogTimer = 0;
    }
    cancelIosKbDebounce();
    cancelIosKbShortHold();
    if (scrollMemoSaveTimer != 0) {
      clearTimeout(scrollMemoSaveTimer);
      scrollMemoSaveTimer = 0;
    }
    if (rowPressTimer != 0) {
      clearTimeout(rowPressTimer);
      rowPressTimer = 0;
      rowPressTarget = null;
    }
    if (avatarPressTimer != 0) {
      clearTimeout(avatarPressTimer);
      avatarPressTimer = 0;
      avatarPressTarget = null;
    }
    uni.$off(IM_CHAT_JUMP_EVENT, onJumpEvent);
    uni.$off(IM_AT_PICK_EVENT, onAtPickEvent);
    // 注销 IM WS 事件订阅
    eventBus.off(`${EVENT_TYPE.ImMessagesSynced}`, onImMessagesSynced);
    eventBus.off(`${EVENT_TYPE.ImMessageReceived}`, onImMessageReceived);
    eventBus.off(`${EVENT_TYPE.ImMessageRevoked}`, onImMessageRevoked);
    eventBus.off(`${EVENT_TYPE.ImMessageEdited}`, onImMessageEdited);
    eventBus.off(`${EVENT_TYPE.ImReadNotified}`, onImReadNotified);
    eventBus.off(`${EVENT_TYPE.ImConnectionState}`, onImConnectionState);
    eventBus.off(`${EVENT_TYPE.ImConversationUnread}`, onImConvUnread);
    eventBus.off(`${EVENT_TYPE.ImMessageReaction}`, onImMessageReaction);
    eventBus.off(`${EVENT_TYPE.ImAgentStatus}`, onImAgentStatus);
    clearAgentClockTimers();
    if (readRefreshTimer != 0) {
      clearTimeout(readRefreshTimer);
      readRefreshTimer = 0;
    }
    if (readSettleTimer != 0) {
      clearTimeout(readSettleTimer);
      readSettleTimer = 0;
    }
    clearFlashTimers();
  });

  // 首次 onShow 与 onLoad 的首屏拉取重合，跳过避免重复请求（message.uvue 同款惯用法）
  let chatHasShownOnce = false;
  onShow(() => {
    pageVisible = true;
    for (let i = 0; i < messages.value.length; i++) {
      const row = messages.value[i];
      if (deferredMediaIds.has(row.msgId)) resolveRowMedia(row);
    }
    if (deferredAnchor.length > 0) scrollToAnchorWithSettle(deferredAnchor);
    reportReadIfNeeded(maxSeq());
    // Android：进子页返回的 show/hide 周期里原生 gravity 可能被重置回 top，
    // 未重新聚焦前 placeholder 会贴上沿，返回时按拍兜底重设（textarea 卸载时逐拍空转）
    sweepAndroidInputGravity(6);
    // 从子页（@ 成员选择等）回来：若键盘本就开着（部分机型事件已哑），轮询立即接管；
    // 否则校准残留让位（键盘已收但收起事件丢失时，输入坞下方不留「键盘空白」）
    if (inputFocused.value || expanded.value) {
      startAndroidImePolling();
    } else {
      calibrateAndroidImeAfterShow();
    }
    // @ 成员选择页选完返回：等页面切换动画收尾再聚焦拉键盘（太早窗口未就绪不生效）
    if (pendingFocusAfterAtPick) {
      pendingFocusAfterAtPick = false;
      if (voiceMode.value != true && convDisbanded.value != true) {
        setTimeout((): void => {
          if (pageVisible == true) {
            focusChatInput();
          }
        }, 300);
      }
    }
    // 从别的页面回来：置顶集与已读计数是多人共享状态，重拉自我纠正
    loadPinnedIds();
    refreshReadStatus();
    // 静默同步最新消息（离开期间其他端新发的消息兜底；不打断滚动）
    if (chatHasShownOnce && convId.value.length > 0 && messages.value.length > 0) {
      silentSyncLatest();
    }
    chatHasShownOnce = true;
    if (pendingJumpId.length == 0) {
      return;
    }
    // 从 quote-detail 返回本页后再滚动定位并闪烁（延迟一拍等页面切换完成）
    setTimeout(() => {
      if (!isChatActive()) return;
      applyPendingJump();
    }, 100);
  });

  onHide(() => {
    releasePrependAnchor();
    pageVisible = false;
    // 进子页停语音/视频播放（微信同款：离开聊天即停；视频只暂停不清首帧）；
    // 息屏/锁屏/切后台不停语音——判后台放行续播，见 stopChatAudioOnHideIfNeeded
    stopChatAudioOnHideIfNeeded();
    pauseChatVideos();
    if (!listSettled.value && scrollAnchor.value.length > 0) deferredAnchor = scrollAnchor.value;
    clearChatUiTimers();
    cancelSettle();
    readStatusSeq += 1;
    if (readRefreshTimer != 0) {
      clearTimeout(readRefreshTimer);
      readRefreshTimer = 0;
    }
    readRefreshOwed = false;
    // 进子页/切后台停轮询：避免读到子页（如成员选择搜索框）的键盘高度误驱动本页让位
    stopAndroidImePolling();
    // 预抬看门狗一并清（离开页面后预测必失效，防切后台期间误回落）
    clearKbWatchdog();
    cancelIosKbDebounce();
    cancelIosKbShortHold();
    // 返回/进子页/切后台时记忆阅读位置（下次进页恢复）
    saveScrollMemo();
  });

  onReady(() => {
    // 二次刷新底部安全区（iOS 首帧前 safeAreaInsets 可能为 0）
    safeBottomPx.value = getSafeAreaBottom();
    // 面板槽 rpx→px 换算基淮同步刷新（首帧前 getWindowInfo 可能未就绪）
    chatWindowWidthPx = uni.getWindowInfo().windowWidth;
    // Android：输入框已挂载时把原生 gravity 设为垂直居中；进页首帧原生视图可能
    // 晚于 onReady 挂载（单次调用会静默空转，未聚焦时 placeholder 偏上），带重试兜到挂载
    centerAndroidInputGravityWithRetry(8);
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架：渐变底 + 头/列表/输入坞三段 ===== */
  .chat-page {
    display: flex;
    flex-direction: column;
    position: relative; /* 让位填充带（absolute 贴屏底）的定位锚 */
    /* #ifdef H5 */
    height: 100%;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
    /* #ifndef H5 */
    flex: 1;
    /* #endif */
    background-color: #ffffff;
  }

  /* 顶部固定区：主体刚体平移时消息会从底下透上来——不透明底 + z-index 压住（白底与页面同色，视觉零变化） */
  .chat-top {
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    background-color: #ffffff;
  }

  /* 主体区（列表+输入坞+面板槽）：随键盘/面板刚体平移 translateY(-liftPx)。视口尺寸不变
     （无 reflow），在底部天然贴底、看历史天然保位；曲线为 agent-detail 注入 H5 已调过的键盘近似 */
  .chat-main {
    flex: 1;
    min-height: 0;
    position: relative; /* 面板槽 absolute 的定位锚 */
    z-index: 1;
    transition-property: transform;
    transition-duration: 250ms;
    transition-timing-function: cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  .chat-header {
    flex-shrink: 0;
    height: 108rpx;
    padding: 0 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-bottom: 2rpx solid #e5e6eb;
  }

  /* 单聊：分割线由下方子页签行承担，header 自身去线（透明保高度，不跳布局） */
  .chat-header--flush {
    border-bottom: 2rpx solid rgba(0, 0, 0, 0);
  }

  /* 子页签行（标题下功能按钮区）整体上移约 1/3：标题行高 108rpx 内标题下方留白 ~31rpx +
     .cst-bar 顶 padding 12rpx ≈ 43rpx 间距，负 margin 收掉 16rpx（组件根节点承接 class） */
  .chat-subpage-tabs {
    margin-top: -16rpx;
  }

  .chat-header__btn {
    width: 72rpx;
    height: 72rpx;
    border-radius: 36rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chat-header__btn--active {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .chat-header__btn--ghost {
    background-color: rgba(0, 0, 0, 0);
  }

  .chat-header__title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .chat-header__title {
    max-width: 420rpx;
    font-size: 33rpx;
    line-height: 46rpx;
    font-weight: 500;
    color: #1f2329;
  }

  /* 消息列滚动区包裹层：仅为「回到底部」浮钮充当 absolute 定位锚（底缘即输入坞顶） */
  .chat-body-wrap {
    flex: 1;
    min-height: 0;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .chat-body {
    flex: 1;
    min-height: 0;
    padding: 36rpx 32rpx 16rpx;
  }

  /* ===== 「回到底部」浮钮：读历史时悬于列表右下（白圆底 + 双下箭头）。
     不设 z-index——底部面板槽(z1)/展开蒙层(z998+)按 DOM 序与层级自然盖住 ===== */
  .chat-jump-latest {
    position: absolute;
    right: 28rpx;
    bottom: 32rpx;
    width: 88rpx;
    height: 88rpx;
    border-radius: 44rpx;
    background-color: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.12);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-jump-latest--active {
    background-color: #f2f3f5;
  }

  .chat-jump-latest__arrows {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .chat-jump-latest__arrow {
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  /* 双箭头叠影：下枚上提与上枚错叠出「快进到底」双箭头观感 */
  .chat-jump-latest__arrow--lower {
    margin-top: -18rpx;
  }

  .chat-foot {
    padding: 12rpx 0 20rpx;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .chat-foot__text {
    font-size: 22rpx;
    line-height: 32rpx;
    color: #b0aebc;
  }

  .chat-state {
    padding: 240rpx 48rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .chat-state__text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #9a98a5;
  }

  /* ===== 消息行：微信式——对方左对齐（头像左 + 名字 + 气泡），我方右对齐 ===== */
  .chat-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 36rpx;
  }

  /* 我方行：DOM 仍为 [头像][气泡列][状态列]，row-reverse 翻转主轴后渲染为
     [状态列][气泡][头像]——头像落右缘（微信同款），状态列贴气泡左下角。 */
  .chat-row--mine {
    flex-direction: row-reverse;
  }

  /* 被 pin 的消息：行本体淡黄底（比定位闪烁 flash 更浅的静态黄）。挂行节点而非
     外层 chat-msg——外层连 margin-bottom 行距空白一起染色会高出内容一截 */
  .chat-row--pinned {
    background-color: #fff6df;
    border-radius: 12rpx;
  }

  .chat-ava-wrap {
    width: 76rpx;
    height: 76rpx;
    flex-shrink: 0;
  }

  /* 真图裁切容器（border-radius + overflow 兜底 SVG 渲染路径，见模板处注释） */
  .chat-ava-clip {
    width: 76rpx;
    height: 76rpx;
    border-radius: 38rpx;
    overflow: hidden;
  }

  .chat-ava {
    width: 76rpx;
    height: 76rpx;
    border-radius: 38rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-ava-letter {
    font-size: 32rpx;
    line-height: 40rpx;
    font-weight: 600;
    color: #ffffff;
  }

  .chat-col {
    flex: 1;
    min-width: 0;
    margin: 0 20rpx;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* 我方列（微信式右贴）：flex: none 去掉基类 flex:1——列宽 hug 内容，row-reverse
     从右往左排，列自然贴住头像，不依赖 align-items 交叉轴对齐（web 模拟器上不可靠，
     气泡曾因此跑左）；margin-left: 3px 是旧结构（状态列挂 chat-row 行内）给已读圈
     让位的补差，状态列移入 chat-bubwrap 后已无实际作用，仅为不动已验证布局而保留。
     align-items: flex-end 保留：时间行/Pin 署名等窄子元素列内右贴 */
  .chat-col--mine {
    flex: none;
    margin-left: 3px;
    align-items: flex-end;
  }

  .chat-name {
    align-self: flex-start;
    max-width: 480rpx;
    margin-bottom: 12rpx;
    font-size: 25rpx;
    line-height: 34rpx;
    color: #9a98a5;
  }

  /* 气泡包裹行（chat-col 内）：[状态列][气泡/图片] 横排。align-items:flex-end 让
     发送态/已读徽标恒贴气泡左下角——气泡下方再垫 Pin 署名行/表情行/时间行也不受
     影响（旧结构状态列挂 chat-row 行内，Pin 署名行撑高行底后已读圈跟着沉到署名行旁） */
  .chat-bubwrap {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
  }

  /* 气泡：普通圆角方形浅灰底（白底页面上我方/对方同款） */
  .chat-bubble {
    /* 宽度跟随内容：不设 align-self——对齐交给列的 align-items（对方 flex-start 左贴
       是本页一直生效的机制）；基类若声明 flex-start 会与 --mine 的 flex-end 冲突，
       uvue 运行时里基类抢赢就把气泡锚到左边（已踩） */
    max-width: 500rpx;
    padding: 24rpx 30rpx;
    background-color: #f2f3f5;
    border-radius: 16rpx;
  }

  /* 我方气泡右贴（微信同款）：与 chat-col--mine 的 flex-end 同向加固，
     全样式表无对立声明，级联顺序无关胜负 */
  .chat-bubble--mine {
    align-self: flex-end;
  }

  .chat-bubble--active {
    background-color: #ecebf1;
  }

  .chat-bubble__text {
    font-size: 30rpx;
    line-height: 46rpx;
    color: #22212a;
  }

  .chat-bubble__text--mine {
    color: #22212a;
  }

  /* 纯链接文本：微信同款链接蓝 */
  .chat-bubble__text--link {
    color: #576b95;
  }

  .chat-bubble__text--link-mine {
    color: #576b95;
  }

  /* ===== 语音消息（msgType=audio，气泡内）：声波条 + 时长 ===== */
  .chat-voice {
    display: flex;
    flex-direction: row;
    align-items: center;
    /* 高度定死：播放中声波条 150ms 一跳（最高 14+6=20px），高度随内容自适应
       会让气泡乃至整页逐帧回流抖动；52rpx 兜住最大条高，条在容器内垂直居中跳 */
    height: 52rpx;
  }

  /* 我方语音镜像（微信同款：声波靠气泡右缘） */
  .chat-voice--mine {
    flex-direction: row-reverse;
  }

  .chat-voice__bar {
    width: 6rpx;
    margin: 0 3rpx;
    border-radius: 3rpx;
    background-color: #22212a;
  }

  /* 播放中：换主题色（高度由 voiceTick 驱动跳动；App 端无 height 过渡，逐帧跳即动画） */
  .chat-voice--playing .chat-voice__bar {
    background-color: #5147ff;
  }

  .chat-voice__dur {
    margin: 0 8rpx;
    font-size: 26rpx;
    line-height: 36rpx;
    color: #22212a;
  }

  /* ===== 互动卡片（msgType=card，气泡内）：标题/正文/字段行 + 动作按钮 ===== */
  .chat-card {
    display: flex;
    flex-direction: column;
  }

  .chat-card__title {
    font-size: 30rpx;
    line-height: 42rpx;
    font-weight: 600;
    color: #22212a;
  }

  /* desc 自足（含申请人附言等关键信息），不截断 */
  .chat-card__desc {
    margin-top: 8rpx;
    font-size: 26rpx;
    line-height: 38rpx;
    color: #6b6875;
  }

  .chat-card__field {
    margin-top: 8rpx;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }

  .chat-card__field-label {
    margin-right: 12rpx;
    flex-shrink: 0;
    font-size: 26rpx;
    line-height: 38rpx;
    color: #94929c;
  }

  .chat-card__field-value {
    flex: 1;
    font-size: 26rpx;
    line-height: 38rpx;
    color: #22212a;
  }

  .chat-card__actions {
    margin-top: 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  /* 按钮配色只随 style 走（primary=主色实底 / danger=红描边 / 其余=default 描边），
     不可点（done/stale/forbidden/unknown/执行中）一律置灰 */
  .chat-card__btn {
    flex: 1;
    height: 68rpx;
    margin-left: 16rpx;
    border-radius: 34rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .chat-card__btn:first-child {
    margin-left: 0;
  }

  .chat-card__btn--default {
    background-color: #ffffff;
    border: 1px solid #d9d7e0;
  }

  .chat-card__btn--primary {
    background-color: #5147ff;
  }

  .chat-card__btn--danger {
    background-color: #ffffff;
    border: 1px solid #e05f5f;
  }

  .chat-card__btn--disabled {
    background-color: #f0eff4;
  }

  /* 按压态用透明度统一处理：不覆盖各配色底色（primary 深底也能正确反馈） */
  .chat-card__btn--active {
    opacity: 0.72;
  }

  .chat-card__btn-text {
    font-size: 26rpx;
    line-height: 36rpx;
    font-weight: 500;
    color: #44424e;
  }

  .chat-card__btn-text--on {
    color: #ffffff;
  }

  .chat-card__btn-text--disabled {
    color: #94929c;
  }

  /* 跳转链接（actionUrl）：展示卡底部「查看详情」蓝字（对齐 PC im-card-link 的 #1664ff） */
  .chat-card__link {
    margin-top: 16rpx;
    font-size: 26rpx;
    line-height: 38rpx;
    font-weight: 500;
    color: #1664ff;
  }

  /* 纯展示卡（无动作区且无跳转链接）：补一句人话，免得用户去点不可点的卡片本身 */
  .chat-card__hint {
    margin-top: 16rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #94929c;
  }

  /* ===== 引用块（气泡内灰底，点击进全屏引用详情） ===== */
  .chat-quote {
    align-self: stretch;
    margin-bottom: 12rpx;
    padding: 14rpx 18rpx;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 10rpx;
    display: flex;
    flex-direction: column;
  }

  .chat-quote--mine {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .chat-quote__name {
    margin-bottom: 4rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    font-weight: 500;
    color: #576b95;
  }

  .chat-quote__name--mine {
    color: #576b95;
  }

  .chat-quote__text {
    font-size: 26rpx;
    line-height: 38rpx;
    color: #6b6976;
  }

  .chat-quote__text--mine {
    color: #6b6976;
  }

  /* ===== 图片消息：不进气泡，300rpx 方形缩略，点击全屏放大 ===== */
  .chat-image {
    width: 300rpx;
    height: 300rpx;
    border-radius: 12rpx;
    background-color: #ecebf1;
  }

  .chat-image--att {
    width: 260rpx;
    height: 260rpx;
    margin-top: 12rpx;
  }

  /* ===== 视频消息：不进气泡，深色圆角占位卡（服务端无封面字段），点击原位换 <video>。
     固定 400×300（4:3）尺寸：占位卡 ↔ 播放器切换不引起 scroll-view 布局跳动；竖版视频 contain 黑边 ===== */
  .chat-video {
    width: 400rpx;
    height: 300rpx;
    border-radius: 12rpx;
    background-color: #1c1b20;
    overflow: hidden;
  }

  /* rich_text 气泡内嵌视频附件：播放器同尺寸，与气泡内文案/图片留间距 */
  .chat-video--in-bubble {
    margin-top: 8rpx;
  }

  .chat-video__player {
    width: 400rpx;
    height: 300rpx;
    background-color: #000000;
  }

  /* 全屏兜底按钮（仅 APP-ANDROID：控制条实测无全屏键）：56rpx 半透明黑圆 + 四角括号
     纯 view 绘制（不依赖字体字形）；全屏态由 v-if 卸载（Android 子节点创建/销毁安全，
     iOS 勿用——#22070 闪退） */
  .chat-video__fs {
    position: absolute;
    top: 12rpx;
    right: 12rpx;
    width: 56rpx;
    height: 56rpx;
    border-radius: 28rpx;
    background-color: rgba(0, 0, 0, 0.45);
  }

  .chat-video__fs-corner {
    position: absolute;
    width: 12rpx;
    height: 12rpx;
    border-color: #ffffff;
    border-style: solid;
  }

  .chat-video__fs-corner--tl {
    top: 16rpx;
    left: 16rpx;
    border-top-width: 3rpx;
    border-left-width: 3rpx;
  }

  .chat-video__fs-corner--tr {
    top: 16rpx;
    right: 16rpx;
    border-top-width: 3rpx;
    border-right-width: 3rpx;
  }

  .chat-video__fs-corner--bl {
    bottom: 16rpx;
    left: 16rpx;
    border-bottom-width: 3rpx;
    border-left-width: 3rpx;
  }

  .chat-video__fs-corner--br {
    bottom: 16rpx;
    right: 16rpx;
    border-bottom-width: 3rpx;
    border-right-width: 3rpx;
  }

  .chat-video__poster {
    width: 400rpx;
    height: 300rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .chat-video__play {
    width: 88rpx;
    height: 88rpx;
    border-radius: 44rpx;
    background-color: rgba(255, 255, 255, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* PNG 内已做光学居中（bbox 中心右移 14/512）；再整体右移 4rpx（≈2px，
     10-04 真机校准追加）——flex 居中布局下 margin 即视觉位移，三端一致 */
  .chat-video__play-icon {
    width: 60rpx;
    height: 60rpx;
    margin-left: 4rpx;
  }

  .chat-video__hint {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.72);
  }

  /* ===== 文件/链接附件卡片：图标 + 文案 + 域名，点击打开链接 ===== */
  .chat-link {
    align-self: stretch;
    margin-top: 12rpx;
    padding: 16rpx 18rpx;
    background-color: #f7f6fb;
    border-radius: 12rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .chat-link__icon-wrap {
    width: 64rpx;
    height: 64rpx;
    border-radius: 12rpx;
    background-color: #ffffff;
    border: 2rpx solid #ecebf1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* md 文档卡片图标：复用文件树 static/filetree/icon_md.svg（白底瓷贴内留边） */
  .chat-link__md-icon {
    width: 40rpx;
    height: 40rpx;
  }

  .chat-link__col {
    flex: 1;
    min-width: 0;
    margin-left: 16rpx;
    display: flex;
    flex-direction: column;
  }

  .chat-link__title {
    font-size: 26rpx;
    line-height: 36rpx;
    color: #22212a;
  }

  .chat-link__host {
    margin-top: 4rpx;
    font-size: 22rpx;
    line-height: 30rpx;
    color: #9a98a5;
  }

  /* 定位到消息：背景快速切换高亮（外层整行铺底，不改变布局） */
  .chat-msg--flash {
    background-color: rgba(255, 213, 79, 0.45);
    border-radius: 12rpx;
  }

  /* 进页定位遮蔽：布局保留（scroll-into-view 需要真实高度），仅视觉隐藏 */
  .chat-msg--veiled {
    opacity: 0;
  }

  /* Pin 署名行：pin icon + 操作人署名（飞书式左对齐，随气泡列）；
     下边距补差——本行在气泡外裸排，行距仅剩 chat-row 的 36rpx（普通消息是
     气泡内边距 24rpx + 36rpx），不补会视觉贴住下一条消息 */
  .chat-pininfo {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 6rpx;
    margin-bottom: 12rpx;
    padding: 0 8rpx;
  }

  .chat-pininfo__icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 8rpx;
  }

  /* 点消息内容展开的时间行（微信同款）：小号灰字，随列对齐（我方右、对方左） */
  .chat-msgtime {
    margin-top: 8rpx;
    padding: 0 8rpx;
    font-size: 22rpx;
    line-height: 30rpx;
    color: #9a98a5;
  }

  /* ===== 飞书式时间分割线：居中灰字无底色（不带秒；精确到秒点消息体查看，两套并存） ===== */
  .chat-time-divider {
    margin: 16rpx 0 20rpx;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .chat-time-divider__text {
    font-size: 22rpx;
    line-height: 32rpx;
    color: #a5a3b0;
    text-align: center;
  }

  .chat-pininfo__text {
    font-size: 22rpx;
    line-height: 30rpx;
    color: #b08a2e;
  }

  /* ===== 表情回复行（气泡内容区末行/图片下方：emoji + 竖分割线 + 用户名；组间留间距） ===== */
  .chat-reactions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6rpx;
  }

  .chat-reaction {
    display: flex;
    flex-direction: row;
    align-items: center;
    max-width: 100%;
    min-height: 48rpx;
    padding: 4rpx 16rpx;
    margin-right: 12rpx;
    margin-top: 4rpx;
    border-radius: 24rpx;
    background-color: #ffffff;
    border-width: 2rpx;
    border-style: solid;
    border-color: rgba(0, 0, 0, 0);
  }

  .chat-reaction--mine {
    border-color: #5147ff;
  }

  .chat-reaction--hover {
    background-color: #eceaf6;
  }

  .chat-reaction__face {
    font-size: 28rpx;
    line-height: 36rpx;
    flex-shrink: 0;
  }

  /* 垂直分割线（emoji 与用户名之间） */
  .chat-reaction__divider {
    width: 2rpx;
    height: 24rpx;
    margin-left: 12rpx;
    margin-right: 12rpx;
    background-color: #d9d8e3;
    flex-shrink: 0;
  }

  .chat-reaction__names {
    max-width: 300rpx;
    font-size: 22rpx;
    line-height: 30rpx;
    color: #6b6978;
  }

  /* 我加过的组：主题色署名（类直绑在 text 上，不用后代选择器——App 端选择器支持有限） */
  .chat-reaction__names--mine {
    color: #5147ff;
  }

  /* ===== 合并转发卡片（气泡内摘要卡：标题 + 前 2 条预览 + 共 N 条） ===== */
  .chat-merge {
    display: flex;
    flex-direction: column;
    width: 440rpx;
  }

  .chat-merge__title {
    font-size: 28rpx;
    line-height: 40rpx;
    font-weight: bold;
    color: #1c1b20;
  }

  .chat-merge__item {
    display: flex;
    flex-direction: column;
    margin-top: 12rpx;
  }

  .chat-merge__name {
    font-size: 22rpx;
    line-height: 30rpx;
    color: #6b6978;
  }

  .chat-merge__text {
    margin-top: 2rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #33323d;
  }

  .chat-merge__count {
    margin-top: 14rpx;
    padding-top: 12rpx;
    border-top-width: 2rpx;
    border-top-style: solid;
    border-top-color: rgba(81, 71, 255, 0.15);
    font-size: 22rpx;
    line-height: 30rpx;
    color: #5147ff;
  }

  /* ===== 多选态勾选框（头像位替换）：实心=选中，空心=可选，灰=不可转发。
     纵向对齐消息首行的下移量加在 wrap 上（圈贴 wrap 顶不越界）：首行中心 47rpx
     （气泡 padding 24 + 行高 46/2）− 半圈 22 = wrap 下移 25rpx，圈心与首行文字
     中线齐平；群聊对方行昵称（46rpx）压低气泡，named 再 +46 = 71rpx ===== */
  .chat-ava-wrap--check {
    margin-top: 25rpx;
  }

  .chat-ava-wrap--check-named {
    margin-top: 71rpx;
  }

  .chat-check {
    width: 44rpx;
    height: 44rpx;
    border-radius: 22rpx;
    border-width: 3rpx;
    border-style: solid;
    border-color: #c9c7d6;
    background-color: rgba(0, 0, 0, 0);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-check--on {
    border-color: #5147ff;
    background-color: #5147ff;
  }

  .chat-check--ban {
    border-color: #e3e2ec;
    background-color: #f6f5fb;
  }

  /* ===== 多选态底部工具条（替换输入坞）：取消 / 逐条转发 / 合并转发 ===== */
  .chat-multibar {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 16rpx 24rpx 6rpx;
    background-color: #ffffff;
    border-top-width: 2rpx;
    border-top-style: solid;
    border-top-color: #e5e6eb;
  }

  .chat-multibar__btn {
    flex: 1;
    height: 80rpx;
    margin: 0 12rpx;
    border-radius: 40rpx;
    background-color: #5147ff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-multibar__btn--ghost {
    background-color: #f0eff7;
  }

  .chat-multibar__btn--disabled {
    opacity: 0.4;
  }

  .chat-multibar__btn--active {
    opacity: 0.8;
  }

  .chat-multibar__btn-text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #ffffff;
  }

  .chat-multibar__btn-text--ghost {
    color: #4a4860;
  }

  /* 状态列（微信式：我方气泡左侧下缘，仅我发的消息渲染）：发送态 / 已读徽标。
     chat-bubwrap 首个子节点（常规 row，DOM 在前即渲染在气泡左侧），margin-right
     即与气泡的间距；align-self:flex-end 沉到包裹行底（=气泡底），不再随气泡下方
     的 Pin 署名行/表情行/时间行下移。 */
  .chat-tail {
    align-self: flex-end;
    flex-shrink: 0;
    margin: 0 16rpx 8rpx 0;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .chat-status {
    font-size: 22rpx;
    line-height: 30rpx;
    color: #9a98a5;
  }

  .chat-edited-inline {
    margin-left: 10rpx;
    font-size: 22rpx;
    line-height: 30rpx;
    color: #9a98a5;
  }

  .chat-status--fail {
    color: #ff4d4f;
  }

  /* 已读徽标（我发的）：绿圈白勾 + 计数文本；单聊未读=灰空心圈（无文本无勾） */
  .chat-read {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4rpx 0;
  }

  .chat-read--active {
    opacity: 0.7;
  }

  /* 已读绿圈：绿色描边空心圆（无底色），圈内绘绿勾（已读）/ 扇形饼图（群部分已读）。
     尺寸一律整数 px：rpx 在 iPhone 上换算成非整数 pt（28rpx≈14.56pt），圆弧经像素取整
     后边缘被裁掉一截（贴气泡右侧时尤明显）；整数 px 落在整数网格上弧线完整（同 rs-ava 修法） */
  .chat-read__ring {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 2px solid #3fae94;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* 单聊未读：灰空心圈（圈内无内容） */
  .chat-read__ring--pending {
    border-color: #c3c1cd;
  }

  /* 绿勾（圈内居中）：双边框旋转法（App 端无伪元素/字体图标依赖）。
     沿用 rpx 版的 L 形质心推算结论（盒中心取内径的 (50%,39%)）：勾盒 4×6
     （border-box，右边+底边各 2），内径 10 的 padding box 里盒中心放 (5,4)
     （left 3 / top 1），视觉重心落在圆心 (5,5) 附近。
     （负 margin 在 App 原生端不可靠，不用 margin 微调） */
  .chat-read__tick {
    position: absolute;
    top: 1px;
    left: 3px;
    width: 4px;
    height: 6px;
    border-right: 2px solid #3fae94;
    border-bottom: 2px solid #3fae94;
    transform: rotate(45deg);
  }

  /* 扇形饼图（群部分已读，扇形面积=已读占比）：双半圆法——半遮罩 overflow hidden
     + 绕圆心旋转的半圆盘填充（App 端无 conic-gradient）；--r 盖右半（0~180°顺时针），--l 续左半 */
  .chat-read__pie {
    position: absolute;
    top: 0;
    width: 5px;
    height: 10px;
    overflow: hidden;
  }

  .chat-read__pie--r {
    right: 0;
  }

  .chat-read__pie--l {
    left: 0;
  }

  .chat-read__fill {
    position: absolute;
    top: 0;
    width: 5px;
    height: 10px;
    background-color: #3fae94;
  }

  /* 右遮罩内填充=左半圆盘（弧朝左）：初始藏于左半平面，绕圆心顺时针转出 wrap 进右半，
     形成 [0..θ] 扇形；transform-origin=盘右缘中点即圆心 */
  .chat-read__fill--r {
    left: -5px;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    transform-origin: 100% 50%;
  }

  /* 左遮罩内填充=右半圆盘（弧朝右）：初始藏于右半平面，绕圆心顺时针转出补左半
     [180..θ]；transform-origin=盘左缘中点即圆心 */
  .chat-read__fill--l {
    left: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    transform-origin: 0% 50%;
  }

  /* ===== 智能体处理标记（我发的 + 衔接智能体；对齐 PC DEV-275 四态，色板同 PC）：
     未读灰 #c3c1cd / 处理中青 #0fa893 / 完成蓝 #3370ff（DEV-308：蓝=完成，绿=已读回执）/
     失败红 #f54a45→用本页 fail 红 #ff4d4f。几何与 chat-read 系同口径（14px 整数 px 圆）。 ===== */
  .chat-agent {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4rpx 0;
  }

  /* 圈底：默认灰空心=未读（刚发出，仅历史拉取可见——后端建行不推帧）；圈内可居中放内容 */
  .chat-agent__ring {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 2px solid #c3c1cd;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* 完成：蓝圈（圈内蓝勾见 __tick） */
  .chat-agent__ring--done {
    border-color: #3370ff;
  }

  /* 失败：红圈（圈内红叹号见 __bang） */
  .chat-agent__ring--fail {
    border-color: #ff4d4f;
  }

  /* 完成蓝勾：几何与 chat-read__tick 完全同款（双边框旋转法），仅配色蓝 */
  .chat-agent__tick {
    position: absolute;
    top: 1px;
    left: 3px;
    width: 4px;
    height: 6px;
    border-right: 2px solid #3370ff;
    border-bottom: 2px solid #3370ff;
    transform: rotate(45deg);
  }

  /* 失败叹号（PC 端 failReason 走 title，移动端图标语义即可） */
  .chat-agent__bang {
    font-size: 20rpx;
    line-height: 20rpx;
    font-weight: bold;
    color: #ff4d4f;
  }

  /* 处理中钟面：青圈 + 两根指针（子元素随父级 transform 一起旋转）。
     App 端 CSS animation 不可靠——旋转由 inline style 注入的 transform+transition-duration
     与此处 transition-property/timing-function 共同完成（spin-loading 同款自转） */
  .chat-agent__clock {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 2px solid #0fa893;
    box-sizing: border-box;
    flex-shrink: 0;
    transition-property: transform;
    transition-timing-function: linear;
    transform: rotate(0deg);
  }

  /* 指针：从圆心 (5,5) 指向 12 点 / 3 点的两根短针（padding box 10×10 内） */
  .chat-agent__hand {
    position: absolute;
    background-color: #0fa893;
  }

  .chat-agent__hand--v {
    left: 4px;
    top: 1px;
    width: 2px;
    height: 4px;
  }

  .chat-agent__hand--h {
    left: 5px;
    top: 4px;
    width: 4px;
    height: 2px;
  }

  /* ===== 撤回 / 系统提示行 ===== */
  .chat-sys {
    margin-bottom: 28rpx;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .chat-sys__text {
    max-width: 560rpx;
    font-size: 22rpx;
    line-height: 32rpx;
    color: #a5a3b0;
    text-align: center;
  }

  .chat-bottom-anchor {
    height: 4rpx;
  }

  /* ===== 引用 / 编辑条 + 输入坞 ===== */
  .chat-compose-bar {
    flex-shrink: 0;
    margin: 0 24rpx 8rpx;
    padding: 14rpx 20rpx;
    border-radius: 16rpx;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .chat-compose-bar__accent {
    width: 6rpx;
    height: 44rpx;
    border-radius: 3rpx;
    background-color: #5147ff;
    flex-shrink: 0;
  }

  /* 编辑条竖条换暖色，与引用态视觉区分 */
  .chat-compose-bar__accent--edit {
    background-color: #e0942e;
  }

  .chat-compose-bar__main {
    flex: 1;
    min-width: 0;
    margin-left: 16rpx;
    display: flex;
    flex-direction: column;
  }

  .chat-compose-bar__label {
    font-size: 22rpx;
    line-height: 30rpx;
    color: #6f6d7b;
    font-weight: 500;
  }

  .chat-compose-bar__text {
    margin-top: 2rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #4b4b52;
  }

  .chat-compose-bar__close {
    width: 56rpx;
    height: 56rpx;
    margin-left: 8rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chat-compose-bar__close--active {
    opacity: 0.6;
  }

  .chat-dock-wrap {
    flex-shrink: 0;
    background-color: #f2f3f5;
    padding: 0;
    /* 让位由 .chat-main 刚体平移承担；底距仅随升起态收安全区（6↔6+safeBottom 约 34px），
       与平移同曲线过渡（同曲线同拍，旧 padding 让位机制已废，此处只是小段安全区收放） */
    transition-property: padding-bottom;
    transition-duration: 250ms;
    transition-timing-function: cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  /* 输入坞（两行）：第一行输入 + 发送/展开，第二行工具条；浅灰底 + 白 pill 输入框，
     底部安全区由 dock-wrap 内联样式垫 */
  .chat-dock {
    display: flex;
    flex-direction: column;
    padding: 4rpx 16rpx 4rpx;
    background-color: #f2f3f5;
  }

  /* iOS 输入框整体略矮一些，并增加框上方留白。 */
  /* #ifdef APP-IOS */
  .chat-dock {
    padding-top: 12rpx;
  }
  /* #endif */

  /* Android/鸿蒙 对齐 iOS：框上方留白同 12rpx（基线 4rpx 观感过挤）。 */
  /* #ifdef APP-ANDROID || APP-HARMONY */
  .chat-dock {
    padding-top: 12rpx;
  }
  /* #endif */

  .chat-dock__main {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
  }

  .chat-round {
    width: 68rpx;
    height: 68rpx;
    border-radius: 34rpx;
    background-color: #f2f3f5;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chat-round--active {
    background-color: #e9eaef;
  }

  .chat-dock__voice {
    flex: 1;
    min-width: 0;
    margin: 0 12rpx 0 0;
  }

  /* 语音模式左侧键盘键：白底按钮，与按住说话条等高（90rpx）留间距，点击回输入框 */
  .chat-dock__kb {
    width: 90rpx;
    height: 90rpx;
    margin-right: 16rpx;
    border-radius: 45rpx;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chat-dock__kb--active {
    background-color: #e9eaef;
  }

  /* 输入 pill：白底圆角容器（浅灰坞上），textarea 撑满、展开键贴框内右侧
     （高度参考飞书消息对话框：文字 32rpx + 行高 48rpx + 上下各 20rpx padding ≈ 88rpx） */
  .chat-input-box {
    flex: 1;
    min-height: 56rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: #ffffff;
    border-radius: 16rpx;
    padding: 0 10rpx 0 0;
    /* #ifdef APP-ANDROID || APP-HARMONY */
    /* Android/鸿蒙 根因（disable-default-padding 仅 iOS 生效）：
       CSS min-height 对原生 EditText 无效（EditText 强制 MinHeight=48dp ≈ 96rpx，
       在 720p 上 ≈ 64px 物理 = 视觉 130rpx），故外层 box 必须自己固定单行高度。
       88rpx = 一行飞书视觉标准高度，足以让 EditText 自带的系统 padding 把
       placeholder 与文字完整渲染（pill 不会被原生 EditText 撑变形）。
       鸿蒙同病（2026-09-29 真机：无固定高时 pill 下半被工具行遮挡），一并固定 */
    height: 88rpx;
    min-height: 88rpx;
    /* #endif */
    /* #ifdef APP-IOS */
    /* iOS pill 88rpx：align-items:center
       + line-height 50rpx + 上下对称 padding 让光标/placeholder 视觉居中。
       ★只设 min-height 不设 height：iOS textarea 走 auto-height 原生自撑，
       且 chatInputBoxHeightStyle 在 iOS 恒为空串（无内联覆盖），固定 height
       会把多行增长裁掉（2026-10-01 真机：输入框高度不随内容变化） */
    min-height: 88rpx;
    padding-top: 0;
    /* #endif */
  }

  .chat-input-box--reply {
    height: auto;
    min-height: 144rpx;
    flex-direction: column;
    align-items: stretch;
    padding: 8rpx 10rpx 8rpx 8rpx;
  }

  /* 已解散灰条：占住输入 pill 位置，居中灰字（高度沿用 88rpx 单行 pill 标准） */
  .chat-input-box--disbanded {
    justify-content: center;
  }

  .chat-input-box__disbanded-text {
    font-size: 28rpx;
    color: #8a8a8a;
  }

  /* 引用条：灰底整行，X（小）+ 竖分割线 + 「回复xx：消息」单行截断（飞书式） */
  .chat-reply-preview {
    height: 60rpx;
    padding: 0 14rpx 0 2rpx;
    border-radius: 8rpx;
    background-color: #f2f3f5;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
  }

  /* 语音模式引用条：钉在按住说话行上方整行（其余样式沿用基础引用条） */
  .chat-reply-preview--voice {
    margin-bottom: 12rpx;
  }

  .chat-reply-preview__close {
    width: 48rpx;
    height: 48rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chat-reply-preview__divider {
    width: 2rpx;
    height: 28rpx;
    border-radius: 1rpx;
    background-color: #dcdee5;
    margin-left: 8rpx;
    margin-right: 14rpx;
    flex-shrink: 0;
  }

  .chat-reply-preview__text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #6f6d7b;
  }

  /* 待发图片暂存条：横向滚动缩略图行（微信同款），钉在输入坞首行。
     横滑结构对齐 shared-home-tools / chat-upload-image 已验证配方：wrapper 行布局 +
     scroll flex:1 + min-width:0（不用 width:100%），滚动余量由 measureStagedRow
     实测总宽写回行内联样式制造（App 原生端 flex 行会被压成视口宽） */
  .chat-staged {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 12rpx;
    flex-shrink: 0;
  }

  .chat-staged__scroll {
    flex: 1;
    min-width: 0;
  }

  .chat-staged__row {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    padding: 10rpx 4rpx 4rpx 4rpx;
  }

  .chat-staged__item {
    position: relative;
    width: 140rpx;
    height: 140rpx;
    margin-right: 16rpx;
    flex-shrink: 0;
  }

  .chat-staged__thumb {
    width: 140rpx;
    height: 140rpx;
    border-radius: 8rpx;
    background-color: #f2f3f5;
  }

  .chat-staged__remove {
    position: absolute;
    /* 外挂量 4rpx：保留压角样式，但须完整落在行盒内——行 padding-top 仅 10rpx，
       App 端 scroll-view 按自身 frame 裁切，外挂 12rpx 时角标顶部超 frame 2rpx
       被削（右上角截断的根因）；右向 4rpx 落在 16rpx 间距内，末张也在实测行宽内 */
    top: -4rpx;
    right: -4rpx;
    width: 40rpx;
    height: 40rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-staged__remove--active {
    opacity: 0.6;
  }

  .chat-staged__remove-icon {
    width: 36rpx;
    height: 36rpx;
  }

  .chat-input-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .chat-input {
    flex: 1;
    min-height: 56rpx;
    max-height: 220rpx;
    /* 左内边距 28rpx = 原 24rpx + 2px（375 宽基准）：文字/placeholder 起始右移微调 */
    padding: 10rpx 8rpx 10rpx 28rpx;
    font-size: 32rpx;
    line-height: 50rpx;
    color: #17171a;
    /* #ifdef APP-ANDROID || APP-HARMONY */
    /* 配合 chat-input-box 的 88rpx 固定高：CSS min-height 对 EditText 无效，
       故去掉（避免误导）；padding-top/bottom 留 4rpx 给原生系统让 placeholder
       完整渲染（之前去成 0 后 placeholder 被原生 padding 顶到 pill 外被裁） */
    padding-top: 4rpx;
    padding-bottom: 4rpx;
    /* auto-height 关闭后须显式定高（88rpx pill − 上下 padding 8rpx − 余量），
       否则 EditText wrap-content 高度不受控、内容照样可能画到裁剪区外 */
    height: 72rpx;
    /* 单行内容的垂直居中不在 CSS 里做：多行 EditText 原生 gravity 默认 top，
       Android 由 centerAndroidInputGravity() 在 onReady/聚焦时设 CENTER_VERTICAL
       （多行超出时仍按框内滚动形态，不受影响）；鸿蒙走下方 APP-HARMONY 块的
       padding 补偿 */
    /* #endif */
    /* #ifdef APP-HARMONY */
    /* 鸿蒙单行文字/placeholder 贴 72rpx 盒顶（2026-09-29 真机）：鸿蒙无
       getAndroidView 类原生 API（本机 HX 与离线 SDK 均核实无），垂直位置只能
       CSS 补——顶 padding 把单行行盒推到盒中心：(72 − 行高 50) / 2 ≈ 11 → 12rpx。
       多行时仍是 72rpx 盒内滚动，顶 padding 仅占少量滚动视口，可接受 */
    padding-top: 12rpx;
    /* #endif */
    /* #ifdef APP-IOS */
    /* iOS 垂直居中：auto-height 下让 textarea 收缩成单行行盒——纵向 padding 归零、
       min-height 从 56 降到一行 40（去掉地板让盒子贴内容），行高压到贴近字体自然行
       （50rpx 会被原生按首行上方加 leading 处理：光标整体下沉，placeholder 又按
       自然行高画，一低一高错位）；盒子贴行后由 chat-input-content 的
       align-items:center 在 88rpx pill 内整体居中。
       ★placeholder-style 的 line-height 在 App 端不生效，勿用它修垂直位置。
       ★40rpx 仅单行态：多行时 chatInputHeightStyle 内联覆盖为 50rpx
       （多行无 placeholder，居中 hack 不再需要），行距与 Android 一致 */
    padding-top: 0;
    padding-bottom: 0;
    min-height: 40rpx;
    line-height: 40rpx;
    /* #endif */
  }

  .chat-input__expand {
    width: 56rpx;
    height: 56rpx;
    border-radius: 28rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chat-input__expand--active {
    background-color: #e9eaef;
  }

  /* 多行：展开键钉在输入框右上角（第一行右侧）；单行保持行垂直居中
     （content 行 align-items:center，子项 align-self 覆盖为顶对齐） */
  .chat-input__expand--top {
    align-self: flex-start;
  }

  /* 展开键内对角双箭头 ⤢（飞书输入框右上角同款）：PNG 图标（SVG 光栅化生成，
     45° 主轴 + 两端人字箭头、圆头端点）。垂直居中由 chat-input-content 的
     align-items:center 承担（对称方形图标无需光学补偿，去掉旧字形的 margin-bottom） */
  .chat-expand-glyph {
    width: 44rpx;
    height: 44rpx;
  }

  /* 收起键内交错双箭头（面板右上角）：两枚 180° 旋转对称的对角箭头（L 臂 + 斜杆），
     同为 SVG 光栅化 PNG，#8a8b8f 圆头端点（= tab 未激活色 rgba(21,23,31,.5) 合成白底） */
  .chat-collapse-glyph {
    width: 44rpx;
    height: 44rpx;
  }

  /* ===== 展开输入面板（⤢ 从底部拉起）：贴底白面板（无边框）+ 大输入区 + 底部工具行 ===== */
  .chat-expand-sheet {
    position: fixed;
    left: 0;
    right: 0;
    top: 15%;
    bottom: 0;
    z-index: 999;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    /* 键盘让位过渡（同输入坞）：padding-bottom 内联绑定随键盘高度变化 */
    transition-property: padding-bottom;
    transition-duration: 250ms;
    transition-timing-function: ease-in-out;
  }

  /* 非拖拽期：位移变化带过渡（松手弹回）；拖拽期无 transform 过渡保跟手即时 */
  .chat-expand-sheet--snap {
    transition-property: padding-bottom, transform;
  }

  /* 面板背面半透明蒙层（消息区之上、面板之下）：点蒙层收起面板 */
  .chat-expand-mask {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 998;
    background-color: rgba(0, 0, 0, 0.35);
  }

  .chat-expand-sheet__head {
    flex-shrink: 0;
    height: 84rpx;
    /* 收起键右边距与上边距对称：按钮盒 72rpx 居中于 84rpx 头部 → 上边距 6rpx，
       右边距同为 6rpx（图标在按钮盒内居中，视觉边距随之同步对称） */
    padding: 0 6rpx 0 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
  }

  .chat-expand-sheet__collapse {
    width: 72rpx;
    height: 72rpx;
    border-radius: 36rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-expand-sheet__collapse--active {
    background-color: #f3f1fb;
  }

  .chat-expand-sheet__body {
    flex: 1;
    min-height: 0;
    padding: 0 32rpx 12rpx;
    display: flex;
    flex-direction: column;
  }

  .chat-expand-sheet__input {
    flex: 1;
    padding: 8rpx 0;
    font-size: 32rpx;
    line-height: 52rpx;
    color: #17171a;
    /* #ifdef APP-IOS */
    /* 大输入区同 .chat-input 的 iOS 结论：52rpx 行高会被原生按首行上方加 leading，
       光标/正文下沉而 placeholder 按自然行高画——一低一高错位；压到贴近字体自然行
       （40rpx）后光标与 placeholder 重合，多行行距也与主坞输入框一致。
       ★placeholder-style 的 line-height 在 App 端不生效，勿用它修垂直位置 */
    line-height: 40rpx;
    /* #endif */
  }

  /* 内嵌面板（与键盘互斥，位于工具行下方）：表情网格（键样式复用主坞表情面板）；
       面板成为最底元素，H5 安全区由这里承接 */
  .chat-expand-sheet__panel {
    flex-shrink: 0;
    padding: 0 24rpx;
    /* #ifdef H5 */
    padding-bottom: env(safe-area-inset-bottom, 0px);
    /* #endif */
  }

  /* Aa 格式行不再有专属样式：整行复用主坞 .chat-fontbar（--sheet 微调外距/占满），
     底部安全区由 __bar 承接——格式行在 bar 内，bar 仍是面板最底元素 */

  /* 底部工具行：灰底（对齐主坞第二行观感）+ 工具键组（复用主坞 chat-tool 键）+ 发送键等分槽 */
  .chat-expand-sheet__bar {
    flex-shrink: 0;
    padding: 10rpx 20rpx;
    background-color: #f2f3f5;
    display: flex;
    flex-direction: row;
    align-items: center;
    /* #ifdef H5 */
    padding-bottom: calc(10rpx + env(safe-area-inset-bottom, 0px));
    /* #endif */
  }

  /* 面板展开时面板在下方承接安全区，工具行收回 H5 加高（避免双重安全区） */
  .chat-expand-sheet--paneled .chat-expand-sheet__bar {
    /* #ifdef H5 */
    padding-bottom: 10rpx;
    /* #endif */
  }

  /* 展开面板底部工具行：五枚工具键（.chat-tool flex:1）+ 发送键（.chat-tools__sendslot
     flex:1）六槽等分全行，观感与主坞第二行一致 */
  .chat-expand-sheet__tools {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  /* Aa 格式模式：bar 左右内边距收到 16rpx（同主坞 dock 内边距），内衬 chat-fontbar
     白底横条与主坞几何逐 rpx 一致（横条同宽、键距同隙） */
  .chat-expand-sheet__bar--font {
    padding-left: 16rpx;
    padding-right: 16rpx;
  }

  /* 主坞发送键（第二行右端加号右侧 / 格式横条右端）：与展开面板右端纸飞机发送
     同款——72rpx 圆、无内容灰底灰图标 / 有内容蓝底白图标（canSend 驱动） */
  .chat-dock-send {
    margin-left: 8rpx;
    width: 72rpx;
    height: 72rpx;
    border-radius: 36rpx;
    background-color: #e6e5ee;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chat-dock-send--ready {
    background-color: #337eff;
  }

  .chat-dock-send--active {
    opacity: 0.85;
  }

  /* 纸飞机字形光学补偿：iconfont 字形墨迹在 em-box 内偏左（PNG 分析曾误判方向，
     -4rpx 真机实锤更偏左），右移 3rpx 让视觉重心回圆心；主坞发送键与展开面板
     发送键共用。若仍有偏差，微调此唯一常量即可 */
  .chat-send-glyphfix {
    transform: translateX(3rpx);
  }

  /* 第二行工具条：功能键 + 发送键等分一行（flex:1 槽位），图标中心间距均匀、
     整行均匀分布；pill 与工具行间距 25rpx、行高 65rpx 沿用 */
  .chat-tools {
    margin-top: 25rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .chat-tool {
    flex: 1;
    height: 65rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 20rpx;
  }

  /* 发送键等分槽：槽位与功能键同宽（flex:1），72rpx 圆钮槽内居中，
     保证七个键中心间距完全均匀 */
  .chat-tools__sendslot {
    flex: 1;
    height: 72rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* 槽内圆钮去掉字体条场景的左间距（等分布局由槽位承担） */
  .chat-tools__sendslot .chat-dock-send {
    margin-left: 0;
  }

  /* 格式横条内发送键：space-between 等分已承担间距，去主坞第二行的左间距 */
  .chat-fontbar .chat-dock-send {
    margin-left: 0;
  }

  .chat-tool--active {
    background-color: #f3f1fb;
  }

  .chat-tool--on {
    background-color: rgba(81, 71, 255, 0.12);
  }

  /* 表情键 PNG 图标（icon-face App 端字形损坏走图片降级，双色 PNG 切 src
     代替 tint-color；尺寸对齐同行 48rpx 图标键，容器 flex 居中） */
  .chat-tool__face {
    width: 48rpx;
    height: 48rpx;
  }

  .chat-tool__text {
    /* @ 字符光学对齐 48rpx 图标键（图标墨迹 ≈0.87em≈42rpx；@ 墨迹 ≈0.79em，
       50rpx 墨迹高 ≈39rpx 低于图标一档）。字重 400：500 时 @ 线条偏粗
       （2026-10-01 字号 54→50、字重 500→400 调细，Aa 同步受益） */
    font-size: 50rpx;
    line-height: 60rpx;
    font-weight: 400;
    color: #7a7887;
  }

  .chat-tool__text--aa {
    /* Aa 大写 A 墨迹 ≈0.71em，按原 @:Aa=4:3 比例同步放大（40→54 则 30→40），
       刻意小于图标保持飞书式层级（文字格式键视觉轻于功能键） */
    font-size: 40rpx;
  }

  .chat-tool__text--on {
    /* 按压/激活蓝对齐加号键 --on（#337eff） */
    color: #337eff;
  }

  /* 加号键：圆环 + 加号自绘 icon（点击无背景；开面板时圆环/加号变蓝，
     加号整体旋 45° 成 X，再点收起面板）——尺寸 48rpx 与同行 svg 图标统一，
     基色 #7a7887 同行统一（按下载目录参考图 20260924-163047，2026-10-01 调浅） */
  .chat-plus-key {
    width: 48rpx;
    height: 48rpx;
    border-radius: 24rpx;
    border: 3rpx solid #7a7887;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-plus-key--on {
    border-color: #337eff;
  }

  .chat-plus-key__glyph {
    position: relative;
    width: 22rpx;
    height: 22rpx;
    /* 基态显式 rotate(0)：类移除时 iOS 原生层需要「回落值」才解除旋转，
       仅靠删 --on 的 transform 会卡在 45°（2026-10-01 真机：圈中叉不还原） */
    transform: rotate(0deg);
    transition-property: transform;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out;
  }

  .chat-plus-key__glyph--on {
    transform: rotate(45deg);
  }

  .chat-plus-key__h {
    position: absolute;
    left: 0;
    top: 9rpx;
    width: 22rpx;
    height: 4rpx;
    border-radius: 2rpx;
    background-color: #7a7887;
  }

  .chat-plus-key__h--on {
    background-color: #337eff;
  }

  .chat-plus-key__v {
    position: absolute;
    top: 0;
    left: 9rpx;
    width: 4rpx;
    height: 22rpx;
    border-radius: 2rpx;
    background-color: #7a7887;
  }

  .chat-plus-key__v--on {
    background-color: #337eff;
  }

  .chat-round--on {
    background-color: rgba(81, 71, 255, 0.12);
  }

  /* ===== 按住说话全屏蒙层（liveAsr 三阶段，布局对齐设计稿）=====
     贴 .chat-page 全屏 absolute（fixed 在 App-Android 定位不稳的仓库教训）；
     常驻 DOM opacity 切换；recording 态 pointer-events:none 不拦截触摸（按住手势
     落在其下的录音按钮上），processing/editing 态切 auto 拦截底层交互 */
  .chat-voice-mask {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 998;
    pointer-events: none;
    opacity: 0;
    background-color: rgba(17, 24, 39, 0.62);
    transition: opacity 0.16s ease;
  }

  .chat-voice-mask--on {
    opacity: 1;
  }

  /* 上滑取消（按住中）：蒙层微偏红提示 */
  .chat-voice-mask--cancel {
    background-color: rgba(96, 26, 26, 0.66);
  }

  /* 松手后（识别中/编辑中）加深背景，突出编辑卡 */
  .chat-voice-mask--interactive {
    pointer-events: auto;
    background-color: rgba(17, 24, 39, 0.85);
  }

  /* 按住中/识别中阶段容器：顶部气泡 + 波形（整体下移至页面中间偏上） */
  .chat-voice-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 36%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .chat-voice-bubble {
    max-width: 76%;
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 24rpx;
    padding: 20rpx 30rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-voice-bubble--cancel {
    background-color: rgba(255, 214, 214, 0.96);
  }

  .chat-voice-bubble__text {
    font-size: 28rpx;
    line-height: 42rpx;
    color: #1f2937;
    text-align: center;
  }

  /* 气泡下小尾巴（旋转 45° 小方块，App 不支持伪元素） */
  .chat-voice-bubble__tail {
    width: 20rpx;
    height: 20rpx;
    background-color: rgba(255, 255, 255, 0.94);
    transform: rotate(45deg);
    margin-top: -10rpx;
  }

  .chat-voice-wave {
    position: relative;
    width: 100%;
    height: 56px;
    margin-top: 56rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-voice-baseline {
    position: absolute;
    left: 12%;
    right: 12%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.45);
  }

  .chat-voice-bars {
    width: 76%;
    height: 56px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-voice-bar {
    width: 4rpx;
    margin-left: 3rpx;
    margin-right: 3rpx;
    border-radius: 4rpx;
    background-color: #ffffff;
    /* #ifndef APP */
    transition: height 0.12s ease;
    /* #endif */
  }

  /* 识别完成：整页容器——上半区编辑主体（垂直居中），✓ 大圆钮沉底居中 */
  .chat-voice-edit {
    position: absolute;
    left: 48rpx;
    right: 48rpx;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  /* 编辑主体（卡片+提示行+按钮排）：在 ✓ 上方剩余空间内整体垂直居中；
     padding-top 60rpx=居中组净下移 30rpx（视觉配平 ✓ 钮上提后的重心） */
  .chat-voice-edit__main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 60rpx;
  }

  .chat-voice-card {
    background-color: rgba(255, 255, 255, 0.14);
    border-radius: 24rpx;
    padding: 24rpx 28rpx;
  }

  .chat-voice-card__input {
    width: 100%;
    height: 220rpx;
    font-size: 30rpx;
    line-height: 48rpx;
    color: #ffffff;
    background-color: transparent;
  }

  /* 编辑框下提示行（原 placeholder 文案移到这里） */
  .chat-voice-card__hint {
    font-size: 24rpx;
    line-height: 36rpx;
    color: rgba(255, 255, 255, 0.55);
    text-align: center;
    margin-top: 20rpx;
  }

  /* 取消 ↩ / 仅发语音 🎤 一排居中，间距加大（相对卡片再下沉） */
  .chat-voice-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 128rpx;
  }

  .chat-voice-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-left: 72rpx;
    margin-right: 72rpx;
  }

  .chat-voice-action--active {
    opacity: 0.6;
  }

  .chat-voice-action__text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #ffffff;
    margin-top: 8rpx;
  }

  /* ✓ 确认大圆钮：蒙层下方，水平居中（略上提避开底边） */
  .chat-voice-confirm {
    align-self: center;
    margin-bottom: 200rpx;
    width: 108rpx;
    height: 108rpx;
    border-radius: 54rpx;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-voice-confirm--active {
    opacity: 0.85;
  }

  .chat-voice-confirm--disabled {
    opacity: 0.45;
  }

  /* ===== 飞书式内嵌面板（表情 / 加号），与键盘互斥 ===== */
  /* 让位填充带：贴屏底（absolute 于 .chat-page、不占布局），高度=liftPx 且与主体平移
     同曲线同拍过渡；键盘态填同色灰补动画失配缝，面板态承载面板从下拉出/收回。
     height 0 + overflow hidden 静止态不可见（iOS 上同款旧表情面板折叠先例，稳定） */
  .chat-lift-zone {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    background-color: #f2f3f5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    transition-property: height;
    transition-duration: 250ms;
    transition-timing-function: cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  /* 表情槽位（填充带内）：高 0↔卡片高+下间距（内联 px）同曲线过渡，收起完全折叠——
     非激活面板不占位（键盘态不露内容、加号态不顶加号面板），先例=旧 .chat-emoji-panel 折叠 */
  .chat-emoji-slot {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transition-property: height;
    transition-duration: 250ms;
    transition-timing-function: cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  /* 表情卡片边框盒总高 448rpx（边框2+上内距16+滚动区336+操作行8+72+下内距12+边框2），
     改动面板内容需同步 script 的 EMOJI_CARD_RPX / EMOJI_SLOT_CONTENT_RPX。
     下间距由内联 6+safeBottom 恒定承担（不参与折叠动画） */
  .chat-panel {
    padding: 16rpx 16rpx 12rpx;
    border-radius: 32rpx;
    background-color: #ffffff;
    border: 2rpx solid rgba(81, 71, 255, 0.16);
    box-shadow: 0 8rpx 32rpx rgba(81, 71, 255, 0.08);
  }

  .chat-emoji-scroll {
    height: 336rpx;
  }

  /* 显式分行不用 flex-wrap：App 端 12.5% 宽的亚像素取整会把第 8 个 cell 挤到
     下一行（一排只显 7 个）；分行后换行判定不再参与，宽度余差由 cell 收缩吸收 */
  .chat-emoji-grid {
    display: flex;
    flex-direction: column;
  }

  .chat-emoji-row {
    display: flex;
    flex-direction: row;
  }

  /* 常用行（面板首行，仅真实历史）：小灰标题 + 恒一行（列数同网格） */
  .chat-emoji-recent {
    display: flex;
    flex-direction: column;
  }

  .chat-emoji-recent__title {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #6b6976;
    padding-left: 8rpx;
    padding-bottom: 4rpx;
  }

  .chat-emoji-cell {
    width: 12.5%;
    height: 84rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    /* 吸收分行后的宽度取整余差（App 端 shrink 默认 0 会横向溢出切边） */
    flex-shrink: 1;
  }

  .chat-emoji-cell--active {
    background-color: #f3f1fb;
    border-radius: 12rpx;
  }

  .chat-emoji-item {
    font-size: 44rpx;
    line-height: 56rpx;
  }

  /* 面板操作行：右侧退格（发送移至输入坞第二行右端发送键，面板内不再重复） */
  .chat-emoji-bar {
    margin-top: 8rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .chat-emoji-bar__space {
    flex: 1;
  }

  .chat-emoji-back {
    width: 72rpx;
    height: 72rpx;
    border-radius: 36rpx;
    background-color: #f3f1fb;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-emoji-back--active {
    background-color: #e9e6f7;
  }

  /* 加号面板（在工具行下方拉起）：灰底白磁贴行（dock 灰底延续，对齐设计图） */
  .chat-plus-panel {
    padding: 4rpx 16rpx 16rpx;
  }

  .chat-plus-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 16rpx 8rpx 8rpx;
  }

  .chat-plus-item {
    width: 25%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16rpx 0;
  }

  .chat-plus-item--active {
    opacity: 0.7;
  }

  .chat-plus-item__icon {
    width: 112rpx;
    height: 112rpx;
    border-radius: 56rpx;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-plus-item__text {
    margin-top: 12rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #55535f;
  }

  /* ===== 格式横条（Aa 开，与系统键盘共存；左右蓝键 + 六键 space-between 全行均匀分布，
     展开面板 Aa 格式行复用同款） ===== */
  .chat-fontbar {
    margin-top: 8rpx;
    padding: 10rpx 20rpx;
    border-radius: 16rpx;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  /* 展开面板内复用格式横条：去自身外距（bar 已有纵向内边距），撑满 bar 内宽。
     须放在 .chat-fontbar 之后——同为单类选择器，靠源码顺序覆盖 margin-top */
  .chat-fontbar--sheet {
    margin-top: 0;
    flex: 1;
  }

  .chat-fontbar__btn {
    width: 84rpx;
    height: 84rpx;
    border-radius: 42rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* 按压反馈（每个功能键点击都有对应背景） */
  .chat-fontbar__btn--active {
    background-color: #e9eaef;
  }

  /* 样式态/列表态选中背景（B/I/S/U 与有序/无序） */
  .chat-fontbar__btn--on {
    background-color: rgba(51, 126, 255, 0.14);
  }

  .chat-fontbar__glyph {
    font-size: 38rpx;
    line-height: 50rpx;
    font-weight: 600;
    color: #8a8896;
  }

  .chat-fontbar__glyph--b {
    font-weight: 800;
  }

  /* 斜体：衬线斜体大写 I（Word 式斜杠 I 观感） */
  .chat-fontbar__glyph--i {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 500;
  }

  .chat-fontbar__glyph--s {
    text-decoration-line: line-through;
  }

  .chat-fontbar__glyph--u {
    text-decoration-line: underline;
  }

  /* 有序列表 icon：1 2 3 数字行（行高/间隔与无序 icon 同几何，见 chat-ex-li-row） */
  .chat-ex-ol-num {
    width: 16rpx;
    margin-right: 4rpx;
    font-size: 13rpx;
    line-height: 14rpx;
    font-weight: 600;
    color: #8a8896;
    text-align: center;
  }

  /* 左端蓝底圆向下箭头：收起横条 */
  .chat-fontbar__down {
    width: 64rpx;
    height: 64rpx;
    border-radius: 32rpx;
    background-color: #337eff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chat-fontbar__down--active {
    opacity: 0.85;
  }

  /* ===== 富文本气泡渲染（嵌套 text 分段；样式能力对齐 uni-ai-text-md 已验证集） ===== */
  .chat-rich {
    /* ★不设 align-self: stretch——stretch 会让富文本容器按列可用宽拉满，
       连带把气泡撑到占满整行（用户反馈「消息行宽度不要占满」的根因）；
       代码块/引用/链接自身的 stretch 仍以气泡内容宽为界 */
    display: flex;
    flex-direction: column;
  }

  .chat-rl {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .chat-rl--code {
    align-self: stretch;
    margin: 6rpx 0;
    padding: 14rpx 18rpx;
    background-color: #f3f1fb;
    border-radius: 12rpx;
  }

  .chat-rl--code-mine {
    background-color: #f3f1fb;
  }

  .chat-rl--quote {
    align-self: stretch;
    margin: 6rpx 0;
    padding: 4rpx 0 4rpx 18rpx;
    border-left: 6rpx solid #c9c5e8;
  }

  .chat-rl--quote-mine {
    border-left: 6rpx solid rgba(255, 255, 255, 0.4);
  }

  /* 行内段基础（颜色不设：继承外层 chat-bubble__text 的我方白/对方深） */
  .chat-md {
    font-size: 30rpx;
    line-height: 46rpx;
  }

  /* 标题行（# / ## / ###） */
  .chat-md--h1 {
    font-size: 34rpx;
    line-height: 50rpx;
    font-weight: 700;
  }

  .chat-md--h2 {
    font-size: 32rpx;
    line-height: 48rpx;
    font-weight: 700;
  }

  .chat-md--h3 {
    font-size: 30rpx;
    line-height: 46rpx;
    font-weight: 600;
  }

  /* 行内段标记类 */
  .chat-md--b {
    font-weight: 700;
  }

  .chat-md--i {
    font-style: italic;
  }

  .chat-md--s {
    text-decoration-line: line-through;
  }

  .chat-md--u {
    text-decoration-line: underline;
  }

  .chat-md--c {
    font-size: 27rpx;
    background-color: rgba(27, 31, 35, 0.06);
    border-radius: 8rpx;
  }

  /* 行内代码（我方，无气泡底色后与常规版一致） */
  .chat-md--c-mine {
    background-color: rgba(27, 31, 35, 0.06);
  }

  /* 代码块整行（text 存多行原文，字号略小；不在 bubble__text 内需自带颜色） */
  .chat-md--block {
    font-size: 26rpx;
    line-height: 40rpx;
    color: #22212a;
  }

  .chat-md--block-mine {
    color: #22212a;
  }

  /* @提及统一使用高对比蓝色，包含我方发送的消息。 */
  .chat-md--at {
    color: #5147ff;
    font-weight: 600;
  }

  /* [标题](url) 链接段：微信同款链接蓝（与纯链接消息一致，点击打开） */
  .chat-md--link {
    color: #576b95;
  }

  /* 列表行首前缀（蓝色序号 "N. " / 圆点 "· "） */
  .chat-md--listmark {
    color: #337eff;
    font-weight: 600;
  }

  .chat-md--at-mine {
    color: #337eff;
    font-weight: 600;
  }

  /* 自绘清单 icon（项目 icon 库无对应资源）：有序=方条+线 / 无序=圆点+线 */
  .chat-ex-li {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* 清单 icon 行：固定行高 + 等距间隔（有序数字行与无序圆点行共用，两 icon 几何一致） */
  .chat-ex-li-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 14rpx;
    margin: 2rpx 0;
  }

  .chat-ex-li-dot {
    width: 8rpx;
    height: 8rpx;
    border-radius: 4rpx;
    background-color: #6b6976;
    margin-right: 8rpx;
  }

  .chat-ex-li-bar {
    width: 8rpx;
    height: 12rpx;
    border-radius: 3rpx;
    background-color: #6b6976;
    margin-right: 8rpx;
  }

  .chat-ex-li-line {
    width: 20rpx;
    height: 4rpx;
    border-radius: 2rpx;
    background-color: #9a98a5;
  }
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  /* #endif */
  /* #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || MP-LARK || MP-KUAISHOU || MP-JD */
  page {
    height: 100%;
  }
  /* #endif */
</style>
