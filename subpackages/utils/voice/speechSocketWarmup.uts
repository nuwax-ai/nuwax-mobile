/**
 * 会话页语音 Socket 生命周期（按需连接）。
 *
 * - 进页：只标记活跃，不预连
 * - 录音 onStart：预热 TTS；ASR 由录音按钮自行 preheatConnect / begin
 * - 离页：teardown 断开
 * - 前后台 / 相册 / Home：不做任何 socket 保活、挂起或重连
 *   （连接随录音/合成建立；ASR 识别完即关；TTS 靠自身 idleClose）
 */
import { asrWebSocketClient } from "./asrWebSocketClient";
import { ttsWebSocketPlayer } from "./ttsWebSocketPlayer";

/**
 * 会话页「长隐藏」阈值（ms）：仅给 usePageResume 做会话恢复 / 轮询，
 * 与 ASR·TTS socket 无关。
 */
export const CHAT_PAGE_LONG_HIDE_MS = 30000;

/** @deprecated 使用 CHAT_PAGE_LONG_HIDE_MS；保留别名避免外部旧引用 */
export const SPEECH_BACKGROUND_SUSPEND_DELAY_MS = CHAT_PAGE_LONG_HIDE_MS;

export class SpeechSocketWarmup {
  /** 会话页仍挂载（onMounted～onUnmounted） */
  private active: boolean = false;

  isActive(): boolean {
    return this.active;
  }

  /** 进入会话页：只标记活跃，不建连 */
  warmup(): void {
    this.active = true;
  }

  /**
   * 录音真正 onStart 后预热 TTS（建连但不发合成）。
   * 无论是否自动播报都预热（中途打开自动播报时可立刻出声）。
   * 轻触未开录不应调用。
   */
  preheatTtsForRecording(): void {
    if (this.active != true) {
      return;
    }
    ttsWebSocketPlayer.enableWarmupAndConnect();
  }

  /** 离开会话页：断开 ASR/TTS */
  teardown(): void {
    this.active = false;
    asrWebSocketClient.disableWarmupAndDisconnect();
    ttsWebSocketPlayer.disableWarmupAndDisconnect();
  }
}

/** 全局单例：会话页 mount/unmount / 按录音预热 */
export const speechSocketWarmup = new SpeechSocketWarmup();
