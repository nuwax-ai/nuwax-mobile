# 本机敏感配置模板（可提交业务仓）。真实值请放到签名目录，勿填进本文件后推远程。
#
# 推荐（权威模板与实值都在签名目录）：
#   cp "${NUWAX_SIGNING_HOME:-$HOME/workspace/nuwax-signing}/local-secrets.env.example" \
#      "${NUWAX_SIGNING_HOME:-$HOME/workspace/nuwax-signing}/local-secrets.env"
#   编辑签名目录下的 local-secrets.env；source scripts/local-base-env.sh 会优先加载它。
#
# 本文件与 $NUWAX_SIGNING_HOME/local-secrets.env.example 字段保持一致，便于未打开签名目录时查阅。
#
# 回退（已弃用）：仍可把本文件复制为 scripts/local-secrets.env（业务仓已 gitignore），
#   但 local-base-env.sh 会告警，请尽快迁到 $NUWAX_SIGNING_HOME/local-secrets.env。
#
# DCLOUD_APPKEY：DCloud 离线打包 AppKey（受控渠道获取）
# ANDROID_RELEASE_*：应用市场正式签名
# IOS_DEVELOPMENT_TEAM / IOS_PROVISIONING_PROFILE_UUID：Apple 开发者信息
export DCLOUD_APPKEY=
export ANDROID_RELEASE_STORE_FILE="${NUWAX_SIGNING_HOME:-$HOME/workspace/nuwax-signing}/android/nuwax-release.jks"
export ANDROID_RELEASE_STORE_TYPE="JKS"
export ANDROID_RELEASE_STORE_PASSWORD=''
export ANDROID_RELEASE_KEY_ALIAS="nuwax-release"
export ANDROID_RELEASE_KEY_PASSWORD=''
# 默认三条 Android 构建链统一使用上述正式证书；临时排障可在命令前覆盖为 debug。
export ANDROID_SIGNING_MODE="release"
export IOS_DEVELOPMENT_TEAM=
export IOS_PROVISIONING_PROFILE_UUID=
