<template>
  <!-- App 内嵌 H5：自绘全屏预览，避免 uni.previewImage 关闭时把原生聊天页弹回首页 -->
  <view
    v-if="visible"
    class="app-wv-image-preview"
    @tap="onOverlayTap"
    @touchstart="onTouchStart"
    @touchmove.stop.prevent="onTouchMove"
    @touchend="onTouchEnd"
  >
    <image
      class="app-wv-image-preview__img"
      :src="currentUrl"
      mode="aspectFit"
      @tap.stop="onOverlayTap"
      @touchstart="onTouchStart"
      @touchmove.stop.prevent="onTouchMove"
      @touchend="onTouchEnd"
    />
  </view>
</template>

<script setup lang="uts">
  import { onUnmounted, ref, watch } from "vue";
  import {
    installAppWebViewImagePreviewHook,
    setAppWebViewImagePreviewHost,
    uninstallAppWebViewImagePreviewHook,
  } from "@/utils/appWebViewImagePreview.uts";
  import {
    registerBackInterceptionGlobals,
    registerPopupClose,
    unregisterPopupClose,
  } from "@/utils/popupBackRegistry";

  const visible = ref<boolean>(false);
  const currentUrl = ref<string>("");
  let popupRegistryId: number = 0;
  let touchStartX: number = 0;
  let touchStartY: number = 0;
  let closedBySwipe: boolean = false;
  const SWIPE_CLOSE_THRESHOLD: number = 60;

  const close = (): void => {
    visible.value = false;
  };

  const onOverlayTap = (): void => {
    if (closedBySwipe == true) {
      closedBySwipe = false;
      return;
    }
    close();
  };

  const openPreview = (_urls: string[], current: string): void => {
    closedBySwipe = false;
    currentUrl.value = current;
    visible.value = true;
  };

  const onTouchStart = (e: UniTouchEvent): void => {
    if (e == null || e.touches == null || e.touches.length == 0) {
      return;
    }
    closedBySwipe = false;
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  };

  const onTouchMove = (_e: UniTouchEvent): void => {};

  const onTouchEnd = (e: UniTouchEvent): void => {
    if (
      e == null ||
      e.changedTouches == null ||
      e.changedTouches.length == 0
    ) {
      return;
    }
    const touch = e.changedTouches[0];
    const deltaX = touch.clientX - touchStartX;
    const deltaY = touch.clientY - touchStartY;
    if (deltaX > 0 - SWIPE_CLOSE_THRESHOLD) {
      return;
    }
    if (Math.abs(deltaX) <= Math.abs(deltaY)) {
      return;
    }
    closedBySwipe = true;
    close();
  };

  // 始终登记宿主与 hook：内嵌桥可能晚于 setup。点击时再判断是否内嵌；
  // 浏览器直开会回落到 uni.previewImage，不改预览体验。
  registerBackInterceptionGlobals();
  setAppWebViewImagePreviewHost(openPreview);
  installAppWebViewImagePreviewHook();
  watch(
    visible,
    (val: boolean) => {
      if (val == true) {
        if (popupRegistryId == 0) {
          popupRegistryId = registerPopupClose(close);
        }
      } else if (popupRegistryId != 0) {
        unregisterPopupClose(popupRegistryId);
        popupRegistryId = 0;
      }
    },
    { immediate: true },
  );

  onUnmounted(() => {
    setAppWebViewImagePreviewHost(null);
    uninstallAppWebViewImagePreviewHook();
    if (popupRegistryId != 0) {
      unregisterPopupClose(popupRegistryId);
      popupRegistryId = 0;
    }
    visible.value = false;
  });
</script>

<style lang="scss" scoped>
  .app-wv-image-preview {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 10050;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.92);
    /* #ifdef H5 */
    touch-action: none;
    /* #endif */
  }

  .app-wv-image-preview__img {
    width: 100%;
    height: 100%;
  }
</style>
