    left: 2px;
  }

  /* 标题即「会议信息」入口（飞书同款：文字 + 下拉箭头） */
  .mr-header__main {
    flex: 1;
    height: 40px;
    padding-left: 2px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .mr-header__main--active {
    opacity: 0.6;
  }

  .mr-header__title {
    font-size: 17px;
    line-height: 24px;
    font-weight: 600;
    color: #141416;
    margin-right: 2px;
  }

  /* 标题下那行计时（飞书同位置） */
  .mr-clock {
    padding: 0 14px 2px 14px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .mr-clock__text {
    font-size: 12px;
    line-height: 17px;
    color: #8f8f99;
  }

  .mr-clock__limit {
    margin-left: 5px;
    padding: 1px 6px;
    border-radius: 8px;
    font-size: 11px;
    line-height: 16px;
    color: #646a73;
  }

  .mr-clock__limit--warn {
    background-color: #fff3e0;
    color: #c96a00;
  }

  /* 计时行右侧的「布局」入口：图标 + 文字的小胶囊按钮 */
  .mr-clock__spacer {
    flex: 1;
  }

  .mr-clock__layout {
    padding: 2px 8px;
    border-radius: 11px;
    background-color: #eceef2;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .mr-clock__layout-text {
    margin-left: 4px;
    font-size: 11px;
    line-height: 16px;
    color: #4e5969;
  }

  /* 舞台：浅灰底 + 居中头像圆（没人开视频时的画面）
     ★position: relative 不能删：舞台左下角那行「🎤 张三（我）」是 absolute，
       没有定位祖先时会落到**页面**左下角、压住工具条第一个按钮（点它没反应）。
     ★多人（宫格）时舞台通栏：左右不留白、去掉圆角（房间画面对齐飞书宫格）；
       圆角与左右留白只在单人卡片态由 `--solo` 加回来。 */
  .mr-stage {
    position: relative;
    flex: 1;
    margin: 8px 0 12px 0;
    border-radius: 0;
    background-color: #f2f3f5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* 原生视频视图是矩形，靠父级裁出圆角 */
    overflow: hidden;
    /* 兜底：任何 flex 尺寸算错都不至于把整块舞台压成 0（上面 solo 那次的教训） */
    min-height: 180px;
  }

  /* 只有我一个人：卡片高度占容器的一半（用户要求再收一半），内容居中；
     左右保留 12px 留白；圆角与宫格卡片（.mr-tile__avatar 的 5px）保持一致。
     ★用 flex-basis: 50% 而不是 height：基类 `flex: 1` 的 flex-basis 是 0%，
       只覆盖 grow/shrink 高度会被压成 0（已两次踩坑）。 */
  .mr-stage--solo {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 50%;
    margin: 8px 12px 12px 12px;
    border-radius: 5px;
    justify-content: center;
  }

  /* 舞台容器：撑满剩余高度，工具条因此始终贴底 */
  .mr-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    /* 单人卡片在页面垂直方向居中（不留顶部空档） */
    justify-content: center;
  }

  /* 多人：每行两格（脚本切行，不依赖 flex-wrap） */
  .mr-grid {
    flex: 1;
    width: 100%;
    padding: 10px;
    display: flex;
    flex-direction: column;
    /* 宫格整体在页面中居中（行数少时不贴顶） */
    justify-content: center;
  }

  .mr-grid__row {
    display: flex;
    flex-direction: row;
  }

  /* 铺满态：这一行吃掉舞台剩余高度（只在单格显示时由模板直接绑定） */
  .mr-grid__row--fill {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
  }

  .mr-tile {
    flex: 1;
    /* 横/纵都要留出间隔（相邻格 5+5=10px）：App 端 row-gap 不生效，用 padding 撑 */
    padding: 5px;
  }

  /* 铺满态：格子不再留白，内层头像区吃满整格 */
  .mr-tile--fill {
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* 卡片本体：白底 + 圆角 + 居中头像（用内层 view 撑比例，避免百分比高度塌陷） */
  .mr-tile__avatar {
    position: relative;
    width: 100%;
    height: 120px;
    border-radius: 5px;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    /* 原生视频是矩形，靠格子裁圆角 */
    overflow: hidden;
  }

  .mr-tile__img {
    width: 72px;
    height: 72px;
    border-radius: 36px;
  }

  /* 远端视频：铺满格子（圆角由格子自身裁） */
  .mr-tile__video {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }

  .mr-tile__initial {
    font-size: 34px;
    line-height: 42px;
    font-weight: 600;
    color: #5147ff;
  }

  /* 铺满态：头像区吃满整格（★用 flex-basis 0 + grow，height 会被 flex 覆盖） */
  .mr-tile__avatar--fill {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    border-radius: 0;
  }

  /* 3×3（5 人以上）时缩小格子内的头像，保证 9 格排得下 */
  .mr-tile__avatar--compact {
    height: 84px;
  }

  .mr-tile__initial--compact {
    font-size: 24px;
    line-height: 30px;
  }

  .mr-tile__img--compact {
    width: 48px;
    height: 48px;
    border-radius: 24px;
  }

  /* 分页器：宫格超过一页时出现在舞台底部中间 */
  .mr-pager {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    z-index: 3;
  }

  .mr-pager__btn {
    width: 30px;
    height: 30px;
    line-height: 30px;
    text-align: center;
    font-size: 18px;
    color: #4e5969;
  }

  .mr-pager__text {
    margin: 0 6px;
    font-size: 12px;
    line-height: 17px;
    color: #4e5969;
  }

  /* 我的卡片左上角的切摄像头按钮（宫格模式） */
  .mr-tile__switch {
    position: absolute;
    left: 6px;
    top: 6px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    /* 必须高于透明命中层（z=3），否则切换摄像头点不到 */
    z-index: 4;
  }

  /* 名字条：压在卡片左下角（视频/头像之上），飞书同款 */
  .mr-tile__name-wrap {
    position: absolute;
    left: 2px;
    bottom: 2px;
    max-width: 90%;
    /* 高度 -5px；圆角 3px */
    padding: 3.5px 5px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.75);
    display: flex;
    flex-direction: row;
    align-items: center;
    z-index: 2;
  }

  .mr-tile__name {
    margin-left: 0;
    font-size: 10px;
    line-height: 14px;
    color: #1f2329;
    flex-shrink: 1;
  }

  .mr-tile__status-icon {
    margin-right: 2px;
  }

  .mr-tile__status-img {
    width: 9px;
    height: 9px;
    margin-right: 2px;
  }

  /* 举手标：格子左上角放大展示（白底圆托住，盖在视频画面上也看得清） */
  .mr-tile__hand {
    position: absolute;
    left: 6px;
    top: 6px;
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: rgba(255, 255, 255, 0.92);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    z-index: 3;
  }

  .mr-tile__hand-img {
    width: 18px;
    height: 18px;
  }

  /* 3×3 宫格：格子更小，举手标等比收一档 */
  .mr-tile__hand--compact {
    left: 4px;
    top: 4px;
    width: 22px;
    height: 22px;
    border-radius: 11px;
  }

  .mr-tile__hand--compact .mr-tile__hand-img {
    width: 15px;
    height: 15px;
  }

  /* 自己开着自己的视频：左上角是切换摄像头按钮（left:6/top:6），举手标右移让位 */
  .mr-tile__hand--shift {
    left: 30px;
  }

  /* 点整格的透明命中层：盖在头像与原生视频之上（原生视频会吞掉父级点击），
     压在名字条之上（名字条本身不可点），切换摄像头/共享全屏靠更高的 z-index 保持可点 */
  .mr-tile__hit {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
  }

  /* ===== 两人：一人一行、上下排列，中间留 12px 间距（不左右并排） =====
     ★间距用格子自身的上下 padding 撑（6+6=12），不用 row-gap：
       App 端 flex 的 row-gap 实测不生效，两张卡会直接贴在一起。
     ★行/格/头像吃高度的类同样直绑在节点上（--stack），理由同铺满态。 */
  .mr-grid--stack {
    padding: 4px 10px;
  }

  .mr-grid__row--stack {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
  }

  .mr-tile--stack {
    padding: 6px 0;
    display: flex;
    flex-direction: column;
  }

  /* flex 撑满会盖掉基类的 height:120px，让两张卡片各占容器的一半 */
  .mr-tile__avatar--stack {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
  }

  /* ===== 缩略图条（顶部 / 侧边布局） =====
     绝对定位在舞台里，大图区靠 grid 的 padding 让位（见下面的 --topThumbs/--sideThumbs） */
  .mr-thumbs {
    position: absolute;
    z-index: 3;
  }

  .mr-thumbs--top {
    left: 0;
    right: 0;
    top: 0;
    height: 76px;
    padding: 8px 10px;
  }

  .mr-thumbs--side {
    right: 0;
    top: 0;
    bottom: 0;
    width: 76px;
    padding: 8px 10px;
  }

  /* ★横/竖用内层自己的类直接给，不靠「祖先类 + 后代选择器」：
     Android 上祖先类切换后后代样式不重算，侧边条切回顶部条会继续竖排。 */
  .mr-thumbs__inner {
    display: flex;
    flex-direction: row;
  }

  .mr-thumbs__inner--top {
    flex-direction: row;
  }

  .mr-thumbs__inner--side {
    flex-direction: column;
  }

  .mr-thumb {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    background-color: #eceafd;
    border: 1px solid transparent;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mr-thumbs--top .mr-thumb {
    margin-right: 8px;
  }

  .mr-thumbs--side .mr-thumb {
    margin-bottom: 8px;
  }

  /* 大图区正在画的那位：蓝色描边高亮 */
  .mr-thumb--on {
    border: 2px solid #3370ff;
  }

  .mr-thumb--active {
    opacity: 0.75;
  }

  .mr-thumb__img {
    width: 100%;
    height: 100%;
    border-radius: 9px;
  }

  .mr-thumb__initial {
    font-size: 18px;
    line-height: 24px;
    font-weight: 600;
    color: #5147ff;
  }

  /* ===== 单格放大（点宫格放大到整个舞台容器） ===== */
  .mr-grid--full {
    padding: 0;
  }

  /* 顶部/侧边布局给缩略图条让出位置（双类选择器特异性更高，盖过上面的 padding:0） */
  .mr-grid--full.mr-grid--topThumbs {
    padding: 76px 0 0 0;
  }

  .mr-grid--full.mr-grid--sideThumbs {
    padding: 0 76px 0 0;
  }

  /* 放大态头像/首字同步放大，否则一格铺满屏中间只有 72px 的小头像
     （铺满态的布局类直接绑在节点上，见 .mr-grid__row--fill / .mr-tile--fill /
      .mr-tile__avatar--fill；★不要改回 .mr-grid--full 后代选择器） */
  .mr-tile__img--fill {
    width: 104px;
    height: 104px;
    border-radius: 52px;
  }

  .mr-tile__initial--fill {
    font-size: 44px;
    line-height: 54px;
  }

  /* 右上角让给「返回宫格」，共享全屏入口在放大态下移避让
     （用双类提高特异性：--compact 规则在文件后面，单类会被它盖掉） */
  .mr-tile__fullscreen.mr-tile__fullscreen--fill {
    top: 40px;
  }

  /* 返回宫格：舞台右上角浮层按钮（点击卡片本身也会还原） */
  .mr-focus-exit {
    position: absolute;
    right: 8px;
    top: 8px;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    z-index: 5;
  }

  /* 叉号的视觉重心偏左：relative 右移 2px（flex 居中下不会把偏移对半分） */
  .mr-focus-exit__icon {
    position: relative;
    left: 2px;
  }

  .mr-tile__host {
    margin-left: 3px;
    font-size: 9px;
    line-height: 13px;
    color: #b26a00;
    flex-shrink: 0;
  }

  .mr-tile__rec,
  .mr-stage__rec {
    margin-left: 4px;
    font-size: 9px;
    line-height: 13px;
    color: #e5484d;
    font-weight: 600;
    flex-shrink: 0;
  }

  /* 单人卡片里的大头像：从 176px 收到 112px（用户反馈太大），文字同步缩小 */
  .mr-avatar-big {
    width: 112px;
    height: 112px;
    border-radius: 56px;
    background-color: #5147ff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mr-avatar-big__text {
    font-size: 40px;
    line-height: 48px;
    font-weight: 600;
    color: #ffffff;
  }

  /* 舞台左下角：麦克风状态 + 「张三（我）」 */
  /* 原生视频：铺满舞台（圆角靠父级 overflow:hidden 裁） */
  /* 原生视频：作为卡片的普通子节点铺满（100% 宽高）。
     ★不要用绝对定位：native-view 在 flex 居中的父容器里绝对定位时，
       部分端会按原生视图的默认尺寸出图，表现就是"黑底 + 一个小画面"。 */
  .mr-stage__video {
    width: 100%;
    height: 100%;
  }

  /* #ifdef APP-HARMONY */
  .mr-harmony-stage {
    width: 100%;
    height: 100%;
  }

  .mr-harmony-stage--hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /* #endif */

  /* 单人卡片的左下角名字条：做成深色小标签，压在画面上也读得清 */
  .mr-stage__foot {
    position: absolute;
    /* 单人卡片的左下角名字条：9px 基础上再左移 2px（用户要求） */
    left: 7px;
    bottom: 2px;
    padding: 3.5px 5px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.75);
    display: flex;
    flex-direction: row;
    align-items: center;
    z-index: 2;
  }

  .mr-stage__name {
    margin-left: 1px;
    font-size: 11px;
    line-height: 15px;
    color: #1f2329;
  }

  .mr-stage__status-img {
    width: 10px;
    height: 10px;
    margin-right: 2px;
  }

  /* ===== 底部操作区：5 列网格，最后一行最后一格是收起/展开箭头 =====
     整块同一个背景色（不再有分隔横线），收起后只剩箭头那一排。 */
  .mr-actions {
    /* 底部内边距的 App 分支由 toolsStyle 内联覆盖（样式表 env() 在 App 端不可靠） */
    padding: 4px 2px calc(6px + env(safe-area-inset-bottom, 0px)) 2px;
    background-color: #ffffff;
    /* ★不许被压缩：主持人三排时整页内容变高，page 是 flex 列，默认 shrink 会把这整块
       挤矮、把每排按钮的文案裁掉（参会人两排不溢出所以没暴露）。要让舞台去缩。 */
    flex-shrink: 0;
  }

  /* 行距统一挂在这一层：2 排 / 3 排的行间距完全一致（用户要求对齐） */
  .mr-actions__row {
    padding: 4px 0;
    display: flex;
    flex-direction: row;
    align-items: stretch;
  }

  /* 每排 5 格等分（flex:1），空位也是同宽的格子，箭头因此恒在最后一格。
     ★用 min-height 而不是 height：系统字体放大时格子跟着长高，文案不会被裁掉。 */
  .mr-action {
    flex: 1;
    min-width: 0;
    min-height: 52px;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* 收起态只剩箭头那排：那排压矮一点，别白占舞台高度 */
  .mr-actions--collapsed .mr-actions__row {
    padding: 2px 0;
  }

  .mr-actions--collapsed .mr-action {
    min-height: 38px;
    padding: 0;
  }

  .mr-action--active {
    opacity: 0.55;
  }

  .mr-action__icon {
    position: relative;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* 选中态（共享中 / 已举手 / 弹幕开 / 全员静音 / 录制中）：
     只加淡蓝底，图标仍是同一个 ink 色（用户要求 icon 颜色统一，不换白） */
  .mr-action__icon--on {
    background-color: #e8efff;
  }

  .mr-action__img {
    width: 20px;
    height: 20px;
  }

  /* 图标字形微调：弹幕（方块套方块）视觉重心偏左，整块右移 1px。
     ★用 margin-left: 2px 而不是 left/padding：外框是 flex 居中，
       padding 只挪一半（实测不生效），position: relative + left 在 App 端也不生效；
       居中容器里 margin-left 2px 的可视位移正好是 1px。 */
  .mr-action__glyph-shift {
    margin-left: 2px;
  }

  .mr-action__label {
    margin-top: 2px;
    font-size: 10px;
    line-height: 14px;
    color: #4e5969;
    text-align: center;
  }

  /* 参会人角标（飞书同款：图标右上角小圆）
     ★不要用 min-width：App 端支持不稳，宽度算成 0 就只剩一块蓝色、数字看不见（真机现象）。
       给死尺寸 + 足够字号，数字才出得来。 */
  /* 视频层左上角的切换前后摄像头按钮 */
  .mr-stage__switch {
    position: absolute;
    left: 10px;
    top: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .mr-stage__switch--active {
    opacity: 0.6;
  }

  .mr-stage__switch-img {
    width: 24px;
    height: 24px;
  }

  .mr-tile__switch-img {
    width: 16px;
    height: 16px;
  }

  /* 共享者卡片右上角的全屏入口 */
  .mr-tile__fullscreen {
    position: absolute;
    right: 6px;
    top: 6px;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    /* 与切换摄像头同理：要压在透明命中层（z=3）之上才点得到 */
    z-index: 4;
  }

  .mr-tile__fullscreen--compact {
    right: 4px;
    top: 4px;
    width: 20px;
    height: 20px;
  }

  .mr-tile__fullscreen-img {
    width: 14px;
    height: 14px;
  }

  /* 共享全屏：黑底铺满，点任意处退出 */
  .mr-fs {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 60;
    background-color: #000000;
    display: flex;
    flex-direction: column;
  }

  .mr-fs__video {
    flex: 1;
    width: 100%;
  }

  .mr-fs__bar {
    height: 48px;
    padding: 0 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0.6);
  }

  .mr-fs__name {
    font-size: 14px;
    line-height: 20px;
    color: #ffffff;
  }

  .mr-fs__close {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 真实头像圆同步缩到 112px（与首字圆同尺寸，切换时不跳） */
  .mr-avatar-big__img {
    width: 112px;
    height: 112px;
    border-radius: 56px;
  }

  /* ---- 底部面板 ---- */
  .mr-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .mr-sheet {
    max-height: 72%;
    background-color: #ffffff;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    display: flex;
    flex-direction: column;
    /* App 分支由 sheetStyle 内联覆盖，其余端用 env() 兜底 */
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .mr-sheet--chat {
    /* App 端高度由 sheetStyle 按窗口高度的 1/2 设置；H5/小程序用 vh 兜底（同口径）。 */
    height: 50vh;
    max-height: 50vh;
    box-sizing: border-box;
  }

  .mr-sheet__head {
    height: 48px;
    padding: 0 12px 0 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .mr-sheet__title {
    font-size: 16px;
    line-height: 22px;
    font-weight: 600;
    color: #141416;
  }

  .mr-sheet__close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mr-sheet__close--active {
    opacity: 0.65;
  }

  .mr-chat-head {
    height: 52px;
    padding: 0 12px 0 16px;
    border-bottom: 1px solid #e8e9ed;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .mr-chat-head__title {
    font-size: 18px;
    line-height: 25px;
    font-weight: 600;
    color: #141416;
  }

  .mr-chat-head__actions {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .mr-chat-danmaku {
    padding: 6px 12px;
    border-radius: 18px;
    background-color: #f2f3f5;
    margin-right: 12px;
  }

  .mr-chat-danmaku--on {
    background-color: #fff1df;
  }

  .mr-chat-danmaku--disabled {
    opacity: 0.55;
  }

  .mr-chat-danmaku--active,
  .mr-chat-close--active {
    opacity: 0.65;
  }

  .mr-chat-danmaku__text {
    font-size: 14px;
    line-height: 20px;
    color: #d97706;
  }

  .mr-chat-close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mr-chat-close__text {
    font-size: 28px;
    line-height: 30px;
    font-weight: 300;
    color: #8f8f99;
  }

  .mr-chat-content {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .mr-chat-list {
    flex: 1;
    min-height: 0;
    padding: 14px 12px 10px 12px;
  }

  .mr-chat-empty {
    flex: 1;
    padding-top: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mr-chat-empty__text {
    font-size: 13px;
    color: #a0a3ab;
  }

  .mr-chat-row {
    width: 100%;
    margin-bottom: 10px;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
  }

  .mr-chat-row--self {
    justify-content: flex-end;
  }

  .mr-chat-bubble {
    max-width: 78%;
    padding: 8px 12px;
    border-radius: 12px;
    background-color: #f2f3f5;
    display: flex;
    flex-direction: column;
  }

  .mr-chat-bubble--self {
    background-color: #e6f1ff;
  }

  .mr-chat-name {
    font-size: 11px;
    line-height: 16px;
    color: #7d818c;
  }

  .mr-chat-text {
    margin-top: 2px;
    font-size: 15px;
    line-height: 21px;
    color: #141416;
    word-break: break-all;
  }

  /* 会中聊天 markdown 气泡：排版由渲染器自带（段落/列表/代码块/表格各自成套），
     这里只约束容器宽度，超宽内容（代码块、表格）不许把气泡撑破 */
  .mr-chat-md {
    margin-top: 2px;
    width: 100%;
    overflow: hidden;
  }

  .mr-chat-compose {
    padding: 10px 12px;
    border-top: 1px solid #e8e9ed;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .mr-chat-input {
    flex: 1;
    height: 44px;
    padding: 0 14px;
    border: 1px solid #5147ff;
    border-radius: 12px;
    background-color: #ffffff;
    font-size: 16px;
    color: #141416;
  }

  .mr-chat-send {
    width: 44px;
    height: 44px;
    margin-left: 12px;
    border-radius: 22px;
    background-color: #5147ff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 白色 icon 的视觉重心偏左，累计右移 4px 让它在圆钮里看起来居中 */
  .mr-chat-send__icon {
    /* ★用 relative + left：父级 justify-content:center 会把 margin/padding 的留白
       对半分，实际只挪一半甚至看不出来（项目里 mt-action__glyph--nudge 同款结论）。 */
    position: relative;
    left: 4px;
  }

  .mr-chat-send--disabled {
    background-color: #e5e6ea;
  }

  .mr-chat-send--active {
    opacity: 0.72;
  }

  /* flex:1 让参会人多时在面板内滚动（父级 max-height 封顶，内容短则按内容高） */
  .mr-sheet__body {
    flex: 1;
    padding: 0 16px 12px 16px;
  }

  /* 会议主题（面板第一项，PC 同序） */
  .mr-sheet__topic {
    padding: 2px 0 10px 0;
    font-size: 17px;
    line-height: 24px;
    font-weight: 600;
    color: #141416;
  }

  .mr-sheet__foot {
    padding: 16px 0 8px 0;
  }

  /* ---- 信息行 / 链接 / 按钮 ---- */
  .mr-row {
    padding: 10px 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .mr-label {
    font-size: 13px;
    line-height: 18px;
    color: rgba(21, 23, 31, 0.55);
    flex-shrink: 0;
    margin-right: 12px;
  }

  .mr-value {
    flex: 1;
    font-size: 14px;
    line-height: 20px;
    color: #141416;
    text-align: right;
  }

  .mr-value--muted {
    color: rgba(21, 23, 31, 0.45);
    font-size: 12px;
    line-height: 18px;
  }

  .mr-value-row {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
  }

  .mr-no {
    font-size: 15px;
    line-height: 21px;
    font-weight: 600;
    color: #141416;
  }

  .mr-pill {
    margin-left: 8px;
    padding: 3px 10px;
    border-radius: 10px;
    background-color: #f2f1f7;
    font-size: 12px;
    line-height: 16px;
    color: #5147ff;
    flex-shrink: 0;
  }

  .mr-pill--active {
    opacity: 0.6;
  }

  .mr-tag {
    padding: 2px 8px;
    border-radius: 9px;
    background-color: #f2f1f7;
    flex-shrink: 0;
  }

  .mr-tag__text {
    font-size: 11px;
    line-height: 15px;
    color: rgba(21, 23, 31, 0.6);
  }

  .mr-tag--live {
    background-color: #e7f6ef;
  }

  .mr-tag__text--live {
    color: #1f9e6f;
  }

  .mr-tag--pending {
    background-color: #f2f1f7;
  }

  .mr-tag__text--pending {
    color: rgba(21, 23, 31, 0.6);
  }

  .mr-failed {
    margin-top: 10px;
    padding: 10px;
    border-radius: 10px;
    background-color: #fdeceb;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .mr-failed__text {
    font-size: 12px;
    line-height: 18px;
    color: #d83931;
  }

  /* 主操作黑色（与「发起 / 加入 / 预约」三页的黑色主按钮同一口径） */
  .mr-primary {
    height: 46px;
    border-radius: 23px;
    background-color: #111111;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mr-primary--active {
    opacity: 0.85;
  }

  .mr-primary__text {
    font-size: 15px;
    line-height: 21px;
    font-weight: 600;
    color: #ffffff;
  }

  /* ---- 参会人 ---- */
  .mr-sec-state {
    padding: 18px 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .mr-sec-state__text {
    font-size: 12px;
    line-height: 18px;
    color: rgba(21, 23, 31, 0.4);
  }

  .mr-members {
    display: flex;
    flex-direction: column;
  }

  .mr-member {
    padding: 8px 0;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  /* 会中成员行：上排是身份，下排是主持人操作（竖排容器） */
  .mr-member--tile {
    flex-direction: column;
    align-items: stretch;
    padding: 10px 0;
    border-bottom: 1px solid #f2f1f7;
  }

  .mr-member__line {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .mr-member__acts {
    margin-top: 8px;
    margin-left: 40px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .mr-act {
    padding: 4px 10px;
    margin-right: 8px;
    border-radius: 12px;
    background-color: #f2f1f7;
  }

  .mr-act--active {
    opacity: 0.6;
  }

  .mr-act--off {
    opacity: 0.4;
  }

  .mr-act__text {
    font-size: 12px;
    line-height: 16px;
    color: #141416;
  }

  .mr-act--danger {
    background-color: #fdeceb;
  }

  .mr-act__text--danger {
    color: #d83931;
  }

  .mr-avatar__img {
    width: 30px;
    height: 30px;
    border-radius: 15px;
  }

  .mr-badge--muted {
    background-color: #f2f1f7;
  }

  .mr-badge__text--muted {
    color: rgba(21, 23, 31, 0.5);
  }

  /* 头像位：详情只给昵称没有头像，用文字圆片占位（不引入 image，避开各端加载差异） */
  .mr-avatar {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: #eceafd;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mr-avatar__text {
    font-size: 13px;
    line-height: 18px;
    font-weight: 600;
    color: #5147ff;
  }

  .mr-member__name {
    flex: 1;
    margin-left: 10px;
    font-size: 14px;
    line-height: 20px;
    color: #141416;
  }

  .mr-badge {
    margin-left: 8px;
    padding: 1px 7px;
    border-radius: 8px;
    background-color: #fdf3e3;
    flex-shrink: 0;
  }

  .mr-badge__text {
    font-size: 10px;
    line-height: 15px;
    color: #d97706;
  }

  /* ---- 「更多」功能宫格 ---- */
  .mr-more-row {
    display: flex;
    flex-direction: row;
    margin-bottom: 18px;
  }

  .mr-more-row:last-child {
    margin-bottom: 4px;
  }

  /* 每排固定 4 等分：两排列宽与列心才能对齐（主持人第二排不再用占位格凑数）。 */
  .mr-more-item {
    flex: 1;
    min-width: 0;
  }

  .mr-more-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 点击反馈只作用图标，避免下面的文案跟着闪灰。 */
  .mr-more-item--active .mr-more-item__icon,
  .mr-more-item--active .mr-more-item__img {
    opacity: 0.65;
  }

  /* 请求在途时不再整体降透明：图标与文案忽明忽暗会被当成「闪灰」。
     防重复点击由 moreBusy 判断保证，不靠视觉置灰。 */
  .mr-more-item--busy {
    opacity: 1;
  }

  .mr-invite-panel {
    margin-top: 4px;
    padding: 12px;
    border-radius: 12px;
    background-color: #f7f8fa;
  }

  .mr-invite-panel__head {
    display: flex;
    flex-direction: column;
  }

  /* 标题行：标题 + 右侧刷新（提示文案仍在下一行） */
  .mr-invite-panel__head-row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .mr-invite-panel__spacer {
    flex: 1;
  }

  .mr-invite-panel__refresh {
    width: 28px;
    height: 28px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mr-invite-panel__refresh--busy {
    opacity: 0.4;
  }

  /* 与会议历史记录那个刷新图标同一份资源（18px 缩放后视觉≈16px） */
  .mr-invite-panel__refresh-img {
    width: 18px;
    height: 18px;
  }

  .mr-invite-panel__title {
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: #141416;
  }

  .mr-invite-panel__hint {
    margin-top: 3px;
    font-size: 11px;
    line-height: 16px;
    color: #8f8f99;
  }

  .mr-invite-panel__search {
    height: 30px;
    margin-top: 8px;
    padding: 0 8px;
    border-radius: 6px;
    background-color: #ffffff;
    /* 输入内容与 placeholder 同字号：整块比面板标题小一级 */
    font-size: 12px;
    color: #141416;
  }

  .mr-invite-panel__list {
    height: 188px;
    margin-top: 6px;
  }

  .mr-invite-panel__state {
    padding: 18px 4px;
    font-size: 12px;
    line-height: 18px;
    color: #8f8f99;
    text-align: center;
  }

  .mr-invite-panel__state--empty {
    height: 188px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mr-invite-panel__state-empty-text {
    font-size: 12px;
    line-height: 18px;
    color: #b8bac2;
  }

  .mr-invite-row {
    height: 42px;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-bottom: 1px solid #ececf0;
  }

  .mr-invite-row--selected {
    background-color: #f5f6f8;
  }

  /* 已在会议中的人：整行置灰、勾选圈禁用（点了不响应，见 toggleInvitee 的守卫） */
  .mr-invite-row--disabled {
    opacity: 0.45;
  }

  .mr-invite-row--disabled .mr-invite-row__check {
    border-color: #dcdce4;
    background-color: #f2f2f5;
  }

  /* 勾选圆圈：行尾右侧（头像 → 名字 → 圆圈） */
  .mr-invite-row__check {
    width: 20px;
    height: 20px;
    margin-left: 8px;
    flex-shrink: 0;
    border: 1px solid #c9c9d2;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #141416;
    font-size: 13px;
  }

  /* 选中态保留细边框，不再显示黑色实心圆；仅勾本身使用黑色。 */
  .mr-invite-row--selected .mr-invite-row__check {
    border-color: #141416;
    background-color: transparent;
    color: #141416;
  }

  /* 头像现在是行首（面板自带 12px 内边距，不再额外做左边距） */
  .mr-invite-row__avatar {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #eceafd;
  }

  .mr-invite-row__avatar text {
    font-size: 12px;
    color: #5147ff;
  }

  .mr-invite-row__avatar-img {
    width: 28px;
    height: 28px;
    border-radius: 14px;
  }

  /* min-width: 0：不加的话长名字会把右侧勾选圆圈挤出圆角外（flex 子项默认 min-width:auto） */
  .mr-invite-row__name {
    flex: 1;
    min-width: 0;
    margin-left: 8px;
    font-size: 13px;
    line-height: 18px;
    color: #141416;
  }

  .mr-invite-panel__foot {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
  }

  .mr-invite-panel__count {
    flex: 1;
    font-size: 12px;
    color: #8f8f99;
  }

  .mr-invite-panel__send {
    height: 34px;
    padding: 0 16px;
    border-radius: 17px;
    background-color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mr-invite-panel__send text,
  .mr-invite-panel__send-text {
    font-size: 12px;
    color: #ffffff;
  }

  .mr-invite-panel__send--disabled {
    opacity: 0.45;
  }

  /* ===== 布局选择弹层（宫格 / 顶部缩略图 / 侧边缩略图 / 演讲者） ===== */
  .mr-layout-list {
    display: flex;
    flex-direction: column;
  }

  .mr-layout-item {
    margin-bottom: 6px;
    padding: 10px 12px;
    border-radius: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  /* 选中行：浅蓝底 + 圆角（与设计稿一致） */
  .mr-layout-item--on {
    background-color: #edf2ff;
  }

  .mr-layout-item--active {
    background-color: #f2f3f5;
  }

  .mr-layout-item__icon {
    flex-shrink: 0;
  }

  .mr-layout-item__body {
    flex: 1;
    min-width: 0;
    margin-left: 10px;
    display: flex;
    flex-direction: column;
  }

  .mr-layout-item__title {
    font-size: 15px;
    line-height: 21px;
    color: #1f2329;
  }

  .mr-layout-item__title--on {
    color: #3370ff;
  }

  .mr-layout-item__desc {
    margin-top: 2px;
    font-size: 12px;
    line-height: 17px;
    color: #8f959e;
  }

  .mr-more-item__icon {
    /* 未读角标绝对定位到这个盒子的右上角 */
    position: relative;
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background-color: #f1f2f5;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }

  .mr-more-item__icon--on {
    background-color: #3370ff;
  }

  /* 会中聊天未读角标：与 IM 会话列表（conv-row-item 的 chat-item__badge）同一套观感，
     只把尺寸压到 19px 以适配 50px 的宫格图标盒 */
  .mr-more-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    /* 写成半高而不是 50%：多位数时盒子变宽，50% 会画成椭圆 */
    border-radius: 9.5px;
    background-color: #ff4d4f;
    /* 白色细描边：图标盒是浅灰底，没有描边时红点会糊进灰底里 */
    border: 2px solid #ffffff;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mr-more-badge__text {
    font-size: 11px;
    line-height: 13px;
    font-weight: 600;
    color: #ffffff;
  }

  /* 底部操作区里图标只有 30px：角标缩一档，压在图标右上角内侧。
     ★负偏移会被父容器（30px 图标盒）裁掉顶/右边，角标显示不全 —— 必须留在盒内，
       允许盖住图标本身。 */
  .mr-more-badge--sm {
    top: 0;
    right: 0;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    border: 1.5px solid #ffffff;
  }

  .mr-more-badge--sm .mr-more-badge__text {
    font-size: 9px;
    line-height: 11px;
  }

  /* #ifdef APP-IOS */
  /* iOS 上白色数字比 Android 低 1px：margin-bottom 把内容盒抬高半格 ⇒ 视觉上移 1px */
  .mr-more-badge--sm .mr-more-badge__text {
    margin-bottom: 2px;
  }
  /* #endif */

  .mr-more-item__icon--recording {
    background-color: #e5484d;
  }

  /* 弹幕图标视觉重心偏左：方块内右移 2px（relative 偏移，flex 居中下不会被对半分） */
  .mr-more-danmaku-icon {
    position: relative;
    left: 2px;
  }

  .mr-more-item__img {
    width: 22px;
    height: 22px;
  }

  .mr-more-item__label {
    max-width: 78px;
    font-size: 12px;
    line-height: 18px;
    color: #141416;
    text-align: center;
  }

  .mr-more-item__state {
    max-width: 78px;
    margin-top: 2px;
    font-size: 10px;
    line-height: 15px;
    color: #8f8f99;
    text-align: center;
  }
</style>
