<template>
  <view class="provision-connect">
    <custom-nav-bar :title="t('Mobile.Provision.Connect.title')" :show-back="true" :has-safety-zone="true" />

    <view class="provision-connect__body">
      <!-- 连接中 -->
      <view v-if="!isFailed" class="status">
        <view class="radar">
          <view class="radar__ring radar__ring--1"></view>
          <view class="radar__ring radar__ring--2"></view>
          <view class="radar__ring radar__ring--3"></view>
          <view class="radar__core">
            <text class="radar__core-icon">📡</text>
          </view>
        </view>
        <text class="status__text">{{ statusText }}</text>
        <text v-if="deviceName != ''" class="status__device">{{ deviceName }}</text>
      </view>

      <!-- 失败 -->
      <view v-else class="status">
        <view class="status__fail-badge">
          <text class="status__fail-icon">✕</text>
        </view>
        <text class="status__text status__text--fail">{{ t('Mobile.Provision.Connect.failed') }}</text>
        <text class="status__reason">{{ failReason }}</text>
        <view class="status__btn-group">
          <view class="status__btn status__btn--primary" hover-class="status__btn--hover" @tap="onRetry">
            <text class="status__btn-text status__btn-text--primary">{{ t('Mobile.Provision.Connect.retry') }}</text>
          </view>
          <view class="status__btn status__btn--plain" hover-class="status__btn--hover" @tap="onBackToScan">
            <text class="status__btn-text status__btn-text--plain">{{ t('Mobile.Provision.Connect.backToScan') }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { ref, computed } from "vue";
  import { onLoad, onUnload } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { useEspProvisioning, releaseEspProvisioning } from "@/hooks/useEspProvisioning";
  import { getQrPayload, clearProvisionSession } from "@/utils/provisionSession";
  import { EspProvisioningPhaseEnum } from "@/types/enums/espProvisioning";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const controller = useEspProvisioning();
  const phase = controller.phase;
  const error = controller.error;

  const deviceName = ref<string>("");
  const isFailed = ref<boolean>(false);
  let pageActive = true;
  let leavingForward = false;

  const statusText = computed((): string => {
    const p = phase.value;
    if (p == EspProvisioningPhaseEnum.CONNECTING || p == EspProvisioningPhaseEnum.DISCOVERING) {
      return t("Mobile.Provision.Connect.connecting");
    }
    if (p == EspProvisioningPhaseEnum.ESTABLISHING_SESSION || p == EspProvisioningPhaseEnum.READING_DEVICE_INFO) {
      return t("Mobile.Provision.Connect.readingInfo");
    }
    return t("Mobile.Provision.Connect.connecting");
  });

  const failReason = computed((): string => {
    const e = error.value;
    if (e == null) return "";
    return t(e.i18nKey);
  });

  const run = async () => {
    const qr = getQrPayload();
    if (qr == null) {
      isFailed.value = true;
      return;
    }
    deviceName.value = qr.name;
    isFailed.value = false;
    const ok = await controller.selectAndPrepareFromQr();
    if (!pageActive) return;
    if (ok && controller.phase.value == EspProvisioningPhaseEnum.READY) {
      // 连接成功，直接进 WiFi 选择页（replace，不让用户返回到这个 loading 页）
      leavingForward = true;
      uni.redirectTo({
        url: "/subpackages/pages/provision/provision-wifi/provision-wifi",
        fail: () => {
          leavingForward = false;
          isFailed.value = true;
        },
      });
    } else {
      isFailed.value = true;
    }
  };

  const onRetry = () => {
    run();
  };

  const onBackToScan = () => {
    uni.navigateBack();
  };

  onLoad((_options: OnLoadOptions) => {
    pageActive = true;
    run();
  });

  onUnload(() => {
    pageActive = false;
    // redirect 到 WiFi 页时保留 Security 2 会话；用户返回/取消时必须释放扫描与 GATT。
    if (!leavingForward) {
      releaseEspProvisioning();
      clearProvisionSession();
    }
  });
</script>

<style lang="scss" scoped>
  .provision-connect {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;
  }

  .provision-connect__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48rpx 32rpx;
  }

  .status {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .status__fail-badge {
    width: 160rpx;
    height: 160rpx;
    border-radius: 50%;
    background-color: rgba(221, 82, 77, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 32rpx;
  }

  .status__fail-icon {
    font-size: 72rpx;
    font-weight: 600;
    color: #dd524d;
  }

  .status__text {
    font-size: 32rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 16rpx;
  }

  .status__text--fail {
    color: #dd524d;
  }

  .status__device {
    font-size: 26rpx;
    color: #999;
    margin-bottom: 24rpx;
  }

  .status__reason {
    font-size: 26rpx;
    color: #999;
    text-align: center;
    width: 80%;
    margin-bottom: 48rpx;
    line-height: 1.5;
  }

  .status__btn-group {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .status__btn {
    width: 80%;
    padding: 28rpx 0;
    border-radius: 48rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24rpx;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }

  .status__btn--primary {
    background-color: #5147ff;
  }

  .status__btn--plain {
    background-color: #ffffff;
    border: 1rpx solid #5147ff;
  }

  .status__btn--hover {
    opacity: 0.85;
    transform: scale(0.98);
  }

  .status__btn-text {
    font-size: 32rpx;
  }

  .status__btn-text--primary {
    color: #ffffff;
  }

  .status__btn-text--plain {
    color: #5147ff;
  }

  /* 呼吸雷达动效（与 progress 页一致） */
  .radar {
    width: 280rpx;
    height: 280rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 32rpx;
  }

  .radar__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 240rpx;
    height: 240rpx;
    border-radius: 50%;
    border: 2rpx solid rgba(81, 71, 255, 0.5);
    transform: translate(-50%, -50%);
    opacity: 0.25;
  }

  .radar__ring--2 {
    width: 200rpx;
    height: 200rpx;
    opacity: 0.4;
  }

  .radar__ring--3 {
    width: 176rpx;
    height: 176rpx;
    opacity: 0.6;
  }

  .radar__core {
    width: 160rpx;
    height: 160rpx;
    border-radius: 50%;
    background-color: rgba(81, 71, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .radar__core-icon {
    font-size: 72rpx;
  }

</style>
