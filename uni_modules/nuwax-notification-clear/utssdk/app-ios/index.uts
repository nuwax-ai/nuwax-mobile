// nuwax-notification-clear · app-ios
//
// uni-app x 没有「清除通知」的 JS API，实际清理在 NotificationClearBridge.swift
// （UNUserNotificationCenter.removeAllDeliveredNotifications）。
// 清自己的通知不需要通知权限，用户拒绝通知授权时调用同样安全（无通知可清）。

/**
 * 清空本 App 在通知中心 / 锁屏里已投递的全部通知。
 * 不动图标角标：角标口径是 IM 未读总数，与通知条数无关（见 utils/appIconBadge.uts）。
 */
export function clearAppNotifications(): void {
  try {
    NotificationClearBridge.clearAll();
  } catch (e) {
    console.error("[NotificationClear][ios] clearAll fail:", e);
  }
}
