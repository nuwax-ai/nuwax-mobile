<template>
  <view
    class="chat-page"
    @touchstart="handlePageTouchStart($event)"
    @touchend="handlePageTouchEnd($event)"
    @touchcancel="handlePageTouchEnd($event)"
  >
    <!-- 顶部固定区（safety-zone + 标题头 + 子页签）：主体刚体平移时压在其上（z-index + 不透明底） -->
    <view class="chat-top">
    <safety-zone />

    <!-- 顶部：返回 + 会话名（对齐参考设计 50+54 双段头，App 由 safety-zone 垫高；
         分割线由下方子页签行承担，header 恒去线）。
         多选态：左 X 退出、标题换「已选 N 条」（飞书式工具栏替换整条头） -->
    <view v-if="multiSelectMode" class="chat-header chat-header--flush">
      <view class="chat-header__btn" hover-class="chat-header__btn--active" @click="exitMultiSelect">
        <svg-icon name="icon-X" size="36" color="#141416" />
      </view>
      <view class="chat-header__title-wrap">
        <text class="chat-header__title text-ellipsis">{{ tCount("Mobile.Message.multiSelectedCount", multiSelectedIds.length) }}</text>
      </view>
      <view class="chat-header__btn chat-header__btn--ghost" />
    </view>
    <view v-else class="chat-header chat-header--flush">
      <view class="chat-header__btn" hover-class="chat-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="chat-header__title-wrap">
        <text class="chat-header__title text-ellipsis">{{ titleName }}</text>
      </view>
      <!-- 右侧：群聊/团队显示「...」进群设置页（飞书式）；单聊占位保证标题绝对居中 -->
      <view
        v-if="isGroupLike"
        class="chat-header__btn"
        hover-class="chat-header__btn--active"
        @click="handleOpenGroupInfo"
      >
        <svg-icon name="icon-More" size="40" color="#141416" />
      </view>
      <view v-else class="chat-header__btn chat-header__btn--ghost" />
    </view>

    <!-- 子页签行（单聊与群聊共用）：默认选中「消息」展示当前消息页，Pin/文件从右侧进独立页
         （接口均按 convId 过滤，群聊直接可用），资料库占位，行尾放大镜进本会话内搜索 -->
    <chat-subpage-tabs
      class="chat-subpage-tabs"
      :tabs="subpageTabs"
      active="messages"
      :show-search="true"
      @select="handleSubpageSelect"
      @search="handleSearchTap"
    />
    </view>

    <!-- 主体区（消息列表 + 输入坞）：整体随键盘/面板刚体平移 translateY(-liftPx)，
         视口尺寸不变——在底部天然贴底、看历史天然保位（微信/飞书式，无补滚）。
         展开输入面板（fixed 蒙层/浮层）与让位填充带必须留在此包裹外 -->
    <view class="chat-main" :style="chatMainStyle">

    <!-- 消息列滚动区包裹层：仅为「回到底部」浮钮充当 absolute 定位锚（底缘即输入坞顶，
         暂存条/回复条/多选条都在坞内，浮钮天然悬于其上；不包一层则锚到 chat-main 底，
         浮钮会被高度动态变化的输入坞盖住） -->
    <view class="chat-body-wrap">
    <!-- 消息列表（升序渲染；向下滑到顶加载更早） -->
    <scroll-view
      id="im-chat-body"
      class="chat-body"
      direction="vertical"
      :show-scrollbar="false"
      :scroll-into-view="scrollAnchor"
      :upper-threshold="50"
      :lower-threshold="50"
      @scroll="handleChatScroll"
      @scrolltoupper="handleLoadOlder"
      @click="handleBodyTap"
      @touchstart="handlePageTouchStart($event)"
      @touchend="handlePageTouchEnd($event)"
      @touchcancel="handlePageTouchEnd($event)"
    >
      <view v-if="loadingOlder" class="chat-foot">
        <text class="chat-foot__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view v-else-if="listSettled && messages.length > 0 && hasMore != true" class="chat-foot">
        <text class="chat-foot__text">{{ t("Mobile.Message.noMore") }}</text>
      </view>

      <view v-if="loading && messages.length == 0" class="chat-state">
        <text class="chat-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view
        v-else-if="loadFailed && messages.length == 0"
        class="chat-state"
        @click="handleRetry"
      >
        <text class="chat-state__text">{{ t("Mobile.Message.loadFailed") }}</text>
      </view>
      <view v-else-if="messages.length == 0" class="chat-state">
        <text class="chat-state__text">{{ t("Mobile.Message.emptyMessages") }}</text>
      </view>

      <view
        v-for="(msg, idx) in messages"
        :key="msg.msgId"
        :id="'msg-' + msg.msgId"
        class="chat-msg"
        :class="msgRowClass(msg)"
      >
        <!-- 飞书式时间分割线：首条 / 跨天 / 与上一条间隔超 5 分钟出线（渲染时实时
             比较，翻页整表重赋值与确认行原位替换都会重估）；放在本行内部首子位，
             不动 selectAll(".chat-msg") 的按序 rect 映射与 msg-{id} 滚动锚定 -->
        <view v-if="dividerTimeOf(idx).length > 0" class="chat-time-divider">
          <text class="chat-time-divider__text">{{ dividerTimeOf(idx) }}</text>
        </view>
        <!-- 撤回 / 系统行：无正文无图无附件不进气泡（撤回的消息仍在列表里，勿过滤）；
             互动卡片（cardTitle 非空）与合并转发卡片走下方气泡渲染，不落 digest 系统行 -->
        <view
          v-if="msg.bodyText.length == 0 && msg.imageUrl.length == 0 && msg.audioUrl.length == 0 && msg.videoUrl.length == 0 && msg.imageAtts.length == 0 && msg.linkAtts.length == 0 && msg.cardTitle.length == 0 && msg.mergeItems.length == 0 && (msg.revoked || msg.digest.length > 0)"
          class="chat-sys"
        >
          <text class="chat-sys__text">{{ sysText(msg) }}</text>
        </view>
        <view
          v-else-if="msg.bodyText.length > 0 || msg.imageUrl.length > 0 || msg.audioUrl.length > 0 || msg.videoUrl.length > 0 || msg.imageAtts.length > 0 || msg.linkAtts.length > 0 || msg.cardTitle.length > 0 || msg.mergeItems.length > 0"
          class="chat-row"
          :class="rowCls(msg)"
        >
          <!-- 多选态：头像位换勾选框（不可转发的行整行置灰仍可点但只弹提示）；
               勾选圈纵向对齐消息首行——下移量加在 wrap 上（见 chat-ava-wrap--check*，
               加在圈上会溢出 76rpx 定高 wrap 被 Android 裁剪），群聊对方行昵称再下移 -->
          <view
            v-if="multiSelectMode"
            class="chat-ava-wrap"
            :class="isGroupLike && isMine(msg) != true ? 'chat-ava-wrap--check-named' : 'chat-ava-wrap--check'"
            @click="toggleMultiSelect(msg)"
          >
            <view class="chat-check" :class="multiCheckCls(msg)">
              <svg-icon v-if="isMultiSelected(msg)" name="icon-Check" size="28" color="#ffffff" />
            </view>
          </view>
          <view
            v-else
            class="chat-ava-wrap"
            @touchstart.stop="handleAvatarPressStart(msg, $event)"
            @touchmove.stop="handleAvatarPressMove($event)"
            @touchend.stop="handleAvatarPressEnd"
            @touchcancel.stop="handleAvatarPressEnd"
          >
            <!-- 真图裁切容器：app-android <image> 自身 border-radius 对 SVG 渲染路径不生效
                 （位图正常、SVG 方形透出；iOS 原生裁剪恒生效、H5 背景图恒被裁，故仅 Android
                 透方）——消息页 chat-item__avatar-clip 同款 overflow 兜底，与消息列表裁圆一致 -->
            <view
              v-if="avatarSrcOf(msg, avatarResolveTick).length > 0 && avatarFailedOf(msg) != true"
              class="chat-ava-clip"
            >
              <image
                class="chat-ava"
                :src="avatarSrcOf(msg, avatarResolveTick)"
                mode="aspectFill"
                @error="handleAvatarError(msg)"
              />
            </view>
            <view
              v-else
              class="chat-ava"
              :style="{ backgroundImage: avatarGradient(isMine(msg) ? myDisplayName : titleName) }"
            >
              <text class="chat-ava-letter">{{ avatarLetter(isMine(msg) ? myDisplayName : titleName) }}</text>
            </view>
          </view>
          <view class="chat-col" :class="isMine(msg) ? 'chat-col--mine' : ''">
            <!-- 微信式：我方行不显示昵称（头像已在右侧标识发送者），仅对方行展示 -->
            <text v-if="isGroupLike && isMine(msg) != true" class="chat-name text-ellipsis">{{
              msg.senderName.length > 0 ? msg.senderName : titleName
            }}</text>
            <!-- 气泡横排包层：[状态列][图片|气泡]——align-items:flex-end 让发送态/已读
                 icon 沉到气泡左下角；包层只包气泡本体，下方表情行/pin 署名行/时间行
                 仍在气泡列竖排（状态列不再随它们下沉） -->
            <view class="chat-bubwrap">
              <!-- 状态列（微信式：紧挨我方气泡左下角）：发送态 / 已读 icon / 智能体处理标记
                   （仅我发的消息会渲染本列；DOM 前位=渲染在气泡左侧） -->
              <view
                v-if="msg.status == 0 || msg.status == 2 || msg.agentStatus > 0 || readInfoOf(msg, readInfoTick) != null"
                class="chat-tail"
              >
                <text v-if="msg.status == 0" class="chat-status">{{ t("Mobile.Message.sending") }}</text>
                <text v-else-if="msg.status == 2" class="chat-status chat-status--fail">{{ t("Mobile.Message.sendFailed") }}</text>
                <!-- 智能体处理标记（消息衔接了智能体才有明细；WS 3006 帧驱动）：
                     未读=灰空心圈 / 处理中=青色转钟 / 完成=蓝圈蓝勾（DEV-308：蓝=完成，
                     绿=已读回执，勿混）/ 失败=红圈叹号。
                     ★p2p 替代已读环、群聊与已读环并列（PC 拍板⑥=C）——与下方两环各自独立 v-if；
                     agentClockDeg 作参传入建立响应依赖（readInfoTick 同款） -->
                <view v-if="msg.agentStatus > 0" class="chat-agent">
                  <view v-if="msg.agentStatus == 1" class="chat-agent__ring" />
                  <view
                    v-else-if="msg.agentStatus == 2"
                    class="chat-agent__clock"
                    :style="agentClockStyle(agentClockDeg)"
                  >
                    <view class="chat-agent__hand chat-agent__hand--v" />
                    <view class="chat-agent__hand chat-agent__hand--h" />
                  </view>
                  <view v-else-if="msg.agentStatus == 4" class="chat-agent__ring chat-agent__ring--done">
                    <view class="chat-agent__tick" />
                  </view>
                  <view v-else-if="msg.agentStatus == 3" class="chat-agent__ring chat-agent__ring--fail">
                    <text class="chat-agent__bang">!</text>
                  </view>
                </view>
                <!-- 群聊：绿圈（部分已读=圈内扇形饼图按占比动态 / 全员已读=绿勾），无计数文案，
                     点击进「消息阅读状态」页看已读/未读名单。
                     ★已读相关绑定统一把 readInfoTick 作尾参传入：App-Android 方法调用
                     绑定不收集方法体内依赖，须让表达式直接读该 ref 才会随已读数据重算 -->
                <view
                  v-if="readInfoOf(msg, readInfoTick) != null && isGroupLike"
                  class="chat-read"
                  :class="pressedReadCls(msg.msgId)"
                  @click="handleReadTap(msg)"
                  @touchstart="handlePressTouchStart(`r-${msg.msgId}`, $event)"
                  @touchmove="handlePressTouchMove($event)"
                  @touchend="handlePressTouchEnd"
                  @touchcancel="handlePressTouchEnd"
                >
                  <view class="chat-read__ring">
                    <view v-if="readAllOf(msg, readInfoTick)" class="chat-read__tick" />
                    <view v-else class="chat-read__pie chat-read__pie--r">
                      <view
                        v-if="readPieDegOf(msg, readInfoTick) > 0"
                        class="chat-read__fill chat-read__fill--r"
                        :style="pieRightStyleOf(msg, readInfoTick)"
                      />
                    </view>
                    <view v-if="readAllOf(msg, readInfoTick) != true" class="chat-read__pie chat-read__pie--l">
                      <view
                        v-if="readPieDegOf(msg, readInfoTick) > 180"
                        class="chat-read__fill chat-read__fill--l"
                        :style="pieLeftStyleOf(msg, readInfoTick)"
                      />
                    </view>
                  </view>
                </view>
                <!-- 单聊：未读=灰空心圈，已读=绿圈绿勾，点击无动作；
                     有智能体标记时不渲染（agent mark 替代已读环） -->
                <view
                  v-if="readInfoOf(msg, readInfoTick) != null && isGroupLike != true && msg.agentStatus <= 0"
                  class="chat-read"
                >
                  <view v-if="readAllOf(msg, readInfoTick) || readCountOf(msg, readInfoTick) > 0" class="chat-read__ring">
                    <view class="chat-read__tick" />
                  </view>
                  <view v-else class="chat-read__ring chat-read__ring--pending" />
                </view>
              </view>
              <!-- 图片消息：不进气泡，点击全屏放大（微信交互） -->
              <image
                v-if="msg.msgType == 'image' && msg.imageUrl.length > 0"
                class="chat-image"
                :src="msg.imageUrl"
                mode="aspectFill"
                @click="handleImageMsgTap(msg)"
                @error="handleImageRenderError(msg)"
                @touchstart="handleMsgTouchStart(msg, $event)"
                @touchmove="handleMsgTouchMove($event)"
                @touchend="handleMsgTouchEnd"
                @touchcancel="handleMsgTouchEnd"
              />
              <!-- 视频消息：不进气泡（对齐图片）。预载策略——进页/增量合并后自动解析视频地址
                   回填 msg.videoPlayUrl ⇒ 每行常驻原生 <video>（首帧即封面，交给系统播放键
                   点播，不再做任何自动起播：iOS autoplay/延迟补调均不稳，手点是唯一稳定路径）；
                   预载未完成/失败时短暂回落深色占位卡（进度文案 / ▶ 手动重试）。
                   ★videoPlayUrl/videoLoadingId/videoLoadPercent 须在模板表达式直读
                   （App-Android 方法调用绑定不收集方法体内依赖，包进方法 UI 会冻结，readInfoTick 先例）；
                   预载挂载后轻触视频任意位置切换播放/暂停（原生中央播放键只覆盖中心小区域）；
                   全屏走控制条全屏键；退全屏不清播放状态（原位续播）。
                   ★iOS 坑：勿往 <video> 里挂子组件（全屏切换子节点销毁闪退 #22070 未修复） -->
              <view
                v-else-if="(msg.msgType == 'video' || msg.msgType == 'file') && msg.videoUrl.length > 0"
                class="chat-video"
                @click="handleVideoMsgTap(msg)"
                @touchstart="handleMsgTouchStart(msg, $event)"
                @touchmove="handleMsgTouchMove($event)"
                @touchend="handleMsgTouchEnd"
                @touchcancel="handleMsgTouchEnd"
              >
                <video
                  v-if="msg.videoPlayUrl.length > 0"
                  :id="'chatVideoPlayer-' + msg.msgId"
                  class="chat-video__player"
                  :src="msg.videoPlayUrl"
                  :controls="true"
                  :show-fullscreen-btn="true"
                  :title="msg.videoFileName"
                  object-fit="contain"
                  @play="handleVideoPlaying(msg.msgId)"
                  @pause="handleVideoPaused(msg.msgId)"
                  @ended="handleVideoEnded(msg.msgId)"
                  @error="handleVideoError(msg.msgId)"
                  @fullscreenchange="handleVideoFullscreenChange"
                >
                  <!-- #ifdef APP-ANDROID -->
                  <!-- Android 控制条实测无全屏键，官方 video 子组件层补一枚显式入口
                       （全屏态隐藏）；全屏后交互全归原生播放器——点中央播放/暂停、
                       点表面弹原生顶栏（左上角标题+返回）。iOS 勿开——video 子节点
                       创建/销毁在 iOS 闪退（#22070 未修复），iOS 用控制条自带全屏键 -->
                  <view v-if="videoFullscreen != true" class="chat-video__fs" @tap.stop="requestChatVideoFullscreen(msg.msgId)">
                    <view class="chat-video__fs-corner chat-video__fs-corner--tl" />
                    <view class="chat-video__fs-corner chat-video__fs-corner--tr" />
                    <view class="chat-video__fs-corner chat-video__fs-corner--bl" />
                    <view class="chat-video__fs-corner chat-video__fs-corner--br" />
                  </view>
                  <!-- #endif -->
                </video>
                <view v-else class="chat-video__poster">
                  <!-- 预载中只显进度；未预载/失败显 ▶ 可点重试（成功即被 <video> 首帧顶替） -->
                  <text v-if="msg.msgId == videoLoadingId && videoLoadPercent >= 0" class="chat-video__hint">{{ t("Mobile.FileTree.downloading") }} {{ videoLoadPercent }}%</text>
                  <text v-else-if="msg.msgId == videoLoadingId" class="chat-video__hint">{{ t("Mobile.FileTree.downloading") }}</text>
                  <view v-else class="chat-video__play">
                    <!-- ▶ 文字字形各平台字体度量不一，固定 margin 补不齐；PNG 按像素
                         精确光学居中（bbox 中心右移 14/512），三端渲染一致 -->
                    <image class="chat-video__play-icon" src="/static/images/icon-video-play.png" mode="aspectFit" />
                  </view>
                </view>
              </view>
              <view
                v-else
                class="chat-bubble"
                :class="bubbleCls(msg)"
                @click="handleBubbleTap(msg)"
                @touchstart="handleBubbleTouchStart(msg, $event)"
                @touchmove="handleBubbleTouchMove($event)"
                @touchend="handleBubbleTouchEnd"
                @touchcancel="handleBubbleTouchEnd"
              >
                <!-- 引用的原消息：点击进全屏详情，可「定位到聊天位置」。可点元素须自带
                     长按三件套（吞触摸流，气泡根收不到 touchstart，同分段 text） -->
                <view
                  v-if="msg.replyId.length > 0 && quotePreview(msg).length > 0"
                  class="chat-quote"
                  @click="handleQuoteTap(msg)"
                  @touchstart="handleMsgTouchStart(msg, $event)"
                  @touchmove="handleMsgTouchMove($event)"
                  @touchend="handleMsgTouchEnd"
                  @touchcancel="handleMsgTouchEnd"
                >
                  <text
                    v-if="msg.replySenderName.length > 0"
                    class="chat-quote__name text-ellipsis"
                  >{{ msg.replySenderName }}</text>
                  <text
                    class="chat-quote__text text-ellipsis-2"
                  >{{ quotePreview(msg) }}</text>
                </view>
                <!-- 语音消息（msgType=audio）：声波条 + 时长，点气泡播放/停止（页面级单一
                     播放实例，播放中声波跳动换主题色；时长 body 无则首播后回填） -->
                <view
                  v-if="msg.msgType == 'audio' && msg.audioUrl.length > 0"
                  class="chat-voice"
                  :class="(msg.msgId == playingAudioId ? 'chat-voice--playing ' : '') + (isMine(msg) ? 'chat-voice--mine' : '')"
                >
                  <view class="chat-voice__bar" :style="{ height: voiceBarH(msg, 0, voiceTick) + 'px' }" />
                  <view class="chat-voice__bar" :style="{ height: voiceBarH(msg, 1, voiceTick) + 'px' }" />
                  <view class="chat-voice__bar" :style="{ height: voiceBarH(msg, 2, voiceTick) + 'px' }" />
                  <view class="chat-voice__bar" :style="{ height: voiceBarH(msg, 3, voiceTick) + 'px' }" />
                  <text v-if="msg.audioDuration > 0" class="chat-voice__dur">{{ audioDurationLabelOf(msg) }}</text>
                </view>
                <!-- 合并转发卡片（msgType=merge_forward）：标题 + 前 2 条预览 + 「共 N 条」；
                     点卡片进聊天记录详情页看全量（openMergeDetail，载荷经 session 暂存跳转） -->
                <view v-if="msg.msgType == 'merge_forward' && msg.mergeItems.length > 0" class="chat-merge">
                  <text class="chat-merge__title text-ellipsis">{{ msg.mergeTitle.length > 0 ? msg.mergeTitle : t("Mobile.Message.mergeForwardFallbackTitle") }}</text>
                  <view
                    v-for="(mi, mIdx) in msg.mergeItems"
                    :key="mIdx"
                    class="chat-merge__item"
                  >
                    <text class="chat-merge__name text-ellipsis">{{ mi.senderName }}</text>
                    <text class="chat-merge__text text-ellipsis">{{ mi.preview }}</text>
                  </view>
                  <text class="chat-merge__count">{{ tCount("Mobile.Message.mergeForwardCount", msg.mergeTotal) }}</text>
                </view>
                <!-- 互动卡片（msgType=card）：标题/正文/字段行 + 动作按钮（入群审核的同意/拒绝）。
                     按钮形态由服务端回填的 state 决定（判据在 cardActionStateOf，对齐 PC lib/card.ts）；
                     body.actionUrl 渲染「查看详情」跳转链接（对齐 PC InteractionCard 的 im-card-link）；
                     无 actions 且无跳转链接的展示卡补一句「无需操作」，避免用户去点不可点的卡片本身 -->
                <view v-else-if="msg.msgType == 'card' && msg.cardTitle.length > 0" class="chat-card">
                  <text class="chat-card__title">{{ msg.cardTitle }}</text>
                  <text v-if="msg.cardDesc.length > 0" class="chat-card__desc">{{ msg.cardDesc }}</text>
                  <view
                    v-for="(field, fi) in msg.cardFields"
                    :key="fi"
                    class="chat-card__field"
                  >
                    <text v-if="field.label.length > 0" class="chat-card__field-label">{{ field.label }}</text>
                    <text class="chat-card__field-value">{{ field.value }}</text>
                  </view>
                  <view v-if="msg.cardActions.length > 0" class="chat-card__actions">
                    <view
                      v-for="action in cardVisibleActions(msg)"
                      :key="action.key"
                      :class="cardBtnClass(msg, action)"
                      @click="handleCardActionTap(msg, action)"
                      @touchstart="handlePressTouchStart(cardActionClickable(action) ? `c-${msg.msgId}-${action.key}` : '', $event)"
                      @touchmove="handlePressTouchMove($event)"
                      @touchend="handlePressTouchEnd"
                      @touchcancel="handlePressTouchEnd"
                    >
                      <text :class="cardBtnTextClass(action)">{{ cardActionText(action) }}</text>
                    </view>
                  </view>
                  <!-- 跳转链接（actionUrl）：展示卡底部「查看详情」蓝字，点击打开页面（PC 同款位置）。
                       可点 text 须自带长按三件套（同引用条/分段 text） -->
                  <text
                    v-if="msg.cardActionUrl.length > 0"
                    class="chat-card__link"
                    @click="handleCardLinkTap(msg)"
                    @touchstart="handleMsgTouchStart(msg, $event)"
                    @touchmove="handleMsgTouchMove($event)"
                    @touchend="handleMsgTouchEnd"
                    @touchcancel="handleMsgTouchEnd"
                  >{{ t("Mobile.Message.cardViewDetail") }}</text>
                  <text
                    v-if="msg.cardActions.length == 0 && msg.cardActionUrl.length == 0"
                    class="chat-card__hint"
                  >{{ t("Mobile.Message.cardNoActionHint") }}</text>
                </view>
                <!-- 富文本正文（Markdown 标记 + @提及高亮 + [标题](url) 链接，嵌套 text 分段渲染）；
                     纯文本消息 bodyFormatted=false 走原路径（保留纯链接点击等零回归）。
                     分段 text 自带长按三件套：链接/@提及段绑定 @click 是可点元素、会吞掉
                     触摸流，气泡根收不到 touchstart，长按面板必须在段上直接锚定（同下方
                     纯文本分支；与气泡根幂等——定时器重置重挂） -->
                <view v-else-if="msg.bodyFormatted == true" class="chat-rich">
                  <view
                    v-for="(ln, li) in msg.lines"
                    :key="li"
                    :class="lineClassOf(ln, isMine(msg))"
                  >
                    <text
                      v-if="ln.kind == 'code'"
                      :class="isMine(msg) ? 'chat-md chat-md--block chat-md--block-mine' : 'chat-md chat-md--block'"
                    >{{ ln.text }}<text
                      v-if="msg.edited && li == msg.lines.length - 1 && msg.status == 1"
                      class="chat-edited-inline"
                    >{{ t("Mobile.Message.msgEditedTag") }}</text></text>
                    <text v-else class="chat-bubble__text" :class="textClassOf(msg)">
                      <text
                        v-for="(sg, si) in ln.segs"
                        :key="si"
                        :class="segClassOf(sg, isMine(msg), ln.kind)"
                        @click.stop="handleSegTap(msg, sg)"
                        @touchstart="handleMsgTouchStart(msg, $event)"
                        @touchmove="handleMsgTouchMove($event)"
                        @touchend="handleMsgTouchEnd"
                        @touchcancel="handleMsgTouchEnd"
                      >{{ sg.text }}</text>
                      <text
                        v-if="msg.edited && li == msg.lines.length - 1 && msg.status == 1"
                        class="chat-edited-inline"
                      >{{ t("Mobile.Message.msgEditedTag") }}</text>
                    </text>
                  </view>
                </view>
                <!-- 纯文本/纯链接文案：自带长按三件套（链接文案上长按同样拉底部面板，
                     不依赖 text→气泡根的事件冒泡；与气泡根处理幂等——定时器重置重挂） -->
                <text
                  v-else-if="msg.bodyText.length > 0"
                  class="chat-bubble__text"
                  :class="textClassOf(msg)"
                  @click="handleLinkTextTap(msg)"
                  @touchstart="handleMsgTouchStart(msg, $event)"
                  @touchmove="handleMsgTouchMove($event)"
                  @touchend="handleMsgTouchEnd"
                  @touchcancel="handleMsgTouchEnd"
                >{{ msg.bodyText }}<text
                  v-if="msg.edited && msg.status == 1"
                  class="chat-edited-inline"
                >{{ t("Mobile.Message.msgEditedTag") }}</text></text>
                <!-- rich_text 图片附件：缩略图，点击全屏放大 -->
                <image
                  v-for="att in msg.imageAtts"
                  :key="att.url"
                  class="chat-image chat-image--att"
                  :src="att.url"
                  mode="aspectFill"
                  @click="handleAttImageTap(msg, att)"
                  @error="handleAttImageRenderError(att)"
                />
                <!-- rich_text 内嵌视频附件：气泡内联播放（播放器/预载/全屏与单视频消息
                     同管线，videoPlayUrl 由 preloadChatVideos 回填；iOS 坑同外层：勿往
                     <video> 挂子组件（全屏切换闪退 #22070），Android 全屏兜底键除外） -->
                <view
                  v-if="msg.videoUrl.length > 0"
                  class="chat-video chat-video--in-bubble"
                  @click="handleVideoMsgTap(msg)"
                  @touchstart="handleMsgTouchStart(msg, $event)"
                  @touchmove="handleMsgTouchMove($event)"
                  @touchend="handleMsgTouchEnd"
                  @touchcancel="handleMsgTouchEnd"
                >
                  <video
                    v-if="msg.videoPlayUrl.length > 0"
                    :id="'chatVideoPlayer-' + msg.msgId"
                    class="chat-video__player"
                    :src="msg.videoPlayUrl"
                    :controls="true"
                    :show-fullscreen-btn="true"
                    :title="msg.videoFileName"
                    object-fit="contain"
                    @ended="handleVideoEnded(msg.msgId)"
                    @error="handleVideoError(msg.msgId)"
                    @fullscreenchange="handleVideoFullscreenChange"
                  >
                    <!-- #ifdef APP-ANDROID -->
                    <view v-if="videoFullscreen != true" class="chat-video__fs" @tap.stop="requestChatVideoFullscreen(msg.msgId)">
                      <view class="chat-video__fs-corner chat-video__fs-corner--tl" />
                      <view class="chat-video__fs-corner chat-video__fs-corner--tr" />
                      <view class="chat-video__fs-corner chat-video__fs-corner--bl" />
                      <view class="chat-video__fs-corner chat-video__fs-corner--br" />
                    </view>
                    <!-- #endif -->
                  </video>
                  <view v-else class="chat-video__poster">
                    <text v-if="msg.msgId == videoLoadingId && videoLoadPercent >= 0" class="chat-video__hint">{{ t("Mobile.FileTree.downloading") }} {{ videoLoadPercent }}%</text>
                    <text v-else-if="msg.msgId == videoLoadingId" class="chat-video__hint">{{ t("Mobile.FileTree.downloading") }}</text>
                    <view v-else class="chat-video__play">
                      <image class="chat-video__play-icon" src="/static/images/icon-video-play.png" mode="aspectFit" />
                    </view>
                  </view>
                </view>
                <!-- 文件 / 链接附件：md 文档画文档卡片（点开按后缀规则直接下载），
                     其余展示文案点击打开链接（微信交互）。卡片自带长按三件套
                     （同图片/视频消息）：长按拉底部面板不再依赖冒泡到气泡根，
                     抬手补发的 click 由 handleLinkAttTap 的 rowPressFired 吞掉 -->
                <view
                  v-for="att in msg.linkAtts"
                  :key="att.url"
                  class="chat-link"
                  @click="handleLinkAttTap(att)"
                  @touchstart="handleMsgTouchStart(msg, $event)"
                  @touchmove="handleMsgTouchMove($event)"
                  @touchend="handleMsgTouchEnd"
                  @touchcancel="handleMsgTouchEnd"
                >
                  <view class="chat-link__icon-wrap">
                    <image
                      v-if="isMarkdownAtt(att)"
                      class="chat-link__md-icon"
                      :src="mdAttIconSrc"
                      mode="aspectFit"
                    />
                    <svg-icon v-else name="icon-Link" size="32" color="#5147ff" />
                  </view>
                  <view class="chat-link__col">
                    <text class="chat-link__title text-ellipsis">{{ isMarkdownAtt(att) ? mdAttTitle(att) : (att.fileName.length > 0 ? att.fileName : att.url) }}</text>
                    <text class="chat-link__host text-ellipsis">{{ hostOf(att.url) }}</text>
                  </view>
                </view>
                <!-- 表情回复行（气泡内容区最末一行）：按 emoji 聚合，格式 emoji｜用户a 用户b，
                     不同 emoji 组之间留间距；我加过的组描边高亮。点组 = toggle 我的该 emoji
                     （我加过则取消；click.stop 避免冒泡触发气泡点按的时间显示） -->
                <view v-if="reactionChipsOf(msg).length > 0" class="chat-reactions">
                  <view
                    v-for="chip in reactionChipsOf(msg)"
                    :key="chip.emoji"
                    class="chat-reaction"
                    :class="chip.mine ? 'chat-reaction--mine' : ''"
                    hover-class="chat-reaction--hover"
                    @tap.stop="handleReactionChipTap(msg, chip)"
                  >
                    <text class="chat-reaction__face">{{ chip.emoji }}</text>
                    <view class="chat-reaction__divider" />
                    <text
                      class="chat-reaction__names text-ellipsis"
                      :class="chip.mine ? 'chat-reaction__names--mine' : ''"
                    >{{ chip.namesText }}</text>
                  </view>
                </view>
              </view>
            </view>
            <!-- 图片/视频消息无气泡：表情回复行挂在媒体正下方（同样式，条件对齐上方 image/video 分支） -->
            <view
              v-if="((msg.msgType == 'image' && msg.imageUrl.length > 0) || (msg.msgType == 'video' && msg.videoUrl.length > 0)) && reactionChipsOf(msg).length > 0"
              class="chat-reactions"
            >
              <view
                v-for="chip in reactionChipsOf(msg)"
                :key="chip.emoji"
                class="chat-reaction"
                :class="chip.mine ? 'chat-reaction--mine' : ''"
                hover-class="chat-reaction--hover"
                @tap.stop="handleReactionChipTap(msg, chip)"
              >
                <text class="chat-reaction__face">{{ chip.emoji }}</text>
                <view class="chat-reaction__divider" />
                <text
                  class="chat-reaction__names text-ellipsis"
                  :class="chip.mine ? 'chat-reaction__names--mine' : ''"
                >{{ chip.namesText }}</text>
              </view>
            </view>
            <!-- Pin 署名行：被 pin 的消息在文案下加 pin icon + 操作人署名（对所有成员可见） -->
            <view v-if="pinInfoOf(msg) != null" class="chat-pininfo">
              <image class="chat-pininfo__icon" src="/static/images/icon-msg-pin.png" mode="aspectFit" />
              <text class="chat-pininfo__text">{{ pinInfoTextOf(msg) }}</text>
            </view>
            <!-- 点消息内容展开的时间行（微信同款）：点气泡切换显示/隐藏这条消息的发送时间 -->
            <text v-if="timeRevealedId == msg.msgId" class="chat-msgtime">{{ formatMsgTime(msg.sendTime) }}</text>
          </view>
        </view>
      </view>

      <!-- 底部锚点：scroll-into-view 定位用 -->
      <view id="chat-bottom" class="chat-bottom-anchor" />
    </scroll-view>

    <!-- 「回到底部」浮钮：滚上去看历史时出现（白圆底双下箭头），点击滚到最新并消失；
         不设 z-index——底部面板槽/展开蒙层按 DOM 序与层级自然盖住；多选态隐藏 -->
    <view
      v-if="showJumpLatest && multiSelectMode != true"
      class="chat-jump-latest"
      hover-class="chat-jump-latest--active"
      @click="handleJumpLatest"
    >
      <view class="chat-jump-latest__arrows">
        <view class="chat-jump-latest__arrow">
          <svg-icon name="icon-a-Chevrondown" size="30" color="#6b6878" />
        </view>
        <view class="chat-jump-latest__arrow chat-jump-latest__arrow--lower">
          <svg-icon name="icon-a-Chevrondown" size="30" color="#6b6878" />
        </view>
      </view>
    </view>
    </view>

    <!-- 多选态底部工具条：取消 + 逐条转发 + 合并转发（>50 条禁用合并，服务端上限 50 items） -->
    <view v-if="multiSelectMode" class="chat-multibar" :style="{ paddingBottom: 6 + safeBottomPx + 'px' }">
      <view class="chat-multibar__btn chat-multibar__btn--ghost" hover-class="chat-multibar__btn--active" @click="exitMultiSelect">
        <text class="chat-multibar__btn-text chat-multibar__btn-text--ghost">{{ t("Mobile.Message.multiCancel") }}</text>
      </view>
      <view
        class="chat-multibar__btn"
        :class="multiSelectedIds.length > 0 && multiSelectedIds.length <= MULTI_MERGE_MAX ? '' : 'chat-multibar__btn--disabled'"
        hover-class="chat-multibar__btn--active"
        @click="handleMultiForward('merge')"
      >
        <text class="chat-multibar__btn-text">{{ t("Mobile.Message.multiMergeForward") }}</text>
      </view>
      <view
        class="chat-multibar__btn"
        :class="multiSelectedIds.length > 0 ? '' : 'chat-multibar__btn--disabled'"
        hover-class="chat-multibar__btn--active"
        @click="handleMultiForward('single')"
      >
        <text class="chat-multibar__btn-text">{{ t("Mobile.Message.multiOneByOneForward") }}</text>
      </view>
    </view>

    <!-- 编辑状态条；回复预览显示在输入框内部。 -->
    <view v-if="editTarget != null && multiSelectMode != true" class="chat-compose-bar">
      <view class="chat-compose-bar__accent" :class="editTarget != null ? 'chat-compose-bar__accent--edit' : ''" />
      <view class="chat-compose-bar__main">
        <text class="chat-compose-bar__label">{{
          editTarget != null ? t("Mobile.Message.editingBarLabel") : t("Mobile.Message.quoteBarLabel")
        }}</text>
        <text class="chat-compose-bar__text text-ellipsis">{{ composePreviewText }}</text>
      </view>
      <view class="chat-compose-bar__close" hover-class="chat-compose-bar__close--active" @click="handleComposeBarClose">
        <svg-icon name="icon-X" size="32" color="#8a8a8a" />
      </view>
    </view>

    <!-- 底部输入坞（飞书消息对话框布局）：语音/键盘切换 + 输入框 + 表情 + 加号/发送
         （多选态卸载，由多选工具条接管底部） -->
    <view v-if="multiSelectMode != true" class="chat-dock-wrap" :style="{ paddingBottom: dockPadBottomPx + 'px' }">
      <!-- 输入坞第一行：输入框（语音条互斥）+ 发送（有内容时）+ 展开长文编辑 -->
      <view class="chat-dock">
        <!-- 待发图片暂存条（微信同款）：选图/拍照后先暂存，可与文案合并发送；
             点缩略图预览、右上角删除；语音/文字两态都展示（dock 首子节点） -->
        <view v-if="stagedImages.length > 0 && !convDisbanded" class="chat-staged">
          <scroll-view class="chat-staged__scroll" direction="horizontal" :show-scrollbar="false">
            <view class="chat-staged__row" :style="stagedRowStyle">
              <view class="chat-staged__item" v-for="img in stagedImages" :key="img.id">
                <image
                  class="chat-staged__thumb"
                  :src="img.localPath"
                  mode="aspectFill"
                  @click="handleStagedImageTap(img.localPath)"
                />
                <view class="chat-staged__remove" hover-class="chat-staged__remove--active" @click.stop="removeStagedImage(img.id)">
                  <image
                    class="chat-staged__remove-icon"
                    src="/static/images/icon-a-Xcircle-fill.png"
                    mode="aspectFit"
                  />
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
        <!-- 语音模式回复提示条（飞书式）：按住说话行上方展示当前引用，
             与输入框内引用条互斥呈现——切语音/文字模式各自展示对应样式 -->
        <view
          v-if="voiceMode && quoteTarget != null && !convDisbanded"
          class="chat-reply-preview chat-reply-preview--voice"
        >
          <view
            class="chat-reply-preview__close"
            hover-class="chat-compose-bar__close--active"
            @click="handleComposeBarClose"
          >
            <svg-icon name="icon-X" size="24" color="#8a8a8a" />
          </view>
          <view class="chat-reply-preview__divider" />
          <text class="chat-reply-preview__text text-ellipsis">{{ replyPreviewText }}</text>
        </view>
        <view class="chat-dock__main">
          <!-- 群已解散：整个输入坞第一行折叠为灰条（飞书同款；详情 status=2 或发送被 IM_20105 拒） -->
          <view v-if="convDisbanded" class="chat-input-box chat-input-box--disbanded">
            <text class="chat-input-box__disbanded-text">{{ t("Mobile.Message.groupDisbandedSendTip") }}</text>
          </view>
          <!-- 语音模式：左侧键盘键（点击回输入框）+ 按住说话（松开识别直接发送） -->
          <view
            v-if="voiceMode && !convDisbanded"
            class="chat-dock__kb"
            hover-class="chat-dock__kb--active"
            @click="toggleVoiceMode"
          >
            <svg-icon name="icon-keyboard" size="38" color="#5a5867" />
          </view>
          <voice-recorder-button
            v-if="voiceMode && !convDisbanded"
            class="chat-dock__voice"
            :duration="600000"
            :enable-asr="true"
            :live-asr="true"
            @onRecordStop="handleVoiceStop"
            @onLiveProcessing="handleVoiceProcessing"
            @onLiveResult="handleVoiceLiveResult"
            @onError="handleVoiceError"
            @onVisualActive="handleVoiceVisualActive"
            @onCancelZoneChange="handleVoiceCancelZone"
          />
          <!-- 输入 pill：textarea + 框内右侧展开键（飞书同款布局）。
               回车不发消息（confirm-type 缺省 done）：发送统一走第二行右端蓝圆纸飞机 -->
          <view
            v-if="!voiceMode && !convDisbanded"
            class="chat-input-box"
            :class="quoteTarget != null ? 'chat-input-box--reply' : ''"
            :style="quoteTarget == null ? chatInputBoxHeightStyle : ''"
          >
            <view v-if="quoteTarget != null" class="chat-reply-preview">
              <view
                class="chat-reply-preview__close"
                hover-class="chat-compose-bar__close--active"
                @click="handleComposeBarClose"
              >
                <svg-icon name="icon-X" size="24" color="#8a8a8a" />
              </view>
              <view class="chat-reply-preview__divider" />
              <text class="chat-reply-preview__text text-ellipsis">{{ replyPreviewText }}</text>
            </view>
            <view class="chat-input-content">
              <textarea
                id="chat-input-textarea"
                class="chat-input"
                v-model="inputText"
                :maxlength="2000"
                :auto-height="chatInputAutoHeight"
                :placeholder="t('Mobile.Message.inputPlaceholder')"
                placeholder-style="color:#b0aebc;line-height:48rpx;"
                :style="chatInputHeightStyle"
                :show-confirm-bar="false"
                :disable-default-padding="true"
                :adjust-position="false"
                :hold-keyboard="true"
                :focus="focusRequest"
                @focus="handleInputFocus"
                @blur="handleInputBlur"
                @input="handleInputTyped"
              />
              <!-- 展开键：从底部拉起展开输入面板（飞书式大输入区 + 工具行），对角双箭头 ⤢ 贴输入框右侧。
                   单行垂直居中对齐当前行；多行随框增高钉在输入框右上角（第一行右侧） -->
              <view
                class="chat-input__expand"
                :class="{ 'chat-input__expand--top': chatInputMultiLine }"
                hover-class="chat-input__expand--active"
                @click="toggleExpandPanel"
              >
                <image class="chat-expand-glyph" src="/static/images/icon-expand.png" mode="aspectFit" />
              </view>
            </view>
          </view>
        </view>
        <!-- 格式横条（Aa 开，与系统键盘共存；展开时工具行让位；展开面板 Aa 格式行同款）：
             左端蓝箭头收起 / B I S U 样式态（点击切背景不插标记，发送时按态包装）
             / 有序 1·2·3（当前行序号 toggle）/ 无序圆点（当前行圆点 toggle）
             / 右端蓝圆发送——左右蓝键 + 六键 space-between 全行均匀分布 -->
        <view v-if="panelMode == 'font'" class="chat-fontbar">
          <view class="chat-fontbar__down" hover-class="chat-fontbar__down--active" @click="collapseFontBar">
            <svg-icon name="icon-a-Chevrondown" size="28" color="#ffffff" />
          </view>
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': markBold }"
            hover-class="chat-fontbar__btn--active"
            @click="handleMarkToggle('bold')"
          >
            <text class="chat-fontbar__glyph chat-fontbar__glyph--b">B</text>
          </view>
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': markItalic }"
            hover-class="chat-fontbar__btn--active"
            @click="handleMarkToggle('italic')"
          >
            <text class="chat-fontbar__glyph chat-fontbar__glyph--i">I</text>
          </view>
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': markStrike }"
            hover-class="chat-fontbar__btn--active"
            @click="handleMarkToggle('strike')"
          >
            <text class="chat-fontbar__glyph chat-fontbar__glyph--s">S</text>
          </view>
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': markUnderline }"
            hover-class="chat-fontbar__btn--active"
            @click="handleMarkToggle('underline')"
          >
            <text class="chat-fontbar__glyph chat-fontbar__glyph--u">U</text>
          </view>
          <!-- 有序列表（1 2 3 数字行，当前行序号 toggle；与无序互斥） -->
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': listKind == 'ol' }"
            hover-class="chat-fontbar__btn--active"
            @click="handleListTap('ol')"
          >
            <view class="chat-ex-li">
              <view class="chat-ex-li-row">
                <text class="chat-ex-ol-num">1</text>
                <view class="chat-ex-li-line" />
              </view>
              <view class="chat-ex-li-row">
                <text class="chat-ex-ol-num">2</text>
                <view class="chat-ex-li-line" />
              </view>
              <view class="chat-ex-li-row">
                <text class="chat-ex-ol-num">3</text>
                <view class="chat-ex-li-line" />
              </view>
            </view>
          </view>
          <!-- 无序列表（圆点+线，当前行圆点 toggle；与有序互斥） -->
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': listKind == 'ul' }"
            hover-class="chat-fontbar__btn--active"
            @click="handleListTap('ul')"
          >
            <view class="chat-ex-li">
              <view class="chat-ex-li-row">
                <view class="chat-ex-li-dot" />
                <view class="chat-ex-li-line" />
              </view>
              <view class="chat-ex-li-row">
                <view class="chat-ex-li-dot" />
                <view class="chat-ex-li-line" />
              </view>
              <view class="chat-ex-li-row">
                <view class="chat-ex-li-dot" />
                <view class="chat-ex-li-line" />
              </view>
            </view>
          </view>
          <!-- 发送键：横条右端同款蓝圆纸飞机（格式横条占位时保持可发送） -->
          <view
            class="chat-dock-send"
            :class="{ 'chat-dock-send--ready': canSend }"
            hover-class="chat-dock-send--active"
            @click="handleSend"
          >
            <view class="chat-send-glyphfix">
              <svg-icon name="icon-send" size="36" :color="canSend ? '#ffffff' : '#b0aebc'" />
            </view>
          </view>
        </view>
        <!-- 第二行工具键（飞书六键等距）：表情 / @成员 / 语音切换 / 相册 / 字体 / 加号（横条展开时让位） -->
        <view v-if="panelMode != 'font'" class="chat-tools">
          <!-- 表情键：无选中背景（仅图标高亮），点击恒开面板不切换。
               ★App 端 icon-face 走 PNG 降级（iconfont 字形损坏），svg-icon 的
               tint-color 换色不跨端可靠（蓝激活态出不来）——改直接 <image>
               双色 PNG 按面板态切 src，基色/激活色烤进图（H5/小程序同路径渲染） -->
          <view
            class="chat-tool"
            hover-class="chat-tool--active"
            @click="toggleEmojiPanel"
            @touchstart="pressTool('face')"
            @touchend="releaseTool"
            @touchcancel="releaseTool"
          >
            <image
              class="chat-tool__face"
              :src="panelMode == 'emoji' || toolPressedKey == 'face' ? '/static/images/icon-face-on.png' : '/static/images/icon-face.png'"
              mode="aspectFit"
            />
          </view>
          <!-- @键：无选中背景（仅字符高亮），点击进全屏成员选择页（飞书式） -->
          <view
            class="chat-tool"
            hover-class="chat-tool--active"
            @click="handleMentionKeyTap"
            @touchstart="pressTool('at')"
            @touchend="releaseTool"
            @touchcancel="releaseTool"
          >
            <text
              class="chat-tool__text"
              :class="{ 'chat-tool__text--on': toolPressedKey == 'at' }"
            >@</text>
          </view>
          <!-- 话筒键：恒 Mic 图标、无激活态（语音态的退出入口在按住说话条左侧的键盘键） -->
          <view
            class="chat-tool"
            hover-class="chat-tool--active"
            @click="toggleVoiceMode"
            @touchstart="pressTool('mic')"
            @touchend="releaseTool"
            @touchcancel="releaseTool"
          >
            <svg-icon
              name="icon-Mic"
              size="48"
              :color="toolPressedKey == 'mic' ? '#337eff' : '#7a7887'"
            />
          </view>
          <view
            class="chat-tool"
            hover-class="chat-tool--active"
            @click="handleImageToolTap"
            @touchstart="pressTool('image')"
            @touchend="releaseTool"
            @touchcancel="releaseTool"
          >
            <svg-icon
              name="icon-Image"
              size="48"
              :color="toolPressedKey == 'image' ? '#337eff' : '#7a7887'"
            />
          </view>
          <!-- Aa 键：无选中背景（仅字符高亮），开格式横条并保持系统键盘 -->
          <view
            class="chat-tool"
            hover-class="chat-tool--active"
            @click="handleAaKeyTap"
            @touchstart="pressTool('aa')"
            @touchend="releaseTool"
            @touchcancel="releaseTool"
          >
            <text
              class="chat-tool__text chat-tool__text--aa"
              :class="{ 'chat-tool__text--on': panelMode == 'font' || toolPressedKey == 'aa' }"
            >Aa</text>
          </view>
          <!-- 加号键：圆环+加号自绘 icon（开面板时无背景，圆环与加号变蓝、加号旋 45° 成 X）。
               ★绑定用三元式而非对象字面量：iOS 上多层嵌套 view 的对象字面量 :class
               在类移除时不回落（圈中叉不还原，Android 正常），三元式为全项目已验证写法 -->
          <view
            class="chat-tool"
            @click="togglePlusPanel"
            @touchstart="pressTool('plus')"
            @touchend="releaseTool"
            @touchcancel="releaseTool"
          >
            <view
              class="chat-plus-key"
              :class="panelMode == 'plus' || toolPressedKey == 'plus' ? 'chat-plus-key--on' : ''"
            >
              <view
                class="chat-plus-key__glyph"
                :class="panelMode == 'plus' ? 'chat-plus-key__glyph--on' : ''"
              >
                <view
                  class="chat-plus-key__h"
                  :class="panelMode == 'plus' || toolPressedKey == 'plus' ? 'chat-plus-key__h--on' : ''"
                />
                <view
                  class="chat-plus-key__v"
                  :class="panelMode == 'plus' || toolPressedKey == 'plus' ? 'chat-plus-key__v--on' : ''"
                />
              </view>
            </view>
          </view>
          <!-- 发送键：与功能键等分同行（flex:1 槽位，72rpx 蓝圆纸飞机槽内居中；
               无内容灰置 / 有内容蓝亮） -->
          <view class="chat-tools__sendslot">
            <view
              class="chat-dock-send"
              :class="{ 'chat-dock-send--ready': canSend }"
              hover-class="chat-dock-send--active"
              @click="handleSend"
            >
              <view class="chat-send-glyphfix">
                <svg-icon name="icon-send" size="36" :color="canSend ? '#ffffff' : '#b0aebc'" />
              </view>
            </view>
          </view>
        </view>
      </view>

    </view>

    </view>

    <!-- 让位填充带（与 liftPx 同高，贴屏底 absolute 不占布局）：键盘态以 dock 同色灰填平移与
         键盘动画的失配缝；面板态承载加号/表情面板——高度过渡与主体平移同曲线同拍，
         面板即随平移从下拉出/收回（不依赖越界/百分比定位，iOS 稳定） -->
    <view class="chat-lift-zone" :style="{ height: liftPx + 'px' }">
      <!-- 加号面板：视频 / 文件（灰底白磁贴，参考设计图；
           发送链路与 PC 端单附件同契约：上传后按 mime 定类型发出） -->
      <view
        v-if="panelMode == 'plus' && multiSelectMode != true"
        class="chat-plus-panel"
        :style="{ marginBottom: 6 + safeBottomPx + 'px' }"
      >
        <view class="chat-plus-grid">
          <view class="chat-plus-item" hover-class="chat-plus-item--active" @click="handlePickVideo">
            <view class="chat-plus-item__icon">
              <svg-icon name="icon-VideoCamera" size="52" color="#337eff" />
            </view>
            <text class="chat-plus-item__text">{{ t("Mobile.Chat.video") }}</text>
          </view>
          <!-- 文件入口：H5/Android/鸿蒙走 uni.chooseFile（kotlin/arkts 已实现）；iOS 的
               chooseFile 无 Swift 实现，走 nuwax-ios-file-picker 插件的 UIDocumentPicker（需自定义基座） -->
          <view class="chat-plus-item" hover-class="chat-plus-item--active" @click="handlePickFile">
            <view class="chat-plus-item__icon">
              <svg-icon name="icon-Folder" size="52" color="#e0942e" />
            </view>
            <text class="chat-plus-item__text">{{ t("Mobile.Chat.file") }}</text>
          </view>
        </view>
      </view>

      <!-- 表情面板：常驻预渲染（非鸿蒙），槽位高 0↔卡片高+间距 同曲线过渡拉出/收回
           （开=panelMode 'emoji'）；鸿蒙 emojiPanelAlwaysRender=false 退化为 v-if 直出直收。
           槽位折叠=非激活态不占位：键盘态不露内容、加号态不顶加号面板 -->
      <view
        v-if="(emojiPanelAlwaysRender || panelMode == 'emoji') && multiSelectMode != true"
        class="chat-emoji-slot"
        :style="{ height: panelMode == 'emoji' ? emojiSlotOpenPx + 'px' : '0px' }"
      >
        <view class="chat-panel" :style="{ marginBottom: 6 + safeBottomPx + 'px' }">
        <scroll-view class="chat-emoji-scroll" direction="vertical" :show-scrollbar="false">
          <view class="chat-emoji-grid">
            <!-- 常用行（仅真实历史，空则整段不渲染；点选走 handleEmojiTap 同款记账链路） -->
            <view v-if="panelRecentEmojis.length > 0" class="chat-emoji-recent">
              <text class="chat-emoji-recent__title">{{ t("Mobile.Message.recentEmojis") }}</text>
              <view class="chat-emoji-row">
                <view
                  v-for="emo in panelRecentEmojis"
                  :key="emo"
                  class="chat-emoji-cell"
                  hover-class="chat-emoji-cell--active"
                  @click="handleEmojiTap(emo)"
                >
                  <text class="chat-emoji-item">{{ emo }}</text>
                </view>
              </view>
            </view>
            <view v-for="(row, ri) in EMOJI_ROWS" :key="ri" class="chat-emoji-row">
              <view
                v-for="emo in row"
                :key="emo"
                class="chat-emoji-cell"
                hover-class="chat-emoji-cell--active"
                @click="handleEmojiTap(emo)"
              >
                <text class="chat-emoji-item">{{ emo }}</text>
              </view>
            </view>
          </view>
        </scroll-view>
        <!-- 面板操作行：右下角 X 形删除键（发送走输入坞第二行右端发送键，面板内不再重复） -->
        <view class="chat-emoji-bar">
          <view class="chat-emoji-bar__space" />
          <view class="chat-emoji-back" hover-class="chat-emoji-back--active" @click="handleEmojiBackspace">
            <svg-icon name="icon-X" size="36" color="#6b6976" />
          </view>
        </view>
        </view>
        </view>
      </view>

    <!-- 展开输入面板（输入框 ⤢ 从底部拉起，飞书式）：大输入区（与输入坞共享 inputText）
         + 底部工具行（与输入坞第二行一致但无加号：表情 / @ / 话筒 / 相册 / Aa）+ 右下纸飞机发送；
         右上 ⤢ 收起、点蒙层收起、按住面板下滑收起；无边框，背面半透明蒙层 -->
    <view v-if="expanded" class="chat-expand-mask" @click="closeExpandSheet" />
    <view
      v-if="expanded"
      class="chat-expand-sheet"
      :class="{
        'chat-expand-sheet--snap': sheetDragging != true,
        'chat-expand-sheet--paneled': expandPanel == 'emoji',
      }"
      :style="{ paddingBottom: expandBottomPx + 'px', transform: 'translateY(' + sheetDragPx + 'px)' }"
      @touchstart="handleSheetTouchStart($event)"
      @touchmove="handleSheetTouchMove($event)"
      @touchend="handleSheetTouchEnd($event)"
      @touchcancel="handleSheetTouchEnd($event)"
    >
      <!-- 头部仅一枚收起键（贴右上角，点击收回面板回输入坞） -->
      <view class="chat-expand-sheet__head">
        <view
          class="chat-expand-sheet__collapse"
          hover-class="chat-expand-sheet__collapse--active"
          @click="toggleExpandPanel"
        >
          <image class="chat-collapse-glyph" src="/static/images/icon-collapse.png" mode="aspectFit" />
        </view>
      </view>
      <!-- 大输入区：聚焦拉系统键盘（adjust-position=false，让位由面板 paddingBottom 承担；
           hold-keyboard 使点工具键不失焦收键盘） -->
      <view class="chat-expand-sheet__body">
        <textarea
          class="chat-expand-sheet__input"
          v-model="inputText"
          :maxlength="2000"
          :placeholder="t('Mobile.Message.inputPlaceholder')"
          placeholder-style="color:#b0aebc;line-height:48rpx;"
          :show-confirm-bar="false"
          :disable-default-padding="true"
          :adjust-position="false"
          :hold-keyboard="true"
          :focus="expandFocusRequest"
          @input="handleExpandInputTyped"
        />
      </view>

      <!-- 底部工具行：与输入坞第二行一致但无加号键（表情 / @ / 话筒 / 相册 / Aa，
           展示与交互同款：话筒收面板进语音态，@/相册收面板走主坞链路）；五键 + 发送键
           （sendslot 槽位）六槽等分全行；Aa 开格式行时整行换成主坞完全同款的 chat-fontbar
           白底横条（左蓝下箭头收起 + 六键 + 右蓝发送，space-between 全行均匀分布） -->
      <view
        class="chat-expand-sheet__bar"
        :class="{ 'chat-expand-sheet__bar--font': expandPanel == 'font' }"
      >
        <view v-if="expandPanel != 'font'" class="chat-expand-sheet__tools">
          <view
            class="chat-tool"
            hover-class="chat-tool--active"
            @click="toggleExpandEmoji"
            @touchstart="pressTool('face')"
            @touchend="releaseTool"
            @touchcancel="releaseTool"
          >
            <image
              class="chat-tool__face"
              :src="expandPanel == 'emoji' || toolPressedKey == 'face' ? '/static/images/icon-face-on.png' : '/static/images/icon-face.png'"
              mode="aspectFit"
            />
          </view>
          <view
            class="chat-tool"
            hover-class="chat-tool--active"
            @click="handleExpandMentionTap"
            @touchstart="pressTool('at')"
            @touchend="releaseTool"
            @touchcancel="releaseTool"
          >
            <text
              class="chat-tool__text"
              :class="{ 'chat-tool__text--on': toolPressedKey == 'at' }"
            >@</text>
          </view>
          <view
            class="chat-tool"
            hover-class="chat-tool--active"
            @click="handleExpandVoiceTap"
            @touchstart="pressTool('mic')"
            @touchend="releaseTool"
            @touchcancel="releaseTool"
          >
            <svg-icon
              name="icon-Mic"
              size="48"
              :color="toolPressedKey == 'mic' ? '#337eff' : '#7a7887'"
            />
          </view>
          <view
            class="chat-tool"
            hover-class="chat-tool--active"
            @click="handleExpandImageTap"
            @touchstart="pressTool('image')"
            @touchend="releaseTool"
            @touchcancel="releaseTool"
          >
            <svg-icon
              name="icon-Image"
              size="48"
              :color="toolPressedKey == 'image' ? '#337eff' : '#7a7887'"
            />
          </view>
          <view
            class="chat-tool"
            hover-class="chat-tool--active"
            @click="toggleExpandFont"
            @touchstart="pressTool('aa')"
            @touchend="releaseTool"
            @touchcancel="releaseTool"
          >
            <text
              class="chat-tool__text chat-tool__text--aa"
              :class="{ 'chat-tool__text--on': expandPanel == 'font' || toolPressedKey == 'aa' }"
            >Aa</text>
          </view>
          <!-- 发送键：与功能键等分同行（同主坞 sendslot 槽位，72rpx 蓝圆纸飞机槽内居中） -->
          <view class="chat-tools__sendslot">
            <view
              class="chat-dock-send"
              :class="{ 'chat-dock-send--ready': canSend }"
              hover-class="chat-dock-send--active"
              @click="handleExpandSend"
            >
              <view class="chat-send-glyphfix">
                <svg-icon name="icon-send" size="36" :color="canSend ? '#ffffff' : '#b0aebc'" />
              </view>
            </view>
          </view>
        </view>
        <!-- Aa 格式行：主坞 chat-fontbar 完全同款（白底横条：左蓝下箭头收起 + B/I/S/U + 清单 +
             右蓝发送，space-between 全行均匀分布；仅收起/发送回调走面板版） -->
        <view v-else class="chat-fontbar chat-fontbar--sheet">
          <view
            class="chat-fontbar__down"
            hover-class="chat-fontbar__down--active"
            @click="toggleExpandFont"
          >
            <svg-icon name="icon-a-Chevrondown" size="28" color="#ffffff" />
          </view>
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': markBold }"
            hover-class="chat-fontbar__btn--active"
            @click="handleMarkToggle('bold')"
          >
            <text class="chat-fontbar__glyph chat-fontbar__glyph--b">B</text>
          </view>
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': markItalic }"
            hover-class="chat-fontbar__btn--active"
            @click="handleMarkToggle('italic')"
          >
            <text class="chat-fontbar__glyph chat-fontbar__glyph--i">I</text>
          </view>
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': markStrike }"
            hover-class="chat-fontbar__btn--active"
            @click="handleMarkToggle('strike')"
          >
            <text class="chat-fontbar__glyph chat-fontbar__glyph--s">S</text>
          </view>
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': markUnderline }"
            hover-class="chat-fontbar__btn--active"
            @click="handleMarkToggle('underline')"
          >
            <text class="chat-fontbar__glyph chat-fontbar__glyph--u">U</text>
          </view>
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': listKind == 'ol' }"
            hover-class="chat-fontbar__btn--active"
            @click="handleListTap('ol')"
          >
            <view class="chat-ex-li">
              <view class="chat-ex-li-row">
                <text class="chat-ex-ol-num">1</text>
                <view class="chat-ex-li-line" />
              </view>
              <view class="chat-ex-li-row">
                <text class="chat-ex-ol-num">2</text>
                <view class="chat-ex-li-line" />
              </view>
              <view class="chat-ex-li-row">
                <text class="chat-ex-ol-num">3</text>
                <view class="chat-ex-li-line" />
              </view>
            </view>
          </view>
          <view
            class="chat-fontbar__btn"
            :class="{ 'chat-fontbar__btn--on': listKind == 'ul' }"
            hover-class="chat-fontbar__btn--active"
            @click="handleListTap('ul')"
          >
            <view class="chat-ex-li">
              <view class="chat-ex-li-row">
                <view class="chat-ex-li-dot" />
                <view class="chat-ex-li-line" />
              </view>
              <view class="chat-ex-li-row">
                <view class="chat-ex-li-dot" />
                <view class="chat-ex-li-line" />
              </view>
              <view class="chat-ex-li-row">
                <view class="chat-ex-li-dot" />
                <view class="chat-ex-li-line" />
              </view>
            </view>
          </view>
          <!-- 发送键：横条右端同款蓝圆纸飞机（主坞一致；间距由 space-between 等分承担） -->
          <view
            class="chat-dock-send"
            :class="{ 'chat-dock-send--ready': canSend }"
            hover-class="chat-dock-send--active"
            @click="handleExpandSend"
          >
            <view class="chat-send-glyphfix">
              <svg-icon name="icon-send" size="36" :color="canSend ? '#ffffff' : '#b0aebc'" />
            </view>
          </view>
        </view>
      </view>

      <!-- 内嵌面板（与键盘互斥，位于工具行下方——与主坞表情/加号面板的弹出位置一致）：
           表情网格（复用主坞表情面板样式与点选逻辑） -->
      <view v-if="expandPanel == 'emoji'" class="chat-expand-sheet__panel">
        <scroll-view class="chat-emoji-scroll" direction="vertical" :show-scrollbar="false">
          <view class="chat-emoji-grid">
            <!-- 常用行（仅真实历史，空则整段不渲染；与主坞表情面板共用数据源与样式） -->
            <view v-if="panelRecentEmojis.length > 0" class="chat-emoji-recent">
              <text class="chat-emoji-recent__title">{{ t("Mobile.Message.recentEmojis") }}</text>
              <view class="chat-emoji-row">
                <view
                  v-for="emo in panelRecentEmojis"
                  :key="emo"
                  class="chat-emoji-cell"
                  hover-class="chat-emoji-cell--active"
                  @click="handleEmojiTap(emo)"
                >
                  <text class="chat-emoji-item">{{ emo }}</text>
                </view>
              </view>
            </view>
            <view v-for="(row, ri) in EMOJI_ROWS" :key="ri" class="chat-emoji-row">
              <view
                v-for="emo in row"
                :key="emo"
                class="chat-emoji-cell"
                hover-class="chat-emoji-cell--active"
                @click="handleEmojiTap(emo)"
              >
                <text class="chat-emoji-item">{{ emo }}</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 按住说话全屏蒙层（liveAsr 三阶段）：按住中=顶部状态气泡+波形（不拦截触摸，
         手势全程落在其下的录音按钮上，鸿蒙 v-if 插节点会打手势的教训保持常驻 DOM）；
         松手识别中=气泡「语音识别中」；识别完成=中部可编辑卡片 + 底部 取消/仅发语音/确认
         （后两态拦截触摸）。实时逐字文案需 vox-server 下发 asr_partial（现协议仅 stop 后
         一次 asr_result，docs/integration/app-asr-tts.md），当前按住中显示状态提示，
         识别完成文本落入编辑卡，后端支持后气泡直接接逐字文本 -->
    <view
      class="chat-voice-mask"
      :class="{
        'chat-voice-mask--on': voiceStage != 'idle',
        'chat-voice-mask--cancel': recordWillCancel && voiceStage == 'recording',
        'chat-voice-mask--interactive': voiceStage == 'processing' || voiceStage == 'editing',
      }"
    >
      <!-- 按住中：状态气泡 + 波形 -->
      <view v-if="voiceStage == 'recording'" class="chat-voice-stage">
        <view class="chat-voice-bubble" :class="recordWillCancel ? 'chat-voice-bubble--cancel' : ''">
          <text class="chat-voice-bubble__text">{{ recordOverlayHint }}</text>
        </view>
        <view class="chat-voice-bubble__tail" />
        <view class="chat-voice-wave">
          <view class="chat-voice-baseline" />
          <view class="chat-voice-bars">
            <view
              v-for="(bar, index) in waveformBars"
              :key="index"
              class="chat-voice-bar"
              :style="{ height: `${bar.height}px` }"
            />
          </view>
        </view>
      </view>
      <!-- 松手识别中 -->
      <view v-else-if="voiceStage == 'processing'" class="chat-voice-stage">
        <view class="chat-voice-bubble">
          <text class="chat-voice-bubble__text">{{ t("Mobile.Voice.recognizing") }}</text>
        </view>
        <view class="chat-voice-bubble__tail" />
      </view>
      <!-- 识别完成：中部编辑卡（页面居中，卡下提示行 + 取消/仅发语音按钮排），
           ✓ 大圆钮独立沉底居中（设计稿二版；轻触卡片拉键盘编辑） -->
      <view v-else-if="voiceStage == 'editing'" class="chat-voice-edit">
        <view class="chat-voice-edit__main">
          <view class="chat-voice-card" @click="handleVoiceCardTap">
            <textarea
              class="chat-voice-card__input"
              v-model="voiceDraftText"
              :focus="voiceDraftFocus"
              :maxlength="2000"
              @focus="handleVoiceDraftFocus"
              @blur="handleVoiceDraftBlur"
            />
          </view>
          <text class="chat-voice-card__hint">{{ t("Mobile.Voice.tapToEdit") }}</text>
          <view class="chat-voice-actions">
            <view
              class="chat-voice-action"
              hover-class="chat-voice-action--active"
              @click="handleVoiceEditCancel"
            >
              <svg-icon name="icon-a-Return" size="34" color="#ffffff" />
              <text class="chat-voice-action__text">{{ t("Mobile.Common.cancel") }}</text>
            </view>
            <view
              v-if="voicePcmPath.length > 0"
              class="chat-voice-action"
              hover-class="chat-voice-action--active"
              @click="handleVoiceSendAudio"
            >
              <svg-icon name="icon-Mic" size="34" color="#ffffff" />
              <text class="chat-voice-action__text">{{ t("Mobile.Voice.sendVoiceOnly") }}</text>
            </view>
          </view>
        </view>
        <view
          class="chat-voice-confirm"
          :class="voiceDraftText.trim().length > 0 && voiceAudioSending != true ? '' : 'chat-voice-confirm--disabled'"
          hover-class="chat-voice-confirm--active"
          @click="handleVoiceEditConfirm"
        >
          <svg-icon name="icon-Check" size="44" color="#2a8cff" />
        </view>
      </view>
    </view>

    <!-- 长按消息操作弹窗（显隐规则在页面侧 buildActionsFor，组件只渲染与上抛；
         表情快选条数据由 sheetQuickEmojis 按 selectedId 消息算出） -->
    <msg-action-sheet
      ref="actionSheetRef"
      :actions="sheetActions"
      :quick-emojis="sheetQuickEmojis"
      :all-emojis="EMOJIS"
      @select="handleSheetSelect"
      @closed="handleSheetClosed"
    />

    <!-- 选择复制弹层（长按面板「选择复制」进）：textarea 原生选择手柄 + 系统菜单复制
         选中部分；文案传剥掉 Markdown 标记的纯文本，编辑不回写消息 -->
    <msg-select-copy-sheet ref="selectCopyRef" :text="selectCopyText" @closed="handleSelectCopyClosed" />

    <!-- 删除消息二次确认（按人删除：仅自己的可见范围，红钮确认） -->
    <confirm-modal ref="confirmModalRef" @confirm="handleDeleteConfirmOk" @cancel="handleDeleteConfirmCancel" />

    <!-- 合并转发聊天记录详情页：点卡片经 imMergeRecordSession 暂存跳转（openMergeDetail） -->
  </view>
</template>

<script setup lang="uts">
