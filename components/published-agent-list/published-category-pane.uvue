<template>
  <list-view
    v-if="scrollable == true"
    class="category-list"
    direction="vertical"
    :show-scrollbar="false"
    :refresher-enabled="true"
    :refresher-triggered="refreshing == true"
    @refresherrefresh="emit('refresh')"
    @scrolltolower="emit('loadmore')"
  >
    <list-item v-for="info in agents" :key="info.id">
      <agent-component
        :icon="info.icon"
        :name="info.name"
        :description="info.description"
        :userCount="getStatUserCount(info)"
        :convCount="getStatConvCount(info)"
        :collectCount="getStatCollectCount(info)"
        :collect="info.collect"
        :paymentRequired="info.paymentRequired == true && enableSubscription == 1"
        :subscribed="info.subscribed"
        @click="emit('agentClick', info)"
        @collect="emit('collect', info)"
      />
    </list-item>
    <list-item
      v-if="agents.length == 0 && loading != true && refreshing != true"
    >
      <view class="empty-state">
        <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
        <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
      </view>
    </list-item>
    <list-item v-if="agents.length == 0 && loading == true">
      <view class="loading-state">
        <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
    </list-item>
    <list-item v-if="loading != true && hasMore != true && agents.length > 6">
      <view class="no-more-state">
        <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
      </view>
    </list-item>
  </list-view>
  <view v-else class="category-pane-static">
    <view v-for="info in agents" :key="info.id">
      <agent-component
        :icon="info.icon"
        :name="info.name"
        :description="info.description"
        :userCount="getStatUserCount(info)"
        :convCount="getStatConvCount(info)"
        :collectCount="getStatCollectCount(info)"
        :collect="info.collect"
        :paymentRequired="info.paymentRequired == true && enableSubscription == 1"
        :subscribed="info.subscribed"
        @click="emit('agentClick', info)"
        @collect="emit('collect', info)"
      />
    </view>
    <view
      v-if="agents.length == 0 && loading != true && refreshing != true"
      class="empty-state"
    >
      <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
      <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
    </view>
    <view v-if="agents.length == 0 && loading == true" class="loading-state">
      <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
    </view>
    <view
      v-if="loading != true && hasMore != true && agents.length > 6"
      class="no-more-state"
    >
      <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import AgentComponent from "@/components/agent-component/agent-component.uvue";
  import noData from "@/static/assets/no_data.png";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      agents: UTSJSONObject[];
      loading?: boolean;
      refreshing?: boolean;
      hasMore?: boolean;
      enableSubscription?: number;
      /** false：不自建滚动，交给外层 list-view 吸顶竖滑（应用 Tab） */
      scrollable?: boolean;
    }>(),
    {
      agents: [] as UTSJSONObject[],
      loading: false,
      refreshing: false,
      hasMore: true,
      enableSubscription: 0,
      scrollable: true,
    },
  );

  const emit = defineEmits<{
    refresh: [];
    loadmore: [];
    agentClick: [info: UTSJSONObject];
    collect: [info: UTSJSONObject];
  }>();

  function getNestedObj(info: UTSJSONObject, key: string): UTSJSONObject | null {
    const raw = info[key];
    if (raw == null) {
      return null;
    }
    return raw as UTSJSONObject;
  }

  function getStatNumber(info: UTSJSONObject, key: string): number {
    const stat = getNestedObj(info, "statistics");
    if (stat == null) {
      return 0;
    }
    const val = stat[key];
    return val != null ? val as number : 0;
  }

  function getStatUserCount(info: UTSJSONObject): number {
    return getStatNumber(info, "userCount");
  }

  function getStatConvCount(info: UTSJSONObject): number {
    return getStatNumber(info, "convCount");
  }

  function getStatCollectCount(info: UTSJSONObject): number {
    return getStatNumber(info, "collectCount");
  }
</script>

<style lang="scss" scoped>
  .category-list {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
    /* #ifdef H5 */
    overscroll-behavior-y: none;
    /* #endif */
  }

  .category-pane-static {
    width: 100%;
  }

  .empty-state {
    min-height: 800rpx;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80rpx 0;
  }

  .empty-image {
    width: 172rpx;
    height: 172rpx;
  }

  .empty-text {
    font-size: 28rpx;
    color: #999;
    margin-top: 32rpx;
  }

  .loading-state {
    min-height: 480rpx;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40rpx;
  }

  .loading-text {
    font-size: 28rpx;
    color: #666;
    display: flex;
    align-items: center;
  }

  .no-more-state {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40rpx;
  }

  .no-more-text {
    font-size: 24rpx;
    color: #999;
  }
</style>
