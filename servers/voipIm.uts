/** nuwax-im feat-video-meeting 的一对一电话适配；会议 API 仅用作底层 RTC 房间。 */
import request from "@/servers/useRequest";
import { apiImConvDetail, apiImContacts, apiImWhoami, getImDeviceId, imDevicePlatform } from "@/servers/im";
import { apiResCode, apiResData } from "@/utils/apiResponse";
import { getImSessionStamp } from "@/utils/im/imSessionScope";
import { callFailure } from "@/features/voip/callErrors";

export async function imVoipCapabilities(convId: string): Promise<UTSJSONObject> {
  const response = await apiImConvDetail(convId, "", true, true);
  const data = apiResData<UTSJSONObject>(response) as UTSJSONObject | null;
  if (apiResCode(response) != "0000" || data == null) throw callFailure("CALL_SERVICE_UNAVAILABLE");
  // 当前后端仅实现真人 RTC；没有智能体语音参与者或模型视频能力声明。
  const peerId = `${data["peerUserId"] ?? ""}`;
  const contacts = apiResData<UTSJSONObject>(await apiImContacts()) as UTSJSONObject | null;
  const items = contacts != null ? contacts["items"] as UTSJSONObject[] | null : null;
  let human = false;
  if (items != null) {
    for (let i = 0; i < items.length; i++) {
      if (`${items[i]["userId"] ?? ""}` == peerId && `${items[i]["subjectType"] ?? ""}` == "1") human = true;
    }
  }
  const me = apiResData<UTSJSONObject>(await apiImWhoami()) as UTSJSONObject | null;
  const callerId = me != null ? `${me["userId"] ?? ""}` : "";
  const callerDisplayName = me != null ? `${me["displayName"] ?? me["userId"] ?? ""}` : "";
  const enabled = callerId.length > 0 && peerId != callerId && human && `${data["convType"] ?? ""}` == "1" && `${data["peerSubjectType"] ?? "1"}` == "1" && peerId.length > 0 && peerId != "1999999999999";
  return { enabled, audio: enabled, video: enabled, callerId, callerDisplayName, peerId, peerName: `${data["peerName"] ?? peerId}` } as UTSJSONObject;
}

export async function createImVoipCall(convId: string, mediaType: string, callId: string): Promise<UTSJSONObject> {
  const stamp = getImSessionStamp();
  const caps = await imVoipCapabilities(convId);
  if (stamp != getImSessionStamp()) throw callFailure("CALL_SESSION_CHANGED");
  if (caps[mediaType] !== true || `${caps["callerId"] ?? ""}`.length == 0) throw callFailure("CALL_MEDIA_UNSUPPORTED");
  const roomName = `call-${callId}`;
  const response = await request({ url: "/api/instant-message/meetings/rtc/rooms", method: "POST", suppressErrorToast: true,
    data: { name: roomName, maxParticipants: 2, emptyTimeoutSeconds: 120, platform: imDevicePlatform(), deviceId: getImDeviceId() } });
  if (stamp != getImSessionStamp()) throw callFailure("CALL_SESSION_CHANGED");
  if (`${(response as UTSJSONObject)["code"] ?? ""}` != "0000") throw callFailure("CALL_SERVICE_UNAVAILABLE");
  // 邀请由原生媒体连接成功后发送；此处没有向对端发信，迟到响应只留下会自动回收的空房间。
  return { protocol: "im-voip-v1", callId, roomName, msgId: "", convId, version: 1, state: "ringing", mediaType,
    callerId: `${caps["callerId"]}`, callerDeviceId: getImDeviceId(), calleeId: `${caps["peerId"]}`,
    callerDisplayName: `${caps["callerDisplayName"]}`, calleeDisplayName: `${caps["peerName"]}`,
    acceptedDeviceId: "", expiresAt: Date.now() + 60000 } as UTSJSONObject;
}
