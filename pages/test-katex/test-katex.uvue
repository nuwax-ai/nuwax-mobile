<template>
  <view class="tk-page">
    <!-- 隐藏 web-view：H5 公式 v-html 由它算 resultHtml 回传 -->
    <web-view
      class="markdown-proxy-web"
      id="markdown-proxy-web"
      src="/uni_modules/uni-ai-x/static/proxy-web/proxy-web.html"
      @message="onProxyMsg"
    ></web-view>

    <view class="tk-header">
      <text class="tk-title">KaTeX 块级公式换行测试（H5）</text>
      <text class="tk-sub">proxy 状态: {{ proxyReady ? "就绪" : "未就绪" }}</text>
    </view>

    <scroll-view class="tk-scroll" direction="vertical">
      <!-- 1. 短块级公式（不应换行） -->
      <view class="tk-case">
        <text class="tk-case-title">1. 短块级公式 $$E=mc^2$$</text>
        <katex-el :html="html1" :href="''" :width="0" :height="0" />
      </view>

      <!-- 2. 长块级公式（超宽应横滚不换行） -->
      <view class="tk-case">
        <text class="tk-case-title">2. 长块级公式（应横滚不换行）</text>
        <katex-el :html="html2" :href="''" :width="0" :height="0" />
      </view>

      <!-- 3. 含中文的块级公式（截图同款） -->
      <view class="tk-case">
        <text class="tk-case-title">3. 含中文块级公式（T_resize 同款）</text>
        <katex-el :html="html3" :href="''" :width="0" :height="0" />
      </view>

      <!-- 4. 行内公式混排 -->
      <view class="tk-case">
        <text class="tk-case-title">4. 行内公式混排（与文字同行）</text>
        <view class="tk-inline-row">
          <text class="tk-inline-text">设容量初始为 </text>
          <katex-el :html="html4" :href="''" :width="0" :height="0" :inline="true" />
          <text class="tk-inline-text"> ，倍增因子为 2，则 </text>
          <katex-el :html="html5" :href="''" :width="0" :height="0" :inline="true" />
          <text class="tk-inline-text"> 次插入。</text>
        </view>
      </view>

      <!-- 5. 多行公式（\\ 换行，验证 nowrap 不破坏内部换行） -->
      <view class="tk-case">
        <text class="tk-case-title">5. 多行公式（\\ 换行，应保持两行）</text>
        <katex-el :html="html6" :href="''" :width="0" :height="0" />
      </view>

      <!-- 6. 分数+上下标混合（验证内部结构不错位） -->
      <view class="tk-case">
        <text class="tk-case-title">6. 分数+上下标（内部结构应正常）</text>
        <katex-el :html="html7" :href="''" :width="0" :height="0" />
      </view>

      <!-- ===== 公式渲染模式对照（运行时可切，无需重编译） =====
           katex: PNG 截图（native image） / mathjax: 纯 SVG 串（x-svg-renderer 矢量渲染）
           App 端看 M1-M3 是否随模式变化；切 mathjax 后应正常显示矢量公式 -->
      <view class="tk-case">
        <text class="tk-case-title">公式渲染模式：{{ currentMode == "katex" ? "KaTeX · PNG 截图" : "MathJax · SVG" }}</text>
        <button size="mini" @click="switchMode">切换为 {{ currentMode == "katex" ? "MathJax SVG" : "KaTeX PNG" }}</button>
      </view>
      <view class="tk-case">
        <text class="tk-case-title">M1. 对照 $$E=mc^2$$</text>
        <katex-el :href="mjHref1" :svg="mjSvg1" :html="mjHtml1" :width="mjW1" :height="mjH1" />
      </view>
      <view class="tk-case">
        <text class="tk-case-title">M2. 对照 分数+求和（块级）</text>
        <katex-el :href="mjHref2" :svg="mjSvg2" :html="mjHtml2" :width="mjW2" :height="mjH2" />
      </view>
      <view class="tk-case">
        <text class="tk-case-title">M3. 对照 行内（与文字同行）</text>
        <view class="tk-inline-row">
          <text class="tk-inline-text">能量 </text>
          <katex-el :href="mjHref3" :svg="mjSvg3" :html="mjHtml3" :width="mjW3" :height="mjH3" :inline="true" />
          <text class="tk-inline-text"> 倍增。</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts" setup>
import { onMounted, ref } from "vue";
import proxyWeb from "@/uni_modules/uni-ai-x/sdk/proxy-web.uts";
import {
  resolveMathAction,
  mathRenderConfig,
  MATH_MODE_KATEX,
  MATH_MODE_MATHJAX,
} from "@/uni_modules/uni-ai-x/sdk/math-render.uts";

const currentMode = ref(MATH_MODE_KATEX);
const proxyReady = ref(false);
const html1 = ref("");
const html2 = ref("");
const html3 = ref("");
const html4 = ref("");
const html5 = ref("");
const html6 = ref("");
const html7 = ref("");
// MathJax SVG 对照：mathjax 模式回填 svg 串 → x-svg-renderer 矢量渲染
const mjHref1 = ref("");
const mjSvg1 = ref("");
const mjW1 = ref(0);
const mjH1 = ref(0);
const mjHref2 = ref("");
const mjSvg2 = ref("");
const mjW2 = ref(0);
const mjH2 = ref(0);
const mjHref3 = ref("");
const mjSvg3 = ref("");
const mjW3 = ref(0);
const mjH3 = ref(0);
const mjHtml1 = ref("");
const mjHtml2 = ref("");
const mjHtml3 = ref("");

function onProxyMsg(e: UniWebViewMessageEvent) {
  proxyWeb.onWebMsg(e);
}

/** 调 proxy 渲染一条公式，回写 resultHtml（H5 v-html 路径） */
function renderMath(latex: string, displayMode: boolean, target: Ref<string>) {
  const param = new UTSJSONObject();
  param["action"] = "katexRender";
  param["pureMathText"] = latex;
  param["displayMode"] = displayMode;
  proxyWeb.callMethod(param, (res: UTSJSONObject): void => {
    const html = res["resultHtml"];
    if (html != null && `${html}`.length > 0) {
      target.value = `${html}`;
    }
  });
}

/** 对照用例渲染：按 currentMode（resolveMathAction）选 katex/mathjax。
 *  katex：回填 href(PNG)+html+w+h；mathjax：回填 svg(纯串)+w+h（→ x-svg-renderer）。 */
function renderMathCase(
  latex: string,
  displayMode: boolean,
  hrefT: Ref<string>,
  svgT: Ref<string>,
  htmlT: Ref<string>,
  wT: Ref<number>,
  hT: Ref<number>,
) {
  const param = new UTSJSONObject();
  param["action"] = resolveMathAction();
  param["pureMathText"] = latex;
  param["displayMode"] = displayMode;
  proxyWeb.callMethod(param, (res: UTSJSONObject): void => {
    const img = res["imageDataURL"];
    if (img != null && `${img}`.length > 0) {
      hrefT.value = `${img}`;
    }
    const svg = res["svg"];
    if (svg != null && `${svg}`.length > 0) {
      svgT.value = `${svg}`;
    }
    const html = res["resultHtml"];
    if (html != null && `${html}`.length > 0) {
      htmlT.value = `${html}`;
    }
    const w = res["width"];
    if (w != null) {
      wT.value = w as number;
    }
    const h = res["height"];
    if (h != null) {
      hT.value = h as number;
    }
  });
}

/** 对照用例统一渲染（切换 mode 后也调它重渲，先清空旧结果避免残留上一模式图） */
function renderMathCases() {
  mjHref1.value = "";
  mjSvg1.value = "";
  mjHtml1.value = "";
  mjHref2.value = "";
  mjSvg2.value = "";
  mjHtml2.value = "";
  mjHref3.value = "";
  mjSvg3.value = "";
  mjHtml3.value = "";
  renderMathCase("E=mc^2", true, mjHref1, mjSvg1, mjHtml1, mjW1, mjH1);
  renderMathCase(
    "\\frac{-b \\pm \\sqrt{b^2-4ac}}{2a} + \\sum_{i=1}^{n} x_i^2",
    true,
    mjHref2,
    mjSvg2,
    mjHtml2,
    mjW2,
    mjH2,
  );
  renderMathCase("E=mc^2", false, mjHref3, mjSvg3, mjHtml3, mjW3, mjH3);
}

function renderAll() {
  renderMath("E=mc^2", true, html1);
  renderMath(
    "f(x)=a_0+a_1x+a_2x^2+a_3x^3+a_4x^4+a_5x^5+a_6x^6+a_7x^7+a_8x^8+a_9x^9",
    true,
    html2,
  );
  renderMath(
    "T_{\\text{resize}}(n) = m + 2m + 4m + \\cdots + 2^{\\lfloor \\log_2(n/m) \\rfloor} m = O(n)",
    true,
    html3,
  );
  renderMath("m", false, html4);
  renderMath("n", false, html5);
  // 多行公式（\\ 换行）：验证 nowrap 不破坏内部换行
  renderMath(
    "\\begin{aligned} T_{\\text{resize}}(n) &= m + 2m + 4m + \\dots \\\\ &= 2^{\\lfloor \\log_2(n/m) \\rfloor} m = O(n) \\end{aligned}",
    true,
    html6,
  );
  // 分数+上下标：验证内部结构不错位
  renderMath(
    "\\frac{-b \\pm \\sqrt{b^2-4ac}}{2a} + \\sum_{i=1}^{n} x_i^2",
    true,
    html7,
  );
  // 公式模式对照（按 currentMode：katex PNG / mathjax SVG）
  renderMathCases();
}

/** 运行时切换 katex/mathjax 模式（无需重新编译），重渲对照用例 */
function switchMode() {
  mathRenderConfig.mode =
    currentMode.value == MATH_MODE_KATEX ? MATH_MODE_MATHJAX : MATH_MODE_KATEX;
  currentMode.value = mathRenderConfig.mode;
  renderMathCases();
}

onMounted(() => {
  // #ifdef WEB
  const el = document.getElementById("markdown-proxy-web");
  proxyWeb.init(el as any, "markdown-proxy-web");
  // #endif
  // #ifndef WEB
  proxyWeb.ensureAppContext("markdown-proxy-web");
  // #endif
  proxyWeb.whenReady((): void => {
    proxyReady.value = true;
    renderAll();
  });
});
</script>

<style lang="scss">
.tk-page {
  width: 100%;
  height: 100vh;
  background-color: #f5f5f5;
  flex-direction: column;
}
.markdown-proxy-web {
  width: 0;
  height: 0;
  position: absolute;
  left: -9999px;
  top: -9999px;
}
.tk-header {
  padding: 24rpx;
  background-color: #fff;
  border-bottom: 1px solid #eee;
}
.tk-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}
.tk-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.tk-scroll {
  flex: 1;
}
.tk-case {
  background-color: #fff;
  margin: 16rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 1px solid #eee;
}
.tk-case-title {
  font-size: 26rpx;
  color: #0066cc;
  margin-bottom: 16rpx;
  display: block;
}
.tk-inline-row {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}
.tk-inline-text {
  font-size: 32rpx;
  color: #404040;
}
</style>
