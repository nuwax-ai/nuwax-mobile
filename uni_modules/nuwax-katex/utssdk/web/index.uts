/**
 * nuwax-katex H5 实现：内置 KaTeX 直出 HTML，组件用 v-html 渲染（真实 DOM，实时更新）。
 */
import type { KatexRenderOptions, KatexRenderRes } from '../interface.uts'
export * from '../interface.uts'

// 内置 KaTeX 桥（JS：katex → renderToString）
import katexWeb from './katex-web.js'

/**
 * 渲染 LaTeX 公式为 HTML（H5：v-html 直用）
 */
export function renderLatex(tex: string, options: KatexRenderOptions): KatexRenderRes {
	try {
		const html = katexWeb.renderToString(tex, options.displayMode, options.errorColor) as string
		const res: KatexRenderRes = {
			html: html,
			errMsg: '',
		}
		return res
	} catch (e) {
		const msg = e instanceof Error ? e.message : `${e}`
		const res: KatexRenderRes = {
			html: '',
			errMsg: msg,
		}
		return res
	}
}
