/**
 * 语音（TTS / ASR）WebSocket 鉴权 Token 统一解析。
 * TTS 与 ASR 共用同一实现，避免两处独立 copy 导致行为漂移（曾因 key 不一致双双取不到）。
 *
 * - 浏览器 H5 生产：优先 cookie `ticket`（WS 无法靠 Cookie 握手时再拼进 URL query）
 * - App 内嵌 H5 / App / 小程序：优先本地 ACCESS_TOKEN（配合 Authorization Header）
 */
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { isAppWebViewEmbedded } from "@/utils/appWebViewDetect";

/**
 * H5：从 document.cookie 读取指定 key（仅非 HttpOnly 可读）。
 */
function readCookie(name: string): string {
  // #ifdef H5 || WEB
  try {
    const raw = document.cookie;
    if (raw == null || raw.length == 0) {
      return "";
    }
    const parts = raw.split(";");
    const prefix = name + "=";
    for (let i = 0; i < parts.length; i++) {
      let part = parts[i];
      while (part.length > 0 && part.charAt(0) == " ") {
        part = part.substring(1);
      }
      if (part.indexOf(prefix) == 0) {
        const value = part.substring(prefix.length);
        try {
          const decodedRaw = decodeURIComponent(value);
          return decodedRaw != null ? decodedRaw : value;
        } catch (_eDecode) {
          // JWT 等未编码值时 decodeURIComponent 可能抛错：原样返回
          return value;
        }
      }
    }
  } catch (_e) {
    // ignore
  }
  // #endif
  return "";
}

/** 去掉 Bearer 前缀 */
function normalizeAccessToken(token: string): string {
  if (token.startsWith("Bearer ")) {
    return token.substring(7);
  }
  return token;
}

/**
 * 解析语音 WebSocket 鉴权 Token。
 * 优先级：
 * 1. App 内嵌 H5 / 非浏览器路径：本地 ACCESS_TOKEN
 * 2. 浏览器 H5：cookie ticket，再回退 storage
 *
 * iOS：key 不存在时 getStorageSync 可能抛「返回值为 undefined」，必须 try-catch。
 */
export function resolveSpeechAccessToken(): string {
  // #ifdef H5 || WEB
  // App 内嵌：与 HTTP 一致走 storage + Header，不依赖 cookie
  if (isAppWebViewEmbedded()) {
    try {
      const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
      if (tokenRaw != null) {
        const asStr = `${tokenRaw}`;
        if (asStr.length > 0 && asStr != "undefined" && asStr != "null") {
          return normalizeAccessToken(asStr);
        }
      }
    } catch (_eEmb) {
      // fall through
    }
  } else {
    const cookieToken = readCookie("ticket");
    if (cookieToken.length > 0) {
      return normalizeAccessToken(cookieToken);
    }
  }
  // #endif
  try {
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    if (tokenRaw == null) {
      return "";
    }
    const asStr = `${tokenRaw}`;
    if (asStr.length == 0 || asStr == "undefined" || asStr == "null") {
      return "";
    }
    return normalizeAccessToken(asStr);
  } catch (_eStorage) {
    return "";
  }
}
