<template>
  <!-- 首页与会话详情共用的输入内核；scene 只控制展示形态，发送业务仍由父页面处理。 -->
  <view
    class="relative container"
    :class="{
      'container--recording': isRecording,
      'container--quick-popup': quickPopupVisible,
    }"
  >
    <!-- 勿加 overflow-hide：iOS 会裁切手动选择 chips 底边框 -->
    <view class="flex flex-row items-center container-block">
      <!-- 手动选择组件（会话场景整条工具栏；首页改用 home-tools-bar 只展示工具） -->
      <manual-component-item
        v-if="showManualComponent && !usesHomeLayout"
        :manual-components="safeManualComponents"
        :selected-components="selectedComponents"
        :page-home-index="pageHomeIndexVal"
        :expand-page-area="expandPageAreaVal"
        @onSelectComponent="handleToggleSelectComponent"
        @onOpenPagePreview="handleOpenPagePreview"
        @onOpenFileTree="handleOpenFileTree"
        :is-task-agent="isTaskAgentVal"
        :is-device-agent="isDeviceAgentVal"
        :sandbox-list="sandboxListVal"
        :current-sandbox-id="currentSandboxId"
        :is-sandbox-switch-disabled="isSandboxSwitchDisabled"
        :is-sandbox-unavailable="isSandboxUnavailable"
        :sandbox-disabled-text="sandboxDisabledText"
        :readonly="readonlyVal"
        @onSandboxChange="handleSandboxChange"
        :allow-other-model="allowOtherModelVal"
        :current-model-id="currentModelIdVal"
        :current-model-name="currentModelNameVal"
        :agent-id="agentId"
        :agent-type="agentTypeVal"
        :is-temp-chat="isTempChat"
        :current-agent-mode="agentMode"
        :allow-choose-mode="allowChooseMode"
        @onAgentModeChange="handleAgentModeChange"
        @onModelChange="handleModelChange"
      />
    </view>

    <!--图片列表-->
    <template v-if="hasUploadedFiles">
      <chat-upload-image
        class="container-block"
        :files="files"
        @onDel="handleDelFile"
      />
    </template>
    <!-- 首页与会话详情复用同一工具栏；附件栏在上、工具栏在下并一起随键盘抬升。 -->
    <view
      v-if="usesHomeLayout && safeManualComponents.length > 0"
      class="shared-home-tools"
    >
      <view v-if="homeDetailToolsExpanded != true" class="shared-home-tools__rowwrap">
        <scroll-view
          class="shared-home-tools__scroll"
          :scroll-x="true"
          :scroll-y="false"
          direction="horizontal"
          :show-scrollbar="false"
        >
          <view class="shared-home-tools__row" :style="sharedHomeToolsRowStyle">
            <view
              v-for="comp in safeManualComponents"
              :key="'shared-tool-' + comp.id"
              class="shared-home-tools__chip"
              :class="{ 'shared-home-tools__chip--on': isSharedHomeToolSelected(comp) }"
              @tap.stop="toggleSharedHomeTool(comp)"
            >
              <image v-if="comp.icon.length > 0" class="shared-home-tools__icon" :src="comp.icon" mode="aspectFit" />
              <text class="shared-home-tools__chip-text">{{ comp.name }}</text>
            </view>
          </view>
        </scroll-view>
        <view
          v-if="homeDetailToolsOverflow"
          class="shared-home-tools__toggle"
          @tap.stop="homeDetailToolsExpanded = true"
        >
          <text class="shared-home-tools__toggle-text">{{ t("Mobile.Chat.toolsExpand") }}</text>
        </view>
      </view>
      <view v-else class="shared-home-tools__expanded">
        <view
          class="shared-home-tools__toggle shared-home-tools__toggle--float"
          @tap.stop="homeDetailToolsExpanded = false"
        >
          <text class="shared-home-tools__toggle-text">{{ t("Mobile.Chat.toolsCollapse") }}</text>
        </view>
        <scroll-view class="shared-home-tools__panel" direction="vertical" :show-scrollbar="false">
          <view class="shared-home-tools__grid">
            <view
              v-for="comp in safeManualComponents"
              :key="'shared-tool-panel-' + comp.id"
              class="shared-home-tools__panel-item"
              :class="{ 'shared-home-tools__panel-item--on': isSharedHomeToolSelected(comp) }"
              @tap.stop="toggleSharedHomeTool(comp)"
            >
              <image v-if="comp.icon.length > 0" class="shared-home-tools__icon" :src="comp.icon" mode="aspectFit" />
              <text class="shared-home-tools__panel-text">{{ comp.name }}</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
    <view
      id="record-tip-container"
      class="record-tip-container"
      :class="{
        'remove-shadow': isRecording,
        'record-tip-container--with-extra': showExtraContainer,
        'record-tip-container--home': usesHomeLayout,
        'record-tip-container--quick-popup': quickPopupVisible,
        'record-tip-container--home-compact': usesHomeLayout && !isMultiLine && !isVoiceInput && !showExtraContainer && selectedTag.length == 0 && activeInputExpertId <= 0 && pinnedProjectName.length == 0 && workspaceDirLabel.length == 0 && spaceSelectorLabel.length == 0,
      }"
    >
      <!-- 无权限蒙层 -->
      <view class="permission-mask" v-if="showNoPermissionMask">
        <text class="permission-text">{{
          t("Mobile.Chat.noAgentPermission")
        }}</text>
      </view>
      <!-- 首页 @ 专家快捷浮层：锚定输入框上方，继续输入即搜索；仅首页挂载（内部 v-show 常驻保数据） -->
      <expert-quick-popup
        v-if="usesHomeLayout && quickPopupVisible && (quickPopupMode != 'expert' || allowExpertSelection)"
        ref="quickPopupListRef"
        :visible="quickPopupVisible"
        :mode="quickPopupMode"
        :keyword="quickPopupKeyword"
        :height="quickPopupHeightPx"
        :bottom="quickPopupBottomPx"
        :anchor-height="quickPopupAnchorHeightPx"
        :files="conversationFiles"
        @close="dismissQuickPopup"
        @select="handleQuickPopupSelect"
      />
      <!-- 推荐位选中上框（对齐 PC selectedTag）：输入框上方独立行，可清除；语音模式下保留展示，仅录音中隐藏 -->
      <view
        class="input-expert-row"
        v-if="selectedTag.length > 0 && !isRecording"
      >
        <view class="input-expert-pill">
          <agent-icon :icon="selectedTagIcon" :alt="selectedTag" :size="34" :margin-right="8" />
          <text class="input-expert-pill-name">{{ selectedTag }}</text>
          <view v-if="selectedTagClosable" class="input-expert-pill-remove" @click.stop="handleClearSelectedTag">
            <view class="input-expert-pill-remove-line input-expert-pill-remove-line--left" />
            <view class="input-expert-pill-remove-line input-expert-pill-remove-line--right" />
          </view>
        </view>
      </view>
      <!-- 专家单独一行，不再挤占输入框首行；位于 chips 行上方；语音模式下保留展示，仅录音中隐藏 -->
      <view
        class="input-expert-row"
        v-if="activeInputExpertId > 0 && !isRecording"
      >
        <view class="input-expert-pill">
          <agent-icon :icon="activeInputExpertIcon" :alt="activeInputExpertName" :size="34" :margin-right="8" />
          <text class="input-expert-pill-name">{{ activeInputExpertName }}</text>
          <view class="input-expert-pill-remove" @click.stop="clearActiveInputExpert">
            <view class="input-expert-pill-remove-line input-expert-pill-remove-line--left" />
            <view class="input-expert-pill-remove-line input-expert-pill-remove-line--right" />
          </view>
        </view>
      </view>
      <!-- MP 无富文本输入组件，chips 降级为独立行；App/H5 技能/资料为 editor 内 mention，可穿插在正文中 -->
      <!-- #ifdef MP -->
      <skill-tags-bar
        v-if="enableSkillAt || selectedDocs.length > 0"
        :selected-skills="selectedSkills"
        :selected-docs="selectedDocs"
        @onRemove="removeSkill"
        @onAdd="skillSelectModalVisible = true"
        @onRemoveDoc="removeSelectedDoc"
      />
      <!-- #endif -->
      <view
        class="chat-input-container"
        :class="{
          'multi-line': isMultiLine && !isVoiceInput,
          'is-recording': isRecording,
          'is-voice': isVoiceInput,
          'chat-input-container--home': usesHomeLayout,
        }"
      >
        <!--输入框-->
        <!-- placeholder-class：微信小程序placeholder样式无效 -->
        <!-- #ifndef MP -->
        <!-- editor 外壳：HX 5.21 前 App 端 min-height 覆盖不生效（editor 恒有 200px 最小高度），
             外壳用显式高度 + overflow hidden 裁剪，防止输入条被撑爆、遮挡下方内容 -->
        <view
          id="chat-input-editor-shell"
          class="editor-shell"
          :style="editorInlineStyle"
        >
          <editor
            v-if="isVoiceInput != true || keepAndroidInputMounted"
            ref="editorRef"
            id="chat-input-editor"
            class="rich-input"
            :style="editorInlineStyle"
            :type="null"
            :read-only="wholeDisabledVal || androidEditorDefocus"
            :placeholder="inputPlaceholderText"
            @ready="handleEditorReady"
            @input="handleEditorInput"
            @focus="onInputFocus"
            @blur="onInputBlur"
            @keydown="handleEditorKeydown"
          />
        </view>
        <!-- #endif -->
        <!-- #ifdef MP -->
        <textarea
          v-if="isVoiceInput != true || keepAndroidInputMounted"
          ref="inputRef"
          id="chat-input-textarea"
          class="input"
          :class="{ 'input-text': messageInfo?.length }"
          placeholder-class="input-placeholder"
          :value="messageInfo"
          :focus="isInputFocused"
          :cursor="textareaCursor"
          @input="handleInput"
          adjust-position="false"
          @keyboardheightchange="onKeyboardheightchange"
          :auto-height="true"
          @focus="onInputFocus"
          @blur="onInputBlur"
          @confirm="handleSendMessage"
          @linechange="handleLineChange"
          :placeholder="inputPlaceholderText"
          :show-confirm-bar="false"
          :maxlength="-1"
          :disable-default-padding="true"
        >
        </textarea>
        <!-- #endif -->
        <!-- Android：textarea 常驻在底层，语音面板后渲染并覆盖其上 -->
        <voice-recorder-button
          v-if="isVoiceInput"
          class="voice-recorder-button-full"
          :duration="600000"
          :is-conversation-active="isConversationActive"
          :enable-asr="enableVoice"
          :native-bridge="useNativeVoiceBridge"
          @onRecordPress="handleVoicePress"
          @onRecordStart="handleVoiceStart"
          @onRecordStop="handleVoiceStop"
          @onError="handleVoiceError"
          @onRecordCancel="handleRecordCancel"
          @onVisualActive="handleRecorderVisualActive"
          @onCancelZoneChange="handleCancelZoneChange"
        />
      </view>
      <!-- 独立于录音/textarea 内容层，Android 切模式时不会连带重建图标层 -->
      <view
        class="icon-wrap"
        :class="{ 'icon-wrap--multi-line': isMultiLine && !isVoiceInput }"
        v-if="!isRecording && !usesHomeLayout"
      >
        <view class="icon-container">
          <!-- 如果不存在输入内容，则显示输入方式 -->
          <template v-if="showInputMethodIcons">
            <!-- 容器和 svg-icon 常驻，只更新图标名 -->
            <view
              class="icon-action-hit"
              @click.stop.prevent="handleChangeInputMethod"
            >
              <!-- 点击容器常驻，仅切换内部图标；同一时刻只渲染一个固定名称的图标 -->
              <svg-icon
                v-if="isVoiceInput"
                name="icon-keyboard"
                size="48"
              />
              <svg-icon
                v-else
                name="icon-voice"
                size="48"
              />
            </view>
          </template>
          <!-- 正在会话中，则显示停止会话按钮 -->
          <template v-if="isConversationActive">
            <!-- 正在停止会话 loading -->
            <view
              v-if="isStoppingConversation"
              class="icon-action-hit"
            >
              <uni-icons
                class="icon-loop"
                type="loop"
                size="48rpx"
                color="#999"
              />
            </view>
            <!-- 停止会话 -->
            <view
              v-else
              class="icon-action-hit"
              @click.stop.prevent="handleStopConversation"
            >
              <svg-icon
                name="icon-stop-circle"
                customClass="icon-image"
                size="48"
              />
            </view>
          </template>
          <!-- 如果存在输入内容或图片文件，则显示发送按钮。没有输入内容和图片文件，则显示添加图片或文件按钮 -->
          <view
            v-else-if="showSendIcon"
            class="icon-action-hit"
            @click.stop.prevent="handleSendMessage"
          >
            <svg-icon
              name="icon-send"
              customClass="icon-send-image"
              size="48"
            />
          </view>
          <!-- 输入方式: 上传图片 -->
          <view
            v-else
            class="icon-action-hit"
            @click.stop.prevent="toggleExtraContainer"
          >
            <svg-icon
              name="icon-a-Pluscircle"
              customClass="icon-plus-image"
              size="48"
            />
          </view>
        </view>
      </view>
      <!-- 阴影面板（对齐 PC）：+ 号工具行与灰色项目/工作目录行共用一个圆角阴影容器 -->
      <view v-if="usesHomeLayout && !isRecording" class="home-capability-panel">
      <view class="home-capability-bar">
        <view
          class="home-action-button home-action-button--add"
          @click.stop.prevent="toggleExtraContainer"
        >
          <view class="home-plus-glyph">
            <view class="home-plus-line home-plus-line--horizontal" />
            <view class="home-plus-line home-plus-line--vertical" />
          </view>
        </view>
        <view
          v-if="(isTaskAgentVal || agentTypeVal == 'TaskAgent') && allowPrivateSandboxVal && hideComputerSelector != true"
          class="home-capability-pill"
          :class="{ 'home-capability-pill--disabled': isSandboxSwitchDisabled }"
          @click="openHomeComputerSheet"
        >
          <svg-icon name="icon-Globe" size="30" color="#5147ff" />
          <text class="home-capability-text">{{ selectedComputerName }}</text>
        </view>
        <view v-if="allowOtherModelVal" class="home-capability-pill" @click="modelSheetVisible = true">
          <image
            class="home-model-icon"
            :src="selectedModelIcon"
            mode="aspectFit"
            @error="handleSelectedModelIconError"
          />
          <text class="home-capability-text">{{ selectedModelName.length > 0 ? selectedModelName : t("Mobile.Chat.modelSelect") }}</text>
        </view>
        <view class="home-capability-spacer" />
        <view
          v-if="showInputMethodIcons"
          class="home-action-button"
          @click.stop.prevent="handleChangeInputMethod"
        >
          <svg-icon v-if="isVoiceInput" name="icon-keyboard" size="44" />
          <image v-else class="home-voice-icon" src="/static/images/icon-Mic.png" mode="aspectFit" />
        </view>
        <view v-if="isConversationActive" class="home-action-button">
          <uni-icons
            v-if="isStoppingConversation"
            class="icon-loop"
            type="loop"
            size="44rpx"
            color="#999"
          />
          <svg-icon
            v-else
            name="icon-stop-circle"
            size="44"
            color="#5147ff"
            @click.stop.prevent="handleStopConversation"
          />
        </view>
        <view
          v-else-if="showSendIcon"
          class="home-action-button"
          @click.stop.prevent="handleSendMessage"
        >
          <svg-icon name="icon-send" size="44" color="#5147ff" />
        </view>
      </view>

      <!-- 灰色行：上框项目 / 工作目录互斥（对齐 PC：上框期间目录条隐藏）+ 右侧空间选择，面板底部通栏 -->
      <view
        v-if="pinnedProjectName.length > 0 || workspaceDirLabel.length > 0 || spaceSelectorLabel.length > 0"
        class="input-card-bottom-bar"
      >
      <view v-if="pinnedProjectName.length > 0" class="input-card-bottom-inner">
        <image
          v-if="pinnedProjectIcon.length > 0"
          class="input-card-bottom-icon"
          :src="pinnedProjectIcon"
          mode="aspectFit"
        />
        <svg-icon v-else name="icon-Folder" size="34" color="#8a8a8a" />
        <text class="input-card-bottom-text">{{ pinnedProjectName }}</text>
        <view class="input-card-bottom-remove" @click.stop="handleClearPinnedClick">
          <text class="input-card-bottom-remove-text">✕</text>
        </view>
      </view>
      <view
        v-else-if="workspaceDirLabel.length > 0"
        class="input-card-bottom-inner input-card-bottom-inner--dir"
        @click="handleWorkspaceDirClick"
      >
        <svg-icon name="icon-Folder" size="34" color="#8a8a8a" />
        <text class="input-card-bottom-text">{{ workspaceDirLabel }}</text>
        <svg-icon name="icon-a-Chevrondown" size="24" color="#8a8a8a" />
      </view>
      <view class="input-card-bottom-spacer" />
      <!-- 空间选择（对齐 PC SpaceSelector）：项目行右侧，项目类推荐建项目时展示 -->
      <view
        v-if="spaceSelectorLabel.length > 0"
        class="input-card-bottom-inner input-card-bottom-inner--space"
        @click="handleSpaceClick"
      >
        <text class="input-card-bottom-text input-card-bottom-text--space">{{ spaceSelectorLabel }}</text>
        <svg-icon name="icon-a-Chevrondown" size="24" color="#8a8a8a" />
      </view>
      </view>
    </view>

    <!-- 按住说话：底部渐变录音层（覆盖输入区，不拦截触摸） -->
    <view
      class="record-overlay"
      :class="{
        'record-overlay--on': isRecording,
        'record-overlay--cancel': recordWillCancel,
      }"
    >
      <text class="record-overlay__hint">{{ recordOverlayHint }}</text>
      <view class="record-overlay__wave">
        <view class="record-overlay__baseline" />
        <view class="record-overlay__bars">
          <view
            v-for="(bar, index) in waveformBars"
            :key="index"
            class="record-overlay__bar"
            :style="{ height: `${bar.height}px` }"
          />
        </view>
      </view>
    </view>

    <!-- 功能栏 -->
    <view
      class="extra-container"
      :class="{ show: showExtraContainer }"
      v-if="showExtraContainer"
    >
      <view class="extra-box" @click="chooseImage('camera')">
        <view class="icon-box">
          <svg-icon name="icon-Camera" />
        </view>
        <text class="text">
          {{ t("Mobile.Chat.takePhoto") }}
        </text>
      </view>
      <view class="extra-box" @click="chooseImage('album')">
        <view class="icon-box">
          <svg-icon name="icon-Image" />
        </view>
        <text class="text">
          {{ t("Mobile.Chat.album") }}
        </text>
      </view>
      <view class="extra-box" @click="chooseFile">
        <view class="icon-box">
          <svg-icon name="icon-Folder" />
        </view>
        <text class="text">
          {{ t("Mobile.Chat.file") }}
        </text>
      </view>
      <view
        class="extra-box"
        v-if="enableSkillAt"
        @click="chooseSkill"
      >
        <view class="icon-box">
          <svg-icon name="icon-skill" />
        </view>
        <text class="text">
          {{ t("Mobile.Chat.skill") }}
        </text>
      </view>
    </view>
    <!-- 技能选择模态框 -->
    <skill-select-modal
      :visible="skillSelectModalVisible"
      @onClose="handleSkillModalClose"
      @onSelect="handleSkillSelect"
    />
    <model-select-sheet
      v-if="usesHomeLayout"
      :visible="modelSheetVisible"
      :agent-id="agentId"
      :agent-type="agentTypeVal"
      :current-model-id="selectedModelId"
      :avoid-tab-bar="isHomeScene"
      @close="modelSheetVisible = false"
      @sync="handleHomeModelSync"
      @select="handleHomeModelSelect"
    />
    <computer-select-sheet
      v-if="usesHomeLayout"
      :visible="computerSheetVisible"
      :agent-id="agentId"
      :current-value="selectedComputerId"
      :avoid-tab-bar="isHomeScene"
      @close="computerSheetVisible = false"
      @sync="handleComputerSync"
      @select="handleComputerSelect"
    />
    <composer-action-sheet
      v-if="usesHomeLayout"
      :visible="actionSheetVisible"
      :version-enabled="versionControlEnabled"
      :auto-commit-enabled="autoCommitEnabled"
      :approval-enabled="agentMode == 'ask'"
      :switch-disabled="wholeDisabledVal || isConversationActive"
      :show-skill="enableSkillAt"
      :show-expert="isHomeScene && allowExpertSelection"
      :avoid-tab-bar="isHomeScene"
      :agent-type="agentTypeVal"
      @close="actionSheetVisible = false"
      @action="handleComposerAction"
      @version-control-change="handleVersionControlChange"
      @auto-commit-change="handleAutoCommitChange"
      @approval-change="handleApprovalChange"
    />
    <expert-select-sheet
      v-if="isHomeScene && allowExpertSelection"
      :visible="expertSheetVisible"
      :avoid-tab-bar="isHomeScene"
      @close="handleExpertSheetClose"
      @select="handleExpertSelect"
    />
    <skill-select-sheet
      v-if="usesHomeLayout"
      :visible="skillSheetVisible"
      :avoid-tab-bar="isHomeScene"
      @close="skillSheetVisible = false"
      @select="handleHomeSkillSelect"
    />
    <connector-select-sheet
      v-if="usesHomeLayout"
      :visible="connectorSheetVisible"
      :avoid-tab-bar="isHomeScene"
      :initial-tab="connectorSheetInitialTab"
      @close="connectorSheetVisible = false"
    />
    <knowledge-select-sheet
      :visible="knowledgeSheetVisible"
      :avoid-tab-bar="isHomeScene"
      @close="knowledgeSheetVisible = false"
      @select="handleKnowledgeSelect"
    />
  </view>

    <!-- AI 生成提示：与 record-tip-container（阴影容器）同层，移出阴影范围 -->
    <view
      class="ai-generate-text-container"
      :class="{ 'ios-wechat': isIOSWechatMiniProgram }"
      :style="aiGenerateBottomStyle"
      >
      <text class="ai-generate-text">{{t("Mobile.Chat.aiGeneratedDisclaimer")}}</text>
    </view>
    <!-- 占位必须在固定高度输入卡片之外，才能撑高整个输入区并缩小消息列表。 -->
    <view
      class="keyboard-cover"
      :class="{ 'keyboard-cover--animate': keyboardCoverAnimate }"
      :style="keyboardCoverStyle"
    ></view>
  </view>
</template>

<script lang="uts" setup>
  import { buildEditorAtomicReplacementScript, applyEditorAtomicReplacementInWeb, resolveWebComposerQuill } from "@/utils/editorAtomicReplacement";
  import { detectComposerQuickTrigger } from "@/utils/composerQuickTrigger";
  import { observeWebComposer, buildComposerEditorObserverScript } from "@/utils/composerEditorObserver";
  import SkillSelectModal from "./skill-select-modal/skill-select-modal.uvue";
  import SkillTagsBar from "./skill-tags-bar/skill-tags-bar.uvue";
  import { SkillInfoForAt } from "@/types/interfaces/skill";
  import { UploadFileStatus } from "@/types/enums/common.uts";
  import ChatUploadImage from "./chat-upload-image/chat-upload-image.uvue";
  import ManualComponentItem from "./manual-component-item/manual-component-item.uvue";
  import VoiceRecorderButton from "./voice-recorder-button/voice-recorder-button.uvue";
  import ModelSelectSheet from "./model-select-sheet/model-select-sheet.uvue";
  import ComputerSelectSheet from "./computer-select-sheet/computer-select-sheet.uvue";
  import ComposerActionSheet from "./composer-action-sheet/composer-action-sheet.uvue";
  import ExpertSelectSheet from "./expert-select-sheet/expert-select-sheet.uvue";
  import ExpertQuickPopup from "./expert-quick-popup/expert-quick-popup.uvue";
  import SkillSelectSheet from "./skill-select-sheet/skill-select-sheet.uvue";
  import ConnectorSelectSheet from "./connector-select-sheet/connector-select-sheet.uvue";
  import KnowledgeSelectSheet from "./knowledge-select-sheet/knowledge-select-sheet.uvue";
  import AgentIcon from "@/components/agent-icon/agent-icon.uvue";
  import { stopAllSpeechPlayback } from "@/utils/voice/stopAllSpeechPlayback";
  import { getStatusBarHeight } from "@/utils/system";
  import { voiceStreamSpeaker } from "@/utils/voice/voiceStreamSpeaker";
  import { speechSocketWarmup } from "@/utils/voice/speechSocketWarmup";
  import { nativeVoiceBridge } from "@/utils/voice/nativeVoiceBridge";
  import {
    nativeMediaBridge,
    type NativeMediaPickedFile,
  } from "@/utils/voice/nativeMediaBridge";
  import { isAppWebViewEmbedded, isIosAppWebView } from "@/utils/appWebViewDetect";
  import {
    applyAppWebViewKeyboardChrome,
    dumpKeyboardDiag,
    resolveKeyboardCoverHeight,
    shouldAnimateKeyboardCover,
  } from "@/utils/appWebViewKeyboardChrome.uts";
  import {
    AgentManualComponentInfo,
    AgentSelectedComponentInfo,
  } from "@/types/interfaces/agent.uts";
  import { SelectedDocInfo } from "@/types/interfaces/knowledgeList";
  import {
    AgentComponentTypeEnum,
    DefaultSelectedEnum,
  } from "@/types/enums/agent.uts";
  import { ChatInputMethod } from "@/types/enums/chat.uts";
  import {
    DEFAULT_IMAGE_COUNT,
    DEFAULT_FILE_COUNT,
    CHAT_INPUT_METHOD,
  } from "@/constants/common.constants";
  import {
    MicrophonePermissionHelper,
    type PermissionState,
  } from "@/utils/permissionHelper";
  import { pageSystemOverlay } from "@/utils/pageSystemOverlay.uts";
  import { ExpandPageAreaEnum } from "@/types/enums/agent.uts";
  import { SandboxInfo } from "@/types/interfaces/sandbox";
  import { ChatSendMessageData } from "@/types/interfaces/chat";
  import { useI18n, toI18nParams, emptyI18nParams } from "@/utils/i18n";
  import { uploadSingleFile } from "@/utils/fileUploader.uts";
  import { apiUserConfigGet, apiChatboxConfigSet } from "@/servers/userConfig.uts";
  import { apiResCode, apiResData } from "@/utils/apiResponse.uts";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import {
    readAgentModeCache,
    writeAgentModeCache,
    type AgentMode,
  } from "@/utils/agentModeCache.uts";
  import { getCurrentInstance, nextTick, watch, type ComponentPublicInstance } from "vue";
  import {
    canSendChatMessage,
    computeWechatKeyboardOffset,
    filterSkillsRemainingInText,
    getSkillInsertPrefix,
    invertBoolean,
    isAtTypedOnInput,
    guessImageMimeFromPath,
    isImageChooseCancelled,
    isMessageEmptyForIcons,
    isSkillAlreadySelected,
    isUploadImageLike,
    isWholeDisabledSendBlocked,
    looksLikeImageFileName,
    shouldApplyAtCursorAfterSkillSelect,
    shouldInsertSkillAtCursor,
    shouldOpenSkillPickerOnAtInput,
    shouldRestoreCursorOnSkillModalClose,
    shouldShowSendButton,
    showManualComponentBar,
    stringContains,
    stringEndsWith,
  } from "./chatInputActions.uts";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  /** 模板用：单参翻译（useI18n 的 t 需全参，模板单参调用不匹配） */

  /** UTS 兼容：带 count 参数的翻译 */
  const tCount = (key: string, count: number): string => {
    const m = new Map<string, string | number>();
    m.set("count", count);
    return tFn(key, toI18nParams(m), "");
  };

  /** UTS 兼容：带 reason 参数的翻译 */
  const tReason = (key: string, reason: string): string => {
    const m = new Map<string, string | number>();
    m.set("reason", reason);
    return tFn(key, toI18nParams(m), "");
  };

  /** UTS 兼容：可空字符串兜底 */
  const coalesceString = (value: string | null): string => {
    if (value != null) {
      return value;
    }
    return "";
  };

  // 小程序 textarea 使用元素 ref；App/H5 editor 必须通过 EditorContext 操作。
  const inputRef = ref<UniTextareaElement | null>(null);
  let editorContext: EditorContext | null = null;
  const editorReady = ref<boolean>(false);
  const editorDelta = ref<any | null>(null);
  // App 原生 editor 不支持 CSS line-height（Android 编译器会明确告警），实际行距约 34rpx。
  // 用 34rpx 行增量 + 26rpx 首行内边距可保持单行 60rpx，并在 196rpx 时完整显示 5 行。
  const EDITOR_LINE_HEIGHT_RPX = 34;
  const EDITOR_VERTICAL_INSET_RPX = 26;
  const EDITOR_MAX_LINES = 5;
  // 首页输入区可用宽度约可容纳 22 个全角字符；半角英文/数字约占 0.55 个全角宽度。
  // 不能直接按 string.length / 20，否则英文约 3 行时就会被误判为 5 行并提前滚动。
  const EDITOR_WRAP_UNITS_PER_LINE = 22;
  const EDITOR_MIN_HEIGHT_RPX = EDITOR_LINE_HEIGHT_RPX + EDITOR_VERTICAL_INSET_RPX;
  const editorHeightRpx = ref<number>(EDITOR_MIN_HEIGHT_RPX);
  const componentInstance = getCurrentInstance();
  let lastEditorText: string = "";
  let lastEditorRawText: string = "";
  let syncingEditorContent: boolean = false;
  /** 输入框聚焦状态（editor/textarea 共用；focusChatInput 兜底判定也依赖，须先声明） */
  const isInputFocused = ref<boolean>(false);
  const editorRef = ref<UniEditorElement | null>(null);
  // Android：BACK 收起键盘后 editor 焦点悬挂，短暂只读强制断焦（也用于触摸层短按后恢复焦点）。
  const androidEditorDefocus = ref<boolean>(false);
  let androidEditorDefocusTimer: number = 0;

  /**
   * iOS 上组件 ref 在 editor 初始化早期可能仍为 null；官方 DOM API 能按 id 取得
   * UniEditorElement，作为点击聚焦的第二条可靠路径。
   */
  const resolveEditorElement = (): UniEditorElement | null => {
    const refEditor = editorRef.value;
    if (refEditor != null) return refEditor;
    // #ifndef MP
    try {
      const editorElement = uni.getElementById("chat-input-editor");
      if (editorElement != null) return editorElement as UniEditorElement;
    } catch (_eResolveEditor) {
      // ignore
    }
    // #endif
    return null;
  };

  /** UTS 兼容：安全聚焦输入框 */
  const focusChatInput = (): void => {
    // #ifdef MP
    const el = inputRef.value;
    if (el == null) return;
    (el as UniTextareaElement).focus();
    // #endif
    // #ifdef H5 || WEB
    // H5 兜底：直接聚焦 Quill 的 contenteditable 根节点
    try {
      const container = document.querySelector("#chat-input-editor .ql-container") as any | null;
      if (container != null && container.__quill != null) container.__quill.focus();
    } catch (_eFocusDom) {
      // ignore
    }
    // #endif
    // #ifdef APP
    // EditorContext 没有 focus API，但 UniEditorElement 从原生元素基类继承了 focus()。
    const editor = resolveEditorElement();
    // props 在本文件稍后声明；Android UTS 不支持在此处前向引用 props（error18）。
    console.log(`[conversation-input][focus-request] editor=${editor != null}, readonly=${androidEditorDefocus.value}`);
    if (editor != null) {
      editor.focus();
    }
    // #endif
  };

  // 文档
  // Android 会将 ref 内元素包装为响应式 JSON；附件全链路保持 JSON 对象以避免 class 强转。
  const files = ref<UTSJSONObject[]>([]);
  // 输入内容
  const messageInfo = ref<string>("");
  // 已选技能列表
  const selectedSkills = ref<SkillInfoForAt[]>([]);
  // 技能选择模态框可见状态
  const skillSelectModalVisible = ref<boolean>(false);
  const isMultiLine = ref<boolean>(false);
  const isEditorScrollable = ref<boolean>(false);
  // 键盘高度
  const keyboardHeight = ref<number>(0);
  // 首页编辑器上推距离（不直接使用键盘总高度，避免把输入卡抬过键盘上沿）。
  const homeKeyboardOffset = ref<number>(0);
  let homeInputBaseBottom: number = -1;
  /**
   * 原生注入的底部安全区（px）。App web-view 内嵌优先用它，
   * 避免鸿蒙 WebView/模拟器 env(safe-area-inset-bottom) 虚高。
   * -1 = 尚未注入。
   */
  const injectedSafeAreaBottom = ref<number>(-1);

  function readCachedInjectedSafeAreaBottom(): number {
    // #ifdef H5 || WEB
    try {
      const w = window as any;
      const raw = w.__nuwaxSafeAreaBottom;
      if (raw != null) {
        const n = parseFloat(`${raw}`);
        if (!isNaN(n) && n >= 0) {
          return n;
        }
      }
    } catch (_e) {
      // ignore
    }
    // #endif
    return -1;
  }

  // #ifdef APP
  /** App 全局键盘高度监听 id（onKeyboardHeightChange 返回值） */
  let appKeyboardHeightListenerId: number = 0;
  /** 部分自定义基座不派发 onKeyboardHeightChange，聚焦期间持续轮询 WindowInsets 兜底：
   *  IME 打开时读真实高度驱动上推；读数归零 = 键盘已收起（如 BACK 只收 IME 不失焦，
   *  该路径在自定义基座上没有其他归零通道），须同步清零让输入条回落，避免悬浮半空。 */
  let androidImePollTimer: number = 0;
  /** BACK 只收 IME 不失焦：原生 editor 悬挂焦点后，再 tap 不会触发 @focus / showSoftInput，
   *  键盘唤不回。按官方 readOnly 切换法强制断一次焦点，下次 tap 走完整聚焦流程。 */
  function scheduleAndroidEditorDefocus(): void {
    if (!isInputFocused.value) return;
    androidEditorDefocus.value = true;
    if (androidEditorDefocusTimer != 0) clearTimeout(androidEditorDefocusTimer);
    androidEditorDefocusTimer = setTimeout((): void => {
      androidEditorDefocusTimer = 0;
      androidEditorDefocus.value = false;
    }, 60) as number;
  }

  function readAndroidImeHeight(): number {
    // #ifdef APP-ANDROID
    try {
      const activity = UTSAndroid.getUniActivity();
      if (activity == null) return 0;
      const win = activity.getWindow();
      if (win == null) return 0;
      const decor = win.getDecorView();
      if (decor == null) return 0;
      const insets = decor.getRootWindowInsets();
      if (insets == null) return 0;
      const ime = insets.getInsets(8);
      if (ime == null || ime.bottom <= 0) return 0;
      const height = UTSAndroid.devicePX2px(ime.bottom);
      return height > 0 ? height : 0;
    } catch (_error) {
      return 0;
    }
    // #endif
    return 0;
  }

  function stopAndroidImePolling(): void {
    if (androidImePollTimer != 0) {
      clearTimeout(androidImePollTimer);
      androidImePollTimer = 0;
    }
  }

  function pollAndroidImeHeight(): void {
    androidImePollTimer = 0;
    const height = readAndroidImeHeight();
    if (height > 0) {
      if (keyboardHeight.value != height) {
        keyboardHeight.value = height;
      }
    } else if (keyboardHeight.value > 0) {
      keyboardHeight.value = 0;
      // #ifdef APP-ANDROID
      scheduleAndroidEditorDefocus();
      // #endif
    }
    if (isInputFocused.value) {
      // 已抬起后降频轮询（等打开动画期间用快频），只需捕捉收起沿
      const nextDelay = keyboardHeight.value > 0 ? 250 : 100;
      androidImePollTimer = setTimeout((): void => {
        pollAndroidImeHeight();
      }, nextDelay) as number;
    }
  }

  function startAndroidImePolling(): void {
    stopAndroidImePolling();
    // 聚焦瞬间先校准：IME 实际未开而残留旧值时清零，避免输入条跳到上一轮高度
    if (keyboardHeight.value > 0 && readAndroidImeHeight() <= 0) {
      keyboardHeight.value = 0;
    }
    androidImePollTimer = setTimeout((): void => {
      pollAndroidImeHeight();
    }, 60) as number;
  }
  /**
   * App 全局键盘高度（须声明在 onMounted 之前，避免 UTS 前向引用报错）。
   * 切语音后 textarea 已卸载，系统收起键盘仍会走这里。
   */
  function onAppKeyboardHeightChange(res: any): void {
    const hadVisibleKeyboard = keyboardHeight.value > 0;
    let h = 0;
    try {
      const obj = res as UTSJSONObject;
      const raw = obj["height"];
      if (raw != null) {
        const n = parseFloat(`${raw}`);
        if (!isNaN(n)) {
          h = n;
        }
      }
    } catch (_eObj) {
      // ignore
    }
    if (h > 0) {
      keyboardHeight.value = h;
    } else {
      keyboardHeight.value = 0;
      // #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
      homeKeyboardOffset.value = 0;
      // #endif
      // #ifdef APP-ANDROID
      if (hadVisibleKeyboard) scheduleAndroidEditorDefocus();
      // #endif
    }
  }
  // #endif

  // #ifdef H5 || WEB
  /**
   * App web-view 内嵌页：接收原生壳注入的键盘高度。
   * Android / iOS / 鸿蒙均由 agent-detail 原生页 onKeyboardHeightChange（Android 另有
   * WindowInsets 直读）注入完整 IME 高；H5 只存值驱动 keyboard-cover，并锁定文档滚动，
   * 避免 iOS / 鸿蒙整页 pan 把固定导航栏顶出屏。
   */
  function onInjectedKeyboardHeightChange(evt: any): void {
    try {
      const detail = (evt as any)["detail"] as UTSJSONObject | null;
      if (detail != null) {
        const raw = detail["height"];
        const safeRaw = detail["safeAreaBottom"];
        if (raw != null) {
          const h = parseFloat(`${raw}`);
          if (!isNaN(h)) {
            const next = h > 0 ? h : 0;
            const safeN =
              safeRaw != null ? parseFloat(`${safeRaw}`) : -1;
            if (!isNaN(safeN) && safeN >= 0) {
              injectedSafeAreaBottom.value = safeN;
            }
            console.log(
              "[kb-diag] chat-input recv injH=" +
                `${next}` +
                " coverH=" +
                `${resolveKeyboardCoverHeight(next)}` +
                " safeBottom=" +
                `${safeN}` +
                " prevInj=" +
                `${keyboardHeight.value}`,
            );
            keyboardHeight.value = next;
            applyAppWebViewKeyboardChrome(next);
            dumpKeyboardDiag(
              "chat-input-cover",
              next,
              resolveKeyboardCoverHeight(next),
            );
          }
        }
      }
    } catch (_eObj) {
      // ignore
    }
  }
  // #endif

  // 是否显示额外功能栏
  const showExtraContainer = ref<boolean>(false);
  // 输入方式
  const inputMethod = ref<ChatInputMethod>(ChatInputMethod.Input);
  // 模板用：当前是否语音输入（UTS 模板不能直接引用枚举类）
  const isVoiceInput = computed((): boolean => inputMethod.value == ChatInputMethod.Voice);
  /** Android 原生 EditText 常驻，避免语音转输入时新建原生控件产生一帧错位 */
  const keepAndroidInputMounted = computed((): boolean => {
    // #ifdef APP-ANDROID
    return true;
    // #endif
    // #ifndef APP-ANDROID
    return false;
    // #endif
  });
  // 是否正在录音（唯一跟随 voice-recorder-button 的 onVisualActive）
  const isRecording = ref<boolean>(false);
  /** 手指上移进入取消区 */
  const recordWillCancel = ref<boolean>(false);
  const recordOverlayHint = computed((): string => {
    if (recordWillCancel.value == true) {
      return t("Mobile.CreateHub.releaseToCancel");
    }
    return t("Mobile.CreateHub.releaseToSendSlideCancel");
  });
  // 已选组件列表
  const selectedComponents = ref<AgentSelectedComponentInfo[]>([]);
  const homeDetailToolsExpanded = ref<boolean>(false);
  /** 收起态工具行实测宽度；iOS 原生 flex 行不会自动按内容撑宽。 */
  const sharedHomeToolsRowWidthPx = ref<number>(0);
  // 当前 Agent 执行模式，默认自动
  const agentMode = ref<AgentMode>("yolo");
  // 录音时长计时器
  let durationTimer: number | null = null;

  // 波形动画数据
  class CreateHubWaveformBar {
    height: number;
    delay: number;
    constructor(height: number, delay: number) {
      this.height = height;
      this.delay = delay;
    }
  }
  const waveformBars = ref<CreateHubWaveformBar[]>([] as CreateHubWaveformBar[]);
  // 是否是 iOS 微信小程序
  const isIOSWechatMiniProgram = ref<boolean>(false);
  // 标记是否由输入 @ 触发
  const isAtTrigger = ref<boolean>(false);
  /** 点「+」主动 blur 时，跳过 onInputBlur 关闭额外栏，避免刚打开就被关掉 */
  let skipCloseExtraOnBlur = false;

  /** UTS 兼容：失焦并收起键盘（切语音前须先 blur，否则 Android 上 hideKeyboard 常无效） */
  const blurChatInput = (): void => {
    isInputFocused.value = false;
    try {
      // #ifdef MP
      const el = inputRef.value;
      if (el != null) {
        (el as UniTextareaElement).blur();
      }
      // #endif
      // #ifndef MP
      if (editorContext != null) editorContext!.blur(null);
      // #endif
    } catch (_eBlur) {
      // ignore
    }
    try {
      uni.hideKeyboard();
    } catch (_eHide) {
      // ignore
    }
  };

  /** 切换输入方式的延迟任务，快速连点时必须清掉，否则会打到过期状态 */
  let methodSwitchTimer: number = 0;

  function clearMethodSwitchTimer(): void {
    if (methodSwitchTimer != 0) {
      clearTimeout(methodSwitchTimer);
      methodSwitchTimer = 0;
    }
  }

  // 记录输入 @ 时的光标索引定位
  const atCursorIndex = ref<number>(-1);
  // 绑定文本框光标位置
  const textareaCursor = ref<number>(-1);

  const props = withDefaults(
    defineProps<{
      manualComponents?: AgentManualComponentInfo[];
      /** 当前会话的上下文文件树；仅详情页 @ 弹层使用。 */
      conversationFiles?: any[];
      defaultSelectedComponents?: AgentSelectedComponentInfo[];
      // 会话是否正在进行中（有消息正在处理）
      isConversationActive?: boolean;
      // 停止操作是否正在进行中
      isStoppingConversation?: boolean;
      // 是否禁用发送按钮
      wholeDisabled?: boolean;
      // 首页页面URL
      pageHomeIndex?: string;
      // 是否默认展开扩展页面区域
      expandPageArea?: number;
      isTaskAgent?: boolean;
      /** 是否设备智能体（设备智能体不显示工作台入口） */
      isDeviceAgent?: boolean;
      sandboxList?: SandboxInfo[];
      currentSandboxId?: string;
      isSandboxSwitchDisabled?: boolean;
      isSandboxUnavailable?: boolean;
      sandboxDisabledText?: string;
      hasPermission?: boolean;
      readonly?: boolean;
      enableSkillAt?: boolean;
      /** 推荐位选中上框文案（对齐 PC selectedTag；空 = 不显示） */
      selectedTag?: string;
      /** 上框图标 */
      selectedTagIcon?: string;
      /** 项目锁定的推荐专家不可单独移除。 */
      selectedTagClosable?: boolean;
      /** 上框项目锁定智能体类型时禁用所有首页专家选择入口。 */
      allowExpertSelection?: boolean;
      /** 外部指定 placeholder（推荐位自带；空 = 用场景默认文案） */
      inputPlaceholder?: string;
      // 模型选择相关
      allowOtherModel?: boolean;
      currentModelId?: number;
      currentModelName?: string;
      agentId?: number;
      agentType?: string;
      isTempChat?: boolean;
      // subscriptionRequired?: boolean;
      // 是否允许用户选择自动/审批模式
      allowChooseMode?: number;
      // 是否启用语音输入（录音 + ASR）。原生桥仅 App web-view 内嵌页开启，见 useNativeVoiceBridge
      enableVoice?: boolean;
      /** 首页使用 home；会话详情保持 conversation。 */
      scene?: string;
      /** 仅复用首页输入卡布局与工具入口，不改变会话页的发送/专家语义。 */
      homeLayout?: boolean;
      currentComputerName?: string;
      /** 智能体详情中的版本管理默认值；用户配置未建立时使用。 */
      agentEnableVersionControl?: number;
      summonedExpertId?: number;
      summonedExpertName?: string;
      summonedExpertIcon?: string;
      /** 当前智能体是否允许私有沙箱（对齐 PC allowPrivateSandbox：false=隐藏电脑选择器） */
      allowPrivateSandbox?: boolean;
      /** 隐藏电脑选择器（对齐 PC：项目上框期间沙箱由项目隐含） */
      hideComputerSelector?: boolean;
      /** 上框项目名（空 = 不显示卡底灰条的项目槽位） */
      pinnedProjectName?: string;
      /** 上框项目图标 */
      pinnedProjectIcon?: string;
      /** 工作目录灰条文案（空 = 隐藏；首页按 PC 条件算好传入） */
      workspaceDirLabel?: string;
      /** 空间选择文案（空 = 隐藏；项目类推荐选中时由首页传入） */
      spaceSelectorLabel?: string;
    }>(),
    {
      manualComponents: () => [],
      conversationFiles: () => [] as any[],
      isConversationActive: false,
      isStoppingConversation: false,
      wholeDisabled: false,
      isTaskAgent: false,
      isDeviceAgent: false,
      sandboxList: () => [],
      currentSandboxId: "",
      isSandboxSwitchDisabled: false,
      isSandboxUnavailable: false,
      sandboxDisabledText: "",
      hasPermission: true,
      readonly: false,
      enableSkillAt: true,
      selectedTag: "",
      selectedTagIcon: "",
      selectedTagClosable: true,
      allowExpertSelection: true,
      inputPlaceholder: "",
      allowOtherModel: false,
      currentModelId: 0,
      currentModelName: "",
      agentId: 0,
      agentType: "ChatBot",
      isTempChat: false,
      // subscriptionRequired: false,
      allowChooseMode: 0,
      enableVoice: true,
      scene: "conversation",
      homeLayout: false,
      currentComputerName: "",
      agentEnableVersionControl: 0,
      summonedExpertId: 0,
      summonedExpertName: "",
      summonedExpertIcon: "",
      allowPrivateSandbox: false,
      hideComputerSelector: false,
      pinnedProjectName: "",
      pinnedProjectIcon: "",
      workspaceDirLabel: "",
      spaceSelectorLabel: "",
    },
  );

  const isHomeScene = computed((): boolean => props.scene == "home");
  const usesHomeLayout = computed((): boolean => isHomeScene.value || props.homeLayout == true);

  let iosEditorLayoutQueued = false;
  function syncIOSHomeEditorViewport(): void {
    // #ifdef APP-IOS
    if (!isHomeScene.value || iosEditorLayoutQueued) return;
    iosEditorLayoutQueued = true;
    nextTick((): void => {
      if (!isInputFocused.value) { iosEditorLayoutQueued = false; return; }
      const editor = resolveEditorElement();
      const web = editor != null ? editor.querySelector("web-view") : null;
      if (web == null) { iosEditorLayoutQueued = false; return; }
      // iOS 真机实测：中文已写入 Quill，但 WKWebView viewport 为 0×0。
      // 临时增大内层 web-view 再恢复，能使视口恢复；外壳裁剪保持输入卡尺寸不变。
      const originalHeight = web.style.height.length > 0 ? web.style.height : "100%";
      const visibleHeight = web.getBoundingClientRect().height;
      console.log(`[conversation-input][ios-viewport-repair] height=${visibleHeight}`);
      const expanded = new Map<string, any>();
      expanded.set("height", `${Math.max(200, visibleHeight + 100)}px`);
      web.updateStyle(expanded);
      setTimeout((): void => {
        const restored = new Map<string, any>();
        restored.set("height", originalHeight);
        try {
          if (web.isConnected) web.updateStyle(restored);
        } finally {
          iosEditorLayoutQueued = false;
        }
      }, 120);
    });
    // #endif
  }

  /** 纯计算：输入卡底边相对键盘顶的重叠量（UTS→Kotlin 禁前向引用，
   *  measure/update 共用的计算拆到这里最先声明，打破二者互相调用的环）。 */
  function computeHomeKeyboardOffset(baseBottom: number, height: number): number {
    if (baseBottom <= 0 || height <= 0) return 0;
    let windowHeight = 0;
    try {
      const info = uni.getSystemInfoSync();
      // iOS 首页窗口高度已扣除 TabBar，键盘高度却以屏幕底部为基准。
      // 使用同一屏幕坐标，避免把 TabBar 高度重复计入上推距离。
      windowHeight = info.screenHeight != null ? info.screenHeight : 0;
    } catch (_error) {
      windowHeight = 0;
    }
    if (windowHeight <= 0) return 0;
    const keyboardTop = windowHeight - height;
    const offset = baseBottom - keyboardTop;
    return offset > 0 ? offset : 0;
  }

  function measureHomeInputBaseBottom(): void {
    if (!isHomeScene.value || componentInstance == null || componentInstance.proxy == null) return;
    const proxy = componentInstance.proxy;
    uni.createSelectorQuery()
      .in(proxy)
      .select(".ai-generate-text-container")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        if (results.length == 0 || results[0] == null) return;
        const rect = results[0] as NodeInfo;
        const top = rect.top != null ? parseFloat(`${rect.top}`) : 0;
        const height = rect.height != null ? parseFloat(`${rect.height}`) : 0;
        if (top > 0 && height > 0) {
          // bottom 是已应用偏移后的坐标，还原自然位置后只补实际遮挡。
          homeInputBaseBottom = top + height + homeKeyboardOffset.value;
          homeKeyboardOffset.value = isInputFocused.value
            ? computeHomeKeyboardOffset(homeInputBaseBottom, keyboardHeight.value) : 0;
        }
      });
  }

  function updateHomeKeyboardOffset(height: number): void {
    if (!isHomeScene.value || !isInputFocused.value || height <= 0) {
      homeKeyboardOffset.value = 0;
      return;
    }
    nextTick((): void => measureHomeInputBaseBottom());
    // 原生 resize 可能晚于高度事件；动画结束后重新读取，已消化的部分及时归零。
    setTimeout((): void => {
      if (keyboardHeight.value == height && isInputFocused.value) measureHomeInputBaseBottom();
    }, 180);
  }

  watch(keyboardHeight, (height: number): void => {
    // 三端都检查实际遮挡，不依据平台名称推断 resize 是否已完成。
    // #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
    updateHomeKeyboardOffset(height);
    // #endif
  });

  /** placeholder：推荐位自带文案优先，空则用场景默认（对齐 PC selectedRecommend.placeholder） */
  const inputPlaceholderText = computed((): string => {
    if (props.inputPlaceholder.length > 0) return props.inputPlaceholder;
    return usesHomeLayout.value ? t("Mobile.ConversationInput.sendPlaceholder") : t("Mobile.TempSession.inputPlaceholder");
  });
  const modelSheetVisible = ref<boolean>(false);
  const computerSheetVisible = ref<boolean>(false);
  const actionSheetVisible = ref<boolean>(false);
  const expertSheetVisible = ref<boolean>(false);
  // 首页 @专家 / /技能 快捷浮层（输入框上方，输入即搜索）
  const quickPopupVisible = ref<boolean>(false);
  const quickPopupMode = ref<string>("expert");
  // 快捷浮层键盘导航状态（对齐 PC focusIndex）：高亮索引 + 列表项总数
  const quickPopupFocusIndex = ref<number>(0);
  const quickPopupItemCount = ref<number>(0);
  const quickPopupListRef = ref<any | null>(null);
  const quickPopupKeyword = ref<string>("");
  // 浮层可用高度（px，0 = 未测量，用默认最大高度）
  const quickPopupHeightPx = ref<number>(0);
  // iOS page-container 从视口底部定位，记录输入卡顶边到视口底部的距离（px）。
  const quickPopupBottomPx = ref<number>(0);
  const quickPopupAnchorHeightPx = ref<number>(0);
  let quickPopupBlurTimer: number | null = null;
  let quickPopupFocusTimer: number | null = null;
  let quickPopupMeasureRequestId = 0;
  // 弹层抢焦点前保存触发范围，回填时按 Delta 坐标恢复插入点。
  let removingQuickTriggerText: boolean = false;
  let quickTriggerRemovalRequestId = 0;
  let quickTriggerStart = -1;
  let quickTriggerEnd = -1;
  let editorIndexedText = "";
  let editorInputCursor = 0;
  let stopComposerObserver: (() => void) | null = null;
  const skillSheetVisible = ref<boolean>(false);
  const connectorSheetVisible = ref<boolean>(false);
  // 连接器弹窗初始页签（对齐 PC：头像组入口落「已连接」聚合页签，普通入口落系统广场）
  const connectorSheetInitialTab = ref<string>("system");
  const knowledgeSheetVisible = ref<boolean>(false);

  // 会话场景已选专家（单选，参考 PC expertComponents：pill 即唯一事实源，随消息发送后清空）
  const sessionExpertId = ref<number>(0);
  const sessionExpertName = ref<string>("");
  const sessionExpertIcon = ref<string>("");
  const clearSessionExpert = (): void => {
    sessionExpertId.value = 0;
    sessionExpertName.value = "";
    sessionExpertIcon.value = "";
  };
  const activeInputExpertId = computed((): number => {
    return isHomeScene.value ? props.summonedExpertId : sessionExpertId.value;
  });
  const activeInputExpertName = computed((): string => {
    return isHomeScene.value ? props.summonedExpertName : sessionExpertName.value;
  });
  const activeInputExpertIcon = computed((): string => {
    return isHomeScene.value ? props.summonedExpertIcon : sessionExpertIcon.value;
  });
  const editorInlineStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    style["height"] = `${editorHeightRpx.value}rpx`;
    // App 端必须把高度同时写到 editor 本体，不能只裁剪外壳；否则旧版默认
    // min-height: 200px 的内容区不会在第五行后产生内部滚动。
    // UTSJSONObject 内联样式须使用驼峰键；连字符键在 iOS 聚焦后会被忽略，
    // editor 的默认 200px min-height 重新生效并把首页输入卡撑出大片空白。
    style["minHeight"] = "0px";
    style["maxHeight"] = `${EDITOR_LINE_HEIGHT_RPX * EDITOR_MAX_LINES + EDITOR_VERTICAL_INSET_RPX}rpx`;
    return style;
  });

  // 已选资料库文档（胶囊回显 + 随消息发送，字段对齐 PC 端 selectedDocs）
  const selectedDocs = ref<SelectedDocInfo[]>([] as SelectedDocInfo[]);
  const removeSelectedDoc = (index: number): void => {
    const next = [] as SelectedDocInfo[];
    for (let i = 0; i < selectedDocs.value.length; i++) {
      if (i != index) next.push(selectedDocs.value[i]);
    }
    selectedDocs.value = next;
  };
  const selectedModelId = ref<number>(props.currentModelId != null ? props.currentModelId : 0);
  const selectedModelName = ref<string>(props.currentModelName != null ? props.currentModelName : "");
  const selectedModelIcon = ref<string>("/static/images/icon-Brain.png");
  const selectedComputerId = ref<string>(props.currentSandboxId != null && props.currentSandboxId.length > 0 ? props.currentSandboxId : "-1");
  const selectedComputerName = ref<string>(props.currentComputerName != null && props.currentComputerName.length > 0 ? props.currentComputerName : t("Mobile.CreateHub.selectComputer"));
  const versionControlEnabled = ref<boolean>(props.agentEnableVersionControl == 1);
  const autoCommitEnabled = ref<boolean>(true);
  let chatboxConfigRequestId: number = 0;
  let chatboxConfigHydrated: boolean = false;
  let chatboxConfigUserMutated: boolean = false;

  function chatboxConfigKey(agentId: number): string {
    return `chatbox.config.${agentId}`;
  }

  async function loadHomeChatboxConfig(): Promise<void> {
    chatboxConfigRequestId += 1;
    const requestId = chatboxConfigRequestId;
    chatboxConfigHydrated = false;
    chatboxConfigUserMutated = false;
    versionControlEnabled.value = props.agentEnableVersionControl == 1;
    autoCommitEnabled.value = true;
    if (usesHomeLayout.value != true || props.agentId <= 0) {
      return;
    }
    const requestedAgentId = props.agentId;
    try {
      const res = await apiUserConfigGet(chatboxConfigKey(requestedAgentId));
      if (requestId != chatboxConfigRequestId || requestedAgentId != props.agentId) {
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const dataRaw = apiResData<any>(res);
      if (dataRaw == null) {
        return;
      }
      chatboxConfigHydrated = true;
      if (chatboxConfigUserMutated == true) {
        return;
      }
      const data = dataRaw as UTSJSONObject;
      versionControlEnabled.value = data["enableVersionControl"] == 1;
      autoCommitEnabled.value = data["autoCommit"] == 1;
      const modeRaw = data["mode"];
      const mode = modeRaw != null ? `${modeRaw}` : "";
      if (mode == "ask" || mode == "yolo") {
        agentMode.value = mode as AgentMode;
        writeAgentModeCache(agentMode.value, requestedAgentId);
      }
    } catch (_error) {
      // 偏好读取失败不阻塞输入；下次进入重新校正。
    }
  }

  async function persistHomeChatboxConfig(): Promise<void> {
    if (usesHomeLayout.value != true || props.agentId <= 0) {
      return;
    }
    const requestedAgentId = props.agentId;
    try {
      await apiChatboxConfigSet(
        chatboxConfigKey(requestedAgentId),
        agentMode.value,
        versionControlEnabled.value ? 1 : 0,
        autoCommitEnabled.value ? 1 : 0,
      );
    } catch (_error) {
      // 乐观更新保持当前交互；下次进入以服务端配置校正。
    }
  }

  /**
   * 原生语音桥仅 App web-view 内嵌 H5 才有。
   * 创建会话页是 uni-app x 原生页：native-bridge=true 会空等 WebView 回传，loading 永远不消失，也弹不出麦克风权限。
   */
  const useNativeVoiceBridge = computed((): boolean => {
    if (props.enableVoice != true) {
      return false;
    }
    return isAppWebViewEmbedded() == true;
  });

  /**
   * 键盘占位高度。
   * 聊天页 agent-detail 设了 softinputMode:nothing，窗口不随键盘收缩，必须靠 cover 顶起输入区。
   * 创建页没有 nothing：鸿蒙会把窗口收到键盘上方，再垫 cover 就会在输入框和键盘之间留出一整段空白。
   */
  const keyboardCoverHeight = computed((): number => {
    // 原生首页单独测量实际遮挡；不再叠加整段键盘 cover。
    // 三端首页都不能再垫完整键盘高度，否则输入卡下方会形成整块空白。
    // 会话详情使用 softinputMode:nothing，必须由共享组件的 cover 抬到键盘上方。
    // #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
    if (isHomeScene.value) return 0;
    return resolveKeyboardCoverHeight(keyboardHeight.value);
    // #endif
    // #ifndef APP-ANDROID || APP-HARMONY || APP-IOS
    return resolveKeyboardCoverHeight(keyboardHeight.value);
    // #endif
  });

  /**
   * 免责声明底部间距：
   * - 键盘弹起：清零（由 keyboard-cover 垫高）；
   * - App 内嵌：用原生 safeBottom，不用虚高的 env()；
   * - 浏览器直开：走 CSS env(safe-area-inset-bottom)。
   */
  const aiGenerateBottomStyle = computed((): UTSJSONObject => {
    const style: UTSJSONObject = {} as UTSJSONObject;
    // 是否弹出必须看原始键盘高度。resize 消化全部遮挡时 cover 为 0，但键盘仍在。
    if (keyboardHeight.value > 0) {
      style["marginBottom"] = "0px";
      style["paddingBottom"] = "4px";
      return style;
    }
    // #ifdef H5 || WEB
    if (isAppWebViewEmbedded() == true) {
      let px = injectedSafeAreaBottom.value;
      if (px < 0) {
        px = readCachedInjectedSafeAreaBottom();
        if (px >= 0) {
          injectedSafeAreaBottom.value = px;
        }
      }
      // 注入前也不用 env()，避免首屏虚高闪一下
      style["marginBottom"] = px >= 0 ? `${Math.round(px)}px` : "0px";
    }
    // #endif
    return style;
  });

  const keyboardCoverStyle = computed((): UTSJSONObject => {
    const style: UTSJSONObject = { height: keyboardCoverHeight.value + "px" };
    if (keyboardHeight.value > 0) style["marginBottom"] = "0px";
    return style;
  });

  /** iOS/鸿蒙：高度一次跳变，靠 CSS transition 对齐系统键盘动画 */
  const keyboardCoverAnimate = computed((): boolean => {
    return shouldAnimateKeyboardCover() == true;
  });

  /**
   * 供父组件通过 $callMethod 读取附件列表。
   * Android：Gen* 组件禁止 as UTSJSONObject 取 defineExpose 的 ref。
   */
  const getFiles = (): UTSJSONObject[] => {
    return files.value;
  };

  /**
   * 供父组件通过 $callMethod 读取已选组件。
   */
  const getSelectedComponents = (): AgentSelectedComponentInfo[] => {
    return selectedComponents.value;
  };


  const updateAgentModeByProps = (): void => {
    if (props.allowChooseMode != 1) {
      agentMode.value = "yolo";
      return;
    }
    const cachedAgentMode = readAgentModeCache(props.agentId);
    agentMode.value = cachedAgentMode == "ask" || cachedAgentMode == "yolo"
      ? cachedAgentMode
      : "yolo";
  };

  watch(
    (): number => props.agentId,
    (_agentId: number): void => {
      updateAgentModeByProps();
      loadHomeChatboxConfig();
    },
  );
  watch(
    (): number => props.allowChooseMode,
    (_allowChooseMode: number): void => updateAgentModeByProps(),
  );
  watch((): number => props.currentModelId != null ? props.currentModelId : 0, (value: number): void => { selectedModelId.value = value; });
  watch((): string => props.currentModelName != null ? props.currentModelName : "", (value: string): void => { selectedModelName.value = value; });
  watch((): string => props.currentSandboxId != null && props.currentSandboxId.length > 0 ? props.currentSandboxId : "-1", (value: string): void => { selectedComputerId.value = value; });
  watch((): string => props.currentComputerName != null ? props.currentComputerName : "", (value: string): void => {
    selectedComputerName.value = value.length > 0 ? value : t("Mobile.CreateHub.selectComputer");
  });
  watch(
    (): number => props.agentEnableVersionControl,
    (value: number): void => {
      if (chatboxConfigHydrated != true && chatboxConfigUserMutated != true) {
        versionControlEnabled.value = value == 1;
      }
    },
  );

  // 添加文件、图片等

  // 声明事件
  const emit = defineEmits<{
    (e: "onClearPinnedProject"): void;
    (e: "onOpenWorkspaceDirPicker"): void;
    (e: "onOpenSpaceSelector"): void;
    (e: 'onSendMessage', data: ChatSendMessageData): void;
    (e: 'onStopConversation'): void;
    (e: 'onOpenPagePreview', uri: string): void;
    (e: 'onOpenFileTree'): void;
    (e: 'onRequestConversationFiles'): void;
    (e: 'onSandboxChange', sandboxId: string): void;
    (e: 'onModelChange', modelId: number, name: string): void;
    (e: 'onScrollToLastMsg', smooth: boolean): void;
    (e: 'onComputerChange', computerId: string, name: string): void;
    (e: 'onOpenAction', action: string): void;
    (e: 'onFocusChange', focused: boolean): void;
    (e: 'onKeyboardOffsetChange', offset: number): void;
    (e: 'onQuickPopupVisibleChange', visible: boolean): void;
    (e: 'onExpertAgentSelect', item: UTSJSONObject): void;
    (e: 'onKnowledgeSelect', item: UTSJSONObject): void;
    (e: 'onClearExpert'): void;
    (e: 'onClearSelectedTag'): void;
    (e: 'onSelectedComponentsChange', components: AgentSelectedComponentInfo[]): void;
  }>();

  // 首页的工具栏由页面承载，不能只移动输入卡。把实测键盘避让量交给页面，
  // 由 create-hub__bottom 整体抬升工具栏、上传列表和输入区。
  watch(homeKeyboardOffset, (offset: number): void => {
    if (isHomeScene.value) emit("onKeyboardOffsetChange", offset);
  });

  watch(quickPopupVisible, (visible: boolean): void => {
    if (isHomeScene.value) emit("onQuickPopupVisibleChange", visible);
  });

  function clearActiveInputExpert(): void {
    if (isHomeScene.value) emit("onClearExpert");
    else clearSessionExpert();
  }

  /** 推荐位上框清除（对齐 PC onClearSelectedTag） */
  function handleClearSelectedTag(): void {
    emit("onClearSelectedTag");
  }

  // 切换沙盒
  const handleSandboxChange = (sandboxId: string) => {
    emit("onSandboxChange", sandboxId);
  };

  // 切换模型
  const handleModelChange = (modelId: number, name: string) => {
    selectedModelId.value = modelId;
    selectedModelName.value = name;
    emit("onModelChange", modelId, name);
  };

  const handleHomeModelChange = (modelId: number, name: string, providerIcon: string): void => {
    selectedModelIcon.value = providerIcon.length > 0 ? providerIcon : "/static/images/icon-Brain.png";
    handleModelChange(modelId, name);
  };

  const handleHomeModelSync = (modelId: number, name: string, providerIcon: string): void => {
    selectedModelIcon.value = providerIcon.length > 0 ? providerIcon : "/static/images/icon-Brain.png";
    if (selectedModelId.value == modelId && selectedModelName.value.length > 0) return;
    handleHomeModelChange(modelId, name, providerIcon);
  };

  const handleHomeModelSelect = (modelId: number, name: string, providerIcon: string): void => {
    handleHomeModelChange(modelId, name, providerIcon);
    modelSheetVisible.value = false;
  };

  const handleSelectedModelIconError = (): void => {
    selectedModelIcon.value = "/static/images/icon-Brain.png";
  };

  const handleComputerSelect = (computerId: string, name: string): void => {
    selectedComputerId.value = computerId;
    selectedComputerName.value = name;
    computerSheetVisible.value = false;
    emit("onSandboxChange", computerId);
    emit("onComputerChange", computerId, name);
  };

  const handleComputerSync = (computerId: string, name: string): void => {
    selectedComputerId.value = computerId;
    selectedComputerName.value = name;
    emit("onComputerChange", computerId, name);
  };

  // 打开文件树
  const handleOpenFileTree = () => {
    emit("onOpenFileTree");
  };

  // 停止会话
  const handleStopConversation = () => {
    showExtraContainer.value = false;
    emit("onStopConversation");
  };

  const handleOpenPagePreview = (uri: string) => {
    emit("onOpenPagePreview", uri);
  };

  const handleAgentModeChange = (mode: AgentMode): void => {
    agentMode.value = mode;
    writeAgentModeCache(mode, props.agentId);
  };

  // 初始化波形动画数据（中心高、两侧低的竖条，对齐豆包录音态）
  function computeEnvelopeBarHeight(index: number, numBars: number): number {
    if (numBars <= 1) {
      return 12;
    }
    const mid = (numBars - 1) / 2;
    const dist = Math.abs(index - mid) / mid;
    const envelope = 1 - dist * dist;
    const base = 4 + envelope * 26;
    const jitter = Math.random() * (4 + envelope * 8);
    return base + jitter;
  }

  const initWaveform = () => {
    const numBars = 42;
    const arr = [] as CreateHubWaveformBar[];
    for (let index = 0; index < numBars; index++) {
      arr.push(new CreateHubWaveformBar(computeEnvelopeBarHeight(index, numBars), 0));
    }
    waveformBars.value = arr;
  };

  const handleNuwaxAgentModeChanged = (payload: any): void => {
    const data = payload as UTSJSONObject;
    const agentIdRaw = data["agentId"];
    const modeRaw = data["mode"];
    const eventAgentId = agentIdRaw != null ? `${agentIdRaw}` : null;
    const eventMode = modeRaw != null ? `${modeRaw}` : "";
    const currentAgentKey = props.agentId > 0 ? `${props.agentId}` : null;
    if (
      eventAgentId === currentAgentKey &&
      (eventMode === "yolo" || eventMode === "ask")
    ) {
      agentMode.value = eventMode as AgentMode;
    }
  };

  // 确保组件挂载后也初始化波形和输入方式
  /**
   * iOS 兜底：@ready 在 iOS 真机上可能不触发（2026-09-19 实测 rdy:0，
   * context 永远拿不到 → 无 placeholder/无法聚焦）。挂载后轮询补取，
   * 与 @ready 路径幂等共存，谁先成功谁生效。
   */
  function ensureEditorContextRetry(attempt: number): void {
    // #ifndef MP
    if (editorReady.value == true || attempt > 12) return;
    if (componentInstance == null || componentInstance.proxy == null) return;
    uni.createEditorContextAsync({
      id: "chat-input-editor",
      component: componentInstance.proxy,
      success: (context: EditorContext): void => {
        if (editorReady.value == true) return;
        editorContext = context;
        editorReady.value = true;
        lastEditorText = messageInfo.value;
        lastEditorRawText = messageInfo.value;
        console.log(`[conversation-input][context-ready] retry=${attempt}`);
      },
      fail: (error: UniError): void => {
        console.warn(`[conversation-input][context-fail] retry=${attempt}, ${error.errMsg}`);
      },
    });
    if (editorReady.value != true) {
      setTimeout((): void => {
        ensureEditorContextRetry(attempt + 1);
      }, 600);
    }
    // #endif
  }

  onMounted(() => {
    // 初始化波形动画数据
    initWaveform();

    // 从缓存中读取输入方式
    const chatInputMethod = uni.getStorageSync(CHAT_INPUT_METHOD);
    if (chatInputMethod == "voice") {
      inputMethod.value = ChatInputMethod.Voice;
    } else if (chatInputMethod == "input") {
      inputMethod.value = ChatInputMethod.Input;
    }

    updateAgentModeByProps();
    loadHomeChatboxConfig();
    uni.$on("NuwaxAgentModeChanged", handleNuwaxAgentModeChanged);

    // 判断是否是 iOS 微信小程序
    // #ifdef MP-WEIXIN
    try {
      const systemInfo = uni.getSystemInfoSync();

      if (systemInfo.osName === "ios") {
        isIOSWechatMiniProgram.value = true;
      }
    } catch (e) {
      console.error("获取系统信息失败:", e);
    }
    // #endif

    // 小程序端首页页面，录音波形动画在开始录音时没有正常显示，需要延迟初始化，确保DOM已渲染
    // #ifdef MP-WEIXIN
    // 延迟初始化，确保DOM已渲染
    setTimeout(() => {
      if (waveformBars.value.length === 0) {
        initWaveform();
      }
    }, 100);
    // #endif

    // #ifdef APP
    appKeyboardHeightListenerId = uni.onKeyboardHeightChange(onAppKeyboardHeightChange);
    // #endif

    // #ifndef MP
    // iOS @ready 不触发时兜底补取 editor context（见 ensureEditorContextRetry 注释）
    setTimeout((): void => {
      ensureEditorContextRetry(0);
    }, 300);
    // #endif

    // #ifdef H5 || WEB
    // 内嵌 / 浏览器直开统一：接收原生壳注入的键盘高度（evalJS 写全局 + CustomEvent）。
    // Android / iOS / 鸿蒙内嵌由 agent-detail 注入；浏览器直开无原生壳，事件不触发，无副作用。
    try {
      const w = window as any;
      w.addEventListener("nuwax:keyboardHeightChange", onInjectedKeyboardHeightChange);
      // 桥注入可能早于本组件挂载（evalJS 先于渲染），读全局兜底一次
      const cachedSafe = readCachedInjectedSafeAreaBottom();
      if (cachedSafe >= 0) {
        injectedSafeAreaBottom.value = cachedSafe;
      }
      const cached = w.__nuwaxKeyboardHeight;
      // iOS 常驻壳：仅输入框聚焦时才采纳缓存键盘高度；否则清零，
      // 避免上次收起未写回 0 / 桥轮询复灌 LastH 留下「键盘高」幽灵空白。
      // Android / 鸿蒙（zhuoda 独立页壳）：保持原逻辑，始终恢复缓存高度。
      if (isIosAppWebView() == true) {
        let restoreH = 0;
        let inputFocused = false;
        try {
          const ae = document.activeElement;
          if (ae != null) {
            const tag = `${ae.tagName}`.toLowerCase();
            if (tag == "textarea" || tag == "input") {
              inputFocused = true;
            }
          }
        } catch (_eFocus) {
          inputFocused = false;
        }
        if (cached != null && inputFocused == true) {
          const h = parseFloat(`${cached}`);
          if (!isNaN(h) && h > 0) {
            restoreH = h;
          }
        }
        if (restoreH > 0) {
          keyboardHeight.value = restoreH;
          applyAppWebViewKeyboardChrome(restoreH);
        } else {
          w.__nuwaxKeyboardHeight = 0;
          keyboardHeight.value = 0;
          applyAppWebViewKeyboardChrome(0);
        }
      } else {
        if (cached != null) {
          const h = parseFloat(`${cached}`);
          if (!isNaN(h)) {
            const next = h > 0 ? h : 0;
            keyboardHeight.value = next;
            applyAppWebViewKeyboardChrome(next);
          }
        }
      }
    } catch (_eObj) {
      // ignore
    }
    // #endif
  });

  // 更新波形动画
  const updateWaveform = () => {
    const total = waveformBars.value.length;
    const arr = [] as CreateHubWaveformBar[];
    for (let index = 0; index < total; index++) {
      arr.push(new CreateHubWaveformBar(computeEnvelopeBarHeight(index, total), 0));
    }
    waveformBars.value = arr;
  };

  // 开始录音时长计时
  const startDurationTimer = () => {
    durationTimer = setInterval(() => {
      updateWaveform();
    }, 150);
  };

  // 停止录音时长计时
  const stopDurationTimer = () => {
    const t = durationTimer;
    if (t != null) {
      clearInterval(t);
      durationTimer = null;
    }
  };

  // 组件卸载时清理资源
  onUnmounted(() => {
    if (stopComposerObserver != null) stopComposerObserver!();
    stopComposerObserver = null;
    stopDurationTimer();
    clearMethodSwitchTimer();
    quickPopupMeasureRequestId += 1;
    quickTriggerRemovalRequestId += 1;
    removingQuickTriggerText = false;
    if (quickPopupBlurTimer != null) {
      clearTimeout(quickPopupBlurTimer!);
      quickPopupBlurTimer = null;
    }
    if (quickPopupFocusTimer != null) {
      clearTimeout(quickPopupFocusTimer!);
      quickPopupFocusTimer = null;
    }
    nativeMediaBridge.setResultHandler(null);
    uni.$off("NuwaxAgentModeChanged", handleNuwaxAgentModeChanged);
    // #ifdef APP
    if (appKeyboardHeightListenerId != 0) {
      uni.offKeyboardHeightChange(appKeyboardHeightListenerId);
      appKeyboardHeightListenerId = 0;
    }
    // #endif
    // #ifdef APP-ANDROID
    stopAndroidImePolling();
    if (androidEditorDefocusTimer != 0) {
      clearTimeout(androidEditorDefocusTimer);
      androidEditorDefocusTimer = 0;
    }
    // #endif

    // #ifdef H5 || WEB
    try {
      (window as any).removeEventListener(
        "nuwax:keyboardHeightChange",
        onInjectedKeyboardHeightChange,
      );
      // 组件卸载时解除文档滚动锁，避免残留 overflow:hidden
      applyAppWebViewKeyboardChrome(0);
    } catch (_eObj) {
      // ignore
    }
    // #endif
  });

  // 选择组件
  const handleToggleSelectComponent = (item: AgentSelectedComponentInfo) => {
    let found = false;
    // 详情页由会话状态持有工具选择。首页仍使用输入组件自己的选择副本。
    const controlled = usesHomeLayout.value && !isHomeScene.value;
    const list = controlled && props.defaultSelectedComponents != null
      ? props.defaultSelectedComponents : selectedComponents.value;
    const listLen = list.length;
    const next: AgentSelectedComponentInfo[] = [];
    for (let i = 0; i < listLen; i++) {
      if (list[i].id == item.id) {
        found = true;
      } else {
        next.push(list[i]);
      }
    }
    if (!found) next.push(item);
    selectedComponents.value = next;
    if (controlled) emit('onSelectedComponentsChange', next);
  };

  /** 首页形态工具栏：详情页与首页按组件 id 共用同一组选中状态。 */
  function isSharedHomeToolSelected(item: AgentManualComponentInfo): boolean {
    const list = usesHomeLayout.value && !isHomeScene.value && props.defaultSelectedComponents != null
      ? props.defaultSelectedComponents : selectedComponents.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].id == item.id) return true;
    }
    return false;
  }

  function toggleSharedHomeTool(item: AgentManualComponentInfo): void {
    handleToggleSelectComponent(new AgentSelectedComponentInfo(item.id, item.type));
  }

  // 监听 props.defaultSelectedComponents 变化并更新 selectedComponents
  watch(
    (): AgentSelectedComponentInfo[] | null => props.defaultSelectedComponents as AgentSelectedComponentInfo[] | null,
    (newValue: AgentSelectedComponentInfo[] | null) => {
      if (newValue != null) {
        selectedComponents.value = newValue;
      } else {
        const defaults = [] as AgentSelectedComponentInfo[];
        const manualList = props.manualComponents;
        const manualLen = manualList != null ? manualList.length : 0;
        for (let i = 0; i < manualLen; i++) {
          const list_ = props.manualComponents;
          if (list_ == null) {
            break;
          }
          const item = list_[i];
          if (item.defaultSelected == DefaultSelectedEnum.Yes) {
            defaults.push(new AgentSelectedComponentInfo(item.id, item.type));
          }
        }
        selectedComponents.value = defaults;
      }
    },
    { immediate: true, deep: true },
  );

  // 键盘高度变化（绑定在 textarea 上；语音模式下 textarea 已卸载，App 另见全局监听）
  const onKeyboardheightchange = (res: UniInputKeyboardHeightChangeEvent) => {
    // 微信小程序
    // #ifdef MP-WEIXIN
    if (res.detail.height > 31) {
      keyboardHeight.value = computeWechatKeyboardOffset(
        showExtraContainer.value,
      );
    } else {
      keyboardHeight.value = 0;
    }
    // #endif

    // 非微信小程序
    // #ifndef MP-WEIXIN
    keyboardHeight.value = res.detail.height;
    // #endif
  };

  // 生成文件唯一ID
  const getFileUid = () => {
    return Date.now().toString() + Math.floor(Math.random() * 1000000000).toString();
  };

  // UTS 跨模块会把 UTSJSONObject[] 导出参数降级为 Any[]，附件数组操作保留在组件内。
  // App chooseImage 无 type，需结合 name/url 扩展名判断（见 isUploadImageLike）。
  const countImageFiles = (fileList: UTSJSONObject[]): number => {
    let count = 0;
    for (let i = 0; i < fileList.length; i++) {
      const item = fileList[i];
      const type = item["type"] as string | null;
      const name = item["name"] as string | null;
      const url = item["url"] as string | null;
      if (
        isUploadImageLike(
          type != null ? type : "",
          name != null ? name : "",
          url != null ? url : "",
        ) == true
      ) {
        count++;
      }
    }
    return count;
  };

  const countNonImageFiles = (fileList: UTSJSONObject[]): number => {
    let count = 0;
    for (let i = 0; i < fileList.length; i++) {
      const item = fileList[i];
      const type = item["type"] as string | null;
      const name = item["name"] as string | null;
      const url = item["url"] as string | null;
      if (
        isUploadImageLike(
          type != null ? type : "",
          name != null ? name : "",
          url != null ? url : "",
        ) != true
      ) {
        count++;
      }
    }
    return count;
  };

  const hasUploadErrorInFiles = (fileList: UTSJSONObject[]): boolean => {
    for (let i = 0; i < fileList.length; i++) {
      if (fileList[i]["status"] == UploadFileStatus.error) {
        return true;
      }
    }
    return false;
  };

  const filterFilesExcludingUid = (
    fileList: UTSJSONObject[],
    uid: string,
  ): UTSJSONObject[] => {
    const result: UTSJSONObject[] = [];
    for (let i = 0; i < fileList.length; i++) {
      if (fileList[i]["uid"] != uid) {
        result.push(fileList[i]);
      }
    }
    return result;
  };

  // 计算已选择图片数量（UTS 不支持 reduce，逻辑见 countImageFiles）
  const imageCount = computed((): number => {
    return countImageFiles(files.value);
  });

  // 计算已选择文件数量
  const fileCount = computed((): number => {
    return countNonImageFiles(files.value);
  });

  // 计算是否显示添加按钮
  const showAddButton = computed((): boolean => {
    if (imageCount.value < DEFAULT_IMAGE_COUNT) {
      return true;
    }
    if (fileCount.value < DEFAULT_FILE_COUNT) {
      return true;
    }
    return false;
  });

  /** 模板 v-if：手动组件栏 */
  const showManualComponent = computed((): boolean => {
    const manualLen = props.manualComponents.length;
    let pageHome = "";
    if (props.pageHomeIndex != null) {
      pageHome = props.pageHomeIndex as string;
    }
    return showManualComponentBar(
      manualLen,
      isRecording.value,
      pageHome,
      props.expandPageArea != null ? props.expandPageArea! : 0,
      1,
      props.isTaskAgent,
      props.allowOtherModel,
    );
  });

  /** APP 端向子组件传递 boolean/string props 时使用 computed */
  const isTaskAgentVal = computed((): boolean => props.isTaskAgent == true);
  const isDeviceAgentVal = computed((): boolean => props.isDeviceAgent == true);
  const allowOtherModelVal = computed((): boolean => props.allowOtherModel == true);
  const allowPrivateSandboxVal = computed((): boolean => props.allowPrivateSandbox == true);

  /** 卡底灰条：移除上框项目（对齐 PC onClearPinnedProject） */
  function handleClearPinnedClick(): void {
    emit("onClearPinnedProject");
  }

  /** 卡底灰条：打开工作目录选择（sheet 由首页挂载） */
  function handleWorkspaceDirClick(): void {
    emit("onOpenWorkspaceDirPicker");
  }

  /** 灰行右侧：打开空间选择（sheet 由首页挂载） */
  function handleSpaceClick(): void {
    emit("onOpenSpaceSelector");
  }

  /** 首页电脑 pill：锁定云端（disablePersonalComputer）时不弹选择（对齐 PC cloudOnly） */
  function openHomeComputerSheet(): void {
    if (props.isSandboxSwitchDisabled == true) {
      return;
    }
    computerSheetVisible.value = true;
  }
  const readonlyVal = computed((): boolean => props.readonly == true);
  const wholeDisabledVal = computed((): boolean => props.wholeDisabled == true);
  const pageHomeIndexVal = computed((): string => {
    const index = props.pageHomeIndex;
    if (index == null) {
      return "";
    }
    return `${index}`;
  });
  const expandPageAreaVal = computed((): number => {
    const area = props.expandPageArea;
    if (area == null) {
      return 0;
    }
    return area;
  });
  const currentModelNameVal = computed((): string => {
    const name = props.currentModelName;
    if (name == null) {
      return "";
    }
    return `${name}`;
  });
  const currentModelIdVal = computed((): number => {
    const id = props.currentModelId;
    if (id == null) {
      return 0;
    }
    return id;
  });
  const agentTypeVal = computed((): string => {
    const typeVal = props.agentType;
    if (typeVal == null || `${typeVal}`.length == 0) {
      return "ChatBot";
    }
    return `${typeVal}`;
  });
  const sandboxListVal = computed((): SandboxInfo[] => {
    const list = props.sandboxList;
    if (list == null) {
      return [];
    }
    return list;
  });

  /** 模板 :manual-components 兜底 */
  const safeManualComponents = computed((): AgentManualComponentInfo[] => {
    return props.manualComponents;
  });

  // 与首页相同：工具较多时提供展开面板；少量工具保持一行并可横滑。
  const homeDetailToolsOverflow = computed((): boolean => {
    return safeManualComponents.value.length > 2;
  });

  const sharedHomeToolsRowStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    if (sharedHomeToolsRowWidthPx.value > 0) {
      style["width"] = `${sharedHomeToolsRowWidthPx.value}px`;
    }
    return style;
  });

  function sharedHomeToolsRpxToPx(rpx: number): number {
    const info = uni.getWindowInfo();
    const width = info.windowWidth != null ? info.windowWidth : 375;
    return rpx * width / 750;
  }

  /**
   * 收起态逐项实测总宽并显式写回行宽，避免 iOS/原生端 flex 行被压成视口宽、
   * scroll-view 看似开启却没有可滚动余量。
   */
  function measureSharedHomeToolsRow(attempt: number): void {
    if (usesHomeLayout.value != true || componentInstance == null || componentInstance.proxy == null) return;
    uni.createSelectorQuery()
      .in(componentInstance.proxy)
      .select(".shared-home-tools__scroll")
      .boundingClientRect()
      .selectAll(".shared-home-tools__chip")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        const ready = results.length >= 2 && results[0] != null && results[1] != null && Array.isArray(results[1]);
        if (ready != true) {
          if (attempt < 2) setTimeout((): void => measureSharedHomeToolsRow(attempt + 1), 180);
          return;
        }
        const viewport = results[0] as NodeInfo;
        const chips = results[1] as NodeInfo[];
        const viewportWidth = viewport.width != null ? parseFloat(`${viewport.width}`) : 0;
        let contentWidth = 0;
        for (let i = 0; i < chips.length; i++) {
          const chip = chips[i];
          contentWidth += chip.width != null ? parseFloat(`${chip.width}`) : 0;
        }
        contentWidth += chips.length * sharedHomeToolsRpxToPx(16);
        sharedHomeToolsRowWidthPx.value = contentWidth > viewportWidth + 1
          ? Math.ceil(contentWidth) + 2
          : 0;
      });
  }

  watch(safeManualComponents, (list: AgentManualComponentInfo[]): void => {
    homeDetailToolsExpanded.value = false;
    if (list.length == 0) {
      sharedHomeToolsRowWidthPx.value = 0;
      return;
    }
    setTimeout((): void => measureSharedHomeToolsRow(0), 120);
  });

  /** 模板 v-if：附件列表 */
  const hasUploadedFiles = computed((): boolean => {
    return files.value.length > 0;
  });

  /** 模板 v-if：无权限蒙层 */
  const showNoPermissionMask = computed((): boolean => {
    return props.hasPermission == false;
  });

  /**
   * 模板 v-if：显示语音/键盘切换图标。
   * 录音模式下始终显示（选技能会向 messageInfo 插入 @技能名，若仅按空文本判断，
   * 切换图标会被发送图标顶掉，用户将无法切回输入模式；与选相册表现保持一致）；
   * 输入模式下仅空内容时显示。
   */
  const showInputMethodIcons = computed((): boolean => {
    if (inputMethod.value == ChatInputMethod.Voice) {
      return true;
    }
    return isMessageEmptyForIcons(messageInfo.value);
  });

  /** 模板 v-if：显示发送按钮 */
  const showSendIcon = computed((): boolean => {
    return shouldShowSendButton(messageInfo.value, files.value.length);
  });

  // 前置间接引用（uploadMultipleFiles 定义在下方，UTS 不支持函数声明提升）
  let _uploadMultipleFiles: ((filePaths: string[]) => Promise<void>) | null = null;

  /**
   * App web-view 内嵌页原生媒体选择结果：把原生返回的文件列表喂给现有上传流程。
   * 非内嵌（浏览器/原生页/小程序）走 uni.chooseImage/chooseFile 的路径不受影响。
   */
  const handleNativeMediaResult = (
    success: boolean,
    action: string,
    pickedFiles: NativeMediaPickedFile[],
    cancelled: boolean,
    error: string,
  ) => {
    pageSystemOverlay.end();
    if (cancelled == true) {
      return;
    }
    if (success != true || pickedFiles.length == 0) {
      if (error.length > 0) {
        // iOS 常驻壳：原生侧应对 No Permission 弹引导窗，此处不再把英文裸错误 toast 给用户。
        // Android / 鸿蒙（zhuoda 壳）保持原行为：直接 toast 原生错误文本。
        // #ifdef H5 || WEB
        if (isIosAppWebView() == true) {
          const lower = error.toLowerCase();
          if (
            lower.indexOf("no permission") >= 0 ||
            lower.indexOf("permission denied") >= 0
          ) {
            return;
          }
        }
        // #endif
        uni.showToast({
          title: error,
          position: "bottom",
        });
      }
      return;
    }
    const isImage = action == "chooseImage";
    const _files = [] as UTSJSONObject[];
    for (let i = 0; i < pickedFiles.length; i++) {
      const f = pickedFiles[i];
      // 原生侧已上传完成：url/key 为后端返回结果，path 仅兜底
      const fileUrl = f.url;
      const resolvedUrl = fileUrl.length > 0 ? fileUrl : f.path;
      const fileSize = f.size;
      let resolvedName = f.name;
      if (resolvedName.length == 0) {
        const pathParts = resolvedUrl.split("/");
        if (pathParts.length > 0) {
          resolvedName = pathParts[pathParts.length - 1];
        }
        if (resolvedName.length == 0) {
          resolvedName = isImage ? "image.jpg" : "file";
        }
      }
      let resolvedType = f.type;
      if (resolvedType.length == 0) {
        resolvedType = isImage ? "image/jpeg" : "application/octet-stream";
      } else if (isImage && resolvedType.indexOf("image/") < 0) {
        // 后端未给 image/* 时按文件名扩展名兜底
        const guessed = guessImageMimeFromPath(resolvedName);
        if (guessed.indexOf("image/") >= 0) {
          resolvedType = guessed;
        }
      }
      const uploadFile = new UTSJSONObject();
      uploadFile["url"] = resolvedUrl;
      uploadFile["key"] = f.key;
      uploadFile["name"] = resolvedName;
      uploadFile["type"] = resolvedType;
      uploadFile["size"] = fileSize;
      uploadFile["status"] = UploadFileStatus.done;
      uploadFile["percent"] = 100;
      uploadFile["uid"] = getFileUid();
      _files.push(uploadFile);
    }
    files.value = [...files.value, ..._files];
    console.log("[Upload] native done count=" + _files.length);
  };

  // 选择文件
  const chooseFile = () => {
    // 如果已选择文件数量大于等于默认文件数量，则提示
    if (fileCount.value >= DEFAULT_FILE_COUNT) {
      uni.showToast({
        position: "bottom",
        title: tCount("Mobile.Chat.fileLimitReached", DEFAULT_FILE_COUNT),
      });
      return;
    }
    // 可选择文件数量
    const maxCount = DEFAULT_FILE_COUNT - fileCount.value;
    // 标记 overlay：避免选文件触发的 onHide 误暂停轮询 / 长隐藏恢复（与 ASR·TTS 无关）
    // Android 常先 App Show、后 complete；endOnNextShow 防 depth 泄漏
    pageSystemOverlay.begin("chooseFile", true);
    // App web-view 内嵌页：文件选择走原生（权限/系统选择器由原生处理），
    // 结果经 __onNativeMediaResult 回传复用现有上传流程；浏览器/原生页逻辑不变。
    // #ifdef H5 || WEB
    if (isAppWebViewEmbedded() == true) {
      nativeMediaBridge.setup();
      nativeMediaBridge.setResultHandler(handleNativeMediaResult);
      nativeMediaBridge.chooseFile(maxCount);
      return;
    }
    // #endif
    uni.chooseFile({
      type: "file",
      count: maxCount,
      success: (res) => {
        // 当前选择文件数量
        const uploadCount = res.tempFiles.length;
        // 如果当前选择图片数量大于可选择图片数量，则返回
        if (uploadCount > maxCount) {
          uni.showToast({
            title: tCount("Mobile.Chat.fileMaxSelect", maxCount),
            icon: "none",
            duration: 2000,
          });
          return;
        }

        const _files = res.tempFiles.map((file) => {
          const uploadFile = new UTSJSONObject();
          uploadFile["url"] = file.path;
          let resolvedName = "";
          if (file.name != null && `${file.name}`.length > 0) {
            resolvedName = `${file.name}`;
          } else {
            const pathParts = file.path.split("/");
            if (pathParts.length > 0) {
              resolvedName = pathParts[pathParts.length - 1];
            }
          }
          uploadFile["name"] = resolvedName;
          // App 常无 type；若扩展名是图片则补 image/*，否则保留空/原值
          let resolvedType = "";
          if (file.type != null && `${file.type}`.length > 0) {
            resolvedType = `${file.type}`;
          } else if (looksLikeImageFileName(resolvedName) == true || looksLikeImageFileName(file.path) == true) {
            resolvedType = guessImageMimeFromPath(
              resolvedName.length > 0 ? resolvedName : file.path,
            );
          }
          if (resolvedType.length > 0) {
            uploadFile["type"] = resolvedType;
          }
          uploadFile["size"] = file.size;
          uploadFile["status"] = UploadFileStatus.uploading;
          uploadFile["uid"] = getFileUid();
          return uploadFile;
        });
        files.value = [...files.value, ..._files];

        // 一次性上传所有选中的图片
        const filePaths = res.tempFiles.map((file) => file.path);
        if (_uploadMultipleFiles != null) {
          _uploadMultipleFiles!(filePaths);
        }
      },
      fail: (err) => {
        console.error("choose file: " + err.errMsg);
      },
      complete: () => {
        pageSystemOverlay.end();
      },
    });
  };

  // 选择技能
  const chooseSkill = () => {
    showExtraContainer.value = false;
    skillSelectModalVisible.value = true;
  };

  // 声明须在 updateEditorHeight 之前（UTS/Kotlin 前向引用 error18）
  function syncEditorScrollState(): void {
    // #ifdef H5 || WEB
    nextTick(() => {
      const root = document.getElementById("chat-input-editor") as any | null;
      if (root == null) return;
      const content = root.querySelector(".ql-editor") as any | null;
      if (content == null) return;
      content.style.overflowY = "auto";
      content.onscroll = (): void => {
        if (isEditorScrollable.value != true && content.scrollTop != 0) {
          content.scrollTop = 0;
        }
      };
      if (isEditorScrollable.value != true) content.scrollTop = 0;
    });
    // #endif
    // #ifdef APP || MP
    return;
    // #endif
  }

  function updateEditorHeight(text: string): void {
    const segments = text.split("\n");
    let lines = 0;
    for (let i = 0; i < segments.length; i++) {
      const segment = segments[i];
      let visualUnits = 0;
      for (let charIndex = 0; charIndex < segment.length; charIndex++) {
        const code = segment.charCodeAt(charIndex);
        if (code != null && code <= 0x007f) visualUnits += 0.55;
        else visualUnits += 1;
      }
      lines += Math.max(1, Math.ceil(visualUnits / EDITOR_WRAP_UNITS_PER_LINE));
    }
    const visibleLines = Math.max(1, Math.min(EDITOR_MAX_LINES, lines));
    // 1～5 行随内容增长；第 6 行开始保持五行高度，由 editor 自身滚动。
    // 额外 inset 仅用于完整绘制 mention 圆角，不参与行距计算。
    editorHeightRpx.value = visibleLines * EDITOR_LINE_HEIGHT_RPX + EDITOR_VERTICAL_INSET_RPX;
    isMultiLine.value = visibleLines > 1;
    isEditorScrollable.value = lines > EDITOR_MAX_LINES;
    syncEditorScrollState();
  }

  /** 剥掉 mention 名称的图标前缀（🔧 技能 / 📄 资料，历史兼容 "/"、"@"），得到纯名称 */
  function mentionDisplayName(name: string): string {
    let clean = name;
    if (clean.startsWith("🔧")) {
      clean = clean.substring("🔧".length);
    } else if (clean.startsWith("📄")) {
      clean = clean.substring("📄".length);
    } else if (clean.length > 1 && (clean.startsWith("/") || clean.startsWith("@"))) {
      clean = clean.substring(1);
    }
    if (clean.startsWith(" ")) clean = clean.substring(1);
    return clean;
  }

  /** editor 内 mention（技能/资料）→ 文本：统一序列化为 PC 约定的 @名称（输入态的图标前缀不外发） */
  function editorPlainTextFromDelta(deltaRaw: any | null): string {
    if (deltaRaw == null) return "";
    const opsRaw = (deltaRaw as UTSJSONObject)["ops"];
    if (!Array.isArray(opsRaw)) return "";
    const ops = opsRaw as any[];
    let text = "";
    for (let i = 0; i < ops.length; i++) {
      const op = ops[i] as UTSJSONObject;
      const insertRaw = op["insert"];
      if (insertRaw == null) continue;
      if (typeof insertRaw == "string") {
        text += `${insertRaw}`;
        continue;
      }
      const mentionRaw = (insertRaw as UTSJSONObject)["mention"];
      if (mentionRaw == null) continue;
      const mention = mentionRaw as UTSJSONObject;
      const id = mention["id"] != null ? `${mention["id"]}` : "";
      const name = mention["name"] != null ? `${mention["name"]}` : "";
      if (id.startsWith("context-file|")) {
        const encodedPath = id.substring("context-file|".length);
        const decodedPath = decodeURIComponent(encodedPath);
        text += `@${decodedPath != null ? decodedPath : mentionDisplayName(name)}`;
      } else {
        text += `@${mentionDisplayName(name)}`;
      }
    }
    if (text.endsWith("\n")) text = text.substring(0, text.length - 1);
    return text;
  }

  /** 编辑中删除 mention 时同步 selectedSkills/selectedDocs（chips 与 editor 单一数据源） */
  function syncMentionsFromEditorDelta(deltaRaw: any | null): void {
    const skills = [] as SkillInfoForAt[];
    const docs = [] as SelectedDocInfo[];
    if (deltaRaw == null) {
      selectedSkills.value = skills;
      selectedDocs.value = docs;
      return;
    }
    const delta = deltaRaw as UTSJSONObject;
    const opsRaw = delta["ops"];
    if (!Array.isArray(opsRaw)) return;
    const ops = opsRaw as any[];
    for (let i = 0; i < ops.length; i++) {
      const op = ops[i] as UTSJSONObject;
      const insertRaw = op["insert"];
      if (insertRaw == null || typeof insertRaw == "string") continue;
      const insertObj = insertRaw as UTSJSONObject;
      const mentionRaw = insertObj["mention"];
      if (mentionRaw == null) continue;
      const mention = mentionRaw as UTSJSONObject;
      const idRaw = mention["id"];
      const nameRaw = mention["name"];
      const id = idRaw != null ? `${idRaw}` : "";
      const name = mentionDisplayName(nameRaw != null ? `${nameRaw}` : "");
      if (id.startsWith("skill|")) {
        const targetId = parseInt(id.substring(6));
        if (targetId > 0) {
          const skill = new SkillInfoForAt();
          skill.id = targetId;
          skill.targetId = targetId;
          skill.name = name;
          skills.push(skill);
        }
      } else if (id.startsWith("doc|")) {
        const parts = id.split("|");
        if (parts.length >= 2) {
          const doc = new SelectedDocInfo();
          const slugPart = parts[1];
          const decodedSlug = slugPart != null ? decodeURIComponent(slugPart) : null;
          doc.slugId = decodedSlug != null ? decodedSlug : "";
          doc.title = name;
          const pageTypePart = parts.length >= 3 ? parts[2] : null;
          const decodedPageType = pageTypePart != null ? decodeURIComponent(pageTypePart) : null;
          doc.pageType = decodedPageType != null ? decodedPageType : "";
          docs.push(doc);
        }
      }
    }
    selectedSkills.value = skills;
    selectedDocs.value = docs;
  }

  function setEditorPlainText(text: string): void {
    // #ifndef MP
    if (editorContext == null || editorReady.value != true) return;
    const insert = new UTSJSONObject();
    insert["insert"] = text.length > 0 ? `${text}\n` : "\n";
    const ops: UTSJSONObject[] = [] as UTSJSONObject[];
    ops.push(insert);
    const delta = new UTSJSONObject();
    delta["ops"] = ops;
    syncingEditorContent = true;
    editorContext!.setContents({
      delta,
      complete: (_res: any): void => { syncingEditorContent = false; },
    });
    // #endif
  }

  function clearEditorContent(): void {
    // #ifndef MP
    if (editorContext != null && editorReady.value == true) editorContext!.clear(null);
    editorDelta.value = null;
    lastEditorText = "";
    editorHeightRpx.value = EDITOR_MIN_HEIGHT_RPX;
    isMultiLine.value = false;
    isEditorScrollable.value = false;
    syncEditorScrollState();
    // #endif
  }

  /** 光标处插入技能/资料 chip。字号与行高继承正文，仅保留紧凑的水平留白。 */
  function insertEditorMention(kind: string, id: string, name: string): void {
    // #ifndef MP
    // App 端点选弹层时 editor 会先 blur；和弹层销毁同一轮调用 insertMention 会被原生焦点切换吞掉。
    setTimeout((): void => {
      if (editorContext == null || editorReady.value != true) return;
      const isSkill = kind == "skill";
      editorContext!.insertMention({
          id: `${kind}|${id}`,
          name,
          color: isSkill ? "#5147ff" : "#5f5f69",
          background: isSkill ? "#eee9ff" : "#f2f1f6",
          radius: "999px",
          success: (_res: UniEditorElementOptionsSuccessRes): void => {
            // 空格必须在 mention 成功后插入，否则原生异步队列可能先写空格、后丢 mention。
            if (editorContext == null) return;
            editorContext!.insertText({
              text: " ",
              complete: (_insertRes: UniEditorElementOptionsCompleteRes): void => {
                if (editorContext != null) editorContext!.scrollIntoView(null);
              },
            });
          },
          fail: (res: UniEditorElementOptionsFailRes): void => {
            console.warn("[conversation-input] insertMention failed:", res.errMsg);
          },
      });
    }, 0);
    // #endif
  }

  function handleEditorReady(): void {
    // #ifndef MP
    console.log("[conversation-input][editor-ready-event]");
    if (componentInstance == null || componentInstance.proxy == null) return;
    const proxy = componentInstance.proxy;
    uni.createEditorContextAsync({
      id: "chat-input-editor",
      component: proxy,
      success: (context: EditorContext): void => {
        editorContext = context;
        editorReady.value = true;
        lastEditorText = messageInfo.value;
        lastEditorRawText = messageInfo.value;
        syncEditorScrollState();
        console.log("[conversation-input][context-ready] event");
      },
      fail: (error: UniError): void => {
        console.warn(`[conversation-input][context-fail] event, ${error.errMsg}`);
      },
    });
    // #endif
  }

  function findSingleInsertedCharacter(previous: string, current: string): string {
    if (current.length != previous.length + 1) return "";
    let index = 0;
    while (index < previous.length && previous[index] == current[index]) index++;
    return current.substring(index, index + 1);
  }

  /** @ 触发字符后允许的搜索字符（对齐 PC：字母/数字/汉字/-_./，空格等出现即视为结束） */
  function isAtSearchChar(ch: string): boolean {
    if (ch.length != 1) return false;
    const code = ch.charCodeAt(0);
    if (code == null) return false;
    const c = code as number;
    if (c >= 48 && c <= 57) return true;
    if (c >= 65 && c <= 90) return true;
    if (c >= 97 && c <= 122) return true;
    if (c >= 0x4e00 && c <= 0x9fa5) return true;
    return ch == "-" || ch == "_" || ch == "." || ch == "/";
  }

  function isAtWhitespaceChar(ch: string): boolean {
    return ch == " " || ch == "\n" || ch == "\t" || ch == "\r" || ch == "　";
  }

  /**
   * 对齐 PC detectMention：对当前全文判定（不依赖单字符 diff，中文输入法组合输入/全角＠均兼容）。
   * @ 须位于行首或空白之后；@ 后的搜索词仅允许字母/数字/汉字/-_./。
   */
  function detectQuickTrigger(text: string, trigger: string, alternate: string = ""): UTSJSONObject {
    const res = new UTSJSONObject();
    res["hasMention"] = false;
    res["searchText"] = "";
    const primary = text.lastIndexOf(trigger);
    const secondary = alternate.length > 0 ? text.lastIndexOf(alternate) : -1;
    const at = Math.max(primary, secondary);
    if (at < 0) return res;
    if (at > 0 && isAtWhitespaceChar(text.charAt(at - 1)) != true) return res;
    const search = text.substring(at + 1);
    for (let i = 0; i < search.length; i++) {
      if (isAtSearchChar(search.charAt(i)) != true) return res;
    }
    res["hasMention"] = true;
    res["searchText"] = search;
    return res;
  }

  /** 浮层高度取 640rpx 与当前可视视口内输入框上方空间的较小值。 */
  function measureQuickPopupSpace(showAfterMeasure: boolean = false): void {
    if (componentInstance == null || componentInstance.proxy == null) return;
    const requestId = quickPopupMeasureRequestId + 1;
    quickPopupMeasureRequestId = requestId;
    const requestedMode = quickPopupMode.value;
    const requestedKeyword = quickPopupKeyword.value;
    const proxy = componentInstance.proxy;
    uni.createSelectorQuery()
      .in(proxy)
      .select("#record-tip-container")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        if (requestId != quickPopupMeasureRequestId ||
          requestedMode != quickPopupMode.value ||
          requestedKeyword != quickPopupKeyword.value) return;
        if (results.length == 0 || results[0] == null) return;
        const rect = results[0] as NodeInfo;
        quickPopupAnchorHeightPx.value = rect.height != null ? parseFloat(`${rect.height}`) : 0;
        const top = rect.top != null ? parseFloat(`${rect.top}`) : 0;
        if (top <= 0) return;
        let reservedTop = getStatusBarHeight() + 8;
        let viewportBottom = 0;
        // #ifdef H5 || WEB
        try {
          const vv = window.visualViewport;
          if (vv != null) {
            const vvTop = vv.offsetTop != null ? vv.offsetTop : 0;
            const vvHeight = vv.height != null ? vv.height : 0;
            reservedTop = Math.max(reservedTop, vvTop + 8);
            if (vvHeight > 0) viewportBottom = vvTop + vvHeight;
          }
          // 会话详情内嵌页的固定导航栏也属于不可覆盖区；首页不存在时自然跳过。
          const nav = document.querySelector(".layout-fixed") as any | null;
          if (nav != null) {
            const navRect = nav.getBoundingClientRect();
            if (navRect != null && navRect.bottom != null) {
              reservedTop = Math.max(reservedTop, parseFloat(`${navRect.bottom}`) + 8);
            }
          }
        } catch (_eViewport) {
          // ignore
        }
        // #endif
        // 快捷面板与输入卡片上沿保留 4px 间距，并覆盖卡片上方的会话工具栏。
        const gap = 4;
        const systemInfo = uni.getSystemInfoSync();
        if (viewportBottom <= 0) {
          viewportBottom = systemInfo.windowHeight != null ? systemInfo.windowHeight : 0;
        }
        const anchorTop = viewportBottom > 0 ? Math.min(top, viewportBottom) : top;
        const available = Math.max(0, anchorTop - gap - reservedTop);
        const windowWidth = systemInfo.windowWidth != null ? systemInfo.windowWidth : 375;
        const maxHeight = Math.round((windowWidth / 750) * 640);
        const height = Math.floor(Math.min(maxHeight, available));
        quickPopupHeightPx.value = height;
        // iOS 的普通 z-index 无法越过外层原生 scroll-view。快捷面板由 page-container
        // 提升到页面顶层后，以该距离在输入卡上方保持原锚点。
        quickPopupBottomPx.value = Math.max(0, Math.round(viewportBottom - anchorTop + gap));
        if (showAfterMeasure) quickPopupVisible.value = true;
      });
  }

  function callQuickListMethod(method: string, arg: number = -1): void {
    const list = quickPopupListRef.value;
    if (list == null) return;
    const proxy = list as ComponentPublicInstance;
    if (arg >= 0) {
      proxy.$callMethod(method, arg);
    } else {
      proxy.$callMethod(method);
    }
  }

  function refreshQuickPopupCount(): void {
    const list = quickPopupListRef.value;
    if (list == null) return;
    const proxy = list as ComponentPublicInstance;
    const count = proxy.$callMethod("getItemCount") as number | null;
    quickPopupItemCount.value = count != null ? (count as number) : 0;
  }

  function resetQuickPopupNav(): void {
    quickPopupFocusIndex.value = 0;
    callQuickListMethod("setHighlightIndex", 0);
  }

  function openQuickPopup(mode: string, keyword: string): void {
    const shouldRequestFiles = mode == "file" && (quickPopupVisible.value != true || quickPopupMode.value != "file");
    if (quickPopupBlurTimer != null) {
      clearTimeout(quickPopupBlurTimer!);
      quickPopupBlurTimer = null;
    }
    showExtraContainer.value = false;
    quickPopupMode.value = mode;
    quickPopupKeyword.value = keyword;
    if (shouldRequestFiles) emit("onRequestConversationFiles");
    if (quickPopupVisible.value != true) measureQuickPopupSpace(true);
    else measureQuickPopupSpace();
    // 键盘导航（对齐 PC resetSelectedIndex）：打开即取列表项数并复位高亮
    refreshQuickPopupCount();
    resetQuickPopupNav();
  }

  function closeQuickPopup(): void {
    quickPopupMeasureRequestId += 1;
    if (quickPopupFocusTimer != null) {
      clearTimeout(quickPopupFocusTimer!);
      quickPopupFocusTimer = null;
    }
    if (quickPopupBlurTimer != null) {
      clearTimeout(quickPopupBlurTimer!);
      quickPopupBlurTimer = null;
    }
    quickPopupVisible.value = false;
    quickPopupKeyword.value = "";
    quickPopupHeightPx.value = 0;
    quickPopupBottomPx.value = 0;
  }

  watch((): boolean => props.allowExpertSelection, (allowed: boolean): void => {
    if (allowed == true) return;
    expertSheetVisible.value = false;
    if (quickPopupMode.value == "expert") closeQuickPopup();
  });

  function quickPopupMove(step: number): void {
    const list = quickPopupListRef.value;
    if (list == null) return;
    const total = quickPopupItemCount.value;
    if (total <= 0) return;
    let next = quickPopupFocusIndex.value + step;
    if (next < 0) next = 0;
    if (next > total - 1) next = total - 1;
    quickPopupFocusIndex.value = next;
    callQuickListMethod("setHighlightIndex", next);
  }

  function quickPopupPickCurrent(): void {
    const list = quickPopupListRef.value;
    if (list == null) return;
    callQuickListMethod("pickHighlight");
  }

  /** 快捷浮层键盘导航（对齐 PC MentionEditor keydown）：↑/↓ 移动高亮、Enter 选中、Esc 关闭。
      editor 的 @keydown 目前仅 H5 存在（uni-app x App 端无此事件，绑定不触发）；
      事件对象用 any + UTSJSONObject 取值，避免 H5 专属类型名在 Kotlin/Swift 编译失败。 */
  function handleEditorKeydown(e: any | null): void {
    if (e == null || quickPopupVisible.value != true) return;
    const evt = e as UTSJSONObject;
    const detailRaw = evt["detail"];
    const detail = detailRaw != null ? (detailRaw as UTSJSONObject) : null;
    const keyRaw = detail != null ? detail["key"] : null;
    const keyCodeRaw = detail != null ? detail["keyCode"] : null;
    const key = keyRaw != null ? `${keyRaw}` : (keyCodeRaw != null ? `${keyCodeRaw}` : "");
    if (key == "ArrowUp" || key == "38") {
      quickPopupMove(-1);
    } else if (key == "ArrowDown" || key == "40") {
      quickPopupMove(1);
    } else if (key == "Enter" || key == "13") {
      quickPopupPickCurrent();
    } else if (key == "Escape" || key == "27") {
      closeQuickPopup();
    }
  }

  function syncQuickPopupFromText(rawText: string): void {
    const trigger = detectComposerQuickTrigger(rawText, editorInputCursor, 0, false,
      props.enableSkillAt, !isHomeScene.value || props.allowExpertSelection);
    if (trigger == null) { closeQuickPopup(); return; }
    quickTriggerStart = trigger["start"] as number;
    quickTriggerEnd = trigger["end"] as number;
    openQuickPopup(trigger["mode"] == "skill" ? "skill" : (isHomeScene.value ? "expert" : "file"), `${trigger["keyword"]}`);
  }

  function handleComposerEditorState(state: UTSJSONObject): void {
    // #ifdef APP-IOS
    if (state["viewportCollapsed"] == true && state["composing"] != true) syncIOSHomeEditorViewport();
    // #endif
    if (syncingEditorContent || removingQuickTriggerText) return;
    const cursor = state["cursor"] as number;
    const length = state["length"] as number;
    const reason = `${state["reason"]}`;
    // blur 由现有延迟处理，给候选项点击保留完成插入的机会。
    if (cursor < 0 && reason == "selection") return;
    if (state["composing"] == true || reason == "dismiss" || reason == "paste" || reason == "programmatic" || length != 0 || cursor < 0) {
      closeQuickPopup();
      return;
    }
    const text = `${state["text"]}`;
    editorInputCursor = cursor;
    if (reason == "selection") {
      // 移动光标不唤起；离开原触发区间就关闭，不重写触发范围。
      if (cursor != quickTriggerEnd || text != editorIndexedText) closeQuickPopup();
      return;
    }
    if (reason == "edit") syncQuickPopupFromText(text);
  }

  function installComposerObserver(): void {
    // #ifdef H5 || WEB
    if (stopComposerObserver != null) stopComposerObserver!();
    stopComposerObserver = null;
    const q = resolveWebComposerQuill();
    if (q != null) stopComposerObserver = observeWebComposer(q, handleComposerEditorState);
    // #endif
    // #ifdef APP
    const editor = resolveEditorElement();
    const web = editor != null ? editor.querySelector("web-view") : null;
    let watchIOSViewport = false;
    // #ifdef APP-IOS
    watchIOSViewport = isHomeScene.value;
    // #endif
    if (web != null) (web as UniWebViewElement).evalJS(buildComposerEditorObserverScript(watchIOSViewport));
    // #endif
  }


  /** Delta 的文本坐标：embed 统一占一位，与 Quill 的选区索引一致。 */
  function indexedEditorText(deltaRaw: any | null): string {
    if (deltaRaw == null) return "";
    const ops = (deltaRaw as UTSJSONObject)["ops"] as UTSJSONObject[] | null;
    if (ops == null) return "";
    let result = "";
    for (let i = 0; i < ops.length; i++) {
      const value = ops[i]["insert"];
      result += typeof value == "string" ? `${value}` : "\ufffc";
    }
    return result.endsWith("\n") ? result.substring(0, result.length - 1) : result;
  }


  /** 四端共用：将删除、插入、恢复选区合并为一次局部编辑。 */
  function replaceQuickTriggerAtomically(mode: string, mention: UTSJSONObject | null, done: (() => void) | null): void {
    // #ifndef MP
    if (editorContext == null || removingQuickTriggerText) return;
    const start = quickTriggerStart;
    const end = quickTriggerEnd;
    if (start < 0 || end <= start) return;
    const requestId = ++quickTriggerRemovalRequestId;
    removingQuickTriggerText = true;
    const fail = (): void => {
      if (requestId != quickTriggerRemovalRequestId) return;
      removingQuickTriggerText = false;
      syncingEditorContent = false;
      console.warn("[conversation-input] atomic replacement unavailable or editor changed");
    };
    editorContext!.getContents({
      success: (res: UniEditorElementGetContentsOptionsRes): void => {
        if (requestId != quickTriggerRemovalRequestId || editorContext == null) return;
        const text = indexedEditorText(res.delta);
        const trigger = text.substring(start, start + 1);
        if (end > text.length || (mode == "skill" ? trigger != "/" : trigger != "@" && trigger != "＠")) { fail(); return; }
        const ops: UTSJSONObject[] = [];
        if (start > 0) ops.push({ retain: start });
        ops.push({ delete: end - start });
        if (mention != null) {
          ops.push({ insert: { mention: mention } });
          ops.push({ insert: " " });
        }
        const cursor = start + (mention != null ? 2 : 0);
        const expectedResult = text.substring(0, start) + (mention != null ? "\ufffc " : "") + text.substring(end);
        const change: UTSJSONObject = { ops: ops };
        const payload: UTSJSONObject = { expected: text, change: change, cursor: cursor };
        syncingEditorContent = true;
        // #ifdef H5 || WEB
        const quill = resolveWebComposerQuill();
        if (!applyEditorAtomicReplacementInWeb(quill, payload)) { fail(); return; }
        // #endif
        // #ifdef APP
        // App 三端 editor 都由内部 WebView 承载 Quill。
        // 只通过元素的 evalJS 桥调用；不修改 SDK，不使用 clear/setContents 兜底。
        const editor = resolveEditorElement();
        const web = editor != null ? editor.querySelector("web-view") : null;
        if (web == null) { fail(); return; }
        (web as UniWebViewElement).evalJS(buildEditorAtomicReplacementScript(payload));
        // #endif
        // 与 evalJS 排在同一 editor WebView 队列之后，确认写入成功再更新外部选中态。
        editorContext!.getContents({
          success: (updated: UniEditorElementGetContentsOptionsRes): void => {
            if (requestId != quickTriggerRemovalRequestId) return;
            if (indexedEditorText(updated.delta) != expectedResult) { fail(); return; }
            editorDelta.value = updated.delta;
            editorIndexedText = expectedResult;
            lastEditorRawText = updated.text != null ? `${updated.text}` : expectedResult;
            lastEditorText = editorPlainTextFromDelta(updated.delta);
            messageInfo.value = lastEditorText;
            editorInputCursor = cursor;
            updateEditorHeight(lastEditorText);
            syncMentionsFromEditorDelta(updated.delta);
            quickTriggerStart = -1;
            quickTriggerEnd = -1;
            removingQuickTriggerText = false;
            syncingEditorContent = false;
            if (done != null) done();
          },
          fail: (_error: UniEditorElementOptionsFailRes): void => fail(),
        });
      },
      fail: (_error: UniEditorElementOptionsFailRes): void => fail(),
    });
    // #endif
  }

  /** 按触发时保存的范围删除。 */
  function removeQuickTriggerText(mode: string, afterRemove: (() => void) | null): void {
    // #ifndef MP
    replaceQuickTriggerAtomically(mode, null, afterRemove);
    return;
    // #endif
    // #ifdef MP
    const detected = detectQuickTrigger(messageInfo.value, mode == "skill" ? "/" : "@", mode == "skill" ? "" : "＠");
    if (detected["hasMention"] == true) {
      messageInfo.value = messageInfo.value.substring(0, messageInfo.value.length - `${detected["searchText"]}`.length - 1);
      textareaCursor.value = messageInfo.value.length;
    }
    if (afterRemove != null) afterRemove();
    return;
    // #endif
  }

  /** 关闭建议不修改草稿；重新聚焦也不自动唤起。 */
  function dismissQuickPopup(): void {
    closeQuickPopup();
  }

  function handleEditorInput(e: UniEditorInputEvent): void {
    // 观测快照不重复解析/回填内容，避免选区变化也触发整个工具栏更新。
    // #ifdef APP
    const state = (e.detail.delta as UTSJSONObject)["__nuwaxComposer"] as UTSJSONObject | null;
    if (state != null) { handleComposerEditorState(state); return; }
    // #endif
    let rawText = e.detail.text != null ? `${e.detail.text}` : "";
    if (rawText.endsWith("\n")) rawText = rawText.substring(0, rawText.length - 1);
    lastEditorRawText = rawText;
    const value = editorPlainTextFromDelta(e.detail.delta);
    lastEditorText = value;
    messageInfo.value = value;
    editorDelta.value = e.detail.delta;
    const indexed = indexedEditorText(e.detail.delta);
    if (syncingEditorContent != true && removingQuickTriggerText != true) {
      let suffix = 0;
      while (suffix < editorIndexedText.length && suffix < indexed.length &&
        editorIndexedText.charAt(editorIndexedText.length - suffix - 1) == indexed.charAt(indexed.length - suffix - 1)) suffix++;
      editorInputCursor = indexed.length - suffix;
    }
    editorIndexedText = indexed;
    updateEditorHeight(value);
    syncMentionsFromEditorDelta(e.detail.delta);
    if (syncingEditorContent == true || removingQuickTriggerText == true) return;
    // 弹层仅由编辑来源快照控制，普通 input 不猜测光标和输入来源。
  }

  watch(
    (): string => messageInfo.value,
    (value: string): void => {
      if (editorReady.value == true && value != lastEditorText) {
        closeQuickPopup();
        lastEditorText = value;
        updateEditorHeight(value);
        setEditorPlainText(value);
      }
    },
  );

  watch(
    (): number => keyboardHeight.value,
    (): void => {
      if (quickPopupVisible.value == true) nextTick(() => measureQuickPopupSpace());
    },
  );

  // 选中技能
  const handleSkillSelect = (skill: SkillInfoForAt) => {
    skillSelectModalVisible.value = false; // 关闭选择技能弹框

    const alreadySelected = isSkillAlreadySelected(
      selectedSkills.value,
      skill.id,
    );
    if (alreadySelected == false) {
      selectedSkills.value = [...selectedSkills.value, skill];
    }

    // #ifndef MP
    // 技能以 chip（mention）插到光标处，可穿插在正文中间
    insertEditorMention("skill", skill.targetId.toString(), skill.name);
    isAtTrigger.value = false;
    atCursorIndex.value = -1;
    return;
    // #endif

    // #ifdef MP
    const _rawText: string = messageInfo.value;
    let text: string = coalesceString(_rawText);
    const index = atCursorIndex.value;
    let targetCursor: number = -1;

    const insertAtCursor = shouldInsertSkillAtCursor(
      isAtTrigger.value,
      index,
      text.length,
    );
    if (insertAtCursor == true) {
      // 在光标位置原地补全
      const before = text.substring(0, index - 1);
      const after = text.substring(index);
      const addedText = `@${skill.name} `;
      text = before + addedText + after;
      targetCursor = before.length + addedText.length;
    } else {
      // 降级处理（末尾追加）
      let tempText = text;
      const endsWithAt = stringEndsWith(tempText, "@");
      if (isAtTrigger.value == true) {
        if (endsWithAt == true) {
          tempText = tempText.slice(0, -1);
        }
      }
      const prefix = getSkillInsertPrefix(tempText);
      const addedText = prefix + `@${skill.name} `;
      text = tempText + addedText;
      targetCursor = tempText.length + addedText.length;
    }

    messageInfo.value = text;
    const triggerWasActive = isAtTrigger.value;
    isAtTrigger.value = false; // 重置状态
    atCursorIndex.value = -1; // 重置光标位置

    const shouldSetCursor = shouldApplyAtCursorAfterSkillSelect(
      triggerWasActive,
      targetCursor,
    );
    if (shouldSetCursor == true) {
      textareaCursor.value = targetCursor;
    }

    // #ifdef MP-WEIXIN
    isInputFocused.value = false;
    setTimeout(() => {
      isInputFocused.value = true;
      setTimeout(() => {
        textareaCursor.value = -1;
      }, 50);
    }, 50);
    // #endif

    // #ifndef MP-WEIXIN
    nextTick(() => {
      focusChatInput();
      setTimeout(() => {
        textareaCursor.value = -1;
      }, 100);
    });
    // #endif
    // #endif
  };

  // 关闭技能选择框时的回调
  const handleSkillModalClose = () => {
    skillSelectModalVisible.value = false;

    const shouldRestore = shouldRestoreCursorOnSkillModalClose(
      isAtTrigger.value,
      atCursorIndex.value,
    );
    if (shouldRestore == true) {
      textareaCursor.value = atCursorIndex.value;

      // #ifdef MP-WEIXIN
      isInputFocused.value = false;
      setTimeout(() => {
        isInputFocused.value = true;
        setTimeout(() => {
          textareaCursor.value = -1;
        }, 50);
      }, 50);
      // #endif

      // #ifndef MP-WEIXIN
      nextTick(() => {
        focusChatInput();
        setTimeout(() => {
          textareaCursor.value = -1;
        }, 100);
      });
      // #endif
    }

    isAtTrigger.value = false;
    atCursorIndex.value = -1;
    // #ifndef MP
    nextTick(() => focusChatInput());
    // #endif
  };

  // 移除技能
  const removeSkill = (index: number) => {
    const skill = selectedSkills.value[index];
    if (skill != null) {
      selectedSkills.value.splice(index, 1);
      // #ifdef MP
      // MP 的 @名称 是光标处插入的正文，需同步清除；App/H5 正文不含 chip 文本
      const mentionWithSpace = `@${skill.name} `;
      const mention = `@${skill.name}`;

      let text: string = coalesceString(messageInfo.value);

      // 本地变量操作，避免对 messageInfo.value 作多次 Response 促发
      while (stringContains(text, mentionWithSpace) == true) {
        text = text.replace(mentionWithSpace, "");
      }
      while (stringContains(text, mention) == true) {
        text = text.replace(mention, "");
      }
      messageInfo.value = text;
      // #endif
    }
  };

  // 拍照或相册选择图片
  const chooseImage = (type: string) => {
    // 如果已选择图片数量大于等于默认图片数量，则提示
    if (imageCount.value >= DEFAULT_IMAGE_COUNT) {
      uni.showToast({
        position: "bottom",
        title: tCount("Mobile.Chat.imageLimitReached", DEFAULT_IMAGE_COUNT),
      });
      return;
    }
    // 可选择图片数量
    const maxCount = DEFAULT_IMAGE_COUNT - imageCount.value;
    let sourceTypeItem = "album";
    if (type == "camera") {
      sourceTypeItem = "camera";
    }
    console.log(
      "[Upload] chooseImage invoke type=" + sourceTypeItem + " maxCount=" + maxCount
    );
    // 标记 overlay：避免相册/相机 onHide 误暂停轮询 / 长隐藏恢复（与 ASR·TTS 无关）
    // endOnNextShow 兜底 complete 晚于 onShow 的机型
    pageSystemOverlay.begin("chooseImage." + sourceTypeItem, true);
    // App web-view 内嵌页：拍照/相册走原生（权限 + 系统选择器由原生处理），
    // 结果经 __onNativeMediaResult 回传复用现有上传流程；浏览器/原生页逻辑不变。
    // #ifdef H5 || WEB
    if (isAppWebViewEmbedded() == true) {
      nativeMediaBridge.setup();
      nativeMediaBridge.setResultHandler(handleNativeMediaResult);
      nativeMediaBridge.chooseImage(sourceTypeItem, maxCount);
      return;
    }
    // #endif
    uni.chooseImage({
      sourceType: [sourceTypeItem],
      sizeType: ["compressed"],
      count: maxCount,
      success: (res) => {
        console.log("[Upload] chooseImage success enter");
        try {
          // App 官方示例优先 tempFilePaths；tempFiles 可能缺字段，做兼容
          const pathList = [] as string[];
          const pathsFromApi = res.tempFilePaths;
          if (pathsFromApi != null) {
            for (let pi = 0; pi < pathsFromApi.length; pi++) {
              const p = pathsFromApi[pi];
              if (p != null && `${p}`.length > 0) {
                pathList.push(`${p}`);
              }
            }
          }
          const tempFiles = res.tempFiles;
          if (pathList.length == 0 && tempFiles != null) {
            for (let fi = 0; fi < tempFiles.length; fi++) {
              const f = tempFiles[fi];
              if (f != null && f.path != null && `${f.path}`.length > 0) {
                pathList.push(`${f.path}`);
              }
            }
          }
          const uploadCount = pathList.length;
          const tempFilesLen = tempFiles != null ? tempFiles.length : -1;
          console.log(
            "[Upload] chooseImage paths=" + uploadCount + " tempFiles=" + tempFilesLen
          );
          if (uploadCount == 0) {
            console.warn("[Upload] chooseImage empty paths");
            return;
          }
          if (uploadCount > maxCount) {
            uni.showToast({
              title: tCount("Mobile.Chat.imageMaxSelect", maxCount),
              icon: "none",
              duration: 2000,
            });
            return;
          }

          const _files = [] as UTSJSONObject[];
          for (let i = 0; i < pathList.length; i++) {
            const filePath = pathList[i];
            let fileSize = 0;
            let resolvedName = "";
            let resolvedType = "";
            if (tempFiles != null && i < tempFiles.length) {
              const file = tempFiles[i];
              if (file != null) {
                fileSize = file.size;
                if (file.name != null && `${file.name}`.length > 0) {
                  resolvedName = `${file.name}`;
                }
                if (file.type != null && `${file.type}`.length > 0) {
                  resolvedType = `${file.type}`;
                }
              }
            }
            if (resolvedName.length == 0) {
              const pathParts = filePath.split("/");
              if (pathParts.length > 0) {
                resolvedName = pathParts[pathParts.length - 1];
              }
              if (resolvedName.length == 0) {
                resolvedName = "image.jpg";
              }
            }
            if (resolvedType.length == 0 || resolvedType.indexOf("image/") < 0) {
              resolvedType = guessImageMimeFromPath(filePath);
              if (resolvedType.indexOf("image/") < 0) {
                resolvedType = guessImageMimeFromPath(resolvedName);
              }
              if (resolvedType.indexOf("image/") < 0) {
                resolvedType = "image/jpeg";
              }
            }
            const uploadFile = new UTSJSONObject();
            uploadFile["url"] = filePath;
            uploadFile["name"] = resolvedName;
            uploadFile["type"] = resolvedType;
            uploadFile["size"] = fileSize;
            uploadFile["status"] = UploadFileStatus.uploading;
            uploadFile["uid"] = getFileUid();
            _files.push(uploadFile);
          }
          files.value = [...files.value, ..._files];
          console.log(
            "[Upload] chooseImage queued count=" + uploadCount + " files=" + files.value.length
          );

          if (_uploadMultipleFiles != null) {
            _uploadMultipleFiles!(pathList);
          } else {
            console.error("[Upload] _uploadMultipleFiles is null");
          }
        } catch (e) {
          console.error("[Upload] chooseImage success handler error:", e);
        }
      },
      fail: (err) => {
        const errMsg = coalesceString(err.errMsg);
        console.warn("[Upload] chooseImage fail errMsg=" + errMsg);
        // 如果取消选择图片，则不显示错误提示
        const isCancelled = isImageChooseCancelled(errMsg);
        if (isCancelled == true) {
          return;
        }
        uni.showToast({
          title: tReason("Mobile.Chat.chooseImageFailed", errMsg),
          position: "bottom",
        });
      },
      complete: () => {
        console.log("[Upload] chooseImage complete");
        pageSystemOverlay.end();
      },
    });
  };

  /** 按 uid 整表替换单项，确保 App 下 status/loading 刷新 */
  const replaceFileByUid = (uid: string, nextFile: UTSJSONObject): void => {
    if (uid.length == 0) {
      return;
    }
    const list = files.value;
    const out = [] as UTSJSONObject[];
    let found = false;
    for (let i = 0; i < list.length; i++) {
      const cur = list[i] as UTSJSONObject;
      const curUid = cur["uid"] as string | null;
      if (curUid != null && `${curUid}` == uid) {
        out.push(nextFile);
        found = true;
      } else {
        out.push(cur);
      }
    }
    if (found == true) {
      files.value = out;
    } else {
      console.warn("[Upload] replaceFileByUid miss uid=" + uid);
    }
  };

  const markFileUploadError = (uid: string): void => {
    if (uid.length == 0) {
      return;
    }
    const list = files.value;
    const out = [] as UTSJSONObject[];
    for (let i = 0; i < list.length; i++) {
      const cur = list[i] as UTSJSONObject;
      const curUid = cur["uid"] as string | null;
      if (curUid != null && `${curUid}` == uid) {
        const errorFile = new UTSJSONObject();
        if (cur["url"] != null) {
          errorFile["url"] = cur["url"];
        }
        if (cur["name"] != null) {
          errorFile["name"] = cur["name"];
        }
        if (cur["type"] != null) {
          errorFile["type"] = cur["type"];
        }
        if (cur["size"] != null) {
          errorFile["size"] = cur["size"];
        }
        errorFile["uid"] = uid;
        if (cur["key"] != null) {
          errorFile["key"] = cur["key"];
        }
        errorFile["status"] = UploadFileStatus.error;
        out.push(errorFile);
      } else {
        out.push(cur);
      }
    }
    files.value = out;
  };

  // 上传单张图片：复用 fileUploader（.uvue 内联 uni.uploadFile 易触发 UTS110111101）
  const uploadFile = async (
    filePath: string,
    uid: string,
  ): Promise<UTSJSONObject> => {
    console.log("[Upload] start uid=" + uid + " path=" + filePath);
    let displayFileName = "";
    const currentFiles = files.value;
    for (let fi = 0; fi < currentFiles.length; fi++) {
      const current = currentFiles[fi] as UTSJSONObject;
      if (`${current["uid"]}` == uid && current["name"] != null) {
        displayFileName = `${current["name"]}`;
        break;
      }
    }
    const result = await uploadSingleFile(filePath, uid, (percent: number) => {
      const list = files.value;
      for (let i = 0; i < list.length; i++) {
        const cur = list[i] as UTSJSONObject;
        if (`${cur["uid"]}` == uid) {
          cur["percent"] = percent;
          break;
        }
      }
    }, displayFileName);

    if (result.success && result.file != null) {
      const info = result.file;
      let mimeType = info.type;
      // 保留本地已推断的 mime，避免服务端空值把图片变成文档卡
      const list = files.value;
      for (let i = 0; i < list.length; i++) {
        const cur = list[i] as UTSJSONObject;
        if (`${cur["uid"]}` == uid && cur["type"] != null) {
          const localType = `${cur["type"]}`;
          if (localType.length > 0) {
            mimeType = localType;
          }
          break;
        }
      }
      if (mimeType.length == 0) {
        mimeType = "image/jpeg";
      }
      let fileUrl = info.url;
      if (fileUrl.length == 0) {
        fileUrl = filePath;
      }
      const uploadedFile = new UTSJSONObject();
      if (info.key != null) {
        uploadedFile["key"] = info.key;
      } else {
        uploadedFile["key"] = "";
      }
      uploadedFile["name"] = info.name;
      uploadedFile["type"] = mimeType;
      uploadedFile["size"] = info.size;
      uploadedFile["url"] = fileUrl;
      uploadedFile["uid"] = uid;
      uploadedFile["status"] = UploadFileStatus.done;
      uploadedFile["percent"] = 100;
      if (info.response != null) {
        uploadedFile["response"] = info.response;
      }
      replaceFileByUid(uid, uploadedFile);
      console.log("[Upload] done uid=" + uid);
      return uploadedFile;
    }

    const failText =
      result.error != null && result.error.length > 0
        ? result.error
        : t("Mobile.AudioUploader.uploadFailed");
    markFileUploadError(uid);
    console.warn("[Upload] fail uid=" + uid + " msg=" + failText);
    throw new Error(failText);
  };

  // 多文件上传（单文件完成态已在 uploadFile 内更新）
  async function uploadMultipleFiles(filePaths: string[]): Promise<void> {
    if (filePaths.length == 0) return;

    try {
      const trackedUids = [] as string[];
      for (let pi = 0; pi < filePaths.length; pi++) {
        const filePath = filePaths[pi];
        let matchedUid = "";
        const fileList = files.value;
        for (let i = 0; i < fileList.length; i++) {
          const file = fileList[i] as UTSJSONObject;
          if (`${file["url"]}` == `${filePath}`) {
            const uidVal = file["uid"] as string | null;
            if (uidVal != null) {
              matchedUid = `${uidVal}`;
            }
            break;
          }
        }
        trackedUids.push(matchedUid);
      }
      console.log(
        "[Upload] batch start count=" + filePaths.length + " uids=" + trackedUids.join(",")
      );

      // uni-app x Android 对 Promise.allSettled + uni.uploadFile 的桥接存在提前 settled：
      // 上传回调尚未返回就继续执行，旧兜底会把全部 uploading 项误标为 error。
      // 逐个 await 保证原生上传回调真正结束后再处理下一项。
      for (let i = 0; i < filePaths.length; i++) {
        const path = filePaths[i];
        const uid = trackedUids[i];
        try {
          await uploadFile(path, uid);
        } catch (error) {
          markFileUploadError(uid);
          console.warn("[Upload] item rejected uid=" + uid + " error=" + `${error}`);
        }
      }

      showExtraContainer.value = false;
    } catch (error) {
      console.error("批量上传处理失败:", error);
      const recovered = [] as UTSJSONObject[];
      for (let i = 0; i < files.value.length; i++) {
        const prev = files.value[i] as UTSJSONObject;
        if (`${prev["status"]}` == `${UploadFileStatus.uploading}`) {
          const errorFile = new UTSJSONObject();
          if (prev["url"] != null) {
            errorFile["url"] = prev["url"];
          }
          if (prev["name"] != null) {
            errorFile["name"] = prev["name"];
          }
          if (prev["type"] != null) {
            errorFile["type"] = prev["type"];
          }
          if (prev["size"] != null) {
            errorFile["size"] = prev["size"];
          }
          if (prev["uid"] != null) {
            errorFile["uid"] = prev["uid"];
          }
          errorFile["status"] = UploadFileStatus.error;
          recovered.push(errorFile);
        } else {
          recovered.push(prev);
        }
      }
      files.value = recovered;
    }
  }
  _uploadMultipleFiles = uploadMultipleFiles;

  // 输入框获取焦点
  const onInputFocus = () => {
    installComposerObserver();
    console.log("[conversation-input][focus-event]");
    isInputFocused.value = true;
    emit('onFocusChange', true);
    // 先记录未上推时的输入区底边，再按 IME 顶部计算精确偏移，避免整段白边。
    homeInputBaseBottom = -1;
    // #ifdef APP
    if (isHomeScene.value) {
      nextTick((): void => {
        measureHomeInputBaseBottom();
      });
    }
    // #endif
    // #ifdef APP-ANDROID
    if (isHomeScene.value) startAndroidImePolling();
    // #endif
    const blurTimer = quickPopupBlurTimer;
    if (blurTimer != null) {
      clearTimeout(blurTimer);
      quickPopupBlurTimer = null;
    }
    const focusTimer = quickPopupFocusTimer;
    if (focusTimer != null) clearTimeout(focusTimer);
    // 隐藏额外功能栏
    showExtraContainer.value = false;
    // 滚动到最后一个消息
    emit('onScrollToLastMsg', true);
  };

  // 输入框失去焦点
  const onInputBlur = () => {
    console.log("[conversation-input][blur-event]");
    isInputFocused.value = false;
    emit('onFocusChange', false);
    if (quickPopupFocusTimer != null) {
      clearTimeout(quickPopupFocusTimer!);
      quickPopupFocusTimer = null;
    }
    // #ifdef APP-ANDROID
    stopAndroidImePolling();
    if (isHomeScene.value) {
      keyboardHeight.value = 0;
      homeKeyboardOffset.value = 0;
      homeInputBaseBottom = -1;
    }
    // #endif
    // 点快捷浮层列表项会先触发 blur：延迟关闭让 click 先完成（选中路径自己会关）
    if (quickPopupVisible.value == true) {
      const pending = quickPopupBlurTimer;
      if (pending != null) clearTimeout(pending);
      quickPopupBlurTimer = setTimeout(() => {
        quickPopupBlurTimer = null;
        closeQuickPopup();
      }, 600);
    }
    if (skipCloseExtraOnBlur) {
      skipCloseExtraOnBlur = false;
      return;
    }
    // 隐藏额外功能栏
    showExtraContainer.value = false;
  };

  // 切换额外功能栏显示/隐藏
  const handleComposerAction = (action: string): void => {
    actionSheetVisible.value = false;
    if (action == "expert") {
      // 会话详情的 @ 仅代表上下文文件；专家入口只属于首页创建会话场景。
      if (isHomeScene.value != true || props.allowExpertSelection != true) return;
      setTimeout(() => {
        if (props.allowExpertSelection == true) expertSheetVisible.value = true;
      }, 100);
      return;
    }
    if (action == "connector" || action == "connectorConnected") {
      // 头像组入口初始落「已连接」聚合页签（对齐 PC connectedView），普通入口落系统广场
      connectorSheetInitialTab.value = action == "connectorConnected" ? "connected" : "system";
      setTimeout(() => {
        connectorSheetVisible.value = true;
      }, 100);
      return;
    }
    if (action == "knowledge") {
      setTimeout(() => {
        knowledgeSheetVisible.value = true;
      }, 100);
      return;
    }
    if (action == "camera") {
      chooseImage("camera");
      return;
    }
    if (action == "album") {
      chooseImage("album");
      return;
    }
    if (action == "file") {
      chooseFile();
      return;
    }
    if (action == "skill") {
      if (props.enableSkillAt != true) return;
      setTimeout(() => {
        skillSheetVisible.value = true;
      }, 100);
      return;
    }
    emit("onOpenAction", action);
  };

  const handleExpertSelect = (item: UTSJSONObject): void => {
    if (isHomeScene.value == true && props.allowExpertSelection != true) return;
    const targetIdRaw = item["targetId"];
    const targetId = targetIdRaw != null ? parseInt(`${targetIdRaw}`) : 0;
    if (targetId <= 0) return;
    if (isAtTrigger.value == true && atCursorIndex.value > 0) {
      const text = messageInfo.value;
      const index = atCursorIndex.value;
      messageInfo.value = text.substring(0, index - 1) + text.substring(index);
    }
    isAtTrigger.value = false;
    atCursorIndex.value = -1;
    if (isHomeScene.value == true) {
      // 首页：以该专家智能体身份创建会话，交由父页面切换
      emit("onExpertAgentSelect", item);
    } else {
      // 会话：专家作为消息级 Agent 组件回显在输入框上（单选替换），随下一条消息发送
      sessionExpertId.value = targetId;
      sessionExpertName.value = item["name"] != null ? `${item["name"]}` : "";
      sessionExpertIcon.value = item["icon"] != null ? `${item["icon"]}` : "";
    }
    expertSheetVisible.value = false;
  };

  const handleHomeSkillSelect = (item: UTSJSONObject): void => {
    const targetIdRaw = item["targetId"];
    const targetId = targetIdRaw != null ? parseInt(`${targetIdRaw}`) : 0;
    if (targetId <= 0) return;
    const skill = new SkillInfoForAt();
    skill.id = targetId;
    skill.targetId = targetId;
    skill.name = item["name"] != null ? `${item["name"]}` : "";
    skill.description = item["description"] != null ? `${item["description"]}` : "";
    skill.icon = item["icon"] != null ? `${item["icon"]}` : "";
    skill.category = item["category"] != null ? `${item["category"]}` : "";
    skillSheetVisible.value = false;
    handleSkillSelect(skill);
  };

  /** 首页快捷浮层选中：清触发文本，再复用专家/技能的现有选择流程。 */
  const handleQuickPopupSelect = (item: UTSJSONObject): void => {
    const mode = quickPopupMode.value;
    closeQuickPopup();
    if (mode == "expert" && props.allowExpertSelection != true) return;
    // #ifndef MP
    let mention: UTSJSONObject | null = null;
    if (mode == "skill" || mode == "file") {
      const rawId = mode == "skill" ? item["targetId"] : item["path"];
      if (rawId == null || `${rawId}`.length == 0) return;
      const id = `${rawId}`;
      if (mode == "skill" && !(parseInt(id) > 0)) return;
      const rawName = item["name"];
      const name = rawName != null && `${rawName}`.length > 0 ? `${rawName}` : id.substring(id.lastIndexOf("/") + 1);
      mention = {
        id: mode == "skill" ? `skill|${id}` : `context-file|${encodeURIComponent(id)}`,
        name: name,
        color: mode == "skill" ? "#5147ff" : "#5f5f69",
        background: mode == "skill" ? "#eee9ff" : "#f2f1f6",
        radius: "999px",
      };
    }
    replaceQuickTriggerAtomically(mode, mention, (): void => {
      if (mode == "expert") handleExpertSelect(item);
    });
    return;
    // #endif
    removeQuickTriggerText(mode, (): void => {
      if (mode == "skill") {
        handleHomeSkillSelect(item);
      } else if (mode == "file") {
        const path: string = item["path"] != null ? `${item["path"]}` : "";
        let name: string = item["name"] != null ? `${item["name"]}` : "";
        if (path.length > 0) {
          if (name.length == 0) {
            const slashIndex = path.lastIndexOf("/");
            name = slashIndex >= 0 && slashIndex + 1 < path.length
              ? path.substring(slashIndex + 1)
              : path;
          }
          const mentionName: string = name.length > 0 ? `${name}` : path;
          insertEditorMention("context-file", `${encodeURIComponent(path)}`, mentionName);
        }
      } else {
        handleExpertSelect(item);
        nextTick(() => focusChatInput());
      }
    });
  };

  const handleKnowledgeSelect = (item: UTSJSONObject): void => {
    const slugId = item["slugId"] != null ? `${item["slugId"]}` : "";
    if (slugId.length > 0) {
      let exists = false;
      for (let i = 0; i < selectedDocs.value.length; i++) {
        if (selectedDocs.value[i].slugId == slugId) {
          exists = true;
          break;
        }
      }
      if (exists != true) {
        const doc = new SelectedDocInfo();
        doc.slugId = slugId;
        doc.title = item["name"] != null ? `${item["name"]}` : "";
        doc.pageType = item["pageType"] != null ? `${item["pageType"]}` : "";
        selectedDocs.value = [...selectedDocs.value, doc];
        // #ifndef MP
        // 资料以 chip（mention）插到光标处，可穿插在正文中间
        insertEditorMention(
          "doc",
          `${encodeURIComponent(doc.slugId)}|${encodeURIComponent(doc.pageType)}`,
          doc.title,
        );
        nextTick(() => focusChatInput());
        // #endif
      }
    }
    emit("onKnowledgeSelect", item);
    knowledgeSheetVisible.value = false;
  };

  /** 全局搜索页选中结果回填到当前输入框（搜索页通过 navigateTo 覆盖，本组件仍保持挂载）。 */
  const handleGlobalSearchSelection = (payloadRaw: any): void => {
    if (payloadRaw == null) return;
    try {
      const jsonStr = JSON.stringify(payloadRaw);
      if (jsonStr == null || jsonStr.length == 0) return;
      const payload = JSON.parse<UTSJSONObject>(jsonStr);
      if (payload == null) return;
      const typeRaw = payload["type"];
      const itemRaw = payload["item"];
      if (typeRaw == null || itemRaw == null) return;
      const item = itemRaw as UTSJSONObject;
      const type = `${typeRaw}`;
      if (type == "expert") handleExpertSelect(item);
      else if (type == "skill") handleHomeSkillSelect(item);
      else if (type == "knowledge") handleKnowledgeSelect(item);
    } catch (error) {
      console.error("[conversation-input] global search selection failed:", error);
    }
  };

  onMounted(() => {
    uni.$on("NuwaxGlobalSearchSelection", handleGlobalSearchSelection);
    if (safeManualComponents.value.length > 0) {
      setTimeout((): void => measureSharedHomeToolsRow(0), 120);
    }
  });

  onUnmounted(() => {
    uni.$off("NuwaxGlobalSearchSelection", handleGlobalSearchSelection);
  });

  const handleExpertSheetClose = (): void => {
    expertSheetVisible.value = false;
    if (isAtTrigger.value == true) {
      isAtTrigger.value = false;
      atCursorIndex.value = -1;
      nextTick(() => focusChatInput());
    }
    // #ifndef MP
    nextTick(() => focusChatInput());
    // #endif
  };

  const handleApprovalChange = (enabled: boolean): void => {
    chatboxConfigUserMutated = true;
    handleAgentModeChange(enabled ? "ask" : "yolo");
    persistHomeChatboxConfig();
  };

  const handleVersionControlChange = (enabled: boolean): void => {
    chatboxConfigUserMutated = true;
    versionControlEnabled.value = enabled;
    persistHomeChatboxConfig();
  };

  const handleAutoCommitChange = (enabled: boolean): void => {
    chatboxConfigUserMutated = true;
    autoCommitEnabled.value = enabled;
    persistHomeChatboxConfig();
  };

  const toggleExtraContainer = () => {
    if (usesHomeLayout.value == true) {
      blurChatInput();
      actionSheetVisible.value = true;
      return;
    }
    const willShow = invertBoolean(showExtraContainer.value);
    if (willShow == true) {
      // 展开功能栏时收起软键盘（Android 上仅 hideKeyboard 不够，须先 blur）
      skipCloseExtraOnBlur = true;
      blurChatInput();
      // #ifdef APP-ANDROID
      setTimeout(() => {
        blurChatInput();
        if (showExtraContainer.value == true) {
          keyboardHeight.value = 0;
        }
      }, 80);
      // #endif
    }
    showExtraContainer.value = willShow;
  };

  // 切换输入方式（切到输入后聚焦；Android 切语音延迟 80ms）
  const handleChangeInputMethod = async () => {
    if (inputMethod.value == ChatInputMethod.Voice) {
      clearMethodSwitchTimer();
      inputMethod.value = ChatInputMethod.Input;
      uni.setStorageSync(CHAT_INPUT_METHOD, ChatInputMethod.Input);
      showExtraContainer.value = false;
      // Android 原生 textarea 刚挂载时立即 focus，会在同一帧同时触发原生控件布局和键盘重排，
      // 图标层会短暂绘制到旧坐标。先提交输入态，再在下一帧之后聚焦。
      // #ifdef APP-ANDROID
      methodSwitchTimer = setTimeout(() => {
        methodSwitchTimer = 0;
        if (inputMethod.value == ChatInputMethod.Input) {
          focusChatInput();
        }
      }, 80) as number;
      // #endif
      // #ifndef APP-ANDROID
      nextTick(() => {
        focusChatInput();
      });
      // #endif
    } else {
      // 切到语音：须先 blur + hideKeyboard，再卸 textarea。
      // Android 上若先卸 textarea / 先清零 keyboard-cover，会出现「输入栏已落底但软键盘仍在」。
      clearMethodSwitchTimer();
      blurChatInput();

      const switchToVoice = (): void => {
        keyboardHeight.value = 0;
        // 切语音后 textarea 已卸下，残留 multi-line 会让 icon-wrap 错位、高度微抖
        isMultiLine.value = false;
        inputMethod.value = ChatInputMethod.Voice;
        uni.setStorageSync(CHAT_INPUT_METHOD, ChatInputMethod.Voice);
        // Android textarea 常驻，不能清掉 ref；否则再次切输入时无法自动聚焦。
        // #ifndef APP-ANDROID
        inputRef.value = null;
        // #endif
      };

      // #ifdef APP-ANDROID
      // 给系统一点时间收起软键盘，再切语音并清零占位
      methodSwitchTimer = setTimeout(() => {
        methodSwitchTimer = 0;
        blurChatInput();
        switchToVoice();
      }, 80) as number;
      // #endif
      // #ifndef APP-ANDROID
      switchToVoice();
      // #endif
    }
  };

  // 监听输入方式变化 - watch 暂时禁用以排查 UTS 编译错误

  // 输入事件
  const handleInput = (e: UniInputEvent) => {
    const value = coalesceString(e.detail.value as string | null);
    const prevValue = coalesceString(messageInfo.value);
    const cursor = e.detail.cursor as number | null;
    messageInfo.value = value;
    lastEditorRawText = value;
    if (usesHomeLayout.value == true) {
      syncQuickPopupFromText(value);
      selectedSkills.value = filterSkillsRemainingInText(selectedSkills.value, value);
      return;
    }
    const isAtTyped = isAtTypedOnInput(cursor, value);
    const isAddingOne = value.length == prevValue.length + 1;
    const openExpertPicker = usesHomeLayout.value == true && props.allowExpertSelection == true && isAddingOne == true && isAtTyped == true;
    const openPicker = shouldOpenSkillPickerOnAtInput(
      props.enableSkillAt,
      isAddingOne,
      isAtTyped,
    );
    if (openExpertPicker == true) {
      uni.hideKeyboard();
      isAtTrigger.value = true;
      atCursorIndex.value = cursor != null ? cursor : -1;
      showExtraContainer.value = false;
      expertSheetVisible.value = true;
    } else if (openPicker == true) {
      uni.hideKeyboard();
      isAtTrigger.value = true;
      if (cursor != null) {
        atCursorIndex.value = cursor;
      } else {
        atCursorIndex.value = -1;
      }
      showExtraContainer.value = false;
      skillSelectModalVisible.value = true;
    }
    selectedSkills.value = filterSkillsRemainingInText(
      selectedSkills.value,
      value,
    );
  };

  // 点击发送事件
  const handleSendMessage = (): void => {
    const isDisabled = isWholeDisabledSendBlocked(props.wholeDisabled);
    if (isDisabled == true) {
      messageInfo.value = "";
      clearEditorContent();
      uni.showToast({
        title: t("Mobile.Chat.fillRequiredParams"),
        icon: "none",
        duration: 2000,
      });
      return;
    }
    const existErrorFile = hasUploadErrorInFiles(files.value);
    if (existErrorFile == true) {
      uni.showToast({
        title: t("Mobile.Chat.removeUploadFailed"),
        icon: "none",
        duration: 1500,
      });
      return;
    }
    const canSend = canSendChatMessage(
      messageInfo.value,
      files.value.length,
      selectedSkills.value.length,
    );
    if (canSend == true) {
      const payload = new UTSJSONObject();
      // App/H5 的 @名称 由 editor 内 mention 序列化而来（editorPlainTextFromDelta），MP 由光标处插入的文本提供
      payload["messageInfo"] = messageInfo.value;
      payload["files"] = files.value;
      // 会话场景已选专家随消息合并进 selectedComponents（对齐 PC：专家为消息级 Agent 组件）
      const sendComponents: AgentSelectedComponentInfo[] = [];
      for (let sc = 0; sc < selectedComponents.value.length; sc++) {
        sendComponents.push(selectedComponents.value[sc]);
      }
      if (isHomeScene.value != true && sessionExpertId.value > 0) {
        sendComponents.push(new AgentSelectedComponentInfo(sessionExpertId.value, AgentComponentTypeEnum.Agent));
      }
      payload["selectedComponents"] = sendComponents;
      payload["selectedDocs"] = selectedDocs.value;
      const skillIds: number[] = [];
      const skills = selectedSkills.value;
      for (let i = 0; i < skills.length; i++) {
        skillIds.push(skills[i].targetId);
      }
      payload["skillIds"] = skillIds;
      payload["modelId"] = selectedModelId.value;
      payload["modelName"] = selectedModelName.value;
      payload["sandboxId"] = selectedComputerId.value;
      if (props.isTaskAgent == true) {
        payload["agentMode"] =
          props.allowChooseMode == 1
            ? agentMode.value
            : "yolo";
      }
      // 首页和会话页都通过组件事件发送，避免首页语音转写结果落到无人监听的全局事件中。
      emit("onSendMessage", payload);
      selectedSkills.value = [];
      selectedDocs.value = [] as SelectedDocInfo[];
      files.value = [];
      messageInfo.value = "";
      clearEditorContent();
      clearSessionExpert();
      closeQuickPopup();
      // 发送后收起「+」功能栏（拍照/相册/文件等），避免遮挡会话区
      showExtraContainer.value = false;
    }
  };

  // 按下：仅预热波形；isRecording 由 onVisualActive 驱动，避免与紫底双源
  const handleVoicePress = () => {
    if (waveformBars.value.length == 0) {
      initWaveform();
    }
  };

  // RecorderManager onStart：有效开录后再停播，避免轻触误掐 TTS
  const handleVoiceStart = () => {
    // 仅在确实在播时打断。无播报勿调 stop（会拆掉子组件刚 preheat 的空闲连）。
    // 若打断了正在播的 TTS：stop 会 release 连接，而此前 preheat 因已有业务连直接 return，
    // 需再预热一次，保证本轮回复仍能复用预热连。
    if (nativeVoiceBridge.isActive() == true && nativeVoiceBridge.isTtsBusy() == true) {
      // App web-view 内嵌页：原生播报由原生侧在开录时自行打断，这里双保险
      nativeVoiceBridge.ttsStop();
    }
    if (voiceStreamSpeaker.isBusy() == true) {
      stopAllSpeechPlayback();
      uni.$emit("streamSpeakInterrupt", {});
      speechSocketWarmup.preheatTtsForRecording();
    }
    if (waveformBars.value.length == 0) {
      initWaveform();
    }
  };

  /**
   * 按钮紫色态变化：父级 isRecording 唯一跟随源。
   * 轻触松手时子组件会强制 onVisualActive(false)。
   */
  const handleRecorderVisualActive = (active: boolean) => {
    if (active == true) {
      if (isRecording.value != true) {
        isRecording.value = true;
        if (waveformBars.value.length == 0) {
          initWaveform();
        }
        startDurationTimer();
      }
      return;
    }
    isRecording.value = false;
    recordWillCancel.value = false;
    stopDurationTimer();
  };

  const handleCancelZoneChange = (active: boolean) => {
    recordWillCancel.value = active;
  };

  // 语音转写成功 → 发送；UI 复位交给 onVisualActive(false)
  const handleVoiceStop = async (transcriptText: string) => {
    const isStringType = typeof transcriptText === "string";
    if (isStringType == true) {
      if (transcriptText.length > 0) {
      messageInfo.value = transcriptText;
      await nextTick();
      handleSendMessage();
      }
    }
  };

  /** 从 Error / UTSError / UTSJSONObject 安全读取文案（禁止 as UTSJSONObject） */
  function resolveVoiceErrorMessage(error: any | null, fallback: string): string {
    if (error == null) {
      return fallback;
    }
    try {
      const err = error as Error;
      const message = err.message;
      if (message != null && `${message}`.length > 0) {
        if (`${message}`.indexOf("ClassCastException") >= 0) {
          return fallback;
        }
        return `${message}`;
      }
    } catch (_eErr) {
      // ignore
    }
    try {
      const jsonStr = JSON.stringify(error);
      if (jsonStr != null && jsonStr.length > 2 && jsonStr != "{}" && jsonStr != "null") {
        const parsed = JSON.parse(jsonStr) as UTSJSONObject;
        const messageField = parsed["message"];
        if (messageField != null && `${messageField}`.length > 0) {
          return `${messageField}`;
        }
        const errMsgField = parsed["errMsg"];
        if (errMsgField != null && `${errMsgField}`.length > 0) {
          return `${errMsgField}`;
        }
      }
    } catch (_eJson) {
      // ignore
    }
    const text = `${error}`;
    if (text.length > 0 && text != "null" && text.indexOf("ClassCastException") < 0) {
      return text;
    }
    return fallback;
  }

  // 语音录制错误（UI 复位交给 onVisualActive；此处只 toast）
  const handleVoiceError = (error: any) => {
    const errorMessage = resolveVoiceErrorMessage(error, t("Mobile.Voice.recordFailed"));
    // 轻触 / Recorder 竞态类文案：子组件一般已静默，这里再兜底一次不 toast
    const lower = errorMessage.toLowerCase();
    if (
      lower.indexOf("other error") >= 0 ||
      lower.indexOf("not start") >= 0 ||
      lower.indexOf("not recording") >= 0 ||
      errorMessage.indexOf("未开始") >= 0
    ) {
      return;
    }

    uni.showToast({
      title: errorMessage,
      icon: "none",
      duration: 2000,
    });
  };

  // cancel 与 visual(false) 可能同帧双发；幂等清一次即可
  const handleRecordCancel = () => {
    recordWillCancel.value = false;
    if (isRecording.value == true) {
      isRecording.value = false;
      stopDurationTimer();
    }
  };

  // 光标换行且内容超出输入框最大高度时，滚动到底部让光标可见。
  // 行数增加才滚（删行回缩时不动，避免把光标滚出视野）；仅在行数超过 6 行上限后生效。
  let lastInputLineCount = 1;
  const scrollInputCaretIntoView = (lineCount: number): void => {
    const grew = lineCount > lastInputLineCount;
    lastInputLineCount = lineCount;
    if (!grew) return;
    // #ifdef H5 || WEB
    const el = document.getElementById("chat-input-textarea") as any | null;
    if (el != null && el.scrollHeight > el.clientHeight) {
      el.scrollTop = el.scrollHeight;
    }
    // #endif
  };

  // Add handler for line change
  const handleLineChange = (e: UniTextareaLineChangeEvent) => {
    isMultiLine.value = e.detail.lineCount > 1;
    scrollInputCaretIntoView(e.detail.lineCount);
  };

  // 删除文档
  const handleDelFile = (uid: string) => {
    files.value = filterFilesExcludingUid(files.value, uid);
  };
  // 暴露messageInfo和files
  defineExpose({
    files,
    selectedComponents,
    getFiles,
    getSelectedComponents,
    /** 首页提示问题：一次替换草稿，清技能/资料，不触发发送且保留当前智能体。 */
    setText: (text: string): void => {
      selectedSkills.value = [];
      selectedDocs.value = [] as SelectedDocInfo[];
      closeQuickPopup();
      isAtTrigger.value = false;
      atCursorIndex.value = -1;
      quickTriggerStart = -1;
      quickTriggerEnd = -1;
      lastEditorText = text;
      lastEditorRawText = text;
      editorIndexedText = text;
      editorInputCursor = text.length;
      editorDelta.value = null;
      messageInfo.value = text;
      updateEditorHeight(text);
      setEditorPlainText(text);
      // #ifdef MP
      const el = inputRef.value;
      if (el != null) (el as UniTextareaElement).value = text;
      textareaCursor.value = text.length;
      // #endif
      nextTick((): void => focusChatInput());
    },
    /** 清空输入内容（对齐 PC chatInputRef.clear()：首页切分类/切推荐位时调用） */
    clear: (): void => {
      messageInfo.value = "";
      clearEditorContent();
      // #ifdef MP
      const el = inputRef.value;
      if (el != null) (el as UniTextareaElement).value = "";
      // #endif
    },
    /** 聚焦输入框 */
    focus: (): void => {
      nextTick(() => focusChatInput());
    },
  });

</script>

<style lang="scss" scoped>
  .container {
    display: flex;
    flex-direction: column;
    padding: 8rpx 32rpx 0 32rpx;
    background-color: #fff;
    border-radius: 16rpx 16rpx 0 0;
    // 确保容器为相对定位，用于容纳绝对定位的蒙层
    position: relative;
    overflow: visible;
    box-sizing: border-box;
    width: 100%;
    /* #ifdef APP-HARMONY */
    // 鸿蒙模拟器屏幕圆角很大，32rpx 时加号会贴进圆角被裁掉一块
    padding-right: 48rpx;
    padding-left: 48rpx;
    /* #endif */

    &.container--recording {
      background-color: transparent;
    }



    &.container--quick-popup {
      z-index: 500;
    }

    .container-block {
      margin-bottom: 20rpx;
    }

    /* 会话详情中的 agent 工具栏：视觉、热区和展开方式与首页工具栏保持一致。 */
    .shared-home-tools {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      padding: 0 0 4rpx;
      margin-bottom: 8rpx;
    }

    .shared-home-tools__rowwrap {
      display: flex;
      flex-direction: row;
      align-items: center;
    }

    .shared-home-tools__scroll {
      flex: 1;
      min-width: 0;
      height: 80rpx;
    }

    .shared-home-tools__row {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      height: 80rpx;
    }

    .shared-home-tools__chip {
      display: flex;
      flex-direction: row;
      align-items: center;
      flex: none;
      min-height: 72rpx;
      padding: 0 24rpx;
      margin-right: 16rpx;
      border: 2rpx solid #e5e6eb;
      border-radius: 999rpx;
      background-color: #ffffff;
      box-sizing: border-box;
      box-shadow: 0 2rpx 8rpx rgba(27, 31, 43, 0.05);
    }

    .shared-home-tools__chip--on {
      border-color: #5147ff;
      background-color: #f2f2ff;
    }

    .shared-home-tools__icon {
      width: 32rpx;
      height: 32rpx;
      margin-right: 12rpx;
      flex-shrink: 0;
    }

    .shared-home-tools__chip-text,
    .shared-home-tools__panel-text {
      font-size: 27rpx;
      line-height: 38rpx;
      color: #242631;
      lines: 1;
    }

    .shared-home-tools__chip--on .shared-home-tools__chip-text,
    .shared-home-tools__panel-item--on .shared-home-tools__panel-text {
      color: #5147ff;
    }

    .shared-home-tools__toggle {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      flex: none;
      min-width: 72rpx;
      height: 52rpx;
      margin-left: 4rpx;
      padding: 0 8rpx;
    }

    .shared-home-tools__toggle-text {
      font-size: 24rpx;
      line-height: 34rpx;
      color: #6f6f78;
      white-space: nowrap;
    }

    .shared-home-tools__expanded {
      position: relative;
      display: flex;
      flex-direction: column;
      border-radius: 16rpx;
      background-color: #f7f8fa;
      overflow: hidden;
    }

    .shared-home-tools__toggle--float {
      position: absolute;
      top: 8rpx;
      right: 12rpx;
      z-index: 2;
    }

    .shared-home-tools__panel {
      max-height: 360rpx;
    }

    .shared-home-tools__grid {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      padding: 52rpx 16rpx 16rpx;
      box-sizing: border-box;
    }

    .shared-home-tools__panel-item {
      display: flex;
      flex-direction: row;
      align-items: center;
      height: 72rpx;
      padding: 0 24rpx;
      margin: 8rpx 16rpx 0 0;
      border: 2rpx solid #e5e6eb;
      border-radius: 999rpx;
      background-color: #ffffff;
      box-sizing: border-box;
      box-shadow: 0 2rpx 8rpx rgba(27, 31, 43, 0.05);
    }

    .shared-home-tools__panel-item--on {
      border-color: #5147ff;
      background-color: #f2f2ff;
    }

    /* ── 输入卡底部灰条（对齐 PC workspace-dir-bar 槽位）：卡内贴底全宽 ── */
    /* 工具面板：+ 号工具行 + 灰色行同容器；无阴影、无外边距充满容器 */
    .home-capability-panel {
      border-radius: 24rpx;
      background-color: #ffffff;
      overflow: hidden;
    }

    /* 灰色行：面板底部通栏（底角由面板 overflow:hidden 裁切）；内容右置 */
    .input-card-bottom-bar {
      padding: 0 24rpx;
      background-color: #f5f5f7;
      min-height: 72rpx;
      display: flex;
      flex-direction: row;
      align-items: center;
    }

    /* 内容块：宽度随内容自适应、左对齐；超宽整体收缩省略；与项目并排时留间距可压缩 */
    .input-card-bottom-inner {
      display: flex;
      flex-direction: row;
      align-items: center;
      min-height: 72rpx;
      max-width: 520rpx;
      flex-shrink: 1;
    }

    .input-card-bottom-spacer {
      flex: 1;
    }

    .input-card-bottom-inner--space {
      flex-shrink: 0;
    }

    .input-card-bottom-text--space {
      max-width: 240rpx;
    }

    .input-card-bottom-icon {
      width: 34rpx;
      height: 34rpx;
      border-radius: 6rpx;
    }

    .input-card-bottom-text {
      max-width: 360rpx;
      margin-left: 10rpx;
      font-size: 24rpx;
      line-height: 34rpx;
      color: #8a8a8a;
      font-weight: 500;
      lines: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .input-card-bottom-remove {
      width: 56rpx;
      height: 56rpx;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .input-card-bottom-remove-text {
      font-size: 26rpx;
      color: #8a8a8a;
    }

    .home-capability-bar {      display: flex;
      flex-direction: row;
      align-items: center;
      min-height: 72rpx;
      padding: 0 18rpx 14rpx;
      z-index: 2;
    }

    .home-expert-chip {
      display: flex;
      flex-direction: row;
      align-items: center;
      align-self: flex-start;
      height: 56rpx;
      max-width: 420rpx;
      margin: 14rpx 18rpx 0;
      padding: 0 14rpx 0 8rpx;
      border-radius: 999rpx;
      background-color: #f2f1f6;
      box-sizing: border-box;
      z-index: 3;
    }

    .home-expert-name {
      flex: 1;
      min-width: 0;
      color: #34343d;
      font-size: 24rpx;
      lines: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .home-expert-remove {
      position: relative;
      flex-shrink: 0;
      width: 36rpx;
      height: 36rpx;
      margin-left: 8rpx;
    }

    .home-expert-remove-line {
      position: absolute;
      left: 9rpx;
      top: 17rpx;
      width: 18rpx;
      height: 3rpx;
      border-radius: 999rpx;
      background-color: #8d8d97;
    }

    .home-expert-remove-line--left { transform: rotate(45deg); }
    .home-expert-remove-line--right { transform: rotate(-45deg); }

    .home-action-button {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 64rpx;
      height: 64rpx;
      margin-left: 8rpx;
      border-radius: 50%;
      background-color: #f2f1f6;
      box-sizing: border-box;
    }

    .home-action-button--add {
      margin-left: 0;
      margin-right: 12rpx;
    }

    .home-plus-glyph {
      position: relative;
      width: 32rpx;
      height: 32rpx;
    }

    .home-plus-line {
      position: absolute;
      left: 50%;
      top: 50%;
      border-radius: 999rpx;
      background-color: #393943;
      transform: translate(-50%, -50%);
    }

    .home-plus-line--horizontal {
      width: 30rpx;
      height: 3rpx;
    }

    .home-plus-line--vertical {
      width: 3rpx;
      height: 30rpx;
    }

    .home-capability-pill {
      display: flex;
      flex-direction: row;
      align-items: center;
      min-width: 0;
      max-width: 220rpx;
      height: 64rpx;
      padding: 0 16rpx;
      border-radius: 999rpx;
      background-color: #f2f1f6;
      box-sizing: border-box;
      margin-right: 12rpx;
    }

    .home-model-icon {
      width: 30rpx;
      height: 30rpx;
      border-radius: 6rpx;
      flex-shrink: 0;
    }

    .home-voice-icon {
      width: 44rpx;
      height: 44rpx;
    }

    .home-capability-text {
      flex: 1;
      min-width: 0;
      margin-left: 10rpx;
      color: #282832;
      font-size: 25rpx;
      lines: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .home-capability-spacer {
      flex: 1;
      min-width: 0;
    }

    .record-tip-container {
      display: flex;
      flex-direction: column;
      width: 100%;
      box-sizing: border-box;
      border-radius: 24rpx;
      position: relative;
      background-color: #fff;
      /* 圆角容器默认可能裁切溢出内容（鸿蒙实测会）；首页 @ 快捷浮层需渲染到容器上边界之外 */
      overflow: visible;
      /* #ifndef APP */
      box-shadow:
        0 9rpx 45rpx 0 rgba(0, 0, 0, 0.08),
        0 2rpx 10rpx 0 rgba(0, 0, 0, 0.08),
        0 0 3rpx 0 rgba(0, 0, 0, 0.08);
      border: 1rpx solid rgba(0, 0, 0, 0.15);
      /* #endif */
      /* #ifdef APP */
      box-shadow: 0 0 28rpx rgba(0, 0, 0, 0.12);
      /* #endif */
      /* #ifdef APP-IOS */
      border: 1rpx solid rgba(0, 0, 0, 0.15);
      /* #endif */
      /* #ifdef APP-ANDROID */
      // Android：1rpx 在部分机型会半像素丢失；用 1px 物理边框，底边更稳定
      border: 1px solid rgba(0, 0, 0, 0.15);
      z-index: 1;
      /* #endif */

      &.record-tip-container--with-extra {
        /* #ifdef APP-ANDROID */
        // 功能栏展开时与下方留出 1px，避免底边被贴合裁切
        margin-bottom: 2rpx;
        /* #endif */
      }

      &.record-tip-container--home {
        min-height: 176rpx;
        /* 圆角与 @ 专家快捷浮层（quick-panel 24rpx）保持一致 */
        border-radius: 24rpx;
      }

      &.record-tip-container--home-compact {
        /* iOS 原生 editor 聚焦后会重新声明约 200px 的默认最小高度；
           单行首页卡片必须锁定为两行布局（输入 + 能力栏），避免尾部大片空白。
           快捷面板绝对定位在卡片外，不应解除高度锁；否则鸿蒙 ArkWeb 输入 `/` 时会
           把 editor 撑到可视区剩余高度。仅多行、专家/推荐标签、功能栏展开或存在
           项目/工作目录底栏时移除，恢复内容自适应。 */
        height: 176rpx;
        max-height: 176rpx;
      }

      &.record-tip-container--quick-popup {
        // Android 子弹层不能越过父级层叠上下文；打开时让输入卡宿主盖住上方工具栏。
        z-index: 20;
      }

      &.remove-shadow {
        box-shadow: none;
        border-color: transparent;
        background-color: transparent;
      }
    }

    /* 专家独立行：位于输入行上方，不再叠在输入框内 */
    .input-expert-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      width: 100%;
      margin-top: 14rpx;
      padding: 0 18rpx;
      box-sizing: border-box;
    }

    .input-expert-pill {
      display: flex;
      flex-direction: row;
      align-items: center;
      min-width: 0;
      flex-shrink: 1;
      height: 52rpx;
      padding: 0 12rpx 0 8rpx;
      border-radius: 999rpx;
      background-color: #f2f1f6;
      box-sizing: border-box;
    }

    .input-expert-pill-name {
      flex: 1;
      min-width: 0;
      color: #34343d;
      /* 与输入框正文字号一致 */
      font-size: 28rpx;
      lines: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .input-expert-pill-remove {
      position: relative;
      flex-shrink: 0;
      width: 32rpx;
      height: 32rpx;
      margin-left: 6rpx;
    }

    .input-expert-pill-remove-line {
      position: absolute;
      left: 8rpx;
      top: 15rpx;
      width: 16rpx;
      height: 3rpx;
      border-radius: 999rpx;
      background-color: #8d8d97;
    }

    .input-expert-pill-remove-line--left { transform: rotate(45deg); }
    .input-expert-pill-remove-line--right { transform: rotate(-45deg); }

    .chat-input-container {
      width: 100%;
      position: relative;
      display: flex;
      flex-direction: row;
      align-items: center;
      align-self: stretch;
      min-height: 90rpx;

      .voice-recorder-button-full {
        width: 100%;
        flex: 1;
        min-width: 0;
        /* App/H5 一致：录音区铺满输入容器，右侧图标靠绝对定位悬浮 */
        align-self: stretch;
        /* #ifdef APP-ANDROID */
        // Android textarea 常驻占位，录音面板覆盖其上且不参与 flex 分栏。
        position: absolute;
        left: 0;
        top: 0;
        right: 0;
        bottom: 0;
        height: 90rpx;
        z-index: 1;
        /* #endif */
      }

      &.is-voice {
        // 与单行输入区同高，避免切语音时上方 manual chips 出现 1~2px 跳动
        height: 90rpx;
        min-height: 90rpx;
      }

      &.is-recording {
        height: auto;
        min-height: 90rpx;

        .voice-recorder-container {
          flex: 1;
          width: 100%;
        }
      }

      &.chat-input-container--home {
        // 首页单行态固定输入行盒，阻断 iOS editor 聚焦/失焦时恢复 200px 默认高度向上撑开卡片。
        height: 90rpx;
        min-height: 90rpx;
        overflow: hidden;

        &.multi-line {
          height: auto;
          overflow: visible;
        }

        &.is-voice {
          position: relative;

          .voice-recorder-button-full {
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            bottom: 0;
            width: 100%;
            height: 90rpx;
          }
        }

        .input {
          width: 100%;
          padding-right: 20rpx;
        }

        .rich-input {
          padding-right: 20rpx;
        }

      }

      .input {
        flex: 1;
        // 行高与最大高度须为整数倍，否则 APP/iOS 滚动裁剪会露出下一行
        // 正文与 mention chip 继承同一行高，换行时仍保留适度垂直间距
        $input-line-height: 52rpx;
        $input-max-lines: 5;
        line-height: $input-line-height;
        max-height: $input-line-height * $input-max-lines;
        margin: 10rpx 0 10rpx 10rpx;
        // 右侧图标改为绝对定位后，为文本预留两个操作图标的空间。
        padding: 0 124rpx 0 20rpx;
        border: none;
        font-size: 28rpx;
        font-weight: 400;
        color: #000;
        box-sizing: border-box;
        /* #ifndef APP */
        overflow-y: auto;
        resize: none;
        outline: none;
        /* #endif */

        &.input-text {
          /* 单行留右侧给 icon-wrap，多行宽度在 .multi-line 中覆盖 */
          /* #ifdef H5 || WEB */
          width: 90%;
          /* #endif */
        }

        // 隐藏滚动条 - 兼容各浏览器
        /* #ifndef APP */
        scrollbar-width: none; // Firefox
        -ms-overflow-style: none; // IE/Edge
        &::-webkit-scrollbar {
          display: none;
          width: 0;
          height: 0;
        }
        /* #endif */
      }

      /* editor 裁剪外壳：承担原 .input 的盒模型（flex/margin），高度由 editorInlineStyle 内联驱动。
         HX 5.21 前 App 端 editor 的 min-height 覆盖不生效（恒 200px），靠外壳裁剪保证输入条布局不爆 */
      .editor-shell {
        position: relative;
        flex: 1;
        min-width: 0;
        margin: 10rpx 0 10rpx 10rpx;
        /* 原生 editor 在 iOS 聚焦或失焦时都可能短暂恢复 200px 默认最小高度。
           驼峰内联 minHeight 负责正常尺寸，外壳裁剪只兜底原生层切换帧，避免撑高输入卡。 */
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
      }

      .rich-input {
        position: relative;
        z-index: 1;
        flex: 1;
        width: 100%;
        /* 官方要求：editor 默认带 min-height:200px，改高度须重写 min-height（必须 0px，
           iOS 上 rpx 值覆盖无效）；HX 5.21 前 App 端可能整体不生效，由外壳裁剪兜底 */
        min-height: 0px;
        /* 右侧图标绝对定位悬浮，为两个操作图标预留空间（home 场景无图标，另行覆盖） */
        padding: 0 124rpx 0 20rpx;
        border: none;
        box-sizing: border-box;
        font-size: 28rpx;
        font-weight: 400;
        /* 行高与外壳高度须为整数倍，否则 APP/iOS 滚动裁剪会露下一行 */
        line-height: 52rpx;
        color: #000;
        /* #ifdef APP */
        pointer-events: auto;
        /* #endif */
        /* #ifndef APP */
        outline: none;
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        &::-webkit-scrollbar {
          display: none;
          width: 0;
          height: 0;
        }
        /* #endif */
      }

      /* #ifdef H5 || WEB */
      /* uni-editor 的 H5 内层 .ql-container 自带 height/min-height: 200px；
         只约束 uni-editor 宿主无法覆盖它，iOS 聚焦时会按最小内容高度把整张输入卡撑开。 */
      :deep(.rich-input .ql-container) {
        height: 100% !important;
        min-height: 0 !important;
        max-height: 100% !important;
      }

      :deep(.rich-input .ql-container .ql-editor) {
        height: 100% !important;
        min-height: 0 !important;
        max-height: 100% !important;
      }
      /* #endif */

      .input-placeholder {
        color: rgba(0, 0, 0, 0.25);
        font-size: 28rpx;
        font-weight: 400;
      }

      & + .icon-wrap {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        align-self: center;
        align-items: center;
        justify-content: center;
        // 高于录音按钮 is-recording 的 z-index:100，避免偶发被盖住
        z-index: 200;
        /* #ifdef APP */
        pointer-events: auto;
        /* #endif */

        .icon-container {
          display: flex;
          flex-direction: row;
          align-items: center;
          flex-shrink: 0;
          margin-right: 12rpx;
          /* #ifdef APP-HARMONY */
          margin-right: 20rpx;
          /* #endif */

          .icon-action-hit {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 64rpx;
            height: 64rpx;
          }

          .iconfont {
            padding: 8rpx;
          }

          .icon-image {
            color: #5147ff;
          }

          .icon-send-image {
            color: #5147ff !important;
          }

          .icon-plus-image {
            /* #ifdef APP || MP-WEIXIN */
            margin-left: 10rpx;
            /* #endif */
          }
        }

        /* 多行：与输入框底部对齐（由父级 align-items: flex-end 控制） */
        &.icon-wrap--multi-line {
          top: auto;
          bottom: 12rpx;
          justify-content: flex-end;
          margin-bottom: 0;
        }

      }
    }

    .chat-input-container.multi-line {
      align-items: flex-end;

      .input {
        flex: 1;
        min-width: 0;
      }
    }
  }

  .record-overlay {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 520rpx;
    z-index: 998;
    pointer-events: none;
    opacity: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 48rpx;
    /* 常驻 DOM，避免按住过程中 v-if 插入节点把鸿蒙手势打成 touchcancel */
    /* #ifdef H5 || WEB || MP-WEIXIN */
    background: linear-gradient(
      180deg,
      rgba(58, 155, 255, 0) 0%,
      rgba(58, 155, 255, 0.62) 40%,
      rgba(42, 140, 255, 1) 100%
    );
    /* #endif */
    /* #ifdef APP */
    background-image: linear-gradient(to top, #2a8cff, rgba(58, 155, 255, 0));
    /* #endif */

    &.record-overlay--on {
      opacity: 1;
    }

    &.record-overlay--cancel {
      /* #ifdef H5 || WEB || MP-WEIXIN */
      background: linear-gradient(
        180deg,
        rgba(255, 90, 90, 0) 0%,
        rgba(255, 90, 90, 0.62) 40%,
        rgba(232, 72, 72, 1) 100%
      );
      /* #endif */
      /* #ifdef APP */
      background-image: linear-gradient(to top, #e84848, rgba(255, 90, 90, 0));
      /* #endif */
    }
  }

  .record-overlay__hint {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #ffffff;
    margin-bottom: 40rpx;
  }

  .record-overlay__wave {
    position: relative;
    width: 100%;
    height: 56px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .record-overlay__baseline {
    position: absolute;
    left: 12%;
    right: 12%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.45);
  }

  .record-overlay__bars {
    width: 76%;
    height: 56px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .record-overlay__bar {
    width: 4rpx;
    margin-left: 3rpx;
    margin-right: 3rpx;
    border-radius: 4rpx;
    background-color: #ffffff;
    /* #ifndef APP */
    transition: height 0.12s ease;
    /* #endif */
  }

  .extra-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 0.3s ease-in-out,
      margin-top 0.3s ease-in-out,
      padding 0.3s ease-in-out,
      opacity 0.3s ease-in-out;
    opacity: 0;

    &.show {
      max-height: 200rpx;
      margin-top: 24rpx;
      opacity: 1;
    }

