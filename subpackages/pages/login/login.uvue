<template>
  <login-content :initial-redirect="redirectUrl" />
</template>
<script setup lang="uts">
import { ref } from "vue";
import { onLoad } from "@dcloudio/uni-app";
import LoginContent from "./login-content.uvue";
// #ifdef H5 || WEB
import { authBrowserQuery, authBrowserOrigin, canUseBrowserIdp } from "@/utils/idpNavigation";
import { resolveMobileAuthReturn, resolvePendingAuthReturn } from "@/utils/authIdp";
// #endif
const redirectUrl = ref<string>("");
onLoad((query: any) => {
  // #ifdef H5 || WEB
  if (canUseBrowserIdp()) {
    // 直接读取原始 URL 并解码一次，保留 pending token 和业务 query 的编码。
    const raw = authBrowserQuery('redirect');
    const value = raw != null ? raw : '';
    const pending = resolvePendingAuthReturn(value, authBrowserOrigin());
    redirectUrl.value = pending.length > 0 ? pending : resolveMobileAuthReturn(value, authBrowserOrigin());
    return;
  }
  // #endif
  const q = query as UTSJSONObject;
  const redirectRaw = q["redirect"];
  if (redirectRaw != null && `${redirectRaw}`.length > 0) {
    const decoded = decodeURIComponent(`${redirectRaw}`);
    const target = decoded != null ? decoded : `${redirectRaw}`;
    redirectUrl.value = target == "/subpackages/pages/temporary-session/temporary-session"
      ? "/pages/message/message"
      : target;
  }
});

</script>
