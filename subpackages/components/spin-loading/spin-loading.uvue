<template>
  <!--
    App 端 CSS @keyframes / image animation 常无效；
    用 transition + transitionend 自驱动旋转，周期默认 1s（对齐 H5 icon_loading）。
  -->
  <view
    class="spin-loading"
    :style="boxStyle"
    @transitionend="onTransitionEnd"
  ></view>
</template>

<script setup lang="uts">
  const props = withDefaults(
    defineProps<{
      /** 尺寸，如 14px / 24px */
      size?: string;
      /** 环颜色 */
      color?: string;
      /** 一圈时长（ms），默认 1000 对齐 H5 */
      durationMs?: number;
    }>(),
    {
      size: "16px",
      color: "#3283ff",
      durationMs: 1000,
    },
  );

  const times = ref<number>(0);

  const boxStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    style["width"] = props.size;
    style["height"] = props.size;
    style["borderTopColor"] = props.color;
    style["borderRightColor"] = props.color;
    style["transform"] = `rotate(${times.value * 360}deg)`;
    style["transitionDuration"] = `${props.durationMs}ms`;
    return style;
  });

  function onTransitionEnd(): void {
    times.value = times.value + 1;
  }

  onMounted(() => {
    // 等节点就绪后再启动第一圈，避免首帧 transition 不触发
    setTimeout(() => {
      times.value = 1;
    }, 50);
  });
</script>

<style lang="scss" scoped>
  .spin-loading {
    box-sizing: border-box;
    border-radius: 100px;
    border-top-width: 2px;
    border-top-style: solid;
    border-right-width: 2px;
    border-right-style: solid;
    border-bottom-width: 2px;
    border-bottom-style: solid;
    border-bottom-color: transparent;
    border-left-width: 2px;
    border-left-style: solid;
    border-left-color: transparent;
    transition-property: transform;
    transition-timing-function: linear;
    transform: rotate(0deg);
  }
</style>
