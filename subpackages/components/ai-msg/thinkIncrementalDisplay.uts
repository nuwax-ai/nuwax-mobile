/**
 * THINK 增量展示缓冲。
 *
 * 背景：
 * - 单个 rich-text 的 :nodes 一旦整体替换，原生侧仍会整段 HTML 重解析/重排，
 *   「只增量转义」省不了 layout，长文 THINK 照样卡。
 * - 可行增量：把已稳定前缀冻成块（不再改 props），只更新尾部 live。
 *   冻结尽量落在换行处，避免 App 上多段 text/rich-text 块级断开把半句拆开。
 */

/** 尾部超过该长度则尝试冻结一段前缀 */
export const THINK_INC_CHUNK_CHARS: number = 480;

export type ThinkIncPaint = {
  /** 已冻结、不应再改动的段落（按展示顺序） */
  frozenParts: string[];
  /** 仍在增长的尾部 */
  livePart: string;
};

/**
 * 转义 THINK 片段为 rich-text HTML（仅处理增量 delta 时调用）。
 * @param fragment 原始文本片段（可含换行）
 */
export function escapeThinkHtmlFragment(fragment: string): string {
  if (fragment.length == 0) {
    return "";
  }
  return fragment
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/\n/g, "<br/>");
}

/**
 * 增量拼出 rich-text nodes：前缀已转义则只转义 delta。
 * 注意：即便如此，单个 rich-text 换绑 :nodes 仍会整段重排；请优先用分块冻结。
 */
export function buildThinkRichNodesIncremental(
  prevRaw: string,
  prevEscapedInner: string,
  nextRaw: string,
  styleAttr: string,
): string {
  let inner = "";
  if (
    prevRaw.length > 0 &&
    nextRaw.length >= prevRaw.length &&
    nextRaw.substring(0, prevRaw.length) == prevRaw
  ) {
    inner =
      prevEscapedInner +
      escapeThinkHtmlFragment(nextRaw.substring(prevRaw.length));
  } else {
    inner = escapeThinkHtmlFragment(nextRaw);
  }
  return `<span style="${styleAttr}">` + inner + `</span>`;
}

/**
 * 根据最新原文更新冻结块 + 尾部（追加友好；回退/改写则全量重建）。
 * @param prevFull 上次已应用的完整原文
 * @param prevFrozen 上次冻结块
 * @param prevLive 上次尾部
 * @param nextRaw 最新完整原文
 */
export function applyThinkIncremental(
  prevFull: string,
  prevFrozen: string[],
  prevLive: string,
  nextRaw: string,
): ThinkIncPaint {
  const canAppend =
    prevFull.length > 0 &&
    nextRaw.length >= prevFull.length &&
    nextRaw.substring(0, prevFull.length) == prevFull;

  if (canAppend != true) {
    return rebuildThinkIncremental(nextRaw);
  }

  if (nextRaw.length == prevFull.length) {
    return {
      frozenParts: prevFrozen,
      livePart: prevLive,
    } as ThinkIncPaint;
  }

  let live = prevLive + nextRaw.substring(prevFull.length);
  const frozen: string[] = [...prevFrozen];

  while (live.length >= THINK_INC_CHUNK_CHARS) {
    let cut = live.lastIndexOf("\n", THINK_INC_CHUNK_CHARS);
    if (cut < Math.floor(THINK_INC_CHUNK_CHARS / 3)) {
      cut = THINK_INC_CHUNK_CHARS - 1;
    }
    const end = cut + 1;
    frozen.push(live.substring(0, end));
    live = live.substring(end);
  }

  return {
    frozenParts: frozen,
    livePart: live,
  } as ThinkIncPaint;
}

function rebuildThinkIncremental(raw: string): ThinkIncPaint {
  const frozen: string[] = [];
  let offset = 0;
  while (raw.length - offset >= THINK_INC_CHUNK_CHARS) {
    const windowEnd = offset + THINK_INC_CHUNK_CHARS;
    let cut = raw.lastIndexOf("\n", windowEnd - 1);
    if (cut < offset + Math.floor(THINK_INC_CHUNK_CHARS / 3)) {
      cut = windowEnd - 1;
    }
    const end = cut + 1;
    frozen.push(raw.substring(offset, end));
    offset = end;
  }
  return {
    frozenParts: frozen,
    livePart: raw.substring(offset),
  } as ThinkIncPaint;
}
