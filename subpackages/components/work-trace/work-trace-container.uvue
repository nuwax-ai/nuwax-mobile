<template>
  <!--
    V2 整轮工作轨迹容器（H5/MP-WEIXIN 专用）。
    轨迹头：状态图标 + 「工作中 T」/「N 次工具调用 · 已工作 T」 + 展开箭头；
    折叠状态机（终态自动收起一次 / 手动保持 / 活动组切换收起）托管在 ai-msg，
    本组件为无状态展示壳；展开体内容（思考区 + 轨迹元素）经默认 slot 注入，
    收起仅 v-if 卸载内容，宿主组件实例不卸载 → 手动状态不丢。
  -->
  <view class="work-trace">
    <view class="work-trace__header" @tap="onToggle">
      <view v-if="running" class="work-trace__status">
        <text class="iconfont icon-Loader work-trace__spinner" />
      </view>
      <text
        v-else-if="failed"
        class="iconfont icon-waring work-trace__failed-icon"
      />
      <view v-else class="work-trace__dot" />
      <text class="work-trace__metrics" :class="{ 'is-failed': failed }">{{
        headerText
      }}</text>
      <text
        class="iconfont icon-a-Chevrondown work-trace__arrow"
        :class="{ 'is-expanded': expanded }"
      />
    </view>
    <view v-if="expanded" class="work-trace__body">
      <slot />
    </view>
  </view>
</template>

<script setup lang="uts">
  const props = withDefaults(
    defineProps<{
      /** 轨迹是否展开（有效展开 = 手动值 ?? 运行态默认）。 */
      expanded?: boolean;
      /** 轨迹头指标文案（含状态语态与耗时）。 */
      headerText?: string;
      /** 当前轮是否运行中。 */
      running?: boolean;
      /** 整轮是否存在失败。 */
      failed?: boolean;
    }>(),
    {
      expanded: false,
      headerText: "",
      running: false,
      failed: false,
    },
  );

  const emit = defineEmits<{
    toggle: [];
  }>();

  function onToggle(): void {
    emit("toggle");
  }
</script>

<style lang="scss" scoped>
  .work-trace {
    width: 100%;
    margin: 12rpx 0;

    &__header {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 12rpx;
      min-height: 56rpx;
      padding: 4rpx 8rpx;
      border-radius: 10rpx;
      box-sizing: border-box;

      &:active {
        background-color: rgba(18, 23, 43, 0.04);
      }
    }

    &__status {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32rpx;
      height: 32rpx;
    }

    &__spinner {
      font-size: 26rpx;
      color: #1890ff;
      animation: work-trace-spin 1s linear infinite;
    }

    &__failed-icon {
      flex-shrink: 0;
      font-size: 26rpx;
      color: #ffcb00;
      line-height: 34rpx;
    }

    &__dot {
      flex-shrink: 0;
      width: 12rpx;
      height: 12rpx;
      border-radius: 50%;
      background-color: #d9dce2;
      margin: 0 10rpx;
    }

    &__metrics {
      flex: 1;
      min-width: 0;
      font-size: 24rpx;
      color: #8b8e96;
      line-height: 34rpx;

      &.is-failed {
        color: #cf222e;
      }
    }

    &__arrow {
      flex-shrink: 0;
      font-size: 24rpx;
      color: #8b8e96;
      transition: transform 0.2s ease;

      &.is-expanded {
        transform: rotate(180deg);
      }
    }

    &__body {
      padding: 4rpx 0 8rpx;
    }
  }

  @keyframes work-trace-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
</style>
