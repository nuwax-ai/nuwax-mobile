/** 每个图片节点只绑定一个地址；成功后保留该节点，避免鸿蒙换 src 不重绘。 */
export class BufferedAvatarLayer {
  id: number = 0;
  url: string = "";
  loaded: boolean = false;
}

/** 保留已加载图，同时准备下一张；地址解析完成不代表图片已经可显示。 */
export class BufferedAvatarState {
  layers: BufferedAvatarLayer[] = [];
  loading: boolean = false;
  private sourceKey: string = "";
  private nextId: number = 0;
  private pendingId: number = 0;

  private keepLoaded(): void {
    this.layers = this.layers.filter((layer: BufferedAvatarLayer): boolean => layer.loaded);
    this.pendingId = 0;
  }

  update(sourceKey: string, displayUrl: string, failed: boolean): void {
    if (sourceKey != this.sourceKey) {
      this.sourceKey = sourceKey;
      this.keepLoaded();
    }
    // 服务端明确移除头像时才清旧图；解析中的空展示地址不会清旧图。
    if (sourceKey.length == 0) {
      this.keepLoaded();
      this.layers = [];
      this.loading = false;
      return;
    }
    if (failed || displayUrl.length == 0) {
      this.keepLoaded();
      this.loading = !failed;
      return;
    }
    for (let i = 0; i < this.layers.length; i++) {
      const layer = this.layers[i];
      if (layer.url == displayUrl) {
        if (layer.loaded) this.keepLoaded();
        this.loading = !layer.loaded;
        return;
      }
    }
    this.keepLoaded();
    const pending = new BufferedAvatarLayer();
    pending.id = ++this.nextId;
    pending.url = displayUrl;
    this.pendingId = pending.id;
    this.layers.push(pending);
    this.loading = true;
  }

  imageLoaded(id: number): boolean {
    if (id != this.pendingId || id == 0) return false;
    for (let i = 0; i < this.layers.length; i++) {
      const layer = this.layers[i];
      if (layer.id == id) {
        layer.loaded = true;
        // 只移除旧节点：新图沿用已触发 load 的节点，不重新创建或重新请求。
        this.layers = [layer];
        this.pendingId = 0;
        this.loading = false;
        return true;
      }
    }
    return false;
  }

  imageFailed(id: number): boolean {
    if (id != this.pendingId || id == 0) return false;
    this.keepLoaded();
    this.loading = false;
    return true;
  }
}
