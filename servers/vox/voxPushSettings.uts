/**
 * Nuwax Vox 设备语音网关 - 会议推送设置接口
 * 渠道开关读/写；mock 开关见 mockVoxData.uts
 */
import request from "@/servers/useRequest";
import { VOX_BASE_URL } from "@/constants/config";
import type { RequestResponse } from "@/types/interfaces/request";
import type {
  AppMeetingPushSettingsUpdateParams,
  IAppMeetingPushSettingsView,
} from "@/types/interfaces/voxPushSettings";
import {
  isVoxMockEnabled,
  mockVoxGetPushSettings,
  mockVoxUpdatePushSettings,
} from "./mockVoxData";

/** 获取会议推送设置（APP/邮箱/飞书/企微/钉钉渠道开关与推送策略） */
export async function apiVoxGetPushSettings(deviceId: string): Promise<RequestResponse<IAppMeetingPushSettingsView>> {
  if (isVoxMockEnabled()) {
    return mockVoxGetPushSettings();
  }
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/meeting/push-settings`, method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 更新会议推送设置（POST .../update；未传字段保持原值） */
export async function apiVoxUpdatePushSettings(deviceId: string, data: AppMeetingPushSettingsUpdateParams): Promise<RequestResponse<IAppMeetingPushSettingsView>> {
  // 只构造非 null 字段（局部更新语义）
  const body = new UTSJSONObject();
  if (data.appEnabled != null) body["appEnabled"] = data.appEnabled;
  if (data.emailEnabled != null) body["emailEnabled"] = data.emailEnabled;
  if (data.feishuEnabled != null) body["feishuEnabled"] = data.feishuEnabled;
  if (data.wecomEnabled != null) body["wecomEnabled"] = data.wecomEnabled;
  if (data.dingtalkEnabled != null) body["dingtalkEnabled"] = data.dingtalkEnabled;
  if (data.pushStrategy != null) body["pushStrategy"] = data.pushStrategy;
  if (isVoxMockEnabled()) {
    return mockVoxUpdatePushSettings(body);
  }
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/meeting/push-settings/update`, method: "POST", data: body, baseUrl: VOX_BASE_URL });
  return res;
}
