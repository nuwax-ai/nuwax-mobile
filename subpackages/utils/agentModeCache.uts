export type AgentMode = "ask" | "yolo";

export const AGENT_MODE_STORAGE_KEY = "nuwax_agent_mode_cache";

const isAgentMode = (mode: any | null): boolean =>
  mode === "yolo" || mode === "ask";

const normalizeAgentModeCacheAgentId = (
  agentId?: number | string | null,
): string | null => {
  if (agentId == null) {
    return null;
  }
  const normalized = `${agentId}`.trim();
  return normalized.length > 0 ? normalized : null;
};

const parseAgentModeCache = (
  raw: string | null,
): UTSJSONObject | AgentMode | null => {
  if (raw == null || `${raw}`.length === 0) {
    return null;
  }
  if (isAgentMode(raw)) {
    return raw as AgentMode;
  }
  try {
    const parsed = JSON.parse<UTSJSONObject>(raw);
    if (parsed != null && typeof parsed === "object") {
      return parsed;
    }
  } catch (e) {
    // ignore invalid cache
  }
  return null;
};

export const readAgentModeCache = (
  agentId?: number | string | null,
): AgentMode | null => {
  const agentKey = normalizeAgentModeCacheAgentId(agentId);
  const raw = uni.getStorageSync(AGENT_MODE_STORAGE_KEY) as string;
  const parsed = parseAgentModeCache(raw);

  if (isAgentMode(parsed)) {
    return parsed as AgentMode;
  }

  if (parsed == null) {
    return null;
  }

  // Android JSON.parse 返回 UTSJSONObject，不能强转为自定义 class。
  const cacheObj = parsed as UTSJSONObject;
  const agentsRaw = cacheObj["agents"];
  if (agentKey != null && agentsRaw != null) {
    const agents = agentsRaw as UTSJSONObject;
    const cachedAgentMode = agents[agentKey];
    if (isAgentMode(cachedAgentMode)) {
      return cachedAgentMode as AgentMode;
    }
  }

  const defaultMode = cacheObj["defaultMode"];
  if (isAgentMode(defaultMode)) {
    return defaultMode as AgentMode;
  }

  return null;
};

export const writeAgentModeCache = (
  mode: AgentMode,
  agentId?: number | string | null,
) => {
  const agentKey = normalizeAgentModeCacheAgentId(agentId);
  const raw = uni.getStorageSync(AGENT_MODE_STORAGE_KEY) as string;
  const parsed = parseAgentModeCache(raw);

  const nextCache = new UTSJSONObject();
  const agents = new UTSJSONObject();
  nextCache["version"] = 1;
  if (parsed != null && !isAgentMode(parsed)) {
    const existing = parsed as UTSJSONObject;
    const version = existing["version"];
    const defaultMode = existing["defaultMode"];
    const existingAgents = existing["agents"];
    if (version != null) {
      nextCache["version"] = version;
    }
    if (isAgentMode(defaultMode)) {
      nextCache["defaultMode"] = defaultMode;
    }
    if (existingAgents != null) {
      const existingAgentsObj = existingAgents as UTSJSONObject;
      const agentKeys = UTSJSONObject.keys(existingAgentsObj);
      for (let i = 0; i < agentKeys.length; i++) {
        const key = agentKeys[i];
        const cachedMode = existingAgentsObj[key];
        if (isAgentMode(cachedMode)) {
          agents[key] = cachedMode;
        }
      }
    }
  } else {
    if (isAgentMode(parsed)) {
      nextCache["defaultMode"] = parsed as AgentMode;
    }
  }

  if (agentKey != null) {
    agents[agentKey] = mode;
  } else {
    nextCache["defaultMode"] = mode;
  }
  nextCache["agents"] = agents;

  uni.setStorageSync(AGENT_MODE_STORAGE_KEY, JSON.stringify(nextCache));

  const eventPayload = new UTSJSONObject();
  eventPayload["agentId"] = agentKey;
  eventPayload["mode"] = mode;
  uni.$emit("NuwaxAgentModeChanged", eventPayload);
};
