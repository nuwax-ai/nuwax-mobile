export interface DiffChangePart {
  added?: boolean;
  removed?: boolean;
  value: string;
}

// #ifdef H5 || WEB
// @ts-ignore
import { diffLines as npmDiffLines } from "diff";
// #endif

const splitDiffLines = (text: string): string[] => {
  const lines = (text || "").split("\n");
  if (lines.length > 0 && lines[lines.length - 1] === "") {
    lines.pop();
  }
  return lines;
};

const mergeDiffChanges = (changes: DiffChangePart[]): DiffChangePart[] => {
  if (changes.length === 0) {
    return changes;
  }
  const merged: DiffChangePart[] = [];
  let current = changes[0];
  for (let i = 1; i < changes.length; i++) {
    const next = changes[i];
    const currentAdded = current.added == true;
    const currentRemoved = current.removed == true;
    const nextAdded = next.added == true;
    const nextRemoved = next.removed == true;
    if (currentAdded === nextAdded && currentRemoved === nextRemoved) {
      current = {
        added: current.added,
        removed: current.removed,
        value: current.value + next.value,
      } as DiffChangePart;
    } else {
      merged.push(current);
      current = next;
    }
  }
  merged.push(current);
  return merged;
};

/** APP/小程序端纯 UTS 行级 diff，避免引入 npm diff 包 */
const diffLinesNative = (oldText: string, newText: string): DiffChangePart[] => {
  const oldLines = splitDiffLines(oldText);
  const newLines = splitDiffLines(newText);
  const m = oldLines.length;
  const n = newLines.length;
  const dp: number[][] = [];

  for (let i = 0; i <= m; i++) {
    const row: number[] = [];
    for (let j = 0; j <= n; j++) {
      row.push(0);
    }
    dp.push(row);
  }

  for (let i = 1; i <= m; i++) {
    for (let j = 1; j <= n; j++) {
      if (oldLines[i - 1] === newLines[j - 1]) {
        dp[i][j] = dp[i - 1][j - 1] + 1;
      } else {
        const up = dp[i - 1][j];
        const left = dp[i][j - 1];
        dp[i][j] = up >= left ? up : left;
      }
    }
  }

  const stack: DiffChangePart[] = [];
  let i = m;
  let j = n;
  while (i > 0 || j > 0) {
    if (i > 0 && j > 0 && oldLines[i - 1] === newLines[j - 1]) {
      stack.push({ value: oldLines[i - 1] + "\n" } as DiffChangePart);
      i--;
      j--;
    } else if (j > 0 && (i === 0 || dp[i][j - 1] >= dp[i - 1][j])) {
      stack.push({ added: true, value: newLines[j - 1] + "\n" } as DiffChangePart);
      j--;
    } else {
      stack.push({ removed: true, value: oldLines[i - 1] + "\n" } as DiffChangePart);
      i--;
    }
  }

  const changes: DiffChangePart[] = [];
  for (let k = stack.length - 1; k >= 0; k--) {
    changes.push(stack[k]);
  }
  return mergeDiffChanges(changes);
};

// #ifdef H5 || WEB
export const computeDiffChanges = (
  oldText: string,
  newText: string,
): DiffChangePart[] => {
  return npmDiffLines(oldText || "", newText || "") as DiffChangePart[];
};
// #endif

// #ifndef H5 || WEB
export const computeDiffChanges = (
  oldText: string,
  newText: string,
): DiffChangePart[] => {
  return diffLinesNative(oldText || "", newText || "");
};
// #endif

export interface NormalizedFileDiffItem {
  path: string;
  oldText: string;
  newText: string;
}

export interface FileDiffLineStats {
  added: number;
  removed: number;
}

export interface FileDiffLineItem {
  type: string;
  content: string;
  oldLineNum: string;
  newLineNum: string;
}

const readString = (source: any, keys: string[]): string | undefined => {
  if (!source || typeof source !== "object") {
    return undefined;
  }
  for (let i = 0; i < keys.length; i++) {
    const value = source[keys[i]];
    if (typeof value === "string") {
      return value;
    }
  }
  return undefined;
};

const readPath = (source: any, locations?: any): string | undefined => {
  const direct = readString(source, [
    "path",
    "filePath",
    "filepath",
    "file_path",
    "filename",
  ]);
  if (direct) {
    return direct;
  }

  if (Array.isArray(locations)) {
    for (let i = 0; i < locations.length; i++) {
      const item = locations[i];
      if (item && typeof item === "object" && typeof item.path === "string") {
        return item.path;
      }
    }
  }

  return undefined;
};

export const parseUnifiedDiffToFileDiff = (
  diffText: string | undefined,
  fallbackPath?: string,
): NormalizedFileDiffItem[] => {
  if (!diffText) {
    return [];
  }

  const lines = diffText.split("\n");
  const items: NormalizedFileDiffItem[] = [];
  let path = fallbackPath || "";
  let oldLines: string[] = [];
  let newLines: string[] = [];
  let inHunk = false;

  const flush = () => {
    if (!path || (!oldLines.length && !newLines.length)) {
      return;
    }
    items.push({
      path,
      oldText: oldLines.join("\n"),
      newText: newLines.join("\n"),
    } as NormalizedFileDiffItem);
    oldLines = [];
    newLines = [];
    inHunk = false;
  };

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (line.startsWith("Index: ")) {
      flush();
      path = line.slice("Index: ".length).trim() || path;
      continue;
    }
    if (line.startsWith("--- ")) {
      continue;
    }
    if (line.startsWith("+++ ")) {
      const nextPath = line.slice(4).trim();
      if (nextPath && nextPath !== "/dev/null") {
        path = nextPath.replace(/^[ab]\//, "");
      }
      continue;
    }
    if (line.startsWith("@@")) {
      inHunk = true;
      continue;
    }
    if (!inHunk) {
      continue;
    }
    if (line.startsWith("+")) {
      newLines.push(line.slice(1));
      continue;
    }
    if (line.startsWith("-")) {
      oldLines.push(line.slice(1));
      continue;
    }
    if (line.startsWith(" ")) {
      const content = line.slice(1);
      oldLines.push(content);
      newLines.push(content);
    }
  }

  flush();
  return items;
};

export const normalizeFileDiffItems = (
  value: any,
): NormalizedFileDiffItem[] => {
  if (!value || typeof value !== "object") {
    return [];
  }

  const result = value;
  const data = result.data;
  const existingItems: NormalizedFileDiffItem[] = [];

  if (Array.isArray(data)) {
    for (let i = 0; i < data.length; i++) {
      const item = data[i];
      if (!item || typeof item !== "object" || item.type !== "diff") {
        continue;
      }
      const filePath = readPath(item);
      if (!filePath) {
        continue;
      }
      existingItems.push({
        path: filePath,
        oldText: readString(item, ["oldText", "old_text"]) || "",
        newText: readString(item, ["newText", "new_text"]) || "",
      } as NormalizedFileDiffItem);
    }
  }

  if (existingItems.length) {
    return existingItems;
  }

  const input = result.input || result.rawInput || result.raw_input || {};
  const locations = result.locations || input.locations;
  const filePath = readPath(input, locations) || readPath(result, locations);
  const diffItems = parseUnifiedDiffToFileDiff(
    readString(input, ["diff"]),
    filePath,
  );
  if (diffItems.length) {
    return diffItems;
  }

  if (!filePath) {
    return [];
  }

  const content = readString(input, ["content", "newContent", "new_content"]);
  if (content !== undefined) {
    return [
      {
        path: filePath,
        oldText: "",
        newText: content,
      } as NormalizedFileDiffItem,
    ];
  }

  const oldText = readString(input, ["oldString", "old_string", "oldText"]);
  const newText = readString(input, ["newString", "new_string", "newText"]);
  if (oldText !== undefined || newText !== undefined) {
    return [
      {
        path: filePath,
        oldText: oldText || "",
        newText: newText || "",
      } as NormalizedFileDiffItem,
    ];
  }

  return [];
};

export const getFileDiffLineStats = (
  item: NormalizedFileDiffItem,
): FileDiffLineStats => {
  let added = 0;
  let removed = 0;
  const changes = computeDiffChanges(item.oldText || "", item.newText || "");
  for (let i = 0; i < changes.length; i++) {
    const change = changes[i];
    let rawLines = String(change.value || "").split("\n");
    if (rawLines.length > 0 && rawLines[rawLines.length - 1] === "") {
      rawLines.pop();
    }
    if (change.added) {
      added += rawLines.length;
    } else if (change.removed) {
      removed += rawLines.length;
    }
  }
  return { added, removed } as FileDiffLineStats;
};

export const getFileDiffLines = (
  item: NormalizedFileDiffItem,
): FileDiffLineItem[] => {
  const lines: FileDiffLineItem[] = [];
  let oldLineCount = 1;
  let newLineCount = 1;
  const changes = computeDiffChanges(item.oldText || "", item.newText || "");

  for (let i = 0; i < changes.length; i++) {
    const change = changes[i];
    let rawLines = String(change.value || "").split("\n");
    if (rawLines.length > 0 && rawLines[rawLines.length - 1] === "") {
      rawLines.pop();
    }

    for (let j = 0; j < rawLines.length; j++) {
      const lineContent = rawLines[j];
      if (change.added) {
        lines.push({
          type: "added",
          content: lineContent,
          oldLineNum: " ",
          newLineNum: String(newLineCount++),
        } as FileDiffLineItem);
      } else if (change.removed) {
        lines.push({
          type: "removed",
          content: lineContent,
          oldLineNum: String(oldLineCount++),
          newLineNum: " ",
        } as FileDiffLineItem);
      } else {
        lines.push({
          type: "normal",
          content: lineContent,
          oldLineNum: String(oldLineCount++),
          newLineNum: String(newLineCount++),
        } as FileDiffLineItem);
      }
    }
  }

  return lines;
};

export const getFileDiffTotalStats = (
  items: NormalizedFileDiffItem[],
): FileDiffLineStats => {
  let added = 0;
  let removed = 0;
  for (let i = 0; i < items.length; i++) {
    const stats = getFileDiffLineStats(items[i]);
    added += stats.added;
    removed += stats.removed;
  }
  return { added, removed } as FileDiffLineStats;
};

export const toDiffInputFiles = (items: NormalizedFileDiffItem[]): any[] => {
  return items.map((item: NormalizedFileDiffItem) => ({
    filePath: item.path,
    oldText: item.oldText,
    newText: item.newText,
  }));
};
