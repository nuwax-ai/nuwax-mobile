{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": [
    "**/*.uts",
    "**/*.uvue",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "unpackage",
    "dist"
  ]
}
