/**
 * Nuwax Vox 设备语音网关 - Mock 数据与开关
 *
 * 联调前所有 /api/app/** 接口走这里；开关持久化在 storage（VOX_USE_MOCK_API），
 * DEBUG 默认开、生产默认关。mock 设备表为模块级可变数组，
 * 绑定/解绑/改名会在同一次 App 运行内保持状态，便于全流程演示。
 *
 * 响应统一构造为 RequestResponse（UTSJSONObject 包络 { code, message, data }），
 * 与真实后端一致，页面侧无需区分 mock/真实。
 */
import { VOX_USE_MOCK_STORAGE_KEY } from '@/constants/provision.constants';
import type { RequestResponse } from '@/types/interfaces/request';

/** 是否使用 Vox Mock（DEBUG 默认 true，生产默认 false） */
export function isVoxMockEnabled(): boolean {
  const v = uni.getStorageSync(VOX_USE_MOCK_STORAGE_KEY);
  if (v == null || v == '') {
    // #ifdef DEBUG
    return true;
    // #endif
    // #ifndef DEBUG
    return false;
    // #endif
  }
  return v == '1';
}

/** 设置 Vox Mock 开关（调试页用） */
export function setVoxMockEnabled(enabled: boolean): void {
  uni.setStorageSync(VOX_USE_MOCK_STORAGE_KEY, enabled ? '1' : '0');
}

// ================= 包络构造 =================

function okEnvelope(data: any | null): RequestResponse<any> {
  const env = new UTSJSONObject();
  env["code"] = "0000";
  env["message"] = "success";
  env["data"] = data;
  env["success"] = true;
  return env;
}

function errEnvelope(code: string, message: string): RequestResponse<any> {
  const env = new UTSJSONObject();
  env["code"] = code;
  env["message"] = message;
  env["data"] = null;
  env["success"] = false;
  return env;
}

/** 模拟网络延迟 */
function delay(ms: number): Promise<void> {
  return new Promise<void>((resolve, _reject) => {
    setTimeout(() => resolve(), ms);
  });
}

// ================= 设备 mock（有状态） =================

function makeDevice(deviceId: string, displayName: string, online: boolean, boundAt: string, secret: string | null): UTSJSONObject {
  const d = new UTSJSONObject();
  d["deviceId"] = deviceId;
  d["displayName"] = displayName;
  d["online"] = online;
  d["deviceSecret"] = secret;
  d["boundAt"] = boundAt;
  return d;
}

// 模块级设备表：初始 2 台
let mockDeviceTable: UTSJSONObject[] = [
  makeDevice("NX-A1B2-C3D4-E5F6", "灵珠", true, "2026-07-18T10:24:00+08:00", null),
  makeDevice("NX-F6E5-D4C3-B2A1", "客厅灵珠", false, "2026-07-19T21:03:00+08:00", null),
];

export async function mockVoxDeviceList(): Promise<RequestResponse<any>> {
  await delay(200);
  const arr: UTSJSONObject[] = [];
  // 列表不返回密钥，拷贝一份去掉 deviceSecret
  for (let i = 0; i < mockDeviceTable.length; i++) {
    const d = mockDeviceTable[i];
    const onlineVal = d.getBoolean("online");
    arr.push(makeDevice(
      `${d["deviceId"]}`, `${d["displayName"]}`,
      onlineVal != null ? onlineVal : false, `${d["boundAt"]}`, null,
    ));
  }
  return okEnvelope(arr);
}

export async function mockVoxBindDevice(deviceId: string, displayName: string): Promise<RequestResponse<any>> {
  await delay(300);
  if (deviceId == "") return errEnvelope("1001", "deviceId 不能为空");
  for (let i = 0; i < mockDeviceTable.length; i++) {
    if (`${mockDeviceTable[i]["deviceId"]}` == deviceId) {
      return errEnvelope("1002", "设备已被绑定");
    }
  }
  const tail = deviceId.length > 4 ? deviceId.slice(deviceId.length - 4) : deviceId;
  const name = displayName != "" ? displayName : deviceId;
  const device = makeDevice(deviceId, name, true, "2026-07-22T10:30:00+08:00", `mock-secret-${tail}`);
  mockDeviceTable.push(device);
  return okEnvelope(device);
}

export async function mockVoxUnbindDevice(deviceId: string): Promise<RequestResponse<any>> {
  await delay(200);
  const next: UTSJSONObject[] = [];
  let found = false;
  for (let i = 0; i < mockDeviceTable.length; i++) {
    if (`${mockDeviceTable[i]["deviceId"]}` == deviceId) {
      found = true;
    } else {
      next.push(mockDeviceTable[i]);
    }
  }
  if (!found) return errEnvelope("1004", "设备不存在或未绑定");
  mockDeviceTable = next;
  return okEnvelope(null);
}

export async function mockVoxRenameDevice(deviceId: string, displayName: string): Promise<RequestResponse<any>> {
  await delay(200);
  for (let i = 0; i < mockDeviceTable.length; i++) {
    if (`${mockDeviceTable[i]["deviceId"]}` == deviceId) {
      mockDeviceTable[i]["displayName"] = displayName != "" ? displayName : deviceId;
      return okEnvelope(mockDeviceTable[i]);
    }
  }
  return errEnvelope("1004", "设备不存在或未绑定");
}

export async function mockVoxMeetingModeSwitch(deviceId: string, start: boolean): Promise<RequestResponse<any>> {
  await delay(200);
  for (let i = 0; i < mockDeviceTable.length; i++) {
    const d = mockDeviceTable[i];
    if (`${d["deviceId"]}` == deviceId) {
      const online = d.getBoolean("online");
      if (online == null || !online) {
        return errEnvelope("1005", "设备离线，无法下发会议模式");
      }
      return okEnvelope(null);
    }
  }
  return errEnvelope("1004", "设备不存在或未绑定");
}

// ================= 会议 mock =================

function makeSegment(seq: number, speaker: string, text: string, startMs: number, endMs: number): UTSJSONObject {
  const s = new UTSJSONObject();
  s["seq"] = seq;
  s["speaker"] = speaker;
  s["text"] = text;
  s["startMs"] = startMs;
  s["endMs"] = endMs;
  s["startedAt"] = "2026-07-18T14:30:00+08:00";
  s["endedAt"] = "2026-07-18T14:30:20+08:00";
  return s;
}

function makeMeeting(
  id: number, title: string, brief: string | null, count: number | null,
  status: string, summaryStatus: string, fileAsrStatus: string | null,
  startedAt: string, endedAt: string, hasAudio: boolean,
): UTSJSONObject {
  const m = new UTSJSONObject();
  m["id"] = id;
  m["deviceId"] = "NX-A1B2-C3D4-E5F6";
  m["status"] = status;
  m["summaryStatus"] = summaryStatus;
  m["title"] = title;
  m["briefSummary"] = brief;
  m["participantCount"] = count;
  m["fileAsrStatus"] = fileAsrStatus;
  m["audioFileUrl"] = hasAudio ? `oss://vox-recordings/meeting-${id}.wav` : null;
  m["startedAt"] = startedAt;
  m["endedAt"] = endedAt;
  return m;
}

let mockMeetingTable: UTSJSONObject[] = [
  makeMeeting(101, "Q3产品规划评审", "讨论了Q3产品路线图，确定了3个核心Feature的优先级排序", 5, "ENDED", "SUCCESS", "SUCCESS", "2026-07-18T14:30:00+08:00", "2026-07-18T15:45:00+08:00", true),
  makeMeeting(102, "女娲移动端发版对齐", "确认 1.0.3 版本范围与灰度节奏，终端接入排期到下周", 4, "ENDED", "SUCCESS", "SUCCESS", "2026-07-19T10:00:00+08:00", "2026-07-19T10:42:00+08:00", true),
  makeMeeting(103, "语音网关接口评审", "对齐设备绑定、会议、推送三组接口契约", 3, "ENDED", "PENDING", "PENDING", "2026-07-20T16:00:00+08:00", "2026-07-20T16:35:00+08:00", true),
  makeMeeting(104, "桌搭固件周会", "BLE 配网窗口与 vox-config 端点确认", 6, "ENDED", "FAILED", "FAILED", "2026-07-21T09:30:00+08:00", "2026-07-21T10:05:00+08:00", true),
  makeMeeting(105, "客户交付讨论", null, null, "ENDED", "FAILED", "FAILED", "2026-07-21T19:20:00+08:00", "2026-07-21T19:50:00+08:00", false),
  makeMeeting(106, "早间站会", "同步昨日进度与今日计划", 5, "ENDED", "SUCCESS", "SUCCESS", "2026-07-22T09:35:00+08:00", "2026-07-22T09:50:00+08:00", true),
];

const MOCK_SUMMARY_MD = "## 会议摘要\n\n讨论了Q3产品路线图，确定 3 个核心 Feature 的优先级：\n\n1. 终端设备接入（最高优先）\n2. 会议回放体验优化\n3. 应用内消息中心\n\n## 行动项\n\n- 移动端：本周完成接口 mock 接入\n- 后端：提供正式网关域名与登录代理\n- 固件：实现 vox-config 自定义端点";

function makeDetailSegments(): UTSJSONObject[] {
  return [
    makeSegment(1, "说话人1", "我们先过一下Q3的路线图，移动端终端接入是这季度最高优先级。", 0, 8200),
    makeSegment(2, "说话人2", "后端这边绑定、会议、推送三组接口已经可以在网关上联调了。", 8200, 14500),
    makeSegment(3, "说话人1", "固件的 vox-config 端点什么时候能好？App 绑定时要把密钥下发下去。", 14500, 21000),
    makeSegment(4, "说话人3", "下周三之前给版本，先用 mock 端点联调。", 21000, 25600),
    makeSegment(5, "说话人2", "那 App 先全量接 mock，接口开关留好，联调时一切就切。", 25600, 31200),
  ];
}

export async function mockVoxMeetingList(keyword: string, timeRange: string, page: number, pageSize: number): Promise<RequestResponse<any>> {
  await delay(250);
  // 关键字过滤（标题/摘要）
  let filtered: UTSJSONObject[] = [];
  for (let i = 0; i < mockMeetingTable.length; i++) {
    const m = mockMeetingTable[i];
    const title = `${m["title"]}`;
    const briefVal = m["briefSummary"];
    const brief = briefVal != null ? `${briefVal}` : "";
    if (keyword != "" && !title.includes(keyword) && !brief.includes(keyword)) {
      continue;
    }
    filtered.push(m);
  }
  // timeRange 在 mock 里只演示 TODAY 过滤（数据均为 07-18 ~ 07-22）
  if (timeRange == "TODAY") {
    const today: UTSJSONObject[] = [];
    for (let i = 0; i < filtered.length; i++) {
      if (`${filtered[i]["startedAt"]}`.startsWith("2026-07-22")) {
        today.push(filtered[i]);
      }
    }
    filtered = today;
  } else if (timeRange == "THIS_WEEK") {
    const week: UTSJSONObject[] = [];
    for (let i = 0; i < filtered.length; i++) {
      const d = `${filtered[i]["startedAt"]}`;
      if (d >= "2026-07-20") week.push(filtered[i]);
    }
    filtered = week;
  }
  const total = filtered.length;
  const start = (page - 1) * pageSize;
  const items: UTSJSONObject[] = [];
  for (let i = start; i < filtered.length && items.length < pageSize; i++) {
    items.push(filtered[i]);
  }
  const pageView = new UTSJSONObject();
  pageView["items"] = items;
  pageView["total"] = total;
  pageView["page"] = page;
  pageView["pageSize"] = pageSize;
  return okEnvelope(pageView);
}

export async function mockVoxMeetingDetail(id: number): Promise<RequestResponse<any>> {
  await delay(250);
  for (let i = 0; i < mockMeetingTable.length; i++) {
    const m = mockMeetingTable[i];
    if ((m["id"] as number) == id) {
      const detail = new UTSJSONObject();
      const keys = ["id", "deviceId", "status", "summaryStatus", "title", "briefSummary", "participantCount", "fileAsrStatus", "audioFileUrl", "startedAt", "endedAt"];
      for (let ki = 0; ki < keys.length; ki++) {
        detail[keys[ki]] = m[keys[ki]];
      }
      const asrOk = m["fileAsrStatus"] != null && `${m["fileAsrStatus"]}` == "SUCCESS";
      detail["summary"] = asrOk ? MOCK_SUMMARY_MD : "";
      detail["transcript"] = asrOk ? "说话人1: 我们先过一下Q3的路线图...\n说话人2: 后端接口已可联调..." : "";
      detail["segments"] = asrOk ? makeDetailSegments() : ([] as UTSJSONObject[]);
      detail["audioBytes"] = m["audioFileUrl"] != null ? 1852320 : null;
      detail["audioDurationMs"] = m["audioFileUrl"] != null ? 31200 : null;
      return okEnvelope(detail);
    }
  }
  return errEnvelope("2004", "会议不存在");
}

export async function mockVoxMeetingAudioUrl(id: number): Promise<RequestResponse<any>> {
  await delay(150);
  const view = new UTSJSONObject();
  view["meetingId"] = id;
  // 固定可播放的示例音频
  view["url"] = "https://www.soundjay.com/misc/sounds/bell-ringing-05.mp3";
  view["expiresInSeconds"] = 86400;
  return okEnvelope(view);
}

export async function mockVoxMeetingReprocess(id: number): Promise<RequestResponse<any>> {
  await delay(300);
  for (let i = 0; i < mockMeetingTable.length; i++) {
    const m = mockMeetingTable[i];
    if ((m["id"] as number) == id) {
      m["summaryStatus"] = "PENDING";
      m["fileAsrStatus"] = "PENDING";
      const detail = new UTSJSONObject();
      detail["id"] = m["id"];
      detail["status"] = m["status"];
      detail["summaryStatus"] = m["summaryStatus"];
      detail["fileAsrStatus"] = m["fileAsrStatus"];
      return okEnvelope(detail);
    }
  }
  return errEnvelope("2004", "会议不存在");
}

// ================= 会议推送设置 mock（有状态） =================

let mockPushSettings = ((): UTSJSONObject => {
  const s = new UTSJSONObject();
  s["appEnabled"] = true;
  s["emailEnabled"] = true;
  s["feishuEnabled"] = false;
  s["wecomEnabled"] = false;
  s["dingtalkEnabled"] = false;
  s["pushStrategy"] = "AFTER_EACH_MEETING";
  return s;
})();

export async function mockVoxGetPushSettings(): Promise<RequestResponse<any>> {
  await delay(150);
  return okEnvelope(mockPushSettings);
}

export async function mockVoxUpdatePushSettings(patch: UTSJSONObject): Promise<RequestResponse<any>> {
  await delay(200);
  const keys = ["appEnabled", "emailEnabled", "feishuEnabled", "wecomEnabled", "dingtalkEnabled", "pushStrategy"];
  for (let i = 0; i < keys.length; i++) {
    const v = patch[keys[i]];
    if (v != null) mockPushSettings[keys[i]] = v;
  }
  return okEnvelope(mockPushSettings);
}

// ================= 推送消息 mock（有状态） =================

function makeMessage(id: number, messageType: string, refId: number | null, title: string, body: string, read: boolean, createdAt: string): UTSJSONObject {
  const m = new UTSJSONObject();
  m["id"] = id;
  m["messageType"] = messageType;
  m["refId"] = refId;
  m["title"] = title;
  m["body"] = body;
  m["read"] = read;
  m["createdAt"] = createdAt;
  return m;
}

let mockMessageTable: UTSJSONObject[] = [
