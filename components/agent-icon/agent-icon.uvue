<template>
  <view class="agent-icon">
    <view class="agent-icon-mask">
      <image
        :src="currentIcon"
        class="agent-icon-image"
        mode="aspectFill"
        flatten
        :fade-show="false"
        :alt="alt"
        @error="handleImageError"
      />
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, watch } from "vue";
  import defaultAgentIcon from "@/static/assets/agent_image.png";

  interface AgentIconProps {
    icon: string;
    alt?: string | null;
  }

  const props = withDefaults(defineProps<AgentIconProps>(), {
    alt: null,
  });

  const currentIcon = ref<string>(props.icon);
  watch(
    () : string => props.icon,
    (icon : string) => {
      currentIcon.value = icon;
    },
  );

  const handleImageError = () => {
    if (currentIcon.value != defaultAgentIcon) {
      currentIcon.value = defaultAgentIcon;
    }
  };
</script>

<style scoped lang="scss">
  .agent-icon {
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    box-shadow: 0 0 8rpx rgba(21, 23, 31, 0.18);

    /* Android 原生阴影渲染较淡，使用更大的模糊半径和透明度对齐 H5 观感。 */
    /* #ifdef APP-ANDROID */
    box-shadow: 0 0 12rpx rgba(21, 23, 31, 0.28);
    /* #endif */

    flex-shrink: 0;
    margin-right: 24rpx;

    .agent-icon-mask {
      width: 96rpx;
      height: 96rpx;
      border-radius: 50%;
      overflow: hidden;

      .agent-icon-image {
        width: 96rpx;
        height: 96rpx;
      }
    }
  }
</style>
