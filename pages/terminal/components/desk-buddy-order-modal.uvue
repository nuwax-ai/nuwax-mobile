      margin-top: -8rpx;
      margin-bottom: 16rpx;
    }

    .order-form-actions {
      display: flex;
      flex-direction: row;
      margin-top: 8rpx;
    }

    .order-form-btn {
      flex: 1;
      height: 80rpx;
      border-radius: 12rpx;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .order-form-btn-cancel {
      background-color: #f2f3f5;
      margin-right: 20rpx;
    }

