<template>
  <view></view>
</template>

<script setup lang="uts">
  import { computed, watch } from "vue";
  import { onTabPageHide, onTabPageShow } from "@/hooks/useMainTabLifecycle";
  import { isVoipBusy, voipRevision } from "@/features/voip/callManager";
  import { isNativeImVoipEnabled } from "@/features/voip/integration";
  import { androidCallAlertSteps, readAndroidCallPresentation } from "@/features/voip/permissionSettings";
  import { appForegroundRevision, isAppInBackground } from "@/utils/appLifecycle";
  import { hasAppPrivacyConsent } from "@/utils/appPrivacyConsent";
  import { hasLoginSession } from "@/utils/authSession";
  import { emptyI18nParams, t as translate } from "@/utils/i18n";
  import { VOIP_CALL_ALERT_STATE_KEY } from "@/utils/installScopedStorage";
  import { hasImPushPreferenceUser, readImPushEnabled } from "@/utils/im/imPushPreference";
  import { readStorageString } from "@/utils/readStorageString";

  let pageVisible = false;
  let promptVisible = false;
  const t = (key: string): string => translate(key, emptyI18nParams(), "");
  const inCall = computed((): boolean => { voipRevision.value; return isVoipBusy(); });

  // ★声明顺序：checkCallSettings 会调 showCallSettingsPrompt，被调的必须排前面
  //   （uvue/UTS 前向引用会编译成「先调用后声明」的 Kotlin，报 Unresolved reference）
  function showCallSettingsPrompt(): void {
    if (promptVisible || !pageVisible || isAppInBackground() || inCall.value) return;
    promptVisible = true;
    uni.showModal({
      title: t("Mobile.Voip.setupTitle"),
      content: t("Mobile.Voip.setupHint"),
      confirmText: t("Mobile.Voip.setupTitle"),
      cancelText: t("Mobile.PushBackground.later"),
      success: (result: ShowModalSuccess): void => {
        promptVisible = false;
        if (result.confirm == true && pageVisible && !isAppInBackground() && !isVoipBusy()) {
          uni.navigateTo({ url: "/subpackages/pages/settings/settings?section=call" });
        }
      },
      fail: (): void => {
        promptVisible = false;
      },
    });
  }

  function checkCallSettings(): void {
    if (!pageVisible || isAppInBackground() || inCall.value) return;
    if (!hasAppPrivacyConsent() || !hasLoginSession() || !isNativeImVoipEnabled()
      || (hasImPushPreferenceUser() && !readImPushEnabled())) {
      return;
    }
    const status = readAndroidCallPresentation();
    if (status == null) {
      return;
    }

    const saved = readStorageString(VOIP_CALL_ALERT_STATE_KEY);
    let previous = new UTSJSONObject();
    try {
      if (saved.startsWith("{")) previous = JSON.parse<UTSJSONObject>(saved) ?? new UTSJSONObject();
    } catch (_e) {}

    let missing = false;
    let newlyMissing = false;
    let changed = false;
    for (const step of androidCallAlertSteps(status)) {
      if (step.ready == null) continue;
      if (step.ready == false) {
        missing = true;
        if (previous[step.id] !== false) newlyMissing = true;
      }
      if (previous[step.id] !== step.ready) {
        previous[step.id] = step.ready;
        changed = true;
      }
    }
    // 兼容只存过「已提示」的版本。第一次读取仍保存实际状态，后续新增缺项照常提示。
    if (changed) {
      try {
        uni.setStorageSync(VOIP_CALL_ALERT_STATE_KEY, JSON.stringify(previous));
      } catch (_e) {
        // 写入失败不阻塞消息列表和本次提示。
      }
    }
    if (missing && newlyMissing && saved != "1" && !promptVisible) showCallSettingsPrompt();
  }

  onTabPageShow(() => {
    pageVisible = true;
    checkCallSettings();
  });
  onTabPageHide(() => {
    pageVisible = false;
  });
  watch(appForegroundRevision, () => { checkCallSettings(); });
  watch(inCall, (busy: boolean) => { if (!busy) checkCallSettings(); });
</script>
