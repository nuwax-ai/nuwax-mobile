import { firstString, orEmpty, orObject } from "@/utils/utsCoalesce";

/**
 * Diff 变更片段
 * UTS: 需 class 构造，不支持 interface 对象字面量
 */
export class DiffChangePart {
  added?: boolean;
  removed?: boolean;
  value: string = "";
}

function createDiffChangePart(
  value: string,
  added: boolean | null = null,
  removed: boolean | null = null,
): DiffChangePart {
  const part = new DiffChangePart();
  part.value = value;
  if (added != null) {
    part.added = added;
  }
  if (removed != null) {
    part.removed = removed;
  }
  return part;
}

// #ifdef H5 || WEB
// @ts-ignore
import { diffLines as npmDiffLines } from "diff";
// #endif

const splitDiffLines = (text: string): string[] => {
  const lines = orEmpty(text).split("\n");
  if (lines.length > 0 && lines[lines.length - 1] === "") {
    lines.pop();
  }
  return lines;
};

const mergeDiffChanges = (changes: DiffChangePart[]): DiffChangePart[] => {
  if (changes.length === 0) {
    return changes;
  }
  const merged: DiffChangePart[] = [];
  let current = changes[0];
  for (let i = 1; i < changes.length; i++) {
    const next = changes[i];
    const currentAdded = current.added == true;
    const currentRemoved = current.removed == true;
    const nextAdded = next.added == true;
    const nextRemoved = next.removed == true;
    if (currentAdded === nextAdded && currentRemoved === nextRemoved) {
      current = createDiffChangePart(
        current.value + next.value,
        current.added,
        current.removed,
      );
    } else {
      merged.push(current);
      current = next;
    }
  }
  merged.push(current);
  return merged;
};

/** APP/小程序端纯 UTS 行级 diff，避免引入 npm diff 包 */
const diffLinesNative = (oldText: string, newText: string): DiffChangePart[] => {
  const oldLines = splitDiffLines(oldText);
  const newLines = splitDiffLines(newText);
  const m = oldLines.length;
  const n = newLines.length;
  const dp: number[][] = [];

  for (let i = 0; i <= m; i++) {
    const row: number[] = [];
    for (let j = 0; j <= n; j++) {
      row.push(0);
    }
    dp.push(row);
  }

  for (let i = 1; i <= m; i++) {
    for (let j = 1; j <= n; j++) {
      if (oldLines[i - 1] === newLines[j - 1]) {
        dp[i][j] = dp[i - 1][j - 1] + 1;
      } else {
        const up = dp[i - 1][j];
        const left = dp[i][j - 1];
        dp[i][j] = up >= left ? up : left;
      }
    }
  }

  const stack: DiffChangePart[] = [];
  let i = m;
  let j = n;
  while (i > 0 || j > 0) {
    if (i > 0 && j > 0 && oldLines[i - 1] === newLines[j - 1]) {
      stack.push(createDiffChangePart(oldLines[i - 1] + "\n"));
      i--;
      j--;
    } else if (j > 0 && (i === 0 || dp[i][j - 1] >= dp[i - 1][j])) {
      stack.push(createDiffChangePart(newLines[j - 1] + "\n", true, null));
      j--;
    } else {
      stack.push(createDiffChangePart(oldLines[i - 1] + "\n", null, true));
      i--;
    }
  }

  const changes: DiffChangePart[] = [];
  for (let k = stack.length - 1; k >= 0; k--) {
    changes.push(stack[k]);
  }
  return mergeDiffChanges(changes);
};

// #ifdef H5 || WEB
export const computeDiffChanges = (
  oldText: string,
  newText: string,
): DiffChangePart[] => {
  return npmDiffLines(orEmpty(oldText), orEmpty(newText)) as DiffChangePart[];
};
// #endif

// #ifndef H5 || WEB
export const computeDiffChanges = (
  oldText: string,
  newText: string,
): DiffChangePart[] => {
  return diffLinesNative(orEmpty(oldText), orEmpty(newText));
};
// #endif

export class NormalizedFileDiffItem {
  path: string = "";
  oldText: string = "";
  newText: string = "";
}

function createNormalizedFileDiffItem(
  path: string,
  oldText: string,
  newText: string,
): NormalizedFileDiffItem {
  const item = new NormalizedFileDiffItem();
  item.path = path;
  item.oldText = oldText;
  item.newText = newText;
  return item;
}

export class FileDiffLineStats {
  added: number = 0;
  removed: number = 0;
}

function createFileDiffLineStats(
  added: number,
  removed: number,
): FileDiffLineStats {
  const stats = new FileDiffLineStats();
  stats.added = added;
  stats.removed = removed;
  return stats;
}

export class FileDiffLineItem {
  type: string = "";
  content: string = "";
  oldLineNum: string = "";
  newLineNum: string = "";
}

function createFileDiffLineItem(
  type: string,
  content: string,
  oldLineNum: string,
  newLineNum: string,
): FileDiffLineItem {
  const item = new FileDiffLineItem();
  item.type = type;
  item.content = content;
  item.oldLineNum = oldLineNum;
  item.newLineNum = newLineNum;
  return item;
}

function readString(source: any, keys: string[]): string | null {
  if (source == null || typeof source !== "object") {
    return null;
  }
  const sourceObj = source as UTSJSONObject;
  for (let i = 0; i < keys.length; i++) {
    const value = sourceObj[keys[i]];
    if (typeof value === "string") {
      return value;
    }
  }
  return null;
}

function readPath(source: any, locations: any | null = null): string | null {
  const direct = readString(source, [
    "path",
    "filePath",
    "filepath",
    "file_path",
    "filename",
  ]);
  if (direct != null && direct.length > 0) {
    return direct;
  }

  if (locations != null && Array.isArray(locations)) {
    for (let i = 0; i < locations.length; i++) {
      const item = locations[i];
      if (item != null && typeof item === "object") {
        const itemObj = item as UTSJSONObject;
        const path = itemObj["path"];
        if (typeof path === "string") {
          return path;
        }
      }
    }
  }

  return null;
}

/** 将可空字符串安全转为非空字符串 */
function nonEmptyString(value: string | null): string {
  return value != null ? value : "";
}

export const parseUnifiedDiffToFileDiff = (
  diffText: string | null,
  fallbackPath?: string,
): NormalizedFileDiffItem[] => {
  if (diffText == null || diffText.length === 0) {
    return [];
  }

  const lines = diffText.split("\n");
  const items: NormalizedFileDiffItem[] = [];
  let path = fallbackPath != null ? fallbackPath : "";
  let oldLines: string[] = [];
  let newLines: string[] = [];
  let inHunk = false;

  const flush = () => {
    if (path.length === 0 || (oldLines.length === 0 && newLines.length === 0)) {
      return;
    }
    items.push(
      createNormalizedFileDiffItem(
        path,
        oldLines.join("\n"),
        newLines.join("\n"),
      ),
    );
    oldLines = [];
    newLines = [];
    inHunk = false;
  };

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (line.startsWith("Index: ")) {
      flush();
      path = firstString([line.slice("Index: ".length).trim()], path);
      continue;
    }
    if (line.startsWith("--- ")) {
      continue;
    }
    if (line.startsWith("+++ ")) {
      const nextPath = line.slice(4).trim();
      if (nextPath.length > 0 && nextPath !== "/dev/null") {
        path = nextPath.replace(/^[ab]\//, "");
      }
      continue;
    }
    if (line.startsWith("@@")) {
      inHunk = true;
      continue;
    }
    if (!inHunk) {
      continue;
    }
    if (line.startsWith("+")) {
      newLines.push(line.slice(1));
      continue;
    }
    if (line.startsWith("-")) {
      oldLines.push(line.slice(1));
      continue;
    }
    if (line.startsWith(" ")) {
      const content = line.slice(1);
      oldLines.push(content);
      newLines.push(content);
    }
  }

  flush();
  return items;
};

export const normalizeFileDiffItems = (
  value: any,
): NormalizedFileDiffItem[] => {
  if (value == null || typeof value !== "object") {
    return [];
  }

  const resultObj = value as UTSJSONObject;
  const data = resultObj["data"];
  const existingItems: NormalizedFileDiffItem[] = [];

  if (Array.isArray(data)) {
    for (let i = 0; i < data.length; i++) {
      const item = data[i];
      if (item == null || typeof item !== "object") {
        continue;
      }
      const itemObj = item as UTSJSONObject;
      if (itemObj["type"] !== "diff") {
        continue;
      }
      const filePath = readPath(item, null);
      if (filePath == null || filePath.length === 0) {
        continue;
      }
      existingItems.push(
        createNormalizedFileDiffItem(
          filePath,
          nonEmptyString(readString(item, ["oldText", "old_text"])),
          nonEmptyString(readString(item, ["newText", "new_text"])),
        ),
      );
    }
  }

  if (existingItems.length > 0) {
    return existingItems;
  }

  const input = orObject(
    resultObj["input"],
    orObject(
      resultObj["rawInput"],
      orObject(resultObj["raw_input"], new UTSJSONObject()),
    ),
  );
  const inputObj = input as UTSJSONObject;
  const resultLocations = resultObj["locations"];
  const inputLocations = inputObj["locations"];
  const locations = resultLocations != null ? resultLocations : inputLocations;
  const pathCandidates: any[] = [
    orEmpty(readPath(input, locations)),
    orEmpty(readPath(resultObj, locations)),
  ];
  const filePath = firstString(pathCandidates);
  const diffItems = parseUnifiedDiffToFileDiff(
    readString(input, ["diff"]),
    filePath,
  );
  if (diffItems.length > 0) {
    return diffItems;
  }

  if (filePath.length === 0) {
    return [];
  }

  const content = readString(input, ["content", "newContent", "new_content"]);
  if (content != null) {
    return [createNormalizedFileDiffItem(filePath, "", content)];
  }

  const oldText = readString(input, ["oldString", "old_string", "oldText"]);
  const newText = readString(input, ["newString", "new_string", "newText"]);
  if (oldText != null || newText != null) {
    return [
      createNormalizedFileDiffItem(
        filePath,
        nonEmptyString(oldText),
        nonEmptyString(newText),
      ),
    ];
  }

  return [];
};

export const getFileDiffLineStats = (
  item: NormalizedFileDiffItem,
): FileDiffLineStats => {
  let added = 0;
  let removed = 0;
  const changes = computeDiffChanges(orEmpty(item.oldText), orEmpty(item.newText));
  for (let i = 0; i < changes.length; i++) {
    const change = changes[i];
    let rawLines = orEmpty(change.value).split("\n");
    if (rawLines.length > 0 && rawLines[rawLines.length - 1] === "") {
      rawLines.pop();
    }
    if (change.added == true) {
      added += rawLines.length;
    } else if (change.removed == true) {
      removed += rawLines.length;
    }
  }
  return createFileDiffLineStats(added, removed);
};

export const getFileDiffLines = (
  item: NormalizedFileDiffItem,
): FileDiffLineItem[] => {
  const lines: FileDiffLineItem[] = [];
  let oldLineCount = 1;
  let newLineCount = 1;
  const changes = computeDiffChanges(orEmpty(item.oldText), orEmpty(item.newText));

  for (let i = 0; i < changes.length; i++) {
    const change = changes[i];
    let rawLines = orEmpty(change.value).split("\n");
    if (rawLines.length > 0 && rawLines[rawLines.length - 1] === "") {
      rawLines.pop();
    }

    for (let j = 0; j < rawLines.length; j++) {
      const lineContent = rawLines[j];
      if (change.added == true) {
        lines.push(
          createFileDiffLineItem(
            "added",
            lineContent,
            " ",
            `${newLineCount++}`,
          ),
        );
      } else if (change.removed == true) {
        lines.push(
          createFileDiffLineItem(
            "removed",
            lineContent,
            `${oldLineCount++}`,
            " ",
          ),
        );
      } else {
        lines.push(
          createFileDiffLineItem(
            "normal",
            lineContent,
            `${oldLineCount++}`,
            `${newLineCount++}`,
          ),
        );
      }
    }
  }

  return lines;
};

export const getFileDiffTotalStats = (
  items: NormalizedFileDiffItem[],
): FileDiffLineStats => {
  let added = 0;
  let removed = 0;
  for (let i = 0; i < items.length; i++) {
    const stats = getFileDiffLineStats(items[i]);
    added += stats.added;
    removed += stats.removed;
  }
  return createFileDiffLineStats(added, removed);
};

export const toDiffInputFiles = (items: NormalizedFileDiffItem[]): any[] => {
  return items.map((item: NormalizedFileDiffItem) => ({
    filePath: item.path,
    oldText: item.oldText,
    newText: item.newText,
  }));
};
