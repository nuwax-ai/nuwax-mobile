<template>
  <acp-permission-card
    v-if="showAcpCard"
    :interaction="resolvedAcpInteraction"
    @respond="handleAcpRespond"
  />
  <mcp-ask-question-card
    v-else-if="showMcpCard"
    :interaction="resolvedMcpInteraction"
    @respond="handleMcpRespond"
  />
</template>

<script lang="uts">
/**
 * 干预卡片调度器
 * 按 kind 分发到 ACP 权限审批或 MCP Ask 子卡片
 * 对齐 Web 版 InterventionDockPanel.renderCard
 * 详见 components/agent-intervention/README.md
 */
import AcpPermissionCard from '@/components/agent-intervention/acp-permission-card/acp-permission-card.uvue'
import McpAskQuestionCard from '@/components/agent-intervention/mcp-ask-question-card/mcp-ask-question-card.uvue'
import type {
  AcpPermissionResponse,
  McpAskRespondPayload,
} from '@/types/intervention'

export default {
  name: 'InterventionCard',
  components: {
    AcpPermissionCard,
    McpAskQuestionCard,
  },
  props: {
    // Android：禁止 class 类型 prop（`Object as () => ClassType` / `String as () => Union`
    // 运行期会 CCE：McpAskInteraction cannot be cast to Function0）。统一宽松 Object/String，
    // 子卡片内部用 readRawField 读字段（对齐 mcp-ask-question-card 的做法）。
    kind: {
      type: String,
      required: true,
    },
    acpInteraction: {
      type: Object,
      default: null,
    },
    mcpInteraction: {
      type: Object,
      default: null,
    },
  },
  emits: ['respond-acp', 'respond-mcp'],
  computed: {
    showAcpCard(): boolean {
      // UTS: 禁止 `kind === 'x' && prop != null` 内联写法（Android 运行期 CCE：
      // McpAskInteraction cannot be cast to Function0）。拆成 if + == 字符串比较。
      if (this.kind == "acp_permission") {
        return this.acpInteraction != null;
      }
      return false;
    },
    showMcpCard(): boolean {
      if (this.kind == "mcp_ask") {
        return this.mcpInteraction != null;
      }
      return false;
    },
    // 返回 any | null（prop 可空），避免 `as ClassType` 在 Android 上 CCE；子卡片按 Object 接收、内部 readRawField。
    resolvedAcpInteraction(): any | null {
      return this.acpInteraction;
    },
    resolvedMcpInteraction(): any | null {
      return this.mcpInteraction;
    },
  },
  methods: {
    handleAcpRespond(response: AcpPermissionResponse) {
      this.$emit('respond-acp', response)
    },
    handleMcpRespond(payload: McpAskRespondPayload) {
      this.$emit('respond-mcp', payload)
    },
  },
}
</script>
