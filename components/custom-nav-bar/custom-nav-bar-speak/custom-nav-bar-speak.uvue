<template>
  <view class="all-conversations">
    <!-- 会话列表（Android：item 为 UTSJSONObject，字段走 helper） -->
    <view 
      class="conversation-item"
      hover-class="hover-class"
      hover-start-time="50"
      v-for="(item, index) in chatList"
      :key="getConversationKey(item, index)"
      @click="onConversationClick(item)"
    >
      <text class="conversation-title text-ellipsis">{{ getConversationTopic(item) }}</text>
      <text class="conversation-date">{{ getConversationDateText(item) }}</text>
    </view>
    <empty-state v-if="chatList.length == 0" />
  </view>
</template>

<script setup lang="uts">
import { formatDate } from '@/utils/system';
import { jumpToAgentDetailPage } from '@/utils/commonBusiness';
import { readRawField } from '@/utils/readRawField.uts';

interface CustomNavBarSpeakProps {
  chatList : any[],
  isAppDetails : boolean,
}

const props = withDefaults(defineProps<CustomNavBarSpeakProps>(), {
  chatList: [] as any[],
  isAppDetails: false,
})

const readConvString = (item: any | null, key: string): string => {
  const raw = readRawField(item, key);
  return raw != null ? `${raw}` : "";
}

const getConversationKey = (item: any | null, index: number): string => {
  const id = readConvString(item, "id");
  return id.length > 0 ? id : `conv-${index}`;
}

const getConversationTopic = (item: any | null): string => {
  return readConvString(item, "topic");
}

const getConversationDateText = (item: any | null): string => {
  const modified = readConvString(item, "modified");
  if (modified.length == 0) {
    return "";
  }
  return formatDate(modified, "MM-DD");
}

/** 会话项点击（Android：勿 as ConversationInfo） */
const onConversationClick = (item: any) => {
  const agentIdRaw = readRawField(item, "agentId");
  const idRaw = readRawField(item, "id");
  const agentId = agentIdRaw != null ? parseFloat(`${agentIdRaw}`) : 0;
  const conversationId = idRaw != null ? parseFloat(`${idRaw}`) : 0;

  if (props.isAppDetails) {
    let url = `/subpackages/pages/app-details/app-details?id=${agentId}`;
    if (conversationId != 0 && isNaN(conversationId) == false) {
      url = url + "&conversationId=" + conversationId;
    }
    uni.navigateTo({ url });
  } else {
    const convIdParam: number | null =
      conversationId != 0 && isNaN(conversationId) == false
        ? conversationId
        : null;
    jumpToAgentDetailPage(agentId, convIdParam, "ChatBot", "");
  }
};

</script>

<style lang="scss" scoped>
.conversation-item {
  height: 76rpx;
  padding: 0 16rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  transition: background-color 0.2s;
  border-radius: 16rpx;
}

/* vapor: 原 &.hover-class hoist 为同层单类（hover-class 由 uni-app hover-class 属性动态挂载到 .conversation-item）*/
.hover-class {
  background-color: rgba(12, 20, 102, 0.04);
}

.conversation-title {
  margin-right: 32rpx;
  color: #000;
  font-size: 28rpx;
  font-weight: 400;
  flex: 1;
}

.conversation-date {
  text-align: right;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.45);
}
</style>
