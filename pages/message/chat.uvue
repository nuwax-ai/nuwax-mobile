<template>
  <!-- #ifdef APP-ANDROID || APP-IOS -->
  <view class="chat-page-frame">
  <!-- #endif -->
    <chat-view ref="chatRef" class="chat-page-host" @close="handleClose" />
    <meeting-invite-banner />
    <meeting-active-banner />
  <!-- #ifdef APP-ANDROID || APP-IOS -->
    <return-to-call />
  </view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { nextTick, ref, type ComponentPublicInstance } from "vue";
  import { onLoad, onReady, onShow, onHide, onUnload, onBackPress } from "@dcloudio/uni-app";
  import ChatView from "./components/chat-view.uvue";
  import MeetingInviteBanner from "@/components/meeting-invite-banner/meeting-invite-banner.uvue";
  // #ifdef APP-ANDROID || APP-IOS
  import ReturnToCall from "@/features/voip/components/return-to-call.uvue";
  // #endif
  import MeetingActiveBanner from "@/components/meeting-active-banner/meeting-active-banner.uvue";
  import { switchMainTab } from "@/utils/mainTabNavigation";

  const chatRef = ref<any | null>(null);
  let loadOptions: any | null = null;
  let initPending = false;
  let showPending = false;
  let hidePending = false;
  let readyPending = false;
  let unloadPending = false;

  function flushLifecycle(attempt: number): void {
    const proxy = chatRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      if (attempt < 8) setTimeout((): void => { flushLifecycle(attempt + 1); }, 16);
      return;
    }
    if (initPending && loadOptions != null) {
      initPending = false;
      proxy.$callMethod("initFromOptions", loadOptions);
    }
    if (showPending) {
      showPending = false;
      proxy.$callMethod("onPageShow");
    }
    if (readyPending) {
      readyPending = false;
      proxy.$callMethod("onPageReady");
    }
    if (hidePending) {
      hidePending = false;
      proxy.$callMethod("onPageHide");
    }
    if (unloadPending) {
      unloadPending = false;
      proxy.$callMethod("onPageUnload");
    }
  }

  function scheduleFlush(): void {
    nextTick((): void => { flushLifecycle(0); });
  }

  function handleClose(): void {
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      switchMainTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    loadOptions = options;
    initPending = true;
    scheduleFlush();
  });

  onShow(() => {
    hidePending = false;
    showPending = true;
    scheduleFlush();
  });

  onReady(() => {
    readyPending = true;
    scheduleFlush();
  });

  onHide(() => {
    const proxy = chatRef.value as ComponentPublicInstance | null;
    if (proxy != null) {
      proxy.$callMethod("onPageHide");
    } else {
      hidePending = true;
    }
  });

  onUnload(() => {
    hidePending = true;
    unloadPending = true;
    flushLifecycle(0);
  });

  onBackPress((options: OnBackPressOptions): boolean => {
    const proxy = chatRef.value as ComponentPublicInstance | null;
    if (proxy == null) return false;
    return proxy.$callMethod("onPageBackPress", options) as boolean;
  });
</script>

<style scoped>
  .chat-page-frame {
    flex: 1;
    height: 100%;
    position: relative;
  }
  .chat-page-host {
    flex: 1;
    height: 100%;
  }
</style>
