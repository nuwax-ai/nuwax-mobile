<template>
  <uni-modal-popup ref="popupRef" position="bottom" height="78%" :show-header="false" :body-scroll="false" @update-visible="handleVisibleChange">
    <view class="sheet" :class="avoidTabBar ? 'sheet--avoid-tab-bar' : ''">
      <view class="sheet-header">
        <view class="title-box">
          <text class="sheet-title">{{ t("Mobile.CreateHub.knowledgeBase") }}</text>
          <text class="sheet-subtitle">{{ t("Mobile.KnowledgeList.capabilities") }}</text>
        </view>
        <view class="close-button" @click="close">
          <view class="close-line close-line--left" />
          <view class="close-line close-line--right" />
        </view>
      </view>

      <view class="toolbar">
        <scroll-view class="tabs-scroll" scroll-x="true" :show-scrollbar="false" :scroll-into-view="tabsScrollInto" :scroll-with-animation="true">
          <view class="tabs" :style="tabsRowStyle">
            <view id="knowledge-tab-recent" class="tab" :class="source == 'recent' ? 'tab--active' : ''" @click="selectRecent">
              <text class="tab-text">{{ t("Mobile.KnowledgeList.recent") }}</text>
              <view v-if="source == 'recent'" class="tab-indicator" />
            </view>
            <view v-for="space in spaces" :key="space.id" :id="`knowledge-tab-space-${space.id}`" class="tab" :class="source == 'space' && selectedSpaceId == space.id ? 'tab--active' : ''" @click="selectSpace(space.id)">
              <text class="tab-text">{{ space.name }}</text>
              <view v-if="source == 'space' && selectedSpaceId == space.id" class="tab-indicator" />
            </view>
          </view>
        </scroll-view>
        <view class="search-button" @click="searchOpen = !searchOpen">
          <svg-icon name="icon-Search" size="38" color="#656570" />
        </view>
      </view>

      <view v-if="searchOpen" class="search-box">
        <svg-icon name="icon-Search" size="32" color="#9a9aa4" />
        <input v-model="keyword" class="search-input" :placeholder="t('Mobile.KnowledgeList.searchPlaceholder')" confirm-type="search" />
        <view v-if="keyword.length > 0" class="search-clear" @click="keyword = ''">
          <text class="search-clear-text">×</text>
        </view>
      </view>

      <view class="sheet-list" :class="{ 'sheet-list--enter-next': swipeEnterDirection > 0, 'sheet-list--enter-prev': swipeEnterDirection < 0 }" @touchstart="handleSwipeStart" @touchend="handleSwipeEnd">
        <view v-show="source == 'recent'" class="sheet-list-pane">
          <knowledge-list-view class="sheet-list-inner" type="recent" variant="default" :space-id="0" :keyword="keyword" :page-size="20" @loaded="handleLoaded" @select="handleSelect" />
        </view>
        <template v-for="space in spaces" :key="'knowledge-pane-' + space.id">
          <view v-if="space.visited" v-show="source == 'space' && selectedSpaceId == space.id" class="sheet-list-pane">
            <knowledge-list-view class="sheet-list-inner" type="space" variant="default" :space-id="space.id" :keyword="keyword" :page-size="20" @loaded="handleLoaded" @select="handleSelect" />
          </view>
        </template>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { computed, getCurrentInstance, nextTick, ref, watch, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import KnowledgeListView from "@/components/knowledge-list-view/knowledge-list-view.uvue";
  import { apiSpaceList } from "@/servers/workspace";
  import { type KnowledgeListSourceType } from "@/types/interfaces/knowledgeList";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { HorizontalTabSwipeTracker } from "@/utils/horizontalTabSwipe";

  class KnowledgeSpaceItem {
    id: number = 0;
    name: string = "";
    type: string = "";
    visited: boolean = false;
  }

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const props = withDefaults(defineProps<{ visible: boolean; avoidTabBar?: boolean }>(), { visible: false, avoidTabBar: false });
  const emit = defineEmits<{ (e: "close"): void; (e: "select", item: UTSJSONObject): void; }>();
  const popupRef = ref<any | null>(null);
  const componentInstance = getCurrentInstance();
  const source = ref<KnowledgeListSourceType>("recent");
  const selectedSpaceId = ref<number>(0);
  const spaces = ref<KnowledgeSpaceItem[]>([] as KnowledgeSpaceItem[]);
  const keyword = ref<string>("");
  const searchOpen = ref<boolean>(false);
  const tabsRowWidthPx = ref<number>(0);
  const tabsScrollInto = ref<string>("");
  let spacesLoaded: boolean = false;
  const swipeTracker = new HorizontalTabSwipeTracker();
  const swipeEnterDirection = ref<number>(0);

  const tabsRowStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    if (tabsRowWidthPx.value > 0) style["width"] = `${tabsRowWidthPx.value}px`;
    return style;
  });

  function playSwipeEnter(direction: number): void {
    swipeEnterDirection.value = direction;
    setTimeout((): void => { swipeEnterDirection.value = 0; }, 20);
  }

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string): number {
    const raw = obj[key];
    if (raw == null) return 0;
    const value = parseFloat(`${raw}`);
    return isNaN(value) ? 0 : value;
  }

  function callPopup(method: string): void {
    if (popupRef.value != null) (popupRef.value as ComponentPublicInstance).$callMethod(method);
  }

  function close(): void { callPopup("close"); }
  function handleVisibleChange(value: boolean): void { if (value != true) emit("close"); }
  function activeTabId(): string {
    return source.value == "recent" ? "knowledge-tab-recent" : `knowledge-tab-space-${selectedSpaceId.value}`;
  }

  function ensureActiveTabVisible(attempt: number): void {
    if (componentInstance == null || componentInstance.proxy == null) return;
    const target = activeTabId();
    uni.createSelectorQuery()
      .in(componentInstance.proxy)
      .select(".tabs-scroll")
      .boundingClientRect()
      .select(".tab--active")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        if (target != activeTabId()) return;
        if (results.length < 2 || results[0] == null || results[1] == null) {
          if (attempt < 2) setTimeout((): void => ensureActiveTabVisible(attempt + 1), 120);
          return;
        }
        const viewport = results[0] as NodeInfo;
        const tab = results[1] as NodeInfo;
        const left = viewport.left != null ? parseFloat(`${viewport.left}`) : 0;
        const width = viewport.width != null ? parseFloat(`${viewport.width}`) : 0;
        const tabLeft = tab.left != null ? parseFloat(`${tab.left}`) : 0;
        const tabWidth = tab.width != null ? parseFloat(`${tab.width}`) : 0;
        if (width <= 0 || tabWidth <= 0) {
          if (attempt < 2) setTimeout((): void => ensureActiveTabVisible(attempt + 1), 120);
          return;
        }
        if (tabLeft >= left && tabLeft + tabWidth <= left + width) return;
        // 同一分类被再次选中时也要触发滚动（用户可能已经手动将它滑出视口）。
        if (tabsScrollInto.value == target) {
          tabsScrollInto.value = "";
          nextTick((): void => { if (target == activeTabId()) tabsScrollInto.value = target; });
        } else tabsScrollInto.value = target;
      });
  }

  function selectRecent(): void {
    source.value = "recent";
    keyword.value = "";
    nextTick((): void => ensureActiveTabVisible(0));
  }
  function selectSpace(spaceId: number): void {
    for (let i = 0; i < spaces.value.length; i++) {
      if (spaces.value[i].id == spaceId) spaces.value[i].visited = true;
    }
    source.value = "space";
    selectedSpaceId.value = spaceId;
    keyword.value = "";
    nextTick((): void => ensureActiveTabVisible(0));
  }

  function handleSwipeStart(event: UniTouchEvent): void { swipeTracker.begin(event); }
  function handleSwipeEnd(event: UniTouchEvent): void {
    const direction = swipeTracker.finish(event);
    if (direction == 0) return;
    let currentIndex = 0;
    if (source.value == "space") {
      for (let i = 0; i < spaces.value.length; i++) {
        if (spaces.value[i].id == selectedSpaceId.value) currentIndex = i + 1;
      }
    }
    const nextIndex = currentIndex + direction;
    if (nextIndex == 0) { playSwipeEnter(direction); selectRecent(); }
    else if (nextIndex > 0 && nextIndex <= spaces.value.length) { playSwipeEnter(direction); selectSpace(spaces.value[nextIndex - 1].id); }
  }

  function tabsRpxToPx(rpx: number): number {
    const info = uni.getWindowInfo();
    const width = info.windowWidth != null ? info.windowWidth : 375;
    return rpx * width / 750;
  }

  function measureTabsRow(attempt: number): void {
    if (componentInstance == null || componentInstance.proxy == null) return;
    uni.createSelectorQuery()
      .in(componentInstance.proxy)
      .select(".tabs-scroll")
      .boundingClientRect()
      .selectAll(".tab")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        const ready = results.length >= 2 && results[0] != null && results[1] != null && Array.isArray(results[1]);
        if (ready != true) {
          if (attempt < 2) setTimeout((): void => measureTabsRow(attempt + 1), 120);
          return;
        }
        const viewport = results[0] as NodeInfo;
        const tabRects = results[1] as NodeInfo[];
        const viewportWidth = viewport.width != null ? parseFloat(`${viewport.width}`) : 0;
        let contentWidth = 0;
        for (let i = 0; i < tabRects.length; i++) {
          contentWidth += tabRects[i].width != null ? parseFloat(`${tabRects[i].width}`) : 0;
        }
        contentWidth += tabRects.length * tabsRpxToPx(40);
        tabsRowWidthPx.value = contentWidth > viewportWidth + 1 ? Math.ceil(contentWidth) + 2 : 0;
        nextTick((): void => ensureActiveTabVisible(0));
      });
  }

  async function loadSpaces(): Promise<void> {
    if (spacesLoaded) return;
    spacesLoaded = true;
    try {
      const res = await apiSpaceList();
      if (apiResCode(res) != SUCCESS_CODE) return;
      const raw = apiResData<any>(res);
      const rows = raw != null ? (raw as any[]) : ([] as any[]);
      const personal = [] as KnowledgeSpaceItem[];
      const others = [] as KnowledgeSpaceItem[];
      for (let i = 0; i < rows.length; i++) {
        const obj = rows[i] as UTSJSONObject;
        const item = new KnowledgeSpaceItem();
        item.id = readNumber(obj, "id");
        item.name = readString(obj, "name");
        item.type = readString(obj, "type");
        if (item.id <= 0 || item.name.length == 0) continue;
        if (item.type == "Personal") personal.push(item);
        else others.push(item);
      }
      spaces.value = [...personal, ...others];
      if (selectedSpaceId.value <= 0 && spaces.value.length > 0) selectedSpaceId.value = spaces.value[0].id;
      nextTick((): void => measureTabsRow(0));
    } catch (_error) {
      spacesLoaded = false;
    }
  }

  function handleLoaded(type: string, count: number): void {
    if (type == "recent" && count == 0 && spaces.value.length > 0) selectSpace(spaces.value[0].id);
  }

  function handleSelect(item: UTSJSONObject): void {
    emit("select", item);
    close();
  }

  watch((): boolean => props.visible, (value: boolean): void => {
    if (value) {
      loadSpaces();
      callPopup("open");
      nextTick((): void => measureTabsRow(0));
    }
    else callPopup("close");
  });
</script>

<style scoped lang="scss">
  .sheet { display: flex; flex-direction: column; height: 100%; padding: 30rpx 32rpx 0; background-color: #ffffff; box-sizing: border-box; }
  /* #ifdef APP-ANDROID || APP-HARMONY */
  .sheet--avoid-tab-bar { padding-bottom: 100rpx; }
  /* #endif */
  /* #ifdef APP-IOS */
  /* iOS 窗口高度不含 tabBar（2026-09-19 真机实测），弹层无需避让，多留只会出现底部空白 */
  .sheet--avoid-tab-bar { padding-bottom: env(safe-area-inset-bottom); }
  /* #endif */
  /* #ifdef H5 */
  .sheet--avoid-tab-bar { padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
  /* #endif */
  .sheet-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 4rpx; }
  .title-box { display: flex; flex-direction: column; }
  .sheet-title { color: #17171d; font-size: 36rpx; font-weight: 700; line-height: 48rpx; }
  .sheet-subtitle { margin-top: 4rpx; color: #94949e; font-size: 25rpx; line-height: 34rpx; letter-spacing: 1rpx; }
  .close-button { position: relative; width: 58rpx; height: 58rpx; }
  .close-line { position: absolute; left: 13rpx; top: 28rpx; width: 34rpx; height: 4rpx; border-radius: 999rpx; background-color: #8b8b96; }
  .close-line--left { transform: rotate(45deg); }
  .close-line--right { transform: rotate(-45deg); }
  .toolbar { display: flex; flex-direction: row; align-items: flex-end; height: 92rpx; margin-top: 12rpx; border-bottom: 2rpx solid #f1f1f4; }
  .tabs-scroll { flex: 1; min-width: 0; height: 92rpx; }
  .tabs { display: flex; flex-direction: row; height: 92rpx; }
  .tab { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; height: 92rpx; margin-right: 40rpx; }
  .tab-text { color: #92929c; font-size: 29rpx; font-weight: 600; white-space: nowrap; }
  .tab--active .tab-text { color: #202027; }
  .tab-indicator { position: absolute; left: 0; right: 0; bottom: -2rpx; height: 6rpx; border-radius: 999rpx; background-color: #5b46ff; }
  .search-button { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 92rpx; background-color: #ffffff; }
  .search-box { display: flex; flex-direction: row; align-items: center; height: 68rpx; margin: 18rpx 4rpx 6rpx; padding: 0 18rpx; border-radius: 18rpx; background-color: #f5f4f8; }
  .search-input { flex: 1; height: 68rpx; margin-left: 12rpx; color: #292930; font-size: 27rpx; }
  .search-clear { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; }
  .search-clear-text { color: #9999a3; font-size: 36rpx; line-height: 40rpx; }
  .sheet-list { flex: 1; min-height: 0; display: flex; flex-direction: column; transition: transform 0.2s ease-out, opacity 0.2s ease-out; }
  .sheet-list--enter-next { transform: translateX(40rpx); opacity: 0.35; transition: none; }
  .sheet-list--enter-prev { transform: translateX(-40rpx); opacity: 0.35; transition: none; }
  .sheet-list-pane { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .sheet-list-inner { flex: 1; min-height: 0; }
</style>
