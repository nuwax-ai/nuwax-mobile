<template>
  <view class="app-entry">
    <!-- #ifdef APP -->
    <!-- #ifdef APP-ANDROID -->
    <app-privacy-consent v-if="appEntryStage == 'privacy'" @accepted="acceptPrivacy" />
    <!-- #endif -->
    <login-content v-if="appEntryStage == 'login'" :initial-redirect="appEntryLoginReturn" />
    <main-tab-content v-if="appEntryStage == 'main'" ref="mainContentRef" :visible="pageVisible" :page-ready="pageReady" />
    <meeting-invite-banner v-if="appEntryStage == 'main' && pageVisible" />
    <!-- #ifdef APP-ANDROID -->
    <return-to-call v-if="appEntryStage == 'main' && pageVisible" />
    <!-- #endif -->
    <!-- #endif -->
    <!-- #ifndef APP -->
    <main-tab-content ref="mainContentRef" :visible="pageVisible" :page-ready="pageReady" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
import { ref, nextTick, type ComponentPublicInstance } from "vue";
import { onLoad, onShow, onHide, onReady, onUnload, onBackPress, onResize } from "@dcloudio/uni-app";
import MainTabContent from "@/components/main-tab-content/main-tab-content.uvue";
import MeetingInviteBanner from "@/components/meeting-invite-banner/meeting-invite-banner.uvue";
import { MAIN_TAB_PATHS, isMainTabPath, mainTabPathOnly, selectMainTab } from "@/utils/mainTabNavigation";
// #ifdef APP
import LoginContent from "@/subpackages/pages/login/login-content.uvue";
import { appEntryStage, appEntryLoginReturn, attachAppEntry, detachAppEntry, resolveAppEntryStage, hasAppEntryToken, takeAppEntryColdStart } from "@/utils/appEntryState";
import { hasAppPrivacyConsent, prepareAppPrivacyConsent } from "@/utils/appPrivacyConsent";
import { routeIncomingQrLogin } from "@/utils/qrLoginNavigation";
import { scheduleImPushAfterLogin } from "@/utils/im/imPushClient";
// #endif
// #ifdef APP-ANDROID
import AppPrivacyConsent from "@/components/app-privacy-consent/app-privacy-consent.uvue";
import ReturnToCall from "@/features/voip/components/return-to-call.uvue";
import { schedulePushBackgroundGuideAfterLogin } from "@/utils/push/pushBackgroundGuide";
// #endif

const pageVisible = ref<boolean>(false);
const pageReady = ref<boolean>(false);
const mainContentRef = ref<ComponentPublicInstance | null>(null);
let disposed = false;
// #ifdef APP
// 首次渲染就选择有内容的界面，不创建空白中转页，也不等待业务网络请求。
const entryOwner = attachAppEntry();
let coldStartPending = true;
let pushScheduled = false;

function continueEntry(): void {
  if (disposed || !hasAppPrivacyConsent()) return;
  if (!pushScheduled && hasAppEntryToken()) {
    pushScheduled = true;
    scheduleImPushAfterLogin();
    // #ifdef APP-ANDROID
    schedulePushBackgroundGuideAfterLogin();
    // #endif
  }
  if (!pageReady.value || !coldStartPending) return;
  coldStartPending = false;
  // 仅显式扫码意图可打开确认页；普通冷启动没有任何 reLaunch/switchTab。
  nextTick((): void => {
    if (disposed || !takeAppEntryColdStart()) return;
    routeIncomingQrLogin(hasAppEntryToken(), "", true);
  });
}
function acceptPrivacy(): void {
  if (disposed) return;
  appEntryStage.value = resolveAppEntryStage();
  continueEntry();
}
// #endif

onLoad((options: OnLoadOptions) => {
  const tab = options["tab"];
  if (tab != null) {
    // 兼容旧入口传入的编码 Tab 地址。
    let path = `${tab}`;
    try { path = decodeURIComponent(path) ?? path; } catch (_error) {}
    if (isMainTabPath(path)) selectMainTab(MAIN_TAB_PATHS.indexOf(mainTabPathOnly(path)));
  }
  // #ifdef APP
  prepareAppPrivacyConsent((accepted: boolean) => {
    if (disposed || !accepted) return;
    // 只结束隐私准备，不因 Token 写入自动跳过登录表单的强制改密步骤。
    if (appEntryStage.value == "privacy") appEntryStage.value = resolveAppEntryStage();
    continueEntry();
  });
  // #endif
});
onShow(() => { pageVisible.value = true; });
onHide(() => { pageVisible.value = false; });
onReady(() => {
  pageReady.value = true;
  // #ifdef APP
  continueEntry();
  // #endif
});
onUnload(() => {
  disposed = true;
  pageVisible.value = false;
  // #ifdef APP
  detachAppEntry(entryOwner);
  // #endif
});
onBackPress((options: OnBackPressOptions): boolean => {
  const content = mainContentRef.value;
  return content != null ? content.$callMethod("onPageBackPress", options) as boolean : false;
});
onResize((options: OnResizeOptions) => {
  const content = mainContentRef.value;
  if (content != null) content.$callMethod("onPageResize", options);
});
</script>

<style>
/* #ifdef H5 || WEB */
page { height: 100%; overflow: hidden; }
uni-page-body { height: 100%; overflow: hidden; overscroll-behavior: none; }
/* #endif */
</style>
<style scoped>
.app-entry { flex: 1; height: 100%; background-color: #ffffff; }
</style>
