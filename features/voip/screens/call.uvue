<template>
  <view class="call-page">
    <view class="call-backdrop" />
    <!-- Retain the existing video mount condition and native bindings. -->
    <view v-if="showVideo" class="call-video">
      <!-- #ifndef APP-HARMONY -->
      <nuwax-voip-video :local="false" />
      <view class="call-self" :style="{ top: selfVideoTop + 'px' }"><nuwax-voip-video :local="true" /></view>
      <!-- #endif -->
      <view class="call-video-shade" />
    </view>
    <view class="call-content">
      <safety-zone />
      <view class="call-header">
        <view class="call-minimize" hover-class="call-pressed" @click="leave">
          <image class="call-minimize-icon" src="/static/voip/call-icons/minimize-white.png" mode="aspectFit" />
          <text class="call-minimize-label">{{ t("Mobile.Voip.minimize") }}</text>
        </view>
        <text class="call-kind">{{ t(video ? "Mobile.Voip.video" : "Mobile.Voip.audio") }}</text>
        <view class="call-header-spacer" />
      </view>

      <view class="call-identity" :class="{ 'call-identity--video': showVideo }">
        <view v-if="!showVideo" class="call-avatar-frame">
          <view class="call-avatar">
            <image v-if="avatarUrl.length > 0 && !avatarFailed" :key="avatarUrl" class="call-avatar-image" :src="avatarUrl" mode="aspectFill" @error="avatarFailed = true" />
            <text v-else class="call-avatar-text">{{ displayName.slice(0, 1) }}</text>
          </view>
        </view>
        <text class="call-name text-ellipsis-2" :class="{ 'call-name--video': showVideo }">{{ displayName }}</text>
        <view class="call-status">
          <view v-if="phase != 'ended' && phase != 'idle'" class="call-status-dot" :class="{ 'call-status-dot--active': phase == 'active' }" />
          <text class="call-state" :class="{ 'call-state--active': phase == 'active' }">{{ status }}</text>
        </view>
        <text v-if="phase == 'ended' && reason.length > 0" class="call-reason">{{ reason }}</text>
      </view>

      <view class="call-space" />
      <view v-if="error.length > 0 || voipPermissionPending || voipAudioInterrupted" class="call-feedback">
        <text v-if="error.length > 0" class="call-error">{{ error }}</text>
        <text v-if="voipPermissionPending && phase != 'ended'" class="call-notice">{{ t("Mobile.Voip.permissionForeground") }}</text>
        <text v-if="voipAudioInterrupted && phase != 'ended'" class="call-notice">{{ t("Mobile.Voip.audioInterrupted") }}</text>
        <button v-if="voipError == 'CALL_PERMISSION_REQUIRED'" class="call-settings" hover-class="call-pressed" @click="openSettings()">{{ t("Mobile.Voip.openSettings") }}</button>
      </view>

      <!-- These remain presentation-only controls over the existing manager operations. -->
      <view class="call-dock">
        <!-- #ifdef APP-HARMONY -->
        <button v-if="showVideo" class="call-settings" @click="showMedia()">{{ t("Mobile.Voip.return") }}</button>
        <!-- #endif -->
        <view v-if="phase == 'incoming'" class="call-controls" :class="{ 'call-controls--incoming': !video }">
          <call-control icon="hangup" tone="danger" :large="true" :label="t('Mobile.Voip.reject')" @press="endVoipCall()" />
          <call-control icon="phone" :tone="video ? 'default' : 'success'" :large="true" :label="t('Mobile.Voip.answerAudio')" @press="answerVoipCall('audio')" />
          <call-control v-if="video" icon="video" tone="success" :large="true" :label="t('Mobile.Voip.answerVideo')" @press="answerVoipCall('video')" />
        </view>
        <view v-else-if="phase != 'ended' && phase != 'idle'" class="call-controls-wrap">
          <view v-if="video" class="call-controls call-controls--video">
            <call-control :icon="voipMicrophone ? 'microphone' : 'microphone-off'" :selected="!voipMicrophone" :dense="true" :label="voipMicrophone ? t('Mobile.Voip.mute') : t('Mobile.Voip.unmute')" @press="setVoipMicrophone(!voipMicrophone)" />
            <call-control :icon="voipCamera ? 'video' : 'video-off'" :selected="!voipCamera" :dense="true" :label="voipCamera ? t('Mobile.Voip.cameraOff') : t('Mobile.Voip.cameraOn')" @press="setVoipCamera(!voipCamera)" />
            <call-control icon="switch-camera" :dense="true" :label="t('Mobile.Voip.switchCamera')" @press="switchVoipCamera()" />
            <call-control icon="speaker" :selected="voipSpeaker" :dense="true" :label="voipAudioRoutes.length > 0 ? t('Mobile.Voip.audioRoute') : (voipSpeaker ? t('Mobile.Voip.earpiece') : t('Mobile.Voip.speaker'))" @press="chooseAudioRoute()" />
          </view>
          <view class="call-controls" :class="{ 'call-controls--single': video }">
            <call-control v-if="!video" :icon="voipMicrophone ? 'microphone' : 'microphone-off'" :selected="!voipMicrophone" :label="voipMicrophone ? t('Mobile.Voip.mute') : t('Mobile.Voip.unmute')" @press="setVoipMicrophone(!voipMicrophone)" />
            <call-control icon="hangup" tone="danger" :large="true" :label="t('Mobile.Voip.hangup')" @press="endVoipCall()" />
            <call-control v-if="!video" icon="speaker" :selected="voipSpeaker" :label="voipAudioRoutes.length > 0 ? t('Mobile.Voip.audioRoute') : (voipSpeaker ? t('Mobile.Voip.earpiece') : t('Mobile.Voip.speaker'))" @press="chooseAudioRoute()" />
          </view>
        </view>
        <view v-else class="call-controls call-controls--single">
          <call-control icon="close" :large="true" :label="t('Mobile.Voip.close')" @press="leave" />
        </view>
      </view>
      <view :style="{ height: bottomInset + 'px' }" />
    </view>
  </view>
</template>
<script setup lang="uts">
  import { ref, computed, onMounted, onUnmounted, watch } from "vue";
  import CallControl from "@/features/voip/components/call-control.uvue";
  import { getSafeAreaBottom } from "@/utils/safeAreaBottom";
  import { getStatusBarHeight } from "@/utils/system";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  import { getVoipSnapshot, getVoipPhase, getVoipConnectedAt, getVoipPeerName, getVoipPeerAvatar, voipRevision, voipError, voipMicrophone, voipCamera, voipSpeaker,
    answerVoipCall as answerCall, endVoipCall as endCall, setVoipMicrophone as microphone, setVoipCamera as camera, setVoipSpeaker as speaker, switchVoipCamera as flipCamera } from "@/features/voip/callManager";
  import { showNativeVoipMedia } from "@/features/voip/callManager";
  import { voipAudioInterrupted, voipPermissionPending, voipAudioRoutes, voipAudioRoute, setVoipAudioRoute } from "@/features/voip/callManager";
  import { voipNativeIncomingUI } from "@/features/voip/callManager";
  import { openVoipAppSettings } from "@/uni_modules/nuwax-voip";
  import { callErrorTranslationKey, callEndTranslationKey } from "@/features/voip/callErrors";
  import { startForegroundCallAlert, stopForegroundCallAlert } from "@/utils/im/foregroundCallAlert";
  import { resolveImAvatarDisplay } from "@/utils/imAvatarDisplay";
  import { isAuthProtectedFileUrl, resolveAuthProtectedFileFetchUrl } from "@/utils/authProtectedFileUrl";
  import { getApiBaseUrl } from "@/constants/config";
  import { switchMainTab } from "@/utils/mainTabNavigation";
  const props = defineProps({ shown: { type: Boolean, default: false } });
  const END_SCREEN_DELAY_MS = 3000;
  function showMedia(): void { showNativeVoipMedia(); }
  function answerVoipCall(mode: string): void { answerCall(mode); }
  function endVoipCall(): void { endCall(); }
  function setVoipMicrophone(enabled: boolean): void { microphone(enabled); }
  function setVoipCamera(enabled: boolean): void { camera(enabled); }
  function setVoipSpeaker(enabled: boolean): void { speaker(enabled); }
  function switchVoipCamera(): void { flipCamera(); }
  function openSettings(): void { openVoipAppSettings(); }
  function chooseAudioRoute(): void {
    if (voipAudioRoutes.value.length == 0) { speaker(!voipSpeaker.value); return; }
    const routes = voipAudioRoutes.value.slice();
    const items: string[] = [];
    for (let i = 0; i < routes.length; i++) {
      const route = routes[i]; const kind = `${route["kind"] ?? "headset"}`;
      const label = `${route["name"] ?? ""}`;
      items.push((`${route["id"]}` == voipAudioRoute.value ? "✓ " : "") + (label.length > 0 ? label : t("Mobile.Voip." + kind)));
    }
    uni.showActionSheet({ itemList: items, success: (result) => { if (result.tapIndex < routes.length) setVoipAudioRoute(`${routes[result.tapIndex]["id"]}`); } });
  }
  const now = ref(Date.now()); let timer = 0;
  const bottomInset = ref(Math.max(16, getSafeAreaBottom()) + 12);
  const selfVideoTop = ref(getStatusBarHeight() + 64);
  const phase = computed((): string => { voipRevision.value; return getVoipPhase(); });
  const endedCallId = computed((): string => {
    voipRevision.value;
    return props.shown && phase.value == "ended" ? (getVoipSnapshot()?.callId ?? "") : "";
  });
  let autoCloseTimer = 0;
  const alertOwner = "voip-call-" + Date.now() + "-" + Math.floor(Math.random() * 1000000);
  function syncIncomingAlert(): void {
    if (phase.value == "incoming" && !voipNativeIncomingUI.value) startForegroundCallAlert(alertOwner);
    else stopForegroundCallAlert(alertOwner);
  }
  const peerName = computed((): string => { voipRevision.value; return getVoipPeerName(); });
  const displayName = computed((): string => peerName.value.length > 0 ? peerName.value : t("Mobile.Voip.title"));
  const peerAvatar = computed((): string => { voipRevision.value; return getVoipPeerAvatar(); });
  const avatarUrl = ref<string>("");
  const avatarFailed = ref<boolean>(false);
  let avatarRequest = 0;
  watch(peerAvatar, (url: string): void => {
    const request = ++avatarRequest;
    avatarUrl.value = "";
    avatarFailed.value = false;
    if (url.length == 0) return;
    if (isAuthProtectedFileUrl(url) && !resolveAuthProtectedFileFetchUrl(url).startsWith(getApiBaseUrl() + "/")) {
      avatarUrl.value = url;
      return;
    }
    resolveImAvatarDisplay(url, 208).then((resolved: string): void => {
      if (request == avatarRequest) avatarUrl.value = resolved;
    });
  }, { immediate: true });
  const video = computed((): boolean => { voipRevision.value; return getVoipSnapshot()?.mediaType == "video"; });
  const showVideo = computed((): boolean => video.value && phase.value != "incoming" && phase.value != "dialing" && phase.value != "ended");
  const error = computed((): string => voipError.value.length > 0 ? t(callErrorTranslationKey(voipError.value)) : "");
  const reason = computed((): string => {
    voipRevision.value; const value = getVoipSnapshot()?.reason ?? "";
    const key = callEndTranslationKey(value);
    return key.length > 0 ? t(key) : "";
  });
  const status = computed((): string => {
    if (phase.value == "active") {
      const start = getVoipConnectedAt();
      const seconds = Math.max(0, Math.floor((now.value - start) / 1000));
      return `${Math.floor(seconds / 60)}`.padStart(2, "0") + ":" + `${seconds % 60}`.padStart(2, "0");
    }
    if (phase.value == "dialing") return t("Mobile.Voip.dialing");
    if (phase.value == "incoming") return t("Mobile.Voip.incoming");
    if (phase.value == "connecting") return t("Mobile.Voip.connecting");
    if (phase.value == "reconnecting") return t("Mobile.Voip.reconnecting");
    return t("Mobile.Voip.ended");
  });
  function clearAutoClose(): void {
    if (autoCloseTimer == 0) return;
    clearTimeout(autoCloseTimer);
    autoCloseTimer = 0;
  }
  function leave(): void {
    clearAutoClose();
    if (getCurrentPages().length > 1) uni.navigateBack();
    else switchMainTab({ url: "/pages/message/message" });
  }
  watch(endedCallId, (callId: string): void => {
    clearAutoClose();
    if (callId.length == 0) return;
    autoCloseTimer = setTimeout((): void => {
      autoCloseTimer = 0;
      if (props.shown && getVoipPhase() == "ended" && getVoipSnapshot()?.callId == callId) leave();
    }, END_SCREEN_DELAY_MS);
  }, { immediate: true });
  watch(phase, (): void => { syncIncomingAlert(); });
  watch(voipNativeIncomingUI, (): void => { syncIncomingAlert(); });
  onMounted(() => { bottomInset.value = Math.max(16, getSafeAreaBottom()) + 12; selfVideoTop.value = getStatusBarHeight() + 64; timer = setInterval((): void => { now.value = Date.now(); }, 1000); syncIncomingAlert(); });
  onUnmounted(() => { avatarRequest++; clearAutoClose(); if (timer != 0) clearInterval(timer); stopForegroundCallAlert(alertOwner); });
</script>
<style scoped>
  .call-page { flex: 1; position: relative; background-color: #202827; overflow: hidden; }
  .call-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: linear-gradient(to bottom, #46534f, #202827); }
  .call-content { flex: 1; position: relative; }
  .call-header { height: 48px; flex-direction: row; align-items: center; padding-left: 16px; padding-right: 16px; }
  .call-minimize { width: 104px; height: 44px; flex-direction: row; align-items: center; justify-content: flex-start; }
  .call-minimize-icon { width: 20px; height: 20px; }
  .call-minimize-label { color: rgba(255, 255, 255, 0.7); font-size: 12px; margin-left: 7px; }
  .call-header-spacer { width: 104px; height: 44px; }
  .call-kind { flex: 1; color: rgba(255, 255, 255, 0.6); font-size: 13px; text-align: center; }
  .call-identity { align-items: center; padding-top: 48px; padding-left: 28px; padding-right: 28px; }
  .call-avatar-frame { width: 116px; height: 116px; padding: 5px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1); border-radius: 30px; }
  .call-avatar { width: 104px; height: 104px; border-radius: 24px; background-color: #71867c; align-items: center; justify-content: center; overflow: hidden; }
  .call-avatar-image { width: 104px; height: 104px; }
  .call-avatar-text { font-size: 44px; font-weight: 500; color: #f0f5f2; }
  .call-name { width: 100%; color: #ffffff; font-size: 28px; line-height: 36px; font-weight: 600; text-align: center; margin-top: 25px; }
  .call-status { margin-top: 14px; min-height: 24px; flex-direction: row; align-items: center; justify-content: center; }
  .call-status-dot { width: 5px; height: 5px; border-radius: 3px; background-color: #c4d2ca; margin-right: 9px; }
  .call-status-dot--active { background-color: #32d68a; }
  .call-state { color: rgba(255, 255, 255, 0.68); font-size: 15px; line-height: 24px; }
  .call-state--active { color: #ffffff; font-size: 20px; }
  .call-reason { color: rgba(255, 255, 255, 0.6); font-size: 14px; line-height: 22px; margin-top: 12px; text-align: center; }
  .call-space { flex: 1; min-height: 20px; }
  .call-feedback { padding: 0 28px 24px; align-items: center; }
  .call-error { color: #ffb7b7; font-size: 13px; line-height: 20px; text-align: center; }
  .call-notice { color: rgba(255, 255, 255, 0.76); font-size: 13px; line-height: 20px; text-align: center; margin-top: 6px; }
  .call-settings { color: #ffffff; background-color: rgba(255, 255, 255, 0.14); font-size: 13px; border-width: 0; border-radius: 20px; padding: 0 18px; margin-top: 12px; margin-bottom: 8px; }
  .call-dock { padding-left: 16px; padding-right: 16px; width: 100%; max-width: 420px; align-self: center; }
  .call-controls-wrap { width: 100%; align-items: center; }
  .call-controls { width: 100%; flex-direction: row; align-items: flex-end; justify-content: space-between; }
  .call-controls--single { justify-content: center; }
  .call-controls--incoming { padding-left: 18px; padding-right: 18px; }
  .call-controls--video { margin-bottom: 10px; }
  .call-pressed { opacity: 0.65; }
  .call-video { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #111716; }
  .call-self { position: absolute; right: 16px; width: 94px; height: 138px; border-width: 1px; border-color: rgba(255, 255, 255, 0.3); border-radius: 14px; overflow: hidden; background-color: #3d4943; }
  .call-video-shade { position: absolute; left: 0; right: 0; bottom: 0; height: 320px; background-image: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.85)); }
  .call-identity--video { align-items: flex-start; padding-top: 14px; padding-right: 128px; }
  .call-name--video { margin-top: 0; font-size: 20px; line-height: 28px; text-align: left; }
</style>
