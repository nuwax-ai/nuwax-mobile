/**
 * nuwax-katex：把包含 $...$ / $$...$$ 的正文切分为 [文本 | 行内公式 | 块级公式] 片段。
 *
 * 规则：
 * - `$$...$$` 块级公式（可跨多行）
 * - `$...$`   行内公式（单行内闭合，不允许跨行）
 * - `\$`      转义美元符：正文段显示为字面 `$`；公式段内容原样保留（KaTeX 自会处理 \$）
 * - 找不到闭合分隔符时按普通文本处理（不误吞正文）
 *
 * 注意：UTS 中字符串索引 text[i] 返回 Char，不能与 String 比较；
 * 统一用 charAt() + 双引号（与 appMarkdownFallback 的公式切分写法一致）。
 */
import type { MathSegment } from '@/uni_modules/nuwax-katex/utssdk/interface.uts'

/**
 * 切分正文为片段数组。空输入返回空数组。
 */
export function splitMathSegments(text: string): MathSegment[] {
	const segments: MathSegment[] = []
	const n = text.length
	let i = 0
	let textBuf = ''

	const flushText = () => {
		if (textBuf.length > 0) {
			const seg: MathSegment = {
				type: 'text',
				content: textBuf,
			}
			segments.push(seg)
			textBuf = ''
		}
	}

	while (i < n) {
		const ch = text.charAt(i)
		if (ch != "$") {
			// \$ 转义：正文里显示字面 $
			if (ch == "\\" && i + 1 < n && text.charAt(i + 1) == "$") {
				textBuf = textBuf + "$"
				i += 2
				continue
			}
			textBuf = textBuf + ch
			i++
			continue
		}

		// 块级 $$...$$
		if (i + 1 < n && text.charAt(i + 1) == "$") {
			const close = text.indexOf("$$", i + 2)
			if (close > i + 2) {
				flushText()
				const seg: MathSegment = {
					type: 'block',
					content: text.substring(i + 2, close),
				}
				segments.push(seg)
				i = close + 2
				continue
			}
			textBuf = textBuf + "$$"
			i += 2
			continue
		}

		// 行内 $...$：同一行内找未转义的闭合 $
		let j = i + 1
		let closed = false
		while (j < n) {
			const c = text.charAt(j)
			if (c == "\n") {
				break
			}
			if (c == "$") {
				// 统计前面连续反斜杠：奇数=转义（\$ 不是闭合符），偶数=闭合
				let backslashes = 0
				let k = j - 1
				while (k >= 0 && text.charAt(k) == "\\") {
					backslashes++
					k--
				}
				if (backslashes % 2 == 0) {
					closed = true
					break
				}
			}
			j++
		}
		if (closed && j > i + 1) {
			flushText()
			const seg: MathSegment = {
				type: 'inline',
				content: text.substring(i + 1, j),
			}
			segments.push(seg)
			i = j + 1
			continue
		}

		// 未闭合：字面 $
		textBuf = textBuf + "$"
		i++
	}
	flushText()
	return segments
}
