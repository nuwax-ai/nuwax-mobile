<template>
  <view class="reset-password-container relative flex flex-col">
    <custom-nav-bar :title="t('Mobile.Profile.resetPassword')" className="border-b" hasSafetyZone showBack />

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <view class="form-card">
        <view class="field-group">
          <text class="field-label">{{ t("Mobile.Profile.newPassword") }}</text>
          <view class="input-box">
            <input
              v-model="newPassword"
              class="field-input"
              :password="!showNewPassword"
              :placeholder="t('Mobile.Profile.inputNewPassword')"
              placeholder-class="field-placeholder"
            />
            <view class="eye-button" @tap="toggleNewPasswordVisibility">
              <svg-icon :name="showNewPassword ? 'icon-eye-open' : 'icon-eye-close'" size="32" />
            </view>
          </view>
        </view>

        <view class="field-group">
          <text class="field-label">{{ t("Mobile.Profile.confirmPassword") }}</text>
          <view class="input-box">
            <input
              v-model="confirmPassword"
              class="field-input"
              :password="!showConfirmPassword"
              :placeholder="t('Mobile.Profile.inputConfirmPassword')"
              placeholder-class="field-placeholder"
            />
            <view class="eye-button" @tap="toggleConfirmPasswordVisibility">
              <svg-icon :name="showConfirmPassword ? 'icon-eye-open' : 'icon-eye-close'" size="32" />
            </view>
          </view>
        </view>

        <view class="field-group field-group-last">
          <text class="field-label">{{ t("Mobile.Profile.verificationCode") }}</text>
          <view class="code-row">
            <view class="input-box code-input-box">
              <input
                v-model="verificationCode"
                class="field-input"
                type="number"
                maxlength="6"
                :placeholder="t('Mobile.Profile.inputVerificationCode')"
                placeholder-class="field-placeholder"
              />
            </view>
            <view class="code-button" :class="{ 'code-button-disabled': sendingCode || countdown > 0 }" @tap="handleSendCode">
              <text class="code-button-text">{{ sendCodeText }}</text>
            </view>
          </view>
        </view>

        <view class="submit-button" :class="{ 'submit-button-disabled': submitting }" @tap="handleSubmit">
          <text class="submit-button-text">{{ t("Mobile.Profile.confirmResetPassword") }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { onLoad, onUnload } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiResetPassword, apiSendCode, apiUserInfo } from "@/servers/account";
  import { SendCode, UserInfo } from "@/types/interfaces/login";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const newPassword = ref<string>("");
  const confirmPassword = ref<string>("");
  const verificationCode = ref<string>("");
  const showNewPassword = ref<boolean>(false);
  const showConfirmPassword = ref<boolean>(false);
  const submitting = ref<boolean>(false);
  const sendingCode = ref<boolean>(false);
  const countdown = ref<number>(0);
  const verificationTarget = ref<string>("");
  const verificationByEmail = ref<boolean>(false);
  let countdownTimer: number | null = null;

  const sendCodeText = computed((): string => {
    return countdown.value > 0
      ? countdown.value.toString() + "s"
      : t("Mobile.Profile.sendVerificationCode");
  });

  const clearCountdown = () => {
    if (countdownTimer != null) {
      clearInterval(countdownTimer);
      countdownTimer = null;
    }
    countdown.value = 0;
  };

  const startCountdown = () => {
    clearCountdown();
    countdown.value = 60;
    countdownTimer = setInterval(() => {
      countdown.value = countdown.value - 1;
      if (countdown.value <= 0) clearCountdown();
    }, 1000);
  };

  const loadVerificationTarget = async () => {
    try {
      const res = await apiUserInfo();
      if (apiResCode(res) != SUCCESS_CODE) return;
      const rawData = apiResData<any>(res);
      if (rawData == null) return;
      const info = new UserInfo(rawData as UTSJSONObject);
      if (info.phone.length > 0) {
        verificationTarget.value = info.phone;
        verificationByEmail.value = false;
      } else {
        verificationTarget.value = info.email;
        verificationByEmail.value = true;
      }
    } catch (error) {
      console.error("获取验证码接收方式失败", error);
    }
  };

  const toggleNewPasswordVisibility = () => {
    showNewPassword.value = !showNewPassword.value;
  };

  const toggleConfirmPasswordVisibility = () => {
    showConfirmPassword.value = !showConfirmPassword.value;
  };

  const handleSendCode = async () => {
    if (sendingCode.value || countdown.value > 0) return;
    if (verificationTarget.value.length == 0) {
      await loadVerificationTarget();
    }
    if (verificationTarget.value.length == 0) {
      uni.showToast({ title: t("Mobile.Profile.verificationTargetMissing"), icon: "none" });
      return;
    }

    sendingCode.value = true;
    try {
      const params = new SendCode();
      params.type = "RESET_PASSWORD";
      if (verificationByEmail.value) {
        params.email = verificationTarget.value;
      } else {
        params.phone = verificationTarget.value;
      }
      const res = await apiSendCode(params);
      if (apiResCode(res) != SUCCESS_CODE) {
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Profile.sendCodeFailed"), icon: "none" });
        return;
      }
      startCountdown();
      uni.showToast({ title: t("Mobile.Auth.codeSentSuccess"), icon: "success" });
    } catch (error) {
      console.error("发送重置密码验证码失败", error);
      uni.showToast({ title: t("Mobile.Profile.sendCodeFailed"), icon: "none" });
    } finally {
      sendingCode.value = false;
    }
  };

  const validateForm = (): boolean => {
    if (newPassword.value.length < 6) {
      uni.showToast({ title: t("Mobile.Auth.passwordMinLength"), icon: "none" });
      return false;
    }
    if (newPassword.value != confirmPassword.value) {
      uni.showToast({ title: t("Mobile.Auth.passwordMismatch"), icon: "none" });
      return false;
    }
    if (verificationCode.value.length != 6) {
      uni.showToast({ title: t("Mobile.Profile.verificationCodeInvalid"), icon: "none" });
      return false;
    }
    return true;
  };

  const handleSubmit = async () => {
    if (submitting.value || !validateForm()) return;
    submitting.value = true;
    try {
      const body = new UTSJSONObject();
      body["newPassword"] = newPassword.value;
      body["code"] = verificationCode.value;
      const res = await apiResetPassword(body);
      if (apiResCode(res) != SUCCESS_CODE) {
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Auth.passwordSetFailed"), icon: "none" });
        return;
      }
      newPassword.value = "";
      confirmPassword.value = "";
      verificationCode.value = "";
      clearCountdown();
      uni.showToast({ title: t("Mobile.Auth.passwordSetSuccess"), icon: "success" });
    } catch (error) {
      console.error("重置密码失败", error);
      uni.showToast({ title: t("Mobile.Auth.passwordSetFailed"), icon: "none" });
    } finally {
      submitting.value = false;
    }
  };

  onLoad((_options: any) => {
    setCurrentPageNavigationBarTitle();
    loadVerificationTarget();
  });

  onUnload(() => {
    clearCountdown();
  });
</script>

<style lang="scss" scoped>
  .reset-password-container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .form-card {
    margin: 24rpx;
    padding: 0 32rpx 32rpx;
    border-radius: 24rpx;
    background-color: #ffffff;
  }

  .field-group {
    padding: 32rpx 0;
    border-bottom: 2rpx solid #f5f5f5;

    &.field-group-last {
      border-bottom-width: 0;
    }
  }

  .field-label {
    margin-bottom: 20rpx;
    font-size: 30rpx;
    font-weight: 500;
    color: #1a1a1a;
  }

  .input-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 80rpx;
    padding: 0 20rpx;
    border: 2rpx solid #e8e8e8;
    border-radius: 16rpx;
    box-sizing: border-box;
  }

  .field-input {
    flex: 1;
    min-width: 0;
    font-size: 28rpx;
    color: #1a1a1a;
  }

  .field-placeholder {
    color: #bfbfbf;
  }

  .eye-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48rpx;
    height: 48rpx;
    margin-left: 12rpx;
    flex-shrink: 0;
    opacity: 0.5;
  }

  .code-row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .code-input-box {
    flex: 1;
  }

  .code-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 180rpx;
    height: 80rpx;
    margin-left: 16rpx;
    border-radius: 16rpx;
    background-color: #5147ff;
    flex-shrink: 0;

    &.code-button-disabled {
      opacity: 0.6;
    }
  }

  .code-button-text {
    font-size: 26rpx;
    color: #ffffff;
  }

  .submit-button {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80rpx;
    border-radius: 16rpx;
    background-color: #5147ff;

    &.submit-button-disabled {
      opacity: 0.6;
    }
  }

  .submit-button-text {
    font-size: 30rpx;
    font-weight: 500;
    color: #ffffff;
  }
</style>
