/**
 * 资料库文档的公开分享地址。
 * 进入网页页时预取：按 /repo/doc/{slugId} 查文档，再创建公开只读分享链接。
 */
import { apiRepoCreateShareLink, apiRepoPageBySlug } from "@/servers/repo";
import { apiResData, isApiSuccess } from "@/utils/apiResponse";
import { getApiBaseUrl } from "@/constants/config";

let cachedSlug = "";
let cachedUrl = "";
let pendingSlug = "";
let pending: Promise<string> | null = null;

/** 资料库文档地址 /repo/doc/{slugId} 中的短链。其它地址返回空串。 */
function repoDocSlug(raw: string): string {
  let path = raw;
  const hash = path.indexOf("#");
  if (hash >= 0) path = path.substring(0, hash);
  const query = path.indexOf("?");
  if (query >= 0) path = path.substring(0, query);
  const marker = "/repo/doc/";
  const at = path.indexOf(marker);
  if (at < 0) return "";
  let slug = path.substring(at + marker.length);
  const slash = slug.indexOf("/");
  if (slash >= 0) slug = slug.substring(0, slash);
  return slug;
}

function readPositiveId(raw: any | null): number {
  if (raw == null) return 0;
  const value = parseInt(`${raw}`);
  if (value == null || value <= 0) return 0;
  return value;
}

/** 请求并记下当前文档的分享地址。失败时清掉进行中的标记，方便点击分享时再取一次。 */
async function loadRepoPageShare(slugId: string): Promise<string> {
  let shareUrl = "";
  try {
    const pageRes = await apiRepoPageBySlug(slugId);
    let pageData: UTSJSONObject | null = null;
    if (isApiSuccess(pageRes) == true) {
      const pageRaw = apiResData<any>(pageRes);
      if (pageRaw != null) {
        pageData = pageRaw as UTSJSONObject;
      }
    }
    const pageId = pageData != null ? readPositiveId(pageData["id"]) : 0;
    if (pageId > 0) {
      const linkRes = await apiRepoCreateShareLink(pageId, "public", 0, 1);
      let linkData: UTSJSONObject | null = null;
      if (isApiSuccess(linkRes) == true) {
        const linkRaw = apiResData<any>(linkRes);
        if (linkRaw != null) {
          linkData = linkRaw as UTSJSONObject;
        }
      }
      const token = linkData != null && linkData["token"] != null ? `${linkData["token"]}`.trim() : "";
      if (token.length > 0) {
        shareUrl = getApiBaseUrl() + "/repo/share/" + encodeURIComponent(token);
      }
    }
  } catch (_error) {
    shareUrl = "";
  }
  if (shareUrl.length > 0) {
    cachedSlug = slugId;
    cachedUrl = shareUrl;
  }
  if (pendingSlug == slugId) {
    pending = null;
    pendingSlug = "";
  }
  return shareUrl;
}

/**
 * 进入资料库文档页时预取分享地址。不是 /repo/doc/{slugId} 时返回空串。
 * 同一短链的进行中请求会被后续调用复用。
 * @param pageUrl 当前网页地址
 */
export function prepareRepoPageShare(pageUrl: string): Promise<string> {
  const slugId = repoDocSlug(pageUrl);
  if (slugId.length == 0) return Promise.resolve("");
  if (cachedSlug == slugId) return Promise.resolve(cachedUrl);
  const current = pending;
  if (pendingSlug == slugId && current != null) return current;
  pendingSlug = slugId;
  const task = loadRepoPageShare(slugId);
  pending = task;
  return task;
}

/** 进入页面时已经拿到的分享地址。没有或不是当前文档时返回空串，不发请求。 */
export function readRepoPageShareUrl(pageUrl: string): string {
  const slugId = repoDocSlug(pageUrl);
  if (slugId.length == 0 || cachedSlug != slugId) return "";
  return cachedUrl;
}
