/**
 * Android：UTS class 经 JSON.stringify 可能丢字段，显式拼 UTSJSONObject。
 */
function buildConversationMessageListBody(
  data: ConversationMessageListParams,
): UTSJSONObject {
  const body = new UTSJSONObject();
  body["conversationId"] = data.conversationId;
  body["index"] = data.index;
  body["size"] = data.size;
  return body;
}

// 查询会话消息列表（加载更多历史消息）
