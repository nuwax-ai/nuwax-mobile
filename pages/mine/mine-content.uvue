<template>
  <view class="container relative flex flex-col">
    <!-- 顶部导航栏 -->
    <custom-nav-bar :title="t('Mobile.Nav.mine')" className="border-b" hasSafetyZone />

    <!-- 新消息顶部横幅（fixed 覆盖层） -->
    <im-notice-bar />

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <!-- 用户卡：整卡点击进账号管理页；卡内右侧二维码图标单独跳我的二维码页
           （@click.stop 阻断冒泡，避免一次点击推两层页面；openMyQr 内部自带空信息守卫） -->
      <view class="user-card" v-if="isLoggedIn" @click="handleAccountManagement">
        <!-- 圆形裁剪必须由外层 view（border-radius + overflow: hidden）承担：
             Android 端 <image> 自身的 border-radius 裁不住 SVG（矢量图不是位图，圆角被跳过），
             头像会露出 SVG 自带的圆角方形底板。与 components/agent-icon 保持同一结构。 -->
        <view class="user-avatar">
          <image
            v-if="currentAvatar.length > 0"
            class="user-avatar-image"
            :src="currentAvatar"
            mode="aspectFill"
            :fade-show="false"
            :alt="t('Mobile.Common.avatarAlt')"
            @error="handleImageError"
          />
        </view>
        <view class="user-info">
          <text class="user-name text-ellipsis">{{ displayName }}</text>
          <text class="user-desc text-ellipsis">{{ displayAccount }}</text>
        </view>
        <!-- 右侧竖排：二维码（点击进我的二维码页）+ 其正下方的右箭头（整卡点击进账号管理） -->
        <view class="user-side">
          <view class="user-qr-btn" v-if="myUserIdStr.length > 0" @click.stop="openMyQr">
            <svg-icon name="icon-Qrcode" size="15" unit="px" color="#9a98a5" />
          </view>
          <text class="user-card-arrow">›</text>
        </view>
      </view>

      <!-- 未登录引导 -->
      <view class="user-card" v-else @click="handleLogin">
        <view class="user-avatar">
          <image class="user-avatar-image" :src="defaultAvatar" :fade-show="false" mode="aspectFill" :alt="t('Mobile.Common.avatarAlt')" />
        </view>
        <view class="user-info">
          <text class="user-name">{{ t("Mobile.Common.loginRegister") }}</text>
          <text class="user-desc">{{ t("Mobile.Mine.loginTip") }}</text>
        </view>
      </view>

      <!-- 积分概览（iOS 上架版隐藏整个区块：积分/增购/订阅积分属付费体系展示，3.1.1/2.1(b)） -->
      <!-- #ifndef APP-IOS -->
      <view class="stats-row" v-if="isLoggedIn">
        <CreditsBreakdown :summary="creditsSummary" @add-purchase="handleAddPurchase" />
      </view>
      <!-- #endif -->

      <!-- 资料库（站内 repo-web 首页，登录态走 _ticket 免登进 webview 新页）；
           工作商业版未授权（workCommercialEdition !== true）整卡隐藏（对齐 PC 菜单
           enabled 口径），handleRepoLibrary 另有兜底守卫 -->
      <view v-if="!workRepoBlocked" class="card-group repo-group">
        <view class="row-item" @click="handleRepoLibrary">
          <view class="row-icon-box row-icon-repo">
            <view class="repo-book">
              <view class="repo-book-pages">
                <view class="repo-book-page"></view>
                <view class="repo-book-page"></view>
              </view>
              <view class="repo-book-base"></view>
            </view>
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Mine.repoLibrary") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
      </view>

      <!-- 智能终端：H5/Web 无配网，不展示。iOS 与 Android 一样进设备列表；
           硬件购买卡、下单弹窗仍在终端页内按 APP-IOS 单独屏蔽。 -->
      <!-- #ifndef H5 || WEB -->
      <template v-if="isLoggedIn">
        <view class="section-title"><text class="section-title-text">{{ t("Mobile.Mine.smartTerminal") }}</text></view>
        <view class="card-group">
          <view class="row-item" @click="handleMyTerminal">
            <view class="row-icon-box row-icon-terminal">
              <view class="terminal-monitor">
                <view class="terminal-monitor-screen"></view>
                <view class="terminal-monitor-neck"></view>
                <view class="terminal-monitor-base"></view>
              </view>
            </view>
            <view class="row-info">
              <text class="row-title">{{ t("Mobile.Mine.myTerminal") }}</text>
            </view>
            <text class="row-value">{{ terminalCountText }}</text>
            <text class="row-arrow">›</text>
          </view>
        </view>
      </template>
      <!-- #endif -->

      <!-- 账户设置 -->
      <view class="section-title"><text class="section-title-text">{{ t("Mobile.Mine.account") }}</text></view>
      <view class="card-group">
        <!-- 我的订阅（iOS 上架版隐藏：无应用内购买渠道，订阅页仅其他平台可见） -->
        <!-- #ifndef APP-IOS -->
        <view
          v-if="isSubscriptionEnabled"
          class="row-item"
          @click="handleMySubscriptions"
        >
          <view class="row-icon-box">
            <svg-icon name="icon-member" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Header.mySubscriptions") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <!-- #endif -->
        <!-- 我的订单（iOS 上架版隐藏：与备案备注「不含支付功能」口径一致，全端无购买/订单链路） -->
        <!-- #ifndef APP-IOS -->
        <view
          v-if="isSubscriptionEnabled"
          class="row-item"
          @click="handleMyOrders"
        >
          <view class="row-icon-box">
            <svg-icon name="icon-order" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Header.myOrders") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <!-- #endif -->
        <!-- 系统消息 -->
        <view class="row-item" @click="handleSystemMessages">
          <view class="row-icon-box">
            <svg-icon name="icon-bell" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.SystemMessages.title") }}</text>
          </view>
          <view v-if="systemMessageUnreadCount > 0" class="row-badge">
            <text class="row-badge-text">{{ systemMessageUnreadCount > 99 ? "99+" : `${systemMessageUnreadCount}` }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <!-- 推送通知（原账号管理页移入）：业务开关 + 系统通知权限合并为一个，开关状态 = 真能收到推送
             ★系统权限只能申请、无法由代码关闭，所以「关」只关业务侧（后端不再下发本设备）；
               系统权限被拒/未授予时开关回弹为关，并弹窗引导去系统设置开启。 -->
        <!-- #ifdef APP-ANDROID || APP-IOS || APP-HARMONY -->
        <view class="row-item" v-if="isLoggedIn">
          <view class="row-icon-box">
            <svg-icon name="icon-notification-box" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Profile.pushNotifications") }}</text>
          </view>
          <switch class="push-switch" :checked="pushSwitchChecked" :disabled="pushBusy || !pushReady" color="#6155F5" @change="handlePushChange" />
        </view>
        <!-- #endif -->
      </view>
      <!-- #ifdef APP-ANDROID || APP-IOS || APP-HARMONY -->
      <view class="section-title" v-if="isLoggedIn"><text class="section-title-text">{{ t("Mobile.Mine.about") }}</text></view>
      <view class="card-group" v-if="isLoggedIn">
        <!-- 检查更新：按当前 App 平台读取租户配置中的版本信息 -->
        <view class="row-item" @click="handleCheckUpdate">
          <view class="row-icon-box">
            <svg-icon name="icon-attention" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Mine.checkUpdate") }}</text>
          </view>
          <text class="row-value">{{ appVersionDisplay }}</text>
          <text class="row-arrow">›</text>
        </view>
        <!-- 隐私协议：仅 App 端（Android / iOS / 鸿蒙）展示，点击跳转外部隐私协议页 -->
        <view class="row-item" @click="handlePrivacyPolicy">
          <view class="row-icon-box">
            <svg-icon name="icon-api-key-thick" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Mine.privacyAgreement") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <!-- 用户协议：链接与登录页协议勾选一致（Mobile.Auth.userAgreementLink） -->
        <view class="row-item" @click="handleUserAgreement">
          <view class="row-icon-box">
            <svg-icon name="icon-a-Filetext" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Mine.userAgreement") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <!-- 联系我们：点击展示反馈邮箱 -->
        <view class="row-item" @click="handleContactUs">
          <view class="row-icon-box">
            <svg-icon name="icon-message" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Mine.contactUs") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <!-- 关于我们（仅正式站 agent.nuwax.com 展示；目标页需登录态，走 _ticket 免登录跳转） -->
        <view
          v-if="isAboutUsVisible"
          class="row-item"
          @click="handleAboutUs"
        >
          <view class="row-icon-box">
            <svg-icon name="icon-HelpAndFeedback" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Mine.helpFeedback") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
      </view>
      <!-- #endif -->

      <view class="card-group logout-group" v-if="isLoggedIn">
        <!-- 退出登录 -->
        <view class="row-item logout-item" @click="handleLogout">
          <view class="row-icon-box">
            <svg-icon name="icon-Exit" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Header.logout") }}</text>
          </view>
        </view>
      </view>
      <view class="bottom-space"></view>
    </scroll-view>


    <!-- 增购积分套餐弹窗（iOS 上架版不挂载：无应用内购买渠道，3.1.1/2.1(b)） -->
    <!-- #ifndef APP-IOS -->
    <PurchaseModal ref="purchaseModalRef" :on-payment-success="fetchCreditsSummary" />
    <!-- #endif -->

    <!-- 登录弹窗（仅微信小程序） -->
    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, onUnmounted, type ComponentPublicInstance } from "vue";
  import { useMainTabLifecycle } from "@/hooks/useMainTabLifecycle";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiUserInfo, apiLogout, apiTenantConfig } from "@/servers/account";
  import { apiGetCreditSummary } from "@/subpackages/servers/subscription";
  import { UserInfo } from "@/types/interfaces/login";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { resolveDisplayImageUrl } from "@/utils/remoteSvgImage";
  import defaultAvatar from "@/static/assets/avatar.png";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import {
    ABOUT_US_PAGE_PATH,
    REPO_LIBRARY_PAGE_PATH,
    clearStoragePreservingApiBaseUrl,
    getApiBaseUrl,
    isAboutUsEntryHost,
  } from "@/constants/config";
  import { addTicketAndJumpToWebview, addTicketAndJumpToWebviewWithoutShare, syncNativeTabBarState } from "@/utils/commonBusiness";
  import { getCurrentPageFullPath } from "@/utils/common";
  import { goToLogin } from "@/utils/authNavigation";
  import { unregisterImDeviceSafe } from "@/utils/im/imWsClient";
  import { setCurrentPageNavigationBarTitle, checkSubscriptionEnable as checkSubscriptionEnableUtil } from "@/utils/system";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import { useI18n, emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  // #ifdef MP-WEIXIN
  import AuthLoginPopup from "@/components/auth-login-popup/auth-login-popup.uvue";
  // #endif
  import CreditsBreakdown from "@/components/credits-breakdown/credits-breakdown.uvue";
  import PurchaseModal from "@/subpackages/pages/my-subscriptions/components/purchase-modal/purchase-modal.uvue";
  import { refreshSystemMessageBadge, systemMessageUnreadCount } from "@/utils/notificationBadge";
  // 推送通知开关（App 三端；H5/小程序无离线推送）
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  import { apiImDeviceRegister, ensureImPushPreferenceUser } from "@/servers/im";
  import {
    getImPushCid,
    ensureImPushCid,
    getImNotifyPermissionState,
    openImNotifyPermissionSettings,
    IM_NOTIFY_PERMISSION_GRANTED,
  } from "@/utils/im/imPushClient";
  import {
    hasImPushPreferenceUser,
    readImPushEnabled,
    writeImPushEnabled,
  } from "@/utils/im/imPushPreference";
  import { getImSessionStamp } from "@/utils/im/imSessionScope";
  // #endif
  import { isWorkCommercialBlockedSync } from "@/utils/workCommercial";
  import eventBus from "@/utils/eventBus";
  import { PROFILE_SETUP_COMPLETED_EVENT } from "@/utils/profileSetupPrompt";
  // #ifdef APP-IOS
  import {
    teardownResidentChatForLogout,
    isResidentChatVisible,
    isResidentChatCoverActive,
  } from "@/utils/residentChatShell";
  // #endif

  // #ifndef H5 || WEB
  import { apiVoxDeviceList } from "@/servers/vox/voxDevice";
  // #endif

  const { onLoad, onShow } = useMainTabLifecycle("/pages/mine/mine");

  const { loadI18n } = useI18n();
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // 登录拦截
  const { loginPopupRef, hasToken } = useAuthInterceptor();

  // 登录态
  const isLoggedIn = ref<boolean>(false);
  // 用户信息
  const userInfo = ref<UserInfo | null>(null);
  // 我的 userId 字符串（★int64 雪花号：UserInfo.id 走 number 丢精度，
  // 个人名片码须用模板串化口径——同 chat.uvue loadMyInfo）
  const myUserIdStr = ref<string>("");
  // 当前头像
  // 首次解析完成前不给 <image> src（空串）：iOS 端替换 src 会取消上一张在途请求并补发 error，
  // handleImageError 会把刚解析好的头像误判失败。详见 agent-icon。
  // 之后 tab 再进入时不要先清空：v-if 卸掉 <image> 会闪一下；原始地址未变则直接复用已展示的 src。
  const currentAvatar = ref<string>("");
  const lastRawAvatar = ref<string>("");
  // onLoad 与 tab onShow 可能连续刷新；旧头像请求不得覆盖较新的用户信息。
  let avatarResolveSeq = 0;

  const resetUserAvatar = (src : string) : void => {
    avatarResolveSeq++;
    lastRawAvatar.value = "";
    currentAvatar.value = src;
  };

  const applyUserAvatar = async (avatar : string) : Promise<void> => {
    const raw = avatar.length > 0 ? avatar : defaultAvatar;
    if (raw == lastRawAvatar.value && currentAvatar.value.length > 0) {
      return;
    }
    const seq = ++avatarResolveSeq;
    lastRawAvatar.value = raw;
    try {
      // 受保护地址（/api/f/）与远程 SVG 由 resolveDisplayImageUrl 统一处理：
      // Android / iOS 上 SVG 必须带鉴权头取文本再改尺寸生成 data URL，
      // 不能先 downloadFile 落成本地文件（否则退回原生 1:1 光栅化，头像显示异常）。
      const resolved = await resolveDisplayImageUrl(raw, 120, 120);
      if (seq != avatarResolveSeq) return;
      if (resolved == currentAvatar.value) return;
      currentAvatar.value = resolved;
    } catch (_e) {
      if (seq == avatarResolveSeq) {
        currentAvatar.value = defaultAvatar;
      }
    }
  };
  // 是否开启订阅
  const isSubscriptionEnabled = ref<boolean>(false);
  // 「关于我们」入口是否可见：服务域名可在设置页运行时切换（非响应式），
  // 因此不用 computed，每次 performLoad（onLoad / tab onShow）重算一次。
  const isAboutUsVisible = ref<boolean>(isAboutUsEntryHost());

  const appVersion = computed((): string => {
    const version = uni.getAppBaseInfo().appVersion ?? "";
    return version.trim();
  });
  const appVersionDisplay = computed((): string => {
    return appVersion.value.length > 0 ? `v${appVersion.value}` : "--";
  });

  // ================================ 终端设备列表 ================================
  // #ifndef H5 || WEB
  const terminalCount = ref<number>(0);
  const terminalCountText = computed((): string => {
    const m = new Map<string, string | number>();
    m.set("count", terminalCount.value);
    return translateFn("Mobile.Mine.terminalCount", toI18nParams(m), "");
  });
  // #endif

  // 积分概览
  const creditsSummary = ref<UTSJSONObject | null>(null);
  const purchaseModalRef = ref<any | null>(null);

  // 用户名字段（uvue 模板不支持 ?.）
  const displayName = computed((): string => {
    const u = userInfo.value;
    if (u == null) return "";
    return u.nickName.length > 0 ? u.nickName : u.userName;
  });
  const displayAccount = computed((): string => {
    const u = userInfo.value;
    if (u == null) return "";
    return u.phone.length > 0 ? u.phone : u.email;
  });

  const handleImageError = () => {
    // 尚未给出 src（解析中）时收到的 error 一定不属于当前头像，忽略
    if (currentAvatar.value.length == 0) return;
    currentAvatar.value = defaultAvatar;
  };

  // 查询当前登录用户信息
  const fetchUserInfo = async () => {
    const res = await apiUserInfo();
    if (res != null && apiResCode(res) == SUCCESS_CODE) {
      const rawData = apiResData<any>(res);
      userInfo.value = rawData != null ? new UserInfo(rawData as UTSJSONObject) : null;
      const rawObj = rawData != null ? (rawData as UTSJSONObject) : null;
      myUserIdStr.value = rawObj != null && rawObj["id"] != null ? `${rawObj["id"]}` : "";
      if (userInfo.value != null) {
        await applyUserAvatar(userInfo.value.avatar);
      } else {
        resetUserAvatar(defaultAvatar);
      }
    }
  };

  // 新用户引导弹窗（tab-shell 挂）保存成功：正停在「我的」tab 时立即刷新用户信息
  // （其余场景靠 tab onShow 自然刷新）。eventBus 回调必须单参，off 须同引用。
  const onProfileSetupCompleted = (_payload: any): void => {
    fetchUserInfo();
  };
  eventBus.on(PROFILE_SETUP_COMPLETED_EVENT, onProfileSetupCompleted);
  onUnmounted(() => {
    eventBus.off(PROFILE_SETUP_COMPLETED_EVENT, onProfileSetupCompleted);
  });

  /** 个人名片二维码：跳独立展示页（正面含 logo 码 + 翻转链接面；码内容页内重建，
   *  userName 即登录账号，同时作为码内 ?a= 预填搜索关键字）。 */
  function openMyQr(): void {    const u = userInfo.value;
    if (u == null || myUserIdStr.value.length == 0) {
      return;
    }
    uni.navigateTo({
      url:
        `/subpackages/pages/qr-show/qr-show?type=user` +
        `&name=${encodeURIComponent(displayName.value)}` +
        `&account=${encodeURIComponent(u.userName)}` +
        `&userId=${encodeURIComponent(myUserIdStr.value)}`,
    });
  }

  // Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject 或直接点方法；用 $callMethod 调 defineExpose 方法
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // #ifndef H5 || WEB
  // 点击终端设备，跳终端设备列表
  const handleMyTerminal = () => {
    uni.navigateTo({ url: "/subpackages/pages/terminal/terminal"});
  };

  const fetchTerminalCount = async () => {
    try {
      const res = await apiVoxDeviceList();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        terminalCount.value = arr.length;
      }
    } catch (_e) {
      // 静默失败，保留上次台数
    }
  };
  // #endif

  // 登录
  const handleLogin = () => {
    // #ifdef MP-WEIXIN
    callRefMethod(loginPopupRef.value, "open");
    // #endif

    // #ifdef H5 || WEB || APP
    goToLogin();
    // #endif
  };

  // 账号管理
  const handleAccountManagement = () => {
    if (isLoggedIn.value) {
      uni.navigateTo({ url: "/subpackages/pages/account-management/account-management" });
    } else {
      handleLogin();
    }
  };

  // 系统消息
  const handleSystemMessages = () => {
    if (isLoggedIn.value) {
      uni.navigateTo({ url: "/subpackages/pages/system-messages/system-messages" });
    } else {
      handleLogin();
    }
  };

  // 我的订阅
  const handleMySubscriptions = () => {
    if (isLoggedIn.value) {
      uni.navigateTo({ url: "/subpackages/pages/my-subscriptions/my-subscriptions" });
    } else {
      handleLogin();
    }
  };

  // 我的订单
  const handleMyOrders = () => {
    if (isLoggedIn.value) {
      uni.navigateTo({ url: "/subpackages/pages/my-orders/my-orders" });
    } else {
      handleLogin();
    }
  };

  // 工作商业版闸门：未授权时资料库卡整卡隐藏（performLoad 每次 onShow 同步复查，
  // 登录页/其他 Tab 刷新缓存后授权态翻转就地生效；缓存未定=放行，与伙伴页 fail-open 口径一致）
  const workRepoBlocked = ref<boolean>(false);

  // 资料库：站内 repo-web 首页，目标页需登录态——
  // 复用 _ticket 免登链路（同 conversation-search 的资料库文档跳法），在 webview 新页打开。
  const handleRepoLibrary = () => {
    if (workRepoBlocked.value) {
      uni.showToast({ title: t("Mobile.Message.workCommercialRequired"), icon: "none" });
      return;
    }
    if (!isLoggedIn.value) {
      handleLogin();
      return;
    }
    addTicketAndJumpToWebview(REPO_LIBRARY_PAGE_PATH, "inner", t("Mobile.Mine.repoLibrary"));
  };

  // 关于我们
  // 目标页是 agent.nuwax.com 上的 PageApp 发布页，本身需要登录态：
  // 复用 PageApp 的免登录链路 —— 先用本地 token 换一次性 _ticket，拼进 URL 后交给 webview 页，
  // 网页侧凭 ticket 建立会话，不会再弹登录页（App / 小程序）；H5 同源直接带 cookie。
  const handleAboutUs = () => {
    if (!isLoggedIn.value) {
      handleLogin();
      return;
    }
    // 关于我们是纯展示页，走不带分享按钮的跳转
    addTicketAndJumpToWebviewWithoutShare(ABOUT_US_PAGE_PATH, "inner", t("Mobile.Mine.helpFeedback"));
  };

  // 增购积分在当前页面弹出套餐选择面板，支付后刷新积分概览。
  // iOS 上架版无应用内购买渠道（3.1.1）：CreditsBreakdown 的入口已隐藏，这里再挡一层防误触
  const handleAddPurchase = () => {
    // #ifndef APP-IOS
    callRefMethod(purchaseModalRef.value, "open");
    // #endif
  };

  const fetchCreditsSummary = async () => {
    try {
      const res = await apiGetCreditSummary();
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        creditsSummary.value = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      }
    } catch (e) {
      // 积分接口失败时保留默认展示，不影响“我的”页其余内容。
      creditsSummary.value = null;
    }
  };

  const checkSubscriptionEnable = async () => {
    isSubscriptionEnabled.value = await checkSubscriptionEnableUtil();
  };

  // 退出登录
  // 本地优先：服务端注销只是 best-effort。当前服务域名不可达（如企业域名失效、
  // 覆盖安装保留了旧的切换域名）时接口必然失败，若只在成功时清本地态，用户会被
  // 锁死在登录态里无法回到登录页切换域名，因此无论接口结果如何都清本地态并回登录页。
  const performLogout = async () => {
    // ★ 先注销 IM 设备再调 /api/user/logout：logout 会清服务端会话（H5 即清
    //   ticket cookie），且下方「本地清 token」发生在 IM_SESSION_CLEARED 事件
    //   之前——顺序反了 DELETE devices 既没 Cookie 也没 Bearer，必然 401。
    //   此刻本地登录态未动，凭证齐全；内部已吞错，失败不阻断退出。
    await unregisterImDeviceSafe();
    try {
      await apiLogout();
    } catch (error) {
      console.error("服务端注销失败，继续本地退出:", error);
    }
    // #ifdef APP-IOS
    // 首页 Tab 上的常驻聊天 WKWebView 须先 blank/销毁，再 reLaunch；否则 iOS 下次登录开验证码 web-view 易崩
    await teardownResidentChatForLogout();
    // #endif
    uni.setStorageSync(ACCESS_TOKEN, ""); // 清空token【兼容鸿蒙系统】
    clearStoragePreservingApiBaseUrl(); // 清空业务缓存并保留企业域名
    // #ifdef MP-WEIXIN
    if (globalThis.appConfig != null) {
      globalThis.appConfig.redirectUrl = "";
    }
    // #endif
    // 获取一次语言
    loadI18n(false);
    uni.showToast({
      title: t("Mobile.Header.logoutSuccess"),
      icon: "success",
    });
    setTimeout(() => {
      // #ifdef MP-WEIXIN
      uni.reLaunch({ url: "/subpackages/pages/login-weixin/login-weixin" });
      // #endif

      // 除微信小程序外（H5 / WEB / Android / iOS / 鸿蒙）统一回普通登录页。
      // 这里用 #ifndef 而不是逐平台枚举：此前按平台枚举漏了 APP-HARMONY，
      // 鸿蒙端退出登录后没有任何分支参与编译，导致停留在原页面。
      // #ifndef MP-WEIXIN
      uni.reLaunch({ url: "/subpackages/pages/login/login" });
      // #endif
    }, 1000);
  };

  const handleLogout = () => {
    uni.showModal({
      title: t("Mobile.Common.tip"),
      content: t("Mobile.Header.logoutConfirm"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm == true) {
          performLogout();
        }
      },
    });
  };

  /** 兼容配置中被 Markdown 链接语法包裹的更新地址。 */
  const normalizeUpdateUrl = (rawUrl: string): string => {
    let url = rawUrl.trim();
    const separator = "](";
    if (url.startsWith("[") && url.endsWith(")")) {
      const separatorIndex = url.indexOf(separator);
      if (separatorIndex >= 0) {
        url = url.substring(separatorIndex + separator.length, url.length - 1).trim();
      }
    }
    return url;
  };

  const normalizedVersion = (version: string): string => {
    const value = version.trim();
    if (value.startsWith("v") || value.startsWith("V")) {
      return value.substring(1);
    }
    return value;
  };

  /** 取版本号第 index 段（从 0 起：大、中、小版本）。缺段或非数字按 0。 */
  const versionPartAt = (version: string, index: number): number => {
    const parts = version.split(".");
    if (index < 0 || index >= parts.length) {
      return 0;
    }
    const raw = parts[index];
    let value = 0;
    let seenDigit = false;
    for (let i = 0; i < raw.length; i++) {
      const codeRaw = raw.charCodeAt(i);
      if (codeRaw == null) {
        break;
      }
      const code = codeRaw as number;
      if (code < 48 || code > 57) {
        break;
      }
      seenDigit = true;
      value = value * 10 + (code - 48);
    }
    return seenDigit == true ? value : 0;
  };

  /**
   * 远端版本是否比当前版本新。
   * 从大版本号开始逐段比数字，大版本相同再比中版本，再比小版本。
   */
  const isRemoteVersionNewer = (current: string, remote: string): boolean => {
    const currentVersion = normalizedVersion(current);
    const remoteVersion = normalizedVersion(remote);
    const currentParts = currentVersion.split(".");
    const remoteParts = remoteVersion.split(".");
    const length = currentParts.length > remoteParts.length ? currentParts.length : remoteParts.length;
    for (let i = 0; i < length; i++) {
      const currentPart = versionPartAt(currentVersion, i);
      const remotePart = versionPartAt(remoteVersion, i);
      if (remotePart > currentPart) {
        return true;
      }
      if (remotePart < currentPart) {
        return false;
      }
    }
    return false;
  };

  // 隐私政策：仅 App 端入口，直接打开内置 webview 页。
  // 不走 handleExternalLink 是因为要固定标题为「隐私政策」并隐藏分享按钮，
  // 这两项都挂在 webview 页自身的路由参数上，不污染目标网页 URL。
  const handlePrivacyPolicy = () => {
    const privacyUrl = t("Mobile.Auth.privacyAgreementLink");
    if (privacyUrl.length == 0) {
      uni.showToast({ title: t("Mobile.Link.invalidConfig"), icon: "none" });
      return;
    }
    const privacyTitle = t("Mobile.Mine.privacyAgreement");
    uni.navigateTo({
      url:
        `/subpackages/pages/webview/webview?url=${encodeURIComponent(privacyUrl)}` +
        `&hideShare=1&title=${encodeURIComponent(privacyTitle)}`,
    });
  };

  // 用户协议：与隐私协议同链路（固定标题 + 隐藏分享），链接复用登录页协议勾选的地址
  const handleUserAgreement = () => {
    const agreementUrl = t("Mobile.Auth.userAgreementLink");
    if (agreementUrl.length == 0) {
      uni.showToast({ title: t("Mobile.Link.invalidConfig"), icon: "none" });
      return;
    }
    const agreementTitle = t("Mobile.Mine.userAgreement");
    uni.navigateTo({
      url:
        `/subpackages/pages/webview/webview?url=${encodeURIComponent(agreementUrl)}` +
        `&hideShare=1&title=${encodeURIComponent(agreementTitle)}`,
    });
  };

  const handleContactUs = () => {
    uni.showToast({
      title: t("Mobile.Profile.feedbackEmail"),
      icon: "none",
    });
  };

  // 检查更新
  const handleCheckUpdate = async () => {
    try {
      const response = await apiTenantConfig();
      if (apiResCode(response) != SUCCESS_CODE) {
        throw new Error();
      }
      const dataRaw = apiResData<any>(response);
      if (dataRaw == null) {
        throw new Error();
      }
      const data = dataRaw as UTSJSONObject;
      const versionConfigRaw = data["appVersionInfo"];
      // 未配置版本信息 / 无当前平台条目：视为已是最新，不走失败提示
      if (versionConfigRaw == null || typeof versionConfigRaw != "string") {
        uni.showToast({
          title: t("Mobile.Mine.alreadyLatest"),
          icon: "none",
        });
        return;
      }
      const versionConfig = JSON.parse<UTSJSONObject>(versionConfigRaw as string);
      if (versionConfig == null) {
        uni.showToast({
          title: t("Mobile.Mine.alreadyLatest"),
          icon: "none",
        });
        return;
      }

      let platformKey = "";
      // #ifdef APP-IOS
      platformKey = "ios";
      // #endif
      // #ifdef APP-ANDROID
      platformKey = "android";
      // #endif
      // #ifdef APP-HARMONY
      platformKey = "harmonyos";
      // #endif

      const platformRaw = versionConfig[platformKey];
      if (platformRaw == null) {
        uni.showToast({
          title: t("Mobile.Mine.alreadyLatest"),
          icon: "none",
        });
        return;
      }
      const platformInfo = platformRaw as UTSJSONObject;
      const latestVersionRaw = platformInfo["version"];
      const versionInfoRaw = platformInfo["versionInfo"];
      const updateUrlRaw = platformInfo["url"];
      const platformNameRaw = platformInfo["name"];
      const latestVersion = latestVersionRaw != null ? `${latestVersionRaw}`.trim() : "";
      const versionInfo = versionInfoRaw != null ? `${versionInfoRaw}`.trim() : "";
      const updateUrl = updateUrlRaw != null ? normalizeUpdateUrl(`${updateUrlRaw}`) : "";
      const platformName = platformNameRaw != null ? `${platformNameRaw}`.trim() : "";
      if (latestVersion.length == 0) {
        uni.showToast({
          title: t("Mobile.Mine.alreadyLatest"),
          icon: "none",
        });
        return;
      }

      if (isRemoteVersionNewer(appVersion.value, latestVersion) != true) {
        uni.showToast({
          title: t("Mobile.Mine.alreadyLatest"),
          icon: "none",
        });
        return;
      }
      if (!updateUrl.startsWith("https://") && !updateUrl.startsWith("http://")) {
        throw new Error();
      }

      const modalTitle = platformName.length > 0
        ? `${platformName} v${normalizedVersion(latestVersion)}`
        : `${t("Mobile.Mine.newVersion")} v${normalizedVersion(latestVersion)}`;
      const modalContent = versionInfo.length > 0 ? versionInfo : t("Mobile.Mine.newVersionAvailable");
      uni.openDialogPage({
        url: "/pages/mine/components/update-dialog/update-dialog"
          + `?title=${encodeURIComponent(modalTitle)}`
          + `&versionInfo=${encodeURIComponent(modalContent)}`
          + `&url=${encodeURIComponent(updateUrl)}`,
        animationType: "fade-in",
      });
    } catch (error) {
      console.error("检测更新失败:", error);
      uni.showToast({
        title: t("Mobile.Mine.checkUpdateFailed"),
        icon: "none",
      });
    }
  };

  // === 推送通知（业务开关，自账号管理页移入「我的-账户」，「系统消息」下方） ===
  // ★开关状态 = 业务开关本身（后端 push_enabled）：拨开即开、拨关即关。
  //   系统通知权限只在「拨到开」之后做一次提示：未开启则弹窗引导去设置，
  //   ★但开关保持打开（用户是否去开启系统权限不影响这里的业务状态）；拨关完全不读权限。
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  const pushEnabled = ref<boolean>(false);
  /** 推送身份（users/me）已就绪：未就绪时本地偏好无宿主，开关置灰不可拨。 */
  const pushReady = ref<boolean>(false);
  const pushBusy = ref<boolean>(false);
  /** 开关的显示值：乐观更新（用户拨动即变），失败时回弹到真实业务开关。 */
  const pushSwitchChecked = ref<boolean>(false);
  let pushPageActive = true;
  let pushPageStamp = "";
  /**
   * pushBusy 操作代次 + 看门狗。
   * ★踩过的坑：拨开开关时若用户跳去系统设置手动开权限，App 期间退到后台，
   *   `ensureImPushPreferenceUser` / `apiImDeviceRegister` 的请求回调可能丢失
   *   （Promise 永不 settle）→ pushBusy 卡在 true → 开关 `:disabled="pushBusy"` 永久变灰，
   *   用户只能杀 App。所以：①每次操作带代次，旧流程回来不得再写状态；②看门狗超时强制复位。
   */
  let pushBusySeq = 0;
  let pushBusyTimer = 0;
  const PUSH_BUSY_TIMEOUT_MS = 8000;

  /** 按业务开关同步开关显示值。 */
  function syncPushSwitch(): void {
    pushSwitchChecked.value = pushEnabled.value;
  }

  /** 开始一次开关操作：返回本次代次，并挂上看门狗（请求挂起时自动解灰）。 */
  function beginPushBusy(): number {
    pushBusySeq += 1;
    const seq = pushBusySeq;
    pushBusy.value = true;
    if (pushBusyTimer != 0) {
      clearTimeout(pushBusyTimer);
    }
    pushBusyTimer = setTimeout(() => {
      pushBusyTimer = 0;
      if (seq != pushBusySeq) return;
      pushBusy.value = false;
      // 挂起期间显示的乐观值可能从未落库：按真实业务开关重算
      syncPushSwitch();
    }, PUSH_BUSY_TIMEOUT_MS);
    return seq;
  }

  /** 结束一次开关操作（只有代次仍是最新的那次才生效，旧流程回来不得解掉新流程的忙碌态）。 */
  function endPushBusy(seq: number): void {
    if (seq != pushBusySeq) return;
    if (pushBusyTimer != 0) {
      clearTimeout(pushBusyTimer);
      pushBusyTimer = 0;
    }
    pushBusy.value = false;
  }

  /** 作废所有在途操作并解灰（页面重新可见时用：上一次操作可能已被系统挂起）。 */
  function abortPushBusy(): void {
    pushBusySeq += 1;
    if (pushBusyTimer != 0) {
      clearTimeout(pushBusyTimer);
      pushBusyTimer = 0;
    }
    pushBusy.value = false;
    syncPushSwitch();
  }

  function pushSettingsStamp(): string {
    return `${getImSessionStamp()}|${getApiBaseUrl()}`;
  }

  function pushCurrent(stamp: string, seq: number): boolean {
    // 代次不符 = 本次操作已被 onShow 的 abortPushBusy 作废，返回值一律丢弃
    return pushPageActive && seq == pushBusySeq && stamp == pushSettingsStamp();
  }

  /** 补推一次当前偏好（用于旧请求可能晚于新状态落到服务端的收敛，失败忽略）。
   *  ★cid 还没有时不要注册：registerImDeviceNow 在 pushToken 为空时会把 pushEnabled 写 false，
   *    等于替用户把服务端开关关掉（等 cid 到达后由推送客户端自己的注册链路补推）。 */
  async function resyncPushRegistration(): Promise<void> {
    if (getImPushCid().length == 0) return;
    try {
      await apiImDeviceRegister(getImPushCid());
    } catch (_e) {
      // 忽略：下次进页 onShow 的 refreshPushPreference 还会再注册
    }
  }

  /**
   * 进页/切回本 Tab 时校正开关。
   * ★tab 页每次显示都会走这里（比账号管理页的「进页一次」频繁得多），所以分两条路：
   *   ①身份已绑定（常态）：先用本地偏好即时点亮开关，再后台补一次设备注册——不占 pushBusy，
   *     开关不会每次切回来都短暂置灰；注册体在真正发送时才读本地偏好，与用户拨动天然收敛。
   *   ②身份未绑定（首次登录/换账号/换环境）：走完整流程（whoami 绑定 → 注册），期间置灰防并发。
   */
  async function refreshPushPreference(): Promise<void> {
    if (pushBusy.value) return;
    if (hasImPushPreferenceUser()) {
      pushReady.value = true;
      pushEnabled.value = readImPushEnabled();
      syncPushSwitch();
      resyncPushRegistration();
      return;
    }
    const stamp = pushSettingsStamp();
    const seq = beginPushBusy();
    try {
      const ready = await ensureImPushPreferenceUser();
      if (!pushCurrent(stamp, seq)) return;
      pushReady.value = ready;
      pushEnabled.value = readImPushEnabled();
      syncPushSwitch();
      if (!ready) throw new Error(t("Mobile.Error.pushIdentityUnavailable"));
      // 注册一次让服务端拿到本设备的最新偏好（失败无 UI 提示：下次 onShow 会重试）
      await apiImDeviceRegister(getImPushCid());
    } catch (_e) {
      // 忽略：开关状态保持不变
    } finally {
      endPushBusy(seq);
    }
  }

  /**
   * 拨开后检查系统通知权限：未开启就弹窗提示并引导去系统设置。
   * ★只提示，不影响开关：业务开关已经打开，用户去不去开系统权限由他自己决定。
   */
  function hintSystemNotificationIfOff(): void {
    getImNotifyPermissionState().then((state: string): void => {
      if (!pushPageActive) return;
      if (state == IM_NOTIFY_PERMISSION_GRANTED) return;
      uni.showModal({
        title: t("Mobile.Profile.systemNotificationPermission"),
        content: t("Mobile.Profile.systemNotificationDeniedTip"),
        confirmText: t("Mobile.Voice.goToSettings"),
        cancelText: t("Mobile.Common.cancel"),
        success: (res: ShowModalSuccess) => {
          if (res.confirm == true) {
            openImNotifyPermissionSettings();
          }
        },
      });
    }).catch((_e: any | null): void => {
      // 读不到权限状态就不提示，不影响业务开关
    });
  }

  /**
   * 推送通知（业务开关）：拨开即开、拨关即关。
   * ★打开后若系统通知未开启，弹一次提示引导去设置；开关本身保持打开，
   *   用户是否去开启系统权限不影响这里的业务状态。
   * ★并发控制：busy 期间开关 disabled + 入口再判 busy（互斥，杜绝并发注册乱序）；
   *   不做时间窗防抖——拨动必须即时响应，重复/连拨已被互斥挡住。
   */
  async function handlePushChange(event: any): Promise<void> {
    if (pushBusy.value || !pushReady.value) return;
    const change = event as UniSwitchChangeEvent;
    const want = change.detail.value;
    // 程序化改值（回弹）在部分平台会再冒一次 change：与当前显示值相同即视为回传，忽略
    if (want == pushSwitchChecked.value) return;
    // 乐观更新：用户拨动即改变显示值，失败时再回弹（switch 非受控回弹需要值有变化）
    pushSwitchChecked.value = want;
    const stamp = pushSettingsStamp();
    const seq = beginPushBusy();
    try {
      if (want) {
        // ★开启前必须先有推送 cid：cid 为空时设备注册会把 pushEnabled 强制置为 false
        //   （见 servers/im.uts registerImDeviceNow），服务端会继续按「关闭」过滤本设备，
        //   表现为「开关已打开但退后台收不到离线通知」。
        const cid = await ensureImPushCid();
        if (!pushCurrent(stamp, seq)) return;
        if (cid.length == 0) {
          console.error("[PushSwitch] open aborted: push cid unavailable");
          uni.showToast({ title: t("Mobile.Profile.pushTokenPending"), icon: "none" });
          // 没有 cid 就无法真正开启：回弹到真实业务开关值（保持关闭）
          syncPushSwitch();
          return;
        }
      }
      if (!writeImPushEnabled(want)) throw new Error(t("Mobile.Error.pushIdentityChanged"));
      pushEnabled.value = readImPushEnabled();
      const res = await apiImDeviceRegister(getImPushCid());
      if (!pushCurrent(stamp, seq)) {
        // 本次操作已被 onShow / 换账号作废，但请求可能后到把旧偏好写进服务端：
        // 按当前真实偏好补推一次，让服务端收敛到最新值（并发互斥之外的最后一道保险）
        resyncPushRegistration();
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) throw new Error(t("Mobile.Error.pushNotSynchronized"));
      syncPushSwitch();
      if (want) {
        uni.showToast({title:t("Mobile.Profile.pushSaved"),icon:"none"});
        // 开关已打开；若系统通知未开启，过一拍弹提示（先让 toast 露一下再弹窗）
        setTimeout((): void => {
          hintSystemNotificationIfOff();
        }, 750);
      } else {
        uni.showToast({title:t("Mobile.Profile.pushDisabledToast"),icon:"none"});
      }
    } catch (_e) {
      if (pushCurrent(stamp, seq)) {
        pushEnabled.value = readImPushEnabled();
        // 按真实业务开关回算显示：关闭失败时业务仍开着，应显示为开
        syncPushSwitch();
        uni.showToast({title:t("Mobile.Profile.pushPending"),icon:"none"});
      }
    } finally {
      endPushBusy(seq);
    }
  }

  onUnmounted(() => {
    pushPageActive = false;
    if (pushBusyTimer != 0) {
      clearTimeout(pushBusyTimer);
      pushBusyTimer = 0;
    }
  });
  // #endif

  const performLoad = async () => {
    setCurrentPageNavigationBarTitle();
    // 资料库闸门同步复查（标题链异步写缓存，本 tick 可能读到旧值，下次 onShow 就地收敛）
    workRepoBlocked.value = isWorkCommercialBlockedSync();
    checkSubscriptionEnable();
    isAboutUsVisible.value = isAboutUsEntryHost();
    const loggedIn = await hasToken();
    isLoggedIn.value = loggedIn;
    if (loggedIn) {
      fetchUserInfo();
      // #ifndef H5 || WEB
      fetchTerminalCount();
      // #endif
      fetchCreditsSummary();
      refreshSystemMessageBadge();
    } else {
      userInfo.value = null;
      myUserIdStr.value = "";
      resetUserAvatar(defaultAvatar);
      // #ifndef H5 || WEB
      terminalCount.value = 0;
      // #endif
      creditsSummary.value = null;
      refreshSystemMessageBadge();
    }
  };

  // tab 页每次显示时刷新登录态与数据
  onShow(() => {
    // 清除可能残留的 mask:true loading，避免跨 tab 吞点击（对齐 index.uvue）
    uni.hideLoading();
    // 校准原生 tabBar 显隐（自绘模式常隐 / 兜底模式恢复原生栏）
    // #ifdef APP-IOS
    // 常驻壳仍覆盖时跳过：避免兜底模式把原生栏 show 到壳上
    if (
      isResidentChatVisible() != true &&
      isResidentChatCoverActive() != true
    ) {
      syncNativeTabBarState();
    }
    // #endif
    // #ifndef APP-IOS
    syncNativeTabBarState();
    // #endif
    performLoad();
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    // 推送开关：本 Tab 每次显示都校正一次（含从系统设置/账号管理页返回）
    pushPageActive = true;
    if (pushPageStamp != pushSettingsStamp()) {
      // 账号 / 环境变了：状态清空，由下面的 abort + 重新拉取校正
      pushPageStamp = pushSettingsStamp();
      pushReady.value = false;
      pushEnabled.value = false;
    }
    // ★从系统设置 / 后台返回：上一次操作可能已被系统挂起（跳去设置期间请求回调丢失，
    //   Promise 永不 settle）→ pushBusy 卡在 true、开关 `:disabled` 变灰点不动。
    //   这里作废在途操作立即解灰，再重新核一次真实状态。
    abortPushBusy();
    refreshPushPreference();
    // #endif
  });
</script>

