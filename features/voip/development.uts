import { isVoipTestPackage } from "@/uni_modules/nuwax-voip";

/** Dedicated device packages require a native debug build AND an explicit package marker. */
export function isVoipDeviceTestPackage(): boolean {
  try { return isVoipTestPackage(); } catch (_e) { return false; }
}

export function isVoipDevelopmentBuild(): boolean {
  return process.env.NODE_ENV == "development" || isVoipDeviceTestPackage();
}
