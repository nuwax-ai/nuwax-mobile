// #ifdef APP-IOS
/**
 * iOS 原生 SVG 数学渲染后端（混编，与 Android 端 renderMathAsync 同契约）。
 *
 * 混编约定：同目录 MathSvgBridge.swift 的 public class 对 UTS 直接可见（无需 import，
 * 见 uts-plugin-hybrid 文档，同 nuwax-esp-provisioning 范式）。本文件只做 UTSJSONObject
 * 组装 + 闭包透传，重活（JSContext + MathJax + UIImage 栅格化）在 Swift 侧。
 *
 * 线程：Swift 侧在专用串行 DispatchQueue 上跑 JSContext，结果经 DispatchQueue.main.async
 * 切回主线程回调，故 UTS 侧闭包已在主线程触发（nativeSvgBackend 不需再切主线程）。
 *
 * ★ 状态：骨架已就位，待 Xcode 真机验证（bundle 路径、UIImage(data:) SVG 解析）。
 *   验证通过前 Core 仍可走 native（runtime 失败自动回退 proxyWebBackend），不影响 iOS 现状。
 */
export function renderMathAsync(
	latex: string,
	display: boolean,
	dpiScale: number,
	color: string,
	onResult: (res: UTSJSONObject) => void,
): void {
	MathSvgBridge.renderMathAsync(
		latex,
		display,
		dpiScale,
		color,
		(imageDataURL: string, width: number, height: number, svg: string, error: string): void => {
			const res = new UTSJSONObject()
			if (error.length > 0) {
				res["error"] = error
			} else {
				res["imageDataURL"] = imageDataURL
				res["width"] = width
				res["height"] = height
				res["svg"] = svg
			}
			onResult(res)
		},
	)
}
// #endif
