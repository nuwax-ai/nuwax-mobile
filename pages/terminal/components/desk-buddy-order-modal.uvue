<template>
  <view v-if="visible" class="order-modal-mask" @tap="close">
    <view class="order-modal-content" @tap.stop>
      <view class="order-modal-header">
        <text class="order-modal-title">填写收货信息</text>
        <view class="order-modal-close" @tap="close"><text class="order-modal-close-text">×</text></view>
      </view>
      <view class="order-form">
      <text class="order-form-tip">请填写收货信息，以便为您安排发货。</text>
      <view class="order-form-item">
        <text class="order-form-label"><text class="required-mark">*</text>姓名</text>
        <input class="order-form-input" v-model="receiverName" maxlength="30" placeholder="请输入收货人姓名" />
      </view>
      <view class="order-form-item">
        <text class="order-form-label"><text class="required-mark">*</text>手机号</text>
        <input class="order-form-input" v-model="receiverPhone" type="number" maxlength="11" placeholder="请输入手机号" />
      </view>
      <view class="order-form-item">
        <text class="order-form-label"><text class="required-mark">*</text>收货地址</text>
        <textarea class="order-form-textarea" v-model="receiverAddress" maxlength="200" placeholder="请输入详细收货地址" />
      </view>
      <text v-if="formError.length > 0" class="order-form-error">{{ formError }}</text>
      <view class="order-form-actions">
        <view class="order-form-btn order-form-btn-cancel" @tap="close">
          <text class="order-form-btn-cancel-text">取消</text>
        </view>
        <view :class="['order-form-btn', 'order-form-btn-confirm', submitting ? 'order-form-btn-disabled' : '']" @tap="submit">
          <text class="order-form-btn-confirm-text">{{ submitting ? "提交中..." : "提交订单" }}</text>
        </view>
      </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants.uts";
  import { apiCreateDeskBuddyOrder } from "@/subpackages/servers/subscription";
  import { getPayMode } from "@/subpackages/utils/paymentUtils";
  import { apiResCode, apiResData } from "@/utils/apiResponse";

  import { useSubscriptionPurchase } from "@/subpackages/pages/my-subscriptions/hooks/useSubscriptionPurchase";

  const visible = ref(false);
  const receiverName = ref("");
  const receiverPhone = ref("");
  const receiverAddress = ref("");
  const formError = ref("");
  const submitting = ref(false);
  const purchase = useSubscriptionPurchase(() => {});
  // 当前商品 ID（由终端产品卡 open 时传入，随下单回传）
  const goodsId = ref("");

  const open = (id: string): void => {
    goodsId.value = id;
    formError.value = "";
    visible.value = true;
  };

  const close = (): void => {
    if (submitting.value) return;
    visible.value = false;
    formError.value = "";
  };

  const allCharsAreDigits = (value: string): boolean => {
    if (value.length == 0) return false;
    for (let i = 0; i < value.length; i++) {
      const code = value.charCodeAt(i);
      if (code == null) return false;
      if (code < 48 || code > 57) return false;
    }
    return true;
  };

  const validateForm = (): boolean => {
    const name = receiverName.value.trim();
    const phone = receiverPhone.value.trim();
    const address = receiverAddress.value.trim();
    if (name.length == 0) {
      formError.value = "请输入收货人姓名";
      return false;
    }
    if (phone.length == 0) {
      formError.value = "请输入手机号";
      return false;
    }
    if (phone.length != 11 || phone.charAt(0) != "1" || !allCharsAreDigits(phone)) {
      formError.value = "请输入正确的 11 位手机号";
      return false;
    }
    if (address.length == 0) {
      formError.value = "请输入详细收货地址";
      return false;
    }
    formError.value = "";
    return true;
  };

  const readOrderId = (response: UTSJSONObject): number => {
    const data = apiResData<any>(response);
    if (data == null) return 0;
    try {
      const rawId = (data as UTSJSONObject)["id"];
      return rawId != null ? parseInt(`${rawId}`) : 0;
    } catch (_e) {
      return 0;
    }
  };

  const submit = async (): Promise<void> => {
    if (submitting.value || !validateForm()) return;
    submitting.value = true;
    try {
      const response = await apiCreateDeskBuddyOrder({
        goodsId: goodsId.value,
        name: receiverName.value.trim(),
        phone: receiverPhone.value.trim(),
        address: receiverAddress.value.trim(),
        payMode: getPayMode(),
      });
      if (apiResCode(response) != SUCCESS_CODE) {
        formError.value = "订单创建失败，请稍后重试";
        return;
      }
      const orderId = readOrderId(response);
      if (orderId <= 0) {
        formError.value = "订单创建失败，请稍后重试";
        return;
      }
      visible.value = false;
      await purchase.handlePayExistingOrder(orderId);
    } catch (_e) {
      formError.value = "订单创建失败，请检查网络后重试";
    } finally {
      submitting.value = false;
    }
  };

  defineExpose({ open: open as any, close: close as any });
</script>

<style lang="scss" scoped>
  .order-modal-mask {
    position: fixed;
    z-index: 1000;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .order-modal-content {
    width: 80%;
    background-color: #ffffff;
    border-radius: 20rpx;
    overflow: hidden;
  }

  .order-modal-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 30rpx;
    border-bottom: 2rpx solid #f0f0f0;
  }

  .order-modal-title {
    flex: 1;
    font-size: 32rpx;
    font-weight: 600;
    color: #15171f;
  }

  .order-modal-close {
    width: 48rpx;
    height: 48rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .order-modal-close-text {
    font-size: 52rpx;
    line-height: 1;
    color: #333333;
  }

  .order-form {
    display: flex;
    flex-direction: column;
    padding: 30rpx;

    .order-form-tip {
      font-size: 26rpx;
      color: #666666;
      line-height: 1.5;
      margin-bottom: 28rpx;
    }

    .order-form-item {
      display: flex;
      flex-direction: column;
      margin-bottom: 24rpx;
    }

    .order-form-label {
      font-size: 28rpx;
      font-weight: 500;
      color: #1a1a1a;
      margin-bottom: 12rpx;
    }

    .required-mark {
      color: #f53f3f;
      margin-right: 6rpx;
    }

    .order-form-input,
    .order-form-textarea {
      box-sizing: border-box;
      width: 100%;
      border: 2rpx solid #e5e6eb;
      border-radius: 12rpx;
      background-color: #f7f8fa;
      color: #1d2129;
      font-size: 28rpx;
      padding: 20rpx 24rpx;
    }

    .order-form-input {
      height: 80rpx;
    }

    .order-form-textarea {
      height: 140rpx;
      line-height: 1.4;
    }

    .order-form-error {
      color: #f53f3f;
      font-size: 24rpx;
      margin-top: -8rpx;
      margin-bottom: 16rpx;
    }

    .order-form-actions {
      display: flex;
      flex-direction: row;
      margin-top: 8rpx;
    }

    .order-form-btn {
      flex: 1;
      height: 80rpx;
      border-radius: 12rpx;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .order-form-btn-cancel {
      background-color: #f2f3f5;
      margin-right: 20rpx;
    }

    .order-form-btn-confirm {
      background-color: #5147ff;
    }

    .order-form-btn-disabled {
      opacity: 0.6;
    }

    .order-form-btn-cancel-text,
    .order-form-btn-confirm-text {
      font-size: 28rpx;
      font-weight: 600;
    }

    .order-form-btn-cancel-text {
      color: #4e5969;
    }

    .order-form-btn-confirm-text {
      color: #ffffff;
    }
  }
</style>
