import NativeAuthBridge from 'com.nuwax.nativeauth.NativeAuthBridge';

export function nativeAuthAvailable(): boolean {
  const context = UTSAndroid.getAppContext();
  return context != null && NativeAuthBridge.available(context!);
}
export function nativeAuthRandomToken(): string { return NativeAuthBridge.randomToken(); }
export function nativeAuthSha256(value: string): string { return NativeAuthBridge.sha256(value); }
export function nativeAuthRead(): string { return NativeAuthBridge.read(UTSAndroid.getAppContext()!); }
export function nativeAuthWrite(value: string): boolean { return NativeAuthBridge.write(UTSAndroid.getAppContext()!, value); }
export function nativeAuthClear(): boolean { return NativeAuthBridge.clear(UTSAndroid.getAppContext()!); }
export function nativeAuthOpen(value: string): boolean {
  const activity = UTSAndroid.getUniActivity();
  return activity != null && NativeAuthBridge.open(activity!, value);
}
export function nativeAuthCancel(requestId: string): void { /* Android 系统浏览器不能被宿主强行关闭；事务由上层作废。 */ }
export function nativeAuthTakeResult(): string { return NativeAuthBridge.takeResult(UTSAndroid.getAppContext()!); }
