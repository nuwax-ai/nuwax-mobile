/** 方向只取决于横纵位移的相对大小。 */
export function resolveHorizontalIntent(dx: number, dy: number): number {
  const x = Math.abs(dx);
  const y = Math.abs(dy);
  if (x > y) return 1;
  if (y > x) return -1;
  return 0;
}

/**
 * 仅供菜单抽屉使用；分页由原生 swiper 自己处理方向。
 * 系统容差过滤按下抖动，越过容差后按主轴分配本次触摸，锁定到松手。
 * 不按 MOVE 次数、累计路程或瞬时速度猜方向。
 */
export class HorizontalGestureIntent {
  private axis: number = 0;
  private slop: number = 0;

  begin(slop: number): void {
    this.axis = 0;
    this.slop = slop;
  }

  move(dx: number, dy: number): number {
    if (this.axis != 0) return this.axis;
    if (Math.max(Math.abs(dx), Math.abs(dy)) <= this.slop) return 0;
    this.axis = Math.abs(dx) > Math.abs(dy) ? 1 : -1;
    return this.axis;
  }
}

/**
 * 抽屉松手：速度只能帮助完成与整体位移同向的开关操作。
 * 末尾反向小回摆不改变目标，停顿时自然退回按位移判断。
 */
export function resolveDrawerOpen(offset: number, width: number, velocity: number, wasOpen: boolean): boolean {
  if (width <= 0) return wasOpen;
  const progress = Math.max(0, Math.min(1, 1 + offset / width));
  const displacement = wasOpen ? offset : offset + width;
  const aligned = displacement * velocity > 0;
  if (aligned && Math.abs(velocity) > 0.45 && Math.abs(displacement) >= width * 0.05) return velocity > 0;
  return wasOpen ? progress > 0.70 : progress >= 0.30;
}
