<template>
  <!--
    智联录 tab 列表（组件化 Stage 5 从 message-content 抽出，模板/样式原样迁移）：
    五个 section（新的伙伴申请/已申请/我的团队/我的群组/正常联系人）+ 降级页脚。
    纯展示组件——状态经 props 下发（单一事实源在页面），交互经 emit 上抛
    （守卫/判定/长按装填/导航全在页面处理器；行 id 命名 conv=convId、
    group=row-grp-、contact=ct-、space=sp-、申请行=in-/ct- 与抽离前一致）。
    - 行 class（按压闪亮/菜单高亮）改内联表达式读 props（App-Android 方法调用式
      class 绑定不保证重估，conv-list-pane 同款）
    - 手势链冒泡序保持：行 touchstart → scroll-view（pane-touch*）→ 页面根
    - ★行测量协议：measureRow(domId) 组件作用域自测（$callMethod 调起），矩形
      原始数字经 row-rect 上抛（conv-list-pane / im-header-tabs 同机制）
  -->
  <!-- #ifdef APP-HARMONY -->
  <!-- 鸿蒙圆点画在 scroll-view 外（原生插槽动态样式不跟手）。 -->
  <view class="im-pane-wrap">
  <!-- #endif -->
  <scroll-view
    v-if="scrollAlive"
    class="im-pane"
    :key="scrollViewKey"
    :direction="menuVisible ? 'none' : 'vertical'"
    :show-scrollbar="false"
    :refresher-enabled="pullEntryEnabled"
    :refresher-triggered="pullTriggered"
    :refresher-threshold="pullNativeThreshold"
    :refresher-max-drag-distance="pullMaxDragDistance"
    refresher-default-style="none"
    refresher-background="#f4f3fb"
    @scroll="emitScroll"
    @refresherpulling="handlePulling($event)"
    @refresherrefresh="emitPullRefresh"
    @refresherrestore="emitPullRestore"
    @refresherabort="emitPullAbort"
    @touchstart="emitPaneTouchStart($event)"
    @touchend="emitPaneTouchEnd($event)"
    @touchcancel="emitPaneTouchCancel($event)"
  >
    <!-- 新的伙伴入口行（PC DEV-413 对齐，微信「新的朋友」入口）：智联录最顶行，
         恒渲染——入口是导航不是数据，零记录的新用户也要能找到这一层（同「我的团队」
         入口行判据，与「我的群组」有群才显示相反）；角标只数待我处理的申请
         （pendingIn，status=2）且 >0 才显示——「0」角标会像有事要处理 -->
    <view
      class="group-header"
      :class="[pressedRowId == 'np-head' ? 'group-header--active' : '']"
      @click="emitNewPartnerClick"
      @touchstart="emitRowTouchStart('np-head', $event)"
      @touchmove="emitRowTouchMove($event)"
      @touchend="emitNewPartnerTouchEnd($event)"
      @touchcancel="emitRowTouchCancel"
    >
      <image class="group-header__icon" :src="iconNewPartner" mode="aspectFit" />
      <text class="group-header__title">{{ t("Mobile.Message.newPartnerEntry") }}</text>
      <view v-if="pendingIn.length > 0" class="np-entry-badge">
        <text class="np-entry-badge__text">{{ pendingIn.length }}</text>
      </view>
      <view class="group-header__spacer" />
      <svg-icon
        name="icon-a-Chevronright"
        size="16" unit="px"
        color="#c0bec8"
      />
    </view>

    <view v-if="loading && contactTotal == 0" class="im-state">
      <text class="im-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
    </view>
    <view
      v-else-if="contactTotal == 0"
      class="im-state"
      @click="emitRetry"
    >
      <text class="im-state__text">{{
        failed ? t("Mobile.Message.loadFailed") : t("Mobile.Message.emptyContact")
      }}</text>
    </view>
    <template v-else>
      <!-- 新的伙伴申请：对方申请了我，等我同意 -->
      <view v-if="pendingIn.length > 0" class="contact-group">
        <text class="contact-group__title">{{ t("Mobile.Message.newRequests") }}</text>
        <view v-for="(contact, index) in pendingIn" :key="'in-' + contact.userId">
          <view
            class="chat-item"
            :class="[pressedRowId == 'in-' + contact.userId ? 'chat-item--active' : '']"
            @click="emitPendingInClick(contact)"
            @touchstart="emitRowTouchStart('in-' + contact.userId, $event)"
            @touchmove="emitRowTouchMove($event)"
            @touchend="emitPendingInTouchEnd(contact, $event)"
            @touchcancel="emitRowTouchCancel"
          >
            <view class="chat-item__avatar-wrap" :style="avatarBoxStyle">
              <view
                v-if="contact.avatarLoaded != true || contact.avatarFailed == true"
                class="chat-item__avatar"
                :style="{ backgroundImage: avatarGradient(contact.displayName) }"
              >
                <view class="chat-item__avatar-fallback">
                  <text class="chat-item__avatar-fallback-text">{{ contact.fallbackLine1 }}</text>
                </view>
              </view>
              <view
                v-if="contact.avatarDisplay.length > 0 && contact.avatarFailed != true"
                class="chat-item__avatar-clip"
              >
                <image
                  class="chat-item__avatar chat-item__avatar--img"
                  :src="contact.avatarDisplay"
                  mode="aspectFill"
                  :fade-show="false"
                  @load="emitContactAvatarLoaded(contact)"
                  @error="emitContactAvatarError(contact)"
                />
              </view>
            </view>
            <view class="chat-item__body">
              <view class="chat-item__title-row">
                <text class="chat-item__title text-ellipsis">{{ contact.displayName }}</text>
                <view class="contact-tag contact-tag--warn">
                  <text class="contact-tag__text contact-tag__text--warn">{{ t("Mobile.Message.statusWaitConfirm") }}</text>
                </view>
              </view>
              <!-- 申请理由单行预览（空则不渲染，行高与无理由行一致；全文见点按后的详情卡片） -->
              <text
                v-if="contact.applyMsg.length > 0"
                class="group-row__count text-ellipsis"
              >{{ contact.applyMsg }}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 已申请：我申请了对方，等对方同意 -->
      <view v-if="pendingOut.length > 0" class="contact-group">
        <text class="contact-group__title">{{ t("Mobile.Message.sentRequests") }}</text>
        <view v-for="(contact, index) in pendingOut" :key="'out-' + contact.userId">
          <!-- 行内容（长按弹操作气泡）：撤回申请（无确认，直接调接口） -->
          <view
            :id="'row-ct-' + contact.userId"
            class="chat-item"
            :class="[
              pressedRowId == 'ct-' + contact.userId ? 'chat-item--active' : '',
              menuVisible && menuRowId == 'ct-' + contact.userId ? 'chat-item--menu-on' : '',
            ]"
            @click="emitPendingOutClick(contact)"
            @touchstart="emitContactTouchStart(contact, $event)"
            @touchmove="emitRowTouchMove($event)"
            @touchend="emitPendingOutTouchEnd(contact, $event)"
            @touchcancel="emitRowTouchCancel"
          >
            <view class="chat-item__avatar-wrap" :style="avatarBoxStyle">
              <view
                v-if="contact.avatarLoaded != true || contact.avatarFailed == true"
                class="chat-item__avatar"
                :style="{ backgroundImage: avatarGradient(contact.displayName) }"
              >
                <view class="chat-item__avatar-fallback">
                  <text class="chat-item__avatar-fallback-text">{{ contact.fallbackLine1 }}</text>
                </view>
              </view>
              <view
                v-if="contact.avatarDisplay.length > 0 && contact.avatarFailed != true"
                class="chat-item__avatar-clip"
              >
                <image
                  class="chat-item__avatar chat-item__avatar--img"
                  :src="contact.avatarDisplay"
                  mode="aspectFill"
                  :fade-show="false"
                  @load="emitContactAvatarLoaded(contact)"
                  @error="emitContactAvatarError(contact)"
                />
              </view>
            </view>
            <view class="chat-item__body">
              <view class="chat-item__title-row">
                <text class="chat-item__title text-ellipsis">{{ contact.displayName }}</text>
                <view class="contact-tag contact-tag--muted">
                  <text class="contact-tag__text contact-tag__text--muted">{{ t("Mobile.Message.statusWaitAccept") }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 我的团队：折叠分类（spaces），点行 enter 团队对话；置于我的群组上方 -->
      <view v-if="spacesLoaded && spaceTotal > 0" class="contact-group">
        <view
          class="group-header"
          :class="[pressedRowId == 'sp-head' ? 'group-header--active' : '']"
          @click="emitSpacesHeadClick"
          @touchstart="emitRowTouchStart('sp-head', $event)"
          @touchmove="emitRowTouchMove($event)"
          @touchend="emitSpacesHeadTouchEnd($event)"
          @touchcancel="emitRowTouchCancel"
        >
          <image class="group-header__icon" :src="iconGroupSet" mode="aspectFit" />
          <text class="group-header__title">{{ t("Mobile.Message.myTeams") }}</text>
          <text class="group-header__count">{{ spaceTotal }}</text>
          <view class="group-header__spacer" />
          <svg-icon
            :name="spacesExpanded ? 'icon-a-Chevrondown' : 'icon-a-Chevronright'"
            size="16" unit="px"
            color="#c0bec8"
          />
        </view>
        <view v-if="spacesExpanded">
          <view v-for="(space, index) in spaces" :key="'sp-' + space.spaceId">
            <!-- 布局同我的群组行：icon/名称/角色徽章 + 描述（无左滑操作） -->
            <view
              class="chat-item"
              :class="[pressedRowId == 'sp-' + space.spaceId ? 'chat-item--active' : '']"
              @click="emitSpaceRowClick(space)"
              @touchstart="emitRowTouchStart('sp-' + space.spaceId, $event)"
              @touchmove="emitRowTouchMove($event)"
              @touchend="emitSpaceRowTouchEnd(space, $event)"
              @touchcancel="emitRowTouchCancel"
            >
              <view class="chat-item__avatar-wrap" :style="avatarBoxStyle">
                <view
                  v-if="space.iconLoaded != true || space.iconFailed == true"
                  :class="space.fallbackMerged ? 'chat-item__avatar chat-item__avatar--solid' : 'chat-item__avatar'"
                  :style="{ backgroundImage: space.fallbackMerged ? 'none' : avatarGradient(space.name) }"
                >
                  <image
                    v-if="space.fallbackMerged"
                    class="chat-item__avatar-glyph"
                    :src="avatarDefaultGroup"
                    mode="aspectFit"
                  />
                  <view v-else class="chat-item__avatar-fallback">
                    <text :class="space.fallbackLine2.length > 0 ? 'chat-item__avatar-fallback-text chat-item__avatar-fallback-text--sm' : 'chat-item__avatar-fallback-text'">{{ space.fallbackLine1 }}</text>
                    <text v-if="space.fallbackLine2.length > 0" class="chat-item__avatar-fallback-text chat-item__avatar-fallback-text--sm">{{ space.fallbackLine2 }}</text>
                  </view>
                </view>
                <view
                  v-if="space.iconDisplay.length > 0 && space.iconFailed != true"
                  class="chat-item__avatar-clip"
                >
                  <image
                    class="chat-item__avatar chat-item__avatar--img"
                    :src="space.iconDisplay"
                    mode="aspectFill"
                    :fade-show="false"
                    @load="emitSpaceIconLoaded(space)"
                    @error="emitSpaceIconError(space)"
                  />
                </view>
              </view>
              <view class="chat-item__body">
                <view class="chat-item__title-row">
                  <text class="chat-item__title text-ellipsis">{{ space.name }}</text>
                  <view :class="spaceRoleTagClass(space)">
                    <text :class="spaceRoleTextClass(space)">{{ spaceRoleText(space) }}</text>
                  </view>
                </view>
                <text v-if="space.description.length > 0" class="group-row__count text-ellipsis">
                  {{ space.description }}
                </text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 我的群组：折叠分类（含已从会话列表删除但仍在群内的群），点行进群聊；置于联系人上方 -->
      <view v-if="groupsLoaded && groupTotal > 0" class="contact-group">
        <view
          class="group-header"
          :class="[pressedRowId == 'grp-head' ? 'group-header--active' : '']"
          @click="emitGroupsHeadClick"
          @touchstart="emitRowTouchStart('grp-head', $event)"
          @touchmove="emitRowTouchMove($event)"
          @touchend="emitGroupsHeadTouchEnd($event)"
          @touchcancel="emitRowTouchCancel"
        >
          <image class="group-header__icon" :src="iconGroupSet" mode="aspectFit" />
          <text class="group-header__title">{{ t("Mobile.Message.myGroups") }}</text>
          <text class="group-header__count">{{ groupTotal }}</text>
          <view class="group-header__spacer" />
          <svg-icon
            :name="groupsExpanded ? 'icon-a-Chevrondown' : 'icon-a-Chevronright'"
            size="16" unit="px"
            color="#c0bec8"
          />
        </view>
        <view v-if="groupsExpanded">
          <view v-for="(group, index) in groups" :key="'grp-' + group.convId">
            <!-- 行内容（长按弹操作气泡）：打开会话 / 解散群聊（群主）/ 退出群聊（非群主） -->
            <view
              :id="'row-grp-' + group.convId"
              class="chat-item"
              :class="[
                pressedRowId == group.convId ? 'chat-item--active' : '',
                menuVisible && menuRowId == group.convId ? 'chat-item--menu-on' : '',
              ]"
              @click="emitGroupRowClick(group)"
              @touchstart="emitGroupTouchStart(group, $event)"
              @touchmove="emitRowTouchMove($event)"
              @touchend="emitGroupRowTouchEnd(group, $event)"
              @touchcancel="emitRowTouchCancel"
            >
              <view class="chat-item__avatar-wrap" :style="avatarBoxStyle">
                <view
                  v-if="group.avatarLoaded != true || group.avatarFailed == true"
                  :class="group.fallbackMerged ? 'chat-item__avatar chat-item__avatar--solid' : 'chat-item__avatar'"
                  :style="{ backgroundImage: group.fallbackMerged ? 'none' : avatarGradient(group.displayName) }"
                >
                  <image
                    v-if="group.fallbackMerged"
                    class="chat-item__avatar-glyph"
                    :src="avatarDefaultGroup"
                    mode="aspectFit"
                  />
                  <view v-else class="chat-item__avatar-fallback">
                    <text :class="group.fallbackLine2.length > 0 ? 'chat-item__avatar-fallback-text chat-item__avatar-fallback-text--sm' : 'chat-item__avatar-fallback-text'">{{ group.fallbackLine1 }}</text>
                    <text v-if="group.fallbackLine2.length > 0" class="chat-item__avatar-fallback-text chat-item__avatar-fallback-text--sm">{{ group.fallbackLine2 }}</text>
                  </view>
                </view>
                <view
                  v-if="group.avatarDisplay.length > 0 && group.avatarFailed != true"
                  class="chat-item__avatar-clip"
                >
                  <image
                    class="chat-item__avatar chat-item__avatar--img"
                    :src="group.avatarDisplay"
                    mode="aspectFill"
                    :fade-show="false"
                    @load="emitConvAvatarLoaded(group)"
                    @error="emitConvAvatarError(group)"
                  />
                </view>
              </view>
              <view class="chat-item__body">
                <view class="chat-item__title-row">
                  <text class="chat-item__title text-ellipsis">{{ displayConvName(group) }}</text>
                  <view v-if="group.myRole == 3" class="contact-tag contact-tag--owner">
                    <text class="contact-tag__text contact-tag__text--owner">{{ t("Mobile.Message.groupOwner") }}</text>
                  </view>
                  <text class="chat-item__time">{{ formatConvTime(group.lastMsgAt) }}</text>
                </view>
                <text class="group-row__count">{{ groupMemberLabel(group) }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 正常联系人：智能体（原「专家」标签）/ 用户 -->
      <view v-if="contacts.length > 0" class="contact-group">
        <text class="contact-group__title">{{ t("Mobile.Message.contactsTitle") }}</text>
        <view v-for="(contact, index) in contacts" :key="'ok-' + contact.userId">
          <!-- 行内容（长按弹操作气泡）：发消息 / 修改备注 / 删除联系人 -->
          <view
            :id="'row-ct-' + contact.userId"
            class="chat-item"
            :class="[
              pressedRowId == 'ct-' + contact.userId ? 'chat-item--active' : '',
              menuVisible && menuRowId == 'ct-' + contact.userId ? 'chat-item--menu-on' : '',
            ]"
            @click="emitContactRowClick(contact)"
            @touchstart="emitContactTouchStart(contact, $event)"
            @touchmove="emitRowTouchMove($event)"
            @touchend="emitContactRowTouchEnd(contact, $event)"
            @touchcancel="emitRowTouchCancel"
          >
            <view class="chat-item__avatar-wrap" :style="avatarBoxStyle">
              <view
                v-if="contact.avatarLoaded != true || contact.avatarFailed == true"
                class="chat-item__avatar"
                :style="{ backgroundImage: avatarGradient(contact.displayName) }"
              >
                <view class="chat-item__avatar-fallback">
                  <text class="chat-item__avatar-fallback-text">{{ contact.fallbackLine1 }}</text>
                </view>
              </view>
              <view
                v-if="contact.avatarDisplay.length > 0 && contact.avatarFailed != true"
                class="chat-item__avatar-clip"
              >
                <image
                  class="chat-item__avatar chat-item__avatar--img"
                  :src="contact.avatarDisplay"
                  mode="aspectFill"
                  :fade-show="false"
                  @load="emitContactAvatarLoaded(contact)"
                  @error="emitContactAvatarError(contact)"
                />
              </view>
            </view>
            <view class="chat-item__body">
              <view class="chat-item__title-row">
                <text class="chat-item__title text-ellipsis">{{ contact.displayName }}</text>
                <view
                  class="contact-tag"
                  :class="isExpertContact(contact) ? 'contact-tag--expert' : 'contact-tag--user'"
                >
                  <text
                    class="contact-tag__text"
                    :class="isExpertContact(contact) ? 'contact-tag__text--expert' : 'contact-tag__text--user'"
                  >{{
                    isExpertContact(contact)
                      ? t("Mobile.Message.contactExpert")
                      : t("Mobile.Message.contactUser")
                  }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 降级 / 截断提示（语义不同：缺人 vs 截断，都要读） -->
      <view v-if="degraded || truncated" class="im-foot">
        <text class="im-foot__text">{{
          degraded
            ? t("Mobile.Message.contactDegraded")
            : t("Mobile.Message.contactTruncated")
        }}</text>
      </view>
    </template>
    <!-- 原生节点直接作为 refresher 插槽（置末位：App 端 refresher 取末个 slot 内容）。
         Android/iOS 的插槽按 PULL_ENTRY_SLOT_HEIGHT 开高、露出多少看多少，圆点就在这里随位移上浮；
         鸿蒙插槽只当「浅灰底 + 占位」用（不画圆点，插槽内的动态样式不跟手），
         圆点改画在下面列表外的覆盖层里。 -->
    <view slot="refresher" class="pull-guide" :style="pullGuideRootStyle">
      <!-- #ifndef APP-HARMONY -->
      <view class="pull-guide__dots" :style="pullGuideDotsStyle">
        <view class="pull-guide__dot pull-guide__dot--left" :style="pullGuideLeftDotStyle"></view>
        <view class="pull-guide__dot pull-guide__dot--center" :style="pullGuideCenterDotStyle"></view>
        <view class="pull-guide__dot pull-guide__dot--right" :style="pullGuideRightDotStyle"></view>
      </view>
      <!-- #endif -->
    </view>
  </scroll-view>
  <!-- #ifdef APP-HARMONY -->
  <!-- 下拉圆点覆盖层：贴 pane 顶，高度 = 原生下拉位移 dy（=列表被推下来的那段空白），
       圆点在该层内 flex 居中 → 全程恒在下拉区域的垂直中心（与原生刷新控件内部怎么排版无关）。
       纯展示层，pointer-events:none 不抢列表手势。 -->
  <view class="pull-dot-layer" :style="pullDotLayerStyle">
    <view class="pull-guide__dots" :style="pullGuideDotsStyle">
      <view class="pull-guide__dot pull-guide__dot--left" :style="pullGuideLeftDotStyle"></view>
      <view class="pull-guide__dot pull-guide__dot--center" :style="pullGuideCenterDotStyle"></view>
      <view class="pull-guide__dot pull-guide__dot--right" :style="pullGuideRightDotStyle"></view>
    </view>
  </view>
  <!-- #endif -->
  <!-- #ifdef APP-HARMONY -->
  </view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { computed, getCurrentInstance, nextTick, ref, watch } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import iconGroupSet from "@/static/icons/group_set.png";
  import iconNewPartner from "@/static/icons/new_partner.svg";
  import avatarDefaultGroup from "@/static/images/avatar-default-group.png";
  import { ImContactRow, ImConvRow, ImSpaceRow } from "./im-row-models.uts";
  import {
    avatarBoxStyle as avatarBoxStyleOf,
    avatarGradient as avatarGradientOf,
    displayConvName as displayConvNameOf,
    formatConvTime as formatConvTimeOf,
    groupMemberLabel as groupMemberLabelOf,
    isExpertContact as isExpertContactOf,
    spaceRoleTagClass as spaceRoleTagClassOf,
    spaceRoleText as spaceRoleTextOf,
    spaceRoleTextClass as spaceRoleTextClassOf,
  } from "./im-row-helpers.uts";

  // 事件名须 kebab-case：App-Android 模板监听会把 camelCase 转小写导致收不到（add-menu-drawer 同规约）
  const emit = defineEmits<{
    /** 空态点击重试（页面 handleContactRetry）。 */
    retry: [];
    /** 列表滚动（页面 handleListScroll）。 */
    scroll: [];
    /** 下拉进入默认智能体会话：拉到位松手触发 refresherrefresh（页面当帧跳转）；
     *  restore/abort = 没拉到位就松手回弹 / 手势被打断（页面收提示条，什么都不做）。 */
    "pull-refresh": [];
    "pull-restore": [];
    "pull-abort": [];
    /** scroll-view 层页面触摸三件套（冒泡到页面根之前先到这，40ms 去重语义在页面）。 */
    "pane-touchstart": [e: UniTouchEvent];
    "pane-touchend": [e: UniTouchEvent];
    "pane-touchcancel": [e: UniTouchEvent];
    /** 通用行 touchstart（无长按语义的行：申请行 in-/团队行 sp-/折叠头 sp-head/grp-head；
        页面 handleRowTouchStart(rowId, e)）。 */
    "row-touchstart": [rowId: string, e: UniTouchEvent];
    /** 联系人行 touchstart（页面 handleContactRowTouchStart：公共判定+装填长按）。 */
    "contact-touchstart": [contact: ImContactRow, e: UniTouchEvent];
    /** 群组行 touchstart（页面 handleGroupRowTouchStart：公共判定+装填长按）。 */
    "group-touchstart": [group: ImConvRow, e: UniTouchEvent];
    /** 行 touchmove/touchcancel 公共（页面 handleRowTouchMove/handleRowTouchCancel）。 */
    "row-touchmove": [e: UniTouchEvent];
    "row-touchcancel": [];
    /** 新的伙伴申请行点按（页面 handlePendingInRowClick/TouchEnd：弹申请详情卡片）。 */
    "pending-in-click": [contact: ImContactRow];
    "pending-in-touchend": [contact: ImContactRow, e: UniTouchEvent];
    /** 已申请行点按（页面 handlePendingOutRowClick/TouchEnd：仅提示等待）。 */
    "pending-out-click": [contact: ImContactRow];
    "pending-out-touchend": [contact: ImContactRow, e: UniTouchEvent];
    /** 「新的伙伴」入口行点按（页面 handleNewPartnerRowClick/TouchEnd：进记录页）。 */
    "new-partner-click": [];
    "new-partner-touchend": [e: UniTouchEvent];
    /** 我的团队折叠头点按（页面 handleSpacesHeadClick/TouchEnd：展开/折叠）。 */
    "spaces-head-click": [];
    "spaces-head-touchend": [e: UniTouchEvent];
    /** 团队行点按（页面 handleSpaceRowClick/TouchEnd：进团队对话）。 */
    "space-row-click": [space: ImSpaceRow];
    "space-row-touchend": [space: ImSpaceRow, e: UniTouchEvent];
    /** 我的群组折叠头点按（页面 handleGroupsHeadClick/TouchEnd：展开/折叠）。 */
    "groups-head-click": [];
    "groups-head-touchend": [e: UniTouchEvent];
    /** 群组行点按（页面 handleConvRowClick/handleConvRowTouchEnd：进群聊）。 */
    "group-row-click": [group: ImConvRow];
    "group-row-touchend": [group: ImConvRow, e: UniTouchEvent];
    /** 正常联系人行点按（页面 handleContactRowClick/TouchEnd：发消息）。 */
    "contact-row-click": [contact: ImContactRow];
    "contact-row-touchend": [contact: ImContactRow, e: UniTouchEvent];
    /** 头像/icon @load/@error（页面记缓存+整表重建；群组行复用 conv 语义）。 */
    "contact-avatar-loaded": [contact: ImContactRow];
    "contact-avatar-error": [contact: ImContactRow];
    "conv-avatar-loaded": [conv: ImConvRow];
    "conv-avatar-error": [conv: ImConvRow];
    "space-icon-loaded": [space: ImSpaceRow];
    "space-icon-error": [space: ImSpaceRow];
    /** 行矩形测量结果（视口 px 原始数字；页面拼长按浮层气泡/蒙层）。 */
    "row-rect": [top: number, bottom: number, left: number];
  }>();

  const props = withDefaults(
    defineProps<{
      /** 新的伙伴申请行（对方申请了我）。 */
      pendingIn: ImContactRow[];
      /** 已申请行（我申请了对方）。 */
      pendingOut: ImContactRow[];
      /** 我的团队行。 */
      spaces: ImSpaceRow[];
      /** 我的群组行。 */
      groups: ImConvRow[];
      /** 正常联系人行。 */
      contacts: ImContactRow[];
      /** 联系人总数（含各分区，空表判定用）。 */
      contactTotal: number;
      spaceTotal: number;
      groupTotal: number;
      /** 首次加载中/失败（空表态文案）。 */
      loading: boolean;
      failed: boolean;
      /** 团队/群组分区已加载（折叠头显隐）。 */
      spacesLoaded: boolean;
      groupsLoaded: boolean;
      /** 团队/群组分区展开态。 */
      spacesExpanded: boolean;
      groupsExpanded: boolean;
      /** 降级/截断页脚（语义不同都要读）。 */
      degraded: boolean;
      truncated: boolean;
      /** 长按浮层展开（锁滚动+行高亮判定）。 */
      menuVisible: boolean;
      /** 长按浮层指向行 id（contact=ct-userId、group=convId）。 */
      menuRowId: string;
      /** 按压闪亮行 id（300ms 闪灰）。 */
      pressedRowId: string;
      /** 下拉进入默认智能体：是否启用原生下拉（租户未配置默认智能体时为 false）。
       *  ★同时用作 scroll-view 的 :key：false→true 时重建滚动容器——Android 端挂载后
       *   再改 refresher-enabled 不会重新装配下拉控件（官方示例也用静态 true）。 */
      pullEntryEnabled: boolean;
      /** 原生下拉刷新处于「已触发」态（页面持有，导航/失败后复位收回）。 */
      pullTriggered: boolean;
      /** 下拉触发距离 px（原生 refresher-threshold；圆点形态进度也按它归一 = 三点完整即触发）。 */
      pullThreshold: number;
      /** 最大拖拽距离 px（= 还能拉多远；Android 因原生拖拽阻尼被放大，见页面常量注释）。 */
      pullMaxDragDistance: number;
      /** refresher 插槽（原生 header）高度 px：原生按它算触发率、松手也停靠到它。 */
      pullSlotHeight: number;
      /** 列表重建令牌：变化=重建 scroll-view（把原生下拉态强制归位）。
       *  下拉跳转时回弹还没走完才用（跳转打断收回动画，见 message-content onShow）。 */
      pullResetToken: number;
    }>(),
    {
      pendingIn: [] as ImContactRow[],
      pendingOut: [] as ImContactRow[],
      spaces: [] as ImSpaceRow[],
      groups: [] as ImConvRow[],
      contacts: [] as ImContactRow[],
      contactTotal: 0,
      spaceTotal: 0,
      groupTotal: 0,
      loading: false,
      failed: false,
      spacesLoaded: false,
      groupsLoaded: false,
      spacesExpanded: false,
      groupsExpanded: false,
      degraded: false,
      truncated: false,
      menuVisible: false,
      menuRowId: "",
      pressedRowId: "",
      pullEntryEnabled: false,
      pullTriggered: false,
      pullThreshold: 54,
      pullMaxDragDistance: 60,
      pullSlotHeight: 60,
      pullResetToken: 0,
    },
  );

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ★uvue 模板不能直接调用导入函数（invoke 解析失败）——本地 const 包装（Stage 1 同款）
  const avatarBoxStyle = avatarBoxStyleOf;
  const avatarGradient = (name: string): string => avatarGradientOf(name);
  const displayConvName = (conv: ImConvRow): string => displayConvNameOf(conv);
  const formatConvTime = (ts: number): string => formatConvTimeOf(ts);
  const groupMemberLabel = (conv: ImConvRow): string => groupMemberLabelOf(conv);
  const isExpertContact = (contact: ImContactRow): boolean => isExpertContactOf(contact);
  const spaceRoleTagClass = (space: ImSpaceRow): string => spaceRoleTagClassOf(space);
  const spaceRoleText = (space: ImSpaceRow): string => spaceRoleTextOf(space);
  const spaceRoleTextClass = (space: ImSpaceRow): string => spaceRoleTextClassOf(space);

  const componentInstance = getCurrentInstance();
  /** scroll-view 的 key：enabled 翻转要重建（见 pullEntryEnabled 注释）。
   *  回页强制归位走上面的 v-if（见 scrollAlive），不叠在这把 key 上，免一次翻两遍容器。 */
  const scrollViewKey = computed((): string => {
    const base = props.pullEntryEnabled ? "pull-on" : "pull-off";
    // #ifdef APP-ANDROID
    // Android 必须让 reset token 进入原生节点 key：仅 v-if 在页面隐藏/返回交界处
    // 可能复用旧 SmartRefreshLayout，残留位移会和下一轮下拉叠加。
    return `${base}-${props.pullResetToken}`;
    // #endif
    // #ifndef APP-ANDROID
    return base;
    // #endif
  });
  /** 滚动容器是否挂着：下拉跳转打断原生收回动画后，靠 v-if 卸掉再挂回来强制归位
   *  （原生下拉态只有重建容器能确定复位；单改 :key 在 App 端不一定真的重建）。
   *  只在翻 pullResetToken 时短暂置 false 一帧：正常路径是跳转后页面已被会话页盖住时翻
   *  （隐藏期重建，回页看不见），回页 onShow 只为兜底。 */
  const scrollAlive = ref<boolean>(true);
  const pullGuideDistance = ref<number>(0);
  /** 回弹/收回动画期间原生还会继续派 refresherpulling（位移一路减小），若继续写响应式，
   *  列表外壳就在动画里逐帧重渲染 → 肉眼可见的回弹抖动（不如手指滑动丝滑）。
   *  松手（refresh/abort/restore）后冻结，下一次触摸按下再解冻。 */
  let pullGuideFrozen = false;
  /** 手指是否正按在列表上：上一轮的收回动画收尾（refresherrestore）可能正好落在
   *  新一轮下拉中间，那时不能清位移/冻结，否则圆点会突然消失。 */
  let pullGuideDragging = false;
  /** 本轮手势是否已经在 touchend / 原生 refresher 事件里判定过触发。
   *  Android/iOS 统一由 touchend 当帧判定，避免等待原生 refresh 停靠动画；
   *  Harmony 仍保留原生 refresherrefresh 通道，三端共用这个防重位。 */
  let pullReleaseFired = false;
  /** 重建滚动容器时把下拉位移一并清零：跳转打断收回的话 refresherrestore 不会来，
   *  pullGuideDistance 会停在松手时的值，重建后圆点按旧位移显示。 */
  watch((): number => props.pullResetToken, (_token: number): void => {
    pullGuideDistance.value = 0;
    pullGuideFrozen = false;
    // #ifdef APP-IOS
    // iOS 只清下拉展示状态，不卸载 scroll-view。该节点位于原生 swiper-item 内，
    // 多次下拉进会话再返回时反复 v-if 卸挂，会让 swiper 的横向 transform 累积异常，
    // 最终整页向左偏移、右侧露出空白。
    return;
    // #endif
    scrollAlive.value = false;
    nextTick((): void => {
      scrollAlive.value = true;
    });
  });
  /** Android/iOS 不让原生进入 refresh 停靠态：原生阈值放到最大拖距之外，
   *  是否达到入口线由 touchend 使用 pullThreshold 自己判定。这样松手后不会先向下
   *  补到 header 高度再跳页。Harmony 保留原生阈值与原生刷新事件。 */
  const pullNativeThreshold = computed((): number => {
    // #ifdef APP-HARMONY
    return props.pullThreshold;
    // #endif
    // #ifndef APP-HARMONY
    return props.pullMaxDragDistance + 1;
    // #endif
  });
  /** 形态进度按**触发距离**（pullThreshold）归一：走到触发线恰好三圆点完全展开。
   *  ★必须与原生触发线对齐——用户看到三点完整，就是「松手必跳」的那一刻；
   *    按 maxDrag（还能拉多远）归一会让圆点先展开、触发线还在后面（旧版实坑）。
   *  ★Android 的最大拖拽距离被放大到 300（原生拖拽有阻尼，见 message-content 常量），
   *    更不能按它归一：触发线只占行程的 18%，圆点会几乎不动。 */
  const pullGuideProgress = computed((): number => {
    const extent = Math.max(1, props.pullThreshold);
    return Math.max(0, Math.min(pullGuideDistance.value / extent, 1));
  });
  /** 展开进度：走到触发线的 55% 就开始分叉，到 100%（= 触发线）完全展开成三个。
   *  ★起分点尽量早（54px 行程下 = 30px 起分、54px 收口）→ 三个点出现得干脆。 */
  const pullGuideMorphProgress = computed((): number => Math.max(0, Math.min((pullGuideProgress.value - 0.55) / 0.45, 1)));
  /** 淡入：进度 0.35 露头、0.60 全显（≈ 触发线的 19px / 32px，与旧的绝对像素口径一致）。 */
  const pullGuideOpacity = computed((): number => Math.max(0, Math.min((pullGuideProgress.value - 0.35) / 0.25, 1)));
  /** refresher 插槽高度（= 原生 header 高，原生按它算触发率、松手也停靠到它）。
   *  Android/iOS 取 pullSlotHeight（页面常量 60，比 Android 的最大拖拽距离小得多，见
   *  message-content）；鸿蒙插槽只当浅灰底与占位用（圆点画在列表外的覆盖层），
   *  按 runtime 给的窗口高度（阈值）排版。 */
  const pullGuideSlotHeight = computed((): number => {
    // #ifdef APP-HARMONY
    return props.pullThreshold;
    // #endif
    // #ifndef APP-HARMONY
    return props.pullSlotHeight;
    // #endif
  });
  /** Android/iOS：圆点随下拉位移上浮，恒定居中于插槽下方露出的那条空白
   *  （露出的是插槽底部 min(dy, 插槽高) 段 → 偏移 (插槽高 - 露出高)/2）。
   *  ★用插槽高、不是 maxDrag：Android 能拉过插槽高一大截，超过后插槽已整块露出，
   *    圆点停在插槽中心（clamp 住），不会跟着被推出屏幕。 */
  const pullGuideOffsetY = computed((): number => {
    const slot = props.pullSlotHeight;
    const shown = Math.min(pullGuideDistance.value, slot);
    return (slot - shown) * 0.5;
  });
  /** 鸿蒙下拉圆点覆盖层高度 = 原生下拉位移 dy。dy 就是列表被推下来、露出空白的高度，
   *  圆点在该层内 flex 居中 → 全程恒在下拉区域的垂直中心（不依赖原生刷新控件内部排版）。 */
  const pullDotLayerStyle = computed((): string => {
    return `height: ${Math.max(0, pullGuideDistance.value)}px;`;
  });
  const pullGuideRootStyle = computed((): string => {
    return `width: 100%; height: ${pullGuideSlotHeight.value}px; display: flex; flex-direction: row; align-items: center; justify-content: center; background-color: #f4f3fb;`;
  });
  const pullGuideDotsStyle = computed((): string => {
    // #ifdef APP-HARMONY
    // 覆盖层里由 flex 居中定位，不需要位移，只跟下拉进度淡入。
    return `position: relative; width: 42px; height: 18px; opacity: ${pullGuideOpacity.value};`;
    // #endif
    // #ifndef APP-HARMONY
    return `position: relative; width: 42px; height: 18px; transform: translateY(${pullGuideOffsetY.value}px); opacity: ${pullGuideOpacity.value};`;
    // #endif
  });
  /** 圆点只改 transform / opacity（合成层），**不碰 left/top/width/height**：
   *  改布局属性会让 refresher 插槽每帧重新排版，回弹动画期间肉眼可见地抖。
   *  两侧小点固定停在终点位置（left 6 / 30，见 .pull-guide__dot--left/--right），
   *  展开由 translateX 从中心「推」出去；中间点固定 12px 盒子，靠 scale 缩到 6px。 */
  const pullGuideLeftDotStyle = computed((): string =>
    `transform: translateX(${12 - 12 * pullGuideMorphProgress.value}px); opacity: ${pullGuideMorphProgress.value};`);
  const pullGuideRightDotStyle = computed((): string =>
    `transform: translateX(${12 * pullGuideMorphProgress.value - 12}px); opacity: ${pullGuideMorphProgress.value};`);
  const pullGuideCenterDotStyle = computed((): string =>
    `transform: scale(${1 - 0.5 * pullGuideMorphProgress.value}); opacity: 1;`);

  function handlePulling(eventValue: Any): void {
    if (pullGuideFrozen) return;
    const e = eventValue as UniRefresherEvent;
    const distance = Math.max(0, Math.min(e.detail.dy, props.pullMaxDragDistance));
    if (Math.abs(pullGuideDistance.value - distance) >= 1) pullGuideDistance.value = distance;
  }

  /** createSelectorQuery.exec 回调（具名函数：深层箭头块会触发 UTS 截断编译，
      message-content 同款约束）。矩形解析后原始数字直发页面（视口坐标系）。 */
  function onRowRectMeasured(results: Array<any>): void {
    let topPx = -1;
    let bottomPx = -1;
    let leftPx = -1;
    if (results.length > 0) {
      const raw = results[0];
      if (raw != null) {
        const rect = raw as NodeInfo;
        if (rect.top != null) {
          topPx = parseFloat(`${rect.top}`);
        }
        if (rect.bottom != null) {
          bottomPx = parseFloat(`${rect.bottom}`);
        }
        if (rect.left != null) {
          leftPx = parseFloat(`${rect.left}`);
        }
      }
    }
    emit("row-rect", topPx, bottomPx, leftPx);
  }

  /** 组件作用域测行矩形（页面 openRowMenu 经 $callMethod 调起；boundingClientRect
      为视口坐标系，与页面侧 .im-page 矩形同系，挖洞/锚定数学不变）。 */
  function measureRow(domId: string): void {
    const proxy = componentInstance != null ? componentInstance.proxy : null;
    if (proxy == null) {
      return;
    }
    uni.createSelectorQuery()
      .in(proxy)
      .select("#" + domId)
      .boundingClientRect()
      .exec(onRowRectMeasured);
  }

  defineExpose({
    measureRow: measureRow as any,
  });

  // ===== 事件上抛薄包装（模板边界 $event 为 Any，进入前 as UniTouchEvent）=====

  function emitRetry(): void {
    emit("retry");
  }

  function emitScroll(): void {
    emit("scroll");
  }

  function emitPullRefresh(): void {
    if (pullReleaseFired) return;
    pullReleaseFired = true;
    pullGuideFrozen = true;
    emit("pull-refresh");
  }

  function emitPullRestore(): void {
    // 上一轮收回动画收尾落在新一轮下拉中间：不复位，让这一拉继续跟手
    if (!pullGuideDragging) {
      pullGuideFrozen = true;
      pullGuideDistance.value = 0;
    }
    emit("pull-restore");
  }

  /** 未拉到位松手。★兜底：位移其实已经到了触发线（三圆点正好完整展开处；原生口径是
   *  「超过」触发线才算触发，恰好卡在线上会派 abort）仍按触发处理，避免「三个点明明
   *  完整了却不跳」。 */
  function emitPullAbort(): void {
    const distance = pullGuideDistance.value;
    // touchend 已判定达到入口线时，Android 随后仍可能补派 abort；此时不能立即清零/
    // 冻结，否则会截断正在进行的原生回弹。让 pulling 递减帧与 restore 自然收尾。
    if (pullReleaseFired) return;
    pullGuideFrozen = true;
    pullGuideDistance.value = 0;
    pullReleaseFired = true;
    if (distance >= props.pullThreshold * 0.98) {
      emit("pull-refresh");
      return;
    }
    emit("pull-abort");
  }

  /** 手指按下：解冻（上一轮的回弹动画可能还在跑，但新的下拉要能跟手）。 */
  function emitPaneTouchStart(eventValue: Any): void {
    pullGuideFrozen = false;
    pullGuideDragging = true;
    pullReleaseFired = false;
    emit("pane-touchstart", eventValue as UniTouchEvent);
  }

  function emitPaneTouchEnd(eventValue: Any): void {
    pullGuideDragging = false;
    // Android/iOS 松手当帧判定：拉到触发线（= 三个圆点完整）就立刻上抛，
    // 不等原生走 refresh/abort/restore 时序。原生稍后的事件由 pullReleaseFired 吞掉。
    if (!pullReleaseFired && pullGuideDistance.value >= props.pullThreshold * 0.97) {
      pullReleaseFired = true;
      // #ifdef APP-ANDROID
      // Android 回弹期间继续接收 pulling 的递减 dy，让圆点/灰区跟随原生回弹逐帧收起；
      // 旧逻辑冻结在最大位置，直到 abort/restore 才突然清零，视觉上像列表卡了一下。
      pullGuideFrozen = false;
      // #endif
      // #ifndef APP-ANDROID
      pullGuideFrozen = true;
      // #endif
      emit("pull-refresh");
    }
    emit("pane-touchend", eventValue as UniTouchEvent);
  }

  function emitPaneTouchCancel(eventValue: Any): void {
    pullGuideDragging = false;
    emit("pane-touchcancel", eventValue as UniTouchEvent);
  }

  function emitRowTouchStart(rowId: string, eventValue: Any): void {
    emit("row-touchstart", rowId, eventValue as UniTouchEvent);
  }

  function emitContactTouchStart(contact: ImContactRow, eventValue: Any): void {
    emit("contact-touchstart", contact, eventValue as UniTouchEvent);
  }

  function emitGroupTouchStart(group: ImConvRow, eventValue: Any): void {
    emit("group-touchstart", group, eventValue as UniTouchEvent);
  }

  function emitRowTouchMove(eventValue: Any): void {
    emit("row-touchmove", eventValue as UniTouchEvent);
  }

  function emitRowTouchCancel(): void {
    emit("row-touchcancel");
  }

  function emitPendingInClick(contact: ImContactRow): void {
    emit("pending-in-click", contact);
  }

  function emitPendingInTouchEnd(contact: ImContactRow, eventValue: Any): void {
    emit("pending-in-touchend", contact, eventValue as UniTouchEvent);
  }

  function emitPendingOutClick(contact: ImContactRow): void {
    emit("pending-out-click", contact);
  }

  function emitPendingOutTouchEnd(contact: ImContactRow, eventValue: Any): void {
    emit("pending-out-touchend", contact, eventValue as UniTouchEvent);
  }

  function emitNewPartnerClick(): void {
    emit("new-partner-click");
  }

  function emitNewPartnerTouchEnd(eventValue: Any): void {
    emit("new-partner-touchend", eventValue as UniTouchEvent);
  }

  function emitSpacesHeadClick(): void {
    emit("spaces-head-click");
  }

  function emitSpacesHeadTouchEnd(eventValue: Any): void {
    emit("spaces-head-touchend", eventValue as UniTouchEvent);
  }

  function emitSpaceRowClick(space: ImSpaceRow): void {
    emit("space-row-click", space);
  }

  function emitSpaceRowTouchEnd(space: ImSpaceRow, eventValue: Any): void {
    emit("space-row-touchend", space, eventValue as UniTouchEvent);
  }

  function emitGroupsHeadClick(): void {
    emit("groups-head-click");
  }

  function emitGroupsHeadTouchEnd(eventValue: Any): void {
    emit("groups-head-touchend", eventValue as UniTouchEvent);
  }

  function emitGroupRowClick(group: ImConvRow): void {
    emit("group-row-click", group);
  }

  function emitGroupRowTouchEnd(group: ImConvRow, eventValue: Any): void {
    emit("group-row-touchend", group, eventValue as UniTouchEvent);
  }

  function emitContactRowClick(contact: ImContactRow): void {
    emit("contact-row-click", contact);
  }

  function emitContactRowTouchEnd(contact: ImContactRow, eventValue: Any): void {
    emit("contact-row-touchend", contact, eventValue as UniTouchEvent);
  }

  function emitContactAvatarLoaded(contact: ImContactRow): void {
    emit("contact-avatar-loaded", contact);
  }

  function emitContactAvatarError(contact: ImContactRow): void {
    emit("contact-avatar-error", contact);
  }

  function emitConvAvatarLoaded(conv: ImConvRow): void {
    emit("conv-avatar-loaded", conv);
  }

  function emitConvAvatarError(conv: ImConvRow): void {
    emit("conv-avatar-error", conv);
  }

  function emitSpaceIconLoaded(space: ImSpaceRow): void {
    emit("space-icon-loaded", space);
  }

  function emitSpaceIconError(space: ImSpaceRow): void {
    emit("space-icon-error", space);
  }
</script>

<style lang="scss" scoped>
  /* ★本样式块与 conv-list-pane 各持一份 .chat-item 全族（App 端 scoped 样式按
