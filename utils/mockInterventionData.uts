/**
 * Mock 干预数据生成器
 * 用于开发和调试 ACP Permission / MCP Ask 交互卡片渲染
 *
 * 集成演示页：components/agent-intervention/README.md
 * 使用方式:
 *   import { injectMockIntervention, mockAcpPermissionSimple, mockMcpAskSurvey } from '@/utils/mockInterventionData'
 *   injectMockIntervention(messageList, 'acp-simple')
 *   injectMockIntervention(messageList, 'mcp-survey')
 */
import {
  AcpPermissionInteraction,
  AcpPermissionOption,
  AcpPermissionOptionKind,
  AcpPermissionRequest,
  AcpToolCallInfo,
  InteractionUiSchema,
  McpAskInteraction,
  MCP_ASK_TOOL_NAME,
} from "@/types/intervention";
import {
  MCP_ASK_SCHEMA_VERSION,
  INTERACTION_UI_SCHEMA_VERSION,
} from "@/utils/mcpAskSchema.uts";
import { orArray } from "@/utils/utsCoalesce";

export class MessageListRef {
  value: any[] = [];
}

function createMockAcpOption(
  optionId: string,
  kind: AcpPermissionOptionKind,
  name: string,
): AcpPermissionOption {
  const option = new AcpPermissionOption();
  option.optionId = optionId;
  option.kind = kind;
  option.name = name;
  return option;
}

function createMockAcpPermission(
  sessionId: string,
  toolCallId: string,
  title: string,
  kind: string,
  options: AcpPermissionOption[],
): AcpPermissionInteraction {
  const toolCall = new AcpToolCallInfo();
  toolCall.toolCallId = toolCallId;
  toolCall.title = title;
  toolCall.kind = kind;

  const request = new AcpPermissionRequest();
  request.sessionId = sessionId;
  request.toolCall = toolCall;
  request.options = options;

  const interaction = new AcpPermissionInteraction();
  interaction.id = `mock_acp_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;
  interaction.request = request;
  interaction.responseStatus = "pending";
  return interaction;
}

function fillMockMcpAskBase(interaction: McpAskInteraction): void {
  interaction.toolName = MCP_ASK_TOOL_NAME;
  interaction.schemaVersion = MCP_ASK_SCHEMA_VERSION;
  interaction.requestId = `mock_mcp_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;
  interaction.revision = 1;
  interaction.sessionId = "mock-session";
  interaction.responseStatus = "pending";
}

function createMockMcpAsk(
  title: string,
  description: string | null,
  ui: InteractionUiSchema,
): McpAskInteraction {
  const interaction = new McpAskInteraction();
  fillMockMcpAskBase(interaction);
  interaction.title = title;
  if (description != null) {
    interaction.description = description;
  }
  interaction.ui = ui;
  return interaction;
}

function parseMockUi(json: string): InteractionUiSchema {
  return JSON.parse(json) as InteractionUiSchema;
}

// ==================== ACP Permission Mock 数据 ====================

/**
 * 简单权限请求 - 单个 allow_once 选项
 * 场景: Agent 请求使用一次某工具
 */
export function mockAcpPermissionSimple(): AcpPermissionInteraction {
  return createMockAcpPermission(
    "mock-session-001",
    "tc_mock_001",
    "执行 Shell 命令",
    "bash",
    [
      createMockAcpOption("opt_allow_1", "allow_once", "允许一次"),
      createMockAcpOption("opt_reject_1", "reject_once", "拒绝"),
    ],
  );
}

/**
 * 多选项权限请求 - allow_once, allow_always, reject_once, reject_always
 * 场景: Agent 请求文件写入权限, 提供多种选择
 */
export function mockAcpPermissionMultiOption(): AcpPermissionInteraction {
  return createMockAcpPermission(
    "mock-session-002",
    "tc_mock_002",
    "写入文件 /src/main.ts",
    "write",
    [
      createMockAcpOption("opt_ao", "allow_once", "允许一次"),
      createMockAcpOption("opt_aa", "allow_always", "始终允许"),
      createMockAcpOption("opt_ro", "reject_once", "拒绝一次"),
      createMockAcpOption("opt_ra", "reject_always", "始终拒绝"),
    ],
  );
}

/**
 * 网络请求权限 - 无 kind 标签
 * 场景: Agent 请求发起外部 HTTP 请求
 */
export function mockAcpPermissionNetwork(): AcpPermissionInteraction {
  return createMockAcpPermission(
    "mock-session-003",
    "tc_mock_003",
    "访问 https://api.example.com/data",
    "network",
    [
      createMockAcpOption("opt_allow", "allow_once", "允许访问"),
      createMockAcpOption("opt_reject", "reject_once", "拒绝"),
    ],
  );
}

// ==================== MCP Ask Mock 数据（nuwax.interaction.v2） ====================

/**
 * 简单调查问卷 - text + textarea + radio
 * 场景: Agent 向用户收集反馈信息
 */
export function mockMcpAskSurvey(): McpAskInteraction {
  const ui = parseMockUi(
    `{"version":"${INTERACTION_UI_SCHEMA_VERSION}","presentation":"inline","title":"用户反馈","description":"请分享您对这次交互体验的反馈","fields":[{"name":"name","title":"您的称呼","widget":"text"},{"name":"feedback","title":"详细反馈","widget":"textarea","maxLength":500},{"name":"rating","title":"整体评分","widget":"radio","required":true,"options":[{"value":"excellent","label":"非常满意"},{"value":"good","label":"满意"},{"value":"fair","label":"一般"},{"value":"poor","label":"不满意"}]}],"submitLabel":"提交反馈","cancelLabel":"取消"}`,
  );
  return createMockMcpAsk(
    "用户反馈",
    "请分享您对这次交互体验的反馈",
    ui,
  );
}

/**
 * 选择框表单 - radio + checkboxes + select + number
 * 场景: Agent 让用户选择部署配置
 */
export function mockMcpAskSelectForm(): McpAskInteraction {
  const ui = parseMockUi(
    `{"version":"${INTERACTION_UI_SCHEMA_VERSION}","presentation":"inline","title":"部署配置","description":"请选择您需要的部署选项","fields":[{"name":"environment","title":"部署环境","widget":"radio","required":true,"options":[{"value":"dev","label":"开发环境"},{"value":"staging","label":"预发布环境"},{"value":"production","label":"生产环境"}]},{"name":"features","title":"启用功能","widget":"checkboxes","type":"array","options":[{"value":"logging","label":"日志记录"},{"value":"monitoring","label":"监控面板"},{"value":"alerts","label":"告警通知"},{"value":"backup","label":"自动备份"}]},{"name":"region","title":"服务区域","widget":"select","options":[{"value":"cn-east","label":"华东"},{"value":"cn-north","label":"华北"},{"value":"us-west","label":"美西"},{"value":"eu-central","label":"欧洲中部"}]},{"name":"replicas","title":"副本数","widget":"number","type":"integer","minimum":1,"maximum":10}],"submitLabel":"确认部署","cancelLabel":"取消"}`,
  );
  return createMockMcpAsk("部署配置", "请选择您需要的部署选项", ui);
}

/**
 * 最小表单 - 仅一个文本输入
 * 场景: Agent 请求用户确认一个简单输入
 */
export function mockMcpAskSimple(): McpAskInteraction {
  const ui = parseMockUi(
    `{"version":"${INTERACTION_UI_SCHEMA_VERSION}","presentation":"inline","title":"确认分支名称","fields":[{"name":"branch","title":"Git 分支名","widget":"text","required":true}],"submitLabel":"确认","cancelLabel":"取消"}`,
  );
  return createMockMcpAsk("确认分支名称", null, ui);
}

/**
 * 文件上传表单 - 包含图片和文件上传 widget
 * 场景: Agent 请求用户上传截图或文档
 */
export function mockMcpAskWithFile(): McpAskInteraction {
  const ui = parseMockUi(
    `{"version":"${INTERACTION_UI_SCHEMA_VERSION}","presentation":"inline","title":"提交问题截图","description":"请上传问题的截图或相关文件，帮助 Agent 更好地理解问题","fields":[{"name":"description","title":"问题描述","widget":"textarea","maxLength":500,"required":true},{"name":"screenshot","title":"截图","widget":"file","accept":"image/*"},{"name":"attachments","title":"相关附件","widget":"file","type":"array","multiple":true}],"submitLabel":"提交","cancelLabel":"取消"}`,
  );
  return createMockMcpAsk(
    "提交问题截图",
    "请上传问题的截图或相关文件，帮助 Agent 更好地理解问题",
    ui,
  );
}

