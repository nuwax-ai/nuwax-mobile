<template>
  <view class="container relative flex flex-col border-b">
    <!-- 顶部导航栏 -->
    <custom-nav-bar :title="t('Mobile.Nav.unionRecord')" className="border-b" hasSafetyZone>
      <!-- #ifdef MP-WEIXIN -->
      <template v-slot:left>
        <svg-icon v-if="isLoggedIn" name="icon-Search" size="48" @click="handleSearch" />
      </template>
      <!-- #endif -->
      <!-- #ifndef MP-WEIXIN -->
      <template v-slot:right>
        <svg-icon v-if="isLoggedIn" name="icon-Search" size="48" @click="handleSearch" />
      </template>
      <!-- #endif -->
    </custom-nav-bar>
    <template v-if="loading">
      <view class="loading-state">
        <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
    </template>
    <template v-else>
      <view class="flex-1 relative">
        <!-- 团队列表 -->
        <scroll-view
          class="h-full"
          direction="vertical"
          :scroll-with-animation="false"
          :refresher-enabled="true"
          :refresher-triggered="refreshing"
          @refresherrefresh="handleRefresh"
          :show-scrollbar="false"
          :scroll-into-view="anchor"
        >
          <!-- 顶部导航栏 -->
          <view
            v-for="category in homeCategoryInfo.categories"
            :key="category.type"
            class="flex flex-row items-center content-between category-box"
            hover-class="category-box-active"
            @click="handleCategoryClick(category.type)"
          >
            <!-- 默认图标 -->
            <image
              class="icon_item_category"
              :src="getCategoryIcon(category.categoryType)"
              mode="aspectFill"
              :alt="category.name.length > 0 ? category.name : t('Mobile.Common.agentIconAlt')"
            />

            <!-- 分类名称 -->
            <view class="flex-1 category-name text-ellipsis">{{
              category.name
            }}</view>

            <!-- 箭头图标（使用简单文本代替 svg-icon，减少 iOS 渲染开销） -->
            <text class="icon-right-arrow">›</text>
          </view>
          <!-- 智能体列表 -->
          <view
            v-for="group in categoryList"
            :key="group.key"
            class="group"
            :id="'id-' + group.key"
          >
            <view class="group__title">{{ group.label }}</view>
            <view
              v-for="item in group.children"
              :key="item.targetId"
              class="flex flex-row items-center item-card"
              @click="handleAgentClick(item)"
            >
              <image
                class="item-card__icon"
                :src="getImageSrc(item.targetId, item.icon)"
                mode="aspectFill"
                :alt="item.name.length > 0 ? item.name : t('Mobile.Common.agentIconAlt')"
                lazy-load
                @error="handleImageError(item.targetId)"
              />
              <view class="item-card__content">
                <text class="item-card__name text-ellipsis">{{
                  item.name
                }}</text>
                <text
                  class="item-card__desc text-ellipsis"
                  v-if="item.description"
                  >{{ item.description }}</text
                >
              </view>
            </view>
          </view>
        </scroll-view>
        <!-- 右侧字母导航栏 -->
        <view class="right-bar">
          <view
            class="right-bar__item"
            v-for="L in letters"
            :key="L"
            @click="scrollToSection(L)"
          >
            <text class="right-bar__item-text">{{ L }}</text>
          </view>
        </view>
      </view>
    </template>

    <!-- 登录弹窗（仅微信小程序） -->
    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { ref, reactive, nextTick, type ComponentPublicInstance } from 'vue';
  import {
    SUCCESS_CODE,
    USER_NO_LOGIN,
    REDIRECT_LOGIN,
  } from "@/constants/codes.constants";
  import { apiHomeCategoryList } from "@/servers/agentDev";
  import {
    CategoryInfo,
    HomeAgentCategoryInfo,
    CategoryItemInfo,
  } from "@/types/interfaces/agentConfig";
  // #ifdef H5 || WEB || MP-WEIXIN
  import { pinyin } from "@/utils/pinyin";
  // #endif
  // #ifdef APP || APP-ANDROID
  import { pinyin } from "@/utils/pinyin-stub";
  // #endif
  import agentImage from "@/static/assets/agent_image.png";
  import { getCurrentPagePath, jumpToAgentDetailPage } from "@/utils/commonBusiness";
  import { onLoad, onShow } from "@dcloudio/uni-app";
  // #ifdef MP-WEIXIN
  import { onTabItemTap, onAddToFavorites } from "@dcloudio/uni-app";
  // #endif
  import iconAgentCollect from "@/static/icons/agent_collect.svg";
  import iconTeamSpace from "@/static/icons/team_space.svg";
  import iconAgentRecommend from "@/static/icons/agent_recommend.svg";
  import iconPersonalSpace from "@/static/icons/personal_space.svg";
  // #ifdef MP-WEIXIN
  import AuthLoginPopup from "@/components/auth-login-popup/auth-login-popup.uvue";
  // #endif
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { apiPublishedAgentList } from "@/servers/square";
  import type { SquarePublishedListParams } from "@/types/interfaces/square";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { getCurrentPageFullPath } from "@/utils/common";
  import { goToLogin } from "@/utils/authNavigation";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { appGlobalState } from "@/utils/appGlobalState";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const letters = ref<string[]>([]);
  const anchor = ref<string>("");
  const loading = ref<boolean>(false);
  // 所有分类下的智能体列表，并且去重
  class CategoryLabel {
    label: string = "";
    key: string = "";
    children: CategoryItemInfo[] = [] as CategoryItemInfo[];
    constructor(label: string, key: string, children: CategoryItemInfo[]) {
      this.label = label;
      this.key = key;
      this.children = children;
    }
  }
  const categoryList = ref<CategoryLabel[]>([]);
  // 分类信息，包括每一项分类下的智能体列表
  const homeCategoryInfo = ref<HomeAgentCategoryInfo>(new HomeAgentCategoryInfo());

  // 记录加载失败的图片ID（使用非 reactive 的 Set，避免触发 Vue 重渲染）
  const failedImageIds = new Set<number>();
  // 刷新状态
  const refreshing = ref<boolean>(false);

  // 新增标志变量，用于区分首次加载
  const isFirstLoad = ref<boolean>(true);

  // 登录态
  const isLoggedIn = ref<boolean>(false);

  // 使用登录拦截 composable
  const {
    loginPopupRef,
    handleAgentClick: baseHandleAgentClick,
    checkAuthAndShowPopup,
    hasToken,
  } = useAuthInterceptor();

  // Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject 或直接点方法；用 $callMethod 调 defineExpose 方法
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // 登录
  const handleLogin = () => {
    // #ifdef MP-WEIXIN
    callRefMethod(loginPopupRef.value, "open");
    // #endif

    // #ifdef H5 || WEB || APP
    goToLogin();
    // #endif
  };

  // 包装 handleAgentClick 以适配 CategoryItemInfo 类型
  const handleAgentClick = (info: CategoryItemInfo) => {
    // 检查登录状态，如果未登录则显示登录弹窗
    if (!isLoggedIn.value) {
      handleLogin();
      return;
    }
    const infoObj = info as UTSJSONObject;
    const lastConversationId = infoObj["lastConversationId"] as number;
    const targetId = info.targetId;
    const name = info.name;
    const targetType = info.targetType;
    const baseClick = baseHandleAgentClick as (info : any) => void;
    if (lastConversationId != null && lastConversationId != 0) {
      jumpToAgentDetailPage(targetId, lastConversationId);
    } else {
      baseClick({
        targetId: targetId,
        name: name,
        targetType: targetType,
        icon: info.icon,
        description: info.description,
      });
    }
  };

  /**
   * 获取图片源地址
   * @param id 智能体ID
   * @param originalIcon 原始图片地址
   * @returns 图片地址（加载失败则返回默认图片）
   */
  const getImageSrc = (id: number, originalIcon: string): string => {
    return failedImageIds.has(id) ? agentImage : originalIcon;
  };

  /**
   * 图片加载错误时触发，切换为默认图片
   * @param id 智能体ID
   */
  const handleImageError = (id: number) => {
    failedImageIds.add(id);
  };

  // 根据 categoryType 获取对应图标
  // 注意：Android 端 UTS 的 === 编译为 Kotlin 引用相等（referential equality），
  // 从 JSON 解析出的字符串与字面量 === 比较始终为 false，必须用 ==（编译为 equals() 值比较）
  const getCategoryIcon = (categoryType: string | null): string => {
    if (categoryType == 'AGENT_COLLECT') return iconAgentCollect;
    if (categoryType == 'TEAM_SPACE') return iconTeamSpace;
    if (categoryType == 'AGENT_RECOMMEND') return iconAgentRecommend;
    return iconPersonalSpace;
  };

  // 处理智联录列表搜索
  const handleSearch = async () => {
    // 检查登录状态，如果未登录则显示登录弹窗
    const isLoggedIn = await checkAuthAndShowPopup();
    if (!isLoggedIn) {
      return;
    }
    // 将 categoryList 扁平化为一维数组
    const flatList: CategoryItemInfo[] = [] as CategoryItemInfo[];
    categoryList.value.forEach((group: CategoryLabel) => {
      group.children.forEach((item: CategoryItemInfo) => {
        flatList.push(item);
      });
    });

    // 使用共享状态临时存储列表数据和文案（替代 getApp().globalData）
    appGlobalState.localAgentList = flatList;
    // 传递搜索文案 key（在搜索页运行时翻译，保证语言切换一致）
    appGlobalState.searchPlaceholder = "Mobile.AgentUnion.searchPlaceholder";

    const currentUrl = getCurrentPagePath();
    // 跳转时添加 searchMode=local 参数标识前端过滤模式
    uni.navigateTo({
      url:
        `/subpackages/pages/agent-search/agent-search?type=ChatBot&searchMode=local&backUrl=` +
        encodeURIComponent(currentUrl),
    });
  };

  // 根据智能体列表的name字段首字母进行分组，并排序呢
  const groupByFirstLetterList = (list: CategoryItemInfo[]): CategoryLabel[] => {
    const grouped = new Map<string, CategoryItemInfo[]>();
    const allKeys: string[] = [] as string[];
    list.forEach((item: CategoryItemInfo) => {
      const itemName = item.name != null ? item.name : "";
      const firstChar = itemName.length > 0 ? itemName.charAt(0) : "";
      let firstLetter = pinyin(firstChar, {
        pattern: "first",
        tone: "none",
      }).toUpperCase();
      const isAz = /^[A-Z]$/.test(firstLetter);
      if (isAz == false) {
        firstLetter = "#";
      }
      let bucket = grouped.get(firstLetter);
      if (bucket == null) {
        bucket = [] as CategoryItemInfo[];
        grouped.set(firstLetter, bucket);
        allKeys.push(firstLetter);
      }
      bucket.push(item);
    });

    // 获取按字母排序的键（仅A-Z）
    const azKeys: string[] = [] as string[];
    allKeys.forEach((k: string) => {
      if (/^[A-Z]$/.test(k)) {
        azKeys.push(k);
      }
    });
    azKeys.sort((a: string, b: string): number => {
      return a < b ? -1 : (a > b ? 1 : 0);
    });

    // 如果有#组，添加到末尾
    const sortedKeys: string[] = [] as string[];
    azKeys.forEach((k: string) => {
      sortedKeys.push(k);
    });
    if (grouped.get("#") != null) {
      sortedKeys.push("#");
    }

    // 将首字母添加到字母列表中
    letters.value = sortedKeys;

    // 转换为指定数组格式，并对每个 children 按完整拼音排序
    const formattedList: CategoryLabel[] = [] as CategoryLabel[];
    sortedKeys.forEach((key: string) => {
      const rawBucket = grouped.get(key);
      const bucket = rawBucket != null ? rawBucket : ([] as CategoryItemInfo[]);
      // 对 children 按 name 的完整拼音排序
      bucket.sort((a: CategoryItemInfo, b: CategoryItemInfo): number => {
        const pinyinA = pinyin(a.name, { pattern: "pinyin", tone: "none" })
          .replace(/\s/g, "")
          .toLowerCase();
        const pinyinB = pinyin(b.name, { pattern: "pinyin", tone: "none" })
          .replace(/\s/g, "")
          .toLowerCase();
        return pinyinA < pinyinB ? -1 : (pinyinA > pinyinB ? 1 : 0);
      });

      const actualKey = key == "#" ? "hash" : key;
      formattedList.push(new CategoryLabel(key, actualKey, bucket));
    });

    return formattedList; // 返回结果
  };

  // 点击分类标签的逻辑
  const handleCategoryClick = (categoryKey: string) => {
    uni.navigateTo({
      url: `/subpackages/pages/category-agent-list/category-agent-list?categoryKey=${categoryKey}`,
    });
  };

  // 滚动到对应字母分组的逻辑
  const scrollToSection = (letter: string) => {
    const actualLetter = letter == "#" ? "hash" : letter;
    // 通过 nextTick 延迟设置 anchor，避免连续点击时 scroll-view 反复定位卡顿
    anchor.value = "";
    nextTick(() => {
      anchor.value = `id-${actualLetter}`;
    });
  };

  // 主页智能体列表接口
  const fetchHomeCategoryList = async () => {
    const response = await apiHomeCategoryList();
    loading.value = false;
    const code = apiResCode(response);
    if (code == SUCCESS_CODE) {
      const dataRaw = apiResData<any>(response);
      if (dataRaw != null) {
        // 直接以 UTSJSONObject 操作，避免 Gson 反序列化 interface 崩溃
        const dataObj = dataRaw as UTSJSONObject;
        // categories 下已改为 class，可安全 typed parse
        const categoriesRaw = dataObj["categories"];
        if (categoriesRaw != null) {
          const parsedCats = JSON.parse<CategoryInfo[]>(JSON.stringify(categoriesRaw));
          const cats = parsedCats != null ? parsedCats : ([] as CategoryInfo[]);
          homeCategoryInfo.value.categories = cats;
        }
        const categoryItemsRaw = dataObj["categoryItems"];
        const allCategoryItems: CategoryItemInfo[] = [] as CategoryItemInfo[];
          if (categoryItemsRaw != null) {
            const itemsObj = categoryItemsRaw as UTSJSONObject;
            const keys = UTSJSONObject.keys(itemsObj);
            for (let i = 0; i < keys.length; i++) {
              const k = keys[i];
              const valueRaw = itemsObj[k];
              if (valueRaw != null) {
                const parsedItems = JSON.parse<CategoryItemInfo[]>(JSON.stringify(valueRaw));
                const items = parsedItems != null ? parsedItems : ([] as CategoryItemInfo[]);
                for (let qi = 0; qi < items.length; qi++) {
                  allCategoryItems.push(items[qi]);
                }
              }
            }
          }

          if (allCategoryItems.length > 0) {
            // 按 targetId 去重
            const seen = new Map<number, CategoryItemInfo>();
            allCategoryItems.forEach((item: CategoryItemInfo) => {
              if (seen.get(item.targetId) == null) {
                seen.set(item.targetId, item);
              }
            });
            const uniqueCategoryItems: CategoryItemInfo[] = [] as CategoryItemInfo[];
            seen.forEach((value: CategoryItemInfo, k: number) => {
              uniqueCategoryItems.push(value);
            });

            // 根据智能体列表的name字段首字母进行分组，并排序呢
            categoryList.value = groupByFirstLetterList(uniqueCategoryItems);
          }
        }
      }
    else if (code != USER_NO_LOGIN && code != REDIRECT_LOGIN) {
      const message = apiResMessage(response);
      uni.showToast({
        title: message.length > 0 ? message : t("Mobile.AgentUnion.fetchHomeAgentListFailed"),
        icon: "none",
      });
    }
  };

  // 获取公开的智能体列表（未登录时使用）
  const fetchPublishedAgentList = async () => {
    try {
      const params = new SquarePublishedListParams();
      params.targetType = "Agent";
      params.targetSubType = "ChatBot";
      params.page = 1;
      params.pageSize = 10;
      params.category = "";
      params.kw = "";
      const res = await apiPublishedAgentList(params);
      loading.value = false;
      if (apiResCode(res) == SUCCESS_CODE) {
        const pageDataRaw = apiResData<any>(res);
        const pageObj = pageDataRaw != null ? (pageDataRaw as UTSJSONObject) : null;
        const recordsRaw = pageObj != null ? pageObj["records"] : null;
        const parsedRecords = recordsRaw != null
          ? JSON.parse<CategoryItemInfo[]>(JSON.stringify(recordsRaw))
          : null;
        const records = parsedRecords != null ? parsedRecords : ([] as CategoryItemInfo[]);
        categoryList.value = groupByFirstLetterList(records);
      }
    } catch (error) {
      loading.value = false;
    }
  };

  // 下拉刷新
  const handleRefresh = async () => {
    if (refreshing.value) {
      return;
    }
    refreshing.value = true;

    const isLoggedIn = await hasToken();

    if (isLoggedIn) {
      // 已登录
      fetchHomeCategoryList().finally(() => {
        // 添加延迟，让loading效果更明显
        setTimeout(() => {
          refreshing.value = false;
        }, 500);
      });
    } else {
      // 未登录
      fetchPublishedAgentList().finally(() => {
        // 添加延迟，让loading效果更明显
        setTimeout(() => {
          refreshing.value = false;
        }, 500);
      });
    }
  };

  const performOnLoad = async () => {
    // 设置当前页面导航栏标题
    setCurrentPageNavigationBarTitle();

    isFirstLoad.value = true;
    // 检查登录状态，如果未登录则显示登录弹窗，不加载数据
    const loggedIn = await hasToken();
    isLoggedIn.value = loggedIn;
    if (!loggedIn) {
      loading.value = false;
      // 未登录，获取公开的智能体列表
      fetchPublishedAgentList();
      return;
    }
    loading.value = true;
    fetchHomeCategoryList();
  };

  onLoad((options: any) => {
    performOnLoad();
  });

  onShow(() => {
    performOnLoad();
  });

  // #ifdef MP-WEIXIN
  onTabItemTap(async () => {
    await nextTick();

    if (Boolean(isFirstLoad.value)) {
      isFirstLoad.value = false;
      return;
    }
    const isLoggedIn = await hasToken();
    if (Boolean(isLoggedIn)) {
      fetchHomeCategoryList();
    } else {
      fetchPublishedAgentList();
    }
  });
  // #endif

  // #ifdef MP-WEIXIN
  // 收藏
  onAddToFavorites(() => {
    return {
      title: t("Mobile.Nav.unionRecord"),
    };
  });
  // #endif
</script>

<style lang="scss" scoped>
  .container {
    height: 100%; // 假设全屏
  }

  // vapor: 删除死规则 .container .icon-Search（模板使用 svg-icon 组件无 .icon-Search 类）

  /* 加载状态 */
  .loading-state {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loading-text {
    font-size: 28rpx;
    color: #666;
    display: flex;
    align-items: center;
    flex-direction: row;
  }

  /* #ifndef APP */
  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  /* #endif */

  /* #ifndef APP */
  .loading-text::before {
    content: "";
    width: 32rpx;
    height: 32rpx;
    border: 4rpx solid #e8e8e8;
    border-top: 4rpx solid #8b5cf6;
    border-radius: 16rpx;
    animation: spin 1s linear infinite;
    margin-right: 16rpx;
  }
  /* #endif */

  .category-box {
    padding: 24rpx 32rpx;
    border-bottom: 2rpx solid #f0f0f0;
    /* #ifdef APP-IOS */
    transform: translateZ(0);
    /* #endif */
    transition: background-color 0.3s ease;
  }

  // vapor: 原 &-active（.category-box-active 单类，hover-class 切换）提平
  .category-box-active {
    background-color: rgba(12, 20, 102, 0.04);
  }

  .category-name {
    font-size: 32rpx;
    font-weight: 400;
    color: rgb(51, 51, 51);
    margin-right: 16rpx;
  }

  .icon_item_category {
    width: 80rpx;
    height: 80rpx;
    border-radius: 40rpx;
    margin-right: 16rpx;
  }

  // vapor: 删除死规则 .item-category__icon（模板无此类，实际使用 .icon_item_category / .item-card__icon）

  .icon-right-arrow {
    font-size: 40rpx;
    color: #999;
    font-weight: 300;
    line-height: 1;
    padding-left: 8rpx;
  }

  // vapor: 原 .group &__title 提平为单类 .group__title
  .group__title {
    padding: 12rpx 32rpx;
    font-size: 28rpx;
    background-color: #f5f5f5;
    color: #6f6d6d;
    /* #ifdef APP-IOS */
    transform: translateZ(0);
    /* #endif */
  }

  .item-card {
    height: 150rpx;
    display: flex;
    align-items: center;
    padding: 0 32rpx;
    border-bottom: 2rpx solid #f0f0f0;
    /* #ifdef APP-IOS */
    transform: translateZ(0);
    /* #endif */
  }

  // vapor: 删除死规则 .item-card-active / .item-card__count（模板无此类）

  .item-card__icon {
    width: 80rpx;
    height: 80rpx;
    border-radius: 40rpx;
    margin-right: 24rpx;
  }

  .item-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  // vapor: 原 .item-card__content .item-card__name 后代 + .item-card &__name 合并提平为单类 .item-card__name
  .item-card__name {
    margin-bottom: 8rpx;
    font-size: 32rpx;
    font-weight: 600;
    color: #15171f;
  }

  .item-card__desc {
    font-size: 28rpx;
    color: rgba(21, 23, 31, 0.7);
    line-height: 44rpx;
    font-weight: 400;
  }

  .right-bar {
    position: absolute;
    right: 22rpx;
    bottom: 120rpx;
    width: 32rpx;
    /* #ifdef H5 */
    max-height: calc(100% - 140rpx);
    /* #endif */
    /* #ifndef H5 */
    max-height: 800rpx;
    /* #endif */
    padding: 16rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    border-radius: 16rpx;
    /* #ifdef H5 */
    overflow: auto;
    /* #endif */
    /* #ifndef H5 */
    overflow: hidden;
    /* #endif */
    z-index: 100;
    background-color: rgb(244, 241, 241);
  }

  .right-bar__item {
    margin-bottom: 8rpx;
  }

  .right-bar__item:last-child {
    margin-bottom: 0;
  }

  /* #ifdef H5 */
