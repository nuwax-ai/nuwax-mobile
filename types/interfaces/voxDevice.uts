/**
 * Nuwax Vox 设备语音网关 - App 设备接口类型
 * 接口文档: POST /api/app/devices/bind 等
 */

/** 绑定设备请求参数（deviceSecret 仅绑定响应返回，App 需下发给设备本地保存） */
export class AppDeviceBindParams {
  // 设备 ID（必填；配网时取 device-info 的 serialNumber）
  deviceId: string = "";
  // 展示名称；空则服务端默认用 deviceId
  displayName: string = "";
}

/** 修改设备名称请求参数 */
export class AppDeviceRenameParams {
  // 展示名称；空则回退为 deviceId
  displayName: string = "";
}

/** 更新设备资料请求参数 */
export class AppDeviceProfileUpdateParams {
  deviceName: string = "";
  deviceRole: string = "";
  wakeWord: string = "";
}

/** 设备绑定资料（更新接口响应） */
export interface IAppDeviceBindingView {
  id: any;
  deviceId: string;
  deviceName: string;
  deviceRole: string;
  wakeWord: string;
  wakeWordPinyin: string;
  online: boolean;
  bindingStatus: string;
  mode: string;
  agentId: number;
  conversationId: number;
  deviceSecret: string;
  boundAt: string;
}

/** 设备视图（GET /api/app/devices 当前返回绑定记录详情） */
export interface IAppDeviceView {
  id?: any | null;
  deviceId: string;
  deviceName?: string | null;
  deviceRole?: string | null;
  wakeWord?: string | null;
  wakeWordPinyin?: string | null;
  bindingStatus?: string | null;
  online: boolean;
  // 旧绑定/改名接口可能仍返回 displayName。
  displayName?: string | null;
  // 设备连接密钥；列表通常返回 null，绑定成功时仅在内存持有并下发给设备。
  deviceSecret?: string | null;
  // 设备 WebSocket 地址；绑定成功时由服务端返回，App 原样下发给设备。
  websocketUrl?: string | null;
  // 绑定时间
  boundAt: string;
  /**
   * 设备关联的终端智能体 ID（主站配置 / 群组成员接口入参）
   * 由设备列表接口下发；缺省表示尚未关联，组员管理入口需拦截
   */
  agentId?: number | null;
  conversationId?: number | null;
  /**
   * 当前工作模式（CONVERSATION / MEETING / MONITORING）
   * 由设备详情/列表接口下发，设备详情页模式选择据此回显
   */
  mode?: string | null;
}

/** 设备事件表情绑定视图（GET /api/app/devices/{id}/event-emotions 返回项） */
export interface IAppDeviceEventEmotionView {
  // 事件 wire 值，更新时回传
  event: string;
  // 事件中文名
  eventLabel: string;
  // 生效表情 wire 值
  emotion: string;
  // 生效表情中文说明
  emotionLabel: string;
  // 系统默认表情 wire 值
  defaultEmotion: string;
  // 是否相对默认做了自定义绑定
  customized: boolean;
}

/** 可选设备表情（GET /api/app/devices/emotions 返回项） */
export interface IAppDeviceEmotionView {
  // 表情 wire 值，写入事件绑定时使用
  emotion: string;
  // 中文说明
  label: string;
}

/** 可选 TTS 音色（GET /api/app/devices/tts-voices 返回项） */
export interface IAppTtsVoiceView {
  // CosyVoice voice 参数，写入设备设置
  voiceId: string;
  // 展示名（特质）
  name: string;
  // 音色预听音频 URL
  previewUrl: string;
}

/** 设备语音设置视图（GET /api/app/devices/{id}/voice-settings） */
export interface IAppDeviceVoiceSettingsView {
  // 设备是否在线（离线时不可调节音量）
  online: boolean;
  // 语音播报开关
  voiceBroadcastEnabled: boolean;
  // 音量百分比 0-100
  volumePercent: number;
  // 当前 TTS 音色 voice 参数（CosyVoice）
  ttsVoice: string;
  // 当前 TTS 音色展示名
  ttsVoiceName: string;
}

/**
 * 更新设备语音设置请求（POST /voice-settings/update；未传字段保持原值）
 * 用 class + 可空字段：Android 上显式 build body，避免序列化多余 null。
 * ttsVoice：null=不改，""=恢复全局默认。
 */
export class AppDeviceVoiceSettingsUpdateParams {
  voiceBroadcastEnabled: boolean | null = null;
  volumePercent: number | null = null;
  ttsVoice: string | null = null;
}

/** 设备商品视图（GET /api/app/device-goods 返回项；终端产品购买卡数据源） */
export interface IAppDeviceGoodsView {
  // 商品 ID（下单时回传给 desk-buddy/create）
  goodsId: string;
  // 商品标题
  title: string;
  // 副标题
  subtitle: string;
  // 价格（元）
  priceYuan: number;
  // 货币代码（如 CNY）
  currency: string;
  // 商品主图 URL
  imageUrl: string;
  // 商品卖点列表
  highlights: string[];
  // 按钮文案
  buttonText: string;
}
