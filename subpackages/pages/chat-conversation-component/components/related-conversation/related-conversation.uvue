<template>
  <view class="related-conversation">
    <view class="header">
      <text class="title">{{ t("Mobile.Conversation.relatedTitle") }}</text>
      <view class="view-all" @click="onViewAll(chatList)">
        <text class="view-all-text">{{
          t("Mobile.Conversation.viewAll")
        }}</text>
        <svg-icon name="icon-a-Chevronright" />
      </view>
    </view>
    <custom-nav-bar-speak :chat-list="chatListTop" />
  </view>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { ref, computed, onMounted } from "vue";
  import { ConversationListParams } from "@/types/interfaces/conversationInfo";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiAgentConversationList } from "@/servers/conversation";
  import CustomNavBarSpeak from "@/components/custom-nav-bar/custom-nav-bar-speak/custom-nav-bar-speak.uvue";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  // uvue 对复杂对象 prop（AgentDetailDto）存在 override 类型不匹配问题，改用 UTSJSONObject
  interface RelatedConversationProps {
    agentInfo: UTSJSONObject;
  }

  const props = defineProps<RelatedConversationProps>();

  // 定义自定义事件（Android：列表项多为 UTSJSONObject，勿用 ConversationInfo[]）
  const emit = defineEmits<{
    "view-all": [data: any[]];
  }>();

  const chatList = ref<any[]>([]);

  // 取前 10 条（UTS 用循环构建，避免模板上对数组做 slice/?. 的 nullable 问题）
  const chatListTop = computed((): any[] => {
    const src = chatList.value;
    const out = [] as any[];
    const limit = src.length >= 10 ? 10 : src.length;
    for (let i = 0; i < limit; i++) {
      out.push(src[i]);
    }
    return out;
  });

  // 查看全部处理
  const onViewAll = (data: any[]) => {
    emit("view-all", data);
  };

  // 从对象中安全提取有效智能体 ID (大于 0)
  const extractAgentIdNum = (obj: UTSJSONObject): number => {
    const v = obj["agentId"];
    if (v != null) {
      const n = parseFloat(`${v}`);
      if (!isNaN(n) && n > 0) return n;
    }
    const id = obj["id"];
    if (id != null) {
      const n = parseFloat(`${id}`);
      if (!isNaN(n) && n > 0) return n;
    }
    const tid = obj["targetId"];
    if (tid != null) {
      const n = parseFloat(`${tid}`);
      if (!isNaN(n) && n > 0) return n;
    }
    return 0;
  };

  // 查询用户历史会话
  const fetchUserConversationList = async () => {
    const a = props.agentInfo;
    const agentId = extractAgentIdNum(a);

    const params = new ConversationListParams();
    if (agentId > 0) {
      params.agentId = agentId;
    }
    const res = await apiAgentConversationList(params);
    if (res == null) {
      return;
    }
    const code = res.code;
    if (code == SUCCESS_CODE) {
      const d = res.data;
      if (d != null) {
        try {
          const list = d as any[];
          chatList.value = list != null ? list : ([] as any[]);
        } catch (_e) {
          chatList.value = [] as any[];
        }
      } else {
        chatList.value = [] as any[];
      }
    }
  };

  onMounted(() => {
    fetchUserConversationList();
  });
</script>

<style lang="scss" scoped>
  .related-conversation {
    padding: 0rpx;
    background-color: #fff;
    border-radius: 16rpx;
    margin-bottom: 24rpx;
  }

  .header {
    margin-top: 20rpx;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx 10rpx;
  }

  .title {
    font-size: 28rpx;
    font-weight: 600;
    color: rgba(21, 23, 31, 1);
    line-height: 44rpx;
  }

  .view-all {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .view-all-text {
    font-size: 24rpx;
    color: rgba(130, 136, 148, 1);
    margin-right: 5rpx;
    line-height: 38rpx;
  }
</style>
