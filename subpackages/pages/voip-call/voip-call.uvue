<template>
  <voip-call-screen :shown="pageShown" />
</template>
<script setup lang="uts">
  import { ref } from "vue";
  import VoipCallScreen from "@/features/voip/screens/call.uvue";
  const pageShown = ref(false);

  function hideCallPage(): void { pageShown.value = false; }
  onShow((): void => { pageShown.value = true; });
  onHide(hideCallPage);
  onUnload(hideCallPage);
</script>
