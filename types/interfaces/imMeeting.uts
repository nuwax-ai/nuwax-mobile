/**
 * IM 实时会议（对齐 PC `nuwax-im-web/src/api/types.ts`，分支 feat-video-meeting）类型定义。
 *
 * ★三条硬约束，改这个文件前先读：
 * 1. **所有 id 都是字符串**：服务端是 19 位雪花号，JS/Kotlin 的 number 都会丢精度，
 *    转数字后表现为「点开提示会议不存在」。会议号 roomName 例外，它本来就是字符串。
 * 2. **接口返回运行时是 UTSJSONObject**（见 types/interfaces/request.uts 头注释），
 *    这里只做形状文档与编译期提示，页面里仍走 apiResCode / apiResData 取值。
 * 3. **状态字段一律用数字码判据**（status / recordStatus / transcript.status），
 *    不要比对 *Text 字符串——文案随语言变、服务端也会改。
 */

// ---------------------------------------------------------------- 会议邀请（IM 普通消息）

/**
 * 会议邀请 body（msgType="meeting_invite"）。
 *
 * ★与 voip 通话邀请的差别是有意的：会议邀请没有 60 秒响铃窗口，也不需要 callId，
 * 被邀请人直接按 roomName 入会（create=false，绝不凭空建房）。
 */
export interface ImMeetingInviteBody {
  /** 前端生成的去重键：同一条消息重复投递只处理一次。 */
  inviteId: string;
  /** 会议号 = LiveKit 房间名；入会只签令牌，不建房。 */
  roomName: string;
  /** 会议主题（服务端只拿它拼消息摘要，会议号不进摘要）。 */
  title: string;
  /** 入会时默认开不开摄像头；会议一律语音开局。 */
  mediaType: string;
  /** 群通话卡片（可选，缺省=普通会议邀请）。只影响文案，不改变入会方式。 */
  groupCall?: boolean;
  /** 静默投递（可选）：到达时不弹浮层，只留在聊天里。 */
  silent?: boolean;
}

/** 会议邀请「忽略 / 已加入」跨端同步（只发给自己的其余在线设备，邀请人收不到）。 */
export class ImMeetingInviteHandledRequest {
  convId: string = "";
  msgId: string = "";
  inviteId: string = "";
  roomName: string = "";
}

// ---------------------------------------------------------------- 房间与令牌

/** 创建会议房间（POST /meetings/rtc/rooms）。 */
export class ImMeetingCreateRoomRequest {
  /** 会议标题（origin=1 时生效；留空服务端按「会议+房间名」兜底）。 */
  title: string = "";
  /** 关联会话，可空（从会议栏发起没有会话）。 */
  convId: string = "";
  /** ★来源：1=会议（只有 origin=1 建房时才落一条 im_meeting）。 */
  origin: number = 1;
  /** 会议类型：1=语音 2=视频 3=含屏幕共享（口径同 im_meeting.meeting_type，勿照旧注释写反）。 */
  meetingType: number = 1;
  /** ★是否允许免登录游客入会。服务端缺省 true，移动端必须显式传，不依赖默认值。 */
  allowGuest: boolean = false;
  /** ★客户端预生成的分享 slug（[a-z0-9]{8,32}）：复制邀请时链接里必须已是最终值。 */
  shareSlug: string = "";
}

/** 创建房间返回。 */
export interface ImMeetingRoomView {
  name: string;
  sid?: string;
  numParticipants?: number;
  createdAt?: string;
  hostUserId?: string;
  hostIdentity?: string;
}

/** 给自己签发入会令牌（POST /meetings/rtc/rooms/{room}/tokens）。 */
export class ImMeetingIssueTokenRequest {
  /** ★必填：identity 第三段（tenant:user:platform），同平台同房间只有一个席位。 */
  platform: string = "";
  deviceId: string = "";
  displayName: string = "";
}

/** 入会令牌返回。★token 是 LiveKit JWT：只交给 SDK connect，绝不落日志/埋点/存储。 */
export interface ImMeetingTokenView {
  room: string;
  identity: string;
  userId?: string | null;
  platform?: string | null;
  deviceId?: string | null;
  role?: string | null;
  token: string;
  /** 客户端连接地址（ws:// 或 wss://），由服务端按配置下发。 */
  wsUrl: string;
  expiresAt?: string | null;
  /** 本场会议是否允许游客加入（来自房间 metadata，不是本地勾选状态）。 */
  guestAllowed?: boolean;
  /** 会议时长上限（秒）；null/undefined 表示不展示。到点服务端自动结束（宽限 60 秒）。 */
  plannedDurationSec?: number | null;
  /** 会议记录里的开始时刻（epoch 毫秒），用来算「剩余时长」。 */
  meetingStartedAt?: number | null;
  /**
   * ★这场会还没正式开始（预约会议「提前进入」的等待房间）。
   * 据此提示「等待其他人加入，满 2 人自动开始」。
   */
  waiting?: boolean;
}

// ---------------------------------------------------------------- 会中成员与治理

/** 在线成员（一个「用户+平台」席位一条，同一用户多端会有多条同 userId 记录）。 */
export interface ImMeetingParticipantView {
  /** tenant:user:platform；非 IM 客户端接入的参与者可能不是这个格式。 */
  identity: string;
  userId?: string | null;
  /** ios/android/harmonyos/web/desktop/miniapp。 */
  platform?: string | null;
  deviceId?: string | null;
  name?: string | null;
  /** ★是否主持人：判据是房间 metadata 的 hostUserId，不是 token 角色。 */
  host?: boolean;
  /** JOINING / JOINED / ACTIVE / DISCONNECTED。 */
  state?: string | null;
  joinedAt?: string | null;
  permission?: ImMeetingPermissionView | null;
  /** ★麦克风是否在推流看这里：source=MICROPHONE 的 audio 轨道的 muted。 */
  tracks?: ImMeetingTrackView[];
  /** ★LiveKit participant attributes 原样透出（举手 handRaised、头像 avatar 等）。 */
  attributes?: UTSJSONObject | null;
}

export interface ImMeetingTrackView {
  sid?: string;
  /** audio / video。 */
  type?: string;
  name?: string;
  /** microphone / camera / screen_share / screen_share_audio。 */
  source?: string;
  muted?: boolean;
  width?: number;
  height?: number;
}

export interface ImMeetingPermissionView {
  canPublish?: boolean;
  canSubscribe?: boolean;
  canPublishData?: boolean;
  canPublishSources?: string[];
  hidden?: boolean;
  recorder?: boolean;
  canUpdateOwnMetadata?: boolean;
}

/** 踢人结果。★目标已离线时 kickedCount=0 是幂等成功，不是错误。 */
export interface ImMeetingKickView {
  userId?: string | null;
  kickedIdentities?: string[];
  kickedCount: number;
}

/** 静音结果。 */
export interface ImMeetingMuteView {
  userId?: string | null;
  identities?: string[];
  trackSids?: string[];
  mutedCount: number;
  muted?: boolean;
}

/** 全员静音结果（mutedCount 是轨道数；已在静音的席位被跳过，重复点击得 0 属正常）。 */
export interface ImMeetingMuteAllView {
  mutedCount: number;
  identities?: string[];
}

/** 改成员权限（只覆盖传入的非 null 字段）。 */
export class ImMeetingUpdatePermissionRequest {
  platform: string = "";
  deviceId: string = "";
  canPublish: boolean | null = null;
  canSubscribe: boolean | null = null;
  canPublishData: boolean | null = null;
  canUpdateOwnMetadata: boolean | null = null;
  hidden: boolean | null = null;
}

export interface ImMeetingPermissionUpdateView {
  userId?: string | null;
  identities?: string[];
  permission?: ImMeetingPermissionView | null;
}

/** 静音/取消静音：按 source（默认 audio）或精确 trackSid 操作。 */
export class ImMeetingMuteParticipantRequest {
  platform: string = "";
  deviceId: string = "";
  trackSid: string = "";
  source: string = "";
  /** ★false=取消静音；不传按 true（静音）处理。 */
  muted: boolean = true;
}

/**
 * 会中开关（仅房主）。只覆盖传入的非 null 字段；服务端写进房间 metadata，
 * 房内所有端立刻收到 RoomMetadataChanged，不靠轮询。
 *
 * ★muteAll（全员禁言）是双动作：除了改开关，服务端还会静音非主持人麦克风并把
 * microphone 从发布源里摘掉——对方重连也开不了麦。与单点静音（可自己点回来）不同。
 */
export class ImMeetingUpdateRoomSettingsRequest {
  muteAll: boolean | null = null;
  danmaku: boolean | null = null;
}

export interface ImMeetingRoomSettingsView {
  room?: string;
  hostUserId?: string;
  muteAll?: boolean;
  danmaku?: boolean;
}

// ---------------------------------------------------------------- 录制（LiveKit Egress）

/** 发起服务端录制（RoomCompositeEgress，仅房主；同一房间同时只允许一个进行中）。 */
export class ImMeetingStartRecordingRequest {
  /** grid（默认）/ speaker / single-speaker / spotlight。 */
  layout: string = "";
  preset: string = "";
  /** true ⇒ 只出音频（OGG）。 */
  audioOnly: boolean = false;
  convId: string = "";
  title: string = "";
  /** 来源：1=会议 2=通话。会议栏发起的录制传 1。 */
  origin: number = 1;
  meetingType: number = 1;
  selfDisplayName: string = "";
}

export interface ImMeetingRecordingFileView {
  filename?: string;
  /** 对象存储里的 key。 */
  location?: string;
  /** 可直接下载的地址（egress/存储配置允许时才带）。 */
  downloadUrl?: string;
}

/**
 * 录制任务。状态：EGRESS_STARTING / EGRESS_ACTIVE / EGRESS_ENDING /
 * EGRESS_COMPLETE / EGRESS_FAILED / EGRESS_ABORTED。
 * ★停止是异步的：必须轮询到 EGRESS_COMPLETE 才拿到最终文件。
 */
export interface ImMeetingRecordingView {
  egressId: string;
  roomName: string;
  status: string;
  error?: string;
  startedAt?: string;
  endedAt?: string;
  files?: ImMeetingRecordingFileView[];
}

// ---------------------------------------------------------------- 访客（免登录）

/** 访客看到的会议信息（/meetings/public/rooms/{room}，唯一匿名端点）。 */
export interface ImMeetingGuestRoomView {
  room: string;
  /** 会议名称；空白时前端回退成「会议 123 456 789」（★必须用 room 拼，不是链接里的 slug）。 */
  title?: string | null;
  /** 在线人数（含主持人）。 */
  numParticipants: number;
  /** ★false ⇒ 房间不在；用 status 区分「还没开始 / 已结束 / 已取消」。 */
  active: boolean;
  /** 0=预约未开始 1=进行中 2=已结束 3=已取消（null=查不到记录）。 */
  status?: number | null;
  /** ★false ⇒ 不要再展示昵称表单，直接提示需登录入会。 */
  guestAllowed: boolean;
  /** ★游客会中计时必须用它（这场会开了多久，不是我这个访客连了多久）。 */
  startedAt?: number | null;
  plannedDurationSec?: number | null;
  /** 允许提前进入：status=0 且为 true 时展示「进入等候」，而不是死等约定时间。 */
  allowEarlyJoin?: boolean;
  /** 这场会设了入会密码（填写后才能进）。 */
  requiresPasscode?: boolean;
}

/** 凭昵称换访客令牌（userId 为 null、platform=guest，identity=guest-{uuid}）。 */
export class ImMeetingGuestTokenRequest {
  /** 必填，1~24 字符。 */
  nickname: string = "";
  deviceId: string = "";
  /** 入会密码（设了密码的会议必填）。 */
  passcode: string = "";
}

// ---------------------------------------------------------------- 预约与会议记录

/**
 * 创建预约（POST /meetings/schedules）。
 * ★没有会议时长字段：时长由服务端配置统一写入，客户端不要传。
 * ★roomName/shareSlug 必须沿用弹窗预生成的值，否则刚复制出去的邀请链接立刻作废。
 */
export class ImMeetingCreateScheduleRequest {
  title: string = "";
  roomName: string = "";
  /** ISO 字符串或 yyyy-MM-dd HH:mm。 */
  startAt: string = "";
  convId: string = "";
  meetingType: number = 1;
  allowGuest: boolean = false;
  /** 允许提前进入（未到点也能进等待房，满 2 人自动开始）。不传=默认开（与服务端同口径）。 */
  allowEarlyJoin: boolean = true;
  /** 入会密码（4-6 位数字）。空串=不设密码。 */
  joinPasscode: string = "";
  shareSlug: string = "";
}

/** 修改入会设置（POST /meetings/{id}/join-policy，仅主持人）。 */
export class ImMeetingUpdateJoinPolicyRequest {
  /** 不传=不改。 */
  allowEarlyJoin: boolean | null = null;
  /** ★不传=不改密码；传空串=取消密码；只改开关时千万不要带它。 */
  joinPasscode: string | null = null;
}

/** 入会设置（服务端只回"要不要密码"，绝不回密码本身）。 */
export interface ImMeetingJoinPolicyView {
  allowEarlyJoin: boolean;
  requiresPasscode: boolean;
}

/**
 * 主持人查自己会议的入会密码（按需拉取，不随列表/详情批量下发）。
 * ★三种状态必须分开：没设密码 / 有值可显示 / 设了但还原不出来（老密码只有单向摘要）。
 */
export interface ImMeetingPasscodeView {
  requiresPasscode: boolean;
  passcode?: string | null;
}

/**
 * 会议记录列表项。口径是「我参与过」而不是「我主持过」，通话录音转成的记录也在内。
 * ★列表里没有下载地址：下载前调 fileUrl 现签，服务端每次重新校验参会人身份。
 */
export interface ImMeetingRecordView {
  id: string;
  convId?: string | null;
  title?: string;
  /** 1=会议 2=通话（开启录音后转成的会议）。 */
  origin?: number;
  originText?: string;
  /** 0=未开始（预约） 1=进行中 2=已结束 3=已取消。 */
  status?: number;
  statusText?: string;
  /** LiveKit 房间名：另一端看到「进行中」后点入会用。预约会议创建时就有，开始沿用同名。 */
  roomName?: string | null;
  /** ★分享链接专用不可猜测串（空=升级前老记录，拼链接时回退会议号）。 */
  shareSlug?: string | null;
  /** 预约时定下的游客开关：「开始」这场预约时要带回 createRoom，否则客人进不来。 */
  allowGuest?: boolean;
  /** 预约会议是否允许提前进入。 */
  allowEarlyJoin?: boolean;
  /** 这场会设了入会密码（列表/详情标签用；明文只能主持人单独拉）。 */
  requiresPasscode?: boolean;
  /** 0=未录制 1=录制中 2=已完成 3=录制失败。 */
  recordStatus?: number;
  recordStatusText?: string;
  startTime?: string;
  endTime?: string | null;
  durationSec?: number;
  durationText?: string;
  memberCount?: number;
  members?: string[];
  hasRecording?: boolean;
  fileCount?: number;
  hostUserId?: string;
  hostName?: string | null;
  /** 我是不是主持人（决定「结束/删除对所有人生效」等按钮显隐；最终仍由服务端判权）。 */
  host?: boolean;
}

/** 录音文件（★刻意没有 url：预签名链接是临时凭证，不能让「能看列表」=「能下文件」）。 */
export interface ImMeetingRecordFileView {
  id: string;
  filename?: string;
  contentType?: string;
  sizeBytes?: number;
  durationSec?: number;
  /** 1=生成中 2=可用 3=失败。 */
  status?: number;
  statusText?: string;
  error?: string | null;
}

export interface ImMeetingTranscriptSegmentView {
  speakerId?: number | null;
  /** 毫秒（识别服务原生单位）。 */
  beginMs?: number | null;
  endMs?: number | null;
  text?: string;
}

/**
 * 一个录制文件的转写结果。
 * 状态：1=待抽音频 2=抽音频中 3=待识别 4=识别中 5=完成 6=失败 7=跳过。
 * ★只有 5（完成）才带 segments，其余状态为空——不要据此猜进度。
 */
export interface ImMeetingTranscriptView {
  id: string;
  sourceFileId?: string | null;
  status?: number;
  statusText?: string;
  language?: string | null;
  durationMs?: number | null;
  speakerCount?: number | null;
  segmentCount?: number | null;
  error?: string | null;
  segments?: ImMeetingTranscriptSegmentView[];
}

export interface ImMeetingRecordMemberView {
  userId?: string;
  displayName?: string;
  /** 1=参会者 2=主持人。 */
  role?: number;
  roleText?: string;
}

/** 会议详情：列表项 + 参会人 + 录音文件 + 转写。 */
export interface ImMeetingRecordDetailView {
  meeting?: ImMeetingRecordView;
  members?: ImMeetingRecordMemberView[];
  /**
   * 录制文件。★服务端已按回放可见性过滤：非主持人且主持人没分享 / 没分享给你时
   * 这里恒为空数组并置 replayVisible=false —— 用状态区分「没录制」和「看不到」。
   */
  files?: ImMeetingRecordFileView[];
  /** 语音转写（每个文件一条）；与 files 同一条可见性规则，未启用时为空。 */
  transcripts?: ImMeetingTranscriptView[];
  roomName?: string;
  /** 当前用户是否能看本场回放。 */
  replayVisible?: boolean;
  /** 主持人是否已分享过回放（有效期内）：区分「没分享」和「没分享给你」。 */
  replayShared?: boolean;
  /** 说话人编号 → 最终展示名（source=manual 已确认 / auto 按说话时间线预填）。 */
  speakerNames?: UTSJSONObject | null;
}

/**
 * 现签地址。★expiresIn===0 / 两个 url 都空是**正常返回**（录音生成中 / 失败 / 存储未配置），
 * 按 reason 显示「处理中」，不要当错误弹框。
 * playUrl 是 inline（页面内播放），downloadUrl 是 attachment（落盘）。
 */
export interface ImMeetingRecordUrlView {
  fileId?: string;
  filename?: string;
  /** @deprecated 等价于 downloadUrl，仅为兼容保留。 */
  url?: string | null;
  playUrl?: string | null;
  playExpiresIn?: number;
  downloadUrl?: string | null;
  downloadExpiresIn?: number;
  /** @deprecated 等价于 downloadExpiresIn。 */
  expiresIn?: number;
  reason?: string | null;
}

// ---------------------------------------------------------------- 常量（与 PC 对齐，勿各写一份）

/** 会中聊天 DataChannel topic（弹幕关闭时「聊天」入口用它）。 */
export const IM_MEETING_CHAT_TOPIC = "meeting-chat";
/** 弹幕 DataChannel topic。 */
export const IM_MEETING_DANMAKU_TOPIC = "danmaku";
/** 会中文字上限（与 PC 一致）。 */
export const IM_MEETING_CHAT_MAX_LEN = 120;

/** im_meeting.status：0 未开始 1 进行中 2 已结束 3 已取消。 */
export const IM_MEETING_STATUS_SCHEDULED = 0;
export const IM_MEETING_STATUS_ACTIVE = 1;
export const IM_MEETING_STATUS_ENDED = 2;
export const IM_MEETING_STATUS_CANCELED = 3;

/** im_meeting.meeting_type：1 语音 2 视频 3 含屏幕共享。 */
export const IM_MEETING_TYPE_AUDIO = 1;
export const IM_MEETING_TYPE_VIDEO = 2;
export const IM_MEETING_TYPE_SCREEN = 3;

/** im_meeting.origin：1 会议 2 通话。 */
export const IM_MEETING_ORIGIN_MEETING = 1;
export const IM_MEETING_ORIGIN_CALL = 2;

/** im_meeting_transcript.status：5=完成。 */
export const IM_MEETING_TRANSCRIPT_DONE = 5;

/** 录制文件状态：1 生成中 2 可用 3 失败。 */
export const IM_MEETING_FILE_READY = 2;

/** 回放分享范围：0=所有人 1=参会人员 2=指定人员 3=指定联系人。 */
export const IM_MEETING_SHARE_SCOPE_ALL = 0;
export const IM_MEETING_SHARE_SCOPE_MEMBERS = 1;
export const IM_MEETING_SHARE_SCOPE_USERS = 2;
export const IM_MEETING_SHARE_SCOPE_CONTACTS = 3;

// ---------------------------------------------------------------- 共享占位（A10 抢占式投屏）

/**
 * ★★共享占位结果（四个 share-holder 端点统一返回）。
 *
 * 语义是「后来者赢」：抢占**没有拒绝分支**，原 holder 会被服务端收走发布权限，
 * 并通过 RoomMetadataChanged 被告知「已被 XX 接管」。
 * ★调用顺序必须是「先抢占成功 → 再开屏幕采集」：不先拿到 holder 身份就采集，
 * 画面采到了却推不出去（服务端默认把 screen_share 从发布源摘掉了）。
 * 失败 IM_30004 = 限流/正在切换（每人每 10 秒最多接管一次），提示「请再点一次」，不是故障。
 */
export interface ImMeetingShareHolderView {
  /** 当前 holder 的完整 identity；★空串 = 已释放（没人在共享）。 */
  holder: string;
  /** holder 显示名（游客名字不在 identity 里，被顶提示靠它）。 */
  holderName: string;
  /** 占锁时刻（epoch 毫秒）。 */
  since: number;
}

// ---------------------------------------------------------------- 回放分享（2026-11-09 起要求登录）

/** 创建/重新生成回放分享。★默认幂等：已有有效链接原样返回，regenerate=true 才换新。 */
export class ImMeetingCreateReplayShareRequest {
  /** 有效期（天）：不传=默认 7；0=永久；其余 1~365。有效期变了会重新生成（旧链接立即失效）。 */
  expiresInDays: number | null = null;
  regenerate: boolean | null = null;
  /** 分享范围：0/1/2/3（见 IM_MEETING_SHARE_SCOPE_*）。不传：新建默认 1，已分享保持原范围。 */
  scope: number | null = null;
}

/** 主持人视角的分享状态。未分享时 token 为 null、active=false（★正常返回，不是 404）。 */
export interface ImMeetingReplayShareView {
  meetingId?: string;
  token?: string | null;
  /** yyyy-MM-dd HH:mm:ss；null=永久。 */
  expiresAt?: string | null;
  createdAt?: string | null;
  /** 当前是否存在一条有效链接。 */
  active?: boolean;
  scope?: number | null;
  scopeText?: string | null;
  /** 「指定人员」名单（字符串雪花 id）。 */
  scopeUserIds?: string[] | null;
  /** 分享到的群（会话 id），仅 scope=2 可能有值；群名由客户端用会话列表补。 */
  scopeGroupIds?: string[] | null;
}

/** 回放页里的一个可播文件（★没有下载地址）。 */
export interface ImMeetingPublicReplayFileView {
  id: string;
  filename?: string | null;
  contentType?: string | null;
  sizeBytes?: number | null;
  durationSec?: number | null;
}

/** 回放页的一段转写（★speakerNames 只是「编号→姓名」，不含 userId：访客不该拿到内部 id）。 */
export interface ImMeetingPublicTranscriptView {
  sourceFileId?: string | null;
  segments?: ImMeetingTranscriptSegmentView[];
  speakerNames?: UTSJSONObject | null;
}

/** GET /meetings/public/replays/{token}：回放页全部数据。★失效/过期统一抛 MEETING_NOT_FOUND。 */
export interface ImMeetingPublicReplayView {
  title?: string | null;
  /** 1=会议 2=通话。 */
  origin?: number | null;
  originText?: string | null;
  startedAt?: string | null;
  endedAt?: string | null;
  durationSec?: number | null;
  files?: ImMeetingPublicReplayFileView[];
  transcripts?: ImMeetingPublicTranscriptView[];
  /** ★只有主持人能下载；老服务端不下发 ⇒ false（不给下载按钮）。 */
  canDownload?: boolean | null;
}

/** 回放文件地址。★分享链接是「可以看」不是「可以拿走」：downloadUrl 只在 download=1 时返回。 */
export interface ImMeetingReplayUrlView {
  fileId?: string;
  playUrl?: string | null;
  downloadUrl?: string | null;
  /** 有效期（秒）；不可用时为 0（按 reason 提示处理中）。 */
  expiresIn?: number;
  reason?: string | null;
}

// ---------------------------------------------------------------- 说话人识别

/** 一个说话人编号的最终展示名。 */
export interface ImMeetingSpeakerNameView {
  name: string;
  /** 参会人 id（字符串）；游客 / 自定义名字为 null。 */
  userId?: string | null;
  /** manual（主持人确认）/ auto（按会中说话时间线预填，可能不准）。 */
  source?: string | null;
}

/** PUT /meetings/{id}/transcript/speakers：人工确认的完整映射（★整体替换，空数组=清空）。 */
export class ImMeetingSetSpeakerNamesRequest {
  /** 不传时服务端作用于该会议最早一份已完成的转写。 */
  transcriptId: string | null = null;
}

/** POST /meetings/speaker-events：会中「我什么时候说了话」批量上报（每 8 秒一批）。 */
export class ImMeetingSpeakerEvent {
  /** 本端 RTC 参与者标识。 */
  rtcUid: string = "";
  /** epoch 毫秒。 */
  beginAt: number = 0;
  endAt: number = 0;
}
