import {MarkdownToken} from '@/uni_modules/uni-cmark'

/** 类型均加 UniAi 前缀，避免与项目 types/interfaces/ai-msg.uts 等在 Android 编译时类名冲突 */

export type UniAiLLMModel = {
	name: string,
	thinking?: boolean,
	webSearch?: boolean,
	image?: boolean,
	video?: boolean,
	audio?: boolean
}

export type UniAiProvider = {
	models: UniAiLLMModel[],
	description?: string,
	baseURL?: string,
	getToken?: () => Promise<string>,
}

export type UniAiDefaultLLM = {
	provider: string,
	model: string
}

export type UniAiLLmTokenInfo = {
	token: string,
	expireTime: number
}

export type UniAiLlm = {
	provider: string
	model: string
	webSearch: boolean
}

export type UniAiChat = {
	datas: UniAiChatItem[],
	activeId: string
}

export type UniAiChatItem = {
	id: string,
	title: string,
	state: string,
	inputContent: string,
	msgList: UniAiMsgItem[],
	update_time: number
}

export type UniAiChunkChoiceDelta = {
	content: string,
	reasoning_content?: string
}
export type UniAiChunkMessage = {
	content: string
}
export type UniAiChunkChoice = {
	delta?: UniAiChunkChoiceDelta
	message?: UniAiChunkMessage
}
type UniAiChunkOutput = {
	text: string
}
export type UniAiChunk = {
	choices?: UniAiChunkChoice[],
	output?: UniAiChunkOutput,
	DONE?: boolean,
}

export type UniAiMarkdownElItem = {
	uniqueId: string,
	type: string,
	datasList: MarkdownToken[][],
	/** markdown-custom-process 标签解析后的属性列表。 */
	customProcessList?: any[],
	/** task-result 标签解析后的任务产物。 */
	taskResultData?: any
}

export type UniAiMsgItem = {
	_id: string
	body: string
	img_url_list?: string[]
	thinkContent?: string
	from_uid: string
	state: number
	create_time: number
	about_msg_id?: string
	chat_id: string,
	markdownElList: UniAiMarkdownElItem[]
	error_msg?: string
	rendered: boolean
}

export type UniAiBaseMsgItem = {
	body: string
	from_uid: string
	about_msg_id?: string
	img_url_list?: string[]
}

export type UniAiMsg = {
	dataList: UniAiMsgItem[],
	hasMore: boolean,
	loading: boolean,
	loadMore: () => void
}

export type UniAiTextParse = {
	type: 'text',
	text: string
}

export type UniAiImageUrl = {
	url: string
}

export type UniAiImgParse = {
	type: 'image_url',
	image_url: UniAiImageUrl
}

export type UniAiMultiModalContent = (UniAiTextParse | UniAiImgParse)[]

export type UniAiRequestAiCoMessage = {
	role : "user" | "assistant"
	content : string | UniAiMultiModalContent
}

export type UniAiUserInfo = {
	_id?: string
	nickname?: string
	avatar_file?: UniAiAvatarFile
}

export type UniAiAvatarFile = {
	url?: string
	file_id?: string
}

export type UniAiTheme =  "auto" | "dark" | "light"

export type UniAiSetting = {
	theme: UniAiTheme
	language: "zh-CN" | "en-US"
	llm: UniAiLlm
}

export type UniAiImgItem = {
	path: string
	name: string
	size: string
	type: string
	uploadPercent: number
}
