import { emptyI18nParams, t } from "@/utils/i18n";
import { isAppInBackground } from "@/utils/appLifecycle.uts";
import {
  canAutoShowPushBackgroundGuide,
  getPushBackgroundStatus,
  isPushBackgroundSetupAcknowledged,
  snoozePushBackgroundGuide,
} from "@/utils/push/pushBackgroundStatus";
import {
  hasImPushPreferenceUser,
  readImPushEnabled,
} from "@/utils/im/imPushPreference";

const GUIDE_DELAY_MS = 6500;
let guideScheduled = false;
let guideVisible = false;

/**
 * 登录后的低打扰引导：晚于现有通知权限流程，且“稍后”后 30 天内不再自动提示。
 * “我的”页手动入口不受该冷却限制。
 */
export function schedulePushBackgroundGuideAfterLogin(): void {
  // #ifndef APP-ANDROID
  return;
  // #endif
  // #ifdef APP-ANDROID
  if (guideScheduled || guideVisible || !canAutoShowPushBackgroundGuide()) return;
  guideScheduled = true;
  setTimeout((): void => {
    guideScheduled = false;
    if (guideVisible || isAppInBackground() || !canAutoShowPushBackgroundGuide()) return;
    // 推送业务开关未绑定或已关闭时不主动打扰。
    if (!hasImPushPreferenceUser() || !readImPushEnabled()) return;
    getPushBackgroundStatus().then((status): void => {
      if (status.vendor != "none" || !status.manualSettingsRequired) return;
      // 用户已在「我的」页确认过设置：不再自动弹出，状态仍如实展示。
      if (isPushBackgroundSetupAcknowledged()) return;
      guideVisible = true;
      uni.showModal({
        title: t("Mobile.PushBackground.guideTitle", emptyI18nParams(), ""),
        content: t(
          "Mobile.PushBackground.guideDescription",
          emptyI18nParams(),
          "",
        ),
        confirmText: t("Mobile.PushBackground.viewSettings", emptyI18nParams(), ""),
        cancelText: t("Mobile.PushBackground.later", emptyI18nParams(), ""),
        success: (res: ShowModalSuccess): void => {
          guideVisible = false;
          if (res.confirm == true) {
            uni.switchTab({ url: "/pages/mine/mine" });
          } else {
            snoozePushBackgroundGuide();
          }
        },
        fail: (): void => {
          guideVisible = false;
        },
      });
    }).catch((_e: any | null): void => {});
  }, GUIDE_DELAY_MS);
  // #endif
}
