<template>
  <view class="search-page-container flex flex-col">
    <!-- 微信/原生安全区 -->
    <safety-zone></safety-zone>
    <!-- 搜索框 -->
    <view class="search-container border-b">
      <!-- #ifdef MP-WEIXIN -->
      <view class="cancel-btn" @click="jumpNavigateBack">
        <text class="cancel-text">{{ t("Mobile.Common.cancel") }}</text>
      </view>
      <!-- #endif -->
      <view class="search-box" :class="{ focused: isFocused }">
        <svg-icon name="icon-Search" />
        <input
          ref="searchInputRef"
          class="search-input"
          :placeholder="t('Mobile.ConversationSearch.placeholder')"
          placeholder-class="placeholder-class"
          type="search"
          confirm-type="search"
          :value="searchKeyword"
          @confirm="onSearchConfirm"
          @input="onSearchInput"
          @focus="handleFocus"
          @blur="handleBlur"
          :auto-focus="shouldAutoFocus"
        />
        <svg-icon
          v-if="searchKeyword.length > 0"
          name="icon-a-Xcircle-fill"
          customClass="clear-icon"
          @click="handleSearch('')"
        />
      </view>
      <!-- #ifndef MP-WEIXIN -->
      <view class="cancel-btn" @click="jumpNavigateBack">
        <text class="cancel-text">{{ t("Mobile.Common.cancel") }}</text>
      </view>
      <!-- #endif -->

      <!-- 微信胶囊按钮功能区 -->
      <!-- #ifdef MP-WEIXIN -->
      <view
        class="right-safety"
        :style="{
          width: clientRect.width + 13 + 'px',
          height: clientRect.height + 'px',
        }"
      ></view>
      <!-- #endif -->
    </view>

    <!-- 滚动列表部分 -->
    <view class="scroll-section flex-1">
      <scroll-view
        class="h-full"
        scroll-y="true"
        @scrolltolower="handleLoadMore"
        :refresher-enabled="true"
        :refresher-triggered="refreshing"
        @refresherrefresh="handleRefresh"
        :show-scrollbar="false"
      >
        <template v-if="convRowList.length > 0">
          <view class="conv-list border-t border-b">
            <view
              v-for="(row, index) in convRowList"
              :key="row.id"
              class="conv-item border-b"
              @click="handleConvClick(index)"
            >
              <view class="conv-item-inner">
                <view class="title-row">
                  <text class="conversation-title">{{ row.topic }}</text>
                  <text class="time-label">{{ row.timeLabel }}</text>
                </view>
                <view class="bottom-row">
                  <text class="agent-name">{{ row.agentName }}</text>
                  <view v-if="row.showExecuting" class="status-tag">
                    <text class="status-text">{{ t("Mobile.Conversation.executing") }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </template>

        <template v-if="loading">
          <view class="loading-state">
            <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
          </view>
        </template>

        <template v-else-if="showEmpty">
          <view class="empty-state">
            <image
              :src="noData"
              class="empty-image"
              :alt="t('Mobile.Common.noDataImageAlt')"
            />
            <text class="empty-text">{{
              t("Mobile.AgentSearch.emptyResult")
            }}</text>
          </view>
        </template>

        <template v-if="showNoMore">
          <view class="no-more-state">
            <text class="no-more-text">{{
              t("Mobile.Common.noMoreData")
            }}</text>
          </view>
        </template>
      </scroll-view>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { apiAgentConversationList } from "@/servers/conversation";
  import { ConversationListParams } from "@/types/interfaces/conversationInfo";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { jumpToAgentDetailPage, isTabPage } from "@/utils/commonBusiness";
  import { formatTimeAgo } from "@/utils/common";
  import noData from "@/static/assets/no_data.png";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system.uts";

  class ConversationRowView {
    id: number = 0;
    topic: string = "";
    timeLabel: string = "";
    agentName: string = "";
    showExecuting: boolean = false;
  }

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const searchKeyword = ref<string>("");
  const searchTimeoutRef = ref<number | null>(null);
  const conversationList = ref<UTSJSONObject[]>([]);
  const lastId = ref<number | null>(null);
  const hasMore = ref<boolean>(true);
  const loading = ref<boolean>(false);
  const refreshing = ref<boolean>(false);
  const searchInputRef = ref<UniInputElement | null>(null);
  const isFocused = ref<boolean>(false);
  const shouldAutoFocus = ref<boolean>(false);
  const backUrl = ref<string>("");

  // #ifdef MP-WEIXIN
  const clientRect = uni.getMenuButtonBoundingClientRect();
  // #endif

  function toNum(v: any | null, fallback: number = 0): number {
    if (v == null) return fallback;
    if (typeof v == "number") {
      const n = v as number;
      return n != n ? fallback : n;
    }
    const parsed = parseFloat(`${v}`);
    return parsed != parsed ? fallback : parsed;
  }

  function toStr(v: any | null, fallback: string = ""): string {
    if (v == null) return fallback;
    return `${v}`;
  }

  function normalizeList(raw: any | null): UTSJSONObject[] {
    const result: UTSJSONObject[] = [];
    if (raw == null) return result;
    let items: any[] = [];
    if (Array.isArray(raw)) {
      items = raw as any[];
    } else {
      try {
        const jsonStr = JSON.stringify(raw);
        if (jsonStr != null && jsonStr.length > 0) {
          const parsed = JSON.parse(jsonStr);
          if (Array.isArray(parsed)) {
            items = parsed as any[];
          }
        }
      } catch (_e) {
        return result;
      }
    }
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      if (item != null) {
        result.push(item as UTSJSONObject);
      }
    }
    return result;
  }

  const convRowList = computed((): ConversationRowView[] => {
    const list: ConversationRowView[] = [];
    const source = conversationList.value;
    for (let i = 0; i < source.length; i++) {
      const item = source[i];
      const id = toNum(item["id"], 0);
      let topic = toStr(item["topic"], "");
      if (topic.length == 0) {
        topic = t("Mobile.Conversation.defaultTopic");
      }
      const updated = toStr(item["updated"], "");
      const created = toStr(item["created"], "");
      const dateStr = updated.length > 0 ? updated : created;
      const ago = formatTimeAgo(dateStr);
      const timeLabel = ago != null ? ago : "";
      let agentName = toStr(item["agentName"], "");
      if (agentName.length == 0) {
        agentName = t("Mobile.Conversation.defaultAgentName");
      }
      const state = toNum(item["state"], 0);

      const row = new ConversationRowView();
      row.id = id;
      row.topic = topic;
      row.timeLabel = timeLabel;
      row.agentName = agentName;
      row.showExecuting = state == 1;
      list.push(row);
    }
    return list;
  });

  const showEmpty = computed((): boolean => {
    if (loading.value) return false;
    if (searchKeyword.value.length == 0) return false;
    return conversationList.value.length == 0;
  });

  const showNoMore = computed((): boolean => {
    if (loading.value) return false;
    if (hasMore.value) return false;
    return conversationList.value.length > 8;
  });

  const jumpNavigateBack = () => {
    let toUrl = "/pages/index/index";
    if (backUrl.value.length > 0) {
      toUrl = backUrl.value;
    }
    if (isTabPage(toUrl)) {
      uni.switchTab({ url: toUrl });
    } else {
      uni.redirectTo({ url: toUrl });
    }
  };

  const fetchConversationList = async (isLoadMore: boolean, keyword: string): Promise<void> => {
    try {
      const params = new ConversationListParams();
      params.agentId = null;
      params.lastId = isLoadMore ? lastId.value : null;
      params.limit = 20;
      params.topic = keyword.length > 0 ? keyword : null;

      const res = await apiAgentConversationList(params);
      if (apiResCode(res) == SUCCESS_CODE) {
        const newList = normalizeList(apiResData<any>(res));
        if (isLoadMore) {
          const combined: UTSJSONObject[] = [];
          const prev = conversationList.value;
          for (let i = 0; i < prev.length; i++) {
            combined.push(prev[i]);
          }
          for (let j = 0; j < newList.length; j++) {
            combined.push(newList[j]);
          }
          conversationList.value = combined;
        } else {
          conversationList.value = newList;
        }

        if (newList.length > 0) {
          const lastItem = newList[newList.length - 1];
          lastId.value = toNum(lastItem["id"], 0);
          hasMore.value = newList.length >= 20;
        } else {
          hasMore.value = false;
        }
      }
    } catch (e) {
      console.error("fetchConversationList error:", e);
    } finally {
      loading.value = false;
    }
  };

  const handleFocus = () => {
    isFocused.value = true;
  };

  const handleBlur = () => {
    isFocused.value = false;
  };

  const handleSearch = (keyword: string) => {
    searchKeyword.value = keyword;
    const timer = searchTimeoutRef.value;
    if (timer != null) {
      clearTimeout(timer);
    }

    if (keyword.length == 0) {
      conversationList.value = [];
      lastId.value = null;
      hasMore.value = false;
      loading.value = false;
      return;
    }

    loading.value = true;
    searchTimeoutRef.value = setTimeout(() => {
      lastId.value = null;
      hasMore.value = true;
      fetchConversationList(false, keyword);
    }, 500);
  };

  const extractEventValue = (e: UniInputEvent): string => {
    if (e == null) return "";
    return e.detail.value;
  };

  const onSearchConfirm = (e: UniInputEvent) => {
    handleSearch(extractEventValue(e));
  };

  const onSearchInput = (e: UniInputEvent) => {
    handleSearch(extractEventValue(e));
  };

  const handleLoadMore = () => {
    if (!hasMore.value || loading.value) return;
    loading.value = true;
    fetchConversationList(true, searchKeyword.value);
  };

  const handleRefresh = () => {
    if (refreshing.value) return;
    refreshing.value = true;
    lastId.value = null;
    fetchConversationList(false, searchKeyword.value).then((): void => {
      refreshing.value = false;
    }).catch((): void => {
      refreshing.value = false;
    });
  };

  const handleConvClick = (index: number) => {
    if (index < 0 || index >= conversationList.value.length) return;
    const item = conversationList.value[index];
    const convId = toNum(item["id"], 0);
    const agentId = toNum(item["agentId"], 0);
    if (convId <= 0 || agentId <= 0) return;
    const typeStr = toStr(item["agentType"], "ChatBot");
    let agentType: "ChatBot" | "PageApp" | "TaskAgent" = "ChatBot";
    if (typeStr == "PageApp") {
      agentType = "PageApp";
    } else if (typeStr == "TaskAgent") {
      agentType = "TaskAgent";
    }
    jumpToAgentDetailPage(agentId, convId, agentType, toStr(item["agentName"], ""));
  };

  onLoad((options: any) => {
    const optObj = options as UTSJSONObject;
    const backUrlRaw = optObj["backUrl"];
    if (backUrlRaw != null) {
      const rawBack = backUrlRaw as string;
      if (rawBack.length > 0) {
        const dec = decodeURIComponent(rawBack);
        if (dec != null) {
          backUrl.value = dec;
        }
      }
    }
    setCurrentPageNavigationBarTitle();
  });

  onMounted(() => {
    // #ifndef MP-WEIXIN
    nextTick(() => {
      const input = searchInputRef.value;
      if (input != null) {
        input.focus();
      }
    });
    // #endif
  });

  onReady(() => {
    // #ifdef MP-WEIXIN
    shouldAutoFocus.value = true;
    // #endif
  });
</script>

<style lang="scss" scoped>
  .search-page-container {
    /* #ifdef H5 */
    height: 100vh;
    /* #endif */
    /* #ifndef H5 */
    height: 100%;
    /* #endif */
    overflow: hidden;
    background-color: #fff;
    /* #ifdef MP-WEIXIN */
    padding-bottom: env(safe-area-inset-bottom);
    /* #endif */

    .search-container {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 10rpx 0 10rpx 32rpx;
      flex-shrink: 0;

      .search-box {
        flex: 1;
        display: flex;
        align-items: center;
        flex-direction: row;
        height: 76rpx;
        padding: 0 24rpx;
        border-radius: 16rpx;
        border: 2rpx solid transparent;
        background: rgba(12, 20, 102, 0.04);
        transition: border-color 0.3s ease;

        &.focused {
          border-color: #5147ff;
        }

        .search-input {
          flex: 1;
          border: none;
          font-size: 28rpx;
          color: #15171f;
          /* #ifndef APP */
          outline: none;
          /* #endif */
          font-weight: 400;
        }

        .placeholder-class {
          color: rgba(21, 23, 31, 0.5);
          font-size: 28rpx;
          font-weight: 400;
        }

        .clear-icon {
          font-size: 32rpx;
          color: #999 !important;
          /* #ifndef APP */
          cursor: pointer;
          /* #endif */
        }
      }

      .cancel-btn {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        height: 76rpx;
        padding: 0 32rpx;
        border-radius: 8rpx;
        transition: background-color 0.3s ease;

        &:active {
          background-color: rgba(12, 20, 102, 0.04);
        }
        /* #ifdef H5 */
        &:hover {
          cursor: pointer;
        }
        /* #endif */
      }

      .cancel-text {
        font-weight: 400;
        color: rgba(21, 23, 31, 0.5);
        font-size: 32rpx;
      }
    }

    .scroll-section {
      flex: 1;
      overflow: hidden;

      .conv-list {
        background-color: #ffffff;
      }

      .conv-item {
        margin: 0;
        padding: 0;
      }

      .conv-item-inner {
        padding: 24rpx 32rpx;
      }

      .title-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12rpx;

        .conversation-title {
          flex: 1;
          font-size: 30rpx;
          font-weight: 600;
          color: #1a1a1a;
          margin-right: 16rpx;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .time-label {
          font-size: 24rpx;
          color: #999999;
          flex-shrink: 0;
        }
      }

      .bottom-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;

        .agent-name {
          font-size: 26rpx;
          color: #666666;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
          flex: 1;
        }

        .status-tag {
          padding: 2rpx 12rpx;
          border-radius: 8rpx;
          background-color: rgba(81, 71, 255, 0.1);
          margin-left: 12rpx;

          .status-text {
            font-size: 20rpx;
            color: #5147ff;
          }
        }
      }

      .empty-state {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 100rpx;

        .empty-image {
          width: 172rpx;
          height: 172rpx;
        }

        .empty-text {
          font-size: 32rpx;
          color: #15171f;
          font-weight: 400;
          margin-top: 32rpx;
        }
      }

      .loading-state {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40rpx;

        .loading-text {
          font-size: 28rpx;
          color: #666;
        }
      }

      .no-more-state {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40rpx;

        .no-more-text {
          font-size: 24rpx;
          color: #999;
        }
      }
    }
  }
</style>
