/**
 * 语音会话模块配置
 * TTS 接口、mock 开关与播放限制集中管理。
 * 后端接口未最终确定，联调时只需修改本文件。
 */
import { API_BASE_URL } from "@/constants/config";

export class VoiceConfig {
  // ==================== 总开关 ====================
  /**
   * 语音会话功能总开关。
   * false 时聊天页不渲染语音会话面板，便于其他同学调试原会话页面。
   * 重新开启语音功能时改回 true 即可。
   */
  enableVoiceConversation: boolean = false;

  // ==================== TTS 语音合成 ====================
  /** TTS 合成接口地址 */
  ttsUrl: string = API_BASE_URL + "/api/audio/tts";
  /** 音色 */
  ttsVoice: string = "default";
  /** 音频格式 */
  ttsFormat: string = "mp3";
  /** 语速 */
  ttsSpeed: number = 1.0;
  /** 请求超时（ms） */
  ttsTimeout: number = 30000;

  // ==================== mock 开关（接口未就绪时使用） ====================
  /** TTS mock 开关：true 时不请求接口，走 mock 流程 */
  ttsMock: boolean = false;
  /**
   * mock 模式下使用的测试音频地址。
   * 为空字符串时播放器自动跳过实际播放，仅跑通"分句→合成→入队→播放状态"流转。
   */
  mockAudioUrl: string = "";

  // ==================== 播放 ====================
  /** 单条消息最大朗读句数（防止异常长文占用过多资源） */
  maxSentencesPerMessage: number = 60;
}

/** 全局默认配置单例（运行期可修改字段） */
export const voiceConfig = new VoiceConfig();
