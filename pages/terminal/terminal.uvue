    margin: 24rpx 24rpx 0;
    overflow: hidden;
  }

  /* 行项 */
  .row-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 28rpx 32rpx;
    border-bottom: 2rpx solid #f5f5f5;

    &:last-child {
      border-bottom-width: 0;
    }

    &-active {
      background-color: rgba(12, 20, 102, 0.04);
    }

    .row-avatar {
      width: 80rpx;
      height: 80rpx;
      border-radius: 16rpx;
      background-color: #fafafa;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 24rpx;

      .row-avatar-emoji {
        font-size: 40rpx;
      }
    }

    .row-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;

      .row-title {
        font-size: 30rpx;
        font-weight: 600;
        color: #1a1a1a;
      }

      .row-desc {
        font-size: 26rpx;
        color: #666666;
        margin-top: 4rpx;
      }
    }

    .row-status {
      display: flex;
      flex-direction: row;
      align-items: center;
      margin-right: 8rpx;

      .status-dot {
        width: 12rpx;
        height: 12rpx;
        border-radius: 50%;
        background-color: #07c160;
        margin-right: 8rpx;

        &.status-dot-off {
          background-color: #c0c0c0;
        }
      }

      .status-text {
        font-size: 24rpx;
        color: #07c160;

        &.status-text-off {
          color: #999999;
        }
      }
    }

    .row-arrow {
      font-size: 40rpx;
      color: #c0c0c0;
      font-weight: 300;
      line-height: 1;
      padding-left: 8rpx;
    }
  }

  /* 离线设备：重新配网按钮 */
  .reprovision-btn {
    padding: 8rpx 20rpx;
    border-radius: 24rpx;
    background-color: rgba(81, 71, 255, 0.1);
    margin-left: 12rpx;

    &-text {
      font-size: 24rpx;
      color: #5147ff;
