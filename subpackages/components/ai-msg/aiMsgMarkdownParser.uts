import type { UniAiMarkdownElItem } from "@/uni_modules/uni-ai-x/types.uts";
import ParseMarkdown from "@/uni_modules/uni-ai-x/sdk/parseMarkdown.uts";
import treeToListSdk from "@/uni_modules/uni-ai-x/sdk/treeToList.uts";
import { MarkdownToken, type ParseMdRes } from "@/uni_modules/uni-cmark/utssdk/interface.uts";
import { md2json } from "@/uni_modules/uni-cmark";
import { MsgItem } from "@/types/interfaces/ai-msg";
import { parseAppMarkdownFallback } from "@/subpackages/components/ai-msg/appMarkdownFallback.uts";
import { expandMarkdownImageItems } from "@/subpackages/components/ai-msg/markdownImage.uts";

/** 从自定义工具标签属性中读取字符串。 */
function extractCustomProcessAttribute(
  attributes: string,
  name: string,
): string {
  let regex = new RegExp(`${name}="([^"]*)"`, "i");
  let match = attributes.match(regex);
  if (match != null && match.length > 1) {
    const value = match[1];
    return value != null ? value.replace(/&quot;/g, '"') : "";
  }
  regex = new RegExp(`${name}='([^']*)'`, "i");
  match = attributes.match(regex);
  if (match != null && match.length > 1) {
    const value = match[1];
    return value != null ? value.replace(/&quot;/g, '"') : "";
  }
  return "";
}

/** 解析 html token 中的 markdown-custom-process 标签。 */
function parseCustomProcessList(source: string): any[] {
  const result: any[] = [];
  if (source.indexOf("<markdown-custom-process") < 0) {
    return result;
  }
  const regex =
    /<markdown-custom-process(?!-group)\b([^>]*)>(?:<\/markdown-custom-process>)?|<markdown-custom-process(?!-group)\b([^>]*?)\/>/gi;
  let match = regex.exec(source);
  while (match != null) {
    const firstAttrs = match.length > 1 ? match[1] : null;
    const secondAttrs = match.length > 2 ? match[2] : null;
    const attributes =
      firstAttrs != null && firstAttrs.length > 0
        ? firstAttrs
        : secondAttrs != null
          ? secondAttrs
          : "";
    const item = new UTSJSONObject();
    let executeId = extractCustomProcessAttribute(attributes, "executeId");
    if (executeId.length == 0) {
      executeId = extractCustomProcessAttribute(attributes, "executeid");
    }
    item["executeId"] = executeId;
    item["type"] = extractCustomProcessAttribute(attributes, "type");
    item["status"] = extractCustomProcessAttribute(attributes, "status");
    item["name"] = extractCustomProcessAttribute(attributes, "name");
    result.push(item);
    match = regex.exec(source);
  }
  return result;
}

/**
 * 递归提取 App 原生 uni-cmark token 树中的工具标签。
 * H5 通常返回顶层 html token，Android/iOS 可能将 HTML 放在 paragraph 子 token。
 */
function collectTokenSource(token: MarkdownToken): string {
  const raw = token.raw != null ? token.raw! : "";
  const text = token.text != null ? token.text! : "";
  const direct = raw.length > 0 ? raw : text;
  if (direct.length > 0) {
    return direct;
  }

  const children =
    token.tokens != null
      ? token.tokens!
      : token.items != null
        ? token.items!
        : [] as MarkdownToken[];
  if (children.length == 0) {
    return "";
  }

  const fragments = [] as string[];
  for (let i = 0; i < children.length; i++) {
    const fragment = collectTokenSource(children[i]);
    if (fragment.length > 0) {
      fragments.push(fragment);
    }
  }
  return fragments.join("\n");
}

/** 递归收集包含指定自定义标签的完整 token 文本。 */
function collectMarkupSource(token: MarkdownToken, marker: string): string {
  const source = collectTokenSource(token);
  return source.indexOf(marker) >= 0 ? source : "";
}

/** 解析 task-result 中的描述与文件名。 */
function parseTaskResultData(source: string): UTSJSONObject | null {
  const taskMatch = source.match(
    /<task-result\b[^>]*>([\s\S]*?)<\/task-result>/i,
  );
  if (taskMatch == null || taskMatch.length < 2 || taskMatch[1] == null) {
    return null;
  }
  const content = taskMatch[1]!;
  const descriptionMatch = content.match(
    /<description\b[^>]*>([\s\S]*?)<\/description>/i,
  );
  const fileMatch = content.match(
    /<file\b[^>]*>([\s\S]*?)<\/file>/i,
  );
  const data = new UTSJSONObject();
  data["description"] =
    descriptionMatch != null &&
    descriptionMatch.length > 1 &&
    descriptionMatch[1] != null
      ? descriptionMatch[1]!.trim()
      : "";
  data["file"] =
    fileMatch != null && fileMatch.length > 1 && fileMatch[1] != null
      ? fileMatch[1]!.trim()
      : "";
  return data;
}

function token2el(token: MarkdownToken): UniAiMarkdownElItem {
  const taskResultSource = collectMarkupSource(token, "<task-result");
  const taskResultData = parseTaskResultData(taskResultSource);
  if (taskResultData != null) {
    return {
      uniqueId: token.uniqueId!,
      type: "task_result",
      datasList: [] as MarkdownToken[][],
      taskResultData,
    };
  }

  const source = collectMarkupSource(token, "<markdown-custom-process");
  const customProcessList = parseCustomProcessList(source);
  if (customProcessList.length > 0) {
    const isGroup =
      source.indexOf("<markdown-custom-process-group") >= 0 ||
      customProcessList.length > 1;
    return {
      uniqueId: token.uniqueId!,
      type: isGroup
        ? "markdown_custom_process_group"
        : "markdown_custom_process",
      datasList: [] as MarkdownToken[][],
      customProcessList: customProcessList,
    };
  }
  return {
    uniqueId: token.uniqueId!,
    type: token.type!,
    datasList: treeToListSdk.markTreeToList(token),
  };
}

/** 打开后可在调试时查看 Markdown 解析细节；默认关闭避免热路径刷屏。 */
const MD_RENDER_DEBUG = false;

function mdRenderLog(tag: string, detail: string = ""): void {
  if (!MD_RENDER_DEBUG) {
    return;
  }
  if (detail.length > 0) {
    console.log(tag, detail);
  } else {
    console.log(tag);
  }
}

/**
 * 历史/SSE 消息 markdown 解析（从 ai-msg.uvue 抽出，避免 UTS 大 setup 编译失败）
 */
export class AiMsgMarkdownParser {
  cmarkParseEnabled: boolean = true;
  private msg: Ref<MsgItem>;
  private streamRevision: Ref<number>;
  private getBodyText: () => string;
  private getIsConversationActive: () => boolean;
  private getIsLastMsg: () => boolean;
  private parseMarkdown: ParseMarkdown | null = null;
  /** 递增后忽略旧 ParseMarkdown 回调，避免增量打字机覆盖 fallback 结果 */
  private parseGeneration: number = 0;
  private cmarkProbeDone: boolean = false;
  private cmarkProbeOk: boolean = true;
  private lastFallbackBody: string = "";
  /** 已完成消息的正文快照，用于跳过父级重渲染触发的重复解析。 */
  private lastFinishedBody: string = "";

  constructor(
    msg: Ref<MsgItem>,
    streamRevision: Ref<number>,
    getBodyText: () => string,
    getIsConversationActive: () => boolean,
    getIsLastMsg: () => boolean,
  ) {
    this.msg = msg;
    this.streamRevision = streamRevision;
    this.getBodyText = getBodyText;
    this.getIsConversationActive = getIsConversationActive;
    this.getIsLastMsg = getIsLastMsg;
  }

  resolveRenderList(): UniAiMarkdownElItem[] {
    const parsed = this.msg.value.markdownElList;
    if (parsed != null && parsed.length > 0) {
      return parsed;
    }
    return [] as UniAiMarkdownElItem[];
  }

  resetForNewMessage(): void {
    this.abortIncrementalParse();
    this.cmarkParseEnabled = true;
    this.cmarkProbeDone = false;
    this.cmarkProbeOk = true;
    this.lastFallbackBody = "";
    this.lastFinishedBody = "";
    this.parseMarkdown = this.createParseMarkdown();
  }

  /**
   * 中止 uni-cmark 增量打字机。
   * 正文一旦出现 :::container / 工具标签会切到 App fallback；
   * 若不中止，旧 runTask 的延迟回调会用半截正文覆盖已渲染列表（H5 表现为卡在「好的…7月30」）。
   */
  private abortIncrementalParse(): void {
    this.parseGeneration = this.parseGeneration + 1;
    const pm = this.parseMarkdown;
    if (pm != null) {
      pm.abort();
    }
  }

  private bumpRevision(): void {
    this.streamRevision.value = this.streamRevision.value + 1;
  }

  /** 正文是否包含需由 App fallback 识别的自定义标签（cmark 无法可靠产出）。 */
  private hasCustomMarkup(body: string): boolean {
    return (
      body.indexOf("markdown-custom-process") >= 0 ||
      body.indexOf(":::container") >= 0 ||
      body.indexOf("<task-result") >= 0 ||
      body.indexOf("<conversation") >= 0
    );
  }

  /**
   * App：结构块优先走 fallback（与 code 对齐）。
   * 判定尽量收窄，避免普通正文里的单个 `|` / `$100` 误触发：
   * - code：```
   * - 图片：![
   * - 块级公式：$$ / \[ / \(
   * - 表格：同时出现 | 与对齐分隔（---|:-- 等）
   */
  private prefersAppStructuralFallback(body: string): boolean {
    if (body.indexOf("```") >= 0) {
      return true;
    }
    if (body.indexOf("![") >= 0) {
      return true;
    }
    if (body.indexOf("$$") >= 0) {
      return true;
    }
    if (body.indexOf("\\[") >= 0 || body.indexOf("\\(") >= 0) {
      return true;
    }
    // 表格：需要管道 + 分隔行特征，避免「A | B」普通句子误入
    if (body.indexOf("|") >= 0) {
      if (
        body.indexOf("---") >= 0 ||
        body.indexOf(":--") >= 0 ||
        body.indexOf("--:") >= 0 ||
        body.indexOf(":-:") >= 0
      ) {
        return true;
      }
    }
    return false;
  }

  /** 当前渲染列表是否已包含自定义组件元素。 */
  private renderListHasCustomEl(): boolean {
    const list = this.msg.value.markdownElList;
    for (let i = 0; i < list.length; i++) {
      const type = list[i].type;
      if (
        type == "markdown_custom_process" ||
        type == "markdown_custom_process_group" ||
        type == "task_result"
      ) {
        return true;
      }
      const datasList = list[i].datasList;
      for (let rowIndex = 0; rowIndex < datasList.length; rowIndex++) {
        const row = datasList[rowIndex];
        for (let tokenIndex = 0; tokenIndex < row.length; tokenIndex++) {
          if (row[tokenIndex].className == "conversation-link") {
            return true;
          }
        }
      }
    }
    return false;
  }

  /** fallback 结果是否已含结构组件（code/math/table/image）。 */
  private renderListHasStructuralEl(): boolean {
    const list = this.msg.value.markdownElList;
    for (let i = 0; i < list.length; i++) {
      const type = list[i].type;
      if (
        type == "code_block" ||
        type == "math" ||
        type == "table" ||
        type == "markdown_image" ||
        type == "image"
      ) {
        return true;
      }
    }
    return false;
  }

  private applyAppFallback(): void {
    const body = this.getBodyText();
    if (body.length == 0) {
      return;
    }
    const needsCustom = this.hasCustomMarkup(body);
    const needsStructural = this.prefersAppStructuralFallback(body);
    if (
      body == this.lastFallbackBody &&
      this.msg.value.markdownElList.length > 0
    ) {
      const customOk =
        needsCustom != true || this.renderListHasCustomEl() == true;
      const structuralOk =
        needsStructural != true || this.renderListHasStructuralEl() == true;
      if (customOk == true && structuralOk == true) {
        return;
      }
    }
    // 进入 fallback 前必须掐掉 cmark 打字机，否则延迟回调会覆盖本结果
    this.abortIncrementalParse();
    this.parseMarkdown = null;
    this.lastFallbackBody = body;
    if (body.indexOf("|") >= 0) {
      mdRenderLog(
        "[MdRender] fallback table source msgId=" +
          this.msg.value._id +
          " body=" +
          body.replace(/\n/g, "\\n"),
      );
    }
    this.msg.value.markdownElList = expandMarkdownImageItems(
      parseAppMarkdownFallback(
        body,
        (): void => {
          // KaTeX 回调修改的是原始 token；替换外层数组以通知 Vue 子组件刷新 href。
          this.msg.value.markdownElList =
            this.msg.value.markdownElList.slice();
          this.bumpRevision();
        },
      ),
    );
    this.msg.value.rendered = true;
    this.lastFinishedBody = body;
    this.bumpRevision();
  }

  private applyMarkdownTokenList(markdownTokenList: MarkdownToken[]): void {
    if (markdownTokenList.length == 0) {
      mdRenderLog(
        "[MdRender] applyMarkdownTokenList.skip",
        `msgId=${this.msg.value._id} empty tokens`,
      );
      return;
    }
    const mapped = markdownTokenList.map((token: MarkdownToken) =>
      token2el(token),
    );
    this.msg.value.markdownElList = expandMarkdownImageItems(mapped);
    mdRenderLog(
      "[MdRender] applyMarkdownTokenList",
      `msgId=${this.msg.value._id} bodyLen=${this.getBodyText().length} elCount=${this.msg.value.markdownElList.length}`,
    );
  }

  private parseFullBodyMarkdown(body: string): boolean {
    if (body.length == 0) {
      return false;
    }
    try {
      let tokens = [] as MarkdownToken[];
      // #ifdef APP-IOS
      const jsonString = md2json(body) as string;
      if (jsonString.length == 0) {
        return false;
      }
      tokens = JSON.parseArray<MarkdownToken>(jsonString) as MarkdownToken[];
      // #endif
      // #ifndef APP-IOS
      const parseRes = md2json(body) as ParseMdRes;
      if (parseRes.errorMsg.length > 0) {
        mdRenderLog(
          "[MdRender] parseFullBodyMarkdown.errorMsg",
          `msgId=${this.msg.value._id} err=${parseRes.errorMsg}`,
        );
        return false;
      }
      tokens = parseRes.data;
      // #endif
      if (tokens.length == 0) {
        return false;
      }
      this.applyMarkdownTokenList(tokens);
      return true;
    } catch (e) {
      mdRenderLog(
        "[MdRender] parseFullBodyMarkdown.exception",
        `msgId=${this.msg.value._id} err=${e}`,
      );
      return false;
    }
  }

  private ensureCmarkAvailable(): boolean {
    if (this.cmarkProbeDone) {
      return this.cmarkProbeOk;
    }
    this.cmarkProbeDone = true;
    try {
      // #ifdef APP-IOS
      const jsonString = md2json("#") as string;
      this.cmarkProbeOk = jsonString.length > 0;
      // #endif
      // #ifndef APP-IOS
      const probeRes = md2json("#") as ParseMdRes;
      this.cmarkProbeOk = probeRes.errorMsg.length == 0;
      if (!this.cmarkProbeOk) {
        mdRenderLog(
          "[MdRender] ensureCmark.probeError",
          `errorMsg=${probeRes.errorMsg}`,
        );
      }
      // #endif
    } catch (e) {
      this.cmarkProbeOk = false;
      mdRenderLog("[MdRender] ensureCmark.probeException", `err=${e}`);
    }
    if (!this.cmarkProbeOk) {
      this.cmarkParseEnabled = false;
    }
    mdRenderLog(
      "[MdRender] ensureCmark.probe",
      `ok=${this.cmarkProbeOk} cmarkParseEnabled=${this.cmarkParseEnabled}`,
    );
    return this.cmarkProbeOk;
  }

  private createParseMarkdown(): ParseMarkdown {
    const gen = this.parseGeneration;
    return new ParseMarkdown((markdownTokenList: MarkdownToken[], isParseDone: boolean) => {
      // 已切换到 fallback / 新消息：忽略过期打字机回调
      if (gen != this.parseGeneration) {
        return;
      }
      this.applyMarkdownTokenList(markdownTokenList);
      if (isParseDone) {
        this.msg.value.rendered = true;
        const body = this.getBodyText();
        this.lastFinishedBody = body;
        if (markdownTokenList.length == 0 && body.trim().length > 0) {
          if (!this.parseFullBodyMarkdown(body)) {
            this.cmarkParseEnabled = false;
            this.applyAppFallback();
            mdRenderLog(
              "[MdRender] ParseMarkdown.disableCmark",
              `msgId=${this.msg.value._id} app markdown fallback`,
            );
          }
        }
      }
      this.bumpRevision();
    });
  }

  runMarkdownParse(forceDone: boolean = false): void {
    const msgId = this.msg.value._id;
    const body = this.getBodyText();
    const streamFinished =
      forceDone ||
      !this.getIsConversationActive() ||
      !this.getIsLastMsg() ||
      this.msg.value.state === 3;
    const needsCustomFallback = this.hasCustomMarkup(body);

    // 历史/已完成消息：正文未变且已有渲染结果时跳过。
    // 含 Plan/工具标签时，必须已解析出对应 el，否则不能跳过。
    // 注意：勿在 lastFinishedBody 为空时仅凭 rendered 直接 return ——
    // 中间段 CHAT finished 会把 state 置 Complete，此时 token 可能仍是
    // 「未剥离图片语法」的旧结果，跳过会导致原文与 <image> 双显。
    if (
      streamFinished &&
      body.length > 0 &&
      this.msg.value.markdownElList.length > 0
    ) {
      if (needsCustomFallback && !this.renderListHasCustomEl()) {
        // 继续走下方 fallback
      } else if (
        this.lastFinishedBody.length > 0 &&
        body == this.lastFinishedBody
      ) {
        return;
      }
    }

    mdRenderLog(
      "[MdRender] runMarkdownParse.enter",
      `msgId=${msgId} bodyLen=${body.length} forceDone=${forceDone}`,
    );

    // Plan / ToolCall / task-result：与 dev 的 mp-html 自定义节点等价，须走 App fallback。
    // uni-cmark 不会产出 markdown_custom_process，会把标签泄漏为正文。
    // 一旦出现自定义标记，立即中止 cmark 增量打字机，避免半截正文覆盖 UI。
    if (needsCustomFallback) {
      this.applyAppFallback();
      if (streamFinished) {
        this.lastFinishedBody = body;
      }
      return;
    }

    // App：code / 公式 / 表格 / 图片优先 fallback。
    // 标准基座 uni-cmark 流式常把结构块打成 paragraph；fallback 已支持这些类型。
    // 判定收窄（见 prefersAppStructuralFallback），避免普通 `|` / `$100` 误伤。
    // #ifdef APP
    if (this.prefersAppStructuralFallback(body) == true) {
      this.applyAppFallback();
      if (streamFinished) {
        this.lastFinishedBody = body;
      }
      return;
    }
    // #endif

    if (!this.cmarkParseEnabled) {
      mdRenderLog(
        "[MdRender] runMarkdownParse.skip",
        `cmarkParseEnabled=false msgId=${msgId} bodyLen=${body.length}`,
      );
      this.applyAppFallback();
      return;
    }
    if (!this.ensureCmarkAvailable()) {
      mdRenderLog(
        "[MdRender] runMarkdownParse.cmarkUnavailable",
        `msgId=${msgId} bodyLen=${body.length}`,
      );
      this.applyAppFallback();
      return;
    }

    if (this.parseMarkdown == null) {
      this.parseMarkdown = this.createParseMarkdown();
    }
    // strip 掉已闭合图片后正文会变短；官方 ParseMarkdown 对缩短直接 return，
    // 会残留流式阶段写入的 `![alt](url)` 文本 token，必须重建解析器。
    const pm = this.parseMarkdown!;
    if (body.length < pm.oldMsgBodyLength) {
      mdRenderLog(
        "[MdRender] runMarkdownParse.bodyShrunk",
        `msgId=${msgId} bodyLen=${body.length} oldLen=${pm.oldMsgBodyLength}`,
      );
      this.abortIncrementalParse();
      this.parseMarkdown = this.createParseMarkdown();
      this.msg.value.markdownElList = [] as UniAiMarkdownElItem[];
      this.lastFinishedBody = "";
      this.lastFallbackBody = "";
    }
    this.parseMarkdown!.msgReceiveDone = streamFinished;
    if (body.length > 0) {
      mdRenderLog(
        "[MdRender] runMarkdownParse.incremental",
        `msgId=${msgId} bodyLen=${body.length} streamFinished=${streamFinished}`,
      );
      this.parseMarkdown!.runTask(body);
      if (streamFinished) {
        this.lastFinishedBody = body;
      }
    }
  }
}
