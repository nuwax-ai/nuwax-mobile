/** 资料库数据场景：最近访问、全库搜索或指定空间。 */
export type KnowledgeListSourceType = "recent" | "search" | "space";

/** default 为完整资料行，simple 为紧凑单行。 */
export type KnowledgeListVariant = "default" | "simple";

/** KnowledgeListView 对外统一条目。 */
export class KnowledgeListItem {
  key: string = "";
  rawId: number = 0;
  slugId: string = "";
  name: string = "";
  pageType: string = "";
  fileType: string = "";
  usedTime: string = "";
}

/** 已选资料库文档（输入框胶囊回显 + 随消息发送，字段对齐 PC 端 selectedDocs） */
export class SelectedDocInfo {
  slugId: string = "";
  title: string = "";
  pageType: string = "";
}
