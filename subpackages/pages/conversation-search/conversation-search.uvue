<template>
  <view class="search-page-container flex flex-col">
    <safety-zone></safety-zone>
    <view class="search-container border-b">
      <!-- #ifdef MP-WEIXIN -->
      <view class="cancel-btn" @click="jumpNavigateBack"><text class="cancel-text">{{ t("Mobile.Common.cancel") }}</text></view>
      <!-- #endif -->
      <view class="search-box" :class="{ focused: isFocused }">
        <svg-icon name="icon-Search" />
        <input ref="searchInputRef" class="search-input" :placeholder="t('Mobile.ConversationSearch.globalPlaceholder')"
          placeholder-class="placeholder-class" type="search" confirm-type="search" :value="searchKeyword"
          @confirm="onSearchConfirm" @input="onSearchInput" @focus="handleFocus" @blur="handleBlur"
          :auto-focus="shouldAutoFocus" />
        <svg-icon v-if="searchKeyword.length > 0" name="icon-a-Xcircle-fill" customClass="clear-icon" @click="handleSearch('')" />
      </view>
      <!-- #ifndef MP-WEIXIN -->
      <view class="cancel-btn" @click="jumpNavigateBack"><text class="cancel-text">{{ t("Mobile.Common.cancel") }}</text></view>
      <!-- #endif -->
      <!-- #ifdef MP-WEIXIN -->
      <view class="right-safety" :style="{ width: clientRect.width + 13 + 'px', height: clientRect.height + 'px' }"></view>
      <!-- #endif -->
    </view>

    <view class="tab-bar">
      <scroll-view class="tab-scroll" direction="horizontal" :show-scrollbar="false">
        <view class="tab-bar-inner">
          <view v-for="tab in searchTabs" :key="tab.key" class="tab-item"
            :class="{ 'tab-item-active': tab.key == activeTab }" @click="handleTabClick(tab.key)">
            <text class="tab-item-text" :class="{ 'tab-item-text-active': tab.key == activeTab }">{{ t(tab.labelKey) }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="scroll-section flex-1">
      <!-- tab 内容一律「首次访问才挂载 + v-show 切换」：v-if 会销毁组件实例丢掉已加载数据，
           切回该 tab 时重新走 loading（对齐 drawer 任务区同款约定，见 project-task-drawer 注释）。 -->
      <skill-list-view v-if="tabMounted('skill')" v-show="activeTab == 'skill'" type="search" variant="simple" :keyword="searchKeyword" @select="handleSkillSelect" />
      <expert-list-view v-if="tabMounted('expert')" v-show="activeTab == 'expert'" type="search" variant="simple" :keyword="searchKeyword" @select="handleExpertSelect" />
      <connector-list-view v-if="tabMounted('connector')" v-show="activeTab == 'connector'" type="search" variant="default" :keyword="searchKeyword" />
      <knowledge-list-view v-if="tabMounted('repo')" v-show="activeTab == 'repo'" type="search" variant="simple" :keyword="searchKeyword" @select="handleKnowledgeSelect" />
      <scroll-view v-if="tabMounted('task') || tabMounted('project')" v-show="activeTab == 'task' || activeTab == 'project'" class="result-scroll" scroll-y="true" @scrolltolower="handleLoadMore"
        :refresher-enabled="true" :refresher-triggered="refreshing" @refresherrefresh="handleRefresh" :show-scrollbar="false">
        <view v-if="activeTab == 'task' && convRowList.length > 0" class="result-list">
          <view v-for="(row, index) in convRowList" :key="row.id" class="result-row" @click="handleConvClick(index)">
            <view class="result-icon result-icon-task">
              <svg-icon v-if="row.taskStatus == 'EXECUTING'" name="icon-Loader" customClass="result-status-running" color="#5147ff" />
              <svg-icon v-else-if="row.taskStatus == 'FAILED'" name="icon-waring" color="#e54d4d" />
              <svg-icon v-else name="icon-a-Filetext" color="#5147ff" />
            </view>
            <view class="result-main">
              <text class="result-title">{{ row.topic }}</text>
              <text class="result-meta">{{ rowMeta("Mobile.ConversationSearch.tabTask", row.timeLabel) }}</text>
            </view>
          </view>
        </view>

        <view v-else-if="activeTab == 'project' && projectList.length > 0" class="result-list">
          <view v-for="(project, index) in projectList" :key="project.id" class="result-row" @click="handleProjectClick(index)">
            <view class="result-icon result-icon-project">
              <image :src="folderOpenIcon" class="result-folder-icon" mode="aspectFit" />
            </view>
            <view class="result-main">
              <view class="result-title-line">
                <image v-if="project.pinned" :src="pinIcon" class="result-pin-icon" mode="aspectFit" />
                <image v-if="project.owner == false" :src="teamIcon" class="result-team-icon" mode="aspectFit" />
                <text class="result-title">{{ project.name }}</text>
              </view>
              <text class="result-meta">{{ t("Mobile.ConversationSearch.tabProject") }}</text>
            </view>
          </view>
        </view>

        <view v-if="activeLoading" class="loading-state"><text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text></view>
        <view v-else-if="showEmpty" class="empty-state">
          <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
          <text class="empty-text">{{ emptyText }}</text>
        </view>
        <view v-if="showNoMore" class="no-more-state"><text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text></view>
      </scroll-view>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import SkillListView from "@/components/skill-list-view/skill-list-view.uvue";
  import ExpertListView from "@/components/expert-list-view/expert-list-view.uvue";
  import ConnectorListView from "@/components/connector-list-view/connector-list-view.uvue";
  import KnowledgeListView from "@/components/knowledge-list-view/knowledge-list-view.uvue";
  import { apiAgentConversationList } from "@/servers/conversation";
  import { apiUserProjectTabPageQuery } from "@/servers/project";
  import { ConversationListParams } from "@/types/interfaces/conversationInfo";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { jumpToAgentDetailPage, isTabPage, addTicketAndJumpToWebview } from "@/utils/commonBusiness";
  // #ifdef APP-IOS
  import { navigateBackByBackUrl } from "@/utils/commonBusiness";
  import { onBackPress } from "@dcloudio/uni-app";
  // #endif
  import { formatTimeAgo } from "@/utils/common";
  import { PROJECT_PAGE_SIZE, ProjectGroupView, appendProjectGroupsDedup, computeProjectHasMore,
    mapProjectTabResponse, mapProjectTotalPages } from "@/utils/projectGroupProjection";
  import noData from "@/static/assets/no_data.png";
  import folderOpenIcon from "@/static/icons/folder-open.svg";
  import pinIcon from "@/static/icons/pin.svg";
  import teamIcon from "@/static/icons/team.svg";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system.uts";

  const GLOBAL_SEARCH_SELECTION_EVENT = "NuwaxGlobalSearchSelection";

  class ConversationRowView {
    id: number = 0;
    topic: string = "";
    timeLabel: string = "";
    taskStatus: string = "";
  }
  class SearchTabConfig { key: string = ""; labelKey: string = ""; }
  function createSearchTab(key: string, labelKey: string): SearchTabConfig {
    const tab = new SearchTabConfig(); tab.key = key; tab.labelKey = labelKey; return tab;
  }

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
  const searchTabs = [
    createSearchTab("task", "Mobile.ConversationSearch.tabTask"),
    createSearchTab("project", "Mobile.ConversationSearch.tabProject"),
    createSearchTab("expert", "Mobile.ConversationSearch.tabExpert"),
    createSearchTab("skill", "Mobile.ConversationSearch.tabSkill"),
    createSearchTab("connector", "Mobile.ConversationSearch.tabConnector"),
    createSearchTab("repo", "Mobile.ConversationSearch.tabRepo"),
  ] as SearchTabConfig[];

  const activeTab = ref<string>("task");
  // 已访问过的 tab：只有访问过才挂载对应内容（避免一进页面把 6 个 tab 的请求全打一遍），
  // 挂载后靠 v-show 常驻，切回时直接显示已加载数据而不是重新 loading。
  const visitedTabs = ref<string[]>(["task"] as string[]);
  function tabMounted(key: string): boolean {
    return visitedTabs.value.indexOf(key) >= 0;
  }
  function markTabVisited(key: string): void {
    if (visitedTabs.value.indexOf(key) >= 0) return;
    const next = [] as string[];
    for (let i = 0; i < visitedTabs.value.length; i++) next.push(visitedTabs.value[i]);
    next.push(key);
    visitedTabs.value = next;
  }
  const searchKeyword = ref<string>("");
  const searchTimeoutRef = ref<number | null>(null);
  const conversationList = ref<UTSJSONObject[]>([] as UTSJSONObject[]);
  const lastId = ref<number | null>(null);
  const taskHasMore = ref<boolean>(true);
  const taskLoading = ref<boolean>(false);
  const projectList = ref<ProjectGroupView[]>([] as ProjectGroupView[]);
  const projectPage = ref<number>(0);
  const projectHasMore = ref<boolean>(true);
  const projectLoading = ref<boolean>(false);
  const refreshing = ref<boolean>(false);
  const searchInputRef = ref<UniInputElement | null>(null);
  const isFocused = ref<boolean>(false);
  const shouldAutoFocus = ref<boolean>(false);
  const backUrl = ref<string>("");
  let taskRequestId = 0;
  let projectRequestId = 0;
  // 各 tab 已拉取数据对应的关键词：切 tab 时用来判断能否直接复用，避免展示过期结果
  let taskKeyword = "";
  let projectKeyword = "";

  // #ifdef MP-WEIXIN
  const clientRect = uni.getMenuButtonBoundingClientRect();
  // #endif

  function toNum(v: any | null, fallback: number = 0): number {
    if (v == null) return fallback;
    if (typeof v == "number") { const n = v as number; return n != n ? fallback : n; }
    const parsed = parseFloat(`${v}`); return parsed != parsed ? fallback : parsed;
  }
  function toStr(v: any | null, fallback: string = ""): string { return v == null ? fallback : `${v}`; }
  function formatTimeLabel(targetTime: string): string {
    const ago = formatTimeAgo(targetTime);
    return ago != null ? ago : "";
  }

  function normalizeList(raw: any | null): UTSJSONObject[] {
    const result = [] as UTSJSONObject[];
    if (raw == null) return result;
    let items = [] as any[];
    if (Array.isArray(raw)) items = raw as any[];
    else {
      try {
        const jsonStr = JSON.stringify(raw);
        if (jsonStr != null && jsonStr.length > 0) {
          const parsed = JSON.parse(jsonStr); if (Array.isArray(parsed)) items = parsed as any[];
        }
      } catch (_error) { return result; }
    }
    for (let i = 0; i < items.length; i++) if (items[i] != null) result.push(items[i] as UTSJSONObject);
    return result;
  }

  function appendConversationDedup(base: UTSJSONObject[], incoming: UTSJSONObject[]): UTSJSONObject[] {
    const result = [] as UTSJSONObject[];
    for (let i = 0; i < base.length; i++) result.push(base[i]);
    for (let i = 0; i < incoming.length; i++) {
      const nextId = toNum(incoming[i]["id"], 0);
      let duplicate = false;
      for (let j = 0; j < result.length; j++) {
        if (toNum(result[j]["id"], 0) == nextId) { duplicate = true; break; }
      }
      if (duplicate != true) result.push(incoming[i]);
    }
    return result;
  }

  const convRowList = computed((): ConversationRowView[] => {
    const list = [] as ConversationRowView[];
    for (let i = 0; i < conversationList.value.length; i++) {
      const item = conversationList.value[i];
      const row = new ConversationRowView();
      row.id = toNum(item["id"], 0);
      row.topic = toStr(item["topic"], "");
      if (row.topic.length == 0) row.topic = t("Mobile.Conversation.unnamed");
      const updated = toStr(item["updated"], "");
      const created = toStr(item["created"], "");
      const ago = formatTimeAgo(updated.length > 0 ? updated : created);
      row.timeLabel = ago != null ? ago : "";
      row.taskStatus = toStr(item["taskStatus"], "");
      list.push(row);
    }
    return list;
  });
  const activeLoading = computed((): boolean => activeTab.value == "task" ? taskLoading.value : projectLoading.value);
  const activeResultCount = computed((): number => activeTab.value == "task" ? conversationList.value.length : projectList.value.length);
  const activeHasMore = computed((): boolean => activeTab.value == "task" ? taskHasMore.value : projectHasMore.value);
  const showEmpty = computed((): boolean => activeLoading.value != true && activeResultCount.value == 0);
  const emptyText = computed((): string => searchKeyword.value.length > 0 ? t("Mobile.AgentSearch.emptyResult") : t("Mobile.Common.noData"));
  const showNoMore = computed((): boolean => activeLoading.value != true && activeHasMore.value != true && activeResultCount.value > 8);
  function rowMeta(labelKey: string, timeLabel: string): string {
    const label = t(labelKey); return timeLabel.length > 0 ? `${label} · ${timeLabel}` : label;
  }

  // #ifdef APP-IOS
  const jumpNavigateBack = () => {
    let toUrl = backUrl.value.length > 0 ? backUrl.value : "/pages/index/index";
    if (backUrl.value.length == 0) {
      try { const cached = uni.getStorageSync("NUWAX_CONV_SEARCH_BACK_URL"); if (cached != null && `${cached}`.length > 0) toUrl = `${cached}`; } catch (_error) {}
    }
    try { uni.removeStorageSync("NUWAX_CONV_SEARCH_BACK_URL"); } catch (_error) {}
    navigateBackByBackUrl(toUrl);
  };
  onBackPress((_options: OnBackPressOptions): boolean => { jumpNavigateBack(); return true; });
  // #endif
  // #ifndef APP-IOS
  const jumpNavigateBack = () => {
    const toUrl = backUrl.value.length > 0 ? backUrl.value : "/pages/index/index";
    if (isTabPage(toUrl)) uni.switchTab({ url: toUrl }); else uni.redirectTo({ url: toUrl });
  };
  // #endif

  async function fetchConversationList(isLoadMore: boolean, keyword: string): Promise<void> {
    const requestId = taskRequestId + 1; taskRequestId = requestId; taskLoading.value = true;
    try {
      const params = new ConversationListParams();
      params.agentId = null; params.lastId = isLoadMore ? lastId.value : null; params.limit = 20;
      params.topic = keyword.length > 0 ? keyword : null; params.projectFilter = "exclude";
      const res = await apiAgentConversationList(params);
      if (requestId != taskRequestId) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const next = normalizeList(apiResData<any>(res));
        conversationList.value = isLoadMore ? appendConversationDedup(conversationList.value, next) : next;
        if (next.length > 0) { lastId.value = toNum(next[next.length - 1]["id"], 0); taskHasMore.value = next.length >= 20; }
        else taskHasMore.value = false;
        taskKeyword = keyword;
      }
    } catch (error) { console.error("fetchConversationList error:", error); }
    finally { if (requestId == taskRequestId) taskLoading.value = false; }
  }

  async function fetchProjectList(isLoadMore: boolean, keyword: string): Promise<void> {
    const requestId = projectRequestId + 1; projectRequestId = requestId; projectLoading.value = true;
    const page = isLoadMore ? projectPage.value + 1 : 1;
    try {
      const res = await apiUserProjectTabPageQuery(page, PROJECT_PAGE_SIZE, keyword);
      if (requestId != projectRequestId) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const data = apiResData<any>(res);
        const mapped = mapProjectTabResponse(data, formatTimeLabel);
        const visible = [] as ProjectGroupView[];
        for (let i = 0; i < mapped.length; i++) if (mapped[i].archived != true) visible.push(mapped[i]);
        projectList.value = isLoadMore ? appendProjectGroupsDedup(projectList.value, visible) : visible;
        projectPage.value = page;
        projectHasMore.value = computeProjectHasMore(page, mapProjectTotalPages(data), mapped.length, PROJECT_PAGE_SIZE);
        projectKeyword = keyword;
      }
    } catch (error) { console.error("fetchProjectList error:", error); }
    finally { if (requestId == projectRequestId) projectLoading.value = false; }
  }

  function handleTabClick(key: string): void {
    if (activeTab.value == key) return;
    activeTab.value = key;
    markTabVisited(key);
    // 已加载过但关键词已变（在别的 tab 输入/清空）必须重拉，否则展示过期结果
    if (key == "task") {
      if (conversationList.value.length == 0 || taskKeyword != searchKeyword.value) fetchConversationList(false, searchKeyword.value);
    } else if (key == "project") {
      if (projectList.value.length == 0 || projectKeyword != searchKeyword.value) fetchProjectList(false, searchKeyword.value);
    }
  }
  function handleFocus(): void { isFocused.value = true; }
  function handleBlur(): void { isFocused.value = false; }
  function handleSearch(keyword: string): void {
    searchKeyword.value = keyword;
    const timer = searchTimeoutRef.value; if (timer != null) clearTimeout(timer);
    searchTimeoutRef.value = setTimeout(() => {
      if (activeTab.value == "task") { lastId.value = null; taskHasMore.value = true; fetchConversationList(false, keyword); }
      else if (activeTab.value == "project") { projectPage.value = 0; projectHasMore.value = true; fetchProjectList(false, keyword); }
    }, 500) as number;
  }
  function extractEventValue(e: UniInputEvent): string { return e == null ? "" : e.detail.value; }
  function onSearchConfirm(e: UniInputEvent): void { handleSearch(extractEventValue(e)); }
  function onSearchInput(e: UniInputEvent): void { handleSearch(extractEventValue(e)); }
  function handleLoadMore(): void {
    if (activeLoading.value || activeHasMore.value != true) return;
    if (activeTab.value == "task") fetchConversationList(true, searchKeyword.value);
    else if (activeTab.value == "project") fetchProjectList(true, searchKeyword.value);
  }
  function handleRefresh(): void {
    if (refreshing.value) return;
    refreshing.value = true;
    const request = activeTab.value == "task" ? fetchConversationList(false, searchKeyword.value) : fetchProjectList(false, searchKeyword.value);
    request.finally((): void => { refreshing.value = false; });
  }

  function handleConvClick(index: number): void {
    if (index < 0 || index >= conversationList.value.length) return;
    const item = conversationList.value[index];
    const convId = toNum(item["id"], 0); const agentId = toNum(item["agentId"], 0);
    if (convId <= 0 || agentId <= 0) return;
    const typeStr = toStr(item["agentType"], "ChatBot");
    let agentType: "ChatBot" | "PageApp" | "TaskAgent" = "ChatBot";
    if (typeStr == "PageApp") agentType = "PageApp"; else if (typeStr == "TaskAgent") agentType = "TaskAgent";
    jumpToAgentDetailPage(agentId, convId, agentType, toStr(item["agentName"], ""));
  }
  /** 项目结果点击：跳第一个子会话。子会话随项目列表回包（完整接口契约），不再逐项目拉会话。 */
  function handleProjectClick(index: number): void {
    if (index < 0 || index >= projectList.value.length) return;
    const project = projectList.value[index];
    const children = project.children;
    if (children.length == 0) { uni.showToast({ title: t("Mobile.ConversationSearch.projectNoConversation"), icon: "none" }); return; }
    const child = children[0]; if (child.agentId <= 0) return;
    jumpToAgentDetailPage(child.agentId, child.id, "ChatBot", "", project.projectType);
  }

  function emitExternalSelection(type: string, item: UTSJSONObject): void {
    const payload = new UTSJSONObject(); payload["type"] = type; payload["item"] = item;
    uni.$emit(GLOBAL_SEARCH_SELECTION_EVENT, payload); jumpNavigateBack();
  }
  function handleExpertSelect(item: UTSJSONObject): void { emitExternalSelection("expert", item); }
  function handleSkillSelect(item: UTSJSONObject): void { emitExternalSelection("skill", item); }
  /** 资料库文档：走 repo-web 深链 /repo/doc/{slugId}（对齐 PC SidebarSearchModal openRepoDoc），
   *  webview 内 web 打开并带登录态 ticket；slugId 缺失时不动作。 */
  function handleKnowledgeSelect(item: UTSJSONObject): void {
    const slugId = toStr(item["slugId"]);
    if (slugId.length == 0) return;
    addTicketAndJumpToWebview("/repo/doc/" + slugId, "inner", toStr(item["name"]));
  }

  onLoad((options: any) => {
    const optObj = options as UTSJSONObject; const backUrlRaw = optObj["backUrl"];
    if (backUrlRaw != null && `${backUrlRaw}`.length > 0) {
      const decoded = decodeURIComponent(`${backUrlRaw}`);
      if (decoded != null) {
        backUrl.value = decoded;
        // #ifdef APP-IOS
        try { uni.setStorageSync("NUWAX_CONV_SEARCH_BACK_URL", decoded); } catch (_error) {}
        // #endif
      }
    }
    setCurrentPageNavigationBarTitle(); fetchConversationList(false, "");
  });
  onMounted(() => {
    // #ifndef MP-WEIXIN
    nextTick(() => { const input = searchInputRef.value; if (input != null) input.focus(); });
    // #endif
  });
  onUnmounted(() => {
    const timer = searchTimeoutRef.value; if (timer != null) clearTimeout(timer);
    taskRequestId += 1; projectRequestId += 1;
  });
  onReady(() => {
    // #ifdef MP-WEIXIN
    shouldAutoFocus.value = true;
    // #endif
  });
</script>

<style lang="scss" scoped>
  .search-page-container {
    /* #ifdef H5 */ height: 100vh; /* #endif */
    /* #ifndef H5 */ height: 100%; /* #endif */
    overflow: hidden; background-color: #fff;
    /* #ifdef MP-WEIXIN */ padding-bottom: env(safe-area-inset-bottom); /* #endif */
  }
  .search-container { display: flex; flex-direction: row; align-items: center; padding: 10rpx 0 10rpx 32rpx; flex-shrink: 0; }
  .search-box { flex: 1; display: flex; align-items: center; flex-direction: row; height: 76rpx; padding: 0 24rpx; border-radius: 16rpx; border: 2rpx solid transparent; background: rgba(12, 20, 102, 0.04); }
  .search-box.focused { border-color: #5147ff; }
  .search-input { flex: 1; border: none; font-size: 28rpx; color: #15171f; font-weight: 400; }
  .placeholder-class { color: rgba(21, 23, 31, 0.5); font-size: 28rpx; }
  .clear-icon { font-size: 32rpx; color: #999 !important; }
  .cancel-btn { display: flex; flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; height: 76rpx; padding: 0 32rpx; }
  .cancel-text { color: rgba(21, 23, 31, 0.55); font-size: 30rpx; }
  .tab-bar { flex-shrink: 0; height: 88rpx; border-bottom: 2rpx solid #f1f2f5; }
  .tab-scroll { width: 100%; height: 88rpx; }
  .tab-bar-inner { display: flex; flex-direction: row; align-items: stretch; height: 88rpx; padding: 0 24rpx; }
  .tab-item { flex-shrink: 0; display: flex; align-items: center; justify-content: center; min-width: 96rpx; height: 88rpx; margin-right: 18rpx; border-bottom: 4rpx solid transparent; }
  .tab-item-active { border-bottom-color: #5147ff; }
  .tab-item-text { font-size: 26rpx; color: rgba(21, 23, 31, 0.6); }
  .tab-item-text-active { color: #5147ff; font-weight: 600; }
  .scroll-section { flex: 1; min-height: 0; overflow: hidden; }
  .result-scroll { height: 100%; }
  .result-list { padding: 12rpx 24rpx 24rpx; }
  .result-row { display: flex; flex-direction: row; align-items: center; min-height: 112rpx; padding: 14rpx 12rpx; border-bottom: 2rpx solid #f1f2f5; }
  .result-row:active { background-color: rgba(12, 20, 102, 0.04); }
  .result-icon { width: 72rpx; height: 72rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 20rpx; }
  .result-icon-task { background: rgba(81, 71, 255, 0.1); }
  .result-icon-project { background: rgba(129, 93, 255, 0.1); }
  .result-folder-icon { width: 38rpx; height: 38rpx; }
  .result-pin-icon { width: 24rpx; height: 24rpx; flex-shrink: 0; }
  .result-team-icon { width: 22rpx; height: 22rpx; flex-shrink: 0; }
  .result-main { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
  .result-title-line { display: flex; flex-direction: row; align-items: center; }
  .result-title { flex: 1; font-size: 29rpx; line-height: 42rpx; color: #15171f; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
