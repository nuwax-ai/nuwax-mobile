<template>
  <UniAiXMsgRender
    v-if="renderList.length > 0"
    :markdown-el-list="renderList"
    :processing-list="processingList"
    :is-current-streaming="isCurrentStreaming"
    :conversation-id="conversationId"
    :body-text="content"
    :is-app-details="isAppDetails"
  />
</template>

<script setup lang="uts">
  import { onUnmounted } from "vue";
  import { MsgItem } from "@/types/interfaces/ai-msg";
  import type { UniAiMarkdownElItem } from "@/uni_modules/uni-ai-x/types.uts";
  import UniAiXMsgRender from "@/uni_modules/uni-ai-x/components/uni-ai-x-msg/uni-ai-x-msg.uvue";
  import { AiMsgMarkdownParser } from "@/subpackages/components/ai-msg/aiMsgMarkdownParser.uts";

  const props = withDefaults(
    defineProps<{
      content?: string;
      processingList?: any[];
      conversationId?: string;
      isCurrentStreaming?: boolean;
      isAppDetails?: boolean;
    }>(),
    {
      content: "",
      processingList: (): any[] => [] as any[],
      conversationId: "",
      isCurrentStreaming: false,
      isAppDetails: false,
    },
  );

  /**
   * App 原生 Markdown 渲染桥：为 V2 的 narration / OpenUI / 最终回答分别维护
   * 独立解析器。流式回答沿用 AiMsgMarkdownParser 的增量与结构块降级策略，避免
   * 为了接入折叠轨迹退回纯文本或每个 chunk 都全量重建渲染树。
   */
  const segmentMsg = ref<MsgItem>(new MsgItem());
  const renderRevision = ref<number>(0);
  const parser = new AiMsgMarkdownParser(
    segmentMsg,
    renderRevision,
    (): string => (props.content != null ? `${props.content}` : ""),
    (): boolean => props.isCurrentStreaming == true,
    (): boolean => true,
  );

  const renderList = computed((): UniAiMarkdownElItem[] => {
    const _revision = renderRevision.value;
    return parser.resolveRenderList();
  });

  watch(
    (): string => (props.content != null ? `${props.content}` : ""),
    (content: string) => {
      segmentMsg.value.body = content;
      parser.runMarkdownParse(props.isCurrentStreaming != true);
    },
    { immediate: true },
  );

  watch(
    (): boolean => props.isCurrentStreaming == true,
    (streaming: boolean) => {
      if (streaming != true) {
        parser.runMarkdownParse(true);
      }
    },
  );

  onUnmounted(() => {
    parser.resetForNewMessage();
  });
</script>
