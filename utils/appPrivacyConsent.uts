/** Android 隐私授权：框架真实同意状态与协议版本必须同时满足。 */
// #ifdef APP-ANDROID
import { APP_PRIVACY_POLICY_VERSION } from "@/constants/appPrivacyPolicy";
export const APP_PRIVACY_VERSION = APP_PRIVACY_POLICY_VERSION;
// #endif
// #ifndef APP-ANDROID
export const APP_PRIVACY_VERSION = "";
// #endif
export const APP_PRIVACY_STORAGE_KEY = "nuwax_privacy_consent_version";
export const APP_PRIVACY_GRANTED_EVENT = "nuwax:privacy-consent-granted";

let privacyGranted = false;

export function hasAppPrivacyConsent(): boolean {
  // #ifdef APP-ANDROID
  return privacyGranted;
  // #endif
  // #ifndef APP-ANDROID
  return true;
  // #endif
}

/** 首启/协议实质变更重新确认；普通版本升级、退出登录不清除授权。 */
export function prepareAppPrivacyConsent(done: (accepted: boolean) => void): void {
  // #ifdef APP-ANDROID
  const saved = uni.getStorageSync(APP_PRIVACY_STORAGE_KEY);
  const current = saved != null && `${saved}` == APP_PRIVACY_VERSION;
  if (!current) uni.resetPrivacyAuthorization();
  uni.getPrivacySetting({
    success: (res) => {
      privacyGranted = current && !res.needAuthorization;
      done(privacyGranted);
    },
    fail: (_err: any) => {
      privacyGranted = false;
      done(false);
    },
  });
  // #endif
  // #ifndef APP-ANDROID
  done(true);
  // #endif
}

/** 仅在原生 agreePrivacyAuthorization 按钮触发真实授权之后记录。 */
export function completeAppPrivacyConsent(done: (accepted: boolean) => void): void {
  // #ifdef APP-ANDROID
  uni.getPrivacySetting({
    success: (res) => {
      if (res.needAuthorization) {
        done(false);
        return;
      }
      uni.setStorageSync(APP_PRIVACY_STORAGE_KEY, APP_PRIVACY_VERSION);
      privacyGranted = true;
      done(true);
      uni.$emit(APP_PRIVACY_GRANTED_EVENT);
    },
    fail: (_err: any) => { done(false); },
  });
  // #endif
  // #ifndef APP-ANDROID
  done(true);
  // #endif
}
