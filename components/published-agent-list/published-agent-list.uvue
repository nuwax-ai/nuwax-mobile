<template>
  <view class="container page-container relative border-b">
    <!-- 导航栏 -->
    <custom-nav-bar :title="title" hasSafetyZone :showBack="showBack">
      <!-- #ifdef MP-WEIXIN -->
      <template v-slot:left>
        <svg-icon name="icon-Search" size="48" @click="handleSearch" />
      </template>
      <!-- #endif -->
      <!-- #ifndef MP-WEIXIN -->
      <template v-slot:right>
        <svg-icon name="icon-Search" size="48" @click="handleSearch" />
      </template>
      <!-- #endif -->
    </custom-nav-bar>

    <!-- 分类导航 -->
    <view class="category-nav border-b">
      <scroll-view
        class="category-scroll"
        :key="categories.length"
        direction="horizontal"
        :scroll-x="true"
        :scroll-y="false"
        :scroll-with-animation="true"
        :scroll-into-view="scrollIntoView"
        :show-scrollbar="false"
      >
        <view class="category-scroll-content">
          <view
            :id="category.key"
            v-for="(category, index) in categories"
            :key="category.key"
            :class="`category-item ${activeCategory === category.key ? 'active' : ''}`"
            @click="handleCategoryClick(category.key, index)"
          >
            <text class="category-text">{{
              translate(category.label)
            }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 滚动部分 -->
    <view class="scroll-section">
      <swiper
        class="h-full"
        :current="activeSwiperIndex"
        @change="handleSwiperChange"
        :indicator-dots="false"
        :circular="false"
        :duration="300"
        easing-function="easeOut"
      >
        <template v-for="(category, index) in categories" :key="category.key">
          <swiper-item>
            <!-- 全端统一 list-view：与 swiper 手势协商更好，且支持长列表复用 -->
            <list-view
              v-if="shouldRenderCategory(index)"
              class="h-full category-list"
              direction="vertical"
              :show-scrollbar="false"
              :refresher-enabled="true"
              :refresher-triggered="refreshingMap[category.key] == true"
              @refresherrefresh="handleRefresh"
              @scrolltolower="handleLoadMore"
            >
              <list-item
                v-for="info in (agentListMap[category.key] != null ? agentListMap[category.key]! : [])"
                :key="info.id"
              >
                <template v-if="agentType == 'PageApp'">
                  <page-card
                    :coverImg="info.icon"
                    :name="info.name"
                    :avatar="getPublishUserAvatar(info)"
                    :userName="getPublishUserName(info)"
                    :created="info.created"
                    :userCount="getStatUserCount(info)"
                    :collectCount="getStatCollectCount(info)"
                    :collect="info.collect"
                    @click="handleAgentClick(info)"
                    @collect="handleToggleCollect(info, category.key)"
                  />
                </template>
                <template v-else>
                  <agent-component
                    :icon="info.icon"
                    :name="info.name"
                    :avatar="getPublishUserAvatar(info)"
                    :userName="getPublishUserName(info)"
                    :description="info.description"
                    :userCount="getStatUserCount(info)"
                    :convCount="getStatConvCount(info)"
                    :collectCount="getStatCollectCount(info)"
                    :collect="info.collect"
                    :paymentRequired="info.paymentRequired == true && enableSubscription == 1"
                    :subscribed="info.subscribed"
                    @click="handleAgentClick(info)"
                    @collect="handleToggleCollect(info, category.key)"
                  />
                </template>
              </list-item>
              <list-item
                v-if="
                  (agentListMap[category.key] == null || agentListMap[category.key]!.length == 0) &&
                  loadingMap[category.key] != true &&
                  refreshingMap[category.key] != true
                "
              >
                <view class="empty-state">
                  <image
                    :src="noData"
                    class="empty-image"
                    :alt="t('Mobile.Common.noDataImageAlt')"
                  />
                  <text class="empty-text">{{
                    t("Mobile.Common.noData")
                  }}</text>
                </view>
              </list-item>
              <list-item
                v-if="
                  (agentListMap[category.key] == null || agentListMap[category.key]!.length == 0) &&
                  loadingMap[category.key] == true
                "
              >
                <view class="loading-state">
                  <text class="loading-text">{{
                    t("Mobile.Page.loadingMore")
                  }}</text>
                </view>
              </list-item>
              <list-item
                v-if="
                  loadingMap[category.key] != true &&
                  hasMoreMap[category.key] != true &&
                  (agentListMap[category.key] != null && agentListMap[category.key]!.length > 6)
                "
              >
                <view class="no-more-state">
                  <text class="no-more-text">{{
                    t("Mobile.Common.noMoreData")
                  }}</text>
                </view>
              </list-item>
            </list-view>
            <view v-else class="h-full placeholder-view"></view>
          </swiper-item>
        </template>
      </swiper>
    </view>

    <!-- 登录弹窗（仅微信小程序） -->
    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, onMounted, onUnmounted } from 'vue';
  // #ifdef MP-WEIXIN
  import { onShow, onUnload } from "@dcloudio/uni-app";
  // #endif
  import { CONST_ALL } from "@/constants/common.constants";
  import { SquarePublishedListParams } from "@/types/interfaces/square";
  import { apiPublishedCategoryList, apiPublishedAgentList } from "@/servers/square";
  import { SUCCESS_CODE, USER_NO_LOGIN, REDIRECT_LOGIN } from "@/constants/codes.constants";
  import { SquareAgentTypeEnum } from "@/types/enums/square";
  import AgentComponent from "@/components/agent-component/agent-component.uvue";
  import PageCard from "@/components/page-card/page-card.uvue";
  import noData from "@/static/assets/no_data.png";
  import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
  import { apiTenantConfig } from "@/servers/account";
  import { getCurrentPagePath } from "@/utils/commonBusiness";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { apiUnCollectAgent, apiCollectAgent } from "@/servers/agentDev";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  // #ifdef MP-WEIXIN
  import AuthLoginPopup from "@/components/auth-login-popup/auth-login-popup.uvue";
  // #endif
  import { t as translateFn, translateText, emptyI18nParams } from "@/utils/i18n";

  const translate = (text : string) : string => {
    return translateText(text);
  };

  const _i18nParams = emptyI18nParams();
  const t = (key: string): string => translateFn(key, _i18nParams, "");

  const props = withDefaults(
    defineProps<{
      agentType: string;
      title: string;
      showBack?: boolean;
    }>(),
    {
      agentType: "ChatBot",
      title: "Mobile.Nav.agent",
      showBack: false,
    },
  );

  // 使用登录拦截 composable
  const authInterceptor = useAuthInterceptor();
  const loginPopupRef = authInterceptor.loginPopupRef;
  const baseHandleAgentClick = authInterceptor.handleAgentClick as (info : any) => void;
  const checkAuthAndShowPopup = authInterceptor.checkAuthAndShowPopup as () => Promise<boolean>;

  // 当前分类
  const activeCategory = ref<string>(CONST_ALL);
  // 当前swiper索引
  const activeSwiperIndex = ref<number>(0);

  class PublishedCategoryItem {
    key : string = "";
    label : string = "";
    active : boolean = false;
    constructor(key : string, label : string, active : boolean) {
      this.key = key;
      this.label = label;
      this.active = active;
    }
  }
  // 分类列表
  const categories = ref<PublishedCategoryItem[]>([]);
  // 智能体列表
  // Android: use UTSJSONObject[] because JSON.parse returns UTSJSONObject trees (not typed interface instances).
  // Bracket notation works on UTSJSONObject; `any["key"]` would compile to String.get in Kotlin.
  const agentListMap = ref<Record<string, UTSJSONObject[]>>({} as Record<string, UTSJSONObject[]>);
  // 加载状态
  const loadingMap = ref<Record<string, boolean>>({} as Record<string, boolean>);
  // 刷新状态
  const refreshingMap = ref<Record<string, boolean>>({} as Record<string, boolean>);
  // 页码
  const pageMap = ref<Record<string, number>>({} as Record<string, number>);
  // 是否还有更多
  const hasMoreMap = ref<Record<string, boolean>>({} as Record<string, boolean>);
  // 搜索关键词
  const searchKeyword = ref<string>("");
  // 滚动到对应的分类标签
  const scrollIntoView = ref<string>("");
  // 搜索定时器
  const searchTimeoutRef = ref<number>(0);
  // 租户信息
  const tenantConfigInfo = ref<any | null>(null);

  // 租户订阅限制强受控标志
  const enableSubscription = computed((): number => {
    const tc = tenantConfigInfo.value;
    if (tc != null) {
      const obj = tc as UTSJSONObject;
      const sub = obj["enableSubscription"];
      if (sub != null) {
        return sub as number;
      }
    }
    return 0;
  });
  // 已渲染的分类索引集合（用于懒加载优化）
  const renderedCategoryIndexes = ref<Set<number>>(new Set([0]));

  // // 新增标志变量，用于区分首次加载
  // const isFirstLoad = ref<boolean>(true)

  /**
   * 判断是否应该渲染该分类
   * 只渲染当前页和相邻的前后各1页，减少DOM节点数量
   */
  const shouldRenderCategory = (index: number): boolean => {
    const currentIndex = activeSwiperIndex.value;
    // 渲染当前页、前一页、后一页
    const shouldRender = Math.abs(index - currentIndex) <= 1;
    if (shouldRender) {
      renderedCategoryIndexes.value.add(index);
    }
    // 已经渲染过的页面保持渲染状态，避免频繁创建销毁
    return renderedCategoryIndexes.value.has(index);
  };

  // 获取用户配置
  const fetchTenantConfig = async () => {
    const res = await apiTenantConfig();
    if (apiResCode(res) == SUCCESS_CODE) {
      const dataRaw = apiResData<any>(res);
      if (dataRaw != null) {
        tenantConfigInfo.value = dataRaw;
        const dataObj = dataRaw as UTSJSONObject;
        const siteNameRaw = dataObj["siteName"];
        const siteName = siteNameRaw != null ? `${siteNameRaw}` : "";
        uni.setNavigationBarTitle({
          title: siteName,
        });
        uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(dataRaw));
      }
    }
  };

  // 获取分类列表
  const fetchCategories = async () => {
    const response = await apiPublishedCategoryList();
    if (apiResCode(response) == SUCCESS_CODE) {
      // Same pattern as fetchAgentList: `pageData["records"] as UTSJSONObject[]`
      // On Android: res["data"] returns UTSArray for JSON array. Casting UTSArray to
      // UTSJSONObject[] works (array→array cast). Casting to UTSJSONObject would fail.
      const dataRaw = apiResData<any>(response);
      // apiResData 返回 any，须显式收窄类型
      const rawArray: UTSJSONObject[] =
        dataRaw != null ? (dataRaw as UTSJSONObject[]) : ([] as UTSJSONObject[]);

      // IMPORTANT: On Android (Kotlin) SquareAgentTypeEnum.Agent is an enum instance, not "Agent" string.
      // Comparing `item["type"]` (String from JSON) with enum fails: String.equals(Enum) always false.
      // Use string literal for cross-platform comparison (H5/iOS: "Agent" == "Agent", Android: "Agent" == "Agent").
      const filterTypeStr: string = props.agentType == "ChatBot" ? "Agent" : "PageApp";

      const categoryData: PublishedCategoryItem[] = [];
      for (let i = 0; i < rawArray.length; i++) {
        const item = rawArray[i];
        //#ifdef MP-WEIXIN
        if (`${item["type"]}` == "PageApp" && item["children"] != null) {
          const children: UTSJSONObject[] = item["children"] as UTSJSONObject[];
          item["children"] = children.filter((child: UTSJSONObject): boolean => {
            return child["key"] !== "Game";
          });
        }
        //#endif
        if (`${item["type"]}` == filterTypeStr) {
          const children: UTSJSONObject[] = item["children"] != null ? (item["children"] as UTSJSONObject[]) : ([] as UTSJSONObject[]);
          for (let j = 0; j < children.length; j++) {
            const child = children[j];
            categoryData.push(new PublishedCategoryItem(`${child["key"]}`, `${child["label"]}`, false));
          }
          break;
        }
      }

      categories.value = [
        new PublishedCategoryItem(CONST_ALL, "Mobile.Common.all", true),
        ...categoryData,
      ];
    } else if (apiResCode(response) != USER_NO_LOGIN && apiResCode(response) != REDIRECT_LOGIN) {
      uni.showToast({
        title: t("Mobile.AgentList.fetchCategoryFailed"),
        icon: "error",
      });
    }
  };

  // 获取智能体列表
  const fetchAgentList = async (
    category: string,
    pageNum: number,
    keyword: string,
  ) => {
    if (loadingMap.value[category] != null && loadingMap.value[category] == true) return;
    // 设置加载状态
    loadingMap.value[category] = true;
    try {
      const params = new SquarePublishedListParams();
      params.targetType = "Agent";
      params.targetSubType = props.agentType;
      params.page = pageNum;
      params.pageSize = 10;
      params.category = category === CONST_ALL ? "" : category;
      params.kw = keyword;
      // 获取智能体列表
      const response = await apiPublishedAgentList(params);
      // 成功
      if (apiResCode(response) == SUCCESS_CODE) {
        const pageDataRaw = apiResData<any>(response);
        // Android: JSON.parse returns UTSJSONObject trees. Use bracket notation via UTSJSONObject.
        const pageData: UTSJSONObject | null =
          pageDataRaw != null ? (pageDataRaw as UTSJSONObject) : null;
        const records: UTSJSONObject[] = pageData != null ? (pageData["records"] as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        //#ifdef MP-WEIXIN
        const newList: UTSJSONObject[] = records.filter((item: UTSJSONObject) : boolean => {
          return item["category"] !== "Game";
        });
        //#endif
        //#ifndef MP-WEIXIN
        const newList: UTSJSONObject[] = records;
        //#endif
        if (pageNum > 1) {
          const raw = agentListMap.value[category];
          const existingList: UTSJSONObject[] = raw != null ? raw : ([] as UTSJSONObject[]);
          agentListMap.value[category] = [...existingList, ...newList];
        } else {
          agentListMap.value[category] = newList;
        }
        const pages: number = pageData != null ? (pageData["pages"] as number) : 1;
        hasMoreMap.value[category] = pageData != null && pages > pageNum;
        pageMap.value[category] = pageNum;
      } else if (apiResCode(response) != USER_NO_LOGIN && apiResCode(response) != REDIRECT_LOGIN) {
        const msg = apiResMessage(response);
        uni.showToast({
          title: msg != null && msg != "" ? msg : t("Mobile.AgentList.fetchAgentFailed"),
          icon: "error",
        });
      }
    } catch (e) {
      console.error("fetchAgentList error", e);
    } finally {
      loadingMap.value[category] = false;
    }
  };

  const initData = async () => {
    // 获取分类列表
    fetchCategories();
    // 1. 首先尝试从本地缓存读取，以实现秒开级的初始渲染，防止 siteName 等标题闪烁
    const tenantConfigInfoString = uni.getStorageSync(TENANT_CONFIG_INFO) as string;
    if (tenantConfigInfoString != null && tenantConfigInfoString != "") {
      const parsed = JSON.parse(tenantConfigInfoString);
      tenantConfigInfo.value = parsed;
      const parsedObj = parsed as UTSJSONObject;
      const siteNameRaw = parsedObj["siteName"];
      const siteName = siteNameRaw != null ? `${siteNameRaw}` : "";
      uni.setNavigationBarTitle({
        title: siteName,
      });
    }
    // 2. 然后必须发起强同步网络请求更新最新状态，防止缓存过期导致计费状态显示不准确
    await fetchTenantConfig();
  };

  // #ifdef MP-WEIXIN
  onShow(() => {
    initData();
    fetchAgentList(CONST_ALL, 1, searchKeyword.value);
  });

  onUnload(() => {
    if (searchTimeoutRef.value != 0) {
      clearTimeout(searchTimeoutRef.value);
    }
  });
  // #endif

  // #ifndef MP-WEIXIN
  onMounted(() => {
    initData();
    fetchAgentList(CONST_ALL, 1, searchKeyword.value);
  });

  onUnmounted(() => {
    if (searchTimeoutRef.value != 0) {
      clearTimeout(searchTimeoutRef.value);
    }
  });
  // #endif

  // 点击智能体分类标签
  const handleCategoryClick = (key: string, index: number) => {
    // 当前分类
    activeCategory.value = key;
    // 当前swiper索引
    activeSwiperIndex.value = index;
    // 滚动到对应的分类标签
    scrollIntoView.value = key;

    // 如果该分类还没有数据，则加载数据
    const rawList = agentListMap.value[key];
    if (rawList == null || rawList.length == 0) {
      pageMap.value[key] = 1;
      hasMoreMap.value[key] = true;
      fetchAgentList(key, 1, searchKeyword.value);
    }
  };

  // 处理Swiper切换
  const handleSwiperChange = (e: UniSwiperChangeEvent) => {
    const index = e.detail.current;
    const category = categories.value[index];
    if (category != null && category.key !== activeCategory.value) {
      // 当前分类
      activeCategory.value = category.key;
      // 当前swiper索引
      activeSwiperIndex.value = index;

      // 滚动到对应的分类标签
      const id = categories.value[index].key;
      scrollIntoView.value = id;

      // 如果该分类还没有数据，则加载数据
      const catRaw = agentListMap.value[category.key];
      if (catRaw == null || catRaw.length == 0) {
        pageMap.value[category.key] = 1;
        hasMoreMap.value[category.key] = true;
        fetchAgentList(category.key, 1, searchKeyword.value);
      }
    }
  };

  // 处理搜索
  const handleSearch = async () => {
    // 检查登录状态，如果未登录则显示登录弹窗
    const isLoggedIn = await checkAuthAndShowPopup();
    if (isLoggedIn != true) {
      return;
    }
    const currentUrl = getCurrentPagePath();
    uni.navigateTo({
      url:
        `/subpackages/pages/agent-search/agent-search?type=${props.agentType}&backUrl=` +
        encodeURIComponent(currentUrl),
    });
  };

  // 跳转到智能体详情页
  const handleAgentClick = (agentInfo: UTSJSONObject) => {
    // 使用登录拦截逻辑处理点击
    baseHandleAgentClick({
      targetId: agentInfo["targetId"],
      name: agentInfo["name"],
      agentType: agentInfo["agentType"],
      icon: agentInfo["icon"],
      description: agentInfo["description"],
    });
  };

  // 安全获取发布用户信息（UTSJSONObject 需要使用方括号访问属性）
  const getPublishUserAvatar = (info: UTSJSONObject): string => {
    const user = info["publishUser"] as UTSJSONObject;
    if (user != null) {
      const avatar = user["avatar"];
      return avatar != null ? avatar as string : '';
    }
    return '';
  };
  const getPublishUserName = (info: UTSJSONObject): string => {
    const user = info["publishUser"] as UTSJSONObject;
    if (user != null) {
      const nickName = user["nickName"];
      if (nickName != null && (nickName as string) != '') return nickName as string;
      const userName = user["userName"];
      return userName != null ? userName as string : '';
    }
    return '';
  };
  // 安全获取 statistics 字段（UTSJSONObject 需要使用方括号访问属性）
  const getStatUserCount = (info: UTSJSONObject): number => {
    const stat = info["statistics"] as UTSJSONObject;
    if (stat != null) {
      const val = stat["userCount"];
      return val != null ? val as number : 0;
    }
    return 0;
  };
  const getStatConvCount = (info: UTSJSONObject): number => {
    const stat = info["statistics"] as UTSJSONObject;
    if (stat != null) {
      const val = stat["convCount"];
      return val != null ? val as number : 0;
    }
    return 0;
  };
  const getStatCollectCount = (info: UTSJSONObject): number => {
    const stat = info["statistics"] as UTSJSONObject;
    if (stat != null) {
      const val = stat["collectCount"];
      return val != null ? val as number : 0;
    }
    return 0;
  };

  // 处理收藏与取消收藏
  const handleToggleCollect = async (
    agentInfo: UTSJSONObject,
    category: string,
  ) => {
    const targetId = agentInfo["targetId"] as number;
    const collect = agentInfo["collect"] == true;
    // 获取当前分类列表
    const rawList = agentListMap.value[category];
    const existingList: UTSJSONObject[] = rawList != null ? rawList : [];
    // 更新列表收藏状态，并更新统计信息
    const updatedList = existingList.map((item: UTSJSONObject): UTSJSONObject => {
      if (item["targetId"] === targetId) {
        const statistics = item["statistics"] as UTSJSONObject;
        const collectCount = statistics != null && statistics["collectCount"] != null ? (statistics["collectCount"] as number) : 0;
        const newCollectCount = collect ? collectCount - 1 : collectCount + 1;
        item["collect"] = collect != true;
        if (statistics != null) {
          statistics["collectCount"] = newCollectCount;
        }
      }
      return item;
    });
    agentListMap.value[category] = updatedList;
    // 更新数据库收藏状态
    if (collect == true) {
      const unCollectRes = await apiUnCollectAgent(targetId);
      if (apiResCode(unCollectRes) != SUCCESS_CODE) {
        agentListMap.value[category] = existingList;
        uni.showToast({
          title: t("Mobile.AgentList.unCollectFailed"),
          icon: "none",
        });
      }
    } else {
      const collectRes = await apiCollectAgent(targetId);
      if (apiResCode(collectRes) != SUCCESS_CODE) {
        agentListMap.value[category] = existingList;
        uni.showToast({
          title: t("Mobile.AgentList.collectFailed"),
          icon: "none",
        });
      }
    }
  };

  // 下拉刷新
  const handleRefresh = () => {
    const currentCategory = activeCategory.value;
    if (refreshingMap.value[currentCategory] == true) {
      return;
    }
    refreshingMap.value[currentCategory] = true;
    pageMap.value[currentCategory] = 1;
    hasMoreMap.value[currentCategory] = true;
    fetchAgentList(currentCategory, 1, searchKeyword.value).finally(() => {
      // 添加延迟，让loading效果更明显
      setTimeout(() => {
        refreshingMap.value[currentCategory] = false;
      }, 500);
    });
  };

  // 加载更多
  const handleLoadMore = () => {
    const currentPage : number = pageMap.value[activeCategory.value] != null ? pageMap.value[activeCategory.value] as number : 1;
    const currentHasMore = hasMoreMap.value[activeCategory.value] != false;
    const currentLoading = loadingMap.value[activeCategory.value];

    if (currentHasMore && currentLoading != true) {
      fetchAgentList(activeCategory.value, currentPage + 1, searchKeyword.value);
    }
  };
</script>

<style lang="scss" scoped>
  .container {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: #fff;
    /* #ifdef H5 */
    width: 100%;
    height: 100%;
    max-height: 100%;
    /* #endif */
    /* #ifdef MP-WEIXIN || APP */
    // padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
    /* #endif */

    .icon-Search {
      margin-left: 12rpx;
    }

    .category-nav {
      width: 100%;
      flex-shrink: 0;
      padding: 0 32rpx 16rpx 32rpx;

      /* 分类导航：uni-app-x 横向滚动须 direction=horizontal + scroll-view flex-direction:row */
      .category-scroll {
        width: 100%;
        height: 80rpx;
        flex-direction: row;
        /* #ifndef APP */
        scroll-behavior: smooth;
        /* #endif */
        /* #ifdef H5 || MP-WEIXIN */
        -webkit-overflow-scrolling: touch;
        /* #endif */
      }

      .category-scroll-content {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: center;
        /* #ifdef H5 */
        width: max-content;
        /* #endif */
      }

      .category-item {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        height: 80rpx;
        padding: 0 32rpx;
        border-radius: 16rpx;
        /* #ifndef APP */
        cursor: pointer;
        user-select: none;
        /* #endif */
        transition: all 0.3s ease;
        color: #5e6470;
        font-size: 32rpx;
        font-weight: 400;

        &.active {
          background-color: #f2f2ff;

          .category-text {
            color: #5147ff;
          }
        }

        .category-text {
          font-size: 32rpx;
          font-weight: 400;
          color: #5e6470;
          transition: color 0.3s ease;
          white-space: nowrap;
        }
      }
    }

    /* 滚动部分：flex 子项必须 min-height:0，否则 H5 会被内容撑开导致页面也滚动 */
    .scroll-section {
      flex: 1;
      min-height: 0;
      overflow: hidden;
      width: 100%;

      .category-list {
        flex: 1;
        width: 100%;
        height: 100%;
        min-height: 0;
        /* #ifdef H5 */
        overflow: hidden;
        /* #endif */
      }
    }

    /* 空状态：list-item 无法靠 height:100% 撑满视口，用 min-height 保证居中 */
    .empty-state {
      min-height: 800rpx;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 80rpx 0;

      .empty-image {
        width: 172rpx;
        height: 172rpx;
      }

      .empty-text {
        font-size: 28rpx;
        color: #999;
        margin-top: 32rpx;
      }
    }

    /* 加载状态（首屏无数据时同样撑开） */
    .loading-state {
      min-height: 480rpx;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40rpx;
    }

    .loading-text {
      font-size: 28rpx;
      color: #666;
      display: flex;
      align-items: center;
    }

    /* #ifndef APP */
    .loading-text::before {
      content: "";
      width: 32rpx;
      height: 32rpx;
      border: 4rpx solid #e8e8e8;
      border-top: 4rpx solid #8b5cf6;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin-right: 16rpx;
    }

    @keyframes spin {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }
    /* #endif */

    /* 没有更多数据状态 */
    .no-more-state {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40rpx;
    }

    .no-more-text {
      font-size: 24rpx;
      color: #999;
    }

    /* 占位视图 */
    .placeholder-view {
      background-color: #f8f9fa;
    }
  }
</style>
