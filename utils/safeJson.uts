/**
 * 静默 JSON 解析：失败返回 null，避免脏字符串 JSON.parse 在 H5 刷 SyntaxError。
 */

/**
 * 引号感知截取从首字符起的第一个完整 JSON 值（object/array）。
 * 无法截取时返回空串。
 */
export function sliceBalancedJson(text: string): string {
  if (text.length == 0) {
    return "";
  }
  const startChar = text.charAt(0);
  if (startChar != "{" && startChar != "[") {
    return "";
  }
  const open = startChar;
  const close = open == "{" ? "}" : "]";
  let depth = 0;
  let quote = "";
  let escaped = false;
  for (let i = 0; i < text.length; i++) {
    const ch = text.charAt(i);
    if (quote.length > 0) {
      if (escaped) {
        escaped = false;
        continue;
      }
      if (ch == "\\") {
        escaped = true;
        continue;
      }
      if (ch == quote) {
        quote = "";
      }
      continue;
    }
    if (ch == '"' || ch == "'") {
      quote = ch;
      continue;
    }
    if (ch == open) {
      depth++;
      continue;
    }
    if (ch == close) {
      depth--;
      if (depth == 0) {
        return text.substring(0, i + 1);
      }
    }
  }
  return "";
}

/** 明显不是业务 JSON 的正文（工具 HTML / markdown 自定义标签等）。 */
function looksLikeNonJsonPayload(text: string): boolean {
  if (text.indexOf("<markdown-custom-process") >= 0) {
    return true;
  }
  if (text.indexOf("<!DOCTYPE") >= 0 || text.indexOf("<!doctype") >= 0) {
    return true;
  }
  if (text.indexOf("<html") >= 0 || text.indexOf("</html>") >= 0) {
    return true;
  }
  if (text.indexOf(":::container") >= 0) {
    return true;
  }
  return false;
}

/**
 * 尝试 JSON.parse；任意异常返回 null（不 rethrow、不 console）。
 */
export function safeJsonParse(text: string): any | null {
  if (text.length == 0) {
    return null;
  }
  const candidate = text.trim();
  if (candidate.length == 0) {
    return null;
  }
  const first = candidate.charAt(0);
  if (first != "{" && first != "[") {
    return null;
  }
  if (looksLikeNonJsonPayload(candidate)) {
    return null;
  }

  // 先直接 parse；失败再试平衡前缀（容忍尾部脏数据）
  try {
    return JSON.parse(candidate);
  } catch (_direct: any) {
    // fallthrough
  }

  const sliced = sliceBalancedJson(candidate);
  if (sliced.length == 0 || sliced == candidate) {
    return null;
  }
  try {
    return JSON.parse(sliced);
  } catch (_sliced: any) {
    return null;
  }
}
