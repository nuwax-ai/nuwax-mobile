/**
 * 项目相关接口 —— 对齐 PC 端 ProjectPanel / SpaceProjectManage
 * （nuwax src/pages/AppDevPro/services/appDevPro.ts）。
 *
 * Android：body 显式拼 UTSJSONObject（UTS class 经 JSON.stringify 可能丢字段）。
 * PageApp 契约未覆盖改名/删除（对齐 PC：仅本地改名、不挂删除菜单）。
 */
import { RequestResponse, VoidRequestResponse } from "@/types/interfaces/request";
import {
  UserProjectUpdateParams,
  UserAppUpdateParams,
} from "@/types/interfaces/projectInfo";
import request from "@/servers/useRequest";

/** 侧栏场景一把拉全量（PC ProjectPanel 同款 pageSize=100） */
const TAB_PAGE_SIZE = 100;

/** 云电脑沙箱哨兵值：后端默认分配云端沙箱（对齐 PC CLOUD_SANDBOX_ID） */
const CLOUD_SANDBOX_ID = -1;

/**
 * 侧栏「项目」数据：项目列表附带各项目会话列表（conversations），一次请求全量返回。
 * spaceId 移动端无空间路由暂不传，由后端按用户默认空间处理（联调确认）。
 */
export async function apiUserProjectTabPageQuery(): Promise<RequestResponse<any>> {
  const queryFilter = new UTSJSONObject();
  const body = new UTSJSONObject();
  body["queryFilter"] = queryFilter;
  body["current"] = 1;
  body["pageSize"] = TAB_PAGE_SIZE;
  // 空数组字面量无法推断元素类型（Kotlin），显式声明
  const emptyList: any[] = [] as any[];
  body["orders"] = emptyList;
  body["filters"] = emptyList;
  body["columns"] = emptyList;
  const res = await request({
    url: "/api/user-project/tab/page-query",
    method: "POST",
    data: body,
  });
  return res;
}

function buildUserProjectUpdateBody(data: UserProjectUpdateParams): UTSJSONObject {
  const body = new UTSJSONObject();
  body["id"] = data.id;
  body["name"] = data.name;
  return body;
}

/** 常规项目重命名 */
export async function apiUserProjectUpdate(
  data: UserProjectUpdateParams,
): Promise<RequestResponse<any>> {
  const res = await request({
    url: "/api/user-project/update",
    method: "POST",
    data: buildUserProjectUpdateBody(data),
  });
  return res;
}

/** 常规项目删除 */
export async function apiUserProjectDelete(id: number): Promise<VoidRequestResponse> {
  const res = await request({
    url: `/api/user-project/delete/${id}`,
    method: "POST",
  });
  return res;
}

function buildUserAppUpdateBody(data: UserAppUpdateParams): UTSJSONObject {
  const body = new UTSJSONObject();
  body["id"] = data.id;
  if (data.name != null) {
    body["name"] = data.name;
  }
  return body;
}

/** 全栈应用重命名 */
export async function apiUserAppUpdate(
  data: UserAppUpdateParams,
): Promise<RequestResponse<any>> {
  const res = await request({
    url: "/api/userapp/update",
    method: "POST",
    data: buildUserAppUpdateBody(data),
  });
  return res;
}

/** 全栈应用删除 */
export async function apiUserAppDelete(id: number): Promise<VoidRequestResponse> {
  const res = await request({
    url: `/api/userapp/delete/${id}`,
    method: "POST",
  });
  return res;
}

// ---------------------------------------------------------------------------
// 创建（对齐 PC 2026-09-10 契约）
// ---------------------------------------------------------------------------

/**
 * 创建常规项目（开始页「项目开发-常规项目」入口）。
 * 返回 id/targetId 二选一 + 创建即建的首首个会话 conversationId/agentId（契约先行，缺省由调用方降级）。
 * sandboxId 固定云电脑哨兵 -1（移动端暂只支持云电脑，弹窗里的运行环境选择是占位展示）。
 */
export async function apiNormalProjectCreate(name: string): Promise<RequestResponse<any>> {
  const body = new UTSJSONObject();
  body["name"] = name;
  body["sandboxId"] = CLOUD_SANDBOX_ID;
  const res = await request({
    url: "/api/normal-project/create",
    method: "POST",
    data: body,
  });
  return res;
}

/**
 * 创建全栈应用（开始页「项目开发-全栈项目」入口）。
 * 口径对齐 PC CreateUserApp：sandboxId=-1（全栈仅云端）、devAgentId=租户默认任务智能体
 * （defaultTaskAgentId 缺省回落 defaultAgentId，都无则不传）。
 */
export async function apiUserAppCreate(name: string, devAgentId: number): Promise<RequestResponse<any>> {
  const body = new UTSJSONObject();
  body["name"] = name;
  body["sandboxId"] = CLOUD_SANDBOX_ID;
  if (devAgentId > 0) {
    body["devAgentId"] = devAgentId;
  }
  const res = await request({
    url: "/api/userapp/create",
    method: "POST",
    data: body,
  });
  return res;
}

/**
 * 创建网页应用（开始页「项目开发-网页应用」入口，统一创建接口）。
 * 对齐 PC 首页 projectCreateStrategy：targetType=PageApp。
 */
export async function apiPageAppCreate(name: string): Promise<RequestResponse<any>> {
  const body = new UTSJSONObject();
  body["targetType"] = "PageApp";
  body["name"] = name;
  const res = await request({
    url: "/api/project/create",
    method: "POST",
    data: body,
  });
  return res;
}
