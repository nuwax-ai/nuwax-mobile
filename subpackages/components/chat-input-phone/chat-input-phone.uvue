<template>
  <view class="relative container" :class="{ 'container--home-launcher': isHomeLauncher }">
    <!-- 技能选择按钮 -->
    <skill-tags-bar
      v-if="isTaskAgent && enableSkillAt && !isHomeLauncher"
      class="container-block"
      :selected-skills="selectedSkills"
      @onRemove="removeSkill"
      @onAdd="skillSelectModalVisible = true"
    />
    <!-- 勿加 overflow-hide：iOS 会裁切手动选择 chips 底边框 -->
    <view class="flex flex-row items-center container-block manual-component-block">
      <!-- 手动选择组件 -->
      <manual-component-item
        v-if="showManualComponent"
        :manual-components="safeManualComponents"
        :selected-components="selectedComponents"
        :page-home-index="pageHomeIndexVal"
        :expand-page-area="expandPageAreaVal"
        @onSelectComponent="handleToggleSelectComponent"
        @onOpenPagePreview="handleOpenPagePreview"
        @onOpenFileTree="handleOpenFileTree"
        :is-task-agent="isTaskAgentVal"
        :sandbox-list="sandboxListVal"
        :current-sandbox-id="currentSandboxId"
        :is-sandbox-switch-disabled="isSandboxSwitchDisabled"
        :is-sandbox-unavailable="isSandboxUnavailable"
        :sandbox-disabled-text="sandboxDisabledText"
        :readonly="readonlyVal"
        :enable-skill-at="enableSkillAt"
        @onSandboxChange="handleSandboxChange"
        :allow-other-model="allowOtherModelVal"
        :current-model-id="currentModelIdVal"
        :current-model-name="currentModelNameVal"
        :agent-id="agentId"
        :agent-type="agentTypeVal"
        :is-temp-chat="isTempChat"
        :current-agent-mode="agentMode"
        :allow-choose-mode="allowChooseMode"
        :is-home-launcher="isHomeLauncher"
        @onAgentModeChange="handleAgentModeChange"
        @onModelChange="handleModelChange"
      />
    </view>

    <!--图片列表-->
    <template v-if="hasUploadedFiles">
      <chat-upload-image
        class="container-block"
        :files="files"
        @onDel="handleDelFile"
        @onAdd="handleAddFile"
        :show-add-button="showAddButton"
      />
      <view class="split-line" />
    </template>
    <view
      class="record-tip-container"
      :class="{
        'remove-shadow': isRecording,
        'record-tip-container--with-extra': showExtraContainer,
      }"
    >
      <!-- 无权限蒙层 -->
      <view class="permission-mask" v-if="showNoPermissionMask">
        <text class="permission-text">{{
          t("Mobile.Chat.noAgentPermission")
        }}</text>
      </view>

      <!-- 订阅限制蒙层 -->
      <!-- <view
        class="permission-mask clickable"
        v-else-if="subscriptionRequired"
        @tap="handleOpenSubscription"
      >
        <text class="permission-text text-blue">{{
          t("Mobile.Chat.subscriptionRequiredTip")
        }}</text>
        <text class="sub-arrow">➔</text>
      </view> -->

      <!-- 录音波形 -->
      <view v-if="isRecording" class="waveform">
        <view
          v-for="(bar, index) in waveformBars"
          :key="index"
          class="waveform-bar"
          :style="{
            height: `${bar.height}px`,
            animationDelay: `${bar.delay}ms`,
          }"
        />
      </view>
      <view
        class="chat-input-container"
        :class="{ 'multi-line': isMultiLine, 'is-recording': isRecording }"
      >
        <voice-recorder-button
          v-if="isVoiceInput"
          class="voice-recorder-button-full"
          :duration="600000"
          :is-conversation-active="isConversationActive"
          @onRecordPress="handleVoicePress"
          @onRecordStart="handleVoiceStart"
          @onRecordStop="handleVoiceStop"
          @onError="handleVoiceError"
          @onRecordCancel="handleRecordCancel"
          @onRecordEnd="handleRecordEnd"
        />
        <!--输入框-->
        <!-- placeholder-class：微信小程序placeholder样式无效 -->
        <textarea
          v-else
          ref="inputRef"
          class="input"
          :class="{ 'input-text': messageInfo?.length }"
          placeholder-class="input-placeholder"
          :value="messageInfo"
          :focus="isInputFocused"
          :cursor="textareaCursor"
          @input="handleInput"
          adjust-position="false"
          @keyboardheightchange="onKeyboardheightchange"
          :auto-height="true"
          @focus="onInputFocus"
          @blur="onInputBlur"
          @confirm="handleSendMessage"
          @linechange="handleLineChange"
          :placeholder="isHomeLauncher ? '发消息' : t('Mobile.TempSession.inputPlaceholder')"
          :show-confirm-bar="false"
          :maxlength="-1"
          :disable-default-padding="true"
        >
        </textarea>
        <!-- 图标使用绝对定位，不占用录音按钮宽度；多行输入时贴底 -->
        <view
          class="icon-wrap"
          :class="{ 'icon-wrap--multi-line': isMultiLine }"
          v-if="!isRecording"
        >
          <view class="icon-container">
            <!-- 如果不存在输入内容，则显示输入方式 -->
            <template v-if="showInputMethodIcons">
              <!-- 输入方式: 键盘 -->
              <view
                v-if="isVoiceInput"
                class="icon-action-hit"
                @touchstart.stop
                @touchend.stop
                @touchcancel.stop
                @click.stop.prevent="handleChangeInputMethod"
              >
                <svg-icon
                  name="icon-keyboard"
                  size="48"
                />
              </view>
              <!-- 输入方式: 语音 -->
              <view
                v-else
                class="icon-action-hit"
                @touchstart.stop
                @touchend.stop
                @touchcancel.stop
                @click.stop.prevent="handleChangeInputMethod"
              >
                <svg-icon
                  name="icon-voice"
                  size="48"
                />
              </view>
            </template>
            <!-- 正在会话中，则显示停止会话按钮 -->
            <template v-if="isConversationActive">
              <!-- 正在停止会话 loading -->
              <view
                v-if="isStoppingConversation"
                class="icon-action-hit"
                @touchstart.stop
                @touchend.stop
                @touchcancel.stop
              >
                <uni-icons
                  class="icon-loop"
                  type="loop"
                  size="48rpx"
                  color="#999"
                />
              </view>
              <!-- 停止会话 -->
              <view
                v-else
                class="icon-action-hit"
                @touchstart.stop
                @touchend.stop
                @touchcancel.stop
                @click.stop.prevent="handleStopConversation"
              >
                <svg-icon
                  name="icon-stop-circle"
                  customClass="icon-image"
                  size="48"
                />
              </view>
            </template>
            <!-- 如果存在输入内容或图片文件，则显示发送按钮。没有输入内容和图片文件，则显示添加图片或文件按钮 -->
            <view
              v-else-if="showSendIcon"
              class="icon-action-hit"
              @touchstart.stop
              @touchend.stop
              @touchcancel.stop
              @click.stop.prevent="handleSendMessage"
            >
              <svg-icon
                name="icon-send"
                customClass="icon-send-image"
                size="48"
              />
            </view>
            <!-- 输入方式: 上传图片 -->
            <view
              v-else
              class="icon-action-hit"
              @touchstart.stop
              @touchend.stop
              @touchcancel.stop
              @click.stop.prevent="toggleExtraContainer"
            >
              <svg-icon
                name="icon-a-Pluscircle"
                customClass="icon-plus-image"
                size="48"
              />
            </view>
          </view>
        </view>
      </view>
    </view>
    <!-- 功能栏 -->
    <view
      class="extra-container"
      :class="{ show: showExtraContainer }"
      v-if="showExtraContainer"
    >
      <view class="extra-box" @click="chooseImage('camera')">
        <view class="icon-box">
          <svg-icon name="icon-Camera" />
        </view>
        <text class="text">
          {{ t("Mobile.Chat.takePhoto") }}
        </text>
      </view>
      <view class="extra-box" @click="chooseImage('album')">
        <view class="icon-box">
          <svg-icon name="icon-Image" />
        </view>
        <text class="text">
          {{ t("Mobile.Chat.album") }}
        </text>
      </view>
      <view class="extra-box" @click="chooseFile">
        <view class="icon-box">
          <svg-icon name="icon-Folder" />
        </view>
        <text class="text">
          {{ t("Mobile.Chat.file") }}
        </text>
      </view>
      <view
        class="extra-box"
        v-if="isTaskAgent && enableSkillAt"
        @click="chooseSkill"
      >
        <view class="icon-box">
          <svg-icon name="icon-skill" />
        </view>
        <text class="text">
          {{ t("Mobile.Chat.skill") }}
        </text>
      </view>
    </view>
    <!-- 开启键盘时，底部背景高度为键盘高度 -->
    <view
      class="ai-generate-text-container"
      :class="{ 'ios-wechat': isIOSWechatMiniProgram }"
      ><text class="ai-generate-text">{{
        t("Mobile.Chat.aiGeneratedDisclaimer")
      }}</text></view
    >
    <view
      class="keyboard-cover"
      :style="{ height: keyboardHeight + 'px' }"
    ></view>
    <!-- 技能选择模态框 -->
    <skill-select-modal
      :visible="skillSelectModalVisible"
      @onClose="handleSkillModalClose"
      @onSelect="handleSkillSelect"
    />
  </view>
</template>

<script lang="uts" setup>
  import SkillSelectModal from "./skill-select-modal/skill-select-modal.uvue";
  import SkillTagsBar from "./skill-tags-bar/skill-tags-bar.uvue";
  import { SkillInfoForAt } from "@/types/interfaces/skill";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { UploadFileStatus } from "@/types/enums/common.uts";
  import ChatUploadImage from "./chat-upload-image/chat-upload-image.uvue";
  import ManualComponentItem from "./manual-component-item/manual-component-item.uvue";
  import VoiceRecorderButton from "./voice-recorder-button/voice-recorder-button.uvue";
  import {
    AgentManualComponentInfo,
    AgentSelectedComponentInfo,
  } from "@/types/interfaces/agent.uts";
  import {
    AgentComponentTypeEnum,
    DefaultSelectedEnum,
  } from "@/types/enums/agent.uts";
  import { ChatInputMethod } from "@/subpackages/types/enums/chat.uts";
  import {
    UPLOAD_FILE_ACTION,
    DEFAULT_IMAGE_COUNT,
    DEFAULT_FILE_COUNT,
    CHAT_INPUT_METHOD,
  } from "@/constants/common.constants";
  import {
    MicrophonePermissionHelper,
    type PermissionState,
  } from "@/utils/permissionHelper";
  import { ExpandPageAreaEnum } from "@/types/enums/agent.uts";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import { SandboxInfo } from "@/types/interfaces/sandbox";
  import { ChatSendMessageData } from "@/types/interfaces/chat";
  import { useI18n, toI18nParams, emptyI18nParams } from "@/utils/i18n";
  import {
    readAgentModeCache,
    writeAgentModeCache,
    type AgentMode,
  } from "@/subpackages/utils/agentModeCache.uts";
  import { watch } from "vue";
  import {
    canSendChatMessage,
    computeWechatKeyboardOffset,
    filterSkillsRemainingInText,
    getSkillInsertPrefix,
    getStorageTokenString,
    invertBoolean,
    isAtTypedOnInput,
    isImageChooseCancelled,
    isMessageEmptyForIcons,
    isSkillAlreadySelected,
    isWholeDisabledSendBlocked,
    resolveUploadFailMessage,
    shouldApplyAtCursorAfterSkillSelect,
    shouldInsertSkillAtCursor,
    shouldOpenSkillPickerOnAtInput,
    shouldRestoreCursorOnSkillModalClose,
    shouldShowSendButton,
    showManualComponentBar,
    stringContains,
    stringEndsWith,
  } from "./chatInputActions.uts";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  /** 模板用：单参翻译（useI18n 的 t 需全参，模板单参调用不匹配） */

  /** UTS 兼容：带 count 参数的翻译 */
  const tCount = (key: string, count: number): string => {
    const m = new Map<string, string | number>();
    m.set("count", count);
    return tFn(key, toI18nParams(m), "");
  };

  /** UTS 兼容：带 reason 参数的翻译 */
  const tReason = (key: string, reason: string): string => {
    const m = new Map<string, string | number>();
    m.set("reason", reason);
    return tFn(key, toI18nParams(m), "");
  };

  /** UTS 兼容：可空字符串兜底 */
  const coalesceString = (value: string | null): string => {
    if (value != null) {
      return value;
    }
    return "";
  };

  // 输入框 ref：模板是 textarea，须用 UniTextareaElement（不能用 UniInputElement / any）
  const inputRef = ref<UniTextareaElement | null>(null);

  /** UTS 兼容：安全聚焦输入框 */
  const focusChatInput = (): void => {
    const el = inputRef.value;
    if (el == null) {
      return;
    }
    el.focus();
  };

  // 文档
  // Android 会将 ref 内元素包装为响应式 JSON；附件全链路保持 JSON 对象以避免 class 强转。
  const files = ref<UTSJSONObject[]>([]);
  // 输入内容
  const messageInfo = ref<string>("");
  // 已选技能列表
  const selectedSkills = ref<SkillInfoForAt[]>([]);
  // 技能选择模态框可见状态
  const skillSelectModalVisible = ref<boolean>(false);
  const isMultiLine = ref<boolean>(false);
  // 键盘高度
  const keyboardHeight = ref<number>(0);
  // 是否显示额外功能栏
  const showExtraContainer = ref<boolean>(false);
  // 输入方式
  const inputMethod = ref<ChatInputMethod>(ChatInputMethod.Input);
  // 模板用：当前是否语音输入（UTS 模板不能直接引用枚举类）
  const isVoiceInput = computed((): boolean => inputMethod.value == ChatInputMethod.Voice);
  // 是否正在录音
  const isRecording = ref<boolean>(false);
  // 是否取消录音
  const isCancelled = ref<boolean>(false);
  // 已选组件列表
  const selectedComponents = ref<AgentSelectedComponentInfo[]>([]);
  // 当前 Agent 执行模式，默认自动
  const agentMode = ref<AgentMode>("yolo");
  // 录音时长计时器
  let durationTimer: number | null = null;

  // 波形动画数据
  class WaveformBar {
    height: number;
    delay: number;
    constructor(height: number, delay: number) {
      this.height = height;
      this.delay = delay;
    }
  }
  const waveformBars = ref<WaveformBar[]>([] as WaveformBar[]);
  // 是否是 iOS 微信小程序
  const isIOSWechatMiniProgram = ref<boolean>(false);
  // 标记是否由输入 @ 触发
  const isAtTrigger = ref<boolean>(false);
  // 控制输入框聚焦状态（兼容小程序）
  const isInputFocused = ref<boolean>(false);
  // 记录输入 @ 时的光标索引定位
  const atCursorIndex = ref<number>(-1);
  // 绑定文本框光标位置
  const textareaCursor = ref<number>(-1);

  const props = withDefaults(
    defineProps<{
      manualComponents?: AgentManualComponentInfo[];
      defaultSelectedComponents?: AgentSelectedComponentInfo[];
      // 会话是否正在进行中（有消息正在处理）
      isConversationActive?: boolean;
      // 停止操作是否正在进行中
      isStoppingConversation?: boolean;
      // 是否禁用发送按钮
      wholeDisabled?: boolean;
      // 首页页面URL
      pageHomeIndex?: string;
      // 是否默认展开扩展页面区域
      expandPageArea?: number;
      isTaskAgent?: boolean;
      sandboxList?: SandboxInfo[];
      currentSandboxId?: string;
      isSandboxSwitchDisabled?: boolean;
      isSandboxUnavailable?: boolean;
      sandboxDisabledText?: string;
      hasPermission?: boolean;
      readonly?: boolean;
      enableSkillAt?: boolean;
      // 模型选择相关
      allowOtherModel?: boolean;
      currentModelId?: number;
      currentModelName?: string;
      agentId?: number;
      agentType?: string;
      isTempChat?: boolean;
      subscriptionRequired?: boolean;
      // 是否允许用户选择自动/审批模式
      allowChooseMode?: number;
      /** 首页头部嵌入式样式，避免沿用会话页底部输入区的留白与直角。 */
      isHomeLauncher?: boolean;
    }>(),
    {
      manualComponents: () => [],
      isConversationActive: false,
      isStoppingConversation: false,
      wholeDisabled: false,
      isTaskAgent: false,
      sandboxList: () => [],
      currentSandboxId: "",
      isSandboxSwitchDisabled: false,
      isSandboxUnavailable: false,
      sandboxDisabledText: "",
      hasPermission: true,
      readonly: false,
      enableSkillAt: true,
      allowOtherModel: false,
      currentModelId: 0,
      currentModelName: "",
      agentId: 0,
      agentType: "ChatBot",
      isTempChat: false,
      subscriptionRequired: false,
      allowChooseMode: 0,
      isHomeLauncher: false,
    },
  );

  /**
   * 供父组件通过 $callMethod 读取附件列表。
   * Android：Gen* 组件禁止 as UTSJSONObject 取 defineExpose 的 ref。
   */
  const getFiles = (): UTSJSONObject[] => {
    return files.value;
  };

  /**
   * 供父组件通过 $callMethod 读取已选组件。
   */
  const getSelectedComponents = (): AgentSelectedComponentInfo[] => {
    return selectedComponents.value;
  };

  // 暴露messageInfo和files
  defineExpose({
    files,
    selectedComponents,
    getFiles,
    getSelectedComponents,
  });

  const updateAgentModeByProps = (): void => {
    if (props.allowChooseMode != 1) {
      agentMode.value = "yolo";
      return;
    }
    const cachedAgentMode = readAgentModeCache(props.agentId);
    agentMode.value = cachedAgentMode == "ask" || cachedAgentMode == "yolo"
      ? cachedAgentMode
      : (props.isHomeLauncher ? "ask" : "yolo");
  };

  watch(
    (): number => props.agentId,
    (_agentId: number): void => updateAgentModeByProps(),
  );
  watch(
    (): number => props.allowChooseMode,
    (_allowChooseMode: number): void => updateAgentModeByProps(),
  );

  // 添加文件、图片等
  const handleAddFile = () => {
    // 显示额外功能栏
    showExtraContainer.value = true;
  };

  // 声明事件
  const emit = defineEmits<{
    (e: 'onSendMessage', data: ChatSendMessageData): void;
    (e: 'onStopConversation'): void;
    (e: 'onOpenPagePreview', uri: string): void;
    (e: 'onOpenFileTree'): void;
    (e: 'onSandboxChange', sandboxId: string): void;
    (e: 'onModelChange', modelId: number, name: string): void;
    (e: 'onOpenSubscription'): void;
    (e: 'onScrollToLastMsg', smooth: boolean): void;
  }>();

  // 切换沙盒
  const handleSandboxChange = (sandboxId: string) => {
    emit("onSandboxChange", sandboxId);
  };

  // 切换模型
  const handleModelChange = (modelId: number, name: string) => {
    emit("onModelChange", modelId, name);
  };

  // 触发打开订阅弹窗
  const handleOpenSubscription = () => {
    emit("onOpenSubscription");
  };

  // 打开文件树
  const handleOpenFileTree = () => {
    emit("onOpenFileTree");
  };

  // 停止会话
  const handleStopConversation = () => {
    showExtraContainer.value = false;
    emit("onStopConversation");
  };

  const handleOpenPagePreview = (uri: string) => {
    emit("onOpenPagePreview", uri);
  };

  const handleAgentModeChange = (mode: AgentMode): void => {
    agentMode.value = mode;
    writeAgentModeCache(mode, props.agentId);
  };

  // 初始化波形动画数据
  const initWaveform = () => {
    // Dynamically generate waveform bars based on 80% of width
    const targetWidth = 640 * 0.8; // rpx
    const barWidth = 6; // rpx
    const gap = 4; // rpx
    const numBars = Math.max(
      3,
      Math.floor((targetWidth + gap) / (barWidth + gap)),
    ); // At least 3 bars

    const arr = [] as WaveformBar[];
    for (let index = 0; index < numBars; index++) {
      arr.push(new WaveformBar(Math.random() * 20 + 5, index * 100));
    }
    waveformBars.value = arr;
  };

  const handleNuwaxAgentModeChanged = (payload: any): void => {
    const data = payload as UTSJSONObject;
    const agentIdRaw = data["agentId"];
    const modeRaw = data["mode"];
    const eventAgentId = agentIdRaw != null ? `${agentIdRaw}` : null;
    const eventMode = modeRaw != null ? `${modeRaw}` : "";
    const currentAgentKey = props.agentId > 0 ? `${props.agentId}` : null;
    if (
      eventAgentId === currentAgentKey &&
      (eventMode === "yolo" || eventMode === "ask")
    ) {
      agentMode.value = eventMode as AgentMode;
    }
  };

  // 确保组件挂载后也初始化波形和输入方式
  onMounted(() => {
    // 初始化波形动画数据
    initWaveform();

    // 从缓存中读取输入方式
    const chatInputMethod = uni.getStorageSync(CHAT_INPUT_METHOD);
    if (chatInputMethod == "voice") {
      inputMethod.value = ChatInputMethod.Voice;
    } else if (chatInputMethod == "input") {
      inputMethod.value = ChatInputMethod.Input;
    }

    updateAgentModeByProps();
    uni.$on("NuwaxAgentModeChanged", handleNuwaxAgentModeChanged);

    // 判断是否是 iOS 微信小程序
    // #ifdef MP-WEIXIN
    try {
      const systemInfo = uni.getSystemInfoSync();

      if (systemInfo.osName === "ios") {
        isIOSWechatMiniProgram.value = true;
      }
    } catch (e) {
      console.error("获取系统信息失败:", e);
    }
    // #endif

    // 小程序端首页页面，录音波形动画在开始录音时没有正常显示，需要延迟初始化，确保DOM已渲染
    // #ifdef MP-WEIXIN
    // 延迟初始化，确保DOM已渲染
    setTimeout(() => {
      if (waveformBars.value.length === 0) {
        initWaveform();
      }
    }, 100);
    // #endif
  });

  // 更新波形动画
  const updateWaveform = () => {
    const arr = [] as WaveformBar[];
    waveformBars.value.forEach((bar: WaveformBar) => {
      arr.push(new WaveformBar(Math.random() * 20 + 5, bar.delay));
    });
    waveformBars.value = arr;
  };

  // 开始录音时长计时
  const startDurationTimer = () => {
    durationTimer = setInterval(() => {
      updateWaveform();
    }, 150);
  };

  // 停止录音时长计时
  const stopDurationTimer = () => {
    const t = durationTimer;
    if (t != null) {
      clearInterval(t);
      durationTimer = null;
    }
  };

  // 组件卸载时清理资源
  onUnmounted(() => {
    stopDurationTimer();
    uni.$off("NuwaxAgentModeChanged", handleNuwaxAgentModeChanged);
  });

  // 选择组件
  const handleToggleSelectComponent = (item: AgentSelectedComponentInfo) => {
    let found = false;
    const list = selectedComponents.value;
    const listLen = list.length;
    for (let i = 0; i < listLen; i++) {
      if (list[i].id == item.id) {
        found = true;
        break;
      }
    }
    if (found == true) {
      const next: AgentSelectedComponentInfo[] = [];
      for (let j = 0; j < listLen; j++) {
        if (list[j].id != item.id) {
          next.push(list[j]);
        }
      }
      selectedComponents.value = next;
    } else {
      selectedComponents.value = [...list, item];
    }
  };

  // 监听 props.defaultSelectedComponents 变化并更新 selectedComponents
  watch(
    (): AgentSelectedComponentInfo[] | null => props.defaultSelectedComponents as AgentSelectedComponentInfo[] | null,
    (newValue: AgentSelectedComponentInfo[] | null) => {
      if (newValue != null) {
        selectedComponents.value = newValue;
      } else {
        const defaults = [] as AgentSelectedComponentInfo[];
        const manualList = props.manualComponents;
        const manualLen = manualList != null ? manualList.length : 0;
        for (let i = 0; i < manualLen; i++) {
          const list_ = props.manualComponents;
          if (list_ == null) {
            break;
          }
          const item = list_[i];
          if (item.defaultSelected == DefaultSelectedEnum.Yes) {
            defaults.push(new AgentSelectedComponentInfo(item.id, item.type));
          }
        }
        selectedComponents.value = defaults;
      }
    },
    { immediate: true, deep: true },
  );

  // 键盘高度变化
  const onKeyboardheightchange = (res: UniInputKeyboardHeightChangeEvent) => {
    // keyboardHeight.value = res.detail.height

    // 微信小程序
    // #ifdef MP-WEIXIN
    if (res.detail.height > 31) {
      keyboardHeight.value = computeWechatKeyboardOffset(
        showExtraContainer.value,
      );
    } else {
      keyboardHeight.value = 0;
    }
    // #endif

    // 非微信小程序
    // #ifndef MP-WEIXIN
    keyboardHeight.value = res.detail.height;
    // #endif
  };

  // 生成文件唯一ID
  const getFileUid = () => {
    return Date.now().toString() + Math.floor(Math.random() * 1000000000).toString();
  };

  // UTS 跨模块会把 UTSJSONObject[] 导出参数降级为 Any[]，附件数组操作保留在组件内。
  const countImageFiles = (fileList: UTSJSONObject[]): number => {
    let count = 0;
    for (let i = 0; i < fileList.length; i++) {
      const type = fileList[i]["type"] as string | null;
      if (type != null && type.indexOf("image/") >= 0) {
        count++;
      }
    }
    return count;
  };

  const countNonImageFiles = (fileList: UTSJSONObject[]): number => {
    let count = 0;
    for (let i = 0; i < fileList.length; i++) {
      const type = fileList[i]["type"] as string | null;
      if (type == null || type.indexOf("image/") < 0) {
        count++;
      }
    }
    return count;
  };

  const hasUploadErrorInFiles = (fileList: UTSJSONObject[]): boolean => {
    for (let i = 0; i < fileList.length; i++) {
      if (fileList[i]["status"] == UploadFileStatus.error) {
        return true;
      }
    }
    return false;
  };

  const filterFilesExcludingUid = (
    fileList: UTSJSONObject[],
    uid: string,
  ): UTSJSONObject[] => {
    const result: UTSJSONObject[] = [];
    for (let i = 0; i < fileList.length; i++) {
      if (fileList[i]["uid"] != uid) {
        result.push(fileList[i]);
      }
    }
    return result;
  };

  // 计算已选择图片数量（UTS 不支持 reduce，逻辑见 countImageFiles）
  const imageCount = computed((): number => {
    return countImageFiles(files.value);
  });

  // 计算已选择文件数量
  const fileCount = computed((): number => {
    return countNonImageFiles(files.value);
  });

  // 计算是否显示添加按钮
  const showAddButton = computed((): boolean => {
    if (imageCount.value < DEFAULT_IMAGE_COUNT) {
      return true;
    }
    if (fileCount.value < DEFAULT_FILE_COUNT) {
      return true;
    }
    return false;
  });

  /** 模板 v-if：手动组件栏 */
  const showManualComponent = computed((): boolean => {
    const manualLen = props.manualComponents.length;
    let pageHome = "";
    if (props.pageHomeIndex != null) {
      pageHome = props.pageHomeIndex as string;
    }
    return showManualComponentBar(
      manualLen,
      isRecording.value,
      pageHome,
      props.expandPageArea != null ? props.expandPageArea! : 0,
      1,
      props.isTaskAgent,
      props.allowOtherModel,
    );
  });

  /** APP 端向子组件传递 boolean/string props 时使用 computed */
  const isTaskAgentVal = computed((): boolean => props.isTaskAgent == true);
  const allowOtherModelVal = computed((): boolean => props.allowOtherModel == true);
  const readonlyVal = computed((): boolean => props.readonly == true);
  const pageHomeIndexVal = computed((): string => {
    const index = props.pageHomeIndex;
    if (index == null) {
      return "";
    }
    return `${index}`;
  });
  const expandPageAreaVal = computed((): number => {
    const area = props.expandPageArea;
    if (area == null) {
      return 0;
    }
    return area;
  });
  const currentModelNameVal = computed((): string => {
    const name = props.currentModelName;
    if (name == null) {
      return "";
    }
    return `${name}`;
  });
  const currentModelIdVal = computed((): number => {
    const id = props.currentModelId;
    if (id == null) {
      return 0;
    }
    return id;
  });
  const agentTypeVal = computed((): string => {
    const typeVal = props.agentType;
    if (typeVal == null || `${typeVal}`.length == 0) {
      return "ChatBot";
    }
    return `${typeVal}`;
  });
  const sandboxListVal = computed((): SandboxInfo[] => {
    const list = props.sandboxList;
    if (list == null) {
      return [];
    }
    return list;
  });

  /** 模板 :manual-components 兜底 */
  const safeManualComponents = computed((): AgentManualComponentInfo[] => {
    return props.manualComponents;
  });

  /** 模板 v-if：附件列表 */
  const hasUploadedFiles = computed((): boolean => {
    return files.value.length > 0;
  });

  /** 模板 v-if：无权限蒙层 */
  const showNoPermissionMask = computed((): boolean => {
    return props.hasPermission == false;
  });

  /** 模板 v-if：空内容时显示语音/键盘图标 */
  const showInputMethodIcons = computed((): boolean => {
    return isMessageEmptyForIcons(messageInfo.value);
  });

  /** 模板 v-if：显示发送按钮 */
  const showSendIcon = computed((): boolean => {
    return shouldShowSendButton(messageInfo.value, files.value.length);
  });

  // 前置间接引用（uploadMultipleFiles 定义在下方，UTS 不支持函数声明提升）
  let _uploadMultipleFiles: ((filePaths: string[]) => Promise<void>) | null = null;

  // 选择文件
  const chooseFile = () => {
    // 如果已选择文件数量大于等于默认文件数量，则提示
    if (fileCount.value >= DEFAULT_FILE_COUNT) {
      uni.showToast({
        position: "bottom",
        title: tCount("Mobile.Chat.fileLimitReached", DEFAULT_FILE_COUNT),
      });
      return;
    }
    // 可选择文件数量
    const maxCount = DEFAULT_FILE_COUNT - fileCount.value;
    uni.chooseFile({
      type: "file",
      count: maxCount,
      success: (res) => {
        // 当前选择文件数量
        const uploadCount = res.tempFiles.length;
        // 如果当前选择图片数量大于可选择图片数量，则返回
        if (uploadCount > maxCount) {
          uni.showToast({
            title: tCount("Mobile.Chat.fileMaxSelect", maxCount),
            icon: "none",
            duration: 2000,
          });
          return;
        }

        const _files = res.tempFiles.map((file) => {
          const uploadFile = new UTSJSONObject();
          uploadFile["url"] = file.path;
          if (file.name != null) {
            uploadFile["name"] = file.name;
          }
          if (file.type != null) {
            uploadFile["type"] = file.type;
          }
          uploadFile["size"] = file.size;
          uploadFile["status"] = UploadFileStatus.uploading;
          uploadFile["uid"] = getFileUid();
          return uploadFile;
        });
        files.value = [...files.value, ..._files];

        // 一次性上传所有选中的图片
        const filePaths = res.tempFiles.map((file) => file.path);
        if (_uploadMultipleFiles != null) {
          _uploadMultipleFiles!(filePaths);
        }
      },
      fail: (err) => {
        console.error("choose file: " + err.errMsg);
      },
    });
  };

  // 选择技能
  const chooseSkill = () => {
    showExtraContainer.value = false;
    skillSelectModalVisible.value = true;
  };

  // 选中技能
  const handleSkillSelect = (skill: SkillInfoForAt) => {
    skillSelectModalVisible.value = false; // 关闭选择技能弹框

    const alreadySelected = isSkillAlreadySelected(
      selectedSkills.value,
      skill.id,
    );
    if (alreadySelected == false) {
      selectedSkills.value.push(skill);
    }

    const _rawText: string = messageInfo.value;
    let text: string = coalesceString(_rawText);
    const index = atCursorIndex.value;
    let targetCursor: number = -1;

    const insertAtCursor = shouldInsertSkillAtCursor(
      isAtTrigger.value,
      index,
      text.length,
    );
    if (insertAtCursor == true) {
      // 在光标位置原地补全
      const before = text.substring(0, index - 1);
      const after = text.substring(index);
      const addedText = `@${skill.name} `;
      text = before + addedText + after;
      targetCursor = before.length + addedText.length;
    } else {
      // 降级处理（末尾追加）
      let tempText = text;
      const endsWithAt = stringEndsWith(tempText, "@");
      if (isAtTrigger.value == true) {
        if (endsWithAt == true) {
          tempText = tempText.slice(0, -1);
        }
      }
      const prefix = getSkillInsertPrefix(tempText);
      const addedText = prefix + `@${skill.name} `;
      text = tempText + addedText;
      targetCursor = tempText.length + addedText.length;
    }

    messageInfo.value = text;
    const triggerWasActive = isAtTrigger.value;
    isAtTrigger.value = false; // 重置状态
    atCursorIndex.value = -1; // 重置光标位置

    const shouldSetCursor = shouldApplyAtCursorAfterSkillSelect(
      triggerWasActive,
      targetCursor,
    );
    if (shouldSetCursor == true) {
      textareaCursor.value = targetCursor;
    }

    // #ifdef MP-WEIXIN
    isInputFocused.value = false;
    setTimeout(() => {
      isInputFocused.value = true;
      setTimeout(() => {
        textareaCursor.value = -1;
      }, 50);
    }, 50);
    // #endif

    // #ifndef MP-WEIXIN
    nextTick(() => {
      focusChatInput();
      setTimeout(() => {
        textareaCursor.value = -1;
      }, 100);
    });
    // #endif
  };

  // 关闭技能选择框时的回调
  const handleSkillModalClose = () => {
    skillSelectModalVisible.value = false;

    const shouldRestore = shouldRestoreCursorOnSkillModalClose(
      isAtTrigger.value,
      atCursorIndex.value,
    );
    if (shouldRestore == true) {
      textareaCursor.value = atCursorIndex.value;

      // #ifdef MP-WEIXIN
      isInputFocused.value = false;
      setTimeout(() => {
        isInputFocused.value = true;
        setTimeout(() => {
          textareaCursor.value = -1;
        }, 50);
      }, 50);
      // #endif

      // #ifndef MP-WEIXIN
      nextTick(() => {
        focusChatInput();
        setTimeout(() => {
          textareaCursor.value = -1;
        }, 100);
      });
      // #endif
    }

    isAtTrigger.value = false;
    atCursorIndex.value = -1;
  };

  // 移除技能
  const removeSkill = (index: number) => {
    const skill = selectedSkills.value[index];
    if (skill != null) {
      selectedSkills.value.splice(index, 1);
      const mentionWithSpace = `@${skill.name} `;
      const mention = `@${skill.name}`;

      let text: string = coalesceString(messageInfo.value);

      // 本地变量操作，避免对 messageInfo.value 作多次 Response 促发
      while (stringContains(text, mentionWithSpace) == true) {
        text = text.replace(mentionWithSpace, "");
      }
      while (stringContains(text, mention) == true) {
        text = text.replace(mention, "");
      }
      messageInfo.value = text;
    }
  };

  // 拍照或相册选择图片
  const chooseImage = (type: string) => {
    // 如果已选择图片数量大于等于默认图片数量，则提示
    if (imageCount.value >= DEFAULT_IMAGE_COUNT) {
      uni.showToast({
        position: "bottom",
        title: tCount("Mobile.Chat.imageLimitReached", DEFAULT_IMAGE_COUNT),
      });
      return;
    }
    // 可选择图片数量
    const maxCount = DEFAULT_IMAGE_COUNT - imageCount.value;
    let sourceTypeItem = "album";
    if (type == "camera") {
      sourceTypeItem = "camera";
    }
    uni.chooseImage({
      sourceType: [sourceTypeItem],
      sizeType: ["original", "compressed"],
      count: maxCount,
      success: (res) => {
        // 当前选择图片数量
        const uploadCount = res.tempFiles.length;
        // 如果当前选择图片数量大于可选择图片数量，则返回
        if (uploadCount > maxCount) {
          uni.showToast({
            title: tCount("Mobile.Chat.imageMaxSelect", maxCount),
            icon: "none",
            duration: 2000,
          });
          return;
        }

        const _files = res.tempFiles.map((file) => {
          const uploadFile = new UTSJSONObject();
          uploadFile["url"] = file.path;
          if (file.name != null) {
            uploadFile["name"] = file.name;
          }
          if (file.type != null) {
            uploadFile["type"] = file.type;
          }
          uploadFile["size"] = file.size;
          uploadFile["status"] = UploadFileStatus.uploading;
          uploadFile["uid"] = getFileUid();
          return uploadFile;
        });
        files.value = [...files.value, ..._files];

        // 一次性上传所有选中的图片
        const filePaths = res.tempFiles.map((file) => file.path);
        if (_uploadMultipleFiles != null) {
          _uploadMultipleFiles!(filePaths);
        }
      },
      fail: (err) => {
        const errMsg = coalesceString(err.errMsg);
        // 如果取消选择图片，则不显示错误提示
        const isCancelled = isImageChooseCancelled(errMsg);
        if (isCancelled == true) {
          return;
        }
        uni.showToast({
          title: tReason("Mobile.Chat.chooseImageFailed", errMsg),
          position: "bottom",
        });
      },
    });
  };

  // 上传单张图片（返回Promise）
  const uploadFile = (
    filePath: string,
    uid: string,
  ): Promise<UTSJSONObject> => {
    // 令牌
    const token = getStorageTokenString(ACCESS_TOKEN);
    const header = new UTSJSONObject();
    // #ifdef H5 || WEB
    if (process.env.NODE_ENV === "development") {
      header["Authorization"] = `Bearer ${token}`;
    }
    // #endif

    // #ifdef MP-WEIXIN
    header["Authorization"] = `Bearer ${token}`;
    // #endif

    return new Promise((resolve, reject) => {
      const _pop: string = filePath.split("/").pop() as string;
      let fileName = "image.jpg";
      if (_pop.length > 0) {
        fileName = _pop;
      }
      const formDataObj = new UTSJSONObject();
      formDataObj["type"] = "tmp";
      const uploadTask: UploadTask = uni.uploadFile({
        url: UPLOAD_FILE_ACTION,
        filePath: filePath,
        name: "file",
        header: header,
        formData: formDataObj,
        success: (res) => {
          try {
            const result = JSON.parse<UTSJSONObject>(res.data as string);
            const code = result != null ? result["code"] as string : "";
            const data = result != null ? result["data"] as UTSJSONObject | null : null;
            const message = result != null ? result["message"] as string | null : null;
            if (code == SUCCESS_CODE) {
              let fileKey = "";
              let uploadName = fileName;
              let mimeType = "image/jpeg";
              let fileSize = 0;
              let fileUrl = "";
              if (data != null) {
                if (data["key"] != null) {
                  fileKey = data["key"] as string;
                }
                if (data["fileName"] != null) {
                  uploadName = data["fileName"] as string;
                }
                if (data["mimeType"] != null) {
                  mimeType = data["mimeType"] as string;
                }
                if (data["size"] != null) {
                  fileSize = data["size"] as number;
                }
                if (data["url"] != null) {
                  fileUrl = data["url"] as string;
                }
              }
              const uploadedFile = new UTSJSONObject();
              uploadedFile["key"] = fileKey;
              uploadedFile["name"] = uploadName;
              uploadedFile["type"] = mimeType;
              uploadedFile["size"] = fileSize;
              uploadedFile["url"] = fileUrl;
              uploadedFile["uid"] = uid;
              uploadedFile["status"] = UploadFileStatus.done;
              uploadedFile["percent"] = 100;
              if (result != null) {
                uploadedFile["response"] = result;
              }
              resolve(uploadedFile);
            } else {
              let dataMsg: string | null = null;
              let resultMsg: string | null = null;
              if (data != null) {
                if (data["message"] != null) {
                  dataMsg = data["message"] as string;
                }
              }
              if (message != null) {
                resultMsg = message;
              }
              const failText = resolveUploadFailMessage(
                dataMsg,
                resultMsg,
                t("Mobile.AudioUploader.uploadFailed"),
              );
              reject(new Error(failText));
            }
          } catch (error) {
            console.error("解析上传响应失败:", error);
            reject(error);
          }
        },
        fail: (error) => {
          // console.error('上传失败:', error);
          reject(error);
        },
      });

      // 上传进度
      uploadTask.onProgressUpdate((res: OnProgressUpdateResult) => {
        const list = files.value;
        const listLen = list.length;
        let foundIndex = -1;
        for (let i = 0; i < listLen; i++) {
          if ((list[i] as UTSJSONObject)["uid"] == uid) {
            foundIndex = i;
            break;
          }
        }
        if (foundIndex != -1) {
          (list[foundIndex] as UTSJSONObject)["percent"] = res.progress;
        }
      });
    });
  };

  // 多文件上传
  async function uploadMultipleFiles(filePaths: string[]): Promise<void> {
    if (filePaths.length == 0) return;

    try {
      // 并发上传所有图片
      const uploadPromises = filePaths.map((filePath) => {
        // 找到对应的文件以获取 uid
        let matchedUid = "";
        const fileList = files.value;
        const fileListLen = fileList.length;
        for (let i = 0; i < fileListLen; i++) {
          const file = fileList[i] as UTSJSONObject;
          if (file["url"] == filePath) {
            const fileUid = file["uid"] as string | null;
            if (fileUid != null) {
              matchedUid = fileUid;
            }
            break;
          }
        }
        return uploadFile(filePath, matchedUid);
      });

      // 使用 Promise.allSettled 处理部分成功、部分失败的情况
      const uploadResults = await Promise.allSettled(uploadPromises);

      // 处理上传结果
      uploadResults.forEach((result, index) => {
        const filePath = filePaths[index];
        let matchedUid = "";
        const fileList = files.value;
        const fileListLen = fileList.length;
        for (let i = 0; i < fileListLen; i++) {
          const file = fileList[i] as UTSJSONObject;
          if (file["url"] == filePath) {
            const fileUid = file["uid"] as string | null;
            if (fileUid != null) {
              matchedUid = fileUid;
            }
            break;
          }
        }
        // 上传成功
        if (result.status == "fulfilled") {
          // UTS 无法对 allSettled 判别联合窄化，用 JSON 往返读取 value。
          const rObj = JSON.parse<UTSJSONObject>(JSON.stringify(result));
          const uploadedFileRaw = rObj != null ? rObj["value"] : null;
          if (uploadedFileRaw != null) {
            const uploadedFile = uploadedFileRaw as UTSJSONObject;
            const uploadedUid = uploadedFile["uid"] as string | null;
            for (let j = 0; j < fileListLen; j++) {
              if ((files.value[j] as UTSJSONObject)["uid"] == uploadedUid) {
                const completedFile = new UTSJSONObject();
                const fileKey = uploadedFile["key"] as string | null;
                if (fileKey != null) {
                  completedFile["key"] = fileKey;
                }
                completedFile["name"] = uploadedFile["name"] as string;
                completedFile["type"] = uploadedFile["type"] as string;
                completedFile["size"] = uploadedFile["size"] as number;
                completedFile["url"] = uploadedFile["url"] as string;
                if (uploadedUid != null) {
                  completedFile["uid"] = uploadedUid;
                }
                completedFile["status"] = uploadedFile["status"] as UploadFileStatus;
                const uploadPercent = uploadedFile["percent"] as number | null;
                if (uploadPercent != null) {
                  completedFile["percent"] = uploadPercent;
                }
                const uploadResponse = uploadedFile["response"];
                if (uploadResponse != null) {
                  completedFile["response"] = uploadResponse;
                }
                files.value[j] = completedFile;
                break;
              }
            }
          }
        } else {
          // 上传失败，更新对应文件状态为 error
          if (matchedUid.length > 0) {
            for (let k = 0; k < fileListLen; k++) {
              const file = files.value[k] as UTSJSONObject;
              if (file["uid"] == matchedUid) {
                file["status"] = UploadFileStatus.error;
                break;
              }
            }
          }
        }
      });

      // 隐藏额外功能栏
      showExtraContainer.value = false;
    } catch (error) {
      console.error("批量上传处理失败:", error);
    }
  }
  _uploadMultipleFiles = uploadMultipleFiles;

  // 输入框获取焦点
  const onInputFocus = () => {
    isInputFocused.value = true;
    // 隐藏额外功能栏
    showExtraContainer.value = false;
    // 滚动到最后一个消息
    emit('onScrollToLastMsg', true);
  };

  // 输入框失去焦点
  const onInputBlur = () => {
    isInputFocused.value = false;
    // 隐藏额外功能栏
    showExtraContainer.value = false;
  };

  // 切换额外功能栏显示/隐藏
  const toggleExtraContainer = () => {
    showExtraContainer.value = invertBoolean(showExtraContainer.value);
  };

  // 打开麦克风权限
  const openMicrophonePermission = async () => {
    // Android 构建阶段暂不处理麦克风权限弹窗
  };

  // 切换输入方式
  const handleChangeInputMethod = async () => {
    if (inputMethod.value == ChatInputMethod.Voice) {
      inputMethod.value = ChatInputMethod.Input;
      uni.setStorageSync(CHAT_INPUT_METHOD, ChatInputMethod.Input);
      showExtraContainer.value = false;
      nextTick(() => {
        focusChatInput();
      });
    } else {
      inputMethod.value = ChatInputMethod.Voice;
      uni.setStorageSync(CHAT_INPUT_METHOD, ChatInputMethod.Voice);
      inputRef.value = null;
    }
  };

  // 监听输入方式变化 - watch 暂时禁用以排查 UTS 编译错误

  // 输入事件
  const handleInput = (e: UniInputEvent) => {
    const value = coalesceString(e.detail.value as string | null);
    const prevValue = coalesceString(messageInfo.value);
    const cursor = e.detail.cursor as number | null;
    const isAtTyped = isAtTypedOnInput(cursor, value);
    const isAddingOne = value.length == prevValue.length + 1;
    const openPicker = shouldOpenSkillPickerOnAtInput(
      props.isTaskAgent,
      props.enableSkillAt,
      isAddingOne,
      isAtTyped,
    );
    if (openPicker == true) {
      uni.hideKeyboard();
      isAtTrigger.value = true;
      if (cursor != null) {
        atCursorIndex.value = cursor;
      } else {
        atCursorIndex.value = -1;
      }
      showExtraContainer.value = false;
      skillSelectModalVisible.value = true;
    }
    messageInfo.value = value;
    selectedSkills.value = filterSkillsRemainingInText(
      selectedSkills.value,
      value,
    );
  };

  // 点击发送事件
  const handleSendMessage = (): void => {
    const isDisabled = isWholeDisabledSendBlocked(props.wholeDisabled);
    if (isDisabled == true) {
      messageInfo.value = "";
      uni.showToast({
        title: t("Mobile.Chat.fillRequiredParams"),
        icon: "none",
        duration: 2000,
      });
      return;
    }
    const existErrorFile = hasUploadErrorInFiles(files.value);
    if (existErrorFile == true) {
      uni.showToast({
        title: t("Mobile.Chat.removeUploadFailed"),
        icon: "none",
        duration: 1500,
      });
      return;
    }
    const canSend = canSendChatMessage(
      messageInfo.value,
      files.value.length,
      selectedSkills.value.length,
    );
    if (canSend == true) {
      const payload = new UTSJSONObject();
      payload["messageInfo"] = messageInfo.value;
      payload["files"] = files.value;
      payload["selectedComponents"] = selectedComponents.value;
      const skillIds: number[] = [];
      const skills = selectedSkills.value;
      for (let i = 0; i < skills.length; i++) {
        skillIds.push(skills[i].targetId);
      }
      payload["skillIds"] = skillIds;
      if (props.isTaskAgent == true) {
        payload["agentMode"] =
          props.allowChooseMode == 1
            ? agentMode.value
            : "yolo";
      }
      // 首页和会话页都通过组件事件发送，避免首页语音转写结果落到无人监听的全局事件中。
      emit("onSendMessage", payload);
      selectedSkills.value = [];
      files.value = [];
      messageInfo.value = "";
    }
  };

  // 语音录制按下（立即展示波形并隐藏右侧图标，不等待 onStart）
  const handleVoicePress = () => {
    if (isRecording.value == true) {
      return;
    }
    isRecording.value = true;
    if (waveformBars.value.length == 0) {
      initWaveform();
    }
    startDurationTimer();
  };

  // 语音录制开始（RecorderManager onStart 回调）
  const handleVoiceStart = () => {
    if (isRecording.value == false) {
      handleVoicePress();
    }
  };

  // 语音录制结束并转换为文字
  const handleVoiceStop = async (transcriptText: string) => {
    isRecording.value = false;
    stopDurationTimer();
    const isStringType = typeof transcriptText === "string";
    if (isStringType == true) {
      if (transcriptText.length > 0) {
      // 将语音转换的文字作为消息发送
      messageInfo.value = transcriptText;
      await nextTick();
      handleSendMessage();
      }
    }
  };

  /** 从 Error / UTSError / UTSJSONObject 安全读取文案（禁止 as UTSJSONObject） */
  function resolveVoiceErrorMessage(error: any | null, fallback: string): string {
    if (error == null) {
      return fallback;
    }
    try {
      const err = error as Error;
      const message = err.message;
      if (message != null && `${message}`.length > 0) {
        if (`${message}`.indexOf("ClassCastException") >= 0) {
          return fallback;
        }
        return `${message}`;
      }
    } catch (_eErr) {
      // ignore
    }
    try {
      const jsonStr = JSON.stringify(error);
      if (jsonStr != null && jsonStr.length > 2 && jsonStr != "{}" && jsonStr != "null") {
        const parsed = JSON.parse(jsonStr) as UTSJSONObject;
        const messageField = parsed["message"];
        if (messageField != null && `${messageField}`.length > 0) {
          return `${messageField}`;
        }
        const errMsgField = parsed["errMsg"];
        if (errMsgField != null && `${errMsgField}`.length > 0) {
          return `${errMsgField}`;
        }
      }
    } catch (_eJson) {
      // ignore
    }
    const text = `${error}`;
    if (text.length > 0 && text != "null" && text.indexOf("ClassCastException") < 0) {
      return text;
    }
    return fallback;
  }

  // 语音录制错误
  const handleVoiceError = (error: any) => {
    isRecording.value = false;
    stopDurationTimer();
    const errorMessage = resolveVoiceErrorMessage(error, t("Mobile.Voice.recordFailed"));

    uni.showToast({
      title: errorMessage,
      icon: "none",
      duration: 2000,
    });
  };

  // 取消录音
  // const handleCancelChange = (value: boolean) => {
  //   isCancelled.value = value;
  // }

  // Add @onRecordCancel to voice-recorder-button
  const handleRecordCancel = () => {
    isRecording.value = false;
    isCancelled.value = false; // Optional: reset cancel state
  };

  // 松手结束录音手势（上传/识别阶段仍保持 isRecording，直到转写完成）
  const handleRecordEnd = () => {
    isCancelled.value = false;
  };

  // Add handler for line change
  const handleLineChange = (e: UniTextareaLineChangeEvent) => {
    isMultiLine.value = e.detail.lineCount > 1;
  };

  // 删除文档
  const handleDelFile = (uid: string) => {
    files.value = filterFilesExcludingUid(files.value, uid);
  };
</script>

