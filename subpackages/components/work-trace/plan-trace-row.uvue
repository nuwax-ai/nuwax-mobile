<template>
  <!--
    V2 轨迹中的 Plan 独立行（对齐 PC：plan 是 ProcessNodeRow + ToolNodeDetail todo 分支）。
    行：任务图标 +「已更新计划/正在更新计划」动作词 + 状态 + 箭头；展开 = todo 步骤清单。
  -->
  <view class="node-row-wrapper" :class="{ 'is-failed': isFailed }">
    <view class="node-row" @tap="onRowTap">
      <text class="iconfont icon-List node-kind-icon" :class="{ 'is-failed-icon': isFailed }" />
      <text class="node-title" :class="{ 'shimmer-text': isRunning }">{{ actionText }}</text>
      <text v-if="planName.length > 0" class="node-summary">{{ planName }}</text>
      <view v-if="isRunning" class="node-status-icon">
        <text class="iconfont icon-Loader node-spinner" />
      </view>
      <text v-else-if="isFailed" class="iconfont icon-a-Xcircle node-failed-icon" />
      <text
        v-if="steps.length > 0"
        class="iconfont icon-a-Chevrondown node-disclosure"
        :class="{ 'node-disclosure-open': expanded }"
      />
    </view>
    <view v-if="expanded && steps.length > 0" class="node-detail">
      <view class="tool-detail-steps">
        <view v-for="(step, index) in steps" :key="index" class="tool-detail-step">
          <text
            class="iconfont tool-detail-step-icon"
            :class="stepIconClass(step.status)"
          />
          <text class="tool-detail-step-text">{{ step.content }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import type { TraceToolRow } from "@/subpackages/components/ai-msg/conversationTrace.uts";
  import { useI18n } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, undefined, "");

  const props = withDefaults(
    defineProps<{
      /** Plan 类型工具行数据（kind = todo）。 */
      row?: TraceToolRow | null;
      /** 步骤清单展开状态（托管在 ai-msg 折叠状态机）。 */
      expanded?: boolean;
    }>(),
    {
      row: null,
      expanded: false,
    },
  );

  const emit = defineEmits<{
    toggle: [];
  }>();

  const isRunning = computed((): boolean => props.row != null && props.row!.status == "running");
  const isFailed = computed((): boolean => props.row != null && props.row!.status == "failed");
  const planName = computed((): string => (props.row == null ? "" : props.row!.name));

  const actionText = computed((): string => {
    const row = props.row;
    if (row == null) return "";
    const status = row!.status;
    if (status == "running") return t("Mobile.Chat.WorkTrace.toolActionPlanRunning");
    if (status == "failed") return t("Mobile.Chat.WorkTrace.toolActionPlanFailed");
    return t("Mobile.Chat.WorkTrace.toolActionPlanFinished");
  });

  /** Plan 步骤清单（result.data 中含 content 的项）。 */
  const steps = computed((): any[] => {
    const row = props.row;
    if (row == null || row!.processing == null) return [] as any[];
    const result = (row!.processing as UTSJSONObject)["result"];
    if (result == null || typeof result != "object") return [] as any[];
    const data = (result as UTSJSONObject)["data"];
    if (data == null || Array.isArray(data) != true) return [] as any[];
    return data as any[];
  });

  function stepIconClass(status: string): string {
    if (status == "completed") return "icon-CheckSquareOutlined";
    if (status == "in_progress") return "icon-HourglassOutlined";
    if (status == "failed") return "icon-CloseSquareOutlined";
    return "icon-BorderOutlined";
  }

  function onRowTap(): void {
    if (steps.value.length == 0) {
      return;
    }
    emit("toggle");
  }
</script>

<style lang="scss" scoped>
  // 对齐 PC hairline 色板（与 tool-trace-row 同体系）
  $text-main: rgba(0, 0, 0, 0.88);
  $text-tertiary: rgba(5, 5, 5, 0.45);
  $text-secondary: rgba(5, 5, 5, 0.65);
  $text-quaternary: rgba(5, 5, 5, 0.25);
  $color-error: #ff4d4f;
  $color-primary: #6a5af9;

  .node-row-wrapper {
    min-width: 0;

    &.is-failed .node-title {
      color: $color-error;
    }
  }

  .node-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14rpx;
    width: 100%;
    min-height: 60rpx;
    padding: 0;
    color: $text-main;
    font-size: 26rpx;
    line-height: 40rpx;
  }

  .node-kind-icon {
    width: 28rpx;
    flex-shrink: 0;
    font-size: 28rpx;
    color: $text-tertiary;
    line-height: 40rpx;

    &.is-failed-icon {
      color: $color-error;
    }
  }

  .node-title {
    max-width: 42%;
    overflow: hidden;
    flex-shrink: 0;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node-summary {
    // 自然宽度：箭头紧跟内容
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    color: $text-tertiary;
    font-size: 26rpx;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node-status-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32rpx;
    height: 32rpx;
  }

  .node-spinner {
    font-size: 26rpx;
    color: $color-primary;
    animation: plan-row-spin 1s linear infinite;
  }

  .node-failed-icon {
    flex-shrink: 0;
    font-size: 26rpx;
    color: #ff4d4f;
  }

  .node-disclosure {
    flex-shrink: 0;
    font-size: 20rpx;
    color: $text-quaternary;
    transform: rotate(-90deg);
    transition: transform 0.18s ease, color 0.18s ease;

    &-open {
      transform: rotate(0deg);
      color: $text-secondary;
    }
  }

  .node-detail {
    margin: 4rpx 12rpx 16rpx 42rpx;
    min-width: 0;
  }

  .tool-detail-steps {
    display: flex;
    flex-direction: column;
    gap: 10rpx;
  }

  .tool-detail-step {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 14rpx;
  }

  .tool-detail-step-icon {
    flex-shrink: 0;
    font-size: 30rpx;
    color: #8c8c8c;
    line-height: 38rpx;
  }

  .tool-detail-step-text {
    flex: 1;
    min-width: 0;
    font-size: 26rpx;
    color: $text-main;
    line-height: 40rpx;
  }

  @keyframes plan-row-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  /* #ifndef APP */
  /* 运行中文案扫光（对齐 PC shimmer-text） */
  @keyframes v2-shimmer-sweep {
    0% {
      background-position: 200% 0;
    }

    100% {
      background-position: -200% 0;
    }
  }

  .shimmer-text {
    background: linear-gradient(
      90deg,
      rgba(5, 5, 5, 0.45) 0%,
      rgba(5, 5, 5, 0.45) 38%,
      rgba(0, 0, 0, 0.88) 50%,
      rgba(5, 5, 5, 0.45) 62%,
      rgba(5, 5, 5, 0.45) 100%
    );
    background-size: 200% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: v2-shimmer-sweep 2.4s linear infinite;
  }
  /* #endif */
</style>
