<template>
  <view class="perf-page">
    <custom-nav-bar title="流式渲染性能测试" :show-back="true" />

    <!-- 控制面板 -->
    <view class="control-panel">
      <view class="ctrl-row">
        <text class="ctrl-label">历史消息 {{ historyCount }} 条</text>
        <slider
          class="ctrl-slider"
          :value="historyCount"
          min="0"
          max="100"
          step="10"
          @change="onHistorySliderChange"
        />
      </view>
      <view class="ctrl-row ctrl-toggles">
        <view
          v-for="v in [0, 1, 2, 3, 4]"
          :key="v"
          class="toggle"
          :class="{ 'toggle-active': mdType == v }"
          @tap="setMdType(v)"
        >
          <text class="toggle-text">{{ mdTypeLabel(v) }}</text>
        </view>
        <view class="toggle" :class="{ 'toggle-active': showCard }" @tap="toggleCard">
          <text class="toggle-text">卡片{{ showCard ? "开" : "关" }}</text>
        </view>
      </view>
      <view class="ctrl-row ctrl-btns">
        <button class="btn btn-primary" @tap="running ? stop() : start()">
          {{ running ? "停止" : "开始流式" }}
        </button>
        <button class="btn" @tap="reset">重置</button>
      </view>

      <!-- 实时指标 -->
      <view class="metrics">
        <text class="metric-text">chunk: {{ chunkCount }}</text>
        <text class="metric-text">字符: {{ streamText.length }}</text>
        <text class="metric-text" :class="{ 'metric-bad': avgFps < 20 }">
          帧率: {{ avgFps }} fps
        </text>
        <text class="metric-text" :class="{ 'metric-bad': maxGap > 100 }">
          最大帧间隔: {{ maxGap }}ms
        </text>
      </view>
    </view>

    <!-- 干预卡片（开关）：真实组件，验证卡片是否热点 -->
    <view v-if="showCard" class="card-slot">
      <mcp-ask-question-card
        :interaction="cardInteraction"
        @respond="onCardRespond"
      />
    </view>

    <!-- 消息列表：历史 + 流式 -->
    <scroll-view class="msg-scroll" direction="vertical" :show-scrollbar="false">
      <view class="msg-list">
        <view
          v-for="h in historyList"
          :key="h.id"
          class="msg-item"
        >
          <UniAiXMsg
            :message-id="h.id"
            :body-text="h.text"
            :show-tool-bar="false"
          />
        </view>
        <!-- 流式消息 -->
        <view class="msg-item">
          <UniAiXMsg
            message-id="stream"
            :body-text="streamText"
            :show-tool-bar="false"
            :is-conversation-active="running"
          />
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  /**
   * 流式渲染性能测试页（隔离复现 Android 卡顿 / 假死 / 输出不全）
   *
   * 路由  /pages/test-stream-perf/test-stream-perf
   * 用法：
   *  1. 调「历史消息」到 0，开流式 → 纯文本流式基线（应流畅）。
   *  2. 历史调到 50/100 → 看长列表 diff 是否热点。
   *  3. 开「复杂 Markdown」（含公式/表格/代码）→ 看 markdown 重解析是否热点。
   *  4. 开「干预卡片」→ 看卡片常驻是否热点（对比假死是否复现）。
   * 帧率掉到 <20 或最大帧间隔 >100ms 即出现卡顿。
   */
  import { ref, onUnmounted } from "vue";
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import UniAiXMsg from "@/subpackages/components/ai-msg/ai-msg.uvue";
  import McpAskQuestionCard from "@/components/agent-intervention/mcp-ask-question-card/mcp-ask-question-card.uvue";
  import { asReadableMcp } from "@/subpackages/pages/chat-conversation-component/utils/mcpAskInterventionState.uts";
  import { mockMcpAskSurvey } from "@/utils/mockInterventionData";
  import type { McpAskRespondPayload } from "@/types/intervention";

  class HistoryMsg {
    id: string = "";
    text: string = "";
    constructor(id: string, text: string) {
      this.id = id;
      this.text = text;
    }
  }

  const FLUSH_MS = 40; // 与生产 STREAM_UI_COALESCE_MS 一致

  const running = ref(false);
  const historyCount = ref(0);
  const mdType = ref(0); // 0 纯文本 1 表格 2 公式 3 代码 4 混合
  const showCard = ref(false);
  const historyList = ref<HistoryMsg[]>([] as HistoryMsg[]);
  const streamText = ref("");
  const chunkCount = ref(0);
  const avgFps = ref(0);
  const maxGap = ref(0);

  let timer: number = 0;
  let lastTick: number = 0;
  let gapSum: number = 0;
  let gapSamples: number = 0;

  // 干预卡片 interaction（可读 UTSJSONObject，与生产一致）
  const cardInteraction = asReadableMcp(mockMcpAskSurvey());

  const PLAIN_CHUNK =
    "这是一段普通的流式文本，用来测试纯文本渲染的基线性能。";
  const TABLE_CHUNK =
    "\n\n| 列A | 列B | 列C |\n| --- | --- | --- |\n| a1 | b1 | c1 |\n| a2 | b2 | c2 |\n| a3 | b3 | c3 |";
  const MATH_CHUNK =
    "\n\n行内公式 $E = mc^2$ 与块级：\n\n$$\\int_0^1 x^2 \\, dx = \\frac{1}{3}$$\n\n$$\\sum_{i=1}^{n} i = \\frac{n(n+1)}{2}$$";
  const CODE_CHUNK =
    "\n\n```ts\nfunction fib(n: number): number {\n  return n <= 1 ? n : fib(n - 1) + fib(n - 2);\n}\n```";
  const COMPLEX_CHUNK =
    TABLE_CHUNK + MATH_CHUNK + CODE_CHUNK + "\n\n- 列表项一\n\n**加粗** `code`。";

  // mdType: 0 纯文本 1 表格 2 公式 3 代码 4 混合
  const currentChunk = (): string => {
    if (mdType.value == 1) return TABLE_CHUNK;
    if (mdType.value == 2) return MATH_CHUNK;
    if (mdType.value == 3) return CODE_CHUNK;
    if (mdType.value == 4) return COMPLEX_CHUNK;
    return PLAIN_CHUNK;
  };

  const buildHistory = () => {
    const list: HistoryMsg[] = [] as HistoryMsg[];
    for (let i = 0; i < historyCount.value; i++) {
      list.push(new HistoryMsg(`h_${i}`, `历史消息 #${i}：${currentChunk()}`));
    }
    historyList.value = list;
  };

  const onHistoryChange = (v: number) => {
    historyCount.value = v;
    buildHistory();
  };

  const onHistorySliderChange = (e: UniSliderChangeEvent) => {
    onHistoryChange(e.detail.value);
  };

  const setMdType = (v: number) => {
    mdType.value = v;
    buildHistory();
  };

  const mdTypeLabel = (v: number): string => {
    if (v == 1) return "表格";
    if (v == 2) return "公式";
    if (v == 3) return "代码";
    if (v == 4) return "混合";
    return "纯文本";
  };

  const toggleCard = () => {
    showCard.value = !showCard.value;
  };

  const tick = () => {
    const now = Date.now();
    if (lastTick > 0) {
      const gap = now - lastTick;
      if (gap > maxGap.value) maxGap.value = gap;
      gapSum += gap;
      gapSamples += 1;
      avgFps.value = Math.round(1000 / (gapSum / gapSamples));
    }
    lastTick = now;
    streamText.value += currentChunk();
    chunkCount.value += 1;
  };

  const start = () => {
    if (running.value) return;
    running.value = true;
    timer = setInterval(() => {
      tick();
    }, FLUSH_MS);
  };

  const stop = () => {
    running.value = false;
    if (timer != 0) {
      clearInterval(timer);
      timer = 0;
    }
  };

  const reset = () => {
    stop();
    streamText.value = "";
    chunkCount.value = 0;
    avgFps.value = 0;
    maxGap.value = 0;
    lastTick = 0;
    gapSum = 0;
    gapSamples = 0;
  };

  const onCardRespond = (_payload: McpAskRespondPayload) => {
    uni.showToast({ title: "卡片已响应", icon: "none" });
  };

  onUnmounted(() => {
    stop();
  });
</script>

