/** 会话滚动的互斥模式；代替多个 timer + autoToLastMsg boolean 隐式竞争。 */
export type ConversationScrollMode =
  "initializing" | "follow-bottom" | "free-scroll" |
  "programmatic" | "prepend-compensating" | "settling";

export class ConversationScrollState {
  private modeValue: ConversationScrollMode = "initializing";
  private touchActive: boolean = false;

  mode(): ConversationScrollMode { return this.modeValue; }
  isTouchActive(): boolean { return this.touchActive; }
  shouldFollowBottom(): boolean { return this.modeValue == "follow-bottom"; }
  mayMeasure(): boolean {
    return this.touchActive != true && this.modeValue != "settling";
  }
  mayCompensateAnchor(): boolean {
    return (
      this.touchActive != true &&
      this.modeValue != "follow-bottom" &&
      this.modeValue != "initializing"
    );
  }

  historyReady(): void { this.modeValue = "follow-bottom"; }
  beginTouch(): void {
    this.touchActive = true;
    this.modeValue = "free-scroll";
  }
  endTouch(): void { this.touchActive = false; }
  reachedBottom(): void {
    if (this.touchActive != true) this.modeValue = "follow-bottom";
  }
  leaveBottomByUser(): void { this.modeValue = "free-scroll"; }
  beginProgrammaticScroll(): void { this.modeValue = "programmatic"; }
  finishProgrammaticScroll(atBottom: boolean): void {
    this.modeValue = atBottom ? "follow-bottom" : "free-scroll";
  }
  beginPrepend(): void { this.modeValue = "prepend-compensating"; }
  finishPrepend(): void { this.modeValue = "free-scroll"; }
  beginSettle(): void { this.modeValue = "settling"; }
  finishSettle(atBottom: boolean): void {
    this.modeValue = atBottom ? "follow-bottom" : "free-scroll";
  }
}
