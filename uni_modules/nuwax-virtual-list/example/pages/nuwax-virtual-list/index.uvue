<!--
  nuwax-virtual-list 示例页
  使用方式：将本文件连同 nuwax-virtual-list 组件一起拷入宿主项目，并在 pages.json 注册
  { "path": "pages/nuwax-virtual-list/index" }
  本示例演示：500 条动态高度数据 + 虚拟滚动 + 底部跟随 + 追加/前插/长高操作。
-->
<template>
  <view class="hsp-page page-container">
    <view class="hsp-toolbar">
      <text class="hsp-btn" @click="onAppend">追加</text>
      <text class="hsp-btn" @click="onPrepend">前插</text>
      <text class="hsp-btn" @click="onGrowLast">长高最后一项</text>
      <text class="hsp-btn" @click="onBottom">滚底</text>
      <text class="hsp-btn" @click="onTop">滚顶</text>
    </view>
    <view class="hsp-body">
      <nuwax-virtual-list
        ref="listRef"
        :data="list"
        :item-height="56"
        :buffer-count="10"
        key-field="key"
        :follow-bottom="true"
        @scroll="onScroll"
      >
        <template #item="sp">
          <view class="hsp-item">
            <view class="hsp-item-head">
              <text class="hsp-index">{{ sp.index }}</text>
              <text class="hsp-title">{{ field(sp.item, 'title') }}</text>
            </view>
            <text class="hsp-desc" v-if="hasDesc(sp.item)">{{ field(sp.item, 'desc') }}</text>
          </view>
        </template>
      </nuwax-virtual-list>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  // H5 建议显式导入（easycom 扫描不到 uni_modules 时）
  import NuwaxVirtualList from "@/uni_modules/nuwax-virtual-list/components/nuwax-virtual-list/nuwax-virtual-list.uvue";

  const listRef = ref<any | null>(null);

  // ==================== 模板辅助（UTS 函数声明不提升，须先定义） ====================
  function readField(item: any | null, key: string): string {
    if (item == null) return "";
    try {
      const obj = item as UTSJSONObject;
      const v = obj[key];
      if (v != null) return `${v}`;
    } catch (_e) {
      // ignore
    }
    return "";
  }

  function field(item: any | null, key: string): string {
    return readField(item, key);
  }

  function hasDesc(item: any | null): boolean {
    return readField(item, "desc").length > 0;
  }

  // ==================== 数据 ====================
  let nextIndex = 0;
  const list = ref<Array<UTSJSONObject>>([] as Array<UTSJSONObject>);

  function makeItem(index: number): UTSJSONObject {
    const lines = (index % 5) + 1;
    let desc = "";
    for (let l = 0; l < lines; l++) {
      desc += `第 ${l + 1} 行：内容长度变化 → 高度自动测量。`;
    }
    return {
      "key": `item-${index}`,
      "title": `Title #${index}`,
      "desc": desc,
    } as UTSJSONObject;
  }

  function build(count: number): Array<UTSJSONObject> {
    const out: Array<UTSJSONObject> = [];
    for (let i = 0; i < count; i++) {
      out.push(makeItem(nextIndex));
      nextIndex++;
    }
    return out;
  }

  list.value = build(500);

  // ==================== 数据操作 ====================
  function onAppend(): void {
    list.value = [...list.value, makeItem(nextIndex)];
    nextIndex++;
  }

  function onPrepend(): void {
    const fresh = [] as Array<UTSJSONObject>;
    fresh.push(makeItem(nextIndex));
    nextIndex++;
    list.value = [...fresh, ...list.value];
  }

  function onGrowLast(): void {
    if (list.value.length == 0) return;
    const last = list.value[list.value.length - 1];
    const key = field(last, "key");
    const title = field(last, "title");
    const newList = [...list.value] as Array<UTSJSONObject>;
    newList[newList.length - 1] = {
      "key": key,
      "title": title,
      "desc": field(last, "desc") + " 长高后的追加内容行。",
    } as UTSJSONObject;
    list.value = newList;
  }

  function listProxy(): ComponentPublicInstance | null {
    const ref = listRef.value as any | null;
    if (ref == null) return null;
    try {
      return ref as ComponentPublicInstance;
    } catch (_e) {
      return null;
    }
  }

  function onBottom(): void {
    const p = listProxy();
    if (p != null) p.$callMethod("scrollToBottom", true);
  }

  function onTop(): void {
    const p = listProxy();
    if (p != null) p.$callMethod("scrollToTop", false);
  }

  function onScroll(e: any): void {
    // 标准 UniScrollEvent，含 detail.scrollTop / detail.scrollHeight
  }
</script>

<style lang="scss" scoped>
  .hsp-page {
    display: flex;
    flex-direction: column;
    background-color: #f5f6f7;
  }

  .hsp-toolbar {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    padding: 16rpx 24rpx;
    background-color: #ffffff;
    flex-shrink: 0;
  }

  .hsp-btn {
    font-size: 22rpx;
    color: #2b6ef2;
    background-color: #eef4ff;
    border-radius: 16rpx;
    padding: 8rpx 20rpx;
    margin: 4rpx;
  }

  .hsp-body {
    flex: 1;
    min-height: 0;
  }

  .hsp-item {
    margin: 8rpx 24rpx;
    border-radius: 16rpx;
    padding: 20rpx 24rpx;
    background-color: #ffffff;
    border-left-width: 8rpx;
    border-left-color: #3bb346;
  }

  .hsp-item-head {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .hsp-index {
    font-size: 20rpx;
    color: #999;
    margin-right: 16rpx;
  }

  .hsp-title {
    font-size: 28rpx;
    color: #222;
    font-weight: bold;
  }

  .hsp-desc {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #555;
    line-height: 1.6;
  }
</style>
