<template>
  <!--
    创建群组页（原底部弹窗改整页，搜索页同款交互）：
    - 群名称（必填）+ 初始成员（用户/智能体双 tab，多选混选，可空；选人 tag 盒——点盒
      聚焦并展开下方常驻面板：默认按拼音字母序平铺当前用户联系人/智能体（contacts 按
      subjectType 分桶），点行以 tag 插回盒内；盒尾输入防抖 400ms 搜索（contacts/agents
      搜索接口），点结果同样插 tag 且保留关键词便于连续勾选，清空回默认列表；面板未展开
      时进群规则三段说明占列表位，展开后收列表尾）
    - 初始成员直接进群——用户无确认卡、智能体默认「唤起」
    - 确定后调创建群组接口，成功 redirectTo 新群消息详情页（替换本页，返回直达消息列表）
    - 非 tabBar 页：无需隐藏/恢复原生 tabBar，底部安全区由 footerStyle 内联兜底
  -->
  <view class="cg-page">
    <safety-zone />

    <!-- 顶部：返回 + 标题（群成员页同款页头） -->
    <view class="cg-header">
      <view class="cg-header__btn" hover-class="cg-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="cg-header__title-wrap">
        <text class="cg-header__title">{{ t("Mobile.Message.createGroup") }}</text>
      </view>
      <view class="cg-header__btn cg-header__btn--ghost" />
    </view>

    <!-- 表单：群名称 + 初始成员搜索 -->
    <view class="cg-form">
      <view class="cg-label-row">
        <text class="cg-req">*</text>
        <text class="cg-label">{{ t("Mobile.Message.groupName") }}</text>
      </view>
      <input
        class="cg-input"
        v-model="groupName"
        :placeholder="t('Mobile.Message.groupNamePlaceholder')"
        placeholder-class="cg-ph"
        :maxlength="32"
      />

      <view class="cg-label-row">
        <text class="cg-req">*</text>
        <text class="cg-label">{{ t("Mobile.Message.initialMembers") }}</text>
        <text class="cg-label-hint">{{ t("Mobile.Message.initialMembersHint") }}</text>
      </view>

      <!-- 成员 tab：用户 / 智能体（切 tab 只重置搜索态，已选 tag 保留可混选；
           无下划线，选中仅文字变色——同消息页 tab；标题后括号计数=各自桶已选数） -->
      <view class="cg-tabs">
        <view class="cg-tab" @click="switchTab('user')">
          <text
            class="cg-tab-text"
            :class="{ 'cg-tab-text--on': activeTab == 'user' }"
          >{{ t("Mobile.Message.buddyTabUser") }}<text v-if="userTabCount > 0" class="cg-tab-count">({{ userTabCount }})</text></text>
        </view>
        <view class="cg-tab" @click="switchTab('agent')">
          <text
            class="cg-tab-text"
            :class="{ 'cg-tab-text--on': activeTab == 'agent' }"
          >{{ t("Mobile.Message.buddyTabAgent") }}<text v-if="agentTabCount > 0" class="cg-tab-count">({{ agentTabCount }})</text></text>
        </view>
      </view>

      <!-- 按钮标签随 tab（添加伙伴页同款） -->
      <view class="cg-sublabel-row">
        <text class="cg-sublabel">
          {{ activeTab == 'user' ? t("Mobile.Message.searchUserLabel") : t("Mobile.Message.searchAgentLabel") }}
        </text>
      </view>
      <!-- 选人 tag 盒：点盒（任意空白处）聚焦并展开下方常驻面板；已选成员以 tag 芯片
           流式插在输入区前（点 × 移除），尾部输入关键词搜索、点结果同样插 tag -->
      <view class="cg-tagbox" @click="focusTagInput">
        <view class="cg-tagbox-main">
          <view
            v-for="m in selectedMembers"
            :key="m.userId"
            class="cg-tag"
            hover-class="cg-tag--active"
            @click.stop="toggleMember(m)"
          >
            <text class="cg-tag-text">{{ m.displayName }}</text>
            <text class="cg-tag-x">×</text>
          </view>
          <view class="cg-tagbox-field">
            <input
              class="cg-tagbox-input"
              v-model="memberKeyword"
              :focus="focusRequest"
              :placeholder="activeTab == 'user'
                ? t('Mobile.Message.searchMemberPlaceholder')
                : t('Mobile.Message.searchAgentPlaceholder')"
              placeholder-class="cg-ph"
              @focus="handleTagFocus"
              @blur="handleTagBlur"
            />
          </view>
        </view>
        <view class="cg-search-icon">
          <svg-icon name="icon-Search" size="28" color="#9a9aa2" />
        </view>
      </view>
    </view>

    <!-- 结果列表：面板未展开时进群规则三段说明占位；展开后 idle 态展示默认联系人/
         智能体（contacts 拉取、拼音字母序平铺，说明收列表尾）；输入后走搜索分支
         （智能体平台侧不可用单独提示，契约 degraded=true 时 items 为空≠没有结果） -->
    <scroll-view class="cg-list" direction="vertical" :show-scrollbar="false">
      <!-- 面板未展开（初始）：三段进群规则说明 -->
      <view v-if="!panelVisible" class="cg-hint cg-hint--intro">
        <text class="cg-hint-text">{{ t("Mobile.Message.createGroupHint1") }}</text>
        <text class="cg-hint-text">{{ t("Mobile.Message.createGroupHint2") }}</text>
        <text class="cg-hint-text">{{ t("Mobile.Message.createGroupHint3") }}</text>
      </view>
      <view v-else-if="searchState == 'idle' && defaultState == 'loading'" class="cg-state">
        <text class="cg-state-text">{{ t("Mobile.Common.loading") }}</text>
      </view>
      <view v-else-if="searchState == 'idle' && defaultState == 'failed'" class="cg-state" @click="loadDefaultMembers">
        <text class="cg-state-text">{{ t("Mobile.Message.loadFailed") }}</text>
      </view>
      <view v-else-if="searchState == 'idle' && sortedMembers.length == 0" class="cg-state">
        <text class="cg-state-text">{{ activeTab == 'user' ? t("Mobile.Message.emptyContact") : t("Mobile.Message.emptyAgentContact") }}</text>
      </view>
      <view v-else-if="searchState == 'idle'" class="cg-list-body">
        <view
          v-for="m in sortedMembers"
          :key="m.userId"
          class="cg-member"
          hover-class="cg-member--active"
          @click="toggleMember(m)"
        >
          <view class="cg-avatar">
            <image
              v-if="m.avatarUrl.length > 0 && m.avatarFailed != true"
              class="cg-avatar-img"
              :src="m.avatarUrl"
              mode="aspectFill"
              @error="handleAvatarError(m)"
            />
            <view
              v-else
              class="cg-avatar-fallback"
              :style="{ backgroundImage: avatarGradient(m.displayName) }"
            >
              <text class="cg-avatar-letter">{{ avatarLetter(m.displayName) }}</text>
            </view>
          </view>
          <view class="cg-member-main">
            <text class="cg-member-name text-ellipsis">{{ m.displayName }}</text>
            <text v-if="m.description.length > 0" class="cg-member-desc text-ellipsis">{{ m.description }}</text>
          </view>
          <view class="cg-check" :class="{ 'cg-check--on': isSelected(m.userId) }">
            <svg-icon v-if="isSelected(m.userId)" name="icon-Check" size="24" color="#ffffff" />
          </view>
        </view>
        <!-- 进群规则说明（原 idle 态三段灰字，默认列表落地后收列表尾） -->
        <view class="cg-hint cg-hint--tail">
          <text class="cg-hint-text">{{ t("Mobile.Message.createGroupHint1") }}</text>
          <text class="cg-hint-text">{{ t("Mobile.Message.createGroupHint2") }}</text>
          <text class="cg-hint-text">{{ t("Mobile.Message.createGroupHint3") }}</text>
        </view>
      </view>
      <view v-else-if="searchState == 'loading'" class="cg-state">
        <text class="cg-state-text">{{ t("Mobile.Common.loading") }}</text>
      </view>
      <view v-else-if="searchState == 'failed'" class="cg-state" @click="doSearchNow">
        <text class="cg-state-text">{{ t("Mobile.Message.loadFailed") }}</text>
      </view>
      <view v-else-if="searchState == 'unavailable'" class="cg-state" @click="doSearchNow">
        <text class="cg-state-text">{{ t("Mobile.Message.agentSearchUnavailable") }}</text>
      </view>
      <view v-else-if="searchState == 'done' && searchMembers.length == 0" class="cg-state">
        <text class="cg-state-text">{{ t("Mobile.AgentSearch.emptyResult") }}</text>
      </view>
      <view v-else class="cg-list-body">
        <view
          v-for="m in searchMembers"
          :key="m.userId"
          class="cg-member"
          hover-class="cg-member--active"
          @click="toggleMember(m)"
        >
          <view class="cg-avatar">
            <image
              v-if="m.avatarUrl.length > 0 && m.avatarFailed != true"
              class="cg-avatar-img"
              :src="m.avatarUrl"
              mode="aspectFill"
              @error="handleAvatarError(m)"
            />
            <view
              v-else
              class="cg-avatar-fallback"
              :style="{ backgroundImage: avatarGradient(m.displayName) }"
            >
              <text class="cg-avatar-letter">{{ avatarLetter(m.displayName) }}</text>
            </view>
          </view>
          <view class="cg-member-main">
            <text class="cg-member-name text-ellipsis">{{ m.displayName }}</text>
            <text v-if="m.description.length > 0" class="cg-member-desc text-ellipsis">{{ m.description }}</text>
          </view>
          <view class="cg-check" :class="{ 'cg-check--on': isSelected(m.userId) }">
            <svg-icon v-if="isSelected(m.userId)" name="icon-Check" size="24" color="#ffffff" />
          </view>
        </view>
        <!-- 平台侧查询失败：结果不完整提示（契约 degraded 标志） -->
        <view v-if="searchDegraded" class="cg-degraded">
          <text class="cg-degraded-text">{{ t("Mobile.Message.searchDegraded") }}</text>
        </view>
      </view>
      <view class="cg-tail" />
    </scroll-view>

    <!-- 底部按钮：取消=返回，确定=建群后跳新群会话 -->
    <view class="cg-footer" :style="footerStyle">
      <view class="cg-btn" hover-class="cg-btn-cancel--active" @click="handleBack">
        <text class="cg-btn-text cg-btn-text--cancel">{{ t("Mobile.Common.cancel") }}</text>
      </view>
      <view class="cg-btn cg-btn--ok" hover-class="cg-btn-ok--active" @click="handleConfirm">
        <text class="cg-btn-text cg-btn-text--ok">
          {{ submitting ? t("Mobile.Common.loading") : t("Mobile.Common.ok") }}
        </text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { switchMainTab } from "@/utils/mainTabNavigation";

  import { computed, nextTick, onUnmounted, ref, watch } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { imAvatarDisplayUrl, resolveImAvatarDisplay } from "@/utils/imAvatarDisplay";
  import { cnFirstLetter } from "@/utils/cn-initials";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { apiImContacts, apiImCreateGroup, apiImSearchAgents, apiImSearchContacts } from "@/servers/im";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 成员行（搜索结果与已选共用；description 仅智能体 tab 有；isAgent 供 tab
   *  标题角标按桶计数——已选混选时用户/智能体 tab 各显各自数量）。 */
  class CgMember {
    userId: string = "";
    displayName: string = "";
    avatarRaw: string = "";
    avatarUrl: string = "";
    avatarFailed: boolean = false;
    description: string = "";
    isAgent: boolean = false;
  }

  /** 头像字母底色渐变板（对齐消息页五色系）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  const groupName = ref<string>("");
  /** 成员搜索 tab：user=人（searchContacts）| agent=智能体（contactSearchAgents）；
   *  两类 userId 同空间，已选 tag 可混选（切 tab 不清已选）。 */
  const activeTab = ref<string>("user");
  const memberKeyword = ref<string>("");
  /** 搜索结果（仅当次关键字命中；初始不加载，输入才搜） */
  const searchMembers = ref<CgMember[]>([]);
  /** idle=未输入 | loading | failed | done */
  const searchState = ref<string>("idle");
  const searchDegraded = ref<boolean>(false);
  /** 默认列表（contacts）：用户/智能体两桶按 subjectType 分（打开即加载，搜索态隐藏不清） */
  const defaultUsers = ref<CgMember[]>([]);
  const defaultAgents = ref<CgMember[]>([]);
  /** 默认列表加载态：loading | ready | failed（与搜索态解耦） */
  const defaultState = ref<string>("loading");
  /** 默认列表加载防重入 */
  let defaultLoading = false;
  /** 已选成员独立持有（跨关键字/多次搜索保持，tag 芯片与提交都用它） */
  const selectedMembers = ref<CgMember[]>([]);
  /** 选人面板：点 tag 盒展开后常驻（不因键盘收起/失焦收起），提交/离开页面才结束 */
  const panelVisible = ref<boolean>(false);
  /** 程序化聚焦边沿驱动（chat.uvue focusChatInput 同款）：false → nextTick → true */
  const focusRequest = ref<boolean>(false);
  /** input 实际聚焦态（已聚焦时不再重复拉焦，避免边沿失效） */
  const inputFocused = ref<boolean>(false);
  const submitting = ref<boolean>(false);
  /** 输入防抖定时器 + 搜索序号（旧请求晚归丢弃，防竞态串结果） */
  let searchDebounceTimer = -1;
  let searchSeq = 0;

  /**
   * 底部安全距离（同原底部弹窗版）：App 端样式表 env(safe-area-inset-bottom)
   * 不可靠，内联把底部内边距改为 24rpx 基础 + 系统安全区（px），按钮避开
   * iPhone home 条；H5/小程序走样式表 env()，不叠加。
   */
  const footerStyle = computed((): string => {
    let style = "";
    // #ifdef APP
    try {
      const win = uni.getWindowInfo();
      const scale = win.windowWidth / 750;
      const basePx = scale > 0 ? Math.round(24 * scale) : 24;
      style = `padding-bottom: ${basePx + win.safeAreaInsets.bottom}px;`;
    } catch (_e) {
      style = "";
    }
    // #endif
    return style;
  });

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  /** 批量解析头像展示地址（/api/f/ 受保护与远程 SVG；H5 裸连 <img> 会被 ORB 拦）。
   * ★须在对应 ref 数组 .value 赋值后调、传 ref 数组本身（响应式代理实例），异步写回才会
   * 触发渲染刷新——建行期 new 出的裸实例上写回不刷新（message.uvue resolveConvRowsIcons 同款）。 */
  function resolveRowAvatars(rows: CgMember[]): void {
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      const raw = row.avatarRaw;
      if (raw.length == 0 || row.avatarUrl.length > 0) {
        continue;
      }
      resolveImAvatarDisplay(raw, 72).then((resolved: string) => {
        if (resolved != raw && resolved != row.avatarUrl) {
          row.avatarUrl = resolved;
          row.avatarFailed = false; // 首帧失败可能已标死字母兜底，解析成功救回
        }
      });
    }
  }

  /** 搜索响应行（用户 tab）：ContactSearchItem 无 displayName，展示名按 nickName > userName 回落。 */
  function readSearchMember(item: UTSJSONObject): CgMember | null {
    const row = new CgMember();
    row.userId = readString(item, "userId");
    if (row.userId.length == 0) {
      return null;
    }
    const nickName = readString(item, "nickName");
    row.displayName = nickName.length > 0 ? nickName : readString(item, "userName");
    row.avatarRaw = readString(item, "avatar");
    row.avatarUrl = imAvatarDisplayUrl(row.avatarRaw, 72);
    return row;
  }

  /** 搜索响应行（智能体 tab）：AgentSearchItem 的 name/description/avatar。 */
  function readAgentRow(item: UTSJSONObject): CgMember | null {
    const row = new CgMember();
    row.userId = readString(item, "userId");
    if (row.userId.length == 0) {
      return null;
    }
    row.displayName = readString(item, "name");
    row.description = readString(item, "description");
    row.avatarRaw = readString(item, "avatar");
    row.avatarUrl = imAvatarDisplayUrl(row.avatarRaw, 72);
    row.isAgent = true;
    return row;
  }

  /** 默认列表响应行（contactList 的 ContactItem）：displayName 服务端已按
   *  remark > nickName > userName 算好，缺键时逐级回落（智联录同口径）。 */
  function readContactRow(item: UTSJSONObject): CgMember | null {
    const row = new CgMember();
    row.userId = readString(item, "userId");
    if (row.userId.length == 0) {
      return null;
    }
    const display = readString(item, "displayName");
    const nickName = readString(item, "nickName");
    row.displayName = display.length > 0 ? display : nickName;
    row.avatarRaw = readString(item, "avatar");
    row.avatarUrl = imAvatarDisplayUrl(row.avatarRaw, 72);
    return row;
  }

  /**
   * 默认列表：拉当前用户联系人（contactList），status=1（已互为联系人）才收——
   * 2/3 是待确认态，混进默认列表会导致建群提交无权限目标；subjectType=1 进用户桶、
   * 其余进智能体桶，两 tab 各持一桶。★先落 ref 再解析头像（异步写回只有 ref 数组
   * 内代理实例才触发重渲）。
   */
  async function loadDefaultMembers(): Promise<void> {
    if (defaultLoading) {
      return;
    }
    defaultLoading = true;
    defaultState.value = "loading";
    try {
      const res = await apiImContacts();
      if (apiResCode(res) != SUCCESS_CODE) {
        defaultState.value = "failed";
        return;
      }
      const users: CgMember[] = [];
      const agents: CgMember[] = [];
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const item = items[i];
            if (readNumber(item, "status", 1) != 1) {
              continue;
            }
            const row = readContactRow(item);
            if (row == null) {
              continue;
            }
            if (readNumber(item, "subjectType", 1) == 1) {
              users.push(row);
            } else {
              row.isAgent = true;
              agents.push(row);
            }
          }
        }
      }
      defaultUsers.value = users;
      defaultAgents.value = agents;
      resolveRowAvatars(defaultUsers.value);
      resolveRowAvatars(defaultAgents.value);
      defaultState.value = "ready";
    } catch (e) {
      defaultState.value = "failed";
    } finally {
      defaultLoading = false;
    }
  }

  /**
   * 默认列表拼音字母序（@选择页 groups 同款口径，平铺不渲染字母头）：首字母分桶 →
   * A-Z 升序、# 末尾 → 桶内按显示名纯字符串比较 → 顺序连接。纯字符串整排会让中文
   * 按 Unicode 码点序（"张"排在"李"前），分桶连接才保证按拼音首字母序。
   */
  const sortedMembers = computed((): CgMember[] => {
    const buckets = new Map<string, CgMember[]>();
    const keys: string[] = [];
    const all = activeTab.value == "agent" ? defaultAgents.value : defaultUsers.value;
    for (let i = 0; i < all.length; i++) {
      const m = all[i];
      const letter = cnFirstLetter(m.displayName);
      let bucket = buckets.get(letter);
      if (bucket == null) {
        bucket = [];
        buckets.set(letter, bucket);
        keys.push(letter);
      }
      bucket.push(m);
    }
    const azKeys: string[] = [];
    let hasHash = false;
    for (let i = 0; i < keys.length; i++) {
      if (keys[i] == "#") {
        hasHash = true;
      } else {
        azKeys.push(keys[i]);
      }
    }
    azKeys.sort((a: string, b: string): number => (a < b ? -1 : a > b ? 1 : 0));
    if (hasHash) {
      azKeys.push("#");
    }
    const out: CgMember[] = [];
    for (let i = 0; i < azKeys.length; i++) {
      const bucket = buckets.get(azKeys[i]);
      if (bucket == null) {
        continue;
      }
      bucket.sort((a: CgMember, b: CgMember): number => (a.displayName < b.displayName ? -1 : a.displayName > b.displayName ? 1 : 0));
      for (let j = 0; j < bucket.length; j++) {
        out.push(bucket[j]);
      }
    }
    return out;
  });

  /** tab 标题角标：已选成员里用户/智能体各自数量（跨 tab 混选分桶计数，随 tag 增删联动）。 */
  const userTabCount = computed((): number => {
    let n = 0;
    const sel = selectedMembers.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].isAgent != true) {
        n++;
      }
    }
    return n;
  });

  const agentTabCount = computed((): number => {
    let n = 0;
    const sel = selectedMembers.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].isAgent == true) {
        n++;
      }
    }
    return n;
  });

  /** 回初始态：清结果/清防抖定时器/序号自增（作废在途请求）。 */
  function resetSearchIdle(): void {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
    searchSeq++;
    searchState.value = "idle";
    searchDegraded.value = false;
    searchMembers.value = [];
  }

  /** 切成员 tab：数据源不同，重置关键字/结果（已选成员与群名保留——可跨 tab 混选）。 */
  function switchTab(tab: string): void {
    if (activeTab.value == tab) {
      return;
    }
    activeTab.value = tab;
    memberKeyword.value = "";
    resetSearchIdle();
  }

  /** 用当前关键字立即搜索（防抖到期或失败重试触发），按 tab 走对应接口。 */
  async function doSearchNow(): Promise<void> {
    const kw = memberKeyword.value.trim();
    if (kw.length == 0) {
      resetSearchIdle();
      return;
    }
    const tab = activeTab.value;
    const seq = ++searchSeq;
    searchState.value = "loading";
    searchDegraded.value = false;
    try {
      const res = tab == "agent"
        ? await apiImSearchAgents(kw, 1, 20)
        : await apiImSearchContacts(kw, 20);
      // 期间又有新输入/清空/切 tab：本请求作废，不覆盖新状态
      if (seq != searchSeq || tab != activeTab.value) {
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        searchState.value = "failed";
        return;
      }
      const rows: CgMember[] = [];
      let degraded = false;
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        degraded = readBool(dataObj, "degraded");
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const row = tab == "agent" ? readAgentRow(items[i]) : readSearchMember(items[i]);
            if (row != null) {
              rows.push(row);
            }
          }
        }
      }
      // 智能体契约：degraded=true ⇒ 平台不可用且 items 为空（≠没有结果），单独提示；
      // 用户 tab degraded 仅表示结果可能不全，列表尾提示（searchDegraded）
      if (tab == "agent" && degraded) {
        searchState.value = "unavailable";
        return;
      }
      searchMembers.value = rows;
      resolveRowAvatars(searchMembers.value);
      searchDegraded.value = degraded;
      searchState.value = "done";
    } catch (e) {
      if (seq == searchSeq && tab == activeTab.value) {
        searchState.value = "failed";
      }
    }
  }

  /** 输入防抖 400ms：停顿后才发请求（连打只发最后一次）；清空立即回初始态。 */
  watch(memberKeyword, (val: string) => {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
    if (val.trim().length == 0) {
      resetSearchIdle();
      return;
    }
    searchDebounceTimer = setTimeout(() => {
      searchDebounceTimer = -1;
      doSearchNow();
    }, 400);
  });

  function isSelected(userId: string): boolean {
    const sel = selectedMembers.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].userId == userId) {
        return true;
      }
    }
    return false;
  }

  function toggleMember(m: CgMember): void {
    const next: CgMember[] = [];
    let removed = false;
    const sel = selectedMembers.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].userId == m.userId) {
        removed = true;
      } else {
        next.push(sel[i]);
      }
    }
    if (removed != true) {
      next.push(m);
    }
    selectedMembers.value = next;
  }

  /** 点 tag 盒（任意空白处）：展开面板 + 未聚焦时边沿驱动拉起键盘。 */
  function focusTagInput(): void {
    panelVisible.value = true;
    if (inputFocused.value) {
      return;
    }
    focusRequest.value = false;
    nextTick((): void => {
      focusRequest.value = true;
    });
  }

  /** input 原生聚焦：记录聚焦态 + 展开面板（直接点 input 本体的双保险）。 */
  function handleTagFocus(): void {
    inputFocused.value = true;
    panelVisible.value = true;
  }

  /** input 失焦：只复位聚焦边沿，面板常驻不收（重点盒空白可再拉键盘）。 */
  function handleTagBlur(): void {
    inputFocused.value = false;
    focusRequest.value = false;
  }

  function handleAvatarError(m: CgMember): void {
    m.avatarFailed = true;
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  /**
   * 确定：校验群名 → 建群 → redirectTo 新群消息详情页（替换本页，
   * 返回直达消息列表——与原弹窗「关弹窗后跳转」同栈序）。
   */
  async function handleConfirm(): Promise<void> {
    if (submitting.value) {
      return;
    }
    const name = groupName.value.trim();
    if (name.length == 0) {
      uni.showToast({ title: t("Mobile.Message.groupNameRequired"), icon: "none" });
      return;
    }
    submitting.value = true;
    try {
      const ids: string[] = [];
      const sel = selectedMembers.value;
      for (let i = 0; i < sel.length; i++) {
        ids.push(sel[i].userId);
      }
      const res = await apiImCreateGroup(name, ids);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.createGroupFailed"), icon: "none" });
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      const convId = dataObj != null ? readString(dataObj, "convId") : "";
      if (convId.length == 0) {
        uni.showToast({ title: t("Mobile.Message.createGroupFailed"), icon: "none" });
        return;
      }
      uni.redirectTo({
        url:
          `/pages/message/chat?convId=${convId}&convType=2` +
          `&name=${encodeURIComponent(name)}&avatar=`,
      });
    } catch (e) {
      uni.showToast({ title: t("Mobile.Message.createGroupFailed"), icon: "none" });
    } finally {
      submitting.value = false;
    }
  }

  function handleBack(): void {
    // 刷新后栈底保护：同搜索页，无页可退时切回消息 tab，避免整页重载死循环
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      switchMainTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((_options: OnLoadOptions) => {
    loadDefaultMembers();
  });

  onUnmounted(() => {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架（白底，表单视觉与原底部弹窗一致） ===== */
  .cg-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #ffffff;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  .cg-header {
    flex-shrink: 0;
    height: 104rpx;
    padding: 0 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-bottom: 2rpx solid #eceaf1;
  }

  .cg-header__btn {
    width: 72rpx;
    height: 72rpx;
    border-radius: 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cg-header__btn--active {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .cg-header__btn--ghost {
    background-color: rgba(0, 0, 0, 0);
  }

  .cg-header__title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .cg-header__title {
    max-width: 460rpx;
    font-size: 33rpx;
    line-height: 46rpx;
    font-weight: 600;
    color: #17171a;
  }

  /* ===== 表单 ===== */
  .cg-form {
    flex-shrink: 0;
    padding: 8rpx 32rpx 0;
  }

  .cg-label-row {
    margin-top: 20rpx;
    margin-bottom: 12rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .cg-req {
    color: #e5414b;
    font-size: 26rpx;
    line-height: 36rpx;
    margin-right: 6rpx;
  }

  .cg-label {
    color: #1c1b20;
    font-size: 28rpx;
    line-height: 40rpx;
    font-weight: 600;
  }

  /* 标签尾灰字说明（初始成员：可稍后再加，至少 1 名） */
  .cg-label-hint {
    margin-left: 8rpx;
    color: #9a9aa2;
    font-size: 24rpx;
    line-height: 34rpx;
    font-weight: 400;
  }

  /* ===== 成员 tab：用户 / 智能体（同添加伙伴页：激活态无短横线，选中仅文字变色；分割线保留） ===== */
  .cg-tabs {
    margin-top: 8rpx;
    display: flex;
    flex-direction: row;
    border-bottom: 2rpx solid #f0eff7;
  }

  .cg-tab {
    margin-right: 64rpx;
    padding: 12rpx 4rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cg-tab-text {
    color: #9a9aa2;
    font-size: 28rpx;
    line-height: 40rpx;
  }

  .cg-tab-text--on {
    color: #5147ff;
    font-weight: 600;
  }

  /* tab 标题角标计数：26rpx + 左留白与文案分隔（颜色/字重随 tab 选中态继承） */
  .cg-tab-count {
    margin-left: 8rpx;
    font-size: 26rpx;
  }

  .cg-sublabel-row {
    margin-top: 20rpx;
    margin-bottom: 12rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .cg-sublabel {
    color: #9a9aa2;
    font-size: 24rpx;
    line-height: 34rpx;
  }

  .cg-input {
    height: 80rpx;
    padding: 0 24rpx;
    border-radius: 20rpx;
    background-color: #f6f5f8;
    font-size: 28rpx;
    color: #1c1b20;
  }

  /* ===== 选人 tag 盒：已选成员芯片流式插在输入区前，尾部关键词输入 ===== */
  .cg-tagbox {
    min-height: 80rpx;
    padding: 8rpx 8rpx 8rpx 24rpx;
    border-radius: 20rpx;
    background-color: #f6f5f8;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    box-sizing: border-box;
  }

  /* Android 原生输入控件底部视觉偏高，先只去掉成员搜索盒下内边距验证高度差。 */
  /* #ifdef APP-ANDROID */
  .cg-tagbox {
    padding-bottom: 0;
  }
  /* #endif */

  .cg-tagbox-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }

  /* 输入外固定高行槽：Android EditText 按内容行盒测量、可超 CSS 高（去掉 App 端
     line-height 后仍略超 64rpx），直接作 flex 子项会把 tag 盒撑过 80rpx 比群名称框
     高（真机实测）；固定高 view 钳住行高（同添加伙伴页 ab-search 固定高容器做法），
     超出部分裁掉，行槽内居中保证光标视觉居中 */
  .cg-tagbox-field {
    flex: 1;
    min-width: 120rpx;
    height: 64rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
  }

  .cg-tagbox-input {
    flex: 1;
    /* H5 高度+行高必须同值成对设：uvue 运行时 uni-input{height:auto;display:flex}
       后加载覆盖经典 height:1.4em，placeholder 是绝对定位盒子（top:auto +
       line-height:inherit），缺任一都会让它的静态位贴顶偏上（Playwright 实测） */
    height: 64rpx;
    /* #ifdef H5 */
    line-height: 64rpx;
    /* #endif */
    font-size: 28rpx;
    color: #1c1b20;
  }

  .cg-search-icon {
    width: 64rpx;
    height: 64rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cg-ph {
    color: #b7b7be;
    font-size: 26rpx;
  }

  /* 灰盒内白芯 tag（描边分隔），点 × 或整芯移除 */
  .cg-tag {
    margin: 0 16rpx 12rpx 0;
    padding: 8rpx 20rpx;
