<template>
  <view class="voice-panel">
    <view v-if="panelState == 'idle'" class="idle-row">
      <view class="voice-action voice-action-secondary" @tap="toggleLatestPlayback">
        <text class="action-icon">{{ isPlaying ? "■" : "▶" }}</text>
        <text class="action-label">{{ isPlaying ? t("Mobile.Voice.stopPlaying") : t("Mobile.Voice.playLatest") }}</text>
      </view>
      <streaming-voice-recorder-button
        class="recorder-button"
        :is-conversation-active="props.isConversationActive"
        @onRecordStart="handleRecordStart"
        @onStreamingText="handleStreamingText"
        @onError="handleRecordError"
        @onRecordCancel="handleRecordCancel"
      />
      <view class="settings-button" @tap="openSettings">
        <svg-icon name="icon-settings" />
      </view>
    </view>

    <view v-else-if="panelState == 'recording'" class="recording-row">
      <view class="recording-dot"></view>
      <text class="recording-text">{{ liveTranscript.length > 0 ? liveTranscript : t("Mobile.Voice.recognizing") }}</text>
    </view>

    <view v-else class="editing-box">
      <textarea
        class="voice-editor"
        :value="draftText"
        :placeholder="t('Mobile.Voice.editHint')"
        :auto-height="true"
        :maxlength="-1"
        @input="handleDraftInput"
      />
      <view class="editing-actions">
        <button class="edit-button cancel-button" @tap="cancelDraft">{{ t("Mobile.Voice.cancel") }}</button>
        <button class="edit-button send-button" @tap="sendDraft">{{ t("Mobile.Voice.send") }}</button>
      </view>
    </view>

    <voice-setting-modal ref="voiceSettingModalRef" @change="handleSettingsChange" />
  </view>
</template>

<script lang="uts" setup>
  import { ref, watch, onMounted, onUnmounted } from "vue";
  import StreamingVoiceRecorderButton from "./streaming-voice-recorder-button/streaming-voice-recorder-button.uvue";
  import VoiceSettingModal from "@/subpackages/components/voice-setting-modal/voice-setting-modal.uvue";
  import { audioPlayerManager } from "@/subpackages/utils/voice/audioPlayerManager";
  import { streamingAsrService } from "@/subpackages/utils/voice/streamingAsrService";
  import { cleanTextForSpeech, extractSpeakableSentences } from "@/subpackages/utils/voice/textFilter";
  import { ttsService } from "@/subpackages/utils/voice/ttsService";
  import { voiceConfig } from "@/subpackages/utils/voice/voiceConfig";
  import { voiceStreamSpeaker } from "@/subpackages/utils/voice/voiceStreamSpeaker";
  import { VoiceSettings, cloneVoiceSettings, loadVoiceSettings } from "@/subpackages/utils/voice/voiceTypes";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";

  type PanelState = "idle" | "recording" | "editing";

  const props = withDefaults(defineProps<{
    assistantMsgId?: string;
    streamText?: string;
    thinkText?: string;
    streamStatus?: string;
    lastUserMsgId?: string;
    lastUserMsgText?: string;
    isConversationActive?: boolean;
    conversationKey?: string;
  }>(), {
    assistantMsgId: "",
    streamText: "",
    thinkText: "",
    streamStatus: "",
    lastUserMsgId: "",
    lastUserMsgText: "",
    isConversationActive: false,
    conversationKey: "",
  });

  const emit = defineEmits<{
    sendVoiceMessage: [text: string];
  }>();

  const { t: tFn } = useI18n();
  function t(key: string): string {
    return tFn(key, emptyI18nParams(), "");
  }

  const panelState = ref<PanelState>("idle");
  const liveTranscript = ref<string>("");
  const draftText = ref<string>("");
  const isPlaying = ref<boolean>(false);
  const voiceSettings = ref<VoiceSettings>(new VoiceSettings());
  const voiceSettingModalRef = ref<any | null>(null);

  let pendingRound: boolean = false;
  let pendingUserBaseline: string = "";
  let sentText: string = "";
  let awaitingAssistant: boolean = false;
  let activeStreamId: string = "";
  let manualPlayGeneration: number = 0;

  function isStreamFinished(): boolean {
    return props.streamStatus == "complete" || props.streamStatus == "error";
  }

  function clearRoundHandshake(): void {
    pendingRound = false;
    pendingUserBaseline = "";
    sentText = "";
    awaitingAssistant = false;
  }

  function stopAllAudio(): void {
    manualPlayGeneration += 1;
    activeStreamId = "";
    voiceStreamSpeaker.stop();
    audioPlayerManager.stop();
    isPlaying.value = false;
  }

  function resetPanel(): void {
    streamingAsrService.cancel();
    stopAllAudio();
    clearRoundHandshake();
    panelState.value = "idle";
    liveTranscript.value = "";
    draftText.value = "";
  }

  function feedCurrentStream(): void {
    if (activeStreamId.length == 0 || activeStreamId != props.assistantMsgId) {
      return;
    }
    voiceStreamSpeaker.onStreamChunk(
      props.streamText,
      props.thinkText,
      isStreamFinished(),
    );
  }

  function handleRecordStart(): void {
    stopAllAudio();
    clearRoundHandshake();
    liveTranscript.value = "";
    draftText.value = "";
    panelState.value = "recording";
  }

  function handleStreamingText(text: string, isFinal: boolean): void {
    liveTranscript.value = text;
    if (isFinal == true) {
      draftText.value = text;
      if (text.trim().length == 0) {
        uni.showToast({ title: t("Mobile.Voice.noSpeechDetected"), icon: "none" });
        panelState.value = "idle";
      } else {
        panelState.value = "editing";
      }
    }
  }

  function handleRecordError(error: any): void {
    console.warn("[VoicePanel] record error", error);
    panelState.value = "idle";
    uni.showToast({ title: t("Mobile.Voice.recordFailed"), icon: "none" });
  }

  function handleRecordCancel(): void {
    panelState.value = "idle";
    liveTranscript.value = "";
    draftText.value = "";
  }

  function handleDraftInput(event: any): void {
    const detail = (event as UTSJSONObject)["detail"] as UTSJSONObject | null;
    const value = detail != null ? detail!["value"] : null;
    draftText.value = value != null ? `${value}` : "";
  }

  function cancelDraft(): void {
    panelState.value = "idle";
    liveTranscript.value = "";
    draftText.value = "";
  }

  function sendDraft(): void {
    const text = draftText.value.trim();
    if (text.length == 0) {
      uni.showToast({ title: t("Mobile.Voice.noSpeechDetected"), icon: "none" });
      cancelDraft();
      return;
    }
    pendingRound = true;
    pendingUserBaseline = props.lastUserMsgId;
    sentText = text;
    awaitingAssistant = false;
    panelState.value = "idle";
    liveTranscript.value = "";
    draftText.value = "";
    emit("sendVoiceMessage", text);
  }

  async function playLatestReply(): Promise<void> {
    stopAllAudio();
    const rawBody = props.streamText;
    const settings = voiceSettings.value;
    let fullText = rawBody;
    if (settings.includeThinkContent == true && props.thinkText.length > 0) {
      fullText = props.thinkText + "\n" + rawBody;
    }
    const cleaned = cleanTextForSpeech(fullText, settings);
    const allSentences = extractSpeakableSentences(cleaned);
    const sentenceLimit = Math.min(allSentences.length, voiceConfig.maxSentencesPerMessage);
    if (sentenceLimit == 0) {
      uni.showToast({ title: t("Mobile.Voice.noSpeakableContent"), icon: "none" });
      return;
    }

    manualPlayGeneration += 1;
    const expectedGeneration = manualPlayGeneration;
    const messageId = props.assistantMsgId;
    const first = await ttsService.synthesize(allSentences[0], messageId, 0);
    if (expectedGeneration != manualPlayGeneration) {
      return;
    }
    const sessionId = audioPlayerManager.playList([first]);
    for (let i = 1; i < sentenceLimit; i++) {
      if (expectedGeneration != manualPlayGeneration || audioPlayerManager.getSessionId() != sessionId) {
        return;
      }
      const item = await ttsService.synthesize(allSentences[i], messageId, i);
      if (expectedGeneration != manualPlayGeneration || audioPlayerManager.getSessionId() != sessionId) {
        return;
      }
      audioPlayerManager.enqueue([item], sessionId);
    }
  }

  function toggleLatestPlayback(): void {
    if (isPlaying.value == true) {
      stopAllAudio();
    } else {
      playLatestReply();
    }
  }

  function openSettings(): void {
    const modal = voiceSettingModalRef.value;
    if (modal == null) {
      return;
    }
    const openFn = (modal as UTSJSONObject)["open"] as (() => void) | null;
    if (openFn != null) {
      openFn();
    }
  }

  function handleSettingsChange(settings: VoiceSettings): void {
    voiceSettings.value = cloneVoiceSettings(settings);
  }

  // 必须先观察用户消息，再观察助手消息；助手回调同时做同步复核，兼容不同平台 flush 行为。
  watch((): string => props.lastUserMsgId, (newId: string, _oldId: string) => {
    if (pendingRound == false || newId.length == 0 || newId == pendingUserBaseline) {
      return;
    }
    if (props.lastUserMsgText == sentText) {
      awaitingAssistant = true;
    } else {
      clearRoundHandshake();
    }
  });

  watch((): string => props.assistantMsgId, (newId: string, _oldId: string) => {
    if (newId.length == 0) {
      return;
    }
    if (pendingRound == true && awaitingAssistant == false && props.lastUserMsgId != pendingUserBaseline) {
      if (props.lastUserMsgText == sentText) {
        awaitingAssistant = true;
      } else {
        clearRoundHandshake();
      }
    }
    const settings = voiceSettings.value;
    const shouldPlay = settings.autoPlay == true || (settings.voiceRoundAutoPlay == true && awaitingAssistant == true);
    if (shouldPlay == false) {
      return;
    }
    stopAllAudio();
    activeStreamId = newId;
    voiceStreamSpeaker.begin(newId, cloneVoiceSettings(settings));
    clearRoundHandshake();
    feedCurrentStream();
  });

  watch((): string => props.streamText, (_value: string, _oldValue: string) => {
    feedCurrentStream();
  });
  watch((): string => props.thinkText, (_value: string, _oldValue: string) => {
    feedCurrentStream();
  });
  watch((): string => props.streamStatus, (_value: string, _oldValue: string) => {
    feedCurrentStream();
  });
  watch((): boolean => props.isConversationActive, (active: boolean, oldActive: boolean) => {
    if (oldActive == true && active == false && activeStreamId.length > 0 && isStreamFinished() == false) {
      stopAllAudio();
    }
  });
  watch((): string => props.conversationKey, (newKey: string, oldKey: string) => {
    if (newKey != oldKey) {
      resetPanel();
    }
  });

  onMounted(() => {
    voiceSettings.value = loadVoiceSettings();
    audioPlayerManager.setOnStateChange((state, _messageId) => {
      isPlaying.value = state == "playing";
    });
  });

  onUnmounted(() => {
    voiceStreamSpeaker.stop();
    audioPlayerManager.stop();
    streamingAsrService.cancel();
    audioPlayerManager.setOnStateChange(null);
  });
</script>

<style lang="scss" scoped>
  .voice-panel {
    flex-shrink: 0;
    padding: 12rpx 24rpx 4rpx;
    background-color: #fff;
  }

  .idle-row,
  .recording-row {
    min-height: 84rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    border: 1rpx solid rgba(0, 0, 0, 0.08);
    border-radius: 24rpx;
    background-color: #f7f7fa;
  }

  .recorder-button {
    flex: 1;
  }

  .voice-action {
    height: 60rpx;
    padding: 0 18rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-right: 1rpx solid rgba(0, 0, 0, 0.08);
  }

  .action-icon {
    font-size: 22rpx;
    color: rgb(108, 101, 244);
    margin-right: 8rpx;
  }

  .action-label {
    font-size: 24rpx;
    color: rgba(0, 0, 0, 0.65);
  }

  .settings-button {
    width: 76rpx;
    height: 76rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .recording-row {
    padding: 0 24rpx;
  }

  .recording-dot {
    width: 16rpx;
    height: 16rpx;
    border-radius: 8rpx;
    background-color: #ff4d4f;
    margin-right: 16rpx;
  }

  .recording-text {
    flex: 1;
    font-size: 28rpx;
    color: rgba(0, 0, 0, 0.75);
  }

  .editing-box {
    padding: 18rpx;
    border: 1rpx solid rgba(108, 101, 244, 0.25);
    border-radius: 24rpx;
    background-color: #f7f7fa;
  }

  .voice-editor {
    width: 100%;
    min-height: 88rpx;
    font-size: 28rpx;
    line-height: 42rpx;
  }

  .editing-actions {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12rpx;
  }

  .edit-button {
    margin: 0 0 0 16rpx;
    padding: 0 28rpx;
    height: 60rpx;
    line-height: 60rpx;
    border-radius: 30rpx;
    font-size: 26rpx;
  }

  .cancel-button {
    color: rgba(0, 0, 0, 0.65);
    background-color: #fff;
  }

  .send-button {
    color: #fff;
    background-color: rgb(108, 101, 244);
  }
</style>
