<template>
  <view class="manual-wrapper">
    <scroll-view
      class="manual-container"
      direction="horizontal"
      :scroll-x="true"
      :scroll-y="false"
      :scroll-with-animation="true"
      :show-scrollbar="false"
    >
      <view class="manual-scroll-content">
      <!-- 页面首页 -->
      <view
        v-if="showPageHomeVal"
        class="manual-box"
        @click="handleOpenPagePreview"
      >
        <text class="icon iconfont"></text>
        <text class="text">{{ t("Mobile.Common.pageHome") }}</text>
      </view>

      <!-- 工作台 -->
      <view v-if="isTaskAgentVal" class="manual-box" @click="handleOpenFileTree">
        <text class="icon iconfont"></text>
        <text class="text">{{ t("Mobile.Common.workspace") }}</text>
      </view>

      <!-- 沙盒选择 -->
      <view v-if="isTaskAgentVal && readonlyVal == false" class="manual-group">
        <view
          v-if="isSandboxUnavailableVal == false && currentSandboxName.length > 0"
          class="manual-box manual-select"
          @click="openSandboxDrawer"
        >
          <text class="text">{{ currentSandboxName }}</text>
          <text class="icon iconfont icon-arrow-down"></text>
        </view>
        <view v-else class="manual-box manual-select disabled">
          <text class="text">{{ sandboxDisabledTextVal }}</text>
        </view>
      </view>

      <!-- 模型选择 -->
      <view
        v-if="allowOtherModelVal"
        class="manual-box manual-select"
        @click="modelSelectVisible = true"
      >
        <text class="text">{{ modelSelectLabelVal }}</text>
        <text class="icon iconfont icon-arrow-down"></text>
      </view>

      <view
        v-for="item in manualComponentsVal"
        :key="item.id"
        class="manual-box"
        :class="{ active: isSelected(item) }"
        @click="handleSelectComponent(item)"
      >
        <text
          class="icon iconfont"
          :class="getIconClass(item.name)"
          v-if="getIconClass(item.name).length > 0"
        ></text>
        <text class="text">{{ item.name }}</text>
      </view>
      </view>
    </scroll-view>
  </view>

  <!-- 页面预览 -->
  <page-preview-iframe ref="pagePreviewIframeRef" />

  <!-- 沙盒切换弹窗 -->
  <sandbox-select-modal
    :visible="sandboxVisible"
    :sandbox-list="sandboxListVal"
    :current-sandbox-id="currentSandboxIdVal"
    :is-sandbox-switch-disabled="isSandboxSwitchDisabledVal"
    :readonly="readonlyVal"
    @on-close="handleSandboxClose"
    @on-sandbox-change="handleSandboxChangeInside"
  />

  <model-select-modal
    v-if="allowOtherModelVal"
    :visible="modelSelectVisible"
    :agent-id="agentIdVal"
    :agent-type="agentTypeVal"
    :current-model-id="currentModelIdVal"
    :is-temp-chat="isTempChatVal"
    @on-close="modelSelectVisible = false"
    @on-model-sync="handleModelSyncInside"
    @on-model-change="handleModelChangeInside"
  />
</template>

<script lang="uts" setup>
  import { ref, computed } from 'vue';
  import { AgentManualComponentInfo, AgentSelectedComponentInfo } from "@/types/interfaces/agent";
  import { SandboxInfo } from "@/types/interfaces/sandbox";
  import SandboxSelectModal from "../sandbox-select-modal/sandbox-select-modal.uvue";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import ModelSelectModal from "../model-select-modal/model-select-modal.uvue";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      manualComponents: AgentManualComponentInfo[];
      selectedComponents: AgentSelectedComponentInfo[];
      isTaskAgent?: boolean;
      pageHomeIndex?: string;
      expandPageArea?: number;
      sandboxList?: SandboxInfo[];
      currentSandboxId?: string;
      isSandboxSwitchDisabled?: boolean;
      isSandboxUnavailable?: boolean;
      sandboxDisabledText?: string;
      readonly?: boolean;
      // 模型选择相关
      allowOtherModel?: boolean;
      currentModelId?: number;
      currentModelName?: string;
      agentId?: number;
      agentType?: string;
      isTempChat?: boolean;
    }>(),
    {
      manualComponents: () => [],
      selectedComponents: () => [],
      isTaskAgent: false,
      pageHomeIndex: "",
      expandPageArea: 0,
      sandboxList: () => [],
      currentSandboxId: "",
      isSandboxSwitchDisabled: false,
      isSandboxUnavailable: false,
      sandboxDisabledText: "",
      readonly: false,
      allowOtherModel: false,
      currentModelId: 0,
      currentModelName: "",
      agentId: 0,
      agentType: "ChatBot",
      isTempChat: false,
    },
  );

  const emit = defineEmits<{
    (e: 'onSandboxChange', sandboxId: string): void;
    (e: 'onModelChange', modelId: number, name: string): void;
    (e: 'onSelectComponent', item: AgentSelectedComponentInfo): void;
    (e: 'onOpenPagePreview', uri: string): void;
    (e: 'onOpenFileTree'): void;
  }>();

  /** APP 端模板 v-if 须通过 computed 读取 props */
  const isTaskAgentVal = computed((): boolean => props.isTaskAgent == true);
  const allowOtherModelVal = computed((): boolean => props.allowOtherModel == true);
  const readonlyVal = computed((): boolean => props.readonly == true);
  const isSandboxUnavailableVal = computed((): boolean => props.isSandboxUnavailable == true);
  const isSandboxSwitchDisabledVal = computed((): boolean => props.isSandboxSwitchDisabled == true);
  const isTempChatVal = computed((): boolean => props.isTempChat == true);
  const manualComponentsVal = computed((): AgentManualComponentInfo[] => props.manualComponents);
  const sandboxListVal = computed((): SandboxInfo[] => props.sandboxList);
  const currentSandboxIdVal = computed((): string => {
    const id = props.currentSandboxId;
    if (id == null) {
      return "";
    }
    return `${id}`;
  });
  const currentModelNameVal = computed((): string => {
    const name = props.currentModelName;
    if (name == null) {
      return "";
    }
    return `${name}`;
  });
  const agentTypeVal = computed((): string => {
    const typeVal = props.agentType;
    if (typeVal == null || `${typeVal}`.length == 0) {
      return "ChatBot";
    }
    return `${typeVal}`;
  });
  const modelSelectLabelVal = computed((): string => {
    if (currentModelNameVal.value.length > 0) {
      return currentModelNameVal.value;
    }
    return t("Mobile.Chat.modelSelect");
  });
  const sandboxDisabledTextVal = computed((): string => {
    const text = props.sandboxDisabledText;
    if (text == null) {
      return "";
    }
    return `${text}`;
  });
  const agentIdVal = computed((): number => {
    const id = props.agentId;
    if (id == null) {
      return 0;
    }
    return id;
  });
  const currentModelIdVal = computed((): number => {
    const id = props.currentModelId;
    if (id == null) {
      return 0;
    }
    return id;
  });

  const currentSandboxName = computed((): string => {
    const list = props.sandboxList;
    const len = list.length;
    const targetId = props.currentSandboxId;
    for (let i = 0; i < len; i++) {
      if (list[i].sandboxId == targetId) {
        return list[i].name;
      }
    }
    if (len > 0) {
      return list[0].name;
    }
    return "";
  });

  const showPageHomeVal = computed((): boolean => {
    const pageHome = props.pageHomeIndex;
    if (pageHome == null || `${pageHome}`.length == 0) {
      return false;
    }
    const area = props.expandPageArea;
    if (area == 1 || `${area}` == "1") {
      return true;
    }
    return false;
  });

  const modelSelectVisible = ref(false);

  /** 静默同步模型名称（不关弹窗） */
  const handleModelSyncInside = (id: number, name: string) => {
    emit("onModelChange", id, name);
  };

  /** 用户在弹窗中选中模型 */
  const handleModelChangeInside = (id: number, name: string) => {
    emit("onModelChange", id, name);
    modelSelectVisible.value = false;
  };
  // 页面预览iframe引用
  const pagePreviewIframeRef = ref<any | null>(null);
  const sandboxVisible = ref(false);

  // 打开沙盒切换抽屉
  const openSandboxDrawer = () => {
    sandboxVisible.value = true;
  };

  // 抽屉内切换沙盒反馈
  const handleSandboxChangeInside = (id: string) => {
    emit("onSandboxChange", id);
    sandboxVisible.value = false;
  };

  const handleSandboxClose = () => {
    sandboxVisible.value = false;
  };

  // 点击工作台，打开文件树弹窗
  const handleOpenFileTree = () => {
    emit("onOpenFileTree");
  };

  // 打开页面预览
  const handleOpenPagePreview = () => {
    const pageHomeIndex = props.pageHomeIndex;
    if (pageHomeIndex.length == 0) {
      return;
    }
    // APP-ANDROID 无 iframe 页面预览，整个事件发送逻辑仅 H5 / 小程序生效
    // #ifndef APP-ANDROID
    let uri = pageHomeIndex;
    // #ifdef H5 || WEB
    if (process.env.NODE_ENV === "production") {
      uri = window.location.origin + props.pageHomeIndex;
    }
    // #endif
    emit("onOpenPagePreview", uri);
    // #endif
  };

  // 选择组件
  const handleSelectComponent = (item: AgentManualComponentInfo) => {
    const selectedComponent = new AgentSelectedComponentInfo(item.id, item.type);
    emit("onSelectComponent", selectedComponent);
  };

  // 判断组件是否被选中
  const isSelected = (item: AgentManualComponentInfo): boolean => {
    const list = props.selectedComponents;
    const len = list.length;
    for (let i = 0; i < len; i++) {
      if (list[i].id == item.id) {
        return true;
      }
    }
    return false;
  };

  // 根据组件名称返回对应的图标类名
  const getIconClass = (name: string): string => {
    const lowerName = name.toLowerCase();
    if (
      name.includes("搜索") ||
      name.includes("互联网") ||
      lowerName.includes("search") ||
      lowerName.includes("internet")
    ) {
      return "icon-Globe";
    } else if (
      name.includes("研究") ||
      name.includes("深度") ||
      lowerName.includes("research") ||
      lowerName.includes("deep")
    ) {
      return "icon-bulb";
    }
    return "";
  };
</script>

<style lang="scss" scoped>
  // Android 原生 scroll-view 需要由确定宽度的父容器约束，才能正确计算横向内容尺寸。
  .manual-wrapper {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: 76rpx;

    .manual-container {
      width: 100%;
      height: 76rpx;
      flex-direction: row;
      /* #ifndef APP */
      scroll-behavior: smooth;
      /* #endif */
      /* #ifdef H5 || MP-WEIXIN */
      -webkit-overflow-scrolling: touch;
      /* #endif */
    }

    .manual-scroll-content {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      /* #ifdef H5 */
      width: max-content;
      /* #endif */
    }
  }

  .manual-group {
    display: flex;
    flex-direction: row;
  }

  .manual-box {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    height: 76rpx;
    padding: 16rpx 24rpx;
    margin-right: 16rpx;
    border-radius: 16rpx;
    border: 2rpx solid #f0f0f0;
    transition: all 0.3s ease;
    box-sizing: border-box;

    .icon {
      font-size: 32rpx;
      color: #6b7280;
      transition: color 0.3s ease;
      margin-right: 6rpx;
    }

    &.active {
      background: #f2f2ff;
      border-color: #f2f2ff;

      .icon {
        color: #4f46e5;
      }

      .text {
        color: #5147ff;
      }
    }

    .text {
      color: rgba(21, 23, 31, 0.7);
      font-size: 28rpx;
      font-weight: 400;
      white-space: nowrap;
    }

    &.manual-select {
      border-color: #eeeeee;
      min-width: 100rpx;
      max-width: 300rpx;
      flex-shrink: 0;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: row;
      align-items: center;

      .text {
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
        min-width: 0;
      }

      .icon-arrow-down {
        font-size: 24rpx;
        margin-left: -4rpx;
        color: rgba(21, 23, 31, 0.4);
      }

      &.disabled {
        opacity: 0.6;
        background: #f5f5f5;
        pointer-events: auto;

        .text {
          color: rgba(21, 23, 31, 0.7);
        }
      }
    }

    &.disabled {
      opacity: 0.6;
      background: #f5f5f5;
      pointer-events: none;

      .text {
        color: rgba(21, 23, 31, 0.7);
      }
    }
  }

  /* iOS 原生横向 scroll-view 会裁剪紧贴视口底部的边框，预留 4rpx 垂直空间。 */
  /* #ifdef APP-IOS */
    .manual-container,
    .manual-scroll-content {
      height: 80rpx;
    }
  /* #endif */
</style>
