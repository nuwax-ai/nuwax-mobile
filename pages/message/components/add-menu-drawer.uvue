<template>
  <!--
    消息页右上角「+」锚定气泡：
    - 贴屏幕右缘（与加号右缘对齐，留小间距），顶部在加号下方
    - 高度随内容（非全高抽屉），点遮罩关闭
    - 安卓返回先关气泡（popupBackRegistry）
  -->
  <view v-if="visible" class="add-pop__mask" @tap="handleMaskTap">
    <view class="add-pop" :style="popStyle" @tap.stop="handlePopTap">
      <view
        class="add-pop__item"
        hover-class="add-pop__item--active"
        @click="handleCreateGroup"
      >
        <image class="add-pop__icon" :src="iconCreateGroup" mode="aspectFit" />
        <text class="add-pop__label">{{ t("Mobile.Message.createGroup") }}</text>
      </view>
      <view
        class="add-pop__item"
        hover-class="add-pop__item--active"
        @click="handleJoinGroup"
      >
        <image class="add-pop__icon" :src="iconJoinGroup" mode="aspectFit" />
        <text class="add-pop__label">{{ t("Mobile.Message.joinGroup") }}</text>
      </view>
      <view
        class="add-pop__item"
        hover-class="add-pop__item--active"
        @click="handleAddBuddy"
      >
        <image class="add-pop__icon" :src="iconAddBuddy" mode="aspectFit" />
        <text class="add-pop__label">{{ t("Mobile.Message.addBuddy") }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, onUnmounted, ref, watch } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import {
    registerPopupClose,
    unregisterPopupClose,
    registerBackInterceptionGlobals,
  } from "@/utils/popupBackRegistry";
  import iconCreateGroup from "@/static/icons/group_set.svg";
  import iconJoinGroup from "@/static/icons/join_group.svg";
  import iconAddBuddy from "@/static/icons/add_buddy.svg";

  const emit = defineEmits<{
    createGroup: [];
    joinGroup: [];
    addBuddy: [];
    /** 关闭后触发，页面借此串行接续下一个弹窗 */
    closed: [];
  }>();

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const visible = ref<boolean>(false);
  /** 加号按钮测量值（px，视口坐标）；-1 表示测量失败，用兜底位置 */
  const anchorBottomPx = ref<number>(-1);
  const anchorRightPx = ref<number>(-1);

  /** 气泡位置：顶部在加号下缘 + 6px；右缘与加号右缘对齐（视口 right 坐标需换算成距右缘间距）。 */
  const popStyle = computed((): string => {
    const top = anchorBottomPx.value > 0 ? anchorBottomPx.value + 6 : 56;
    let rightGap = 16;
    if (anchorRightPx.value > 0) {
      const winWidth = uni.getWindowInfo().windowWidth;
      const gap = winWidth - anchorRightPx.value;
      if (gap >= 0) {
        rightGap = gap;
      }
    }
    return "top: " + top.toString() + "px; right: " + rightGap.toString() + "px;";
  });

  /** 打开气泡（页面测量加号后传入 bottom/right 视口坐标 px）。 */
  function open(anchorBottom: number, anchorRight: number): void {
    anchorBottomPx.value = anchorBottom;
    anchorRightPx.value = anchorRight;
    visible.value = true;
  }

  /** 关闭气泡（无动画版，v-if 直摘）。 */
  function close(): void {
    if (visible.value == false) {
      return;
    }
    visible.value = false;
    emit("closed");
  }

  /** App web-view 内嵌 H5：Android 返回手势先关气泡。 */
  registerBackInterceptionGlobals();
  let popupRegistryId: number = 0;
  watch(
    visible,
    (val: boolean) => {
      if (val == true) {
        if (popupRegistryId == 0) {
          popupRegistryId = registerPopupClose(close);
        }
      } else if (popupRegistryId != 0) {
        unregisterPopupClose(popupRegistryId);
        popupRegistryId = 0;
      }
    },
    { immediate: true },
  );
  onUnmounted(() => {
    if (popupRegistryId != 0) {
      unregisterPopupClose(popupRegistryId);
      popupRegistryId = 0;
    }
  });

  function handleMaskTap(): void {
    close();
  }

  /** 阻断气泡内点击冒泡到遮罩（行点击各自处理）。 */
  function handlePopTap(): void {}

  function handleCreateGroup(): void {
    emit("createGroup");
    close();
  }

  function handleJoinGroup(): void {
    emit("joinGroup");
    close();
  }

  function handleAddBuddy(): void {
    emit("addBuddy");
    close();
  }

  defineExpose({
    open: open as any,
    close: close as any,
  });
</script>

<style lang="scss" scoped>
  .add-pop__mask {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* 低于 uni-modal-popup 默认 zIndex 999：串行弹出的底部表单在气泡之上 */
    z-index: 998;
    background-color: rgba(0, 0, 0, 0.35);
  }

  .add-pop {
    position: fixed;
    width: 320rpx;
    padding: 12rpx 0;
    background-color: #ffffff;
    border-radius: 20rpx;
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
  }

  .add-pop__item {
    height: 96rpx;
    padding: 0 32rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .add-pop__item--active {
    background-color: #f4f3f8;
  }

  .add-pop__icon {
    width: 44rpx;
    height: 44rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
  }

  .add-pop__label {
    font-size: 28rpx;
    line-height: 40rpx;
    font-weight: 500;
    color: #1c1b20;
  }
</style>
