/**
 * 跨端写入系统剪贴板。
 * iOS：uni.setClipboardData 可能回调 success 但系统剪贴板仍为空，优先写 UIPasteboard。
 */

/**
 * 将纯文本写入系统剪贴板。
 * @param text 待复制文本
 * @param onSuccess 写入成功（尽量已回读校验）
 * @param onFail 写入失败
 */
export function writeClipboardText(
  text: string,
  onSuccess: () => void,
  onFail: () => void,
): void {
  if (text.length == 0) {
    onFail();
    return;
  }
  // 强制拷成普通 string，避免 UTS 特殊字符串类型在 iOS 剪贴板失效
  const plain = `${text}`;

  // #ifdef APP-IOS
  try {
    // UIKit 由 iOS UTS 引擎自动引入
    UIPasteboard.general.string = plain;
    const written = UIPasteboard.general.string;
    if (written != null && `${written}`.length > 0) {
      onSuccess();
      return;
    }
  } catch (_eIos) {
    // 原生失败再走 uni API
  }
  // #endif

  uni.setClipboardData({
    data: plain,
    showToast: false,
    success: () => {
      // 回读校验：避免「success 但剪贴板空」的假成功
      uni.getClipboardData({
        success: (res) => {
          const got = res.data != null ? `${res.data}` : "";
          if (got.length > 0) {
            onSuccess();
          } else {
            onFail();
          }
        },
        fail: () => {
          // 部分机型读剪贴板需权限；写接口已 success 则仍按成功提示
          onSuccess();
        },
      });
    },
    fail: () => {
      onFail();
    },
  });
}
