<template>
  <view class="container relative flex flex-col">
    <custom-nav-bar :title="t('Mobile.Terminal.myComputer')" className="border-b" hasSafetyZone showBack />

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <!-- 在线状态筛选（仅有电脑时显示，对齐 PC Web） -->
      <view v-if="computerList.length > 0" class="filter-row">
        <view :class="['filter-btn', filter == 'all' ? 'filter-btn-on' : '']" @click="setFilter('all')">
          <text :class="['filter-btn-text', filter == 'all' ? 'filter-btn-text-on' : '']">{{ t("Mobile.Terminal.filterAll") }}</text>
        </view>
        <view :class="['filter-btn', filter == 'online' ? 'filter-btn-on' : '']" @click="setFilter('online')">
          <text :class="['filter-btn-text', filter == 'online' ? 'filter-btn-text-on' : '']">{{ t("Mobile.Terminal.filterOnline") }}</text>
        </view>
        <view :class="['filter-btn', filter == 'offline' ? 'filter-btn-on' : '']" @click="setFilter('offline')">
          <text :class="['filter-btn-text', filter == 'offline' ? 'filter-btn-text-on' : '']">{{ t("Mobile.Terminal.filterOffline") }}</text>
        </view>
      </view>

      <!-- 电脑列表 -->
      <view class="card-group">
        <view v-for="(item, index) in filteredList" :key="item.id" class="row-item" :class="index === filteredList.length - 1 ? 'row-item--last' : ''">
          <view class="row-avatar">
            <text class="row-avatar-emoji">💻</text>
          </view>
          <view class="row-info">
            <text class="row-title">{{ item.name }}</text>
          </view>
          <view class="row-status">
            <view :class="['status-dot', item.online ? '' : 'status-dot-off']"></view>
            <text :class="['status-text', item.online ? '' : 'status-text-off']">
              {{ item.online ? t("Mobile.Terminal.filterOnline") : t("Mobile.Terminal.filterOffline") }}
            </text>
          </view>
        </view>

        <!-- 无电脑 -->
        <view v-if="!loading && computerList.length == 0" class="empty-box">
          <text class="empty-text">{{ t("Mobile.Terminal.noComputer") }}</text>
        </view>
        <!-- 当前筛选下无匹配 -->
        <view v-if="!loading && computerList.length > 0 && filteredList.length == 0" class="empty-box">
          <text class="empty-text">{{ filter == 'online' ? t("Mobile.Terminal.noOnlineDevices") : t("Mobile.Terminal.noOfflineDevices") }}</text>
        </view>
        <!-- 加载中 -->
        <view v-if="loading" class="empty-box">
          <text class="empty-text">{{ t("Mobile.Terminal.loading") }}</text>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiGetMyComputerList } from "@/servers/sandbox";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import { SUCCESS_CODE } from "@/constants/codes.constants";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  class ComputerItem {
    id: number = 0;
    name: string = "";
    online: boolean = false;
    constructor(id: number, name: string, online: boolean) {
      this.id = id;
      this.name = name;
      this.online = online;
    }
  }

  const computerList = ref<ComputerItem[]>([]);
  const loading = ref<boolean>(true);
  // 在线状态筛选：all | online | offline
  const filter = ref<string>("all");
  const filteredList = computed((): ComputerItem[] => {
    const out: ComputerItem[] = [];
    for (let i = 0; i < computerList.value.length; i++) {
      const c = computerList.value[i];
      if (filter.value == "all") {
        out.push(c);
      } else if (filter.value == "online" && c.online) {
        out.push(c);
      } else if (filter.value == "offline" && !c.online) {
        out.push(c);
      }
    }
    return out;
  });
  const setFilter = (f: string) => {
    filter.value = f;
  };

  const fetchList = async () => {
    loading.value = true;
    try {
      const res = await apiGetMyComputerList();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        const list: ComputerItem[] = [];
        for (let i = 0; i < arr.length; i++) {
          const idVal = arr[i]["id"];
          const nameVal = arr[i]["name"];
          const onlineVal = arr[i]["online"];
          list.push(new ComputerItem(
            idVal != null ? (idVal as number) : 0,
            nameVal != null ? `${nameVal}` : "",
            onlineVal != null ? (onlineVal as boolean) : false,
          ));
        }
        computerList.value = list;
      } else {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.fetchComputerFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchMyComputerList error", e);
      uni.showToast({ title: t("Mobile.Terminal.fetchComputerFailed"), icon: "none" });
    }
    loading.value = false;
  };

  onLoad((options: any) => {
    setCurrentPageNavigationBarTitle();
    fetchList();
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .filter-row {
    display: flex;
    flex-direction: row;
    padding: 16rpx 24rpx 8rpx;
  }

  .filter-btn {
    flex: 1;
    padding: 12rpx 0;
    border-radius: 12rpx;
    background-color: #ffffff;
    border: 2rpx solid #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 12rpx;
  }

  .filter-btn:last-child {
    margin-right: 0;
  }

  .filter-btn-text {
    font-size: 26rpx;
    color: #666666;
  }

  // vapor: 原 &.filter-btn-text-on hoist 为同层单类（与 .filter-btn-text 同特异性）
  .filter-btn-text-on {
    color: #5147ff;
    font-weight: 600;
  }

  // vapor: 原 &.filter-btn-on hoist 为 .filter-row 内同层单类（与 .filter-btn 同特异性）
  .filter-btn-on {
    border-color: #5147ff;
    background-color: rgba(81, 71, 255, 0.08);
  }

  .card-group {
    background-color: #ffffff;
    border-radius: 24rpx;
    margin: 24rpx 24rpx 0;
    overflow: hidden;
  }

  .row-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 28rpx 32rpx;
    border-bottom: 2rpx solid #f5f5f5;
  }

  .row-item--last {
    border-bottom-width: 0;
  }

  .row-avatar {
    width: 72rpx;
    height: 72rpx;
    border-radius: 16rpx;
    background-color: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 24rpx;
  }

  .row-avatar-emoji {
    font-size: 36rpx;
  }

  .row-info {
    flex: 1;
    overflow: hidden;
  }

  .row-title {
    font-size: 30rpx;
    font-weight: 500;
    color: #1a1a1a;
  }

  .row-status {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .status-dot {
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    background-color: #07c160;
    margin-right: 8rpx;
  }

  // vapor: 原 &.status-dot-off hoist 为同层单类
  .status-dot-off {
    background-color: #c0c0c0;
  }

  .status-text {
    font-size: 24rpx;
    color: #07c160;
  }

  // vapor: 原 &.status-text-off hoist 为同层单类
  .status-text-off {
    color: #999999;
  }

  .empty-box {
    padding: 80rpx 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .empty-text {
    font-size: 28rpx;
    color: #999999;
  }

  .bottom-space {
    height: 40rpx;
  }
</style>
