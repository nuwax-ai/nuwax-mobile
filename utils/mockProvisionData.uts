/**
 * 桌宠配网 Mock 数据与场景配置
 *
 * 供 MockBleAdapter 与 test-provision 调试页使用。
 * 对齐项目既有 mock*.uts 风格（导出一批工厂函数/查询函数）。
 */
import { MockScenarioEnum } from '@/types/enums/provision';
import { BleDeviceInfo } from '@/utils/ble/bleTypes';
import {
  PROV_DEVICE_NAME_PREFIX,
  PROV_MOCK_SCENARIO_STORAGE_KEY,
} from '@/constants/provision.constants';

/** Mock 场景配置项（调试页展示 + 适配器行为参数） */
export class MockScenarioOption {
  /** 场景枚举值 */
  value: MockScenarioEnum;
  /** 调试页展示名（中文，调试页可硬编码） */
  label: string;
  /** 场景说明 */
  desc: string;
  constructor(value: MockScenarioEnum, label: string, desc: string) {
    this.value = value;
    this.label = label;
    this.desc = desc;
  }
}

/** 全部 Mock 场景（调试页选择器数据源） */
export function mockScenarioOptions(): MockScenarioOption[] {
  return [
    new MockScenarioOption(MockScenarioEnum.SUCCESS, '成功', '顺利联网成功'),
    new MockScenarioOption(MockScenarioEnum.FAIL_WRONG_PASSWORD, '密码错误', '联网失败：WiFi 密码错误'),
    new MockScenarioOption(MockScenarioEnum.FAIL_AP_NOT_FOUND, '找不到AP', '联网失败：AP 不可达'),
    new MockScenarioOption(MockScenarioEnum.FAIL_TIMEOUT, '超时', '只到 PROVISIONING，触发 30s 超时'),
    new MockScenarioOption(MockScenarioEnum.CONNECT_FLAKY, '连接抖动', '连接前 2 次失败第 3 次成功'),
    new MockScenarioOption(MockScenarioEnum.WRITE_FLAKY, '写抖动', '写凭据前 1 次失败'),
    new MockScenarioOption(MockScenarioEnum.ALREADY_CONFIGURED, '已配置', '订阅即报 ALREADY_CONFIGURED'),
    new MockScenarioOption(MockScenarioEnum.UNEXPECTED_DISCONNECT, '意外断开', '写入凭据后意外断开'),
  ];
}

/** 读取当前 Mock 场景（storage，默认 SUCCESS） */
export function getMockScenario(): MockScenarioEnum {
  const v = uni.getStorageSync(PROV_MOCK_SCENARIO_STORAGE_KEY);
  if (v == null || v == '') return MockScenarioEnum.SUCCESS;
  return v as MockScenarioEnum;
}

/** 设置当前 Mock 场景（写 storage） */
export function setMockScenario(scenario: MockScenarioEnum): void {
  uni.setStorageSync(PROV_MOCK_SCENARIO_STORAGE_KEY, scenario as string);
}

/** 生成模拟扫描到的待配网设备列表 */
export function mockScanDevices(): BleDeviceInfo[] {
  return [
    new BleDeviceInfo('AA:BB:CC:DD:EE:01', `${PROV_DEVICE_NAME_PREFIX}-A001`, -52, ''),
    new BleDeviceInfo('AA:BB:CC:DD:EE:02', `${PROV_DEVICE_NAME_PREFIX}-B023`, -68, ''),
    new BleDeviceInfo('AA:BB:CC:DD:EE:03', `${PROV_DEVICE_NAME_PREFIX}-C107`, -81, ''),
  ];
}

/** 模拟 DEVICE_INFO 原始字节内容（UTF-8 分隔符串 sn|model|firmware） */
export function mockDeviceInfoRaw(deviceId: string): string {
  const sn = deviceId.length > 0 ? deviceId : 'UNKNOWN';
  return `SN${sn}|NUWAX-PET-PRO|v1.0.0`;
}
