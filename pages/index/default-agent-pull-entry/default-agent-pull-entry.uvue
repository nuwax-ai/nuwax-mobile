<template>
  <view class="pull-entry">
    <!-- 第一层：状态栏 / 刘海 / 动态岛安全区，与下方内容使用同一背景。 -->
    <view class="pull-entry-safe-area">
      <safety-zone />
    </view>

    <!-- 第二层：默认智能体入口的内容承载层。 -->
    <view class="pull-entry-content">
      <!-- 第三层：智能体主体卡片。 -->
      <view class="pull-entry-card">
        <view class="agent-icon-shell">
          <image
            class="agent-icon"
            :src="resolvedIcon"
            mode="aspectFit"
            :alt="agentName"
            @error="handleImageError"
          />
        </view>

        <view class="agent-info">
          <view class="agent-title-row">
            <text class="agent-name">{{ agentName }}</text>
          </view>
          <text v-if="agentDescription.length > 0" class="agent-description">{{ agentDescription }}</text>
          <view class="pull-action-row">
            <text class="pull-tip">{{ pullTip }}</text>
            <view class="arrow-shell">
              <text class="arrow-icon">↓</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { computed, ref, watch } from "vue";
  import agentImage from "@/static/assets/agent_image.png";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  interface DefaultAgentPullEntryProps {
    agentName: string;
    agentIcon: string;
    agentDescription: string;
    pullDistance: number;
    triggerDistance: number;
  }

  const props = defineProps<DefaultAgentPullEntryProps>();
  const imageFailed = ref<boolean>(false);

  function t(key: string): string {
    return translateFn(key, emptyI18nParams(), "");
  }

  const resolvedIcon = computed((): string => {
    return imageFailed.value || props.agentIcon.length == 0 ? agentImage : props.agentIcon;
  });

  const pullTip = computed((): string => {
    return props.pullDistance >= props.triggerDistance
      ? t("Mobile.Home.releaseToOpenDefaultAgent")
      : t("Mobile.Home.pullToOpenDefaultAgent");
  });

  function handleImageError(): void {
    imageFailed.value = true;
  }

  watch(
    (): string => props.agentIcon,
    (): void => {
      imageFailed.value = false;
    },
  );
</script>

<style lang="scss" scoped>
  .pull-entry {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background-color: #ece9ff;
  }

  /* 顶层：系统安全区。独立背景保证刘海屏顶部不会露出页面底色。 */
  .pull-entry-safe-area {
    width: 100%;
    flex-shrink: 0;
    background-color: #ece9ff;
  }

  /* 内容层：固定为手势阈值对应的高度，内部再承载白色主体卡片。 */
  .pull-entry-content {
    width: 100%;
    height: 140px;
    padding: 16rpx 24rpx 24rpx;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    background: linear-gradient(180deg, #ece9ff 0%, #f7f6ff 72%, #ffffff 100%);
  }

  /* 主体层：通过边框和阴影从背景层中抬升。 */
  .pull-entry-card {
    width: 100%;
    min-width: 0;
    padding: 20rpx 22rpx;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-radius: 24rpx;
    border: 2rpx solid rgba(81, 71, 255, 0.1);
    background-color: #ffffff;
    box-shadow: 0 10rpx 30rpx rgba(60, 48, 180, 0.14);
  }

  /* 图标层：外壳与图片分离，强化智能体身份入口。 */
  .agent-icon-shell {
    width: 96rpx;
    height: 96rpx;
    padding: 4rpx;
    box-sizing: border-box;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 26rpx;
    background-color: #eeeaff;
  }

  .agent-icon {
    width: 88rpx;
    height: 88rpx;
    border-radius: 22rpx;
    background-color: #f5f5f5;
  }

  .agent-info {
    flex: 1;
    min-width: 0;
    margin-left: 20rpx;
    display: flex;
    flex-direction: column;
  }

  .agent-title-row,
  .pull-action-row {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .agent-name,
  .agent-description,
  .pull-tip {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .agent-name {
    flex: 1;
    min-width: 0;
    color: #1a1a1a;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 42rpx;
  }

  .agent-description {
    margin-top: 4rpx;
    color: #888888;
    font-size: 24rpx;
    line-height: 34rpx;
  }

  /* 操作层：与信息层留出间距，提示文字和方向图标形成一组。 */
  .pull-action-row {
    margin-top: 8rpx;
  }

  .pull-tip {
    flex: 1;
    min-width: 0;
    color: #5147ff;
    font-size: 24rpx;
    line-height: 34rpx;
  }

  .arrow-shell {
    width: 36rpx;
    height: 36rpx;
    margin-left: 12rpx;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 18rpx;
    background-color: #5147ff;
  }

  .arrow-icon {
    color: #ffffff;
    font-size: 24rpx;
    line-height: 30rpx;
  }
</style>
