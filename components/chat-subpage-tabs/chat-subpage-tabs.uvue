<template>
  <view class="cst-bar">
    <view
      v-for="tab in tabs"
      :key="tab.id"
      class="cst-tab"
      :class="active == tab.id ? 'cst-tab--on' : ''"
      hover-class="cst-tab--hover"
      @click="handleTap(tab.id)"
    >
      <image class="cst-tab__icon" :src="tab.icon" mode="aspectFit" />
      <text
        class="cst-tab__text"
        :class="active == tab.id ? 'cst-tab__text--on' : ''"
      >{{ tab.label }}</text>
    </view>
    <!-- 行尾搜索键（文件按钮后面）：进「本会话内搜索」页，开关由调用方控制 -->
    <view
      v-if="showSearch"
      class="cst-search"
      hover-class="cst-search--hover"
      @click="handleSearchTap"
    >
      <svg-icon name="icon-Search" size="34" color="#6b6878" />
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { ChatSubpageTab } from "@/types/interfaces/chatSubpageTab";

  /**
   * 聊天详情页「子页签行」：对话标题下方一排 消息/Pin/资料库/文件 按钮（单聊与群聊复用）。
   *
   * - 标签集由调用方拼装传入（单聊四枚；群聊后续可加群公告等），本组件只管渲染与点击分发；
   * - ★选中态不改图标颜色（彩色实心 PNG 常驻），只改文字色 + 胶囊底色——
   *   对齐 PC nuwax-im-web DEV-187 的参考图语义，勿改用 currentColor 类单色图标；
   * - 「消息」由页面侧恒为选中（本组件无内部状态，active 受控）；
   *   Pin/资料库/文件/搜索 的开页/占位逻辑全部在页面侧处理（组件不感知路由）；
   * - 行尾可带一枚搜索键（showSearch 开关）：点击只向外发 search 事件。
   */
  const props = withDefaults(
    defineProps<{
      /** 标签集（顺序即渲染顺序）。 */
      tabs: ChatSubpageTab[];
      /** 当前选中标签 id（受控；「消息」页恒传 "messages"）。 */
      active?: string;
      /** 行尾是否渲染搜索键（「文件」后面的放大镜）。 */
      showSearch?: boolean;
    }>(),
    {
      tabs: () => [] as ChatSubpageTab[],
      active: "messages",
      showSearch: false,
    },
  );

  const emit = defineEmits<{
    (e: "select", id: string): void;
    (e: "search"): void;
  }>();

  function handleTap(id: string): void {
    emit("select", id);
  }

  function handleSearchTap(): void {
    emit("search");
  }
</script>

<style lang="scss" scoped>
  /* ===== 子页签行：标题下方，左起横排胶囊 ===== */
  .cst-bar {
    flex-shrink: 0;
    padding: 12rpx 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-bottom: 2rpx solid #e5e6eb;
  }

  .cst-tab {
    padding: 8rpx 22rpx;
    margin-right: 12rpx;
    border-radius: 30rpx;
    background-color: rgba(0, 0, 0, 0);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .cst-tab--on {
    /* 选中胶囊淡蓝底（与「消息」气泡蓝同色系） */
    background-color: rgba(19, 86, 240, 0.1);
  }

  .cst-tab--hover {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .cst-tab__icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 8rpx;
    flex-shrink: 0;
  }

  .cst-tab__text {
    font-size: 26rpx;
    line-height: 36rpx;
    color: #6b6878;
  }

  .cst-tab__text--on {
    color: #1356f0;
    font-weight: 600;
  }

  /* 行尾搜索键：圆形热区，紧跟最后一个 tab（不顶到右缘） */
  .cst-search {
    width: 64rpx;
    height: 64rpx;
    margin-left: 4rpx;
    border-radius: 32rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cst-search--hover {
    background-color: rgba(81, 71, 255, 0.06);
  }
</style>
