<template>
  <view class="agent-conversation-history">
    <scroll-view
      class="history-scroll"
      direction="vertical"
      @scrolltolower="handleLoadMore"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      @refresherrefresh="handleRefresh"
      :show-scrollbar="false"
    >
      <!-- 会话列表（Android：item 为 UTSJSONObject，字段走 helper） -->
      <template v-if="conversationList.length > 0">
        <view class="list-wrapper">
          <view
            class="conversation-item"
            hover-class="hover-class"
            hover-start-time="50"
            v-for="(item, index) in conversationList"
            :key="getConversationKey(item, index)"
            @click="onConversationClick(item)"
          >
            <text class="conversation-title text-ellipsis">{{
              getConversationTitle(item)
            }}</text>
            <text class="conversation-date">{{
              getConversationDateText(item)
            }}</text>
          </view>
        </view>
      </template>

      <!-- loading状态或刷新状态时隐藏空状态 -->
      <template v-else-if="!loading && !refreshing">
        <view class="empty-state">
          <empty-state />
        </view>
      </template>

      <!-- 刷新状态时隐藏加载状态 -->
      <template v-else-if="!refreshing">
        <view class="loading-state">
          <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
        </view>
      </template>

      <!-- 没有更多数据提示 -->
      <template v-if="showNoMore">
        <view class="no-more-state">
          <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
        </view>
      </template>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { ref, computed, onMounted } from "vue";
  import { ConversationListParams } from "@/types/interfaces/conversationInfo";
  import { formatDate } from "@/utils/system";
  import { jumpToAgentDetailPage } from "@/utils/commonBusiness";
  import { apiAgentConversationList } from "@/servers/conversation";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import { readRawField } from "@/utils/readRawField.uts";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  interface AgentConversationHistoryProps {
    agentId: number;
  }

  // 接收组件属性
  const props = withDefaults(defineProps<AgentConversationHistoryProps>(), {});

  // 会话列表（Android：元素为 UTSJSONObject，勿用 ConversationInfo[]）
  const conversationList = ref<any[]>([]);
  // 加载状态
  const loading = ref<boolean>(false);
  // 刷新状态
  const refreshing = ref<boolean>(false);
  // 是否还有更多
  const hasMore = ref<boolean>(true);
  // 最后一条记录ID
  const lastId = ref<number | null>(null);

  // 是否显示没有更多数据
  const showNoMore = computed((): boolean => {
    return !loading.value && !hasMore.value && conversationList.value.length > 0;
  });

  const readConvString = (item: any | null, key: string): string => {
    const raw = readRawField(item, key);
    return raw != null ? `${raw}` : "";
  };

  const getConversationKey = (item: any | null, index: number): string => {
    const id = readConvString(item, "id");
    return id.length > 0 ? id : `conv-${index}`;
  };

  const getConversationTitle = (item: any | null): string => {
    const topic = readConvString(item, "topic");
    return topic.length > 0 ? topic : t("Mobile.Conversation.unnamed");
  };

  const getConversationDateText = (item: any | null): string => {
    const modified = readConvString(item, "modified");
    if (modified.length == 0) {
      return "";
    }
    return formatDate(modified, "MM-DD");
  };

  /** 从列表项安全读取数字 id */
  const readConvNumber = (item: any | null, key: string): number => {
    const raw = readRawField(item, key);
    if (raw == null) {
      return 0;
    }
    const n = parseFloat(`${raw}`);
    return isNaN(n) ? 0 : n;
  };

  /** 将接口 data 规范为 any[]，禁止 as ConversationInfo[] */
  const normalizeConversationList = (data: any | null): any[] => {
    if (data == null) {
      return [] as any[];
    }
    try {
      const list = data as any[];
      return list != null ? list : ([] as any[]);
    } catch (_e) {
      return [] as any[];
    }
  };

  // 获取会话列表
  const fetchConversationList = async (isLoadMore: boolean): Promise<any> => {
    try {
      const params = new ConversationListParams();
      params.agentId = props.agentId;
      params.lastId = isLoadMore ? lastId.value : null;
      params.limit = 20;

      const res = await apiAgentConversationList(params);
      loading.value = false;

      if (res == null) {
        return null;
      }
      const code = res.code;
      const data = res.data;
      if (code == SUCCESS_CODE) {
        const newList = normalizeConversationList(data);

        if (isLoadMore) {
          // 追加数据（UTS 不支持数组展开，用循环拼接）
          const existing = conversationList.value;
          const combined = [] as any[];
          for (let i = 0; i < existing.length; i++) {
            combined.push(existing[i]);
          }
          for (let j = 0; j < newList.length; j++) {
            combined.push(newList[j]);
          }
          conversationList.value = combined;
        } else {
          conversationList.value = newList;
        }

        if (newList.length > 0) {
          lastId.value = readConvNumber(newList[newList.length - 1], "id");
          hasMore.value = newList.length >= 20;
        } else {
          hasMore.value = false;
        }

        return data;
      }
    } catch (error) {
      loading.value = false;
      return false;
    }
    return null;
  };

  // 下拉刷新
  const handleRefresh = async () => {
    if (refreshing.value == true) {
      return;
    }
    refreshing.value = true;
    lastId.value = null;
    hasMore.value = true;

    await fetchConversationList(false);

    setTimeout(() => {
      refreshing.value = false;
    }, 500);
  };

  // 加载更多
  const handleLoadMore = () => {
    if (hasMore.value && !loading.value) {
      loading.value = true;
      fetchConversationList(true);
    }
  };

  // 会话项点击（Android：勿 as ConversationInfo）
  const onConversationClick = (item: any) => {
    const agentId = readConvNumber(item, "agentId");
    const conversationId = readConvNumber(item, "id");
    const convIdParam: number | null =
      conversationId != 0 ? conversationId : null;
    jumpToAgentDetailPage(agentId, convIdParam);
  };

  // 组件挂载时加载数据
  onMounted(() => {
    loading.value = true;
    fetchConversationList(false);
  });
</script>

<style lang="scss" scoped>
  .agent-conversation-history {
    /* 填满 uni-modal-popup body（flex 列）；勿用 height:100%，Android 百分比常失效 */
    width: 100%;
    flex: 1;
    height: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .list-wrapper {
    padding: 16rpx;
  }

  .conversation-item {
    height: 76rpx;
    padding: 0 16rpx;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    transition: background-color 0.2s;
    border-radius: 16rpx;
  }

  // vapor: 原 &.hover-class 反嵌套为同层单类
  .hover-class {
    background-color: rgba(12, 20, 102, 0.04);
  }

  .conversation-title {
    color: #000;
    font-size: 28rpx;
    font-weight: 400;
    flex: 1;
    margin-right: 32rpx;
  }

  .conversation-date {
    text-align: right;
    font-size: 24rpx;
    color: rgba(0, 0, 0, 0.45);
  }

  /* Android Flex 下允许 scroll-view 收缩，滚动手势才能由它接收 */
  .history-scroll {
    width: 100%;
    flex: 1;
    height: 0;
    min-height: 0;
  }

  /* 空状态 */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80rpx 0;
  }

  /* 加载状态 */
  .loading-state {
    width: 100%;
    padding: 40rpx 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loading-text {
    font-size: 28rpx;
    color: #666;
    display: flex;
    align-items: center;
    flex-direction: row;
  }

  /* #ifndef APP */
  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  /* #endif */

  /* #ifndef APP */
  .loading-text::before {
    content: "";
    width: 32rpx;
    height: 32rpx;
    border: 4rpx solid #e8e8e8;
    border-top: 4rpx solid #8b5cf6;
    border-radius: 16rpx;
    animation: spin 1s linear infinite;
    margin-right: 16rpx;
  }
  /* #endif */

  /* 没有更多数据状态 */
  .no-more-state {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40rpx;
  }

  .no-more-text {
    font-size: 24rpx;
    color: #999;
  }
</style>
