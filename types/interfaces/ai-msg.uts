import type { UniAiMarkdownElItem } from '@/uni_modules/uni-ai-x/types.uts'

export interface LLMModel {
  name: string;
  thinking?: boolean;
  webSearch?: boolean;
}

export interface Provider {
  models: LLMModel[];
  description?: string;
  baseURL?: string;
  getToken: any;
}

export interface DefaultLLM {
  provider: string;
  model: string;
}

export interface BailianTokenInfo {
  token: string;
  expireTime: number;
}

export interface Llm {
  provider: string;
  model: string;
  webSearch: boolean;
}

export interface Chat {
  datas: ChatItem[];
  activeId: string;
}

export interface ChatItem {
  id: string;
  title: string;
  state: string;
  inputContent: string;
  msgList: MsgItem[];
  update_time: number;
}

interface ChunkChoiceDelta {
  content: string;
  reasoning_content?: string;
}

interface ChunkMessage {
  content: string;
}

interface ChunkChoice {
  delta?: ChunkChoiceDelta;
  message?: ChunkMessage;
}

interface Output {
  text: string;
}

export interface Chunk {
  choices?: ChunkChoice[];
  output?: Output;
  DONE?: boolean;
}

export class MsgItem {
  _id: string = '';
  body: string = '';
  thinkContent: string = '';
  from_uid: string = '';
  state: number = 3;
  create_time: number = 0;
  about_msg_id: string = '';
  chat_id: string = '';
  markdownElList: UniAiMarkdownElItem[] = [];
  error_msg: string = '';
  rendered: boolean = false;
  processingList: any[] = [];
  // OpenUI 产物（移动端点击 → 全屏 webview）。非空时渲染 openui-card。
  openuiArtifactId: string = '';
  openuiTitle: string = '';

  constructor() {
  }
}

export interface BaseMsgItem {
  body: string;
  from_uid: string;
  about_msg_id?: string;
}

export interface Msg {
  dataList: MsgItem[];
  hasMore: boolean;
  loading: boolean;
  loadMore: any;
}

export interface RequestAiCoMessage {
  role: "user" | "assistant";
  content: string;
}

export type Theme = "auto" | "dark" | "light";

export interface Setting {
  theme: Theme;
  language: "zh-CN" | "en-US";
}
