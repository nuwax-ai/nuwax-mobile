/**
 * App 前后台生命周期标记（单例）。
 * 供 SSE 空闲超时、后台断流续接等判断「是否在后台」。
 * 由 App.uvue onHide / onShow 写入；页面勿重复维护。
 */

let appInBackground: boolean = false;

/**
 * 设置 App 是否处于后台。
 * @param hidden true = onHide / 退后台；false = onShow / 回前台
 */
export function setAppInBackground(hidden: boolean): void {
  appInBackground = hidden == true;
}

/**
 * 当前是否处于后台。
 */
export function isAppInBackground(): boolean {
  return appInBackground == true;
}
