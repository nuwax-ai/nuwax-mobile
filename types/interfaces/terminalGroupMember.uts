/**
 * 终端设备关联智能体 — 群组成员相关类型
 * 接口：GET/POST /api/terminal/agent/group-member/*
 */

/** 群组成员（list 接口返回项） */
export class GroupMemberDto {
  /** 组员智能体 ID */
  agentId: number = 0;
  /** 显示名称 */
  name: string = "";
  /** 简介描述 */
  description: string = "";
  /** 图标（URL 或 emoji；空则前端占位） */
  icon: string = "";
}

/** 新增群组成员请求体 */
export class GroupMemberAddParams {
  /** 设备对应的 agentId（宿主智能体） */
  agentId: number = 0;
  /** 要添加的目标 agentId */
  targetAgentId: number = 0;
}
