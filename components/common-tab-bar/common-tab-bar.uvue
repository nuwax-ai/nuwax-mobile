<template>
  <view class="common-tab-bar" :style="coverStyle">
  <uni-tab-bar class="common-tab-bar__items" style="padding-bottom: 0px; border-top-width: 0px;">
    <uni-tab-item v-for="(item, index) in items" :key="item.path">
      <!-- 插槽全尺寸 wrapper：**切换由本层自己落定**（touchend 主通道 + click 兜底，
           见 activateTabAt），不再依赖 click 冒泡到 item 根由 uni-tab 派发 change——
           那是唯一一条切页通道，一旦原生 click 没合成 / change 没派发（Android 下拉
           回弹后偶发），整块 tabbar 就完全失灵（点击无反应、文案高亮不变），而列表行
           因为走 touchend 主通道照常可点。加 touch 三路后与行点按同构。
           不加 .stop：事件继续冒泡给 item 根，uni-tab 内部同索引守卫会吞掉重复切换。 -->
      <view
        class="common-tab-bar__hit"
        @touchstart="handleTabTouchStart(index, $event)"
        @touchend="handleTabTouchEnd(index, $event)"
        @touchcancel="handleTabTouchCancel(index)"
        @click="handleTabClick(index)"
      >
        <text class="common-tab-bar__label" :class="{ 'common-tab-bar__label--active': item.path == props.activePath }">{{ t(item.key) }}</text>
        <view v-if="badgeCount(item) > 0" class="common-tab-bar__badge">
          <text class="common-tab-bar__badge-text">{{ badgeText(item) }}</text>
        </view>
      </view>
    </uni-tab-item>
  </uni-tab-bar>
  <view class="common-tab-bar__safe-area" :style="safeAreaStyle" />
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import { MAIN_TAB_PATHS, mainTabBarCovered, selectMainTab } from "@/utils/mainTabNavigation";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { systemMessageUnreadCount } from "@/utils/notificationBadge";
  import { imTabBadgeCount } from "@/utils/imUnreadBadge";
  import { dispatchMainTabRetap } from "@/hooks/useMainTabLifecycle";

  type CommonTabItem = { path: string; key: string };

  const items: Array<CommonTabItem> = [
    { path: "/pages/message/message", key: "Mobile.Nav.message" },
    { path: "/pages/index/index", key: "Mobile.Nav.task" },
    { path: "/pages/discover/discover", key: "Mobile.Nav.discover" },
    { path: "/pages/mine/mine", key: "Mobile.Nav.mine" },
  ];

  // 用路由标识选中项，高亮和角标不依赖视觉序号。
  const props = defineProps<{ activePath: string; bottomInset: number }>();
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const badgeCount = (item: CommonTabItem): number => {
    // 伙伴：会话未读 + 智联录待我处理；直接复用状态，不新增请求。
    if (item.path == "/pages/message/message") return imTabBadgeCount.value;
    if (item.path == "/pages/mine/mine") return systemMessageUnreadCount.value;
    return 0;
  };
  const badgeText = (item: CommonTabItem): string => {
    const count = badgeCount(item);
    return count > 99 ? "99+" : `${count}`;
  };

  const coverStyle = computed((): string => mainTabBarCovered.value ? "height: 0px; visibility: hidden;" : "");
  const safeAreaStyle = computed((): string => {
    // #ifdef APP
    return `height: ${props.bottomInset}px;`;
    // #endif
    // #ifndef APP
    return "";
    // #endif
  });

  // ===== 双击「伙伴」tab 定位首条未读；再点已激活「任务」tab 静默刷新 =====
  const MESSAGE_TAB_PATH = "/pages/message/message";
  const TASK_TAB_PATH = "/pages/index/index";
  const RETAP_WINDOW_MS = 300;
  let lastMessageTabTapMs = 0;

  // ===== 轻点判定（触摸主通道 + 合成 click 兜底）=====
  /** 静止点按的位移阈值（px）：下拉/横滑的抬手位移必超它，不会被当成点按。 */
  const TAB_TAP_SLOP_PX = 12;
  /** click 去重窗：touchend 已派发后，同一次手势紧随合成的 click 一律吞掉。 */
  const TAB_CLICK_DEDUPE_MS = 500;
  /** 各项的起手坐标/是否已记录（下标与 items 对齐）。 */
  const tabTapStartX: Array<number> = [0, 0, 0, 0];
  const tabTapStartY: Array<number> = [0, 0, 0, 0];
  const tabTapArmed: Array<boolean> = [false, false, false, false];
  /** 最近一次 touchend 主通道派发时刻（供 click 兜底去重）。
   *  ★不复用 utils/reliableTap 的 ReliableTap：它的 500ms 防重窗连「双击伙伴定位
   *    首条未读」的第二下（间隔 ~300ms 的 touchend）也一起吞；这里把去重只放在
   *    click 通道，两下抬手都能正常派发。 */
  let tabTouchEndedAt = 0;

  /** 落定点击结果（切换 + 已激活项的重按语义）。切换**由本层直接写状态**，
   *  不再依赖 uni-tab 的 change 派发（见模板注释：那条通道偶发断掉会让整块 tabbar 失灵）。 */
  function activateTabAt(index: number): void {
    if (index < 0 || index >= items.length) return;
    const path = items[index].path;
    if (path == MESSAGE_TAB_PATH) {
      const now = Date.now();
      if (lastMessageTabTapMs > 0 && now - lastMessageTabTapMs <= RETAP_WINDOW_MS) {
        // 触发即清零：三连击只定位一次
        lastMessageTabTapMs = 0;
        dispatchMainTabRetap(MESSAGE_TAB_PATH);
      } else {
        lastMessageTabTapMs = now;
      }
    } else if (path == TASK_TAB_PATH && props.activePath == path) {
      // 任务 tab：再点已激活项 → 静默刷新/失败重试（dispatch 仅激活 tab 的订阅者可达）
      dispatchMainTabRetap(TASK_TAB_PATH);
    }
    const target = MAIN_TAB_PATHS.indexOf(path);
    if (target >= 0) selectMainTab(target);
  }

  function handleTabTouchStart(index: number, eventValue: Any): void {
    if (index < 0 || index >= tabTapArmed.length) return;
    const e = eventValue as UniTouchEvent;
    // touches 优先、changedTouches 兜底（部分运行时的 touchstart touches 可能为空）
    if (e.touches.length > 0) {
      tabTapStartX[index] = e.touches[0].clientX;
      tabTapStartY[index] = e.touches[0].clientY;
      tabTapArmed[index] = true;
      return;
    }
    if (e.changedTouches != null && e.changedTouches.length > 0) {
      tabTapStartX[index] = e.changedTouches[0].clientX;
      tabTapStartY[index] = e.changedTouches[0].clientY;
      tabTapArmed[index] = true;
    }
  }

  /** 触摸主通道：静止点按即落定（与列表行同款「抬手派发」，click 只作兜底）。 */
  function handleTabTouchEnd(index: number, eventValue: Any): void {
    if (index < 0 || index >= tabTapArmed.length || !tabTapArmed[index]) return;
    tabTapArmed[index] = false;
    const e = eventValue as UniTouchEvent;
    if (e.changedTouches == null || e.changedTouches.length == 0) return;
    const tc = e.changedTouches[0];
    if (Math.abs(tc.clientX - tabTapStartX[index]) > TAB_TAP_SLOP_PX) return;
    if (Math.abs(tc.clientY - tabTapStartY[index]) > TAB_TAP_SLOP_PX) return;
    tabTouchEndedAt = Date.now();
    activateTabAt(index);
  }

  /** 取消（手势被系统/滚动手势接管）：只弃本轮起点，不落定。 */
  function handleTabTouchCancel(index: number): void {
    if (index < 0 || index >= tabTapArmed.length) return;
    tabTapArmed[index] = false;
  }

  /** click 兜底（H5 桌面无触摸；App 上紧随 touchend 的合成 click 在去重窗内被吞）。 */
  function handleTabClick(index: number): void {
    if (index < 0 || index >= tabTapArmed.length) return;
    if (Date.now() - tabTouchEndedAt <= TAB_CLICK_DEDUPE_MS) return;
    activateTabAt(index);
  }

</script>

<style scoped>
  .common-tab-bar {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: #ffffff;
  }

  .common-tab-bar__items {
    height: 50px;
    flex-shrink: 0;
  }

  .common-tab-bar__safe-area {
    flex-shrink: 0;
    height: 0px;
    background-color: #ffffff;
    /* #ifdef H5 || WEB */
    height: constant(safe-area-inset-bottom);
    height: env(safe-area-inset-bottom, 0px);
    /* #endif */
  }

  .common-tab-bar__hit {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* badge 绝对定位基准：本层横向 100% 同宽，水平锚点取中心（文案居中处） */
    position: relative;
  }

  .common-tab-bar__label {
    /* px 定值（原 35rpx/48rpx）：密度类不随屏宽缩放，宽屏/折叠屏展开不放大 */
    font-size: 17.5px;
    font-weight: 700;
    line-height: 24px;
    color: #8a8a93;
  }

  .common-tab-bar__label--active {
    color: #141416;
  }

  .common-tab-bar__badge {
    position: absolute;
    top: 4px;
    /* 水平锚点由「项右缘 12px」改为「项中心 + 固定 7.5px」：
       文案居中且字号已是 px 定值，中心随之固定；7.5px 为 375 屏旧几何换算
       （项宽 75、right 12、角标宽 18 → 左缘 45 − 中心 37.5），窄屏观感不变，
       折叠屏/平板展开项变宽时角标不再被右缘甩开 */
    left: 50%;
    margin-left: 7.5px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    background-color: #ff4d4f;
    align-items: center;
    justify-content: center;
  }

  .common-tab-bar__badge-text {
    font-size: 11px;
    color: #ffffff;
  }

</style>
