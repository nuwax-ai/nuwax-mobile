<template>
  <!-- 「N 条新消息」浮钮（飞书式，2026-11-02）：停留在会话页时息屏/锁屏/退后台，
       期间到达的消息在回页后仍在视口下方看不见——悬出本提示，点击滚到最新。
       零绑定挂载——条数读模块级 ref、点击经模块回调转发给页面（chat-ai-hint 同款，
       原因见 utils/chatNewMsgTip.uts：chat.uvue 模板 255 捕获上限）。
       ★与「回到底部」圆钮互斥：页面侧在条数 > 0 时收起圆钮（同一位置只留一个入口）。 -->
  <view
    v-if="count > 0"
    class="chat-new-msg-tip"
    hover-class="chat-new-msg-tip--active"
    @click="handleTap"
  >
    <text class="chat-new-msg-tip__text">{{ tCount("Mobile.Chat.newMessagesCount", count) }}</text>
    <view class="chat-new-msg-tip__arrow">
      <svg-icon name="icon-a-Chevrondown" size="12" unit="px" color="#1664ff" />
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { t as translateFn, toI18nParams } from "@/utils/i18n";
  import { chatNewMsgTipCount, triggerChatNewMsgTipJump } from "@/utils/chatNewMsgTip.uts";

  /** 模块级 ref 直接取别名（勿包 computed）：模板直读模块 ref、页面侧写入即重渲。 */
  const count = chatNewMsgTipCount;

  /** 文案在模板里逐渲染取（chat.uvue 同款），不缓存：语言包/文案更新即刻生效。 */
  const tCount = (key: string, c: number): string => {
    const m = new Map<string, string | number>();
    m.set("count", c);
    return translateFn(key, toI18nParams(m), "");
  };

  function handleTap(): void {
    triggerChatNewMsgTipJump();
  }
</script>

<style lang="scss" scoped>
  /* 悬于消息区右下（.chat-body-wrap 是 absolute 锚，底缘即输入坞顶）：
     白底胶囊 + 轻投影，右侧与「回到底部」圆钮同边（两者互斥，不会同框）。 */
  .chat-new-msg-tip {
    position: absolute;
    right: 14px;
    bottom: 16px;
    height: 36px;
    padding-left: 14px;
    padding-right: 10px;
    border-radius: 18px;
    background-color: #ffffff;
    box-shadow: 0 2px 8px rgba(31, 35, 41, 0.12);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-new-msg-tip--active {
    background-color: #f2f3f5;
  }

  /* 与「以下为新消息」分隔线同色（#1664ff）：同一语义的蓝 */
  .chat-new-msg-tip__text {
    font-size: 13px;
    line-height: 18px;
    color: #1664ff;
  }

  .chat-new-msg-tip__arrow {
    margin-left: 2px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }
</style>
