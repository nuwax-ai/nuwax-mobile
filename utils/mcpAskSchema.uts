/**
 * MCP Ask schema and tool input helpers (nuwax.interaction.v2).
 * Keeps SSE, history hydration, resume formatting, and card rendering aligned.
 *
 * v2:表单为有序自描述数组 ui.fields[];不再有 schema/uiSchema/ui:widget/enum。
 */
import {
  InteractionUiOptions,
  InteractionUiSchema,
  InteractionUiStep,
  McpAskFieldOption,
  McpAskFormField,
  McpAskInteraction,
  McpAskWidget,
  MCP_ASK_TOOL_NAME,
  MCP_ASK_WIDGET_TYPES,
} from "@/types/intervention";
import { firstString, orEmpty, orString } from "@/utils/utsCoalesce";

export const MCP_ASK_SCHEMA_VERSION = "nuwax.mcp_ask.v2";
export const INTERACTION_UI_SCHEMA_VERSION = "nuwax.interaction.v2";
export { MCP_ASK_TOOL_NAME };

/**
 * 解析后的字段:形状对齐渲染层(mcp-ask-question-card.uvue 的 toParsedField)读取路径。
 * property 为从 v2 McpAskFormField 重建的 JsonSchema 约束视图。
 * UTS: 需 class 构造
 */
export class ParsedMcpAskField {
  name: string = "";
  property: any | null = null;
  widget: McpAskWidget = "text";
  required: boolean = false;
  options: InteractionUiOptions = new InteractionUiOptions();
  enumValues: string[] = [];
  enumLabels: string[] = [];
  isInteger: boolean = false;
}

function asRecord(value: any | null): Record<string, unknown> | null {
  if (value != null && typeof value === "object") {
    return value as Record<string, unknown>;
  }
  return null;
}

function asObject(value: any): UTSJSONObject | null {
  if (value != null && typeof value === "object") {
    return value as UTSJSONObject;
  }
  return null;
}

function readField(obj: UTSJSONObject | null, key: string): any {
  if (obj == null) {
    return null as any;
  }
  return obj[key] as any;
}

function maybeParseRawInput(raw: any): any | null {
  if (typeof raw !== "string") {
    return raw as any;
  }
  try {
    return JSON.parse(raw) as any;
  } catch (_) {
    return null;
  }
}

function isFieldOption(opt: any): boolean {
  if (opt == null || typeof opt !== "object") {
    return false;
  }
  const option = opt as McpAskFieldOption;
  return typeof option.value === "string" && typeof option.label === "string";
}

function isKnownWidget(widget: string): boolean {
  for (let i = 0; i < MCP_ASK_WIDGET_TYPES.length; i++) {
    if (MCP_ASK_WIDGET_TYPES[i] === widget) {
      return true;
    }
  }
  return false;
}

/** 把 v2 字段重建为 JsonSchema 约束视图(toParsedField 读 minimum/maximum/type/title)。 */
function buildProperty(field: McpAskFormField): UTSJSONObject {
  const property = new UTSJSONObject();
  property["type"] = field.type;
  property["title"] = field.title;
  property["description"] = field.description;
  property["minimum"] = field.minimum;
  property["maximum"] = field.maximum;
  property["multipleOf"] = field.multipleOf;
  property["minLength"] = field.minLength;
  property["maxLength"] = field.maxLength;
  return property;
}

function buildOptions(field: McpAskFormField): InteractionUiOptions {
  const options = new InteractionUiOptions();
  options.placeholder = field.placeholder;
  options.allowCustom = field.allowCustom;
  options.otherValue = field.otherValue;
  options.otherField = field.otherField;
  options.accept = field.accept;
  options.multiple = field.multiple;
  return options;
}

function parseField(field: McpAskFormField): ParsedMcpAskField {
  const rawOptions = Array.isArray(field.options) ? field.options : [];
  const optionList: McpAskFieldOption[] = [];
  for (let i = 0; i < rawOptions.length; i++) {
    const opt = rawOptions[i];
    if (isFieldOption(opt)) {
      optionList.push(opt as McpAskFieldOption);
    }
  }
  const widget = isKnownWidget(field.widget)
    ? field.widget
    : ("text" as McpAskWidget);
  const parsed = new ParsedMcpAskField();
  parsed.name = field.name;
  parsed.property = buildProperty(field);
  parsed.widget = widget;
  parsed.required = field.required === true;
  parsed.options = buildOptions(field);
  parsed.enumValues = optionList.map(
    (opt: McpAskFieldOption): string => opt.value,
  );
  parsed.enumLabels = optionList.map(
    (opt: McpAskFieldOption): string => opt.label,
  );
  parsed.isInteger =
    getJsonSchemaPrimaryType(buildProperty(field)) === "integer";
  return parsed;
}

/**
 * 解析 v2 表单字段:遍历 ui.fields[],数组顺序即展示顺序。
 * 传入 fieldNames(wizard 步骤)时按其顺序与名称过滤。
 */
export function parseInteractionFields(
  ui: InteractionUiSchema,
  fieldNames: string[] | null = null,
): ParsedMcpAskField[] {
  const rawFields = Array.isArray(ui.fields) ? ui.fields : [];
  const allFields = rawFields as McpAskFormField[];
  if (fieldNames == null || fieldNames.length === 0) {
    return allFields.map(
      (field: McpAskFormField): ParsedMcpAskField => parseField(field),
    );
  }
  const result: ParsedMcpAskField[] = [];
  fieldNames.forEach((name: string) => {
    const found = allFields.find(
      (f: McpAskFormField): boolean => f.name === name,
    );
    if (found != null) {
      result.push(parseField(found));
    }
  });
  return result;
}

export function getInteractionSteps(
  ui: InteractionUiSchema,
): InteractionUiStep[] {
  if (ui.steps != null && ui.steps.length > 0) return ui.steps;

  const rawFields = Array.isArray(ui.fields) ? ui.fields : [];
  const allFields = rawFields as McpAskFormField[];
  if (allFields.length === 0) return [];

  const fieldNames = allFields.map((f: McpAskFormField): string => f.name);
  const step = new InteractionUiStep();
  step.id = "default";
  step.title = ui.title;
  step.description = ui.description;
  step.fields = fieldNames;
  return [step];
}

export function isWizardPresentation(ui: InteractionUiSchema): boolean {
  return ui.presentation === "wizard" || (!!ui.steps && ui.steps.length > 1);
}

/** 是否允许跳过:v2 由 ui.allowSkip 顶层字段控制(旧 v1 的 uiSchema.ui:options.allowSkip 已移除)。 */
export function isSkipAllowed(ui: InteractionUiSchema): boolean {
  return ui.allowSkip === true;
}

export function getSkipLabel(ui: InteractionUiSchema): string | null {
  const label = ui.skipLabel;
  if (label == null) return null;
  return label;
}

/** JSON Schema 主类型(忽略 null 联合)。parseField 用于判断 integer。 */
export function getJsonSchemaPrimaryType(property: any): string {
  const propertyObj = property as UTSJSONObject | null;
  if (propertyObj == null) {
    return "string";
  }
  const typeValue = propertyObj["type"];
  if (Array.isArray(typeValue)) {
    const types = typeValue as string[];
    for (let i = 0; i < types.length; i++) {
      if (types[i] !== "null") {
        return types[i];
      }
    }
    return "string";
  }
  return orString(typeValue as any, "string");
}

export function extractMcpAskStructuredInputFromResult(
  result: any,
): Record<string, unknown> | null {
  if (result == null || typeof result !== "object") {
    return null;
  }
  const resultObj = result as UTSJSONObject;
  const data = resultObj["data"];
  if (!Array.isArray(data)) return null;

  for (let i = 0; i < data.length; i++) {
    const item = data[i];
    if (item == null || typeof item !== "object") continue;
    const itemObj = item as UTSJSONObject;
    const contentRaw = itemObj["content"];
    if (contentRaw == null || typeof contentRaw !== "object") continue;
    const content = contentRaw as UTSJSONObject;
    if (content["type"] !== "text") continue;
    const text = content["text"];
    if (typeof text !== "string") continue;

    const trimmed = text.trim();
    if (!trimmed.startsWith("{")) continue;

    try {
      const parsed = JSON.parse(text) as UTSJSONObject;
      const input = parsed["input"];
      if (input != null && typeof input === "object") {
        const inputObj = input as UTSJSONObject;
        const keys = UTSJSONObject.keys(inputObj);
        if (keys.length > 0) {
          return input as Record<string, unknown>;
        }
      }
    } catch (_) {
      // 非 JSON,跳过
    }
  }
  return null;
}

/**
 * 仅支持 v2:优先 schemaVersion,其次 ui.version 推断。非 v2 返回 null。
 */
function resolveSchemaVersion(record: Record<string, unknown>): string | null {
  const recordObj = record as UTSJSONObject;
  const schemaVersion = readField(recordObj, "schemaVersion");
  if (
    typeof schemaVersion === "string" &&
    schemaVersion === MCP_ASK_SCHEMA_VERSION
  ) {
    return schemaVersion;
  }

  const ui = asObject(readField(recordObj, "ui"));
  const uiVersion = readField(ui, "version");
  if (
    typeof uiVersion === "string" &&
    uiVersion === INTERACTION_UI_SCHEMA_VERSION
  ) {
    return MCP_ASK_SCHEMA_VERSION;
  }

  const uiFields = readField(ui, "fields");
  const uiSchema = readField(ui, "schema");
  if (ui != null && Array.isArray(uiFields) && uiSchema == null) {
    return MCP_ASK_SCHEMA_VERSION;
  }

  return null;
}

export function parseMcpAskToolInput(raw: any): any | null {
  const parsedRaw = maybeParseRawInput(raw) as any;
  const record = asRecord(parsedRaw);
  if (record == null) return null;

  const schemaVersion = resolveSchemaVersion(record);
  if (schemaVersion == null || schemaVersion.length === 0) return null;

  const recordObj = record as UTSJSONObject;
  const toolName = orString(readField(recordObj, "toolName"), MCP_ASK_TOOL_NAME);
  if (toolName !== MCP_ASK_TOOL_NAME) {
    return null;
  }

  const ui = asObject(readField(recordObj, "ui"));
  const requestId = readField(recordObj, "requestId");
  if (
    typeof requestId !== "string" ||
    requestId.length === 0 ||
    ui == null
  ) {
    return null;
  }

  const sessionId = readField(recordObj, "sessionId");
  if (sessionId != null && typeof sessionId !== "string") {
    return null;
  }

  const revision = readField(recordObj, "revision");
  if (revision != null) {
    if (typeof revision !== "number") {
      return null;
    }
    const revisionNum = revision as number;
    if (revisionNum <= 0) {
      return null;
    }
    if (Math.floor(revisionNum) !== revisionNum) {
      return null;
    }
  }

  const title = readField(recordObj, "title");
  if (title != null && typeof title !== "string") {
    return null;
  }

  const uiFields = readField(ui, "fields");
  const uiSteps = readField(ui, "steps");
  const hasFields = Array.isArray(uiFields) && uiFields.length > 0;
  const hasSteps = Array.isArray(uiSteps) && uiSteps.length > 0;
  if (hasFields == false && hasSteps == false) return null;

  recordObj["schemaVersion"] = schemaVersion;
  recordObj["toolName"] = toolName;
  return recordObj;
}

export function createMcpAskInteractionFromToolInput(
  rawInput: any,
  toolCallId: string | null = null,
): McpAskInteraction | null {
  const input = parseMcpAskToolInput(rawInput);
  if (input == null) return null;

  const inputObj = input as UTSJSONObject;
  const ui = inputObj["ui"] as InteractionUiSchema;
  const interaction = new McpAskInteraction();
  interaction.toolName = orString(readField(inputObj, "toolName"), MCP_ASK_TOOL_NAME);
  interaction.schemaVersion = orString(
    readField(inputObj, "schemaVersion"),
    MCP_ASK_SCHEMA_VERSION,
  );
  interaction.requestId = orString(readField(inputObj, "requestId"), "");
  const revision = readField(inputObj, "revision");
  if (typeof revision === "number") {
    interaction.revision = revision;
  }
  interaction.sessionId = orEmpty(readField(inputObj, "sessionId"));
  interaction.toolCallId = toolCallId;
  interaction.title = firstString([
    readField(inputObj, "title"),
    ui.title,
  ] as any[]);
  const description = readField(inputObj, "description");
  interaction.description =
    description != null && `${description}`.length > 0
      ? `${description}`
      : ui.description;
  interaction.ui = ui;
  interaction.responseStatus = "pending";
  interaction.triggeredAt = Date.now();
  return interaction;
}
