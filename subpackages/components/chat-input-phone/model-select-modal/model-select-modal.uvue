<template>
  <radio-list-drawer
    :visible="visible"
    :title="t('Mobile.Chat.modelSelect')"
    :list="modelOptions"
    :current-value="currentModelIdVal.toString()"
    :readonly="readonly"
    :loading="isLoading"
    @onClose="handleClose"
    @onChange="handleModelChange"
  />
</template>

<script lang="uts" setup>
  import { RadioListItem } from "@/types/interfaces/radio";
  import RadioListDrawer from "@/components/radio-list-drawer/radio-list-drawer.uvue";
  import { apiGetAgentModelOptions } from "@/servers/agentDev";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { t as tRaw, emptyI18nParams } from "@/utils/i18n";
  import { readRawField } from "@/subpackages/utils/messageInfoClass.uts";
  import { readAgentEnumString } from "@/subpackages/utils/agentInfoField.uts";
  import { apiResCode, apiResData } from "@/utils/apiResponse";

  const t = (key: string): string => tRaw(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      visible: boolean;
      agentId: number;
      agentType: string;
      currentModelId: number;
      readonly?: boolean;
      isTempChat?: boolean;
    }>(),
    {
      visible: false,
      agentType: "ChatBot",
      readonly: false,
      isTempChat: false,
    },
  );

  const emit = defineEmits<{
    (e: 'onClose'): void;
    (e: 'onModelChange', modelId: number, name: string): void;
  }>();

  const modelOptions = ref<RadioListItem[]>([]);
  const isLoading = ref(false);

  const currentModelIdVal = computed((): number => {
    const id = props.currentModelId;
    if (id == null) {
      return 0;
    }
    return id;
  });

  const agentTypeStrVal = computed((): string => {
    const typeVal = props.agentType;
    if (typeVal == null || `${typeVal}`.length == 0) {
      return "ChatBot";
    }
    return readAgentEnumString(typeVal as any);
  });

  /** 模型 usageScenarios 是否包含当前智能体类型（Android：readRawField + 字符串比较） */
  const modelMatchesAgentType = (raw: any): boolean => {
    const agentTypeStr = agentTypeStrVal.value;
    if (agentTypeStr.length == 0) {
      return true;
    }
    const scenariosRaw = readRawField(raw, "usageScenarios");
    if (scenariosRaw == null) {
      return false;
    }
    const scenarios = scenariosRaw as any[];
    const len = scenarios.length;
    for (let i = 0; i < len; i++) {
      const scenarioStr = readAgentEnumString(scenarios[i]);
      if (scenarioStr == agentTypeStr) {
        return true;
      }
    }
    return false;
  };

  /** 可空描述兜底 */
  const coalesceDescription = (description: string | null | undefined): string => {
    if (description != null) {
      return description as string;
    }
    return "";
  };

  const handleClose = () => {
    emit("onClose");
  };

  const emitModelChange = (modelId: number, name: string): void => {
    if (modelId == 0 || name.length == 0) {
      return;
    }
    emit("onModelChange", modelId, name);
  };

  // 注意：handleModelChange 必须在 fetchModelOptions 之前定义（UTS 不提升函数声明）
  const handleModelChange = (value: string) => {
    let label = "";
    const list = modelOptions.value;
    const listLen = list.length;
    for (let i = 0; i < listLen; i++) {
      if (list[i].value == value) {
        label = list[i].label;
        break;
      }
    }
    emitModelChange(parseInt(value), label);
  };

  /** 同步当前模型：已有 modelId 则回填名称，否则默认选第一项 */
  const syncCurrentModelSelection = (): void => {
    const options = modelOptions.value;
    if (options.length == 0) {
      return;
    }
    const currentId = currentModelIdVal.value;
    if (currentId != 0) {
      const currentIdStr = `${currentId}`;
      for (let i = 0; i < options.length; i++) {
        if (options[i].value == currentIdStr) {
          emitModelChange(currentId, options[i].label);
          return;
        }
      }
    }
    handleModelChange(options[0].value);
  };

  // 获取并过滤模型列表
  const fetchModelOptions = async () => {
    if (props.isTempChat == true) {
      return;
    }
    if (props.agentId == 0) {
      return;
    }
    isLoading.value = true;
    try {
      modelOptions.value = [];
      const res = await apiGetAgentModelOptions(props.agentId);
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const dataRaw = apiResData<any>(res);
      if (dataRaw == null) {
        return;
      }
      const allModelsRaw = dataRaw as any[];
      const filteredModels: any[] = [];
      const allLen = allModelsRaw.length;
      for (let i = 0; i < allLen; i++) {
        const modelRaw = allModelsRaw[i];
        if (modelMatchesAgentType(modelRaw) == true) {
          filteredModels.push(modelRaw);
        }
      }

      const options: RadioListItem[] = [];
      const filteredLen = filteredModels.length;
      for (let j = 0; j < filteredLen; j++) {
        const modelRaw = filteredModels[j];
        const idRaw = readRawField(modelRaw, "id");
        const nameRaw = readRawField(modelRaw, "name");
        const descRaw = readRawField(modelRaw, "description");
        const idNum = idRaw != null ? parseFloat(`${idRaw}`) : 0;
        const nameStr = nameRaw != null ? `${nameRaw}` : "";
        if (idNum == 0 || nameStr.length == 0) {
          continue;
        }
        const item = new RadioListItem(
          nameStr,
          `${idNum}`,
          coalesceDescription(descRaw != null ? `${descRaw}` : ""),
        );
        options.push(item);
      }
      modelOptions.value = options;
      syncCurrentModelSelection();
    } catch (error) {
      console.error("[model-select-modal] 获取模型选项失败:", error);
    } finally {
      isLoading.value = false;
    }
  };

  watch((): boolean => props.visible, (newVal: boolean): void => {
    if (newVal == true) {
      fetchModelOptions();
    }
  });

  watch(
    (): number => props.agentId,
    (): void => {
      fetchModelOptions();
    },
  );

  watch(
    (): string => agentTypeStrVal.value,
    (): void => {
      fetchModelOptions();
    },
  );

  // 初始化加载数据，以便在外部显示首项名称（即使弹窗未打开）
  onMounted(() => {
    fetchModelOptions();
  });
</script>

<style lang="scss" scoped>
</style>
