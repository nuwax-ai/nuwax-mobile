<template>
  <view class="call-page">
    <safety-zone />
    <view class="call-head">
      <view class="call-head__space" />
      <text class="call-head__title">{{ mediaTitle }}</text>
      <view class="call-head__space" />
    </view>

    <view class="call-stage">
      <!-- #ifdef APP-ANDROID || APP-IOS -->
      <native-view v-if="remoteVideoOn" class="call-video call-video--remote" @init="handleRemoteVideoInit" />
      <native-view v-if="cameraOn" class="call-video call-video--local" @init="handleLocalVideoInit" />
      <!-- #endif -->
      <view v-if="!remoteVideoOn" class="call-avatar">
        <image v-if="peerAvatar.length > 0 && !avatarFailed" class="call-avatar__img" :src="peerAvatar" mode="aspectFill" @error="avatarFailed = true" />
        <text v-else class="call-avatar__text">{{ peerInitial }}</text>
      </view>
      <text class="call-name text-ellipsis">{{ peerName }}</text>
      <text class="call-status">{{ statusText }}</text>
    </view>

    <view v-if="phase == 'incoming'" class="call-actions call-actions--incoming">
      <view class="call-action" @click="decline">
        <view class="call-action__circle call-action__circle--danger"><text class="call-phone">☎</text></view>
        <text class="call-action__label">拒绝</text>
      </view>
      <view class="call-action" @click="accept">
        <view class="call-action__circle call-action__circle--accept"><text class="call-phone">☎</text></view>
        <text class="call-action__label">接听</text>
      </view>
    </view>

    <view v-else class="call-tools">
      <view class="call-tool" @click="toggleMic">
        <view class="call-tool__circle" :class="micOn ? '' : 'call-tool__circle--off'"><svg-icon name="icon-Mic" size="24" unit="px" :color="micOn ? '#141416' : '#ffffff'" /></view>
        <text class="call-tool__label">{{ micOn ? '静音' : '取消静音' }}</text>
      </view>
      <view class="call-tool" @click="toggleCamera">
        <view class="call-tool__circle" :class="cameraOn ? '' : 'call-tool__circle--off'"><svg-icon name="icon-VideoCamera" size="24" unit="px" :color="cameraOn ? '#141416' : '#ffffff'" /></view>
        <text class="call-tool__label">{{ cameraOn ? '关闭视频' : '开启视频' }}</text>
      </view>
      <view class="call-tool" @click="toggleSpeaker">
        <view class="call-tool__circle" :class="speakerOn ? '' : 'call-tool__circle--off'"><svg-icon name="icon-voice" size="24" unit="px" :color="speakerOn ? '#141416' : '#ffffff'" /></view>
        <text class="call-tool__label">扬声器</text>
      </view>
      <view class="call-tool" @click="hangup">
        <view class="call-tool__circle call-tool__circle--hangup"><text class="call-phone call-phone--small">☎</text></view>
        <text class="call-tool__label">挂断</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, onUnmounted, ref } from "vue";
  import { onLoad, onBackPress } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiUserInfo } from "@/servers/account";
  import { getImDeviceId, imDevicePlatform } from "@/servers/im";
  import { apiImMeetingCreateRoom } from "@/servers/imMeeting";
  import { apiImCallAnswered, apiImCallDeclined, apiImCallEnded, apiImSendVoipInvite } from "@/servers/imCall";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { generateUUID } from "@/utils/common";
  import eventBus from "@/utils/eventBus";
  import {
    IM_CALL_CHANGED_EVENT,
    clearImCallSession,
    finishImCall,
    getImCallSession,
    patchImCallSession,
  } from "@/utils/im/imCallSession";
  import {
    MEETING_MEDIA_CHANGED_EVENT,
    MeetingMediaOptions,
    meetingMediaConnect,
    meetingMediaDisconnect,
    meetingMediaRemoteVideoIdentities,
    meetingMediaSetCamera,
    meetingMediaSetMic,
    meetingMediaSetSpeaker,
    meetingMediaState,
    meetingMediaSupported,
  } from "@/utils/meeting/meetingMedia";
  // #ifdef APP-ANDROID || APP-IOS
  import { attachLocalVideo, createRemoteVideoView, createVideoView, releaseVideoView } from "@/uni_modules/nuwax-livekit";
  // #endif

  const phase = ref<string>("idle");
  const direction = ref<string>("");
  const callId = ref<string>("");
  const msgId = ref<string>("");
  const convId = ref<string>("");
  const roomName = ref<string>("");
  const mediaType = ref<string>("audio");
  const peerName = ref<string>("通话用户");
  const peerAvatar = ref<string>("");
  const detail = ref<string>("");
  const connectedAt = ref<number>(0);
  const elapsedSec = ref<number>(0);
  const micOn = ref<boolean>(false);
  const cameraOn = ref<boolean>(false);
  const speakerOn = ref<boolean>(true);
  const remoteIdentity = ref<string>("");
  const avatarFailed = ref<boolean>(false);
  let timer = 0;
  let invitationSentAt = 0;
  let closing = false;
  let connectedHandled = false;
  let emptyTicks = 0;

  const mediaTitle = computed((): string => mediaType.value == "video" ? "视频通话" : "语音通话");
  const peerInitial = computed((): string => peerName.value.length > 0 ? peerName.value.charAt(0) : "通");
  // 语音通话中双方也可随时开摄像头；不能用初始 mediaType 把远端视频挡掉。
  const remoteVideoOn = computed((): boolean => remoteIdentity.value.length > 0);
  const statusText = computed((): string => {
    if (detail.value.length > 0) return detail.value;
    if (phase.value == "incoming") return mediaType.value == "video" ? "邀请你进行视频通话" : "邀请你进行语音通话";
    if (phase.value == "outgoing") return "正在等待对方接听…";
    if (phase.value == "connecting") return "正在连接…";
    if (phase.value == "active") {
      const m = Math.floor(elapsedSec.value / 60);
      const s = elapsedSec.value % 60;
      return m + ":" + (s < 10 ? "0" : "") + s;
    }
    return "通话已结束";
  });

  function closeSoon(): void {
    setTimeout((): void => {
      clearImCallSession();
      const pages = getCurrentPages();
      if (pages.length > 1) uni.navigateBack({ delta: 1 });
      else uni.redirectTo({ url: "/pages/message/message" });
    }, 700);
  }

  function finishLocal(text: string): void {
    if (closing) return;
    closing = true;
    detail.value = text;
    finishImCall(text);
    meetingMediaDisconnect();
    closeSoon();
  }

  async function handleConnected(): Promise<void> {
    if (closing) return;
    connectedHandled = true;
    meetingMediaSetMic(true);
    meetingMediaSetSpeaker(true);
    meetingMediaSetCamera(mediaType.value == "video");
    if (direction.value == "out") {
      const sent = await apiImSendVoipInvite(convId.value, callId.value, mediaType.value, roomName.value, generateUUID());
      if (apiResCode(sent) != SUCCESS_CODE) {
        finishLocal("邀请发送失败");
        return;
      }
      const raw = apiResData<any>(sent);
      const obj = raw != null ? (raw as UTSJSONObject) : null;
      const id = obj != null && obj["msgId"] != null ? "" + obj["msgId"] : "";
      msgId.value = id;
      patchImCallSession("outgoing", id, "");
      invitationSentAt = Date.now();
    } else {
      if (msgId.value.length > 0) await apiImCallAnswered(convId.value, msgId.value, callId.value, roomName.value);
      connectedAt.value = Date.now();
      patchImCallSession("active", "", "");
    }
  }

  function syncSession(): void {
    const s = getImCallSession();
    phase.value = s.phase;
    direction.value = s.direction;
    callId.value = s.callId;
    msgId.value = s.msgId;
    convId.value = s.convId;
    roomName.value = s.roomName;
    mediaType.value = s.mediaType;
    peerName.value = s.peerName.length > 0 ? s.peerName : "通话用户";
    peerAvatar.value = s.peerAvatar;
    detail.value = s.detail;
    if (phase.value == "ended" && !closing) closeSoon();
  }

  function refreshMedia(): void {
    const st = meetingMediaState();
    micOn.value = st.micOn;
    cameraOn.value = st.cameraOn;
    speakerOn.value = st.speakerOn;
    const ids = meetingMediaRemoteVideoIdentities();
    remoteIdentity.value = ids.length > 0 ? ids[0] : "";
    if (st.connected && !connectedHandled) handleConnected();
    if (phase.value == "active") {
      if (st.peopleCount <= 1) emptyTicks++; else emptyTicks = 0;
      if (emptyTicks >= 8) finishLocal("对方已离开");
    }
  }

  const onSessionChanged = (_payload: any): void => { syncSession(); };
  const onMediaChanged = (_payload: any): void => { refreshMedia(); };

  async function myDisplayName(): Promise<string> {
    try {
      const res = await apiUserInfo();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const obj = raw != null ? (raw as UTSJSONObject) : null;
        if (obj != null) {
          const nick = obj["nickName"] == null ? "" : "" + obj["nickName"];
          if (nick.length > 0) return nick;
          const name = obj["userName"] == null ? "" : "" + obj["userName"];
          if (name.length > 0) return name;
        }
      }
    } catch (_e) {}
    return "用户";
  }

  async function connectRoom(): Promise<void> {
    if (!meetingMediaSupported()) {
      finishLocal("当前基座未包含音视频能力");
      return;
    }
    const options = new MeetingMediaOptions();
    options.room = roomName.value;
    options.displayName = await myDisplayName();
    await meetingMediaConnect(options);
    refreshMedia();
  }

  async function beginOutgoing(): Promise<void> {
    const body: UTSJSONObject = {};
    body["name"] = roomName.value;
    body["platform"] = imDevicePlatform();
    body["deviceId"] = getImDeviceId();
    body["maxParticipants"] = 2;
    body["allowGuest"] = false;
    body["emptyTimeoutSeconds"] = 120;
    const created = await apiImMeetingCreateRoom(body, true);
    if (apiResCode(created) != SUCCESS_CODE) {
      finishLocal("通话创建失败");
      return;
    }
    await connectRoom();
  }

  async function accept(): Promise<void> {
    if (phase.value != "incoming") return;
    patchImCallSession("connecting", "", "");
    await connectRoom();
  }

  async function decline(): Promise<void> {
    if (msgId.value.length > 0) await apiImCallDeclined(convId.value, msgId.value, callId.value, roomName.value);
    finishLocal("已拒绝");
  }

  async function hangup(): Promise<void> {
    if (direction.value == "in" && phase.value == "incoming" && msgId.value.length > 0) {
      await apiImCallDeclined(convId.value, msgId.value, callId.value, roomName.value);
    }
    if (direction.value == "out" && phase.value != "active" && msgId.value.length > 0) await apiImCallEnded(convId.value, msgId.value, "cancel");
    finishLocal("通话已结束");
  }

  function toggleMic(): void { meetingMediaSetMic(!micOn.value); refreshMedia(); }
  function toggleCamera(): void {
    meetingMediaSetCamera(!cameraOn.value);
    // #ifdef APP-ANDROID || APP-IOS
    if (cameraOn.value) releaseVideoView();
    // #endif
    refreshMedia();
  }
  function toggleSpeaker(): void { meetingMediaSetSpeaker(!speakerOn.value); refreshMedia(); }

  function tick(): void {
    refreshMedia();
    if (phase.value == "incoming" && Date.now() - getImCallSession().startedAt >= 65000) {
      finishLocal("未接听");
      return;
    }
    if (phase.value == "outgoing" && meetingMediaState().peopleCount > 1) {
      connectedAt.value = Date.now();
      patchImCallSession("active", "", "");
    }
    if (phase.value == "active" && connectedAt.value > 0) elapsedSec.value = Math.max(0, Math.floor((Date.now() - connectedAt.value) / 1000));
    if (phase.value == "outgoing" && invitationSentAt > 0 && Date.now() - invitationSentAt >= 60000) {
      if (msgId.value.length > 0) apiImCallEnded(convId.value, msgId.value, "timeout");
      finishLocal("无人接听");
    }
  }

  // #ifdef APP-ANDROID || APP-IOS
  function handleLocalVideoInit(event: any): void {
    const e = event as UniNativeViewInitEvent;
    // #ifdef APP-ANDROID
    const view = createVideoView();
    if (view != null) e.detail.element.bindAndroidView(view!!);
    // #endif
    // #ifdef APP-IOS
    createVideoView(e.detail.element);
    // #endif
    attachLocalVideo();
  }
  function handleRemoteVideoInit(event: any): void {
    if (remoteIdentity.value.length == 0) return;
    const e = event as UniNativeViewInitEvent;
    // #ifdef APP-ANDROID
    const view = createRemoteVideoView(remoteIdentity.value);
    if (view != null) e.detail.element.bindAndroidView(view!!);
    // #endif
    // #ifdef APP-IOS
    createRemoteVideoView(remoteIdentity.value, e.detail.element);
    // #endif
  }
  // #endif

  onLoad((_options: any) => {
    syncSession();
    eventBus.on(IM_CALL_CHANGED_EVENT, onSessionChanged);
    eventBus.on(MEETING_MEDIA_CHANGED_EVENT, onMediaChanged);
    timer = setInterval(tick, 500);
    if (phase.value == "outgoing") beginOutgoing();
  });

  onBackPress((_options: OnBackPressOptions): boolean => {
    hangup();
    return true;
  });

  onUnmounted(() => {
    if (timer != 0) clearInterval(timer);
    eventBus.off(IM_CALL_CHANGED_EVENT, onSessionChanged);
    eventBus.off(MEETING_MEDIA_CHANGED_EVENT, onMediaChanged);
    if (!closing && phase.value != "idle" && phase.value != "ended") hangup();
  });
</script>

<style lang="scss" scoped>
  .call-page { flex: 1; background-color: #17181c; }
  .call-head { height: 48px; padding: 0 12px; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
  .call-head__space { width: 40px; }
  .call-head__title { color: #ffffff; font-size: 16px; font-weight: 600; }
  .call-stage { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .call-video--remote { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
  .call-video--local { position: absolute; width: 112px; height: 168px; right: 16px; top: 16px; border-radius: 12px; overflow: hidden; z-index: 3; }
  .call-avatar { width: 108px; height: 108px; border-radius: 54px; background-color: #5554a7; align-items: center; justify-content: center; overflow: hidden; z-index: 2; }
  .call-avatar__img { width: 108px; height: 108px; }
  .call-avatar__text { color: #ffffff; font-size: 42px; font-weight: 600; }
  .call-name { margin-top: 22px; max-width: 260px; color: #ffffff; font-size: 24px; font-weight: 600; z-index: 4; }
  .call-status { margin-top: 10px; color: #c9cad1; font-size: 14px; z-index: 4; }
  .call-actions, .call-tools { padding: 22px 24px 40px; display: flex; flex-direction: row; align-items: center; justify-content: space-around; }
  .call-actions--incoming { padding-left: 64px; padding-right: 64px; }
  .call-action, .call-tool { width: 72px; align-items: center; }
  .call-action__circle, .call-tool__circle { width: 58px; height: 58px; border-radius: 29px; background-color: #ffffff; align-items: center; justify-content: center; }
  .call-action__circle--danger, .call-tool__circle--hangup { background-color: #e5484d; transform: rotate(135deg); }
  .call-action__circle--accept { background-color: #31c46c; }
  .call-tool__circle--off { background-color: #61636b; }
  .call-action__label, .call-tool__label { margin-top: 9px; color: #ffffff; font-size: 12px; text-align: center; }
  .call-phone { color: #ffffff; font-size: 30px; line-height: 32px; }
  .call-phone--small { font-size: 26px; }
</style>
