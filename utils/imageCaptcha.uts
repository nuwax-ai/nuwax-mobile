/** 图形验证码与阿里云验证码开关相互独立。兼容 App prop 的动态字段读取。 */
export function isImageCaptchaEnabled(config: UTSJSONObject | null): boolean {
  if (config == null) return false;
  const direct = config["openImageCaptcha"];
  if (direct != null) return `${direct}` == "1";
  const json = JSON.stringify(config);
  if (json == null || json.length <= 2) return false;
  const parsed = JSON.parse<UTSJSONObject>(json);
  if (parsed == null) return false;
  const value = parsed["openImageCaptcha"];
  return value != null && `${value}` == "1";
}

/** 返回提示文案 key；关闭时不要求图形验证码。 */
export function imageCaptchaValidationKey(
  enabled: boolean,
  captchaId: string,
  captchaCode: string,
): string {
  if (!enabled) return "";
  if (captchaId.length == 0) return "Mobile.Auth.imageCaptchaLoadFailed";
  if (captchaCode.trim().length == 0) return "Mobile.Auth.imageCaptchaRequired";
  return "";
}

/** 每次换图立即作废旧挑战；迟到响应和卸载后的响应不能恢复旧 ID。 */
export class ImageCaptchaChallenge {
  captchaId: string = "";
  captchaCode: string = "";
  image: string = "";
  loading: boolean = false;
  requestSeq: number = 0;

  begin(): number {
    this.invalidate();
    this.loading = true;
    return this.requestSeq;
  }

  complete(seq: number, captchaId: string, image: string): boolean {
    if (seq != this.requestSeq) return false;
    this.loading = false;
    // 图片或 ID 缺失都不是有效挑战，禁止提交半个响应。
    if (captchaId.length > 0 && image.length > 0) {
      this.captchaId = captchaId;
      this.image = image;
    }
    this.captchaCode = "";
    return true;
  }

  invalidate(): void {
    this.requestSeq = this.requestSeq + 1;
    this.captchaId = "";
    this.captchaCode = "";
    this.image = "";
    this.loading = false;
  }
}
