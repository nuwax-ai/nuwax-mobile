<template>
  <view class="captcha-page">
    <!-- #ifdef APP-ANDROID -->
    <custom-nav-bar
      :title="title"
      className="border-b"
      hasSafetyZone
      showBack
    />
    <!-- #endif -->
    <web-view id="aliyun-captcha-webview" :src="src" @message="onMessage"></web-view>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import { getApiBaseUrl } from "@/constants/config";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { extractCaptchaVerifyParam } from "@/utils/aliyunCaptcha";

  const _params = emptyI18nParams();
  const t = (key: string): string => translateFn(key, _params, "");

  const path = "/static/aliyun-captcha.html";

  const title = computed((): string => {
    return t("Mobile.ThirdParty.AliyunCaptcha.title");
  });
  const src = computed((): string => {
    return getApiBaseUrl() + path;
  });

  function onMessage(event: UniWebViewMessageEvent) {
    const messages = event.detail.data;
    if (messages.length == 0) {
      return;
    }
    // 与微信小程序保持一致：直接取回阿里云返回的原始校验参数。
    const rawParam = messages[messages.length - 1] as any;
    const captchaVerifyParam = extractCaptchaVerifyParam(rawParam);
    if (captchaVerifyParam.length == 0) {
      return;
    }
    uni.$emit("login_aliyun_captcha_result", captchaVerifyParam);
    uni.navigateBack({ delta: 1 });
  }
</script>

<style lang="scss" scoped>
.captcha-page {
  flex: 1;
}
</style>
