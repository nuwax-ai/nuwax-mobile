  .emoji-bind {
    margin-top: 8rpx;
  }

  .field-label {
    font-size: 24rpx;
    color: #666666;
    padding: 20rpx 32rpx 12rpx;
  }

  .card-group {
    background-color: #ffffff;
    border-radius: 16rpx;
    margin: 0 24rpx;
    overflow: hidden;
  }

  .row-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 20rpx 32rpx;
    border-bottom: 2rpx solid #f8f8f8;

    &:last-child {
      border-bottom-width: 0;
    }

    &-active {
      background-color: rgba(12, 20, 102, 0.04);
    }

    .emoji-box {
      width: 72rpx;
      display: flex;
      align-items: center;
      justify-content: center;

      .emoji-text {
        font-size: 40rpx;
      }
    }

    .row-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;

      .row-title {
        font-size: 30rpx;
        font-weight: 500;
        color: #1a1a1a;
      }
    }

    .emoji-current {
      font-size: 32rpx;
      color: #666666;
      margin-right: 8rpx;
    }

    .row-arrow {
      font-size: 40rpx;
      color: #c0c0c0;
      font-weight: 300;
      line-height: 1;
      padding-left: 8rpx;
    }
  }
</style>
