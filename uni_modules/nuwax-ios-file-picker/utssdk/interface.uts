/** 用户选中的文件（path=ASCII 物化路径、name=原文件名含扩展名、size=字节数）。
 *  物化失败时 path 回落系统拷贝原路径（名称可能含中文/空格，uploadFile 会编码失败）。 */
export type IosFilePickedCallback = (path: string, name: string, size: number) => void;

/** 文件选择器失败或取消。 */
export type IosFileFailureCallback = (code: string, message: string) => void;

/** 打开 iOS 系统文件选择器。 */
export type PickIosFilesApi = (
  onPicked: IosFilePickedCallback,
  onFail: IosFileFailureCallback,
) => void;
