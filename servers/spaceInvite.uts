import request from "@/servers/useRequest";
import { RequestResponse } from "@/types/interfaces/request";
import { spaceInvitePageUrl } from "@/utils/spaceInvite";

export async function apiSpaceInviteInfo(code: string): Promise<RequestResponse<any>> {
  return await request({ url: "/api/space/invite/info/" + encodeURIComponent(code), method: "GET", authReturnUrl: spaceInvitePageUrl(code), suppressErrorToast: true });
}

export async function apiSpaceInviteJoin(code: string): Promise<RequestResponse<any>> {
  return await request({ url: "/api/space/invite/join/" + encodeURIComponent(code), method: "POST", authReturnUrl: spaceInvitePageUrl(code), suppressErrorToast: true });
}
