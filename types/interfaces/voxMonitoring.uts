/**
 * Nuwax Vox 设备语音网关 - App 监控接口类型
 * 接口文档: GET /api/app/monitorings 等
 */

/** 监控列表查询参数（与会议同形） */
export class AppMonitoringListParams {
  keyword: string = "";
  // ALL | TODAY | THIS_WEEK | THIS_MONTH
  timeRange: string = "ALL";
  // 页码，从 1 开始
  page: number = 1;
  pageSize: number = 20;
  /**
   * 设备过滤。
   * ⚠️ 后端 GET /api/app/monitorings 暂未支持 deviceId 查询，先透传；
   * 后端加上该可选参数后即生效，无需改前端。
   */
  deviceId: string = "";
}

/** 监控列表项（AppMonitoringView） */
export interface IAppMonitoringView {
  id: number;
  deviceId: string;
  // 监控运行 ID
  runId: string;
  status: string;
  // 录音原始 URL（有值表示有录音；播放需调 /monitorings/{id}/audio-url）
  audioFileUrl: string;
  audioBytes: number;
  audioDurationMs: number;
  startedAt: string;
  endedAt: string;
  // 转写摘要预览（截断）
  transcriptPreview: string;
}

/** 监控列表分页（AppMonitoringPageView） */
export interface IAppMonitoringPageView {
  items: IAppMonitoringView[];
  total: number;
  page: number;
  pageSize: number;
}

/** 监控录音临时播放地址（AppMonitoringAudioUrlView） */
export interface IAppMonitoringAudioUrlView {
  url: string;
  expiresInSeconds: number;
}

/** 监控详情（AppMonitoringDetailView） */
export interface IAppMonitoringDetailView {
  id: number;
  deviceId: string;
  runId: string;
  status: string;
  startedAt: string;
  endedAt: string;
  // 转写全文
  transcript: string;
  audioFileUrl: string;
  audioBytes: number;
  audioDurationMs: number;
  // 分段转写
  utterances: UTSJSONObject[];
}

/** 监控内容（场景）项（AppMonitoringContentView） */
export interface IAppMonitoringContentView {
  id: number;
  title: string;
  keywords: string[];
  enabled: boolean;
  sortOrder: number;
}

/** 监控设置（AppMonitoringSettingsView） */
export interface IAppMonitoringSettingsView {
  appAlertEnabled: boolean;
  smsAlertEnabled: boolean;
  smsPhones: string[];
  segmentMinutes: number;
  contents: IAppMonitoringContentView[];
}

/** 更新监控设置（POST /monitoring/settings/update；未传字段保持原值） */
export class AppMonitoringSettingsUpdateParams {
  appAlertEnabled: boolean | null = null;
  smsAlertEnabled: boolean | null = null;
}

/** 监控内容新增/更新（POST /monitoring/contents、/contents/{id}/update） */
export class AppMonitoringContentUpsertParams {
  title: string = "";
  keywords: string[] = [];
  enabled: boolean | null = null;
}
