    .row-badge {
      min-width: 36rpx;
      height: 36rpx;
      padding: 0 10rpx;
      border-radius: 100rpx;
      background-color: #ff4d4f;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      margin-right: 8rpx;

      .row-badge-text {
        font-size: 22rpx;
        font-weight: 600;
        color: #ffffff;
        line-height: 36rpx;
        text-align: center;
      }
    }
  }

  /* 退出登录 */
  .logout-group {
    margin-top: 24rpx;
  }

  /* 危险操作文案（注销账号）：提升层级，覆盖 .row-item .row-info .row-title 的默认深色 */
  .logout-item {
    .row-info {
