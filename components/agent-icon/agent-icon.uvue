<template>
  <view class="agent-icon">
    <view class="agent-icon-mask">
      <image
        :src="currentIcon"
        class="agent-icon-image"
        mode="aspectFill"
        :fade-show="false"
        :alt="alt"
        @error="handleImageError"
      />
      <image
        v-if="pendingIcon.length > 0"
        :src="pendingIcon"
        :class="pendingIconVisible
          ? 'agent-icon-image agent-icon-image-pending agent-icon-image-visible'
          : 'agent-icon-image agent-icon-image-pending'"
        mode="aspectFill"
        :fade-show="false"
        :alt="alt"
        @load="handlePendingImageLoad"
        @error="handlePendingImageError"
      />
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, watch } from "vue";
  import defaultAgentIcon from "@/static/assets/agent_image.png";
  import { resolveAppSvgUrl } from "@/utils/remoteSvgImage";

  interface AgentIconProps {
    icon: string;
    alt?: string | null;
  }

  const props = withDefaults(defineProps<AgentIconProps>(), {
    alt: null,
  });

  // App 端远程 SVG 需按容器尺寸（96rpx）各自解析；H5/小程序 resolveAppSvgUrl 原样透传。
  // raw* 保存未解析的原始值用于比对，currentIcon/pendingIcon 保存解析后的 src。
  const rawCurrentIcon = ref<string>(props.icon.length > 0 ? props.icon : defaultAgentIcon);
  const currentIcon = ref<string>(rawCurrentIcon.value);
  const rawPendingIcon = ref<string>("");
  const pendingIcon = ref<string>("");
  const pendingIconVisible = ref<boolean>(false);
  // 异步解析竞态序号：保证过期的解析结果不会覆盖新目标
  let resolveSeq = 0;

  // 初始图标解析（挂载即执行；PNG/非 App 端微任务内透传完成，无闪烁）
  const applyInitialIcon = () : void => {
    const seq = ++resolveSeq;
    resolveAppSvgUrl(rawCurrentIcon.value, 96, 96).then((resolved : string) => {
      if (seq == resolveSeq) {
        currentIcon.value = resolved;
      }
    });
  };
  applyInitialIcon();

  watch(
    () : string => props.icon,
    (icon : string) => {
      const nextIcon = icon.length > 0 ? icon : defaultAgentIcon;
      if (nextIcon == rawCurrentIcon.value) {
        pendingIconVisible.value = false;
        pendingIcon.value = "";
        rawPendingIcon.value = "";
        return;
      }
      if (nextIcon == rawPendingIcon.value) return;

      // 上一张候选图已经显示时，先将其提升为底图；它已完成解码，不会出现空白帧。
      if (pendingIconVisible.value && pendingIcon.value.length > 0) {
        currentIcon.value = pendingIcon.value;
        rawCurrentIcon.value = rawPendingIcon.value;
      }
      pendingIconVisible.value = false;
      rawPendingIcon.value = nextIcon;
      const seq = ++resolveSeq;
      resolveAppSvgUrl(nextIcon, 96, 96).then((resolved : string) => {
        if (seq != resolveSeq || rawPendingIcon.value != nextIcon) return;
        pendingIcon.value = resolved;
      });
    },
  );

  const handleImageError = () => {
    if (rawCurrentIcon.value != defaultAgentIcon) {
      rawCurrentIcon.value = defaultAgentIcon;
      currentIcon.value = defaultAgentIcon;
    }
  };

  const handlePendingImageLoad = () => {
    const expectedIcon = props.icon.length > 0 ? props.icon : defaultAgentIcon;
    if (rawPendingIcon.value == expectedIcon) {
      pendingIconVisible.value = true;
    }
  };

  const handlePendingImageError = () => {
    pendingIconVisible.value = false;
    if (rawPendingIcon.value != defaultAgentIcon) {
      rawPendingIcon.value = defaultAgentIcon;
      pendingIcon.value = defaultAgentIcon;
    } else {
      rawPendingIcon.value = "";
      pendingIcon.value = "";
    }
  };
</script>

<style scoped lang="scss">
  .agent-icon {
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    flex-shrink: 0;
    margin-right: 24rpx;

    .agent-icon-mask {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      overflow: hidden;

      .agent-icon-image {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
      }

      .agent-icon-image-pending {
        opacity: 0;
        z-index: 2;
      }

      .agent-icon-image-visible {
        opacity: 1;
      }
    }
  }
</style>
