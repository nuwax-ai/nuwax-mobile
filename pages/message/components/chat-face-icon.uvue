<template>
  <!-- 表情键图标：纯 view 绘制（圆环 + 两眼 + 下弧嘴）。
       ★鸿蒙专用（APP-HARMONY）：该平台的 <image> 初帧创建的节点不上屏——动态 src、
       静态字面量 src、延迟到 onReady 后挂载三种写法均真机复验失败（2026-10-20），
       点按（触发 re-render 新建节点）后才显示。view/text 走常规渲染管线，
       首帧即上屏，彻底绕开图片加载；其它平台仍用 icon-face.png（视觉保持
       2026-10-01 双色 PNG 的调校）。尺寸/配色与 .chat-tool__face 口径一致（24px，
       基色 #7a7887、激活 #337eff）。 -->
  <view class="chat-face">
    <view :class="props.active ? 'chat-face__ring chat-face__ring--on' : 'chat-face__ring'" />
    <view
      :class="props.active ? 'chat-face__eye chat-face__eye--l chat-face__eye--on' : 'chat-face__eye chat-face__eye--l'"
    />
    <view
      :class="props.active ? 'chat-face__eye chat-face__eye--r chat-face__eye--on' : 'chat-face__eye chat-face__eye--r'"
    />
    <!-- 嘴：父层裁上半，子层整圆下移半高 → 只露下半圈弧（= 微笑） -->
    <view class="chat-face__smile">
      <view :class="props.active ? 'chat-face__arc chat-face__arc--on' : 'chat-face__arc'" />
    </view>
  </view>
</template>

<script setup lang="uts">
  const props = withDefaults(
    defineProps<{
      /** 激活态（面板展开或按键按下）：整图换蓝，对齐 PNG 双色口径 */
      active?: boolean;
    }>(),
    {
      active: false,
    },
  );
</script>

<style lang="scss" scoped>
  .chat-face {
    position: relative;
    width: 24px;
    height: 24px;
  }

  /* 外圈：直径 22px 居中，描边 1.8px（PNG 描边视觉粗细） */
  .chat-face__ring {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.8px solid #7a7887;
    box-sizing: border-box;
  }

  .chat-face__ring--on {
    border-color: #337eff;
  }

  /* 眼睛：2.4px 小圆点，光学位置对齐 PNG（圈内上 1/3） */
  .chat-face__eye {
    position: absolute;
    top: 9px;
    width: 2.4px;
    height: 2.4px;
    border-radius: 50%;
    background-color: #7a7887;
  }

  .chat-face__eye--l {
    left: 8px;
  }

  .chat-face__eye--r {
    left: 13.6px;
  }

  .chat-face__eye--on {
    background-color: #337eff;
  }

  /* 嘴的裁切窗：11×5.5px，只保留子圆的下半圈 */
  .chat-face__smile {
    position: absolute;
    left: 6.5px;
    top: 12.4px;
    width: 11px;
    height: 5.6px;
    overflow: hidden;
  }

  .chat-face__arc {
    width: 11px;
    height: 11px;
    margin-top: -5.4px;
    border-radius: 50%;
    border: 1.8px solid #7a7887;
    box-sizing: border-box;
  }

  .chat-face__arc--on {
    border-color: #337eff;
  }
</style>
