<template>
  <view class="update-dialog__mask">
    <view class="update-dialog__panel" @tap.stop>
      <text class="update-dialog__title">{{ title }}</text>
      <view class="update-dialog__body">
        <text class="update-dialog__log">{{ versionInfo }}</text>
      </view>
      <view class="update-dialog__actions">
        <view class="update-dialog__btn update-dialog__btn--cancel" @tap="cancel">
          <text class="update-dialog__btn-text">{{ t("Mobile.Common.cancel") }}</text>
        </view>
        <view class="update-dialog__btn" @tap="update">
          <text class="update-dialog__btn-text update-dialog__btn-text--primary">{{
            t("Mobile.Mine.updateNow")
          }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { openExternalUrl } from "@/utils/openExternalUrl";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const title = ref("");
  const versionInfo = ref("");
  const updateUrl = ref("");

  const readOption = (value: any | null): string => {
    if (value == null) return "";
    // dialogPage 的查询参数已由运行时解码，禁止再次 decodeURIComponent：
    // 更新日志中的 "30%" 会被二次解码视为非法百分号转义并在 Android 崩溃。
    return `${value}`;
  };

  onLoad((options: OnLoadOptions) => {
    title.value = readOption(options["title"]);
    versionInfo.value = readOption(options["versionInfo"]);
    updateUrl.value = readOption(options["url"]);
  });

  const closeSelf = (): void => {
    uni.closeDialogPage({});
  };

  const cancel = (): void => {
    closeSelf();
  };

  const update = (): void => {
    openExternalUrl(updateUrl.value)
      .then((): void => {
        closeSelf();
      })
      .catch((): void => {
        uni.showToast({
          title: t("Mobile.Mine.openUpdateFailed"),
          icon: "none",
        });
      });
  };
</script>

<style lang="scss" scoped>
  .update-dialog__mask {
    position: fixed;
    z-index: 1000;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .update-dialog__panel {
    width: 620rpx;
    box-sizing: border-box;
    background-color: #ffffff;
    border-radius: 24rpx;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .update-dialog__title {
    font-size: 32rpx;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 44rpx;
    text-align: center;
    margin: 44rpx 40rpx 0;
  }

  .update-dialog__body {
    box-sizing: border-box;
    padding: 28rpx 40rpx 40rpx;
  }

  .update-dialog__log {
    width: 100%;
    font-size: 28rpx;
    color: #666666;
    line-height: 44rpx;
    text-align: left;
  }

  .update-dialog__actions {
    display: flex;
    flex-direction: row;
    border-top: 2rpx solid #f0f0f0;
  }

  .update-dialog__btn {
    flex: 1;
    height: 100rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .update-dialog__btn--cancel {
    border-right: 2rpx solid #f0f0f0;
  }

  .update-dialog__btn-text {
    font-size: 32rpx;
    color: #1a1a1a;
  }

  .update-dialog__btn-text--primary {
    color: #576b95;
  }
</style>
