<template>
  <!--
    修改备注底部弹窗：
    - 标题后跟当前展示名（灰字括号），输入框预填现有备注（无备注则空）
    - 留空保存 = 清除备注（回落平台昵称）：PUT /contacts/{userId}/remark {"remark":""}
    - 上限 32 字（服务端 MAX_REMARK）；成功后关弹窗并通知页面刷新联系人列表
      （displayName = remark > nickName > userName，刷新后才更新）
  -->
  <uni-modal-popup
    ref="popupRef"
    position="bottom"
    :height="sheetHeight"
    :show-header="false"
    :body-scroll="false"
    :enable-swipe-close="true"
    @afterleave="handleAfterLeave"
  >
    <view class="remark-sheet" :style="sheetStyle">
      <view class="remark-sheet__header">
        <view class="remark-sheet__title-row">
          <text class="remark-sheet__title">{{ t("Mobile.Message.editRemark") }}</text>
          <text v-if="contactName.length > 0" class="remark-sheet__title-name">
            （{{ contactName }}）
          </text>
        </view>
        <view class="remark-sheet__close" @click="close">
          <svg-icon name="icon-X" size="36" color="#8a8a8a" />
        </view>
      </view>

      <view class="remark-sheet__form">
        <input
          class="remark-sheet__input"
          v-model="remark"
          :maxlength="32"
          :placeholder="t('Mobile.Message.remarkPlaceholder')"
          placeholder-class="remark-sheet__ph"
        />
      </view>

      <view class="remark-sheet__footer">
        <view
          class="remark-sheet__btn"
          hover-class="remark-sheet__btn-cancel--active"
          @click="close"
        >
          <text class="remark-sheet__btn-text remark-sheet__btn-text--cancel">
            {{ t("Mobile.Common.cancel") }}
          </text>
        </view>
        <view
          class="remark-sheet__btn remark-sheet__btn--ok"
          :class="{ 'remark-sheet__btn--disabled': busy }"
          hover-class="remark-sheet__btn-ok--active"
          @click="handleSubmit"
        >
          <text class="remark-sheet__btn-text remark-sheet__btn-text--ok">
            {{ t("Mobile.Common.save") }}
          </text>
        </view>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { computed, onUnmounted, ref, type ComponentPublicInstance } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiResCode } from "@/utils/apiResponse";
  import { apiImContactSetRemark } from "@/servers/im";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const emit = defineEmits<{
    /** 备注保存成功（页面借此刷新联系人列表，displayName 随之更新） */
    saved: [];
  }>();

  const popupRef = ref<any | null>(null);
  const tabBarHiddenBySheet = ref<boolean>(false);
  /** 目标联系人（userId 是 int64 雪花号，全程存字符串） */
  let targetUserId = "";
  const contactName = ref<string>("");
  /** 备注输入（预填现有值；留空保存 = 清除） */
  const remark = ref<string>("");
  /** 提交防重 */
  const busy = ref<boolean>(false);

  /**
   * 面板高度：内容固定 ~336rpx + 底部安全区（px→rpx 反算）。
   * popup 的 body 槽在 App 端是 height:0 + flex:1，必须给面板确定高度（auto 会塌陷），
   * 故不用固定百分比（32% 在高分屏留大片空白、不紧凑）。
   */
  const sheetHeight = computed((): string => {
    let safeRpx = 0;
    // #ifndef H5
    try {
      const win = uni.getWindowInfo();
      const scale = win.windowWidth / 750;
      if (scale > 0) {
        safeRpx = Math.ceil(win.safeAreaInsets.bottom / scale);
      }
    } catch (_e) {
      safeRpx = 0;
    }
    // #endif
    return `${336 + safeRpx}rpx`;
  });

  /**
   * 底部安全距离：App 端样式表 env(safe-area-inset-bottom) 不可靠（H5/小程序走
   * 样式表 env()，勿重复叠加），这里内联把底部内边距改为 24rpx 基础 + 系统安全
   * 区（px），按钮避开 iPhone home 条。
   */
  const sheetStyle = computed((): string => {
    let style = "";
    // #ifdef APP
    try {
      const win = uni.getWindowInfo();
      const scale = win.windowWidth / 750;
      const basePx = scale > 0 ? Math.round(24 * scale) : 24;
      style = `padding-bottom: ${basePx + win.safeAreaInsets.bottom}px;`;
    } catch (_e) {
      style = "";
    }
    // #endif
    return style;
  });

  function callPopupMethod(methodName: string): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(methodName);
  }

  /** 打开弹窗：记录目标联系人并预填现有备注。 */
  function open(userId: string, name: string, currentRemark: string): void {
    targetUserId = userId;
    contactName.value = name;
    remark.value = currentRemark;
    busy.value = false;
    // 系统 TabBar 是独立原生层，页面内弹窗无法用 z-index 覆盖，先隐藏、关闭时恢复
    tabBarHiddenBySheet.value = true;
    uni.hideTabBar({
      animation: false,
      complete: () => {
        callPopupMethod("open");
      },
    });
  }

  function close(): void {
    callPopupMethod("close");
  }

  function restoreTabBar(): void {
    if (tabBarHiddenBySheet.value != true) {
      return;
    }
    tabBarHiddenBySheet.value = false;
    uni.showTabBar({
      animation: false,
    });
  }

  /** 保存：留空 = 清除备注（契约语义），成功关弹窗并通知页面刷新。 */
  async function handleSubmit(): Promise<void> {
    if (busy.value) {
      return;
    }
    if (targetUserId.length == 0) {
      return;
    }
    busy.value = true;
    try {
      const res = await apiImContactSetRemark(targetUserId, remark.value.trim());
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Message.remarkSaved"), icon: "none" });
      emit("saved");
      close();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    } finally {
      busy.value = false;
    }
  }

  /** 弹窗完全收起：恢复 tabBar。 */
  function handleAfterLeave(): void {
    restoreTabBar();
  }

  defineExpose({
    open: open as any,
    close: close as any,
  });

  onUnmounted(() => {
    restoreTabBar();
  });
</script>

<style lang="scss" scoped>
  .remark-sheet {
    width: 100%;
    height: 100%;
    padding: 28rpx 32rpx 24rpx;
    /* #ifdef H5 || MP-WEIXIN */
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    /* #endif */
    background-color: #ffffff;
    border-radius: 32rpx 32rpx 0 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .remark-sheet__header {
    min-height: 52rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .remark-sheet__title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .remark-sheet__title {
    color: #111111;
    font-size: 32rpx;
    line-height: 44rpx;
    font-weight: 600;
  }

  /* 当前展示名（灰字括号），对齐设计稿 */
  .remark-sheet__title-name {
    color: #9a9aa2;
    font-size: 26rpx;
    line-height: 36rpx;
  }

  .remark-sheet__close {
    width: 56rpx;
    height: 56rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .remark-sheet__form {
    flex: 1;
    min-height: 0;
    margin-top: 24rpx;
    display: flex;
    flex-direction: column;
  }

  .remark-sheet__input {
    width: 100%;
    height: 88rpx;
    padding: 0 24rpx;
    border-radius: 20rpx;
    background-color: #f6f5f8;
    font-size: 28rpx;
    color: #1c1b20;
    box-sizing: border-box;
  }

  .remark-sheet__ph {
    color: #b7b7be;
    font-size: 26rpx;
  }

  .remark-sheet__footer {
    flex-shrink: 0;
    padding-top: 20rpx;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
  }

  /* 按钮风格对齐 create-group-sheet：取消=浅灰填充、确定=品牌紫，无描边 */
  .remark-sheet__btn {
    min-width: 192rpx;
    height: 88rpx;
    padding: 0 32rpx;
    border-radius: 24rpx;
    background-color: #f2f1f7;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .remark-sheet__btn-cancel--active {
    background-color: #e8e7f0;
  }

  .remark-sheet__btn--ok {
    margin-left: 24rpx;
    background-color: #5147ff;
  }

  .remark-sheet__btn-ok--active {
    background-color: #4239e8;
  }

  .remark-sheet__btn--disabled {
    opacity: 0.55;
  }

  .remark-sheet__btn-text {
    font-size: 30rpx;
    line-height: 42rpx;
    font-weight: 500;
  }

  .remark-sheet__btn-text--cancel {
    color: #4b4b52;
  }

  .remark-sheet__btn-text--ok {
    color: #ffffff;
  }
</style>
