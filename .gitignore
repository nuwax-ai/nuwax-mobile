# HBuilderX 编译、缓存、日志、基座和离线 H5 产物均不入库
# 仅保留项目约定的 H5 部署目录 unpackage/dist/build/web/
/unpackage/*
!/unpackage/dist/
/unpackage/dist/*
!/unpackage/dist/build/
/unpackage/dist/build/*
!/unpackage/dist/build/web/

# HBuilderX 本地运行配置(含本机证书绝对路径,不入库)
.hbuilderx/launch.json

# 本地自定义基座中间产物（正式交付在 unpackage/debug/，已 ignore）
/out/
scripts/__pycache__/

# 本机敏感配置（AppKey / iOS Team / Profile UUID），绝不入库
scripts/local-secrets.env

# 构建产物 / 字节码缓存 / 代码签名元数据
__pycache__/
**/_CodeSignature/

# 诊断 / 性能日志（grab-diag.sh 输出，本地分析用，不入库）
.diag/
.zcode/

# 离线 H5 安装包及原子安装中间目录；协议源码在 components/offline-h5-container/，随源码入库
/static/app/offline-h5/
/static/app/offline-h5.installing/
/static/app/offline-h5.previous/
