import { isAppInBackground } from "@/utils/appLifecycle";
import eventBus from "@/utils/eventBus";
import { IM_SESSION_CLEARED } from "@/utils/im/imSessionScope";
import { meetingMediaActiveRoom, meetingMediaResume } from "@/utils/meeting/meetingMedia";
// #ifdef APP-HARMONY
import { getApiBaseUrl, TEST_PUSH_API_ORIGIN } from "@/constants/config";
import { hasNativeVoipCall } from "@/uni_modules/nuwax-voip";
// #endif

// 只存内存：锁屏接听后等待 App 前台和页面就绪；密码不得持久化或输出日志。
let pendingURL = "";
let pendingRoom = "";
let pendingKey = "";
let completedKeys: string[] = [];
let opening = false;
let retryTimer = 0;
let generation = 0;
// #ifdef APP-HARMONY
let pendingUntil = 0;
// #endif

function clearPendingInvite(): void {
  pendingURL = ""; pendingRoom = ""; pendingKey = "";
  // #ifdef APP-HARMONY
  pendingUntil = 0;
  // #endif
  if (retryTimer != 0) { clearInterval(retryTimer); retryTimer = 0; }
}

export function clearMeetingInviteNavigation(): void {
  generation += 1;
  clearPendingInvite();
  completedKeys = [];
  opening = false;
}
eventBus.on(IM_SESSION_CLEARED, (_payload: any): void => { clearMeetingInviteNavigation(); });

function completed(): void {
  completedKeys.push(pendingKey);
  if (completedKeys.length > 32) completedKeys.shift();
  clearPendingInvite();
}

export function flushMeetingInviteNavigation(): void {
  if (pendingURL.length == 0 || opening) return;
  // #ifdef APP-HARMONY
  if (pendingUntil > 0 && Date.now() >= pendingUntil) {
    completed();
    return;
  }
  // #endif
  if (isAppInBackground()) return;
  if (getCurrentPages().length == 0) return;
  // #ifdef APP-HARMONY
  if (pendingUntil > 0) {
    try { if (hasNativeVoipCall()) return; } catch (_error) {}
  }
  // #endif
  if (meetingMediaActiveRoom() == pendingRoom) { meetingMediaResume(); completed(); return; }
  const current = generation;
  opening = true;
  uni.navigateTo({ url: pendingURL,
    success: (_res) => { if (current == generation) completed(); },
    complete: (_res) => { if (current == generation) opening = false; },
  });
}

export function openMeetingInvite(inviteId: string, room: string, title: string, media: string, passcode: string, handoffExpiresAt: number = 0): void {
  if (room.length == 0) return;
  const key = inviteId.length > 0 ? inviteId : room;
  if (key == pendingKey || completedKeys.includes(key)) return;
  // #ifdef APP-HARMONY
  // 锁屏接听后等前台导航期间，后到的接听事件不能抢占已有请求。
  if (getApiBaseUrl() == TEST_PUSH_API_ORIGIN) {
    if (opening || pendingKey.length > 0) return;
    const now = Date.now();
    if (handoffExpiresAt > 0 && handoffExpiresAt <= now) return;
    pendingUntil = handoffExpiresAt > 0 ? handoffExpiresAt : now + 60_000;
  }
  // #endif
  generation += 1;
  opening = false;
  pendingKey = key;
  pendingRoom = room;
  pendingURL = "/subpackages/pages/im-meeting/im-meeting-room?room=" + encodeURIComponent(room) +
    "&title=" + encodeURIComponent(title) + "&status=1&host=0&call=1&video=" + (media == "video" ? "1" : "0") +
    (passcode.length > 0 ? "&pc=" + encodeURIComponent(passcode) : "");
  if (retryTimer == 0) retryTimer = setInterval(() => { flushMeetingInviteNavigation(); }, 1000);
  flushMeetingInviteNavigation();
}
