// nuwax-ios-file-picker · app-ios
//
import type { IosFileFailureCallback, IosFilePickedCallback } from "../interface.uts";

// uni.chooseFile 的 iOS Swift 实现缺位（Android/鸿蒙已有），聊天页「文件」入口在
// iOS 走本插件：同目录 FilePickerBridge.swift 弹系统 UIDocumentPicker
// （文件 App，含 iCloud），asCopy=true 拷进沙盒后回传绝对路径，直接可上传。
//
// 混编约定（同 nuwax-esp-provisioning）：Swift 文件的 public 类对本文件直接可见，
// 无需 import；两个桥接回调使用无标签参数，避免 UTS 和 Swift 标签映射不兼容。

/**
 * 弹系统文件选择器（多选，与 H5 uni.chooseFile count=5 同口径）。
 * 每选中一个文件回调一次 onPicked（path=ASCII 物化绝对路径——原名含中文/空格时
 * uni.uploadFile 拼 URL 不编码必失败，须在原生层物化；name=原文件名含扩展名，
 * size=字节数供体积闸门）；用户取消走 onFail(code="cancel")，调用方静默处理
 * （与 uni.chooseFile 的 fail 同口径）。
 * @UTSJS.keepAlive 回调被原生委托持有到选择器关闭，须防回收。
 */
@UTSJS.keepAlive
export function pickIosFiles(
  onPicked: IosFilePickedCallback,
  onFail: IosFileFailureCallback,
): void {
  IosFilePickerBridge.pickFiles(onPicked, onFail);
}

/**
 * 本地文件是否存在（真实绝对路径；unifile:// 等虚拟路径恒 false，交调用方走 FSM）。
 * ★iOS 上 uni.getFileSystemManager().accessSync 失败只打 log 不抛异常（1300002），
 * 用它会得出"永远存在"的错误结论——重试已失效的沙盒临时件会一路走到 uploadFile
 * 才报 "Illegal file"。凡是 iOS 上判断真实路径，必须用本函数。
 */
export function iosLocalFileExists(path: string): boolean {
  return IosFilePickerBridge.localFileExists(path);
}

/**
 * 上传前兜底（旧失败行重试不经过选择器）：文件不存在返回空串，调用方提示重新选择；
 * 含空格/中文等不安全字符则物化为纯 ASCII 临时名后返回；否则原样返回。
 */
export function prepareIosUploadPath(path: string): string {
  return IosFilePickerBridge.prepareUploadPath(path);
}
