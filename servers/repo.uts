import request from "@/servers/useRequest";
import { RepoPageDetail, RepoShareLink } from "@/types/interfaces/repoPage";
import { RequestResponse } from "@/types/interfaces/request";

/** 指定空间的完整资料树。 */
export async function apiRepoSpaceTree(spaceId: number): Promise<RequestResponse<any>> {
  return await request({
    url: `/api/repo/spaces/${spaceId}/tree`,
    method: "GET",
  });
}

/** 资料库 ES 全库搜索；spaceId 省略时跨全部空间（对齐 PC SidebarSearchModal）。 */
export async function apiRepoSearch(
  keyword: string,
  from: number = 0,
  size: number = 20,
): Promise<RequestResponse<any>> {
  return await request({
    url: `/api/repo/search?keyword=${encodeURIComponent(keyword)}&from=${from}&size=${size}`,
    method: "GET",
  });
}

/**
 * 按短链 ID 查询资料页详情，含当前用户访问权限 myAccess。
 * @param slugId 短链 ID
 * @param shareToken 分享令牌，可选
 */
export async function apiRepoPageBySlug(
  slugId: string,
  shareToken: string = "",
): Promise<RequestResponse<RepoPageDetail>> {
  let url = `/api/repo/s/${encodeURIComponent(slugId)}`;
  if (shareToken.length > 0) {
    url = url + "?shareToken=" + encodeURIComponent(shareToken);
  }
  return await request({
    url: url,
    method: "GET",
  });
}

/**
 * 新建资料页分享链接。
 * accessType 为 login 或 public；allowComment 控制评论；permBits 为只读类权限位。
 * 未传的字段不写入请求体。allowComment、permBits 传 null 表示不设置。
 * @param pageId 资料页 ID
 * @param accessType 访问方式，空串表示不传
 * @param allowComment 是否允许评论，null 表示不传
 * @param permBits 只读类权限位，null 表示不传
 */
export async function apiRepoCreateShareLink(
  pageId: number,
  accessType: string = "",
  allowComment: number | null = null,
  permBits: number | null = null,
): Promise<RequestResponse<RepoShareLink>> {
  const body = new UTSJSONObject();
  if (accessType.length > 0) {
    body["accessType"] = accessType;
  }
  if (allowComment != null) {
    body["allowComment"] = allowComment;
  }
  if (permBits != null) {
    body["permBits"] = permBits;
  }
  return await request({
    url: `/api/repo/pages/${pageId}/shares/links`,
    method: "POST",
    data: body,
  });
}

/** 门户最近访问资料。 */
export async function apiRepoRecentlyAccessedPages(from: number = 0, size: number = 20): Promise<RequestResponse<any>> {
  return await request({
    url: `/api/repo/pages/recently-accessed?from=${from}&size=${size}`,
    method: "GET",
  });
}
