<template>
  <view class="diff-content-wrapper">
    <view class="diff-table">
      <view
        v-for="(line, index) in linesList"
        :key="index"
        :class="['diff-line', line.type]"
      >
        <!-- 行号：移动端只展示一列，删除行取旧行号，其余取新行号 -->
        <text class="line-number">{{ getDisplayLineNum(line) }}</text>
        <!-- 标志 (+ / - / 空) -->
        <text class="line-sign">{{
          line.type === "added" ? "+" : line.type === "removed" ? "-" : " "
        }}</text>
        <!-- 代码/文本内容 -->
        <text class="line-content">{{ line.content }}</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { DiffLineItem } from "../../types";
  import { computed } from "vue";

  const props = defineProps({
    diffLinesList: {
      type: Array,
      required: true,
    },
  })

  const linesList = computed(() : DiffLineItem[] => {
    return props.diffLinesList as DiffLineItem[];
  })

  const getDisplayLineNum = (line: DiffLineItem): string => {
    if (line.type === "removed") {
      return line.oldLineNum;
    }
    return line.newLineNum;
  }
</script>

<style lang="scss" scoped>
  .diff-content-wrapper {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
    width: 100%;
    background-color: #ffffff;
  }

  .diff-table {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
  }

  .diff-line {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    min-height: 40rpx;
    line-height: 40rpx;
    font-size: 24rpx;
    width: 100%;
    overflow: hidden;
  }

  /* 行号基类 */
  .line-number {
    width: 70rpx;
    text-align: right;
    padding-right: 12rpx;
    color: #8c959f;
    /* #ifdef H5 || WEB */
    user-select: none;
    /* #endif */
    font-family: monospace;
    font-size: 20rpx;
    background-color: #f6f8fa;
    border-right: 1rpx solid #d0d7de;
    flex-shrink: 0;
  }

  .line-sign {
    width: 36rpx;
    text-align: center;
    font-weight: bold;
    /* #ifdef H5 || WEB */
    user-select: none;
    /* #endif */
    font-family: monospace;
    font-size: 22rpx;
    flex-shrink: 0;
  }

  .line-content {
    padding-left: 12rpx;
    padding-right: 12rpx;
    font-family: monospace, Courier, monospace;
    white-space: pre-wrap;
    /* #ifdef H5 || WEB */
    word-break: break-all;
    overflow-wrap: anywhere;
    /* #endif */
    flex: 1;
    min-width: 0;
    font-size: 22rpx;
  }

  /*
    样式变体 —— vapor: 原 &.normal/&.added/&.removed 提为同层单类（line.type 动态挂载到 .diff-line）。
    原 .added/.removed 下对 .line-number/.line-sign/.line-content 的状态覆写依赖
    「复合+后代」选择器（.diff-line.added .line-number），vapor 不支持，已舍弃；
    行背景着色保留，子元素仍取基类默认色。恢复需给子元素加状态变体类（BEM）。
  */
  .normal {
    background-color: #ffffff;
  }

  .added {
    background-color: rgba(46, 160, 67, 0.12);
  }

  .removed {
    background-color: rgba(248, 81, 73, 0.12);
  }
</style>
