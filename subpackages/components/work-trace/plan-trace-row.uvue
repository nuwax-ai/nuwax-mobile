<template>
  <!--
    V2 待办卡（对齐 PC TodoTraceNode）：Plan 结构化任务清单专属渲染。
    头：List 图标 +「待办」+ N/M 进度 + 运行 spinner + 箭头；
    体：浅灰圆角面板三态步骤（完成=绿圈勾+删除线 / 进行中=›+主色加粗 /
    待办=空心圆 / 失败=红 ✗）。展开状态托管 ai-msg：运行中默认展开、
    结束自动收起一次、历史收起；无结构化步骤回落普通 Plan 行。
  -->
  <view class="todo-trace" v-if="steps.length > 0">
    <view class="todo-trace-toggle" @tap="onRowTap">
      <text class="iconfont todo-trace-icon">&#xe630;</text>
      <text class="todo-trace-title">{{ t("Mobile.Chat.WorkTrace.todoTitle") }}</text>
      <text class="todo-trace-progress">{{ completedCount }}/{{ steps.length }}</text>
      <view v-if="isRunning" class="todo-trace-status">
        <text class="iconfont todo-trace-spinner">&#xe628;</text>
      </view>
      <text v-else-if="isFailed" class="iconfont todo-trace-failed">&#xe60d;</text>
      <text
        class="iconfont icon-a-Chevrondown todo-caret"
        :class="{ 'todo-caret-open': expanded }"
      >&#xe647;</text>
    </view>
    <view v-if="expanded" class="todo-trace-body">
      <view
        v-for="(step, index) in steps"
        :key="index"
        class="todo-step"
        :class="todoStepClass(step.status)"
      >
        <view class="todo-step-icon-box">
          <text
            v-if="step.status == 'completed'"
            class="iconfont icon-a-Checkcircle todo-step-icon"
          >&#xe636;</text>
          <text
            v-else-if="step.status == 'in_progress'"
            class="iconfont icon-a-Chevronright todo-step-icon"
          >&#xe63f;</text>
          <text
            v-else-if="step.status == 'failed'"
            class="iconfont icon-a-Xcircle todo-step-icon"
          >&#xe60d;</text>
          <view v-else class="todo-step-circle" />
        </view>
        <text class="todo-step-text">{{ step.content }}</text>
      </view>
    </view>
  </view>
  <!-- 无结构化步骤：回落普通 Plan 行（动作词 + 计划名 + 状态） -->
  <view class="node-row-wrapper" v-else :class="{ 'is-failed': isFailed }">
    <view class="node-row" @tap="onRowTap">
      <text class="iconfont node-kind-icon" :class="{ 'is-failed-icon': isFailed }">&#xe630;</text>
      <text class="node-title">{{ actionText }}</text>
      <text v-if="planName.length > 0" class="node-summary">{{ planName }}</text>
      <view v-if="isRunning" class="node-status-icon">
        <text class="iconfont node-spinner">&#xe628;</text>
      </view>
      <text v-else-if="isFailed" class="iconfont node-failed-icon">&#xe60d;</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { useI18n, emptyI18nParams } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      /** Plan 类型工具行数据（kind = todo）。 */
      row: any;
      /** 步骤清单展开状态（托管在 ai-msg 折叠状态机：todo 运行中默认展开）。 */
      expanded?: boolean;
    }>(),
    {
      expanded: false,
    },
  );

  const emit = defineEmits<{
    toggle: [];
  }>();

  class PlanStepView {
    status: string = "";
    content: string = "";
  }

  function rowField(key: string): any | null {
    const row = props.row;
    if (row == null || typeof row != "object") return null;
    return (row as UTSJSONObject)[key];
  }

  const isRunning = computed((): boolean => `${rowField("status") ?? ""}` == "running");
  const isFailed = computed((): boolean => `${rowField("status") ?? ""}` == "failed");
  const planName = computed((): string => `${rowField("name") ?? ""}`);

  const actionText = computed((): string => {
    const status = `${rowField("status") ?? ""}`;
    if (status == "running") return t("Mobile.Chat.WorkTrace.toolActionPlanRunning");
    if (status == "failed") return t("Mobile.Chat.WorkTrace.toolActionPlanFailed");
    return t("Mobile.Chat.WorkTrace.toolActionPlanFinished");
  });

  /** Plan 步骤清单（result.data 中含 content 的项，对齐 PC readPlanSteps 契约）。 */
  const steps = computed((): PlanStepView[] => {
    const processing = rowField("processing");
    if (processing == null) return [] as PlanStepView[];
    const result = (processing as UTSJSONObject)["result"];
    if (result == null || typeof result != "object") return [] as PlanStepView[];
    const data = (result as UTSJSONObject)["data"];
    if (data == null || Array.isArray(data) != true) return [] as PlanStepView[];
    const list = data as any[];
    const withContent: PlanStepView[] = [] as PlanStepView[];
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      if (item != null && typeof item == "object") {
        const obj = item as UTSJSONObject;
        const content = obj["content"];
        if (content != null && `${content}`.length > 0) {
          const step = new PlanStepView();
          step.content = `${content}`;
          const status = obj["status"];
          step.status = status == null ? "" : `${status}`;
          withContent.push(step);
        }
      }
    }
    return withContent;
  });

  const completedCount = computed((): number => {
    const list = steps.value;
    let n = 0;
    for (let i = 0; i < list.length; i++) {
      if (list[i].status == "completed") {
        n = n + 1;
      }
    }
    return n;
  });

  function todoStepClass(status: any): string {
    const s = status == null ? "" : `${status}`;
    if (s == "completed") return "is-completed";
    if (s == "in_progress") return "is-in-progress";
    if (s == "failed") return "is-failed";
    return "";
  }

  function onRowTap(): void {
    if (steps.value.length == 0) {
      return;
    }
    emit("toggle");
  }
</script>

<style lang="scss" scoped>
  // 对齐 PC hairline 色板（与 tool-trace-row 同体系）
  $text-main: rgba(0, 0, 0, 0.88);
  $text-tertiary: rgba(5, 5, 5, 0.45);
  $text-secondary: rgba(5, 5, 5, 0.65);
  $text-quaternary: rgba(5, 5, 5, 0.25);
  $color-error: #ff4d4f;
  $color-primary: #6a5af9;
  $color-success: #52c41a;
  $panel-fill: rgba(5, 5, 5, 0.04);

  // ---- 待办卡（Plan 结构化任务清单）----
  .todo-trace {
    min-width: 0;
  }

  .todo-trace-toggle {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 16rpx;
    width: 100%;
    min-height: 60rpx;
    padding: 0;
  }

  .todo-trace-icon {
    width: 28rpx;
    flex-shrink: 0;
    font-size: 28rpx;
    color: $text-tertiary;
    line-height: 40rpx;
  }

  .todo-trace-title {
    color: $text-secondary;
    font-weight: 500;
  }

  .todo-trace-progress {
    margin-left: 4rpx;
    color: $text-tertiary;
  }

  .todo-trace-status {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32rpx;
    height: 32rpx;
  }

  .todo-trace-spinner {
    font-size: 24rpx;
    color: $color-primary;
    /* #ifndef APP */
    animation: todo-card-spin 1s linear infinite;
    /* #endif */
  }

  .todo-trace-failed {
    flex-shrink: 0;
    font-size: 24rpx;
    color: $color-error;
  }

  // 箭头：caret 单一图标 + 旋转（-90°收起 / 0°展开，对齐 PC caret_down）
  .todo-caret {
    flex-shrink: 0;
    color: $text-quaternary;
    font-size: 20rpx;
    line-height: 20rpx;
    transform: rotate(-90deg);
    transition: transform 0.18s ease, color 0.18s ease;
  }

  .todo-caret-open {
    transform: rotate(0deg);
    color: $text-secondary;
  }

  // 列表承载：浅灰圆角面板（对齐参考样式），不用引导竖线
  .todo-trace-body {
    margin: 4rpx 0 12rpx;
    padding: 12rpx 32rpx;
    background: $panel-fill;
    border-radius: 20rpx;
    display: flex;
    flex-direction: column;
  }

  .todo-step {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 20rpx;
    padding: 14rpx 0;
    font-size: 26rpx;
    line-height: 40rpx;
    color: $text-secondary;
  }

  // 状态图标定高居中盒：与 40rpx 行高文字居中对齐
  .todo-step-icon-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 28rpx;
    height: 40rpx;
    flex-shrink: 0;
  }

  .todo-step-icon {
    font-size: 28rpx;
    color: $text-quaternary;
    line-height: 40rpx;
  }

  // 待办项空心圆（对齐参考 ○）：图标集无素圈，CSS 圆环代替
  .todo-step-circle {
    width: 20rpx;
    height: 20rpx;
    border: 3rpx solid $text-quaternary;
    border-radius: 50%;
  }

  .todo-step-text {
    flex: 1;
    min-width: 0;
    word-break: break-word;
  }

  // 完成：绿圈勾 + 删除线灰字；进行中：› + 主文字加粗；失败：红 ✗
  .todo-step.is-completed .todo-step-icon {
    color: $color-success;
  }

  .todo-step.is-completed .todo-step-text {
    color: $text-tertiary;
    text-decoration: line-through;
  }

  .todo-step.is-in-progress .todo-step-icon {
    color: $text-main;
  }

  .todo-step.is-in-progress .todo-step-text {
    color: $text-main;
    font-weight: 500;
  }

  .todo-step.is-failed .todo-step-icon {
    color: $color-error;
  }

  .todo-step.is-failed .todo-step-text {
    color: $color-error;
  }

  /* #ifndef APP */
  @keyframes todo-card-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
  /* #endif */

  // ---- 回落普通 Plan 行 ----
  .node-row-wrapper {
    min-width: 0;

    &.is-failed .node-title {
      color: $color-error;
    }
  }

  .node-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14rpx;
    width: 100%;
    min-height: 60rpx;
    padding: 0;
  }

  .node-kind-icon {
    width: 28rpx;
    flex-shrink: 0;
    font-size: 28rpx;
    color: $text-tertiary;
    line-height: 40rpx;

    &.is-failed-icon {
      color: $color-error;
    }
  }

  .node-title {
    overflow: hidden;
    flex-shrink: 0;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node-summary {
    // 自然宽度：内容后紧跟状态
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    color: $text-tertiary;
    font-size: 26rpx;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node-status-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32rpx;
    height: 32rpx;
  }

  .node-spinner {
    font-size: 26rpx;
    color: $color-primary;
    /* #ifndef APP */
    animation: todo-card-spin 1s linear infinite;
    /* #endif */
  }

  .node-failed-icon {
    flex-shrink: 0;
    font-size: 26rpx;
    color: $color-error;
  }
</style>
