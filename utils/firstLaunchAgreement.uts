/**
 * 首启协议同意状态（服务协议 + 隐私政策）。
 *
 * 产品流程（对齐主流 App）：安装后首次启动不直接进登录页，先弹协议弹窗；
 * 同意才继续，不同意直接退出。同意状态跨启动持久化，之后不再打扰。
 *
 * ★与登录页的 `agreement-checkbox` 是两回事：那个是登录表单的勾选（每次登录勾一次），
 *   这里只拦冷启动的第一屏。
 */

const AGREEMENT_ACCEPTED_KEY = "app_agreement_accepted_v1";

/** 是否已在本次安装中同意过首启协议。 */
export function hasAcceptedFirstLaunchAgreement(): boolean {
  try {
    const raw = uni.getStorageSync(AGREEMENT_ACCEPTED_KEY);
    return raw != null && `${raw}` == "1";
  } catch (_e) {
    // 读失败按「未同意」处理：最多让用户多点一次，不能放过未同意的用户
    return false;
  }
}

/** 记录已同意（同意按钮点击时写，先落盘再放行）。 */
export function markFirstLaunchAgreementAccepted(): void {
  try {
    uni.setStorageSync(AGREEMENT_ACCEPTED_KEY, "1");
  } catch (_e) {
    // 落盘失败：本次仍放行，下次启动会再问一次
  }
}
