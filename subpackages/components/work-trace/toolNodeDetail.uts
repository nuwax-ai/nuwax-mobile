/**
 * V2 工具行内联详情归一化（纯函数）。
 * 移植自 PC 端 nuwax presentation-v2/toolDetail.ts + hasProcessNodeDetail(traceItems.ts)：
 * 从 ProcessingInfo.result 抽取 terminal/file-read/file-edit/search/browser/skill/todo/generic
 * 各类型的详情字段，供 tool-node-detail 内联展开渲染与 vitest 直接使用。
 */
import { normalizeFileDiffItems, type NormalizedFileDiffItem } from "@/utils/fileChangeDiff.uts";

export class ToolDetailStep {
  status: string = "";
  content: string = "";
}

export class ToolNodeDetailData {
  /** 展示类型：terminal | file-read | file-edit | search | browser | skill | todo | generic */
  kind: string = "generic";
  command: string = "";
  description: string = "";
  filePath: string = "";
  lineStart: number = -1;
  lineEnd: number = -1;
  query: string = "";
  url: string = "";
  resultTitle: string = "";
  resultSummary: string = "";
  skillContent: string = "";
  /** <0 表示未知 */
  exitCode: number = -9999;
  additions: number = 0;
  deletions: number = 0;
  isCreate: boolean = false;
  /** 终端输出 / 文件内容 / generic 结果（已剥外层 code fence） */
  output: string = "";
  /** 剔除已知字段后的输入 JSON（generic 兜底展示） */
  inputText: string = "";
  /** todo 步骤清单 */
  steps: ToolDetailStep[] = [] as ToolDetailStep[];
  diffs: NormalizedFileDiffItem[] = [] as NormalizedFileDiffItem[];
  /** 是否失败（result.success === false） */
  failed: boolean = false;
  /** 是否运行中（由行状态传入后回填，供 terminal 头状态判定） */
  running: boolean = false;
}

function asRecord(value: any | null): UTSJSONObject | null {
  if (value == null || typeof value != "object") return null;
  if (Array.isArray(value)) return null;
  return value as UTSJSONObject;
}

function readStringOf(source: UTSJSONObject | null, keys: string[]): string {
  if (source == null) return "";
  for (let i = 0; i < keys.length; i++) {
    const v = source[keys[i]];
    if (typeof v == "string" && (v as string).length > 0) {
      return v as string;
    }
  }
  return "";
}

function readNumberOf(source: UTSJSONObject | null, keys: string[]): number {
  if (source == null) return -9999;
  for (let i = 0; i < keys.length; i++) {
    const v = source[keys[i]];
    if (typeof v == "number") {
      return v as number;
    }
  }
  return -9999;
}

function dataRecords(result: UTSJSONObject | null): UTSJSONObject[] {
  const out: UTSJSONObject[] = [] as UTSJSONObject[];
  if (result == null) return out;
  const data = result["data"];
  if (data == null || Array.isArray(data) != true) return out;
  const arr = data as any[];
  for (let i = 0; i < arr.length; i++) {
    const rec = asRecord(arr[i]);
    if (rec != null) {
      out.push(rec);
    }
  }
  return out;
}

/** 只剥包住整段结果的 code fence，内部 fence 保留（对齐 PC stripOuterCodeFence）。 */
function stripOuterCodeFence(value: string): string {
  const trimmed = value.trim();
  const match = trimmed.match(/^```[^\n]*\n([\s\S]*?)\n```$/);
  return match != null && match.length > 1 ? (match[1] as string).trim() : trimmed;
}

function displayJson(value: any | null): string {
  if (value == null) return "";
  if (typeof value == "string") return value as string;
  try {
    return JSON.stringify(value, null, 2);
  } catch (_e) {
    return `${value}`;
  }
}

/** data 数组逐项取 content/output/content.text/text，无则 JSON 化；\n 拼接后剥外层 fence。 */
function readOutput(result: UTSJSONObject | null): string {
  if (result == null) return "";
  const data = result["data"];
  if (data == null) return "";
  if (Array.isArray(data) != true) {
    return stripOuterCodeFence(displayJson(data));
  }
  const arr = data as any[];
  const parts: string[] = [] as string[];
  for (let i = 0; i < arr.length; i++) {
    const item = arr[i];
    if (item == null) continue;
    if (typeof item == "string") {
      parts.push(item as string);
      continue;
    }
    const obj = asRecord(item);
    if (obj == null) {
      parts.push(displayJson(item));
      continue;
    }
    const content = obj["content"];
    if (typeof content == "string") {
      parts.push(content as string);
      continue;
    }
    if (typeof obj["output"] == "string") {
      parts.push(obj["output"] as string);
      continue;
    }
    const contentObj = asRecord(content);
    if (contentObj != null && typeof contentObj["text"] == "string") {
      parts.push(contentObj["text"] as string);
      continue;
    }
    if (typeof obj["text"] == "string") {
      parts.push(obj["text"] as string);
      continue;
    }
    parts.push(displayJson(item));
  }
  return stripOuterCodeFence(parts.filter((p) => p.length > 0).join("\n"));
}

const INPUT_DISPLAY_EXCLUDE_KEYS = [
  "command",
  "description",
  "file_path",
  "filePath",
  "filepath",
  "skill_content",
  "skillContent",
  "kind",
  "rawInput",
  "raw_input",
];

function readInputText(input: UTSJSONObject | null): string {
  if (input == null) return "";
  const filtered = new UTSJSONObject();
  try {
    const keys = Object.keys(input);
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i];
      if (INPUT_DISPLAY_EXCLUDE_KEYS.indexOf(key) < 0) {
        filtered[key] = input[key];
      }
    }
  } catch (_e) {
    return "";
  }
  const text = displayJson(filtered);
  return text == "{}" ? "" : text;
}

function countLines(value: string): number {
  if (value.length == 0) return 0;
  return value.split("\n").length;
}

/**
 * 归一化工具详情。参数为行级数据（投影层 TraceToolRow 的 kind/processing + 状态）。
 * 纯函数：任何脏数据安全降级为空字段。
 */
export function normalizeToolNodeDetail(
  kind: string,
  processing: any | null,
  rowStatus: string,
): ToolNodeDetailData {
  const detail = new ToolNodeDetailData();
  detail.kind = kind;
  detail.running = rowStatus == "running";
  const processingObj = asRecord(processing);
  const result = processingObj == null ? null : asRecord(processingObj!["result"]);
  detail.failed = result != null && result!["success"] == false;

  const input = result == null ? null : asRecord(result!["input"]);
  // rawInput / raw_input 嵌套展开（对齐 PC readResultInput）
  const nestedRaw = input == null ? null : asRecord(input!["rawInput"]);
  const effectiveInput = nestedRaw != null ? nestedRaw : input;

  detail.command = readStringOf(input, ["command"]).length > 0
    ? readStringOf(input, ["command"])
    : readStringOf(effectiveInput, ["command"]);
  detail.description = readStringOf(input, ["description"]);
  detail.filePath = readStringOf(input, ["file_path", "filePath", "filepath", "path"]);
  detail.lineStart = readNumberOf(input, ["line_start", "lineStart", "start_line"]);
  detail.lineEnd = readNumberOf(input, ["line_end", "lineEnd", "end_line"]);
  detail.query = readStringOf(input, ["query", "q", "keyword", "keywords"]);
  detail.url = readStringOf(input, ["url", "uri", "href"]);
  detail.skillContent = readStringOf(input, ["skill_content", "skillContent"]);

  // structuredResult：data 数组中首个含 title/summary/url 的项，或 data 对象本身
  const records = dataRecords(result);
  let structured: UTSJSONObject | null = null;
  if (records.length > 0) {
    for (let i = 0; i < records.length; i++) {
      const rec = records[i];
      if (
        typeof rec["title"] == "string" ||
        typeof rec["summary"] == "string" ||
        typeof rec["url"] == "string"
      ) {
        structured = rec;
        break;
      }
    }
  } else if (result != null) {
    const dataObj = asRecord(result!["data"]);
    if (dataObj != null) {
      structured = dataObj;
    }
  }
  if (detail.url.length == 0) {
    detail.url = readStringOf(structured, ["url", "uri", "href"]);
  }
  detail.resultTitle = readStringOf(structured, ["title", "name"]);
  detail.resultSummary = readStringOf(structured, ["summary", "description", "snippet"]);

  // exitCode：data 中 terminal 项优先，兜底 result 顶层
  detail.exitCode = -9999;
  for (let i = 0; i < records.length; i++) {
    const code = readNumberOf(records[i], ["exitCode", "exit_code", "code"]);
    if (code != -9999) {
      detail.exitCode = code;
      break;
    }
  }
  if (detail.exitCode == -9999) {
    detail.exitCode = readNumberOf(result, ["exitCode", "exit_code", "code"]);
  }

  // steps：data 数组中含 content:string 的项（todo 步骤）
  if (result != null) {
    const data = result!["data"];
    if (data != null && Array.isArray(data) == true) {
      const arr = data as any[];
      for (let i = 0; i < arr.length; i++) {
        const obj = asRecord(arr[i]);
        if (obj == null) continue;
        if (typeof obj["content"] == "string") {
          const step = new ToolDetailStep();
          const status = obj["status"];
          step.status = status != null ? `${status}` : "unknown";
          step.content = obj["content"] as string;
          detail.steps.push(step);
        }
      }
    }
  }

  // diffs（复用移动端 normalizeFileDiffItems：data[].type=diff / input.diff / old-new 对 / content 新建）
  try {
    detail.diffs = normalizeFileDiffItems(result);
  } catch (_e) {
    detail.diffs = [] as NormalizedFileDiffItem[];
  }
  let additions = 0;
  let deletions = 0;
  let allCreate = detail.diffs.length > 0;
  for (let i = 0; i < detail.diffs.length; i++) {
    const diff = detail.diffs[i];
    additions += countLines(diff.newText);
    deletions += countLines(diff.oldText);
    if (diff.oldText.length > 0 || diff.newText.length == 0) {
      allCreate = false;
    }
  }
  detail.additions = additions;
  detail.deletions = deletions;
  detail.isCreate = allCreate;

  detail.output = readOutput(result);
  detail.inputText = readInputText(input);
  return detail;
}

/** 是否存在可展开的有效详情；空协议节点渲染成静态行不伪装可点（对齐 PC hasProcessNodeDetail）。 */
export function hasToolNodeDetail(detail: ToolNodeDetailData): boolean {
  return (
    detail.command.length > 0 ||
    detail.description.length > 0 ||
    detail.filePath.length > 0 ||
    detail.query.length > 0 ||
    detail.url.length > 0 ||
    detail.resultTitle.length > 0 ||
    detail.resultSummary.length > 0 ||
    detail.skillContent.length > 0 ||
    detail.exitCode != -9999 ||
    detail.inputText.length > 0 ||
    detail.output.length > 0 ||
    detail.steps.length > 0 ||
    detail.diffs.length > 0
  );
}

/** diff 文本逐行加前缀（`- `/`+ `），对齐 PC 的两整块 pre 渲染形态。 */
export function prefixDiffLines(text: string, prefix: string): string {
  if (text.length == 0) return "";
  return text
    .split("\n")
    .map((line) => prefix + line)
    .join("\n");
}
