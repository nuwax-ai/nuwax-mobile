<template>
  <view class="conversation-list h-full">
    <scroll-view
      class="h-full"
      scroll-y="true"
      @scrolltolower="handleLoadMore"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      @refresherrefresh="handleRefresh"
      :show-scrollbar="false"
      :enhanced="true"
    >
      <template v-if="rowList.length > 0">
        <view class="list-wrapper">
          <view
            class="conversation-item"
            v-for="(row, index) in rowList"
            :key="row.id"
            @click="handleItemClickByIndex(index)"
            @longpress="handleLongPressByIndex(index)"
          >
            <view class="item-content">
              <view class="title-row">
                <text class="conversation-title">{{ row.topic }}</text>
                <text class="time-label">{{ row.timeLabel }}</text>
              </view>
              <view class="bottom-row">
                <text class="agent-name">{{ row.agentName }}</text>
                <view v-if="row.showExecuting" class="status-tag">
                  <text class="status-text">{{
                    t("Mobile.Conversation.executing")
                  }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </template>

      <template v-else-if="!loading && !refreshing">
        <view class="empty-state h-full">
          <image
            :src="noData"
            class="empty-image"
            :alt="t('Mobile.Common.noDataImageAlt')"
          />
          <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
        </view>
      </template>

      <template v-else-if="!refreshing">
        <view class="loading-state">
          <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
        </view>
      </template>

      <template v-if="showNoMore">
        <view class="no-more-state">
          <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
        </view>
      </template>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import {
    apiAgentConversationList,
    apiAgentConversationUpdate,
    apiAgentConversationDelete,
  } from "@/servers/conversation";
  import { ConversationListParams } from "@/types/interfaces/conversationInfo";
  import { AgentConversationUpdateParams } from "@/types/interfaces/agent";
  import { SUCCESS_CODE } from "@/constants/codes.constants.uts";
  import { formatTimeAgo } from "@/utils/common";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import noData from "@/static/assets/no_data.png";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /**
   * 模板展示行（Android：禁止 v-for ConversationInfo，运行时是 UTSJSONObject）
   */
  class ConversationRowView {
    id: number = 0;
    topic: string = "";
    timeLabel: string = "";
    agentName: string = "";
    showExecuting: boolean = false;
  }

  interface ConversationListContentProps {
    isLoggedIn: boolean;
  }

  const props = defineProps<ConversationListContentProps>();

  const emit = defineEmits<{
    (e: "conversation-click", item: any): void;
  }>();

  // 原始列表：UTSJSONObject[]，禁止 as ConversationInfo[]
  const conversationList = ref<UTSJSONObject[]>([]);
  const loading = ref<boolean>(false);
  const refreshing = ref<boolean>(false);
  const hasMore = ref<boolean>(false);
  const lastId = ref<number | null>(null);

  function toNum(v: any | null, fallback: number = 0): number {
    if (v == null) {
      return fallback;
    }
    if (typeof v == "number") {
      const n = v as number;
      return n != n ? fallback : n;
    }
    const parsed = parseFloat(`${v}`);
    return parsed != parsed ? fallback : parsed;
  }

  function toStr(v: any | null, fallback: string = ""): string {
    if (v == null) {
      return fallback;
    }
    return `${v}`;
  }

  /** 将接口 data 归一化为 UTSJSONObject[] */
  function normalizeList(raw: any | null): UTSJSONObject[] {
    const result: UTSJSONObject[] = [];
    if (raw == null) {
      return result;
    }
    let items: any[] = [];
    if (Array.isArray(raw)) {
      items = raw as any[];
    } else {
      try {
        const jsonStr = JSON.stringify(raw);
        if (jsonStr != null && jsonStr.length > 0) {
          const parsed = JSON.parse(jsonStr);
          if (Array.isArray(parsed)) {
            items = parsed as any[];
          }
        }
      } catch (_e) {
        return result;
      }
    }
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      if (item == null) {
        continue;
      }
      try {
        const jsonStr = JSON.stringify(item);
        if (jsonStr != null && jsonStr.length > 0) {
          const obj = JSON.parse(jsonStr) as UTSJSONObject | null;
          if (obj != null) {
            result.push(obj);
          }
        }
      } catch (_e2) {
        // skip
      }
    }
    return result;
  }

  const rowList = computed((): ConversationRowView[] => {
    const raw = conversationList.value;
    const result: ConversationRowView[] = [];
    if (raw == null) {
      return result;
    }
    const unnamed = t("Mobile.Conversation.unnamed");
    const unknownAgent = t("Mobile.Conversation.unknownAgent");
    for (let i = 0; i < raw.length; i++) {
      const item = raw[i];
      if (item == null) {
        continue;
      }
      const row = new ConversationRowView();
      row.id = toNum(item["id"], 0);
      const topic = toStr(item["topic"], "");
      row.topic = topic.length > 0 ? topic : unnamed;
      const modified = toStr(item["modified"], "");
      const ago = formatTimeAgo(modified);
      row.timeLabel = ago != null ? ago : "";
      const agentRaw = item["agent"];
      let agentName = "";
      if (agentRaw != null) {
        try {
          const agentStr = JSON.stringify(agentRaw);
          if (agentStr != null && agentStr.length > 0) {
            const agentObj = JSON.parse(agentStr) as UTSJSONObject | null;
            if (agentObj != null) {
              agentName = toStr(agentObj["name"], "");
            }
          }
        } catch (_e) {
          agentName = "";
        }
      }
      row.agentName = agentName.length > 0 ? agentName : unknownAgent;
      const statusStr = toStr(item["taskStatus"], "");
      row.showExecuting = statusStr == "EXECUTING";
      result.push(row);
    }
    return result;
  });

  const showNoMore = computed((): boolean => {
    const cl = conversationList.value;
    const clLen = cl != null ? cl.length : 0;
    return !loading.value && !hasMore.value && clLen > 8;
  });

  async function fetchConversationList(isLoadMore: boolean = false): Promise<void> {
    if (!props.isLoggedIn) {
      loading.value = false;
      refreshing.value = false;
      return;
    }

    try {
      const params = new ConversationListParams();
      params.agentId = null;
      params.lastId = isLoadMore ? lastId.value : null;
      params.limit = 20;

      const res = await apiAgentConversationList(params);
      loading.value = false;

      if (apiResCode(res) == SUCCESS_CODE) {
        const newList = normalizeList(apiResData<any>(res));

        if (isLoadMore) {
          const existing = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
          const combined: UTSJSONObject[] = [];
          for (let i = 0; i < existing.length; i++) {
            combined.push(existing[i]);
          }
          for (let j = 0; j < newList.length; j++) {
            combined.push(newList[j]);
          }
          conversationList.value = combined;
        } else {
          conversationList.value = newList;
        }

        if (newList.length > 0) {
          const last = newList[newList.length - 1];
          lastId.value = toNum(last["id"], 0);
          hasMore.value = newList.length >= 20;
        } else {
          hasMore.value = false;
        }
      }
    } catch (error) {
      loading.value = false;
    }
  }

  const handleRefresh = async () => {
    if (refreshing.value) {
      return;
    }
    refreshing.value = true;
    lastId.value = null;
    hasMore.value = true;
    await fetchConversationList(false);
    setTimeout(() => {
      refreshing.value = false;
    }, 500);
  };

  const handleLoadMore = () => {
    if (hasMore.value && !loading.value) {
      loading.value = true;
      fetchConversationList(true);
    }
  };

  function getItemByIndex(index: number): UTSJSONObject | null {
    const list = conversationList.value;
    if (list == null || index < 0 || index >= list.length) {
      return null;
    }
    return list[index];
  }

  const handleItemClickByIndex = (index: number) => {
    const item = getItemByIndex(index);
    if (item != null) {
      emit("conversation-click", item);
    }
  };

  async function performRenameSubmit(item: UTSJSONObject, newName: string): Promise<void> {
    if (newName.length == 0) {
      uni.showToast({
        title: t("Mobile.Components.HistoryConversationList.renameTitleEmpty"),
        icon: "none",
      });
      return;
    }
    if (newName.length > 50) {
      uni.showToast({
        title: t("Mobile.Components.HistoryConversationList.renameTitleTooLong"),
        icon: "none",
      });
      return;
    }

    try {
      const updateParams = new AgentConversationUpdateParams();
      updateParams.id = toNum(item["id"], 0);
      updateParams.topic = newName;
      const updateRes = await apiAgentConversationUpdate(updateParams);
      if (apiResCode(updateRes) == SUCCESS_CODE) {
        uni.showToast({
          title: t("Mobile.Components.HistoryConversationList.renameSuccess"),
          icon: "success",
        });
        item["topic"] = newName;
        // 触发 rowList 刷新
        const list = conversationList.value;
        conversationList.value = list != null ? list.slice(0) : ([] as UTSJSONObject[]);
      } else {
        const errorMessage = apiResMessage(updateRes);
        uni.showToast({
          title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"),
          icon: "none",
        });
      }
    } catch (error) {
      uni.showToast({
        title: t("Mobile.Common.operationFailed"),
        icon: "none",
      });
    }
  }

  async function performDeleteSubmit(item: UTSJSONObject): Promise<void> {
    try {
      const id = toNum(item["id"], 0);
      const deleteRes = await apiAgentConversationDelete(id);
      if (apiResCode(deleteRes) == SUCCESS_CODE) {
        uni.showToast({
          title: t("Mobile.Components.HistoryConversationList.deleteSuccess"),
          icon: "success",
        });
        const current = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
        const next: UTSJSONObject[] = [];
        for (let i = 0; i < current.length; i++) {
          const c = current[i];
          if (toNum(c["id"], -1) != id) {
            next.push(c);
          }
        }
        conversationList.value = next;
      } else {
        const errorMessage = apiResMessage(deleteRes);
        uni.showToast({
          title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"),
          icon: "none",
        });
      }
    } catch (error) {
      uni.showToast({
        title: t("Mobile.Common.operationFailed"),
        icon: "none",
      });
    }
  }

  function handleRename(item: UTSJSONObject): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.renameModalTitle"),
      editable: true,
      placeholderText: t("Mobile.Components.HistoryConversationList.renamePlaceholder"),
      content: toStr(item["topic"], ""),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      success: (res) => {
        if (res.confirm) {
          const rawContent = res.content;
          const newName = rawContent != null ? rawContent.trim() : "";
          performRenameSubmit(item, newName);
        }
      },
    });
  }

  function handleDelete(item: UTSJSONObject): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.deleteModalTitle"),
      content: t("Mobile.Components.HistoryConversationList.deleteModalContent"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm) {
          performDeleteSubmit(item);
        }
      },
    });
  }

  const handleLongPressByIndex = (index: number) => {
    const item = getItemByIndex(index);
    if (item == null) {
      return;
    }
    const options = [
      t("Mobile.Components.HistoryConversationList.rename"),
      t("Mobile.Components.HistoryConversationList.delete"),
    ];
    uni.showActionSheet({
      itemList: options,
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.tapIndex == 0) {
          handleRename(item);
        } else if (res.tapIndex == 1) {
          handleDelete(item);
        }
      },
    });
  };

  const loadData = async () => {
    loading.value = true;
    await fetchConversationList(false);
  };

  defineExpose({
    loadData: loadData as any,
    conversationList,
  });
</script>

<style lang="scss" scoped>
  .conversation-list {
    background: #f5f5f5;

    .list-wrapper {
      padding: 0;

      .conversation-item {
        background: #fff;
        border-bottom: 2rpx solid #f0f0f0;
        padding: 32rpx 24rpx;

        .item-content {
          .title-row {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 16rpx;

            .conversation-title {
              flex: 1;
              font-size: 30rpx;
              font-weight: 600;
              color: #333;
              line-height: 42rpx;
              margin-right: 16rpx;
              overflow: hidden;
              text-overflow: ellipsis;
              white-space: nowrap;
            }

            .time-label {
              flex-shrink: 0;
              font-size: 24rpx;
              color: #999;
              line-height: 42rpx;
            }
          }

          .bottom-row {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;

            .agent-name {
              flex: 1;
              font-size: 26rpx;
              color: #999;
              overflow: hidden;
              text-overflow: ellipsis;
              white-space: nowrap;
            }

            .status-tag {
              flex-shrink: 0;
              padding: 4rpx 0rpx;
              margin-left: 16rpx;

              .status-text {
                font-size: 22rpx;
                color: rgba(0, 0, 0, 0.45);
                line-height: 28rpx;
              }
            }
          }
        }
      }
    }
  }

  .h-full {
    height: 100%;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    .empty-image {
      width: 170rpx;
      height: 170rpx;
    }

    .empty-text {
      font-size: 28rpx;
      color: #999;
      margin-top: 32rpx;
    }
  }

  .loading-state {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;

    .loading-text {
      font-size: 28rpx;
      color: #666;
    }
  }

  .no-more-state {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40rpx;

    .no-more-text {
      font-size: 24rpx;
      color: #999;
    }
  }
</style>
