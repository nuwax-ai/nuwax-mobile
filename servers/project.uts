// ---------------------------------------------------------------------------
// 创建（对齐 PC 2026-09-10 契约）
// ---------------------------------------------------------------------------

/**
 * 创建常规项目（开始页「项目开发-常规项目」入口）。
 * 返回 id/targetId 二选一 + 创建即建的首首个会话 conversationId/agentId（契约先行，缺省由调用方降级）。
 * sandboxId 固定云电脑哨兵 -1（移动端暂只支持云电脑，弹窗里的运行环境选择是占位展示）。
 */
export async function apiNormalProjectCreate(name: string): Promise<RequestResponse<any>> {
  const body = new UTSJSONObject();
  body["name"] = name;
  body["sandboxId"] = CLOUD_SANDBOX_ID;
  const res = await request({
    url: "/api/normal-project/create",
    method: "POST",
    data: body,
  });
  return res;
}

/**
 * 创建全栈应用（开始页「项目开发-全栈项目」入口）。
 * 口径对齐 PC CreateUserApp：sandboxId=-1（全栈仅云端）、devAgentId=租户默认任务智能体
 * （defaultTaskAgentId 缺省回落 defaultAgentId，都无则不传）。
 */
export async function apiUserAppCreate(name: string, devAgentId: number): Promise<RequestResponse<any>> {
  const body = new UTSJSONObject();
  body["name"] = name;
  body["sandboxId"] = CLOUD_SANDBOX_ID;
  if (devAgentId > 0) {
    body["devAgentId"] = devAgentId;
  }
  const res = await request({
    url: "/api/userapp/create",
    method: "POST",
    data: body,
  });
  return res;
}

/**
 * 创建网页应用（开始页「项目开发-网页应用」入口，统一创建接口）。
 * 对齐 PC 首页 projectCreateStrategy：targetType=PageApp。
 */
export async function apiPageAppCreate(name: string): Promise<RequestResponse<any>> {
  const body = new UTSJSONObject();
  body["targetType"] = "PageApp";
  body["name"] = name;
  const res = await request({
    url: "/api/project/create",
    method: "POST",
    data: body,
  });
  return res;
}
