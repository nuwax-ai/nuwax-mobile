import type { UniAiMarkdownElItem } from "@/uni_modules/uni-ai-x/types.uts";
import type { MarkdownToken } from "@/uni_modules/uni-cmark/utssdk/interface.uts";

const CJK_URL_PUNCTUATION = "，。！？；：、（）［］【】《》〈〉“”‘’「」『』";

function isCjkTextCharacter(char: string): boolean {
  if (char.length == 0) {
    return false;
  }
  const codeRaw = char.charCodeAt(0);
  const code = codeRaw != null ? (codeRaw as number) : -1;
  return (
    (code >= 0x3400 && code <= 0x4dbf) ||
    (code >= 0x4e00 && code <= 0x9fff) ||
    (code >= 0xf900 && code <= 0xfaff) ||
    (code >= 0x3040 && code <= 0x30ff) ||
    (code >= 0xac00 && code <= 0xd7af)
  );
}

function hasCompleteAsciiUrlPrefix(prefix: string): boolean {
  let schemeLength = 0;
  if (prefix.startsWith("https://")) {
    schemeLength = 8;
  } else if (prefix.startsWith("http://")) {
    schemeLength = 7;
  } else {
    return false;
  }

  const remainder = prefix.substring(schemeLength);
  if (remainder.length == 0) {
    return false;
  }
  if (
    remainder.indexOf("/") >= 0 ||
    remainder.indexOf("?") >= 0 ||
    remainder.indexOf("#") >= 0
  ) {
    return true;
  }
  if (remainder == "localhost") {
    return true;
  }
  return /^[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+(?::[0-9]+)?$/.test(
    remainder,
  );
}

/** 找出裸 URL 后中文标点/正文的起点；国际化域名不会被截成协议前缀。 */
export function findCjkAutolinkBoundary(url: string): number {
  for (let i = 0; i < url.length; i++) {
    const char = url.charAt(i);
    if (CJK_URL_PUNCTUATION.indexOf(char) >= 0) {
      return i;
    }
    if (
      isCjkTextCharacter(char) &&
      hasCompleteAsciiUrlPrefix(url.substring(0, i))
    ) {
      return i;
    }
  }
  return -1;
}

/**
 * 修正 cmark-gfm 已生成的裸 URL token：保留可点击 URL，并把后续中文恢复为普通文本。
 * 显式 Markdown 链接的显示文本通常不同于 href，因此不会进入此分支。
 */
export function normalizeCjkAutolinks(items: UniAiMarkdownElItem[]): void {
  for (let itemIndex = 0; itemIndex < items.length; itemIndex++) {
    const rows = items[itemIndex].datasList;
    for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
      const row = rows[rowIndex];
      const normalized = [] as MarkdownToken[];
      let changed = false;
      for (let tokenIndex = 0; tokenIndex < row.length; tokenIndex++) {
        const token = row[tokenIndex];
        const href = token.href != null ? `${token.href}` : "";
        const text = token.text != null ? `${token.text}` : "";
        if (
          href.length > 0 &&
          href == text &&
          (href.startsWith("http://") || href.startsWith("https://"))
        ) {
          const boundary = findCjkAutolinkBoundary(href);
          if (boundary > 0) {
            const baseId =
              token.uniqueId != null ? `${token.uniqueId}` : `t${tokenIndex}`;
            token.href = href.substring(0, boundary);
            token.text = href.substring(0, boundary);
            normalized.push(token);

            const trailingToken: MarkdownToken = {
              type: "text",
              text: href.substring(boundary),
              href: "",
              className: "text",
              uniqueId: baseId + "-autolink-tail",
            };
            normalized.push(trailingToken);
            changed = true;
            continue;
          }
        }
        normalized.push(token);
      }
      if (changed) {
        rows[rowIndex] = normalized;
      }
    }
  }
}
