import App from './App.uvue'

import { createSSRApp } from 'vue'
// #ifdef H5 || WEB
import { registerOfflineH5Navigation } from '@/components/offline-h5-container/offline-h5-navigation'
// #endif
import { bootstrapI18nCache } from '@/utils/i18n'
export function createApp() {
	bootstrapI18nCache()
	const app = createSSRApp(App)
	// #ifdef H5 || WEB
	app.mixin({ mounted() {
		const instance = this as any
		if (instance.$parent == null) registerOfflineH5Navigation(instance.$router)
	} })
	// #endif
	return {
		app
	}
}
