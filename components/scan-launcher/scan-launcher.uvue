<template>
  <!--
    扫一扫结果弹层（消息页「+」气泡「扫一扫」入口配套）：
    - startScan()：拉起 uni.scanCode（App / 微信小程序；H5 无此 API，入口本身不渲染）
    - 结果四路分发（判定见 utils/scanRouter）：
      · 用户名片码（URL）→ 查联系人列表：已互为好友 → toast；否则 emit add-buddy
        由页面拉起添加伙伴弹窗并预填账号/用户名（预填搜索确认，不直接发申请）
      · 群名片码（group#{群号}[#{convId}] 标识内容）→ 第二段携带 convId 时查会话
        详情：myRole>0 已在群 → toast；否则 emit join-group 由页面拉起加入群组弹窗
        并预填群号（用户点按钮提交）
      · 其他 http(s) 链接 → 「打开链接」域名确认 → handleExternalLink（App 走独立 web-view 页）
      · 纯文本 → 「扫码结果」限高展示 + 复制（utils/clipboard 跨端写剪贴板）
    - 弹层样式对齐 confirm-modal（600rpx 白底卡片、底部分割线双按钮）；
      确认钮品牌紫（非危险操作，不用红色态）；单层 fixed 蒙层，无 fixed 嵌套
  -->
  <view v-if="visible" class="scan-modal__mask" @tap="handleMaskTap">
    <view class="scan-modal__panel" @tap.stop="handlePanelTap">
      <text class="scan-modal__title">{{ titleText }}</text>
      <view v-if="mode == 'text'" class="scan-modal__body">
        <scroll-view class="scan-modal__text-scroll" direction="vertical" :show-scrollbar="false">
          <text class="scan-modal__text">{{ textContent }}</text>
        </scroll-view>
      </view>
      <view v-else class="scan-modal__body">
        <text class="scan-modal__desc">{{ descText }}</text>
      </view>
      <view class="scan-modal__actions">
        <view class="scan-modal__btn scan-modal__btn--cancel" @tap="handleCancel">
          <text class="scan-modal__btn-text">{{ cancelText }}</text>
        </view>
        <view class="scan-modal__btn" @tap="handleConfirm">
          <text class="scan-modal__btn-text scan-modal__btn-text--primary">{{ confirmText }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiImContacts, apiImConvDetail } from "@/servers/im";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { writeClipboardText } from "@/utils/clipboard";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { handleExternalLink } from "@/utils/system";
  import { extractUrlHost, parseScanContent } from "@/utils/scanRouter";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /**
   * user / group 名片码不在本弹窗确认，交页面拉起对应 sheet：
   * - add-buddy：[预填关键字（账号/用户名，缺省回 userId）, 目标 userId]
   *   ——userId 供添加弹窗在搜索结果里自动选中本人，用户点按钮即提交
   * - join-group：预填群号
   * （字符串数组式 + 带参 emit，先例 agent-subscription-modal 的 summon）
   */
  const emit = defineEmits(["join-group", "add-buddy"]);

  const visible = ref<boolean>(false);
  /** text | url（user/group 直接拉起页面侧 sheet，不开本弹窗） */
  const mode = ref<string>("text");
  /** text：扫码原文 */
  const textContent = ref<string>("");
  /** url：目标链接与展示用 host */
  const urlTarget = ref<string>("");
  const urlHost = ref<string>("");

  const titleText = computed((): string => {
    if (mode.value == "url") {
      return t("Mobile.Scan.openUrlTitle");
    }
    return t("Mobile.Scan.textTitle");
  });

  const descText = computed((): string => {
    if (mode.value == "url") {
      const params = new Map<string, string | number>();
      params.set("host", urlHost.value);
      return translateFn("Mobile.Scan.openUrlDesc", toI18nParams(params), "");
    }
    return "";
  });

  const cancelText = computed((): string => {
    return mode.value == "text" ? t("Mobile.Scan.close") : t("Mobile.Common.cancel");
  });

  const confirmText = computed((): string => {
    if (mode.value == "url") {
      return t("Mobile.Scan.open");
    }
    return t("Mobile.Scan.copy");
  });

  /** 模板串化读字段（雪花号保精度口径，同 message.uvue readString）。 */
  function readStringField(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  /**
   * 数字字面量且 > 0（status / myRole 判定；不 parseInt——避免非数字串在
   * Kotlin 侧抛异常，直接按字面量比较，全数字且含非零位才算正）。
   */
  function isPositiveNumberLiteral(raw: any | null): boolean {
    if (raw == null) {
      return false;
    }
    const s = `${raw}`;
    if (s.length == 0) {
      return false;
    }
    let hasNonZero = false;
    for (let i = 0; i < s.length; i++) {
      const c = s.charAt(i);
      if (c < "0" || c > "9") {
        return false;
      }
      if (c != "0") {
        hasNonZero = true;
      }
    }
    return hasNonZero;
  }

  /**
   * 用户名片码：查联系人列表，已互为好友（status==1）→ toast；
   * 其余（未加 / 列表拉取失败——不挡加好友流程）→ emit add-buddy 预填拉起。
   */
  async function handleUserCard(userId: string, account: string): Promise<void> {
    uni.showLoading({ title: t("Mobile.Common.loading"), mask: true });
    try {
      const res = await apiImContacts();
      uni.hideLoading();
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        const itemsRaw = dataObj != null ? dataObj["items"] : null;
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            // status：1=已互为联系人（2/3 是待确认申请，仍可走添加弹窗）
            if (
              readStringField(items[i], "userId") == userId &&
              readStringField(items[i], "status") == "1"
            ) {
              uni.showToast({ title: t("Mobile.Message.alreadyContact"), icon: "none" });
              return;
            }
          }
        }
      }
    } catch (_e) {
      uni.hideLoading();
    }
    emit("add-buddy", account.length > 0 ? account : userId, userId);
  }

  /**
   * 群名片码：c 携带 convId 时查会话详情判「已在群」（群列表接口对 groupNo
   * 恒回 null，无法按群号反查）；myRole>0 → toast，否则/查询失败 → emit
   * join-group 预填拉起（失败不挡加群流程，提交时服务端还会兜底校验）。
   */
  async function handleGroupCard(groupNo: string, convId: string): Promise<void> {
    if (convId.length == 0) {
      emit("join-group", groupNo);
      return;
    }
    uni.showLoading({ title: t("Mobile.Common.loading"), mask: true });
    try {
      const res = await apiImConvDetail(convId);
      uni.hideLoading();
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        const myRoleRaw = dataObj != null ? dataObj["myRole"] : null;
        // myRole：1=成员 2=管理员 3=群主；字段缺失/0 都视为不在群
        if (isPositiveNumberLiteral(myRoleRaw) == true) {
          uni.showToast({ title: t("Mobile.Message.groupAlreadyMember"), icon: "none" });
          return;
        }
      }
    } catch (_e) {
      uni.hideLoading();
    }
    emit("join-group", groupNo);
  }

  /** 扫码原文 → 四路分发（user/group 拉起页面侧 sheet，url/text 开本弹层）。 */
  function routeScanResult(raw: string): void {
    const trimmed = raw.trim();
    if (trimmed.length == 0) {
      uni.showToast({ title: t("Mobile.Scan.invalid"), icon: "none" });
      return;
    }
    const route = parseScanContent(trimmed);
    if (route.kind == "user") {
      handleUserCard(route.userId, route.userAccount);
      return;
    }
    if (route.kind == "group") {
      handleGroupCard(route.groupNo, route.groupConvId);
      return;
    }
    if (route.kind == "url") {
      mode.value = "url";
      urlTarget.value = route.url;
      urlHost.value = extractUrlHost(route.url);
      visible.value = true;
      return;
    }
    mode.value = "text";
    textContent.value = trimmed;
    visible.value = true;
  }

  /** 拉起扫码（消息页「+」气泡入口，气泡关闭后调用）。 */
  function startScan(): void {
    // #ifdef APP || MP-WEIXIN
    uni.scanCode({
      onlyFromCamera: false,
      success: (res: ScanCodeSuccess) => {
        const raw = res.result != null ? res.result : "";
        routeScanResult(raw);
      },
      fail: (_res: ScanCodeFail) => {
        // 用户取消扫码，静默返回
      },
    });
    // #endif
    // #ifndef APP || MP-WEIXIN
    uni.showToast({ title: t("Mobile.Scan.unsupported"), icon: "none" });
    // #endif
  }

  function close(): void {
    visible.value = false;
  }

  function handleMaskTap(): void {
    close();
  }

  /** 阻断面板内点击冒泡到蒙层。 */
  function handlePanelTap(): void {}

  function handleCancel(): void {
    close();
  }

  /** 复制文本结果（跨端剪贴板，成功后关弹层提示已复制）。 */
  function copyTextResult(): void {
    const content = textContent.value;
    writeClipboardText(
      content,
      (): void => {
        close();
        uni.showToast({ title: t("Mobile.Scan.copied"), icon: "none" });
      },
      (): void => {
        uni.showToast({ title: t("Mobile.Scan.copyFailed"), icon: "none" });
      },
    );
  }

  function handleConfirm(): void {
    if (mode.value == "url") {
      const url = urlTarget.value;
      close();
      handleExternalLink(url);
      return;
    }
    copyTextResult();
  }

  defineExpose({
    startScan: startScan as any,
  });
</script>

<style lang="scss" scoped>
  .scan-modal__mask {
    position: fixed;
    z-index: 1000;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scan-modal__panel {
    width: 600rpx;
    box-sizing: border-box;
    background-color: #ffffff;
    border-radius: 24rpx;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .scan-modal__title {
    font-size: 32rpx;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 44rpx;
    text-align: center;
    margin-top: 44rpx;
  }

  .scan-modal__body {
    display: flex;
    flex-direction: column;
    padding: 24rpx 40rpx 40rpx;
  }

  .scan-modal__desc {
    font-size: 28rpx;
    color: #666666;
    line-height: 44rpx;
    text-align: center;
  }

  /* 文本结果：限高滚动，长内容不撑爆弹层 */
  .scan-modal__text-scroll {
    max-height: 420rpx;
  }

  .scan-modal__text {
    font-size: 28rpx;
    color: #1c1b20;
    line-height: 44rpx;
  }

  .scan-modal__actions {
    display: flex;
    flex-direction: row;
    border-top: 2rpx solid #f0f0f0;
  }

  .scan-modal__btn {
    flex: 1;
    height: 100rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scan-modal__btn--cancel {
    border-right: 2rpx solid #f0f0f0;
  }

  .scan-modal__btn-text {
    font-size: 32rpx;
    color: #1a1a1a;
  }

  /* 确认钮品牌紫（打开/复制均为普通操作，非危险态） */
  .scan-modal__btn-text--primary {
    color: #5147ff;
    font-weight: 500;
  }
</style>
