/** 当前用户对资料页的访问权限（myAccess）。 */
export class RepoAccessResult {
  viewable: boolean = false;
  editable: boolean = false;
  exportable: boolean = false;
  copyable: boolean = false;
  shareable: boolean = false;
  deletable: boolean = false;
  manageable: boolean = false;
  commentable: boolean = false;
  /** 权限来源。 */
  via: string = "";
  permBits: number = 0;
}

/**
 * 按短链查询到的资料页详情。
 * 运行时响应仍是 UTSJSONObject，本类只给字段约定。
 */
export class RepoPageDetail {
  id: number = 0;
  spaceId: number = 0;
  parentId: number = 0;
  title: string = "";
  slugId: string = "";
  position: string = "";
  pageType: string = "";
  sourceExt: string = "";
  originalFileKey: string = "";
  editorIds: number[] = [];
  editorNames: UTSJSONObject | null = null;
  editorAvatars: UTSJSONObject | null = null;
  aclEnabled: number = 0;
  contentSize: number = 0;
  attachmentSize: number = 0;
  creatorId: number = 0;
  creatorName: string = "";
  creatorAvatar: string = "";
  ownerId: number = 0;
  ownerName: string = "";
  lastEditorId: number = 0;
  editedAt: string = "";
  created: string = "";
  modified: string = "";
  myAccess: RepoAccessResult | null = null;
}

/** 新建分享链接的返回。运行时响应仍是 UTSJSONObject。 */
export class RepoShareLink {
  id: number = 0;
  pageId: number = 0;
  token: string = "";
  /** login 或 public。 */
  accessType: string = "";
  allowComment: number = 0;
  permBits: number = 0;
  createdBy: number = 0;
  created: string = "";
}
