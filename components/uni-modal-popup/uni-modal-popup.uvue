<template>
  <!--
    基于 page-container 的弹窗容器。
    支持 center / top / bottom / left / right。
    iOS：page-container 内容层常盖住原生遮罩，@clickoverlay 不触发；
    全方向用全屏透明 host 承接空白点击以关闭，left/right 的贴边也由 host flex 布局
    （H5 端 page-container 容器自定义宽度后不贴边，宽度交给面板自身）。
  -->
  <!-- #ifdef MP-WEIXIN -->
  <page-container
    v-if="visible"
    :show="visible"
    :position="resolvedPosition"
    :duration="duration"
    :z-index="zIndex"
    :overlay="resolvedOverlay"
    :round="round"
    :close-on-slide-down="resolvedCloseOnSlideDown"
    :overlay-style="overlayStyle"
    :custom-style="resolvedCustomStyle"
    @clickoverlay="onClickOverlay"
    @afterleave="onAfterLeave"
    @beforeenter="onBeforeEnter"
    @enter="onEnter"
    @afterenter="onAfterEnter"
    @beforeleave="onBeforeLeave"
    @leave="onLeave"
  >
    <view class="uni-modal-popup__host" :class="hostClassName" @tap="onClickOverlay">
      <view
        v-if="visible && useInternalSideOverlay && overlay"
        class="uni-modal-popup__side-mask"
        :style="overlayStyle"
      />
      <view
        class="uni-modal-popup__panel"
        :class="panelClassName"
        :style="panelInlineStyle"
        @tap.stop="onPanelTap"
      >
        <view class="uni-modal-popup__head" v-if="showHeader">
          <view class="uni-modal-popup__title">
            <text class="uni-modal-popup__title-text" :lines="1">{{ displayTitle }}</text>
          </view>
          <slot name="header-extra"></slot>
          <view class="uni-modal-popup__close" v-if="showCloseBtn" @tap="close">
            <svg-icon name="icon-X" />
          </view>
        </view>
        <!-- #ifdef H5 -->
        <view class="uni-modal-popup__body">
          <slot></slot>
        </view>
        <!-- #endif -->
        <!-- #ifndef H5 -->
        <scroll-view
          v-if="bodyScroll"
          class="uni-modal-popup__body uni-modal-popup__body--scroll"
          direction="vertical"
          :show-scrollbar="false"
        >
          <slot></slot>
        </scroll-view>
        <view
          v-else
          class="uni-modal-popup__body uni-modal-popup__body--static"
        >
          <slot></slot>
        </view>
        <!-- #endif -->
      </view>
    </view>
  </page-container>
  <!-- #endif -->

  <!-- #ifndef MP-WEIXIN -->
  <page-container
    v-if="renderPageContainer"
    :show="visible"
    :position="resolvedPosition"
    :duration="duration"
    :z-index="zIndex"
    :overlay="resolvedOverlay"
    :round="round"
    :close-on-slide-down="resolvedCloseOnSlideDown"
    :overlay-style="overlayStyle"
    :custom-style="resolvedCustomStyle"
    @clickoverlay="onClickOverlay"
    @afterleave="onAfterLeave"
    @beforeenter="onBeforeEnter"
    @enter="onEnter"
    @afterenter="onAfterEnter"
    @beforeleave="onBeforeLeave"
    @leave="onLeave"
  >
    <view class="uni-modal-popup__host" :class="hostClassName" @tap="onClickOverlay">
      <!-- #ifdef APP-ANDROID -->
      <!-- 蒙层触摸接管（三星 One UI）：原生遮罩对带位移的按压不合成 clickoverlay，
           且微移会触发原生下滑手势（面板/蒙层跟着微动一下弹回=闪动、不收起）。
           近透明可命中的内容层蒙层把触摸整链接走（原生层收不到，手势不启动），
           在本组件上按下并完整抬起（end/cancel 同权）即关闭，无位移判定。 -->
      <view
        v-if="visible && maskClick && useBlankTapMask"
        class="uni-modal-popup__tap-mask"
        @tap.stop="onClickOverlay"
        @touchstart="onMaskTouchStart"
        @touchend="onMaskTouchEnd"
        @touchcancel="onMaskTouchEnd"
      />
      <!-- #endif -->
      <view
        v-if="visible && useInternalSideOverlay && overlay"
        class="uni-modal-popup__side-mask"
        :style="overlayStyle"
      />
      <view
        class="uni-modal-popup__panel"
        :class="panelClassName"
        :style="panelInlineStyle"
        @tap.stop="onPanelTap"
      >
        <view class="uni-modal-popup__head" v-if="showHeader">
          <view class="uni-modal-popup__title">
            <text class="uni-modal-popup__title-text" :lines="1">{{ displayTitle }}</text>
          </view>
          <slot name="header-extra"></slot>
          <view class="uni-modal-popup__close" v-if="showCloseBtn" @tap="close">
            <svg-icon name="icon-X" />
          </view>
        </view>
        <!-- #ifdef H5 -->
        <view class="uni-modal-popup__body">
          <slot></slot>
        </view>
        <!-- #endif -->
        <!-- #ifndef H5 -->
        <scroll-view
          v-if="bodyScroll"
          class="uni-modal-popup__body uni-modal-popup__body--scroll"
          direction="vertical"
          :show-scrollbar="false"
        >
          <slot></slot>
        </scroll-view>
        <view
          v-else
          class="uni-modal-popup__body uni-modal-popup__body--static"
        >
          <slot></slot>
        </view>
        <!-- #endif -->
      </view>
    </view>
  </page-container>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ref, computed, watch, onUnmounted } from "vue";
  import { translateText } from "@/utils/i18n";
  import {
    registerPopupClose,
    unregisterPopupClose,
    registerBackInterceptionGlobals,
  } from "@/utils/popupBackRegistry";

  const props = withDefaults(
    defineProps<{
      /** 标题（支持 i18n key） */
      title?: string;
      /** 内容区宽度（center / left / right 生效），如 80% */
      width?: string;
      /** 内容区高度（top / bottom 生效），如 85% */
      height?: string;
      /** 弹出方向：center | top | bottom | left | right */
      position?: string;
      /** 是否显示遮罩 */
      overlay?: boolean;
      /** 点击遮罩是否关闭 */
      maskClick?: boolean;
      /** 是否圆角（透传 page-container round） */
      round?: boolean;
      /** 是否显示标题栏 */
      showHeader?: boolean;
      /** 是否显示关闭按钮 */
      showCloseBtn?: boolean;
      /** 动画时长 ms */
      duration?: number;
      /** 层级 */
      zIndex?: number;
      /** 遮罩自定义样式 */
      overlayStyle?: string;
      /** 左右抽屉在内容宿主内绘制遮罩，避免 iOS 原生遮罩盖住 fixed 面板 */
      internalSideOverlay?: boolean;
      /** 弹出层自定义样式（会与内置方向样式合并） */
      customStyle?: string;
      /** 底部弹出时是否支持下滑关闭 */
      closeOnSlideDown?: boolean;
      /** 兼容旧 modal-popup：底部方向时等同 closeOnSlideDown */
      enableSwipeClose?: boolean;
      /**
       * APP/小程序：内容区是否用 scroll-view 承接纵向滚动。
       * 子内容自带 scroll-view 时请设为 false，避免嵌套滚动。
       * H5 始终用 overflow:auto，不受此属性影响。
       */
      bodyScroll?: boolean;
    }>(),
    {
      title: "",
      width: "80%",
      height: "80%",
      position: "center",
      overlay: true,
      maskClick: true,
      round: true,
      showHeader: true,
      showCloseBtn: true,
      duration: 300,
      zIndex: 999,
      overlayStyle: "background-color: rgba(0, 0, 0, 0.4);",
      internalSideOverlay: false,
      customStyle: "",
      closeOnSlideDown: false,
      enableSwipeClose: false,
      bodyScroll: true,
    },
  );

  const emit = defineEmits([
    "update-visible",
    "beforeenter",
    "enter",
    "afterenter",
    "beforeleave",
    "leave",
    "afterleave",
  ]);

  const visible = ref(false);
  // Android 上初始 :show="false" 的 page-container 仍可能留下透明命中层，
  // 挡住随后打开的弹窗。首次打开时再挂载，关闭后保留节点以完成离场动画。
  const renderPageContainer = ref(true);
  // #ifdef APP-ANDROID
  renderPageContainer.value = false;
  // #endif

  /**
   * 遮罩点击时间窗门卫：open 后 400ms 内的遮罩点击一律忽略。
   * 弹窗在旧弹层点击链内同步打开时（气泡菜单切底部弹窗），同一次手势的
   * mouseup/click 尾事件可能落到刚挂载的全屏透明 host / 原生遮罩上（没有
   * 对应完整的按下-抬起），须吞掉。曾以「host 是否收到 pointerdown」判别，
   * 但 App-Android 蒙层点击由原生遮罩承接（只派发 @clickoverlay，host 收
   * 不到 touchstart），门卫把真实点击也拦死——真机表现为点弹窗外不关闭
   * （iOS 内容层盖住原生遮罩、host 全链路收事件，故正常）。改按时间窗判别。
   * （2026-10-08 起 App-Android 蒙层触摸由内容层 tap-mask 接管，见
   * useBlankTapMask；@tap 与触摸两路径共用本门卫。）
   */
  const OPEN_TAP_GUARD_MS = 400;
  let openedAtMs = 0;
  /** 蒙层触摸门闩：tap-mask 自身收到 touchstart 才置位；无起点直达的 touchend
   *  属旧点击链尾事件（气泡菜单切弹窗等场景），一律忽略（三星修复，2026-10-08）。 */
  let maskTouchStarted = false;

  const displayTitle = computed((): string => {
    return translateText(props.title);
  });

  const resolvedPosition = computed((): string => {
    const raw = props.position;
    if (
      raw == "top" ||
      raw == "bottom" ||
      raw == "left" ||
      raw == "right" ||
      raw == "center"
    ) {
      return raw;
    }
    return "center";
  });

  const isCenter = computed((): boolean => {
    return resolvedPosition.value == "center";
  });

  const isTop = computed((): boolean => {
    return resolvedPosition.value == "top";
  });

  const isBottom = computed((): boolean => {
    return resolvedPosition.value == "bottom";
  });

  const useInternalSideOverlay = computed((): boolean => {
    return props.internalSideOverlay &&
      (resolvedPosition.value == "left" || resolvedPosition.value == "right");
  });

  /**
   * center/top/bottom：用全屏 host 承接空白区点击。
   * iOS 上原生 @clickoverlay 常被内容层挡住而无法关闭。
   */
  const useTapHost = computed((): boolean => {
    return isCenter.value || isTop.value || isBottom.value || useInternalSideOverlay.value;
  });

  /**
   * center/top/bottom 的蒙层触摸由内容层近透明 tap-mask 接管（仅 APP-ANDROID 渲染）。
   * 原生遮罩承接蒙层触摸时，三星 One UI 灵敏——触下瞬间微移即被原生层判为手势：
   * 不合成点击（@clickoverlay 不派发、弹窗不收起），且微移触发下滑关闭手势，
   * 面板/蒙层跟着微动一下弹回（闪动）。tap-mask 在原生层之前把触摸接走，手势
   * 不启动；按下并完整抬起即关闭（蒙层唯一交互就是关闭，不做位移判定——位移
   * 判定正是原生层误吞的源头）。左右抽屉走 side-mask/host 路径，不在此列。
   */
  const useBlankTapMask = computed((): boolean => {
    return isCenter.value || isTop.value || isBottom.value;
  });

  const resolvedOverlay = computed((): boolean => {
    return props.overlay && !useInternalSideOverlay.value;
  });
  const resolvedCloseOnSlideDown = computed((): boolean => {
    if (props.closeOnSlideDown) {
      return true;
    }
    return props.enableSwipeClose && resolvedPosition.value == "bottom";
  });

  /**
   * page-container 保持全屏透明，由内部 host 布局面板；
   * 空白区域点击走 host @tap，不依赖原生 clickoverlay。
   * @see https://doc.dcloud.net.cn/uni-app-x/component/page-container.html
   */
  const resolvedCustomStyle = computed((): string => {
    const pos = resolvedPosition.value;
    let base = "";
    if (pos == "center" || pos == "top" || pos == "bottom" || useInternalSideOverlay.value) {
      base =
        "width: 100%; height: 100%; background-color: transparent;";
    } else {
      // 左右侧：宽度按 props.width；高度不在容器上写死（iOS 会断链），
      // 由内部面板 fixed + top/bottom 锚定自适应。
      base =
        "width: " +
        props.width +
        "; height: 100%; background-color: transparent;";
    }
    if (props.customStyle.length > 0) {
      return base + props.customStyle;
    }
    return base;
  });

  const hostPositionClass = computed((): string => {
    return "uni-modal-popup__host--" + resolvedPosition.value;
  });

  const hostClassName = computed((): string => {
    const positionClass = hostPositionClass.value;
    return visible.value
      ? positionClass
      : positionClass + " uni-modal-popup__host--inactive";
  });

  const panelPositionClass = computed((): string => {
    return "uni-modal-popup__panel--" + resolvedPosition.value;
  });

  const panelClassName = computed((): string => {
    if (useInternalSideOverlay.value) {
      return panelPositionClass.value + " uni-modal-popup__panel--internal-side";
    }
    return panelPositionClass.value;
  });

  /**
   * 面板尺寸：
   * - left/right：面板自带 props.width，贴边由 host flex 布局
   * - center：面板用 props.width，并限制 max-width
   * - top/bottom：用 height
   */
  const panelInlineStyle = computed((): string => {
    const pos = resolvedPosition.value;
    if (pos == "left" || pos == "right") {
      if (useInternalSideOverlay.value) {
        return "width: " + props.width + "; height: 100%;";
      }
      // page-container 自身已经按 props.width 定宽。Android/鸿蒙/H5 内部面板必须铺满
      // 容器，若再次使用 props.width 会二次缩窄；若同时 fixed，还会脱离抽屉容器形成
      // 一块覆盖菜单的白层。iOS 内容槽高度链会断裂，仍由 fixed 面板按视口宽度兜底。
      // #ifdef APP-IOS
      return "width: " + props.width + ";";
      // #endif
      // #ifndef APP-IOS
      return "width: 100%; height: 100%;";
      // #endif
    }
    if (pos == "center") {
      return "width: " + props.width + "; max-width: 675rpx;";
    }
    const h = props.height.length > 0 ? props.height : "80%";
    return "width: 100%; height: " + h + ";";
  });

  // UTS 不提升 const 函数：open/close 须定义在调用方之前
  const open = (): void => {
    openedAtMs = Date.now();
    // 新开重置蒙层触摸门闩：上一轮手势的残留 true 不再误放行本轮尾事件
    maskTouchStarted = false;
    renderPageContainer.value = true;
    visible.value = true;
    emit("update-visible", true);
  };

  const close = (): void => {
    if (visible.value == false) {
      return;
    }
    visible.value = false;
    // 立即同步父级；勿只等 afterleave（iOS 上可能延迟或丢失）
    emit("update-visible", false);
  };

  /**
   * App web-view 内嵌 H5：Android 返回手势先关弹窗（page-container 在 Android 不拦截返回）。
   * open 登记 / close 注销，组成「已打开弹窗」栈；全局注册幂等，所有弹窗统一生效。
   */
  registerBackInterceptionGlobals();
  let popupRegistryId: number = 0;
  watch(
    visible,
    (val: boolean) => {
      if (val == true) {
        if (popupRegistryId == 0) {
          popupRegistryId = registerPopupClose(close);
        }
      } else if (popupRegistryId != 0) {
        unregisterPopupClose(popupRegistryId);
        popupRegistryId = 0;
      }
    },
    { immediate: true },
  );
  onUnmounted(() => {
    if (popupRegistryId != 0) {
      unregisterPopupClose(popupRegistryId);
      popupRegistryId = 0;
    }
  });

  const onPanelTap = (): void => {};

  const onBeforeEnter = (): void => {
    emit("beforeenter");
  };
  const onEnter = (): void => {
    emit("enter");
  };
  const onAfterEnter = (): void => {
    emit("afterenter");
  };
  const onBeforeLeave = (): void => {
    emit("beforeleave");
  };
  const onLeave = (): void => {
    emit("leave");
  };

  const onClickOverlay = (): void => {
    // 时间窗内视为旧点击链的尾事件（无完整按下-抬起），吞掉
    if (Date.now() - openedAtMs < OPEN_TAP_GUARD_MS) {
      console.log("[UniModalPopup] overlay tap swallowed by open guard");
      return;
    }
    if (props.maskClick) {
      console.log("[UniModalPopup] overlay tap close");
      close();
    }
  };

  /** tap-mask 触摸主通道（仅 APP-ANDROID）：按下置门闩。 */
  const onMaskTouchStart = (): void => {
    maskTouchStarted = true;
  };

  /** tap-mask 抬手关闭：touchend/touchcancel 同权派发（原生下滑手势抢占触摸时
   *  抬手侧收到的是 cancel，不处理会被整个吞掉）。门闩未置位=无起点直达的尾
   *  事件，直接忽略；400ms 开启门卫与 @tap 路径共用，close 幂等不双关。 */
  const onMaskTouchEnd = (): void => {
    if (maskTouchStarted == false) {
      return;
    }
    maskTouchStarted = false;
    onClickOverlay();
  };

  const onAfterLeave = (): void => {
    visible.value = false;
    emit("afterleave");
    emit("update-visible", false);
  };

  defineExpose({
    open: open as any,
    close: close as any,
    visible,
  });
</script>

<style lang="scss" scoped>
  @import "./uni-modal-popup.scss";
</style>
