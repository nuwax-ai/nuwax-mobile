import { ref, type Ref } from "vue";

/**
 * 输入框 placeholder 轮播白纱的显隐/取色（模块级状态，不放 chat.uvue 的 setup state）。
 *
 * 为什么不放页面：chat.uvue 的渲染 lambda 捕获参数已顶到 255 上限，模板每新增一个
 * setup 顶层符号引用就多一个捕获参数，R8 转发桩超限 → Android
 * `VerifyError: Verifier rejected class GenPagesMessageChat` → 整页加载失败
 * （见 utils/chatLocateLoading.uts / utils/chatAiHint.uts 同款说明）。所以白纱抽成
 * 零绑定组件（components/chat-input-veil）挂载，显隐经模块级 ref 传递。
 *
 * 干什么：智能体会话输入框的引导占位文案每 5s 轮播一条，原生 textarea 的 hint
 * 做不了单独的 opacity 过渡，只能在文字区盖一层与 pill 同色的「白纱」——
 * 盖上=旧文案淡出、幕后换下标、揭开=新文案淡入（见 chat.uvue
 * rotateAgentGuidePromptWithFade）。
 *
 * ★跨页残留：模块级 ref 跨页实例存活，聊天页 onHide/onUnload 必须复位
 * （chat.uvue 的 stopAgentGuidePromptRotation 里统一收纱），否则下一个聊天页
 * 首帧可能先按旧值画出一整块白纱盖住输入框。
 */
export const chatInputVeilOn: Ref<boolean> = ref(false);

/** 白纱颜色：跟随输入 pill 底色（常态白 / 禁言灰底 #f2f3f5），
 *  盖在白底上是「看不见的一层」，盖在灰底上不换色就会闪白块。 */
export const chatInputVeilColor: Ref<string> = ref("#ffffff");

/** 输入框此刻是否处于禁言灰底态（页面在 composerLocked 处 watch 写入）。 */
const veilLocked: Ref<boolean> = ref(false);

/** 写入禁言灰底态（同值不触发，避免无谓重渲）；顺带换白纱取色。 */
export function setChatInputVeilLocked(locked: boolean): void {
  if (veilLocked.value == locked) return;
  veilLocked.value = locked;
  chatInputVeilColor.value = locked ? "#f2f3f5" : "#ffffff";
}

/** 盖纱。 */
export function showChatInputVeil(): void {
  if (chatInputVeilOn.value != true) {
    chatInputVeilOn.value = true;
  }
}

/** 收纱（同值不触发，避免无谓重渲）。 */
export function hideChatInputVeil(): void {
  if (chatInputVeilOn.value == true) {
    chatInputVeilOn.value = false;
  }
}
