<template>
  <drawer-popup
    ref="popupFileTreeRef"
    direction="bottom"
    height="85%"
    :title="t('Mobile.Common.workspace')"
    @update-visible="updateVisible"
  >
    <view class="file-tree" ref="fileTreeRef">
      <view class="file-tree-measure" ref="fileTreeMeasureRef"></view>
      <!-- #ifdef H5 -->
      <view class="file-tree-scroll" :style="scrollViewStyle">
      <!-- #endif -->
      <!-- #ifndef H5 -->
      <scroll-view
        class="file-tree-scroll"
        direction="vertical"
        :show-scrollbar="false"
        :style="scrollViewStyle"
      >
      <!-- #endif -->
        <view class="file-tree-wrapper" ref="fileTreeWrapperRef">
        <!-- <text class="test-long-text">噶事根深蒂固萨达噶是的gsasag工地萨嘎搜嘎十多个噶事根深蒂固萨达噶是的gsasag工地萨嘎搜嘎十多个噶事根深蒂固萨达噶是的gsasag工地萨嘎搜嘎十多个噶事根深蒂固萨达噶是的gsasag工地萨嘎搜嘎十多个噶事根深蒂固萨达噶是的gsasag工地萨嘎搜嘎十多个噶事根深蒂固萨达噶是的gsasag工地萨嘎搜嘎十多个噶事根深蒂固萨达噶是的gsasag工地萨嘎搜嘎十多个噶事根深蒂固萨达噶是的gsasag工地萨嘎搜嘎十多个噶事根深蒂固萨达噶是的gsasag工地萨嘎搜嘎十多个</text> -->

        <!-- 加载中, 刷新时，不显示加载图标 -->
        <template v-if="isLoading && !hasFiles">
          <view class="file-tree-loading">
            <image
              class="icon-loading-image"
              src="@/static/assets/icon_loading.svg"
              mode="widthFix"
              alt=""
            />
          </view>
        </template>
        <!-- 有文件时，显示文件树 -->
        <template v-else-if="hasFiles">
          <file-tree-node
            v-for="node in files"
            :key="node.id"
            :node-id="node.id"
            :node-name="node.name"
            :node-type="node.type"
            :node-is-link="node.isLink"
            :file-proxy-url="node.fileProxyUrl"
            :children="node.children"
            :level="0"
            :expanded-folders="expandedFolders"
            :selected-file-id="selectedFileId"
            @toggle-folder="handleToggleFolder"
            @select-file="handleSelectFile"
          />
        </template>
        <!-- 没有文件时，显示空状态 -->
        <template v-else>
          <view class="file-tree-empty">
            <text>{{ t("Mobile.FileTree.noFiles") }}</text>
          </view>
        </template>
        </view>
      <!-- #ifdef H5 -->
      </view>
      <!-- #endif -->
      <!-- #ifndef H5 -->
      </scroll-view>
      <!-- #endif -->
      <view
        class="download-button"
        v-if="!isLoading && hasFiles"
        :style="{
          bottom: buttonPosition.bottom + 'rpx',
          right: buttonPosition.right + 'rpx',
        }"
        @click="handleDownload"
        @touchstart.stop="handleTouchStart"
        @touchmove.stop="handleTouchMove"
        @touchend.stop="handleTouchEnd"
      >
        <text class="download-icon iconfont icon-a-Arrowdown"></text>
      </view>
    </view>
  </drawer-popup>
</template>

<script setup lang="uts">
  import { ref, computed, onMounted, nextTick, getCurrentInstance, type ComponentPublicInstance } from "vue";
  import DrawerPopup from "@/components/drawer-popup/drawer-popup.uvue";
  import type { FileNode } from "@/types/interfaces/agent";
  import FileTreeNode from "./file-tree-node.uvue";
  import { apiDownloadAllFiles } from "@/servers/agentDev";
  import { API_BASE_URL } from "@/constants/config";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { useI18n, toI18nParams, emptyI18nParams } from "@/utils/i18n";
  import { getRect } from "@/uni_modules/lime-shared/getRect";
  import { readRawField } from "@/subpackages/utils/messageInfoClass.uts";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
  // UTS: uvue 模板中调用 t() 不会自动填充可选参数，这里包一层单参版本

  // #ifdef H5 || WEB
  import { exportWholeProjectZipH5 } from "@/subpackages/utils/fileTree";
  // #endif
  // #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ
  import { downloadFileInMiniProgram } from "@/subpackages/utils/fileTree";
  // #endif

  // 文件树弹窗引用
  const popupFileTreeRef = ref<any | null>(null);
  // 文件树容器引用（下载按钮定位与拖拽边界）
  const fileTreeRef = ref<any | null>(null);
  const fileTreeMeasureRef = ref<any | null>(null);
  // 文件树内容包装器引用
  const fileTreeWrapperRef = ref<any | null>(null);
  // 已展开的文件夹ID集合 (UTS: 使用 string[] 替代 Set<string>，避免 uvue prop 不支持 Set)
  const expandedFolders = ref<string[]>([]);
  // 选中的文件ID
  const selectedFileId = ref<string>("");

  type ButtonPosition = { bottom: number; right: number }
  type DragPosition = { x: number; y: number }
  type PxSize = { width: number; height: number }
  type PxPosition = { bottom: number; right: number }
  const BUTTON_SIZE = 120;
  // 下载按钮位置（rpx，用于样式）
  const buttonPosition = ref<ButtonPosition>({
    bottom: 50,
    right: 50,
  });
  // file-tree 可视区域尺寸（px），拖拽边界以像素为准避免 rpx 换算误差
  const containerRectPx = ref<PxSize>({
    width: 375,
    height: 600,
  });

  // 拖拽相关状态
  const isDragging = ref<boolean>(false);
  const dragStartPos = ref<DragPosition>({ x: 0, y: 0 });
  const buttonStartPos = ref<ButtonPosition>({
    bottom: 50,
    right: 50,
  });
  const buttonStartPosPx = ref<PxPosition>({
    bottom: 0,
    right: 0,
  });

  const props = withDefaults(
    defineProps<{
      cId: number;
      files: FileNode[];
      isLoading: boolean;
    }>(),
    {
      cId: 0,
      files: [],
      isLoading: false,
    },
  );

  const emit = defineEmits(["update-visible"]);

  // UTS: 模板里对 files?.length 做 !/比较 会报 nullable 与 'not' 解析错误，这里用 boolean computed 规避
  const hasFiles = computed((): boolean => {
    return props.files.length > 0;
  });

  /** scroll-view 需要明确 px 高度才能在 APP/小程序内滚动 */
  const scrollViewStyle = computed((): string => {
    return `height:${containerRectPx.value.height}px;width:100%;`;
  });

  /** rpx 与 px 换算比例 */
  const getRpxRatio = (): number => {
    return uni.getSystemInfoSync().windowWidth / 750;
  };

  /** 抽屉内容区高度兜底（px） */
  const getFallbackContainerHeightPx = (): number => {
    const systemInfo = uni.getSystemInfoSync();
    const rpxRatio = getRpxRatio();
    const drawerPx = systemInfo.windowHeight * 0.85;
    const headerPx = 88 * rpxRatio;
    return Math.max(drawerPx - headerPx, 300);
  };

  /** px 转 rpx */
  const pxToRpx = (px: number): number => {
    const rpxRatio = getRpxRatio();
    return px / rpxRatio;
  };

  /** rpx 转 px */
  const rpxToPx = (rpx: number): number => {
    return rpx * getRpxRatio();
  };

  /** 将按钮位置限制在 file-tree 可视区域内 */
  const clampButtonPosition = () => {
    const bounds = containerRectPx.value;
    const buttonSizePx = rpxToPx(BUTTON_SIZE);
    const maxRightPx = Math.max(0, bounds.width - buttonSizePx);
    const maxBottomPx = Math.max(0, bounds.height - buttonSizePx);
    const rightPx = rpxToPx(buttonPosition.value.right);
    const bottomPx = rpxToPx(buttonPosition.value.bottom);
    buttonPosition.value = {
      right: pxToRpx(Math.max(0, Math.min(maxRightPx, rightPx))),
      bottom: pxToRpx(Math.max(0, Math.min(maxBottomPx, bottomPx))),
    };
  };

  /**
   * 刷新 file-tree 可视区域尺寸
   */
  const refreshContainerRect = async () => {
    const instance = getCurrentInstance();
    if (instance == null) return;
    try {
      const rect = await getRect(
        ".file-tree-measure",
        instance as ComponentPublicInstance,
      );
      if (rect != null) {
        const w = rect.width;
        const h = rect.height;
        if ((w != null ? w : 0) > 0 && (h != null ? h : 0) > 0) {
          containerRectPx.value = {
            width: w as number,
            height: h as number,
          };
          clampButtonPosition();
          return;
        }
      }
      // 测量失败时用抽屉内容区兜底
      const fallbackHeightPx = getFallbackContainerHeightPx();
      const systemInfo = uni.getSystemInfoSync();
      containerRectPx.value = {
        width: systemInfo.windowWidth,
        height: fallbackHeightPx,
      };
      clampButtonPosition();
    } catch (e) {
      console.error("获取文件树区域尺寸失败:", e);
    }
  };

  // 处理文件树弹窗可见性变化
  const updateVisible = (value: boolean) => {
    emit("update-visible", value);
    if (value == true) {
      const fallbackHeightPx = getFallbackContainerHeightPx();
      const systemInfo = uni.getSystemInfoSync();
      containerRectPx.value = {
        width: systemInfo.windowWidth,
        height: fallbackHeightPx,
      };
      nextTick(() => {
        setTimeout(() => {
          refreshContainerRect();
        }, 150);
      });
    }
  };

  // 导出项目
  const handleExportProject = async () => {
    // 检查项目ID是否有效
    if (props.cId == 0) {
      uni.showToast({
        title: t("Mobile.FileTree.invalidConversationId"),
        icon: "none",
      });
      return;
    }

    try {
      uni.showLoading({ title: t("Mobile.FileTree.preparingDownload") });

      // #ifdef H5 || WEB
      // H5 环境：使用 blob 下载
      const result = await apiDownloadAllFiles(props.cId);
      const filename = `chat-${props.cId}.zip`;
      await exportWholeProjectZipH5(
        result.data as Blob,
        result.headers,
        filename,
      );
      uni.hideLoading();
      uni.showToast({
        title: t("Mobile.FileTree.exportSuccess"),
        icon: "success",
      });
      // #endif

      // #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ
      // 小程序环境：直接使用下载地址（后端已打包成zip）
      let downloadUrl = `${API_BASE_URL}/api/computer/static/download-all-files?cId=${props.cId}`;
      const filename = `chat-${props.cId}.zip`;

      // 下载并保存zip文件，返回保存路径（函数内部已弹窗提示用户）
      const savedFilePath = await downloadFileInMiniProgram(
        downloadUrl,
        filename,
      );
      console.log("文件保存路径:", savedFilePath);
      // #endif
    } catch (error) {
      uni.hideLoading();
      // 改进错误处理，兼容不同的错误格式
      let errorMessage = t("Mobile.FileTree.exportUnknownError");
      if (error != null) {
        const errObj = error as UTSJSONObject;
        const msgVal = errObj["message"];
        if (msgVal != null) {
          errorMessage = `${msgVal}`;
        }
      }

      const errParams = new Map<string, string | number>();
      errParams.set("message", errorMessage);
      uni.showToast({
        title: tFn("Mobile.FileTree.exportFailed", toI18nParams(errParams), ""),
        icon: "none",
      });
      console.error("导出失败:", error);
    }
  };

  /**
   * 下载文件
   */
  const handleDownload = () => {
    if (isDragging.value) {
      return; // 如果正在拖拽，不触发下载
    }
    handleExportProject();
  };

  /** 解析 storage 中的按钮位置（Android 可能为 JSON 字符串） */
  const parseButtonPositionFromStorage = (raw: any | null): ButtonPosition | null => {
    if (raw == null) {
      return null;
    }
    let data: any | null = raw;
    const rawStr = `${raw}`;
    if (rawStr.length > 0 && rawStr.charAt(0) == "{") {
      try {
        data = JSON.parse(rawStr);
      } catch (_eParse) {
        return null;
      }
    }
    const bottomRaw = readRawField(data, "bottom");
    const rightRaw = readRawField(data, "right");
    if (bottomRaw == null || rightRaw == null) {
      return null;
    }
    const bottom = parseFloat(`${bottomRaw}`);
    const right = parseFloat(`${rightRaw}`);
    if (bottom != bottom || right != right) {
      return null;
    }
    return { bottom: bottom, right: right };
  };

  /**
   * 加载按钮位置
   */
  const loadButtonPosition = () => {
    try {
      const saved = uni.getStorageSync("file-tree-download-button-position");
      const pos = parseButtonPositionFromStorage(saved);
      if (pos != null) {
        buttonPosition.value = pos;
        clampButtonPosition();
      }
    } catch (e) {
      console.error("加载按钮位置失败:", e);
    }
  };

  /**
   * 保存按钮位置
   */
  const saveButtonPosition = () => {
    try {
      const cur = buttonPosition.value;
      const payload = new UTSJSONObject();
      payload["bottom"] = cur.bottom;
      payload["right"] = cur.right;
      uni.setStorageSync(
        "file-tree-download-button-position",
        JSON.stringify(payload),
      );
    } catch (e) {
      console.error("保存按钮位置失败:", e);
    }
  };

  /**
   * 触摸开始
   */
  const handleTouchStart = async (e: any) => {
    await refreshContainerRect();
    if (e == null) return;
    const eObj = e as UTSJSONObject;
    const touchesVal = eObj["touches"];
    if (touchesVal == null) {
      return;
    }
    const touches = touchesVal as UTSJSONObject[];
    if (touches.length == 0) {
      return;
    }
    const touch = touches[0];
    const touchObj = touch as UTSJSONObject;
    const cxVal = touchObj["clientX"];
    const cyVal = touchObj["clientY"];
    const cx = cxVal != null ? (cxVal as number) : 0;
    const cy = cyVal != null ? (cyVal as number) : 0;

    // 使用 clientX/clientY 获取触摸坐标
    const startPos: DragPosition = { x: cx, y: cy };
    dragStartPos.value = startPos;
    // UTS: 不可变拷贝
    const cur = buttonPosition.value;
    buttonStartPos.value = { bottom: cur.bottom, right: cur.right };
    buttonStartPosPx.value = {
      bottom: rpxToPx(cur.bottom),
      right: rpxToPx(cur.right),
    };
    isDragging.value = false;
  };

  /**
   * 触摸移动
   */
  const handleTouchMove = (e: any) => {
    if (e == null) return;
    const eObj = e as UTSJSONObject;
    const touchesVal = eObj["touches"];
    if (touchesVal == null) {
      return;
    }
    const touches = touchesVal as UTSJSONObject[];
    if (touches.length == 0) {
      return;
    }
    const touch = touches[0];
    const touchObj = touch as UTSJSONObject;
    const cxVal = touchObj["clientX"];
    const cyVal = touchObj["clientY"];
    const currentX = cxVal != null ? (cxVal as number) : 0;
    const currentY = cyVal != null ? (cyVal as number) : 0;
    const deltaX = currentX - dragStartPos.value.x;
    const deltaY = currentY - dragStartPos.value.y;

    // 如果移动距离超过10px，认为是拖拽
    const movedX = Math.abs(deltaX) > 10;
    const movedY = Math.abs(deltaY) > 10;
    if (movedX == true) {
      isDragging.value = true;
    } else if (movedY == true) {
      isDragging.value = true;
    }

    if (isDragging.value) {
      const buttonSizePx = rpxToPx(BUTTON_SIZE);
      const bounds = containerRectPx.value;

      // 全程使用 px 计算，避免 rpx 换算导致可移动范围偏小
      let newRightPx = buttonStartPosPx.value.right - deltaX;
      let newBottomPx = buttonStartPosPx.value.bottom - deltaY;

      const maxRightPx = Math.max(0, bounds.width - buttonSizePx);
      const maxBottomPx = Math.max(0, bounds.height - buttonSizePx);

      newRightPx = Math.max(0, Math.min(maxRightPx, newRightPx));
      newBottomPx = Math.max(0, Math.min(maxBottomPx, newBottomPx));

      buttonPosition.value = {
        right: pxToRpx(newRightPx),
        bottom: pxToRpx(newBottomPx),
      };
    }
  };

  /**
   * 触摸结束
   */
  const handleTouchEnd = () => {
    if (isDragging.value) {
      saveButtonPosition();
    }
    isDragging.value = false;
  };

  // 组件挂载时加载位置
  onMounted(() => {
    const fallbackHeightPx = getFallbackContainerHeightPx();
    const systemInfo = uni.getSystemInfoSync();
    containerRectPx.value = {
      width: systemInfo.windowWidth,
      height: fallbackHeightPx,
    };
    loadButtonPosition();
    nextTick(() => {
      refreshContainerRect();
    });
  });

  /**
   * 切换文件夹展开/收起
   */
  const handleToggleFolder = (folderId: string) => {
    const idx = expandedFolders.value.indexOf(folderId);
    if (idx >= 0) {
      // 已存在：移除（收起）。UTS: 不可变更新，重建数组
      const next: string[] = [];
      for (let i = 0; i < expandedFolders.value.length; i++) {
        if (i != idx) {
          next.push(expandedFolders.value[i]);
        }
      }
      expandedFolders.value = next;
    } else {
      // 不存在：添加（展开）
      const next2 = expandedFolders.value.slice();
      next2.push(folderId);
      expandedFolders.value = next2;
    }
  };

  /**
   * 选择文件
   */
  const handleSelectFile = (
    fileId: string,
    isLink: boolean,
    fileProxyUrl: string,
  ) => {
    selectedFileId.value = fileId;
    if (isLink == true) {
      uni.showToast({
        title: t("Mobile.FileTree.linkFileNotSupported"),
        icon: "none",
      });
      return;
    }

    uni.navigateTo({
      url:
        "/subpackages/pages/file-preview-page/file-preview-page?cId=" +
        props.cId +
        "&fileProxyUrl=" +
        encodeURIComponent(fileProxyUrl),
    });
  };

  /** Android：Gen* 组件 ref 禁止 as UTSJSONObject，用 $callMethod 调 drawer-popup */
  const callDrawerPopupMethod = (methodName: string): void => {
    const refVal = popupFileTreeRef.value as any | null;
    if (refVal == null) {
      return;
    }
    try {
      const proxy = refVal as ComponentPublicInstance;
      proxy.$callMethod(methodName);
    } catch (_e) {
      // ignore
    }
  };

  // 打开文件树弹窗
  const open = () => {
    const fallbackHeightPx = getFallbackContainerHeightPx();
    const systemInfo = uni.getSystemInfoSync();
    containerRectPx.value = {
      width: systemInfo.windowWidth,
      height: fallbackHeightPx,
    };
    callDrawerPopupMethod("open");
    nextTick(() => {
      setTimeout(() => {
        refreshContainerRect();
      }, 100);
    });
  };

  // 关闭文件树弹窗
  const close = () => {
    callDrawerPopupMethod("close");
  };

  // 暴露文件树弹窗引用
  defineExpose({
    open: open as any,
    close: close as any,
  });
</script>

<style scoped lang="scss">
  .file-tree {
    position: relative;
    flex: 1;
    height: 100%;
    width: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;

    .file-tree-scroll {
      flex-shrink: 0;
      width: 100%;
      /* #ifdef H5 */
      overflow-y: auto;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      /* #endif */
    }

    .file-tree-measure {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      pointer-events: none;
    }

    .download-button {
      position: absolute;
      width: 120rpx;
      height: 120rpx;
      background-color: rgba(0, 0, 0, 0.6);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 999;
      box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
      transition: background-color 0.2s;
      /* #ifndef APP */
      touch-action: none;
      /* #endif */

      &:active {
        background-color: rgba(0, 0, 0, 0.8);
      }

      .download-icon {
        font-size: 48rpx;
        color: #fff;
        line-height: 1;
      }
    }

    .file-tree-wrapper {
      /* #ifdef H5 */
      display: inline-block;
      width: max-content;
      min-width: 100%;
      /* #endif */
      /* #ifndef H5 */
      display: flex;
      flex-direction: column;
      width: 100%;
      min-width: 750rpx;
      /* #endif */
      padding-bottom: 20rpx;
    }

    .test-long-text {
      white-space: nowrap;
    }

    .file-tree-loading {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 400rpx;

      .icon-loading-image {
        width: 48rpx;
        height: 48rpx;
        margin-right: 10rpx;
        /* #ifndef APP */
        -webkit-touch-callout: none !important;
        -webkit-user-select: none !important;
        user-select: none !important;
        /* #endif */
      }
    }

    .file-tree-empty {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 400rpx;
      font-size: 28rpx;
      color: #999;
    }
  }
</style>
