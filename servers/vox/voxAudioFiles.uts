import request from "@/servers/useRequest";
import { getVoxBaseUrl } from "@/constants/config";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { apiResCode, apiResData } from "@/utils/apiResponse";
import type { RequestResponse } from "@/types/interfaces/request";

/** 新接口优先；旧网关尚未部署 audio-files（路由 404）时临时兼容整段录音。 */
export async function requestVoxAudioFiles(
  resource: string, id: number, page: number, pageSize: number,
): Promise<RequestResponse<any>> {
  const baseUrl = getVoxBaseUrl();
  const recordPath = `/api/app/${resource}/${id}`;
  const filesPath = `${recordPath}/audio-files`;
  const res = (await request({
    url: `${filesPath}?page=${page}&pageSize=${pageSize}`,
    method: "GET", baseUrl: baseUrl, suppressNotFoundToast: true,
  })) as UTSJSONObject;
  // 空列表、鉴权失败和业务错误均以新接口为准，不能误回退到旧录音。
  if (apiResCode(res) != null || `${res["status"] ?? ""}` != "404" || `${res["path"] ?? ""}` != filesPath) {
    return res;
  }

  const items = [] as UTSJSONObject[];
  if (page == 1) {
    const legacy = (await request({ url: `${recordPath}/audio-url`, method: "GET", baseUrl: baseUrl })) as UTSJSONObject;
    if (apiResCode(legacy) != SUCCESS_CODE) return legacy;
    const raw = apiResData<any>(legacy);
    const audio = raw != null ? (raw as UTSJSONObject) : null;
    const url = audio != null && audio["url"] != null ? `${audio["url"]}` : "";
    if (url != "") {
      // 旧地址响应不含时长，播放器沿用已加载的详情 / 原生音频时长。
      const item = new UTSJSONObject();
      item["segmentIndex"] = 0;
      item["audioUrl"] = url;
      item["durationMs"] = 0;
      item["audioBytes"] = 0;
      items.push(item);
    }
  }
  const data = new UTSJSONObject();
  data["items"] = items;
  data["total"] = page == 1 ? items.length : 1;
  data["page"] = page;
  data["pageSize"] = pageSize;
  const result = new UTSJSONObject();
  result["code"] = SUCCESS_CODE;
  result["data"] = data;
  return result;
}
