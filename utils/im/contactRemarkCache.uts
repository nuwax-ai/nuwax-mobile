import { getImSessionStamp } from "./imSessionScope";
/**
 * 联系人备注索引（userId → remark）模块级缓存（App 进程内，页面销毁不丢）。
 *
 * 用途：按「备注优先」覆写各处展示名——① 聊天页群聊消息行发送者昵称（senderName
 * 是发送那一刻的昵称快照，不含我方备注）；② 群详情头像条 / 群成员列表页成员名
 * （成员接口只有 群卡片 nickName + 平台昵称 name，无备注）。★只收录设了备注的
 * 联系人（remark 非空）：无备注的 displayName=昵称 会盖过群名片，破坏
 * 「备注 > 群卡片 > 昵称」的优先级，故存纯备注而非服务端合成的 displayName。
 *
 * 写入口三处（任一刷新后其他页面读到的即是新值）：消息页联系人整表刷新
 * （rebuildContactNameIndex，消息 tab 每次 onShow 必刷）、聊天页自身拉取
 * （loadContactRemarks）、资料页 resolvePeer（改备注后立即保鲜）。消费方在
 * 各自重算展示名的时机同步读取（群页 onShow 整表重拉 / 聊天页 tick 重渲）。
 *
 * 失效：随 IM 会话戳（token/origin/epoch 变化即换账号或登出）自动清空，
 * 与 myInfoCache 同款机制——不会串账号。
 */

let cached: Map<string, string> | null = null;
let cacheSession = "";

function ensureCacheSession(): void {
  if (cacheSession != getImSessionStamp()) {
    cached = null;
    cacheSession = getImSessionStamp();
  }
}

/** 整表写入（空表不写——拉取失败/都无备注保持旧值）。 */
export function setCachedContactRemarks(remarks: Map<string, string>): void {
  ensureCacheSession();
  if (remarks.size == 0) {
    return;
  }
  cached = remarks;
}

/** 取缓存；未缓存或已失效返回 null（返回共享引用；聊天页改备注事件的原位
 *  set/delete 会同步保鲜缓存，属预期——整表替换仍是唯一全量写入路径，勿 clear）。 */
export function getCachedContactRemarks(): Map<string, string> | null {
  ensureCacheSession();
  return cached;
}
