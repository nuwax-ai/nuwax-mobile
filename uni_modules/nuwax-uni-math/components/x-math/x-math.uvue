<template>
  <!-- #ifdef APP-IOS -->
  <!-- iOS：SVG 位图路径不可行（UIImage 不解码任何 SVG，已实测），改用 iosMath 原生矢量视图
       （<x-native-math> → MTMathUILabel / CoreText，不过 SVG/不过 UIImage）。iOS 直接原生渲染，
       不经 MathRendererCore。Android/H5/MP 继续走下方 katex-el 后端（Android SVG 位图正常）。 -->
  <x-native-math
    :latex="latex"
    :display-mode="displayModeForNative"
    :font-size="fontSizeForNative"
    :color="colorForNative"
  />
  <!-- #endif -->
  <!-- #ifndef APP-IOS -->
  <!--
    x-math：跨平台 LaTeX 渲染外观组件（Android SVG 位图 / H5/MP KaTeX）。
    自包含 —— 传 latex 即渲染（缓存命中秒回；否则经 MathRendererCore 去重/并发/截图）。
    显示层复用 katex-el（H5: v-html 真 DOM；Android: <image> SVG 位图 + 占位）。
  -->
  <katex-el
    :html="html"
    :href="href"
    :width="width"
    :height="height"
    :inline="inlineResolved"
    :preserve-size="preserveSizeResolved"
    @longpress="onLongPress"
  />
  <!-- #endif -->
</template>

<script lang="uts" setup>
import { computed, onMounted, ref, watch } from "vue"
import mathRendererCore from "@/uni_modules/nuwax-uni-math/sdk/mathRendererCore.uts"
import type { MathRenderResult } from "@/uni_modules/nuwax-uni-math/sdk/mathRenderer.uts"

const props = defineProps<{
  /** LaTeX 源码（不含 $ / $$ 定界符） */
  latex: string
  /** true=块级公式（display），false/缺省=行内 */
  displayMode?: boolean
  /** 显式指定行内（覆盖 displayMode 推断；表格单元格等场景用） */
  inline?: boolean
  /** 保持截图原尺寸不缩字号（表格内由外层横滚，不压扁公式） */
  preserveSize?: boolean
  /** 预留：字号（Phase2 native 后端生效，proxy 后端沿用 KaTeX 默认） */
  fontSize?: number
  /** 预留：颜色（同上） */
  color?: string
}>()

const html = ref("")
const href = ref("")
const width = ref(0)
const height = ref(0)
/** 原生后端产出的 SVG（供导出/复制；proxy 后端为空） */
const svg = ref("")

const inlineResolved = computed((): boolean => {
  if (props.inline != null) {
    return props.inline!
  }
  return props.displayMode != true
})

const preserveSizeResolved = computed((): boolean => {
  return props.preserveSize == true
})

// #ifdef APP-IOS
/** iOS native-view（<x-native-math> / iosMath MTMathUILabel）props 映射。
 *  iOS 不走 SVG 位图后端（UIImage 不解码 SVG），直接原生矢量渲染，不经 MathRendererCore，
 *  故下方 doRender/watch/onMounted 在 iOS 上不执行（见 #ifndef APP-IOS 守卫）。 */
const displayModeForNative = computed((): boolean => {
  // x-math 的 inline/displayMode 语义 → native-view 的 display(bool)：块级=true
  return !inlineResolved.value
})
const fontSizeForNative = computed((): number => {
  return props.fontSize ?? 0
})
const colorForNative = computed((): number => {
  // x-math color 是 "#RRGGBB" 字符串，native-view 要 ARGB int(0xAARRGGBB，-1=iosMath 库默认)。
  // 现状 SVG 后端固定近黑 #1A1A1A，这里 -1（iosMath 默认黑）与之对齐；需精确色再做 hex→int。
  return -1
})
// #endif

function applyResult(res: MathRenderResult): void {
  html.value = res.html
  href.value = res.href
  width.value = res.width
  height.value = res.height
  svg.value = res.svg
}

function clearResult(): void {
  html.value = ""
  href.value = ""
  width.value = 0
  height.value = 0
  svg.value = ""
}

/** 长按导出：优先复制原生 SVG（矢量、可缩放、可二次渲染）；无 SVG 时回退复制 LaTeX 源码。 */
function onLongPress(): void {
  const payload = svg.value.length > 0 ? svg.value : props.latex
  if (payload.length == 0) {
    return
  }
  uni.setClipboardData({
    data: payload,
    success: (): void => {
      uni.showToast({
        title: svg.value.length > 0 ? "SVG 已复制" : "LaTeX 已复制",
        icon: "none",
      })
    },
  })
}

function doRender(): void {
  const latex = props.latex
  if (latex.length == 0) {
    clearResult()
    return
  }
  const dm = props.displayMode == true
  mathRendererCore.render(latex, dm, (res: MathRenderResult): void => {
    applyResult(res)
  })
}

// #ifndef APP-IOS
// iOS 走 <x-native-math> 原生视图，不经 MathRendererCore；以下渲染调用仅 Android/H5/MP 执行
watch((): string => props.latex, (): void => {
  doRender()
})
watch((): boolean => props.displayMode == true, (): void => {
  doRender()
})
onMounted((): void => {
  doRender()
})
// #endif
</script>
