import { getApiBaseUrl } from "@/constants/config";
import { callFailure, callErrorTranslationKey, isIncomingPresentationError } from "@/features/voip/callErrors";
import { ref } from "vue";
import { CallStateStore, CallSnapshot, parseCallSnapshot } from "./callState";
import { VoipHistoryRecord, parseVoipHistory } from "./callHistory";
// #ifdef APP-ANDROID || APP-IOS
import { voipChatEndTranslationKey } from "./callHistory";
// #endif
// #ifdef APP-ANDROID
import { VoipChatTerminal, addVoipChatTerminal, readVoipChatTerminals } from "./callHistory";
// #endif
import { apiCallCapabilities, apiCreateCall, apiCallSnapshot, voipSessionConfig, readVoipDevSession, setVoipDevSession, cancelCreatedVoipCall } from "@/servers/voip";
import { apiImWhoami } from "@/servers/im";
import { apiImMeetingInviteHandled } from "@/servers/imMeeting";
import { apiResData } from "@/utils/apiResponse";
import { generateUUID } from "@/utils/common";
import { getImSessionStamp } from "@/utils/im/imSessionScope";
import { hasAppPrivacyConsent } from "@/utils/appPrivacyConsent";
import { isAppInBackground } from "@/utils/appLifecycle";
import { openMeetingInvite, clearMeetingInviteNavigation, flushMeetingInviteNavigation } from "@/utils/meeting/meetingInviteNavigation";
import { executeVoip, drainVoipEvents, ensureVoipPermissions, openVoipAppSettings } from "@/uni_modules/nuwax-voip";
// #ifdef APP-IOS
import { revokeVoipPushBeforeLogout } from "@/uni_modules/nuwax-voip";
// #endif
// #ifdef APP-ANDROID
import { isVoipReleaseOrigin } from "@/uni_modules/nuwax-voip";
// #endif
import { claimVoipAudio, releaseVoipAudio } from "./audioFocus";
import { stopAllSpeechPlayback } from "@/utils/voice/stopAllSpeechPlayback";
import { t } from "@/utils/i18n";

export const voipRevision = ref<number>(0);
export const voipError = ref<string>("");
export const voipMicrophone = ref<boolean>(true);
export const voipCamera = ref<boolean>(false);
export const voipRemoteVideo = ref<boolean>(false);
export const voipCameraSwitching = ref<boolean>(false);
export const voipSpeaker = ref<boolean>(false);
export const voipAudioRoutePending = ref<boolean>(false);
export const voipAudioInterrupted = ref<boolean>(false);
export const voipPermissionPending = ref<boolean>(false);
/** 系统来电 UI 正在负责响铃时，应用内通话页不得重复播放提示音。 */
export const voipNativeIncomingUI = ref<boolean>(false);
export const voipSystemRingingOnly = ref<boolean>(false);
export const voipAudioRoutes = ref<UTSJSONObject[]>([]);
export const voipAudioRoute = ref<string>("");
export const voipHistory = ref<VoipHistoryRecord[]>([]);
// #ifdef APP-ANDROID || APP-IOS
const chatHistoryImStamp = ref<string>("");
// #endif
// #ifdef APP-ANDROID
const chatTerminals = ref<VoipChatTerminal[]>([]);
let chatHistoryStorageKey = "";
// #endif
/** Registration/sender declaration only; never evidence that a device received a VoIP push. */
export const voipPushRegistration = ref<UTSJSONObject>({ provider: "", state: "unknown", serverReady: false } as UTSJSONObject);
const store = new CallStateStore();
let userId = "", deviceId = "", sessionStamp = "", nativeScope = "", sessionApiBase = "";
let timer = 0, creating = false, routeOpening = false;
let bootstrapSerial = 0, createSerial = 0;
let answeringCallId = "";
let pendingIncomingPageId = "";
let requestedIncomingPageId = "";
// #ifdef APP-IOS
let voipLogoutStamp = "";
let voipLogoutRevocation: Promise<boolean> | null = null;
// #endif

/** 开发联调只记录阶段；不输出账号、会话、平台 token 或 RTC 凭据。 */
function traceCall(stage: string): void {
  if (process.env.NODE_ENV == "development") console.log("[VoipCall] " + stage);
}

/** QA gates are deliberately false until the device matrix in the acceptance record is passed. */
export function isVoipPlatformAccepted(): boolean {
  return false;
}

/** Android/iOS 使用同一套业务通话；实际服务地址来自当前登录环境。 */
export function isVoipBusinessEnabled(): boolean {
  // #ifdef APP-ANDROID
  return isVoipReleaseOrigin(getApiBaseUrl());
  // #endif
  let supported = false;
  // #ifdef APP-IOS
  supported = true;
  // #endif
  return supported && getApiBaseUrl().startsWith("https://");
}

function send(command: UTSJSONObject): void {
  command["scope"] = nativeScope;
  const op = `${command["op"] ?? ""}`;
  if (op == "action" || op == "microphone" || op == "camera" || op == "speaker" || op == "audioRoute" || op == "switchCamera") command["callId"] = store.current?.callId ?? "";
  executeVoip(JSON.stringify(command));
}

export function getVoipSnapshot(): CallSnapshot | null { return store.current; }
export function getVoipChatEndKey(convId: string, callId: string): string {
  // #ifdef APP-ANDROID || APP-IOS
  const stamp = chatHistoryImStamp.value;
  if (stamp.length == 0 || stamp != getImSessionStamp()) return "";
  // #endif
  // #ifdef APP-ANDROID
  const row = chatTerminals.value.find((entry: VoipChatTerminal): boolean => entry.convId == convId && entry.callId == callId);
  if (row != null) return voipChatEndTranslationKey(row.reason);
  // #endif
  // #ifdef APP-IOS
  const row = voipHistory.value.find((entry: VoipHistoryRecord): boolean => entry.convId == convId && entry.callId == callId && entry.endedAt > 0);
  if (row != null) return voipChatEndTranslationKey(row.reason);
  // #endif
  return "";
}

// #ifdef APP-ANDROID
function rememberVoipChatTerminal(call: CallSnapshot, reason: string): void {
  if (chatHistoryStorageKey.length == 0 || chatHistoryImStamp.value != getImSessionStamp()) return;
  const records = addVoipChatTerminal(chatTerminals.value, call.callId, call.convId, reason);
  if (records == null) return;
  chatTerminals.value = records;
  try { uni.setStorageSync(chatHistoryStorageKey, JSON.stringify(records)); }
  catch (_e) { /* Keep the observation visible for this app session. */ }
}
// #endif

export function getVoipPhase(): string { return store.phase(userId); }
export function getVoipConnectedAt(): number { return store.activeStartedAt; }
export function isVoipBusy(): boolean { return store.isBusy() || creating; }
export function getVoipPeerName(): string {
  const s = store.current;
  if (s == null) return "";
  return s.callerId == userId ? s.calleeDisplayName : s.callerDisplayName;
}
export function getVoipPeerAvatar(): string {
  const s = store.current;
  if (s == null) return "";
  return s.callerId == userId ? s.calleeAvatar : s.callerAvatar;
}
function occupyAudio(): void { claimVoipAudio(); stopAllSpeechPlayback(); }

export function openVoipPage(): void {
  if (voipSystemRingingOnly.value && !voipPermissionPending.value && voipError.value != "CALL_PERMISSION_REQUIRED") return;
  // #ifdef APP-HARMONY
  const active = store.current;
  if (active != null && (active.state == "connecting" || active.state == "active")) { showNativeVoipMedia(); return; }
  // #endif
  if (routeOpening) return;
  const pages = getCurrentPages();
  if (pages.length > 0 && pages[pages.length - 1].route == "subpackages/pages/voip-call/voip-call") return;
  routeOpening = true;
  uni.navigateTo({ url: "/subpackages/pages/voip-call/voip-call", complete: () => { routeOpening = false; } });
}

export function restoreVoipCall(): void {
  const call = store.current;
  if (call == null || call.state == "ended" ||
      (call.state == "ringing" && call.expiresAt <= Date.now())) return;
  // #ifdef APP-ANDROID
  if (call.calleeId == userId) {
    send({ op: "restoreCall", callId: call.callId } as UTSJSONObject);
    return;
  }
  // #endif
  openVoipPage();
}

function openPendingIncomingPage(): void {
  if (pendingIncomingPageId.length == 0) return;
  const call = store.current;
  if (call == null || call.callId != pendingIncomingPageId || call.state == "ended" ||
      (call.state == "ringing" && call.expiresAt <= Date.now())) {
    pendingIncomingPageId = "";
    return;
  }
  if (isAppInBackground() || routeOpening || getCurrentPages().length == 0) return;
  pendingIncomingPageId = "";
  traceCall("opening incoming call page");
  openVoipPage();
}

function consumeNative(): void {
  try {
    const events = JSON.parse(drainVoipEvents()) as UTSJSONObject[];
    for (let i = 0; i < events.length; i++) {
      const event = events[i];
      if (`${event["scope"] ?? ""}` != nativeScope || nativeScope.length == 0) continue;
      const type = `${event["type"] ?? ""}`;
      if (type == "pushRegistration") {
        // Device registration is session-level and normally arrives before any call exists.
        const state = `${event["state"] ?? ""}`;
        if (!["registering", "registered", "unavailable", "configurationMissing", "stopped"].includes(state)) continue;
        voipPushRegistration.value = { provider: `${event["provider"] ?? ""}`, state: state,
          serverReady: state == "registered" && event["nativePush"] === true } as UTSJSONObject;
      } else if (type == "history") {
        voipHistory.value = parseVoipHistory(event["records"] as UTSJSONObject[]);
      } else if (type == "snapshot") {
        const raw = event["snapshot"] as UTSJSONObject;
        const next = parseCallSnapshot(raw);
        const firstSnapshot = store.current?.callId != next.callId;
        if (!store.apply(next, store.epoch, userId, Date.now(), deviceId)) continue;
        voipNativeIncomingUI.value = event["nativeIncomingUI"] === true;
        if (firstSnapshot) { voipMicrophone.value = true; voipCamera.value = next.mediaType == "video"; voipError.value = ""; resetCallControls(); }
        voipSystemRingingOnly.value = next.state == "ringing" && event["systemRingingOnly"] === true;
        if (next.state != "ended") {
          if (next.state == "connecting") voipCamera.value = next.mediaType == "video";
          occupyAudio();
          if (next.calleeId == userId) {
            if (event["foregroundIncomingPage"] === true) {
              // The system may defer the App page until answer. Request it once per call.
              if (requestedIncomingPageId != next.callId) {
                requestedIncomingPageId = next.callId;
                pendingIncomingPageId = next.callId;
              }
            } else if (next.state == "ringing" && !voipNativeIncomingUI.value && !isAppInBackground()) openVoipPage();
          }
        } else {
          // #ifdef APP-ANDROID
          rememberVoipChatTerminal(next, next.reason);
          // #endif
          voipNativeIncomingUI.value = false; resetCallControls(); releaseVoipAudio();
        }
        if (next.calleeId == userId && next.acceptedDeviceId.length > 0 && next.acceptedDeviceId != deviceId) {
          store.endLocal("answeredElsewhere", Date.now()); releaseVoipAudio();
        }
      } else if (type == "meetingInvite") {
        // 会议来电：原生只负责熄屏响铃/来电卡片，接听后由这里打开会议页；
        // 忽略/超时回写 meeting-invite-handled，其余端收起邀请。
        const action = `${event["action"] ?? ""}`;
        const inviteId = `${event["inviteId"] ?? ""}`;
        const room = `${event["roomName"] ?? ""}`;
        const title = `${event["title"] ?? ""}`;
        const media = `${event["mediaType"] ?? "audio"}`;
        const convId = `${event["convId"] ?? ""}`;
        const msgId = `${event["msgId"] ?? ""}`;
        if (action == "accept" && room.length > 0) {
          if (convId.length > 0 && msgId.length > 0 && inviteId.length > 0) {
            apiImMeetingInviteHandled(convId, msgId, inviteId, room, true);
          }
          openMeetingInvite(inviteId, room, title, media, `${event["passcode"] ?? ""}`);
        } else if ((action == "reject" || action == "timeout") && convId.length > 0 && msgId.length > 0 && inviteId.length > 0) {
          apiImMeetingInviteHandled(convId, msgId, inviteId, room, false);
        }
        continue;
      } else if (type == "error") {
        const code = `${event["code"] ?? "CALL_SERVICE_UNAVAILABLE"}`;
        const eventId = `${event["callId"] ?? ""}`;
        // Session errors have no callId. A filtered new incoming call has not
        // been published as a snapshot, and may follow an already-ended call.
        if (eventId.length > 0 && eventId != store.current?.callId && (store.isBusy() || !isIncomingPresentationError(code))) continue;
        voipError.value = code;
        if (isIncomingPresentationError(code) && !isAppInBackground()) uni.showToast({ title: t(callErrorTranslationKey(code)), icon: "none" });
        traceCall("native error " + voipError.value);
      } else if (type == "localEnded") {
        traceCall("native call ended");
        if (store.current != null && `${event["callId"] ?? ""}` != store.current?.callId) continue;
        const reason = `${event["reason"] ?? "failed"}`;
        // #ifdef APP-ANDROID
        const call = store.current;
        if (call != null && call.state != "ended") rememberVoipChatTerminal(call, reason);
        // #endif
        store.endLocal(reason, Date.now());
        resetCallControls();
        releaseVoipAudio();
      } else if (type == "openPage") {
        if (store.isBusy() && !isAppInBackground()) openVoipPage();
      } else if (type == "minimize") {
        const pages = getCurrentPages();
        if (pages.length > 1 && pages[pages.length - 1].route == "subpackages/pages/voip-call/voip-call") uni.navigateBack();
      } else {
        const current = store.current;
        if (current == null || `${event["callId"] ?? ""}` != current.callId || current.state == "ended") continue;
        if (type == "connected") { store.mediaConnected = true; store.reconnecting = false; }
        if (type == "peerMediaReady") store.peerMediaReady = true;
        if (type == "reconnecting") store.reconnecting = true;
        if (type == "microphone") voipMicrophone.value = event["enabled"] === true;
        if (type == "camera") voipCamera.value = event["enabled"] === true;
        if (type == "remoteVideo") voipRemoteVideo.value = event["enabled"] === true;
        if (type == "cameraSwitching") voipCameraSwitching.value = event["enabled"] === true;
        if (type == "speaker") voipSpeaker.value = event["enabled"] === true;
        if (type == "audioRoutePending") voipAudioRoutePending.value = event["enabled"] === true;
        if (type == "audioInterrupted") voipAudioInterrupted.value = event["enabled"] === true;
        if (type == "audioRoutes") { voipAudioRoutes.value = event["routes"] as UTSJSONObject[]; voipAudioRoute.value = `${event["selected"] ?? ""}`; }
        if (type == "permissionPending") voipPermissionPending.value = true;
        if (type == "connected") voipPermissionPending.value = false;
      }
      store.syncActiveClock(Date.now());
      voipRevision.value += 1;
    }
    openPendingIncomingPage();
  } catch (_e) { /* Native event decoding cannot break App/IM initialization. */ }
}

function resetCallControls(): void {
  voipSystemRingingOnly.value = false;
  voipRemoteVideo.value = false;
  voipCameraSwitching.value = false;
  voipAudioRoutePending.value = false;
  voipAudioInterrupted.value = false; voipPermissionPending.value = false;
  voipAudioRoutes.value = []; voipAudioRoute.value = "";
}

// #ifdef APP-IOS
export async function prepareIosVoipLogout(): Promise<void> {
  const stamp = getImSessionStamp();
  try {
    if (voipLogoutStamp != stamp) {
      voipLogoutStamp = stamp;
      bootstrapSerial += 1; createSerial += 1;
      voipLogoutRevocation = revokeVoipPushBeforeLogout();
    }
    const pending = voipLogoutRevocation;
    if (pending != null) await pending;
  } catch (_error) { /* 离线或使用旧基座时继续完成本地退出。 */ }
}
// #endif

export function clearVoipSession(): void {
  // #ifdef APP-IOS
  voipLogoutStamp = ""; voipLogoutRevocation = null;
  // #endif
  clearMeetingInviteNavigation();
  bootstrapSerial += 1; createSerial += 1;
  setVoipDevSession(null);
  try { send({ op: "reset" } as UTSJSONObject); } catch (_e) { /* Older bases must still be able to log out. */ }
  if (timer != 0) { clearInterval(timer); timer = 0; }
  store.reset(); creating = false; answeringCallId = ""; userId = ""; deviceId = ""; sessionStamp = ""; nativeScope = ""; sessionApiBase = "";
  pendingIncomingPageId = "";
  requestedIncomingPageId = "";
  voipError.value = ""; voipRevision.value += 1;
  voipNativeIncomingUI.value = false;
  resetCallControls(); voipHistory.value = [];
  // #ifdef APP-ANDROID || APP-IOS
  chatHistoryImStamp.value = "";
  // #endif
  // #ifdef APP-ANDROID
  chatHistoryStorageKey = "";
  chatTerminals.value = [];
  // #endif
  resetPushRegistration();
  releaseVoipAudio();
}

function resetPushRegistration(): void {
  voipPushRegistration.value = { provider: "", state: "unknown", serverReady: false } as UTSJSONObject;
}

export async function bootstrapVoip(): Promise<void> {
  if (!hasAppPrivacyConsent()) return;
  const dev = readVoipDevSession();
  if (!isVoipBusinessEnabled() && !isVoipPlatformAccepted() && dev == null) return;
  const stamp = getImSessionStamp();
  // #ifdef APP-IOS
  if (voipLogoutStamp == stamp) return;
  // #endif
  const serial = bootstrapSerial;
  const config = voipSessionConfig();
  let uid = `${config["userId"] ?? ""}`;
  if (uid.length == 0) {
    const response = await apiImWhoami();
    const data = apiResData<UTSJSONObject>(response);
    if (data == null || stamp != getImSessionStamp() || serial != bootstrapSerial) return;
    uid = `${(data as UTSJSONObject)["userId"] ?? ""}`;
  }
  if (uid.length == 0 || stamp != getImSessionStamp() || serial != bootstrapSerial) return;
  const currentScope = `${stamp}|${config["apiBaseUrl"]}|${uid}|${config["accessToken"]}`;
  if (sessionStamp == currentScope) return;
  // Do not reset the native singleton here: it may already own a cold-start system call.
  if (timer != 0) { clearInterval(timer); timer = 0; }
  const sameIdentity = userId == uid && deviceId == `${config["deviceId"]}` && sessionApiBase == `${config["apiBaseUrl"]}`;
  if (!sameIdentity) {
    // #ifdef APP-ANDROID || APP-IOS
    chatHistoryImStamp.value = "";
    // #endif
    if (userId.length > 0) clearMeetingInviteNavigation();
    store.reset(); pendingIncomingPageId = ""; requestedIncomingPageId = ""; resetCallControls(); voipHistory.value = []; releaseVoipAudio();
  }
  sessionStamp = currentScope; userId = uid; deviceId = `${config["deviceId"]}`;
  sessionApiBase = `${config["apiBaseUrl"]}`;
  nativeScope = generateUUID();
  resetPushRegistration();
  config["userId"] = userId; config["op"] = "initialize";
  config["qaAccepted"] = isVoipPlatformAccepted();
  config["businessEnabled"] = isVoipBusinessEnabled();
  config["background"] = isAppInBackground();
  config["callLabel"] = t("Mobile.Voip.title");
  config["incomingNotificationLabel"] = t("Mobile.Voip.notificationIncoming");
  config["ongoingNotificationLabel"] = t("Mobile.Voip.notificationOngoing");
  const labels = new UTSJSONObject();
  const labelKeys = ["meetingInvitation", "meetingNumber", "meetingInvitedBy", "meetingJoin", "meetingIgnore", "meetingJoining", "meetingMinimize", "title", "audio", "video", "minimize", "mute", "unmute", "speaker", "earpiece", "cameraOff", "cameraOn", "switchCamera", "hangup", "connecting", "reconnecting", "ended", "incoming", "dialing", "answerAudio", "answerVideo", "reject", "permissionRequired", "permissionForeground", "testListenerTitle", "testListenerNotification", "testListenerStop"];
  for (let i = 0; i < labelKeys.length; i++) labels[labelKeys[i]] = t("Mobile.Voip." + labelKeys[i]);
  // 原生展示时才知道邀请人；保留占位符，避免 t 的空参数插值提前抹去姓名。
  const inviterParams = new Map<string, string | number>();
  inviterParams.set("name", "{name}");
  labels["meetingInvitedBy"] = t("Mobile.Voip.meetingInvitedBy", inviterParams as Record<string, string | number>);
  config["labels"] = labels;
  try {
    send(config);
  } catch (error) {
    // 初始化失败不能留下“已经初始化”的会话戳，否则下次回前台也不会重试。
    sessionStamp = "";
    // #ifdef APP-ANDROID || APP-IOS
    chatHistoryImStamp.value = "";
    // #endif
    voipError.value = "CALL_SYSTEM_UNAVAILABLE";
    throw error;
  }
  // #ifdef APP-ANDROID || APP-IOS
  const historyStamp = dev == null && `${config["accessToken"] ?? ""}`.length > 0 ? stamp : "";
  // #endif
  // #ifdef APP-ANDROID
  // Android reports the terminal event but has no native history store. Keep only the status for the chat row.
  const historyKey = historyStamp.length > 0 ? `NUWAX_VOIP_CHAT_V1:${encodeURIComponent(sessionApiBase)}:${encodeURIComponent(uid)}` : "";
  if (chatHistoryStorageKey != historyKey) {
    chatHistoryStorageKey = historyKey;
    chatTerminals.value = historyKey.length > 0 ? readVoipChatTerminals(historyKey) : [];
  }
  // #endif
  // #ifdef APP-ANDROID || APP-IOS
  chatHistoryImStamp.value = historyStamp;
  // #endif
  timer = setInterval((): void => { consumeNative(); }, 100);
}

export async function voipCapabilities(convId: string): Promise<UTSJSONObject> {
  const disabled = { enabled: false, audio: false, video: false } as UTSJSONObject;
  if ((!isVoipBusinessEnabled() && !isVoipPlatformAccepted() && readVoipDevSession() == null) || !hasAppPrivacyConsent()) return disabled;
  try { return await apiCallCapabilities(convId); } catch (_e) { return disabled; }
}

export async function startVoipCall(convId: string, mediaType: string): Promise<void> {
  traceCall("dial tapped");
  if (creating) { traceCall("dial already pending"); return; }
  if (store.isBusy()) { openVoipPage(); return; }
  const operation = ++createSerial;
  creating = true; voipError.value = "";
  try {
    traceCall("session initializing");
    await bootstrapVoip();
    traceCall(nativeScope.length > 0 ? "session ready" : "session unavailable");
    if (store.isBusy()) { openVoipPage(); return; }
    const epoch = store.epoch;
    const config = voipSessionConfig();
    traceCall("capabilities checking");
    const caps = await voipCapabilities(convId);
    traceCall("capabilities received");
    if (epoch != store.epoch || operation != createSerial || nativeScope.length == 0) return;
    if (store.isBusy()) { openVoipPage(); return; }
    if (caps["enabled"] !== true || caps[mediaType] !== true) throw callFailure("CALL_MEDIA_UNSUPPORTED");
    occupyAudio();
    traceCall("permissions checking");
    if (!await ensureVoipPermissions(mediaType)) throw callFailure("CALL_PERMISSION_REQUIRED");
    traceCall("permissions granted");
    if (epoch != store.epoch || operation != createSerial || nativeScope.length == 0) return;
    if (store.isBusy()) { openVoipPage(); return; }
    traceCall("room creating");
    const raw = await apiCreateCall(convId, mediaType, generateUUID());
    traceCall("room created");
    if (epoch != store.epoch || operation != createSerial) { cancelCreatedVoipCall(config, `${raw["callId"] ?? ""}`); return; }
    const snapshot = parseCallSnapshot(raw);
    if (!store.apply(snapshot, epoch, userId, Date.now(), deviceId)) { traceCall("snapshot rejected"); cancelCreatedVoipCall(config, snapshot.callId); return; }
    resetCallControls(); voipMicrophone.value = true; voipCamera.value = mediaType == "video"; voipSpeaker.value = mediaType == "video";
    send({ op: "watch", snapshot: raw } as UTSJSONObject);
    traceCall("native call dispatched");
    voipRevision.value += 1; openVoipPage();
  } catch (error) {
    traceCall("dial failed");
    if (operation != createSerial) return;
    const code = error instanceof Error ? error.message : "CALL_START_FAILED";
    voipError.value = code;
    if (code == "CALL_PERMISSION_REQUIRED") {
      uni.showModal({ title: t("Mobile.Voip.permissionRequired"), content: t("Mobile.Voip.permissionSettings"), confirmText: t("Mobile.Voip.openSettings"), success: (result) => { if (result.confirm) openVoipAppSettings(); } });
      return;
    }
    const text = code == "CALL_BUSY" ? t("Mobile.Voip.busy") : code == "CALL_PERMISSION_REQUIRED" ? t("Mobile.Voip.permissionRequired") : t("Mobile.Voip.startFailed");
    uni.showToast({ title: text, icon: "none" });
  } finally { traceCall("dial preparation finished"); if (operation == createSerial) { creating = false; if (!store.isBusy()) releaseVoipAudio(); } }
}

export async function answerVoipCall(mediaType: string): Promise<void> {
  const epoch = store.epoch;
  const current = store.current;
  if (current == null || current.state != "ringing" || current.calleeId != userId || answeringCallId == current.callId) return;
  if (mediaType != "audio" && mediaType != "video") return;
  if (mediaType == "video" && current.mediaType != "video") return;
  answeringCallId = current.callId;
  try {
    occupyAudio();
    const permitted = await ensureVoipPermissions(mediaType);
    if (epoch != store.epoch || store.current?.callId != current.callId || store.current?.state != "ringing") return;
    if (!permitted) { voipError.value = "CALL_PERMISSION_REQUIRED"; return; }
    send({ op: "action", action: "accept", answerMediaType: mediaType, callId: current.callId } as UTSJSONObject);
  } finally { if (epoch == store.epoch && answeringCallId == current.callId) answeringCallId = ""; }
}

/** Ordinary app-push adapter (including iOS 15); a push only initiates an authoritative query. */
export async function handleVoipInvitation(callId: string, clicked: boolean, convId: string = "", msgId: string = "",
    expiresAt: number = 0, calleeId: string = ""): Promise<void> {
  if ((callId.length == 0 && (convId.length == 0 || msgId.length == 0)) || !hasAppPrivacyConsent() || (!isVoipBusinessEnabled() && !isVoipPlatformAccepted() && readVoipDevSession() == null)) return;
  if (!Number.isInteger(expiresAt) || (expiresAt != 0 && expiresAt <= Date.now())) return;
  const stamp = getImSessionStamp();
  const serial = bootstrapSerial;
  try {
    await bootstrapVoip(); const epoch = store.epoch;
    if (stamp != getImSessionStamp() || serial != bootstrapSerial || nativeScope.length == 0 ||
        (calleeId.length > 0 && calleeId != userId) ||
        (expiresAt > 0 && expiresAt <= Date.now())) return;
    if (readVoipDevSession() == null) {
      if (convId.length == 0 || msgId.length == 0) return;
      send({ op: "invitation", callId, convId, msgId, expiresAt } as UTSJSONObject);
      return;
    }
    const raw = await apiCallSnapshot(callId);
    if (stamp != getImSessionStamp() || serial != bootstrapSerial || epoch != store.epoch ||
        (expiresAt > 0 && expiresAt <= Date.now())) return;
    const snapshot = parseCallSnapshot(raw);
    if (snapshot.state == "ended" || (snapshot.state == "ringing" && snapshot.expiresAt <= Date.now())) return;
    send({ op: "watch", snapshot: raw } as UTSJSONObject);
    if (clicked && !isAppInBackground()) openVoipPage();
  } catch (_e) { /* Never turn a failed/stale invitation into a new call. */ }
}

export function endVoipCall(): void {
  const current = store.current;
  if (current == null || current.state == "ended") return;
  let action = "end";
  if (current.state == "ringing") action = current.callerId == userId ? "cancel" : "reject";
  send({ op: "action", action, callId: current.callId } as UTSJSONObject);
}

export function setVoipMicrophone(enabled: boolean): void { send({ op: "microphone", enabled } as UTSJSONObject); }
export function setVoipCamera(enabled: boolean): void { send({ op: "camera", enabled } as UTSJSONObject); }
export function setVoipSpeaker(enabled: boolean): void { send({ op: "speaker", enabled } as UTSJSONObject); }
export function switchVoipCamera(): void { send({ op: "switchCamera" } as UTSJSONObject); }
export function setVoipBackground(hidden: boolean): void {
  if (!hidden) flushMeetingInviteNavigation();
  try {
    send({ op: "background", hidden } as UTSJSONObject);
  } catch (_e) {
    // 原生插件异常不能打断 App.onHide 后续的角标清理、轮询停止和 IM 退后台。
    voipError.value = "CALL_SYSTEM_UNAVAILABLE";
    console.error("[VoipCall] native background notification unavailable");
  }
}
// #ifdef APP-ANDROID || APP-IOS
export function setVoipCallPageVisible(callId: string, visible: boolean): void {
  send({ op: "callPageVisibility", callId, visible } as UTSJSONObject);
}
// #endif
export function setVoipDevelopmentListener(enabled: boolean): void { send({ op: "developmentListener", enabled } as UTSJSONObject); }
export function showNativeVoipMedia(): void { send({ op: "showMedia" } as UTSJSONObject); }

export function setVoipAudioRoute(route: string): void { send({ op: "audioRoute", route } as UTSJSONObject); }
export async function refreshVoipHistory(): Promise<void> { await bootstrapVoip(); send({ op: "history" } as UTSJSONObject); }
export function clearVoipHistory(): void { send({ op: "clearHistory" } as UTSJSONObject); }
export function openVoipHistory(): void { uni.navigateTo({ url: "/subpackages/pages/voip-history/voip-history" }); }
