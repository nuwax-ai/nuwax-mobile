<template>
  <!-- 保留订阅组件完成离场动画和支付回调，不随 / 快捷列表卸载。 -->
  <agent-subscription-modal
    v-if="modalMounted"
    ref="modalRef"
    :target-id="targetId"
    target-type="Skill"
    :is-need-subscription="true"
    @update-visible="handleVisibleChange"
    @purchase-success="handlePurchaseSuccess"
  />
</template>

<script setup lang="uts">
  import { nextTick, onUnmounted, ref, type ComponentPublicInstance } from "vue";
  import AgentSubscriptionModal from "@/subpackages/pages/chat-conversation-component/components/agent-subscription-modal/agent-subscription-modal.uvue";
  import { apiPublishedSkillDetail } from "@/servers/skill";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiResCode, apiResData } from "@/utils/apiResponse";

  const emit = defineEmits<{
    (e: "select", item: UTSJSONObject): void;
  }>();
  const modalRef = ref<any | null>(null);
  const modalMounted = ref<boolean>(false);
  const targetId = ref<number>(0);
  const pendingItem = ref<UTSJSONObject | null>(null);
  let busy: boolean = false;
  let requestId: number = 0;
  let closeTimer: number | null = null;

  function clearCloseTimer(): void {
    const timer = closeTimer;
    if (timer != null) clearTimeout(timer);
    closeTimer = null;
  }

  function callModal(method: string): void {
    const modal = modalRef.value;
    if (modal != null) (modal as ComponentPublicInstance).$callMethod(method);
  }

  function handleVisibleChange(visible: boolean): void {
    if (visible || closeTimer != null) return;
    requestId += 1;
    // uni-modal-popup 默认离场动画 300ms，结束前吞掉连续点击。
    closeTimer = setTimeout((): void => {
      closeTimer = null;
      busy = false;
    }, 350);
  }

  function handlePurchaseSuccess(): void {
    const item = pendingItem.value;
    if (item == null) return;
    pendingItem.value = null;
    item["subscribed"] = true;
    callModal("close");
    emit("select", item);
  }

  async function open(item: UTSJSONObject): Promise<void> {
    const rawId = item["targetId"];
    const id = rawId != null ? parseInt(`${rawId}`) : 0;
    if (busy || !(id > 0)) return;
    busy = true;
    const currentRequest = requestId + 1;
    requestId = currentRequest;
    pendingItem.value = item;
    targetId.value = id;
    let detail: UTSJSONObject | null = null;
    try {
      const res = await apiPublishedSkillDetail(id);
      const raw = apiResCode(res) == SUCCESS_CODE ? apiResData<any>(res) : null;
      if (raw != null) detail = raw as UTSJSONObject;
    } catch (_error) {
      // 详情复核失败仍显示付费门，不直接插入技能。
    }
    if (currentRequest != requestId) return;
    if (detail != null && (detail["paymentRequired"] != true || detail["subscribed"] == true)) {
      item["paymentRequired"] = detail["paymentRequired"] == true;
      item["subscribed"] = detail["subscribed"] == true;
      pendingItem.value = null;
      busy = false;
      emit("select", item);
      return;
    }
    modalMounted.value = true;
    await nextTick();
    if (currentRequest != requestId) return;
    if (modalRef.value == null) {
      pendingItem.value = null;
      busy = false;
      return;
    }
    uni.hideKeyboard();
    callModal("open");
  }

  function close(): void {
    requestId += 1;
    callModal("close");
    if (closeTimer == null) {
      pendingItem.value = null;
      busy = false;
    }
  }

  onUnmounted((): void => {
    requestId += 1;
    clearCloseTimer();
  });

  defineExpose({ open: open as any, close: close as any });
</script>
