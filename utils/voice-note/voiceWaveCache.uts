/**
 * 录音面板卸掉后仍保留当前这一次的音波柱高。
 * 回到面板时接着画。离开面板或退到后台时不再采样，这里只存已经画出的柱子。
 */

let savedSessionId = "";
let savedHeights: number[] = [];

/**
 * 读出这一次录音已经画出的柱高。不是这一次则返回空数组。
 * @param sessionId 录音本地 id
 */
export function readVoiceWave(sessionId: string): number[] {
  if (sessionId.length == 0 || sessionId != savedSessionId) {
    return [];
  }
  const copy: number[] = [];
  for (let i = 0; i < savedHeights.length; i++) {
    copy.push(savedHeights[i]);
  }
  return copy;
}

/**
 * 记下这一次录音当前的柱高。
 * @param sessionId 录音本地 id
 * @param heights 从旧到新的柱高
 */
export function writeVoiceWave(sessionId: string, heights: number[]): void {
  if (sessionId.length == 0) {
    return;
  }
  savedSessionId = sessionId;
  savedHeights = [];
  for (let i = 0; i < heights.length; i++) {
    savedHeights.push(heights[i]);
  }
}

/** 这次录音结束或放弃后清掉音波。 */
export function clearVoiceWave(): void {
  savedSessionId = "";
  savedHeights = [];
}
