import { getImSessionStamp } from "@/utils/im/imSessionScope";
import { isAppInBackground } from "@/utils/appLifecycle";
import { ref, type Ref } from "vue";
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { EVENT_TYPE } from "@/constants/event.constants";
import { apiImUnreadTotal } from "@/servers/im";
import { apiResCode, apiResData } from "@/utils/apiResponse";
import eventBus from "@/utils/eventBus";

/** 「消息」Tab 序号（各平台均为 1；iOS 不显示应用 Tab）。 */
const MESSAGE_TAB_INDEX = 1;

/** 角标链路诊断日志（排查 tabBar 未读不实时；2026-09-28 定位为免打扰减除口径，已对齐飞书，置 false 降噪）。 */
const IM_UNREAD_DEBUG = false;

function imUnreadLog(msg: string): void {
  if (IM_UNREAD_DEBUG) {
    console.log(`[IMUnread] ${msg}`);
  }
}

/** IM 未读数响应式变量（角标数字 = total + dndTotal，对齐飞书口径），供 TabBar 徽标与消息页同步渲染。 */
export const imUnreadCount: Ref<number> = ref<number>(0);

/** TabBar 页面路由（与 pages.json tabBar.list 保持一致；imNoticeBar 横幅 gate 复用）。 */
export function isTabBarRoute(route: string): boolean {
  return (
    route == "pages/index/index" ||
    route == "pages/message/message" ||
    route == "pages/expert-list/expert-list" ||
    // #ifndef APP-IOS
    route == "pages/app-dev/app-dev" ||
    // #endif
    route == "pages/mine/mine"
  );
}

/**
 * TabBar API 要求当前栈顶为 Tab 页，且 TabBar 已挂载。
 * errCode 100 = TabBar 不存在（非 Tab 页 / 启动过早都会触发）。
 */
function canUpdateTabBarBadge(): boolean {
  const pages = getCurrentPages();
  if (pages.length == 0) {
    imUnreadLog("skip: 页面栈为空");
    return false;
  }
  // UTS：Page 实例勿 as any，否则访问 .route 会报「找不到名称 route」
  const currentPage = pages[pages.length - 1];
  if (currentPage == null) {
    return false;
  }
  const route = `${currentPage.route}`;
  if (!isTabBarRoute(route)) {
    imUnreadLog(`skip: 栈顶 ${route} 非 tab 页（聊天页/二级页期间不刷角标，回 tab 页即恢复）`);
    return false;
  }
  return true;
}

function clearBadge(): void {
  if (!canUpdateTabBarBadge()) {
    return;
  }
  try {
    uni.removeTabBarBadge({
      index: MESSAGE_TAB_INDEX,
      fail: (_err) => {
        // TabBar 未就绪时忽略
      },
    });
  } catch (_e) {
    // uni-app x 部分端会以异常抛出 UniError
  }
}

function setBadge(count: number): void {
  if (!canUpdateTabBarBadge()) {
    return;
  }
  imUnreadLog(`setTabBarBadge index=${MESSAGE_TAB_INDEX} count=${count}`);
  try {
    uni.setTabBarBadge({
      index: MESSAGE_TAB_INDEX,
      text: count > 99 ? "99+" : `${count}`,
      fail: (_err) => {
        // TabBar 未就绪时忽略，进入 Tab 页后再刷新
      },
    });
  } catch (_e) {
    // uni-app x 部分端会以异常抛出 UniError
  }
}

/**
 * 刷新「消息」Tab 的 IM 未读徽标。
 * 角标值 = total + dndTotal（对齐飞书：tabBar 角标计入免打扰消息，免打扰的
 * 区分在列表行内体现——红数字→灰数字）。★服务端 UnreadTotalResult 的 total
 * 【不含】免打扰会话（设计如此：角标不被静音群顶爆），免打扰部分单独走
 * dndTotal——只取 total 会让静音群的增长完全不上角标（真机实测卡在 1）。
 */
let badgeLoading = false;
let badgeRefreshOwed = false;
let badgeRevision = 0;

export async function refreshImUnreadBadge(): Promise<void> {
  if (isAppInBackground()) return;
  if (badgeLoading) {
    badgeRefreshOwed = true;
    return;
  }
  const stamp = getImSessionStamp();
  const revision = badgeRevision;
  const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
  const token = tokenRaw != null ? `${tokenRaw}` : "";
  if (token.length == 0) {
    imUnreadCount.value = 0;
    clearBadge();
    return;
  }

  badgeLoading = true;
  try {
    const response = await apiImUnreadTotal();
    if (stamp != getImSessionStamp() || revision != badgeRevision) return;
    if (apiResCode(response) != SUCCESS_CODE) {
      imUnreadLog(`unread-total 接口非成功码: ${apiResCode(response)}`);
      return;
    }
    const dataRaw = apiResData<any>(response);
    const data = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
    if (data == null) {
      return;
    }
    const totalRaw = data["total"];
    const total = totalRaw != null ? parseInt(`${totalRaw}`) : 0;
    const dndRaw = data["dndTotal"];
    const dndTotal = dndRaw != null ? parseInt(`${dndRaw}`) : 0;
    const authoritativeRaw = data["authoritative"];
    const degraded = authoritativeRaw != null && `${authoritativeRaw}` == "false";

    let count = 0;
    if (!isNaN(total)) {
      count += total > 0 ? total : 0;
    }
    if (!isNaN(dndTotal)) {
      count += dndTotal > 0 ? dndTotal : 0;
    }
    imUnreadLog(`unread-total total=${total} dnd=${dndTotal} count=${count} degraded=${degraded}`);
    imUnreadCount.value = count;
    if (count <= 0) {
      clearBadge();
      return;
    }
    setBadge(count);
  } catch (_error) {
    // 未读数刷新失败时保留上一次徽标。
  } finally {
    badgeLoading = false;
    if (badgeRefreshOwed) {
      badgeRefreshOwed = false;
      scheduleWsRefresh();
    }
  }
}

/** 退出登录等场景立即清零徽标。 */
export function clearImUnreadBadge(): void {
  badgeRevision += 1;
  badgeRefreshOwed = false;
  const timer = wsRefreshTimer;
  if (timer != null) clearTimeout(timer);
  wsRefreshTimer = null;
  imUnreadCount.value = 0;
  clearBadge();
}

// ==================== WS 帧驱动 tabBar 角标（最后一环） ====================

/** WS 未读相关帧 → 角标刷新的去抖定时器（群消息风暴合并为一次 HTTP 全量拉取）。 */
let wsRefreshTimer: number | null = null;
/** 防重复绑定（App 生命周期内只绑一次）。 */
let wsEventsBound = false;

/**
 * WS 帧 → 角标刷新（1s 去抖）：走全量 GET unread-total 而非本地 +1——
 * 自己在其他端发的消息不计未读、免打扰部分走 dndTotal、已读边界随会话状态变，
 * 本地加必然算不准；全量拉一次永远与服务端口径一致，风暴期合并为一次请求。
 * 无轮询：断线/重连窗口由回前台 onShow 全量拉一次兜底（App.uvue）。
 */
function scheduleWsRefresh(): void {
  // 局部变量承接：可变模块属性无法 smart cast 到 Number（Kotlin 并发限制）
  const timerId = wsRefreshTimer;
  if (timerId != null || isAppInBackground()) return;
  wsRefreshTimer = setTimeout(() => {
    wsRefreshTimer = null;
    imUnreadLog("ws 去抖到点 → 全量拉 unread-total");
    refreshImUnreadBadge();
  }, 1000);
}

/**
 * 绑定 WS 事件到 tabBar 角标（App onLaunch 调用一次）：
 * - im_message_received：来新消息（含自己在 PC 端发的多端同步帧）→ 稍后全量拉
 * - im_conversation_unread：CONV_UNREAD(6001) 是「自己其他端已读后」的红点同步帧
 *   （服务端 ImReadStateApplicationService ⑥，只发给自己其他端）→ 全量拉
 */
export function bindImUnreadWsEvents(): void {
  if (wsEventsBound) {
    return;
  }
  wsEventsBound = true;
  eventBus.on(`${EVENT_TYPE.ImMessagesSynced}`, (_event: any) => { scheduleWsRefresh(); });
  // 零参函数直接当 EventCallback 传在 UTS→Kotlin 报 Unit≠EventCallback（error17），
  // 包箭头函数（同 App.uvue NewNotifyMessage 绑定写法）
  eventBus.on(`${EVENT_TYPE.ImMessageReceived}`, (_event: any) => {
    imUnreadLog("ws im_message_received → 1s 去抖");
    scheduleWsRefresh();
  });
  eventBus.on(`${EVENT_TYPE.ImConversationUnread}`, (_event: any) => {
    imUnreadLog("ws im_conversation_unread → 1s 去抖");
    scheduleWsRefresh();
  });
}
