<template>
  <view
    class="im-page"
    @touchstart="handlePageTouchStart($event)"
    @touchend="handlePageTouchEnd($event)"
    @touchcancel="handlePageTouchCancel($event)"
  >
    <safety-zone />

    <!-- 工作商业版未授权（workCommercialEdition !== true）：整页居中提示，
         不渲染列表与入口、不发任何 IM 请求（对齐 PC WorkCommercialRouteBoundary；
         WS 连接 / 未读角标在工具层同步闸门，见 utils/workCommercial.uts） -->
    <view v-if="workGateBlocked" class="work-gate">
      <text class="work-gate__text">{{ t("Mobile.Message.workCommercialRequired") }}</text>
    </view>
    <!-- 闸门未定（缓存缺失、租户配置拉取中）：加载占位（PC Boundary 的 Spin 同款语义） -->
    <view v-else-if="workGatePending" class="work-gate">
      <text class="work-gate__text">{{ t("Mobile.Page.loadingMore") }}</text>
    </view>
    <template v-else>
    <!-- 顶部：消息 / 智联录 tab + 搜索、添加占位入口（组件化 Stage 3 抽出
         im-header-tabs；加号测量经组件 measurePlus/$callMethod + plus-rect 上抛） -->
    <im-header-tabs
      ref="headerTabsRef"
      :active-tab="activeTab"
      :pending-in-count="contactPendingInCount"
      :add-covered="addDrawerVisible"
      @tab-click="switchTab"
      @search-tap="handlePlaceholderTap"
      @plus-tap="openAddDrawer"
      @plus-rect="onHeaderPlusMeasured"
    />

    <!-- 消息 / 智联录双页 swiper（专家页同款滑动效果）：横滑跟手切 tab，tab 点击经
         current 驱动滑向目标页；横滑与列表纵向滚动的手势仲裁由原生 swiper 承担
         （斜滑不再带动列表，页面级触摸只留吞击守卫与浮层收起，滚动锁只剩长按浮层） -->
    <swiper
      class="im-body"
      :current="activeTab == 'contact' ? 1 : 0"
      @change="handleTabSwiperChange"
      :indicator-dots="false"
      :circular="false"
      :duration="300"
      easing-function="easeOut"
    >
      <!-- 消息 tab：会话列表（组件化 Stage 4 抽出 conv-list-pane；长按浮层期间
           direction=none 锁滚动、行测量经组件 measureRow/$callMethod + row-rect 上抛） -->
      <swiper-item>
        <!-- loading 喂首拉加载态（convInitialLoading）而非在途标志 convLoading：
             空表后的静默刷新不回闪「加载中」，首拉前的间隙帧也不闪「暂无消息」 -->
        <conv-list-pane
          ref="convPaneRef"
          :conversations="conversations"
          :loading="convInitialLoading"
          :failed="convFailed"
          :loading-more="convLoadingMore"
          :has-more="convHasMore"
          :scroll-anchor="convScrollAnchor"
          :menu-visible="rowMenuVisible"
          :menu-row-id="rowMenuRowId"
          :pressed-row-id="pressedRowId"
          @retry="handleConvRetry"
          @scroll="handleListScroll"
          @scroll-lower="handleConvScrollLower"
          @pane-touchstart="handlePageTouchStart"
          @pane-touchend="handlePageTouchEnd"
          @pane-touchcancel="handlePageTouchCancel"
          @row-click="handleConvRowClick"
          @row-touchstart="handleConvRowTouchStart"
          @row-touchmove="handleRowTouchMove"
          @row-touchend="handleConvRowTouchEnd"
          @row-touchcancel="handleRowTouchCancel"
          @avatar-loaded="handleConvAvatarLoaded"
          @avatar-error="handleConvAvatarError"
          @row-rect="onPaneRowRectMeasured"
        />
      </swiper-item>

      <!-- 智联录 tab：通讯录列表（组件化 Stage 5 抽出 contact-list-pane；同会话列表
           direction=none 锁滚动、行测量经组件 measureRow/$callMethod + row-rect 上抛） -->
      <swiper-item>
        <contact-list-pane
          ref="contactPaneRef"
          :pending-in="pendingInContacts"
          :pending-out="pendingOutContacts"
          :spaces="mySpaces"
          :groups="myGroups"
          :contacts="acceptedContacts"
          :contact-total="contactTotal"
          :space-total="spaceTotal"
          :group-total="groupTotal"
          :loading="contactLoading"
          :failed="contactFailed"
          :spaces-loaded="spacesLoaded"
          :groups-loaded="groupsLoaded"
          :spaces-expanded="spacesExpanded"
          :groups-expanded="groupsExpanded"
          :degraded="contactDegraded"
          :truncated="contactTruncated"
          :menu-visible="rowMenuVisible"
          :menu-row-id="rowMenuRowId"
          :pressed-row-id="pressedRowId"
          @retry="handleContactRetry"
          @scroll="handleListScroll"
          @pane-touchstart="handlePageTouchStart"
          @pane-touchend="handlePageTouchEnd"
          @pane-touchcancel="handlePageTouchCancel"
          @row-touchstart="handleRowTouchStart"
          @contact-touchstart="handleContactRowTouchStart"
          @group-touchstart="handleGroupRowTouchStart"
          @row-touchmove="handleRowTouchMove"
          @row-touchcancel="handleRowTouchCancel"
          @pending-in-click="handlePendingInRowClick"
          @pending-in-touchend="handlePendingInRowTouchEnd"
          @pending-out-click="handlePendingOutRowClick"
          @pending-out-touchend="handlePendingOutRowTouchEnd"
          @spaces-head-click="handleSpacesHeadClick"
          @spaces-head-touchend="handleSpacesHeadTouchEnd"
          @space-row-click="handleSpaceRowClick"
          @space-row-touchend="handleSpaceRowTouchEnd"
          @groups-head-click="handleGroupsHeadClick"
          @groups-head-touchend="handleGroupsHeadTouchEnd"
          @group-row-click="handleConvRowClick"
          @group-row-touchend="handleConvRowTouchEnd"
          @contact-row-click="handleContactRowClick"
          @contact-row-touchend="handleContactRowTouchEnd"
          @contact-avatar-loaded="handleContactAvatarLoaded"
          @contact-avatar-error="handleContactAvatarError"
          @conv-avatar-loaded="handleConvAvatarLoaded"
          @conv-avatar-error="handleConvAvatarError"
          @space-icon-loaded="handleSpaceIconLoaded"
          @space-icon-error="handleSpaceIconError"
          @row-rect="onPaneRowRectMeasured"
        />
      </swiper-item>
    </swiper>
    </template>

    <!-- 长按行操作浮层（双模式）：rowMenuDark（自定义 tabbar 平台）=飞书式——压暗蒙层条
         挖洞（紧邻其下）+ 行原位浅灰高亮 + 行旁锚定白色气泡；MP（原生 tabBar
         盖不住）=无蒙层同款气泡，路径不变。
         气泡根 @touchstart/.touchend/.touchcancel 三阶段全断冒泡（气泡内不算点外——
         add-menu-drawer 同款，漏断 touchend 会让页面吞击守卫拿旧起点误判滑动、白吞
         item click），同手势补发的 click 全吞（rowMenuTouchSwallowed）防误进会话/
         误触入口；Android 返回先关浮层；列表滚动随浮层锁死（direction=none）。
         底部导航：MP 原生 tabBar / 其余 common-tab-bar，切页时由 onHide 收起浮层 -->
    <!-- 飞书式压暗蒙层条 + 行旁锚定气泡：已抽为 row-menu-pop 组件（Stage 2），显隐/
         定位/操作项经 props 下发，收层请求与操作分发经 mask-close/act-tap 上抛 -->
    <row-menu-pop
      :visible="rowMenuVisible"
      :dark="rowMenuDark"
      :acts="rowMenuActs"
      :pop-style="rowMenuPopStyle"
      :mask-top-style="rowMenuMaskTopStyle"
      :mask-bottom-style="rowMenuMaskBottomStyle"
      @mask-close="closeRowMenu"
      @act-tap="handleRowMenuAct"
    />

    <!-- 右上角「+」锚定气泡：创建群组 / 加入群组 / 添加伙伴 / 扫一扫
         fixed 全屏近透明蒙层承接点外关闭（蒙层 @tap 收起，confirm-modal 同款结构），
         气泡 absolute 挂蒙层内（视口坐标锚定）。
         ★Android 点外关闭暂不可用（2026-10-01 四轮真机日志，暂缓排查）：蒙层版
         点外为事件黑洞（原生层拦住触摸但 tap/touchstart 均不派发到 JS）；无蒙层版
         （页面根 touchstart 冒泡收起 + 吞击守卫）点 header 又零事件，锚定
         $callMethod 与数字 props 两通道均试过无果。Android 暂靠返回键/菜单项收起 -->
    <view v-if="addDrawerVisible" class="add-drawer-mask" @tap="handleAddMaskTap">
      <add-menu-drawer
        :visible="addDrawerVisible"
        :anchor-bottom="addDrawerAnchorBottom"
        :anchor-right-gap="addDrawerAnchorRightGap"
        @create-group="handleCreateGroupTap"
        @join-group="handleJoinGroupTap"
        @add-buddy="handleAddBuddyTap"
        @scan-tap="handleScanTap"
        @closed="handleAddDrawerClosed"
      />
    </view>
    <!-- 以下两块补层为 Android 专属（iOS/H5 不渲染：蒙层 @tap 直通点外关闭、真加号
         可直接 toggle，补层反而因复制图标与真图标切换产生闪动）。
         fixed 全屏蒙层在 Android 上不稳定命中 header；顶部专用透明命中区只负责关闭，
         高度止于加号底部，不盖住下方菜单气泡。 -->
    <!-- #ifdef APP-ANDROID -->
    <view
      v-if="addDrawerVisible"
      class="add-header-dismiss-overlay"
      :style="addHeaderDismissOverlayStyle"
      @tap.stop="handleAddMaskTap"
    />
    <!-- Android 的 fixed 蒙层会覆盖 header 所在原生命中层；菜单展开后在蒙层之后
         单独补一个加号命中层（真图标已由 im-action--covered 隐藏，此层图标替身），
         保证再次点击加号可以执行 toggle。 -->
    <view
      v-if="addDrawerVisible"
      class="add-plus-overlay"
      :style="addPlusOverlayStyle"
      @tap.stop="openAddDrawer"
    >
      <svg-icon name="icon-a-Pluscircle" size="22" unit="px" color="#1c1b20" />
    </view>
    <!-- #endif -->
    <!-- 扫一扫结果弹层（用户码加联系人 / 链接确认打开 / 文本展示复制） -->
    <scan-launcher ref="scanLauncherRef" @join-group="handleScanJoinGroup" @add-buddy="handleScanAddBuddy" />
    <!-- 修改备注底部弹窗（留空保存 = 清除备注） -->
    <remark-sheet ref="remarkSheetRef" @saved="handleRemarkSaved" />
    <!-- 新的伙伴申请 · 申请详情卡片（理由全文 + 同意/拒绝） -->
    <apply-detail-sheet ref="applyDetailSheetRef" @resolved="handleContactRequestResolved" />
    <!-- 紧凑确认弹窗（删除会话/联系人、解散/退出群聊等危险操作确认，替代系统 showModal 样式） -->
    <confirm-modal ref="confirmModalRef" @confirm="handleConfirmOk" @cancel="handleConfirmCancel" />
  </view>
</template>

<script setup lang="uts">
  import { getCurrentInstance, nextTick, ref, watch, type ComponentPublicInstance } from "vue";
  import { useMainTabLifecycle } from "@/hooks/useMainTabLifecycle";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { hasLoginSession } from "@/utils/authSession";
  import { syncNativeTabBarState } from "@/utils/commonBusiness";
  import {
    LOGIN_PAGE_PATH,
    LOGIN_WEIXIN_PAGE_PATH,
    redirectToLoginOnce,
  } from "@/utils/authNavigation";
  import AddMenuDrawer from "./components/add-menu-drawer.uvue";
  import RowMenuPop from "./components/row-menu-pop.uvue";
  import ImHeaderTabs from "./components/im-header-tabs.uvue";
  import ConvListPane from "./components/conv-list-pane.uvue";
  import ContactListPane from "./components/contact-list-pane.uvue";
  import ScanLauncher from "@/components/scan-launcher/scan-launcher.uvue";
  import RemarkSheet from "./components/remark-sheet.uvue";
  import ApplyDetailSheet from "./components/apply-detail-sheet.uvue";
  import ConfirmModal from "@/components/confirm-modal/confirm-modal.uvue";
  // 组件化重构 Stage 1：行模型与行渲染纯函数抽至本地 uts 模块（panes 子组件共用）
  import { ImConvRow, ImContactRow, ImSpaceRow, ImRowMenuAct } from "./components/im-row-models.uts";
  import {
    AVATAR_DISPLAY_PX,
    assignContactFallbacks,
    assignConvFallbacks,
    assignSpaceFallbacks,
    cloneConvRow,
    cloneConvRows,
    displayConvName,
    isSystemConv,
    rebuildContactNameIndex,
  } from "./components/im-row-helpers.uts";
  import {
    registerPopupClose,
    unregisterPopupClose,
  } from "@/utils/popupBackRegistry";
  import {
    apiImContactReject,
    apiImContactRemove,
    apiImContacts,
    apiImConversations,
    apiImConvRemove,
    apiImConvSetDnd,
    apiImConvSetTop,
    apiImCreateP2pConversation,
    apiImGroupDisband,
    apiImGroupLeave,
    apiImMyGroups,
    apiImSpaceEnter,
    apiImSpaces,
  } from "@/servers/im";
  import type { RequestResponse } from "@/types/interfaces/request";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { refreshImUnreadBadge, clearImUnreadBadge } from "@/utils/imUnreadBadge";
  import { consumeConvReadMark } from "@/utils/im/imConvReadLocal";
  // 伙伴页列表缓存（SWR）：进页先水合缓存秒出，网络回包整表替换后回写
  import {
    clearImListCache,
    readImContactsCache,
    readImConvCache,
    readImGroupsCache,
    readImSpacesCache,
    saveImContactsCache,
    saveImConvCache,
    saveImGroupsCache,
    saveImSpacesCache,
  } from "@/utils/im/imListCache";
  // 会话草稿（微信式）：聊天页未发文案，列表摘要行显示「[草稿]xxx」
  import { getChatDraft, chatDraftRecency, chatDraftsVersion } from "@/utils/im/chatDrafts";
  import { initImWsClient, stopImWsClient } from "@/utils/im/imWsClient";
  import { isWorkCommercialBlockedSync, resolveWorkCommercialBlocked } from "@/utils/workCommercial";
  import eventBus from "@/utils/eventBus";
  import { getImSessionStamp, IM_SESSION_CLEARED } from "@/utils/im/imSessionScope";
  import { isAuthProtectedFileUrl, releaseDisplayImageUrl } from "@/utils/authProtectedFileUrl";
  import { isAppInBackground } from "@/utils/appLifecycle";
  import { EVENT_TYPE } from "@/constants/event.constants";
  import { CUSTOM_TAB_BAR_ENABLED } from "@/constants/customTabBar.constants";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { isRemoteSvgUrl, resolveDisplayImageUrl } from "@/utils/remoteSvgImage";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { ReliableTap } from "@/utils/reliableTap.uts";
  // 本地图标用 png：App 端 <image> 官方支持格式不含 svg，部分机型直接不渲染（对齐 agent-union-record 做法）
  // 头像兜底：拼名群（「用户a，用户b」式群名）无语义词可取，走默认群剪影图

  const { onLoad, onShow, onHide, onUnload, onRetap } = useMainTabLifecycle("/pages/message/message");

  const messagePageSession = getImSessionStamp();
  let messagePageVisible = false;
  let messagePageDisposed = false;
  let convRevision = 0;
  let convRefreshTimer = 0;
  let convRefreshOwed = false;
  const seenMessageIds = new Set<string>();
  const seenMessageOrder: string[] = [];

  let convRefreshRunner: (() => void) | null = null;
  let convLoadRetryRunner: (() => void) | null = null;

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // 模板可见的行渲染辅助：uvue 模板不能直接调导入函数（invoke 解析失败），包一层
  // 本地 const（plan-cards 同款约束）。Stage 4/5 模板随 pane 迁入子组件后此处删除。

  /** 会话列表页大小（服务端 clamp 到 [1,100]）。 */
  const CONV_PAGE_SIZE = 50;

  // ===== 工作商业版闸门（对齐 PC WorkCommercialRouteBoundary）=====
  // workCommercialEdition !== true → 整页替换为居中提示语，所有 IM 请求（会话/
  // 联系人/群组/团队/未读）与 WS 连接全部不出；pending = 缓存未定、租户配置拉取中
  // （PC 同款 Spin 语义）。授权态翻转（缓存被登录页/其他 Tab 刷新）经 onShow 复查
  // 就地生效：撤销即停 WS 清角标，恢复即补首拉。
  const workGateBlocked = ref<boolean>(false);
  const workGatePending = ref<boolean>(true);

  // ===== 行按压反馈（点按判定成立才亮，pressedRowId）=====
  // 按住期间不点亮：此时还区分不了点击/滑动，先不给反馈（原「按下 50ms 仍在按
  // 点亮」层已移除）。手指真实抬起（touchend）且落点位移 ≤6px = 判定为点击，
  // 此刻才挂激活底色 ~300ms；click 紧随 touchend 到达，各点击入口的 flashRowPressed
  // 重置计时覆盖页面转场。位移超 6px 判定为滑动、触摸被取消（touchcancel，Android
  // 滚动接管）一律不闪，全程无灰底。
  // 滚动抑制（rowTouchDuringScroll 起手快照）：起手于滚动中（点停惯性滚动）的抬手
  // 不闪不派发；快照在 touchstart 落定，滚动停稳 ≥80ms 后的真实点击不再被
  // listScrolling 的 160ms idle 尾窗连坐（见 rowTouchDuringScroll 声明处注释）。
  // ★不用 hover-class：Android 上触摸被滚动接管后按压底色会粘住不灭
  //   （长按后上下滑、快速滑动扫过的行被点亮，松手后残留；把 hover-class
  //   值改成 'none' 也清不掉已激活样式）。
  const pressedRowId = ref<string>("");
  let pressedRowTimer = 0;

  // ===== 行触摸判定态（只判点击/滑动，不驱动点亮）=====
  /** 待判定行（touchstart 记入；位移超 6px 判滑动即清，抬手仍非空 = 点击）。 */
  let touchingRowPending = "";
  /** 起手快照：起手时长按浮层开着且正落在浮层所属行（行 touchstart 先于页面根冒泡执行、
   *  浮层尚未被收起，快照有效）。抬手按它区分：所属行=只收层（不进会话、不闪灰），
   *  其余行=正常点按动作（进会话/联系人操作）。 */
  let rowTouchOnMenuOwner = false;
  let rowTouchStartX = 0;
  let rowTouchStartY = 0;
  /** 起手快照：touchstart 时距最近滚动事件 <80ms（fling 进行中触摸，scroll 事件每帧
   *  在发）= 点停惯性滚动的手势。抬手时才查 listScrolling 会被其 160ms idle 尾窗连坐：
   *  滚动停稳后的真实点击先被拦派发、settleRowTouchEnd 里刚置上的 500ms 防重窗又吞掉
   *  随后补发的合成 click——双通道全死、这次点击净丢失（三星 fling 快而长，点停后紧点
   *  行「没反应」即此）。80ms 介于 fling 帧间隔(~16ms)与人手反应时(≥150ms)之间。 */
  let rowTouchDuringScroll = false;
  /** 本轮手势是否弹出了长按浮层（openRowMenu 置位、touchstart 清零）：弹浮层手势的
   *  抬手绝不派发——持按超过 800ms 吞击窗再松手时，rowClickIntercept 会把它当
   *  「超时到达的真实点击」走到收浮层分支（长按松手浮层自关的回归即此）。 */
  let rowTouchMenuArmed = false;
  /** 长按自计时器（撤 @longpress 后自计时，见 armRowLongPress；在此先声明是因为
   *  clearRowTouch 要清它——滑动/取消/滚动接管/抬手任一终结即弃，到点不得再弹）。 */
  let rowLongPressTimer = 0;

  /** 清长按自计时（与 touchingRowPending 同生命周期，clearRowTouch 统一调）。 */
  function cancelRowLongPress(): void {
    if (rowLongPressTimer != 0) {
      clearTimeout(rowLongPressTimer);
      rowLongPressTimer = 0;
    }
  }

  /** 长按浮层「点外收起」手势的吞击位：收层当次手势稍后派发的 click 全吞（点外只关
   *  浮层不穿透），下一次页面 touchstart（新手势）自动解除；置位在 handlePageTouchStart，
   *  经 pageTapSwallowed() 并入各 click 入口守卫。★在此先声明是因为 settleRowTouchEnd
   *  要读它（收层手势不闪灰）——UTS 不提升，前向引用报错。 */
  let rowMenuTouchSwallowed = false;

  // ===== 三星可靠点按（utils/reliableTap.uts）：touchend 主通道派发 + click 兜底 =====
  // 三星 One UI 触控灵敏，按压触下瞬间带微移即被原生层判为手势、不合成 click
  // （会话/智联录行点了没反应即此症）。slop 取 10 与下方 finishPageTouch 的吞击
  // 阈值对齐：页面判为滑动的位移（>10px）必被点按判定拒绝，滑动抬手不会从主通道
  // 漏进。每轮 touchstart 先 reset 清防重窗——500ms 窗只负责吞「本轮 touchend 派发
  // 后紧随的合成 click」，不吞下一次手势（桌面 H5 无 touchstart 清窗，500ms 内连续
  // 第二次鼠标点击会被吞一次，仅桌面、接受）。
  const rowTapGuard = new ReliableTap(10);

  // 行点按闪亮 class（pressedRowCls/pressedHeaderCls）与长按高亮 class（rowMenuOnCls）
  // 已随 pane 组件迁移（Stage 4/5）：组件内联表达式读 props 实现，互斥/色号不变。

  /** 轻点行：挂激活底色 ~300ms（页面转场期间仍可见）；重复点按重置计时。 */
  function flashRowPressed(rowId: string): void {
    pressedRowId.value = rowId;
    if (pressedRowTimer != 0) {
      clearTimeout(pressedRowTimer);
    }
    pressedRowTimer = setTimeout(() => {
      pressedRowTimer = 0;
      pressedRowId.value = "";
    }, 300);
  }

  /** 最近一次滚动事件时刻（handleListScroll 记；rowTouchDuringScroll 起手快照用）。
   *  原 listScrolling + 160ms idle 尾窗已撤：读点全改起手快照（尾窗连坐死点击，见
   *  rowTouchDuringScroll 声明处注释）。 */
  let lastScrollEventAt = 0;

  // ===== 长按行操作浮层 / 横滑切 tab 页级状态（须先于 handleListScroll 等使用方：UTS 不提升声明）=====
  /** 长按操作浮层是否展开（无蒙层：行浅灰高亮 + 行旁锚定气泡）。 */
  const rowMenuVisible = ref<boolean>(false);
  /** 浮层指向的行类型："conv"=会话 "group"=群组 "contact"=联系人（status=3 撤回申请/其余常规操作集）。 */
  const rowMenuKind = ref<string>("");
  /** 浮层指向的行数据（conv/group 共用 ImConvRow；contact 含已申请 status=3）。 */
  const rowMenuConv = ref<ImConvRow | null>(null);
  const rowMenuContact = ref<ImContactRow | null>(null);
  /** 气泡操作项（按行类型生成：文案+图标，点击按 index 分发 handleRowMenuAct）。 */
  const rowMenuActs = ref<ImRowMenuAct[]>([]);
  /** 气泡定位（视口坐标系 px 样式串，fixed 定位与蒙层条同层；长按测行矩形后拼装）。 */
  const rowMenuPopStyle = ref<string>("");
  /** 飞书式压暗蒙层总开关：自定义 tabbar 平台（APP/H5/WEB）开，MP 保留旧版
   *  无蒙层（原生 tabBar 盖不住）；气泡面板两端统一纯白底。★单点回退：改 false
   *  即整页回到旧行为。 */
  const rowMenuDark = CUSTOM_TAB_BAR_ENABLED;
  /** 压暗蒙层条高度（fixed 视口系 px 样式串，长按测行矩形后拼装；仅 rowMenuDark 平台写值）。 */
  const rowMenuMaskTopStyle = ref<string>("");
  const rowMenuMaskBottomStyle = ref<string>("");
  // 吞击位：长按弹浮层/所属行收层抬手后部分端仍补发一次 click，吞掉避免误进会话/误关浮层。
  // ★双保险防白吞下一次真实点按（主通道被它拦 + 补发 click 被 guard 防重窗拦 = 双通道
  //   全死、点击净丢失）：① 新行手势 touchstart 即清（handleRowTouchStart，要吞的补发
  //   click 属上一手势、物理上必先于本次 touchstart 到达，此时清不漏吞）；② 800ms 时效
  //   兜底（Android 长按抬手通常不补发 click，flag 会一直挂着）。
  let suppressNextSwipeClick = false;
  let suppressSwipeClickUntil = 0;

  /** 长按浮层指向的行 id（pressedRowCls 同键：conv/group=convId、contact=ct-userId）。
   *  Stage 4 起 ref 化：经 :menu-row-id 下发 pane 子组件（模板自动解包）。 */
  const rowMenuRowId = ref<string>("");

  // 置顶行常驻底色 class（pinnedRowCls）已随 conv-list-pane 迁移（Stage 4）：组件内
  // 联表达式实现，互斥逻辑不变（App 原生端同特异性 class 覆盖不保证按样式表序）。

  /** 收起长按浮层（页面任意触摸/操作分发/Android 返回）。★声明在 handlePageTouchStart
   *  之前：页面级「点外收起」要调它（UTS 先声明后调用）。 */
  function closeRowMenu(): void {
    if (rowMenuVisible.value != true) {
      return;
    }
    rowMenuVisible.value = false;
    rowMenuKind.value = "";
    rowMenuConv.value = null;
    rowMenuContact.value = null;
    rowMenuActs.value = [];
    rowMenuRowId.value = "";
  }

  /** 清行触摸判定态（任何触摸结束路径都调它，杜绝粘滞）。长按自计时一并清：
   *  计时存续期间手势已被滑动/取消/滚动接管/抬手终结，到点不得再弹。 */
  function clearRowTouch(): void {
    touchingRowPending = "";
    cancelRowLongPress();
  }

  function handleListScroll(): void {
    lastScrollEventAt = Date.now();
    // 滚动事件 = 手势已被原生滚动接管：立即清触摸判定态（否则抬手会被误判为
    // 点击闪灰）。Android 上子视图 touchmove 在 touchslop(≈8px) 拦截后断流，
    // 位移清除路径走不到（iOS move 持续分发故无此问题），滚动事件是兜底。
    clearRowTouch();
    // 滚动即收起长按操作浮层；横滑切 tab 期间 direction 已锁 none 不产生滚动事件，
    // 不会与切 tab 手势竞争
    if (rowMenuVisible.value) {
      rowMenuVisible.value = false;
    }
  }

  /** 行触摸开始：记起点与待判定行（按住不点亮，点亮推迟到抬手判定为点击时）。
   *  三星可靠点按：先清防重窗再记本轮起点（防上一轮 500ms 窗吞掉快速连点的下一击）；
   *  须在 touches 早退之前喂——touchStart 内含 changedTouches 兜底（鸿蒙系 touches
   *  可能为空），早退路径的起点也要有值。
   *  起手快照 rowTouchDuringScroll 在此落定（见其声明处注释）。 */
  function handleRowTouchStart(rowId: string, eventValue: Any): void {
    rowTapGuard.reset();
    rowTapGuard.touchStart(eventValue);
    rowTouchMenuArmed = false;
    // 新手势解除上一轮吞击窗：所属行收层抬手/openRowMenu 置的 800ms 窗若存活，会连坐
    // 吞掉紧随的下一次真实点按（收层后再点同一行没反应即此），见声明处注释
    suppressNextSwipeClick = false;
    rowTouchOnMenuOwner = rowMenuVisible.value && rowMenuRowId.value == rowId;
    rowTouchDuringScroll = Date.now() - lastScrollEventAt < 80;
    const e = eventValue as UniTouchEvent;
    if (e.touches.length > 0) {
      rowTouchStartX = e.touches[0].clientX;
      rowTouchStartY = e.touches[0].clientY;
      touchingRowPending = rowId;
      return;
    }
    // 鸿蒙系 touches 可能为空（坐标在 changedTouches，guard 同款兜底）：不记行的话
    // touchingRowPending 恒空，长按自计时到点必弃、闪灰也不亮。
    if (e.changedTouches != null && e.changedTouches.length > 0) {
      rowTouchStartX = e.changedTouches[0].clientX;
      rowTouchStartY = e.changedTouches[0].clientY;
      touchingRowPending = rowId;
    }
  }

  /** 行触摸移动：位移超 6px = 判定为滑动（滚动/左滑/长按拖动），清判定态（全程无灰底）。 */
  function handleRowTouchMove(eventValue: Any): void {
    if (touchingRowPending.length == 0) {
      return;
    }
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    const dx = e.touches[0].clientX - rowTouchStartX;
    const dy = e.touches[0].clientY - rowTouchStartY;
    // 阈值须低于 Android touchslop(≈8px)：原生滚动在 touchslop 拦截后子视图
    // touchmove 断流，10px 永远等不到（滑动抬手被误判为点击闪灰）；6px 能赶在拦截前清掉
    if (Math.abs(dx) > 6 || Math.abs(dy) > 6) {
      clearRowTouch();
    }
  }

  /** 行触摸结束（手指真实抬起）公共判定：闪灰 + 三星可靠点按判定。
   *  闪灰：判定态仍非空 + 抬手落点位移 ≤6px = 点击，挂激活底色 ~300ms（各点击入口
   *  的 flashRowPressed 会重置计时覆盖页面转场）。不闪：起手于滚动中（点停惯性滚动，
   *  rowTouchDuringScroll 快照）；长按操作浮层开着（含长按弹层后的抬手，
   *  rowClickIntercept 会吞派发）；落点位移复检不过（兜底 move 断流——Android 滚动
   *  接管可在一个帧批内完成、行上一个 >6px 的 move 都没送达）。
   *  返回 true = 点按派发主通道放行（guard 位移 ≤10px 且非起手于滚动中）：调用方
   *  再过 rowClickIntercept 后执行行点击动作（三星微移不合成 click 的兜底主通道）。
   *  起手于滚动中的抬手不派发（Android「点停不激活」惯例，同闪灰口径）；起手时列表
   *  已停 ≥80ms 的真实点击照常派发——不再被 160ms idle 尾窗连坐（此前该尾窗拦下
   *  派发后，刚置上的 500ms 防重窗又吞掉补发 click，双通道全死、点击净丢失）。
   *  弹浮层手势（rowTouchMenuArmed）的抬手一律不派发：持按超 800ms 吞击窗再松手
   *  时 rowClickIntercept 会把本轮抬手当「超时到达的真实点击」走到收浮层分支；
   *  吞击位也不在此消费，留给随后平台补发的 click 走原吞法（只吞不关）。 */
  function settleRowTouchEnd(eventValue: Any): boolean {
    const tapFired = rowTapGuard.touchEnd(eventValue);
    if (
      touchingRowPending.length > 0 &&
      rowTouchDuringScroll != true &&
      rowMenuVisible.value != true &&
      // 浮层所属行的收层手势不闪灰：点它=只收层，闪一下灰底像「点了没反应」；其余行
      // 放行闪灰——那是正常点按反馈（闪完随即进会话）
      rowTouchOnMenuOwner != true
    ) {
      const e = eventValue as UniTouchEvent;
      if (e.changedTouches != null && e.changedTouches.length > 0) {
        const dx = e.changedTouches[0].clientX - rowTouchStartX;
        const dy = e.changedTouches[0].clientY - rowTouchStartY;
        if (Math.abs(dx) <= 6 && Math.abs(dy) <= 6) {
          flashRowPressed(touchingRowPending);
        }
      }
    }
    clearRowTouch();
    if (rowTouchMenuArmed) {
      return false;
    }
    // 浮层所属行的收层抬手不派发（点它=只收层不进会话）；置 800ms 吞击窗吞掉 Android
    // 抬手补发的 click（同 openRowMenu 长按弹层的吞法，只吞不派发不闪灰）
    if (rowTouchOnMenuOwner) {
      suppressNextSwipeClick = true;
      suppressSwipeClickUntil = Date.now() + 800;
      return false;
    }
    return tapFired && rowTouchDuringScroll != true;
  }

  /** 行触摸被取消（Android 滚动接管/系统打断）：绝不是点击，只清判定态、不闪。
   *  ★必须与 touchend 分开绑：接管 cancel 可能先于首个滚动事件到达（起手快照
   *  仍判非滚动中），并入 touchend 会把刚起步的滚动误判为点击闪灰——
   *  表现为按住行上下滑动时灰底闪现（iOS 无接管 cancel，不受影响）。 */
  function handleRowTouchCancel(): void {
    clearRowTouch();
  }

  // ===== 「+」气泡开合（定位测量见「右上角+锚定气泡」节）=====
  // 状态唯一归页面所有（经 :visible 下发组件）——组件不自带显隐状态，页面/组件间
  // 无跨模块共享 ref（uni-app x 页面与组件的模块实例不保证同份，页面本地 ref 才可靠）。
  // 点外关闭=蒙层 @tap（fixed 全屏承接层，iOS 主路径）；根 touchstart 冒泡收起路径
  // 保留为兜底（Android 蒙层黑洞下不触发，不冲突，见模板注释与 closeAddDrawerOnOutsideTouch）。
  /** 加号下缘视口坐标 y（fixed 蒙层内气泡顶部锚定，测量回调经 props 下发；-1=未测到用兜底位）。 */
  const addDrawerAnchorBottom = ref<number>(-1);
  /** 加号右缘距屏幕右缘间距（气泡 right 偏移；-1=未测到用兜底位）。 */
  const addDrawerAnchorRightGap = ref<number>(-1);
  /** 加号气泡是否展开：再点加号（toggle）/ 蒙层点外 / 返回键 / onHide 均置 false。 */
  const addDrawerVisible = ref<boolean>(false);
  // 加号按钮测量矩形（视口 px，开气泡时刷新）；left=-1 表示未测到（不排除加号区）。
  let plusRectLeft = -1;
  let plusRectTop = -1;
  let plusRectRight = -1;
  let plusRectBottom = -1;
  const addPlusOverlayStyle = ref<string>("right: 32px; top: 0px; width: 36px; height: 36px;");
  const addHeaderDismissOverlayStyle = ref<string>("left: 0px; top: 0px; right: 0px; height: 0px;");

  /** 蒙层点外关闭（iOS/H5 主路径）：点蒙层任意处收气泡。★Android 蒙层触摸为事件
   *  黑洞（原生层拦住不派发，2026-10-01 实测暂缓），点外暂只能靠返回键/菜单项收起。 */
  function handleAddMaskTap(): void {
    addDrawerVisible.value = false;
  }

  // 点外收起手势的吞击标志：收起当次手势稍后派生的 click 全吞（点外只关气泡，
  // 不穿透触发底下的行/tab/入口），下一次 touchstart（新手势）自动解除；
  // 经 pageTapSwallowed() 并入各 click 入口的既有守卫。
  // （长按浮层同款 rowMenuTouchSwallowed 已前移至行触摸判定态区——settleRowTouchEnd 要读）
  let addDrawerTouchSwallowed = false;

  /** 点外收起（兜底路径：主路径=蒙层 @tap，Android 黑洞下触摸到不了根不触发）：
      气泡已开时，漏到页面根的触摸（气泡自身已阻断冒泡，必在气泡外）在此收起并
      吞同手势 click（防穿透到底下行/tab/入口）。★落在加号矩形内除外：排除后本手势
      不收，紧随的 click 走 openAddDrawer 的 toggle 收起半程——若不排除，touchstart
      先关、同一次手势的 click 又把它打开，净效果=关不掉。 */
  function closeAddDrawerOnOutsideTouch(x: number, y: number): void {
    if (addDrawerVisible.value != true) {
      return;
    }
    if (
      plusRectLeft >= 0 &&
      x >= plusRectLeft &&
      x <= plusRectRight &&
      y >= plusRectTop &&
      y <= plusRectBottom
    ) {
      return;
    }
    addDrawerVisible.value = false;
    // 收起当次手势吞 click 防穿透（见标志声明处注释）
    addDrawerTouchSwallowed = true;
    // 该手势已被消费（只关气泡不穿透），行级 touchend 不再判为点击闪灰
    clearRowTouch();
  }

  const activeTab = ref<string>("chat");

  // ===== 会话列表状态 =====
  const conversations = ref<ImConvRow[]>([]);
  const convLoading = ref<boolean>(false);
  const convLoaded = ref<boolean>(false);
  const convFailed = ref<boolean>(false);
  const convHasMore = ref<boolean>(false);
  const convLoadingMore = ref<boolean>(false);
  const nextCursor = ref<string>("");
  // 双击「伙伴」tab 定位首条未读：行锚点（清空再赋值防连续同值不生效）+ 翻页封顶与重入标志
  const convScrollAnchor = ref<string>("");
  const RETAP_LOCATE_MAX_PAGES = 5;
  let retapLocating = false;

  /** 会话列表首拉加载态：首拉尚未成功（convLoaded）期间的在途请求，或「请求还没
   *  发出也还没失败」的间隙帧（loadConversations 守卫早退 / 刷新去抖窗）——进页
   *  先见「加载中」而非闪「暂无消息」。★整个表达式以 convLoaded != true 为前提：
   *  成功加载过一次后本值恒 false，静默刷新（WS 推送 / 回页 onShow 去抖）在途也
   *  不回闪加载态，空表保持「暂无消息」等回包落表（首版写成 convLoading || (…)
   *  漏了这层约束，登录后 WS 同步刷新照样二闪）。失败态显示不变；手点/自动重试
   *  起手即复位 convFailed（loadConversations），重试在途仍显示加载中。 */
  const convInitialLoading = computed<boolean>(
    (): boolean => convLoaded.value != true && (convLoading.value || convFailed.value != true),
  );

  // ===== 通讯录状态 =====
  const acceptedContacts = ref<ImContactRow[]>([]);
  const pendingInContacts = ref<ImContactRow[]>([]);
  const pendingOutContacts = ref<ImContactRow[]>([]);
  const contactLoading = ref<boolean>(false);
  const contactLoaded = ref<boolean>(false);
  const contactFailed = ref<boolean>(false);
  const contactDegraded = ref<boolean>(false);
  const contactTruncated = ref<boolean>(false);

  // 联系人展示名索引已抽至 im-row-helpers.uts（模块级私有 Map + rebuildContactNameIndex
  // /displayConvName 导出，Stage 1）；loadContacts 成功路径负责重建+联动整表刷新。

  const contactTotal = computed<number>(
    (): number =>
      acceptedContacts.value.length +
      pendingInContacts.value.length +
      pendingOutContacts.value.length,
  );

  /** 智联录 tab 角标：待我处理的好友申请数（status=2）；status=3 是我发出的申请
   *  （等对方处理，无需我动作）不计入。同意/拒绝成功后 loadContacts 整表重拉，
   *  本 computed 随 pendingInContacts 替换自动重算，角标即时增减。 */
  const contactPendingInCount = computed<number>(
    (): number => pendingInContacts.value.length,
  );

  // ===== 我的群组状态（智联录内折叠分类，与通讯录同生命周期）=====
  const myGroups = ref<ImConvRow[]>([]);
  const groupTotal = ref<number>(0);
  const groupsExpanded = ref<boolean>(false);
  const groupsLoading = ref<boolean>(false);
  const groupsLoaded = ref<boolean>(false);

  // ===== 我的团队状态（智联录内折叠分类，置于我的群组上方）=====
  const mySpaces = ref<ImSpaceRow[]>([]);
  const spaceTotal = ref<number>(0);
  const spacesExpanded = ref<boolean>(false);
  const spacesLoading = ref<boolean>(false);
  const spacesLoaded = ref<boolean>(false);

  // ===== 右上角「+」锚定气泡 / 创建群组・加入群组・添加伙伴子包页 + 扫一扫 =====
  const pageInstance = getCurrentInstance();
  // 页头组件 ref：加号测量经 $callMethod("measurePlus") 调起（Android 组件 ref 为
  // Gen* 类须走 $callMethod，scanLauncher/confirmModal 同款；矩形经 plus-rect 上抛）
  const headerTabsRef = ref<any | null>(null);
  // 消息 pane ref：会话行测量经 $callMethod("measureRow", domId) 调起（行节点在
  // conv-list-pane 内页面查不到；矩形经 row-rect 上抛，im-header-tabs 同机制）
  const convPaneRef = ref<any | null>(null);
  // 智联录 pane ref：group/contact 行测量同 conv 路由（$callMethod + row-rect 上抛）
  const contactPaneRef = ref<any | null>(null);
  const scanLauncherRef = ref<any | null>(null);
  const remarkSheetRef = ref<any | null>(null);
  const applyDetailSheetRef = ref<any | null>(null);
  const confirmModalRef = ref<any | null>(null);
  /** 气泡关闭后待接续的动作（跳子包页 / 拉起扫码）：串行接续，避免与气泡收起转场叠在一起 */
  let pendingSheetAfterDrawer = "";

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  // ===== 头像 / 图标展示地址解析（受保护 /api/f/ 与远程 SVG 统一经 resolveDisplayImageUrl）=====
  // 页面级正缓存 rawUrl→展示地址：onShow/WS 整表 reload 时同步命中回填，已出过的图不再闪回字母底；
  // 负缓存按原始 URL 记忆连续失败（有限重试耗尽后由 <image> @error 记入）：
  // reload 重建行对象后继承 avatarFailed，真正失败的头像稳定停在渐变字母底。
  // 已渲染缓存按原始 URL 记忆成功（<image> @load 记入）：reload 重建行对象后继承 avatarLoaded——
  // 行 key 不变时 Vue 复用 <image> 元素、正缓存同步回填的 src 无变化，@load 不会补发，
  // 不继承则字母底重新叠出（透明底头像重影回归）。
  const resolvedIconCache = new Map<string, string>();
  const failedIconUrls = new Set<string>();
  const renderedIconUrls = new Set<string>();
  // 覆盖安装后的首次冷启动可能遇到 token/网络/原生网络栈尚未稳定；
  // 受保护头像解析失败时延迟重试，避免一次瞬时失败被永久留在本页。
  let iconResolveRetryTimer = 0;
  let iconResolveRetryCount = 0;
  const MAX_ICON_RESOLVE_RETRIES = 3;
  let iconResolveRetryRunner: (() => void) | null = null;
  // <image> 原生加载瞬时失败时，按原始 URL 做少量重试；真正失败后才进入负缓存。
  const iconLoadRetryTimers = new Map<string, number>();
  const iconLoadRetryCounts = new Map<string, number>();
  const MAX_ICON_LOAD_RETRIES = 2;

  // 头像展示尺寸 AVATAR_DISPLAY_PX / 头像盒内联样式 avatarBoxStyle 已抽至
  // im-row-helpers.uts（Stage 1）；本文件模板经上方本地 const 包装使用。

  // ===== 页面手势活跃窗口（问题2：横滑切 tab 动画期不让定时器驱动的整表刷新抢帧）=====
  // touchstart 置位；touchend/cancel 后 400ms 复位（盖住 swiper 300ms 切页动画尾部）。
  // 只影响 timer 驱动刷新的重排（图标表/WS 会话刷新/onShow 去抖刷新），load 照发仅
  // 延后、无数据丢失；直接赋值与 WS 本地 bump 不受影响（延迟 bump 会基于未落表的
  // 旧数组构建列表→丢消息，故不做）。3s 绝对自清兜底 touchend/cancel 全漏的异常，
  // 防刷新永停。声明须早于 runIconTableRefresh/scheduleConvRefresh/scheduleShowRefresh
  // 与触摸处理器（UTS 不提升，前向引用报 error18）。
  let pageTouchActive = false;
  let pageTouchIdleTimer = 0;
  let pageTouchHardTimer = 0;

  function markPageTouchActive(): void {
    pageTouchActive = true;
    if (pageTouchHardTimer != 0) clearTimeout(pageTouchHardTimer);
    pageTouchHardTimer = setTimeout(() => {
      pageTouchHardTimer = 0;
      pageTouchActive = false;
    }, 3000);
  }

  function armPageTouchIdleClear(): void {
    if (pageTouchIdleTimer != 0) clearTimeout(pageTouchIdleTimer);
    pageTouchIdleTimer = setTimeout(() => {
      pageTouchIdleTimer = 0;
      pageTouchActive = false;
    }, 400);
  }

  // Android 不追踪 ref 数组内实例属性的原地变更（465b0bee3 dnd 同款平台缺陷）：
  // 异步解析回填 avatarDisplay 后 v-for 行不重渲，冷启动消息列表全停在字母底，
  // 直到某次整表重建（重进页/WS 刷新）缓存同步命中才出图。回填后去抖合并一次
  // 整表重建赋值强制重渲（key 稳定元素复用，iOS/H5 无副作用）。
  let iconTableRefreshTimer = 0;

  function copyRows<T>(rows: T[]): T[] {
    const out: T[] = [];
    for (let i = 0; i < rows.length; i++) {
      out.push(rows[i]);
    }
    return out;
  }

  function runIconTableRefresh(): void {
    iconTableRefreshTimer = 0;
    if (messagePageDisposed) return;
    // 手势活跃窗口内重排到动画后（问题2；3s 自清兜底防永停）
    if (pageTouchActive) {
      iconTableRefreshTimer = setTimeout(() => { runIconTableRefresh(); }, 300);
      return;
    }
    // 隐藏/后台不整表替换（问题1/3）：隐藏期异步解析的头像原地回填与「x分钟前」
    // 相对时间，由回页 onShow 的 scheduleIconTableRefresh 兜底刷出（onShow 先置
    // visible 再调度，此处守卫不会误伤回页首刷）
    if (!messagePageVisible || isAppInBackground()) return;
    // ★会话行内容已抽 conv-row-item（按对象身份跳过重渲染）：头像回填/相对时间这类
    // 原位改字段的显示刷新必须换行身份——深克隆整表；智联录行未组件化，浅拷即可
    conversations.value = cloneConvRows(conversations.value);
    acceptedContacts.value = copyRows(acceptedContacts.value);
    pendingInContacts.value = copyRows(pendingInContacts.value);
    pendingOutContacts.value = copyRows(pendingOutContacts.value);
    myGroups.value = copyRows(myGroups.value);
    mySpaces.value = copyRows(mySpaces.value);
  }

  function scheduleIconTableRefresh(): void {
    if (iconTableRefreshTimer != 0) return;
    iconTableRefreshTimer = setTimeout(() => { runIconTableRefresh(); }, 50);
  }

  function scheduleIconResolveRetry(delayMs: number = 1000): void {
    if (iconResolveRetryTimer != 0 || iconResolveRetryCount >= MAX_ICON_RESOLVE_RETRIES) {
      return;
    }
    iconResolveRetryCount += 1;
    iconResolveRetryTimer = setTimeout(() => {
      iconResolveRetryTimer = 0;
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) {
        return;
      }
      const runner = iconResolveRetryRunner;
      if (runner != null) {
        runner();
      }
    }, delayMs);
  }

  /**
   * 解析并回填单个头像/图标地址（apply 收可直接绑定给 <image> 的地址）。
   * ★rows 须取自 ref 数组（响应式代理实例），异步写入才会触发渲染刷新（chat.uvue resolveRowMedia 同款）。
   */
  function resolveIconInto(rawUrl: string, apply: (resolved: string) => void): void {
    if (rawUrl.length == 0 || failedIconUrls.has(rawUrl)) {
      return;
    }
    const cached = resolvedIconCache.get(rawUrl);
    if (cached != null) {
      apply(cached);
      return;
    }
    resolveDisplayImageUrl(rawUrl, AVATAR_DISPLAY_PX, AVATAR_DISPLAY_PX)
      .then((resolved: string): void => {
        if (messagePageDisposed || messagePageSession != getImSessionStamp()) {
          releaseDisplayImageUrl(resolved);
          return;
        }
        // resolveDisplayImageUrl 在受保护资源失败时会回退原 URL。
        // 原 URL 没有鉴权，直接绑定只会再次触发 401/error；不要把它当正缓存，
        // 给冷启动的 token/网络初始化留出有限重试机会。
        if (
          resolved == rawUrl &&
          (isAuthProtectedFileUrl(rawUrl)
            // App 原生 SVG 需要先下载改尺寸；失败时不能把原地址当成成功结果缓存。
            // #ifdef APP-ANDROID || APP-IOS
            || isRemoteSvgUrl(rawUrl)
            // #endif
          )
        ) {
          // App SVG 失败后工具层有 5 秒负缓存，页面重试需稍晚于该窗口；
          // 普通受保护位图仍按 1/2/3 秒快速重试。
          let retryDelayMs = 1000;
          // #ifdef APP-ANDROID || APP-IOS
          if (isRemoteSvgUrl(rawUrl)) {
            retryDelayMs = 5500;
          }
          // #endif
          scheduleIconResolveRetry(retryDelayMs);
          return;
        }
        if (resolved.length > 0) {
          resolvedIconCache.set(rawUrl, resolved);
          apply(resolved);
          // 仅异步路径需要：同步缓存命中与整表赋值同 tick，首帧已带上
          scheduleIconTableRefresh();
        }
      })
      .catch((_e: any | null): void => {
        // 解析器通常会把失败回退成原地址；这里保留静默兜底，
        // 真实加载失败仍由 @error 负责落到字母/默认群图。
      });
  }

  /** 会话/群组行批量解析（跳过已回填行，loadMore 追加后整表重调安全）。 */
  function resolveConvRowsIcons(rows: ImConvRow[]): void {
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      if (row.avatarUrl.length == 0 || row.avatarDisplay.length > 0) {
        continue;
      }
      resolveIconInto(row.avatarUrl, (resolved: string): void => {
        row.avatarDisplay = resolved;
      });
    }
  }

  /** 联系人行批量解析（新的伙伴申请 / 已申请 / 正常联系人三个列表共用）。 */
  function resolveContactRowsIcons(rows: ImContactRow[]): void {
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      if (row.avatarUrl.length == 0 || row.avatarDisplay.length > 0) {
        continue;
      }
      resolveIconInto(row.avatarUrl, (resolved: string): void => {
        row.avatarDisplay = resolved;
      });
    }
  }

  /** 团队行批量解析（icon 字段）。 */
  function resolveSpaceRowsIcons(rows: ImSpaceRow[]): void {
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      if (row.icon.length == 0 || row.iconDisplay.length > 0) {
        continue;
      }
      resolveIconInto(row.icon, (resolved: string): void => {
        row.iconDisplay = resolved;
      });
    }
  }

  iconResolveRetryRunner = (): void => {
    resolveConvRowsIcons(conversations.value);
    resolveContactRowsIcons(acceptedContacts.value);
    resolveContactRowsIcons(pendingInContacts.value);
    resolveContactRowsIcons(pendingOutContacts.value);
    resolveConvRowsIcons(myGroups.value);
    resolveSpaceRowsIcons(mySpaces.value);
  };

  function resetRowsForIconRetry(rawUrl: string): void {
    for (let i = 0; i < conversations.value.length; i++) {
      const row = conversations.value[i];
      if (row.avatarUrl == rawUrl) {
        row.avatarDisplay = "";
        row.avatarLoaded = false;
        row.avatarFailed = false;
      }
    }
    for (let i = 0; i < acceptedContacts.value.length; i++) {
      const row = acceptedContacts.value[i];
      if (row.avatarUrl == rawUrl) {
        row.avatarDisplay = "";
        row.avatarLoaded = false;
        row.avatarFailed = false;
      }
    }
    for (let i = 0; i < pendingInContacts.value.length; i++) {
      const row = pendingInContacts.value[i];
      if (row.avatarUrl == rawUrl) {
        row.avatarDisplay = "";
        row.avatarLoaded = false;
        row.avatarFailed = false;
      }
    }
    for (let i = 0; i < pendingOutContacts.value.length; i++) {
      const row = pendingOutContacts.value[i];
      if (row.avatarUrl == rawUrl) {
        row.avatarDisplay = "";
        row.avatarLoaded = false;
        row.avatarFailed = false;
      }
    }
    for (let i = 0; i < myGroups.value.length; i++) {
      const row = myGroups.value[i];
      if (row.avatarUrl == rawUrl) {
        row.avatarDisplay = "";
        row.avatarLoaded = false;
        row.avatarFailed = false;
      }
    }
    for (let i = 0; i < mySpaces.value.length; i++) {
      const row = mySpaces.value[i];
      if (row.icon == rawUrl) {
        row.iconDisplay = "";
        row.iconLoaded = false;
        row.iconFailed = false;
      }
    }
    scheduleIconTableRefresh();
  }

  function retryIconAfterLoadError(rawUrl: string): void {
    if (rawUrl.length == 0 || messagePageDisposed || messagePageSession != getImSessionStamp()) {
      return;
    }
    const existingTimer = iconLoadRetryTimers.get(rawUrl);
    if (existingTimer != null) {
      return;
    }
    const currentCount = iconLoadRetryCounts.get(rawUrl) ?? 0;
    if (currentCount >= MAX_ICON_LOAD_RETRIES) {
      failedIconUrls.add(rawUrl);
      return;
    }
    iconLoadRetryCounts.set(rawUrl, currentCount + 1);
    failedIconUrls.delete(rawUrl);
    renderedIconUrls.delete(rawUrl);
    const cached = resolvedIconCache.get(rawUrl);
    if (cached != null) {
      releaseDisplayImageUrl(cached);
      resolvedIconCache.delete(rawUrl);
    }
    resetRowsForIconRetry(rawUrl);
    const delayMs = 1000 * (currentCount + 1);
    const timer = setTimeout(() => {
      iconLoadRetryTimers.delete(rawUrl);
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) {
        return;
      }
      const runner = iconResolveRetryRunner;
      if (runner != null) {
        runner();
      }
    }, delayMs);
    iconLoadRetryTimers.set(rawUrl, timer);
  }

  function markIconLoaded(rawUrl: string): void {
    if (rawUrl.length == 0) return;
    const timer = iconLoadRetryTimers.get(rawUrl);
    if (timer != null) {
      clearTimeout(timer);
      iconLoadRetryTimers.delete(rawUrl);
    }
    iconLoadRetryCounts.delete(rawUrl);
    failedIconUrls.delete(rawUrl);
  }

  function readConvRow(obj: UTSJSONObject, directAvatar: boolean): ImConvRow {
    const row = new ImConvRow();
    row.convId = readString(obj, "convId");
    row.convType = readNumber(obj, "convType", 1);
    row.peerUserId = readString(obj, "peerUserId");
    const name = readString(obj, "name");
    const peerName = readString(obj, "peerName");
    const avatar = readString(obj, "avatar");
    const peerAvatar = readString(obj, "peerAvatar");
    // 单聊 name 恒为 null（服务端约定），展示名用 peerName；群聊用 name。
    if (row.convType == 1) {
      row.displayName = peerName.length > 0 ? peerName : name;
      row.avatarUrl = peerAvatar.length > 0 ? peerAvatar : avatar;
    } else {
      row.displayName = name.length > 0 ? name : peerName;
      row.avatarUrl = avatar;
    }
    // ★实验（2026-10-08，仅消息列表）：受保护 /api/f/ 头像直连原始地址——后端确认
    // 登录态（Cookie 会话）下 /api/f/ 可直接访问，<image> 请求自动带 Cookie（带不了
    // Bearer 才有原先的换链机制）。directAvatar 时首帧即绑原地址，绕开
    // resolveDisplayImageUrl 的 Bearer 拉取换 blob/temp；失败（401 JSON→ORB / Cookie
    // 未命中）由 @error 走原有字母兜底 + 有限重试。远程 SVG 例外：App 端 1:1 光栅化
    // 裁切与鉴权无关，仍走 resolveConvRowsIcons 的尺寸改写解析。
    // 「我的群组」共用本函数但传 false，保持原解析路径（本实验只改消息列表）。
    if (directAvatar && row.avatarUrl.length > 0 && !isRemoteSvgUrl(row.avatarUrl)) {
      row.avatarDisplay = row.avatarUrl;
    }
    // unreadCount：服务端没算时键整个不存在（非 0），整表刷新下只能按 0 展示。
    row.unreadCount = readNumber(obj, "unreadCount", 0);
    row.lastMsgAt = readNumber(obj, "lastMsgAt", 0);
    // memberCount：群聊行在智联录「我的群组」里展示
    row.memberCount = readNumber(obj, "memberCount", 0);
    // myRole：1=成员 2=管理员 3=群主；仅群聊行有意义（群主徽章）
    row.myRole = readNumber(obj, "myRole", 1);
    row.lastMsgDigest = readString(obj, "lastMsgDigest");
    row.topFlag = readBool(obj, "topFlag");
    row.dnd = readBool(obj, "dnd");
    // 整表 reload 重建行对象：负缓存继承失败态（失败头像不重走加载防反复闪）；
    // 已渲染缓存继承成功态（复用的 <image> 不补发 @load，防字母底重影回归）
    row.avatarLoaded = renderedIconUrls.has(row.avatarUrl);
    row.avatarFailed = failedIconUrls.has(row.avatarUrl);
    return row;
  }

  function readContactRow(obj: UTSJSONObject): ImContactRow {
    const row = new ImContactRow();
    row.userId = readString(obj, "userId");
    row.subjectType = readNumber(obj, "subjectType", 1);
    row.status = readNumber(obj, "status", 1);
    // displayName 服务端已按 remark > nickName > userName 算好，仅在缺键时逐级回落。
    const display = readString(obj, "displayName");
    const nickName = readString(obj, "nickName");
    row.displayName = display.length > 0 ? display : nickName;
    row.avatarUrl = readString(obj, "avatar");
    row.remark = readString(obj, "remark");
    // 申请附言（仅 status=2/3 有值；服务端已截断 100 字，客户端不再截）
    row.applyMsg = readString(obj, "applyMsg");
    // reload 重建行对象：继承已渲染/失败态（语义同 readConvRow）
    row.avatarLoaded = renderedIconUrls.has(row.avatarUrl);
    row.avatarFailed = failedIconUrls.has(row.avatarUrl);
    return row;
  }

  function readSpaceRow(obj: UTSJSONObject): ImSpaceRow {
    const row = new ImSpaceRow();
    row.spaceId = readString(obj, "spaceId");
    row.name = readString(obj, "name");
    row.description = readString(obj, "description");
    row.icon = readString(obj, "icon");
    row.type = readString(obj, "type");
    row.currentUserRole = readString(obj, "currentUserRole");
    // reload 重建行对象：继承已渲染/失败态（语义同 readConvRow）
    row.iconLoaded = renderedIconUrls.has(row.icon);
    row.iconFailed = failedIconUrls.has(row.icon);
    return row;
  }

  /** 已解散群（status=2）：「消息」列表按后端 DEV-165 设计保留展示（用户左滑删除会话自清），
      仅「我的群组」过滤（服务端 isUsable 已滤，此处兜底）。 */
  function isDisbandedConvRecord(obj: UTSJSONObject): boolean {
    return readNumber(obj, "status", 1) == 2;
  }

  /** 会话列表排序（消息 tab）：置顶区（组内 lastMsgAt 降序）→ 草稿区（非置顶且
   *  有草稿的行整体浮在置顶区后，最近编辑的在前）→ 其余（保持传入序=服务端
   *  update_time 降序）。置顶区对齐 PC convOrder.ts DEV-227「置顶优先 → lastMsgAt
   *  降序」；草稿浮顶是 App 端独立增强（PC 无此规则）。parseConvRecords 全量解析、
   *  loadMore 追加后、从聊天页返回时的本地即时重排共用本规则，保证三种路径同序。 */
  function reorderConvRows(rows: ImConvRow[]): ImConvRow[] {
    const pinned: ImConvRow[] = [];
    const drafts: ImConvRow[] = [];
    const normal: ImConvRow[] = [];
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].topFlag) {
        pinned.push(rows[i]);
      } else if (getChatDraft(rows[i].convId).length > 0) {
        drafts.push(rows[i]);
      } else {
        normal.push(rows[i]);
      }
    }
    pinned.sort((a: ImConvRow, b: ImConvRow): number => {
      return b.lastMsgAt - a.lastMsgAt;
    });
    drafts.sort((a: ImConvRow, b: ImConvRow): number => {
      return chatDraftRecency(b.convId) - chatDraftRecency(a.convId);
    });
    const merged: ImConvRow[] = [];
    for (let i = 0; i < pinned.length; i++) {
      merged.push(pinned[i]);
    }
    for (let i = 0; i < drafts.length; i++) {
      merged.push(drafts[i]);
    }
    for (let i = 0; i < normal.length; i++) {
      merged.push(normal[i]);
    }
    return merged;
  }

  function parseConvRecords(res: RequestResponse<any>): ImConvRow[] {
    const rows: ImConvRow[] = [];
    const dataRaw = apiResData<any>(res);
    const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
    if (dataObj == null) {
      return rows;
    }
    const recordsRaw = dataObj["records"];
    if (recordsRaw != null) {
      const records = recordsRaw as UTSJSONObject[];
      for (let i = 0; i < records.length; i++) {
        rows.push(readConvRow(records[i], true));
      }
    }
    const cursorRaw = dataObj["nextCursor"];
    nextCursor.value = cursorRaw != null ? `${cursorRaw}` : "";
    return reorderConvRows(rows);
  }

  /**
   * 群组分页解析：★cursor 语义与 /conversations 不同（可见集不同，不能混用），
   * 故不复用 parseConvRecords。服务端 total 实测返回 -1（未统计），分组头计数回落到本页条数。
   */
  function parseGroupRecords(res: RequestResponse<any>): ImConvRow[] {
    const rows: ImConvRow[] = [];
    const dataRaw = apiResData<any>(res);
    const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
    if (dataObj == null) {
      return rows;
    }
    const recordsRaw = dataObj["records"];
    if (recordsRaw != null) {
      const records = recordsRaw as UTSJSONObject[];
      for (let i = 0; i < records.length; i++) {
        if (isDisbandedConvRecord(records[i])) {
          continue;
        }
        rows.push(readConvRow(records[i], false));
      }
    }
    const totalRaw = readNumber(dataObj, "total", 0);
    // 实测 dev 环境返回 total:-1（未统计），此时以本页条数计数（单页 limit=100 足够覆盖）。
    groupTotal.value = totalRaw > 0 ? totalRaw : rows.length;
    return rows;
  }

  function scheduleConvRefresh(): void {
    convRefreshOwed = true;
    if (messagePageDisposed || messagePageSession != getImSessionStamp() || !messagePageVisible || isAppInBackground() || convRefreshTimer != 0) return;
    convRefreshTimer = setTimeout(() => {
      convRefreshTimer = 0;
      if (messagePageDisposed || messagePageSession != getImSessionStamp() || !messagePageVisible || isAppInBackground()) return;
      // 手势活跃窗口内重排到动画后再拉（问题2；owed 已置位，重排走全守卫原路径）。
      // ★回调内先归零再进调度：scheduleConvRefresh 入口守卫要求 timer==0 才武装，
      //  直接调会因本变量仍持有已触发 timer 的旧 id 而早退，刷新静默丢失
      if (pageTouchActive) {
        convRefreshTimer = setTimeout(() => {
          convRefreshTimer = 0;
          scheduleConvRefresh();
        }, 300);
        return;
      }
      const runner = convRefreshRunner;
      if (runner != null) runner();
    }, 500);
  }

  // 头像兜底取字引擎（渐变板/取字规则/列表去重回填）已整体抽至 im-row-helpers.uts（Stage 1）。

  // ===== 会话列表首拉失败有限自动重试（头像解析同款配方）：冷启动网络栈未稳 /
  //       IM 网关瞬态 5xx 不该把用户晾在「加载失败」——列表仍空时延迟重试，连续
  //       失败封顶后停（保留手点重试与 onShow 自愈）。有数据的静默刷新失败不
  //       重试（列表仍在屏，onShow/WS 路径自会再刷）。=====
  let convLoadRetryTimer = 0;
  let convLoadRetryCount = 0;
  const MAX_CONV_LOAD_RETRIES = 2;

  function scheduleConvLoadRetry(): void {
    if (convLoadRetryTimer != 0 || convLoadRetryCount >= MAX_CONV_LOAD_RETRIES) {
      return;
    }
    if (conversations.value.length > 0) {
      return;
    }
    convLoadRetryCount += 1;
    convLoadRetryTimer = setTimeout(() => {
      convLoadRetryTimer = 0;
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) {
        return;
      }
      if (conversations.value.length > 0 || convLoading.value) {
        return;
      }
      const runner = convLoadRetryRunner;
      if (runner != null) runner();
    }, 1500);
  }

  async function loadConversations(): Promise<void> {
    // 工作商业版未授权：会话列表请求不出（闸门见 workGateBlocked 声明处）
    if (workGateBlocked.value) return;
    if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
    if (convLoading.value || convLoadingMore.value) {
      convRefreshOwed = true;
      return;
    }
    convRefreshOwed = false;
    const revision = convRevision;
    if (!hasLoginSession()) {
      // App / 小程序：storage token 是唯一登录态形态，缺失即纯匿名（无 token、
      // 无 Cookie 会话），不再静默渲染「暂无消息」空态——对齐 App launch 分流
      // 语义直接去登录页（redirectToLoginOnce 去重，防 onShow 重复触发）。
      // #ifdef APP
      redirectToLoginOnce(LOGIN_PAGE_PATH);
      convLoaded.value = true;
      return;
      // #endif
      // #ifdef MP-WEIXIN
      redirectToLoginOnce(LOGIN_WEIXIN_PAGE_PATH);
      convLoaded.value = true;
      return;
      // #endif
      // H5 / WEB 不拦截：生产浏览器登录态是服务端 Set-Cookie 下发的 ticket 会话，
      // HttpOnly / path 限定 / 后端改名都会让 document.cookie 读不到（本地无法
      // 证伪有效会话，hasLoginSession 的 cookie 回退只是尽力而为）。放行请求，
      // 真匿名由 useRequest 4010 链路踢登录——与任务/专家/应用/我的页
      // 「无条件发请求」口径一致；拦了反而会把 Cookie 登录用户踢成登录循环。
    }
    convLoading.value = true;
    convFailed.value = false;
    try {
      const res = await apiImConversations("", CONV_PAGE_SIZE);
      // 先复位 loading 再做废弃守卫：会话戳中途变化（登录/换 token）早退时，
      // 卡死的 convLoading=true 会让后续所有刷新进 loading 守卫早退、列表永停「加载中」
      convLoading.value = false;
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (messagePageDisposed || messagePageSession != getImSessionStamp() || revision != convRevision) {
        scheduleConvRefresh();
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        convFailed.value = true;
        scheduleConvLoadRetry();
        return;
      }
      conversations.value = parseConvRecords(res);
      resolveConvRowsIcons(conversations.value);
      assignConvFallbacks(conversations.value);
      convHasMore.value = nextCursor.value.length > 0;
      convLoaded.value = true;
      convLoadRetryCount = 0;
      // 列表缓存回写（首页 records 原文 + nextCursor；同串跳写，翻页不写）
      saveImConvCache(res);
    } catch (_error) {
      convLoading.value = false;
      convFailed.value = true;
      scheduleConvLoadRetry();
    } finally {
      if (convRefreshOwed) scheduleConvRefresh();
    }
  }

  convRefreshRunner = (): void => { loadConversations(); };
  convLoadRetryRunner = (): void => { loadConversations(); };

  async function loadMoreConversations(): Promise<void> {
    if (messagePageDisposed || convLoading.value || convHasMore.value != true || convLoadingMore.value) {
      return;
    }
    if (nextCursor.value.length == 0) {
      return;
    }
    const revision = convRevision;
    convLoadingMore.value = true;
    try {
      const res = await apiImConversations(nextCursor.value, CONV_PAGE_SIZE);
      // 先复位 loading 再守卫（同 loadConversations：防会话戳变化早退卡死翻页态）
      convLoadingMore.value = false;
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (messagePageDisposed || messagePageSession != getImSessionStamp() || revision != convRevision) {
        scheduleConvRefresh();
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const rows = parseConvRecords(res);
      // 追加后整表重排：新页里带草稿/置顶的行不能滞留表尾（分区不变式跨页成立）
      const merged: ImConvRow[] = copyRows(conversations.value);
      // convId 去重：缓存水合的 nextCursor 可能落后服务端头，翻页会带回已展示行
      //（服务端游标边界重复同防），重复行直接跳过
      const seen = new Set<string>();
      for (let i = 0; i < conversations.value.length; i++) {
        seen.add(conversations.value[i].convId);
      }
      for (let i = 0; i < rows.length; i++) {
        if (seen.has(rows[i].convId)) {
          continue;
        }
        seen.add(rows[i].convId);
        merged.push(rows[i]);
      }
      conversations.value = reorderConvRows(merged);
      // 追加行统一解析（helper 跳过已回填行，直接传整表安全）
      resolveConvRowsIcons(conversations.value);
      // 取字整表重算（去重 map 重建，顺序稳定：loadMore 追加行参与同列表去重）
      assignConvFallbacks(conversations.value);
      convHasMore.value = nextCursor.value.length > 0;
    } catch (_error) {
      convLoadingMore.value = false;
    } finally {
      if (convRefreshOwed) scheduleConvRefresh();
    }
  }

  async function loadContacts(): Promise<void> {
    // 工作商业版未授权：联系人请求不出（含 WS CONTACT_UPDATE 驱动的重拉）
    if (workGateBlocked.value) return;
    if (contactLoading.value) {
      return;
    }
    if (!hasLoginSession()) {
      // App / 小程序 token 缺失即纯匿名，不发包；H5 放行请求由 4010 兜底
      //（Cookie 可读性不保证，口径见 loadConversations 闸门说明）
      // #ifndef H5 || WEB
      contactLoaded.value = true;
      return;
      // #endif
    }
    contactLoading.value = true;
    contactFailed.value = false;
    try {
      const res = await apiImContacts();
      // 先复位 loading 再守卫（同 loadConversations：防会话戳变化早退卡死加载态）
      contactLoading.value = false;
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        contactFailed.value = true;
        return;
      }
      const accepted: ImContactRow[] = [];
      const pendingIn: ImContactRow[] = [];
      const pendingOut: ImContactRow[] = [];
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        contactDegraded.value = readBool(dataObj, "degraded");
        contactTruncated.value = readBool(dataObj, "truncated");
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const row = readContactRow(items[i]);
            if (row.status == 2) {
              pendingIn.push(row);
            } else if (row.status == 3) {
              pendingOut.push(row);
            } else {
              accepted.push(row);
            }
          }
        }
      }
      acceptedContacts.value = accepted;
      pendingInContacts.value = pendingIn;
      pendingOutContacts.value = pendingOut;
      // 组件化（Stage 1 起）联系人表变化不再天然触发会话行重渲染：靠整表重建会话行
      // 刷新 displayConvName（Android 方法绑定不收集依赖，displayConvName 读模块级
      // 索引）。WS 联系人推送、备注修改后刷新均走本路径；★索引没变（onShow 静默刷新
      // 名字全没动）则跳过，不多余重渲染会话 pane。
      if (rebuildContactNameIndex(acceptedContacts.value)) {
        conversations.value = copyRows(conversations.value);
      }
      // 页内智联录 tab 角标随上面赋值自动重算（tabBar 伙伴角标 = total，后端口径）
      resolveContactRowsIcons(acceptedContacts.value);
      resolveContactRowsIcons(pendingInContacts.value);
      resolveContactRowsIcons(pendingOutContacts.value);
      assignContactFallbacks(acceptedContacts.value);
      assignContactFallbacks(pendingInContacts.value);
      assignContactFallbacks(pendingOutContacts.value);
      contactLoaded.value = true;
      // 列表缓存回写（全量 items 原文 + degraded/truncated）
      saveImContactsCache(res);
    } catch (_error) {
      contactLoading.value = false;
      contactFailed.value = true;
    }
  }

  /** 群组页大小：服务端 clamp 到 [1,100]，智联录分类单页拉满，免分页 UI（群组数超 100 再补分页）。 */
  const GROUP_PAGE_SIZE = 100;

  async function loadGroups(): Promise<void> {
    // 工作商业版未授权：群组请求不出（闸门见 workGateBlocked 声明处）
    if (workGateBlocked.value) return;
    if (groupsLoading.value) {
      return;
    }
    if (!hasLoginSession()) {
      // 同 loadContacts：App / 小程序不发包，H5 放行请求由 4010 兜底
      // #ifndef H5 || WEB
      groupsLoaded.value = true;
      return;
      // #endif
    }
    groupsLoading.value = true;
    try {
      const res = await apiImMyGroups("", GROUP_PAGE_SIZE);
      // 先复位 loading 再守卫（同 loadConversations：防会话戳变化早退卡死加载态）
      groupsLoading.value = false;
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        // 失败静默：分类不展示，下次切入智联录自动重试
        return;
      }
      myGroups.value = parseGroupRecords(res);
      resolveConvRowsIcons(myGroups.value);
      assignConvFallbacks(myGroups.value);
      groupsLoaded.value = true;
      // 列表缓存回写（records 原文 + total）
      saveImGroupsCache(res);
    } catch (_error) {
      groupsLoading.value = false;
    }
  }

  /** 团队列表（spaces 全量无分页；失败静默：分类不展示，下次切入智联录自动重试）。 */
  async function loadSpaces(): Promise<void> {
    // 工作商业版未授权：团队请求不出（闸门见 workGateBlocked 声明处）
    if (workGateBlocked.value) return;
    if (spacesLoading.value) {
      return;
    }
    if (!hasLoginSession()) {
      // 同 loadContacts：App / 小程序不发包，H5 放行请求由 4010 兜底
      // #ifndef H5 || WEB
      spacesLoaded.value = true;
      return;
      // #endif
    }
    spacesLoading.value = true;
    try {
      const res = await apiImSpaces();
      // 先复位 loading 再守卫（同 loadConversations：防会话戳变化早退卡死加载态）
      spacesLoading.value = false;
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const rows: ImSpaceRow[] = [];
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const row = readSpaceRow(items[i]);
            if (row.spaceId.length > 0) {
              rows.push(row);
            }
          }
        }
      }
      mySpaces.value = rows;
      resolveSpaceRowsIcons(mySpaces.value);
      assignSpaceFallbacks(mySpaces.value);
      spaceTotal.value = rows.length;
      spacesLoaded.value = true;
      // 列表缓存回写（全量 items 原文）
      saveImSpacesCache(res);
    } catch (_error) {
      spacesLoading.value = false;
    }
  }

  // ===== 工作商业版闸门函数（声明在四个 load 之后：UTS 不提升声明）=====

  /** 闸门判定为未授权：停 WS + 清 tab 未读角标（对齐 PC 授权撤销即卸载微应用）。幂等。 */
  function applyWorkGateBlocked(): void {
    workGatePending.value = false;
    if (workGateBlocked.value) {
      return;
    }
    workGateBlocked.value = true;
    stopImWsClient();
    clearImUnreadBadge();
  }

  // ===== 列表缓存水合（stale-while-revalidate，imListCache.uts）=====
  // 命中即整表落对应 ref 并置 loaded：加载态随之切到「静默刷新」语义
  //（convInitialLoading 等 computed 恒 false，不闪「加载中」），随后 loadXxx 回包
  // 整表替换为服务端真值（无合并逻辑）。守卫照抄 loadXxx + 已有数据早退（幂等）。

  function hydrateConversationsFromCache(): void {
    if (workGateBlocked.value) return;
    if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
    if (convLoaded.value || conversations.value.length > 0) return;
    const cached = readImConvCache();
    if (cached == null) return;
    const rows: ImConvRow[] = [];
    for (let i = 0; i < cached.records.length; i++) {
      rows.push(readConvRow(cached.records[i], true));
    }
    conversations.value = reorderConvRows(rows);
    resolveConvRowsIcons(conversations.value);
    assignConvFallbacks(conversations.value);
    // 翻页游标一并水合：水合态下上滑直接续翻（陈旧 cursor 带回的重复行由
    // loadMoreConversations 的 convId 去重挡掉），刷新成功即被服务端真值重置
    nextCursor.value = cached.nextCursor;
    convHasMore.value = cached.nextCursor.length > 0;
    convLoaded.value = true;
  }

  function hydrateContactsFromCache(): void {
    if (workGateBlocked.value) return;
    if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
    if (contactLoaded.value || acceptedContacts.value.length > 0 || pendingInContacts.value.length > 0 || pendingOutContacts.value.length > 0) return;
    const cached = readImContactsCache();
    if (cached == null) return;
    const accepted: ImContactRow[] = [];
    const pendingIn: ImContactRow[] = [];
    const pendingOut: ImContactRow[] = [];
    for (let i = 0; i < cached.items.length; i++) {
      const row = readContactRow(cached.items[i]);
      if (row.status == 2) {
        pendingIn.push(row);
      } else if (row.status == 3) {
        pendingOut.push(row);
      } else {
        accepted.push(row);
      }
    }
    acceptedContacts.value = accepted;
    pendingInContacts.value = pendingIn;
    pendingOutContacts.value = pendingOut;
    contactDegraded.value = cached.degraded;
    contactTruncated.value = cached.truncated;
    // 展示名索引重建 + 会话行联动（对齐 loadContacts 成功路径：索引供会话行
    // displayConvName 读，Android 方法绑定不收集依赖须换行身份刷新）
    if (rebuildContactNameIndex(acceptedContacts.value)) {
      conversations.value = copyRows(conversations.value);
    }
    resolveContactRowsIcons(acceptedContacts.value);
    resolveContactRowsIcons(pendingInContacts.value);
    resolveContactRowsIcons(pendingOutContacts.value);
    assignContactFallbacks(acceptedContacts.value);
    assignContactFallbacks(pendingInContacts.value);
    assignContactFallbacks(pendingOutContacts.value);
    contactLoaded.value = true;
  }

  function hydrateGroupsFromCache(): void {
    if (workGateBlocked.value) return;
    if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
    if (groupsLoaded.value || myGroups.value.length > 0) return;
    const cached = readImGroupsCache();
    if (cached == null) return;
    const rows: ImConvRow[] = [];
    for (let i = 0; i < cached.records.length; i++) {
      if (isDisbandedConvRecord(cached.records[i])) {
        continue;
      }
      rows.push(readConvRow(cached.records[i], false));
    }
    myGroups.value = rows;
    // total 实测 -1=未统计，回落本页条数（parseGroupRecords 同款口径）
    groupTotal.value = cached.total > 0 ? cached.total : rows.length;
    resolveConvRowsIcons(myGroups.value);
    assignConvFallbacks(myGroups.value);
    groupsLoaded.value = true;
  }

  function hydrateSpacesFromCache(): void {
    if (workGateBlocked.value) return;
    if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
    if (spacesLoaded.value || mySpaces.value.length > 0) return;
    const cached = readImSpacesCache();
    if (cached == null) return;
    const rows: ImSpaceRow[] = [];
    for (let i = 0; i < cached.items.length; i++) {
      const row = readSpaceRow(cached.items[i]);
      if (row.spaceId.length > 0) {
        rows.push(row);
      }
    }
    mySpaces.value = rows;
    spaceTotal.value = rows.length;
    resolveSpaceRowsIcons(mySpaces.value);
    assignSpaceFallbacks(mySpaces.value);
    spacesLoaded.value = true;
  }

  /** 页面 onLoad 闸门：缓存优先、缺失拉一次租户配置；放行后补跑首拉（原 onLoad 直调的两个 load）。 */
  async function initWorkGate(): Promise<void> {
    const blocked = await resolveWorkCommercialBlocked();
    if (messagePageDisposed) {
      return;
    }
    if (blocked) {
      applyWorkGateBlocked();
      return;
    }
    workGatePending.value = false;
    if (workGateBlocked.value) {
      // 拉取期间 onShow 复查曾抢先拦下：恢复授权，重启 WS/角标（同 onShow 解锁分支）
      workGateBlocked.value = false;
      initImWsClient();
      refreshImUnreadBadge();
    }
    // 先水合再首拉：缓存命中秒出列表（加载态直接进静默刷新语义），网络照常整表替换
    //（onShow 复查可能已抢先解锁并补拉过：loadXxx 自带 loading 去重，水合已有数据早退，重复调用无害）
    hydrateConversationsFromCache();
    hydrateContactsFromCache();
    loadConversations();
    loadContacts();
  }

  /** 切 tab 落定（tab 点击与 swiper 横滑共用）。横滑抬手必置吞击位，走 switchTab 会被
   *  自己的守卫拦掉，故拆无守卫版供 swiper change 直调。 */
  function applyTabSwitch(tab: string): void {
    if (activeTab.value == tab) {
      return;
    }
    activeTab.value = tab;
    // 切 tab 收起长按浮层（气泡随 v-if 摘除、行高亮随 rowMenuVisible 摘除）
    if (rowMenuVisible.value) {
      rowMenuVisible.value = false;
    }
    // 智联录懒加载：联系人已随页面首拉（tab 角标需要「待我处理」数据），群组/团队首次切入时拉取。
    // 各分支先水合再照常 load（条件进 body 时已定，水合命中也不跳过请求）＝SWR：
    // 缓存秒出 + 静默刷新；水合失败/未命中则与原行为完全一致。
    if (tab == "contact") {
      if (contactLoaded.value != true) {
        hydrateContactsFromCache();
        loadContacts();
      }
      if (groupsLoaded.value != true) {
        hydrateGroupsFromCache();
        loadGroups();
      }
      if (spacesLoaded.value != true) {
        hydrateSpacesFromCache();
        loadSpaces();
      }
    }
  }

  // ===== 页面级触摸：吞击守卫（chat.uvue 同款；横滑切 tab 已交原生 swiper） =====
  // Android 上滑动手势的 touchup 可能被判定为 click：快速滑动列表/横滑切 tab 后手指落在
  // 行/tab/入口上会误进聊天页、误开弹层。页面级记录触摸位移，超阈值时短暂置吞击标志，
  // click 处理器首行用 pageTapSwallowed() 拦截（50ms 后自动失效，不影响后续正常点击）；
  // iOS 滑动不派生 click，守卫恒不触发，已验证交互零影响。
  let pageTouchStartX = 0;
  let pageTouchStartY = 0;
  /** 上次页面级 touchstart 时刻：冒泡去重用（见 handlePageTouchStart）。 */
  let pageTouchStartAt = 0;
  let pageTouchSwallowed = false;
  let pageTouchResetTimer = 0;

  function handlePageTouchStart(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) {
      return;
    }
    // 手势活跃窗口开启（问题2）：定时器驱动的整表刷新在此窗口内自动延后
    //（幂等：pane 与页面根的重复派发重复置位无副作用，见声明处注释）
    markPageTouchActive();
    // 冒泡去重：同一手势会先后打到 pane scroll-view 与页面根两处同名绑定（毫秒级内、
    // 坐标逐位相同）。不去重的话二次调用会把首次刚做的「收层+吞击决策」当新手势清掉
    // ——吞击位恒失效，点外收层后 click 穿透、浮层所属行闪灰即其症。40ms 内同坐标视为
    // 同次派发直接跳过（人手两次独立触屏间隔远大于此）。
    const touchStartAt = Date.now();
    if (
      touchStartAt - pageTouchStartAt <= 40 &&
      e.touches[0].clientX == pageTouchStartX &&
      e.touches[0].clientY == pageTouchStartY
    ) {
      return;
    }
    pageTouchStartAt = touchStartAt;
    pageTouchStartX = e.touches[0].clientX;
    pageTouchStartY = e.touches[0].clientY;
    // 新手势开始：解除上一手势（气泡/浮层点外收起）的吞击标志
    addDrawerTouchSwallowed = false;
    rowMenuTouchSwallowed = false;
    // 「+」气泡：页面任意触摸即收起（气泡内触摸已在组件根阻断冒泡，必在气泡外；
    // 加号区除外——排除后交给 click toggle，见函数注释）
    closeAddDrawerOnOutsideTouch(pageTouchStartX, pageTouchStartY);
    // 长按操作浮层（无蒙层）：任意页面触摸即收起（气泡内触摸已被气泡根 @touchstart.stop
    // 阻断冒泡，必在气泡外）。★不清判定态（clearRowTouch）：本手势若起在另一行上，行
    // touchstart 先冒泡到此、已装填 500ms 长按计时，此处清掉会把「浮层开着长按另一行换弹」
    // 连坐杀掉（群成员页原生 @longpress 天然可换弹，对齐之）；判定态清理由手势终结路径
    // 负责（touchend/cancel、move>6px、滚动接管 handleListScroll）。
    // 吞击位只给非行落点（列表空白/分组头/tab/+入口——点外只关浮层不穿透）；行落点不置：
    // 抬手由行路径按 rowTouchOnMenuOwner 快照决策——所属行=只收层（不进会话不闪灰），
    // 其余行=正常点按（进会话/联系人动作）。★行落点判定依据 touchingRowPending：行
    // touchstart 已先于本函数（冒泡序）执行并记好行 id。
    if (rowMenuVisible.value) {
      closeRowMenu();
      rowMenuTouchSwallowed = touchingRowPending.length == 0;
    }
  }

  /** 页面触摸结束：置吞击位（含 swiper 横滑抬手，防 Android 派生 click 误触行/入口）。
   *  ★须先于 handlePageTouchEnd/Cancel 声明（UTS 不提升，前向引用报 error18）。 */
  function finishPageTouch(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    if (e.changedTouches == null || e.changedTouches.length == 0) {
      return;
    }
    const tc = e.changedTouches[0];
    const dx = tc.clientX - pageTouchStartX;
    const dy = tc.clientY - pageTouchStartY;
    if (Math.abs(dx) <= 10 && Math.abs(dy) <= 10) {
      return;
    }
    pageTouchSwallowed = true;
    if (pageTouchResetTimer != 0) {
      clearTimeout(pageTouchResetTimer);
    }
    pageTouchResetTimer = setTimeout(() => {
      pageTouchResetTimer = 0;
      pageTouchSwallowed = false;
    }, 50);
  }

  function handlePageTouchEnd(eventValue: Any): void {
    // 手势活跃窗口收尾（问题2）：400ms 后复位（盖住 swiper 300ms 切页动画尾部）；
    // 无条件 arm（finishPageTouch 对位移≤10px 的点按提前 return，不能放它里面）
    armPageTouchIdleClear();
    finishPageTouch(eventValue);
  }

  /** 触摸被取消（Android 滚动/横滑接管/系统打断）：同样走吞击判定（cancel 不派生 click，
   *  实际无副作用，保持与 end 同路径简单）。 */
  function handlePageTouchCancel(eventValue: Any): void {
    armPageTouchIdleClear();
    finishPageTouch(eventValue);
  }

  // ===== swiper 横滑切 tab 即时提交（原 330ms+顺延延迟提交机制已撤，2026-10-17）=====
  // 历史根因（2026-10-16 真机 A/B 实锤）：change 在落定动画窗内同步写 activeTab →
  // 两个 pane 内联在根渲染里，数百行 v-for 全量重执行 → 动画冻住，故曾改为手势/
  // 滚动空闲窗顺延提交。pane 组件化（Stage 4/5）后 activeTab 根模板只剩两处轻量
  // 读取：swiper :current 同值 no-op 回写 + im-header-tabs 的 props（子组件重渲染
  // 只有页头），写它不再触碰两列表 → change 即时提交、高亮即时（顺延版高亮滞后
  // ~0.7s 真机仍可感）。收浮层与智联录首拉随提交即时触发，均轻量。

  /** 双页 swiper 横滑切 tab（专家页同款）：change 即时提交——activeTab 与 native
   *  页始终同步，快速往返的回程 applyTabSwitch 同值 no-op。 */
  function handleTabSwiperChange(e: UniSwiperChangeEvent): void {
    applyTabSwitch(e.detail.current == 1 ? "contact" : "chat");
  }

  /** click 入口守卫：true=本次 click 由滑动 touchup 派生、或「气泡/长按浮层点外收起」手势产生，应吞掉。 */
  function pageTapSwallowed(): boolean {
    return pageTouchSwallowed || addDrawerTouchSwallowed || rowMenuTouchSwallowed;
  }

  /** tab 点击：吞击守卫后立即落定 activeTab——swiper 的 :current 随之变化滑向目标页
   *  （重渲染发生在动画起点=原有行为）。 */
  function switchTab(tab: string): void {
    if (pageTapSwallowed()) {
      return;
    }
    applyTabSwitch(tab);
  }

  // 展示辅助纯函数已抽至 im-row-helpers.uts（Stage 1）；随 pane 组件化（Stage 4 起）
  // conv 侧包装已移除，此处仅剩智联录内联行仍用的本地 const 包装。

  /** 展开/折叠我的群组（默认折叠，对齐 PC 端智联录交互）。 */
  function toggleGroups(): void {
    if (pageTapSwallowed()) {
      return;
    }
    flashRowPressed("grp-head");
    groupsExpanded.value = !groupsExpanded.value;
  }

  /** 展开/折叠我的团队（默认折叠，交互同我的群组）。 */
  function toggleSpaces(): void {
    if (pageTapSwallowed()) {
      return;
    }
    flashRowPressed("sp-head");
    spacesExpanded.value = !spacesExpanded.value;
  }

  function handleConvScrollLower(): void {
    loadMoreConversations();
  }

  /** 首条未读会话（数组序即视觉序：置顶行已在解析端重排在前）。 */
  function findFirstUnreadConv(): ImConvRow | null {
    const list = conversations.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].unreadCount > 0) return list[i];
    }
    return null;
  }

  /** 定位到指定会话行：先清空再 nextTick 赋值，连续定位同一行也能生效（agent-union-record 同款）。 */
  function locateConvRow(convId: string): void {
    convScrollAnchor.value = "";
    nextTick(() => {
      convScrollAnchor.value = `row-${convId}`;
    });
  }

  /** 双击「伙伴」tab：定位首条未读会话；已加载列表没有则翻页找（封顶防请求风暴）。 */
  async function handleRetapLocateFirstUnread(): Promise<void> {
    if (retapLocating) return;
    // 长按操作浮层开着：先收浮层，本次不定位（浮层期间列表 direction=none 本也不可滚）
    if (rowMenuVisible.value) {
      closeRowMenu();
      return;
    }
    // 智联录页双击：先切回消息页；直调 applyTabSwitch（switchTab 的吞击守卫会拦掉
    // 程序调用；tab 提交已即时，activeTab 恒等于 native 页、无待提交态）
    const switchedFromContact = activeTab.value != "chat";
    if (switchedFromContact) applyTabSwitch("chat");
    retapLocating = true;
    try {
      let found = findFirstUnreadConv();
      let pages = 0;
      while (found == null && convHasMore.value && pages < RETAP_LOCATE_MAX_PAGES) {
        const before = conversations.value.length;
        await loadMoreConversations();
        pages++;
        // 无进展：请求失败 / 被并发加载挡下 / 翻完 → 退出，防重试轰炸
        if (conversations.value.length == before) break;
        found = findFirstUnreadConv();
      }
      if (found == null) return;
      // 按 convId 锚点：翻页期间 WS 可能就地改未读/整表刷新，按 id 天然安全
      const targetConvId = found.convId;
      if (switchedFromContact) {
        // 等 swiper 300ms 切页动画落定再设锚点（动画进行中 Android 设 anchor 不可靠）；
        // 350ms 窗内页面可能已卸载/换会话（fire-and-forget 短计时器，按仓内惯例
        // 回调首行守卫，不装配清理）
        setTimeout((): void => {
          if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
          locateConvRow(targetConvId);
        }, 350);
      } else {
        locateConvRow(targetConvId);
      }
    } finally {
      retapLocating = false;
    }
  }

  onRetap((): void => {
    handleRetapLocateFirstUnread();
  });

  function handleConvRetry(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (convFailed.value) {
      loadConversations();
    }
  }

  function handleContactRetry(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (contactFailed.value) {
      loadContacts();
    }
  }

  /** 搜索入口：进 IM 全局搜索子包页（消息/联系人/群组，PC 搜索弹窗同款能力）。 */
  function handlePlaceholderTap(): void {
    if (pageTapSwallowed()) {
      return;
    }
    uni.navigateTo({ url: "/subpackages/pages/im-search/im-search" });
  }

  // ===== 右上角「+」锚定气泡 =====

  /** 加号矩形测量结果（im-header-tabs 组件 plus-rect 上抛，视口 px；-1=未测到）。
      原为 createSelectorQuery.exec 回调（onAddDrawerRectsMeasured），「+」节点移入
      页头组件后改由组件侧测量、原始数字直发——拼装逻辑原样保留（Stage 3）。 */
  function onHeaderPlusMeasured(
    leftPx: number,
    topPx: number,
    rightPx: number,
    bottomPx: number,
  ): void {
    // 加号矩形保持视口坐标（touch 事件的 clientX/Y 是视口系）：兜底收起路径排除加号区用
    plusRectLeft = leftPx;
    plusRectTop = topPx;
    plusRectRight = rightPx;
    plusRectBottom = bottomPx;
    if (
      leftPx >= 0 &&
      topPx >= 0 &&
      rightPx > leftPx &&
      bottomPx > topPx
    ) {
      addPlusOverlayStyle.value =
        "left: " +
        leftPx.toString() +
        "px; top: " +
        topPx.toString() +
        "px; width: " +
        (rightPx - leftPx).toString() +
        "px; height: " +
        (bottomPx - topPx).toString() +
        "px;";
      addHeaderDismissOverlayStyle.value =
        "left: 0px; top: 0px; right: 0px; height: " + bottomPx.toString() + "px;";
    }
    // 气泡 absolute 挂 fixed 蒙层内：锚定用视口坐标（加号下缘 y 直用，右距=窗口宽-右缘）
    const anchorBottom = bottomPx;
    let anchorRightGap = -1;
    const winWidthPx = uni.getWindowInfo().windowWidth;
    if (rightPx > 0 && winWidthPx - rightPx >= 0) {
      anchorRightGap = winWidthPx - rightPx;
    }
    // 先写锚定 props 再开显隐（v-if 挂载组件时锚定值已就位）
    addDrawerAnchorBottom.value = anchorBottom;
    addDrawerAnchorRightGap.value = anchorRightGap;
    addDrawerVisible.value = true;
  }

  /** 点击「+」：测量加号位置，弹出锚定气泡（贴右缘、顶部在加号下方）；气泡已开则收起
   *  （toggle）。iOS/H5：蒙层点外关闭已排除加号矩形（closeAddDrawerOnOutsideTouch），
   *  点加号走本函数收起半程；Android：蒙层盖住真按钮，经补层 add-plus-overlay 的
   *  @tap 进这里 toggle。气泡 absolute 挂 fixed 蒙层内，锚定坐标为视口坐标系。
   *  测量路由页头组件 measurePlus（selectNodeQuery 不穿透自定义组件，Stage 3 起
   *  「+」节点在 im-header-tabs 内，页面作用域查不到）。 */
  function openAddDrawer(): void {
    if (pageTapSwallowed()) {
      return;
    }
    if (addDrawerVisible.value) {
      addDrawerVisible.value = false;
      return;
    }
    const proxy = headerTabsRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("measurePlus");
  }

  /** 气泡 - 创建群组：记录待跳子包页，等气泡关闭（closed）再接续跳转。 */
  function handleCreateGroupTap(): void {
    pendingSheetAfterDrawer = "create-group";
  }

  /** 气泡 - 加入群组：记录待跳子包页，等气泡关闭（closed）再接续跳转。 */
  function handleJoinGroupTap(): void {
    pendingSheetAfterDrawer = "join-group";
  }

  /** 气泡 - 添加伙伴：记录待跳子包页，等气泡关闭（closed）再接续跳转。 */
  function handleAddBuddyTap(): void {
    pendingSheetAfterDrawer = "add-buddy";
  }

  /** 气泡 - 扫一扫：等气泡关闭后拉起系统扫码（结果分发见 scan-launcher）。 */
  function handleScanTap(): void {
    pendingSheetAfterDrawer = "scan";
  }

  /** 扫群名片码（不在群）：跳加入群组页并预填 19 位群号（用户确认提交；返回时
   *  本页 onShow 静默刷新会话列表，免审批群立即出现）。 */
  function handleScanJoinGroup(groupNo: string): void {
    uni.navigateTo({ url: `/subpackages/pages/im-join-group/im-join-group?groupNo=${groupNo}` });
  }

  /** 扫用户名片码（未加好友）：跳添加伙伴页并预填账号/用户名（防抖自动搜索，
   *  结果返回后按 userId 自动选中目标行）。 */
  function handleScanAddBuddy(keyword: string, userId: string): void {
    uni.navigateTo({
      url:
        `/subpackages/pages/im-add-buddy/im-add-buddy` +
        `?keyword=${encodeURIComponent(keyword)}&userId=${encodeURIComponent(userId)}`,
    });
  }

  /** 气泡关闭后：接续 pending 的动作（跳子包页 / 拉起扫码）。closed 由组件在
   *  菜单项点击 / Android 返回时派发；页面在此收下显隐再消费 pending。 */
  function handleAddDrawerClosed(): void {
    addDrawerVisible.value = false;
    if (pendingSheetAfterDrawer == "create-group") {
      pendingSheetAfterDrawer = "";
      uni.navigateTo({ url: "/subpackages/pages/im-create-group/im-create-group" });
      return;
    }
    if (pendingSheetAfterDrawer == "join-group") {
      pendingSheetAfterDrawer = "";
      uni.navigateTo({ url: "/subpackages/pages/im-join-group/im-join-group" });
      return;
    }
    if (pendingSheetAfterDrawer == "add-buddy") {
      pendingSheetAfterDrawer = "";
      uni.navigateTo({ url: "/subpackages/pages/im-add-buddy/im-add-buddy" });
      return;
    }
    if (pendingSheetAfterDrawer == "scan") {
      pendingSheetAfterDrawer = "";
      const proxy = scanLauncherRef.value as ComponentPublicInstance | null;
      if (proxy == null) {
        return;
      }
      proxy.$callMethod("startScan");
    }
  }

  /** 进入消息详情页：携带会话基础信息（名称/头像 encodeURIComponent，详情页容错解码）。 */
  function openConversation(conv: ImConvRow): void {
    const chatUrl =
      `/pages/message/chat?convId=${conv.convId}&convType=${conv.convType}` +
      `&name=${encodeURIComponent(displayConvName(conv))}` +
      `&avatar=${encodeURIComponent(conv.avatarUrl)}`;
    uni.navigateTo({ url: chatUrl });
  }

  // ===== 长按行操作浮层（无蒙层：行浅灰高亮 + 行旁锚定气泡；浮层状态与 closeRowMenu/
  //       rowMenuOnCls 声明在 handleListScroll/handlePageTouchStart 等使用方上方——
  //       UTS 先声明后调用；操作分发 handleRowMenuAct 定义在各操作处理器之后）=====

  /** 测量中转：长按落定的行类型与行数据（exec 回调取用拼装浮层）。 */
  let rowMenuPendingKind = "";
  let rowMenuPendingConv: ImConvRow | null = null;
  let rowMenuPendingContact: ImContactRow | null = null;

  /** 浮层拼装（原 onRowMenuRectsMeasured 主体，Stage 4 抽出供双测量路径共用）：
      行矩形（视口 px）+ .im-page 原点与高度（页面矩形供上下空间判定与 fixed 视口
      坐标换算：页面坐标 + 页面原点 = 视口坐标）；气泡与蒙层条同为 fixed 层
      （z-index 991 压条上），测不到行矩形则放弃弹层。 */
  function assembleRowMenu(
    rowTopPx: number,
    rowBottomPx: number,
    rowLeftPx: number,
    pageTopPx: number,
    pageLeftPx: number,
    pageHpx: number,
  ): void {
    if (rowTopPx < 0 || rowBottomPx <= rowTopPx) {
      return;
    }
    const holeTop = rowTopPx - pageTopPx;
    const holeBottom = rowBottomPx - pageTopPx;
    const holeLeft = rowLeftPx - pageLeftPx;
    // 操作项按行类型生成（conv/group 共用 ImConvRow；contact 按 status 分撤回/常规）；
    // 图标取 iconfont 既有字形（svg-icon 16px，同尺寸不同形）
    const kind = rowMenuPendingKind;
    const conv = rowMenuPendingConv;
    const contact = rowMenuPendingContact;
    const acts: ImRowMenuAct[] = [];
    if (kind == "conv" && conv != null) {
      acts.push(
        new ImRowMenuAct(
          conv.topFlag ? t("Mobile.Conversation.unpin") : t("Mobile.Conversation.pin"),
          "icon-a-Arrowup",
        ),
      );
      acts.push(new ImRowMenuAct(conv.dnd ? t("Mobile.Message.unmute") : t("Mobile.Message.mute"), "icon-bell"));
      acts.push(new ImRowMenuAct(t("Mobile.Common.delete"), "icon-a-trashcan"));
    } else if (kind == "group" && conv != null) {
      acts.push(new ImRowMenuAct(t("Mobile.Message.groupOpenChat"), "icon-message"));
      acts.push(
        new ImRowMenuAct(
          conv.myRole == 3 ? t("Mobile.Message.dissolveGroupConfirm") : t("Mobile.Message.leaveGroupConfirm"),
          conv.myRole == 3 ? "icon-a-Xcircle" : "icon-Exit",
        ),
      );
    } else if (kind == "contact" && contact != null) {
      if (contact.status == 3) {
        acts.push(new ImRowMenuAct(t("Mobile.Message.withdrawRequest"), "icon-Clock"));
      } else {
        acts.push(new ImRowMenuAct(t("Mobile.Message.sendMessage"), "icon-message"));
        acts.push(new ImRowMenuAct(t("Mobile.Message.editRemark"), "icon-Edit"));
        acts.push(new ImRowMenuAct(t("Mobile.Message.removeContactTitle"), "icon-a-trashcan"));
      }
    }
    if (acts.length == 0) {
      return;
    }
    rowMenuKind.value = kind;
    rowMenuConv.value = conv;
    rowMenuContact.value = contact;
    rowMenuActs.value = acts;
    // 行高亮 id 与 pressedRowCls 同键（contact=ct-userId，conv/group=convId）
    rowMenuRowId.value = contact != null ? `ct-${contact.userId}` : conv != null ? conv.convId : "";
    // 气泡几何与样式表对齐：宽 120px 固定（CSS），高 = 项高 44px×N + 垂直内边距 4px×2；
    // 上下空间实测判定：上方余量够（含 5px 间距）弹行上方，否则下方，两侧都不够挑空间
    // 大的一侧并钳回页面内；左对齐行内容（16px 行内边距），右缘越屏则钳到距右缘 12px
    // （尺寸已 px 化，不再随窗口宽换算缩放）
    const win = uni.getWindowInfo();
    if (pageHpx <= 0) {
      pageHpx = win.windowHeight - pageTopPx;
    }
    // 蒙层条几何（fixed=视口系，直接用行矩形视口坐标，不做页面坐标换算）：行顶以上全盖、
    // 行底以下全盖；行半滚出屏钳 0（洞随可见区收窄）。仅 rowMenuDark 平台写值，MP 零增量
    if (rowMenuDark) {
      const winH = win.windowHeight;
      const maskTopH = rowTopPx < 0 ? 0 : rowTopPx;
      const maskBottomH = rowBottomPx >= winH ? 0 : winH - rowBottomPx;
      rowMenuMaskTopStyle.value = "height: " + maskTopH.toString() + "px;";
      rowMenuMaskBottomStyle.value = "height: " + maskBottomH.toString() + "px;";
    }
    const popWpx = 120;
    const popHpx = acts.length * 44 + 8;
    const gapPx = 5;
    const spaceAbovePx = holeTop;
    const spaceBelowPx = pageHpx - holeBottom;
    let popTop = -1;
    if (spaceAbovePx >= popHpx + gapPx) {
      popTop = holeTop - gapPx - popHpx;
    } else if (spaceBelowPx >= popHpx + gapPx) {
      popTop = holeBottom + gapPx;
    } else {
      popTop = spaceAbovePx >= spaceBelowPx ? holeTop - gapPx - popHpx : holeBottom + gapPx;
      const maxTop = pageHpx - popHpx - 6;
      if (popTop > maxTop) {
        popTop = maxTop < 6 ? 6 : maxTop;
      }
      if (popTop < 6) {
        popTop = 6;
      }
    }
    let popLeft = holeLeft + 16;
    const maxLeft = win.windowWidth - 12 - popWpx;
    if (popLeft > maxLeft) {
      popLeft = maxLeft < 12 ? 12 : maxLeft;
    }
    // 气泡 fixed（视口坐标 = 页面坐标 + 页面原点）：App 原生 fixed 层浮于普通流之上，
    // absolute 气泡会被蒙层条压住，z-index 991>990 须同定位模式才作数
    rowMenuPopStyle.value = "top: " + (popTop + pageTopPx).toString() + "px; left: " + (popLeft + pageLeftPx).toString() + "px;";
    rowMenuVisible.value = true;
  }

  // ===== 拆分测量路径（行节点在 pane 子组件内的 kind；Stage 4 起 conv 用）=====
  // 行矩形由 pane 侧 measureRow 自测经 row-rect 上抛，页面矩形仍页面作用域量
  // （.im-page 是页面节点）；两回调各自落槽，双 ready 后 tryAssembleRowMenu 拼装
  // （exec 回调异步、到达序不定，门闩吸收任意顺序）。
  let rowMenuSplitRowTop = -1;
  let rowMenuSplitRowBottom = -1;
  let rowMenuSplitRowLeft = -1;
  let rowMenuSplitPageTop = 0;
  let rowMenuSplitPageLeft = 0;
  let rowMenuSplitPageH = 0;
  let rowMenuRowReady = false;
  let rowMenuPageReady = false;

  /** 双 ready 门闩：行 + 页面矩形都到位才拼装（一次消费后复位，防重复弹）。
   *  ★声明在两个落槽回调之前（UTS 不提升声明，error18 前向引用）。 */
  function tryAssembleRowMenu(): void {
    if (!rowMenuRowReady || !rowMenuPageReady) {
      return;
    }
    rowMenuRowReady = false;
    rowMenuPageReady = false;
    assembleRowMenu(
      rowMenuSplitRowTop,
      rowMenuSplitRowBottom,
      rowMenuSplitRowLeft,
      rowMenuSplitPageTop,
      rowMenuSplitPageLeft,
      rowMenuSplitPageH,
    );
  }

  /** .im-page 矩形回调（拆分路径）：落槽后试拼装。 */
  function onRowMenuPageMeasured(results: Array<any>): void {
    if (results.length > 0) {
      const pageRaw = results[0];
      if (pageRaw != null) {
        const pageRect = pageRaw as NodeInfo;
        if (pageRect.top != null) {
          rowMenuSplitPageTop = parseFloat(`${pageRect.top}`);
        }
        if (pageRect.left != null) {
          rowMenuSplitPageLeft = parseFloat(`${pageRect.left}`);
        }
        if (pageRect.height != null) {
          rowMenuSplitPageH = parseFloat(`${pageRect.height}`);
        }
      }
    }
    rowMenuPageReady = true;
    tryAssembleRowMenu();
  }

  /** pane 行矩形上抛（conv/contact pane row-rect；视口 px 原始数字）：落槽后试拼装。 */
  function onPaneRowRectMeasured(topPx: number, bottomPx: number, leftPx: number): void {
    rowMenuSplitRowTop = topPx;
    rowMenuSplitRowBottom = bottomPx;
    rowMenuSplitRowLeft = leftPx;
    rowMenuRowReady = true;
    tryAssembleRowMenu();
  }

  /** 长按弹操作浮层入口：记中转数据并测量行矩形（回调里定位气泡并展开）。
   *  置吞击位：撤 @longpress 后无原生长按消费触摸，各端长按抬手都会补发一次 click，
   *  rowClickIntercept 只吞不关（浮层保持）；窗 800ms 覆盖浮层弹出后再抬手的常见
   *  反应时延（500ms 到点弹层 + ~300ms 松手）。
   *  测量路由（Stage 5 起全 kind 拆分路径）：行节点全在 pane 子组件内（页面作用域
   *  查不到 #row-*）——pane 侧 measureRow 自测 + 页面侧量 .im-page，双 ready 拼装。 */
  function openRowMenu(kind: string, domId: string, conv: ImConvRow | null, contact: ImContactRow | null): void {
    suppressNextSwipeClick = true;
    suppressSwipeClickUntil = Date.now() + 800;
    // 本轮手势弹了浮层：其抬手不派发（见 rowTouchMenuArmed 声明处注释）
    rowTouchMenuArmed = true;
    rowMenuPendingKind = kind;
    rowMenuPendingConv = conv;
    rowMenuPendingContact = contact;
    const pageProxy = pageInstance != null ? pageInstance.proxy : null;
    if (pageProxy == null) {
      return;
    }
    // 行节点全在 pane 子组件内（页面作用域查不到 #row-*）：pane 侧 measureRow 自测
    // 经 row-rect 上抛 + 页面侧量 .im-page，双 ready 拼装（两查询并发发出）
    rowMenuRowReady = false;
    rowMenuPageReady = false;
    const paneProxy = (kind == "conv" ? convPaneRef.value : contactPaneRef.value) as ComponentPublicInstance | null;
    if (paneProxy == null) {
      return;
    }
    paneProxy.$callMethod("measureRow", domId);
    uni.createSelectorQuery()
      .in(pageProxy)
      .select(".im-page")
      .boundingClientRect()
      .exec(onRowMenuPageMeasured);
  }

  // Android 返回先关浮层（popupBackRegistry，同 add-menu-drawer 气泡）——所有收起路径
  // （closeRowMenu/页面任意触摸/滚动/onHide）都改 rowMenuVisible，必经此 watch 注册/注销，无遗漏
  let rowMenuBackId = 0;
  watch(rowMenuVisible, (val: boolean) => {
    if (val == true) {
      if (rowMenuBackId == 0) {
        rowMenuBackId = registerPopupClose(closeRowMenu);
      }
    } else if (rowMenuBackId != 0) {
      unregisterPopupClose(rowMenuBackId);
      rowMenuBackId = 0;
    }
  });

  // 气泡根吞 touch/click 的空处理器已随 row-menu-pop 组件迁移（Stage 2）：模板里
  // .stop 断冒泡 + 组件内空实现自闭环。★touchend 必须断冒泡的根因（页面根
  // finishPageTouch 拿旧起点误判滑动派生 click、白吞 item click）见组件模板注释。

  /** 长按装填（撤 @longpress 后自计时；声明在 openRowMenu 之后——计时回调要调它，
   *  UTS 不提升声明）。500ms 对齐 iOS 原生长按体感、跨端统一：Android 原生 ~400ms
   *  偏短（三星上「按压时间不长却弹窗」即其症），且原生长按不要求零位移——现微移
   *  >6px 即清计时（handleRowTouchMove → clearRowTouch），移动了就不是长按。
   *  到点守卫 touchingRowPending 非空：滑动/取消/滚动接管/抬手都经 clearRowTouch
   *  清了计时，此为双保险（防未来新增清除路径漏调）。 */
  let rowLongPressKind = "";
  let rowLongPressDomId = "";
  let rowLongPressConv: ImConvRow | null = null;
  let rowLongPressContact: ImContactRow | null = null;

  function armRowLongPress(kind: string, domId: string, conv: ImConvRow | null, contact: ImContactRow | null): void {
    rowLongPressKind = kind;
    rowLongPressDomId = domId;
    rowLongPressConv = conv;
    rowLongPressContact = contact;
    rowLongPressTimer = setTimeout(() => {
      rowLongPressTimer = 0;
      if (touchingRowPending.length == 0) {
        return;
      }
      openRowMenu(rowLongPressKind, rowLongPressDomId, rowLongPressConv, rowLongPressContact);
    }, 500);
  }

  /** 会话行 touchstart：公共判定 + 装填长按（系统通知会话无操作，不装填）。 */
  function handleConvRowTouchStart(conv: ImConvRow, eventValue: Any): void {
    handleRowTouchStart(conv.convId, eventValue);
    if (isSystemConv(conv)) {
      return;
    }
    armRowLongPress("conv", `row-${conv.convId}`, conv, null);
  }

  /** 群组行 touchstart：公共判定 + 装填长按（打开会话 / 解散·退出群聊）。 */
  function handleGroupRowTouchStart(group: ImConvRow, eventValue: Any): void {
    // 双页 swiper 常驻后行 id 不得跨 pane 撞名（群 conv 同时在会话列表）：群组行加 grp- 前缀
    handleRowTouchStart(group.convId, eventValue);
    armRowLongPress("group", `row-grp-${group.convId}`, group, null);
  }

  /** 联系人行 touchstart（含已申请行）：公共判定 + 装填长按——已申请（status=3）=
   *  撤回申请；正式联系（status=1）= 发消息/备注/删除。 */
  function handleContactRowTouchStart(contact: ImContactRow, eventValue: Any): void {
    handleRowTouchStart(`ct-${contact.userId}`, eventValue);
    armRowLongPress("contact", `row-ct-${contact.userId}`, null, contact);
  }

  /** 行点击守卫：长按浮层开着时点任意行=收浮层并吞掉本次点击；长按/滑动补发的 click
   *  只吞不关（长按弹层后的松手浮层须保持）。返回 true 表示调用方直接 return。 */
  function rowClickIntercept(): boolean {
    // 滑动 touchup 派生的 click（Android）直接吞掉；顺带清补发标记，避免误吞下一次正常点击
    if (pageTapSwallowed()) {
      suppressNextSwipeClick = false;
      return true;
    }
    if (suppressNextSwipeClick) {
      suppressNextSwipeClick = false;
      // 时效内的 click 视为长按抬手补发：只吞不关（浮层刚弹出须保持）；
      // 超时才到的（Android 长按不补发 click 的端）是真实点击，落到下方收浮层分支
      if (Date.now() <= suppressSwipeClickUntil) {
        return true;
      }
    }
    if (rowMenuVisible.value) {
      closeRowMenu();
      return true;
    }
    return false;
  }

  /** 会话行点击：长按浮层开着时先收浮层；否则进消息详情页。 */
  function handleConvClick(conv: ImConvRow): void {
    if (rowClickIntercept()) {
      return;
    }
    flashRowPressed(conv.convId);
    openConversation(conv);
  }

  /** 置顶/取消置顶（topFlag）：成功后整表刷新，分区由 topFlag 定、置顶组内按最近
      消息时间降序（parseConvRecords 端上重排，对齐 PC convOrder.ts DEV-227）。 */
  async function handleConvPin(conv: ImConvRow): Promise<void> {
    if (pageTapSwallowed()) {
      return;
    }
    const pin = !conv.topFlag;
    try {
      const res = await apiImConvSetTop(conv.convId, pin);
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({
        title: pin
          ? t("Mobile.Conversation.pinSuccess")
          : t("Mobile.Conversation.unpinSuccess"),
        icon: "none",
      });
      loadConversations();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /** 消息免打扰开关（dnd）：不影响列表排序，本地即时生效。 */
  async function handleConvDnd(conv: ImConvRow): Promise<void> {
    if (pageTapSwallowed()) {
      return;
    }
    const mute = !conv.dnd;
    try {
      const res = await apiImConvSetDnd(conv.convId, mute);
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      conv.dnd = mute;
      // Android 不追踪 ref 数组内实例属性变更：conv.dnd 原地改不触发 v-for 行重渲，
      // icon 停在旧态直到下次整表重建（iOS 原生追踪属性所以即时）——整表重建赋值
      // 强制三端一致重渲（removeConversation 同款，无 watch 副作用）。★行内容已抽
      // conv-row-item（按对象身份跳过）：须深克隆换行身份，浅拷重建行组件会跳过
      conversations.value = cloneConvRows(conversations.value);
      uni.showToast({
        title: mute ? t("Mobile.Message.muteSuccess") : t("Mobile.Message.unmuteSuccess"),
        icon: "none",
      });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /** 删除成功：本地移除该行，并刷新 tab 未读角标（GET unread-total）。 */
  async function removeConversation(conv: ImConvRow): Promise<void> {
    try {
      const res = await apiImConvRemove(conv.convId);
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      const next: ImConvRow[] = [];
      const list = conversations.value;
      for (let i = 0; i < list.length; i++) {
        if (list[i].convId != conv.convId) {
          next.push(list[i]);
        }
      }
      conversations.value = next;
      refreshImUnreadBadge();
      uni.showToast({ title: t("Mobile.Message.removeConvSuccess"), icon: "none" });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  // ===== 紧凑确认弹窗（全页共享一个实例；打开时记 pendingAction，确认回调按其分发，
  //       回调定义在 leaveGroup 之后——UTS 要求先定义后调用）=====
  /** 待确认操作：""=无 / "conv"=删会话 / "contact"=删联系人 / "dissolve"=解散群 / "leave"=退群。 */
  let pendingAction = "";
  let pendingConv: ImConvRow | null = null;
  let pendingContact: ImContactRow | null = null;

  /** 打开确认弹窗（标题/正文/确认文案由调用方算好传入；载荷记在 pending* 字段）。 */
  function openConfirmModal(title: string, content: string, confirmText: string): void {
    const proxy = confirmModalRef.value as ComponentPublicInstance | null;
    if (proxy != null) {
      proxy.$callMethod("open", title, content, confirmText);
    }
  }

  /** 删除会话（visible=false 仅移出我的消息列表）：紧凑确认弹窗按会话类型给不同文案。 */
  function handleConvRemove(conv: ImConvRow): void {
    if (pageTapSwallowed()) {
      return;
    }
    pendingAction = "conv";
    pendingConv = conv;
    openConfirmModal(
      t("Mobile.Message.removeConvTitle"),
      conv.convType == 2
        ? t("Mobile.Message.removeConvGroupTip")
        : t("Mobile.Message.removeConvP2pTip"),
      t("Mobile.Common.delete"),
    );
  }

  // ===== 智联录交互 =====

  /** 联系人点击防重入：p2p 会话创建是一次网络往返，期间忽略连点。 */
  let contactChatOpening = false;

  /**
   * 点击正式联系人：get-or-create 单聊（幂等，同一对人永远同一 convId）后进详情页。
   * convId 取响应原文（请求层 parseJsonKeepInt64 保证雪花号精确）；名称/头像用
   * 联系人行的展示值，与会话列表入口的参数结构保持一致。
   */
  async function openContactChat(contact: ImContactRow): Promise<void> {
    // 长按浮层开着时点行 = 收浮层并吞掉；滑动/长按松手补发的 click 吞掉
    if (rowClickIntercept()) {
      return;
    }
    if (contactChatOpening) {
      return;
    }
    contactChatOpening = true;
    flashRowPressed(`ct-${contact.userId}`);
    try {
      const res = await apiImCreateP2pConversation(contact.userId);
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      contactChatOpening = false;
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      const convId = dataObj != null ? readString(dataObj, "convId") : "";
      if (apiResCode(res) != SUCCESS_CODE || convId.length == 0) {
        uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
        return;
      }
      uni.navigateTo({
        url:
          `/pages/message/chat?convId=${convId}&convType=1` +
          `&name=${encodeURIComponent(contact.displayName)}` +
          `&avatar=${encodeURIComponent(contact.avatarUrl)}`,
      });
    } catch (_error) {
      contactChatOpening = false;
      uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
    }
  }

  /** 点击团队防重入：enter 是一次网络往返，期间忽略连点。 */
  let spaceEntering = false;

  /**
   * 点击团队：POST spaces/{spaceId}/enter（幂等 get-or-create，同 p2p 语义）拿
   * convId 后进聊天页；convType 从响应取（团队会话=4），convId 雪花号经请求层
   * 防精度解析保持精确。名称/头像用团队行的展示值，与联系人入口参数结构一致。
   */
  async function handleSpaceTap(space: ImSpaceRow): Promise<void> {
    if (pageTapSwallowed()) {
      return;
    }
    if (spaceEntering) {
      return;
    }
    spaceEntering = true;
    flashRowPressed(`sp-${space.spaceId}`);
    try {
      const res = await apiImSpaceEnter(space.spaceId);
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      spaceEntering = false;
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      const convId = dataObj != null ? readString(dataObj, "convId") : "";
      if (apiResCode(res) != SUCCESS_CODE || convId.length == 0) {
        uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
        return;
      }
      const convType = dataObj != null ? readNumber(dataObj, "convType", 4) : 4;
      uni.navigateTo({
        url:
          `/pages/message/chat?convId=${convId}&convType=${convType}` +
          `&name=${encodeURIComponent(space.name)}` +
          `&avatar=${encodeURIComponent(space.icon)}`,
      });
    } catch (_error) {
      spaceEntering = false;
      uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
    }
  }

  /** 申请已处理（同意/拒绝由详情卡片调接口）：整表刷新，pendingIn/角标自动重算。 */
  function handleContactRequestResolved(): void {
    loadContacts();
  }

  /** 点击「新的伙伴申请」：弹底部申请详情卡片（理由全文 + 同意/拒绝）。 */
  function handlePendingInTap(contact: ImContactRow): void {
    if (pageTapSwallowed()) {
      return;
    }
    flashRowPressed(`in-${contact.userId}`);
    const proxy = applyDetailSheetRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(
      "open",
      contact.userId,
      contact.displayName,
      contact.avatarDisplay,
      contact.fallbackLine1,
      contact.applyMsg,
      // 原始地址：列表行还没解析出展示地址时，卡片自己解析（不依赖行状态）
      contact.avatarUrl,
    );
  }

  /** 点击「已申请」：等待对方处理，仅提示。 */
  function handlePendingOutTap(contact: ImContactRow): void {
    // 长按浮层开着时点行 = 收浮层并吞掉；滑动/长按松手补发的 click 吞掉
    if (rowClickIntercept()) {
      return;
    }
    flashRowPressed(`ct-${contact.userId}`);
    uni.showToast({ title: t("Mobile.Message.requestPendingTip"), icon: "none" });
  }

  // ===== 行点按双通道派发（三星 One UI 按压带微移不合成 click——touchend 主通道
  //       + @click 兜底，判定收敛 rowTapGuard；包装函数放各实现函数之后：UTS 不提升）=====
  // 主通道：touchend 判定通过（位移 ≤10px）+ rowClickIntercept 放行 → 直接执行原
  // 点击动作（不再等合成 click，三星微移点了没反应即修此）；随后若仍合成 click，
  // 由兜底通道的防重窗吞掉。兜底通道：H5 桌面无触摸走 click；App 上 touchend 未
  // 送达但 click 送到的端也由此接住。原入口函数（handleConvClick 等）守卫链原样
  // 保留，非行入口（长按气泡操作等）仍直调原函数、不经防重窗。

  /** 会话/群组行：点按进会话。 */
  function handleConvRowTouchEnd(conv: ImConvRow, eventValue: Any): void {
    if (settleRowTouchEnd(eventValue) && !rowClickIntercept()) {
      handleConvClick(conv);
    }
  }

  function handleConvRowClick(conv: ImConvRow): void {
    if (rowTapGuard.clickFallback()) {
      handleConvClick(conv);
    }
  }

  /** 新的伙伴申请行：点按弹同意/拒绝。 */
  function handlePendingInRowTouchEnd(contact: ImContactRow, eventValue: Any): void {
    if (settleRowTouchEnd(eventValue) && !rowClickIntercept()) {
      handlePendingInTap(contact);
    }
  }

  function handlePendingInRowClick(contact: ImContactRow): void {
    if (rowTapGuard.clickFallback()) {
      handlePendingInTap(contact);
    }
  }

  /** 已申请行：点按仅提示等待。 */
  function handlePendingOutRowTouchEnd(contact: ImContactRow, eventValue: Any): void {
    if (settleRowTouchEnd(eventValue) && !rowClickIntercept()) {
      handlePendingOutTap(contact);
    }
  }

  function handlePendingOutRowClick(contact: ImContactRow): void {
    if (rowTapGuard.clickFallback()) {
      handlePendingOutTap(contact);
    }
  }

  /** 我的团队折叠头：展开/折叠。 */
  function handleSpacesHeadTouchEnd(eventValue: Any): void {
    if (settleRowTouchEnd(eventValue) && !rowClickIntercept()) {
      toggleSpaces();
    }
  }

  function handleSpacesHeadClick(): void {
    if (rowTapGuard.clickFallback()) {
      toggleSpaces();
    }
  }

  /** 团队行：点按进团队对话。 */
  function handleSpaceRowTouchEnd(space: ImSpaceRow, eventValue: Any): void {
    if (settleRowTouchEnd(eventValue) && !rowClickIntercept()) {
      handleSpaceTap(space);
    }
  }

  function handleSpaceRowClick(space: ImSpaceRow): void {
    if (rowTapGuard.clickFallback()) {
      handleSpaceTap(space);
    }
  }

  /** 我的群组折叠头：展开/折叠。 */
  function handleGroupsHeadTouchEnd(eventValue: Any): void {
    if (settleRowTouchEnd(eventValue) && !rowClickIntercept()) {
      toggleGroups();
    }
  }

  function handleGroupsHeadClick(): void {
    if (rowTapGuard.clickFallback()) {
      toggleGroups();
    }
  }

  /** 联系人行：点按 get-or-create 单聊后进详情页。 */
  function handleContactRowTouchEnd(contact: ImContactRow, eventValue: Any): void {
    if (settleRowTouchEnd(eventValue) && !rowClickIntercept()) {
      openContactChat(contact);
    }
  }

  function handleContactRowClick(contact: ImContactRow): void {
    if (rowTapGuard.clickFallback()) {
      openContactChat(contact);
    }
  }

  // ===== 联系人行长按气泡操作（发消息 / 修改备注 / 删除联系人 / 撤回申请）=====

  /** 气泡-发消息：与点行同路径（get-or-create 单聊后进详情页）。 */
  function handleContactMessage(contact: ImContactRow): void {
    if (pageTapSwallowed()) {
      return;
    }
    openContactChat(contact);
  }

  /** 气泡-修改备注：打开底部弹窗（预填现有备注，留空保存=清除）。 */
  function handleContactRemark(contact: ImContactRow): void {
    if (pageTapSwallowed()) {
      return;
    }
    const proxy = remarkSheetRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("open", contact.userId, contact.displayName, contact.remark);
  }

  /** 备注保存成功：刷新联系人 + 会话列表。服务端展示名统一按 remark > nick > name
   *  计算（联系人 displayName 与单聊会话 peerName 同源），只刷联系人的话消息 tab
   *  仍显旧名。 */
  function handleRemarkSaved(): void {
    loadContacts();
    if (convLoaded.value) {
      loadConversations();
    }
  }

  /** 删除成功：整表刷新（以服务端为准）。 */
  async function removeContact(contact: ImContactRow): Promise<void> {
    try {
      const res = await apiImContactRemove(contact.userId);
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Message.removeContactSuccess"), icon: "none" });
      loadContacts();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /** 气泡-删除联系人：紧凑确认弹窗二次确认（★双向删除：对方那边也会失去我）后调 DELETE。 */
  function handleContactRemove(contact: ImContactRow): void {
    if (pageTapSwallowed()) {
      return;
    }
    pendingAction = "contact";
    pendingContact = contact;
    openConfirmModal(
      t("Mobile.Message.removeContactTitle"),
      t("Mobile.Message.removeContactTip"),
      t("Mobile.Common.delete"),
    );
  }

  /**
   * 气泡-撤回申请：★无确认直接调（与「拒绝申请」同一端点：删掉两行，幂等）。
   * 成功后整表刷新（status=3 的行随之消失）。
   */
  async function handleContactWithdraw(contact: ImContactRow): Promise<void> {
    if (pageTapSwallowed()) {
      return;
    }
    try {
      const res = await apiImContactReject(contact.userId);
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Message.withdrawSuccess"), icon: "none" });
      loadContacts();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  // ===== 群组行长按气泡操作（打开会话 / 解散群聊（群主）/ 退出群聊（非群主））=====

  /** 气泡-打开会话：与点行同路径（群聊直接带 convId 进详情页）。 */
  function handleGroupOpen(group: ImConvRow): void {
    if (pageTapSwallowed()) {
      return;
    }
    openConversation(group);
  }

  /** 解散成功：群组 + 会话列表整表刷新，并同步 tab 未读角标。 */
  async function dissolveGroup(group: ImConvRow): Promise<void> {
    try {
      const res = await apiImGroupDisband(group.convId);
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Message.dissolveGroupSuccess"), icon: "none" });
      loadGroups();
      loadConversations();
      refreshImUnreadBadge();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /** 气泡-解散群聊（仅群主）：紧凑确认弹窗二次确认后 DELETE 会话（群整体消失，不可恢复）。 */
  function handleGroupDissolve(group: ImConvRow): void {
    if (pageTapSwallowed()) {
      return;
    }
    pendingAction = "dissolve";
    pendingConv = group;
    // 标题/正文含群名与人数（设计稿：解散群「xxx」？/ 群里 N 人的会话都会消失…）
    const params = new Map<string, string | number>();
    params.set("name", displayConvName(group));
    params.set("count", group.memberCount);
    openConfirmModal(
      translateFn("Mobile.Message.dissolveGroupTitle", toI18nParams(params), "解散群聊"),
      translateFn("Mobile.Message.dissolveGroupTip", toI18nParams(params), ""),
      t("Mobile.Message.dissolveGroupConfirm"),
    );
  }

  /** 退群成功：群组 + 会话列表整表刷新，并同步 tab 未读角标。 */
  async function leaveGroup(group: ImConvRow): Promise<void> {
    try {
      const res = await apiImGroupLeave(group.convId);
      if (messagePageDisposed || messagePageSession != getImSessionStamp()) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Message.leaveGroupSuccess"), icon: "none" });
      loadGroups();
      loadConversations();
      refreshImUnreadBadge();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  /**
   * 气泡-退出群聊（非群主）：紧凑确认弹窗二次确认后 POST leave。
   * 群主不会看到该入口（服务端同样禁止群主直接退群，需先转让）。
   */
  function handleGroupLeave(group: ImConvRow): void {
    if (pageTapSwallowed()) {
      return;
    }
    pendingAction = "leave";
    pendingConv = group;
    // 标题含群名（对齐解散弹窗：退出群「xxx」？）；按钮为固定文案「退出群聊」
    const params = new Map<string, string | number>();
    params.set("name", displayConvName(group));
    openConfirmModal(
      translateFn("Mobile.Message.leaveGroupTitle", toI18nParams(params), "退出群聊"),
      t("Mobile.Message.leaveGroupTip"),
      t("Mobile.Message.leaveGroupConfirm"),
    );
  }

  /**
   * 气泡操作分发：按 rowMenuKind 与行数据调对应处理器（index 对应 rowMenuActs 的
   * 拼装顺序，见 onRowMenuRectsMeasured）。先取行数据再收浮层——closeRowMenu 会清
   * rowMenuConv/rowMenuContact；收完再执行，确认弹窗/跳转不被气泡挡住。
   */
  function handleRowMenuAct(index: number): void {
    if (pageTapSwallowed()) {
      return;
    }
    const kind = rowMenuKind.value;
    const conv = rowMenuConv.value;
    const contact = rowMenuContact.value;
    closeRowMenu();
    // 气泡内点击是明确意图：清吞击位，避免 openContactChat 等入口的 rowClickIntercept 白吞
    suppressNextSwipeClick = false;
    if (kind == "conv" && conv != null) {
      if (index == 0) {
        handleConvPin(conv);
      } else if (index == 1) {
        handleConvDnd(conv);
      } else if (index == 2) {
        handleConvRemove(conv);
      }
      return;
    }
    if (kind == "group" && conv != null) {
      if (index == 0) {
        handleGroupOpen(conv);
      } else if (index == 1) {
        if (conv.myRole == 3) {
          handleGroupDissolve(conv);
        } else {
          handleGroupLeave(conv);
        }
      }
      return;
    }
    if (kind == "contact" && contact != null) {
      if (contact.status == 3) {
        if (index == 0) {
          handleContactWithdraw(contact);
        }
        return;
      }
      if (index == 0) {
        handleContactMessage(contact);
      } else if (index == 1) {
        handleContactRemark(contact);
      } else if (index == 2) {
        handleContactRemove(contact);
      }
    }
  }

  /** 确认弹窗-确认：按打开时记下的操作分发执行（弹窗组件负责关闭自身）。 */
  function handleConfirmOk(): void {
    const action = pendingAction;
    const conv = pendingConv;
    const contact = pendingContact;
    pendingAction = "";
    pendingConv = null;
    pendingContact = null;
    if (action == "contact") {
      if (contact != null) {
        removeContact(contact);
      }
      return;
    }
    if (action == "dissolve") {
      if (conv != null) {
        dissolveGroup(conv);
      }
      return;
    }
    if (action == "leave") {
      if (conv != null) {
        leaveGroup(conv);
      }
      return;
    }
    if (action == "conv") {
      if (conv != null) {
        removeConversation(conv);
      }
    }
  }

  /** 确认弹窗-取消/点遮罩：清掉待确认操作（不产生副作用）。 */
  function handleConfirmCancel(): void {
    pendingAction = "";
    pendingConv = null;
    pendingContact = null;
  }

  /** 头像真图渲染成功（@load）：字母渐变底整层退场（不垫背景色，本地首字母也不再
      与头像文件自带的字母标错位重影）；按原始 URL 记入已渲染缓存，reload 重建行
      后继承（复用的 <image> src 未变不补发 @load）；失败路径见下方 @error 系列。 */
  function handleConvAvatarLoaded(conv: ImConvRow): void {
    conv.avatarLoaded = true;
    markIconLoaded(conv.avatarUrl);
    if (conv.avatarUrl.length > 0) {
      renderedIconUrls.add(conv.avatarUrl);
    }
    // Android 不追踪原地属性变更：字母底退场同样要整表重建才生效（透明底头像防重影）
    scheduleIconTableRefresh();
  }

  function handleContactAvatarLoaded(contact: ImContactRow): void {
    contact.avatarLoaded = true;
    markIconLoaded(contact.avatarUrl);
    if (contact.avatarUrl.length > 0) {
      renderedIconUrls.add(contact.avatarUrl);
    }
    scheduleIconTableRefresh();
  }

  /** 团队 icon 渲染成功（@load）：字母退场 + 记已渲染缓存（语义同头像）。 */
  function handleSpaceIconLoaded(space: ImSpaceRow): void {
    space.iconLoaded = true;
    markIconLoaded(space.icon);
    if (space.icon.length > 0) {
      renderedIconUrls.add(space.icon);
    }
    scheduleIconTableRefresh();
  }

  /** 头像真图渲染失败：先做有限重试，连续失败后才按原始 URL 记入负缓存。 */
  function handleConvAvatarError(conv: ImConvRow): void {
    conv.avatarFailed = true;
    if (conv.avatarUrl.length > 0) {
      retryIconAfterLoadError(conv.avatarUrl);
    }
  }

  function handleContactAvatarError(contact: ImContactRow): void {
    contact.avatarFailed = true;
    if (contact.avatarUrl.length > 0) {
      retryIconAfterLoadError(contact.avatarUrl);
    }
  }

  /** 团队 icon 加载失败：先做有限重试，连续失败后回落字母渐变底。 */
  function handleSpaceIconError(space: ImSpaceRow): void {
    space.iconFailed = true;
    if (space.icon.length > 0) {
      retryIconAfterLoadError(space.icon);
    }
  }

  // ==================== IM WebSocket 事件订阅 ====================
  // IM WS 在 App.uvue onLaunch 中启动，本页订阅下行事件做会话列表局部更新。
  // 设计原则：
  // - MSG_RECV：按 convId 局部更新（避免每次都 loadConversations 全表刷）
  // - CONV_UPDATE reason=DISBANDED：从列表移除
  // - CONTACT_UPDATE：触发 GET /contacts 重拉通讯录（contract: 收到后只重拉）
  // - im_auth_invalid / im_kicked：让 useRequest 4010 链路接管，App.uvue 已 stopImWsClient

  /** bumpRowToTop 的插入半段（行已不在列表中；供顶置与 WS 克隆更新路径共用）：
   *  分区规则见 bumpRowToTop 注释。splice 即触发响应，无须再同引用回写 ref。
   *  ★声明在 bumpRowToTop/handleImMessageReceived 之前（UTS 不提升，error18）。 */
  function insertConvRowPromoted(row: ImConvRow): void {
    const list = conversations.value;
    if (row.topFlag) {
      list.splice(0, 0, row);
      return;
    }
    // 跳过置顶区；本行无草稿再跳过草稿区
    const hasDraft = getChatDraft(row.convId).length > 0;
    let insertAt = 0;
    while (insertAt < list.length && list[insertAt].topFlag) {
      insertAt++;
    }
    if (!hasDraft) {
      while (insertAt < list.length && getChatDraft(list[insertAt].convId).length > 0) {
        insertAt++;
      }
    }
    list.splice(insertAt, 0, row);
  }

  /**
   * 把一条 row 移到「其分区」最前（与 reorderConvRows 分区一致）：
   * 置顶行 → 置顶区最前（组内按最近消息时间降序，本函数仅在 lastMsgAt 更新为更大
   * 值后调用，移到最前即最新——★此前版本把它挪到置顶区末尾，破坏组内时间序）；
   * 非置顶行 → 本会话留有草稿则草稿区最前，否则草稿区之后（新消息不越过草稿行，
   * 草稿浮顶不变式在 WS 实时路径同样成立）。
   */
  function bumpRowToTop(row: ImConvRow): void {
    const list = conversations.value;
    const idx = list.indexOf(row);
    if (idx < 0) {
      return;
    }
    // 从原位置移除
    list.splice(idx, 1);
    insertConvRowPromoted(row);
  }

  function findConvRowById(convId: string): ImConvRow | null {
    const list = conversations.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].convId == convId) {
        return list[i];
      }
    }
    return null;
  }

  function handleImMessageReceived(payload: any): void {
    if (payload == null || messagePageDisposed) return;
    const obj = payload as UTSJSONObject;
    const convId = readString(obj, "convId");
    const msgId = readString(obj, "msgId");
    if (convId.length == 0 || msgId.length == 0) return;
    const key = `${convId}:${msgId}`;
    if (seenMessageIds.has(key)) return;
    seenMessageIds.add(key);
    seenMessageOrder.push(key);
    if (seenMessageOrder.length > 500) {
      seenMessageIds.delete(seenMessageOrder[0]);
      seenMessageOrder.splice(0, 1);
    }
    convRevision += 1;
    scheduleConvRefresh();
    if (!messagePageVisible || isAppInBackground()) return;
    const existing = findConvRowById(convId);
    const sendTime = readNumber(obj, "sendTime", 0);
    if (existing != null && sendTime > existing.lastMsgAt) {
      // ★换克隆再顶置：conv-row-item 按对象身份跳过重渲染，原位改摘要/时间行组件
      // 会跳过、显示旧值；克隆新身份 → 插入后该行重渲染出新摘要/时间
      const updated = cloneConvRow(existing);
      updated.lastMsgDigest = readString(obj, "digest");
      updated.lastMsgAt = sendTime;
      const list = conversations.value;
      const idx = list.indexOf(existing);
      if (idx >= 0) {
        list.splice(idx, 1);
        insertConvRowPromoted(updated);
      }
    }
    // 未读必须以服务端为准，自己发送/已读/重放都不能本地 +1。
  }

  function handleImMessagesSynced(_payload: any): void {
    convRevision += 1;
    scheduleConvRefresh();
  }

  function handleImMessageRevoked(payload: any): void {
    if (payload == null) {
      return;
    }
    convRevision += 1;
    scheduleConvRefresh();
    if (!messagePageVisible || isAppInBackground()) return;
    const obj = payload as UTSJSONObject;
    const convId = readString(obj, "convId");
    if (convId.length == 0) {
      return;
    }
    const existing = findConvRowById(convId);
    if (existing != null) {
      // 非最新消息被撤回时不能覆盖摘要，由全量刷新给出正确末条。
    }
  }

  function handleImConvUnread(payload: any): void {
    if (payload == null) {
      return;
    }
    convRevision += 1;
    scheduleConvRefresh();
    if (!messagePageVisible || isAppInBackground()) return;
    const obj = payload as UTSJSONObject;
    const convId = readString(obj, "convId");
    const unreadRaw = obj["unreadCount"];
    const unread = typeof unreadRaw === "number" ? unreadRaw : null;
    if (convId.length == 0 || unread == null) {
      // 服务端 NON_NULL 序列化：unread 整键缺失时为 null，按全表 reload 兜底
      if (convLoaded.value) {
        scheduleConvRefresh();
      }
      return;
    }
    const existing = findConvRowById(convId);
    if (existing != null) {
      // ★换克隆原位替换：conv-row-item 按对象身份跳过重渲染，纯原位写三端都要等
      // scheduleConvRefresh 全量回包才显示；克隆换身份 → 仅该行重渲染、角标即时
      const idx = conversations.value.indexOf(existing);
      if (idx >= 0) {
        const updated = cloneConvRow(existing);
        updated.unreadCount = unread;
        conversations.value.splice(idx, 1, updated);
      }
    }

  }

  /** 消费本端 read 标记（imConvReadLocal）：read 回包 unreadCleared 本地清行角标。
   *  来源端收不到自己的 CONV_UNREAD 帧（deviceId 排除），后端回显 unreadCleared 就是
   *  为来源端本地清红点设计的；行口径含免打扰，advanced=true 时置 0/按量减恒对，
   *  权威值由 onShow 300ms 去抖的 loadConversations 回包覆盖纠正。
   *  克隆换身份仅重渲该行（同 handleImConvUnread 机制，不吃整表重排）。 */
  function applyPendingConvReadMark(): void {
    const mark = consumeConvReadMark();
    if (mark == null) return;
    if (!mark.caughtUp && mark.cleared <= 0) return;
    const existing = findConvRowById(mark.convId);
    if (existing == null || existing.unreadCount <= 0) return;
    const idx = conversations.value.indexOf(existing);
    if (idx < 0) return;
    const updated = cloneConvRow(existing);
    updated.unreadCount = mark.caughtUp ? 0 : Math.max(0, existing.unreadCount - mark.cleared);
    conversations.value.splice(idx, 1, updated);
  }

  function handleImConvUpdated(payload: any): void {
    if (payload == null) {
      return;
    }
    convRevision += 1;
    scheduleConvRefresh();
    if (!messagePageVisible || isAppInBackground()) return;
    const obj = payload as UTSJSONObject;
    let reason = readString(obj, "reason");
    if (reason.length == 0) {
      reason = "PROFILE";
    }
    const convId = readString(obj, "convId");
    if (reason == "DISBANDED" && convId.length > 0) {
      // 会话被解散 → 从列表移除
      const list = conversations.value;
      const idx = list.findIndex((r): boolean => r.convId == convId);
      if (idx >= 0) {
        list.splice(idx, 1);
        conversations.value = list;
      }
      return;
    }
    // 其他 reason（PROFILE / LAST_MSG_REVOKED / LAST_MSG_EDITED / PIN_CHANGED）：
    // snapshot 是全量覆盖；服务端不保证前端字段全集，最稳妥是 reload
    if (convLoaded.value) {
      scheduleConvRefresh();
    }
  }

  function handleImContactUpdated(_payload: any): void {
    // 契约要求：收到 CONTACT_UPDATE 只重拉 GET /contacts（不提示）。联系人已随页面
    // 首拉（角标需要），去掉「已加载过」门槛让 WS 帧始终驱动角标增减；并发由
    // loadContacts 自身的 loading 守卫合并。
    // 隐藏/后台不拉（问题3）：数据仅本页消费（列表+display 名缓存，页外零引用），
    // 切回时 onShow 去抖刷新必补拉（contactLoaded||contactFailed 已覆盖曾 settles
    // 的全部状态）——契约按「下次激活补拉」履行
    if (!messagePageVisible || isAppInBackground()) return;
    loadContacts();
  }

  // ★App-Android(UTS→Kotlin) 裸函数引用传 eventBus.on 绑不上回调（编译产物原样
  // 透传函数名，运行时不成立，订阅静默失效——列表页不实时的直接原因；App.uvue/
  // imUnreadBadge 的箭头包装形态真机验证有效）。必须箭头包装；on/off 须同一引用，
  // 故存为具名 const（现写箭头字面量是不同引用，off 将匹配失败造成泄漏）。
  const onImMessagesSynced = (payload: any): void => { handleImMessagesSynced(payload); };
  const onImMessageReceived = (payload: any): void => { handleImMessageReceived(payload); };
  const onImMessageRevoked = (payload: any): void => { handleImMessageRevoked(payload); };
  const onImConvUnread = (payload: any): void => { handleImConvUnread(payload); };
  const onImConvUpdated = (payload: any): void => { handleImConvUpdated(payload); };
  const onImContactUpdated = (payload: any): void => { handleImContactUpdated(payload); };

  function clearMessageUiResources(): void {
    resolvedIconCache.forEach((url: string) => { releaseDisplayImageUrl(url); });
    resolvedIconCache.clear();
    failedIconUrls.clear();
    renderedIconUrls.clear();
    if (pressedRowTimer != 0) clearTimeout(pressedRowTimer);
    if (pageTouchResetTimer != 0) clearTimeout(pageTouchResetTimer);
    if (convRefreshTimer != 0) clearTimeout(convRefreshTimer);
    convRefreshTimer = 0;
    if (convLoadRetryTimer != 0) clearTimeout(convLoadRetryTimer);
    convLoadRetryTimer = 0;
    convLoadRetryCount = 0;
    if (iconResolveRetryTimer != 0) clearTimeout(iconResolveRetryTimer);
    iconResolveRetryTimer = 0;
    iconResolveRetryCount = 0;
    iconLoadRetryTimers.forEach((timer: number) => { clearTimeout(timer); });
    iconLoadRetryTimers.clear();
    iconLoadRetryCounts.clear();
  }

  const onImSessionCleared = (_event: any): void => {
    convRevision += 1;
    conversations.value = [];
    acceptedContacts.value = [];
    pendingInContacts.value = [];
    pendingOutContacts.value = [];
    myGroups.value = [];
    mySpaces.value = [];
    clearMessageUiResources();
    // 列表缓存同清：登出/换账号/切域名不串号（信封账号 tag 校验兜底）
    clearImListCache();
  };

  onLoad((_options: any) => {
    // 工作商业版闸门先行：未授权不发任何 IM 请求（首拉由闸门放行后在 initWorkGate
    // 里补跑——联系人原本就随页面首拉，供智联录角标与展示名索引）
    initWorkGate();
    eventBus.on(IM_SESSION_CLEARED, onImSessionCleared);
    // 订阅 IM WS 事件
    eventBus.on(`${EVENT_TYPE.ImMessagesSynced}`, onImMessagesSynced);
    eventBus.on(`${EVENT_TYPE.ImMessageReceived}`, onImMessageReceived);
    eventBus.on(`${EVENT_TYPE.ImMessageRevoked}`, onImMessageRevoked);
    eventBus.on(`${EVENT_TYPE.ImConversationUnread}`, onImConvUnread);
    eventBus.on(`${EVENT_TYPE.ImConversationUpdated}`, onImConvUpdated);
    eventBus.on(`${EVENT_TYPE.ImContactUpdated}`, onImContactUpdated);
  });

  // ===== onShow 网络刷新去抖 + 草稿脏标记（问题1）=====
  /** 300ms 去抖合并 onShow 的三个静默刷新：快速切 tab 时 300ms 内离开即整组取消，
   *  HTTP 与回包落表的风暴归零；停留则合并为一次（比原直调晚 300ms，静默刷新不可
   *  感知；列表期间显示旧数据=原网络延迟期间的表现，无新增空窗）。 */
  let showRefreshTimer = 0;
  /** 草稿版本快照（onHide 记录；-1=无快照，回退为现状必重建）。 */
  let draftsVersionAtHide = -1;

  function scheduleShowRefresh(): void {
    if (showRefreshTimer != 0) clearTimeout(showRefreshTimer);
    showRefreshTimer = setTimeout(() => {
      showRefreshTimer = 0;
      if (messagePageDisposed || !messagePageVisible || isAppInBackground()) return;
      // 手势活跃窗口内重排到动画后（问题2），其余条件与原 onShow 直调一致
      if (pageTouchActive) {
        showRefreshTimer = setTimeout(() => { scheduleShowRefresh(); }, 300);
        return;
      }
      if (convLoaded.value || convFailed.value) {
        loadConversations();
      }
      if (contactLoaded.value || contactFailed.value) {
        loadContacts();
      }
      if (groupsLoaded.value) {
        loadGroups();
      }
    }, 300);
  }

  onUnload((): void => {
    eventBus.off(IM_SESSION_CLEARED, onImSessionCleared);
    // 浮层开着时卸载：收起浮层（注销返回拦截经 watch）
    closeRowMenu();
    cancelRowLongPress();
    clearMessageUiResources();
    messagePageDisposed = true;
    messagePageVisible = false;
    convRevision += 1;
    if (convRefreshTimer != 0) clearTimeout(convRefreshTimer);
    if (iconTableRefreshTimer != 0) clearTimeout(iconTableRefreshTimer);
    if (showRefreshTimer != 0) clearTimeout(showRefreshTimer);
    if (pageTouchIdleTimer != 0) clearTimeout(pageTouchIdleTimer);
    if (pageTouchHardTimer != 0) clearTimeout(pageTouchHardTimer);
    // 注销 IM WS 事件订阅（避免页面销毁后泄漏）
    eventBus.off(`${EVENT_TYPE.ImMessagesSynced}`, onImMessagesSynced);
    eventBus.off(`${EVENT_TYPE.ImMessageReceived}`, onImMessageReceived);
    eventBus.off(`${EVENT_TYPE.ImMessageRevoked}`, onImMessageRevoked);
    eventBus.off(`${EVENT_TYPE.ImConversationUnread}`, onImConvUnread);
    eventBus.off(`${EVENT_TYPE.ImConversationUpdated}`, onImConvUpdated);
    eventBus.off(`${EVENT_TYPE.ImContactUpdated}`, onImContactUpdated);
  });

  onHide(() => {
    // 浮层开着时切走（进后台等）：收起浮层；「+」气泡同理静默收起
    // 点底部导航切 Tab 时也在这里收起浮层。按压中途切走：长按计时一并弃。
    closeRowMenu();
    cancelRowLongPress();
    addDrawerVisible.value = false;
    messagePageVisible = false;
    // 草稿脏标记快照（问题1）：回页时版本号未变则跳过同步整表重建
    draftsVersionAtHide = chatDraftsVersion();
    if (convRefreshTimer != 0) clearTimeout(convRefreshTimer);
    convRefreshTimer = 0;
    // 隐藏期不再整表替换（问题1/3）：挂起的图标表与 onShow 去抖刷新 timer 一并
    // 取消，回页 onShow 重新调度兜底（隐藏期解析回填的头像由彼时刷出）
    if (iconTableRefreshTimer != 0) clearTimeout(iconTableRefreshTimer);
    iconTableRefreshTimer = 0;
    if (showRefreshTimer != 0) clearTimeout(showRefreshTimer);
    showRefreshTimer = 0;
    // 手势标记复位（手势不可能跨隐藏期存活；3s 自清之外的兜底）
    pageTouchActive = false;
    if (pageTouchIdleTimer != 0) clearTimeout(pageTouchIdleTimer);
    pageTouchIdleTimer = 0;
    if (pageTouchHardTimer != 0) clearTimeout(pageTouchHardTimer);
    pageTouchHardTimer = 0;
  });

  // 首次 onShow 与 onLoad 重合，跳过避免重复请求；之后每次回页静默刷新
  let hasShownOnce = false;
  onShow(() => {
    syncNativeTabBarState();
    messagePageVisible = true;
    setCurrentPageNavigationBarTitle();
    refreshImUnreadBadge();
    // 本端刚读过的会话：read 回包 unreadCleared 本地清行角标（不等 300ms 去抖全量刷新）
    applyPendingConvReadMark();
    // 闸门缓存复查（同步读，开销可忽略）：登录页/其他 Tab 拉租户配置会写缓存，
    // 授权态翻转就地生效——撤销即停 WS 清角标，恢复即解锁补首拉
    if (isWorkCommercialBlockedSync()) {
      applyWorkGateBlocked();
    } else if (workGateBlocked.value && !workGatePending.value) {
      // 授权恢复：解除拦截 + 重启 WS（stop 曾置 manualClosed，需 init 复位）+ 补角标与首拉
      //（blocked 期间从未拉过、表为空，先水合缓存秒出再补拉——与 initWorkGate 同款 SWR）
      workGateBlocked.value = false;
      initImWsClient();
      refreshImUnreadBadge();
      hydrateConversationsFromCache();
      hydrateContactsFromCache();
      loadConversations();
      loadContacts();
    }
    if (!hasShownOnce) {
      hasShownOnce = true;
      return;
    }
    // 从聊天页返回且草稿确有写入（隐藏前后版本号变化）才同步整表重建：让「[草稿]xxx」
    // 即时上屏 + 按草稿态本地重排（草稿会话浮到置顶区，免等网络往返才跳动位置，
    // reorderConvRows 与网络刷新同规则）。隐藏期无草稿写入则跳过——快速切 tab 不再
    // 每次激活都同步整表重渲染（问题1主因；隐藏期 reorder 输入只可能来自草稿：置顶
    // 仅本页可改、WS 本地更新本就有隐藏守卫）。版本号无快照（-1）时回退为必重建。
    if (chatDraftsVersion() != draftsVersionAtHide) {
      // 深克隆（非浅 copyRows）：草稿是模块态，conv-row-item 读它靠行对象身份变化
      // 触发重渲染——浅拷只换数组身份，行组件会跳过、草稿不上屏
      conversations.value = reorderConvRows(cloneConvRows(conversations.value));
    }
    // 保留：兜底隐藏期异步解析的头像原地回填与相对时间刷新（50ms 后、激活首帧之外；
    // timer 回调内有手势/隐藏守卫，见 runIconTableRefresh）
    scheduleIconTableRefresh();
    // 失败态也重载：首拉失败（含自动重试耗尽）后切回页面自愈，不必等用户手点
    // 「点击重试」；300ms 去抖合并（快速切走即整组取消，见 scheduleShowRefresh）
    scheduleShowRefresh();
  });
</script>

<style lang="scss" scoped>
  .im-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #ffffff;
  }

  /* 页头样式（.im-header / .im-tab 族 / .im-action 族 / .im-header-line）已随 im-header-tabs
     组件迁移（Stage 3）；Android 加号补层切换 .im-action--covered 规则同迁（App 端
     scoped 样式按组件解析，跨组件不生效）。 */

  /* 右上角「+」气泡全屏承接蒙层：fixed 四边贴 0（confirm-modal 同款结构）、近透明
     不压暗；气泡挂其内（z-index 998 > 蒙层 997）。★Android 蒙层触摸为事件黑洞暂缓
     （拦住不派发，点外关闭暂不可用，见模板注释）。 */
  .add-drawer-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 997;
    background-color: rgba(0, 0, 0, 0.01);
  }

  .add-header-dismiss-overlay {
    position: fixed;
    z-index: 998;
    background-color: rgba(0, 0, 0, 0);
  }

  .add-plus-overlay {
    position: fixed;
    z-index: 999;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* 双页 swiper（专家页同款）：占满 header 以下剩余高度，横滑与内部纵向滚动原生仲裁 */
  .im-body {
    flex: 1;
    min-height: 0;
  }

  /* 列表态样式（.im-pane/.im-state/.im-foot）与行样式（.chat-item 全族等）已随
     conv-list-pane / contact-list-pane 迁移（Stage 4/5）——两 pane 各持一份
     .chat-item 全族并互相同步（App 端 scoped 样式按组件解析，跨组件不生效）。 */

  /* 工作商业版闸门整页态：未授权=居中提示语；未定=加载占位。
     flex:1 占满 header 以下（im-page 是 flex column，闸门态下 header/swiper 不渲染） */
  .work-gate {
    flex: 1;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .work-gate__text {
    font-size: 14px;
    line-height: 20px;
    color: #94929c;
    text-align: center;
  }

</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  /* #endif */
  /* #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || MP-LARK || MP-KUAISHOU || MP-JD */
  page {
    height: 100%;
  }
  /* #endif */
</style>
