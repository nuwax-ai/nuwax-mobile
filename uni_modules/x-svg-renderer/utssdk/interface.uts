export type SvgFit = 'contain' | 'cover' | 'fill' | 'center'

export type NativeSvgRendererListener = (message: string | null) => void

export interface NativeSvgRendererContract {
  setListener(listener: NativeSvgRendererListener): void
  setFit(fit: string): void
  setSvg(content: string): void
  clear(): void
  destroy(): void
}
