<template>
  <!--
    会中页（会议信息页的飞书式布局，媒体层未接入时的骨架）。

    ★布局对齐飞书会中画面：左上「返回 + 会议信息」、中间舞台（当前只有自己的头像/昵称）、
      底部固定五个入口「麦克风 / 摄像头 / 扬声器 / 参会人 / 更多」。
      按需求去掉了飞书的 AI 总结、"说点什么" 输入框和右上角气泡，也暂不放挂断按钮
      （媒体层接入后与「结束会议 / 仅退出」一起做）。
    ★「会议信息」点开是底部面板：会议号/入会密码/入会链接/开始时间·已进行/参会人/
      复制邀请信息 —— 字段与顺序对齐 PC `MeetingInfoPanel.tsx`。
    ★数据分两层：先用手上（列表/发起页）传进来的投影渲染，再打 `GET /meetings/{id}`
      补成员与服务端权威值；id 缺失时按会议号在首页记录里反查一次。

    ★当前页面已接入 Android/iOS LiveKit 会中聊天；屏幕共享接入 Android MediaProjection
      与 iOS ReplayKit 广播扩展整屏采集；基座必须包含对应原生能力。
      鸿蒙隔离测试包使用 ArkWeb 媒体舞台。
  -->
  <view class="mr-page">
    <safety-zone />

    <view class="mr-header">
      <view class="mr-header__btn" hover-class="mr-header__btn--active" @click="handleBack">
        <back-chevron :size="20" color="#141416" />
      </view>
      <!-- 标题即「会议信息」入口（飞书同款）：点开底部面板看会议号/密码/链接等 -->
      <view class="mr-header__main" hover-class="mr-header__main--active" @click="openSheet('info')">
        <text class="mr-header__title">{{ t("Mobile.Meeting.infoTitle") }}</text>
        <svg-icon name="icon-a-Chevrondown" size="12" unit="px" color="#8f8f99" />
      </view>
      <!-- 右上角：主持人选择「仅退出 / 结束会议」，普通参会人直接退出 -->
      <view class="mr-header__btn" hover-class="mr-header__btn--active" @click="handleLeaveOrEnd">
        <view class="mr-header__end">
          <svg-icon class="mr-header__end-icon" name="icon-Exit" size="15" unit="px" color="#ffffff" />
        </view>
      </view>
    </view>

    <!-- 会中计时（飞书标题下那一行）：`12:05（限时 2小时）`，只有进行中才有；
         多人时这一行右侧挂「布局」入口（宫格 / 顶部缩略图 / 侧边缩略图 / 演讲者） -->
    <view v-if="clockText.length > 0 || !stageSolo" class="mr-clock">
      <text v-if="clockText.length > 0" class="mr-clock__text">{{ clockText }}</text>
      <text
        v-if="limitStateText.length > 0"
        class="mr-clock__limit"
        :class="{ 'mr-clock__limit--warn': limitWarn }"
      >{{ limitStateText }}</text>
      <view class="mr-clock__spacer" />
      <view
        v-if="!stageSolo"
        class="mr-clock__layout"
        hover-class="mr-stage__switch--active"
        @click="toggleLayoutPicker"
      >
        <svg-icon :name="layoutEntryIcon" size="13" unit="px" color="#4e5969" />
        <text class="mr-clock__layout-text">{{ t("Mobile.Meeting.layoutTitle") }}</text>
      </view>
    </view>

    <!-- 舞台容器：占满剩余高度，底部工具条因此始终钉在页面底部 -->

    <!--
      舞台（对齐飞书会中画面）：
      · 只有我一个人 → 收缩成一块小卡片（不再占满整屏），中间是大头像；开摄像头时用原生预览替代；
      · 有别人加入（PC/另一台手机等任意端）→ 变成卡片网格，每人一张（头像 + 昵称 + 主持人标）。
      ★在线成员来自 `GET /rtc/rooms/{room}/participants`（5 秒轮询）：这是服务端转查 LiveKit
        的结果，比 SDK 事件简单可靠；`room.events` 的事件流等下一批再接。
    -->
    <view class="mr-body">
    <view class="mr-stage" :class="{ 'mr-stage--solo': stageSolo }">
      <!-- #ifdef APP-HARMONY -->
      <native-view v-if="mediaSupported && meetingStageEnabled" class="mr-harmony-stage"
        :class="{ 'mr-harmony-stage--hidden': !harmonyMediaVisible }" @init="handleHarmonyStageInit" />
      <template v-if="!harmonyMediaVisible">
      <!-- #endif -->
      <!-- #ifdef APP-ANDROID || APP-IOS -->
      <!-- 原生视频视图（Android SurfaceViewRenderer / iOS LiveKit VideoView）：
           独自一人 + 开摄像头 + 已连上时挂载，init 里把原生 View 绑到 native-view 上。
           鸿蒙使用独立的 ArkWeb 舞台。 -->
      <native-view v-if="showSelfVideo" class="mr-stage__video" @init="handleVideoInit" />
      <!-- #endif -->

      <!-- 视频层左上角：切换前后摄像头（默认前置） -->
      <view v-if="showSelfVideo" class="mr-stage__switch" hover-class="mr-stage__switch--active" @click="handleSwitchCamera">
        <image class="mr-stage__switch-img" src="/static/voip/call-icons/switch-camera-white.png" mode="aspectFit" />
      </view>

      <!-- 独自一人：一张居中大卡片，中间大头像（开摄像头时由原生预览替代） -->
      <view v-if="stageSolo && !showSelfVideo" class="mr-avatar-big">
        <image
          v-if="myStageAvatar.length > 0 && myAvatarFailed != true"
          class="mr-avatar-big__img"
          :src="myStageAvatar"
          mode="aspectFill"
          @error="handleMyAvatarError"
        />
        <text v-else class="mr-avatar-big__text">{{ myInitial }}</text>
      </view>

      <!--
        多人：宫格（对齐飞书「宫格视图」）
        · ≤4 人 2×2；5–9 人 3×3；超过 9 人分页（底部 ‹ 1/3 › 翻页）。
        · 每格 = 头像/首字 + 昵称 + 主持人标；空位补格子保证行内等宽。
      -->
      <view
        v-else-if="!stageSolo && shareFullKey.length == 0"
        class="mr-grid"
        :class="{
          'mr-grid--full': singleCell,
          'mr-grid--stack': gridStack,
          'mr-grid--topThumbs': stageLayout == 'topThumbs',
          'mr-grid--sideThumbs': stageLayout == 'sideThumbs'
        }"
      >
        <!-- ★铺满态（放大/大图布局）的尺寸类必须直接绑在节点自己身上（--fill），
             不要用「祖先类 + 后代选择器」：Android 上祖先类变了，后代的样式不会重算，
             切换布局后格子会残留旧尺寸（padding 0 / 头像 104px 留在宫格里、行撑不满等）。 -->
        <view
          v-for="row in displayRows"
          :key="row.key"
          class="mr-grid__row"
          :class="{ 'mr-grid__row--fill': singleCell, 'mr-grid__row--stack': gridStack }"
        >
          <view
            v-for="tile in row.items"
            :key="tile.key"
            class="mr-tile"
            :class="{ 'mr-tile--compact': pageCols == 3, 'mr-tile--fill': singleCell, 'mr-tile--stack': gridStack }"
          >
            <view
              class="mr-tile__avatar"
              :class="{ 'mr-tile__avatar--compact': pageCols == 3, 'mr-tile__avatar--fill': singleCell, 'mr-tile__avatar--stack': gridStack }"
            >
              <!-- #ifdef APP-ANDROID || APP-IOS -->
              <!-- 远端已订阅到视频：格子里用原生画面盖住头像 -->
              <native-view
                v-if="tile.hasVideo"
                class="mr-tile__video"
                @init="handleTileVideoInit($event, tile)"
              />
              <!-- #endif -->
              <!-- 有视频时**不渲染头像**：否则头像会盖在画面上（用户反馈"视频中间又出头像"） -->
              <image
                v-if="!tile.hasVideo && tile.avatar.length > 0 && tile.avatarFailed != true"
                class="mr-tile__img"
                :class="{ 'mr-tile__img--compact': pageCols == 3, 'mr-tile__img--fill': singleCell }"
                :src="tile.avatar"
                mode="aspectFill"
                @error="handleTileAvatarError(tile)"
              />
              <text
                v-else-if="!tile.hasVideo"
                class="mr-tile__initial"
                :class="{ 'mr-tile__initial--compact': pageCols == 3, 'mr-tile__initial--fill': singleCell }"
              >{{ tile.initial }}</text>

              <!-- 我的卡片左上角：切换前后摄像头（与单人卡片一致，宫格里也要能切） -->
              <!-- #ifdef APP-ANDROID || APP-IOS -->
              <view
                v-if="tile.isMe && tile.hasVideo"
                class="mr-tile__switch"
                hover-class="mr-stage__switch--active"
                @click.stop="handleSwitchCamera"
              >
                <image class="mr-tile__switch-img" src="/static/voip/call-icons/switch-camera-white.png" mode="aspectFit" />
              </view>
              <!-- #endif -->

              <!-- 有人在共享：在共享者卡片右上角给一个全屏入口 -->
              <view
                v-if="tile.keepsShare && tile.hasVideo && !tile.isMe"
                class="mr-tile__fullscreen"
                :class="{ 'mr-tile__fullscreen--compact': pageCols == 3, 'mr-tile__fullscreen--fill': singleCell }"
                hover-class="mr-stage__switch--active"
                @click.stop="openShareFullscreen(tile)"
              >
                <image class="mr-tile__fullscreen-img" src="/static/images/icon-fullscreen.svg" mode="aspectFit" />
              </view>

              <!-- 举手标：格子左上角放大展示（原来是名字条里 9px 的小图标，太小看不见）。
                   自己开视频时左上角是切换摄像头按钮，举手标右移让位。 -->
              <view
                v-if="tile.handRaised"
                class="mr-tile__hand"
                :class="{ 'mr-tile__hand--compact': pageCols == 3, 'mr-tile__hand--shift': tile.isMe && tile.hasVideo }"
              >
                <image class="mr-tile__hand-img" src="/static/images/icon-hand.svg" mode="aspectFit" />
              </view>

              <!-- 名字 + 主持人标：压在卡片左下角（飞书同款） -->
              <view class="mr-tile__name-wrap">
                <!-- 麦克风与底部工具条同源；不再用红色表示关闭 -->
                <image
                  class="mr-tile__status-img"
                  mode="aspectFit"
                  :src="(tile.isMe ? micOn : tile.micOn) ? '/static/voip/call-icons/microphone-ink.png' : '/static/voip/call-icons/microphone-off-ink.png'"
                />
                <text class="mr-tile__name text-ellipsis" :lines="1">{{ tile.name }}</text>
                <text v-if="tile.host" class="mr-tile__host">{{ t("Mobile.Meeting.hostBadge") }}</text>
                <text v-if="tile.host && recordingOn" class="mr-tile__rec">REC</text>
              </view>

              <!-- 点整格：放大到整个舞台容器；再点一下还原。
                   ★必须是一张透明命中层盖在原生视频之上：原生 SurfaceView/VideoView 会吞掉父级的点击。
                   层级：本层 z=3（在名字条之上），切换摄像头/共享全屏 z=4（仍在最上面可点）。 -->
              <view class="mr-tile__hit" @click="handleTileTap(tile)" />
            </view>
          </view>
          <!-- 末行补位：保证每行格子等宽 -->
          <view
            v-for="slot in row.empties"
            :key="slot"
            class="mr-tile"
            :class="{ 'mr-tile--compact': pageCols == 3 }"
          />
        </view>
      </view>

      <!-- 缩略图条（顶部 / 侧边布局）：绝对定位在舞台里，大图区靠 grid 的 padding 让位。
           ★必须放在宫格之后：它是独立的 v-if，插在宫格前面会把上面的 v-if/v-else-if 链拆断。
           ★顶部条与侧边条是**两个独立节点**（不是同一个节点切 class）：Android 上
             scroll-view 的 direction 与内层 flex-direction 在节点复用时不会跟着变，
             会残留成「顶部条里竖着排 / 侧边条里横着排」，表现为只看见一个缩略图。 -->
      <scroll-view
        v-if="stageLayout == 'topThumbs' && thumbsVisible && shareFullKey.length == 0"
        class="mr-thumbs mr-thumbs--top"
        direction="horizontal"
        :show-scrollbar="false"
      >
        <!-- 内层 flex 容器：scroll-view 自身不负责排布方向，横排靠这个 view 的 flex-direction；
             宽由 thumbsInnerStyle 显式给出（否则被压成视口大小、滑不动） -->
        <view class="mr-thumbs__inner mr-thumbs__inner--top" :style="thumbsInnerStyle">
          <view
            v-for="tile in stageThumbs"
            :key="'thumb-top-' + tile.key"
            class="mr-thumb"
            :class="{ 'mr-thumb--on': isStageMain(tile) }"
            hover-class="mr-thumb--active"
            @click="selectStageMain(tile)"
          >
            <image
              v-if="tile.avatar.length > 0 && tile.avatarFailed != true"
              class="mr-thumb__img"
              :src="tile.avatar"
              mode="aspectFill"
              @error="handleTileAvatarError(tile)"
            />
            <text v-else class="mr-thumb__initial">{{ tile.initial }}</text>
          </view>
        </view>
      </scroll-view>

      <scroll-view
        v-else-if="stageLayout == 'sideThumbs' && thumbsVisible && shareFullKey.length == 0"
        class="mr-thumbs mr-thumbs--side"
        direction="vertical"
        :show-scrollbar="false"
      >
        <view class="mr-thumbs__inner mr-thumbs__inner--side" :style="thumbsInnerStyle">
          <view
            v-for="tile in stageThumbs"
            :key="'thumb-side-' + tile.key"
            class="mr-thumb"
            :class="{ 'mr-thumb--on': isStageMain(tile) }"
            hover-class="mr-thumb--active"
            @click="selectStageMain(tile)"
          >
            <image
              v-if="tile.avatar.length > 0 && tile.avatarFailed != true"
              class="mr-thumb__img"
              :src="tile.avatar"
              mode="aspectFill"
              @error="handleTileAvatarError(tile)"
            />
            <text v-else class="mr-thumb__initial">{{ tile.initial }}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 单格放大：右上角「返回宫格」（再点一下卡片本身也会还原；系统返回键同样先还原） -->
      <view v-if="gridFull" class="mr-focus-exit" hover-class="mr-stage__switch--active" @click.stop="exitTileFocus">
        <svg-icon class="mr-focus-exit__icon" name="icon-X" size="16" unit="px" color="#ffffff" />
      </view>

      <!-- 弹幕飘屏：自驱子组件（定时器驱动位移，只重渲自身，不拖累整页）。
           队列由 drainMeetingChat 在收到 danmaku 消息时 push。 -->
      <!-- #ifndef APP-HARMONY -->
      <meeting-danmaku />
      <!-- #endif -->

      <!-- 分页器（只在超过一页时出现；放大/大图布局时整屏只有一格，不需要翻页） -->
      <view v-if="pageCount > 1 && !singleCell" class="mr-pager">
        <text class="mr-pager__btn" @click="prevPage">‹</text>
        <text class="mr-pager__text">{{ pageLabel }}</text>
        <text class="mr-pager__btn" @click="nextPage">›</text>
      </view>

      <!-- 名字条：单人卡片左下角（开视频时压在画面左下角，飞书同款）。多人时名字在各自卡片里，不重复 -->
      <view v-if="stageSolo" class="mr-stage__foot">
        <image class="mr-stage__status-img" mode="aspectFit"
          :src="micOn ? '/static/voip/call-icons/microphone-ink.png' : '/static/voip/call-icons/microphone-off-ink.png'" />
        <text class="mr-stage__name">{{ myLabel }}</text>
        <text v-if="isHost && recordingOn" class="mr-stage__rec">REC</text>
      </view>
      <!-- #ifdef APP-HARMONY -->
      </template>
      <view v-if="harmonyMediaVisible && gridFull" class="mr-focus-exit"
        hover-class="mr-stage__switch--active" @click.stop="exitTileFocus">
        <svg-icon class="mr-focus-exit__icon" name="icon-X" size="16" unit="px" color="#ffffff" />
      </view>
      <view v-if="harmonyMediaVisible && pageCount > 1 && !singleCell" class="mr-pager">
        <text class="mr-pager__btn" @click="prevPage">‹</text>
        <text class="mr-pager__text">{{ pageLabel }}</text>
        <text class="mr-pager__btn" @click="nextPage">›</text>
      </view>
      <meeting-danmaku />
      <!-- #endif -->
    </view>
    </view>

    <!-- 共享全屏：点任意处退出；宫格此时已卸载，原生视图重新绑定到这一格 -->
    <view v-if="shareFullKey.length > 0" class="mr-fs" @click="closeShareFullscreen">
      <!-- #ifdef APP-ANDROID || APP-IOS -->
      <native-view v-if="videoBridgeReady" class="mr-fs__video" @init="handleFullscreenVideoInit" />
      <!-- #endif -->
      <view class="mr-fs__bar">
        <text class="mr-fs__name">{{ shareFullName }}</text>
        <view class="mr-fs__close" hover-class="mr-stage__switch--active" @click.stop="closeShareFullscreen">
          <svg-icon name="icon-X" size="18" unit="px" color="#ffffff" />
        </view>
      </view>
    </view>

    <!-- 底部操作区：5 列网格，最后一格固定是收起/展开箭头（底部安全区内联补，见 toolsStyle）。
         展开：动作按 5 个一排排布，最后一个动作之后补空格，箭头落在最后一排的最后一格；
         收起：只留箭头那一排。舞台上移填满由 flex 自适应，不用手动算高度。 -->
    <view class="mr-actions" :class="{ 'mr-actions--collapsed': !actionsVisible }" :style="toolsStyle">
      <view v-for="(row, ri) in actionRows" :key="'ar-' + ri" class="mr-actions__row">
        <view
          v-for="cell in row"
          :key="cell.key"
          class="mr-action"
          :class="{ 'mr-action--empty': cell.kind == 'empty' }"
          :hover-class="cell.kind == 'empty' ? 'none' : 'mr-action--active'"
          @click="handleCellTap(cell)"
        >
          <template v-if="cell.kind == 'action'">
            <view class="mr-action__icon" :class="{ 'mr-action__icon--on': cell.on }">
              <image v-if="cell.image.length > 0" class="mr-action__img" :src="cell.image" mode="aspectFit" />
              <!-- 视觉重心偏左的字形（弹幕）：给图标本身挂偏移类。★不要给外框加 left，
                   也不要用 padding —— 外框是 flex 居中，padding 只会挪一半，实测不生效。 -->
              <svg-icon
                v-else-if="cell.iconShift > 0"
                class="mr-action__glyph-shift"
                :name="cell.icon"
                size="20"
                unit="px"
                color="#283633"
              />
              <svg-icon v-else :name="cell.icon" size="20" unit="px" color="#283633" />
              <!-- 未读角标（会中聊天） -->
              <view v-if="cell.badge > 0" class="mr-more-badge mr-more-badge--sm">
                <text class="mr-more-badge__text">{{ cell.badgeText }}</text>
              </view>
            </view>
            <text class="mr-action__label" :lines="1">{{ cell.label }}</text>
          </template>
          <!-- 空格什么都不画；箭头格画上/下箭头 -->
          <svg-icon v-else-if="cell.kind == 'arrow'" :name="cell.icon" size="16" unit="px" color="#4e5969" />
        </view>
      </view>
    </view>

    <!-- 底部面板：会议信息 / 参会人 / 布局 / 邀请参会人 / 会中聊天（tap 遮罩关闭） -->
    <view v-if="sheet.length > 0" class="mr-mask" @click="closeSheet">
      <view class="mr-sheet" :class="{ 'mr-sheet--chat': sheet == 'chat' }" :style="sheetStyle" @click.stop>
        <view v-if="sheet == 'chat'" class="mr-chat-head">
          <text class="mr-chat-head__title">{{ t("Mobile.Meeting.meetingChat") }}</text>
          <view class="mr-chat-head__actions">
            <!-- 弹幕开关只有主持人有：参会人聊天弹窗不展示这个按钮（开关是房间级设置） -->
            <view
              v-if="isHost"
              class="mr-chat-danmaku"
              :class="{ 'mr-chat-danmaku--on': danmakuOn }"
              hover-class="mr-chat-danmaku--active"
              @click="handleDanmakuTap"
            >
              <text class="mr-chat-danmaku__text">{{ t("Mobile.Meeting.danmaku") }}</text>
            </view>
            <view class="mr-chat-close" hover-class="mr-chat-close--active" @click="closeSheet">
              <text class="mr-chat-close__text">×</text>
            </view>
          </view>
        </view>
        <view v-else class="mr-sheet__head">
          <text class="mr-sheet__title">{{ sheetTitle }}</text>
          <view class="mr-sheet__close" hover-class="mr-sheet__close--active" @click="closeSheet">
            <svg-icon name="icon-X" size="16" unit="px" color="#646a73" />
          </view>
        </view>

        <view v-if="sheet == 'chat'" class="mr-chat-content">
          <scroll-view class="mr-chat-list" direction="vertical" :show-scrollbar="false" :scroll-top="chatScrollTop">
            <view v-if="chatMessages.length == 0" class="mr-chat-empty">
                <text class="mr-chat-empty__text">{{ t("Mobile.Terminal.noMessages") }}</text>
            </view>
            <view
              v-for="(message, index) in chatMessages"
              :key="index"
              class="mr-chat-row"
              :class="{ 'mr-chat-row--self': message.self }"
            >
              <view class="mr-chat-bubble" :class="{ 'mr-chat-bubble--self': message.self }">
                <text class="mr-chat-name">{{ message.self ? "我" : message.name }}</text>
                <!-- 会中聊天按 markdown 渲染（智能体入会后会发 markdown 内容）：
                     App 端复用 AI 消息渲染器（与 ai-msg 同一套 app-trace-markdown）；
                     其它端媒体层不可用、聊天面板开不出来，保留纯文本兜底。 -->
                <!-- #ifdef APP-ANDROID || APP-IOS || APP-HARMONY -->
                <view class="mr-chat-md">
                  <app-trace-markdown :content="message.text" />
                </view>
                <!-- #endif -->
                <!-- #ifndef APP-ANDROID || APP-IOS || APP-HARMONY -->
                <text class="mr-chat-text">{{ message.text }}</text>
                <!-- #endif -->
              </view>
            </view>
          </scroll-view>
          <view class="mr-chat-compose">
            <input
              class="mr-chat-input"
              :value="chatInput"
              :maxlength="-1"
              :placeholder="chatPlaceholder"
              confirm-type="send"
              @input="handleChatInput"
              @confirm="sendMeetingChatMessage"
            />
            <view
              class="mr-chat-send"
              :class="{ 'mr-chat-send--disabled': !chatCanSend }"
              hover-class="mr-chat-send--active"
              @click="sendMeetingChatMessage"
            >
              <!-- 白色发送 icon 视觉居中偏左 2px，整体右移补一下 -->
              <view class="mr-chat-send__icon">
                <svg-icon name="icon-send" size="20" unit="px" :color="chatCanSend ? '#ffffff' : '#a8abb2'" />
              </view>
            </view>
          </view>
        </view>

        <scroll-view v-else class="mr-sheet__body" direction="vertical" :show-scrollbar="false">
          <!-- 会议信息：字段与顺序对齐 PC 面板 -->
          <template v-if="sheet == 'info'">
            <!-- 会议主题（PC 面板第一项），空标题回落到「会议 123 456 789」 -->
            <text class="mr-sheet__topic" :lines="2">{{ pageTitle }}</text>

            <view class="mr-row">
              <text class="mr-label">{{ t("Mobile.Meeting.statusLabel") }}</text>
              <view :class="tagClass">
                <text :class="tagTextClass">{{ statusText }}</text>
              </view>
            </view>

            <view class="mr-row">
              <text class="mr-label">{{ t("Mobile.Meeting.roomNoLabel") }}</text>
              <view class="mr-value-row">
                <text class="mr-no">{{ formattedRoom }}</text>
                <text
                  v-if="formattedRoom.length > 0"
                  class="mr-pill"
                  hover-class="mr-pill--active"
                  @click="handleCopyNo"
                >{{ t("Mobile.Meeting.copyNoShort") }}</text>
              </view>
            </view>

            <!-- 入会密码：只有主持人会去拉明文；拿不到明文**不能藏整行**
                 （藏掉会让人以为这场会没密码，把链接直接发出去别人却进不来） -->
            <view v-if="passcodeState != 'hidden'" class="mr-row">
              <text class="mr-label">{{ t("Mobile.Meeting.passcodeLabel") }}</text>
              <view class="mr-value-row">
                <text v-if="passcodeState == 'value'" class="mr-no">{{ passcodeValue }}</text>
                <text v-else-if="passcodeState == 'loading'" class="mr-value mr-value--muted">…</text>
                <text v-else class="mr-value mr-value--muted">{{ t("Mobile.Meeting.passcodeUnavailable") }}</text>
                <text
                  v-if="passcodeState == 'value' && passcodeValue.length > 0"
                  class="mr-pill"
                  hover-class="mr-pill--active"
                  @click="handleCopyPasscode"
                >{{ t("Mobile.Meeting.copyNoShort") }}</text>
              </view>
            </view>

            <view v-if="startText.length > 0" class="mr-row">
              <text class="mr-label">{{ t("Mobile.Meeting.startTimeLabel") }}</text>
              <text class="mr-value">{{ startTextWithElapsed }}</text>
            </view>

            <view class="mr-row">
              <text class="mr-label">{{ t("Mobile.Meeting.membersLabel") }}</text>
              <text class="mr-value">{{ membersCountText }}</text>
            </view>

            <view v-if="failed" class="mr-failed" @click="handleRetry">
              <text class="mr-failed__text">{{ t("Mobile.Meeting.loadFailed") }}</text>
            </view>

            <view class="mr-sheet__foot">
              <view
                class="mr-primary"
                hover-class="mr-primary--active"
                @click="handleCopyInvite"
              >
                <text class="mr-primary__text">{{ t("Mobile.Meeting.copyInviteInfo") }}</text>
              </view>
            </view>
          </template>

          <!-- 参会人：记录口径（预约时邀请的人 + 实际入会的人），主持人排最前 -->
          <template v-else-if="sheet == 'members'">
            <!-- 会中在线成员（可管理）：主持人可静音 / 禁止发言 / 移出 -->
            <view v-if="tiles.length > 0" class="mr-members">
              <view v-for="tile in tiles" :key="tile.key" class="mr-member mr-member--tile">
                <view class="mr-member__line">
                  <view v-if="tile.avatar.length > 0 && tile.avatarFailed != true" class="mr-avatar">
                    <image class="mr-avatar__img" :src="tile.avatar" mode="aspectFill" @error="handleTileAvatarError(tile)" />
                  </view>
                  <view v-else class="mr-avatar">
                    <text class="mr-avatar__text">{{ tile.initial }}</text>
                  </view>
                  <text class="mr-member__name text-ellipsis" :lines="1">{{ tile.name }}</text>
                  <view v-if="tile.host" class="mr-badge">
                    <text class="mr-badge__text">{{ t("Mobile.Meeting.hostBadge") }}</text>
                  </view>
                  <!-- 静音徽标：自己这一行用本机实时状态（micOn），别等 3 秒轮询的 tile.micOn -->
                  <view v-if="tile.isMe ? !micOn : !tile.micOn" class="mr-badge mr-badge--muted">
                    <text class="mr-badge__text mr-badge__text--muted">{{ t("Mobile.Meeting.mutedBadge") }}</text>
                  </view>
                  <view v-if="!tile.canPublish" class="mr-badge mr-badge--muted">
                    <text class="mr-badge__text mr-badge__text--muted">{{ t("Mobile.Meeting.speakDisabledBadge") }}</text>
                  </view>
                </view>
                <!-- 主持人操作：只对别人显示（自己那份不给按钮） -->
                <view v-if="isHost && !tile.isMe" class="mr-member__acts">
                  <!-- 麦克风按钮只管静音/取消静音；「允许发言」只属于下面那个发言权限按钮。
                       ★不能再按 !canPublish 把这里也改成「允许发言」：智能体（canPublish=false 且
                         未开麦）会同时出现两个「允许发言」（用户反馈）。 -->
                  <view
                    v-if="tile.canPublish || tile.micOn"
                    class="mr-act"
                    hover-class="mr-act--active"
                    @click="handleMuteTile(tile)"
                  >
                    <text class="mr-act__text">{{ tile.micOn ? t("Mobile.Meeting.muteMember") : t("Mobile.Meeting.unmuteMember") }}</text>
                  </view>
                  <view
                    class="mr-act"
                    hover-class="mr-act--active"
                    @click="handleToggleSpeak(tile)"
                  >
                    <text class="mr-act__text">{{ tile.canPublish ? t("Mobile.Meeting.disableSpeak") : t("Mobile.Meeting.enableSpeak") }}</text>
                  </view>
                  <view
                    class="mr-act mr-act--danger"
                    hover-class="mr-act--active"
                    @click="handleKickTile(tile)"
                  >
                    <text class="mr-act__text mr-act__text--danger">{{ t("Mobile.Meeting.kickMember") }}</text>
                  </view>
                </view>
              </view>
            </view>

            <!-- 未入会（预约/已结束）：退回记录里的参会人，只读 -->
            <view v-else-if="membersState == 'loading' && members.length == 0" class="mr-sec-state">
              <text class="mr-sec-state__text">{{ t("Mobile.Common.loading") }}</text>
            </view>
            <!-- 拉失败时给可点重试，不谎报「暂无参会人」 -->
            <view v-else-if="members.length == 0 && membersState == 'failed'" class="mr-failed" @click="handleRetry">
              <text class="mr-failed__text">{{ t("Mobile.Meeting.loadFailed") }}</text>
            </view>
            <view v-else-if="members.length == 0" class="mr-sec-state">
              <text class="mr-sec-state__text">{{ t("Mobile.Meeting.membersEmpty") }}</text>
            </view>
            <view v-else class="mr-members">
              <view v-for="m in members" :key="m.userId" class="mr-member">
                <view class="mr-avatar">
                  <text class="mr-avatar__text">{{ m.initial }}</text>
                </view>
                <text class="mr-member__name text-ellipsis" :lines="1">{{ m.name }}</text>
                <view v-if="m.host" class="mr-badge">
                  <text class="mr-badge__text">{{ t("Mobile.Meeting.hostBadge") }}</text>
                </view>
              </view>
            </view>
          </template>

          <!-- 布局：宫格 / 顶部缩略图 / 侧边缩略图 / 演讲者（选中行浅蓝底 + 右侧勾） -->
          <template v-else-if="sheet == 'layout'">
            <view class="mr-layout-list">
              <view
                v-for="opt in layoutOptions"
                :key="opt.value"
                class="mr-layout-item"
                :class="{ 'mr-layout-item--on': stageLayout == opt.value }"
                hover-class="mr-layout-item--active"
                @click="setStageLayout(opt.value)"
              >
                <svg-icon
                  class="mr-layout-item__icon"
                  :name="opt.icon"
                  size="20"
                  unit="px"
                  :color="stageLayout == opt.value ? '#3370ff' : '#a8abb2'"
                />
                <view class="mr-layout-item__body">
                  <text
                    class="mr-layout-item__title"
                    :class="{ 'mr-layout-item__title--on': stageLayout == opt.value }"
                  >{{ opt.title }}</text>
                  <text class="mr-layout-item__desc">{{ opt.desc }}</text>
                </view>
                <svg-icon v-if="stageLayout == opt.value" name="icon-Check" size="16" unit="px" color="#3370ff" />
              </view>
            </view>
          </template>

          <!-- 邀请参会人：原「更多」面板里的选人块，改成独立底部弹层（用户要求从底部拉起） -->
          <template v-else-if="sheet == 'invite'">
            <view class="mr-invite-panel">
              <view class="mr-invite-panel__head">
                <view class="mr-invite-panel__head-row">
                  <text class="mr-invite-panel__title">{{ t("Mobile.Meeting.inviteesLabel") }}</text>
                  <view class="mr-invite-panel__spacer" />
                  <!-- 刷新：重拉联系人 + 立刻重判「谁已在会里」，退会的人马上可以再勾（图标同历史会议） -->
                  <view
                    class="mr-invite-panel__refresh"
                    :class="{ 'mr-invite-panel__refresh--busy': inviteRefreshing }"
                    hover-class="mr-stage__switch--active"
                    @click="refreshInviteList"
                  >
                    <image class="mr-invite-panel__refresh-img" :src="iconInviteRefresh" mode="aspectFit" />
                  </view>
                </view>
                <text class="mr-invite-panel__hint">{{ t("Mobile.Meeting.inviteesHint") }}</text>
              </view>
              <input
                class="mr-invite-panel__search"
                v-model="inviteKeyword"
                :placeholder="t('Mobile.Meeting.inviteesPlaceholder')"
                placeholder-style="color:#a8a7b2"
              />
              <scroll-view class="mr-invite-panel__list" direction="vertical" :show-scrollbar="false">
                <view v-if="invitePoolState == 'loading'" class="mr-invite-panel__state">{{ t("Mobile.Common.loading") }}</view>
                <view v-else-if="invitePoolState == 'failed'" class="mr-invite-panel__state">{{ t("Mobile.Meeting.inviteesFailed") }}</view>
                <view v-else-if="inviteCandidates.length == 0" class="mr-invite-panel__state mr-invite-panel__state--empty">
                  <text class="mr-invite-panel__state-empty-text">{{ t("Mobile.Meeting.participantsEmpty") }}</text>
                </view>
                <view
                  v-for="person in inviteCandidates"
                  :key="person.userId"
                  class="mr-invite-row"
                  :class="{
                    'mr-invite-row--selected': isInviteSelected(person.userId),
                    'mr-invite-row--disabled': isInviteBlocked(person.userId)
                  }"
                  @click="toggleInvitee(person.userId)"
                >
                  <view class="mr-invite-row__avatar">
                    <image
                      v-if="person.avatar.length > 0 && !person.avatarFailed"
                      class="mr-invite-row__avatar-img"
                      :src="person.avatar"
                      mode="aspectFill"
                      @error="handleInviteAvatarError(person.userId)"
                    />
                    <text v-else>{{ person.initial }}</text>
                  </view>
                  <text class="mr-invite-row__name text-ellipsis" :lines="1">{{ person.displayName }}</text>
                  <!-- 勾选圆圈放到行尾右侧（用户要求）；智能体在列表最前由 loadInviteContacts 排序保证 -->
                  <view class="mr-invite-row__check">
                    <svg-icon v-if="isInviteSelected(person.userId)" name="icon-Check" size="12" unit="px" color="#141416" />
                  </view>
                </view>
              </scroll-view>
              <view class="mr-invite-panel__foot">
                <text class="mr-invite-panel__count">{{ inviteSelectedCountText }}</text>
                <view
                  class="mr-invite-panel__send"
                  :class="{ 'mr-invite-panel__send--disabled': inviteSelected.length == 0 || inviteSending }"
                  @click="sendMeetingInvites"
                >
                  <text class="mr-invite-panel__send-text">{{ inviteSending ? t("Mobile.Meeting.processing") : t("Mobile.Meeting.invite") }}</text>
                </view>
              </view>
            </view>
          </template>
        </scroll-view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  // ★onUnmounted 是 Vue 的 API；onLoad/onBackPress 是 uni-app 的页面钩子
  import { computed, onUnmounted, ref } from "vue";
  // #ifdef APP-HARMONY
  import { watch } from "vue";
  // #endif
  import { onBackPress, onLoad, onShow, onHide } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import {
    apiImMeetingAllowRejoin,
    apiImMeetingDeleteRoom,
    apiImMeetingKick,
    apiImMeetingListRecordings,
    apiImMeetingMuteAll,
    apiImMeetingMuteParticipant,
    apiImMeetingParticipants,
    apiImMeetingPublicRoomSafe,
    apiImMeetingPasscode,
    apiImMeetingPasscodeByRoom,
    apiImMeetingRecordDetail,
    apiImMeetingRecords,
    apiImMeetingStartRecording,
    apiImMeetingStopRecording,
    apiImMeetingUpdatePermissions,
    apiImMeetingUpdateRoomSettings,
  } from "@/servers/imMeeting";
  import { apiImContacts, apiImCreateP2pConversation, apiImWhoami } from "@/servers/im";
  import { apiImSendMeetingInvite } from "@/servers/imCall";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { getCachedMyInfo, setCachedMyInfo } from "@/utils/im/myInfoCache";
  // 联系人（取参与者头像：参与者接口只给 userId/name，不带头像）+ 我的资料兜底
  // 头像展示地址统一解析（受保护地址/尺寸规则，见该文件头）
  import { imAvatarDisplayUrl, resolveImAvatarDisplay } from "@/utils/imAvatarDisplay";
  import {
    buildMeetingInviteText,
    buildMeetingInviteUrl,
    formatMeetingId,
    meetingDisplayTitle,
    shareKeyOf,
  } from "@/utils/meeting/meetingLink";
  // 邀请链接的前缀来自部署配置（多环境各有站点），端上不硬编码域名
  import { getApiBaseUrl } from "@/constants/config";
  // 弹幕飘屏：入队/清空（逐帧动画在 <meeting-danmaku> 子组件里，不拖累本页重渲）
  import { pushMeetingDanmaku, resetMeetingDanmaku } from "@/utils/meeting/meetingDanmaku";
  // 媒体层适配：Android/iOS 接 LiveKit，鸿蒙占位
  import {
    MEETING_MEDIA_CHANGED_EVENT,
    MeetingMediaOptions,
    meetingMediaConnect,
    meetingMediaDebugLine,
    meetingMediaLocalAudioLevel,
    meetingMediaRemoteSpeakingIdentity,
    meetingMediaDisconnect,
    meetingMediaDrainMessages,
    meetingMediaSendMessage,
    meetingMediaStartScreenShare,
    meetingMediaStopScreenShare,
    meetingMediaScreenShareOn,
    meetingMediaScreenShareError,
    meetingMediaScreenShareStartError,
    meetingMediaPlatform,
    meetingMediaRoomMetadata,
    meetingMediaSetCamera,
    meetingMediaSetHandRaised,
    meetingMediaSetMic,
    meetingMediaSetSpeaker,
    meetingMediaRemoteVideoIdentities,
    meetingMediaState,
    meetingMediaSupported,
    meetingMediaSwitchCamera,
    meetingMediaActiveRoom,
    meetingMediaSetMinimized,
    meetingMediaSetResumeURL,
    meetingMediaReleasePageViews,
    meetingMediaSetPageVisible,
    meetingMediaConfirmPageVisible,
    meetingMediaReconcile,
  } from "@/utils/meeting/meetingMedia";
  // 会议数据变更广播（列表在会议 tab 内监听，见 meeting-pane 的 handleMeetingChanged）
  import { IM_MEETING_CHANGED_EVENT } from "@/servers/imMeeting";
  import iconInviteRefresh from "@/static/icons/refresh_meeting.svg";
  // #ifdef APP-HARMONY
  import { bindMeetingStage, releaseMeetingStage, setMeetingStageLayout, consumeMeetingStageTap } from "@/uni_modules/nuwax-livekit";
  import { meetingMediaCanCaptureScreen, meetingMediaConsumeDeviceError } from "@/utils/meeting/meetingMedia";
  import { resolveHarmonyMeetingAvatarData } from "@/utils/meeting/harmonyMeetingAvatar";
  // #endif
  // Android/iOS 为每路视频绑定单独的原生视图。
  // #ifdef APP-ANDROID || APP-IOS
  import { attachLocalVideo, createVideoView, releaseVideoView } from "@/uni_modules/nuwax-livekit";
  // #endif
  // 远端视频（Android / iOS 都已实现订阅渲染）
  // #ifdef APP-ANDROID || APP-IOS
  import { createRemoteVideoView } from "@/uni_modules/nuwax-livekit";
  // #endif
  // ★媒体状态广播走仓内 eventBus（App-Android 上 uni.$on 的订阅者有零触发前科）
  import eventBus from "@/utils/eventBus";
  import { generateUUID } from "@/utils/common";
  // 会中聊天气泡的 markdown 渲染：与智能体消息同一套 App 渲染桥（ai-msg 内部同源）
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  import AppTraceMarkdown from "@/subpackages/components/ai-msg/app-trace-markdown.uvue";
  // #endif

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  function tOf(key: string, params: Map<string, string | number>): string {
    return translateFn(key, toI18nParams(params), "");
  }

  /** 舞台卡片（会中实时在线成员，来自 `GET /rtc/rooms/{room}/participants`）。 */
  class StageTile {
    /** identity（游客没有 userId，踢人/静音时用它兜底）。 */
    key: string = "";
    userId: string = "";
    name: string = "";
    initial: string = "";
    host: boolean = false;
    /** 是不是我（主持人操作不给自己开按钮）。 */
    isMe: boolean = false;
    /** 麦克风是否在采集（无音轨或音轨 muted 都算"已静音"）。 */
    micOn: boolean = false;
    /** 摄像头是否在采集。 */
    cameraOn: boolean = false;
    /** 是否举手（participant attributes.handRaised 非空）。 */
    handRaised: boolean = false;
    /** 摄像头开启且远端已订阅到视频轨道（true ⇒ 格子里用原生视频画面替代头像）。 */
    hasVideo: boolean = false;
    /** 服务端下发的发布权限（false = 主持人已禁止发言）。 */
    canPublish: boolean = true;
    keepsShare: boolean = false;
    /** 单行操作在途（防连点）。 */
    busy: boolean = false;
    /** 用户真实头像原始地址（联系人表里带来的；空 = 没有头像，用首字兜底）。 */
    avatarRaw: string = "";
    /** 展示用地址（受保护地址需 Bearer/尺寸解析，见 utils/imAvatarDisplay）。 */
    avatar: string = "";
    /** 加载失败：退回首字，不反复重试。 */
    avatarFailed: boolean = false;
  }

  /**
   * 舞台网格的一行（含右侧补位空格子）。★不用 flex-wrap：App 端 wrap 支持不稳，
   * 多人时每格被拉成整宽白条（真机现象），改成"脚本切行 + 行内 flex:1 等分"。
   * ★必须写在 StageTile 之后：uvue 里类的前向引用同样报 error18。
   */
  class TileRow {
    key: string = "";
    items: StageTile[] = [];
    /** 该行右侧要补的空格子 key（保证每行等宽，末行也是整齐的格子） */
    empties: string[] = [];
  }

  /** 一页宫格（对齐飞书宫格视图：等分展示，手机竖屏一页最多 9 格）。 */
  class GridPage {
    key: string = "";
    rows: TileRow[] = [];
  }

  /** 一行参会人（详情接口的 `members`，只有昵称没有头像）。 */
  class MemberRow {
    userId: string = "";
    name: string = "";
    /** 昵称首字：头像位没有图片，用文字圆片占位（不引入 image，避开各端加载差异）。 */
    initial: string = "";
    host: boolean = false;
  }

  class MeetingInviteContact {
    userId: string = "";
    displayName: string = "";
    initial: string = "";
    avatarRaw: string = "";
    avatar: string = "";
    avatarFailed: boolean = false;
    /** 服务端算的伙伴类型：1=人 2=智能体（见 contacts 接口的 subjectType）。 */
    subjectType: number = 1;
    /** 便捷判定：智能体在邀请列表里排最前。 */
    isAgent: boolean = false;
  }

  class MeetingChatMessage {
    text: string = "";
    name: string = "";
    identity: string = "";
    self: boolean = false;
    topic: string = "meeting-chat";
    at: number = 0;
  }

  /** 会议 id（详情/密码接口都要它）；发起页刚建完房拿不到，靠会议号反查补上。 */
  const meetingId = ref<string>("");
  const roomRaw = ref<string>("");
  const titleRaw = ref<string>("");
  /** 0=未开始 1=进行中 2=已结束 3=已取消（与列表/服务端同一口径）。 */
  const status = ref<number>(1);
  /** 服务端原始开始时间（ISO 或 yyyy-MM-dd HH:mm:ss）。 */
  const startRaw = ref<string>("");
  const memberCount = ref<number>(0);
  /** 这场会设了入会密码（看到它才可能需要去拉明文）。 */
  const requiresPasscode = ref<boolean>(false);
  /** 从「加入会议」页带过来的入会密码明文：令牌接口对设了密码的会议会校验它。 */
  const joinPasscode = ref<string>("");
  /** 我是不是主持人（入口传参 + 详情回包都认；非主持人不发密码请求）。 */
  const isHost = ref<boolean>(false);
  /** 群语音/视频通话入口：连上后自动开麦；视频通话再自动开摄像头。普通会议不受影响。 */
  let groupCallMediaPending = false;
  let groupCallVideoRequested = false;

  /** 舞台卡片（会中在线成员；空 = 还没拉到，退回「只有我」的样式）。 */
  const tiles = ref<StageTile[]>([]);
  /** userId → 头像原始地址（来自联系人表，用来给舞台卡片显示真实头像）。 */
  let avatarByUser = new Map<string, string>();
  /** 联系人展示名（服务端已按 备注>昵称>账号 算好）：参与者接口的名字可能只是「用户+id」。 */
  let nameByUser = new Map<string, string>();
  let avatarLoaded = false;
  /** 在线成员轮询：只在已连接时跑（3 秒一次，成员进出更跟手；单人房请求量可忽略）。 */
  let peopleTimer = -1;
  /** 请求序号：并发时只认最后一次回包，避免旧列表盖掉新列表。 */
  let peopleLoading = false;

  const members = ref<MemberRow[]>([]);
  /** 底部操作区是否展开（默认展开=所有操作按钮都显示）。 */
  const actionsVisible = ref<boolean>(true);
  const inviteKeyword = ref<string>("");
  const invitePool = ref<MeetingInviteContact[]>([]);
  const invitePoolState = ref<string>("idle");
  const inviteSelected = ref<MeetingInviteContact[]>([]);
  const inviteSending = ref<boolean>(false);
  /** 邀请列表刷新在途（图标淡出，防连点）。 */
  const inviteRefreshing = ref<boolean>(false);
  /** idle | loading | ready | failed */
  const membersState = ref<string>("idle");
  /** hidden | loading | value | unavailable（三态口径与 PC `passcodeDisplay` 一致）。 */
  const passcodeState = ref<string>("hidden");
  const passcodeValue = ref<string>("");
  /** 分享 slug（房间 metadata / 详情 / 入口参数任一处先到先用）：复制邀请时的链接 key。 */
  const shareSlugRaw = ref<string>("");
  /** 详情接口失败：页面照常显示传参内容，面板里给一条可点重试。 */
  const failed = ref<boolean>(false);
  /** 底部面板："" 关闭 | "info" 会议信息 | "members" 参会人 | "more" 更多。 */
  const sheet = ref<string>("");
  /** 房间级全员禁言。初值按 PC 缺省 false；本端操作成功后同步，后续接原生 metadata 事件覆盖。 */
  const roomMuteAll = ref<boolean>(false);
  /** 房间级弹幕开关。PC/服务端缺省 true；主持人操作成功后同步。 */
  const danmakuOn = ref<boolean>(true);
  /** 本端举手状态；写 participant attributes，所有端从参与者快照读取。 */
  const handRaised = ref<boolean>(false);
  /** 当前共享占位（来自房间 metadata；移动端尚未接屏幕采集，但必须展示其它端状态）。 */
  const shareHolder = ref<string>("");
  const shareHolderName = ref<string>("");
  const shareSince = ref<number>(0);
  /** 本端是否仍被允许发布麦克风；metadata 与参与者权限任一变化都要重算禁言。 */
  const localMicPublishAllowed = ref<boolean>(false);
  /** 只有被全员禁言自动关麦时才置 true，解除后才自动恢复；用户主动静音不恢复。 */
  const mutedByRoomPolicy = ref<boolean>(false);
  /** 云端录制状态（会中恢复靠录制列表，点击后以 REST 回包为准）。 */
  const recordingOn = ref<boolean>(false);
  const recordingEgressId = ref<string>("");
  /** 更多面板 REST 操作在途 key；非空时阻止重复提交。 */
  const moreBusy = ref<string>("");
  /** 会中聊天弹层（消息由 LiveKit DataChannel 收发，最多保留最近 100 条）。 */
  const chatOpen = ref<boolean>(false);
  /** 聊天未读数：聊天面板没开时收到别人的消息才累加（口径同 IM 会话列表的未读角标）。 */
  const chatUnread = ref<number>(0);
  const chatInput = ref<string>("");
  const chatMessages = ref<MeetingChatMessage[]>([]);
  const chatScrollTop = ref<number>(0);
  let chatTimer = -1;
  const localSharePending = ref<boolean>(false);
  const localShareWasOn = ref<boolean>(false);
  /** 本端能不能真正收发音视频（false ⇒ 工具条只提示「接入中」，不伪造开关态）。 */
  const mediaSupported = ref<boolean>(false);
  /** 是否已真正连上房间：没连上时图标保持中性色（不暗示已静音/已关摄像头）。 */
  const mediaConnected = ref<boolean>(false);
  /** 最近一次媒体失败原因（`token` / `connect` / `exception` …）。 */
  const mediaError = ref<string>("");
  /** 是否正在连接（按钮点了给「正在连接会议…」而不是笼统的不可用）。 */
  const mediaConnecting = ref<boolean>(false);
  /** 房间实时人数（含本端；0 = 未连接/未知）。连上后角标以它为准。 */
  const mediaPeople = ref<number>(0);
  /** 会议时长上限（秒；0 = 服务端没下发，不显示"限时"）。 */
  const plannedSec = ref<number>(0);
  /** 服务端真实开会时刻（epoch ms），用于与 PC 一致地计算最后 10 分钟提醒。 */
  const meetingStartedAtMs = ref<number>(0);
  /** 我方真实头像加载失败（失败退回首字，不重试）。 */
  const myAvatarFailed = ref<boolean>(false);
  /** myInfoCache 不是响应式的：拉到「我的资料」后靠它触发计算属性重算。 */
  const myInfoTick = ref<number>(0);
  // #ifdef APP-HARMONY
  let harmonyStageId = 0;
  const harmonyMediaVisible = ref<boolean>(false);
  const harmonyMyAvatar = ref<string>("");
  // 预约允许提前入会时，详情仍可能回 status=0。媒体层由服务端预检和令牌判定入会资格。
  const meetingStageEnabled = computed((): boolean => roomRaw.value.length > 0 &&
    (status.value == 0 || status.value == 1 || mediaConnecting.value || mediaConnected.value));
  // #endif
  const screenShareAvailable = ref<boolean>(true);
  const micOn = ref<boolean>(false);
  const cameraOn = ref<boolean>(false);
  /** 旧 iOS 基座还把 UIView 返回给页面，不能挂载原生预览。 */
  const videoBridgeReady = ref<boolean>(true);
  const speakerOn = ref<boolean>(true);
  /** 「已进行」的时钟：只在进行中每 10s 推一次，避免整页每秒重渲染。 */
  const nowMs = ref<number>(0);
  let clockTimer = -1;

  // ---------------------------------------------------------------- 字段读取

  /** ★这些读取函数必须写在使用者之前：uvue 同级函数不支持前向引用（error18）。 */
  function readStr(obj: UTSJSONObject, key: string): string {
    const value = obj[key];
    return value != null ? `${value}` : "";
  }

  function readNum(obj: UTSJSONObject, key: string, fallback: number): number {
    const value = obj[key];
    if (value == null) {
      return fallback;
    }
    if (typeof value == "number") {
      const n = value as number;
      return n != n ? fallback : n;
    }
    const parsed = parseFloat(`${value}`);
    return parsed != parsed ? fallback : parsed;
  }

  /** 同账号多端会各有席位；只有 identity 第三段等于当前平台的才是本端。 */
  function isCurrentDeviceIdentity(identity: string, userId: string, myUserId: string): boolean {
    if (userId.length == 0 || myUserId.length == 0 || userId != myUserId) {
      return false;
    }
    const parts = identity.split(":");
    if (parts.length < 3) {
      return true;
    }
    return parts[2] == meetingMediaPlatform();
  }

  /**
   * 本端在房间里的 identity（`tenant:user:platform`）。
   * 共享互斥等服务端 metadata 用 identity 记持有者，拿 userId 比会永远不等。
   * 成员列表还没拉到（刚入会）时返回空串，调用方按"未知"跳过判断。
   */
  function myMeetingIdentity(): string {
    const list = tiles.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].isMe) {
        return list[i].key;
      }
    }
    return "";
  }

  // ---------------------------------------------------------------- 时间文案

  /** `yyyy-MM-dd HH:mm[:ss]` ⇒ 「yyyy-MM-dd HH:mm」（与列表卡同口径：秒是噪音）。 */
  function formatTime(raw: string): string {
    const text = raw.trim();
    if (text.length == 0) {
      return "";
    }
    let s = text.replaceAll("T", " ");
    const dot = s.indexOf(".");
    if (dot > 0) {
      s = s.substring(0, dot);
    }
    if (s.length >= 16) {
      return `${s.substring(0, 10)} ${s.substring(11, 16)}`;
    }
    return s;
  }

  /**
   * 服务端时间 ⇒ 毫秒（不用 new Date(串)：iOS 对该格式解析不一致）。
   * ★必须保留**秒**：会议时长从 startTime 现算，只到分钟会把 :37 当成 :00，
   *   一进会就凭空多出最多 59 秒（真机现象：刚进会显示"已持续几十秒"）。
   */
  function parseServerTime(raw: string): number {
    let s = raw.trim();
    if (s.length == 0) {
      return -1;
    }
    s = s.replaceAll("T", " ");
    const dot = s.indexOf(".");
    if (dot > 0) {
      s = s.substring(0, dot);
    }
    if (s.length < 16) {
      return -1;
    }
    const year = parseInt(s.substring(0, 4));
    const month = parseInt(s.substring(5, 7));
    const day = parseInt(s.substring(8, 10));
    const hh = parseInt(s.substring(11, 13));
    const mm = parseInt(s.substring(14, 16));
    let ss = 0;
    if (s.length >= 19) {
      const parsed = parseInt(s.substring(17, 19));
      ss = isNaN(parsed) ? 0 : parsed;
    }
    if (isNaN(year) || isNaN(month) || isNaN(day) || isNaN(hh) || isNaN(mm)) {
      return -1;
    }
    return new Date(year, month - 1, day, hh, mm, ss).getTime();
  }

  function pad2(n: number): string {
    return n < 10 ? `0${n}` : `${n}`;
  }

  /**
   * 已进行时长（对齐 PC 「已进行 00:11」的语义，但手机上不需要秒级跳动）：
   * 不足 1 分钟给秒，其余给分钟 / 小时+分钟。★用词条拼，四套语言都要出这句。
   */
  function durationTextOf(sec: number): string {
    if (sec < 0) {
      return "";
    }
    const total = Math.floor(sec);
    const params = new Map<string, string | number>();
    if (total < 60) {
      params.set("sec", total);
      return tOf("Mobile.Meeting.durationSec", params);
    }
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    if (h > 0) {
      params.set("hour", h);
      params.set("min", pad2(m));
      return tOf("Mobile.Meeting.durationHourMin", params);
    }
    params.set("min", m);
    return tOf("Mobile.Meeting.durationMin", params);
  }

  /**
   * 开始时间文案（对齐 PC `formatStartedAt`）：今天只给时分，跨天带月日 ——
   * 一眼能判断这场会开了多久，又不用在手机上塞一整行日期。
   */
  function startTimeTextOf(raw: string): string {
    const text = formatTime(raw);
    if (text.length < 16) {
      return text;
    }
    const now = new Date();
    const today = `${now.getFullYear()}-${pad2(now.getMonth() + 1)}-${pad2(now.getDate())}`;
    const hhmm = text.substring(11, 16);
    if (text.substring(0, 10) == today) {
      return hhmm;
    }
    const month = parseInt(text.substring(5, 7));
    const day = parseInt(text.substring(8, 10));
    const params = new Map<string, string | number>();
    params.set("month", month);
    params.set("day", day);
    params.set("time", hhmm);
    return tOf("Mobile.Meeting.monthDayTime", params);
  }

  /** 进行中已走过的秒数（拿不到开始时间返回 -1）。 */
  function elapsedSecOf(): number {
    if (status.value != 1 || nowMs.value <= 0) {
      return -1;
    }
    const started = meetingStartedAtMs.value > 0 ? meetingStartedAtMs.value : parseServerTime(startRaw.value);
    if (started <= 0) {
      return -1;
    }
    const sec = Math.floor((nowMs.value - started) / 1000);
    return sec > 0 ? sec : 0;
  }

  // ---------------------------------------------------------------- 时钟
  // ★必须写在 loadDetail / onLoad 之前：uvue 同级函数不支持前向引用（error18）。

  function stopClock(): void {
    if (clockTimer != -1) {
      clearInterval(clockTimer);
      clockTimer = -1;
    }
  }

  /** 只有进行中才需要「已进行」；结束时立刻停表。 */
  function syncClock(): void {
    if (status.value != 1) {
      stopClock();
      return;
    }
    nowMs.value = Date.now();
    if (clockTimer != -1) {
      return;
    }
    // 1 秒推进一次：会议时长要按秒走（用户要求），只在 ref 值变化时才重绘
    clockTimer = setInterval(() => {
      nowMs.value = Date.now();
    }, 1000);
  }

  // ---------------------------------------------------------------- 数据

  /** 会议号 → meetingId：发起页刚建完房时 createRoom 不回 id，按首页记录反查一次。 */
  async function findMeetingIdByRoom(room: string): Promise<string> {
    if (room.length == 0) {
      return "";
    }
    try {
      const res = await apiImMeetingRecords("", 10, true);
      if (apiResCode(res) != SUCCESS_CODE) {
        return "";
      }
      const data = apiResData<any>(res);
      if (data == null) {
        return "";
      }
      let list: UTSJSONObject[] | null = null;
      if (Array.isArray(data)) {
        list = data as UTSJSONObject[];
      } else if (typeof data == "object") {
        const records = (data as UTSJSONObject)["records"];
        if (records != null) {
          list = records as UTSJSONObject[];
        }
      }
      if (list == null) {
        return "";
      }
      for (let i = 0; i < list.length; i++) {
        const item = list[i];
        if (item == null) {
          continue;
        }
        const obj = item as UTSJSONObject;
        if (readStr(obj, "roomName") == room) {
          return readStr(obj, "id");
        }
      }
    } catch (_error) {
      // 反查失败不影响页面：已传参的主题/会议号/状态照样能看
    }
    return "";
  }

  /** 参会人数组（主持人排最前）。入参是数组：调用方判空后再强转（UTS 不认识 Any? 形参）。 */
  function parseMembers(list: UTSJSONObject[]): MemberRow[] {
    const out: MemberRow[] = [];
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      if (item == null) {
        continue;
      }
      const obj = item as UTSJSONObject;
      const row = new MemberRow();
      row.userId = readStr(obj, "userId");
      row.name = readStr(obj, "displayName");
      if (row.name.length == 0) {
        row.name = readStr(obj, "roleText");
      }
      row.initial = row.name.length > 0 ? row.name.substring(0, 1) : "?";
      row.host = readNum(obj, "role", 1) == 2;
      out.push(row);
    }
    return out;
  }

  /** 详情回包覆盖传参：会议可能刚被别人开始/结束，服务端才是权威。 */
  function applyDetail(data: UTSJSONObject): void {
    const meetingRaw = data["meeting"];
    if (meetingRaw != null) {
      const meeting = meetingRaw as UTSJSONObject;
      const id = readStr(meeting, "id");
      if (id.length > 0) {
        meetingId.value = id;
      }
      const room = readStr(meeting, "roomName");
      if (room.length > 0) {
        roomRaw.value = room;
      }
      const title = readStr(meeting, "title");
      if (title.length > 0) {
        titleRaw.value = title;
      }
      status.value = readNum(meeting, "status", status.value);
      const start = readStr(meeting, "startTime");
      if (start.length > 0) {
        startRaw.value = start;
      }
      memberCount.value = readNum(meeting, "memberCount", memberCount.value);
      requiresPasscode.value = readStr(meeting, "requiresPasscode") == "true";
      // 复制邀请要用 slug 拼链接；老记录没有就回退会议号（shareKeyOf 处理）
      const slug = readStr(meeting, "shareSlug").trim();
      if (slug.length > 0) {
        shareSlugRaw.value = slug;
      }
      // 详情里的 host 是按查看者算的，比入口传参更准
      isHost.value = readStr(meeting, "host") == "true";
    }
    // `data["members"]` 是 Any?：先判空再强转成数组（UTS 的 Any? 不能直接当参数传）
    const membersRaw = data["members"];
    if (membersRaw != null) {
      const parsed = parseMembers(membersRaw as UTSJSONObject[]);
      if (parsed.length > 0) {
        members.value = parsed;
        memberCount.value = parsed.length;
      }
    }
    membersState.value = "ready";
  }

  /** 入会密码：只有主持人、且这场会确实设了密码时才去查（PC `shouldFetchPasscode` 同口径）。 */
  async function loadPasscodeIfNeeded(): Promise<void> {
    if (!isHost.value || !requiresPasscode.value) {
      passcodeState.value = "hidden";
      return;
    }
    if (passcodeState.value == "value" || passcodeState.value == "unavailable") {
      return;
    }
    passcodeState.value = "loading";
    try {
      const id = meetingId.value;
      const res = id.length > 0
        ? await apiImMeetingPasscode(id)
        : await apiImMeetingPasscodeByRoom(roomRaw.value);
      if (apiResCode(res) != SUCCESS_CODE) {
        // 拉不到 ≠ 没设密码：保持「已设置但看不到」的如实说明
        passcodeState.value = "unavailable";
        return;
      }
      const data = apiResData<any>(res);
      const obj = data != null ? (data as UTSJSONObject) : null;
      const code = obj != null ? readStr(obj, "passcode").trim() : "";
      if (code.length > 0) {
        passcodeValue.value = code;
        passcodeState.value = "value";
      } else {
        passcodeState.value = "unavailable";
      }
    } catch (_error) {
      passcodeState.value = "unavailable";
    }
  }

  /** 拉详情：失败不弹 toast，只在面板里亮一条可点重试（页面已有传参内容可看）。 */
  async function loadDetail(): Promise<void> {
    if (membersState.value == "idle") {
      membersState.value = "loading";
    }
    try {
      let id = meetingId.value;
      if (id.length == 0) {
        id = await findMeetingIdByRoom(roomRaw.value);
        if (id.length > 0) {
          meetingId.value = id;
        }
      }
      if (id.length == 0) {
        // 没有 id 就只剩传参可用（发起页刚建房时可能如此）
        membersState.value = "ready";
        failed.value = false;
        return;
      }
      const res = await apiImMeetingRecordDetail(id, true);
      if (apiResCode(res) != SUCCESS_CODE) {
        failed.value = true;
        membersState.value = members.value.length > 0 ? "ready" : "failed";
        return;
      }
      const data = apiResData<any>(res);
      if (data == null) {
        failed.value = true;
        membersState.value = members.value.length > 0 ? "ready" : "failed";
        return;
      }
      failed.value = false;
      applyDetail(data as UTSJSONObject);
      loadPasscodeIfNeeded();
      syncClock();
    } catch (_error) {
      failed.value = true;
      membersState.value = members.value.length > 0 ? "ready" : "failed";
    }
  }

  // ---------------------------------------------------------------- 展示

  const pageTitle = computed((): string => {
    return meetingDisplayTitle(titleRaw.value, roomRaw.value);
  });

  const formattedRoom = computed((): string => {
    return roomRaw.value.length > 0 ? formatMeetingId(roomRaw.value) : "";
  });

  /** 我自己的昵称（舞台上那行「张三（我）」）与头像字。 */
  const myName = computed((): string => {
    // 用意是让计算属性依赖 tick：myInfoCache 不是响应式的，缓存更新后靠 tick 触发重算
    const info = myInfoTick.value >= 0 ? getCachedMyInfo() : null;
    const name = info != null ? info.displayName : "";
    // 缓存没水合时别显示 "?"：舞台卡片会变成"蓝圈 + 白色问号"，看不清是谁
    return name.length > 0 ? name : t("Mobile.Meeting.me");
  });

  const myInitial = computed((): string => {
    const name = myName.value;
    return name.length > 0 ? name.substring(0, 1) : "?";
  });

  /** 我方真实头像（缓存里的原始地址 → 展示地址；没有就退回首字）。 */
  const myAvatar = computed((): string => {
    // 同 myName：靠 tick 把非响应式缓存的变化带进来
    const info = myInfoTick.value >= 0 ? getCachedMyInfo() : null;
    const raw = info != null ? info.avatar : "";
    if (raw.length == 0) {
      return "";
    }
    return imAvatarDisplayUrl(raw, 352);
  });

  const myStageAvatar = computed((): string => {
    // #ifdef APP-HARMONY
    if (harmonyMyAvatar.value.length > 0) return harmonyMyAvatar.value;
    // #endif
    return myAvatar.value;
  });

  const myLabel = computed((): string => {
    return `${myName.value}${t("Mobile.Meeting.meLabel")}`;
  });

  /**
   * 底部安全区：App 端样式表的 env(safe-area-inset-bottom) 不可靠（同 remark-sheet 口径），
   * 这里内联补到工具条 / 面板底部；H5 与小程序仍由样式表 env() 兜底。
   */
  const toolsStyle = computed((): string => {
    let style = "";
    // #ifdef APP
    try {
      const win = uni.getWindowInfo();
      style = `padding-bottom: ${10 + win.safeAreaInsets.bottom}px;`;
    } catch (_e) {
      style = "";
    }
    // #endif
    return style;
  });

  const sheetStyle = computed((): string => {
    let style = "";
    // #ifdef APP
    try {
      const win = uni.getWindowInfo();
      const safeBottom = win.safeAreaInsets.bottom;
      // 聊天按 PC 移动端交互做成底部短弹层，保留输入框和最近消息，避免遮住整个会议舞台。
      // 高度取窗口的 1/2（在原来 1/3 基础上加到 1.5 倍，用户要求更高一截）。
      if (sheet.value == "chat") {
        const height = Math.max(1, Math.round(win.windowHeight / 2));
        style = `height: ${height}px; max-height: ${height}px; padding-bottom: ${safeBottom}px;`;
      } else {
        style = `padding-bottom: ${safeBottom}px;`;
      }
    } catch (_e) {
      style = "";
    }
    // #endif
    return style;
  });

  /** 状态文案：直接对齐列表 Tag 的四档（未开始 / 进行中 / 已结束 / 已取消）。 */
  const statusText = computed((): string => {
    if (status.value == 0) {
      return t("Mobile.Meeting.tagPending");
    }
    if (status.value == 1) {
      return t("Mobile.Meeting.tagOngoing");
    }
    if (status.value == 3) {
      return t("Mobile.Meeting.tagCancelled");
    }
    return t("Mobile.Meeting.tagEnded");
  });

  const tagClass = computed((): string => {
    return status.value == 1 ? "mr-tag mr-tag--live" : "mr-tag mr-tag--pending";
  });

  const tagTextClass = computed((): string => {
    return status.value == 1 ? "mr-tag__text mr-tag__text--live" : "mr-tag__text mr-tag__text--pending";
  });

  /** 开始时间（今天只时分 / 跨天带月日）。 */
  const startText = computed((): string => {
    return startTimeTextOf(startRaw.value);
  });

  /** 开始时间 + 「· 已进行 xx」（仅进行中）。 */
  const startTextWithElapsed = computed((): string => {
    const base = startTimeTextOf(startRaw.value);
    const sec = elapsedSecOf();
    const duration = sec >= 0 ? durationTextOf(sec) : "";
    if (duration.length == 0) {
      return base.length > 0 ? base : "—";
    }
    const params = new Map<string, string | number>();
    params.set("duration", duration);
    const live = tOf("Mobile.Meeting.liveFor", params);
    return base.length > 0 ? `${base} · ${live}` : live;
  });

  /**
   * 在会人数（含自己）= 在线成员列表 → SDK 报的人数 → 都没有算 0。
   * ★不能退回 `memberCount`（记录里的参会人数）：预约邀请 5 人、实际来 1 人时会显示 5。
   * ★必须写在 membersLabelText 之前：uvue 里 const 前向引用同样报错（error18）。
   */
  const badgeCount = computed((): number => {
    if (tiles.value.length > 0) {
      return tiles.value.length;
    }
    if (mediaConnected.value && mediaPeople.value > 0) {
      return mediaPeople.value;
    }
    return 0;
  });

  /** 时长上限的人话（`7200 → 2小时`；`5400 → 1小时30分`）。 */
  function limitTextOf(sec: number): string {
    const total = Math.floor(sec);
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const params = new Map<string, string | number>();
    if (h > 0 && m == 0) {
      params.set("hour", h);
      return tOf("Mobile.Meeting.durationHourOnly", params);
    }
    if (h > 0) {
      params.set("hour", h);
      params.set("min", pad2(m));
      return tOf("Mobile.Meeting.durationHourMin", params);
    }
    params.set("min", m);
    return tOf("Mobile.Meeting.durationMin", params);
  }

  function clockDurationOf(sec: number): string {
    const safe = sec > 0 ? Math.floor(sec) : 0;
    const h = Math.floor(safe / 3600);
    const m = Math.floor((safe % 3600) / 60);
    const s = safe % 60;
    return h > 0 ? `${h}:${pad2(m)}:${pad2(s)}` : `${pad2(m)}:${pad2(s)}`;
  }

  /** 顶栏已进行时长；限时与最后 10 分钟提醒单独渲染，和 PC 口径一致。 */
  const clockText = computed((): string => {
    const sec = elapsedSecOf();
    return sec >= 0 ? clockDurationOf(sec) : "";
  });

  const remainingSec = computed((): number => {
    const elapsed = elapsedSecOf();
    if (plannedSec.value <= 0 || elapsed < 0) {
      return -1;
    }
    const remaining = plannedSec.value - elapsed;
    return remaining > 0 ? remaining : 0;
  });

  const limitWarn = computed((): boolean => {
    return remainingSec.value >= 0 && remainingSec.value <= 600;
  });

  const limitStateText = computed((): string => {
    if (plannedSec.value <= 0) {
      return "";
    }
    const params = new Map<string, string | number>();
    if (remainingSec.value < 0) {
      params.set("duration", limitTextOf(plannedSec.value));
      return tOf("Mobile.Meeting.clockLimit", params);
    }
    if (remainingSec.value <= 0) {
      return t("Mobile.Meeting.clockLimitReached");
    }
    if (remainingSec.value <= 600) {
      params.set("duration", clockDurationOf(remainingSec.value));
      return tOf("Mobile.Meeting.clockRemaining", params);
    }
    params.set("duration", limitTextOf(plannedSec.value));
    return tOf("Mobile.Meeting.clockLimit", params);
  });

  /** 参会人工具项文案：把人数直接写在标签里（角标在 App 端反复画不出来）。 */
  const membersLabelText = computed((): string => {
    const base = t("Mobile.Meeting.membersTitle");
    return badgeCount.value > 0 ? `${base} ${badgeCount.value}` : base;
  });

  /**
   * 宫格分页（对齐飞书宫格视图的取舍）：
   * · 2 人 → 1 列 ×2 行上下排列（用户要求，不左右并排）；
   * · 3–4 人 → 2×2 一页（手机竖屏能看清脸的最小粒度）；
   * · 5–9 人 → 3×3 一页（飞书/腾讯会议手机端的上限口径）；
   * · >9 人 → 每页 9 格 + 翻页（飞书 PC 端可到 25 格，手机屏小，9 格是清晰度上限）。
   * ★全部分行在脚本里算好：模板只用两层 v-for，不依赖 flex-wrap。
   */
  const pageCols = computed((): number => {
    return tiles.value.length <= 4 ? 2 : 3;
  });

  /** 只有两个人：一人一行、上下排列（用户要求，不左右并排）。 */
  const stackedPair = computed((): boolean => tiles.value.length == 2);

  const tilePages = computed((): GridPage[] => {
    const list = tiles.value;
    // 两人：列数按 1 走（每人一行），每页 2 格 —— 仍然是一页，不产生分页器
    const stacked = stackedPair.value;
    const cols = stacked ? 1 : pageCols.value;
    const perPage = stacked ? 2 : cols * cols;
    const pages: GridPage[] = [];
    let pi = 0;
    while (pi < list.length) {
      const page = new GridPage();
      page.key = `p-${pi}`;
      const rows: TileRow[] = [];
      let i = pi;
      while (i < pi + perPage && i < list.length) {
        const row = new TileRow();
        row.key = `r-${i}`;
        const items: StageTile[] = [];
        const empties: string[] = [];
        for (let c = 0; c < cols; c++) {
          if (i + c < list.length && i + c < pi + perPage) {
            items.push(list[i + c]);
          } else {
            empties.push(`e-${i}-${c}`);
          }
        }
        row.items = items;
        row.empties = empties;
        rows.push(row);
        i = i + cols;
      }
      page.rows = rows;
      pages.push(page);
      pi = pi + perPage;
    }
    return pages;
  });

  const pageCount = computed((): number => tilePages.value.length);

  /** 当前页下标（tiles 变化后自动夹紧，不越界）。 */
  const pageIndex = ref<number>(0);

  const currentRows = computed((): TileRow[] => {
    const pages = tilePages.value;
    if (pages.length == 0) {
      return [];
    }
    let idx = pageIndex.value;
    if (idx >= pages.length) {
      idx = pages.length - 1;
    }
    if (idx < 0) {
      idx = 0;
    }
    return pages[idx].rows;
  });

  /** 分页器文案 `2/3`（页码夹紧，列表变短时不越界）。 */
  const pageLabel = computed((): string => {
    const n = pageCount.value;
    if (n == 0) {
      return "";
    }
    let idx = pageIndex.value;
    if (idx >= n) {
      idx = n - 1;
    }
    if (idx < 0) {
      idx = 0;
    }
    return `${idx + 1}/${n}`;
  });

  /**
   * 舞台人数/布局**只看在线成员列表**（tiles），不用 SDK 报的人数兜底：
   * 兜底会出现「SDK 说 2 人、列表还没拉到」的空窗 —— 那时按多人布局渲染，
   * 但一张卡片都没有，中间区域整块空白（用户实测反馈）。
   * 列表为空 ⇒ 一律按"只有我"渲染，永远有内容可看。
   */
  const stageCount = computed((): number => {
    return tiles.value.length > 0 ? tiles.value.length : 1;
  });

  /** 只有我一个人 ⇒ 舞台收缩成一块小卡片（用户要求：别占满整屏）。 */
  const stageSolo = computed((): boolean => {
    return tiles.value.length <= 1;
  });

  // ---------------------------------------------------------------- 单格放大 / 舞台布局

  /**
   * 宫格里点开的那一格（空串 = 宫格视图）。
   * ★存 key 而不是对象：成员列表每 3 秒重建一次对象，存对象会立刻失效。
   */
  const focusedTileKey = ref<string>("");

  /** 当前放大的格子；该人已离开就返回 null（自动退回宫格）。 */
  const focusedTile = computed((): StageTile | null => {
    const key = focusedTileKey.value;
    if (key.length == 0) {
      return null;
    }
    const list = tiles.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].key == key) {
        return list[i];
      }
    }
    return null;
  });

  /** 宫格「点开一格」的放大态（只有宫格布局有；用来显示右上角「返回宫格」）。 */
  const gridFull = computed((): boolean => focusedTile.value != null);

  /** 舞台布局：grid（默认宫格）/ topThumbs（顶部缩略图）/ sideThumbs（侧边缩略图）/ speaker（演讲者）。 */
  const stageLayout = ref<string>("grid");

  /** 非宫格布局里大图区画的是谁（空 = 自动：共享者优先，其次第一位）。 */
  const stageMainKey = ref<string>("");

  /** 演讲者布局：最近一次「正在说话」的成员 identity（没人说话时粘住上一位）。 */
  const speakerKey = ref<string>("");

  /** 大图区的候选格子（不含宫格放大态）。 */
  const stageMainTile = computed((): StageTile | null => {
    const list = tiles.value;
    if (list.length == 0) {
      return null;
    }
    const key = stageMainKey.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].key == key) {
        return list[i];
      }
    }
    // 自动：正在共享屏幕的人优先（共享内容最值得占大屏），否则按列表第一位
    //（第一位已经过「举手优先」排序，举手的人自然排最前）
    for (let i = 0; i < list.length; i++) {
      if (list[i].keepsShare) {
        return list[i];
      }
    }
    return list[0];
  });

  /** 舞台真正只画一格时的那个格子：宫格放大态 > 演讲者 > 非宫格布局的主画面。 */
  const mainTile = computed((): StageTile | null => {
    const focused = focusedTile.value;
    if (focused != null) {
      return focused;
    }
    if (stageLayout.value == "grid") {
      return null;
    }
    if (stageLayout.value == "speaker") {
      // 大图跟「最近在说话的人」走；那人离会/还没轮到过就回落到共享者/第一位
      const key = speakerKey.value;
      const list = tiles.value;
      for (let i = 0; i < list.length; i++) {
        if (list[i].key == key) {
          return list[i];
        }
      }
    }
    return stageMainTile.value;
  });

  /** 只画一格（铺满大图区）：放大态或非宫格布局。 */
  const singleCell = computed((): boolean => mainTile.value != null);

  /** 两人上下排（放大/大图态不叠这个类：那时只有一格，铺满容器）。 */
  const gridStack = computed((): boolean => stackedPair.value && mainTile.value == null);

  /** 缩略图条是否显示（只有顶部/侧边两种布局、且不是共享全屏）。 */
  const thumbsVisible = computed((): boolean => {
    return !stageSolo.value && (stageLayout.value == "topThumbs" || stageLayout.value == "sideThumbs");
  });

  /** 缩略图列表：全部参会人（大图区那位也留在条里，靠高亮区分）。 */
  const stageThumbs = computed((): StageTile[] => tiles.value);

  /**
   * 缩略图条内层的宽/高：★必须显式给尺寸（每格 52 + 8 间距逐格累加）。
   * App 端 flex 行会被压成视口大小，内层不撑开的话 scroll-view 一点滑动余量都没有
   * （shared-home-tools 踩过同一个坑）。
   */
  const thumbsInnerStyle = computed((): string => {
    const n = stageThumbs.value.length;
    if (stageLayout.value == "topThumbs") {
      return `width: ${n * 60 + 10}px;`;
    }
    if (stageLayout.value == "sideThumbs") {
      return `height: ${n * 60 + 10}px;`;
    }
    return "";
  });

  /** 当前布局在入口按钮上显示的图标。 */
  const layoutEntryIcon = computed((): string => {
    const layout = stageLayout.value;
    if (layout == "topThumbs") {
      return "icon-layout";
    }
    if (layout == "sideThumbs") {
      return "icon-Sidebar";
    }
    if (layout == "speaker") {
      return "icon-stop";
    }
    return "icon-Grid";
  });

  /** 布局选项（底部弹层里的四行；顺序与设计稿一致）。 */
  class StageLayoutOption {
    value: string = "grid";
    icon: string = "icon-Grid";
    title: string = "";
    desc: string = "";
  }

  const layoutOptions = computed((): StageLayoutOption[] => {
    const out: StageLayoutOption[] = [];
    const grid = new StageLayoutOption();
    grid.value = "grid";
    grid.icon = "icon-Grid";
    grid.title = t("Mobile.Meeting.layoutGrid");
    grid.desc = t("Mobile.Meeting.layoutGridDesc");
    out.push(grid);
    const top = new StageLayoutOption();
    top.value = "topThumbs";
    top.icon = "icon-layout";
    top.title = t("Mobile.Meeting.layoutTop");
    top.desc = t("Mobile.Meeting.layoutTopDesc");
    out.push(top);
    const side = new StageLayoutOption();
    side.value = "sideThumbs";
    side.icon = "icon-Sidebar";
    side.title = t("Mobile.Meeting.layoutSide");
    side.desc = t("Mobile.Meeting.layoutSideDesc");
    out.push(side);
    const speaker = new StageLayoutOption();
    speaker.value = "speaker";
    speaker.icon = "icon-stop";
    speaker.title = t("Mobile.Meeting.layoutSpeaker");
    speaker.desc = t("Mobile.Meeting.layoutSpeakerDesc");
    out.push(speaker);
    return out;
  });

  /**
   * 实际渲染的行：只画一格时返回一行一格（复用宫格的格子标记与样式，
   * 不另写一套大图卡片，否则视频/举手标/名字条三处都要跟着改）。
   */
  const displayRows = computed((): TileRow[] => {
    const main = mainTile.value;
    if (main != null) {
      const row = new TileRow();
      row.key = "main";
      const items: StageTile[] = [];
      items.push(main);
      const empties: string[] = [];
      row.items = items;
      row.empties = empties;
      const rows: TileRow[] = [];
      rows.push(row);
      return rows;
    }
    return currentRows.value;
  });

  // #ifdef APP-HARMONY
  const harmonyStagePresentation = computed((): string => {
    const members: UTSJSONObject[] = [];
    const list = tiles.value;
    for (let i = 0; i < list.length; i++) {
      const tile = list[i];
      let avatar = tile.avatar.indexOf("data:image/") == 0 ? tile.avatar : "";
      if (tile.isMe && harmonyMyAvatar.value.indexOf("data:image/") == 0) {
        avatar = harmonyMyAvatar.value;
      }
      members.push({
        identity: tile.key,
        name: tile.isMe ? myLabel.value : tile.name,
        micOn: tile.isMe ? micOn.value : tile.micOn,
        handRaised: tile.isMe ? handRaised.value : tile.handRaised,
        hostLabel: tile.host ? t("Mobile.Meeting.hostBadge") : "",
        recording: tile.host && recordingOn.value,
        avatar,
      } as UTSJSONObject);
    }
    const grid: string[] = [];
    const rows = displayRows.value;
    for (let i = 0; i < rows.length; i++) {
      for (let j = 0; j < rows[i].items.length; j++) grid.push(rows[i].items[j].key);
    }
    return JSON.stringify({
      mode: stageLayout.value, main: mainTile.value?.key ?? "", focused: gridFull.value,
      grid, columns: gridStack.value ? 1 : pageCols.value, members,
    } as UTSJSONObject);
  });
  watch(harmonyStagePresentation, (presentation: string): void => {
    if (harmonyStageId > 0) setMeetingStageLayout(harmonyStageId, presentation);
  });
  // #endif

  /** 点宫格：没放大就放大这一格；点已放大的那一格则还原（最直观的返回手势）。 */
  function handleTileTap(tile: StageTile): void {
    if (stageSolo.value) {
      return;
    }
    // 非宫格布局：大图区已经铺满，点它不再进入放大态（否则会与布局语义打架）
    if (stageLayout.value != "grid") {
      return;
    }
    if (focusedTileKey.value == tile.key) {
      focusedTileKey.value = "";
      return;
    }
    focusedTileKey.value = tile.key;
  }

  /** 退出单格放大（右上角按钮 / 系统返回键都走这里）。 */
  function exitTileFocus(): void {
    focusedTileKey.value = "";
  }

  /** 某格是不是大图区正在画的那一格（缩略图高亮用）。 */
  function isStageMain(tile: StageTile): boolean {
    const main = stageMainTile.value;
    return main != null && main.key == tile.key;
  }

  /** 共享全屏：非空 = 正在全屏看这个 identity（tile.key）。 */
  const shareFullKey = ref<string>("");
  /** 全屏时顶栏显示谁在共享。 */
  const shareFullName = computed((): string => {
    const key = shareFullKey.value;
    if (key.length == 0) {
      return "";
    }
    const list = tiles.value;
    for (let i = 0; i < list.length; i++) {
      if (list[i].key == key) {
        return list[i].name;
      }
    }
    return "";
  });

  /** 独自一人且开了摄像头 ⇒ 用原生预览铺满小卡片，替代头像圆。 */
  const showSelfVideo = computed((): boolean => {
    return stageSolo.value && cameraOn.value && mediaConnected.value && videoBridgeReady.value;
  });

  /**
   * 参会人小节的数字：会中看**在会人数**（与角标同口径）；
   * 未入会（预约/已结束）才退回记录里的参会人数。
   */
  const membersCountText = computed((): string => {
    let count = memberCount.value;
    if (mediaConnected.value && badgeCount.value > 0) {
      count = badgeCount.value;
    }
    if (count <= 0) {
      return "—";
    }
    const params = new Map<string, string | number>();
    params.set("count", count);
    return tOf("Mobile.Meeting.inRoomCount", params);
  });

  const sheetTitle = computed((): string => {
    if (sheet.value == "members") {
      return t("Mobile.Meeting.membersTitle");
    }
    if (sheet.value == "invite") {
      return t("Mobile.Meeting.inviteesLabel");
    }
    if (sheet.value == "layout") {
      return t("Mobile.Meeting.layoutTitle");
    }
    return t("Mobile.Meeting.infoTitle");
  });

  const roomMuteAllStateText = computed((): string => {
    return roomMuteAll.value ? t("Mobile.Meeting.stateOn") : t("Mobile.Meeting.stateOff");
  });

  const danmakuStateText = computed((): string => {
    return danmakuOn.value ? t("Mobile.Meeting.stateOn") : t("Mobile.Meeting.stateOff");
  });

  const handRaisedStateText = computed((): string => {
    return handRaised.value ? t("Mobile.Meeting.handRaised") : t("Mobile.Meeting.handLowered");
  });

  const chatPlaceholder = computed((): string => {
    return danmakuOn.value ? "发弹幕…（回车发送，会飘屏）" : "发消息…（回车发送）";
  });

  const chatCanSend = computed((): boolean => {
    return chatInput.value.trim().length > 0;
  });

  /** 未读角标文案：与 PC 会话列表同口径，超过 99 显示 99+。 */
  const chatUnreadText = computed((): string => {
    const n = chatUnread.value;
    if (n <= 0) {
      return "";
    }
    return n > 99 ? "99+" : `${n}`;
  });

  const shareStateText = computed((): string => {
    if (localSharePending.value) {
      return t("Mobile.Meeting.processing");
    }
    if (shareHolder.value.length == 0) {
      return t("Mobile.Meeting.stateOff");
    }
    if (shareHolderName.value.length > 0) {
      const params = new Map<string, string | number>();
      params.set("name", shareHolderName.value);
      return tOf("Mobile.Meeting.sharingBy", params);
    }
    return t("Mobile.Meeting.stateOn");
  });

  /** 服务端先授予共享权，iOS 再弹 ReplayKit 授权；等待授权时不能误显示为已开启。 */
  const shareIconOn = computed((): boolean => {
    if (localSharePending.value) {
      return false;
    }
    return localShareWasOn.value || shareHolder.value.length > 0;
  });

  // ---------------------------------------------------------------- 底部操作区（5 列网格）

  /** 底部操作格里的一格：action = 可点按钮，empty = 占位，arrow = 收起/展开箭头。 */
  class StageAction {
    key: string = "";
    kind: string = "action";
    label: string = "";
    /** iconfont 字形名（image 为空时才用）。 */
    icon: string = "";
    /** 图片图标地址（非空时优先于 icon）。 */
    image: string = "";
    /** 选中态（共享中 / 已举手 / 弹幕开 / 全员静音 / 录制中）：淡蓝底高亮，图标颜色不变。 */
    on: boolean = false;
    /** 角标数字（会中聊天未读）。 */
    badge: number = 0;
    badgeText: string = "";
    /**
     * 图标整体右移的像素数（个别字形视觉重心偏左时微调）。
     * ★用 position: relative + left，不要用 padding：格子是 flex 居中，
     *   padding 只会把内容盒改小、居中后实际只挪一半（用户实测「padding 不生效」）。
     */
    iconShift: number = 0;
  }

  function makeAction(key: string, label: string, icon: string, image: string, on: boolean): StageAction {
    const item = new StageAction();
    item.key = key;
    item.kind = "action";
    item.label = label;
    item.icon = icon;
    item.image = image;
    item.on = on;
    return item;
  }

  function makeEmptyCell(key: string): StageAction {
    const item = new StageAction();
    item.key = key;
    item.kind = "empty";
    return item;
  }

  /** 收起/展开箭头：永远占「最后一排的最后一格」，图标随展开态换成上/下箭头。 */
  function makeArrowCell(): StageAction {
    const item = new StageAction();
    item.key = "arrow";
    item.kind = "arrow";
    item.icon = actionsVisible.value ? "icon-a-Chevrondown" : "icon-a-Chevronup";
    return item;
  }

  /**
   * 底部操作区按 5 列切片（用户定的排布）：
   * · 主持人：邀请 / 共享 / 举手 / 聊天 / 弹幕 |
   *           麦克风 / 摄像头 / 扬声器 / 全员静音 / 静音所有人 |
   *           参会人 / 录制 / 空 / 空 / 箭头
   * · 参会人：邀请 / 共享 / 举手 / 聊天 / 参会人 |
   *           麦克风 / 摄像头 / 扬声器 / 空 / 箭头
   * · 收起态：只有一排（前 4 格空 + 最后一格箭头）。
   * ★麦克风/摄像头/扬声器/参会人 也是操作按钮，跟着一起展开/收起（不再留在独立底栏里）。
   */
  const actionRows = computed((): StageAction[][] => {
    const rows: StageAction[][] = [];
    if (actionsVisible.value) {
      const all: StageAction[] = [];
      all.push(makeAction("invite", t("Mobile.Meeting.inviteesLabel"), "icon-User", "", false));
      all.push(makeAction("share", t("Mobile.Meeting.shareScreen"), "", "/static/images/icon-screen-share.svg", shareIconOn.value));
      all.push(makeAction("hand", t("Mobile.Meeting.raiseHand"), "", "/static/images/icon-hand.svg", handRaised.value));
      const chat = makeAction("chat", t("Mobile.Meeting.meetingChat"), "icon-message", "", false);
      chat.badge = chatUnread.value;
      chat.badgeText = chatUnreadText.value;
      all.push(chat);
      if (isHost.value) {
        const danmaku = makeAction("danmaku", t("Mobile.Meeting.danmaku"), "icon-notification-box", "", danmakuOn.value);
        // 弹幕字形（方块套方块）视觉重心偏左：整体右移 1px
        danmaku.iconShift = 1;
        all.push(danmaku);
      }
      // 音视频开关：开/关是两张图标（同一 ink 颜色），所以不加高亮底
      all.push(makeAction("mic", t("Mobile.Meeting.micLabel"), "",
        micOn.value ? "/static/voip/call-icons/microphone-ink.png" : "/static/voip/call-icons/microphone-off-ink.png", false));
      all.push(makeAction("camera", t("Mobile.Meeting.cameraLabel"), "",
        cameraOn.value ? "/static/voip/call-icons/video-ink.png" : "/static/voip/call-icons/video-off-ink.png", false));
      all.push(makeAction("speaker", t("Mobile.Meeting.speakerLabel"), "",
        speakerOn.value ? "/static/voip/call-icons/speaker-ink.png" : "/static/voip/call-icons/speaker-off-ink.png", false));
      if (isHost.value) {
        all.push(makeAction("muteAll", t("Mobile.Meeting.fullMute"), "icon-Mic", "", roomMuteAll.value));
        all.push(makeAction("muteEveryone", t("Mobile.Meeting.muteEveryone"), "icon-voice", "", false));
      }
      // 参会人：鸿蒙 <image> 首帧不上屏，退回 iconfont 单人字形
      let membersIcon = "";
      let membersImage = "/static/icons/meeting_members.svg";
      // #ifdef APP-HARMONY
      membersIcon = "icon-User";
      membersImage = "";
      // #endif
      all.push(makeAction("members", membersLabelText.value, membersIcon, membersImage, false));
      if (isHost.value) {
        all.push(makeAction("recording", t("Mobile.Meeting.recording"), "icon-stop-circle", "", recordingOn.value));
      }
      let row: StageAction[] = [];
      for (let i = 0; i < all.length; i++) {
        row.push(all[i]);
        if (row.length == 5) {
          rows.push(row);
          row = [];
        }
      }
      // 末行补空到 4 格，再放箭头（箭头固定在最后一格）
      while (row.length < 4) {
        row.push(makeEmptyCell(`e-${row.length}`));
      }
      row.push(makeArrowCell());
      rows.push(row);
    } else {
      const row: StageAction[] = [];
      for (let i = 0; i < 4; i++) {
        row.push(makeEmptyCell(`c-${i}`));
      }
      row.push(makeArrowCell());
      rows.push(row);
    }
    return rows;
  });

  const recordingStateText = computed((): string => {
    if (moreBusy.value == "recording") {
      return t("Mobile.Meeting.processing");
    }
    return recordingOn.value ? t("Mobile.Meeting.stateOn") : t("Mobile.Meeting.stateOff");
  });

  /**
   * 将房间级全员禁言落实到本端。解除时只恢复“被策略自动关掉”的麦克风，
   * 用户自己按下的静音不会被其它端解除禁言后偷偷打开。
   */
  function syncRoomMutePolicy(): void {
    if (!mediaConnected.value) {
      return;
    }
    const allowed = isHost.value || !roomMuteAll.value || localMicPublishAllowed.value;
    if (!allowed) {
      if (micOn.value) {
        mutedByRoomPolicy.value = true;
        meetingMediaSetMic(false);
      }
      return;
    }
    if (mutedByRoomPolicy.value) {
      mutedByRoomPolicy.value = false;
      meetingMediaSetMic(true);
    }
  }

  /** 与原生授权等待窗口一致；不能在用户操作系统授权页时提前释放共享权。 */
  let sharePendingAt = 0;
  /** 本次共享开始时的原生错误快照：只把「之后新出现的错误」当本次失败。 */
  let shareErrorBaseline = "";

  /** 本次「被主持人静音」是否已经提示过（恢复开麦后复位）。 */
  let micMutedNotified = false;
  /** 连续几次发现「自己的麦克风轨被服务端静音」：满 2 次才收麦。 */
  let selfMicMutedSeen = 0;

  /** 共享失败原因 → 人话（原生给的是 error code / 英文 message，不能原样丢给用户）。 */
  function screenShareErrorText(code: string): string {
    if (code == "background_session_unavailable") return "当前音视频组件不支持整屏共享，请更新应用";
    if (code == "broadcast_extension_missing") return "当前安装包缺少屏幕广播扩展或 App Group 配置";
    if (code == "share_ui_unavailable") return "暂时无法打开共享授权，请回到会议页面后重试";
    if (code == "screen_capture_timeout") return t("Mobile.Meeting.shareTimeout");
    // 抢到占位了、但屏幕轨没推出去（权限下发有延迟 / 编码失败）：提示再点一次
    if (code == "screen_share_publish" || code == "screen_share_no_track") {
      return t("Mobile.Meeting.sharePublishFailed");
    }
    if (code == "not_connected") return t("Mobile.Meeting.mediaConnectFailed");
    const low = code.toLowerCase();
    if (low.indexOf("permission") >= 0 || low.indexOf("security") >= 0 || low.indexOf("foreground") >= 0) {
      return t("Mobile.Meeting.sharePermissionDenied");
    }
    return t("Mobile.Meeting.shareStartFailed");
  }

  /**
   * 「抢共享占位」阶段失败的原因 → 人话。
   * ★之前这一步失败时 toast 取的是**原生采集错误**（此刻还是空串），所以永远只显示
   *   「屏幕共享启动失败，请重试」，把真正原因（限流 / 不在会中 / 被踢）全盖掉了。
   */
  function screenShareStartErrorText(reason: string): string {
    if (reason == "busy") {
      return t("Mobile.Meeting.shareBusy");
    }
    if (reason == "disconnected") {
      return t("Mobile.Meeting.mediaConnectFailed");
    }
    if (reason.indexOf("http:") == 0) {
      const code = reason.substring(5);
      if (code == "IM_30004") {
        return t("Mobile.Meeting.shareBusy");
      }
      if (code == "IM_50403") {
        return t("Mobile.Meeting.shareNotInMeeting");
      }
      if (code == "IM_50001" || code == "IM_50002") {
        return t("Mobile.Meeting.roomEnded");
      }
      if (code == "IM_50006") {
        return t("Mobile.Meeting.kickedOut");
      }
    }
    return screenShareErrorText(meetingMediaScreenShareError());
  }

  /**
   * 读取 LiveKit 房间 metadata 权威快照。原生端暂用 3 秒轮询；PC/H5 仍走
   * RoomMetadataChanged，但字段和缺省值完全相同。
   */
  function refreshRoomMetadata(): void {
    if (!mediaConnected.value) {
      return;
    }
    const mine = getCachedMyInfo();
    const myUserId = mine != null ? mine.userId : "";
    // ★shareHolder 存的是 identity（`tenant:user:platform`），不是 userId；
    //   只能拿成员列表里标记为本端的 identity 去比。
    const myIdentity = myMeetingIdentity();
    const metadata = meetingMediaRoomMetadata();
    roomMuteAll.value = metadata.muteAll;
    danmakuOn.value = metadata.danmaku;
    shareHolder.value = metadata.shareHolder;
    shareHolderName.value = metadata.shareHolderName;
    shareSince.value = metadata.shareSince;
    if (metadata.shareSlug.length > 0) {
      shareSlugRaw.value = metadata.shareSlug;
    }
    // 共享结束 / 换成别人：全屏看着的那一路已经没了，直接退出
    if (shareFullKey.value.length > 0 && metadata.shareHolder != shareFullKey.value) {
      shareFullKey.value = "";
    }
    const nativeShareOn = meetingMediaScreenShareOn();
    const nativeShareError = meetingMediaScreenShareError();
    // 共享排障（保留到「别人共享我看不到」彻底关闭）：有没有把这个人的视频轨订阅上
    if (metadata.shareHolder.length > 0) {
      const shareVideos = meetingMediaRemoteVideoIdentities();
      let videoText = "";
      for (let i = 0; i < shareVideos.length; i++) {
        videoText += (i > 0 ? "|" : "") + shareVideos[i];
      }
      console.error(`[MeetingUI] share holder=${metadata.shareHolder} nativeOn=${nativeShareOn} videoIds=${videoText}`);
    }
    let captureStopped = localShareWasOn.value;
    // #ifdef APP-HARMONY
    if (myIdentity.length > 0 && metadata.shareHolder.length > 0 && metadata.shareHolder != myIdentity) {
      captureStopped = false;
    }
    // #endif
    if (nativeShareOn) {
      localSharePending.value = false;
      localShareWasOn.value = true;
      sharePendingAt = 0;
    } else if (captureStopped) {
      localShareWasOn.value = false;
      void meetingMediaStopScreenShare(roomRaw.value);
    } else if (localSharePending.value) {
      if (nativeShareError.length == 0) {
        // ★原生这一拍把上一次共享留下的错误清掉了：本次共享从这里重新算。
        //   不区分的话，上一轮残留的 "permission…" 会被当成这次失败，表现就是
        //   「有时提示没有录屏权限、有时又能共享」。
        shareErrorBaseline = "";
      } else if (nativeShareError != shareErrorBaseline) {
        localSharePending.value = false;
        shareHolder.value = "";
        shareHolderName.value = "";
        sharePendingAt = 0;
        shareErrorBaseline = "";
        void meetingMediaStopScreenShare(roomRaw.value);
        console.error(`[MeetingUI] screen share failed err=${nativeShareError}`);
        if (nativeShareError != "cancelled" && nativeShareError != "stopped") {
          uni.showToast({ title: screenShareErrorText(nativeShareError), icon: "none" });
        }
      } else if (sharePendingAt > 0 && Date.now() - sharePendingAt > 65000) {
        // iOS 系统广播 picker 没有取消回调，原生 60 秒后收尾，此处仅兜底。
        localSharePending.value = false;
        shareHolder.value = "";
        shareHolderName.value = "";
        sharePendingAt = 0;
        shareErrorBaseline = "";
        void meetingMediaStopScreenShare(roomRaw.value);
        console.error("[MeetingUI] screen share pending timeout");
        uni.showToast({ title: t("Mobile.Meeting.shareTimeout"), icon: "none" });
      }
    }
    // 共享互斥（PC 同口径「后来者赢」）：服务端只认一个共享持有者。被他人接管后
    // 本机必须立刻停采集，否则会继续往房间推屏幕轨，其它端出现两路共享叠加。
    if (localShareWasOn.value && !localSharePending.value
      && myIdentity.length > 0 && metadata.shareHolder.length > 0
      && metadata.shareHolder != myIdentity) {
      localShareWasOn.value = false;
      void meetingMediaStopScreenShare(roomRaw.value);
      const params = new Map<string, string | number>();
      params.set("name", metadata.shareHolderName.length > 0 ? metadata.shareHolderName : t("Mobile.Meeting.someone"));
      uni.showToast({ title: tOf("Mobile.Meeting.shareTakenOver", params), icon: "none" });
    }
    if (metadata.hostUserId.length > 0 && myUserId.length > 0) {
      isHost.value = metadata.hostUserId == myUserId;
    }
    syncRoomMutePolicy();
  }

  // ---------------------------------------------------------------- 交互

  function stopChatPolling(): void {
    if (chatTimer != -1) {
      clearInterval(chatTimer);
      chatTimer = -1;
    }
  }

  function closeSheet(): void {
    sheet.value = "";
    chatOpen.value = false;
    // ★不在这里停聊天轮询：danmaku 消息也走同一条 DataChannel 队列，停掉它
    //   就变成「只有打开聊天面板时才飘弹幕」。轮询跟连接生命周期走（断开/退页才停）。
  }


  /** 媒体层未接入时的统一提示（不伪造开关状态）。 */
  function handleMediaTap(): void {
    uni.showToast({ title: t("Mobile.Meeting.mediaPending"), icon: "none" });
  }

  /** 仅保留给尚未接入的其它媒体能力使用。 */
  function showMoreNativePending(): void {
    uni.showToast({ title: t("Mobile.Meeting.moreNativePending"), icon: "none" });
  }

  /** 点操作前校准原生连接，避免残留 exception 将已入会用户拦在聊天/举手/共享之外。 */
  function syncConnectionBeforeAction(): void {
    meetingMediaReconcile(roomRaw.value);
    if (meetingMediaActiveRoom().length > 0 && meetingMediaActiveRoom() != roomRaw.value) return;
    const snapshot = meetingMediaState();
    mediaConnected.value = snapshot.connected;
    mediaConnecting.value = snapshot.connecting;
    mediaError.value = snapshot.errorText;
  }

  /** 设备按钮在「还不能动」时的提示：能力未接入 / 连接中 / 连接失败分别提示。 */
  function mediaUnavailableToast(tag: string): void {
    // 「插件没随基座」和「这个平台根本还不支持」要分开说：鸿蒙/H5 给明确降级文案，
    // 否则用户会当成加载慢，反复点。
    let title = t("Mobile.Meeting.mediaPending");
    // #ifdef APP-HARMONY
    title = t("Mobile.Meeting.mediaConnectFailed");
    // #endif
    // #ifdef H5
    title = t("Mobile.Meeting.mediaWebPending");
    // #endif
    if (mediaSupported.value) {
      if (mediaConnecting.value) {
        title = t("Mobile.Meeting.mediaConnecting");
      } else if (mediaError.value.length > 0) {
        title = t("Mobile.Meeting.mediaConnectFailed");
      }
    }
    console.error(`[MeetingUI] tap ${tag} unavailable sup=${mediaSupported.value} conn=${mediaConnected.value} connecting=${mediaConnecting.value} err=${mediaError.value} ${meetingMediaDebugLine()}`);
    uni.showToast({ title: title, icon: "none" });
  }

  /** 聊天列表滚到最新一条：`scroll-top` 只在值变化时生效，用只增基数保证每次都变。 */
  let chatScrollBase = 0;
  function scrollChatToBottom(): void {
    chatScrollBase += 1;
    chatScrollTop.value = 1000000 + chatScrollBase;
    // 内容高度要到下一拍才更新：再补一次滚动，否则会停在新消息上面一行
    setTimeout(() => {
      chatScrollBase += 1;
      chatScrollTop.value = 1000000 + chatScrollBase;
    }, 30);
  }

  function drainMeetingChat(): void {
    // #ifdef APP-HARMONY
    const tap = consumeMeetingStageTap(harmonyStageId);
    if (harmonyMediaVisible.value && tap.length > 0) {
      const data = JSON.parseObject(tap);
      if (data != null) {
        const identity = readStr(data, "identity");
        const tile = tiles.value.find((item: StageTile): boolean => item.key == identity);
        if (tile != null) {
          if (data["thumbnail"] === true) stageMainKey.value = tile.key;
          else handleTileTap(tile);
        }
      }
    }
    // #endif
    if (!mediaConnected.value) return;
    try {
      const raw = meetingMediaDrainMessages();
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) return;
      for (let i = 0; i < parsed.length; i++) {
        const obj = parsed[i] as UTSJSONObject;
        const message = new MeetingChatMessage();
        message.text = readStr(obj, "text");
        message.name = readStr(obj, "name");
        message.identity = readStr(obj, "identity");
        message.self = readStr(obj, "self") == "true";
        message.topic = readStr(obj, "topic");
        message.at = readNum(obj, "at", Date.now());
        if (message.text.length > 0) chatMessages.value.push(message);
        // 未读角标：聊天面板没开时收到别人的消息才累加。
        // ★弹幕也算未读（用户 2026-11-26 定：弹幕与聊天消息同一个队列，都要在聊天按钮上提示）；
        //   自己发的不算。
        if (message.text.length > 0 && !message.self && !chatOpen.value) {
          chatUnread.value += 1;
        }
        // 弹幕消息额外进入飘屏队列（动画在 <meeting-danmaku> 里跑，这里只入队）；
        // 聊天面板仍保留记录（对齐飞书「会内临时展示」）。
        if (message.topic == "danmaku" && danmakuOn.value && message.text.length > 0) {
          pushMeetingDanmaku(message.name, message.text);
        }
      }
      while (chatMessages.value.length > 100) chatMessages.value.shift();
      if (parsed.length > 0) scrollChatToBottom();
    } catch (_e) {
    }
  }

  function startChatPolling(): void {
    if (chatTimer != -1) return;
    chatTimer = setInterval(() => { drainMeetingChat(); }, 300);
  }

  function openSheet(name: string): void {
    sheet.value = name;
    chatOpen.value = name == "chat";
    if (name == "chat") {
      // 打开聊天即视为已读（角标清零）
      chatUnread.value = 0;
      startChatPolling();
      drainMeetingChat();
    }
  }


  /** 这个人是不是已经在会里（LiveKit 当前在线成员，3 秒轮询刷新）。 */
  function isInMeetingUser(userId: string): boolean {
    for (let i = 0; i < tiles.value.length; i++) {
      if (tiles.value[i].userId == userId) {
        return true;
      }
    }
    return false;
  }

  /** 已在会的联系人：仍列在名单里，但勾选圈置灰不可选（用户要求，不再整行隐藏）。 */
  function isInviteBlocked(userId: string): boolean {
    return userId.length > 0 && isInMeetingUser(userId);
  }

  /** 把「已在会里」的人从已选里摘掉（刷新/发送前调用，防止带着一个点不中的勾一起发出去）。 */
  function pruneInviteSelection(): void {
    const sel = inviteSelected.value;
    const next: MeetingInviteContact[] = [];
    for (let i = 0; i < sel.length; i++) {
      if (!isInviteBlocked(sel[i].userId)) {
        next.push(sel[i]);
      }
    }
    if (next.length != sel.length) {
      inviteSelected.value = next;
    }
  }

  const inviteCandidates = computed((): MeetingInviteContact[] => {
    const keyword = inviteKeyword.value.trim().toLowerCase();
    const output: MeetingInviteContact[] = [];
    const existing = new Set<string>();
    const currentUser = getCachedMyInfo();
    const selfId = currentUser != null ? currentUser.userId : "";
    for (let i = 0; i < invitePool.value.length; i++) {
      const item = invitePool.value[i];
      // ★已在会里的人不再剔除：列表里保留并置灰（模板按 isInviteBlocked 禁选）
      if (item.userId == selfId || existing.has(item.userId)) {
        continue;
      }
      if (keyword.length > 0 && item.displayName.toLowerCase().indexOf(keyword) < 0 && item.userId.indexOf(keyword) < 0) {
        continue;
      }
      existing.add(item.userId);
      output.push(item);
    }
    return output;
  });

  const inviteSelectedCountText = computed((): string => {
    // 计数只算真正可勾的人（已在会的即便残留在数组里也不算）
    let count = 0;
    const sel = inviteSelected.value;
    for (let i = 0; i < sel.length; i++) {
      if (!isInviteBlocked(sel[i].userId)) {
        count += 1;
      }
    }
    const params = new Map<string, string | number>();
    params.set("count", count);
    return tOf("Mobile.Meeting.inviteesSelected", params);
  });

  function isInviteSelected(userId: string): boolean {
    // 已在会里的人不算选中（勾与计数都跟着变），即便他之前被勾过
    if (isInviteBlocked(userId)) {
      return false;
    }
    for (let i = 0; i < inviteSelected.value.length; i++) {
      if (inviteSelected.value[i].userId == userId) {
        return true;
      }
    }
    return false;
  }

  function handleInviteAvatarError(userId: string): void {
    const rows = invitePool.value;
    const next: MeetingInviteContact[] = [];
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      if (row.userId == userId) {
        row.avatarFailed = true;
      }
      next.push(row);
    }
    invitePool.value = next;
  }

  function resolveInviteAvatars(): void {
    const rows = invitePool.value;
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      if (row.avatarRaw.length == 0) {
        continue;
      }
      const userId = row.userId;
      const raw = row.avatarRaw;
      resolveImAvatarDisplay(raw, 56).then((resolved: string): void => {
        const live = invitePool.value;
        const next: MeetingInviteContact[] = [];
        for (let j = 0; j < live.length; j++) {
          const item = live[j];
          if (item.userId == userId && item.avatarRaw == raw) {
            item.avatar = resolved;
            item.avatarFailed = false;
          }
          next.push(item);
        }
        invitePool.value = next;
      });
    }
  }

  async function loadInviteContacts(): Promise<void> {
    if (invitePoolState.value == "loading" || invitePoolState.value == "ready") {
      return;
    }
    invitePoolState.value = "loading";
    try {
      const res = await apiImContacts();
      if (apiResCode(res) != SUCCESS_CODE) {
        invitePoolState.value = "failed";
        return;
      }
      const data = apiResData<any>(res);
      const obj = data != null ? data as UTSJSONObject : null;
      const rawItems = obj != null ? obj["items"] : null;
      // ★智能体不再被过滤掉（会中邀请支持智能体），且要排在列表最前；
      //   先按类型分两桶再拼，天然稳定排序（不用 sort 比较器，App 端更稳）。
      const agents: MeetingInviteContact[] = [];
      const humans: MeetingInviteContact[] = [];
      if (rawItems != null) {
        const rows = rawItems as UTSJSONObject[];
        for (let i = 0; i < rows.length; i++) {
          const row = rows[i];
          const subjectType = readNum(row, "subjectType", 1);
          const isAgent = subjectType == 2;
          // 人：只保留已互为联系人（status=1，2/3 是待确认）；
          // 智能体：★不过滤（用户明确要求会中邀请要能选到智能体）。
          if (!isAgent && readNum(row, "status", 1) != 1) {
            continue;
          }
          const userId = readStr(row, "userId");
          if (userId.length == 0) {
            continue;
          }
          const displayName = readStr(row, "displayName").length > 0 ? readStr(row, "displayName") : readStr(row, "nickName");
          const contact = new MeetingInviteContact();
          contact.userId = userId;
          contact.displayName = displayName.length > 0 ? displayName : readStr(row, "userName");
          contact.initial = contact.displayName.length > 0 ? contact.displayName.substring(0, 1) : "?";
          contact.avatarRaw = readStr(row, "avatar");
          contact.avatar = imAvatarDisplayUrl(contact.avatarRaw, 56);
          contact.subjectType = subjectType;
          contact.isAgent = isAgent;
          if (contact.isAgent) {
            agents.push(contact);
          } else {
            humans.push(contact);
          }
        }
      }
      const list: MeetingInviteContact[] = [];
      for (let i = 0; i < agents.length; i++) {
        list.push(agents[i]);
      }
      for (let i = 0; i < humans.length; i++) {
        list.push(humans[i]);
      }
      invitePool.value = list;
      invitePoolState.value = "ready";
      resolveInviteAvatars();
    } catch (_error) {
      invitePoolState.value = "failed";
    }
  }

  /** 邀请参会人：改成独立底部弹层（原先是「更多」面板里的内嵌块）。 */
  function openInvitePanel(): void {
    if (inviteSending.value) {
      return;
    }
    if (sheet.value == "invite") {
      closeSheet();
      return;
    }
    inviteKeyword.value = "";
    inviteSelected.value = [];
    openSheet("invite");
    loadInviteContacts();
    loadPasscodeIfNeeded();
  }

  function toggleInvitee(userId: string): void {
    // 已在会里的人勾选圈是禁用的：点了不响应
    if (isInviteBlocked(userId)) {
      return;
    }
    const current = inviteSelected.value;
    const next: MeetingInviteContact[] = [];
    let found = false;
    for (let i = 0; i < current.length; i++) {
      if (current[i].userId == userId) {
        found = true;
      } else {
        next.push(current[i]);
      }
    }
    if (!found) {
      for (let i = 0; i < invitePool.value.length; i++) {
        if (invitePool.value[i].userId == userId) {
          next.push(invitePool.value[i]);
          break;
        }
      }
    }
    inviteSelected.value = next;
  }

  async function sendMeetingInvites(): Promise<void> {
    // 发送前摘掉已在会里的人，避免给刚入会的人白发一张卡
    pruneInviteSelection();
    if (inviteSending.value || inviteSelected.value.length == 0 || roomRaw.value.length == 0) {
      return;
    }
    inviteSending.value = true;
    moreBusy.value = "invite";
    // ★★主持人「再次邀请」被移出的人：先撤销禁入标记，再发邀请消息。
    //   踢人时服务端写了 im_meeting_member.banned，签令牌会据此拒绝；只发消息的话，
    //   对方点邀请卡片/通知仍会撞 IM_50006「你已被移出该会议」（2026-11-27 用户反馈）。
    //   ★只在主持人的这场会里调：普通参会人没有撤销权限，服务端也会拒，
    //     别先发一轮无用请求；★失败不阻断邀请（对齐 PC），真进不去时入会接口有明确提示。
    if (isHost.value) {
      for (let i = 0; i < inviteSelected.value.length; i++) {
        try { await apiImMeetingAllowRejoin(roomRaw.value, inviteSelected.value[i].userId); } catch (_error) {}
      }
    }
    let sent = 0;
    const failed: string[] = [];
    const inviteBase = generateUUID();
    try {
      for (let i = 0; i < inviteSelected.value.length; i++) {
        const person = inviteSelected.value[i];
        try {
          const convRes = await apiImCreateP2pConversation(person.userId, "", true);
          if (apiResCode(convRes) != SUCCESS_CODE) {
            failed.push(person.displayName);
            continue;
          }
          const convData = apiResData<any>(convRes);
          const conv = convData != null ? convData as UTSJSONObject : null;
          const convId = conv != null ? readStr(conv, "convId") : "";
          if (convId.length == 0) {
            failed.push(person.displayName);
            continue;
          }
          const inviteId = `${inviteBase}-${i}`;
          const sendRes = await apiImSendMeetingInvite(
            convId,
            inviteId,
            roomRaw.value,
            titleRaw.value.length > 0 ? titleRaw.value : roomRaw.value,
            "audio",
            false,
            false,
            generateUUID(),
            passcodeState.value == "value" ? passcodeValue.value : "",
          );
          if (apiResCode(sendRes) == SUCCESS_CODE) {
            sent++;
          } else {
            failed.push(person.displayName);
          }
        } catch (_error) {
          failed.push(person.displayName);
        }
      }
    } finally {
      inviteSending.value = false;
      moreBusy.value = "";
    }
    inviteSelected.value = [];
    let message = "";
    if (failed.length == 0) {
      const params = new Map<string, string | number>();
      params.set("count", sent);
      message = tOf("Mobile.Meeting.inviteesSent", params);
    } else if (sent > 0) {
      const params = new Map<string, string | number>();
      params.set("count", sent);
      params.set("failed", failed.length);
      message = `${tOf("Mobile.Meeting.inviteesSentPartial", params)} (${failed.slice(0, 3).join("、")})`;
    } else {
      message = `${t("Mobile.Meeting.inviteesFailed")}: ${failed.slice(0, 3).join("、")}`;
    }
    uni.showToast({ title: message, icon: "none", duration: 2800 });
  }

  function handleShareTap(): void {
    syncConnectionBeforeAction();
    if (!mediaSupported.value || !mediaConnected.value || roomRaw.value.length == 0) {
      mediaUnavailableToast("share");
      return;
    }
    if (localSharePending.value) {
      localSharePending.value = false;
      sharePendingAt = 0;
      void meetingMediaStopScreenShare(roomRaw.value);
      return;
    }
    if (meetingMediaScreenShareOn()) {
      localShareWasOn.value = false;
      localSharePending.value = false;
      void meetingMediaStopScreenShare(roomRaw.value);
      shareHolder.value = "";
      shareHolderName.value = "";
      return;
    }
    moreBusy.value = "share";
    localSharePending.value = true;
    sharePendingAt = Date.now();
    // 记下此刻的残留错误：上一轮失败的错误还在原生层，不区分会被当成本次失败
    shareErrorBaseline = meetingMediaScreenShareError();
    // #ifdef APP-HARMONY
    closeSheet();
    const start = meetingMediaStartScreenShare(roomRaw.value, t("Mobile.Meeting.shareEntireScreen"), t("Mobile.Common.cancel"));
    // #endif
    // #ifndef APP-HARMONY
    const start = meetingMediaStartScreenShare(roomRaw.value);
    // #endif
    void start.then((started: boolean) => {
      moreBusy.value = "";
      if (started) shareErrorBaseline = "";
      if (!started) {
        // 走到这里说明「拿共享权」这步就失败了（系统授权弹窗之后失败由轮询兜）
        localSharePending.value = false;
        sharePendingAt = 0;
        const reason = meetingMediaScreenShareStartError();
        console.error(`[MeetingUI] screen share start failed reason=${reason} native=${meetingMediaScreenShareError()}`);
        uni.showToast({ title: screenShareStartErrorText(reason), icon: "none" });
      }
    });
  }

  function handleRaiseHandTap(): void {
    syncConnectionBeforeAction();
    if (!mediaSupported.value || !mediaConnected.value) {
      mediaUnavailableToast("hand");
      return;
    }
    const next = !handRaised.value;
    handRaised.value = next;
    meetingMediaSetHandRaised(next);
  }

  function handleMeetingChatTap(): void {
    syncConnectionBeforeAction();
    if (!mediaSupported.value || !mediaConnected.value) {
      mediaUnavailableToast("chat");
      return;
    }
    openSheet("chat");
  }

  function handleChatInput(event: UniInputEvent): void {
    if (event == null) {
      return;
    }
    chatInput.value = event.detail.value;
  }

  /** 发一条会中聊天：★不限长度（120 字只是老的口径，不是服务端限制；
   *  真正的硬上限是 LiveKit 数据包大小，超大文本由传输层拒收）。 */
  function sendMeetingChatMessage(): void {
    const text = chatInput.value.trim();
    if (text.length == 0 || !mediaConnected.value) return;
    meetingMediaSendMessage(text, myName.value, danmakuOn.value);
    chatInput.value = "";
    // 发完立刻贴底（自己的消息要 80ms 后才由 native 回传，先滚一下不等它）
    scrollChatToBottom();
    setTimeout(() => {
      drainMeetingChat();
      scrollChatToBottom();
    }, 80);
  }

  /** 主持人切换房间级全员禁言：开启后普通参会人不能自行开麦。 */
  async function handleToggleRoomMuteAll(): Promise<void> {
    if (!isHost.value || roomRaw.value.length == 0 || moreBusy.value.length > 0) {
      return;
    }
    const next = !roomMuteAll.value;
    moreBusy.value = "muteAll";
    try {
      const res = await apiImMeetingUpdateRoomSettings(roomRaw.value, next, null);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Meeting.controlFailed"), icon: "none" });
        return;
      }
      roomMuteAll.value = next;
      setTimeout(() => { refreshRoomMetadata(); }, 300);
      uni.showToast({
        title: t(next ? "Mobile.Meeting.fullMuteEnabled" : "Mobile.Meeting.fullMuteDisabled"),
        icon: "none",
      });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Meeting.controlFailed"), icon: "none" });
    } finally {
      moreBusy.value = "";
    }
  }

  /** 主持人一次性静音所有参会人；与 PC 同口径，对方之后仍可自行重新开麦。 */
  async function handleMuteEveryone(): Promise<void> {
    if (!isHost.value || roomRaw.value.length == 0 || moreBusy.value.length > 0) {
      return;
    }
    moreBusy.value = "muteEveryone";
    try {
      const res = await apiImMeetingMuteAll(roomRaw.value);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Meeting.controlFailed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Meeting.muteEveryoneDone"), icon: "none" });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Meeting.controlFailed"), icon: "none" });
    } finally {
      moreBusy.value = "";
    }
  }

  /** 主持人改房间弹幕总开关；普通参会人的弹幕收发要等 DataChannel 接入。 */
  async function handleDanmakuTap(): Promise<void> {
    if (!isHost.value) {
      showMoreNativePending();
      return;
    }
    if (roomRaw.value.length == 0 || moreBusy.value.length > 0) {
      return;
    }
    const next = !danmakuOn.value;
    moreBusy.value = "danmaku";
    try {
      const res = await apiImMeetingUpdateRoomSettings(roomRaw.value, null, next);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Meeting.controlFailed"), icon: "none" });
        return;
      }
      danmakuOn.value = next;
      setTimeout(() => { refreshRoomMetadata(); }, 300);
      uni.showToast({
        title: t(next ? "Mobile.Meeting.danmakuEnabled" : "Mobile.Meeting.danmakuDisabled"),
        icon: "none",
      });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Meeting.controlFailed"), icon: "none" });
    } finally {
      moreBusy.value = "";
    }
  }

  /** 从服务端录制列表恢复正在进行的 egress，避免换端进入后把“停止录制”显示成“录制”。 */
  async function loadRecordingState(): Promise<void> {
    if (!isHost.value || roomRaw.value.length == 0) {
      return;
    }
    try {
      const res = await apiImMeetingListRecordings(roomRaw.value, true);
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const raw = apiResData<any>(res);
      if (raw == null || !Array.isArray(raw)) {
        return;
      }
      recordingOn.value = false;
      recordingEgressId.value = "";
      const list = raw as UTSJSONObject[];
      for (let i = list.length - 1; i >= 0; i--) {
        const item = list[i];
        if (item == null) {
          continue;
        }
        const statusText = readStr(item, "status");
        if (statusText == "EGRESS_STARTING" || statusText == "EGRESS_ACTIVE" || statusText == "EGRESS_ENDING") {
          recordingEgressId.value = readStr(item, "egressId");
          recordingOn.value = recordingEgressId.value.length > 0;
          return;
        }
      }
    } catch (_error) {
    }
  }

  /** 主持人开始 / 停止云端录制，参数与 PC 房间会议保持一致。 */
  async function handleToggleRecording(): Promise<void> {
    if (!isHost.value || roomRaw.value.length == 0 || moreBusy.value.length > 0) {
      return;
    }
    moreBusy.value = "recording";
    try {
      if (recordingOn.value && recordingEgressId.value.length > 0) {
        const stopRes = await apiImMeetingStopRecording(roomRaw.value, recordingEgressId.value);
        if (apiResCode(stopRes) != SUCCESS_CODE) {
          uni.showToast({ title: t("Mobile.Meeting.controlFailed"), icon: "none" });
          return;
        }
        recordingOn.value = false;
        recordingEgressId.value = "";
        uni.showToast({ title: t("Mobile.Meeting.recordingStopped"), icon: "none" });
        return;
      }
      const body: UTSJSONObject = {
        layout: "grid",
        title: pageTitle.value,
        origin: 1,
        meetingType: 2,
        selfDisplayName: myName.value,
      };
      const startRes = await apiImMeetingStartRecording(roomRaw.value, body);
      if (apiResCode(startRes) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Meeting.controlFailed"), icon: "none" });
        return;
      }
      const raw = apiResData<any>(startRes);
      if (raw == null) {
        uni.showToast({ title: t("Mobile.Meeting.controlFailed"), icon: "none" });
        return;
      }
      recordingEgressId.value = readStr(raw as UTSJSONObject, "egressId");
      if (recordingEgressId.value.length == 0) {
        uni.showToast({ title: t("Mobile.Meeting.controlFailed"), icon: "none" });
        return;
      }
      recordingOn.value = true;
      uni.showToast({ title: t("Mobile.Meeting.recordingStarted"), icon: "none" });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Meeting.controlFailed"), icon: "none" });
    } finally {
      moreBusy.value = "";
    }
  }

  // ---------------------------------------------------------------- 在线成员（舞台卡片）

  function stopPeoplePoll(): void {
    if (peopleTimer != -1) {
      clearInterval(peopleTimer);
      peopleTimer = -1;
    }
  }

  // #ifdef APP-HARMONY
  function resolveHarmonyMyAvatar(): void {
    const info = getCachedMyInfo();
    const raw = info != null ? info.avatar : "";
    if (raw.length == 0) {
      harmonyMyAvatar.value = "";
      return;
    }
    resolveHarmonyMeetingAvatarData(raw).then((resolved: string): void => {
      if (resolved.length == 0 || pageUnmounted) return;
      const current = getCachedMyInfo();
      if (current == null || current.avatar != raw) return;
      harmonyMyAvatar.value = resolved;
      myAvatarFailed.value = false;
    });
  }

  function resolveHarmonyParticipantAvatars(rows: StageTile[]): void {
    const room = roomRaw.value;
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      const raw = row.avatarRaw;
      if (raw.length == 0 || row.avatar.indexOf("data:image/") == 0) continue;
      const key = row.key;
      resolveHarmonyMeetingAvatarData(raw).then((resolved: string): void => {
        if (resolved.length == 0 || pageUnmounted || roomRaw.value != room) return;
        const live = tiles.value.find((tile: StageTile): boolean => tile.key == key && tile.avatarRaw == raw);
        if (live == null) return;
        live.avatar = resolved;
        live.avatarFailed = false;
      });
    }
  }
  // #endif

  /** 给现有卡片补上头像地址并整表重建（响应式换引用，行级原地写不刷新）。
   *  ★必须写在 loadAvatarMap 之前：uvue 同级函数前向引用报 error18。 */
  function rebuildTileAvatars(): void {
    const list = tiles.value;
    if (list.length == 0) {
      return;
    }
    const next: StageTile[] = [];
    for (let i = 0; i < list.length; i++) {
      const t = list[i];
      if (t.avatarRaw.length > 0 && t.avatar.length == 0) {
        t.avatar = imAvatarDisplayUrl(t.avatarRaw, 96);
      }
      // 联系人表可能比成员列表后到：补上展示名（含把「用户+id」换成人名）
      const contactName = t.userId.length > 0 ? nameByUser.get(t.userId) : null;
      if (contactName != null && contactName.length > 0) {
        t.name = contactName;
        t.initial = contactName.substring(0, 1);
      }
      next.push(t);
    }
    tiles.value = next;
    // #ifdef APP-HARMONY
    resolveHarmonyParticipantAvatars(tiles.value);
    // #endif
  }

  /**
   * 联系人表 → userId 头像映射，舞台卡片据此显示真实头像（一次一页，失败静默）。
   * ★参与者接口只给 userId/name，不带头像；头像统一由联系人表补，取不到就用首字兜底。
   */
  async function loadAvatarMap(): Promise<void> {
    if (avatarLoaded) {
      return;
    }
    avatarLoaded = true;
    try {
      const res = await apiImContacts();
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const data = apiResData<any>(res);
      if (data == null) {
        return;
      }
      // ★联系人接口返回的是对象 `{ items: [...], degraded, truncated }`，不是数组
      //   （之前按数组解析拿不到任何头像，全员退回首字）
      const obj = data as UTSJSONObject;
      const itemsRaw = obj["items"];
      if (itemsRaw == null) {
        return;
      }
      const list = itemsRaw as UTSJSONObject[];
      const map = new Map<string, string>();
      const names = new Map<string, string>();
      for (let i = 0; i < list.length; i++) {
        const item = list[i];
        if (item == null) {
          continue;
        }
        const obj = item as UTSJSONObject;
        const uid = readStr(obj, "userId");
        const avatar = readStr(obj, "avatar");
        // displayName 服务端已按 remark > nickName > userName 算好，直接用
        const displayName = readStr(obj, "displayName").trim();
        if (uid.length > 0 && avatar.length > 0) {
          map.set(uid, avatar);
        }
        if (uid.length > 0 && displayName.length > 0) {
          names.set(uid, displayName);
        }
      }
      avatarByUser = map;
      nameByUser = names;
      // 头像/名字到了：用已解析地址重建卡片，逼一次重渲染（Android 原地改行不重绘）
      rebuildTileAvatars();
    } catch (_error) {
    }
  }

  /**
   * 头像加载失败 → 退回首字兜底。
   * ★回调里不直接改行字段后指望重绘：App-Android 行级原地写不刷新，
   *   而且原生事件回调里读响应式容易踩 NPE（android-native-event-reactive-read-npe），
   *   所以整表重建放在 setTimeout(0) 里做。
   */
  function handleTileAvatarError(tile: StageTile): void {
    setTimeout(() => {
      tile.avatarFailed = true;
      const list = tiles.value;
      const next: StageTile[] = [];
      for (let i = 0; i < list.length; i++) {
        next.push(list[i]);
      }
      tiles.value = next;
    }, 0);
  }

  /** 数组里有没有这个 identity（不用 Array.includes：各端实现一致性不确定）。 */
  function hasIdentity(ids: string[], id: string): boolean {
    for (let i = 0; i < ids.length; i++) {
      if (ids[i] == id) {
        return true;
      }
    }
    return false;
  }

  /** 会中定期核对服务端会议状态；网络错误或踢人不误判为结束。 */
  let meetingClosing = false;
  let roomEndChecking = false;
  let roomEndCheckedAt = 0;
  /** 本端是否真的入过会（只置 true）：决定要不要跑「远端结束」看门狗。 */
  let everMediaConnected = false;
  /** 入过会又被断开的一次性处理标记（重连/重新入会成功后复位）。 */
  let mediaLostHandled = false;
  /** 远端结束看门狗（与媒体连接解耦，见 checkRoomEnded 的注释）。 */
  let remoteEndTimer = -1;
  /** 成员列表里曾出现过自己；被移出后不会再出现，用它区分「还没同步到」和「真的被踢」。 */
  let selfSeenInList = false;
  /** 连续看不到自己的次数（3 秒一次）：满 2 次才认定被移出，避免服务端快照抖动误判。 */
  let selfMissingChecks = 0;
  /** 页面已卸载：延迟退栈的回调别再动导航（否则会把上一页弹掉）。 */
  let pageUnmounted = false;

  function returnFromClosedMeeting(): void {
    if (pageUnmounted) return;
    uni.navigateBack({ delta: 1, fail: (_error) => {
      if (!pageUnmounted) uni.reLaunch({ url: "/pages/tab-shell/tab-shell" });
    } });
  }

  /** 会议已被服务端结束/取消：统一收尾（定时核对与被移出核对共用同一套动作）。 */
  function closeBecauseEnded(endedStatus: number): void {
    if (meetingClosing || pageUnmounted) return;
    meetingClosing = true;
    console.error(`[MeetingUI] remote meeting ended status=${endedStatus}`);
    status.value = endedStatus;
    eventBus.emit(IM_MEETING_CHANGED_EVENT, {});
    uni.showToast({ title: t("Mobile.Meeting.endDone"), icon: "none" });
    void meetingMediaDisconnect();
    setTimeout(() => {
      returnFromClosedMeeting();
    }, 400);
  }

  /** 被主持人移出：服务端已取消我们的席位，本端立即断开并退回上一页（PC 同口径）。 */
  async function handleKickedOut(): Promise<void> {
    if (meetingClosing) {
      return;
    }
    // ★整场会议被结束时成员列表同样看不到自己，不能误报成「被移出」。
    try {
      const res = await apiImMeetingPublicRoomSafe(roomRaw.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        if (raw != null) {
          const ended = readNum(raw as UTSJSONObject, "status", -1);
          if (ended == 2 || ended == 3) {
            closeBecauseEnded(ended);
            return;
          }
        }
      }
    } catch (_e) {
    }
    if (meetingClosing) {
      return;
    }
    meetingClosing = true;
    console.error("[MeetingUI] kicked out by host");
    eventBus.emit(IM_MEETING_CHANGED_EVENT, {});
    uni.showToast({ title: t("Mobile.Meeting.kickedOut"), icon: "none" });
    void meetingMediaDisconnect();
    setTimeout(() => {
      if (!pageUnmounted) uni.navigateBack({ delta: 1 });
    }, 600);
  }

  /**
   * 核对服务端会议是否已被结束/取消（REST，**不依赖** LiveKit 连接）。
   * ★必须与连接状态解耦：主持人结束会议 = 服务端删房，房内所有人**先被踢出房间**，
   *   `mediaConnected` 变 false 后成员/聊天轮询会整体停掉；旧实现又把 `mediaConnected`
   *   当作本函数的前提，于是最该退出的这一刻反而永远查不到（只剩「断线前恰好抢到一次
   *   轮询」的运气路径）。现在只看「本端入过会」，被踢之后照样查得出来。
   */
  async function checkRoomEnded(): Promise<void> {
    const now = Date.now();
    if (meetingClosing || pageUnmounted || roomEndChecking || !everMediaConnected
        || roomRaw.value.length == 0 || now - roomEndCheckedAt < 5000) {
      return;
    }
    roomEndChecking = true;
    roomEndCheckedAt = now;
    try {
      const res = await apiImMeetingPublicRoomSafe(roomRaw.value);
      if (meetingClosing || pageUnmounted) {
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        if (apiResCode(res) == "IM_50001" || apiResCode(res) == "IM_50002") closeBecauseEnded(2);
        return;
      }
      const raw = apiResData<any>(res);
      if (raw == null) {
        return;
      }
      const ended = readNum(raw as UTSJSONObject, "status", -1);
      if (ended != 2 && ended != 3) {
        return;
      }
      closeBecauseEnded(ended);
    } catch (error) {
      console.error(`[MeetingUI] room end check failed: ${error}`);
    } finally {
      roomEndChecking = false;
    }
  }

  /** ★声明顺序：start 里的定时器回调会调 stop，所以 stop 必须写在 start 之前（uvue 前向引用限制）。 */
  function stopRemoteEndWatch(): void {
    if (remoteEndTimer != -1) {
      clearInterval(remoteEndTimer);
      remoteEndTimer = -1;
    }
  }

  /**
   * 远端结束看门狗：入过会就一直跑，**与会中成员轮询相互独立**。
   * ★为什么必须单独一个定时器：成员/聊天轮询跟着 `mediaConnected` 开关，主持人删房会先把
   *   我们踢断，轮询随之全停；只有这条不依赖连接状态的核对能在「已被踢出」之后发现会议结束。
   * 未入会过（连不上/还没连）不跑，避免白打请求。
   */
  function startRemoteEndWatch(): void {
    if (remoteEndTimer != -1) {
      return;
    }
    remoteEndTimer = setInterval(() => {
      if (meetingClosing || pageUnmounted || !everMediaConnected || roomRaw.value.length == 0) {
        stopRemoteEndWatch();
        return;
      }
      void checkRoomEnded();
    }, 3000);
  }

  // ---------------------------------------------------------------- 舞台布局（布局弹层 + 演讲者跟踪）

  /** 演讲者布局的跟踪节拍（1.2 秒）：交给原生按 isSpeaking/音量给出「正在说的人」。 */
  let speakerTimer = -1;
  let speakerPolling = false;

  /** ★声明顺序：start 里的定时器回调会调 poll，setStageLayout 会调 start/stop，
      三者必须按 stop → poll → start → setStageLayout 的顺序写（uvue 前向引用限制）。 */
  function stopSpeakerWatch(): void {
    if (speakerTimer != -1) {
      clearInterval(speakerTimer);
      speakerTimer = -1;
    }
    speakerPolling = false;
  }

  /**
   * 问一次「现在是谁在说话」：远端优先（原生挑音量最大的那位），
   * 没有远端在说时才看本机开麦音量；都没人说话就**保留上一位**（粘住，避免大图乱跳/变空）。
   */
  function pollSpeaker(): void {
    if (meetingClosing || pageUnmounted || speakerPolling) {
      return;
    }
    speakerPolling = true;
    try {
      const remote = meetingMediaRemoteSpeakingIdentity();
      if (remote.length > 0) {
        speakerKey.value = remote;
        return;
      }
      if (micOn.value && meetingMediaLocalAudioLevel() > 0.02) {
        const list = tiles.value;
        for (let i = 0; i < list.length; i++) {
          if (list[i].isMe) {
            speakerKey.value = list[i].key;
            return;
          }
        }
      }
    } finally {
      speakerPolling = false;
    }
  }

  function startSpeakerWatch(): void {
    if (speakerTimer != -1) {
      return;
    }
    pollSpeaker();
    speakerTimer = setInterval(() => { pollSpeaker(); }, 1200);
  }

  /** 计时行右侧的布局按钮：再点一次收起选择面板（用户要求）。 */
  function toggleLayoutPicker(): void {
    if (sheet.value == "layout") {
      closeSheet();
      return;
    }
    openSheet("layout");
  }

  /** 选一种舞台布局；选完即收起面板，宫格放大态一并退出（两套语义不叠加）。 */
  function setStageLayout(layout: string): void {
    stageLayout.value = layout;
    focusedTileKey.value = "";
    // 演讲者布局才需要按秒追问「谁在说话」，其它布局一律停掉轮询
    if (layout == "speaker") {
      startSpeakerWatch();
    } else {
      stopSpeakerWatch();
    }
    closeSheet();
  }

  /** 点缩略图：把这个人放大到大图区。 */
  function selectStageMain(tile: StageTile): void {
    stageMainKey.value = tile.key;
  }

  /**
   * 入过会却被断开（不是本端主动离会/结束）：立刻按服务端记录判断这是「会议结束」还是
   * 「本端连接掉了」。会议已结束 → closeBecauseEnded 自动退出；记录仍是进行中 → 只提示一次，
   * 页面保留，用户可自行返回或重新入会。
   */
  async function handleMediaLost(): Promise<void> {
    if (meetingClosing || pageUnmounted || !everMediaConnected) {
      return;
    }
    // 绕过 5 秒节流：断线这一下就是最需要立刻核对的时刻
    roomEndCheckedAt = 0;
    await checkRoomEnded();
    if (meetingClosing || pageUnmounted) {
      return;
    }
    // 记录显示会议还在进行：再区分「被主持人移出」和「本端连接掉了」——
    // 被移出时成员接口会回 IM_50006 / IM_30001（席位已取消），走既有的被踢收尾。
    try {
      const res = await apiImMeetingParticipants(roomRaw.value, true);
      const code = apiResCode(res);
      if (code == "IM_50006" || code == "IM_30001") {
        void handleKickedOut();
        return;
      }
    } catch (_e) {
    }
    if (meetingClosing || pageUnmounted) {
      return;
    }
    // 纯连接问题（网络/被同账号顶号）：提示一次，不误报「已结束」，页面留给用户自己返回
    console.error("[MeetingUI] media lost but meeting still ongoing");
    uni.showToast({ title: t("Mobile.Meeting.mediaConnectFailed"), icon: "none" });
  }

  /**
   * 举手排序记录（key=参与者 identity，at=首次看到举手时的序号，越小越早）。
   * ★服务端的 attributes 只有 `handRaised='1'`，没有时间戳，所以「先来后到」只能由端上
   *   在**第一次看到某人举手**的时刻打点；放下手/离开就从记录里消失，重新举手按新时间排。
   */
  class HandRaiseMark {
    key: string = "";
    at: number = 0;
  }
  let handRaiseMarks: HandRaiseMark[] = [];
  let handRaiseSeq = 0;

  function handRaiseOrderOf(key: string): number {
    for (let i = 0; i < handRaiseMarks.length; i++) {
      if (handRaiseMarks[i].key == key) {
        return handRaiseMarks[i].at;
      }
    }
    return 0;
  }

  /**
   * 把正在举手的人排到宫格最前（多人举手按举起时间先来后到），其余人保持服务端原顺序。
   * ★只调整渲染顺序，不改成员数据本身。
   * ★发现**新**举手的人时顺手把宫格翻回第 1 页（见下面 pageIndex 那行）。
   */
  function orderTilesByHand(list: StageTile[]): StageTile[] {
    const raised: StageTile[] = [];
    const rest: StageTile[] = [];
    const marks: HandRaiseMark[] = [];
    for (let i = 0; i < list.length; i++) {
      const tile = list[i];
      if (!tile.handRaised) {
        rest.push(tile);
        continue;
      }
      let at = handRaiseOrderOf(tile.key);
      if (at == 0) {
        handRaiseSeq += 1;
        at = handRaiseSeq;
        // 有新人举手：把宫格翻回第 1 页。举手的人已经被排到第 1 页，
        // 不同步翻页的话，停在 2/3 页的人根本看不到谁举了手（用户要求）。
        pageIndex.value = 0;
      }
      const mark = new HandRaiseMark();
      mark.key = tile.key;
      mark.at = at;
      marks.push(mark);
      raised.push(tile);
    }
    // 用本次快照覆盖：放下手/已离开的人自然被清掉
    handRaiseMarks = marks;
    // 举手人数很少，插入排序足够（uvue 各端的 sort 比较器行为不一致，不依赖它）
    for (let i = 1; i < raised.length; i++) {
      const cur = raised[i];
      const curAt = handRaiseOrderOf(cur.key);
      let j = i - 1;
      while (j >= 0 && handRaiseOrderOf(raised[j].key) > curAt) {
        raised[j + 1] = raised[j];
        j -= 1;
      }
      raised[j + 1] = cur;
    }
    const out: StageTile[] = [];
    for (let i = 0; i < raised.length; i++) {
      out.push(raised[i]);
    }
    for (let i = 0; i < rest.length; i++) {
      out.push(rest[i]);
    }
    return out;
  }

  /** 拉一次会中在线成员 → 舞台卡片。失败保留上一次，不闪空。 */
  async function loadParticipants(): Promise<void> {
    if (roomRaw.value.length == 0 || !mediaConnected.value || meetingClosing || peopleLoading) {
      return;
    }
    peopleLoading = true;
    try {
      const res = await apiImMeetingParticipants(roomRaw.value, true);
      if (!mediaConnected.value || meetingClosing) {
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        const failCode = apiResCode(res);
        console.error(`[MeetingUI] participants failed code=${failCode}`);
        // ★IM_50006 = 已被移出该会议：成员列表直接拒绝，不用再等「连续两次看不到自己」。
        //   不在这里收口的话，被移出方会一直停在会议信息页且没有任何提示。
        if (failCode == "IM_50006") {
          void handleKickedOut();
          return;
        }
        // ★IM_30001 = 服务端「你已经不在该会议里」：被主持人移出后席位就没了，
        //   成员接口会一直这样拒（不是空列表）。连续两次才收口，避免刚入会时的瞬时竞态。
        if (failCode == "IM_30001") {
          selfMissingChecks += 1;
          if (selfMissingChecks >= 2) {
            selfMissingChecks = 0;
            void handleKickedOut();
          }
          return;
        }
        // 成员列表拉不到（未加入/服务端未同步/会议已收尾）时只记日志：
        // 舞台退回"只有我"的样式，不留空白块
        await checkRoomEnded();
        return;
      }
      const data = apiResData<any>(res);
      if (data == null || !Array.isArray(data)) {
        return;
      }
      const list = data as UTSJSONObject[];
      const mine = getCachedMyInfo();
      const myUserId = mine != null ? mine.userId : "";
      let foundLocal = false;
      let localCanPublishMic = localMicPublishAllowed.value;
      // 哪些远端已经订阅到视频（原生层查询；空数组=没人开视频）
      const videoIds = meetingMediaRemoteVideoIdentities();
      const next: StageTile[] = [];
      for (let i = 0; i < list.length; i++) {
        const item = list[i];
        if (item == null) {
          continue;
        }
        const obj = item as UTSJSONObject;
        const identity = readStr(obj, "identity");
        // 云端录制 Egress 是 LiveKit 参与者但不是人；与 PC 一样从成员列表/人数中剔除。
        if (identity.startsWith("EG_")) {
          continue;
        }
        const permissionRaw = obj["permission"];
        if (permissionRaw != null) {
          const permission = permissionRaw as UTSJSONObject;
          if (readStr(permission, "hidden") == "true" || readStr(permission, "recorder") == "true") {
            continue;
          }
        }
        const tile = new StageTile();
        // 自己去重：identity=tenant:user:platform，同一用户多端会各占一行（PC/手机）。
        // 舞台按人聚合会丢信息，这里按 identity 展示，名字重复就重复。
        tile.key = identity;
        tile.name = readStr(obj, "name");
        const uid = readStr(obj, "userId");
        if (tile.name.length == 0) {
          tile.name = uid == myUserId && myUserId.length > 0 ? myName.value : "参会人";
        }
        if (uid == myUserId && myUserId.length > 0 && myName.value.length > 0) {
          tile.name = myName.value;
        }
        // 名字兜底：服务端在签令牌时没拿到昵称会落成「用户+userId」，宫格里显示一串数字。
        // ① 联系人表有 displayName（备注>昵称）就用它；② 否则别把数字露给用户。
        if (uid.length > 0) {
          const contactName = nameByUser.get(uid);
          if (contactName != null && contactName.length > 0) {
            tile.name = contactName;
          } else if (tile.name == `用户${uid}`) {
            tile.name = uid == myUserId && myUserId.length > 0 ? myName.value : "参会人";
          }
        }
        tile.initial = tile.name.length > 0 ? tile.name.substring(0, 1) : "?";
        tile.host = readStr(obj, "host") == "true";
        tile.userId = uid;
        tile.isMe = isCurrentDeviceIdentity(tile.key, uid, myUserId);
        // 发布权限：permission.canPublish=false ⇒ 主持人已禁止发言（和"静音"是两回事）
        const permRaw = obj["permission"];
        if (permRaw != null) {
          const permission = permRaw as UTSJSONObject;
          tile.canPublish = readStr(permission, "canPublish") != "false";
          const sourcesRaw = permission["canPublishSources"];
          if (sourcesRaw != null && Array.isArray(sourcesRaw)) {
            const sources = sourcesRaw as string[];
            if (sources.length > 0) {
              let allowsMic = false;
              for (let j = 0; j < sources.length; j++) {
                const source = `${sources[j]}`.toUpperCase();
                if (source == "MICROPHONE" || source == "2") allowsMic = true;
                if (source == "SCREEN_SHARE" || source == "3") tile.keepsShare = true;
              }
              tile.canPublish = tile.canPublish && allowsMic;
            }
          }
        }
        if (tile.isMe) {
          foundLocal = true;
          localCanPublishMic = tile.canPublish;
        }
        const attributesRaw = obj["attributes"];
        if (attributesRaw != null) {
          const attributes = attributesRaw as UTSJSONObject;
          tile.handRaised = readStr(attributes, "handRaised").length > 0;
        }
        // 更多面板里的举手按钮只代表本机席位，不能被其他参会人的 attributes 带动。
        if (tile.isMe) {
          handRaised.value = tile.handRaised;
        }
        // 轨道：有未静音的音轨才算"在说"；摄像头同理
        let mic = false;
        let cam = false;
        /** 是否存在麦克风轨（不管是否静音）：区分「还没发布」和「被服务端静音」。 */
        let micTrack = false;
        const tracksRaw = obj["tracks"];
        if (tracksRaw != null && Array.isArray(tracksRaw)) {
          const tracks = tracksRaw as UTSJSONObject[];
          for (let j = 0; j < tracks.length; j++) {
            const tr = tracks[j];
            if (tr == null) {
              continue;
            }
            const trObj = tr as UTSJSONObject;
            const source = readStr(trObj, "source").toUpperCase();
            const type = readStr(trObj, "type").toUpperCase();
            const muted = readStr(trObj, "muted") == "true";
            if (source == "MICROPHONE" || (source.length == 0 && type == "AUDIO")) {
              micTrack = true;
              if (!muted) {
                mic = true;
              }
            }
            if ((source == "CAMERA" || (source.length == 0 && type == "VIDEO")) && !muted) {
              cam = true;
            }
            if ((source == "SCREEN_SHARE" || source == "SCREEN_SHARE_VIDEO") && !muted) tile.keepsShare = true;
          }
        }
        tile.micOn = mic;
        tile.cameraOn = cam;
        // 主持人把我静音了：服务端只把轨道置 muted（PC 靠 TrackMuted 事件收回本地开关），
        // 本端没有事件回调，只能靠成员接口的权威轨道状态对齐。
        // ★必须「麦克风轨存在且 muted」才算，刚开麦还没发布的空窗不会被误判；
        //   连续两次（约 6 秒）确认后停放本机采集并提示。
        if (tile.isMe && micTrack && micOn.value && !mic) {
          selfMicMutedSeen += 1;
          if (selfMicMutedSeen >= 2) {
            selfMicMutedSeen = 0;
            micOn.value = false;
            mutedByRoomPolicy.value = false;
            // 这里只同步按钮状态，不能关闭本地音轨；否则主持人随后取消静音时，
            // 服务端已经找不到可恢复的 publication，会表现成点击没有反应。
            if (!micMutedNotified) {
              micMutedNotified = true;
              uni.showToast({ title: t("Mobile.Meeting.mutedByHost"), icon: "none" });
            }
          }
        } else if (tile.isMe && mic) {
          selfMicMutedSeen = 0;
          if (!micOn.value) {
            micOn.value = true;
          }
          if (micMutedNotified) {
            micMutedNotified = false;
            uni.showToast({ title: t("Mobile.Meeting.unmutedByHost"), icon: "none" });
          }
        } else if (tile.isMe && !micOn.value) {
          selfMicMutedSeen = 0;
        }
        // 真实头像：自己用缓存里的头像（联系人表通常不含自己），别人查联系人表
        let avatarRaw = "";
        if (tile.isMe) {
          const mineInfo = getCachedMyInfo();
          avatarRaw = mineInfo != null ? mineInfo.avatar : "";
        }
        if (avatarRaw.length == 0) {
          const fromMap = avatarByUser.get(uid);
          avatarRaw = fromMap != null ? fromMap : "";
        }
        tile.avatarRaw = avatarRaw;
        tile.avatar = imAvatarDisplayUrl(tile.avatarRaw, 96);
        // 视频格：自己看本机预览（开摄像头才有）；远端还要同时校验成员接口里的
        // CAMERA 轨道未静音。iOS/Android 关闭摄像头后原生层可能仍保留已订阅的
        // identity，仅看 videoIds 会让 native-view 一直显示关闭前的最后一帧。
        if (tile.isMe) {
          tile.hasVideo = cameraOn.value && mediaConnected.value && videoBridgeReady.value;
        } else {
          tile.hasVideo = (tile.keepsShare || tile.cameraOn) && hasIdentity(videoIds, tile.key) && videoBridgeReady.value;
        }
        next.push(tile);
      }
      if (next.length > 0) {
        // 举手的人排最前（按举起时间先来后到），其余保持服务端顺序
        tiles.value = orderTilesByHand(next);
        // 放大着的那个人已经离会：清掉 key，免得他重新入会（identity 不变）时又莫名其妙全屏
        if (focusedTileKey.value.length > 0 && focusedTile.value == null) {
          focusedTileKey.value = "";
        }
        // #ifdef APP-HARMONY
        resolveHarmonyParticipantAvatars(tiles.value);
        // #endif
      }
      if (foundLocal) {
        selfSeenInList = true;
        selfMissingChecks = 0;
        localMicPublishAllowed.value = localCanPublishMic;
      } else if (!selfSeenInList) {
        // 列表拉成功但还没有自己（刚入会）：属正常过渡，清掉「接口拒绝」的计数
        selfMissingChecks = 0;
      } else if (selfSeenInList) {
        // 自己被主持人移出后，成员列表里就再也找不到本端 identity。
        selfMissingChecks++;
        if (selfMissingChecks >= 2) {
          selfMissingChecks = 0;
          selfSeenInList = false;
          void handleKickedOut();
          return;
        }
      }
      syncRoomMutePolicy();
      // 联系人表还没拉过：异步补一次（拿到后重建卡片）
      if (!avatarLoaded) {
        loadAvatarMap();
      }
      // 与 PC 会中轮询一致：成员接口成功也要核对会议记录状态。
      // 主持人在另一端结束后，成员快照可能仍可读，不能只靠 404 才退会。
      await checkRoomEnded();
    } catch (error) {
      console.error(`[MeetingUI] participants request failed: ${error}`);
      await checkRoomEnded();
    } finally {
      peopleLoading = false;
    }
  }

  function startPeoplePoll(): void {
    if (peopleTimer != -1) {
      return;
    }
    refreshRoomMetadata();
    loadParticipants();
    loadRecordingState();
    peopleTimer = setInterval(() => {
      refreshRoomMetadata();
      loadParticipants();
      loadRecordingState();
    }, 3000);
  }

  /**
   * 邀请名单刷新（面板里「邀请参会人」那一行的刷新图标）：
   * 重拉一次联系人 + 立刻重拉一次会中成员，重新判定谁还能勾。
   * ★为什么需要：有人在名单里但已经退出会议时，端上要等他下次「不在会里」才放开勾选；
   *   成员轮询虽然 3 秒一次，但刚退会那一下和服务器快照之间会有一段窗口，
   *   手动刷新把这一步做成立即生效（用户明确要求）。
   */
  async function refreshInviteList(): Promise<void> {
    if (inviteRefreshing.value || inviteSending.value) {
      return;
    }
    inviteRefreshing.value = true;
    try {
      // 强制重走一次联系人拉取（状态是 ready 时 loadInviteContacts 会直接 return）
      invitePoolState.value = "idle";
      loadParticipants();
      await loadInviteContacts();
      // 刷新后仍在会里的人，从已选里摘掉
      pruneInviteSelection();
    } finally {
      inviteRefreshing.value = false;
    }
  }

  /** 诊断轮询句柄（-1 = 没在打）。 */
  let diagTimer = -1;

  /**
   * 排查用：每 3 秒打一行 UTS + 原生诊断（见 meetingMediaDebugLine 的注释）。
   * ★与连接状态无关——未连上也要打，才能看出「卡在令牌 / 连接 / 设备」哪一步。
   * ★iOS 真机闪退没有堆栈时，控制台最后一行就是落点；问题关闭后连同
   *   meetingMedia/MeetingRoomBridge 里的 bridgeLog 一起删。
   */
  function startDiagPoll(): void {
    if (diagTimer != -1) {
      return;
    }
    diagTimer = setInterval(() => {
      meetingMediaReconcile();
      // #ifdef APP-HARMONY
      const deviceError = meetingMediaConsumeDeviceError();
      if (deviceError.length > 0) {
        // 主持人禁言不是设备故障：给「已禁言」（与参会人列表里的徽标同一句话，PC 也是这个口径），
        // 不要用泛化的「操作失败」——那种提示会让用户以为是自己设备/网络坏了。
        uni.showToast({
          title: deviceError == "mic_denied" ? t("Mobile.Meeting.speakDisabledBadge") : t("Mobile.Common.operationFailed"),
          icon: "none",
        });
      }
      // #endif
      console.error(`[MeetingUI] diag ${meetingMediaDebugLine()}`);
    }, 3000);
  }

  function stopDiagPoll(): void {
    if (diagTimer != -1) {
      clearInterval(diagTimer);
      diagTimer = -1;
    }
  }

  /**
   * 兜底补一次「我的资料」：缓存没水合时（比如直接进会议页），solo 卡片会一直显示首字。
   * 成功写回缓存后 bump tick，让 myName / myAvatar 重算，并重拉一次成员卡片。
   * ★必须写在 loadParticipants 之后：uvue 同级函数前向引用报 error18。
   */
  async function ensureMyInfo(): Promise<void> {
    const cached = getCachedMyInfo();
    // 头像和昵称都要有：只带头像时签令牌会落成「用户+id」，宫格里就出现那串数字。
    if (cached != null && cached.avatar.length > 0 && cached.displayName.length > 0) {
      // #ifdef APP-HARMONY
      resolveHarmonyMyAvatar();
      // #endif
      return;
    }
    try {
      const res = await apiImWhoami();
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const data = apiResData<any>(res);
      const obj = data != null ? (data as UTSJSONObject) : null;
      if (obj == null) {
        return;
      }
      const uid = readStr(obj, "userId");
      if (uid.length == 0) {
        return;
      }
      // displayName 缺失时依次回落昵称/账号：签令牌的名字不能再空着
      let displayName = readStr(obj, "displayName").trim();
      if (displayName.length == 0) {
        displayName = readStr(obj, "nickName").trim();
      }
      if (displayName.length == 0) {
        displayName = readStr(obj, "userName").trim();
      }
      setCachedMyInfo(uid, displayName, readStr(obj, "avatar"));
      myInfoTick.value = myInfoTick.value + 1;
      // #ifdef APP-HARMONY
      resolveHarmonyMyAvatar();
      // #endif
      loadParticipants();
    } catch (_error) {
    }
  }

  // ---------------------------------------------------------------- 成员管理（仅主持人）

  /** 换引用重建卡片（App-Android 行级原地写不重绘）。 */
  function refreshTiles(): void {
    const list = tiles.value;
    const next: StageTile[] = [];
    for (let i = 0; i < list.length; i++) {
      next.push(list[i]);
    }
    tiles.value = next;
  }

  /** 操作目标：优先 userId（服务端按 userId 覆盖该用户全部平台席位），游客用 identity。 */
  function tileTarget(tile: StageTile): string {
    return tile.userId.length > 0 ? tile.userId : tile.key;
  }

  /**
   * 静音 / 取消静音。
   * ★这是**轨道级**操作：只把对方当前音轨置 muted，对方仍可自己重新开麦；
   *   要"开不了麦"用「禁止发言」（撤 canPublish），两者不要混为一句文案。
   */
  async function handleMuteTile(tile: StageTile): Promise<void> {
    if (tile.busy || roomRaw.value.length == 0) {
      return;
    }
    const target = tileTarget(tile);
    if (target.length == 0) {
      return;
    }
    tile.busy = true;
    const muted = tile.micOn;
    try {
      const res = await apiImMeetingMuteParticipant(roomRaw.value, target, muted);
      if (apiResCode(res) != SUCCESS_CODE) {
        console.error(`[MeetingUI] mute member failed target=${target} code=${apiResCode(res)} message=${apiResMessage(res)}`);
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Meeting.failed"), icon: "none" });
      } else {
        // 成员接口按 3 秒轮询，成功后先乐观更新当前行，避免主持人感觉“点了没反应”。
        // 后续轮询仍会用服务端轨道状态校准。
        tile.micOn = !muted;
        refreshTiles();
        uni.showToast({
          title: muted ? t("Mobile.Meeting.muteMemberDone") : t("Mobile.Meeting.unmuteMemberDone"),
          icon: "none",
        });
      }
    } catch (error) {
      console.error(`[MeetingUI] mute member threw target=${target}: ${error}`);
      uni.showToast({ title: t("Mobile.Meeting.failed"), icon: "none" });
    }
    tile.busy = false;
    loadParticipants();
  }

  /** 禁止发言 / 允许发言（改 canPublish；服务端判权，非主持人会被拒）。 */
  async function handleToggleSpeak(tile: StageTile): Promise<void> {
    if (tile.busy || roomRaw.value.length == 0) {
      return;
    }
    const target = tileTarget(tile);
    if (target.length == 0) {
      return;
    }
    tile.busy = true;
    try {
      const body: UTSJSONObject = {};
      // 与 PC 相同：只改麦克风源，保留摄像头及当前共享权限。
      const sources: string[] = ["camera"];
      if (!tile.canPublish) sources.push("microphone");
      if (tile.keepsShare) {
        sources.push("screen_share");
        sources.push("screen_share_audio");
      }
      body["canPublish"] = true;
      body["canPublishSources"] = sources;
      const res = await apiImMeetingUpdatePermissions(roomRaw.value, target, body);
      if (apiResCode(res) != SUCCESS_CODE) {
        console.error(`[MeetingUI] update permissions failed target=${target} code=${apiResCode(res)} message=${apiResMessage(res)}`);
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Meeting.failed"), icon: "none" });
      } else if (!tile.canPublish) {
        // 已放行但音轨仍被主持人静音时，再取消一次轨道静音（PC 同口径）。
        try {
          const unmuteRes = await apiImMeetingMuteParticipant(roomRaw.value, target, false);
          if (apiResCode(unmuteRes) != SUCCESS_CODE) {
            console.error("[MeetingUI] unmute after permission failed target=" + target + " code=" + apiResCode(unmuteRes) + " message=" + apiResMessage(unmuteRes));
          }
        } catch (error) {
          console.error(`[MeetingUI] unmute after permission failed target=${target}: ${error}`);
        }
      }
    } catch (error) {
      console.error(`[MeetingUI] update permissions threw target=${target}: ${error}`);
      uni.showToast({ title: t("Mobile.Meeting.failed"), icon: "none" });
    }
    tile.busy = false;
    loadParticipants();
  }

  /** 确认后的移出动作（拆出来：showModal 回调里只做派发；★必须写在 handleKickTile 之前，error18）。 */
  async function kickTile(tile: StageTile, target: string): Promise<void> {
    tile.busy = true;
    try {
      const res = await apiImMeetingKick(roomRaw.value, target);
      if (apiResCode(res) != SUCCESS_CODE) {
        console.error(`[MeetingUI] kick member failed target=${target} code=${apiResCode(res)} message=${apiResMessage(res)}`);
        const message = apiResMessage(res);
        uni.showToast({ title: message.length > 0 ? message : t("Mobile.Meeting.failed"), icon: "none" });
      }
    } catch (error) {
      console.error(`[MeetingUI] kick member threw target=${target}: ${error}`);
      uni.showToast({ title: t("Mobile.Meeting.failed"), icon: "none" });
    }
    tile.busy = false;
    loadParticipants();
  }

  /** 移出会议：二次确认后调服务端（影响该用户所有平台席位）。 */
  function handleKickTile(tile: StageTile): void {
    if (tile.busy || roomRaw.value.length == 0) {
      return;
    }
    const target = tileTarget(tile);
    if (target.length == 0) {
      return;
    }
    const params = new Map<string, string | number>();
    params.set("name", tile.name);
    uni.showModal({
      title: tOf("Mobile.Meeting.kickConfirmTitle", params),
      content: t("Mobile.Meeting.kickConfirmBody"),
      confirmText: t("Mobile.Meeting.kickMember"),
      cancelText: t("Mobile.Common.cancel"),
      confirmColor: "#e5484d",
      success: (res) => {
        if (!res.confirm) {
          return;
        }
        kickTile(tile, target);
      },
    });
  }

  /** 上一次打日志的那行内容：状态没变就不刷屏（人数轮询每 3 秒都会回调一次）。 */
  let lastMediaLog = "";

  /** 把适配层快照同步到本页（页面只读这几个 ref 决定图标颜色）。 */
  function refreshMediaState(): void {
    const snap = meetingMediaState();
    mediaConnected.value = snap.connected;
    mediaConnecting.value = snap.connecting;
    mediaPeople.value = snap.peopleCount;
    plannedSec.value = snap.plannedDurationSec;
    meetingStartedAtMs.value = snap.meetingStartedAtMs;
    mediaError.value = snap.errorText;
    micOn.value = snap.micOn;
    cameraOn.value = snap.cameraOn;
    speakerOn.value = snap.speakerOn;
    // #ifdef APP-HARMONY
    harmonyMediaVisible.value = snap.visualMedia;
    screenShareAvailable.value = snap.connected && meetingMediaCanCaptureScreen();
    // #endif
    if (snap.connected) {
      everMediaConnected = true;
      mediaLostHandled = false;
      // 远端结束看门狗：与成员轮询解耦，被踢出/断线后仍能发现会议已结束
      startRemoteEndWatch();
    }
    if (snap.connected && groupCallMediaPending) {
      groupCallMediaPending = false;
      meetingMediaSetMic(true);
      if (groupCallVideoRequested) {
        meetingMediaSetCamera(true);
      }
    }
    // 在线成员列表和聊天跟着连接状态走：连上开始轮询，断开就全停
    if (snap.connected) {
      startPeoplePoll();
      startChatPolling();
    } else {
      stopPeoplePoll();
      stopChatPolling();
      tiles.value = [];
      pageIndex.value = 0;
      roomMuteAll.value = false;
      danmakuOn.value = true;
      resetMeetingDanmaku();
      handRaised.value = false;
      shareHolder.value = "";
      shareHolderName.value = "";
      shareSince.value = 0;
      localMicPublishAllowed.value = false;
      mutedByRoomPolicy.value = false;
      // 举手时序记录跟着这一场会话走：断开后重连按新的举手时间重新排
      handRaiseMarks = [];
      // 单格放大态跟着会话走：断开后回宫格（重连时不要停在一个空的放大格上）
      focusedTileKey.value = "";
      // 演讲者跟踪也要停：断开后没有成员可问
      speakerKey.value = "";
      stopSpeakerWatch();
      // ★入过会又断开（非主动离会/结束）：主持人结束会议走「删房」，本端会先被踢断，
      //   这一下立刻核对服务端记录——已结束就直接退出，别停在没有会议的页面上。
      if (everMediaConnected && !meetingClosing && !pageUnmounted && !mediaLostHandled) {
        mediaLostHandled = true;
        void handleMediaLost();
      }
    }
    const line = `connected=${snap.connected} connecting=${snap.connecting} err=${snap.errorText} people=${snap.peopleCount}`;
    if (line != lastMediaLog) {
      lastMediaLog = line;
      console.error(`[MeetingUI] media ${line}`);
    }
  }

  /** 返回页时保留会议（最小化）标记：★必须声明在首个使用者（handleConnectFailure）之前，
      同 uvue 同级函数前向引用限制，否则 Android 生成代码报 Unresolved reference。 */
  let preserveMeetingOnUnmount = false;

  /**
   * 入会失败按原因说人话（预检阶段返回的三种"进不去"分别是三句话）。
   * ★会议已结束/已取消时列表常还挂着旧状态（服务端要等房间回收才改记录），
   *   这里广播一次让会议 tab 重拉，别让用户对着一条"进行中"反复点入会。
   * ★必须写在 connectMedia 之前：uvue 同级函数前向引用报 error18。
   */
  function handleConnectFailure(code: string): void {
    if (meetingClosing || pageUnmounted) return;
    let title = t("Mobile.Meeting.mediaConnectFailed");
    if (code == "ended") {
      title = t("Mobile.Meeting.roomEnded");
    } else if (code == "cancelled") {
      title = t("Mobile.Meeting.roomCancelled");
    } else if (code == "notStarted") {
      title = t("Mobile.Meeting.roomNotStarted");
    } else if (code == "banned") {
      title = t("Mobile.Meeting.kickedOut");
    } else if (code == "passcode") {
      title = t("Mobile.Meeting.passcodeInvalid");
    } else if (code == "full") {
      title = t("Mobile.Meeting.roomFull");
    }
    console.error(`[MeetingUI] join failed: ${code}`);
    uni.showToast({ title: title, icon: "none", duration: 2600 });
    if (code == "ended" || code == "cancelled" || code == "banned") {
      eventBus.emit(IM_MEETING_CHANGED_EVENT, {});
    }
    // 被移出/密码错/房间不存在：停在会议页没有意义，退回上一页
    if (code == "ended" || code == "banned" || code == "cancelled" || code == "passcode") {
      meetingClosing = true;
      preserveMeetingOnUnmount = false;
      void meetingMediaDisconnect();
      setTimeout(() => {
        returnFromClosedMeeting();
      }, 1200);
    }
  }

  /**
   * 签入会令牌只能传账号真实昵称。UI 可以在资料未水合时临时显示“我”，
   * 但绝不能把这个本地占位文案写进 LiveKit participant name，否则所有端都会看到“我”。
   * 空串交给后端回退成“用户{id}”，也比把本地关系词当昵称可靠。
   */
  function tokenDisplayName(): string {
    const info = getCachedMyInfo();
    if (info == null) {
      return "";
    }
    return info.displayName.trim();
  }

  /**
   * 入会（媒体）：能力未就绪直接跳过，**不发令牌请求**。
   * SDK 随自定义基座打进后（插件 `isSupported()` 返回 true）这里就会真的连 LiveKit。
   */
  async function connectMedia(): Promise<void> {
    if (!mediaSupported.value || roomRaw.value.length == 0) {
      console.error(`[MeetingUI] connectMedia skipped sup=${mediaSupported.value} room=${roomRaw.value}`);
      return;
    }
    const options = new MeetingMediaOptions();
    options.room = roomRaw.value;
    options.displayName = tokenDisplayName();
    // 设了密码的会议：令牌接口会校验，不带上会 401（从「加入会议」页进来时才有值）
    options.passcode = joinPasscode.value;
    try {
      console.error(`[MeetingUI] connectMedia start room=${roomRaw.value} name=${options.displayName}`);
      const joined = await meetingMediaConnect(options);
      console.error(`[MeetingUI] connectMedia ret=${joined} ${meetingMediaDebugLine()}`);
      refreshMediaState();
      if (!joined && mediaError.value.length > 0) {
        handleConnectFailure(mediaError.value);
      }
    } catch (error) {
      // 适配层理论上不抛，这里兜底：任何异常都不能把页面打断（否则整页按钮都没反应）
      console.error(`[MeetingUI] connectMedia throw: ${error}`);
      refreshMediaState();
    }
  }

  /** 先完成我的资料水合，再签令牌入会，避免把“我”写成跨端可见昵称。 */
  async function prepareIdentityAndConnect(): Promise<void> {
    await ensureMyInfo();
    if (pageUnmounted) return;
    connectMedia();
  }

  /** 麦克风：未接入/未连上只提示；连上后切本地采集并同步图标态。 */
  function handleMicTap(): void {
    if (!mediaSupported.value || !mediaConnected.value) {
      mediaUnavailableToast("mic");
      return;
    }
    const next = !micOn.value;
    const allowed = isHost.value || !roomMuteAll.value || localMicPublishAllowed.value;
    if (next && !allowed) {
      uni.showToast({ title: t("Mobile.Meeting.fullMuteEnabled"), icon: "none" });
      return;
    }
    // 主持人单独禁言（撤了麦克风发布权限）：就地给「已禁言」，别把请求交给原生再弹
    // 泛化的「操作失败」（Android/iOS 原生侧对这种请求是静默失败的，鸿蒙也不该报设备故障）。
    // ★成员列表还没看见自己（selfSeenInList=false）时权限值不可信，放给原生兜底。
    if (next && !isHost.value && selfSeenInList && !localMicPublishAllowed.value) {
      uni.showToast({ title: t("Mobile.Meeting.speakDisabledBadge"), icon: "none" });
      return;
    }
    if (!next) {
      // 用户主动静音：后续解除全员禁言时不得自动替用户打开。
      mutedByRoomPolicy.value = false;
    }
    console.error(`[MeetingUI] tap mic next=${next} ${meetingMediaDebugLine()}`);
    meetingMediaSetMic(next);
    refreshMediaState();
    console.error(`[MeetingUI] tap mic done ${meetingMediaDebugLine()}`);
  }

  /** 我方头像加载失败：退回首字（只置标记，不改行）。 */
  function handleMyAvatarError(): void {
    setTimeout(() => {
      myAvatarFailed.value = true;
    }, 0);
  }

  // ---------------------------------------------------------------- 退出 / 结束会议

  /**
   * 非主持人最后一人退会：先断自己的席位再删房 —— 服务端只允许非主持人删
   * 「确认空房」的会议，人还挂在房间里时这次删房会被直接拒掉。
   */
  async function deleteRoomAfterLeaving(room: string): Promise<void> {
    try {
      // #ifdef APP-HARMONY
      const left = await meetingMediaDisconnect();
      if (!left || meetingMediaActiveRoom() == room) return;
      // #endif
      // #ifndef APP-HARMONY
      await meetingMediaDisconnect();
      // #endif
      await apiImMeetingDeleteRoom(room);
    } catch (_error) {
      // 删房失败不影响本端退出：空房超时后服务端也会收尾。
    }
  }

  /** 成员退出：只断自己，会议继续（返回上一页会触发 onUnmounted 断连）。 */
  function leaveMeeting(): void {
    meetingClosing = true;
    // 与 PC 一致：主持人仅退出也会停掉云端录制，不能让它继续录空房间。
    if (isHost.value && recordingOn.value && recordingEgressId.value.length > 0) {
      apiImMeetingStopRecording(roomRaw.value, recordingEgressId.value).catch((_e: any | null): void => {});
    }
    // PC shouldAutoEndRoom 同口径：非主持人若是最后一人，立即删房，不等空房超时。
    // ★必须先断开自己的席位：服务端只允许非主持人删「确认空房」的会议，人还在房里会被拒。
    const lastParticipant = !isHost.value && badgeCount.value <= 1 && roomRaw.value.length > 0;
    if (lastParticipant) {
      void deleteRoomAfterLeaving(roomRaw.value);
    }
    // #ifdef APP-HARMONY
    if (!lastParticipant) void meetingMediaDisconnect();
    // #endif
    eventBus.emit(IM_MEETING_CHANGED_EVENT, {});
    uni.navigateBack({ delta: 1 });
  }

  /**
   * 主持人结束会议：服务端删房 → 房内所有人被踢出，录制也停。
   * ★接口注释明确：房间已不存在返回 404，按「会议已结束」处理，不弹错误。
   */
  async function endMeeting(): Promise<void> {
    if (roomRaw.value.length == 0 || meetingClosing) {
      return;
    }
    meetingClosing = true;
    // PC 口径：先停录制再删房，避免 egress 在删房时丢掉文件尾部。
    if (recordingOn.value && recordingEgressId.value.length > 0) {
      try {
        await apiImMeetingStopRecording(roomRaw.value, recordingEgressId.value);
        recordingOn.value = false;
        recordingEgressId.value = "";
      } catch (_error) {
        // 停录制失败不阻断结束会议；服务端删房也会收尾 egress。
      }
    }
    try {
      const res = await apiImMeetingDeleteRoom(roomRaw.value);
      const code = apiResCode(res);
      if (code != SUCCESS_CODE && code != "IM_50001" && code != "404") {
        console.error(`[MeetingUI] deleteRoom failed code=${code}`);
        meetingClosing = false;
        uni.showToast({ title: t("Mobile.Meeting.failed"), icon: "none" });
        return;
      }
    } catch (error) {
      console.error(`[MeetingUI] deleteRoom throw: ${error}`);
      meetingClosing = false;
      uni.showToast({ title: t("Mobile.Meeting.failed"), icon: "none" });
      return;
    }
    eventBus.emit(IM_MEETING_CHANGED_EVENT, {});
    uni.showToast({ title: t("Mobile.Meeting.endDone"), icon: "none" });
    await meetingMediaDisconnect();
    setTimeout(() => {
      uni.navigateBack({ delta: 1 });
    }, 400);
  }

  /** 普通参会人退出进行中的会议前先确认；未连接/已结束直接返回。 */
  function confirmLeaveMeeting(): void {
    if (status.value != 1 || !mediaConnected.value) {
      leaveMeeting();
      return;
    }
    uni.showModal({
      title: t("Mobile.Meeting.leaveTitle"),
      content: t("Mobile.Meeting.leaveBody"),
      confirmText: t("Mobile.Meeting.leaveMeeting"),
      cancelText: t("Mobile.Common.cancel"),
      confirmColor: "#e5484d",
      success: (res) => {
        if (res.confirm) {
          leaveMeeting();
        }
      },
    });
  }

  /**
   * 右上角按钮：普通参会人确认后退出；主持人按 PC 口径选择：
   * 有其他人在会时可选仅退出或结束会议；独自在会时只确认结束会议。
   */
  function handleLeaveOrEnd(): void {
    if (meetingClosing) {
      return;
    }
    if (!isHost.value) {
      confirmLeaveMeeting();
      return;
    }
    if (badgeCount.value <= 1) {
      uni.showModal({
        title: t("Mobile.Meeting.endTitle"),
        content: t("Mobile.Meeting.endBody"),
        confirmText: t("Mobile.Meeting.endMeeting"),
        cancelText: t("Mobile.Common.cancel"),
        confirmColor: "#e5484d",
        success: (res) => {
          if (res.confirm) {
            endMeeting();
          }
        },
      });
      return;
    }
    uni.showActionSheet({
      itemList: [
        t("Mobile.Meeting.hostLeaveOnly"),
        t("Mobile.Meeting.hostEndForAll"),
      ],
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.tapIndex == 0) {
          leaveMeeting();
        } else if (res.tapIndex == 1) {
          endMeeting();
        }
      },
    });
  }

  function minimizeMeetingPage(): void {
    preserveMeetingOnUnmount = true;
    meetingMediaSetMinimized(true);
    uni.navigateBack({
      delta: 1,
      fail: (_error) => {
        preserveMeetingOnUnmount = false;
        meetingMediaSetMinimized(false);
      },
    });
  }

  /** 返回可保留会议，右上角退出仍沿用原来的离会/结束确认。 */
  function handleBack(): void {
    if (sheet.value.length > 0) {
      closeSheet();
      return;
    }
    syncConnectionBeforeAction();
    let inMeeting = status.value == 1;
    // #ifdef APP-HARMONY
    inMeeting = status.value == 0 || status.value == 1;
    // #endif
    if (meetingClosing || !inMeeting || (!mediaConnected.value && !mediaConnecting.value)) {
      uni.navigateBack({ delta: 1 });
      return;
    }
    // #ifdef APP-HARMONY
    // 保留已接通的房间。首次签票期间退回上一页时取消入会，避免后台留下未接通的会场。
    if (!mediaConnected.value) {
      meetingClosing = true;
      uni.navigateBack({ delta: 1, fail: (_error) => { meetingClosing = false; } });
      return;
    }
    // #endif
    minimizeMeetingPage();
  }

  // #ifdef APP-HARMONY
  function handleHarmonyStageInit(event: any): void {
    const e = event as UniNativeViewInitEvent;
    harmonyStageId = bindMeetingStage(e.detail.element);
    if (harmonyStageId > 0) setMeetingStageLayout(harmonyStageId, harmonyStagePresentation.value);
  }
  // #endif

  /** 切换摄像头节流时间戳：SDK 切摄像头本身要重启采集，连点会明显卡顿。 */
  let switchLockUntil = 0;

  /** 切换前后摄像头（默认前置）。900ms 内重复点击直接忽略，避免连点把画面切卡。 */
  function handleSwitchCamera(): void {
    const now = Date.now();
    if (now < switchLockUntil) {
      return;
    }
    switchLockUntil = now + 900;
    console.error(`[MeetingUI] switchCamera ${meetingMediaDebugLine()}`);
    meetingMediaSwitchCamera();
  }

  /** 宫格翻页（夹紧到合法范围；页数变化时也不会越界）。 */
  function prevPage(): void {
    const i = pageIndex.value - 1;
    pageIndex.value = i < 0 ? 0 : i;
  }

  function nextPage(): void {
    const n = pageCount.value;
    const i = pageIndex.value + 1;
    pageIndex.value = i >= n ? (n > 0 ? n - 1 : 0) : i;
  }

  function handleCameraTap(): void {
    if (!mediaSupported.value || !mediaConnected.value) {
      mediaUnavailableToast("cam");
      return;
    }
    if (!videoBridgeReady.value) {
      console.error("[MeetingUI] camera blocked: old iOS base lacks native-view bridge");
      uni.showToast({ title: t("Mobile.Meeting.updateIosApp"), icon: "none" });
      return;
    }
    const next = !cameraOn.value;
    console.error(`[MeetingUI] tap cam next=${next} ${meetingMediaDebugLine()}`);
    meetingMediaSetCamera(next);
    // #ifdef APP-ANDROID || APP-IOS
    if (!next) {
      // 关摄像头：立刻释放渲染器，别留着最后一帧（PC 同口径）
      console.error("[MeetingUI] tap cam -> releaseVideoView");
      releaseVideoView();
    }
    // #endif
    refreshMediaState();
    // 宫格里"我这一格"是否显示视频跟着摄像头状态走，立刻重拉一次成员卡片
    if (mediaConnected.value) {
      loadParticipants();
    }
    console.error(`[MeetingUI] tap cam done ${meetingMediaDebugLine()}`);
  }

  // #ifdef APP-ANDROID || APP-IOS
  /**
   * native-view 初始化：Android 在页面绑定；iOS 在 UTS 插件内绑定，
   * 避免 UIView 作为插件返回值跨到页面。相机轨道发布稍晚于视图创建，
   *   所以插件在 `setCameraEnabled` 成功后会再 attach 一次。
   * ★整段（含函数签名里的 UniNativeViewInitEvent 类型）都包在条件编译里：
   *   H5/鸿蒙没有这个全局类型，露在外面会编不过。
   */
  function handleVideoInit(event: any): void {
    if (!videoBridgeReady.value) {
      console.error("[MeetingUI] video init blocked: iOS base has old view bridge");
      return;
    }
    // 同 handleTileVideoInit：$event 是 Any，这里显式断言（直接绑定也给 any 更稳）
    const e = event as UniNativeViewInitEvent;
    // #ifdef APP-ANDROID
    console.error("[MeetingUI] stage video init -> createVideoView");
    const view = createVideoView();
    if (view == null) {
      console.error("[MeetingUI] createVideoView returned null");
      return;
    }
    e.detail.element.bindAndroidView(view!!);
    // #endif
    // #ifdef APP-IOS
    console.error("[MeetingUI] stage video init -> plugin bindIOSView");
    if (!createVideoView(e.detail.element)) {
      console.error("[MeetingUI] createVideoView failed");
      return;
    }
    // #endif
    console.error("[MeetingUI] stage video init -> attachLocalVideo");
    attachLocalVideo();
    console.error("[MeetingUI] stage video init done");
  }
  // #endif

  // #ifdef APP-ANDROID || APP-IOS
  /**
   * 宫格格子的视频：自己取本机渲染器、别人按 identity 取远端渲染器。
   * ★native-view 每次挂载都重新绑定；iOS 插件每次新建 UIView，避免重复绑定旧视图。
   */
  function handleTileVideoInit(event: any, tile: StageTile): void {
    if (!videoBridgeReady.value) {
      console.error("[MeetingUI] tile video init blocked: iOS base has old view bridge");
      return;
    }
    // ★形参必须是 any：模板里 `@init="fn($event, tile)"` 的 $event 推断为 Any，
    //   直接写 UniNativeViewInitEvent 会报 error17（参数类型不匹配）
    const e = event as UniNativeViewInitEvent;
    console.error(`[MeetingUI] tile video init key=${tile.key} isMe=${tile.isMe}`);
    // #ifdef APP-ANDROID
    const view = tile.isMe ? createVideoView() : createRemoteVideoView(tile.key);
    if (view == null) {
      console.error(`[MeetingUI] tile video view null for ${tile.key}`);
      return;
    }
    e.detail.element.bindAndroidView(view!!);
    // #endif
    // #ifdef APP-IOS
    const bound = tile.isMe
      ? createVideoView(e.detail.element)
      : createRemoteVideoView(tile.key, e.detail.element);
    if (!bound) {
      console.error(`[MeetingUI] tile video view unavailable for ${tile.key}`);
      return;
    }
    // #endif
    if (tile.isMe) {
      attachLocalVideo();
    }
  }
  // #endif

  // #ifdef APP-ANDROID || APP-IOS
  /** 共享全屏：把共享者的远端画面绑到全屏 native-view 上（宫格此时已卸载）。 */
  function handleFullscreenVideoInit(event: any): void {
    if (!videoBridgeReady.value || shareFullKey.value.length == 0) {
      return;
    }
    const e = event as UniNativeViewInitEvent;
    // #ifdef APP-ANDROID
    const view = createRemoteVideoView(shareFullKey.value);
    if (view == null) {
      return;
    }
    e.detail.element.bindAndroidView(view!!);
    // #endif
    // #ifdef APP-IOS
    if (!createRemoteVideoView(shareFullKey.value, e.detail.element)) {
      console.error(`[MeetingUI] fullscreen video bind failed key=${shareFullKey.value}`);
      return;
    }
    // #endif
  }
  // #endif

  /** 宫格里点共享者的全屏按钮。 */
  function openShareFullscreen(tile: StageTile): void {
    // ★只有画面真的到了才允许全屏：拿共享权/系统授权弹窗阶段 keepsShare 已经是 true，
    //   但此时没有画面，全屏进去只会是黑屏。
    if (!mediaConnected.value || tile.key.length == 0 || !tile.hasVideo) {
      return;
    }
    shareFullKey.value = tile.key;
  }

  /** 点全屏区域/关闭按钮退出。 */
  function closeShareFullscreen(): void {
    shareFullKey.value = "";
  }

  function handleSpeakerTap(): void {
    if (!mediaSupported.value || !mediaConnected.value) {
      mediaUnavailableToast("spk");
      return;
    }
    meetingMediaSetSpeaker(!speakerOn.value);
    refreshMediaState();
  }

  /** 底部操作格里一格的分发（键值见 actionRows）。 */
  function handleAction(key: string): void {
    if (key == "invite") {
      openInvitePanel();
      return;
    }
    if (key == "share") {
      handleShareTap();
      return;
    }
    if (key == "hand") {
      handleRaiseHandTap();
      return;
    }
    if (key == "chat") {
      handleMeetingChatTap();
      return;
    }
    if (key == "danmaku") {
      handleDanmakuTap();
      return;
    }
    if (key == "mic") {
      handleMicTap();
      return;
    }
    if (key == "camera") {
      handleCameraTap();
      return;
    }
    if (key == "speaker") {
      handleSpeakerTap();
      return;
    }
    if (key == "muteAll") {
      handleToggleRoomMuteAll();
      return;
    }
    if (key == "muteEveryone") {
      handleMuteEveryone();
      return;
    }
    if (key == "members") {
      openSheet("members");
      return;
    }
    if (key == "recording") {
      handleToggleRecording();
      return;
    }
  }

  /** 点格子：动作 → 分发；箭头 → 收起/展开；空格 → 什么都不做。 */
  function handleCellTap(cell: StageAction): void {
    if (cell.kind == "arrow") {
      actionsVisible.value = !actionsVisible.value;
      return;
    }
    if (cell.kind != "action") {
      return;
    }
    handleAction(cell.key);
  }

  function copyText(data: string, toastKey: string): void {
    if (data.length == 0) {
      return;
    }
    uni.setClipboardData({
      data,
      success: (_res) => {
        uni.showToast({ title: t(toastKey), icon: "none" });
      },
    });
  }

  function handleCopyNo(): void {
    copyText(roomRaw.value, "Mobile.Meeting.noCopied");
  }

  function handleCopyPasscode(): void {
    copyText(passcodeValue.value, "Mobile.Meeting.passcodeCopied");
  }

  /**
   * 复制邀请信息：文案 = 邀请人 + 主题 + 会议号 + 会议密码（有才展示）+ 会议链接。
   * ★链接用 slug（老记录回退会议号），指向部署站点；App 内点这条链接会直接进会，
   *   所以这里必须带上，否则对方只能手抄会议号。
   */
  function handleCopyInvite(): void {
    if (roomRaw.value.length == 0) {
      return;
    }
    const passcode = passcodeState.value == "value" ? passcodeValue.value : "";
    const url = buildMeetingInviteUrl(getApiBaseUrl(), shareKeyOf(shareSlugRaw.value, roomRaw.value));
    const text = buildMeetingInviteText(myName.value, titleRaw.value, roomRaw.value, url, passcode);
    copyText(text, "Mobile.Meeting.copied");
  }

  function handleRetry(): void {
    failed.value = false;
    membersState.value = "loading";
    loadDetail();
    loadRecordingState();
  }

  // ---------------------------------------------------------------- 生命周期

  /**
   * 媒体状态变化 → 刷新本页图标态。
   * ★必须用**具名箭头函数**注册：App-Android(UTS→Kotlin) 上裸函数引用传给 eventBus.on
   *   绑不上回调（message-content 4220 行的真机结论）；on/off 必须是同一个引用。
   * ★连房是异步回调回来的，页面不订阅就永远停在「未连接」，按钮点了也只会提示未连接。
   */
  const onMediaChanged = (_payload: any): void => {
    if (meetingMediaActiveRoom().length > 0 && meetingMediaActiveRoom() != roomRaw.value) return;
    refreshMediaState();
  };

  onBackPress((options: OnBackPressOptions): boolean => {
    // 确认离会后的程序化返回必须放行，否则会再次进入离会确认。
    if (options.from == "navigateBack") {
      return false;
    }
    // 单格放大态：系统返回先退回宫格，再来一次才走离会确认
    if (focusedTile != null) {
      exitTileFocus();
      return true;
    }
    handleBack();
    return true;
  });

  /** ★onLoad 放在所有被调函数之后：uvue 同级函数前向引用报 error18。 */
  onLoad((options: any) => {
    if (options == null) {
      return;
    }
    const obj = options as UTSJSONObject;
    meetingId.value = readStr(obj, "id");
    roomRaw.value = readStr(obj, "room");
    titleRaw.value = readStr(obj, "title");
    // 会议列表入口会带 slug（复制邀请的链接 key）；其它入口后面从 metadata/详情补
    shareSlugRaw.value = readStr(obj, "slug");
    status.value = readNum(obj, "status", 1);
    startRaw.value = readStr(obj, "start");
    memberCount.value = readNum(obj, "members", 0);
    requiresPasscode.value = readStr(obj, "passcode") == "1";
    isHost.value = readStr(obj, "host") == "1";
    groupCallMediaPending = readStr(obj, "call") == "1";
    groupCallVideoRequested = readStr(obj, "video") == "1";
    // 「加入会议」页带过来的入会密码（其余入口没有这个参数）
    joinPasscode.value = readStr(obj, "pc");
    if (meetingMediaActiveRoom().length > 0 && meetingMediaActiveRoom() != roomRaw.value) {
      preserveMeetingOnUnmount = true;
      uni.showModal({
        title: "已有进行中的会议",
        content: "请先返回并退出当前会议，再加入另一场会议。",
        showCancel: false,
        success: (_res) => { uni.navigateBack({ delta: 1 }); },
      });
      return;
    }
    meetingMediaSetResumeURL(
      `/subpackages/pages/im-meeting/im-meeting-room?room=${encodeURIComponent(roomRaw.value)}` +
      `&id=${encodeURIComponent(meetingId.value)}&title=${encodeURIComponent(titleRaw.value)}` +
      `&status=1&host=${isHost.value ? "1" : "0"}&pc=${encodeURIComponent(joinPasscode.value)}`
    );
    meetingMediaSetMinimized(false);
    meetingMediaSetPageVisible(true);
    nowMs.value = Date.now();
    syncClock();
    // 插件和环境都就绪后才申请媒体令牌
    mediaSupported.value = meetingMediaSupported();
    // #ifdef APP-HARMONY
    screenShareAvailable.value = false;
    // #endif
    // #ifdef APP-IOS
    videoBridgeReady.value = meetingMediaDebugLine().indexOf("bridge=ios-native-view-v2") >= 0;
    if (!videoBridgeReady.value) {
      console.error("[MeetingUI] old iOS base: native video preview disabled; rebuild custom base");
    }
    // #endif
    console.error(`[MeetingUI] onLoad room=${roomRaw.value} supported=${mediaSupported.value}`);
    eventBus.on(MEETING_MEDIA_CHANGED_EVENT, onMediaChanged);
    // 先按入口传参决定要不要拉密码（详情回来后会按服务端口径再校一次）
    loadPasscodeIfNeeded();
    loadDetail();
    // 能力就绪才连房（未就绪什么都不发，页面照样能看会议信息）
    startDiagPoll();
    prepareIdentityAndConnect();
  });

  onShow(() => {
    if (roomRaw.value.length == 0) return;
    if (meetingMediaActiveRoom() != roomRaw.value) {
      // 媒体会话已经不在了（被主持人结束 / 被踢 / 断线后回前台）：不能再像旧实现那样直接
      // return —— 那会把「回到前台才发现会已经散了」永久停在这一页，改成仍核对一次服务端状态。
      if (everMediaConnected && !meetingClosing) {
        roomEndCheckedAt = 0;
        void checkRoomEnded();
      }
      return;
    }
    meetingMediaReconcile();
    meetingMediaSetPageVisible(true);
    meetingMediaConfirmPageVisible(roomRaw.value);
    refreshMediaState();
    refreshRoomMetadata();
  });

  onHide(() => {
    if (!meetingClosing && meetingMediaActiveRoom() == roomRaw.value) {
      meetingMediaSetPageVisible(false);
    }
  });

  onUnmounted(() => {
    pageUnmounted = true;
    stopClock();
    stopPeoplePoll();
    stopDiagPoll();
    stopRemoteEndWatch();
    stopSpeakerWatch();
    stopChatPolling();
    eventBus.off(MEETING_MEDIA_CHANGED_EVENT, onMediaChanged);
    if (meetingMediaActiveRoom().length > 0 && meetingMediaActiveRoom() != roomRaw.value) return;
    // #ifdef APP-HARMONY
    if (!releaseMeetingStage(harmonyStageId)) return;
    const keepMeeting = !meetingClosing && meetingMediaState().connected;
    if (keepMeeting && localSharePending.value && !meetingMediaScreenShareOn()) {
      void meetingMediaStopScreenShare(roomRaw.value);
    }
    // #endif
    // #ifndef APP-HARMONY
    meetingMediaReleasePageViews();
    const keepMeeting = preserveMeetingOnUnmount || (!meetingClosing && (mediaConnected.value || mediaConnecting.value));
    // #endif
    if (keepMeeting) {
      meetingMediaSetPageVisible(false);
      meetingMediaSetMinimized(true);
      eventBus.emit(IM_MEETING_CHANGED_EVENT, {});
      return;
    }
    // 只断自己，不删房（结束会议是主持人动作）
    console.error(`[MeetingUI] onUnmounted disconnect ${meetingMediaDebugLine()}`);
    if ((localShareWasOn.value || localSharePending.value) && roomRaw.value.length > 0) {
      void meetingMediaStopScreenShare(roomRaw.value);
    }
    meetingMediaDisconnect();
    // 退出房间后列表里的状态可能已经变了（最后一人离开 ⇒ 服务端收尾），让会议 tab 重拉
    eventBus.emit(IM_MEETING_CHANGED_EVENT, {});
  });
</script>

<style lang="scss" scoped>
  .mr-page {
