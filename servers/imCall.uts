/** IM 语音/视频通话请求层；协议与 PC callApi 对齐。 */
import request from "./useRequest";
import { getImDeviceId } from "./im";
import type { RequestResponse } from "@/types/interfaces/request";

export async function apiImSendVoipInvite(convId: string, callId: string, mediaType: string, roomName: string, clientMsgId: string): Promise<RequestResponse<any>> {
  const body = '{"callId":' + JSON.stringify(callId) + ',"mediaType":' + JSON.stringify(mediaType) + ',"roomName":' + JSON.stringify(roomName) + '}';
  return await request({
    url: "/api/instant-message/messages",
    method: "POST",
    data: '{"convId":' + convId + ',"msgType":"voip","clientMsgId":' + JSON.stringify(clientMsgId) + ',"deviceId":' + JSON.stringify(getImDeviceId()) + ',"body":' + body + '}',
  });
}

/**
 * ★★叫人开会（2026-11-28 对齐 PC）：一次 POST ⇒ 一帧 3007 `meeting:invite`。
 *
 * - <b>不建会话、不落消息</b>：被邀请人不会凭空多出一段私聊（含非好友/同群成员）；
 * - 服务端逐人过发送闸门（联系人 / 同群 / 智能体），过不了的进 `rejectedUserIds`，不报错；
 * - ★3007 不落库、无离线推送 ⇒ 只有当时在线的端会响铃；`targetDevices=0` 要如实提示。
 *
 * ★`userIds` 是 int64 雪花号：必须拼成<b>原始数字字面量</b>（同 apiImSendVoipInvite 的
 *   convId），走 JS number 会丢精度、邀请会发给另一个人。
 */
export async function apiImSendMeetingInviteSignal(
  userIds: string[],
  roomName: string,
  title: string,
  mediaType: string,
  groupCall: boolean,
  inviteId: string,
  passcode: string = "",
): Promise<RequestResponse<any>> {
  const ids: string[] = [];
  for (let i = 0; i < userIds.length; i++) {
    const id = `${userIds[i]}`.trim();
    // 只收纯数字：脏 id 拼进 JSON 会让整个请求体非法（后端也会剔，但请求先坏了）。
    if (/^[0-9]+$/.test(id) && ids.indexOf(id) < 0) {
      ids.push(id);
    }
  }
  let body = '{"userIds":[' + ids.join(",") + ']';
  body += ',"roomName":' + JSON.stringify(roomName);
  body += ',"title":' + JSON.stringify(title);
  body += ',"mediaType":' + JSON.stringify(mediaType == "video" ? "video" : "audio");
  body += ',"groupCall":' + (groupCall ? "true" : "false");
  // 只转发会议密码的合法形态；无密码时不发字段（服务端形状不合格会直接丢弃）。
  if (/^[0-9]{4,6}$/.test(passcode)) {
    body += ',"passcode":' + JSON.stringify(passcode);
  }
  body += ',"inviteId":' + JSON.stringify(inviteId) + '}';
  console.log(`[MeetingInvite] signal request POST /api/instant-message/calls/meeting-invite count=${ids.length} roomName=${roomName} inviteId=${inviteId} mediaType=${mediaType} groupCall=${groupCall} passcode=${passcode.length > 0 ? "set" : "none"}`);
  const res = await request({
    url: "/api/instant-message/calls/meeting-invite",
    method: "POST",
    data: body,
  });
  console.log(`[MeetingInvite] signal response ${JSON.stringify(res)}`);
  return res;
}

/**
 * 会议邀请消息版（`msgType=meeting_invite`）—— 2026-11-28 起不再是 App 的主路径。
 *
 * ★仍保留：群通话的「群卡片」（silent=true 发到群会话）与存量客户端/存量消息走它。
 * 单聊邀请请用 {@link apiImSendMeetingInviteSignal}，否则会凭空建出一段私聊。
 */
export async function apiImSendMeetingInvite(convId: string, inviteId: string, roomName: string, title: string, mediaType: string, groupCall: boolean, silent: boolean, clientMsgId: string, passcode: string = ""): Promise<RequestResponse<any>> {
  let body = '{"inviteId":' + JSON.stringify(inviteId) + ',"roomName":' + JSON.stringify(roomName) + ',"title":' + JSON.stringify(title) + ',"mediaType":' + JSON.stringify(mediaType) + ',"groupCall":' + groupCall + ',"silent":' + silent;
  // 只转发会议密码的合法形态；无密码时不发字段，兼容旧客户端。
  if (/^[0-9]{4,6}$/.test(passcode)) {
    body += ',"passcode":' + JSON.stringify(passcode);
  }
  body += '}';
  // 排查会议响铃：记录实际调用的接口与关键参数（密码只记是否设置，不落明文）。
  console.log(`[MeetingInvite] request POST /api/instant-message/messages convId=${convId} inviteId=${inviteId} roomName=${roomName} title=${title} mediaType=${mediaType} groupCall=${groupCall} silent=${silent} passcode=${passcode.length > 0 ? "set" : "none"}`);
  const res = await request({
    url: "/api/instant-message/messages",
    method: "POST",
    data: '{"convId":' + convId + ',"msgType":"meeting_invite","clientMsgId":' + JSON.stringify(clientMsgId) + ',"deviceId":' + JSON.stringify(getImDeviceId()) + ',"body":' + body + '}',
  });
  console.log(`[MeetingInvite] response ${JSON.stringify(res)}`);
  return res;
}

export async function apiImCallAnswered(convId: string, msgId: string, callId: string, roomName: string): Promise<RequestResponse<any>> {
  return await request({ url: "/api/instant-message/calls/answered", method: "POST", data: { convId, msgId, callId, roomName }, suppressErrorToast: true });
}

export async function apiImCallEnded(convId: string, msgId: string, reason: string): Promise<RequestResponse<any>> {
  return await request({ url: "/api/instant-message/calls/ended", method: "POST", data: { convId, msgId, reason }, suppressErrorToast: true });
}

export async function apiImCallDeclined(convId: string, msgId: string, callId: string, roomName: string): Promise<RequestResponse<any>> {
  return await request({ url: "/api/instant-message/calls/declined", method: "POST", data: { convId, msgId, callId, roomName }, suppressErrorToast: true });
}
