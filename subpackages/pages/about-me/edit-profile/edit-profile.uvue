<template>
  <view class="edit-profile-container relative flex flex-col">
    <custom-nav-bar :title="t('Mobile.Profile.editProfile')" className="border-b" hasSafetyZone showBack />

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <view class="form-card">
        <view class="form-section">
          <text class="field-label">{{ t("Mobile.Profile.userName") }}</text>
          <view class="input-box">
            <input
              v-model="userName"
              class="field-input"
              maxlength="50"
              :placeholder="t('Mobile.Profile.inputUserName')"
              placeholder-class="field-placeholder"
            />
            <text class="count-text">{{ userName.length }} / 50</text>
          </view>
        </view>

        <view class="form-section form-section-last">
          <text class="field-label">{{ t("Mobile.Profile.nickName") }}</text>
          <view class="input-box">
            <input
              v-model="nickName"
              class="field-input"
              maxlength="50"
              :placeholder="t('Mobile.Profile.inputNickName')"
              placeholder-class="field-placeholder"
            />
            <text class="count-text">{{ nickName.length }} / 50</text>
          </view>
        </view>

        <view class="save-button" :class="{ 'save-button-disabled': saving }" @tap="handleSave">
          <text class="save-button-text">{{ t("Mobile.Profile.save") }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiUserInfo, apiUserUpdate } from "@/servers/account";
  import { UserInfo } from "@/types/interfaces/login";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const userName = ref<string>("");
  const nickName = ref<string>("");
  const saving = ref<boolean>(false);

  const loadUserInfo = async () => {
    try {
      const res = await apiUserInfo();
      if (apiResCode(res) != SUCCESS_CODE) return;
      const rawData = apiResData<any>(res);
      if (rawData == null) return;
      const info = new UserInfo(rawData as UTSJSONObject);
      userName.value = info.userName;
      nickName.value = info.nickName;
    } catch (error) {
      console.error("获取用户资料失败", error);
    }
  };

  const handleSave = async () => {
    const nextUserName = userName.value.trim();
    if (nextUserName.length == 0) {
      uni.showToast({ title: t("Mobile.Profile.userNameRequired"), icon: "none" });
      return;
    }
    if (saving.value) return;

    saving.value = true;
    try {
      const body = new UTSJSONObject();
      body["userName"] = nextUserName;
      body["nickName"] = nickName.value.trim();
      const res = await apiUserUpdate(body);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Profile.saveFailed"), icon: "none" });
        return;
      }
      userName.value = nextUserName;
      nickName.value = nickName.value.trim();
      uni.showToast({ title: t("Mobile.Profile.saveSuccess"), icon: "success" });
    } catch (error) {
      console.error("保存用户资料失败", error);
      uni.showToast({ title: t("Mobile.Profile.saveFailed"), icon: "none" });
    } finally {
      saving.value = false;
    }
  };

  onLoad((_options: any) => {
    setCurrentPageNavigationBarTitle();
    loadUserInfo();
  });
</script>

<style lang="scss" scoped>
  .edit-profile-container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .form-card {
    margin: 24rpx;
    padding: 0 32rpx;
    border-radius: 24rpx;
    background-color: #ffffff;
  }

  .form-section {
    padding: 32rpx 0;
    border-bottom: 2rpx solid #f5f5f5;
  }
  /* vapor: 复合 &.form-section-last 提为顶层单类（模板 form-section + form-section-last 两类同挂）*/
  .form-section-last {
    border-bottom-width: 0;
  }

  .field-label {
    margin-bottom: 20rpx;
    font-size: 30rpx;
    font-weight: 500;
    color: #1a1a1a;
  }

  .input-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 80rpx;
    padding: 0 20rpx;
    border: 2rpx solid #e8e8e8;
    border-radius: 16rpx;
    box-sizing: border-box;
  }

  .field-input {
    flex: 1;
    min-width: 0;
    font-size: 28rpx;
    color: #1a1a1a;
  }

  .field-placeholder {
    color: #bfbfbf;
  }

  .count-text {
    margin-left: 16rpx;
    flex-shrink: 0;
    font-size: 24rpx;
    color: #999999;
  }

  .save-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 144rpx;
    height: 72rpx;
    margin: 8rpx 0 32rpx;
    border-radius: 16rpx;
    background-color: #5147ff;
  }
  /* vapor: 复合 &.save-button-disabled 提为顶层单类（模板 save-button + save-button-disabled 两类同挂）*/
  .save-button-disabled {
    opacity: 0.6;
  }

  .save-button-text {
    font-size: 28rpx;
    font-weight: 500;
    color: #ffffff;
  }
</style>
