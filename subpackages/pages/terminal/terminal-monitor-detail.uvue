<template>
  <view class="container relative flex flex-col">
    <custom-nav-bar :title="t('Mobile.Terminal.monitorDetail')" className="border-b" hasSafetyZone showBack />

    <template v-if="!detailReady">
      <view class="state-box flex-1">
        <text class="state-text">{{ t("Mobile.Terminal.loading") }}</text>
      </view>
    </template>

    <template v-else-if="loadFailed">
      <view class="state-box flex-1">
        <text class="state-text">{{ t("Mobile.Terminal.fetchMonitorFailed") }}</text>
        <view class="retry-btn" hover-class="retry-btn-active" @click="fetchDetail">
          <text class="retry-text">{{ t("Mobile.Common.retry") }}</text>
        </view>
      </view>
    </template>

    <template v-else>
      <view class="top-fixed">
        <view class="head-card">
          <text class="head-title">{{ title != "" ? title : t("Mobile.Terminal.untitledMonitoring") }}</text>
          <view class="head-meta">
            <text class="head-meta-text">{{ formatDateRange(startedAt, endedAt) }}</text>
            <text v-if="durationMs > 0" class="head-meta-text"> · {{ formatMs(durationMs) }}</text>
            <text v-if="statusLabel != ''" :class="['head-meta-text', 'head-status-' + statusLevel]"> · {{ statusLabel }}</text>
          </view>
        </view>

        <view class="tab-row">
          <view :class="['tab-btn', activeTab == 'content' ? 'tab-btn-on' : '']" @click="switchTab('content')">
            <text :class="['tab-text', activeTab == 'content' ? 'tab-text-on' : '']">{{ t("Mobile.Terminal.monitorContentTab") }}</text>
          </view>
          <view :class="['tab-btn', activeTab == 'transcript' ? 'tab-btn-on' : '']" @click="switchTab('transcript')">
            <text :class="['tab-text', activeTab == 'transcript' ? 'tab-text-on' : '']">{{ t("Mobile.Terminal.transcriptTab") }}</text>
          </view>
        </view>
      </view>

      <audio-transcript-player
        v-if="hasAudio || segments.length > 0"
        :class="activeTab == 'transcript' ? 'player-host flex-1' : 'player-host player-host--bar'"
        :meeting-id="monitoringId"
        :segments="segments"
        :duration-ms="durationMs"
        :has-audio="hasAudio"
        :autoplay="autoplay"
        :show-player="hasAudio"
        :show-transcript="activeTab == 'transcript'"
        :visible="activeTab == 'transcript'"
        record-type="monitoring"
        @play="handlePlayerPlay"
      />

      <scroll-view
        v-if="activeTab == 'content'"
        class="content-scroll flex-1"
        direction="vertical"
        :show-scrollbar="false"
      >
        <view class="content-card">
          <text v-if="transcript != ''" class="content-text">{{ transcript }}</text>
          <text v-else class="empty-text">{{ statusFailed ? t("Mobile.Terminal.processFailed") : t("Mobile.Terminal.noMonitorContent") }}</text>
        </view>
        <view class="bottom-space"></view>
      </scroll-view>
    </template>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiVoxMonitoringDetail } from "@/servers/vox/voxMonitoring";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { AudioTranscriptSegment } from "@/components/audio-transcript-player/types.uts";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const monitoringId = ref<number>(0);
  const autoplay = ref<boolean>(false);
  const detailReady = ref<boolean>(false);
  const loadFailed = ref<boolean>(false);
  const title = ref<string>("");
  const status = ref<string>("");
  const statusLabel = ref<string>("");
  const statusLevel = ref<string>("unknown");
  const startedAt = ref<string>("");
  const endedAt = ref<string>("");
  const transcript = ref<string>("");
  const durationMs = ref<number>(0);
  const hasAudio = ref<boolean>(false);
  const statusFailed = ref<boolean>(false);
  const segments = ref<AudioTranscriptSegment[]>([]);
  const activeTab = ref<string>("content");

  const formatMs = (ms: number): string => {
    const totalSec = Math.floor(ms / 1000);
    const min = Math.floor(totalSec / 60);
    const sec = totalSec % 60;
    const secStr = sec < 10 ? `0${sec}` : `${sec}`;
    return `${min}:${secStr}`;
  };

  const formatDateRange = (start: string, end: string): string => {
    if (start.length < 16) return start;
    const datePart = start.substring(5, 10);
    const startTime = start.substring(11, 16);
    const endTime = end.length >= 16 ? end.substring(11, 16) : "";
    return endTime != "" ? `${datePart} ${startTime}-${endTime}` : `${datePart} ${startTime}`;
  };

  const switchTab = (tab: string) => {
    activeTab.value = tab;
  };

  const handlePlayerPlay = () => {
    if (activeTab.value != "transcript") {
      activeTab.value = "transcript";
    }
  };

  const fetchDetail = async () => {
    if (monitoringId.value <= 0) {
      detailReady.value = true;
      loadFailed.value = true;
      return;
    }
    detailReady.value = false;
    loadFailed.value = false;
    try {
      const res = await apiVoxMonitoringDetail(monitoringId.value);
      if (apiResCode(res) != SUCCESS_CODE) {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.fetchMonitorFailed"), icon: "none" });
        loadFailed.value = true;
        return;
      }
      const raw = apiResData<any>(res);
      const d = raw != null ? (raw as UTSJSONObject) : null;
      if (d == null) {
        loadFailed.value = true;
        return;
      }

      const runIdVal = d["runId"];
      title.value = runIdVal != null ? `${runIdVal}` : "";
      const statusVal = d["status"];
      status.value = statusVal != null ? `${statusVal}` : "";
      const statusUpper = status.value.toUpperCase();
      if (statusUpper == "ACTIVE") {
        statusLabel.value = t("Mobile.Terminal.monitorStatusActive");
        statusLevel.value = "active";
      } else if (statusUpper == "ENDED") {
        statusLabel.value = t("Mobile.Terminal.monitorStatusEnded");
        statusLevel.value = "ended";
      } else if (statusUpper == "INCOMPLETE") {
        statusLabel.value = t("Mobile.Terminal.monitorStatusIncomplete");
        statusLevel.value = "incomplete";
      } else {
        statusLabel.value = status.value;
        statusLevel.value = "unknown";
      }
      statusFailed.value = statusUpper == "INCOMPLETE";
      const startVal = d["startedAt"];
      startedAt.value = startVal != null ? `${startVal}` : "";
      const endVal = d["endedAt"];
      endedAt.value = endVal != null ? `${endVal}` : "";
      const transcriptVal = d["transcript"];
      transcript.value = transcriptVal != null ? `${transcriptVal}` : "";
      const durationVal = d["audioDurationMs"];
      durationMs.value = durationVal != null ? (durationVal as number) : 0;
      const audioVal = d["audioFileUrl"];
      hasAudio.value = audioVal != null && `${audioVal}` != "";

      const utterancesVal = d["utterances"];
      const utterances = utterancesVal != null ? (utterancesVal as UTSJSONObject[]) : ([] as UTSJSONObject[]);
      const list: AudioTranscriptSegment[] = [];
      for (let i = 0; i < utterances.length; i++) {
        const item = utterances[i];
        const seqVal = item["seq"];
        const speakerVal = item["speaker"];
        const textVal = item["text"];
        const startMsVal = item["startMs"];
        const endMsVal = item["endMs"];
        list.push(new AudioTranscriptSegment(
          seqVal != null ? (seqVal as number) : i,
          speakerVal != null ? `${speakerVal}` : "",
          textVal != null ? `${textVal}` : "",
          startMsVal != null ? (startMsVal as number) : 0,
          endMsVal != null ? (endMsVal as number) : 0,
        ));
      }
      segments.value = list;
      if (autoplay.value && hasAudio.value) {
        activeTab.value = "transcript";
      }
    } catch (e) {
      loadFailed.value = true;
      console.error("fetchMonitoringDetail error", e);
    } finally {
      detailReady.value = true;
    }
  };

  onLoad((options: any) => {
    if (options != null) {
      const optObj = options as UTSJSONObject;
      const idVal = optObj["id"];
      if (idVal != null && `${idVal}` != "") {
        monitoringId.value = parseInt(`${idVal}`);
      }
      const autoplayVal = optObj["autoplay"];
      autoplay.value = autoplayVal != null && `${autoplayVal}` == "1";
    }
    setCurrentPageNavigationBarTitle();
    fetchDetail();
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .state-box {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;

    .state-text {
      font-size: 28rpx;
      color: #999999;
    }

    .retry-btn {
      margin-top: 24rpx;
      padding: 14rpx 36rpx;
      border-radius: 24rpx;
      background-color: rgba(81, 71, 255, 0.1);
    }

    .retry-btn-active {
      opacity: 0.7;
    }

    .retry-text {
      font-size: 26rpx;
      color: #5147ff;
    }
  }

  .top-fixed {
    flex-shrink: 0;
  }

  .content-scroll {
    min-height: 0;
  }

  .player-host {
    min-height: 0;
    width: 100%;

    &--bar {
      flex-shrink: 0;
      flex-grow: 0;
    }
  }

  .head-card {
    background-color: #ffffff;
    border-radius: 24rpx;
    margin: 24rpx 24rpx 0;
    padding: 32rpx;

    .head-title {
      font-size: 34rpx;
      font-weight: 700;
      color: #1a1a1a;
    }

    .head-meta {
      margin-top: 12rpx;

      .head-meta-text {
        font-size: 24rpx;
        color: #666666;
      }

      .head-status-active {
        color: #ff9500;
      }

      .head-status-ended {
        color: #08a960;
      }

      .head-status-incomplete {
        color: #dd524d;
      }
    }
  }

  .tab-row {
    display: flex;
    flex-direction: row;
    margin: 24rpx 24rpx 0;
    background-color: #ffffff;
    border-radius: 16rpx;
    padding: 8rpx;

    .tab-btn {
      flex: 1;
      padding: 16rpx 0;
      border-radius: 12rpx;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .tab-btn-on {
      background-color: rgba(81, 71, 255, 0.1);
    }

    .tab-text {
      font-size: 28rpx;
      color: #666666;
    }

    .tab-text-on {
      color: #5147ff;
      font-weight: 600;
    }
  }

  .content-card {
    background-color: #ffffff;
    border-radius: 24rpx;
    margin: 20rpx 24rpx 0;
    padding: 32rpx;

    .content-text {
      font-size: 28rpx;
      color: #1a1a1a;
      line-height: 1.7;
    }

    .empty-text {
      font-size: 26rpx;
      color: #999999;
    }
  }

  .bottom-space {
    height: 40rpx;
  }
</style>
