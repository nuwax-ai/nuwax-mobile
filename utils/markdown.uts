import { orEmpty } from "@/utils/utsCoalesce";
import {
  findNextMarkdownContainerFence,
  findNextMarkdownCustomProcessTag,
  toMarkdownCustomProcessHtml,
} from "@/utils/markdownCustomProcess.uts";
import { isOpenUiRenderToolName } from "@/utils/openUiSchema.uts";
import { openUiStatusPriority } from "@/utils/openUiMarkdown.uts";

class MathDelimiter {
  left: string = "";
  right: string = "";
  display: boolean = false;
}

function createMathDelimiter(
  left: string,
  right: string,
  display: boolean,
): MathDelimiter {
  const item = new MathDelimiter();
  item.left = left;
  item.right = right;
  item.display = display;
  return item;
}

const defaultDelimiters: MathDelimiter[] = [
  createMathDelimiter("\\[", "\\]", true),
  createMathDelimiter("\\(", "\\)", false),
];

class BracketMatchResult {
  formula: string = "";
  display: boolean = false;
  start: number = 0;
  end: number = 0;
  left: string = "";
  right: string = "";
  success: boolean = false;
}

function createBracketMatchSuccess(
  formula: string,
  display: boolean,
  start: number,
  end: number,
  left: string,
  right: string,
): BracketMatchResult {
  const result = new BracketMatchResult();
  result.formula = formula;
  result.display = display;
  result.start = start;
  result.end = end;
  result.left = left;
  result.right = right;
  result.success = true;
  return result;
}

function createBracketMatchFailure(): BracketMatchResult {
  return new BracketMatchResult();
}

// 转义括号规则 - 通用数学公式解析器
function escapedBracketRule(delimiters: MathDelimiter[]) {
  return (text: string, startPos: number): BracketMatchResult => {
    const max = text.length;
    const start = startPos;

    for (let di = 0; di < delimiters.length; di++) {
      const delimiter = delimiters[di];
      const left = delimiter.left;
      const right = delimiter.right;
      const display = delimiter.display;

      // 检查是否以左标记开始
      if (!text.slice(start).startsWith(left)) {
        continue;
      }

      // 跳过左标记的长度
      let pos = start + left.length;

      // 寻找匹配的右标记
      while (pos < max) {
        if (text.slice(pos).startsWith(right)) {
          break;
        }
        pos++;
      }

      // 没找到匹配的右标记，跳过，进入下个匹配
      if (pos >= max) {
        continue;
      }

      // 提取数学公式内容
      const content = text.slice(start + left.length, pos);
      const endPos = pos + right.length;

      return createBracketMatchSuccess(
        content,
        display,
        start,
        endPos,
        left,
        right,
      );
    }

    return createBracketMatchFailure();
  };
}

/** groupMarkdownContainers / dedupe 用的过程块匹配结果。 */
class MarkdownContainerMatch {
  index: number = 0;
  endIndex: number = 0;
  executeId: string = "";
  fullMatch: string = "";
  tagMatch: string = "";
  isPlan: boolean = false;
  type: string = "";
  status: string = "";
  name: string = "";
}

function expandLeadingWhitespace(text: string, index: number): number {
  let i = index;
  while (i > 0) {
    const ch = text.charAt(i - 1);
    if (ch == " " || ch == "\n" || ch == "\r" || ch == "\t") {
      i--;
      continue;
    }
    break;
  }
  return i;
}

/** 按出现顺序收集 HTML / :::container 过程块（引号感知，允许 name 含 >）。 */
function collectMarkdownContainerMatches(
  text: string,
): MarkdownContainerMatch[] {
  const matches: MarkdownContainerMatch[] = [];
  let from = 0;
  while (from < text.length) {
    const htmlTag = findNextMarkdownCustomProcessTag(text, from);
    const fence = findNextMarkdownContainerFence(text, from);
    const htmlFound = htmlTag.found == true;
    const fenceFound = fence.found == true;
    if (htmlFound != true && fenceFound != true) {
      break;
    }
    let useHtml = false;
    if (htmlFound == true && fenceFound == true) {
      useHtml = htmlTag.index <= fence.index;
    } else {
      useHtml = htmlFound == true;
    }
    const item = new MarkdownContainerMatch();
    if (useHtml == true) {
      if (htmlTag.executeId.length == 0) {
        from = htmlTag.endIndex > from ? htmlTag.endIndex : from + 1;
        continue;
      }
      item.index = expandLeadingWhitespace(text, htmlTag.index);
      item.endIndex = htmlTag.endIndex;
      item.executeId = htmlTag.executeId;
      item.fullMatch = text.substring(item.index, item.endIndex);
      item.tagMatch = htmlTag.tagMatch;
      item.type = htmlTag.type;
      item.status = htmlTag.status;
      item.name = htmlTag.name;
      item.isPlan = htmlTag.type == "Plan";
      matches.push(item);
      from = htmlTag.endIndex > from ? htmlTag.endIndex : from + 1;
    } else {
      if (fence.executeId.length == 0) {
        from = fence.endIndex > from ? fence.endIndex : from + 1;
        continue;
      }
      item.index = expandLeadingWhitespace(text, fence.index);
      item.endIndex = fence.endIndex;
      item.executeId = fence.executeId;
      item.fullMatch = text.substring(item.index, item.endIndex);
      item.tagMatch = fence.fullMatch;
      item.type = fence.type;
      item.status = fence.status;
      item.name = fence.name;
      item.isPlan = fence.type == "Plan";
      matches.push(item);
      from = fence.endIndex > from ? fence.endIndex : from + 1;
    }
  }
  return matches;
}

function normalizeContainerTag(m: MarkdownContainerMatch): string {
  return toMarkdownCustomProcessHtml(
    m.executeId,
    orEmpty(m.type),
    orEmpty(m.status),
    orEmpty(m.name),
  );
}

function dedupeMarkdownContainers(text: string): string {
  if (text.length === 0) return "";

  const matches = collectMarkdownContainerMatches(text);
  // 普通工具：同 executeId 保留最后一次；OpenUI：优先更好 status（策略在 openUiMarkdown）
  const keepIndexMap = new Map<string, number>();
  for (let i = 0; i < matches.length; i++) {
    const m = matches[i];
    const execId = m.executeId;
    const prevIdx = keepIndexMap.get(execId);
    if (prevIdx == null) {
      keepIndexMap.set(execId, i);
      continue;
    }
    if (isOpenUiRenderToolName(m.name) == true) {
      const prev = matches[prevIdx];
      const prevPri = openUiStatusPriority(prev.status);
      const curPri = openUiStatusPriority(m.status);
      if (curPri < prevPri || (curPri == prevPri && m.index >= prev.index)) {
        keepIndexMap.set(execId, i);
      }
    } else {
      keepIndexMap.set(execId, i);
    }
  }

  const ignoreMatchIndices = new Set<number>();
  for (let i = 0; i < matches.length; i++) {
    const m = matches[i];

    if (keepIndexMap.get(m.executeId) !== i) {
      ignoreMatchIndices.add(i);
      continue;
    }

    if (m.isPlan) {
      let nextPlanIndex = -1;
      for (let j = i + 1; j < matches.length; j++) {
        const next = matches[j];
        if (next.isPlan) {
          const middleText = text.slice(m.endIndex, next.index);
          if (middleText.trim() === "") {
            nextPlanIndex = j;
          }
          break;
        } else {
          break;
        }
      }

      if (nextPlanIndex !== -1) {
        ignoreMatchIndices.add(i);
      }
    }
  }

  let dedupedText = "";
  let lastPos = 0;

  for (let i = 0; i < matches.length; i++) {
    const m = matches[i];
    if (ignoreMatchIndices.has(i)) {
      dedupedText += text.slice(lastPos, m.index);
      lastPos = m.endIndex;
    }
  }
  dedupedText += text.slice(lastPos);

  return dedupedText;
}

/**
 * 根据规则将连续的过程标签（ToolCall, Skill等）合并。
 * 1. 仅 ≥2 个连续过程标签才合成 process-group；单工具始终独立卡
 *    （流式期与完成态渲染一致，避免「流式组内 1 项 → 会话完成后移出组单独显示」的跳动）
 * 2. Plan 作分隔符不进组；Event 默认跳过（OpenUI renderUI 例外，需保留供 openui-card）
 * 3. 标签间仅空白时不中断合并
 * 4. 支持 :::container 与 HTML 过程标签
 * @param text - 待处理的 Markdown 文本
 * @returns 处理后的文本
 */
export function groupMarkdownContainers(text: string): string {
  if (text.length === 0) return "";

  // 预处理：合并连续相同的 Plan 并去重重复的自定义容器
  const dedupedText = dedupeMarkdownContainers(text);
  const matches = collectMarkdownContainerMatches(dedupedText);

  let result = "";
  let lastIndex = 0;
  let currentGroup: string[] = [];
  let normalizedGroup: string[] = [];

  const flushGroup = () => {
    if (currentGroup.length > 0) {
      // ≥2 才合组；单工具始终独立卡（与完成态渲染一致）
      if (currentGroup.length >= 2) {
        const groupContent = `\n\n<markdown-custom-process-group>\n${normalizedGroup.join("\n")}\n</markdown-custom-process-group>\n\n`;
        result += groupContent;
      } else {
        // 单工具：规范化 HTML，避免 H5 :::container 插件把 data 弄成字符串
        result += `\n\n${normalizedGroup[0]}\n\n`;
      }
      currentGroup = [] as string[];
      normalizedGroup = [] as string[];
    }
  };

  for (let i = 0; i < matches.length; i++) {
    const match = matches[i];
    const textBefore = dedupedText.slice(lastIndex, match.index);

    // Event：内部事件默认跳过；OpenUI renderUI 例外——需保留标签供 mp-html 渲染 openui-card。
    if (match.type == "Event" && isOpenUiRenderToolName(match.name) != true) {
      if (textBefore.trim() !== "") {
        flushGroup();
        result += textBefore;
      } else if (currentGroup.length === 0) {
        result += textBefore;
      }
      lastIndex = match.endIndex;
      continue;
    }

    if (textBefore.trim() !== "") {
      flushGroup();
      result += textBefore;
    } else {
      if (currentGroup.length === 0) {
        result += textBefore;
      }
    }

    const tagMatch = match.tagMatch;
    const normalizedTag = normalizeContainerTag(match);

    if (match.isPlan == true) {
      // Plan 定界前面的工具簇，自身不进组
      flushGroup();
      result += `\n\n${normalizedTag}\n\n`;
    } else if (isOpenUiRenderToolName(match.name) == true) {
      // OpenUI 独立渲染：禁止塞进 markdown-custom-process-group。
      // group-content 默认/折叠态 max-height:0 + opacity:0，会把 openui-card 完全藏住。
      flushGroup();
      result += `\n\n${normalizedTag}\n\n`;
    } else {
      currentGroup.push(tagMatch);
      normalizedGroup.push(normalizedTag);
    }

    lastIndex = match.endIndex;
  }

  const trailingText = dedupedText.slice(lastIndex);
  flushGroup();
  result += trailingText;

  const finalResult = result.replace(/\n{3,}/g, "\n\n").trim();
  return finalResult;
}

// 新的数学公式替换函数 - 直接替换为 $$ 分隔符
export function replaceMathBracket(text: string): string {
  // return text; //临时关闭

  // 创建只包含非美元符号分隔符的选项
  const nonDollarDelimiters: MathDelimiter[] = [];
  for (let i = 0; i < defaultDelimiters.length; i++) {
    const delimiter = defaultDelimiters[i];
    if (
      !delimiter.left.includes("$") &&
      !delimiter.right.includes("$")
    ) {
      nonDollarDelimiters.push(delimiter);
    }
  }

  const rule = escapedBracketRule(nonDollarDelimiters);
  let result = "";
  let pos = 0;

  while (pos < text.length) {
    const match = rule(text, pos);
    if (match.success) {
      // 添加匹配前的文本
      result += text.slice(pos, match.start);
      // 替换为 $$ 分隔符
      const delimiter = match.display ? "$$" : "$";
      result += `${delimiter}${match.formula}${delimiter}`;
      pos = match.end;
    } else {
      // 没有匹配，添加当前字符
      result += text[pos];
      pos++;
    }
  }

  return result;
}
