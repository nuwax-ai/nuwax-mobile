<template>
  <view class="cst-bar">
    <view
      v-for="tab in tabs"
      :key="tab.id"
      class="cst-tab"
      :class="active == tab.id ? 'cst-tab--on' : ''"
      hover-class="cst-tab--hover"
      @click="handleTap(tab.id)"
    >
      <!-- #ifdef APP-HARMONY -->
      <!-- 鸿蒙：整粒胶囊（图标+文案）由 contentOn 统一放行——图标 <image> 必须生在
           页面首帧已呈现之后（见 props.contentOn 注释），文案随之同拍，
           绝不出现「先文案后图标」 -->
      <image v-if="contentOn" class="cst-tab__icon" :src="tab.icon" mode="aspectFit" />
      <!-- #endif -->
      <!-- #ifndef APP-HARMONY -->
      <image class="cst-tab__icon" :src="tab.icon" mode="aspectFit" />
      <!-- #endif -->
      <!-- #ifdef APP-HARMONY -->
      <text
        v-if="contentOn"
        class="cst-tab__text"
        :class="active == tab.id ? 'cst-tab__text--on' : ''"
      >{{ tab.label }}</text>
      <!-- #endif -->
      <!-- #ifndef APP-HARMONY -->
      <text
        class="cst-tab__text"
        :class="active == tab.id ? 'cst-tab__text--on' : ''"
      >{{ tab.label }}</text>
      <!-- #endif -->
    </view>
    <!-- 行尾搜索键（文件按钮后面）：进「本会话内搜索」页，开关由调用方控制；
         鸿蒙与页签同拍放行，整行一起出现 -->
    <!-- #ifdef APP-HARMONY -->
    <view
      v-if="contentOn && showSearch"
      class="cst-search"
      hover-class="cst-search--hover"
      @click="handleSearchTap"
    >
      <svg-icon name="icon-Search" size="17" unit="px" color="#6b6878" />
    </view>
    <!-- #endif -->
    <!-- #ifndef APP-HARMONY -->
    <view
      v-if="showSearch"
      class="cst-search"
      hover-class="cst-search--hover"
      @click="handleSearchTap"
    >
      <svg-icon name="icon-Search" size="17" unit="px" color="#6b6878" />
    </view>
    <!-- #endif -->
  </view>
</template>

<script lang="uts" setup>
  import { ChatSubpageTab } from "@/types/interfaces/chatSubpageTab";

  /**
   * 聊天详情页「子页签行」：对话标题下方一排 消息/Pin/资料库/文件 按钮（单聊与群聊复用）。
   *
   * - 标签集由调用方拼装传入（单聊四枚；群聊后续可加群公告等），本组件只管渲染与点击分发；
   * - ★选中态不改图标颜色（彩色实心 PNG 常驻），只改文字色 + 胶囊底色——
   *   对齐 PC nuwax-im-web DEV-187 的参考图语义，勿改用 currentColor 类单色图标；
   * - 「消息」由页面侧恒为选中（本组件无内部状态，active 受控）；
   *   Pin/资料库/文件/搜索 的开页/占位逻辑全部在页面侧处理（组件不感知路由）；
   * - 行尾可带一枚搜索键（showSearch 开关）：点击只向外发 search 事件。
   */
  const props = withDefaults(
    defineProps<{
      /** 标签集（顺序即渲染顺序）。 */
      tabs: ChatSubpageTab[];
      /** 当前选中标签 id（受控；「消息」页恒传 "messages"）。 */
      active?: string;
      /** 行尾是否渲染搜索键（「文件」后面的放大镜）。 */
      showSearch?: boolean;
      /**
       * APP-HARMONY：页签内容（图标+文案+搜索键）是否放行。
       * 鸿蒙 Image 节点建出来即 Visibility.Hidden，要等 onComplete 派发 loadingStatus===0
       * 才置可见；而 @load 走 loadingStatus===1 另一条分支，于是「事件正常、图不显示」。
       * 实证规律：图片节点生在页面首帧窗内就永久 Hidden，生在首帧呈现之后则正常
       * （代码依据见 pages/message/chat.uvue 的 harmonyImgOn 头注）。
       * 故由调用方在 onReady（=首帧已呈现）之后置 true，图标与文案整粒一起出现，
       * 不做组件内自计时（旧版延迟放行会「先文案后图标」）。
       * 其余端不传，默认 true 恒放行。
       */
      contentOn?: boolean;
    }>(),
    {
      tabs: () => [] as ChatSubpageTab[],
      active: "messages",
      showSearch: false,
      contentOn: true,
    },
  );

  const emit = defineEmits<{
    (e: "select", id: string): void;
    (e: "search"): void;
  }>();

  // 组件的放行时机全部由调用方掌握（props.contentOn），组件内不自行计时。

  function handleTap(id: string): void {
    emit("select", id);
  }

  function handleSearchTap(): void {
    emit("search");
  }
</script>

<style lang="scss" scoped>
  /* ===== 子页签行：标题下方，左起横排胶囊 ===== */
  .cst-bar {
    flex-shrink: 0;
    padding: 6px 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-bottom: 1px solid #e5e6eb;
  }

  .cst-tab {
    padding: 4px 11px;
    margin-right: 6px;
    /* 圆角收敛：近全胶囊 → 8px 小圆角（用户要求「圆角小一点」） */
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .cst-tab--on {
    /* 选中胶囊淡蓝底（与「消息」气泡蓝同色系） */
    background-color: rgba(19, 86, 240, 0.1);
  }

  .cst-tab--hover {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .cst-tab__icon {
    width: 20px;
    height: 20px;
    margin-right: 4px;
    flex-shrink: 0;
  }

  .cst-tab__text {
    font-size: 13px;
    line-height: 18px;
    color: #6b6878;
  }

  .cst-tab__text--on {
    color: #1356f0;
    font-weight: 600;
  }

  /* 行尾搜索键：圆形热区，紧跟最后一个 tab（不顶到右缘） */
  .cst-search {
    width: 32px;
    height: 32px;
    margin-left: 2px;
    border-radius: 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cst-search--hover {
    background-color: rgba(81, 71, 255, 0.06);
  }

  /* #ifdef APP-HARMONY || APP-ANDROID */
  /* 鸿蒙 HarmonyOS Sans 字形偏宽：四页签 + 搜索键在窄屏行内溢出，最右搜索键被裁
     （uni-app x 子项默认 flex-shrink:0 不收缩）。只收间距（margin）不动胶囊内距
     （padding）与 icon 尺寸：11px 内距撑住胶囊视觉大小，页间距收到 2px 后相邻
     胶囊视觉间隙仍有 25px 不显拥挤；合计省 26px。
     Android 同步这套收窄后的间距（用户要求两端观感一致，页间距小一点）；
     iOS/H5 保持 6px 不动。 */
  .cst-tab {
    margin-right: 2px;
  }

  .cst-tab__icon {
    margin-right: 2px;
  }

  .cst-search {
    margin-left: 0px;
  }
  /* #endif */
</style>
