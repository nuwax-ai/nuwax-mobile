  .mr-chat-name {
    font-size: 11px;
    line-height: 16px;
    color: #7d818c;
  }

  .mr-chat-text {
    margin-top: 2px;
    font-size: 15px;
    line-height: 21px;
    color: #141416;
    word-break: break-all;
  }

  .mr-chat-compose {
    padding: 10px 12px;
    border-top: 1px solid #e8e9ed;
    display: flex;
    flex-direction: row;
