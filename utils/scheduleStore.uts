/**
 * 日程本地草稿。
 * 新建页保存后按开始日期落在月历当天；重复规则只做展示过滤，不展开成多条记录。
 */

const STORAGE_KEY = "nuwax_schedule_events";

/** 一条日程。日期为 yyyy-mm-dd，时间为 HH:mm。 */
export class ScheduleEvent {
  id: string = "";
  title: string = "";
  startDate: string = "";
  endDate: string = "";
  startTime: string = "";
  endTime: string = "";
  /** none | daily | weekly | monthly | yearly */
  repeat: string = "none";
  /** none | start | m5 | m15 | m30 | h1 */
  remind: string = "m15";
  location: string = "";
  notes: string = "";
}

function readString(obj: UTSJSONObject, key: string): string {
  const value = obj[key];
  if (value == null) {
    return "";
  }
  return `${value}`;
}

function ymdNumber(text: string, start: number, end: number): number {
  if (text.length < end) {
    return -1;
  }
  const n = parseInt(text.substring(start, end));
  if (isNaN(n)) {
    return -1;
  }
  return n;
}

/** yyyy-mm-dd 的星期，解析失败返回 -1。 */
function ymdWeekday(text: string): number {
  const year = ymdNumber(text, 0, 4);
  const month = ymdNumber(text, 5, 7);
  const day = ymdNumber(text, 8, 10);
  if (year < 0 || month < 1 || day < 1) {
    return -1;
  }
  return new Date(year, month - 1, day).getDay();
}

function eventFromJson(obj: UTSJSONObject): ScheduleEvent {
  const event = new ScheduleEvent();
  event.id = readString(obj, "id");
  event.title = readString(obj, "title");
  event.startDate = readString(obj, "sd");
  event.endDate = readString(obj, "ed");
  event.startTime = readString(obj, "st");
  event.endTime = readString(obj, "et");
  event.repeat = readString(obj, "rp");
  event.remind = readString(obj, "rm");
  event.location = readString(obj, "loc");
  event.notes = readString(obj, "nt");
  if (event.repeat.length == 0) {
    event.repeat = "none";
  }
  if (event.remind.length == 0) {
    event.remind = "m15";
  }
  if (event.endDate.length == 0) {
    event.endDate = event.startDate;
  }
  return event;
}

function eventToJson(event: ScheduleEvent): UTSJSONObject {
  const obj = new UTSJSONObject();
  obj["id"] = event.id;
  obj["title"] = event.title;
  obj["sd"] = event.startDate;
  obj["ed"] = event.endDate;
  obj["st"] = event.startTime;
  obj["et"] = event.endTime;
  obj["rp"] = event.repeat;
  obj["rm"] = event.remind;
  obj["loc"] = event.location;
  obj["nt"] = event.notes;
  return obj;
}

/**
 * 读取全部已保存日程。存储损坏时按空列表处理。
 */
export function loadScheduleEvents(): ScheduleEvent[] {
  const result: ScheduleEvent[] = [];
  try {
    const raw = uni.getStorageSync(STORAGE_KEY);
    if (raw == null) {
      return result;
    }
    const text = `${raw}`.trim();
    if (text.length == 0) {
      return result;
    }
    const root = JSON.parse<UTSJSONObject>(text);
    if (root == null) {
      return result;
    }
    const itemsRaw = root["items"];
    if (itemsRaw == null) {
      return result;
    }
    const items = itemsRaw as UTSJSONObject[];
    for (let i = 0; i < items.length; i++) {
      const event = eventFromJson(items[i]);
      if (event.id.length > 0 && event.startDate.length > 0) {
        result.push(event);
      }
    }
  } catch (_error) {
    return [] as ScheduleEvent[];
  }
  return result;
}

function persistEvents(events: ScheduleEvent[]): void {
  const items: UTSJSONObject[] = [];
  for (let i = 0; i < events.length; i++) {
    items.push(eventToJson(events[i]));
  }
  const root = new UTSJSONObject();
  root["items"] = items;
  const json = JSON.stringify(root);
  if (json == null) {
    return;
  }
  try {
    uni.setStorageSync(STORAGE_KEY, json);
  } catch (_error) {
    // 写失败保持内存外的旧数据，下次进入再读
  }
}

/**
 * 追加一条日程并落盘。
 * @param event 已填好 id 与开始日期的日程
 */
export function appendScheduleEvent(event: ScheduleEvent): void {
  if (event.id.length == 0 || event.startDate.length == 0) {
    return;
  }
  const events = loadScheduleEvents();
  events.push(event);
  persistEvents(events);
}

/** yyyy-mm-dd 转成可比较的整数，解析失败返回 -1。 */
function ymdKey(text: string): number {
  const year = ymdNumber(text, 0, 4);
  const month = ymdNumber(text, 5, 7);
  const day = ymdNumber(text, 8, 10);
  if (year < 0 || month < 1 || day < 1) {
    return -1;
  }
  return year * 10000 + month * 100 + day;
}

/** HH:mm 转成分钟数，解析失败返回 0。 */
function hmKey(text: string): number {
  const parts = text.split(":");
  if (parts.length < 2) {
    return 0;
  }
  const hour = parseInt(parts[0]);
  const minute = parseInt(parts[1]);
  if (isNaN(hour) || isNaN(minute)) {
    return 0;
  }
  return hour * 60 + minute;
}

function occursOn(event: ScheduleEvent, date: string, weekday: number, day: number, month: number): boolean {
  const dateKey = ymdKey(date);
  const startKey = ymdKey(event.startDate);
  if (dateKey < 0 || startKey < 0 || dateKey < startKey) {
    return false;
  }
  if (event.repeat == "none") {
    const endKey = ymdKey(event.endDate.length > 0 ? event.endDate : event.startDate);
    return endKey >= startKey && dateKey >= startKey && dateKey <= endKey;
  }
  if (event.repeat == "daily") {
    return true;
  }
  if (event.repeat == "weekly") {
    return ymdWeekday(event.startDate) == weekday;
  }
  if (event.repeat == "monthly") {
    return ymdNumber(event.startDate, 8, 10) == day;
  }
  if (event.repeat == "yearly") {
    return ymdNumber(event.startDate, 5, 7) == month && ymdNumber(event.startDate, 8, 10) == day;
  }
  return event.startDate == date;
}

/**
 * 选出落在某一天的日程，按开始时间升序。
 * @param date yyyy-mm-dd
 * @param weekday Date.getDay()，0 为周日
 * @param day 日
 * @param month 月，1-12
 */
export function eventsOnDate(date: string, weekday: number, day: number, month: number): ScheduleEvent[] {
  const all = loadScheduleEvents();
  const matched: ScheduleEvent[] = [];
  for (let i = 0; i < all.length; i++) {
    if (occursOn(all[i], date, weekday, day, month)) {
      matched.push(all[i]);
    }
  }
  matched.sort((a: ScheduleEvent, b: ScheduleEvent): number => {
    return hmKey(a.startTime) - hmKey(b.startTime);
  });
  return matched;
}
