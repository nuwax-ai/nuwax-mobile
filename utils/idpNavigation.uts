import { getApiBaseUrl } from "@/constants/config";
import { isAppWebViewEmbedded } from "@/utils/appWebViewDetect";
import { IDP_RETURN_PATH, IDENTITY_PAGE_PATH, MOBILE_LOGIN_PATH, mobileAuthWebReturn,
  buildIdpAuthorizePath, buildIdentityBindPath, resolveMobileAuthReturn, resolvePendingAuthReturn, decodeAuthQuery } from "@/utils/authIdp";

export function canUseBrowserIdp(): boolean {
  // #ifdef H5 || WEB
  const base = getApiBaseUrl();
  return !isAppWebViewEmbedded() && (base.length == 0 || base == window.location.origin);
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

export function authBrowserOrigin(): string {
  // #ifdef H5 || WEB
  return window.location.origin;
  // #endif
  // #ifndef H5 || WEB
  return "";
  // #endif
}

export function authBrowserUserAgent(): string {
  // #ifdef H5 || WEB
  return navigator.userAgent;
  // #endif
  // #ifndef H5 || WEB
  return "";
  // #endif
}

// 顶层 query 和 hash query 分开读；hash 中的参数优先。不将参数值当作 HTML。
export function authBrowserQuery(name: string): string {
  let result = "";
  // #ifdef H5 || WEB
  const hash = window.location.hash;
  const hashQuery = hash.includes("?") ? hash.substring(hash.indexOf("?") + 1) : "";
  const queries = [window.location.search.substring(1), hashQuery];
  for (let i = 0; i < queries.length; i++) {
    const pairs = queries[i].split("&");
    for (let j = 0; j < pairs.length; j++) {
      const idx = pairs[j].indexOf("=");
      const key = idx >= 0 ? pairs[j].substring(0, idx) : pairs[j];
      if (key == name) result = idx >= 0 ? decodeAuthQuery(pairs[j].substring(idx + 1).replace(/\+/g, " ")) : "1";
    }
  }
  // #endif
  return result;
}

export function beginBrowserIdp(providerId: string, requestedReturn: string, replace: boolean = false): boolean {
  if (!canUseBrowserIdp()) return false;
  const target = resolveMobileAuthReturn(requestedReturn, authBrowserOrigin());
  const callback = "/m/#" + IDP_RETURN_PATH + "?redirect=" + encodeURIComponent(target);
  const path = buildIdpAuthorizePath(providerId, callback);
  if (path.length == 0) return false;
  // #ifdef H5 || WEB
  if (replace) window.location.replace(path);
  else window.location.assign(path);
  // #endif
  return true;
}

export function beginBrowserIdentityBind(providerId: string): boolean {
  if (!canUseBrowserIdp()) return false;
  const path = buildIdentityBindPath(providerId, mobileAuthWebReturn(IDENTITY_PAGE_PATH, authBrowserOrigin()));
  if (path.length == 0) return false;
  // #ifdef H5 || WEB
  window.location.assign(path);
  // #endif
  return true;
}

export function ordinaryLoginUrl(returnPath: string = ""): string {
  // 用户主动切换登录方式仍须保留“登录后绑定已有账号”的可信 pending 上下文。
  const pending = canUseBrowserIdp() ? resolvePendingAuthReturn(returnPath, authBrowserOrigin()) : "";
  const target = pending.length > 0 ? pending : resolveMobileAuthReturn(returnPath, authBrowserOrigin());
  const suffix = returnPath.length > 0 ? "&redirect=" + encodeURIComponent(target) : "";
  return MOBILE_LOGIN_PATH + "?local=1" + suffix;
}
