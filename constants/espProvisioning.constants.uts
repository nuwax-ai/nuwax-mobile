/** ESP32-S3 / ESP-IDF 6.0 Provisioning APP 侧非敏感默认值。 */

/** 乐鑫 BLE Provisioning 默认 Primary Service UUID。硬件可通过组件 API 覆盖。 */
export const ESP_PROV_DEFAULT_SERVICE_UUID = '0000ffff-0000-1000-8000-00805f9b34fb';

/** 官方示例常用广播名前缀；最终以固件实际 service name 为准。 */
export const ESP_PROV_DEFAULT_DEVICE_PREFIX = 'PROV_';

export const ESP_PROV_SCAN_TIMEOUT_MS = 15000;
/** 连接超时：对齐 ESPProvision iOS SDK 内部 BLE 连接计时器 bleConnectTimer=20s
 *  （含 createESPDevice 内部 ~5s 重扫 + BLE 连接 + Security 2 握手）。
 *  若小于 SDK 内部 20s，APP 会先于 SDK 断开，把本可成功的慢连接掐掉。 */
export const ESP_PROV_CONNECT_TIMEOUT_MS = 20000;
/** 扫码直连等待窗口：已联网设备扫码后需回详情页点 BLE 按钮重启进 300s 窗口，过程 >8s，对齐模拟器 30s。 */
export const ESP_PROV_QR_CONNECT_TIMEOUT_MS = 30000;
/** 蓝牙权限申请等待上限：权限弹窗回调若丢失（页面跳转/回调 GC），超时后按 NO_PERMISSION
 *  进入失败态可重试（重试时权限已授予会立即通过），避免卡死在「正在连接设备…」。 */
export const ESP_PROV_PERMISSION_TIMEOUT_MS = 15000;
/** 固件单次观察 30s，APP 额外预留 5s BLE 调度余量。 */
export const ESP_PROV_STATUS_TIMEOUT_MS = 35000;
export const ESP_PROV_FIRMWARE_STATUS_TIMEOUT_MS = 30000;
export const ESP_PROV_TOTAL_WINDOW_MS = 300000;
export const ESP_PROV_POST_SUCCESS_WINDOW_MS = 15000;
export const ESP_PROV_REQUIRED_CAPABILITY = 'wifi_prov';
export const ESP_PROV_OPTIONAL_SCAN_CAPABILITY = 'wifi_scan';
export const ESP_PROV_DEVICE_INFO_ENDPOINT = 'device-info';
export const ESP_PROV_ANDROID_LIBRARY_VERSION = 'lib-2.4.4';

/** 本期固件已冻结 Security 2，不允许降级。 */
export const ESP_PROV_MIN_PRODUCTION_SECURITY = 2;
