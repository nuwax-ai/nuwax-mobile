<template>
  <view class="h-full flex flex-col border-b">
    <!-- 顶部导航栏 -->
    <custom-nav-bar :title="t('Mobile.Nav.home')" className="border-b" hasSafetyZone>
      <template v-slot:left>
        <view class="flex flex-row items-center header-menu-trigger">
          <header-menu
            v-if="isLoggedIn"
            :userInfo="userInfo"
            ref="headerMenuRef"
          />
          <!-- 登录、注册按钮 -->
          <!-- App：hover-class 对 scoped 嵌套选择器（如 &.active）常不生效；用独立类名 + touch 兜底 -->
          <view
            v-else
            class="login-btn-wrapper"
            :class="{ 'login-btn-hover': loginBtnPressed }"
            hover-class="login-btn-hover"
            :hover-start-time="0"
            @touchstart="onLoginBtnTouchStart"
            @touchend="onLoginBtnTouchEnd"
            @touchcancel="onLoginBtnTouchEnd"
            @click="handleLogin"
          >
            <text class="login-btn-text">{{
              t("Mobile.Common.loginRegister")
            }}</text>
          </view>
          <!-- #ifdef MP-WEIXIN -->
          <view v-if="isLoggedIn" class="icon-search-box" @click="handleSearch">
            <svg-icon name="icon-Search" size="48" />
          </view>
          <!-- #endif -->
        </view>
      </template>

      <!-- #ifdef H5 || WEB || APP -->
      <template v-slot:right>
        <view v-if="isLoggedIn" class="icon-search-box" @click="handleSearch">
          <svg-icon name="icon-Search" size="48" />
        </view>
      </template>
      <!-- #endif -->
    </custom-nav-bar>

    <!-- 小程序与 Android 使用原生布局，避免 uni-notice-bar 的 Vue 样式未编译导致错位。 -->
    <!-- #ifdef MP-WEIXIN -->
    <view v-if="!isLoggedIn && showExperienceNotice" class="experience-notice">
      <!-- #ifdef APP-ANDROID -->
      <view class="experience-notice-icon">
        <svg-icon name="icon-voice-1-notice" size="32" />
      </view>
      <!-- #endif -->
      <!-- #ifdef MP-WEIXIN -->
      <text class="iconfont icon-voice-1 experience-notice-icon"></text>
      <!-- #endif -->
      <text class="experience-notice-text">{{ t('Mobile.Common.noticeExperience') }}</text>
      <!-- #ifdef APP-ANDROID -->
      <view class="experience-notice-close" @click="closeExperienceNotice">
        <svg-icon name="icon-X-notice" size="32" />
      </view>
      <!-- #endif -->
      <!-- #ifdef MP-WEIXIN -->
      <text class="iconfont icon-X experience-notice-close" @click="closeExperienceNotice"></text>
      <!-- #endif -->
    </view>
    <!-- #endif -->

    <!-- 通知栏（APP-ANDROID 暂用 uni-notice-bar 的 .vue 样式不兼容，先隐藏） -->
    <!-- #ifndef APP-ANDROID -->
    <!-- #ifndef MP-WEIXIN -->
    <uni-notice-bar
      v-if="!isLoggedIn"
      single
      show-close
      show-icon
      :text="t('Mobile.Common.noticeExperience')"
    ></uni-notice-bar>
    <!-- #endif -->
    <!-- #endif -->

    <!-- 未登录时只显示智能体列表，不显示标签页 -->
    <agent-list-content
      v-if="!isLoggedIn"
      class="content-area"
      ref="agentListContentRef"
      :is-logged-in="isLoggedIn"
      @agent-click="handleAgentClick"
    >
      <!-- 头部随列表滚动，列表区吸顶 -->
      <home-header
        :user-info="userInfo"
        :is-logged-in="isLoggedIn"
        @agent-click="handleAgentClickLast"
        @input-click="handleSearch"
      />
    </agent-list-content>

    <!-- 登录后：单个滚动列表，头部随滚动滚走，历史会话/最近使用 tab 栏滚动到顶才吸顶 -->
    <home-content
      v-if="isLoggedIn"
      class="content-area"
      ref="homeContentRef"
      :is-logged-in="isLoggedIn"
      :user-info="userInfo"
      @agent-click="handleAgentClickLast"
      @conversation-click="handleConversationClick"
      @input-click="handleSearch"
    >
      <template v-slot:chat-input>
        <home-chat-launcher
          :submitting="isHomeSubmitting"
          @submit="handleHomeChatSubmit"
        />
      </template>
    </home-content>

    <!-- 登录弹窗（仅微信小程序） -->
    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, nextTick, type ComponentPublicInstance } from 'vue';
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiUserInfo } from "@/servers/account";
  import type { AgentInfo } from "@/types/interfaces/agent";
  import HeaderMenu from "./header-menu/header-menu.uvue";
  import HomeHeader from "./home-header/home-header.uvue";
  import HomeContent from "./home-content/home-content.uvue";
  import HomeChatLauncher from "./home-chat-launcher/home-chat-launcher.uvue";
  import AgentListContent from "./agent-list-content/agent-list-content.uvue";
  import { UserInfo } from "@/types/interfaces/login";
  import { onLoad, onShow, onHide } from "@dcloudio/uni-app";
  // #ifdef MP-WEIXIN
  import { onShareAppMessage, onAddToFavorites } from "@dcloudio/uni-app";
  // #endif
  import { getCurrentPagePath, jumpToAgentDetailPage } from "@/utils/commonBusiness";
  import { getCurrentPageFullPath } from "@/utils/common";
  import { goToLogin } from "@/utils/authNavigation";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  // #ifdef MP-WEIXIN
  import AuthLoginPopup from "@/components/auth-login-popup/auth-login-popup.uvue";
  // #endif
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
  import { useI18n, applyTabBarI18n, emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { orEmpty } from "@/utils/utsCoalesce.uts";
  import { apiAgentConversationCreate } from "@/servers/conversation";
  import { PendingChatDraft } from "@/types/interfaces/pendingChatDraft";
  import type { AgentSelectedComponentInfo } from "@/types/interfaces/agent";
  import { savePendingChatDraft, removePendingChatDraft } from "@/utils/pendingChatDraft";

  const { syncLanguageFromUser } = useI18n();
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const activeTab = ref<string>("recent");
  const isHomeSubmitting = ref<boolean>(false);
  const showExperienceNotice = ref<boolean>(true);
  // 分享标题
  const shareTitle = ref<string>("");
  const fallbackShareTitle = computed<string>((): string => t("Mobile.Nav.home"));
  // App：hover-class 不稳时用 touch 驱动按压态
  const loginBtnPressed = ref<boolean>(false);
  const onLoginBtnTouchStart = () => {
    loginBtnPressed.value = true;
  };
  const onLoginBtnTouchEnd = () => {
    loginBtnPressed.value = false;
  };

  const closeExperienceNotice = () => {
    showExperienceNotice.value = false;
  };

  const toAttachments = (files: any): UTSJSONObject[] => {
    const result: UTSJSONObject[] = [];
    const list = files as UTSJSONObject[] | null;
    if (list == null) return result;
    for (let i = 0; i < list.length; i++) {
      const file = list[i];
      const attachment = new UTSJSONObject();
      attachment["fileKey"] = `${file["key"] as string | null ?? ""}`;
      attachment["fileUrl"] = `${file["url"] as string | null ?? ""}`;
      attachment["fileName"] = `${file["name"] as string | null ?? ""}`;
      attachment["mimeType"] = `${file["type"] as string | null ?? ""}`;
      attachment["fileSize"] = file["size"] as number | null ?? 0;
      result.push(attachment);
    }
    return result;
  };

  const submitHomeChat = async (payload: any): Promise<void> => {
    if (isHomeSubmitting.value) return;
    const data = payload as UTSJSONObject;
    const agentId = data["agentId"] as number | null ?? 0;
    if (agentId <= 0) return;
    isHomeSubmitting.value = true;
    try {
      const params = new UTSJSONObject();
      params["agentId"] = agentId;
      params["devMode"] = false;
      const createRes = await apiAgentConversationCreate(params);
      if (apiResCode(createRes) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      const conversation = apiResData<any>(createRes) as UTSJSONObject | null;
      const conversationId = conversation != null ? (conversation["id"] as number | null ?? 0) : 0;
      if (conversationId <= 0) return;

      const draft = new PendingChatDraft();
      draft.createdAt = Date.now();
      draft.agentId = agentId;
      draft.conversationId = conversationId;
      draft.message = `${data["messageInfo"] as string | null ?? ""}`;
      const filesRaw = data["files"];
      draft.attachments = filesRaw != null
        ? toAttachments(filesRaw)
        : [] as UTSJSONObject[];
      const selectedComponentsRaw = data["selectedComponents"];
      if (selectedComponentsRaw != null) {
        draft.selectedComponents = selectedComponentsRaw as AgentSelectedComponentInfo[];
      }
      const skillIdsRaw = data["skillIds"];
      if (skillIdsRaw != null) {
        draft.skillIds = skillIdsRaw as number[];
      }
      draft.sandboxId = `${data["sandboxId"] as string | null ?? ""}`;
      draft.modelId = data["modelId"] as number | null ?? 0;
      const agentMode = data["agentMode"] as string | null;
      if (agentMode == "ask" || agentMode == "yolo") {
        draft.agentMode = agentMode;
      }
      savePendingChatDraft(draft);
      uni.navigateTo({
        url: "/subpackages/pages/agent-detail/agent-detail?id=" + agentId + "&conversationId=" + conversationId,
        fail: () => { removePendingChatDraft(conversationId); },
      });
    } catch (error) {
      console.error("[home-chat] 创建会话失败", error);
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    } finally {
      isHomeSubmitting.value = false;
    }
  };

  const handleHomeChatSubmit = (payload: any): void => { submitHomeChat(payload); };

  // 头部菜单ref
  const headerMenuRef = ref<any | null>(null);
  // 智能体列表组件ref（未登录）
  const agentListContentRef = ref<any | null>(null);
  // 首页内容组件ref（登录后：单列表吸顶）
  const homeContentRef = ref<any | null>(null);

  // 使用登录拦截 composable
  const {
    loginPopupRef,
    handleAgentClick: baseHandleAgentClick,
    checkAuthAndShowPopup,
    hasToken,
  } = useAuthInterceptor();

  // Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject；用 $callMethod 调 defineExpose 方法
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // 处理会话项点击
  const handleConversationClick = (item: any) => {
    const obj = item as UTSJSONObject;
    jumpToAgentDetailPage(obj["agentId"] as number, obj["id"] as number);
  };

  // 处理登录点击
  const handleLogin = () => {
    // #ifdef MP-WEIXIN
    callRefMethod(loginPopupRef.value, "open");
    // #endif

    // #ifdef H5 || WEB || APP
    goToLogin();
    // #endif
  };




  // 最近使用
  const handleAgentClickLast = (info: any) => {
    const infoObj = info as UTSJSONObject;
    const lastConvRaw = infoObj["lastConversationId"];
    const agentIdRaw = infoObj["agentId"];
    const agentId = agentIdRaw != null ? (agentIdRaw as number) : 0;
    if (lastConvRaw != null) {
      jumpToAgentDetailPage(agentId, lastConvRaw as number);
    } else {
      const nameRaw = infoObj["name"];
      const iconRaw = infoObj["icon"];
      const descRaw = infoObj["description"];
      const agentTypeRaw = infoObj["agentType"];
      baseHandleAgentClick({
        targetId: agentId,
        name: nameRaw != null ? `${nameRaw}` : "",
        agentType: agentTypeRaw != null ? `${agentTypeRaw}` : null,
        icon: iconRaw != null ? `${iconRaw}` : "",
        description: descRaw != null ? `${descRaw}` : "",
      });
    }
  };


  // 用户信息
  const userInfo = ref<UserInfo | null>(null);

  // 判断是否登录
  const isLoggedIn = ref<boolean>(false);

  // 包装 handleAgentClick 以适配 AgentInfo 类型
  const handleAgentClick = (info: any) => {
    // 检查登录状态，如果未登录则显示登录弹窗
    if (!isLoggedIn.value) {
      handleLogin();
      return;
    }
    const infoObj = info as UTSJSONObject;
    const agentIdRaw = infoObj["agentId"];
    const nameRaw = infoObj["name"];
    const iconRaw = infoObj["icon"];
    const descRaw = infoObj["description"];
    const agentTypeRaw = infoObj["agentType"];
    baseHandleAgentClick({
      targetId: agentIdRaw != null ? (agentIdRaw as number) : 0,
      name: nameRaw != null ? `${nameRaw}` : "",
      agentType: agentTypeRaw != null ? `${agentTypeRaw}` : null,
      icon: iconRaw != null ? `${iconRaw}` : "",
      description: descRaw != null ? `${descRaw}` : "",
    });
  };

  // 查询当前登录用户信息
  async function fetchUserInfo(): Promise<void> {
    const res = await apiUserInfo();
    if (res != null && apiResCode(res) == SUCCESS_CODE) {
      const rawData = apiResData<any>(res);
      userInfo.value = rawData != null ? new UserInfo(rawData as UTSJSONObject) : null;
      let lang = "";
      if (userInfo.value != null) {
        lang = userInfo.value.lang;
      }
      await syncLanguageFromUser(lang);
    }
  }

  // 设置分享标题
  async function setCurrentShareTitle(): Promise<void> {
    // 获取本地用户配置
    const tenantConfigRaw = uni.getStorageSync(TENANT_CONFIG_INFO);
    const tenantConfigInfoString = orEmpty(tenantConfigRaw);
    if (tenantConfigInfoString.length > 0) {
      try {
        const parsed = JSON.parse<UTSJSONObject>(tenantConfigInfoString);
        if (parsed != null) {
          const siteName = parsed["siteName"] as string | null;
          const siteDescription = parsed["siteDescription"] as string | null;
          let titleStr = "";
          if (siteName != null) {
            titleStr = siteName;
          }
          if (siteDescription != null) {
            titleStr = titleStr.length > 0
              ? titleStr + " " + siteDescription
              : siteDescription;
          }
          shareTitle.value = titleStr;
        }
      } catch (error) {
        console.error("获取本地用户配置失败:", error);
      }
    }
  }

  onLoad((options: any) => {
    // 检测是否为文件预览分享跳转
    // #ifdef MP-WEIXIN
    if (options?.cId && options?.fileProxyUrl) {
      // 跳转到文件预览页面
      // 注意：fileProxyUrl 在分享时已经被 encodeURIComponent 编码过了
      // 这里不需要再次编码，直接传递即可
      uni.navigateTo({
        url: `/subpackages/pages/file-preview-page/file-preview-page?cId=${options.cId}&fileProxyUrl=${encodeURIComponent(options.fileProxyUrl)}`,
      });
      return;
    }
    // #endif

    // 设置当前页面导航栏标题
    setCurrentPageNavigationBarTitle();

    // 设置分享标题
    setCurrentShareTitle();
  });

  // onShow 的异步逻辑抽出到命名函数，规避 async 回调返回 Promise 与 Unit 不匹配
  async function performOnShow(): Promise<void> {
    // 确保从新页面返回首页时清除残存的加载提示框
    uni.hideLoading();

    // 确保每次回到首页都刷新一次 TabBar 翻译，
    // 解决语言切换重载后 TabBar 对象可能未就绪导致 uni.setTabBarItem 失效的问题。
    applyTabBarI18n();

    const loggedIn = await hasToken();
    isLoggedIn.value = loggedIn;
    // 如果是登录状态，需要等待 home-content 初始化
    if (isLoggedIn.value) {
      await nextTick();
      fetchUserInfo();
      // 回到首页时刷新当前 tab 列表
      callRefMethod(homeContentRef.value, "loadData");
    }
  }
  onShow(() => {
    performOnShow();
  });

  // 处理搜索（异步逻辑抽出，规避模板事件 handler 直接 async）
  async function performSearch(): Promise<void> {
    // 检查登录状态，如果未登录则显示登录弹窗
    const ok = await checkAuthAndShowPopup();
    if (!ok) {
      return;
    }
    const currentUrl = getCurrentPagePath();

    uni.navigateTo({
      url:
        "/subpackages/pages/agent-search/agent-search?type=Home&backUrl=" +
        encodeURIComponent(currentUrl),
    });
  }
  const handleSearch = () => {
    performSearch();
  };

  // #ifdef MP-WEIXIN
  // 转发给朋友
  onShareAppMessage(() => {
    return {
      title: shareTitle.value.length > 0 ? shareTitle.value : fallbackShareTitle.value,
      path: "/pages/index/index",
    };
  });

  // 收藏
  onAddToFavorites(() => {
    return {
      title: shareTitle.value.length > 0 ? shareTitle.value : fallbackShareTitle.value,
    };
  });
  // #endif

  onHide(() => {
    // #ifndef APP-ANDROID
    callRefMethod(headerMenuRef.value, "closeDropdown");
    // #endif
  });
</script>

<style lang="scss" scoped>
  /* #ifdef MP-WEIXIN || APP-ANDROID */
  .experience-notice {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 72rpx;
    padding: 16rpx 24rpx;
    box-sizing: border-box;
    background-color: #fff9ea;

    &-icon,
    &-close {
      flex-shrink: 0;
    }

    &-icon {
      margin-right: 12rpx;
    }

    &-close {
      margin-left: 16rpx;
      padding: 4rpx;
    }

    /* #ifdef MP-WEIXIN */
    &-icon,
    &-close {
      color: #ff9a43;
      font-size: 32rpx;
      line-height: 40rpx;
    }
    /* #endif */

    &-text {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      color: #ff9a43;
      font-size: 28rpx;
      line-height: 40rpx;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  }
  /* #endif */
</style>

<!-- 在微信小程序编译后，scoped 会把选择器变成类似 page[data-v-xxx]，而小程序根节点 page 不会带这个属性，所以匹配不到，样式就“无效” -->
<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 || MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || MP-LARK || MP-KUAISHOU || MP-JD */
  page {
    height: 100%;
  }
  /* #endif */
</style>

<style lang="scss" scoped>
  .h-full {
    height: 100%;
    background-color: #ffffff;
  }

  .w-full {
    width: 100%;
  }

  .content-area {
    flex: 1;
    min-height: 0;
    width: 100%;
  }

  .icon-search-box {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 12rpx;
  }

  .login-btn-wrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 15rpx 20rpx;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 100rpx;
    margin-right: 8rpx;

    .login-btn-text {
      color: #333333;
      font-size: 26rpx;
      font-weight: 400;
    }
  }

  /* App：hover-class 须用独立顶层类名；勿用 &.active 嵌套（App 常匹配失败，H5 却正常） */
  .login-btn-hover {
    background-color: rgba(0, 0, 0, 0.1);
  }
</style>
