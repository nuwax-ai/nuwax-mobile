  data: ConversationMessageListParams,
): Promise<RequestResponse<MessageInfo[]>> {
  const res = await request({
    url: "/api/agent/conversation/message/list",
    method: "POST",
    data: buildConversationMessageListBody(data),
  });
  return res;
}
