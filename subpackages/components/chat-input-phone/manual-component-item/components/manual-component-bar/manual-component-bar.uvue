<template>
  <view class="manual-wrapper">
    <scroll-view
      class="manual-container"
      direction="horizontal"
      :scroll-x="true"
      :scroll-y="false"
      :scroll-with-animation="true"
      :show-scrollbar="false"
    >
      <view class="manual-scroll-content">
        <!-- 页面首页 -->
        <view
          v-if="props.showPageHomeVal"
          class="manual-box"
          @click="emit('onOpenPagePreview')"
        >
          <text class="icon iconfont"></text>
          <text class="text text-ellipsis">{{ t("Mobile.Common.pageHome") }}</text>
        </view>

        <!-- 工作台 -->
        <view v-if="props.isTaskAgentVal && props.showWorkspaceVal" class="manual-box" @click="emit('onOpenFileTree')">
          <text class="icon iconfont"></text>
          <text class="text text-ellipsis">{{ t("Mobile.Common.workspace") }}</text>
        </view>

        <!-- 自动/审批模式选择 -->
        <view
          v-if="props.isTaskAgentVal && props.allowChooseModeVal"
          class="manual-box manual-select"
          :class="{ disabled: props.readonlyVal }"
          @click="emit('openAgentModeDrawer')"
        >
          <text class="text text-ellipsis text--manual-select">{{ props.currentAgentModeLabel }}</text>
          <svg-icon name="icon-arrow-down" size="24" customClass="icon-arrow-down" />
        </view>

        <!-- 沙盒选择 -->
        <view v-if="props.isTaskAgentVal && props.readonlyVal == false" class="manual-group">
          <view
            v-if="props.isSandboxUnavailableVal == false && props.currentSandboxName.length > 0"
            class="manual-box manual-select"
            @click="emit('openSandboxDrawer')"
          >
            <text class="text text-ellipsis text--manual-select">{{ props.currentSandboxName }}</text>
            <svg-icon name="icon-arrow-down" size="24" customClass="icon-arrow-down" />
          </view>
          <view v-else class="manual-box manual-select disabled">
            <text class="text text-ellipsis text--manual-select">{{ props.sandboxDisabledTextVal }}</text>
          </view>
        </view>

        <!-- 模型选择 -->
        <view
          v-if="props.allowOtherModelVal"
          class="manual-box manual-select"
          @click="emit('openModelSelect')"
        >
          <text class="text text-ellipsis text--manual-select">{{ props.modelSelectLabelVal }}</text>
          <svg-icon name="icon-arrow-down" size="24" customClass="icon-arrow-down" />
        </view>

        <view
          v-for="item in props.manualComponentsVal"
          :key="item.id"
          class="manual-box"
          :class="{ active: isSelected(item) }"
          @click="handleSelectComponent(item)"
        >
          <text class="text text-ellipsis" :class="{ 'text--active': isSelected(item) }">{{ item.name }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts" setup>
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { AgentManualComponentInfo, AgentSelectedComponentInfo } from "@/types/interfaces/agent";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      showPageHomeVal?: boolean;
      isTaskAgentVal?: boolean;
      showWorkspaceVal?: boolean;
      allowChooseModeVal?: boolean;
      readonlyVal?: boolean;
      currentAgentModeLabel?: string;
      isSandboxUnavailableVal?: boolean;
      currentSandboxName?: string;
      sandboxDisabledTextVal?: string;
      allowOtherModelVal?: boolean;
      modelSelectLabelVal?: string;
      manualComponentsVal?: AgentManualComponentInfo[];
      selectedComponents?: AgentSelectedComponentInfo[];
    }>(),
    {
      showPageHomeVal: false,
      isTaskAgentVal: false,
      showWorkspaceVal: false,
      allowChooseModeVal: false,
      readonlyVal: false,
      currentAgentModeLabel: "",
      isSandboxUnavailableVal: false,
      currentSandboxName: "",
      sandboxDisabledTextVal: "",
      allowOtherModelVal: false,
      modelSelectLabelVal: "",
      manualComponentsVal: () => [],
      selectedComponents: () => [],
    },
  );

  const emit = defineEmits<{
    (e: "onOpenPagePreview"): void;
    (e: "onOpenFileTree"): void;
    (e: "openAgentModeDrawer"): void;
    (e: "openSandboxDrawer"): void;
    (e: "openModelSelect"): void;
    (e: "handleSelectComponent", item: AgentManualComponentInfo): void;
  }>();

  const handleSelectComponent = (item: AgentManualComponentInfo) => {
    emit("handleSelectComponent", item);
  };

  const isSelected = (item: AgentManualComponentInfo): boolean => {
    const list = props.selectedComponents;
    const len = list.length;
    for (let i = 0; i < len; i++) {
      if (list[i].id == item.id) {
        return true;
      }
    }
    return false;
  };

</script>

<style lang="scss" scoped>
  .manual-wrapper {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: 76rpx;
    /* #ifdef APP-IOS */
    height: 80rpx;
    overflow: visible;
    /* #endif */
  }

  .manual-container {
    width: 100%;
    height: 76rpx;
    flex-direction: row;
    /* #ifdef APP-IOS */
    height: 80rpx;
    /* #endif */
    /* #ifndef APP */
    scroll-behavior: smooth;
    /* #endif */
    /* #ifdef H5 || MP-WEIXIN */
    -webkit-overflow-scrolling: touch;
    /* #endif */
  }

  .manual-scroll-content {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    /* #ifdef APP-IOS */
    height: 80rpx;
    /* #endif */
    /* #ifdef H5 */
    width: max-content;
    /* #endif */
  }

  .manual-group {
    display: flex;
    flex-direction: row;
  }

  .manual-box {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    height: 76rpx;
    max-width: 280rpx;
    padding: 16rpx 24rpx;
    margin-right: 16rpx;
    border-radius: 16rpx;
    border: 2rpx solid #f0f0f0;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .icon {
    font-size: 32rpx;
    color: #6b7280;
    transition: color 0.3s ease;
    margin-right: 6rpx;
  }

  .text {
    width: 100%;
    color: rgba(21, 23, 31, 0.7);
    font-size: 28rpx;
    font-weight: 400;
  }

  // vapor: 以下子节点修饰类提为顶层单类，与 .icon/.text 基础规则同特异性以覆盖 color
  .icon--active {
    color: #4f46e5;
  }

  .text--active {
    color: #5147ff;
  }

  .text--manual-select {
    text-align: center;
    flex: 1;
    min-width: 0;
  }

  .icon-arrow-down {
    font-size: 24rpx;
    margin-left: -4rpx;
    color: rgba(21, 23, 31, 0.4);
  }

  // vapor: 修饰类从 .manual-box 内 hoist 为顶层单类（原 &.active / &.manual-select / &.disabled 复合选择器，
  // 作用于 .manual-box 元素本身，与 .manual-box 同特异性）
  .active {
    background: #f2f2ff;
    border-color: #f2f2ff;
  }

  .manual-select {
    border-color: #eeeeee;
    min-width: 100rpx;
    max-width: 300rpx;
    flex-shrink: 0;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  // disabled 仅与 manual-select 同元素出现；原 &.manual-select.disabled（pointer-events:auto）
  // 与 &.disabled（pointer-events:none）合并，取高特异性规则的 auto（none 从未生效）。
  // 原 disabled .text 的 color 与基础 .text 一致，省略。
  .disabled {
    opacity: 0.6;
    background: #f5f5f5;
    pointer-events: auto;
  }
</style>
