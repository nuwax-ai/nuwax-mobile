<template>
  <view class="container relative flex flex-col">
    <custom-nav-bar :title="t('Mobile.Terminal.groupMembers')" className="border-b" hasSafetyZone showBack />

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <view class="tip-box">
        <text class="tip-text">{{ t("Mobile.Terminal.groupManageTip") }}</text>
      </view>

      <!-- 当前组员 -->
      <view class="field-label">{{ t("Mobile.Terminal.currentMembers") }}</view>
      <view class="card-group">
        <view v-if="memberList.length == 0 && !loading" class="empty-row">
          <text class="empty-text">{{ t("Mobile.Terminal.noMembers") }}</text>
        </view>
        <view class="row-item" v-for="member in memberList" :key="member.agentId">
          <view class="row-avatar">
            <image v-if="isIconUrl(member.icon)" class="row-avatar-img" :src="member.icon" mode="aspectFill" />
            <text v-else class="row-avatar-emoji">{{ member.icon != "" ? member.icon : "🤖" }}</text>
          </view>
          <view class="row-info">
            <text class="row-title">{{ member.name }}</text>
            <text class="row-desc">{{ member.desc }}</text>
          </view>
          <view class="remove-btn" hover-class="remove-btn-active" @click="handleRemove(member.agentId)">
            <text class="remove-text">{{ t("Mobile.Terminal.remove") }}</text>
          </view>
        </view>
      </view>

      <!-- 添加智能体（候选自最近使用，已过滤在组成员） -->
      <view class="field-label">{{ t("Mobile.Terminal.addAgent") }}</view>
      <view class="card-group">
        <view v-if="candidateList.length == 0 && !loading" class="empty-row">
          <text class="empty-text">{{ t("Mobile.Terminal.noCandidates") }}</text>
        </view>
        <view
          class="row-item"
          v-for="agent in candidateList"
          :key="agent.agentId"
          hover-class="row-item-active"
          @click="handleAdd(agent.agentId)"
        >
          <view class="row-avatar row-avatar-add">
            <image v-if="isIconUrl(agent.icon)" class="row-avatar-img" :src="agent.icon" mode="aspectFill" />
            <text v-else class="row-avatar-plus">+</text>
          </view>
          <view class="row-info">
            <text class="row-title">{{ agent.name }}</text>
            <text class="row-desc">{{ agent.desc }}</text>
          </view>
          <text class="add-text">{{ t("Mobile.Terminal.add") }}</text>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- 完成（固定底部安全栏） -->
    <view class="done-footer">
      <view class="done-btn" hover-class="done-btn-active" @click="handleDone">
        <text class="done-text">{{ t("Mobile.Terminal.done") }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiGetGroupMembers, apiAddGroupMember } from "@/servers/terminalAgent";
  import { apiUserUsedAgentList } from "@/servers/agentDev";
  import { GroupMemberAddParams } from "@/types/interfaces/terminalGroupMember";
  import { ListParams } from "@/types/interfaces/common";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import { SUCCESS_CODE } from "@/constants/codes.constants";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 列表行展示模型（组员 / 候选共用） */
  class MemberRow {
    agentId: number = 0;
    name: string = "";
    desc: string = "";
    icon: string = "";
    constructor(agentId: number, name: string, desc: string, icon: string) {
      this.agentId = agentId;
      this.name = name;
      this.desc = desc;
      this.icon = icon;
    }
  }

  /** 设备宿主智能体 ID（路由入参） */
  const hostAgentId = ref<number>(0);
  const memberList = ref<MemberRow[]>([] as MemberRow[]);
  const candidateList = ref<MemberRow[]>([] as MemberRow[]);
  const loading = ref<boolean>(false);
  /** 防止连续点击添加 */
  const adding = ref<boolean>(false);

  /** icon 是否为图片 URL（否则按 emoji / 占位文本渲染） */
  const isIconUrl = (icon: string): boolean => {
    if (icon == "") return false;
    return icon.indexOf("http://") == 0 || icon.indexOf("https://") == 0 || icon.indexOf("/") == 0;
  };

  const readStr = (obj: UTSJSONObject, key: string): string => {
    const v = obj[key];
    return v != null ? `${v}` : "";
  };

  const readNum = (obj: UTSJSONObject, key: string): number => {
    const v = obj[key];
    if (v == null) return 0;
    const n = parseFloat(`${v}`);
    return !isNaN(n) ? (n as number) : 0;
  };

  /**
   * 将组员接口项转为行模型
   * @param src 接口 UTSJSONObject
   */
  const mapMember = (src: UTSJSONObject): MemberRow => {
    return new MemberRow(
      readNum(src, "agentId"),
      readStr(src, "name"),
      readStr(src, "description"),
      readStr(src, "icon"),
    );
  };

  /**
   * 拉取当前组员列表
   * @returns 组员 agentId 集合，供候选过滤
   */
  const fetchMembers = async (): Promise<number[]> => {
    const ids: number[] = [] as number[];
    if (hostAgentId.value <= 0) return ids;
    try {
      const res = await apiGetGroupMembers(hostAgentId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        const rows: MemberRow[] = [] as MemberRow[];
        for (let i = 0; i < arr.length; i++) {
          const row = mapMember(arr[i]);
          if (row.agentId > 0) {
            rows.push(row);
            ids.push(row.agentId);
          }
        }
        memberList.value = rows;
      } else {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.loadMembersFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchMembers error", e);
      uni.showToast({ title: t("Mobile.Terminal.loadMembersFailed"), icon: "none" });
    }
    return ids;
  };

  /**
   * 拉取最近使用智能体作为候选，并排除已在组内的成员
   * @param memberIds 已在组内的 agentId
   */
  const fetchCandidates = async (memberIds: number[]): Promise<void> => {
    try {
      const params = new ListParams();
      params.size = 50;
      params.pageIndex = 1;
      const res = await apiUserUsedAgentList(params);
      if (apiResCode(res) == SUCCESS_CODE) {
        // used/list 直接返回数组（与首页最近使用一致）
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        const rows: MemberRow[] = [] as MemberRow[];
        for (let i = 0; i < arr.length; i++) {
          const src = arr[i];
          const aid = readNum(src, "agentId");
          if (aid <= 0) continue;
          // 宿主自身与已在组内的不进候选
          if (aid == hostAgentId.value) continue;
          let inGroup = false;
          for (let j = 0; j < memberIds.length; j++) {
            if (memberIds[j] == aid) {
              inGroup = true;
              break;
            }
          }
          if (inGroup) continue;
          rows.push(
            new MemberRow(aid, readStr(src, "name"), readStr(src, "description"), readStr(src, "icon")),
          );
        }
        candidateList.value = rows;
      } else {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.loadCandidatesFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchCandidates error", e);
      uni.showToast({ title: t("Mobile.Terminal.loadCandidatesFailed"), icon: "none" });
    }
  };

  /** 并行刷新组员 + 候选 */
  const refreshAll = async (): Promise<void> => {
    loading.value = true;
    uni.showLoading({ title: "", mask: true });
    try {
      const memberIds = await fetchMembers();
      await fetchCandidates(memberIds);
    } finally {
      loading.value = false;
      uni.hideLoading();
    }
  };

  /** 移除：后端暂无删除接口，仅提示 */
  const handleRemove = (_agentId: number) => {
    uni.showToast({ title: t("Mobile.Terminal.removeNotSupported"), icon: "none" });
  };

  /**
   * 添加组员
   * @param targetAgentId 要加入的智能体 ID
   */
  const handleAdd = async (targetAgentId: number) => {
    if (adding.value || hostAgentId.value <= 0 || targetAgentId <= 0) return;
    adding.value = true;
    try {
      const body = new GroupMemberAddParams();
      body.agentId = hostAgentId.value;
      body.targetAgentId = targetAgentId;
      const res = await apiAddGroupMember(body);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Terminal.added"), icon: "none" });
        await refreshAll();
      } else {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.addFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("handleAdd error", e);
      uni.showToast({ title: t("Mobile.Terminal.addFailed"), icon: "none" });
    } finally {
      adding.value = false;
    }
  };

  const handleDone = () => {
    uni.navigateBack({ delta: 1 });
  };

  onLoad((options: any) => {
    setCurrentPageNavigationBarTitle();
    let aid = 0;
    if (options != null) {
      const optObj = options as UTSJSONObject;
      const raw = optObj["agentId"];
      if (raw != null && `${raw}`.length > 0) {
        const parsed = parseFloat(`${raw}`);
        if (!isNaN(parsed) && parsed > 0) {
          aid = parsed as number;
        }
      }
    }
    if (aid <= 0) {
      uni.showToast({ title: t("Mobile.Terminal.agentIdMissing"), icon: "none" });
      setTimeout(() => {
        uni.navigateBack({ delta: 1 });
      }, 500);
      return;
    }
    hostAgentId.value = aid;
    refreshAll();
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  .tip-box {
    padding: 24rpx 32rpx 8rpx;
    display: flex;
    align-items: center;
    justify-content: center;

    .tip-text {
      font-size: 28rpx;
      color: #666666;
    }
  }

  .field-label {
    font-size: 24rpx;
    color: #666666;
    padding: 20rpx 32rpx 12rpx;
  }

  .card-group {
    background-color: #ffffff;
    border-radius: 16rpx;
    margin: 0 24rpx;
    overflow: hidden;
  }

  .empty-row {
    padding: 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;

    .empty-text {
      font-size: 26rpx;
      color: #999999;
    }
  }

  .row-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 24rpx 32rpx;
    border-bottom: 2rpx solid #f8f8f8;

    &:last-child {
      border-bottom-width: 0;
    }

    &-active {
      background-color: rgba(12, 20, 102, 0.04);
    }

    .row-avatar {
      width: 72rpx;
      height: 72rpx;
      border-radius: 12rpx;
      background-color: #fafafa;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 24rpx;
      overflow: hidden;

      .row-avatar-emoji {
        font-size: 36rpx;
      }

      .row-avatar-img {
        width: 72rpx;
        height: 72rpx;
      }

      &.row-avatar-add {
        .row-avatar-plus {
          font-size: 40rpx;
          color: #999999;
        }
      }
    }

    .row-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;

      .row-title {
        font-size: 30rpx;
        font-weight: 500;
        color: #1a1a1a;
      }

      .row-desc {
        font-size: 24rpx;
        color: #666666;
        margin-top: 4rpx;
      }
    }

    .remove-btn {
      padding: 8rpx 20rpx;
      border-radius: 24rpx;
      background-color: rgba(250, 81, 81, 0.08);

      &-active {
        opacity: 0.7;
      }

      .remove-text {
        font-size: 24rpx;
        color: #fa5151;
        font-weight: 500;
      }
    }

    .add-text {
      font-size: 24rpx;
      color: #07c160;
      font-weight: 500;
    }
  }

  /* 完成按钮固定底部安全栏 */
  .done-footer {
    flex-shrink: 0;
    padding: 16rpx 24rpx 56rpx;
    background-color: #f7f7f7;
  }

  .done-btn {
    padding: 26rpx 0;
    border-radius: 48rpx;
    background-color: #5147ff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, transform 0.15s ease;

    &-active {
      opacity: 0.85;
      transform: scale(0.98);
    }

    .done-text {
      font-size: 32rpx;
      color: #ffffff;
      font-weight: 600;
    }
  }

  .bottom-space {
    height: 40rpx;
  }
</style>
