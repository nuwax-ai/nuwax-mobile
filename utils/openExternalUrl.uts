// #ifdef APP-ANDROID
import { openPayUrlNative } from "@/uni_modules/nuwax-android-native-pay";
// #endif

// #ifdef APP-HARMONY
import type { Want } from "@kit.AbilityKit";
// #endif

// #ifdef APP-IOS
/**
 * 从 App Store 网页地址里取出数字 id。
 * 例：https://apps.apple.com/cn/app/id6802498764
 */
function appStoreIdFromUrl(url: string): string {
  const lower = url.toLowerCase();
  if (lower.indexOf("apps.apple.com") < 0 && lower.indexOf("itunes.apple.com") < 0) {
    return "";
  }
  const marker = "/id";
  const idIndex = lower.lastIndexOf(marker);
  if (idIndex < 0) {
    return "";
  }
  let id = "";
  const start = idIndex + marker.length;
  for (let i = start; i < url.length; i++) {
    const codeRaw = url.charCodeAt(i);
    if (codeRaw == null) {
      break;
    }
    const code = codeRaw as number;
    if (code < 48 || code > 57) {
      break;
    }
    id += url.charAt(i);
  }
  return id;
}

/**
 * 只替换协议，保留 apps.apple.com 和地区路径。
 * itms-apps://itunes.apple.com 在较新的 iOS 上不会进入 App Store。
 */
function iosAppStoreUrl(url: string): string {
  if (appStoreIdFromUrl(url).length == 0) {
    return "";
  }
  const httpsScheme = "https://";
  const httpScheme = "http://";
  if (url.startsWith(httpsScheme)) {
    return "itms-apps://" + url.substring(httpsScheme.length);
  }
  if (url.startsWith(httpScheme)) {
    return "itms-apps://" + url.substring(httpScheme.length);
  }
  return "";
}
// #endif

/**
 * 使用系统浏览器打开外部链接。
 * 更新地址由租户配置下发，入口仅允许 HTTP(S)。
 * iOS 的 App Store 网页链改为 itms-apps://apps.apple.com/... 再打开。
 */
export function openExternalUrl(url: string): Promise<void> {
  if (!url.startsWith("https://") && !url.startsWith("http://")) {
    return Promise.reject(new Error());
  }

  // #ifdef APP-ANDROID
  return openPayUrlNative(url).then((): void => {});
  // #endif

  // #ifdef APP-IOS
  const storeUrl = iosAppStoreUrl(url);
  return new Promise<void>((resolve, reject) => {
    const openOnce = (targetUrl: string, fallbackUrl: string): void => {
      const target = NSURL.URLWithString(targetUrl);
      if (target == null) {
        if (fallbackUrl.length > 0) {
          openOnce(fallbackUrl, "");
          return;
        }
        reject(new Error());
        return;
      }
      // options 传 null。空 Map 在 UTS 桥接后可能被当成 universalLinksOnly，
      // apps.apple.com 不是本 App 的通用链接，系统会直接返回打不开。
      UIApplication.shared.open(target, null, (success: boolean): void => {
        if (success) {
          resolve();
        } else if (fallbackUrl.length > 0) {
          openOnce(fallbackUrl, "");
        } else {
          reject(new Error());
        }
      });
    };
    if (storeUrl.length > 0) {
      openOnce(storeUrl, url);
    } else {
      openOnce(url, "");
    }
  });
  // #endif

  // #ifdef APP-HARMONY
  const context = UTSHarmony.getUIAbilityContext();
  const want: Want = {
    action: "ohos.want.action.viewData",
    entities: ["entity.system.browsable"],
    uri: url,
  };
  return context.startAbility(want);
  // #endif

  // #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
  return Promise.reject(new Error());
  // #endif
}
