/**
 * 录音详情转写帧。只给录音详情播放器使用。
 */

/** 一段可播放的录音文件。多段按 segmentIndex 顺序连播。 */
export class VoiceNoteAudioPart {
  audioUrl: string = "";
  durationMs: number = 0;
  segmentIndex: number = 0;

  constructor(audioUrl: string, durationMs: number, segmentIndex: number) {
    this.audioUrl = audioUrl;
    this.durationMs = durationMs;
    this.segmentIndex = segmentIndex;
  }
}

/** 单条转写句子 */
export class VoiceNoteTranscriptFrame {
  seq: number = 0;
  speaker: string = "";
  text: string = "";
  /** 片段起始毫秒（相对录音开始） */
  startMs: number = 0;
  /** 片段结束毫秒（相对录音开始） */
  endMs: number = 0;
  /** 监控：所属音频段的采集起点；会议仍使用整场 startMs/endMs。 */
  startedAt: string = "";

  constructor(seq: number, speaker: string, text: string, startMs: number, endMs: number, startedAt: string = "") {
    this.seq = seq;
    this.speaker = speaker;
    this.text = text;
    this.startMs = startMs;
    this.endMs = endMs;
    this.startedAt = startedAt;
  }
}
