<template>
  <!--
    V2 轨迹工具事件行（对齐 PC ProcessNodeRow）：图标 + 动作词 + 目标/文件徽标链 + meta + 状态。
    整行点击 = 展开/收起内联详情（tool-node-detail）；无详情渲染静态行不伪装可点。
  -->
  <view class="node-row-wrapper" :class="{ 'is-failed': isFailed }">
    <view class="node-row" @tap="onRowTap">
      <text class="iconfont node-kind-icon" :class="[kindIconClass, isFailed ? 'is-failed-icon' : '']" />
      <text class="node-title">{{ actionText }}</text>
      <!-- 文件类动作：灰徽标 + 文件名链（对齐 PC FileResourceLink inline）；多文件先显计数 -->
      <template v-if="fileBadgeViews.length > 0">
        <text v-if="fileBadgeViews.length > 1" class="node-summary">{{ targetText }}</text>
        <view class="node-file-links">
          <view
            v-for="(fileView, fileIndex) in fileBadgeViews"
            :key="fileIndex"
            class="tool-file-link"
          >
            <text class="tool-file-badge">{{ fileView.label }}</text>
            <text class="tool-file-name">{{ fileView.name }}</text>
          </view>
        </view>
      </template>
      <text v-else-if="targetText.length > 0" class="node-summary">{{ targetText }}</text>
      <text v-if="row.meta.length > 0" class="node-meta">{{ row.meta }}</text>
      <view v-if="isRunning" class="node-status-icon">
        <text class="iconfont icon-Loader node-spinner" />
      </view>
      <text v-else-if="isFailed" class="iconfont icon-waring node-failed-icon" />
      <view v-if="isPageType" class="node-page-action" @tap.stop.prevent="openPreviewPage">
        <text class="iconfont icon-eye-open" />
      </view>
      <text
        v-if="hasDetail"
        class="iconfont icon-a-Chevrondown node-disclosure"
        :class="{ 'node-disclosure-open': expanded }"
      />
    </view>
    <view v-if="expanded && hasDetail" class="node-detail">
      <tool-node-detail :row="row" />
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    toolTraceActionI18nKey,
    type TraceToolRow,
  } from "@/subpackages/components/ai-msg/conversationTrace.uts";
  import {
    buildFileBadgeViews,
    type ToolFileBadgeView,
  } from "@/subpackages/components/work-trace/toolFilePresentation.uts";
  import {
    hasToolNodeDetail,
    normalizeToolNodeDetail,
  } from "@/subpackages/components/work-trace/toolNodeDetail.uts";
  import toolNodeDetail from "@/subpackages/components/work-trace/tool-node-detail.uvue";
  import { traceKindIconClass } from "@/subpackages/components/work-trace/traceIcons.uts";
  import { useI18n, toI18nParams } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, undefined, "");

  const props = withDefaults(
    defineProps<{
      /** 投影产出的工具行数据。 */
      row?: TraceToolRow | null;
      /** 行内联详情展开状态（托管在 ai-msg 折叠状态机）。 */
      expanded?: boolean;
    }>(),
    {
      row: null,
      expanded: false,
    },
  );

  const emit = defineEmits<{
    toggle: [];
  }>();

  const isRunning = computed((): boolean => props.row != null && props.row!.status == "running");
  const isFailed = computed((): boolean => props.row != null && props.row!.status == "failed");

  const kindIconClass = computed((): string => {
    const row = props.row;
    return traceKindIconClass(row == null ? "generic" : row!.kind);
  });

  const actionText = computed((): string => {
    const row = props.row;
    if (row == null) return "";
    return t(toolTraceActionI18nKey(row!.kind, row!.status, row!.isCreate));
  });

  /** 多文件编辑显示「N 个文件」，其余显示行目标摘要。 */
  const targetText = computed((): string => {
    const row = props.row;
    if (row == null) return "";
    if (row!.kind == "file-edit" && row!.fileCount > 1) {
      const params = new Map<string, string | number>();
      params.set("count", row!.fileCount);
      return tFn(
        "Mobile.Chat.WorkTrace.toolTargetFiles",
        toI18nParams(params),
        "",
      );
    }
    return row!.target;
  });

  /** 文件徽标链视图（预计算，避免模板函数每帧重算）；非文件类动作为空走原 target。 */
  const fileBadgeViews = computed((): ToolFileBadgeView[] => {
    const row = props.row;
    if (row == null) return [] as ToolFileBadgeView[];
    const files = row!.files;
    if (files == null || files.length == 0) {
      return [] as ToolFileBadgeView[];
    }
    return buildFileBadgeViews(files);
  });

  /** 是否存在可展开的有效详情（静态行不渲染箭头、不伪装可点）。 */
  const hasDetail = computed((): boolean => {
    const row = props.row;
    if (row == null) return false;
    const detail = normalizeToolNodeDetail(row!.kind, row!.processing, row!.status);
    return hasToolNodeDetail(detail);
  });

  const isPageType = computed((): boolean => {
    const row = props.row;
    return row != null && row!.componentType == "Page";
  });

  function openPreviewPage(): void {
    const row = props.row;
    if (row == null || row!.processing == null) return;
    uni.$emit("page_preview_executing", row!.processing);
  }

  function onRowTap(): void {
    if (hasDetail.value != true) {
      return;
    }
    emit("toggle");
  }
</script>

<style lang="scss" scoped>
  // 对齐 PC hairline 色板与 13px→26rpx 行字号体系
  $hairline: rgba(5, 5, 5, 0.08);
  $text-main: rgba(0, 0, 0, 0.88);
  $text-secondary: rgba(5, 5, 5, 0.65);
  $text-tertiary: rgba(5, 5, 5, 0.45);
  $text-quaternary: rgba(5, 5, 5, 0.25);
  $color-error: #ff4d4f;
  $color-primary: #6a5af9;
  $mono: "Monaco", "Menlo", "Ubuntu Mono", monospace;

  .node-row-wrapper {
    min-width: 0;

    &.is-failed {
      .node-title {
        color: $color-error;
      }
    }
  }

  .node-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14rpx;
    width: 100%;
    min-height: 60rpx;
    padding: 0;
    color: $text-main;
    font-size: 26rpx;
    line-height: 40rpx;
  }

  .node-kind-icon {
    width: 28rpx;
    flex-shrink: 0;
    font-size: 28rpx;
    color: $text-tertiary;
    line-height: 40rpx;

    &.is-failed-icon {
      color: $color-error;
    }
  }

  .node-title {
    max-width: 42%;
    overflow: hidden;
    flex-shrink: 0;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node-summary {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    color: $text-tertiary;
    font-size: 26rpx;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node-meta {
    flex-shrink: 0;
    color: $text-tertiary;
    font-family: $mono;
    font-size: 24rpx;
    line-height: 40rpx;
  }

  .node-status-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32rpx;
    height: 32rpx;
  }

  .node-spinner {
    font-size: 26rpx;
    color: $color-primary;
    animation: node-row-spin 1s linear infinite;
  }

  .node-failed-icon {
    flex-shrink: 0;
    font-size: 26rpx;
    color: #ffcb00;
    line-height: 34rpx;
  }

  .node-page-action {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44rpx;
    height: 44rpx;

    .iconfont {
      font-size: 28rpx;
      color: $text-tertiary;
    }
  }

  // 箭头：-90°=收起 / 0°=展开（对齐 PC）；触屏无 hover 常显
  .node-disclosure {
    flex-shrink: 0;
    font-size: 20rpx;
    color: $text-quaternary;
    transform: rotate(-90deg);
    transition: transform 0.18s ease, color 0.18s ease;

    &-open {
      transform: rotate(0deg);
      color: $text-secondary;
    }
  }

  // 行内联展开详情区：对齐 PC .node-detail（margin-left 21px≈42rpx，限高内滚由内部 pre 承担）
  .node-detail {
    margin: 4rpx 12rpx 16rpx 42rpx;
    min-width: 0;
    color: $text-main;
  }

  // 文件徽标链（inline 变体：徽标+文件名，无目录段）
  .node-file-links {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    white-space: nowrap;
  }

  .tool-file-link {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 10rpx;
    margin-right: 16rpx;
    max-width: 100%;
  }

  .tool-file-badge {
    flex-shrink: 0;
    padding: 0 8rpx;
    border-radius: 6rpx;
    background-color: #8a8f98;
    color: #ffffff;
    font-family: $mono;
    font-weight: 600;
    font-size: 20rpx;
    line-height: 32rpx;
  }

  .tool-file-name {
    min-width: 0;
    overflow: hidden;
    color: $text-main;
    font-family: $mono;
    font-size: 24rpx;
    line-height: 34rpx;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @keyframes node-row-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
</style>
