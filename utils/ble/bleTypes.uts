/**
 * BLE 通讯适配层公共类型定义（平台无关）
 *
 * 说明：BLE 层的特征值 `value` 为 ArrayBuffer（uni 回调直接给），不走 JSON，
 * 因此此处无 UTSJSONObject / `as Map` 强转坑。设备/服务/特征列表在各实现的内部
 * 用 `UTSJSONObject.keys()` + 方括号取值后，再构造为下面的强类型 interface。
 */

/** 扫描到的 BLE 设备 */
export class BleDeviceInfo {
  /** 平台设备标识（Android=MAC，iOS=CoreBluetooth UUID，鸿蒙=addr） */
  deviceId: string;
  /** 广播名（可能为空串） */
  name: string;
  /** 信号强度 */
  rssi: number;
  /** 广播原始数据转 hex（用于解析厂商字段/SN，可选） */
  advertisDataHex: string;
  constructor(deviceId: string, name: string, rssi: number, advertisDataHex: string = '') {
    this.deviceId = deviceId;
    this.name = name;
    this.rssi = rssi;
    this.advertisDataHex = advertisDataHex;
  }
}

/** BLE 服务 */
export class BleServiceInfo {
  uuid: string;
  isPrimary: boolean;
  constructor(uuid: string, isPrimary: boolean) {
    this.uuid = uuid;
    this.isPrimary = isPrimary;
  }
}

/** BLE 特征值 */
export class BleCharacteristicInfo {
  uuid: string;
  /** 归属 service uuid（uni 不直接回带，发现时关联） */
  serviceUuid: string;
  canRead: boolean;
  canWrite: boolean;
  canNotify: boolean;
  constructor(uuid: string, serviceUuid: string, canRead: boolean, canWrite: boolean, canNotify: boolean) {
    this.uuid = uuid;
    this.serviceUuid = serviceUuid;
    this.canRead = canRead;
    this.canWrite = canWrite;
    this.canNotify = canNotify;
  }
}

/** 连接状态 */
export type BleConnectionState = 'connected' | 'disconnected';

/**
 * 统一 BLE 错误（配网层据此映射用户可读文案）
 */
export class BleError {
  /**
   * 业务码：
   * 'BT_OFF' 蓝牙未开 | 'NO_PERMISSION' 无权限 | 'SCAN_TIMEOUT' 扫描超时 |
   * 'CONNECT_FAIL' 连接失败 | 'WRITE_FAIL' 写失败 | 'NOTIFY_FAIL' 订阅失败 |
   * 'READ_FAIL' 读失败 | 'DISCONNECTED' 连接断开 | 'UNSUPPORTED' 平台不支持 |
   * 'TIMEOUT' 操作超时 | 'UNKNOWN' 未知
   */
  code: string;
  /** 技术信息（调试/日志用，不直接上屏） */
  message: string;
  /** 平台原始错误码，无则 0 */
  nativeCode: number;
  constructor(code: string, message: string, nativeCode: number = 0) {
    this.code = code;
    this.message = message;
    this.nativeCode = nativeCode;
  }
}

/** notify/read 数据回调（value 为原始字节） */
export type BleNotifyCallback = (
  deviceId: string,
  serviceUuid: string,
  charUuid: string,
  value: ArrayBuffer,
) => void;

/** 连接状态回调（unexpected=true 表示意外断开） */
export type BleConnectionStateCallback = (
  deviceId: string,
  state: BleConnectionState,
  unexpected: boolean,
) => void;

/** 扫描发现设备回调 */
export type BleDeviceFoundCallback = (device: BleDeviceInfo) => void;

/**
 * 构造一个 BleError（便捷工厂，避免各处重复写字面量）
 */
export function createBleError(
  code: string,
  message: string,
  nativeCode: number = 0,
): BleError {
  return new BleError(code, message, nativeCode);
}
