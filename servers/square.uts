// 获取广场分类列表
export async function apiPublishedCategoryList(): Promise<RequestResponse<SquareCategoryInfo[]>> {
  const res = await request({
    url: '/api/published/category/list',
    method: 'GET',
  });
  return res;
}

/**
 * 对话框智能体(ChatBox)分类列表：已发布分类接口中 type=ChatBox 根节点的 children。
 * 首页会话框类型 pill 数据源（对齐 PC fetchChatboxCategories，与推荐管理同源）。
 */
export async function fetchChatboxCategories(): Promise<SquareCategoryInfo[]> {
  try {
    const res = await apiPublishedCategoryList();
    if (apiResCode(res) != SUCCESS_CODE) return [] as SquareCategoryInfo[];
    // API 边界统一 JSON 化：Android UTSArray / iOS 桥接数组 / H5 Array 不能安全互相强转。
    const dataRaw = apiResData<any>(res);
    const dataJson = dataRaw != null ? JSON.stringify(dataRaw) : "";
    const parsedData = dataJson.length > 0 ? JSON.parse(dataJson) : null;
    const rows: any[] = parsedData != null && Array.isArray(parsedData) ? (parsedData as any[]) : ([] as any[]);
    const result = [] as SquareCategoryInfo[];
    for (let i = 0; i < rows.length; i++) {
      const item = rows[i] as UTSJSONObject;
      const typeRaw = item["type"];
      if (typeRaw == null || `${typeRaw}` != "ChatBox") continue;
      // ChatBox 根的 children 即首页类型 pill（实测：对话任务/项目开发/AI 教育等）
      const childrenRaw = item["children"];
      const childrenJson = childrenRaw != null ? JSON.stringify(childrenRaw) : "";
      const parsedChildren = childrenJson.length > 0 ? JSON.parse(childrenJson) : null;
      const children: any[] = parsedChildren != null && Array.isArray(parsedChildren) ? (parsedChildren as any[]) : ([] as any[]);
      for (let j = 0; j < children.length; j++) {
        const child = children[j] as UTSJSONObject;
        const category = new SquareCategoryInfo();
        const keyRaw = child["key"];
        const labelRaw = child["label"];
        category.key = keyRaw != null ? `${keyRaw}` : "";
        category.label = labelRaw != null ? `${labelRaw}` : "";
        // ChatBox 根下的子项 type 同为 ChatBox；禁止字符串 as 枚举（Android ClassCastException）
        category.type = SquareAgentTypeEnum.ChatBox;
        const iconRaw = child["icon"];
        if (iconRaw != null && `${iconRaw}`.length > 0) category.icon = `${iconRaw}`;
        if (category.key.length > 0 && category.label.length > 0) result.push(category);
      }
      break;
    }
    return result;
  } catch (_error) {
    console.warn("[square] fetchChatboxCategories failed:", _error);
    return [] as SquareCategoryInfo[];
  }
}

// 获取已发布的智能体详情
