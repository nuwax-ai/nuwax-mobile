/** 页面在 onLoad 捕获 requestId；异步完成时必须使用该快照，不能重读当前 URL。 */
export function readOfflineH5RequestId(options: UTSJSONObject): string {
  const raw = options["offlineH5RequestId"];
  return raw != null ? `${raw}` : "";
}

export function notifyOfflineH5PageReady(requestId: string): void {
  // #ifdef H5 || WEB
  const bridge = (window as any).OfflineH5Bridge;
  if (requestId.length > 0 && bridge != null) bridge.pageReady(requestId);
  // #endif
}

/** 从当前路由解析并上报就绪。H5 页面组件被 keep-alive 缓存时切换会话不会重新 onLoad，
 * 只走 activated/onShow；此时必须现取路由里的请求身份，不能用 onLoad 快照。 */
export function notifyOfflineH5PageReadyFromLocation(): void {
  // #ifdef H5 || WEB
  const bridge = (window as any).OfflineH5Bridge;
  if (bridge == null) return;
  const requestId = bridge.requestId();
  if (requestId.length > 0) {
    // 路由摘要用于比对容器请求与页面路由；凭据参数必须先脱敏，日志不落 token。
    const routeSummary = (window as any).location.hash
      .substring(0, 200)
      .replace(/([?&])accessToken=[^&]*/g, '$1accessToken=***');
    bridge.debug(requestId, 'show-route:' + routeSummary);
    bridge.pageReady(requestId);
  }
  // #endif
}
