/**
 * 新建待办的责任人草稿。
 * 弹层和负责人页共用这一份，避免把类数组穿过组件事件（Android 上容易丢字段）。
 */

export class TodoAssignee {
  userId: string = "";
  name: string = "";
  avatar: string = "";
  /** 当前登录用户。接口返回前也可能为 true。 */
  self: boolean = false;
}

let people: TodoAssignee[] = [];
let completeMode = "single";

function copyPerson(source: TodoAssignee): TodoAssignee {
  const item = new TodoAssignee();
  item.userId = source.userId;
  item.name = source.name;
  item.avatar = source.avatar;
  item.self = source.self;
  return item;
}

/** 读出一份拷贝，调用方改数组不会写穿草稿。 */
export function getTodoAssignees(): TodoAssignee[] {
  const next: TodoAssignee[] = [];
  for (let i = 0; i < people.length; i++) {
    next.push(copyPerson(people[i]));
  }
  return next;
}

/** 整表替换责任人。传入的对象会被再拷贝一次。 */
export function setTodoAssignees(list: TodoAssignee[]): void {
  const next: TodoAssignee[] = [];
  for (let i = 0; i < list.length; i++) {
    next.push(copyPerson(list[i]));
  }
  people = next;
}

/** 完成模式：single / ratio / all，与新建待办表单一致。 */
export function getTodoCompleteMode(): string {
  return completeMode;
}

export function setTodoCompleteMode(value: string): void {
  if (value == "single" || value == "ratio" || value == "all") {
    completeMode = value;
  }
}
