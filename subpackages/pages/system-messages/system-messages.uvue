<template>
  <view class="system-messages-page">
    <custom-nav-bar :title="t('Mobile.SystemMessages.title')" :has-safety-zone="true">
      <template v-slot:left>
        <view class="header-icon-box" @tap="handleBack">
          <svg-icon name="icon-a-Chevronleft" />
        </view>
      </template>
    </custom-nav-bar>

    <scroll-view
      :scroll-y="true"
      class="message-list"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      @refresherrefresh="handleRefresh"
    >
      <view v-if="messages.length > 0" class="message-list-content">
        <view v-for="(item, index) in messages" :key="item.id" class="message-item" :class="index === messages.length - 1 ? 'message-item--last' : ''">
          <view class="message-icon">
            <image class="sender-avatar" :src="item.senderAvatar" mode="aspectFill" />
          </view>
          <view class="message-body">
            <text class="message-sender" flatten>{{ item.senderName }}</text>
            <view class="message-content">
              <ai-msg
                class="system-message-markdown"
                :msg="item.markdownMsg"
                :body-text="item.content"
                :show-tool-bar="false"
                :is-conversation-active="false"
                :is-last-msg="false"
              />
            </view>
            <text class="message-time" flatten>{{ formatDateLocal(item.created) }}</text>
          </view>
        </view>
      </view>

      <view v-else-if="!loading" class="empty-wrapper">
        <empty-state text="Mobile.SystemMessages.empty" />
      </view>

      <view v-else class="loading-state">
        <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiNotifyMessageList, apiNotifyMessageUnreadClear } from "@/servers/message";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { jumpNavigateBack } from "@/utils/common";
  import { formatDate } from "@/utils/system";
  import { clearSystemMessageBadge } from "@/utils/notificationBadge";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import EmptyState from "@/components/empty-state/empty-state.uvue";
  import AiMsg from "@/subpackages/components/ai-msg/ai-msg.uvue";
  import { MsgItem } from "@/types/interfaces/ai-msg";
  import defaultAvatar from "@/static/assets/avatar.png";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
  const formatDateLocal = (input: string): string => formatDate(input, "YYYY-MM-DD HH:mm");

  class SystemMessageItem {
    id: number = 0;
    content: string = "";
    created: string = "";
    senderName: string = "";
    senderAvatar: string = defaultAvatar;
    markdownMsg: MsgItem = new MsgItem();

    constructor(raw: any) {
      const obj = raw as UTSJSONObject;
      this.id = parseInt(`${obj["id"] != null ? obj["id"] : 0}`);
      this.content = obj["content"] != null ? `${obj["content"]}` : "";
      this.created = obj["created"] != null ? `${obj["created"]}` : "";
      this.markdownMsg._id = `system-message-${this.id}`;
      this.markdownMsg.body = this.content;

      const senderRaw = obj["sender"];
      if (senderRaw != null) {
        const sender = senderRaw as UTSJSONObject;
        const nickName = sender["nickName"];
        const userName = sender["userName"];
        const avatar = sender["avatar"];
        this.senderName = nickName != null && `${nickName}`.length > 0
          ? `${nickName}`
          : userName != null && `${userName}`.length > 0
            ? `${userName}`
            : "";
        if (avatar != null && `${avatar}`.length > 0) {
          this.senderAvatar = `${avatar}`;
        }
      }
    }
  }

  const messages = ref<SystemMessageItem[]>([]);
  const loading = ref<boolean>(false);
  const refreshing = ref<boolean>(false);

  const normalizeMessages = (raw: any | null): SystemMessageItem[] => {
    const result = [] as SystemMessageItem[];
    if (!Array.isArray(raw)) return result;
    for (let i = 0; i < raw.length; i++) {
      result.push(new SystemMessageItem(raw[i]));
    }
    return result;
  };

  const loadMessages = async () => {
    if (loading.value) return;
    loading.value = true;
    try {
      const params = new UTSJSONObject();
      params["size"] = 100;
      const response = await apiNotifyMessageList(params);
      if (apiResCode(response) == SUCCESS_CODE) {
        messages.value = normalizeMessages(apiResData<any>(response));
      }

      // 与 PC 保持一致：打开消息中心后将所有未读消息置为已读。
      const clearResponse = await apiNotifyMessageUnreadClear();
      if (apiResCode(clearResponse) == SUCCESS_CODE) {
        clearSystemMessageBadge();
      }
    } catch (error) {
      console.error("加载系统消息失败:", error);
    } finally {
      loading.value = false;
      refreshing.value = false;
    }
  };

  const handleRefresh = () => {
    refreshing.value = true;
    loadMessages();
  };

  const handleBack = () => jumpNavigateBack();

  onLoad((_options: OnLoadOptions) => {
    loadMessages();
  });
</script>

<style lang="scss" scoped>
  .system-messages-page {
    /* #ifdef H5 || WEB */
    height: 100vh;
    /* #endif */
    /* #ifndef H5 || WEB */
    height: 100%;
    /* #endif */
    background-color: #f7f7f7;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .header-icon-box {
    width: 72rpx;
    height: 72rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .message-list {
    height: 0;
    flex: 1;
    // Android Flex 布局下允许 scroll-view 收缩，滚动手势才能由它接收。
    min-height: 0;
  }

  .message-list-content {
    margin: 24rpx;
    padding: 0 24rpx;
    border-radius: 24rpx;
    background-color: #ffffff;
  }

  .message-item {
    display: flex;
    flex-direction: row;
    padding: 28rpx 0;
    border-bottom: 2rpx solid #f0f0f0;
  }

  // vapor: :last-child 运行时丢弃，改模板绑 --last 单类
  .message-item--last {
    border-bottom-width: 0;
  }

  .message-icon {
    width: 64rpx;
    height: 64rpx;
    margin-right: 20rpx;
    border-radius: 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sender-avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 32rpx;
    background-color: #f5f5f5;
  }

  .message-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .message-sender {
    color: #999999;
    font-size: 26rpx;
    margin-bottom: 8rpx;
  }

  .message-content {
    width: 100%;
    max-width: 100%;
    margin-left: -32rpx;
    margin-right: -32rpx;
    min-height: 0;
    box-sizing: border-box;

    /* H5 能命中下方 deep padding:0，无需再用负边距抵消 ai-msg 内边距；
     * 否则内容盒会超出 message-body，并在卡片右侧被裁切。 */
    /* #ifdef H5 || WEB */
    margin-left: 0;
    margin-right: 0;
    /* #endif */
  }

  ::v-deep .system-message-markdown {
    width: 100%;
    max-width: 100%;
    min-height: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* 系统通知使用紧凑正文；不影响聊天消息的 Markdown 排版。
     vapor: 原 ::v-deep 后代链（.system-message-markdown 下 .paragraph-box 内 .text 等）
     在 vapor 被丢弃，改为单类穿透。.text 为 ai-msg 内 markdown 正文（本页仅系统通知，
     无其他 .text），单类命中与原后代等价；长名为 markdown 组件内部真实类，防御性保留。 */
  ::v-deep .text,
  ::v-deep .uni-ai-text-md-paragraph-box-text,
  ::v-deep .uni-ai-text-md-list-box-text {
    font-size: 26rpx !important;
    line-height: 42rpx !important;
  }

  .message-time {
    margin-top: 10rpx;
    color: #999999;
    font-size: 24rpx;
  }

  .empty-wrapper,
  .loading-state {
    min-height: 360rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loading-text {
    color: #999999;
    font-size: 26rpx;
  }
</style>
