import proxyWeb from "@/uni_modules/uni-ai-x/sdk/proxy-web.uts"

/**
 * Phase1 数学渲染后端：复用现有隐藏 proxy web-view（KaTeX + html2canvas）。
 *
 * 契约（与 appMarkdownFallback / test-katex 的 katexRender 调用一致）：
 *   - H5/WEB：proxy 回传 resultHtml（katex.renderToString 的 HTML），组件 v-html 注入。
 *   - App（Android/iOS）：proxy 渲染 KaTeX 后 html2canvas 截图，回传 imageDataURL + width/height。
 *
 * 依赖：使用方页面需挂载 <web-view id="markdown-proxy-web" src=".../proxy-web.html">
 * 并调 proxyWeb.init / ensureAppContext（与 chat-conversation-component、test-katex 一致）。
 * proxyWeb 未就绪时 whenReady 会挂起等待 DOMContentLoaded，避免 callMath 空转。
 *
 * Phase2 将新增 nativeViewBackend（JLaTeXMath / iosMath）作为可替换后端，Core 逻辑不变。
 */
export function proxyWebBackend(
  latex: string,
  displayMode: boolean,
  callback: (res: UTSJSONObject) => void,
): void {
  const param = new UTSJSONObject()
  param["action"] = "katexRender"
  param["pureMathText"] = latex
  param["displayMode"] = displayMode
  const doRender = (): void => {
    proxyWeb.callMethod(param, (res: UTSJSONObject): void => {
      callback(res)
    })
  }
  if (proxyWeb.isReady() == true) {
    doRender()
  } else {
    proxyWeb.whenReady((): void => {
      doRender()
    })
  }
}
