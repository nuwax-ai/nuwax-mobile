<template>
  <view class="create-hub">
    <safety-zone />

    <view class="create-hub__nav">
      <view class="create-hub__menu" @click="handleDrawerOpen">
        <svg-icon name="icon-Menu" size="40" color="#111111" />
      </view>
    </view>

    <scroll-view
      class="create-hub__scroll"
      direction="vertical"
      :show-scrollbar="false"
    >
      <view class="create-hub__hero">
        <text class="create-hub__title">{{ t("Mobile.CreateHub.heroTitle") }}</text>
        <text class="create-hub__subtitle">{{ t("Mobile.CreateHub.heroSubtitle") }}</text>
        <view class="create-hub__modes">
          <view
            class="create-hub__mode"
            :class="{ 'create-hub__mode--on': currentMode == 'chat' }"
            @click="handleModeChange('chat')"
          >
            <text
              class="create-hub__mode-text"
              :class="{ 'create-hub__mode-text--on': currentMode == 'chat' }"
            >{{ t("Mobile.CreateHub.modeChat") }}</text>
          </view>
          <view
            class="create-hub__mode"
            :class="{ 'create-hub__mode--on': currentMode == 'project' }"
            @click="handleModeChange('project')"
          >
            <text
              class="create-hub__mode-text"
              :class="{ 'create-hub__mode-text--on': currentMode == 'project' }"
            >{{ t("Mobile.CreateHub.modeProject") }}</text>
          </view>
        </view>

        <view v-if="currentMode == 'project'" class="create-hub__project-list">
          <view class="create-hub__project-card" @click="handleProjectCardClick('standard')">
            <view class="create-hub__project-icon create-hub__project-icon--standard">
              <svg-icon name="icon-BorderOutlined" size="36" color="#6558ff" />
            </view>
            <view class="create-hub__project-info">
              <text class="create-hub__project-title">{{ t("Mobile.CreateHub.projectStandard") }}</text>
              <text class="create-hub__project-desc">{{ t("Mobile.CreateHub.projectStandardDesc") }}</text>
            </view>
            <svg-icon name="icon-a-Chevronright" size="32" color="#b8bcc5" />
          </view>

          <view class="create-hub__project-card" @click="handleProjectCardClick('web')">
            <view class="create-hub__project-icon create-hub__project-icon--web">
              <svg-icon name="icon-Globe" size="36" color="#18b99a" />
            </view>
            <view class="create-hub__project-info">
              <text class="create-hub__project-title">{{ t("Mobile.CreateHub.projectWeb") }}</text>
              <text class="create-hub__project-desc">{{ t("Mobile.CreateHub.projectWebDesc") }}</text>
            </view>
            <svg-icon name="icon-a-Chevronright" size="32" color="#b8bcc5" />
          </view>

          <view class="create-hub__project-card" @click="handleProjectCardClick('fullstack')">
            <view class="create-hub__project-icon create-hub__project-icon--fullstack">
              <text class="create-hub__project-code">&lt;/&gt;</text>
            </view>
            <view class="create-hub__project-info">
              <text class="create-hub__project-title">{{ t("Mobile.CreateHub.projectFullstack") }}</text>
              <text class="create-hub__project-desc">{{ t("Mobile.CreateHub.projectFullstackDesc") }}</text>
            </view>
            <svg-icon name="icon-a-Chevronright" size="32" color="#b8bcc5" />
          </view>
        </view>
      </view>
    </scroll-view>

    <view v-if="currentMode != 'project'" class="create-hub__bottom">
      <create-conversation-input
        :agent-id="defaultAgentId"
        :agent-type="defaultAgentType"
        :is-task-agent="isTaskAgent"
        :enable-voice="true"
        :is-conversation-active="false"
        :has-permission="true"
        @onSendMessage="handleSendMessage"
      />
    </view>

    <create-project-sheet ref="projectSheetRef" />

    <!-- 项目/任务抽屉（App v3）：左上角菜单唤起 -->
    <project-task-drawer
      ref="drawerRef"
      :is-logged-in="isLoggedIn"
      @conversation-click="handleConversationClick"
    />

    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, type ComponentPublicInstance } from "vue";
  import { onShow } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
  import { apiTenantConfig } from "@/servers/account";
  import { apiPublishedAgentInfo } from "@/servers/agentDev";
  import { apiAgentConversationCreate } from "@/servers/conversation";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { jumpToAgentDetailPage, syncNativeTabBarState } from "@/utils/commonBusiness";
  import { goToLogin } from "@/utils/authNavigation";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import { applyTabBarI18n, emptyI18nParams, useI18n } from "@/utils/i18n";
  import { PendingChatDraft } from "@/types/interfaces/pendingChatDraft";
  import { savePendingChatDraft } from "@/utils/pendingChatDraft";
  import { AgentSelectedComponentInfo } from "@/types/interfaces/agent";
  import { AgentComponentTypeEnum } from "@/types/enums/agent";
  import CreateConversationInput from "@/components/create-conversation-input/create-conversation-input.uvue";
  import ProjectTaskDrawer from "@/components/project-task-drawer/project-task-drawer.uvue";
  import CreateProjectSheet from "@/pages/task/components/create-project-sheet.uvue";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  type CreateHubMode = "" | "chat" | "project";

  const currentMode = ref<CreateHubMode>("");
  const sending = ref<boolean>(false);

  const defaultAgentId = ref<number>(0);
  const defaultAgentName = ref<string>("");
  const defaultAgentType = ref<string>("ChatBot");

  const { loginPopupRef, checkAuthAndShowPopup, hasToken } = useAuthInterceptor();

  const isTaskAgent = computed((): boolean => {
    return defaultAgentType.value == "TaskAgent";
  });

  function applyDefaultAgentConfig(raw: any | null): number {
    if (raw == null) {
      return 0;
    }
    const obj = raw as UTSJSONObject;
    const idRaw = obj["defaultAgentId"];
    const id = idRaw != null ? (idRaw as number) : 0;
    defaultAgentId.value = id;
    return id;
  }

  async function loadDefaultAgentEntry(): Promise<void> {
    try {
      let agentId = 0;
      const cachedRaw = uni.getStorageSync(TENANT_CONFIG_INFO);
      if (cachedRaw != null && `${cachedRaw}`.length > 0) {
        try {
          const cached = JSON.parse<UTSJSONObject>(`${cachedRaw}`);
          agentId = applyDefaultAgentConfig(cached);
        } catch (_e) {
          agentId = 0;
        }
      }

      const configRes = await apiTenantConfig();
      if (apiResCode(configRes) == SUCCESS_CODE) {
        const configData = apiResData<any>(configRes);
        if (configData != null) {
          uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(configData));
          agentId = applyDefaultAgentConfig(configData);
        }
      }

      if (agentId > 0) {
        const detailRes = await apiPublishedAgentInfo(agentId, false);
        if (apiResCode(detailRes) == SUCCESS_CODE) {
          const detailRaw = apiResData<any>(detailRes);
          if (detailRaw != null) {
            const detail = detailRaw as UTSJSONObject;
            const nameRaw = detail["name"];
            const typeRaw = detail["type"];
            defaultAgentName.value = nameRaw != null ? `${nameRaw}` : t("Mobile.Common.appName");
            defaultAgentType.value = typeRaw != null ? `${typeRaw}` : "ChatBot";
          }
        }
      }
    } catch (error) {
      console.error("加载创建页默认智能体失败", error);
    }
  }

  // ===== 项目/任务抽屉（声明须在 onShow 注册之前，规避 UTS 前向引用 error18）=====
  const drawerRef = ref<any | null>(null);
  const projectSheetRef = ref<any | null>(null);
  const isLoggedIn = ref<boolean>(false);

  /** Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject；用 $callMethod 调 defineExpose 方法 */
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  async function refreshLoginStateAndDrawer(): Promise<void> {
    isLoggedIn.value = await hasToken();
    // 抽屉开着（如从会话页返回）时静默补差
    callRefMethod(drawerRef.value, "resumeData");
  }

  function handleDrawerOpen(): void {
    if (isLoggedIn.value != true) {
      // 未登录先去登录（抽屉数据依赖登录态）
      // #ifdef MP-WEIXIN
      checkAuthAndShowPopup();
      // #endif
      // #ifndef MP-WEIXIN
      goToLogin(true);
      // #endif
      return;
    }
    callRefMethod(drawerRef.value, "open");
  }

  /** 项目卡片点击：standard = 常规项目，web = 网页应用，fullstack = 全栈项目 */
  function handleProjectCardClick(type: string): void {
    const inst = projectSheetRef.value;
    if (inst == null) {
      return;
    }
    // Android：组件 ref 是 Gen* 类，须用 $callMethod 调 defineExpose 方法并带参
    (inst as ComponentPublicInstance).$callMethod("open", type);
  }

  function handleConversationClick(item: any): void {
    const obj = item as UTSJSONObject;
    const agentIdRaw = obj["agentId"];
    const agentId = agentIdRaw != null ? (agentIdRaw as number) : 0;
    const idRaw = obj["id"];
    const conversationId = idRaw != null ? (idRaw as number) : 0;
    if (agentId <= 0 || conversationId <= 0) {
      return;
    }
    jumpToAgentDetailPage(agentId, conversationId);
  }

  onShow(() => {
    syncNativeTabBarState();
    applyTabBarI18n();
    loadDefaultAgentEntry();
    refreshLoginStateAndDrawer();
  });

  function handleModeChange(mode: string): void {
    currentMode.value = mode == "project" ? "project" : "chat";
  }

  async function ensureLoggedIn(): Promise<boolean> {
    const loggedIn = await hasToken();
    if (loggedIn == true) {
      return true;
    }
    // #ifdef MP-WEIXIN
    await checkAuthAndShowPopup();
    return false;
    // #endif
    // #ifndef MP-WEIXIN
    goToLogin(true);
    return false;
    // #endif
  }

  function resolveAgentType(): "ChatBot" | "PageApp" | "TaskAgent" {
    const rawType = defaultAgentType.value;
    if (rawType == "PageApp") {
      return "PageApp";
    }
    if (rawType == "TaskAgent") {
      return "TaskAgent";
    }
    return "ChatBot";
  }

  function parseConversationId(raw: any | null): number {
    if (raw == null) {
      return 0;
    }
    const jsonStr = JSON.stringify(raw);
    if (jsonStr == null || jsonStr.length == 0) {
      return 0;
    }
    const parsed = JSON.parse(jsonStr) as UTSJSONObject | null;
    if (parsed == null) {
      return 0;
    }
    const idRaw = parsed["id"];
    if (idRaw == null) {
      return 0;
    }
    if (typeof idRaw == "number") {
      return idRaw as number;
    }
    const parsedId = parseInt(`${idRaw}`, 10);
    return parsedId != parsedId ? 0 : parsedId;
  }

  function collectDraftAttachments(raw: any | null): UTSJSONObject[] {
    const result: UTSJSONObject[] = [];
    if (raw == null) {
      return result;
    }
    const list = raw as UTSJSONObject[];
    for (let i = 0; i < list.length; i++) {
      const file = list[i];
      const item: UTSJSONObject = {} as UTSJSONObject;
      const urlRaw = file["url"];
      const typeRaw = file["type"];
      const nameRaw = file["name"];
      const keyRaw = file["key"];
      const sizeRaw = file["size"];
      item["fileUrl"] = urlRaw != null ? `${urlRaw}` : "";
      item["mimeType"] = typeRaw != null ? `${typeRaw}` : "";
      item["fileName"] = nameRaw != null ? `${nameRaw}` : "";
      item["fileKey"] = keyRaw != null ? `${keyRaw}` : "";
      item["fileSize"] = sizeRaw != null ? (sizeRaw as number) : 0;
      result.push(item);
    }
    return result;
  }

  function collectSkillIds(raw: any | null): number[] {
    const result: number[] = [];
    if (raw == null) {
      return result;
    }
    const list = raw as number[];
    for (let i = 0; i < list.length; i++) {
      result.push(list[i]);
    }
    return result;
  }

  async function handleSendMessage(data: any): Promise<void> {
    if (sending.value == true) {
      return;
    }
    const obj = data as UTSJSONObject;
    const messageRaw = obj["messageInfo"];
    const message = messageRaw != null ? `${messageRaw}`.trim() : "";
    const attachments = collectDraftAttachments(obj["files"]);
    if (message.length == 0 && attachments.length == 0) {
      return;
    }
    const loggedIn = await ensureLoggedIn();
    if (loggedIn != true) {
      return;
    }
    const agentId = defaultAgentId.value;
    if (agentId <= 0) {
      uni.showToast({
        title: t("Mobile.CreateHub.noDefaultAgent"),
        icon: "none",
      });
      return;
    }

    sending.value = true;
    uni.showLoading({ title: t("Mobile.Page.loading"), mask: true });
    try {
      const conversationParams: UTSJSONObject = {
        agentId: agentId,
        devMode: false,
      };
      const res = await apiAgentConversationCreate(conversationParams);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({
          title: apiResMessage(res).length > 0 ? apiResMessage(res) : t("Mobile.CreateHub.sendFailed"),
          icon: "none",
        });
        return;
      }
      const convId = parseConversationId(apiResData<any>(res));
      if (convId <= 0) {
        uni.showToast({
          title: t("Mobile.CreateHub.sendFailed"),
          icon: "none",
        });
        return;
      }
      const draft = new PendingChatDraft();
      draft.createdAt = Date.now();
      draft.agentId = agentId;
      draft.conversationId = convId;
      draft.message = message;
      draft.attachments = attachments;
      draft.skillIds = collectSkillIds(obj["skillIds"]);
      const selectedRaw = obj["selectedComponents"];
      if (selectedRaw != null) {
        const selectedList = selectedRaw as UTSJSONObject[];
        for (let i = 0; i < selectedList.length; i++) {
          const item = selectedList[i];
          const idRaw = item["id"];
          const id = idRaw != null ? (idRaw as number) : 0;
          const typeRaw = item["type"];
          const type = typeRaw != null ? (typeRaw as AgentComponentTypeEnum) : AgentComponentTypeEnum.Plugin;
          draft.selectedComponents.push(new AgentSelectedComponentInfo(id, type));
        }
      }
      const agentModeRaw = obj["agentMode"];
      const agentMode = agentModeRaw != null ? `${agentModeRaw}` : "";
      if (agentMode == "ask" || agentMode == "yolo") {
        draft.agentMode = agentMode;
      }
      savePendingChatDraft(draft);
      await jumpToAgentDetailPage(agentId, convId, resolveAgentType(), defaultAgentName.value);
    } catch (error) {
      console.error("创建会话失败", error);
      uni.showToast({
        title: t("Mobile.CreateHub.sendFailed"),
        icon: "none",
      });
    } finally {
      sending.value = false;
      uni.hideLoading();
    }
  }
</script>

<style lang="scss" scoped>
  .create-hub {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #ffffff;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  .create-hub__nav {
    padding: 12rpx 32rpx 0;
  }

  .create-hub__menu {
    width: 72rpx;
    height: 72rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* 页面主体：从上到下正常流，内容超出即垂直滚动 */
  .create-hub__scroll {
    flex: 1;
    min-height: 0;
  }

  .create-hub__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 48rpx 48rpx;
  }

  .create-hub__title {
    font-size: 52rpx;
    font-weight: 700;
    line-height: 72rpx;
    color: #111111;
    text-align: center;
  }

  .create-hub__subtitle {
    margin-top: 16rpx;
    font-size: 28rpx;
    line-height: 40rpx;
    color: #8a8a8a;
    text-align: center;
  }

  .create-hub__modes {
    margin-top: 48rpx;
    width: 480rpx;
    max-width: 100%;
    padding: 8rpx;
    border-radius: 999rpx;
    background-color: #f3f3f3;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .create-hub__mode {
    flex: 1;
    height: 72rpx;
    border-radius: 999rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .create-hub__mode--on {
    background-color: #ffffff;
    /* #ifndef APP-HARMONY */
    box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
    /* #endif */
  }

  .create-hub__mode-text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #8a8a8a;
  }

  .create-hub__mode-text--on {
    color: #111111;
    font-weight: 600;
  }

  .create-hub__project-list {
    width: 100%;
    margin-top: 48rpx;
    display: flex;
    flex-direction: column;
  }

  .create-hub__project-card {
    width: 100%;
    min-height: 120rpx;
    margin-bottom: 16rpx;
    padding: 20rpx 24rpx;
    border-radius: 20rpx;
    background-color: #ffffff;
    box-shadow: 0 4rpx 20rpx rgba(18, 24, 40, 0.05);
    display: flex;
    flex-direction: row;
    align-items: center;
    box-sizing: border-box;
  }

  .create-hub__project-icon {
    width: 72rpx;
    height: 72rpx;
    margin-right: 20rpx;
    border-radius: 16rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .create-hub__project-icon--standard {
    background-color: #f1efff;
  }

  .create-hub__project-icon--web {
    background-color: #e8f8f4;
  }

  .create-hub__project-icon--fullstack {
    background-color: #edf5ff;
  }

  .create-hub__project-code {
    color: #2878e8;
    font-size: 28rpx;
    line-height: 36rpx;
    font-weight: 600;
  }

  .create-hub__project-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .create-hub__project-title {
    color: #161616;
    font-size: 30rpx;
    line-height: 42rpx;
    font-weight: 600;
  }

  .create-hub__project-desc {
    margin-top: 2rpx;
    color: #8a8a8a;
    font-size: 24rpx;
    line-height: 34rpx;
  }

  .create-hub__bottom {
    flex-shrink: 0;
  }
</style>

<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  /* #endif */
</style>
