<template>
  <view class="buffered-avatar">
    <view v-if="layers.length == 0 && !loading" class="buffered-avatar__fallback">
      <slot />
    </view>
    <image
      v-for="layer in layers"
      :key="layer.id"
      class="buffered-avatar__image"
      :style="{ opacity: layer.loaded ? 1 : 0 }"
      :src="layer.url"
      mode="aspectFill"
      :fade-show="false"
      @load="handleLoad(layer.id)"
      @error="handleError(layer.id)"
    />
  </view>
</template>

<script setup lang="uts">
  import { ref, watch } from "vue";
  import { BufferedAvatarLayer, BufferedAvatarState } from "@/utils/im/bufferedAvatar";

  const props = defineProps({
    sourceKey: { type: String, default: "" },
    src: { type: String, default: "" },
    failed: { type: Boolean, default: false },
  });
  const emit = defineEmits<{ "avatar-loaded": []; "avatar-error": [] }>();
  const state = new BufferedAvatarState();
  const layers = ref<BufferedAvatarLayer[]>([]);
  const loading = ref<boolean>(false);

  function renderState(): void {
    layers.value = state.layers.slice();
    loading.value = state.loading;
  }

  function updateSource(): void {
    state.update(props.sourceKey, props.src, props.failed);
    renderState();
  }

  function handleLoad(id: number): void {
    if (state.imageLoaded(id)) {
      renderState();
      emit("avatar-loaded");
    }
  }

  function handleError(id: number): void {
    if (state.imageFailed(id)) {
      renderState();
      emit("avatar-error");
    }
  }

  // 分别监听，避免父页面克隆行对象刷新摘要时重新加载头像。
  watch((): string => props.sourceKey, updateSource);
  watch((): string => props.src, updateSource);
  watch((): boolean => props.failed, updateSource);
  updateSource();
</script>

<style lang="scss" scoped>
  .buffered-avatar {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #f0eff5;
  }

  .buffered-avatar__fallback,
  .buffered-avatar__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
</style>
