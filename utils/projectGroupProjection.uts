/**
 * 项目 tab 接口响应 → 抽屉视图模型映射（纯函数，供单测与抽屉组件复用）。
 *
 * 对齐 PC ProjectPanel 的数据结构：项目行（分组头）+ 项目下会话（子项）。
 * 字段全部可选容错：后端字段缺失时兜底，不抛错。
 * 时间文案由调用方注入 formatter（依赖 i18n 的 formatTimeAgo 留在组件层，
 * 本模块保持无 uni/i18n 依赖以便 node 单测）。
 */

/** 项目下会话（子项）视图模型 */
export class ProjectChildView {
  /** 会话 id */
  id: number = 0;
  /** 所属智能体 id（跳会话用，可能缺失 → 0） */
  agentId: number = 0;
  name: string = "";
  timeLabel: string = "";
  /** 会话任务状态：EXECUTING / FAILED / COMPLETE...（空串 = 无） */
  taskStatus: string = "";
  pinned: boolean = false;
}

/** 项目（分组）视图模型 */
export class ProjectGroupView {
  id: number = 0;
  name: string = "";
  /** NormalProject / PageApp / UserApp（决定改名/删除路由） */
  projectType: string = "";
  expanded: boolean = true;
  children: ProjectChildView[] = [] as ProjectChildView[];
}

function toNum(v: any | null, fallback: number = 0): number {
  if (v == null) {
    return fallback;
  }
  const parsed = parseFloat(`${v}`);
  // parsed != parsed 判 NaN
  return parsed != parsed ? fallback : parsed;
}

function toStr(v: any | null, fallback: string = ""): string {
  if (v == null) {
    return fallback;
  }
  return `${v}`;
}

/** 项目类型 → 类型标签 i18n key（未知类型返回空串 = 不展示标签） */
export function projectTypeLabelKey(projectType: string): string {
  if (projectType == "NormalProject") return "Mobile.Project.typeNormal";
  if (projectType == "PageApp") return "Mobile.Project.typePageApp";
  if (projectType == "UserApp") return "Mobile.Project.typeUserApp";
  return "";
}

/** 解析单个项目下会话（conversations 数组项） */
function mapProjectChild(raw: UTSJSONObject, formatTime: (s: string) => string): ProjectChildView {
  const child = new ProjectChildView();
  child.id = toNum(raw["id"], 0);
  child.agentId = toNum(raw["agentId"], 0);
  const topic = toStr(raw["topic"], "");
  child.name = topic;
  const modified = toStr(raw["modified"], "");
  child.timeLabel = modified.length > 0 ? formatTime(modified) : "";
  child.taskStatus = toStr(raw["taskStatus"], "");
  return child;
}

/** 解析单个项目行（records 数组项） */
function mapProjectGroup(raw: UTSJSONObject, formatTime: (s: string) => string): ProjectGroupView {
  const group = new ProjectGroupView();
  // tab 接口主键字段名为 projectId（对齐 PC UserProjectTabItem）
  group.id = toNum(raw["projectId"], toNum(raw["id"], 0));
  group.name = toStr(raw["name"], "");
  group.projectType = toStr(raw["projectType"], "");
  const childrenRaw = raw["conversations"];
  if (childrenRaw != null && Array.isArray(childrenRaw)) {
    const arr = childrenRaw as any[];
    for (let i = 0; i < arr.length; i++) {
      const item = arr[i];
      if (item == null) continue;
      group.children.push(mapProjectChild(item as UTSJSONObject, formatTime));
    }
  }
  return group;
}

/**
 * tab/page-query 响应 data（{ records: [...] }）→ 分组视图列表。
 * data 为空/结构不符时返回空数组。
 */
export function mapProjectTabResponse(
  data: any | null,
  formatTime: (s: string) => string,
): ProjectGroupView[] {
  const groups: ProjectGroupView[] = [] as ProjectGroupView[];
  if (data == null) {
    return groups;
  }
  let records: any[] | null = null;
  if (data instanceof UTSJSONObject) {
    const raw = (data as UTSJSONObject)["records"];
    if (raw != null && Array.isArray(raw)) {
      records = raw as any[];
    }
  } else if (typeof data == "object") {
    // H5 下响应可能是普通对象
    const obj = data as Record<string, any>;
    const raw = obj["records"];
    if (raw != null && Array.isArray(raw)) {
      records = raw as any[];
    }
  }
  if (records == null) {
    return groups;
  }
  for (let i = 0; i < records.length; i++) {
    const item = records[i];
    if (item == null) continue;
    groups.push(mapProjectGroup(item as UTSJSONObject, formatTime));
  }
  return groups;
}
