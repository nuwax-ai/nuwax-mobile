<template>
  <login-layout
    :key="tenantConfigRevision"
    :title="tenantConfigSiteName"
    :logo="tenantConfigSiteLogo"
  >
    <view v-if="currentFormType == 'domain'" class="domain-step">
      <text class="domain-title">{{ t("Mobile.Auth.enterpriseLogin") }}</text>
      <view class="domain-input-wrap" :class="{ 'domain-input-error': domainError.length > 0 }">
        <input
          class="domain-input"
          type="text"
          v-model="domainInput"
          :placeholder="t('Mobile.Auth.inputDomain')"
          :disabled="domainValidating"
          cursor-color="#5147ff"
          @confirm="handleValidateDomain"
        />
        <view
          v-if="domainInput.length > 0 && !domainValidating"
          class="domain-clear"
          @tap="handleClearDomain"
        >
          <svg-icon
            name="icon-a-Xcircle-fill"
            :size="32"
            customClass="domain-clear-icon"
          />
        </view>
      </view>
      <text v-if="domainError.length > 0" class="domain-error">{{ domainError }}</text>
      <button
        class="domain-next"
        :loading="domainValidating"
        :disabled="domainValidating"
        @click="handleValidateDomain"
      >{{ t("Mobile.Auth.nextStep") }}</button>
      <button class="domain-back" :disabled="domainValidating" @click="handleDomainBack">
        {{ t("Mobile.Auth.back") }}
      </button>
    </view>

    <login-form
      v-else-if="currentFormType == 'login'"
      :tenantConfigInfo="tenantConfigInfo"
      :siteName="tenantConfigSiteName"
      :siteLogo="tenantConfigSiteLogo"
      :redirectUrl="redirectUrl"
      :isEnterpriseDomain="isEnterpriseDomain"
      :submitting="inlineCodeLoginLoading"
      @show-verify="handleShowVerify"
      @code-login="handleInlineCodeLogin"
      @enterprise-login="handleEnterpriseLogin"
      @personal-login="handlePersonalLogin"
    />

    <captcha-verify
      v-else-if="currentFormType == 'verify'"
      :phoneOrEmail="phoneOrEmail"
      :tenantConfigInfo="tenantConfigInfo"
      @verify-login="handleLoginByCode"
      @back="handleBack"
    />

    <reset-password v-else @back="handleBack" />
  </login-layout>
</template>

<script setup lang="uts">
import { ref, computed } from "vue";
import { SUCCESS_CODE, AGENT_NOT_EXIST } from "@/constants/codes.constants";
import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
import {
  getApiBaseUrl,
  getDefaultApiBaseUrl,
  hasConfiguredApiBaseUrl,
  normalizeApiBaseUrl,
  resetApiBaseUrl,
  setApiBaseUrl,
} from "@/constants/config";
import { apiTenantConfig, apiTenantConfigWithUrl, apiLoginCode } from "@/servers/account";
import { CodeLogin } from "@/types/interfaces/login";
import type { RequestResponse } from "@/types/interfaces/request";
import LoginLayout from "./components/login-layout/login-layout.uvue";
import LoginForm from "./components/login-form/login-form.uvue";
import CaptchaVerify from "./components/captcha-verify/captcha-verify.uvue";
import ResetPassword from "./components/reset-password/reset-password.uvue";
import { redirectTo } from "@/utils/common.uts";
// #ifdef APP-ANDROID || APP-IOS
import { resumeDeepLinkAfterLogin } from "@/utils/deepLinkRouter.uts";
// #endif
import { useI18n, emptyI18nParams } from "@/utils/i18n";
import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
import { clearAccessToken, saveAccessToken } from "@/utils/authSession";

const { t: tFn, ensureLangList } = useI18n();
const t = (key: string): string => tFn(key, emptyI18nParams(), "");

const currentFormType = ref<string>("login");
const phoneOrEmail = ref<string>("");
const redirectUrl = ref<string>("");
const tenantConfigInfo = ref<any | null>(null);
const tenantConfigRevision = ref<number>(0);
const domainInput = ref<string>("");
const domainError = ref<string>("");
const domainValidating = ref<boolean>(false);
const domainConfigured = ref<boolean>(hasConfiguredApiBaseUrl());
const inlineCodeLoginLoading = ref<boolean>(false);

const isEnterpriseDomain = computed((): boolean => {
  return domainConfigured.value;
});

const tenantConfigSiteName = computed((): string => {
  const obj = tenantConfigInfo.value != null ? tenantConfigInfo.value as UTSJSONObject : null;
  const raw = obj != null ? obj["siteName"] : null;
  const value = raw != null ? `${raw}` : "";
  return value.length > 0 ? value : "女娲Nuwax";
});

const tenantConfigSiteLogo = computed((): string => {
  const obj = tenantConfigInfo.value != null ? tenantConfigInfo.value as UTSJSONObject : null;
  const raw = obj != null ? obj["siteLogo"] : null;
  return raw != null ? `${raw}` : "";
});

function applyTenantConfig(data: any | null): void {
  tenantConfigInfo.value = data;
  if (data != null) {
    const json = JSON.stringify(data);
    if (json != null) uni.setStorageSync(TENANT_CONFIG_INFO, json);
    const obj = data as UTSJSONObject;
    const siteNameRaw = obj["siteName"];
    if (siteNameRaw != null && `${siteNameRaw}`.length > 0) {
      uni.setNavigationBarTitle({ title: `${siteNameRaw}` });
    }
  } else {
    uni.removeStorageSync(TENANT_CONFIG_INFO);
    uni.setNavigationBarTitle({ title: "女娲Nuwax" });
  }
  // Android 下子组件对 UTSJSONObject prop 的深层更新可能不会立即重绘，
  // 通过版本键重建登录布局，确保 Logo、站点名和登录配置整体更新。
  tenantConfigRevision.value = tenantConfigRevision.value + 1;
}

async function fetchTenantConfig(baseUrl: string | null = null): Promise<boolean> {
  try {
    const res = baseUrl != null
      ? await apiTenantConfigWithUrl(baseUrl)
      : await apiTenantConfig();
    const data = apiResData<any>(res);
    if (apiResCode(res) == SUCCESS_CODE && data != null) {
      applyTenantConfig(data);
      return true;
    }
  } catch (error) {
    console.error("获取租户配置失败", error);
  }
  return false;
}

const handleEnterpriseLogin = () => {
  domainInput.value = "";
  domainError.value = "";
  currentFormType.value = "domain";
};

const handleDomainBack = () => {
  domainError.value = "";
  currentFormType.value = "login";
};

const handleClearDomain = () => {
  domainInput.value = "";
  domainError.value = "";
};

const handlePersonalLogin = async () => {
  if (!isEnterpriseDomain.value) return;
  const defaultBaseUrl = getDefaultApiBaseUrl();
  if (defaultBaseUrl.length == 0) return;
  clearAccessToken();
  resetApiBaseUrl();
  domainConfigured.value = false;
  domainInput.value = defaultBaseUrl;
  applyTenantConfig(null);
  // 显式按个人版默认域名重新获取真实配置，不复用企业版配置或缓存。
  const loaded = await fetchTenantConfig(defaultBaseUrl);
  if (!loaded) {
    uni.showToast({
      title: t("Mobile.Auth.domainValidateFailed"),
      icon: "none",
    });
    return;
  }
  await ensureLangList();
  uni.showToast({
    title: t("Mobile.Auth.personalLoginSwitched"),
    icon: "none",
  });
};

const handleValidateDomain = async () => {
  if (domainValidating.value) return;
  const normalized = normalizeApiBaseUrl(domainInput.value);
  if (normalized.length == 0) {
    domainError.value = t("Mobile.Auth.invalidDomain");
    return;
  }
  domainError.value = "";
  domainValidating.value = true;
  try {
    // 验证请求不携带旧域名 Token，验证成功前也不会修改全局服务地址。
    const res = await apiTenantConfigWithUrl(normalized);
    if (apiResCode(res) != SUCCESS_CODE || apiResData<any>(res) == null) {
      const message = apiResMessage(res);
      domainError.value = message.length > 0 ? message : t("Mobile.Auth.domainValidateFailed");
      return;
    }
    if (normalized != getApiBaseUrl()) clearAccessToken();
    if (!setApiBaseUrl(normalized)) {
      domainError.value = t("Mobile.Auth.invalidDomain");
      return;
    }
    const configData = apiResData<any>(res);
    domainConfigured.value = true;
    domainInput.value = normalized;
    // 使用本次目标域名 /api/tenant/config 返回的完整配置刷新登录页。
    applyTenantConfig(configData);
    await ensureLangList();
    currentFormType.value = "login";
    uni.showToast({ title: t("Mobile.Auth.domainValidateSuccess"), icon: "none" });
  } catch (error) {
    console.error("企业域名验证失败", error);
    domainError.value = t("Mobile.Auth.domainValidateFailed");
  } finally {
    domainValidating.value = false;
  }
};

const handleLoginSuccess = (result: RequestResponse<any> | null) => {
  const code = apiResCode(result);
  const message = apiResMessage(result);
  const dataRaw = apiResData<any>(result);
  if (code == AGENT_NOT_EXIST) {
    uni.showToast({ title: message, icon: "none" });
    return;
  }
  if (code == SUCCESS_CODE && dataRaw != null) {
    const data = dataRaw as UTSJSONObject;
    const tokenRaw = data["token"];
    saveAccessToken(tokenRaw != null ? `${tokenRaw}` : "");
    const resetPassRaw = data["resetPass"];
    if ((resetPassRaw != null ? parseFloat(`${resetPassRaw}`) : 1) == 0) {
      currentFormType.value = "reset";
      return;
    }
    uni.showToast({ title: t("Mobile.Auth.loginSuccess"), icon: "success" });
    setTimeout(() => {
      redirectTo(redirectUrl.value);
      // #ifdef APP-ANDROID || APP-IOS
      resumeDeepLinkAfterLogin(); // 登录成功后消费待跳转业务深链（前台 reLaunch 不触发 onShow）
      // #endif
    }, 1000);
  }
};

const handleShowVerify = (value: string, _captcha: string) => {
  currentFormType.value = "verify";
  phoneOrEmail.value = value;
};
const handleBack = () => {
  currentFormType.value = "login";
};
const handleLoginByCode = async (verifyCode: string) => {
  const params = new CodeLogin();
  params.phoneOrEmail = phoneOrEmail.value;
  if (phoneOrEmail.value.includes("@")) params.email = phoneOrEmail.value;
  else params.phone = phoneOrEmail.value;
  params.code = verifyCode;
  handleLoginSuccess(await apiLoginCode(params));
};

const handleInlineCodeLogin = async (
  target: string,
  verifyCode: string,
  isEmail: boolean,
  captchaVerifyParam: string,
) => {
  if (inlineCodeLoginLoading.value) return;
  const params = new CodeLogin();
  params.phoneOrEmail = target;
  if (isEmail) params.email = target;
  else params.phone = target;
  params.code = verifyCode;
  params.captchaVerifyParam = captchaVerifyParam;
  inlineCodeLoginLoading.value = true;
  try {
    const result = await apiLoginCode(params);
    const loginAccepted = apiResCode(result) == SUCCESS_CODE;
    handleLoginSuccess(result);
    if (!loginAccepted) inlineCodeLoginLoading.value = false;
  } catch (error) {
    inlineCodeLoginLoading.value = false;
    uni.showToast({ title: t("Mobile.Common.networkRetry"), icon: "none" });
  }
};

onLoad((query: any) => {
  const q = query as UTSJSONObject;
  const redirectRaw = q["redirect"];
  if (redirectRaw != null && `${redirectRaw}`.length > 0) {
    const decoded = decodeURIComponent(`${redirectRaw}`);
    const target = decoded != null ? decoded : `${redirectRaw}`;
    redirectUrl.value = target == "/subpackages/pages/temporary-session/temporary-session"
      ? "/pages/index/index"
      : target;
  }
});

onMounted(() => {
  fetchTenantConfig();
  // 登录页需主动加载语言列表；Android 无缓存时否则不会渲染语言入口。
  ensureLangList();
});
</script>

<style lang="scss" scoped>
.domain-step {
  width: 100%;
  display: flex;
  flex-direction: column;
  padding-top: 28rpx;
}

.domain-title {
  color: #17191f;
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 40rpx;
}

.domain-input-wrap {
  height: 88rpx;
  padding: 0 28rpx;
  border: 2rpx solid #5147ff;
  border-radius: 14rpx;
  background-color: #ffffff;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.domain-input-error {
  border-color: #e5484d;
}

.domain-input {
  flex: 1;
  height: 84rpx;
  font-size: 30rpx;
  color: #17191f;
  background-color: #ffffff;
}

.domain-clear {
  width: 56rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}

.domain-clear-icon {
  color: #b2b4b8;
}

.domain-error {
  color: #e5484d;
  font-size: 24rpx;
  line-height: 34rpx;
  margin-top: 12rpx;
}

.domain-next {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  border-width: 0;
  background-color: #5147ff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 28rpx;
}

.domain-next::after,
.domain-back::after {
  border-width: 0;
}

.domain-back {
  height: 80rpx;
  line-height: 80rpx;
  border-width: 0;
  background-color: transparent;
  color: #777980;
  font-size: 28rpx;
  margin-top: 18rpx;
}
</style>
