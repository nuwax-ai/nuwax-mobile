/**
 * App 分享出去 / 分享进来。
 *
 * 出去：系统分享面板发出 HTTPS 中转页（微信内先打开网页，提示用浏览器打开；
 * 浏览器里再通过 nuwax:// 拉起已安装的 App）。
 * 进来：解析启动参数或中转页回流，落到 pages/share-receive。
 */
import { getApiBaseUrl } from "@/constants/config";
import { nativeRouteFromConversationUrl } from "@/utils/conversationShareUrl.uts";
import { hasLoginSession } from "@/utils/authSession";
import { redirectToLoginOnce } from "@/utils/authNavigation";
import { openShareIntoChat } from "@/utils/im/imForwardSession";
import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
import { isQrLoginLink } from "@/utils/qrLogin";

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

const PENDING_KEY = "nuwax_share_pending";
/** 冷启动时 onShow 先拿到的协议，交给启动页进入对应页面。 */
let coldStartScheme = "";

/**
 * 是否启用尚未验收的新分享。
 *
 * false：直接系统分享或复制，不弹出分享面板。
 * true：分享先弹出微信浏览器式分享面板（转发给会话 / 其他应用，其余入口先占位）。
 * 文件预览、网页预览的外链始终是 `{域名}/m/static/share-open.html`：
 * 微信内点「打开 App」只提示用浏览器打开；其它应用里先看页面内容，再点按钮用 nuwax:// 唤起 App。
 */
export const USE_NEW_ARTIFACT_SHARE = true;

export class ShareTarget {
  kind: string = "";
  id: string = "";
  title: string = "";
  text: string = "";
  sk: string = "";
  filePath: string = "";
  /** 外部分享要直接展示的 http(s) 页面。文件产物留空，中转页按 sk 打开预览。 */
  pageUrl: string = "";
}

function queryValue(raw: string, key: string): string {
  const mark = raw.indexOf("?");
  const query = mark >= 0 ? raw.substring(mark + 1) : raw;
  const parts = query.split("&");
  const prefix = key + "=";
  for (let i = 0; i < parts.length; i++) {
    const part = parts[i];
    if (part.indexOf(prefix) == 0) {
      try {
        const decoded = decodeURIComponent(part.substring(prefix.length));
        return decoded != null ? decoded : part.substring(prefix.length);
      } catch (_e) {
        return part.substring(prefix.length);
      }
    }
  }
  return "";
}

function appendQuery(url: string, key: string, value: string): string {
  if (value.length == 0) return url;
  const join = url.indexOf("?") >= 0 ? "&" : "?";
  return url + join + key + "=" + encodeURIComponent(value);
}

/**
 * 中转页所在站点。
 * App 用当前服务域名；H5 生产环境接口走相对路径、服务域名为空时，用页面自己的 origin。
 */
function sharePageOrigin(): string {
  const api = getApiBaseUrl();
  if (api.length > 0) return api;
  // #ifdef H5 || WEB
  try {
    const origin = window.location.origin;
    const text = origin != null ? `${origin}` : "";
    if (text.length > 0 && text.indexOf("file:") != 0) return text;
  } catch (_e) {
    return "";
  }
  // #endif
  return "";
}

function pageHost(raw: string): string {
  const scheme = raw.indexOf("://");
  const rest = scheme >= 0 ? raw.substring(scheme + 3) : raw;
  let end: number = rest.length;
  const slash = rest.indexOf("/");
  const question = rest.indexOf("?");
  const hash = rest.indexOf("#");
  if (slash >= 0 && slash < end) end = slash;
  if (question >= 0 && question < end) end = question;
  if (hash >= 0 && hash < end) end = hash;
  const host = rest.substring(0, end).toLowerCase();
  const colon = host.indexOf(":");
  return colon >= 0 ? host.substring(0, colon) : host;
}

function hostIsNuwax(host: string): boolean {
  return host == "agent.nuwax.com" || host == "testagent.xspaceagi.com";
}

/**
 * 普通网页里，只有女娲自己的域名才包进中转页。
 * 只有 agent.nuwax.com、testagent.xspaceagi.com 走 share-open；其它地址原样分享。
 */
function isExternalSharePage(target: ShareTarget): boolean {
  if (target.kind != "page") return false;
  const raw = target.pageUrl;
  const lower = raw.toLowerCase();
  if (lower.indexOf("https://") != 0 && lower.indexOf("http://") != 0) return false;
  return hostIsNuwax(pageHost(raw)) != true;
}

/** 对外发出的链接。外站网页直接用原地址，女娲页面仍用中转页。 */
export function buildOutgoingShareUrl(target: ShareTarget): string {
  if (isExternalSharePage(target)) return target.pageUrl;
  return buildShareOpenUrl(target);
}

/** 微信 / 浏览器可打开的 HTTPS 中转页。域名缺失时返回空串，调用方不要把相对路径分享出去。 */
export function buildShareOpenUrl(target: ShareTarget): string {
  const base = sharePageOrigin();
  if (base.length == 0) return "";
  let url = base + "/m/static/share-open.html?kind=" + encodeURIComponent(target.kind);
  url = appendQuery(url, "id", target.id);
  url = appendQuery(url, "sk", target.sk);
  url = appendQuery(url, "text", target.text.length > 180 ? target.text.substring(0, 180) : target.text);
  url = appendQuery(url, "url", target.pageUrl);
  return url;
}

export function buildAppScheme(target: ShareTarget): string {
  let url = "nuwax://open?kind=" + encodeURIComponent(target.kind);
  url = appendQuery(url, "id", target.id);
  url = appendQuery(url, "title", target.title);
  url = appendQuery(url, "sk", target.sk);
  url = appendQuery(url, "text", target.text.length > 180 ? target.text.substring(0, 180) : target.text);
  url = appendQuery(url, "url", target.pageUrl);
  return url;
}

export function parseShareUrl(raw: string): ShareTarget | null {
  if (raw.length == 0) return null;
  // 登录确认有独立的同服务域校验，不能被 query 中的 kind 当成普通分享消费。
  if (isQrLoginLink(raw)) return null;
  const lower = raw.toLowerCase();
  const isScheme = lower.indexOf("nuwax://") >= 0;
  const isPage = lower.indexOf("share-open.html") >= 0 || lower.indexOf("kind=") >= 0;
  if (isScheme != true && isPage != true) return null;
  const target = new ShareTarget();
  target.kind = queryValue(raw, "kind");
  target.id = queryValue(raw, "id");
  target.title = queryValue(raw, "title");
  target.sk = queryValue(raw, "sk");
  target.text = queryValue(raw, "text");
  target.filePath = queryValue(raw, "file");
  const pageTo = queryValue(raw, "to");
  target.pageUrl = pageTo.length > 0 ? pageTo : queryValue(raw, "url");
  if (target.kind.length == 0) return null;
  return target;
}

function readEnterRaw(): string {
  let raw = "";
  // #ifdef APP
  try {
    const enter = uni.getEnterOptionsSync();
    if (enter != null) {
      raw = schemeFromEnterOptions(enter as UTSJSONObject);
    }
  } catch (_e) {
    raw = "";
  }
  // #endif
  return raw;
}

/** uni-app x 把自定义协议放在 appScheme，通用链接放在 appLink，不在 path 里。 */
function schemeFromEnterOptions(enter: UTSJSONObject): string {
  const appScheme = enter["appScheme"] != null ? `${enter["appScheme"]}` : "";
  if (appScheme.indexOf("nuwax://") >= 0) return appScheme;
  const appLink = enter["appLink"] != null ? `${enter["appLink"]}` : "";
  if (appLink.indexOf("share-open.html") >= 0 || appLink.indexOf("nuwax://") >= 0) return appLink;
  const query = enter["query"] as UTSJSONObject | null;
  if (query != null) {
    const link = query["link"] != null ? `${query["link"]}` : "";
    const kind = query["kind"] != null ? `${query["kind"]}` : "";
    if (link.length > 0) return link;
    if (kind.length > 0) return "nuwax://open?kind=" + kind;
  }
  const path = enter["path"] != null ? `${enter["path"]}` : "";
  if (path.indexOf("nuwax") >= 0 || path.indexOf("kind=") >= 0) return path;
  return "";
}

export function saveShareTarget(target: ShareTarget): void {
  const obj = new UTSJSONObject();
  obj["kind"] = target.kind;
  obj["id"] = target.id;
  obj["title"] = target.title;
  obj["text"] = target.text;
  obj["sk"] = target.sk;
  obj["filePath"] = target.filePath;
  obj["pageUrl"] = target.pageUrl;
  uni.setStorageSync(PENDING_KEY, JSON.stringify(obj));
}

export function peekShareTarget(): ShareTarget | null {
  const raw = uni.getStorageSync(PENDING_KEY);
  if (raw == null || `${raw}`.length == 0) return null;
  try {
    const obj = JSON.parse(`${raw}`) as UTSJSONObject;
    const target = new ShareTarget();
    target.kind = obj["kind"] != null ? `${obj["kind"]}` : "";
    target.id = obj["id"] != null ? `${obj["id"]}` : "";
    target.title = obj["title"] != null ? `${obj["title"]}` : "";
    target.text = obj["text"] != null ? `${obj["text"]}` : "";
    target.sk = obj["sk"] != null ? `${obj["sk"]}` : "";
    target.filePath = obj["filePath"] != null ? `${obj["filePath"]}` : "";
    target.pageUrl = obj["pageUrl"] != null ? `${obj["pageUrl"]}` : "";
    if (target.kind.length == 0) return null;
    return target;
  } catch (_e) {
    return null;
  }
}

export function consumeShareTarget(): ShareTarget | null {
  const target = peekShareTarget();
  uni.removeStorageSync(PENDING_KEY);
  return target;
}

let rememberedAgentId = "";
let rememberedAgentTitle = "";

export function rememberShareAgent(id: string, title: string): void {
  rememberedAgentId = id;
  rememberedAgentTitle = title;
}

export function shareRememberedAgent(): void {
  if (rememberedAgentId.length == 0) {
    uni.showToast({ title: t("Mobile.Share.noAgent"), icon: "none" });
    return;
  }
  const target = new ShareTarget();
  target.kind = "agent";
  target.id = rememberedAgentId;
  target.title = rememberedAgentTitle.length > 0 ? rememberedAgentTitle : "女娲智能体";
  const url = buildShareOpenUrl(target);
  chooseShareTarget(target.title, url, () => {
    shareTarget(target);
  });
}

/**
 * 把会话页包进中转页。别人点开后可唤起女娲，并按 url 里的路由打开同一会话。
 * @param title 分享标题
 * @param pageUrl 已去掉 token 等宿主参数的会话地址
 */
export function buildConversationTransferUrl(title: string, pageUrl: string): string {
  if (pageUrl.indexOf("http://") != 0 && pageUrl.indexOf("https://") != 0) return "";
  const target = new ShareTarget();
  target.kind = "page";
  target.title = title.length > 0 ? title : "女娲智能体";
  target.pageUrl = pageUrl;
  return buildShareOpenUrl(target);
}

/**
 * 分享当前会话。对外链接仍是 share-open 中转页，url 参数携带完整会话地址。
 * @param title 分享摘要标题
 * @param pageUrl 已去掉 token 等宿主参数的会话地址
 */
export function shareConversationLink(title: string, pageUrl: string): void {
  const name = title.length > 0 ? title : "女娲智能体";
  const openUrl = buildConversationTransferUrl(name, pageUrl);
  if (openUrl.length == 0) {
    shareRememberedAgent();
    return;
  }
  const target = new ShareTarget();
  target.kind = "page";
  target.title = name;
  target.pageUrl = pageUrl;
  chooseShareTarget(name, openUrl, () => {
    shareTarget(target);
  });
}

/** 分享面板入参。当前页的 share-sheet 组件读取，不单独开页面。 */
export class PendingShareSheet {
  title: string = "";
  /** 发进女娲会话的正文，通常是标题加链接。 */
  body: string = "";
  /** 可复制、可在浏览器打开的 http(s) 链接。 */
  url: string = "";
  /** 面板顶栏「此网页由 xxx 提供」。 */
  host: string = "";
}

/** 当前页挂上的分享面板。后挂的盖住先挂的，关闭时按 id 摘掉。 */
class ShareSheetBinding {
  id: number = 0;
  notify: () => void = (): void => {};
}

let pendingSheet: PendingShareSheet | null = null;
let pendingOutside: (() => void) | null = null;
/** 本次分享的「刷新」。网页预览、文件预览传入；没有则面板里点刷新只提示占位。 */
let pendingRefresh: (() => void) | null = null;
let shareSheetOpen = false;
let shareSheetBindings: ShareSheetBinding[] = [];
let shareSheetBindingSeq = 1;

function httpUrlIn(raw: string): string {
  const lines = raw.split("\n");
  for (let i = lines.length - 1; i >= 0; i--) {
    const line = lines[i].trim();
    if (line.indexOf("https://") == 0 || line.indexOf("http://") == 0) return line;
  }
  return "";
}

/** 中转页里的真实页面。没有 url/to 时保持原链接。 */
function unwrapSharedPageUrl(raw: string): string {
  if (raw.length == 0) return "";
  if (raw.toLowerCase().indexOf("share-open.html") < 0) return raw;
  const to = queryValue(raw, "to");
  if (to.length > 0) return to;
  const inner = queryValue(raw, "url");
  return inner.length > 0 ? inner : raw;
}

/** 转发到女娲、转发给朋友只用当前页面真实地址，不带中转页。 */
function bodyWithActualPage(body: string): string {
  const found = httpUrlIn(body);
  if (found.length == 0) return body;
  const actual = unwrapSharedPageUrl(found);
  if (actual.length == 0 || actual == found) return body;
  const at = body.indexOf(found);
  if (at < 0) return body;
  return body.substring(0, at) + actual + body.substring(at + found.length);
}

/**
 * 分享出去：女娲页面（agent.nuwax.com、testagent.xspaceagi.com）用中转页；
 * 第三方链接只用原始地址。
 */
function outgoingHttpUrl(raw: string): string {
  if (raw.length == 0) return "";
  const page = unwrapSharedPageUrl(raw);
  if (hostIsNuwax(pageHost(page)) != true) return page;
  return raw;
}

function hostOfHttp(raw: string): string {
  const scheme = raw.indexOf("://");
  const rest = scheme >= 0 ? raw.substring(scheme + 3) : raw;
  // indexOf 返回 number，end 显式标 number（length 是 Int，裸推断后赋值报 Number→Int）
  let end: number = rest.length;
  const slash = rest.indexOf("/");
  const question = rest.indexOf("?");
  const hash = rest.indexOf("#");
  if (slash >= 0 && slash < end) end = slash;
  if (question >= 0 && question < end) end = question;
  if (hash >= 0 && hash < end) end = hash;
  return rest.substring(0, end);
}

function clearPendingShare(): void {
  pendingSheet = null;
  pendingOutside = null;
  pendingRefresh = null;
}

function notifyTopShareSheet(): void {
  if (shareSheetBindings.length == 0) return;
  shareSheetBindings[shareSheetBindings.length - 1].notify();
}

/** 页面挂上分享面板时登记。返回 id，卸载时交给 unbindShareSheet。 */
export function bindShareSheet(notify: () => void): number {
  const item = new ShareSheetBinding();
  item.id = shareSheetBindingSeq;
  shareSheetBindingSeq += 1;
  item.notify = notify;
  shareSheetBindings.push(item);
  return item.id;
}

/** 页面卸载时摘掉自己的面板，避免关页后还通知到已销毁组件。 */
export function unbindShareSheet(id: number): void {
  const next: ShareSheetBinding[] = [];
  for (let i = 0; i < shareSheetBindings.length; i++) {
    if (shareSheetBindings[i].id != id) next.push(shareSheetBindings[i]);
  }
  shareSheetBindings = next;
}

export function isShareSheetOpen(): boolean {
  return shareSheetOpen;
}

/** 先收起当前页面板，再执行后续动作。 */
function closeShareSheetThen(action: (() => void) | null): void {
  let ran = false;
  const run = (): void => {
    if (ran) return;
    ran = true;
    if (action != null) action();
  };
  shareSheetOpen = false;
  notifyTopShareSheet();
  clearPendingShare();
  run();
}

function showLegacyShareSheet(title: string, body: string, shareOutside: () => void): void {
  uni.showActionSheet({
    itemList: [t("Mobile.Share.toNuwax"), t("Mobile.Share.toOther")],
    cancelText: t("Mobile.Common.cancel"),
    success: (res) => {
      if (res.tapIndex == 0) {
        if (hasLoginSession() != true) {
          uni.showToast({ title: t("Mobile.Share.loginRequired"), icon: "none" });
          redirectToLoginOnce();
          return;
        }
        const text = body.length > 0 ? body : title;
        openShareIntoChat(title.length > 0 ? title : t("Mobile.Share.appName"), text);
        return;
      }
      shareOutside();
    },
  });
}

export function peekShareSheet(): PendingShareSheet | null {
  return pendingSheet;
}

/** 分享到女娲：关掉面板后进入选会话页。 */
export function runShareToNuwax(): void {
  const sheet = pendingSheet;
  const title = sheet != null && sheet.title.length > 0 ? sheet.title : t("Mobile.Share.appName");
  const text = sheet != null && sheet.body.length > 0 ? sheet.body : title;
  closeShareSheetThen(() => {
    if (hasLoginSession() != true) {
      uni.showToast({ title: t("Mobile.Share.loginRequired"), icon: "none" });
      redirectToLoginOnce();
      return;
    }
    openShareIntoChat(title, text);
  });
}

/** 分享到其他应用：交给调用方原来的系统分享或复制。 */
export function runShareOutside(): void {
  const fn = pendingOutside;
  closeShareSheetThen(fn);
}

/**
 * 刷新当前页。调用方打开面板时传入了刷新函数才执行，否则返回 false 由面板提示占位。
 */
export function runShareRefresh(): boolean {
  const fn = pendingRefresh;
  if (fn == null) return false;
  closeShareSheetThen(() => {
    fn();
    uni.showToast({ title: t("Mobile.Share.refreshed"), icon: "none" });
  });
  return true;
}

/** 点遮罩或取消。 */
export function dismissShareSheet(): void {
  closeShareSheetThen(null);
}

/**
 * 新分享先打开当前页里的分享面板：转发给女娲会话，或交给调用方继续系统分享 / 复制链接。
 * 开关关闭时不弹面板，直接走调用方原来的系统分享或复制。
 * 页面需挂 components/share-sheet。当前页没挂时退回两项菜单。
 * 微信小程序仍用两项菜单。
 * @param onRefresh 网页 / 文件预览的刷新；没有可刷新内容时传 null
 */
export function chooseShareTarget(
  title: string,
  body: string,
  shareOutside: () => void,
  onRefresh: (() => void) | null = null,
): void {
  if (USE_NEW_ARTIFACT_SHARE != true) {
    shareOutside();
    return;
  }
  const sheet = new PendingShareSheet();
  sheet.title = title;
  const internalBody = bodyWithActualPage(body.length > 0 ? body : title);
  sheet.body = internalBody.length > 0 ? internalBody : title;
  const found = httpUrlIn(body.length > 0 ? body : title);
  sheet.url = outgoingHttpUrl(found);
  const nested = queryValue(sheet.url, "url");
  const hostSource =
    nested.indexOf("https://") == 0 || nested.indexOf("http://") == 0 ? nested : sheet.url;
  sheet.host = hostOfHttp(hostSource);
  pendingSheet = sheet;
  pendingOutside = shareOutside;
  pendingRefresh = onRefresh;
  // #ifdef MP-WEIXIN
  clearPendingShare();
  showLegacyShareSheet(title, sheet.body, shareOutside);
  return;
  // #endif
  if (shareSheetBindings.length == 0) {
    clearPendingShare();
    showLegacyShareSheet(title, sheet.body, shareOutside);
    return;
  }
  shareSheetOpen = true;
  notifyTopShareSheet();
}

/** 唤起系统分享面板，把中转页发给微信等。 */
export function shareTarget(target: ShareTarget): void {
  const url = buildOutgoingShareUrl(target);
  const title = target.title.length > 0 ? target.title : t("Mobile.Share.appName");
  // #ifdef APP
  uni.shareWithSystem({
    type: "text",
    summary: "【" + title + "】",
    href: url,
    fail: (res: ShareWithSystemFail) => {
      if (res.errCode == 1310600) return;
      uni.setClipboardData({
        data: url,
        success: () => {
          uni.showToast({ title: t("Mobile.Share.linkCopied"), icon: "none" });
        },
      });
    },
  });
  // #endif
  // #ifndef APP
  uni.setClipboardData({
    data: url,
    success: () => {
      uni.showToast({ title: t("Mobile.Share.linkCopied"), icon: "none" });
    },
  });
  // #endif
}

/** 智能体、文件、网页直接进对应页面；其余仍进分享接收页。 */
function openTargetUrl(target: ShareTarget): string {
  const nativeRoute = nativeRouteFromConversationUrl(target.pageUrl, getApiBaseUrl());
  if (nativeRoute.length > 0) return nativeRoute;
  if (target.kind == "agent" && target.id.length > 0) {
    return "/subpackages/pages/agent-detail/agent-detail?id=" + encodeURIComponent(target.id);
  }
  const previewUrl = filePreviewUrl(target);
  if (previewUrl.length > 0) {
    return webviewRoute(previewUrl, target.title);
  }
  if (isHttpPageUrl(target.pageUrl)) {
    return webviewRoute(target.pageUrl, target.title);
  }
  return receiveUrl(target);
}

/** 文件分享优先打开带 sk 的预览地址，避免只剩标题时落到「没有可读文本」。 */
function filePreviewUrl(target: ShareTarget): string {
  const pointedAtFile = isHttpPageUrl(target.pageUrl) && target.pageUrl.indexOf("file-preview.html") >= 0;
  if (pointedAtFile) return target.pageUrl;
  if (target.sk.length == 0) return "";
  if (target.kind != "file" && target.kind != "page") return "";
  // 普通网页自己有地址时，不拿 sk 覆盖。
  if (target.kind == "page" && isHttpPageUrl(target.pageUrl)) return "";
  const base = sharePageOrigin();
  if (base.length == 0) return "";
  return base + "/static/file-preview.html?sk=" + encodeURIComponent(target.sk);
}

function webviewRoute(raw: string, title: string): string {
  return "/subpackages/pages/webview/webview?url=" + encodeURIComponent(raw);
}

function isHttpPageUrl(raw: string): boolean {
  const lower = raw.toLowerCase();
  return lower.indexOf("https://") == 0 || lower.indexOf("http://") == 0;
}

function receiveUrl(target: ShareTarget): string {
  let url = "/pages/share-receive/share-receive?kind=" + encodeURIComponent(target.kind);
  url = appendQuery(url, "id", target.id);
  url = appendQuery(url, "title", target.title);
  url = appendQuery(url, "sk", target.sk);
  url = appendQuery(url, "text", target.text);
  url = appendQuery(url, "file", target.filePath);
  url = appendQuery(url, "to", target.pageUrl);
  url = appendQuery(url, "sk", target.sk);
  return url;
}

/**
 * 冷启动时 onShow 先拿到协议。启动页再取走，避免这次地址被丢掉后进入首页。
 */
export function rememberColdStartScheme(raw: string): void {
  if (raw.length == 0) return;
  coldStartScheme = raw;
}

/** 取走冷启动协议。没有则返回空串，调用方再读本次启动参数。 */
export function takeColdStartScheme(): string {
  const raw = coldStartScheme;
  coldStartScheme = "";
  return raw;
}

/**
 * 冷启动或回前台时按外部链接进入对应页面。
 * 不记录「已经打开过」：每次唤起都进入该页面。
 * 连点由中转页在 App 还没起来时挡住。
 * 智能体 / 文件可未登录打开；文本图片进来需已登录，否则先记下再去登录。
 */
export function routeIncomingShare(hasToken: boolean, schemeFromShow: string): boolean {
  const fromShow = schemeFromShow.length > 0 ? schemeFromShow : "";
  const raw = fromShow.length > 0 ? fromShow : readEnterRaw();
  const target = parseShareUrl(raw);
  if (target == null) return false;
  // 文件和网页靠 sk / 页面地址就能看，不要求先登录。文本、图片、会话摘要仍要登录。
  const inbound = target.kind == "text" || target.kind == "image" || target.kind == "message";
  if (inbound && hasToken != true) {
    saveShareTarget(target);
    return false;
  }
  uni.reLaunch({ url: openTargetUrl(target) });
  return true;
}

export function routePendingAfterLogin(): void {
  const target = peekShareTarget();
  if (target == null) return;
  consumeShareTarget();
  uni.reLaunch({ url: openTargetUrl(target) });
}
