/**
 * 从网络层返回的 Map / UTSJSONObject 安全读取字段。
 * 放在主包 utils，避免主包模块反向依赖 subpackages。
 */
export function readRawField(raw: any | null, key: string): any | null {
  if (raw == null || key.length == 0) {
    return null;
  }

  try {
    const map = raw as Map<string, any | null>;
    if (map.has(key)) {
      return map.get(key);
    }
    const mapValue = map.get(key);
    if (mapValue != null) {
      return mapValue;
    }
  } catch (_mapError) {
    // 非 Map，继续尝试 UTSJSONObject。
  }

  try {
    const object = raw as UTSJSONObject;
    const value = object[key];
    if (value != null) {
      return value;
    }
  } catch (_objectError) {
    // 非 UTSJSONObject。
  }

  return null;
}
