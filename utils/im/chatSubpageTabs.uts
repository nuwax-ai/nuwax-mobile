/**
 * 聊天页顶部「子页签」的注册表、可见性投影与显隐偏好。
 *
 * <p>对齐 PC nuwax-im-web 的 {@code lib/topTabs.ts}，但**只取内置页签那一段**：
 * App 端已用独立子页面承载的群公告 / 入群申请 / 设置 / 成员<b>不上页签行</b>
 * （用户 2026-11-06 定：这些功能保持现有入口不变）。
 *
 * <h2>两套真源，别混</h2>
 * <ul>
 *   <li><b>内置页签显隐</b>：本文件，存本地（{@link TAB_PREF_KEY}），不跨设备；</li>
 *   <li><b>自定义链接</b>：服务端 im_custom_link，会话成员共享（见 utils/im/chatCustomTabs.uts）。</li>
 * </ul>
 *
 * <h2>三条不能破的规则</h2>
 * <ol>
 *   <li>「消息」是锚点：任何情况下都在、且不可移除（去掉它这个页面就没地方看消息了）；</li>
 *   <li>偏好只决定<b>显隐</b>，不决定<b>顺序</b> —— 顺序永远按 {@link CHAT_SUBPAGE_TAB_DEFS}
 *       的声明顺序，避免"我调了顺序但界面没变"；</li>
 *   <li>★<b>iOS 的 {@code uni.getStorageSync} 读不存在的 key 会抛异常</b>（"返回值为：undefined"
 *       的框架日志，实测会打断调用方同步栈）⇒ 读取必须 try-catch，且缺省要能回落成全量显示。</li>
 * </ol>
 */

/** 内置页签名（★改 key = 让所有老用户的偏好里这一项被静默丢弃，不要动）。 */
export const CHAT_TAB_MESSAGES = "messages";
export const CHAT_TAB_PIN = "pin";
export const CHAT_TAB_LIBRARY = "library";
export const CHAT_TAB_FILES = "files";

/** 显隐偏好的本地存储键。 */
export const TAB_PREF_KEY = "nuwax-chat-subpage-tabs";

/** 一个内置页签的定义。 */
export class ChatSubpageTabDef {
  /** 页签 key（= 渲染用的 id）。 */
  key: string = "";
  /** 文案 i18n key。 */
  labelKey: string = "";
  /** 图标（96×96 PNG，三端同规格；★勿换 SVG——`<image>` 对 svg 三端支持不一致）。 */
  icon: string = "";
  /** 能否被「管理标签页」移除；锚点恒 false。 */
  removable: boolean = true;
  /** 只在群式会话里有意义。 */
  groupOnly: boolean = false;
  /** 与智能体的单聊里隐藏（点进去没有内容）。 */
  hiddenInAgentP2p: boolean = false;
  /** 系统通知会话里隐藏。 */
  hiddenInSystemConv: boolean = false;
}

function makeTabDef(
  key: string,
  labelKey: string,
  icon: string,
  removable: boolean,
  groupOnly: boolean,
  hiddenInAgentP2p: boolean,
  hiddenInSystemConv: boolean,
): ChatSubpageTabDef {
  const def = new ChatSubpageTabDef();
  def.key = key;
  def.labelKey = labelKey;
  def.icon = icon;
  def.removable = removable;
  def.groupOnly = groupOnly;
  def.hiddenInAgentP2p = hiddenInAgentP2p;
  def.hiddenInSystemConv = hiddenInSystemConv;
  return def;
}

/**
 * 全部内置页签（声明顺序 = 标签行顺序 = 「添加标签页」菜单里的呈现顺序）。
 *
 * ★图标 96×96 PNG：与 static/images/icon-tab-*.png 同规格，Android / iOS / 鸿蒙
 *   三端都按位图渲染，不存在 svg 解析差异（此前踩过坑）。
 */
export const CHAT_SUBPAGE_TAB_DEFS: ChatSubpageTabDef[] = [
  makeTabDef(CHAT_TAB_MESSAGES, "Mobile.Message.chatTabMessages", "/static/images/icon-tab-messages.png", false, false, false, false),
  makeTabDef(CHAT_TAB_PIN, "Mobile.Message.chatTabPin", "/static/images/icon-tab-pin.png", true, false, false, false),
  makeTabDef(CHAT_TAB_LIBRARY, "Mobile.Message.chatTabLibrary", "/static/images/icon-tab-library.png", true, false, true, true),
  makeTabDef(CHAT_TAB_FILES, "Mobile.Message.chatTabFiles", "/static/images/icon-tab-files.png", true, false, false, false),
];

/** 默认偏好：全量显示（与 2026-11-06 之前的写死行为逐字一致）。 */
export function defaultChatTabKeys(): string[] {
  const keys: string[] = [];
  for (let i = 0; i < CHAT_SUBPAGE_TAB_DEFS.length; i++) {
    keys.push(CHAT_SUBPAGE_TAB_DEFS[i].key);
  }
  return keys;
}

/** 这个 key 是不是已注册的内置页签。 */
export function isKnownChatTabKey(key: string): boolean {
  for (let i = 0; i < CHAT_SUBPAGE_TAB_DEFS.length; i++) {
    if (CHAT_SUBPAGE_TAB_DEFS[i].key == key) {
      return true;
    }
  }
  return false;
}

/** 按 key 取定义；取不到返回 null。 */
export function chatTabDefOf(key: string): ChatSubpageTabDef | null {
  for (let i = 0; i < CHAT_SUBPAGE_TAB_DEFS.length; i++) {
    if (CHAT_SUBPAGE_TAB_DEFS[i].key == key) {
      return CHAT_SUBPAGE_TAB_DEFS[i];
    }
  }
  return null;
}

/**
 * 归一化一组偏好 key：
 * 1. 丢弃不认识的 key（老版本偏好里的残留）；
 * 2. 去重；
 * 3. 锚点「消息」恒补回；
 * 4. 按声明顺序稳定重排（偏好**不**决定顺序）。
 */
export function normalizeChatTabKeys(keys: string[]): string[] {
  const allowed = new Set<string>();
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    if (key.length > 0 && isKnownChatTabKey(key)) {
      allowed.add(key);
    }
  }
  // 锚点：删不掉、去不掉的「消息」
  allowed.add(CHAT_TAB_MESSAGES);
  const out: string[] = [];
  for (let i = 0; i < CHAT_SUBPAGE_TAB_DEFS.length; i++) {
    const key = CHAT_SUBPAGE_TAB_DEFS[i].key;
    if (allowed.has(key)) {
      out.push(key);
    }
  }
  return out;
}

/**
 * 读显隐偏好。
 *
 * ★没存过 / 存储读失败 / JSON 坏了，一律回落「全量显示」——宁可多显示一个页签，
 *   也不要把用户的标签行清空（"我的页签没了"是查不出线索的那种 bug）。
 * ★iOS 缺 key 会抛异常，必须包在 try 里（见文件头第三条规则）。
 */
export function readChatTabPrefs(): string[] {
  try {
    // ★声明成 any | null：getStorageSync 的返回是 Any?，写成 any 会让 Kotlin 报
    //   「Initializer type mismatch: expected 'Any', actual 'Any?'」
    const raw: any | null = uni.getStorageSync(TAB_PREF_KEY);
    const text = raw != null ? `${raw}` : "";
    if (text.length == 0) {
      return defaultChatTabKeys();
    }
    // 与 utils/conversationListCache 同款写法：先收 any | null，判过 Array 再转 any[]
    // （直接把 JSON.parse 的结果 as any[] 会撞 "expected 'Any', actual 'Any?'"）
    const parsedRaw: any | null = JSON.parse(text);
    if (parsedRaw == null || !Array.isArray(parsedRaw)) {
      return defaultChatTabKeys();
    }
    const parsed = parsedRaw as any[];
    const keys: string[] = [];
    for (let i = 0; i < parsed.length; i++) {
      const item = parsed[i];
      if (item != null) {
        keys.push(`${item}`);
      }
    }
    if (keys.length == 0) {
      return defaultChatTabKeys();
    }
    return normalizeChatTabKeys(keys);
  } catch (_error) {
    return defaultChatTabKeys();
  }
}

/** 写显隐偏好（先归一化再落盘；写失败静默——下次读取会回落默认值）。 */
export function saveChatTabPrefs(keys: string[]): string[] {
  const normalized = normalizeChatTabKeys(keys);
  try {
    uni.setStorageSync(TAB_PREF_KEY, JSON.stringify(normalized));
  } catch (_error) {
    // 存储写满/无权限：不阻断用户当前操作，下次进页回落默认值
  }
  return normalized;
}

/**
 * 可见性投影（对齐 PC {@code isTabAllowedIn} 的四条判据，逐条分开、各自 return）。
 *
 * ★三个参数都由调用方按会话算好传进来：本文件不认识会话对象，也不按 id 段位猜。
 * ★判据方向统一是「少显示」：算不出来时传 false（fail-open），宁可短暂多显示，
 *   也不要把普通会话的页签误藏（藏错的代价更大，且刷新即自愈）。
 */
export function isChatTabAllowedIn(
  def: ChatSubpageTabDef,
  isGroup: boolean,
  isAgentP2p: boolean,
  isSystemConv: boolean,
): boolean {
  if (def.groupOnly && !isGroup) {
    return false;
  }
  if (def.hiddenInAgentP2p && isAgentP2p) {
    return false;
  }
  if (def.hiddenInSystemConv && isSystemConv) {
    return false;
  }
  return true;
}

/** 「添加标签页」菜单里可添加的内置页签：当前偏好里没有、且可移除的。 */
export function missingChatTabKeys(prefs: string[]): string[] {
  const shown = new Set<string>();
  for (let i = 0; i < prefs.length; i++) {
    shown.add(prefs[i]);
  }
  const out: string[] = [];
  for (let i = 0; i < CHAT_SUBPAGE_TAB_DEFS.length; i++) {
    const def = CHAT_SUBPAGE_TAB_DEFS[i];
    if (!def.removable) {
      continue;
    }
    if (!shown.has(def.key)) {
      out.push(def.key);
    }
  }
  return out;
}

/** 从偏好里移除一个内置页签（锚点拒绝移除，原样返回）。 */
export function removeChatTabKey(prefs: string[], key: string): string[] {
  const def = chatTabDefOf(key);
  if (def == null || !def.removable) {
    return normalizeChatTabKeys(prefs);
  }
  const next: string[] = [];
  for (let i = 0; i < prefs.length; i++) {
    if (prefs[i] != key) {
      next.push(prefs[i]);
    }
  }
  return normalizeChatTabKeys(next);
}

/** 往偏好里加一个内置页签（幂等）。 */
export function addChatTabKey(prefs: string[], key: string): string[] {
  if (!isKnownChatTabKey(key)) {
    return normalizeChatTabKeys(prefs);
  }
  const next = prefs.slice(0);
  next.push(key);
  return normalizeChatTabKeys(next);
}
