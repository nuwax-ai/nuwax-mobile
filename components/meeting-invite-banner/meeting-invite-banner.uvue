<template>
  <view v-if="visible" class="meeting-invite-banner" :style="{ top: topPx + 'px' }">
    <view class="mib-avatar">
      <image
        v-if="avatarUrl.length > 0 && !avatarFailed"
        class="mib-avatar-img"
        :src="avatarUrl"
        mode="aspectFill"
        @error="handleAvatarError"
      />
      <text v-else class="mib-avatar-text">{{ initial }}</text>
    </view>
    <view class="mib-body">
      <text class="mib-title">{{ titleText }}</text>
      <text v-if="subtitle.length > 0" class="mib-sub">{{ subtitle }}</text>
    </view>
    <view class="mib-actions">
      <view class="mib-btn mib-reject" @click.stop="reject">
        <text class="mib-btn-text mib-reject-text">忽略</text>
      </view>
      <view class="mib-btn mib-join" @click.stop="join">
        <text class="mib-btn-text mib-join-text">{{ joinText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, onMounted, onUnmounted, ref, watch } from "vue";
import { meetingInviteBanner, hideMeetingInviteBanner } from "@/utils/im/meetingInviteBanner";
import { startForegroundCallAlert, stopForegroundCallAlert } from "@/utils/im/foregroundCallAlert";
import { apiImMeetingInviteHandled, apiImMeetingPublicRoomSafe } from "@/servers/imMeeting";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { apiResCode, apiResData } from "@/utils/apiResponse";
import { imAvatarDisplayUrl, resolveImAvatarDisplay, resolveImAvatarReference } from "@/utils/imAvatarDisplay";
import { isAuthProtectedFileUrl } from "@/utils/authProtectedFileUrl";
import { getApiBaseUrl } from "@/constants/config";
import { emptyI18nParams, t } from "@/utils/i18n";
import { openMeetingInvite } from "@/utils/meeting/meetingInviteNavigation";
// #ifdef APP-HARMONY
import { markNativeMeetingInviteHandled } from "@/features/voip/integration";
// #endif

const visible = computed((): boolean => meetingInviteBanner.value != null);
const joinText = computed((): string => t("Mobile.Meeting.enterRoom", emptyI18nParams(), ""));
const topPx = ref<number>(8);
let hideTimer = 0;
/** 邀请条展示期间轮询会议状态（主持人结束会议后不必等满 60 秒）。 */
const ROOM_POLL_INTERVAL_MS = 20_000;
let roomPollTimer = 0;
let roomPollRequest = 0;
const alertOwner = "meeting-banner-" + Date.now() + "-" + Math.floor(Math.random() * 1000000);

try {
  const info = uni.getWindowInfo();
  topPx.value = (info.statusBarHeight ?? 0) + 8;
} catch (_e) {
  topPx.value = 8;
}

const field = (key: string): string => {
  const value = meetingInviteBanner.value;
  return value == null ? "" : `${value[key] ?? ""}`;
};

/** 头像加载失败退回「首字圆」；Android 原生事件里不直接写响应式，挪到 setTimeout。 */
const avatarFailed = ref<boolean>(false);
const resolvedAvatar = ref<string>("");
let avatarRequest = 0;
function handleAvatarError(): void {
  const request = avatarRequest;
  setTimeout(() => { if (request == avatarRequest) avatarFailed.value = true; }, 0);
}

const initial = computed((): string => {
  const name = field("senderName");
  return name.length > 0 ? name.charAt(0) : "会";
});

/** 邀请人真实头像（受保护地址会换成带票的展示地址）。 */
const avatarUrl = computed((): string => {
  if (avatarFailed.value) return "";
  return resolvedAvatar.value;
});

const titleText = computed((): string => {
  const name = field("senderName");
  return name.length > 0 ? `${name} 邀请您参加会议` : "邀请您参加会议";
});

// 只展示会议主题：横幅里不再拼「语音会议/视频会议」这类媒体类型
const subtitle = computed((): string => field("title"));

function clearTimer(): void {
  if (hideTimer != 0) {
    clearTimeout(hideTimer);
    hideTimer = 0;
  }
}

/** 停掉状态轮询，并让在途请求的结果失效（避免旧房间的响应收掉新邀请条）。 */
function stopRoomPoll(): void {
  roomPollRequest++;
  if (roomPollTimer != 0) {
    clearInterval(roomPollTimer);
    roomPollTimer = 0;
  }
}

function readRoomStatus(data: UTSJSONObject): number {
  const raw = data["status"];
  if (raw == null) return -1;
  if (typeof raw == "number") return raw as number;
  const parsed = parseInt(`${raw}`, 10);
  return isNaN(parsed) ? -1 : parsed;
}

/**
 * 邀请条展示期间核对房间状态：主持人结束/取消会议后尽快收起，不必等 60 秒自然到期。
 *
 * ★判定口径对齐 PC（MeetingInviteCard）：只有服务端明确返回「已结束(2)/已取消(3)」才收起；
 *   查询失败、无记录（status 为空）一律保持原样 —— 绝不凭一次网络抖动把还能进的会判成结束。
 * ★收起时顺手上报 handled，让本账号其它设备（含原生来电通道）一起停铃。
 * ★轮询只覆盖 App 前台/进程存活的场景；后台熄屏的原生响铃仍以 60 秒过期为准。
 */
async function pollRoomStatus(): Promise<void> {
  // ★身份在发请求前拍快照：请求返回时邀请条可能已经换成另一条，
  //   不能拿旧房间的状态去收新邀请（watch 的 token 失效要等下一次 tick，可能晚于本回调）。
  const room = field("roomName");
  const inviteId = field("inviteId");
  const convId = field("convId");
  const msgId = field("msgId");
  if (room.length == 0) return;
  const request = roomPollRequest;
  let status = -1;
  try {
    const res = await apiImMeetingPublicRoomSafe(room);
    if (request != roomPollRequest) return;
    if (apiResCode(res) != SUCCESS_CODE) return;
    const data = apiResData<any>(res);
    if (data != null) status = readRoomStatus(data as UTSJSONObject);
  } catch (_error) {
    return;
  }
  if (request != roomPollRequest || (status != 2 && status != 3)) return;
  if (field("inviteId") != inviteId || field("roomName") != room) return;
  if (inviteId.length > 0) {
    // #ifdef APP-HARMONY
    // 原生卡片按 msgId 匹配；事件版邀请没有消息坐标，无需通知原生。
    if (msgId.length > 0) markNativeMeetingInviteHandled(msgId);
    // #endif
    // 第 5 参用默认值：自动收条是后台动作，失败不弹提示。
    apiImMeetingInviteHandled(convId, msgId, inviteId, room);
  }
  // watch 收到 null 后会停铃、清轮询与 60 秒隐藏计时器。
  hideMeetingInviteBanner();
}

function syncInvite(): void {
  clearTimer();
  stopRoomPoll();
  const request = ++avatarRequest;
  resolvedAvatar.value = "";
  // 换了一条邀请：头像失败标记跟着复位，避免上一个人的失败状态遮住新头像
  avatarFailed.value = false;
  if (meetingInviteBanner.value == null) {
    stopForegroundCallAlert(alertOwner);
    return;
  }
  let visibleFor = 60_000;
  // #ifdef APP-HARMONY
  const expiresAt = field("expiresAt");
  if (expiresAt.length > 0) {
    visibleFor = Math.min(visibleFor, parseFloat(expiresAt) - Date.now());
    if (!(visibleFor > 0)) {
      stopForegroundCallAlert(alertOwner);
      hideMeetingInviteBanner();
      return;
    }
  }
  // #endif
  const avatar = resolveImAvatarReference(field("senderAvatar"));
  if (avatar.length > 0) {
    if (isAuthProtectedFileUrl(avatar) && !avatar.startsWith(getApiBaseUrl() + "/")) {
      resolvedAvatar.value = avatar;
    } else {
      resolvedAvatar.value = imAvatarDisplayUrl(avatar, 72);
      resolveImAvatarDisplay(avatar, 72).then((resolved: string): void => {
        if (request == avatarRequest && resolved != resolvedAvatar.value) {
          avatarFailed.value = false;
          resolvedAvatar.value = resolved;
        }
      });
    }
  }
  startForegroundCallAlert(alertOwner);
  hideTimer = setTimeout(() => {
    hideMeetingInviteBanner();
  }, visibleFor);
  roomPollTimer = setInterval(() => {
    void pollRoomStatus();
  }, ROOM_POLL_INTERVAL_MS);
}

// 邀请条只做前台提示；60 秒后自动收起，期间每 20 秒核对一次会议是否已结束。
watch(meetingInviteBanner, () => { syncInvite(); });

onMounted(() => { syncInvite(); });

onUnmounted(() => {
  avatarRequest++;
  clearTimer();
  stopRoomPoll();
  stopForegroundCallAlert(alertOwner);
});

function dismiss(): void {
  clearTimer();
  hideMeetingInviteBanner();
}

function reportHandled(accepted: boolean): void {
  const inviteId = field("inviteId");
  const convId = field("convId");
  const msgId = field("msgId");
  const room = field("roomName");
  // ★事件版邀请（3007 meeting:invite）没有 convId/msgId，只按 inviteId 上报；
  //   消息版仍带消息坐标（服务端据此校验归属）。
  if (inviteId.length > 0) {
    // #ifdef APP-HARMONY
    if (msgId.length > 0) markNativeMeetingInviteHandled(msgId);
    // #endif
    apiImMeetingInviteHandled(convId, msgId, inviteId, room, accepted);
  }
}

function reject(): void {
  reportHandled(false);
  dismiss();
}

function join(): void {
  const inviteId = field("inviteId");
  const room = field("roomName");
  const title = field("title");
  // 被直接邀请的人不应再被密码拦一次：邀请消息里带了密码就随 query 带给令牌接口
  const passcode = field("passcode");
  reportHandled(true);
  dismiss();
  if (room.length == 0) return;
  openMeetingInvite(inviteId, room, title, passcode);
}
</script>

<style>
.meeting-invite-banner {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  z-index: 99999;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
}

.mib-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #3b6cff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mib-avatar-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.mib-avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
}

.mib-body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  margin-right: 12rpx;
  display: flex;
  flex-direction: column;
}

.mib-title {
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 600;
  lines: 1;
  text-overflow: ellipsis;
}

.mib-sub {
  margin-top: 6rpx;
  color: #646a73;
  font-size: 24rpx;
  lines: 1;
  text-overflow: ellipsis;
}

.mib-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.mib-btn {
  height: 56rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mib-reject {
  background-color: #f2f3f5;
  margin-right: 12rpx;
}

/* 加入按钮用项目统一的黑色主按钮（与会议页/表单主操作同色） */
.mib-join {
  background-color: #111111;
}

.mib-btn-text {
  font-size: 24rpx;
}

.mib-reject-text {
  color: #646a73;
}

.mib-join-text {
  color: #ffffff;
}
</style>
