/**
 * IM 文件「已下载」注册表（本地持久化，供文件卡片/文件详情页显示下载状态）。
 *
 * 写入方：subpackages/utils/fileTree.uts downloadFileInApp —— App 端全部下载
 * （聊天气泡 / 合并转发 / 文件树 / 文件详情页）的唯一汇合点，成功即按文件名打标；
 * im-file-detail 页自身下载后再按本页键（fileName 优先，缺省 url）补标一次。
 *
 * 存储：uni storage key `im_file_downloaded`，结构 {version:1, downloaded:string[]}；
 * 上限 500 条滚动裁剪（旧的下头部），全程容错（坏数据当未下载）。
 * 注意：H5 下载由浏览器接管，本注册表只对 App 端展示有意义（H5 卡片不显示状态）。
 */

const IM_FILE_DOWNLOADED_KEY = "im_file_downloaded";
const IM_FILE_DOWNLOADED_VERSION = 1;
const IM_FILE_DOWNLOADED_MAX = 500;

/** 登记键：fileName 优先（downloadFileInApp 只知道文件名，故名为主键），缺省回落 url。 */
export function imFileDownloadKey(fileName: string, url: string): string {
  return fileName.length > 0 ? fileName : url;
}

function readDownloadedKeys(): string[] {
  const out: string[] = [] as string[];
  try {
    const raw = uni.getStorageSync(IM_FILE_DOWNLOADED_KEY);
    if (raw == null) {
      return out;
    }
    const text = `${raw}`;
    if (text.length == 0) {
      return out;
    }
    const parsed = JSON.parse(text);
    if (parsed == null || typeof parsed != "object") {
      return out;
    }
    const obj = parsed as UTSJSONObject;
    const listRaw = obj["downloaded"];
    if (listRaw == null || Array.isArray(listRaw) != true) {
      return out;
    }
    const arr = listRaw as any[];
    for (let i = 0; i < arr.length; i++) {
      const value = arr[i];
      if (value == null) {
        continue;
      }
      const s = `${value}`;
      if (s.length > 0) {
        out.push(s);
      }
    }
  } catch (_e) {
    // 容错：坏数据当空处理
  }
  return out;
}

function writeDownloadedKeys(keys: string[]): void {
  try {
    const obj = new UTSJSONObject();
    obj["version"] = IM_FILE_DOWNLOADED_VERSION;
    obj["downloaded"] = keys;
    uni.setStorageSync(IM_FILE_DOWNLOADED_KEY, JSON.stringify(obj));
  } catch (_e) {
    // 写失败静默（状态展示非关键数据）
  }
}

/** 标记已下载（已存在则不动；超限裁最旧）。 */
export function markImFileDownloaded(key: string): void {
  if (key.length == 0) {
    return;
  }
  const keys = readDownloadedKeys();
  if (keys.indexOf(key) >= 0) {
    return;
  }
  keys.push(key);
  if (keys.length > IM_FILE_DOWNLOADED_MAX) {
    keys.splice(0, keys.length - IM_FILE_DOWNLOADED_MAX);
  }
  writeDownloadedKeys(keys);
}

/** 是否已下载（键为空/坏数据一律 false，不抛错）。 */
export function isImFileDownloaded(key: string): boolean {
  if (key.length == 0) {
    return false;
  }
  return readDownloadedKeys().indexOf(key) >= 0;
}

/** 撤销打标（im-file-detail 实查发现文件已被用户删除时纠偏，聊天页等列表同步回「未下载」）。 */
export function unmarkImFileDownloaded(key: string): void {
  if (key.length == 0) {
    return;
  }
  const keys = readDownloadedKeys();
  const idx = keys.indexOf(key);
  if (idx < 0) {
    return;
  }
  keys.splice(idx, 1);
  writeDownloadedKeys(keys);
}
