// 环境配置
// 使用uni-app的条件编译来处理不同环境

export const API_BASE_URL_STORAGE_KEY = "NUWAX_API_BASE_URL";

let DEFAULT_API_BASE_URL = "";
let API_BASE_URL = "";
// Nuwax Vox 设备语音网关 / App BFF（设备绑定、会议、推送消息）
let VOX_BASE_URL = "";

// uEnvProd
if (process.env.NODE_ENV === "production") {
  // #ifdef MP-WEIXIN || APP
  DEFAULT_API_BASE_URL = "https://agent.nuwax.com";
  // #endif
}

// uEnvDev
if (process.env.NODE_ENV === "development") {
  DEFAULT_API_BASE_URL = "https://testagent.xspaceagi.com";
}

/**
 * 规范化用户输入的服务地址。
 * App 端接受 HTTP/HTTPS origin，不允许携带路径、查询参数或 hash。
 * 用户可只输入域名，客户端会自动补全 https://。
 */
export function normalizeApiBaseUrl(input: string): string {
  let value = input.trim();
  if (value.length == 0) return "";

  const lowerValue = value.toLowerCase();
  let scheme = "https://";
  let rest = value;
  if (lowerValue.startsWith("https://")) {
    scheme = "https://";
    rest = value.substring(8);
  } else if (lowerValue.startsWith("http://")) {
    scheme = "http://";
    rest = value.substring(7);
  } else if (value.includes("://")) {
    return "";
  }

  if (rest.includes("@") || rest.includes("?") || rest.includes("#")) {
    return "";
  }

  for (let i = 0; i < rest.length; i++) {
    const codeRaw = rest.charCodeAt(i);
    if (codeRaw == null || (codeRaw as number) <= 32) return "";
  }

  const slashIdx = rest.indexOf("/");
  if (slashIdx >= 0) {
    if (slashIdx != rest.length - 1) {
      return "";
    }
    rest = rest.substring(0, rest.length - 1);
  }

  if (rest.length == 0) {
    return "";
  }

  return scheme + rest;
}

function readStoredApiBaseUrl(): string {
  try {
    const raw = uni.getStorageSync(API_BASE_URL_STORAGE_KEY);
    if (raw == null) return "";
    return normalizeApiBaseUrl(`${raw}`);
  } catch (_error) {
    return "";
  }
}

API_BASE_URL = readStoredApiBaseUrl();
if (API_BASE_URL.length == 0) API_BASE_URL = DEFAULT_API_BASE_URL;

// Vox 网关跟随当前运行时主域名，不再写死内网 IP+端口
VOX_BASE_URL = API_BASE_URL;

export function getDefaultApiBaseUrl(): string {
  return DEFAULT_API_BASE_URL;
}

export function getApiBaseUrl(): string {
  return API_BASE_URL;
}

export function getVoxBaseUrl(): string {
  return VOX_BASE_URL;
}

/** 是否存在用户手动验证并保存的企业域名。 */
export function hasConfiguredApiBaseUrl(): boolean {
  try {
    const raw = uni.getStorageSync(API_BASE_URL_STORAGE_KEY);
    return raw != null && normalizeApiBaseUrl(`${raw}`).length > 0;
  } catch (_error) {
    return false;
  }
}

/** 保存并立即应用新的运行时服务域名。 */
export function setApiBaseUrl(value: string): boolean {
  const normalized = normalizeApiBaseUrl(value);
  if (normalized.length == 0) return false;
  API_BASE_URL = normalized;
  VOX_BASE_URL = normalized;
  uni.setStorageSync(API_BASE_URL_STORAGE_KEY, normalized);
  return true;
}

/** 清除手动域名配置并恢复当前环境的女娲个人版默认域名。 */
export function resetApiBaseUrl(): void {
  API_BASE_URL = DEFAULT_API_BASE_URL;
  VOX_BASE_URL = DEFAULT_API_BASE_URL;
  uni.removeStorageSync(API_BASE_URL_STORAGE_KEY);
}

/** 清理业务缓存时保留当前服务域名，避免退出登录后企业配置丢失。 */
export function clearStoragePreservingApiBaseUrl(): void {
  const current = API_BASE_URL;
  const shouldPreserve = hasConfiguredApiBaseUrl();
  uni.clearStorageSync();
  if (shouldPreserve && current.length > 0) {
    uni.setStorageSync(API_BASE_URL_STORAGE_KEY, current);
  }
}

// 允许外部链接跳转的域名
export const ALLOW_EXTERNAL_LINK_DOMAIN = ["https://nuwax.com"];

// 不需要登录检查的地址
export const NO_LOGIN_CHECK_URL = [
  "https://nuwax.com/user-agreement.html",
  "https://nuwax.com/privacy.html",
];

// 登录白名单地址
export const LOGIN_WHITELIST_URL = [
  "/api/user/getLoginInfo",
];

// API_BASE_URL / VOX_BASE_URL 为 let 声明，单独导出；其余常量已在声明处直接导出
export { API_BASE_URL, VOX_BASE_URL };
