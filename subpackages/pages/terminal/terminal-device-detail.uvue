<template>
  <view class="container relative flex flex-col">
    <!-- 顶部导航栏 -->
    <custom-nav-bar :title="deviceName" className="border-b" hasSafetyZone showBack />

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <!-- 头部 -->
      <view class="detail-header">
        <view :class="['detail-icon', isLingzhu ? '' : 'detail-icon-computer']">
          <text class="detail-icon-emoji">{{ isLingzhu ? "🔮" : "💻" }}</text>
        </view>
        <text class="detail-name">{{ deviceName }}</text>
        <view class="detail-status">
          <text class="detail-status-text">{{ isLingzhu ? t("Mobile.Terminal.lingzhuTerminal") : t("Mobile.Terminal.computerTerminal") }} · {{ deviceOnline ? t("Mobile.Terminal.connected") : t("Mobile.Terminal.disconnected") }}</text>
          <!-- 灵珠快捷入口：对话 / 组员管理 -->
          <template v-if="isLingzhu">
            <view class="quick-btn" @click="handleOpenChat">
              <text class="quick-btn-emoji">💬</text>
            </view>
            <view class="quick-btn" @click="handleGroupMembers">
              <text class="quick-btn-emoji">👥</text>
            </view>
          </template>
        </view>
      </view>

      <!-- 名称 -->
      <view class="field-label">{{ isLingzhu ? t("Mobile.Terminal.deviceName") : t("Mobile.Terminal.computerName") }}</view>
      <view class="field-input-box">
        <input class="field-input" v-model="editName" placeholder="" placeholder-class="field-placeholder" @blur="handleNameChange" />
      </view>
      <text v-if="isLingzhu" class="field-tip">{{ t("Mobile.Terminal.wakeTip") }}</text>

      <!-- ===== 灵珠专属：模式选择 ===== -->
      <template v-if="isLingzhu">
        <view class="field-label">{{ t("Mobile.Terminal.modeSelect") }}</view>
        <view class="mode-row">
          <view
            v-for="mode in modeList"
            :key="mode.key"
            :class="['mode-btn', activeMode == mode.key ? 'mode-btn-on' : '']"
            @click="handleModeSwitch(mode.key)"
          >
            <text :class="['mode-btn-text', activeMode == mode.key ? 'mode-btn-text-on' : '']">{{ mode.label }}</text>
          </view>
        </view>

        <!-- 会议记录 / 监控记录入口 -->
        <view class="record-row">
          <view class="record-btn" hover-class="record-btn-active" @click="handleMeetingRecords">
            <text class="record-btn-text">{{ t("Mobile.Terminal.meetingRecords") }}</text>
          </view>
          <view class="record-btn" hover-class="record-btn-active" @click="handleMonitorRecords">
            <text class="record-btn-text">{{ t("Mobile.Terminal.monitorRecords") }}</text>
          </view>
        </view>

        <!-- 对话模式配置 -->
        <template v-if="activeMode == 'chat'">
          <view class="field-label">{{ t("Mobile.Terminal.voiceBroadcast") }}</view>
          <view class="card-group">
            <view class="row-item" hover-class="row-item-active" @click="handleToggle('语音播报开关')">
              <view class="row-info">
                <text class="row-title">{{ t("Mobile.Terminal.voiceSwitch") }}</text>
                <text class="row-desc">{{ t("Mobile.Terminal.voiceSwitchDesc") }}</text>
              </view>
              <view class="pill-on"><text class="pill-on-text">{{ t("Mobile.Terminal.switchOn") }}</text></view>
            </view>
            <view class="row-item">
              <view class="row-info">
                <text class="row-title">{{ t("Mobile.Terminal.voiceVolume") }}</text>
              </view>
              <view class="volume-box">
                <text class="volume-label">{{ t("Mobile.Terminal.volumeLow") }}</text>
                <view class="volume-track">
                  <view class="volume-fill" :style="'width: ' + voiceVolume.toString() + '%;'"></view>
                </view>
                <text class="volume-label">{{ t("Mobile.Terminal.volumeHigh") }}</text>
              </view>
            </view>
          </view>
          <!-- 事件表情绑定 -->
          <event-emoji-bind />
        </template>

        <!-- 会议模式配置 -->
        <template v-if="activeMode == 'meeting'">
          <view class="field-label">{{ t("Mobile.Terminal.meetingMode") }}</view>
          <view class="card-group">
            <view class="row-item" hover-class="row-item-active" @click="handleMeetingModeToggle">
              <view class="row-info">
                <text class="row-title">{{ t("Mobile.Terminal.meetingMode") }}</text>
                <text class="row-desc">{{ t("Mobile.Terminal.meetingModeDesc") }}</text>
              </view>
              <view :class="meetingModeOn ? 'pill-on' : 'pill-off'">
                <text :class="meetingModeOn ? 'pill-on-text' : 'pill-off-text'">{{ meetingModeOn ? t("Mobile.Terminal.switchOn") : t("Mobile.Terminal.switchOff") }}</text>
              </view>
            </view>
          </view>
          <view class="field-label">{{ t("Mobile.Terminal.meetingPush") }}</view>
          <view class="card-group">
            <view class="row-item" v-for="item in pushChannelList" :key="item.key" hover-class="row-item-active" @click="handlePushChannelToggle(item)">
              <view class="row-info"><text class="row-title">{{ item.label }}</text></view>
              <view :class="item.enabled ? 'pill-on' : 'pill-off'">
                <text :class="item.enabled ? 'pill-on-text' : 'pill-off-text'">{{ item.enabled ? "✓" : "—" }}</text>
              </view>
            </view>
          </view>
          <event-emoji-bind />
        </template>

        <!-- 监控模式配置 -->
        <template v-if="activeMode == 'monitor'">
          <view class="field-label">{{ t("Mobile.Terminal.monitorContent") }}</view>
          <view class="card-group">
            <view class="row-item" v-for="item in monitorContentList" :key="item.title" hover-class="row-item-active" @click="handleToggle(item.title)">
              <view class="row-info">
                <text class="row-title">{{ item.title }}</text>
                <text class="row-desc">{{ item.desc }}</text>
              </view>
              <view class="pill-on"><text class="pill-on-text">{{ t("Mobile.Terminal.monitoring") }}</text></view>
            </view>
            <view class="row-item" hover-class="row-item-active" @click="handleToggle('添加监控内容')">
              <view class="row-info"><text class="row-title add-text">{{ t("Mobile.Terminal.addMonitorContent") }}</text></view>
            </view>
          </view>
          <view class="field-label">{{ t("Mobile.Terminal.alarmNotify") }}</view>
          <view class="card-group">
            <view class="row-item" v-for="item in alarmNotifyList" :key="item" hover-class="row-item-active" @click="handleToggle(item)">
              <view class="row-info"><text class="row-title">{{ item }}</text></view>
              <view class="pill-on"><text class="pill-on-text">✓</text></view>
            </view>
          </view>
          <event-emoji-bind />
        </template>
      </template>

      <!-- ===== 我的电脑专属：接入工具 ===== -->
      <template v-else>
        <view class="field-label">{{ t("Mobile.Terminal.accessTools") }}</view>
        <view class="card-group">
          <view class="row-item" v-for="tool in computerTools" :key="tool.name" hover-class="row-item-active" @click="handleToggle(tool.name)">
            <view class="row-avatar">
              <text class="row-avatar-emoji">{{ tool.icon }}</text>
            </view>
            <view class="row-info">
              <text class="row-title">{{ tool.name }}</text>
              <text class="row-desc">{{ tool.desc }}</text>
            </view>
            <text :class="['tool-status', tool.installed ? 'tool-status-on' : '']">{{ tool.installed ? t("Mobile.Terminal.installed") : t("Mobile.Terminal.notInstalled") }}</text>
            <text class="row-arrow">›</text>
          </view>
        </view>
      </template>

      <!-- 重新配网（仅网关已绑定的灵珠设备） -->
      <template v-if="isLingzhu && deviceId != ''">
        <view class="reprovision-btn" hover-class="reprovision-btn-active" @click="handleReprovision">
          <text class="reprovision-btn-text">{{ t("Mobile.Terminal.reprovision") }}</text>
        </view>
      </template>

      <!-- 解绑设备（仅网关已绑定的灵珠设备） -->
      <template v-if="isLingzhu && deviceId != ''">
        <view class="unbind-btn" hover-class="unbind-btn-active" @click="handleUnbind">
          <text class="unbind-btn-text">{{ t("Mobile.Terminal.unbindDevice") }}</text>
        </view>
      </template>

      <view class="bottom-space"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { orEmpty } from "@/utils/utsCoalesce.uts";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import EventEmojiBind from "./components/event-emoji-bind.uvue";
  import {
    apiVoxDeviceList,
    apiVoxRenameDevice,
    apiVoxUnbindDevice,
    apiVoxMeetingModeStart,
    apiVoxMeetingModeStop,
  } from "@/servers/vox/voxDevice";
  import { apiVoxGetPushSettings, apiVoxUpdatePushSettings } from "@/servers/vox/voxPushSettings";
  import { AppDeviceRenameParams } from "@/types/interfaces/voxDevice";
  import { AppMeetingPushSettingsUpdateParams } from "@/types/interfaces/voxPushSettings";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import { SUCCESS_CODE } from "@/constants/codes.constants";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // 设备类型 / 标识 / 名称
  const deviceType = ref<string>("lingzhu");
  const deviceId = ref<string>("");
  const deviceName = ref<string>("灵珠");
  const editName = ref<string>("灵珠");
  const deviceOnline = ref<boolean>(true);
  const meetingModeOn = ref<boolean>(false);

  // Android UTS：字符串比较用 ==
  const isLingzhu = computed((): boolean => deviceType.value == "lingzhu");

  // 模式
  const activeMode = ref<string>("chat");
  class ModeItem {
    key: string = "";
    label: string = "";
    constructor(key: string, label: string) {
      this.key = key;
      this.label = label;
    }
  }
  const modeList = ref<ModeItem[]>([]);

  // 音量
  const voiceVolume = ref<number>(70);

  // 会议推送渠道（网关 push-settings）
  class PushChannel {
    key: string = "";
    label: string = "";
    enabled: boolean = false;
    constructor(key: string, label: string, enabled: boolean) {
      this.key = key;
      this.label = label;
      this.enabled = enabled;
    }
  }
  const pushChannelList = ref<PushChannel[]>([]);

  const buildPushChannelList = (
    appEnabled: boolean, emailEnabled: boolean, feishuEnabled: boolean,
    wecomEnabled: boolean, dingtalkEnabled: boolean,
  ) => {
    pushChannelList.value = [
      new PushChannel("appEnabled", t("Mobile.Terminal.pushChannelApp"), appEnabled),
      new PushChannel("emailEnabled", t("Mobile.Terminal.pushChannelEmail"), emailEnabled),
      new PushChannel("feishuEnabled", t("Mobile.Terminal.pushChannelFeishu"), feishuEnabled),
      new PushChannel("wecomEnabled", t("Mobile.Terminal.pushChannelWecom"), wecomEnabled),
      new PushChannel("dingtalkEnabled", t("Mobile.Terminal.pushChannelDingtalk"), dingtalkEnabled),
    ];
  };

  const fetchPushSettings = async () => {
    try {
      const res = await apiVoxGetPushSettings();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          buildPushChannelList(
            d["appEnabled"] != null ? (d["appEnabled"] as boolean) : false,
            d["emailEnabled"] != null ? (d["emailEnabled"] as boolean) : false,
            d["feishuEnabled"] != null ? (d["feishuEnabled"] as boolean) : false,
            d["wecomEnabled"] != null ? (d["wecomEnabled"] as boolean) : false,
            d["dingtalkEnabled"] != null ? (d["dingtalkEnabled"] as boolean) : false,
          );
        }
      }
    } catch (e) {
      console.error("fetchPushSettings error", e);
    }
  };

  // 乐观更新 + 失败回滚
  const handlePushChannelToggle = async (channel: PushChannel) => {
    const next = !channel.enabled;
    channel.enabled = next;
    const params = new AppMeetingPushSettingsUpdateParams();
    if (channel.key == "appEnabled") params.appEnabled = next;
    else if (channel.key == "emailEnabled") params.emailEnabled = next;
    else if (channel.key == "feishuEnabled") params.feishuEnabled = next;
    else if (channel.key == "wecomEnabled") params.wecomEnabled = next;
    else if (channel.key == "dingtalkEnabled") params.dingtalkEnabled = next;
    try {
      const res = await apiVoxUpdatePushSettings(params);
      if (apiResCode(res) != SUCCESS_CODE) {
        channel.enabled = !next;
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.pushSettingFailed"), icon: "none" });
      }
    } catch (e) {
      channel.enabled = !next;
      console.error("handlePushChannelToggle error", e);
    }
  };

  // 监控内容（静态）
  class MonitorContent {
    title: string = "";
    desc: string = "";
    constructor(title: string, desc: string) {
      this.title = title;
      this.desc = desc;
    }
  }
  const monitorContentList = ref<MonitorContent[]>([
    new MonitorContent("线上故障", "匹配：挂了、崩了、故障、500、报错"),
    new MonitorContent("数据异常", "匹配：数据不对、数据丢失、数据恢复"),
    new MonitorContent("紧急上线", "匹配：紧急、马上部署、立刻上线"),
    new MonitorContent("安全风险", "匹配：漏洞、攻击、泄露、权限异常"),
  ]);

  // 告警通知（静态）
  const alarmNotifyList = ref<string[]>(["APP", "短信"]);

  // 电脑接入工具（静态）
  class ComputerTool {
    name: string = "";
    desc: string = "";
    icon: string = "";
    installed: boolean = false;
    constructor(name: string, desc: string, icon: string, installed: boolean) {
      this.name = name;
      this.desc = desc;
      this.icon = icon;
      this.installed = installed;
    }
  }
  const computerTools = ref<ComputerTool[]>([
    new ComputerTool("nuwaclaw", "命令行终端工具", "⌨️", true),
    new ComputerTool("nuwa-cli", "网页终端工具", "💻", false),
  ]);

  const initModeList = () => {
    modeList.value = [
      new ModeItem("chat", t("Mobile.Terminal.modeChat")),
      new ModeItem("meeting", t("Mobile.Terminal.modeMeeting")),
      new ModeItem("monitor", t("Mobile.Terminal.modeMonitor")),
    ];
  };

  const handleModeSwitch = (key: string) => {
    activeMode.value = key;
  };

  const handleNameChange = async () => {
    const newName = editName.value.trim();
    if (newName == "" || newName == deviceName.value) {
      editName.value = deviceName.value;
      return;
    }
    if (deviceId.value == "") return; // 我的电脑：静态，不接接口
    const params = new AppDeviceRenameParams();
    params.displayName = newName;
    try {
      const res = await apiVoxRenameDevice(deviceId.value, params);
      if (apiResCode(res) == SUCCESS_CODE) {
        deviceName.value = newName;
        uni.showToast({ title: t("Mobile.Terminal.nameUpdated"), icon: "none" });
      } else {
        editName.value = deviceName.value;
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.renameFailed"), icon: "none" });
      }
    } catch (e) {
      editName.value = deviceName.value;
      console.error("handleNameChange error", e);
    }
  };

  const doUnbind = async () => {
    try {
      const res = await apiVoxUnbindDevice(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Terminal.unbindSuccess"), icon: "none" });
        setTimeout(() => {
          uni.navigateBack();
        }, 600);
      } else {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.unbindFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("doUnbind error", e);
    }
  };

  const handleUnbind = () => {
    if (deviceId.value == "") return;
    uni.showModal({
      title: t("Mobile.Terminal.unbindTitle"),
      content: t("Mobile.Terminal.unbindConfirm"),
      confirmText: t("Mobile.Terminal.unbindConfirmBtn"),
      cancelText: t("Mobile.Terminal.unbindCancel"),
      success: function (r) {
        if (r.confirm == true) {
          doUnbind();
        }
      },
    });
  };

  const handleMeetingModeToggle = async () => {
    if (deviceId.value == "") return;
    const next = !meetingModeOn.value;
    try {
      const res = next
        ? await apiVoxMeetingModeStart(deviceId.value)
        : await apiVoxMeetingModeStop(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        meetingModeOn.value = next;
        uni.showToast({ title: next ? t("Mobile.Terminal.meetingModeStarted") : t("Mobile.Terminal.meetingModeStopped"), icon: "none" });
      } else {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.meetingModeFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("handleMeetingModeToggle error", e);
    }
  };

  const handleToggle = (name: string) => {
    uni.showToast({ title: name, icon: "none" });
  };

  const handleOpenChat = () => {
    uni.showToast({ title: t("Mobile.Terminal.openChat"), icon: "none" });
  };

  const handleGroupMembers = () => {
    uni.navigateTo({ url: "/subpackages/pages/terminal/terminal-group-members" });
  };

  const handleMeetingRecords = () => {
    uni.navigateTo({ url: "/subpackages/pages/terminal/terminal-meeting-records" });
  };

  const handleMonitorRecords = () => {
    uni.navigateTo({ url: "/subpackages/pages/terminal/terminal-monitor-records" });
  };

  // 重新配网（换 WiFi）
  const handleReprovision = () => {
    if (deviceId.value == "") return;
    uni.navigateTo({
      url: `/subpackages/pages/provision/provision-entry/provision-entry?deviceId=${encodeURIComponent(deviceId.value)}&name=${encodeURIComponent(deviceName.value)}`,
    });
  };

  const fetchDeviceInfo = async () => {
    if (deviceId.value == "") return;
    try {
      const res = await apiVoxDeviceList();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        for (let i = 0; i < arr.length; i++) {
          const idVal = arr[i]["deviceId"];
          if (idVal != null && `${idVal}` == deviceId.value) {
            const onlineVal = arr[i]["online"];
            deviceOnline.value = onlineVal != null ? (onlineVal as boolean) : false;
            const nameVal = arr[i]["displayName"];
            if (nameVal != null && `${nameVal}` != "") {
              deviceName.value = `${nameVal}`;
              editName.value = deviceName.value;
            }
            break;
          }
        }
      }
    } catch (e) {
      console.error("fetchDeviceInfo error", e);
    }
  };

  onLoad((options: any) => {
    if (options != null) {
      const optObj = options as UTSJSONObject;
      const dt = optObj["deviceType"];
      if (dt != null && `${dt}`.length > 0) {
        deviceType.value = `${dt}`;
      }
      const id = optObj["deviceId"];
      if (id != null && `${id}`.length > 0) {
        deviceId.value = orEmpty(decodeURIComponent(`${id}`));
        // 网关绑定设备一律按灵珠处理
        deviceType.value = "lingzhu";
      }
      const nm = optObj["name"];
      if (nm != null && `${nm}`.length > 0) {
        deviceName.value = orEmpty(decodeURIComponent(`${nm}`));
        editName.value = deviceName.value;
      }
    }
    initModeList();
    setCurrentPageNavigationBarTitle();
    if (isLingzhu.value && deviceId.value != "") {
      fetchDeviceInfo();
      fetchPushSettings();
    }
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  /* 头部 */
  .detail-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24rpx 0 16rpx;

    .detail-icon {
      width: 128rpx;
      height: 128rpx;
      border-radius: 32rpx;
      background-color: #5147ff;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16rpx;

      &.detail-icon-computer {
        background-color: #576b95;
      }

      .detail-icon-emoji {
        font-size: 64rpx;
      }
    }

    .detail-name {
      font-size: 36rpx;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 8rpx;
    }

    .detail-status {
      display: flex;
      flex-direction: row;
      align-items: center;

      .detail-status-text {
        font-size: 24rpx;
        color: #666666;
      }

      .quick-btn {
        width: 48rpx;
        height: 48rpx;
        border-radius: 50%;
        background-color: rgba(81, 71, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: 16rpx;

        .quick-btn-emoji {
          font-size: 24rpx;
        }
      }
    }
  }

  /* 字段 */
  .field-label {
    font-size: 24rpx;
    color: #666666;
    padding: 20rpx 32rpx 12rpx;
  }

  .field-input-box {
    background-color: #ffffff;
    border-radius: 16rpx;
    margin: 0 24rpx;
    padding: 24rpx 32rpx;

    .field-input {
      width: 100%;
      font-size: 32rpx;
      color: #1a1a1a;
    }

    .field-placeholder {
      color: #c0c0c0;
    }
  }

  .field-tip {
    font-size: 22rpx;
    color: #999999;
    padding: 8rpx 32rpx 0;
  }

  /* 模式选择 */
  .mode-row {
    display: flex;
    flex-direction: row;
    margin: 0 24rpx;

    .mode-btn {
      flex: 1;
      padding: 20rpx 0;
      border-radius: 16rpx;
      background-color: #ffffff;
      border: 2rpx solid #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 12rpx;

      &:last-child {
        margin-right: 0;
      }

      &.mode-btn-on {
        border-color: #5147ff;
        background-color: rgba(81, 71, 255, 0.08);
      }

      .mode-btn-text {
        font-size: 26rpx;
        font-weight: 500;
        color: #666666;

        &.mode-btn-text-on {
          color: #5147ff;
          font-weight: 600;
        }
      }
    }
  }

  /* 记录入口 */
  .record-row {
    display: flex;
    flex-direction: row;
    margin: 24rpx 24rpx 0;

    .record-btn {
      flex: 1;
      padding: 20rpx 0;
      border-radius: 16rpx;
      background-color: #ffffff;
      border: 2rpx solid #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 16rpx;

      &:last-child {
        margin-right: 0;
      }

      &-active {
        background-color: rgba(12, 20, 102, 0.04);
      }

      .record-btn-text {
