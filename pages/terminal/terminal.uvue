      .status-dot {
        width: 12rpx;
        height: 12rpx;
        border-radius: 50%;
        background-color: #07c160;
        margin-right: 8rpx;

        &.status-dot-off {
          background-color: #c0c0c0;
        }
      }

      .status-text {
        font-size: 24rpx;
        color: #07c160;

        &.status-text-off {
          color: #999999;
        }
      }
    }

    .row-arrow {
      font-size: 40rpx;
      color: #c0c0c0;
      font-weight: 300;
      line-height: 1;
      padding-left: 8rpx;
    }
  }

  /* 添加设备卡 */
  .add-card {
    background-color: #ffffff;
    border: 4rpx dashed #e0e0e0;
    border-radius: 24rpx;
    margin: 24rpx 24rpx 0;
    padding: 28rpx 32rpx;
    display: flex;
    flex-direction: row;
    align-items: center;

    &-active {
      border-color: #5147ff;
    }

    .add-icon {
      width: 80rpx;
      height: 80rpx;
      border-radius: 16rpx;
      background-color: #fafafa;
