/**
 * 伙伴页录音笔记接口，对齐资料库《录音 App 端对接文档》。
 */
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { getApiBaseUrl } from "@/constants/config";
import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
import { applyBearerAuthorization } from "@/utils/authSession";
import { applyXClientTypeHeader } from "@/utils/appWebViewDetect";
import request from "@/servers/useRequest";

function authHeader(): UTSJSONObject {
  const header = {} as UTSJSONObject;
  const token = uni.getStorageSync(ACCESS_TOKEN);
  applyBearerAuthorization(header, token != null ? `${token}` : null);
  applyXClientTypeHeader(header);
  return header;
}

function asApiRes(res: any | null): UTSJSONObject | null {
  if (res == null) {
    return null;
  }
  return res as UTSJSONObject;
}

function readDataString(data: any | null, key: string): string {
  if (data == null) return "";
  const obj = data as UTSJSONObject;
  const raw = obj[key];
  if (raw == null) return "";
  return `${raw}`;
}

function isDigitChar(ch: string): boolean {
  return ch >= "0" && ch <= "9";
}

function isJsonWs(ch: string): boolean {
  return ch == " " || ch == "\n" || ch == "\r" || ch == "\t";
}

/**
 * 上传响应里的 code 有时是未加引号的 0000。
 * Android Gson 把前导零当成非法数字，JSON.parse 会直接打出 JsonSyntaxException，catch 拦不住。
 * 只改写冒号后面的前导零整数，字符串里的内容不动。
 */
function quoteLeadingZeroInts(text: string): string {
  let out = "";
  let i = 0;
  let segStart = 0;
  const n = text.length;
  while (i < n) {
    const ch = text.charAt(i);
    if (ch == "\"") {
      i = i + 1;
      while (i < n) {
        const sc = text.charAt(i);
        if (sc == "\\") {
          i = i + 2;
          continue;
        }
        if (sc == "\"") {
          i = i + 1;
          break;
        }
        i = i + 1;
      }
      continue;
    }
    if (ch != ":") {
      i = i + 1;
      continue;
    }
    i = i + 1;
    while (i < n && isJsonWs(text.charAt(i))) {
      i = i + 1;
    }
    let j = i;
    while (j < n && isDigitChar(text.charAt(j))) {
      j = j + 1;
    }
    const digits = j - i;
    const next = j < n ? text.charAt(j) : "";
    const leadingZero = digits > 1 && text.charAt(i) == "0" && next != "." && next != "e" && next != "E";
    if (leadingZero) {
      out = out + text.substring(segStart, i) + "\"" + text.substring(i, j) + "\"";
      segStart = j;
    }
    i = j;
  }
  if (segStart == 0) return text;
  return out + text.substring(segStart, n);
}

/**
 * 解析 uploadFile 的 res.data。
 * 非对象正文不调用 JSON.parse，避免网关返回纯文本时打出 JsonSyntaxException。
 */
function parseUploadBody(raw: any | null): UTSJSONObject | null {
  if (raw == null) return null;
  if (typeof raw != "string") {
    try {
      const obj = raw as UTSJSONObject;
      if (obj["code"] != null || obj["data"] != null || obj["message"] != null) return obj;
    } catch (_obj) {
      return null;
    }
    return null;
  }
  let text = `${raw}`.trim();
  if (text.length == 0) return null;
  if (text.charCodeAt(0) == 0xfeff) {
    text = text.substring(1).trim();
    if (text.length == 0) return null;
  }
  const first = text.charAt(0);
  const last = text.charAt(text.length - 1);
  const isObject = first == "{" && last == "}";
  const isArray = first == "[" && last == "]";
  if (!isObject && !isArray) return null;
  const normalized = quoteLeadingZeroInts(text);
  try {
    const parsed = JSON.parse(normalized);
    if (parsed == null || typeof parsed != "object") return null;
    return parsed as UTSJSONObject;
  } catch (_parse) {
    return null;
  }
}

function readSegmentId(data: any | null): string {
  if (data == null) return "";
  if (typeof data == "string" || typeof data == "number") return `${data}`;
  if (typeof data != "object") return "";
  const dataObj = data as UTSJSONObject;
  if (dataObj["segmentId"] == null) return "";
  return `${dataObj["segmentId"]}`;
}

// #ifdef APP-IOS
/** Matches the existing upload endpoint. The Swift recorder keeps this context only in memory. */
export function iosVoiceNoteUploadContext(noteId: string, filePath: string): string {
  const headers = authHeader();
  const authorization = headers["Authorization"];
  if (authorization == null || noteId.length == 0 || filePath.length == 0) return "";
  const clientType = headers["X-Client-Type"];
  const context = {
    path: filePath,
    url: `${getApiBaseUrl()}/api/voice/note/${noteId}/segment/upload`,
    authorization: `${authorization}`,
    clientType: clientType != null ? `${clientType}` : "",
  } as UTSJSONObject;
  return JSON.stringify(context);
}

export function iosVoiceNoteBackgroundUploadResult(raw: string): string | null {
  const body = parseUploadBody(raw);
  if (body == null || `${body["code"]}` != SUCCESS_CODE) return null;
  return readSegmentId(body["data"]);
}
// #endif

/**
 * 创建笔记会话，返回 noteId。title 可空，空则由服务端在转写后生成。
 * quiet 为 true 时，失败不弹提示，也不因登录失效跳走。录音过程中必须用 quiet。
 */
export async function apiVoiceNoteCreate(title: string, quiet: boolean = false): Promise<string> {
  const body = {} as UTSJSONObject;
  if (title.length > 0) body["title"] = title;
  const path = "POST /api/voice/note/create";
  let response: any | null = null;
  try {
    response = await request({
      url: "/api/voice/note/create",
      method: "POST",
      data: body,
      suppressAuthRedirect: quiet,
      suppressErrorToast: true,
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    const message = apiResMessage(res);
    throw new Error(message);
  }
  const noteId = readDataString(apiResData<any>(res), "noteId");
  if (noteId.length == 0) {
    throw new Error("创建笔记未返回 noteId");
  }
  return noteId;
}

/** quiet 为 true 时，失败不弹提示，也不因登录失效跳走。 */
export async function apiVoiceNoteComplete(noteId: string, totalSegments: number, quiet: boolean = false): Promise<string> {
  const body = {} as UTSJSONObject;
  body["totalSegments"] = totalSegments;
  const path = "POST /api/voice/note/" + noteId + "/complete";
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}/complete`,
      method: "POST",
      data: body,
      suppressErrorToast: quiet,
      suppressAuthRedirect: quiet,
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    const message = apiResMessage(res);
    throw new Error(message);
  }
  const status = readDataString(apiResData<any>(res), "status");
  const resolved = status.length > 0 ? status : "PROCESSING";
  return resolved;
}

/** 按当前状态重试：部分转写失败、文档失败或文档已删除。返回新的 status。历史页调用，不写入录音页日志。 */
export async function apiVoiceNoteReprocess(noteId: string): Promise<string> {
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}/reprocess`,
      method: "POST",
      data: {},
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    throw new Error(apiResMessage(res));
  }
  const status = readDataString(apiResData<any>(res), "status");
  return status.length > 0 ? status : "PROCESSING";
}

/** 回放音频列表。audioUrl 只在本次播放使用，不写入本地缓存。历史页调用，不写入录音页日志。 */
export async function apiVoiceNoteAudioFiles(noteId: string, page: number, pageSize: number): Promise<UTSJSONObject | null> {
  const safePage = page > 0 ? page : 1;
  const size = pageSize > 0 ? pageSize : 50;
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}/audio-files?page=${safePage}&pageSize=${size}`,
      method: "GET",
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    throw new Error(apiResMessage(res));
  }
  const data = apiResData<any>(res);
  if (data == null) return null;
  return data as UTSJSONObject;
}

/** quiet 为 true 时，失败不弹提示，也不因登录失效跳走。 */
export async function apiVoiceNoteDelete(noteId: string, quiet: boolean = false): Promise<void> {
  const path = "POST /api/voice/note/" + noteId + "/delete";
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}/delete`,
      method: "POST",
      data: {},
      suppressErrorToast: quiet,
      suppressAuthRedirect: quiet,
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    const message = apiResMessage(res);
    throw new Error(message);
  }
}

/**
 * 历史列表。首页不传 lastId；翻页传上一页最后一条 noteId。
 * data 按创建时间倒序：noteId、title、status、totalDurationMs、segmentCount、created。
 */
export async function apiVoiceNoteList(lastId: string, limit: number): Promise<UTSJSONObject[]> {
  const body = {} as UTSJSONObject;
  const size = limit > 0 ? limit : 20;
  body["limit"] = size > 100 ? 100 : size;
  if (lastId.length > 0) {
    const noteNumber = parseFloat(lastId);
    const digitsOnly = `${Math.floor(noteNumber)}` == lastId;
    if (!isNaN(noteNumber) && digitsOnly) {
      body["lastId"] = noteNumber;
    } else {
      body["lastId"] = lastId;
    }
  }
  let response: any | null = null;
  try {
    response = await request({
      url: "/api/voice/note/list",
      method: "POST",
      data: body,
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    throw new Error(apiResMessage(res));
  }
  const data = apiResData<any>(res);
  if (data == null || !Array.isArray(data)) {
    return [];
  }
  return data as UTSJSONObject[];
}

/**
 * 联动回放的转写帧。历史详情页使用，不写入录音页日志。
 * data 可能是帧数组，或带 frames / items / segments 的对象。
 */
export async function apiVoiceNoteTranscript(noteId: string): Promise<any | null> {
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}/transcript`,
      method: "GET",
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    throw new Error(apiResMessage(res));
  }
  return apiResData<any>(res);
}

export async function apiVoiceNoteDetail(noteId: string): Promise<UTSJSONObject | null> {
  const path = "GET /api/voice/note/" + noteId;
  let response: any | null = null;
  try {
    response = await request({
      url: `/api/voice/note/${noteId}`,
      method: "GET",
    });
  } catch (error) {
    throw error;
  }
  const res = asApiRes(response);
  if (apiResCode(res) != SUCCESS_CODE) {
    const message = apiResMessage(res);
    throw new Error(message);
  }
  const data = apiResData<any>(res);
  if (data == null) {
    return null;
  }
  const obj = data as UTSJSONObject;
  const status = obj["status"] != null ? `${obj["status"]}` : "";
  return obj;
}

/**
 * 上传一个已落盘分段。同一 segmentIndex 重传会覆盖，重试必须沿用原编号。
 * 是否已经是最后一段不在这里传，全部上传成功后再调用 complete。
 * 文件名必须以 .m4a / .aac 结尾。
 */
export function apiVoiceNoteUploadSegment(
  noteId: string,
  filePath: string,
  segmentIndex: number,
  durationMs: number,
): Promise<string> {
  const formData = {} as UTSJSONObject;
  formData["segmentIndex"] = `${segmentIndex}`;
  if (durationMs > 0) formData["durationMs"] = `${durationMs}`;
  const url = `${getApiBaseUrl()}/api/voice/note/${noteId}/segment/upload`;
  const path = "POST /api/voice/note/" + noteId + "/segment/upload";
  return new Promise<string>((resolve, reject) => {
    uni.uploadFile({
      url: url,
      filePath: filePath,
      name: "file",
      header: authHeader(),
      formData: formData,
      success: (res) => {
        const parsed = parseUploadBody(res.data);
        if (parsed == null) {
          reject(new Error("上传响应无法解析"));
          return;
        }
        const code = parsed["code"] != null ? `${parsed["code"]}` : "";
        if (code != SUCCESS_CODE) {
          const message = parsed["message"] != null ? `${parsed["message"]}` : "分段上传失败";
          reject(new Error(message));
          return;
        }
        const segmentId = readSegmentId(parsed["data"]);
        resolve(segmentId);
      },
      fail: (err) => {
        const message = err != null && err.errMsg != null ? `${err.errMsg}` : "分段上传失败";
        reject(new Error(message));
      },
    });
  });
}
