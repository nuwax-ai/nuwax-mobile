// 响应先从 UTSJSONObject 映射为 class，避免 Android 将 JSON 强转 interface。
// ID 保持字符串，兼容后端 int64；providerId 与 identityId 不可混用。
export class AuthIdpProvider {
  id: string = "";
  type: string = "";
  name: string = "";
  icon: string = "";
  wechatMode: string = "";
}

export class AuthIdpList {
  valid: boolean = false;
  items: AuthIdpProvider[] = [];
  autoRedirectIdpId: string = "";
}

export class AuthIdentity {
  id: string = "";
  idpId: string = "";
  providerName: string = "";
  externalUserName: string = "";
  externalIdMasked: string = "";
}
