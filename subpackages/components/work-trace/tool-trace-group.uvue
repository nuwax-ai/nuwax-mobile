<template>
  <!--
    V2 连续工具调用组（对齐 PC ToolGroupDisclosure）：
    透明组头（图标+动作词标题+状态图标+箭头）+ 组体左竖线（border-left 近似 PC ::before）。
    展开状态托管在 ai-msg（稳定组 id + 手动保持），本组件无内部状态。
  -->
  <view class="tool-group" :class="{ 'is-failed': isFailed }">
    <view class="tool-group-toggle" @tap="onToggle">
      <!-- terminal 专属图标：iconfont 无终端字形，用内联 SVG mask（方框+>_），颜色由 background-color 控制 -->
      <text class="iconfont tool-group-icon" :class="{ 'is-failed-icon': isFailed }">{{ firstKindIconGlyph }}</text>
      <text class="tool-group-title">{{ groupTitle }}</text>
      <view v-if="isRunning" class="tool-group-status">
        <text class="iconfont tool-group-spinner">&#xe628;</text>
      </view>
      <text
        v-else-if="isFailed"
        class="iconfont tool-group-failed-icon"
      >&#xe60d;</text>
      <text
        class="iconfont tool-group-caret"
        :class="{ 'tool-group-caret-open': expanded }"
      >&#xe647;</text>
    </view>
    <view v-if="expanded" class="tool-group-body">
      <view class="tool-group-body-inner">
        <view v-for="row in rows" :key="row.id">
          <plan-trace-row
            v-if="row.kind == 'todo'"
            :row="row.raw"
            :expanded="nodeIsExpanded(row.id)"
            @toggle="toggleNode(row.id)"
          />
          <tool-trace-row
            v-else
            :row="row.raw"
            :expanded="nodeIsExpanded(row.id)"
            @toggle="toggleNode(row.id)"
          />
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { traceKindIconGlyph } from "@/subpackages/components/work-trace/traceIcons.uts";
  import planTraceRow from "@/subpackages/components/work-trace/plan-trace-row.uvue";
  import toolTraceRow from "@/subpackages/components/work-trace/tool-trace-row.uvue";

  class GroupRowView {
    id: string = "";
    kind: string = "generic";
    status: string = "finished";
    isCreate: boolean = false;
    raw: UTSJSONObject | null = null;
  }

  const props = withDefaults(
    defineProps<{
      title?: string;
      firstKind?: string;
      status?: string;
      rowsJson?: string;
      /** 组展开状态（托管在 ai-msg 折叠状态机）。 */
      expanded?: boolean;
      /** 已展开行 id，使用 |id| 分隔，避免跨组件传递函数与 class。 */
      nodeExpandedIds?: string;
    }>(),
    {
      title: "",
      firstKind: "generic",
      status: "finished",
      rowsJson: "[]",
      expanded: false,
      nodeExpandedIds: "|",
    },
  );

  const emit = defineEmits<{
    toggle: [];
    toggleNode: [id: string];
  }>();

  const rows = computed((): GroupRowView[] => {
    let source: UTSJSONObject[] = [] as UTSJSONObject[];
    try {
      const parsed = JSON.parseArray<UTSJSONObject>(props.rowsJson);
      if (parsed != null) source = parsed as UTSJSONObject[];
    } catch (_e) {
      return [] as GroupRowView[];
    }
    const result: GroupRowView[] = [] as GroupRowView[];
    for (let i = 0; i < source.length; i++) {
      const raw = source[i];
      if (raw == null || typeof raw != "object") continue;
      const obj = raw as UTSJSONObject;
      const row = new GroupRowView();
      row.id = `${obj["id"] ?? ""}`;
      row.kind = `${obj["kind"] ?? "generic"}`;
      row.status = `${obj["status"] ?? "finished"}`;
      row.isCreate = obj["isCreate"] == true;
      row.raw = obj;
      result.push(row);
    }
    return result;
  });

  const isRunning = computed((): boolean => props.status == "running");
  const isFailed = computed((): boolean => props.status == "failed");

  const firstKindIconGlyph = computed((): string => traceKindIconGlyph(props.firstKind));

  /**
   * 组头摘要：按 actionKinds 首次出现顺序，取组内同 kind 行的聚合状态生成
   * 动作短语（对齐 PC ToolGroupDisclosure：kind 级状态、file-edit 全新建用「创建」语态）。
   */
  const groupTitle = computed((): string => props.title);

  function onToggle(): void {
    emit("toggle");
  }

  function nodeIsExpanded(id: string): boolean {
    return props.nodeExpandedIds.indexOf("|" + id + "|") >= 0;
  }

  function toggleNode(id: string): void {
    emit("toggleNode", id);
  }
</script>

<style lang="scss" scoped>
  // 对齐 PC hairline 色板
  $hairline: rgba(5, 5, 5, 0.08);
  $text-main: rgba(0, 0, 0, 0.88);
  $text-secondary: rgba(5, 5, 5, 0.65);
  $text-tertiary: rgba(5, 5, 5, 0.45);
  $text-quaternary: rgba(5, 5, 5, 0.25);
  $color-error: #ff4d4f;
  $color-primary: #6a5af9;

  .tool-group {
    min-width: 0;

    &.is-failed {
      .tool-group-title {
        color: $color-error;
      }
    }
  }

  // 透明组头：图标 + 标题 + 状态 + 箭头（无边框/背景/计数，对齐 PC）
  .tool-group-toggle {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14rpx;
    width: 100%;
    min-height: 60rpx;
    padding: 0;
  }

  .tool-group-icon {
    width: 28rpx;
    flex-shrink: 0;
    font-size: 28rpx;
    color: $text-tertiary;
    line-height: 40rpx;
    &.is-failed-icon {
      color: $color-error;
    }
  }

  .tool-group-title {
    // 自然宽度：箭头紧跟标题（不漂在行最右侧）
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    color: $text-secondary;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tool-group-status {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32rpx;
    height: 32rpx;
  }

  .tool-group-spinner {
    font-size: 26rpx;
    color: $color-primary;
    /* #ifndef APP */
    animation: tool-group-spin 1s linear infinite;
    /* #endif */
  }

  .tool-group-failed-icon {
    flex-shrink: 0;
    font-size: 26rpx;
    color: #ff4d4f;
  }

  // 箭头：caret 单一图标 + 旋转（-90°收起 / 0°展开，对齐 PC caret_down）；触屏无 hover 常显
  .tool-group-caret {
    flex-shrink: 0;
    color: $text-quaternary;
    font-size: 20rpx;
    line-height: 20rpx;
    transform: rotate(-90deg);
    transition: transform 0.18s ease, color 0.18s ease;

    &-open {
      transform: rotate(0deg);
      color: $text-secondary;
    }
  }

  // 组体左竖线（border-left 近似 PC ::before：margin-left 12px + 1px 线对齐图标中心）
  .tool-group-body {
    margin: 2rpx 0 10rpx 24rpx;
    min-width: 0;
  }

  .tool-group-body-inner {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
    min-width: 0;
    padding-left: 16rpx;
    border-left: 1px solid $hairline;
  }

  /* #ifndef APP */
  @keyframes tool-group-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
  /* #endif */
</style>
