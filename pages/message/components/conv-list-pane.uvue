<template>
  <scroll-view
    id="partner-conv-scroll"
    class="im-pane"
    :direction="menuVisible || scrollLocked ? 'none' : 'vertical'"
    :show-scrollbar="false"
    :scroll-into-view="scrollAnchor"
    :bounces="false"
    @scroll="handlePaneScroll($event)"
    @scrolltolower="emitScrollLower"
    @touchstart="handlePaneTouchStart($event)"
    @touchmove="handlePaneTouchMove($event)"
    @touchend="handlePaneTouchEnd($event)"
    @touchcancel="handlePaneTouchCancel($event)"
  >
    <view class="im-pane-body">
      <view v-if="loading && conversations.length == 0" class="im-state">
        <text class="im-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view v-else-if="conversations.length == 0" class="im-state" @click="emitRetry">
        <text class="im-state__text">{{ failed ? t("Mobile.Message.loadFailed") : t("Mobile.Message.emptyMessages") }}</text>
      </view>
      <template v-else>
        <view v-for="(conv, index) in conversations" :key="conv.convId">
          <view
            :id="`row-${conv.convId}`"
            class="chat-item"
            :class="[
              pressedRowId == conv.convId ? 'chat-item--active' : '',
              menuVisible && menuRowId == conv.convId ? 'chat-item--menu-on' : '',
              pressedRowId == conv.convId || (menuVisible && menuRowId == conv.convId) ? '' : conv.topFlag ? 'chat-item--pinned' : '',
            ]"
            @click="emitRowClick(conv)"
            @touchstart="emitRowTouchStart(conv, $event)"
            @touchmove="emitRowTouchMove($event)"
            @touchend="emitRowTouchEnd(conv, $event)"
            @touchcancel="emitRowTouchCancel"
          >
            <conv-row-item :conv="conv" @avatar-loaded="emitAvatarLoaded(conv)" @avatar-error="emitAvatarError(conv)" />
          </view>
        </view>
        <view v-if="loadingMore" class="im-foot">
          <text class="im-foot__text">{{ t("Mobile.Page.loadingMore") }}</text>
        </view>
        <view v-else-if="hasMore != true" class="im-foot">
          <text class="im-foot__text">{{ t("Mobile.Message.noMore") }}</text>
        </view>
      </template>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
  import { getCurrentInstance, nextTick, onMounted, onUnmounted, watch } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import ConvRowItem from "./conv-row-item.uvue";
  import { ImConvRow } from "./im-row-models.uts";
  // #ifdef APP-ANDROID
  import {
    attachAndroidPullAction,
    detachAndroidPullAction,
    setAndroidPullActionEnabled,
  } from "@/uni_modules/nuwax-android-pull-action";
  // #endif

  const emit = defineEmits<{
    retry: [];
    scroll: [];
    "scroll-lower": [];
    "pull-gesture-start": [];
    "pull-gesture-move": [distance: number];
    "pull-gesture-end": [distance: number, velocity: number];
    "pull-gesture-cancel": [];
    "pane-touchstart": [e: UniTouchEvent];
    "pane-touchmove": [e: UniTouchEvent];
    "pane-touchend": [e: UniTouchEvent];
    "pane-touchcancel": [e: UniTouchEvent];
    "row-click": [conv: ImConvRow];
    "row-touchstart": [conv: ImConvRow, e: UniTouchEvent];
    "row-touchmove": [e: UniTouchEvent];
    "row-touchend": [conv: ImConvRow, e: UniTouchEvent];
    "row-touchcancel": [];
    "avatar-loaded": [conv: ImConvRow];
    "avatar-error": [conv: ImConvRow];
    "row-rect": [top: number, bottom: number, left: number];
  }>();

  const props = withDefaults(
    defineProps<{
      conversations: ImConvRow[];
      loading: boolean;
      failed: boolean;
      loadingMore: boolean;
      hasMore: boolean;
      scrollAnchor: string;
      menuVisible: boolean;
      /** 右滑露出录音层时锁纵向滚动。 */
      scrollLocked: boolean;
      /** 长按浮层指向行 id（convId；高亮判定）。 */
      menuRowId: string;
      pressedRowId: string;
      pullEntryEnabled: boolean;
    }>(),
    {
      conversations: [] as ImConvRow[],
      loading: false,
      failed: false,
      loadingMore: false,
      hasMore: true,
      scrollAnchor: "",
      menuVisible: false,
      scrollLocked: false,
      menuRowId: "",
      pressedRowId: "",
      pullEntryEnabled: false,
    },
  );

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const componentInstance = getCurrentInstance();
  let paneScrollTop = 0;
  let pullCandidate = false;
  let pullDragging = false;
  let pullStartX = 0;
  let pullStartY = 0;
  let pullStartAt = 0;
  let pullDistance = 0;
  const PULL_MAX_DISTANCE = 360;

  // #ifdef APP-ANDROID
  // Android scroll-view 会在超过 touch slop 后截获 touchmove。使用项目已有的原生
  // SmartRefreshLayout 只采集连续下拉位移，页面位移仍由 tab-shell Stage 统一绘制。
  const ANDROID_PULL_KEY = "partner-conv-stage-pull";
  const ANDROID_PULL_ELEMENT_ID = "partner-conv-scroll";
  const ANDROID_PULL_HEADER_PX = 115;
  // 与 Stage 的震动/提交线一致。原生桥额外要求按住 180ms；快速下拉已经越线时，
  // 在 settled 回调按这个可见位移补交，避免“已经震动但不进入”。
  const ANDROID_PULL_COMMIT_PX = 132;
  let androidPullAttachTimer = 0;
  let androidPullAttachAttempts = 0;
  let androidPullAttachGeneration = 0;
  let androidPullActive = false;
  let androidPullStartedAt = 0;
  let androidPullDistance = 0;
  let androidPullMaxDistance = 0;

  function resetAndroidPullGesture(): void {
    androidPullActive = false;
    androidPullStartedAt = 0;
    androidPullDistance = 0;
    androidPullMaxDistance = 0;
  }

  /** Android 松手首帧直接把结果交给 Stage；不等原生 260ms 回弹结束。 */
  function finishAndroidPullOnRelease(distanceValue: number): void {
    if (!androidPullActive) return;
    const distance = Math.max(0, Math.min(distanceValue, PULL_MAX_DISTANCE));
    const elapsed = Math.max(1, Date.now() - androidPullStartedAt);
    if (distance >= ANDROID_PULL_COMMIT_PX) {
      emit("pull-gesture-end", distance, (distance * 1000) / elapsed);
    } else {
      emit("pull-gesture-cancel");
    }
    resetAndroidPullGesture();
  }

  function handleAndroidPullProgress(distanceValue: number, dragging: boolean): void {
    const distance = Math.max(0, Math.min(distanceValue, PULL_MAX_DISTANCE));
    if (dragging && distance > 0) {
      if (!androidPullActive) {
        androidPullActive = true;
        androidPullStartedAt = Date.now();
        androidPullMaxDistance = 0;
        emit("pull-gesture-start");
      }
      androidPullDistance = distance;
      androidPullMaxDistance = Math.max(androidPullMaxDistance, distance);
      emit("pull-gesture-move", distance);
      return;
    }
    // SmartRefreshLayout 在手指松开时先派一帧 dragging=false，再开始自身回弹。
    // 当帧同步启动 Stage 动画，消除未达阈值和达到阈值两条路径的停顿。
    if (!dragging && androidPullActive) {
      finishAndroidPullOnRelease(Math.max(androidPullDistance, androidPullMaxDistance));
    }
  }

  function handleAndroidPullTriggered(): void {
    if (!androidPullActive) return;
    finishAndroidPullOnRelease(Math.max(androidPullDistance, androidPullMaxDistance));
  }

  function handleAndroidPullSettled(triggered: boolean): void {
    // 正常路径已在 dragging=false / onTriggered 当帧处理；这里只兜底少数不派释放帧的机型。
    if (!triggered && androidPullActive) {
      finishAndroidPullOnRelease(androidPullDistance);
      return;
    }
    resetAndroidPullGesture();
  }

  function attachAndroidPullNow(generation: number): void {
    androidPullAttachTimer = 0;
    if (generation != androidPullAttachGeneration) return;
    const attached = attachAndroidPullAction(
      ANDROID_PULL_KEY,
      ANDROID_PULL_ELEMENT_ID,
      ANDROID_PULL_HEADER_PX,
      PULL_MAX_DISTANCE,
      "#ffffff",
      props.pullEntryEnabled && !props.menuVisible,
      handleAndroidPullProgress,
      handleAndroidPullTriggered,
      handleAndroidPullSettled,
    );
    if (attached) {
      androidPullAttachAttempts = 0;
      return;
    }
    androidPullAttachAttempts = androidPullAttachAttempts + 1;
    if (androidPullAttachAttempts < 30) {
      androidPullAttachTimer = setTimeout((): void => {
        attachAndroidPullNow(generation);
      }, 50);
    }
  }

  function queueAndroidPullAttach(): void {
    if (androidPullAttachTimer != 0) clearTimeout(androidPullAttachTimer);
    androidPullAttachAttempts = 0;
    const generation = androidPullAttachGeneration + 1;
    androidPullAttachGeneration = generation;
    nextTick((): void => { attachAndroidPullNow(generation); });
  }

  onMounted((): void => { queueAndroidPullAttach(); });

  onUnmounted((): void => {
    androidPullAttachGeneration = androidPullAttachGeneration + 1;
    if (androidPullAttachTimer != 0) clearTimeout(androidPullAttachTimer);
    androidPullAttachTimer = 0;
    detachAndroidPullAction(ANDROID_PULL_KEY);
  });

  watch((): boolean => props.pullEntryEnabled && !props.menuVisible, (enabled: boolean): void => {
    setAndroidPullActionEnabled(ANDROID_PULL_KEY, enabled);
    if (!enabled && androidPullActive) {
      emit("pull-gesture-cancel");
      resetAndroidPullGesture();
    }
  });
  // #endif

  function dampPullDistance(rawValue: number): number {
    const raw = Math.max(0, rawValue);
    const distance = raw <= 160 ? raw : 160 + (raw - 160) * 0.35;
    return Math.min(PULL_MAX_DISTANCE, distance);
  }

  function resetPullGesture(): void {
    pullCandidate = false;
    pullDragging = false;
    pullStartAt = 0;
    pullDistance = 0;
  }

  /** 列表内 touchmove 上抛：右滑露出录音层由页面 movePartnerVoiceDrag 跟手；
   *  原生滚动会吞掉部分 move，页面根 view 收不全，故此处补一条。
   *  ★须定义在 handlePaneTouchMove 之前（UTS 不提升，前向引用报 error18）。 */
  function emitPaneTouchMove(eventValue: Any): void {
    emit("pane-touchmove", eventValue as UniTouchEvent);
  }

  function handlePaneScroll(eventValue: Any): void {
    const e = eventValue as UniScrollEvent;
    paneScrollTop = Math.max(0, e.detail.scrollTop);
    emit("scroll");
  }

  function handlePaneTouchStart(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) return;
    // #ifdef APP-ANDROID
    // 下拉手势由原生桥接管；页面触摸事件仍上抛给列表点击/长按守卫。
    emit("pane-touchstart", e);
    return;
    // #endif
    const touch = e.touches[0];
    pullStartX = touch.clientX;
    pullStartY = touch.clientY;
    pullStartAt = Date.now();
    pullDistance = 0;
    pullDragging = false;
    pullCandidate = props.pullEntryEnabled && !props.menuVisible && paneScrollTop <= 1;
    emit("pane-touchstart", e);
  }

  function handlePaneTouchMove(eventValue: Any): void {
    // 右滑录音拖拽：所有平台都要上抛（Stage 下拉手势只在非 Android 走本函数）。
    emitPaneTouchMove(eventValue);
    // #ifdef APP-ANDROID
    return;
    // #endif
    if (!pullCandidate) return;
    const e = eventValue as UniTouchEvent;
    if (e.touches.length == 0) return;
    const touch = e.touches[0];
    const dx = touch.clientX - pullStartX;
    const dy = touch.clientY - pullStartY;
    if (dy <= 0 || Math.abs(dx) > Math.abs(dy) * 0.85) {
      if (pullDragging) emit("pull-gesture-cancel");
      resetPullGesture();
      return;
    }
    if (!pullDragging) {
      if (dy < 6 || Math.abs(dy) <= Math.abs(dx) * 1.2) return;
      pullDragging = true;
      emit("pull-gesture-start");
    }
    pullDistance = dampPullDistance(dy);
    emit("pull-gesture-move", pullDistance);
  }

  function handlePaneTouchEnd(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    // #ifdef APP-ANDROID
    emit("pane-touchend", e);
    return;
    // #endif
    if (pullDragging) {
      const elapsed = Math.max(1, Date.now() - pullStartAt);
      emit("pull-gesture-end", pullDistance, (pullDistance * 1000) / elapsed);
    }
    resetPullGesture();
    emit("pane-touchend", e);
  }

  function handlePaneTouchCancel(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    // #ifdef APP-ANDROID
    emit("pane-touchcancel", e);
    return;
    // #endif
    if (pullDragging) emit("pull-gesture-cancel");
    resetPullGesture();
    emit("pane-touchcancel", e);
  }

  function onRowRectMeasured(results: Array<any>): void {
    let topPx = -1;
    let bottomPx = -1;
    let leftPx = -1;
    if (results.length > 0) {
      const raw = results[0];
      if (raw != null) {
        const rect = raw as NodeInfo;
        if (rect.top != null) topPx = parseFloat(`${rect.top}`);
        if (rect.bottom != null) bottomPx = parseFloat(`${rect.bottom}`);
        if (rect.left != null) leftPx = parseFloat(`${rect.left}`);
      }
    }
    emit("row-rect", topPx, bottomPx, leftPx);
  }

  function measureRow(domId: string): void {
    const proxy = componentInstance != null ? componentInstance.proxy : null;
    if (proxy == null) return;
    uni.createSelectorQuery().in(proxy).select("#" + domId).boundingClientRect().exec(onRowRectMeasured);
  }

  defineExpose({ measureRow: measureRow as any });
  function emitRetry(): void { emit("retry"); }
  function emitScrollLower(): void { emit("scroll-lower"); }
  function emitRowClick(conv: ImConvRow): void { emit("row-click", conv); }
  function emitRowTouchStart(conv: ImConvRow, eventValue: Any): void { emit("row-touchstart", conv, eventValue as UniTouchEvent); }
  function emitRowTouchMove(eventValue: Any): void { emit("row-touchmove", eventValue as UniTouchEvent); }
  function emitRowTouchEnd(conv: ImConvRow, eventValue: Any): void { emit("row-touchend", conv, eventValue as UniTouchEvent); }
  function emitRowTouchCancel(): void { emit("row-touchcancel"); }
  function emitAvatarLoaded(conv: ImConvRow): void { emit("avatar-loaded", conv); }
  function emitAvatarError(conv: ImConvRow): void { emit("avatar-error", conv); }
</script>

<style lang="scss" scoped>
  .im-pane { height: 100%; background-color: #ffffff; }
  .im-pane-body { min-height: 100%; background-color: #ffffff; }
  .im-state { padding: 100px 24px; display: flex; flex-direction: column; align-items: center; }
  .im-state__text { font-size: 14px; line-height: 20px; color: #94929c; }
  .im-foot { padding: 14px 0 22px; display: flex; flex-direction: row; justify-content: center; }
  .im-foot__text { font-size: 12px; line-height: 17px; color: #c0bec8; }
  .chat-item { display: flex; flex-direction: row; align-items: center; padding: 10.5px 16px; }
  .chat-item--pinned { background-color: #f7f6fb; }
  .chat-item--active { background-color: #eceaf3; }
  .chat-item--menu-on { background-color: #eceaf3; }
</style>
