<template>
  <view class="idp-login" v-if="providers.length > 0 || errorText.length > 0">
    <text v-if="errorText.length > 0" class="idp-error">{{ errorText }}</text>
    <text v-if="providers.length > 0" class="idp-title">{{ t('Mobile.Auth.externalLogin') }}</text>
    <button v-for="provider in providers" :key="provider.id" class="idp-button"
      :disabled="busy || disabled" :loading="busy && activeId == provider.id" @click="login(provider.id)">
      {{ provider.name.length > 0 ? provider.name : t('Mobile.Auth.externalLogin') }}
    </button>
    <button v-if="providers.length > 0" class="idp-local" :disabled="busy || disabled" @click="useOrdinaryLogin">
      {{ t('Mobile.Auth.otherLogin') }}
    </button>
  </view>
</template>

<script setup lang="uts">
import { ref, watch, onMounted, onUnmounted } from 'vue';
import { AuthIdpProvider } from '@/types/interfaces/authIdp';
import { apiAuthIdpList } from '@/servers/authIdp';
import { apiResCode, apiResData } from '@/utils/apiResponse';
import { SUCCESS_CODE } from '@/constants/codes.constants';
import { getApiBaseUrl } from '@/constants/config';
import { AuthLoadScope, parseAuthIdpList, availableAuthProviders, autoAuthProviderId } from '@/utils/authIdp';
import { canUseBrowserIdp, authBrowserQuery, authBrowserUserAgent, beginBrowserIdp, ordinaryLoginUrl } from '@/utils/idpNavigation';
import { useI18n, emptyI18nParams } from '@/utils/i18n';

const props = defineProps<{ agreed: boolean, disabled: boolean, redirectUrl: string }>();
const { t: translate } = useI18n();
const t = (key: string): string => translate(key, emptyI18nParams(), '');
const providers = ref<AuthIdpProvider[]>([]);
const errorText = ref<string>('');
const busy = ref(false);
const activeId = ref('');
let automaticId = '';
let local = false;
let loadedOrigin = '';
const scope = new AuthLoadScope();
const AUTO_ATTEMPT_KEY = 'NUWAX_IDP_AUTO_ATTEMPT';

function reserveAutomaticAttempt(): boolean {
  // #ifdef H5 || WEB
  try {
    const previous = sessionStorage.getItem(AUTO_ATTEMPT_KEY);
    const timestamp = previous != null ? parseFloat(previous) : 0;
    if (timestamp > 0 && Date.now() - timestamp < 300000) return false;
    sessionStorage.setItem(AUTO_ATTEMPT_KEY, `${Date.now()}`);
    return true;
  } catch (_error) { return false; }
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

function login(id: string, automatic: boolean = false): void {
  if (busy.value || props.disabled || loadedOrigin != getApiBaseUrl()) return;
  if (!providers.value.some((p: AuthIdpProvider): boolean => p.id == id)) return;
  if (!props.agreed) {
    uni.showToast({ title: t('Mobile.Auth.idpAgreementRequired'), icon: 'none' });
    return;
  }
  activeId.value = id;
  busy.value = true;
  if (!beginBrowserIdp(id, props.redirectUrl, automatic)) {
    busy.value = false;
    errorText.value = t('Mobile.Auth.idpUnavailable');
  }
}

function tryAutomatic(): void {
  if (props.disabled || busy.value) return;
  const id = autoAuthProviderId(providers.value, automaticId, local, errorText.value, props.agreed);
  if (id.length > 0 && reserveAutomaticAttempt()) login(id, true);
}

function useOrdinaryLogin(): void {
  local = true;
  uni.reLaunch({ url: ordinaryLoginUrl(props.redirectUrl) });
}

// 浏览器从 IdP 返回缓存页面时，恢复按钮；不再次自动发起。
// #ifdef H5 || WEB
function restoreFromBrowser(event: PageTransitionEvent): void {
  // 首次 pageshow 不应取消租户配置的自动跳转；仅处理 bfcache 恢复。
  if (event.persisted == true) { busy.value = false; local = true; }
}
// #endif

onMounted(async () => {
  errorText.value = authBrowserQuery('idpError').substring(0, 500);
  local = authBrowserQuery('local').length > 0 || errorText.value.length > 0;
  if (!canUseBrowserIdp()) return;
  // #ifdef H5 || WEB
  window.addEventListener('pageshow', restoreFromBrowser);
  // #endif
  const sequence = scope.begin();
  const origin = getApiBaseUrl();
  try {
    const response = await apiAuthIdpList();
    if (!scope.accepts(sequence, origin, getApiBaseUrl()) || apiResCode(response) != SUCCESS_CODE) return;
    const data = parseAuthIdpList(apiResData<any>(response));
    if (!data.valid) return;
    loadedOrigin = origin;
    providers.value = availableAuthProviders(data.items, canUseBrowserIdp(), authBrowserUserAgent());
    automaticId = data.autoRedirectIdpId;
    tryAutomatic();
  } catch (_error) {
    // 旧后端、网络失败和超时保留普通登录；不把错误当成空的身份绑定列表。
  }
});
watch(() => props.agreed, () => tryAutomatic());
onUnmounted(() => {
  scope.invalidate();
  // #ifdef H5 || WEB
  window.removeEventListener('pageshow', restoreFromBrowser);
  // #endif
});
</script>

<style scoped>
.idp-login { width: 100%; margin-top: 28rpx; }
.idp-title { color: #777777; font-size: 26rpx; text-align: center; margin-bottom: 16rpx; }
.idp-error { color: #b42318; font-size: 26rpx; margin-bottom: 16rpx; }
.idp-button { background-color: #ffffff; color: #111111; border: 1rpx solid #dddddd; border-radius: 12rpx; font-size: 28rpx; margin-bottom: 16rpx; }
.idp-local { background-color: transparent; color: #666666; font-size: 24rpx; }
.idp-local::after { border-width: 0; }
</style>
