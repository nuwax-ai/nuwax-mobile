import request from "@/servers/useRequest";
import { readRawField } from "@/utils/readRawField.uts";

export interface AgentInterventionOutcomeSelected {
  option_id: string;
}

export interface AgentInterventionOutcome {
  Selected?: AgentInterventionOutcomeSelected;
  Cancelled?: any | null;
}

export interface AgentInterventionPermissionResponse {
  outcome: AgentInterventionOutcome;
}

export interface AgentInterventionPermissionResolveRequest {
  request_permission_response: AgentInterventionPermissionResponse;
  session_id?: string;
  tool_call_id?: string;
  save_rule: boolean;
}

/** 权限审批回调参数 */
export interface AgentInterventionRespondParams {
  interventionId: string;
  permission_resolve_request: AgentInterventionPermissionResolveRequest;
  conversation_id?: number;
}

/**
 * 权限审批回调
 * 对齐 agent-platform /api/agent/conversation/chat/permission-request/response
 */
export async function apiAgentInterventionRespond(
  params: UTSJSONObject,
) {
  const permissionRequest = readRawField(params, "permission_resolve_request");
  const permissionResponse = readRawField(
    permissionRequest,
    "request_permission_response",
  );
  const outcome = readRawField(permissionResponse, "outcome");
  const selected = readRawField(outcome, "Selected");
  const selectedOptionId = readRawField(selected, "option_id");
  const fallbackOptionId =
    selected == null ? "reject" : null;

  const toolCallId = readRawField(permissionRequest, "tool_call_id");
  const sessionId = readRawField(permissionRequest, "session_id");
  // 后端校验要求 session_id + tool_call_id（缺一则 0001）；
  // 同时保留 toolId 兼容旧网关映射。
  return request({
    url: "/api/agent/conversation/chat/permission-request/response",
    method: "POST",
    data: {
      conversationId: readRawField(params, "conversation_id"),
      toolId: toolCallId,
      session_id: sessionId,
      tool_call_id: toolCallId,
      option: {
        optionId:
          selectedOptionId != null && `${selectedOptionId}`.length > 0
            ? selectedOptionId
            : fallbackOptionId,
        outcome: selected != null ? "selected" : "cancelled",
      },
    },
  });
}
