<template>
  <!--
    V2 连续工具调用组（H5/MP-WEIXIN 专用）。
    组头压缩动作类型（「读取了文件 · 运行了命令」），组内保留逐条真实执行行。
    展开状态托管在 ai-msg（稳定组 id + 手动保持），本组件无内部状态。
  -->
  <view class="tool-trace-group" :class="{ 'is-failed': isFailed }">
    <view class="tool-trace-group__header" @tap="onToggle">
      <text
        class="iconfont tool-trace-group__kind-icon"
        :class="firstKindIconClass"
      />
      <text class="tool-trace-group__title">{{ groupTitle }}</text>
      <view v-if="isRunning" class="tool-trace-group__status">
        <text class="iconfont icon-Loader tool-trace-group__spinner" />
      </view>
      <text
        v-else-if="isFailed"
        class="iconfont icon-waring tool-trace-group__failed-icon"
      />
      <text class="tool-trace-group__count">{{ itemCount }}</text>
      <text
        class="iconfont icon-a-Chevrondown tool-trace-group__arrow"
        :class="{ 'is-expanded': expanded }"
      />
    </view>
    <view v-if="expanded" class="tool-trace-group__body">
      <tool-trace-row v-for="(row, index) in rows" :key="row.id" :row="row" />
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    getRowsGroupStatus,
    toolTraceActionI18nKey,
    type TraceItem,
    type TraceToolRow,
  } from "@/subpackages/components/ai-msg/conversationTrace.uts";
  import { traceKindIconClass } from "@/subpackages/components/work-trace/traceIcons.uts";
  import toolTraceRow from "@/subpackages/components/work-trace/tool-trace-row.uvue";
  import { useI18n } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, undefined, "");

  const props = withDefaults(
    defineProps<{
      /** 投影产出的工具组（kind = tool-group）。 */
      item?: TraceItem | null;
      /** 展开状态（托管在 ai-msg 折叠状态机）。 */
      expanded?: boolean;
    }>(),
    {
      item: null,
      expanded: false,
    },
  );

  const emit = defineEmits<{
    toggle: [];
  }>();

  const rows = computed((): TraceToolRow[] => {
    return props.item != null ? props.item!.rows : ([] as TraceToolRow[]);
  });

  const itemCount = computed((): string => {
    const count = rows.value.length;
    return count + " " + t("Mobile.ThirdParty.MpHtml.itemCount");
  });

  const isRunning = computed((): boolean => props.item != null && props.item!.status == "running");
  const isFailed = computed((): boolean => props.item != null && props.item!.status == "failed");

  const firstKindIconClass = computed((): string => {
    const list = rows.value;
    const first = list.length > 0 ? list[0] : null;
    return traceKindIconClass(first == null ? "generic" : first.kind);
  });

  /**
   * 组头摘要：按 actionKinds 首次出现顺序，取组内同 kind 行的聚合状态生成
   * 动作短语（对齐 PC ToolGroupDisclosure：kind 级状态、file-edit 全新建用「创建」语态）。
   */
  const groupTitle = computed((): string => {
    const group = props.item;
    if (group == null) return t("Mobile.ThirdParty.MpHtml.toolCall");
    const list = group!.rows;
    const kinds = group!.actionKinds;
    let title = "";
    for (let i = 0; i < kinds.length; i++) {
      const kind = kinds[i];
      const matching: TraceToolRow[] = [] as TraceToolRow[];
      let allCreate = true;
      for (let j = 0; j < list.length; j++) {
        if (list[j].kind == kind) {
          matching.push(list[j]);
          if (list[j].isCreate != true) {
            allCreate = false;
          }
        }
      }
      if (matching.length == 0) continue;
      const label = t(
        toolTraceActionI18nKey(
          kind,
          getRowsGroupStatus(matching),
          kind == "file-edit" && allCreate,
        ),
      );
      if (label.length == 0) continue;
      title = title.length == 0 ? label : title + " · " + label;
    }
    if (title.length == 0) {
      return t("Mobile.ThirdParty.MpHtml.toolCall");
    }
    return title;
  });

  function onToggle(): void {
    emit("toggle");
  }
</script>

<style lang="scss" scoped>
  .tool-trace-group {
    width: 100%;
    margin: 10rpx 0;
    border-radius: 12rpx;
    border: 1rpx solid rgba(28, 31, 40, 0.08);
    background-color: #ffffff;
    overflow: hidden;

    &.is-failed {
      .tool-trace-group__title {
        color: #cf222e;
      }
    }

    &__header {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 10rpx;
      min-height: 68rpx;
      padding: 0 20rpx;
      box-sizing: border-box;
      background-color: rgba(18, 23, 43, 0.018);
    }

    &__kind-icon {
      flex-shrink: 0;
      font-size: 26rpx;
      color: #8b8e96;
    }

    &__title {
      flex: 1;
      min-width: 0;
      font-size: 26rpx;
      color: #33363d;
      line-height: 38rpx;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &__status {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32rpx;
      height: 32rpx;
    }

    &__spinner {
      font-size: 26rpx;
      color: #1890ff;
      animation: tool-trace-group-spin 1s linear infinite;
    }

    &__failed-icon {
      flex-shrink: 0;
      font-size: 26rpx;
      color: #ffcb00;
    }

    &__count {
      flex-shrink: 0;
      font-size: 24rpx;
      color: #8b8e96;
      line-height: 34rpx;
    }

    &__arrow {
      flex-shrink: 0;
      font-size: 24rpx;
      color: #8b8e96;
      transition: transform 0.2s ease;

      &.is-expanded {
        transform: rotate(180deg);
      }
    }

    &__body {
      padding: 6rpx 20rpx 10rpx;
      border-top: 1rpx solid rgba(28, 31, 40, 0.06);
      box-sizing: border-box;
    }
  }

  @keyframes tool-trace-group-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
</style>
