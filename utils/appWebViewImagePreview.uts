/**
 * App web-view 内嵌 H5 的图片预览。
 *
 * uni.previewImage 在 H5 关闭时会 history.back / uni.navigateBack，
 * 内嵌 WebView 里会把承载页（agent-detail）一并弹掉，表现为回到首页。
 * 内嵌场景改为自绘遮罩，并由 popupBackRegistry 接管系统返回 / 侧滑。
 */
import { isAppWebViewEmbedded } from "@/utils/appWebViewDetect";

type PreviewOpenHandler = (urls: string[], current: string) => void;
type UniPreviewFn = (options: any) => void;

let previewHostOpen: PreviewOpenHandler | null = null;
let uniPreviewPatched: boolean = false;
let originalUniPreviewImage: UniPreviewFn | null = null;

/**
 * 会话页预览遮罩挂载 / 卸载时登记。
 */
export function setAppWebViewImagePreviewHost(
  open: PreviewOpenHandler | null,
): void {
  previewHostOpen = open;
}

function toUrlList(raw: any): string[] {
  const urls: string[] = [];
  if (raw == null) {
    return urls;
  }
  try {
    const arr = raw as string[];
    const len = arr.length;
    for (let i = 0; i < len; i++) {
      const item = arr[i];
      if (item != null) {
        const text = `${item}`;
        if (text.length > 0) {
          urls.push(text);
        }
      }
    }
  } catch (_e) {
    // ignore
  }
  return urls;
}

function resolveCurrentUrl(urls: string[], currentRaw: any): string {
  if (urls.length == 0) {
    return "";
  }
  if (currentRaw == null) {
    return urls[0];
  }
  if (typeof currentRaw == "number") {
    const idx = currentRaw as number;
    if (idx >= 0 && idx < urls.length) {
      return urls[idx];
    }
    return urls[0];
  }
  const text = `${currentRaw}`;
  if (text.length == 0) {
    return urls[0];
  }
  for (let i = 0; i < urls.length; i++) {
    if (urls[i] == text) {
      return text;
    }
  }
  const asNum = parseFloat(text);
  if (!isNaN(asNum) && asNum >= 0 && asNum < urls.length) {
    const idx = asNum as number;
    return urls[idx];
  }
  return text;
}

function tryOpenHost(urls: string[], current: string): boolean {
  if (isAppWebViewEmbedded() != true) {
    return false;
  }
  const opener = previewHostOpen;
  if (opener == null) {
    return false;
  }
  if (current.length == 0 && urls.length == 0) {
    return false;
  }
  const next = current.length > 0 ? current : urls[0];
  opener?.invoke(urls, next);
  return true;
}

/**
 * 解析 uni.previewImage 入参并尝试走内嵌遮罩。
 * @returns 已由遮罩承接时为 true
 */
export function tryOpenAppWebViewImagePreview(options: any): boolean {
  if (options == null) {
    return false;
  }
  const obj = options as UTSJSONObject;
  const urls = toUrlList(obj["urls"]);
  const current = resolveCurrentUrl(urls, obj["current"]);
  return tryOpenHost(urls, current);
}

/**
 * 与 uni.previewImage 同语义；App 内嵌 H5 走自绘遮罩。
 */
export function previewImageCompat(urls: string[], current: string): void {
  if (tryOpenHost(urls, current) == true) {
    return;
  }
  uni.previewImage({
    urls,
    current,
  });
}

/**
 * 拦截 window.uni.previewImage（mp-html 等 JS 调用），并挂 window.__nuwaxPreviewImage。
 * 幂等；宿主卸载后 patch 仍在，但 host 为空会回退官方预览。
 */
export function installUniPreviewImagePatch(): void {
  // #ifdef H5 || WEB
  if (uniPreviewPatched == true) {
    return;
  }
  try {
    const w = window as any;
    if (w == null) {
      return;
    }
    const uniGlobal = w.uni;
    if (uniGlobal != null && uniGlobal.previewImage != null) {
      originalUniPreviewImage = uniGlobal.previewImage as UniPreviewFn;
      uniGlobal.previewImage = (options: any): void => {
        if (tryOpenAppWebViewImagePreview(options) == true) {
          return;
        }
        const fallback = originalUniPreviewImage;
        if (fallback != null) {
          fallback.invoke(options);
        }
      };
    }
    w.__nuwaxPreviewImage = (options: any): void => {
      if (tryOpenAppWebViewImagePreview(options) == true) {
        return;
      }
      const fallback = originalUniPreviewImage;
      if (fallback != null) {
        fallback.invoke(options);
        return;
      }
      uni.previewImage(options);
    };
    uniPreviewPatched = true;
  } catch (_e) {
    // ignore
  }
  // #endif
}
