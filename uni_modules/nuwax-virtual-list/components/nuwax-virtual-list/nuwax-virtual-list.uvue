<!--
  nuwax-virtual-list — uni-app x 动态高度虚拟滚动列表

  特性：
  1. 虚拟滚动：只渲染可视区 ± bufferCount 条，万级数据流畅滚动（H5/微信小程序/App 统一）
  2. 动态高度：每项高度可随内容变化（流式 Markdown / 图片 / 折叠等），实测高度 + 视口上方高度
     变化自动补偿 scrollTop，视觉稳定不跳动
  3. list-view 全部功能：scroll-top 受控滚动、scroll-with-animation、show-scrollbar、rebound、
     refresher-* 下拉刷新、scrolltoupper/scrolltolower、lower/upper-threshold 等
  4. App 端默认走原生 list-view（原生 recycle + 原生动态高度），native-list=false 可切换为自定义引擎

  与 z-paging-x / list-view 兼容面：
  - list-id 透传到滚动容器节点，支持 uni.getElementById(listId) 读取 scrollTop/scrollHeight/offsetHeight
  - defineExpose: scrollToY / scrollToTop / scrollToBottom / scrollToIndex / scrollToOffset / getScrollTop / refreshSizes / reload
  - @scroll / @scrolltoupper / @scrolltolower 传标准 UniScrollEvent
-->

<template>
  <view class="nvwl-root" :style="rootStyle" @touchstart="onTouchStart" @touchend="onTouchEnd" @touchcancel="onTouchEnd">
    <!-- #ifdef APP -->
    <!-- App：native-list 开启时走原生 list-view（原生 recycle + 原生动态高度） -->
    <list-view
      v-if="useNativeList"
      :id="listId"
      :scroll-top="scrollTopValue"
      :scroll-with-animation="finalScrollWithAnimation"
      :show-scrollbar="showScrollbar"
      :rebound="rebound"
      :lower-threshold="lowerThreshold"
      :upper-threshold="upperThreshold"
      :refresher-enabled="refresherEnabled"
      :refresher-threshold="refresherThreshold"
      :refresher-default-style="refresherDefaultStyle"
      :refresher-triggered="refresherTriggered"
      :refresher-background="refresherBackground"
      @scroll="onNativeScroll"
      @scrolltoupper="onScrollToUpper"
      @scrolltolower="onScrollToLower"
      @refresherpulling="onRefresherPulling"
      @refresherrefresh="onRefresherRefresh"
      @refresherrestore="onRefresherRestore"
      @refresherabort="onRefresherAbort"
    >
      <slot name="header" />
      <list-item v-for="(item, index) in data" :key="keyOfItem(index)">
        <slot name="item" :item="item" :index="index" />
      </list-item>
      <slot name="footer" />
      <list-item v-if="data.length == 0" class="nvwl-empty-cell">
        <view class="nvwl-empty">
          <slot name="empty" />
        </view>
      </list-item>
    </list-view>
    <!-- #endif -->

    <!-- 虚拟滚动引擎：H5 / 微信小程序 / App(native-list=false) -->
    <scroll-view
      v-if="useVirtualEngine"
      :id="listId"
      class="nvwl-scroll"
      :scroll-y="true"
      :scroll-top="scrollTopValue"
      :scroll-with-animation="finalScrollWithAnimation"
      :show-scrollbar="showScrollbar"
      :enable-back-to-top="enableBackToTop"
      :rebound="rebound"
      :lower-threshold="lowerThreshold"
      :upper-threshold="upperThreshold"
      :refresher-enabled="refresherEnabled"
      :refresher-threshold="refresherThreshold"
      :refresher-default-style="refresherDefaultStyle"
      :refresher-triggered="refresherTriggered"
      :refresher-background="refresherBackground"
      @scroll="onVirtualScroll"
      @scrolltoupper="onScrollToUpper"
      @scrolltolower="onScrollToLower"
      @refresherpulling="onRefresherPulling"
      @refresherrefresh="onRefresherRefresh"
      @refresherrestore="onRefresherRestore"
      @refresherabort="onRefresherAbort"
    >
      <slot name="header" />
      <view class="nvwl-pole" :style="poleStyle">
        <view class="nvwl-window" :style="windowStyle">
          <view
            class="nvwl-item"
            v-for="vitem in visibleItems"
            :key="vitem.key"
            :id="itemDomId(vitem.index)"
          >
            <slot name="item" :item="vitem.item" :index="vitem.index" />
          </view>
        </view>
      </view>
      <slot name="footer" />
      <view v-if="data.length == 0" class="nvwl-empty">
        <slot name="empty" />
      </view>
    </scroll-view>

    <!-- 关闭虚拟滚动：scroll-view 全量渲染（保留 list-view 全部功能） -->
    <scroll-view
      v-if="showFullRender"
      :id="listId"
      class="nvwl-scroll"
      :scroll-y="true"
      :scroll-top="scrollTopValue"
      :scroll-with-animation="finalScrollWithAnimation"
      :show-scrollbar="showScrollbar"
      :enable-back-to-top="enableBackToTop"
      :rebound="rebound"
      :lower-threshold="lowerThreshold"
      :upper-threshold="upperThreshold"
      :refresher-enabled="refresherEnabled"
      :refresher-threshold="refresherThreshold"
      :refresher-default-style="refresherDefaultStyle"
      :refresher-triggered="refresherTriggered"
      :refresher-background="refresherBackground"
      @scroll="onNativeScroll"
      @scrolltoupper="onScrollToUpper"
      @scrolltolower="onScrollToLower"
      @refresherpulling="onRefresherPulling"
      @refresherrefresh="onRefresherRefresh"
      @refresherrestore="onRefresherRestore"
      @refresherabort="onRefresherAbort"
    >
      <slot name="header" />
      <view v-for="(item, index) in data" :key="keyOfItem(index)">
        <slot name="item" :item="item" :index="index" />
      </view>
      <slot name="footer" />
      <view v-if="data.length == 0" class="nvwl-empty">
        <slot name="empty" />
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import {
    ref,
    computed,
    watch,
    nextTick,
    onMounted,
    onUnmounted,
    getCurrentInstance,
    type ComponentPublicInstance,
  } from "vue";
  import {
    VirtualListEngine,
    Range,
  } from "@/uni_modules/nuwax-virtual-list/js_sdk/modules/virtual-list-engine.uts";
  import {
    measureItemHeights,
    measureViewportHeight,
  } from "@/uni_modules/nuwax-virtual-list/js_sdk/modules/measure.uts";

  // ==================== 平台标记 ====================
  // #ifdef APP
  const IS_APP = true;
  // #endif
  // #ifndef APP
  const IS_APP = false;
  // #endif

  // ==================== 类型 ====================
  /** 可视窗口中的一项（用 class 而非 interface：UTS 对象字面量只能落 UTSJSONObject/class） */
  class VirtualItem {
    key: string = "";
    item: any | null = null;
    index: number = 0;
    constructor(key: string, item: any | null, index: number) {
      this.key = key;
      this.item = item;
      this.index = index;
    }
  }

  // ==================== 组件属性 ====================
  const props = withDefaults(
    defineProps<{
      /** 列表数据源。元素类型不限（UTSJSONObject / 业务类实例均可，经 any 通道透传给 item 插槽） */
      data: Array<any>;
      /** 项预估高度(px)，动态高度模式仅作未测量项的初始估计，建议按业务最小高度给 */
      itemHeight?: number;
      /** 可视区外缓冲渲染条数（越大滚动越不抖，内存略增） */
      bufferCount?: number;
      /** 容器高度（支持 px / rpx / 百分比），默认 100% 撑满父级 */
      height?: string;
      /** 是否开启虚拟滚动，false 时全量渲染 */
      virtualScroll?: boolean;
      /** App 端是否用原生 list-view（原生 recycle + 原生动态高度）；H5/小程序忽略。false 时 App 也用自定义虚拟引擎 */
      nativeList?: boolean;
      /** 稳定 key 字段（从数据项读取，如 "id"），缺省回退为下标。前插/流式更新时务必提供 */
      keyField?: string;
      /** 滚动容器 id（透传，供 uni.getElementById 使用，如聊天页 "msg-list"） */
      listId?: string;
      /** scroll-top 是否带动画（可被 scrollTo* 方法的 animate 参数临时覆盖） */
      scrollWithAnimation?: boolean;
      /** 是否显示滚动条 */
      showScrollbar?: boolean;
      /** 回到顶部按钮（H5 生效，小程序/App 无此能力） */
      enableBackToTop?: boolean;
      /** iOS 回弹 */
      rebound?: boolean;
      /** 距底部多长距离触发 scrolltolower(px) */
      lowerThreshold?: number;
      /** 距顶部多长距离触发 scrolltoupper(px) */
      upperThreshold?: number;
      /** 是否启用下拉刷新（App/小程序为原生 refresher，H5 无原生实现） */
      refresherEnabled?: boolean;
      refresherThreshold?: number;
      refresherDefaultStyle?: string;
      refresherTriggered?: boolean;
      refresherBackground?: string;
      /** 虚拟滚动模式下：处于底部时是否跟随内容增长自动滚底（聊天流式场景由外层 ScrollManager 接管时应关闭） */
      followBottom?: boolean;
      /** 触底加载更多：开启后触底自动 emit "loadmore"（父组件请求下一页并追加到 data） */
      loadMoreEnabled?: boolean;
      /** 没有更多了：true 时停止触发 loadmore（父组件在最后一页后置 true） */
      loadMoreNoMore?: boolean;
      /** 加载中：true 时暂停触发 loadmore（父组件请求期间置 true，防止重复请求） */
      loadMoreLoading?: boolean;
      /**
       * 初始即从底部开始渲染：进入页面时首屏窗口直接定位到内容底部（只渲染底部附近几条），
       * 测量后自动校准到真实底部。适合「进入即显示最后一条历史会话」的场景。
       * 仅初始化时生效，之后由用户滚动接管。
       */
      initScrollToBottom?: boolean;
    }>(),
    {
      data: (): Array<any> => [] as Array<any>,
      itemHeight: 100,
      bufferCount: 8,
      height: "100%",
      virtualScroll: true,
      nativeList: true,
      keyField: "",
      listId: "",
      scrollWithAnimation: false,
      showScrollbar: true,
      enableBackToTop: false,
      rebound: true,
      lowerThreshold: 50,
      upperThreshold: 0,
      refresherEnabled: false,
      refresherThreshold: 45,
      refresherDefaultStyle: "black",
      refresherTriggered: false,
      refresherBackground: "#FFFFFF",
      followBottom: false,
      loadMoreEnabled: false,
      loadMoreNoMore: false,
      loadMoreLoading: false,
      initScrollToBottom: false,
    },
  );

  // ==================== 插槽与事件 ====================
  defineSlots<{
    item(props: { item: any | null; index: number }): any;
    empty(props: {}): any;
    header(props: {}): any;
    footer(props: {}): any;
    refresher(props: { refresherStatus: number }): any;
  }>();

  const emit = defineEmits<{
    (e: "scroll", ev: UniScrollEvent): void;
    (e: "scrolltoupper"): void;
    (e: "scrolltolower"): void;
    (e: "visible-change", payload: UTSJSONObject): void;
    (e: "loadmore"): void;
    (e: "refresherpulling"): void;
    (e: "refresherrefresh"): void;
    (e: "refresherrestore"): void;
    (e: "refresherabort"): void;
  }>();

  // ==================== 实例与引擎 ====================
  /**
   * 实例唯一后缀：多实例同页时保证测量 id 不冲突。
   * script setup 顶层变量为实例级（不能依赖模块级计数器），用随机数兜底（lime-shared guid 同思路）。
   */
  const uid = "nvwl-" + Math.floor(Math.random() * 1000000);
  const instance = getCurrentInstance();
  const proxy: ComponentPublicInstance | null =
    instance != null ? instance.proxy : null;

  const engine = new VirtualListEngine();
  engine.init(props.data.length, props.itemHeight, props.bufferCount);

  // ==================== 响应式状态 ====================
  const visibleItems = ref<VirtualItem[]>([] as VirtualItem[]);
  /** 窗格顶部距撑杆顶部的偏移（px）：重排时设为 offsets[start]，滑动中不变 → 原生滚动自然流过静态内容，不闪不空白 */
  const startOffset = ref<number>(0);
  const poleHeight = ref<number>(engine.totalHeight);
  /** 绑定 scroll-view :scroll-top 的 ref：只在程序滚动（applyScrollTop）时更新，避免用户滑动时干扰原生手势 */
  const scrollTopValue = ref<number>(0);
  const viewportHeight = ref<number>(600);
  /** 动画临时覆盖：-1 跟随 props.scrollWithAnimation，0/1 强制 关/开 */
  const animOverride = ref<number>(-1);

  // ==================== 非响应式运行态（热路径，避免触发渲染） ====================
  let lastStart = 0;
  let lastEnd = 0;
  /** 原生滚动位置（px）：用户滑动时实时记录，不绑定 scroll-top 以免干扰手势 */
  let nativeScrollTop = 0;
  let measuring = false;
  let userTouching = false;
  let lastScrollTime = 0;
  let idleTimer = 0;
  let viewportMeasured = false;
  /** 数据变化时用户在底部 + follow-bottom：测量完成后跟随内容增长滚底（覆盖视口下方增长场景） */
  let pendingFollow = false;
  /** 前插（加载历史）视角保持：前插前记录滚动基座，测量后按高度差补偿 scrollTop */
  let prependBaseTop = 0;
  let prependBaseHeight = 0;
  let pendingPrepend = false;
  /** loadmore 防抖（毫秒）：防止触底反复触发 */
  let lastLoadMoreEmit = 0;
  /** init-scroll-to-bottom：首屏定位到底部后，测量校准完成前保持 true（测量后滚到真实底部再清除） */
  let initBottomPending = false;
  /** 收敛迭代记录：连续两轮窗口位置与 totalHeight 都稳定才认为已到达真实底部 */
  let initBottomPrevStart = -1;
  let initBottomPrevTotal = -1;

  // ==================== 计算属性 ====================
  const rootStyle = computed((): UTSJSONObject => ({ "height": props.height }));
  const poleStyle = computed((): UTSJSONObject => ({
    "height": poleHeight.value + "px",
  }));
  /** 窗格定位：absolute top = offsets[start]，重排时设置，滑动中固定不动 */
  const windowStyle = computed((): UTSJSONObject => ({
    "top": startOffset.value + "px",
  }));
  const finalScrollWithAnimation = computed((): boolean => {
    if (animOverride.value >= 0) {
      return animOverride.value == 1;
    }
    return props.scrollWithAnimation;
  });
  const useNativeList = computed((): boolean =>
    IS_APP && props.virtualScroll && props.nativeList,
  );
  const useVirtualEngine = computed((): boolean =>
    props.virtualScroll && !useNativeList.value,
  );
  const showFullRender = computed((): boolean =>
    !props.virtualScroll && !useNativeList.value,
  );
  /** watch 用 computed ref 镜像 props.data（uni-app x watch 不支持 getter source，只认 Ref） */
  const dataSource = computed((): Array<any> => props.data);
  const dataLen = computed((): number =>
    props.data != null ? props.data.length : 0,
  );

  // ==================== 工具方法 ====================
  /** 安全读取任意字段（any 通道，兼容 UTSJSONObject 与业务类实例） */
  function readField(item: any | null, key: string): any | null {
    if (item == null) return null;
    try {
      const obj = item as UTSJSONObject;
      const v = obj[key];
      if (v != null) return v;
    } catch (_e) {
      // 类型不匹配时忽略
    }
    return null;
  }

  /** 稳定 key：优先 keyField，缺省回退下标 */
  function keyOfItem(index: number): string {
    const kf = props.keyField;
    if (kf.length > 0 && index >= 0 && index < props.data.length) {
      const raw = readField(props.data[index], kf);
      if (raw != null) return `${raw}`;
    }
    return `${index}`;
  }

  /** 从任意数据项读稳定 key（前插检测用；无 keyField 时返回空串避免误判） */
  function keyOfRaw(item: any | null): string {
    const kf = props.keyField;
    if (kf.length > 0 && item != null) {
      const raw = readField(item, kf);
      if (raw != null) return `${raw}`;
    }
    return "";
  }

  /** H5 同步测量用的节点 id（带实例 uid 防冲突） */
  function itemDomId(index: number): string {
    return "nvwl-item-" + uid + "-" + index;
  }

  /** 测量用的 class 选择器（配合 .in(context) 只命中本实例） */
  function itemSelector(): string {
    return ".nvwl-item";
  }

  // ==================== 窗口计算 ====================
  /**
   * 重排窗口：按滚动位置重算 [start,end]、重建 visibleItems、窗格定位到 offsets[start]。
   * 滑动中不调用（窗格固定不动，原生滚动自然流过内容），仅在缓冲耗尽 / 数据变化时触发。
   */
  function refreshWindow(): void {
    const range: Range = engine.getRange(nativeScrollTop, viewportHeight.value);
    lastStart = range.start;
    lastEnd = range.end;
    const items: VirtualItem[] = [];
    for (let i = range.start; i < range.end; i++) {
      if (i < props.data.length) {
        items.push(new VirtualItem(keyOfItem(i), props.data[i], i));
      }
    }
    visibleItems.value = items;
    startOffset.value = engine.getOffset(range.start);
    poleHeight.value = engine.totalHeight;
    emit("visible-change", { "start": range.start, "end": range.end });
  }

  /** 缓冲耗尽检查：视口滑出窗格上下缓冲 → 重排（滑动中每帧调用，O(1)；窗格不动，内容靠原生滚动流过） */
  function maybeReflow(): void {
    if (props.data.length == 0) return;
    const count = engine.sizes.length;
    const start = lastStart;
    const end = lastEnd;
    if (count == 0 || end <= start) {
      refreshWindow();
      return;
    }
    const buf = engine.bufferCount * engine.estimatedHeight;
    const st = nativeScrollTop;
    const vp = viewportHeight.value;
    // 上方：窗格顶低于视口顶的缓冲线（start>0 才可上扩；start=0 时窗格已含顶部全部内容）
    if (start > 0 && engine.getOffset(start) > st - buf) {
      refreshWindow();
      return;
    }
    // 下方：窗格底不足缓冲（end<count 才可下扩；end=count 已到底）
    if (end < count && engine.getBottom(end - 1) < st + vp + buf) {
      refreshWindow();
    }
  }

  /**
   * 触底加载更多检测：滚动到底部（含 H5 scrolltolower 不可靠的手动兜底）→ emit "loadmore"。
   * 受 loadMoreEnabled / loadMoreNoMore / loadMoreLoading / 800ms 防抖 约束。
   */
  function checkLoadMore(): void {
    if (!props.loadMoreEnabled || props.loadMoreNoMore || props.loadMoreLoading) return;
    if (props.data.length == 0) return;
    const viewport = viewportHeight.value;
    if (viewport <= 0) return;
    const threshold = props.lowerThreshold > 0 ? props.lowerThreshold : 50;
    if (nativeScrollTop + viewport >= engine.totalHeight - threshold) {
      const now = Date.now();
      if (now - lastLoadMoreEmit < 800) return;
      lastLoadMoreEmit = now;
      emit("loadmore");
    }
  }

  // ==================== 滚动控制基础 ====================
  /**
   * 程序滚动到指定位置。先同步为原生位置再下一帧设目标值：
   * 保证重复调用「滚动到同一位置」也生效（与 z-paging-x scrollToY 同一技巧）。
   * scroll-top prop 只在程序滚动时更新，用户滑动时不写（避免干扰原生手势）。
   */
  function applyScrollTop(y: number, animate: boolean): void {
    animOverride.value = animate ? 1 : 0;
    const target = y > 0 ? y : 0;
    scrollTopValue.value = nativeScrollTop;
    nextTick(() => {
      scrollTopValue.value = target;
    });
  }

  // ==================== 测量与高度修正 ====================
  /**
   * 测量后滚动位置修正：仅处理「底部跟随」。
   * 视口上方内容高度变化无需补偿 scrollTop：窗格 translateY 方案下，
   * offsets 变化自动改变窗格位置，视口内容天然保持稳定（也消除了测量→补偿→再测量的乒乓循环）。
   */
  function correctScrollAfterMeasure(): void {
    const now = Date.now();
    const interacting = userTouching || (now - lastScrollTime < 180);
    if (interacting) {
      return;
    }
    const viewport = viewportHeight.value;
    // 数据变化时曾在底部（follow-bottom）：跟随增长滚底，覆盖「追加/长高发生在视口下方」场景
    if (props.followBottom && pendingFollow) {
      pendingFollow = false;
      const target = engine.totalHeight - viewport;
      if (target > 0 && Math.abs(target - nativeScrollTop) > 1) {
        applyScrollTop(target, false);
      }
      return;
    }
    const atBottom =
      viewport > 0 &&
      nativeScrollTop + viewport >= engine.totalHeight - 2;
    if (props.followBottom && atBottom) {
      const target = engine.totalHeight - viewport;
      if (target > 0 && Math.abs(target - nativeScrollTop) > 1) {
        applyScrollTop(target, false);
      }
      return;
    }
  }

  /** 执行一次测量：量可见项 → 更新引擎高度 → 视口上方高度变化补偿 scrollTop */
  async function doMeasure(): Promise<void> {
    if (!props.virtualScroll) {
      measuring = false;
      return;
    }
    if (props.data.length == 0) {
      measuring = false;
      return;
    }
    if (!viewportMeasured) {
      const vh = await measureViewportHeight(proxy, props.listId);
      if (vh > 0) {
        viewportHeight.value = vh;
        viewportMeasured = true;
      }
    }
    const count = visibleItems.value.length;
    const ids: string[] = [];
    const indexes: number[] = [];
    const keys: string[] = [];
    for (let i = 0; i < count; i++) {
      const v = visibleItems.value[i];
      ids.push(itemDomId(v.index));
      indexes.push(v.index);
      keys.push(v.key);
    }
    const heights = await measureItemHeights(proxy, itemSelector(), ids);
    let changed = false;
    const minLen = heights.length < indexes.length ? heights.length : indexes.length;
    for (let i = 0; i < minLen; i++) {
      const h = heights[i];
      if (h > 0) {
        if (engine.setMeasuredHeight(indexes[i], keys[i], h)) {
          changed = true;
        }
      }
    }
    poleHeight.value = engine.totalHeight;
    if (changed) {
      correctScrollAfterMeasure();
    }
    measuring = false;
    maybeReflow();
    // 前插（加载历史）测量完成：按实际高度差精确校准滚动位置，保持视角
    if (pendingPrepend) {
      pendingPrepend = false;
      const actualDelta = engine.totalHeight - prependBaseHeight;
      const target = prependBaseTop + actualDelta;
      if (Math.abs(target - nativeScrollTop) > 1) {
        applyScrollTop(target, false);
      }
    }
    // init-scroll-to-bottom：迭代校准到真实底部。
    // totalHeight = 窗口内实测 + 窗口外估计，初始定位是"估计底部"，需多轮「滚底→测量→再滚底」逼近真实底部；
    // 连续两轮窗口位置(start)与 totalHeight 都无变化才认为收敛（避免在错误位置提前终止）。
    if (initBottomPending) {
      const viewport = viewportHeight.value;
      const atBottom =
        viewport > 0 && nativeScrollTop + viewport >= engine.totalHeight - 2;
      const bottomTarget = engine.totalHeight - viewport;
      const startChanged = lastStart != initBottomPrevStart;
      const totalChanged = Math.abs(engine.totalHeight - initBottomPrevTotal) > 0.5;
      initBottomPrevStart = lastStart;
      initBottomPrevTotal = engine.totalHeight;
      if (!atBottom && bottomTarget > 0) {
        applyScrollTop(bottomTarget, false);
      }
      if (startChanged || totalChanged || changed) {
        // 本轮窗口下移 / 高度更新 → 尚未到达真实底部，继续快速迭代
        // 内联 nextTick 递归（UTS 函数不提升，避免与 scheduleMeasure 互相前向引用）
        measuring = true;
        nextTick(() => {
          doMeasure();
        });
      } else {
        // 收敛：已到达真实底部（窗口内项目均已实测）
        initBottomPending = false;
      }
    }
  }

  /** 触发一次测量（合并到下一帧，去重） */
  function scheduleMeasure(): void {
    if (measuring) return;
    measuring = true;
    nextTick(() => {
      doMeasure();
    });
  }

  /** 滚动停稳后补一次测量，捕捉滚动期间被延迟的内容高度变化 */
  function scheduleIdleMeasure(): void {
    if (idleTimer != 0) clearTimeout(idleTimer);
    idleTimer = setTimeout(() => {
      idleTimer = 0;
      if (measuring) return;
      measuring = true;
      nextTick(() => {
        doMeasure();
      });
    }, 180);
  }

  // ==================== 滚动控制 ====================
  /** 滚动到指定位置（px） */
  function scrollToY(y: number, animate: boolean): void {
    applyScrollTop(y, animate);
  }

  /** 滚动到顶部 */
  function scrollToTop(animate: boolean): void {
    scrollToY(0, animate);
  }

  /** 滚动到底部（虚拟模式滚到内容总高，原生模式用极大值夹到底） */
  function scrollToBottom(animate: boolean): void {
    if (useVirtualEngine.value) {
      scrollToY(engine.totalHeight, animate);
    } else {
      scrollToY(99999999, animate);
    }
  }

  /** 滚动到第 index 项 */
  function scrollToIndex(index: number, animate: boolean): void {
    const target = engine.getScrollOffsetForIndex(index);
    scrollToY(target, animate);
  }

  /** 滚动偏移别名 */
  function scrollToOffset(offset: number, animate: boolean): void {
    scrollToY(offset, animate);
  }

  /** 当前滚动位置（px） */
  function getScrollTop(): number {
    return nativeScrollTop;
  }

  /** 当前可视窗口 [start, end) */
  function getVisibleRange(): UTSJSONObject {
    return { "start": lastStart, "end": lastEnd };
  }

  /** 重新测量当前可视项（内容高度变化后调用，如折叠/图片加载完成） */
  function refreshSizes(): void {
    scheduleMeasure();
  }

  /** 重置测量缓存并回到顶部（数据整体替换后调用） */
  function reload(): void {
    engine.reset();
    engine.init(props.data.length, props.itemHeight, props.bufferCount);
    poleHeight.value = engine.totalHeight;
    lastStart = 0;
    lastEnd = 0;
    nativeScrollTop = 0;
    startOffset.value = 0;
    visibleItems.value = [] as VirtualItem[];
    scrollToY(0, false);
    refreshWindow();
  }

  // ==================== 事件处理 ====================
  /**
   * 虚拟滚动：记录原生位置（不写 scroll-top prop，避免干扰手势）→ 平移窗格 →
   * 缓冲耗尽才重排 → 转发事件 → 停稳后补测。
   * 滑动过程中窗口不重建，原生 view 全程复用，消除闪动。
   */
  function onVirtualScroll(e: UniScrollEvent): void {
    if (e != null && e.detail != null) {
      nativeScrollTop = e.detail.scrollTop;
    }
    lastScrollTime = Date.now();
    maybeReflow();
    emit("scroll", e);
    checkLoadMore();
    scheduleIdleMeasure();
  }

  /** 原生滚动（list-view / 全量 scroll-view）：记录原生位置（不写 scroll-top prop，避免干扰手势）+ 转发 */
  function onNativeScroll(e: UniScrollEvent): void {
    if (e != null && e.detail != null) {
      nativeScrollTop = e.detail.scrollTop;
    }
    lastScrollTime = Date.now();
    emit("scroll", e);
  }

  function onScrollToUpper(): void {
    emit("scrolltoupper");
  }

  function onScrollToLower(): void {
    emit("scrolltolower");
    // 原生触底事件 + 手动检测双保险（H5 scrolltolower 有不可靠历史）
    checkLoadMore();
  }

  function onRefresherPulling(): void {
    emit("refresherpulling");
  }

  function onRefresherRefresh(): void {
    emit("refresherrefresh");
  }

  function onRefresherRestore(): void {
    emit("refresherrestore");
  }

  function onRefresherAbort(): void {
    emit("refresherabort");
  }

  // ==================== 触摸跟踪 ====================
  function onTouchStart(): void {
    userTouching = true;
    // 用户接管滚动：取消挂起的底部跟随 / 初始滚底
    pendingFollow = false;
    initBottomPending = false;
  }

  function onTouchEnd(): void {
    userTouching = false;
    // 手势结束补测一次，捕捉滚动中被延后的高度变化
    scheduleMeasure();
  }

  // ==================== 数据与属性监听 ====================
  /**
   * 数据变化 → 同步引擎（保留已测高度）→ 按需重排。
   * 前插（加载历史）检测：首条 key 变化时记录滚动基座，立即按估计高度差补偿 scrollTop 保持视角，
   * 测量完成后在 doMeasure 里按实际高度差精确校准。UTS 函数声明不提升，须先定义后使用。
   */
  function onDataChanged(oldData: Array<any> | null): void {
    const prevTotal = engine.totalHeight;
    const wasAtBottom =
      viewportHeight.value > 0 &&
      nativeScrollTop + viewportHeight.value >= prevTotal - 2;
    // 前插检测：有旧数组、首条 key 与旧首条不同（顶部加载历史）
    let isPrepend = false;
    if (oldData != null && oldData.length > 0 && props.data.length > 0) {
      isPrepend = keyOfRaw(oldData[0]) != keyOfItem(0);
    }
    if (isPrepend) {
      prependBaseTop = nativeScrollTop;
      prependBaseHeight = prevTotal;
      pendingPrepend = true;
    }
    const firstKey = props.data.length > 0 ? keyOfItem(0) : null;
    engine.syncData(props.data.length, firstKey, (i: number): string => keyOfItem(i));
    poleHeight.value = engine.totalHeight;
    // 数据变化前在底部 + follow-bottom：标记跟随，测量完成后滚底（见 correctScrollAfterMeasure）
    if (props.followBottom && wasAtBottom) {
      pendingFollow = true;
    }
    // 数据收缩/清空后窗口越界 → 直接重排；否则缓冲检查
    if (lastStart >= engine.sizes.length) {
      refreshWindow();
    } else {
      maybeReflow();
    }
    // 数据收缩后如果超出底部，夹回
    const maxScroll = engine.totalHeight - viewportHeight.value;
    if (nativeScrollTop > maxScroll && maxScroll > 0) {
      scrollToY(maxScroll, false);
    }
    // 前插：立即按估计高度差补偿滚动位置（窗口已按新 offsets 重排）
    if (isPrepend) {
      const estimatedDelta = engine.totalHeight - prependBaseHeight;
      const target = prependBaseTop + estimatedDelta;
      applyScrollTop(target, false);
    }
    scheduleMeasure();
  }

  /** 数据变化（引用替换 或 长度变化）→ onDataChanged；引用替换时带旧数组用于前插检测 */
  watch(dataSource, (newVal: Array<any>, oldVal: Array<any>) => {
    onDataChanged(oldVal);
  });
  watch(dataLen, (newVal: number) => {
    onDataChanged(null);
  });

  const itemHeightSource = computed((): number => props.itemHeight);
  const bufferCountSource = computed((): number => props.bufferCount);

  watch(itemHeightSource, (v: number) => {
    if (v > 0) engine.estimatedHeight = v;
  });

  watch(bufferCountSource, (v: number) => {
    if (v >= 0) engine.bufferCount = v;
  });

  // ==================== 生命周期 ====================
  onMounted(() => {
    measureViewportHeight(proxy, props.listId).then((h: number) => {
      if (h > 0) {
        viewportHeight.value = h;
        viewportMeasured = true;
      }
      poleHeight.value = engine.totalHeight;
      if (props.initScrollToBottom && useVirtualEngine.value) {
        // 初始直接从底部渲染：首屏窗口=底部窗口，上方历史消息完全不创建 vnode。
        // 因 totalHeight 为估计值，需经 doMeasure 收敛循环（滚底→测量→再滚底）逼近真实底部。
        initBottomPending = true;
        initBottomPrevStart = -1;
        initBottomPrevTotal = -1;
        const target = Math.max(0, engine.totalHeight - viewportHeight.value);
        nativeScrollTop = target;
        refreshWindow();
        applyScrollTop(target, false);
      } else {
        refreshWindow();
      }
      scheduleMeasure();
    });
    // App 原生 list-view 分支：mounted 后滚到底（原生 recycle 本身只渲染可视 cell）
    if (props.initScrollToBottom && useNativeList.value) {
      nextTick(() => {
        scrollToBottom(false);
      });
    }
  });

  onUnmounted(() => {
    if (idleTimer != 0) clearTimeout(idleTimer);
  });

  // ==================== 对外暴露 ====================
  defineExpose({
    scrollToY,
    scrollToTop,
    scrollToBottom,
    scrollToIndex,
    scrollToOffset,
    getScrollTop,
    getVisibleRange,
    refreshSizes,
    reload,
  });
</script>

<style lang="scss" scoped>
  .nvwl-root {
    width: 100%;
    overflow: hidden;
  }

  .nvwl-scroll {
    width: 100%;
    height: 100%;
  }

  .nvwl-pole {
    position: relative;
    width: 100%;
  }

  .nvwl-window {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
  }

  .nvwl-item {
    width: 100%;
    box-sizing: border-box;
  }

  .nvwl-empty {
    width: 100%;
  }
</style>
