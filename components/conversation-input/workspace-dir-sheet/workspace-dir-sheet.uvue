<template>
  <uni-modal-popup ref="popupRef" position="bottom" height="72%" :show-header="false" :body-scroll="false" @update-visible="handleVisibleChange">
    <view class="sheet" :class="{ 'sheet--avoid-tab-bar': avoidTabBar }">
      <view class="sheet-handle" />
      <view class="sheet-header">
        <view class="header-main">
          <svg-icon name="icon-Folder" size="36" color="#5147ff" />
          <text class="sheet-title">{{ t("Mobile.CreateHub.selectWorkspaceDir") }}</text>
          <text class="sheet-path" :title="currentPath">{{ currentPath.length > 0 ? currentPath.substring(1) : "" }}</text>
        </view>
        <view class="close-button" @click="close">
          <view class="close-line close-line--left" />
          <view class="close-line close-line--right" />
        </view>
      </view>

      <!-- 工具行：上一级 + 面包屑分段跳转（对齐 PC toolbar） -->
      <view class="nav-row">
        <view class="nav-back" :class="{ 'nav-back--disabled': currentPath.length == 0 || loading }" @click="goParent">
          <svg-icon name="icon-a-Chevronleft" size="28" color="#5147ff" />
          <text class="nav-back-text">{{ t("Mobile.CreateHub.backToParent") }}</text>
        </view>
        <scroll-view class="crumb-scroll" :scroll-x="true" direction="horizontal" :show-scrollbar="false">
          <view class="crumb-row">
            <text
              v-for="(crumb, ci) in displayCrumbs"
              :key="`${ci}-${crumb.name}`"
              class="crumb-item"
              :class="{ 'crumb-item--current': ci == displayCrumbs.length - 1 }"
              @click="navigateTo(crumb.index)"
            >{{ crumb.name }}{{ ci < displayCrumbs.length - 1 ? " / " : "" }}</text>
          </view>
        </scroll-view>
        <view class="nav-pick" :class="{ 'nav-pick--disabled': currentPath.length == 0 || loading }" @click="handlePickCurrent">
          <text class="nav-pick-text">{{ t("Mobile.CreateHub.useThisFolder") }}</text>
        </view>
      </view>

      <scroll-view class="dir-list" direction="vertical" :show-scrollbar="false">
        <!-- 最近选择（仅根视图展示；对齐 PC recent 快速重选） -->
        <view v-if="currentPath.length == 0 && loading != true && error != true && recentDirs.length > 0" class="recent-section">
          <text class="recent-title">{{ t("Mobile.CreateHub.recentDirs") }}</text>
          <view v-for="dir in recentDirs" :key="dir" class="dir-row" @click="enterPath(dir)">
            <svg-icon name="icon-Folder" size="36" color="#8a8a8a" />
            <text class="dir-name">{{ dir }}</text>
            <svg-icon name="icon-a-Chevronright" size="24" color="#c7c9d1" />
          </view>
        </view>

        <view v-if="loading" class="state-box"><text class="state-text">...</text></view>
        <view v-else-if="error" class="state-box">
          <view class="retry-button" @click="reload">
            <text class="retry-text">{{ t("Mobile.CreateHub.reloadDir") }}</text>
          </view>
        </view>
        <template v-else>
          <view
            v-for="entry in entries"
            :key="entry.path"
            class="dir-row"
            :class="{ 'dir-row--file': entry.isDir != true }"
            @click="enterDir(entry)"
          >
            <svg-icon name="icon-Folder" size="36" color="#8a8a8a" />
            <text class="dir-name">{{ entry.isHome ? t("Mobile.CreateHub.homeDir") : entry.name }}</text>
            <svg-icon v-if="entry.isDir" name="icon-a-Chevronright" size="24" color="#c7c9d1" />
          </view>
          <view v-if="entries.length == 0 && recentDirs.length == 0" class="state-box">
            <text class="state-text">{{ t("Mobile.CreateHub.emptyDir") }}</text>
          </view>
        </template>
      </scroll-view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, computed, watch, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import SvgIcon from "@/components/svg-icon/svg-icon.uvue";
  import { apiComputerFsChildren, apiComputerFsRoots } from "@/servers/computerFs";
  import { apiResCode, apiResData } from "@/utils/apiResponse.uts";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 最近选择工作目录存储（对齐 PC workspaceDirRecent：localStorage 持久化、去重置顶、封顶 5 条） */
  const RECENT_STORAGE_KEY = "workspace_dir_recent_list";
  const RECENT_LIMIT = 5;

  function loadRecentDirs(): string[] {
    try {
      const raw = uni.getStorageSync(RECENT_STORAGE_KEY);
      if (raw == null) return [] as string[];
      const str = `${raw}`;
      if (str.length == 0) return [] as string[];
      const parsed = JSON.parse(str);
      if (parsed == null || Array.isArray(parsed) != true) return [] as string[];
      const rows = parsed as any[];
      const list = [] as string[];
      for (let i = 0; i < rows.length; i++) {
        const item = `${rows[i]}`;
        if (item.length > 0) list.push(item);
      }
      return list;
    } catch (_error) {
      return [] as string[];
    }
  }

  function addRecentDir(dir: string): string[] {
    const current = loadRecentDirs();
    if (dir.length == 0) return current;
    const next = [] as string[];
    next.push(dir);
    for (let i = 0; i < current.length && next.length < RECENT_LIMIT; i++) {
      if (current[i] != dir) next.push(current[i]);
    }
    try {
      uni.setStorageSync(RECENT_STORAGE_KEY, JSON.stringify(next));
    } catch (_error) {
      // 存储不可用时降级为本次会话内存语义
    }
    return next;
  }

  /** 目录条目（对齐 PC FsDirEntry；roots 视图与逐级子项共用） */
  class FsEntryView {
    name: string = "";
    path: string = "";
    isDir: boolean = true;
    isHome: boolean = false;
  }

  /** 面包屑分段（对齐 PC toCrumbs：兼容 posix/windows 分隔符） */
  class CrumbSegment {
    name: string = "";
    /** 全路径中的第几段（0 = 根视图） */
    index: number = 0;
  }

  /** 按 / 与 \ 切分并去空段（对齐 PC 正则 split 的双平台兼容实现） */
  function splitPathSegments(path: string): string[] {
    const bySlash = path.split("/");
    const segs = [] as string[];
    for (let i = 0; i < bySlash.length; i++) {
      const parts = bySlash[i].split("\\");
      for (let j = 0; j < parts.length; j++) {
        if (parts[j].length > 0) segs.push(parts[j]);
      }
    }
    return segs;
  }

  function toCrumbs(path: string): string[] {
    if (path.length == 0) return ["/"];
    const segs = splitPathSegments(path);
    const head = path.substring(0, 2);
    const isWinDrive = head.length == 2 && head.charAt(1) == ":" &&
      ((head.charAt(0) >= "a" && head.charAt(0) <= "z") || (head.charAt(0) >= "A" && head.charAt(0) <= "Z"));
    if (isWinDrive) return [head, ...segs.slice(1)];
    return ["/", ...segs];
  }

  function crumbPathOf(path: string, index: number): string {
    if (index <= 0) return "";
    const crumbs = toCrumbs(path);
    const segs = crumbs.slice(1, index + 1);
    const head = crumbs[0];
    const sep = head == "/" ? "/" : "\\";
    return head == "/" ? `/${segs.join("/")}` : [head, ...segs].join(sep);
  }

  function parentPathOf(path: string): string {
    const crumbs = toCrumbs(path);
    if (crumbs.length <= 2) return "";
    return crumbPathOf(path, crumbs.length - 2);
  }

  const props = withDefaults(defineProps<{
    visible: boolean;
    /** 个人电脑沙箱 id（目录浏览的目标电脑） */
    sandboxId: string;
    /** 已选目录（空 = 默认工作目录） */
    currentPath?: string;
    avoidTabBar?: boolean;
  }>(), {
    visible: false,
    sandboxId: "",
    currentPath: "",
    avoidTabBar: false,
  });
  const emit = defineEmits<{ (e: "close"): void; (e: "select", path: string): void; }>();

  const popupRef = ref<any | null>(null);
  const loading = ref<boolean>(false);
  const error = ref<boolean>(false);
  const entries = ref<FsEntryView[]>([] as FsEntryView[]);
  // 当前所在目录：空串 = 根视图（未进入任何目录，不可确认）
  const currentPath = ref<string>("");
  const recentDirs = ref<string[]>([] as string[]);
  // 竞态丢弃（对齐 PC loadSeqRef）
  let loadSeq = 0;

  const displayCrumbs = computed((): CrumbSegment[] => {
    const crumbs = toCrumbs(currentPath.value);
    const list = [] as CrumbSegment[];
    for (let i = 1; i < crumbs.length; i++) {
      const seg = new CrumbSegment();
      seg.name = crumbs[i];
      seg.index = i;
      list.push(seg);
    }
    return list;
  });

  function callPopup(method: string): void {
    if (popupRef.value != null) (popupRef.value as ComponentPublicInstance).$callMethod(method);
  }

  function close(): void {
    callPopup("close");
  }

  function handleVisibleChange(value: boolean): void {
    if (value != true) emit("close");
  }

  function parseEntries(raw: any | null): FsEntryView[] {
    const list = [] as FsEntryView[];
    if (raw == null) return list;
    const rows = raw as UTSJSONObject[];
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      const entry = new FsEntryView();
      entry.name = row["name"] != null ? `${row["name"]}` : "";
      entry.path = row["path"] != null ? `${row["path"]}` : "";
      entry.isDir = row["isDir"] == null ? true : row["isDir"] == true;
      if (entry.path.length == 0) continue;
      // 隐藏项（点开头）不进列表（对齐 PC）
      if (entry.name.length > 0 && entry.name.substring(0, 1) == ".") continue;
      list.push(entry);
    }
    return list;
  }

  async function loadRoots(): Promise<void> {
    const seq = loadSeq + 1;
    loadSeq = seq;
    loading.value = true;
    error.value = false;
    try {
      const res = await apiComputerFsRoots(props.sandboxId);
      if (seq != loadSeq) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        error.value = true;
        entries.value = [] as FsEntryView[];
        return;
      }
      const raw = apiResData<any>(res);
      const data = raw != null ? (raw as UTSJSONObject) : null;
      const list = [] as FsEntryView[];
      if (data != null) {
        const rootsRaw = data["roots"];
        if (rootsRaw != null) {
          const roots = rootsRaw as UTSJSONObject[];
          for (let i = 0; i < roots.length; i++) {
            const entry = new FsEntryView();
            entry.name = roots[i]["name"] != null ? `${roots[i]["name"]}` : "";
            entry.path = roots[i]["path"] != null ? `${roots[i]["path"]}` : "";
            entry.isDir = roots[i]["isDir"] == null ? true : roots[i]["isDir"] == true;
            if (entry.path.length == 0 || entry.isDir != true) continue;
            if (entry.name.length > 0 && entry.name.substring(0, 1) == ".") continue;
            list.push(entry);
          }
        }
        // 主目录快捷入口（去重后追加；对齐 PC homeDir）
        const homeRaw = data["home"];
        const home = homeRaw != null ? `${homeRaw}` : "";
        if (home.length > 0) {
          let dup = false;
          for (let i = 0; i < list.length; i++) {
            if (list[i].path == home) { dup = true; break; }
          }
          if (dup != true) {
            const homeEntry = new FsEntryView();
            homeEntry.name = home;
            homeEntry.path = home;
            homeEntry.isDir = true;
            homeEntry.isHome = true;
            list.push(homeEntry);
          }
        }
      }
      entries.value = list;
    } catch (_error2) {
      if (seq == loadSeq) {
        error.value = true;
        entries.value = [] as FsEntryView[];
      }
    } finally {
      if (seq == loadSeq) loading.value = false;
    }
  }

  async function loadChildren(path: string): Promise<void> {
    const seq = loadSeq + 1;
    loadSeq = seq;
    loading.value = true;
    error.value = false;
    try {
      const res = await apiComputerFsChildren(path, props.sandboxId);
      if (seq != loadSeq) return;
      if (apiResCode(res) != SUCCESS_CODE) {
        error.value = true;
        entries.value = [] as FsEntryView[];
        return;
      }
      const raw = apiResData<any>(res);
      const data = raw != null ? (raw as UTSJSONObject) : null;
      entries.value = parseEntries(data != null ? data["entries"] : null);
    } catch (_error2) {
      if (seq == loadSeq) {
        error.value = true;
        entries.value = [] as FsEntryView[];
      }
    } finally {
      if (seq == loadSeq) loading.value = false;
    }
  }

  function reload(): void {
    if (currentPath.value.length == 0) loadRoots();
    else loadChildren(currentPath.value);
  }

  function enterDir(entry: FsEntryView): void {
    if (entry.isDir != true) return;
    currentPath.value = entry.path;
    loadChildren(entry.path);
  }

  function enterPath(path: string): void {
    currentPath.value = path;
    loadChildren(path);
  }

  function navigateTo(index: number): void {
    const next = crumbPathOf(currentPath.value, index);
    currentPath.value = next;
    if (next.length == 0) loadRoots();
    else loadChildren(next);
  }

  function goParent(): void {
    if (currentPath.value.length == 0 || loading.value) return;
    const next = parentPathOf(currentPath.value);
    currentPath.value = next;
    if (next.length == 0) loadRoots();
    else loadChildren(next);
  }

  function handlePickCurrent(): void {
    if (currentPath.value.length == 0 || loading.value) return;
    // 记入最近选择（对齐 PC handleConfirm）
    recentDirs.value = addRecentDir(currentPath.value);
    emit("select", currentPath.value);
    close();
  }

  watch(
    (): boolean => props.visible,
    (value: boolean): void => {
      if (value) {
        // 每次打开回根视图取最新目录 + 读最近选择（对齐 PC）
        currentPath.value = "";
        recentDirs.value = loadRecentDirs();
        loadRoots();
        callPopup("open");
      } else {
        callPopup("close");
      }
    },
  );
</script>

<style lang="scss" scoped>
  .sheet { display: flex; flex-direction: column; height: 100%; padding: 18rpx 32rpx 0; background-color: #ffffff; box-sizing: border-box; }
  /* #ifdef H5 */
  .sheet--avoid-tab-bar { padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
  /* #endif */
  .sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 20rpx; border-radius: 999rpx; background-color: #dedee8; }
  .sheet-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
  .header-main { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; }
  .sheet-title { margin-left: 12rpx; color: #17171c; font-size: 34rpx; line-height: 48rpx; font-weight: 700; flex-shrink: 0; }
  .sheet-path { flex: 1; min-width: 0; margin-left: 16rpx; color: #8a8a8a; font-size: 22rpx; lines: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .close-button { position: relative; width: 52rpx; height: 52rpx; flex-shrink: 0; }
  .close-line { position: absolute; left: 10rpx; top: 25rpx; width: 32rpx; height: 4rpx; border-radius: 999rpx; background-color: #8b8b96; }
  .close-line--left { transform: rotate(45deg); }
  .close-line--right { transform: rotate(-45deg); }

  .nav-row { display: flex; flex-direction: row; align-items: center; padding: 8rpx 0 16rpx; }
  .nav-back { display: flex; flex-direction: row; align-items: center; flex-shrink: 0; }
  .nav-back--disabled { opacity: 0.4; }
  .nav-back-text { color: #5147ff; font-size: 29rpx; }
  .crumb-scroll { flex: 1; min-width: 0; margin: 0 12rpx; }
  .crumb-row { display: flex; flex-direction: row; align-items: center; width: auto; }
  .crumb-item { color: #5147ff; font-size: 23rpx; lines: 1; }
  .crumb-item--current { color: #292930; font-weight: 600; }
  .nav-pick { flex-shrink: 0; padding: 14rpx 32rpx; border-radius: 999rpx; background-color: #5147ff; }
  .nav-pick--disabled { opacity: 0.4; }
  .nav-pick-text { color: #ffffff; font-size: 28rpx; }

  .dir-list { flex: 1; min-height: 0; }
  .recent-section { margin-bottom: 8rpx; }
  .recent-title { color: #9999a3; font-size: 23rpx; margin: 8rpx 8rpx 8rpx; }
  .dir-row { display: flex; flex-direction: row; align-items: center; min-height: 86rpx; padding: 12rpx 16rpx; border-radius: 20rpx; }
  .dir-row--file { opacity: 0.45; }
  .dir-name { flex: 1; min-width: 0; margin-left: 16rpx; color: #292930; font-size: 28rpx; lines: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .state-box { display: flex; align-items: center; justify-content: center; min-height: 200rpx; }
  .state-text { color: #aaaab3; font-size: 26rpx; }
  .retry-button { padding: 12rpx 32rpx; border-radius: 999rpx; background-color: #f3f1ff; }
  .retry-text { color: #5147ff; font-size: 26rpx; }
</style>
