  .mc-header__btn {
    width: 40px;
    height: 40px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mc-header__btn--active {
    opacity: 0.6;
  }

  .mc-header__btn--ghost {
    opacity: 0;
  }

  .mc-header__title-wrap {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mc-header__title {
    font-size: 17px;
    line-height: 24px;
    font-weight: 600;
    color: #141416;
  }

  .mc-body {
    flex: 1;
  }

  .mc-card {
    margin: 10px 12px 0 12px;
    padding: 14px;
    background-color: #ffffff;
    border-radius: 12px;
  }

  .mc-card--row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .mc-row-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-right: 12px;
  }

  /* 字段标题 / 提示文案：取会议「历史记录」卡片标题同色 rgba(21,23,31,0.8)，
     原来的 0.55 / 0.4 在灰底 #f5f6f8 上显得发灰、读不清 */
  .mc-label {
    font-size: 13px;
    line-height: 18px;
    color: rgba(21, 23, 31, 0.8);
  }

  .mc-label--inline {
    flex-shrink: 0;
    margin-right: 12px;
  }

  .mc-hint {
    margin-top: 4px;
    font-size: 11px;
    line-height: 16px;
    color: rgba(21, 23, 31, 0.8);
  }

  .mc-input {
    margin-top: 8px;
    height: 24px;
    font-size: 16px;
    line-height: 24px;
    color: #141416;
  }

  /* 会议号一行：号 + 三个文字操作（换一个 / 复制 / 复制邀请），窄屏换行仍右对齐 */
  .mc-row-value {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    row-gap: 4px;
  }

  .mc-no {
    font-size: 16px;
    line-height: 22px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #141416;
  }

  .mc-pill {
    margin-left: 12px;
    padding: 2px 0;
    font-size: 12px;
    line-height: 18px;
    color: #5147ff;
  }

  .mc-pill--active {
    opacity: 0.6;
  }

  .mc-switch {
    transform: scale(0.85);
  }

  /* ===== 邀请参会人（选人盒：与建群页 cg-tagbox / 预约页 ms-tagbox 同款） ===== */
  .mc-tagbox {
    margin-top: 8px;
    min-height: 40px;
    padding: 4px 4px 4px 12px;
    border-radius: 10px;
    background-color: #f6f5f8;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    box-sizing: border-box;
  }

  /* Android 原生输入控件底部视觉偏高，建群页同样只去掉下内边距（真机实测） */
  /* #ifdef APP-ANDROID */
  .mc-tagbox {
    padding-bottom: 0;
  }
  /* #endif */

  .mc-tagbox-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }

  /* 输入外固定高行槽：Android EditText 按内容行盒测量、可超 CSS 高，
     直接作 flex 子项会把盒子撑高（建群页同款处理），超出部分裁掉 */
  .mc-tagbox-field {
    flex: 1;
    min-width: 60px;
    height: 32px;
    display: flex;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
  }

  .mc-tagbox-input {
    flex: 1;
    /* H5 高度+行高必须同值成对设（同建群页注释：placeholder 是绝对定位盒子） */
    height: 32px;
    /* #ifdef H5 */
    line-height: 32px;
    /* #endif */
    font-size: 14px;
    color: #1c1b20;
  }

  .mc-search-icon {
    width: 32px;
    height: 32px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mc-ph {
    color: #b7b7be;
    font-size: 13px;
  }

  /* 灰盒内白芯 tag（描边分隔），点整芯移除 */
  .mc-tag {
    margin: 0 8px 6px 0;
    padding: 4px 10px;
    border-radius: 16px;
    background-color: #ffffff;
    border: 1px solid #eceaf1;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
  }

  .mc-tag--active {
    background-color: #f4f3fa;
  }

  .mc-tag__text {
    color: #4b4b52;
    font-size: 12px;
    line-height: 17px;
  }

  .mc-tag__x {
    margin-left: 5px;
    color: #9a9aa2;
    font-size: 14px;
    line-height: 17px;
  }

  /* ===== 候选面板（盒子下方，常驻） ===== */
  .mc-panel {
    margin-top: 8px;
    border-radius: 10px;
    background-color: #f9f9fb;
    overflow: hidden;
  }

  /* 高度由模板上的 :style 按行数算出（见 inviteeListHeight） */
  .mc-panel-list {
    width: 100%;
  }

  .mc-panel-body {
    padding: 2px 0;
  }

  .mc-panel-state {
    padding: 20px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mc-panel-state__text {
    font-size: 12px;
    line-height: 17px;
    color: #9a9aa2;
  }

  .mc-panel-row {
    padding: 0 12px;
    height: 44px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #efeff4;
  }

  .mc-panel-row--active {
    background-color: #f2f1f7;
  }

  .mc-panel-row__name {
    flex: 1;
    min-width: 0;
    font-size: 14px;
    line-height: 20px;
    color: #1c1b20;
  }

  .mc-panel-check {
    width: 18px;
    height: 18px;
    margin-left: 12px;
    border-radius: 9px;
    border: 1px solid #d8d7e0;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mc-panel-check--on {
    border-color: #5147ff;
    background-color: #5147ff;
  }

  /* 提交按钮：建房成功后本页会被 redirectTo 换掉，不再有「已创建」结果屏样式 */
  .mc-submit {
    margin: 20px 12px 0 12px;
  }

  /* 主操作黑色（PC 端主按钮同款；预约页「保存」、加入页「加入」同一套） */
  .mc-primary {
    height: 46px;
    border-radius: 23px;
    background-color: #111111;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mc-primary--disabled {
    opacity: 0.6;
  }

  .mc-primary--active {
    opacity: 0.85;
  }

  .mc-primary__text {
    font-size: 15px;
    line-height: 21px;
    font-weight: 600;
    color: #ffffff;
  }

  .mc-tail {
    height: 32px;
  }
</style>
