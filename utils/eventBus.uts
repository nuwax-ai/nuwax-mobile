/**
 * 事件总线封装
 *
 * 对外提供与 PC 端一致的 API：on / off / emit / once
 * ★纯 UTS 自有订阅表，不走 uni.$on/$emit：App-Android 上经 uni 事件机制注册的
 * 订阅者不被调用（IM 实时链路真机多轮实锤：帧到达、ACK 回包正常，订阅者零触发）。
 * ★★EventCallback 必须是「单参无变参」签名：(payload: any) => void。曾用
 * (...args: any[]) => void——编译能过，但编译器会按 uni.$emit 展开约定把订阅箭头
 * 改写成「收参数数组、取 [0]」形态（编译产物实证：do_not_transform_spread[0]），
 * 与本总线 cb(payload) 单参调用在运行时错配，首个监听器抛错被 WS 回调边界吞掉、
 * 同轮后续监听器全部不执行（表现：emit 静默失效）。单参签名让订阅方与回调类型
 * 精确一致，编译器不再做任何适配改写。iOS/H5 同语义（同步分发、注册序、单载荷）。
 *
 * 分发带诊断日志（EVENT_BUS_DEBUG）：emit 打印监听数、监听器异常单独捕获打印，
 * 避免一个监听器抛错中断同轮其余分发（uni.$emit 路径无此保护）。
 * 裸 uni.$on 直用的监听名与本总线事件名无交集，两套互不受影响。
 *
 * 参考文档：https://doc.dcloud.net.cn/uni-app-x/api/event-bus.html
 */

/** 分发诊断日志开关（Android 实时链路已验证通过，2026-09-26 置 false 降噪；排查时改回 true）。 */
const EVENT_BUS_DEBUG = false;

function busLog(msg: string): void {
  if (EVENT_BUS_DEBUG) {
    console.log(`[EventBus] ${msg}`);
  }
}

/** 订阅回调：★单参非变参（见文件头 ★★ 说明，勿改回 (...args) 形态）。 */
type EventCallback = (payload: any) => void;

/**
 * 事件总线类
 */
class EventBus {
  /** 订阅表：eventName → 回调列表（注册序）。 */
  private listeners = new Map<string, EventCallback[]>();
  /** once 标记：触发前先注销（Kotlin 不支持闭包自引用，用标记表实现）。 */
  private onceFlags = new Set<EventCallback>();

  /**
   * 订阅事件
   * @param eventName 事件名称
   * @param callback 回调函数
   */
  on(eventName: string, callback: EventCallback): void {
    const list = this.listeners.get(eventName);
    if (list != null) {
      list.push(callback);
      busLog(`on ${eventName} → total ${list.length}`);
      return;
    }
    const arr: EventCallback[] = [];
    arr.push(callback);
    this.listeners.set(eventName, arr);
    busLog(`on ${eventName} → total 1`);
  }

  /**
   * 取消订阅
   * @param eventName 事件名称
   * @param callback 回调函数（须与 on 时同一引用）
   */
  off(eventName: string, callback: EventCallback): void {
    this.onceFlags.delete(callback);
    const list = this.listeners.get(eventName);
    if (list == null) {
      return;
    }
    const idx = list.indexOf(callback);
    if (idx < 0) {
      return;
    }
    list.splice(idx, 1);
    if (list.length == 0) {
      this.listeners.delete(eventName);
    }
    busLog(`off ${eventName} → total ${list.length}`);
  }

  /**
   * 发布事件
   * @param eventName 事件名称
   * @param args 参数（仓库内调用方均为单载荷，只分发首个；与 iOS 已验证的
   *             uni.$emit 实际送达形态一致）
   */
  emit(eventName: string, ...args: any[]): void {
    const list = this.listeners.get(eventName);
    // 直接判空收窄：局部 val 经 if (list == null) return 后 Kotlin smart cast 到非空；
    // 经派生变量间接判空不收窄（nullable receiver 不许 .length，真机构建实锤）
    if (list == null) {
      busLog(`emit ${eventName} → 0 listener(s), no-op`);
      return;
    }
    busLog(`emit ${eventName} → ${list.length} listener(s)`);
    // 快照遍历：回调内 off（自身或其他订阅）不影响本轮已入快照的分发
    const snapshot: EventCallback[] = [];
    for (let i = 0; i < list.length; i++) {
      snapshot.push(list[i]);
    }
    if (args.length == 0) {
      // 无实参 emit 本仓库无用法，防御不分发（原路径下订阅者收到的也是 null，
      // 各处理器首行判空返回，行为等价）
      return;
    }
    // args[0] 索引访问即非空 Any：★不能经三元或 ?? 掺 null，Any? 传 any 形参
    // 过不了 Kotlin 编译（error17，真机构建实锤）
    const payload = args[0];
    for (let i = 0; i < snapshot.length; i++) {
      const cb = snapshot[i];
      if (this.onceFlags.has(cb)) {
        this.onceFlags.delete(cb);
        this.off(eventName, cb);
      }
      // 单监听器异常不中断同轮其余分发（曾因无保护被 WS 回调边界整体吞掉）
      try {
        cb(payload);
      } catch (e) {
        console.error(`[EventBus] listener ${eventName}#${i} threw: ${e != null ? `${e}` : "unknown"}`);
      }
    }
  }

  /**
   * 一次性订阅事件（触发一次后自动取消）
   * @param eventName 事件名称
   * @param callback 回调函数
   */
  once(eventName: string, callback: EventCallback): void {
    this.onceFlags.add(callback);
    this.on(eventName, callback);
  }
}

// 创建全局事件总线实例
const eventBus = new EventBus();

export default eventBus;

// 定义常用的事件名称常量（与 PC 端保持一致）
export const EVENT_NAMES = {
  // 发送聊天消息事件
  SEND_CHAT_MESSAGE: 'send_chat_message',
  // 清空聊天输入框事件
  CLEAR_CHAT_INPUT: 'clear_chat_input',
} as const;
