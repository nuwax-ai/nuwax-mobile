<template>
  <view class="task-result-card" @tap="handleClick">
    <view class="task-result-card__icon">
      <svg-icon name="icon-a-Filetext" size="32" />
    </view>
    <view class="task-result-card__content">
      <text class="task-result-card__title">{{ displayText }}</text>
      <text
        v-if="description.length > 0 && fileName.length > 0"
        class="task-result-card__file"
      >{{ fileName }}</text>
    </view>
    <view class="task-result-card__arrow">
      <svg-icon name="icon-a-Chevronright" size="24" />
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    getFileProxyUrlByConversationIdAndFilePath,
    jumpToFilePreviewPage,
  } from "@/utils/system.uts";

  const props = withDefaults(
    defineProps<{
      /** 解析后的 task-result 数据。 */
      taskResultData: any;
      /** 当前会话 ID，可带 chat- 前缀。 */
      conversationId?: string;
    }>(),
    {
      conversationId: "",
    },
  );

  function readDataField(key: string): string {
    const source = props.taskResultData;
    if (source == null) return "";
    const obj = source as UTSJSONObject;
    const value = obj[key];
    return value != null ? `${value}` : "";
  }

  const description = computed((): string => readDataField("description"));
  const fileName = computed((): string => readDataField("file"));
  const displayText = computed((): string => {
    if (description.value.length > 0) return description.value;
    if (fileName.value.length > 0) return fileName.value;
    return "查看结果";
  });

  /** 打开任务产物文件；无会话时交给页面事件处理。 */
  async function handleClick(): Promise<void> {
    let conversationId = props.conversationId;
    if (conversationId.startsWith("chat-")) {
      conversationId = conversationId.substring(5);
    }
    if (conversationId.length == 0 || fileName.value.length == 0) {
      const payload = new UTSJSONObject();
      payload["data"] = props.taskResultData;
      payload["fileName"] = fileName.value;
      payload["description"] = description.value;
      uni.$emit("task_result_click", payload);
      return;
    }
    try {
      const parts = fileName.value.split(conversationId + "/");
      const fileId = parts.length > 0 ? parts[parts.length - 1] : fileName.value;
      const proxyUrlRaw =
        await getFileProxyUrlByConversationIdAndFilePath(
          conversationId,
          fileId,
        );
      const proxyUrl = proxyUrlRaw != null ? `${proxyUrlRaw}` : "";
      jumpToFilePreviewPage(conversationId, proxyUrl);
    } catch (error) {
      console.error("[TaskResult] 打开任务结果失败:", error);
      uni.showToast({ title: "打开文件失败", icon: "none" });
    }
  }
</script>

<style lang="scss" scoped>
  .task-result-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin: 16rpx 0;
    padding: 18rpx 20rpx;
    border-radius: 16rpx;
    background-color: rgba(12, 20, 102, 0.045);
    box-sizing: border-box;

    &__icon,
    &__arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    &__icon {
      width: 40rpx;
      height: 40rpx;
      margin-right: 12rpx;
    }

    &__content {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-width: 0;
    }

    &__title {
      color: #333333;
      font-size: 28rpx;
      font-weight: 600;
      line-height: 40rpx;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &__file {
      margin-top: 4rpx;
      color: #8b8e96;
      font-size: 23rpx;
      line-height: 32rpx;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &__arrow {
      width: 32rpx;
      height: 32rpx;
      margin-left: 12rpx;
    }
  }
</style>
