/**
 * 流式 Markdown 稳定切点：切点之前可冻结不再重解析，之后为仍在增长的 live 区。
 * 供 App 增量 fallback 使用（纯函数，便于 Node 自测镜像）。
 *
 * 工具卡约定：文末相连的工具（含 process-group）流式期间不得冻入 stable，
 * 否则第一张进冻结区、后续进 live，会先分开显示、结束才合组。
 */

import { findIncompleteCustomMarkupTailStart } from "@/utils/markdownCustomProcess.uts";

/**
 * 未闭合 ``` 代码围栏起点；无则 -1。
 */
function findUnclosedCodeFenceStart(text: string): number {
  let search = 0;
  let openAt = -1;
  while (search < text.length) {
    const idx = text.indexOf("```", search);
    if (idx < 0) {
      break;
    }
    if (openAt < 0) {
      openAt = idx;
      search = idx + 3;
      continue;
    }
    // 闭合
    openAt = -1;
    search = idx + 3;
  }
  return openAt;
}

/**
 * 未闭合块级 $$ 起点；无则 -1。
 * 跳过行内单 $；成对 $$ 开合交替。
 */
function findUnclosedBlockMathStart(text: string): number {
  let search = 0;
  let openAt = -1;
  while (search < text.length) {
    const idx = text.indexOf("$$", search);
    if (idx < 0) {
      break;
    }
    if (openAt < 0) {
      openAt = idx;
      search = idx + 2;
      continue;
    }
    openAt = -1;
    search = idx + 2;
  }
  return openAt;
}

/**
 * 未闭合块级公式起点（$$ 成对开合 / \[ 需配对 \]），无则 -1。
 * 代码围栏内的 $$ / \[ 不识别（围栏未闭合时内部内容不视为公式）。
 * 用于流式「整体冻结到闭合」：live 区出现未闭合块级公式时，公式及之后内容不上屏，
 * 直到闭合后才连同后续内容一并上屏（对齐官方 runTask：公式开头未闭合即 return 冻结）。
 */
export function findUnclosedBlockFormulaStart(text: string): number {
  if (text.length == 0) {
    return -1;
  }
  let inFence = false;
  let dOpen = -1;
  let bOpen = -1;
  const n = text.length;
  let i = 0;
  while (i < n) {
    const c = text.charAt(i);
    if (inFence == true) {
      if (
        c == "`" &&
        i + 2 < n &&
        text.charAt(i + 1) == "`" &&
        text.charAt(i + 2) == "`"
      ) {
        inFence = false;
        i += 3;
        continue;
      }
      i++;
      continue;
    }
    if (
      c == "`" &&
      i + 2 < n &&
      text.charAt(i + 1) == "`" &&
      text.charAt(i + 2) == "`"
    ) {
      inFence = true;
      i += 3;
      continue;
    }
    if (c == "$" && i + 1 < n && text.charAt(i + 1) == "$") {
      if (dOpen < 0) {
        dOpen = i;
      } else {
        dOpen = -1;
      }
      i += 2;
      continue;
    }
    if (c == "\\" && i + 1 < n && text.charAt(i + 1) == "[") {
      if (bOpen < 0) {
        bOpen = i;
      }
      i += 2;
      continue;
    }
    if (c == "\\" && i + 1 < n && text.charAt(i + 1) == "]") {
      bOpen = -1;
      i += 2;
      continue;
    }
    i++;
  }
  let best = -1;
  if (dOpen >= 0) {
    best = dOpen;
  }
  if (bOpen >= 0 && (best < 0 || bOpen < best)) {
    best = bOpen;
  }
  return best;
}

/**
 * 文末仍在增长的 GFM 表格起点（末尾连续 | 行且未以空行结束）。
 * 无则 -1。
 */
function findTrailingOpenTableStart(text: string): number {
  if (text.length == 0) {
    return -1;
  }
  const normalized = text.replace(/\r\n/g, "\n");
  const lines = normalized.split("\n");
  if (lines.length == 0) {
    return -1;
  }
  // 末行非空且是表行 → 表可能仍在增长
  let end = lines.length - 1;
  while (end >= 0 && lines[end].trim().length == 0) {
    end--;
  }
  if (end < 0) {
    return -1;
  }
  if (!lines[end].trim().startsWith("|")) {
    return -1;
  }
  // 向上收齐连续表行（含分隔行）
  let startLine = end;
  while (startLine > 0) {
    const prev = lines[startLine - 1].trim();
    if (prev.length == 0) {
      break;
    }
    if (!prev.startsWith("|")) {
      break;
    }
    startLine--;
  }
  // 至少两行才像表（表头+分隔或表头+数据）；单行 | 也可能是半截表
  // 计算该 startLine 在原文中的字符偏移
  let offset = 0;
  for (let i = 0; i < startLine; i++) {
    offset += lines[i].length + 1; // + \n
  }
  return offset;
}

/**
 * 在 limit 之前找最后一个段落边界（\n\n 之后），作为可冻结终点。
 * 找不到返回 0。
 */
function lastParagraphBoundaryBefore(text: string, limit: number): number {
  const sliceEnd = limit > text.length ? text.length : limit;
  if (sliceEnd <= 0) {
    return 0;
  }
  const region = text.substring(0, sliceEnd);
  const idx = region.lastIndexOf("\n\n");
  if (idx < 0) {
    return 0;
  }
  return idx + 2;
}

/**
 * 纯散文单段时，把可冻结终点推进到最后一个单个 \n 行边界（含该换行）。
 * 仅当正文不包含任何跨行块结构时由 findStableMarkdownCut 调用：
 * 避免长单段回复（无空行）每次都全量重解析整段 → 累计 O(n²) 打满主线程。
 * 副作用：流式期间单段会被拆成多行展示，终态 endStreamListDraft 全量重解析会合回一段。
 */
function lastSoftLineBoundaryBefore(text: string, limit: number): number {
  const sliceEnd = limit > text.length ? text.length : limit;
  if (sliceEnd <= 0) {
    return 0;
  }
  const region = text.substring(0, sliceEnd);
  const idx = region.lastIndexOf("\n");
  if (idx < 0) {
    return 0;
  }
  return idx + 1;
}

/**
 * 是否为纯散文（可安全按单个 \n 冻结）。
 * 出现任一跨行块结构 / 空行则返回 false，回退原 \n\n 语义：
 * - ``` 代码围栏、$$ 块级公式、<markdown-custom 自定义标签、![ 图片
 * - 空行 \n\n（已有段落边界，走原逻辑）
 * - 行首块标记：# 标题、> 引用、| 表格、- / * / + 列表项、数字. 有序列表
 */
function isSafeProseText(text: string): boolean {
  if (text.length == 0) {
    return false;
  }
  if (text.indexOf("```") >= 0) {
    return false;
  }
  if (text.indexOf("$$") >= 0) {
    return false;
  }
  if (text.indexOf("<markdown-custom") >= 0) {
    return false;
  }
  if (text.indexOf("![") >= 0) {
    return false;
  }
  if (text.indexOf("\n\n") >= 0) {
    return false;
  }
  const lines = text.split("\n");
  const linesLen = lines.length;
  for (let i = 0; i < linesLen; i++) {
    const t = lines[i].trim();
    if (t.length == 0) {
      return false;
    }
    const c = t.charAt(0);
    if (c == "#" || c == ">" || c == "|") {
      return false;
    }
    if (
      (c == "-" || c == "*" || c == "+") &&
      t.length > 1 &&
      isWhitespaceChar(t.charAt(1)) == true
    ) {
      return false;
    }
    if (isOrderedListItemStart(t) == true) {
      return false;
    }
  }
  return true;
}

/** 是否有序列表项起点（如 "1. "、"1) "、"1、"）。 */
function isOrderedListItemStart(t: string): boolean {
  let i = 0;
  const n = t.length;
  while (i < n && t.charAt(i) >= "0" && t.charAt(i) <= "9") {
    i++;
  }
  if (i == 0) {
    return false;
  }
  if (i < n) {
    const marker = t.charAt(i);
    if (marker == "." || marker == ")" || marker == "、") {
      if (i + 1 >= n || isWhitespaceChar(t.charAt(i + 1)) == true) {
        return true;
      }
    }
  }
  return false;
}

function earlierNonNeg(a: number, b: number): number {
  if (a < 0) {
    return b;
  }
  if (b < 0) {
    return a;
  }
  return a < b ? a : b;
}

function maxInt(a: number, b: number): number {
  return a > b ? a : b;
}

function isWhitespaceChar(ch: string): boolean {
  return ch == " " || ch == "\n" || ch == "\r" || ch == "\t";
}

function isTerminalProcessOpenTag(openTag: string): boolean {
  return (
    openTag.indexOf('status="FINISHED"') >= 0 ||
    openTag.indexOf('status="FAILED"') >= 0 ||
    openTag.indexOf("status='FINISHED'") >= 0 ||
    openTag.indexOf("status='FAILED'") >= 0
  );
}

/**
 * 解析单个 markdown-custom-process（非 group）块终点；失败返回 -1。
 */
function scanProcessBlockEnd(slice: string, openIdx: number): number {
  const openMarker = "<markdown-custom-process";
  if (slice.substring(openIdx, openIdx + openMarker.length) != openMarker) {
    return -1;
  }
  const afterName = openIdx + openMarker.length;
  if (slice.substring(afterName, afterName + 6) == "-group") {
    return -1;
  }
  const gt = slice.indexOf(">", afterName);
  if (gt < 0) {
    return -1;
  }
  let blockEnd = gt + 1;
  if (slice.charAt(gt - 1) != "/") {
    const closeMarker = "</markdown-custom-process>";
    const closeIdx = slice.indexOf(closeMarker, gt);
    if (closeIdx < 0) {
      return -1;
    }
    blockEnd = closeIdx + closeMarker.length;
  }
  return blockEnd;
}

/**
 * 吃掉紧随的空白与可选 </div>，返回新终点。
 */
function expandAfterProcessBlock(slice: string, blockEnd: number): number {
  let lastEnd = blockEnd;
  let p = blockEnd;
  while (p < slice.length && isWhitespaceChar(slice.charAt(p)) == true) {
    p++;
  }
  if (slice.substring(p, p + 6).toLowerCase() == "</div>") {
    lastEnd = p + 6;
  }
  return lastEnd;
}

/**
 * 已终态工具块可冻终点。
 * - process-group：整组全 FINISHED/FAILED 才冻到组闭合；禁止切在组中（否则拆开显示）。
 * - 独立 process：FINISHED/FAILED 可冻。
 * @returns exclusive end；无可冻返回 0
 */
function endOfFinishedCustomBlocks(text: string, limit: number): number {
  const sliceEnd = limit > text.length ? text.length : limit;
  if (sliceEnd <= 0) {
    return 0;
  }
  const slice = text.substring(0, sliceEnd);
  const openMarker = "<markdown-custom-process";
  const groupOpen = "<markdown-custom-process-group>";
  const groupClose = "</markdown-custom-process-group>";
  let search = 0;
  let lastEnd = 0;

  while (search < slice.length) {
    const groupIdx = slice.indexOf(groupOpen, search);
    const procIdx = slice.indexOf(openMarker, search);
    if (groupIdx < 0 && procIdx < 0) {
      break;
    }

    // 优先消费完整 group，避免组内 process 被单独冻到组中
    if (groupIdx >= 0 && (procIdx < 0 || groupIdx <= procIdx)) {
      const innerStart = groupIdx + groupOpen.length;
      const closeIdx = slice.indexOf(groupClose, innerStart);
      if (closeIdx < 0) {
        // 组未闭合：不可冻及组内任何部分
        break;
      }
      const inner = slice.substring(innerStart, closeIdx);
      let allTerminal = true;
      let hasProcess = false;
      let innerSearch = 0;
      while (innerSearch < inner.length) {
        const pIdx = inner.indexOf(openMarker, innerSearch);
        if (pIdx < 0) {
          break;
        }
        const after = pIdx + openMarker.length;
        if (inner.substring(after, after + 6) == "-group") {
          innerSearch = after + 6;
          continue;
        }
        const gt = inner.indexOf(">", after);
        if (gt < 0) {
          allTerminal = false;
          break;
        }
        hasProcess = true;
        const openTag = inner.substring(pIdx, gt + 1);
        if (isTerminalProcessOpenTag(openTag) != true) {
          allTerminal = false;
          break;
        }
        const blockEndRel = scanProcessBlockEnd(inner, pIdx);
        if (blockEndRel < 0) {
          allTerminal = false;
          break;
        }
        innerSearch = blockEndRel;
      }
      const groupEnd = closeIdx + groupClose.length;
      if (hasProcess == true && allTerminal == true) {
        lastEnd = expandAfterProcessBlock(slice, groupEnd);
      }
      search = groupEnd;
      continue;
    }

    // 独立 process（不在 group 内；上面已跳过 group）
    if (procIdx < 0) {
      break;
    }
    const afterName = procIdx + openMarker.length;
    if (slice.substring(afterName, afterName + 6) == "-group") {
      search = afterName + 6;
      continue;
    }
    const gt = slice.indexOf(">", afterName);
    if (gt < 0) {
      break;
    }
    const openTag = slice.substring(procIdx, gt + 1);
    const blockEnd = scanProcessBlockEnd(slice, procIdx);
    if (blockEnd < 0) {
      break;
    }
    if (isTerminalProcessOpenTag(openTag) == true) {
      lastEnd = expandAfterProcessBlock(slice, blockEnd);
    }
    search = blockEnd;
  }
  return lastEnd;
}

class ToolBlockRange {
  start: number = 0;
  end: number = 0;
}

/**
 * 收集正文中的工具块范围（group / process / :::container）。
 */
function collectToolBlockRanges(text: string): ToolBlockRange[] {
  const ranges: ToolBlockRange[] = [];
  const openMarker = "<markdown-custom-process";
  const groupOpen = "<markdown-custom-process-group>";
  const groupClose = "</markdown-custom-process-group>";
  const containerMarker = ":::container";
  let search = 0;
  while (search < text.length) {
    const groupIdx = text.indexOf(groupOpen, search);
    const procIdx = text.indexOf(openMarker, search);
    const fenceIdx = text.indexOf(containerMarker, search);

    let best = -1;
    let kind = "";
    if (groupIdx >= 0) {
      best = groupIdx;
      kind = "group";
    }
    if (procIdx >= 0 && (best < 0 || procIdx < best)) {
      best = procIdx;
      kind = "process";
    }
    if (fenceIdx >= 0 && (best < 0 || fenceIdx < best)) {
      best = fenceIdx;
      kind = "container";
    }
    if (best < 0 || kind.length == 0) {
      break;
    }

    if (kind == "group") {
      const closeIdx = text.indexOf(groupClose, best + groupOpen.length);
      if (closeIdx < 0) {
        const r = new ToolBlockRange();
        r.start = best;
        r.end = text.length;
        ranges.push(r);
        break;
      }
      const r = new ToolBlockRange();
      r.start = best;
      r.end = closeIdx + groupClose.length;
      ranges.push(r);
      search = r.end;
      continue;
    }

    if (kind == "process") {
      const afterName = best + openMarker.length;
      if (text.substring(afterName, afterName + 6) == "-group") {
        search = afterName + 6;
        continue;
      }
      const blockEnd = scanProcessBlockEnd(text, best);
      if (blockEnd < 0) {
        const r = new ToolBlockRange();
        r.start = best;
        r.end = text.length;
        ranges.push(r);
        break;
      }
      // 与 endOfFinished 一致：吃掉紧随 </div>，避免文末簇误判
      const expanded = expandAfterProcessBlock(text, blockEnd);
      const r = new ToolBlockRange();
      r.start = best;
      r.end = expanded;
      ranges.push(r);
      search = expanded;
      continue;
    }

    // :::container ...\n:::
    const after = best + containerMarker.length;
    if (after < text.length) {
      const next = text.charAt(after);
      if (next != " " && next != "\t" && next != "\n" && next != "\r") {
        search = after;
        continue;
      }
    }
    const closeIdx = text.indexOf("\n:::", after);
    if (closeIdx < 0) {
      const r = new ToolBlockRange();
      r.start = best;
      r.end = text.length;
      ranges.push(r);
      break;
    }
    const r = new ToolBlockRange();
    r.start = best;
    r.end = closeIdx + "\n:::".length;
    ranges.push(r);
    search = r.end;
  }
  return ranges;
}

/**
 * 文末相连工具簇起点：从文末向前，仅空白间隔的连续工具块。
 * 流式时这些块必须留在 live，以便第二张起即合组显示。
 * @returns 起点；无则 -1
 */
function startOfTrailingToolCluster(text: string): number {
  const ranges = collectToolBlockRanges(text);
  if (ranges.length == 0) {
    return -1;
  }
  // 文末若有非空白非工具内容，则工具不在「文末簇」
  let lastContent = text.length - 1;
  while (lastContent >= 0 && isWhitespaceChar(text.charAt(lastContent)) == true) {
    lastContent--;
  }
  if (lastContent < 0) {
    return ranges[0].start;
  }
  // lastContent 必须落在最后一个工具块内，才算文末工具簇
  const lastRange = ranges[ranges.length - 1];
  if (lastContent < lastRange.start || lastContent >= lastRange.end) {
    return -1;
  }

  // 从末块向前合并：块间仅空白
  let clusterStart = lastRange.start;
  for (let i = ranges.length - 2; i >= 0; i--) {
    const prev = ranges[i];
    const between = text.substring(prev.end, clusterStart);
    if (between.trim().length > 0) {
      break;
    }
    clusterStart = prev.start;
  }
  return clusterStart;
}

/**
 * 流式「可冻结」切点（exclusive end index）。
 * @param markdown 已经过 stripIncomplete 的可渲染正文
 * @param streaming true=流式（末段段落留 live）；false=终态（可冻到文末）
 */
export function findStableMarkdownCut(
  markdown: string,
  streaming: boolean = true,
): number {
  if (markdown.length == 0) {
    return 0;
  }
  if (streaming != true) {
    return markdown.length;
  }

  // 不完整结构起点（取最早者）
  let incompleteAt = -1;
  const fenceAt = findUnclosedCodeFenceStart(markdown);
  const mathAt = findUnclosedBlockFormulaStart(markdown);
  const tableAt = findTrailingOpenTableStart(markdown);
  const customAt = findIncompleteCustomMarkupTailStart(markdown);
  incompleteAt = earlierNonNeg(incompleteAt, fenceAt);
  incompleteAt = earlierNonNeg(incompleteAt, mathAt);
  incompleteAt = earlierNonNeg(incompleteAt, tableAt);
  incompleteAt = earlierNonNeg(incompleteAt, customAt);

  // 结构完整时：段落边界 + 已 FINISHED 工具卡均可冻；末段纯文本仍留 live
  const structureLimit = incompleteAt >= 0 ? incompleteAt : markdown.length;
  // 纯散文单段（无跨行块结构、无空行）：按单个 \n 推进切点，避免 O(n²) 全量重解析
  const region = markdown.substring(0, structureLimit);
  const paraCut = isSafeProseText(region) == true
    ? lastSoftLineBoundaryBefore(markdown, structureLimit)
    : lastParagraphBoundaryBefore(markdown, structureLimit);
  const toolCut = endOfFinishedCustomBlocks(markdown, structureLimit);
  let cut = maxInt(paraCut, toolCut);

  // 文末相连工具簇留在 live：避免第一张冻住后第二张拆开显示
  const trailingTools = startOfTrailingToolCluster(markdown);
  if (trailingTools >= 0 && cut > trailingTools) {
    const beforeTools = lastParagraphBoundaryBefore(markdown, trailingTools);
    cut = beforeTools <= trailingTools ? beforeTools : trailingTools;
    if (cut > trailingTools) {
      cut = trailingTools;
    }
  }
  return cut;
}
