<template>
  <uni-modal-popup ref="popupRef" position="bottom" height="56%" :show-header="false" :body-scroll="false" @update-visible="handleVisibleChange">
    <view class="sheet" :class="{ 'sheet--avoid-tab-bar': avoidTabBar }">
      <view class="sheet-handle" />
      <view class="sheet-header">
        <text class="sheet-title">{{ t("Mobile.CreateHub.spaceSelect") }}</text>
        <view class="close-button" @click="close">
          <view class="close-line close-line--left" />
          <view class="close-line close-line--right" />
        </view>
      </view>

      <scroll-view class="space-list" direction="vertical" :show-scrollbar="false">
        <view
          v-for="space in spaces"
          :key="space.id"
          class="space-row"
          :class="{ 'space-row--active': space.id == selectedId }"
          @click="handleSelect(space)"
        >
          <image
            v-if="space.icon.length > 0"
            class="space-icon"
            :src="space.icon"
            mode="aspectFit"
          />
          <view v-else class="space-icon space-icon--fallback">
            <text class="space-icon-text">{{ space.name.length > 0 ? space.name.substring(0, 1) : "?" }}</text>
          </view>
          <view class="space-main">
            <text class="space-name">{{ space.name }}</text>
            <text v-if="space.description.length > 0" class="space-desc">{{ space.description }}</text>
          </view>
          <text v-if="space.id == selectedId" class="space-check">✓</text>
        </view>
        <view v-if="spaces.length == 0" class="empty-box">
          <text class="empty-text">{{ t("Mobile.CreateHub.noSpace") }}</text>
        </view>
      </scroll-view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, watch, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { SpaceOptionInfo } from "@/types/interfaces/spaceOption";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const props = withDefaults(defineProps<{
    visible: boolean;
    spaces: SpaceOptionInfo[];
    selectedId: number;
    avoidTabBar?: boolean;
  }>(), {
    visible: false,
    spaces: () => [] as SpaceOptionInfo[],
    selectedId: 0,
    avoidTabBar: false,
  });
  const emit = defineEmits<{ (e: "close"): void; (e: "select", spaceId: number): void; }>();

  const popupRef = ref<any | null>(null);

  function callPopup(method: string): void {
    if (popupRef.value != null) (popupRef.value as ComponentPublicInstance).$callMethod(method);
  }

  function close(): void {
    callPopup("close");
  }

  function handleVisibleChange(value: boolean): void {
    if (value != true) emit("close");
  }

  function handleSelect(space: SpaceOptionInfo): void {
    emit("select", space.id);
    close();
  }

  watch(
    (): boolean => props.visible,
    (value: boolean): void => {
      if (value) callPopup("open");
      else callPopup("close");
    },
  );
</script>

<style lang="scss" scoped>
  .sheet { display: flex; flex-direction: column; height: 100%; padding: 18rpx 32rpx 0; background-color: #ffffff; box-sizing: border-box; }
  /* #ifdef APP-ANDROID || APP-HARMONY */
  .sheet--avoid-tab-bar { padding-bottom: 100rpx; }
  /* #endif */
  /* #ifdef APP-IOS */
  /* iOS 窗口高度不含 tabBar（2026-09-19 真机实测），弹层无需避让，多留只会出现底部空白 */
  .sheet--avoid-tab-bar { padding-bottom: env(safe-area-inset-bottom); }
  /* #endif */
  /* #ifdef H5 */
  .sheet--avoid-tab-bar { padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
  /* #endif */
  .sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 20rpx; border-radius: 999rpx; background-color: #dedee8; }
  .sheet-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
  .sheet-title { color: #17171c; font-size: 34rpx; line-height: 48rpx; font-weight: 700; }
  .close-button { position: relative; width: 52rpx; height: 52rpx; }
  .close-line { position: absolute; left: 10rpx; top: 25rpx; width: 32rpx; height: 4rpx; border-radius: 999rpx; background-color: #8b8b96; }
  .close-line--left { transform: rotate(45deg); }
  .close-line--right { transform: rotate(-45deg); }

  .space-list { flex: 1; min-height: 0; }
  .space-row { display: flex; flex-direction: row; align-items: center; min-height: 108rpx; padding: 20rpx 24rpx; border-radius: 20rpx; }
  .space-row--active { background-color: #f3f1ff; }
  .space-icon { width: 64rpx; height: 64rpx; border-radius: 16rpx; flex-shrink: 0; }
  .space-icon--fallback { display: flex; align-items: center; justify-content: center; background-color: #f0eff8; }
  .space-icon-text { color: #5147ff; font-size: 28rpx; font-weight: 700; }
  .space-main { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
  .space-name { color: #292930; font-size: 29rpx; lines: 1; }
  .space-row--active .space-name { color: #5147ff; font-weight: 600; }
  .space-desc { margin-top: 4rpx; color: #9999a3; font-size: 23rpx; lines: 1; }
  .space-check { color: #5147ff; font-size: 30rpx; font-weight: 700; margin-left: 16rpx; }
  .empty-box { display: flex; align-items: center; justify-content: center; min-height: 200rpx; }
  .empty-text { color: #aaaab3; font-size: 26rpx; }
</style>
