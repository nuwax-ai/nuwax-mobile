import { extOf, urlExtOf } from "@/utils/imChatAttachments";

// 纸面底图（类型字母不进 SVG，由调用方 uvue <text> 叠加，字形随平台字体渲染恒清晰）
import sheetIcon from "@/static/file-icons/icon-file-sheet.svg";
import sheetUnknownIcon from "@/static/file-icons/icon-file-sheet-unknown.svg";

/**
 * IM 文件附件卡片展示口径（微信式：类型图标 + 大小 + 下载状态）。
 *
 * 图标 = 纸面 SVG（static/file-icons，仅几何形状）+ 调用方叠加的彩色类型字
 * （PDF 红 / DOC 蓝 / XLS 绿 / PPT 橙 / ZIP 琥珀 / TXT 灰蓝）；不常用后缀一律
 * 灰蓝纸面 + 白色问号（微信未知文件样式）。
 *
 * 消费方：pages/message/quote-detail.uvue、subpackages/pages/im-file-detail；
 * 聊天气泡接入时复用本模块 + components/file-type-icon。
 */

/** 文件名后缀 → 类型键（空串 = 未知类型）。 */
function fileTypeKeyOf(ext: string): string {
  if (ext == "pdf") {
    return "pdf";
  }
  if (ext == "doc" || ext == "docx") {
    return "doc";
  }
  if (ext == "xls" || ext == "xlsx" || ext == "csv") {
    return "xls";
  }
  if (ext == "ppt" || ext == "pptx") {
    return "ppt";
  }
  if (ext == "zip" || ext == "rar" || ext == "7z" || ext == "tar" || ext == "gz" || ext == "bz2" || ext == "xz") {
    return "zip";
  }
  if (ext == "txt" || ext == "log" || ext == "md") {
    return "txt";
  }
  return "";
}

/** 解析附件的有效后缀：文件名优先，URL 兜底（均小写）。 */
function attExtOf(fileName: string, url: string): string {
  const nameExt = extOf(fileName);
  if (nameExt.length > 0) {
    return nameExt;
  }
  return urlExtOf(url);
}

/** 文件卡片判定：文件名或 URL 带扩展名（图片附件由调用方先行分流，不再判图）。 */
export function isFileCardAtt(fileName: string, url: string): boolean {
  return attExtOf(fileName, url).length > 0;
}

/** 是否未知类型（不常用后缀 / 认不出的后缀 → 问号纸面）。 */
export function isUnknownFileType(fileName: string, url: string): boolean {
  return fileTypeKeyOf(attExtOf(fileName, url)).length == 0;
}

/** 类型标签字：PDF / DOC / XLS / PPT / ZIP / TXT；未知为 "?"。 */
export function fileTypeLabelOf(fileName: string, url: string): string {
  const key = fileTypeKeyOf(attExtOf(fileName, url));
  if (key.length == 0) {
    return "?";
  }
  return key.toUpperCase();
}

/** 类型标签配色（叠在白纸上）；未知类型白色（叠在灰蓝纸上）。 */
export function fileTypeColorOf(fileName: string, url: string): string {
  const key = fileTypeKeyOf(attExtOf(fileName, url));
  if (key == "pdf") {
    return "#FA5151";
  }
  if (key == "doc") {
    return "#1485EE";
  }
  if (key == "xls") {
    return "#07C160";
  }
  if (key == "ppt") {
    return "#FA9D3B";
  }
  if (key == "zip") {
    return "#F7B500";
  }
  if (key == "txt") {
    return "#8A94A6";
  }
  return "#FFFFFF";
}

/** 纸面底图地址：H5 必须 bundler import（部署在 /m/ 子路径，运行时拼 /static 字串会 404）。 */
export function fileSheetSrc(unknown: boolean): string {
  if (unknown) {
    // #ifdef H5 || WEB
    return sheetUnknownIcon;
    // #endif
    // #ifndef H5 || WEB
    return "/static/file-icons/icon-file-sheet-unknown.svg";
    // #endif
  }
  // #ifdef H5 || WEB
  return sheetIcon;
  // #endif
  // #ifndef H5 || WEB
  return "/static/file-icons/icon-file-sheet.svg";
  // #endif
}

/** 文件大小展示：B / KB / MB / GB（一位小数，<1KB 直接给字节数；≤0 返回空串）。 */
export function formatFileSize(size: number): string {
  if (size <= 0) {
    return "";
  }
  if (size < 1024) {
    return `${size} B`;
  }
  const kb = size / 1024;
  if (kb < 1024) {
    return `${kb.toFixed(1)} KB`;
  }
  const mb = kb / 1024;
  if (mb < 1024) {
    return `${mb.toFixed(1)} MB`;
  }
  const gb = mb / 1024;
  return `${gb.toFixed(1)} GB`;
}
