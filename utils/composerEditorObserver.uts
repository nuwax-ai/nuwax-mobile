/** Web 与原生 editor 的事件适配。业务规则由 composerQuickTrigger 统一处理。 */
export function observeWebComposer(q: any, report: (state: UTSJSONObject) => void): () => void {
  // #ifdef H5 || WEB
  let composing = false;
  let pasted = false;
  let pending = "";
  let timer: number | null = null;
  const schedule = (reason: string): void => {
    if (reason != "selection" || pending == "") pending = reason;
    if (timer != null) clearTimeout(timer!);
    timer = setTimeout((): void => {
      timer = null;
      const range = q.getSelection();
      const delta = q.getContents();
      let text = delta.ops.map((op: any): string => typeof op.insert == "string" ? op.insert : "\ufffc").join("");
      if (text.endsWith("\n")) text = text.substring(0, text.length - 1);
      report({ text: text, cursor: range != null ? range.index : -1, length: range != null ? range.length : 0, composing: composing, reason: pending });
      pending = "";
      pasted = false;
    }, 0);
  };
  const onText = (_delta: any, _old: any, source: string): void => schedule(pasted ? "paste" : (source == "user" ? "edit" : "programmatic"));
  const onSelection = (): void => schedule("selection");
  const onPaste = (): void => { pasted = true; schedule("paste"); };
  const onBeforeInput = (event: any): void => { if (event.inputType == "insertFromPaste" || event.inputType == "insertFromDrop") onPaste(); };
  const onStart = (): void => { composing = true; schedule("composition"); };
  const onEnd = (): void => { composing = false; schedule("edit"); };
  const onKey = (event: any): void => { if (event.key == "Escape") schedule("dismiss"); };
  q.on("text-change", onText);
  q.on("selection-change", onSelection);
  q.root.addEventListener("paste", onPaste, true);
  q.root.addEventListener("drop", onPaste, true);
  q.root.addEventListener("beforeinput", onBeforeInput, true);
  q.root.addEventListener("compositionstart", onStart);
  q.root.addEventListener("compositionend", onEnd);
  q.root.addEventListener("keydown", onKey);
  return (): void => {
    if (timer != null) clearTimeout(timer!);
    q.off("text-change", onText);
    q.off("selection-change", onSelection);
    q.root.removeEventListener("paste", onPaste, true);
    q.root.removeEventListener("drop", onPaste, true);
    q.root.removeEventListener("beforeinput", onBeforeInput, true);
    q.root.removeEventListener("compositionstart", onStart);
    q.root.removeEventListener("compositionend", onEnd);
    q.root.removeEventListener("keydown", onKey);
  };
  // #endif
  // #ifndef H5 || WEB
  return (): void => {};
  // #endif
}

/** 原生 editor 已支持 input 的 delta 透传；只附加观测信息，不改内容和 SDK。 */
export function buildComposerEditorObserverScript(watchIOSViewport: boolean = false): string {
  return `(function(){
    var root=document.querySelector('.ql-container');
    var q=root&&(root.__quill||(window.Quill&&window.Quill.find(root)));
    if(!q||q.__nuwaxObserver)return;q.__nuwaxObserver=true;
    var composing=false,pasted=false,pending='',timer=null,watchViewport=${watchIOSViewport ? "true" : "false"};
    function schedule(reason){
      if(reason!=='selection'||!pending)pending=reason;
      if(timer!==null)clearTimeout(timer);
      timer=setTimeout(function(){
        timer=null;var range=q.getSelection(),delta=q.getContents();
        var text=delta.ops.map(function(op){return typeof op.insert==='string'?op.insert:'\uFFFC';}).join('');
        if(text.slice(-1)==='\\n')text=text.slice(0,-1);
        delta.__nuwaxComposer={text:text,cursor:range?range.index:-1,length:range?range.length:0,composing:composing,reason:pending,viewportCollapsed:window.innerWidth===0||window.innerHeight===0};
        if(typeof triggerEvent==='function')triggerEvent('input',{text:q.getText(),html:q.root.innerHTML,delta:delta});
        pending='';pasted=false;
      },0);
    }
    function paste(){pasted=true;schedule('paste');}
    function checkViewport(){
      if(watchViewport&&!composing&&(window.innerWidth===0||window.innerHeight===0))schedule('viewport-check');
    }
    q.on('text-change',function(d,o,source){schedule(pasted?'paste':(source==='user'?'edit':'programmatic'));});
    q.on('selection-change',function(){schedule('selection');});
    q.root.addEventListener('paste',paste,true);q.root.addEventListener('drop',paste,true);
    q.root.addEventListener('beforeinput',function(e){if(e.inputType==='insertFromPaste'||e.inputType==='insertFromDrop')paste();},true);
    q.root.addEventListener('compositionstart',function(){composing=true;schedule('composition');});
    q.root.addEventListener('compositionend',function(){
      composing=false;schedule('edit');
      if(watchViewport){setTimeout(checkViewport,80);setTimeout(checkViewport,320);}
    });
    if(watchViewport)window.addEventListener('resize',function(){setTimeout(checkViewport,0);});
    q.root.addEventListener('keydown',function(e){if(e.key==='Escape')schedule('dismiss');});
  })();`;
}
