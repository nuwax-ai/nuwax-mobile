/**
 * Nuwax Vox 设备语音网关 - App 会议接口类型
 * 接口文档: GET /api/app/meetings 等
 */

/** 会议列表查询参数（keyword 匹配短标题/摘要；timeRange=ALL|TODAY|THIS_WEEK|THIS_MONTH） */
export class AppMeetingListParams {
  keyword: string = "";
  timeRange: string = "ALL";
  // 页码，从 1 开始
  page: number = 1;
  pageSize: number = 20;
}

/** 会议列表项 */
export interface IAppMeetingView {
  id: number;
  deviceId: string;
  status: string;
  summaryStatus: string;
  // 短标题（LLM）；未生成时为空
  title: string;
  // 一两句话摘要（LLM）；未生成时为空
  briefSummary: string;
  // 参与人数（按说话人去重）；无法判断时为空
  participantCount?: number | null;
  // 文件 ASR 状态：PENDING / SUCCESS / FAILED
  fileAsrStatus?: string | null;
  // 录音原始 URL（无 ak；有值表示有录音；播放请调 audio-url 接口）
  audioFileUrl?: string | null;
  startedAt: string;
  endedAt: string;
}

/** 会议分页视图（网关自定义分页，与主站 Page<T> 结构不同） */
export interface IAppMeetingPageView {
  items: IAppMeetingView[];
  total: number;
  page: number;
  pageSize: number;
}

/** 会议转写分段 */
export interface IAppMeetingSegmentView {
  seq: number;
  text: string;
  startedAt: string;
  endedAt: string;
  // 说话人标识，文件 ASR 成功后填充；流式分段时为空
  speaker?: string | null;
  // 片段起始毫秒（相对会议开始）
  startMs?: number | null;
  endMs?: number | null;
}

/** 会议详情 */
export interface IAppMeetingDetailView {
  id: number;
  deviceId: string;
  status: string;
  title: string;
  briefSummary: string;
  participantCount?: number | null;
  // 完整会议纪要（Markdown）
  summary: string;
  summaryStatus: string;
  startedAt: string;
  endedAt: string;
  // 文件 ASR 全量带 speaker 转写；为空表示文件 ASR 未成功
  transcript: string;
  audioFileUrl?: string | null;
  audioBytes?: number | null;
  audioDurationMs?: number | null;
  fileAsrStatus?: string | null;
  segments: IAppMeetingSegmentView[];
}

/** 录音临时播放地址（有效期约 24h，勿持久化） */
export interface IAppMeetingAudioUrlView {
  meetingId: number;
  url: string;
  expiresInSeconds: number;
}
