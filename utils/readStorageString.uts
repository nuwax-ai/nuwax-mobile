/**
 * 同步读取本地存储字符串。
 * iOS 上键不存在时 getStorageSync 抛「返回值为 undefined」，不能用 ?? 接。
 * @param key 存储键
 * @returns 存储中的字符串；缺失、空值或读取失败时返回空串
 */
export function readStorageString(key: string): string {
  try {
    const raw = uni.getStorageSync(key);
    if (raw == null) {
      return "";
    }
    const text = `${raw}`;
    if (text.length == 0 || text == "undefined" || text == "null") {
      return "";
    }
    return text;
  } catch (_e) {
    return "";
  }
}
