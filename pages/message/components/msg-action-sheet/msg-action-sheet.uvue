<template>
  <!--
    消息长按操作弹窗（chat.uvue 专用）：
    - 动作列表由页面侧 buildActionsFor 按消息状态/角色算好传入（显隐规则不进组件）
    - 点行只上抛 select(key) 并收起，业务处理全在页面；closed 供页面清"选中消息"高亮
    - 行图标走 PNG（iconfont 无 Pin/撤回/引用字形，且 H5 端 svg-icon 缺字形渲染为空）
    - 底部避让 home 条（sheetStyle，同 add-buddy-sheet）；宿主是非 tabBar 页，无需 hideTabBar
    - 表情回复条（quick-emojis 非空时渲染在动作列表上方）：一排快选 emoji + 展开键；
      展开后显示全量表情网格（all-emojis，scroll-view）；点 emoji 上抛 select("react:"+emoji)
      并收起（面板内不做已选激活态，toggle 语义在页面侧）
  -->
  <uni-modal-popup
    ref="popupRef"
    position="bottom"
    :height="sheetHeight"
    :show-header="false"
    :body-scroll="false"
    :enable-swipe-close="true"
    @afterleave="handleAfterLeave"
  >
    <view class="ma-sheet" :style="sheetStyle">
      <!-- 表情快选条：长按消息直接一排 emoji 回复（飞书同款位置）。
           「更多」键（灰圆三黑点）固定在滚动区右侧、热区贴行尾无 margin；展开后隐藏，
           同时下方动作列表也卸载——面板只保留表情区（收面板即复位） -->
      <view v-if="quickEmojis.length > 0" class="ma-emojis">
        <view class="ma-emojis__bar">
          <scroll-view direction="horizontal" :show-scrollbar="false" class="ma-emojis__scroll">
            <view class="ma-emojis__row">
              <view
                v-for="emo in quickEmojis"
                :key="emo"
                class="ma-emoji"
                hover-class="ma-emoji--hover"
                @click="handleEmojiSelect(emo)"
                @touchstart="handleSheetTouchStart($event)"
                @touchend="handleSheetTouchEnd('react:' + emo, $event)"
                @touchcancel="handleSheetTouchCancel('react:' + emo, $event)"
              >
                <text class="ma-emoji__face">{{ emo }}</text>
              </view>
            </view>
          </scroll-view>
          <view
            v-if="expanded != true"
            class="ma-more"
            hover-class="ma-more--active"
            @click="toggleExpand"
            @touchstart="handleSheetTouchStart($event)"
            @touchend="handleMoreTouchEnd($event)"
            @touchcancel="handleMoreTouchCancel($event)"
          >
            <view class="ma-more__circle">
              <view class="ma-more__dot" />
              <view class="ma-more__dot" />
              <view class="ma-more__dot" />
            </view>
          </view>
        </view>
        <view v-if="expanded" class="ma-emoji-grid-wrap">
          <scroll-view direction="vertical" :show-scrollbar="false" class="ma-emoji-grid">
            <view class="ma-emoji-grid__inner">
              <view
                v-for="emo in allEmojis"
                :key="emo"
                class="ma-emoji"
                hover-class="ma-emoji--hover"
                @click="handleEmojiSelect(emo)"
                @touchstart="handleSheetTouchStart($event)"
                @touchend="handleSheetTouchEnd('react:' + emo, $event)"
                @touchcancel="handleSheetTouchCancel('react:' + emo, $event)"
              >
                <text class="ma-emoji__face">{{ emo }}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
      <!-- 分割线：rest 列底部放一个常规流内的固定高度 view（从 icon 右缘延伸到行尾，
           不穿图标区）。不用绝对定位拉伸/嵌套 border（两者都在 iOS 部分行丢失），
           流式 view 是三端最不易丢的画线方式。
           图标：复制/编辑/转发/多选/删除有 iconfont 矢量字形（任意密度清晰）；
           回复/置顶/撤回/下载视频走 PNG。
           表情网格展开时动作列表整体卸载 -->
      <view v-if="expanded != true" class="ma-actions">
        <view
          v-for="a in actions"
          :key="a.key"
          class="ma-row"
          hover-class="ma-row--active"
          @click="handleSelect(a.key)"
          @touchstart="handleSheetTouchStart($event)"
          @touchend="handleSheetTouchEnd(a.key, $event)"
          @touchcancel="handleSheetTouchCancel(a.key, $event)"
        >
          <view class="ma-row__icon-wrap">
            <svg-icon v-if="a.key == 'copy'" name="icon-CopyOutlined" size="44" color="#292832" />
            <svg-icon v-else-if="a.key == 'edit'" name="icon-Edit" size="44" color="#292832" />
            <svg-icon v-else-if="a.key == 'forward'" name="icon-Share" size="44" color="#292832" />
            <svg-icon v-else-if="a.key == 'multi'" name="icon-CheckSquareOutlined" size="44" color="#292832" />
            <svg-icon v-else-if="a.key == 'delete'" name="icon-a-trashcan" size="44" color="#292832" />
            <!-- 无 icon 字段的动作留空占位，不能渲染空 src 的 image（破图） -->
            <image v-else-if="a.icon.length > 0" class="ma-row__icon" :src="a.icon" mode="aspectFit" />
          </view>
          <view class="ma-row__rest">
            <view class="ma-row__rest-main">
              <text class="ma-row__label" :class="a.danger ? 'ma-row__label--danger' : ''">{{ a.label }}</text>
            </view>
            <view class="ma-row__line" />
          </view>
        </view>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { computed, ref, type ComponentPublicInstance } from "vue";
  import { MsgActionItem } from "@/types/interfaces/msgActionItem";

  const props = withDefaults(
    defineProps<{
      /** 操作列表（页面按消息状态/角色算好；空列表时 open 前页面已拦，不弹）。 */
      actions?: MsgActionItem[] | null;
      /** 表情快选条（空数组=不渲染；点项上抛 select("react:"+emoji)）。 */
      quickEmojis?: string[] | null;
      /** 全量表情（展开网格用；quickEmojis 为空时本项无意义）。 */
      allEmojis?: string[] | null;
    }>(),
    {
      actions: () => [] as MsgActionItem[],
      quickEmojis: () => [] as string[],
      allEmojis: () => [] as string[],
    },
  );

  const emit = defineEmits<{
    (e: "select", key: string): void;
    (e: "closed"): void;
  }>();

  const popupRef = ref<any | null>(null);
  /** 表情网格展开态（组件内部：展开/收起不经过页面，高度随之联动）。 */
  const expanded = ref<boolean>(false);

  // ===== 点选触摸判定态（三星 One UI 修复，2026-10-08）=====
  // 三星机型在 page-container 原生弹层内对子视图的 click 合成偶发不产生：长按消息
  // 弹出本面板后，回复/转发等按钮点了没反应（其余验证的 Android/iOS 均正常）。
  // 行/表情/「更多」键改为 touchend 自行判点按（位移 ≤12px 即派发）为主通道，
  // @click 保留为 H5 桌面无触摸兜底；两通道经 handleSelect/toggleExpand 内 500ms
  // 防重（同 key）保证只生效一次。
  let sheetTouchStartX = 0;
  let sheetTouchStartY = 0;
  let lastSelectKey = "";
  let lastSelectAtMs = 0;
  let lastToggleAtMs = 0;
  const SELECT_DEDUPE_MS = 500;

  /** 记点按起点（行/表情/更多键 touchstart 共用；横向 emoji 条滚动起点的位移超阈值不派发）。
   *  部分安卓运行时（鸿蒙系手机装 Android 版）touchstart 的 touches 为空、坐标只在
   *  changedTouches：起点取不到会残留上一轮旧坐标，isSheetTap 位移必超阈值，touchend
   *  主通道整轮哑火——起点两侧互补读取。 */
  function handleSheetTouchStart(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    if (e.touches.length > 0) {
      sheetTouchStartX = e.touches[0].clientX;
      sheetTouchStartY = e.touches[0].clientY;
      return;
    }
    if (e.changedTouches != null && e.changedTouches.length > 0) {
      sheetTouchStartX = e.changedTouches[0].clientX;
      sheetTouchStartY = e.changedTouches[0].clientY;
    }
  }

  /** 抬手落点位移 ≤12px 判点按（emoji 条横滚、面板下滑关闭手势都超阈值，不会误派发）。
   *  落点同样 changedTouches 优先、touches 兜底（与起点互补，防单侧为空的运行时）。 */
  function isSheetTap(eventValue: Any): boolean {
    const e = eventValue as UniTouchEvent;
    if (e.changedTouches != null && e.changedTouches.length > 0) {
      const dx = e.changedTouches[0].clientX - sheetTouchStartX;
      const dy = e.changedTouches[0].clientY - sheetTouchStartY;
      return Math.abs(dx) <= 12 && Math.abs(dy) <= 12;
    }
    if (e.touches.length > 0) {
      const dx = e.touches[0].clientX - sheetTouchStartX;
      const dy = e.touches[0].clientY - sheetTouchStartY;
      return Math.abs(dx) <= 12 && Math.abs(dy) <= 12;
    }
    return false;
  }

  /** easycom 子组件须走 $callMethod（uni-modal-popup expose open/close，同 add-buddy-sheet）。 */
  function callPopupMethod(methodName: string): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(methodName);
  }

  function open(): void {
    expanded.value = false;
    // 新开面板清点选防重窗：上一轮收面板手势的 dedupe 态不再吞本轮首点
    lastSelectKey = "";
    lastSelectAtMs = 0;
    lastToggleAtMs = 0;
    callPopupMethod("open");
  }

  function close(): void {
    callPopupMethod("close");
  }

  /** 完全收起后通知页面清"选中消息"高亮（提前清会有背景突变的视觉残留）。 */
  function handleAfterLeave(): void {
    expanded.value = false;
    emit("closed");
  }

  /** 点选分发（行/表情共用）：emit 后收面板。双通道防重——touchend 先派发，系统随后
   *  合成的 click 再进这里时 500ms 内同 key 直接吞（三星合成 click 有时不产生，touchend
   *  是主通道；其余端两通道都发，靠此处去重保证只生效一次）。 */
  function handleSelect(key: string): void {
    if (key == lastSelectKey && Date.now() - lastSelectAtMs < SELECT_DEDUPE_MS) {
      return;
    }
    lastSelectKey = key;
    lastSelectAtMs = Date.now();
    emit("select", key);
    close();
  }

  /** 点 emoji：react: 前缀动作走 handleSelect 同一分发/防重路径（toggle 语义在页面侧判定）。 */
  function handleEmojiSelect(emoji: string): void {
    handleSelect("react:" + emoji);
  }

  /** touchend 派发（行/表情）：落点位移 ≤12px 判点按后走 handleSelect——绕开三星
   *  One UI 在 page-container 原生弹层内 click 合成偶发失败导致的「按钮点不动」。 */
  function handleSheetTouchEnd(key: string, eventValue: Any): void {
    if (isSheetTap(eventValue)) {
      handleSelect(key);
    }
  }

  function toggleExpand(): void {
    // 「更多」键同样双通道（touchend + click），500ms 防重
    if (Date.now() - lastToggleAtMs < SELECT_DEDUPE_MS) {
      return;
    }
    lastToggleAtMs = Date.now();
    expanded.value = !expanded.value;
  }

  /** 「更多」键 touchend 派发（判定语义同 handleSheetTouchEnd）。 */
  function handleMoreTouchEnd(eventValue: Any): void {
    if (isSheetTap(eventValue)) {
      toggleExpand();
    }
  }

  /** touchcancel 派发（行/表情）：原生弹层的下滑关闭手势、scroll-view 滚动抢占触摸时，
   *  抬手侧收到的是 cancel 而非 touchend（鸿蒙系 Android 尤其明显），且被手势认领后
   *  click 也不会再合成——不处理 cancel 点按就被整个吞掉（点表情面板无反应、不收起）。
   *  静点按（位移 ≤12px）同样派发；位移超阈值按滚动/下滑手势吞掉。先清起点防脏坐标
   *  毒化下一轮判定（防重仍由 handleSelect 的 500ms 窗口保证）。 */
  function handleSheetTouchCancel(key: string, eventValue: Any): void {
    const tap = isSheetTap(eventValue);
    sheetTouchStartX = 0;
    sheetTouchStartY = 0;
    if (tap) {
      handleSelect(key);
    }
  }

  /** 「更多」键 touchcancel（判定语义同 handleSheetTouchCancel）。 */
  function handleMoreTouchCancel(eventValue: Any): void {
    const tap = isSheetTap(eventValue);
    sheetTouchStartX = 0;
    sheetTouchStartY = 0;
    if (tap) {
      toggleExpand();
    }
  }

  /**
   * 底部安全距离（同 add-buddy-sheet）：App 端样式表 env(safe-area-inset-bottom)
   * 不可靠，内联 24rpx 基础 + 系统安全区（px）；H5/小程序走样式表 env()。
   */
  const sheetStyle = computed((): string => {
    let style = "";
    // #ifdef APP
    try {
      const win = uni.getWindowInfo();
      const scale = win.windowWidth / 750;
      const basePx = scale > 0 ? Math.round(24 * scale) : 24;
      style = `padding-bottom: ${basePx + win.safeAreaInsets.bottom}px;`;
    } catch (_e) {
      style = "";
    }
    // #endif
    return style;
  });

  /** 面板高度 = 顶栏圆角区 + （表情条 104rpx + 展开网格 512rpx）+ 收起态行数×行高 + 底部留白 + 安全区（rpx）。
   *  展开态动作列表与「更多」键都卸载，只算表情区。 */
  const sheetHeight = computed((): string => {
    const n = props.actions == null ? 0 : props.actions.length;
    let safeRpx = 0;
    try {
      const win = uni.getWindowInfo();
      const scale = win.windowWidth / 750;
      if (scale > 0) {
        safeRpx = Math.ceil(win.safeAreaInsets.bottom / scale);
      }
    } catch (_e) {
      safeRpx = 0;
    }
    let h = 32 + 24 + safeRpx;
    if (props.quickEmojis.length > 0) {
      h += 104;
      if (expanded.value) {
        h += 512;
      }
    }
    if (expanded.value != true) {
      h += n * 112;
    }
    return `${h}rpx`;
  });

  defineExpose({
    open: open as any,
    close: close as any,
  });
</script>

<style lang="scss" scoped>
  .ma-sheet {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    border-top-left-radius: 32rpx;
    border-top-right-radius: 32rpx;
    padding-top: 16rpx;
    /* #ifndef APP */
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    /* #endif */
  }

  /* ===== 表情快选条（动作列表上方；高 104rpx，横向滚动） ===== */
  .ma-emojis {
    display: flex;
    flex-direction: column;
  }

  /* 快选条本体：滚动区 + 固定「更多」键（更多键钉在右侧不随滚动） */
  .ma-emojis__bar {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .ma-emojis__scroll {
    flex: 1;
    min-width: 0;
  }

  .ma-emojis__row {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .ma-emoji {
    width: 88rpx;
    height: 88rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 4rpx;
    border-radius: 20rpx;
    /* 横向滚动容器内不被压缩（保证整排可滚出屏宽） */
    flex-shrink: 0;
  }

  .ma-emoji__face {
    font-size: 52rpx;
    line-height: 60rpx;
  }

  .ma-emoji--hover {
    background-color: #f0eff7;
  }

  /* 「更多」键：88rpx 热区内嵌 56rpx 灰圆 + 三颗 8rpx 黑点（纯 view 绘制，
     不依赖 iconfont 字形；无 margin，热区贴行尾、灰圆距右缘留 12rpx）。
     展开后整体卸载（无收起键） */
  .ma-more {
    width: 88rpx;
    height: 88rpx;
    border-radius: 44rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ma-more--active {
    background-color: #f0eff7;
  }

  .ma-more__circle {
    width: 64rpx;
    height: 64rpx;
    border-radius: 32rpx;
    background-color: #eceaf6;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* 左右对称 margin 保证点组整体居中 */
  .ma-more__dot {
    width: 10rpx;
    height: 10rpx;
    border-radius: 5rpx;
    background-color: #1c1b20;
    margin-left: 4rpx;
    margin-right: 4rpx;
  }

  /* 动作列表容器（表情网格展开时整体卸载） */
  .ma-actions {
    display: flex;
    flex-direction: column;
  }

  .ma-emoji-grid-wrap {
    width: 100%;
    height: 512rpx;
    border-top-width: 2rpx;
    border-top-style: solid;
    border-top-color: #f0eff7;
  }

  .ma-emoji-grid {
    width: 100%;
    height: 100%;
  }

  /* 内层网格：8 列（与输入坞表情面板同列数，750/8≈12.5% 自适应） */
  .ma-emoji-grid__inner {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 8rpx;
    padding-right: 8rpx;
    padding-top: 8rpx;
  }

  .ma-emoji-grid__inner .ma-emoji {
    width: 12.5%;
    margin-right: 0;
  }

  /* 行高 112rpx（对齐 iOS 标准动作行）。stretch 使 __rest 拉满行高：
     分割线钉在行底 = 按钮区域底边，hover 灰底恰好填满相邻两条线之间的区域 */
  .ma-row {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    height: 112rpx;
    padding-left: 32rpx;
    padding-right: 40rpx;
  }

  .ma-row__icon-wrap {
    width: 88rpx;
    height: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
  }

  /* 右侧内容列：垂直分「文字区 + 分割线」，线只在本列内（从 icon 右缘到行尾） */
  .ma-row__rest {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .ma-row__rest-main {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .ma-row__line {
    /* 与文案拉开呼吸间距（flex:1 的文字区吸收空间，线仍贴行底、行高不变） */
    margin-top: 12rpx;
    height: 2rpx;
    background-color: #f0eff7;
  }

  .ma-row--active {
    background-color: #f6f5fb;
  }

  /* icon 显示 44rpx（3x 屏 66 物理像素）：回复/置顶/下载视频为矢量线稿导出的 512px 高清 PNG
     （线重/颜色 #292832 对齐 svg 字形，大比例下采样渲染近矢量清晰度）；
     svg 矢量与 PNG 同尺寸保持视觉一致 */
  .ma-row__icon {
    width: 44rpx;
    height: 44rpx;
    flex-shrink: 0;
  }

  .ma-row__label {
    font-size: 30rpx;
    line-height: 42rpx;
    color: #1c1b20;
  }

  .ma-row__label--danger {
    color: #e05f5f;
  }
</style>
