    border-radius: 24rpx;
    margin: 0 24rpx;
    overflow: hidden;
  }

  /* 行项 */
  .row-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 28rpx 32rpx;
    border-bottom: 2rpx solid #f5f5f5;

    &:last-child {
      border-bottom-width: 0;
    }

    .row-icon {
      width: 56rpx;
      height: 56rpx;
      border-radius: 12rpx;
      margin-right: 24rpx;
    }

    .row-icon-box {
      width: 56rpx;
      height: 56rpx;
      margin-right: 24rpx;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .row-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;

      .row-title {
        font-size: 30rpx;
        font-weight: 500;
        color: #1a1a1a;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        lines: 1;
      }
    }

    .row-arrow {
      font-size: 40rpx;
