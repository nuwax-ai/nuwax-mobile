// #ifdef APP-ANDROID || APP-IOS
import { renderLatexAsync } from "@/uni_modules/nuwax-ratex"
import type { RatexRenderOptions } from "@/uni_modules/nuwax-ratex/utssdk/interface.uts"

/**
 * Phase2 数学渲染后端（ratex / Rust）：LaTeX → Rust parse+layout → DisplayList →
 * Canvas → Bitmap → WebP dataURL。不经 MathJax / 不经 SVG / 不经 webview，Rust 引擎无状态。
 *
 * 与另两个后端对照：
 *  - nativeSvg 后端 = QuickJS 跑 MathJax → SVG → AndroidSVG 位图（当前 APP 默认）
 *  - proxyWeb 后端 = 隐藏 web-view + KaTeX + 截图（H5/MP 主路径，APP 兜底）
 *  - ratex 后端   = Rust 原生布局 + Canvas 直绘（无 JS 引擎、无 SVG 解析、无 webview 冷启动）
 *
 * 线程模型：ratex 插件内部自带 Executors.newFixedThreadPool(4)（Rust 引擎无状态可安全并行），
 * 结果经 Handler(Looper.getMainLooper()) 切回主线程 → 这里直接调 callback（已在主线程），
 * Core.dispatchCallback 仍会再切一次主线程，无副作用。因 ratex 自带线程池，Core 对 ratex 路径
 * 放开并发闸（见 MathRendererCore.maxInFlight），吞吐由 ratex 内部 4 线程决定。
 *
 * 契约：回包 UTSJSONObject { imageDataURL, width, height }；失败回 { error }（ratex errMsg → error），
 *   由 MathRendererCore.renderViaBackend 兜底回 nativeSvgBackend / proxyWebBackend。
 *
 * 颜色 / 字号：固定近黑 #1A1A1A（与 nativeSvgBackend 同色，A/B 对照公平）；字号行内 16 / 块级 13
 * （ratex-view 同款默认）。暗色主题与字号随主题接入是后续 TODO（与 nativeSvgBackend 同步）。
 */
export function ratexBackend(
	latex: string,
	displayMode: boolean,
	callback: (res: UTSJSONObject) => void,
): void {
	console.log("[ratexBE] enter tex0=" + latex.substring(0, 16))
	// ratex-view 同款默认字号：行内 16 / 块级 13
	const fs: number = displayMode ? 13 : 16
	const opts: RatexRenderOptions = {
		displayMode: displayMode,
		fontSize: fs,
		// 近黑（非纯黑，视觉更柔和），与 nativeSvgBackend 同色保证 A/B 公平；暗色模式 TODO
		color: "#1A1A1A",
	}
	renderLatexAsync(latex, opts, (res): void => {
		const out = new UTSJSONObject()
		out["imageDataURL"] = res.imageDataURL
		out["width"] = res.width
		out["height"] = res.height
		// ratex 失败字段为 errMsg；Core 约定 error（命中即兜底回 native/proxy）
		if (res.errMsg.length > 0) {
			out["error"] = res.errMsg
		}
		console.log("[ratexBE] done err=" + (res.errMsg.length > 0 ? res.errMsg : "OK") + " imgLen=" + res.imageDataURL.length + " w=" + res.width + " h=" + res.height)
		callback(out)
	})
}
// #endif
