<template>
  <uni-modal-popup
    ref="popupRef"
    position="bottom"
    height="auto"
    :show-header="false"
    :body-scroll="false"
    :mask-click="true"
    :round="true"
    :close-on-slide-down="false"
    :z-index="1500"
  >
    <view class="sheet">
      <view class="sheet__head">
        <text class="sheet__head-title">{{ t("Mobile.Discover.todoCompleteTitle") }}</text>
        <view class="sheet__close" @click="close">
          <svg-icon name="icon-X" size="18" unit="px" color="#1f2329" />
        </view>
      </view>
      <text class="sheet__title">{{ title }}</text>
      <text v-if="assigneeLine.length > 0" class="sheet__line">{{ assigneeLine }}</text>
      <text class="sheet__ask">{{ t("Mobile.Discover.todoCompleteAsk") }}</text>
      <view class="sheet__label-row">
        <text class="sheet__label">{{ t("Mobile.Discover.todoCompleteAttach") }}</text>
        <text class="sheet__optional">{{ t("Mobile.Discover.todoCompleteOptional") }}</text>
      </view>
      <view class="sheet__files">
        <view v-for="(file, index) in files" :key="index" class="sheet__card" :class="tileEndClass(index)">
          <view class="sheet__card-remove" @click.stop="removeFile(index)">
            <svg-icon name="icon-X" size="10" unit="px" color="#ffffff" />
          </view>
          <svg-icon :name="file.icon" size="28" unit="px" color="#5b4dff" />
          <text class="sheet__card-name">{{ file.name }}</text>
        </view>
        <view class="sheet__add" :class="tileEndClass(files.length)" @click="pickFile">
          <svg-icon name="icon-Plus" size="22" unit="px" color="#8f959e" />
        </view>
      </view>
      <view class="sheet__label-row">
        <text class="sheet__label">{{ t("Mobile.Discover.todoCompleteRemark") }}</text>
        <text class="sheet__optional">{{ t("Mobile.Discover.todoCompleteOptional") }}</text>
      </view>
      <textarea
        class="sheet__input"
        v-model="remark"
        :maxlength="500"
        :placeholder="t('Mobile.Discover.todoCompleteRemarkPlaceholder')"
        placeholder-style="color: #c9cdd4; font-size: 14px;"
      />
      <view class="sheet__done" :class="submitting ? 'sheet__done--busy' : ''" hover-class="sheet__done--hover" @click="confirm">
        <text class="sheet__done-text">{{ t("Mobile.Discover.todoConfirmDone") }}</text>
      </view>
      <safety-zone />
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiErrorMessage, apiResCode } from "@/utils/apiResponse";
  import { apiCalendarForceComplete, apiCalendarParticipantComplete } from "@/servers/calendar/calendar.uts";
  import { CalendarIdReq, CalendarParticipantCompleteReq } from "@/types/interfaces/calendar";

  const emit = defineEmits<{
    done: [];
  }>();

  class TodoFile {
    name: string = "";
    path: string = "";
    icon: string = "";
  }

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const popupRef = ref<any | null>(null);
  const title = ref<string>("");
  const assigneeLine = ref<string>("");
  const remark = ref<string>("");
  const files = ref<TodoFile[]>([]);
  const submitting = ref<boolean>(false);
  let eventId = "";
  let creator = false;

  function callPopup(methodName: string): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(methodName);
  }

  function readText(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const text = `${raw}`.trim();
    if (text == "null" || text == "undefined") {
      return "";
    }
    return text;
  }

  function fileLabel(path: string): string {
    let name = path;
    const slash = path.lastIndexOf("/");
    if (slash >= 0 && slash < path.length - 1) {
      name = path.substring(slash + 1);
    }
    return name;
  }

  function lowerName(name: string): string {
    let next = "";
    for (let i = 0; i < name.length; i++) {
      const ch = name.charAt(i);
      const codeRaw = ch.charCodeAt(0);
      if (codeRaw != null) {
        const code = codeRaw as number;
        if (code >= 65 && code <= 90) {
          next += String.fromCharCode(code - 65 + 97);
          continue;
        }
      }
      next += ch;
    }
    return next;
  }

  function hasSuffix(name: string, suffix: string): boolean {
    if (name.length < suffix.length) {
      return false;
    }
    return name.substring(name.length - suffix.length) == suffix;
  }

  function iconFor(name: string): string {
    const lower = lowerName(name);
    if (
      hasSuffix(lower, ".jpg") ||
      hasSuffix(lower, ".jpeg") ||
      hasSuffix(lower, ".png") ||
      hasSuffix(lower, ".gif") ||
      hasSuffix(lower, ".webp") ||
      hasSuffix(lower, ".heic") ||
      hasSuffix(lower, ".bmp")
    ) {
      return "icon-Image";
    }
    if (hasSuffix(lower, ".xls") || hasSuffix(lower, ".xlsx") || hasSuffix(lower, ".csv")) {
      return "icon-List";
    }
    if (hasSuffix(lower, ".zip") || hasSuffix(lower, ".rar") || hasSuffix(lower, ".7z")) {
      return "icon-Folder";
    }
    return "icon-a-Filetext";
  }

  function tileEndClass(index: number): string {
    if (index % 3 == 2) {
      return "sheet__tile--end";
    }
    return "";
  }

  function clearFiles(): void {
    const empty: TodoFile[] = [];
    files.value = empty;
  }

  function open(payload: string): void {
    eventId = "";
    creator = false;
    title.value = "";
    assigneeLine.value = "";
    remark.value = "";
    clearFiles();
    submitting.value = false;
    try {
      const obj = JSON.parse(payload) as UTSJSONObject | null;
      if (obj != null) {
        eventId = readText(obj, "id");
        title.value = readText(obj, "title");
        assigneeLine.value = readText(obj, "line");
        creator = readText(obj, "creator") == "true";
      }
    } catch (_error) {
      eventId = "";
    }
    if (eventId.length == 0) {
      return;
    }
    callPopup("open");
  }

  function close(): void {
    callPopup("close");
  }

  function appendFile(name: string, path: string): void {
    const label = name.length > 0 ? name : fileLabel(path);
    if (label.length == 0) {
      return;
    }
    const current = files.value;
    for (let i = 0; i < current.length; i++) {
      if (current[i].path == path && path.length > 0) {
        return;
      }
    }
    const next: TodoFile[] = [];
    for (let i = 0; i < current.length; i++) {
      next.push(current[i]);
    }
    const file = new TodoFile();
    file.name = label;
    file.path = path;
    file.icon = iconFor(label);
    next.push(file);
    files.value = next;
  }

  function appendPicked(res: UTSJSONObject): void {
    const rawFiles = res["tempFiles"];
    if (rawFiles != null) {
      try {
        const text = JSON.stringify(rawFiles);
        if (text != null && text.length > 0 && text.charAt(0) == "[") {
          const list = JSON.parse(text) as UTSJSONObject[] | null;
          if (list != null) {
            for (let i = 0; i < list.length; i++) {
              const row = list[i];
              if (row == null) {
                continue;
              }
              appendFile(readText(row, "name"), readText(row, "path"));
            }
            return;
          }
        }
      } catch (_error) {}
    }
    const rawPaths = res["tempFilePaths"];
    if (rawPaths == null) {
      return;
    }
    try {
      const text = JSON.stringify(rawPaths);
      if (text == null || text.length == 0 || text.charAt(0) != "[") {
        return;
      }
      const paths = JSON.parse(text) as string[] | null;
      if (paths == null) {
        return;
      }
      for (let i = 0; i < paths.length; i++) {
        appendFile("", paths[i]);
      }
    } catch (_error) {}
  }

  function pickFile(): void {
    uni.chooseFile({
      count: 9,
      type: "all",
      success: (res: UTSJSONObject) => {
        appendPicked(res);
      },
    });
  }

  function removeFile(index: number): void {
    const current = files.value;
    const next: TodoFile[] = [];
    for (let i = 0; i < current.length; i++) {
      if (i != index) {
        next.push(current[i]);
      }
    }
    files.value = next;
  }

  async function confirm(): Promise<void> {
    if (submitting.value || eventId.length == 0) {
      return;
    }
    submitting.value = true;
    try {
      if (creator) {
        const query = new CalendarIdReq();
        query.id = eventId;
        const res = await apiCalendarForceComplete(query);
        if (apiResCode(res) == SUCCESS_CODE) {
          close();
          emit("done");
        }
      } else {
        const query = new CalendarParticipantCompleteReq();
        query.eventId = eventId;
        const res = await apiCalendarParticipantComplete(query);
        if (apiResCode(res) == SUCCESS_CODE) {
          close();
          emit("done");
        }
      }
    } catch (error) {
      const message = apiErrorMessage(error);
      if (message.length > 0) {
        uni.showToast({ title: message, icon: "none" });
      }
    }
    submitting.value = false;
  }

  defineExpose({
    open: open as any,
    close: close as any,
  });
</script>

<style scoped>
  .sheet {
    padding: 8px 16px 12px;
    background-color: #ffffff;
  }

  .sheet__head {
    height: 48px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .sheet__head-title {
    font-size: 17px;
    font-weight: 600;
    color: #1f2329;
    text-align: center;
  }

  .sheet__close {
    position: absolute;
    right: 0;
    top: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sheet__title {
    margin-top: 8px;
    font-size: 18px;
    line-height: 26px;
    font-weight: 600;
    color: #1f2329;
  }

  .sheet__line {
    margin-top: 6px;
    font-size: 14px;
    line-height: 20px;
    color: #86909c;
  }

  .sheet__ask {
    margin-top: 22px;
    font-size: 16px;
    line-height: 24px;
    color: #1f2329;
  }

  .sheet__label-row {
    margin-top: 22px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .sheet__label {
    font-size: 14px;
    color: #86909c;
  }

  .sheet__optional {
    margin-left: 8px;
    font-size: 14px;
    color: #c9cdd4;
  }

  .sheet__files {
    margin-top: 12px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .sheet__card,
  .sheet__add {
    width: 31%;
    height: 108px;
    margin-right: 3.5%;
    margin-bottom: 14px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .sheet__tile--end {
    margin-right: 0;
  }

  .sheet__card {
    background-color: #f4f5f7;
  }

  .sheet__card-remove {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: #8b909a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sheet__card-name {
    margin-top: 8px;
    padding: 0 8px;
    font-size: 12px;
    line-height: 16px;
    color: #4e5969;
    text-align: center;
  }

  .sheet__add {
    border-width: 1px;
    border-style: dashed;
    border-color: #d9dce3;
    background-color: #ffffff;
  }

  .sheet__input {
    width: 100%;
    height: 96px;
    margin-top: 12px;
    padding: 12px;
    border-radius: 12px;
    background-color: #f5f6f8;
    font-size: 14px;
    color: #1f2329;
  }

  .sheet__done {
    height: 48px;
    margin-top: 24px;
    border-radius: 12px;
    background-color: #1f2329;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sheet__done--hover {
    background-color: #3a3a3a;
  }

  .sheet__done--busy {
    opacity: 0.72;
  }

  .sheet__done-text {
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
  }
</style>
