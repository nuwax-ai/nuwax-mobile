import request from "@/servers/useRequest";
import { RequestResponse, VoidRequestResponse } from "@/types/interfaces/request";

function addQuery(parts: string[], key: string, value: string): void {
  if (value.length > 0) parts.push(`${encodeURIComponent(key)}=${encodeURIComponent(value)}`);
}

function withQuery(path: string, parts: string[]): string {
  return parts.length > 0 ? `${path}?${parts.join("&")}` : path;
}

/** 连接器提供方列表。 */
export async function apiConnectorProviderList(
  pageNum: number,
  pageSize: number,
  scope: string,
  connected: string,
  keyword: string,
  category: string,
  spaceId: number,
): Promise<RequestResponse<any>> {
  const parts = [] as string[];
  if (pageNum > 0) addQuery(parts, "pageNum", `${pageNum}`);
  if (pageSize > 0) addQuery(parts, "pageSize", `${pageSize}`);
  addQuery(parts, "scope", scope);
  addQuery(parts, "connected", connected);
  addQuery(parts, "keyword", keyword.trim());
  addQuery(parts, "category", category);
  if (spaceId > 0) addQuery(parts, "spaceId", `${spaceId}`);
  return await request({
    url: withQuery("/api/connector/providers", parts),
    method: "GET",
  });
}

/** 连接器详情；凭证字段与 OAuth 授权完成后的状态回查均使用该接口。 */
export async function apiConnectorProviderDetail(service: string, spaceId: number): Promise<RequestResponse<any>> {
  const parts = [] as string[];
  if (spaceId > 0) addQuery(parts, "spaceId", `${spaceId}`);
  addQuery(parts, "includeDisabled", "true");
  return await request({
    url: withQuery(`/api/connector/providers/${encodeURIComponent(service)}`, parts),
    method: "GET",
  });
}

/** 当前用户的连接列表；用于缺少 connectionId 时按 service 兜底寻址。 */
export async function apiConnectorConnectionList(spaceId: number): Promise<RequestResponse<any>> {
  const parts = [] as string[];
  if (spaceId > 0) addQuery(parts, "spaceId", `${spaceId}`);
  return await request({
    url: withQuery("/api/connector/connections", parts),
    method: "GET",
  });
}

/** 建立免鉴权或凭证型连接。 */
export async function apiConnectorConnectionCreate(data: UTSJSONObject): Promise<VoidRequestResponse> {
  return await request({
    url: "/api/connector/connections/api-key",
    method: "POST",
    data,
  });
}

/** 切换连接启用状态；关闭开关只停用，不断开。 */
export async function apiConnectorConnectionToggleStatus(connectionId: number, enabled: boolean): Promise<VoidRequestResponse> {
  return await request({
    url: `/api/connector/connections/${connectionId}/status?enabled=${enabled ? "true" : "false"}`,
    method: "POST",
  });
}

/** 断开用户连接；connectionId 是连接主键，不是连接器提供方 id。 */
export async function apiConnectorConnectionDelete(connectionId: number): Promise<VoidRequestResponse> {
  return await request({
    url: `/api/connector/connections/${connectionId}`,
    method: "DELETE",
  });
}

/** 发起普通 OAuth 授权。 */
export async function apiConnectorOauthAuthorize(service: string, spaceId: number): Promise<RequestResponse<any>> {
  const parts = [] as string[];
  addQuery(parts, "service", service);
  if (spaceId > 0) addQuery(parts, "spaceId", `${spaceId}`);
  return await request({
    url: withQuery("/api/connector/oauth/authorize", parts),
    method: "GET",
  });
}

/** 发起设备码授权。 */
export async function apiConnectorDeviceAuthorize(service: string, spaceId: number): Promise<RequestResponse<any>> {
  const parts = [] as string[];
  addQuery(parts, "service", service);
  if (spaceId > 0) addQuery(parts, "spaceId", `${spaceId}`);
  return await request({
    url: withQuery("/api/connector/oauth/device/authorize", parts),
    method: "GET",
  });
}

/** 轮询设备码授权结果。 */
export async function apiConnectorDevicePoll(state: string, interval: number): Promise<RequestResponse<any>> {
  const data = new UTSJSONObject();
  data["state"] = state;
  data["interval"] = interval;
  return await request({
    url: "/api/connector/oauth/device/poll",
    method: "POST",
    data,
  });
}
