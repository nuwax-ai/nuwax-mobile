/**
 * App web-view 内部历史后退。
 *
 * 不在业务侧另记路由。android.webkit.WebView、WKWebView、鸿蒙 WebviewController
 * 已经记录链接跳转和 history.pushState。这里只查询 canGoBack / accessBackward，
 * 有上一页则后退，没有则交给页面栈。
 *
 * ⚠️ iOS 暂未实现（返回 false，退回「点返回直接离开本页」的旧行为）：
 * iOS 要拿 WKWebView 只能 `uni.getElementById(id).getIOSView()`，而 getIOSView 和
 * `import { WKWebView } from "WebKit"` 都只在 utssdk 插件里可用；写在业务 .uts 里
 * 打包期直接报 `Could not resolve "WebKit"`，连带 Android 一起编不过。
 * 要恢复 iOS 的 canGoBack / goBack / allowsBackForwardNavigationGestures，须新建
 * `uni_modules/<plugin>/utssdk/app-ios`，并重打 iOS 自定义基座（参见
 * uni_modules/nuwax-ios-file-picker、nuwax-notification-clear 的写法）。
 */

// #ifdef APP-ANDROID
import WebView from "android.webkit.WebView";
import View from "android.view.View";
import ViewGroup from "android.view.ViewGroup";
// #endif

// #ifdef APP-HARMONY
import { webview } from "@kit.ArkWeb";
// #endif

// #ifdef APP-ANDROID
/** 从指定节点向下找第一个 WebView。DCloud 的实现类继承 android.webkit.WebView。 */
function findAndroidWebView(elementId: string): WebView | null {
  const el = uni.getElementById(elementId);
  if (el == null) {
    return null;
  }
  return findAndroidWebViewIn(el.getAndroidView());
}

function findAndroidWebViewIn(view: View | null): WebView | null {
  if (view == null) {
    return null;
  }
  if (view instanceof WebView) {
    return view as WebView;
  }
  if (view instanceof ViewGroup) {
    const group = view as ViewGroup;
    const count: Int = group.getChildCount();
    for (let i: Int = 0; i < count; i++) {
      const found = findAndroidWebViewIn(group.getChildAt(i));
      if (found != null) {
        return found;
      }
    }
  }
  return null;
}
// #endif

// #ifdef APP-HARMONY
function findHarmonyWebView(elementId: string): webview.WebviewController | null {
  const el = uni.getElementById(elementId);
  if (el == null) {
    return null;
  }
  try {
    return el.getHarmonyController() as webview.WebviewController | null;
  } catch (_e) {
    return null;
  }
}
// #endif

/**
 * 当前 web-view 是否还能退回网页上一页。
 * 原生视图还没挂上时返回 false，调用方应离开本页，避免把用户困在白屏。
 * @param elementId web-view 的 id
 */
export function appWebViewCanGoBack(elementId: string): boolean {
  // #ifdef APP-ANDROID
  try {
    const androidView = findAndroidWebView(elementId);
    return androidView != null && androidView.canGoBack();
  } catch (_eAndroid) {
    return false;
  }
  // #endif
  // #ifdef APP-IOS
  // 访问 WKWebView 须走 utssdk 插件（见文件头），暂按「网页没有可退页面」处理：
  // 返回键直接交给页面栈，与加此功能前一致。
  if (elementId.length < 0) {
    return false;
  }
  return false;
  // #endif
  // #ifdef APP-HARMONY
  try {
    const harmonyView = findHarmonyWebView(elementId);
    return harmonyView != null && harmonyView.accessBackward();
  } catch (_eHarmony) {
    return false;
  }
  // #endif
  // #ifndef APP
  return false;
  // #endif
}

/**
 * 网页还有上一页时后退，并返回 true。没有上一页或视图不可用时返回 false。
 * @param elementId web-view 的 id
 */
export function appWebViewGoBack(elementId: string): boolean {
  // #ifdef APP-ANDROID
  try {
    const androidView = findAndroidWebView(elementId);
    if (androidView != null && androidView.canGoBack()) {
      // WebView.goBack 必须在主线程。已在主线程时 runOnUiThread 会立即执行。
      const target = androidView;
      const activity = UTSAndroid.getUniActivity();
      if (activity != null) {
        activity.runOnUiThread((): void => {
          try {
            target.goBack();
          } catch (_eGo) {
            // 后退失败时页面栈已由 onBackPress 消费；下一轮查询 canGoBack 仍为 true，可再退
          }
        });
      } else {
        androidView.goBack();
      }
      return true;
    }
  } catch (_eAndroidBack) {
    return false;
  }
  return false;
  // #endif
  // #ifdef APP-IOS
  // 访问 WKWebView 须走 utssdk 插件（见文件头），永远不消费返回事件。
  if (elementId.length < 0) {
    return false;
  }
  return false;
  // #endif
  // #ifdef APP-HARMONY
  try {
    const harmonyView = findHarmonyWebView(elementId);
    if (harmonyView != null && harmonyView.accessBackward()) {
      harmonyView.backward();
      return true;
    }
  } catch (_eHarmonyBack) {
    return false;
  }
  return false;
  // #endif
  // #ifndef APP
  return false;
  // #endif
}

/**
 * 内嵌网页当前文档标题。视图未挂上、读失败或 iOS 暂不可读时返回空串。
 * Android 加载中 getTitle 可能是地址本身，调用方需自行过滤。
 * iOS 恒为空串（WKWebView 须走 utssdk 插件，见文件头）；
 * webview 页在 iOS 上改用 evalJS 读 document.title + @message 回传，见
 * subpackages/pages/webview/webview.uvue 的 requestWebViewDocumentTitle。
 * @param elementId web-view 的 id
 */
export function appWebViewPageTitle(elementId: string): string {
  // #ifdef APP-ANDROID
  try {
    const androidView = findAndroidWebView(elementId);
    if (androidView == null) {
      return "";
    }
    const raw = androidView.getTitle();
    return raw != null ? `${raw}`.trim() : "";
  } catch (_eTitle) {
    return "";
  }
  // #endif
  // #ifdef APP-IOS
  if (elementId.length < 0) {
    return "";
  }
  return "";
  // #endif
  // #ifdef APP-HARMONY
  try {
    const harmonyView = findHarmonyWebView(elementId);
    if (harmonyView == null) {
      return "";
    }
    const raw = harmonyView.getTitle();
    return raw != null ? `${raw}`.trim() : "";
  } catch (_eHarmonyTitle) {
    return "";
  }
  // #endif
  // #ifndef APP
  return "";
  // #endif
}

/**
 * 内嵌网页当前地址。视图未挂上或读失败时返回空串。
 * @param elementId web-view 的 id
 */
export function appWebViewPageUrl(elementId: string): string {
  // #ifdef APP-ANDROID
  try {
    const androidView = findAndroidWebView(elementId);
    if (androidView == null) {
      return "";
    }
    const raw = androidView.getUrl();
    return raw != null ? `${raw}`.trim() : "";
  } catch (_eUrl) {
    return "";
  }
  // #endif
  // #ifdef APP-IOS
  if (elementId.length < 0) {
    return "";
  }
  return "";
  // #endif
  // #ifdef APP-HARMONY
  try {
    const harmonyView = findHarmonyWebView(elementId);
    if (harmonyView == null) {
      return "";
    }
    const raw = harmonyView.getUrl();
    return raw != null ? `${raw}`.trim() : "";
  } catch (_eHarmonyUrl) {
    return "";
  }
  // #endif
  // #ifndef APP
  return "";
  // #endif
}

/**
 * 打开 iOS WebView 自带的边缘后退手势。其它端没有对应开关，空操作。
 * 重复调用只重复赋值，不叠加手势。
 *
 * 当前 iOS 侧为空实现：WKWebView 原生访问须走 utssdk 插件（见文件头），
 * 插件落地后把 `allowsBackForwardNavigationGestures = true` 接在这里即可，
 * 调用方（webview 页）不用改。
 * @param elementId web-view 的 id
 */
export function enableAppWebViewBackGesture(elementId: string): void {
  // 读一次参数，避免目标平台把未使用形参判为错误。
  if (elementId.length < 0) {
    return;
  }
}
