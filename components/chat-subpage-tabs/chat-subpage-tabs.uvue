<template>
  <view class="cst-bar">
    <view
      v-for="tab in tabs"
      :key="tab.id"
      class="cst-tab"
      :class="active == tab.id ? 'cst-tab--on' : ''"
      hover-class="cst-tab--hover"
      @click="handleTap(tab.id)"
    >
      <!-- #ifdef APP-HARMONY -->
      <!-- 初帧 <image> 不上屏（平台规则，chat.uvue harmonyImgOn 同款）：放行前不挂，
           避免页签 icon 出生在首帧窗内成死节点 -->
      <image v-if="iconOn" class="cst-tab__icon" :src="tab.icon" mode="aspectFit" />
      <!-- #endif -->
      <!-- #ifndef APP-HARMONY -->
      <image class="cst-tab__icon" :src="tab.icon" mode="aspectFit" />
      <!-- #endif -->
      <text
        class="cst-tab__text"
        :class="active == tab.id ? 'cst-tab__text--on' : ''"
      >{{ tab.label }}</text>
    </view>
    <!-- 行尾搜索键（文件按钮后面）：进「本会话内搜索」页，开关由调用方控制 -->
    <view
      v-if="showSearch"
      class="cst-search"
      hover-class="cst-search--hover"
      @click="handleSearchTap"
    >
      <svg-icon name="icon-Search" size="17" unit="px" color="#6b6878" />
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { ref, onMounted } from "vue";
  import { ChatSubpageTab } from "@/types/interfaces/chatSubpageTab";

  /**
   * 聊天详情页「子页签行」：对话标题下方一排 消息/Pin/资料库/文件 按钮（单聊与群聊复用）。
   *
   * - 标签集由调用方拼装传入（单聊四枚；群聊后续可加群公告等），本组件只管渲染与点击分发；
   * - ★选中态不改图标颜色（彩色实心 PNG 常驻），只改文字色 + 胶囊底色——
   *   对齐 PC nuwax-im-web DEV-187 的参考图语义，勿改用 currentColor 类单色图标；
   * - 「消息」由页面侧恒为选中（本组件无内部状态，active 受控）；
   *   Pin/资料库/文件/搜索 的开页/占位逻辑全部在页面侧处理（组件不感知路由）；
   * - 行尾可带一枚搜索键（showSearch 开关）：点击只向外发 search 事件。
   */
  const props = withDefaults(
    defineProps<{
      /** 标签集（顺序即渲染顺序）。 */
      tabs: ChatSubpageTab[];
      /** 当前选中标签 id（受控；「消息」页恒传 "messages"）。 */
      active?: string;
      /** 行尾是否渲染搜索键（「文件」后面的放大镜）。 */
      showSearch?: boolean;
    }>(),
    {
      tabs: () => [] as ChatSubpageTab[],
      active: "messages",
      showSearch: false,
    },
  );

  const emit = defineEmits<{
    (e: "select", id: string): void;
    (e: "search"): void;
  }>();

  // #ifdef APP-HARMONY
  /** ★鸿蒙：页面首帧渲染窗内创建的 <image> 节点永不上屏——页签 icon 随页面
   *  首帧创建必死（2026-10-27 真机实锤）。死窗实测越过 mounted+300ms
   *  （chat.uvue 同步页放行打点定界），放宽到 1200ms 再挂载绕开死窗。
   *  仅鸿蒙编译，其余端零改动。 */
  const iconOn = ref(false);
  onMounted(() => {
    setTimeout(() => {
      iconOn.value = true;
    }, 1200);
  });
  // #endif

  function handleTap(id: string): void {
    emit("select", id);
  }

  function handleSearchTap(): void {
    emit("search");
  }
</script>

<style lang="scss" scoped>
  /* ===== 子页签行：标题下方，左起横排胶囊 ===== */
  .cst-bar {
    flex-shrink: 0;
    padding: 6px 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-bottom: 1px solid #e5e6eb;
  }

  .cst-tab {
    padding: 4px 11px;
    margin-right: 6px;
    /* 圆角收敛：近全胶囊 → 8px 小圆角（用户要求「圆角小一点」） */
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .cst-tab--on {
    /* 选中胶囊淡蓝底（与「消息」气泡蓝同色系） */
    background-color: rgba(19, 86, 240, 0.1);
  }

  .cst-tab--hover {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .cst-tab__icon {
    width: 20px;
    height: 20px;
    margin-right: 4px;
    flex-shrink: 0;
  }

  .cst-tab__text {
    font-size: 13px;
    line-height: 18px;
    color: #6b6878;
  }

  .cst-tab__text--on {
    color: #1356f0;
    font-weight: 600;
  }

  /* 行尾搜索键：圆形热区，紧跟最后一个 tab（不顶到右缘） */
  .cst-search {
    width: 32px;
    height: 32px;
    margin-left: 2px;
    border-radius: 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cst-search--hover {
    background-color: rgba(81, 71, 255, 0.06);
  }

  /* #ifdef APP-HARMONY */
  /* 鸿蒙 HarmonyOS Sans 字形偏宽：四页签 + 搜索键在窄屏行内溢出，最右搜索键
     被裁（uni-app x 子项默认 flex-shrink:0 不收缩）。一档（9px 内距/4px 页距）
     实测仍溢出，二档收到 8px 内距 + 18px icon + 3px 页距；仅鸿蒙，其余端不动。 */
  .cst-bar {
    padding: 6px 8px;
  }

  .cst-tab {
    padding: 4px 8px;
    margin-right: 3px;
  }

  .cst-tab__icon {
    width: 18px;
    height: 18px;
    margin-right: 3px;
  }

  .cst-search {
    width: 30px;
    margin-left: 0;
  }
  /* #endif */
</style>
