<template>
  <view class="container relative flex flex-col border-b">
    <!-- 顶部导航栏 -->
    <custom-nav-bar :title="t('Mobile.Nav.mine')" className="border-b" hasSafetyZone />

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <!-- 用户卡 -->
      <view class="user-card" v-if="isLoggedIn">
        <image
          class="user-avatar"
          :src="currentAvatar"
          mode="aspectFill"
          :alt="t('Mobile.Common.avatarAlt')"
          @error="handleImageError"
        />
        <view class="user-info">
          <text class="user-name text-ellipsis">{{ displayName }}</text>
          <text class="user-desc text-ellipsis">{{ displayAccount }}</text>
        </view>
      </view>

      <!-- 未登录引导 -->
      <view class="user-card" v-else @click="handleLogin">
        <image class="user-avatar" :src="defaultAvatar" mode="aspectFill" :alt="t('Mobile.Common.avatarAlt')" />
        <view class="user-info">
          <text class="user-name">{{ t("Mobile.Common.loginRegister") }}</text>
          <text class="user-desc">{{ t("Mobile.Mine.loginTip") }}</text>
        </view>
      </view>

      <!-- 积分概览 -->
      <view class="stats-row" v-if="isLoggedIn">
        <CreditsBreakdown :summary="creditsSummary" @add-purchase="handleAddPurchase" />
      </view>

      <!-- 智联录分类铺开 -->
      <!-- #ifndef H5 || WEB -->
      <template v-if="isLoggedIn && categoryList.length > 0">
        <view class="section-title">{{ t("Mobile.Mine.unionRecord") }}</view>
        <view class="card-group">
          <view
            v-for="category in categoryList"
            :key="category.type"
            class="row-item"
            @click="handleCategoryClick(category.type)"
          >
            <image
              class="row-icon"
              :src="getCategoryIcon(category.categoryType)"
              mode="aspectFill"
              :alt="category.name"
            />
            <view class="row-info">
              <text class="row-title text-ellipsis">{{ category.name }}</text>
            </view>
            <text class="row-arrow">›</text>
          </view>
        </view>
      </template>
      <!-- #endif -->

      <!-- 应用入口 -->
      <view class="section-title">{{ t("Mobile.Mine.appEntrance") }}</view>
      <view class="card-group">
        <view class="row-item" @click="handleAppEntrance">
          <view class="row-icon-box">
            <svg-icon name="icon-Grid" size="40" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Nav.app") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
      </view>

      <!-- 其他设置 -->
      <view class="section-title">{{ t("Mobile.Mine.other") }}</view>
      <view class="card-group">
        <!-- 个人资料 -->
        <view class="row-item" @click="handlePersonalInfo">
          <view class="row-icon-box">
            <svg-icon name="icon-User" size="40" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Profile.title") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <!-- 系统消息 -->
        <view class="row-item" @click="handleSystemMessages">
          <view class="row-icon-box">
            <svg-icon name="icon-bell" size="40" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.SystemMessages.title") }}</text>
          </view>
          <view v-if="systemMessageUnreadCount > 0" class="row-badge">
            <text class="row-badge-text">{{ systemMessageUnreadCount > 99 ? "99+" : `${systemMessageUnreadCount}` }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <!-- 我的订阅（iOS 上架版隐藏：无应用内购买渠道，订阅页仅其他平台可见） -->
        <!-- #ifndef APP-IOS -->
        <view
          v-if="isSubscriptionEnabled"
          class="row-item"
          @click="handleMySubscriptions"
        >
          <view class="row-icon-box">
            <svg-icon name="icon-member" size="40" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Header.mySubscriptions") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <!-- #endif -->
        <!-- 我的订单（iOS 上架版隐藏：与备案备注「不含支付功能」口径一致，全端无购买/订单链路） -->
        <!-- #ifndef APP-IOS -->
        <view
          v-if="isSubscriptionEnabled"
          class="row-item"
          @click="handleMyOrders"
        >
          <view class="row-icon-box">
            <svg-icon name="icon-order" size="40" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Header.myOrders") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <!-- #endif -->
      </view>

      <!-- 退出登录 -->
      <view class="card-group logout-group" v-if="isLoggedIn">
        <view class="row-item logout-item" @click="handleLogout">
          <view class="row-icon-box">
            <svg-icon name="icon-Exit" size="40" />
          </view>
          <view class="row-info">
            <text class="row-title logout-text">{{ t("Mobile.Header.logout") }}</text>
          </view>
        </view>
      </view>

      <!-- 删除账号（应用内注销，iOS 审核 5.1.1(v) 必需；点击弹窗二次确认） -->
      <view class="card-group logout-group" v-if="isLoggedIn">
        <view class="row-item logout-item" @click="handleDeleteAccount">
          <view class="row-icon-box">
            <svg-icon name="icon-Exit" size="40" />
          </view>
          <view class="row-info">
            <text class="row-title logout-text">{{ t("Mobile.Header.deleteAccount") }}</text>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <PurchaseModal ref="purchaseModalRef" :on-payment-success="fetchCreditsSummary" />

    <!-- 登录弹窗（仅微信小程序） -->
    <!-- #ifdef MP-WEIXIN -->
    <auth-login-popup ref="loginPopupRef" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, type ComponentPublicInstance } from "vue";
  import { onLoad, onShow } from "@dcloudio/uni-app";
  import { SUCCESS_CODE, USER_NO_LOGIN, REDIRECT_LOGIN } from "@/constants/codes.constants";
  import { apiUserInfo, apiLogout, apiDeleteAccount } from "@/servers/account";
  import { apiHomeCategoryList } from "@/servers/agentDev";
  import { apiGetCreditSummary } from "@/subpackages/servers/subscription";
  import { UserInfo } from "@/types/interfaces/login";
  import { CategoryInfo, HomeAgentCategoryInfo } from "@/types/interfaces/agentConfig";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { resolveAppSvgUrl } from "@/utils/remoteSvgImage";
  import defaultAvatar from "@/static/assets/avatar.png";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import { clearStoragePreservingApiBaseUrl } from "@/constants/config";
  import { getCurrentPageFullPath } from "@/utils/common";
  import { goToLogin } from "@/utils/authNavigation";
  import { setCurrentPageNavigationBarTitle, checkSubscriptionEnable as checkSubscriptionEnableUtil } from "@/utils/system";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import { useI18n, emptyI18nParams, t as translateFn } from "@/utils/i18n";
  // #ifdef MP-WEIXIN
  import AuthLoginPopup from "@/components/auth-login-popup/auth-login-popup.uvue";
  // #endif
  import iconAgentCollect from "@/static/icons/agent_collect.svg";
  import iconTeamSpace from "@/static/icons/team_space.svg";
  import iconAgentRecommend from "@/static/icons/agent_recommend.svg";
  import iconPersonalSpace from "@/static/icons/personal_space.svg";
  import CreditsBreakdown from "@/components/credits-breakdown/credits-breakdown.uvue";
  import PurchaseModal from "@/subpackages/pages/my-subscriptions/components/purchase-modal/purchase-modal.uvue";
  import { refreshSystemMessageBadge, systemMessageUnreadCount } from "@/utils/notificationBadge";

  const { loadI18n } = useI18n();
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // 登录拦截
  const { loginPopupRef, hasToken } = useAuthInterceptor();

  // 登录态
  const isLoggedIn = ref<boolean>(false);
  // 用户信息
  const userInfo = ref<UserInfo | null>(null);
  // 当前头像
  const currentAvatar = ref<string>(defaultAvatar);
  // 是否开启订阅
  const isSubscriptionEnabled = ref<boolean>(false);

  // 智联录分类列表
  const categoryList = ref<CategoryInfo[]>([] as CategoryInfo[]);

  // 积分概览
  const creditsSummary = ref<UTSJSONObject | null>(null);
  const purchaseModalRef = ref<any | null>(null);

  // 用户名字段（uvue 模板不支持 ?.）
  const displayName = computed((): string => {
    const u = userInfo.value;
    if (u == null) return "";
    return u.nickName.length > 0 ? u.nickName : u.userName;
  });
  const displayAccount = computed((): string => {
    const u = userInfo.value;
    if (u == null) return "";
    return u.phone.length > 0 ? u.phone : u.email;
  });

  const handleImageError = () => {
    currentAvatar.value = defaultAvatar;
  };

  // 查询当前登录用户信息
  const fetchUserInfo = async () => {
    const res = await apiUserInfo();
    if (res != null && apiResCode(res) == SUCCESS_CODE) {
      const rawData = apiResData<any>(res);
      userInfo.value = rawData != null ? new UserInfo(rawData as UTSJSONObject) : null;
      if (userInfo.value != null) {
        // 头像可能是服务端返回的 svg 远程图，App 端需先转换为可正常渲染的 data URL
        const rawAvatar = userInfo.value.avatar.length > 0 ? userInfo.value.avatar : defaultAvatar;
        currentAvatar.value = await resolveAppSvgUrl(rawAvatar, 120, 120);
      } else {
        currentAvatar.value = defaultAvatar;
      }
    }
  };

  // 获取智联录分类（与首页官方推荐/智联录同接口 GET /api/home/list）
  const fetchHomeCategoryList = async () => {
    const response = await apiHomeCategoryList();
    const code = apiResCode(response);
    if (code == SUCCESS_CODE) {
      const dataRaw = apiResData<any>(response);
      if (dataRaw != null) {
        // 直接以 UTSJSONObject 操作，避免 Gson 反序列化 interface 崩溃
        const dataObj = dataRaw as UTSJSONObject;
        const categoriesRaw = dataObj["categories"];
          if (categoriesRaw != null) {
            const parsedCats = JSON.parse<CategoryInfo[]>(JSON.stringify(categoriesRaw));
            categoryList.value = parsedCats != null ? parsedCats : ([] as CategoryInfo[]);
          }
      }
    } else if (code != USER_NO_LOGIN && code != REDIRECT_LOGIN) {
      // 静默失败，不打扰用户
    }
  };

  // 根据 categoryType 获取对应图标
  // 注意：Android 端 UTS 的 === 编译为 Kotlin 引用相等，必须用 == 值比较
  const getCategoryIcon = (categoryType: string | null): string => {
    if (categoryType == "AGENT_COLLECT") return iconAgentCollect;
    if (categoryType == "TEAM_SPACE") return iconTeamSpace;
    if (categoryType == "AGENT_RECOMMEND") return iconAgentRecommend;
    return iconPersonalSpace;
  };

  // Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject 或直接点方法；用 $callMethod 调 defineExpose 方法
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // 点击智联录分类，跳分类下智能体列表
  const handleCategoryClick = (categoryKey: string) => {
    uni.navigateTo({
      url: `/subpackages/pages/category-agent-list/category-agent-list?categoryKey=${categoryKey}`,
    });
  };

  // 登录
  const handleLogin = () => {
    // #ifdef MP-WEIXIN
    callRefMethod(loginPopupRef.value, "open");
    // #endif

    // #ifdef H5 || WEB || APP
    goToLogin();
    // #endif
  };

  // 应用入口（page-app 保留为主包普通页，可 navigateTo）
  const handleAppEntrance = () => {
    if (isLoggedIn.value) {
      uni.navigateTo({ url: "/pages/page-app/page-app" });
    } else {
      handleLogin();
    }
  };

  // 个人信息
  const handlePersonalInfo = () => {
    if (isLoggedIn.value) {
      uni.navigateTo({ url: "/subpackages/pages/about-me/about-me" });
    } else {
      handleLogin();
    }
  };

  // 系统消息
  const handleSystemMessages = () => {
    if (isLoggedIn.value) {
      uni.navigateTo({ url: "/subpackages/pages/system-messages/system-messages" });
    } else {
      handleLogin();
    }
  };

  // 我的订阅
  const handleMySubscriptions = () => {
    if (isLoggedIn.value) {
      uni.navigateTo({ url: "/subpackages/pages/my-subscriptions/my-subscriptions" });
    } else {
      handleLogin();
    }
  };

  // 我的订单
  const handleMyOrders = () => {
    if (isLoggedIn.value) {
      uni.navigateTo({ url: "/subpackages/pages/my-orders/my-orders" });
    } else {
      handleLogin();
    }
  };

  // 增购积分在当前页面弹出套餐选择面板，支付后刷新积分概览。
  // iOS 上架版无应用内购买渠道（3.1.1）：CreditsBreakdown 的入口已隐藏，这里再挡一层防误触
  const handleAddPurchase = () => {
    // #ifndef APP-IOS
    callRefMethod(purchaseModalRef.value, "open");
    // #endif
  };

  const fetchCreditsSummary = async () => {
    try {
      const res = await apiGetCreditSummary();
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        creditsSummary.value = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      }
    } catch (e) {
      // 积分接口失败时保留默认展示，不影响“我的”页其余内容。
      creditsSummary.value = null;
    }
  };





  const checkSubscriptionEnable = async () => {
    isSubscriptionEnabled.value = await checkSubscriptionEnableUtil();
  };

  // 退出登录
  // 本地优先：服务端注销只是 best-effort。当前服务域名不可达（如企业域名失效、
  // 覆盖安装保留了旧的切换域名）时接口必然失败，若只在成功时清本地态，用户会被
  // 锁死在登录态里无法回到登录页切换域名，因此无论接口结果如何都清本地态并回登录页。
  const performLogout = async () => {
    try {
      await apiLogout();
    } catch (error) {
      console.error("服务端注销失败，继续本地退出:", error);
    }
    uni.setStorageSync(ACCESS_TOKEN, ""); // 清空token【兼容鸿蒙系统】
    clearStoragePreservingApiBaseUrl(); // 清空业务缓存并保留企业域名
    // #ifdef MP-WEIXIN
    if (globalThis.appConfig != null) {
      globalThis.appConfig.redirectUrl = "";
    }
    // #endif
    // 获取一次语言
    loadI18n(false);
    uni.showToast({
      title: t("Mobile.Header.logoutSuccess"),
      icon: "success",
    });
    setTimeout(() => {
      // #ifdef H5 || WEB
      uni.reLaunch({ url: "/subpackages/pages/login/login" });
      // #endif

      // #ifdef APP-ANDROID
      uni.reLaunch({ url: "/subpackages/pages/login/login" });
      // #endif

      // #ifdef APP-IOS
      uni.reLaunch({ url: "/subpackages/pages/login/login" });
      // #endif

      // #ifdef MP-WEIXIN
      uni.reLaunch({ url: "/subpackages/pages/login-weixin/login-weixin" });
      // #endif
    }, 1000);
  };

  const handleLogout = () => {
    uni.showModal({
      title: t("Mobile.Common.tip"),
      content: t("Mobile.Header.logoutConfirm"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm == true) {
          performLogout();
        }
      },
    });
  };

  // 删除账号（注销）
  // 与退出登录不同：注销以接口成功为准才清本地态，失败保留登录态仅提示；
  // 本地清理与跳登录页逻辑和 performLogout 保持一致（含 APP-IOS 分支）。
  const performDeleteAccount = async () => {
    try {
      const res = await apiDeleteAccount();
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.setStorageSync(ACCESS_TOKEN, ""); // 清空token【兼容鸿蒙系统】
        clearStoragePreservingApiBaseUrl(); // 清空业务缓存并保留企业域名
        loadI18n(false);
        uni.showToast({
          title: t("Mobile.Header.deleteAccountSuccess"),
          icon: "success",
        });
        setTimeout(() => {
          // #ifdef H5 || WEB
          uni.reLaunch({ url: "/subpackages/pages/login/login" });
          // #endif

          // #ifdef APP-ANDROID
          uni.reLaunch({ url: "/subpackages/pages/login/login" });
          // #endif

          // #ifdef APP-IOS
          uni.reLaunch({ url: "/subpackages/pages/login/login" });
          // #endif

          // #ifdef MP-WEIXIN
          uni.reLaunch({ url: "/subpackages/pages/login-weixin/login-weixin" });
          // #endif
        }, 1000);
      } else {
        uni.showToast({
          title: t("Mobile.Header.deleteAccountFailed"),
          icon: "none",
        });
      }
    } catch (error) {
      console.error("删除账号接口失败:", error);
      uni.showToast({
        title: t("Mobile.Header.deleteAccountFailed"),
        icon: "none",
      });
    }
  };

  // 删除账号入口：弹窗二次确认（删除不可恢复，需明确告知后果）
  const handleDeleteAccount = () => {
    uni.showModal({
      title: t("Mobile.Header.deleteAccount"),
      content: t("Mobile.Header.deleteAccountConfirm"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Header.deleteAccountConfirmBtn"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm == true) {
          performDeleteAccount();
        }
      },
    });
  };

  const performLoad = async () => {
    setCurrentPageNavigationBarTitle();
    checkSubscriptionEnable();
    const loggedIn = await hasToken();
    isLoggedIn.value = loggedIn;
    if (loggedIn) {
      fetchUserInfo();
      // #ifndef H5 || WEB
      fetchHomeCategoryList();
      // #endif
      fetchCreditsSummary();
      refreshSystemMessageBadge();
    } else {
      userInfo.value = null;
      currentAvatar.value = defaultAvatar;
      categoryList.value = [] as CategoryInfo[];
      creditsSummary.value = null;
      refreshSystemMessageBadge();
    }
  };

  onLoad((options: any) => {
    performLoad();
  });

  // tab 页每次显示时刷新登录态与数据
  onShow(() => {
    // 清除可能残留的 mask:true loading，避免跨 tab 吞点击（对齐 index.uvue）
    uni.hideLoading();
    performLoad();
  });
</script>

<style lang="scss" scoped>
  .container {
    height: 100%;
    background-color: #f7f7f7;
  }

  /* 用户卡 */
  .user-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 32rpx;
    background-color: #ffffff;
    margin: 24rpx 24rpx 0;
    border-radius: 24rpx;

    .user-avatar {
      width: 120rpx;
      height: 120rpx;
      border-radius: 50%;
      margin-right: 24rpx;
      background-color: #f5f5f5;
    }

    .user-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;

      .user-name {
        font-size: 36rpx;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 8rpx;
      }

      .user-desc {
        font-size: 26rpx;
        color: #999999;
      }
    }
  }

  /* 积分概览 */
  .stats-row {
    margin: 16rpx 24rpx 0;
  }

  /* 分组标题 */
  .section-title {
    font-size: 26rpx;
    font-weight: 600;
    color: #666666;
    padding: 28rpx 32rpx 12rpx;
  }

  /* 卡片组 */
  .card-group {
    background-color: #ffffff;
    border-radius: 24rpx;
    margin: 0 24rpx;
    overflow: hidden;
  }

  /* 行项 */
  .row-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 28rpx 32rpx;
    border-bottom: 2rpx solid #f5f5f5;

    &:last-child {
      border-bottom-width: 0;
    }

    .row-icon {
      width: 56rpx;
      height: 56rpx;
      border-radius: 12rpx;
      margin-right: 24rpx;
    }

    .row-icon-box {
      width: 56rpx;
      height: 56rpx;
      margin-right: 24rpx;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .row-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;

      .row-title {
        font-size: 30rpx;
        font-weight: 500;
        color: #1a1a1a;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        lines: 1;
      }
    }

    .row-arrow {
      font-size: 40rpx;
      color: #c0c0c0;
      font-weight: 300;
      line-height: 1;
      padding-left: 8rpx;
    }

    .row-badge {
      min-width: 36rpx;
      height: 36rpx;
      padding: 0 10rpx;
      border-radius: 100rpx;
      background-color: #ff4d4f;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      margin-right: 8rpx;

      .row-badge-text {
        font-size: 22rpx;
        font-weight: 600;
        color: #ffffff;
        line-height: 36rpx;
        text-align: center;
      }
    }
  }

  /* 退出登录 */
  .logout-group {
    margin-top: 24rpx;

    .logout-text {
      color: #fa5151;
    }
  }

  .bottom-space {
    height: 40rpx;
  }
</style>
