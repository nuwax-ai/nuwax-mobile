<template>
  <view class="formula-stream-root">
    <view
      v-for="(block, index) in frozenBlocks"
      :key="'formula-frozen-' + index"
      class="formula-stream-block"
    >
      <UniAiXMsgRender
        :markdown-el-list="block"
        :processing-list="processingList"
        :conversation-id="conversationId"
        :body-text="bodyText"
        :is-app-details="isAppDetails"
      />
    </view>
    <UniAiXMsgRender
      v-if="liveList.length > 0"
      :markdown-el-list="liveList"
      :processing-list="processingList"
      :conversation-id="conversationId"
      :body-text="bodyText"
      :is-app-details="isAppDetails"
    />
  </view>
</template>

<script lang="uts" setup>
import type { UniAiMarkdownElItem } from "@/uni_modules/uni-ai-x/types.uts";
import UniAiXMsgRender from "@/uni_modules/uni-ai-x/components/uni-ai-x-msg/uni-ai-x-msg.uvue";

const props = withDefaults(
  defineProps<{
    initialList: UniAiMarkdownElItem[];
    initialStableCount: number;
    processingList: any[];
    conversationId: string;
    bodyText: string;
    isAppDetails: boolean;
  }>(),
  {
    initialList: (): UniAiMarkdownElItem[] => [] as UniAiMarkdownElItem[],
    initialStableCount: 0,
    processingList: (): any[] => [] as any[],
    conversationId: "",
    bodyText: "",
    isAppDetails: false,
  },
);

const frozenBlocks = ref<UniAiMarkdownElItem[][]>([] as UniAiMarkdownElItem[][]);
const liveList = ref<UniAiMarkdownElItem[]>([] as UniAiMarkdownElItem[]);
let frozenCount = 0;
const FROZEN_BLOCK_ITEMS = 12;

/**
 * 已完成前缀只在稳定边界增长时追加一个不可变 renderer；普通 SSE tick 仅替换 live 尾部。
 * 该状态完全位于展示适配层，不回写 MsgItem / 权威正文。
 */
function updateRenderList(list: UniAiMarkdownElItem[], stableCount: number): void {
  let safeStable = stableCount;
  if (safeStable < 0) safeStable = 0;
  if (safeStable > list.length) safeStable = list.length;
  if (safeStable < frozenCount || list.length < frozenCount) {
    frozenBlocks.value = [] as UniAiMarkdownElItem[][];
    liveList.value = [] as UniAiMarkdownElItem[];
    frozenCount = 0;
  }
  // 小稳定段不立即各建一个 renderer：按固定元素数封块，剩余稳定尾巴留在 live renderer。
  // 这样 100 个元素约 8 个冻结 renderer，而不是几十个；live 仍被限制在 12 个以内 + 真尾部。
  const sealCount =
    safeStable - (safeStable % FROZEN_BLOCK_ITEMS);
  while (sealCount - frozenCount >= FROZEN_BLOCK_ITEMS) {
    const block = [] as UniAiMarkdownElItem[];
    const blockEnd = frozenCount + FROZEN_BLOCK_ITEMS;
    for (let i = frozenCount; i < blockEnd; i++) {
      block.push(list[i]);
    }
    if (block.length == FROZEN_BLOCK_ITEMS) {
      const nextBlocks = frozenBlocks.value.slice();
      nextBlocks.push(block);
      frozenBlocks.value = nextBlocks;
    }
    frozenCount = blockEnd;
  }
  const nextLive = [] as UniAiMarkdownElItem[];
  for (let i = frozenCount; i < list.length; i++) {
    nextLive.push(list[i]);
  }
  liveList.value = nextLive;
}

function resetWith(list: UniAiMarkdownElItem[], stableCount: number): void {
  frozenBlocks.value = [] as UniAiMarkdownElItem[][];
  liveList.value = [] as UniAiMarkdownElItem[];
  frozenCount = 0;
  updateRenderList(list, stableCount);
}

updateRenderList(props.initialList, props.initialStableCount);

defineExpose({
  updateRenderList,
  resetWith,
});
</script>

<style lang="scss">
.formula-stream-root,
.formula-stream-block {
  width: 100%;
  flex-direction: column;
}
</style>
