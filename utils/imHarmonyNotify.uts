// #ifdef APP-HARMONY
import { notificationManager } from "@kit.NotificationKit";
// UTSHarmony 为 uni-app x 环境全局（同 nuwax-harmony-native-pay 等插件，直接用不 import）
// #endif

/**
 * 鸿蒙后台新消息系统本地通知（自研直连系统 notificationManager）。
 *
 * 设计决策（2026-10-21，需求收敛为「先做鸿蒙本地通知」）：
 * - 不经 uni-push/个推：不走 uni.createPushMessage（那要求打包 uni-push 模块
 *   + 开通 unipush 2.0），直接调系统 API，零外部账号依赖；
 * - 调用方：utils/imNoticeBar.uts handleBackgroundNotification（静默口径/
 *   标题摘要组装全在那边，本模块只管「发」）；
 * - 通知授权：鸿蒙系统弹窗**每应用只弹一次**，拒绝后只能引导去设置手动开，
 *   因此必须在 onLaunch 前台时机申请（bindImHarmonyNotify，App.uvue 调）；
 * - 固定通知 id=1 单槽顶替：新消息顶掉上一条，对齐前台横幅的「单条」语义；
 * - 点击路由（v2 未做）：需 WantAgent 携带 convId 启动 Ability +
 *   UTSHarmony.onAppAbilityNewWant 接回跳，届时 publish 加 additionalData；
 *   当前点通知仅系统默认行为。
 * 鸿蒙真机排障：console.log/warn 不可见，探针一律 console.error（grep ImNotify）。
 */

// #ifdef APP-HARMONY
/** 授权申请只做一次（App 生命周期内；系统弹窗本来也只弹一次）。 */
let notifyPermissionRequested = false;

/**
 * 启动时申请通知授权（App.uvue onLaunch 调，#ifdef APP-HARMONY）：
 * 已授权则跳过；未授权弹系统窗（仅一次）；被拒后静默，由用户去设置手动开。
 */
export function bindImHarmonyNotify(): void {
  if (notifyPermissionRequested) {
    return;
  }
  notifyPermissionRequested = true;
  try {
    const context = UTSHarmony.getUIAbilityContext();
    notificationManager
      .isNotificationEnabled()
      .then((enabled: boolean): void => {
        if (enabled) {
          return;
        }
        notificationManager
          .requestEnableNotification(context)
          .catch((_e: any | null): void => {
            // 拒绝/弹窗已用尽：不阻塞启动，发通知时会再报 1600004 落日志
            console.error("[ImNotify][hm] notification disabled (user declined?)");
          });
      })
      .catch((_e: any | null): void => {
        console.error("[ImNotify][hm] isNotificationEnabled fail");
      });
  } catch (e) {
    console.error("[ImNotify][hm] bindImHarmonyNotify threw:", e);
  }
}

/**
 * 发一条系统本地通知（单槽顶替，id=1）。
 * convId/convType 为 v2 点击路由预留（当前未写入通知载荷）。
 */
export function publishImHarmonyNotify(
  title: string,
  content: string,
  _convId: string,
  _convType: number
): void {
  try {
    const request: notificationManager.NotificationRequest = {
      id: 1,
      // SOCIAL_COMMUNICATION = IM 类：声音+震动+锁屏可见（真机若报错降级 SERVICE_INFORMATION）
      notificationSlotType: notificationManager.SlotType.SOCIAL_COMMUNICATION,
      content: {
        contentType: notificationManager.ContentType.NOTIFICATION_CONTENT_BASIC_TEXT,
        normal: {
          title: title,
          text: content,
        },
      },
    };
    notificationManager
      .publish(request)
      .then((): void => {})
      .catch((e: any | null): void => {
        // 1600004 = 通知未授权（被拒后静默期的常规报错）
        console.error(`[ImNotify][hm] publish fail: ${JSON.stringify(e)}`);
      });
  } catch (e) {
    console.error("[ImNotify][hm] publish threw:", e);
  }
}
// #endif
