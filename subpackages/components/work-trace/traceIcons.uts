/**
 * V2 轨迹类型 → iconfont 类名映射（H5/MP-WEIXIN 分支使用）。
 * 图标取自项目 iconfont（static/iconfont），语义对齐 PC antd 图标：
 * terminal=CodeOutlined→branch（代码分支）、file-read=ReadOutlined→book、
 * todo=OrderedListOutlined→List；其余与 PC 同义（Edit/Search/Globe/skill/wrench）。
 */
export function traceKindIconClass(kind: string): string {
  if (kind == "terminal") return "icon-branch";
  if (kind == "file-read") return "icon-book";
  if (kind == "file-edit") return "icon-Edit";
  if (kind == "search") return "icon-Search";
  if (kind == "browser") return "icon-Globe";
  if (kind == "skill") return "icon-skill";
  if (kind == "todo") return "icon-List";
  return "icon-wrench";
}
