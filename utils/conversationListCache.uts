/**
 * 任务列表（抽屉「任务」区）跨实例内存缓存。
 *
 * 为什么必须放独立 .uts 模块：.uvue 的 <script setup> 顶层 let 编译到 Kotlin
 * 后是组件实例字段，实例销毁重建（下拉刷新 listKey 重建滚动容器、关抽屉重开）
 * 后即归零——写在组件文件里的「模块级缓存」在 Android 端从不真正跨实例，
 * 表现为重建出的空列表 + 容器计数停在旧值（09-21 复现：下拉刷新后任务区
 * 「暂无数据」不自恢复）。独立模块的全局 let 才是真模块作用域（同 appGlobalState）。
 */

let cachedConversationList: UTSJSONObject[] = [];
let cachedLastId: number | null = null;

export function getCachedConversationList(): UTSJSONObject[] {
  return cachedConversationList;
}

export function getCachedLastId(): number | null {
  return cachedLastId;
}

/** 回包即写（conversation-history-list 的 watch 是唯一出口，覆盖首拉/加载更多/静默合并/标记写侧） */
export function setCachedConversationList(list: UTSJSONObject[], lastId: number | null): void {
  cachedConversationList = list;
  cachedLastId = lastId;
}

/** 登出（或未登录）清缓存：避免下一个账号先看到上一个账号的任务 */
export function clearCachedConversationList(): void {
  cachedConversationList = [];
  cachedLastId = null;
}
