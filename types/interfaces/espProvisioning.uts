/** ESP-IDF 6.0 network_provisioning APP 侧领域类型。 */
import type {
  EspProvisioningErrorCodeEnum,
  EspProvisioningPhaseEnum,
  EspProvisioningSecurityEnum,
} from '@/types/enums/espProvisioning';

/** 固件协议配置。PoP/用户名不得持久化到普通 storage。 */
export class EspProvisioningConfig {
  serviceUuid: string;
  deviceNamePrefix: string;
  security: EspProvisioningSecurityEnum;
  username: string;
  proofOfPossession: string;
  scanTimeoutMs: number;
  connectTimeoutMs: number;
  statusTimeoutMs: number;

  constructor(
    serviceUuid: string,
    deviceNamePrefix: string,
    security: EspProvisioningSecurityEnum,
    username: string,
    proofOfPossession: string,
    scanTimeoutMs: number,
    connectTimeoutMs: number,
    statusTimeoutMs: number,
  ) {
    this.serviceUuid = serviceUuid;
    this.deviceNamePrefix = deviceNamePrefix;
    this.security = security;
    this.username = username;
    this.proofOfPossession = proofOfPossession;
    this.scanTimeoutMs = scanTimeoutMs;
    this.connectTimeoutMs = connectTimeoutMs;
    this.statusTimeoutMs = statusTimeoutMs;
  }
}
/** 扫描发现的官方 Provisioning 设备。 */
export class EspProvisioningDevice {
  deviceId: string;
  name: string;
  rssi: number;
  primaryServiceUuid: string;

  constructor(deviceId: string, name: string, rssi: number, primaryServiceUuid: string) {
    this.deviceId = deviceId;
    this.name = name;
    this.rssi = rssi;
    this.primaryServiceUuid = primaryServiceUuid;
  }
}

/** 设备端扫描到的 WiFi AP。 */
export class EspWifiNetwork {
  ssid: string;
  rssi: number;
  security: number;

  constructor(ssid: string, rssi: number, security: number) {
    this.ssid = ssid;
    this.rssi = rssi;
    this.security = security;
  }
}

/** `proto-ver` 的 APP 侧稳定视图。 */
export class EspProvisioningCapabilities {
  appVersion: string;
  protocolVersion: string;
  securityVersion: number;
  capabilities: string[];

  constructor(
    appVersion: string,
    protocolVersion: string,
    securityVersion: number,
    capabilities: string[],
  ) {
    this.appVersion = appVersion;
    this.protocolVersion = protocolVersion;
    this.securityVersion = securityVersion;
    this.capabilities = capabilities;
  }

  has(capability: string): boolean {
    return this.capabilities.indexOf(capability) >= 0;
  }
}

/** Security 2 后从 `device-info` custom endpoint 获取。 */
export class EspProvisioningDeviceInfo {
  protocolVersion: string;
  serialNumber: string;
  productModel: string;
  hardwareVersion: string;
  firmwareVersion: string;
  capabilities: string[];
  lastProvisioningOutcome: string;
  lastProvisioningReason: string;

  constructor(
    protocolVersion: string,
    serialNumber: string,
    productModel: string,
    hardwareVersion: string,
    firmwareVersion: string,
    capabilities: string[],
    lastProvisioningOutcome: string,
    lastProvisioningReason: string,
  ) {
    this.protocolVersion = protocolVersion;
    this.serialNumber = serialNumber;
    this.productModel = productModel;
    this.hardwareVersion = hardwareVersion;
    this.firmwareVersion = firmwareVersion;
    this.capabilities = capabilities;
    this.lastProvisioningOutcome = lastProvisioningOutcome;
    this.lastProvisioningReason = lastProvisioningReason;
  }
}

/** 配网过程事件，用于驱动现有进度 UI 和诊断日志。 */
export class EspProvisioningProgress {
  phase: EspProvisioningPhaseEnum;
  message: string;

  constructor(phase: EspProvisioningPhaseEnum, message: string = '') {
    this.phase = phase;
    this.message = message;
  }
}

/** 跨平台统一错误。 */
export class EspProvisioningError {
  code: EspProvisioningErrorCodeEnum;
  message: string;
  detail: string;
  nativeCode: number;
  retryable: boolean;

  constructor(
    code: EspProvisioningErrorCodeEnum,
    message: string,
    detail: string = '',
    nativeCode: number = 0,
    retryable: boolean = true,
  ) {
    this.code = code;
    this.message = message;
    this.detail = detail;
    this.nativeCode = nativeCode;
    this.retryable = retryable;
  }
}

/** 二维码解析后的安全引导信息。 */
export class EspProvisioningQrPayload {
  version: string;
  name: string;
  transport: string;
  network: string;
  security: EspProvisioningSecurityEnum;
  username: string;
  proofOfPossession: string;

  constructor(
    version: string,
    name: string,
    transport: string,
    network: string,
    security: EspProvisioningSecurityEnum,
    username: string,
    proofOfPossession: string,
  ) {
    this.version = version;
    this.name = name;
    this.transport = transport;
    this.network = network;
    this.security = security;
    this.username = username;
    this.proofOfPossession = proofOfPossession;
  }
}

/** 二维码解析结果，避免把异常或原始二维码内容直接写日志。 */
export class EspProvisioningQrParseResult {
  payload: EspProvisioningQrPayload | null;
  errorCode: string;

  constructor(payload: EspProvisioningQrPayload | null, errorCode: string = '') {
    this.payload = payload;
    this.errorCode = errorCode;
  }
}
