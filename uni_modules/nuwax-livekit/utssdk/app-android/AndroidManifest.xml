<?xml version="1.0" encoding="utf-8"?>
<!--
  nuwax-livekit · Android 权限声明（随插件合并进 APK Manifest）。

  ★现在只是"声明"，不会主动向用户弹窗：运行时申请必须由用户点「入会 / 开麦 / 开视频」
    触发（Android 14+ 对摄像头/麦克风前台服务有"使用中权限"限制，静默拉起会直接被拒）。
  ★最终以**合并后的 APK Manifest** 为验收对象：项目根目录 AndroidManifest.xml 里的
    权限是全局的，插件这里只带会议自身必需的那几条，避免污染其它业务。
  ★等 LiveKit Android SDK 接入时，若 SDK 自带前台服务/Extension 声明，优先使用 SDK 的，
    这里只补 SDK 没覆盖的部分（重复声明无害，但别声明用不到的权限）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- 语音会议：麦克风采集 -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- 视频会议：摄像头采集（默认不开，但开关一旦可点就必须有） -->
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- 会中挂前台服务：退后台不被系统冻结（Android 14+ 按用途细分 microphone/camera） -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <!-- Android 13+ 前台服务常驻通知需要通知权限（用户拒绝时降级为无通知，不阻断会议） -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
