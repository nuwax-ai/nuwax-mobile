<template>
  <view class="skill-tags-wrapper" v-if="selectedSkills.length > 0 || selectedDocs.length > 0">
    <view class="skill-tags-list">
      <view v-for="(skill, index) in selectedSkills" :key="skill.id" class="skill-chip">
        <agent-icon v-if="skill.icon.length > 0" :icon="skill.icon" :alt="skill.name" :size="28" :margin-right="6" />
        <text class="skill-chip-name">{{ skill.name }}</text>
        <view class="skill-chip-remove" @click="handleRemove(index)">
          <svg-icon name="icon-X" size="24" color="#8d8d97" />
        </view>
      </view>
      <view v-for="(doc, index) in selectedDocs" :key="`doc-${doc.slugId}`" class="skill-chip">
        <view class="skill-chip-doc-icon">
          <svg-icon name="icon-a-Filetext" size="28" color="#5f5f69" />
        </view>
        <text class="skill-chip-name">{{ doc.title }}</text>
        <view class="skill-chip-remove" @click="handleRemoveDoc(index)">
          <svg-icon name="icon-X" size="24" color="#8d8d97" />
        </view>
      </view>
      <view class="skill-chip-add" @click="handleAdd">
        <svg-icon name="icon-Plus" size="28" color="#5f5f69" />
      </view>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import AgentIcon from '@/components/agent-icon/agent-icon.uvue';
  import { SkillInfoForAt } from '@/types/interfaces/skill';
  import { SelectedDocInfo } from '@/types/interfaces/knowledgeList';

  withDefaults(defineProps<{
    selectedSkills: SkillInfoForAt[];
    selectedDocs?: SelectedDocInfo[];
  }>(), {
    selectedDocs: () => [] as SelectedDocInfo[],
  });

  const emit = defineEmits<{
    (e: 'onRemove', index: number): void;
    (e: 'onAdd'): void;
    (e: 'onRemoveDoc', index: number): void;
  }>();

  const handleRemove = (index: number) => {
    emit('onRemove', index);
  };

  const handleAdd = () => {
    emit('onAdd');
  };

  const handleRemoveDoc = (index: number) => {
    emit('onRemoveDoc', index);
  };
</script>

<style lang="scss" scoped>
  .skill-tags-wrapper {
    width: 100%;
    margin-top: 14rpx;
    padding: 0 18rpx;
    box-sizing: border-box;

    .skill-tags-list {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;

      /* 胶囊样式（同专家 pill / editor 内 mention chip）：999rpx 全圆角 + 52rpx 高 */
      .skill-chip {
        display: flex;
        flex-direction: row;
        align-items: center;
        height: 52rpx;
        min-width: 0;
        flex-shrink: 1;
        margin: 0 10rpx 10rpx 0;
        padding: 0 12rpx 0 8rpx;
        border-radius: 999rpx;
        background-color: #f2f1f6;
        box-sizing: border-box;
      }

      .skill-chip-doc-icon {
        display: flex;
        align-items: center;
        margin-right: 6rpx;
      }

      .skill-chip-name {
        max-width: 300rpx;
        color: #5f5f69;
        font-size: 22rpx;
        lines: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .skill-chip-remove {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 40rpx;
        height: 40rpx;
        margin-left: 4rpx;
      }

      .skill-chip-add {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52rpx;
        height: 52rpx;
        margin: 0 0 10rpx 0;
        border-radius: 999rpx;
        background-color: #f2f1f6;
      }
    }
  }
</style>
