<template>
  <!--
    会话历史列表（「任务」分组）：游标分页 + 静默头部合并 + 服务端标记
    （2026-09-13 后端化：pinned/archived/collected 列表回读打标，写侧接口切换）+
    长按五项操作。由 project-task-drawer 在其滚动容器内组装；
    滚动/下拉刷新由容器触发（loadMore / refresh），组件只负责列表本体，
    「任务」分组标题由容器渲染（吸顶需要标题在容器层，sticky-header 仅认容器直接子节点）。
    对齐 PC 侧栏行为：归档项直接隐藏，不设「已归档」查看入口。
  -->
  <view class="conversation-history-list">
    <view v-if="taskRows.length > 0">
      <view
        v-for="(row, index) in taskRows"
        :key="row.id"
        class="task-row"
        @click="handleTaskClick(index)"
        @longpress="handleTaskLongPress(index)"
      >
        <view class="task-title-row">
          <!-- 固定状态槽，优先级与 PC ConversationStatusMark 一致：执行中 > 失败 > 置顶 > 收藏。 -->
          <view v-if="row.hasLeadingState" class="task-leading-slot">
            <svg-icon v-if="row.taskStatus == 'EXECUTING'" name="icon-Loader" size="24" color="#8b8e96" customClass="task-status-running" />
            <svg-icon v-else-if="row.taskStatus == 'FAILED'" name="icon-waring" size="24" color="#e54d4d" customClass="task-status-failed" />
            <image v-else-if="row.pinned" :src="pinIcon" class="task-pin-image" mode="aspectFit" />
            <svg-icon v-else name="icon-Star-fill" size="22" color="#faad14" customClass="task-status-collected" />
          </view>
          <text class="task-title">{{ row.topic }}</text>
        </view>
      </view>
    </view>
    <view v-else-if="!taskLoading" class="empty-state">
      <image :src="noData" class="empty-image" :alt="t('Mobile.Common.noDataImageAlt')" />
      <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
    </view>
    <view v-if="taskShowNoMore" class="no-more-state">
      <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, watch } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants.uts";
  import {
    apiAgentConversationList,
    apiAgentConversationUpdate,
    apiAgentConversationDelete,
    apiAgentConversationPin,
    apiAgentConversationArchive,
    apiAgentConversationCollect,
    apiAgentConversationUnCollect,
  } from "@/servers/conversation";
  import { ConversationListParams } from "@/types/interfaces/conversationInfo";
  import { AgentConversationUpdateParams } from "@/types/interfaces/agent";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { migrateConversationFavorites } from "@/utils/favoritesMigration.uts";
  import noData from "@/static/assets/no_data.png";
  import pinIcon from "@/static/icons/pin.svg";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  interface ConversationHistoryListProps {
    isLoggedIn: boolean;
  }
  const props = defineProps<ConversationHistoryListProps>();

  const emit = defineEmits<{
    (e: "conversation-click", item: any): void;
    /** 可见行数变化（含分页/长按归档删除等组件内变更），容器据此刷新「任务 (N)」吸顶头计数 */
    (e: "count-change", count: number): void;
  }>();

  const TASK_PAGE_SIZE = 20;
  const SILENT_HEAD_SIZE = 10;

  class TaskRowView {
    id: number = 0;
    topic: string = "";
    /** 原始列表项引用：列表经置顶排序/归档过滤后 index 不再等于原始下标，交互一律走 row.item */
    item: UTSJSONObject | null = null;
    pinned: boolean = false;
    collected: boolean = false;
    taskStatus: string = "";
    hasLeadingState: boolean = false;
  }

  const conversationList = ref<UTSJSONObject[]>([]);
  const taskInitialLoading = ref<boolean>(false);
  const taskLoadingMore = ref<boolean>(false);
  const taskHasMore = ref<boolean>(false);
  const lastId = ref<number | null>(null);
  /** 服务端字段写侧更新后 bump，驱动列表重算 */
  const taskFlagsVersion = ref<number>(0);
  let conversationRequestPromise: Promise<boolean> | null = null;
  let favoritesMigrationTriggered = false;

  const taskLoading = computed((): boolean => {
    return taskInitialLoading.value || taskLoadingMore.value;
  });

  function toNum(v: any | null, fallback: number = 0): number {
    if (v == null) {
      return fallback;
    }
    const parsed = parseFloat(`${v}`);
    // parsed != parsed 判 NaN
    return parsed != parsed ? fallback : parsed;
  }
  function toStr(v: any | null, fallback: string = ""): string {
    if (v == null) {
      return fallback;
    }
    return `${v}`;
  }
  function toBool(v: any | null): boolean {
    return v == true;
  }

  function normalizeList(raw: any | null): UTSJSONObject[] {
    const result: UTSJSONObject[] = [];
    if (raw == null) {
      return result;
    }
    let items: any[] = [];
    if (Array.isArray(raw)) {
      items = raw as any[];
    } else {
      try {
        const jsonStr = JSON.stringify(raw);
        if (jsonStr != null && jsonStr.length > 0) {
          const parsed = JSON.parse(jsonStr);
          if (Array.isArray(parsed)) {
            items = parsed as any[];
          }
        }
      } catch (_e) {
        return result;
      }
    }
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      if (item == null) {
        continue;
      }
      try {
        const jsonStr = JSON.stringify(item);
        if (jsonStr != null && jsonStr.length > 0) {
          const obj = JSON.parse(jsonStr) as UTSJSONObject | null;
          if (obj != null) {
            const agentRaw = obj["agent"];
            let agentName = "";
            if (agentRaw != null) {
              try {
                const agentStr = JSON.stringify(agentRaw);
                if (agentStr != null && agentStr.length > 0) {
                  const agentObj = JSON.parse(agentStr) as UTSJSONObject | null;
                  if (agentObj != null) {
                    agentName = toStr(agentObj["name"], "");
                  }
                }
              } catch (_3) {
                agentName = "";
              }
            }
            obj["_agentName"] = agentName;
            result.push(obj);
          }
        }
      } catch (_e2) {
        // skip
      }
    }
    return result;
  }

  function updateConversationItem(target: UTSJSONObject, source: UTSJSONObject): void {
    const topic = source["topic"];
    if (topic != null) {
      target["topic"] = topic;
    }
    const modified = source["modified"];
    if (modified != null) {
      target["modified"] = modified;
    }
    const taskStatus = source["taskStatus"];
    if (taskStatus != null) {
      target["taskStatus"] = taskStatus;
    }
    const agentName = source["_agentName"];
    if (agentName != null) {
      target["_agentName"] = agentName;
    }
    const agentId = source["agentId"];
    if (agentId != null) {
      target["agentId"] = agentId;
    }
    // 标记字段随头部静默合并一起回读（后端 2026-09-13 起回包打标）
    const pinned = source["pinned"];
    if (pinned != null) {
      target["pinned"] = pinned;
    }
    const archived = source["archived"];
    if (archived != null) {
      target["archived"] = archived;
    }
    const collected = source["collected"];
    if (collected != null) {
      target["collected"] = collected;
    }
  }

  /** 将会话头部增量置顶去重，保留原列表尾部及其分页游标。 */
  function mergeConversationHead(incoming: UTSJSONObject[]): void {
    const current = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
    const merged: UTSJSONObject[] = [];

    for (let i = 0; i < incoming.length; i++) {
      const source = incoming[i];
      const sourceId = toNum(source["id"], 0);
      let target: UTSJSONObject | null = null;
      for (let j = 0; j < current.length; j++) {
        if (toNum(current[j]["id"], 0) == sourceId) {
          target = current[j];
          break;
        }
      }
      if (target != null) {
        updateConversationItem(target, source);
      } else {
        target = source;
      }
      let duplicated = false;
      for (let k = 0; k < merged.length; k++) {
        if (toNum(merged[k]["id"], 0) == sourceId) {
          duplicated = true;
          break;
        }
      }
      if (!duplicated) merged.push(target);
    }

    for (let i = 0; i < current.length; i++) {
      const candidate = current[i];
      const candidateId = toNum(candidate["id"], 0);
      let duplicated = false;
      for (let j = 0; j < merged.length; j++) {
        if (toNum(merged[j]["id"], 0) == candidateId) {
          duplicated = true;
          break;
        }
      }
      if (!duplicated) merged.push(candidate);
    }
    conversationList.value = merged;
  }

  /** 静默查询任务头部 10 条，保留已加载列表、末尾游标和分页状态。 */
  async function silentFetchTasks(): Promise<void> {
    if (!props.isLoggedIn || conversationList.value.length == 0 || conversationRequestPromise != null) return;
    try {
      const params = new ConversationListParams();
      params.agentId = null;
      params.lastId = null;
      params.limit = SILENT_HEAD_SIZE;
      // 与 PC「任务」分组一致：项目内会话只展示在项目子项，不在任务区重复。
      params.projectFilter = "exclude";
      const res = await apiAgentConversationList(params);
      if (apiResCode(res) == SUCCESS_CODE) {
        const newList = normalizeList(apiResData<any>(res));
        mergeConversationHead(newList);
      }
    } catch (error) {
      console.error("silentFetchTasks error:", error);
    }
  }

  async function fetchTasks(isLoadMore: boolean): Promise<boolean> {
    if (!props.isLoggedIn) {
      if (isLoadMore) {
        taskLoadingMore.value = false;
      } else {
        taskInitialLoading.value = false;
      }
      return false;
    }
    try {
      const params = new ConversationListParams();
      params.agentId = null;
      params.lastId = isLoadMore ? lastId.value : null;
      params.limit = TASK_PAGE_SIZE;
      params.projectFilter = "exclude";
      const res = await apiAgentConversationList(params);
      if (apiResCode(res) == SUCCESS_CODE) {
        const newList = normalizeList(apiResData<any>(res));
        if (isLoadMore) {
          const existing = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
          const combined: UTSJSONObject[] = [];
          for (let i = 0; i < existing.length; i++) {
            combined.push(existing[i]);
          }
          for (let j = 0; j < newList.length; j++) {
            const candidate = newList[j];
            const candidateId = toNum(candidate["id"], 0);
            let duplicated = false;
            for (let k = 0; k < combined.length; k++) {
              if (toNum(combined[k]["id"], 0) == candidateId) {
                duplicated = true;
                break;
              }
            }
            if (!duplicated) combined.push(candidate);
          }
          conversationList.value = combined;
        } else {
          conversationList.value = newList;
        }
        if (newList.length > 0) {
          const last = newList[newList.length - 1];
          lastId.value = toNum(last["id"], 0);
          // 接口可能返回不足一页但仍存在下一页，只有空页才能确认到底。
          taskHasMore.value = true;
        } else {
          taskHasMore.value = false;
        }
        // 首次加载成功后触发本地收藏一次性迁移（幂等，未完成前每次重试）
        if (favoritesMigrationTriggered != true) {
          favoritesMigrationTriggered = true;
          migrateConversationFavorites();
        }
        return true;
      }
      return false;
    } catch (error) {
      console.error("fetchTasks error:", error);
      return false;
    } finally {
      if (isLoadMore) {
        taskLoadingMore.value = false;
      } else {
        taskInitialLoading.value = false;
      }
    }
  }

  async function requestTasks(isLoadMore: boolean): Promise<boolean> {
    const pending = conversationRequestPromise;
    if (pending != null) {
      return await pending;
    }
    if (isLoadMore) {
      if (!taskHasMore.value) {
        return false;
      }
      taskLoadingMore.value = true;
    } else {
      taskInitialLoading.value = true;
    }
    const requestPromise = fetchTasks(isLoadMore);
    conversationRequestPromise = requestPromise;
    try {
      return await requestPromise;
    } finally {
      // 单飞入口保证同一时刻只有这一笔任务列表请求。
      conversationRequestPromise = null;
    }
  }

  /**
   * 列表投影（对齐 PC useHomeSectionData）：消费服务端 pinned 排前、
   * 隐藏归档项（侧栏不设归档查看入口）、collected 打标。
   */
  const taskRows = computed((): TaskRowView[] => {
    const _fv = taskFlagsVersion.value;
    const raw = conversationList.value;
    const result: TaskRowView[] = [];
    if (raw == null) {
      return result;
    }
    // 过滤归档 + 置顶排前（双数组拼接保持稳定，规避 UTS sort 稳定性）
    const visible: UTSJSONObject[] = [] as UTSJSONObject[];
    const pinned: UTSJSONObject[] = [] as UTSJSONObject[];
    for (let i = 0; i < raw.length; i++) {
      const item = raw[i];
      if (item == null || toBool(item["archived"])) {
        continue;
      }
      if (toBool(item["pinned"])) {
        pinned.push(item);
      } else {
        visible.push(item);
      }
    }
    const ordered: UTSJSONObject[] = pinned;
    for (let i = 0; i < visible.length; i++) {
      ordered.push(visible[i]);
    }
    const unnamed = t("Mobile.Conversation.unnamed");
    for (let i = 0; i < ordered.length; i++) {
      const item = ordered[i];
      if (item == null) {
        continue;
      }
      const row = new TaskRowView();
      row.id = toNum(item["id"], 0);
      const topic = toStr(item["topic"], "");
      row.topic = topic.length > 0 ? topic : unnamed;
      row.item = item;
      row.pinned = toBool(item["pinned"]);
      row.collected = toBool(item["collected"]);
      row.taskStatus = toStr(item["taskStatus"], "");
      row.hasLeadingState = row.taskStatus == "EXECUTING" || row.taskStatus == "FAILED" || row.pinned || row.collected;
      result.push(row);
    }
    return result;
  });

  const taskShowNoMore = computed((): boolean => {
    const cl = conversationList.value;
    const clLen = cl != null ? cl.length : 0;
    return !taskLoading.value && !taskHasMore.value && clLen > 8;
  });

  function getTaskItemByIndex(index: number): UTSJSONObject | null {
    const rows = taskRows.value;
    if (index < 0 || index >= rows.length) {
      return null;
    }
    return rows[index].item;
  }

  function handleTaskClick(index: number): void {
    const item = getTaskItemByIndex(index);
    if (item != null) {
      emit("conversation-click", item);
    }
  }

  // ============================================================
  // 长按五项操作（对齐 PC ConversationContextMenu 2026-09-13 服务端化）：
  // 置顶/归档（pin/archive query 必传 bool）、收藏（collect/unCollect 双路径），
  // 后端成功才更新本地字段并 bump 重算；失败 toast 不动状态。
  // ============================================================
  function applyTaskFlag(item: UTSJSONObject, field: string, value: boolean): void {
    item[field] = value;
    taskFlagsVersion.value = taskFlagsVersion.value + 1;
  }

  function performTaskPinToggle(item: UTSJSONObject, successTitleOn: string, successTitleOff: string): void {
    const next = toBool(item["pinned"]) != true;
    apiAgentConversationPin(toNum(item["id"], 0), next).then((res) => {
      if (apiResCode(res) == SUCCESS_CODE) {
        applyTaskFlag(item, "pinned", next);
        uni.showToast({ title: next ? successTitleOn : successTitleOff, icon: "none" });
      } else {
        uni.showToast({ title: apiResMessage(res).length > 0 ? apiResMessage(res) : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  function performTaskArchiveToggle(item: UTSJSONObject, successTitleOn: string, successTitleOff: string): void {
    const next = toBool(item["archived"]) != true;
    apiAgentConversationArchive(toNum(item["id"], 0), next).then((res) => {
      if (apiResCode(res) == SUCCESS_CODE) {
        applyTaskFlag(item, "archived", next);
        uni.showToast({ title: next ? successTitleOn : successTitleOff, icon: "none" });
      } else {
        uni.showToast({ title: apiResMessage(res).length > 0 ? apiResMessage(res) : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  /** 归档行内二次确认（对齐 PC 09-19/20 定调）：归档方向需确认，取消归档直接切换 */
  function confirmTaskArchiveToggle(item: UTSJSONObject, successTitleOn: string, successTitleOff: string): void {
    if (toBool(item["archived"]) != true) {
      uni.showModal({
        title: t("Mobile.Conversation.archive"),
        content: t("Mobile.Conversation.archiveConfirm"),
        cancelText: t("Mobile.Common.cancel"),
        confirmText: t("Mobile.Common.confirm"),
        success: (res) => {
          if (res.confirm) {
            performTaskArchiveToggle(item, successTitleOn, successTitleOff);
          }
        },
      });
      return;
    }
    performTaskArchiveToggle(item, successTitleOn, successTitleOff);
  }

  function performTaskCollectToggle(item: UTSJSONObject, successTitleOn: string, successTitleOff: string): void {
    const collected = toBool(item["collected"]);
    const request = collected
      ? apiAgentConversationUnCollect(toNum(item["id"], 0))
      : apiAgentConversationCollect(toNum(item["id"], 0));
    request.then((res) => {
      if (apiResCode(res) == SUCCESS_CODE) {
        applyTaskFlag(item, "collected", collected != true);
        uni.showToast({ title: collected != true ? successTitleOn : successTitleOff, icon: "none" });
      } else {
        uni.showToast({ title: apiResMessage(res).length > 0 ? apiResMessage(res) : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    }).catch((_e) => {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    });
  }

  async function performTaskRenameSubmit(item: UTSJSONObject, newName: string): Promise<void> {
    if (newName.length == 0) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleEmpty"), icon: "none" });
      return;
    }
    if (newName.length > 50) {
      uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameTitleTooLong"), icon: "none" });
      return;
    }
    try {
      const updateParams = new AgentConversationUpdateParams();
      updateParams.id = toNum(item["id"], 0);
      updateParams.topic = newName;
      const updateRes = await apiAgentConversationUpdate(updateParams);
      if (apiResCode(updateRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.renameSuccess"), icon: "success" });
        item["topic"] = newName;
        const list = conversationList.value;
        conversationList.value = list != null ? list.slice(0) : ([] as UTSJSONObject[]);
      } else {
        const errorMessage = apiResMessage(updateRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  async function performTaskDeleteSubmit(item: UTSJSONObject): Promise<void> {
    try {
      const id = toNum(item["id"], 0);
      const deleteRes = await apiAgentConversationDelete(id);
      if (apiResCode(deleteRes) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Components.HistoryConversationList.deleteSuccess"), icon: "success" });
        const current = conversationList.value != null ? conversationList.value : ([] as UTSJSONObject[]);
        const next: UTSJSONObject[] = [];
        for (let i = 0; i < current.length; i++) {
          const c = current[i];
          if (toNum(c["id"], -1) != id) {
            next.push(c);
          }
        }
        conversationList.value = next;
      } else {
        const errorMessage = apiResMessage(deleteRes);
        uni.showToast({ title: errorMessage.length > 0 ? errorMessage : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  function handleTaskRename(item: UTSJSONObject): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.renameModalTitle"),
      editable: true,
      placeholderText: t("Mobile.Components.HistoryConversationList.renamePlaceholder"),
      content: toStr(item["topic"], ""),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      success: (res) => {
        if (res.confirm) {
          const rawContent = res.content;
          const newName = rawContent != null ? rawContent.trim() : "";
          performTaskRenameSubmit(item, newName);
        }
      },
    });
  }

  function handleTaskDelete(item: UTSJSONObject): void {
    uni.showModal({
      title: t("Mobile.Components.HistoryConversationList.deleteModalTitle"),
      content: t("Mobile.Components.HistoryConversationList.deleteModalContent"),
      cancelText: t("Mobile.Common.cancel"),
      confirmText: t("Mobile.Common.confirm"),
      confirmColor: "#ff4d4f",
      success: (res) => {
        if (res.confirm) {
          performTaskDeleteSubmit(item);
        }
      },
    });
  }

  function handleTaskLongPress(index: number): void {
    const item = getTaskItemByIndex(index);
    if (item == null) {
      return;
    }
    const pinned = toBool(item["pinned"]);
    const archived = toBool(item["archived"]);
    const collected = toBool(item["collected"]);
    const options = [
      pinned ? t("Mobile.Conversation.unpin") : t("Mobile.Conversation.pin"),
      archived ? t("Mobile.Conversation.unarchive") : t("Mobile.Conversation.archive"),
      collected ? t("Mobile.Conversation.unfavorite") : t("Mobile.Conversation.favorite"),
      t("Mobile.Components.HistoryConversationList.rename"),
      t("Mobile.Components.HistoryConversationList.delete"),
    ];
    uni.showActionSheet({
      itemList: options,
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.tapIndex == 0) {
          performTaskPinToggle(
            item,
            t("Mobile.Conversation.pinSuccess"),
            t("Mobile.Conversation.unpinSuccess"),
          );
        } else if (res.tapIndex == 1) {
          confirmTaskArchiveToggle(
            item,
            t("Mobile.Conversation.archiveSuccess"),
            t("Mobile.Conversation.unarchiveSuccess"),
          );
        } else if (res.tapIndex == 2) {
          performTaskCollectToggle(
            item,
            t("Mobile.Conversation.favoriteSuccess"),
            t("Mobile.Conversation.unfavoriteSuccess"),
          );
        } else if (res.tapIndex == 3) {
          handleTaskRename(item);
        } else if (res.tapIndex == 4) {
          handleTaskDelete(item);
        }
      },
    });
  }

  // ============================================================
  // 容器触发入口（滚动/下拉刷新/抽屉生命周期）
  // ============================================================
  /** 容器触底：加载下一页。 */
  function loadMore(): void {
    if (taskHasMore.value && conversationRequestPromise == null) {
      requestTasks(true);
    }
  }

  /** 容器下拉刷新：等待在途请求收口后重置游标拉第一页。 */
  async function refresh(): Promise<void> {
    const pending = conversationRequestPromise;
    if (pending != null) {
      await pending;
    }
    lastId.value = null;
    taskHasMore.value = true;
    await requestTasks(false);
  }

  /** 静默头部补差（抽屉 resume / ChatFinished）。 */
  function silentRefresh(): void {
    silentFetchTasks();
  }

  /** 首次打开且无数据时拉第一页。 */
  async function loadIfEmpty(): Promise<void> {
    if (conversationList.value.length > 0) return;
    await requestTasks(false);
  }

  // 可见行数上报：列表整体替换（分页/刷新）与标记版本 bump（置顶/归档/收藏/删除/重命名）都覆盖
  watch(conversationList, (_v: UTSJSONObject[]) => {
    emit("count-change", taskRows.value.length);
  });
  watch(taskFlagsVersion, (_v: number) => {
    emit("count-change", taskRows.value.length);
  });

  defineExpose({
    refresh: refresh as any,
    loadMore: loadMore as any,
    silentRefresh: silentRefresh as any,
    loadIfEmpty: loadIfEmpty as any,
  });
</script>

