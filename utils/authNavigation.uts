import { getCurrentPageFullPath } from "@/utils/common";

/**
 * 跳转到登录页面的公共函数
 * 自动检测当前页面 URL，若当前已处于登录页，则不追加 redirect 参数。
 * @param reLaunch 是否使用 uni.reLaunch 代替 uni.navigateTo（默认为 false）
 */
export function goToLogin(reLaunch: boolean = false): void {
  const currentUrl = getCurrentPageFullPath();
  // 判断当前页面是否已经是登录页（包括普通登录页和微信登录页）
  const isLoginPage =
    currentUrl.includes("/subpackages/pages/login/login") ||
    currentUrl.includes("/subpackages/pages/login-weixin/login-weixin");

  const targetUrl = isLoginPage
    ? "/subpackages/pages/login/login"
    : "/subpackages/pages/login/login?redirect=" + encodeURIComponent(currentUrl);

  if (reLaunch) {
    uni.reLaunch({ url: targetUrl });
  } else {
    uni.navigateTo({ url: targetUrl });
  }
}
