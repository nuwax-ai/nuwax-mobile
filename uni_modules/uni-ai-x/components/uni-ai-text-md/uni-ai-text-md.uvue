<template>
	<text class="text" :class="rootTextClass()">
		<text
			v-for="(data, index) in visibleDatas"
			:key="index"
			:class="tokenTextClass(data.className)"
			@click="toLink(data.href)"
		>{{resolveTokenText(data)}}</text>
	</text>
</template>

<script setup>
	import { MarkdownToken} from '@/uni_modules/uni-cmark';
	import { t, emptyI18nParams } from '@/utils/i18n';
	type UniAiTextMdProps = {
		datas: MarkdownToken[]
		itemType: string
	}

	const props = defineProps({
		datas: {
			type: Array as PropType<MarkdownToken[]>,
			required: true
		},
		itemType: {
			type: String,
			required: true
		},
		contentVariant: {
			type: String,
			default: ''
		},
		isAppDetails: {
			type: Boolean,
			default: false
		}
	})
	
	const toLink = (url: string | null) => {
		if (url != null && url!.length > 0) {
			const conversationPrefix = 'conversation://'
			if (url!.startsWith(conversationPrefix)) {
				const params = url!.substring(conversationPrefix.length).split('&')
				let conversationId = ''
				let agentId = ''
				for (let index = 0; index < params.length; index++) {
					const pair = params[index].split('=')
					if (pair.length < 2) continue
					if (pair[0] == 'id') conversationId = pair[1]
					if (pair[0] == 'agentId') agentId = pair[1]
				}
				if (conversationId.length == 0 || agentId.length == 0) return
				const pagePath = props.isAppDetails
					? '/subpackages/pages/app-details/app-details'
					: '/subpackages/pages/agent-detail/agent-detail'
				uni.navigateTo({
					url: pagePath + '?id=' + agentId + '&conversationId=' + conversationId,
				})
				return
			}
			// console.error('url', url)
			uni.navigateTo({
				"url":"/uni_modules/uni-ai-x/pages/common/webview/webview?url="+url,
				fail:e=>{
					console.error(e);
				}
			})
		}
	}

	const resolveTokenText = (data: MarkdownToken): string => {
		if (data.className == 'conversation-link') {
			return t('Mobile.Chat.viewTaskDetails', emptyI18nParams(), '')
		}
		return data.text != null ? data.text : ''
	}

	/**
	 * App：列表行已拆成多个组件，再渲染 linebreak/\\n 会多出一整行空白，需过滤。
	 * H5：兄弟 text 偏 inline，仍依赖 linebreak 换行，不过滤。
	 */
	const visibleDatas = computed((): MarkdownToken[] => {
		const source = props.datas as MarkdownToken[]
		// #ifndef APP
		return source
		// #endif
		// #ifdef APP
		const out = [] as MarkdownToken[]
		for (let i = 0; i < source.length; i++) {
			const token = source[i]
			const className = token.className != null ? `${token.className}` : ''
			if (className.indexOf('linebreak') >= 0) {
				continue
			}
			if (props.itemType == 'list') {
				const text = token.text != null ? `${token.text}` : ''
				if (text == '\n') {
					continue
				}
			}
			out.push(token)
		}
		return out
		// #endif
	})

	// data.className 可能为 "text depth-1" 等多 class，需拆分为 BEM 单层 class 才能命中 .uni-ai-text-md-heading-box-depth-1 等样式
	const headingBoxClass = (className : string | null | undefined) : string => {
		if (className == null || className == '') return ''
		const raw = (className as string).trim()
		if (raw == '') return ''
		const type = props.itemType
		const parts = raw.split(/\s+/)
		const bem = parts.map((p : string) => 'uni-ai-text-md-' + type + '-box-' + p).join(' ')
		return raw + ' ' + bem
	}

	/** 根文本样式；think 变体仅影响思考内容实例。 */
	const rootTextClass = (): string => {
		const base = props.itemType + '-box' +
			(props.itemType == 'list' ? ' list-content' : '') +
			' uni-ai-text-md-' + props.itemType + '-box'
		return props.contentVariant == 'think'
			? base + ' uni-ai-text-md-think-root'
			: base
	}

	/** token 样式；覆盖标题、列表、链接等各自字号。 */
	const tokenTextClass = (
		className : string | null | undefined,
	): string => {
		const base = headingBoxClass(className)
		return props.contentVariant == 'think'
			? base + ' uni-ai-text-md-think-token'
			: base
	}
</script>

<style lang="scss">
	// 引用scss
	@import './uni-ai-text-md.scss';
	// 元素的样式
	@font-face {
		// #ifdef WEB
		font-display: swap;
		// #endif
		font-family: uniAiIconFontFamily;
		src: url('/uni_modules/uni-ai-x/static/font/iconfont.ttf');
	}
	.uni-ai-icon {
		font-family: uniAiIconFontFamily;
	}
	// .image {
	// 	max-width: 60%;
	// }

	/* 对齐 dev mp-html：正文约 32rpx / lh 48rpx，段落间距约 32rpx（原 px×2） */
	.uni-ai-text-md-paragraph-box {
		width: 100%;
		margin-top: 10rpx;
		margin-bottom: 10rpx;
	}

	.uni-ai-text-md-paragraph-box-text {
		font-size: 32rpx;
		line-height: 48rpx;
		color: #404040;
		white-space: normal;
		/* #ifndef APP */
		max-width: 100%;
		word-break: break-word;
		/* #endif */
	}

	.uni-ai-text-md-heading-box {
		width: 100%;
		margin: 24rpx 0;
	}

	.uni-ai-text-md-heading-box-text {
		font-weight: 600;
		color: #404040;
	}

	.uni-ai-text-md-heading-box-depth-1 {
		font-size: 40rpx;
		line-height: 60rpx;
		font-weight: 600;
		padding-bottom: 0.3em;
	}

	.uni-ai-text-md-heading-box-depth-2 {
		font-size: 36rpx;
		line-height: 54rpx;
		font-weight: 600;
	}

	.uni-ai-text-md-heading-box-depth-3,
	.uni-ai-text-md-heading-box-depth-4,
	.uni-ai-text-md-heading-box-depth-5 {
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 600;
	}

	.uni-ai-text-md-heading-box-depth-6 {
		font-size: 28rpx;
		line-height: 42rpx;
		font-weight: 600;
		color: #999;
	}

	.uni-ai-text-md-hr {
		height: 1rpx;
		background: #d9d9d9;
		margin: 30rpx 0;
	}

	.uni-ai-text-md-list-box {
		width: 100%;
		/* 列表项逐行独立渲染：上下 margin 在 App 不折叠，会导致行距过大；外间距交给 .msg-root-list-box */
		padding-left: 32rpx;
		margin-top: 0;
		margin-bottom: 0;
		box-sizing: border-box;
		/* #ifndef APP */
		display: block;
		/* #endif */
	}

	.uni-ai-text-md-list-content {
		width: 100%;
	}

	.uni-ai-text-md-list-box-text {
		font-size: 32rpx;
		line-height: 48rpx;
		color: #404040;
	}

	.uni-ai-text-md-list-item-content-box {
		flex: 1;
	}

	.uni-ai-text-md-list-item-content-box-list {
		margin-top: 0;
	}

	.uni-ai-text-md-list-item-br {
		width: 100%;
	}

	.uni-ai-text-md-list-item-index {
		width: 40rpx;
		font-size: 28rpx;
		line-height: 48rpx;
		color: #666;
	}

	.uni-ai-text-md-list-item-index-unordered {
		color: #404040;
	}

	/* 思考内容统一使用弱化正文样式，不影响普通答复中的 Markdown。 */
	.uni-ai-text-md-think-root {
		font-size: 28rpx;
		font-weight: 400;
		font-style: normal;
		line-height: 1.6;
		color: #888;
	}

	.uni-ai-text-md-think-token {
		font-size: 28rpx;
		font-weight: 400;
		font-style: normal;
		line-height: 1.6;
		color: #888 !important;
		background-color: transparent;
		padding: 0;
		border-radius: 0;
	}
</style>
