import { ref, type Ref } from "vue";

/**
 * 智能体单聊合规提示显隐（模块级状态，不放 chat.uvue 的 setup state）。
 *
 * 为什么不放页面：chat.uvue 的渲染 lambda 捕获参数已顶到 255 上限，模板每新增一个
 * setup 顶层符号引用就多一个捕获参数，R8 转发桩超限 → Android
 * `VerifyError: Verifier rejected class GenPagesMessageChat`（lambda arg count 0 越界）
 * → 整页加载失败，点消息行进不去聊天页。所以提示抽成零绑定组件
 * （components/chat-ai-hint）挂载，可见性经模块级 ref 传递（utils/imNoticeBar.uts 同款）。
 *
 * 出场方式：主入口（列表/智联录/资料页）把主体类型随 URL 带进来，onLoad 首帧即定死，
 * 不占额外一拍的位移；缺参入口等异步判定齐料后才出现，此时坞会瞬间长高 22px
 * （原「0→22px 高度滑出」依赖 height:0+裁剪 藏隐藏态，鸿蒙真机不可靠——群聊里露出
 * 半行，故改为 v-if 结构性不渲染，不再做高度过渡）。
 *
 * ★跨页残留：模块级 ref 跨页实例存活，聊天页 onHide/onUnload 必须复位 false（见
 * chat.uvue），否则从智能体单聊跳到群聊时，新页首帧可能先按旧值画出这行文案。
 */
export const aiContentHintVisible: Ref<boolean> = ref(false);

/** 写入可见性（同值不触发，避免无谓重渲）。 */
export function setAiContentHintVisible(visible: boolean): void {
  if (aiContentHintVisible.value != visible) {
    aiContentHintVisible.value = visible;
  }
}
