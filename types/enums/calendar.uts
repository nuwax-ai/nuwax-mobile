/**
 * 日程 / 待办枚举，取值与 /api/calendar/* 契约一致。
 * 后续列表、创建等接口共用这里的取值，不要在页面里另写字面量。
 */

/** 日程分类。 */
export enum CalendarCategoryEnum {
  /** 待办 */
  TODO = "TODO",
  /** 工作日程 */
  WORK = "WORK",
}

/** 提醒方式。ONCE 为到期提醒，REPEAT 为提前多次提醒。 */
export enum CalendarRemindTypeEnum {
  ONCE = "ONCE",
  REPEAT = "REPEAT",
}

/** 完成模式。 */
export enum CalendarCompleteModeEnum {
  /** 单人完成即可 */
  ANY_ONE = "ANY_ONE",
  /** 按比例完成 */
  BY_RATIO = "BY_RATIO",
  /** 需所有人完成 */
  ALL = "ALL",
}

/** 日程状态。 */
export enum CalendarEventStatusEnum {
  ACTIVE = "ACTIVE",
  COMPLETED = "COMPLETED",
  CANCELED = "CANCELED",
}

/** 参与人角色。 */
export enum CalendarParticipantRoleEnum {
  OWNER = "OWNER",
  EDITOR = "EDITOR",
  VIEWER = "VIEWER",
}

/** 参与人回复状态。 */
export enum CalendarReplyStatusEnum {
  NEED_ACTION = "NEED_ACTION",
  ACCEPTED = "ACCEPTED",
  TENTATIVE = "TENTATIVE",
  REFUSED = "REFUSED",
}
