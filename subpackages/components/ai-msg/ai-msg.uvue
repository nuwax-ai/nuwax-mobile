     与 .msg-root 内嵌套版本必须保持同步。 */
  .thinking-icon {
    font-size: 28rpx;
    line-height: 40rpx;
    color: rgba(5, 5, 5, 0.45);
    margin-right: 12rpx;
  }

  .thinking-title {
