<template>
  <view v-if="visible" class="meeting-active" @click="resume">
    <text class="meeting-active__text">会议进行中 · 返回会议</text>
  </view>
</template>

<script setup lang="uts">
  import { ref, onMounted, onUnmounted } from "vue";
  import eventBus from "@/utils/eventBus";
  import { MEETING_MEDIA_CHANGED_EVENT, meetingMediaIsMinimized, meetingMediaResume, meetingMediaHasNativeWindow } from "@/utils/meeting/meetingMedia";
  const visible = ref(false);
  const refresh = (_payload: any): void => { visible.value = meetingMediaIsMinimized() && !meetingMediaHasNativeWindow(); };
  function resume(): void { meetingMediaResume(); }
  onMounted(() => {
    refresh(null);
    eventBus.on(MEETING_MEDIA_CHANGED_EVENT, refresh);
  });
  onUnmounted(() => { eventBus.off(MEETING_MEDIA_CHANGED_EVENT, refresh); });
</script>

<style scoped>
  .meeting-active { position: fixed; right: 16px; bottom: 110px; z-index: 180; padding: 12px 16px; border-radius: 24px; background-color: #171719; }
  .meeting-active__text { color: #ffffff; font-size: 13px; }
</style>
