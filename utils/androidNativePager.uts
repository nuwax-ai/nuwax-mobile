import View from "android.view.View";
import ViewGroup from "android.view.ViewGroup";
import ViewPager2 from "androidx.viewpager2.widget.ViewPager2";

/** 只观察公开的原生分页状态，不改触摸监听器、子视图结构或滚动参数。 */
export class AndroidNativePager extends ViewPager2.OnPageChangeCallback {
  private pager: ViewPager2;
  private settled: (index: number) => void;

  constructor(pager: ViewPager2, settled: (index: number) => void) {
    super();
    this.pager = pager;
    this.settled = settled;
    pager.registerOnPageChangeCallback(this);
  }

  override onPageScrollStateChanged(state: Int): void {
    if (state == ViewPager2.SCROLL_STATE_IDLE) this.settled(this.pager.getCurrentItem());
  }

  synchronize(index: number): void {
    // 仅用于重新打开/挂载，与正在进行的触摸无关。
    this.pager.setCurrentItem(index.toInt(), false);
  }

  dispose(): void {
    this.pager.unregisterOnPageChangeCallback(this);
  }
}

function findPager(view: View): ViewPager2 | null {
  if (view instanceof ViewPager2) return view as ViewPager2;
  if (view instanceof ViewGroup) {
    const group = view as ViewGroup;
    for (let i = 0; i < group.getChildCount(); i++) {
      const child = group.getChildAt(i.toInt());
      if (child == null) continue;
      const pager = findPager(child);
      if (pager != null) return pager;
    }
  }
  return null;
}

export function observeAndroidPager(element: UniElement, settled: (index: number) => void): AndroidNativePager | null {
  const host = element.getAndroidView();
  if (host == null) return null;
  const pager = findPager(host);
  return pager != null ? new AndroidNativePager(pager, settled) : null;
}
