<template>
  <!-- 内容区域 -->
  <scroll-view
    class="flex-1 h-full"
    scroll-y="true"
    @scrolltolower="handleLoadMore"
    :lower-threshold="50"
    :refresher-enabled="true"
    :refresher-triggered="refreshing"
    @refresherrefresh="handleRefresh"
    :show-scrollbar="false"
  >
    <template v-if="recentAgentList.length > 0">
      <recent-used-agent-item
        v-for="info in recentAgentList"
        :key="getAgentFieldNumber(info, 'id')"
        :icon="getAgentFieldString(info, 'icon')"
        :name="getAgentFieldString(info, 'name')"
        :description="getAgentDescription(info)"
        :modifiedTime="formatModifiedTime(getAgentFieldString(info, 'modified'))"
        :showModifiedTime="isLoggedIn"
        :paymentRequired="getAgentFieldBool(info, 'paymentRequired') && enableSubscription == 1"
        :subscribed="getAgentFieldBool(info, 'subscribed')"
        @click="handleAgentClick(info)"
        @longpress="handleLongPress(info)"
      />
    </template>

    <!-- loading状态或刷新状态时隐藏空状态 -->
    <template v-else-if="!loading && !refreshing">
      <view class="empty-state h-full">
        <image
          :src="noData"
          class="empty-image"
          :alt="t('Mobile.Common.noDataImageAlt')"
        />
        <text class="empty-text">{{ t("Mobile.Common.noData") }}</text>
      </view>
    </template>

    <!-- 刷新状态时隐藏加载状态 -->
    <template v-else-if="!refreshing">
      <view class="loading-state">
        <text class="loading-text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
    </template>

    <!-- 加载状态时隐藏没有更多数据状态 -->
    <template v-if="showNoMore">
      <view class="no-more-state">
        <text class="no-more-text">{{ t("Mobile.Common.noMoreData") }}</text>
      </view>
    </template>
  </scroll-view>
</template>

<script setup lang="uts">
  import { SUCCESS_CODE } from "@/constants/codes.constants.uts";
  import {
    apiUserUsedAgentList,
    apiUserUsedAgentDelete,
  } from "@/servers/agentDev";
  import { apiPublishedAgentList } from "@/servers/square";
  import { SquarePublishedListParams } from "@/types/interfaces/square";
  import RecentUsedAgentItem from "@/components/recent-used-agent-item/recent-used-agent-item.uvue";
  import noData from "@/static/assets/no_data.png";
  import { formatTimeAgo, defaultString } from "@/utils/common";
  import { USER_NO_LOGIN, REDIRECT_LOGIN } from "@/constants/codes.constants";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { apiTenantConfig } from "@/servers/account";
  import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
  import { ListParams } from "@/types/interfaces/common";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const formatModifiedTime = (modified: string): string => {
    const r = formatTimeAgo(modified);
    return r != null ? r : "";
  };

  /** 接口 description 可能为 null，传给子组件前兜底为空字符串 */
  const getAgentDescription = (info: any): string => {
    if (info == null) return "";
    const obj = info as UTSJSONObject;
    const desc = obj["description"];
    return defaultString(desc != null ? `${desc}` : null, "");
  };

  const agentFieldStr = (info: any, key: string): string => {
    if (info == null) return "";
    const raw = (info as UTSJSONObject)[key];
    return raw != null ? `${raw}` : "";
  };

  const agentFieldNum = (info: any, key: string): number => {
    if (info == null) return 0;
    const raw = (info as UTSJSONObject)[key];
    return raw != null ? (raw as number) : 0;
  };

  const agentFieldBool = (info: any, key: string): boolean => {
    if (info == null) return false;
    const raw = (info as UTSJSONObject)[key];
    return raw == true;
  };

  // Props 定义
  interface AgentListContentProps {
    isLoggedIn: boolean;
  }

  const props = defineProps<AgentListContentProps>();

  // Emits 定义 - 只保留需要父组件处理的事件
  const emit = defineEmits<{
    (e: "agent-click", info: any): void;
  }>();

  // 最近使用智能体列表（Android 上为 UTSJSONObject[]，禁止按 interface 强转）
  const recentAgentList = ref<any[]>([] as any[]);
  // 加载状态
  const loading = ref<boolean>(false);
  // 刷新状态
  const refreshing = ref<boolean>(false);
  // 是否还有更多
  const hasMore = ref<boolean>(false);
  // 当前页码
  const currentPage = ref<number>(1);

  // 租户信息
  const tenantConfigInfo = ref<any | null>(null);

  // 租户订阅限制强受控标志
  const enableSubscription = computed((): number => {
    const tc = tenantConfigInfo.value;
    if (tc != null) {
      const obj = tc as UTSJSONObject;
      const sub = obj["enableSubscription"];
      if (sub != null) {
        return sub as number;
      }
    }
    return 0;
  });

  // 是否显示没有更多数据
  const showNoMore = computed((): boolean => {
    const rl = recentAgentList.value;
    const rlLen = rl != null ? rl.length : 0;
    return !loading.value && !hasMore.value && rlLen > 8;
  });

  // 查询用户最近使用过的智能体列表
  async function fetchUserUsedAgentList(
    page: number = 1,
    pageSize: number = 20,
  ): Promise<any> {
    try {
      const params = new ListParams();
      params.pageIndex = page;
      params.size = pageSize;
      const res = await apiUserUsedAgentList(params);
      loading.value = false;
      const code = apiResCode(res);
      const dataRaw = apiResData<any>(res);
      if (code == SUCCESS_CODE) {
        const newList = dataRaw != null ? (dataRaw as any[]) : ([] as any[]);
        if (page > 1) {
          // 追加数据
          const existing = recentAgentList.value != null ? recentAgentList.value : ([] as any[]);
          const combined = [] as any[];
          for (let i = 0; i < existing.length; i++) {
            combined.push(existing[i]);
          }
          for (let j = 0; j < newList.length; j++) {
            combined.push(newList[j]);
          }
          recentAgentList.value = combined;
        } else {
          // 替换数据
          recentAgentList.value = newList;
        }

        // 是否有更多数据, 如果数据长度大于0，则有更多数据
        hasMore.value = newList.length > 0;
        currentPage.value = page;
        return dataRaw;
      }
    } catch (error) {
      console.error("fetchUserUsedAgentList error:", error);
      return false;
    }
  }

  // 获取公开的智能体列表（未登录时使用）
  const fetchPublishedAgentList = async (): Promise<any> => {
    try {
      const params = new SquarePublishedListParams();
      params.targetType = "Agent";
      params.targetSubType = "ChatBot";
      params.page = 1;
      params.pageSize = 10;
      params.category = "";
      params.kw = "";
      const res = await apiPublishedAgentList(params);
      loading.value = false;
      const code = apiResCode(res);
      if (code == SUCCESS_CODE) {
        // Android: data 是 UTSJSONObject，禁止 JSON.parse<Page<interface>> / 点号访问
        const pageDataRaw = apiResData<any>(res);
        const pageObj = pageDataRaw != null ? (pageDataRaw as UTSJSONObject) : null;
        const recordsRaw = pageObj != null ? pageObj["records"] : null;
        const records = recordsRaw != null ? (recordsRaw as any[]) : ([] as any[]);
        const agentList = [] as any[];
        for (let i = 0; i < records.length; i++) {
          const item = records[i] as UTSJSONObject;
          const obj = new UTSJSONObject();
          obj["id"] = item["id"];
          obj["agentId"] = item["targetId"];
          obj["name"] = item["name"];
          obj["icon"] = item["icon"];
          const desc = item["description"];
          obj["description"] = desc != null ? desc : "";
          obj["agentType"] = item["agentType"];
          obj["modified"] = item["modified"];
          obj["paymentRequired"] = item["paymentRequired"];
          obj["subscribed"] = item["subscribed"];
          agentList.push(obj);
        }
        recentAgentList.value = agentList;
        // 只显示第一页，所以没有更多数据
        hasMore.value = false;
        currentPage.value = 1;
        return agentList;
      }
    } catch (error) {
      console.error("fetchPublishedAgentList error:", error);
      return false;
    }
  };

  // 删除用户最近智能体使用记录
  async function deleteUserUsedAgent(agentId: number): Promise<void> {
    const res = await apiUserUsedAgentDelete(agentId);
    const code = apiResCode(res);
    const message = apiResMessage(res);
    if (code == SUCCESS_CODE) {
      const current = recentAgentList.value != null ? recentAgentList.value : ([] as any[]);
      const filtered = [] as any[];
      for (let i = 0; i < current.length; i++) {
        const item = current[i] as UTSJSONObject;
        const itemAgentId = item["agentId"];
        if (itemAgentId == null || (itemAgentId as number) != agentId) {
          filtered.push(item);
        }
      }
      recentAgentList.value = filtered;
    } else if (code != USER_NO_LOGIN && code != REDIRECT_LOGIN) {
      uni.showToast({
        title: message.length > 0 ? message : t("Mobile.AgentList.deleteFailed"),
        icon: "none",
      });
    }
  }

  // 删除最近使用的智能体
  const handleDeleteUserUsedAgent = (info: any) => {
    const infoObj = info != null ? (info as UTSJSONObject) : null;
    const infoNameRaw = infoObj != null ? infoObj["name"] : null;
    const infoName = infoNameRaw != null ? `${infoNameRaw}` : "";
    uni.showModal({
      title: t("Mobile.AgentList.confirmDeleteAgent"),
      content: infoName,
      success: (res) => {
        // 确认删除
        if (res.confirm) {
          const agentIdRaw = infoObj != null ? infoObj["agentId"] : null;
          const agentId = agentIdRaw != null ? (agentIdRaw as number) : 0;
          deleteUserUsedAgent(agentId);
        }
      },
    });
  };

  // 长按事件（受登录态控制）
  const handleLongPress = (info: any) => {
    if (props.isLoggedIn) {
      handleDeleteUserUsedAgent(info);
    }
  };

  // 下拉刷新
  const handleRefresh = async () => {
    if (refreshing.value) {
      return;
    }
    refreshing.value = true;
    currentPage.value = 1;
    hasMore.value = true;
    // 根据是否登录调用不同的 API
    const fetchPromise = props.isLoggedIn
      ? fetchUserUsedAgentList()
      : fetchPublishedAgentList();
    fetchPromise.finally(() => {
      // 添加延迟，让loading效果更明显
      setTimeout(() => {
        refreshing.value = false;
      }, 500);
    });
  };

  // 加载更多
  const handleLoadMore = () => {
    if (hasMore.value && !loading.value) {
      // 下一页页码
      const nextPage = currentPage.value + 1;
      fetchUserUsedAgentList(nextPage);
    }
  };

  // 点击智能体 - 发射事件给父组件处理
  const handleAgentClick = (info: any) => {
    emit("agent-click", info);
  };

  // 获取租户配置
  const fetchTenantConfig = async () => {
    const res = await apiTenantConfig();
    if (apiResCode(res) == SUCCESS_CODE) {
      const data = apiResData<any>(res);
      tenantConfigInfo.value = data;
      if (data != null) {
        uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(data));
      }
    }
  };

  // 初始化租户配置数据
  const initTenantConfig = async () => {
    // 1. 首先尝试从本地缓存读取
    const tenantConfigInfoString = uni.getStorageSync(TENANT_CONFIG_INFO) as string;
    if (tenantConfigInfoString != null && tenantConfigInfoString.length > 0) {
      const parsed = JSON.parse(tenantConfigInfoString);
      if (parsed != null) {
        tenantConfigInfo.value = parsed;
      }
    }
    // 2. 然后必须发起网络强同步请求，以获得最新的 enableSubscription 状态
    await fetchTenantConfig();
  };

  // 初始化加载数据
  const loadData = async () => {
    loading.value = true;
    // 强同步更新最新的租户配置，防止进入首页列表时计费状态渲染不正确
    await initTenantConfig();
    const list = props.isLoggedIn
      ? await fetchUserUsedAgentList(1, 20 * currentPage.value)
      : await fetchPublishedAgentList();
  };

  onMounted(()=>{
    console.log("onMounted11111111");
    loadData();
  })

  // 暴露方法给父组件
  defineExpose({
    loadData: loadData as any,
    recentAgentList,
  });
</script>

<style lang="scss" scoped>
  /* 空状态 */
  .h-full {
    height: 100%;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    .empty-image {
      width: 170rpx;
      height: 170rpx;
    }

    .empty-text {
      font-size: 28rpx;
      color: #999;
      margin-top: 32rpx;
    }
  }

  /* 加载状态 */
  .loading-state {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;

    .loading-text {
      font-size: 28rpx;
      color: #666;
      display: flex;
      align-items: center;
      flex-direction: row;

      /* #ifndef APP */
      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }

      &::before {
        content: "";
        width: 32rpx;
        height: 32rpx;
        border: 4rpx solid #e8e8e8;
        border-top: 4rpx solid #8b5cf6;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-right: 16rpx;
      }
      /* #endif */
    }
  }

  /* 没有更多数据状态 */
  .no-more-state {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40rpx;

    .no-more-text {
      font-size: 24rpx;
      color: #999;
    }
  }
</style>
