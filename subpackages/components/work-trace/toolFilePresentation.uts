/**
 * V2 工具行「文件路径」展示纯函数：路径拆段 + 扩展名徽标映射。
 * 移植自 PC 端 nuwax presentation-v2/toolFilePresentation.ts（2026-09-14 定调）：
 * 跳转关闭 + 徽标统一中性灰，仅保留类型缩写徽标。
 * 纯模块（不依赖组件/uni API），供 tool-trace-row 渲染与 vitest 直接使用。
 */

/** 会话沙箱工作区路径：/home/user/{数字会话ID}/...；其余按原样完整展示 */
const SANDBOX_HOME_PATTERN = /^\/home\/user\/\d+\//;

/** 是否为会话沙箱工作区路径（非沙箱如 /home/user/Desktop/x.md 按原样展示） */
export function isConversationSandboxPath(target: string): boolean {
  return SANDBOX_HOME_PATTERN.test(target);
}

export class SandboxFilePathParts {
  /** 文件所在目录（不含结尾斜杠；根目录文件为空串） */
  dir: string = "";
  /** 文件名（含扩展名） */
  name: string = "";
  /** 小写扩展名（不含点；无扩展名/点开头的隐藏文件为空串） */
  ext: string = "";
}

/** 把路径拆成目录与文件名；容忍结尾斜杠，点开头的隐藏文件不算扩展名 */
export function splitFilePath(target: string): SandboxFilePathParts {
  const parts = new SandboxFilePathParts();
  let normalized = target;
  // 剥结尾斜杠（/a/b/ → /a/b）
  while (normalized.length > 0 && normalized.charAt(normalized.length - 1) == "/") {
    normalized = normalized.substring(0, normalized.length - 1);
  }
  const slashIndex = normalized.lastIndexOf("/");
  parts.name = slashIndex >= 0 ? normalized.substring(slashIndex + 1) : normalized;
  parts.dir = slashIndex >= 0 ? normalized.substring(0, slashIndex) : "";
  const dotIndex = parts.name.lastIndexOf(".");
  parts.ext = dotIndex > 0 ? parts.name.substring(dotIndex + 1).toLowerCase() : "";
  return parts;
}

export class FileTypeInfo {
  /** 徽标缩写（如 TS / MD） */
  label: string = "";
}

function buildExtTypeMap(): Map<string, string> {
  const map = new Map<string, string>();
  map.set("ts", "TS");
  map.set("tsx", "TSX");
  map.set("js", "JS");
  map.set("jsx", "JSX");
  map.set("mjs", "JS");
  map.set("cjs", "JS");
  map.set("json", "JSON");
  map.set("md", "MD");
  map.set("markdown", "MD");
  map.set("css", "CSS");
  map.set("less", "LESS");
  map.set("scss", "SCSS");
  map.set("sass", "SASS");
  map.set("html", "HTML");
  map.set("htm", "HTML");
  map.set("xml", "XML");
  map.set("yml", "YML");
  map.set("yaml", "YML");
  map.set("py", "PY");
  map.set("sh", "SH");
  map.set("bash", "SH");
  map.set("zsh", "SH");
  map.set("go", "GO");
  map.set("rs", "RS");
  map.set("java", "JAVA");
  map.set("c", "C");
  map.set("h", "C");
  map.set("cpp", "C++");
  map.set("cc", "C++");
  map.set("hpp", "C++");
  map.set("php", "PHP");
  map.set("rb", "RB");
  map.set("sql", "SQL");
  map.set("vue", "VUE");
  map.set("svg", "SVG");
  map.set("png", "IMG");
  map.set("jpg", "IMG");
  map.set("jpeg", "IMG");
  map.set("gif", "IMG");
  map.set("webp", "IMG");
  map.set("mp4", "VIDEO");
  map.set("mov", "VIDEO");
  map.set("webm", "VIDEO");
  map.set("mp3", "AUDIO");
  map.set("wav", "AUDIO");
  map.set("flac", "AUDIO");
  map.set("zip", "ZIP");
  map.set("gz", "ZIP");
  map.set("tar", "ZIP");
  map.set("rar", "ZIP");
  map.set("pdf", "PDF");
  map.set("txt", "TXT");
  map.set("log", "LOG");
  map.set("env", "ENV");
  return map;
}

const EXT_TYPE_MAP: Map<string, string> = buildExtTypeMap();

/** 按文件名取徽标信息；未知扩展名给大写缩写（无扩展名归为 FILE） */
export function getFileTypeInfo(fileName: string): FileTypeInfo {
  const info = new FileTypeInfo();
  const parts = splitFilePath(fileName);
  const mapped = EXT_TYPE_MAP.get(parts.ext);
  if (mapped != null) {
    info.label = mapped;
    return info;
  }
  const raw = parts.ext.length > 0 ? parts.ext : "file";
  info.label = raw.substring(0, 4).toUpperCase();
  return info;
}

/** 行内徽标视图项（预计算，避免模板函数每帧重算） */
export class ToolFileBadgeView {
  /** 徽标缩写（TS/MD…） */
  label: string = "";
  /** 文件名（含扩展名，展示层自行截断） */
  name: string = "";
}

/** 批量生成行内徽标视图（files → [{label, name}]） */
export function buildFileBadgeViews(files: string[]): ToolFileBadgeView[] {
  const out: ToolFileBadgeView[] = [] as ToolFileBadgeView[];
  for (let i = 0; i < files.length; i++) {
    const parts = splitFilePath(files[i]);
    const view = new ToolFileBadgeView();
    view.label = getFileTypeInfo(parts.name).label;
    view.name = parts.name;
    out.push(view);
  }
  return out;
}
