<template>
  <view
    class="openui-card"
    :class="{ 'openui-card--pending': !isReady }"
    @tap="handleClick"
  >
    <view class="openui-card__icon">
      <svg-icon name="icon-a-Filetext" size="32" />
    </view>
    <view class="openui-card__content">
      <text class="openui-card__title">{{ displayTitle }}</text>
      <text class="openui-card__hint">{{ displayHint }}</text>
    </view>
    <view v-if="isReady" class="openui-card__arrow">
      <svg-icon name="icon-a-Chevronright" size="24" />
    </view>
  </view>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { openOpenUiArtifact } from "@/utils/system.uts";

  const props = withDefaults(
    defineProps<{
      /** OpenUI artifactId（UUID）。 */
      artifactId: string;
      /** 卡片标题（artifact.title）。 */
      title?: string;
      /** 当前会话 ID，可带 chat- 前缀。 */
      conversationId?: string;
    }>(),
    {
      title: "",
      conversationId: "",
    },
  );

  const displayTitle = computed((): string => {
    return props.title.length > 0 ? props.title : "OpenUI 界面";
  });

  const isReady = computed((): boolean => props.artifactId.length > 0);

  const displayHint = computed((): string => {
    return isReady.value ? "点击查看界面" : "界面生成中";
  });

  /** 点击 → file-preview-page（与文件树点击 .openui.json 同一页面）。 */
  async function handleClick(): Promise<void> {
    // 流式 EXECUTING 阶段只有工具名，没有 artifactId；此时卡片仅作进度占位。
    if (!isReady.value) {
      return;
    }
    if (props.conversationId.length == 0) {
      uni.showToast({ title: "无法打开 OpenUI", icon: "none" });
      return;
    }
    await openOpenUiArtifact(props.conversationId, props.artifactId, props.title);
  }
</script>

<style lang="scss" scoped>
  .openui-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 72rpx; /* sidecar：紧凑摘要行 */
    margin: 8rpx 0;
    padding: 10rpx 14rpx;
    border-radius: 10rpx;
    background-color: rgba(12, 20, 102, 0.045);
    box-sizing: border-box;
  }

  .openui-card--pending {
    opacity: 0.68;
  }

  .openui-card__icon,
  .openui-card__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .openui-card__icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 12rpx;
  }

  .openui-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .openui-card__title {
    color: #333333;
    font-size: 28rpx;
    font-weight: 600;
    line-height: 40rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .openui-card__hint {
    margin-top: 4rpx;
    color: #8b8e96;
    font-size: 23rpx;
    line-height: 32rpx;
  }

  .openui-card__arrow {
    width: 32rpx;
    height: 32rpx;
    margin-left: 12rpx;
  }
</style>
