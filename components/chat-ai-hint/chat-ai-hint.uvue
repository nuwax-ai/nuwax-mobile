<template>
  <!-- 智能体单聊合规提示：会话名下方一行小字（2026-10-29 从输入坞下方移到标题下）。
       零绑定挂载——状态读模块级 ref（im-notice-bar 同款写法），原因见 utils/chatAiHint.uts。
       ★隐藏态用 v-if 结构性不渲染（im-notice-bar 同款），不用「height:0 + overflow:hidden」
       收起：原先那种写法在鸿蒙真机上不可靠（群聊里曾露出半行、被输入坞挡住；0 高度容器
       没把字裁掉或高度过渡半途停住都可能有这形态）。合规文案出现在群聊/人类单聊属误导，
       宁可不渲染，也不依赖裁剪/过渡去「藏」。 -->
  <view v-if="visible" class="chat-ai-hint">
    <text class="chat-ai-hint__text">{{ t("Mobile.Message.aiContentHint") }}</text>
  </view>
</template>

<script lang="uts" setup>
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { aiContentHintVisible } from "@/utils/chatAiHint.uts";

  /** 模块级 ref 直接取别名（勿包 computed）：im-notice-bar 已验证「模板直读模块 ref、
     页面侧写入即重渲」，多套一层 computed 无收益且多一条待验路径。 */
  const visible = aiContentHintVisible;
  /** 文案在模板里逐渲染取（与 chat.uvue 的 t 同款），不缓存：语言包/文案更新即刻生效。 */
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
</script>

<style lang="scss" scoped>
  /* 标题列里的第二行：行高 15 与 11px 字配套，标题 23 + 本行 15 ≈ 38，54px 头高内仍居中。
     隐藏态不靠裁剪（见模板注释），节点由 v-if 整体卸载。 */
  .chat-ai-hint {
    margin-top: 1px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* 与 foot__text 同灰的小字 */
  .chat-ai-hint__text {
    text-align: center;
    font-size: 11px;
    line-height: 15px;
    color: #b0aebc;
  }
</style>
