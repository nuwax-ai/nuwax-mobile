<template>
  <view class="about-page">
    <custom-nav-bar :title="t('Mobile.Mine.aboutNuwax')" :has-safety-zone="true">
      <template v-slot:left>
        <view class="header-icon-box" @tap="handleBack">
          <svg-icon name="icon-a-Chevronleft" size="22" unit="px" />
        </view>
      </template>
    </custom-nav-bar>

    <view class="card-group">
      <!-- 隐私协议 -->
      <view class="row-item" @click="handlePrivacyPolicy">
        <view class="row-icon-box">
          <svg-icon name="icon-api-key-thick" size="20" unit="px" />
        </view>
        <view class="row-info">
          <text class="row-title">{{ t("Mobile.Mine.privacyAgreement") }}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <!-- 用户协议 -->
      <view class="row-item" @click="handleUserAgreement">
        <view class="row-icon-box">
          <svg-icon name="icon-a-Filetext" size="20" unit="px" />
        </view>
        <view class="row-info">
          <text class="row-title">{{ t("Mobile.Mine.userAgreement") }}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <!-- 联系我们 -->
      <view class="row-item" @click="handleContactUs">
        <view class="row-icon-box">
          <svg-icon name="icon-message" size="20" unit="px" />
        </view>
        <view class="row-info">
          <text class="row-title">{{ t("Mobile.Mine.contactUs") }}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <!-- 帮助与反馈 -->
      <view v-if="isAboutUsVisible" class="row-item" @click="handleHelpFeedback">
        <view class="row-icon-box">
          <svg-icon name="icon-HelpAndFeedback" size="20" unit="px" />
        </view>
        <view class="row-info">
          <text class="row-title">{{ t("Mobile.Mine.helpFeedback") }}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <!-- 版本号 -->
    <text class="version-text">{{ appVersionDisplay }}</text>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { onShow } from "@dcloudio/uni-app";
  import { ABOUT_US_PAGE_PATH, isAboutUsEntryHost } from "@/constants/config";
  import { jumpToWebview } from "@/utils/commonBusiness";
  import { jumpNavigateBack } from "@/utils/common";
  import { goToLogin } from "@/utils/authNavigation";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const isAboutUsVisible = ref<boolean>(isAboutUsEntryHost());
  const appVersionDisplay = computed((): string => {
    const version = uni.getAppBaseInfo().appVersion ?? "";
    const trimmed = version.trim();
    return trimmed.length > 0 ? `v${trimmed}` : "--";
  });

  const handleBack = () => {
    jumpNavigateBack();
  };

  const openAgreement = (urlKey: string, titleKey: string) => {
    const targetUrl = t(urlKey);
    if (targetUrl.length == 0) {
      uni.showToast({ title: t("Mobile.Link.invalidConfig"), icon: "none" });
      return;
    }
    uni.navigateTo({
      url:
        `/subpackages/pages/webview/webview?url=${encodeURIComponent(targetUrl)}` +
        `&title=${encodeURIComponent(t(titleKey))}`,
    });
  };

  const handlePrivacyPolicy = () => {
    openAgreement("Mobile.Auth.privacyAgreementLink", "Mobile.Mine.privacyAgreement");
  };

  const handleUserAgreement = () => {
    openAgreement("Mobile.Auth.userAgreementLink", "Mobile.Mine.userAgreement");
  };

  const handleContactUs = () => {
    uni.showToast({
      title: t("Mobile.Profile.feedbackEmail"),
      icon: "none",
    });
  };

  const handleHelpFeedback = () => {
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    const token = tokenRaw != null ? `${tokenRaw}`.trim() : "";
    if (token.length == 0) {
      goToLogin();
      return;
    }
    jumpToWebview(ABOUT_US_PAGE_PATH, "inner", t("Mobile.Mine.helpFeedback"));
  };

  onShow(() => {
    isAboutUsVisible.value = isAboutUsEntryHost();
  });
</script>

<style lang="scss" scoped>
  .about-page {
    flex: 1;
    background-color: #f7f7f7;
    display: flex;
    flex-direction: column;
  }

  .header-icon-box {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-group {
    background-color: #ffffff;
    border-radius: 12px;
    margin: 12px 12px 0;
    overflow: hidden;
  }

  .row-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid #f5f5f5;
  }

  .row-item:last-child {
    border-bottom-width: 0;
  }

  .row-icon-box {
    width: 28px;
    height: 28px;
    margin-right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .row-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .row-title {
    font-size: 15px;
    font-weight: 500;
    color: #1a1a1a;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    lines: 1;
  }

  .row-arrow {
    font-size: 20px;
    color: #c0c0c0;
    font-weight: 300;
    line-height: 1;
    padding-left: 4px;
  }

  .version-text {
    margin-top: 12px;
    text-align: center;
    font-size: 13px;
    color: #c0c0c0;
  }
</style>
