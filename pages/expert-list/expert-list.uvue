<template>
  <view class="expert-list">
    <safety-zone />

    <search-more-bar
      :placeholder="t('Mobile.ExpertList.searchPlaceholder')"
      :more-text="t('Mobile.Conversation.more')"
      @search="handleSearch"
      @more="handleMore"
    />

    <!-- 列表 -->
    <view class="expert-list__body">
      <published-agent-list
        ref="publishedAgentListRef"
        targetType="ChatBot"
        :is-official="true"
        :expert-payment="true"
      ></published-agent-list>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  import PublishedAgentList from '@/components/published-agent-list/published-agent-list.uvue'
  import SearchMoreBar from '@/components/search-more-bar/search-more-bar.uvue'
  // #ifdef MP-WEIXIN
  import { onAddToFavorites } from '@dcloudio/uni-app'
  // #endif
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { onShow } from "@dcloudio/uni-app";
  import { getCurrentPagePath } from "@/utils/commonBusiness";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ============================== 每次进入tab页时静默刷新智能体列表数据start ==============================
  const publishedAgentListRef = ref<ComponentPublicInstance | null>(null);

  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) return;
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // 切到本 tab 时清除可能残留的 mask:true loading，并触发智能体列表静默刷新（对齐 index.uvue / mine.uvue）
  onShow(() => {
    callRefMethod(publishedAgentListRef.value, "refreshData");
  });
  // ============================== 每次进入tab页时静默刷新智能体列表数据end ==============================

  function handleSearch(): void {
    const currentUrl = getCurrentPagePath();
    uni.navigateTo({
      url:
        `/subpackages/pages/agent-search/agent-search?type=ChatBot&backUrl=` +
        encodeURIComponent(currentUrl),
    });
  }

  function handleMore(): void {
    uni.navigateTo({
      url: "/subpackages/pages/agent-list/agent-list",
    });
  }

  // #ifdef MP-WEIXIN
  // 收藏
  onAddToFavorites(() => {
    return {
      title: t("Mobile.Nav.agent"),
    }
  })
  // #endif
</script>

<style lang="scss" scoped>
  .expert-list {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #ffffff;
  }

  .expert-list__body {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
</style>

<!-- H5：禁止页面级滚动，仅列表内部滚动 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  /* #endif */
</style>
