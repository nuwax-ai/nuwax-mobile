<template>
  <view class="cst-bar">
    <!-- 页签横向滚动区：页签集将来可被「添加标签页」扩展（群公告/入群申请/设置/成员…），
         超出可用宽度时横向滚动，绝不裁切。
         ★搜索键**不放在这里**：它固定在右端不参与滚动 —— 页签多到需要滚动时，
           搜索仍需一键可达（PC 同款：搜索是右侧固定工具位）。 -->
    <!-- ★方向必须写 direction，不能只靠 scroll-x：uni-app x 里 scroll-x/scroll-y 已废弃，
         实际滚动方向只看 direction（默认 "vertical"），且 scroll-y 默认 true ——
         只写 :scroll-x="true" 时方向仍是竖向，iOS 上表现为「页签被裁、滑不动」
         （Android 老实现还认 scroll-x，所以双端表现不一致）。 -->
    <scroll-view class="cst-scroll" direction="horizontal" :scroll-x="true" :scroll-y="false" :show-scrollbar="false">
      <view class="cst-row" :style="rowStyle">
        <view
          v-for="tab in tabs"
          :key="tab.id"
          class="cst-tab"
          :class="active == tab.id ? 'cst-tab--on' : ''"
          hover-class="cst-tab--hover"
          @click="handleTap(tab.id)"
        >
          <!-- #ifdef APP-HARMONY -->
          <!-- 鸿蒙：整粒胶囊（图标+文案）由 contentOn 统一放行——图标 <image> 必须生在
               页面首帧已呈现之后（见 props.contentOn 注释），文案随之同拍，
               绝不出现「先文案后图标」 -->
          <!-- 自定义链接的 emoji 图标（iconText 非空）走 <text> 字形：不经过位图加载
               链路，但同样跟 contentOn 一起放行，保持整粒同拍 -->
          <text v-if="contentOn && tab.iconText.length > 0" class="cst-tab__emoji">{{ tab.iconText }}</text>
          <image v-else-if="contentOn" class="cst-tab__icon" :src="tab.icon" mode="aspectFit" />
          <!-- #endif -->
          <!-- #ifndef APP-HARMONY -->
          <text v-if="tab.iconText.length > 0" class="cst-tab__emoji">{{ tab.iconText }}</text>
          <image v-else class="cst-tab__icon" :src="tab.icon" mode="aspectFit" />
          <!-- #endif -->
          <!-- #ifdef APP-HARMONY -->
          <text
            v-if="contentOn"
            class="cst-tab__text"
            :class="active == tab.id ? 'cst-tab__text--on' : ''"
          >{{ tab.label }}</text>
          <!-- #endif -->
          <!-- #ifndef APP-HARMONY -->
          <text
            class="cst-tab__text"
            :class="active == tab.id ? 'cst-tab__text--on' : ''"
          >{{ tab.label }}</text>
          <!-- #endif -->
        </view>
      </view>
    </scroll-view>
    <!-- 行尾「+」（添加标签页 / 管理标签页入口，对齐 PC 顶部标签栏右侧的 + 菜单）。
         ★与搜索键同处固定右端、不参与滚动：PC 把它排在最后一个标签之后，但 App 的
           页签集最多会有「4 内置 + 100 自定义链接」，排在滚动行里等于多滚几屏才看得见。
         ★零绑定：本组件不新增 prop/事件（chat.uvue 的模板捕获参数已到硬限），
           点按直接跳独立页 subpackages/pages/im-chat-tabs，会话上下文从 chatTabsStore 现取。
         鸿蒙与页签同拍放行，整行一起出现 -->
    <!-- #ifdef APP-HARMONY -->
    <view v-if="contentOn" class="cst-plus" hover-class="cst-plus--hover" @click="handlePlusTap">
      <svg-icon name="icon-Plus" size="17" unit="px" color="#6b6878" />
    </view>
    <!-- #endif -->
    <!-- #ifndef APP-HARMONY -->
    <view class="cst-plus" hover-class="cst-plus--hover" @click="handlePlusTap">
      <svg-icon name="icon-Plus" size="17" unit="px" color="#6b6878" />
    </view>
    <!-- #endif -->
    <!-- 行尾搜索键（固定在右端）：进「本会话内搜索」页，开关由调用方控制；
         鸿蒙与页签同拍放行，整行一起出现 -->
    <!-- #ifdef APP-HARMONY -->
    <view
      v-if="contentOn && showSearch"
      class="cst-search"
      hover-class="cst-search--hover"
      @click="handleSearchTap"
    >
      <svg-icon name="icon-Search" size="17" unit="px" color="#6b6878" />
    </view>
    <!-- #endif -->
    <!-- #ifndef APP-HARMONY -->
    <view
      v-if="showSearch"
      class="cst-search"
      hover-class="cst-search--hover"
      @click="handleSearchTap"
    >
      <svg-icon name="icon-Search" size="17" unit="px" color="#6b6878" />
    </view>
    <!-- #endif -->
  </view>
</template>

<script lang="uts" setup>
  import { computed, getCurrentInstance, onMounted, ref, watch } from "vue";
  import { ChatSubpageTab } from "@/types/interfaces/chatSubpageTab";
  import { currentChatTabsContext } from "@/utils/im/chatTabsStore";

  /**
   * 聊天详情页「子页签行」：对话标题下方一排 消息/Pin/资料库/文件 按钮（单聊与群聊复用）。
   *
   * - 标签集由调用方拼装传入（单聊四枚；群聊后续可加群公告等），本组件只管渲染与点击分发；
   * - ★选中态不改图标颜色（彩色实心 PNG 常驻），只改文字色 + 胶囊底色——
   *   对齐 PC nuwax-im-web DEV-187 的参考图语义，勿改用 currentColor 类单色图标；
   * - 「消息」由页面侧恒为选中（本组件无内部状态，active 受控）；
   *   Pin/资料库/文件/搜索 的开页/占位逻辑全部在页面侧处理（组件不感知路由）；
   * - 行尾可带一枚搜索键（showSearch 开关）：点击只向外发 search 事件。
   *
   * <h2>★横向滚动（2026-11-06，对齐 PC 顶部页签的第一步）</h2>
   *
   * 页签集要从 4 枚扩到 9 枚（群公告/入群申请/设置/成员/自定义链接…），旧的普通 view
   * 横排靠「收窄间距」硬扛，窄屏最右搜索键已被裁（见下方样式注释）。改法：
   * <ol>
   *   <li>页签放进 {@code scroll-view} 横向滚动，搜索键固定在右端不参与滚动；</li>
   *   <li>★内层行必须由 {@link measureRow} **实测写回宽度** —— Android 上 scroll-view 里的
   *       flex 行会被压成视口宽，内容再宽也拿不到滚动余量（同 components/conversation-input/
   *       knowledge-select-sheet 的 measureTabsRow 配方，那边已真机验证）；</li>
   *   <li>测量在挂载后、props.tabs 变化后、鸿蒙 contentOn 放行后各做一次 ——
   *       鸿蒙放行前图标/文案都没建节点，测出来偏小会漏掉写回。</li>
   * </ol>
   * ★当前「消息」恒选中（点其它页签是推子页，选中态不变），所以暂不做
   *   scroll-into-view 把选中项滚进视野；将来若改成页内切换，在这里补 ensureActiveVisible。
   */
  const props = withDefaults(
    defineProps<{
      /** 标签集（顺序即渲染顺序）。 */
      tabs: ChatSubpageTab[];
      /** 当前选中标签 id（受控；「消息」页恒传 "messages"）。 */
      active?: string;
      /** 行尾是否渲染搜索键（「文件」后面的放大镜）。 */
      showSearch?: boolean;
      /**
       * APP-HARMONY：页签内容（图标+文案+搜索键）是否放行。
       * 鸿蒙 Image 节点建出来即 Visibility.Hidden，要等 onComplete 派发 loadingStatus===0
       * 才置可见；而 @load 走 loadingStatus===1 另一条分支，于是「事件正常、图不显示」。
       * 实证规律：图片节点生在页面首帧窗内就永久 Hidden，生在首帧呈现之后则正常
       * （代码依据见 pages/message/chat.uvue 的 harmonyImgOn 头注）。
       * 故由调用方在 onReady（=首帧已呈现）之后置 true，图标与文案整粒一起出现，
       * 不做组件内自计时（旧版延迟放行会「先文案后图标」）。
       * 其余端不传，默认 true 恒放行。
       */
      contentOn?: boolean;
    }>(),
    {
      tabs: () => [] as ChatSubpageTab[],
      active: "messages",
      showSearch: false,
      contentOn: true,
    },
  );

  const emit = defineEmits<{
    (e: "select", id: string): void;
    (e: "search"): void;
  }>();

  // 组件的放行时机全部由调用方掌握（props.contentOn），组件内不自行计时。

  function handleTap(id: string): void {
    emit("select", id);
  }

  function handleSearchTap(): void {
    emit("search");
  }

  /**
   * 「+」点按：进「标签管理」页（subpackages/pages/im-chat-tabs）。
   *
   * ★会话上下文（convId / 是否群聊 / 我能不能改链接 / 资料库可不可用）由本组件的
   *   调用方在 onShow 注册进 chatTabsStore，这里现取一次拼进 URL —— 组件因此仍然
   *   **零 prop 零事件**（chat.uvue 的模板捕获参数已到 255 硬限）。
   * ★管理页必须自己带着这些参数重新注册上下文：进页时聊天页会 onHide 把上下文摘掉，
   *   否则页内拉取/增删改全部落空（详见那个页面的文件头）。
   */
  function handlePlusTap(): void {
    const ctx = currentChatTabsContext();
    if (ctx.convId.length == 0) {
      // 页面还没注册上下文（首帧早期）：静默忽略，不弹空页
      return;
    }
    const isGroup = ctx.isGroup ? "1" : "0";
    const isAgentP2p = ctx.isAgentP2p ? "1" : "0";
    const isSystemConv = ctx.isSystemConv ? "1" : "0";
    const canEditLinks = ctx.canEditLinks ? "1" : "0";
    const canShowLibrary = ctx.canShowLibrary ? "1" : "0";
    uni.navigateTo({
      url: `/subpackages/pages/im-chat-tabs/im-chat-tabs?convId=${ctx.convId}&isGroup=${isGroup}&isAgentP2p=${isAgentP2p}&isSystemConv=${isSystemConv}&canEditLinks=${canEditLinks}&canShowLibrary=${canShowLibrary}`,
    });
  }

  // ===== 横向滚动：内层行宽实测写回 =====

  /** 页签之间的间距，必须与下方 .cst-tab 的 margin-right **同一数值**。 */
  // #ifdef APP-ANDROID || APP-HARMONY
  const TAB_GAP = 2;
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  const TAB_GAP = 6;
  // #endif

  /** 行尾留白，必须与 .cst-row 的 padding-right **同一数值**。 */
  const ROW_END_PADDING = 4;

  const componentInstance = getCurrentInstance();
  /** 内层行写回宽度（px）；0 = 内容没超视口，交给 flex 自然排布。 */
  const rowWidthPx = ref<number>(0);

  const rowStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    if (rowWidthPx.value > 0) {
      style["width"] = `${rowWidthPx.value}px`;
    }
    return style;
  });

  /**
   * 量一次内层行内容宽度：超过滚动视口才写死宽度（写死了 scroll-view 才有滚动余量）。
   * 节点还没布局完（首帧、鸿蒙放行前）时重试 2 次，每次 120ms。
   */
  function measureRow(attempt: number): void {
    if (componentInstance == null || componentInstance.proxy == null) return;
    uni.createSelectorQuery()
      .in(componentInstance.proxy)
      .select(".cst-scroll")
      .boundingClientRect()
      .selectAll(".cst-tab")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        const ready = results.length >= 2 && results[0] != null && Array.isArray(results[1]);
        if (ready != true) {
          if (attempt < 2) setTimeout((): void => measureRow(attempt + 1), 120);
          return;
        }
        const viewport = results[0] as NodeInfo;
        const tabRects = results[1] as NodeInfo[];
        const viewportWidth = viewport.width != null ? parseFloat(`${viewport.width}`) : 0;
        if (tabRects.length == 0 || viewportWidth <= 0) {
          if (attempt < 2) setTimeout((): void => measureRow(attempt + 1), 120);
          else rowWidthPx.value = 0;
          return;
        }
        let contentWidth = 0;
        for (let i = 0; i < tabRects.length; i++) {
          const w = tabRects[i].width != null ? parseFloat(`${tabRects[i].width}`) : 0;
          contentWidth += w;
        }
        contentWidth += tabRects.length * TAB_GAP + ROW_END_PADDING;
        // 差 1px 以内算没超（浮点取整抖动），避免无谓地写死宽度
        rowWidthPx.value = contentWidth > viewportWidth + 1 ? Math.ceil(contentWidth) : 0;
      });
  }

  // 页签集变化（资料库按智能体判定齐料后出现/消失、将来用户增删页签）→ 重测
  watch((): ChatSubpageTab[] => props.tabs, (_tabs: ChatSubpageTab[]): void => {
    setTimeout((): void => measureRow(0), 120);
  });

  // #ifdef APP-HARMONY
  // 鸿蒙 contentOn 放行前图标/文案节点都不存在，测出来偏小：放行后再量一次
  watch((): boolean => props.contentOn == true, (value: boolean): void => {
    if (value) {
      setTimeout((): void => measureRow(0), 120);
    }
  });
  // #endif

  onMounted((): void => {
    setTimeout((): void => measureRow(0), 120);
  });
</script>

<style lang="scss" scoped>
  /* ===== 子页签行：标题下方，左起横排胶囊（可横向滚动） ===== */
  .cst-bar {
    flex-shrink: 0;
    padding: 6px 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-bottom: 1px solid #e5e6eb;
  }

  /* 滚动视口：占满搜索键以左的全部宽度；高度必须写死（scroll-view 不会由内容撑高） */
  .cst-scroll {
    flex: 1;
    min-width: 0;
    height: 32px;
  }

  /* 内层行：高度与视口同高，胶囊纵向居中；宽度由 measureRow 实测写回（超出视口时） */
  .cst-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding-right: 4px;
  }

  .cst-tab {
    padding: 4px 11px;
    margin-right: 6px;
    /* 圆角收敛：近全胶囊 → 8px 小圆角（用户要求「圆角小一点」） */
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    /* ★不被压缩：一行放不下时靠 scroll-view 滚动，而不是把胶囊挤扁 */
    flex-shrink: 0;
  }

  .cst-tab--on {
    /* 选中胶囊淡蓝底（与「消息」气泡蓝同色系） */
    background-color: rgba(19, 86, 240, 0.1);
  }

  .cst-tab--hover {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .cst-tab__icon {
    width: 20px;
    height: 20px;
    margin-right: 4px;
    flex-shrink: 0;
  }

  /* 自定义链接的 emoji 图标：与 .cst-tab__icon 同占位（20×20），字号 16px 让彩色
     字形视觉大小接近 20px 的 PNG 图案；居中避免不同系统 emoji 字宽差异带偏基线。
     ★不要给 font-family 兜底字体：让系统按 emoji 走彩色字体（iOS Apple Color Emoji /
     Android NotoColorEmoji / 鸿蒙系统 emoji），指定文本字体会退化成黑白豆腐块。 */
  .cst-tab__emoji {
    width: 20px;
    height: 20px;
    margin-right: 4px;
    font-size: 16px;
    line-height: 20px;
    text-align: center;
    flex-shrink: 0;
  }

  .cst-tab__text {
    font-size: 13px;
    line-height: 18px;
    color: #6b6878;
    white-space: nowrap;
  }

  .cst-tab__text--on {
    color: #1356f0;
    font-weight: 600;
  }

  /* 行尾「+」：与搜索键同尺寸、同色的圆形热区，固定在右端（不参与滚动）。 */
  .cst-plus {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cst-plus--hover {
    background-color: rgba(0, 0, 0, 0.06);
  }

  /* 行尾搜索键：圆形热区，固定在右端（不参与滚动） */
  .cst-search {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cst-search--hover {
    background-color: rgba(81, 71, 255, 0.06);
  }

  /* #ifdef APP-HARMONY || APP-ANDROID */
  /* 鸿蒙 HarmonyOS Sans 字形偏宽：四页签 + 搜索键在窄屏行内溢出（una flex 子项默认
     flex-shrink:0 不收缩）。只收间距（margin）不动胶囊内距（padding）与 icon 尺寸：
     11px 内距撑住胶囊视觉大小，页间距收到 2px 后相邻胶囊视觉间隙仍有 25px 不显拥挤；
     合计省 26px。Android 同步这套收窄后的间距（用户要求两端观感一致，页间距小一点）；
     iOS/H5 保持 6px 不动。
     ★2026-11-06 起溢出由 scroll-view 横向滚动兜底，这套收窄保留只为两端观感一致，
     ★改这里必须同步改 script 里的 TAB_GAP（measureRow 用它算内容总宽）。 */
  .cst-tab {
    margin-right: 2px;
  }

  .cst-tab__icon {
    margin-right: 2px;
  }

  /* emoji 图标同间距收紧（与上面 .cst-tab__icon 同步，否则自定义链接标签会比其它标签宽一截） */
  .cst-tab__emoji {
    margin-right: 2px;
  }
  /* #endif */
</style>
