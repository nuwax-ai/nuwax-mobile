/**
 * 受保护文件预览的分享地址。
 * 进入网页页时，路径含 /api/f/ 就换成带 ak 的直链；点击分享时优先用这次结果。
 */
import { fetchAuthProtectedFileAkUrl } from "@/utils/authProtectedFileUrl";

let cachedKey = "";
let cachedUrl = "";
let pendingKey = "";
let pending: Promise<string> | null = null;

/** 路径中含 /api/f/ 视为文件预览地址，返回去掉域名和查询后的路径。 */
export function filePreviewPath(raw: string): string {
  const at = raw.indexOf("/api/f/");
  if (at < 0) return "";
  let path = raw.substring(at);
  const query = path.indexOf("?");
  if (query >= 0) path = path.substring(0, query);
  const hash = path.indexOf("#");
  if (hash >= 0) path = path.substring(0, hash);
  return path;
}

/** 请求并记下文件分享地址。失败时清掉进行中的标记，方便点击分享时再取一次。 */
async function loadFilePageShare(pageUrl: string, pathKey: string): Promise<string> {
  let shareUrl = "";
  try {
    shareUrl = await fetchAuthProtectedFileAkUrl(pageUrl, false);
  } catch (_error) {
    shareUrl = "";
  }
  if (shareUrl.length > 0) {
    cachedKey = pathKey;
    cachedUrl = shareUrl;
  }
  if (pendingKey == pathKey) {
    pending = null;
    pendingKey = "";
  }
  return shareUrl;
}

/**
 * 进入文件预览页时预取分享地址。路径不含 /api/f/ 时返回空串。
 * @param pageUrl 当前网页地址
 */
export function prepareFilePageShare(pageUrl: string): Promise<string> {
  const pathKey = filePreviewPath(pageUrl);
  if (pathKey.length == 0) return Promise.resolve("");
  if (cachedKey == pathKey) return Promise.resolve(cachedUrl);
  if (pendingKey == pathKey && pending != null) return pending;
  pendingKey = pathKey;
  pending = loadFilePageShare(pageUrl, pathKey);
  return pending;
}

/** 进入页面时已经拿到的文件分享地址。没有或不是当前文件时返回空串，不发请求。 */
export function readFilePageShareUrl(pageUrl: string): string {
  const pathKey = filePreviewPath(pageUrl);
  if (pathKey.length == 0 || cachedKey != pathKey) return "";
  return cachedUrl;
}
