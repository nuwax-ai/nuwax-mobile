/** 聊天业务适配：只组装会话路由，加载与回退交给 offline-h5-container。 */
import { getStatusBarHeight } from '@/utils/system.uts';
import { buildProjectOfflineH5Request, OFFLINE_H5_BOOTSTRAP_ROUTE } from '@/components/offline-h5-container/offline-h5-project';

export function createChatOfflineH5Request(agentId: string, conversationId: string, pType: string = ""): UTSJSONObject {
  let route = `/subpackages/pages/agent-detail/agent-detail?id=${encodeURIComponent(agentId)}`;
  if (conversationId.length > 0) route = `${route}&conversationId=${encodeURIComponent(conversationId)}`;
  if (pType.length > 0) route = `${route}&pType=${encodeURIComponent(pType)}`;
  route = `${route}&statusBarHeight=${getStatusBarHeight()}`;
  return buildProjectOfflineH5Request(route, `chat:${agentId}:${conversationId}`);
}

export function createChatWarmupRequest(): UTSJSONObject {
  const request = buildProjectOfflineH5Request(OFFLINE_H5_BOOTSTRAP_ROUTE, 'warmup');
  // 预热只做本地：包缺失/加载失败时不回退远程，避免后台悄悄消耗流量
  request['remoteUrl'] = '';
  return request;
}

export function getChatH5EntryUrl(agentId: string, conversationId: string, pType: string = ""): string {
  const request = createChatOfflineH5Request(agentId, conversationId, pType);
  const key = request['preferLocal'] == true ? 'localUrl' : 'remoteUrl';
  return `${request[key]}`;
}
