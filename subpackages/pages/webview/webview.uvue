<template>
  <view class="webview-page page-container">
    <!-- #ifdef H5 || WEB || APP -->
    <!-- Web 与 App 统一使用自定义导航栏；安全区覆盖 Android 状态栏和 iOS 刘海区域。 -->
    <custom-nav-bar
      class="webview-nav"
      :title="displayPageTitle"
      :subtitle="displayPageHost"
      :has-safety-zone="true"
    >
      <!-- 密度类尺寸 px 定值（22px = 44rpx @375），折叠屏展开/宽屏不随屏宽放大 -->
      <template v-slot:left>
        <view class="webview-back" @click="onBackClick">
          <svg-icon name="icon-X" size="22" unit="px" />
        </view>
      </template>
      <template v-slot:right>
        <svg-icon
          name="icon-More"
          size="22"
          unit="px"
          @click="handleShare"
        />
      </template>
    </custom-nav-bar>
    <!-- #endif -->

    <view class="webview-content">
      <web-view
        class="web-view"
        v-if="url.length != 0"
        :src="url"
        id="webview"
        <!-- #ifndef APP -->
        @error="handleWebviewError"
        <!-- #endif -->
        @load="handleWebviewLoad"
        @message="handleWebviewMessage"
      ></web-view>
      <!-- #ifdef APP -->
      <!-- 不可见占位：Android 内容区只有 web-view 时会走全屏原生层，createWebviewContext 拿不到，token 注入会失效。 -->
      <view class="webview-placeholder" />
      <!-- #endif -->
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { switchMainTab } from "@/utils/mainTabNavigation";

  import { computed, ref, watch } from "vue";
  // #ifdef APP
  import { getCurrentInstance } from "vue";
  // #endif
  import { removeQueryCompat, isHttpUrl } from "@/utils/common";
  import { NO_LOGIN_CHECK_URL } from "@/constants/config";
  // #ifdef APP
  import { getApiBaseUrl } from "@/constants/config";
  // #endif
  import { apiUserTicketCreate } from "@/servers/agentDev";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { onLoad, onUnload, onBackPress, onShareAppMessage, onAddToFavorites } from "@dcloudio/uni-app";
  import { isRepoLibraryPath } from "@/utils/repoLibraryLink";
  import { isTabPage } from "@/utils/commonBusiness";
  // #ifdef APP-IOS
  // iOS：返回时须显式恢复 TabBar（常驻壳关壳可能 hide 过）
  import { navigateBackByBackUrl } from "@/utils/commonBusiness";
  // #endif
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  // App 端内嵌 H5 字体放大修复：Android 强制 webview textZoom = 100%（iOS 无此问题，自动跳过）
  import { fixAppWebviewTextZoom } from "@/subpackages/utils/webviewTextZoom";
  // #ifdef APP
  import {
    appWebViewGoBack,
    appWebViewPageTitle,
    appWebViewPageUrl,
  } from "@/subpackages/utils/appWebViewHistory";
  // #endif
  // #ifdef APP-IOS
  import {
    appWebViewCanGoBack,
    enableAppWebViewBackGesture,
  } from "@/subpackages/utils/appWebViewHistory";
  // #endif
  import { useShareLink, ShareLinkOptions } from "@/hooks/useShareLink";
  import { buildShareOpenUrl, chooseShareTarget, ShareTarget } from "@/utils/appShare";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
  // uvue 中直接调用 t() 会因缺少 params 形参报错，这里包一层单参版本

  const url = ref<string>("");
  const method = ref<string>("");
  const data_type = ref<string>("");
  const request_id = ref<string>("");
  const pageTitle = ref<string>("");
  /** 当前地址的域名。加载完成前单独居中显示。 */
  const pageHost = ref<string>("");
  /** 内嵌页 document.title。读到之后才显示在域名上方。 */
  const embeddedTitle = ref<string>("");
  let navSyncTimer: number = 0;
  // 资料库页要写入 localStorage 的登录 token。非资料库、未取到票据时为空。
  // 小程序 web-view 不能 evalJS，票据只走地址上的 _ticket。
  let repoPageTicket = "";
  // #ifdef APP
  const instance = getCurrentInstance();
  let webViewContext: WebviewContext | null = null;
  let repoCookieTimer: number = 0;
  let repoCookieAttempts = 0;
  // #endif
  // #ifdef APP-IOS
  /** iOS 页面侧滑是否已按网页 canGoBack 锁住。-1 表示还没设置过。 */
  let iosSwipeLocked = -1;
  let iosSwipeSyncTimer: number = 0;
  // #endif

  /** 与模板 web-view id 一致，供原生后退栈查询。 */
  const WEBVIEW_ELEMENT_ID = "webview";

  const displayPageTitle = computed((): string => {
    if (embeddedTitle.value.length > 0) {
      return embeddedTitle.value;
    }
    if (pageHost.value.length > 0) {
      return pageHost.value;
    }
    return pageTitle.value.length > 0 ? pageTitle.value : t("Mobile.Webview.defaultTitle");
  });

  /** 只有读到网页标题后才把域名放到第二行，加载前标题位本身就是域名。 */
  const displayPageHost = computed((): string => {
    return embeddedTitle.value.length > 0 ? pageHost.value : "";
  });

  /** 去掉协议后，截出主机名，不带端口、路径和账号。 */
  const stripHost = (raw: string): string => {
    let value = raw.trim();
    const schemeIdx = value.indexOf("://");
    if (schemeIdx >= 0) {
      value = value.substring(schemeIdx + 3);
    }
    const slash = value.indexOf("/");
    if (slash >= 0) {
      value = value.substring(0, slash);
    }
    const query = value.indexOf("?");
    if (query >= 0) {
      value = value.substring(0, query);
    }
    const hash = value.indexOf("#");
    if (hash >= 0) {
      value = value.substring(0, hash);
    }
    const at = value.indexOf("@");
    if (at >= 0) {
      value = value.substring(at + 1);
    }
    const colon = value.indexOf(":");
    if (colon >= 0) {
      value = value.substring(0, colon);
    }
    return value;
  };

  /**
   * 从地址里取出主机名，不带协议、端口和路径。
   * 站内相对路径用当前站点或接口域名。
   */
  const hostOf = (raw: string): string => {
    const value = raw.trim();
    if (value.length == 0) {
      return "";
    }
    if (value.indexOf("://") < 0 && value.indexOf("/") == 0) {
      // #ifdef H5 || WEB
      return `${window.location.host}`;
      // #endif
      // #ifdef APP
      return stripHost(getApiBaseUrl());
      // #endif
      // #ifdef MP-WEIXIN
      return "";
      // #endif
    }
    return stripHost(value);
  };

  /** 加载中 WebView 的 title 经常就是整段地址，这种情况不拿来当标题。 */
  const isDocumentTitle = (title: string, pageUrl: string): boolean => {
    const text = title.trim();
    if (text.length == 0) {
      return false;
    }
    if (text.indexOf("http://") == 0 || text.indexOf("https://") == 0) {
      return false;
    }
    if (pageUrl.length > 0 && text == pageUrl) {
      return false;
    }
    const host = hostOf(pageUrl.length > 0 ? pageUrl : text);
    return host.length == 0 || text != host;
  };

  const applyNavTitle = (title: string): void => {
    if (title == embeddedTitle.value) {
      return;
    }
    embeddedTitle.value = title;
    if (title.length > 0) {
      uni.setNavigationBarTitle({ title: title });
    }
  };

  /**
   * 读取内嵌页标题和当前地址。
   * App 走原生 WebView；H5 只在同源 iframe 可读，跨域时保持域名单行。
   */
  const syncEmbeddedNav = (): void => {
    let nextUrl = "";
    let nextTitle = "";
    // #ifdef APP
    nextUrl = appWebViewPageUrl(WEBVIEW_ELEMENT_ID);
    nextTitle = appWebViewPageTitle(WEBVIEW_ELEMENT_ID);
    // #endif
    // #ifdef H5 || WEB
    try {
      const frames = document.getElementsByTagName("iframe");
      if (frames.length > 0) {
        const frame = frames[frames.length - 1];
        const doc = frame.contentDocument;
        if (doc != null) {
          nextTitle = doc.title != null ? `${doc.title}` : "";
          nextUrl = frame.contentWindow != null ? `${frame.contentWindow.location.href}` : "";
        }
      }
    } catch (_eFrame) {
      nextTitle = "";
      nextUrl = "";
    }
    // #endif
    const hostSource = nextUrl.length > 0 ? nextUrl : url.value;
    const host = hostOf(hostSource);
    if (host.length > 0) {
      pageHost.value = host;
    }
    if (isDocumentTitle(nextTitle, hostSource)) {
      applyNavTitle(nextTitle.trim());
    }
  };

  const stopEmbeddedNavSync = (): void => {
    if (navSyncTimer != 0) {
      clearInterval(navSyncTimer);
      navSyncTimer = 0;
    }
  };

  const startEmbeddedNavSync = (): void => {
    syncEmbeddedNav();
    if (navSyncTimer != 0) {
      return;
    }
    navSyncTimer = setInterval((): void => {
      syncEmbeddedNav();
    }, 500) as number;
  };

  watch(url, (value: string): void => {
    const host = hostOf(value);
    if (host.length > 0) {
      pageHost.value = host;
    }
    embeddedTitle.value = "";
  });

  /**
   * 还原 webview 的 url 参数。
   * 资料库链接会编码两次，避开 iOS 对整段路由的一次 decodeURI；
   * 其它调用方仍是编码一次或已是绝对地址，循环解开到 http(s) 或站内路径即可。
   */
  const unwrapWebviewUrl = (raw: string): string => {
    let value = raw.trim();
    for (let i = 0; i < 2; i++) {
      if (
        value.indexOf("http://") == 0 ||
        value.indexOf("https://") == 0 ||
        (value.indexOf("/") == 0 && value.indexOf("//") != 0)
      ) {
        return value;
      }
      if (value.indexOf("%") < 0) {
        break;
      }
      try {
        const next = decodeURIComponent(value);
        const nextText = next != null ? `${next}` : "";
        if (nextText.length == 0 || nextText == value) {
          break;
        }
        value = nextText;
      } catch (_e) {
        break;
      }
    }
    return value;
  };

  // 获取查询参数
  const getQueryParams = (url: string): UTSJSONObject => {
    const parts = url.split("?");
    const queryString = parts.length > 1 ? parts[1] : "";
    const pairs = queryString.split("&");
    const params = new UTSJSONObject();
    for (let i = 0; i < pairs.length; i++) {
      const pair = pairs[i];
      if (pair.length == 0) {
        continue;
      }
      const kv = pair.split("=");
      const k = kv.length > 0 ? kv[0] : "";
      const v = kv.length > 1 ? kv[1] : "";
      const decK = decodeURIComponent(k);
      const decV = decodeURIComponent(v);
      const keyStr = decK != null ? decK : "";
      const valStr = decV != null ? decV : "";
      params[keyStr] = valStr;
    }
    return params;
  };

  // 判断是否需要调用接口
  const isNeedCallApi = computed((): boolean => {
    return (
      method.value == "browser_navigate_page" &&
      data_type.value.length > 0 &&
      request_id.value.length > 0
    );
  });

  // WebView 加载错误处理
  const handleWebviewError = (e: any) => {
    console.error("WebView 加载错误:", e);
    uni.showToast({
      title: t("Mobile.Webview.loadFailed"),
      icon: "none",
      duration: 2000,
    });
  };

  /** 本地登录 token。鸿蒙清空时会写成空串。 */
  const readCachedAccessToken = (): string => {
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    if (tokenRaw == null) {
      return "";
    }
    return `${tokenRaw}`.trim();
  };

  /**
   * 从地址里取出完整 `_ticket`。
   * 通用查询解析按第一个 `=` 截断，票据里的填充符会被切掉。
   */
  const readQueryTicket = (raw: string): string => {
    const hashIdx = raw.indexOf("#");
    const withoutHash = hashIdx >= 0 ? raw.substring(0, hashIdx) : raw;
    const marker = "_ticket=";
    const idx = withoutHash.indexOf(marker);
    if (idx < 0) {
      return "";
    }
    const start = idx + marker.length;
    const amp = withoutHash.indexOf("&", start);
    const encoded = amp >= 0 ? withoutHash.substring(start, amp) : withoutHash.substring(start);
    if (encoded.length == 0) {
      return "";
    }
    try {
      const decoded = decodeURIComponent(encoded);
      return decoded != null ? `${decoded}` : encoded;
    } catch (_e) {
      return encoded;
    }
  };

  /**
   * 记下资料库页的 ticket，供打开后写入登录 token。
   * 其它页面只把 _ticket 放在地址上。
   */
  const rememberRepoPageTicket = (pageUrl: string, ticket: string): void => {
    let value = ticket.trim();
    const hashIdx = value.indexOf("#");
    if (hashIdx >= 0) {
      value = value.substring(0, hashIdx).trim();
    }
    if (value.length == 0 || isRepoLibraryPath(pageUrl) == false) {
      repoPageTicket = "";
      return;
    }
    repoPageTicket = value;
  };

  // #ifdef APP
  const stopRepoTicketCookieInject = (): void => {
    if (repoCookieTimer != 0) {
      clearInterval(repoCookieTimer);
      repoCookieTimer = 0;
    }
  };

  /**
   * 在已打开的资料库文档上写入登录态：
   * localStorage 的 ACCESS_TOKEN、内嵌标记。
   * 地址还不是资料库页时跳过。
   * 返回 true 只表示拿到 context 且 evalJS 没有抛错。
   */
  const injectRepoTicketCookieOnce = (): boolean => {
    if (repoPageTicket.length == 0) {
      return false;
    }
    let ctx: WebviewContext | null = webViewContext;
    if (ctx == null) {
      try {
        ctx = uni.createWebviewContext(
          "webview",
          instance != null ? instance.proxy : null,
        );
        webViewContext = ctx;
      } catch (_e) {
        return false;
      }
      if (ctx == null) {
        return false;
      }
    }
    const cachedToken = readCachedAccessToken();
    const tokenToInject = cachedToken.length > 0 ? cachedToken : repoPageTicket;
    const ticketLiteral = JSON.stringify(tokenToInject);
    // 资料库文档不在 /m/ 下，相对路径 ./static 会落到 /repo/doc/，改为站点 /m/ 下的 JSSDK。
    const sdkLiteral = JSON.stringify(`${getApiBaseUrl()}/m/static/uni.webview.1.5.5.js`);
    try {
      ctx.evalJS(
        `try{var h=location.pathname||'';if(h.indexOf('/repo/')!=0){return;}try{if(!window.uni||!uni.webView){var s=document.createElement('script');s.src=${sdkLiteral};document.head.appendChild(s);}}catch(e){}try{localStorage.setItem('ACCESS_TOKEN',${ticketLiteral});}catch(e){}window.__nuwaxSetAppEmbedded&&window.__nuwaxSetAppEmbedded();}catch(e){}`,
      );
    } catch (_e) {
      return false;
    }
    return true;
  };

  /**
   * 文档加载后短轮询写入登录态。
   * 加载过程中的 evalJS 可能落在中间文档上，页面内跳转后需要再写一次。
   */
  const startRepoTicketCookieInject = (): void => {
    stopRepoTicketCookieInject();
    webViewContext = null;
    if (repoPageTicket.length == 0) {
      return;
    }
    repoCookieAttempts = 0;
    injectRepoTicketCookieOnce();
    repoCookieTimer = setInterval((): void => {
      repoCookieAttempts++;
      injectRepoTicketCookieOnce();
      if (repoCookieAttempts >= 12) {
        stopRepoTicketCookieInject();
      }
    }, 250) as number;
  };
  // #endif

  const injectRepoTicketCookie = (): void => {
    // #ifdef APP
    startRepoTicketCookieInject();
    // #endif
  };

  /**
   * iOS：网页还能后退时关掉页面侧滑，边缘手势交给 WKWebView；
   * 已经在第一页时恢复页面侧滑，右滑离开本页。
   * canGoBack 会随网页跳转变化，且 pushState 不一定触发 @load，因此页面显示期间轮询。
   */
  const syncIosWebViewSwipe = (): void => {
    // #ifdef APP-IOS
    enableAppWebViewBackGesture(WEBVIEW_ELEMENT_ID);
    const canGoBack = appWebViewCanGoBack(WEBVIEW_ELEMENT_ID);
    const locked = canGoBack ? 1 : 0;
    if (iosSwipeLocked == locked) {
      return;
    }
    const pages = getCurrentPages();
    if (pages.length == 0) {
      return;
    }
    const style = new UTSJSONObject();
    style["disableSwipeBack"] = canGoBack;
    try {
      pages[pages.length - 1].setPageStyle(style);
      iosSwipeLocked = locked;
    } catch (_eStyle) {
      iosSwipeLocked = -1;
    }
    // #endif
  };

  const startIosWebViewSwipeSync = (): void => {
    // #ifdef APP-IOS
    syncIosWebViewSwipe();
    if (iosSwipeSyncTimer != 0) {
      return;
    }
    iosSwipeSyncTimer = setInterval((): void => {
      syncIosWebViewSwipe();
    }, 250) as number;
    // #endif
  };

  const stopIosWebViewSwipeSync = (): void => {
    // #ifdef APP-IOS
    if (iosSwipeSyncTimer != 0) {
      clearInterval(iosSwipeSyncTimer);
      iosSwipeSyncTimer = 0;
    }
    // #endif
  };

  // WebView 加载完成
  const handleWebviewLoad = (e: any) => {
    // Android 内嵌 H5 字体放大修复：@load 时 WebView 必已存在，立即复位 textZoom
    fixAppWebviewTextZoom();
    syncIosWebViewSwipe();
    syncEmbeddedNav();
    if (repoPageTicket.length > 0) {
      injectRepoTicketCookie();
    }
    // #ifdef MP-WEIXIN || APP
    if (isNeedCallApi.value) {
      uni.showLoading({
        title: t("Mobile.Webview.aiReading"),
        mask: true,
      });
      setTimeout(() => {
        uni.navigateBack({ delta: 1 });
        uni.hideLoading();
      }, 4000);
    }
    // #endif
  };

  /**
   * WebView 消息处理
   *
   * ⚠️ 重要：微信小程序的 @message 不会实时触发！
   * 触发时机：
   * 1. 用户点击返回按钮（最常用）
   * 2. 组件销毁时
   * 3. 分享时
   *
   * 调试方法：
   * 1. 网页发送消息后，点击小程序的返回按钮
   * 2. 查看控制台是否有 "收到消息" 日志
   * 3. 如果没有，检查网页端代码是否正确调用 wx.miniProgram.postMessage
   */
  const handleWebviewMessage = (e: UniWebViewMessageEvent): void => {
    // #ifdef MP-WEIXIN || APP
    // UniWebViewMessageEvent 是原生强类型对象，Android 上不可整体强转 UTSJSONObject。
    // detail.data 是 postMessage 消息数组，只取最后一条的 html。
    const messages = e.detail.data;
    if (isNeedCallApi.value && messages.length > 0) {
      const lastMsg = messages[messages.length - 1];
      uni.$emit(
        "browser_navigate_page",
        {
          method: method.value,
          data_type: data_type.value,
          html: lastMsg["html"],
          request_id: request_id.value,
        } as UTSJSONObject,
      );
    } else {
      console.warn("消息数组为空");
    }
    // #endif
  };

  /**
   * 清理当前 webview 地址：去除 _ticket / jump_type 后重新标记为外部跳转来源。
   * 小程序转发（拼进内部路径）与「复制链接/系统分享」（需要真实可直接打开的外链）共用同一份清理逻辑。
   */
  const buildCleanShareTargetUrl = (): string => {
    const newUrl = removeQueryCompat(url.value, ["_ticket", "jump_type"]);
    const andStr = newUrl.includes("?") ? "&" : "?";
    return newUrl + andStr + "jump_type=outer";
  };

  /**
   * 获取分享链接（用于小程序转发/收藏路径拼接，需 encode 后作为查询参数值）
   */
  const getSharingLink = () => {
    return encodeURIComponent(buildCleanShareTargetUrl());
  };

  /**
   * 分享链接：中转页内嵌当前网页。
   * 文件预览只带 sk，避免把整段文件地址再嵌进链接后被飞书截断。
   * 微信里点「打开 App」只提示改用浏览器；其它应用里可以直接看内容，并唤起女娲。
   */
  const readQueryValue = (raw: string, key: string): string => {
    const mark = key + "=";
    const idx = raw.indexOf(mark);
    if (idx < 0) return "";
    const start = idx + mark.length;
    const amp = raw.indexOf("&", start);
    const hash = raw.indexOf("#", start);
    // indexOf 在 Android 上是 Number，不能赋给由 length 推出的 Int。
    let encoded = "";
    if (amp >= 0 && (hash < 0 || amp <= hash)) {
      encoded = raw.substring(start, amp);
    } else if (hash >= 0) {
      encoded = raw.substring(start, hash);
    } else {
      encoded = raw.substring(start);
    }
    try {
      const decoded = decodeURIComponent(encoded);
      return decoded != null ? `${decoded}` : encoded;
    } catch (_e) {
      return encoded;
    }
  };

  const getShareUrl = async (): Promise<string> => {
    const target = new ShareTarget();
    target.title = displayPageTitle.value;
    const cleanUrl = buildCleanShareTargetUrl();
    const shareKey = readQueryValue(cleanUrl, "sk");
    if (cleanUrl.indexOf("file-preview.html") >= 0 && shareKey.length > 0) {
      target.kind = "file";
      target.sk = shareKey;
      const schemeIdx = cleanUrl.indexOf("://");
      const hostStart = schemeIdx >= 0 ? schemeIdx + 3 : -1;
      const pathIdx = hostStart >= 0 ? cleanUrl.indexOf("/", hostStart) : -1;
      const origin = pathIdx > 0 ? cleanUrl.substring(0, pathIdx) : "";
      if (origin.indexOf("http://") == 0 || origin.indexOf("https://") == 0) {
        target.pageUrl = origin + "/static/file-preview.html?sk=" + shareKey;
      }
    } else {
      target.kind = "page";
      target.pageUrl = cleanUrl;
    }
    const shareUrl = buildShareOpenUrl(target);
    if (shareUrl.indexOf("http://") != 0 && shareUrl.indexOf("https://") != 0) {
      throw new Error(t("Mobile.Share.shareFailed"));
    }
    return shareUrl;
  };

  // 分享交互统一由 useShareLink 提供，与 file-preview-page 共用同一套逻辑：
  // H5/WEB 点击分享直接复制链接；App 端唤起系统分享面板。模板无需渲染任何分享面板组件。
  // 入参须 new + 逐字段赋值（不能传对象字面量，Android UTS 编译器会把字面量误推导成
  // UTSJSONObject 而报参数类型不匹配，与 usePageResume 的 PageResumeOptions 同一避坑写法）。
  const shareTitle = (): string => {
    const title = displayPageTitle.value;
    if (title.length == 0) {
      return title;
    }
    return "【" + title + "】";
  };

  const shareOptions = new ShareLinkOptions();
  shareOptions.getShareTitle = () => shareTitle();
  shareOptions.getShareUrl = getShareUrl;
  const share = useShareLink(shareOptions);
  const handleShareOutside = share.handleShare;
  const handleShare = async (): Promise<void> => {
    try {
      const shareUrl = await getShareUrl();
      chooseShareTarget(shareTitle(), shareUrl, () => {
        handleShareOutside();
      });
    } catch (_error) {
      uni.showToast({
        title: t("Mobile.Share.shareFailed"),
        icon: "none",
      });
    }
  };

  /** 网页还有上一页时先退网页。返回 true 表示已经消费这次返回。 */
  const consumeWebViewBack = (): boolean => {
    // #ifdef APP
    if (appWebViewGoBack(WEBVIEW_ELEMENT_ID)) {
      syncIosWebViewSwipe();
      return true;
    }
    // #endif
    return false;
  };

  /** 导航栏关闭：不论网页内部跳了多少层，直接离开本页。侧滑和系统返回仍走 consumeWebViewBack。 */
  const onBackClick = () => {
    const pages = getCurrentPages();
    if (pages.length > 1) {
      uni.navigateBack({ delta: 1 });
      return;
    }

    // 栈只剩本页（H5 刷新 / 直接打开）：按 storage 里的来源落地
    const backUrlRaw = uni.getStorageSync("backUrl");
    const backUrl = backUrlRaw != null ? `${backUrlRaw}` : "";
    const toUrl =
      backUrl.length > 0 && backUrl != "/" ? backUrl : "/pages/message/message";

    // #ifdef APP-IOS
    // iOS：常驻壳关壳时 TabBar 可能仍被 hide，回 Tab 前须显式恢复
    navigateBackByBackUrl(toUrl);
    // #endif
    // #ifndef APP-IOS
    if (isTabPage(toUrl)) {
      switchMainTab({ url: toUrl });
    } else {
      uni.redirectTo({ url: toUrl });
    }
    // #endif
    uni.removeStorageSync("backUrl");
  };

  // 初始化加载
  const onLoadInit = async (params: OnLoadOptions) => {
    // 外部站点自带鉴权参数时传 noTicket=1，避免把主站 _ticket 拼给第三方域名
    const noTicketVal = params["noTicket"];
    const noTicket = noTicketVal != null && `${noTicketVal}` == "1";

    const urlVal = params["url"];
    if (urlVal == null) {
      return;
    }
    const urlStr = `${urlVal}`;
    const currentUrl = unwrapWebviewUrl(urlStr);
    if (currentUrl.length == 0) {
      return;
    }
    const queryParams = getQueryParams(currentUrl);

    // 设置页面标题：优先取本页路由参数 title（外部链接不便在目标 URL 上拼 query），
    // 其次取目标 URL 自带的 title（站内页沿用原有约定），都没有才用默认标题
    const routeTitleRaw = params["title"];
    let routeTitle = "";
    if (routeTitleRaw != null) {
      // 调用方按路由约定做过 encodeURIComponent，这里与 url 参数一致地解码
      const decodedTitle = decodeURIComponent(`${routeTitleRaw}`);
      routeTitle = decodedTitle != null ? decodedTitle : "";
    }
    const titleRaw = queryParams["title"];
    const title =
      routeTitle.length > 0
        ? routeTitle
        : (titleRaw != null ? `${titleRaw}` : t("Mobile.Webview.defaultTitle"));
    pageTitle.value = title;
    uni.setNavigationBarTitle({
      title: title,
    });

    // #ifdef H5 || WEB
    if (isHttpUrl(currentUrl)) {
      url.value = currentUrl;
    } else if (`${window.location.protocol}` == "file:") {
      // 本地包的 origin 是 file://。相对路径拼上去会打开包内 index，也就是 App 首页。
      return;
    } else {
      url.value = window.location.origin + currentUrl;
    }
    // #endif

    // #ifdef MP-WEIXIN || APP
    // 判断当前url是否不需要登录检查
    if (noTicket || NO_LOGIN_CHECK_URL.includes(currentUrl)) {
      url.value = currentUrl;
      if (isRepoLibraryPath(currentUrl)) {
        console.log(`[repo-link] preview src=${currentUrl}`);
      }
      return;
    }

    const methodVal = queryParams["method"];
    if (methodVal != null) {
      method.value = `${methodVal}`;
    }
    const dtVal = queryParams["data_type"];
    if (dtVal != null) {
      data_type.value = `${dtVal}`;
    }
    const riVal = queryParams["request_id"];
    if (riVal != null) {
      request_id.value = `${riVal}`;
    }

    // 判断是否存在 _ticket
    const ticketVal = queryParams["_ticket"];
    if (ticketVal != null) {
      url.value = currentUrl;
      if (isRepoLibraryPath(currentUrl)) {
        const existingTicket = readQueryTicket(currentUrl);
        rememberRepoPageTicket(
          currentUrl,
          existingTicket.length > 0 ? existingTicket : `${ticketVal}`,
        );
        injectRepoTicketCookie();
      }
    } else {
      // 暂存当前url（仅微信小程序读取 globalThis.appConfig，APP 端无读取方）
      // #ifdef MP-WEIXIN
      globalThis.appConfig.redirectUrl = urlStr; // 未解码
      // #endif
      const ticketResult = await apiUserTicketCreate();
      if (ticketResult.code == SUCCESS_CODE && ticketResult.data != null) {
        // 带锚点(#fragment)的 URL 须把 _ticket 插在 # 之前，拼在末尾目标页读不到
        const hashIdx = currentUrl.indexOf("#");
        const baseUrl = hashIdx >= 0 ? currentUrl.substring(0, hashIdx) : currentUrl;
        const hashStr = hashIdx >= 0 ? currentUrl.substring(hashIdx) : "";
        const andStr = baseUrl.includes("?") ? "&" : "?";
        const createdTicket = `${ticketResult.data}`;
        url.value = baseUrl + andStr + `_ticket=${createdTicket}` + hashStr;
        if (isRepoLibraryPath(currentUrl)) {
          rememberRepoPageTicket(currentUrl, createdTicket);
          injectRepoTicketCookie();
        }
      } else {
        // ticket 获取失败也加载原地址：web-view 仅在 url 非空时挂载，
        // 不兜底会整页白屏（目标站自身的登录/错误页至少可见、可操作）。
        // 仅资料库页改用本地登录 token 写入 localStorage。
        url.value = currentUrl;

        // 资料库链接地址需要注入token信息到localStorage中，用于验证用户身份和权限。注入
        if (isRepoLibraryPath(currentUrl)) {
          const cachedToken = readCachedAccessToken();
          if (cachedToken.length > 0) {
            rememberRepoPageTicket(currentUrl, cachedToken);
            injectRepoTicketCookie();
          }
        }
      }
    }
    // #endif
  };

  onLoad((params: OnLoadOptions) => {
    onLoadInit(params);
    fixAppWebviewTextZoom();
    startIosWebViewSwipeSync();
    startEmbeddedNavSync();
  });

  // 导航栏返回不走 onBackPress。系统返回键、Android/鸿蒙侧滑走这里。
  // uni.navigateBack 会再次进入本回调，from 为 navigateBack 时必须放行，否则离页被取消。
  // #ifdef APP
  onBackPress((options: OnBackPressOptions): boolean => {
    if (options.from == "navigateBack") {
      return false;
    }
    return consumeWebViewBack();
  });
  // #endif

  onUnload(() => {
    // #ifdef APP
    stopRepoTicketCookieInject();
    // #endif
    stopIosWebViewSwipeSync();
    stopEmbeddedNavSync();
  });

  // #ifdef MP-WEIXIN
  // 转发给朋友
  onShareAppMessage(() => {
    const params = getQueryParams(url.value);
    const titleVal = params["title"];
    return {
      title:
        titleVal != null && `${titleVal}`.length > 0
          ? "【" + `${titleVal}` + "】"
          : "【" + t("Mobile.Common.appName") + "】",
      path: "/subpackages/pages/webview/webview?url=" + getSharingLink(),
    } as UTSJSONObject;
  });

  // 收藏
  onAddToFavorites(() => {
    const params = getQueryParams(url.value);
    const titleVal = params["title"];
    return {
      title:
        titleVal != null && `${titleVal}`.length > 0
          ? "【" + `${titleVal}` + "】"
          : "【" + t("Mobile.Common.appName") + "】",
      query: "url=" + getSharingLink(),
    } as UTSJSONObject;
  });
  // #endif
</script>

<style lang="scss" scoped>
  .webview-page {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .webview-nav {
    flex-shrink: 0;
    position: relative;
    z-index: 20;
    background: #fff;
  }

  .webview-back {
    /* px 定值（原 64rpx/-10rpx），折叠屏展开不随屏宽放大 */
    width: 32px;
    height: 32px;
    margin-left: -5px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .webview-content {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .web-view {
    width: 100%;
    height: 100%;
  }

  .webview-placeholder {
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
