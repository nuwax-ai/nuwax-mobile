<template>
  <view class="agent-icon" :style="iconStyle">
    <view class="agent-icon-mask">
      <image
        v-if="currentIcon.length > 0"
        :src="currentIcon"
        class="agent-icon-image"
        mode="aspectFill"
        :fade-show="false"
        :alt="alt"
        @error="handleImageError"
      />
      <image
        v-if="pendingIcon.length > 0"
        :src="pendingIcon"
        :class="pendingIconVisible
          ? 'agent-icon-image agent-icon-image-pending agent-icon-image-visible'
          : 'agent-icon-image agent-icon-image-pending'"
        mode="aspectFill"
        :fade-show="false"
        :alt="alt"
        @load="handlePendingImageLoad"
        @error="handlePendingImageError"
      />
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, watch } from "vue";
  import defaultAgentIcon from "@/static/assets/agent_image.png";
  import { resolveAppSvgUrl } from "@/utils/remoteSvgImage";

  const props = defineProps({
    icon: {
      type: String,
      required: true,
    },
    alt: {
      type: String,
      default: null,
    },
    size: {
      type: Number,
      default: 96,
    },
    // 勿命名为 radius：Android 会把 :radius 当成原生/样式属性，Vue prop 收不到，一直走默认圆形。
    iconRadius: {
      type: Number,
      default: -1,
    },
    marginRight: {
      type: Number,
      default: 24,
    },
    /**
     * size/iconRadius/marginRight 的单位：缺省 rpx（全仓既有调用方口径，随屏宽缩放）；
     * "px" 供已 px 化的页面用（密度类定值，宽屏/折叠屏展开不放大——
     * 传值时数值记得 ÷2 保持 375 手机像素等值）
     */
    unit: {
      type: String,
      default: "rpx",
    },
  });

  /** CSS 单位（unit prop 归一） */
  function cssUnit(): string {
    return props.unit == "px" ? "px" : "rpx";
  }

  /**
   * 圆角 CSS 值。iconRadius &lt; 0 表示圆形。
   * 不用 50%：Android 上 class 的 50% 会把图片裁成圆，且父级 overflow 不一定裁切 image。
   */
  function radiusCss(): string {
    if (props.iconRadius >= 0) {
      return `${props.iconRadius}${cssUnit()}`;
    }
    return `${Math.floor(props.size / 2)}${cssUnit()}`;
  }

  const clipStyle = computed((): string => {
    return `border-radius:${radiusCss()};`;
  });

  const iconStyle = computed((): string => {
    return `width:${props.size}${cssUnit()};height:${props.size}${cssUnit()};margin-right:${props.marginRight}${cssUnit()};${clipStyle.value}`;
  });

  /**
   * App 端 SVG 光栅化接口 resolveAppSvgUrl 按 rpx 口径换算物理像素（×windowWidth/750）。
   * px 调用方须折回 rpx 等价值（cssPx × 750/windowWidth），保证光栅尺寸与 CSS 盒一致。
   */
  function rasterSize(css: number): number {
    if (props.unit != "px") {
      return css;
    }
    let win = 375;
    try {
      const w = uni.getWindowInfo().windowWidth;
      if (w > 0) {
        win = w;
      }
    } catch (_e) {
      // 保持兜底 375
    }
    return (css * 750) / win;
  }

  // App 端远程 SVG 需按容器实际尺寸各自解析；H5/小程序 resolveAppSvgUrl 原样透传。
  // raw* 保存未解析的原始值用于比对，currentIcon/pendingIcon 保存解析后的 src。
  //
  // currentIcon 初始必须为空串（解析完成前不给 <image> 任何 src）：
  // iOS 端在 <image> 的 src 被替换时会取消上一张的在途请求，并对该 <image> 补发一次 error 事件；
  // 事件里拿不到是哪个 src 失败，handleImageError 会把「刚解析好的 data URL」误判为加载失败而换成默认图。
  // 表现：同一个远程 SVG 图标出现多次时，先渲染的几个（未命中缓存、真的发起过原图请求）显示默认图，
  // 后面命中 data URL 缓存的（微任务内直接给最终 src，没有被取消的请求）反而正常。Android 取消请求不报错，故只在 iOS 复现。
  const rawCurrentIcon = ref<string>(props.icon.length > 0 ? props.icon : defaultAgentIcon);
  const currentIcon = ref<string>("");
  const rawPendingIcon = ref<string>("");
  const pendingIcon = ref<string>("");
  /** pendingIcon 当前对应的原始地址：用于判定收到的 error 是否属于当前候选图（同上：iOS 换 src 会补发假 error） */
  const pendingResolvedFor = ref<string>("");
  const pendingIconVisible = ref<boolean>(false);
  // 异步解析竞态序号：保证过期的解析结果不会覆盖新目标
  let resolveSeq = 0;

  // 初始图标解析（挂载即执行；PNG/非 App 端微任务内透传完成，无闪烁）
  const applyInitialIcon = () : void => {
    const seq = ++resolveSeq;
    resolveAppSvgUrl(rawCurrentIcon.value, rasterSize(props.size), rasterSize(props.size)).then((resolved : string) => {
      if (seq == resolveSeq) {
        currentIcon.value = resolved;
      }
    });
  };
  applyInitialIcon();

  watch(
    () : string => props.icon,
    (icon : string) => {
      const nextIcon = icon.length > 0 ? icon : defaultAgentIcon;
      if (nextIcon == rawCurrentIcon.value) {
        pendingIconVisible.value = false;
        pendingIcon.value = "";
        rawPendingIcon.value = "";
        pendingResolvedFor.value = "";
        return;
      }
      if (nextIcon == rawPendingIcon.value) return;

      // 上一张候选图已经显示时，先将其提升为底图；它已完成解码，不会出现空白帧。
      if (pendingIconVisible.value && pendingIcon.value.length > 0) {
        currentIcon.value = pendingIcon.value;
        rawCurrentIcon.value = rawPendingIcon.value;
      }
      pendingIconVisible.value = false;
      rawPendingIcon.value = nextIcon;
      const seq = ++resolveSeq;
      resolveAppSvgUrl(nextIcon, rasterSize(props.size), rasterSize(props.size)).then((resolved : string) => {
        if (seq != resolveSeq || rawPendingIcon.value != nextIcon) return;
        pendingResolvedFor.value = nextIcon;
        pendingIcon.value = resolved;
      });
    },
  );

  const handleImageError = () => {
    // 尚未给出 src（解析中）时收到的 error 一定不属于当前图，忽略
    if (currentIcon.value.length == 0) return;
    if (rawCurrentIcon.value != defaultAgentIcon) {
      rawCurrentIcon.value = defaultAgentIcon;
      currentIcon.value = defaultAgentIcon;
    }
  };

  const handlePendingImageLoad = () => {
    const expectedIcon = props.icon.length > 0 ? props.icon : defaultAgentIcon;
    if (rawPendingIcon.value == expectedIcon) {
      pendingIconVisible.value = true;
    }
  };

  const handlePendingImageError = () => {
    // 候选图尚未解析出来，或这次 error 属于上一个候选目标（切图时被取消的旧请求），忽略：
    // 否则会把 rawPendingIcon 改成默认图，导致真正的解析结果因目标不匹配而被丢弃。
    if (pendingIcon.value.length == 0 || pendingResolvedFor.value != rawPendingIcon.value) return;
    pendingIconVisible.value = false;
    if (rawPendingIcon.value != defaultAgentIcon) {
      rawPendingIcon.value = defaultAgentIcon;
      pendingResolvedFor.value = defaultAgentIcon;
      pendingIcon.value = defaultAgentIcon;
    } else {
      rawPendingIcon.value = "";
      pendingResolvedFor.value = "";
      pendingIcon.value = "";
    }
  };
</script>

<style scoped lang="scss">
  .agent-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin-right: 12px;
    /* ★App 端不支持 border-radius: inherit：裁剪上提到外层，
       由外层自身的动态圆角（内联 50%/props.radius）直接裁剪子图 */
    overflow: hidden;

    .agent-icon-mask {
      position: relative;
      width: 100%;
      height: 100%;

      .agent-icon-image {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
      }

      .agent-icon-image-pending {
        opacity: 0;
        z-index: 2;
      }

      .agent-icon-image-visible {
        opacity: 1;
      }
    }
  }
</style>
