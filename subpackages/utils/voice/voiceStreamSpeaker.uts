/**
 * 边生成边播报器：AI 回复流式生成过程中，增量文本分句后喂给流式 TTS 会话顺序播报。
 *
 * 播放链路（一次 start 的流式会话，协议见 docs/app-asr-tts.md 5.1）：
 * - kickFeed 把合并后的句子喂给 ttsWebSocketPlayer.feedStreamText（多次 text，结束 flush）；
 * - 服务端边收边合成回 PCM，player 按阈值切段成 WAV，回调推入 readySegments；
 * - kickPlay 顺序 playSrcAndWait 播放；tts_end 后段队列排空即 finishRound（本地播完才算完）。
 *
 * 文本侧：
 * - 双通道（body / think）按「可朗读快照」增量消费（consumedSpeakable）；
 * - 流式用 speakableRawForStreaming，避免未闭合 agent-info 整段 hold 到 SSE 结束；
 * - 快照合并，处理循环串行。
 */
import { voiceConfig } from "./voiceConfig";
import { VoiceSettings } from "./voiceTypes";
import {
  cleanTextForSpeech,
  drainCompleteSentences,
  speakableRawForStreaming,
  needsFullSpeechClean,
} from "./textFilter";
import { ttsWebSocketPlayer } from "./ttsWebSocketPlayer";
import { audioPlayerManager } from "./audioPlayerManager";
import { clearMessageIdRewrite } from "./speechIdRewrite";

/** 单次喂入最短字数：更短以便更快出声 */
const MIN_UTTERANCE_CHARS = 2;

/**
 * 单次喂入文本上限（字符）。生产节流（FEED_PACING_BUFFER_MS=12s）后单块不宜过大：
 * 300 字 ≈ 1 分钟音频会把缓冲顶到 ~60s、停止浪费一整块合成。
 * 50 字 ≈ 2~3 句 / ~11s 音频，**≤ 节流阈值 12s**——喂一块缓冲峰值 ≈ 阈值+单块 ≈ 23s，
 * 波动收窄到 12~23s，既消除短句碎片（50/16 ≈ 3 倍任务削减），又保持「在途 2~3 句」。
 */
const MAX_MERGED_UTTERANCE_CHARS = 50;

/**
 * 等待段/会话结束的兜底超时：服务端中途停流（无新帧且不发 tts_end）时
 * 强制结束本轮，防止播放循环永久悬挂、图标不复位。
 */
const STREAM_SEGMENT_WAIT_TIMEOUT_MS = 15000;

/**
 * 生产节流阈值（原生流式）：播放缓冲（Android=enqueuedMs−writtenMs 写队列深度，单调可靠；
 * iOS/鸿蒙=enqueuedMs−playedMs）低于该值才喂下一句。
 * 服务端只合成「即将播放」的 2~3 句（单块 ≤50 字 ≈11s < 阈值）——中途停止浪费有限；
 * PCM 到达匹配播放节奏 → 队列不积压 → 长文本不再逼近背压上限、不丢帧。
 * 句长突发（长句一次回 10s+）会短暂超出该值，但受句子长度而非文本总长约束。
 * 注：该阈值只决定队列深度；喂入节奏由闸门B（等完整到达）钉死在播放速度上。
 */
const FEED_PACING_BUFFER_MS = 12000;
/** 生产节流轮询间隔：缓冲未达标时每 200ms 复查一次 */
const FEED_PACING_POLL_MS = 200;

/**
 * 闸门B超时（ms）：喂出上一句后等它「完整到达」的最长等待。
 * 节流闸门只能测到已送达播放器的音频，测不到服务端正在合成的——合成延迟窗口内
 * 连喂多句会一次性承诺几百秒音频、队列照样顶满背压丢帧。故放行下一句前须等上一句
 * 音频完整到达（enqueued 增长 ≥ 估算时长）；但估算可能偏高（标点/表格多）或服务端
 * 慢速送达，超时兜底放行，防停喂导致当前语音中断。
 */
const FEED_FULL_DELIVERY_TIMEOUT_MS = 5000;

/**
 * 首个 PCM 到达前最多喂入的句子数（启动上限）。
 * 播放器未创建（无音频反馈）时无缓冲可节流，但不能无限喂——手动播报全文已入队时，
 * 无上限会把整段文本一次性灌给后端。给到足够触发服务端开流的量即可（正常 1~2 句即回 PCM）。
 */
const MAX_STARTUP_FEED_UTTERANCES = 3;

/**
 * 超长句切块用的软停顿字符（与 textFilter.SOFT_BREAK_CHARS 对齐）。
 * 分句在 flush 模式只按强句末切、不限制整句长度（16 字上限仅作用于句末残留），
 * 文章里的整句可达 100+ 字；若整块喂入，节流闸门A放行后缓冲会堆到
 * 12s + 整块时长（30s+），喂入间隔随之逼近第三方 TTS 的 23s「无新文本」超时。
 */
const UTTERANCE_SOFT_BREAK_CHARS = "，,、；;\n";

/**
 * 超长单句按软停顿切回 ≤maxLen 的块（无软停顿处硬切，与 flush 尾段切分同法）。
 * 返回 ≥1 块，顺序与原文一致；调用方喂出首块、把其余块放回队首续喂。
 */
function splitOversizedUtterance(text: string, maxLen: number): string[] {
  const pieces: string[] = [];
  let tail = text.trim();
  while (tail.length > maxLen) {
    let cut = maxLen;
    for (let k = maxLen - 1; k >= 1; k--) {
      if (UTTERANCE_SOFT_BREAK_CHARS.indexOf(tail.charAt(k)) >= 0) {
        cut = k + 1;
        break;
      }
    }
    const piece = tail.substring(0, cut).trim();
    if (piece.length > 0) {
      pieces.push(piece);
    }
    tail = tail.substring(cut).trim();
  }
  if (tail.length > 0) {
    pieces.push(tail);
  }
  return pieces;
}

/** 会话切好的待播段（src + 估算时长） */
class ReadyUtterance {
  sentence: string = "";
  src: string = "";
  /** 合成完成时的 PCM 估算时长；深预取会覆盖 player 上的 lastSynthDurationMs */
  durationMs: number = 0;
}

/** 单通道（body/think）消费状态 */
class StreamChannel {
  /** 已消费的「可朗读快照」长度（相对 clean 后全文，而非 raw） */
  consumedSpeakable: number = 0;
  /** 已清洗但未分句的文本 */
  pending: string = "";
  /** 上次参与清洗的 source（speakableRaw / flush raw），用于增量清洗 */
  lastSource: string = "";
  /** 与 lastSource 对应的清洗结果缓存 */
  lastSpeakable: string = "";
}

/** 流式文本快照（onStreamChunk 入参，携带全量累计文本） */
class ChunkSnapshot {
  bodyText: string = "";
  thinkText: string = "";
  finished: boolean = false;
  /** 生成轮次（begin 自增），用于丢弃上一轮的滞留快照 */
  round: number = 0;
}

export class VoiceStreamSpeaker {
  private active: boolean = false;
  private messageId: string = "";
  private settings: VoiceSettings = new VoiceSettings();
  private bodyChannel: StreamChannel = new StreamChannel();
  private thinkChannel: StreamChannel = new StreamChannel();
  /** 待播句子队列（已分句、尚未合成/播放） */
  private pendingSentences: string[] = [];
  /** 全局分段序号（跨通道递增） */
  private segmentIndex: number = 0;
  /** 生成轮次计数 */
  private round: number = 0;
  /** 文本处理循环运行标记 */
  private processing: boolean = false;
  /** 播放循环运行标记 */
  private playLooping: boolean = false;
  /** kickPlay 内挂接：SSE 继续入队时唤醒预合成填缓冲 */
  private onPendingEnqueued: (() => void) | null = null;
  /** SSE 已结束（尾句入队后仍可能在播） */
  private streamFinished: boolean = false;
  /** 流式会话已结束（tts_end / flush 看门狗 / 停止；之后不再有新段） */
  private streamEnded: boolean = false;
  /** 会话切好的待播段（由会话回调推入，kickPlay 顺序消费） */
  private readySegments: ReadyUtterance[] = [];
  /** 文本喂入循环运行标记 */
  private feeding: boolean = false;
  /** 首个 PCM 到达前已喂入句数（begin 重置；首个 PCM 到达后不再参与节流） */
  private startupFeedCount: number = 0;
  /** 诊断：本轮累计已喂出字符数（feed 进度汇总用；begin 重置） */
  private totalFedChars: number = 0;
  /** 诊断：本轮待播文本总长度（speakPrepared 设置；流式未知为 0，仅汇总展示用） */
  private totalTextLen: number = 0;
  /** 上次喂出句子的时刻（闸门B判定用；0=本轮尚未喂过） */
  private lastFeedAtMs: number = 0;
  /** 上次喂出句子时的 enqueuedMs（闸门B判定用；-1=无播放器/未喂过，不阻塞） */
  private lastFeedEnqueuedMs: number = -1;
  /** 上次喂出句子的估算音频时长（ms）：enqueued 相对上次增长 ≥ 此值视为完整到达 */
  private lastFeedExpectedMs: number = 0;
  /** 段就绪 / 会话结束的等待器（kickPlay 挂起，回调唤醒） */
  private segmentWaiter: (() => void) | null = null;
  /** 段等待兜底超时（停流时强制收尾，防悬挂） */
  private segmentWaitTimer: number = 0;
  /** 待处理快照（只保留最新一份） */
  private queuedChunk: ChunkSnapshot | null = null;

  /** 清掉段等待兜底定时器（换轮/结束时必须 clearTimeout，防旧轮定时器误杀新会话） */
  private clearSegmentWaitTimer(): void {
    if (this.segmentWaitTimer != 0) {
      clearTimeout(this.segmentWaitTimer);
      this.segmentWaitTimer = 0;
    }
  }

  /**
   * 开始一轮流式播报（新一轮会话开始时调用）
   * 会打断当前播报（含工具栏单条播放）。
   */
  begin(messageId: string, settings: VoiceSettings): void {
    ttsWebSocketPlayer.stop();
    audioPlayerManager.stop();
    // 新轮播报：清空上一轮的 id 改写映射（换轮后旧映射不再适用于新的在播消息）
    clearMessageIdRewrite();
    this.round += 1;
    this.messageId = messageId;
    this.settings = settings;
    this.bodyChannel = new StreamChannel();
    this.thinkChannel = new StreamChannel();
    this.pendingSentences = [];
    this.readySegments = [];
    this.segmentIndex = 0;
    this.queuedChunk = null;
    this.streamFinished = false;
    this.streamEnded = false;
    this.playLooping = false;
    this.feeding = false;
    this.startupFeedCount = 0;
    this.totalFedChars = 0;
    this.totalTextLen = 0;
    this.lastFeedAtMs = 0;
    this.lastFeedEnqueuedMs = -1;
    this.lastFeedExpectedMs = 0;
    this.segmentWaiter = null;
    this.clearSegmentWaitTimer();
    this.onPendingEnqueued = null;
    this.active = true;
    // 注册流式会话回调（段就绪 → 播放队列；会话结束 → 排空即整轮结束）
    const expectedRound = this.round;
    ttsWebSocketPlayer.setStreamSessionHandlers(
      (src: string, durationMs: number): void => {
        if (expectedRound != this.round) {
          return;
        }
        const item = new ReadyUtterance();
        item.src = src;
        item.durationMs = durationMs;
        this.readySegments.push(item);
        this.notifySegmentWaiter();
        // 若正在播上一段：把队首（下一段）预置到空闲 context，换段几乎无缝
        if (this.readySegments.length > 0) {
          try {
            ttsWebSocketPlayer.preloadNextStreamSegment(
              this.readySegments[0].src,
            );
          } catch (_ePre) {
            // ignore
          }
        }
      },
      (): void => {
        if (expectedRound != this.round) {
          return;
        }
        this.streamEnded = true;
        this.notifySegmentWaiter();
        // 原生流式（AudioTrack 边推边播）：会话结束即音频已播完（排空由 TTS drain 轮询判定），
        // 无段队列可等——立即整轮收尾复位图标，不依赖 kickPlay 段循环走完（直接响应终态事件）。
        // 停止 / 失败路径同样经 notifyStreamEnd 到此，此处收尾与 stop() 的幂等复位一致。
        if (ttsWebSocketPlayer.isStreamNativeMode() == true) {
          this.finishRound();
        }
      },
    );
    // 一次 start 的流式会话：后续 onStreamChunk 增量喂 text，flush 后 tts_end 收尾
    ttsWebSocketPlayer.beginStreamSession(messageId);
  }

  /**
   * 流式文本回调（SSE 每次消息列表更新后调用）
   * @param bodyText 正文累计文本（非增量）
   * @param thinkText 思考内容累计文本（非增量）
   * @param finished 本轮流式输出是否结束
   */
  onStreamChunk(bodyText: string, thinkText: string, finished: boolean): void {
    try {
      if (!this.active) {
        return;
      }
      const snap = new ChunkSnapshot();
      snap.bodyText = bodyText;
      snap.thinkText = thinkText;
      snap.finished = finished;
      snap.round = this.round;
      this.queuedChunk = snap;
      this.kick();
    } catch (eChunk) {
      // 底线：分句/入队异常不得冒泡到 SSE 同步调用栈
      console.warn("[VoiceStreamSpeaker] onStreamChunk ignored", eChunk);
    }
  }

  /**
   * 工具栏手动播报：已清洗全文 → 分句 → 分段 TTS（禁止整段一次合成）。
   * @param messageId 消息 id
   * @param settings 播报设置
   * @param preparedText 可播报纯文本（建议已是 speakableText）
   */
  speakPrepared(
    messageId: string,
    settings: VoiceSettings,
    preparedText: string,
  ): void {
    const trimmed = preparedText.trim();
    if (trimmed.length == 0) {
      return;
    }
    const logText = trimmed.split("\r").join("\\r").split("\n").join("\\n");
    console.log(
      "[TTS] toolbar.full messageId=" +
        messageId +
        " textLen=" +
        trimmed.length +
        " text=" +
        logText,
    );
    this.begin(messageId, settings);
    this.totalTextLen = trimmed.length;
    // finished=true：整段按句/软切分入队，kickFeed 逐句喂入流式会话，播放由段队列驱动
    this.onStreamChunk(trimmed, "", true);
  }

  /** 停止流式播报（会话停止/新轮次/手动停止时调用） */
  stop(): void {
    // 作废在途 kickPlay / 喂入，避免 stop 后 await 返回又 playSrcAndWait
    this.round += 1;
    this.active = false;
    this.queuedChunk = null;
    this.pendingSentences = [];
    this.readySegments = [];
    this.streamFinished = false;
    this.streamEnded = true;
    this.playLooping = false;
    this.feeding = false;
    this.onPendingEnqueued = null;
    this.segmentWaiter = null;
    this.clearSegmentWaitTimer();
    this.messageId = "";
    // 会话结束（发 close + 唤醒等待者）；内部 ttsWebSocketPlayer.stop() 再收尾连接
    ttsWebSocketPlayer.stop();
    audioPlayerManager.stop();
  }

  /** 是否仍在接收/分句（尾音频可能仍在 ttsWebSocketPlayer） */
  isActive(): boolean {
    return this.active;
  }

  /** 是否仍占用播报（分句中、待播队列、或本轮 TTS 仍在播） */
  isBusy(): boolean {
    if (this.active == true) {
      return true;
    }
    if (this.playLooping == true) {
      return true;
    }
    if (this.pendingSentences.length > 0) {
      return true;
    }
    if (
      this.messageId.length > 0 &&
      ttsWebSocketPlayer.getMessageId() == this.messageId
    ) {
      const st = ttsWebSocketPlayer.getState();
      if (st == "connecting" || st == "synthesizing" || st == "playing") {
        return true;
      }
    }
    return false;
  }

  getMessageId(): string {
    return this.messageId;
  }

  /** 整轮结束：清 messageId，并强制 TTS 再发 idle，让工具栏复位 */
  private finishRound(): void {
    this.active = false;
    this.playLooping = false;
    this.streamFinished = false;
    this.streamEnded = false;
    this.pendingSentences = [];
    this.readySegments = [];
    this.queuedChunk = null;
    this.segmentWaiter = null;
    this.clearSegmentWaitTimer();
    this.messageId = "";
    ttsWebSocketPlayer.notifyUiIdle();
  }

  /** 串行处理循环：合并消费排队快照 */
  private async kick(): Promise<void> {
    if (this.processing) {
      return;
    }
    this.processing = true;
    while (this.active) {
      const snap = this.queuedChunk;
      if (snap == null) {
        break;
      }
      this.queuedChunk = null;
      if (snap.round != this.round) {
        continue;
      }
      try {
        await this.processChunk(snap);
      } catch (e: any) {
        console.warn("[VoiceStreamSpeaker] process chunk failed", e);
      }
      // 让出主线程：SSE 洪峰时否则 TTS WS / 音频回调要等会话结束后才被调度
      await new Promise<void>((resolve) => {
        setTimeout(() => {
          resolve();
        }, 0);
      });
    }
    this.processing = false;
  }

  /** 处理一份快照：双通道清洗分句 → 入待播队列 → 触发流水线合成/播放 */
  private async processChunk(snap: ChunkSnapshot): Promise<void> {
    const sentences: string[] = [];
    if (this.settings.includeThinkContent && snap.thinkText.length > 0) {
      const thinkFlush = snap.finished || snap.bodyText.length > 0;
      this.drainChannel(this.thinkChannel, snap.thinkText, thinkFlush, sentences);
    }
    if (snap.bodyText.length > 0) {
      this.drainChannel(this.bodyChannel, snap.bodyText, snap.finished, sentences);
    }
    for (let i = 0; i < sentences.length; i++) {
      if (this.segmentIndex >= voiceConfig.maxSentencesPerMessage) {
        // 只停入队，不置 active=false，否则已入队句与尾段都播不完
        console.warn("[VoiceStreamSpeaker] reach max sentences, stop enqueue");
        break;
      }
      this.segmentIndex += 1;
      this.pendingSentences.push(sentences[i]);
      const notify = this.onPendingEnqueued;
      if (notify != null) {
        notify!();
      }
    }
    if (snap.finished == true) {
      this.streamFinished = true;
    }
    // 不 await：文本继续吃 SSE，喂入与播放都在独立循环里执行
    this.kickPlay(snap.round);
    this.kickFeed(snap.round);
  }

  /** 等待新的段 / 会话结束（kickPlay 挂起处；回调唤醒；超时兜底收尾） */
  private waitForSegment(): Promise<void> {
    if (this.readySegments.length > 0 || this.streamEnded == true) {
      return Promise.resolve();
    }
    // 原生流式（AudioTrack 边推边播）：音频在播放器内部排队，排空由会话 drain 轮询驱动，
    // 无需请求切段，也不用 15s 段等待看门狗（长音频合法播放不超时）
    if (ttsWebSocketPlayer.isStreamNativeMode() == true) {
      return new Promise<void>((resolve) => {
        this.segmentWaiter = (): void => {
          resolve();
        };
      });
    }
    // 播放端需要音频：请求会话按需切段（不等凑满阈值），消除「凑段等待」的段边界停顿
    try {
      ttsWebSocketPlayer.requestStreamSegment();
    } catch (_eReq) {
      // ignore
    }
    return new Promise<void>((resolve) => {
      this.segmentWaiter = (): void => {
        resolve();
      };
      // 停流兜底：服务端无新帧且不发 tts_end 时强制结束本轮，防悬挂
      this.segmentWaitTimer = setTimeout((): void => {
        this.segmentWaitTimer = 0;
        if (this.streamEnded != true) {
          this.streamEnded = true;
          // 通知 TTS 层收尾（发 close + 复位会话）
          try {
            ttsWebSocketPlayer.closeStreamSession();
          } catch (_eC) {
            // ignore
          }
        }
        resolve();
      }, STREAM_SEGMENT_WAIT_TIMEOUT_MS) as number;
    });
  }

  private notifySegmentWaiter(): void {
    if (this.segmentWaitTimer != 0) {
      clearTimeout(this.segmentWaitTimer);
      this.segmentWaitTimer = 0;
    }
    const waiter = this.segmentWaiter;
    this.segmentWaiter = null;
    if (waiter != null) {
      try {
        waiter();
      } catch (_eW) {
        // ignore
      }
    }
  }

  /**
   * 文本喂入循环：把合并好的句子串行喂给流式会话（一次 start 的会话内多次 text）；
   * 流结束冲刷尾包（flush）。让出主线程，避免 SSE 洪峰饿死 TTS WS / 音频回调。
   */
  private async kickFeed(expectedRound: number): Promise<void> {
    if (this.feeding) {
      return;
    }
    this.feeding = true;
    try {
      while (
        this.active == true &&
        this.streamEnded != true &&
        expectedRound == this.round
      ) {
        if (this.pendingSentences.length == 0) {
          break;
        }
        const utt = this.takeNextUtterance();
        if (utt == null) {
          // 队列里还有被放回的短句 → 等更多 SSE；队列空则静默退出
          break;
        }
        if (utt.trim().length == 0) {
          continue;
        }
        // 生产节流（原生流式）：缓冲未低于阈值前不喂下一句。
        // 让服务端只合成即将播放的内容：中途停止浪费 ≤ 在途 1~2 句；
        // 队列保持秒级 → 长文本不积压、不丢帧。非原生（isStreamNativeMode=false）不节流。
        // 播放器未创建（buffered=-1）时无缓冲可测：首帧反馈前只放行启动上限句数
        // （MAX_STARTUP_FEED_UTTERANCES），详见循环内注释。
        if (ttsWebSocketPlayer.isStreamNativeMode()) {
          while (
            this.active == true &&
            this.streamEnded != true &&
            expectedRound == this.round
          ) {
            const buffered = ttsWebSocketPlayer.getNativeBufferedMs();
            if (buffered < 0) {
              // 播放器未创建（buffered<0）= 尚无首个 PCM 反馈：无缓冲可节流，
              // 但不能无限喂——首个 PCM 前最多喂 MAX_STARTUP_FEED_UTTERANCES 句，
              // 之后等首个 PCM 建立反馈（到达即恢复正常缓冲节流；不来由 no-audio watchdog 判死）。
              // 播放器是「喂文本 → 服务端回 PCM」的结果，不是喂入前提；
              // 但无反馈确认时不能无限提交，否则手动播报全文入队会把整段文本一次灌给后端。
              if (this.startupFeedCount < MAX_STARTUP_FEED_UTTERANCES) {
                break;
              }
            } else if (buffered < FEED_PACING_BUFFER_MS) {
              // 缓冲低于阈值：放行下一句，但须闸门B——节流只能测到已送达播放器的
              // 音频，测不到服务端正在合成的：合成延迟窗口内连喂多句（每句≈11s）
              // 会一次性承诺几百秒音频，队列照样顶满背压丢帧。上一句音频「完整到达」
              // （enqueued 相对上次喂入增长 ≥ 估算时长，单调只增）或超时兜底
              // （估算偏高/服务端慢速期放行，防停喂中断当前语音）才真正放行。
              const enqueuedNow = ttsWebSocketPlayer.getNativeEnqueuedMs();
              const delivered = enqueuedNow - this.lastFeedEnqueuedMs;
              const fullDelivered =
                this.lastFeedExpectedMs > 0 &&
                delivered >= this.lastFeedExpectedMs;
              const waitTimeout =
                Date.now() - this.lastFeedAtMs >=
                FEED_FULL_DELIVERY_TIMEOUT_MS;
              if (
                this.lastFeedEnqueuedMs < 0 ||
                fullDelivered ||
                waitTimeout
              ) {
                break;
              }
            }
            await new Promise<void>((resolve) => {
              setTimeout(() => {
                resolve();
              }, FEED_PACING_POLL_MS);
            });
          }
        }
        if (
          this.active != true ||
          this.streamEnded == true ||
          expectedRound != this.round
        ) {
          break;
        }
        // 诊断：喂入间隔监控——第三方 TTS 对「23s 无新文本」会判超时并让后端重连，
        // 间隔逼近阈值时告警（超长句/缓冲积压都会拉长间隔，便于复现定位）
        const feedGapMs = Date.now() - this.lastFeedAtMs;
        if (this.lastFeedAtMs > 0 && feedGapMs > 15000) {
          console.warn(
            "[TTS] feed gap " +
              feedGapMs +
              "ms chunkLen=" +
              utt.length +
              " bufferedMs=" +
              ttsWebSocketPlayer.getNativeBufferedMs() +
              " (3rd-party no-text timeout 23000ms)",
          );
        }
        ttsWebSocketPlayer.feedStreamText(utt, false);
        this.startupFeedCount += 1;
        this.totalFedChars += utt.length;
        // 闸门B基线：记录本次喂出时刻、当时的 enqueuedMs 与本句估算音频时长。
        // 下一句放行前须看到 enqueued 相对本基线增长 ≥ 估算时长（完整到达）；
        // 播放器未创建时 getNativeEnqueuedMs=-1，启动期不受此闸门限制（由上方
        // MAX_STARTUP_FEED_UTTERANCES 约束）。估算 ~170ms/字（中文 TTS 约 5~6 字/s），
        // 下限 2s 防止过短句过早放行。
        this.lastFeedAtMs = Date.now();
        this.lastFeedEnqueuedMs = ttsWebSocketPlayer.getNativeEnqueuedMs();
        this.lastFeedExpectedMs = Math.max(
          2000,
          Math.floor(utt.length * 170),
        );
        // 让出主线程：SSE 洪峰时否则 TTS WS / 音频回调要等会话结束后才被调度
        await new Promise<void>((resolve) => {
          setTimeout(() => {
            resolve();
          }, 0);
        });
      }
      if (
        expectedRound == this.round &&
        this.streamFinished == true &&
        this.pendingSentences.length == 0 &&
        this.active == true &&
        this.streamEnded != true
      ) {
        // 诊断：喂入完成汇总（对比 toolbar.full 的 textLen 可确认全文是否喂完）
        console.log(
          "[TTS] feed done fedChars=" +
            this.totalFedChars +
            (this.totalTextLen > 0 ? " of " + this.totalTextLen : "") +
            " bufferedMs=" +
            ttsWebSocketPlayer.getNativeBufferedMs(),
        );
        ttsWebSocketPlayer.flushStreamSession();
      }
    } catch (eFeed: any) {
      console.warn("[VoiceStreamSpeaker] feed failed", eFeed);
    }
    this.feeding = false;
  }

  /**
   * 从待播队列取出下一段：合并过短片段，减少 TTS 往返。
   * 过短句必须合并到达标：不可因「下一段太长」而单独播出（否则会先播「你好你好」再空等长句合成）。
   * @returns null 表示短句暂缓（等更多文本或流结束）
   */
  private takeNextUtterance(): string | null {
    if (this.pendingSentences.length == 0) {
      return null;
    }
    let utterance = this.pendingSentences.shift()!;
    while (
      utterance.trim().length < MIN_UTTERANCE_CHARS &&
      this.pendingSentences.length > 0
    ) {
      // 未达最短字数时一律吞下一段（可突破 MAX_MERGED）；达标后才受长度上限约束
      const next = this.pendingSentences.shift()!;
      utterance = utterance + next;
    }
    // 已够长时，在上限内继续合并后续短尾巴，减少碎片
    while (
      this.pendingSentences.length > 0 &&
      utterance.length < MAX_MERGED_UTTERANCE_CHARS
    ) {
      const next = this.pendingSentences[0];
      if (utterance.length + next.length > MAX_MERGED_UTTERANCE_CHARS) {
        break;
      }
      this.pendingSentences.shift();
      utterance = utterance + next;
    }
    // 单句超长（合并上限对整句不生效）：按软停顿切回 ≤MAX 块，本次喂首块、
    // 其余放回队首续喂。否则一块 100+ 字（≈20s+ 音频）会令闸门A放行后缓冲
    // 堆到 30s+，喂入间隔逼近第三方 TTS 的 23s「无新文本」超时。
    if (utterance.length > MAX_MERGED_UTTERANCE_CHARS) {
      const pieces = splitOversizedUtterance(
        utterance,
        MAX_MERGED_UTTERANCE_CHARS,
      );
      for (let i = pieces.length - 1; i > 0; i--) {
        this.pendingSentences.unshift(pieces[i]);
      }
      utterance = pieces[0];
    }
    // 仍过短且流未结束：放回队列，等后续分句再合
    if (
      utterance.trim().length < MIN_UTTERANCE_CHARS &&
      this.streamFinished != true &&
      this.pendingSentences.length == 0 &&
      this.active == true
    ) {
      this.pendingSentences.unshift(utterance);
      return null;
    }
    return utterance;
  }

  /**
   * 段播放循环：消费流式会话切好的段，顺序播放。
   * 段由会话回调推入 readySegments；会话结束（streamEnded）后队列排空即整轮结束。
   * tts_end 只表示服务端已发完，本地段队列播完才 finishRound —— 这正是
   * 「tts_end 不表示本地已播完」的收尾语义。
   */
  private async kickPlay(expectedRound: number): Promise<void> {
    if (this.playLooping) {
      return;
    }
    this.playLooping = true;
    try {
      while (
        expectedRound == this.round &&
        (this.active == true || this.streamFinished == true) &&
        (this.readySegments.length > 0 || this.streamEnded != true)
      ) {
        if (this.readySegments.length == 0) {
          // 段未到：挂起等会话回调（新段 / tts_end / flush 看门狗 / 停止）
          await this.waitForSegment();
          if (expectedRound != this.round) {
            break;
          }
          continue;
        }
        const item = this.readySegments.shift()!;
        // 双 context 交替播放：预置下一段 src 到空闲 context，换段近乎无缝
        const nextSrc = this.readySegments.length > 0
          ? this.readySegments[0].src
          : "";
        // 队列将空：提前请求会话切下一段，让它在当前段播放期间就绪并被预置
        if (nextSrc.length == 0) {
          try {
            ttsWebSocketPlayer.requestStreamSegment();
          } catch (_eReq) {
            // ignore
          }
        }
        let ok = false;
        try {
          ok = await ttsWebSocketPlayer.playStreamSegment(
            this.messageId,
            item.src,
            item.durationMs,
            nextSrc,
          );
        } catch (ePlay: any) {
          console.warn("[VoiceStreamSpeaker] playStreamSegment failed", ePlay);
          ok = false;
        }
        if (expectedRound != this.round) {
          break;
        }
        if (ok != true) {
          console.warn(
            "[StreamSpeak] segment play failed, drop remaining segments=",
            this.readySegments.length,
          );
          this.readySegments = [];
          ttsWebSocketPlayer.releaseIdleConnection();
          this.finishRound();
          break;
        }
      }
    } catch (eKick: any) {
      console.warn("[VoiceStreamSpeaker] kickPlay error", eKick);
    }

    // 已被 stop/begin 换轮：勿动 playLooping / messageId（新轮可能已在跑）
    if (expectedRound != this.round) {
      return;
    }
    // 失败路径已 finishRound
    if (this.messageId.length == 0) {
      this.playLooping = false;
      return;
    }
    this.playLooping = false;
    // streamEnded 即服务端已发完（tts_end / flush 看门狗 / 停流强制收尾）：
    // 段队列已空且无滞留快照 → 整轮结束（本地缓冲播完才到这里）。
    if (
      this.streamEnded == true &&
      this.readySegments.length == 0 &&
      this.queuedChunk == null
    ) {
      // 释放连接 + 清 messageId + 强制 idle 通知工具栏
      ttsWebSocketPlayer.releaseIdleConnection();
      this.finishRound();
    } else if (
      this.readySegments.length > 0 ||
      (this.streamEnded != true && this.active == true)
    ) {
      // 写段回调在循环退出后入队 / 会话仍在出段：异步再入，避免同步递归
      setTimeout(() => {
        this.kickPlay(expectedRound);
      }, 0);
    }
    // streamEnded 但 queuedChunk 未消费：等下一次 processChunk → kickPlay
  }

  /**
   * 单通道增量处理：全文 → 流式可朗读快照 → 相对上次的增量 → 分句。
   * 纯中文等无标记正文：前缀增长时只清洗增量，避免 SSE 每帧 O(n²) 全量 clean。
   * 一旦出现 Markdown / 公式 / 图片 / 未闭合结构：必须全量 clean，
   * 避免只洗 delta 导致代码/LaTeX/半截 URL 泄漏进播报。
   */
  private drainChannel(
    ch: StreamChannel,
    fullRaw: string,
    flush: boolean,
    out: string[],
  ): void {
    // 流式 / 终态统一用 speakable 快照，便于命中 lastSource 缓存
    const source = speakableRawForStreaming(fullRaw);

    let speakable: string = "";
    if (source == ch.lastSource && ch.lastSource.length > 0) {
      // agent-info 未闭合等场景：可朗读快照不变，跳过昂贵正则
      speakable = ch.lastSpeakable;
    } else {
      const prefixGrew =
        ch.lastSource.length > 0 &&
        source.length > ch.lastSource.length &&
        source.indexOf(ch.lastSource) == 0;
      // 仅当「历史 + 当前」都无需全量清洗时，才走增量
      const canIncremental =
        prefixGrew &&
        needsFullSpeechClean(source) != true &&
        needsFullSpeechClean(ch.lastSource) != true;
      if (canIncremental == true) {
        const rawDelta = source.substring(ch.lastSource.length);
        const cleanedDelta = cleanTextForSpeech(rawDelta, this.settings, false);
        speakable = ch.lastSpeakable + cleanedDelta;
      } else {
        speakable = cleanTextForSpeech(source, this.settings, true);
      }
      ch.lastSource = source;
      ch.lastSpeakable = speakable;
    }

    if (speakable.length < ch.consumedSpeakable) {
      // 新出现代码围栏等导致可朗读文本变短：对齐已消费长度，清空未播 pending（已入队句无法撤回）
      ch.consumedSpeakable = speakable.length;
      ch.pending = "";
    } else if (speakable.length > ch.consumedSpeakable) {
      const delta = speakable.substring(ch.consumedSpeakable);
      ch.consumedSpeakable = speakable.length;
      // 增量已是 speakable 子串，禁止再插空格（中文会被拆成「床 前 明 月」）
      if (delta.length > 0) {
        ch.pending = ch.pending + delta;
      }
    }
    const drain = drainCompleteSentences(ch.pending, flush);
    ch.pending = drain.remainder;
    for (let i = 0; i < drain.sentences.length; i++) {
      out.push(drain.sentences[i]);
    }
  }
}

/** 全局流式播报单例 */
export const voiceStreamSpeaker = new VoiceStreamSpeaker();
