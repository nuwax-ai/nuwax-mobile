export const SPACE_INVITE_PAGE = "/subpackages/pages/space-invite/space-invite";

export function spaceInvitePageUrl(code: string): string {
  return SPACE_INVITE_PAGE + "?code=" + encodeURIComponent(code);
}

/** 站内 Web 邀请地址转为移动业务路由，保留查询值的原始编码。 */
export function mobileSpaceInviteFromWebPath(value: string): string {
  const parts = value.split("#")[0].split("?");
  const match = parts[0].match(/^\/invite\/space\/([^/]+)\/?$/);
  if (match == null) return "";
  const encodedCode = match[1];
  if (encodedCode == null || encodedCode.length == 0) return "";
  try {
    const code = decodeURIComponent(encodedCode);
    if (code == null || code.length == 0) return "";
    let target = spaceInvitePageUrl(code);
    if (parts.length > 1) {
      const fields = parts.slice(1).join("?").split("&");
      for (let i = 0; i < fields.length; i++) {
        if (fields[i].length > 0 && fields[i].split("=")[0] != "code") target += "&" + fields[i];
      }
    }
    return target;
  } catch (_error) { return ""; }
}

/** App 只识别当前服务域的邀请，不把外站同名路径当作本站入团操作。 */
export function spaceInviteCodeFromUrl(value: string, origin: string): string {
  if (origin.length == 0 || !value.toLowerCase().startsWith(origin.toLowerCase() + "/")) return "";
  const target = mobileSpaceInviteFromWebPath(value.substring(origin.length).split("#")[0]);
  if (target.length == 0) return "";
  const code = target.substring(target.indexOf("?code=") + 6).split("&")[0];
  try { return decodeURIComponent(code) ?? ""; } catch (_error) { return ""; }
}
