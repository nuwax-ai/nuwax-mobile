<template>
  <view class="emoji-bind">
    <view class="field-label">{{ t("Mobile.Terminal.eventEmojiBind") }}</view>
    <view class="card-group">
      <view
        v-for="item in eventList"
        :key="item.name"
        class="row-item"
        hover-class="row-item-active"
        @click="handleEmojiClick(item.name)"
      >
        <view class="emoji-box">
          <text class="emoji-text">{{ item.emoji }}</text>
        </view>
        <view class="row-info">
          <text class="row-title">{{ item.name }}</text>
        </view>
        <text class="emoji-current">{{ item.emoji }}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // 智能体事件表情绑定（静态假数据）
  class EventEmoji {
    name: string = "";
    emoji: string = "";
    constructor(name: string, emoji: string) {
      this.name = name;
      this.emoji = emoji;
    }
  }

  const eventList = ref<EventEmoji[]>([
    new EventEmoji("工具调用开始", "🔧"),
    new EventEmoji("工具调用结束", "✅"),
    new EventEmoji("工具调用错误", "❌"),
    new EventEmoji("耗时过长", "⏰"),
    new EventEmoji("深度思考", "🤔"),
    new EventEmoji("对话开始", "💬"),
    new EventEmoji("对话结束", "🏁"),
    new EventEmoji("智能体启动", "🚀"),
    new EventEmoji("智能体空闲", "😴"),
    new EventEmoji("快速完成", "⚡"),
    new EventEmoji("联网搜索", "🔍"),
    new EventEmoji("文档生成", "📄"),
    new EventEmoji("任务完成", "🎉"),
  ]);

  const handleEmojiClick = (name: string) => {
    uni.showToast({ title: name, icon: "none" });
  };
</script>

