<template>
  <!-- #ifdef H5 || WEB -->
  <view class="file-preview-h5" :style="containerStyle">
    <!-- Loading Overlay -->
    <view v-show="loading" class="state-overlay">
      <!-- <text>加载中...</text> -->
    </view>

    <!-- Error Overlay -->
    <view v-show="error" class="state-overlay error">
      <text class="error-text">{{ error }}</text>
      <button size="mini" @click="reload">
        {{ i18n("Mobile.Common.retry") }}
      </button>
    </view>

    <!-- Preview iframe -->
    <iframe
      v-if="previewUrl"
      ref="previewIframe"
      :src="previewUrl"
      class="preview-iframe"
      frameborder="0"
      allowfullscreen
      @load="onIframeLoad"
      @error="onIframeError"
    ></iframe>
  </view>
  <!-- #endif -->
  <!-- #ifndef H5 ? H5 : WEB -->
  <!-- 文件 H5 预览仅在 H5 可用，APP 端走 file-preview-page 页面 -->
  <view />
  <!-- #endif -->
</template>

<script lang="uts" setup>
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  // #ifdef H5 || WEB
  import { getApiBaseUrl } from '@/constants/config';
  import { translateText } from '@/utils/i18n';
  import { orString } from '@/utils/utsCoalesce';
  import { ref, computed, watch, onMounted, onBeforeUnmount, nextTick } from 'vue';

  const props = defineProps({
    src: {
      type: String,
      default: '',
    },
    fileType: {
      type: String,
      default: '',
    },
    height: {
      type: String,
      default: '100%',
    },
  })
  const emit = defineEmits(['load', 'error'])

  const i18n = (key: string): string => translateText(key)

  const loading = ref<boolean>(true)
  const error = ref<string | null>(null)
  const previewIframe = ref<any>(null)

  const getPreviewBaseUrl = (): string => {
    // 判断是否为开发环境
    if (process.env.NODE_ENV === 'development') {
      console.log('API_BASE_URL', API_BASE_URL);
      return API_BASE_URL;
    }
    // In development, use current origin
    // In production, use the same origin or configured base URL
    if (typeof window !== 'undefined') {
      return window.location.origin;
    }
    return '';
  }

  const containerStyle = computed(() : any => {
    return {
      minHeight: props.height,
      height: props.height,
    };
  })

  const previewUrl = computed(() : string => {
    if (!props.src) return '';

    // Get the base URL for the preview page
    // In production, H5 is served under /m/ path
    const baseUrl = getPreviewBaseUrl();

    // Build query parameters
    const params = new URLSearchParams();
    params.set('fileUrl', props.src);

    if (Boolean(props.fileType)) {
      params.set('fileType', props.fileType);
    }

    // Use /static/ for H5 deployment
    return `${baseUrl}/static/file-preview.html?${params.toString()}`;
  })

  const onIframeLoad = () => {
    console.log('[FilePreviewH5] Iframe loaded');
    // Don't hide loading here - wait for preview_success message
  }

  const onIframeError = (e: any) => {
    console.error('[FilePreviewH5] Iframe error:', e);
    loading.value = false;
    error.value = i18n('Mobile.FilePreview.previewPageLoadFailed');
  }

  const handleMessage = (event: any) => {
    // Validate message origin if needed
    const data = event.data;

    if (data == null || data.type == null) return;

    console.log('[FilePreviewH5] Received message:', data);

    if (data.type == 'preview_success') {
      loading.value = false;
      error.value = null;
      emit('load');
    } else if (data.type == 'preview_error') {
      loading.value = false;
      error.value = orString(data.error, i18n('Mobile.FilePreview.documentRenderFailed'));
      emit('error', data.error);
    }
  }

  const reload = () => {
    loading.value = true;
    error.value = null;

    // Force iframe reload by toggling src
    const iframe = previewIframe.value;
    if (Boolean(iframe)) {
      const currentSrc = iframe.src;
      iframe.src = '';
      nextTick(() => {
        iframe.src = currentSrc;
      });
    }
  }

  watch(() => props.src, (newSrc: string) => {
    if (Boolean(newSrc)) {
      loading.value = true;
      error.value = null;
    }
  }, { immediate: true })

  onMounted(() => {
    console.log('[FilePreviewH5] Mounted with iframe mode', { src: props.src, type: props.fileType });

    // Listen for messages from iframe
    window.addEventListener('message', handleMessage);
  })

  onBeforeUnmount(() => {
    window.removeEventListener('message', handleMessage);
  })
  // #endif

  // #ifndef H5 || WEB
  // APP / 小程序端：H5 文件预览组件不可用，提供空 stub 避免编译失败。
  defineProps({
    src: {
      type: String,
      default: '',
    },
    fileType: {
      type: String,
      default: '',
    },
    height: {
      type: String,
      default: '100%',
    },
  })
  // #endif
</script>

<style scoped>
.file-preview-h5 {
  width: 100%;
  height: 100%;
  min-height: 400px;
  background: #fff;
  position: relative;
}

.state-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  z-index: 10;
  color: #666;
}

.state-overlay.error {
  color: #ff4d4f;
}

.error-text {
  margin-bottom: 16px;
}

.preview-iframe {
  width: 100%;
  height: 100%;
  border: none;
}
</style>
