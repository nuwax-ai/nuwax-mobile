    display: flex;
    align-items: center;
    justify-content: center;
  }

  .content-popup-close-text {
    font-size: 52rpx;
    line-height: 1;
    color: #333333;
  }

  .content-popup-body {
    display: flex;
    flex-direction: column;
    padding: 30rpx;
  }

  .content-popup-item {
    display: flex;
    flex-direction: column;
    margin-bottom: 24rpx;
  }

  .content-popup-label {
    font-size: 28rpx;
    font-weight: 500;
    color: #1a1a1a;
    margin-bottom: 12rpx;
  }

  .content-popup-required {
    color: #f53f3f;
    margin-right: 6rpx;
  }

  .content-popup-input {
    box-sizing: border-box;
    width: 100%;
    height: 80rpx;
    border: 2rpx solid #e5e6eb;
    border-radius: 12rpx;
    background-color: #f7f8fa;
    color: #1d2129;
    font-size: 28rpx;
    padding: 20rpx 24rpx;
  }

  .content-popup-placeholder {
    color: #c0c0c0;
  }

  .content-popup-error {
    color: #f53f3f;
    font-size: 24rpx;
    margin-top: -8rpx;
    margin-bottom: 16rpx;
  }

  .recipient-help {
    margin-top: 10rpx;
    color: #86909c;
    font-size: 22rpx;
    line-height: 1.5;
  }

  .content-popup-actions {
    display: flex;
    flex-direction: row;
    margin-top: 8rpx;
  }

  .content-popup-btn {
    flex: 1;
    height: 80rpx;
    border-radius: 12rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 16rpx;
  }

