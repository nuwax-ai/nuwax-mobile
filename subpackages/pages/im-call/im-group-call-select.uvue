<template>
  <view class="gc-page">
    <safety-zone />
    <view class="gc-head">
      <view class="gc-head__btn" @click="close"><svg-icon name="icon-X" size="18" unit="px" color="#141416" /></view>
      <text class="gc-head__title">{{ pageTitle }}</text>
      <view class="gc-head__btn gc-head__btn--text" @click="submit"><text class="gc-head__ok">发起</text></view>
    </view>
    <view class="gc-tip"><text class="gc-tip__text">选择要通知的群成员，最多 19 人；其他成员仍可从群里的通话卡片加入。</text></view>
    <view class="gc-toolbar">
      <text class="gc-count">已选 {{ selectedIds.length }} / {{ Math.min(members.length, 19) }} 人</text>
      <view class="gc-space" />
      <text class="gc-link" @click="selectAll">全选</text>
      <text class="gc-link" @click="clearAll">清空</text>
    </view>
    <scroll-view class="gc-list" direction="vertical" :show-scrollbar="false">
      <view v-if="loading" class="gc-state"><text class="gc-state__text">正在加载群成员…</text></view>
      <view v-else-if="failed" class="gc-state" @click="loadMembers"><text class="gc-state__text">加载失败，点击重试</text></view>
      <view v-else-if="members.length == 0" class="gc-state"><text class="gc-state__text">暂无可邀请成员</text></view>
      <view v-for="m in members" :key="m.userId" class="gc-row" @click="toggle(m)">
        <view class="gc-check" :class="isSelected(m) ? 'gc-check--on' : ''">
          <svg-icon v-if="isSelected(m)" name="icon-Check" size="11" unit="px" color="#ffffff" />
        </view>
        <image v-if="m.avatar.length > 0" class="gc-avatar" :src="m.avatar" mode="aspectFill" />
        <view v-else class="gc-avatar gc-avatar--text"><text class="gc-avatar__text">{{ m.name.charAt(0) }}</text></view>
        <text class="gc-name text-ellipsis">{{ m.name }}</text>
      </view>
      <view class="gc-tail" />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiUserInfo } from "@/servers/account";
  import { apiImConvMembersAll, apiImCreateP2pConversation, getImDeviceId, imDevicePlatform } from "@/servers/im";
  import { apiImMeetingCreateRoom } from "@/servers/imMeeting";
  import { apiImSendMeetingInvite } from "@/servers/imCall";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { generateUUID } from "@/utils/common";
  import { imAvatarDisplayUrl } from "@/utils/imAvatarDisplay";
  import { makeMeetingNo } from "@/utils/meeting/meetingLink";

  class GroupCallMember {
    userId: string = "";
    name: string = "";
    avatar: string = "";
  }

  const convId = ref<string>("");
  const groupName = ref<string>("群聊");
  const mediaType = ref<string>("audio");
  const members = ref<GroupCallMember[]>([]);
  const selectedIds = ref<string[]>([]);
  const loading = ref<boolean>(false);
  const failed = ref<boolean>(false);
  const submitting = ref<boolean>(false);
  const pageTitle = computed((): string => mediaType.value == "video" ? "发起群视频通话" : "发起群语音通话");

  function option(options: any, key: string): string {
    if (options == null) return "";
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) return "";
    try { return decodeURIComponent("" + raw)!!; } catch (_e) { return "" + raw; }
  }

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw == null ? "" : "" + raw;
  }

  async function myUserId(): Promise<string> {
    try {
      const res = await apiUserInfo();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const obj = raw != null ? (raw as UTSJSONObject) : null;
        if (obj != null) return readString(obj, "id");
      }
    } catch (_e) {}
    return "";
  }

  async function loadMembers(): Promise<void> {
    if (loading.value || convId.value.length == 0) return;
    loading.value = true;
    failed.value = false;
    try {
      const mine = await myUserId();
      const records = await apiImConvMembersAll(convId.value);
      if (records == null) { failed.value = true; return; }
      const out: GroupCallMember[] = [];
      for (let i = 0; i < records.length; i++) {
        const row = records[i];
        const uid = readString(row, "userId");
        if (uid.length == 0 || uid == mine || readString(row, "self") == "true") continue;
        if (row["agentMode"] != null) continue;
        const m = new GroupCallMember();
        m.userId = uid;
        m.name = readString(row, "nickName");
        if (m.name.length == 0) m.name = readString(row, "name");
        if (m.name.length == 0) m.name = "用户" + uid;
        m.avatar = imAvatarDisplayUrl(readString(row, "avatar"), 88);
        out.push(m);
      }
      members.value = out;
      const ids: string[] = [];
      const count = Math.min(out.length, 19);
      for (let i = 0; i < count; i++) ids.push(out[i].userId);
      selectedIds.value = ids;
    } catch (_e) {
      failed.value = true;
    } finally {
      loading.value = false;
    }
  }

  function isSelected(m: GroupCallMember): boolean { return selectedIds.value.indexOf(m.userId) >= 0; }
  function toggle(m: GroupCallMember): void {
    const at = selectedIds.value.indexOf(m.userId);
    if (at >= 0) { selectedIds.value.splice(at, 1); return; }
    if (selectedIds.value.length >= 19) { uni.showToast({ title: "最多邀请 19 人", icon: "none" }); return; }
    selectedIds.value.push(m.userId);
  }
  function selectAll(): void {
    const ids: string[] = [];
    const count = Math.min(members.value.length, 19);
    for (let i = 0; i < count; i++) ids.push(members.value[i].userId);
    selectedIds.value = ids;
  }
  function clearAll(): void { selectedIds.value = []; }
  function close(): void { uni.navigateBack({ delta: 1 }); }

  async function notifySelected(room: string, title: string): Promise<void> {
    const list = members.value;
    for (let i = 0; i < list.length; i++) {
      const m = list[i];
      if (selectedIds.value.indexOf(m.userId) < 0) continue;
      try {
        const conv = await apiImCreateP2pConversation(m.userId, "", true);
        if (apiResCode(conv) != SUCCESS_CODE) continue;
        const raw = apiResData<any>(conv);
        const obj = raw != null ? (raw as UTSJSONObject) : null;
        const targetConvId = obj != null ? readString(obj, "convId") : "";
        if (targetConvId.length == 0) continue;
        await apiImSendMeetingInvite(targetConvId, generateUUID(), room, title, mediaType.value, true, false, generateUUID());
      } catch (_e) {}
    }
  }

  async function submit(): Promise<void> {
    if (submitting.value) return;
    submitting.value = true;
    const room = makeMeetingNo(Math.floor(Math.random() * 1000000000));
    const title = groupName.value + (mediaType.value == "video" ? " 的视频通话" : " 的语音通话");
    try {
      const body: UTSJSONObject = {};
      body["name"] = room;
      body["platform"] = imDevicePlatform();
      body["deviceId"] = getImDeviceId();
      body["maxParticipants"] = 20;
      body["origin"] = 1;
      body["title"] = title;
      body["meetingType"] = mediaType.value == "video" ? 2 : 1;
      body["allowGuest"] = false;
      body["convId"] = convId.value;
      body["emptyTimeoutSeconds"] = 3600;
      const created = await apiImMeetingCreateRoom(body);
      if (apiResCode(created) != SUCCESS_CODE) { uni.showToast({ title: "发起通话失败", icon: "none" }); return; }
      await apiImSendMeetingInvite(convId.value, generateUUID(), room, title, mediaType.value, true, true, generateUUID());
      notifySelected(room, title);
      // 群通话也是会议房间：发起人同样默认静音、关摄像头，由用户主动打开设备。
      // ★带 convId：会中「邀请参会人」面板据此把群成员排在最前（普通会议没有这个参数）。
      uni.redirectTo({
        url: "/subpackages/pages/im-meeting/im-meeting-room?room=" + encodeURIComponent(room) + "&title=" + encodeURIComponent(title) + "&status=1&host=1&members=1&convId=" + convId.value,
      });
    } catch (_e) {
      uni.showToast({ title: "发起通话失败", icon: "none" });
    } finally {
      submitting.value = false;
    }
  }

  onLoad((options: any) => {
    convId.value = option(options, "convId");
    const name = option(options, "name");
    if (name.length > 0) groupName.value = name;
    mediaType.value = option(options, "media") == "video" ? "video" : "audio";
    loadMembers();
  });
</script>

<style lang="scss" scoped>
  .gc-page { flex: 1; background-color: #f7f8fa; }
  .gc-head { height: 48px; padding: 0 8px; background-color: #ffffff; display: flex; flex-direction: row; align-items: center; }
  .gc-head__btn { width: 54px; height: 44px; align-items: center; justify-content: center; }
  .gc-head__btn--text { align-items: flex-end; }
  .gc-head__title { flex: 1; text-align: center; font-size: 17px; font-weight: 600; color: #141416; }
  .gc-head__ok { color: #5147ff; font-size: 15px; font-weight: 600; }
  .gc-tip { margin: 12px 16px 0; padding: 12px; border-radius: 10px; background-color: #efedff; }
  .gc-tip__text { color: #59566c; font-size: 13px; line-height: 19px; }
  .gc-toolbar { height: 48px; padding: 0 18px; display: flex; flex-direction: row; align-items: center; }
  .gc-count { color: #777481; font-size: 13px; }
  .gc-space { flex: 1; }
  .gc-link { margin-left: 18px; color: #5147ff; font-size: 13px; }
  .gc-list { flex: 1; background-color: #ffffff; }
  .gc-row { height: 62px; padding: 0 18px; display: flex; flex-direction: row; align-items: center; border-bottom: 1px solid #f0eff3; }
  .gc-check { width: 20px; height: 20px; margin-right: 12px; border-radius: 10px; border: 1px solid #c7c5cf; align-items: center; justify-content: center; }
  .gc-check--on { border-color: #5147ff; background-color: #5147ff; }
  .gc-avatar { width: 40px; height: 40px; border-radius: 20px; margin-right: 12px; }
  .gc-avatar--text { background-color: #7772d8; align-items: center; justify-content: center; }
  .gc-avatar__text { color: #ffffff; font-size: 16px; }
  .gc-name { flex: 1; color: #1f1f22; font-size: 15px; }
  .gc-state { padding: 48px 20px; align-items: center; }
  .gc-state__text { color: #8a8792; font-size: 14px; }
  .gc-tail { height: 24px; }
</style>
