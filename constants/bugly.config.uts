// App ID 跟随发包环境和平台。渠道跟随实际访问的服务域名。
const BUGLY_TEST_HOST = "testagent.xspaceagi.com";
const BUGLY_RELEASE_HOST = "agent.nuwax.com";
export const BUGLY_TEST_ORIGIN = `https://${BUGLY_TEST_HOST}`;
export const BUGLY_RELEASE_ORIGIN = `https://${BUGLY_RELEASE_HOST}`;
export const BUGLY_ANDROID_TEST_APP_ID = "1e61e64e7c";
export const BUGLY_IOS_TEST_APP_ID = "e5855de67c";
export const BUGLY_ANDROID_RELEASE_APP_ID = "";
export const BUGLY_IOS_RELEASE_APP_ID = "";

export type BuglyServiceEnvironment = {
  host: string;
  environment: string;
};

// 女娲官方服务的上报清单。企业登录允许填写其他地址，租户的自定义域名不会自动加入这里。
export const BUGLY_SERVICE_ENVIRONMENTS: Array<BuglyServiceEnvironment> = [
  { host: BUGLY_TEST_HOST, environment: "test" },
  { host: BUGLY_RELEASE_HOST, environment: "production" },
];
