import request from "@/servers/useRequest";
import { RequestResponse, VoidRequestResponse } from "@/types/interfaces/request";

/** 读取智能体级会话框偏好：chatbox.config.{agentId}。 */
export async function apiUserConfigGet(key: string): Promise<RequestResponse<any>> {
  const data = new UTSJSONObject();
  data["key"] = key;
  return await request({
    url: "/api/user/config/get",
    method: "GET",
    data,
  });
}

/** 三项配置全量写回，保持与 PC chatbox.config 契约一致。 */
export async function apiChatboxConfigSet(
  key: string,
  mode: string,
  enableVersionControl: number,
  autoCommit: number,
): Promise<VoidRequestResponse> {
  const value = new UTSJSONObject();
  value["mode"] = mode;
  value["enableVersionControl"] = enableVersionControl;
  value["autoCommit"] = autoCommit;
  const data = new UTSJSONObject();
  data["key"] = key;
  data["value"] = value;
  return await request({
    url: "/api/user/config/set",
    method: "POST",
    data,
  });
}
