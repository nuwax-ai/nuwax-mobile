/**
 * Nuwax Vox 设备语音网关 - App 监控接口类型
 * 接口文档: GET /api/app/monitorings 等
 */

/** 监控列表查询参数（与会议同形） */
export class AppMonitoringListParams {
  // 设备关联的终端智能体 ID；后端必传
  agentId: number = 0;
  keyword: string = "";
  // ALL | TODAY | THIS_WEEK | THIS_MONTH
  timeRange: string = "ALL";
  // 页码，从 1 开始
  page: number = 1;
  pageSize: number = 20;
}

/** 监控列表项（AppMonitoringView） */
export interface IAppMonitoringView {
  id: number;
  deviceId: string;
  // 监控运行 ID
  runId: string;
  status: string;
  // 录音原始 URL（有值表示有录音；播放需调 /monitorings/{id}/audio-url）
  audioFileUrl: string;
  audioBytes: number;
  audioDurationMs: number;
  startedAt: string;
  endedAt: string;
  // 转写摘要预览（截断）
  transcriptPreview: string;
}

/** 监控列表分页（AppMonitoringPageView） */
export interface IAppMonitoringPageView {
  items: IAppMonitoringView[];
  total: number;
  page: number;
  pageSize: number;
}

/** 监控录音临时播放地址（AppMonitoringAudioUrlView）；接口已废弃，仅存量播放链路未切完前保留 */
export interface IAppMonitoringAudioUrlView {
  url: string;
  expiresInSeconds: number;
}

/** 监控录音音频分段项（GET /monitorings/{id}/audio-files；NW-269 播放接口变更） */
export interface IAppMonitoringAudioFileItem {
  // 播放顺序，升序连播
  segmentIndex: number;
  // 预签名播放地址（24h 有效，勿持久化，每次进页面重新请求）
  audioUrl: string;
  // 本段有效音频时长（毫秒）
  durationMs: number;
  // 本段 WAV 字节数
  audioBytes: number;
  // 本段采集开始时间；设备未上报时为 null
  startedAt?: string | null;
  // 提交类型：MONITORING_REALTIME（实时）/ MONITORING_HISTORY（补传，有卡时多段）
  commitType?: string | null;
}

/** 监控录音分段分页视图（旧 audio-url 单文件口径废弃，新版本一律走本接口）
 *  无卡监控 total=1；有卡多段按 segmentIndex 升序连播；total=0 / items 空表示无音频。 */
export interface IAppMonitoringAudioFilesView {
  items: IAppMonitoringAudioFileItem[];
  total: number;
  page: number;
  pageSize: number;
}

/** 监控详情（AppMonitoringDetailView） */
export interface IAppMonitoringDetailView {
  id: number;
  deviceId: string;
  runId: string;
  status: string;
  startedAt: string;
  endedAt: string;
  // 转写全文
  transcript: string;
  audioFileUrl: string;
  audioBytes: number;
  audioDurationMs: number;
  // 分段转写
  utterances: UTSJSONObject[];
}

/** 监控内容（场景）项（AppMonitoringContentView） */
export interface IAppMonitoringContentView {
  id: number;
  title: string;
  keywords: string[];
  enabled: boolean;
  sortOrder: number;
}

/** 监控设置（AppMonitoringSettingsView） */
export interface IAppMonitoringSettingsView {
  appAlertEnabled: boolean;
  smsAlertEnabled: boolean;
  smsPhones: string[];
  segmentMinutes: number;
  contents: IAppMonitoringContentView[];
}

/** 更新监控设置（POST /monitoring/settings/update；未传字段保持原值） */
export class AppMonitoringSettingsUpdateParams {
  appAlertEnabled: boolean | null = null;
  smsAlertEnabled: boolean | null = null;
  smsPhones: string[] | null = null;
}

/** 监控内容新增/更新（POST /monitoring/contents、/contents/{id}/update） */
export class AppMonitoringContentUpsertParams {
  title: string = "";
  keywords: string[] = [];
  enabled: boolean | null = null;
}
