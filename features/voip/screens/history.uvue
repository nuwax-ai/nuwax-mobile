<template>
  <view class="history-page">
    <safety-zone />
    <view class="history-header"><text class="history-back" @click="leave()">‹</text><text class="history-title">{{ t("Mobile.Voip.history") }}</text><text class="history-clear" @click="clearRecords()">{{ t("Mobile.Voip.clearHistory") }}</text></view>
    <text class="history-note">{{ t("Mobile.Voip.historyLocalOnly") }}</text>
    <text v-if="voipHistory.length == 0" class="history-empty">{{ t("Mobile.Voip.historyEmpty") }}</text>
    <scroll-view v-else class="history-list" scroll-y>
      <view v-for="row in voipHistory" :key="row.callId" class="history-row">
        <view class="history-detail">
          <text class="history-name" :class="{ 'history-missed': row.missed }">{{ row.peerName }}</text>
          <text class="history-meta">{{ direction(row) }} · {{ t(row.mediaType == 'video' ? 'Mobile.Voip.video' : 'Mobile.Voip.audio') }} · {{ formatDate(row.startedAt) }}</text>
          <text v-if="endLabel(row).length > 0" class="history-meta">{{ endLabel(row) }}</text>
        </view>
        <button class="history-call" :disabled="dialing" @click="redial(row)">{{ t("Mobile.Voip.redial") }}</button>
      </view>
    </scroll-view>
  </view>
</template>
<script setup lang="uts">
  import { ref, onMounted } from "vue";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { voipHistory, refreshVoipHistory, clearVoipHistory, startVoipCall } from "@/features/voip/callManager";
  import { VoipHistoryRecord } from "@/features/voip/callHistory";
  import { callEndTranslationKey } from "@/features/voip/callErrors";
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const dialing = ref(false);
  function leave(): void { uni.navigateBack(); }
  function direction(row: VoipHistoryRecord): string { return t(row.missed ? "Mobile.Voip.missed" : (row.direction == "incoming" ? "Mobile.Voip.historyIncoming" : "Mobile.Voip.historyOutgoing")); }
  function formatDate(value: number): string {
    const date = new Date(value);
    return `${date.getFullYear()}-` + `${date.getMonth() + 1}`.padStart(2, "0") + "-" + `${date.getDate()}`.padStart(2, "0") + " " + `${date.getHours()}`.padStart(2, "0") + ":" + `${date.getMinutes()}`.padStart(2, "0");
  }
  function endLabel(row: VoipHistoryRecord): string {
    if (row.connectedAt > 0 && row.endedAt > 0) {
      const seconds = Math.max(0, Math.floor((row.endedAt - row.connectedAt) / 1000));
      return `${Math.floor(seconds / 60)}`.padStart(2, "0") + ":" + `${seconds % 60}`.padStart(2, "0");
    }
    const key = callEndTranslationKey(row.reason); return key.length > 0 ? t(key) : "";
  }
  async function redial(row: VoipHistoryRecord): Promise<void> {
    if (dialing.value) return;
    dialing.value = true;
    try { await startVoipCall(row.convId, row.mediaType); } finally { dialing.value = false; }
  }
  function clearRecords(): void {
    uni.showModal({ title: t("Mobile.Voip.clearHistory"), content: t("Mobile.Voip.clearHistoryConfirm"), success: (result) => { if (result.confirm) clearVoipHistory(); } });
  }
  onMounted(() => { refreshVoipHistory(); });
</script>
<style scoped>
  .history-page { flex: 1; background-color: #f5f6fa; }
  .history-header { height: 52px; flex-direction: row; align-items: center; padding: 0 16px; }
  .history-back { width: 32px; font-size: 32px; color: #242a38; }.history-title { flex: 1; font-size: 20px; color: #242a38; }
  .history-clear { font-size: 13px; color: #3568cf; }.history-note { padding: 12px 16px; font-size: 12px; color: #777e8e; }
  .history-empty { margin-top: 80px; text-align: center; font-size: 15px; color: #777e8e; }.history-list { flex: 1; }
  .history-row { flex-direction: row; align-items: center; background-color: #ffffff; padding: 16px; margin-bottom: 1px; }
  .history-detail { flex: 1; }.history-name { font-size: 16px; color: #242a38; }.history-missed { color: #d83949; }
  .history-meta { font-size: 12px; color: #777e8e; margin-top: 6px; }.history-call { font-size: 13px; color: #3568cf; background-color: #edf2ff; margin-left: 12px; }
</style>
