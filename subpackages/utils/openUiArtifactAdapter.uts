/**
 * OpenUI RENDER_UI 专用 SSE 适配器。
 *
 * 对齐 nuwax Web 的 applyOpenUiToolCallSseEvent：后端以
 * `eventType=PROCESSING + subEventType=RENDER_UI` 下发一等公民事件，真实结果位于
 * `data.result`，openui-ref 位于 `result.data`（或 `result.data.output` JSON 字符串）。
 *
 * UTS（编译到 Kotlin）：动态字段访问一律走 UTSJSONObject["key"]（readField），
 * 不使用 (x as any).field；可空返回值先判空。
 */
import { firstNullableString } from "@/utils/utsCoalesce";
import {
  extractOpenUiArtifactInfo,
  isOpenUiRenderToolName,
  OpenUiArtifactInfo,
} from "@/utils/openUiSchema.uts";
import { readRawField } from "@/subpackages/utils/messageInfoClass.uts";
import { ProcessingEnum } from "@/types/enums/common.uts";

const RENDER_UI_EVENT_NAME = "Backend.Sandbox.Event.renderUI";

function mapRenderUiStatus(raw: any | null): ProcessingEnum {
  const status = raw != null ? `${raw}`.toLowerCase() : "";
  if (status == "failed" || status == "error") {
    return ProcessingEnum.FAILED;
  }
  if (status == "completed" || status == "finished") {
    return ProcessingEnum.FINISHED;
  }
  return ProcessingEnum.EXECUTING;
}

/** 取第一个非空 ID（兼容 number / string，避免 firstNullableString 拒收数字）。 */
function firstIdCandidate(values: (any | null)[]): string {
  for (let i = 0; i < values.length; i++) {
    const v = values[i];
    if (v == null) {
      continue;
    }
    const s = `${v}`.trim();
    if (s.length > 0 && s != "null" && s != "undefined") {
      return s;
    }
  }
  return "";
}

/** 是否是最新契约的 RENDER_UI 专用 PROCESSING 事件。 */
function isRenderUiProcessingEvent(envelope: any, data: any): boolean {
  const subEventType = firstNullableString([
    readRawField(data, "subEventType"),
    readRawField(data, "sub_event_type"),
    readRawField(envelope, "subEventType"),
    readRawField(envelope, "sub_type"),
    readRawField(envelope, "sub_event_type"),
  ]);
  if (subEventType == "RENDER_UI") {
    return true;
  }
  const result = readRawField(data, "result");
  const name = firstNullableString([
    readRawField(data, "name"),
    readRawField(result, "name"),
  ]);
  const normalizedName = name.toLowerCase();
  // 最新契约只接受 RENDER_UI 专用事件名；普通 nuwax_render_openui ToolCall 不在此处吞掉。
  return normalizedName == "renderui" || normalizedName.endsWith(".renderui");
}

/**
 * 将最新 RENDER_UI 报文规范为移动端通用 ProcessingInfo 结构。
 * 返回 null 表示不是 RENDER_UI，调用方继续走普通 PROCESSING 适配。
 *
 * 后端契约（用户实报文）：
 *   name=Backend.Sandbox.Event.renderUI, type=Event, subEventType=RENDER_UI,
 *   result.data.output 常为 JSON 字符串（内含 nuwax.openui-ref / path）。
 * 必须：① 把 type 改成 ToolCall（避免 groupMarkdownContainers / container 当 Event 丢掉）；
 *       ② 对整棵 result 做 BFS（含 data.output 字符串解析），不能只读 result.data 对象字面量。
 */
export function normalizeRenderUiProcessingData(
  envelope: any,
  data: any,
): UTSJSONObject | null {
  const peekResult = readRawField(data, "result");

  if (!isRenderUiProcessingEvent(envelope, data)) {
    return null;
  }

  const result = peekResult;
  // 整棵 result BFS：覆盖 result.data 为 openui-ref，或 result.data.output 为 JSON 字符串。
  const artifact = extractOpenUiArtifactInfo(result);
  const executeId = firstIdCandidate([
    readRawField(data, "executeId"),
    result != null ? readRawField(result, "executeId") : null,
    result != null ? readRawField(result, "id") : null,
    artifact != null ? artifact.artifactId : null,
  ]);
  // 无稳定 executeId 时仍构造块：用 name 兜底，保证正文能插入 markdown-custom-process。
  const resolvedExecuteId =
    executeId.length > 0 ? executeId : "render-ui-pending";

  const status = mapRenderUiStatus(
    firstNullableString([
      readRawField(data, "status"),
      result != null ? readRawField(result, "status") : null,
    ]),
  );
  const name = firstNullableString(
    [
      readRawField(data, "name"),
      result != null ? readRawField(result, "name") : null,
    ],
    RENDER_UI_EVENT_NAME,
  );

  // 对齐 Web applyOpenUiToolCallSseEvent：把解析后的 openui-ref 提升到
  // result.data / structuredContent / rawOutput，避免下游只认「对象 ref」而漏掉
  // result.data.output JSON 字符串形态。
  const resultPayload = new UTSJSONObject();
  resultPayload["executeId"] = resolvedExecuteId;
  resultPayload["name"] = name;
  resultPayload["type"] = "ToolCall";
  resultPayload["success"] = status != ProcessingEnum.FAILED;
  resultPayload["error"] = "";
  resultPayload["targetId"] = -1;
  if (result != null) {
    const inputRaw = readRawField(result, "input");
    if (inputRaw != null) {
      resultPayload["input"] = inputRaw;
    }
  }
  if (artifact != null) {
    const refObj = new UTSJSONObject();
    refObj["type"] = "nuwax.openui-ref";
    refObj["artifactId"] = artifact.artifactId;
    refObj["title"] = artifact.title;
    if (artifact.mode.length > 0) {
      const presentation = new UTSJSONObject();
      presentation["mode"] = artifact.mode;
      refObj["presentation"] = presentation;
    }
    resultPayload["data"] = refObj;
    resultPayload["structuredContent"] = refObj;
    const rawOutput = new UTSJSONObject();
    rawOutput["structuredContent"] = refObj;
    resultPayload["rawOutput"] = rawOutput;
  } else if (result != null) {
    // 无 artifact 时仍透传原始 result，供 EXECUTING 占位 / 后续 FINISHED 合并
    const dataRaw = readRawField(result, "data");
    if (dataRaw != null) {
      resultPayload["data"] = dataRaw;
    }
  }

  const out = new UTSJSONObject();
  out["executeId"] = resolvedExecuteId;
  out["name"] = name;
  // 与 Web applier 一致，专用 Event 进入渲染链后按 ToolCall 消费。
  out["type"] = "ToolCall";
  out["status"] = status;
  out["targetId"] = -1;
  out["cardBindConfig"] = null;
  out["result"] = resultPayload;
  return out;
}

function asRecord(value: any | null): UTSJSONObject | null {
  if (value == null || typeof value != "object") {
    return null;
  }
  if (Array.isArray(value)) {
    return null;
  }
  return value as UTSJSONObject;
}

function readField(obj: UTSJSONObject | null, key: string): any | null {
  if (obj == null) {
    return null;
  }
  const val = obj[key];
  return val != null ? val : null;
}

/**
 * 从 SSE chunk 中提取 OpenUI 产物信息；非 OpenUI 渲染工具返回 null。
 * 调用方：AgentDetailService.uts 的 PROCESSING 分支（收到工具结果时）。
 */
export function extractOpenUiArtifactFromChunk(chunk: any): OpenUiArtifactInfo | null {
  const chunkObj = asRecord(chunk);
  if (chunkObj == null) {
    return null;
  }

  // envelope：chunk.data 可能再包一层事件信封。
  let envelope = chunkObj;
  const nested = asRecord(readField(chunkObj, "data"));
  if (
    nested != null &&
    (readField(nested, "eventType") != null ||
      readField(nested, "messageType") != null ||
      readField(nested, "subType") != null)
  ) {
    envelope = nested;
  }

  const dataObj = asRecord(readField(envelope, "data"));
  const data = dataObj != null ? dataObj : envelope;
  const result = asRecord(readField(data, "result"));
  const blockSource = asRecord(readField(data, "blockSource"));

  // 工具名候选：跨 backend 字段位置兼容（readField 返回 Any?，用 firstNullableString）。
  const toolName = firstNullableString([
    readField(data, "name"),
    readField(result, "name"),
    readField(blockSource, "name"),
    readField(chunkObj, "name"),
  ]);
  if (isOpenUiRenderToolName(toolName) == false) {
    return null;
  }

  // 产物 ref 候选载荷：优先 result.data / structuredContent，再回退整块 result/data/chunk。
  const candidates: any[] = [];
  const add = (v: any | null): void => {
    if (v != null) {
      candidates.push(v);
    }
  };
  add(readField(result, "data"));
  add(readField(data, "structuredContent"));
  add(readField(data, "structured_content"));
  add(readField(data, "rawOutput"));
  add(readField(data, "raw_output"));
  add(readField(result, "rawOutput"));
  if (result != null) {
    candidates.push(result);
  }
  if (data != null) {
    candidates.push(data);
  }
  candidates.push(chunkObj);

  for (let i = 0; i < candidates.length; i++) {
    // 数组下标返回 any?，判空。
    const c = candidates[i];
    if (c == null) {
      continue;
    }
    const info = extractOpenUiArtifactInfo(c);
    if (info != null) {
      return info;
    }
  }
  return null;
}
