<template>
  <view class="tk-page">
    <!-- 隐藏 web-view：native 失败时 proxy KaTeX 兜底（App）/ H5 v-html 主路径 -->
    <web-view
      class="markdown-proxy-web"
      id="markdown-proxy-web"
      src="/uni_modules/uni-ai-x/static/proxy-web/proxy-web.html"
      @message="onProxyMsg"
    ></web-view>

    <view class="tk-header">
      <text class="tk-title">数学公式渲染测试</text>
      <text class="tk-sub">x-math（MathRendererCore → native SVG 位图 / proxy 兜底）</text>
    </view>

    <scroll-view class="tk-scroll" direction="vertical">
      <!-- ===== 块级公式 ===== -->
      <view class="tk-case">
        <text class="tk-case-title">1. 短公式 E=mc²</text>
        <x-math latex="E=mc^2" :display-mode="true" />
      </view>

      <view class="tk-case">
        <text class="tk-case-title">2. 求根公式（分数+根号）</text>
        <x-math :latex="mFrac" :display-mode="true" />
      </view>

      <view class="tk-case">
        <text class="tk-case-title">3. 求和公式</text>
        <x-math :latex="mSum" :display-mode="true" />
      </view>

      <view class="tk-case">
        <text class="tk-case-title">4. 高斯积分</text>
        <x-math :latex="mIntegral" :display-mode="true" />
      </view>

      <view class="tk-case">
        <text class="tk-case-title">5. n 次根号 + 分数</text>
        <x-math :latex="mSqrt" :display-mode="true" />
      </view>

      <view class="tk-case">
        <text class="tk-case-title">6. 矩阵</text>
        <x-math latex="\begin{pmatrix} a & b \\ c & d \end{pmatrix}" :display-mode="true" />
      </view>

      <view class="tk-case">
        <text class="tk-case-title">7. 方程组（cases）</text>
        <x-math latex="\begin{cases} x + y = 1 \\ x - y = 3 \end{cases}" :display-mode="true" />
      </view>

      <view class="tk-case">
        <text class="tk-case-title">8. aligned 多行</text>
        <x-math latex="\begin{aligned} a &= b+c \\ d &= e+f \end{aligned}" :display-mode="true" />
      </view>

      <view class="tk-case">
        <text class="tk-case-title">9. 希腊字母</text>
        <x-math latex="\alpha + \beta = \gamma, \quad \Delta = \Theta - \Phi" :display-mode="true" />
      </view>

      <view class="tk-case">
        <text class="tk-case-title">10. 定界符（left/right）</text>
        <x-math :latex="mDelim" :display-mode="true" />
      </view>

      <view class="tk-case">
        <text class="tk-case-title">11. 超长公式（应横滚不换行）</text>
        <x-math latex="f(x)=a_0+a_1x+a_2x^2+a_3x^3+a_4x^4+a_5x^5+a_6x^6+a_7x^7+a_8x^8+a_9x^9" :display-mode="true" />
      </view>

      <!-- ===== 行内混排 ===== -->
      <view class="tk-case">
        <text class="tk-case-title">12. 行内混排</text>
        <view class="tk-inline-row">
          <text class="tk-inline-text">能量方程 </text>
          <x-math latex="E=mc^2" :inline="true" />
          <text class="tk-inline-text"> 描述质能等价。</text>
        </view>
      </view>

      <view class="tk-case">
        <text class="tk-case-title">13. 行内分数</text>
        <view class="tk-inline-row">
          <text class="tk-inline-text">概率 </text>
          <x-math :latex="mInlineFrac" :inline="true" />
          <text class="tk-inline-text"> 服从均匀分布。</text>
        </view>
      </view>

      <!-- ===== 缓存命中测试（同 latex 二次渲染） ===== -->
      <view class="tk-case">
        <text class="tk-case-title">14. 缓存命中（与 #2 同 latex，应秒显不空白）</text>
        <x-math :latex="mFrac" :display-mode="true" />
      </view>

      <!-- ==================== 原生 MTMathView（仅 Android）==================== -->
      <!-- #ifdef APP-ANDROID -->
      <view class="tk-case tk-native-banner">
        <text class="tk-case-title">▼ 以下为 MTMathView 原生渲染对比</text>
      </view>

      <view class="tk-case">
        <text class="tk-case-title">N1. 求根公式</text>
        <x-native-math :latex="mFrac" :display-mode="true" :font-size="22" />
      </view>
      <view class="tk-case">
        <text class="tk-case-title">N2. 矩阵</text>
        <x-native-math latex="\begin{pmatrix} a & b \\ c & d \end{pmatrix}" :display-mode="true" :font-size="22" />
      </view>
      <view class="tk-case">
        <text class="tk-case-title">N3. 方程组</text>
        <x-native-math latex="\begin{cases} x + y = 1 \\ x - y = 3 \end{cases}" :display-mode="true" :font-size="22" />
      </view>
      <!-- #endif -->
    </scroll-view>
  </view>
</template>

<script lang="uts" setup>
import { onMounted, ref } from "vue";
import proxyWeb from "@/uni_modules/uni-ai-x/sdk/proxy-web.uts";

const proxyReady = ref(false);

// ★ UTS 字符串坑：\f（即使 \\f）被编译器当作 form-feed(0x0C) 而非字面 \f。
//   含 \frac 的串须用 BS 拼接绕开（\b \t \r \n \s \p \i 等不受影响，单反斜杠即可）。
//   故 ALL 含 \frac 的公式都在 <script> 里用 BS 构造，模板用 :latex 绑定。
const BS = String.fromCharCode(92);
const mFrac = BS + "frac{-b \\pm \\sqrt{b^2-4ac}}{2a}";
const mSum = "\\sum_{i=1}^{n} i = " + BS + "frac{n(n+1)}{2}";
const mIntegral = "\\int_0^{\\infty} e^{-x^2}\\,dx = " + BS + "frac{\\sqrt{\\pi}}{2}";
const mSqrt = "\\sqrt[3]{x^2+1} + \\sqrt{2} + " + BS + "frac{\\sqrt{5}}{2}";
const mDelim = "f(x) = \\left( " + BS + "frac{a}{b} \\right)^2 + \\left[ " + BS + "frac{1}{2} + " + BS + "frac{1}{3} \\right]";
const mInlineFrac = BS + "frac{1}{2}";

function onProxyMsg(e: UniWebViewMessageEvent) {
  proxyWeb.onWebMsg(e);
}

onMounted(() => {
  // #ifdef WEB
  const el = document.getElementById("markdown-proxy-web");
  proxyWeb.init(el as any, "markdown-proxy-web");
  // #endif
  // #ifndef WEB
  proxyWeb.ensureAppContext("markdown-proxy-web");
  // #endif
  proxyWeb.whenReady((): void => {
    proxyReady.value = true;
  });
});
</script>

<style lang="scss">
.tk-page {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  flex-direction: column;
}
/* 与 chat-conversation-component 对齐：position:fixed 大画布 + 近透明隐藏。
 * uvue 里 position:absolute + 0x0 + 负偏移会破坏外层 flex 高度测量 → scroll-view flex:1 解析失败 → 页面滚不动。
 * fixed 相对视口，完全脱离文档流，不影响兄弟节点布局。iOS WKWebView 也要求在屏内才能 html2canvas。 */
.markdown-proxy-web {
  position: fixed;
  left: 0;
  top: 0;
  width: 2000px;
  height: 800px;
  opacity: 0.01;
  overflow: hidden;
  pointer-events: none;
  z-index: -1;
}
.tk-header {
  padding: 24rpx;
  background-color: #fff;
  border-bottom: 1px solid #eee;
}
.tk-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}
.tk-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.tk-scroll {
  flex: 1;
}
.tk-case {
  background-color: #fff;
  margin: 16rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 1px solid #eee;
}
.tk-case-title {
  font-size: 26rpx;
  color: #0066cc;
  margin-bottom: 16rpx;
}
.tk-inline-row {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}
.tk-inline-text {
  font-size: 32rpx;
  color: #404040;
}
.tk-native-banner {
  background-color: #f0f8ff;
}
</style>
