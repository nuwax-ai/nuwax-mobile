/**
 * nuwax-ratex 统一渲染契约。用 type 字面量（与 uni-cmark interface.uts 同模式，
 * 可被 utssdk/index.uts 具名 import 后用类型注解）。
 *
 * App：Rust（libratex_ffi.so）→ DisplayList → Canvas → Bitmap → WebP dataURL
 * H5 / 小程序：WASM → Canvas 2D → dataURL（后续）
 */

/** 渲染选项。 */
export type RatexRenderOptions = {
	/** true=块级（display style），false/缺省=行内（text style） */
	displayMode: boolean;
	/** 字号（px）；缺省行内 16、块级 13 */
	fontSize: number;
	/** 公式颜色 "#RRGGBB"；缺省 "#404040" */
	color: string;
};

/** 渲染结果。 */
export type RatexRenderResult = {
	/** WebP/PNG dataURL，喂 <image :src>；失败为空 */
	imageDataURL: string;
	/** CSS 1x 逻辑宽（px） */
	width: number;
	/** CSS 1x 逻辑高（px） */
	height: number;
	/** 失败信息；成功为空 */
	errMsg: string;
};
