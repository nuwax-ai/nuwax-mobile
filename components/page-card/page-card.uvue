<template>
  <view
    class="page-card-container flex flex-col relative"
    hover-class="page-card-container-active"
    @click="handleClick"
  >
    <!-- 封面图 -->
    <view class="flex items-center content-center cover-image-container">
      <image
        v-if="coverImg != null && coverImg != ''"
        class="cover-image-container__image"
        :src="coverImg"
        :alt="t('Mobile.Common.coverImageAlt')"
      />
      <text v-else class="no-screenshot">{{
        t("Mobile.PageCard.noPreviewImage")
      }}</text>
    </view>
    <!-- 卡片内容 -->
    <view class="flex flex-col card-content">
      <view class="flex flex-row items-center agent-info-box">
        <!-- 智能体名称 -->
        <view class="flex-1 agent-name text-ellipsis">{{ name }}</view>
        <!-- 使用人数 -->
        <view class="stat-item">
          <image :src="iconUser" class="stat-icon" alt="" />
          <text class="stat-value">{{ userCount != null ? userCount : 0 }}</text>
        </view>
        <!-- 收藏按钮 -->
        <view
          class="stat-item"
          hover-class="stat-item-active"
          @click.stop.prevent="handleCollect"
        >
          <svg-icon name="icon-Star" customClass="stat-icon" v-if="collect != true" />
          <svg-icon name="icon-Star-fill" customClass="stat-icon" v-else />
          <text class="stat-value">{{ collectCount != null ? collectCount : 0 }}</text>
        </view>
      </view>
      <!-- 用户信息 -->
      <view class="flex flex-row items-center justify-between user-info-box">
        <view class="user-info-left flex flex-row items-center">
          <image
            class="avatar"
            :src="avatar != null && avatar != '' ? avatar : defaultAvatar"
            :alt="t('Mobile.Common.avatarAlt')"
            @error="handleError"
          />
          <text class="user-name text-ellipsis">
            {{ userName }}
          </text>
        </view>
        <text class="created-time text-ellipsis" v-if="formattedCreated != null && formattedCreated != ''">
          {{ formattedCreated }}
        </text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import defaultAvatar from "@/static/assets/avatar.png";
  import iconUser from "@/static/assets/icon_user.png";
  import { computed, ref } from "vue";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const _params = emptyI18nParams();
  const t = (key: string): string => translateFn(key, _params, "");

  const props = defineProps<{
    coverImg: string;
    name: string;
    avatar: string;
    userName?: string;
    created?: string;
    collectCount?: number;
    userCount?: number;
    collect?: boolean;
  }>();

  const formattedCreated = computed(() => {
    if (props.created == null || props.created == "") return "";
    const date = new Date(props.created);
    const year = date.getFullYear();
    const month = `${date.getMonth() + 1}`.padStart(2, "0");
    const day = `${date.getDate()}`.padStart(2, "0");
    return `${year}-${month}-${day}`;
  });

  const currentAvatar = ref<string>(props.avatar);

  const emit = defineEmits(["click", "collect"]);

  const handleError = () => {
    currentAvatar.value = defaultAvatar;
  };

  const handleClick = () => {
    emit("click");
  };

  const handleCollect = (e: UniPointerEvent) => {
    // 阻止冒泡到卡片 @click，避免收藏时进入详情
    e.stopPropagation();
    emit("collect");
  };
</script>

<style lang="scss" scoped>
  .page-card-container {
    padding: 24rpx 32rpx;
  }

  .page-card-container-active {
    background-color: rgba(12, 20, 102, 0.04);
  }

  .cover-image-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 400rpx;
    border-radius: 12rpx;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.4);
  }

  .cover-image-container__image {
    width: 100%;
    height: 100%;
  }

  .no-screenshot {
    font-size: 28rpx;
    color: rgba(0, 0, 0, 0.45);
  }

  .agent-info-box {
    padding: 12rpx 0;
  }

  .agent-name {
    line-height: 56rpx;
    font-size: 28rpx;
    color: #15171f;
    margin-right: 12rpx;
  }

  .stat-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: row;
    padding: 8rpx 16rpx;
    border-radius: 8rpx;
    margin-right: 12rpx;
  }

  .stat-item:last-child {
    margin-right: 0;
  }

  .stat-icon {
    margin-right: 8rpx;
  }

  .stat-item-active {
    background-color: rgba(12, 20, 102, 0.04);
  }

  .stat-icon {
    width: 32rpx;
    height: 32rpx;
  }

  .stat-value {
    font-size: 28rpx;
    color: rgba(21, 23, 31, 0.5);
    font-weight: 400;
  }

  .agent-info-box {
    margin-bottom: 12rpx;
  }

  .user-info-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .user-info-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 1;
    margin-right: 16rpx;
    overflow: hidden;
  }

  .avatar {
    width: 48rpx;
    height: 48rpx;
    border-radius: 24rpx;
    flex-shrink: 0;
    overflow: hidden;
    margin-right: 12rpx;
  }

  .user-name {
    flex: 1;
    font-size: 24rpx;
    color: rgba(21, 23, 31, 0.5);
  }

  .created-time {
    text-align: right;
    flex-shrink: 0;
    font-size: 24rpx;
    color: rgba(21, 23, 31, 0.5);
  }
</style>
