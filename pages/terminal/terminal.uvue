<template>
  <view class="container relative flex flex-col">
    <!-- 顶部导航栏 -->
    <custom-nav-bar :title="t('Mobile.Nav.terminal')" className="border-b" hasSafetyZone />

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <!-- 设备列表 -->
      <view class="card-group">
        <view
          v-for="device in deviceList"
          :key="device.deviceType"
          class="row-item"
          hover-class="row-item-active"
          @click="handleDeviceClick(device)"
        >
          <view class="row-avatar">
            <text class="row-avatar-emoji">{{ device.icon }}</text>
          </view>
          <view class="row-info">
            <text class="row-title">{{ device.name }}</text>
            <text class="row-desc">{{ device.desc }}</text>
          </view>
          <view class="row-status">
            <view :class="['status-dot', device.connected ? '' : 'status-dot-off']"></view>
            <text :class="['status-text', device.connected ? '' : 'status-text-off']">
              {{ device.connected ? t("Mobile.Terminal.connected") : t("Mobile.Terminal.disconnected") }}
            </text>
          </view>
          <text class="row-arrow">›</text>
        </view>
      </view>

      <!-- 添加搭子灵珠 -->
      <view class="add-card" hover-class="add-card-active" @click="handleAddDevice">
        <view class="add-icon">
          <text class="add-icon-plus">+</text>
        </view>
        <view class="add-info">
          <text class="add-title">{{ t("Mobile.Terminal.addDevice") }}</text>
          <text class="add-desc">{{ t("Mobile.Terminal.addDeviceDesc") }}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>

      <!-- 产品购买卡 -->
      <view class="product-card">
        <view class="product-icon">
          <text class="product-icon-emoji">🔮</text>
        </view>
        <text class="product-name">{{ t("Mobile.Terminal.productName") }}</text>
        <text class="product-sub">{{ t("Mobile.Terminal.productSub") }}</text>
        <text class="product-price">¥299</text>

        <view class="product-features">
          <view class="feature-item" v-for="(feature, index) in productFeatures" :key="index">
            <view class="feature-icon">
              <text class="feature-check">✓</text>
            </view>
            <text class="feature-text">{{ feature }}</text>
          </view>
        </view>

        <view class="buy-btn" hover-class="buy-btn-active" @click="handleBuy">
          <text class="buy-btn-text">{{ t("Mobile.Terminal.buyNow") }}</text>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <desk-buddy-order-modal ref="orderFormModalRef" />
  </view>
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import DeskBuddyOrderModal from "./components/desk-buddy-order-modal.uvue";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // 终端设备（静态假数据）
  class TerminalDevice {
    deviceType: string = "";
    name: string = "";
    desc: string = "";
    icon: string = "";
    connected: boolean = false;
    constructor(deviceType: string, name: string, desc: string, icon: string, connected: boolean) {
      this.deviceType = deviceType;
      this.name = name;
      this.desc = desc;
      this.icon = icon;
      this.connected = connected;
    }
  }

  const deviceList = ref<TerminalDevice[]>([
    new TerminalDevice("lingzhu", "灵珠", "搭子终端", "🔮", true),
    new TerminalDevice("computer", "我的电脑", "电脑终端", "💻", true),
  ]);

  // 产品特性（静态假数据）
  const productFeatures = ref<string[]>([
    "五色石设计 · 桌面玩偶形态",
    "语音唤醒 · 调度全部智能体",
    "2.8英寸表情屏幕 · 20+动态表情",
    "蓝牙/WiFi双模 · 48h续航",
  ]);

  // 点击设备，进入设备详情
  const handleDeviceClick = (device: TerminalDevice) => {
    uni.navigateTo({
      url: `/subpackages/pages/terminal/terminal-device-detail?deviceType=${device.deviceType}&name=${encodeURIComponent(device.name)}`,
    });
  };

  // 添加搭子灵珠，跳现有蓝牙配网扫描流程
  const handleAddDevice = () => {
    uni.navigateTo({
      url: "/subpackages/pages/provision/provision-scan/provision-scan",
    });
  };

  const orderFormModalRef = ref<any | null>(null);

  const callOrderFormMethod = (methodName: string): void => {
    const modal = orderFormModalRef.value;
    if (modal == null) return;
    (modal as ComponentPublicInstance).$callMethod(methodName);
  };

  // 立即购买
  const handleBuy = () => {
    callOrderFormMethod("open");
  };

  onLoad((options: any) => {
    setCurrentPageNavigationBarTitle();
  });
</script>

