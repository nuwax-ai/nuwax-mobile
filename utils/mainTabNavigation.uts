import { nextTick, ref } from "vue";
import { CUSTOM_TAB_BAR_ENABLED } from "@/constants/customTabBar.constants";
import { closeAllPopups } from "@/utils/popupBackRegistry";

/** 自定义 Tab 只切换内容；此页面在主界面期间始终保留。 */
export const MAIN_TAB_PAGE = "/pages/tab-shell/tab-shell";
export const MAIN_TAB_PATHS: string[] = [
  "/pages/message/message",
  "/pages/index/index",
  "/pages/expert-list/expert-list",
  // #ifndef APP-IOS
  "/pages/app-dev/app-dev",
  // #endif
  "/pages/mine/mine",
];
export const mainTabActivePath = ref<string>(MAIN_TAB_PATHS[0]);
export const mainTabPageVisible = ref<boolean>(false);
export const mainTabBarCovered = ref<boolean>(false);

class MainTabSwitchResult implements AsyncApiSuccessResult {
  errMsg: string;

  constructor(errMsg: string) {
    this.errMsg = errMsg;
  }
}

export function mainTabPathOnly(url: string): string {
  const path = url.split("?")[0].split("#")[0];
  return path.startsWith("/") ? path : `/${path}`;
}

export function isMainTabPath(url: string): boolean {
  return MAIN_TAB_PATHS.includes(mainTabPathOnly(url));
}

/** 对外保持原来的业务路由，避免 backUrl、登录回跳暴露容器页。 */
export function resolveMainTabPagePath(route: string): string {
  const path = mainTabPathOnly(route);
  if (CUSTOM_TAB_BAR_ENABLED && path == MAIN_TAB_PAGE) {
    return mainTabActivePath.value;
  }
  return path;
}

/** Web 切换内容时同步当前选项，刷新后仍回到同一 Tab，不重新导航页面。 */
export function syncMainTabLocation(): void {
  // #ifdef H5 || WEB
  const rawHashPath = window.location.hash.split("?")[0];
  const hashPath = rawHashPath.length > 0 ? rawHashPath : "#/";
  const nextUrl = `${window.location.pathname}${window.location.search}${hashPath}?tab=${encodeURIComponent(mainTabActivePath.value)}`;
  window.history.replaceState(window.history.state, "", nextUrl);
  // #endif
}

export function selectMainTab(index: number): void {
  if (index >= 0 && index < MAIN_TAB_PATHS.length) {
    if (mainTabActivePath.value != MAIN_TAB_PATHS[index]) closeAllPopups();
    mainTabActivePath.value = MAIN_TAB_PATHS[index];
  }
}

function completeMainTabSwitch(options: SwitchTabOptions): void {
  // 等内容的响应式切换完成，再通知依赖切换结果的业务（如 iOS 常驻聊天壳）。
  nextTick((): void => {
    const result = new MainTabSwitchResult("switchTab:ok");
    options.success?.(result);
    options.complete?.(result);
  });
}

function failMainTabSwitch(options: SwitchTabOptions, error: IUniError): void {
  options.fail?.(error as SwitchTabFail);
  options.complete?.(new MainTabSwitchResult(error.errMsg));
}

/** 小程序继续使用原生 switchTab；App / Web 复用常驻容器。 */
export function switchMainTab(options: SwitchTabOptions): void {
  const path = mainTabPathOnly(options.url);
  if (!CUSTOM_TAB_BAR_ENABLED || !isMainTabPath(path)) {
    uni.switchTab(options);
    return;
  }
  selectMainTab(MAIN_TAB_PATHS.indexOf(path));
  const pages = getCurrentPages();
  for (let i = pages.length - 1; i >= 0; i--) {
    const page = pages[i];
    if (page == null || mainTabPathOnly(`${page.route}`) != MAIN_TAB_PAGE) continue;
    const delta = pages.length - 1 - i;
    if (delta == 0) {
      completeMainTabSwitch(options);
    } else {
      uni.navigateBack({
        delta: delta,
        success: () => completeMainTabSwitch(options),
        fail: (error) => failMainTabSwitch(options, error),
      });
    }
    return;
  }
  // 冷启动 / 登录落地 / 旧路由直达时创建唯一容器。
  uni.reLaunch({
    url: `${MAIN_TAB_PAGE}?tab=${path}`,
    success: () => completeMainTabSwitch(options),
    fail: (error) => failMainTabSwitch(options, error),
  });
}
