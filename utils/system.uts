import { ref, type Ref } from "vue";
import { ALLOW_EXTERNAL_LINK_DOMAIN, getApiBaseUrl } from "@/constants/config";
import { TENANT_CONFIG_INFO } from "@/constants/home.constants";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { apiTenantConfig } from "@/servers/account";
import { apiGetStaticFileList } from "@/servers/agentDev";
import { apiResCode, apiResData } from "@/utils/apiResponse";
import { t } from "@/utils/i18n";
import { isAppWebViewEmbedded } from "@/utils/appWebViewDetect";
import type { TenantConfigInfo } from "@/types/interfaces/login";

/**
 * 获取状态栏高度（兼容 iOS 刘海屏 / 动态岛）
 * iOS 在模块初始化时 getSystemInfoSync 可能返回 0，所以改为延迟调用获取实时值
 */
export const getStatusBarHeight = (): number => {
  const info = uni.getSystemInfoSync();
  // iOS 优先使用 safeAreaInsets.top（更准确，包含刘海/动态岛高度）
  const safeTop = info.safeAreaInsets?.top;
  if (safeTop != null && safeTop > 20) {
    return safeTop;
  }
  return info.statusBarHeight != null ? info.statusBarHeight : 15;
};

export const formatDate = (
  input: string | number | Date | null,
  format: string,
): string => {
  if (input == null) {
    return "-";
  }
  if (typeof input == "string" && input.length == 0) {
    return "-";
  }
  let date: Date | null = null;
  if (input instanceof Date) {
    date = input as Date;
  } else if (typeof input == "number") {
    date = new Date(input as number);
  } else {
    date = new Date(input as string);
  }

  if (date == null) {
    return "-";
  }

  const YYYY = date.getFullYear();
  const MM = `${date.getMonth() + 1}`;
  const DD = `${date.getDate()}`;
  const HH = `${date.getHours()}`;
  const mm = `${date.getMinutes()}`;

  const pad2 = (s: string): string => s.length < 2 ? `0${s}` : s;
  const MM2 = pad2(MM);
  const DD2 = pad2(DD);
  const HH2 = pad2(HH);
  const mm2 = pad2(mm);

  if (format == "YYYY-MM-DD") {
    return `${YYYY}-${MM2}-${DD2}`;
  }
  if (format == "YYYY-MM-DD HH:mm:ss") {
    const ss = pad2(`${date.getSeconds()}`);
    return `${YYYY}-${MM2}-${DD2} ${HH2}:${mm2}:${ss}`;
  }
  if (format == "YYYY-MM-DD HH:mm") {
    return `${YYYY}-${MM2}-${DD2} ${HH2}:${mm2}`;
  }
  if (format == "HH:mm") {
    return `${HH2}:${mm2}`;
  }
  return `${MM2}-${DD2}`;
};

// 判断是否是允许外部链接跳转的域名
export const isAllowExternalLinkDomain = (url: string) => {
  try {
    const targetOrigin = new URL(url).origin;
    if (targetOrigin == getApiBaseUrl()) return true;
    return ALLOW_EXTERNAL_LINK_DOMAIN.some((domain) => targetOrigin == domain);
  } catch (_error) {
    return false;
  }
};

const EXTERNAL_LINK_PAGE_PATH = "/subpackages/pages/external-link/external-link";
const INNER_WEBVIEW_PAGE_PATH = "/subpackages/pages/webview/webview";

function isHttpOrProtocolRelative(url: string): boolean {
  return (
    url.indexOf("http://") == 0 ||
    url.indexOf("https://") == 0 ||
    url.indexOf("//") == 0
  );
}

function normalizeExternalHref(url: string): string {
  if (url.indexOf("//") == 0) {
    return `https:${url}`;
  }
  return url;
}

/**
 * 拼外链预览页路由（url 必须 encode，避免目标地址里的 ?&= 打散本页 query）。
 */
export function buildExternalLinkPageUrl(href: string, title: string = ""): string {
  let path = `${EXTERNAL_LINK_PAGE_PATH}?url=${encodeURIComponent(href)}`;
  if (title.length > 0) {
    path = `${path}&title=${encodeURIComponent(title)}`;
  }
  return path;
}

/**
 * 微信小程序 web-view 内嵌 H5：用 wx.miniProgram.navigateTo 打开原生页。
 * 成功返回 true；非小程序 web-view 或 SDK 未注入返回 false。
 */
export function navigateViaWxMiniProgram(url: string): boolean {
  // #ifdef H5 || WEB
  try {
    const w = window as any;
    if (w == null || w.wx == null) {
      return false;
    }
    const miniProgram = w.wx.miniProgram;
    if (miniProgram == null || miniProgram.navigateTo == null) {
      return false;
    }
    miniProgram.navigateTo({ url: url });
    return true;
  } catch (_e) {
    return false;
  }
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

/**
 * 通过注入的 uni.webview.js（uni.webView.navigateTo）打开原生页。
 * 成功返回 true；JSSDK 未就绪或非内嵌环境返回 false，由调用方回退 uni.navigateTo。
 * 供 App web-view 内嵌 H5 内页面级跳转复用（历史会话 / 文件预览等须压原生栈），
 * 才能与导航栏返回、系统侧滑同源，并避免弹窗登记残留导致 onBackPress 误拦截。
 */
export function navigateViaWebViewSdk(url: string): boolean {
  // #ifdef H5 || WEB
  try {
    const w = window as any;
    if (w == null || w.uni == null) {
      return false;
    }
    const webView = w.uni.webView;
    if (webView == null || webView.navigateTo == null) {
      return false;
    }
    webView.navigateTo({ url: url });
    return true;
  } catch (_e) {
    return false;
  }
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

/**
 * App 内嵌 H5 → 原生：优先 uni.webView.postMessage，
 * 本地调试 H5（Vite / 局域网）经常还没加载到 JSSDK，此时直接走原生注入的
 * __uniapp_x_postMessage（与键盘诊断、商品详情桥同一条通道）。
 */
export function postAppWebViewMessage(payload: UTSJSONObject): boolean {
  // #ifdef H5 || WEB
  try {
    const w = window as any;
    if (w == null) {
      return false;
    }
    if (
      w.uni != null &&
      w.uni.webView != null &&
      w.uni.webView.postMessage != null
    ) {
      w.uni.webView.postMessage({ "data": payload });
      return true;
    }
    if (w.__uniapp_x_postMessage != null) {
      w.__uniapp_x_postMessage({ "data": payload });
      return true;
    }
    if (w.__uniapp_x_ != null && w.__uniapp_x_.postMessage != null) {
      w.__uniapp_x_.postMessage(JSON.stringify({ "data": payload }));
      return true;
    }
  } catch (_e) {
    return false;
  }
  // #endif
  return false;
}

/**
 * 在原生 web-view 页打开 HTTP(S) 外链。
 * App 内嵌 H5：只 postMessage 给承载页（agent-detail），由原生 uni.navigateTo 打开
 * external-link；失败不回退 H5 navigateTo / window.open，避免把聊天页顶掉或看起来没反应。
 */
export function openExternalLinkPage(href: string, title: string = ""): boolean {
  const target = normalizeExternalHref(href);
  if (target.indexOf("http://") != 0 && target.indexOf("https://") != 0) {
    return false;
  }
  const pageUrl = buildExternalLinkPageUrl(target, title);
  if (isAppWebViewEmbedded()) {
    const payload = {} as UTSJSONObject;
    payload["type"] = "app-open-external-link";
    payload["url"] = target;
    if (title.length > 0) {
      payload["title"] = title;
    }
    return postAppWebViewMessage(payload);
  }
  if (navigateViaWxMiniProgram(pageUrl)) {
    return true;
  }
  uni.navigateTo({ url: pageUrl });
  return true;
}

/**
 * 打开聊天 / 业务里的链接。
 * HTTP(S) 外链：App（含内嵌 H5）与微信小程序走独立 web-view 页；
 * 浏览器 H5 仍新开标签。站内相对路径仍走原 webview 页（可带 ticket）。
 */
export const handleExternalLink = (url: string, title: string = "") => {
  if (url == null || url.length == 0) {
    uni.showToast({
      title: t("Mobile.Link.invalidConfig"),
      icon: "none",
    });
    return;
  }

  if (isHttpOrProtocolRelative(url)) {
    const target = normalizeExternalHref(url);

    // #ifdef H5 || WEB
    if (isAppWebViewEmbedded()) {
      if (openExternalLinkPage(target, title) == false) {
        uni.showToast({
          title: t("Mobile.Link.openFailed"),
          icon: "none",
        });
      }
      return;
    }
    if (navigateViaWxMiniProgram(buildExternalLinkPageUrl(target, title))) {
      return;
    }
    try {
      const newWindow = window.open(target, "_blank");
      if (
        newWindow == null ||
        newWindow.closed ||
        typeof newWindow.closed == "undefined"
      ) {
        if (navigator.clipboard != null && navigator.clipboard.writeText != null) {
          navigator.clipboard
            .writeText(target)
            .then((): void => {
              uni.showToast({
                title: t("Mobile.Link.copyAndOpen"),
                icon: "none",
                duration: 3000,
              });
            })
            .catch((): void => {
              window.location.href = target;
            });
        } else {
          window.location.href = target;
        }
      }
    } catch (_error) {
      uni.showToast({
        title: t("Mobile.Link.openFailed"),
        icon: "none",
      });
    }
    return;
    // #endif

    // #ifdef APP || MP-WEIXIN
    openExternalLinkPage(target, title);
    return;
    // #endif
  }

  const innerUrl = `${INNER_WEBVIEW_PAGE_PATH}?url=${encodeURIComponent(url)}`;
  // #ifdef H5 || WEB
  if (isAppWebViewEmbedded() && navigateViaWebViewSdk(innerUrl)) {
    return;
  }
  if (navigateViaWxMiniProgram(innerUrl)) {
    return;
  }
  // #endif
  uni.navigateTo({ url: innerUrl });
};

// 获取用户配置并设置页面标题和缓存租户信息
export const fetchTenantConfig = async () => {
  const res = await apiTenantConfig();
  const code = apiResCode(res);
  const dataRaw = apiResData<any>(res);
  if (code == SUCCESS_CODE && dataRaw != null) {
    const dataObj = dataRaw as UTSJSONObject;
    const siteNameRaw = dataObj["siteName"];
    const siteName = siteNameRaw != null ? `${siteNameRaw}` : "";
    if (siteName != "") {
      // 设置当前页面导航栏标题
      uni.setNavigationBarTitle({ title: siteName });
      // 缓存租户信息
      uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(dataRaw));
    }
  }
};

// 设置当前页面导航栏标题
export const setCurrentPageNavigationBarTitle = async () => {
  // 获取本地用户配置
  const tenantConfigInfoString = uni.getStorageSync(TENANT_CONFIG_INFO);
  if (tenantConfigInfoString != null && tenantConfigInfoString != "") {
    try {
      const tenantConfigStr = tenantConfigInfoString as string;
      const tenantConfig = JSON.parse<UTSJSONObject>(tenantConfigStr);
      if (tenantConfig != null) {
        const siteNameVal = tenantConfig["siteName"];
        if (siteNameVal != null && siteNameVal != "") {
          // 设置当前页面导航栏标题
          uni.setNavigationBarTitle({ title: siteNameVal as string });
          return;
        }
      }
    } catch (error) {
      console.error("获取本地用户配置失败:", error);
    }
  }
  fetchTenantConfig(); // 获取用户配置并设置页面标题和缓存租户信息
};

/**
 * H5 内嵌页的状态栏（刘海）高度（px）。
 * App 端 agent-detail 原生页把 webview 全屏铺满后，顶部刘海区域由内嵌 H5 页面自己处理：
 * 原生侧在 webview URL fragment 追加 &statusBarHeight=xx，H5 侧 onLoad 读取后写入此处，
 * 供 custom-nav-bar / safety-zone 在 H5 内做状态栏占位。0 表示非内嵌或未知（浏览器直开）。
 * 用 ref 保证「onLoad 晚于组件首帧渲染」时（页面生命周期在组件树挂载后才派发）也能响应式补上占位。
 */
const embeddedStatusBarHeight = ref<number>(0);
export const setEmbeddedStatusBarHeight = (height: number): void => {
  embeddedStatusBarHeight.value = height > 0 ? height : 0;
};
export const getEmbeddedStatusBarHeight = (): Ref<number> => embeddedStatusBarHeight;

// 根据会话id和文件路径 跳转至预览页面
export const jumpToFilePreviewPage = (
  conversationId: string,
  fileProxyUrl: string,
) => {
  if (conversationId == null || conversationId.length == 0 || fileProxyUrl == null || fileProxyUrl.length == 0) {
    return;
  }
  const path = "/subpackages/pages/file-preview-page/file-preview-page";
  // fileProxyUrl 是独立 query 值，uni 路由只分隔 &/=，内部 ?/% 无需编码；
  // file-preview-page 端也只做单次 decodeURIComponent。此处不再 encode，避免双重编码。
  // 注意：uni.webView.navigateTo 内部会对整段 url 做 encodeURI，与 file-tree 行为兼容。
  const url = `${path}?cId=${conversationId}&fileProxyUrl=${fileProxyUrl}`;
  // App 内嵌 H5：走 JSSDK 开原生预览页（避免只在 web-view 内 H5 SPA 跳转）
  if (isAppWebViewEmbedded() && navigateViaWebViewSdk(url)) {
    return;
  }
  uni.navigateTo({ url });
};

/**
 * 打开 OpenUI artifact 预览——与文件树点击 .openui.json 打开的是同一个 file-preview-page（有导航栏/返回）。
 * 通过 getFileProxyUrlByConversationIdAndFilePath 获取文件代理 URL，再 jumpToFilePreviewPage 跳转。
 * App 内嵌 H5 时 jumpToFilePreviewPage 会走 uni.webView.navigateTo 开原生页。
 */
export const openOpenUiArtifact = async (
  conversationId: string,
  artifactId: string,
  title: string,
) => {
  const cid =
    conversationId.startsWith("chat-") ? conversationId.substring(5) : conversationId;
  if (cid.length == 0 || artifactId.length == 0) {
    uni.showToast({ title: "无法打开 OpenUI", icon: "none" });
    return;
  }
  try {
    const proxyUrlRaw = await getFileProxyUrlByConversationIdAndFilePath(
      cid,
      `data/${artifactId}.openui.json`,
    );
    const proxyUrl = proxyUrlRaw != null ? `${proxyUrlRaw}` : "";
    if (proxyUrl.length > 0) {
      jumpToFilePreviewPage(cid, proxyUrl);
    } else {
      uni.showToast({ title: "无法打开 OpenUI", icon: "none" });
    }
  } catch (_e) {
    uni.showToast({ title: "打开文件失败", icon: "none" });
  }
};

// 根据会话id查询文件列表并根据文件路径获取到文件代理url
export const getFileProxyUrlByConversationIdAndFilePath = async (
  conversationId: string,
  filePath: string,
) => {
  if (conversationId == null || conversationId.length == 0 || filePath == null || filePath.length == 0) {
    return null;
  }
  // 接口要求 number 类型，先做显式转换并校验，避免把非法字符串传入服务层
  const normalizedConversationId = parseInt(conversationId);
  if (Number.isNaN(normalizedConversationId)) {
    return null;
  }
  const result = await apiGetStaticFileList(normalizedConversationId);
  if (apiResCode(result) == SUCCESS_CODE) {
    const dataRaw = apiResData<any>(result);
    if (dataRaw == null) {
      return null;
    }
    const data = dataRaw as UTSJSONObject;
    const filesRaw = data["files"];
    if (filesRaw == null) {
      return null;
    }
    const files = filesRaw as any[];
    for (let i = 0; i < files.length; i++) {
      const fileRaw = files[i];
      if (fileRaw == null) {
        continue;
      }
      const file = fileRaw as UTSJSONObject;
      const nameRaw = file["name"];
      if (nameRaw != null && `${nameRaw}` == filePath) {
        const proxyUrlRaw = file["fileProxyUrl"];
        return proxyUrlRaw != null ? `${proxyUrlRaw}` : null;
      }
    }
  }
  return null;
};

/**
 * 任务结果数据
 */
type TaskResultData = {
  hasTaskResult : boolean;
  description : string;
  file : string;
}

/**
 * 提取任务结果数据
 * @param text 文本
 * @returns 任务结果数据
 */
export const extractTaskResult = (text: string): TaskResultData => {
  const result: TaskResultData = {
    hasTaskResult: false,
    description: "",
    file: "",
  };

  if (text == null || text.length == 0) return result;

  // 1️⃣ 匹配 <task-result>...</task-result>
  const taskResultMatch = text.match(/<task-result>([\s\S]*?)<\/task-result>/);

  if (taskResultMatch == null) {
    return result;
  }

  result.hasTaskResult = true;
  const taskResultContent = taskResultMatch[1];

  // 2️⃣ 提取 description
  const descriptionMatch = taskResultContent!!.match(
    /<description>([\s\S]*?)<\/description>/,
  );
  if (descriptionMatch != null && descriptionMatch[1] != null) {
    result.description = descriptionMatch[1]!!.trim();
  }

  // 3️⃣ 提取 file
  const fileMatch = taskResultContent!!.match(/<file>([\s\S]*?)<\/file>/);
  if (fileMatch != null && fileMatch[1] != null) {
    result.file = fileMatch[1]!!.trim();
  }

  return result;
};

/**
 * 提取字符串中最后一个 <task-result> 内的 <file> 内容
 * @param text 原始字符串
 * @returns file 内容或 null
 */
export const extractLastTaskResultFile = (text: string): string | null => {
  if (text == null || text.length == 0) return null;

  // 匹配所有 <task-result>...</task-result>
  const taskResultMatches = text.match(/<task-result>[\s\S]*?<\/task-result>/g);

  if (taskResultMatches == null || taskResultMatches.length === 0) {
    return null;
  }

  // 取最后一个 <task-result>
  const lastTaskResult = taskResultMatches[taskResultMatches.length - 1];

  // 在其中提取 <file> 内容
  const fileMatch = lastTaskResult.match(/<file>([\s\S]*?)<\/file>/);

  return fileMatch?.[1]?.trim() ?? null;
};

/**
 * 健壮的千分位数字格式化工具函数（支持整数、浮点数以及负数，带有强健的边界容错降级机制）
 * @param value 输入数值或字符
 * @returns 格式化后的千分位字符串
 */
export function formatNumber(value: any, precision: number = -1): string {
  if (value == null) {
    return "0";
  }
  let str = `${value}`.trim();
  if (str === "" || str === "null" || str === "undefined") {
    return "0";
  }

  const num = Number.parseFloat(str);
  if (Number.isNaN(num) || !Number.isFinite(num)) {
    return "0";
  }

  if (precision >= 0) {
    str = num.toFixed(precision);
  } else {
    str = num.toString();
  }

  const isNegative = str.startsWith("-");
  if (isNegative) {
    str = str.substring(1);
  }

  const parts = str.split(".");
  const integerPart = parts[0];
  const decimalPart = parts.length > 1 ? "." + parts[1] : "";

  let result = "";
  let counter = 0;
  for (let i = integerPart.length - 1; i >= 0; i--) {
    result = integerPart.charAt(i) + result;
    counter++;
    if (counter == 3 && i != 0) {
      result = "," + result;
      counter = 0;
    }
  }

  return (isNegative ? "-" : "") + result + decimalPart;
};

/**
 * 校验并返回订阅功能是否开启 (支持通过缓存快速响应及同步后台最新配置)
 * @returns Promise<boolean>
 */
export const checkSubscriptionEnable = async (): Promise<boolean> => {
  let isEnabled = false;
  // 1. 优先校验本地缓存
  const tenantConfigInfoString = uni.getStorageSync(TENANT_CONFIG_INFO);
  if (tenantConfigInfoString != null && tenantConfigInfoString != "") {
    try {
      const tenantConfig = JSON.parse<UTSJSONObject>(tenantConfigInfoString as string);
      if (tenantConfig != null) {
        const enableSubRaw = tenantConfig["enableSubscription"];
        isEnabled = enableSubRaw != null && (enableSubRaw as number) == 1;
      }
    } catch (error) {
      console.error("Failed to parse tenant config:", error);
    }
  }

  // 2. 实时拉取最新配置进行二次校验和本地同步
  try {
    const res = await apiTenantConfig();
    const code = apiResCode(res);
    const dataRaw = apiResData<any>(res);
    if (code == SUCCESS_CODE && dataRaw != null) {
      const dataObj = dataRaw as UTSJSONObject;
      const enableSub = dataObj["enableSubscription"];
      isEnabled = enableSub != null && (enableSub as number) == 1;
      uni.setStorageSync(TENANT_CONFIG_INFO, JSON.stringify(dataRaw));
    }
  } catch (e) {
    console.error("Failed to sync latest tenant config:", e);
  }

  return isEnabled;
};
