import { nextTick, type ComponentPublicInstance } from "vue";
import AgentDetailData from "./AgentDetailData.uts";

/**
 * 滚动管理层：专门处理滚动相关的逻辑
 * 兼容微信小程序和 H5/App
 * 滚动执行统一走 z-paging-x 的 scrollToY/scrollToBottom（其无 scroll-into-view）。
 */
export default class ScrollManager {
  private data: AgentDetailData;
  /** z-paging-x 实例获取器（视图层构造时注入模板 ref；UTS any 优化下避免 any|null，用 any 判空） */
  private getPagingX: () => any;
  // 记录上次滚动位置，用于判断滚动方向
  private lastScrollTop: number = 0;
  /** 加载更多历史前记录的滚动基座（scrollTop / scrollHeight），加载完成后按高度差补偿恢复视角 */
  private prependBaseScrollTop: number = 0;
  private prependBaseScrollHeight: number = 0;
  /** 历史首屏布局稳定截止时间（ms），期内允许因异步组件撑高而补滚 */
  private historySettleUntil: number = 0;
  /** 历史首屏分批滚底定时器 */
  private historySettleTimers: number[] = [];
  /**
   * 自动滚底节流定时器。
   * leading + trailing：首击立刻滚，窗口内再请求则窗口结束补滚，跟上内容增高。
   */
  private scrollThrottleTimer: number = 0;
  /** 节流窗口内是否还有未消费的滚底请求 */
  private scrollThrottlePending: boolean = false;
  /** trailing 滚底是否需要结构化内容的异步撑高补偿。 */
  private scrollThrottleMayRelayout: boolean = true;
  /**
   * 流式跟底节流（ms）。流式跟底带动画平滑跟随：窗口需接近动画时长的一半，
   * 让每次动画有空间完成——过小（32）动画频繁打断呈抖动，过大（如 100）跟底滞后「慢一步」。
   */
  private readonly SCROLL_THROTTLE_MS: number = 32;
  /** 流式内容晚撑高（工具卡片 / Markdown）后的短补滚定时器 */
  private streamFollowTimers: number[] = [];
  /** setIsInScrollBottom 节流 */
  private bottomCheckTimer: number = 0;
  private pendingScrollTop: number = 0;
  private pendingScrollHeight: number = 0;
  private pendingOffsetHeight: number = 0;
  private readonly BOTTOM_CHECK_MS: number = 80;

  /** 插件 expose 执行回调（组件注入；读取 vsxRef.value 后调 scrollToBottom/scrollToKey） */
  private scrollBottomCb: (() => void) | null = null;
  private scrollKeyCb: ((key: string) => void) | null = null;

  constructor(data: AgentDetailData, getPagingX: () => any) {
    this.data = data;
    this.getPagingX = getPagingX;
  }

  /** 调用 z-paging-x scrollToBottom（Android：$callMethod 调 defineExpose 方法） */
  private invokeScrollToBottom(animate: boolean): void {
    const paging = this.getPagingX();
    if (paging == null) {
      return;
    }
    try {
      const proxy = paging as ComponentPublicInstance;
      proxy.$callMethod("scrollToBottom", animate);
    } catch (_e) {
      // z-paging-x 未挂载 / 已卸载时忽略
    }
  }

  /** 调用 z-paging-x scrollToY（滚动到内容中指定 Y） */
  private invokeScrollToY(y: number, animate: boolean): void {
    const paging = this.getPagingX();
    if (paging == null) {
      return;
    }
    try {
      const proxy = paging as ComponentPublicInstance;
      proxy.$callMethod("scrollToY", y, animate);
    } catch (_e) {
      // ignore
    }
  }

  /**
   * 滚动到最后一条消息
   * 走 z-paging-x scrollToBottom，兼容所有平台
   * @param userClick 是否用户点击触发；true 时启用滚动动画并立刻执行，
   *   并重新开启短时跟底稳定期（上滑打断后点回底，晚撑高 / 流式输出才能继续跟）
   */
  setVsxCallbacks(bottomCb: () => void, keyCb: (key: string) => void): void {
    this.scrollBottomCb = bottomCb;
    this.scrollKeyCb = keyCb;
  }

  /** 调插件 scrollToBottom（跟底 / 回到底 / 流式补滚） */
  private runScrollToBottom(): void {
    const cb = this.scrollBottomCb;
    if (cb != null) {
      (cb as () => void)();
    }
  }

  /** 调插件 scrollToKey（加载更多后定位 / 跳转某消息） */
  private runScrollToKey(key: string): void {
    const cb = this.scrollKeyCb;
    if (cb != null) {
      (cb as (k: string) => void)(key);
    }
  }

  /**
   * 滚动到最后一条消息
   * @param userClick 是否用户点击触发；true 时立刻执行并开启短时跟底稳定期
   * @param contentMayRelayout 当前正文是否可能异步重排（公式/图片）
   */
  scrollToLastMsg(
    userClick: boolean,
    contentMayRelayout: boolean = true,
  ): void {
    // 用户点击：立刻滚底；重新 arm 跟底窗口
    if (userClick == true) {
      this.doScrollToLastMsg(true, true);
      this.armFollowSettle(8000, [
        100, 300, 700, 1200, 2000, 3500, 5000, 7000,
      ]);
      return;
    }
    // 自动滚底：leading 立刻执行；窗口内后续请求记 pending，到点 trailing 再滚
    if (this.scrollThrottleTimer != 0) {
      this.scrollThrottlePending = true;
      if (contentMayRelayout == true) {
        this.scrollThrottleMayRelayout = true;
      }
      return;
    }
    this.scrollThrottleMayRelayout = contentMayRelayout;
    this.doScrollToLastMsg(false, contentMayRelayout);
    this.scrollThrottlePending = false;
    this.scrollThrottleTimer = setTimeout((): void => {
      this.scrollThrottleTimer = 0;
      if (this.scrollThrottlePending == true) {
        this.scrollThrottlePending = false;
        const mayRelayout = this.scrollThrottleMayRelayout;
        this.scrollThrottleMayRelayout = false;
        this.doScrollToLastMsg(false, mayRelayout);
      }
    }, this.SCROLL_THROTTLE_MS) as number;
  }

  /** 实际执行滚底（z-paging-x 无 scroll-into-view，走 scrollToBottom） */
  private doScrollToLastMsg(userClick: boolean, contentMayRelayout: boolean = false): void {
    this.data.autoToLastMsg.value = true;
    this.data.scrollWithAnimation.value = userClick;
    nextTick(() => {
      this.invokeScrollToBottom(userClick);
      this.data.scrollInBottom.value = true;
    });
    // 自动跟底：布局晚到（工具调用卡片等）时短时补滚
    if (contentMayRelayout == true) {
      this.scheduleStreamFollowRetries();
    }
  }

  private clearScrollThrottle(): void {
    if (this.scrollThrottleTimer != 0) {
      clearTimeout(this.scrollThrottleTimer);
      this.scrollThrottleTimer = 0;
    }
    this.scrollThrottlePending = false;
    this.scrollThrottleMayRelayout = true;
  }

  private clearStreamFollowRetries(): void {
    for (let i = 0; i < this.streamFollowTimers.length; i++) {
      clearTimeout(this.streamFollowTimers[i]);
    }
    this.streamFollowTimers = [];
  }

  /**
   * 流式自动跟底后短补滚：等工具卡片 / Markdown 撑高再滚一次。
   * 用户上滑（autoToLastMsg=false / scrollTouch）时立刻停。
   * 每次补滚前都校验 autoToLastMsg/scrollTouch，用户上滑立即停。
   */
  private scheduleStreamFollowRetries(): void {
    this.clearStreamFollowRetries();
    const delays = [120, 140, 160];
    for (let i = 0; i < delays.length; i++) {
      const delay = delays[i];
      const timerId = setTimeout((): void => {
        if (this.data.autoToLastMsg.value != true) {
          this.clearStreamFollowRetries();
          return;
        }
        if (this.data.scrollTouch.value == true) {
          return;
        }
        // 绕过节流，直接滚底，吃到晚到的高度（补滚沿用流式动画设置，平滑补位）
        this.invokeScrollToBottom(false);
        this.data.scrollInBottom.value = true;
      }, delay) as number;
      this.streamFollowTimers.push(timerId);
    }
  }

  /**
   * 开启跟底稳定窗口：分批补滚（绕过流式节流）。
   * 历史首屏 / 用户点「回底」后内容仍可能继续撑高时使用。
   */
  private armFollowSettle(durationMs: number, delays: number[]): void {
    this.clearHistorySettle();
    this.clearScrollThrottle();
    this.data.autoToLastMsg.value = true;
    this.historySettleUntil = Date.now() + durationMs;

    for (let i = 0; i < delays.length; i++) {
      const delay = delays[i];
      const timerId = setTimeout((): void => {
        this.tryScrollDuringHistorySettle();
      }, delay) as number;
      this.historySettleTimers.push(timerId);
    }
  }

  /**
   * 历史消息加载后延迟滚到底部（无动画）。
   * 首屏含数学公式 / table / 卡片等异步撑高时，单次滚底往往已过期，
   * 故在稳定窗口内分批重试。插件 scrollToBottom 锚点恒挂载（#vsx-bottom-anchor），虚拟化下仍可达。
   */
  scrollToLastMsgAfterHistoryLoad(): void {
    this.armFollowSettle(7000, [0, 200, 800, 1600, 2800, 4500, 6500]);
  }

  /** 公式批量上屏补滚防抖，避免多条消息各自 emit 导致连续滚底抖动 */
  private contentReadyNudgeTimer: number = 0;

  /**
   * 消息富文本/公式一次性上屏后补滚到底。
   * 多条历史消息公式齐活时间不同，须防抖合并，否则会连滚多次造成页面抖。
   */
  nudgeAfterContentReady(): void {
    if (this.data.scrollTouch.value == true) {
      return;
    }
    if (this.data.autoToLastMsg.value != true) {
      return;
    }
    if (this.contentReadyNudgeTimer != 0) {
      clearTimeout(this.contentReadyNudgeTimer);
    }
    this.contentReadyNudgeTimer = setTimeout((): void => {
      this.contentReadyNudgeTimer = 0;
      if (this.data.scrollTouch.value == true) {
        return;
      }
      if (this.isHistorySettling() == true) {
        this.tryScrollDuringHistorySettle();
        return;
      }
      // 稳定期已过：短开窗口盖住公式撑高
      this.armFollowSettle(1800, [0, 120, 400, 900, 1500]);
    }, 280) as number;
  }

  /**
   * 发送消息后滚底（含语音转写发送）。
   * 须在用户/助手气泡已写入 messageList 之后调用：
   * 发送前那次滚底打在旧布局上；流式期 list watch 又会跳过滚底，
   * iOS 上语音发送后常见停在旧位置。短窗口分批补滚覆盖布局晚到。
   */
  scrollToLastMsgAfterSend(): void {
    this.armFollowSettle(2500, [0, 80, 200, 450, 900, 1600]);
  }

  /** 页面卸载时清理历史滚底 / 节流滚底定时器 */
  dispose(): void {
    this.clearHistorySettle();
    this.clearScrollThrottle();
    this.clearStreamFollowRetries();
    if (this.contentReadyNudgeTimer != 0) {
      clearTimeout(this.contentReadyNudgeTimer);
      this.contentReadyNudgeTimer = 0;
    }
    if (this.bottomCheckTimer != 0) {
      clearTimeout(this.bottomCheckTimer);
      this.bottomCheckTimer = 0;
    }
  }

  private isHistorySettling(): boolean {
    return Date.now() <= this.historySettleUntil;
  }

  private clearHistorySettle(): void {
    for (let i = 0; i < this.historySettleTimers.length; i++) {
      clearTimeout(this.historySettleTimers[i]);
    }
    this.historySettleTimers = [];
    this.historySettleUntil = 0;
  }

  /**
   * 稳定期内尝试滚底；用户手指上滑打断时立即结束稳定期。
   * 直接 doScroll，绕过流式节流，保证 table 等晚撑高后仍能补滚到底。
   */
  private tryScrollDuringHistorySettle(): void {
    if (this.isHistorySettling() == false) {
      return;
    }
    if (this.data.autoToLastMsg.value != true) {
      this.clearHistorySettle();
      return;
    }
    if (this.data.scrollTouch.value == true) {
      this.clearHistorySettle();
      return;
    }
    // 历史首屏：绕过 throttle，每次补滚都真正滚到底
    this.clearScrollThrottle();
    this.doScrollToLastMsg(false, true);
  }

  /**
   * 滚动状态输入（组件 onVsxScroll 读取插件 #vsx-container 的 metrics 后调用）。
   * - 历史稳定期内立即处理；流式期 80ms 节流。
   * - 维护 scrollInBottom（回到底按钮可见性）/ autoToLastMsg（上滑打断）状态机。
   */
  applyScrollStateThrottled(
    scrollTop: number,
    scrollHeight: number,
    offsetHeight: number,
  ): void {
    if (this.isHistorySettling() == true) {
      if (this.bottomCheckTimer != 0) {
        clearTimeout(this.bottomCheckTimer);
        this.bottomCheckTimer = 0;
      }
      this.applyScrollStateNow(scrollTop, scrollHeight, offsetHeight);
      return;
    }
    this.pendingScrollTop = scrollTop;
    this.pendingScrollHeight = scrollHeight;
    this.pendingOffsetHeight = offsetHeight;
    if (this.bottomCheckTimer != 0) {
      return;
    }
    this.bottomCheckTimer = setTimeout((): void => {
      this.bottomCheckTimer = 0;
      this.applyScrollStateNow(
        this.pendingScrollTop,
        this.pendingScrollHeight,
        this.pendingOffsetHeight,
      );
    }, this.BOTTOM_CHECK_MS) as number;
  }

  private applyScrollStateNow(
    scrollTop: number,
    scrollHeight: number,
    offsetHeight: number,
  ): void {
    const oh = offsetHeight > 0 ? offsetHeight : 600;
    const diff: number = scrollHeight - scrollTop - oh;
    const isInBottom = diff < 50;
    this.data.scrollInBottom.value = isInBottom;

    const isScrollingUp = scrollTop < this.lastScrollTop;
    this.lastScrollTop = scrollTop;
    const userScrolling =
      this.data.scrollTouch.value == true ||
      this.data.mouseScroll.value == true;

    // 手指/滚轮上滑：立刻停跟底（以前要求先离开底部 50px，导致「上滑一点点」仍被判在底部）
    if (userScrolling == true && isScrollingUp == true) {
      this.data.autoToLastMsg.value = false;
      if (isInBottom != true) {
        this.data.scrollInBottom.value = false;
      }
      this.clearStreamFollowRetries();
      if (this.isHistorySettling() == true) {
        this.clearHistorySettle();
      }
      return;
    }

    // 非上滑且已在底部（滑回底 / 程序滚底）：恢复跟底
    if (isInBottom == true) {
      this.data.autoToLastMsg.value = true;
    }
  }

  /**
   * 锁定自动滚动到底部
   */
  lockAutoToLastMsg(): void {
    if (this.data.needSetLockAutoToLastMsg.value != true) return;
    if (this.data.messageList.value.length === 0) {
      this.data.autoToLastMsg.value = false;
      this.data.needSetLockAutoToLastMsg.value = false;
    }
  }

  /**
   * 滚动事件处理
   * 修复：不再错误地设置 mouseScroll，让触摸和鼠标滚动分开处理
   */
  onScroll(e: UniScrollEvent): void {
    // mouseScroll 只在 H5 平台由 wheel 事件设置，这里不设置
    // 触摸滚动由 touchstart/touchend 事件控制 scrollTouch
    this.setIsInScrollBottom(e);
    this.data.scrolling.value = true;
    if (this.data.scrollingT.value != 0) {
      clearTimeout(this.data.scrollingT.value);
    }
    this.data.scrollingT.value = setTimeout(() => {
      this.data.scrolling.value = false;
    }, 500);
  }

  /**
   * 加载更多历史前记录滚动基座（scrollTop / scrollHeight）。
   * 须在向 messageList 头部前插旧消息之前调用，恢复视角靠加载后的高度差补偿。
   */
  captureHistoryPrependBase(): void {
    const list = uni.getElementById("msg-list");
    if (list == null) {
      return;
    }
    this.prependBaseScrollTop = list.scrollTop;
    this.prependBaseScrollHeight = list.scrollHeight;
  }

  /**
   * 加载更多历史后恢复滚动视角。
   * z-paging-x 无 scroll-into-view，且前插的消息离屏后会被原生 list-view 回收，
   * 无法逐个测量元素矩形。改为：加载后内容高度增量 + 加载前 scrollTop 即为目标 Y。
   * 平台若在插入时自动补偿滚动（iOS 系），该公式结果与当前视角一致，不会二次跳转。
   */
  restoreScrollAfterHistoryPrepend(): void {
    this.doRestoreScrollAfterHistoryPrepend(0);
  }

  /** 高度差补偿恢复视角；布局未就绪时最多重试 2 次 */
  private doRestoreScrollAfterHistoryPrepend(attempt: number): void {
    if (this.prependBaseScrollHeight <= 0) {
      return;
    }
    const list = uni.getElementById("msg-list");
    if (list == null) {
      return;
    }
    const newScrollHeight = list.scrollHeight;
    const added = newScrollHeight - this.prependBaseScrollHeight;
    if (added <= 0) {
      // 原生布局可能晚于 setState 完成：短重试，吃到更新后的 scrollHeight
      if (attempt < 2) {
        setTimeout(() => {
          this.doRestoreScrollAfterHistoryPrepend(attempt + 1);
        }, 160);
      }
      return;
    }
    let target = this.prependBaseScrollTop + added;
    if (target < 0) {
      target = 0;
    }
    this.invokeScrollToY(target, false);
  }
}
