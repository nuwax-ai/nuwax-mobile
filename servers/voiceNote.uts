  }
  const data = apiResData<any>(res);
  if (data == null) {
    return null;
  }
  return data as UTSJSONObject;
}

/**
 * 上传一个已落盘分段。同一 segmentIndex 重传会覆盖，重试必须沿用原编号。
 * 是否已经是最后一段不在这里传，全部上传成功后再调用 complete。
 * 文件名必须以 .m4a / .aac 结尾。
 */
export function apiVoiceNoteUploadSegment(
  noteId: string,
  filePath: string,
  segmentIndex: number,
  durationMs: number,
): Promise<string> {
  const formData = {} as UTSJSONObject;
  formData["segmentIndex"] = `${segmentIndex}`;
  if (durationMs > 0) formData["durationMs"] = `${durationMs}`;
  const url = `${getApiBaseUrl()}/api/voice/note/${noteId}/segment/upload`;
  return new Promise<string>((resolve, reject) => {
    uni.uploadFile({
      url: url,
      filePath: filePath,
      name: "file",
      header: authHeader(),
      formData: formData,
      success: (res) => {
        try {
          const raw = res.data;
          let parsed: UTSJSONObject | null = null;
          if (typeof raw == "string") {
            const text = `${raw}`.trim();
            if (text.length > 0) parsed = JSON.parse(text) as UTSJSONObject;
          } else if (raw != null) {
            parsed = raw as UTSJSONObject;
          }
          if (parsed == null) {
            reject(new Error("上传响应为空"));
            return;
          }
          const code = parsed["code"] != null ? `${parsed["code"]}` : "";
          if (code != SUCCESS_CODE) {
            const message = parsed["message"] != null ? `${parsed["message"]}` : "分段上传失败";
            reject(new Error(message));
            return;
          }
          const data = parsed["data"];
          let segmentId = "";
          if (data != null) {
            const dataObj = data as UTSJSONObject;
            if (dataObj["segmentId"] != null) segmentId = `${dataObj["segmentId"]}`;
          }
          resolve(segmentId);
        } catch (e) {
          reject(e);
        }
      },
      fail: (err) => {
        const message = err != null && err.errMsg != null ? `${err.errMsg}` : "分段上传失败";
        reject(new Error(message));
      },
    });
  });
}
