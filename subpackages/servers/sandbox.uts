import request from "@/servers/useRequest";
import { RequestResponse } from "@/types/interfaces/request";
import { SandboxListResponse } from "@/types/interfaces/sandbox";

/**
 * 获取沙盒列表
 */
export const apiGetSandboxList = async (): Promise<
  RequestResponse<SandboxListResponse>
> => {
  const res = await request({
    url: "/api/sandbox/config/select/list",
    method: "GET",
  });
  return res as RequestResponse<SandboxListResponse>;
};

/**
 * 更新选中的沙盒
 */
export const apiUpdateSelectedSandbox = async (
  agentId: string,
  sandboxId: string,
): Promise<RequestResponse<null>> => {
  const res = await request({
    url: `/api/sandbox/config/selected/${agentId}/${sandboxId}`,
    method: "POST",
  });
  return res as RequestResponse<null>;
};

/**
 * 重启智能体
 */
export const apiRestartAgent = async (
  conversationId: number,
): Promise<RequestResponse<null>> => {
  const res = await request({
    url: `/api/computer/agent/stop/${conversationId}`,
    method: "POST",
  });
  return res as RequestResponse<null>;
};

/**
 * 重启容器
 */
export const apiRestartSandbox = async (
  conversationId: number,
): Promise<RequestResponse<null>> => {
  const res = await request({
    url: `/api/computer/pod/restart?cId=${conversationId}`,
    method: "POST",
  });
  return res as RequestResponse<null>;
};
