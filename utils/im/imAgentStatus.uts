/**
 * 智能体消息处理状态（DEV-275 需求 3；判据对齐 PC nuwax-im-web src/lib/agentStatus.ts，
 * 契约见 nuwax-im docs/openapi/im-openapi.yaml 的 AgentMsgStatusDto）。
 *
 * status 值域（== 服务端 AgentMsgStatus.STATUS_*，前端不另编一套）：
 * 1=未读（建行初值） 2=已读处理中 3=处理失败 4=处理完成。
 * 数字顺序 = 允许推进的方向：所有帧/快照一律单调并入（只进不退），P1 帧乱序/重复天然免疫。
 *
 * 数据两条路径喂同一个本地结构（键 = msgId × agentSubjectId）：
 * - 拉：MessageDto.agentStatusDetail（历史分页/单条详情/sync；★只填给发送者本人——
 *   缺键 = 这条消息没衔接智能体，界面回落已读环，绝不画假「未读」）。
 *   注意扇出帧（3002/3005）与发送响应都不带该键，发送后到首帧前 = PC 同款回落态。
 * - 推：MSG_AGENT_STATUS(3006) WS 帧（帧体 = 单条明细同形状；后端仅「处理中/终态」
 *   推帧——建行(未读)不推，PC 端同款链路）。
 *
 * 聚合 = 最差态优先（多智能体场景取最差）：失败 > 挂起 > 处理中 > 未读 > 完成。
 * 挂起(HUNG)是读时投影：status∈{1,2} 且 updateTime 超 1 天没动静 ⇒ 按失败档展示；
 * 库里永远没有 HUNG 值、后端没有定时任务也不推帧——只有拉取/翻页时才看得到。
 */

/** 单智能体明细行（agentStatusDetail 数组元素与 3006 帧体同形状）。 */
export class ImAgentStatusItem {
  agentSubjectId: string = "";
  /** 1=未读 2=已读处理中 3=失败 4=完成；0=坏行（缺键/值非法，解析时丢弃）。 */
  status: number = 0;
  failCode: string = "";
  failReason: string = "";
  /** 状态最后变更时刻（epoch ms）；挂起投影的时间锚。 */
  updateTime: number = 0;
}

/** 聚合后的渲染视图：has=false ⇒ 无有效明细，模板不渲染标记（回落已读环）。 */
export class ImAgentStatusView {
  has: boolean = false;
  status: number = 0;
  failCode: string = "";
  failReason: string = "";
}

export const IM_AGENT_STATUS_UNREAD: number = 1;
export const IM_AGENT_STATUS_PROCESSING: number = 2;
export const IM_AGENT_STATUS_FAILED: number = 3;
export const IM_AGENT_STATUS_DONE: number = 4;

/** 挂起投影阈值：1 天（对齐 PC agentStatus.ts）。 */
const AGENT_HUNG_AFTER_MS: number = 24 * 60 * 60 * 1000;

/** 有效状态判定（未知值跳过——服务端以后加档位，老客户端不臆造）。 */
function isValidAgentStatus(status: number): boolean {
  return status >= IM_AGENT_STATUS_UNREAD && status <= IM_AGENT_STATUS_DONE;
}

/** 单条明细对象解析（拉路径数组元素与 3006 帧体同形状）；坏行返回 null。 */
export function parseAgentStatusObject(item: UTSJSONObject): ImAgentStatusItem | null {
  const out = new ImAgentStatusItem();
  const idRaw = item["agentSubjectId"];
  if (idRaw == null) {
    return null;
  }
  out.agentSubjectId = `${idRaw}`;
  const statusRaw = item["status"];
  if (statusRaw == null) {
    return null;
  }
  const parsed = parseFloat(`${statusRaw}`);
  if (isNaN(parsed) || isValidAgentStatus(parsed) != true) {
    return null;
  }
  out.status = parsed;
  const failCodeRaw = item["failCode"];
  if (failCodeRaw != null) {
    out.failCode = `${failCodeRaw}`;
  }
  const failReasonRaw = item["failReason"];
  if (failReasonRaw != null) {
    out.failReason = `${failReasonRaw}`;
  }
  const updateTimeRaw = item["updateTime"];
  if (updateTimeRaw != null) {
    const parsedTime = parseFloat(`${updateTimeRaw}`);
    if (isNaN(parsedTime) != true) {
      out.updateTime = parsedTime;
    }
  }
  return out;
}

/** MessageDto.agentStatusDetail → 明细行数组（null/缺键/坏元素均安全跳过）。 */
export function parseAgentStatusDetail(raw: any | null): ImAgentStatusItem[] {
  const out: ImAgentStatusItem[] = [];
  if (raw == null) {
    return out;
  }
  const arr = raw as any[];
  for (let i = 0; i < arr.length; i++) {
    const itemRaw = arr[i];
    if (itemRaw == null) {
      continue;
    }
    const item = parseAgentStatusObject(itemRaw as UTSJSONObject);
    if (item != null) {
      out.push(item);
    }
  }
  return out;
}

/**
 * 单调并入：incoming 逐条按 agentSubjectId 并入 current——status 只进不退；
 * 同档时接受新值（后端推的值 == 拉的值，同源覆盖安全，可补 failCode/updateTime）。
 * 无变化返回 null（调用方保持原数组免重渲），有变化返回新数组（不动入参）。
 */
export function mergeAgentStatusItems(
  current: ImAgentStatusItem[],
  incoming: ImAgentStatusItem[],
): ImAgentStatusItem[] | null {
  if (incoming.length == 0) {
    return null;
  }
  let changed = false;
  const out = current.slice();
  for (let i = 0; i < incoming.length; i++) {
    const item = incoming[i];
    let hitIndex = -1;
    for (let j = 0; j < out.length; j++) {
      if (out[j].agentSubjectId == item.agentSubjectId) {
        hitIndex = j;
        break;
      }
    }
    if (hitIndex < 0) {
      out.push(item);
      changed = true;
      continue;
    }
    const old = out[hitIndex];
    // 乱序旧帧：状态更小直接丢弃
    if (item.status < old.status) {
      continue;
    }
    // 重复帧：四个字段全同才算无变化
    if (
      item.status == old.status &&
      item.failCode == old.failCode &&
      item.failReason == old.failReason &&
      item.updateTime == old.updateTime
    ) {
      continue;
    }
    out[hitIndex] = item;
    changed = true;
  }
  return changed ? out : null;
}

/**
 * 聚合为单消息渲染视图（最差态优先）：failed(0) < HUNG(1) < processing(2) < unread(3) < done(4)，
 * 取 rank 最小者。HUNG 是读时投影：status∈{1,2} 且距锚点超 1 天 ⇒ 按 failed 展示（failCode=HUNG）。
 * nowMs 由调用方传入（同一批行同一渲染口径）；updateTime 缺失时以 sendTimeMs 兜底。
 */
export function aggregateAgentStatus(
  detail: ImAgentStatusItem[],
  nowMs: number,
  sendTimeMs: number,
): ImAgentStatusView {
  const view = new ImAgentStatusView();
  if (detail.length == 0) {
    return view;
  }
  let found = false;
  let bestRank = 0;
  let bestStatus = 0;
  let bestFailCode = "";
  let bestFailReason = "";
  let bestHung = false;
  for (let i = 0; i < detail.length; i++) {
    const item = detail[i];
    if (isValidAgentStatus(item.status) != true) {
      continue;
    }
    const anchor = item.updateTime > 0 ? item.updateTime : sendTimeMs;
    const hung =
      (item.status == IM_AGENT_STATUS_UNREAD || item.status == IM_AGENT_STATUS_PROCESSING) &&
        anchor > 0 &&
        nowMs - anchor > AGENT_HUNG_AFTER_MS;
    let rank = 4;
    if (hung) {
      rank = 1;
    } else if (item.status == IM_AGENT_STATUS_FAILED) {
      rank = 0;
    } else if (item.status == IM_AGENT_STATUS_PROCESSING) {
      rank = 2;
    } else if (item.status == IM_AGENT_STATUS_UNREAD) {
      rank = 3;
    }
    if (found != true || rank < bestRank) {
      found = true;
      bestRank = rank;
      bestStatus = item.status;
      bestFailCode = item.failCode;
      bestFailReason = item.failReason;
      bestHung = hung;
    }
  }
  if (found != true) {
    return view;
  }
  view.has = true;
  if (bestHung) {
    // 挂起投影：库里没有的值，只在读侧展示为失败档（不落库、不推帧——PC 同款）
    view.status = IM_AGENT_STATUS_FAILED;
    view.failCode = "HUNG";
    return view;
  }
  view.status = bestStatus;
  view.failCode = bestFailCode;
  view.failReason = bestFailReason;
  return view;
}
