/node_modules
# /unpackage
/dist
.idea
.vscode
.qoder

.temp  

.DS_Store
.npm-cache

# 配置 仅放开 unpackage/dist/build/web/ 目录
unpackage/cache
unpackage/dist/*
!unpackage/dist/build/
unpackage/dist/build/*
!unpackage/dist/build/web/

# 本地打包生成的 App 资源（编译产物，云端打包重新生成，不入库）
unpackage/resources/
unpackage/debug/*

# HBuilderX 本地运行配置(含本机证书绝对路径,不入库)
.hbuilderx/launch.json

# 本地自定义基座中间产物（正式交付在 unpackage/debug/，已 ignore）
/out/
scripts/__pycache__/

# 本机敏感配置（AppKey / iOS Team / Profile UUID），绝不入库
scripts/local-secrets.env

# 构建产物 / 字节码缓存 / 代码签名元数据
__pycache__/
**/_CodeSignature/
