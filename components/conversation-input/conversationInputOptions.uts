/** 对齐 PC：Space 下仅 Team 单独归团队，其余兼容为个人模型。 */
export function resolveConversationModelScope(scope: string, spaceType: string, spaceId: number): string {
  if (scope == "Tenant") return "system";
  if (scope == "Space") return spaceType == "Team" ? "team" : "personal";
  return spaceId == -1 ? "system" : "personal";
}

/** 无场景限制时可用；有限制时必须包含当前智能体类型。 */
export function conversationModelMatchesAgentType(
  usageScenarios: string[],
  agentType: string,
): boolean {
  if (agentType.length == 0 || usageScenarios.length == 0) return true;
  for (let i = 0; i < usageScenarios.length; i++) {
    if (usageScenarios[i] == agentType) return true;
  }
  return false;
}

/** 对齐 PC 默认选择：有效当前值 > options 首项 > 合集首项。 */
export function resolveConversationModelId(
  currentModelId: number,
  preferredModelId: number,
  availableIds: number[],
): number {
  if (availableIds.indexOf(currentModelId) >= 0) return currentModelId;
  if (availableIds.indexOf(preferredModelId) >= 0) return preferredModelId;
  return availableIds.length > 0 ? availableIds[0] : 0;
}

/** 对齐 PC 首页：智能体记忆 > 接口返回的云电脑(-1) > 接口首项。 */
export function resolveHomeComputerId(
  savedComputerId: string,
  availableIds: string[],
): string {
  if (savedComputerId.length > 0 && availableIds.indexOf(savedComputerId) >= 0) {
    return savedComputerId;
  }
  if (availableIds.indexOf("-1") >= 0) return "-1";
  return availableIds.length > 0 ? availableIds[0] : "";
}

/** 对齐 PC：会话保存的电脑优先；云端哨兵不算智能体绑定的个人电脑。 */
export function resolveBoundConversationComputerId(
  conversationComputerId: string,
  agentComputerId: string,
): string {
  const conversationId = conversationComputerId.trim();
  if (conversationId.length > 0) return conversationId;
  const agentId = agentComputerId.trim();
  return agentId.length > 0 && agentId != "-1" && agentId != "0" ? agentId : "";
}

/** 固定电脑缺失时保留绑定，并区分个人电脑与云端电脑的不可用提示。 */
export function resolveBoundComputerUnavailableKey(
  computerId: string,
  availableIds: string[],
): string {
  if (availableIds.indexOf(computerId) >= 0) return "";
  return computerId == "-1"
    ? "Mobile.Sandbox.unavailable"
    : "Mobile.Sandbox.personalUnavailable";
}
