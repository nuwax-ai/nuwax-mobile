<template>
  <view v-if="isVisible" class="tool-call-card">
    <!-- Plan：对齐 dev mp-html container 的执行计划卡片 -->
    <template v-if="isPlanType">
      <view class="plan-header">
        <view class="plan-info">
          <text class="plan-name">{{ planNameDisplay }}</text>
        </view>
        <view class="plan-expand-icon" @tap.stop="togglePlanExpanded">
          <svg-icon
            :key="planExpanded ? 'plan-minus' : 'plan-plus'"
            :name="planExpanded ? 'icon-MinusOutlined' : 'icon-Plus'"
            size="28"
            customClass="plan-expand-svg"
          />
        </view>
      </view>
      <view
        v-if="planExpanded && planTaskList.length > 0"
        class="plan-task-list"
      >
        <view
          v-for="(task, index) in planTaskList"
          :key="index"
          class="plan-task-item"
        >
          <view
            class="task-status-icon"
            :class="getTaskStatusClass(readTaskField(task, 'status'))"
          >
            <text
              class="task-icon iconfont"
              :class="getTaskStatusIcon(readTaskField(task, 'status'))"
            ></text>
          </view>
          <text class="task-content">{{ readTaskField(task, 'content') }}</text>
        </view>
      </view>
    </template>

    <!-- 普通工具调用 -->
    <view v-else class="tool-call-card__main">
      <text class="tool-call-card__name">{{ displayName }}</text>
      <view class="tool-call-card__actions">
        <view class="tool-call-card__status" :class="statusClass">
          <!-- APP：CSS/字符点无法表现 loading，用 transition 自转（1s/圈） -->
          <!-- #ifdef APP -->
          <spin-loading
            v-if="isExecuting"
            size="14px"
            color="#1677ff"
            :duration-ms="1000"
          />
          <text v-else class="tool-call-card__status-text">{{ statusIcon }}</text>
          <!-- #endif -->
          <!-- #ifndef APP -->
          <text class="tool-call-card__status-text">{{ statusIcon }}</text>
          <!-- #endif -->
        </view>
        <view class="tool-call-card__detail" @tap.stop="showDetails">
          <svg-icon name="icon-ProfileOutlined" size="28" />
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import { isOpenUiRenderToolName } from "@/utils/openUiSchema.uts";
  // #ifdef APP
  import SpinLoading from "@/subpackages/components/spin-loading/spin-loading.uvue";
  // #endif

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const props = defineProps<{
    /** 已规范化为 UTSJSONObject 的工具调用数据。 */
    toolCallData: any;
  }>();

  const planExpanded = ref<boolean>(true);

  /** 安全读取工具调用字段。 */
  function readField(key: string): any | null {
    const source = props.toolCallData;
    if (source == null) return null;
    const obj = source as UTSJSONObject;
    const value = obj[key];
    return value != null ? value : null;
  }

  const toolType = computed((): string => {
    const value = readField("type");
    return value != null ? `${value}` : "";
  });

  const toolStatus = computed((): string => {
    const value = readField("status");
    return value != null ? `${value}` : "";
  });

  const isPlanType = computed((): boolean => {
    return toolType.value == "Plan";
  });

  const displayName = computed((): string => {
    const name = readField("name");
    let text = name != null ? `${name}` : "";
    if (text.length == 0) {
      text = toolType.value.length > 0 ? toolType.value : "工具调用";
    }
    try {
      if (text.indexOf("%") >= 0) {
        const decoded = decodeURIComponent(text);
        if (decoded != null) {
          text = decoded;
        }
      }
    } catch (_e) {
      // 保留原始名称
    }
    return text.replace(/&quot;/g, '"').replace(/\n/g, " ").trim();
  });

  const planNameDisplay = computed((): string => {
    const name = displayName.value;
    if (name.length > 0 && name != "Plan") {
      return name;
    }
    return t("Mobile.ThirdParty.MpHtml.executionPlan");
  });

  /** 从任意对象读取字符串字段。 */
  function readObjString(source: any | null, key: string): string {
    if (source == null) return "";
    try {
      const obj = source as UTSJSONObject;
      const value = obj[key];
      return value != null ? `${value}` : "";
    } catch (_e) {
      return "";
    }
  }

  /** 将 result.data 规范为数组（兼容 Android 非 JS Array）。 */
  function asTaskArray(data: any | null): any[] {
    if (data == null) {
      return [] as any[];
    }
    if (Array.isArray(data)) {
      return data as any[];
    }
    try {
      const list = data as any[];
      if (list != null && list.length >= 0) {
        const out = [] as any[];
        for (let i = 0; i < list.length; i++) {
          out.push(list[i]);
        }
        return out;
      }
    } catch (_eArr) {
      // 非数组
    }
    // 有些接口把任务列表放在 data.tasks / data.list
    try {
      const obj = data as UTSJSONObject;
      const nested = obj["tasks"] != null ? obj["tasks"] : obj["list"];
      if (nested != null) {
        return asTaskArray(nested);
      }
    } catch (_eObj) {
      // ignore
    }
    return [] as any[];
  }

  /** 从 result.data 读取 Plan 任务列表（对齐 dev container）。 */
  const planTaskList = computed((): UTSJSONObject[] => {
    const result = readField("result");
    if (result == null) {
      return [] as UTSJSONObject[];
    }
    const data = (result as UTSJSONObject)["data"];
    const list = asTaskArray(data);
    const tasks = [] as UTSJSONObject[];
    for (let i = 0; i < list.length; i++) {
      const raw = list[i];
      if (raw == null) {
        continue;
      }
      const item = new UTSJSONObject();
      let status = readObjString(raw, "status");
      let content = readObjString(raw, "content");
      if (content.length == 0) {
        content = readObjString(raw, "title");
      }
      if (content.length == 0) {
        content = readObjString(raw, "name");
      }
      if (status.length == 0) {
        status = "pending";
      }
      item["status"] = status;
      item["content"] = content;
      tasks.push(item);
    }
    return tasks;
  });

  // 渲染工具（nuwax_render_openui / Backend.Sandbox.Event.renderUI）不展示工具调用卡片：
  // 直接由 openui-card 承载渲染产物。其余 Event 类型（OPEN_DESKTOP 等）默认也不展示。
  const isVisible = computed((): boolean => {
    if (isOpenUiRenderToolName(displayName.value)) return false;
    return toolType.value != "Event";
  });

  /** 非终态均视为执行中（含空状态 / EXECUTING） */
  const isExecuting = computed((): boolean => {
    return (
      toolStatus.value != "FINISHED" && toolStatus.value != "FAILED"
    );
  });

  const statusIcon = computed((): string => {
    if (toolStatus.value == "FINISHED") return "✓";
    if (toolStatus.value == "FAILED") return "!";
    return "·";
  });

  const statusClass = computed((): string => {
    if (toolStatus.value == "FINISHED") {
      return "tool-call-card__status--finished";
    }
    if (toolStatus.value == "FAILED") {
      return "tool-call-card__status--failed";
    }
    return "tool-call-card__status--executing";
  });

  function togglePlanExpanded(): void {
    planExpanded.value = !planExpanded.value;
  }

  /** 模板读取任务字段（UTSJSONObject）。 */
  function readTaskField(task: any | null, key: string): string {
    return readObjString(task, key);
  }

  function getTaskStatusClass(status: string): string {
    if (status == "completed") return "task-status-completed";
    if (status == "in_progress") return "task-status-in-progress";
    if (status == "failed") return "task-status-failed";
    return "task-status-pending";
  }

  function getTaskStatusIcon(status: string): string {
    if (status == "completed") return "icon-CheckSquareOutlined";
    if (status == "in_progress") return "icon-HourglassOutlined";
    if (status == "failed") return "icon-CloseSquareOutlined";
    return "icon-BorderOutlined";
  }

  /** 打开页面级工具详情弹窗。 */
  function showDetails(): void {
    const result = readField("result");
    const resultObj =
      result != null ? result as UTSJSONObject : new UTSJSONObject();
    const detail = new UTSJSONObject();
    detail["params"] = resultObj["input"];
    detail["response"] = resultObj["data"];
    uni.$emit("page_preview_detail", props.toolCallData, detail);
  }
</script>

<style lang="scss" scoped>
  .tool-call-card {
    width: 100%;
    margin: 16rpx 0;
    border-radius: 16rpx;
    background-color: rgba(12, 20, 102, 0.04);
    overflow: hidden;

    &__main {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      min-height: 72rpx;
      padding: 12rpx 20rpx;
      box-sizing: border-box;
    }

    &__name {
      flex: 1;
      min-width: 0;
      color: #333;
      font-size: 28rpx;
      line-height: 40rpx;
      font-weight: 400;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &__actions {
      display: flex;
      flex-direction: row;
      align-items: center;
      flex-shrink: 0;
      margin-left: 16rpx;
    }

    &__status {
      width: 32rpx;
      height: 32rpx;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;

      &-text {
        width: 32rpx;
        text-align: center;
        font-size: 32rpx;
        line-height: 36rpx;
      }

      &--finished {
        color: #32b800;

        .tool-call-card__status-text {
          color: #32b800;
        }
      }

      &--failed {
        color: #e6a700;

        .tool-call-card__status-text {
          color: #e6a700;
        }
      }

      &--executing {
        color: #1677ff;

        .tool-call-card__status-text {
          color: #1677ff;
        }
      }
    }

    &__detail {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44rpx;
      height: 44rpx;
      margin-left: 12rpx;
      color: #30333a;
    }
  }

  .plan-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx;

    .plan-info {
      display: flex;
      flex-direction: row;
      align-items: center;
      flex: 1;
      min-width: 0;
      margin-right: 16rpx;

      .plan-name {
        flex: 1;
        min-width: 0;
        color: #333;
        font-size: 28rpx;
        line-height: 40rpx;
        font-weight: 400;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }

    .plan-expand-icon {
      flex-shrink: 0;
      width: 44rpx;
      height: 44rpx;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #30333a;
    }
  }

  .plan-task-list {
    padding: 0 24rpx 24rpx;
    border-top: 2rpx solid rgba(0, 0, 0, 0.06);

    .plan-task-item {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      padding: 12rpx 0;

      .task-status-icon {
        flex-shrink: 0;
        width: 32rpx;
        height: 32rpx;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 4rpx;
        margin-right: 8rpx;

        .task-icon {
          font-size: 32rpx;
          color: #8c8c8c;
        }

        &.task-status-completed .task-icon {
          color: #52c41a;
        }

        &.task-status-in-progress .task-icon {
          color: #1890ff;
        }

        &.task-status-failed .task-icon {
          color: #ffcb00;
        }
      }

      .task-content {
        flex: 1;
        font-size: 26rpx;
        color: #262626;
        line-height: 40rpx;
      }
    }
  }
</style>
