<template>
  <view class="credits-page">
    <custom-nav-bar :title="t('Mobile.Mine.myCredits')" :has-safety-zone="true">
      <template v-slot:left>
        <view class="header-icon-box" @tap="handleBack">
          <svg-icon name="icon-a-Chevronleft" size="22" unit="px" />
        </view>
      </template>
    </custom-nav-bar>

    <view class="credits-body">
      <CreditsBreakdown :summary="creditsSummary" @add-purchase="handleAddPurchase" />

      <!-- 我的订阅 / 我的订单（iOS 上架版隐藏：属付费体系入口） -->
      <!-- #ifndef APP-IOS -->
      <view class="menu-card" v-if="isSubscriptionEnabled">
        <view class="menu-row" @click="handleMySubscriptions">
          <view class="menu-icon-box">
            <svg-icon name="icon-member" size="20" unit="px" />
          </view>
          <text class="menu-title">{{ t("Mobile.Header.mySubscriptions") }}</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-divider-wrap">
          <view class="menu-divider"></view>
        </view>
        <view class="menu-row" @click="handleMyOrders">
          <view class="menu-icon-box">
            <svg-icon name="icon-order" size="20" unit="px" />
          </view>
          <text class="menu-title">{{ t("Mobile.Header.myOrders") }}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
      <!-- #endif -->
    </view>

    <!-- #ifndef APP-IOS -->
    <PurchaseModal ref="purchaseModalRef" :on-payment-success="fetchCreditsSummary" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  import { onShow } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiGetCreditSummary } from "@/subpackages/servers/subscription";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { jumpNavigateBack } from "@/utils/common";
  import { checkSubscriptionEnable } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import CreditsBreakdown from "@/components/credits-breakdown/credits-breakdown.uvue";
  import PurchaseModal from "@/subpackages/pages/my-subscriptions/components/purchase-modal/purchase-modal.uvue";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const creditsSummary = ref<UTSJSONObject | null>(null);
  const purchaseModalRef = ref<any | null>(null);
  const isSubscriptionEnabled = ref<boolean>(false);

  const handleBack = () => {
    jumpNavigateBack();
  };

  const fetchCreditsSummary = async () => {
    try {
      const res = await apiGetCreditSummary();
      if (apiResCode(res) == SUCCESS_CODE) {
        const dataRaw = apiResData<any>(res);
        creditsSummary.value = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      }
    } catch (_e) {
      creditsSummary.value = null;
    }
  };

  const handleMySubscriptions = () => {
    uni.navigateTo({ url: "/subpackages/pages/my-subscriptions/my-subscriptions" });
  };

  const handleMyOrders = () => {
    uni.navigateTo({ url: "/subpackages/pages/my-orders/my-orders" });
  };

  const handleAddPurchase = () => {
    // #ifndef APP-IOS
    const inst = purchaseModalRef.value;
    if (inst == null) return;
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod("open");
    // #endif
  };

  const loadSubscriptionEnable = async () => {
    // #ifndef APP-IOS
    isSubscriptionEnabled.value = await checkSubscriptionEnable();
    // #endif
  };

  onShow(() => {
    fetchCreditsSummary();
    loadSubscriptionEnable();
  });
</script>

<style lang="scss" scoped>
  .credits-page {
    flex: 1;
    background-color: #f5f6f8;
    display: flex;
    flex-direction: column;
  }

  .header-icon-box {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .credits-body {
    padding: 12px;
  }

  .menu-card {
    margin-top: 12px;
    background-color: #ffffff;
    border-radius: 16px;
    overflow: hidden;
  }

  .menu-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 16px;
  }

  .menu-icon-box {
    width: 24px;
    height: 24px;
    margin-right: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .menu-title {
    flex: 1;
    font-size: 16px;
    font-weight: 500;
    color: #1a1a1a;
  }

  .menu-arrow {
    font-size: 20px;
    color: #c0c0c0;
    font-weight: 300;
    line-height: 1;
  }

  .menu-divider {
    height: 1px;
    background-color: #f0f0f0;
  }
</style>
