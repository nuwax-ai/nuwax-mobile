/**
 * nuwax-livekit · app-harmony —— **逻辑占位**（2026-11-14 定）
 *
 * <h2>为什么这里是空的</h2>
 * <p>LiveKit 官方客户端没有 HarmonyOS 版本（只有 Android / Swift / Web / Flutter / RN / Unity 等），
 * 也不能直接跑 Android AAR。鸿蒙要真正开会，需要一套自己的 **HarmonyOS LiveKitClient**。
 * 在本端做出可维护的实现之前，这里一律返回"不支持"：业务层因此只提供会议信息能力，
 * 会中页的麦克风/摄像头/扬声器如实提示「音视频能力接入中」，不伪造开关状态。</p>
 *
 * <h2>后续要做的东西（已按依赖顺序列好）</h2>
 * <ol>
 *   <li><b>RTC 客户端来源</b>：二选一并做两周可终止的技术尖峰——
 *       (a) 自研：ArkTS + 鸿蒙 WebRTC/原生 RTC 栈，实现 LiveKit 协议（加入、发布/订阅、DataChannel）；
 *       (b) 复用第三方 uni-app x 插件（DCloud 插件市场 28009 `XF-liveKitUTS`，声明支持鸿蒙 5.0.0），
 *           需先验证其能否连当前自建 LiveKit、内存/温升、可维护性；其鸿蒙端无屏幕共享。</li>
 *   <li><b>原生视频渲染组件</b>：UTS 插件内的 ArkTS 原生组件（`XComponent`/`Surface`），
 *       **不把每帧传回 JS**，与 Android/iOS 保持同一套"track → 视图"绑定语义。</li>
 *   <li><b>权限与长时任务</b>：`CAMERA`、`MICROPHONE` 用户授权；
 *       会中挂 VOIP 长时任务 + `KEEP_BACKGROUND_RUNNING`，退后台音频不被冻结。</li>
 *   <li><b>音频路由</b>：`AudioRoutingManager` 处理扬声器/听筒/蓝牙；与现有 TTS/PCM 录音互斥。</li>
 *   <li><b>屏幕共享</b>：`AVScreenCapture` 采集 → 发布为共享轨道（PC 对齐的最终范围）。</li>
 *   <li><b>基座链路</b>：仓库 `make base-harmony` 目前是占位，需先补齐鸿蒙自定义基座构建。</li>
 * </ol>
 * <p>以上任意核心项无可靠路径 ⇒ 鸿蒙只开放会议列表/预约/记录等非媒体能力（No-Go 口径）。</p>
 */

/** 鸿蒙错误码：本端无 RTC 客户端（后续自研 LiveKitClient 时替换）。 */
const ERR_PLATFORM_UNSUPPORTED = "harmony_rtc_unsupported";

/** 本端能否真正收发音视频：鸿蒙当前恒 false（见文件头）。 */
export function isSupported(): boolean {
  return false;
}

/**
 * 连接已有房间（不建房）。
 * ★占位实现只回报不支持：等 HarmonyOS LiveKitClient 落地后在这里接上，接口不用改。
 */
export function connect(
  serverUrl: string,
  token: string,
  room: string,
  displayName: string,
  micOn: boolean,
  cameraOn: boolean,
): void {
  // 占位：不连（isSupported() 恒 false，业务层本来也不会调用）
}

/** 最近一次连接失败原因（鸿蒙恒为不支持码）。 */
export function lastError(): string {
  return ERR_PLATFORM_UNSUPPORTED;
}

export function disconnect(): void {
  // 未连接时无操作；接入后在此退出 RTC 并结束 VOIP 长时任务
}

export function setMicEnabled(on: boolean): void {
  // 接入后：开/关麦克风采集（先申请 MICROPHONE）
}

export function setCameraEnabled(on: boolean): void {
  // 接入后：开/关摄像头采集（先申请 CAMERA）
}

export function setSpeakerEnabled(on: boolean): void {
  // 接入后：AudioRoutingManager 切扬声器/听筒/蓝牙
}

