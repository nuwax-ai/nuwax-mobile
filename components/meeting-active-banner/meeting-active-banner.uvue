<template>
  <view v-if="visible" class="meeting-active" :style="{ top: top + 'px' }"
    @touchstart.stop="handleTouchStart" @touchmove.stop.prevent="handleTouchMove"
    @touchend.stop="handleTouchEnd" @touchcancel.stop="handleTouchCancel" @click.stop="resume">
    <image class="meeting-active__icon" :src="meetingIcon" mode="aspectFit" />
  </view>
</template>

<script setup lang="uts">
  import { ref, onMounted, onUnmounted } from "vue";
  import eventBus from "@/utils/eventBus";
  import meetingIcon from "@/static/icons/meeting-white.svg";
  import { MEETING_MEDIA_CHANGED_EVENT, meetingMediaIsMinimized, meetingMediaResume, meetingMediaHasNativeWindow } from "@/utils/meeting/meetingMedia";
  const visible = ref(false);
  const top = ref(0);
  let position = 0.68;
  let startX = 0;
  let startY = 0;
  let startTop = 0;
  let minTop = 28;
  let maxTop = 28;
  let dragged = false;
  let suppressClickUntil = 0;
  function updateBounds(): void {
    const info = uni.getWindowInfo();
    minTop = 28;
    maxTop = Math.max(minTop, info.windowHeight - 92);
    top.value = minTop + (maxTop - minTop) * position;
  }
  // 刷新逻辑与事件回调分开：refresh 无参（onMounted 直接调），回调保持单参 any，
  // 避免把 null 传给非空 any 参数（Android 生成代码会报 Null cannot be a value of non-null type 'Any'）。
  function refresh(): void { visible.value = meetingMediaIsMinimized() && !meetingMediaHasNativeWindow(); }
  const onMediaChanged = (_payload: any): void => { refresh(); };
  function resume(): void {
    if (Date.now() < suppressClickUntil) return;
    meetingMediaResume();
  }
  function handleTouchStart(event: UniTouchEvent): void {
    if (event.touches.length == 0) return;
    updateBounds();
    startX = event.touches[0].clientX;
    startY = event.touches[0].clientY;
    startTop = top.value;
    dragged = false;
  }
  function handleTouchMove(event: UniTouchEvent): void {
    if (event.touches.length == 0) return;
    const delta = event.touches[0].clientY - startY;
    if (Math.abs(delta) > 8 || Math.abs(event.touches[0].clientX - startX) > 8) dragged = true;
    if (!dragged) return;
    top.value = Math.max(minTop, Math.min(maxTop, startTop + delta));
    position = (top.value - minTop) / Math.max(1, maxTop - minTop);
  }
  function handleTouchEnd(_event: UniTouchEvent): void {
    if (dragged) suppressClickUntil = Date.now() + 500;
  }
  function handleTouchCancel(_event: UniTouchEvent): void { suppressClickUntil = Date.now() + 500; }
  onMounted(() => {
    updateBounds();
    refresh();
    eventBus.on(MEETING_MEDIA_CHANGED_EVENT, onMediaChanged);
  });
  onUnmounted(() => { eventBus.off(MEETING_MEDIA_CHANGED_EVENT, onMediaChanged); });
</script>

<style scoped>
  .meeting-active { position: fixed; right: 0; width: 36px; height: 64px; z-index: 180; border-top-left-radius: 16px; border-bottom-left-radius: 16px; background-color: #1d1e21; flex-direction: row; align-items: center; justify-content: center; }
  .meeting-active__icon { width: 22px; height: 22px; }
</style>
