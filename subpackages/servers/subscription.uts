export async function apiGetOrderCashier(orderId: number, returnUrl?: string): Promise<RequestResponse<CashierInfo>> {
  const data: Record<string, any> = { orderId };
  if (returnUrl != null) {
    data["returnUrl"] = returnUrl;
  }
  const queryStr = buildQueryParams(data);
  const res = await request({
    url: `/api/bill/order/pay/cashier${queryStr}`,
    method: "GET",
  });
  return res;
}

