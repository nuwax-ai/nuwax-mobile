import { PendingChatDraft } from "@/types/interfaces/pendingChatDraft";
import { SelectedDocInfo } from "@/types/interfaces/knowledgeList";
import { AgentSelectedComponentInfo } from "@/types/interfaces/agent";
import { AgentComponentTypeEnum } from "@/types/enums/agent";

const PREFIX = "pendingChatDraft:";
const TTL_MS = 10 * 60 * 1000;

function storageKey(conversationId: number): string {
  return PREFIX + conversationId;
}

function numberFromJson(value: any | null, fallback: number): number {
  if (value == null) return fallback;
  const parsed = parseFloat(`${value}`);
  return isNaN(parsed) ? fallback : parsed;
}

function componentTypeFromJson(value: any | null): AgentComponentTypeEnum {
  const type = value != null ? `${value}` : "";
  if (type == "Workflow") return AgentComponentTypeEnum.Workflow;
  if (type == "Trigger") return AgentComponentTypeEnum.Trigger;
  if (type == "Knowledge") return AgentComponentTypeEnum.Knowledge;
  if (type == "Variable") return AgentComponentTypeEnum.Variable;
  if (type == "Table") return AgentComponentTypeEnum.Table;
  if (type == "Model") return AgentComponentTypeEnum.Model;
  if (type == "Agent") return AgentComponentTypeEnum.Agent;
  if (type == "Mcp") return AgentComponentTypeEnum.MCP;
  if (type == "Page") return AgentComponentTypeEnum.Page;
  if (type == "Event") return AgentComponentTypeEnum.Event;
  if (type == "Skill") return AgentComponentTypeEnum.Skill;
  if (type == "ToolCall") return AgentComponentTypeEnum.ToolCall;
  if (type == "Plan") return AgentComponentTypeEnum.Plan;
  return AgentComponentTypeEnum.Plugin;
}

/**
 * UTS class 在部分 App 运行时直接 JSON.stringify 可能只得到空对象。
 * 跨原生 / 内嵌 H5 传递前显式组装纯 JSON，避免首条消息静默丢失。
 */
export function serializePendingChatDraft(draft: PendingChatDraft): string {
  const attachments: UTSJSONObject[] = [];
  for (let i = 0; i < draft.attachments.length; i++) {
    const source = draft.attachments[i];
    const item = new UTSJSONObject();
    item["fileUrl"] = source["fileUrl"];
    item["mimeType"] = source["mimeType"];
    item["fileName"] = source["fileName"];
    item["fileKey"] = source["fileKey"];
    item["fileSize"] = source["fileSize"];
    attachments.push(item);
  }

  const selectedComponents: UTSJSONObject[] = [];
  for (let i = 0; i < draft.selectedComponents.length; i++) {
    const source = draft.selectedComponents[i];
    const item = new UTSJSONObject();
    item["id"] = source.id;
    item["type"] = `${source.type}`;
    selectedComponents.push(item);
  }

  const selectedDocs: UTSJSONObject[] = [];
  for (let i = 0; i < draft.selectedDocs.length; i++) {
    const source = draft.selectedDocs[i];
    const item = new UTSJSONObject();
    item["slugId"] = source.slugId;
    item["title"] = source.title;
    item["pageType"] = source.pageType;
    selectedDocs.push(item);
  }

  const root = new UTSJSONObject();
  root["version"] = draft.version;
  root["createdAt"] = draft.createdAt;
  root["agentId"] = draft.agentId;
  root["conversationId"] = draft.conversationId;
  root["message"] = draft.message;
  root["attachments"] = attachments;
  root["selectedComponents"] = selectedComponents;
  root["skillIds"] = draft.skillIds;
  root["sandboxId"] = draft.sandboxId;
  root["modelId"] = draft.modelId;
  root["selectedDocs"] = selectedDocs;
  if (draft.agentMode != null) root["agentMode"] = draft.agentMode;
  if (draft.workspacePath != null) root["workspacePath"] = draft.workspacePath;
  const json = JSON.stringify(root);
  return json != null ? json : "";
}

/** 解析 storage 或原生桥传来的纯 JSON 草稿，并校验会话身份与有效期。 */
export function parsePendingChatDraftJson(
  raw: string,
  conversationId: number,
  agentId: number,
): PendingChatDraft | null {
  if (raw.length == 0) return null;
  try {
    const parsed = JSON.parse<UTSJSONObject>(raw);
    if (parsed == null) return null;
    const draft = new PendingChatDraft();
    draft.version = numberFromJson(parsed["version"], 1);
    draft.createdAt = numberFromJson(parsed["createdAt"], 0);
    draft.agentId = numberFromJson(parsed["agentId"], 0);
    draft.conversationId = numberFromJson(parsed["conversationId"], 0);
    draft.message = parsed["message"] != null ? `${parsed["message"]}` : "";
    draft.sandboxId = parsed["sandboxId"] != null ? `${parsed["sandboxId"]}` : "";
    draft.modelId = numberFromJson(parsed["modelId"], 0);

    const workspacePath = parsed["workspacePath"];
    if (workspacePath != null && `${workspacePath}`.length > 0) {
      draft.workspacePath = `${workspacePath}`;
    }
    const agentMode = parsed["agentMode"] != null ? `${parsed["agentMode"]}` : "";
    if (agentMode == "ask" || agentMode == "yolo") {
      draft.agentMode = agentMode;
    }

    const attachmentsRaw = parsed["attachments"];
    if (attachmentsRaw != null && Array.isArray(attachmentsRaw)) {
      const rows = attachmentsRaw as any[];
      for (let i = 0; i < rows.length; i++) {
        draft.attachments.push(rows[i] as UTSJSONObject);
      }
    }

    const skillsRaw = parsed["skillIds"];
    if (skillsRaw != null && Array.isArray(skillsRaw)) {
      const rows = skillsRaw as any[];
      for (let i = 0; i < rows.length; i++) {
        const id = numberFromJson(rows[i], 0);
        if (id > 0) draft.skillIds.push(id);
      }
    }

    const selectedRaw = parsed["selectedComponents"];
    if (selectedRaw != null && Array.isArray(selectedRaw)) {
      const rows = selectedRaw as any[];
      for (let i = 0; i < rows.length; i++) {
        const item = rows[i] as UTSJSONObject;
        const id = numberFromJson(item["id"], 0);
        if (id > 0) {
          draft.selectedComponents.push(
            new AgentSelectedComponentInfo(id, componentTypeFromJson(item["type"])),
          );
        }
      }
    }

    const docsRaw = parsed["selectedDocs"];
    if (docsRaw != null && Array.isArray(docsRaw)) {
      const rows = docsRaw as any[];
      for (let i = 0; i < rows.length; i++) {
        const row = rows[i] as UTSJSONObject;
        const doc = new SelectedDocInfo();
        doc.slugId = row["slugId"] != null ? `${row["slugId"]}` : "";
        doc.title = row["title"] != null ? `${row["title"]}` : "";
        doc.pageType = row["pageType"] != null ? `${row["pageType"]}` : "";
        if (doc.slugId.length > 0) draft.selectedDocs.push(doc);
      }
    }

    const valid = draft.conversationId == conversationId &&
      draft.agentId == agentId && Date.now() - draft.createdAt <= TTL_MS;
    return valid ? draft : null;
  } catch (_error) {
    return null;
  }
}

export function savePendingChatDraft(draft: PendingChatDraft): void {
  const json = serializePendingChatDraft(draft);
  if (json.length > 0) uni.setStorageSync(storageKey(draft.conversationId), json);
}

export function consumePendingChatDraft(
  conversationId: number,
  agentId: number,
): PendingChatDraft | null {
  const key = storageKey(conversationId);
  const raw = uni.getStorageSync(key);
  if (raw == null || `${raw}`.length == 0) return null;
  const draft = parsePendingChatDraftJson(`${raw}`, conversationId, agentId);
  uni.removeStorageSync(key);
  return draft;
}

export function removePendingChatDraft(conversationId: number): void {
  uni.removeStorageSync(storageKey(conversationId));
}
