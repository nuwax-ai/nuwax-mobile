<template>
  <!--
    会议首页（发现 tab 的「会议」入口进来）。

    ★从 feat-zq 移植时，会议原是伙伴页顶部第二个 tab（夹在消息与智联录之间）。
    11 分支已把智联录拆成底部 tab、伙伴页顶部只剩消息，会议改为独立页。
    列表与三入口（发起 / 加入 / 预约）全部由 meeting-pane 自管，本页只出壳与回页补拉。

    ★active 恒 true：pane 的「切回来才刷新」靠 active watch，独立页没有切 tab 动作，
    回页补拉改由本页 onShow 广播 IM_MEETING_CHANGED_EVENT 驱动（pane 里已订阅）。
  -->
  <view class="mh-page">
    <safety-zone />

    <view class="mh-header">
      <view class="mh-header__btn" hover-class="mh-header__btn--active" @click="handleBack">
        <back-chevron :size="20" color="#141416" />
      </view>
      <view class="mh-header__title-wrap">
        <text class="mh-header__title">{{ t("Mobile.Meeting.tab") }}</text>
      </view>
      <view class="mh-header__btn mh-header__btn--ghost" />
    </view>

    <meeting-pane :active="true" />
    <meeting-active-banner />
    <!-- 前台会议邀请条：每个可能位于栈顶的页面都要各挂一个，否则在本页收到邀请时
         只有状态被写入、没有任何 UI（tab-shell / chat 的实例被本页盖住）。 -->
    <meeting-invite-banner />
  </view>
</template>

<script setup lang="uts">
  import { onShow } from "@dcloudio/uni-app";
  import eventBus from "@/utils/eventBus";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { IM_MEETING_CHANGED_EVENT } from "@/servers/imMeeting";
  import MeetingPane from "@/pages/message/components/meeting-pane.uvue";
  import MeetingActiveBanner from "@/components/meeting-active-banner/meeting-active-banner.uvue";
  import MeetingInviteBanner from "@/components/meeting-invite-banner/meeting-invite-banner.uvue";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 回页补拉：子页（发起/加入/预约/会议信息）保存后广播过一次，但那次请求可能赶在
   *  服务端写入对读可见之前，回包是旧数据；这里再补一发，pane 内静默重拉（不闪列表）。
   *  首次进入 onShow 也会发一次，pane 的 onMounted 已在拉，5s 内不重复请求由 pane 侧
   *  mergeHead/isSameHead 去重兜底。 */
  onShow(() => {
    eventBus.emit(IM_MEETING_CHANGED_EVENT, {});
  });

  function handleBack(): void {
    uni.navigateBack({ delta: 1 });
  }
</script>

<style lang="scss" scoped>
  .mh-page {
    flex: 1;
    background-color: #f5f6f8;
  }

  .mh-header {
    height: 48px;
    padding: 0 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .mh-header__btn {
    width: 40px;
    height: 40px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mh-header__btn--active {
    opacity: 0.6;
  }

  .mh-header__btn--ghost {
    opacity: 0;
  }

  .mh-header__title-wrap {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mh-header__title {
    font-size: 17px;
    line-height: 24px;
    font-weight: 600;
    color: #141416;
  }
</style>
