import { invalidateImSession, notifyImSessionReady } from "@/utils/im/imSessionScope";
import { ACCESS_TOKEN, ACCESS_TOKEN_ORIGIN } from "@/constants/home.constants";
import { getApiBaseUrl } from "@/constants/config";
import { readCookie } from "@/utils/webCookie";
import {
  isAppWebViewEmbedded,
  persistAppWebViewEmbeddedFlag,
  readAccessTokenFromHashQuery,
} from "@/utils/appWebViewDetect";

/**
 * App 常驻 web-view：从 hash query 的 accessToken 写入本地登录态。
 * 须在 H5 App.onLaunch / 每次请求前调用，确保首屏接口能带上 Bearer。
 * accessToken 只允许是纯 token（见 readAccessTokenFromHashQuery），不含路径。
 */
export function bootstrapH5AccessTokenFromUrl(): void {
  // #ifdef H5 || WEB
  try {
    const token = readAccessTokenFromHashQuery();
    if (token.length == 0) {
      return;
    }
    // hash 上有 accessToken = 常驻壳打开的内嵌页，立刻标记内嵌，供 applyBearer 使用
    persistAppWebViewEmbeddedFlag();
    const existingRaw = uni.getStorageSync(ACCESS_TOKEN);
    const existing = existingRaw != null ? `${existingRaw}` : "";
    if (existing != token) {
      saveAccessToken(token);
    }
  } catch (_e) {
    // ignore
  }
  // #endif
}

/**
 * 当前是否持有任意形态的登录态：
 * - storage ACCESS_TOKEN 非空：App / 小程序 / H5 开发 / App 内嵌 H5（Bearer 模型）
 * - 浏览器 H5 生产：同域平台登录写下的 `ticket` Cookie 会话（storage 无 token，
 *   请求靠同源 Cookie 鉴权——「我的」页无条件发请求能出数据、消息页被闸门拦死即此因）
 *
 * 入口页「是否加载数据」的闸门必须用它，勿只查 storage token：H5 生产登录态走
 * Cookie，storage-only 判定会把有效会话拦成「暂无消息」空态（2026-10 测试站实测）。
 *
 * ★它只是「尽力而为」的本地提示，不是权威判定：H5 生产 Cookie 由服务端
 * Set-Cookie 下发（前端写入已在 da700c2cb 移除），HttpOnly / path 限定 / 后端
 * 改名都会让 document.cookie 读不到而返回 false。因此 H5 端闸门失败时必须
 * 放行请求、由 useRequest 4010 链路兜底踢登录，勿据 false 拦截或直接跳登录。
 */
export function hasLoginSession(): boolean {
  try {
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    if (tokenRaw != null && `${tokenRaw}`.length > 0) {
      return true;
    }
  } catch (_e) {
    // iOS getStorageSync 键不存在时可能抛「返回值为 undefined」（同 speechToken 处理）
  }
  // #ifdef H5 || WEB
  return readCookie("ticket").length > 0;
  // #endif
  // #ifndef H5 || WEB
  return false;
  // #endif
}

/** 保存 Token 及其所属服务域名。 */
export function saveAccessToken(token: string): void {
  const previous = uni.getStorageSync(ACCESS_TOKEN);
  if (`${previous ?? ""}` != token) invalidateImSession();
  uni.setStorageSync(ACCESS_TOKEN, token);
  uni.setStorageSync(ACCESS_TOKEN_ORIGIN, getApiBaseUrl());
  notifyImSessionReady();
}

/** 切换企业服务时清理旧服务的认证信息。 */
export function clearAccessToken(): void {
  invalidateImSession();
  uni.setStorageSync(ACCESS_TOKEN, "");
  uni.removeStorageSync(ACCESS_TOKEN_ORIGIN);
}

/**
 * 若当前运行时需要 Bearer 鉴权且 token 非空，写入 Authorization 头。
 *
 * - App / 微信小程序：始终写入（独立 `#ifdef`，避免 OR 条件被误裁）
 * - H5 开发 / App web-view 内嵌：写入
 * - H5 生产浏览器：不写，继续走 Cookie `ticket`
 *
 * @param header 请求头对象（会被原地修改）
 * @param accessToken 访问令牌；空则跳过
 */
export function applyBearerAuthorization(
  header: UTSJSONObject,
  accessToken: string | null,
): void {
  if (accessToken == null || `${accessToken}` == "") {
    return;
  }
  // #ifdef APP
  header["Authorization"] = `Bearer ${accessToken}`;
  return;
  // #endif
  // #ifdef MP-WEIXIN
  header["Authorization"] = `Bearer ${accessToken}`;
  return;
  // #endif

  // #ifdef H5 || WEB
  // 生产浏览器走 Cookie ticket；App 内嵌 / 开发环境走 Bearer。
  // 内嵌判定依赖桥全局或 bootstrap 写入的 sessionStorage 标记（见 isAppWebViewEmbedded）。
  if (
    process.env.NODE_ENV === "development" ||
    isAppWebViewEmbedded()
  ) {
    header["Authorization"] = `Bearer ${accessToken}`;
  }
  // #endif
}
