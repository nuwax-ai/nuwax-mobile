<template>
  <!--
    V2 轨迹中的 Plan 任务清单卡（standalone，不进普通工具组）。
    渲染逻辑自 mp-html container.vue Plan 分支迁移：任务状态图标 + 内容清单，默认展开。
  -->
  <view class="plan-trace-card">
    <view class="plan-trace-card__header">
      <view class="plan-trace-card__info" @tap="toggleExpanded">
        <text class="iconfont icon-task plan-trace-card__icon" />
        <text class="plan-trace-card__name">{{
          planName.length > 0
            ? planName
            : t("Mobile.ThirdParty.MpHtml.executionPlan")
        }}</text>
      </view>
      <view class="plan-trace-card__expand" @tap="toggleExpanded">
        <text
          class="iconfont"
          :class="planExpanded ? 'icon-MinusOutlined' : 'icon-Plus'"
        />
      </view>
    </view>
    <view v-if="planExpanded && planTasks.length > 0" class="plan-trace-card__list">
      <view
        v-for="(task, index) in planTasks"
        :key="index"
        class="plan-trace-card__task"
      >
        <view class="plan-trace-card__task-icon">
          <text
            class="iconfont plan-trace-card__task-iconfont"
            :class="taskIconClass(task)"
          />
        </view>
        <text class="plan-trace-card__task-content">{{ taskContent(task) }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import type { TraceToolRow } from "@/subpackages/components/ai-msg/conversationTrace.uts";
  import { useI18n } from "@/utils/i18n";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, undefined, "");

  const props = withDefaults(
    defineProps<{
      /** Plan 类型工具行数据（kind = todo）。 */
      row?: TraceToolRow | null;
    }>(),
    {
      row: null,
    },
  );

  const planExpanded = ref<boolean>(true);

  const planName = computed((): string => {
    return props.row != null ? props.row!.name : "";
  });

  /** Plan 任务列表：result.data 数组（{status, content}）。 */
  const planTasks = computed((): any[] => {
    const row = props.row;
    if (row == null || row!.processing == null) return [] as any[];
    const result = (row!.processing as UTSJSONObject)["result"];
    if (result == null || typeof result != "object") return [] as any[];
    const data = (result as UTSJSONObject)["data"];
    if (data == null || Array.isArray(data) != true) return [] as any[];
    return data as any[];
  });

  function taskStatus(task: any): string {
    if (task == null || typeof task != "object") return "pending";
    const status = (task as UTSJSONObject)["status"];
    return status != null ? `${status}` : "pending";
  }

  function taskContent(task: any): string {
    if (task == null || typeof task != "object") return "";
    const content = (task as UTSJSONObject)["content"];
    return content != null ? `${content}` : "";
  }

  function taskIconClass(task: any): string {
    const status = taskStatus(task);
    if (status == "completed") return "icon-CheckSquareOutlined";
    if (status == "in_progress") return "icon-HourglassOutlined";
    if (status == "failed") return "icon-CloseSquareOutlined";
    return "icon-BorderOutlined";
  }

  function toggleExpanded(): void {
    planExpanded.value = !planExpanded.value;
  }
</script>

<style lang="scss" scoped>
  .plan-trace-card {
    width: 100%;
    margin: 10rpx 0;
    border-radius: 12rpx;
    border: 1rpx solid rgba(28, 31, 40, 0.08);
    background-color: #ffffff;
    overflow: hidden;

    &__header {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      min-height: 68rpx;
      padding: 0 20rpx;
      box-sizing: border-box;
      background-color: rgba(18, 23, 43, 0.018);
    }

    &__info {
      display: flex;
      flex-direction: row;
      align-items: center;
      flex: 1;
      min-width: 0;
      gap: 10rpx;
    }

    &__icon {
      flex-shrink: 0;
      font-size: 26rpx;
      color: #8b8e96;
    }

    &__name {
      flex: 1;
      min-width: 0;
      font-size: 26rpx;
      font-weight: 600;
      color: #33363d;
      line-height: 38rpx;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &__expand {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44rpx;
      height: 44rpx;

      .iconfont {
        font-size: 28rpx;
        color: #8b8e96;
      }
    }

    &__list {
      padding: 6rpx 20rpx 14rpx;
      border-top: 1rpx solid rgba(28, 31, 40, 0.06);
      box-sizing: border-box;
    }

    &__task {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 8rpx;
      padding: 10rpx 0;
    }

    &__task-icon {
      flex-shrink: 0;
      width: 34rpx;
      height: 34rpx;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 2rpx;
    }

    &__task-iconfont {
      font-size: 30rpx;
      color: #8c8c8c;
    }

    &__task-content {
      flex: 1;
      font-size: 26rpx;
      color: #262626;
      line-height: 38rpx;
    }
  }
</style>
