/**
 * 边生成边播报器：AI 回复流式生成过程中，增量文本分句送 TTS 并顺序播放。
 *
 * 核心机制：
 * - 双通道（body / think）各自跟踪 consumedRaw 指针，只处理新增原始文本；
 * - 代码围栏配对保护：流未结束时，未闭合的 ``` 围栏之后的内容不参与清洗，
 *   避免增量清洗把后续正文误吞进"未闭合代码块"；
 * - 边界回退：每次消费预留 HOLD_BACK_CHARS 个字符，给跨分片的行内代码/链接/
 *   加粗等短模式留出重扫空间（流结束时全量消费）；
 * - 快照合并：高频 chunk 只保留最新快照，处理循环串行执行，避免 Promise 链堆积；
 * - 播放会话校验：首句 playList 开播后记录 sessionId，后续 enqueue 凭会话追加；
 *   会话被外部打断（手动停止/单条播放/新一轮）时自动停用。
 */
import { voiceConfig } from "./voiceConfig";
import { AudioQueueItem, VoiceSettings } from "./voiceTypes";
import { cleanTextForSpeech, drainCompleteSentences } from "./textFilter";
import { ttsService } from "./ttsService";
import { audioPlayerManager } from "./audioPlayerManager";

/** 边界回退字符数（覆盖行内代码/链接等短模式的跨片切分） */
const HOLD_BACK_CHARS = 16;

/** 单通道（body/think）消费状态 */
class StreamChannel {
  /** 已消费的原始文本长度 */
  consumedRaw: number = 0;
  /** 已清洗但未分句的文本 */
  pending: string = "";
}

/** 流式文本快照（onStreamChunk 入参，携带全量累计文本） */
class ChunkSnapshot {
  bodyText: string = "";
  thinkText: string = "";
  finished: boolean = false;
  /** 生成轮次（begin 自增），用于丢弃上一轮的滞留快照 */
  round: number = 0;
}

export class VoiceStreamSpeaker {
  private active: boolean = false;
  private messageId: string = "";
  private settings: VoiceSettings = new VoiceSettings();
  private bodyChannel: StreamChannel = new StreamChannel();
  private thinkChannel: StreamChannel = new StreamChannel();
  /** 播放会话序号；-1 表示尚未开播（首句未合成完成） */
  private playSession: number = -1;
  /** 全局分段序号（跨通道递增，保证合成顺序） */
  private segmentIndex: number = 0;
  /** 生成轮次计数 */
  private round: number = 0;
  /** 处理循环运行标记 */
  private processing: boolean = false;
  /** 待处理快照（只保留最新一份） */
  private queuedChunk: ChunkSnapshot | null = null;

  /**
   * 开始一轮流式播报（新一轮会话开始时调用）
   * 会打断当前播报（含单条消息播放）。
   */
  begin(messageId: string, settings: VoiceSettings): void {
    audioPlayerManager.stop();
    this.round += 1;
    this.messageId = messageId;
    this.settings = settings;
    this.bodyChannel = new StreamChannel();
    this.thinkChannel = new StreamChannel();
    this.playSession = -1;
    this.segmentIndex = 0;
    this.queuedChunk = null;
    this.active = true;
  }

  /**
   * 流式文本回调（SSE 每次消息列表更新后调用）
   * @param bodyText 正文累计文本（非增量）
   * @param thinkText 思考内容累计文本（非增量）
   * @param finished 本轮流式输出是否结束
   */
  onStreamChunk(bodyText: string, thinkText: string, finished: boolean): void {
    if (!this.active) {
      return;
    }
    const snap = new ChunkSnapshot();
    snap.bodyText = bodyText;
    snap.thinkText = thinkText;
    snap.finished = finished;
    snap.round = this.round;
    // 快照合并：只留最新，处理循环会消费到最新状态
    this.queuedChunk = snap;
    this.kick();
  }

  /** 停止流式播报（清空播放队列；会话停止/新轮次/单条播放时调用） */
  stop(): void {
    this.active = false;
    this.queuedChunk = null;
    this.playSession = -1;
    audioPlayerManager.stop();
  }

  /** 是否处于流式播报中 */
  isActive(): boolean {
    return this.active;
  }

  /** 串行处理循环：合并消费排队快照 */
  private async kick(): Promise<void> {
    if (this.processing) {
      return;
    }
    this.processing = true;
    while (this.active) {
      const snap = this.queuedChunk;
      if (snap == null) {
        break;
      }
      this.queuedChunk = null;
      if (snap.round != this.round) {
        continue;
      }
      try {
        await this.processChunk(snap);
      } catch (e: any) {
        console.warn("[VoiceStreamSpeaker] process chunk failed", e);
      }
    }
    this.processing = false;
  }

  /** 处理一份快照：双通道清洗分句 → 合成入队 */
  private async processChunk(snap: ChunkSnapshot): Promise<void> {
    const sentences: string[] = [];
    // think 通道：正文已开始或流结束时，冲刷思考内容尾句（保持先 think 后 body 顺序）
    if (this.settings.includeThinkContent && snap.thinkText.length > 0) {
      const thinkFlush = snap.finished || snap.bodyText.length > 0;
      this.drainChannel(this.thinkChannel, snap.thinkText, thinkFlush, sentences);
    }
    if (snap.bodyText.length > 0) {
      this.drainChannel(this.bodyChannel, snap.bodyText, snap.finished, sentences);
    }
    if (sentences.length > 0) {
      await this.enqueueSentences(sentences);
    }
    if (snap.finished) {
      // 流结束：停用（已入队音频继续播完）
      this.active = false;
    }
  }

  /**
   * 单通道增量处理：安全边界 → 增量清洗 → 追加缓冲 → 提取完结句
   * @param flush 为 true 时消费全部文本并冲刷尾句
   */
  private drainChannel(ch: StreamChannel, fullRaw: string, flush: boolean, out: string[]): void {
    const safeEnd = this.computeSafeEnd(fullRaw, flush);
    if (safeEnd > ch.consumedRaw) {
      const piece = fullRaw.substring(ch.consumedRaw, safeEnd);
      ch.consumedRaw = safeEnd;
      const cleaned = cleanTextForSpeech(piece, this.settings);
      if (cleaned.length > 0) {
        ch.pending = ch.pending.length > 0 ? ch.pending + "\n" + cleaned : cleaned;
      }
    }
    const drain = drainCompleteSentences(ch.pending, flush);
    ch.pending = drain.remainder;
    for (let i = 0; i < drain.sentences.length; i++) {
      out.push(drain.sentences[i]);
    }
  }

  /**
   * 计算本次可安全消费的原始文本边界
   * 1. 未闭合 ``` 围栏之后的内容不消费（等围栏闭合或流结束）；
   * 2. 未结束时预留 HOLD_BACK_CHARS 边界回退。
   */
  private computeSafeEnd(raw: string, flush: boolean): number {
    if (flush) {
      return raw.length;
    }
    let end: number = raw.length;
    if (this.countFences(raw) % 2 == 1) {
      end = raw.lastIndexOf("```");
    }
    const holdEnd = raw.length - HOLD_BACK_CHARS;
    if (end > holdEnd) {
      end = holdEnd;
    }
    return end > 0 ? end : 0;
  }

  /** 统计 ``` 围栏出现次数（不重叠） */
  private countFences(raw: string): number {
    let count = 0;
    let idx = 0;
    while (true) {
      const found = raw.indexOf("```", idx);
      if (found < 0) {
        break;
      }
      count += 1;
      idx = found + 3;
    }
    return count;
  }

  /** 逐句合成并入队；首句开播并记录播放会话 */
  private async enqueueSentences(sentences: string[]): Promise<void> {
    for (let i = 0; i < sentences.length; i++) {
      if (!this.active) {
        return;
      }
      if (this.segmentIndex >= voiceConfig.maxSentencesPerMessage) {
        console.warn("[VoiceStreamSpeaker] reach max sentences, stop enqueue");
        this.active = false;
        return;
      }
      const idx = this.segmentIndex;
      this.segmentIndex += 1;
      const item = await ttsService.synthesize(sentences[i], this.messageId, idx);
      if (!this.active) {
        return;
      }
      if (this.playSession < 0) {
        this.playSession = audioPlayerManager.playList([item]);
      } else {
        audioPlayerManager.enqueue([item], this.playSession);
        // 会话被外部打断（手动停止/单条播放），停用流式播报
        if (audioPlayerManager.getSessionId() != this.playSession) {
          this.active = false;
          return;
        }
      }
    }
  }
}

/** 全局流式播报单例 */
export const voiceStreamSpeaker = new VoiceStreamSpeaker();
