/**
 * 原生选择弹层的横向切页手势。
 * 仅在横向位移超过 50px 且明显大于纵向位移时返回方向，避免影响列表纵向滚动。
 */
export class HorizontalTabSwipeTracker {
  private startX: number = 0;
  private startY: number = 0;
  private started: boolean = false;

  begin(event: UniTouchEvent): void {
    if (event == null || event.touches == null || event.touches.length == 0) {
      this.started = false;
      return;
    }
    this.startX = event.touches[0].clientX;
    this.startY = event.touches[0].clientY;
    this.started = true;
  }

  /** 向左滑返回 1（下一页），向右滑返回 -1（上一页），其余返回 0。 */
  finish(event: UniTouchEvent): number {
    if (!this.started || event == null || event.changedTouches == null || event.changedTouches.length == 0) {
      this.started = false;
      return 0;
    }
    this.started = false;
    const touch = event.changedTouches[0];
    const deltaX = touch.clientX - this.startX;
    const deltaY = touch.clientY - this.startY;
    const absX = Math.abs(deltaX);
    const absY = Math.abs(deltaY);
    if (absX < 50 || absX <= absY * 1.2) return 0;
    return deltaX < 0 ? 1 : -1;
  }
}
