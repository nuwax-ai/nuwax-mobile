<template>
  <view class="create">
    <custom-nav-bar :title="pageTitle" className="border-b" hasSafetyZone :show-back="false">
      <template #left>
        <text class="create__nav" @click="onCancel">{{ t("Mobile.Common.cancel") }}</text>
      </template>
      <template #right>
        <text class="create__nav create__nav--save" @click="onSave">{{ t("Mobile.Common.save") }}</text>
      </template>
    </custom-nav-bar>

    <scroll-view class="create__scroll" direction="vertical" :show-scrollbar="false">
      <view class="create__theme">
        <input
          class="create__theme-input"
          v-model="title"
          :maxlength="80"
          :placeholder="t('Mobile.Discover.scheduleThemePlaceholder')"
          placeholder-style="color: #c8cad0; font-size: 22px;"
        />
      </view>
      <view class="create__line"></view>

      <view class="create__row" @click="onParticipants">
        <view class="create__icon">
          <svg-icon name="icon-User" size="20" unit="px" color="#c9cdd4" />
        </view>
        <text :class="peopleText.length > 0 ? 'create__label' : 'create__placeholder'">{{ peopleText.length > 0 ? peopleText : t("Mobile.Discover.scheduleAddParticipants") }}</text>
      </view>
      <view class="create__line"></view>

      <view class="create__when">
        <view class="create__icon create__icon--top">
          <svg-icon name="icon-Clock" size="20" unit="px" color="#c9cdd4" />
        </view>
        <view class="create__when-main">
          <view class="create__when-side" @click="openStartSheet">
            <text class="create__hm">{{ startTime }}</text>
            <text class="create__date">{{ startDateText }}</text>
            <text class="create__tz">{{ t("Mobile.Discover.scheduleTimezone") }}</text>
          </view>
          <view class="create__when-arrow">
            <svg-icon name="icon-a-Chevronright" size="16" unit="px" color="#c9cdd4" />
          </view>
          <view class="create__when-side" @click="openEndSheet">
            <text class="create__hm">{{ endTime }}</text>
            <text class="create__date">{{ endDateText }}</text>
          </view>
        </view>
      </view>
      <view class="create__line"></view>

      <view class="create__row" @click="pickRepeat">
        <view class="create__icon">
          <svg-icon name="icon-refresh" size="20" unit="px" color="#c9cdd4" />
        </view>
        <text class="create__label">{{ t("Mobile.Discover.scheduleRepeat") }}</text>
        <text class="create__value">{{ repeatLabel }}</text>
        <svg-icon name="icon-a-Chevronright" size="14" unit="px" color="#c9cdd4" />
      </view>
      <view class="create__line"></view>

      <view class="create__row">
        <view class="create__icon">
          <view class="create__pin"></view>
        </view>
        <input
          class="create__field"
          v-model="location"
          :maxlength="80"
          :placeholder="t('Mobile.Discover.scheduleAddLocation')"
          placeholder-style="color: #86909c; font-size: 16px;"
        />
      </view>
      <view class="create__line"></view>

      <view class="create__row" @click="pickRemind">
        <view class="create__icon">
          <svg-icon name="icon-bell" size="20" unit="px" color="#c9cdd4" />
        </view>
        <text class="create__label">{{ t("Mobile.Discover.scheduleRemind") }}</text>
        <text class="create__value">{{ remindLabel }}</text>
        <svg-icon name="icon-a-Chevronright" size="14" unit="px" color="#c9cdd4" />
      </view>
      <view class="create__line"></view>

      <view class="create__row">
        <view class="create__icon">
          <svg-icon name="icon-a-Filetext" size="20" unit="px" color="#c9cdd4" />
        </view>
        <input
          class="create__field"
          v-model="notes"
          :maxlength="200"
          :placeholder="t('Mobile.Discover.scheduleAddNotes')"
          placeholder-style="color: #86909c; font-size: 16px;"
        />
      </view>
      <view class="create__line"></view>
      <view v-if="editing" class="create__delete" @click="onDelete">
        <text class="create__delete-text">{{ t("Mobile.Discover.scheduleDelete") }}</text>
      </view>
    </scroll-view>

    <view v-if="sheetOpen" class="sheet">
      <view class="sheet__mask" @click="closeSheet"></view>
      <view class="sheet__panel">
        <view class="sheet__head">
          <text class="sheet__action" @click="closeSheet">{{ t("Mobile.Common.cancel") }}</text>
          <text class="sheet__title">{{ sheetTitle }}</text>
          <text class="sheet__action sheet__action--done" @click="onSheetDone">{{ t("Mobile.Discover.scheduleSheetDone") }}</text>
        </view>
        <scroll-view
          v-if="showSheetDays"
          class="sheet__days"
          direction="horizontal"
          :show-scrollbar="false"
          :scroll-with-animation="false"
          :scroll-left="dayScrollLeftPx"
          :upper-threshold="48"
          :lower-threshold="80"
          @scroll="onDayScroll"
          @scrolltoupper="prependDays"
          @scrolltolower="appendDays"
        >
          <view class="sheet__days-row" :style="dayRowStyle">
            <view
              v-for="(day, dayIndex) in sheetDays"
              :key="dayIndex"
              class="sheet__day-wrap"
              @click="onPickDay(day.key)"
            >
              <view :class="day.key == draftDate ? 'sheet__day sheet__day--on' : 'sheet__day'">
                <text :class="day.key == draftDate ? 'sheet__day-wd sheet__day-wd--on' : 'sheet__day-wd'">{{ day.weekday }}</text>
                <text :class="day.key == draftDate ? 'sheet__day-num sheet__day-num--on' : 'sheet__day-num'">{{ day.dayText }}</text>
                <text :class="day.key == draftDate ? 'sheet__day-month sheet__day-month--on' : 'sheet__day-month'">{{ day.monthText }}</text>
              </view>
            </view>
          </view>
        </scroll-view>
        <scroll-view
          :class="showSheetDays ? 'sheet__times' : 'sheet__times sheet__times--tall'"
          direction="vertical"
          :show-scrollbar="false"
          :scroll-into-view="slotScroll"
        >
          <view class="sheet__grid">
            <view
              v-for="(slot, slotIndex) in sheetSlots"
              :key="slotIndex"
              :id="slot.anchor"
              class="sheet__cell"
              @click="onPickSlot(slot.label)"
            >
              <view :class="slot.label == draftTime ? 'sheet__chip sheet__chip--on' : (slot.disabled ? 'sheet__chip sheet__chip--off' : 'sheet__chip')">
                <text :class="slot.label == draftTime ? 'sheet__chip-text sheet__chip-text--on' : (slot.disabled ? 'sheet__chip-text sheet__chip-text--off' : 'sheet__chip-text')">{{ slot.label }}</text>
              </view>
            </view>
          </view>
        </scroll-view>
        <text class="sheet__hint">{{ t("Mobile.Discover.scheduleSlotHint") }}</text>
      </view>
    </view>

    <view v-if="peopleOpen" class="sheet">
      <view class="sheet__mask" @click="closePeople"></view>
      <view class="sheet__panel">
        <view class="sheet__handle"></view>
        <view class="sheet__head">
          <text class="sheet__action" @click="closePeople">{{ t("Mobile.Common.cancel") }}</text>
          <text class="sheet__title">{{ t("Mobile.Discover.scheduleAddParticipants") }}</text>
          <text class="sheet__action sheet__action--done" @click="onPeopleDone">{{ t("Mobile.Discover.scheduleSheetDone") }}</text>
        </view>
        <scroll-view class="people" direction="vertical" :show-scrollbar="false">
          <view v-for="(person, personIndex) in peopleRows" :key="personIndex" class="people__row" @click="onTogglePerson(person.id)">
            <view class="people__avatar" :style="person.avatarStyle">
              <text class="people__badge">{{ person.badge }}</text>
            </view>
            <text class="people__name">{{ person.name }}</text>
            <view :class="person.picked ? 'people__check people__check--on' : 'people__check'">
              <view v-if="person.picked" class="people__tick"></view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view v-if="remindOpen" class="sheet">
      <view class="sheet__mask" @click="closeRemind"></view>
      <view class="sheet__panel">
        <view class="sheet__handle"></view>
        <text class="remind__title">{{ t("Mobile.Discover.scheduleRemind") }}</text>
        <view v-for="(row, rowIndex) in remindRows" :key="rowIndex" class="remind__row" @click="onPickRemind(row.key)">
          <text class="remind__label">{{ row.label }}</text>
          <view v-if="row.picked" class="remind__mark"></view>
        </view>
      </view>
    </view>

    <view v-if="deleteOpen" class="sheet del-sheet">
      <view :class="deleteShown ? 'del-mask del-mask--on' : 'del-mask'" @click="closeDelete"></view>
      <view :class="deleteShown ? 'del del--on' : 'del'">
        <view class="sheet__handle"></view>
        <text class="del__title">{{ t("Mobile.Discover.scheduleDeleteAsk") }}</text>
        <text class="del__hint">{{ deleteHint }}</text>
        <view class="del__actions">
          <view class="del__btn del__btn--cancel" @click="closeDelete">
            <text class="del__btn-text">{{ t("Mobile.Common.cancel") }}</text>
          </view>
          <view class="del__btn del__btn--danger" @click="confirmDelete">
            <text class="del__btn-text del__btn-text--danger">{{ t("Mobile.Common.delete") }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { nextTick, ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { editableEvent, shiftDate } from "@/utils/scheduleBoard";
  import { ScheduleEvent, appendScheduleEvent, removeScheduleEvent, saveScheduleEvent } from "@/utils/scheduleStore";
  import { participantSummary, schedulePeople, splitPeopleIds } from "@/utils/schedulePeople";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const weekdayKeys: string[] = [
    "Mobile.Discover.weekdaySun",
    "Mobile.Discover.weekdayMon",
    "Mobile.Discover.weekdayTue",
    "Mobile.Discover.weekdayWed",
    "Mobile.Discover.weekdayThu",
    "Mobile.Discover.weekdayFri",
    "Mobile.Discover.weekdaySat",
  ];

  const repeatKeys: string[] = ["none", "daily", "weekly", "monthly", "yearly"];
  const remindKeys: string[] = ["none", "start", "m5", "m15", "m30", "h1", "d1"];

  class SheetDay {
    key: string = "";
    weekday: string = "";
    dayText: string = "";
    monthText: string = "";
  }

  class SheetSlot {
    anchor: string = "";
    label: string = "";
    disabled: boolean = false;
  }

  class PersonRow {
    id: string = "";
    name: string = "";
    badge: string = "";
    avatarStyle: string = "";
    picked: boolean = false;
  }

  class RemindRow {
    key: string = "";
    label: string = "";
    picked: boolean = false;
  }

  const pageTitle = ref<string>(t("Mobile.Discover.scheduleCreate"));
  const editing = ref<boolean>(false);
  let editingId = "";
  const title = ref<string>("");
  const location = ref<string>("");
  const notes = ref<string>("");
  const startDate = ref<string>("");
  const endDate = ref<string>("");
  const startTime = ref<string>("14:30");
  const endTime = ref<string>("15:00");
  const startDateText = ref<string>("");
  const endDateText = ref<string>("");
  const repeat = ref<string>("none");
  const remind = ref<string>("m15");
  const repeatLabel = ref<string>("");
  const remindLabel = ref<string>("");
  const sheetOpen = ref<boolean>(false);
  const showSheetDays = ref<boolean>(false);
  const sheetTitle = ref<string>("");
  const draftDate = ref<string>("");
  const draftTime = ref<string>("");
  const sheetDays = ref<SheetDay[]>([]);
  const sheetSlots = ref<SheetSlot[]>([]);
  const slotScroll = ref<string>("");
  const dayScrollLeftPx = ref<number>(0);
  const dayRowStyle = ref<string>("");
  const peopleOpen = ref<boolean>(false);
  const remindOpen = ref<boolean>(false);
  const deleteOpen = ref<boolean>(false);
  const deleteShown = ref<boolean>(false);
  const deleteHint = ref<string>("");
  const remindRows = ref<RemindRow[]>([]);
  const peopleText = ref<string>("");
  const peopleRows = ref<PersonRow[]>([]);
  let pickedIds: string[] = [];
  let draftPeople: string[] = [];
  let sheetKind = "";
  let dayScrollLeft = 0;
  let dayScrollReady = false;
  let dayPaging = false;
  let saving = false;

  function pad2(n: number): string {
    if (n < 10) {
      return "0" + n;
    }
    return "" + n;
  }

  function isoDate(year: number, month: number, day: number): string {
    return year + "-" + pad2(month) + "-" + pad2(day);
  }

  function dateText(iso: string): string {
    if (iso.length < 10) {
      return "";
    }
    const year = parseInt(iso.substring(0, 4));
    const month = parseInt(iso.substring(5, 7));
    const day = parseInt(iso.substring(8, 10));
    if (isNaN(year) || isNaN(month) || isNaN(day)) {
      return "";
    }
    const date = new Date(year, month - 1, day);
    const params = new Map<string, string | number>();
    params.set("month", month);
    params.set("day", day);
    params.set("weekday", t(weekdayKeys[date.getDay()]));
    return translateFn("Mobile.Discover.scheduleDatePlain", toI18nParams(params), "");
  }

  function refreshDateText(): void {
    startDateText.value = dateText(startDate.value);
    endDateText.value = dateText(endDate.value);
  }

  function minutesText(minutes: number): string {
    const params = new Map<string, string | number>();
    params.set("minutes", minutes);
    return translateFn("Mobile.Discover.scheduleRemindMinutes", toI18nParams(params), "");
  }

  function refreshChoiceText(): void {
    if (repeat.value == "daily") {
      repeatLabel.value = t("Mobile.Discover.scheduleRepeatDaily");
    } else if (repeat.value == "weekly") {
      repeatLabel.value = t("Mobile.Discover.scheduleRepeatWeekly");
    } else if (repeat.value == "monthly") {
      repeatLabel.value = t("Mobile.Discover.scheduleRepeatMonthly");
    } else if (repeat.value == "yearly") {
      repeatLabel.value = t("Mobile.Discover.scheduleRepeatYearly");
    } else {
      repeatLabel.value = t("Mobile.Discover.scheduleRepeatNone");
    }

    if (remind.value == "none") {
      remindLabel.value = t("Mobile.Discover.scheduleRemindNone");
    } else if (remind.value == "start") {
      remindLabel.value = t("Mobile.Discover.scheduleRemindStart");
    } else if (remind.value == "m5") {
      remindLabel.value = minutesText(5);
    } else if (remind.value == "m30") {
      remindLabel.value = minutesText(30);
    } else if (remind.value == "h1") {
      remindLabel.value = t("Mobile.Discover.scheduleRemindHour");
    } else if (remind.value == "d1") {
      remindLabel.value = t("Mobile.Discover.scheduleRemindDay");
    } else {
      remindLabel.value = minutesText(15);
    }
  }

  function timeToMin(hm: string): number {
    const parts = hm.split(":");
    if (parts.length < 2) {
      return 0;
    }
    const hour = parseInt(parts[0]);
    const minute = parseInt(parts[1]);
    if (isNaN(hour) || isNaN(minute)) {
      return 0;
    }
    return hour * 60 + minute;
  }

  function minToTime(total: number): string {
    let value = total;
    if (value < 0) {
      value = 0;
    }
    if (value > 23 * 60 + 59) {
      value = 23 * 60 + 59;
    }
    const hour = Math.floor(value / 60);
    const minute = value % 60;
    return pad2(hour) + ":" + pad2(minute);
  }

  function readQueryInt(options: any, key: string, fallback: number): number {
    if (options == null) {
      return fallback;
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const n = parseInt(`${raw}`);
    if (isNaN(n)) {
      return fallback;
    }
    return n;
  }

  function compareIso(a: string, b: string): number {
    const left = a.length < b.length ? a.length : b.length;
    for (let i = 0; i < left; i++) {
      const caRaw = a.charCodeAt(i);
      const cbRaw = b.charCodeAt(i);
      const ca = caRaw != null ? caRaw : 0;
      const cb = cbRaw != null ? cbRaw : 0;
      const diff = ca - cb;
      if (diff != 0) {
        return diff;
      }
    }
    return a.length - b.length;
  }

  /** 结束时间不早于开始时间；同一天不足 1 分钟时把结束时间推后 30 分钟。 */
  function keepEndAfterStart(): void {
    const dateOrder = compareIso(endDate.value, startDate.value);
    if (dateOrder > 0) {
      return;
    }
    if (dateOrder < 0) {
      endDate.value = startDate.value;
    }
    const startMin = timeToMin(startTime.value);
    const endMin = timeToMin(endTime.value);
    if (endMin <= startMin) {
      endTime.value = minToTime(startMin + 30);
    }
  }

  function parseIso(iso: string): number[] {
    const result: number[] = [];
    const year = iso.length >= 4 ? parseInt(iso.substring(0, 4)) : 0;
    const month = iso.length >= 7 ? parseInt(iso.substring(5, 7)) : 0;
    const day = iso.length >= 10 ? parseInt(iso.substring(8, 10)) : 0;
    result.push(isNaN(year) ? 2026 : year);
    result.push(isNaN(month) || month <= 0 ? 1 : month);
    result.push(isNaN(day) || day <= 0 ? 1 : day);
    return result;
  }

  function monthChip(month: number): string {
    const params = new Map<string, string | number>();
    params.set("month", month);
    return translateFn("Mobile.Discover.scheduleMonthChip", toI18nParams(params), "");
  }

  function snapTime(hm: string): string {
    const snapped = Math.floor(timeToMin(hm) / 30) * 30;
    return minToTime(snapped);
  }

  const dayStride = 66;
  const dayPage = 14;

  function makeDay(year: number, month: number, day: number): SheetDay {
    const item = new SheetDay();
    item.key = isoDate(year, month, day);
    item.weekday = t(weekdayKeys[new Date(year, month - 1, day).getDay()]);
    item.dayText = "" + day;
    item.monthText = monthChip(month);
    return item;
  }

  function daysFrom(year: number, month: number, day: number, count: number): SheetDay[] {
    const days: SheetDay[] = [];
    for (let i = 0; i < count; i++) {
      const date = shiftDate(year, month, day, i);
      days.push(makeDay(date[0], date[1], date[2]));
    }
    return days;
  }

  function syncDayRowWidth(): void {
    dayRowStyle.value = "width:" + (16 + dayStride * sheetDays.value.length) + "px";
  }

  function dayIndex(iso: string): number {
    const days = sheetDays.value;
    for (let i = 0; i < days.length; i++) {
      if (days[i].key == iso) {
        return i;
      }
    }
    return 0;
  }

  function onDayScroll(event: UniScrollEvent): void {
    dayScrollLeft = event.detail.scrollLeft;
  }

  function prependDays(): void {
    if (!dayScrollReady || dayPaging || sheetDays.value.length == 0 || sheetDays.value.length >= 800) {
      return;
    }
    const first = parseIso(sheetDays.value[0].key);
    if (first[0] < 2000) {
      return;
    }
    const start = shiftDate(first[0], first[1], first[2], -dayPage);
    dayPaging = true;
    const extra = daysFrom(start[0], start[1], start[2], dayPage);
    const merged: SheetDay[] = [];
    for (let i = 0; i < extra.length; i++) {
      merged.push(extra[i]);
    }
    const current = sheetDays.value;
    for (let i = 0; i < current.length; i++) {
      merged.push(current[i]);
    }
    sheetDays.value = merged;
    syncDayRowWidth();
    const next = dayScrollLeft + dayPage * dayStride;
    dayScrollLeft = next;
    nextTick(() => {
      dayScrollLeftPx.value = next;
      setTimeout(() => {
        dayPaging = false;
      }, 280);
    });
  }

  function appendDays(): void {
    if (!dayScrollReady || dayPaging || sheetDays.value.length == 0 || sheetDays.value.length >= 800) {
      return;
    }
    const last = parseIso(sheetDays.value[sheetDays.value.length - 1].key);
    if (last[0] > 2100) {
      return;
    }
    const start = shiftDate(last[0], last[1], last[2], 1);
    dayPaging = true;
    const extra = daysFrom(start[0], start[1], start[2], dayPage);
    const merged: SheetDay[] = [];
    const current = sheetDays.value;
    for (let i = 0; i < current.length; i++) {
      merged.push(current[i]);
    }
    for (let i = 0; i < extra.length; i++) {
      merged.push(extra[i]);
    }
    sheetDays.value = merged;
    syncDayRowWidth();
    setTimeout(() => {
      dayPaging = false;
    }, 280);
  }

  function armDayScroll(): void {
    dayScrollReady = false;
    let left = dayIndex(draftDate.value) * dayStride - dayStride;
    if (left < 0) {
      left = 0;
    }
    dayScrollLeft = left;
    dayScrollLeftPx.value = 0;
    nextTick(() => {
      dayScrollLeftPx.value = left;
      setTimeout(() => {
        dayScrollReady = true;
      }, 350);
    });
  }

  function rebuildSlots(): void {
    const startMin = timeToMin(startTime.value);
    const blocking = sheetKind == "end";
    const slots: SheetSlot[] = [];
    for (let i = 0; i < 48; i++) {
      const minutes = i * 30;
      const item = new SheetSlot();
      item.anchor = "s" + minutes;
      item.label = minToTime(minutes);
      item.disabled = blocking && minutes <= startMin;
      slots.push(item);
    }
    sheetSlots.value = slots;
  }

  function armSlotScroll(): void {
    const anchor = "s" + timeToMin(draftTime.value);
    slotScroll.value = "";
    nextTick(() => {
      slotScroll.value = anchor;
    });
  }

  function openStartSheet(): void {
    peopleOpen.value = false;
    remindOpen.value = false;
    const parts = parseIso(startDate.value);
    const start = shiftDate(parts[0], parts[1], parts[2], -dayPage);
    sheetKind = "start";
    showSheetDays.value = true;
    sheetTitle.value = t("Mobile.Discover.scheduleStartTime");
    draftDate.value = startDate.value;
    draftTime.value = snapTime(startTime.value);
    sheetDays.value = daysFrom(start[0], start[1], start[2], dayPage * 2 + 8);
    syncDayRowWidth();
    rebuildSlots();
    sheetOpen.value = true;
    armSlotScroll();
    armDayScroll();
  }

  function openEndSheet(): void {
    peopleOpen.value = false;
    remindOpen.value = false;
    sheetKind = "end";
    showSheetDays.value = false;
    sheetTitle.value = t("Mobile.Discover.scheduleEndTime");
    draftDate.value = endDate.value;
    let next = snapTime(endTime.value);
    const startMin = timeToMin(startTime.value);
    if (timeToMin(next) <= startMin) {
      next = minToTime(startMin + 30);
    }
    draftTime.value = next;
    rebuildSlots();
    sheetOpen.value = true;
    armSlotScroll();
  }

  function onPickDay(iso: string): void {
    draftDate.value = iso;
  }

  function onPickSlot(label: string): void {
    const slots = sheetSlots.value;
    for (let i = 0; i < slots.length; i++) {
      if (slots[i].label == label) {
        if (slots[i].disabled) {
          return;
        }
        draftTime.value = label;
        return;
      }
    }
  }

  function closeSheet(): void {
    sheetOpen.value = false;
    sheetKind = "";
  }

  function onSheetDone(): void {
    if (sheetKind == "start") {
      startDate.value = draftDate.value;
      startTime.value = draftTime.value;
      endDate.value = draftDate.value;
      keepEndAfterStart();
      refreshDateText();
    } else if (sheetKind == "end") {
      endTime.value = draftTime.value;
      keepEndAfterStart();
    }
    closeSheet();
  }

  function pickRepeat(): void {
    uni.showActionSheet({
      itemList: [
        t("Mobile.Discover.scheduleRepeatNone"),
        t("Mobile.Discover.scheduleRepeatDaily"),
        t("Mobile.Discover.scheduleRepeatWeekly"),
        t("Mobile.Discover.scheduleRepeatMonthly"),
        t("Mobile.Discover.scheduleRepeatYearly"),
      ],
      success: (res: ShowActionSheetSuccess): void => {
        if (res.tapIndex >= 0 && res.tapIndex < repeatKeys.length) {
          repeat.value = repeatKeys[res.tapIndex];
          refreshChoiceText();
        }
      },
    });
  }

  function remindLabelOf(key: string): string {
    if (key == "none") {
      return t("Mobile.Discover.scheduleRemindNone");
    }
    if (key == "start") {
      return t("Mobile.Discover.scheduleRemindStart");
    }
    if (key == "m5") {
      return minutesText(5);
    }
    if (key == "m30") {
      return minutesText(30);
    }
    if (key == "h1") {
      return t("Mobile.Discover.scheduleRemindHour");
    }
    if (key == "d1") {
      return t("Mobile.Discover.scheduleRemindDay");
    }
    return minutesText(15);
  }

  function buildRemindRows(): void {
    const rows: RemindRow[] = [];
    for (let i = 0; i < remindKeys.length; i++) {
      const row = new RemindRow();
      row.key = remindKeys[i];
      row.label = remindLabelOf(remindKeys[i]);
      row.picked = remindKeys[i] == remind.value;
      rows.push(row);
    }
    remindRows.value = rows;
  }

  function pickRemind(): void {
    peopleOpen.value = false;
    closeSheet();
    buildRemindRows();
    remindOpen.value = true;
  }

  function closeRemind(): void {
    remindOpen.value = false;
  }

  function onPickRemind(key: string): void {
    remind.value = key;
    refreshChoiceText();
    closeRemind();
  }

  function includesId(ids: string[], id: string): boolean {
    for (let i = 0; i < ids.length; i++) {
      if (ids[i] == id) {
        return true;
      }
    }
    return false;
  }

  function joinPeopleIds(ids: string[]): string {
    if (ids.length == 0) {
      return "";
    }
    let text = ids[0];
    for (let i = 1; i < ids.length; i++) {
      text = text + "," + ids[i];
    }
    return text;
  }

  function copyIds(ids: string[]): string[] {
    const next: string[] = [];
    for (let i = 0; i < ids.length; i++) {
      next.push(ids[i]);
    }
    return next;
  }

  function refreshPeopleRows(): void {
    const source = schedulePeople();
    const rows: PersonRow[] = [];
    for (let i = 0; i < source.length; i++) {
      const row = new PersonRow();
      row.id = source[i].id;
      row.name = source[i].name;
      row.badge = source[i].badge;
      row.avatarStyle = "background-color:" + source[i].color;
      row.picked = includesId(draftPeople, source[i].id);
      rows.push(row);
    }
    peopleRows.value = rows;
  }

  function refreshPeopleText(): void {
    peopleText.value = participantSummary(pickedIds);
  }

  function onParticipants(): void {
    remindOpen.value = false;
    if (sheetOpen.value) {
      closeSheet();
    }
    draftPeople = copyIds(pickedIds);
    refreshPeopleRows();
    peopleOpen.value = true;
  }

  function onTogglePerson(id: string): void {
    const next: string[] = [];
    let found = false;
    for (let i = 0; i < draftPeople.length; i++) {
      if (draftPeople[i] == id) {
        found = true;
      } else {
        next.push(draftPeople[i]);
      }
    }
    if (!found) {
      next.push(id);
    }
    draftPeople = next;
    refreshPeopleRows();
  }

  function closePeople(): void {
    peopleOpen.value = false;
  }

  function onPeopleDone(): void {
    pickedIds = copyIds(draftPeople);
    refreshPeopleText();
    closePeople();
  }

  function onCancel(): void {
    uni.navigateBack();
  }

  function onSave(): void {
    if (saving) {
      return;
    }
    saving = true;
    const event = new ScheduleEvent();
    event.id = "" + Date.now();
    event.title = title.value.trim();
    event.startDate = startDate.value;
    event.endDate = endDate.value;
    event.startTime = startTime.value;
    event.endTime = endTime.value;
    event.repeat = repeat.value;
    event.remind = remind.value;
    event.location = location.value.trim();
    event.notes = notes.value.trim();
    event.people = joinPeopleIds(pickedIds);
    if (editingId.length > 0) {
      event.id = editingId;
      saveScheduleEvent(event);
    } else {
      event.id = "" + Date.now();
      appendScheduleEvent(event);
    }
    uni.showToast({ title: t("Mobile.Discover.scheduleSaved"), icon: "none" });
    setTimeout(() => {
      uni.navigateBack();
    }, 400);
  }

  function readQueryText(options: any, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    return `${raw}`;
  }

  function applyEvent(event: ScheduleEvent): void {
    title.value = event.title;
    location.value = event.location;
    notes.value = event.notes;
    startDate.value = event.startDate;
    endDate.value = event.endDate.length > 0 ? event.endDate : event.startDate;
    if (event.startTime.length > 0) {
      startTime.value = event.startTime;
    }
    if (event.endTime.length > 0) {
      endTime.value = event.endTime;
    }
    repeat.value = event.repeat.length > 0 ? event.repeat : "none";
    remind.value = event.remind.length > 0 ? event.remind : "m15";
    pickedIds = splitPeopleIds(event.people);
    refreshDateText();
    refreshChoiceText();
    refreshPeopleText();
  }

  function onDelete(): void {
    if (saving || editingId.length == 0 || deleteOpen.value) {
      return;
    }
    const name = title.value.trim();
    const shown = name.length > 0 ? name : t("Mobile.Discover.scheduleUntitled");
    const params = new Map<string, string | number>();
    params.set("name", shown);
    deleteHint.value = translateFn("Mobile.Discover.scheduleDeleteHint", toI18nParams(params), "");
    deleteShown.value = false;
    deleteOpen.value = true;
    setTimeout(() => {
      deleteShown.value = true;
    }, 20);
  }

  function closeDelete(): void {
    if (!deleteOpen.value || saving) {
      return;
    }
    deleteShown.value = false;
    setTimeout(() => {
      deleteOpen.value = false;
    }, 240);
  }

  function confirmDelete(): void {
    if (saving || editingId.length == 0) {
      return;
    }
    saving = true;
    removeScheduleEvent(editingId);
    uni.showToast({ title: t("Mobile.Discover.scheduleDeleted"), icon: "none" });
    setTimeout(() => {
      uni.navigateBack();
    }, 400);
  }

  onLoad((options: any) => {
    const eventId = readQueryText(options, "id");
    if (eventId.length > 0) {
      const event = editableEvent(eventId);
      if (event == null) {
        uni.showToast({ title: t("Mobile.Discover.scheduleMissing"), icon: "none" });
        setTimeout(() => {
          uni.navigateBack();
        }, 400);
        return;
      }
      editingId = eventId;
      editing.value = true;
      pageTitle.value = t("Mobile.Discover.scheduleEdit");
      applyEvent(event);
      return;
    }
    const today = new Date();
    const year = readQueryInt(options, "year", today.getFullYear());
    const month = readQueryInt(options, "month", today.getMonth() + 1);
    const day = readQueryInt(options, "day", today.getDate());
    const iso = isoDate(year, month, day);
    startDate.value = iso;
    endDate.value = iso;
    refreshDateText();
    refreshChoiceText();
  });
</script>

