/** 客户端内部合同；不是已经存在的后端接口。后端适配器确认后单独实现。 */
export class NativeAuthTransaction {
  version: number = 1;
  id: string = "";
  origin: string = "";
  providerId: string = "";
  callbackUrl: string = "";
  returnPath: string = "";
  state: string = "";
  verifier: string = "";
  challenge: string = "";
  sessionStamp: string = "";
  serverTransactionId: string = "";
  createdAt: number = 0;
  expiresAt: number = 0;
  phase: string = "preparing";
}

/** prepare 不接收 verifier；它只会传给兑换适配器。 */
export class NativeAuthPrepareRequest {
  requestId: string = "";
  origin: string = "";
  providerId: string = "";
  callbackUrl: string = "";
  state: string = "";
  codeChallenge: string = "";
  codeChallengeMethod: string = "S256";
}

export class NativeAuthLaunch {
  authorizeUrl: string = "";
  serverTransactionId: string = "";
  expiresAt: number = 0;
}

export class NativeAuthExchangeRequest {
  requestId: string = "";
  origin: string = "";
  providerId: string = "";
  callbackUrl: string = "";
  serverTransactionId: string = "";
  code: string = "";
  codeVerifier: string = "";
}

export class NativeAuthSession {
  token: string = "";
  expiresAt: number = 0;
  resetPass: number = 1;
}

export class NativeAuthResult {
  status: string = "idle";
  error: string = "";
  requestId: string = "";
}

export class NativeAuthCallback {
  valid: boolean = false;
  code: string = "";
  error: string = "";
}

export interface NativeAuthCrypto {
  randomToken(): string;
  sha256Base64Url(value: string): string;
}

/** 仅进程内保存的完成信息，不含 Token；消费时还需复核会话上下文。 */
export class NativeAuthCompletion {
  origin: string = "";
  sessionStamp: string = "";
  userId: string = "";
  resetPass: number = 1;
  returnPath: string = "";
}

/** 实现必须是系统安全存储；不允许回落 uni storage。 */
export interface NativeAuthStorage {
  read(): string;
  write(value: string): boolean;
  clear(): boolean;
}

export interface NativeAuthBrowser {
  available(): boolean;
  open(requestId: string, authorizeUrl: string, callbackUrl: string): boolean;
  cancel(requestId: string): void;
}

export interface NativeAuthBackend {
  prepare(request: NativeAuthPrepareRequest): Promise<NativeAuthLaunch>;
  exchange(request: NativeAuthExchangeRequest): Promise<NativeAuthSession>;
  /** 必须通过业务接口验证候选 Token，返回平台 userId，不能只校验开放 OAuth userinfo。 */
  verify(origin: string, token: string): Promise<string>;
}

export interface NativeAuthSessionHost {
  currentOrigin(): string;
  currentSessionStamp(): string;
  commit(session: NativeAuthSession, userId: string, returnPath: string): void;
}
