    .depth-5 {
      font-size: 26rpx;
      line-height: 56rpx;
    }

    .depth-6 {
      font-size: 24rpx;
      color: #999;
      line-height: 56rpx;
    }
  }

  .hr {
    height: 2rpx;
    background: #ddd;
    margin: 20rpx 0;
  }
  .br {
    width: 100%;
    /* #ifndef APP */
    display: block;
    /* #endif */
  }

  .list-box {
    padding-left: 10rpx;
    .list-content {
      width: 100%;
    }
    .text {
      line-height: 56rpx;
    }
    .list-item-content-box {
      flex: 1;
      .list {
        margin-top: 0;
      }
    }
    .list-item-br {
      width: 100%;
    }
    .list-item-index {
      width: 40rpx;
      &.unordered {
        font-size: 28rpx;
        color: #000;
      }
      &.task {
        font-size: 28rpx;
        color: #666;
      }
    }
  }
  .list-inline-image-box {
    /* #ifndef APP */
    max-width: 100%;
    display: block;
    /* #endif */
    .list-content {
      width: 100%;
    }
    .text {
      line-height: 56rpx;
    }
    .list-item-content-box {
      flex: 1;
      .list {
        margin-top: 0;
      }
    }
    .list-item-br {
      width: 100%;
    }
    .list-item-index {
      width: 40rpx;
      &.unordered {
        font-size: 28rpx;
        color: #000;
      }
      &.task {
        font-size: 28rpx;
        color: #666;
      }
    }
  }

  .hr-box {
    background-color: #ddd;
    height: 2rpx;
  }

  .tool-call-box {
    width: 100%;
    margin: 10rpx 0;
  }

  .table-box,
  .code-box,
  .hr-box,
  .paragraph-box,
  .blockquote-box,
  .heading-box,
  .list-box,
  .loging-icon,
  .math-box {
    width: 100%;
    margin: 10rpx 0;
  }
  .paragraph-box {
    margin-top: 0;
    margin-bottom: 0;
  }

  .space-box {
    height: 30rpx;
  }

  .codespan {
    color: #666;
    background-color: #f5f5f5;
    padding: 4rpx 8rpx;
    border-radius: 10rpx;
    font-size: 28rpx;
    /* #ifndef APP */
    word-break: break-all;
    overflow-wrap: anywhere;
    /* #endif */
  }

  .icon-loading-image {
    width: 48rpx;
    height: 48rpx;
    margin-right: 10rpx;
    /* #ifndef APP */
    -webkit-touch-callout: none !important;
    -webkit-user-select: none !important;
    user-select: none !important;
    /* #endif */
  }
</style>
