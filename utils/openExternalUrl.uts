// #ifdef APP-ANDROID
import { openPayUrlNative } from "@/uni_modules/nuwax-android-native-pay";
// #endif

// #ifdef APP-HARMONY
import type { Want } from "@kit.AbilityKit";
// #endif

/**
 * 使用系统浏览器打开外部链接。
 * 更新地址由租户配置下发，仅允许 HTTP(S)，避免意外拉起其它应用协议。
 */
export function openExternalUrl(url: string): Promise<void> {
  if (!url.startsWith("https://") && !url.startsWith("http://")) {
    return Promise.reject(new Error());
  }

  // #ifdef APP-ANDROID
  return openPayUrlNative(url).then((): void => {});
  // #endif

  // #ifdef APP-IOS
  return new Promise<void>((resolve, reject) => {
    const target = NSURL.URLWithString(url);
    if (target == null) {
      reject(new Error());
      return;
    }
    UIApplication.shared.open(
      target,
      new Map<string, any>(),
      (success: boolean) => {
        if (success) {
          resolve();
        } else {
          reject(new Error());
        }
      },
    );
  });
  // #endif

  // #ifdef APP-HARMONY
  const context = UTSHarmony.getUIAbilityContext();
  const want: Want = {
    action: "ohos.want.action.viewData",
    entities: ["entity.system.browsable"],
    uri: url,
  };
  return context.startAbility(want);
  // #endif

  // #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
  return Promise.reject(new Error());
  // #endif
}
