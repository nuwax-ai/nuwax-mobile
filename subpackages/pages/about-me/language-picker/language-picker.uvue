<template>
  <view class="info-section" v-if="langList.length > 1" @tap="handleOpen">
    <text class="label">{{ t("Mobile.Profile.language") }}</text>
    <view class="picker-trigger">
      <text class="value text-ellipsis">{{ currentLanguageName }}</text>
      <view class="language-arrow">
        <svg-icon name="icon-a-Chevrondown" size="24" />
      </view>
    </view>
  </view>

  <radio-list-drawer
    :visible="visible"
    :title="t('Mobile.Profile.selectLanguage')"
    :list="languageOptions"
    :current-value="localCurrentLang"
    @onClose="handleClose"
    max-height="40%"
    @onChange="handleLanguageChange"
  />
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { ref, computed } from 'vue';
  import { useI18n, normalizeLang, emptyI18nParams } from "@/utils/i18n";
  import { RadioListItem } from "@/types/interfaces/radio";
  import type { I18nLangDto } from "@/types/interfaces/i18n";
  import RadioListDrawer from "@/components/radio-list-drawer/radio-list-drawer.uvue";

  const { t: tFn, currentLang, langList, setLanguage } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const visible = ref(false);
  const localCurrentLang = ref("");

  const languageOptions = computed((): RadioListItem[] => {
    const list = langList.value;
    const result: RadioListItem[] = [];
    if (list == null) {
      return result;
    }
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      if (item == null) {
        continue;
      }
      const name = item.name != null ? item.name : "";
      const lang = item.lang != null ? item.lang : "";
      result.push(
        new RadioListItem(name, normalizeLang(lang), "", "", item.status == 0),
      );
    }
    return result;
  });

  const currentLanguageName = computed((): string => {
    const normCurrent = normalizeLang(currentLang.value);
    const list = langList.value;
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      if (normalizeLang(item.lang) == normCurrent) {
        if (item.name.length > 0) {
          return item.name;
        }
        return item.lang;
      }
    }
    return t("Mobile.Profile.languagePlaceholder");
  });

  const handleOpen = () => {
    const list = langList.value;
    let defaultItem: I18nLangDto | null = null;
    for (let i = 0; i < list.length; i++) {
      if (list[i].isDefault == 1) {
        defaultItem = list[i];
        break;
      }
    }
    if (defaultItem != null) {
      const di = defaultItem as I18nLangDto;
      localCurrentLang.value = normalizeLang(di.lang);
    } else {
      localCurrentLang.value = normalizeLang(currentLang.value);
    }
    visible.value = true;
  };

  const handleClose = () => {
    visible.value = false;
  };

  const handleLanguageChange = async (targetLang: string) => {
    if (targetLang.length == 0 || targetLang == currentLang.value) return;

    uni.showLoading({
      title: t("Mobile.Common.switching"),
    });
    try {
      const ok = await setLanguage(targetLang);
      if (!ok) {
        uni.showToast({
          title: t("Mobile.Common.switchFailed"),
          icon: "none",
        });
        return;
      }

      uni.showToast({
        title: t("Mobile.Common.switchSuccess"),
        icon: "success",
      });

      // 成功切换后刷新页面，确保全局语言包生效
      setTimeout(() => {
        // #ifdef H5
        // 必须跳转到首页（TabBar 页面）再刷新，不能在 about-me（非 TabBar 页面）直接 reload。
        // 否则 App 重新初始化时 applyTabBarI18n 调用 uni.setTabBarItem 会报错 "not TabBar page"，
        // 导致导航栏文字无法更新，用户返回首页后依然看到中文 TabBar。
        window.location.replace("/");
        // #endif
        // #ifndef H5
        uni.reLaunch({
          url: "/pages/index/index",
        });
        // #endif
      }, 500);
    } finally {
      uni.hideLoading();
      visible.value = false;
    }
  };
</script>

<style lang="scss" scoped>
  /* vapor: SCSS 反嵌套为顶层单类；.language-arrow 内的 .iconfont 无对应元素（模板用 <svg-icon>），删除 */
  .info-section {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 28rpx 32rpx;
    border-bottom: 2rpx solid #f5f5f5;
  }

  .label {
    font-size: 30rpx;
    font-weight: 500;
    color: #1a1a1a;
  }

  .info-section:active {
    background-color: #f5f5f5;
  }

  .value {
    flex: 1;
    text-align: right;
    margin-left: 24rpx;
    font-size: 24rpx;
    color: #999999;
  }

  .picker-trigger {
    max-width: 260rpx;
    margin-left: auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
  }

  .language-arrow {
    display: flex;
    align-items: center;
    margin-left: 8rpx;
  }
</style>
