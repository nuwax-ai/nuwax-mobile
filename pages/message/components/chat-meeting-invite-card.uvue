<template>
  <view class="chat-meeting-invite">
    <text v-if="from.length > 0" class="chat-meeting-invite__from">{{ from }}</text>
    <text class="chat-meeting-invite__title">{{ title.length > 0 ? title : t("Mobile.Meeting.infoTitle") }}</text>
    <view class="chat-meeting-invite__row">
      <text class="chat-meeting-invite__label">{{ t("Mobile.Meeting.roomNoLabel") }}</text>
      <text class="chat-meeting-invite__value">{{ roomDisplay }}</text>
    </view>
    <view v-if="passcode.length > 0" class="chat-meeting-invite__row">
      <text class="chat-meeting-invite__label">{{ t("Mobile.Meeting.passcodeLabel") }}</text>
      <text class="chat-meeting-invite__value">{{ passcode }}</text>
    </view>
    <view
      class="chat-meeting-invite__join"
      :class="inactive ? 'chat-meeting-invite__join--inactive' : ''"
      @click.stop="handleJoin"
    >
      <text class="chat-meeting-invite__join-text" :class="inactive ? 'chat-meeting-invite__join-text--inactive' : ''">
        {{ status == 2 ? t("Mobile.Meeting.ended") : status == 3 ? t("Mobile.Meeting.roomCancelled") : t("Mobile.Meeting.join") }}
      </text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { onMounted, ref } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiImMeetingPublicRoomSafe } from "@/servers/imMeeting";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const props = defineProps<{
    from: string;
    title: string;
    room: string;
    roomDisplay: string;
    passcode: string;
  }>();
  const emit = defineEmits<{ (e: "join"): void }>();
  const status = ref<number>(-1);
  const inactive = ref<boolean>(false);
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  function readStatus(data: UTSJSONObject): number {
    const raw = data["status"];
    if (raw == null) return -1;
    if (typeof raw == "number") return raw as number;
    const parsed = parseInt(`${raw}`, 10);
    return isNaN(parsed) ? -1 : parsed;
  }

  async function loadRoomStatus(): Promise<void> {
    try {
      const res = await apiImMeetingPublicRoomSafe(props.room);
      if (apiResCode(res) != SUCCESS_CODE) return;
      const raw = apiResData<any>(res);
      if (raw == null) return;
      const nextStatus = readStatus(raw as UTSJSONObject);
      if (nextStatus == 2 || nextStatus == 3) {
        status.value = nextStatus;
        inactive.value = true;
      }
    } catch (_e) {
      // 查询失败不推断会议已结束，保留可加入状态，与 PC 卡片一致。
    }
  }

  function handleJoin(): void {
    if (inactive.value) return;
    emit("join");
  }

  onMounted((): void => {
    loadRoomStatus();
  });
</script>

<style lang="scss" scoped>
  .chat-meeting-invite {
    min-width: 190px;
    display: flex;
    flex-direction: column;
  }

  .chat-meeting-invite__from {
    margin-bottom: 2px;
    font-size: 12px;
    line-height: 17px;
    color: #8a8f99;
  }

  .chat-meeting-invite__title {
    font-size: 16px;
    line-height: 23px;
    font-weight: 600;
    color: #22212a;
  }

  .chat-meeting-invite__row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
  }

  .chat-meeting-invite__label {
    width: 62px;
    flex-shrink: 0;
    font-size: 12px;
    line-height: 18px;
    color: #8f8f99;
  }

  .chat-meeting-invite__value {
    flex: 1;
    min-width: 0;
    font-size: 13px;
    line-height: 18px;
    color: #22212a;
  }

  .chat-meeting-invite__join {
    height: 36px;
    margin-top: 14px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #111111;
  }

  .chat-meeting-invite__join--inactive {
    background-color: #f1f1f3;
  }

  .chat-meeting-invite__join-text {
    font-size: 14px;
    line-height: 20px;
    color: #ffffff;
  }

  .chat-meeting-invite__join-text--inactive {
    color: #8f8f99;
  }
</style>
