<template>
  <view class="container relative flex flex-col">
    <!-- 顶部导航栏（右侧应用内消息入口 + 未读角标） -->
    <custom-nav-bar :title="t('Mobile.Nav.terminal')" className="border-b" hasSafetyZone>
      <template #right>
        <view class="msg-entry" hover-class="msg-entry-active" @tap="handleOpenMessages">
          <text class="msg-entry-icon">🔔</text>
          <view v-if="unreadCount > 0" class="msg-badge">
            <text class="msg-badge-text">{{ unreadCount > 99 ? '99+' : unreadCount.toString() }}</text>
          </view>
        </view>
      </template>
    </custom-nav-bar>

    <scroll-view class="flex-1" direction="vertical" :show-scrollbar="false">
      <!-- 设备列表 -->
      <view class="card-group">
        <view
          v-for="device in deviceList"
          :key="device.deviceId"
          class="row-item"
          hover-class="row-item-active"
          @click="handleDeviceClick(device)"
        >
          <view class="row-avatar">
            <text class="row-avatar-emoji">{{ device.icon }}</text>
          </view>
          <view class="row-info">
            <text class="row-title">{{ device.name }}</text>
            <text class="row-desc">{{ device.desc }}</text>
          </view>
          <view class="row-status">
            <view :class="['status-dot', device.connected ? '' : 'status-dot-off']"></view>
            <text :class="['status-text', device.connected ? '' : 'status-text-off']">
              {{ device.connected ? t("Mobile.Terminal.connected") : t("Mobile.Terminal.disconnected") }}
            </text>
          </view>
          <!-- 离线设备：重新配网快捷入口 -->
          <view v-if="!device.connected" class="reprovision-btn" @tap.stop="handleReprovision(device)">
            <text class="reprovision-btn-text">{{ t("Mobile.Terminal.reprovision") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>

        <!-- 已登录但无绑定设备 -->
        <view v-if="!deviceLoading && deviceList.length == 0 && isLoggedIn" class="empty-box">
          <text class="empty-text">{{ t("Mobile.Terminal.noDevices") }}</text>
        </view>
        <!-- 未登录引导 -->
        <view v-if="!deviceLoading && !isLoggedIn" class="empty-box" hover-class="row-item-active" @click="handleLogin">
          <text class="empty-text empty-text-link">{{ t("Mobile.Terminal.loginTip") }}</text>
        </view>
      </view>

      <!-- 我的电脑（静态，后端暂无对应接口） -->
      <view class="card-group">
        <view class="row-item" hover-class="row-item-active" @click="handleComputerClick">
          <view class="row-avatar">
            <text class="row-avatar-emoji">💻</text>
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Terminal.computerDeviceName") }}</text>
            <text class="row-desc">{{ t("Mobile.Terminal.computerTerminal") }}</text>
          </view>
          <view class="row-status">
            <view class="status-dot"></view>
            <text class="status-text">{{ t("Mobile.Terminal.connected") }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
      </view>

      <!-- 添加搭子灵珠 -->
      <view class="add-card" hover-class="add-card-active" @click="handleAddDevice">
        <view class="add-icon">
          <text class="add-icon-plus">+</text>
        </view>
        <view class="add-info">
          <text class="add-title">{{ t("Mobile.Terminal.addDevice") }}</text>
          <text class="add-desc">{{ t("Mobile.Terminal.addDeviceDesc") }}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>

      <!-- 产品购买卡 -->
      <view class="product-card">
        <view class="product-icon">
          <text class="product-icon-emoji">🔮</text>
        </view>
        <text class="product-name">{{ t("Mobile.Terminal.productName") }}</text>
        <text class="product-sub">{{ t("Mobile.Terminal.productSub") }}</text>
        <text class="product-price">¥299</text>

        <view class="product-features">
          <view class="feature-item" v-for="(feature, index) in productFeatures" :key="index">
            <view class="feature-icon">
              <text class="feature-check">✓</text>
            </view>
            <text class="feature-text">{{ feature }}</text>
          </view>
        </view>

        <view class="buy-btn" hover-class="buy-btn-active" @click="handleBuy">
          <text class="buy-btn-text">{{ t("Mobile.Terminal.buyNow") }}</text>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <desk-buddy-order-modal ref="orderFormModalRef" />
  </view>
</template>

<script setup lang="uts">
  // 合并双方改动：设备列表/消息鉴权（HEAD）+ 订单弹窗（feat-app-zhuoda）
  import { ref, type ComponentPublicInstance } from "vue";
  import { onLoad, onShow } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiVoxDeviceList } from "@/servers/vox/voxDevice";
  import { apiVoxUnreadCount } from "@/servers/vox/voxMessage";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import { SUCCESS_CODE, USER_NO_LOGIN, REDIRECT_LOGIN } from "@/constants/codes.constants";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import DeskBuddyOrderModal from "./components/desk-buddy-order-modal.uvue";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const { hasToken, checkAuthAndShowPopup } = useAuthInterceptor();

  // 终端设备（来自网关绑定列表）
  class TerminalDevice {
    deviceId: string = "";
    name: string = "";
    desc: string = "";
    icon: string = "";
    connected: boolean = false;
    constructor(deviceId: string, name: string, desc: string, icon: string, connected: boolean) {
      this.deviceId = deviceId;
      this.name = name;
      this.desc = desc;
      this.icon = icon;
      this.connected = connected;
    }
  }

  const deviceList = ref<TerminalDevice[]>([]);
  const deviceLoading = ref<boolean>(true);
  const isLoggedIn = ref<boolean>(true);
  const unreadCount = ref<number>(0);

  // 产品特性（静态假数据）
  const productFeatures = ref<string[]>([
    "五色石设计 · 桌面玩偶形态",
    "语音唤醒 · 调度全部智能体",
    "2.8英寸表情屏幕 · 20+动态表情",
    "蓝牙/WiFi双模 · 48h续航",
  ]);

  const fetchDeviceList = async () => {
    if (!(await hasToken())) {
      isLoggedIn.value = false;
      deviceLoading.value = false;
      deviceList.value = [];
      return;
    }
    isLoggedIn.value = true;
    deviceLoading.value = true;
    try {
      const res = await apiVoxDeviceList();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        const list: TerminalDevice[] = [];
        for (let i = 0; i < arr.length; i++) {
          const item = arr[i];
          const deviceIdVal = item["deviceId"];
          const nameVal = item["displayName"];
          const onlineVal = item["online"];
          list.push(new TerminalDevice(
            deviceIdVal != null ? `${deviceIdVal}` : "",
            nameVal != null ? `${nameVal}` : "",
            t("Mobile.Terminal.lingzhuTerminal"),
            "🔮",
            onlineVal != null ? (onlineVal as boolean) : false,
          ));
        }
        deviceList.value = list;
      } else if (apiResCode(res) != USER_NO_LOGIN && apiResCode(res) != REDIRECT_LOGIN) {
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.fetchDevicesFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchDeviceList error", e);
    } finally {
      deviceLoading.value = false;
    }
  };

  const fetchUnreadCount = async () => {
    if (!(await hasToken())) {
      unreadCount.value = 0;
      return;
    }
    try {
      const res = await apiVoxUnreadCount();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const obj = raw != null ? (raw as UTSJSONObject) : null;
        const countVal = obj != null ? obj["unreadCount"] : null;
        unreadCount.value = countVal != null ? (countVal as number) : 0;
      }
    } catch (e) {
      console.error("fetchUnreadCount error", e);
    }
  };

  // 点击设备，进入设备详情
  const handleDeviceClick = (device: TerminalDevice) => {
    uni.navigateTo({
      url: `/subpackages/pages/terminal/terminal-device-detail?deviceId=${encodeURIComponent(device.deviceId)}&name=${encodeURIComponent(device.name)}`,
    });
  };

  // 我的电脑（静态，无后端接口）
  const handleComputerClick = () => {
    uni.navigateTo({
      url: "/subpackages/pages/terminal/terminal-device-detail?deviceType=computer",
    });
  };

  // 添加搭子灵珠，跳配网入口页（扫码/手动蓝牙并列）
  const handleAddDevice = async () => {
    const authed = await checkAuthAndShowPopup();
    if (!authed) return;
    uni.navigateTo({
      url: "/subpackages/pages/provision/provision-entry/provision-entry",
    });
  };

  // 离线设备：重新配网（换 WiFi）
  const handleReprovision = async (device: TerminalDevice) => {
    const authed = await checkAuthAndShowPopup();
    if (!authed) return;
    uni.navigateTo({
      url: `/subpackages/pages/provision/provision-entry/provision-entry?deviceId=${encodeURIComponent(device.deviceId)}&name=${encodeURIComponent(device.name)}`,
    });
  };

  const handleOpenMessages = async () => {
    const authed = await checkAuthAndShowPopup();
    if (!authed) return;
    uni.navigateTo({
      url: "/subpackages/pages/terminal/terminal-messages",
    });
  };

  const handleLogin = async () => {
    await checkAuthAndShowPopup();
  };

  // 订单弹窗 ref：立即购买时调用子组件 open
  const orderFormModalRef = ref<any | null>(null);

  /**
   * 通过 $callMethod 调用订单弹窗暴露的方法（如 open）
   * @param methodName 子组件方法名
   */
  const callOrderFormMethod = (methodName: string): void => {
    const modal = orderFormModalRef.value;
    if (modal == null) return;
    (modal as ComponentPublicInstance).$callMethod(methodName);
  };

  // 立即购买：打开桌面搭子订单弹窗
  const handleBuy = () => {
    callOrderFormMethod("open");
  };

  onLoad((options: any) => {
    setCurrentPageNavigationBarTitle();
  });

  onShow(() => {
    fetchDeviceList();
    fetchUnreadCount();
  });
</script>

