// 定义简化的 MarkdownToken 类型，不依赖 kux-marked
export interface MarkdownToken {
  type: string;
  raw?: string;
  text?: string | null;
  href?: string | null;
  title?: string | null;
  depth?: number;
  lang?: string | null;
  tokens?: MarkdownToken[] | null;
  ordered?: boolean;
  start?: number | null;
  loose?: boolean;
  items?: MarkdownToken[];
  task?: boolean;
  checked?: boolean | null;
  codeBlockStyle?: string | null;
  escaped?: boolean;
}

export interface LLMModel {
  name: string;
  thinking?: boolean;
  webSearch?: boolean;
}

export interface Provider {
  models: LLMModel[];
  description?: string;
  baseURL?: string;
  getToken: any;
}

export interface DefaultLLM {
  provider: string;
  model: string;
}

export interface BailianTokenInfo {
  token: string;
  expireTime: number;
}

export interface Llm {
  provider: string;
  model: string;
  webSearch: boolean;
}

export interface Chat {
  datas: ChatItem[];
  activeId: string;
}

export interface ChatItem {
  id: string;
  title: string;
  state: string;
  inputContent: string;
  msgList: MsgItem[];
  update_time: number;
}

interface ChunkChoiceDelta {
  content: string;
  reasoning_content?: string;
}

interface ChunkMessage {
  content: string;
}

interface ChunkChoice {
  delta?: ChunkChoiceDelta;
  message?: ChunkMessage;
}

interface Output {
  text: string;
}

export interface Chunk {
  choices?: ChunkChoice[];
  output?: Output;
  DONE?: boolean;
}

export interface markdownElItem {
  uniqueId: string;
  type: string;
  datasList: MarkdownToken[][];
}

export interface MsgItem {
  _id: string;
  body: string;
  thinkContent?: string;
  from_uid: string;
  state: number;
  create_time: number;
  about_msg_id?: string;
  chat_id: string;
  markdownElList: markdownElItem[];
  error_msg?: string;
  rendered: boolean;
  processingList?: any[];
}

export interface BaseMsgItem {
  body: string;
  from_uid: string;
  about_msg_id?: string;
}

export interface Msg {
  dataList: MsgItem[];
  hasMore: boolean;
  loading: boolean;
  loadMore: any;
}

export interface RequestAiCoMessage {
  role: "user" | "assistant";
  content: string;
}

export interface Userinfo {
  _id?: string;
  nickname?: string;
  avatar_file?: AvatarFile;
}

export interface AvatarFile {
  url?: string;
  file_id?: string;
}

export type Theme = "auto" | "dark" | "light";

export interface Setting {
  theme: Theme;
  language: "zh-CN" | "en-US";
}
