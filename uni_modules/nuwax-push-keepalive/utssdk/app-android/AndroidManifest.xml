<?xml version="1.0" encoding="utf-8"?>
<!--
  推送保活锚点：与个推的 UniPushService 同进程（:pushservice）。
  进程被三星 remove-task 策略 kill 后，AMS 因 START_STICKY 重新拉起该进程，
  锚点服务在 onCreate 里把 UniPushService 重新 start 起来，个推自己重连。

  ★不要加 android:foregroundServiceType / android:persistent：
    - 该服务不调用 startForeground，产品上不挂常驻通知；
    - persistent 只对系统签名应用有效，第三方声明会被忽略。
  ★android:stopWithTask 保持默认（false）即可。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="uts.sdk.modules.nuwaxPushKeepalive">
  <application>
    <service
      android:name="com.nuwax.pushkeepalive.PushKeepAliveService"
      android:exported="false"
      android:process=":pushservice" />
  </application>
</manifest>
