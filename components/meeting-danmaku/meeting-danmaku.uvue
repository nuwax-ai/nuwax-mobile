<template>
  <!--
    会中弹幕飘屏层（零 props，自驱）。

    ★为什么不用 CSS `@keyframes`：uvue App 端动画支持有限（同 voice-wave-bars 的结论），
      keyframes 不跑时元素会永远停在起点（left:100%），表现就是「弹幕完全不出现」。
      这里用 40ms 定时器算百分比位移，三端一致。
    ★逐帧只改本组件内部的 ref：会议页只负责 push 队列，不参与重渲。
  -->
  <view class="md-layer">
    <view
      v-for="item in items"
      :key="item.id"
      class="md-item"
      :style="'top:' + item.top + 'px;left:' + item.left"
    >
      <text v-if="item.name.length > 0" class="md-name" :lines="1">{{ item.name }}</text>
      <text class="md-text" :lines="1">{{ item.text }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { onMounted, onUnmounted, ref } from "vue";
  import { drainMeetingDanmaku, MeetingDanmakuMessage } from "@/utils/meeting/meetingDanmaku";

  /** 单条弹幕的渲染态（位置按百分比维护，不依赖元素宽度）。 */
  class DanmakuRenderItem {
    id: string = "";
    name: string = "";
    text: string = "";
    top: number = 0;
    /** 起始时间（ms）：位移进度由 `now - startAt` 推出来，掉帧也不会累计漂移。 */
    startAt: number = 0;
    duration: number = 8000;
    /** 左边界：100% → -100%。 */
    left: string = "100%";
  }

  const items = ref<DanmakuRenderItem[]>([]);
  /** 同时最多几条：多了会互相压字，超出直接丢最旧的。 */
  const MAX_ITEMS = 6;
  /** 从右往左飘完整屏所需时长。 */
  const MOVE_MS = 8000;
  /** 轨道数：4 条，避免同一行上下重叠。 */
  const LANES = 4;

  let timer = -1;
  let seq = 0;

  function pctText(pct: number): string {
    // 保留一位小数即可：40ms 一帧在 8 秒里每帧约 1% 位移，多一位没有视觉收益
    const rounded = Math.round(pct * 10) / 10;
    return `${rounded}%`;
  }

  function tick(): void {
    const now = Date.now();
    const list = items.value;
    const next: DanmakuRenderItem[] = [];
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      const progress = (now - item.startAt) / item.duration;
      if (progress >= 1) {
        continue;
      }
      const left = pctText(100 - progress * 200);
      if (left != item.left) {
        item.left = left;
      }
      next.push(item);
    }
    // 新弹幕：一次取空队列，按到达顺序错开轨道
    const fresh = drainMeetingDanmaku();
    for (let i = 0; i < fresh.length; i++) {
      seq++;
      const source: MeetingDanmakuMessage = fresh[i];
      const item = new DanmakuRenderItem();
      item.id = `dm-${seq}`;
      item.name = source.name;
      item.text = source.text;
      item.top = 8 + (seq % LANES) * 32;
      item.startAt = now;
      item.duration = MOVE_MS;
      item.left = "100%";
      next.push(item);
    }
    while (next.length > MAX_ITEMS) {
      next.shift();
    }
    if (next.length == 0 && list.length == 0) {
      return;
    }
    items.value = next;
  }

  onMounted(() => {
    if (timer != -1) {
      return;
    }
    timer = setInterval(() => { tick(); }, 40);
  });

  onUnmounted(() => {
    if (timer != -1) {
      clearInterval(timer);
      timer = -1;
    }
    items.value = [];
  });
</script>

<style lang="scss" scoped>
  .md-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 56px;
    height: 140px;
    z-index: 4;
    overflow: hidden;
    pointer-events: none;
  }

  .md-item {
    position: absolute;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.42);
  }

  .md-name {
    margin-right: 4px;
    font-size: 13px;
    line-height: 18px;
    color: #9fc7ff;
  }

  .md-text {
    font-size: 13px;
    line-height: 18px;
    color: #ffffff;
  }
</style>
