import type { UniAiMarkdownElItem } from "@/uni_modules/uni-ai-x/types.uts";
import ParseMarkdown from "@/uni_modules/uni-ai-x/sdk/parseMarkdown.uts";
import treeToListSdk from "@/uni_modules/uni-ai-x/sdk/treeToList.uts";
import { MarkdownToken, type ParseMdRes } from "@/uni_modules/uni-cmark/utssdk/interface.uts";
import { initCmark, isCmarkReady, md2json } from "@/uni_modules/uni-cmark";
import { MsgItem } from "@/types/interfaces/ai-msg";
import {
  parseAppMarkdownFallback,
  takeLastMathFlushCount,
  isMathConcluded,
} from "@/subpackages/components/ai-msg/appMarkdownFallback.uts";
import { expandMarkdownImageItems } from "@/subpackages/components/ai-msg/markdownImage.uts";
import { normalizeCjkAutolinks } from "@/subpackages/components/ai-msg/markdownAutolink.uts";
import { listMarkdownCustomProcessTags } from "@/utils/markdownCustomProcess.uts";
import {
  findStableMarkdownCut,
  findUnclosedBlockFormulaStart,
} from "@/utils/markdownStableCut.uts";
import { perfRecordParseDetail, sseStallLog } from "@/utils/perfProbe.uts";

/**
 * 消融开关：增量分段解析（applyAppFallbackIncremental）。
 * 默认 true（开）。Phase 3 消融实验时改 false 对比「全量解析」基线，测完还原。
 * 见 docs/perf-conversation-stream-render.md Phase 3。
 */
const INCREMENTAL_FALLBACK_ENABLED: boolean = true;

/**
 * App fallback 每次冻结扩展对应的字符区间与渲染元素。
 * mixed 流中容器归一化可能改写最近一小段正文；按批记录后只需撤回受影响的尾批，
 * 不必替换整棵 UniAiXMsgRender。
 */
class FallbackStableBatch {
  start: number = 0;
  end: number = 0;
  items: UniAiMarkdownElItem[] = [] as UniAiMarkdownElItem[];
}

/** 给 fallback el 的 uniqueId 加前缀，避免 stable/live 碰撞。 */
function prefixMarkdownElIds(
  list: UniAiMarkdownElItem[],
  prefix: string,
): void {
  for (let i = 0; i < list.length; i++) {
    const id = list[i].uniqueId;
    const base = id != null && `${id}`.length > 0 ? `${id}` : `i${i}`;
    list[i].uniqueId = prefix + base;
  }
}

/** 子串计数（indexOf 累加，空 sub 返回 0）。 */
function countSubstringOf(s: string, sub: string): number {
  if (sub.length == 0) {
    return 0;
  }
  let count = 0;
  let from = 0;
  while (true) {
    const idx = s.indexOf(sub, from);
    if (idx < 0) {
      break;
    }
    count = count + 1;
    from = idx + sub.length;
  }
  return count;
}

/**
 * 流式 live 段收尾归一化：合成关闭未配对的结构标记（``` 代码围栏 /
 * <markdown-custom-process-group> / 块级 $$）+ 末尾空行。
 * 让 parseAppMarkdownFallback 对"半截块"也能产出可见元素——否则 live 段是未闭合结构块时
 * 解析器整段丢弃，渲染元素数 el 不涨（el_stuck 卡顿根因）、新内容类型流式期不渲染。
 * live 元素每帧重解析并替换；真闭合后跨 stable cut 冻结为正式态，故合成关闭只影响临时预览。
 */
function normalizeLiveForParse(live: string): string {
  if (live.length == 0) {
    return live;
  }
  let out = live;
  // 注意：不合成关闭 ``` 代码围栏 / $$ 块级公式——这两类走 proxy-web 截图渲染，
  // 在 live 区提前闭合会每帧重渲（mermaid/公式来回抖动、重复截图）。
  // 让它们保持未闭合 → live 区不渲染 → 等闭合后跨 stable cut 冻结时渲一次（稳定）。
  // 仅闭合未配对 <markdown-custom-process-group>（工具卡是 DOM 组件、重渲廉价，可提前出）
  const gOpen = countSubstringOf(out, "<markdown-custom-process-group");
  const gClose = countSubstringOf(out, "</markdown-custom-process-group>");
  let gi = gClose;
  while (gi < gOpen) {
    out = out + "</markdown-custom-process-group>";
    gi = gi + 1;
  }
  // 末尾空行：强制段落 / 表格收尾（表格需空行终止才出元素）
  out = out + "\n\n";
  return out;
}

/** 解析 html token 中的 markdown-custom-process 标签（引号感知，允许 name 含 >）。 */
function parseCustomProcessList(source: string): any[] {
  const result: any[] = [];
  if (source.indexOf("<markdown-custom-process") < 0) {
    return result;
  }
  const tags = listMarkdownCustomProcessTags(source);
  for (let i = 0; i < tags.length; i++) {
    const tag = tags[i];
    if (tag.executeId.length == 0) {
      continue;
    }
    const item = new UTSJSONObject();
    item["executeId"] = tag.executeId;
    item["type"] = tag.type;
    item["status"] = tag.status;
    item["name"] = tag.name;
    result.push(item);
  }
  return result;
}

/**
 * 递归提取 App 原生 uni-cmark token 树中的工具标签。
 * H5 通常返回顶层 html token，Android/iOS 可能将 HTML 放在 paragraph 子 token。
 */
function collectTokenSource(token: MarkdownToken): string {
  const raw = token.raw != null ? token.raw! : "";
  const text = token.text != null ? token.text! : "";
  const direct = raw.length > 0 ? raw : text;
  if (direct.length > 0) {
    return direct;
  }

  const children =
    token.tokens != null
      ? token.tokens!
      : token.items != null
        ? token.items!
        : [] as MarkdownToken[];
  if (children.length == 0) {
    return "";
  }

  const fragments = [] as string[];
  for (let i = 0; i < children.length; i++) {
    const fragment = collectTokenSource(children[i]);
    if (fragment.length > 0) {
      fragments.push(fragment);
    }
  }
  return fragments.join("\n");
}

/** 递归收集包含指定自定义标签的完整 token 文本。 */
function collectMarkupSource(token: MarkdownToken, marker: string): string {
  const source = collectTokenSource(token);
  return source.indexOf(marker) >= 0 ? source : "";
}

/** 解析 task-result 中的描述与文件名。 */
function parseTaskResultData(source: string): UTSJSONObject | null {
  const taskMatch = source.match(
    /<task-result\b[^>]*>([\s\S]*?)<\/task-result>/i,
  );
  if (taskMatch == null || taskMatch.length < 2 || taskMatch[1] == null) {
    return null;
  }
  const content = taskMatch[1]!;
  const descriptionMatch = content.match(
    /<description\b[^>]*>([\s\S]*?)<\/description>/i,
  );
  const fileMatch = content.match(
    /<file\b[^>]*>([\s\S]*?)<\/file>/i,
  );
  const data = new UTSJSONObject();
  data["description"] =
    descriptionMatch != null &&
    descriptionMatch.length > 1 &&
    descriptionMatch[1] != null
      ? descriptionMatch[1]!.trim()
      : "";
  data["file"] =
    fileMatch != null && fileMatch.length > 1 && fileMatch[1] != null
      ? fileMatch[1]!.trim()
      : "";
  return data;
}

function token2el(token: MarkdownToken): UniAiMarkdownElItem {
  const taskResultSource = collectMarkupSource(token, "<task-result");
  const taskResultData = parseTaskResultData(taskResultSource);
  if (taskResultData != null) {
    return {
      uniqueId: token.uniqueId!,
      type: "task_result",
      datasList: [] as MarkdownToken[][],
      taskResultData,
    };
  }

  const source = collectMarkupSource(token, "<markdown-custom-process");
  const customProcessList = parseCustomProcessList(source);
  if (customProcessList.length > 0) {
    const isGroup =
      source.indexOf("<markdown-custom-process-group") >= 0 ||
      customProcessList.length > 1;
    return {
      uniqueId: token.uniqueId!,
      type: isGroup
        ? "markdown_custom_process_group"
        : "markdown_custom_process",
      datasList: [] as MarkdownToken[][],
      customProcessList: customProcessList,
    };
  }
  return {
    uniqueId: token.uniqueId!,
    type: token.type!,
    datasList: treeToListSdk.markTreeToList(token),
  };
}

/**
 * 历史/SSE 消息 markdown 解析（从 ai-msg.uvue 抽出，避免 UTS 大 setup 编译失败）
 */
export class AiMsgMarkdownParser {
  cmarkParseEnabled: boolean = true;
  private msg: Ref<MsgItem>;
  private streamRevision: Ref<number>;
  private getBodyText: () => string;
  private getIsConversationActive: () => boolean;
  private getIsLastMsg: () => boolean;
  private parseMarkdown: ParseMarkdown | null = null;
  /** 递增后忽略旧 ParseMarkdown 回调，避免增量打字机覆盖 fallback 结果 */
  private parseGeneration: number = 0;
  private cmarkProbeDone: boolean = false;
  private cmarkProbeOk: boolean = true;
  /** H5/小程序：WASM 尚未就绪时只等一次 init，避免探测失败永久关掉 cmark */
  private cmarkInitScheduled: boolean = false;
  private lastFallbackBody: string = "";
  /** 已完成消息的正文快照，用于跳过父级重渲染触发的重复解析。 */
  private lastFinishedBody: string = "";
  /** App 增量 fallback：已冻结正文前缀（与 fallbackStableEls 对应）。 */
  private fallbackStablePrefix: string = "";
  /** App 增量 fallback：已冻结的渲染列表（不再随 SSE 重解析）。 */
  private fallbackStableEls: UniAiMarkdownElItem[] = [] as UniAiMarkdownElItem[];
  /** App 增量 fallback：冻结前缀的批次边界，供 mixed 归一化改写时局部回退。 */
  private fallbackStableBatches: FallbackStableBatch[] = [] as FallbackStableBatch[];
  /** 公式回填批量刷新防抖：攒一批 token 回填后整体刷一次，避免逐条替换 markdownElList
   *  造成高频重渲染、与渲染帧竞争触发 ConcurrentModificationException。 */
  private mathFlushPending: boolean = false;
  private mathFlushGen: number = 0;
  /**
   * 官方 WAIT 语义：增量解析期间渲染列表被截断在「图尚未就绪」的公式前，
   * 待该公式出图（scheduleMathFlush）后重新增量解析，把公式与后续内容一并上屏。
   */
  private pendingMathReveal: boolean = false;
  /** cmark 增量打字机：已冻结前缀的渲染元素（同对象引用复用，使 v-for keyed-diff 跳过稳定项）。
   *  对应 fallback 路径的 fallbackStableEls；纯文本流式把每 tick 的全量 token2el O(n) 降为 O(tail)。 */
  private cmarkStableEls: UniAiMarkdownElItem[] = [] as UniAiMarkdownElItem[];
  /** cmark 冻结前缀已覆盖的 token 数（cmarkStableEls 是 image 展开后的元素，二者非 1:1）。 */
  private cmarkStableTokenCount: number = 0;
  /** cmark 空转短路指纹：上次 apply 的 (token 长度 + 末 token uniqueId|text)。
   *  打字机 !isParseDone 时每 40ms 自 tick，无新内容也整树重渲；指纹未变则跳过 apply/bumpRevision。 */
  private cmarkLastAppliedFp: string = "";

  constructor(
    msg: Ref<MsgItem>,
    streamRevision: Ref<number>,
    getBodyText: () => string,
    getIsConversationActive: () => boolean,
    getIsLastMsg: () => boolean,
  ) {
    this.msg = msg;
    this.streamRevision = streamRevision;
    this.getBodyText = getBodyText;
    this.getIsConversationActive = getIsConversationActive;
    this.getIsLastMsg = getIsLastMsg;
  }

  resolveRenderList(): UniAiMarkdownElItem[] {
    const parsed = this.msg.value.markdownElList;
    if (parsed != null && parsed.length > 0) {
      return parsed;
    }
    return [] as UniAiMarkdownElItem[];
  }

  /** 当前可见列表中已越过 fallback 稳定切点的元素数；公式展示层据此冻结不可变前缀。 */
  resolveStableRenderCount(): number {
    const renderedCount = this.msg.value.markdownElList.length;
    const stableCount = this.fallbackStableEls.length;
    return stableCount < renderedCount ? stableCount : renderedCount;
  }

  resetForNewMessage(): void {
    this.abortIncrementalParse();
    this.cmarkParseEnabled = true;
    this.cmarkProbeDone = false;
    this.cmarkProbeOk = true;
    this.clearFallbackIncrementalState();
    // 作废任何在途的批量刷新，避免新消息被旧回调刷到半截
    this.mathFlushGen = this.mathFlushGen + 1;
    this.mathFlushPending = false;
    this.parseMarkdown = this.createParseMarkdown();
    // 虚拟列表回收后重新绑定历史消息时，保留已经完成的权威解析结果。
    // 否则长消息（尤其含公式）每次重新进入窗口都会全量解析并重建渲染节点。
    const body = this.getBodyText();
    const isStreamingLast =
      this.getIsConversationActive() == true && this.getIsLastMsg() == true;
    if (
      body.length > 0 &&
      isStreamingLast != true &&
      this.msg.value.rendered == true &&
      this.msg.value.markdownElList.length > 0
    ) {
      this.lastFinishedBody = body;
      this.lastFallbackBody = body;
    } else {
      this.lastFallbackBody = "";
      this.lastFinishedBody = "";
    }
  }

  /**
   * Android 纯文本快速通道启用时暂停 cmark 打字机。
   * 权威正文仍在外层累计；退出快速通道或终态定稿时 runMarkdownParse 会按需重建解析器。
   */
  suspendForPlainStream(): void {
    this.abortIncrementalParse();
    this.parseMarkdown = null;
    this.msg.value.rendered = false;
    this.lastFinishedBody = "";
  }

  /** 终态 Markdown 是否已与给定权威正文完全对齐。 */
  isFinishedBodyRendered(body: string): boolean {
    return (
      body.length > 0 &&
      this.lastFinishedBody == body &&
      this.msg.value.rendered == true &&
      this.msg.value.markdownElList.length > 0
    );
  }

  /**
   * 表格/code/Mermaid 轻量叶子结束时复用流式期冻结前缀，只补最终 live 尾段。
   * 仅在确实没有可复用前缀时回到完整定稿；公式/工具等仍走原链路。
   */
  finalizeStructuralStream(): void {
    const body = this.getBodyText();
    if (
      body.length > 0 &&
      this.fallbackStablePrefix.length > 0 &&
      body.startsWith(this.fallbackStablePrefix)
    ) {
      this.applyAppFallbackIncremental(body);
      return;
    }
    this.runMarkdownParse(true);
  }

  /** 清空 App 增量 fallback 冻结区（顺带清空 cmark 冻结前缀，二者同为增量态）。 */
  private clearFallbackIncrementalState(): void {
    this.fallbackStablePrefix = "";
    this.fallbackStableEls = [] as UniAiMarkdownElItem[];
    this.fallbackStableBatches = [] as FallbackStableBatch[];
    this.pendingMathReveal = false;
    this.cmarkStableEls = [] as UniAiMarkdownElItem[];
    this.cmarkStableTokenCount = 0;
    this.cmarkLastAppliedFp = "";
  }

  /**
   * 中止 uni-cmark 增量打字机。
   * 正文一旦出现 :::container / 工具标签会切到 App fallback；
   * 若不中止，旧 runTask 的延迟回调会用半截正文覆盖已渲染列表（H5 表现为卡在「好的…7月30」）。
   */
  private abortIncrementalParse(): void {
    this.parseGeneration = this.parseGeneration + 1;
    const pm = this.parseMarkdown;
    if (pm != null) {
      pm.abort();
    }
    // 打字机已中止，其冻结前缀缓存随之失效；清空避免残留覆盖下一次渲染
    this.cmarkStableEls = [] as UniAiMarkdownElItem[];
    this.cmarkStableTokenCount = 0;
    this.cmarkLastAppliedFp = "";
  }

  private bumpRevision(): void {
    this.streamRevision.value = this.streamRevision.value + 1;
  }

  /** 正文是否包含需由 App fallback 识别的自定义标签（cmark 无法可靠产出）。 */
  private hasCustomMarkup(body: string): boolean {
    return (
      body.indexOf("markdown-custom-process") >= 0 ||
      body.indexOf(":::container") >= 0 ||
      body.indexOf("<task-result") >= 0 ||
      body.indexOf("<conversation") >= 0
    );
  }

  /**
   * App：结构块优先走 fallback（与 code 对齐）。
   * 判定尽量收窄，避免普通正文里的单个 `|` / `$100` 误触发：
   * - code：```
   * - 图片：![
   * - 块级公式：$$ / \[ / \(
   * - 表格：同时出现 | 与对齐分隔（---|:-- 等）
   * - 反引号内常见 LaTeX（\frac 等）：须 promote 后走 KaTeX
   */
  private prefersAppStructuralFallback(body: string): boolean {
    if (body.indexOf("```") >= 0) {
      return true;
    }
    if (body.indexOf("![") >= 0) {
      return true;
    }
    if (body.indexOf("$$") >= 0) {
      return true;
    }
    if (body.indexOf("\\[") >= 0 || body.indexOf("\\(") >= 0) {
      return true;
    }
    // 表格：需要管道 + 分隔行特征，避免「A | B」普通句子误入
    if (body.indexOf("|") >= 0) {
      if (
        body.indexOf("---") >= 0 ||
        body.indexOf(":--") >= 0 ||
        body.indexOf("--:") >= 0 ||
        body.indexOf(":-:") >= 0
      ) {
        return true;
      }
    }
    // 反引号内的常见 LaTeX：须走 fallback（promoteLatexInlineCode → KaTeX），
    // 否则 H5 cmark 会当行内 code 灰底展示裸 \frac
    if (body.indexOf("`") >= 0 && body.indexOf("\\") >= 0) {
      if (
        body.indexOf("\\frac") >= 0 ||
        body.indexOf("\\sqrt") >= 0 ||
        body.indexOf("\\sum") >= 0 ||
        body.indexOf("\\int") >= 0 ||
        body.indexOf("\\lim") >= 0 ||
        body.indexOf("\\begin") >= 0 ||
        body.indexOf("\\partial") >= 0 ||
        body.indexOf("\\sin") >= 0 ||
        body.indexOf("\\cos") >= 0 ||
        body.indexOf("\\mathbf") >= 0 ||
        body.indexOf("\\pi") >= 0
      ) {
        return true;
      }
    }
    return false;
  }

  /** 当前渲染列表是否已包含自定义组件元素。 */
  private renderListHasCustomEl(): boolean {
    const list = this.msg.value.markdownElList;
    for (let i = 0; i < list.length; i++) {
      const type = list[i].type;
      if (
        type == "markdown_custom_process" ||
        type == "markdown_custom_process_group" ||
        type == "task_result"
      ) {
        return true;
      }
      const datasList = list[i].datasList;
      for (let rowIndex = 0; rowIndex < datasList.length; rowIndex++) {
        const row = datasList[rowIndex];
        for (let tokenIndex = 0; tokenIndex < row.length; tokenIndex++) {
          if (row[tokenIndex].className == "conversation-link") {
            return true;
          }
        }
      }
    }
    return false;
  }

  /** fallback 结果是否已含结构组件（code/math/table/image）。 */
  private renderListHasStructuralEl(): boolean {
    const list = this.msg.value.markdownElList;
    for (let i = 0; i < list.length; i++) {
      const type = list[i].type;
      if (
        type == "code_block" ||
        type == "math" ||
        type == "table" ||
        type == "markdown_image" ||
        type == "image"
      ) {
        return true;
      }
    }
    return false;
  }

  /**
   * 单个 token 是否需要「等待出图」（官方 WAIT：等公式渲染完再继续渲染后续）。
   * - 已出图（href/html 非空）→ 不等
   * - 已结算（派发过 katexRender 并回调，含失败、结果为空的占位）→ 不等
   * - 其余（在途 dispatch 未回调）→ 等
   * displayMode：块级公式 item.type=="math" 为 true；行内公式一律 false（与 scheduleInlineMathRender 一致）。
   */
  private mathTokenNeedsWait(t: MarkdownToken, displayMode: boolean): boolean {
    if (t.type != "math") {
      // 表格等嵌套 token：递归查内层（表格单元格内的行内公式）
      const child =
        t.tokens != null ? t.tokens : t.items != null ? t.items : null;
      if (child != null) {
        for (let i = 0; i < child.length; i++) {
          if (this.mathTokenNeedsWait(child[i], displayMode)) {
            return true;
          }
        }
      }
      return false;
    }
    const href = t.href != null ? `${t.href}` : "";
    const html = t.html != null ? `${t.html}` : "";
    if (href.length > 0 || html.length > 0) {
      return false;
    }
    const latex = t.text != null ? `${t.text}` : "";
    return isMathConcluded(latex, displayMode) != true;
  }

  /** 渲染列表中第一个「等待出图」的公式所在 item 索引；无则 -1。 */
  private firstPendingMathItemIndex(items: UniAiMarkdownElItem[]): number {
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      const rows = item.datasList;
      if (rows == null) {
        continue;
      }
      const isBlock = item.type == "math";
      for (let r = 0; r < rows.length; r++) {
        const row = rows[r];
        for (let t = 0; t < row.length; t++) {
          if (this.mathTokenNeedsWait(row[t], isBlock)) {
            return i;
          }
        }
      }
    }
    return -1;
  }

  /**
   * 公式回填批量刷新（防抖）：~40ms 内多次 token 回填只整体替换 markdownElList 一次。
   * 含工具卡时拉长到 80ms，降低 ToolCallCard 挂载后列表抖动触发 Android 原生停更的概率。
   * 若增量解析曾因未出图公式截断（pendingMathReveal），则改为重新增量解析，把公式与
   * 后续内容一并上屏（官方 WAIT：等公式渲染完再继续）。
   */
  private scheduleMathFlush(): void {
    if (this.mathFlushPending == true) {
      return;
    }
    this.mathFlushPending = true;
    const gen = this.mathFlushGen;
    const delayMs = this.renderListHasCustomEl() == true ? 80 : 40;
    setTimeout((): void => {
      this.mathFlushPending = false;
      if (gen != this.mathFlushGen) {
        return;
      }
      if (this.pendingMathReveal == true) {
        this.pendingMathReveal = false;
        this.applyAppFallbackIncremental(this.getBodyText());
        return;
      }
      const prev = this.msg.value.markdownElList;
      const next = [] as UniAiMarkdownElItem[];
      for (let i = 0; i < prev.length; i++) {
        next.push(prev[i]);
      }
      this.msg.value.markdownElList = next;
      this.bumpRevision();
      uni.$emit("ai-msg-content-ready", null);
    }, delayMs);
  }

  /**
   * fallback 渲染。
   * - App 流式：稳定前缀冻结 + 只解析尾巴（增量）
   * - App 终态 / H5：全量 parse 一次定稿
   */
  private applyAppFallback(_holdMathUntilDone: boolean = false): void {
    const body = this.getBodyText();
    if (body.length == 0) {
      return;
    }
    const needsCustom = this.hasCustomMarkup(body);
    const needsStructural = this.prefersAppStructuralFallback(body);
    if (
      body == this.lastFallbackBody &&
      this.msg.value.markdownElList.length > 0
    ) {
      const customOk =
        needsCustom != true || this.renderListHasCustomEl() == true;
      const structuralOk =
        needsStructural != true || this.renderListHasStructuralEl() == true;
      if (customOk == true && structuralOk == true) {
        return;
      }
    }
    // 进入 fallback 前必须掐掉 cmark 打字机，否则延迟回调会覆盖本结果
    this.abortIncrementalParse();
    this.parseMarkdown = null;

    const streaming =
      _holdMathUntilDone != true &&
      this.getIsConversationActive() == true &&
      this.getIsLastMsg() == true;

    // #ifdef APP
    if (streaming == true && INCREMENTAL_FALLBACK_ENABLED) {
      this.applyAppFallbackIncremental(body);
      return;
    }
    // #endif

    // #ifdef APP
    try {
      sseStallLog(
        "fallback_full_reason",
        `hold=${_holdMathUntilDone} active=${this.getIsConversationActive()} last=${this.getIsLastMsg()} body=${body.length}`,
      );
    } catch (_eR) {
      // ignore
    }
    // #endif
    this.applyAppFallbackFull(body);
  }

  /** 全量 fallback（终态定稿 / 前缀失效兜底 / 非 App）。 */
  private applyAppFallbackFull(body: string): void {
    this.clearFallbackIncrementalState();
    const onMathNotify = (): void => {
      this.scheduleMathFlush();
    };
    const __parseT0 = Date.now();
    const parsed = expandMarkdownImageItems(
      parseAppMarkdownFallback(body, onMathNotify),
    );
    this.lastFallbackBody = body;
    this.msg.value.markdownElList = parsed;
    try {
      perfRecordParseDetail(
        "full",
        body.length,
        body.length,
        0,
        body.length,
        parsed.length,
        Date.now() - __parseT0,
      );
    } catch (_e) {
      // 埋点失败静默
    }
    this.msg.value.rendered = true;
    this.lastFinishedBody = body;
    this.bumpRevision();
    if (takeLastMathFlushCount() == 0) {
      uni.$emit("ai-msg-content-ready", null);
    }
  }

  /**
   * App 流式增量 fallback：只解析 newlyFrozen + live，前缀 el 冻结复用。
   * body 非纯 append（前缀不匹配）时回退全量。
   */
  private applyAppFallbackIncremental(body: string): void {
    // 容器/工具标签归一化可能在结构闭合时改写最近的稳定尾段。
    // 找共同字符前缀并撤回与改写区相交的完整冻结批；更早的 el 对象继续复用。
    if (
      this.fallbackStablePrefix.length > 0 &&
      !body.startsWith(this.fallbackStablePrefix)
    ) {
      let common = 0;
      const commonLimit = body.length < this.fallbackStablePrefix.length
        ? body.length
        : this.fallbackStablePrefix.length;
      while (
        common < commonLimit &&
        body.charAt(common) == this.fallbackStablePrefix.charAt(common)
      ) {
        common = common + 1;
      }

      const keptBatches = [] as FallbackStableBatch[];
      const keptEls = [] as UniAiMarkdownElItem[];
      let keptEnd = 0;
      for (let b = 0; b < this.fallbackStableBatches.length; b++) {
        const batch = this.fallbackStableBatches[b];
        if (batch.end > common) {
          break;
        }
        keptBatches.push(batch);
        keptEnd = batch.end;
        for (let e = 0; e < batch.items.length; e++) {
          keptEls.push(batch.items[e]);
        }
      }
      this.fallbackStablePrefix = body.substring(0, keptEnd);
      this.fallbackStableEls = keptEls;
      this.fallbackStableBatches = keptBatches;
    }

    let cut = findStableMarkdownCut(body, true);
    // 切点回退（findStableMarkdownCut 对结构块非单调，mixed/工具卡/mermaid 下偶发）：
    // 不退全量（重负载下 full_parse_large 灾难性卡顿），改为钳制到已冻结前缀末尾——
    // append-only 流式下已冻结前缀仍有效，保留 frozen 元素、只重解析 live 尾。
    if (
      this.fallbackStablePrefix.length > 0 &&
      cut < this.fallbackStablePrefix.length
    ) {
      cut = this.fallbackStablePrefix.length;
    }

    const onMathNotify = (): void => {
      this.scheduleMathFlush();
    };
    const __parseT0 = Date.now();
    let parsedChars = 0;

    let stablePrefix = this.fallbackStablePrefix;
    let stableEls = this.fallbackStableEls;
    let stableBatches = this.fallbackStableBatches.slice();

    // 扩展冻结区：只 parse 新增的 newlyFrozen。
    // 已闭合公式在冻结时立刻派发 KaTeX（逐段上屏）；live 仍 defer，避免半截/重解析重复截图。
    if (cut > stablePrefix.length) {
      const batchStart = stablePrefix.length;
      const newlyFrozen = body.substring(batchStart, cut);
      if (newlyFrozen.length > 0) {
        const newEls = expandMarkdownImageItems(
          parseAppMarkdownFallback(newlyFrozen, onMathNotify, false),
        );
        prefixMarkdownElIds(newEls, `f${batchStart}-`);
        const merged = [] as UniAiMarkdownElItem[];
        for (let i = 0; i < stableEls.length; i++) {
          merged.push(stableEls[i]);
        }
        for (let j = 0; j < newEls.length; j++) {
          merged.push(newEls[j]);
        }
        stableEls = merged;
        const batch = new FallbackStableBatch();
        batch.start = batchStart;
        batch.end = cut;
        batch.items = newEls;
        stableBatches.push(batch);
        parsedChars += newlyFrozen.length;
      }
      stablePrefix = body.substring(0, cut);
    }

    // live 区每次重解析（通常很短）。两路保护（合并 perf-vdom 的 el_stuck 修复与官方公式冻结语义）：
    // 1) findUnclosedBlockFormulaStart：live 出现未闭合块级公式（$$ / \[，代码围栏内忽略）时，
    //    只取其前内容 liveToParse 上屏，公式及之后等闭合后下一轮增量解析再连同后续一并上屏
    //    （对齐官方 runTask「整体冻结到闭合」）。
    // 2) normalizeLiveForParse：给 liveToParse 合成关闭未配对的 <markdown-custom-process-group>
    //    + 末尾空行，否则半截工具卡结构块被解析器整段丢弃 → el 不涨（el_stuck 卡顿根因）。
    // KaTeX 在 live 区即派发（defer=false），重复截图由下方 WAIT 截断 + scheduleMathFlush 防抖控制。
    const live = body.substring(stablePrefix.length);
    const unclosedMathAt = findUnclosedBlockFormulaStart(live);
    const liveToParse =
      unclosedMathAt >= 0 ? live.substring(0, unclosedMathAt) : live;
    const liveEls = [] as UniAiMarkdownElItem[];
    if (liveToParse.length > 0) {
      const parsedLive = expandMarkdownImageItems(
        parseAppMarkdownFallback(normalizeLiveForParse(liveToParse), onMathNotify, false),
      );
      prefixMarkdownElIds(parsedLive, "live-");
      for (let k = 0; k < parsedLive.length; k++) {
        liveEls.push(parsedLive[k]);
      }
      parsedChars += liveToParse.length;
    }

    const nextList = [] as UniAiMarkdownElItem[];
    for (let s = 0; s < stableEls.length; s++) {
      nextList.push(stableEls[s]);
    }
    for (let l = 0; l < liveEls.length; l++) {
      nextList.push(liveEls[l]);
    }

    // 官方 WAIT 语义：渲染列表止于第一个「图尚未就绪」的公式（含其后的后续内容），
    // 待公式出图（scheduleMathFlush 重新增量解析）后再把公式与后续一并上屏。
    // 避免「前文已出、公式留白、后文先到」的跳过观感（官方 runTask 未闭合公式 return 冻结、
    // 闭合后窗口阻塞 katexRender 出图才继续，本处等价落地于 fallback 增量）。
    const pendingIdx = this.firstPendingMathItemIndex(nextList);
    this.pendingMathReveal = false;
    let renderedList = nextList;
    if (pendingIdx >= 0) {
      this.pendingMathReveal = true;
      renderedList = [] as UniAiMarkdownElItem[];
      for (let p = 0; p < pendingIdx; p++) {
        renderedList.push(nextList[p]);
      }
    }

    this.fallbackStablePrefix = stablePrefix;
    this.fallbackStableEls = stableEls;
    this.fallbackStableBatches = stableBatches;
    this.lastFallbackBody = body;
    this.msg.value.markdownElList = renderedList;
    try {
      perfRecordParseDetail(
        "inc",
        body.length,
        parsedChars,
        stablePrefix.length,
        live.length,
        nextList.length,
        Date.now() - __parseT0,
      );
    } catch (_e2) {
      // ignore
    }
    this.msg.value.rendered = true;
    this.lastFinishedBody = body;
    this.bumpRevision();
    if (takeLastMathFlushCount() == 0) {
      uni.$emit("ai-msg-content-ready", null);
    }
  }

  /** cmark 回调 token 列表的便宜指纹：长度 + 末 token 的 uniqueId|text。
   *  末 token 是流式 live 边，随正文流入而变；指纹未变即视为本帧无新内容（空转）。 */
  private cmarkTokenFp(tokens: MarkdownToken[]): string {
    const n = tokens.length;
    if (n == 0) {
      return "0";
    }
    const last = tokens[n - 1];
    const lastId = last.uniqueId != null ? `${last.uniqueId}` : "";
    const lastText = last.text != null ? `${last.text}` : "";
    return `${n}|${lastId}|${lastText}`;
  }

  /**
   * cmark 增量路径（stablePrefixLen>0）：复用冻结前缀元素【同一对象引用】，只对 live 尾部做 token2el。
   * 全量路径（stablePrefixLen==0，parseFullBodyMarkdown/兜底）：原逻辑，并清空 cmark 缓存。
   * normalizeCjkAutolinks 逐元素且幂等：前缀只施加一次、尾部每帧施加，等价于原全量施加。
   * 前缀元素引用不变 ⇒ 父级 v-for 按 uniqueId keyed-diff 跳过稳定项 ⇒ 渲染层也降到 O(tail)。
   */
  private applyMarkdownTokenList(
    markdownTokenList: MarkdownToken[],
    stablePrefixLen: number = 0,
  ): void {
    if (markdownTokenList.length == 0) {
      this.cmarkStableTokenCount = 0;
      this.cmarkStableEls = [] as UniAiMarkdownElItem[];
      return;
    }
    let spl = stablePrefixLen;
    if (spl > markdownTokenList.length) {
      spl = markdownTokenList.length;
    }
    if (spl > 0) {
      // 边界回退（append-only 下不应发生）：重建缓存
      if (spl < this.cmarkStableTokenCount) {
        this.cmarkStableTokenCount = 0;
        this.cmarkStableEls = [] as UniAiMarkdownElItem[];
      }
      // 新冻结的 token 一次性转元素并入缓存（image 展开可能 1→多）
      while (this.cmarkStableTokenCount < spl) {
        const frozenToken = markdownTokenList[this.cmarkStableTokenCount];
        const expanded = expandMarkdownImageItems([token2el(frozenToken)]);
        normalizeCjkAutolinks(expanded);
        for (let i = 0; i < expanded.length; i++) {
          this.cmarkStableEls.push(expanded[i]);
        }
        this.cmarkStableTokenCount = this.cmarkStableTokenCount + 1;
      }
      // live 尾部：每帧重转
      const tailTokens = markdownTokenList.slice(spl);
      const tailMapped = tailTokens.map((token: MarkdownToken) =>
        token2el(token),
      );
      normalizeCjkAutolinks(tailMapped);
      const tailEls = expandMarkdownImageItems(tailMapped);
      // 拼接：冻结前缀（同引用）+ 尾部新元素；浅拷贝前缀，避免把尾部污染进缓存
      const next = this.cmarkStableEls.slice();
      for (let i = 0; i < tailEls.length; i++) {
        next.push(tailEls[i]);
      }
      this.msg.value.markdownElList = next;
      return;
    }
    // 全量路径
    this.cmarkStableTokenCount = 0;
    this.cmarkStableEls = [] as UniAiMarkdownElItem[];
    const mapped = markdownTokenList.map((token: MarkdownToken) =>
      token2el(token),
    );
    normalizeCjkAutolinks(mapped);
    this.msg.value.markdownElList = expandMarkdownImageItems(mapped);
  }

  private parseFullBodyMarkdown(body: string): boolean {
    if (body.length == 0) {
      return false;
    }
    try {
      let tokens = [] as MarkdownToken[];
      // #ifdef APP-IOS
      const jsonString = md2json(body) as string;
      if (jsonString.length == 0) {
        return false;
      }
      tokens = JSON.parseArray<MarkdownToken>(jsonString) as MarkdownToken[];
      // #endif
      // #ifndef APP-IOS
      const parseRes = md2json(body) as ParseMdRes;
      if (parseRes.errorMsg.length > 0) {
        return false;
      }
      tokens = parseRes.data;
      // #endif
      if (tokens.length == 0) {
        return false;
      }
      // 全量路径无 ParseMarkdown 增量赋 id，这里补齐，避免渲染 key 为空
      for (let i = 0; i < tokens.length; i++) {
        const id = tokens[i].uniqueId;
        if (id == null || `${id}`.length == 0) {
          tokens[i].uniqueId = "u" + i;
        }
        tokens[i].isClose = 1;
      }
      this.applyMarkdownTokenList(tokens);
      return true;
    } catch (e) {
      return false;
    }
  }

  /**
   * 历史 / 开场白 / 会话已结束：一次出全量，跳过 uni-cmark 逐行 100ms 打字机。
   * SSE 进行中（未 finished）仍走下方 incremental runTask。
   */
  private renderFinishedBodyOnce(body: string): void {
    this.abortIncrementalParse();
    this.parseMarkdown = null;
    if (body.length == 0) {
      return;
    }
    // App：纯文本终态用 cmark 全量一次（比 JS fallback 快、与流式期一致，避免 full_parse_large 收尾卡顿）；
    //   含结构块 / 公式 / $ / 自定义标签的仍走 fallback（结构块更稳）。
    // #ifdef APP
    if (
      this.cmarkParseEnabled == true &&
      this.hasCustomMarkup(body) != true &&
      this.prefersAppStructuralFallback(body) != true &&
      body.indexOf("$") < 0
    ) {
      if (this.ensureCmarkAvailable() == true && this.parseFullBodyMarkdown(body) == true) {
        this.msg.value.rendered = true;
        this.lastFinishedBody = body;
        this.bumpRevision();
        return;
      }
    }
    this.applyAppFallback(true);
    return;
    // #endif
    // #ifndef APP
    // H5：公式/代码/表/图走 fallback；普通正文 cmark 全量一次
    if (this.prefersAppStructuralFallback(body) == true || body.indexOf("$") >= 0) {
      this.applyAppFallback(true);
      return;
    }
    if (
      this.cmarkParseEnabled == true &&
      this.ensureCmarkAvailable() == true &&
      this.parseFullBodyMarkdown(body) == true
    ) {
      this.msg.value.rendered = true;
      this.lastFinishedBody = body;
      this.bumpRevision();
      return;
    }
    this.applyAppFallback(true);
    // #endif
  }

  /**
   * H5/小程序 WASM 未就绪时：先 fallback 出屏，init 完成后再用 cmark 重解析。
   * 不可把「未初始化」当成永久失败，否则整页会话都会锁死在 fallback。
   */
  private scheduleCmarkInitThenParse(): void {
    // #ifdef H5 || WEB || MP-WEIXIN
    if (this.cmarkInitScheduled == true) {
      return;
    }
    this.cmarkInitScheduled = true;
    initCmark()
      .then(() => {
        this.cmarkInitScheduled = false;
        this.cmarkProbeDone = false;
        this.cmarkProbeOk = true;
        this.cmarkParseEnabled = true;
        // 清快照，避免「已 fallback 出屏」被当成终态而跳过 cmark 重解析
        this.lastFinishedBody = "";
        const forceDone =
          !this.getIsConversationActive() ||
          !this.getIsLastMsg() ||
          this.msg.value.state === 3;
        this.runMarkdownParse(forceDone);
      })
      .catch((err) => {
        this.cmarkInitScheduled = false;
        this.cmarkProbeDone = true;
        this.cmarkProbeOk = false;
        this.cmarkParseEnabled = false;
        console.warn("uni-cmark init failed, keep fallback:", err);
      });
    // #endif
  }

  private ensureCmarkAvailable(): boolean {
    if (this.cmarkProbeDone) {
      return this.cmarkProbeOk;
    }
    // #ifdef H5 || WEB || MP-WEIXIN
    if (isCmarkReady() != true) {
      this.scheduleCmarkInitThenParse();
      return false;
    }
    // #endif
    this.cmarkProbeDone = true;
    try {
      // #ifdef APP-IOS
      const jsonString = md2json("#") as string;
      this.cmarkProbeOk = jsonString.length > 0;
      // #endif
      // #ifndef APP-IOS
      const probeRes = md2json("#") as ParseMdRes;
      const errMsg = probeRes.errorMsg;
      if (
        errMsg.length > 0 &&
        (errMsg.indexOf("not initialized") >= 0 ||
          errMsg.indexOf("initCmark") >= 0)
      ) {
        // 竞态：ready 检查与真实调用之间仍可能未就绪
        this.cmarkProbeDone = false;
        this.scheduleCmarkInitThenParse();
        return false;
      }
      this.cmarkProbeOk = errMsg.length == 0;
      // #endif
    } catch (e) {
      const msg = `${e}`;
      if (
        msg.indexOf("not initialized") >= 0 ||
        msg.indexOf("initCmark") >= 0
      ) {
        this.cmarkProbeDone = false;
        this.scheduleCmarkInitThenParse();
        return false;
      }
      this.cmarkProbeOk = false;
    }
    if (!this.cmarkProbeOk) {
      this.cmarkParseEnabled = false;
    }
    return this.cmarkProbeOk;
  }

  private createParseMarkdown(): ParseMarkdown {
    const gen = this.parseGeneration;
    return new ParseMarkdown((markdownTokenList: MarkdownToken[], isParseDone: boolean) => {
      // 已切换到 fallback / 新消息：忽略过期打字机回调
      if (gen != this.parseGeneration) {
        return;
      }
      // 冻结前缀长度由 parseMarkdown.runTask 计算并存于实例字段（避免改 callback 签名牵连 worker）。
      const pm0 = this.parseMarkdown;
      const spl = pm0 != null ? pm0.lastStablePrefixLen : 0;
      // 空转短路：流式期(!isParseDone)打字机每 40ms 自 tick；token 指纹未变(无新内容)则
      // 跳过 apply + bumpRevision，避免每 40ms 整树 v-for 重渲（renderMarkdownElList 依赖 streamRevision）。
      if (isParseDone != true) {
        const fp = this.cmarkTokenFp(markdownTokenList);
        if (fp == this.cmarkLastAppliedFp) {
          return;
        }
        this.cmarkLastAppliedFp = fp;
      }
      this.applyMarkdownTokenList(markdownTokenList, spl);
      if (isParseDone) {
        this.msg.value.rendered = true;
        const body = this.getBodyText();
        this.lastFinishedBody = body;
        if (markdownTokenList.length == 0 && body.trim().length > 0) {
          if (!this.parseFullBodyMarkdown(body)) {
            this.cmarkParseEnabled = false;
            this.applyAppFallback(true);
          }
        }
      }
      this.bumpRevision();
    });
  }

  runMarkdownParse(forceDone: boolean = false): void {
    const body = this.getBodyText();
    // 注意：勿用 msg.state===Complete 单独判定流结束。
    // SSE 中间态也可能短暂 Complete，会导致 App 增量被关掉、反复 full 全量扫。
    // 整轮结束以 isConversationActive / isLastMsg / forceDone 为准。
    const streamFinished =
      forceDone ||
      !this.getIsConversationActive() ||
      !this.getIsLastMsg();
    const needsCustomFallback = this.hasCustomMarkup(body);

    // 历史/已完成消息：正文未变且已有渲染结果时跳过。
    // 含 Plan/工具标签时，必须已解析出对应 el，否则不能跳过。
    // 注意：勿在 lastFinishedBody 为空时仅凭 rendered 直接 return ——
    // 中间段 CHAT finished 会把 state 置 Complete，此时 token 可能仍是
    // 「未剥离图片语法」的旧结果，跳过会导致原文与 <image> 双显。
    if (
      streamFinished &&
      body.length > 0 &&
      this.msg.value.markdownElList.length > 0
    ) {
      if (needsCustomFallback && !this.renderListHasCustomEl()) {
        // 继续走下方 fallback
      } else if (
        this.lastFinishedBody.length > 0 &&
        body == this.lastFinishedBody
      ) {
        return;
      } else if (
        // 非末条：已有 fallback 结果且正文未变，禁止因父级 prop 抖动再全量扫
        this.getIsLastMsg() != true &&
        this.lastFallbackBody.length > 0 &&
        body == this.lastFallbackBody
      ) {
        return;
      }
    }

    // Plan / ToolCall / task-result：与 dev 的 mp-html 自定义节点等价，须走 App fallback。
    // uni-cmark 不会产出 markdown_custom_process，会把标签泄漏为正文。
    // 一旦出现自定义标记，立即中止 cmark 增量打字机，避免半截正文覆盖 UI。
    if (needsCustomFallback) {
      this.applyAppFallback(streamFinished);
      if (streamFinished) {
        this.lastFinishedBody = body;
      }
      return;
    }

    // App：code / 公式 / 表格 / 图片优先 fallback。
    // 标准基座 uni-cmark 流式常把结构块打成 paragraph；fallback 已支持这些类型。
    // 判定收窄（见 prefersAppStructuralFallback），避免普通 `|` / `$100` 误伤。
    // #ifdef APP
    if (this.prefersAppStructuralFallback(body) == true) {
      this.applyAppFallback(streamFinished);
      if (streamFinished) {
        this.lastFinishedBody = body;
      }
      return;
    }
    // #endif

    // 历史首屏 / 上拉历史 / 开场白 / 会话已结束：直接全量渲染，不要打字机
    if (streamFinished) {
      this.renderFinishedBodyOnce(body);
      return;
    }

    if (!this.cmarkParseEnabled) {
      this.applyAppFallback();
      return;
    }
    if (!this.ensureCmarkAvailable()) {
      this.applyAppFallback();
      return;
    }

    if (this.parseMarkdown == null) {
      this.parseMarkdown = this.createParseMarkdown();
    }
    // strip 掉已闭合图片后正文会变短；官方 ParseMarkdown 对缩短直接 return，
    // 会残留流式阶段写入的 `![alt](url)` 文本 token，必须重建解析器。
    const pm = this.parseMarkdown!;
    if (body.length < pm.oldMsgBodyLength) {
      this.abortIncrementalParse();
      this.parseMarkdown = this.createParseMarkdown();
      this.msg.value.markdownElList = [] as UniAiMarkdownElItem[];
      this.lastFinishedBody = "";
      this.lastFallbackBody = "";
      this.clearFallbackIncrementalState();
    }
    // 仅 SSE 进行中走增量打字机
    this.parseMarkdown!.msgReceiveDone = false;
    if (body.length > 0) {
      this.parseMarkdown!.runTask(body);
    }
  }
}
