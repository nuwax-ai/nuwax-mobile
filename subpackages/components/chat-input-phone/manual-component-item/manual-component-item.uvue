<template>
  <view class="manual-component-item">
    <home-manual-component-bar
      v-if="isHomePageVal"
      :is-task-agent-val="isTaskAgentVal"
      :allow-choose-mode-val="allowChooseModeVal"
      :readonly-val="readonlyVal"
      :current-agent-mode-label="currentAgentModeLabel"
      :is-sandbox-unavailable-val="isSandboxUnavailableVal"
      :current-sandbox-name="currentSandboxName"
      :sandbox-disabled-text-val="sandboxDisabledTextVal"
      :allow-other-model-val="allowOtherModelVal"
      :model-select-label-val="modelSelectLabelVal"
      @onOpenPagePreview="handleOpenPagePreview"
      @onOpenFileTree="handleOpenFileTree"
      @openAgentModeDrawer="openAgentModeDrawer"
      @openSandboxDrawer="openSandboxDrawer"
      @openModelSelect="modelSelectVisible = true"
    />
    <manual-component-bar
      v-else
      :show-page-home-val="showPageHomeVal"
      :show-workspace-val="showWorkspaceVal"
      :is-task-agent-val="isTaskAgentVal"
      :allow-choose-mode-val="allowChooseModeVal"
      :readonly-val="readonlyVal"
      :current-agent-mode-label="currentAgentModeLabel"
      :is-sandbox-unavailable-val="isSandboxUnavailableVal"
      :current-sandbox-name="currentSandboxName"
      :sandbox-disabled-text-val="sandboxDisabledTextVal"
      :allow-other-model-val="allowOtherModelVal"
      :model-select-label-val="modelSelectLabelVal"
      :manual-components-val="manualComponentsVal"
      :selected-components="props.selectedComponents"
      @onOpenPagePreview="handleOpenPagePreview"
      @onOpenFileTree="handleOpenFileTree"
      @openAgentModeDrawer="openAgentModeDrawer"
      @openSandboxDrawer="openSandboxDrawer"
      @openModelSelect="modelSelectVisible = true"
      @handleSelectComponent="handleSelectComponent"
    />

    <!-- 页面预览 -->
    <page-preview-iframe ref="pagePreviewIframeRef" />

    <agent-mode-select-modal
      :visible="agentModeVisible"
      :current-agent-mode="currentAgentMode"
      :readonly="readonlyVal"
      @onClose="handleAgentModeClose"
      @onAgentModeChange="handleAgentModeChangeInside"
    />

    <!-- 沙盒切换弹窗 -->
    <sandbox-select-modal
      :visible="sandboxVisible"
      :sandbox-list="sandboxListVal"
      :current-sandbox-id="currentSandboxIdVal"
      :is-sandbox-switch-disabled="isSandboxSwitchDisabledVal"
      :readonly="readonlyVal"
      @on-close="handleSandboxClose"
      @on-sandbox-change="handleSandboxChangeInside"
    />

    <model-select-modal
      v-if="allowOtherModelVal"
      :visible="modelSelectVisible"
      :agent-id="agentIdVal"
      :agent-type="agentTypeVal"
      :current-model-id="currentModelIdVal"
      :is-temp-chat="isTempChatVal"
      @on-close="modelSelectVisible = false"
      @on-model-sync="handleModelSyncInside"
      @on-model-change="handleModelChangeInside"
    />
  </view>
</template>

<script lang="uts" setup>
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { ref, computed } from 'vue';
  import { AgentManualComponentInfo, AgentSelectedComponentInfo } from "@/types/interfaces/agent";
  import { SandboxInfo } from "@/types/interfaces/sandbox";
  import SandboxSelectModal from "../sandbox-select-modal/sandbox-select-modal.uvue";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import ModelSelectModal from "../model-select-modal/model-select-modal.uvue";
  import AgentModeSelectModal from "../agent-mode-select-modal/agent-mode-select-modal.uvue";
  import ManualComponentBar from "./components/manual-component-bar/manual-component-bar.uvue";
  import HomeManualComponentBar from "./components/home-manual-component-bar/home-manual-component-bar.uvue";
  type AgentMode = "ask" | "yolo";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      manualComponents: AgentManualComponentInfo[];
      selectedComponents: AgentSelectedComponentInfo[];
      isTaskAgent?: boolean;
      /** 首页可隐藏工作台入口；会话输入框默认保留。 */
      showWorkspace?: boolean;
      pageHomeIndex?: string;
      expandPageArea?: number;
      sandboxList?: SandboxInfo[];
      currentSandboxId?: string;
      isSandboxSwitchDisabled?: boolean;
      isSandboxUnavailable?: boolean;
      sandboxDisabledText?: string;
      readonly?: boolean;
      // 模型选择相关
      allowOtherModel?: boolean;
      currentModelId?: number;
      currentModelName?: string;
      agentId?: number;
      agentType?: string;
      isTempChat?: boolean;
      currentAgentMode?: AgentMode;
      allowChooseMode?: number;
      isHomePage?: boolean;
    }>(),
    {
      manualComponents: () => [],
      selectedComponents: () => [],
      isTaskAgent: false,
      showWorkspace: true,
      pageHomeIndex: "",
      expandPageArea: 0,
      sandboxList: () => [],
      currentSandboxId: "",
      isSandboxSwitchDisabled: false,
      isSandboxUnavailable: false,
      sandboxDisabledText: "",
      readonly: false,
      allowOtherModel: false,
      currentModelId: 0,
      currentModelName: "",
      agentId: 0,
      agentType: "ChatBot",
      isTempChat: false,
      currentAgentMode: "yolo",
      allowChooseMode: 0,
      isHomePage: false,
    },
  );

  const emit = defineEmits<{
    (e: 'onAgentModeChange', mode: AgentMode): void;
    (e: 'onSandboxChange', sandboxId: string): void;
    (e: 'onModelChange', modelId: number, name: string): void;
    (e: 'onSelectComponent', item: AgentSelectedComponentInfo): void;
    (e: 'onOpenPagePreview', uri: string): void;
    (e: 'onOpenFileTree'): void;
  }>();

  /** APP 端模板 v-if 须通过 computed 读取 props */
  const isHomePageVal = computed((): boolean => props.isHomePage == true);
  const isTaskAgentVal = computed((): boolean => props.isTaskAgent == true);
  const showWorkspaceVal = computed((): boolean => props.showWorkspace == true);
  const allowOtherModelVal = computed((): boolean => props.allowOtherModel == true);
  const readonlyVal = computed((): boolean => props.readonly == true);
  const isSandboxUnavailableVal = computed((): boolean => props.isSandboxUnavailable == true);
  const isSandboxSwitchDisabledVal = computed((): boolean => props.isSandboxSwitchDisabled == true);
  const isTempChatVal = computed((): boolean => props.isTempChat == true);
  const allowChooseModeVal = computed((): boolean =>
    props.allowChooseMode == 1,
  );
  const manualComponentsVal = computed((): AgentManualComponentInfo[] => props.manualComponents);
  const sandboxListVal = computed((): SandboxInfo[] => props.sandboxList);
  const currentSandboxIdVal = computed((): string => {
    const id = props.currentSandboxId;
    if (id == null) {
      return "";
    }
    return `${id}`;
  });
  const currentModelNameVal = computed((): string => {
    const name = props.currentModelName;
    if (name == null) {
      return "";
    }
    return `${name}`;
  });
  const agentTypeVal = computed((): string => {
    const typeVal = props.agentType;
    if (typeVal == null || `${typeVal}`.length == 0) {
      return "ChatBot";
    }
    return `${typeVal}`;
  });
  const modelSelectLabelVal = computed((): string => {
    if (currentModelNameVal.value.length > 0) {
      return currentModelNameVal.value;
    }
    return t("Mobile.Chat.modelSelect");
  });
  const currentAgentModeLabel = computed((): string =>
    props.currentAgentMode == "ask"
      ? t("Mobile.Chat.agentModeAskLabel")
      : t("Mobile.Chat.agentModeYoloLabel"),
  );
  const sandboxDisabledTextVal = computed((): string => {
    const text = props.sandboxDisabledText;
    if (text == null) {
      return "";
    }
    return `${text}`;
  });
  const agentIdVal = computed((): number => {
    const id = props.agentId;
    if (id == null) {
      return 0;
    }
    return id;
  });
  const currentModelIdVal = computed((): number => {
    const id = props.currentModelId;
    if (id == null) {
      return 0;
    }
    return id;
  });

  const agentModeVisible = ref<boolean>(false);
  const openAgentModeDrawer = (): void => {
    if (readonlyVal.value == true) return;
    agentModeVisible.value = true;
  };
  const handleAgentModeChangeInside = (mode: AgentMode): void => {
    emit("onAgentModeChange", mode);
    agentModeVisible.value = false;
  };
  const handleAgentModeClose = (): void => {
    agentModeVisible.value = false;
  };

  const currentSandboxName = computed((): string => {
    const list = props.sandboxList;
    const len = list.length;
    const targetId = props.currentSandboxId;
    for (let i = 0; i < len; i++) {
      if (list[i].sandboxId == targetId) {
        return list[i].name;
      }
    }
    if (len > 0) {
      return list[0].name;
    }
    return "";
  });

  const showPageHomeVal = computed((): boolean => {
    const pageHome = props.pageHomeIndex;
    if (pageHome == null || `${pageHome}`.length == 0) {
      return false;
    }
    const area = props.expandPageArea;
    if (area == 1 || `${area}` == "1") {
      return true;
    }
    return false;
  });

  const modelSelectVisible = ref(false);

  /** 静默同步模型名称（不关弹窗） */
  const handleModelSyncInside = (id: number, name: string) => {
    emit("onModelChange", id, name);
  };

  /** 用户在弹窗中选中模型 */
  const handleModelChangeInside = (id: number, name: string) => {
    emit("onModelChange", id, name);
    modelSelectVisible.value = false;
  };
  // 页面预览iframe引用
  const pagePreviewIframeRef = ref<any | null>(null);
  const sandboxVisible = ref(false);

  // 打开沙盒切换抽屉
  const openSandboxDrawer = () => {
    sandboxVisible.value = true;
  };

  // 抽屉内切换沙盒反馈
  const handleSandboxChangeInside = (id: string) => {
    emit("onSandboxChange", id);
    sandboxVisible.value = false;
  };

  const handleSandboxClose = () => {
    sandboxVisible.value = false;
  };

  // 点击工作台，打开文件树弹窗
  const handleOpenFileTree = () => {
    emit("onOpenFileTree");
  };

  // 打开页面预览
  const handleOpenPagePreview = () => {
    const pageHomeIndex = props.pageHomeIndex;
    if (pageHomeIndex.length == 0) {
      return;
    }
    // APP-ANDROID 无 iframe 页面预览，整个事件发送逻辑仅 H5 / 小程序生效
    // #ifndef APP-ANDROID
    let uri = pageHomeIndex;
    // #ifdef H5 || WEB
    if (process.env.NODE_ENV === "production") {
      uri = window.location.origin + props.pageHomeIndex;
    }
    // #endif
    emit("onOpenPagePreview", uri);
    // #endif
  };

  // 选择组件
  const handleSelectComponent = (item: AgentManualComponentInfo) => {
    const selectedComponent = new AgentSelectedComponentInfo(item.id, item.type);
    emit("onSelectComponent", selectedComponent);
  };

  // 判断组件是否被选中
  const isSelected = (item: AgentManualComponentInfo): boolean => {
    const list = props.selectedComponents;
    const len = list.length;
    for (let i = 0; i < len; i++) {
      if (list[i].id == item.id) {
        return true;
      }
    }
    return false;
  };

</script>

<style lang="scss" scoped>
  .manual-component-item {
    width: 100%;
  }

  // Android 原生 scroll-view 需要由确定宽度的父容器约束，才能正确计算横向内容尺寸。
  .manual-wrapper {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: 76rpx;
    /* #ifdef APP-IOS */
    // 与下方 scroll-view 同高：预留垂直空隙，避免 iOS 裁切 chips 底边框
    height: 80rpx;
    overflow: visible;
    /* #endif */
  }

  .manual-container {
    width: 100%;
    height: 76rpx;
    flex-direction: row;
    /* #ifdef APP-IOS */
    height: 80rpx;
    /* #endif */
    /* #ifndef APP */
    scroll-behavior: smooth;
    /* #endif */
    /* #ifdef H5 || MP-WEIXIN */
    -webkit-overflow-scrolling: touch;
    /* #endif */
  }

  .manual-scroll-content {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    /* #ifdef APP-IOS */
    height: 80rpx;
    /* #endif */
    /* #ifdef H5 */
    width: max-content;
    /* #endif */
  }

  .manual-group {
    display: flex;
    flex-direction: row;
  }

  .manual-box {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    height: 76rpx;
    // 首页模型名和沙盒名可能较长；限制单项宽度，保留横向滚动空间。
    max-width: 280rpx;
    padding: 16rpx 24rpx;
    margin-right: 16rpx;
    border-radius: 16rpx;
    border: 2rpx solid #f0f0f0;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  // vapor: 子节点修饰类提为顶层单类，与 .icon/.text 同特异性（本组件模板不直接渲染 .manual-box，
  // 实际渲染在子组件 manual-component-bar / home-manual-component-bar；保持与子组件一致的扁平结构）
  .icon {
    font-size: 32rpx;
    color: #6b7280;
    transition: color 0.3s ease;
    margin-right: 6rpx;
  }

  .text {
    width: 100%;
    color: rgba(21, 23, 31, 0.7);
    font-size: 28rpx;
    font-weight: 400;
  }

  .icon--active {
    color: #4f46e5;
  }

  .text--active {
    color: #5147ff;
  }

  .text--manual-select {
    text-align: center;
    flex: 1;
    min-width: 0;
  }

  .icon-arrow-down {
    font-size: 24rpx;
    margin-left: -4rpx;
    color: rgba(21, 23, 31, 0.4);
  }

  // vapor: 作用于 .manual-box 元素本身的修饰类 hoist 为顶层单类（与 .manual-box 同特异性）
  .active {
    background: #f2f2ff;
    border-color: #f2f2ff;
  }

  .manual-select {
    border-color: #eeeeee;
    min-width: 100rpx;
    max-width: 300rpx;
    flex-shrink: 0;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  // disabled 仅与 manual-select 同元素出现；原两处 &.disabled 合并，pointer-events 取生效值 auto
  .disabled {
    opacity: 0.6;
    background: #f5f5f5;
    pointer-events: auto;
  }

</style>
