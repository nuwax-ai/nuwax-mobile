// nuwax-notification-clear · app-harmony
//
// uni-app x 没有「清除通知」的 JS API，用系统 notificationManager 补齐：
// cancelAll() 清掉通知中心里本应用已发布的通知（系统按应用隔离，不影响其他 App）。
// ★勿改成 @kit.NotificationKit 具名导入：基座 JS 运行时模块表不提供
//   notificationManager 具名导出（SyntaxError，2026-10-22 真机实锤），必须默认导入
//   ——与 utils/im/imPushClient.uts 同一约定。
import notificationManager from "@ohos.notificationManager";

/**
 * 清空本应用在通知中心 / 锁屏里已发布的通知。
 * 清自己的通知不需要任何权限（NOTIFICATION_CONTROLLER 是管他人通知的受限权限）；
 * 异步接口，失败只落日志，不阻塞调用方。
 */
export function clearAppNotifications(): void {
  try {
    notificationManager
      .cancelAll()
      .catch((e: any | null): void => {
        console.error(`[NotificationClear][hm] cancelAll fail: ${e}`);
      });
  } catch (e) {
    console.error("[NotificationClear][hm] cancelAll threw:", e);
  }
}
