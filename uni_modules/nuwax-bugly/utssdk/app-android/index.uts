import BuglyBridge from "com.nuwax.bugly.BuglyBridge";

export function getBuglyPlatform(): string {
  return "android";
}

export function initializeBugly(appId: string, serviceHost: string, environment: string): boolean {
  const context = UTSAndroid.getAppContext();
  if (context == null) return false;
  BuglyBridge.start(context, appId, serviceHost, environment);
  return true;
}

export function stopBugly(): void {
  BuglyBridge.stop();
}
