/**
 * Nuwax Harmony Native Pay（App-Harmony）
 *
 * 与 app-android 端 nuwax-android-native-pay 同名同签名：
 *  - launchAnxinfuMiniProgramNative：微信 OpenSDK 拉起安心付小程序
 *  - openPayUrlNative：打开支付宝收银台 URL（http(s) → openLink；自定义 scheme → startAbility）
 *
 * 华为 IAP（虚拟商品，仅鸿蒙）：
 *  - iapQueryEnvironmentNative / iapQueryProductsNative / iapCreatePurchaseNative /
 *    iapQueryPurchasesNative / iapFinishPurchaseNative
 *
 * 混编约定（同 esp-provisioning）：uts 依赖同目录 HarmonyPayBridge.ets /
 * HarmonyIapBridge.ets，ets 不引用 uts。
 * 支付结果始终以服务端 settlement-status 轮询为准（对齐 Android/iOS），无需实现 onResp 回调。
 */
import { HarmonyPayBridge } from './HarmonyPayBridge.ets'
import { HarmonyIapBridge } from './HarmonyIapBridge.ets'

let bridge: HarmonyPayBridge | null = null

function getBridge(): HarmonyPayBridge {
  if (bridge == null) {
    bridge = new HarmonyPayBridge()
  }
  return bridge!
}

let iapBridge: HarmonyIapBridge | null = null

function getIapBridge(): HarmonyIapBridge {
  if (iapBridge == null) {
    iapBridge = new HarmonyIapBridge()
  }
  return iapBridge!
}

/** 使用微信 OpenSDK 拉起安心付小程序。 */
export async function launchAnxinfuMiniProgramNative(
  userName: string,
  path: string,
): Promise<any> {
  await getBridge().launchAnxinfuMiniProgram(
    UTSHarmony.getUIAbilityContext(),
    userName,
    path,
  )
  return { errMsg: 'launchMiniProgram:ok' } as UTSJSONObject
}

/** 打开支付宝收银台 URL。 */
export async function openPayUrlNative(url: string): Promise<any> {
  await getBridge().openPayUrl(UTSHarmony.getUIAbilityContext(), url)
  return { errMsg: 'openUrl:ok' } as UTSJSONObject
}

// ========== 华为 IAP（虚拟商品）==========

/** IAP 环境检查：{ ok, code, message }（账号未登录等场景 ok=false）。 */
export async function iapQueryEnvironmentNative(): Promise<any> {
  const json = await getIapBridge().queryEnvironment(UTSHarmony.getUIAbilityContext())
  return JSON.parse(json) as UTSJSONObject
}

/** 查询 AGC 商品：{ ok, message(商品数组 JSON), code }。 */
export async function iapQueryProductsNative(
  productType: number,
  productIds: string[],
): Promise<any> {
  const json = await getIapBridge().queryProducts(
    UTSHarmony.getUIAbilityContext(),
    productType,
    productIds,
  )
  return JSON.parse(json) as UTSJSONObject
}

/**
 * 拉起 IAP 收银台购买：{ ok, summary{purchaseData,productId,productType,
 * purchaseOrderId,purchaseToken,finishStatus}, needRecover, code, message }。
 * needRecover=true（PRODUCT_OWNED / SYSTEM_ERROR）时应走 iapQueryPurchasesNative 补单。
 */
export async function iapCreatePurchaseNative(
  productId: string,
  productType: number,
): Promise<any> {
  const json = await getIapBridge().createPurchase(
    UTSHarmony.getUIAbilityContext(),
    productId,
    productType,
  )
  return JSON.parse(json) as UTSJSONObject
}

/** 查询购买记录（补单）：{ ok, orders[summary], code, message }，orders 仅含待确认发货项。 */
export async function iapQueryPurchasesNative(
  productType: number,
  queryUnfinished: boolean,
): Promise<any> {
  const json = await getIapBridge().queryPurchases(
    UTSHarmony.getUIAbilityContext(),
    productType,
    queryUnfinished,
  )
  return JSON.parse(json) as UTSJSONObject
}

/** 确认发货：{ ok, code, message }。 */
export async function iapFinishPurchaseNative(
  productType: number,
  purchaseToken: string,
  purchaseOrderId: string,
): Promise<any> {
  const json = await getIapBridge().finishPurchase(
    UTSHarmony.getUIAbilityContext(),
    productType,
    purchaseToken,
    purchaseOrderId,
  )
  return JSON.parse(json) as UTSJSONObject
}
