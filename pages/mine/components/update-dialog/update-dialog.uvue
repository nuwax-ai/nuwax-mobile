<template>
  <view class="update-dialog__mask" @tap="cancel">
    <view class="update-dialog__panel" @tap.stop>
      <view class="update-dialog__hero">
        <view class="update-dialog__bubble update-dialog__bubble--lg"></view>
        <view class="update-dialog__bubble update-dialog__bubble--md"></view>
        <view class="update-dialog__bubble update-dialog__bubble--sm"></view>
        <view class="update-dialog__close" @tap="cancel">
          <svg-icon name="icon-X" size="16" unit="px" color="#ffffff" />
        </view>
        <text class="update-dialog__title">{{ title }}</text>
      </view>
      <view class="update-dialog__sheet">
        <scroll-view class="update-dialog__body" scroll-y="true">
          <text class="update-dialog__log">{{ versionInfo }}</text>
        </scroll-view>
        <view class="update-dialog__action" @tap="update">
          <text class="update-dialog__action-text">{{ actionText }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { openExternalUrl } from "@/utils/openExternalUrl";
  import { rememberDismissedAppUpdate } from "@/utils/partnerAppUpdate";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const title = ref("");
  const versionInfo = ref("");
  const updateUrl = ref("");
  const dismissVersion = ref("");

  const actionText = computed((): string => {
    // #ifdef APP-ANDROID
    return t("Mobile.Mine.downloadUpdate");
    // #endif
    // #ifndef APP-ANDROID
    return t("Mobile.Mine.updateImmediately");
    // #endif
  });

  const readOption = (value: any | null): string => {
    if (value == null) return "";
    // dialogPage 的查询参数已由运行时解码，禁止再次 decodeURIComponent：
    // 更新日志中的 "30%" 会被二次解码视为非法百分号转义并在 Android 崩溃。
    return `${value}`;
  };

  onLoad((options: OnLoadOptions) => {
    title.value = readOption(options["title"]);
    versionInfo.value = readOption(options["versionInfo"]);
    updateUrl.value = readOption(options["url"]);
    dismissVersion.value = readOption(options["dismissVersion"]);
  });

  const closeSelf = (): void => {
    uni.closeDialogPage({});
  };

  const cancel = (): void => {
    if (dismissVersion.value.length > 0) {
      rememberDismissedAppUpdate(dismissVersion.value);
    }
    closeSelf();
  };

  const update = (): void => {
    const targetUrl = updateUrl.value;
    // 先关掉弹窗再打开。弹窗还盖在最前面时，iOS 会拒绝切到 App Store。
    closeSelf();
    openExternalUrl(targetUrl).catch((): void => {
      uni.showToast({
        title: t("Mobile.Mine.openUpdateFailed"),
        icon: "none",
      });
    });
  };
</script>

<style lang="scss" scoped>
  .update-dialog__mask {
    position: fixed;
    z-index: 1000;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(20, 16, 24, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .update-dialog__panel {
    width: 300px;
    box-sizing: border-box;
    background-color: #ff6b78;
    border-radius: 22px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .update-dialog__hero {
    height: 120px;
    background-color: #ff6b78;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    padding-top: 36px;
  }

  .update-dialog__bubble {
    position: absolute;
    border-radius: 80px;
    background-color: rgba(255, 255, 255, 0.16);
  }

  .update-dialog__bubble--lg {
    width: 120px;
    height: 120px;
    left: -36px;
    top: -48px;
  }

  .update-dialog__bubble--md {
    width: 72px;
    height: 72px;
    right: -16px;
    top: 18px;
  }

  .update-dialog__bubble--sm {
    width: 28px;
    height: 28px;
    right: 54px;
    top: 16px;
    background-color: rgba(255, 255, 255, 0.28);
  }

  .update-dialog__close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .update-dialog__title {
    width: 220px;
    margin-top: 10px;
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
    line-height: 28px;
    text-align: center;
  }

  .update-dialog__sheet {
    margin-top: -28px;
    background-color: #ffffff;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    padding: 22px 22px 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .update-dialog__body {
    width: 100%;
    max-height: 220px;
  }

  .update-dialog__log {
    width: 100%;
    font-size: 14px;
    color: #5c5a66;
    line-height: 22px;
    text-align: left;
  }

  .update-dialog__action {
    width: 180px;
    height: 44px;
    margin-top: 20px;
    border-radius: 22px;
    background-color: #e24b4b;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .update-dialog__action-text {
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
    line-height: 22px;
  }
</style>
