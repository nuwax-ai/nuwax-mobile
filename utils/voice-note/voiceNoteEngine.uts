/**
 * 伙伴页录音会话。
 * App 使用独立的 VoiceNoteM4aRecorder。一次会话只有一个采集器，每段单独写成 m4a，不经过聊天页的 PCM 采集。
 * 录音器挂在模块上，不随页面卸载停止。退到后台继续录。切段只封口当前文件并打开下一份，不释放采集器。
 * 主按钮只暂停或继续，不结束会话，也不落盘。当前段满 1 小时，或点完成，才落盘并上传。
 */
import {
  findOpenVoiceNote,
  loadBackfillGate,
  loadVoiceNotes,
  removeVoiceNote,
  saveBackfillGate,
  upsertVoiceNote,
  VoiceNoteBackfillGate,
  VoiceNoteRecord,
  VoiceNoteSegmentRecord,
} from "@/utils/voice-note/voiceNoteStore.uts";
import {
  apiVoiceNoteComplete,
  apiVoiceNoteCreate,
  apiVoiceNoteDelete,
  apiVoiceNoteUploadSegment,
} from "@/servers/voiceNote.uts";
import { pushVoiceNoteDebug } from "@/utils/voice-note/voiceNoteDebugLog.uts";
import { isAppInBackground } from "@/utils/appLifecycle.uts";

// #ifdef APP-ANDROID
import {
  VoiceNoteM4aRecorder,
  beginVoiceNoteBackground,
  consumeVoiceNoteTaskRemoved,
  endVoiceNoteBackground,
} from "@/uni_modules/nuwax-stream-pcm-player";
// #endif
// #ifdef APP-IOS
import {
  VoiceNoteM4aRecorder,
  beginVoiceNoteBackground,
  endVoiceNoteBackground,
} from "@/uni_modules/nuwax-stream-pcm-player";
// #endif
// #ifdef APP-HARMONY
import {
  VoiceNoteM4aRecorder,
  beginVoiceNoteBackground,
  endVoiceNoteBackground,
  holdVoiceNoteCall,
  markVoiceNoteBackgroundStale,
  releaseVoiceNoteCall,
} from "@/uni_modules/nuwax-stream-pcm-player";
// #endif

/**
 * 伙伴页录音切片时长（毫秒）。当前段累计超过这个时间才落盘并上传。
 * 上线用 3600000（1 小时）。测试可改成 120000（2 分钟）。只改这一处。
 */
const segmentMs = 3600000;

let recorderBound = false;
// #ifdef APP
let m4aRecorder: VoiceNoteM4aRecorder | null = null;
/** 当前这一段正在写的 m4a 绝对路径。停录后交给上传，不再从 PCM 临时文件拷贝。 */
let currentSegmentPath = "";
let recorderBusy = false;
/** 停录过程中又点了停止或重录时，等这一段收尾后按这个意图处理。 */
let queuedIntent = "";
/** 切段已经打开的下一段路径。采集器不重建。 */
let pendingRotatedPath = "";
/** 鸿蒙切段时下一段没有打开。当前段仍要留下，会话改为暂停。 */
let rotateOpenFailed = false;
/** 原生按实际写入采样算出的刚封口时长。closeSegment 读一次后清零。 */
let closedDurationOverride = 0;
/** 切段过程中点了暂停。新文件打开后再暂停同一个采集器。 */
let pauseAfterRotate = false;
// #endif
/**
 * 回前台时这一段已经超时长。先别切段，让停止、继续先用当前文件。
 * 继续录音返回后再允许切段。
 */
let deferRotate = false;
/** "" 用户没要求停 / rotate 到点切段 / user 用户停止 / discard 重录放弃 / busy 正在停 */
/** 已经点了完成。暂停或切段的回调不能再把这次录音改回未结束。 */
let sessionEnding = false;
let endingLocalId = "";
let stopIntent = "";
/** 本进程里录音器是否还在写当前段。进程重启后为 false，用来把没停完的段收成最后一段。 */
let captureAlive = false;
/** 正在录音的本地会话。接口回写缓存时只能改这一条的笔记编号，不能改阶段和文件。 */
let captureLocalId = "";
/** 一次开始还没返回。连点开始不会并行打开两个录音器。 */
let captureStarting = false;
let tickTimer = 0;
/** 本次录音自己的上传是否在进行。不占用补传。 */
let uploadRunning = false;
/** 本次录音上传过程中又落下新分段时，这一轮结束后立刻再传这一次。 */
let uploadRerunLocalId = "";
/** 当前正在上传的本次录音。补传会避开它。 */
let uploadLocalId = "";
/** 补传是否在进行。不占用本次录音的上传。 */
let backfillRunning = false;
/** 总开关这一轮正在补的本地会话。历史记录里的单条补传不写这里。 */
let activeBackfillLocalId = "";
/** 历史列表里正在单独补传的本地会话。同一条不重复开。 */
let historyBackfillLocalIds: string[] = [];
/** 正在创建笔记的本地会话。不同会话可以同时创建，同一条不重复创建。 */
let noteCreateLocalIds: string[] = [];
/** 这一次录音已经申请过后台录音。前台、后台、继续录音都不再重复申请。 */
let backgroundOn = false;

/**
 * 面板正在显示的这一次录音。
 * 计数和波浪只读这份内存，不在每一拍解析本地存储。
 * 分段、阶段变了，由 touch 换成当前这份。
 */
let panelMemory: VoiceNoteRecord | null = null;

function panelPhaseVisible(phase: string): boolean {
  return phase == "recording" || phase == "paused" || phase == "stopped";
}

function rememberPanelMemory(record: VoiceNoteRecord): void {
  if (panelPhaseVisible(record.phase)) {
    panelMemory = record;
    return;
  }
  const current = panelMemory;
  if (current != null && current.localId == record.localId) {
    panelMemory = null;
  }
}

function forgetPanelMemory(localId: string): void {
  const current = panelMemory;
  if (current != null && current.localId == localId) {
    panelMemory = null;
  }
}

function deleteVoiceNote(localId: string): void {
  forgetPanelMemory(localId);
  removeVoiceNote(localId);
}

function activeRecord(): VoiceNoteRecord | null {
  const current = panelMemory;
  if (current != null && current.phase == "recording") {
    return current;
  }
  const open = findOpenVoiceNote();
  if (open != null && open.phase == "recording") {
    panelMemory = open;
    return open;
  }
  return null;
}

function markCaptureRunning(localId: string): void {
  captureAlive = true;
  captureLocalId = localId;
}

function markCaptureStopped(): void {
  captureAlive = false;
  captureLocalId = "";
}

/**
 * 录音器还在写时，接口成功或失败都不能把这条改成失败、上传中或已结束，也不能清掉正在写的文件。
 * 暂停仍允许写成暂停。用户点停止后会先 markCaptureStopped，再按完成落盘。
 */
function keepLiveRecording(record: VoiceNoteRecord): void {
  if (!captureAlive || captureLocalId.length == 0 || record.localId != captureLocalId) return;
  if (record.phase != "paused") {
    record.phase = "recording";
  }
  record.awaitComplete = false;
  record.error = "";
  // 已经暂停的记录不要把刚封口的路径再填回去，否则通话结束后会去恢复一个已经关掉的文件。
  if (record.phase != "paused" && record.openSegmentPath.length == 0 && currentSegmentPath.length > 0) {
    record.openSegmentPath = currentSegmentPath;
  }
}

function touch(record: VoiceNoteRecord): void {
  keepLiveRecording(record);
  rememberPanelMemory(record);
  upsertVoiceNote(record);
}

function beginBackground(): void {
  if (backgroundOn) return;
  backgroundOn = true;
  pushVoiceNoteDebug("录音", "申请后台录音");
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    beginVoiceNoteBackground();
  } catch (e) {
    backgroundOn = false;
    console.warn("[voice-note] begin background failed " + e);
  }
  // #endif
  // #ifdef APP-HARMONY
  try {
    releaseVoiceNoteCall();
  } catch (_eRelease) {
  }
  // #endif
}

function endBackground(): void {
  if (!backgroundOn) return;
  backgroundOn = false;
  pushVoiceNoteDebug("录音", "结束后台录音");
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    endVoiceNoteBackground();
  } catch (e) {
    console.warn("[voice-note] end background failed " + e);
  }
  // #endif
  // #ifdef APP-HARMONY
  if (!pausedByInterruption) {
    try {
      releaseVoiceNoteCall();
    } catch (_eRelease) {
    }
  }
  // #endif
}

/**
 * 鸿蒙接通后录音器通常已经被系统按住。
 * 不停止长时任务，只把它记成可能已失效。挂断后对同一个采集器 resume，成功后再重新申请。
 * 短时保活要在退后台当时申请，这里再补一次；已经在保活中则不会重复申请。
 */
function finishHarmonyInterruptPause(): void {
  // #ifdef APP-HARMONY
  if (pausedByInterruption) {
    try {
      holdVoiceNoteCall();
    } catch (_eHold) {
    }
    backgroundOn = false;
    try {
      markVoiceNoteBackgroundStale();
    } catch (_eStale) {
    }
    return;
  }
  endBackground();
  // #endif
}

function copySegmentFile(src: string, localId: string, index: number): Promise<string> {
  const root = `${uni.env.USER_DATA_PATH}/voice-notes/${localId}`;
  const dest = `${root}/${segmentFileName(index)}`;
  const fs = uni.getFileSystemManager();
  return new Promise<string>((resolve) => {
    const copy = () => {
      fs.copyFile({
        srcPath: src,
        destPath: dest,
        success: () => {
          resolve(dest);
        },
        fail: () => {
          resolve(src);
        },
      });
    };
    fs.mkdir({
      dirPath: root,
      recursive: true,
      success: () => {
        copy();
      },
      fail: () => {
        copy();
      },
    });
  });
}

function segmentFileName(index: number): string {
  return `${index}.aac`;
}

/** 录音文件名：当前时间年月日时分秒，再加这一段的序号。 */
function segmentStampName(index: number): string {
  const now = new Date();
  const pad2 = (n: number): string => {
    const text = `${n}`;
    return text.length < 2 ? `0${text}` : text;
  };
  const stamp =
    `${now.getFullYear()}` +
    pad2(now.getMonth() + 1) +
    pad2(now.getDate()) +
    pad2(now.getHours()) +
    pad2(now.getMinutes()) +
    pad2(now.getSeconds());
  return `${stamp}${index}`;
}

/**
 * 原生文件已经打开之后才做。
 * 创建笔记、申请后台录音失败只记日志，不能停掉正在写的录音。
 */
function armCaptureSideEffects(localId: string): void {
  try {
    bindNoteAfterCapture(localId);
  } catch (e) {
    console.warn("[voice-note] bind note failed " + e);
  }
  try {
    beginBackground();
  } catch (e) {
    console.warn("[voice-note] background failed " + e);
  }
}

function saveRecordQuiet(record: VoiceNoteRecord): void {
  try {
    touch(record);
  } catch (e) {
    console.warn("[voice-note] save record failed " + e);
  }
}

/** 只负责让原生开始写文件。没有路径才算没录上。笔记和补传不在这里。 */
async function startRecorder(): Promise<void> {
  const record = activeRecord();
  if (record == null) {
    markCaptureStopped();
    return;
  }
  const localId = record.localId;
  const indexName = segmentStampName(record.openSegmentIndex);
  // #ifdef APP
  if (m4aRecorder == null) {
    m4aRecorder = new VoiceNoteM4aRecorder();
  }
  let path = "";
  let startError = "";
  try {
    path = await m4aRecorder!.start(localId, indexName);
  } catch (e) {
    console.warn("[voice-note] m4a start failed " + e);
    startError = `${e}`;
    path = "";
  }
  if (path.length == 0) {
    // #ifdef APP-IOS
    if (startError.length == 0 && m4aRecorder != null) {
      startError = m4aRecorder!.takeLastError();
    }
    // #endif
    abandonUnstartedRecording(startError);
    return;
  }
  currentSegmentPath = path;
  markCaptureRunning(localId);
  const latest = activeRecord();
  const saved = latest != null ? latest : record;
  saved.openSegmentPath = path;
  saveRecordQuiet(saved);
  armCaptureSideEffects(localId);
  // #endif
  // #ifndef APP
  try {
    const recorder = uni.getRecorderManager();
    recorder.start({
      duration: 600000,
      sampleRate: 16000,
      numberOfChannels: 1,
      format: "aac",
    });
    markCaptureRunning(localId);
  } catch (e) {
    console.warn("[voice-note] recorder start failed " + e);
    abandonUnstartedRecording(`${e}`);
  }
  // #endif
}

function stopActiveRecorder(intent: string): void {
  markCaptureStopped();
  // #ifdef APP
  if (recorderBusy) {
    queuedIntent = intent;
    return;
  }
  recorderBusy = true;
  stopIntent = "busy";
  const path = currentSegmentPath;
  currentSegmentPath = "";
  void finishM4aStop(intent, path);
  // #endif
  // #ifndef APP
  stopIntent = intent;
  uni.getRecorderManager().stop();
  // #endif
}

// #ifdef APP
async function finishM4aStop(intent: string, path: string): Promise<void> {
  let ok = "0";
  let rotatedPath = "";
  rotateOpenFailed = false;
  if (m4aRecorder != null) {
    try {
      if (intent == "rotate") {
        const recording = activeRecord();
        if (recording != null) {
          const nextName = segmentStampName(recording.openSegmentIndex + 1);
          rotatedPath = await m4aRecorder!.rotate(recording.localId, nextName);
          ok = rotatedPath.length > 0 ? "1" : "0";
          rotateOpenFailed = ok != "1";
          closedDurationOverride = m4aRecorder!.takeClosedDurationMs();
        }
      } else {
        ok = await m4aRecorder!.stop();
      }
      if (ok == "1" && intent != "rotate") {
        closedDurationOverride = m4aRecorder!.takeClosedDurationMs();
      }
    } catch (e) {
      console.warn("[voice-note] m4a stop failed " + e);
      ok = "0";
      rotatedPath = "";
    }
  }
  let intentToUse = intent;
  if (queuedIntent.length > 0) {
    intentToUse = queuedIntent;
    queuedIntent = "";
    rotatedPath = "";
    rotateOpenFailed = false;
  }
  pendingRotatedPath = ok == "1" ? rotatedPath : "";
  recorderBusy = false;
  const sealedPath = ok == "1" || rotateOpenFailed ? path : "";
  await handleRecorderStop(intentToUse, sealedPath);
}
// #endif

function ensureTicker(): void {
  if (tickTimer != 0) return;
  tickTimer = setInterval(() => {
    onTick();
  }, 1000);
  ensureInterruptWatch();
}

function stopTicker(): void {
  if (tickTimer != 0) {
    clearInterval(tickTimer);
    tickTimer = 0;
  }
}

function openSegmentMs(record: VoiceNoteRecord, now: number): number {
  let extra = 0;
  if (record.segmentStartedAt > 0) {
    extra = now - record.segmentStartedAt;
    if (extra < 0) extra = 0;
  }
  return record.openElapsedMs + extra;
}

function freezeOpenSegment(record: VoiceNoteRecord): void {
  freezeOpenSegmentAt(record, Date.now());
}

/** 计时停在指定时刻。电话接通时用中断发生的时间，避免把通话那一段算进录音。 */
function freezeOpenSegmentAt(record: VoiceNoteRecord, atMs: number): void {
  record.openElapsedMs = openSegmentMs(record, atMs);
  record.segmentStartedAt = 0;
}

function interruptionKind(event: string): string {
  const bar = event.indexOf("|");
  if (bar <= 0) return event;
  return event.substring(0, bar);
}

function interruptionAt(event: string): number {
  const bar = event.indexOf("|");
  if (bar <= 0) return 0;
  const parsed = parseInt(event.substring(bar + 1));
  if (isNaN(parsed) || parsed <= 0) return 0;
  return parsed;
}

let pausedByInterruption = false;
let interruptTimer: number = 0;
let interruptBusy = false;
let interruptRetryAt = 0;
let interruptRetryNoted = false;
let onInterruptTick: (() => void) | null = null;

function stopInterruptWatch(): void {
  if (interruptTimer != 0) {
    clearInterval(interruptTimer);
    interruptTimer = 0;
  }
}

function ensureInterruptWatch(): void {
  if (interruptTimer != 0) {
    return;
  }
  interruptTimer = setInterval(() => {
    if (onInterruptTick != null) {
      onInterruptTick!();
    }
  }, 500);
}

function onTick(): void {
  const record = activeRecord();
  if (record == null) {
    stopTicker();
    if (!pausedByInterruption) {
      stopInterruptWatch();
    }
    return;
  }
  // #ifdef APP
  if (onInterruptTick != null) {
    onInterruptTick!();
  }
  // #endif
  const segmentElapsed = openSegmentMs(record, Date.now());
  if (!deferRotate && segmentElapsed >= segmentMs && stopIntent.length == 0) {
    // 鸿蒙切段要先停掉 AVRecorder 再 start。后台不允许重新 start，文件继续写，回前台再切。
    // #ifdef APP-HARMONY
    if (isAppInBackground()) {
      return;
    }
    // #endif
    stopActiveRecorder("rotate");
  }
}

/**
 * 鸿蒙退后台时不切段，回到前台封口的文件可能远超一段。
 * 按分段时长拆成多份。正常刚满一段的文件（只超出几秒）不拆。
 */
async function splitLongHarmonySegment(record: VoiceNoteRecord): Promise<void> {
  // #ifdef APP-HARMONY
  const count = record.segments.length;
  if (count <= 0) return;
  const last = record.segments[count - 1];
  if (last.durationMs <= segmentMs + 20000) return;
  let splitter = m4aRecorder;
  if (splitter == null) {
    splitter = new VoiceNoteM4aRecorder();
  }
  let packed = "";
  try {
    packed = await splitter.split(last.filePath, segmentMs);
  } catch (e) {
    console.warn("[voice-note] split long segment failed " + e);
    return;
  }
  if (packed.length == 0) return;
  const lines = packed.split("\n");
  const pieces: VoiceNoteSegmentRecord[] = [];
  let cursor = last.startedAt;
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const tab = line.indexOf("\t");
    if (tab <= 0) continue;
    const filePath = line.substring(0, tab);
    const durationMs = parseInt(line.substring(tab + 1));
    if (filePath.length == 0 || isNaN(durationMs) || durationMs <= 0) continue;
    const row = new VoiceNoteSegmentRecord();
    row.segmentIndex = last.segmentIndex + pieces.length;
    row.filePath = filePath;
    row.durationMs = durationMs;
    row.startedAt = cursor;
    row.uploadStatus = "pending";
    row.uploadAttempts = 0;
    pieces.push(row);
    cursor = cursor + durationMs;
  }
  if (pieces.length <= 1) return;
  const kept: VoiceNoteSegmentRecord[] = [];
  for (let i = 0; i < count - 1; i++) {
    kept.push(record.segments[i]);
  }
  for (let i = 0; i < pieces.length; i++) {
    kept.push(pieces[i]);
  }
  record.segments = kept;
  record.openSegmentIndex = last.segmentIndex + pieces.length;
  record.accumulatedMs = record.accumulatedMs - last.durationMs;
  let added = 0;
  for (let i = 0; i < pieces.length; i++) {
    added = added + pieces[i].durationMs;
  }
  record.accumulatedMs = record.accumulatedMs + added;
  touch(record);
  pushVoiceNoteDebug("录音", "超长文件拆成 " + pieces.length.toString() + " 段");
  // #endif
}

// #ifdef APP
/**
 * 杀掉进程后补写 moov。成功返回 "1"。
 * 旧基座没有 seal 方法时返回 "0"，Android、鸿蒙按原文件上传。
 * 新基座封口失败返回 "0:原因"，这次不上传。
 */
async function sealUnfinishedM4a(filePath: string): Promise<string> {
  if (filePath.length == 0) return "0";
  try {
    const sealer = new VoiceNoteM4aRecorder();
    const result = await sealer.seal(filePath);
    pushVoiceNoteDebug("录音", "补封口 " + result);
    if (result.length == 0) return "0";
    return result;
  } catch (e) {
    console.warn("[voice-note] m4a 封口失败 " + e);
    return "0";
  }
}
// #endif

async function closeSegment(record: VoiceNoteRecord, tempPath: string): Promise<number> {
  const index = record.openSegmentIndex;
  const endedAt = Date.now();
  let durationMs = 0;
  // #ifdef APP
  durationMs = closedDurationOverride;
  closedDurationOverride = 0;
  // #endif
  if (durationMs <= 0) {
    durationMs = openSegmentMs(record, endedAt);
  }
  const startedAt = endedAt - durationMs;
  // App 的 m4a 已经写在最终路径上。小程序拿到的是临时 aac，再拷进会话目录。
  let filePath = tempPath;
  // #ifndef APP
  filePath = await copySegmentFile(tempPath, record.localId, index);
  // #endif
  // #ifdef APP-IOS
  // stop() 才会写 moov。进程被杀掉时先补封口，封好才收成一段。封不了就留着路径，下次再试。
  if (isM4aPath(filePath)) {
    let gate = await segmentUploadReady(filePath);
    if (gate == "unsealed") {
      const sealResult = await sealUnfinishedM4a(filePath);
      if (sealResult == "1") {
        gate = await segmentUploadReady(filePath);
      } else if (sealResult == "0:nomdat") {
        await unlinkVoiceFile(filePath);
        if (record.openSegmentPath == filePath || record.openSegmentPath == tempPath) {
          record.openSegmentPath = "";
        }
        record.error = "";
        touch(record);
        console.warn("[voice-note] m4a 没有音频数据，已删除");
        return -1;
      }
    }
    if (gate == "unsealed") {
      if (record.segments.length == 0) {
        record.error = "录音文件未封口";
      }
      touch(record);
      console.warn("[voice-note] m4a 未封口，先不上传");
      return -1;
    }
  }
  // #endif
  const segment = new VoiceNoteSegmentRecord();
  segment.segmentIndex = index;
  segment.filePath = filePath;
  const duration = durationMs > 0 ? durationMs : 0;
  segment.durationMs = duration;
  segment.startedAt = startedAt;
  segment.uploadStatus = "pending";
  segment.uploadAttempts = 0;
  record.segments.push(segment);
  const keepWriting = record.openSegmentPath.length > 0 && record.openSegmentPath != filePath && record.openSegmentPath != tempPath;
  if (!keepWriting) {
    record.openSegmentIndex = index + 1;
    record.segmentStartedAt = 0;
    record.openElapsedMs = 0;
    record.openSegmentPath = "";
  } else if (record.openSegmentIndex <= index) {
    record.openSegmentIndex = index + 1;
    record.openElapsedMs = 0;
    if (record.phase != "recording") {
      record.segmentStartedAt = 0;
    }
  }
  record.accumulatedMs = record.accumulatedMs + duration;
  touch(record);
  await splitLongHarmonySegment(record);
  return index;
}

function readErrorMessage(err: any | null): string {
  if (err == null) return "录音失败";
  const obj = err as UTSJSONObject;
  if (obj["errMsg"] != null) return `${obj["errMsg"]}`;
  return "录音失败";
}

async function forgetUnstartedNote(noteId: string): Promise<void> {
  try {
    await apiVoiceNoteDelete(noteId, true);
  } catch (_e) {
    // 本地会话已经丢掉。服务端未收尾的笔记会在 7 天后回收。
  }
}

/**
 * 开录没有拿到文件路径。这次会话还没有音频，直接丢掉。
 * 不能留成失败记录，否则下次点击开始会再次把它当成当前录音并继续报错。
 */
function abandonUnstartedRecording(reason: string): void {
  markCaptureStopped();
  stopIntent = "";
  const record = activeRecord();
  endBackground();
  stopTicker();
  releaseRecorderCallbacks();
  // #ifdef APP
  if (m4aRecorder != null) {
    const dying = m4aRecorder!;
    m4aRecorder = null;
    void dying.stop();
  }
  // #endif
  if (record != null && (record.segments.length > 0 || record.openSegmentPath.length > 0)) {
    record.phase = "paused";
    record.error = "";
    record.awaitComplete = false;
    record.segmentStartedAt = 0;
    touch(record);
  } else if (record != null) {
    const noteId = record.noteId;
    record.phase = "discarded";
    record.error = "";
    record.awaitComplete = false;
    record.openSegmentPath = "";
    touch(record);
    deleteVoiceNote(record.localId);
    if (noteId.length > 0) {
      void forgetUnstartedNote(noteId);
    }
  }
  const title = reason.length > 0 ? reason : "录音失败";
  uni.showToast({ title: title, icon: "none" });
}

function onNativeError(err: any | null): void {
  markCaptureStopped();
  stopIntent = "";
  // #ifdef APP-HARMONY
  if (m4aRecorder != null) {
    const dying = m4aRecorder!;
    m4aRecorder = null;
    void dying.stop();
  }
  // #endif
  const record = activeRecord();
  if (record == null) {
    releaseRecorderCallbacks();
    return;
  }
  const message = readErrorMessage(err);
  record.phase = "failed";
  record.error = message;
  touch(record);
  endBackground();
  stopTicker();
  releaseRecorderCallbacks();
  uni.showToast({ title: message, icon: "none" });
}

/** App 的 m4a 录音器不占用 RecorderManager。小程序才需要松开那组单例回调。 */
function releaseRecorderCallbacks(): void {
  pausedByInterruption = false;
  stopInterruptWatch();
  recorderBound = false;
  // #ifndef APP
  const recorder = uni.getRecorderManager();
  recorder.onStart((_res: any | null) => {});
  recorder.onStop((_res: RecorderManagerOnStopResult) => {});
  recorder.onError((_err: any) => {});
  // #endif
}

function bindRecorder(): void {
  // #ifdef APP
  if (m4aRecorder == null) {
    m4aRecorder = new VoiceNoteM4aRecorder();
  }
  // #endif
  // #ifndef APP
  const recorder = uni.getRecorderManager();
  recorder.onStart((_res: any | null) => {
    const open = activeRecord();
    if (open == null) return;
    bindNoteAfterCapture(open.localId);
  });
  recorder.onStop((res: RecorderManagerOnStopResult) => {
    const intent = stopIntent;
    stopIntent = "busy";
    const path = res.tempFilePath != null ? `${res.tempFilePath}` : "";
    void handleRecorderStop(intent, path);
  });
  recorder.onError((err: any) => {
    onNativeError(err);
  });
  // #endif
  recorderBound = true;
}

/** 录音中或暂停中都还拿着当前文件。点完成时状态往往已是暂停，不能只认录音中。 */
function sessionHoldingFile(): VoiceNoteRecord | null {
  const open = findOpenVoiceNote();
  if (open == null) return null;
  if (open.phase == "recording" || open.phase == "paused") return open;
  return null;
}

function noteByLocalId(localId: string): VoiceNoteRecord | null {
  if (localId.length == 0) return null;
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].localId == localId) return rows[i];
  }
  return null;
}

async function handleRecorderStop(intent: string, tempPath: string): Promise<void> {
  let usedIntent = intent;
  if (sessionEnding && usedIntent != "discard" && usedIntent != "finish" && usedIntent != "exit") {
    usedIntent = "finish";
  }
  let record = sessionHoldingFile();
  if (record == null && (usedIntent == "finish" || usedIntent == "exit")) {
    record = noteByLocalId(endingLocalId);
    if (record == null) record = findOpenVoiceNote();
  }
  if (record == null) {
    stopIntent = "";
    sessionEnding = false;
    endingLocalId = "";
    return;
  }
  if (intent == "discard") {
    // #ifdef APP
    pauseAfterRotate = false;
    pendingRotatedPath = "";
    // #endif
    sessionEnding = false;
    endingLocalId = "";
    record.phase = "discarded";
    touch(record);
    deleteVoiceNote(record.localId);
    const noteId = record.noteId;
    endBackground();
    stopTicker();
    releaseRecorderCallbacks();
    if (noteId.length > 0) {
      try {
        await apiVoiceNoteDelete(noteId, true);
      } catch (_e) {
        // 本地已放弃。服务端会话会在 7 天未收尾后回收。
      }
    }
    return;
  }
  if (usedIntent == "finish" || usedIntent == "exit") {
    // #ifdef APP
    pauseAfterRotate = false;
    pendingRotatedPath = "";
    // #endif
    let path = tempPath;
    if (path.length == 0 && record.openSegmentPath.length > 0) {
      path = record.openSegmentPath;
    }
    let closedIndex = -1;
    if (path.length > 0) {
      closedIndex = await closeSegment(record, path);
    }
    record.phase = "uploading";
    record.awaitComplete = true;
    record.segmentStartedAt = 0;
    record.openSegmentPath = "";
    touch(record);
    endBackground();
    stopTicker();
    releaseRecorderCallbacks();
    stopIntent = "";
    sessionEnding = false;
    endingLocalId = "";
    if (usedIntent == "finish") {
      void pumpQueue(record.localId, false);
    }
    return;
  }
  const pausing = usedIntent == "user";
  // #ifdef APP
  if (!pausing && usedIntent != "finish" && usedIntent != "exit" && usedIntent != "discard" && pauseAfterRotate) {
    pauseAfterRotate = false;
    if (pendingRotatedPath.length > 0) {
      const opened = pendingRotatedPath;
      pendingRotatedPath = "";
      currentSegmentPath = opened;
      record.openSegmentPath = opened;
      markCaptureRunning(record.localId);
    } else {
      pendingRotatedPath = "";
    }
    await pauseActiveRecorder(record);
    if (tempPath.length > 0 && tempPath != record.openSegmentPath) {
      void closeSegment(record, tempPath);
      void pumpQueue(record.localId, false);
    }
    stopIntent = "";
    return;
  }
  // #endif
  let closedIndex = -1;
  if (tempPath.length > 0) {
    closedIndex = await closeSegment(record, tempPath);
  }
  if (pausing) {
    pushVoiceNoteDebug("录音", "暂停，会话未结束");
    if (sessionEnding) {
      const savedEnding = noteByLocalId(record.localId);
      const ending = savedEnding != null ? savedEnding : record;
      ending.phase = "uploading";
      ending.awaitComplete = true;
      ending.segmentStartedAt = 0;
      ending.openSegmentPath = "";
      touch(ending);
      endBackground();
      stopTicker();
      releaseRecorderCallbacks();
      sessionEnding = false;
      endingLocalId = "";
      void pumpQueue(ending.localId, false);
      return;
    }
    let paused: VoiceNoteRecord | null = null;
    const saved = loadVoiceNotes();
    for (let i = 0; i < saved.length; i++) {
      const row = saved[i];
      if (row != null && row.localId == record.localId) {
        paused = row;
        break;
      }
    }
    const found = paused;
    const target = found != null ? found : record;
    target.phase = "paused";
    target.segmentStartedAt = 0;
    target.openSegmentPath = "";
    target.awaitComplete = false;
    touch(target);
    endBackground();
    stopTicker();
    releaseRecorderCallbacks();
    return;
  }
  // 分段时长已满：当前文件已经封口。采集器仍是原来的那个，下一段文件也已打开。
  void pumpQueue(record.localId, false);
  record.segmentStartedAt = Date.now();
  touch(record);
  stopIntent = "";
  // #ifdef APP
  if (pendingRotatedPath.length > 0) {
    const opened = pendingRotatedPath;
    pendingRotatedPath = "";
    currentSegmentPath = opened;
    record.openSegmentPath = opened;
    markCaptureRunning(record.localId);
    touch(record);
    pushVoiceNoteDebug("录音", "切段，采集器不重建");
    if (pauseAfterRotate) {
      pauseAfterRotate = false;
      await pauseActiveRecorder(record);
    }
    return;
  }
  pendingRotatedPath = "";
  // #endif
  // #ifdef APP-HARMONY
  if (rotateOpenFailed) {
    rotateOpenFailed = false;
    record.phase = "paused";
    record.openSegmentPath = "";
    record.segmentStartedAt = 0;
    record.awaitComplete = false;
    touch(record);
    markCaptureStopped();
    pushVoiceNoteDebug("录音", "下一段没有打开，已暂停");
    endBackground();
    stopTicker();
    if (m4aRecorder != null) {
      const dying = m4aRecorder!;
      m4aRecorder = null;
      try {
        await dying.stop();
      } catch (_e) {
      }
    }
    return;
  }
  // #endif
  // #ifdef APP
  rotateOpenFailed = false;
  // #endif
  await startRecorder();
}

function findVoiceNoteByLocalId(localId: string): VoiceNoteRecord | null {
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].localId == localId) return rows[i];
  }
  return null;
}

/**
 * 按段号回写上传状态。先重读缓存，避免覆盖停止录音时刚落下的最后一段。
 */
function writeSegmentUpload(
  localId: string,
  segmentIndex: number,
  status: string,
  segmentId: string,
  error: string,
  attempts: number,
): VoiceNoteRecord | null {
  const record = findVoiceNoteByLocalId(localId);
  if (record == null) return null;
  for (let i = 0; i < record.segments.length; i++) {
    const row = record.segments[i];
    if (row.segmentIndex != segmentIndex) continue;
    if (segmentId.length > 0) row.segmentId = segmentId;
    row.uploadStatus = status;
    if (attempts >= 0) row.uploadAttempts = attempts;
    if (error.length > 0) {
      record.error = error;
    } else if (status == "uploaded") {
      record.error = "";
    }
    touch(record);
    return record;
  }
  return record;
}

/** 刚落下的一段在同一次上传里连续失败时，最多再试到 3 次，然后留给以后的补传。 */
const maxSegmentUploadAttempts = 3;

/** 两次补传开始时间至少间隔 2 分钟。不满就跳过这次。 */
const backfillGapMs = 120000;

/**
 * 补传只处理还没上传成功的分段。
 * pending 未上传，failed 上传失败，uploading 是上次没传完。
 * uploaded 已成功，不再上传。失败次数不在这里封顶，避免文件永远留在本地。
 */
function segmentCanUpload(row: VoiceNoteSegmentRecord): boolean {
  const status = row.uploadStatus;
  return status == "pending" || status == "failed" || status == "uploading";
}

/** 历史记录触发的补传：正在上传或已经成功的分段不再传。 */
function historySegmentNeedsUpload(row: VoiceNoteSegmentRecord): boolean {
  const status = row.uploadStatus;
  if (status == "uploading" || status == "uploaded") return false;
  return true;
}

function allSegmentsUploaded(record: VoiceNoteRecord): boolean {
  if (record.segments.length <= 0) return false;
  for (let i = 0; i < record.segments.length; i++) {
    if (record.segments[i].uploadStatus != "uploaded") return false;
  }
  return true;
}

function parentDirectory(filePath: string): string {
  const slash = filePath.lastIndexOf("/");
  if (slash <= 0) return "";
  return filePath.substring(0, slash);
}

function rememberDirectory(dirs: string[], dir: string): void {
  if (dir.length == 0) return;
  for (let i = 0; i < dirs.length; i++) {
    if (dirs[i] == dir) return;
  }
  dirs.push(dir);
}

/** 本地录音记录被清掉时，一并删掉本机上的分段文件和会话目录。 */
function deleteVoiceNoteFiles(record: VoiceNoteRecord): void {
  const fs = uni.getFileSystemManager();
  const dirs: string[] = [];
  const unlinkOne = (filePath: string): void => {
    if (filePath.length == 0) return;
    rememberDirectory(dirs, parentDirectory(filePath));
    try {
      fs.unlink({
        filePath: filePath,
        fail: (_err) => {},
      });
    } catch (_eUnlink) {
      // 文件已经不在时忽略。
    }
  };
  for (let i = 0; i < record.segments.length; i++) {
    unlinkOne(record.segments[i].filePath);
  }
  unlinkOne(record.openSegmentPath);
  for (let i = 0; i < dirs.length; i++) {
    try {
      fs.rmdir({
        dirPath: dirs[i],
        recursive: true,
        fail: (_err) => {},
      });
    } catch (_eRmdir) {
      // 目录非空或已经删掉时忽略。
    }
  }
}

/** 文件还在才删。不存在或删除失败都跳过，不打断后面的文件。 */
function unlinkVoiceFile(filePath: string): Promise<void> {
  if (filePath.length == 0) {
    return Promise.resolve();
  }
  return new Promise<void>((resolve) => {
    const fs = uni.getFileSystemManager();
    fs.getFileInfo({
      filePath: filePath,
      success: (_info) => {
        fs.unlink({
          filePath: filePath,
          success: () => {
            resolve();
          },
          fail: (_err) => {
            resolve();
          },
        });
      },
      fail: (_missing) => {
        resolve();
      },
    });
  });
}

/**
 * 历史记录删除成功后调用。补传列表里有这个 noteId，才按分段路径删掉还在的本地音频，并把这条移出列表。
 * 列表里没有，或这一次还在录音，不动文件。
 */
export async function deleteCachedVoiceNoteFiles(noteId: string): Promise<void> {
  if (noteId.length == 0) return;
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    if (row.noteId != noteId) continue;
    if (row.phase == "recording") continue;
    const paths: string[] = [];
    for (let s = 0; s < row.segments.length; s++) {
      const filePath = row.segments[s].filePath;
      if (filePath.length == 0) continue;
      paths.push(filePath);
    }
    if (row.openSegmentPath.length > 0) {
      paths.push(row.openSegmentPath);
    }
    for (let p = 0; p < paths.length; p++) {
      await unlinkVoiceFile(paths[p]);
    }
    deleteVoiceNote(row.localId);
  }
}

// #ifdef APP
/** App 分段是 m4a。小程序是 aac，没有 moov。 */
function isM4aPath(filePath: string): boolean {
  if (filePath.length < 4) return false;
  const tail = filePath.substring(filePath.length - 4);
  return tail == ".m4a" || tail == ".M4A";
}

function waitMs(ms: number): Promise<void> {
  return new Promise<void>((resolve) => {
    setTimeout(() => {
      resolve();
    }, ms);
  });
}

function readBe32(bytes: Uint8Array, offset: number): number {
  return bytes[offset] * 16777216 + bytes[offset + 1] * 65536 + bytes[offset + 2] * 256 + bytes[offset + 3];
}

function segmentFileSize(filePath: string): Promise<number> {
  if (filePath.length == 0) {
    return Promise.resolve(0);
  }
  return new Promise<number>((resolve) => {
    uni.getFileSystemManager().getFileInfo({
      filePath: filePath,
      success: (res) => {
        resolve(res.size);
      },
      fail: (_err) => {
        resolve(0);
      },
    });
  });
}

/**
 * 只读顶层 box 头，确认 m4a 已经写过 moov。
 * moov 由 stop() 落在文件末尾；没走到 stop() 的文件只有 ftyp 和 mdat。
 */
function m4aHasMoov(filePath: string, size: number): boolean {
  if (size < 16) return false;
  const fs = uni.getFileSystemManager();
  let fd = "";
  let sealed = false;
  try {
    fd = fs.openSync({
      filePath: filePath,
      flag: "r",
    });
    const header = new ArrayBuffer(16);
    let pos = 0;
    let steps = 0;
    while (pos + 8 <= size && steps < 64) {
      steps = steps + 1;
      const read = fs.readSync({
        fd: fd,
        arrayBuffer: header,
        offset: 0,
        length: 8,
        position: pos,
      });
      if (read.bytesRead < 8) break;
      const bytes = new Uint8Array(header);
      if (bytes[4] == 0x6d && bytes[5] == 0x6f && bytes[6] == 0x6f && bytes[7] == 0x76) {
        sealed = true;
        break;
      }
      const boxSize32 = readBe32(bytes, 0);
      let boxSize = boxSize32;
      if (boxSize32 == 1) {
        const wide = fs.readSync({
          fd: fd,
          arrayBuffer: header,
          offset: 0,
          length: 8,
          position: pos + 8,
        });
        if (wide.bytesRead < 8) break;
        const wideBytes = new Uint8Array(header);
        const high = readBe32(wideBytes, 0);
        if (high != 0) break;
        boxSize = readBe32(wideBytes, 4);
      } else if (boxSize32 == 0) {
        boxSize = size - pos;
      }
      if (boxSize < 8 || pos + boxSize > size) break;
      pos = pos + boxSize;
    }
  } catch (e) {
    console.warn("[voice-note] 读取 m4a 封口失败 " + e);
    sealed = false;
  }
  if (fd.length > 0) {
    try {
      fs.closeSync({ fd: fd });
    } catch (_e) {
      // 描述符关掉失败不影响这次是否上传。
    }
  }
  return sealed;
}

/**
 * 上传前的文件结论：ready 可以传，missing 不在或是空文件，unsealed 有数据但没有 moov。
 * moov 偶尔会比 stop() 返回晚一拍落盘，缺 moov 时再读一次。
 */
async function segmentUploadReady(filePath: string): Promise<string> {
  const size = await segmentFileSize(filePath);
  if (size <= 0) return "missing";
  if (!isM4aPath(filePath)) return "ready";
  if (m4aHasMoov(filePath, size)) return "ready";
  await waitMs(300);
  const sizeAgain = await segmentFileSize(filePath);
  if (sizeAgain > 0 && m4aHasMoov(filePath, sizeAgain)) return "ready";
  return "unsealed";
}
// #endif

// #ifndef APP
/** 异步确认本地文件还在。iOS 上 accessSync 对不存在的文件也会判成存在，所以只信 getFileInfo 回调。 */
function segmentFileExists(filePath: string): Promise<boolean> {
  if (filePath.length == 0) {
    return Promise.resolve(false);
  }
  return new Promise<boolean>((resolve) => {
    uni.getFileSystemManager().getFileInfo({
      filePath: filePath,
      success: (res) => {
        resolve(res.size != 0);
      },
      fail: (_err) => {
        resolve(false);
      },
    });
  });
}
// #endif

function segmentIndexUsed(indexes: number[], index: number): boolean {
  for (let i = 0; i < indexes.length; i++) {
    if (indexes[i] == index) return true;
  }
  return false;
}

/** 已上传分段的编号不能改。未上传的分段补进空位，保证剩下的编号从 0 连续排到最后。 */
function compactPendingSegmentIndexes(record: VoiceNoteRecord): void {
  const used: number[] = [];
  for (let i = 0; i < record.segments.length; i++) {
    const row = record.segments[i];
    if (row.uploadStatus == "uploaded") used.push(row.segmentIndex);
  }
  let next = 0;
  let maxIndex = -1;
  for (let i = 0; i < record.segments.length; i++) {
    const row = record.segments[i];
    if (row.uploadStatus == "uploaded") {
      if (row.segmentIndex > maxIndex) maxIndex = row.segmentIndex;
      continue;
    }
    while (segmentIndexUsed(used, next)) {
      next = next + 1;
    }
    row.segmentIndex = next;
    used.push(next);
    if (next > maxIndex) maxIndex = next;
    next = next + 1;
  }
  const following = maxIndex + 1;
  record.openSegmentIndex = following > 0 ? following : 0;
}

/** 补传时本地文件已被删掉：从分段列表移除，不占用上传次数。 */
function removeMissingSegment(localId: string, segmentIndex: number): VoiceNoteRecord | null {
  const record = findVoiceNoteByLocalId(localId);
  if (record == null) return null;
  const kept: VoiceNoteSegmentRecord[] = [];
  for (let i = 0; i < record.segments.length; i++) {
    const row = record.segments[i];
    if (row.segmentIndex != segmentIndex || row.uploadStatus == "uploaded") {
      kept.push(row);
    }
  }
  while (record.segments.length > 0) {
    record.segments.pop();
  }
  for (let i = 0; i < kept.length; i++) {
    record.segments.push(kept[i]);
  }
  compactPendingSegmentIndexes(record);
  touch(record);
  return record;
}

function rememberCreateError(localId: string, message: string): void {
  console.warn("[voice-note] create note failed " + message);
  const latest = findVoiceNoteByLocalId(localId);
  if (latest == null) return;
  if (latest.phase == "recording" || latest.phase == "paused") return;
  latest.error = message;
  touch(latest);
}

/**
 * 补齐 noteId。本地录音记录始终保留。
 * 已有非空 noteId 直接返回。这一条正在创建时返回 null，调用方不得上传。其他会话的创建互不影响。
 * 创建失败或没有返回 noteId 时抛错，不把空编号写进这条记录。
 * 创建返回时本地会话已删除或已放弃，则删掉刚建的服务端笔记，不再写回缓存。
 */
async function ensureNoteId(localId: string): Promise<VoiceNoteRecord | null> {
  const current = findVoiceNoteByLocalId(localId);
  if (current == null || current.phase == "discarded") return null;
  if (current.noteId.length > 0) return current;
  if (noteCreateBusy(localId)) return null;
  rememberNoteCreate(localId);
  try {
    const noteId = await apiVoiceNoteCreate("", true);
    if (noteId.length == 0) {
      throw new Error("创建笔记未返回 noteId");
    }
    const latest = findVoiceNoteByLocalId(localId);
    if (latest == null || latest.phase == "discarded") {
      void deleteNoteQuiet(noteId);
      return null;
    }
    latest.noteId = noteId;
    latest.error = "";
    touch(latest);
    return latest;
  } finally {
    forgetNoteCreate(localId);
  }
}

function noteCreateBusy(localId: string): boolean {
  for (let i = 0; i < noteCreateLocalIds.length; i++) {
    if (noteCreateLocalIds[i] == localId) return true;
  }
  return false;
}

function rememberNoteCreate(localId: string): void {
  noteCreateLocalIds.push(localId);
}

function forgetNoteCreate(localId: string): void {
  const next: string[] = [];
  for (let i = 0; i < noteCreateLocalIds.length; i++) {
    if (noteCreateLocalIds[i] != localId) next.push(noteCreateLocalIds[i]);
  }
  noteCreateLocalIds = next;
}

function segmentSkipped(indexes: number[], segmentIndex: number): boolean {
  for (let i = 0; i < indexes.length; i++) {
    if (indexes[i] == segmentIndex) return true;
  }
  return false;
}

/**
 * 面板上还没点完成的这一次。录音中优先，否则最近一条暂停或停止。
 * 历史补传不能收尾这一次：播放时采集已暂停，阶段不再是录音中。
 */
function panelVoiceNote(): VoiceNoteRecord | null {
  const current = panelMemory;
  if (current != null && panelPhaseVisible(current.phase)) {
    return current;
  }
  panelMemory = null;
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].phase == "recording") {
      panelMemory = rows[i];
      return panelMemory;
    }
  }
  for (let i = 0; i < rows.length; i++) {
    const phase = rows[i].phase;
    if (phase == "paused" || phase == "stopped") {
      panelMemory = rows[i];
      return panelMemory;
    }
  }
  return null;
}

/**
 * 本次录音和补传各传各的会话，同时进行。
 * backfill 为 true：某一段失败后跳过，继续下一个文件。
 * 为 false：刚落下的这一段失败后还可以在本次接着试，满 3 次后留给以后的补传。
 */
async function pumpQueue(localId: string, backfill: boolean, history: boolean = false, ownsGate: boolean = true): Promise<void> {
  if (history) {
    if (historyBackfillBusy(localId)) return;
    rememberHistoryBackfill(localId);
  } else if (backfill) {
    if (ownsGate) {
      if (backfillRunning) return;
      backfillRunning = true;
      markBackfillRunning(true);
    }
    activeBackfillLocalId = localId;
  } else {
    if (uploadRunning) {
      uploadRerunLocalId = localId;
      return;
    }
    uploadRunning = true;
    uploadLocalId = localId;
  }
  const panelAtStart = panelVoiceNote();
  const protectedLocalId = panelAtStart != null ? panelAtStart.localId : "";
  try {
    await stageOpenFileForUpload(localId);
    const skipped: number[] = [];
    let guard = 0;
    while (guard < 10000) {
      const open = findVoiceNoteByLocalId(localId);
      if (open == null) break;
      if (history && (open.phase == "recording" || open.localId == uploadLocalId || (protectedLocalId.length > 0 && open.localId == protectedLocalId))) {
        break;
      }
      if (!history && backfill && (open.phase == "recording" || open.phase == "paused" || open.localId == uploadLocalId)) {
        break;
      }
      let pending: VoiceNoteSegmentRecord | null = null;
      for (let i = 0; i < open.segments.length; i++) {
        const row = open.segments[i];
        if (segmentSkipped(skipped, row.segmentIndex)) continue;
        if (history) {
          if (!historySegmentNeedsUpload(row)) continue;
        } else if (!segmentCanUpload(row)) {
          continue;
        }
        pending = row;
        break;
      }
      if (pending == null) {
        if (history) {
          const latest = findVoiceNoteByLocalId(localId);
          if (latest != null && allSegmentsUploaded(latest)) {
            await completeRecord(latest);
          } else if (latest != null && !historyNoteStillUploading(latest) && latest.phase != "recording" && latest.phase != "paused") {
            latest.phase = "failed";
            latest.awaitComplete = false;
            if (latest.error.length == 0) latest.error = "有录音分段上传失败";
            touch(latest);
          }
        } else if (open.awaitComplete && open.phase != "recording" && open.phase != "paused") {
          if (allSegmentsUploaded(open)) {
            await completeRecord(open);
          } else {
            open.phase = "failed";
            open.awaitComplete = false;
            if (open.error.length == 0) open.error = "有录音分段上传失败";
            touch(open);
          }
        }
        break;
      }
      guard = guard + 1;
      const sessionId = open.localId;
      const missingPath = pending.filePath;
      let gate = "missing";
      let sealResult = "";
      // #ifdef APP
      gate = await segmentUploadReady(missingPath);
      if (gate == "unsealed") {
        sealResult = await sealUnfinishedM4a(missingPath);
        if (sealResult == "1") {
          gate = "ready";
        }
        // #ifdef APP-ANDROID || APP-HARMONY
        // 当前基座还没有补封口。划掉任务时 stop() 已经写过 moov，不要因此收成失败。
        if (sealResult == "0") {
          gate = "ready";
        }
        // #endif
      }
      // #endif
      if (sealResult == "0:nomdat") {
        const live = findVoiceNoteByLocalId(sessionId);
        if (live != null && (live.phase == "recording" || live.phase == "paused") && live.openSegmentPath == missingPath) {
          skipped.push(pending.segmentIndex);
          continue;
        }
        await unlinkVoiceFile(missingPath);
        const left = removeMissingSegment(sessionId, pending.segmentIndex);
        const current = left != null ? left : findVoiceNoteByLocalId(sessionId);
        if (current != null && current.openSegmentPath == missingPath) {
          current.openSegmentPath = "";
          touch(current);
        }
        pushVoiceNoteDebug("录音", "没有音频数据，已删除");
        if (current != null && current.segments.length <= 0 && current.phase != "recording" && current.phase != "paused") {
          const noteId = current.noteId;
          current.phase = "discarded";
          touch(current);
          deleteVoiceNote(current.localId);
          if (noteId.length > 0) {
            void deleteNoteQuiet(noteId);
          }
          break;
        }
        continue;
      }
      // #ifndef APP
      if (await segmentFileExists(missingPath)) {
        gate = "ready";
      }
      // #endif
      if (gate != "ready") {
        // 还没封口的文件留在记录里，下次再补 moov。删掉记录这段就找不回来了。
        if (gate == "unsealed") {
          skipped.push(pending.segmentIndex);
          continue;
        }
        const left = removeMissingSegment(sessionId, pending.segmentIndex);
        if (left != null && left.segments.length == 0 && left.awaitComplete && left.phase != "recording" && left.phase != "paused") {
          left.phase = "failed";
          left.awaitComplete = false;
          left.error = gate == "unsealed" ? "录音文件未封口" : "录音文件已删除";
          touch(left);
          break;
        }
        continue;
      }
      let ready: VoiceNoteRecord | null = null;
      try {
        ready = await ensureNoteId(sessionId);
      } catch (e) {
        const message = `${e}`;
        rememberCreateError(sessionId, message);
        break;
      }
      if (ready == null || ready.noteId.length == 0) {
        break;
      }
      const segmentIndex = pending.segmentIndex;
      const filePath = pending.filePath;
      const durationMs = pending.durationMs;
      const attempts = pending.uploadAttempts + 1;
      const marked = writeSegmentUpload(sessionId, segmentIndex, "uploading", "", "", attempts);
      if (marked == null) break;
      try {
        const segmentId = await apiVoiceNoteUploadSegment(
          ready.noteId,
          filePath,
          segmentIndex,
          durationMs,
        );
        writeSegmentUpload(sessionId, segmentIndex, "uploaded", segmentId, "", attempts);
      } catch (e) {
        writeSegmentUpload(sessionId, segmentIndex, "failed", "", `${e}`, attempts);
        if (history || backfill || attempts >= maxSegmentUploadAttempts) {
          skipped.push(segmentIndex);
        }
      }
    }
  } finally {
    if (history) {
      forgetHistoryBackfill(localId);
    } else if (backfill && ownsGate) {
      markBackfillRunning(false);
      backfillRunning = false;
      activeBackfillLocalId = "";
    } else if (!backfill) {
      uploadRunning = false;
      uploadLocalId = "";
      if (uploadRerunLocalId.length > 0) {
        const again = uploadRerunLocalId;
        uploadRerunLocalId = "";
        void pumpQueue(again, false);
      }
    }
  }
}

/** 补传总开关。正在补传，或距上次开始不满 2 分钟，这一轮都不开。 */
function backfillBlocked(gate: VoiceNoteBackfillGate): boolean {
  if (gate.catchingUp) return true;
  if (gate.backfillStartedAt <= 0) return false;
  return Date.now() - gate.backfillStartedAt < backfillGapMs;
}

function markBackfillRunning(running: boolean): void {
  const gate = loadBackfillGate();
  if (gate.catchingUp == running) return;
  gate.catchingUp = running;
  saveBackfillGate(gate);
}

/** 进程已不在补传。清掉上次异常退出留下的正在补传标记，保留开始时间。 */
function clearStaleBackfillRunning(): void {
  if (backfillRunning) return;
  markBackfillRunning(false);
}

function findVoiceNoteByNoteId(noteId: string): VoiceNoteRecord | null {
  if (noteId.length == 0) return null;
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].noteId == noteId) return rows[i];
  }
  return null;
}

function noteHasPendingUpload(record: VoiceNoteRecord): boolean {
  for (let i = 0; i < record.segments.length; i++) {
    if (segmentCanUpload(record.segments[i])) return true;
  }
  return false;
}

/** 没收成一段的文件还在 openSegmentPath。补传先纳入队列，发现没封口再补 moov。 */
function hasUnstagedOpenFile(record: VoiceNoteRecord): boolean {
  // #ifdef APP
  if (record.phase == "recording" || record.phase == "paused") return false;
  return record.openSegmentPath.length > 0;
  // #endif
  // #ifndef APP
  return false;
  // #endif
}

function historyNoteNeedsUpload(record: VoiceNoteRecord): boolean {
  if (hasUnstagedOpenFile(record)) return true;
  for (let i = 0; i < record.segments.length; i++) {
    if (historySegmentNeedsUpload(record.segments[i])) return true;
  }
  return false;
}

/**
 * 补传前把还没收成一段的文件放进队列。这段可能没有 moov，上传循环里会先封口。
 * 正在录或已暂停的文件还在写，不能在这里封。
 */
async function stageOpenFileForUpload(localId: string): Promise<void> {
  // #ifdef APP
  const record = findVoiceNoteByLocalId(localId);
  if (record == null) return;
  if (record.phase == "recording" || record.phase == "paused") return;
  const path = record.openSegmentPath;
  if (path.length == 0) return;
  let listed = false;
  for (let i = 0; i < record.segments.length; i++) {
    if (record.segments[i].filePath == path) listed = true;
  }
  if (!listed) {
    const kept = new VoiceNoteSegmentRecord();
    kept.segmentIndex = record.openSegmentIndex;
    kept.filePath = path;
    let durationMs = record.openElapsedMs;
    if (durationMs <= 0) {
      const size = await segmentFileSize(path);
      if (size > 8) durationMs = size / 8;
    }
    kept.durationMs = durationMs;
    kept.uploadStatus = "pending";
    record.segments.push(kept);
    record.openSegmentIndex = record.openSegmentIndex + 1;
  }
  record.openSegmentPath = "";
  record.awaitComplete = true;
  if (record.phase == "failed" || record.phase == "stopped") {
    record.phase = "uploading";
  }
  record.error = "";
  touch(record);
  // #endif
}

function historyNoteStillUploading(record: VoiceNoteRecord): boolean {
  for (let i = 0; i < record.segments.length; i++) {
    if (record.segments[i].uploadStatus == "uploading") return true;
  }
  return false;
}

function historyBackfillBusy(localId: string): boolean {
  for (let i = 0; i < historyBackfillLocalIds.length; i++) {
    if (historyBackfillLocalIds[i] == localId) return true;
  }
  return false;
}

function rememberHistoryBackfill(localId: string): void {
  historyBackfillLocalIds.push(localId);
}

function forgetHistoryBackfill(localId: string): void {
  const next: string[] = [];
  for (let i = 0; i < historyBackfillLocalIds.length; i++) {
    if (historyBackfillLocalIds[i] != localId) next.push(historyBackfillLocalIds[i]);
  }
  historyBackfillLocalIds = next;
}

/**
 * 历史列表里已加载、且状态是上传中的某一条。
 * 只用 noteId 找到本地那一条的文件。正在上传或已经成功的分段跳过。
 * 失败和其他状态才传。不看 5 分钟间隔。
 * 面板上这一次不补：录音中，或播放时已经暂停。其他录音的补传不改这一次。
 * 全部分段补成功后收尾。转写和文档是否成功不在这里跟进。
 */
export function backfillVoiceNoteByNoteId(noteId: string): void {
  if (noteId.length == 0) return;
  const recording = activeRecord();
  if (recording != null && recording.noteId == noteId) return;
  const target = findVoiceNoteByNoteId(noteId);
  if (target == null) return;
  if (target.phase == "recording") return;
  const panel = panelVoiceNote();
  if (panel != null && panel.localId == target.localId) return;
  if (target.localId == uploadLocalId) return;
  if (backfillRunning && target.localId == activeBackfillLocalId) return;
  if (historyBackfillBusy(target.localId)) return;
  if (!historyNoteNeedsUpload(target)) {
    if (allSegmentsUploaded(target)) {
      void completeRecord(target);
    }
    return;
  }
  void pumpQueue(target.localId, false, true);
}

async function completeRecord(record: VoiceNoteRecord): Promise<void> {
  if (record.phase == "recording" || record.phase == "paused") {
    return;
  }
  if (record.noteId.length == 0) {
    return;
  }
  const total = record.segments.length;
  if (total <= 0 || !allSegmentsUploaded(record)) {
    record.phase = "failed";
    if (total <= 0) {
      record.error = "没有可上传的录音";
    } else if (record.error.length == 0) {
      record.error = "有录音分段上传失败";
    }
    record.awaitComplete = false;
    touch(record);
    return;
  }
  record.phase = "uploading";
  touch(record);
  try {
    await apiVoiceNoteComplete(record.noteId, total, true);
    record.phase = "processing";
    record.awaitComplete = false;
    record.error = "";
    touch(record);
  } catch (e) {
    record.phase = "failed";
    record.error = `${e}`;
    touch(record);
  }
}

/** 本地列表只留未成功的录音。已经标成成功的旧记录也从缓存删掉。 */
function dropStoredSuccessNotes(): void {
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].phase == "success") {
      deleteVoiceNoteFiles(rows[i]);
      deleteVoiceNote(rows[i].localId);
    }
  }
}

/** 这条不参与补传：正在录、已暂停，或就是面板上这一次。 */
function backfillSkips(record: VoiceNoteRecord): boolean {
  if (record.phase == "recording" || record.phase == "paused") return true;
  if (record.localId.length == 0 || record.localId == uploadLocalId) return true;
  const panel = panelVoiceNote();
  if (panel != null && panel.localId == record.localId) return true;
  return false;
}

/** 补传这一轮：还有分段没传完的，以及分段已全部上传、可以移出列表的。正在录、已暂停、面板上这一次不放进来。 */
function backfillPassLocalIds(): string[] {
  const panel = panelVoiceNote();
  const panelId = panel != null ? panel.localId : "";
  const rows = loadVoiceNotes();
  const ids: string[] = [];
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    if (row.phase == "recording" || row.phase == "paused") continue;
    if (row.localId.length == 0 || row.localId == uploadLocalId) continue;
    if (panelId.length > 0 && row.localId == panelId) continue;
    if (row.phase != "stopped" && row.phase != "uploading" && row.phase != "processing" && row.phase != "failed") {
      continue;
    }
    if (allSegmentsUploaded(row)) {
      ids.push(row.localId);
      continue;
    }
    let picked = false;
    for (let s = 0; s < row.segments.length; s++) {
      if (segmentCanUpload(row.segments[s])) {
        ids.push(row.localId);
        picked = true;
        break;
      }
    }
    if (!picked && hasUnstagedOpenFile(row)) {
      ids.push(row.localId);
    }
  }
  return ids;
}

async function runBackfillPass(ids: string[]): Promise<void> {
  markBackfillRunning(true);
  try {
    for (let i = 0; i < ids.length; i++) {
      const localId = ids[i];
      const open = findVoiceNoteByLocalId(localId);
      if (open == null) continue;
      if (backfillSkips(open)) continue;
      let needsUpload = hasUnstagedOpenFile(open);
      for (let s = 0; s < open.segments.length; s++) {
        if (segmentCanUpload(open.segments[s])) {
          needsUpload = true;
          break;
        }
      }
      if (needsUpload) {
        await pumpQueue(localId, true, false, false);
      } else if (open.awaitComplete && open.noteId.length > 0 && allSegmentsUploaded(open)) {
        await completeRecord(open);
      }
      const latest = findVoiceNoteByLocalId(localId);
      if (latest != null && !backfillSkips(latest) && allSegmentsUploaded(latest)) {
        deleteVoiceNoteFiles(latest);
        deleteVoiceNote(latest.localId);
      }
    }
  } finally {
    backfillRunning = false;
    activeBackfillLocalId = "";
    markBackfillRunning(false);
  }
}

/**
 * 只在点击开始录音后调用。上一轮还没结束，或距上次开始不满 2 分钟，都跳过。
 * 只补还有分段没上传成功的会话。传完就从补传列表去掉，不再查转写，也不为转写或文档失败重试。
 */
function startBackfill(): void {
  if (backfillRunning) return;
  clearStaleBackfillRunning();
  const gate = loadBackfillGate();
  if (backfillBlocked(gate)) return;
  const ids = backfillPassLocalIds();
  if (ids.length == 0) return;
  gate.catchingUp = true;
  gate.backfillStartedAt = Date.now();
  saveBackfillGate(gate);
  backfillRunning = true;
  void runBackfillPass(ids);
}

/** 录音中的输入音量，0 到 100。没有采集器时为 0。 */
export function readVoiceNoteInputLevel(): number {
  // #ifdef APP
  if (m4aRecorder == null) {
    return 0;
  }
  try {
    return m4aRecorder!.takeLevel();
  } catch (_e) {
    return 0;
  }
  // #endif
  // #ifndef APP
  return 0;
  // #endif
}

/** 页面展示用：还没点完成的这一次录音。完成后的记录留在缓存里，面板不再接着显示。 */
export function getPanelVoiceNote(): VoiceNoteRecord | null {
  return panelVoiceNote();
}

export function listCachedVoiceNotes(): VoiceNoteRecord[] {
  return loadVoiceNotes();
}

function findPausedVoiceNote(): VoiceNoteRecord | null {
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].phase == "paused") return rows[i];
  }
  return null;
}

/** 创建服务端笔记。失败只记在会话上，不改录音阶段，也不挡住计时。 */
async function bindVoiceNoteId(localId: string): Promise<void> {
  const current = findVoiceNoteByLocalId(localId);
  if (current == null || current.phase == "discarded") {
    return;
  }
  try {
    await ensureNoteId(localId);
  } catch (e) {
    rememberCreateError(localId, `${e}`);
  }
}

/** 原生录音已经在写之后才创建笔记。已有 noteId、未在录、或会话已结束时不请求。 */
function bindNoteAfterCapture(localId: string): void {
  if (!captureAlive) return;
  const latest = findVoiceNoteByLocalId(localId);
  if (latest == null) return;
  if (latest.phase != "recording") return;
  if (latest.noteId.length > 0) return;
  void bindVoiceNoteId(localId);
}

/** 暂停后的同一条笔记接着录，不新建会话，也不新开文件。 */
async function resumePausedNote(record: VoiceNoteRecord): Promise<void> {
  bindRecorder();
  record.phase = "recording";
  record.segmentStartedAt = Date.now();
  record.awaitComplete = false;
  record.heldByCall = false;
  record.error = "";
  saveRecordQuiet(record);
  stopIntent = "";
  ensureTicker();
  // #ifdef APP
  if (m4aRecorder != null && record.openSegmentPath.length > 0) {
    let resumed = "0";
    try {
      resumed = await m4aRecorder!.resume();
    } catch (e) {
      console.warn("[voice-note] m4a resume failed " + e);
      resumed = "0";
    }
    if (resumed == "1") {
      markCaptureRunning(record.localId);
      pushVoiceNoteDebug("录音", "继续写入当前文件");
      armCaptureSideEffects(record.localId);
      return;
    }
  }
  // #endif
  pushVoiceNoteDebug("录音", "继续录音");
  await startRecorder();
}

function releaseRotateIfRecording(): void {
  const record = activeRecord();
  if (record != null && record.phase == "recording") {
    deferRotate = false;
  }
}

/** 开始一轮录音。已暂停的会话会接着录。调用前页面需已拿到麦克风权限。
 *  先让原生录音器写文件。创建笔记、上传、转写、补传都在开录成功之后，失败也不停录音。 */
export async function startVoiceNote(): Promise<void> {
  if (captureStarting) return;
  const existing = activeRecord();
  if (existing != null && captureAlive) return;
  deferRotate = true;
  captureStarting = true;
  try {
    if (existing != null) {
      await resumePausedNote(existing);
    } else {
      const paused = findPausedVoiceNote();
      if (paused != null) {
        await resumePausedNote(paused);
      } else {
        bindRecorder();
        const now = Date.now();
        const record = new VoiceNoteRecord();
        record.localId = `${now}`;
        record.phase = "recording";
        record.segmentStartedAt = now;
        record.openSegmentIndex = 0;
        saveRecordQuiet(record);
        stopIntent = "";
        ensureTicker();
        await startRecorder();
      }
    }
    try {
      startBackfill();
    } catch (e) {
      console.warn("[voice-note] backfill skipped " + e);
    }
  } catch (e) {
    console.warn("[voice-note] start recording failed " + e);
    if (!captureAlive) {
      abandonUnstartedRecording("");
    }
  } finally {
    captureStarting = false;
    releaseRotateIfRecording();
  }
}

/**
 * 暂停采集。App 不结束当前文件，也不上传。
 * 满 1 小时切段，或点完成，才会落盘并上传。
 */
function newestSegmentPath(record: VoiceNoteRecord): string {
  for (let i = record.segments.length - 1; i >= 0; i--) {
    if (record.segments[i].filePath.length > 0) {
      return record.segments[i].filePath;
    }
  }
  return "";
}

async function pauseActiveRecorder(record: VoiceNoteRecord): Promise<void> {
  if (sessionEnding) {
    stopActiveRecorder("finish");
    return;
  }
  // #ifdef APP
  if (recorderBusy) {
    pauseAfterRotate = true;
    return;
  }
  if (m4aRecorder != null && record.openSegmentPath.length > 0) {
    recorderBusy = true;
    let paused = "0";
    try {
      paused = await m4aRecorder!.pause();
    } catch (_e) {
      paused = "0";
    }
    recorderBusy = false;
    if (sessionEnding || queuedIntent == "finish") {
      queuedIntent = "";
      stopActiveRecorder("finish");
      return;
    }
    if (paused == "2") {
      currentSegmentPath = "";
      closedDurationOverride = m4aRecorder!.takeClosedDurationMs();
      const sealedPath = record.openSegmentPath;
      if (sealedPath.length > 0) {
        await closeSegment(record, sealedPath);
      }
      record.phase = "paused";
      record.awaitComplete = false;
      record.heldByCall = pausedByInterruption;
      record.openSegmentPath = "";
      record.segmentStartedAt = 0;
      touch(record);
      pushVoiceNoteDebug("录音", "暂停接口不可用，当前段已封口");
      // #ifdef APP-HARMONY
      finishHarmonyInterruptPause();
      // #endif
      return;
    }
    if (paused == "1") {
      pushVoiceNoteDebug("录音", "暂停，当前文件不落盘");
      const latest = noteByLocalId(record.localId);
      const target = latest != null ? latest : record;
      freezeOpenSegment(target);
      target.phase = "paused";
      target.awaitComplete = false;
      target.heldByCall = pausedByInterruption;
      touch(target);
      // #ifdef APP-HARMONY
      // 用户自己暂停才停长时任务。通话打断要留住进程，挂断后才能接着录。
      finishHarmonyInterruptPause();
      // #endif
      return;
    }
    pushVoiceNoteDebug("录音", "暂停未停住采集，当前段不落盘");
    return;
  }
  // #endif
  if (sessionEnding) {
    stopActiveRecorder("finish");
    return;
  }
  // 停不住采集时也不要 stop。stop 会把未满分段的文件落盘并上传。
  pushVoiceNoteDebug("录音", "暂停未停住采集，当前段不落盘");
}

/** 鸿蒙通话中 pause 会失败，当前段已经封口。这里新开下一段；麦克风还被占用时安静失败，不弹错、不丢掉这次录音。 */
async function openSealedInterruptSegment(record: VoiceNoteRecord): Promise<boolean> {
  // #ifdef APP
  bindRecorder();
  if (m4aRecorder == null) {
    m4aRecorder = new VoiceNoteM4aRecorder();
  }
  let path = "";
  try {
    path = await m4aRecorder!.restart(record.localId, segmentStampName(record.openSegmentIndex));
  } catch (e) {
    console.warn("[voice-note] m4a restart after interruption failed " + e);
    path = "";
  }
  if (path.length == 0) {
    if (!interruptRetryNoted) {
      interruptRetryNoted = true;
      pushVoiceNoteDebug("录音", "下一段还没打开，等麦克风空出来再试");
    }
    return false;
  }
  interruptRetryNoted = false;
  currentSegmentPath = path;
  record.phase = "recording";
  record.openSegmentPath = path;
  record.segmentStartedAt = Date.now();
  record.awaitComplete = false;
  record.heldByCall = false;
  record.error = "";
  markCaptureRunning(record.localId);
  saveRecordQuiet(record);
  stopIntent = "";
  ensureTicker();
  pushVoiceNoteDebug("录音", "继续录音");
  armCaptureSideEffects(record.localId);
  return true;
  // #endif
  // #ifndef APP
  return false;
  // #endif
}

function interruptRetryDue(): boolean {
  const now = Date.now();
  if (interruptRetryAt > 0 && now - interruptRetryAt < 1500) {
    return false;
  }
  interruptRetryAt = now;
  return true;
}

/** 其他应用占用麦克风或播放语音时暂停，结束后再接着录。用户自己点的暂停不会自动恢复。 */
async function resumeInterruptedNote(record: VoiceNoteRecord): Promise<boolean> {
  // #ifdef APP
  if (record.openSegmentPath.length > 0 && m4aRecorder != null) {
    let resumed = "0";
    try {
      resumed = await m4aRecorder!.resume();
    } catch (e) {
      console.warn("[voice-note] m4a resume after interruption failed " + e);
      resumed = "0";
    }
    if (resumed == "1") {
      await resumePausedNote(record);
      return captureAlive;
    }
    // 文件还在，只是麦克风被通话占着。不要丢掉采集器再新建，后台创建会被拒绝。
    // #ifdef APP-HARMONY
    return false;
    // #endif

    // iOS 电话结束后继续写同一个文件。开新文件会把没封口的这一段丢掉。
    // #ifdef APP-IOS
    return false;
    // #endif
  }
  // 鸿蒙封口之后文件已经关掉，resume 会失败。改成新开一段。
  return await openSealedInterruptSegment(record);
  // #endif
  // #ifndef APP
  await resumePausedNote(record);
  return captureAlive;
  // #endif
}

/** 录音面板还在时把中断监听拉起来。退到通话界面后定时器可能停住，回到面板要继续试。 */
export function keepVoiceNoteInterruptionWatch(): void {
  if (!pausedByInterruption) {
    return;
  }
  ensureInterruptWatch();
}

async function pollVoiceInterruption(): Promise<void> {
  // #ifdef APP
  if (interruptBusy) {
    return;
  }
  if (m4aRecorder == null) {
    if (!pausedByInterruption) {
      return;
    }
    m4aRecorder = new VoiceNoteM4aRecorder();
  }
  interruptBusy = true;
  try {
    let event = "";
    try {
      event = m4aRecorder!.takeInterruption();
    } catch (_e) {
      return;
    }
    const kind = interruptionKind(event);
    if (kind == "began") {
      const record = activeRecord();
      if (record == null) {
        return;
      }
      const at = interruptionAt(event);
      if (at > 0) {
        freezeOpenSegmentAt(record, at);
      }
      pausedByInterruption = true;
      pushVoiceNoteDebug("录音", "其他应用占用音频，暂停");
      ensureInterruptWatch();
      await pauseActiveRecorder(record);
      return;
    }
    if (!pausedByInterruption) {
      return;
    }
    let paused = findPausedVoiceNote();
    if (paused == null) {
      paused = activeRecord();
    }
    if (paused == null) {
      return;
    }
    // 通话结束后系统经常仍报着电话场景，也不会再发 ended。文件还在就隔一会儿 resume 一次。
    let retryOpen = false;
    // #ifdef APP-IOS || APP-HARMONY
    retryOpen = event != "ended" && paused.openSegmentPath.length > 0 && interruptRetryDue();
    // #endif
    const retrySealed = event != "ended" && paused.openSegmentPath.length == 0 && interruptRetryDue();
    if (event != "ended" && !retrySealed && !retryOpen) {
      return;
    }
    const resumed = await resumeInterruptedNote(paused);
    if (!resumed) {
      return;
    }
    pausedByInterruption = false;
    stopInterruptWatch();
    pushVoiceNoteDebug("录音", "其他应用已结束，继续录音");
  } finally {
    interruptBusy = false;
  }
  // #endif
}

onInterruptTick = (): void => {
  void pollVoiceInterruption();
};

/**
 * 播放前如果正在录音，只暂停采集，不落盘、不上传。
 * 正在写、还没封口的文件不能播。没有已落盘分段时不暂停，直接返回空字符串。
 * @returns 最近一段已落盘文件的路径。没有则空字符串
 */
export async function playableLocalVoiceFile(): Promise<string> {
  const recording = activeRecord();
  const current = recording != null ? recording : findOpenVoiceNote();
  if (current == null || newestSegmentPath(current).length == 0) {
    return "";
  }
  if (recording != null) {
    pausedByInterruption = false;
    stopInterruptWatch();
    await pauseActiveRecorder(recording);
  }
  const record = findOpenVoiceNote();
  if (record == null) {
    return newestSegmentPath(current);
  }
  return newestSegmentPath(record);
}

export function stopVoiceNote(): void {
  pausedByInterruption = false;
  stopInterruptWatch();
  deferRotate = true;
  const record = activeRecord();
  if (record == null) return;
  void pauseActiveRecorder(record);
}

/** 重录：停掉当前会话并删掉服务端笔记。 */
export function discardVoiceNote(): void {
  const record = findOpenVoiceNote();
  if (record == null) return;
  sessionEnding = false;
  endingLocalId = "";
  if (record.phase == "recording" || record.phase == "paused") {
    stopActiveRecorder("discard");
    return;
  }
  record.phase = "discarded";
  touch(record);
  deleteVoiceNote(record.localId);
  const noteId = record.noteId;
  if (noteId.length > 0) {
    void deleteNoteQuiet(noteId);
  }
}

async function deleteNoteQuiet(noteId: string): Promise<void> {
  try {
    await apiVoiceNoteDelete(noteId, true);
  } catch (_e) {
    // 本地已放弃。未收尾的服务端会话会在 7 天后回收。
  }
}

/** 点完成即结束本次录音。录音中、暂停中、正在播放，都把当前文件落盘并上传。 */
export function finishVoiceNote(): void {
  const record = findOpenVoiceNote();
  if (record == null) {
    return;
  }
  if (record.phase == "processing" || record.phase == "success" || record.phase == "discarded") return;
  if (sessionEnding) {
    return;
  }
  sessionEnding = true;
  endingLocalId = record.localId;
  const holdingFile = record.phase == "recording" || record.phase == "paused" || record.openSegmentPath.length > 0 || captureAlive;
  // #ifdef APP
  if (recorderBusy) {
    queuedIntent = "finish";
    return;
  }
  // #endif
  if (holdingFile) {
    stopActiveRecorder("finish");
    return;
  }
  sessionEnding = false;
  endingLocalId = "";
  record.awaitComplete = true;
  record.phase = "uploading";
  record.segmentStartedAt = 0;
  record.openSegmentPath = "";
  touch(record);
  endBackground();
  stopTicker();
  releaseRecorderCallbacks();
  void pumpQueue(record.localId, false);
}

let recoveringAbandoned = false;

/** 本进程里没有采集器时，缓存里仍是录音中或暂停的那一次。说明上次是直接退出的。 */
function findInterruptedVoiceNote(): VoiceNoteRecord | null {
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].phase == "recording") return rows[i];
  }
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].phase == "paused") return rows[i];
  }
  return null;
}

/** 直接退出后的这一次按完成结束：留下已落盘分段，等下次点开始录音再补传。面板不再显示继续。 */
function markInterruptedComplete(record: VoiceNoteRecord): void {
  record.phase = "uploading";
  record.awaitComplete = true;
  record.openSegmentPath = "";
  record.segmentStartedAt = 0;
  record.openElapsedMs = 0;
  touch(record);
  endBackground();
  stopTicker();
  releaseRecorderCallbacks();
  pushVoiceNoteDebug("录音", "进程已退出，本次按完成结束");
}

/** iOS 上这次还在录，或是被电话打断后进程被杀掉。回到前台要接着录，不能收成失败。 */
function shouldContinueInterrupted(record: VoiceNoteRecord): boolean {
  // #ifdef APP-IOS
  if (record.phase == "recording") return true;
  if (record.phase == "paused" && record.heldByCall) return true;
  // #endif
  return false;
}

/**
 * 电话会把进程杀掉。下次进来先停住计时，旧文件能封口就收成一段，麦克风空出来再接着录。
 */
async function continueRecordingAfterRelaunch(record: VoiceNoteRecord): Promise<void> {
  // #ifdef APP-IOS
  try {
    const localId = record.localId;
    pausedByInterruption = true;
    const path = record.openSegmentPath;
    if (record.segmentStartedAt > 0) {
      const size = path.length > 0 ? await segmentFileSize(path) : 0;
      let audioMs = record.openElapsedMs;
      if (size > 8) {
        const estimated = size / 8;
        if (estimated > audioMs) {
          audioMs = estimated;
        }
      }
      record.openElapsedMs = audioMs;
      record.segmentStartedAt = 0;
    }
    record.phase = "paused";
    record.awaitComplete = false;
    record.heldByCall = true;
    touch(record);
    pushVoiceNoteDebug("录音", "进程已重启，通话结束后继续录音");
    if (path.length > 0) {
      const closed = await closeSegment(record, path);
      const latest = findVoiceNoteByLocalId(localId);
      if (latest != null && closed < 0 && latest.openSegmentPath == path) {
        let listed = false;
        for (let i = 0; i < latest.segments.length; i++) {
          if (latest.segments[i].filePath == path) {
            listed = true;
          }
        }
        if (!listed) {
          const kept = new VoiceNoteSegmentRecord();
          kept.segmentIndex = latest.openSegmentIndex;
          kept.filePath = path;
          kept.durationMs = latest.openElapsedMs;
          kept.uploadStatus = "pending";
          latest.segments.push(kept);
          latest.openSegmentIndex = latest.openSegmentIndex + 1;
        }
        latest.accumulatedMs = latest.accumulatedMs + latest.openElapsedMs;
        latest.openElapsedMs = 0;
        latest.openSegmentPath = "";
        latest.phase = "paused";
        latest.heldByCall = true;
        latest.awaitComplete = false;
        latest.error = "";
        touch(latest);
      }
    }
    const paused = findVoiceNoteByLocalId(localId);
    if (paused == null) return;
    if (m4aRecorder == null) {
      m4aRecorder = new VoiceNoteM4aRecorder();
    }
    ensureInterruptWatch();
    const resumed = await resumeInterruptedNote(paused);
    if (!resumed) {
      pushVoiceNoteDebug("录音", "通话还在，挂断后继续录音");
      return;
    }
    pausedByInterruption = false;
    pushVoiceNoteDebug("录音", "回到应用，继续录音");
  } finally {
    recoveringAbandoned = false;
  }
  // #endif
  // #ifndef APP-IOS
  recoveringAbandoned = false;
  // #endif
}

/**
 * 进程被杀掉后，先给没封口的 m4a 补上 moov，再按完成结束并上传。
 * 文件里还有音频但暂时封不上时，保留本地记录和下次再试的路径，不删。
 */
async function recoverAbandonedRecording(): Promise<void> {
  try {
    const record = findInterruptedVoiceNote();
    if (record == null) return;
    const localId = record.localId;
    const path = record.openSegmentPath;
    if (path.length > 0) {
      await closeSegment(record, path);
    }
    const latest = findVoiceNoteByLocalId(localId);
    if (latest == null) return;
    if (latest.segments.length <= 0) {
      // #ifdef APP-IOS
      const keptPath = latest.openSegmentPath.length > 0 ? latest.openSegmentPath : path;
      const keptSize = keptPath.length > 0 ? await segmentFileSize(keptPath) : 0;
      if (keptSize > 0) {
        latest.openSegmentPath = keptPath;
        latest.phase = "failed";
        latest.awaitComplete = false;
        latest.error = "录音文件未封口";
        touch(latest);
        endBackground();
        stopTicker();
        releaseRecorderCallbacks();
        console.warn("[voice-note] m4a 仍未封口，保留本地记录");
        return;
      }
      // #endif
      const noteId = latest.noteId;
      latest.phase = "discarded";
      touch(latest);
      deleteVoiceNote(latest.localId);
      if (noteId.length > 0) {
        void deleteNoteQuiet(noteId);
      }
      endBackground();
      stopTicker();
      releaseRecorderCallbacks();
      return;
    }
    const pendingPath = latest.openSegmentPath;
    markInterruptedComplete(latest);
    if (pendingPath.length > 0) {
      const again = findVoiceNoteByLocalId(localId);
      if (again != null) {
        again.openSegmentPath = pendingPath;
        again.error = "录音文件未封口";
        touch(again);
      }
    }
    void pumpQueue(localId, false);
  } finally {
    recoveringAbandoned = false;
  }
}

/** 上次没封上的文件留在 openSegmentPath。再次进入时继续补封口，封好再上传。 */
async function sealLeftoverOpenFiles(): Promise<void> {
  // #ifdef APP-IOS
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    if (row.phase == "recording" || row.phase == "paused") continue;
    if (row.openSegmentPath.length == 0) continue;
    const path = row.openSegmentPath;
    const sealResult = await sealUnfinishedM4a(path);
    if (sealResult != "1") continue;
    const current = findVoiceNoteByLocalId(row.localId);
    if (current == null || current.openSegmentPath != path) continue;
    await closeSegment(current, path);
    const latest = findVoiceNoteByLocalId(row.localId);
    if (latest == null) continue;
    latest.phase = "uploading";
    latest.awaitComplete = true;
    latest.error = "";
    touch(latest);
    void pumpQueue(latest.localId, false);
  }
  // #endif
  return;
}

/** 刚退后台时申请短时保活。接通后再申请，已经过了系统允许的窗口。 */
export function voiceNoteOnAppHide(): void {
  // #ifdef APP-HARMONY
  if (!captureAlive && !pausedByInterruption) {
    return;
  }
  try {
    holdVoiceNoteCall();
  } catch (_eHold) {
  }
  // #endif
}

/**
 * 未封口判断曾经加在 Android、鸿蒙上，已经封口的文件被写成 phase=failed，complete 没发出去。
 * 下次进入时把这些文件收成一段并上传。
 */
async function uploadMistakenFailedNotes(): Promise<void> {
  // #ifdef APP-ANDROID || APP-HARMONY
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    if (row.phase != "failed") continue;
    if (row.error != "录音文件未封口" && row.error != "有录音分段上传失败") continue;
    const localId = row.localId;
    const path = row.openSegmentPath;
    if (path.length > 0) {
      await closeSegment(row, path);
    }
    const latest = findVoiceNoteByLocalId(localId);
    if (latest == null || latest.segments.length <= 0) continue;
    latest.phase = "uploading";
    latest.awaitComplete = true;
    latest.error = "";
    latest.openSegmentPath = "";
    touch(latest);
    void pumpQueue(localId, false);
  }
  // #endif
}

/** 回前台：本进程仍在录就继续计时和切段。从最近任务划掉或进程已被杀掉，则把这次按完成结束，不在这里上传。 */
export function voiceNoteOnAppShow(): void {
  void uploadMistakenFailedNotes();
  clearStaleBackfillRunning();
  dropStoredSuccessNotes();
  let taskRemoved = false;
  // #ifdef APP-ANDROID
  taskRemoved = consumeVoiceNoteTaskRemoved();
  // #endif
  const interrupted = findInterruptedVoiceNote();
  if (taskRemoved && interrupted != null && (captureAlive || stopIntent.length > 0)) {
    if (captureAlive && stopIntent.length == 0) {
      pushVoiceNoteDebug("录音", "从最近任务划掉，本次按完成结束");
      stopActiveRecorder("exit");
    }
    return;
  }
  const record = activeRecord();
  if (!captureAlive && stopIntent.length == 0 && interrupted != null) {
    // #ifdef APP-IOS
    if (pausedByInterruption) {
      ensureInterruptWatch();
      void pollVoiceInterruption();
      return;
    }
    if (shouldContinueInterrupted(interrupted)) {
      if (!recoveringAbandoned) {
        recoveringAbandoned = true;
        void continueRecordingAfterRelaunch(interrupted);
      }
      return;
    }
    // #endif
    if (!recoveringAbandoned) {
      recoveringAbandoned = true;
      void recoverAbandonedRecording();
    }
    return;
  }
  void sealLeftoverOpenFiles();
  if (captureAlive || pausedByInterruption) {
    ensureInterruptWatch();
    void pollVoiceInterruption();
  }
  if (record != null) {
    beginBackground();
    ensureTicker();
    const now = Date.now();
    if (openSegmentMs(record, now) >= segmentMs && stopIntent.length == 0) {
      deferRotate = true;
    }
  }
}

/** 退出程序：录音中或暂停中的这一次按完成结束。来得及停录音器就封口，上传留给下次开始录音的补传。 */
export function voiceNoteOnAppExit(): void {
  const interrupted = findInterruptedVoiceNote();
  if (interrupted == null) return;
  if (captureAlive || interrupted.openSegmentPath.length > 0) {
    pushVoiceNoteDebug("录音", "退出程序，本次按完成结束");
    stopActiveRecorder("exit");
    return;
  }
  if (interrupted.segments.length <= 0) return;
  markInterruptedComplete(interrupted);
}
