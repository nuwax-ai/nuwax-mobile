import { RequestResponse } from "@/types/interfaces/request";
import {
  MySubscriptionData,
  CreditSummaryInfo,
  CreditPackageInfo,
  CreditBatchItem,
  SystemSubscriptionPlan,
  CashierInfo,
  CreditRecordInfo,
  MinipayResult,
  SettlementStatusInfo,
  CreateSubscriptionOrderRequest,
  CreateCreditOrderRequest,
  PayMinipayRequest,
  GetSettlementStatusRequest,
  BillOrderPageData,
} from "@/subpackages/types/interfaces/subscription";
import request from "@/servers/useRequest";

export async function apiGetMySubscription(params: Record<string, string>): Promise<RequestResponse<MySubscriptionData>> {
  const res = await request<RequestResponse<MySubscriptionData>>({
    url: "/api/subscription/my",
    method: "GET",
    data: params,
  });
  return res as RequestResponse<MySubscriptionData>;
}

export async function apiGetCreditSummary(): Promise<RequestResponse<CreditSummaryInfo>> {
  const res = await request<RequestResponse<CreditSummaryInfo>>({
    url: "/api/credit/summary",
    method: "GET",
  });
  return res as RequestResponse<CreditSummaryInfo>;
}

export async function apiListSystemSubscriptionPlans(): Promise<RequestResponse<SystemSubscriptionPlan[]>> {
  const res = await request<RequestResponse<SystemSubscriptionPlan[]>>({
    url: "/api/subscription/system/plans",
    method: "GET",
  });
  return res as RequestResponse<SystemSubscriptionPlan[]>;
}

export async function apiListCreditPackages(): Promise<RequestResponse<CreditPackageInfo[]>> {
  const res = await request<RequestResponse<CreditPackageInfo[]>>({
    url: "/api/credit/package/list",
    method: "GET",
  });
  return res as RequestResponse<CreditPackageInfo[]>;
}

export async function apiCreateCreditOrder(data: CreateCreditOrderRequest): Promise<RequestResponse<any>> {
  const res = await request<RequestResponse<any>>({
    url: `/api/credit/order/create?packageId=${data.packageId}&payMode=${data.payMode}`,
    method: "POST",
  });
  return res as RequestResponse<any>;
}

export async function apiGetCreditBatches(params: Record<string, string>): Promise<RequestResponse<CreditBatchItem[]>> {
  const res = await request<RequestResponse<CreditBatchItem[]>>({
    url: "/api/credit/batches",
    method: "GET",
    data: params,
  });
  return res as RequestResponse<CreditBatchItem[]>;
}

export async function apiCreateSubscriptionOrder(data: CreateSubscriptionOrderRequest): Promise<RequestResponse<any>> {
  const res = await request<RequestResponse<any>>({
    url: `/api/subscription/order/create?planId=${data.planId}&payMode=${data.payMode}`,
    method: "POST",
  });
  return res as RequestResponse<any>;
}

export async function apiGetOrderCashier(orderId: number, returnUrl?: string): Promise<RequestResponse<CashierInfo>> {
  const data: Record<string, any> = { orderId };
  if (returnUrl != null) {
    data["returnUrl"] = returnUrl;
  }
  const res = await request<RequestResponse<CashierInfo>>({
    url: "/api/bill/order/pay/cashier",
    method: "GET",
    data,
  });
  return res as RequestResponse<CashierInfo>;
}

export async function apiGetCreditFlows(params: Record<string, any>): Promise<RequestResponse<CreditRecordInfo[]>> {
  const res = await request<RequestResponse<CreditRecordInfo[]>>({
    url: "/api/credit/flows",
    method: "GET",
    data: params,
  });
  return res as RequestResponse<CreditRecordInfo[]>;
}

