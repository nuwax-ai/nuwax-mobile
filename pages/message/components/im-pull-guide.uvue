<template>
  <!--
    伙伴页下拉提示条（scroll-view 自定义 refresher 插槽内容，微信下拉展示最近小程序的同款形态）：
    下拉时列表整体下移，这块区域从页头下方被「拉出来」——只有一句话「下拉进入{name}会话」。
    没到阈值松手 = 原生回弹（什么都不发生）；过了阈值松手 = 进默认智能体会话。
    ★slot 必须落在本组件根节点上（uni-refresh-box 同规约：部分平台不认外层传入的 slot）。
    ★高度与页面传入的 pullThreshold 对齐；文案由页面算好下发，
    本组件零业务、零定时器，只在 props 变化时重渲染。
  -->
  <view slot="refresher" class="im-pull-guide" :style="guideStyle">
    <text v-if="nameStart >= 0" class="im-pull-guide__line">
      <text class="im-pull-guide__context">{{ tipPrefix }}</text><text class="im-pull-guide__name">{{ name }}</text><text class="im-pull-guide__context">{{ tipSuffix }}</text>
    </text>
    <text v-else class="im-pull-guide__line im-pull-guide__context">{{ tip }}</text>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";

  const props = withDefaults(defineProps<{
    /** 提示语（页面算好的单句「下拉进入{name}会话」）。 */
    tip: string;
    /** 提示语中的智能体名称，用于从完整国际化文案中定位并单独着色。 */
    name: string;
    /** 与 scroll-view refresher-threshold 一致的提示区高度。 */
    heightPx: number;
  }>(), {
    tip: "",
    name: "",
    heightPx: 160,
  });

  const guideStyle = computed((): string => `height: ${props.heightPx}px;`);
  const nameStart = computed((): number => props.name.length > 0 ? props.tip.indexOf(props.name) : -1);
  const tipPrefix = computed((): string => nameStart.value >= 0 ? props.tip.substring(0, nameStart.value) : props.tip);
  const tipSuffix = computed((): string => nameStart.value >= 0 ? props.tip.substring(nameStart.value + props.name.length) : "");
</script>

<style lang="scss" scoped>
  .im-pull-guide {
    width: 100%;
    /* 高度由页面阈值传入：拉满阈值时提示条正好填满露出的空档。 */
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    /* 浅灰底：列表下移后露出的这块区域要读成「页面后面的一层」（微信下拉面板观感），
       纯白会与列表黏成一片、看不出是拉出来的。 */
    background-color: #f4f3fb;
  }

  .im-pull-guide__line {
    padding: 0 16px;
    font-size: 13px;
    line-height: 18px;
    text-align: center;
  }

  .im-pull-guide__context {
    color: #8f959e;
  }

  .im-pull-guide__name {
    color: #141416;
  }
</style>
