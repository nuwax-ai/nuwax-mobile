<template>
  <view class="provision-scan">
    <custom-nav-bar :title="t('Mobile.Provision.Scan.title')" :show-back="true" :has-safety-zone="true">
      <template #right>
        <text class="provision-scan__debug" @tap="goDebug">{{ t('Mobile.Provision.Scan.debug') }}</text>
      </template>
    </custom-nav-bar>

    <view class="provision-scan__body">
      <!-- 蓝牙/权限未就绪 -->
      <view v-if="!bleReady" class="provision-scan__panel">
        <text class="provision-scan__panel-text">{{ bleBlockText }}</text>
        <view class="provision-scan__btn" @tap="openBleSetting">
          <text class="provision-scan__btn-text">{{ bleBlockBtnText }}</text>
        </view>
      </view>

      <!-- 扫描中 / 结果 -->
      <template v-else>
        <view class="provision-scan__status">
          <text v-if="scanning" class="provision-scan__status-text">
            {{ t('Mobile.Provision.Scan.searching', toParams('seconds', countdown)) }}
          </text>
          <text v-else class="provision-scan__status-text">
            {{ t('Mobile.Provision.Scan.found', toParams('count', devices.length)) }}
          </text>
        </view>

        <!-- 设备列表 -->
        <scroll-view scroll-y class="provision-scan__list">
          <view
            v-for="(item, index) in devices"
            :key="item.deviceId"
            class="device-item"
            hover-class="device-item--hover"
            @tap="selectDevice(item)"
          >
            <view class="device-item__info">
              <text class="device-item__name">{{ item.name != '' ? item.name : item.deviceId }}</text>
              <text class="device-item__id">{{ item.deviceId }}</text>
            </view>
            <view class="device-item__rssi">
              <text class="device-item__rssi-text" :class="{ 'device-item__rssi-text--weak': item.rssi < -75 }">
                {{ item.rssi < -75 ? t('Mobile.Provision.Scan.signalWeak') : `${item.rssi}` }}
              </text>
            </view>
          </view>

          <!-- 空结果 -->
          <view v-if="!scanning && devices.length == 0" class="provision-scan__empty">
            <text class="provision-scan__empty-title">{{ t('Mobile.Provision.Scan.empty') }}</text>
            <text class="provision-scan__empty-tip">{{ t('Mobile.Provision.Scan.emptyTip') }}</text>
            <view class="provision-scan__btn" @tap="startScan">
              <text class="provision-scan__btn-text">{{ t('Mobile.Provision.Scan.rescan') }}</text>
            </view>
          </view>
        </scroll-view>
      </template>
    </view>
  </view>
</template>

<script setup lang="uts">
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { ref, computed, onUnmounted } from "vue";
  import { onLoad, onUnload } from "@dcloudio/uni-app";
  import { useI18n, toI18nParams } from "@/utils/i18n";
  import { useProvision } from "@/hooks/useProvision";
  import type { ProvisionTargetDevice } from "@/types/interfaces/provision";
  import { setProvisionDevice } from "@/utils/provisionSession";
  import { PROV_SCAN_TIMEOUT_MS } from "@/constants/provision.constants";

  const { t } = useI18n();

  const controller = useProvision();
  const devices = controller.scannedDevices;

  const scanning = ref<boolean>(false);
  const countdown = ref<number>(Math.floor(PROV_SCAN_TIMEOUT_MS / 1000));
  // 蓝牙环境（M2 接入真实权限检查；Mock 下默认可用）
  const bleReady = ref<boolean>(true);
  const bleBlockText = ref<string>("");
  const bleBlockBtnText = ref<string>("");

  let countdownTimer = 0;

  const toParams = (key: string, value: number): Map<string, string | number> => {
    const m = new Map<string, string | number>();
    m.set(key, value);
    return toI18nParams(m);
  };

  const startCountdown = () => {
    stopCountdown();
    countdown.value = Math.floor(PROV_SCAN_TIMEOUT_MS / 1000);
    countdownTimer = setInterval(() => {
      if (countdown.value > 0) {
        countdown.value -= 1;
      }
    }, 1000) as number;
  };
  const stopCountdown = () => {
    if (countdownTimer != 0) {
      clearInterval(countdownTimer);
      countdownTimer = 0;
    }
  };

  const startScan = async () => {
    scanning.value = true;
    startCountdown();
    await controller.startScan();
    // startScan 内部 15s 后自动 stopScan；此处监听扫描结束由 timeout 对齐
    setTimeout(() => {
      scanning.value = false;
      stopCountdown();
    }, PROV_SCAN_TIMEOUT_MS);
  };

  const selectDevice = (item: ProvisionTargetDevice) => {
    controller.stopScan();
    scanning.value = false;
    stopCountdown();
    setProvisionDevice(item);
    uni.navigateTo({ url: "/subpackages/pages/provision/provision-wifi/provision-wifi" });
  };

  const openBleSetting = () => {
    // M2：跳系统蓝牙设置/授权引导
  };

  const goDebug = () => {
    uni.navigateTo({ url: "/pages/test-provision/test-provision" });
  };

  onLoad(() => {
    startScan();
  });

  onUnload(() => {
    stopCountdown();
    controller.dispose();
  });

  onUnmounted(() => {
    stopCountdown();
  });
</script>

<style lang="scss" scoped>
  .provision-scan {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;

    &__debug {
      font-size: 26rpx;
      color: #5147ff;
      padding: 0 24rpx;
    }

    &__body {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    &__panel {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 60rpx;
    }

    &__panel-text {
      font-size: 30rpx;
      color: #666;
      text-align: center;
      margin-bottom: 40rpx;
    }

    &__status {
      padding: 32rpx;
    }

    &__status-text {
      font-size: 28rpx;
      color: #999;
    }

    &__list {
      flex: 1;
      padding: 0 32rpx;
    }

    &__empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 80rpx 40rpx;
    }

    &__empty-title {
      font-size: 32rpx;
      color: #333;
      font-weight: 500;
      margin-bottom: 16rpx;
    }

    &__empty-tip {
      font-size: 26rpx;
      color: #999;
      text-align: center;
      line-height: 1.6;
      margin-bottom: 40rpx;
    }

    &__btn {
      background-color: #5147ff;
      border-radius: 48rpx;
      padding: 24rpx 64rpx;
    }

    &__btn-text {
      color: #ffffff;
      font-size: 30rpx;
    }
  }

  .device-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #ffffff;
    border-radius: 20rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;

    &--hover {
      background-color: #f1f1f1;
    }

    &__info {
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    &__name {
      font-size: 32rpx;
      color: #333;
      font-weight: 500;
      margin-bottom: 8rpx;
    }

    &__id {
      font-size: 24rpx;
      color: #999;
    }

    &__rssi-text {
      font-size: 26rpx;
      color: #4cd964;

      &--weak {
        color: #f0ad4e;
      }
    }
  }
</style>
