<template>
  <uni-modal-popup
    ref="popupPreviewPage"
    :title="headerTitle"
    position="bottom"
    height="90%"
    :enable-swipe-close="false"
    @update-visible="updateVisible"
  >
    <!-- #ifdef H5 || WEB -->
    <iframe
      class="border-none h-full"
      ref="iframeRef"
      :src="iframeConfig.uri"
      @load="onIframeLoad"
    ></iframe>
    <!-- #endif -->
    <!-- #ifndef H5 || WEB -->
    <web-view
      v-if="iframeConfig.uri.length > 0"
      class="h-full"
      :src="iframeConfig.uri"
    ></web-view>
    <!-- #endif -->
  </uni-modal-popup>
</template>

<script setup lang="uts">
  // #ifdef H5 || WEB
  import TurndownService from "turndown"; // markdown转html
  // #endif
  import { ref, reactive, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import { apiAgentComponentPageResultUpdate } from "@/servers/agentDev";
  import { useI18n } from "@/utils/i18n";
  import { PreviewData, readPreviewData } from "./types";
  /**
   * 页面预览组件
   * 用于在弹窗中预览网页内容
   */

  // 预览页面弹窗（组件 ref，UTS 勿用带方法的 type 别名）
  const popupPreviewPage = ref<any | null>(null);
  // iframe引用（仅 H5 使用）
  const iframeRef = ref<any | null>(null);

  const emit = defineEmits(["update-visible"]);

  const updateVisible = (value: boolean) => {
    emit("update-visible", value);
  };

  // iframe配置
  const iframeConfig = reactive(new PreviewData());

  // 预览页面标题
  const headerTitle = ref<string>("");
  const { t } = useI18n();

  const applyPreviewData = (data: PreviewData): void => {
    iframeConfig.uri = data.uri;
    if (data.method != null) {
      iframeConfig.method = data.method;
    }
    if (data.data_type != null) {
      iframeConfig.data_type = data.data_type;
    }
    if (data.request_id != null) {
      iframeConfig.request_id = data.request_id;
    }
  };

  /** Android：Gen* 组件 ref 禁止 as UTSJSONObject，用 $callMethod */
  const callRefMethod = (refVal: any | null, methodName: string): void => {
    if (refVal == null) {
      return;
    }
    try {
      const proxy = refVal as ComponentPublicInstance;
      proxy.$callMethod(methodName);
    } catch (_e) {
      // ignore
    }
  };

  /**
   * 处理页面打开
   * @param data 预览数据
   */
  const handlePageOpen = (data: any) => {
    applyPreviewData(readPreviewData(data));
    callRefMethod(popupPreviewPage.value, "open");
  };

  /**
   * iframe加载完成事件
   */
  const onIframeLoad = () => {
    // #ifdef H5 || WEB
    console.log("onIframeLoad");
    const iframe = iframeRef.value;
    if (iframe == null) return;
    if (iframeConfig.uri.length == 0) return;
    onIframeDOMChange(iframe);
    // #endif
  };

  /**
   * 监听iframe DOM变化（仅 H5）
   */
  const onIframeDOMChange = (iframe: any) => {
    // #ifdef H5 || WEB
    const iframeObj = iframe as UTSJSONObject;
    let iframeDocVal = iframeObj["contentDocument"];
    if (iframeDocVal == null) {
      const contentWindow = iframeObj["contentWindow"];
      if (contentWindow != null) {
        iframeDocVal = (contentWindow as UTSJSONObject)["document"];
      }
    }
    if (iframeDocVal == null) return;
    const iframeDoc = iframeDocVal as UTSJSONObject;

    let timer: number = 0;

    const observer = new MutationObserver(() => {
      clearTimeout(timer);
      timer = setTimeout(async () => {
        const titleEl = iframeDoc.querySelector("head > title");
        const titleText =
          titleEl != null ? (titleEl as UTSJSONObject)["textContent"] : null;
        headerTitle.value =
          titleText != null && (titleText as string).length > 0
            ? (titleText as string)
            : t("Mobile.PagePreview.defaultTitle");

        const body = iframeDoc["body"];
        const html = body != null ? (body as UTSJSONObject)["innerHTML"] : "";

        let str = "";
        if (iframeConfig.data_type === "html") {
          str = html as string;
        }
        if (iframeConfig.data_type === "markdown") {
          const turndownService = new TurndownService();
          str = turndownService.turndown(html as string);
        }
        if (str.length == 0) {
          return;
        }

        if (iframeConfig.method === "browser_navigate_page") {
          const requestId =
            iframeConfig.request_id.length > 0
              ? iframeConfig.request_id
              : "";
          await apiAgentComponentPageResultUpdate({
            requestId: requestId,
            html: str,
          });
        }
      }, 500);
    });

    const bodyEl = iframeDoc["body"];
    if (bodyEl != null) {
      observer.observe(bodyEl, {
        childList: true,
        subtree: true,
        characterData: true,
      });
    }
    // #endif
  };

  // 必须暴露出来，否则父组件访问不到
  defineExpose({
    handlePageOpen,
    popupPreviewPage,
  });
</script>

<style lang="scss" scoped>
  // .h-full {
  //   // border: 2rpx solid #ddd;
  // }
  .border-none {
    border: none;
  }
</style>
