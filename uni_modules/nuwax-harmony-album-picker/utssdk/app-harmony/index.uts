// nuwax-harmony-album-picker · app-harmony
//
// 直开系统相册选择器（PhotoViewPicker，IMAGE_VIDEO_TYPE 图+视频混选），
// 对齐 uni.chooseMedia 鸿蒙运行时相册分支的行为（isPhotoTakingSupported=false
// 不出拍摄入口、maxSelectNumber=count），但不经过其顶层分流——运行时对混选
// mediaType 会先弹自家「拍摄/从相册选择」action sheet 且无视 sourceType:["album"]，
// 与聊天页图片键的二选一弹窗叠成双层（Android/iOS 无此层）。
//
// 权限：系统相册选择器属安全控件，无需任何媒体读取权限（与运行时相册分支一致）。
// fileType 判定：/Video/ 路径段与视频扩展名先判；未命中读文件头 12 字节嗅探
// （'ftyp'/EBML/RIFF）——2026-10-27 真机实锤：视频 URI 可挂在 /Photo/ 段下且
// 末段纯数字无扩展名，旧判据把视频误判成图片进了暂存条（应直发），嗅探兜底后
// URI 形态再怎么变也只影响性能不影响类型；读头失败按图片（复制同路径会再兜底）。
//
// ★图片不出原始 URI、先复制进应用 cacheDir（materializePhotoToCache）：选择器的
// 读授权只在本会话内可靠，file://media/… 存进会话草稿后重进页面会读不出
// （缩略图空白/上传失败，2026-10-26 真机实锤）；沙箱副本跨页面实例可读可续传。
// 视频当场入队上传（会话内消费），保持原 URI 不复制（大文件复制纯浪费）。
import { photoAccessHelper } from '@kit.MediaLibraryKit';
import { BusinessError } from '@kit.BasicServicesKit';
// @kit.CoreFileKit 不导出 fs（ArkTS 编译报 10505001）；官方 runtime 同款默认导入
import fs from '@ohos.file.fs';
import type {
  HarmonyAlbumFailCallback,
  HarmonyAlbumSuccessCallback,
} from '../interface.uts';

/** URI → 是否视频：/Video/ 路径段与视频扩展名先判，未命中读文件头嗅探兜底。 */
function isVideoMedia(uri: string): boolean {
  if (uri.indexOf('/Video/') >= 0) {
    return true;
  }
  const lower = uri.toLowerCase();
  if (
    lower.indexOf('.mp4') >= 0 ||
    lower.indexOf('.mov') >= 0 ||
    lower.indexOf('.3gp') >= 0 ||
    lower.indexOf('.mkv') >= 0 ||
    lower.indexOf('.mpg') >= 0 ||
    lower.indexOf('.mpeg') >= 0
  ) {
    return true;
  }
  return sniffVideoHeader(uri);
}

/** 读文件头 12 字节判视频容器：MP4/MOV/3GP 系 'ftyp' 盒（4-7 字节）、MKV/WebM
 *  EBML 头（1A 45 DF A3）、AVI RIFF 头。选择器会话授权内 openSync 与复制同路径，
 *  读失败按非视频处理（不阻断选图）。 */
function sniffVideoHeader(uri: string): boolean {
  let fd = -1;
  try {
    const src = fs.openSync(uri, fs.OpenMode.READ_ONLY);
    fd = src.fd;
    const buf = new ArrayBuffer(12);
    fs.readSync(fd, buf);
    const b = new Uint8Array(buf);
    if (b[4] == 0x66 && b[5] == 0x74 && b[6] == 0x79 && b[7] == 0x70) {
      return true;
    }
    if (b[0] == 0x1a && b[1] == 0x45 && b[2] == 0xdf && b[3] == 0xa3) {
      return true;
    }
    if (
      b[0] == 0x52 && b[1] == 0x49 && b[2] == 0x46 && b[3] == 0x46 &&
      b[8] == 0x41 && b[9] == 0x56 && b[10] == 0x49 && b[11] == 0x20
    ) {
      return true;
    }
    return false;
  } catch (e) {
    // 鸿蒙真机 console.log/warn 不可见，排障日志须用 console.error
    console.error(`[HarmonyAlbumPicker] sniff failed: ${e} uri=${uri}`);
    return false;
  } finally {
    if (fd >= 0) {
      try {
        fs.closeSync(fd);
      } catch (closeErr) {
        console.error(`[HarmonyAlbumPicker] sniff close failed: ${closeErr}`);
      }
    }
  }
}

/** URI 末段扩展名（媒体库 URI 末段常是纯数字 id，此时空串）。 */
function uriExtOf(uri: string): string {
  const segs = uri.split('/');
  if (segs.length == 0) {
    return '';
  }
  const last = segs[segs.length - 1];
  const dot = last.lastIndexOf('.');
  if (dot > 0 && last.length - dot <= 6) {
    return last.substring(dot + 1);
  }
  return '';
}

/** 媒体库图片 URI → cacheDir 沙箱副本路径。扩展名缺失补 jpg（上传 mime 嗅探同
 *  聊天页 imageSendNameOf 口径）；复制失败回退原 URI（当场发送仍可用，仅草稿
 *  重进会失效——保持旧行为降级，不阻断选图）。 */
function materializePhotoToCache(uri: string, seq: number): string {
  try {
    const ext = uriExtOf(uri).length > 0 ? uriExtOf(uri) : 'jpg';
    const cacheDir = UTSHarmony.getUIAbilityContext().cacheDir;
    const dest = `${cacheDir}/nuwax_stage_${Date.now()}_${seq}.${ext}`;
    const src = fs.openSync(uri, fs.OpenMode.READ_ONLY);
    try {
      fs.copyFileSync(src.fd, dest);
    } finally {
      fs.closeSync(src);
    }
    return dest;
  } catch (e) {
    // 鸿蒙真机 console.log/warn 不可见，排障日志须用 console.error
    console.error(`[HarmonyAlbumPicker] materialize failed: ${e} uri=${uri}`);
    return uri;
  }
}

export function pickHarmonyAlbumMedia(
  count: number,
  success: HarmonyAlbumSuccessCallback,
  fail: HarmonyAlbumFailCallback,
): void {
  try {
    const selectOptions = new photoAccessHelper.PhotoSelectOptions();
    selectOptions.MIMEType = photoAccessHelper.PhotoViewMIMETypes.IMAGE_VIDEO_TYPE;
    selectOptions.maxSelectNumber = count > 0 ? count : 9;
    // 调用方（聊天页图片键 action sheet）已提供拍摄/相册二选一，选择器内不出拍摄入口
    selectOptions.isPhotoTakingSupported = false;
    selectOptions.isOriginalSupported = false;
    new photoAccessHelper.PhotoViewPicker()
      .select(selectOptions)
      .then((result: photoAccessHelper.PhotoSelectResult) => {
        const uris = result.photoUris;
        if (uris == null || uris.length == 0) {
          // 用户取消：部分版本以空结果 resolve（而非 reject），两种口径都归 CANCEL
          fail('CANCEL', 'empty selection');
          return;
        }
        const paths: string[] = [];
        const isVideos: boolean[] = [];
        for (let i = 0; i < uris.length; i++) {
          const uri = `${uris[i]}`;
          const video = isVideoMedia(uri);
          // 图片出沙箱副本（草稿重进可读），视频保持原 URI（当场入队消费）
          paths.push(video ? uri : materializePhotoToCache(uri, i));
          isVideos.push(video);
        }
        success(paths, isVideos);
      })
      .catch((e: BusinessError) => {
        // 用户取消在部分版本以 reject 返回，与真实失败同走 catch：
        // 鸿蒙真机 console.log/warn 不可见，排障日志须用 console.error
        console.error(`[HarmonyAlbumPicker] select failed: ${e.code} ${e.message}`);
        fail('CANCEL', `select failed: ${e.code}`);
      });
  } catch (e) {
    console.error(`[HarmonyAlbumPicker] select threw: ${e}`);
    fail('ERROR', `${e}`);
  }
}
