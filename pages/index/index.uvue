    font-weight: 600;
  }

  .create-hub__bottom {
    /* 勿加 z-index：会把输入区弹层(action sheet/专家快选, z-999/500)封顶在本层，
       被分类胶囊(z-31)反压；保持 auto 让弹层在页面根层级参与比较 */
    position: relative;
