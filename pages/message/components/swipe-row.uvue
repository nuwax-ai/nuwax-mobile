<template>
  <view
    class="chat-swipe"
    hover-class="chat-swipe--hover"
    @touchstart="onTouchStart($event)"
    @touchmove="onTouchMove($event)"
    @touchend="onTouchEnd($event)"
    @touchcancel="onTouchEnd($event)"
  >
    <!-- 默认插槽 = 行内容（不动）；按钮层从右缘重叠滑入/收回（飞书同款） -->
    <slot />
    <!--
      飞书/iOS 同款「重叠堆叠 + 左滑依次带出」：
      按钮层不整体平移；每个按钮自身 transform 公式：
        translateX( calc( var(--swipe-x, 0px) + var(--i, 0) * var(--btn-w, 0px) ) )
      X=0 时所有按钮 translateX=i*W 堆在 right:0 重叠成一摞（仅最右可见）；
      X=-W 时第 0 个到 -W 露出 1 个，第 1 个仍在 0；X=-2W 时第 1 个露出...
      右滑反向收回，序号大的先被吞回。--swipe-x/--btn-w 由容器 :style 注入，
      --i 由按钮自身 inline style 注入；按钮 transform 由 CSS calc 实时算——
      零 JS 调用、纯合成层，跟手期间不掉帧；松手吸附只改 --swipe-x + transition 切换。
    -->
    <view class="chat-swipe__acts" :style="actsContainerStyle">
      <slot name="acts" />
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, watch } from "vue";

  const props = defineProps({
    /**
     * 受控收起：true 时该行处于展开态。展开不由此 prop 驱动（跟手拖拽/松手吸附在子组件自治），
     * prop 变 false 时内部带动画收回——父页单开策略（关其它行）/点行收起/点按钮收起走这里。
     */
    open: {
      type: Boolean,
      default: false,
    },
    // 按钮区总宽（rpx）：420=3×140 / 280=2×140 / 220=单个宽钮
    actsRpx: {
      type: Number,
      default: 420,
    },
    // 单按钮宽（rpx，默认 140）：用于按序号错位位移 X_i = swipeX + i*buttonW
    buttonRpx: {
      type: Number,
      default: 140,
    },
  });

  const emit = defineEmits<{
    /** touchstart：父页收起其它已展开行（单开策略） */
    grab: [];
    /** 轴判定为横向：锁列表滚动（direction=none，防斜滑时页面上下晃动） */
    lock: [];
    /** 松手/取消：解锁列表滚动 */
    unlock: [];
    /** 松手吸附为展开（过半）：父页记入 openRowId */
    opened: [];
    /** 松手吸附为收回（不足半）：父页清出 openRowId */
    closed: [];
    /** 横向滑动松手：H5 会补发一次 click，父页置位吞掉避免误触行点击 */
    swiped: [];
  }>();

  /**
   * rpx→px 换算基准（组件创建时取一次缓存）：
   * 跟手滑动期间不再跨端调 uni.getWindowInfo（原生桥调用 × 每帧，是左滑跟手延迟的主因）。
   */
  const rpxScalePx = uni.getWindowInfo().windowWidth / 750;
  /** 本行按钮区总宽（px）：actsRpx 按行类型固定，算一次即可。 */
  const actsWidthPx = rpxScalePx * props.actsRpx;
  /** 单按钮宽度（px）：作为 CSS 变量 --btn-w 注入按钮层；子按钮 transform
     = calc( var(--swipe-x) + var(--i) * var(--btn-w) )，序号 i 由父页 v-for 索引传入。 */
  const buttonWidthPx = rpxScalePx * props.buttonRpx;

  // 按钮层横向偏移（px，闭合=0，展开=-totalW）：跟手实时，作为 CSS 变量 --swipe-x 注入
  // 按钮层；所有按钮 transform 由 CSS calc 实时算——零 JS 调用、纯合成层
  const swipeX = ref<number>(0);
  // 松手吸附动画开关（200ms 过渡）：仅作用于 --swipe-x；按钮 transform 自身不带过渡，
  // 避免每按钮各算一遍 transition
  const swipeAnim = ref<boolean>(false);

  /** 按钮层容器 :style：注入 --swipe-x / --btn-w；按钮子项 calc 自身位移。 */
  const actsContainerStyle = computed((): string => {
    let style = `--swipe-x: ${Math.round(swipeX.value)}px; --btn-w: ${Math.round(buttonWidthPx)}px;`;
    if (swipeAnim.value) {
      style += "transition-property: --swipe-x; transition-duration: 200ms; transition-timing-function: ease-out;";
    }
    return style;
  });

  // 外部收起：open 变 false 且当前展开 → 动画收回
  watch(
    (): boolean => props.open,
    (open: boolean) => {
      if (open != true && swipeX.value != 0) {
        swipeAnim.value = true;
        swipeX.value = 0;
      }
    },
  );

  // ===== 左滑手势（单行自治；跟手的每帧状态更新只落在本组件内，不重渲整个列表页）=====
  let touching = false;
  let startX = 0;
  let startY = 0;
  let baseX = 0;
  // 轴锁定：0=未判定 1=横向（左滑）2=纵向（让位列表滚动）
  let axis = 0;

  /**
   * 模板内联表达式中的 `$event` 在 Android UTS 会被推断为 Any；
   * 仅在模板边界接收 Any，进入手势逻辑后恢复为真实的 UniTouchEvent。
   */
  function onTouchStart(eventValue: Any): void {
    const e = eventValue as UniTouchEvent;
    touching = true;
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
    baseX = swipeX.value;
    axis = 0;
    emit("grab");
  }

  function onTouchMove(eventValue: Any): void {
    if (touching != true) {
      return;
    }
    const e = eventValue as UniTouchEvent;
    const dx = e.touches[0].clientX - startX;
    const dy = e.touches[0].clientY - startY;
    const adx = dx < 0 ? -dx : dx;
    const ady = dy < 0 ? -dy : dy;
    // 轴锁定：位移超 8px 才判定方向，|dx|>|dy| 为横向，否则让位纵向滚动
    if (axis == 0) {
      if (adx < 8 && ady < 8) {
        return;
      }
      axis = adx > ady ? 1 : 2;
      if (axis == 1) {
        // 横向判定成立即锁列表滚动，吃掉剩余纵向分量（解锁在 onTouchEnd/cancel）
        emit("lock");
      }
    }
    if (axis != 1) {
      return;
    }
    let next = baseX + dx;
    if (next < -actsWidthPx) {
      next = -actsWidthPx;
    }
    if (next > 0) {
      next = 0;
    }
    // 取整到像素：触摸坐标是浮点，亚像素更新只会刷无效帧徒增延迟；值未变则不触发响应式更新
    const snapped = Math.round(next);
    if (snapped == swipeX.value) {
      return;
    }
    swipeAnim.value = false;
    swipeX.value = snapped;
  }

  function onTouchEnd(_eventValue: Any): void {
    if (touching != true) {
      return;
    }
    touching = false;
    if (axis != 1) {
      return;
    }
    // 解锁列表滚动（touchcancel 也走这里：滚动被原生抢占时避免锁死）
    emit("unlock");
    // 横向滑动松手后 H5 仍会补发一次 click，父页吞掉避免误触行点击
    emit("swiped");
    // 过半展开、不足半收回；松手吸附带 200ms 过渡
    swipeAnim.value = true;
    swipeX.value = swipeX.value < -actsWidthPx / 2 ? -actsWidthPx : 0;
    emit(swipeX.value == -actsWidthPx ? "opened" : "closed");
  }
</script>

<style lang="scss">
  /* 左滑操作行（飞书同款）：内容行不动，按钮层绝对定位盖在行内容上方重叠滑入。
     不加 scoped：slot 内容由父页 message.uvue 渲染，scoped 会把 .chat-swipe__act
     改写成 .chat-swipe__act[data-v-xxx] 让父页渲染的按钮拿不到这条样式（行内块
     自然铺开 = 全部按钮可见），与容器样式只此一处使用、无命名冲突故无需 scoped */
  .chat-swipe {
    position: relative;
    overflow: hidden;
  }

  .chat-swipe__acts {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    /* 容器不写 flex：子项全部绝对定位重叠在同一坐标，自身 transform 单独驱动 */
  }
  /* 按钮层内每个按钮：绝对定位叠在 right:0 重叠成一摞，自身 transform
     = calc( var(--swipe-x) + var(--i) * var(--btn-w) ) 由 CSS 实时算，
     序号 i 由父页 v-for 索引 :style 注入；单按钮宽度由父页控制 */
  .chat-swipe__act {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    transform: translateX(calc(var(--swipe-x, 0px) + var(--i, 0) * var(--btn-w, 0px)));
  }
</style>
