<template>
  <view class="page">
    <text class="title">x-svg-renderer demo</text>
    <text class="subtitle">Same source for VDOM and Vapor</text>

    <view class="toolbar">
      <button class="toolbar__button" @click="showBasic">Basic</button>
      <button class="toolbar__button" @click="showMermaid">Mermaid-like</button>
      <button class="toolbar__button" @click="showBroken">Broken SVG</button>
      <button class="toolbar__button" @click="clearSvg">Clear</button>
    </view>

    <view class="toolbar">
      <button class="toolbar__button" @click="setContain">Contain</button>
      <button class="toolbar__button" @click="setCover">Cover</button>
      <button class="toolbar__button" @click="setFill">Fill</button>
      <button class="toolbar__button" @click="setCenter">Center</button>
    </view>

    <view class="card">
      <x-svg-renderer
        class="renderer"
        :svg="currentSvg"
        :fit="fit"
        @load="onLoad"
        @error="onError"
      ></x-svg-renderer>
    </view>

    <text class="status">fit: {{ fit }}</text>
    <text class="status">status: {{ status }}</text>

    <view class="card math-card">
      <katex-el
        :svg="mathSvg"
        :width="320"
        :height="80"
      />
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'

const basicSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="320" height="160" viewBox="0 0 320 160">
  <rect x="10" y="10" width="300" height="140" rx="16" fill="#f5f5f5"/>
  <circle cx="80" cy="80" r="36" fill="#1677ff"/>
  <text x="140" y="88" font-size="26" fill="#111">uni-app x SVG</text>
</svg>`

const mermaidLikeSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="360" height="180" viewBox="0 0 360 180">
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
      <path d="M0,0 L0,6 L9,3 z" fill="#666"/>
    </marker>
  </defs>
  <rect x="20" y="55" width="110" height="60" rx="10" fill="#eef4ff" stroke="#1677ff"/>
  <text x="52" y="91" font-size="18">Agent</text>
  <line x1="135" y1="85" x2="220" y2="85" stroke="#666" stroke-width="2" marker-end="url(#arrow)"/>
  <rect x="225" y="55" width="110" height="60" rx="10" fill="#f6ffed" stroke="#52c41a"/>
  <text x="250" y="91" font-size="18">Tool</text>
</svg>`

const brokenSvg = `<svg><path d="M 0 0 L" /></svg>`

const mathSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="320" height="80" viewBox="0 0 320 80">
  <rect width="320" height="80" fill="#fff"/>
  <text x="16" y="52" font-size="34" font-family="serif" fill="#111">E = mc²</text>
</svg>`

const currentSvg = ref(basicSvg)
const fit = ref('contain')
const status = ref('idle')

function showBasic() {
  status.value = 'updating basic SVG'
  currentSvg.value = basicSvg
}

function showMermaid() {
  status.value = 'updating Mermaid-like SVG'
  currentSvg.value = mermaidLikeSvg
}

function showBroken() {
  status.value = 'expecting error'
  currentSvg.value = brokenSvg
}

function clearSvg() {
  status.value = 'cleared'
  currentSvg.value = ''
}

function setContain() {
  fit.value = 'contain'
}

function setCover() {
  fit.value = 'cover'
}

function setFill() {
  fit.value = 'fill'
}

function setCenter() {
  fit.value = 'center'
}

function onLoad() {
  status.value = 'rendered'
}

function onError(message: string) {
  status.value = `error: ${message}`
  console.error('SVG render failed:', message)
}
</script>

<style>
.page {
  flex: 1;
  padding: 16px;
  background-color: #f5f5f5;
}

.title {
  font-size: 22px;
  font-weight: 600;
  margin-bottom: 4px;
  color: #222;
}

.subtitle {
  font-size: 14px;
  margin-bottom: 12px;
  color: #888;
}

.toolbar {
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 8px;
}

.toolbar__button {
  margin-right: 8px;
  margin-bottom: 8px;
}

.card {
  width: 100%;
  height: 240px;
  margin-bottom: 12px;
  background-color: #fff;
  border-radius: 10px;
}

.math-card {
  height: 120px;
}

.renderer {
  width: 100%;
  height: 100%;
}

.status {
  font-size: 14px;
  margin-bottom: 4px;
  color: #666;
}
</style>
