/**
 * M 站 IM 承接页的参数判据。页面只执行结果，不在页面里再排一次优先级。
 *
 * 单目标优先级沿用 directOpen：convId > userId > agentId > groupNo > spaceId。
 * PC 的 invite 是独立浮层；移动本轮不并行打开两种目标，组合链接明确拒绝。
 * 先出现的参数胜出；值不合法就停在失败态，不偷偷改走后面的参数。
 * 有 invite 时不再看 groupNo，避免同一条链接进两个群。
 *
 * spaceId 只表示「登录后 enter」，这里不拼聊天页地址。convId 要等
 * POST /spaces/{spaceId}/enter 的响应才有，而且聊天页缺 convType 会按单聊渲染。
 */

export class ImInvitePlan {
  /** empty=没有直达参数；invalid=参数在但值不可用；其余是承接页要执行的动作。 */
  action: string = "empty";
  /** 规范化后的 id 或群号。invalid / empty / unsupported 时为空。 */
  value: string = "";
}

/** 登录回跳地址。search 可带或不带前导问号，原样保留已编码的值。 */
export function imInviteReturnPath(search: string): string {
  const page = "/subpackages/pages/im-invite/im-invite";
  if (search.length == 0) return page;
  return page + (search.charAt(0) == "?" ? search : "?" + search);
}

function readQuery(search: string, key: string): string | null {
  let body = search;
  const hashAt = body.indexOf("#");
  if (hashAt >= 0) body = body.substring(0, hashAt);
  const queryAt = body.indexOf("?");
  if (queryAt >= 0) body = body.substring(queryAt + 1);
  const parts = body.split("&");
  for (let i = 0; i < parts.length; i++) {
    const part = parts[i];
    if (part.length == 0) continue;
    const eq = part.indexOf("=");
    const name = eq >= 0 ? part.substring(0, eq) : part;
    if (name != key) continue;
    const raw = eq >= 0 ? part.substring(eq + 1) : "";
    try {
      const decoded = decodeURIComponent(raw.replace(/\+/g, " "));
      return decoded != null ? decoded : "";
    } catch (_error) {
      return raw;
    }
  }
  return null;
}

function isDigits(raw: string, min: number, max: number): boolean {
  if (raw.length < min || raw.length > max) return false;
  for (let i = 0; i < raw.length; i++) {
    const c = raw.charAt(i);
    if (c < "0" || c > "9") return false;
  }
  return true;
}

/** 雪花 id：1～19 位数字，去掉前导 0；0 非法。全程字符串，避免超过安全整数后改末位。 */
function normalizeId(raw: string): string {
  const trimmed = raw.trim();
  if (isDigits(trimmed, 1, 19) != true) return "";
  let start = 0;
  while (start < trimmed.length - 1 && trimmed.charAt(start) == "0") start++;
  const stripped = trimmed.substring(start);
  return stripped == "0" ? "" : stripped;
}

/** PC 群号契约：去空白/短横线，1～19 位数字，保留前导 0。 */
function normalizeGroupNo(raw: string): string {
  const value = raw.replace(/[\s　-]/g, "");
  return isDigits(value, 1, 19) ? value : "";
}

function decide(action: string, value: string): ImInvitePlan {
  const plan = new ImInvitePlan();
  if (value.length == 0) {
    plan.action = "invalid";
    return plan;
  }
  plan.action = action;
  plan.value = value;
  return plan;
}

export function planImInvite(search: string): ImInvitePlan {
  const convId = readQuery(search, "convId");
  const userId = readQuery(search, "userId");
  const agentId = readQuery(search, "agentId");
  const invite = readQuery(search, "invite");
  const groupNo = readQuery(search, "groupNo");
  const spaceId = readQuery(search, "spaceId");
  if (invite != null && (convId != null || userId != null || agentId != null || spaceId != null)) {
    const result = new ImInvitePlan();
    result.action = "unsupported";
    return result;
  }
  if (convId != null) return decide("detail", normalizeId(convId));
  if (userId != null) return decide("p2p", normalizeId(userId));
  if (agentId != null) return decide("agent", normalizeId(agentId));
  // invite 是独立的邀请意图；仅与 groupNo 并存时采用 invite，不自动提交加入。
  if (invite != null) return decide("join", normalizeGroupNo(invite));
  if (groupNo != null) return decide("join", normalizeGroupNo(groupNo));
  if (spaceId != null) return decide("enter", normalizeId(spaceId));
  return new ImInvitePlan();
}
