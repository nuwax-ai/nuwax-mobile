import { getApiBaseUrl } from '@/constants/config';

export const QR_LOGIN_PAGE = '/subpackages/pages/qr-login/qr-login';

export class QrLoginTarget {
  sceneId: string = '';
  origin: string = '';
}

/** 只接受 HTTP(S) origin，不允许凭据、路径或跨环境别名。 */
export function normalizeQrLoginOrigin(value: string): string {
  const match = value
    .trim()
    .match(
      /^(https?):\/\/(\[[0-9a-f:]+\]|[a-z0-9][a-z0-9.-]*)(?::([0-9]{1,5}))?\/?$/i,
    );
  if (match == null) return '';
  const scheme = (match[1] ?? '').toLowerCase();
  const host = (match[2] ?? '').toLowerCase();
  let port = match[3] ?? '';
  if (port.length > 0) {
    const number = parseInt(port);
    if (number <= 0 || number > 65535) return '';
    port = `${number}`;
  }
  if (
    (scheme == 'https' && port == '443') ||
    (scheme == 'http' && port == '80')
  )
    port = '';
  return scheme + '://' + host + (port.length > 0 ? ':' + port : '');
}

export function currentQrLoginOrigin(): string {
  const configured = getApiBaseUrl();
  if (configured.length > 0) return normalizeQrLoginOrigin(configured);
  // #ifdef H5 || WEB
  if (typeof window != 'undefined')
    return normalizeQrLoginOrigin(window.location.origin);
  // #endif
  return '';
}

/** sceneId 是不透明的单路径段，不采用 userId 的纯数字规则。 */
export function validQrLoginScene(value: string): boolean {
  return (
    value != '.' &&
    value != '..' &&
    /^[A-Za-z0-9][A-Za-z0-9._~-]{0,255}$/.test(value)
  );
}

export function qrLoginPageUrl(sceneId: string, origin: string): string {
  return (
    QR_LOGIN_PAGE +
    '?sceneId=' +
    encodeURIComponent(sceneId) +
    '&origin=' +
    encodeURIComponent(origin)
  );
}

export function qrLoginAppUrl(sceneId: string, origin: string): string {
  return (
    'nuwax://qrlogin?sceneId=' +
    encodeURIComponent(sceneId) +
    '&origin=' +
    encodeURIComponent(origin)
  );
}

function uniqueQueryValue(query: string, key: string): string {
  let value = '';
  let found = false;
  const fields = query.split('&');
  for (let i = 0; i < fields.length; i++) {
    const separator = fields[i].indexOf('=');
    if (separator < 0 || fields[i].substring(0, separator) != key) continue;
    if (found) return '';
    found = true;
    try {
      value = decodeURIComponent(fields[i].substring(separator + 1)) ?? '';
    } catch (_error) {
      return '';
    }
  }
  return value;
}

/** 可识别但无效/异域的登录码也须拦截，不能降级成携带账号的普通网页。 */
export function isQrLoginLink(value: string): boolean {
  return (
    /^nuwax:\/\/qrlogin(?:[/?#]|$)/i.test(value.trim()) ||
    /^https?:\/\/[^/?#]+\/qrlogin(?:[/?#]|$)/i.test(value.trim())
  );
}

export function parseQrLoginLink(
  value: string,
  expectedOrigin: string,
): QrLoginTarget | null {
  const expected = normalizeQrLoginOrigin(expectedOrigin);
  if (expected.length == 0) return null;
  const raw = value.trim();
  let sceneId = '';
  let origin = '';
  const scheme = raw.match(/^nuwax:\/\/qrlogin\?([^#]+)$/i);
  if (scheme != null) {
    sceneId = uniqueQueryValue(scheme[1] ?? '', 'sceneId');
    origin = normalizeQrLoginOrigin(
      uniqueQueryValue(scheme[1] ?? '', 'origin'),
    );
  } else {
    const web = raw.match(
      /^(https?:\/\/[^/?#]+)\/qrlogin\/([^/?#]+)\/?(?:\?[^#]*)?(?:#.*)?$/i,
    );
    if (web == null) return null;
    origin = normalizeQrLoginOrigin(web[1] ?? '');
    try {
      sceneId = decodeURIComponent(web[2] ?? '') ?? '';
    } catch (_error) {
      return null;
    }
  }
  if (origin != expected || !validQrLoginScene(sceneId)) return null;
  const target = new QrLoginTarget();
  target.sceneId = sceneId;
  target.origin = origin;
  return target;
}
