import { ref, type Ref } from "vue";

/**
 * 「N 条新消息」提示（飞书式，2026-11-02）的模块级状态。
 *
 * 为什么不放 chat.uvue 的 setup state：chat.uvue 的渲染 lambda 捕获参数已顶到 255 上限，
 * 模板每新增一个 setup 顶层符号引用就多一个捕获参数，R8 转发桩超限 → Android
 * `VerifyError: Verifier rejected class GenPagesMessageChat` → 整页加载失败
 * （见 utils/chatAiHint.uts / utils/chatLocateLoading.uts 同款说明）。所以提示抽成
 * 零绑定组件（components/chat-new-msg-tip）挂载，条数经本模块的 ref 传递。
 *
 * 计数口径由页面推导（不是本模块累加）：页面维护「最近一次贴底看到最新」的 seq 基线，
 * 贴底探测发现「不在底部 + 有比基线更新的行」时把条数写进来。这样息屏/锁屏/退后台
 * 期间到达、回页才由 WS 补拉/静默同步落地的消息天然被算进去（不依赖到达时机）。
 */
export const chatNewMsgTipCount: Ref<number> = ref<number>(0);

/** 写入条数（同值不触发，避免无谓重渲）。 */
export function setChatNewMsgTipCount(count: number): void {
  if (chatNewMsgTipCount.value != count) {
    chatNewMsgTipCount.value = count;
  }
}

// ===== 点击回调注册（页面 → 组件）=====
// 组件点按要滚到最新，滚动逻辑在页面里。token 取会话 id：onHide/onUnload 只清理
// 自己的注册，多聊天页堆叠（后页覆盖前页）时不会把新页面的注册清掉。
let activeToken = "";
let activeHandler: (() => void) | null = null;

/** 页面可见时注册（onShow）。 */
export function setChatNewMsgTipJumpHandler(token: string, handler: () => void): void {
  activeToken = token;
  activeHandler = handler;
}

/** 页面隐藏/销毁时解除注册（仅当注册仍是自己的）。 */
export function clearChatNewMsgTipJumpHandler(token: string): void {
  if (activeToken != token) {
    return;
  }
  activeToken = "";
  activeHandler = null;
}

/** 组件点按 → 通知当前可见的聊天页滚到最新。 */
export function triggerChatNewMsgTipJump(): void {
  const handler = activeHandler;
  if (handler != null) {
    handler();
  }
}
