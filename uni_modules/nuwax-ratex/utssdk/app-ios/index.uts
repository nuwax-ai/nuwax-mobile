/**
 * nuwax-ratex iOS 后端。LaTeX → Rust → CoreGraphics → UIImage → PNG base64。
 */
export * from '../interface.uts'
import { RatexRenderOptions, RatexRenderResult } from '../interface.uts'

export function renderLatex(tex: string, opts: RatexRenderOptions): RatexRenderResult {
	if (tex.length == 0) {
		return { imageDataURL: '', width: 0, height: 0, errMsg: 'empty_tex' }
	}
	// HX5.24 起 type-object 属性在 Swift 侧是 NSNumber?（可选），且 UTS number 桥接为 NSNumber；
	// 桥参数已改 NSNumber（见 RaTeXBridge），此处归一为非可选值再按位调用（参数已下划线化）。
	// 缺省值对齐 interface.uts 注释：行内 16 / "#404040" / 非块级。
	const displayModeVal: boolean = opts.displayMode == true
	const fontSizeVal: number = opts.fontSize != null ? opts.fontSize : 16
	const colorVal: string = opts.color != null ? opts.color : '#404040'
	const raw = RaTeXBridge.renderToPngDataUrl(tex, displayModeVal, fontSizeVal, colorVal)
	if (raw.startsWith('ERR:')) {
		return { imageDataURL: '', width: 0, height: 0, errMsg: raw.substring(4) }
	}
	// 协议 "dataURL|W|H"：base64 与 dataURL 均不含 '|'，split 解析两端通用。
	// （Swift String 无 substring(Int,Int) 重载，双参 substring 在 iOS 桥下编不过。）
	const parts = raw.split('|')
	if (parts.length < 3) {
		return { imageDataURL: '', width: 0, height: 0, errMsg: 'bad_format' }
	}
	return {
		imageDataURL: parts[0],
		width: parseInt(parts[1]),
		height: parseInt(parts[2]),
		errMsg: '',
	}
}

export function renderLatexAsync(
	tex: string,
	opts: RatexRenderOptions,
	onResult: (res: RatexRenderResult) => void,
): void {
	setTimeout((): void => {
		onResult(renderLatex(tex, opts))
	}, 0)
}
