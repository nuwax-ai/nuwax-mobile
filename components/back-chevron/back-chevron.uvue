<template>
  <!-- 自绘返回箭头（「<」）。
       iconfont 的 icon-a-Chevronleft 笔画偏粗（20px 下约 2.2px），消息相关页面的
       左上角返回键看起来比微信重；这里自绘一个笔画 2px 的 chevron，粗细/大小可分别调。
       做法：一个正方形只画左+下两条边框（成「L」），整体旋转 45° ⇒ 顶点朝左的「<」。
       单节点 + 边框折角：没有「两段线在顶点拼接」的接缝，鸿蒙上不会出现顶点缺一截；
       纯 view 绘制，不依赖字体，Android / iOS / 鸿蒙 / H5 表现一致。 -->
  <view class="back-chevron" :style="boxStyle">
    <view class="back-chevron__shape" :style="shapeStyle" />
  </view>
</template>

<script lang="uts" setup>
  import { computed } from "vue";

  /**
   * 细笔画返回箭头。
   * 几何：边长 A 的方框只留 border-left + border-bottom，绕中心 rotate(45deg)：
   *  - 视觉高度 = A * √2（对角）
   *  - 视觉宽度 = A * 0.707 + 笔画的水平投影（≈ 笔画 * 0.7）
   * 取 A = size * 0.565 ⇒ 20px 盒得 16px 高、约 9.4px 宽，与原字形（16×9）同比例。
   */
  const props = withDefaults(
    defineProps<{
      /** 图标盒边长（px），缺省 20（与消息页原 svg-icon size=20/40rpx 等值） */
      size?: any | null;
      /** 笔画粗细（px），缺省 2（1.6 在 iOS 上偏细，2026-11-13 真机反馈） */
      stroke?: any | null;
      /** 笔画颜色，缺省 #141416（消息页头部墨色） */
      color?: string;
    }>(),
    {
      size: 20 as any,
      stroke: 2 as any,
      color: "#141416",
    },
  );

  /** props 运行时可能是 string（Android 强转 number 会抛），统一安全转数值 */
  function resolveNum(raw: any | null, fallback: number): number {
    if (raw == null) {
      return fallback;
    }
    if (typeof raw == "number") {
      const n = raw as number;
      return n != n ? fallback : n;
    }
    const s = `${raw}`;
    if (s.length == 0) {
      return fallback;
    }
    const parsed = parseFloat(s);
    return parsed != parsed ? fallback : parsed;
  }

  /** px 字面量（保留两位小数，避免浮点尾巴写进 style 字符串） */
  function px(v: number): string {
    const r = Math.round(v * 100) / 100;
    return r.toString() + "px";
  }

  const boxSize = computed((): number => {
    const s = resolveNum(props.size, 20);
    return s > 0 ? s : 20;
  });

  const strokeWidth = computed((): number => {
    const t = resolveNum(props.stroke, 2);
    return t > 0 ? t : 2;
  });

  /** 方框边长（对角线≈视觉高度） */
  const shapeSide = computed((): number => {
    return boxSize.value * 0.565;
  });

  /** 笔画颜色（传空串时回落默认墨色，避免拼出空的 border-color） */
  const strokeColor = computed((): string => {
    const c = props.color as string;
    return c.length > 0 ? c : "#141416";
  });

  const boxStyle = computed((): string => {
    const s = boxSize.value;
    return (
      "position: relative;" +
      " width: " + px(s) + "; height: " + px(s) + ";"
    );
  });

  /**
   * 定位：方框绕自身中心旋转，但「L」的墨迹重心不在方框中心——旋转后墨迹偏左
   * （上方框中心往左下 0.707A ≈ 8px 才是笔尖）。这里按墨迹 bbox 反推，把 bbox 摆正：
   *   bbox 中心相对方框中心 = 0.354A'（A' = 边长 - 笔画），故方框中心要右移这么多。
   *   left = 盒半宽 + 0.354A' - A/2，top = (盒边长 - A)/2。
   * 20px 盒 + 2px 笔画下得 left=7.64 / top=4.35，墨迹 9.4 x 16，视觉居中。
   */
  const shapeStyle = computed((): string => {
    const side = shapeSide.value;
    const t = strokeWidth.value;
    const s = boxSize.value;
    const shift = 0.35355 * (side - t);
    const left = s / 2 + shift - side / 2;
    const top = (s - side) / 2;
    return (
      "position: absolute;" +
      " left: " + px(left) + "; top: " + px(top) + ";" +
      " width: " + px(side) + "; height: " + px(side) + ";" +
      " border-left: " + px(t) + " solid " + strokeColor.value + ";" +
      " border-bottom: " + px(t) + " solid " + strokeColor.value + ";" +
      " border-radius: " + px(t * 0.6) + ";" +
      " transform: rotate(45deg);"
    );
  });
</script>

<style scoped>
  .back-chevron {
    flex-shrink: 0;
  }
</style>
