<template>
  <!--
    基于 page-container 的弹窗容器（uni-app x 推荐替代 uni-popup）。
    支持 center / top / bottom / left / right。
  -->
  <!-- #ifdef MP-WEIXIN -->
  <page-container
    v-if="visible"
    :show="visible"
    :position="resolvedPosition"
    :duration="duration"
    :z-index="zIndex"
    :overlay="overlay"
    :round="round"
    :close-on-slide-down="resolvedCloseOnSlideDown"
    :overlay-style="overlayStyle"
    :custom-style="resolvedCustomStyle"
    @clickoverlay="onClickOverlay"
    @afterleave="onAfterLeave"
    @beforeenter="onBeforeEnter"
    @enter="onEnter"
    @afterenter="onAfterEnter"
    @beforeleave="onBeforeLeave"
    @leave="onLeave"
  >
    <!-- 居中：page-container 全屏层 + 内部 flex 居中；点空白关闭（全屏会挡住原生 clickoverlay） -->
    <view
      v-if="isCenter"
      class="uni-modal-popup__center-host"
      @tap="onClickOverlay"
    >
      <view
        class="uni-modal-popup__panel"
        :class="panelPositionClass"
        :style="panelInlineStyle"
        @tap.stop="onPanelTap"
      >
        <view class="uni-modal-popup__head" v-if="showHeader">
          <view class="uni-modal-popup__title">
            <text class="uni-modal-popup__title-text">{{ displayTitle }}</text>
          </view>
          <slot name="header-extra"></slot>
          <view class="uni-modal-popup__close" v-if="showCloseBtn" @tap="close">
            <svg-icon name="icon-X" />
          </view>
        </view>
        <view class="uni-modal-popup__body">
          <slot></slot>
        </view>
      </view>
    </view>
    <view
      v-else
      class="uni-modal-popup__panel"
      :class="panelPositionClass"
      :style="panelInlineStyle"
    >
      <view class="uni-modal-popup__head" v-if="showHeader">
        <view class="uni-modal-popup__title">
          <text class="uni-modal-popup__title-text">{{ displayTitle }}</text>
        </view>
        <slot name="header-extra"></slot>
        <view class="uni-modal-popup__close" v-if="showCloseBtn" @tap="close">
          <svg-icon name="icon-X" />
        </view>
      </view>
      <view class="uni-modal-popup__body">
        <slot></slot>
      </view>
    </view>
  </page-container>
  <!-- #endif -->

  <!-- #ifndef MP-WEIXIN -->
  <page-container
    :show="visible"
    :position="resolvedPosition"
    :duration="duration"
    :z-index="zIndex"
    :overlay="overlay"
    :round="round"
    :close-on-slide-down="resolvedCloseOnSlideDown"
    :overlay-style="overlayStyle"
    :custom-style="resolvedCustomStyle"
    @clickoverlay="onClickOverlay"
    @afterleave="onAfterLeave"
    @beforeenter="onBeforeEnter"
    @enter="onEnter"
    @afterenter="onAfterEnter"
    @beforeleave="onBeforeLeave"
    @leave="onLeave"
  >
    <view
      v-if="isCenter"
      class="uni-modal-popup__center-host"
      @tap="onClickOverlay"
    >
      <view
        class="uni-modal-popup__panel"
        :class="panelPositionClass"
        :style="panelInlineStyle"
        @tap.stop="onPanelTap"
      >
        <view class="uni-modal-popup__head" v-if="showHeader">
          <view class="uni-modal-popup__title">
            <text class="uni-modal-popup__title-text">{{ displayTitle }}</text>
          </view>
          <slot name="header-extra"></slot>
          <view class="uni-modal-popup__close" v-if="showCloseBtn" @tap="close">
            <svg-icon name="icon-X" />
          </view>
        </view>
        <view class="uni-modal-popup__body">
          <slot></slot>
        </view>
      </view>
    </view>
    <view
      v-else
      class="uni-modal-popup__panel"
      :class="panelPositionClass"
      :style="panelInlineStyle"
    >
      <view class="uni-modal-popup__head" v-if="showHeader">
        <view class="uni-modal-popup__title">
          <text class="uni-modal-popup__title-text">{{ displayTitle }}</text>
        </view>
        <slot name="header-extra"></slot>
        <view class="uni-modal-popup__close" v-if="showCloseBtn" @tap="close">
          <svg-icon name="icon-X" />
        </view>
      </view>
      <view class="uni-modal-popup__body">
        <slot></slot>
      </view>
    </view>
  </page-container>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { translateText } from "@/utils/i18n";

  const props = withDefaults(
    defineProps<{
      /** 标题（支持 i18n key） */
      title?: string;
      /** 内容区宽度（center / left / right 生效），如 80% */
      width?: string;
      /** 弹出方向：center | top | bottom | left | right */
      position?: string;
      /** 是否显示遮罩 */
      overlay?: boolean;
      /** 点击遮罩是否关闭 */
      maskClick?: boolean;
      /** 是否圆角（透传 page-container round） */
      round?: boolean;
      /** 是否显示标题栏 */
      showHeader?: boolean;
      /** 是否显示关闭按钮 */
      showCloseBtn?: boolean;
      /** 动画时长 ms */
      duration?: number;
      /** 层级 */
      zIndex?: number;
      /** 遮罩自定义样式 */
      overlayStyle?: string;
      /** 弹出层自定义样式（会与内置方向样式合并） */
      customStyle?: string;
      /** 底部弹出时是否支持下滑关闭 */
      closeOnSlideDown?: boolean;
      /** 兼容旧 modal-popup：底部方向时等同 closeOnSlideDown */
      enableSwipeClose?: boolean;
    }>(),
    {
      title: "",
      width: "80%",
      position: "center",
      overlay: true,
      maskClick: true,
      round: true,
      showHeader: true,
      showCloseBtn: true,
      duration: 300,
      zIndex: 999,
      overlayStyle: "background-color: rgba(0, 0, 0, 0.4);",
      customStyle: "",
      closeOnSlideDown: false,
      enableSwipeClose: false,
    },
  );

  const emit = defineEmits([
    "update-visible",
    "beforeenter",
    "enter",
    "afterenter",
    "beforeleave",
    "leave",
    "afterleave",
  ]);

  const visible = ref(false);

  const displayTitle = computed((): string => {
    return translateText(props.title);
  });

  const resolvedPosition = computed((): string => {
    const raw = props.position;
    if (
      raw == "top" ||
      raw == "bottom" ||
      raw == "left" ||
      raw == "right" ||
      raw == "center"
    ) {
      return raw;
    }
    return "center";
  });

  const isCenter = computed((): boolean => {
    return resolvedPosition.value == "center";
  });

  const resolvedCloseOnSlideDown = computed((): boolean => {
    if (props.closeOnSlideDown) {
      return true;
    }
    return props.enableSwipeClose && resolvedPosition.value == "bottom";
  });

  /**
   * 居中：保持全屏透明层，由内部 flex 居中内容（勿在此写 width，否则会贴左上角）。
   * @see https://doc.dcloud.net.cn/uni-app-x/component/page-container.html
   */
  const resolvedCustomStyle = computed((): string => {
    const pos = resolvedPosition.value;
    let base = "";
    if (pos == "center") {
      base =
        "width: 100%; height: 100%; background-color: transparent;";
    } else if (pos == "top" || pos == "bottom") {
      base = "width: 100%; max-height: 80%; background-color: transparent;";
    } else {
      base =
        "width: " +
        props.width +
        "; height: 100%; background-color: transparent;";
    }
    if (props.customStyle.length > 0) {
      return base + props.customStyle;
    }
    return base;
  });

  const panelPositionClass = computed((): string => {
    return "uni-modal-popup__panel--" + resolvedPosition.value;
  });

  /** 宽度加在内容面板上，而不是 page-container 层 */
  const panelInlineStyle = computed((): string => {
    const pos = resolvedPosition.value;
    if (pos == "center" || pos == "left" || pos == "right") {
      return "width: " + props.width + "; max-width: 675rpx;";
    }
    return "width: 100%;";
  });

  // UTS 不提升 const 函数：open/close 须定义在调用方之前
  const open = (): void => {
    visible.value = true;
    emit("update-visible", true);
  };

  const close = (): void => {
    if (visible.value == false) {
      return;
    }
    visible.value = false;
  };

  const onPanelTap = (): void => {};

  const onBeforeEnter = (): void => {
    emit("beforeenter");
  };
  const onEnter = (): void => {
    emit("enter");
  };
  const onAfterEnter = (): void => {
    emit("afterenter");
  };
  const onBeforeLeave = (): void => {
    emit("beforeleave");
  };
  const onLeave = (): void => {
    emit("leave");
  };

  const onClickOverlay = (): void => {
    if (props.maskClick) {
      close();
    }
  };

  const onAfterLeave = (): void => {
    visible.value = false;
    emit("afterleave");
    emit("update-visible", false);
  };

  defineExpose({
    open: open as any,
    close: close as any,
    visible,
  });
</script>

<style lang="scss" scoped>
  @import "./uni-modal-popup.scss";
</style>
