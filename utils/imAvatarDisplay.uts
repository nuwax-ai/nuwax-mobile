import { resolveDisplayImageUrl } from "@/utils/remoteSvgImage";
import { getImSessionStamp } from "@/utils/im/imSessionScope";
import { isAuthProtectedFileUrl } from "@/utils/authProtectedFileUrl";

/**
 * IM 用户头像展示地址统一解析（选人/搜索等次级页面共用）。
 *
 * H5 根因：/api/f/ 受保护头像 <image> 带不了 Bearer——H5 端 <img> 拿到 401 JSON 会被
 * ORB 拦成 net::ERR_BLOCKED_BY_ORB（真机原生加载器不受浏览器 ORB 约束，直连可用，
 * 故真机正常、浏览器必现）。与消息列表同机制：经 resolveDisplayImageUrl 带 Bearer
 * 拉图换 blob 地址展示。
 *
 * App（2026-10-23 消息列表定稿）：Android/iOS 的 svg 与普通位图直连均正常，
 * resolveDisplayImageUrl 内部按平台分流（App 两端 svg 直连透传、受保护地址换 Bearer
 * temp 文件），调用方无需关心平台差异。Android 走本解析的历史根因（SVG 1:1 光栅化
 * 裁切须改写 data URL）已在直连定稿中推翻。
 *
 * ★鸿蒙例外（2026-10-23 消息列表/聊天页同因实锤）：ArkUI <image> 直连 /api/f/ 不带
 *   Cookie → 服务端回 200+JSON 错误包 → "After download successful, imageObject
 *   Create fail"，受保护地址同样走 resolveDisplayImageUrl 换 Bearer temp 文件。
 *   普通位图/远程 svg 直连可用（ArkUI 不支持 SVG data URL，但直连远程 .svg 可正确
 *   缩放），不解析不额外下载。
 *
 * 缓存策略对齐 utils/remoteSvgImage：按 IM 会话 stamp 隔离清空 + 容量上限、在途
 * 去重、普通地址/失败负缓存不重试。次级页面头像量小，blob 不做逐页 revoke（会话
 * 切换即弃）；消息列表仍走页面级生命周期管理，勿混用。
 *
 * 接入姿势（★批量解析必须放在 xxx.value = rows 赋值之后、行取自 ref 数组——响应式
 * 代理实例上异步写回才触发渲染刷新；建行期 new 出的裸实例上写回不刷新，头像会卡死
 * 字母兜底。message.uvue resolveConvRowsIcons 同款）：
 *   // 建行（本地数组）：
 *   row.avatarRaw = readString(item, "avatar");
 *   row.avatar = imAvatarDisplayUrl(row.avatarRaw);
 *   // 赋值后批量解析：
 *   rows.value = out;
 *   resolveRowAvatars();   // 内部 const live = rows.value 遍历，闭包捕获代理实例
 * ★写回须复位 avatarFailed：首帧失败可能已把行标死在字母兜底，解析完成后要救回。
 * ★App-Android 异步写回后 v-for 行可能不重渲（ba6a72f18 消息列表同款平台缺陷），
 *   页面须在回填后整表重建赋值强制重渲（im-msg-read-status scheduleRowsRefresh 先例）。
 * ★行原始地址留 avatarRaw 字段：跳转带参等数据用途取它，勿把 blob:/data:地址带给别的页面。
 */

/** 原始地址 → 已解析展示地址（键含展示尺寸：App 端 SVG data URL 按尺寸出图，跨页尺寸不同不可混用） */
const resolvedCache = new Map<string, string>();
/** 已发起过解析的键（size|url；含失败回退：不重试，负缓存语义）。★键必须含尺寸：
 *  同 URL 跨页 sizeRpx 不同（群成员页 72 / 用户信息页 160 / 搜索 96）须各自解析——
 *  旧按 URL 记会短路掉第二个尺寸（首帧藏图后永不写回＝字母兜底钉死）。 */
const attemptedUrls = new Set<string>();
/** 在途去重：同「尺寸|地址」并发触发共享同一次解析 */
const pendingUrls = new Map<string, Promise<string>>();
const AVATAR_CACHE_LIMIT = 256;
let cacheSession = "";

function prepareCache(): void {
  const stamp = getImSessionStamp();
  if (stamp != cacheSession || resolvedCache.size >= AVATAR_CACHE_LIMIT ||
      attemptedUrls.size >= AVATAR_CACHE_LIMIT) {
    resolvedCache.clear();
    attemptedUrls.clear();
    cacheSession = stamp;
  }
}

/** 同步取展示地址（sizeRpx 须与 resolveImAvatarDisplay 一致，缓存键含尺寸）：
 * 缓存命中返回已解析地址；H5 / 鸿蒙上未解析的受保护地址返回空（先藏图，与消息列表
 * 一致——H5 裸 <img> 请求必被 ORB 拦；鸿蒙 ArkUI 直连无 Cookie 必 imageObject
 * Create fail；都会触发 @error 标死字母兜底）；其余原样返回。 */
export function imAvatarDisplayUrl(url: string, sizeRpx: number): string {
  if (url.length == 0) return url;
  const hit = resolvedCache.get(`${sizeRpx}|${url}`);
  if (hit != null) return hit;
  // #ifdef H5 || WEB || APP-HARMONY
  if (isAuthProtectedFileUrl(url)) return "";
  // #endif
  return url;
}

/**
 * 异步解析并写缓存：普通地址零请求透传原样返回；受保护/SVG 地址返回换好的展示地址。
 * 调用方把返回值写回行字段（并在失败首帧已标 avatarFailed 时复位）。
 * 生效范围：H5（ORB 拦截）；鸿蒙（受保护 /api/f/ 无 Cookie 直连失败，2026-10-23
 * 实锤，仅解析受保护地址）；Android/iOS 仅有受保护地址会实际换链（svg 与普通位图
 * resolveDisplayImageUrl 内部直连透传，零额外请求）；小程序原样透传。
 */
export function resolveImAvatarDisplay(url: string, sizeRpx: number): Promise<string> {
  // #ifdef H5 || WEB || APP-ANDROID || APP-IOS || APP-HARMONY
  if (url.length == 0) return Promise.resolve(url);
  // #ifdef APP-HARMONY
  // 鸿蒙只解析受保护地址：普通直链位图/远程 svg 直连可用（ArkUI 正确缩放远程
  // .svg），零请求透传不额外下载。
  if (isAuthProtectedFileUrl(url) != true) return Promise.resolve(url);
  // #endif
  prepareCache();
  const key = `${sizeRpx}|${url}`;
  const hit = resolvedCache.get(key);
  if (hit != null) return Promise.resolve(hit);
  if (attemptedUrls.has(key)) return Promise.resolve(url);
  const pending = pendingUrls.get(key);
  if (pending != null) return pending;
  attemptedUrls.add(key);
  const task = resolveDisplayImageUrl(url, sizeRpx, sizeRpx)
    .then((resolved: string): string => {
      if (resolved != url) resolvedCache.set(key, resolved);
      return resolved;
    })
    .catch((_e: any | null): string => url);
  pendingUrls.set(key, task);
  // task 已被 catch 兜底不会 reject；结算后清在途登记，防 map 无谓增长
  task.then((): void => {
    pendingUrls.delete(key);
  });
  return task;
  // #endif
  // #ifndef H5 || WEB || APP-ANDROID || APP-IOS || APP-HARMONY
  return Promise.resolve(url);
  // #endif
}
