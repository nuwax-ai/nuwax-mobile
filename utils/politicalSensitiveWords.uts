  "毛泽东", "毛澤東",
  "周恩来", "周恩來",
  "刘少奇", "劉少奇",
  "朱德",
  "邓小平", "鄧小平",
  "陈云", "陳雲",
  "华国锋", "華國鋒",
  "胡耀邦",
  "赵紫阳", "趙紫陽",
  "江泽民", "江澤民",
  "李鹏", "李鵬",
  "朱镕基", "朱鎔基",
  "胡锦涛", "胡錦濤",
  "温家宝", "溫家寶",
  "习近平", "習近平",
  "李克强", "李克強",
  "李强", "李強",
  "王沪宁", "王滬寧",
  "赵乐际", "趙樂際",
  "韩正", "韓正",
  "丁薛祥",
  "李希",
  "蔡奇",
  "王岐山",
];

/** 涉台敏感表述、分裂主张与涉台政治人物（简繁各一条）。 */
const TAIWAN_WORDS: string[] = [
  // —— 分裂主张 / 错误表述 ——
  "台独", "台獨",
  "台湾独立", "台灣獨立",
  "台湾国", "台灣國",
  "台湾共和国", "台灣共和國",
  "台湾人民共和国", "台灣人民共和國",
  "台湾共和国临时政府", "台灣共和國臨時政府",
  "台湾建国", "台灣建國",
  "台湾独立建国", "台灣獨立建國",
  "台湾独立运动", "台灣獨立運動",
  "台湾独立党", "台灣獨立黨",
  "台湾民政府", "台灣民政府",
  "台湾正名", "台灣正名",
  "台湾地位未定论", "台灣地位未定論",
  "一中一台",
  "两个中国", "兩個中國",
  "两国论", "兩國論",
  "特殊两国论", "特殊兩國論",
  "一边一国", "一邊一國",
  "台湾主权", "台灣主權",
  "台湾主权独立", "台灣主權獨立",
  "中华民国台湾", "中華民國台灣",
  "中华民国台湾政府", "中華民國台灣政府",
  "中华民国是独立国家", "中華民國是獨立國家",
  "台湾不是中国", "台灣不是中國",
  "台湾不属于中国", "台灣不屬於中國",
  "台湾人不是中国人", "台灣人不是中國人",
  "台湾是独立国家", "台灣是獨立國家",
  "台湾是一个国家", "台灣是一個國家",
  "台湾民族", "台灣民族",
  "台湾民族主义", "台灣民族主義",
  "台湾建国运动", "台灣建國運動",
  "制宪正名", "制憲正名",
  "入联公投", "入聯公投",
  "去中国化", "去中國化",
  // —— 涉台政治人物 ——
  "蔡英文",
  "赖清德", "賴清德",
  "李登辉", "李登輝",
  "陈水扁", "陳水扁",
  "苏贞昌", "蘇貞昌",
  "游锡堃", "游錫堃",
  "吴钊燮", "吳釗燮",
  "萧美琴", "蕭美琴",
  "卓荣泰", "卓榮泰",
  "吕秀莲", "呂秀蓮",
  "谢长廷", "謝長廷",
  // —— 涉台政党 / 组织 ——
  "民主进步党", "民主進步黨",
  "民进党", "民進黨",
  "台湾基进", "台灣基進",
  "时代力量", "時代力量",
];

/**
 * 归一化时直接丢弃的字符：空白、中英文标点、常见分隔符、数字。
 * 数字也丢弃，用于对抗「习近1平」这类插字规避；人名本身不含数字，不会误伤。
 */
const SENSITIVE_CHECK_SEPARATORS =
  " \t\r\n 　·•・.．。,，、;；:：'\"‘’“”`-_~!！?？()（）[]【】{}<>《》/\\|+&#@$%^=*—－0123456789０１２３４５６７８９";

/** 零宽 / 不可见字符（常被用来把敏感词拆开）。 */
function isInvisibleCodePoint(code: number): boolean {
  return code == 0x200b || code == 0x200c || code == 0x200d || code == 0x2060 || code == 0xfeff || code == 0x00ad;
}

/**
 * 归一化待校验文本：转小写（英文场景）并去掉空白、标点、数字、零宽字符，
 * 得到连续字符序列后再做子串匹配，可覆盖插入分隔符的变体写法。
 */
export function normalizeForSensitiveCheck(raw: string): string {
  const lower = raw.toLowerCase();
  let out = "";
  for (let i = 0; i < lower.length; i++) {
    const ch = lower.substring(i, i + 1);
    if (SENSITIVE_CHECK_SEPARATORS.indexOf(ch) >= 0) {
      continue;
    }
    // charCodeAt 返回 Number?，UTS 需显式收窄
    const code = ch.charCodeAt(0) as number;
    if (isInvisibleCodePoint(code)) {
      continue;
    }
    out += ch;
  }
  return out;
}

/** 归一化文本中是否包含给定词表中的任一词条。 */
function containsAnyWord(compactText: string, words: string[]): boolean {
  for (let i = 0; i < words.length; i++) {
    if (compactText.indexOf(words[i]) >= 0) {
      return true;
    }
  }
  return false;
}

/** 文本是否命中政治敏感词（含去空白/标点/数字/零宽字符后的变体）。空文本恒为 false。 */
export function containsPoliticalSensitiveWord(raw: string): boolean {
  if (raw.length == 0) {
    return false;
  }
  const compactText = normalizeForSensitiveCheck(raw);
  if (compactText.length == 0) {
    return false;
  }
  return containsAnyWord(compactText, LEADER_WORDS) || containsAnyWord(compactText, TAIWAN_WORDS);
}
