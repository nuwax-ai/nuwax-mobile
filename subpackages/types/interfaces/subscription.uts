  MANUAL_DEDUCT = 'MANUAL_DEDUCT',
}

export interface CreditRecordInfo {
  id: number;
  userId: number;
  batchNo: string;
  creditType: string;
  creditTypeName: string;
  operationType: number; // 1-增加，2-扣减
  operationTypeName: string;
  amount: number;
  beforeAmount: number;
  afterAmount: number;
  bizNo: string;
  created: string;
  remark: string;
}

export type MySubscriptionPlanInfo = {
  id: number;
  name: string;
  description: string | null;
  price: number;
  firstPrice: number;
  period: string;
  creditAmount: number;
  callLimitCount: number | null;
  functionOnly: boolean | null;
  dailyGiftCreditAmount: number | null;
  isHot: boolean | null;
}

export type MySubscriptionItem = {
  id: number | null;
  planId: number;
  planName: string;
  bizType: string | null;
  bizId: number | null;
  bizName: string | null;
  icon: string | null;
  period: string | null;
  startTime: string | null;
  endTime: string | null;
  status: string;
  plan: MySubscriptionPlanInfo;
  callUsedCount: number | null;
  nextResetTime: string | null;
  created: string | null;
  modified: string | null;
}

export interface MySubscriptionData {
  currentSubscription: MySubscriptionItem | null;
  subscriptions: MySubscriptionItem[];
}

export interface CreditSummaryInfo {
  totalCredit: number;
  subscriptionCredit: number;
  purchaseCredit: number;
  activityCredit: number;
}

export interface CreditPackageInfo {
  id: number;
  packageName: string;
  creditAmount: number;
  price: number;
  sort: number;
  status: number;
  period: string;
  remark: string;
}

export type CreditBatchExtra = {
  price: number;
}

export type CreditBatchItem = {
  id: number;
  batchNo: string;
  creditType: string;
  totalAmount: number;
  usedAmount: number;
  remainAmount: number;
  expireTime: string;
  expired: boolean;
  remark: string;
  extra: CreditBatchExtra | null;
  created: string;
}

export type SystemSubscriptionPlanItem = {
  name: string;
  description: string;
  icon: string;
  selected: boolean;
}

export type SystemSubscriptionPlanGroup = {
  name: string;
  description: string;
  groupType: string;
  items: SystemSubscriptionPlanItem[];
}

export type SystemSubscriptionPlan = {
  id: number;
  name: string;
  description: string;
  price: number;
  firstPrice: number;
  period: string;
  creditAmount: number;
  callLimitCount: number;
  functionOnly: boolean;
  dailyGiftCreditAmount: number;
  isHot: boolean;
  status: number;
  sort: number;
  itemGroups: SystemSubscriptionPlanGroup[];
}

export interface CashierInfo {
  cashierUrl: string;
}

export enum PayMode {
  scan = 'scan',
  minipay = 'minipay',
  h5 = 'h5',
  app = 'app',
}

export enum PayChannel {
  WxPay = 'WxPay',
  AliPay = 'AliPay',
}

export interface WxPayParams {
  timeStamp: string;
  nonceStr: string;
  packageValue: string;
  signType: string;
  paySign: string;
}

export interface MinipayResult {
  wxPayParams: WxPayParams | null;
}

export enum AppPayInvokeType {
  REDIRECT_URL = 'REDIRECT_URL',
  QRCODE_FALLBACK = 'QRCODE_FALLBACK',
}

export interface AppNativePayRequest {
  orderId: number;
  payChannel: PayChannel;
}

export interface AppNativePayResult {
  gatewayPaymentOrderNo: string | null;
  gatewayPaymentTxNo: string | null;
  payMode: string;
  payChannel: PayChannel;
  status: PayStatus;
  invokeType: string;
  redirectUrl: string | null;
  wxPayParams: WxPayParams | null;
  qrCodeContent: string | null;
}

export enum PayStatus {
  PENDING = 'PENDING',
  PROCESSING = 'PROCESSING',
  SUCCESS = 'SUCCESS',
  FAILED = 'FAILED',
  CLOSED = 'CLOSED',
}

export enum OrderStatus {
  PENDING = 'PENDING',
  PAID = 'PAID',
  CANCELLED = 'CANCELLED',
}

export interface SettlementStatusInfo {
  orderId: number;
  payStatus: PayStatus;
  orderStatus: OrderStatus;
  settled: boolean;
  terminalFailed: boolean;
  message: string;
}

export type CreateSubscriptionOrderRequest = {
  planId: number;
  payMode: PayMode;
};

export type CreateCreditOrderRequest = {
  packageId: number;
  payMode: PayMode;
};

export type CreateDeskBuddyOrderRequest = {
  // 商品 ID（来自 listGoods；后端未启用则留空，form 体不带该字段）
  goodsId: string;
  name: string;
  phone: string;
  address: string;
  payMode: PayMode;
};

export interface PayMinipayRequest {
  orderId: number;
  payChannel: PayChannel;
  wxLoginCode: string;
  alipayAuthCode?: string;
}

export interface GetSettlementStatusRequest {
  orderId: number;
}

// ===== 我的订单（账单中心） =====

