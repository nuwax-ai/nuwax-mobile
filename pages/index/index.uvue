  .create-hub__tools-panel-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    /* 右侧留白避让悬浮的收起图标 */
    padding: 12rpx 88rpx 16rpx 32rpx;
  }

  .create-hub__tools-panel-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 60rpx;
    padding: 0 24rpx;
    margin: 8rpx 12rpx 0 0;
    border-radius: 999rpx;
    background-color: #ffffff;
  }

  .create-hub__tools-panel-item-text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #44444c;
    lines: 1;
  }

  .create-hub__tools-panel-item--on .create-hub__tools-panel-item-text {
    color: #5147ff;
  }

  /* Android / 鸿蒙离线包预热容器：1px 隐藏 + 裁剪，仅为触发 WebView 的 JS 编译缓存；
     内部组件根节点自带 100% 尺寸，宿主必须显式限位防其撑满全屏吞掉点击 */
  .offline-warmup-host {
    position: fixed;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
  }

  /* #ifdef APP-IOS */
  .resident-chat-opening-cover {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    /* 必须高于 resident-chat-shell(10000)，否则换会话时仍会透出上一会话 */
    z-index: 10001;
  }
  /* #endif */
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
