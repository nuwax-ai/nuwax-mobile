<template>
  <view class="preview">
    <text v-if="loading" class="loading">{{ loadingText }}</text>
    <video v-if="ready && src.length > 0" id="stagedVideoPreview" class="player"
      :src="src" :controls="true" :autoplay="false" object-fit="contain" @error="handleVideoError" />
  </view>
</template>

<script setup lang="uts">
  import { nextTick, ref } from "vue";
  import { onLoad, onReady, onShow, onHide, onUnload } from "@dcloudio/uni-app";
  import { emptyI18nParams, t } from "@/utils/i18n";
  import { resolveLocalVideoPreviewPath } from "@/utils/fileUploader";

  // 本页只供相册待发送视频预览；聊天消息全屏复用行内原生播放器。
  const src = ref<string>("");
  const ready = ref<boolean>(false);
  const loading = ref<boolean>(false);
  const loadingText = t("Mobile.Common.loading", emptyI18nParams(), "");
  let previewAlive = true;
  let previewVisible = true;
  let previewPlayer: UniVideoElement | null = null;

  function preparePreviewPlayer(): void {
    nextTick((): void => {
      if (!previewAlive || !previewVisible || !ready.value || src.value.length == 0) return;
      // #ifdef APP || WEB
      previewPlayer = uni.getElementById("stagedVideoPreview") as UniVideoElement | null;
      // #endif
    });
  }

  function pausePreview(): void {
    // #ifdef APP || WEB
    const player = previewPlayer;
    if (player != null) {
      try { player.pause(); } catch (_error) {}
    }
    // #endif
    // #ifdef MP-WEIXIN
    uni.createVideoContext("stagedVideoPreview").pause();
    // #endif
  }

  function handleError(): void {
    uni.showToast({ title: t("Mobile.Message.videoPlayFailed", emptyI18nParams(), ""), icon: "none" });
  }

  function handleVideoError(_event: UniVideoErrorEvent): void {
    if (!previewAlive || !previewVisible) return;
    handleError();
  }

  async function loadPreview(path: string): Promise<void> {
    loading.value = true;
    try {
      const playablePath = await resolveLocalVideoPreviewPath(path);
      if (!previewAlive) return;
      src.value = playablePath;
      preparePreviewPlayer();
    } catch (_error) {
      if (!previewAlive || !previewVisible) return;
      handleError();
    } finally {
      if (previewAlive) loading.value = false;
    }
  }

  onLoad((options) => {
    const raw = options != null ? options["src"] : null;
    if (raw == null) return;
    try {
      // 仅解外层路由编码；保留 content URI 内部的 %3A/%2F，避免破坏 Android 授权。
      const value = `${raw}`;
      const path = value.startsWith("/") || value.indexOf("://") > 0 || value.startsWith("blob:")
        ? value : decodeURIComponent(value);
      if (path == null || path.length == 0) {
        handleError();
        return;
      }
      loadPreview(path);
    } catch (_e) {
      handleError();
    }
  });
  onReady(() => { ready.value = true; preparePreviewPlayer(); });
  onShow(() => { previewVisible = true; preparePreviewPlayer(); });
  onHide(() => { previewVisible = false; pausePreview(); });
  onUnload(() => {
    previewAlive = false;
    previewPlayer = null;
    // iOS 原生 document 此时可能已销毁，不查元素、不调用 pause。
  });
</script>

<style lang="scss" scoped>
  .preview { display: flex; flex-direction: column; flex: 1; background-color: #000000; justify-content: center; }
  .player { width: 100%; height: 100%; }
  .loading { color: #ffffff; font-size: 14px; text-align: center; }
</style>
