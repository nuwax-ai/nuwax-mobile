# 拷贝为 local-secrets.env（已 gitignore），填本机值。
#   cp scripts/local-secrets.env.example scripts/local-secrets.env
#
# 亦可使用 nuwax-signing 权威副本（推荐）：
#   $NUWAX_SIGNING_HOME/local-secrets.env
# scripts/local-base-env.sh 会优先加载本目录 local-secrets.env，再回退 nuwax-signing。
#
# DCLOUD_APPKEY：DCloud 离线打包 AppKey
# IOS_DEVELOPMENT_TEAM：Apple Developer Team ID
# IOS_PROVISIONING_PROFILE_UUID：描述文件 UUID（Xcode 自动签名可留空）
# ESP_DEV_POP：ESP32 开发联调 PoP（Security 2，仅联调固件）
# ANDROID_RELEASE_*：应用市场正式签名
export DCLOUD_APPKEY=
export IOS_DEVELOPMENT_TEAM=
export IOS_PROVISIONING_PROFILE_UUID=
export ESP_DEV_POP=
export ANDROID_RELEASE_STORE_FILE="${NUWAX_SIGNING_HOME:-$HOME/workspace/nuwax-signing}/android/nuwax-release.jks"
export ANDROID_RELEASE_STORE_TYPE="JKS"
export ANDROID_RELEASE_STORE_PASSWORD=''
export ANDROID_RELEASE_KEY_ALIAS="nuwax-release"
export ANDROID_RELEASE_KEY_PASSWORD=''
export ANDROID_SIGNING_MODE="release"
