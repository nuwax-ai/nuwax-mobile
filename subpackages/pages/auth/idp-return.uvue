<template>
  <view class="idp-return">
    <text class="return-title">{{ t('Mobile.Auth.idpReturning') }}</text>
    <text v-if="errorText.length > 0" class="return-error">{{ errorText }}</text>
    <button v-if="errorText.length > 0" class="return-button" :disabled="busy" :loading="busy" @click="verifySession">
      {{ t('Mobile.Common.retry') }}
    </button>
    <button class="return-local" :disabled="busy" @click="returnToLogin">{{ t('Mobile.Auth.backToLogin') }}</button>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted, onUnmounted } from 'vue';
import { apiAuthIdpSession } from '@/servers/authIdp';
import { apiResCode, apiResData } from '@/utils/apiResponse';
import { SUCCESS_CODE } from '@/constants/codes.constants';
import { getApiBaseUrl } from '@/constants/config';
import { AuthLoadScope, isAuthId, resolveMobileAuthReturn } from '@/utils/authIdp';
import { authBrowserQuery, authBrowserOrigin, canUseBrowserIdp, finishBrowserLogin, idpLoginEntryUrl } from '@/utils/idpNavigation';
import { notifyImSessionReady } from '@/utils/im/imSessionScope';
import { markLoginCheckPending } from '@/utils/profileSetupGate';
import { useI18n, emptyI18nParams } from '@/utils/i18n';

const { t: translate } = useI18n();
const t = (key: string): string => translate(key, emptyI18nParams(), '');
const busy = ref<boolean>(false);
const errorText = ref<string>('');
const scope = new AuthLoadScope();
let returnPath = '';

async function verifySession(): Promise<void> {
  if (busy.value) return;
  if (!canUseBrowserIdp()) { errorText.value = t('Mobile.Auth.idpUnavailable'); return; }
  busy.value = true;
  errorText.value = '';
  const revision = scope.begin();
  const origin = getApiBaseUrl();
  try {
    const response = await apiAuthIdpSession();
    if (!scope.accepts(revision, origin, getApiBaseUrl())) return;
    const data = apiResData<any>(response);
    // 不能仅凭回调参数或本地可读 Cookie 判定成功，必须拿到有效用户。
    const user = data != null ? data as UTSJSONObject : null;
    if (apiResCode(response) != SUCCESS_CODE || user == null || !isAuthId(`${user['id'] ?? ''}`)) {
      errorText.value = t('Mobile.Auth.idpSessionFailed');
      return;
    }
    markLoginCheckPending();
    notifyImSessionReady();
    finishBrowserLogin(returnPath);
  } catch (_error) {
    if (scope.accepts(revision, origin, getApiBaseUrl())) errorText.value = t('Mobile.Auth.idpSessionFailed');
  } finally {
    if (scope.accepts(revision, origin, getApiBaseUrl())) busy.value = false;
  }
}

function returnToLogin(): void {
  scope.invalidate();
  uni.reLaunch({ url: idpLoginEntryUrl(returnPath) });
}

onMounted(() => {
  const target = authBrowserQuery('redirect');
  returnPath = resolveMobileAuthReturn(target != null ? target : '', authBrowserOrigin());
  const error = authBrowserQuery('idpError');
  if (error != null) {
    errorText.value = error.length > 0 ? error.substring(0, 500) : t('Mobile.Auth.idpSessionFailed');
    return;
  }
  verifySession();
});
onUnmounted(() => { scope.invalidate(); });
</script>

<style scoped>
.idp-return { padding: 72px 24px 24px; display: flex; flex-direction: column; align-items: center; }
.return-title { color: #111111; font-size: 18px; margin-bottom: 24px; }
.return-error { color: #b42318; font-size: 14px; margin-bottom: 24px; }
.return-button { width: 100%; background-color: #111111; color: #ffffff; font-size: 15px; border-radius: 7px; }
.return-local { background-color: transparent; color: #777777; font-size: 14px; margin-top: 16px; }
.return-local::after { border-width: 0; }
</style>
