<template>
    <!-- 微信安全区 -->
	<!-- #ifdef MP-WEIXIN || APP -->
	<view :style="{height:getStatusBarHeight()+ addHeight+'px'}"></view>
	<!-- #endif -->
	<!-- #ifdef H5 || WEB -->
	<!-- App web-view 内嵌页：状态栏/刘海高度由原生侧经 URL fragment 注入（H5 下 getStatusBarHeight 恒为 0），
	     在页面内部做状态栏占位；浏览器直开时不渲染（刘海由浏览器自己处理） -->
	<view v-if="embeddedH5StatusBarPx > 0" :style="{height: embeddedH5StatusBarPx + addHeight + 'px'}"></view>
	<!-- #endif -->
</template>
<script setup lang="uts">
import { getStatusBarHeight, getEmbeddedStatusBarHeight } from '@/utils/system.uts'
const props = defineProps({
    addHeight: {
        type: Number,
        default: 0
    }
})

// H5 内嵌页状态栏高度（px）：reactive ref，onLoad 注入晚于首帧时也能自动补上；0 = 非内嵌/未知 → 不渲染占位
const embeddedH5StatusBarPx = getEmbeddedStatusBarHeight();

</script>
