import { firstString, orEmpty } from "@/utils/utsCoalesce";

class MathDelimiter {
  left: string = "";
  right: string = "";
  display: boolean = false;
}

function createMathDelimiter(
  left: string,
  right: string,
  display: boolean,
): MathDelimiter {
  const item = new MathDelimiter();
  item.left = left;
  item.right = right;
  item.display = display;
  return item;
}

const defaultDelimiters: MathDelimiter[] = [
  createMathDelimiter("\\[", "\\]", true),
  createMathDelimiter("\\(", "\\)", false),
];

class BracketMatchResult {
  formula: string = "";
  display: boolean = false;
  start: number = 0;
  end: number = 0;
  left: string = "";
  right: string = "";
  success: boolean = false;
}

function createBracketMatchSuccess(
  formula: string,
  display: boolean,
  start: number,
  end: number,
  left: string,
  right: string,
): BracketMatchResult {
  const result = new BracketMatchResult();
  result.formula = formula;
  result.display = display;
  result.start = start;
  result.end = end;
  result.left = left;
  result.right = right;
  result.success = true;
  return result;
}

function createBracketMatchFailure(): BracketMatchResult {
  return new BracketMatchResult();
}

// 转义括号规则 - 通用数学公式解析器
function escapedBracketRule(delimiters: MathDelimiter[]) {
  return (text: string, startPos: number): BracketMatchResult => {
    const max = text.length;
    const start = startPos;

    for (let di = 0; di < delimiters.length; di++) {
      const delimiter = delimiters[di];
      const left = delimiter.left;
      const right = delimiter.right;
      const display = delimiter.display;

      // 检查是否以左标记开始
      if (!text.slice(start).startsWith(left)) {
        continue;
      }

      // 跳过左标记的长度
      let pos = start + left.length;

      // 寻找匹配的右标记
      while (pos < max) {
        if (text.slice(pos).startsWith(right)) {
          break;
        }
        pos++;
      }

      // 没找到匹配的右标记，跳过，进入下个匹配
      if (pos >= max) {
        continue;
      }

      // 提取数学公式内容
      const content = text.slice(start + left.length, pos);
      const endPos = pos + right.length;

      return createBracketMatchSuccess(
        content,
        display,
        start,
        endPos,
        left,
        right,
      );
    }

    return createBracketMatchFailure();
  };
}

/**
 * 根据规则将连续的过程标签（ToolCall, Skill等）合并
 * 规则：
 * 1. 连续 2 个及以上的过程标签合并
 * 2. 中间包含“执行计划”的不合并（作为分隔符）
 * 3. 标签间只包含空白字符时不中断合并
 * 4. 支持 :::container 语法和 PC 端的 HTML 标签语法
 * @param text - 待处理的 Markdown 文本
 * @returns 处理后的文本
 */
class MarkdownContainerMatch {
  index: number = 0;
  endIndex: number = 0;
  executeId: string = "";
  fullMatch: string = "";
  tagMatch: string = "";
  isPlan: boolean = false;
}

function dedupeMarkdownContainers(text: string): string {
  if (text.length === 0) return "";

  const blockRegex =
    /(?:[\r\n\s]*)(?:(?:<(?:div|p)\b[^>]*>)?\s*(<markdown-custom-process\b[^>]*?>(?:<\/markdown-custom-process>|\/>)?)\s*(?:<\/(?:div|p)>)?|(:::container\b[^\n]*?\n:::))/g;

  const matches: MarkdownContainerMatch[] = [];

  const lastIndexMap = new Map<string, number>();
  let match = blockRegex.exec(text);
  while (match != null) {
    const fullMatch = match[0];
    const tagMatch = firstString([match[1] as any, match[2] as any]);
    const executeId = extractAttribute(tagMatch, "executeId");

    if (executeId.length > 0) {
      const type = extractAttribute(tagMatch, "type");
      const isPlan = type === "Plan";

      const item = new MarkdownContainerMatch();
      item.index = match.index;
      item.endIndex = blockRegex.lastIndex;
      item.executeId = executeId;
      item.fullMatch = orEmpty(fullMatch);
      item.tagMatch = tagMatch;
      item.isPlan = isPlan;
      matches.push(item);
      lastIndexMap.set(executeId, match.index);
    }
    match = blockRegex.exec(text);
  }

  const ignoreMatchIndices = new Set<number>();
  for (let i = 0; i < matches.length; i++) {
    const m = matches[i];

    if (lastIndexMap.get(m.executeId) !== m.index) {
      ignoreMatchIndices.add(i);
      continue;
    }

    if (m.isPlan) {
      let nextPlanIndex = -1;
      for (let j = i + 1; j < matches.length; j++) {
        const next = matches[j];
        if (next.isPlan) {
          const middleText = text.slice(m.endIndex, next.index);
          if (middleText.trim() === "") {
            nextPlanIndex = j;
          }
          break;
        } else {
          break;
        }
      }

      if (nextPlanIndex !== -1) {
        ignoreMatchIndices.add(i);
      }
    }
  }

  let dedupedText = "";
  let lastPos = 0;

  for (let i = 0; i < matches.length; i++) {
    const m = matches[i];
    if (ignoreMatchIndices.has(i)) {
      dedupedText += text.slice(lastPos, m.index);
      lastPos = m.endIndex;
    }
  }
  dedupedText += text.slice(lastPos);

  return dedupedText;
}

/**
 * 根据规则将连续的过程标签（ToolCall, Skill等）合并
 * 规则：
 * 1. 连续 2 个及以上的过程标签合并
 * 2. 中间包含“执行计划”的不合并（作为分隔符）
 * 3. 标签间只包含空白字符时不中断合并
 * 4. 支持 :::container 语法和 PC 端的 HTML 标签语法
 * @param text - 待处理 of Markdown 文本
 * @returns 处理后的文本
 */
export function groupMarkdownContainers(text: string): string {
  if (text.length === 0) return "";

  // 预处理：合并连续相同的 Plan 并去重重复的自定义容器
  const dedupedText = dedupeMarkdownContainers(text);

  // 1. 匹配 HTML 格式的过程标签 (markdown-custom-process)
  // 2. 匹配 :::container 格式的标签
  const blockRegex =
    /(?:[\r\n\s]*)(?:(?:<(?:div|p)\b[^>]*>)?\s*(<markdown-custom-process\b[^>]*?>(?:<\/markdown-custom-process>|\/>)?)\s*(?:<\/(?:div|p)>)?|(:::container\b[^\n]*?\n:::))/g;

  let result = "";
  let lastIndex = 0;
  let currentGroup: string[] = [];
  let normalizedGroup: string[] = [];

  const flushGroup = () => {
    if (currentGroup.length > 0) {
      if (currentGroup.length >= 2) {
        // 多个时，为了支持层级，必须使用规范化后的 HTML 标签
        const groupContent = `\n\n<markdown-custom-process-group>\n${normalizedGroup.join("\n")}\n</markdown-custom-process-group>\n\n`;
        result += groupContent;
      } else {
        // 只有一个工具时，直接输出规范化后的 HTML 标签，避免 H5 上 markdown-it 容器插件将 ::: 转为 <container data={JSON}>
        // 导致 <markdown-container> 组件取到的 data 为字符串而非对象，无法渲染属性
        result += `\n\n${normalizedGroup[0]}\n\n`;
      }
      currentGroup = [] as string[];
      normalizedGroup = [] as string[];
    }
  };

  let count = 0;
  let match = blockRegex.exec(dedupedText);
  while (match != null) {
    count++;
    const textBefore = dedupedText.slice(lastIndex, match.index);

    if (textBefore.trim() !== "") {
      flushGroup();
      result += textBefore;
    } else {
      if (currentGroup.length === 0) {
        result += textBefore;
      }
    }

    let tagMatch = firstString([match[1] as any, match[2] as any]);

    // 为了分组显示，我们依然需要一份规范化后的 HTML 标签
    let normalizedTag = "";
    if (tagMatch.startsWith(":::container")) {
      const executeId = extractAttribute(tagMatch, "executeId");
      const type = extractAttribute(tagMatch, "type");
      const status = extractAttribute(tagMatch, "status");
      const name = extractAttribute(tagMatch, "name");
      const safeName = name.replace(/"/g, "&quot;");
      normalizedTag = `<markdown-custom-process executeid="${executeId}" type="${orEmpty(type)}" status="${orEmpty(status)}" name="${safeName}"></markdown-custom-process>`;
    } else {
      normalizedTag = tagMatch;
      if (
        !normalizedTag.includes("</markdown-custom-process>") &&
        !normalizedTag.endsWith("/>")
      ) {
        normalizedTag = normalizedTag.replace(
          ">",
          "></markdown-custom-process>",
        );
      }
    }

    const isPlan = /type=["']Plan["']/.test(normalizedTag);
    if (isPlan) {
      flushGroup();
      // Plan 类型保持原样输出
      result += `\n\n${tagMatch}\n\n`;
    } else {
      currentGroup.push(tagMatch);
      normalizedGroup.push(normalizedTag);
    }

    lastIndex = blockRegex.lastIndex;
    match = blockRegex.exec(dedupedText);
  }

  flushGroup();
  result += dedupedText.slice(lastIndex);

  const finalResult = result.replace(/\n{3,}/g, "\n\n").trim();
  return finalResult;
}

/**
 * 从属性字符串中提取指定属性的值
 */
function extractAttribute(attrString: string, attrName: string): string {
  // 先尝试双引号
  let regex = new RegExp(`${attrName}="([^"]*)"`);
  let match = attrString.match(regex);
  if (match != null) {
    return orEmpty(match[1]).replace(/&quot;/g, '"');
  }
  // 再尝试单引号
  regex = new RegExp(`${attrName}='([^']*)'`);
  match = attrString.match(regex);
  if (match != null) {
    return orEmpty(match[1]).replace(/&quot;/g, '"');
  }
  return "";
}

// 新的数学公式替换函数 - 直接替换为 $$ 分隔符
export function replaceMathBracket(text: string): string {
  // return text; //临时关闭

  // 创建只包含非美元符号分隔符的选项
  const nonDollarDelimiters: MathDelimiter[] = [];
  for (let i = 0; i < defaultDelimiters.length; i++) {
    const delimiter = defaultDelimiters[i];
    if (
      !delimiter.left.includes("$") &&
      !delimiter.right.includes("$")
    ) {
      nonDollarDelimiters.push(delimiter);
    }
  }

  const rule = escapedBracketRule(nonDollarDelimiters);
  let result = "";
  let pos = 0;

  while (pos < text.length) {
    const match = rule(text, pos);
    if (match.success) {
      // 添加匹配前的文本
      result += text.slice(pos, match.start);
      // 替换为 $$ 分隔符
      const delimiter = match.display ? "$$" : "$";
      result += `${delimiter}${match.formula}${delimiter}`;
      pos = match.end;
    } else {
      // 没有匹配，添加当前字符
      result += text[pos];
      pos++;
    }
  }

  return result;
}
