import { ACCESS_TOKEN, ACCESS_TOKEN_ORIGIN } from "@/constants/home.constants";
import eventBus from "@/utils/eventBus";

export const IM_SESSION_CLEARED = "im_session_cleared";
export const IM_SESSION_READY = "im_session_ready";
let sessionEpoch = 0;

/** 仅用于内存中的相等比较，禁止输出到日志（包含 token）。 */
export function getImSessionStamp(): string {
  const token = uni.getStorageSync(ACCESS_TOKEN);
  const origin = uni.getStorageSync(ACCESS_TOKEN_ORIGIN);
  return `${sessionEpoch}|${token ?? ""}|${origin ?? ""}`;
}

export function invalidateImSession(): void {
  sessionEpoch += 1;
  eventBus.emit(IM_SESSION_CLEARED, {});
}

export function notifyImSessionReady(): void {
  eventBus.emit(IM_SESSION_READY, {});
}
