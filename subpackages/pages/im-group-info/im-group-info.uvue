<template>
  <view class="gi-page">
    <safety-zone />

    <!-- 顶部：返回 + 设置（与聊天页同款双段头） -->
    <view class="gi-header">
      <view class="gi-header__btn" hover-class="gi-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="gi-header__title-wrap">
        <text class="gi-header__title">{{ t("Mobile.Message.groupSettingsTitle") }}</text>
      </view>
      <view class="gi-header__btn gi-header__btn--ghost" />
    </view>

    <scroll-view class="gi-body" direction="vertical" :show-scrollbar="false">
      <view v-if="loading" class="gi-state">
        <text class="gi-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view v-else-if="loadFailed" class="gi-state" @click="handleRetry">
        <text class="gi-state__text">{{ t("Mobile.Message.loadFailed") }}</text>
      </view>
      <view v-else class="gi-list">

        <!-- 群概览：头像 + 群名 + 成员数 -->
        <view class="gi-card">
          <view class="gi-group-row">
            <image
              v-if="groupAvatar.length > 0 && avatarFailed != true"
              class="gi-group-ava"
              :src="groupAvatar"
              mode="aspectFill"
              @error="handleAvatarError"
            />
            <view v-else class="gi-group-ava" :style="{ backgroundImage: avatarGradient(groupName) }">
              <text class="gi-group-ava-letter">{{ avatarLetter(groupName) }}</text>
            </view>
            <view class="gi-group-col">
              <text class="gi-group-name text-ellipsis">{{ groupName }}</text>
              <text class="gi-group-count">{{ memberCountText }}</text>
            </view>
          </view>
        </view>

        <!-- 群公告（单行预览，点进公告页查看/编辑） -->
        <view class="gi-card">
          <view class="gi-cell" hover-class="gi-cell--active" @click="openNotice">
            <view class="gi-cell__icon-wrap">
              <svg-icon name="icon-voice-1" size="36" color="#5147ff" />
            </view>
            <text class="gi-cell__label">{{ t("Mobile.Message.groupNotice") }}</text>
            <view class="gi-cell__space" />
            <text
              class="gi-cell__value text-ellipsis"
              :class="noticeText.length > 0 ? '' : 'gi-cell__value--grey'"
            >{{ noticePreview }}</text>
            <svg-icon name="icon-a-Chevronright" size="28" color="#c3c1cd" />
          </view>
        </view>

        <!-- 群成员：固定一行头像（个数按模块内宽动态计算，添加圆占 1 格），
             行尾数字即成员数（点头部行进成员页） -->
        <view class="gi-card">
          <view class="gi-member-head" hover-class="gi-member-head--active" @click="openMembers">
            <text class="gi-cell__label">{{ t("Mobile.Message.groupMembersLabel") }}</text>
            <view class="gi-cell__space" />
            <text class="gi-member-more">{{ memberCountText }}</text>
            <svg-icon name="icon-a-Chevronright" size="28" color="#c3c1cd" />
          </view>
          <view class="gi-strip">
            <view class="gi-strip__row">
              <view v-for="m in stripMembers" :key="m.userId" class="gi-member-cell">
                <image
                  v-if="m.avatar.length > 0 && m.avatarFailed != true"
                  class="gi-member-ava"
                  :src="m.avatar"
                  mode="aspectFill"
                  @error="handleMemberAvatarError(m)"
                />
                <view v-else class="gi-member-ava" :style="{ backgroundImage: avatarGradient(m.token) }">
                  <text class="gi-member-ava-letter">{{ avatarLetter(m.token) }}</text>
                </view>
              </view>
              <view
                v-if="canAdd"
                class="gi-member-cell"
                hover-class="gi-member-cell--active"
                @click="openAddMember"
              >
                <view class="gi-member-op">
                  <svg-icon name="icon-Plus" size="36" color="#9a98a5" />
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 功能 cells：入群申请（管理员）/ 群管理
             （群文件与资料库入口已移至聊天页子页签行，本页不再重复） -->
        <view class="gi-card">
          <view
            v-if="canGovern"
            class="gi-cell"
            hover-class="gi-cell--active"
            @click="openJoinRequests"
          >
            <view class="gi-cell__icon-wrap">
              <svg-icon name="icon-User" size="36" color="#5147ff" />
            </view>
            <text class="gi-cell__label">{{ t("Mobile.Message.joinRequests") }}</text>
            <view class="gi-cell__space" />
            <view v-if="joinPending > 0" class="gi-badge">
              <text class="gi-badge__text">{{ joinPending > 99 ? "99+" : `${joinPending}` }}</text>
            </view>
            <svg-icon name="icon-a-Chevronright" size="28" color="#c3c1cd" />
          </view>
          <view class="gi-divider" v-if="canGovern" />
          <view class="gi-cell" hover-class="gi-cell--active" @click="openSettings">
            <view class="gi-cell__icon-wrap">
              <svg-icon name="icon-settings" size="36" color="#5147ff" />
            </view>
            <text class="gi-cell__label">{{ t("Mobile.Message.groupManage") }}</text>
            <view class="gi-cell__space" />
            <svg-icon name="icon-a-Chevronright" size="28" color="#c3c1cd" />
          </view>
        </view>

        <!-- 我的会话设置：免打扰 / 置顶 -->
        <view class="gi-card">
          <view class="gi-cell">
            <view class="gi-cell__icon-wrap">
              <svg-icon name="icon-bell" size="36" color="#5147ff" />
            </view>
            <text class="gi-cell__label">{{ t("Mobile.Message.msgDndLabel") }}</text>
            <view class="gi-cell__space" />
            <switch class="gi-switch" :checked="dndFlag" color="#5147ff" @change="handleDndChange" />
          </view>
          <view class="gi-divider" />
          <view class="gi-cell">
            <view class="gi-cell__icon-wrap">
              <svg-icon name="icon-List" size="36" color="#5147ff" />
            </view>
            <text class="gi-cell__label">{{ t("Mobile.Message.pinChatLabel") }}</text>
            <view class="gi-cell__space" />
            <switch class="gi-switch" :checked="topFlag" color="#5147ff" @change="handleTopChange" />
          </view>
        </view>

        <!-- 退出群聊（群主不见此入口：先去群管理转让/解散） -->
        <view v-if="myRole != 3" class="gi-card">
          <view class="gi-leave" hover-class="gi-leave--active" @click="handleLeaveTap">
            <text class="gi-leave__text">{{ t("Mobile.Message.groupLeaveEntry") }}</text>
          </view>
        </view>

        <view class="gi-tail" />
      </view>
    </scroll-view>

    <!-- 紧凑确认弹窗（退出群聊二次确认，替代系统 showModal 样式） -->
    <confirm-modal ref="confirmModalRef" @confirm="leaveGroup" />

    <!-- 添加成员：复用添加伙伴弹窗（群模式，与群成员页「添加」同款） -->
    <add-buddy-sheet ref="addBuddySheetRef" @added="handleMemberAdded" />
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, type ComponentPublicInstance } from "vue";
  import { onLoad, onShow } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import {
    apiImConvDetail,
    apiImConvMembers,
    apiImConvSetDnd,
    apiImConvSetTop,
    apiImGroupLeave,
    apiImJoinRequests,
  } from "@/servers/im";
  import type { RequestResponse } from "@/types/interfaces/request";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { resolveDisplayImageUrl } from "@/utils/remoteSvgImage";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import ConfirmModal from "@/components/confirm-modal/confirm-modal.uvue";
  import AddBuddySheet from "@/components/add-buddy-sheet/add-buddy-sheet.uvue";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 头像字母底色渐变板（与消息/聊天页同款六色系）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #f59a9a, #e05f5f)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  // ===== 头像条格子几何（rpx，与样式保持同步）：圆片 76 + 右间隔 12；
  //     卡片内左右留白合计 120（body 32×2 + 卡 28×2） =====
  const STRIP_CELL_RPX = 76;
  const STRIP_GAP_RPX = 12;
  const STRIP_INSET_RPX = 120;

  /** 一行格子数（成员头像 + 添加圆）：按模块实际内宽动态算，宽屏多显、窄屏少显。 */
  const stripSlots = ref<number>(7);

  /**
   * 重算一行格子数：内宽 = 页面宽 - 留白；每格步进 = 圆片 + 间隔（末格间隔补回）。
   * rpx 折算对齐 pages.json globalStyle.rpxCalcMaxDeviceWidth=960（超宽屏基准封顶）；
   * 取不到窗口信息时保持兜底 7（手机竖屏的标准 6 头像 + 添加圆）。
   */
  function calcStripSlots(): void {
    try {
      const win = uni.getWindowInfo();
      const capped = win.windowWidth > 960 ? 960 : win.windowWidth;
      const scale = capped / 750;
      if (scale <= 0) {
        return;
      }
      const innerPx = win.windowWidth - STRIP_INSET_RPX * scale;
      const stridePx = (STRIP_CELL_RPX + STRIP_GAP_RPX) * scale;
      const gapPx = STRIP_GAP_RPX * scale;
      const slots = Math.floor((innerPx + gapPx) / stridePx);
      if (slots > 0) {
        stripSlots.value = slots;
      }
    } catch (_e) {
      // 取不到窗口信息：保持现值（兜底 7）
    }
  }

  /**
   * 群成员行（横滑条数据源，GET /conversations/{convId}/members）。
   * ★userId 是 int64 雪花号：经 `${raw}` 转字符串存用；token 为展示名
   * （nickName > name > 用户{userId}，与聊天页 @面板同口径）。
   */
  class GiMember {
    userId: string = "";
    name: string = "";
    nickName: string = "";
    avatar: string = "";
    token: string = "";
    avatarFailed: boolean = false;
  }

  // ===== 页面入参 =====
  const convId = ref<string>("");

  // ===== 群详情（apiImConvDetail：唯一能拿到 notice/myRole/治理开关的端点） =====
  const groupName = ref<string>("");
  const groupAvatar = ref<string>("");
  const avatarFailed = ref<boolean>(false);
  const noticeText = ref<string>("");
  const memberCount = ref<number>(0);
  /** 我的角色：1=普通成员 2=管理员 3=群主（★对齐服务端 ImConstants；管理权限 = >=2）。 */
  const myRole = ref<number>(1);
  const dndFlag = ref<boolean>(false);
  const topFlag = ref<boolean>(false);
  /** allowMemberInvite 三态原始值：""=键缺失(按默认放行) / "true" / "false"。 */
  let allowInviteRaw = "";

  // ===== 成员 + 入群申请角标 =====
  const members = ref<GiMember[]>([]);
  const joinPending = ref<number>(0);

  // ===== 页面态 =====
  const loading = ref<boolean>(false);
  const loadFailed = ref<boolean>(false);
  let inited = false;

  /** 管理权限（群主+管理员）：公告编辑 / 入群申请入口。 */
  const canGovern = computed((): boolean => myRole.value >= 2);
  /**
   * 添加成员入口：群主/管理员恒可；普通成员按 allowMemberInvite 开关
   * （★与 PC 端同口径 `!== false`：键缺失视为允许，勿用 readBool 把缺失读成关）。
   */
  const canAdd = computed((): boolean => canGovern.value || allowInviteRaw != "false");

  /** 头像条成员：格子数扣除添加圆（canAdd 时占 1 格），余下全给头像。 */
  const stripMembers = computed((): GiMember[] => {
    const max = stripSlots.value - (canAdd.value ? 1 : 0);
    if (max <= 0) {
      return [];
    }
    return members.value.slice(0, max);
  });

  const memberCountText = computed((): string => {
    const params = new Map<string, string | number>();
    params.set("count", memberCount.value);
    return translateFn("Mobile.Message.groupMemberCount", toI18nParams(params), `${memberCount.value}`);
  });

  /** 公告单行预览（换行折成空格，避免一行里挤出 \n）。 */
  const noticePreview = computed((): string => {
    if (noticeText.value.length == 0) {
      return t("Mobile.Message.noticeUnset");
    }
    return noticeText.value.replace(/\n/g, " ");
  });

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  /** URL 入参读取（来源页 encodeURIComponent 写入，容错解码）。 */
  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  function handleAvatarError(): void {
    avatarFailed.value = true;
  }

  function handleMemberAvatarError(m: GiMember): void {
    m.avatarFailed = true;
  }

  /** /api/f/ 受保护群头像：带 Bearer 拉取换成可展示地址，失败回落字母渐变底。 */
  function resolveAvatar(): void {
    const url = groupAvatar.value;
    if (url.length == 0) {
      return;
    }
    resolveDisplayImageUrl(url, 120, 120)
      .then((resolved: string) => {
        if (resolved != url) {
          groupAvatar.value = resolved;
        }
      })
      .catch((_e: any | null) => {
        // 失败保留原地址：交给 <image> 的 error 回落
      });
  }

  /**
   * 详情 + 成员 + 入群申请角标（管理员专属端点，普通成员不调用）。
   * 首次进页给「加载中」态；onShow 返回刷新走静默——保留旧内容原地更新，
   * 避免从子页返回时整页闪成加载态再换回来（用户反馈的「闪动一下」）。
   */
  async function loadAll(): Promise<void> {
    if (convId.value.length == 0 || loading.value) {
      return;
    }
    const silent = inited;
    loading.value = !silent;
    loadFailed.value = false;
    try {
      const res = await apiImConvDetail(convId.value);
      if (apiResCode(res) != SUCCESS_CODE) {
        loading.value = false;
        // 静默刷新失败保留旧内容（仅首次加载才转失败态，可点重试）
        if (!silent) {
          loadFailed.value = true;
        }
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        const name = readString(dataObj, "name");
        if (name.length > 0) {
          groupName.value = name;
        }
        const avatar = readString(dataObj, "avatar");
        if (avatar != groupAvatar.value) {
          avatarFailed.value = false;
          groupAvatar.value = avatar;
          resolveAvatar();
        }
        noticeText.value = readString(dataObj, "notice");
        memberCount.value = readNumber(dataObj, "memberCount", 0);
        myRole.value = readNumber(dataObj, "myRole", 1);
        dndFlag.value = readBool(dataObj, "dnd");
        topFlag.value = readBool(dataObj, "topFlag");
        const inviteRaw = dataObj["allowMemberInvite"];
        allowInviteRaw = inviteRaw == null ? "" : `${inviteRaw}`;
      }
      const mres = await apiImConvMembers(convId.value);
      if (apiResCode(mres) == SUCCESS_CODE) {
        const mdataRaw = apiResData<any>(mres);
        const mdataObj = mdataRaw != null ? (mdataRaw as UTSJSONObject) : null;
        if (mdataObj != null) {
          const recordsRaw = mdataObj["records"];
          if (recordsRaw != null) {
            const records = recordsRaw as UTSJSONObject[];
            const out: GiMember[] = [];
            for (let i = 0; i < records.length; i++) {
              const m = new GiMember();
              m.userId = readString(records[i], "userId");
              m.name = readString(records[i], "name");
              m.nickName = readString(records[i], "nickName");
              m.avatar = readString(records[i], "avatar");
              m.token = m.nickName.length > 0
                ? m.nickName
                : m.name.length > 0
                  ? m.name
                  : `用户${m.userId}`;
              if (m.userId.length > 0) {
                out.push(m);
              }
            }
            members.value = out;
          }
        }
      }
      if (myRole.value >= 2) {
        // 入群申请列表是数组信封（data = JoinRequestDto[]）：列表只回 pending，
        // 长度即角标数；解析失败/为空按 0 处理（角标不阻塞主流程）
        try {
          const jres = await apiImJoinRequests(convId.value);
          if (apiResCode(jres) == SUCCESS_CODE) {
            const jraw = apiResData<any>(jres);
            const jarr = jraw != null ? (jraw as UTSJSONObject[]) : null;
            joinPending.value = jarr != null ? jarr.length : 0;
          } else {
            joinPending.value = 0;
          }
        } catch (_je) {
          joinPending.value = 0;
        }
      } else {
        joinPending.value = 0;
      }
      loading.value = false;
      inited = true;
    } catch (_error) {
      loading.value = false;
      if (!silent) {
        loadFailed.value = true;
      }
    }
  }

  function handleRetry(): void {
    if (loadFailed.value) {
      loadAll();
    }
  }

  // ===== 子页跳转 =====
  function navTo(page: string, extra: string): void {
    uni.navigateTo({
      url: `/subpackages/pages/im-group-${page}/im-group-${page}?convId=${convId.value}&name=${encodeURIComponent(groupName.value)}${extra}`,
    });
  }

  function openNotice(): void {
    navTo("notice", "");
  }

  function openMembers(): void {
    navTo("members", "");
  }

  // ===== 添加成员（复用添加伙伴弹窗的群模式，与群成员页「添加」同款） =====
  const addBuddySheetRef = ref<any | null>(null);

  function openAddMember(): void {
    const proxy = addBuddySheetRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("openForGroup", convId.value);
  }

  /** 弹窗内添加成功：静默刷新（成员数/头像条/角标随之更新，不闪加载态）。 */
  function handleMemberAdded(_conv: string): void {
    loadAll();
  }

  function openJoinRequests(): void {
    navTo("join-requests", "");
  }

  function openSettings(): void {
    navTo("settings", "");
  }

  // ===== 免打扰 / 置顶（我的会话设置，失败回滚开关态） =====
  function handleDndChange(event: any): void {
    const switchEvent = event as UniSwitchChangeEvent;
    const next = switchEvent.detail.value;
    apiImConvSetDnd(convId.value, next)
      .then((res: RequestResponse<any>) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          dndFlag.value = next;
        } else {
          dndFlag.value = !next;
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
      })
      .catch((_e: any | null) => {
        dndFlag.value = !next;
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
  }

  function handleTopChange(event: any): void {
    const switchEvent = event as UniSwitchChangeEvent;
    const next = switchEvent.detail.value;
    apiImConvSetTop(convId.value, next)
      .then((res: RequestResponse<any>) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          topFlag.value = next;
        } else {
          topFlag.value = !next;
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
      })
      .catch((_e: any | null) => {
        topFlag.value = !next;
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
  }

  // ===== 退出群聊（群主无此入口，走群管理页的解散/转让） =====
  async function leaveGroup(): Promise<void> {
    try {
      const res = await apiImGroupLeave(convId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.leaveGroupSuccess"), icon: "none" });
        // 退群后整个会话消失：切回消息 tab（同时清掉底下的聊天页栈）
        setTimeout(() => {
          uni.switchTab({ url: "/pages/message/message" });
        }, 400);
      } else {
        uni.showToast({ title: apiResMessage(res), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
  }

  // ===== 紧凑确认弹窗（confirm-modal）=====
  const confirmModalRef = ref<any | null>(null);

  function handleLeaveTap(): void {
    const params = new Map<string, string | number>();
    params.set("name", groupName.value);
    const proxy = confirmModalRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(
      "open",
      translateFn("Mobile.Message.leaveGroupTitle", toI18nParams(params), t("Mobile.Message.groupLeaveEntry")),
      t("Mobile.Message.leaveGroupTip"),
      t("Mobile.Message.leaveGroupConfirm"),
    );
  }

  function handleBack(): void {
    // 刷新后栈底保护：同 chat.uvue，无页可退时切回消息 tab
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      uni.switchTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    groupName.value = readOption(options, "name");
    calcStripSlots();
    loadAll();
  });

  onShow(() => {
    // 顺带重算格子数（旋转/分屏后模块宽度变化）；从子页（公告/成员/申请/设置）
    // 返回后刷新：成员数/角标/开关可能已变
    calcStripSlots();
    if (inited) {
      loadAll();
    }
  });
</script>

