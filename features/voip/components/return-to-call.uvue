<template>
  <view v-if="callAvailable" class="return-to-call" :style="{ bottom: bottomOffset + 'px' }" hover-class="return-to-call-pressed" @click="openVoipPage()">
    <image class="return-to-call-icon" src="/static/voip/call-icons/phone-white.png" mode="aspectFit" />
    <text class="return-to-call-label">{{ returnLabel }}</text>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import { getVoipSnapshot, openVoipPage, voipRevision } from "@/features/voip/callManager";
  import { getSafeAreaBottom } from "@/utils/safeAreaBottom";
  import { emptyI18nParams, t } from "@/utils/i18n";

  const bottomOffset = getSafeAreaBottom() + 96;
  const returnLabel = computed((): string => t("Mobile.Voip.return", emptyI18nParams(), ""));
  const callAvailable = computed((): boolean => {
    voipRevision.value;
    const call = getVoipSnapshot();
    return call != null && call.state != "ended";
  });
</script>

<style scoped>
  .return-to-call { position: fixed; right: 16px; z-index: 56; min-height: 44px; padding: 0 14px; border-radius: 22px; background-color: #202827; flex-direction: row; align-items: center; }
  .return-to-call-pressed { opacity: 0.8; }
  .return-to-call-icon { width: 18px; height: 18px; margin-right: 8px; }
  .return-to-call-label { color: #ffffff; font-size: 13px; font-weight: 500; }
</style>
