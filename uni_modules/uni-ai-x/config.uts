import {reactive} from 'vue';
import {UniAiLLMModel, UniAiProvider, UniAiDefaultLLM, UniAiLLmTokenInfo, UniAiUserInfo} from '@/uni_modules/uni-ai-x/types.uts';

// 1. 定义左侧菜单区域下方的用户头像信息（请接入自有用户体系）
export const currentUser: UniAiUserInfo = reactive<UniAiUserInfo>({})

// 2. 点击左侧菜单区域下方的用户头像信息后跳转的页面路径（请改为项目内实际页面）
export const userCenterPage = '/pages/index/index'

/**
 * OpenClaw WebSocket 地址（已移除 uniCloud 中继，需直连自有 WebSocket 服务）。
 * 留空则不会建立连接；示例：wss://your-server.com/openclaw/ws
 */
export const openClawWebSocketUrl: string = ''

/**
 * 抛出未配置 token 的错误，提示接入自有服务端。
 */
function throwTokenNotConfigured(providerName: string): string {
	throw new Error(`请在 uni_modules/uni-ai-x/config.uts 中为 ${providerName} 配置 getToken，接入自有服务端 token 接口`)
	return ''
}

// 3. 配置大语言模型
/** 
 * 配置大语言模型
 * 注意需要在，目录：`/uni_modules/uni-ai-x/static/ai-provider/${provider}.png` 中添加对应的logo图片
 * 默认以第一个为默认模型
 */
const bailianTokenInfo: UniAiLLmTokenInfo = {token: '', expireTime: 0}
const qiniuTokenInfo: UniAiLLmTokenInfo = {token: '', expireTime: 0}
const llmModelMap = new Map<string, UniAiProvider>([
	// 七牛
	[
		'qiniu', {
			models: [
				{ name: 'deepseek-v3'},
				{ name: 'deepseek-r1', thinking: true},
				{ name: 'doubao-seed-1.6', image: true},
				{ name: 'gpt-oss-120b'}
			],
			description: '七牛云-专注云计算和大数据',
			baseURL: "https://openai.qiniu.com/v1/chat/completions",
			async getToken(): Promise<string> {
				if (qiniuTokenInfo.expireTime > Date.now() && qiniuTokenInfo.token.length > 0) {
					return qiniuTokenInfo.token
				}
				// 示例：请求自有服务端获取临时 token
				// const res = await uni.request({ url: 'https://your-server.com/api/llm/token?qiniu', method: 'GET' })
				// qiniuTokenInfo.token = ...
				// qiniuTokenInfo.expireTime = ...
				throwTokenNotConfigured('qiniu')
			}
		}
	],
	// 阿里云百炼
	[
		'bailian', {
			models: [
				{ name: 'deepseek-v3'},
				{ name: 'deepseek-r1', thinking: true },
				{ name: 'qwen-turbo'},
				{ name: 'qwen-plus', thinking: true }
			],
			description: '阿里云百炼 - 专注AI技术研究和应用',
			baseURL: "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
			async getToken(): Promise<string> {
				if (bailianTokenInfo.expireTime > Date.now() && bailianTokenInfo.token.length > 0) {
					return bailianTokenInfo.token
				}
				throwTokenNotConfigured('bailian')
			}
		}
	]
])

const providerNameList: string[] = []
llmModelMap.forEach((_, key: string) => {
	providerNameList.push(key)
})

if (providerNameList.length < 1) {
	throw new Error('至少需要配置一个大语言模型提供商')
}
const defaultLLM: UniAiDefaultLLM = {
	provider: providerNameList[0]!,
	model: llmModelMap.get(providerNameList[0])?.models?.[0].name!
}

export default llmModelMap
export { llmModelMap, type UniAiLLMModel, providerNameList, defaultLLM }
