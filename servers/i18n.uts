import request from "./useRequest";
import type { RequestResponse } from "@/types/interfaces/request";
import type { I18nLangDto } from "@/types/interfaces/i18n";
import { I18N_SET_LANG_API } from "@/constants/i18n.constants";

export type LangMap = Record<string, string>;

// 查询语言列表
export async function apiI18nLangList(): Promise<RequestResponse<I18nLangDto[]>> {
  const res = await request({
    url: "/api/i18n/lang/list",
    method: "GET",
  });
  return res;
}

// 查询语言字典
export async function apiI18nQuery(lang: string = ""): Promise<RequestResponse<LangMap>> {
  const side = "Mobile";
  const query = lang != null && lang != ""
    ? `?lang=${encodeURIComponent(lang)}&side=${side}`
    : `?side=${side}`;
  const res = await request({
    url: `/api/i18n/query${query}`,
    method: "GET",
  });
  return res;
}

// 设置用户语言（后端专用接口）
export async function apiI18nSetLang(lang: string): Promise<RequestResponse<any>> {
  const res = await request({
    url: I18N_SET_LANG_API,
    method: "POST",
    data: { lang },
  });
  return res;
}
