/**
 * Nuwax Stream PCM Player（App-iOS）
 *
 * 包装同目录 StreamPcmPlayerBridge.swift（AVAudioEngine + AVAudioPlayerNode 流式 PCM16 播放）：
 * UTS 接口与 app-android 完全一致，ttsWebSocketPlayer 以平台条件编译引用同一模块。
 */
// iOS 混编：同目录 StreamPcmPlayerBridge.swift 的 public 类对 UTS 直接可见（无需 import）

export class StreamPcmPlayer {
  private bridge: StreamPcmPlayerBridge = new StreamPcmPlayerBridge()
  /** 攒批缓冲：攒够 ~100ms 再一次性交给 Swift，避免每帧跨边界调用卡顿 */
  private pendingBytes: number[] = []

  /** 创建并启动 AVAudioEngine（16kHz mono PCM16） */
  init(sampleRate: number) {
    this.bridge.initPlayer(sampleRate)
  }

  /** 推入一帧 PCM16 LE 字节（先攒批，够量再交给 Swift） */
  push(chunk: Uint8Array): void {
    if (chunk == null || chunk.length == 0) {
      return
    }
    for (let i = 0; i < chunk.length; i++) {
      this.pendingBytes.push(chunk[i])
    }
    if (this.pendingBytes.length >= 3200) {
      this.flushPending()
    }
  }

  /** 冲刷积压：把攒批的字节一次性交给 Swift（调度排队的 buffer） */
  flushPending(): void {
    if (this.pendingBytes.length == 0) {
      return
    }
    this.bridge.push(this.pendingBytes)
    this.pendingBytes = [] as number[]
  }

  /** 攒够起始缓冲后开始播放（幂等） */
  ensurePlaying(): void {
    this.flushPending()
    this.bridge.ensurePlaying()
  }

  /** 立即开始播放（幂等；输入结束时强制用） */
  playNow(): void {
    this.flushPending()
    this.bridge.playNow()
  }

  /** 静音开关 */
  setMuted(muted: boolean): void {
    this.bridge.setMuted(muted)
  }

  getWrittenMs(): number {
    return this.bridge.getWrittenMs()
  }

  getPlayedMs(): number {
    return this.bridge.getPlayedMs()
  }

  isDrained(): boolean {
    return this.bridge.isDrained()
  }

  hasPendingAudio(): boolean {
    return this.bridge.hasPendingAudio()
  }

  releasePlayer(): void {
    this.bridge.releasePlayer()
  }
}
