<template><view /></template>
<script setup lang="uts">
import { onLoad } from '@dcloudio/uni-app';
import { nextTick } from 'vue';
import { readOfflineH5RequestId, notifyOfflineH5PageReady } from '@/utils/offlineH5/offlineH5Page';
// 只初始化运行时和桥；不挂载首页、会话列表或其他业务组件。
onLoad((options: any) => {
  const requestId = readOfflineH5RequestId(options as UTSJSONObject);
  nextTick(() => { notifyOfflineH5PageReady(requestId); });
});
</script>
