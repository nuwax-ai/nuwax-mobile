/** 与 PC markdown-custom-think 持久化协议保持一致。 */
export class InlineThinkSegment {
  kind: string = "narration";
  text: string = "";
  status: string = "finished";
  index: number = 0;
  endIndex: number = 0;
}

export function splitInlineThink(text: string): InlineThinkSegment[] {
  const result: InlineThinkSegment[] = [];
  const tags = text.match(/(?:<(?:div|p)>\s*)?<markdown-custom-think\b[^>]*>[\s\S]*?<\/markdown-custom-think>(?:\s*<\/(?:div|p)>)?/g);
  let cursor = 0;
  if (tags != null) {
    for (let i = 0; i < tags.length; i++) {
      const tag = tags[i] ?? "";
      if (tag.length == 0) continue;
      const index = text.indexOf(tag, cursor);
      if (index > cursor) {
        const before = new InlineThinkSegment();
        before.text = text.substring(cursor, index);
        result.push(before);
      }
      const thought = new InlineThinkSegment();
      thought.kind = "reasoning";
      thought.index = index;
      thought.endIndex = index + tag.length;
      let content = tag.match(/\bcontent\s*=\s*"([^"]*)"/);
      if (content == null) content = tag.match(/\bcontent\s*=\s*'([^']*)'/);
      if (content != null && content.length > 1) {
        const encoded = content[1] ?? "";
        try {
          const decoded = decodeURIComponent(encoded);
          thought.text = decoded != null ? decoded : encoded;
        }
        catch (_e) { thought.text = encoded; }
      }
      const status = tag.match(/\bstatus\s*=\s*["']([^"']*)["']/);
      if (status != null && status.length > 1) thought.status = status[1] ?? "finished";
      result.push(thought);
      cursor = thought.endIndex;
    }
  }
  if (cursor < text.length) {
    const tail = new InlineThinkSegment();
    tail.text = text.substring(cursor);
    result.push(tail);
  }
  return result;
}

export function stripInlineThink(text: string): string {
  return splitInlineThink(text).filter((part: InlineThinkSegment): boolean => part.kind == "narration")
    .map((part: InlineThinkSegment): string => part.text).join("");
}

function thinkTag(content: string, finished: boolean): string {
  // encodeURIComponent 不转义单引号；一并编码以兼容两种属性引号解析。
  const encodedRaw = encodeURIComponent(content);
  const encoded = (encodedRaw != null ? encodedRaw : "").replace(/'/g, "%27");
  return '<div><markdown-custom-think status="' + (finished ? "finished" : "thinking") +
    '" content="' + encoded + '"></markdown-custom-think></div>';
}

export function appendInlineThink(text: string, delta: string, finished: boolean): string {
  const parts = splitInlineThink(text);
  const last = parts.length > 0 ? parts[parts.length - 1] : null;
  if (last != null && last.kind == "reasoning" && last.status == "thinking") {
    return text.substring(0, last.index) + thinkTag(last.text + delta, finished);
  }
  return delta.length > 0 ? text + thinkTag(delta, finished) : text;
}

export function finalizeInlineThink(text: string): string {
  return appendInlineThink(text, "", true);
}
