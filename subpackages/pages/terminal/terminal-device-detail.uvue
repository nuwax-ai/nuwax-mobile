<template>
  <view class="container relative flex flex-col">
    <custom-nav-bar
      :title="detailNavTitle"
      hasSafetyZone
      showBack
      :interceptBack="detailView != 'overview' && !standaloneSubview"
      @back="closeDetailView"
    />

    <scroll-view class="flex-1 detail-scroll" direction="vertical" :show-scrollbar="false" :scroll-top="detailScrollTop">
      <!-- 详情概览：按原型拆成快捷操作、群组设置、设备设置、其他 -->
      <template v-if="detailView == 'overview'">
        <view class="overview-page">
          <view class="overview-hero">
            <view :class="['overview-device-icon', isLingzhu ? '' : 'overview-device-icon-computer']">
              <view v-if="isLingzhu" class="overview-device-glyph"></view>
              <text v-else class="overview-device-computer">⌘</text>
            </view>
            <view class="overview-name-row">
              <text class="overview-name">{{ deviceName }}</text>
              <view class="overview-edit-btn" @click="openDeviceProfilePopup">
                <svg-icon name="icon-Edit" :size="30" />
              </view>
            </view>
            <view class="overview-status">
              <view :class="['overview-status-dot', deviceBound && deviceOnline ? 'overview-status-dot-online' : '']"></view>
              <text class="overview-status-text">
                {{ isLingzhu ? t("Mobile.Terminal.lingzhuTerminal") : t("Mobile.Terminal.computerTerminal") }} ·
                {{ !infoReady && !infoLoadFailed ? t("Mobile.Terminal.loading") : (infoLoadFailed ? t("Mobile.Terminal.statusUnknown") : (!deviceBound ? t("Mobile.Terminal.deviceUnbound") : (deviceOnline ? t("Mobile.Terminal.connected") : t("Mobile.Terminal.disconnected")))) }}
              </text>
            </view>
          </view>

          <view v-if="infoLoadFailed" class="detail-load-error" @tap="fetchDeviceInfo">
            <text class="detail-load-error-text">{{ t("Mobile.Terminal.deviceInfoFailedRetry") }}</text>
          </view>
          <text v-else-if="infoReady && (!deviceOnline || !deviceBound)" class="detail-offline-tip">{{ t("Mobile.Terminal.offlineConfigDisabled") }}</text>

          <text class="overview-section-title">{{ t("Mobile.Terminal.quickActions") }}</text>
          <view class="overview-card">
            <view :class="['overview-menu-row', quickBtnDisabled ? 'overview-menu-row-disabled' : '']" @click="handleOpenChat">
              <view class="overview-menu-icon overview-menu-icon-green"><svg-icon name="icon-message" :size="38" /></view>
              <text class="overview-menu-title">{{ t("Mobile.Terminal.startConversation") }}</text>
              <text class="overview-menu-arrow">›</text>
            </view>
            <view class="overview-menu-row" @click="handleMeetingRecords">
              <view class="overview-menu-icon"><svg-icon name="icon-Calendar" :size="38" /></view>
              <text class="overview-menu-title">{{ t("Mobile.Terminal.meetingRecords") }}</text>
              <text class="overview-menu-arrow">›</text>
            </view>
            <view class="overview-menu-row" @click="handleMonitorRecords">
              <view class="overview-menu-icon"><svg-icon name="icon-eye-open" :size="40" /></view>
              <text class="overview-menu-title">{{ t("Mobile.Terminal.monitorRecords") }}</text>
              <text class="overview-menu-arrow">›</text>
            </view>
          </view>

          <template v-if="isLingzhu">
            <text class="overview-section-title">{{ t("Mobile.Terminal.groupSettings") }}</text>
            <view class="overview-card">
              <view :class="['overview-menu-row', quickBtnDisabled ? 'overview-menu-row-disabled' : '']" @click="handleGroupMembers">
                <view class="overview-menu-icon"><svg-icon name="icon-member" :size="40" /></view>
                <view class="overview-menu-copy">
                  <text class="overview-menu-title overview-menu-title-copy">{{ t("Mobile.Terminal.groupMembers") }}</text>
                  <text class="overview-menu-desc">{{ groupMemberText }}</text>
                </view>
                <text class="overview-menu-arrow">›</text>
              </view>
            </view>

            <text class="overview-section-title">{{ t("Mobile.Terminal.deviceSettings") }}</text>
            <view class="overview-card">
              <view :class="['overview-menu-row', modeAndVolumeDisabled ? 'overview-menu-row-disabled' : '']" @tap="openModePicker">
                <view class="overview-menu-icon"><svg-icon name="icon-restart" :size="40" /></view>
                <text class="overview-menu-title">{{ t("Mobile.Terminal.modeSwitch") }}</text>
                <text class="overview-menu-value">{{ activeModeLabel }}</text>
                <text class="overview-menu-arrow">›</text>
              </view>
              <view class="overview-menu-row" @click="openDetailView('emoji')">
                <view class="overview-menu-icon"><text class="overview-menu-emoji">☺</text></view>
                <text class="overview-menu-title">{{ t("Mobile.Terminal.eventEmojiBind") }}</text>
                <text class="overview-menu-arrow">›</text>
              </view>
              <view class="overview-menu-row" @click="openDetailView('settings')">
                <view class="overview-menu-icon"><svg-icon name="icon-settings" :size="42" /></view>
                <text class="overview-menu-title">{{ t("Mobile.Terminal.moreSettings") }}</text>
                <text class="overview-menu-arrow">›</text>
              </view>
            </view>

            <text class="overview-section-title">{{ t("Mobile.Mine.other") }}</text>
            <view class="overview-card overview-card-last">
              <view class="overview-menu-row" @click="handleReprovision">
                <view class="overview-menu-icon"><svg-icon name="icon-Globe" :size="40" /></view>
                <text class="overview-menu-title">{{ t("Mobile.Terminal.reprovision") }}</text>
                <text class="overview-menu-arrow">›</text>
              </view>
              <view v-if="deviceBound" class="overview-menu-row" @click="handleUnbind">
                <view class="overview-menu-icon"><svg-icon name="icon-Link" :size="40" /></view>
                <text class="overview-menu-title overview-menu-title-danger">{{ t("Mobile.Terminal.unbindDevice") }}</text>
                <text class="overview-menu-arrow">›</text>
              </view>
              <view v-else class="overview-menu-row" @click="handleDeleteDeviceBinding">
                <view class="overview-menu-icon"><svg-icon name="icon-a-trashcan" :size="40" /></view>
                <text class="overview-menu-title overview-menu-title-danger">{{ t("Mobile.Terminal.deleteDevice") }}</text>
                <text class="overview-menu-arrow">›</text>
              </view>
            </view>
          </template>
        </view>
      </template>

      <!-- 表情绑定二级视图 -->
      <template v-else-if="detailView == 'emoji'">
        <view class="detail-subpage">
          <view class="subpage-device-summary">
            <view class="subpage-summary-dot"></view>
            <text class="subpage-summary-name">{{ deviceName }}</text>
            <text class="subpage-summary-mode">{{ activeModeLabel }}</text>
          </view>
          <event-emoji-bind :deviceId="deviceId" :disabled="configDisabled" />
        </view>
      </template>

      <!-- 更多设置：保留全部原有能力，不再受当前模式限制而隐藏 -->
      <template v-else>
        <view class="detail-subpage detail-settings-page">
          <text class="overview-section-title settings-section-title">{{ t("Mobile.Terminal.voiceBroadcast") }}</text>
          <view :class="['card-group settings-card', configDisabled ? 'config-disabled' : '']">
            <view class="row-item" hover-class="row-item-active" @click="handleVoiceBroadcastToggle">
              <view class="row-info">
                <text class="row-title">{{ t("Mobile.Terminal.voiceSwitch") }}</text>
                <text class="row-desc">{{ t("Mobile.Terminal.voiceSwitchDesc") }}</text>
              </view>
              <view :class="voiceBroadcastEnabled ? 'pill-on' : 'pill-off'">
                <text :class="voiceBroadcastEnabled ? 'pill-on-text' : 'pill-off-text'">{{ voiceBroadcastEnabled ? t("Mobile.Terminal.switchOn") : t("Mobile.Terminal.switchOff") }}</text>
              </view>
            </view>
            <view :class="['row-item', modeAndVolumeDisabled ? 'row-item-disabled' : '']">
              <view class="row-info"><text class="row-title">{{ t("Mobile.Terminal.voiceVolume") }}</text></view>
              <view class="volume-box">
                <text class="volume-label">{{ t("Mobile.Terminal.volumeLow") }}</text>
                <slider class="volume-slider" :value="voiceVolume" :min="0" :max="100" :block-size="14" :disabled="modeAndVolumeDisabled" activeColor="#00b96b" backgroundColor="#e8e8e8" @changing="handleVolumeChanging" @change="handleVolumeChange" />
                <text class="volume-label">{{ t("Mobile.Terminal.volumeHigh") }}</text>
              </view>
            </view>
            <view class="row-item" hover-class="row-item-active" @tap="handlePickTtsVoice">
              <view class="row-info"><text class="row-title">{{ t("Mobile.Terminal.ttsVoice") }}</text></view>
              <text class="tts-current">{{ ttsVoiceName != "" ? ttsVoiceName : t("Mobile.Terminal.ttsVoiceDefault") }}</text>
              <text class="row-arrow">›</text>
            </view>
          </view>

          <text class="overview-section-title settings-section-title">{{ t("Mobile.Terminal.meetingPush") }}</text>
          <view :class="['card-group settings-card', configDisabled ? 'config-disabled' : '']">
            <view class="row-item" v-for="(item, index) in pushChannelList" :key="`${item.key}:${item.enabled ? '1' : '0'}`">
              <view class="row-info" hover-class="row-item-active" @click="handlePushChannelInfoClick(item, index)">
                <text class="row-title">{{ item.label }}</text>
                <text v-if="item.key == 'emailEnabled'" :class="['row-desc', emailAddresses.length == 0 ? 'recipient-missing' : '']">
                  {{ emailAddresses.length > 0 ? emailAddressesDisplay : t("Mobile.Terminal.addEmailFirst") }}
                </text>
              </view>
              <view :class="item.enabled ? 'pill-on' : 'pill-off'" hover-class="row-item-active" @click="handlePushChannelToggle(item, index)">
                <text :class="item.enabled ? 'pill-on-text' : 'pill-off-text'">{{ item.enabled ? "✓" : "—" }}</text>
              </view>
            </view>
          </view>

          <text class="overview-section-title settings-section-title">{{ t("Mobile.Terminal.monitorContent") }}</text>
          <view :class="['card-group settings-card', configDisabled ? 'config-disabled' : '']">
            <view class="swipe-wrap" v-for="(item, index) in monitorContentList" :key="`${item.id}:${item.enabled ? '1' : '0'}`">
              <view class="swipe-delete" @click="deleteContent(item, index)"><text class="swipe-delete-text">{{ t("Mobile.Common.delete") }}</text></view>
              <view
                class="swipe-content row-item"
                :data-content-id="item.id"
                :style="{ transform: 'translateX(' + contentOffset(item) + 'px)', transition: (swipingContentId == item.id ? 'none' : 'transform 0.22s ease') }"
                @touchstart="onContentTouchStart"
                @touchmove="onContentTouchMove"
                @touchend="onContentTouchEnd"
              >
                <view class="row-info" hover-class="row-item-active" @click="openEditContent(item)">
                  <text class="row-title">{{ item.title }}</text>
                  <text class="row-desc">{{ item.keywordsText }}</text>
                </view>
                <view :class="item.enabled ? 'pill-on' : 'pill-off'" hover-class="row-item-active" @click.stop="handleMonitorContentToggle(item, index)">
                  <text :class="item.enabled ? 'pill-on-text' : 'pill-off-text'">{{ item.enabled ? "✓" : "—" }}</text>
                </view>
              </view>
            </view>
            <view class="row-item" hover-class="row-item-active" @click="openCreateContent">
              <view class="row-info"><text class="row-title add-text">{{ t("Mobile.Terminal.addMonitorContent") }}</text></view>
            </view>
          </view>

          <text class="overview-section-title settings-section-title">{{ t("Mobile.Terminal.alarmNotify") }}</text>
          <view :class="['card-group settings-card settings-card-last', configDisabled ? 'config-disabled' : '']">
            <view class="row-item">
              <view class="row-info"><text class="row-title">{{ t("Mobile.Terminal.alarmChannelApp") }}</text></view>
              <view class="pill-on"><text class="pill-on-text">✓</text></view>
            </view>
            <view class="row-item">
              <view class="row-info" hover-class="row-item-active" @click="handleSmsRecipientInfoClick">
                <text class="row-title">{{ t("Mobile.Terminal.alarmChannelSms") }}</text>
                <text :class="['row-desc', smsPhones.length == 0 ? 'recipient-missing' : '']">
                  {{ smsPhones.length > 0 ? smsPhonesDisplay : t("Mobile.Terminal.addPhoneFirst") }}
                </text>
              </view>
              <view :class="smsAlertEnabled ? 'pill-on' : 'pill-off'" hover-class="row-item-active" @click="handleAlarmToggle('sms')">
                <text :class="smsAlertEnabled ? 'pill-on-text' : 'pill-off-text'">{{ smsAlertEnabled ? "✓" : "—" }}</text>
              </view>
            </view>
          </view>
        </view>
      </template>
    </scroll-view>

    <radio-list-drawer
      :visible="modePickerVisible"
      :title="t('Mobile.Terminal.modeSwitch')"
      :list="modeRadioOptions"
      :current-value="activeMode"
      max-height="500rpx"
      @onClose="closeModePicker"
      @onChange="selectMode"
    />

    <radio-list-drawer
      :visible="ttsPickerVisible"
      :title="t('Mobile.Terminal.ttsVoice')"
      :list="ttsRadioOptions"
      :current-value="ttsPickerCurrentValue"
      max-height="70%"
      @onClose="closeTtsPicker"
      @onChange="handleTtsVoiceChange"
    />

    <device-profile-edit-popup
      :visible="deviceProfilePopupVisible"
      :device-name="deviceName"
      :device-role="deviceRole"
      :wake-word="deviceWakeWord"
      :submitting="deviceProfileSubmitting"
      @close="closeDeviceProfilePopup"
      @save="saveDeviceProfile"
    />

    <!-- 监控内容编辑弹窗（新增 / 编辑 / 删除） -->
    <view v-if="contentPopupVisible" class="content-popup-mask" @click="closeContentPopup">
      <view class="content-popup" @tap.stop>
        <view class="content-popup-header">
          <text class="content-popup-title">{{ isEditingContent ? t("Mobile.Terminal.monitorContentEditTitle") : t("Mobile.Terminal.monitorContentAddTitle") }}</text>
          <view class="content-popup-close" @click="closeContentPopup"><text class="content-popup-close-text">×</text></view>
        </view>
        <view class="content-popup-body">
          <view class="content-popup-item">
            <text class="content-popup-label"><text class="content-popup-required">*</text>{{ t("Mobile.Terminal.monitorContentTitleLabel") }}</text>
            <input class="content-popup-input" v-model="formTitle" maxlength="30" :placeholder="t('Mobile.Terminal.monitorContentTitlePh')" placeholder-class="content-popup-placeholder" />
          </view>
          <view class="content-popup-item">
            <text class="content-popup-label"><text class="content-popup-required">*</text>{{ t("Mobile.Terminal.monitorContentKeywordsLabel") }}</text>
            <input class="content-popup-input" v-model="formKeywords" maxlength="200" :placeholder="t('Mobile.Terminal.monitorContentKeywordsPh')" placeholder-class="content-popup-placeholder" />
          </view>
          <text v-if="contentFormError.length > 0" class="content-popup-error">{{ contentFormError }}</text>
          <view class="content-popup-actions">
            <view v-if="isEditingContent" :class="['content-popup-btn', 'content-popup-btn-delete', contentSubmitting ? 'content-popup-btn-disabled' : '']" @click="removeContent">
              <text class="content-popup-btn-delete-text">{{ t("Mobile.Common.delete") }}</text>
            </view>
            <view class="content-popup-btn content-popup-btn-cancel" @click="closeContentPopup">
              <text class="content-popup-btn-cancel-text">{{ t("Mobile.Common.cancel") }}</text>
            </view>
            <view :class="['content-popup-btn', 'content-popup-btn-confirm', contentSubmitting ? 'content-popup-btn-disabled' : '']" @click="saveContent">
              <text class="content-popup-btn-confirm-text">{{ contentSubmitting ? t("Mobile.Common.saving") : t("Mobile.Common.save") }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 邮箱 / 短信收件人设置：先配置接收地址，再允许打开对应渠道 -->
    <view v-if="recipientPopupVisible" class="content-popup-mask" @click="closeRecipientPopup">
      <view class="content-popup" @tap.stop>
        <view class="content-popup-header">
          <text class="content-popup-title">
            {{ recipientKind == "email" ? t("Mobile.Terminal.emailRecipientTitle") : t("Mobile.Terminal.smsRecipientsTitle") }}
          </text>
          <view class="content-popup-close" @click="closeRecipientPopup"><text class="content-popup-close-text">×</text></view>
        </view>
        <view class="content-popup-body">
          <view class="content-popup-item">
            <text class="content-popup-label">
              <text class="content-popup-required">*</text>
              {{ recipientKind == "email" ? t("Mobile.Terminal.emailRecipientLabel") : t("Mobile.Terminal.smsRecipientsLabel") }}
            </text>
            <input
              class="content-popup-input"
              v-model="recipientValue"
              :maxlength="recipientKind == 'email' ? 500 : 240"
              type="text"
              :placeholder="recipientKind == 'email' ? t('Mobile.Terminal.emailRecipientPh') : t('Mobile.Terminal.smsRecipientsPh')"
              placeholder-class="content-popup-placeholder"
            />
            <text class="recipient-help">
              {{ recipientKind == "email" ? t("Mobile.Terminal.emailRecipientsHelp") : t("Mobile.Terminal.smsRecipientsHelp") }}
            </text>
          </view>
          <text v-if="recipientError.length > 0" class="content-popup-error">{{ recipientError }}</text>
          <view class="content-popup-actions">
            <view class="content-popup-btn content-popup-btn-cancel" @click="closeRecipientPopup">
              <text class="content-popup-btn-cancel-text">{{ t("Mobile.Common.cancel") }}</text>
            </view>
            <view :class="['content-popup-btn', 'content-popup-btn-confirm', recipientSubmitting ? 'content-popup-btn-disabled' : '']" @click="saveRecipients">
              <text class="content-popup-btn-confirm-text">{{ recipientSubmitting ? t("Mobile.Common.saving") : t("Mobile.Common.save") }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from "vue";
  import { onLoad, onShow, onBackPress } from "@dcloudio/uni-app";
  import { setCurrentPageNavigationBarTitle } from "@/utils/system";
  import { orEmpty } from "@/utils/utsCoalesce.uts";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import EventEmojiBind from "./components/event-emoji-bind.uvue";
  import DeviceProfileEditPopup from "./components/device-profile-edit-popup.uvue";
  import RadioListDrawer from "@/components/radio-list-drawer/radio-list-drawer.uvue";
  import { RadioListItem } from "@/types/interfaces/radio";
  import {
    apiVoxDeviceDetail,
    apiVoxUpdateDeviceProfile,
    apiVoxUnbindDevice,
    apiDeleteDeviceBinding,
    apiVoxUpdateDeviceMode,
    apiVoxGetVoiceSettings,
    apiVoxUpdateVoiceSettings,
    apiVoxGetTtsVoices,
  } from "@/servers/vox/voxDevice";
  import { apiVoxGetPushSettings, apiVoxUpdatePushSettings } from "@/servers/vox/voxPushSettings";
  import { apiVoxGetMonitoringSettings, apiVoxUpdateMonitoringSettings, apiVoxAddMonitoringContent, apiVoxDeleteMonitoringContent, apiVoxUpdateMonitoringContent } from "@/servers/vox/voxMonitoring";
  import { apiGetGroupMembers } from "@/servers/terminalAgent";
  import { AppDeviceProfileUpdateParams, AppDeviceVoiceSettingsUpdateParams } from "@/types/interfaces/voxDevice";
  import { AppMonitoringSettingsUpdateParams, AppMonitoringContentUpsertParams } from "@/types/interfaces/voxMonitoring";
  import { AppMeetingPushSettingsUpdateParams } from "@/types/interfaces/voxPushSettings";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/common";
  import { jumpToAgentDetailPage } from "@/utils/commonBusiness";
  import { SUCCESS_CODE } from "@/constants/codes.constants";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // 全局 loading：深度计数——并发多个请求只显示一个遮罩，全部结束才收起，避免多个 loading 叠加。
  // 注意：toast 与 showLoading 共用同一层，故各动作统一在 finally 里先 hideLoading，再 toast。
  let loadingDepth = 0;
  const showLoadingMask = (title: string) => {
    if (loadingDepth == 0) {
      uni.showLoading({ title: title != "" ? title : t("Mobile.Terminal.loading"), mask: true });
    }
    loadingDepth = loadingDepth + 1;
  };
  const hideLoadingMask = () => {
    if (loadingDepth > 0) loadingDepth = loadingDepth - 1;
    if (loadingDepth == 0) {
      uni.hideLoading();
    }
  };
  // 包裹一个异步任务：无论成败都回调 settle（并行批量统一收尾用）
  const settleWhenDone = async (p: Promise<void>, settle: () => void) => {
    try {
      await p;
    } catch (e) {
      console.error("settleWhenDone error", e);
    }
    settle();
  };

  // 设备类型 / 标识 / 名称
  const deviceType = ref<string>("lingzhu");
  const deviceId = ref<string>("");
  /** 设备绑定记录 ID（删除绑定接口入参） */
  const deviceBindingId = ref<string>("");
  /** 设备关联的终端智能体 ID（组员管理接口入参）；0 表示尚未关联 */
  const deviceAgentId = ref<number>(0);
  /** 设备当前会话 Id（进会话加载历史用）；由 device 详情接口 conversationId 下发，0=未关联 */
  const deviceConversationId = ref<number>(0);
  const deviceName = ref<string>("灵珠");
  const deviceRole = ref<string>("");
  const deviceWakeWord = ref<string>("");
  const deviceOnline = ref<boolean>(false);
  const deviceBound = ref<boolean>(true);
  const detailView = ref<string>("overview");
  // 表情绑定 / 更多设置通过新页面栈实例打开；原生侧滑可自然返回上一层灵珠详情。
  const standaloneSubview = ref<boolean>(false);
  const detailScrollTop = ref<number>(0);
  const deviceProfilePopupVisible = ref<boolean>(false);
  const deviceProfileSubmitting = ref<boolean>(false);
  const modePickerVisible = ref<boolean>(false);
  const ttsPickerVisible = ref<boolean>(false);
  const groupMemberCount = ref<number>(-1);
  // 会改变详情数据的子页面返回后刷新一次；只读记录页不设置。
  let refreshDetailOnNextShow = false;

  // Android UTS：字符串比较用 ==
  const isLingzhu = computed((): boolean => deviceType.value == "lingzhu");

  // 模式：本地 key（chat/meeting/monitor）↔ 后端 enum（CONVERSATION/MEETING/MONITORING）
  const MODE_CHAT = "chat";
  const MODE_MEETING = "meeting";
  const MODE_MONITOR = "monitor";
  const activeMode = ref<string>("chat");
  const toModeEnum = (key: string): string => {
    if (key == MODE_MEETING) return "MEETING";
    if (key == MODE_MONITOR) return "MONITORING";
    return "CONVERSATION";
  };
  const toModeKey = (mode: string): string => {
    if (mode == "MEETING") return MODE_MEETING;
    if (mode == "MONITORING") return MODE_MONITOR;
    return MODE_CHAT;
  };
  class ModeItem {
    key: string = "";
    label: string = "";
    constructor(key: string, label: string) {
      this.key = key;
      this.label = label;
    }
  }
  const modeList = ref<ModeItem[]>([]);
  const activeModeLabel = computed((): string => {
    for (let i = 0; i < modeList.value.length; i++) {
      if (modeList.value[i].key == activeMode.value) return modeList.value[i].label;
    }
    return t("Mobile.Terminal.modeChat");
  });
  const modeRadioOptions = computed((): RadioListItem[] => {
    const result: RadioListItem[] = [];
    for (let i = 0; i < modeList.value.length; i++) {
      const item = modeList.value[i];
      result.push(new RadioListItem(item.label, item.key));
    }
    return result;
  });
  const detailNavTitle = computed((): string => {
    if (detailView.value == "emoji") return t("Mobile.Terminal.eventEmojiBind");
    if (detailView.value == "settings") return t("Mobile.Terminal.moreSettings");
    return t("Mobile.Terminal.lingzhuDetail");
  });
  const groupMemberText = computed((): string => {
    if (groupMemberCount.value < 0) return t("Mobile.Terminal.groupManageTip");
    return `${groupMemberCount.value} ${t("Mobile.Terminal.groupMemberUnit")}`;
  });

  // 设备详情是否就绪（消除 💬/👥 按钮在拉取完成前的竞态误报）
  const infoReady = ref<boolean>(false);
  const infoLoadFailed = ref<boolean>(false);
  /** 详情未就绪时暂不允许提交；离线/解绑不再全局禁用配置。 */
  const configDisabled = computed((): boolean => !infoReady.value || infoLoadFailed.value);
  /** 产品约束：离线或解绑时仅模式切换与音量调节不可用。 */
  const modeAndVolumeDisabled = computed((): boolean => configDisabled.value || !deviceOnline.value || !deviceBound.value);
  const quickBtnDisabled = computed((): boolean => configDisabled.value || deviceAgentId.value <= 0);

  // 语音设置（voiceBroadcastEnabled / volumePercent / ttsVoice）
  const voiceBroadcastEnabled = ref<boolean>(true);
  const voiceVolume = ref<number>(70);
  // 最近一次已落库的音量，用于失败回滚（拖动预览会临时改 voiceVolume）
  const lastPersistedVolume = ref<number>(70);
  // 当前 TTS 音色展示名 + 可选项
  const ttsVoiceId = ref<string>("");
  const ttsVoiceName = ref<string>("");
  class TtsVoiceOption {
    voiceId: string = "";
    name: string = "";
    constructor(voiceId: string, name: string) {
      this.voiceId = voiceId;
      this.name = name;
    }
  }
  const ttsVoiceOptions = ref<TtsVoiceOption[]>([]);
  const TTS_DEFAULT_VALUE = "__default_tts_voice__";
  const ttsPickerCurrentValue = computed((): string => {
    return ttsVoiceId.value != "" ? ttsVoiceId.value : TTS_DEFAULT_VALUE;
  });
  const ttsRadioOptions = computed((): RadioListItem[] => {
    const result: RadioListItem[] = [];
    for (let i = 0; i < ttsVoiceOptions.value.length; i++) {
      const item = ttsVoiceOptions.value[i];
      const label = item.name != "" ? item.name : item.voiceId;
      result.push(new RadioListItem(label, item.voiceId));
    }
    result.push(new RadioListItem(t("Mobile.Terminal.ttsVoiceDefault"), TTS_DEFAULT_VALUE));
    return result;
  });

  // 会议推送渠道（网关 push-settings）
  class PushChannel {
    key: string = "";
    label: string = "";
    enabled: boolean = false;
    constructor(key: string, label: string, enabled: boolean) {
      this.key = key;
      this.label = label;
      this.enabled = enabled;
    }
  }
  const pushChannelList = ref<PushChannel[]>([]);
  // 邮箱推送收件地址来自设备会议推送设置；支持多个。
  const emailAddresses = ref<string[]>([]);
  const emailAddressesDisplay = computed((): string => emailAddresses.value.join("、"));

  // 邮箱 / 短信接收人编辑弹窗
  const recipientPopupVisible = ref<boolean>(false);
  const recipientKind = ref<string>("email");
  const recipientValue = ref<string>("");
  const recipientError = ref<string>("");
  const recipientSubmitting = ref<boolean>(false);
  const recipientEnableAfterSave = ref<boolean>(false);
  const smsAlertEnabled = ref<boolean>(false);
  const smsPhones = ref<string[]>([]);
  const smsPhonesDisplay = computed((): string => {
    const masked: string[] = [];
    for (let i = 0; i < smsPhones.value.length; i++) {
      const phone = smsPhones.value[i];
      masked.push(phone.length == 11 ? phone.substring(0, 3) + "****" + phone.substring(7) : phone);
    }
    return masked.join("、");
  });

  const openRecipientPopup = (kind: string) => {
    if (configDisabled.value || recipientSubmitting.value) return;
    recipientKind.value = kind;
    recipientValue.value = kind == "email" ? emailAddresses.value.join(", ") : smsPhones.value.join(", ");
    recipientError.value = "";
    recipientPopupVisible.value = true;
  };

  const closeRecipientPopup = () => {
    if (recipientSubmitting.value) return;
    recipientPopupVisible.value = false;
    recipientError.value = "";
    recipientEnableAfterSave.value = false;
  };

  const buildPushChannelList = (
    appEnabled: boolean, emailEnabled: boolean, feishuEnabled: boolean,
    wecomEnabled: boolean, dingtalkEnabled: boolean,
  ) => {
    pushChannelList.value = [
      new PushChannel("appEnabled", t("Mobile.Terminal.pushChannelApp"), appEnabled),
      new PushChannel("emailEnabled", t("Mobile.Terminal.pushChannelEmail"), emailEnabled),
      new PushChannel("feishuEnabled", t("Mobile.Terminal.pushChannelFeishu"), feishuEnabled),
      new PushChannel("wecomEnabled", t("Mobile.Terminal.pushChannelWecom"), wecomEnabled),
      new PushChannel("dingtalkEnabled", t("Mobile.Terminal.pushChannelDingtalk"), dingtalkEnabled),
    ];
  };

  const fetchPushSettings = async () => {
    if (deviceId.value == "") return;
    try {
      const res = await apiVoxGetPushSettings(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          buildPushChannelList(
            d["appEnabled"] != null ? (d["appEnabled"] as boolean) : false,
            d["emailEnabled"] != null ? (d["emailEnabled"] as boolean) : false,
            d["feishuEnabled"] != null ? (d["feishuEnabled"] as boolean) : false,
            d["wecomEnabled"] != null ? (d["wecomEnabled"] as boolean) : false,
            d["dingtalkEnabled"] != null ? (d["dingtalkEnabled"] as boolean) : false,
          );
          const emailAddressesVal = d["emailAddresses"];
          emailAddresses.value = emailAddressesVal != null ? (emailAddressesVal as string[]) : ([] as string[]);
        }
      } else {
        uni.showToast({ title: t("Mobile.Terminal.pushSettingLoadFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchPushSettings error", e);
      uni.showToast({ title: t("Mobile.Terminal.pushSettingLoadFailed"), icon: "none" });
    }
  };

  const replacePushChannelRow = (index: number, channel: PushChannel) => {
    const list: PushChannel[] = [];
    for (let i = 0; i < pushChannelList.value.length; i++) {
      list.push(i == index ? channel : pushChannelList.value[i]);
    }
    pushChannelList.value = list;
  };

  // 乐观更新 + 失败回滚
  const handlePushChannelToggle = async (channel: PushChannel, index: number) => {
    if (configDisabled.value) return;
    if (channel.key == "emailEnabled" && !channel.enabled && emailAddresses.value.length == 0) {
      recipientEnableAfterSave.value = true;
      openRecipientPopup("email");
      return;
    }
    const next = !channel.enabled;
    const updated = new PushChannel(channel.key, channel.label, next);
    replacePushChannelRow(index, updated);
    const params = new AppMeetingPushSettingsUpdateParams();
    if (channel.key == "appEnabled") params.appEnabled = next;
    else if (channel.key == "emailEnabled") params.emailEnabled = next;
    else if (channel.key == "feishuEnabled") params.feishuEnabled = next;
    else if (channel.key == "wecomEnabled") params.wecomEnabled = next;
    else if (channel.key == "dingtalkEnabled") params.dingtalkEnabled = next;
    try {
      const res = await apiVoxUpdatePushSettings(deviceId.value, params);
      if (apiResCode(res) != SUCCESS_CODE) {
        replacePushChannelRow(index, channel);
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.pushSettingFailed"), icon: "none" });
      }
    } catch (e) {
      replacePushChannelRow(index, channel);
      console.error("handlePushChannelToggle error", e);
      uni.showToast({ title: t("Mobile.Terminal.pushSettingFailed"), icon: "none" });
    }
  };

  const handlePushChannelInfoClick = (channel: PushChannel, index: number) => {
    if (configDisabled.value) return;
    if (channel.key == "emailEnabled") {
      recipientEnableAfterSave.value = false;
      openRecipientPopup("email");
      return;
    }
    handlePushChannelToggle(channel, index);
  };

  const handleSmsRecipientInfoClick = () => {
    recipientEnableAfterSave.value = false;
    openRecipientPopup("sms");
  };

  // 监控内容（来自 /monitoring/settings.contents，启用态可切）
  class MonitorContent {
    id: number = 0;
    title: string = "";
    keywords: string[] = [] as string[];
    keywordsText: string = "";
    enabled: boolean = false;
    constructor(id: number, title: string, keywords: string[], keywordsText: string, enabled: boolean) {
      this.id = id;
      this.title = title;
      this.keywords = keywords;
      this.keywordsText = keywordsText;
      this.enabled = enabled;
    }
  }
  const monitorContentList = ref<MonitorContent[]>([]);

  // 告警通知（APP 固定开启、不可取消；仅短信可切。来自 /monitoring/settings）

  // 监控内容编辑弹窗（新增 / 编辑 / 删除）
  const contentPopupVisible = ref<boolean>(false);
  const editingContentId = ref<number>(0);
  const formTitle = ref<string>("");
  const formKeywords = ref<string>("");
  const contentSubmitting = ref<boolean>(false);
  const contentFormError = ref<string>("");
  const isEditingContent = computed((): boolean => editingContentId.value > 0);

  // 监控内容左滑删除（单开模式；SWIPE_DELETE_W = 删除按钮宽度 px）
  const SWIPE_DELETE_W = 80;
  const openContentId = ref<number>(0);
  const swipingContentId = ref<number>(0);
  const swipeOffset = ref<number>(0);
  let touchStartX = 0;
  let touchStartY = 0;
  let touchBaseOffset = 0;

  const fetchMonitoringSettings = async () => {
    if (deviceId.value == "") return;
    try {
      const res = await apiVoxGetMonitoringSettings(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          const smsV = d["smsAlertEnabled"];
          smsAlertEnabled.value = smsV != null ? (smsV as boolean) : false;
          const smsPhonesVal = d["smsPhones"];
          smsPhones.value = smsPhonesVal != null ? (smsPhonesVal as string[]) : ([] as string[]);
          const contentsVal = d["contents"];
          const arr = contentsVal != null ? (contentsVal as UTSJSONObject[]) : ([] as UTSJSONObject[]);
          const list: MonitorContent[] = [];
          for (let i = 0; i < arr.length; i++) {
            const c = arr[i];
            const idVal = c["id"];
            const titleVal = c["title"];
            const kwVal = c["keywords"];
            const enVal = c["enabled"];
            const kwArr = kwVal != null ? (kwVal as string[]) : ([] as string[]);
            list.push(new MonitorContent(
              idVal != null ? (idVal as number) : 0,
              titleVal != null ? `${titleVal}` : "",
              kwArr,
              kwArr.join("、"),
              enVal != null ? (enVal as boolean) : false,
            ));
          }
          monitorContentList.value = list;
        }
      } else {
        uni.showToast({ title: t("Mobile.Terminal.monitorSettingsLoadFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchMonitoringSettings error", e);
      uni.showToast({ title: t("Mobile.Terminal.monitorSettingsLoadFailed"), icon: "none" });
    }
  };

  const allCharsAreDigits = (s: string): boolean => {
    if (s.length == 0) return false;
    for (let i = 0; i < s.length; i++) {
      const codeRaw = s.charCodeAt(i);
      if (codeRaw == null) return false;
      const code = codeRaw as number;
      if (code < 48 || code > 57) return false;
    }
    return true;
  };

  const isValidPhone = (phone: string): boolean => {
    if (phone.length != 11 || phone.charAt(0) != "1" || !allCharsAreDigits(phone)) return false;
    const secondRaw = phone.charCodeAt(1);
    if (secondRaw == null) return false;
    const second = secondRaw as number;
    return second >= 51 && second <= 57;
  };

  const isValidEmail = (email: string): boolean => {
    const at = email.indexOf("@");
    const dot = email.lastIndexOf(".");
    return at > 0 && dot > at + 1 && dot < email.length - 1;
  };

  const parseRecipientValues = (value: string): string[] => {
    const normalized = value
      .replace(new RegExp("，", "g"), ",")
      .replace(new RegExp("；", "g"), ",")
      .replace(new RegExp(";", "g"), ",")
      .replace(new RegExp("\\n", "g"), ",");
    const raw = normalized.split(",");
    const result: string[] = [];
    for (let i = 0; i < raw.length; i++) {
      const valueItem = raw[i].trim();
      if (valueItem.length == 0) continue;
      let exists = false;
      for (let j = 0; j < result.length; j++) {
        if (result[j] == valueItem) {
          exists = true;
          break;
        }
      }
      if (!exists) result.push(valueItem);
    }
    return result;
  };

  const parseEmailAddresses = (value: string): string[] => parseRecipientValues(value);
  const parseSmsPhones = (value: string): string[] => parseRecipientValues(value);

  const setEmailChannelLocal = (enabled: boolean): PushChannel | null => {
    for (let i = 0; i < pushChannelList.value.length; i++) {
      const channel = pushChannelList.value[i];
      if (channel.key == "emailEnabled") {
        replacePushChannelRow(i, new PushChannel(channel.key, channel.label, enabled));
        return channel;
      }
    }
    return null;
  };

  const saveEmailRecipients = async (emails: string[]): Promise<boolean> => {
    const oldEmails = emailAddresses.value;
    const shouldEnable = recipientEnableAfterSave.value;
    const oldChannel = shouldEnable ? setEmailChannelLocal(true) : null;
    emailAddresses.value = emails;
    const params = new AppMeetingPushSettingsUpdateParams();
    params.emailAddresses = emails;
    if (shouldEnable) params.emailEnabled = true;
    try {
      const res = await apiVoxUpdatePushSettings(deviceId.value, params);
      if (apiResCode(res) == SUCCESS_CODE) return true;
      const msg = apiResMessage(res);
      recipientError.value = msg.length > 0 ? msg : t("Mobile.Terminal.recipientSaveFailed");
    } catch (e) {
      console.error("saveEmailRecipients error", e);
    }
    emailAddresses.value = oldEmails;
    if (oldChannel != null) {
      for (let i = 0; i < pushChannelList.value.length; i++) {
        if (pushChannelList.value[i].key == "emailEnabled") {
          replacePushChannelRow(i, oldChannel);
          break;
        }
      }
    }
    return false;
  };

  const saveSmsRecipients = async (phones: string[]): Promise<boolean> => {
    const oldPhones = smsPhones.value;
    const oldEnabled = smsAlertEnabled.value;
    const shouldEnable = recipientEnableAfterSave.value ? true : oldEnabled;
    smsPhones.value = phones;
    smsAlertEnabled.value = shouldEnable;
    const params = new AppMonitoringSettingsUpdateParams();
    params.smsPhones = phones;
    params.smsAlertEnabled = shouldEnable;
    try {
      const res = await apiVoxUpdateMonitoringSettings(deviceId.value, params);
      if (apiResCode(res) == SUCCESS_CODE) return true;
    } catch (e) {
      console.error("saveSmsRecipients error", e);
    }
    smsPhones.value = oldPhones;
    smsAlertEnabled.value = oldEnabled;
    return false;
  };

  const saveRecipients = async () => {
    if (recipientSubmitting.value || configDisabled.value) return;
    recipientError.value = "";
    recipientSubmitting.value = true;
    let ok = false;
    if (recipientKind.value == "email") {
      const emails = parseEmailAddresses(recipientValue.value);
      if (emails.length == 0) {
        recipientError.value = t("Mobile.Terminal.emailRequired");
        recipientSubmitting.value = false;
        return;
      }
      for (let i = 0; i < emails.length; i++) {
        if (!isValidEmail(emails[i])) {
          recipientError.value = t("Mobile.Terminal.invalidEmail");
          recipientSubmitting.value = false;
          return;
        }
      }
      ok = await saveEmailRecipients(emails);
    } else {
      const phones = parseSmsPhones(recipientValue.value);
      if (phones.length == 0) {
        recipientError.value = t("Mobile.Terminal.phoneRequired");
        recipientSubmitting.value = false;
        return;
      }
      for (let i = 0; i < phones.length; i++) {
        if (!isValidPhone(phones[i])) {
          recipientError.value = t("Mobile.Terminal.invalidPhone");
          recipientSubmitting.value = false;
          return;
        }
      }
      ok = await saveSmsRecipients(phones);
    }
    recipientSubmitting.value = false;
    if (ok) {
      recipientPopupVisible.value = false;
      recipientEnableAfterSave.value = false;
      uni.showToast({ title: t("Mobile.Terminal.recipientSaved"), icon: "none" });
    } else {
      if (recipientError.value.length == 0) {
        recipientError.value = t("Mobile.Terminal.recipientSaveFailed");
      }
    }
  };

  const replaceMonitorContentRow = (index: number, item: MonitorContent) => {
    const list: MonitorContent[] = [];
    for (let i = 0; i < monitorContentList.value.length; i++) {
      list.push(i == index ? item : monitorContentList.value[i]);
    }
    monitorContentList.value = list;
  };

  /** 监控内容启用切换：先更新本地状态，POST 失败时才回滚 */
  const handleMonitorContentToggle = async (item: MonitorContent, index: number) => {
    if (configDisabled.value) return;
    if (deviceId.value == "" || item.id <= 0) return;
    const next = !item.enabled;
    const updated = new MonitorContent(item.id, item.title, item.keywords, item.keywordsText, next);
    // 替换整个数组引用，确保 uni-app x 立即重绘当前开关。
    replaceMonitorContentRow(index, updated);
    const params = new AppMonitoringContentUpsertParams();
    params.enabled = next;
    try {
      const res = await apiVoxUpdateMonitoringContent(deviceId.value, item.id, params);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: next ? t("Mobile.Terminal.monitorContentEnabledToast") : t("Mobile.Terminal.monitorContentDisabledToast"), icon: "none" });
      } else {
        replaceMonitorContentRow(index, item);
        uni.showToast({ title: t("Mobile.Terminal.monitorSettingsUpdateFailed"), icon: "none" });
      }
    } catch (e) {
      replaceMonitorContentRow(index, item);
      console.error("handleMonitorContentToggle error", e);
      uni.showToast({ title: t("Mobile.Terminal.monitorSettingsUpdateFailed"), icon: "none" });
    }
  };

  /** 当前项左滑偏移：滑动中跟手，否则按开合态（-SWIPE_DELETE_W / 0） */
  const contentOffset = (item: MonitorContent): number => {
    if (swipingContentId.value == item.id) return swipeOffset.value;
    if (openContentId.value == item.id) return -SWIPE_DELETE_W;
    return 0;
  };

  const contentIdFromTouchEvent = (e: UniTouchEvent): number => {
    const target = e.currentTarget;
    if (target == null) return 0;
    const raw = target.dataset["contentId"];
    if (raw == null) return 0;
    const parsed = parseFloat(`${raw}`);
    return !isNaN(parsed) ? parsed as number : 0;
  };

  const onContentTouchStart = (e: UniTouchEvent) => {
    if (e.touches.length == 0) return;
    const contentId = contentIdFromTouchEvent(e);
    if (contentId <= 0) return;
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
    touchBaseOffset = openContentId.value == contentId ? -SWIPE_DELETE_W : 0;
    swipingContentId.value = contentId;
    swipeOffset.value = touchBaseOffset;
  };

  const onContentTouchMove = (e: UniTouchEvent) => {
    const contentId = contentIdFromTouchEvent(e);
    if (swipingContentId.value != contentId) return;
    if (e.touches.length == 0) return;
    const dx = e.touches[0].clientX - touchStartX;
    const dy = e.touches[0].clientY - touchStartY;
    // 垂直分量更大时让位外层纵向滚动
    if (Math.abs(dy) > Math.abs(dx)) return;
    let off = touchBaseOffset + dx;
    if (off < -SWIPE_DELETE_W) off = -SWIPE_DELETE_W;
    if (off > 0) off = 0;
    swipeOffset.value = off;
  };

  const onContentTouchEnd = (e: UniTouchEvent) => {
    const contentId = contentIdFromTouchEvent(e);
    if (swipingContentId.value != contentId) return;
    if (swipeOffset.value < -SWIPE_DELETE_W / 2) {
      openContentId.value = contentId; // 打开（同时只一项）
    } else if (openContentId.value == contentId) {
      openContentId.value = 0;
    }
    swipingContentId.value = 0;
    swipeOffset.value = 0;
  };

  /** 执行删除（左滑按钮触发；局部 splice 移除，不整表刷新以保证流畅） */
  const doDeleteContent = async (item: MonitorContent, index: number) => {
    contentSubmitting.value = true;
    let ok = false;
    let errMsg = "";
    try {
      const res = await apiVoxDeleteMonitoringContent(deviceId.value, item.id);
      if (apiResCode(res) == SUCCESS_CODE) {
        ok = true;
      } else {
        errMsg = apiResMessage(res);
      }
    } catch (e) {
      console.error("doDeleteContent error", e);
    } finally {
      contentSubmitting.value = false;
    }
    if (ok) {
      if (openContentId.value == item.id) openContentId.value = 0;
      monitorContentList.value.splice(index, 1);
      uni.showToast({ title: t("Mobile.Terminal.monitorContentDeleted"), icon: "none" });
    } else {
      uni.showToast({ title: errMsg != "" ? errMsg : t("Mobile.Terminal.monitorContentDeleteFailed"), icon: "none" });
    }
  };

  /** 左滑删除（二次确认） */
  const deleteContent = (item: MonitorContent, index: number) => {
    if (configDisabled.value || contentSubmitting.value) return;
    if (deviceId.value == "" || item.id <= 0) return;
    uni.showModal({
      title: t("Mobile.Common.confirm"),
      content: t("Mobile.Terminal.monitorContentDeleteConfirm"),
      confirmText: t("Mobile.Common.delete"),
      cancelText: t("Mobile.Common.cancel"),
      success: (r) => {
        if (r.confirm != true) return;
        doDeleteContent(item, index);
      },
    });
  };

  /** 将输入串按中英文逗号 / 顿号 / 换行拆分为去空关键词数组 */
  const parseKeywords = (raw: string): string[] => {
    const out: string[] = [] as string[];
    let cur = "";
    for (let i = 0; i < raw.length; i++) {
      const ch = raw.charAt(i);
      if (ch == "," || ch == "，" || ch == "、" || ch == "\n") {
        const token = cur.trim();
        if (token.length > 0) out.push(token);
        cur = "";
      } else {
        cur = cur + ch;
      }
    }
    const last = cur.trim();
    if (last.length > 0) out.push(last);
    return out;
  };

  const openCreateContent = () => {
    if (configDisabled.value) return;
    editingContentId.value = 0;
    formTitle.value = "";
    formKeywords.value = "";
    contentFormError.value = "";
    contentPopupVisible.value = true;
  };

  const openEditContent = (item: MonitorContent) => {
    if (configDisabled.value) return;
    editingContentId.value = item.id;
    formTitle.value = item.title;
    formKeywords.value = item.keywords.join(",");
    contentFormError.value = "";
    contentPopupVisible.value = true;
  };

  const closeContentPopup = () => {
    if (contentSubmitting.value) return;
    contentPopupVisible.value = false;
    contentFormError.value = "";
  };

  /** 保存（新增 / 编辑）：标题必填，关键词至少一个；乐观落库失败回显错误 */
  const saveContent = async () => {
    if (configDisabled.value || contentSubmitting.value) return;
    const title = formTitle.value.trim();
    if (title.length == 0) {
      contentFormError.value = t("Mobile.Terminal.monitorContentTitleEmpty");
      return;
    }
    const keywords = parseKeywords(formKeywords.value);
    if (keywords.length == 0) {
      contentFormError.value = t("Mobile.Terminal.monitorContentKeywordsEmpty");
      return;
    }
    contentFormError.value = "";
    contentSubmitting.value = true;
    const params = new AppMonitoringContentUpsertParams();
    params.title = title;
    params.keywords = keywords;
    let ok = false;
    let errMsg = "";
    try {
      if (editingContentId.value > 0) {
        const res = await apiVoxUpdateMonitoringContent(deviceId.value, editingContentId.value, params);
        if (apiResCode(res) == SUCCESS_CODE) {
          ok = true;
        } else {
          errMsg = apiResMessage(res);
        }
      } else {
        const res = await apiVoxAddMonitoringContent(deviceId.value, params);
        if (apiResCode(res) == SUCCESS_CODE) {
          ok = true;
        } else {
          errMsg = apiResMessage(res);
        }
      }
    } catch (e) {
      console.error("saveContent error", e);
    } finally {
      contentSubmitting.value = false;
    }
    if (ok) {
      contentPopupVisible.value = false;
      uni.showToast({ title: t("Mobile.Terminal.monitorContentSaved"), icon: "none" });
      fetchMonitoringSettings();
    } else {
      contentFormError.value = errMsg != "" ? errMsg : t("Mobile.Terminal.monitorContentSaveFailed");
    }
  };

  /** 执行删除（由 removeContent 二次确认后调用；须先于 removeContent 声明，UTS 要求名称先声明后引用） */
  const doRemoveContent = async () => {
    contentSubmitting.value = true;
    let ok = false;
    let errMsg = "";
    try {
      const res = await apiVoxDeleteMonitoringContent(deviceId.value, editingContentId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        ok = true;
      } else {
        errMsg = apiResMessage(res);
      }
    } catch (e) {
      console.error("doRemoveContent error", e);
    } finally {
      contentSubmitting.value = false;
    }
    if (ok) {
      contentPopupVisible.value = false;
      uni.showToast({ title: t("Mobile.Terminal.monitorContentDeleted"), icon: "none" });
      fetchMonitoringSettings();
    } else {
      uni.showToast({ title: errMsg != "" ? errMsg : t("Mobile.Terminal.monitorContentDeleteFailed"), icon: "none" });
    }
  };

  /** 删除当前编辑项（二次确认） */
  const removeContent = () => {
    if (configDisabled.value || contentSubmitting.value) return;
    if (editingContentId.value <= 0) return;
    uni.showModal({
      title: t("Mobile.Common.confirm"),
      content: t("Mobile.Terminal.monitorContentDeleteConfirm"),
      confirmText: t("Mobile.Common.delete"),
      cancelText: t("Mobile.Common.cancel"),
      success: (r) => {
        if (r.confirm != true) return;
        doRemoveContent();
      },
    });
  };

  /** 告警渠道切换：乐观 + POST /monitoring/settings/update */
  // APP 告警固定开启、不可取消；仅短信渠道可切
  const handleAlarmToggle = async (key: string) => {
    if (configDisabled.value) return;
    if (key != "sms") return;
    if (deviceId.value == "") return;
    if (!smsAlertEnabled.value && smsPhones.value.length == 0) {
      recipientEnableAfterSave.value = true;
      openRecipientPopup("sms");
      return;
    }
    const next = !smsAlertEnabled.value;
    smsAlertEnabled.value = next;
    const params = new AppMonitoringSettingsUpdateParams();
    params.smsAlertEnabled = next;
    try {
      const res = await apiVoxUpdateMonitoringSettings(deviceId.value, params);
      if (apiResCode(res) != SUCCESS_CODE) {
        smsAlertEnabled.value = !next;
        uni.showToast({ title: t("Mobile.Terminal.monitorSettingsUpdateFailed"), icon: "none" });
      }
    } catch (e) {
      smsAlertEnabled.value = !next;
      console.error("handleAlarmToggle error", e);
      uni.showToast({ title: t("Mobile.Terminal.monitorSettingsUpdateFailed"), icon: "none" });
    }
  };

  const initModeList = () => {
    modeList.value = [
      new ModeItem("chat", t("Mobile.Terminal.modeChat")),
      new ModeItem("meeting", t("Mobile.Terminal.modeMeeting")),
      new ModeItem("monitor", t("Mobile.Terminal.modeMonitor")),
    ];
  };

  const resetDetailScroll = () => {
    detailScrollTop.value = 1;
    setTimeout(() => {
      detailScrollTop.value = 0;
    }, 0);
  };

  const openDetailView = (viewName: string) => {
    if (viewName != "emoji" && viewName != "settings") return;
    uni.navigateTo({
      url: `/subpackages/pages/terminal/terminal-device-detail?deviceId=${encodeURIComponent(deviceId.value)}&name=${encodeURIComponent(deviceName.value)}&bound=${deviceBound.value ? "1" : "0"}&subview=${viewName}`,
    });
  };

  const closeDetailView = () => {
    detailView.value = "overview";
    resetDetailScroll();
  };

  // 表情绑定 / 更多设置是详情页内部视图：系统侧滑返回时先退回详情概览，
  // 避免直接退出整个硬件详情页回到终端列表。
  onBackPress((_options: OnBackPressOptions): boolean => {
    if (standaloneSubview.value) return false;
    if (detailView.value == "overview") return false;
    closeDetailView();
    return true;
  });

  const openModePicker = () => {
    if (modeAndVolumeDisabled.value) return;
    modePickerVisible.value = true;
  };

  const closeModePicker = () => {
    modePickerVisible.value = false;
  };

  const handleModeSwitch = async (key: string) => {
    if (modeAndVolumeDisabled.value) return;
    // 我的电脑等无 deviceId 场景：仅本地切换
    if (deviceId.value == "" || activeMode.value == key) {
      activeMode.value = key;
      return;
    }
    const prev = activeMode.value;
    activeMode.value = key; // 乐观切换
    showLoadingMask(t("Mobile.Common.switching"));
    let ok = true;
    let errMsg = "";
    try {
      const res = await apiVoxUpdateDeviceMode(deviceId.value, toModeEnum(key));
      if (apiResCode(res) == SUCCESS_CODE) {
        // 用返回的最新设备详情校准 mode / online
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          const modeVal = d["mode"];
          if (modeVal != null) activeMode.value = toModeKey(`${modeVal}`);
          const onlineVal = d["online"];
          if (onlineVal != null) deviceOnline.value = onlineVal as boolean;
        }
      } else {
        ok = false;
        errMsg = apiResMessage(res);
      }
    } catch (e) {
      ok = false;
      console.error("handleModeSwitch error", e);
    } finally {
      hideLoadingMask();
    }
    if (!ok) {
      activeMode.value = prev; // 回滚
      uni.showToast({ title: errMsg != "" ? errMsg : t("Mobile.Terminal.modeSwitchFailed"), icon: "none" });
    }
  };

  const selectMode = async (key: string) => {
    modePickerVisible.value = false;
    await handleModeSwitch(key);
  };

  /** 音量拖动中实时预览，松手落定并下发 /voice-settings/update（离线由后端拒绝，失败回滚） */
  const readSliderValue = (e: UniSliderChangeEvent): number => {
    return e.detail.value;
  };
  const handleVolumeChanging = (e: UniSliderChangeEvent) => {
    if (modeAndVolumeDisabled.value) return;
    voiceVolume.value = readSliderValue(e);
  };
  const handleVolumeChange = async (e: UniSliderChangeEvent) => {
    if (modeAndVolumeDisabled.value) {
      voiceVolume.value = lastPersistedVolume.value;
      return;
    }
    const v = readSliderValue(e);
    console.log(`[DevDetail] handleVolumeChange v=${v} deviceId=${deviceId.value} online=${deviceOnline.value}`);
    if (deviceId.value == "") {
      voiceVolume.value = v;
      lastPersistedVolume.value = v;
      return;
    }
    const params = new AppDeviceVoiceSettingsUpdateParams();
    params.volumePercent = v;
    try {
      const res = await apiVoxUpdateVoiceSettings(deviceId.value, params);
      if (apiResCode(res) == SUCCESS_CODE) {
        voiceVolume.value = v;
        lastPersistedVolume.value = v;
      } else {
        voiceVolume.value = lastPersistedVolume.value; // 回滚到上次落库值
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
      }
    } catch (err) {
      voiceVolume.value = lastPersistedVolume.value;
      console.error("handleVolumeChange error", err);
      uni.showToast({ title: t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
    }
  };

  /** 语音播报开关：乐观切换 + 失败回滚 */
  const handleVoiceBroadcastToggle = async () => {
    if (configDisabled.value) return;
    if (deviceId.value == "") return;
    const next = !voiceBroadcastEnabled.value;
    const prev = voiceBroadcastEnabled.value;
    voiceBroadcastEnabled.value = next;
    const params = new AppDeviceVoiceSettingsUpdateParams();
    params.voiceBroadcastEnabled = next;
    try {
      const res = await apiVoxUpdateVoiceSettings(deviceId.value, params);
      if (apiResCode(res) != SUCCESS_CODE) {
        voiceBroadcastEnabled.value = prev;
        const msg = apiResMessage(res);
        uni.showToast({ title: msg != "" ? msg : t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
      }
    } catch (e) {
      voiceBroadcastEnabled.value = prev;
      console.error("handleVoiceBroadcastToggle error", e);
      uni.showToast({ title: t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
    }
  };

  const fetchVoiceSettings = async () => {
    if (deviceId.value == "") return;
    try {
      const res = await apiVoxGetVoiceSettings(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          const vbe = d["voiceBroadcastEnabled"];
          voiceBroadcastEnabled.value = vbe != null ? (vbe as boolean) : true;
          const vp = d["volumePercent"];
          const v = vp != null ? (vp as number) : 70;
          voiceVolume.value = v;
          lastPersistedVolume.value = v;
          const tvn = d["ttsVoiceName"];
          ttsVoiceName.value = tvn != null ? `${tvn}` : "";
          const tv = d["ttsVoice"];
          ttsVoiceId.value = tv != null ? `${tv}` : "";
        }
      } else {
        uni.showToast({ title: t("Mobile.Terminal.voiceSettingsLoadFailed"), icon: "none" });
      }
    } catch (e) {
      console.error("fetchVoiceSettings error", e);
      uni.showToast({ title: t("Mobile.Terminal.voiceSettingsLoadFailed"), icon: "none" });
    }
  };

  const fetchTtsVoices = async () => {
    try {
      const res = await apiVoxGetTtsVoices();
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        const opts: TtsVoiceOption[] = [];
        for (let i = 0; i < arr.length; i++) {
          const vid = arr[i]["voiceId"];
          const nm = arr[i]["name"];
          opts.push(new TtsVoiceOption(
            vid != null ? `${vid}` : "",
            nm != null ? `${nm}` : "",
          ));
        }
        ttsVoiceOptions.value = opts;
      }
    } catch (e) {
      console.error("fetchTtsVoices error", e);
    }
  };

  const applyTtsVoice = async (voiceId: string, label: string) => {
    const prevName = ttsVoiceName.value;
    const prevId = ttsVoiceId.value;
    ttsVoiceId.value = voiceId;
    ttsVoiceName.value = voiceId == "" ? t("Mobile.Terminal.ttsVoiceDefault") : label;
    const params = new AppDeviceVoiceSettingsUpdateParams();
    params.ttsVoice = voiceId;
    try {
      const res = await apiVoxUpdateVoiceSettings(deviceId.value, params);
      if (apiResCode(res) != SUCCESS_CODE) {
        ttsVoiceId.value = prevId;
        ttsVoiceName.value = prevName;
        uni.showToast({ title: t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
      }
    } catch (e) {
      ttsVoiceId.value = prevId;
      ttsVoiceName.value = prevName;
      console.error("applyTtsVoice error", e);
      uni.showToast({ title: t("Mobile.Terminal.voiceSettingsUpdateFailed"), icon: "none" });
    }
  };

  const handlePickTtsVoice = () => {
    if (configDisabled.value) return;
    if (deviceId.value == "") return;
    ttsPickerVisible.value = true;
  };

  const closeTtsPicker = () => {
    ttsPickerVisible.value = false;
  };

  const handleTtsVoiceChange = async (value: string) => {
    ttsPickerVisible.value = false;
    if (value == TTS_DEFAULT_VALUE) {
      await applyTtsVoice("", t("Mobile.Terminal.ttsVoiceDefault"));
      return;
    }
    for (let i = 0; i < ttsVoiceOptions.value.length; i++) {
      const item = ttsVoiceOptions.value[i];
      if (item.voiceId == value) {
        await applyTtsVoice(item.voiceId, item.name != "" ? item.name : item.voiceId);
        return;
      }
    }
  };

  const openDeviceProfilePopup = () => {
    if (configDisabled.value) return;
    if (deviceBindingId.value == "") {
      uni.showToast({ title: t("Mobile.Terminal.deviceProfileUnavailable"), icon: "none" });
      return;
    }
    deviceProfilePopupVisible.value = true;
  };

  const closeDeviceProfilePopup = () => {
    if (deviceProfileSubmitting.value) return;
    deviceProfilePopupVisible.value = false;
  };

  const saveDeviceProfile = async (profileDeviceName: string, profileDeviceRole: string, profileWakeWord: string) => {
    if (deviceProfileSubmitting.value || deviceBindingId.value == "") return;
    const params = new AppDeviceProfileUpdateParams();
    params.deviceName = profileDeviceName;
    params.deviceRole = profileDeviceRole;
    params.wakeWord = profileWakeWord;
    deviceProfileSubmitting.value = true;
    let success = false;
    let errMsg = "";
    try {
      const res = await apiVoxUpdateDeviceProfile(deviceBindingId.value, params);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        deviceName.value = params.deviceName;
        deviceRole.value = params.deviceRole;
        deviceWakeWord.value = params.wakeWord;
        if (d != null) {
          const nameVal = d["deviceName"];
          const roleVal = d["deviceRole"];
          const wakeWordVal = d["wakeWord"];
          if (nameVal != null) deviceName.value = `${nameVal}`;
          if (roleVal != null) deviceRole.value = `${roleVal}`;
          if (wakeWordVal != null) deviceWakeWord.value = `${wakeWordVal}`;
        }
        success = true;
      } else {
        errMsg = apiResMessage(res);
      }
    } catch (e) {
      console.error("saveDeviceProfile error", e);
    } finally {
      deviceProfileSubmitting.value = false;
    }
    if (success) {
      deviceProfilePopupVisible.value = false;
      uni.showToast({ title: t("Mobile.Terminal.deviceProfileUpdated"), icon: "none" });
    } else {
      uni.showToast({ title: errMsg != "" ? errMsg : t("Mobile.Terminal.deviceProfileUpdateFailed"), icon: "none" });
    }
  };

  const doUnbind = async () => {
    showLoadingMask(t("Mobile.Terminal.unbinding"));
    let success = false;
    let errMsg = "";
    try {
      const res = await apiVoxUnbindDevice(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        success = true;
      } else {
        errMsg = apiResMessage(res);
      }
    } catch (e) {
      console.error("doUnbind error", e);
    } finally {
      hideLoadingMask();
    }
    // loading 收起后再 toast/navigate，避免与 loading 叠加
    if (success) {
      uni.showToast({ title: t("Mobile.Terminal.unbindSuccess"), icon: "none" });
      setTimeout(() => {
        uni.navigateBack();
      }, 600);
    } else {
      uni.showToast({ title: errMsg != "" ? errMsg : t("Mobile.Terminal.unbindFailed"), icon: "none" });
    }
  };

  const handleUnbind = () => {
    if (deviceId.value == "" || !deviceBound.value) return;
    const statusText = deviceOnline.value
      ? t("Mobile.Terminal.connected")
      : t("Mobile.Terminal.disconnected");
    const deviceInfo = `${t("Mobile.Terminal.unbindDeviceName")}：${deviceName.value}\n${t("Mobile.Terminal.unbindDeviceId")}：${deviceId.value}\n${t("Mobile.Terminal.unbindDeviceStatus")}：${statusText}`;
    uni.showModal({
      title: t("Mobile.Terminal.unbindTitle"),
      content: `${deviceInfo}\n\n${t("Mobile.Terminal.unbindConfirm")}`,
      confirmText: t("Mobile.Terminal.unbindConfirmBtn"),
      cancelText: t("Mobile.Terminal.unbindCancel"),
      success: function (r) {
        if (r.confirm == true) {
          doUnbind();
        }
      },
    });
  };

  const doDeleteDeviceBinding = async () => {
    if (!infoReady.value) {
      uni.showToast({ title: t("Mobile.Terminal.loading"), icon: "none" });
      return;
    }
    const targetBindingId: string = deviceBindingId.value != "" ? deviceBindingId.value : deviceId.value;
    if (targetBindingId == "") return;

    showLoadingMask(t("Mobile.Terminal.deletingDevice"));
    let success = false;
    let errMsg = "";
    try {
      const res = await apiDeleteDeviceBinding(targetBindingId);
      if (apiResCode(res) == SUCCESS_CODE) {
        success = true;
      } else {
        errMsg = apiResMessage(res);
      }
    } catch (e) {
      console.error("doDeleteDeviceBinding error", e);
    } finally {
      hideLoadingMask();
    }
    if (success) {
      uni.showToast({ title: t("Mobile.Terminal.deleteDeviceSuccess"), icon: "none" });
      setTimeout(() => {
        uni.navigateBack();
      }, 600);
    } else {
      uni.showToast({ title: errMsg != "" ? errMsg : t("Mobile.Terminal.deleteDeviceFailed"), icon: "none" });
    }
  };

  const handleDeleteDeviceBinding = () => {
    if (deviceId.value == "") return;
    uni.showModal({
      title: t("Mobile.Terminal.deleteDeviceConfirmTitle"),
      content: t("Mobile.Terminal.deleteDeviceConfirm"),
      confirmText: t("Mobile.Common.confirm"),
      cancelText: t("Mobile.Common.cancel"),
      success: function (r) {
        if (r.confirm == true) {
          doDeleteDeviceBinding();
        }
      },
    });
  };

  const handleOpenChat = () => {
    // 详情未就绪时提示加载中，避免 fetchDeviceInfo 返回前误报"未关联"
    if (!infoReady.value) {
      uni.showToast({ title: t("Mobile.Terminal.loading"), icon: "none" });
      return;
    }
    // 用设备绑定的终端智能体 agentId 进入通用智能体会话详情页（与首页/智联录入口一致）
    if (deviceAgentId.value <= 0) {
      uni.showToast({ title: t("Mobile.Terminal.agentIdMissing"), icon: "none" });
      return;
    }
    // 会话 Id 由接口 conversationId 下发，带上才能加载历史会话；未关联时传 null
    const convId: number | null = deviceConversationId.value > 0 ? deviceConversationId.value : null;
    refreshDetailOnNextShow = true;
    jumpToAgentDetailPage(deviceAgentId.value, convId, "ChatBot", deviceName.value);
  };

  const handleGroupMembers = () => {
    if (!infoReady.value) {
      uni.showToast({ title: t("Mobile.Terminal.loading"), icon: "none" });
      return;
    }
    // 组员接口以设备关联的 agentId 为宿主，缺省时拦截进页
    if (deviceAgentId.value <= 0) {
      uni.showToast({ title: t("Mobile.Terminal.agentIdMissing"), icon: "none" });
      return;
    }
    refreshDetailOnNextShow = true;
    uni.navigateTo({
      url: `/subpackages/pages/terminal/terminal-group-members?agentId=${deviceAgentId.value}`,
      fail: () => {
        refreshDetailOnNextShow = false;
      },
    });
  };

  const handleMeetingRecords = () => {
    if (!infoReady.value) {
      uni.showToast({ title: t("Mobile.Terminal.loading"), icon: "none" });
      return;
    }
    if (deviceAgentId.value <= 0) {
      uni.showToast({ title: t("Mobile.Terminal.agentIdMissing"), icon: "none" });
      return;
    }
    uni.navigateTo({
      url: `/subpackages/pages/terminal/terminal-meeting-records?agentId=${deviceAgentId.value}&name=${encodeURIComponent(deviceName.value)}`,
    });
  };

  const handleMonitorRecords = () => {
    if (!infoReady.value) {
      uni.showToast({ title: t("Mobile.Terminal.loading"), icon: "none" });
      return;
    }
    if (deviceAgentId.value <= 0) {
      uni.showToast({ title: t("Mobile.Terminal.agentIdMissing"), icon: "none" });
      return;
    }
    uni.navigateTo({
      url: `/subpackages/pages/terminal/terminal-monitor-records?agentId=${deviceAgentId.value}&name=${encodeURIComponent(deviceName.value)}`,
    });
  };

  // 重新配网（换 WiFi）
  const handleReprovision = () => {
    if (deviceId.value == "") return;
    refreshDetailOnNextShow = true;
    uni.navigateTo({
      url: `/subpackages/pages/provision/provision-entry/provision-entry?deviceId=${encodeURIComponent(deviceId.value)}&name=${encodeURIComponent(deviceName.value)}`,
      fail: () => {
        refreshDetailOnNextShow = false;
      },
    });
  };

  const fetchGroupMemberCount = async () => {
    if (deviceAgentId.value <= 0) {
      groupMemberCount.value = 0;
      return;
    }
    try {
      const res = await apiGetGroupMembers(deviceAgentId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const arr = raw != null ? (raw as UTSJSONObject[]) : ([] as UTSJSONObject[]);
        groupMemberCount.value = arr.length;
      }
    } catch (e) {
      console.error("fetchGroupMemberCount error", e);
    }
  };

  const fetchDeviceInfo = async () => {
    infoReady.value = false;
    infoLoadFailed.value = false;
    deviceOnline.value = false;
    if (deviceId.value == "") {
      infoReady.value = true;
      return;
    }
    try {
      const res = await apiVoxDeviceDetail(deviceId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          const onlineVal = d["online"];
          deviceOnline.value = onlineVal != null ? (onlineVal as boolean) : false;
          const boundVal = d["bound"];
          if (boundVal != null) deviceBound.value = boundVal as boolean;
          const idVal = d["id"];
          if (idVal != null) deviceBindingId.value = `${idVal}`;
          const newNameVal = d["deviceName"];
          const displayNameVal = d["displayName"];
          const nameVal = newNameVal != null ? newNameVal : displayNameVal;
          if (nameVal != null && `${nameVal}` != "") {
            deviceName.value = `${nameVal}`;
          }
          const roleVal = d["deviceRole"];
          if (roleVal != null) deviceRole.value = `${roleVal}`;
          const wakeWordVal = d["wakeWord"];
          if (wakeWordVal != null) deviceWakeWord.value = `${wakeWordVal}`;
          // 后端下发 agentId，供组员管理等主站配置接口使用
          const agentIdVal = d["agentId"];
          if (agentIdVal != null) {
            const parsed = parseFloat(`${agentIdVal}`);
            deviceAgentId.value = !isNaN(parsed) && parsed > 0 ? parsed as number : 0;
          } else {
            deviceAgentId.value = 0;
          }
          // 会话 Id（接口 conversationId 下发，进会话加载历史用）
          const convIdVal = d["conversationId"];
          if (convIdVal != null) {
            const parsedConv = parseFloat(`${convIdVal}`);
            deviceConversationId.value = !isNaN(parsedConv) && parsedConv > 0 ? parsedConv as number : 0;
          } else {
            deviceConversationId.value = 0;
          }
          // 工作模式回显（CONVERSATION/MEETING/MONITORING → chat/meeting/monitor）
          const modeVal = d["mode"];
          if (modeVal != null) activeMode.value = toModeKey(`${modeVal}`);
          infoReady.value = true;
          await fetchGroupMemberCount();
        } else {
          infoLoadFailed.value = true;
        }
      } else {
        infoLoadFailed.value = true;
        uni.showToast({ title: t("Mobile.Terminal.fetchDevicesFailed"), icon: "none" });
      }
    } catch (e) {
      infoLoadFailed.value = true;
      console.error("fetchDeviceInfo error", e);
      uni.showToast({ title: t("Mobile.Terminal.fetchDevicesFailed"), icon: "none" });
    }
  };

  // 仅从可能修改详情数据的子页面返回时刷新，避免首次 onShow 与 onLoad 重复请求。
  onShow(() => {
    if (!refreshDetailOnNextShow) return;
    refreshDetailOnNextShow = false;
    fetchDeviceInfo();
  });

  onLoad((options: any) => {
    if (options != null) {
      const optObj = options as UTSJSONObject;
      const dt = optObj["deviceType"];
      if (dt != null && `${dt}`.length > 0) {
        deviceType.value = `${dt}`;
      }
      const id = optObj["deviceId"];
      if (id != null && `${id}`.length > 0) {
        deviceId.value = orEmpty(decodeURIComponent(`${id}`));
        // 网关绑定设备一律按灵珠处理
        deviceType.value = "lingzhu";
      }
      const nm = optObj["name"];
      if (nm != null && `${nm}`.length > 0) {
        deviceName.value = orEmpty(decodeURIComponent(`${nm}`));
      }
      const bound = optObj["bound"];
      if (bound != null) {
        deviceBound.value = `${bound}` != "0" && `${bound}` != "false";
      }
      const subview = optObj["subview"];
      if (subview != null) {
        const viewName = `${subview}`;
        if (viewName == "emoji" || viewName == "settings") {
          detailView.value = viewName;
          standaloneSubview.value = true;
        }
      }
    }
    initModeList();
    setCurrentPageNavigationBarTitle();
    if (isLingzhu.value && deviceId.value != "") {
      // 进入页面：并行拉取全部配置，合并为单个 loading（全部完成才收起）
      showLoadingMask(t("Mobile.Terminal.loading"));
      let remaining = 5;
      const settle = () => {
        remaining = remaining - 1;
        if (remaining == 0) hideLoadingMask();
      };
      settleWhenDone(fetchDeviceInfo(), settle);
      settleWhenDone(fetchPushSettings(), settle);
      settleWhenDone(fetchVoiceSettings(), settle);
      settleWhenDone(fetchTtsVoices(), settle);
      settleWhenDone(fetchMonitoringSettings(), settle);
    }
  });
</script>

