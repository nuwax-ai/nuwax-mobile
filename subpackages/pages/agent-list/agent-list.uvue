<template>
  <!-- 导航栏 -->
  <custom-nav-bar :title="t('Mobile.Nav.agent')" hasSafetyZone>
    <!-- #ifdef MP-WEIXIN -->
    <template v-slot:left>
      <svg-icon v-if="isLoggedIn" name="icon-Search" size="48" @click="handleSearch" />
    </template>
    <!-- #endif -->
    <!-- #ifndef MP-WEIXIN -->
    <template v-slot:right>
      <svg-icon v-if="isLoggedIn" name="icon-Search" size="48" @click="handleSearch" />
    </template>
    <!-- #endif -->
  </custom-nav-bar>

  <published-agent-list
    ref="publishedAgentListRef"
    agentType="ChatBot"
    :title="t('Mobile.Nav.agent')"
  ></published-agent-list>
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  import PublishedAgentList from '@/components/published-agent-list/published-agent-list.uvue'
  // #ifdef MP-WEIXIN
  import { onAddToFavorites } from '@dcloudio/uni-app'
  // #endif
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { syncNativeTabBarState } from "@/utils/commonBusiness";
  import { onShow } from "@dcloudio/uni-app";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const publishedAgentListRef = ref<ComponentPublicInstance | null>(null);

  // 导航栏搜索入口（登录后展示）；搜索页为本地过滤模式，列表数据由 published-agent-list 内部维护
  const isLoggedIn = ref<boolean>(false);

  function handleSearch(): void {
    uni.navigateTo({
      url: "/subpackages/pages/agent-search/agent-search?type=ChatBot&searchMode=local",
    });
  }

  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) return;
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  // 切到本 tab 时清除可能残留的 mask:true loading，并触发智能体列表静默刷新（对齐 index.uvue / mine.uvue）
  onShow(() => {
    uni.hideLoading();
    // 校准原生 tabBar 显隐（自绘模式常隐 / 兜底模式恢复原生栏）
    syncNativeTabBarState();
    callRefMethod(publishedAgentListRef.value, "refreshData");
  });

  // #ifdef MP-WEIXIN
  // 收藏
  onAddToFavorites(() => {
    return {
      title: t("Mobile.Nav.agent"),
    }
  })
  // #endif
</script>

<!-- H5：禁止页面级滚动，仅列表内部滚动 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
  }
  /* #endif */
</style>
