/**
 * MCP Ask 表单数据规范化
 * 对齐 nuwax Web 版 normalizeMcpAskFormData.ts
 */
import { UploadFileStatus } from "@/types/enums/common.uts";
import { UploadFileInfo } from "@/types/interfaces/common.uts";
import type { InteractionUiSchema } from "@/types/intervention";
import { parseInteractionFields } from "@/utils/mcpAskSchema.uts";

interface AttachmentFileLike {
  fileUrl?: string;
  fileKey?: string;
  fileName?: string;
  mimeType?: string;
  fileSize?: number;
}

/** 判断是否为统一文件上传服务返回的可访问远程 URL */
export function isRemoteFileUrl(url: any): boolean {
  return (
    typeof url === "string" &&
    (url.startsWith("http://") || url.startsWith("https://"))
  );
}

function isUploadFileInfoLike(item: any): boolean {
  return (
    item != null &&
    typeof item === "object" &&
    ("url" in item || "name" in item || "uid" in item)
  );
}

/** 判断是否为会话附件结构（AttachmentFile） */
function isAttachmentFileLike(item: any): boolean {
  return (
    item != null &&
    typeof item === "object" &&
    ("fileUrl" in item || "fileName" in item || "fileKey" in item)
  );
}

function inferFileNameFromUrl(url: string): string {
  try {
    const pathname = new URL(url).pathname;
    const parts = pathname.split("/").filter((part: string): boolean => part.length > 0);
    return parts.length > 0 ? parts[parts.length - 1] : "file";
  } catch (_err) {
    const parts = url.split("/").filter((part: string): boolean => part.length > 0);
    return parts.length > 0 ? parts[parts.length - 1] : "file";
  }
}

function urlToUploadFileInfo(url: string, index: number): UploadFileInfo {
  const file = new UploadFileInfo();
  file.uid = `mcp-ask-url-${index}`;
  file.name = inferFileNameFromUrl(url);
  file.type = "";
  file.size = 0;
  file.url = url;
  file.status = UploadFileStatus.done;
  return file;
}

/** 将 UploadFileInfo / AttachmentFile / URL 转为发送消息用的 UploadFileInfo */
function toUploadFileInfo(item: any, index: number): UploadFileInfo | null {
  if (typeof item === "string" && isRemoteFileUrl(item)) {
    return urlToUploadFileInfo(item, index);
  }

  if (isUploadFileInfoLike(item)) {
    const fileItem = item as UploadFileInfo;
    if (fileItem.status === UploadFileStatus.removed) {
      return null;
    }
    const url = fileItem.url;
    if (!isRemoteFileUrl(url)) {
      return null;
    }
    const file = new UploadFileInfo();
    file.uid =
      fileItem.uid != null && fileItem.uid.length > 0
        ? fileItem.uid
        : `mcp-ask-file-${index}`;
    file.name =
      fileItem.name != null && fileItem.name.length > 0
        ? fileItem.name
        : inferFileNameFromUrl(url);
    file.type = fileItem.type != null ? fileItem.type : "";
    file.size = fileItem.size != null ? fileItem.size : 0;
    file.url = url;
    file.key = fileItem.key;
    file.status =
      fileItem.status != null ? fileItem.status : UploadFileStatus.done;
    return file;
  }

  if (isAttachmentFileLike(item)) {
    const attach = item as AttachmentFileLike;
    const url = attach.fileUrl;
    if (!isRemoteFileUrl(url)) {
      return null;
    }
    const file = new UploadFileInfo();
    file.uid =
      attach.fileKey != null && attach.fileKey.length > 0
        ? attach.fileKey
        : `mcp-ask-attach-${index}`;
    file.name =
      attach.fileName != null && attach.fileName.length > 0
        ? attach.fileName
        : inferFileNameFromUrl(url);
    file.type = attach.mimeType != null ? attach.mimeType : "";
    file.size = attach.fileSize != null ? attach.fileSize : 0;
    file.url = url;
    file.key = attach.fileKey;
    file.status = UploadFileStatus.done;
    return file;
  }

  return null;
}

/**
 * 从 MCP Ask 表单 file 字段收集已上传附件，供 resume 消息走 chat attachments 发送。
 */
export function extractMcpAskFormAttachments(
  formData: any,
  ui: InteractionUiSchema,
): UploadFileInfo[] {
  const attachments: UploadFileInfo[] = [];

  parseInteractionFields(ui).forEach((field) => {
    if (field.widget !== "file") {
      return;
    }
    if (!Object.prototype.hasOwnProperty.call(formData, field.name)) {
      return;
    }

    const rawValue = formData[field.name];
    const items: any[] = [];

    if (typeof rawValue === "string") {
      items.push(rawValue);
    } else if (Array.isArray(rawValue)) {
      for (let i = 0; i < rawValue.length; i++) {
        items.push(rawValue[i]);
      }
    } else if (rawValue !== undefined && rawValue !== null && rawValue !== "") {
      items.push(rawValue);
    }

    items.forEach((item: any) => {
      const fileInfo = toUploadFileInfo(item, attachments.length);
      if (fileInfo != null) {
        attachments.push(fileInfo);
      }
    });
  });

  return attachments;
}
