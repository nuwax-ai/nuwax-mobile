<template>
  <!-- APP 平台：渲染 SVG 图片 -->
  <!-- #ifdef APP -->
  <image
    :src="svgSrc"
    mode="aspectFit"
    :style="{
      width: `${size}rpx`,
      height: `${size}rpx`,
    }"
    class="svg-icon"
    @tap="handleTap"
  />
  <!-- #endif -->

  <!-- 非 APP 平台（H5 / MP-WEIXIN）：渲染字体图标 -->
  <!-- #ifndef APP -->
  <text
    class="iconfont"
    :class="textClasses"
    @tap="handleTap"
  ><slot /></text>
  <!-- #endif -->
</template>

<script lang="uts" setup>
  import { computed } from "vue";

  /**
   * 通用图标组件
   * - APP 平台：使用 <image> 加载 SVG 图标
   * - H5 / MP-WEIXIN 平台：使用 iconfont 字体图标
   */
  const props = withDefaults(
    defineProps<{
      /** 图标名称，如 "icon-Search"、"icon-Star" */
      name: string;
      /** 图标大小（单位 rpx），APP 下为 SVG 宽高，非 APP 沿用 font-size */
      size?: number;
      /** 额外的 CSS 类名（非 APP 平台附加到 text 元素） */
      customClass?: string;
    }>(),
    {
      size: 46,
      customClass: "",
    },
  );

  const emit = defineEmits<{
    (e: "tap", event: any): void;
  }>();

  /** SVG 文件路径（APP 平台使用，@ 由构建工具解析为项目根目录） */
  const svgSrc = `@/static/svgs/${props.name}.svg`;

  /** 非 APP 平台的 text 元素类名 */
  const textClasses = computed((): string => {
    let cls = props.name;
    if (props.customClass.length > 0) {
      cls = cls + " " + props.customClass;
    }
    return cls;
  });

  /** 处理点击事件 */
  const handleTap = (event: any) => {
    emit("tap", event);
  };
</script>

<style scoped>
  /* #ifdef APP */
  .svg-icon {
    display: inline-block;
    vertical-align: middle;
  }
  /* #endif */
</style>
