    display: flex;
    flex-direction: row;
    align-items: stretch;
    border-bottom: 1px solid #ebeaf0;
    background-color: #ffffff;
  }

  .pull-chat-preview__tab {
    min-width: 52px;
    margin-right: 14px;
    display: flex;
    flex-direction: row;
