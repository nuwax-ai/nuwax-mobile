export function nativeAuthAvailable(): boolean { return NativeAuthBridgeSwift.available(); }
export function nativeAuthRandomToken(): string { return NativeAuthBridgeSwift.randomToken(); }
export function nativeAuthSha256(value: string): string { return NativeAuthBridgeSwift.sha256(value); }
export function nativeAuthRead(): string { return NativeAuthBridgeSwift.read(); }
export function nativeAuthWrite(value: string): boolean { return NativeAuthBridgeSwift.write(value); }
export function nativeAuthClear(): boolean { return NativeAuthBridgeSwift.clear(); }
export function nativeAuthOpen(value: string): boolean { return NativeAuthBridgeSwift.open(value); }
export function nativeAuthCancel(requestId: string): void { NativeAuthBridgeSwift.cancel(requestId); }
export function nativeAuthTakeResult(): string { return NativeAuthBridgeSwift.takeResult(); }

/** DCloud 自动注册导出的生命周期代理；只消费本插件已校验的回调。 */
export class NuwaxNativeAuthHook implements UTSiOSHookProxy {
  applicationOpenURLOptions(app: UIApplication | null, url: URL, options: Map<UIApplication.OpenURLOptionsKey, any> | null = null): boolean {
    return NativeAuthBridgeSwift.receive(url.absoluteString);
  }
}
