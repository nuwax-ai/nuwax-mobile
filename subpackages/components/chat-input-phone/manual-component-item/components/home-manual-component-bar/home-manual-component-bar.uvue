<template>
  <view class="home-manual-wrapper">
    <scroll-view
      class="home-manual-container"
      direction="horizontal"
      :scroll-x="true"
      :scroll-y="false"
      :show-scrollbar="false"
    >
      <view class="home-manual-scroll-content">
      <!-- 自动/审批模式选择 -->
      <view
        v-if="showAgentMode"
        class="manual-box manual-select"
        :class="{ disabled: props.readonlyVal }"
        @click="emit('openAgentModeDrawer')"
      >
        <text class="text text-ellipsis">{{ props.currentAgentModeLabel }}</text>
        <text class="icon iconfont icon-arrow-down"></text>
      </view>

      <!-- 沙盒选择 -->
      <view v-if="showSandbox" class="manual-group">
        <view
          v-if="showEnabledSandbox"
          class="manual-box manual-select"
          @click="emit('openSandboxDrawer')"
        >
          <text class="text text-ellipsis">{{ props.currentSandboxName }}</text>
          <text class="icon iconfont icon-arrow-down"></text>
        </view>
        <view v-else class="manual-box manual-select disabled">
          <text class="text text-ellipsis">{{ props.sandboxDisabledTextVal }}</text>
        </view>
      </view>

      <!-- 模型选择 -->
      <view
        v-if="showModelSelect"
        class="manual-box manual-select"
        @click="emit('openModelSelect')"
      >
        <text class="text text-ellipsis">{{ props.modelSelectLabelVal }}</text>
        <text class="icon iconfont icon-arrow-down"></text>
      </view>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts" setup>
  import { computed } from "vue";

  const props = withDefaults(
    defineProps<{
      isTaskAgentVal?: boolean;
      allowChooseModeVal?: boolean;
      readonlyVal?: boolean;
      currentAgentModeLabel?: string;
      isSandboxUnavailableVal?: boolean;
      currentSandboxName?: string;
      sandboxDisabledTextVal?: string;
      allowOtherModelVal?: boolean;
      modelSelectLabelVal?: string;
    }>(),
    {
      isTaskAgentVal: false,
      allowChooseModeVal: false,
      readonlyVal: false,
      currentAgentModeLabel: "",
      isSandboxUnavailableVal: false,
      currentSandboxName: "",
      sandboxDisabledTextVal: "",
      allowOtherModelVal: false,
      modelSelectLabelVal: "",
    },
  );

  /** Android 模板中须先解包 props，避免组合条件被判定为 false。 */
  const showAgentMode = computed((): boolean =>
    props.isTaskAgentVal == true && props.allowChooseModeVal == true,
  );
  const showSandbox = computed((): boolean =>
    props.isTaskAgentVal == true && props.readonlyVal == false,
  );
  const showEnabledSandbox = computed((): boolean =>
    props.isSandboxUnavailableVal == false && props.currentSandboxName.length > 0,
  );
  const showModelSelect = computed((): boolean => props.allowOtherModelVal == true);

  const emit = defineEmits<{
    (e: "onOpenPagePreview"): void;
    (e: "onOpenFileTree"): void;
    (e: "openAgentModeDrawer"): void;
    (e: "openSandboxDrawer"): void;
    (e: "openModelSelect"): void;
  }>();
</script>

<style lang="scss" scoped>
  .home-manual-wrapper {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: 76rpx;
    align-items: center;
  }

  .home-manual-container {
    width: 100%;
    height: 76rpx;
  }

  .home-manual-scroll-content {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    height: 76rpx;
    /* #ifdef H5 */
    width: max-content;
    /* #endif */
  }

  .manual-group {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    margin-right: 12rpx;
  }

  .manual-box {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    height: 76rpx;
    max-width: 220rpx;
    padding: 16rpx 20rpx;
    margin-right: 12rpx;
    border-radius: 16rpx;
    border: 2rpx solid #eeeeee;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .manual-box:last-child {
    margin-right: 0;
  }

  .text {
    flex: 1;
    min-width: 0;
    flex-shrink: 1;
    color: rgba(21, 23, 31, 0.7);
    font-size: 26rpx;
    font-weight: 400;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    lines: 1;
  }

  .icon-arrow-down {
    font-size: 20rpx;
    margin-left: 2rpx;
    color: rgba(21, 23, 31, 0.4);
    flex-shrink: 0;
  }

  // vapor: &.disabled 提为顶层单类 .disabled（原复合选择器作用于 .manual-box 元素本身）
  .disabled {
    opacity: 0.6;
    background: #f5f5f5;
    pointer-events: none;
  }
</style>
