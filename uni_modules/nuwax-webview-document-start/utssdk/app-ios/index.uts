import { WKWebView } from "WebKit";

/**
 * 用同源文档写入 ACCESS_TOKEN，再由文档跳到资料库。
 * 视图还不是 WKWebView 时返回 false。
 * @param elementId web-view 的 id
 * @param html 引导文档
 * @param baseUrl 资料库站点源，决定 localStorage 落在哪个源
 */
export function primeIosRepoAccessToken(elementId: string, html: string, baseUrl: string): boolean {
  if (elementId.length == 0 || html.length == 0 || baseUrl.length == 0) {
    return false;
  }
  const el = uni.getElementById(elementId);
  if (el == null) {
    return false;
  }
  const view = el.getIOSView();
  if (view == null || (view instanceof WKWebView) == false) {
    return false;
  }
  try {
    return RepoDocumentStartBridge.loadTokenPage(view as WKWebView, html, baseUrl);
  } catch (_e) {
    return false;
  }
}
