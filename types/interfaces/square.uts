import { AllowCopyEnum } from '../enums/agent';
import { PluginTypeEnum } from '../enums/plugin';
// 值导入（非 import type）：SquareCategoryInfo 类默认值需要 SquareAgentTypeEnum 运行时值
import { SquareAgentTypeEnum } from '../enums/square';
import type {
  AgentStatisticsInfo,
  CreatorInfo,
} from './agent';

/**
 * 广场 - 已发布 / 最近使用列表请求参数
 * UTS: 使用 class，interface 对象字面量初始化会报 "does not have constructors"。
 * Android 上 class 实例序列化会带上未赋值的可选字段为 null，请求前请用 buildSquarePublishedListBody。
 */
export class SquarePublishedListParams {
  // 目标类型，可用值:Agent,Plugin,Workflow,Knowledge,Table,Skill,Model,PageApp,Mcp,UserApp,ThirdApp,NormalProject,Conversation
  // 必须用 string：Android 上 UTS enum 序列化会变成 { value: "Agent" }，接口需要纯字符串
  targetType: string = "";
  // 目标类型列表（多类型联合查询，如应用列表的网页应用+全栈应用）
  targetTypes: string[] = [] as string[];
  // 子类型,可用值:Multi,Single,WorkflowChat,ChatBot,TaskAgent,Agent,PageApp,UserApp,ThirdApp
  targetSubType: string = "";
  // 子类型列表（多类型联合查询时的子类型过滤，如应用列表的 PageApp+UserApp）
  targetSubTypes: string[] = [] as string[];
  // 搜索范围（可见范围）：Tenant-系统广场（默认）；Space-团队空间,可用值:Space,Tenant,Global
  scope: string = "";
  // 智能体类型
  agentTypes: string[] = [] as string[];
  // 页码，从1开始
  page: number = 1;
  // 上一页最后一条数据的时间戳，与 page 二选一
  lastTimestamp: number = 0;
  // 每页数量
  pageSize: number = 10;
  // 分类名称
  category: string = "";
  // 关键字搜索
  kw: string = "";
  // 空间ID：0 不指定，-1 搜索场景，正数为具体团队空间。
  spaceId: number = 0;
  // 只返回空间的组件
  justReturnSpaceData: boolean = false;
  // 访问控制过滤，0 无需过滤，1 过滤出需要权限管控的内容
  accessControl: number = 0;
  // 是否只返回官方标识的内容
  official: boolean = false;
  // 适用场景筛选参数，如 [TaskAgent, PageApp]
  usageScenarios: string[] = [] as string[];
  // 团队空间多选过滤（专家列表“团队空间”分组）
  spaceIds?: number[];
}

/**
 * 广场-已发布的组件单项信息
 * statistics / publishUser 分别对应接口 StatisticsDto、PublishUserDto
 */
export interface SquarePublishedItemInfo {
  // 发布ID
  id: number;
  tenantId: number;
  spaceId: number;
  groupId: number;
  // 目标对象类型,可用值:Agent,Plugin,Workflow,Knowledge,Table,Skill,Model,PageApp,Mcp,UserApp,ThirdApp,NormalProject,Conversation
  targetType: SquareAgentTypeEnum;
  // 目标对象（智能体、工作流、插件）类型,可用值:ChatBot,PageApp
  agentType: 'ChatBot' | 'PageApp';
  // 目标对象（智能体、工作流、插件）ID
  targetId: number;
  // 发布名称
  name: string;
  // 描述
  description?: string | null;
  // 图标
  icon: string;
  // 扩展字段
  ext?: UTSJSONObject | null;
  // 适用场景列表，如 [TaskAgent, PageApp]
  usageScenarios?: string[] | null;
  remark: string;
  // 智能体发布修改时间
  modified: string;
  // 智能体发布创建时间
  created: string;
  // 统计信息(智能体、插件、工作流相关的统计都在该结构里，根据实际情况取值)
  statistics: AgentStatisticsInfo;
  // 发布者信息
  publishUser: CreatorInfo;
  // 分类名称
  category: string;
  // 是否允许复制, 1 允许
  allowCopy: AllowCopyEnum;
  // 访问控制, 0 不走权限管控；1 走权限管控
  accessControl: number;
  // 可用值:HTTP,CODE
  pluginType?: PluginTypeEnum | null;
  // 封面图
  coverImg?: string | null;
  // 封面图片来源,可用值:SYSTEM,USER
  coverImgSourceType?: string | null;
  // 是否需要付费
  paymentRequired?: boolean;
  // 价格
  price?: number | null;
  // 价格类型, ONE_TIME 次；SECOND 秒；MILLION_TOKEN 百万Token
  pricingType?: string | null;
  // 是否已订阅，对智能体和技能有效
  subscribed?: boolean;
  // 是否超出调用限制
  overCallLimit?: boolean;
  enabled?: boolean;
  collect: boolean;
}

// 广场智能体与插件分类信息
// class（非 interface）：首页类型 pill 需要逐字段组装实例，interface 运行时擦除不可 new
export class SquareCategoryInfo {

  // 类别名称
  key: string = "";
  // 类别描述
  label: string = "";
  type: SquareAgentTypeEnum = SquareAgentTypeEnum.Agent;
  // 分类图标（接口下发才有，空不展示）
  icon: string = "";
  children: SquareCategoryInfo[] = [] as SquareCategoryInfo[];
}
