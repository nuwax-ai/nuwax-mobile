<template>
  <view v-if="providers.length > 0 || busy || errorText.length > 0" class="native-idp-login">
    <text v-if="errorText.length > 0" class="native-idp-error">{{ errorText }}</text>
    <text v-if="providers.length > 0" class="native-idp-title">{{ t('Mobile.Auth.externalLogin') }}</text>
    <view v-for="provider in providers" :key="provider.id" class="native-idp-option">
      <button class="native-idp-button" :disabled="busy || disabled" :loading="busy && activeId == provider.id" @click="login(provider)">
        <image v-if="provider.icon.length > 0" class="native-idp-icon" :src="provider.icon" mode="aspectFit" />
        <text class="native-idp-name">{{ provider.name.length > 0 ? provider.name : t('Mobile.Auth.externalLogin') }}</text>
      </button>
    </view>
    <button v-if="busy" class="native-idp-cancel" @click="cancel">{{ t('Mobile.Common.cancel') }}</button>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted, onUnmounted } from 'vue';
import { AuthIdpProvider } from '@/types/interfaces/authIdp';
import { NativeAuthResult } from '@/types/interfaces/nativeAuth';
import { NATIVE_AUTH_PROVIDER_IDS } from '@/constants/nativeAuth';
import { apiAuthIdpLoginList } from '@/servers/authIdp';
import { apiResCode, apiResData } from '@/utils/apiResponse';
import { SUCCESS_CODE } from '@/constants/codes.constants';
import { getApiBaseUrl } from '@/constants/config';
import { AuthLoadScope, parseAuthIdpList, availableAuthProviders } from '@/utils/authIdp';
import { nativeAuthReadiness, startNativeAuth, cancelNativeAuth, nativeAuthStatus, NATIVE_AUTH_STATUS_EVENT } from '@/utils/nativeAuthRuntime';
import { useI18n, emptyI18nParams } from '@/utils/i18n';

const props = defineProps<{ agreed: boolean, disabled: boolean, redirectUrl: string }>();
const emit = defineEmits(['agreed', 'busy']);
const { t: translate } = useI18n();
const t = (key: string): string => translate(key, emptyI18nParams(), '');
const providers = ref<AuthIdpProvider[]>([]);
const busy = ref<boolean>(false);
const activeId = ref<string>('');
const errorText = ref<string>('');
const scope = new AuthLoadScope();
let loadedOrigin = '';
let loadedRevision = 0;

function setBusy(value: boolean): void { busy.value = value; emit('busy', value); }

function updateStatus(result: NativeAuthResult): void {
  setBusy(['preparing', 'authorizing', 'exchanging', 'verifying'].includes(result.status));
  if (result.status == 'failed' || result.status == 'expired' || result.status == 'blocked') {
    errorText.value = t('Mobile.Auth.idpSessionFailed');
  } else errorText.value = '';
}

function statusChanged(_data: any): void { updateStatus(nativeAuthStatus()); }

function cancel(): void { cancelNativeAuth(); updateStatus(nativeAuthStatus()); }

function login(provider: AuthIdpProvider): void {
  if (busy.value || props.disabled || nativeAuthReadiness() != 'ready' ||
      !scope.accepts(loadedRevision, loadedOrigin, getApiBaseUrl())) return;
  activeId.value = provider.id;
  setBusy(true);
  errorText.value = '';
  const start = (): void => {
    if (!scope.accepts(loadedRevision, loadedOrigin, getApiBaseUrl())) return;
    startNativeAuth(provider.id, provider.type, props.redirectUrl).then((result: NativeAuthResult): void => {
      if (scope.accepts(loadedRevision, loadedOrigin, getApiBaseUrl())) updateStatus(result);
    }).catch((_error: any | null): void => {
      if (!scope.accepts(loadedRevision, loadedOrigin, getApiBaseUrl())) return;
      setBusy(false);
      errorText.value = t('Mobile.Auth.idpUnavailable');
    });
  };
  if (props.agreed) { start(); return; }
  uni.showModal({
    title: t('Mobile.Common.tip'), content: t('Mobile.Auth.pleaseAgreeProtocol'),
    confirmText: t('Mobile.Common.agree'), cancelText: t('Mobile.Common.disagree'),
    success: (res) => {
      if (!scope.accepts(loadedRevision, loadedOrigin, getApiBaseUrl())) return;
      if (res.confirm == true) { emit('agreed'); start(); } else setBusy(false);
    },
    fail: (_error) => { if (scope.accepts(loadedRevision, loadedOrigin, getApiBaseUrl())) setBusy(false); },
  });
}

async function loadProviders(): Promise<void> {
  // 未配置/旧基座不显示入口，也不额外请求公开列表；原生本阶段只支持手动发起。
  if (nativeAuthReadiness() != 'ready' || NATIVE_AUTH_PROVIDER_IDS.length == 0) return;
  uni.$on(NATIVE_AUTH_STATUS_EVENT, statusChanged);
  updateStatus(nativeAuthStatus());
  const revision = scope.begin();
  const origin = getApiBaseUrl();
  try {
    const response = await apiAuthIdpLoginList();
    if (!scope.accepts(revision, origin, getApiBaseUrl()) || apiResCode(response) != SUCCESS_CODE) return;
    loadedOrigin = origin;
    loadedRevision = revision;
    providers.value = availableAuthProviders(parseAuthIdpList(apiResData<any>(response)).items,
      ['CAS', 'OAUTH2'], NATIVE_AUTH_PROVIDER_IDS, '');
  } catch (_error) { /* 普通登录仍可使用，不显示后端异常原文。 */ }
}

onMounted(() => { loadProviders().catch((_error: any | null): void => {}); });

onUnmounted(() => {
  scope.invalidate();
  uni.$off(NATIVE_AUTH_STATUS_EVENT, statusChanged);
  emit('busy', false);
});
</script>

<style scoped>
.native-idp-login { width: 100%; margin-top: 24px; }
.native-idp-title { color: #777777; font-size: 13px; text-align: center; margin-bottom: 12px; }
.native-idp-error { color: #b42318; font-size: 13px; margin-bottom: 12px; }
.native-idp-option { width: 100%; margin-bottom: 10px; }
.native-idp-button { display: flex; flex-direction: row; align-items: center; justify-content: center; width: 100%; min-height: 42px; background-color: #ffffff; color: #111111; border: 1px solid #dddddd; border-radius: 7px; }
.native-idp-button::after { border-width: 0; }
.native-idp-icon { width: 20px; height: 20px; margin-right: 8px; }
.native-idp-name { font-size: 14px; line-height: 22px; }
.native-idp-cancel { width: 100%; color: #777777; font-size: 14px; background-color: transparent; }
.native-idp-cancel::after { border-width: 0; }
</style>
