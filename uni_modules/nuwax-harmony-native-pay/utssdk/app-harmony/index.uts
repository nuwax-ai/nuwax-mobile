/**
 * Nuwax Harmony Native Pay（App-Harmony）
 *
 * 与 app-android 端 nuwax-android-native-pay 同名同签名：
 *  - launchAnxinfuMiniProgramNative：微信 OpenSDK 拉起安心付小程序
 *  - openPayUrlNative：打开支付宝收银台 URL（http(s) → openLink；自定义 scheme → startAbility）
 *
 * 混编约定（同 esp-provisioning）：uts 依赖同目录 HarmonyPayBridge.ets，ets 不引用 uts。
 * 支付结果始终以服务端 settlement-status 轮询为准（对齐 Android/iOS），无需实现 onResp 回调。
 */
import { HarmonyPayBridge } from './HarmonyPayBridge.ets'

let bridge: HarmonyPayBridge | null = null

function getBridge(): HarmonyPayBridge {
  if (bridge == null) {
    bridge = new HarmonyPayBridge()
  }
  return bridge!
}

/** 使用微信 OpenSDK 拉起安心付小程序。 */
export async function launchAnxinfuMiniProgramNative(
  userName: string,
  path: string,
): Promise<any> {
  await getBridge().launchAnxinfuMiniProgram(
    UTSHarmony.getUIAbilityContext(),
    userName,
    path,
  )
  return { errMsg: 'launchMiniProgram:ok' } as UTSJSONObject
}

/** 打开支付宝收银台 URL。 */
export async function openPayUrlNative(url: string): Promise<any> {
  await getBridge().openPayUrl(UTSHarmony.getUIAbilityContext(), url)
  return { errMsg: 'openUrl:ok' } as UTSJSONObject
}
