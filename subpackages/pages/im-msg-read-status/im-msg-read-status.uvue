<template>
  <view class="rs-page">
    <safety-zone />

    <!-- 顶部：返回 + 标题（群成员页同款骨架） -->
    <view class="rs-header">
      <view class="rs-header__btn" hover-class="rs-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="rs-header__title-wrap">
        <text class="rs-header__title">{{ t("Mobile.Message.readStatusTitle") }}</text>
      </view>
      <view class="rs-header__btn rs-header__btn--ghost" />
    </view>

    <!-- 双 tab（已读/未读，带人数），选中态仅高亮变色 -->
    <view class="rs-tabs">
      <view class="rs-tab" @click="switchTab('read')">
        <text class="rs-tab__text" :class="activeTab == 'read' ? 'rs-tab__text--on' : ''">{{ readTabText }}</text>
      </view>
      <view class="rs-tab" @click="switchTab('unread')">
        <text class="rs-tab__text" :class="activeTab == 'unread' ? 'rs-tab__text--on' : ''">{{ unreadTabText }}</text>
      </view>
    </view>

    <!-- 横滑切页（directional-pager 同 conversation-search：禁 swiper 原生手势靠 tracker
         判向，避免与列表纵向滚动抢手势；两 tab 名单进页各自并行拉好，切页纯本地切换不请求） -->
    <directional-pager
      class="rs-body"
      :current="activePagerIndex"
      :count="2"
      @change="handlePagerChange"
    >
      <swiper-item>
        <scroll-view
          class="rs-list"
          direction="vertical"
          :show-scrollbar="false"
          @scrolltolower="handleReachBottom('read')"
        >
          <view v-if="readState == 'loading'" class="rs-state">
            <text class="rs-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
          </view>
          <!-- >500 人群：服务端 IM_30201 拒绝名单查询（计数仍可信，只退计数形态） -->
          <view v-else-if="readState == 'tooLarge'" class="rs-state">
            <text class="rs-state__text">{{ t("Mobile.Message.readListTooLarge") }}</text>
          </view>
          <!-- 降级：200 + listAvailable=false / degraded 原因码（readCount/eligibleCount 仍可信） -->
          <view v-else-if="readState == 'degraded'" class="rs-state">
            <text class="rs-state__text">{{ t("Mobile.Message.readListUnavailable") }}</text>
          </view>
          <view v-else-if="readState == 'failed'" class="rs-state" @click="reload('read')">
            <text class="rs-state__text">{{ t("Mobile.Message.loadFailed") }}</text>
          </view>
          <view v-else-if="readReaders.length == 0" class="rs-state">
            <text class="rs-state__text">{{ t("Mobile.Message.readEmpty") }}</text>
          </view>
          <view v-else>
            <view
              v-for="(r, i) in readReaders"
              :key="r.userId"
              class="rs-row"
              :class="i < readReaders.length - 1 ? 'rs-row--divider' : ''"
            >
              <view
                v-if="r.avatar.length > 0 && r.avatarFailed != true"
                class="rs-ava rs-ava--clip"
              >
                <image
                  class="rs-ava__img"
                  :src="r.avatar"
                  mode="aspectFill"
                  @error="handleAvatarError(r)"
                />
              </view>
              <view v-else class="rs-ava" :style="{ backgroundImage: avatarGradient(r.name) }">
                <text class="rs-ava-letter">{{ avatarLetter(r.name) }}</text>
              </view>
              <text class="rs-name text-ellipsis">{{ r.name }}</text>
            </view>
            <view v-if="readLoadingMore" class="rs-more">
              <text class="rs-more__text">{{ t("Mobile.Page.loadingMore") }}</text>
            </view>
            <view class="rs-tail" />
          </view>
        </scroll-view>
      </swiper-item>
      <swiper-item>
        <scroll-view
          class="rs-list"
          direction="vertical"
          :show-scrollbar="false"
          @scrolltolower="handleReachBottom('unread')"
        >
          <view v-if="unreadState == 'loading'" class="rs-state">
            <text class="rs-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
          </view>
          <view v-else-if="unreadState == 'tooLarge'" class="rs-state">
            <text class="rs-state__text">{{ t("Mobile.Message.readListTooLarge") }}</text>
          </view>
          <view v-else-if="unreadState == 'degraded'" class="rs-state">
            <text class="rs-state__text">{{ t("Mobile.Message.readListUnavailable") }}</text>
          </view>
          <view v-else-if="unreadState == 'failed'" class="rs-state" @click="reload('unread')">
            <text class="rs-state__text">{{ t("Mobile.Message.loadFailed") }}</text>
          </view>
          <view v-else-if="unreadReaders.length == 0" class="rs-state">
            <text class="rs-state__text">{{ t("Mobile.Message.readEmpty") }}</text>
          </view>
          <view v-else>
            <view
              v-for="(r, i) in unreadReaders"
              :key="r.userId"
              class="rs-row"
              :class="i < unreadReaders.length - 1 ? 'rs-row--divider' : ''"
            >
              <view
                v-if="r.avatar.length > 0 && r.avatarFailed != true"
                class="rs-ava rs-ava--clip"
              >
                <image
                  class="rs-ava__img"
                  :src="r.avatar"
                  mode="aspectFill"
                  @error="handleAvatarError(r)"
                />
              </view>
              <view v-else class="rs-ava" :style="{ backgroundImage: avatarGradient(r.name) }">
                <text class="rs-ava-letter">{{ avatarLetter(r.name) }}</text>
              </view>
              <text class="rs-name text-ellipsis">{{ r.name }}</text>
            </view>
            <view v-if="unreadLoadingMore" class="rs-more">
              <text class="rs-more__text">{{ t("Mobile.Page.loadingMore") }}</text>
            </view>
            <view class="rs-tail" />
          </view>
        </scroll-view>
      </swiper-item>
    </directional-pager>
  </view>
</template>

<script setup lang="uts">
  import { switchMainTab } from "@/utils/mainTabNavigation";

  /*
    消息阅读状态页（群聊已读计数点击进入）：
    - 双 tab：已读（x人）/ 未读（x人），名单 = GET /messages/{msgId}/readers?type=read|unread
    - 进页并行拉 read/unread 两份名单，切 tab（点击/横滑）纯本地切换不再请求；
      失败态点击按 tab 重试、触底翻页按 tab 续拉（状态/游标双 tab 独立）
    - 展示名与群成员列表同口径：我设的备注 > 群卡片 nickName > 平台名（备注取
      contactRemarkCache 模块缓存；卡片进页并行拉成员首屏建映射，见 memberCards）
    - 计数以响应为准校正（入参带来的只是首屏近似值）；未读数 = eligibleCount - readCount
    - >500 人群服务端报 IM_30201：只显示计数（apiImReadStatus 在大群下仍可用）
    - 降级形态是 200 + degraded 字符串原因码 / listAvailable=false：★degraded 是字符串
      不是布尔，判空看长度勿 === true；此时名单为空但计数仍可信
  */
  import { computed, ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { imAvatarDisplayUrl, resolveImAvatarDisplay } from "@/utils/imAvatarDisplay";
  import { apiImConvMembers, apiImMsgReaders } from "@/servers/im";
  import { getCachedContactRemarks } from "@/utils/im/contactRemarkCache";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 头像字母底色渐变板（与群成员页同款）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  /** 名单行（ReaderDto 投影；userId int64 已按字符串存用）。name 为最终展示名
   *  （备注 > 群卡片优先口径，见 resolveDisplayName）；apiName 保留 readers 接口名，
   *  供卡片映射晚到时重算展示名（见 applyMemberCardsToList）。 */
  class RsReader {
    userId: string = "";
    name: string = "";
    apiName: string = "";
    avatarRaw: string = "";
    avatar: string = "";
    avatarFailed: boolean = false;
  }

  // ===== 展示名映射：与群成员列表口径保持一致（备注 > 群卡片 > 平台名） =====
  // readers 接口的 name 是平台账号名（后端 ReaderItem 既不带群卡片 nickName，也不含
  // 我设的联系人备注），群成员列表显示「备注 > 群卡片」、这里此前却只显示账号名/卡片
  // ——改完备注本页不同步的根因。① 备注取模块缓存 contactRemarkCache（消息页/资料页
  // 刷新联系人时会写，进页读到即最新，改完备注再进来立即生效）；② 群卡片进页并行拉
  // 一次成员首屏（apiImConvMembers，与群成员页同款单页 limit=100）建 userId → 卡片名
  // 映射；>100 人群超出部分查不到卡片，回落 readers 接口名。
  /** userId → 群成员卡片名（群卡片 nickName > 平台名 name > 用户+id，token 同款）。 */
  const memberCards = new Map<string, string>();
  let memberCardsLoaded = false;

  /** 行展示名解析：我设的备注 > 群卡片 > readers 接口名（群成员列表同口径，微信语义）。 */
  function resolveDisplayName(userId: string, apiName: string): string {
    const cachedRemarks = getCachedContactRemarks();
    if (cachedRemarks != null) {
      const remark = cachedRemarks.get(userId);
      if (remark != null && remark.length > 0) {
        return remark;
      }
    }
    const card = memberCards.get(userId);
    if (card != null && card.length > 0) {
      return card;
    }
    return apiName.length > 0 ? apiName : `用户${userId}`;
  }

  // ===== 页面入参 =====
  const convId = ref<string>("");
  const msgId = ref<string>("");
  let seq = 0;

  // ===== 计数（响应校正） =====
  const readCount = ref<number>(0);
  const eligibleCount = ref<number>(0);

  // ===== 列表状态（双 tab 各自独立：进页并行拉两页名单，切 tab 纯本地切换不请求） =====
  const activeTab = ref<string>("read");
  /** 已读 tab：名单 / 状态 / 翻页游标。 */
  const readReaders = ref<RsReader[]>([]);
  /** loading | tooLarge | degraded | failed | done */
  const readState = ref<string>("loading");
  const readLoadingMore = ref<boolean>(false);
  let readPage = 1;
  let readTotal = 0;
  /** 未读 tab：名单 / 状态 / 翻页游标。 */
  const unreadReaders = ref<RsReader[]>([]);
  const unreadState = ref<string>("loading");
  const unreadLoadingMore = ref<boolean>(false);
  let unreadPage = 1;
  let unreadTotal = 0;

  const readTabText = computed((): string => {
    const params = new Map<string, string | number>();
    params.set("count", readCount.value);
    return translateFn("Mobile.Message.readTabRead", toI18nParams(params), "");
  });

  const unreadTabText = computed((): string => {
    const params = new Map<string, string | number>();
    params.set("count", eligibleCount.value - readCount.value);
    return translateFn("Mobile.Message.readTabUnread", toI18nParams(params), "");
  });

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  /** App-Android 不追踪 ref 数组内实例属性的原地变更（ba6a72f18 消息列表同款平台
   * 缺陷）：异步回填 row.avatar / @error 置 avatarFailed 后 v-for 行不重渲，图标
   * 停在原始地址的空渲染上。写回后去抖合并一次整表重建赋值强制重渲（key 稳定
   * 元素复用，iOS/H5 无副作用）。 */
  let rowsRefreshTimer = 0;

  function copyRows(live: RsReader[]): RsReader[] {
    const copy: RsReader[] = [];
    for (let i = 0; i < live.length; i++) {
      copy.push(live[i]);
    }
    return copy;
  }

  function scheduleRowsRefresh(): void {
    if (rowsRefreshTimer != 0) return;
    rowsRefreshTimer = setTimeout((): void => {
      rowsRefreshTimer = 0;
      // 两个 tab 的名单都重建（任一 tab 的行被异步回填都会走这里）
      readReaders.value = copyRows(readReaders.value);
      unreadReaders.value = copyRows(unreadReaders.value);
    }, 50);
  }

  /** 图加载失败落字母兜底：avatarFailed 原地写同样不被 Android 追踪（见上），须
   *  整表重建，否则图标停在失败图的空渲染上（im-group-members 同款缺陷；此前
   *  只修了 SVG 解析回填路径，位图直连失败没走 schedule）。 */
  function handleAvatarError(r: RsReader): void {
    r.avatarFailed = true;
    scheduleRowsRefresh();
  }

  /** 批量解析头像展示地址（H5 /api/f/ 受保护被 ORB 拦；App 端远程 SVG 1:1 光栅化
   *  裁切/渲染失败——女娲助手等 SVG 头像 Android 空白、iOS 落字母底的根因）。
   * ★须在名单 ref 赋值后调、行取自 ref 数组（响应式代理实例），异步写回才会
   * 触发渲染刷新——建行期 new 出的裸实例上写回不刷新（message.uvue resolveConvRowsIcons 同款）。
   * ★跳过条件看「avatar 仍等于原始地址」：App 端未解析时 avatar=raw 透传非空，
   *   旧 length>0 判断会把 App 端解析整个跳过。 */
  function resolveRowAvatars(live: RsReader[]): void {
    for (let i = 0; i < live.length; i++) {
      const row = live[i];
      const raw = row.avatarRaw;
      if (raw.length == 0 || row.avatar != raw) {
        continue;
      }
      resolveImAvatarDisplay(raw, 72).then((resolved: string) => {
        if (resolved != raw && resolved != row.avatar) {
          row.avatar = resolved;
          row.avatarFailed = false; // 首帧失败可能已标死字母兜底，解析成功救回
          scheduleRowsRefresh();
        }
      });
    }
  }

  /** 单个 tab 名单重套展示名（卡片映射晚到按「备注 > 群卡片」重算；行取自 ref 数组
   *  =响应式代理实例，写回可触发刷新）。 */
  function applyMemberCardsToList(live: RsReader[]): boolean {
    let changed = false;
    for (let i = 0; i < live.length; i++) {
      const row = live[i];
      const resolved = resolveDisplayName(row.userId, row.apiName);
      if (resolved.length > 0 && resolved != row.name) {
        row.name = resolved;
        changed = true;
      }
    }
    return changed;
  }

  /** 映射晚到（与 fetchPage 并行竞速）：两个 tab 名单都重套展示名并整表重建刷新
   *  （scheduleRowsRefresh，头像回填同款；字母底色取自展示名会一并更新）。
   *  ★两个列表都要执行后取或——`||` 短路会跳过第二个 tab 的回填。 */
  function applyMemberCardsToRows(): void {
    const changedRead = applyMemberCardsToList(readReaders.value);
    const changedUnread = applyMemberCardsToList(unreadReaders.value);
    if (changedRead || changedUnread) {
      scheduleRowsRefresh();
    }
  }

  /** 拉群成员首屏建卡片名映射：失败静默=名单回落 readers 接口名（原行为）。 */
  async function loadMemberCards(): Promise<void> {
    if (convId.value.length == 0 || memberCardsLoaded) {
      return;
    }
    try {
      const res = await apiImConvMembers(convId.value);
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj == null) {
        return;
      }
      const recordsRaw = dataObj["records"];
      if (recordsRaw == null) {
        return;
      }
      const records = recordsRaw as UTSJSONObject[];
      for (let i = 0; i < records.length; i++) {
        const id = readString(records[i], "userId");
        if (id.length == 0) {
          continue;
        }
        const nickName = readString(records[i], "nickName");
        const name = readString(records[i], "name");
        // token 口径与群成员页一致：群卡片 nickName > 平台名 name > 用户+id
        memberCards.set(id, nickName.length > 0 ? nickName : name.length > 0 ? name : `用户${id}`);
      }
      memberCardsLoaded = true;
      applyMemberCardsToRows();
    } catch (_error) {
      // 静默
    }
  }

  /** 拉名单（首页/翻页共用；tab 状态独立）：响应同时校正计数（权威，两 tab 同源幂等）。 */
  async function fetchPage(tab: string, nextPage: number): Promise<void> {
    if (convId.value.length == 0 || msgId.value.length == 0) {
      return;
    }
    const isUnread = tab == "unread";
    const readersRef = isUnread ? unreadReaders : readReaders;
    const stateRef = isUnread ? unreadState : readState;
    const loadingMoreRef = isUnread ? unreadLoadingMore : readLoadingMore;
    if (loadingMoreRef.value) {
      return;
    }
    if (nextPage > 1) {
      loadingMoreRef.value = true;
    } else {
      stateRef.value = "loading";
    }
    try {
      const res = await apiImMsgReaders(msgId.value, convId.value, seq, tab, nextPage);
      if (apiResCode(res) != SUCCESS_CODE) {
        // >500 人群：HTTP 层错误码 IM_30201（不降级查库），退回只显示计数形态
        if (apiResCode(res) == "IM_30201") {
          stateRef.value = "tooLarge";
        } else if (nextPage <= 1) {
          stateRef.value = "failed";
        }
        loadingMoreRef.value = false;
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj == null) {
        stateRef.value = nextPage <= 1 ? "done" : stateRef.value;
        loadingMoreRef.value = false;
        return;
      }
      // 计数校正（readCount/eligibleCount 与查询侧 read-status 同源可信；两 tab 响应同源幂等）
      const rc = readNumber(dataObj, "readCount", -1);
      const ec = readNumber(dataObj, "eligibleCount", -1);
      if (rc >= 0) {
        readCount.value = rc;
      }
      if (ec >= 0) {
        eligibleCount.value = ec;
      }
      // 降级判定：degraded 是字符串原因码（"L3_COLD" 等），判空看长度勿 === true
      const degraded = readString(dataObj, "degraded").length > 0 || readBool(dataObj, "listAvailable") != true;
      if (degraded) {
        stateRef.value = "degraded";
        loadingMoreRef.value = false;
        return;
      }
      const totalVal = readNumber(dataObj, "total", 0);
      if (isUnread) {
        unreadTotal = totalVal;
      } else {
        readTotal = totalVal;
      }
      const out: RsReader[] = nextPage <= 1 ? [] : readersRef.value;
      const readersRaw = dataObj["readers"];
      if (readersRaw != null) {
        const arr = readersRaw as UTSJSONObject[];
        for (let i = 0; i < arr.length; i++) {
          const r = new RsReader();
          r.userId = readString(arr[i], "userId");
          r.apiName = readString(arr[i], "name");
          r.avatarRaw = readString(arr[i], "avatar");
          r.avatar = imAvatarDisplayUrl(r.avatarRaw, 72);
          if (r.userId.length > 0) {
            r.name = resolveDisplayName(r.userId, r.apiName);
            out.push(r);
          }
        }
      }
      readersRef.value = out;
      resolveRowAvatars(readersRef.value);
      if (isUnread) {
        unreadPage = nextPage;
      } else {
        readPage = nextPage;
      }
      stateRef.value = "done";
    } catch (_error) {
      if (nextPage <= 1) {
        stateRef.value = "failed";
      }
    }
    loadingMoreRef.value = false;
  }

  /** 失败态点击重试（按 tab）。 */
  function reload(tab: string): void {
    fetchPage(tab, 1);
  }

  /** 切 tab：两页名单进页已各自并行拉好，纯本地切换（不请求）；数据态随各自 state 呈现。 */
  function switchTab(tab: string): void {
    if (activeTab.value == tab) {
      return;
    }
    activeTab.value = tab;
  }

  /** swiper 页索引：read=0 / unread=1（点击 tab 与横滑共用）。 */
  const activePagerIndex = computed((): number => (activeTab.value == "read" ? 0 : 1));

  /** 横滑切页回调（directional-pager @change）：索引映射回 tab，走统一 switchTab。 */
  function handlePagerChange(index: number): void {
    switchTab(index == 0 ? "read" : "unread");
  }

  /** 触底翻页（按 tab）：已拉条数 < 名单总人数才继续。 */
  function handleReachBottom(tab: string): void {
    const isUnread = tab == "unread";
    if (isUnread) {
      if (unreadState.value != "done" || unreadLoadingMore.value) {
        return;
      }
      if (unreadReaders.value.length < unreadTotal) {
        fetchPage("unread", unreadPage + 1);
      }
    } else {
      if (readState.value != "done" || readLoadingMore.value) {
        return;
      }
      if (readReaders.value.length < readTotal) {
        fetchPage("read", readPage + 1);
      }
    }
  }

  function handleBack(): void {
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      switchMainTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    msgId.value = readOption(options, "msgId");
    const seqParsed = parseFloat(readOption(options, "seq"));
    seq = isNaN(seqParsed) ? 0 : seqParsed;
    const rcParsed = parseFloat(readOption(options, "readCount"));
    readCount.value = isNaN(rcParsed) ? 0 : rcParsed;
    const ecParsed = parseFloat(readOption(options, "eligibleCount"));
    eligibleCount.value = isNaN(ecParsed) ? 0 : ecParsed;
    // 并行：成员卡片映射（慢到由 applyMemberCardsToRows 异步重套）+ 两 tab 名单首页
    // （切 tab 纯本地切换，不再请求；失败态点击按 tab 重试、触底按 tab 续拉）
    loadMemberCards();
    fetchPage("read", 1);
    fetchPage("unread", 1);
  });
</script>

