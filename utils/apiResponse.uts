import type { RequestResponse } from "@/types/interfaces/request";
import { SUCCESS_CODE } from "@/constants/codes.constants";

/** API 响应：读取 code（Android 运行时 res 为 UTSJSONObject） */
export function apiResCode(res: RequestResponse<any> | null): string | null {
  if (res == null) {
    return null;
  }
  const code = res["code"];
  return code != null ? `${code}` : null;
}

/** API 响应：读取 data，泛型 T 对应 RequestResponse<T> 的业务 data 类型 */
export function apiResData<T = any>(res: RequestResponse<T> | null): T | null {
  if (res == null) {
    return null;
  }
  const data = res["data"];
  return data != null ? (data as T) : null;
}

/** API 响应：读取 message */
export function apiResMessage(res: RequestResponse<any> | null): string {
  if (res == null) {
    return "";
  }
  const msg = res["message"];
  return msg != null ? `${msg}` : "";
}

/** API 响应：是否成功（默认 SUCCESS_CODE） */
export function isApiSuccess(res: RequestResponse<any> | null, successCode: string = SUCCESS_CODE): boolean {
  return apiResCode(res) == successCode;
}
