import Intent from 'android.content.Intent';
import Uri from 'android.net.Uri';
import WXLaunchMiniProgram from 'com.tencent.mm.opensdk.modelbiz.WXLaunchMiniProgram';
import IWXAPI from 'com.tencent.mm.opensdk.openapi.IWXAPI';
import WXAPIFactory from 'com.tencent.mm.opensdk.openapi.WXAPIFactory';

/** 微信开放平台“移动应用” AppID。 */
const WECHAT_OPEN_APP_ID = 'wxe2a12018505241ba';

let wxApi: IWXAPI | null = null;

function getWxApi(): IWXAPI | null {
  const context = UTSAndroid.getAppContext();
  if (context == null) return null;
  if (wxApi == null) {
    wxApi = WXAPIFactory.createWXAPI(context, WECHAT_OPEN_APP_ID, true);
    wxApi!.registerApp(WECHAT_OPEN_APP_ID);
  }
  return wxApi;
}

/** 使用微信 OpenSDK 拉起安心付小程序。 */
export function launchAnxinfuMiniProgramNative(
  userName: string,
  path: string,
): Promise<any> {
  return new Promise((resolve, reject) => {
    try {
      const api = getWxApi();
      if (api == null) {
        reject(new Error('Android application context is unavailable'));
        return;
      }
      if (!api!.isWXAppInstalled()) {
        reject(new Error('WeChat is not installed'));
        return;
      }

      const request = new WXLaunchMiniProgram.Req();
      request.userName = userName;
      request.path = path;
      request.miniprogramType = 0;
      console.log('userName',userName)
      console.log('path',path)
      if (!api!.sendReq(request)) {
        reject(new Error('WeChat rejected the mini-program launch request'));
        return;
      }
      resolve({ errMsg: 'launchMiniProgram:ok' });
    } catch (error) {
      reject(error);
    }
  });
}

/** 使用 Android 系统 Intent 打开后端提供的支付宝收银台 URL。 */
export function openPayUrlNative(url: string): Promise<any> {
  return new Promise((resolve, reject) => {
    try {
      const activity = UTSAndroid.getUniActivity();
      if (activity == null) {
        reject(new Error('Android Activity is unavailable'));
        return;
      }
      activity.startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(url)));
      resolve({ errMsg: 'openUrl:ok' });
    } catch (error) {
      reject(error);
    }
  });
}
