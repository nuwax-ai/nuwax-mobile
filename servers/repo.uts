import request from "@/servers/useRequest";
import { RequestResponse } from "@/types/interfaces/request";

/** 指定空间的完整资料树。 */
export async function apiRepoSpaceTree(spaceId: number): Promise<RequestResponse<any>> {
  return await request({
    url: `/api/repo/spaces/${spaceId}/tree`,
    method: "GET",
  });
}

/** 门户最近访问资料。 */
export async function apiRepoRecentlyAccessedPages(from: number = 0, size: number = 20): Promise<RequestResponse<any>> {
  return await request({
    url: `/api/repo/pages/recently-accessed?from=${from}&size=${size}`,
    method: "GET",
  });
}
