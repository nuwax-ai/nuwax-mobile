  .mr-btn {
    padding: 6px 14px;
    border-radius: 16px;
    background-color: #f2f1f7;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mr-btn--active {
    opacity: 0.7;
  }

  .mr-btn__text {
    font-size: 13px;
    line-height: 18px;
    font-weight: 600;
