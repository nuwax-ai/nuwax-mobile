<template>
  <view class="image-captcha">
    <view class="image-captcha-row">
      <input
        :key="'image-captcha-' + inputResizeKey"
        class="image-captcha-input"
        type="text"
        maxlength="8"
        :value="captchaCode"
        :disabled="
          disabled == true ||
          loading ||
          captchaId.length == 0
        "
        :placeholder="t('Mobile.Auth.imageCaptchaPlaceholder')"
        placeholder-style="color: #999999; font-size: 30rpx;"
        cursor-color="#111111"
        @input="handleInput"
      />
      <view class="image-captcha-picture" @tap="handleRefresh">
        <image
          v-if="imageSrc.length > 0"
          class="image-captcha-image"
          :src="imageSrc"
          mode="aspectFit"
        />
        <text v-else class="image-captcha-status">{{
          loading
            ? t("Mobile.Common.loading")
            : t("Mobile.Auth.imageCaptchaRefresh")
        }}</text>
      </view>
    </view>
    <view class="image-captcha-hint" @tap="handleRefresh">
      <text class="image-captcha-hint-text">{{
        captchaId.length == 0 && !loading
          ? t("Mobile.Auth.imageCaptchaLoadFailed")
          : t("Mobile.Auth.imageCaptchaUnclear")
      }}</text>
      <text class="image-captcha-refresh">{{
        t("Mobile.Auth.imageCaptchaRefresh")
      }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, watch, onMounted, onUnmounted } from "vue";
import { apiImageCaptcha } from "@/servers/account";
import { apiResCode, apiResData } from "@/utils/apiResponse";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { ImageCaptchaChallenge } from "@/utils/imageCaptcha";
import { useI18n, emptyI18nParams } from "@/utils/i18n";

const props = defineProps<{
  refreshToken?: number;
  disabled?: boolean;
  inputResizeKey?: number;
}>();
const emit = defineEmits(["change"]);
const { t: tFn } = useI18n();
const t = (key: string): string => tFn(key, emptyI18nParams(), "");
// Android 的 class 内部字段修改不会触发 ref 更新，视图使用独立的基础类型 ref。
const challenge = new ImageCaptchaChallenge();
const captchaId = ref("");
const captchaCode = ref("");
const imageSrc = ref("");
const loading = ref(false);

function publish(): void {
  captchaId.value = challenge.captchaId;
  captchaCode.value = challenge.captchaCode;
  imageSrc.value = challenge.image;
  loading.value = challenge.loading;
  emit("change", challenge.captchaId, challenge.captchaCode);
}

async function refresh(): Promise<void> {
  const seq = challenge.begin();
  publish();
  let captchaId = "";
  let image = "";
  try {
    const res = await apiImageCaptcha();
    if (apiResCode(res) == SUCCESS_CODE) {
      const dataRaw = apiResData<UTSJSONObject>(res);
      const data = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (data != null) {
        const idRaw = data["captchaId"];
        const imageRaw = data["image"];
        captchaId = idRaw != null ? `${idRaw}` : "";
        image = imageRaw != null ? `${imageRaw}` : "";
      }
    }
  } catch (_error) {
    // 状态内展示重试入口；消费请求拒绝，避免全局未处理异常。
  }
  if (challenge.complete(seq, captchaId, image)) publish();
}

function handleRefresh(): void {
  if (props.disabled == true) return;
  refresh();
}

function handleInput(event: UniInputEvent): void {
  challenge.captchaCode = event.detail.value.trim();
  publish();
}

watch(
  (): number => props.refreshToken != null ? props.refreshToken : 0,
  () => { refresh(); },
);
onMounted(() => { refresh(); });
onUnmounted(() => {
  challenge.invalidate();
  publish();
});
</script>

<style lang="scss" scoped>
.image-captcha {
  width: 100%;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.image-captcha-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 84rpx;
}
.image-captcha-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding-left: 24rpx;
  padding-right: 16rpx;
  border: 2rpx solid #dedede;
  border-radius: 16rpx;
  background-color: #ffffff;
  font-size: 30rpx;
  color: #111111;
}
.image-captcha-picture {
  width: 200rpx;
  height: 80rpx;
  margin-left: 16rpx;
  border: 2rpx solid #dedede;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.image-captcha-image {
  width: 196rpx;
  height: 76rpx;
}
.image-captcha-status {
  color: #666666;
  font-size: 24rpx;
}
.image-captcha-hint {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 12rpx;
}
.image-captcha-hint-text {
  flex-shrink: 1;
  color: #999999;
  font-size: 24rpx;
}
.image-captcha-refresh {
  margin-left: 12rpx;
  color: #111111;
  font-size: 24rpx;
}
</style>
