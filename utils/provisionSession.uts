/**
 * 配网会话存储（页间共享，纯内存，不落盘）
 *
 * 用途：配网流程跨多个页面（entry → connect/scan → wifi → progress），
 *  - WiFi 页输入的凭据经此传递给进度页（敏感信息不走 URL query/页面栈/日志）
 *  - 扫描页选中的设备信息经此传递
 *  - 重配场景的目标设备标记（区分新绑定 vs 换 WiFi）
 *  - 扫码解析出的 QR 凭据（蓝牙连接/配对用）
 * 进度页 onUnload 调 clear() 清空。
 */
import type { WifiCredentials } from '@/types/interfaces/provision';
import type { EspProvisioningDevice, EspProvisioningQrPayload } from '@/types/interfaces/espProvisioning';

/** 当前选中的目标设备 */
let currentDevice: EspProvisioningDevice | null = null;
/** 当前输入的 WiFi 凭据（仅内存） */
let currentCredentials: WifiCredentials | null = null;
/** 重配目标（已在线设备换 WiFi 场景；null 表示新设备首次配网） */
let reprovisionTarget: ReprovisionTarget | null = null;
/** 扫码解析出的 QR 凭据（蓝牙直连用；手动扫描场景为 null） */
let qrPayload: EspProvisioningQrPayload | null = null;
/** 流程完成/取消后的明确返回页，避免依赖易变的页面栈层级。 */
let provisionReturnUrl = '';

/** 重配目标设备标记 */
export class ReprovisionTarget {
  deviceId: string;
  name: string;
  constructor(deviceId: string, name: string) {
    this.deviceId = deviceId;
    this.name = name;
  }
}

export function setProvisionDevice(device: EspProvisioningDevice): void {
  currentDevice = device;
}

export function getProvisionDevice(): EspProvisioningDevice | null {
  return currentDevice;
}

export function setProvisionCredentials(credentials: WifiCredentials): void {
  currentCredentials = credentials;
}

export function getProvisionCredentials(): WifiCredentials | null {
  return currentCredentials;
}

export function setReprovisionTarget(target: ReprovisionTarget | null): void {
  reprovisionTarget = target;
}

export function getReprovisionTarget(): ReprovisionTarget | null {
  return reprovisionTarget;
}

export function setQrPayload(payload: EspProvisioningQrPayload | null): void {
  qrPayload = payload;
}

export function getQrPayload(): EspProvisioningQrPayload | null {
  return qrPayload;
}

export function setProvisionReturnUrl(url: string): void {
  provisionReturnUrl = url;
}

export function getProvisionReturnUrl(): string {
  return provisionReturnUrl;
}

/** 清空会话（进度页离开/完成/失败重开时调用） */
export function clearProvisionSession(): void {
  currentDevice = null;
  currentCredentials = null;
  reprovisionTarget = null;
  qrPayload = null;
  provisionReturnUrl = '';
}
