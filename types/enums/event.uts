/**
 * 事件类型枚举
 * 用于 batch 轮询事件分发 + IM WS 帧事件分发。
 *
 * 字符串值保持 snake_case。运行时常量名用 camelCase（与 PC 端 @/types/enums/event.ts 对齐）。
 */
export enum EventTypeEnum {
  // ---- 现有：5s 事件总线 + 通知 ----
  NewNotifyMessage = 'new_notify_message',
  RefreshChatMessage = 'refresh_chat_message',
  RefreshFileList = 'refresh_file_list',
  ChatFinished = 'chat_finished',

  // ---- 新增：IM WebSocket 帧事件（im_*） ----
  // IM 长连接接收一条新消息（MSG_RECV），按 msgId 去重
  ImMessageReceived = 'im_message_received',
  // 消息被撤回（MSG_REVOKE）
  ImMessageRevoked = 'im_message_revoked',
  // 消息被编辑（MSG_EDIT）
  ImMessageEdited = 'im_message_edited',
  // 会话元数据变化（CONV_UPDATE，含 reason=PROFILE/DISBANDED/LAST_MSG_REVOKED/...）
  ImConversationUpdated = 'im_conversation_updated',
  // 会话未读数变化（CONV_UNREAD，驱动 TabBar 角标与单条 row 更新）
  ImConversationUnread = 'im_conversation_unread',
  // 已读回执（READ_NOTIFY / READ_NOTIFY_AGG）
  ImReadNotified = 'im_read_notified',
  // 智能体消息状态（MSG_AGENT_STATUS）
  ImAgentStatus = 'im_agent_status',
  // 自定义事件（MSG_CUSTOM_EVENT，不进消息列表）
  ImCustomEvent = 'im_custom_event',
  // 联系人变更（CONTACT_UPDATE，触发 GET /contacts 重拉）
  ImContactUpdated = 'im_contact_updated',
  // 服务端踢下线（KICK，payload.stopReconnect=true 时跳登录）
  ImKicked = 'im_kicked',
  // WS 错误帧（ERROR，连接通常仍活着）
  ImError = 'im_error',
  // WS 连接状态变化（connecting/open/reconnecting/failed/closed）
  ImConnectionState = 'im_connection_state',
  // WS 鉴权失效（CONNECT_REJECT 非重试 code 或 KICK.stopReconnect=true），App.uvue 监听后 stop + 跳登录
  ImAuthInvalid = 'im_auth_invalid',
}
