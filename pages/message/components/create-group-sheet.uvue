<template>
  <!--
    创建群组底部弹窗：
    - 群名称（必填）+ 初始成员（服务端搜索、多选，可空；输入防抖后才搜）
    - 确定后调创建群组接口，成功关弹窗并跳转新群消息详情页
  -->
  <uni-modal-popup
    ref="popupRef"
    position="bottom"
    height="75%"
    :show-header="false"
    :body-scroll="false"
    :enable-swipe-close="true"
    @afterleave="handleAfterLeave"
  >
    <view class="group-sheet">
      <view class="group-sheet__header">
        <text class="group-sheet__title">{{ t("Mobile.Message.createGroup") }}</text>
        <view class="group-sheet__close" @click="close">
          <svg-icon name="icon-X" size="36" color="#8a8a8a" />
        </view>
      </view>

      <view class="group-sheet__form">
        <view class="group-sheet__label-row">
          <text class="group-sheet__req">*</text>
          <text class="group-sheet__label">{{ t("Mobile.Message.groupName") }}</text>
        </view>
        <input
          class="group-sheet__input"
          v-model="groupName"
          :placeholder="t('Mobile.Message.groupNamePlaceholder')"
          placeholder-class="group-sheet__ph"
          :maxlength="32"
        />

        <view class="group-sheet__label-row">
          <text class="group-sheet__req">*</text>
          <text class="group-sheet__label">{{ t("Mobile.Message.initialMembers") }}</text>
        </view>
        <view class="group-sheet__search">
          <input
            class="group-sheet__search-input"
            v-model="memberKeyword"
            :placeholder="t('Mobile.Message.searchMemberPlaceholder')"
            placeholder-class="group-sheet__ph"
          />
          <view class="group-sheet__search-icon">
            <svg-icon name="icon-Search" size="28" color="#9a9aa2" />
          </view>
        </view>

        <!-- 已选成员 chips：点 chip 移除 -->
        <view v-if="selectedMembers.length > 0" class="group-sheet__chips">
          <view
            v-for="m in selectedMembers"
            :key="m.userId"
            class="group-sheet__chip"
            hover-class="group-sheet__chip--active"
            @click="toggleMember(m)"
          >
            <text class="group-sheet__chip-text">{{ m.displayName }}</text>
            <text class="group-sheet__chip-x">×</text>
          </view>
        </view>
      </view>

      <scroll-view
        class="group-sheet__list"
        direction="vertical"
        :show-scrollbar="false"
      >
        <!-- 初始态：未输入不搜也不展示（等用户输入） -->
        <view v-if="searchState == 'idle'" class="group-sheet__state">
          <text class="group-sheet__state-text">{{ t("Mobile.Message.searchMemberTip") }}</text>
        </view>
        <view v-else-if="searchState == 'loading'" class="group-sheet__state">
          <text class="group-sheet__state-text">{{ t("Mobile.Common.loading") }}</text>
        </view>
        <view v-else-if="searchState == 'failed'" class="group-sheet__state" @click="doSearchNow">
          <text class="group-sheet__state-text">{{ t("Mobile.Message.loadFailed") }}</text>
        </view>
        <view v-else-if="searchMembers.length == 0" class="group-sheet__state">
          <text class="group-sheet__state-text">{{ t("Mobile.AgentSearch.emptyResult") }}</text>
        </view>
        <view v-else class="group-sheet__list-body">
          <view
            v-for="m in searchMembers"
            :key="m.userId"
            class="group-sheet__member"
            hover-class="group-sheet__member--active"
            @click="toggleMember(m)"
          >
            <view class="group-sheet__avatar">
              <image
                v-if="m.avatarUrl.length > 0 && m.avatarFailed != true"
                class="group-sheet__avatar-img"
                :src="m.avatarUrl"
                mode="aspectFill"
                @error="handleAvatarError(m)"
              />
              <view
                v-else
                class="group-sheet__avatar-fallback"
                :style="{ backgroundImage: avatarGradient(m.displayName) }"
              >
                <text class="group-sheet__avatar-letter">{{ avatarLetter(m.displayName) }}</text>
              </view>
            </view>
            <text class="group-sheet__member-name text-ellipsis">{{ m.displayName }}</text>
            <view
              class="group-sheet__check"
              :class="{ 'group-sheet__check--on': isSelected(m.userId) }"
            >
              <svg-icon
                v-if="isSelected(m.userId)"
                name="icon-Check"
                size="24"
                color="#ffffff"
              />
            </view>
          </view>
          <!-- 平台侧查询失败：结果不完整提示（契约 degraded 标志） -->
          <view v-if="searchDegraded" class="group-sheet__degraded">
            <text class="group-sheet__degraded-text">{{ t("Mobile.Message.searchDegraded") }}</text>
          </view>
        </view>
      </scroll-view>

      <view class="group-sheet__footer">
        <view class="group-sheet__btn" hover-class="group-sheet__btn-cancel--active" @click="close">
          <text class="group-sheet__btn-text group-sheet__btn-text--cancel">
            {{ t("Mobile.Common.cancel") }}
          </text>
        </view>
        <view
          class="group-sheet__btn group-sheet__btn--ok"
          hover-class="group-sheet__btn-ok--active"
          @click="handleConfirm"
        >
          <text class="group-sheet__btn-text group-sheet__btn-text--ok">
            {{ submitting ? t("Mobile.Common.loading") : t("Mobile.Common.ok") }}
          </text>
        </view>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { onUnmounted, ref, watch, type ComponentPublicInstance } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { apiImCreateGroup, apiImSearchContacts } from "@/servers/im";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 成员行（搜索结果与已选共用）。 */
  class SheetMember {
    userId: string = "";
    displayName: string = "";
    avatarUrl: string = "";
    avatarFailed: boolean = false;
  }

  /** 头像字母底色渐变板（对齐消息页六色系）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #f59a9a, #e05f5f)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  const popupRef = ref<any | null>(null);
  const tabBarHiddenBySheet = ref<boolean>(false);

  const groupName = ref<string>("");
  const memberKeyword = ref<string>("");
  /** 搜索结果（仅当次关键字命中；初始不加载，输入才搜） */
  const searchMembers = ref<SheetMember[]>([]);
  /** idle=未输入 | loading | failed | done */
  const searchState = ref<string>("idle");
  const searchDegraded = ref<boolean>(false);
  /** 已选成员独立持有（跨关键字/多次搜索保持，chips 与提交都用它） */
  const selectedMembers = ref<SheetMember[]>([]);
  const submitting = ref<boolean>(false);
  /** 创建成功后待跳转的新群会话（等弹窗完全收起再跳，避免弹层压在推入页上） */
  let pendingOpenChatConvId = "";
  let pendingOpenChatName = "";
  /** 输入防抖定时器 + 搜索序号（旧请求晚归丢弃，防竞态串结果） */
  let searchDebounceTimer = -1;
  let searchSeq = 0;

  function callPopupMethod(methodName: string): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(methodName);
  }

  /** 打开创建群组弹窗：重置表单（成员初始不加载、不展示，输入才搜）。 */
  function open(): void {
    groupName.value = "";
    memberKeyword.value = "";
    searchMembers.value = [];
    selectedMembers.value = [];
    resetSearchIdle();
    // 系统 TabBar 是独立原生层，页面内弹窗无法用 z-index 覆盖，先隐藏、关闭时恢复
    tabBarHiddenBySheet.value = true;
    uni.hideTabBar({
      animation: false,
      complete: () => {
        callPopupMethod("open");
      },
    });
  }

  /** 关闭弹窗：作废未发出的防抖搜索与在途请求（列表保留到收起动画结束）。 */
  function close(): void {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
    searchSeq++;
    callPopupMethod("close");
  }

  function restoreTabBar(): void {
    if (tabBarHiddenBySheet.value != true) {
      return;
    }
    tabBarHiddenBySheet.value = false;
    uni.showTabBar({
      animation: false,
    });
  }

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  /** 搜索响应行：ContactSearchItem 无 displayName，展示名按 nickName > userName 回落。 */
  function readSearchMember(item: UTSJSONObject): SheetMember | null {
    const row = new SheetMember();
    row.userId = readString(item, "userId");
    if (row.userId.length == 0) {
      return null;
    }
    const nickName = readString(item, "nickName");
    row.displayName = nickName.length > 0 ? nickName : readString(item, "userName");
    row.avatarUrl = readString(item, "avatar");
    return row;
  }

  /** 回初始态：清结果/清防抖定时器/序号自增（作废在途请求）。 */
  function resetSearchIdle(): void {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
    searchSeq++;
    searchState.value = "idle";
    searchDegraded.value = false;
    searchMembers.value = [];
  }

  /** 用当前关键字立即搜索（防抖到期或失败重试触发）。 */
  async function doSearchNow(): Promise<void> {
    const kw = memberKeyword.value.trim();
    if (kw.length == 0) {
      resetSearchIdle();
      return;
    }
    const seq = ++searchSeq;
    searchState.value = "loading";
    searchDegraded.value = false;
    try {
      const res = await apiImSearchContacts(kw, 20);
      // 期间又有新输入/清空/关闭：本请求作废，不覆盖新状态
      if (seq != searchSeq) {
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        searchState.value = "failed";
        return;
      }
      const rows: SheetMember[] = [];
      let degraded = false;
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        degraded = readBool(dataObj, "degraded");
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const row = readSearchMember(items[i]);
            if (row != null) {
              rows.push(row);
            }
          }
        }
      }
      searchMembers.value = rows;
      searchDegraded.value = degraded;
      searchState.value = "done";
    } catch (e) {
      if (seq == searchSeq) {
        searchState.value = "failed";
      }
    }
  }

  /** 输入防抖 400ms：停顿后才发请求（连打只发最后一次）；清空立即回初始态。 */
  watch(memberKeyword, (val: string) => {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
    if (val.trim().length == 0) {
      resetSearchIdle();
      return;
    }
    searchDebounceTimer = setTimeout(() => {
      searchDebounceTimer = -1;
      doSearchNow();
    }, 400);
  });

  function isSelected(userId: string): boolean {
    const sel = selectedMembers.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].userId == userId) {
        return true;
      }
    }
    return false;
  }

  function toggleMember(m: SheetMember): void {
    const next: SheetMember[] = [];
    let removed = false;
    const sel = selectedMembers.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].userId == m.userId) {
        removed = true;
      } else {
        next.push(sel[i]);
      }
    }
    if (removed != true) {
      next.push(m);
    }
    selectedMembers.value = next;
  }

  function handleAvatarError(m: SheetMember): void {
    m.avatarFailed = true;
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  /** 确定：校验群名 → 建群 → 关弹窗（afterleave 后跳新群详情页）。 */
  async function handleConfirm(): Promise<void> {
    if (submitting.value) {
      return;
    }
    const name = groupName.value.trim();
    if (name.length == 0) {
      uni.showToast({ title: t("Mobile.Message.groupNameRequired"), icon: "none" });
      return;
    }
    submitting.value = true;
    try {
      const ids: string[] = [];
      const sel = selectedMembers.value;
      for (let i = 0; i < sel.length; i++) {
        ids.push(sel[i].userId);
      }
      const res = await apiImCreateGroup(name, ids);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.createGroupFailed"), icon: "none" });
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      const convId = dataObj != null ? readString(dataObj, "convId") : "";
      if (convId.length == 0) {
        uni.showToast({ title: t("Mobile.Message.createGroupFailed"), icon: "none" });
        return;
      }
      pendingOpenChatConvId = convId;
      pendingOpenChatName = name;
      close();
    } catch (e) {
      uni.showToast({ title: t("Mobile.Message.createGroupFailed"), icon: "none" });
    } finally {
      submitting.value = false;
    }
  }

  /** 弹窗完全收起：恢复 tabBar，再跳转新群消息详情页。 */
  function handleAfterLeave(): void {
    restoreTabBar();
    if (pendingOpenChatConvId.length == 0) {
      return;
    }
    const convId = pendingOpenChatConvId;
    const name = pendingOpenChatName;
    pendingOpenChatConvId = "";
    pendingOpenChatName = "";
    uni.navigateTo({
      url:
        `/pages/message/chat?convId=${convId}&convType=2` +
        `&name=${encodeURIComponent(name)}&avatar=`,
    });
  }

  defineExpose({
    open: open as any,
    close: close as any,
  });

  onUnmounted(() => {
    restoreTabBar();
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
  });
</script>

<style lang="scss" scoped>
