// nuwax-clipboard-image · app-android
//
import Context from "android.content.Context";
import ClipboardManager from "android.content.ClipboardManager";
import ClipData from "android.content.ClipData";
import ClipDescription from "android.content.ClipDescription";
import Uri from "android.net.Uri";
import Bitmap from "android.graphics.Bitmap";
import BitmapFactory from "android.graphics.BitmapFactory";
import File from "java.io.File";
import FileOutputStream from "java.io.FileOutputStream";
import InputStream from "java.io.InputStream";
import type {
  ClipboardImageFailureCallback,
  ClipboardImageSuccessCallback,
  ClipboardProbeCallback,
} from "../interface.uts";

// 聊天页「粘贴剪贴板图片」的 Android 实现：
// - 探测：ClipboardManager.getPrimaryClipDescription() 只查 mime 元数据（三星/小米/鸿蒙
//   截屏栏「复制」拷出的图 clip 即 image/*），不取数据体；Android 13+ 的「已读取剪贴板」
//   Toast 只在真正读数据（getPrimaryClip）时弹，探测阶段不打扰
// - 读取：clip URI（临时读权限随复制授予）→ decodeStream → 统一重压 JPEG 92 写
//   cacheDir/clipboard/，回传绝对路径；OEM 截屏拷出的 PNG 截图一并转 JPEG
// 注意：Android 10+ 仅前台焦点应用可访问剪贴板，本插件全部调用都发生在页面交互期。

/** 探测剪贴板是否含图片（元数据级）；fingerprint=clip 时间戳（API26+）供上层去重。 */
export function probeClipboardImage(onResult: ClipboardProbeCallback): void {
  const activity = UTSAndroid.getUniActivity();
  if (activity == null) {
    onResult(false, "");
    return;
  }
  const cm = activity.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager;
  if (cm == null) {
    onResult(false, "");
    return;
  }
  const desc = cm.getPrimaryClipDescription();
  if (desc == null || desc.hasMimeType("image/*") != true) {
    onResult(false, "");
    return;
  }
  onResult(true, `clip-${desc.getTimestamp()}`);
}

/**
 * 读取剪贴板图片重压 JPEG 写缓存目录，回传绝对路径。
 * 读取会触发 Android 13+ 系统读取 Toast（平台常态，微信同款）。
 * @UTSJS.keepAlive 回调被原生块持有到写文件完成，须防回收。
 */
@UTSJS.keepAlive
export function readClipboardImageFile(
  success: ClipboardImageSuccessCallback,
  fail: ClipboardImageFailureCallback,
): void {
  const activity = UTSAndroid.getUniActivity();
  if (activity == null) {
    fail("NO_ACTIVITY", "no uni activity");
    return;
  }
  const cm = activity.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager;
  if (cm == null) {
    fail("NO_SERVICE", "clipboard service unavailable");
    return;
  }
  const clip = cm.getPrimaryClip();
  if (clip == null || clip.getItemCount() <= 0) {
    fail("EMPTY", "clipboard empty");
    return;
  }
  let target: Uri | null = null;
  for (let i = 0; i < clip.getItemCount(); i++) {
    const item = clip.getItemAt(i.toInt());
    if (item == null) {
      continue;
    }
    const uri = item.getUri();
    if (uri != null) {
      target = uri;
      break;
    }
  }
  if (target == null) {
    fail("EMPTY", "clipboard has no image uri");
    return;
  }
  let ins: InputStream | null = null;
  let fos: FileOutputStream | null = null;
  try {
    ins = activity.getContentResolver().openInputStream(target);
    if (ins == null) {
      fail("READ", "openInputStream returned null");
      return;
    }
    const bmp = BitmapFactory.decodeStream(ins);
    if (bmp == null) {
      fail("DECODE", "clipboard content is not a decodable image");
      return;
    }
    const dir = File(activity.getCacheDir(), "clipboard");
    if (dir.exists() != true) {
      dir.mkdirs();
    }
    const file = File(dir, `clipboard_${Date.now()}.jpg`);
    fos = FileOutputStream(file);
    bmp.compress(Bitmap.CompressFormat.JPEG, 92, fos);
    fos.flush();
    bmp.recycle();
    success(file.getAbsolutePath());
  } catch (e) {
    fail("READ", `${e}`);
  } finally {
    try {
      if (ins != null) {
        ins.close();
      }
    } catch (e1) {
      console.error("clipboard close input failed", `${e1}`);
    }
    try {
      if (fos != null) {
        fos.close();
      }
    } catch (e2) {
      console.error("clipboard close output failed", `${e2}`);
    }
  }
}
