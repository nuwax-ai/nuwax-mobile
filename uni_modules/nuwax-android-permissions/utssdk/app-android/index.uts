// Android 运行时权限桥接：把 UTSAndroid 调用收拢到 uts 插件内，
// 让 uvue 页面在蒸汽模式（vapor）下不再直接引用 UTSAndroid。

/** 检查录音权限是否已授予（同步，无弹窗）。*/
export function checkRecordPermission(): boolean {
  const activity = UTSAndroid.getUniActivity();
  if (activity == null) return false;
  const perms = ["android.permission.RECORD_AUDIO"] as string[];
  return UTSAndroid.checkSystemPermissionGranted(activity, perms);
}

/** 请求录音权限（弹系统对话框）。resolve(true) 全部授予，resolve(false) 拒绝。*/
export function requestRecordPermission(): Promise<boolean> {
  return new Promise((resolve) => {
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) {
      resolve(false);
      return;
    }
    const perms = ["android.permission.RECORD_AUDIO"] as string[];
    UTSAndroid.requestSystemPermission(
      activity,
      perms,
      (allGranted: boolean, _granted: string[]) => {
        resolve(allGranted);
      },
      (_doNotAskAgain: boolean, _denied: string[]) => {
        resolve(false);
      },
    );
  });
}

/** 跳转系统权限设置页（用户拒绝且勾选"不再询问"时引导）。*/
export function openRecordPermissionSettings(): void {
  const activity = UTSAndroid.getUniActivity();
  if (activity == null) return;
  const perms = ["android.permission.RECORD_AUDIO"] as string[];
  UTSAndroid.gotoSystemPermissionActivity(activity, perms);
}
