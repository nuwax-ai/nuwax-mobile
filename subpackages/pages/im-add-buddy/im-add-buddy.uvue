<template>
  <!--
    添加伙伴页（原底部弹窗改整页，搜索页同款交互；仅伙伴模式——群成员页的
    添加成员仍走 add-buddy-sheet 组件的群模式，与本页无关）：
    - 「用户」：searchContacts 搜平台用户，附言随「加为联系人」发送（对方需同意）
    - 「智能体」：contactSearchAgents 搜已发布智能体，「加为联系人」直接生效
    - 「发消息」：convCreateP2p 建会话后 redirectTo 消息详情页（替换本页，返回直达消息列表）
    - 打开不搜索，输入 400ms 防抖后才调接口；入参 ?keyword=&userId=：扫用户名片码
      拉起时预填关键字自动搜索，结果命中该 userId 即自动选中（仍可改选）
    - 非 tabBar 页：无需隐藏/恢复原生 tabBar，底部安全区由 footerStyle 内联兜底
  -->
  <view class="ab-page">
    <safety-zone />

    <!-- 顶部：返回 + 标题（群成员页同款页头） -->
    <view class="ab-header">
      <view class="ab-header__btn" hover-class="ab-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="ab-header__title-wrap">
        <text class="ab-header__title">{{ t("Mobile.Message.addBuddy") }}</text>
      </view>
      <view class="ab-header__btn ab-header__btn--ghost" />
    </view>

    <!-- tab：人 / 智能体（无下划线，选中仅文字变色——同消息页 tab） -->
    <view class="ab-tabs">
      <view class="ab-tab" @click="switchTab('user')">
        <text
          class="ab-tab-text"
          :class="{ 'ab-tab-text--on': activeTab == 'user' }"
        >{{ t("Mobile.Message.buddyTabUser") }}</text>
      </view>
      <view class="ab-tab" @click="switchTab('agent')">
        <text
          class="ab-tab-text"
          :class="{ 'ab-tab-text--on': activeTab == 'agent' }"
        >{{ t("Mobile.Message.buddyTabAgent") }}</text>
      </view>
    </view>

    <!-- 表单：搜索框 + 申请附言（仅用户 tab；智能体加联系人直接生效，无需附言） -->
    <view class="ab-form">
      <view class="ab-label-row">
        <text class="ab-label">
          {{ activeTab == 'user' ? t("Mobile.Message.searchUserLabel") : t("Mobile.Message.searchAgentLabel") }}
        </text>
      </view>
      <view class="ab-search">
        <input
          class="ab-search-input"
          v-model="keyword"
          :placeholder="activeTab == 'user'
            ? t('Mobile.Message.searchUserPlaceholder')
            : t('Mobile.Message.searchAgentPlaceholder')"
          placeholder-class="ab-ph"
        />
        <view class="ab-search-icon">
          <svg-icon name="icon-Search" size="28" color="#9a9aa2" />
        </view>
      </view>

      <view v-if="activeTab == 'user'" class="ab-msg-box">
        <textarea
          class="ab-msg-input"
          v-model="applyMessage"
          :maxlength="100"
          :placeholder="t('Mobile.Message.buddyRemarkPlaceholder')"
          placeholder-class="ab-ph"
        />
        <text class="ab-msg-count">{{ applyMessage.length }} / 100</text>
      </view>
    </view>

    <!-- 结果列表：idle 不搜（仅提示输入），智能体平台侧不可用单独提示 -->
    <scroll-view class="ab-list" direction="vertical" :show-scrollbar="false">
      <view v-if="searchState == 'idle'" class="ab-state">
        <text class="ab-state-text">{{ t("Mobile.Message.imSearchIdle") }}</text>
      </view>
      <view v-else-if="searchState == 'loading'" class="ab-state">
        <text class="ab-state-text">{{ t("Mobile.Common.loading") }}</text>
      </view>
      <view v-else-if="searchState == 'failed'" class="ab-state" @click="doSearchNow">
        <text class="ab-state-text">{{ t("Mobile.Message.loadFailed") }}</text>
      </view>
      <!-- 智能体专属：平台侧不可用（契约 degraded=true 时 items 为空≠没有结果） -->
      <view v-else-if="searchState == 'unavailable'" class="ab-state" @click="doSearchNow">
        <text class="ab-state-text">{{ t("Mobile.Message.agentSearchUnavailable") }}</text>
      </view>
      <view v-else-if="searchState == 'done' && results.length == 0" class="ab-state">
        <text class="ab-state-text">{{ t("Mobile.AgentSearch.emptyResult") }}</text>
      </view>
      <view v-else class="ab-list-body">
        <view
          v-for="m in results"
          :key="m.userId"
          class="ab-row"
          hover-class="ab-row--active"
          @click="toggleTarget(m)"
        >
          <view class="ab-avatar">
            <image
              v-if="m.avatarUrl.length > 0 && m.avatarFailed != true"
              class="ab-avatar-img"
              :src="m.avatarUrl"
              mode="aspectFit"
              @error="handleAvatarError(m)"
            />
            <view
              v-else
              class="ab-avatar-fallback"
              :style="{ backgroundImage: avatarGradient(m.displayName) }"
            >
              <text class="ab-avatar-letter">{{ avatarLetter(m.displayName) }}</text>
            </view>
          </view>
          <view class="ab-row-main">
            <text class="ab-row-name text-ellipsis">{{ m.displayName }}</text>
            <text v-if="m.description.length > 0" class="ab-row-desc text-ellipsis">
              {{ m.description }}
            </text>
          </view>
          <view class="ab-check" :class="{ 'ab-check--on': isSelectedTarget(m) }">
            <svg-icon v-if="isSelectedTarget(m)" name="icon-Check" size="24" color="#ffffff" />
          </view>
        </view>
      </view>
      <view class="ab-tail" />
    </scroll-view>

    <!-- 非联系人 gating 提示：选中的还不是我的联系人，发消息被禁，引导先加联系人 -->
    <view v-if="sendMsgBlocked" class="ab-hint">
      <text class="ab-hint-text">{{ t("Mobile.Message.notContactSendHint") }}</text>
    </view>

    <!-- 底部按钮：取消=返回 / 加为联系人 / 发消息 -->
    <view class="ab-footer" :style="footerStyle">
      <view class="ab-btn" hover-class="ab-btn-cancel--active" @click="handleBack">
        <text class="ab-btn-text ab-btn-text--cancel">{{ t("Mobile.Common.cancel") }}</text>
      </view>
      <view
        class="ab-btn ab-btn--secondary"
        :class="{ 'ab-btn--disabled': busy }"
        hover-class="ab-btn-cancel--active"
        @click="handleAddContact"
      >
        <text class="ab-btn-text ab-btn-text--cancel">{{ t("Mobile.Message.addAsContact") }}</text>
      </view>
      <view
        class="ab-btn ab-btn--ok"
        :class="{ 'ab-btn--disabled': busy || sendMsgBlocked }"
        hover-class="ab-btn-ok--active"
        @click="handleSendMsg"
      >
        <text class="ab-btn-text ab-btn-text--ok">{{ t("Mobile.Message.sendMessage") }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, onUnmounted, ref, watch } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import {
    apiImAddContact,
    apiImContacts,
    apiImCreateP2pConversation,
    apiImSearchAgents,
    apiImSearchContacts,
  } from "@/servers/im";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 搜索结果行（人 tab 与智能体 tab 共用；description 仅智能体有）。 */
  class AbBuddy {
    userId: string = "";
    displayName: string = "";
    avatarUrl: string = "";
    avatarFailed: boolean = false;
    description: string = "";
  }

  /** 头像字母底色渐变板（对齐消息页六色系）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #f59a9a, #e05f5f)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  /** user=人 tab（searchContacts）| agent=智能体 tab（contactSearchAgents） */
  const activeTab = ref<string>("user");
  const keyword = ref<string>("");
  const applyMessage = ref<string>("");
  /** 搜索结果（仅当次关键字命中；初始不加载，输入才搜） */
  const results = ref<AbBuddy[]>([]);
  /** idle=未输入 | loading | failed | unavailable(智能体平台侧挂) | done */
  const searchState = ref<string>("idle");
  /** 单选目标（人/智能体通用，按 userId 比对） */
  const selectedTarget = ref<AbBuddy | null>(null);
  /** 加为联系人/发消息 互斥防重 */
  const busy = ref<boolean>(false);
  /** 扫用户名片码预填场景：目标 userId 非空时，搜索结果命中即自动选中该行
   *  （用户仍可改选；未命中/未搜到不选，交用户手动挑）。 */
  let autoSelectUserId = "";
  /** 输入防抖定时器 + 搜索序号（旧请求晚归丢弃，防竞态串结果） */
  let searchDebounceTimer = -1;
  let searchSeq = 0;

  /**
   * 底部安全距离（同原底部弹窗版）：App 端样式表 env(safe-area-inset-bottom)
   * 不可靠，内联把底部内边距改为 24rpx 基础 + 系统安全区（px），按钮避开
   * iPhone home 条；H5/小程序走样式表 env()，不叠加。
   */
  const footerStyle = computed((): string => {
    let style = "";
    // #ifdef APP
    try {
      const win = uni.getWindowInfo();
      const scale = win.windowWidth / 750;
      const basePx = scale > 0 ? Math.round(24 * scale) : 24;
      style = `padding-bottom: ${basePx + win.safeAreaInsets.bottom}px;`;
    } catch (_e) {
      style = "";
    }
    // #endif
    return style;
  });

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  /** 已互为联系人 userId 集（status=1）：搜索接口 ContactSearchItem 无联系人标记，
   *  「发消息」gating 只能靠通讯录本地比对。拉取失败/被截断（truncated）时放弃
   *  gating（fail-open：宁可不禁也不错禁真联系人，服务端仍是权威兜底）。 */
  const contactUserIds = new Set<string>();
  const contactIdsLoaded = ref<boolean>(false);
  const contactIdsTruncated = ref<boolean>(false);
  let contactIdsLoading = false;

  async function loadContactIds(): Promise<void> {
    if (contactIdsLoading || contactIdsLoaded.value) {
      return;
    }
    contactIdsLoading = true;
    try {
      const res = await apiImContacts();
      contactIdsLoading = false;
      if (apiResCode(res) != SUCCESS_CODE) {
        // 失败保持未加载态：下次搜索自动重试，期间发消息按原行为放行
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      contactUserIds.clear();
      if (dataObj != null) {
        contactIdsTruncated.value = readBool(dataObj, "truncated");
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            // status=1 才是已互为联系人；2=对方申请待我确认 3=我已申请待对方同意，都还不能直接发消息
            const item = items[i];
            if (readString(item, "status") == "1") {
              const uid = readString(item, "userId");
              if (uid.length > 0) {
                contactUserIds.add(uid);
              }
            }
          }
        }
      }
      contactIdsLoaded.value = true;
    } catch (_e) {
      contactIdsLoading = false;
    }
  }

  /** 发消息禁用：仅用户 tab——已选中目标、通讯录比对可靠（已拉取且未截断）、对方
   *  还不是我的联系人。智能体 tab 不 gating（加为联系人即时生效）。 */
  const sendMsgBlocked = computed((): boolean => {
    if (activeTab.value != "user" || !contactIdsLoaded.value || contactIdsTruncated.value) {
      return false;
    }
    const target = selectedTarget.value;
    if (target == null) {
      return false;
    }
    return !contactUserIds.has(target.userId);
  });

  /** 页面入参读取（容错解码：扫码预填的关键字可能带中文/特殊字符）。 */
  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  /** 回初始态：清结果/清防抖定时器/序号自增（作废在途请求）。 */
  function resetSearchIdle(): void {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
    searchSeq++;
    searchState.value = "idle";
    results.value = [];
  }

  /** 切 tab：数据源不同，搜索关键字/结果/选中目标全部重置（附言保留）。 */
  function switchTab(tab: string): void {
    if (activeTab.value == tab) {
      return;
    }
    activeTab.value = tab;
    keyword.value = "";
    results.value = [];
    selectedTarget.value = null;
    resetSearchIdle();
  }

  /** 人 tab 结果行：ContactSearchItem 无 displayName，按 nickName > userName 回落。 */
  function readUserRow(item: UTSJSONObject): AbBuddy | null {
    const row = new AbBuddy();
    row.userId = readString(item, "userId");
    if (row.userId.length == 0) {
      return null;
    }
    const nickName = readString(item, "nickName");
    row.displayName = nickName.length > 0 ? nickName : readString(item, "userName");
    row.avatarUrl = readString(item, "avatar");
    return row;
  }

  /** 智能体 tab 结果行：AgentSearchItem 的 name/description/avatar。 */
  function readAgentRow(item: UTSJSONObject): AbBuddy | null {
    const row = new AbBuddy();
    row.userId = readString(item, "userId");
    if (row.userId.length == 0) {
      return null;
    }
    row.displayName = readString(item, "name");
    row.description = readString(item, "description");
    row.avatarUrl = readString(item, "avatar");
    return row;
  }

  /** 用当前关键字立即搜索（防抖到期或失败重试触发），按 tab 走对应接口。 */
  async function doSearchNow(): Promise<void> {
    const kw = keyword.value.trim();
    if (kw.length == 0) {
      resetSearchIdle();
      return;
    }
    const tab = activeTab.value;
    const seq = ++searchSeq;
    searchState.value = "loading";
    // 用户 tab 顺带补拉通讯录（onLoad 首拉失败时的重试路径；成功后 gating 生效）
    if (tab != "agent" && !contactIdsLoaded.value) {
      loadContactIds();
    }
    try {
      const res = tab == "agent"
        ? await apiImSearchAgents(kw, 1, 20)
        : await apiImSearchContacts(kw, 20);
      // 期间又有新输入/切 tab：本请求作废，不覆盖新状态
      if (seq != searchSeq || tab != activeTab.value) {
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        searchState.value = "failed";
        return;
      }
      const rows: AbBuddy[] = [];
      let degraded = false;
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        degraded = readBool(dataObj, "degraded");
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const row = tab == "agent" ? readAgentRow(items[i]) : readUserRow(items[i]);
            if (row != null) {
              rows.push(row);
            }
          }
        }
      }
      // 智能体契约：degraded=true ⇒ 平台不可用且 items 为空（≠没有结果），单独提示
      if (tab == "agent" && degraded) {
        searchState.value = "unavailable";
        return;
      }
      results.value = rows;
      searchState.value = "done";
      // 扫码预填场景：结果命中目标 userId 即自动选中（人 tab；未命中保持手选）
      if (autoSelectUserId.length > 0 && tab == "user") {
        for (let i = 0; i < rows.length; i++) {
          if (rows[i].userId == autoSelectUserId) {
            selectedTarget.value = rows[i];
            autoSelectUserId = "";
            break;
          }
        }
      }
    } catch (e) {
      if (seq == searchSeq && tab == activeTab.value) {
        searchState.value = "failed";
      }
    }
  }

  /** 输入防抖 400ms：停顿后才发请求（连打只发最后一次）；清空立即回初始态。 */
  watch(keyword, (val: string) => {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
    if (val.trim().length == 0) {
      resetSearchIdle();
      return;
    }
    searchDebounceTimer = setTimeout(() => {
      searchDebounceTimer = -1;
      doSearchNow();
    }, 400);
  });

  function isSelectedTarget(m: AbBuddy): boolean {
    const sel = selectedTarget.value;
    return sel != null && sel.userId == m.userId;
  }

  /** 单选：再点同一行取消，点别行换目标。 */
  function toggleTarget(m: AbBuddy): void {
    if (isSelectedTarget(m)) {
      selectedTarget.value = null;
    } else {
      selectedTarget.value = m;
    }
  }

  function handleAvatarError(m: AbBuddy): void {
    m.avatarFailed = true;
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  /**
   * 加为联系人（contactAdd）：人 tab 附言随申请发送（对方需 accept），智能体
   * 无附言、服务端直接生效；按 ContactAddResult 的 alreadyContact / accepted
   * 决定文案。成功 toast + 返回（消息页 onShow 静默刷新智联录）。
   */
  async function handleAddContact(): Promise<void> {
    if (busy.value) {
      return;
    }
    const target = selectedTarget.value;
    if (target == null) {
      uni.showToast({ title: t("Mobile.Message.selectTargetFirst"), icon: "none" });
      return;
    }
    busy.value = true;
    try {
      const msg = activeTab.value == "user" ? applyMessage.value.trim() : "";
      const res = await apiImAddContact(target.userId, msg);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.addContactFailed"), icon: "none" });
        return;
      }
      let accepted = false;
      let alreadyContact = false;
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        accepted = readBool(dataObj, "accepted");
        alreadyContact = readBool(dataObj, "alreadyContact");
      }
      let title = t("Mobile.Message.contactRequestSent");
      if (alreadyContact) {
        title = t("Mobile.Message.alreadyContact");
      } else if (accepted) {
        title = t("Mobile.Message.contactAdded");
      }
      uni.showToast({ title, icon: "none" });
      uni.navigateBack({ delta: 1 });
    } catch (e) {
      uni.showToast({ title: t("Mobile.Message.addContactFailed"), icon: "none" });
    } finally {
      busy.value = false;
    }
  }

  /**
   * 发消息：convCreateP2p（幂等）建/取会话后 redirectTo 消息详情页（替换本页，
   * 返回直达消息列表——与原弹窗「关弹窗后跳转」同栈序）。
   */
  async function handleSendMsg(): Promise<void> {
    if (busy.value) {
      return;
    }
    // 非联系人 gating：按钮已是禁用态，这里兜底点按反馈（提示条常驻 footer 上方）
    if (sendMsgBlocked.value) {
      uni.showToast({ title: t("Mobile.Message.notContactSendHint"), icon: "none" });
      return;
    }
    const target = selectedTarget.value;
    if (target == null) {
      uni.showToast({ title: t("Mobile.Message.selectTargetFirst"), icon: "none" });
      return;
    }
    busy.value = true;
    try {
      const res = await apiImCreateP2pConversation(target.userId);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      const convId = dataObj != null ? readString(dataObj, "convId") : "";
      if (convId.length == 0) {
        uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
        return;
      }
      uni.redirectTo({
        url:
          `/pages/message/chat?convId=${convId}&convType=1` +
          `&name=${encodeURIComponent(target.displayName)}&avatar=${encodeURIComponent(target.avatarUrl)}`,
      });
    } catch (e) {
      uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
    } finally {
      busy.value = false;
    }
  }

  function handleBack(): void {
    // 刷新后栈底保护：同搜索页，无页可退时切回消息 tab，避免整页重载死循环
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      uni.switchTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    // 扫用户名片码预填：赋值 keyword 触发 watch 防抖自动搜索；
    // userId 非空时结果命中即自动选中（QR 已锁定具体用户，免漏点行）
    const kw = readOption(options, "keyword");
    const uid = readOption(options, "userId");
    if (kw.length > 0) {
      keyword.value = kw;
    }
    autoSelectUserId = uid;
    // 首拉通讯录建「已互为联系人」集合（发消息 gating 比对用；失败由每次搜索重试）
    loadContactIds();
  });

  onUnmounted(() => {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
  });
</script>

