/**
 * nuwax-katex：uni-app x 数学公式渲染插件（类似 lime-katex）
 *
 * utssdk 接口定义：各平台实现位于 utssdk/<platform>/index.uts，
 * 通过 `import { renderLatex } from '@/uni_modules/nuwax-katex'` 按平台解析。
 *
 * 平台渲染策略：
 * - H5        ：内置 KaTeX 直出 HTML → 组件 v-html（真实 DOM，实时）
 * - 微信小程序 ：内置 KaTeX 直出 HTML → 关键 CSS 内联 → 组件 rich-text
 * - App       ：组件内 <web-view> 承载本地 static/index.html（KaTeX 实时渲染），
 *               本接口在 App 端为占位实现（无原生代码，标准基座即可运行）
 */

/** 渲染选项 */
export type KatexRenderOptions = {
	/** 块级（displayMode:true）或行内（false） */
	displayMode: boolean
	/** 渲染失败时的兜底颜色（KaTeX errorColor） */
	errorColor: string
}

/** 渲染结果 */
export type KatexRenderRes = {
	/** 可渲染 HTML（H5/MP）；App 端返回空串（组件走 web-view，不经此接口） */
	html: string
	/** 错误信息，空串表示成功 */
	errMsg: string
}

/** 文本切分片段类型：text=普通文本 / inline=行内公式 / block=块级公式 */
export type MathSegmentType = 'text' | 'inline' | 'block'

/** 文本切分片段 */
export type MathSegment = {
	type: MathSegmentType
	content: string
}
