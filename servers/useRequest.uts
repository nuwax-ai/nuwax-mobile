import {
  COMMON_HEADERS,
} from "@/constants/common.constants";
import { API_TIMEOUT } from "@/constants/api.constants";
import { ACCESS_TOKEN, ACCESS_TOKEN_ORIGIN, EXPIRE_DATE } from "../constants/home.constants";
import {
  DEFAULT_LANG,
  I18N_LANG_STORAGE_KEY,
} from "@/constants/i18n.constants";
import {
  LOGIN_WHITELIST_URL,
  clearStoragePreservingApiBaseUrl,
  getApiBaseUrl,
  getVoxBaseUrl,
} from "../constants/config";
import {
  REDIRECT_LOGIN,
  SUCCESS_CODE,
  USER_NO_LOGIN,
} from "@/constants/codes.constants";
import { applyBearerAuthorization, bootstrapH5AccessTokenFromUrl } from "@/utils/authSession";

// #ifdef H5 || WEB
import {
  fetchEventSource,
  EventSourceMessage,
} from "@microsoft/fetch-event-source";
// #endif

import { handleExternalLink } from "@/utils/system";
import { getCurrentPageFullPath } from "@/utils/common";
import {
  LOGIN_PAGE_PATH,
  LOGIN_WEIXIN_PAGE_PATH,
  redirectToLoginOnce,
} from "@/utils/authNavigation";
import { orObject, orString } from "@/utils/utsCoalesce";
import { applyXClientTypeHeader } from "@/utils/appWebViewDetect";

// 请求/响应日志开关：开发环境(HBuilderX 运行=development)自动开，发行打包(NODE_ENV=production，如打 APK)自动关
// const ENABLE_REQUEST_LOG = process.env.NODE_ENV !== "production";

// 微信小程序：request
// 参数/返回值均用 any：Android 运行时对象字面量与响应体均为 UTSJSONObject，禁止 interface 强转
export default function request(options: any): Promise<any> {
  // Android: 调用方传入的对象字面量运行时为 UTSJSONObject，禁止 options.xxx interface 属性访问
  // （Kotlin 会生成 RequestOptions.getData() 等虚调用，UTSJSONObject 未实现该接口 → IncompatibleClassChangeError）
  const opts = options as UTSJSONObject;
  const urlVal = opts["url"];
  const url = urlVal != null ? `${urlVal}` : "";
  const methodVal = opts["method"];
  const method = methodVal != null ? `${methodVal}` : "POST";
  const dataVal = opts["data"];
  // Android: uni.request 的 data 只能是 UTSJSONObject 或 string。
  // 自定义 class（如 SquarePublishedListParams）在小程序可直接序列化，Android 会发畸形 body 导致接口报错。
  // 统一 JSON 中转成 UTSJSONObject，保证各端请求体一致。
  let requestData: any | null = "";
  if (dataVal != null) {
    if (typeof dataVal == "string") {
      requestData = dataVal;
    } else {
      const jsonStr = JSON.stringify(dataVal);
      if (jsonStr != null && jsonStr != "") {
        const parsed = JSON.parse(jsonStr);
        requestData = parsed != null ? parsed : dataVal;
      } else {
        requestData = dataVal;
      }
    }
  }
  const timeoutRaw = opts["timeout"];
  // 所有普通 API 都必须有确定的结束边界，避免页面 await 永久悬挂并锁住交互状态。
  let timeoutNum = API_TIMEOUT;
  if (timeoutRaw != null) {
    timeoutNum = timeoutRaw as number;
  }
  // 可选 baseUrl 覆盖（如 Nuwax Vox 网关 VOX_BASE_URL），缺省走主站 API_BASE_URL
  const baseUrlRaw = opts["baseUrl"];
  const baseUrl = baseUrlRaw != null ? `${baseUrlRaw}` : getApiBaseUrl();
  const skipAuthRaw = opts["skipAuth"];
  const skipAuth = skipAuthRaw == true;
  // #ifdef H5 || WEB
  bootstrapH5AccessTokenFromUrl();
  // #endif
  const accessToken = uni.getStorageSync(ACCESS_TOKEN);
  const accessTokenOriginRaw = uni.getStorageSync(ACCESS_TOKEN_ORIGIN);
  const accessTokenOrigin = accessTokenOriginRaw != null ? `${accessTokenOriginRaw}` : "";
  // 兼容升级前没有 origin 标记的旧 Token；新登录均会写入该标记。
  const tokenMatchesOrigin = accessTokenOrigin.length == 0 || accessTokenOrigin == baseUrl;
  const _rawLang = uni.getStorageSync(I18N_LANG_STORAGE_KEY);
  let currentLang = (_rawLang != null ? _rawLang : DEFAULT_LANG) as string;
  currentLang = (currentLang != null ? currentLang : DEFAULT_LANG).toLowerCase();
  // Build header from COMMON_HEADERS + overrides
  const headerObj = new UTSJSONObject(COMMON_HEADERS);
  const header = JSON.parse(JSON.stringify(headerObj)) as UTSJSONObject;
  header["Accept-Language"] = currentLang;
  // 支持业务接口按需覆盖请求头（例如 application/x-www-form-urlencoded）。
  const customHeaderVal = opts["header"];
  if (customHeaderVal != null) {
    // UTSJSONObject 不支持 Object.keys；当前请求层仅需覆盖 Content-Type。
    const customHeader = customHeaderVal as UTSJSONObject;
    const customContentType = customHeader["Content-Type"];
    if (customContentType != null) {
      header["Content-Type"] = `${customContentType}`;
    }
  }

  // 统一识别头：原生 App ios/android/harmony；小程序 mp-weixin；
  // 浏览器 H5 为 h5；App 内嵌 H5 与宿主同值（ios/android/harmony）。
  applyXClientTypeHeader(header);
  // App / 小程序 / H5 开发 / App 内嵌 H5 → Bearer；浏览器 H5 生产仍走 Cookie ticket
  if (!skipAuth && tokenMatchesOrigin) {
    applyBearerAuthorization(header, accessToken != null ? `${accessToken}` : null);
  }

  // uEnvProd
  if (process.env.NODE_ENV === "production") {
    // #ifdef H5
    //仅H5需要添加fragment参数
    const fragment = orString(window.location.hash, "#/").replace("#/", "/");
    if (fragment != null && fragment != "") {
      header["fragment"] = fragment;
    }
    // #endif
  }

  // uni.request 在 UTS 里返回 RequestTask（非 Promise），这里手动包装为 Promise
  return new Promise<any>((resolve, reject) => {
  // uni-app x: 后端响应大量字段返 null，严格反序列化会 errCode=100003。
  // uni.request<string> 拿原始文本宽松解析；禁止 JSON.parse<T>（Gson 无法实例化 interface）。
  // 自定义 RequestOptions 已改名为 ApiRequestOptions，避免与 SDK RequestOptions 冲突。
    const fullUrl = baseUrl + url;
    // Vox 网关已跟随主域名（config.uts 中 VOX_BASE_URL == API_BASE_URL），仅比较 baseUrl 取值
    // 会把所有主站请求误判成 vox 请求，导致下方 4010 分支的 `!isVoxUrl` 守卫恒不成立、
    // 踢登录逻辑对全部接口失效（表现为接口反复返回 4010 却永不跳登录页）。
    // servers/vox/* 均显式传入 baseUrl: VOX_BASE_URL，主站接口不传，故以「调用方是否显式指定」区分。
    const isVox = baseUrlRaw != null && baseUrl == getVoxBaseUrl();
    const logTag = isVox ? "[VoxReq]" : "[ApiReq]";
    uni.request<ArrayBuffer>({
      url: fullUrl,
      method: method,
      // data 可能为 null(无 body 的 GET)，无 body 时传空串
      data: requestData as any,
      timeout: timeoutNum,
      header: header,
      // 全端统一：>2^53 的 int64（convId/msgId 等雪花号）按数字解析会丢精度
      // （iOS 真机实测：真值 …8256 被舍成 …8260 → 后端报 IM_20103 会话不存在）。
      // iOS 运行时会无视 <string> 泛型与 dataType "text"，仍把 JSON 预解析成对象，
      // 精度在 NSNumber→string 转换时即已损失、事后无法恢复——所以改用
      // responseType "arraybuffer" 按原始字节返回，从根上绕开运行时的一切文本/JSON
      // 处理：success 里自行 UTF-8 解码 + parseJsonKeepInt64 防精度解析。
      // Android/鸿蒙原生解析虽保精度，也统一走此路径消除平台差异。
      dataType: "text",
      responseType: "arraybuffer",
      success: (res) => {
        // 登录态（ACCESS_TOKEN）不再从响应 Set-Cookie 同步：登录/内嵌注入即权威，cookie 轮换不得覆盖
        // （防止进入聊天页时带入被服务端 cookie 轮换淘汰的旧 token → 4010 弹登录）。
        // 正常路径：res.data 是 ArrayBuffer → UTF-8 解码 → parseJsonKeepInt64（大整数保
        // 精度；禁止 JSON.parse<T>，Gson 无法实例化 interface）。
        // 兜底：若某端运行时无视 responseType 仍返回预解析对象（typeof object）或文本，
        // 分别回落旧对象路径 / 直接按文本解析，行为不劣化。
        const dataVal: any | null = res.data as any | null;
        let rawText: string | null = null;
        if (typeof dataVal == "string") {
          rawText = `${dataVal}`;
        } else if (dataVal != null && dataVal instanceof ArrayBuffer) {
          rawText = utf8ArrayBufferToString(dataVal);
        }
        let responseData: any | null = null;
        if (rawText != null) {
          try {
            responseData = parseJsonKeepInt64(rawText);
          } catch (_e) {
            responseData = null; // 空 body / 非 JSON（如网关 HTML 错误页）：按无数据处理，调用方按失败信封处理
          }
        } else {
          responseData = dataVal; // 运行时无视 responseType 仍预解析：保留旧行为
        }
        // 非 JSON 文本不能 as UTSJSONObject（Android 原生会 CCE），信封码按无处理
        const respObj = typeof responseData == "string"
          ? null
          : responseData != null
            ? (responseData as UTSJSONObject)
            : null;
        const codeVal = respObj != null ? respObj["code"] : null;
        const code = codeVal != null ? `${codeVal}` : null;
        const msgVal = respObj != null ? respObj["message"] : null;
        const errorMessage = msgVal != null ? `${msgVal}` : "";
        // UTS→Kotlin: `===` 引用相等，业务码比较一律 `==`。

        // 登录跳转豁免接口：batch 事件上报、多语言列表、租户配置信息。
        // 后两者是登录页挂载即调的游客接口，若参与踢登录页会在登录页自身形成
        // 「挂载→请求返回鉴权码→踢登录页→再挂载」的重定向循环；调用方按非成功码自行处理即可。
        const isAuthKickExemptUrl = url != null &&
          (url.includes("/api/notify/event/collect/batch") ||
            url.includes("/api/i18n/lang/list") ||
            url.includes("/api/tenant/config"));
        // vox 网关未登录响应不踢主站登录态（可能未实现主站 token 校验代理，避免误清 storage）
        const isVoxUrl = isVox;
        if (isAuthKickExemptUrl) {
          resolve(responseData as any);
        } else if (code == USER_NO_LOGIN && !isVoxUrl) {
          // 用户未登录，跳转到登录页
          // 仅在本地确实存有登录态时才清缓存：游客冷启动时多个接口都会返回 4010，
          // 无条件 clearStorage 会把 i18n 文案与租户配置缓存一并清掉，登录页文案/站点名
          // 先落默认值再被接口刷新，直观表现就是闪烁。
          const hadToken = accessToken != null && `${accessToken}`.length > 0;
          if (hadToken) {
            uni.setStorageSync(ACCESS_TOKEN, ""); // 清空token【兼容鸿蒙系统】
            clearStoragePreservingApiBaseUrl(); // 清空业务缓存，保留企业域名
          }
          // 并发/连续多个接口返回 4010 时，跳转由 redirectToLoginOnce 去重，
          // 已在登录页则完全不再 reLaunch，避免登录页被反复重建。
          // #ifdef H5 || WEB || APP
          redirectToLoginOnce(LOGIN_PAGE_PATH);
          // #endif
          // #ifdef MP-WEIXIN
          redirectToLoginOnce(LOGIN_WEIXIN_PAGE_PATH);
          // #endif
          resolve(responseData as any);
        } else if (code == REDIRECT_LOGIN) {
          // 重定向到登录页
          // 与 4010 分支同理：本地没有登录态时不清缓存（否则会连带清掉 i18n/租户配置缓存）
          if (accessToken != null && `${accessToken}`.length > 0) {
            uni.setStorageSync(ACCESS_TOKEN, ""); // 清空token【兼容鸿蒙系统】
            clearStoragePreservingApiBaseUrl(); // 清空业务缓存，保留企业域名
          }
          let redirectUrl = errorMessage;
          let resolvedEarly = false;
          // 如果错误信息包含/login开头，则替换为登录页，否则直接打开完整链接
          if (errorMessage.startsWith("/login")) {
            // #ifdef H5 || WEB || APP
            // 如果url在登录白名单地址中，则不跳转到登录页
            if (LOGIN_WHITELIST_URL.includes(url)) {
              resolve(responseData as any);
              resolvedEarly = true;
            } else {
              redirectUrl = errorMessage.replace(
                "/login",
                LOGIN_PAGE_PATH,
              );
              redirectToLoginOnce(redirectUrl);
            }
            // #endif

            // #ifdef MP-WEIXIN
            // 微信小程序：获取当前页面的 url
            const currentUrl = getCurrentPageFullPath();
            if (currentUrl != null && currentUrl != "") {
              if (globalThis.appConfig.redirectUrl != null && globalThis.appConfig.redirectUrl != "") {
                const otherQueryStr = globalThis.appConfig.redirectUrl;
                redirectToLoginOnce(
                  LOGIN_WEIXIN_PAGE_PATH +
                    "?redirect=" +
                    encodeURIComponent(
                      "/subpackages/pages/webview/webview?url=" + otherQueryStr,
                    ),
                );
              } else {
                redirectToLoginOnce(
                  LOGIN_WEIXIN_PAGE_PATH +
                    "?redirect=" +
                    encodeURIComponent(currentUrl),
                );
              }
            }
            // #endif
          } else {
            // #ifdef H5 || WEB
            window.location.href = errorMessage;
            // #endif
            // #ifdef MP
            handleExternalLink(errorMessage);
            // #endif
            // #ifdef APP
            // APP 端无法也无需跳 H5 登录 URL：登录态已在上方清理，
            // 这里必须回到原生登录页，否则用户停留在已清态的页面上（无任何跳转）。
            redirectToLoginOnce(LOGIN_PAGE_PATH);
            // #endif
          }
          if (!resolvedEarly) {
            resolve(responseData as any);
          }
        } else {
          resolve(responseData as any);
        }
      },
      fail: (error: any) => {
        console.error(`${logTag} ✕ ${method} ${fullUrl} | 网络/请求失败:`, error);
        // 网络错误或其他错误，也返回错误信息
        reject(error);
      },
    });
  });
}

export type SSEOptions<T = any> = {
  url: string;
  method?: "GET" | "POST" | "PUT" | "DELETE";
  headers?: UTSJSONObject | null;
  body?: any;
  onMessage: any;
  onError: any;
  onOpen: any;
  onClose: any;
  abortController?: any;
}

// SSE 连接（平台分叉：H5/Web 用 fetch-event-source，APP 用原生分块请求）
export function createSSEConnection<T = any>(options: SSEOptions<T>) {
  const _rawLang = uni.getStorageSync(I18N_LANG_STORAGE_KEY);
  const rawLangStr = _rawLang != null ? _rawLang as string : DEFAULT_LANG;
  const currentLang = rawLangStr.toLowerCase();

  // #ifdef H5 || WEB
  const controller = orObject(options.abortController, new AbortController());
  const fragment = orString(window.location.hash, "#/").replace("#/", "/");
  try {
    const headers = new UTSJSONObject(COMMON_HEADERS);
    headers["Content-Type"] = "application/json";
    headers["Accept-Language"] = currentLang;
    applyXClientTypeHeader(headers);
    if (options.headers != null) {
      const optHeaders = options.headers as UTSJSONObject;
      const headerKeys = UTSJSONObject.keys(optHeaders);
      for (let hi = 0; hi < headerKeys.length; hi++) {
        const hk = headerKeys[hi];
        headers[hk] = optHeaders[hk];
      }
    }
    if (fragment != null && fragment != "") {
      headers["fragment"] = fragment;
    }
    const fetchOptions = {
      method: options.method != null ? options.method : "POST",
      headers: headers,
      body:
        options.body != null && typeof options.body === "object"
          ? JSON.stringify(options.body)
          : options.body,
      signal: controller.signal,
      openWhenHidden: true,
      onopen: async (response: any) => {
        if (response.status >= 400) {
          throw new Error(
            String(response.statusText != null ? response.statusText : String(response.status != null ? response.status : 0)),
          );
        }
        if (options.onOpen != null) {
          options.onOpen(response);
        }
      },
      onmessage: (event: EventSourceMessage) => {
        try {
          const data = event.data != null ? (JSON.parse(event.data) as T) : null;
          if (data !== null) {
            options.onMessage(data);
          }
        } catch (error) {
          const errMsg = error != null ? String(error) : "Unknown error";
          const normalizedError = new Error(errMsg);
          if (options.onError != null) {
            options.onError(normalizedError);
          }
        }
      },
      onclose: () => {
        if (options.onClose != null) {
          options.onClose();
        }
      },
      onerror: (error: any) => {
        if (error != null && error.name === "AbortError") {
          console.log("SSE连接已被中止");
          return;
        }
        const errMsg2 = error != null ? String(error) : "Unknown error";
        const normalizedError = new Error(errMsg2);
        if (options.onError != null) {
          options.onError(normalizedError);
        }
        throw normalizedError;
      },
    } as any;
    fetchEventSource(options.url, fetchOptions).catch((error: any) => {
      if (error != null && error.name === "AbortError") {
        console.log("SSE连接已被中止");
        return;
      }
      const errMsg3 = error != null ? String(error) : "Unknown error";
      const normalized = new Error(errMsg3);
      if (options.onError != null) {
        options.onError(normalized);
      }
    });
    return controller;
  } catch (error) {
    if (error != null && (error as any).name === "AbortError") {
      console.log("SSE连接已被中止");
      return undefined;
    }
    const errMsg4 = error != null ? String(error) : "Unknown error";
    const normalized = new Error(errMsg4);
    if (options.onError != null) {
      options.onError(normalized);
    }
    throw normalized;
  }
  // #endif

  // #ifdef APP-PLUS || APP
  let buffer = "";
  // 与 H5 分支一致：合并调用方 headers（含 Authorization），勿传空对象导致鉴权丢失
  const appSseHeaders = new UTSJSONObject(COMMON_HEADERS);
  appSseHeaders["Content-Type"] = "application/json";
  appSseHeaders["Accept-Language"] = currentLang;
  applyXClientTypeHeader(appSseHeaders);
  if (options.headers != null) {
    const optHeaders = options.headers as UTSJSONObject;
    const headerKeys = UTSJSONObject.keys(optHeaders);
    for (let hi = 0; hi < headerKeys.length; hi++) {
      const hk = headerKeys[hi];
      appSseHeaders[hk] = optHeaders[hk];
    }
  }
  const task = uni.request({
    url: options.url,
    method: options.method != null ? options.method : "POST",
    header: appSseHeaders,
    data:
      options.body != null && typeof options.body === "object"
        ? JSON.stringify(options.body)
        : options.body,
    enableChunked: true,
    success: (res: any) => {
      const onOpenFn = options.onOpen as ((res: any) => void) | null;
      if (onOpenFn != null) {
        onOpenFn(res);
      }
    },
    fail: (err: any) => {
      const errObj = err as UTSJSONObject;
      const errMsgRaw = errObj != null ? errObj["errMsg"] : null;
      const errMsg5 = errMsgRaw != null ? (errMsgRaw as string) : "Unknown error";
      const error = new Error(errMsg5);
      const onErrorFn = options.onError as ((error: Error) => void) | null;
      if (onErrorFn != null) {
        onErrorFn(error);
      }
    },
    complete: () => {
      const onCloseFn = options.onClose as (() => void) | null;
      if (onCloseFn != null) {
        onCloseFn();
      }
    },
  });

  // Android：必须用官方 RequestTaskOnChunkReceivedListenerResult，勿 as ArrayBuffer / UTSJSONObject
  task.onChunkReceived((res: RequestTaskOnChunkReceivedListenerResult) => {
    const arrayBuffer = res.data as ArrayBuffer;
    try {
      const text = arrayBufferToString(arrayBuffer);
      buffer += text;
      const parts = buffer.split("\n\n");
      const lastPart = parts.pop();
      buffer = lastPart != null ? lastPart : "";
      for (let pi = 0; pi < parts.length; pi++) {
        const part = parts[pi];
        const lines = part.split("\n");
        let dataLine: string | null = null;
        for (let li = 0; li < lines.length; li++) {
          if (lines[li].startsWith("data:")) {
            dataLine = lines[li];
            break;
          }
        }
        if (dataLine == null) {
          continue;
        }
        const payload = dataLine.slice(5).trim();
        if (payload.length == 0 || payload === "[DONE]") {
          continue;
        }
        try {
          const onMessageFn = options.onMessage as ((data: T) => void) | null;
          if (onMessageFn != null) {
            onMessageFn(JSON.parse(payload) as T);
          }
        } catch (e) {
          const errMsg6 = e != null ? (e as string) : "Unknown error";
          const onErrorFn2 = options.onError as ((error: Error) => void) | null;
          if (onErrorFn2 != null) {
            onErrorFn2(new Error(errMsg6));
          }
        }
      }
    } catch (e) {
      const errMsg7 = e != null ? (e as string) : "Unknown error";
      const onErrorFn3 = options.onError as ((error: Error) => void) | null;
      if (onErrorFn3 != null) {
        onErrorFn3(new Error(errMsg7));
      }
    }
  });

  class SSEController {
    aborted: boolean = false;
    signal: UTSJSONObject;
    abort: (() => void);
    constructor(task: any) {
      this.signal = new UTSJSONObject();
      this.signal["aborted"] = false;
      this.abort = () => {
        this.aborted = true;
        this.signal["aborted"] = true;
        try {
          const taskObj = task as UTSJSONObject;
          const abortFn = taskObj["abort"] as (() => void) | null;
          if (abortFn != null) {
            abortFn();
          }
        } catch (e) {
          console.error("SSE task abort failed", e);
        }
      };
    }
  }

  let controller: SSEController;
  if (options.abortController != null) {
    controller = options.abortController as SSEController;
  } else {
    controller = new SSEController(task);
  }

  return controller as any;
  // #endif
}

/**
 * ArrayBuffer → string（完整 UTF-8 解码，含中文与 emoji 代理对）。
 * 供 request 响应体解码：响应体整段到达，无 SSE 分块跨界问题；
 * SSE 路径的 arrayBufferToString 语义不同，勿混用。
 */
function utf8ArrayBufferToString(buffer: ArrayBuffer): string {
  const bytes = new Uint8Array(buffer);
  const n = bytes.length;
  let out = "";
  let i = 0;
  while (i < n) {
    const b0 = bytes[i];
    if (b0 < 0x80) {
      out += String.fromCharCode(b0);
      i += 1;
    } else if (b0 < 0xe0 && i + 1 < n) {
      out += String.fromCharCode(((b0 & 0x1f) << 6) | (bytes[i + 1] & 0x3f));
      i += 2;
    } else if (b0 < 0xf0 && i + 2 < n) {
      out += String.fromCharCode(((b0 & 0x0f) << 12) | ((bytes[i + 1] & 0x3f) << 6) | (bytes[i + 2] & 0x3f));
      i += 3;
    } else if (i + 3 < n) {
      const cp = ((b0 & 0x07) << 18) | ((bytes[i + 1] & 0x3f) << 12) | ((bytes[i + 2] & 0x3f) << 6) | (bytes[i + 3] & 0x3f);
      // >0xFFFF 的码点（emoji 等）拆成 UTF-16 高低代理对
      const v = cp - 0x10000;
      out += String.fromCharCode(0xd800 + (v >> 10));
      out += String.fromCharCode(0xdc00 + (v & 0x3ff));
      i += 4;
    } else {
      // 截断或非法序列：替换字符收尾，避免死循环
      out += String.fromCharCode(0xfffd);
      i += 1;
    }
  }
  return out;
}

function arrayBufferToString(buffer: ArrayBuffer): string {
  const bytes = new Uint8Array(buffer);
  let result = "";
  for (let i = 0; i < bytes.length; i++) {
    result += String.fromCharCode(bytes[i]);
  }
  try {
    const decoded = decodeURIComponent(result);
    return decoded != null ? decoded : result;
  } catch (e) {
    return result;
  }
}

/** 单字符是否为十进制数字字面量（0-9）。UTS 字符串无大小比较运算符，逐个枚举。
 * ★取单字符一律用 charAt(i)：下标 raw[i] 在 Android 端是 Char，与 String 比较/传参编译不过。 */
function isDigitChar(ch: string): boolean {
  return ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" ||
    ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9";
}

/**
 * 快速预检：响应里是否存在「冒号后 ≥16 位连续数字」（>2^53 的 int64 才会丢精度）。
 * 绝大多数响应（i18n/配置/小数值）预检不中，直接走原生 JSON.parse，零改写开销。
 * 字符串字面量内的数字不算（扫描跟踪引号与反斜杠转义）。
 */
function hasLossyIntLiteral(raw: string): boolean {
  const n = raw.length;
  let i = 0;
  let inString = false;
  while (i < n) {
    const ch = raw.charAt(i);
    if (inString) {
      if (ch == "\\") {
        i += 2;
        continue;
      }
      if (ch == "\"") {
        inString = false;
      }
      i++;
      continue;
    }
    if (ch == "\"") {
      inString = true;
      i++;
      continue;
    }
    if (ch == ":") {
      let j = i + 1;
      while (j < n && isDigitChar(raw.charAt(j))) {
        j++;
      }
      if (j - i - 1 >= 16) {
        return true;
      }
      i = j;
      continue;
    }
    i++;
  }
  return false;
}

/**
 * 全端防精度 JSON 解析（Android/鸿蒙/iOS/H5 统一走）：解析前把「对象值位置 ≥16 位的
 * 无符号整数字面量」改写成字符串再 JSON.parse。
 *
 * 背景：后端 convId/msgId/userId 等雪花号是 int64（19 位，远超 JS 的 2^53），
 * H5 默认按数字解析会被舍入（225429701454200828 → …830），拼进 URL 后后端
 * 查无此会话（IM_20103 会话不存在）。雪花号在页面层本就约定「存字符串」
 * （readString 统一 `${raw}` 转换），改写字面量不改变消费方式。
 *
 * 规则与边界：
 * - 只处理冒号后紧跟的数字（对象值位置）；数组元素、负数、浮点/科学计数法不动
 * - 15 位及以下整数本就精确，保持数字类型（seq/sendTime/code/unreadCount 等）
 * - 字符串字面量内部绝不改写（跟踪引号开合与 \\ 转义），消息文本再像 JSON 也安全
 * - 16 位但 ≤2^53 的值（极少见）会被一并字符串化，对 `${}`/URL 拼接无影响
 */
function parseJsonKeepInt64(raw: string): any | null {
  if (!hasLossyIntLiteral(raw)) {
    return JSON.parse(raw);
  }
  let out = "";
  let i = 0;
  const n = raw.length;
  let inString = false;
  while (i < n) {
    const ch = raw.charAt(i);
    if (inString) {
      out += ch;
      if (ch == "\\") {
        if (i + 1 < n) {
          out += raw.charAt(i + 1);
        }
        i += 2;
        continue;
      }
      if (ch == "\"") {
        inString = false;
      }
      i++;
      continue;
    }
    if (ch == "\"") {
      inString = true;
      out += ch;
      i++;
      continue;
    }
    if (ch == ":") {
      out += ch;
      i++;
      let j = i;
      while (j < n && isDigitChar(raw.charAt(j))) {
        j++;
      }
      if (j > i) {
        const digits = raw.substring(i, j);
        if (j - i >= 16) {
          out += "\"";
          out += digits;
          out += "\"";
        } else {
          out += digits;
        }
      }
      i = j;
      continue;
    }
    out += ch;
    i++;
  }
  return JSON.parse(out);
}
