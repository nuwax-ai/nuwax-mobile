<template>
  <!--
    App 端 CSS @keyframes / image animation 常无效，setInterval+transition 每 tick 都要
    JS→native 桥接重建 style，多实例/页面重渲染时掉帧明显（已实测卡顿）。
    App 端改静态圆环图（零 JS 驱动，绝不卡）；非 App 端 SVG + CSS 旋转。
  -->
  <!-- #ifdef APP -->
  <image
    class="spin-loading"
    :style="boxStyle"
    src="@/static/assets/icon_loading.svg"
    mode="aspectFit"
    :show-menu-by-longpress="false"
  />
  <!-- #endif -->

  <!-- #ifndef APP -->
  <view
    class="spin-loading"
    :style="boxStyle"
  ></view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { computed } from "vue";

  const props = withDefaults(
    defineProps<{
      /** 尺寸，如 14px / 24px */
      size?: string;
      /** 环颜色（App 端静态图固定绿色，此参数仅非 App 端生效） */
      color?: string;
      /** 单圈时长（ms），默认 1000 对齐 H5 */
      durationMs?: number;
    }>(),
    {
      size: "16px",
      color: "#3283ff",
      durationMs: 1000,
    },
  );

  const boxStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    style["width"] = props.size;
    style["height"] = props.size;
    return style;
  });
</script>

<style lang="scss" scoped>
  .spin-loading {
    box-sizing: border-box;
    border-radius: 100px;
    border-top-width: 2px;
    border-top-style: solid;
    border-right-width: 2px;
    border-right-style: solid;
    border-bottom-width: 2px;
    border-bottom-style: solid;
    border-bottom-color: transparent;
    border-left-width: 2px;
    border-left-style: solid;
    border-left-color: transparent;
    transition-property: transform;
    transition-timing-function: linear;
    transform: rotate(0deg);
  }
</style>
