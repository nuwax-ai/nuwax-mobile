/**
 * iOS 上架版付费智能体屏蔽（App Store 审核条款 3.1.1）。
 *
 * iOS 端无应用内购买渠道，付费智能体（paymentRequired = true）在 iOS 上
 * 一律不展示、不可访问（含网页端已购内容），各列表数据层与会话入口统一
 * 调用本模块判定，避免被判「访问 App 外购买的数字内容」。
 * 其他平台原样放行，不影响 Android / H5 / 小程序行为。
 */
export function isIosPaidAgentBlocked(src: UTSJSONObject | null): boolean {
  // #ifdef APP-IOS
  if (src == null) {
    return false;
  }
  return src["paymentRequired"] == true;
  // #endif
  // #ifndef APP-IOS
  return false;
  // #endif
}
