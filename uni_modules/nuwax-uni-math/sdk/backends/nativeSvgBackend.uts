// #ifdef APP-ANDROID || APP-IOS
// #ifdef APP-ANDROID
import utils from "@/uni_modules/uni-ai-x/sdk/utils.uts"
// #endif
import { renderMathAsync } from "@/uni_modules/nuwax-uni-math"

/**
 * Phase2 数学渲染后端（APP 原生）：QuickJS/JavaScriptCore + MathJax(tex-svg) → 位图。
 *  - Android：QuickJS + AndroidSVG → WebP 位图
 *  - iOS：JavaScriptCore + UIImage(data:) → PNG 位图（见 utssdk/app-ios/MathSvgBridge.swift）
 *
 * 不再过隐藏 proxy web-view → 根除数学渲染的 evalJS 桥死锁；公式原生生成 SVG（可导出），
 * 再 rasterize 成位图 dataURL 走 <image> 显示（缓存后可回收，适配 list 50~100 公式密度）。
 *
 * 线程模型：
 *  - Android：QuickJS 单 context 非线程安全 → 渲染在插件内 Executors.newSingleThreadExecutor 串行，
 *    结果在工作线程回调 → 这里 utils.uniGetDispatcher("main") 切回主线程。
 *  - iOS：JSContext 非线程安全 → 渲染在插件内串行 DispatchQueue，结果经 DispatchQueue.main.async
 *    切回主线程 → 这里直接调 callback（已在主线程）。
 *
 * 契约：回包 UTSJSONObject { imageDataURL, width, height, svg }（svg 供导出）；失败回 { error }，
 *   由 MathRendererCore.renderViaBackend 兜底回 proxyWebBackend（隐藏 web-view KaTeX）。
 *
 * 颜色 / DPI：当前固定近黑 + 2.5x（高 DPI 清晰）。暗色主题与字号随主题接入是后续 TODO。
 */
export function nativeSvgBackend(
	latex: string,
	displayMode: boolean,
	callback: (res: UTSJSONObject) => void,
): void {
	const dpiScale: number = 2.5
	// 近黑（非纯黑，视觉更柔和）；暗色模式 TODO：从主题取反色
	const color: string = "#1A1A1A"
	renderMathAsync(latex, displayMode, dpiScale, color, (res: UTSJSONObject): void => {
		// #ifdef APP-ANDROID
		utils.uniGetDispatcher("main", (): void => {
			callback(res)
		})
		// #endif
		// #ifdef APP-IOS
		// iOS 插件已在 Swift 内 DispatchQueue.main.async 切回主线程，这里直接回调
		callback(res)
		// #endif
	})
}
// #endif
