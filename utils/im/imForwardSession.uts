import { getImSessionStamp } from "./imSessionScope";
/**
 * 转发会话暂存（chat.uvue → im-forward 页的跨页数据传递）。
 *
 * 转发载荷（消息快照数组）远超 URL query 承载量，eventBus 又是即发即逝
 * （im-forward 页 onLoad 晚于 emit 就丢帧），这里用模块级暂存：
 * chat.uvue set 后 uni.navigateTo，im-forward onLoad take（取出即清，
 * 返回重进不会拿到上一次的旧载荷）。
 *
 * ★single 模式只带 msgId 列表（REST /forward 按服务端存的原始消息逐条复制，
 * 客户端不碰 body）；merge 模式必须带快照（服务端只存客户端拼好的 body.items，
 * 快照构建契约见 servers/im.uts apiImSendMergeForwardMsg）。
 */

/** 一条待转发消息的快照（merge 模式构建 body.items 用；single 模式只用 msgId）。 */
export class ImForwardItem {
  /** 源消息 id（int64 字符串）。 */
  msgId: string = "";
  /** 六型白名单之一（text/rich_text/image/file/audio/video，小写）。 */
  msgType: string = "";
  /** 发送人显示名（服务端 senderName；空则调用方兜底「未知用户」）。 */
  senderName: string = "";
  /** 发送时间（正整数毫秒，合并快照必填）。 */
  sendTime: number = 0;
  /** 正文快照（已按 500 码点截断；纯媒体消息为空串）。 */
  text: string = "";
  /** 附件快照 JSON 数组字符串（[{kind,url,fileName,size}]，已滤掉空 url 项；无附件 "[]"）。 */
  attachmentsJson: string = "[]";
  /** 列表摘要（转发页顶部已选预览行用，发送不参与）。 */
  digest: string = "";
}

/** 一次转发会话：模式 + 源会话 + 待转消息。 */
export class ImForwardSession {
  /** "single" 逐条 / "merge" 合并。 */
  mode: string = "single";
  /** 源会话 id（逐条转发的分片键）。 */
  sourceConvId: string = "";
  items: ImForwardItem[] = [];
}

let forwardSessionStamp = "";
let forwardSession: ImForwardSession | null = null;

/** 写入转发载荷并跳转 im-forward 页（调用方已保证 items 非空且过白名单）。 */
export function openImForward(session: ImForwardSession): void {
  forwardSessionStamp = getImSessionStamp();
  forwardSession = session;
  uni.navigateTo({ url: "/subpackages/pages/im-forward/im-forward" });
}

/** im-forward 页 onLoad 取载荷（一次性：取出即清空）。 */
export function takeImForwardSession(): ImForwardSession | null {
  const s = forwardSessionStamp == getImSessionStamp() ? forwardSession : null;
  forwardSession = null;
  return s;
}

export function clearImForwardSession(): void { forwardSession = null; }
