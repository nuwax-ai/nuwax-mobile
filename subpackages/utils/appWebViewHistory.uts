/**
 * App web-view 内部历史后退。
 *
 * 不在业务侧另记路由。android.webkit.WebView、WKWebView、鸿蒙 WebviewController
 * 已经记录链接跳转和 history.pushState。这里只查询 canGoBack / accessBackward，
 * 有上一页则后退，没有则交给页面栈。
 *
 * iOS 另打开 WKWebView.allowsBackForwardNavigationGestures，让边缘右滑先划出
 * 网页上一页。页面侧滑的开关由 webview 页按 canGoBack 动态切换。
 */

// #ifdef APP-ANDROID
import WebView from "android.webkit.WebView";
import View from "android.view.View";
import ViewGroup from "android.view.ViewGroup";
// #endif

// #ifdef APP-IOS
import { WKWebView } from "WebKit";
import { UIView } from "UIKit";
// #endif

// #ifdef APP-HARMONY
import { webview } from "@kit.ArkWeb";
// #endif

// #ifdef APP-ANDROID
/** 从指定节点向下找第一个 WebView。DCloud 的实现类继承 android.webkit.WebView。 */
function findAndroidWebView(elementId: string): WebView | null {
  const el = uni.getElementById(elementId);
  if (el == null) {
    return null;
  }
  return findAndroidWebViewIn(el.getAndroidView());
}

function findAndroidWebViewIn(view: View | null): WebView | null {
  if (view == null) {
    return null;
  }
  if (view instanceof WebView) {
    return view as WebView;
  }
  if (view instanceof ViewGroup) {
    const group = view as ViewGroup;
    const count: Int = group.getChildCount();
    for (let i: Int = 0; i < count; i++) {
      const found = findAndroidWebViewIn(group.getChildAt(i));
      if (found != null) {
        return found;
      }
    }
  }
  return null;
}
// #endif

// #ifdef APP-IOS
function findIOSWebView(elementId: string): WKWebView | null {
  const el = uni.getElementById(elementId);
  if (el == null) {
    return null;
  }
  return findIOSWebViewIn(el.getIOSView());
}

function findIOSWebViewIn(view: UIView | null): WKWebView | null {
  if (view == null) {
    return null;
  }
  if (view instanceof WKWebView) {
    return view as WKWebView;
  }
  const children = view.subviews;
  for (let i = 0; i < children.length; i++) {
    const found = findIOSWebViewIn(children[i]);
    if (found != null) {
      return found;
    }
  }
  return null;
}
// #endif

// #ifdef APP-HARMONY
function findHarmonyWebView(elementId: string): webview.WebviewController | null {
  const el = uni.getElementById(elementId);
  if (el == null) {
    return null;
  }
  try {
    return el.getHarmonyController() as webview.WebviewController | null;
  } catch (_e) {
    return null;
  }
}
// #endif

/**
 * 当前 web-view 是否还能退回网页上一页。
 * 原生视图还没挂上时返回 false，调用方应离开本页，避免把用户困在白屏。
 * @param elementId web-view 的 id
 */
export function appWebViewCanGoBack(elementId: string): boolean {
  // #ifdef APP-ANDROID
  try {
    const androidView = findAndroidWebView(elementId);
    return androidView != null && androidView.canGoBack();
  } catch (_eAndroid) {
    return false;
  }
  // #endif
  // #ifdef APP-IOS
  try {
    const iosView = findIOSWebView(elementId);
    return iosView != null && iosView.canGoBack;
  } catch (_eIos) {
    return false;
  }
  // #endif
  // #ifdef APP-HARMONY
  try {
    const harmonyView = findHarmonyWebView(elementId);
    return harmonyView != null && harmonyView.accessBackward();
  } catch (_eHarmony) {
    return false;
  }
  // #endif
  // #ifndef APP
  return false;
  // #endif
}

/**
 * 网页还有上一页时后退，并返回 true。没有上一页或视图不可用时返回 false。
 * @param elementId web-view 的 id
 */
export function appWebViewGoBack(elementId: string): boolean {
  // #ifdef APP-ANDROID
  try {
    const androidView = findAndroidWebView(elementId);
    if (androidView != null && androidView.canGoBack()) {
      // WebView.goBack 必须在主线程。已在主线程时 runOnUiThread 会立即执行。
      const target = androidView;
      const activity = UTSAndroid.getUniActivity();
      if (activity != null) {
        activity.runOnUiThread((): void => {
          try {
            target.goBack();
          } catch (_eGo) {
            // 后退失败时页面栈已由 onBackPress 消费；下一轮查询 canGoBack 仍为 true，可再退
          }
        });
      } else {
        androidView.goBack();
      }
      return true;
    }
  } catch (_eAndroidBack) {
    return false;
  }
  return false;
  // #endif
  // #ifdef APP-IOS
  try {
    const iosView = findIOSWebView(elementId);
    if (iosView != null && iosView.canGoBack) {
      iosView.goBack();
      return true;
    }
  } catch (_eIosBack) {
    return false;
  }
  return false;
  // #endif
  // #ifdef APP-HARMONY
  try {
    const harmonyView = findHarmonyWebView(elementId);
    if (harmonyView != null && harmonyView.accessBackward()) {
      harmonyView.backward();
      return true;
    }
  } catch (_eHarmonyBack) {
    return false;
  }
  return false;
  // #endif
  // #ifndef APP
  return false;
  // #endif
}

/**
 * 打开 iOS WebView 自带的边缘后退手势。其它端没有对应开关，空操作。
 * 重复调用只重复赋值，不叠加手势。
 * @param elementId web-view 的 id
 */
export function enableAppWebViewBackGesture(elementId: string): void {
  // #ifdef APP-IOS
  try {
    const iosView = findIOSWebView(elementId);
    if (iosView != null) {
      iosView.allowsBackForwardNavigationGestures = true;
    }
  } catch (_eGesture) {
    // 视图未挂载时下一轮再开
  }
  // #endif
  // #ifndef APP-IOS
  // 非 iOS 没有对应开关。读一次参数，避免目标平台把未使用形参判为错误。
  if (elementId.length < 0) {
    return;
  }
  // #endif
}
