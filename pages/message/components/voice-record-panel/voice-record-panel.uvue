  position: absolute;
  top: 0;
  left: 0;
  width: 1400px;
  height: 100%;
}

.vr-wave__mark {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 4px;
}

.vr-wave__bar {
  position: absolute;
  left: 0;
  bottom: 140rpx;
  width: 3px;
  border-radius: 2px;
}

.vr-wave__base {
  position: absolute;
  left: 0;
  right: 0;
