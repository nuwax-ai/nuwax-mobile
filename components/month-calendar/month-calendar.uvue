<template>
  <view class="month-calendar">
    <view class="month-bar">
      <view class="month-arrow" @click="shiftMonth(-1)">
        <svg-icon name="icon-a-Chevronleft" size="18" unit="px" color="#1f2329" />
      </view>
      <text class="month-title">{{ monthTitle }}</text>
      <view class="month-arrow" @click="shiftMonth(1)">
        <svg-icon name="icon-a-Chevronright" size="18" unit="px" color="#1f2329" />
      </view>
    </view>
    <view class="week-head">
      <text v-for="(label, index) in weekdayLabels" :key="index" class="head-cell">{{ label }}</text>
    </view>
    <swiper class="month-swiper" :current="pageIndex" :circular="true" :duration="280" @change="onPageChange">
      <swiper-item>
        <view v-for="(week, weekIndex) in slotWeeks0" :key="weekIndex" class="week">
          <view v-for="(cell, dayIndex) in week" :key="dayIndex" class="cell" @click="pick(cell)">
            <view class="day" :class="cell.selected ? 'day--selected' : ''">
              <text :class="dayTextClass(cell)">{{ cell.day }}</text>
            </view>
          </view>
        </view>
      </swiper-item>
      <swiper-item>
        <view v-for="(week, weekIndex) in slotWeeks1" :key="weekIndex" class="week">
          <view v-for="(cell, dayIndex) in week" :key="dayIndex" class="cell" @click="pick(cell)">
            <view class="day" :class="cell.selected ? 'day--selected' : ''">
              <text :class="dayTextClass(cell)">{{ cell.day }}</text>
            </view>
          </view>
        </view>
      </swiper-item>
      <swiper-item>
        <view v-for="(week, weekIndex) in slotWeeks2" :key="weekIndex" class="week">
          <view v-for="(cell, dayIndex) in week" :key="dayIndex" class="cell" @click="pick(cell)">
            <view class="day" :class="cell.selected ? 'day--selected' : ''">
              <text :class="dayTextClass(cell)">{{ cell.day }}</text>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import SvgIcon from "@/components/svg-icon/svg-icon.uvue";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";

  /** 月历中的一天。inMonth 为 false 时是上月或下月的补位日期。 */
  class CalendarDay {
    year: number = 0;
    month: number = 0;
    day: number = 0;
    inMonth: boolean = true;
    selected: boolean = false;

    constructor(year: number, month: number, day: number, inMonth: boolean, selected: boolean) {
      this.year = year;
      this.month = month;
      this.day = day;
      this.inMonth = inMonth;
      this.selected = selected;
    }
  }

  const emit = defineEmits<{
    /** 选中日期，格式 yyyy-M-d */
    select: [value: string];
  }>();

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const weekdayLabels: string[] = [
    t("Mobile.Discover.weekdaySunShort"),
    t("Mobile.Discover.weekdayMonShort"),
    t("Mobile.Discover.weekdayTueShort"),
    t("Mobile.Discover.weekdayWedShort"),
    t("Mobile.Discover.weekdayThuShort"),
    t("Mobile.Discover.weekdayFriShort"),
    t("Mobile.Discover.weekdaySatShort"),
  ];

  const now = new Date();
  const viewYear = ref<number>(now.getFullYear());
  const viewMonth = ref<number>(now.getMonth() + 1);
  const selectedYear = ref<number>(now.getFullYear());
  const selectedMonth = ref<number>(now.getMonth() + 1);
  const selectedDay = ref<number>(now.getDate());
  const pageIndex = ref<number>(1);
  const slotWeeks0 = ref<CalendarDay[][]>([] as CalendarDay[][]);
  const slotWeeks1 = ref<CalendarDay[][]>([] as CalendarDay[][]);
  const slotWeeks2 = ref<CalendarDay[][]>([] as CalendarDay[][]);
  const monthTitle = ref<string>("");

  function daysInMonth(year: number, month: number): number {
    return new Date(year, month, 0).getDate();
  }

  function isSelected(year: number, month: number, day: number): boolean {
    return year == selectedYear.value && month == selectedMonth.value && day == selectedDay.value;
  }

  function addMonths(year: number, month: number, delta: number): number[] {
    let nextMonth = month + delta;
    let nextYear = year;
    while (nextMonth < 1) {
      nextMonth += 12;
      nextYear -= 1;
    }
    while (nextMonth > 12) {
      nextMonth -= 12;
      nextYear += 1;
    }
    const result: number[] = [];
    result.push(nextYear);
    result.push(nextMonth);
    return result;
  }

  /** 环形三页里，目标页相对当前页的月份偏移，只可能是 -1、0、1。 */
  function circularDelta(target: number, base: number): number {
    const diff = target - base;
    if (diff == 2 || diff == -1) return -1;
    if (diff == -2 || diff == 1) return 1;
    return 0;
  }

  function buildWeeks(year: number, month: number): CalendarDay[][] {
    const firstWeekday = new Date(year, month - 1, 1).getDay();
    const count = daysInMonth(year, month);
    const prevCount = daysInMonth(year, month - 1);
    const cells: CalendarDay[] = [];
    let index = 0;
    while (index < firstWeekday) {
      const day = prevCount - firstWeekday + index + 1;
      let cellYear = year;
      let cellMonth = month - 1;
      if (cellMonth < 1) {
        cellMonth = 12;
        cellYear = year - 1;
      }
      cells.push(new CalendarDay(cellYear, cellMonth, day, false, isSelected(cellYear, cellMonth, day)));
      index++;
    }
    let day = 1;
    while (day <= count) {
      cells.push(new CalendarDay(year, month, day, true, isSelected(year, month, day)));
      day++;
    }
    let nextDay = 1;
    while (cells.length < 42) {
      let cellYear = year;
      let cellMonth = month + 1;
      if (cellMonth > 12) {
        cellMonth = 1;
        cellYear = year + 1;
      }
      cells.push(new CalendarDay(cellYear, cellMonth, nextDay, false, isSelected(cellYear, cellMonth, nextDay)));
      nextDay++;
    }

    const nextWeeks: CalendarDay[][] = [];
    let weekStart = 0;
    while (weekStart < cells.length) {
      const week: CalendarDay[] = [];
      let offset = 0;
      while (offset < 7) {
        week.push(cells[weekStart + offset]);
        offset++;
      }
      nextWeeks.push(week);
      weekStart += 7;
    }
    return nextWeeks;
  }

  function rebuild(): void {
    const year = viewYear.value;
    const month = viewMonth.value;
    const titleParams = new Map<string, string | number>();
    titleParams.set("year", year);
    titleParams.set("month", month);
    monthTitle.value = translateFn("Mobile.Discover.scheduleMonth", toI18nParams(titleParams), "");
    const current = pageIndex.value;
    const month0 = addMonths(year, month, circularDelta(0, current));
    const month1 = addMonths(year, month, circularDelta(1, current));
    const month2 = addMonths(year, month, circularDelta(2, current));
    slotWeeks0.value = buildWeeks(month0[0], month0[1]);
    slotWeeks1.value = buildWeeks(month1[0], month1[1]);
    slotWeeks2.value = buildWeeks(month2[0], month2[1]);
  }

  function emitSelected(): void {
    emit("select", `${selectedYear.value}-${selectedMonth.value}-${selectedDay.value}`);
  }

  function showMonth(year: number, month: number, day: number): void {
    viewYear.value = year;
    viewMonth.value = month;
    selectedYear.value = year;
    selectedMonth.value = month;
    selectedDay.value = day;
    rebuild();
    emitSelected();
  }

  function shiftMonth(delta: number): void {
    const next = addMonths(viewYear.value, viewMonth.value, delta);
    showMonth(next[0], next[1], 1);
  }

  function onPageChange(e: UniSwiperChangeEvent): void {
    const nextIndex = e.detail.current;
    if (nextIndex == pageIndex.value) return;
    const delta = circularDelta(nextIndex, pageIndex.value);
    pageIndex.value = nextIndex;
    if (delta == 0) {
      rebuild();
      return;
    }
    const next = addMonths(viewYear.value, viewMonth.value, delta);
    showMonth(next[0], next[1], 1);
  }

  function pick(cell: CalendarDay): void {
    selectedYear.value = cell.year;
    selectedMonth.value = cell.month;
    selectedDay.value = cell.day;
    viewYear.value = cell.year;
    viewMonth.value = cell.month;
    rebuild();
    emitSelected();
  }

  /** 回到今天：月历和选中日期都切到当天 */
  function goToday(): void {
    const today = new Date();
    selectedYear.value = today.getFullYear();
    selectedMonth.value = today.getMonth() + 1;
    selectedDay.value = today.getDate();
    viewYear.value = selectedYear.value;
    viewMonth.value = selectedMonth.value;
    rebuild();
    emitSelected();
  }

  function dayTextClass(cell: CalendarDay): string {
    if (cell.selected) return "day-text day-text--selected";
    if (!cell.inMonth) return "day-text day-text--muted";
    return "day-text";
  }

  rebuild();
  defineExpose({ goToday });
</script>

<style scoped>
  .month-calendar {
    background-color: #ffffff;
    border-radius: 16px;
    padding: 8px 8px 12px;
  }

  .month-bar {
    position: relative;
    z-index: 2;
    height: 44px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
  }

  .month-arrow {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .month-title {
    font-size: 16px;
    font-weight: 600;
    color: #1f2329;
  }

  .month-swiper {
    position: relative;
    z-index: 1;
    height: 240px;
    overflow: hidden;
  }

  .week-head {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .head-cell {
    flex: 1;
    text-align: center;
    font-size: 13px;
    color: #86909c;
    line-height: 32px;
  }

  .week {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .cell {
    flex: 1;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .day {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .day--selected {
    background-color: #5b4dff;
  }

  .day-text {
    font-size: 15px;
    color: #1f2329;
    text-align: center;
  }

  .day-text--muted {
    color: #c9cdd4;
  }

  .day-text--selected {
    color: #ffffff;
  }
</style>
