<template>
  <view class="gs-page">
    <safety-zone />

    <!-- 顶部：返回 + 群管理 -->
    <view class="gs-header">
      <view class="gs-header__btn" hover-class="gs-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="20" unit="px" color="#141416" />
      </view>
      <view class="gs-header__title-wrap">
        <text class="gs-header__title">{{ t("Mobile.Message.groupManage") }}</text>
        <!-- 对齐 PC：普通成员也要知道「为什么这些开关都是灰的」，否则会以为是坏了 -->
        <text v-if="!canGovern && !disbanded" class="gs-header__subtitle">
          {{ t("Mobile.Message.groupSettingsAdminOnlyHint") }}
        </text>
      </view>
      <view class="gs-header__btn gs-header__btn--ghost" />
    </view>

    <scroll-view class="gs-body" direction="vertical" :show-scrollbar="false">
      <view v-if="loading" class="gs-state">
        <text class="gs-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view v-else-if="loadFailed" class="gs-state" @click="handleRetry">
        <text class="gs-state__text">{{ t("Mobile.Message.loadFailed") }}</text>
      </view>
      <view v-else class="gs-list">

        <!-- 已解散横幅：群已不存在，下方治理/解散入口整体隐藏（详情 status=2） -->
        <view v-if="disbanded" class="gs-card gs-disbanded-tip">
          <text class="gs-disbanded-tip__text">{{ t("Mobile.Message.groupDisbanded") }}</text>
        </view>

        <!-- 群名称：管理员可改（输入框 + 保存），普通成员只读；
             ★团队群（convType=4）资料跟随平台：整行换成只读文字，连输入框都不给 ——
               留一个灰输入框会让管理员以为"是我权限不够"，去找群主也改不了 -->
        <view class="gs-card">
          <view class="gs-sec-head">
            <text class="gs-sec-title">{{ t("Mobile.Message.groupName") }}</text>
            <view
              v-if="canGovern && !disbanded && !isTeam"
              class="gs-save"
              hover-class="gs-save--active"
              @click="handleSaveName"
            >
              <text class="gs-save__text">{{ savingName ? t("Mobile.Page.loadingMore") : t("Mobile.Common.save") }}</text>
            </view>
          </view>
          <template v-if="isTeam">
            <text class="gs-team-name">{{ nameDraft.length > 0 ? nameDraft : t("Mobile.Message.groupNamePlaceholder") }}</text>
            <text class="gs-desc gs-desc--last">{{ t("Mobile.Message.groupTeamReadonlyHint") }}</text>
          </template>
          <template v-else>
            <input
              class="gs-name-input"
              v-model="nameDraft"
              :disabled="canGovern != true || disbanded"
              :placeholder="t('Mobile.Message.groupNamePlaceholder')"
              placeholder-style="color:#b0aebc"
              :maxlength="64"
            />
            <text v-if="!disbanded" class="gs-desc gs-desc--last">
              {{ canGovern ? t("Mobile.Message.groupNameDescEditable") : t("Mobile.Message.groupNameDescReadonly") }}
            </text>
          </template>
        </view>

        <!-- 群头像（仅 IM 自建群；团队群跟随平台，整行不渲染） -->
        <view v-if="!isTeam" class="gs-card">
          <view class="gs-sec-head">
            <text class="gs-sec-title">{{ t("Mobile.Message.groupAvatarLabel") }}</text>
            <view
              v-if="canGovern && !disbanded"
              class="gs-save"
              hover-class="gs-save--active"
              @click="handleChangeAvatar"
            >
              <text class="gs-save__text">
                {{ avatarUploading ? t("Mobile.Page.loadingMore") : t("Mobile.Message.groupAvatarChange") }}
              </text>
            </view>
          </view>
          <view class="gs-avatar-row">
            <!-- 鸿蒙保留已加载的旧图，候选新图加载成功后才替换；
                 真图绝对定位盖在上面。★不用负 margin 叠：鸿蒙上负偏移跨平台表现不一，
                 容器定尺寸 + absolute 是唯一三端都稳的写法 -->
            <!-- #ifdef APP-HARMONY -->
            <view class="gs-avatar-wrap gs-avatar-wrap--clip">
              <im-buffered-avatar :source-key="avatarRaw" :src="avatarDisplay" :failed="avatarFailed" @avatar-error="handleAvatarError">
                <view class="gs-avatar gs-avatar--letter" :style="{ backgroundImage: avatarGradient }">
                  <text class="gs-avatar__letter">{{ avatarLetter }}</text>
                </view>
              </im-buffered-avatar>
            </view>
            <!-- #endif -->
            <!-- #ifndef APP-HARMONY -->
            <view class="gs-avatar-wrap">
              <view class="gs-avatar gs-avatar--letter" :style="{ backgroundImage: avatarGradient }">
                <text class="gs-avatar__letter">{{ avatarLetter }}</text>
              </view>
              <image
                v-if="avatarDisplay.length > 0 && avatarFailed != true"
                class="gs-avatar gs-avatar--img"
                :src="avatarDisplay"
                mode="aspectFill"
                :fade-show="false"
                @error="handleAvatarError"
              />
            </view>
            <!-- #endif -->
          </view>
          <text class="gs-desc gs-desc--last">
            {{ canGovern ? t("Mobile.Message.groupAvatarDescEditable") : t("Mobile.Message.groupAvatarDescReadonly") }}
          </text>
        </view>

        <!-- 群号：点击复制（邀人加群用）。
             ★没有群号（老群 / 团队群）时**整行不渲染**，不摆一个「--」的空值 -->
        <view v-if="groupNo.length > 0" class="gs-card">
          <view class="gs-cell gs-cell--stack" hover-class="gs-cell--active" @click="handleCopyGroupNo">
            <view class="gs-cell__main">
              <text class="gs-cell__label">{{ t("Mobile.Message.joinGroupNoLabel") }}</text>
              <text class="gs-cell__desc">{{ t("Mobile.Message.groupNoDesc") }}</text>
            </view>
            <text class="gs-cell__value">{{ groupNo }}</text>
            <view class="gs-copy">
              <svg-icon name="icon-Copy" size="16" unit="px" color="#5147ff" />
            </view>
          </view>
        </view>

        <!-- 治理开关：仅群主/管理员可改（disabled 锁交互），普通成员只读展示；已解散隐藏 -->
        <view v-if="!disbanded" class="gs-card">
          <view class="gs-cell gs-cell--stack">
            <view class="gs-cell__main">
              <text class="gs-cell__label">{{ t("Mobile.Message.joinApproveLabel") }}</text>
              <text class="gs-cell__desc">{{ t("Mobile.Message.joinApproveDesc") }}</text>
            </view>
            <switch class="gs-switch" :checked="joinApprove" color="#5147ff" :disabled="canGovern != true" @change="handleJoinApproveChange" />
          </view>
          <view class="gs-divider" />
          <view class="gs-cell gs-cell--stack">
            <view class="gs-cell__main">
              <text class="gs-cell__label">{{ t("Mobile.Message.allowInviteLabel") }}</text>
              <text class="gs-cell__desc">{{ t("Mobile.Message.allowInviteDesc") }}</text>
            </view>
            <switch class="gs-switch" :checked="allowInvite" color="#5147ff" :disabled="canGovern != true" @change="handleAllowInviteChange" />
          </view>
          <view class="gs-divider" />
          <view class="gs-cell gs-cell--stack">
            <view class="gs-cell__main">
              <text class="gs-cell__label">{{ t("Mobile.Message.allowPinLabel") }}</text>
              <text class="gs-cell__desc">{{ t("Mobile.Message.allowPinDesc") }}</text>
            </view>
            <switch class="gs-switch" :checked="allowPin" color="#5147ff" :disabled="canGovern != true" @change="handleAllowPinChange" />
          </view>
          <view class="gs-divider" />
          <view class="gs-cell gs-cell--stack">
            <view class="gs-cell__main">
              <text class="gs-cell__label">{{ t("Mobile.Message.readReceiptLabel") }}</text>
              <text class="gs-cell__desc">{{ t("Mobile.Message.readReceiptDesc") }}</text>
            </view>
            <switch class="gs-switch" :checked="readReceipt" color="#5147ff" :disabled="canGovern != true" @change="handleReadReceiptChange" />
          </view>
        </view>

        <!-- 禁言管理（对齐 PC DEV-313）。
             ★团队群也渲染：服务端 mute 只要求 requireManager，没有 requireNotSpaceMirror，
               跟名称/头像那两行不是同一把尺子。
             ★权限三态：群主可开可关；管理员只在「当前开着」时能关（否则群主不在线时
               整个群永久失声）；其余人置灰。 -->
        <view v-if="!disbanded" class="gs-card">
          <view class="gs-sec-head">
            <text class="gs-sec-title">{{ t("Mobile.Message.groupMuteSection") }}</text>
          </view>
          <view class="gs-cell gs-cell--stack">
            <view class="gs-cell__main">
              <text class="gs-cell__label">{{ t("Mobile.Message.groupMuteAllLabel") }}</text>
              <text class="gs-cell__desc">{{ muteAllDesc }}</text>
            </view>
            <switch
              class="gs-switch"
              :checked="muteAll"
              color="#5147ff"
              :disabled="canToggleMuteAll != true || muteBusy"
              @change="handleMuteAllChange"
            />
          </view>
          <!-- 单人禁言的入口在成员页：这里必须写明，否则用户以为只有「全员」一种 -->
          <text v-if="canGovern" class="gs-desc gs-desc--last">
            {{ t("Mobile.Message.groupMuteMemberGuide") }}
          </text>
        </view>

        <!-- 解散群聊（仅群主；群主退群需先转让，此页只给解散）；已解散隐藏 -->
        <view v-if="myRole == 3 && !disbanded" class="gs-card">
          <view class="gs-disband" hover-class="gs-disband--active" @click="handleDisbandTap">
            <text class="gs-disband__text">{{ t("Mobile.Message.dissolveGroupConfirm") }}</text>
          </view>
        </view>

        <view class="gs-tail" />
      </view>
    </scroll-view>

    <!-- 紧凑确认弹窗（解散群聊二次确认，替代系统 showModal 样式） -->
    <confirm-modal ref="confirmModalRef" @confirm="disbandGroup" />
  </view>
</template>

<script setup lang="uts">
  import { switchMainTab } from "@/utils/mainTabNavigation";

  import { computed, ref, type ComponentPublicInstance } from "vue";
  // #ifdef APP-HARMONY
  import ImBufferedAvatar from "@/components/im-buffered-avatar/im-buffered-avatar.uvue";
  // #endif
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import {
    apiImConvDetail,
    apiImGroupDisband,
    apiImGroupMuteAll,
    apiImGroupSetAllowInvite,
    apiImGroupSetAllowPin,
    apiImGroupSetAvatar,
    apiImGroupSetJoinApprove,
    apiImGroupSetName,
    apiImGroupSetReadReceipt,
  } from "@/servers/im";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { uploadSingleFile } from "@/utils/fileUploader";
  import { resolveDisplayImageUrl } from "@/utils/remoteSvgImage";
  import ConfirmModal from "@/components/confirm-modal/confirm-modal.uvue";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ===== 页面入参 =====
  const convId = ref<string>("");

  /** 头像字母底色渐变板（与群信息页/成员页同款五色系）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  // ===== 群详情状态 =====
  const nameDraft = ref<string>("");
  const groupNo = ref<string>("");
  const memberCount = ref<number>(0);
  /** 我的角色：1=普通成员 2=管理员 3=群主（★对齐服务端 ImConstants；管理权限 = >=2）。 */
  const myRole = ref<number>(1);
  const joinApprove = ref<boolean>(false);
  const allowInvite = ref<boolean>(true);
  const allowPin = ref<boolean>(false);
  const readReceipt = ref<boolean>(false);
  /** 群已解散（详情 status=2，软状态仍返回但不可管）：隐藏治理开关与解散入口。 */
  const disbanded = ref<boolean>(false);
  /** allowMemberInvite 三态原始值：""=键缺失(视为允许) / "true" / "false"。 */
  let allowInviteRaw = "";

  /**
   * 会话类型：1=单聊 / 2=IM 自建群 / 4=团队群（space 镜像）。
   * ★团队群的名称/头像跟随平台，服务端 requireNotSpaceMirror 会直接拒；
   *   禁言不受此限制（mute 端点没挂那个断言）。
   */
  const convType = ref<number>(2);

  /** 全员禁言当前状态（会话级 muteAll）。 */
  const muteAll = ref<boolean>(false);
  /** 禁言开关在途（连点会发出相反的两个请求，最后到底哪个生效不确定）。 */
  const muteBusy = ref<boolean>(false);

  /** 群头像原始地址（服务端返回值，未做 /api/f/ 鉴权解析）。 */
  const avatarRaw = ref<string>("");
  /** 已解析、可直接给 <image> 的地址。 */
  const avatarDisplay = ref<string>("");
  const avatarFailed = ref<boolean>(false);
  let avatarResolveVersion = 0;
  const avatarUploading = ref<boolean>(false);

  // ===== 页面态 =====
  const loading = ref<boolean>(false);
  const loadFailed = ref<boolean>(false);
  const savingName = ref<boolean>(false);
  const disbanding = ref<boolean>(false);

  const canGovern = computed((): boolean => myRole.value >= 2);

  const isTeam = computed((): boolean => convType.value == 4);

  /**
   * 全员禁言能否点。
   * ★三态（对齐 PC `canToggleMuteAll`）：群主随时可开可关；管理员**只在当前开着时**
   *   能关 —— 否则群主一开完就下线，整个群永久失声、没人解得开。
   */
  const canToggleMuteAll = computed(
    (): boolean => canGovern.value && (myRole.value == 3 || muteAll.value),
  );

  /** 全员禁言说明（三态文案，说清「为什么点不动」）。 */
  const muteAllDesc = computed((): string => {
    if (myRole.value == 3) {
      return t("Mobile.Message.groupMuteAllDescOwner");
    }
    if (muteAll.value) {
      return t("Mobile.Message.groupMuteAllDescAdminCanClose");
    }
    return t("Mobile.Message.groupMuteAllDescOwnerOnly");
  });

  /** 头像字母兜底（群名首字符；空名给 #）。 */
  const avatarLetter = computed((): string => {
    const trimmed = nameDraft.value.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  });

  /** 字母底渐变（与群信息页/成员页同一块调色板，按群名散列取色，改名跟着换色）。 */
  const avatarGradient = computed((): string => {
    const name = nameDraft.value;
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  });

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  /**
   * 把服务端返回的头像地址解析成能直接喂给 <image> 的地址。
   *
   * ★受保护资源（/api/f/...）在 App 端要带 Bearer，只有 resolveDisplayImageUrl 会做这件事；
   *   原样塞进 src 在 Android 上是 401 灰图、鸿蒙上干脆不加载。
   * 鸿蒙由缓冲组件保留旧节点，其余端解析期间不改 src，避免提前触发 error。
   */
  function applyAvatar(url: string): void {
    const version = ++avatarResolveVersion;
    // #ifdef APP-HARMONY
    if (url != avatarRaw.value) {
      // 只清候选地址，组件内旧图继续显示。
      avatarDisplay.value = "";
    }
    // #endif
    avatarRaw.value = url;
    avatarFailed.value = false;
    if (url.length == 0) {
      avatarDisplay.value = "";
      return;
    }
    resolveDisplayImageUrl(url, 120, 120)
      .then((resolved: string) => {
        // 晚归守卫：期间又换过一次头像 ⇒ 丢弃
        if (avatarRaw.value == url && version == avatarResolveVersion) {
          avatarDisplay.value = resolved;
        }
      })
      .catch((_e: any | null) => {
        // 原地址仍可尝试加载；鸿蒙候选图失败时会继续保留旧头像。
        if (avatarRaw.value == url && version == avatarResolveVersion) {
          avatarDisplay.value = url;
        }
      });
  }

  /** 鸿蒙加载失败由缓冲组件保留旧图；没有旧图时才回落字母底。 */
  function handleAvatarError(): void {
    avatarFailed.value = true;
  }

  /** 详情：groupNo/治理开关只在此端点返回。 */
  async function loadAll(): Promise<void> {
    if (convId.value.length == 0 || loading.value) {
      return;
    }
    loading.value = true;
    loadFailed.value = false;
    try {
      const res = await apiImConvDetail(convId.value);
      if (apiResCode(res) != SUCCESS_CODE) {
        loading.value = false;
        loadFailed.value = true;
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        nameDraft.value = readString(dataObj, "name");
        groupNo.value = readString(dataObj, "groupNo");
        memberCount.value = readNumber(dataObj, "memberCount", 0);
        myRole.value = readNumber(dataObj, "myRole", 1);
        // status：1=正常 2=已解散（服务端软状态，成员查询仍返回但带 status=2）
        disbanded.value = readNumber(dataObj, "status", 1) == 2;
        joinApprove.value = readBool(dataObj, "joinApprove");
        allowPin.value = readBool(dataObj, "allowMemberPin");
        readReceipt.value = readBool(dataObj, "readReceiptOn");
        // ★allowMemberInvite 缺键=允许（PC `!== false` 同口径），勿用 readBool 读成关
        const inviteRaw = dataObj["allowMemberInvite"];
        allowInviteRaw = inviteRaw == null ? "" : `${inviteRaw}`;
        allowInvite.value = allowInviteRaw != "false";
        // convType 缺键按自建群处理（2）：老接口/团队详情之外的场景都是 2，
        // 若误判成 4 会把可编辑的群名锁死，比反过来更糟
        convType.value = readNumber(dataObj, "convType", 2);
        muteAll.value = readBool(dataObj, "muteAll");
        // ★不 await：/api/f/ 头像要走一次下载落盘，等它等于整页陪着转圈。
        //   鸿蒙解析期间保留旧图，无旧图用浅色占位；其余端字母底兜底。
        applyAvatar(readString(dataObj, "avatar"));
      }
      loading.value = false;
    } catch (_error) {
      loading.value = false;
      loadFailed.value = true;
    }
  }

  function handleRetry(): void {
    if (loadFailed.value) {
      loadAll();
    }
  }

  /** 改群名（管理员）：空名提示；成功后本地生效。 */
  async function handleSaveName(): Promise<void> {
    const name = nameDraft.value.trim();
    if (name.length == 0) {
      uni.showToast({ title: t("Mobile.Message.groupNameRequired"), icon: "none" });
      return;
    }
    if (savingName.value || convId.value.length == 0) {
      return;
    }
    savingName.value = true;
    try {
      const res = await apiImGroupSetName(convId.value, name);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Profile.saveSuccess"), icon: "none" });
      } else {
        uni.showToast({ title: apiResMessage(res), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
    savingName.value = false;
  }

  /** 复制群号。 */
  function handleCopyGroupNo(): void {
    if (groupNo.value.length == 0) {
      return;
    }
    uni.setClipboardData({
      data: groupNo.value,
      success: (_res) => {
        uni.showToast({ title: t("Mobile.Common.copySuccess"), icon: "none" });
      },
    });
  }

  // ===== 治理开关（乐观更新，失败回滚；disabled 已锁普通成员，这里仍防御） =====

  function handleJoinApproveChange(event: any): void {
    const se = event as UniSwitchChangeEvent;
    const next = se.detail.value;
    apiImGroupSetJoinApprove(convId.value, next)
      .then((res) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          joinApprove.value = next;
        } else {
          joinApprove.value = !next;
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
      })
      .catch((_e: any | null) => {
        joinApprove.value = !next;
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
  }

  function handleAllowInviteChange(event: any): void {
    const se = event as UniSwitchChangeEvent;
    const next = se.detail.value;
    apiImGroupSetAllowInvite(convId.value, next)
      .then((res) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          allowInvite.value = next;
        } else {
          allowInvite.value = !next;
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
      })
      .catch((_e: any | null) => {
        allowInvite.value = !next;
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
  }

  function handleAllowPinChange(event: any): void {
    const se = event as UniSwitchChangeEvent;
    const next = se.detail.value;
    apiImGroupSetAllowPin(convId.value, next)
      .then((res) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          allowPin.value = next;
        } else {
          allowPin.value = !next;
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
      })
      .catch((_e: any | null) => {
        allowPin.value = !next;
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
  }

  function handleReadReceiptChange(event: any): void {
    const se = event as UniSwitchChangeEvent;
    const next = se.detail.value;
    apiImGroupSetReadReceipt(convId.value, next)
      .then((res) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          readReceipt.value = next;
        } else {
          readReceipt.value = !next;
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
      })
      .catch((_e: any | null) => {
        readReceipt.value = !next;
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
  }

  // ===== 禁言管理 =====

  /**
   * 全员禁言开/关。
   *
   * ★乐观更新 + 失败回滚：switch 被点后视觉上已经翻过去了，请求失败必须翻回来，
   *   否则用户以为群已禁言、其实一条都没拦住。
   * ★muteBusy 期间开关置灰：连点会发出 `{muteAll:true}` 与 `{muteAll:false}` 两个
   *   并发请求，落库顺序不确定 —— 最终状态可能与用户看到的相反。
   */
  function handleMuteAllChange(event: any): void {
    if (muteBusy.value) {
      return;
    }
    const se = event as UniSwitchChangeEvent;
    const next = se.detail.value;
    if (convId.value.length == 0) {
      muteAll.value = !next;
      return;
    }
    muteBusy.value = true;
    // ★先把值改过去再发请求（真乐观更新）：失败回滚时 `muteAll.value = !next` 才是一次
    //   真实的变更、能触发重渲染把原生开关翻回来。若等回包才赋值，失败路径上 ref
    //   从未变过 ⇒ Vue 不重渲染 ⇒ 开关停在「已开启」而服务端根本没开。
    muteAll.value = next;
    apiImGroupMuteAll(convId.value, next)
      .then((res) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          // 服务端可能回 muteAllChanged=false（本来就是目标状态、没写库），仍是成功
          muteAll.value = next;
        } else {
          muteAll.value = !next;
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
        muteBusy.value = false;
      })
      .catch((_e: any | null) => {
        muteAll.value = !next;
        muteBusy.value = false;
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
      });
  }

  // ===== 群头像 =====

  /**
   * 上传选中的图片并写进会话头像。
   * ★必须排在 handleChangeAvatar **之前**：UTS 编 Kotlin 时同级函数不许前向引用
   *   （报 error18「找不到名称」）。
   */
  async function uploadGroupAvatar(localPath: string, displayName: string): Promise<void> {
    avatarUploading.value = true;
    uni.showLoading({ title: t("Mobile.Common.loading") });
    try {
      const uid = `group-avatar-${Date.now()}-${Math.floor(Math.random() * 100000)}`;
      const up = await uploadSingleFile(localPath, uid, null, displayName);
      // ★先落局部变量再做判空：UTS→Kotlin 不对可空成员属性做 smart cast，
      //   直接在 `up.file!.url` 上取值编不过（chat.uvue 上传链路同款写法）
      if (up.success != true || up.file == null) {
        const errText = up.error != null ? `${up.error}` : "";
        uni.showToast({
          title: errText.length > 0 ? errText : t("Mobile.Common.operationFailed"),
          icon: "none",
        });
        return;
      }
      const file = up.file;
      if (file.url.length == 0) {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        return;
      }
      const url = file.url;
      const res = await apiImGroupSetAvatar(convId.value, url);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: apiResMessage(res), icon: "none" });
        return;
      }
      // 服务端可能把 URL 规范化（加域名前缀等），以写入值为准展示；这里直接用上传返回的地址
      applyAvatar(url);
      uni.showToast({ title: t("Mobile.Profile.saveSuccess"), icon: "none" });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    } finally {
      uni.hideLoading();
      avatarUploading.value = false;
    }
  }

  /**
   * 更换群头像：选图 → /api/file/upload 直传 → PUT 会话 avatar。
   *
   * ★只传 URL，不在这里压缩：uni.chooseImage 的 sizeType=compressed 已经压过一次，
   *   头像再自己压一遍对清晰度损失更大。
   * ★上传成功但写会话失败时，图已经进对象存储（孤儿文件）—— 不做清理，
   *   对象存储的临时桶本来就会过期回收，为此多写一套删除逻辑不划算。
   */
  function handleChangeAvatar(): void {
    if (avatarUploading.value || convId.value.length == 0) {
      return;
    }
    uni.chooseImage({
      count: 1,
      sizeType: ["compressed"],
      sourceType: ["album", "camera"],
      success: (res) => {
        const paths = res.tempFilePaths;
        if (paths.length == 0) {
          return;
        }
        const localPath = paths[0];
        const segs = localPath.split("/");
        const lastSegment = segs.length > 0 ? segs[segs.length - 1] : "";
        // 扩展名兜底 .jpg：Android 的 content:// 末段常没有扩展名，
        // uploadSingleFile 会按 displayFileName 的扩展名补上（否则服务端判成 octet-stream）
        const displayName = lastSegment.indexOf(".") > 0
          ? lastSegment
          : `group-avatar-${Date.now()}.jpg`;
        uploadGroupAvatar(localPath, displayName);
      },
      // 用户取消选图：静默（系统弹窗关掉就关掉，不该弹「失败」）
      fail: (_err: any) => {},
    });
  }

  // ===== 解散群聊（仅群主，二次确认红色弹窗） =====
  async function disbandGroup(): Promise<void> {
    disbanding.value = true;
    try {
      const res = await apiImGroupDisband(convId.value);
      if (apiResCode(res) == SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.dissolveGroupSuccess"), icon: "none" });
        // 群不复存在：切回消息 tab（清掉底下的群信息页/聊天页栈）
        setTimeout(() => {
          switchMainTab({ url: "/pages/message/message" });
        }, 400);
      } else {
        uni.showToast({ title: apiResMessage(res), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
    disbanding.value = false;
  }

  // ===== 紧凑确认弹窗（confirm-modal）=====
  const confirmModalRef = ref<any | null>(null);

  function handleDisbandTap(): void {
    if (disbanding.value) {
      return;
    }
    const nameParams = new Map<string, string | number>();
    nameParams.set("name", nameDraft.value);
    const tipParams = new Map<string, string | number>();
    tipParams.set("count", memberCount.value);
    const proxy = confirmModalRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(
      "open",
      translateFn("Mobile.Message.dissolveGroupTitle", toI18nParams(nameParams), t("Mobile.Message.dissolveGroupConfirm")),
      translateFn("Mobile.Message.dissolveGroupTip", toI18nParams(tipParams), ""),
      t("Mobile.Message.dissolveGroupConfirm"),
    );
  }


  function handleBack(): void {
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      switchMainTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    loadAll();
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架 ===== */
  .gs-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #f6f5fb;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  .gs-header {
    flex-shrink: 0;
    height: 54px;
    padding: 0 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(250, 249, 253, 0.92);
    border-bottom: 1px solid rgba(81, 71, 255, 0.1);
  }

  .gs-header__btn {
    width: 36px;
    height: 36px;
    border-radius: 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gs-header__btn--active {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .gs-header__btn--ghost {
    background-color: rgba(0, 0, 0, 0);
  }

  /* 标题区：主标题 + 说明副标题（普通成员进页时显示「仅群主和管理员可修改」）。
     ★必须是 column：副标题要挂在标题下面，row 会把两行并排放 */
  .gs-header__title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .gs-header__title {
    font-size: 16.5px;
    line-height: 23px;
    font-weight: 600;
    color: #17171a;
  }

  .gs-header__subtitle {
    font-size: 11px;
    line-height: 15px;
    color: #9a98a5;
  }

  .gs-body {
    flex: 1;
    min-height: 0;
    padding: 14px 16px;
  }

  .gs-state {
    padding: 120px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .gs-state__text {
    font-size: 14px;
    line-height: 20px;
    color: #9a98a5;
  }

  .gs-list {
    display: flex;
    flex-direction: column;
  }

  .gs-card {
    margin-bottom: 12px;
    padding: 0 14px;
    background-color: #ffffff;
    border: 1px solid #ecebf1;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
  }

  /* 已解散横幅：灰字居中，占一格卡片位 */
  .gs-disbanded-tip {
    padding: 13px 0;
    align-items: center;
    justify-content: center;
  }

  .gs-disbanded-tip__text {
    font-size: 14px;
    color: #8a8a8a;
  }

  /* ===== 群名编辑 ===== */
  .gs-sec-head {
    padding-top: 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .gs-sec-title {
    flex: 1;
    min-width: 0;
    font-size: 13px;
    line-height: 18px;
    color: #9a98a5;
  }

  .gs-save {
    padding: 4px 10px;
    border-radius: 12px;
    background-color: rgba(81, 71, 255, 0.08);
  }

  .gs-save--active {
    background-color: rgba(81, 71, 255, 0.16);
  }

  .gs-save__text {
    font-size: 12.5px;
    line-height: 18px;
    font-weight: 600;
    color: #5147ff;
  }

  .gs-name-input {
    height: 46px;
    padding: 0;
    font-size: 15px;
    line-height: 21px;
    color: #22212a;
  }

  /* 团队群：群名只读展示（资料跟随平台，没有输入框可用） */
  .gs-team-name {
    padding: 10px 0 2px;
    font-size: 15px;
    line-height: 21px;
    color: #6b6976;
  }

  /* ===== 群头像 ===== */
  .gs-avatar-row {
    padding: 10px 0 2px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  /* 定尺寸容器：字母底与真图都在里面绝对定位叠放 */
  .gs-avatar-wrap {
    position: relative;
    width: 56px;
    height: 56px;
  }

  .gs-avatar {
    width: 56px;
    height: 56px;
    border-radius: 14px;
  }

  .gs-avatar-wrap--clip {
    border-radius: 14px;
    overflow: hidden;
  }

  /* 字母底：鸿蒙仅无头像/失败时可见，其余端保持原来的加载兜底。 */
  .gs-avatar--letter {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .gs-avatar__letter {
    font-size: 22px;
    line-height: 30px;
    font-weight: 600;
    color: #ffffff;
  }

  /* 真图盖在字母底上（后建的节点天然在上，无需 z-index） */
  .gs-avatar--img {
    position: absolute;
    top: 0;
    left: 0;
  }

  /* ===== 说明文案 =====
     ★灰字说明（开关/头像/团队群只读）：与主文案 12px 对比，做「次级信息」的层级。
       line-height 17 保证两行文案不粘在一起 */
  .gs-desc {
    padding: 0 0 10px;
    font-size: 12px;
    line-height: 17px;
    color: #9a98a5;
  }

  .gs-desc--last {
    padding-bottom: 12px;
  }

  /* ===== 通用 cell ===== */
  .gs-cell {
    min-height: 52px;
    padding: 8px 0;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  /* 带说明的双行 cell：左列（标题 + 说明）撑满，右侧跟 switch / 值 */
  .gs-cell--stack {
    min-height: 62px;
    padding: 10px 0;
  }

  .gs-cell__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .gs-cell--active {
    background-color: #f7f6fb;
  }

  .gs-cell__label {
    flex-shrink: 0;
    font-size: 14.5px;
    line-height: 20px;
    color: #22212a;
  }

  .gs-cell__desc {
    margin-top: 2px;
    font-size: 12px;
    line-height: 17px;
    color: #9a98a5;
  }

  .gs-cell__value {
    font-size: 13px;
    line-height: 18px;
    color: #6b6976;
  }

  .gs-copy {
    width: 28px;
    height: 28px;
    margin-left: 6px;
    border-radius: 8px;
    background-color: rgba(81, 71, 255, 0.08);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gs-divider {
    height: 1px;
    background-color: #f1f0f6;
  }

  .gs-switch {
    flex-shrink: 0;
    transform: scale(0.9);
  }

  /* ===== 解散群聊 ===== */
  .gs-disband {
    padding: 13px 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .gs-disband--active {
    opacity: 0.7;
  }

  .gs-disband__text {
    font-size: 15px;
    line-height: 21px;
    font-weight: 500;
    color: #ff4d4f;
  }

  .gs-tail {
    height: 20px;
  }
</style>

