<template>
  <view class="dev-page"><safety-zone />
    <text class="dev-title">{{ t("Mobile.Voip.devTitle") }}</text>
    <view v-if="development">
      <text>{{ t("Mobile.Voip.devHint") }}</text>
      <input v-model="origin" class="dev-input" placeholder="http://192.168.1.100:7890" />
      <view class="dev-row"><button @click="login('alice')">Alice</button><button @click="login('bob')">Bob</button></view>
      <text>{{ status }}</text>
      <view class="dev-row"><button @click="dial('demo-people', 'audio')">{{ t("Mobile.Voip.audio") }}</button><button @click="dial('demo-people', 'video')">{{ t("Mobile.Voip.video") }}</button></view>
      <button @click="dial('demo-agent', 'audio')">{{ t("Mobile.Voip.devAgent") }}</button>
      <button @click="openVoipPage()">{{ t("Mobile.Voip.return") }}</button>
      <button @click="logout">{{ t("Mobile.Voip.devDisconnect") }}</button>
    </view>
    <button @click="back">{{ t("Mobile.Voip.close") }}</button>
  </view>
</template>
<script setup lang="uts">
  import { ref } from "vue";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  import { loginVoipDev, setVoipDevSession } from "@/servers/voip";
  import { bootstrapVoip, clearVoipSession, startVoipCall, openVoipPage as openCallPage } from "@/utils/voip/callManager";
  const development = process.env.NODE_ENV == "development";
  const origin = ref("http://127.0.0.1:7890"), status = ref("");
  async function login(user: string): Promise<void> {
    if (!development) return;
    clearVoipSession();
    try { await loginVoipDev(origin.value, user); await bootstrapVoip(); status.value = user; }
    catch (_e) { status.value = t("Mobile.Voip.devUnavailable"); }
  }
  function dial(conv: string, mode: string): void { if (development) startVoipCall(conv, mode); }
  function openVoipPage(): void { openCallPage(); }
  function logout(): void { clearVoipSession(); setVoipDevSession(null); status.value = ""; }
  function back(): void { uni.navigateBack(); }
</script>
<style scoped>
  .dev-page { flex: 1; padding: 20px; background-color: #f5f6fa; }
  .dev-title { font-size: 23px; margin-bottom: 20px; }.dev-row { flex-direction: row; margin-top: 18px; }
  .dev-input { height: 48px; background-color: #ffffff; padding: 8px; margin-top: 18px; margin-bottom: 18px; }
</style>
