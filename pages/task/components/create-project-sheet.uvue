<template>
  <uni-modal-popup
    ref="popupRef"
    position="bottom"
    :height="sheetHeight"
    :show-header="false"
    :body-scroll="false"
    :enable-swipe-close="true"
    @afterleave="handleAfterLeave"
  >
    <view class="project-sheet">
      <view class="project-sheet__header">
        <text class="project-sheet__title">{{ t(titleKey) }}</text>
        <view class="project-sheet__close" @click="close">
          <svg-icon name="icon-X" size="36" color="#8a8a8a" />
        </view>
      </view>

      <text class="project-sheet__label">{{ t(nameLabelKey) }}</text>
      <input
        v-model="projectName"
        class="project-sheet__input"
        :placeholder="t(namePlaceholderKey)"
        placeholder-class="project-sheet__placeholder"
      />

      <template v-if="showRuntime">
        <text class="project-sheet__label">{{ t("Mobile.CreateHub.runtimeEnvironment") }}</text>
        <view class="project-sheet__select">
          <text class="project-sheet__select-text">{{ t("Mobile.CreateHub.cloudComputer") }}</text>
          <svg-icon name="icon-a-Chevrondown" size="28" color="#8a8a8a" />
        </view>
      </template>

      <text class="project-sheet__label">{{ t("Mobile.CreateHub.workspace") }}</text>
      <view class="project-sheet__select">
        <text class="project-sheet__select-text">{{ t("Mobile.CreateHub.defaultWorkspace") }}</text>
        <svg-icon name="icon-a-Chevrondown" size="28" color="#8a8a8a" />
      </view>

      <view class="project-sheet__actions">
        <view class="project-sheet__button project-sheet__button--cancel" @click="close">
          <text class="project-sheet__button-text project-sheet__button-text--cancel">{{
            t("Mobile.Common.cancel")
          }}</text>
        </view>
        <view class="project-sheet__button project-sheet__button--primary" @click="handleCreate">
          <text class="project-sheet__button-text project-sheet__button-text--primary">{{
            t(submitKey)
          }}</text>
        </view>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { computed, onUnmounted, ref, type ComponentPublicInstance } from "vue";
  import { emptyI18nParams, useI18n } from "@/utils/i18n";

  const emit = defineEmits<{
    create: [payload: UTSJSONObject];
  }>();

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  /** 弹窗类型：standard = 常规项目，web = 网页应用，fullstack = 全栈项目 */
  type ProjectSheetType = "standard" | "web" | "fullstack";

  const popupRef = ref<any | null>(null);
  const sheetType = ref<ProjectSheetType>("standard");
  const projectName = ref<string>("");
  const tabBarHiddenBySheet = ref<boolean>(false);

  /** 仅常规项目需要选择运行环境 */
  const showRuntime = computed((): boolean => {
    return sheetType.value == "standard";
  });

  const sheetHeight = computed((): string => {
    return showRuntime.value ? "720rpx" : "600rpx";
  });

  const titleKey = computed((): string => {
    if (sheetType.value == "web") {
      return "Mobile.CreateHub.createWebApp";
    }
    if (sheetType.value == "fullstack") {
      return "Mobile.CreateHub.createFullstackProject";
    }
    return "Mobile.CreateHub.createStandardProject";
  });

  const nameLabelKey = computed((): string => {
    return sheetType.value == "web"
      ? "Mobile.CreateHub.appName"
      : "Mobile.CreateHub.projectName";
  });

  const namePlaceholderKey = computed((): string => {
    return sheetType.value == "web"
      ? "Mobile.CreateHub.appNamePlaceholder"
      : "Mobile.CreateHub.projectNamePlaceholder";
  });

  const submitKey = computed((): string => {
    return sheetType.value == "web"
      ? "Mobile.CreateHub.createApp"
      : "Mobile.CreateHub.createProject";
  });

  const nameRequiredKey = computed((): string => {
    return sheetType.value == "web"
      ? "Mobile.CreateHub.appNameRequired"
      : "Mobile.CreateHub.projectNameRequired";
  });

  function callPopupMethod(methodName: string): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(methodName);
  }

  /**
   * 打开新建弹窗。
   * @param type standard = 常规项目，web = 网页应用，fullstack = 全栈项目
   */
  function open(type: string): void {
    if (type == "web") {
      sheetType.value = "web";
    } else if (type == "fullstack") {
      sheetType.value = "fullstack";
    } else {
      sheetType.value = "standard";
    }
    projectName.value = "";
    // 系统 TabBar 是独立原生层，页面内弹窗无法用 z-index 覆盖，先隐藏、关闭时恢复
    tabBarHiddenBySheet.value = true;
    uni.hideTabBar({
      animation: false,
      complete: () => {
        callPopupMethod("open");
      },
    });
  }

  /** 关闭新建弹窗。 */
  function close(): void {
    callPopupMethod("close");
  }

  function restoreTabBar(): void {
    if (tabBarHiddenBySheet.value != true) {
      return;
    }
    tabBarHiddenBySheet.value = false;
    uni.showTabBar({
      animation: false,
    });
  }

  function handleAfterLeave(): void {
    restoreTabBar();
  }

  function handleCreate(): void {
    const name = projectName.value.trim();
    if (name.length == 0) {
      uni.showToast({
        title: t(nameRequiredKey.value),
        icon: "none",
      });
      return;
    }
    const payload = {} as UTSJSONObject;
    payload["type"] = sheetType.value;
    payload["name"] = name;
    emit("create", payload);
  }

  defineExpose({
    open: open as any,
    close: close as any,
  });

  onUnmounted(() => {
    restoreTabBar();
  });
</script>

<style lang="scss" scoped>
  .project-sheet {
    width: 100%;
    height: 100%;
    padding: 32rpx 32rpx 24rpx;
    background-color: #ffffff;
    border-radius: 32rpx 32rpx 0 0;
    box-sizing: border-box;
  }

  .project-sheet__header {
    height: 52rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .project-sheet__title {
    color: #111111;
    font-size: 32rpx;
    line-height: 44rpx;
    font-weight: 600;
  }

  .project-sheet__close {
    width: 56rpx;
    height: 56rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .project-sheet__label {
    margin-top: 24rpx;
    color: #8a8a8a;
    font-size: 24rpx;
    line-height: 34rpx;
  }

  .project-sheet__input,
  .project-sheet__select {
    width: 100%;
    height: 80rpx;
    margin-top: 8rpx;
    padding: 0 24rpx;
    border-radius: 20rpx;
    background-color: #f6f5f8;
    box-sizing: border-box;
  }

  .project-sheet__input {
    border: 2rpx solid #d1ccff;
    color: #161616;
    font-size: 28rpx;
  }

  .project-sheet__placeholder {
    color: #b7b7be;
  }

  .project-sheet__select {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .project-sheet__select-text {
    color: #333333;
    font-size: 28rpx;
    line-height: 40rpx;
  }

  .project-sheet__actions {
    margin-top: 28rpx;
    display: flex;
    flex-direction: row;
  }

  .project-sheet__button {
    flex: 1;
    height: 88rpx;
    border-radius: 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .project-sheet__button--cancel {
    margin-right: 12rpx;
    background-color: #f2f1f7;
  }

  .project-sheet__button--primary {
    margin-left: 12rpx;
    background-color: #5147ff;
  }

  .project-sheet__button-text {
    font-size: 30rpx;
    line-height: 42rpx;
    font-weight: 600;
  }

  .project-sheet__button-text--cancel {
    color: #4b4b52;
  }

  .project-sheet__button-text--primary {
    color: #ffffff;
  }
</style>
