/** Only observations made by this device; the native store is separated by origin and account. */
export class VoipHistoryRecord {
  callId: string = "";
  convId: string = "";
  peerName: string = "";
  direction: string = "";
  mediaType: string = "audio";
  startedAt: number = 0;
  connectedAt: number = 0;
  endedAt: number = 0;
  reason: string = "";
  missed: boolean = false;
}

export function parseVoipHistory(values: UTSJSONObject[]): VoipHistoryRecord[] {
  const records: VoipHistoryRecord[] = [];
  const seen: string[] = [];
  for (let i = 0; i < Math.min(values.length, 100); i++) {
    const value = values[i];
    const row = new VoipHistoryRecord();
    row.callId = `${value["callId"] ?? ""}`;
    row.convId = `${value["convId"] ?? ""}`;
    row.direction = `${value["direction"] ?? ""}`;
    row.mediaType = `${value["mediaType"] ?? ""}`;
    row.startedAt = parseFloat(`${value["startedAt"] ?? 0}`);
    row.connectedAt = parseFloat(`${value["connectedAt"] ?? 0}`);
    row.endedAt = parseFloat(`${value["endedAt"] ?? 0}`);
    if (!/^[A-Za-z0-9_-]{1,128}$/.test(row.callId) || !/^[A-Za-z0-9_-]{1,128}$/.test(row.convId) || seen.indexOf(row.callId) >= 0) continue;
    if ((row.direction != "incoming" && row.direction != "outgoing") || (row.mediaType != "audio" && row.mediaType != "video")) continue;
    if (!Number.isFinite(row.startedAt) || !Number.isFinite(row.connectedAt) || !Number.isFinite(row.endedAt) || row.startedAt < 0 || row.connectedAt < 0 || row.endedAt < 0) continue;
    row.peerName = `${value["peerName"] ?? ""}`.slice(0, 80);
    row.reason = `${value["reason"] ?? ""}`;
    row.missed = value["missed"] === true;
    seen.push(row.callId); records.push(row);
  }
  return records;
}
