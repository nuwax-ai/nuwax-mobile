/**
 * ESP Provisioning 客户端注入点。
 *
 * 当前阶段不绑定未完成的固件协议。Android 原生插件、Mock 和后续平台实现
 * 通过 registerEspProvisioningClientProvider 注入同一业务契约。
 */
import type { EspProvisioningClient } from '@/utils/provisioning/espProvisioningClient';

export type EspProvisioningClientProvider = () => EspProvisioningClient;

let registeredProvider: EspProvisioningClientProvider | null = null;

/** 注册平台或 Mock 客户端；应用启动或配网模块初始化时调用一次。 */
export function registerEspProvisioningClientProvider(provider: EspProvisioningClientProvider): void {
  registeredProvider = provider;
}

/** 是否已有可用实现，页面可据此隐藏尚未开放的正式入口。 */
export function hasEspProvisioningClientProvider(): boolean {
  return registeredProvider != null;
}

/** 创建一次配网会话专属客户端，禁止跨会话复用已 dispose 的实例。 */
export function createEspProvisioningClient(): EspProvisioningClient {
  if (registeredProvider == null) {
    throw new Error('ESP_PROVISIONING_CLIENT_NOT_REGISTERED');
  }
  return registeredProvider!!();
}

/** 测试及热切换 Mock 时使用；生产流程一般无需调用。 */
export function clearEspProvisioningClientProvider(): void {
  registeredProvider = null;
}
