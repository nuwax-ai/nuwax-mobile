import { ref } from "vue";

/** 下拉背层使用的轻量消息快照；正式会话仍由 chat.uvue 渲染完整消息模型。 */
export class PullAgentPreviewMessage {
  text: string = "";
  fromAgent: boolean = false;
}

/** 预览层（会话页样式）的标题与最近几条消息。模块级：tab-shell 常驻，跨页存活。 */
export const pullAgentPreviewName = ref<string>("");
export const pullAgentPreviewMessages = ref<PullAgentPreviewMessage[]>([]);

/** 下拉入口打开的会话页在关闭前广播此事件：伙伴页合成层要在此之前复位，
 *  这样会话页滑出时下层露出的就是正常伙伴页，而不是提交态（整页在屏幕外/透明）。
 *  事件名带 im 前缀，避免与业务事件冲突。 */
export const PULL_AGENT_CLOSE_EVENT = "im:pull-agent-close";

/** 清空预览快照（切换账号/退出登录时调用，避免下一个账号看到上一个账号的消息）。 */
export function resetPullAgentPreview(): void {
  pullAgentPreviewName.value = "";
  pullAgentPreviewMessages.value = [];
}
