/** 代码流式快通道的真实渲染段类型。 */
export const CODE_STREAM_SEGMENT_PROSE = "prose";
export const CODE_STREAM_SEGMENT_CODE = "code";

export class CodeStreamSegment {
  kind: string = CODE_STREAM_SEGMENT_PROSE;
  text: string = "";
  language: string = "text";
  closed: boolean = true;
  key: string = "";
}

function appendCodeStreamSegment(
  out: CodeStreamSegment[],
  kind: string,
  text: string,
  language: string,
  closed: boolean,
  force: boolean,
): void {
  if (text.length == 0 && force != true) {
    return;
  }
  const segment = new CodeStreamSegment();
  segment.kind = kind;
  segment.text = text;
  segment.language = language.length > 0 ? language : "text";
  segment.closed = closed;
  segment.key = `code-stream-${kind}-${out.length}`;
  out.push(segment);
}

/**
 * 只识别真实代码围栏，不承担完整 Markdown 解析。
 * 流式阶段正文用原生 text、代码用 UniAiMsgCode 原始文本模式；终态仍由完整 Markdown 定稿。
 */
export function parseCodeStreamSegments(body: string): CodeStreamSegment[] {
  const out = [] as CodeStreamSegment[];
  const lines = body.split("\n");
  let buffer = [] as string[];
  let inCode = false;
  let language = "text";

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const trimmed = line.trim();
    if (inCode != true && trimmed.startsWith("```")) {
      appendCodeStreamSegment(
        out,
        CODE_STREAM_SEGMENT_PROSE,
        buffer.join("\n"),
        "text",
        true,
        false,
      );
      buffer = [] as string[];
      inCode = true;
      const rawLanguage = trimmed.substring(3).trim();
      language = rawLanguage.length > 0 ? rawLanguage : "text";
      continue;
    }
    if (inCode == true && trimmed.startsWith("```")) {
      appendCodeStreamSegment(
        out,
        CODE_STREAM_SEGMENT_CODE,
        buffer.join("\n"),
        language,
        true,
        true,
      );
      buffer = [] as string[];
      inCode = false;
      language = "text";
      continue;
    }
    buffer.push(line);
  }

  appendCodeStreamSegment(
    out,
    inCode == true ? CODE_STREAM_SEGMENT_CODE : CODE_STREAM_SEGMENT_PROSE,
    buffer.join("\n"),
    language,
    inCode != true,
    inCode == true,
  );
  return out;
}
