<template>
  <view class="home-chat-input">
    <view v-if="!hasPermissionVal" class="permission-mask">
      <text class="permission-text">{{ t("Mobile.Chat.noAgentPermission") }}</text>
    </view>

    <textarea
      class="message-input"
      placeholder-class="message-placeholder"
      placeholder="发消息"
      :value="messageInfo"
      :focus="isInputFocused"
      :auto-height="true"
      :maxlength="-1"
      :show-confirm-bar="false"
      :disable-default-padding="true"
      @input="handleInput"
      @focus="isInputFocused = true"
      @blur="isInputFocused = false"
      @confirm="handleSendMessage"
    />

    <view class="actions-row">
      <manual-component-item
        v-if="showManualComponent"
        class="options"
        :manual-components="manualComponents"
        :selected-components="selectedComponents"
        :is-task-agent="isTaskAgent"
        :sandbox-list="sandboxList"
        :current-sandbox-id="currentSandboxId"
        :is-sandbox-switch-disabled="isSandboxSwitchDisabled"
        :is-sandbox-unavailable="isSandboxUnavailable"
        :sandbox-disabled-text="sandboxDisabledText"
        :readonly="readonly"
        :allow-other-model="allowOtherModel"
        :current-model-id="currentModelId"
        :current-model-name="currentModelName"
        :agent-id="agentId"
        :agent-type="agentType"
        :current-agent-mode="agentMode"
        :allow-choose-mode="allowChooseMode"
        @onSelectComponent="handleToggleSelectComponent"
        @onAgentModeChange="handleAgentModeChange"
        @onSandboxChange="handleSandboxChange"
        @onModelChange="handleModelChange"
      />
      <view v-else class="options-placeholder" />
      <view
        class="send-button"
        :class="{ 'send-button--active': canSend }"
        @click.stop.prevent="handleSendMessage"
      >
        <svg-icon name="icon-send" size="48" customClass="send-icon" />
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, watch } from "vue";
  import ManualComponentItem from "@/subpackages/components/chat-input-phone/manual-component-item/manual-component-item.uvue";
  import { AgentManualComponentInfo, AgentSelectedComponentInfo } from "@/types/interfaces/agent";
  import { DefaultSelectedEnum } from "@/types/enums/agent";
  import { SandboxInfo } from "@/types/interfaces/sandbox";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import { readAgentModeCache, writeAgentModeCache, type AgentMode } from "@/subpackages/utils/agentModeCache.uts";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
  const messageInfo = ref("");
  const isInputFocused = ref(false);
  const selectedComponents = ref<AgentSelectedComponentInfo[]>([]);
  const agentMode = ref<AgentMode>("yolo");

  const props = withDefaults(defineProps<{
    manualComponents?: AgentManualComponentInfo[];
    defaultSelectedComponents?: AgentSelectedComponentInfo[];
    isTaskAgent?: boolean;
    sandboxList?: SandboxInfo[];
    currentSandboxId?: string;
    isSandboxSwitchDisabled?: boolean;
    isSandboxUnavailable?: boolean;
    sandboxDisabledText?: string;
    hasPermission?: boolean;
    readonly?: boolean;
    allowOtherModel?: boolean;
    currentModelId?: number;
    currentModelName?: string;
    agentId?: number;
    agentType?: string;
    allowChooseMode?: number;
    wholeDisabled?: boolean;
  }>(), {
    manualComponents: () => [], defaultSelectedComponents: () => [], isTaskAgent: false,
    sandboxList: () => [], currentSandboxId: "", isSandboxSwitchDisabled: false,
    isSandboxUnavailable: false, sandboxDisabledText: "", hasPermission: true,
    readonly: false, allowOtherModel: false, currentModelId: 0, currentModelName: "",
    agentId: 0, agentType: "ChatBot", allowChooseMode: 0, wholeDisabled: false,
  });
  const emit = defineEmits<{
    (e: "onSendMessage", data: any): void;
    (e: "onSandboxChange", sandboxId: string): void;
    (e: "onModelChange", modelId: number, name: string): void;
  }>();

  const hasPermissionVal = computed((): boolean => props.hasPermission == true);
  const canSend = computed((): boolean => messageInfo.value.trim().length > 0 && props.wholeDisabled != true);
  const showManualComponent = computed((): boolean =>
    props.manualComponents.length > 0 || props.isTaskAgent || props.allowOtherModel || props.allowChooseMode == 1,
  );

  const syncSelectedComponents = (items: AgentSelectedComponentInfo[] | null): void => {
    if (items != null) {
      selectedComponents.value = items;
      return;
    }
    const defaults: AgentSelectedComponentInfo[] = [];
    for (let i = 0; i < props.manualComponents.length; i++) {
      const item = props.manualComponents[i];
      if (item.defaultSelected == DefaultSelectedEnum.Yes) defaults.push(new AgentSelectedComponentInfo(item.id, item.type));
    }
    selectedComponents.value = defaults;
  };
  watch((): AgentSelectedComponentInfo[] => props.defaultSelectedComponents, syncSelectedComponents, { immediate: true, deep: true });
  watch((): number => props.agentId, (): void => {
    const cached = readAgentModeCache(props.agentId);
    agentMode.value = cached == "ask" || cached == "yolo" ? cached : "ask";
  }, { immediate: true });

  const handleInput = (event: UniInputEvent): void => { messageInfo.value = `${event.detail.value as string | null ?? ""}`; };
  const handleToggleSelectComponent = (item: AgentSelectedComponentInfo): void => {
    const next: AgentSelectedComponentInfo[] = [];
    let selected = false;
    for (let i = 0; i < selectedComponents.value.length; i++) {
      const current = selectedComponents.value[i];
      if (current.id == item.id) selected = true; else next.push(current);
    }
    if (!selected) next.push(item);
    selectedComponents.value = next;
  };
  const handleAgentModeChange = (mode: AgentMode): void => { agentMode.value = mode; writeAgentModeCache(mode, props.agentId); };
  const handleSandboxChange = (sandboxId: string): void => emit("onSandboxChange", sandboxId);
  const handleModelChange = (id: number, name: string): void => emit("onModelChange", id, name);
  const handleSendMessage = (): void => {
    if (props.wholeDisabled == true) return;
    const message = messageInfo.value.trim();
    if (message.length == 0) return;
    const payload = new UTSJSONObject();
    payload["messageInfo"] = message;
    payload["files"] = [] as UTSJSONObject[];
    payload["skillIds"] = [] as number[];
    payload["selectedComponents"] = selectedComponents.value;
    if (props.isTaskAgent == true) {
      payload["agentMode"] = props.allowChooseMode == 1 ? agentMode.value : "yolo";
    }
    emit("onSendMessage", payload);
    messageInfo.value = "";
  };
</script>

<style lang="scss" scoped>
  .home-chat-input {
    position: relative;
    padding: 32rpx;
    box-sizing: border-box;
    background: #fff;
    border: 2rpx solid #f0f0f0;
    border-radius: 48rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  }

  .message-input {
    width: 100%;
    min-height: 52rpx;
    max-height: 264rpx;
    padding: 0;
    box-sizing: border-box;
    color: #1e1e1e;
    font-size: 32rpx;
    line-height: 52rpx;
  }

  .message-placeholder { color: #b7b7b7; font-size: 32rpx; }
  .actions-row { display: flex; flex-direction: row; align-items: center; min-height: 76rpx; margin-top: 40rpx; }
  .options { flex: 1; min-width: 0; overflow: hidden; }
  .options-placeholder { flex: 1; }
  .send-button { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-left: 16rpx; opacity: .35; }
  .send-button--active { opacity: 1; }
  .send-icon { color: #5147ff; }

  .permission-mask {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.76);
    border-radius: 48rpx;
  }

  .permission-text { color: #999; font-size: 28rpx; }
</style>
