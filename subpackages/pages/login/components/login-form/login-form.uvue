<template>
  <!-- #ifdef APP -->
  <view class="login-form-root" style="background-color: transparent; width: 100%;">
    <view class="container">
  <!-- #endif -->
  <!-- #ifndef APP -->
  <view class="container">
  <!-- #endif -->
    <!-- 分段器组件 -->
    <segmented-control
      :options="loginOptions"
      v-model="currentLoginType"
      @change="handleLoginTypeChange"
      class="login-segmented"
      variant="line"
    />
    <view class="login-fields">
      <view class="phone-input-wrapper" v-if="isCaptchaVerify" :style="fieldBgStyle">
        <view class="country-code" v-if="!isTenantEmailAuth">
          <text class="country-code-text">{{ t("Mobile.Auth.defaultAreaCode") }}</text>
          <svg-icon name="icon-a-Chevrondown" :size="28" />
        </view>
        <input
          v-if="isTenantEmailAuth"
          class="phone-input"
          :style="inputBgStyle"
          type="text"
          :placeholder="t('Mobile.Auth.inputEmail')"
          placeholder-class="login-input-placeholder"
          placeholder-style="color: #b9bbc5; font-size: 30rpx; font-weight: 400;"
          v-model="emailNumber"
          cursor-color="#5147FF"
        />
        <input
          v-else
          class="phone-input"
          :style="inputBgStyle"
          type="number"
          :placeholder="t('Mobile.Auth.inputPhone')"
          placeholder-class="login-input-placeholder"
          placeholder-style="color: #b9bbc5; font-size: 30rpx; font-weight: 400;"
          v-model="phoneNumber"
          cursor-color="#5147FF"
        />
        <view
          class="clear-btn"
          v-if="verificationTarget.length > 0"
          @click="clearVerificationTarget"
        >
          <svg-icon name="icon-a-Xcircle-fill" :size="32" customClass="clear-icon" />
        </view>
      </view>

      <view v-if="isCaptchaVerify" class="verify-code-row">
        <view class="verify-code-input-wrap">
          <input
            class="verify-code-input"
            type="number"
            maxlength="6"
            v-model="verifyCode"
            :placeholder="t('Mobile.Auth.inputVerifyCode')"
            placeholder-class="login-input-placeholder"
            placeholder-style="color: #b9bbc5; font-size: 30rpx; font-weight: 400;"
            cursor-color="#5147FF"
          />
        </view>
        <button
          class="get-code-btn"
          :class="{ 'get-code-disabled': !canSendCode }"
          :disabled="!canSendCode"
          :loading="loading"
          @click="handleGetCode"
        >{{ getCodeButtonText }}</button>
      </view>

      <view v-else class="account-fields">
        <view class="phone-input-wrapper" :style="fieldBgStyle">
          <input
            class="phone-input"
            :style="inputBgStyle"
            type="text"
            :placeholder="t('Mobile.Auth.inputPhoneEmailUsername')"
            placeholder-class="login-input-placeholder"
            placeholder-style="color: #b9bbc5; font-size: 30rpx; font-weight: 400;"
            v-model="emailNumber"
            cursor-color="#5147FF"
          />
          <view class="clear-btn" v-if="emailNumber.length > 0" @click="clearEmailNumber">
            <svg-icon name="icon-a-Xcircle-fill" :size="32" customClass="clear-icon" />
          </view>
        </view>

        <view class="password-input-wrapper" :style="fieldBgStyle">
          <input
            class="password-input"
            :style="inputBgStyle"
            :password="!showPassword"
            :placeholder="t('Mobile.Auth.inputPassword')"
            placeholder-class="login-input-placeholder"
            placeholder-style="color: #b9bbc5; font-size: 30rpx; font-weight: 400;"
            v-model="password"
            cursor-color="#5147FF"
          />
          <view class="clear-btn password-clear-btn" v-if="password.length > 0" @click="clearPassword">
            <svg-icon name="icon-a-Xcircle-fill" :size="32" customClass="clear-icon" />
          </view>
          <view class="eye-btn" @tap.stop="togglePasswordVisibility">
            <svg-icon
              :name="showPassword ? 'icon-eye-open' : 'icon-eye-close'"
              :size="32"
              customClass="eye-icon"
            />
          </view>
        </view>
      </view>
    </view>

    <agreement-checkbox v-model="agreeTerms" />

    <button
      class="login-btn"
      @click="onFinish"
      :loading="isSubmitting"
      :disabled="isSubmitting"
    >{{ t("Mobile.Auth.loginOrRegister") }}</button>

    <!-- #ifdef APP-ANDROID || APP-IOS || APP-HARMONY -->
    <view
      class="enterprise-login-btn"
      :class="{ 'enterprise-login-disabled': isSubmitting }"
      @tap="handleLoginEditionSwitch"
    >
      <image class="edition-logo" :src="siteLogoVal" mode="aspectFill" />
      <text class="enterprise-login-text">{{ editionSwitchText }}</text>
    </view>
    <!-- #endif -->

    <!-- #ifdef APP-ANDROID -->
    <view v-if="showAndroidCaptcha" class="android-captcha-mask">
      <view class="android-captcha-backdrop" @click="closeAndroidCaptcha"></view>
      <web-view
        id="login-aliyun-captcha-webview"
        class="android-captcha-webview"
        :src="androidCaptchaUrl"
        @message="handleAndroidCaptchaMessage"
      ></web-view>
    </view>
    <!-- #endif -->

    <!-- #ifdef H5 || WEB-->
    <button :id="buttonId" type="button" class="captcha-button" />
    <aliyun-captcha-h5
      :config="tenantConfigInfoVal"
      :element-id="buttonId"
      @doAction="handlerSuccess"
    />
    <!-- #endif -->
  <!-- #ifdef APP -->
    </view>
  </view>
  <!-- #endif -->
  <!-- #ifndef APP -->
  </view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ref, computed, onMounted, onUnmounted } from "vue";
  import { apiLogin, apiSendCode } from "@/servers/account";
  import { LoginFieldType, SendCode } from "@/types/interfaces/login";
  import { SUCCESS_CODE, AGENT_NOT_EXIST } from "@/constants/codes.constants";
  import SegmentedControl from "@/components/segmented-control/segmented-control.uvue";
  import AgreementCheckbox from "@/components/agreement-checkbox/agreement-checkbox.uvue";
  import { redirectTo } from "@/utils/common";
  import { getApiBaseUrl } from "@/constants/config";
  import { saveAccessToken } from "@/utils/authSession";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";

  // i18n 包装：模板/脚本统一调用单参数 t(key)
  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  // App 端 input 原生层默认透明，须内联实色背景对齐 H5
  // #ifdef APP
  const inputBgStyle = "background-color: #ffffff;";
  const fieldBgStyle = "background-color: #ffffff;";
  // #endif
  // #ifndef APP
  const inputBgStyle = "";
  const fieldBgStyle = "";
  // #endif

  // 定义组件 props（可选 + 不使用 withDefaults，避免 uvue 覆盖类型不匹配）
  interface LoginFormProps {
    tenantConfigInfo?: UTSJSONObject;
    siteName?: string;
    siteLogo?: string;
    redirectUrl?: string;
    isPopup?: boolean;
    isEnterpriseDomain?: boolean;
    submitting?: boolean;
  }
  const props = defineProps<LoginFormProps>();

  const emit = defineEmits(["show-verify", "code-login", "login-success", "enterprise-login", "personal-login"]);

  /** 从租户配置中解析站点名（props 透传后 App 端方括号访问可能失效，走 JSON 往返兜底） */
  function resolveSiteName(
    siteNameProp: string | null,
    config: any | null,
  ): string {
    if (siteNameProp != null && siteNameProp.length > 0) {
      return siteNameProp;
    }
    if (config == null) return "";
    const obj = config as UTSJSONObject;
    const direct = obj["siteName"];
    if (direct != null) {
      const name = `${direct}`;
      if (name.length > 0) return name;
    }
    const jsonStr = JSON.stringify(config);
    if (jsonStr == null || jsonStr.length <= 2) return "";
    const parsed = JSON.parse<UTSJSONObject>(jsonStr);
    if (parsed == null) return "";
    const raw = parsed["siteName"];
    return raw != null ? `${raw}` : "";
  }

  /** 拼接欢迎语，避免 i18n Map 插值在 App 端失效 */
  function buildWelcomeText(siteName: string): string {
    const template = tFn(
      "Mobile.Auth.welcomeUse",
      emptyI18nParams(),
      "欢迎使用{siteName}",
    );
    const marker = "{siteName}";
    const idx = template.indexOf(marker);
    if (idx < 0) return template;
    return (
      template.substring(0, idx) +
      siteName +
      template.substring(idx + marker.length)
    );
  }

  // 默认值通过 computed 读取
  const tenantConfigInfoVal = computed((): UTSJSONObject | null => {
    return props.tenantConfigInfo != null ? props.tenantConfigInfo : null;
  });
  const siteNameVal = computed((): string => {
    const propName = props.siteName != null ? props.siteName : null;
    const config = props.tenantConfigInfo != null ? props.tenantConfigInfo : null;
    return resolveSiteName(propName, config);
  });
  const siteLogoVal = computed((): string => {
    return props.siteLogo != null && props.siteLogo.length > 0
      ? props.siteLogo
      : "/static/logo.png";
  });
  const welcomeText = computed((): string => {
    return buildWelcomeText(siteNameVal.value);
  });
  const redirectUrlVal = computed((): string => {
    return props.redirectUrl != null ? props.redirectUrl : "";
  });
  const isPopupVal = computed((): boolean => {
    return props.isPopup == true;
  });
  const isEnterpriseDomainVal = computed((): boolean => props.isEnterpriseDomain == true);
  const editionSwitchText = computed((): string => {
    return isEnterpriseDomainVal.value
      ? t("Mobile.Auth.switchPersonalLogin")
      : t("Mobile.Auth.enterpriseLogin");
  });

  const loading = ref<boolean>(false);
  const loginCompleted = ref<boolean>(false);
  const isSubmitting = computed((): boolean => {
    return loading.value || loginCompleted.value || props.submitting == true;
  });

  const handleLoginEditionSwitch = () => {
    if (isSubmitting.value) return;
    if (isEnterpriseDomainVal.value) {
      emit("personal-login");
      return;
    }
    emit("enterprise-login");
  };

  const phoneNumber = ref<string>("");
  const verifyCode = ref<string>("");
  const codeLoginCaptchaVerifyParam = ref<string>("");
  const codeCountdown = ref<number>(0);
  let codeCountdownTimer: number | null = null;
  const emailNumber = ref<string>("");
  const password = ref<string>("");
  const agreeTerms = ref<boolean>(false);
  const showPassword = ref<boolean>(false);
  const isCaptchaVerify = ref<boolean>(false);
  const getCodeButtonText = computed((): string => {
    return codeCountdown.value > 0
      ? `${codeCountdown.value}s`
      : t("Mobile.Auth.getVerificationCode");
  });
  // 阿里云验证码按钮id
  const buttonId = ref<string>("aliyun-captcha-id");
  const captchaResultEvent = "login_aliyun_captcha_result";
  let waitingCaptchaResult = false;
  // #ifdef APP-ANDROID
  const showAndroidCaptcha = ref<boolean>(false);
  const androidCaptchaUrl = computed((): string => getApiBaseUrl() + "/static/aliyun-captcha.html");
  // #endif

  // 分段器相关数据
  const currentLoginType = ref<string>("password");
  const isTenantEmailAuth = computed((): boolean => {
    const config = tenantConfigInfoVal.value;
    if (config == null) return false;
    const raw = config["authType"];
    if (raw != null) return `${raw}` == "3";
    // Android 下 UTSJSONObject 作为 prop 透传时，方括号读取偶尔拿不到动态字段。
    // JSON 往返与站点名读取保持一致，确保企业租户的邮箱认证配置生效。
    const jsonStr = JSON.stringify(config);
    if (jsonStr == null || jsonStr.length <= 2) return false;
    const parsed = JSON.parse<UTSJSONObject>(jsonStr);
    if (parsed == null) return false;
    const parsedRaw = parsed["authType"];
    return parsedRaw != null && `${parsedRaw}` == "3";
  });
  const loginOptions = computed((): UTSJSONObject[] => [
    { label: t("Mobile.Auth.accountLogin"), value: "password" } as UTSJSONObject,
    {
      label: isTenantEmailAuth.value
        ? t("Mobile.Auth.codeLoginRegister")
        : t("Mobile.Auth.phoneLogin"),
      value: "phone",
    } as UTSJSONObject,
  ]);

  const isAccountLogin = computed((): boolean => currentLoginType.value == "password");
  const verificationTarget = computed((): string => {
    return isTenantEmailAuth.value ? emailNumber.value : phoneNumber.value;
  });

  // 处理登录方式切换
  const handleLoginTypeChange = (value: string | number, index: number) => {
    currentLoginType.value = `${value}`;
    if (`${value}` == "password") {
      isCaptchaVerify.value = false;
    } else if (`${value}` == "phone") {
      isCaptchaVerify.value = true;
    }
  };

  // ====== 校验辅助：手机号/邮箱格式 ======
  // 判断字符串是否全部为数字字符
  const allCharsAreDigits = (s: string): boolean => {
    if (s.length == 0) return false;
    for (let i = 0; i < s.length; i++) {
      const cRaw = s.charCodeAt(i);
      if (cRaw == null) return false;
      const c = cRaw as number;
      if (c < 48 || c > 57) return false;
    }
    return true;
  };

  // 原逻辑（L253-255）: 当 emailRegex.test(email) 为 true（即邮箱格式合法）时，
  // 反而弹出"邮箱格式不正确"。这是明显的反向 bug。
  // 此处修正为合理行为：邮箱格式不合法时返回 true（触发提示）。
  // 即返回值含义 = "是否为无效邮箱格式"。
  const isInvalidEmailFormat = (email: string): boolean => {
    const at = email.indexOf("@");
    const dot = email.lastIndexOf(".");
    // 必须包含 @ 且 @ 后有 . 且 . 不在末尾
    if (at <= 0) return true;
    if (dot <= at + 1) return true;
    if (dot == email.length - 1) return true;
    return false;
  };

  // 原逻辑（L273-274）: 当 phoneRegex.test(phone) 为 true（即手机号合法）时，
  // 反而弹出"手机号格式不正确"。同样是反向 bug。
  // 此处修正为合理行为：手机号格式不合法时返回 true（触发提示）。
  // 规则：11 位、首位 1、第二位 3-9、其余为数字。
  const isInvalidPhoneFormat = (phone: string): boolean => {
    if (phone.length != 11) return true;
    if (phone.charAt(0) != "1") return true;
    const secondRaw = phone.charCodeAt(1);
    if (secondRaw == null) return true;
    const second = secondRaw as number;
    if (second < 51 || second > 57) return true; // '3'..'9'
    if (!allCharsAreDigits(phone)) return true;
    return false;
  };

  const canSendCode = computed((): boolean => {
    if (loading.value || codeCountdown.value > 0) return false;
    return isTenantEmailAuth.value
      ? !isInvalidEmailFormat(emailNumber.value.trim())
      : !isInvalidPhoneFormat(phoneNumber.value);
  });

  function clearCodeCountdown(): void {
    const timer = codeCountdownTimer;
    if (timer != null) {
      clearInterval(timer);
      codeCountdownTimer = null;
    }
  }

  function startCodeCountdown(): void {
    clearCodeCountdown();
    codeCountdown.value = 60;
    codeCountdownTimer = setInterval(() => {
      codeCountdown.value = codeCountdown.value - 1;
      if (codeCountdown.value <= 0) clearCodeCountdown();
    }, 1000);
  }

  // ====== 校验登录参数（叶子函数，无依赖业务函数） ======
  function validateLoginParams(): boolean {
    if (isAccountLogin.value) {
      const account = emailNumber.value.trim();
      if (account.length == 0) {
        uni.showToast({
          title: t("Mobile.Auth.inputPhoneEmailUsername"),
          icon: "none",
        });
        return false;
      }
    } else if (isTenantEmailAuth.value) {
      const email = emailNumber.value.trim();
      if (email.length == 0) {
        uni.showToast({
          title: t("Mobile.Auth.inputEmail"),
          icon: "none",
        });
        return false;
      }
      if (isInvalidEmailFormat(email)) {
        uni.showToast({
          title: t("Mobile.Auth.invalidEmailFormat"),
          icon: "none",
        });
        return false;
      }
    } else {
      // 校验手机号是否为空
      const phone = phoneNumber.value;
      if (phone.length == 0) {
        uni.showToast({
          title: t("Mobile.Auth.inputPhone"),
          icon: "none",
        });
        return false;
      }
      // 校验手机号格式
      if (isInvalidPhoneFormat(phone)) {
        uni.showToast({
          title: t("Mobile.Auth.invalidPhoneFormat"),
          icon: "none",
        });
        return false;
      }
    }
    return true;
  }

  // ====== 登录成功后（叶子函数） ======
  // result 是 apiLogin 返回的 RequestResponse，包含 code/message/data
  function handleLoginSuccess(result: UTSJSONObject): void {
    const code = `${result["code"]}`;
    const message = result["message"] != null ? `${result["message"]}` : "";
    const dataRaw = result["data"];
    const data = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
    if (code == SUCCESS_CODE) {
      loginCompleted.value = true;
      uni.showToast({
        title: t("Mobile.Auth.loginSuccess"),
        icon: "success",
      });
      setTimeout(() => {
        if (data != null) {
          const token = data["token"];
          const tokenStr = token != null ? `${token}` : "";
          // #ifdef H5 || WEB
          if (process.env.NODE_ENV == "development") {
            saveAccessToken(tokenStr);
          }
          // #endif
          // #ifdef MP-WEIXIN || APP
          saveAccessToken(tokenStr);
          // #endif
        }
        if (isPopupVal.value) {
          emit("login-success");
        } else {
          redirectTo(redirectUrlVal.value);
        }
      }, 1000);
    } else if (code == AGENT_NOT_EXIST) {
      uni.showToast({
        title: message,
        icon: "none",
      });
    }
  }

  // ====== 手机号登录 ======
  async function handleLoginByPhone(captchaVerifyParam: string): Promise<void> {
    if (!validateLoginParams()) {
      loading.value = false;
      return;
    }
    const pass = password.value;
    if (pass.length == 0) {
      uni.showToast({
        title: t("Mobile.Auth.inputPassword"),
        icon: "none",
      });
      loading.value = false;
      return;
    }
    const params = new LoginFieldType();
    params.phoneOrEmail = phoneNumber.value;
    params.areaCode = "86";
    params.password = password.value;
    params.captchaVerifyParam = captchaVerifyParam;
    try {
      loading.value = true;
      const result = await apiLogin(params);
      handleLoginSuccess(result as UTSJSONObject);
    } finally {
      loading.value = false;
    }
  }

  // ====== 邮箱登录 ======
  async function handleLoginByEmail(captchaVerifyParam: string): Promise<void> {
    if (!validateLoginParams()) {
      loading.value = false;
      return;
    }
    const pass = password.value;
    if (pass.length == 0) {
      uni.showToast({
        title: t("Mobile.Auth.inputPassword"),
        icon: "none",
      });
      loading.value = false;
      return;
    }
    const params = new LoginFieldType();
    params.phoneOrEmail = emailNumber.value;
    params.areaCode = "";
    params.password = password.value;
    params.captchaVerifyParam = captchaVerifyParam;
    try {
      loading.value = true;
      const result = await apiLogin(params);
      const resObj = result as UTSJSONObject;
      const code = `${resObj["code"]}`;
      const message = resObj["message"] != null ? `${resObj["message"]}` : "";
      const dataRaw = resObj["data"];
      const data = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (code == SUCCESS_CODE) {
        loginCompleted.value = true;
        uni.showToast({
          title: t("Mobile.Auth.loginSuccess"),
          icon: "success",
        });
        setTimeout(() => {
          if (data != null) {
            const token = data["token"];
            const tokenStr = token != null ? `${token}` : "";
            // #ifdef H5 || WEB
            if (process.env.NODE_ENV == "development") {
              saveAccessToken(tokenStr);
            }
            // #endif
            // #ifdef MP-WEIXIN || APP
            saveAccessToken(tokenStr);
            // #endif
          }
          if (isPopupVal.value) {
            emit("login-success");
          } else {
            redirectTo(redirectUrlVal.value);
          }
        }, 1000);
      } else if (code == AGENT_NOT_EXIST) {
        uni.showToast({
          title: message,
          icon: "none",
        });
      }
    } finally {
      loading.value = false;
    }
  }

  // ====== 密码登录分发（依据是否邮箱登录） ======
  function handleLogin(captchaVerifyParam: string): void {
    if (isAccountLogin.value) {
      handleLoginByEmail(captchaVerifyParam);
    } else {
      handleLoginByPhone(captchaVerifyParam);
    }
  }

  // ====== 下一步（验证码登录） ======
  async function handleNext(captchaVerifyParam: string): Promise<void> {
    if (!validateLoginParams()) {
      return;
    }
    const params = new SendCode();
    // Android：勿赋 SendCodeEnum，会序列化为 { value: "LOGIN_OR_REGISTER" }
    params.type = "LOGIN_OR_REGISTER";
    params.captchaVerifyParam = captchaVerifyParam;
    if (isTenantEmailAuth.value) {
      params.email = emailNumber.value.trim();
    } else {
      params.phone = phoneNumber.value;
    }
    try {
      loading.value = true;
      const res = await apiSendCode(params);
      const resObj = res as UTSJSONObject;
      const code = `${resObj["code"]}`;
      const message = resObj["message"] != null ? `${resObj["message"]}` : "";
      if (isTenantEmailAuth.value) {
        // 邮箱验证码
        if (code == SUCCESS_CODE) {
          codeLoginCaptchaVerifyParam.value = captchaVerifyParam;
          uni.showToast({
            title: t("Mobile.Auth.codeSentSuccess"),
            icon: "none",
          });
          startCodeCountdown();
        } else if (code == AGENT_NOT_EXIST) {
          codeLoginCaptchaVerifyParam.value = captchaVerifyParam;
          uni.showToast({
            title: message,
            icon: "none",
            duration: 5000,
          });
          startCodeCountdown();
        }
      } else {
        // 手机验证码
        if (code == SUCCESS_CODE) {
          codeLoginCaptchaVerifyParam.value = captchaVerifyParam;
          uni.showToast({
            title: t("Mobile.Auth.codeSentSuccess"),
            icon: "none",
          });
          startCodeCountdown();
        } else {
          uni.showToast({
            title: message,
            icon: "none",
          });
        }
      }
    } finally {
      loading.value = false;
    }
  }

  // ====== 阿里云验证码成功回调 ======
  function handlerSuccess(captchaVerifyParam: string): void {
    if (isCaptchaVerify.value) {
      handleNext(captchaVerifyParam);
    } else {
      handleLogin(captchaVerifyParam);
    }
  }

  // ====== App / 微信小程序阿里云验证码跳转 ======
  const handleClickAliyunCaptcha = () => {
    // #ifdef APP-ANDROID
    showAndroidCaptcha.value = true;
    return;
    // #endif
    waitingCaptchaResult = true;
    uni.navigateTo({
      url: "/subpackages/pages/aliyun-captcha/aliyun-captcha",
      fail: () => {
        waitingCaptchaResult = false;
        loading.value = false;
        uni.showToast({
          title: "验证码页面打开失败",
          icon: "none",
        });
      },
    });
  };

  // #ifdef APP-ANDROID
  const closeAndroidCaptcha = () => {
    showAndroidCaptcha.value = false;
    loading.value = false;
  };

  const handleAndroidCaptchaMessage = (event: UniWebViewMessageEvent) => {
    const messages = event.detail.data;
    if (messages.length == 0) {
      return;
    }
    const payload = messages[messages.length - 1] as UTSJSONObject;
    const value = payload["captchaVerifyParam"];
    const captchaVerifyParam = value != null ? `${value}` : "";
    if (captchaVerifyParam.length == 0) {
      return;
    }
    showAndroidCaptcha.value = false;
    handlerSuccess(captchaVerifyParam);
  };
  // #endif

  const handleCaptchaVerifyResult = (captchaVerifyParam: any) => {
    if (!waitingCaptchaResult) {
      return;
    }
    waitingCaptchaResult = false;
    const verifyParam = captchaVerifyParam != null ? `${captchaVerifyParam}` : "";
    if (verifyParam.length == 0) {
      loading.value = false;
      uni.showToast({
        title: "验证码校验失败，请重试",
        icon: "none",
      });
      return;
    }
    handlerSuccess(verifyParam);
  };

  onMounted(() => {
    uni.$on(captchaResultEvent, handleCaptchaVerifyResult);
  });

  onUnmounted(() => {
    uni.$off(captchaResultEvent, handleCaptchaVerifyResult);
    clearCodeCountdown();
  });

  // ====== 执行登录 / 触发验证码 ======
  const doLogin = () => {
    // 阿里云验证码配置读取
    const tenantConfigInfo = tenantConfigInfoVal.value;
    let captchaSceneId = "";
    let captchaPrefix = "";
    let openCaptcha = false;
    if (tenantConfigInfo != null) {
      const sceneRaw = tenantConfigInfo["captchaSceneId"];
      captchaSceneId = sceneRaw != null ? `${sceneRaw}` : "";
      const prefixRaw = tenantConfigInfo["captchaPrefix"];
      captchaPrefix = prefixRaw != null ? `${prefixRaw}` : "";
      const openRaw = tenantConfigInfo["openCaptcha"];
      openCaptcha = openRaw != null ? `${openRaw}` == "1" : false;
    }
    // 只有同时满足三个条件才启用验证码：场景ID存在、身份标存在、开启验证码
    const needAliyunCaptcha =
      tenantConfigInfo != null &&
      captchaSceneId.length > 0 &&
      captchaPrefix.length > 0 &&
      openCaptcha;

    if (needAliyunCaptcha) {
      // #ifdef H5 || WEB
      // H5和WEB端验证码
      const el = document.getElementById(buttonId.value);
      if (el != null) {
        el.click();
      } else {
        loading.value = false;
      }
      // #endif
      // #ifdef MP-WEIXIN || APP
      // 原生端通过 web-view 加载验证码页，校验结果经页面消息回传。
      handleClickAliyunCaptcha();
      // #endif
    } else {
      handlerSuccess("");
    }
  };

  const handleGetCode = () => {
    if (!canSendCode.value) return;
    doLogin();
  };

  const submitPhoneCodeLogin = () => {
    if (!validateLoginParams()) return;
    const code = verifyCode.value.trim();
    if (code.length != 6 || !allCharsAreDigits(code)) {
      uni.showToast({
        title: t("Mobile.Auth.inputVerifyCode"),
        icon: "none",
      });
      return;
    }
    emit(
      "code-login",
      verificationTarget.value,
      code,
      isTenantEmailAuth.value,
      codeLoginCaptchaVerifyParam.value,
    );
  };

  const submitCurrentLogin = () => {
    if (isCaptchaVerify.value) {
      submitPhoneCodeLogin();
      return;
    }
    if (!validateLoginParams()) return;
    if (password.value.length == 0) {
      uni.showToast({
        title: t("Mobile.Auth.inputPassword"),
        icon: "none",
      });
      return;
    }
    // 在打开图形验证码或发起登录请求前立即进入加载态，阻止重复点击。
    loading.value = true;
    doLogin();
  };

  // ====== 登录按钮点击 ======
  const onFinish = () => {
    if (isSubmitting.value) return;
    if (!agreeTerms.value) {
      uni.showModal({
        title: t("Mobile.Common.tip"),
        content: t("Mobile.Auth.pleaseAgreeProtocol"),
        confirmText: t("Mobile.Common.agree"),
        cancelText: t("Mobile.Common.disagree"),
        success: function (res) {
          if (res.confirm == true) {
            agreeTerms.value = true;
            submitCurrentLogin();
          }
        },
      });
    } else {
      submitCurrentLogin();
    }
  };

  const clearPhoneNumber = () => {
    phoneNumber.value = "";
  };

  const clearEmailNumber = () => {
    emailNumber.value = "";
  };

  const clearVerificationTarget = () => {
    if (isTenantEmailAuth.value) {
      clearEmailNumber();
    } else {
      clearPhoneNumber();
    }
    verifyCode.value = "";
  };

  const clearPassword = () => {
    password.value = "";
  };

  const togglePasswordVisibility = () => {
    showPassword.value = !showPassword.value;
  };
</script>

