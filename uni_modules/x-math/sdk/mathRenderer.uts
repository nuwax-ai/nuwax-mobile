/**
 * x-math 跨平台 LaTeX 渲染基础设施层 —— 公共类型与后端契约。
 *
 * 渲染契约（与现有 proxy-web KaTeX 链路一致）：
 *   给定 (latex, displayMode) → 产出 { html?(H5 v-html), href?(App 截图 dataURL/路径), width, height, error }
 *
 * 对外：<x-math> 组件 + MathRendererCore（去重/并发/缓存/错误兜底）。
 * 下层后端可插拔：
 *   Phase1 ProxyWebBackend —— App 截图 + H5 HTML（沿用隐藏 web-view + KaTeX）
 *   Phase2 NativeViewBackend —— JLaTeXMath / iosMath 真原生矢量排版
 *   future MpHtmlBackend —— 微信小程序 mp-html latex
 */

/** 公式渲染结果（对外回调类型）。
 *  用 class 而非 type 字面量，规避 UTS「函数返回对象字面量」的编译限制
 *  （参见 katex-el.uvue 把宽高拆成两个 number 的同类规避）。 */
export class MathRenderResult {
  /** H5 路径：katex.renderToString 的 HTML，由组件 v-html 注入 */
  html: string = ""
  /** App 路径：截图 dataURL 或落盘后的本地路径，由 <image :src> 显示 */
  href: string = ""
  width: number = 0
  height: number = 0
  /** 渲染失败的错误描述；成功时为空串 */
  error: string = ""
}

/**
 * 后端回包的原始 UTSJSONObject 字段契约（与 proxy-web 回包一致）：
 *   { imageDataURL?, resultHtml?, width?, height? }。
 * 缓存 / 去重 / 并发 / 错误兜底统一由 MathRendererCore 负责；后端只做「一次渲染」。
 * 后端派发在 MathRendererCore.renderViaBackend 里直接调用（UTS 导出函数名非一等值，
 * 不能赋给函数类型字段），Phase2 native 用 #ifdef 分支接入。 */
