<template>
  <view
    class="vr-page"
    @touchstart="handlePanelTouchStart"
    @touchmove="handlePanelTouchMove"
    @touchend="handlePanelTouchEnd"
    @touchcancel="handlePanelTouchEnd"
  >
    <view class="vr-nav">
      <view class="vr-nav__side" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="22" unit="px" color="#1a1a1a" />
      </view>
      <text class="vr-nav__title">录音</text>
      <view class="vr-nav__side vr-nav__side--right" @click.stop="openHistory">
        <text class="vr-nav__action">历史记录</text>
      </view>
    </view>

    <view class="vr-body">
      <view class="vr-timer">
        <view v-for="(ch, index) in timerChars" :key="index" :class="timerSlotClass(ch)">
          <text class="vr-timer__ch">{{ ch }}</text>
        </view>
      </view>
      <text v-if="statusText.length > 0" class="vr-status">{{ statusText }}</text>
      <view class="vr-wave">
        <view class="vr-wave__clip">
          <view class="vr-wave__base"></view>
          <view class="vr-wave__track">
            <view v-for="index in waveSlotIndexes" :key="slotKey(index, waveTick)" class="vr-wave__mark" :style="slotMarkStyle(index, waveTick)">
              <view class="vr-wave__bar" :style="slotBarStyle(index, waveTick)"></view>
            </view>
          </view>
        </view>
        <view v-if="phase != 'idle'" class="vr-wave__played" :style="wavePlayedStyle"></view>
        <view class="vr-wave__head" :style="waveHeadStyle">
          <view class="vr-wave__dot"></view>
          <view class="vr-wave__line"></view>
          <view class="vr-wave__dot"></view>
        </view>
        <view class="vr-wave__fade vr-wave__fade--left"></view>
        <view class="vr-wave__fade vr-wave__fade--right"></view>
        <view v-if="canPlay" class="vr-wave__play" @click="handlePlayToggle">
          <view v-if="playing" class="vr-wave__play-stop"></view>
          <image v-else class="vr-wave__play-icon" src="/static/images/icon-voice-play-mark.png" mode="aspectFit" />
        </view>
      </view>
      <view class="vr-spacer"></view>
      <view class="vr-dock">
        <view v-if="phase != 'idle' && phase != 'recording'" class="vr-dock__side" @click="handleRerecord">
          <view class="vr-dock__slot">
            <view class="vr-action__btn vr-action__btn--ghost">
              <svg-icon name="icon-refresh" size="22" unit="px" color="#e24b4b" />
            </view>
          </view>
          <text class="vr-dock__label">重录</text>
        </view>
        <view v-else class="vr-dock__side"></view>
        <view class="vr-dock__main" @click="handleMainAction">
          <view class="vr-stop__ring">
            <view class="vr-stop__btn">
              <view v-if="phase == 'recording'" class="vr-stop__square"></view>
              <svg-icon v-else name="icon-Mic" size="26" unit="px" color="#ffffff" />
            </view>
          </view>
          <text class="vr-dock__label" :class="phase == 'recording' ? 'vr-dock__label--stop' : ''">{{ mainActionLabel() }}</text>
        </view>
        <view v-if="phase != 'idle' && phase != 'recording'" class="vr-dock__side" @click="handleDone">
          <view class="vr-dock__slot">
            <view class="vr-action__btn vr-action__btn--side">
              <view class="vr-action__check">
                <svg-icon name="icon-Check" size="22" unit="px" color="#ffffff" />
              </view>
            </view>
          </view>
          <text class="vr-dock__label">完成</text>
        </view>
        <view v-else class="vr-dock__side"></view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
/**
 * 伙伴页内录音层：由消息列表右滑打开，不单独占路由。
 * 关闭经 close 上抛，由伙伴页收起本层。
 */
import { isAppInBackground } from "@/utils/appLifecycle.uts";
import { MicrophonePermissionHelper } from "@/utils/permissionHelper";
import { pageSystemOverlay } from "@/utils/pageSystemOverlay.uts";
import { emptyI18nParams, useI18n } from "@/utils/i18n";
import { watch } from "vue";
import { beginPartnerVoiceDrag, endPartnerVoiceDrag, movePartnerVoiceDrag } from "@/utils/voice-note/partnerVoiceDrawer.uts";
import {
  discardVoiceNote,
  finishVoiceNote,
  getPanelVoiceNote,
  keepVoiceNoteInterruptionWatch,
  playableLocalVoiceFile,
  readVoiceNoteInputLevel,
  startVoiceNote,
  stopVoiceNote,
} from "@/utils/voice-note/voiceNoteEngine.uts";
import { clearVoiceWave, readVoiceWave, writeVoiceWave } from "@/utils/voice-note/voiceWaveCache.uts";
import { VoiceNoteRecord, loadRecordingNoteId, saveRecordingNoteId } from "@/utils/voice-note/voiceNoteStore.uts";
// #ifdef APP-HARMONY
import { openHarmonyMicPermissionSettings } from "@/uni_modules/nuwax-stream-pcm-player";
import { readVoiceNoteAudibleOpenMs, readVoiceNoteCallHold } from "@/utils/voice-note/voiceNoteEngine.uts";
// #endif
// #ifdef APP-IOS
import { StreamPcmRecorder } from "@/uni_modules/nuwax-stream-pcm-player";
// #endif

const { t: tFn } = useI18n();
function t(key: string): string {
  return tFn(key, emptyI18nParams(), "");
}

let panelDragToken = 0;

function panelTouchX(eventValue: Any): number {
  const e = eventValue as UniTouchEvent;
  if (e.touches.length > 0) {
    return e.touches[0].screenX;
  }
  if (e.changedTouches != null && e.changedTouches.length > 0) {
    return e.changedTouches[0].screenX;
  }
  return -1;
}

function panelTouchY(eventValue: Any): number {
  const e = eventValue as UniTouchEvent;
  if (e.touches.length > 0) {
    return e.touches[0].screenY;
  }
  if (e.changedTouches != null && e.changedTouches.length > 0) {
    return e.changedTouches[0].screenY;
  }
  return -1;
}

function handlePanelTouchStart(eventValue: Any): void {
  const x = panelTouchX(eventValue);
  const y = panelTouchY(eventValue);
  if (x < 0 || y < 0) {
    return;
  }
  panelDragToken = beginPartnerVoiceDrag(x, y);
}

function handlePanelTouchMove(eventValue: Any): void {
  const x = panelTouchX(eventValue);
  const y = panelTouchY(eventValue);
  if (x < 0 || y < 0) {
    return;
  }
  const claimed = movePartnerVoiceDrag(x, y);
  if (claimed) {
    const e = eventValue as UniTouchEvent;
    e.preventDefault();
    e.stopPropagation();
  }
}

function handlePanelTouchEnd(eventValue: Any): void {
  endPartnerVoiceDrag(panelTouchX(eventValue), panelTouchY(eventValue), panelDragToken);
}

const emit = defineEmits<{
  close: [];
  "recording-change": [recording: boolean];
}>();

/** 音波左右各留出的宽度（rpx）。左侧留给播放按钮，右侧留出对称空白。 */
const WAVE_SIDE_RPX = 112;
/** 音柱间距（px）。细柱靠拢，看起来才像一条连续的音波。 */
const WAVE_PITCH = 4;
/** 大约每 0.14 秒记一柱。界面定时器是 80ms，实际会落在下一次刷新。 */
const WAVE_SAMPLE_MS = 140;

/** 竖线左边固定这些位置。新的音量从最右边进入，旧的依次向左挪。 */
const WAVE_SLOT_COUNT = 48;
const waveSlotIndexes: number[] = [];
for (let waveSlot = 0; waveSlot < WAVE_SLOT_COUNT; waveSlot++) {
  waveSlotIndexes.push(waveSlot);
}
/** 下标 0 是最旧的一柱，最后一格是刚采样的一柱。 */
let waveLevels: number[] = [];
let waveSampleAt = -1;
let waveSessionId = "";
/** 模板直接读它，鸿蒙才会在高度变化后重画柱子。 */
const waveTick = ref<number>(0);

const elapsedMs = ref<number>(0);
/** 录音进度和播放进度分开记，切换时各自回到自己的波浪线位置。 */
let recordWaveMs = 0;
let playWaveMs = 0;
/** 当前波浪线跟随播放进度。继续录音时改回录音进度。 */
let waveFollowsPlay = false;
/** 中间竖线的横坐标（px）。音柱只画在它左边。 */
const waveHeadLeft = ref<number>(187);
let waveLayoutWidth = 0;
/** 当前这条录音已经有过封口分段。满足一次后保持显示，不再每次刷新重判。 */
const canPlay = ref<boolean>(false);
/** 播放图标属于哪一条录音。换一条时重新判断一次。 */
let playIconLocalId = "";
const playing = ref<boolean>(false);
/** idle 未开始 / recording 录音中 / paused 已暂停可继续 / stopped 正在收尾 */
const phase = ref<string>("idle");
const statusText = ref<string>("");
watch(phase, (value: string) => {
  emit("recording-change", value == "recording");
});

let uiTimer = 0;
/** 返回消息页时停掉波形位移，避免关层动画途中还在改样式。 */
let waveFrozen = false;
let player: InnerAudioContext | null = null;
let playToken = 0;
/** 播放计时起点。时间按本地时钟累加，避免跟着稀疏的音频回调跳动。 */
let playClockStart = 0;
let playClockBase = 0;

function pad2(n: number): string {
  if (n < 10) {
    return "0" + n.toString();
  }
  return n.toString();
}

function formatDuration(ms: number): string {
  const safe = ms < 0 ? 0 : ms;
  const totalCs = Math.floor(safe / 10);
  const cs = totalCs % 100;
  const totalSec = Math.floor(totalCs / 100);
  const sec = totalSec % 60;
  const min = Math.floor(totalSec / 60);
  return pad2(min) + ":" + pad2(sec) + "." + pad2(cs);
}

const timerChars = computed((): string[] => {
  const text = formatDuration(elapsedMs.value);
  const chars: string[] = [];
  for (let i = 0; i < text.length; i++) {
    chars.push(text.charAt(i));
  }
  return chars;
});

/** 数字槽等宽，冒号和小数点单独收窄。播放时 1 和 0 交替不会把整行撑来撑去。 */
function timerSlotClass(ch: string): string {
  if (ch == ":" || ch == ".") {
    return "vr-timer__slot vr-timer__slot--sep";
  }
  return "vr-timer__slot";
}

function statusOf(record: VoiceNoteRecord): string {
  let uploaded = 0;
  let failed = 0;
  const total = record.segments.length;
  for (let i = 0; i < total; i++) {
    const row = record.segments[i];
    if (row.uploadStatus == "uploaded") uploaded = uploaded + 1;
    if (row.uploadStatus == "failed") failed = failed + 1;
  }
  if (record.phase == "recording") {
    if (total == 0) return "录音中，退到后台会继续";
    return "录音中，已上传 " + uploaded + "/" + total + " 段";
  }
  if (record.phase == "paused") {
    if (failed > 0) return "已暂停，" + failed + " 段上传失败";
    if (total > 0 && uploaded < total) return "已暂停，已上传 " + uploaded + "/" + total + " 段";
    return "已暂停，可继续录音";
  }
  if (record.phase == "processing") return "转写中";
  if (record.phase == "uploading") return "上传中 " + uploaded + "/" + total;
  if (record.phase == "failed" && record.error.length > 0) return record.error;
  if (failed > 0) return failed + " 段上传失败，点完成会重试";
  if (total > 0 && uploaded < total) return "待上传 " + uploaded + "/" + total;
  if (record.noteId.length > 0) return "已缓存 noteId " + record.noteId;
  return "已保存在本机";
}

function windowWidthPx(): number {
  const width = uni.getWindowInfo().windowWidth;
  if (width > 0) {
    return width;
  }
  return 375;
}

/** 左右留白换算成 px，和播放按钮所在的左侧空位对齐。 */
function waveSidePx(): number {
  return Math.round(windowWidthPx() * WAVE_SIDE_RPX / 750);
}

function waveViewWidth(): number {
  const inner = windowWidthPx() - waveSidePx() * 2;
  if (inner > 0) {
    return inner;
  }
  return windowWidthPx();
}

function ensureWaveLayout(): void {
  const view = waveViewWidth();
  if (view == waveLayoutWidth) {
    return;
  }
  waveLayoutWidth = view;
  const head = Math.round(view * 0.5);
  waveHeadLeft.value = waveSidePx() + head;
}

function resetWaveSession(id: string): void {
  if (waveSessionId == id && waveLevels.length == WAVE_SLOT_COUNT) {
    return;
  }
  waveSessionId = id;
  const kept = readVoiceWave(id);
  waveLevels = [];
  if (id.length > 0 && kept.length == WAVE_SLOT_COUNT) {
    for (let i = 0; i < kept.length; i++) {
      waveLevels.push(kept[i]);
    }
  } else {
    for (let i = 0; i < WAVE_SLOT_COUNT; i++) {
      waveLevels.push(0);
    }
    if (id.length == 0) {
      clearVoiceWave();
    }
  }
  waveSampleAt = -1;
  waveTick.value = waveTick.value + 1;
}

/** 只有这根柱子的高度变了才换 key。鸿蒙要换 key 才会画出新高度；key 里不放采样序号，高度没变时不拆掉重画。 */
function slotKey(index: number, tick: number): number {
  let height = 0;
  if (tick >= 0 && index >= 0 && index < waveLevels.length) {
    height = waveLevels[index];
  }
  return index * 1000 + height;
}

/** 最右边一格贴着竖线，其余按间距向左排。tick 传进来是为了让模板依赖它。 */
function slotMarkStyle(index: number, tick: number): string {
  if (tick < 0) {
    return "left: 0px;";
  }
  const head = waveHeadLeft.value - waveSidePx();
  const fromNewest = WAVE_SLOT_COUNT - 1 - index;
  const left = Math.round(head - 6 - fromNewest * WAVE_PITCH);
  if (left < 0) {
    return "left: 0px; opacity: 0;";
  }
  return "left: " + left.toString() + "px; opacity: 1;";
}

function slotBarStyle(index: number, tick: number): string {
  let height = 0;
  if (tick >= 0 && index >= 0 && index < waveLevels.length) {
    height = waveLevels[index];
  }
  return "height: " + height.toString() + "px;";
}

/** 波浪线区域的高度。音量满格时柱子用到这块高度的大约六成。 */
function waveAreaPx(): number {
  const height = Math.round(windowWidthPx() * 280 / 750);
  if (height < 48) {
    return 48;
  }
  return height;
}

/** 把 0 到 100 的音量收成柱高。没有声音时保持 6px，大声大约到波浪线高度的六成。 */
function levelBarHeight(level: number): number {
  let value = level;
  if (value < 0) {
    value = 0;
  }
  if (value > 100) {
    value = 100;
  }
  const span = Math.round((waveAreaPx() - 6) * 62 / 100);
  return 6 + Math.round(value * span / 100);
}

/** 录音时按音量往竖线左边追加一柱。暂停、播放不再追加。 */
function sampleRecordingWave(): void {
  if (waveFrozen || phase.value != "recording") {
    return;
  }
  // #ifdef APP-HARMONY
  // 通话静音会被剪掉。这段时间不往左推柱子，否则会留下一长条 6px。
  if (readVoiceNoteCallHold()) {
    return;
  }
  // #endif
  const now = Date.now();
  if (waveSampleAt >= 0 && now - waveSampleAt < WAVE_SAMPLE_MS) {
    return;
  }
  waveSampleAt = now;
  if (waveLevels.length != WAVE_SLOT_COUNT) {
    waveLevels = [];
    for (let i = 0; i < WAVE_SLOT_COUNT; i++) {
      waveLevels.push(0);
    }
  }
  for (let i = 0; i < WAVE_SLOT_COUNT - 1; i++) {
    waveLevels[i] = waveLevels[i + 1];
  }
  const step = waveTick.value + 1;
  const base = levelBarHeight(readVoiceNoteInputLevel());
  let room = base - 6;
  if (room < 0) {
    room = 0;
  }
  let mixed = (step * 37) % 100;
  if (mixed < 0) {
    mixed = 0;
  }
  let height = base + Math.round((mixed - 50) * room / 55);
  if (height < 6) {
    height = 6;
  }
  const cap = waveAreaPx() - 6;
  if (height > cap) {
    height = cap;
  }
  waveLevels[WAVE_SLOT_COUNT - 1] = height;
  waveTick.value = step;
  writeVoiceWave(waveSessionId, waveLevels);
}

/** 竖线停在中间。录音时只在左边按音量往外走，右边不画柱子。 */
function syncLevels(): void {
  const before = waveLayoutWidth;
  ensureWaveLayout();
  if (phase.value == "recording") {
    sampleRecordingWave();
    return;
  }
  if (before != waveLayoutWidth) {
    waveTick.value = waveTick.value + 1;
  }
}

const waveHeadStyle = computed((): string => {
  return `left: ${waveHeadLeft.value}px;`;
});

const wavePlayedStyle = computed((): string => {
  const played = waveHeadLeft.value - waveSidePx();
  const width = played > 0 ? played : 0;
  return `left: ${waveSidePx()}px; width: ${width}px;`;
});

class PlaySlice {
  filePath: string = "";
  startMs: number = 0;
  durationMs: number = 0;
}

function playSlices(): PlaySlice[] {
  const record = getPanelVoiceNote();
  const list: PlaySlice[] = [];
  if (record == null) {
    return list;
  }
  let cursor = 0;
  for (let i = 0; i < record.segments.length; i++) {
    const row = record.segments[i];
    if (row.filePath.length == 0) {
      continue;
    }
    const slice = new PlaySlice();
    slice.filePath = row.filePath;
    slice.startMs = cursor;
    slice.durationMs = row.durationMs > 0 ? row.durationMs : 0;
    list.push(slice);
    cursor = cursor + slice.durationMs;
  }
  return list;
}

/** 可播放内容的总时长。竖线停在末尾时，下一次播放从头开始。 */
function playableDurationMs(): number {
  const slices = playSlices();
  if (slices.length == 0) {
    return 0;
  }
  const last = slices[slices.length - 1];
  return last.startMs + last.durationMs;
}

function recordProgressMs(record: VoiceNoteRecord): number {
  // #ifdef APP-HARMONY
  // 接通后文件仍在写，墙上时钟含通话。界面跟剪掉静音后的时长，接通时停住，挂断后接着走。
  if (record.phase == "recording") {
    const audible = readVoiceNoteAudibleOpenMs();
    if (audible >= 0) {
      return record.accumulatedMs + audible;
    }
  }
  // #endif
  let shown = record.accumulatedMs + record.openElapsedMs;
  if (record.phase == "recording" && record.segmentStartedAt > 0) {
    const extra = Date.now() - record.segmentStartedAt;
    if (extra > 0) shown = shown + extra;
  }
  return shown;
}

function playClockMs(): number {
  if (playClockStart == 0) {
    return playWaveMs;
  }
  return playClockBase + (Date.now() - playClockStart);
}

function clampedPlayMs(ms: number): number {
  const total = playableDurationMs();
  let next = ms;
  if (next < 0) {
    next = 0;
  }
  if (total > 0 && next > total) {
    next = total;
  }
  return next;
}

function armPlayClock(ms: number): void {
  const next = clampedPlayMs(ms);
  playWaveMs = next;
  playClockBase = next;
  playClockStart = Date.now();
}

function showRecordWave(): void {
  waveFollowsPlay = false;
  elapsedMs.value = recordWaveMs;
  syncLevels();
}

/** 这条录音是否已有封口分段。只在图标还没出现时看一次内存里的分段。 */
function rememberPlayIcon(record: VoiceNoteRecord): void {
  if (playIconLocalId != record.localId) {
    playIconLocalId = record.localId;
    canPlay.value = false;
  }
  if (canPlay.value) {
    return;
  }
  for (let i = 0; i < record.segments.length; i++) {
    if (record.segments[i].filePath.length > 0) {
      canPlay.value = true;
      return;
    }
  }
}

let savedRecordingNoteId = loadRecordingNoteId();
let savedRecordingLocalId = "";

/** 新开一条录音并拿到 noteId 时写一次。暂停、继续、播放不写。这次结束后清掉。 */
function rememberRecordingNoteId(record: VoiceNoteRecord | null): void {
  if (record != null && (record.phase == "recording" || record.phase == "paused" || record.phase == "stopped")) {
    if (record.phase != "recording" || record.noteId.length == 0) {
      return;
    }
    if (record.localId == savedRecordingLocalId || record.noteId == savedRecordingNoteId) {
      savedRecordingLocalId = record.localId;
      return;
    }
    savedRecordingLocalId = record.localId;
    savedRecordingNoteId = record.noteId;
    saveRecordingNoteId(record.noteId);
    return;
  }
  if (savedRecordingNoteId.length == 0) {
    return;
  }
  savedRecordingLocalId = "";
  savedRecordingNoteId = "";
  saveRecordingNoteId("");
}

function applySnapshot(): void {
  // 面板还在时把通话打断的监听拉起来。通话界面可能把引擎定时器停住。
  keepVoiceNoteInterruptionWatch();
  // 退到后台只让录音和计时继续。不读缓存，也不刷新波形和页面。
  if (isAppInBackground()) {
    return;
  }
  const record = getPanelVoiceNote();
  rememberRecordingNoteId(record);
  if (record == null || record.phase == "success") {
    // 声音还在播时不能把图标和时间清掉。等这次播放结束，下一拍再收回初始状态。
    if (playing.value) {
      return;
    }
    phase.value = "idle";
    elapsedMs.value = 0;
    recordWaveMs = 0;
    playWaveMs = 0;
    waveFollowsPlay = false;
    statusText.value = "";
    canPlay.value = false;
    playIconLocalId = "";
    resetWaveSession("");
    syncLevels();
    return;
  }
  resetWaveSession(record.localId);
  rememberPlayIcon(record);
  statusText.value = statusOf(record);
  if (record.phase == "recording") {
    phase.value = "recording";
  } else if (record.phase == "paused") {
    phase.value = "paused";
  } else {
    phase.value = "stopped";
  }
  if (playing.value || waveFollowsPlay) {
    if (playing.value) {
      playWaveMs = clampedPlayMs(playClockMs());
    }
    elapsedMs.value = playWaveMs;
    syncLevels();
    return;
  }
  recordWaveMs = recordProgressMs(record);
  elapsedMs.value = recordWaveMs;
  syncLevels();
}

function startUiTimer(): void {
  if (uiTimer != 0) return;
  uiTimer = setInterval(() => {
    applySnapshot();
  }, 80);
}

function stopUiTimer(): void {
  if (uiTimer != 0) {
    clearInterval(uiTimer);
    uiTimer = 0;
  }
}

function openMicSettings(): void {
  // #ifdef APP-ANDROID
  const activity = UTSAndroid.getUniActivity();
  if (activity != null) {
    pageSystemOverlay.begin("android.permissionSettings", true);
    UTSAndroid.gotoSystemPermissionActivity(activity, ["android.permission.RECORD_AUDIO"] as string[]);
  }
  // #endif
  // #ifdef APP-HARMONY
  pageSystemOverlay.begin("harmony.permissionSettings", true);
  openHarmonyMicPermissionSettings();
  // #endif
  // #ifdef APP-IOS
  pageSystemOverlay.begin("ios.authorizeSetting", true);
  uni.openAppAuthorizeSetting({});
  // #endif
  // #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ
  uni.openSetting({});
  // #endif
  // #ifdef H5 || WEB
  MicrophonePermissionHelper.showGuide();
  // #endif
}

function showMicGuide(): void {
  uni.showModal({
    title: t("Mobile.Voice.permissionRequired"),
    content: t("Mobile.Voice.permissionContent"),
    confirmText: t("Mobile.Voice.goToSettings"),
    cancelText: t("Mobile.Common.cancel"),
    success: (res) => {
      if (res.confirm == true) {
        openMicSettings();
      }
    },
  });
}

/**
 * 已授权返回 true。未决定时弹出系统授权窗，同意后返回 true。
 * 之前已拒绝、系统不再弹窗时，弹出引导去系统设置，并返回 false。
 */
async function ensureMicPermission(): Promise<boolean> {
  // #ifdef APP-ANDROID
  const activity = UTSAndroid.getUniActivity();
  if (activity == null) {
    return false;
  }
  const permissionNeed = ["android.permission.RECORD_AUDIO"] as string[];
  if (UTSAndroid.checkSystemPermissionGranted(activity, permissionNeed)) {
    return true;
  }
  return await new Promise<boolean>((resolve) => {
    pageSystemOverlay.begin("android.recordPermission", true);
    UTSAndroid.requestSystemPermission(
      activity,
      permissionNeed,
      (allGranted: boolean, _granted: string[]) => {
        pageSystemOverlay.end();
        resolve(allGranted);
      },
      (doNotAskAgain: boolean, _denied: string[]) => {
        pageSystemOverlay.end();
        if (doNotAskAgain == true) {
          showMicGuide();
        }
        resolve(false);
      },
    );
  });
  // #endif

  // #ifdef APP-IOS
  const authSetting = uni.getAppAuthorizeSetting();
  if (authSetting.microphoneAuthorized == "authorized") {
    return true;
  }
  if (authSetting.microphoneAuthorized == "denied") {
    showMicGuide();
    return false;
  }
  // 未决定时不能直接开录。AVAudioRecorder.record() 才会弹系统窗，
  // 那时计时已经从点击时刻开始走了。这里先等用户点完授权。
  const probe = new StreamPcmRecorder();
  pageSystemOverlay.begin("ios.recordPermission", true);
  probe.requestRecordPermission();
  return await new Promise<boolean>((resolve) => {
    let pollTimer = 0;
    pollTimer = setInterval(() => {
      if (probe.permissionResolved()) {
        clearInterval(pollTimer);
        pollTimer = 0;
        pageSystemOverlay.end();
        const granted = probe.permissionGranted();
        if (granted != true) {
          showMicGuide();
        }
        resolve(granted);
      }
    }, 50);
    setTimeout(() => {
      if (pollTimer != 0) {
        clearInterval(pollTimer);
        pollTimer = 0;
        pageSystemOverlay.end();
        resolve(false);
      }
    }, 60000);
  });
  // #endif

  // #ifdef APP-HARMONY
  return await new Promise<boolean>((resolve) => {
    pageSystemOverlay.begin("harmony.recordPermission", true);
    UTSHarmony.requestSystemPermission(
      ["ohos.permission.MICROPHONE"] as string[],
      (allRight: boolean, _granted: string[]) => {
        pageSystemOverlay.end();
        resolve(allRight);
      },
      (doNotAskAgain: boolean, _denied: string[]) => {
        pageSystemOverlay.end();
        if (doNotAskAgain == true) {
          showMicGuide();
        }
        resolve(false);
      },
    );
  });
  // #endif

  // #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ
  return await new Promise<boolean>((resolve) => {
    uni.getSetting({
      success: (res) => {
        const setting = res.authSetting as UTSJSONObject;
        if (setting["scope.record"] == true) {
          resolve(true);
          return;
        }
        if (setting["scope.record"] == false) {
          showMicGuide();
          resolve(false);
          return;
        }
        uni.authorize({
          scope: "scope.record",
          success: () => {
            resolve(true);
          },
          fail: () => {
            resolve(false);
          },
        });
      },
      fail: () => {
        resolve(false);
      },
    });
  });
  // #endif

  // #ifdef H5 || WEB
  const state = await MicrophonePermissionHelper.check();
  if (state == "granted") {
    return true;
  }
  if (state == "denied") {
    showMicGuide();
    return false;
  }
  const granted = await MicrophonePermissionHelper.request();
  if (granted != true) {
    const after = await MicrophonePermissionHelper.check();
    if (after == "denied") {
      showMicGuide();
    }
  }
  return granted;
  // #endif

  return true;
}

function stopPlayback(): void {
  if (playing.value) {
    playWaveMs = clampedPlayMs(playClockMs());
  }
  playClockStart = 0;
  playToken = playToken + 1;
  playing.value = false;
  const audio = player;
  player = null;
  if (audio != null) {
    audio.stop();
    audio.destroy();
  }
}

function sliceIndexAt(ms: number): number {
  const slices = playSlices();
  for (let i = 0; i < slices.length; i++) {
    const slice = slices[i];
    const end = slice.startMs + slice.durationMs;
    if (ms < end || i == slices.length - 1) {
      return i;
    }
  }
  return 0;
}

function showPlayhead(ms: number): void {
  armPlayClock(ms);
  waveFollowsPlay = true;
  elapsedMs.value = playWaveMs;
  syncLevels();
}

function startPlaybackAt(index: number, offsetMs: number): void {
  const slices = playSlices();
  if (index < 0 || index >= slices.length) {
    stopPlayback();
    return;
  }
  const slice = slices[index];
  let into = offsetMs - slice.startMs;
  if (into < 0) {
    into = 0;
  }
  if (slice.durationMs > 0 && into > slice.durationMs) {
    into = slice.durationMs;
  }
  const previous = player;
  player = null;
  if (previous != null) {
    previous.stop();
    previous.destroy();
  }
  const token = playToken + 1;
  playToken = token;
  const audio = uni.createInnerAudioContext();
  player = audio;
  audio.src = slice.filePath;
  if (into >= 500) {
    audio.startTime = into / 1000;
  }
  audio.onTimeUpdate(() => {
    if (playToken != token) {
      return;
    }
    const reported = slice.startMs + audio.currentTime * 1000;
    const shown = playClockMs();
    // currentTime 经常停在 0 或落后于本地时钟。落后时不要把波浪线拉回去。
    if (reported - shown > 400) {
      armPlayClock(reported);
    }
    elapsedMs.value = playClockMs();
    playWaveMs = elapsedMs.value;
    syncLevels();
  });
  audio.onEnded(() => {
    if (playToken != token) {
      return;
    }
    const next = index + 1;
    if (next >= slices.length) {
      showPlayhead(playableDurationMs());
      stopPlayback();
      return;
    }
    startPlaybackAt(next, slices[next].startMs);
  });
  audio.onError((_err) => {
    if (playToken != token) {
      return;
    }
    stopPlayback();
  });
  playing.value = true;
  showPlayhead(slice.startMs + into);
  audio.play();
}

async function handlePlayToggle(): Promise<void> {
  if (playing.value) {
    stopPlayback();
    return;
  }
  const record = getPanelVoiceNote();
  const wasRecording = record != null && record.phase == "recording";
  const path = await playableLocalVoiceFile();
  if (path.length == 0) {
    return;
  }
  applySnapshot();
  if (wasRecording) {
    playWaveMs = 0;
  } else {
    const total = playableDurationMs();
    if (total > 0 && playWaveMs >= total - 250) {
      playWaveMs = 0;
    }
  }
  showPlayhead(playWaveMs);
  startPlaybackAt(sliceIndexAt(playWaveMs), playWaveMs);
}

async function handleStartTap(): Promise<void> {
  const permitted = await ensureMicPermission();
  if (permitted != true) {
    return;
  }
  stopPlayback();
  showRecordWave();
  await startVoiceNote();
  applySnapshot();
}

function handleStop(): void {
  if (phase.value != "recording") {
    return;
  }
  stopVoiceNote();
  applySnapshot();
}

function handleRerecord(): void {
  uni.showModal({
    title: t("Mobile.Voice.rerecordTitle"),
    content: t("Mobile.Voice.rerecordContent"),
    confirmText: t("Mobile.Voice.rerecordConfirm"),
    cancelText: t("Mobile.Common.cancel"),
    success: (res) => {
      if (res.confirm != true) {
        return;
      }
      stopPlayback();
      discardVoiceNote();
      phase.value = "idle";
      elapsedMs.value = 0;
      recordWaveMs = 0;
      playWaveMs = 0;
      waveFollowsPlay = false;
      statusText.value = "";
      syncLevels();
    },
  });
}

function mainActionLabel(): string {
  if (phase.value == "recording") return "停止录音";
  if (phase.value == "paused") return "继续录音";
  if (phase.value == "idle") return "开始录音";
  return "";
}

function handleMainAction(): void {
  if (phase.value == "recording") {
    handleStop();
    return;
  }
  if (phase.value == "idle" || phase.value == "paused") {
    void handleStartTap();
  }
}

function handleDone(): void {
  stopPlayback();
  finishVoiceNote();
  playWaveMs = 0;
  recordWaveMs = 0;
  waveFollowsPlay = false;
  applySnapshot();
}

function leaveToChat(): void {
  // 录音中返回消息列表或退到后台都不停止采集，会话留在 voiceNoteEngine。
  waveFrozen = true;
  stopUiTimer();
  syncLevels();
  emit("close");
}

function handleBack(): void {
  leaveToChat();
}

function openHistory(): void {
  uni.navigateTo({ url: "/subpackages/pages/voice-record-history/voice-record-history" });
}

onMounted(() => {
  waveFrozen = false;
  applySnapshot();
  startUiTimer();
});

onUnmounted(() => {
  stopPlayback();
  stopUiTimer();
});
</script>

