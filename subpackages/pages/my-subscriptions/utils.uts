import { emptyI18nParams, t as i18nT } from "@/utils/i18n";
import { orEmpty } from "@/utils/utsCoalesce.uts";

const emptyParams = emptyI18nParams();

function t(key: string): string {
  return i18nT(key, emptyParams, "");
}

function readMapValue(map: Map<string, string>, key: string): string {
  const value = map.get(key);
  return value != null ? value : "";
}

function buildPeriodUnitMap(): Map<string, string> {
  const map = new Map<string, string>();
  const perMonth = t("Mobile.MySubscriptions.perMonth");
  const perQuarter = t("Mobile.MySubscriptions.perQuarter");
  const perYear = t("Mobile.MySubscriptions.perYear");
  const perForever = t("Mobile.MySubscriptions.perForever");
  map.set("MONTH", perMonth);
  map.set("1", perMonth);
  map.set("QUARTER", perQuarter);
  map.set("3", perQuarter);
  map.set("YEAR", perYear);
  map.set("12", perYear);
  map.set("FOREVER", perForever);
  return map;
}

function buildFeeLabelMap(): Map<string, string> {
  const map = new Map<string, string>();
  const feeMonth = t("Mobile.MySubscriptions.feeMonth");
  const feeQuarter = t("Mobile.MySubscriptions.feeQuarter");
  const feeYear = t("Mobile.MySubscriptions.feeYear");
  map.set("MONTH", feeMonth);
  map.set("1", feeMonth);
  map.set("QUARTER", feeQuarter);
  map.set("3", feeQuarter);
  map.set("YEAR", feeYear);
  map.set("12", feeYear);
  return map;
}

function buildPayTypeMap(): Map<string, string> {
  const map = new Map<string, string>();
  const monthlyPayment = t("Mobile.MySubscriptions.monthlyPayment");
  const quarterlyPayment = t("Mobile.MySubscriptions.quarterlyPayment");
  const yearlyPayment = t("Mobile.MySubscriptions.yearlyPayment");
  map.set("MONTH", monthlyPayment);
  map.set("1", monthlyPayment);
  map.set("QUARTER", quarterlyPayment);
  map.set("3", quarterlyPayment);
  map.set("YEAR", yearlyPayment);
  map.set("12", yearlyPayment);
  return map;
}

function buildStatusMap(): Map<string, string> {
  const map = new Map<string, string>();
  const subscribing = t("Mobile.MySubscriptions.subscribing");
  const expired = t("Mobile.MySubscriptions.expired");
  map.set("ACTIVE", subscribing);
  map.set("EXPIRED", expired);
  map.set("CANCELLED", expired);
  return map;
}

const periodUnitMap = buildPeriodUnitMap();
const feeLabelMap = buildFeeLabelMap();
const payTypeMap = buildPayTypeMap();
const statusMap = buildStatusMap();

export function getPeriodUnit(period: string | null): string {
  if (period == null) return "";
  return orEmpty(readMapValue(periodUnitMap, period));
}

export function getFeeLabel(period: string | null): string {
  if (period == null) return "";
  return orEmpty(readMapValue(feeLabelMap, period));
}

export function getPayTypeText(period: string | null): string {
  if (period == null) return "";
  return orEmpty(readMapValue(payTypeMap, period));
}

export function getStatusText(status: string): string {
  return orEmpty(readMapValue(statusMap, status));
}

export function isActive(status: string): boolean {
  return status === "ACTIVE";
}

export function isForever(period: string | null): boolean {
  return period === "FOREVER";
}

export function formatMoney(amount: number): string {
  return `¥${amount}`;
}
