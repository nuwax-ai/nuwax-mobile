<template>
  <view class="share-receive">
    <text class="share-receive__title">{{ heading }}</text>
    <text class="share-receive__body">{{ body }}</text>
    <view v-if="kind == 'agent'" class="share-receive__btn" @click="openAgent">
      <text class="share-receive__btn-text">打开智能体</text>
    </view>
    <view v-if="kind == 'file'" class="share-receive__btn" @click="openFile">
      <text class="share-receive__btn-text">打开文件</text>
    </view>
    <view v-if="isInbound" class="share-receive__btn" @click="sendToChat">
      <text class="share-receive__btn-text">发到会话</text>
    </view>
    <view v-if="isInbound" class="share-receive__btn share-receive__btn--ghost" @click="copyBody">
      <text class="share-receive__btn-text share-receive__btn-text--ghost">复制内容</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { onLoad } from "@dcloudio/uni-app";
  import { ref } from "vue";
  import { switchMainTab } from "@/utils/mainTabNavigation";
  import { getApiBaseUrl } from "@/constants/config";

  const kind = ref("");
  const id = ref("");
  const title = ref("");
  const text = ref("");
  const sk = ref("");
  const filePath = ref("");
  const heading = ref("分享");
  const body = ref("");
  const isInbound = ref(false);

  onLoad((options: any) => {
    const obj = options as UTSJSONObject;
    kind.value = obj["kind"] != null ? `${obj["kind"]}` : "";
    id.value = obj["id"] != null ? `${obj["id"]}` : "";
    title.value = obj["title"] != null ? `${obj["title"]}` : "";
    text.value = obj["text"] != null ? `${obj["text"]}` : "";
    sk.value = obj["sk"] != null ? `${obj["sk"]}` : "";
    filePath.value = obj["file"] != null ? `${obj["file"]}` : "";
    isInbound.value = kind.value == "text" || kind.value == "image" || kind.value == "file" || kind.value == "message";
    if (kind.value == "agent") {
      heading.value = title.value.length > 0 ? title.value : "智能体";
      body.value = "免登录可查看入口。登录后可继续对话。";
    } else if (kind.value == "file") {
      heading.value = "分享的文件";
      body.value = "打开后按原有文件预览查看。";
    } else if (kind.value == "image") {
      heading.value = "分享进来的图片";
      body.value = filePath.value.length > 0 ? filePath.value : "已收到图片";
    } else {
      heading.value = title.value.length > 0 ? title.value : "分享进来的内容";
      body.value = text.value.length > 0 ? text.value : "没有可读文本";
    }
  });

  function openAgent(): void {
    if (id.value.length == 0) return;
    uni.navigateTo({
      url: "/subpackages/pages/agent-detail/agent-detail?id=" + id.value,
    });
  }

  function openFile(): void {
    if (sk.value.length == 0) return;
    const fileUrl = getApiBaseUrl() + "/static/file-preview.html?sk=" + encodeURIComponent(sk.value);
    uni.navigateTo({
      url: "/subpackages/pages/webview/webview?noTicket=1&url=" + encodeURIComponent(fileUrl),
    });
  }

  function sendToChat(): void {
    const payload = text.value.length > 0 ? text.value : body.value;
    uni.setClipboardData({
      data: payload,
      success: () => {
        uni.showToast({ title: "已复制，可粘贴到会话", icon: "none" });
        switchMainTab({ url: "/pages/message/message" });
      },
    });
  }

  function copyBody(): void {
    uni.setClipboardData({
      data: body.value,
      success: () => {
        uni.showToast({ title: "已复制", icon: "none" });
      },
    });
  }
</script>

<style lang="scss" scoped>
  .share-receive {
    flex: 1;
    padding: 48rpx 32rpx;
    background-color: #ffffff;
  }

  .share-receive__title {
    font-size: 36rpx;
    color: #1f2329;
    font-weight: 700;
  }

  .share-receive__body {
    margin-top: 24rpx;
    font-size: 28rpx;
    color: #4e5969;
    line-height: 44rpx;
  }

  .share-receive__btn {
    margin-top: 32rpx;
    height: 88rpx;
    border-radius: 16rpx;
    background-color: #5b4dff;
    align-items: center;
    justify-content: center;
  }

  .share-receive__btn--ghost {
    background-color: #ffffff;
    border-width: 1px;
    border-style: solid;
    border-color: #5b4dff;
  }

  .share-receive__btn-text {
    color: #ffffff;
    font-size: 30rpx;
  }

  .share-receive__btn-text--ghost {
    color: #5b4dff;
  }
</style>
