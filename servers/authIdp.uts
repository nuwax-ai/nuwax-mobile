import request from "@/servers/useRequest";
import { isAuthId } from "@/utils/authIdp";
import type { RequestResponse } from "@/types/interfaces/request";

// authorize/callback/bind 是浏览器导航，不能通过 JSON request 调用。
export async function apiAuthIdpList(): Promise<RequestResponse<any>> {
  return await request({ url: "/api/auth/idp/list", method: "GET", timeout: 5000,
    skipAuth: true, skipAuthRedirect: true, suppressErrorToast: true });
}

export async function apiAuthIdentityList(): Promise<RequestResponse<any>> {
  return await request({ url: "/api/user/identity/list", method: "GET", suppressErrorToast: true });
}

export async function apiAuthIdentityUnbind(identityId: string): Promise<RequestResponse<any>> {
  if (!isAuthId(identityId)) throw new Error();
  return await request({ url: "/api/user/identity/unbind/" + identityId, method: "POST", suppressErrorToast: true });
}

// Cookie 成功回跳时由服务端验证会话，不通过可读 Cookie 或 URL 中的 code 推断成功。
export async function apiVerifyIdpSession(): Promise<RequestResponse<any>> {
  return await request({ url: "/api/user/getLoginInfo", method: "GET", skipAuth: true, skipAuthRedirect: true, suppressErrorToast: true });
}
