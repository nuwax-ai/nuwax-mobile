/**
 * 桌宠配网 Mock 数据与场景配置
 *
 * 供 MockBleAdapter 与 test-provision 调试页使用。
 * 对齐项目既有 mock*.uts 风格（导出一批工厂函数/查询函数）。
 */
import { MockScenarioEnum } from '@/types/enums/provision';
import type { BleDeviceInfo } from '@/utils/ble/bleTypes';
import {
  PROV_DEVICE_NAME_PREFIX,
  PROV_MOCK_SCENARIO_STORAGE_KEY,
} from '@/constants/provision.constants';

/** Mock 场景配置项（调试页展示 + 适配器行为参数） */
export interface MockScenarioOption {
  /** 场景枚举值 */
  value: MockScenarioEnum;
  /** 调试页展示名（中文，调试页可硬编码） */
  label: string;
  /** 场景说明 */
  desc: string;
}

/** 全部 Mock 场景（调试页选择器数据源） */
export function mockScenarioOptions(): MockScenarioOption[] {
  return [
    { value: MockScenarioEnum.SUCCESS, label: '成功', desc: '顺利联网成功' },
    { value: MockScenarioEnum.FAIL_WRONG_PASSWORD, label: '密码错误', desc: '联网失败：WiFi 密码错误' },
    { value: MockScenarioEnum.FAIL_AP_NOT_FOUND, label: '找不到AP', desc: '联网失败：AP 不可达' },
    { value: MockScenarioEnum.FAIL_TIMEOUT, label: '超时', desc: '只到 PROVISIONING，触发 30s 超时' },
    { value: MockScenarioEnum.CONNECT_FLAKY, label: '连接抖动', desc: '连接前 2 次失败第 3 次成功' },
    { value: MockScenarioEnum.WRITE_FLAKY, label: '写抖动', desc: '写凭据前 1 次失败' },
    { value: MockScenarioEnum.ALREADY_CONFIGURED, label: '已配置', desc: '订阅即报 ALREADY_CONFIGURED' },
    { value: MockScenarioEnum.UNEXPECTED_DISCONNECT, label: '意外断开', desc: '写入凭据后意外断开' },
  ] as MockScenarioOption[];
}

/** 读取当前 Mock 场景（storage，默认 SUCCESS） */
export function getMockScenario(): MockScenarioEnum {
  const v = uni.getStorageSync(PROV_MOCK_SCENARIO_STORAGE_KEY);
  if (v == null || v == '') return MockScenarioEnum.SUCCESS;
  return v as MockScenarioEnum;
}

/** 设置当前 Mock 场景（写 storage） */
export function setMockScenario(scenario: MockScenarioEnum): void {
  uni.setStorageSync(PROV_MOCK_SCENARIO_STORAGE_KEY, scenario as string);
}

/** 生成模拟扫描到的待配网设备列表 */
export function mockScanDevices(): BleDeviceInfo[] {
  return [
    {
      deviceId: 'AA:BB:CC:DD:EE:01',
      name: `${PROV_DEVICE_NAME_PREFIX}-A001`,
      rssi: -52,
      advertisDataHex: '',
    },
    {
      deviceId: 'AA:BB:CC:DD:EE:02',
      name: `${PROV_DEVICE_NAME_PREFIX}-B023`,
      rssi: -68,
      advertisDataHex: '',
    },
    {
      deviceId: 'AA:BB:CC:DD:EE:03',
      name: `${PROV_DEVICE_NAME_PREFIX}-C107`,
      rssi: -81,
      advertisDataHex: '',
    },
  ] as BleDeviceInfo[];
}

/** 模拟 DEVICE_INFO 原始字节内容（UTF-8 分隔符串 sn|model|firmware） */
export function mockDeviceInfoRaw(deviceId: string): string {
  const sn = deviceId.length > 0 ? deviceId : 'UNKNOWN';
  return `SN${sn}|NUWAX-PET-PRO|v1.0.0`;
}
