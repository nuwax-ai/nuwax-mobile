<template>
  <!-- 完成待办：标题和按钮固定，中间内容超出后单独滚动 -->
  <uni-modal-popup
    ref="popupRef"
    position="bottom"
    height="auto"
    :show-header="false"
    :body-scroll="false"
    :mask-click="true"
    :round="true"
    :close-on-slide-down="false"
    :z-index="1500"
  >
    <view class="sheet">
      <!-- 标题与关闭 -->
      <view class="sheet__head">
        <text class="sheet__head-title">{{ t("Mobile.Discover.todoCompleteTitle") }}</text>
        <view class="sheet__close" @click="close">
          <svg-icon name="icon-X" size="18" unit="px" color="#1f2329" />
        </view>
      </view>
      <!-- 待办标题、责任人、确认文案、附件和补充说明 -->
      <scroll-view class="sheet__scroll" direction="vertical" :show-scrollbar="false" :style="scrollStyle">
        <text class="sheet__title">{{ title }}</text>
        <text v-if="assigneeLine.length > 0" class="sheet__line">{{ assigneeLine }}</text>
        <!-- 创建人在多人待办里选择整体完成或仅自己完成 -->
        <view v-if="showWholeOption()" class="sheet__option sheet__option--first" :class="wholeClass()" @click="selectWhole">
          <view class="sheet__radio" :class="wholeSelected ? 'sheet__radio--on' : ''">
            <view v-if="wholeSelected" class="sheet__radio-dot"></view>
          </view>
          <view class="sheet__option-copy">
            <text class="sheet__option-title">{{ t("Mobile.Discover.todoCompleteWhole") }}</text>
            <text class="sheet__option-desc">{{ t("Mobile.Discover.todoCompleteWholeHint") }}</text>
          </view>
        </view>
        <view v-if="showOwnOption()" class="sheet__option" :class="ownClass()" @click="selectOwn">
          <view class="sheet__radio" :class="wholeSelected ? '' : 'sheet__radio--on'">
            <view v-if="!wholeSelected" class="sheet__radio-dot"></view>
          </view>
          <view class="sheet__option-copy">
            <text class="sheet__option-title">{{ t("Mobile.Discover.todoCompleteMine") }}</text>
            <text class="sheet__option-desc">{{ t("Mobile.Discover.todoCompleteMineHint") }}</text>
          </view>
        </view>
        <view v-if="showPendingWarn()" class="sheet__warn">
          <text class="sheet__warn-text">{{ pendingWarn() }}</text>
        </view>
        <text v-if="showAsk()" class="sheet__ask">{{ askText() }}</text>
        <view class="sheet__label-row">
          <text class="sheet__label">{{ attachLabel() }}</text>
          <text class="sheet__optional">{{ attachHint() }}</text>
        </view>
        <!-- 已选附件。上传中显示转圈，失败后可删除 -->
        <view class="sheet__files">
          <view v-for="(file, index) in files" :key="index" class="sheet__tile" :class="tileEndClass(index)">
            <view class="sheet__card" :class="file.failed ? 'sheet__card--failed' : ''">
              <svg-icon :name="file.icon" size="28" unit="px" color="#5b4dff" />
              <text class="sheet__card-name" :class="file.failed ? 'sheet__card-name--short' : 'text-ellipsis-2'">{{ shortFileName(file.name) }}</text>
              <text v-if="file.failed" class="sheet__card-fail">{{ t("Mobile.Discover.todoUploadFailed") }}</text>
              <view v-if="file.uploading" class="sheet__card-mask">
                <chat-staged-spinner />
              </view>
            </view>
            <view class="sheet__card-remove" @click.stop="removeFile(index)">
              <view class="sheet__x">
                <view class="sheet__x-bar sheet__x-bar--a"></view>
                <view class="sheet__x-bar sheet__x-bar--b"></view>
              </view>
            </view>
          </view>
          <view class="sheet__tile" :class="tileEndClass(files.length)">
            <view class="sheet__add" @click="pickFile">
              <svg-icon name="icon-Plus" size="22" unit="px" color="#8f959e" />
            </view>
          </view>
        </view>
        <!-- 补充说明，选填 -->
        <view class="sheet__label-row">
          <text class="sheet__label">{{ t("Mobile.Discover.todoCompleteRemark") }}</text>
          <text class="sheet__optional">{{ t("Mobile.Discover.todoCompleteOptional") }}</text>
        </view>
        <textarea
          class="sheet__input"
          v-model="remark"
          :maxlength="500"
          :placeholder="t('Mobile.Discover.todoCompleteRemarkPlaceholder')"
          placeholder-style="color: #c9cdd4; font-size: 14px;"
        />
      </scroll-view>
      <!-- 确认完成，停在弹层底部 -->
      <view class="sheet__foot">
        <view class="sheet__done" :class="doneClass()" :hover-class="waitingUpload() ? '' : 'sheet__done--hover'" @click="confirm">
          <text class="sheet__done-text" :class="waitingUpload() ? 'sheet__done-text--wait' : ''">{{ doneText() }}</text>
        </view>
        <safety-zone />
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiErrorMessage, apiResCode, apiResMessage } from "@/utils/apiResponse";
  import { apiCalendarAttachmentDelete, apiCalendarAttachmentUpload, apiCalendarForceComplete, apiCalendarParticipantComplete } from "@/servers/calendar/calendar.uts";
  import { CalendarIdReq, CalendarParticipantCompleteReq } from "@/types/interfaces/calendar";
  import { CalendarCompleteModeEnum } from "@/types/enums/calendar";
  import { getStatusBarHeight } from "@/utils/system.uts";
  import ChatStagedSpinner from "@/components/chat-staged-spinner/chat-staged-spinner.uvue";

  const emit = defineEmits<{
    done: [];
  }>();

  class TodoFile {
    name: string = "";
    path: string = "";
    icon: string = "";
    fileKey: string = "";
    uploading: boolean = false;
    failed: boolean = false;
  }

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const popupRef = ref<any | null>(null);
  const title = ref<string>("");
  const assigneeLine = ref<string>("");
  const remark = ref<string>("");
  const files = ref<TodoFile[]>([]);
  const submitting = ref<boolean>(false);
  const needSubmit = ref<boolean>(false);
  /** 非创建人，且完成模式为需所有人完成。 */
  const ownPart = ref<boolean>(false);
  /** choice：可选整体或仅自己。whole：只能整体完成。空：不展示选项。 */
  const completeScope = ref<string>("");
  /** 整体完成是否选中。仅自己完成时为 false。 */
  const wholeSelected = ref<boolean>(true);
  /** 还没完成自己份额的其他责任人。 */
  const pendingNames = ref<string>("");
  const scrollStyle = ref<string>("");
  let eventId = "";
  let creator = false;

  function waitingUpload(): boolean {
    if (!needSubmit.value) {
      return false;
    }
    const current = files.value;
    for (let i = 0; i < current.length; i++) {
      if (current[i].fileKey.length > 0) {
        return false;
      }
    }
    return true;
  }

  function fileUploading(): boolean {
    const current = files.value;
    for (let i = 0; i < current.length; i++) {
      if (current[i].uploading) {
        return true;
      }
    }
    return false;
  }

  function fileFailed(): boolean {
    const current = files.value;
    for (let i = 0; i < current.length; i++) {
      if (current[i].failed) {
        return true;
      }
    }
    return false;
  }

  function attachLabel(): string {
    if (needSubmit.value) {
      return t("Mobile.Discover.todoCompleteNeedSubmit");
    }
    return t("Mobile.Discover.todoCompleteAttach");
  }

  function attachHint(): string {
    if (needSubmit.value) {
      return t("Mobile.Discover.todoCompleteMinOne");
    }
    return t("Mobile.Discover.todoCompleteOptional");
  }

  function showWholeOption(): boolean {
    return completeScope.value == "choice" || completeScope.value == "whole";
  }

  function showOwnOption(): boolean {
    return completeScope.value == "choice";
  }

  function showAsk(): boolean {
    return completeScope.value.length == 0;
  }

  function showPendingWarn(): boolean {
    return showWholeOption() && wholeSelected.value && pendingNames.value.length > 0;
  }

  function wholeClass(): string {
    if (wholeSelected.value) {
      return "sheet__option--on";
    }
    return "";
  }

  function ownClass(): string {
    if (!wholeSelected.value) {
      return "sheet__option--on";
    }
    return "";
  }

  function finishingOwnPart(): boolean {
    if (completeScope.value == "choice" && !wholeSelected.value) {
      return true;
    }
    return ownPart.value;
  }

  function usesForceComplete(): boolean {
    if (completeScope.value == "whole") {
      return true;
    }
    return completeScope.value == "choice" && wholeSelected.value;
  }

  function pendingWarn(): string {
    const params = new Map<string, string | number>();
    params.set("names", pendingNames.value);
    return translateFn("Mobile.Discover.todoCompletePendingWarn", toI18nParams(params), "");
  }

  function askText(): string {
    if (ownPart.value) {
      return t("Mobile.Discover.todoCompleteOwnAsk");
    }
    return t("Mobile.Discover.todoCompleteAsk");
  }

  function doneText(): string {
    if (waitingUpload()) {
      return t("Mobile.Discover.todoUploadFirst");
    }
    if (finishingOwnPart()) {
      return t("Mobile.Discover.todoCompleteOwn");
    }
    return t("Mobile.Discover.todoConfirmDone");
  }

  function doneClass(): string {
    if (waitingUpload() || fileUploading()) {
      return "sheet__done--wait";
    }
    if (submitting.value) {
      return "sheet__done--busy";
    }
    return "";
  }

  function callPopup(methodName: string): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(methodName);
  }

  function readText(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const text = `${raw}`.trim();
    if (text == "null" || text == "undefined") {
      return "";
    }
    return text;
  }

  function fileLabel(path: string): string {
    let name = path;
    const slash = path.lastIndexOf("/");
    if (slash >= 0 && slash < path.length - 1) {
      name = path.substring(slash + 1);
    }
    return name;
  }

  function lowerName(name: string): string {
    let next = "";
    for (let i = 0; i < name.length; i++) {
      const ch = name.charAt(i);
      const codeRaw = ch.charCodeAt(0);
      if (codeRaw != null) {
        const code = codeRaw as number;
        if (code >= 65 && code <= 90) {
          next += String.fromCharCode(code - 65 + 97);
          continue;
        }
      }
      next += ch;
    }
    return next;
  }

  function hasSuffix(name: string, suffix: string): boolean {
    if (name.length < suffix.length) {
      return false;
    }
    return name.substring(name.length - suffix.length) == suffix;
  }

  function iconFor(name: string): string {
    const lower = lowerName(name);
    if (
      hasSuffix(lower, ".jpg") ||
      hasSuffix(lower, ".jpeg") ||
      hasSuffix(lower, ".png") ||
      hasSuffix(lower, ".gif") ||
      hasSuffix(lower, ".webp") ||
      hasSuffix(lower, ".heic") ||
      hasSuffix(lower, ".bmp")
    ) {
      return "icon-Image";
    }
    if (hasSuffix(lower, ".xls") || hasSuffix(lower, ".xlsx") || hasSuffix(lower, ".csv")) {
      return "icon-List";
    }
    if (hasSuffix(lower, ".zip") || hasSuffix(lower, ".rar") || hasSuffix(lower, ".7z")) {
      return "icon-Folder";
    }
    return "icon-a-Filetext";
  }

  /**
   * 文件名过长时保留开头、结尾和扩展名，中间用 **** 收起，最多大约两行。
   */
  function shortFileName(name: string): string {
    const limit = 18;
    if (name.length <= limit) {
      return name;
    }
    const mark = "****";
    let ext = "";
    let base = name;
    const dot = name.lastIndexOf(".");
    if (dot > 0 && dot < name.length - 1 && name.length - dot <= 8) {
      ext = name.substring(dot);
      base = name.substring(0, dot);
    }
    const room = limit - mark.length - ext.length;
    if (room < 2) {
      return name.substring(0, limit - mark.length) + mark;
    }
    let headCount = 0;
    let rest = room;
    while (rest > 1) {
      headCount = headCount + 1;
      rest = rest - 2;
    }
    const tailCount = room - headCount;
    if (base.length <= room) {
      return base + mark;
    }
    return base.substring(0, headCount) + mark + base.substring(base.length - tailCount) + ext;
  }

  function tileEndClass(index: number): string {
    if (index % 3 == 2) {
      return "sheet__tile--end";
    }
    return "";
  }

  /**
   * 中间区域按内容增高，最多占窗口剩余高度。超出后只滚中间，标题和底部按钮不动。
   */
  function layoutScroll(): void {
    let windowHeight = 0;
    try {
      const info = uni.getSystemInfoSync();
      const raw = info.windowHeight;
      if (raw != null && raw > 0) {
        windowHeight = raw;
      }
    } catch (_e) {
      windowHeight = 0;
    }
    if (windowHeight <= 0) {
      windowHeight = 720;
    }
    let ratio = 0.86;
    // H5 弹层最高 80vh，再高会把底部按钮裁掉。
    // #ifdef H5
    ratio = 0.8;
    // #endif
    const sheetMax = Math.floor(windowHeight * ratio);
    let safety = 0;
    // #ifndef H5
    safety = getStatusBarHeight();
    // #endif
    const chrome = 8 + 48 + 16 + 48 + 12 + safety;
    let scrollMax = sheetMax - chrome;
    if (scrollMax < 160) {
      scrollMax = 160;
    }
    let content = 34;
    if (assigneeLine.value.length > 0) {
      content += 26;
    }
    if (completeScope.value == "choice") {
      content += 16 + 72 + 10 + 72;
    } else if (completeScope.value == "whole") {
      content += 16 + 72;
    }
    if (showPendingWarn()) {
      content += 12 + 64;
    }
    if (showAsk()) {
      content += 46;
    }
    content += 42 + 8 + 42 + 108 + 16;
    const tiles = files.value.length + 1;
    let rows = 1;
    let left = tiles;
    while (left > 3) {
      rows += 1;
      left -= 3;
    }
    content += rows * 128;
    let height = content;
    if (height > scrollMax) {
      height = scrollMax;
    }
    scrollStyle.value = "height: " + height.toString() + "px;";
  }

  function selectWhole(): void {
    if (wholeSelected.value) {
      return;
    }
    wholeSelected.value = true;
    layoutScroll();
  }

  function selectOwn(): void {
    if (!wholeSelected.value) {
      return;
    }
    wholeSelected.value = false;
    layoutScroll();
  }

  function clearFiles(): void {
    const empty: TodoFile[] = [];
    files.value = empty;
  }

  function open(payload: string): void {
    eventId = "";
    creator = false;
    ownPart.value = false;
    completeScope.value = "";
    wholeSelected.value = true;
    pendingNames.value = "";
    needSubmit.value = false;
    title.value = "";
    assigneeLine.value = "";
    remark.value = "";
    clearFiles();
    submitting.value = false;
    try {
      const obj = JSON.parse(payload) as UTSJSONObject | null;
      if (obj != null) {
        eventId = readText(obj, "id");
        title.value = readText(obj, "title");
        assigneeLine.value = readText(obj, "line");
        creator = readText(obj, "creator") == "true";
        needSubmit.value = readText(obj, "submit") == "true";
        completeScope.value = readText(obj, "scope");
        pendingNames.value = readText(obj, "pending");
        wholeSelected.value = true;
        const mode = readText(obj, "mode");
        ownPart.value = !creator && mode == `${CalendarCompleteModeEnum.ALL}`;
      }
    } catch (_error) {
      eventId = "";
    }
    if (eventId.length == 0) {
      return;
    }
    layoutScroll();
    callPopup("open");
  }

  function close(): void {
    callPopup("close");
  }

  function appendFile(name: string, path: string): void {
    const label = name.length > 0 ? name : fileLabel(path);
    if (label.length == 0) {
      return;
    }
    const current = files.value;
    for (let i = 0; i < current.length; i++) {
      if (current[i].path == path && path.length > 0) {
        return;
      }
    }
    const next: TodoFile[] = [];
    for (let i = 0; i < current.length; i++) {
      next.push(current[i]);
    }
    const file = new TodoFile();
    file.name = label;
    file.path = path;
    file.icon = iconFor(label);
    file.uploading = true;
    next.push(file);
    files.value = next;
    layoutScroll();
  }

  function hasFilePath(path: string): boolean {
    const current = files.value;
    for (let i = 0; i < current.length; i++) {
      if (current[i].path == path) {
        return true;
      }
    }
    return false;
  }

  function replaceFile(path: string, uploading: boolean, failed: boolean, fileKey: string): void {
    const current = files.value;
    const next: TodoFile[] = [];
    for (let i = 0; i < current.length; i++) {
      const item = current[i];
      if (item.path != path) {
        next.push(item);
        continue;
      }
      const copy = new TodoFile();
      copy.name = item.name;
      copy.path = item.path;
      copy.icon = item.icon;
      copy.fileKey = fileKey;
      copy.uploading = uploading;
      copy.failed = failed;
      next.push(copy);
    }
    files.value = next;
  }

  function dropFilePath(path: string): void {
    const current = files.value;
    const next: TodoFile[] = [];
    for (let i = 0; i < current.length; i++) {
      if (current[i].path != path) {
        next.push(current[i]);
      }
    }
    files.value = next;
    layoutScroll();
  }

  function showError(error: any): void {
    const message = apiErrorMessage(error);
    if (message.length > 0) {
      uni.showToast({ title: message, icon: "none" });
    }
  }

  async function uploadPicked(name: string, path: string): Promise<void> {
    if (path.length == 0) {
      return;
    }
    appendFile(name, path);
    try {
      const fileKey = await apiCalendarAttachmentUpload(path);
      if (!hasFilePath(path)) {
        await apiCalendarAttachmentDelete();
        return;
      }
      replaceFile(path, false, false, fileKey);
    } catch (error) {
      if (hasFilePath(path)) {
        replaceFile(path, false, true, "");
      }
      showError(error);
    }
  }

  function pickFile(): void {
    uni.chooseFile({
      count: 9,
      type: "all",
      success: (res) => {
        const picked = res.tempFiles;
        for (let i = 0; i < picked.length; i++) {
          const file = picked[i];
          let name = "";
          if (file.name != null && `${file.name}`.length > 0) {
            name = `${file.name}`;
          }
          uploadPicked(name, file.path);
        }
      },
    });
  }

  async function removeFile(index: number): Promise<void> {
    const current = files.value;
    if (index < 0 || index >= current.length) {
      return;
    }
    const removed = current[index];
    if (removed.fileKey.length > 0) {
      try {
        const res = await apiCalendarAttachmentDelete();
        if (apiResCode(res) != SUCCESS_CODE) {
          const message = apiResMessage(res);
          if (message.length > 0) {
            uni.showToast({ title: message, icon: "none" });
          }
          return;
        }
      } catch (error) {
        showError(error);
        return;
      }
    }
    if (removed.path.length > 0) {
      dropFilePath(removed.path);
      return;
    }
    const latest = files.value;
    const next: TodoFile[] = [];
    for (let i = 0; i < latest.length; i++) {
      if (i != index) {
        next.push(latest[i]);
      }
    }
    files.value = next;
    layoutScroll();
  }

  function collectFileKeys(): string[] {
    const current = files.value;
    const keys: string[] = [];
    for (let i = 0; i < current.length; i++) {
      const file = current[i];
      if (file.failed || file.uploading || file.fileKey.length == 0) {
        continue;
      }
      keys.push(file.fileKey);
    }
    return keys;
  }

  async function confirm(): Promise<void> {
    if (submitting.value || eventId.length == 0 || waitingUpload() || fileUploading()) {
      return;
    }
    if (fileFailed()) {
      uni.showToast({ title: t("Mobile.Discover.todoUploadFailed"), icon: "none" });
      return;
    }
    submitting.value = true;
    try {
      const fileKeys = collectFileKeys();
      const note = remark.value.trim();
      if (needSubmit.value && fileKeys.length == 0) {
        submitting.value = false;
        return;
      }
      if (usesForceComplete()) {
        const forceQuery = new CalendarIdReq();
        forceQuery.id = eventId;
        const forceRes = await apiCalendarForceComplete(forceQuery);
        if (apiResCode(forceRes) == SUCCESS_CODE) {
          close();
          emit("done");
        }
        submitting.value = false;
        return;
      }
      const query = new CalendarParticipantCompleteReq();
      query.id = eventId;
      if (fileKeys.length > 0) {
        query.completeFileKeys = fileKeys;
      }
      if (note.length > 0) {
        query.completeRemark = note;
      }
      const res = await apiCalendarParticipantComplete(query);
      if (apiResCode(res) == SUCCESS_CODE) {
        close();
        emit("done");
      }
    } catch (error) {
      const message = apiErrorMessage(error);
      if (message.length > 0) {
        uni.showToast({ title: message, icon: "none" });
      }
    }
    submitting.value = false;
  }

  defineExpose({
    open: open as any,
    close: close as any,
  });
</script>

<style scoped>
  .sheet {
    padding: 8px 16px 12px;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
  }

  .sheet__head {
    height: 48px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
  }

  .sheet__scroll {
    flex-shrink: 0;
  }

  .sheet__foot {
    margin-top: 16px;
    flex-shrink: 0;
  }

  .sheet__head-title {
    font-size: 17px;
    font-weight: 600;
    color: #1f2329;
    text-align: center;
  }

  .sheet__close {
    position: absolute;
    right: 0;
    top: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sheet__title {
    margin-top: 8px;
    font-size: 18px;
    line-height: 26px;
    font-weight: 600;
    color: #1f2329;
  }

  .sheet__line {
    margin-top: 6px;
    font-size: 14px;
    line-height: 20px;
    color: #86909c;
  }

  .sheet__option {
    margin-top: 10px;
    padding: 12px 14px;
    border-radius: 12px;
    border-width: 1px;
    border-style: solid;
    border-color: #e5e6eb;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }

  .sheet__option--first {
    margin-top: 16px;
  }

  .sheet__option--on {
