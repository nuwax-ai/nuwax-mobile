<template>
  <uni-modal-popup ref="popupRef" position="bottom" :height="sheetHeight" :show-header="false" :body-scroll="false" @update-visible="handleVisibleChange">
    <view class="sheet" :class="{ 'sheet--avoid-tab-bar': avoidTabBar }">
      <view class="sheet-handle" />
      <view class="media-grid">
        <view class="media-card" @tap.stop="selectAction('camera')"><svg-icon name="icon-Camera" size="48" /><text class="media-text">{{ t("Mobile.Chat.takePhoto") }}</text></view>
        <view class="media-card" @tap.stop="selectAction('album')"><svg-icon name="icon-Image" size="48" /><text class="media-text">{{ t("Mobile.CreateHub.photoVideo") }}</text></view>
        <view class="media-card" @tap.stop="selectAction('file')"><svg-icon name="icon-Folder" size="48" /><text class="media-text">{{ t("Mobile.CreateHub.phoneFiles") }}</text></view>
      </view>
      <scroll-view v-if="agentType != 'ChatBot'" class="action-list" direction="vertical" :show-scrollbar="false">
        <!-- 实测节点：行内 switch 等原生控件行高随平台浮动，面板高度以该节点实测为准 -->
        <view class="action-list-inner">
          <view v-if="showExpert" class="action-row" @tap.stop="selectAction('expert')"><view class="action-icon"><text class="action-symbol">@</text></view><text class="action-name">{{ t("Mobile.CreateHub.mentionExpert") }}</text></view>
          <view v-if="showSkill" class="action-row" @tap.stop="selectAction('skill')"><view class="action-icon"><text class="action-symbol">/</text></view><text class="action-name">{{ t("Mobile.CreateHub.selectSkill") }}</text></view>
          <view class="action-row" @tap.stop="selectAction('connector')">
            <view class="action-icon"><svg-icon name="icon-Link" size="36" /></view>
            <text class="action-name">{{ t("Mobile.CreateHub.connector") }}</text>
            <!-- 对齐 PC：ChatBot 类型智能体不展示头像组；超 3 个显示 2 个 + 尾部 +(N-2)（antd Avatar.Group maxCount=3 语义） -->
            <view
              v-if="agentType != 'ChatBot' && connectedConnectors.length > 0"
              class="connector-avatar-group"
              @tap.stop="selectAction('connectorConnected')"
            >
              <view v-for="(connector, index) in visibleConnectorAvatars" :key="connector.key" class="connector-avatar" :style="{ zIndex: `${10 - index}` }">
                <agent-icon v-if="connector.icon.length > 0" :icon="connector.icon" :alt="connector.name" :size="48" :margin-right="0" />
                <text v-else class="connector-avatar-fallback">{{ connector.name.length > 0 ? connector.name.substring(0, 1) : "C" }}</text>
              </view>
              <view v-if="connectedConnectorOverflow > 0" class="connector-avatar connector-avatar--more">
                <text class="connector-avatar-more">+{{ connectedConnectorOverflow }}</text>
              </view>
            </view>
          </view>
          <view class="action-row" @tap.stop="selectAction('knowledge')"><view class="action-icon"><svg-icon name="icon-a-Filetext" size="36" /></view><text class="action-name">{{ t("Mobile.CreateHub.knowledgeBase") }}</text></view>
          <view class="action-divider" />
          <view class="action-row"><view class="action-icon"><svg-icon name="icon-Clock" size="36" /></view><text class="action-name">{{ t("Mobile.CreateHub.versionManagement") }}</text><switch class="row-switch" :checked="versionEnabled" :disabled="switchDisabled" color="#5147ff" @change="handleVersionControlChange" /></view>
          <view v-if="versionEnabled" class="action-row"><view class="action-icon"><svg-icon name="icon-branch" size="36" /></view><text class="action-name">{{ t("Mobile.CreateHub.autoCommit") }}</text><switch class="row-switch" :checked="autoCommitEnabled" :disabled="switchDisabled" color="#5147ff" @change="handleAutoCommitChange" /></view>
          <view class="action-row"><view class="action-icon"><svg-icon name="icon-seal" size="36" /></view><text class="action-name">{{ t("Mobile.CreateHub.approvalMode") }}</text><switch class="row-switch" :checked="approvalEnabled" :disabled="switchDisabled" color="#5147ff" @change="handleApprovalChange" /></view>
        </view>
      </scroll-view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { computed, getCurrentInstance, ref, watch, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import AgentIcon from "@/components/agent-icon/agent-icon.uvue";
  import { apiConnectorProviderList } from "@/servers/connector";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { t as tRaw, emptyI18nParams } from "@/utils/i18n";
  const t = (key: string): string => tRaw(key, emptyI18nParams(), "");
  const props = withDefaults(defineProps<{ visible: boolean; approvalEnabled?: boolean; versionEnabled?: boolean; autoCommitEnabled?: boolean; switchDisabled?: boolean; showSkill?: boolean; showExpert?: boolean; avoidTabBar?: boolean; agentType?: string; }>(), { visible: false, approvalEnabled: false, versionEnabled: false, autoCommitEnabled: true, switchDisabled: false, showSkill: false, showExpert: true, avoidTabBar: false, agentType: "ChatBot" });
  const emit = defineEmits<{ (e: "close"): void; (e: "action", action: string): void; (e: "version-control-change", value: boolean): void; (e: "auto-commit-change", value: boolean): void; (e: "approval-change", value: boolean): void; }>();
  const popupRef = ref<any | null>(null);
  class ConnectorMenuAvatar {
    key: string = "";
    name: string = "";
    icon: string = "";
  }
  const connectedConnectors = ref<ConnectorMenuAvatar[]>([] as ConnectorMenuAvatar[]);
  /** 头像组展示项（对齐 antd Avatar.Group maxCount=3：超 3 个显示前 2 个 + "+N"） */
  const visibleConnectorAvatars = computed((): ConnectorMenuAvatar[] => {
    const list = connectedConnectors.value;
    return list.length > 3 ? [list[0], list[1]] : list;
  });
  const connectedConnectorOverflow = computed((): number => connectedConnectors.value.length > 3 ? connectedConnectors.value.length - 2 : 0);
  /**
   * 底部内边距（px）：与 .sheet / .sheet--avoid-tab-bar 的 padding-bottom 逐端对齐，
   * JS 多算或少算都会让 H5 外层 body（overflow:auto）出现滚动条。
   */
  function sheetBottomPaddingPx(rpxToPx: number): number {
    let bottomPx = 16 * rpxToPx;
    // #ifdef H5
    if (props.avoidTabBar == true) {
      // CSS 为 calc(100rpx + env(safe-area-inset-bottom))，需加上同值
      const info = uni.getWindowInfo();
      const safeBottom = info.safeAreaInsets != null ? info.safeAreaInsets.bottom : 0;
      bottomPx = 100 * rpxToPx + safeBottom;
    }
    // #endif
    return bottomPx;
  }
  /**
   * 兜底估算，仅作打开首帧的初始高度：switch 等原生控件行高随平台浮动，
   * 精确高度由 measureSheetHeight 打开后实测校准。
   */
  function estimateSheetHeightPx(): number {
    const info = uni.getWindowInfo();
    const windowWidth = info.windowWidth != null ? info.windowWidth : 375;
    const windowHeight = info.windowHeight != null ? info.windowHeight : 667;
    const rpxToPx = windowWidth / 750;
    let contentRpx = 18 + 42 + 154 + 16; // 顶部 padding、拖拽条、媒体卡、底部留白
    if (props.agentType != "ChatBot") {
      let rowCount = 4; // 连接器、知识库、版本管理、审批模式
      if (props.showExpert) rowCount += 1;
      if (props.showSkill) rowCount += 1;
      if (props.versionEnabled) rowCount += 1;
      contentRpx += 18 + rowCount * 80 + 14; // 列表间距、菜单行、分隔线
    }
    const contentPx = contentRpx * rpxToPx + sheetBottomPaddingPx(rpxToPx);
    return Math.ceil(Math.min(contentPx, windowHeight * 0.7));
  }
  /** 实测面板高度（px）；-1 = 尚未实测。70% 视口内正好容纳内容，超出才由 action-list 滚动。 */
  const measuredSheetHeightPx = ref<number>(-1);
  const sheetHeight = computed((): string => {
    const measured = measuredSheetHeightPx.value;
    return `${measured >= 0 ? measured : estimateSheetHeightPx()}px`;
  });

  const instance = getCurrentInstance();

  /** 打开后实测菜单区真实高度并校准面板高度（行内原生 switch、i18n 换行等估算覆盖不了）。 */
  function measureSheetHeight(attempt: number): void {
    if (props.agentType == "ChatBot") return; // 无菜单列表，估算即精确
    const proxy = instance != null ? instance.proxy : null;
    if (proxy == null) return;
    uni.createSelectorQuery()
      .in(proxy)
      .select(".action-list-inner")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        if (results.length == 0 || results[0] == null || (results[0] as NodeInfo).height == null) {
          if (props.visible == true && attempt < 3) setTimeout((): void => measureSheetHeight(attempt + 1), 120);
          return;
        }
        const rect = results[0] as NodeInfo;
        const innerHeight = parseFloat(`${rect.height}`);
        if (innerHeight <= 0) {
          if (props.visible == true && attempt < 3) setTimeout((): void => measureSheetHeight(attempt + 1), 120);
          return;
        }
        const info = uni.getWindowInfo();
        const windowWidth = info.windowWidth != null ? info.windowWidth : 375;
        const windowHeight = info.windowHeight != null ? info.windowHeight : 667;
        const rpxToPx = windowWidth / 750;
        const chromePx = (18 + 42 + 154 + 18) * rpxToPx; // 顶部 padding、拖拽条、媒体卡、列表上边距
        // +2px 吸收 rpx→px 逐元素取整误差，防止亚像素溢出触发滚动条
        const heightPx = Math.ceil(chromePx + innerHeight + sheetBottomPaddingPx(rpxToPx) + 2);
        measuredSheetHeightPx.value = Math.min(heightPx, Math.floor(windowHeight * 0.7));
      });
  }
  let connectorRequestId = 0;

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  async function loadConnectedConnectors(): Promise<void> {
    const requestId = connectorRequestId + 1;
    connectorRequestId = requestId;
    try {
      const res = await apiConnectorProviderList(1, 9999, "", "true", "", "", 0);
      if (requestId != connectorRequestId || apiResCode(res) != SUCCESS_CODE) return;
      const dataRaw = apiResData<any>(res);
      let rows = [] as any[];
      if (dataRaw != null) {
        if (Array.isArray(dataRaw)) rows = dataRaw as any[];
        else {
          const data = dataRaw as UTSJSONObject;
          const records = data["records"];
          if (records != null) rows = records as any[];
        }
      }
      const next = [] as ConnectorMenuAvatar[];
      for (let i = 0; i < rows.length; i++) {
        const raw = rows[i] as UTSJSONObject;
        const item = new ConnectorMenuAvatar();
        item.key = readString(raw, "service");
        if (item.key.length == 0) item.key = readString(raw, "id");
        item.name = readString(raw, "displayName");
        if (item.name.length == 0) item.name = readString(raw, "service");
        item.icon = readString(raw, "icon");
        next.push(item);
      }
      connectedConnectors.value = next;
    } catch (_error) {
      if (requestId == connectorRequestId) connectedConnectors.value = [] as ConnectorMenuAvatar[];
    }
  }
  function callPopup(method: string): void { if (popupRef.value != null) (popupRef.value as ComponentPublicInstance).$callMethod(method); }
  function handleVisibleChange(value: boolean): void { if (value != true) emit("close"); }
  function selectAction(action: string): void { emit("action", action); if (action != "approval" && action != "version") callPopup("close"); }
  function handleVersionControlChange(e: UniSwitchChangeEvent): void { emit("version-control-change", e.detail.value); }
  function handleAutoCommitChange(e: UniSwitchChangeEvent): void { emit("auto-commit-change", e.detail.value); }
  function handleApprovalChange(e: UniSwitchChangeEvent): void { emit("approval-change", e.detail.value); }
  watch((): boolean => props.visible, (value: boolean): void => {
    if (value) {
      callPopup("open");
      if (props.agentType != "ChatBot") loadConnectedConnectors();
      // 首帧布局后实测校准，落在弹层入场动画（300ms）内完成，避免可见的高度跳变
      setTimeout((): void => measureSheetHeight(0), 60);
    } else callPopup("close");
  });
  // 打开状态下切换「版本管理」会增删「自动提交」行，须重测适配
  watch((): boolean => props.versionEnabled, (_value: boolean): void => {
    if (props.visible == true) setTimeout((): void => measureSheetHeight(0), 80);
  });
</script>

<style lang="scss" scoped>
  .sheet { display: flex; flex-direction: column; height: 100%; padding: 18rpx 32rpx 16rpx; background: #fff; box-sizing: border-box; }
  /* #ifdef H5 */
  .sheet--avoid-tab-bar { padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
  /* #endif */
  .sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 34rpx; border-radius: 999rpx; background: #dedee8; }
  .media-grid { display: flex; flex-direction: row; }
  .media-card { flex: 1; height: 154rpx; margin-right: 18rpx; border-radius: 26rpx; background: #f5f4f8; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .media-card:last-child { margin-right: 0; }
  .media-text { margin-top: 18rpx; color: #2c2c33; font-size: 27rpx; }
  .action-list { flex: 1; min-height: 0; margin-top: 18rpx; }
  /* 实测节点：scroll-view 内容以纯列布局包裹，高度即菜单区真实内容高 */
  .action-list-inner { display: flex; flex-direction: column; }
  .action-row { min-height: 80rpx; display: flex; flex-direction: row; align-items: center; padding: 4rpx 8rpx; box-sizing: border-box; }
  .row-switch { flex-shrink: 0; transform: scale(0.72); transform-origin: right center; }
  .action-icon { width: 64rpx; height: 64rpx; border-radius: 50%; background: #f3f2f6; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .action-symbol { color: #25252d; font-size: 40rpx; line-height: 48rpx; }
  .action-name { flex: 1; margin-left: 22rpx; color: #292930; font-size: 29rpx; }
  .connector-avatar-group { flex-shrink: 0; display: flex; flex-direction: row; align-items: center; padding-right: 4rpx; }
  .connector-avatar { width: 56rpx; height: 56rpx; margin-left: -12rpx; border: 4rpx solid #ffffff; border-radius: 999rpx; background-color: #f0eff8; display: flex; align-items: center; justify-content: center; overflow: hidden; box-sizing: border-box; }
  .connector-avatar:first-child { margin-left: 0; }
  .connector-avatar--more { z-index: 0; background-color: #eeeef3; }
  .connector-avatar-fallback { color: #5147ff; font-size: 24rpx; font-weight: 700; }
  .connector-avatar-more { color: #686873; font-size: 22rpx; font-weight: 600; }
  .action-divider { height: 2rpx; margin: 6rpx 0; background: #eeeef2; }
</style>
