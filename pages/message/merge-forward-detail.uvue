<template>
  <view class="mfd-page">
    <safety-zone />

    <!-- 顶部：返回 + 标题（与引用详情页同款双段头） -->
    <view class="mfd-header">
      <view class="mfd-header__btn" hover-class="mfd-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="mfd-header__title-wrap">
        <text class="mfd-header__title">{{ displayTitle }}</text>
      </view>
      <view class="mfd-header__btn mfd-header__btn--ghost" />
    </view>

    <!-- 记录列表：头像 + 发送者/时间 + 内容 -->
    <scroll-view class="mfd-body" direction="vertical" :show-scrollbar="false">
      <view v-for="(it, i) in items" :key="i" class="mfd-row">
        <view class="mfd-row__avatar" :style="{ backgroundImage: avatarGradient(it.senderName) }">
          <text class="mfd-row__avatar-letter">{{ avatarLetter(it.senderName) }}</text>
        </view>
        <view class="mfd-row__rest">
          <view class="mfd-row__title-row">
            <text class="mfd-row__name text-ellipsis">{{ senderNameOf(it) }}</text>
            <text class="mfd-row__time">{{ formatRecordTime(it.sendTime) }}</text>
          </view>
          <!-- 正文（原始文本，非占位归一值；图文混排快照文本与图片并列展示）。
               嵌套 text 分段渲染：裸 http(s) 地址与 [标题](url) 按链接样式展示、点击打开
               （口径同聊天正文；快照不存富文本标记，只拆链接） -->
          <text v-if="it.text.length > 0" class="mfd-row__text"><text
            v-for="(sg, k) in textSegsOf(it)"
            :key="k"
            :class="sg.link ? 'mfd-row__link' : ''"
            @click="handleTextSegTap(sg)"
          >{{ sg.text }}</text></text>
          <!-- 图片附件（kind=image 快照）：缩略图网格，点击全屏预览；受保护 /api/f/ 地址
               onLoad 异步解析（ak 直链优先，失败回落整段下载）回填后整表重建出图
               （chat.uvue resolveRowMedia 同款）；点击时若仍为受保护原址再现场解析一次 -->
          <view v-if="it.images.length > 0" class="mfd-media">
            <view v-for="(img, k) in it.images" :key="k" class="mfd-media__cell" @click="handleImageTap(img)">
              <!-- 挂载闸门（mergeImgMountOk）：快照原值是发送端本机路径 → 只画灰底（点按提示
                   加载失败）；鸿蒙另外要求受保护原址先不挂节点（已挂 <image> 换新 src 不重绘，
                   解析出本地 temp 后由 v-if 新建节点才出图，聊天页 harmonyImgGateOk 同款） -->
              <image
                v-if="mergeImgMountOk(img.url)"
                class="mfd-media__img"
                :src="img.url"
                mode="aspectFill"
                @error="handleImageRenderError(img)"
              />
              <view v-else class="mfd-media__img" />
            </view>
          </view>
          <!-- 视频附件（kind=video / kind=file 实为视频）：内联原生 <video>（chat.uvue 同款
               预载策略——onLoad 解析可播地址回填 playUrl ⇒ 常驻播放器首帧即封面，交给系统
               播放键点播；未预载/失败回落深色占位卡：进度文案 / ▶ 手动重试）。
               ★playUrl/videoLoadingId/videoLoadPercent 须在模板表达式直读（App-Android
               方法调用绑定不收集方法体内依赖）；预载挂载后轻触视频任意位置切换播放/暂停
               （原生中央播放键只覆盖中心小区域）。
               ★App 三端行内关系统控制条、改用自绘条 <chat-video-bar>（系统条时间文案不可调
               字号，时长一长就把全屏键挤出去），全屏态反过来开 controls（退出键挂在同一闸门后，
               见 utils/chatVideoControl.uts）。
               ★iOS 勿往 <video> 挂子组件（全屏切换子节点销毁闪退 #22070） -->
          <view v-for="(v, k) in it.videos" :key="'v' + k" class="mfd-video" @click="handleVideoTap(v)">
            <video
              v-if="v.playUrl.length > 0"
              :id="'mfdVideoPlayer-' + v.uid"
              class="mfd-video__player"
              :src="v.playUrl"
              <!-- #ifdef APP -->
              :controls="videoFullscreen"
              <!-- #endif -->
              <!-- #ifndef APP -->
              :controls="true"
              :show-fullscreen-btn="true"
              <!-- #endif -->
              :title="fileDisplayNameOf(v)"
              object-fit="contain"
              @play="handleVideoPlaying(v.uid)"
              @pause="handleVideoPaused(v.uid)"
              @timeupdate="handleVideoTimeUpdate(v.uid, $event)"
              @ended="handleVideoEnded(v.uid)"
              @error="handleVideoError(v)"
              @fullscreenchange="handleVideoFullscreenChange(v.uid, $event)"
            ></video>
            <view v-else class="mfd-video__poster">
              <!-- 预载中只显进度；未预载/失败显 ▶ 可点重试（成功即被 <video> 首帧顶替） -->
              <text v-if="v.uid == videoLoadingId && videoLoadPercent >= 0" class="mfd-video__hint">{{ t("Mobile.FileTree.downloading") }} {{ videoLoadPercent }}%</text>
              <text v-else-if="v.uid == videoLoadingId" class="mfd-video__hint">{{ t("Mobile.FileTree.downloading") }}</text>
              <view v-else class="mfd-video__play">
                <image class="mfd-video__play-icon" src="/static/images/icon-video-play.png" mode="aspectFit" />
              </view>
            </view>
            <!-- #ifdef APP -->
            <!-- 自绘控制条（chat.uvue 同款，放在 v-if/v-else 之后别顶开 poster 的 v-else） -->
            <chat-video-bar v-if="v.playUrl.length > 0" :player-id="'mfdVideoPlayer-' + v.uid" />
            <!-- #endif -->
          </view>
          <!-- 语音附件（kind=audio）：声波气泡，点按播放/再点停止（chat.uvue 同款——页面级
               单一播放实例，播放中声波跳动换主题色；快照无时长字段，首播后回填真值） -->
          <view
            v-for="(a, k) in it.audios"
            :key="'a' + k"
            class="mfd-voice"
            :class="a.uid == playingAudioId ? 'mfd-voice--playing' : ''"
            @click="handleAudioTap(a)"
          >
            <view class="mfd-voice__bar" :style="{ height: voiceBarH(a, 0, voiceTick) + 'px' }" />
            <view class="mfd-voice__bar" :style="{ height: voiceBarH(a, 1, voiceTick) + 'px' }" />
            <view class="mfd-voice__bar" :style="{ height: voiceBarH(a, 2, voiceTick) + 'px' }" />
            <view class="mfd-voice__bar" :style="{ height: voiceBarH(a, 3, voiceTick) + 'px' }" />
            <text v-if="a.duration > 0" class="mfd-voice__dur">{{ audioDurationLabelOf(a) }}</text>
          </view>
          <!-- 文件附件（kind=file 真文件）：微信式文件卡片（左：名称两行 + 大小/下载状态；
               右：类型图标），点击进文件详情页（下载/打开在该页完成） -->
          <view
            v-for="(f, k) in it.files"
            :key="'f' + k"
            class="mfd-file"
            hover-class="mfd-file--active"
            @click="handleFileTap(f)"
          >
            <view class="mfd-file__col">
              <text class="mfd-file__name text-ellipsis-2">{{ fileDisplayNameOf(f) }}</text>
              <text class="mfd-file__meta">{{ fileMetaText(f, downloadTick) }}</text>
            </view>
            <view class="mfd-file__icon-wrap">
              <file-type-icon :file-name="f.fileName" :url="f.url" :size="96" />
            </view>
          </view>
          <!-- 无文本且无媒体：类型占位兜底 -->
          <text
            v-if="it.text.length == 0 && it.images.length == 0 && it.videos.length == 0 && it.audios.length == 0 && it.files.length == 0"
            class="mfd-row__text"
          >{{ it.preview }}</text>
        </view>
      </view>
      <view v-if="items.length == 0" class="mfd-state">
        <text class="mfd-state__text">{{ t("Mobile.Message.imSearchEmpty") }}</text>
      </view>
      <view class="mfd-bottom-space" />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { objectI18nParams } from "@/utils/i18nParams";

  import { switchMainTab } from "@/utils/mainTabNavigation";
  import { isAppInBackground } from "@/utils/appLifecycle";

  import { computed, ref } from "vue";
  import { onHide, onLoad, onShow, onUnload } from "@dcloudio/uni-app";
  import { ImMergeItem, ImMergeMedia } from "@/types/interfaces/imMergeItem";
  import { takeImMergeRecord } from "@/utils/im/imMergeRecordSession";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { isRemoteSvgUrl, resolveDisplayImageUrl } from "@/utils/remoteSvgImage";
  import {
    buildAuthProtectedFileHeaders,
    extractFileNameFromUrl,
    fetchAuthProtectedFileAkUrl,
    fetchAuthProtectedFileDisplayUrl,
    isAuthProtectedFileUrl,
    openAuthProtectedLinkUrl,
    releaseDisplayImageUrl,
    resolveAuthProtectedFileFetchUrl,
  } from "@/utils/authProtectedFileUrl";
  import { getApiBaseUrl } from "@/constants/config";
  import { handleExternalLinkInWebview } from "@/utils/system";
  import { previewImageCompat } from "@/utils/appWebViewImagePreview";
  import { formatFileSize } from "@/utils/imFileCard";
  // 视频播放态/进度/全屏态（模块级 ref）：自绘控制条 components/chat-video-bar 与页面事件共用
  import {
    chatVideoFullscreen,
    confirmChatVideoFullscreen,
    isChatVideoPlaying,
    setChatVideoFullscreen,
    setChatVideoPlaying,
    updateChatVideoProgress,
  } from "@/utils/chatVideoControl.uts";
  // #ifdef APP
  import { isImFileDownloadedNow } from "@/subpackages/utils/fileTree";
  // #endif

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ===== 记录数据（onLoad 从暂存会话取：title + convId + 全量条目） =====
  const title = ref<string>("");
  /** 源会话 id（承载 merge_forward 消息的会话；文件点击跳预览页带它，同聊天气泡路由）。 */
  const convId = ref<string>("");
  const items = ref<ImMergeItem[]>([] as ImMergeItem[]);
  /** 下载状态重渲 tick：App-Android 模板方法调用不收集依赖（chat.uvue readInfoTick 先例），
   *  从文件详情页返回时（onShow）自增驱动文件卡片「已下载/未下载」文案重估。 */
  const downloadTick = ref<number>(0);

  // ===== 媒体解析态（受保护 /api/f/ 缩略图回填）=====
  let pageDisposed = false;
  let mediaRefreshTimer = 0;
  /** 已解析出的独占展示地址（blob/临时文件），onUnload 统一释放。 */
  const resolvedMediaUrls: string[] = [];
  /** 缩略图显示边长 rpx（与 .mfd-media__img 尺寸对齐，喂给解析器出图）。 */
  const MERGE_IMG_DISPLAY_RPX = 240;
  /** 原始地址 → 已解析展示地址（重渲/点按预览免二次解析）。 */
  const mergeImgResolved = new Map<string, string>();
  /** 在途解析去重（同地址并发共享同一次解析）。 */
  const mergeImgRequests = new Map<string, Promise<string>>();
  /** ak 直链地址 → 原始受保护地址（ak 加载失败时回退整段下载用，聊天页 chatImageAkOrigins 同款）。 */
  const mergeImgAkOrigins = new Map<string, string>();
  /** 已走过一次 ak 失败自愈的原始地址（每页至多一次，坏图不无限重试）。 */
  const mergeImgSelfHealed = new Set<string>();
  /** 快照里「发送端本机路径」形态的附件地址（onLoad 解析前登记）：2026-11-13 真机事故
   *  ——鸿蒙端转发把 `/data/storage/el2/base/cache/uni-download/…jpg` 写进了服务端，
   *  接收端（Android）既画不出也不该反复下载。★只登记快照原值（解析前的 img.url），
   *  本端解析产物（temp/blob/file://）绝不入此集合，否则会误杀正常展示地址。 */
  const mergeForeignLocalUrls = new Set<string>();

  /** 地址是否是「别的设备上的本机路径」：跨端必然取不到（鸿蒙 /data/storage/…、
   *  Android /storage/…、iOS /var/ /private/…、file:// / content:// / blob:）。
   *  仅用于判定快照原值，不要拿去判本端解析后的展示地址。 */
  function isForeignLocalMediaUrl(url: string): boolean {
    if (url.length == 0) {
      return false;
    }
    if (url.indexOf("file://") == 0 || url.indexOf("content://") == 0 || url.indexOf("blob:") == 0) {
      return true;
    }
    if (url.indexOf("/data/") == 0 || url.indexOf("/storage/") == 0 ||
        url.indexOf("/var/") == 0 || url.indexOf("/private/") == 0) {
      return true;
    }
    // 旧版本把本机路径当站内相对路径补成域名后的形态：https://host/data/storage/…
    if (url.indexOf("http://") == 0 || url.indexOf("https://") == 0) {
      return url.indexOf("/data/storage/") >= 0 || url.indexOf("/storage/emulated/") >= 0;
    }
    return false;
  }
  // #ifdef APP-HARMONY
  /** 鸿蒙受保护图解析总尝试次数（退避 400ms×n，对齐聊天页 HARMONY_IMG_RESOLVE_MAX_ATTEMPTS）。 */
  const MERGE_IMG_MAX_ATTEMPTS = 3;
  // #endif

  /** 浅拷贝整表（Android 不追踪 ref 数组内实例属性的原地变更，回填后须整表重建赋值）。 */
  function copyItems(rows: ImMergeItem[]): ImMergeItem[] {
    const out: ImMergeItem[] = [];
    for (let i = 0; i < rows.length; i++) {
      out.push(rows[i]);
    }
    return out;
  }

  /** 50ms 去抖整表重建（多张图并发解析回填合并成一次重渲，chat.uvue scheduleChatMediaRefresh 同款）。 */
  function scheduleMediaTableRefresh(): void {
    if (mediaRefreshTimer != 0) {
      return;
    }
    mediaRefreshTimer = setTimeout(() => {
      mediaRefreshTimer = 0;
      if (pageDisposed) {
        return;
      }
      items.value = copyItems(items.value);
    }, 50);
  }

  /** 受保护图片取址：App 两端优先 ak 换 ?ak= 直链（<image> 自跟 302 到对象存储流式加载，
   *  只花一次轻量 JSON 请求，免整段下载落盘）；鸿蒙 <image> 对 ak 直链静默失败（2026-10-27
   *  真机）一律跳过 ak，走整段下载并退避重试（downloadFile 偶发悬挂/瞬时失败）；接口不可用
   *  或失败回落原整段下载（temp/blob）。SVG 例外交给 resolveDisplayImageUrl 原管线。
   *  策略与聊天页 resolveChatImageProtected 逐条对齐（2026-11-13 反馈：详情页图不显示）。 */
  async function resolveMergeImageProtected(url: string, allowAk: boolean): Promise<string> {
    let useAk = allowAk;
    // #ifdef APP-HARMONY
    useAk = false;
    // #endif
    if (useAk && isAuthProtectedFileUrl(url) && isRemoteSvgUrl(url) != true) {
      try {
        return await fetchAuthProtectedFileAkUrl(url);
      } catch (_e) {
        console.error(`[MergeImg] ak 直链解析失败，回落整段下载 url=${url}`);
      }
    }
    // #ifdef APP-HARMONY
    if (isAuthProtectedFileUrl(url)) {
      // resolveDisplayImageUrl 失败回退原址（resolved == url 仅受保护地址有此语义）：
      // 单发失败会让缩略图永久停在灰块，点按也预览不出，故按头像链退避重试
      for (let attempt = 1; attempt <= MERGE_IMG_MAX_ATTEMPTS; attempt++) {
        const resolved = await resolveDisplayImageUrl(url, MERGE_IMG_DISPLAY_RPX, MERGE_IMG_DISPLAY_RPX);
        if (resolved != url) {
          return resolved;
        }
        if (attempt < MERGE_IMG_MAX_ATTEMPTS) {
          await new Promise<void>((resolve) => {
            setTimeout((): void => {
              resolve();
            }, 400 * attempt);
          });
        }
      }
      return url;
    }
    // #endif
    return await resolveDisplayImageUrl(url, MERGE_IMG_DISPLAY_RPX, MERGE_IMG_DISPLAY_RPX);
  }

  /** 图片解析（缓存 + 在途去重）：CDN 直链原样返回；受保护地址换可展示地址，
   *  失败回退原地址（由 <image>/@error 兜底）。 */
  async function resolveMergeImage(url: string, allowAk: boolean): Promise<string> {
    const cached = mergeImgResolved.get(url);
    if (cached != null) {
      return cached;
    }
    const existing = mergeImgRequests.get(url);
    if (existing != null) {
      return await existing;
    }
    const task = resolveMergeImageProtected(url, allowAk);
    mergeImgRequests.set(url, task);
    try {
      const resolved = await task;
      if (pageDisposed) {
        releaseDisplayImageUrl(resolved);
        return url;
      }
      mergeImgResolved.set(url, resolved);
      if (resolved != url) {
        if (isAuthProtectedFileUrl(resolved)) {
          // ak 直链仍属 /api/f/ 判定：登记原址供 @error 自愈回落整段下载
          mergeImgAkOrigins.set(resolved, url);
        } else {
          resolvedMediaUrls.push(resolved);
        }
      }
      return resolved;
    } finally {
      mergeImgRequests.delete(url);
    }
  }

  /** 单张图解析并回填（allowAk=false 时直接走整段下载：ak 失败自愈路径用）。 */
  function applyMergeImage(img: ImMergeMedia, allowAk: boolean): void {
    const url = img.url;
    if (url.length == 0) {
      return;
    }
    // 发送端本机路径：本端取不到，解析只会白跑一趟（还可能被补成域名后落成 404 假地址）
    if (mergeForeignLocalUrls.has(url)) {
      return;
    }
    resolveMergeImage(url, allowAk)
      .then((resolved: string): void => {
        if (pageDisposed) {
          return;
        }
        // 失败会回退原地址（与 url 相同）：不当成功，保留原地址由 <image>/@error 兜底
        if (resolved.length > 0 && resolved != url && resolved != img.url) {
          img.url = resolved;
          scheduleMediaTableRefresh();
        }
      })
      .catch((_e: any | null): void => {
        // 静默：真实失败由 @error 落日志
      });
  }

  /** 全量条目图片附件解析（受保护地址换可展示地址；失败保留原地址交给 <image> 兜底）。 */
  function resolveMergeMedia(): void {
    const rows = items.value;
    for (let i = 0; i < rows.length; i++) {
      const imgs = rows[i].images;
      for (let j = 0; j < imgs.length; j++) {
        applyMergeImage(imgs[j], true);
      }
    }
  }

  /** <image> 挂载闸门：
   *  - 快照原值就是发送端本机路径（跨端取不到）→ 不挂节点，只画灰底，点按提示加载失败；
   *  - 鸿蒙（#ifdef 内）：已挂节点换新 src 不重绘（[[harmony-avatar-load-refresh-loop]]），
   *    受保护 /api/f/ 原址带不了 Bearer 必失败 → 解析出本地 temp 前只画灰底，回填后由
   *    v-if 新建节点才出图（聊天页 harmonyImgGateOk 同款）。 */
  function mergeImgMountOk(url: string): boolean {
    if (url.length == 0) {
      return false;
    }
    if (mergeForeignLocalUrls.has(url)) {
      return false;
    }
    // #ifdef APP-HARMONY
    return isAuthProtectedFileUrl(url) != true;
    // #endif
    // #ifndef APP-HARMONY
    return true;
    // #endif
  }

  /** 可入滑动预览列表的图：ak 直链（带临时签名免鉴权）与 temp/blob 展示地址可入；
   *  空地址、发送端本机路径、未解析的 /api/f/ 受保护直链剔除（预览器带不了 Bearer
   *  或本机根本没这文件，进去必空白）。 */
  function isPreviewableMediaImage(url: string): boolean {
    if (url.length == 0) {
      return false;
    }
    if (mergeForeignLocalUrls.has(url)) {
      return false;
    }
    if (mergeImgAkOrigins.has(url)) {
      return true;
    }
    return isAuthProtectedFileUrl(url) != true;
  }

  /** 全记录可预览图片（升序 = 视觉顺序，跨条目连续滑动）。 */
  function collectPreviewImages(): string[] {
    const urls: string[] = [];
    const rows = items.value;
    for (let i = 0; i < rows.length; i++) {
      const imgs = rows[i].images;
      for (let j = 0; j < imgs.length; j++) {
        if (isPreviewableMediaImage(imgs[j].url)) {
          urls.push(imgs[j].url);
        }
      }
    }
    return urls;
  }

  /** 缩略图点击：全屏放大（全记录多图滑动）。仍是未解析的受保护原址时先解析出可展示
   *  地址再预览——previewImageCompat 带不了 Bearer，直接喂 /api/f/ 必然打不开
   *  （真机「点了没反应」的根因），解析失败才提示加载失败。 */
  async function handleImageTap(img: ImMergeMedia): Promise<void> {
    if (img.url.length == 0) {
      return;
    }
    // 快照存的是发送端本机路径：本端没有这个文件，预览必空白 → 直接提示（历史脏数据兜底）
    if (mergeForeignLocalUrls.has(img.url)) {
      uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
      return;
    }
    let url = img.url;
    // 未解析的原始受保护地址才需现场解析：ak 直链（已登记原址映射）与 temp/blob 直接可预览
    if (isAuthProtectedFileUrl(url) && mergeImgAkOrigins.has(url) != true) {
      try {
        url = await resolveMergeImage(url, true);
      } catch (_e) {
        url = img.url;
      }
      if (pageDisposed) {
        return;
      }
      // ak 直链的地址仍属 /api/f/ 形态但已带临时签名，可预览；只有解析后仍为原始
      // 受保护地址（解析终态失败）才判定打不开
      if (isAuthProtectedFileUrl(url) && mergeImgAkOrigins.has(url) != true) {
        uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
        return;
      }
      img.url = url;
      scheduleMediaTableRefresh();
    }
    const urls = collectPreviewImages();
    if (urls.indexOf(url) >= 0) {
      previewImageCompat(urls, url);
    } else {
      previewImageCompat([url], url);
    }
  }

  /** 缩略图加载失败：ak 直链过期/该端不跟 302 时作废缓存、按原始受保护地址整段下载
   *  重来一次（每张图每页至多一次，坏图不无限循环；成功才换地址，失败保留原样）。
   *  ★原始受保护地址的首次失败是常态（<image> 带不了 Bearer），解析中会换地址重载，
   *  这里查不到 ak 原址映射即直接返回（聊天页 handleImageRenderError 同口径）。 */
  function handleImageRenderError(img: ImMergeMedia): void {
    const src = img.url;
    console.error("[MergeImg] 缩略图渲染失败 src=" + src);
    const origin = mergeImgAkOrigins.get(src);
    if (origin == null || mergeImgSelfHealed.has(origin)) {
      return;
    }
    mergeImgSelfHealed.add(origin);
    mergeImgResolved.delete(origin);
    mergeImgAkOrigins.delete(src);
    resolveMergeImage(origin, false)
      .then((resolved: string): void => {
        if (pageDisposed) {
          return;
        }
        if (resolved != origin && resolved != img.url) {
          img.url = resolved;
          scheduleMediaTableRefresh();
        }
      })
      .catch((_e: any | null): void => {
        // 下载兜底也失败：维持原样（终态由日志可查）
      });
  }

  // ===== 正文链接分段（合并快照正文是纯文本；[标题](url) 与裸 http(s) 地址按链接段渲染，
  // 口径与聊天正文 parseSegs 的链接部分一致——快照不存富文本标记，只拆链接两种形态） =====

  /** 正文分段：文本段 / 链接段。 */
  class MfdTextSeg {
    text: string = "";
    link: boolean = false;
    url: string = "";
  }

  /** 分段缓存（同一段正文只解析一次；快照正文在页面生命周期内不会变）。 */
  const mfdTextSegCache = new Map<string, MfdTextSeg[]>();

  /** 裸链接字符口径（chat.uvue isBareUrlChar 同款）：ASCII 可见字符，排除空白/引号/
   *  尖括号/反引号/花括号/竖线/反斜杠/脱字符，>0x7f（CJK/emoji）截断。 */
  function isMfdBareUrlChar(code: number | null): boolean {
    if (code == null || code <= 0x20 || code >= 0x7f) {
      return false;
    }
    if (code == 0x22 || code == 0x3c || code == 0x60 || code == 0x7b ||
        code == 0x7d || code == 0x7c || code == 0x5c || code == 0x5e) {
      return false;
    }
    return true;
  }

  /** 常见 HTML 实体还原（后端正文里的 URL 常被转义成 &amp; 等，直接打开会 403/404）。 */
  function unescapeMfdEntities(s: string): string {
    if (s.indexOf("&") < 0) {
      return s;
    }
    let out = s.split("&amp;").join("&");
    out = out.split("&lt;").join("<");
    out = out.split("&gt;").join(">");
    out = out.split("&quot;").join("\"");
    out = out.split("&#39;").join("'");
    return out;
  }

  function pushMfdSeg(out: MfdTextSeg[], text: string): void {
    if (text.length == 0) {
      return;
    }
    const seg = new MfdTextSeg();
    seg.text = text;
    out.push(seg);
  }

  /** 纯文本段再拆裸 http(s) 地址（整段按链接渲染；末尾孤立标点回退给正文）。 */
  function appendMfdPlainSegs(out: MfdTextSeg[], text: string): void {
    if (text.length == 0) {
      return;
    }
    let plainStart = 0;
    let i = 0;
    while (i < text.length) {
      const httpAt = text.indexOf("http://", i);
      const httpsAt = text.indexOf("https://", i);
      let start = -1;
      if (httpAt >= 0 && (httpsAt < 0 || httpAt <= httpsAt)) {
        start = httpAt;
      } else if (httpsAt >= 0) {
        start = httpsAt;
      }
      if (start < 0) {
        break;
      }
      const protoLen = text.charAt(start + 4) == "s" ? 8 : 7;
      let end = start;
      while (end < text.length) {
        if (!isMfdBareUrlChar(text.charCodeAt(end))) {
          break;
        }
        end++;
      }
      while (end > start + protoLen) {
        const tail = text.charAt(end - 1);
        if (tail == "." || tail == "," || tail == ";" || tail == ":" || tail == "!" ||
            tail == "?" || tail == ")" || tail == "]" || tail == "}" || tail == "'" || tail == "\"") {
          end--;
        } else {
          break;
        }
      }
      if (end <= start + protoLen) {
        i = start + 1;
        continue;
      }
      pushMfdSeg(out, text.substring(plainStart, start));
      const clean = unescapeMfdEntities(text.substring(start, end));
      const linkSeg = new MfdTextSeg();
      linkSeg.text = clean;
      linkSeg.link = true;
      linkSeg.url = clean;
      out.push(linkSeg);
      i = end;
      plainStart = i;
    }
    pushMfdSeg(out, text.substring(plainStart));
  }

  /** 正文 → 分段：先拆 [标题](url) 链接（接受 http(s) 与站内相对路径），余下文本再拆裸链接。 */
  function buildMfdTextSegs(text: string): MfdTextSeg[] {
    const out: MfdTextSeg[] = [];
    let plainStart = 0;
    let i = 0;
    while (i < text.length) {
      const openAt = text.indexOf("[", i);
      if (openAt < 0) {
        break;
      }
      const closeAt = text.indexOf("]", openAt + 1);
      if (closeAt < 0 || closeAt == openAt + 1) {
        i = openAt + 1;
        continue;
      }
      if (closeAt + 1 >= text.length || text.charAt(closeAt + 1) != "(") {
        i = openAt + 1;
        continue;
      }
      const urlEnd = text.indexOf(")", closeAt + 2);
      if (urlEnd < 0) {
        i = openAt + 1;
        continue;
      }
      const rawUrl = text.substring(closeAt + 2, urlEnd).trim();
      const isHttp = rawUrl.indexOf("http://") == 0 || rawUrl.indexOf("https://") == 0;
      const isSiteRelative = rawUrl.indexOf("/") == 0 && rawUrl.indexOf("//") != 0;
      if (rawUrl.length == 0 || (!isHttp && !isSiteRelative)) {
        i = openAt + 1;
        continue;
      }
      appendMfdPlainSegs(out, text.substring(plainStart, openAt));
      const linkSeg = new MfdTextSeg();
      linkSeg.text = text.substring(openAt + 1, closeAt);
      linkSeg.link = true;
      linkSeg.url = unescapeMfdEntities(rawUrl);
      out.push(linkSeg);
      i = urlEnd + 1;
      plainStart = i;
    }
    appendMfdPlainSegs(out, text.substring(plainStart));
    return out;
  }

  /** 模板入口：取一条记录的正文分段（无文本返回空数组；结果按正文内容缓存）。 */
  function textSegsOf(it: ImMergeItem): MfdTextSeg[] {
    const text = it.text;
    if (text.length == 0) {
      return [] as MfdTextSeg[];
    }
    const cached = mfdTextSegCache.get(text);
    if (cached != null) {
      return cached;
    }
    const segs = buildMfdTextSegs(text);
    mfdTextSegCache.set(text, segs);
    return segs;
  }

  /** 正文链接段点击：站内相对路径补域名 → 受保护 /api/f/ 走文件预览页（webview 带不了
   *  Bearer）→ 其余按消息外链走站内 webview 页（与聊天正文 handleSegTap 同口径）。 */
  function handleTextSegTap(sg: MfdTextSeg): void {
    if (sg.link != true || sg.url.length == 0) {
      return;
    }
    let url = sg.url;
    const base = getApiBaseUrl();
    if (url.indexOf("/") == 0 && url.indexOf("//") != 0 && base.length > 0) {
      url = base + url;
    }
    if (isAuthProtectedFileUrl(url)) {
      openAuthProtectedLinkUrl(url, sg.text, convId.value).catch((_e: any | null): void => {
        uni.showToast({ title: t("Mobile.Message.loadFailed"), icon: "none" });
      });
      return;
    }
    handleExternalLinkInWebview(url, sg.text);
  }

  // ===== 语音附件播放（chat.uvue 语音块同款移植：页面级单一 InnerAudioContext，
  // 点气泡播放/再点停止复位；条目寻址用 onLoad 编好的 media.uid 顶替 msgId） =====

  /** 正在播放的语音 uid（空=无；模板直读它切 --playing 态）。 */
  const playingAudioId = ref<string>("");
  /** 声波跳动 tick（播放中 150ms +1；模板绑定以尾参直读它——App-Android 方法调用绑定不收集方法体内依赖）。 */
  const voiceTick = ref<number>(0);
  let mfdAudioCtx: InnerAudioContext | null = null;
  let voiceTickTimer = 0;
  /** 原始 url → 已解析可播地址缓存（重放免二次解析）。 */
  const audioResolved = new Map<string, string>();
  /** 在途解析去重（同 url 并发点按共享同一次解析）。 */
  const audioRequests = new Map<string, Promise<string>>();

  /** 声波条静态高度 px（两侧低中间高）；播放态叠随机抖动模拟音量（chat.uvue 同款手法）。 */
  const VOICE_BAR_BASE: number[] = [7, 14, 10, 5];

  function voiceBarH(a: ImMergeMedia, index: number, _tick: number): number {
    const base = VOICE_BAR_BASE[index];
    if (a.uid != playingAudioId.value) {
      return base;
    }
    return base + Math.random() * 6;
  }

  /** 时长文案：秒 → N"（<=0 不展示，等首播回填）。 */
  function audioDurationLabelOf(a: ImMergeMedia): string {
    if (a.duration <= 0) {
      return "";
    }
    return `${Math.round(a.duration)}"`;
  }

  function startVoiceTickTimer(): void {
    if (voiceTickTimer != 0) {
      clearInterval(voiceTickTimer);
    }
    voiceTickTimer = setInterval((): void => {
      voiceTick.value = voiceTick.value + 1;
    }, 150);
  }

  function stopVoiceTickTimer(): void {
    if (voiceTickTimer != 0) {
      clearInterval(voiceTickTimer);
      voiceTickTimer = 0;
    }
  }

  /** 首播回填时长：快照契约无 duration 字段，播放器拿到真实时长后写回媒体对象
   *  （Android 原地属性变更不触发视图，走整表重建调度）。 */
  function backfillAudioDuration(sec: number): void {
    const id = playingAudioId.value;
    if (id.length == 0 || sec <= 0 || sec > 36000) {
      return;
    }
    const rows = items.value;
    for (let i = 0; i < rows.length; i++) {
      const auds = rows[i].audios;
      for (let j = 0; j < auds.length; j++) {
        if (auds[j].uid == id && auds[j].duration <= 0) {
          auds[j].duration = Math.round(sec);
          scheduleMediaTableRefresh();
          return;
        }
      }
    }
  }

  function ensureMfdAudioCtx(): InnerAudioContext {
    const existed = mfdAudioCtx;
    if (existed != null) {
      return existed;
    }
    const ctx = uni.createInnerAudioContext();
    ctx.onEnded(() => {
      playingAudioId.value = "";
      stopVoiceTickTimer();
    });
    ctx.onError((err) => {
      console.error("[MfdAudio] play failed", err);
      playingAudioId.value = "";
      stopVoiceTickTimer();
      uni.showToast({ title: t("Mobile.Message.audioPlayFailed"), icon: "none" });
    });
    ctx.onTimeUpdate(() => {
      if (playingAudioId.value.length == 0) {
        return;
      }
      const dur = ctx.duration;
      if (dur > 0) {
        backfillAudioDuration(dur);
      }
    });
    mfdAudioCtx = ctx;
    return ctx;
  }

  /** 停止当前播放（复位到头；播放态与跳动 timer 一并收）。 */
  function stopMfdAudio(): void {
    const ctx = mfdAudioCtx;
    if (ctx != null) {
      ctx.stop();
    }
    playingAudioId.value = "";
    stopVoiceTickTimer();
  }

  /** 页面卸载销毁（InnerAudioContext 用完必须 destroy 释放资源）。 */
  function destroyMfdAudio(): void {
    const ctx = mfdAudioCtx;
    if (ctx != null) {
      ctx.stop();
      ctx.destroy();
      mfdAudioCtx = null;
    }
    stopVoiceTickTimer();
  }

  /** onHide 停语音判后台延迟复检定时器（见 stopMfdAudioOnHideIfNeeded）。 */
  let stopAudioOnHideTimer = 0;

  /** onHide 停语音前的后台判别：息屏/锁屏/切后台不打断播放（继续播完）；只有进子页
   *  （应用仍前台）才停。App.onHide 与 Page.onHide 触发先后不稳：先即查一次，不能
   *  定论再延迟 400ms 复检（chat.uvue stopChatAudioOnHideIfNeeded 同款）。 */
  function stopMfdAudioOnHideIfNeeded(): void {
    if (playingAudioId.value.length == 0) {
      return;
    }
    // 已后台：息屏/锁屏/切后台 → 继续播完，不停
    if (isAppInBackground()) {
      return;
    }
    const playingId = playingAudioId.value;
    if (stopAudioOnHideTimer != 0) {
      clearTimeout(stopAudioOnHideTimer);
    }
    stopAudioOnHideTimer = setTimeout((): void => {
      stopAudioOnHideTimer = 0;
      // 会话没换（未被手动停/换条）且届时仍前台 = 真导航进子页 → 停（微信同款）
      if (playingAudioId.value == playingId && !pageDisposed && isAppInBackground() != true) {
        stopMfdAudio();
      }
    }, 400);
  }

  /** 清判后台复检定时器（onUnload 用：销毁后不得再触发 stopMfdAudio）。 */
  function clearStopAudioOnHideTimer(): void {
    if (stopAudioOnHideTimer != 0) {
      clearTimeout(stopAudioOnHideTimer);
      stopAudioOnHideTimer = 0;
    }
  }

  /** 语音可播地址：CDN 直链原样；受保护地址换 blob/temp（缓存 + 在途去重，
   *  chat.uvue resolveChatAudioUrl 同款）。 */
  async function resolveMfdAudioUrl(url: string): Promise<string> {
    if (isAuthProtectedFileUrl(url) != true) {
      return url;
    }
    const cached = audioResolved.get(url);
    if (cached != null) {
      return cached;
    }
    const existing = audioRequests.get(url);
    if (existing != null) {
      return await existing;
    }
    const task = fetchAuthProtectedFileDisplayUrl(url);
    audioRequests.set(url, task);
    try {
      const resolved = await task;
      if (pageDisposed) {
        releaseDisplayImageUrl(resolved);
        return url;
      }
      audioResolved.set(url, resolved);
      resolvedMediaUrls.push(resolved);
      return resolved;
    } finally {
      audioRequests.delete(url);
    }
  }

  // ===== 视频附件预载/播放（chat.uvue 视频块同款移植） =====

  /** 受保护地址解析中的 uid（占位卡显示「下载中」，模板直读）。 */
  const videoLoadingId = ref<string>("");
  /** 解析进度百分比（-1=不确定，无进度回调的平台只显「下载中」；模板直读）。 */
  const videoLoadPercent = ref<number>(-1);
  /** 任一视频是否全屏（模块级 ref，与自绘控制条共用：模板 :controls 直读——行内 false
   *  走自绘条、全屏 true 让系统条回来，系统条左上返回是全屏里唯一的退出键）。 */
  const videoFullscreen = chatVideoFullscreen;
  /** 原始 url → 已解析 src 缓存（重放免二次下载）。 */
  const videoResolved = new Map<string, string>();
  /** 在途解析去重（同 url 并发触发共享同一次解析）。 */
  const videoRequests = new Map<string, Promise<string>>();
  /** 播放报错已自动重解析过的 uid（每页会话至多一次：ak 过期自愈够用，坏文件不无限循环）。 */
  const videoRetryIds = new Set<string>();
  /** 批量预载防重入。 */
  let videoPreloadBusy = false;

  /** 指定条目的 <video> 元素（每条独立 id：预载后多条常驻，非单实例）。 */
  function getMfdVideoElement(uid: string): UniVideoElement | null {
    return uni.getElementById(`mfdVideoPlayer-${uid}`) as UniVideoElement | null;
  }

  /** 播放态/进度的状态 key = 播放器元素 id（自绘控制条按同一 key 读，
   *  见 utils/chatVideoControl.uts：进度不放页面 reactive）。 */
  function mfdVideoKeyOf(uid: string): string {
    return `mfdVideoPlayer-${uid}`;
  }

  /** 暂停所有已挂载视频（页面隐藏 / 播语音互斥；不清 src——回来仍停在该帧）。 */
  function pauseMfdVideos(): void {
    const rows = items.value;
    for (let i = 0; i < rows.length; i++) {
      const vids = rows[i].videos;
      for (let j = 0; j < vids.length; j++) {
        if (vids[j].playUrl.length > 0) {
          const el = getMfdVideoElement(vids[j].uid);
          if (el != null) {
            el.pause();
          }
        }
      }
    }
  }

  /** 语音气泡点按：播放/停止（chat.uvue handleAudioMsgTap 同款——再点停止复位，换条
   *  从头播；播视频先停视频，音视频互斥。解析期间即显播放态，再点同条=停止）。 */
  async function handleAudioTap(a: ImMergeMedia): Promise<void> {
    pauseMfdVideos();
    if (a.uid == playingAudioId.value) {
      stopMfdAudio();
      return;
    }
    // 快照存的是发送端本机路径：本端没有这个文件 → 提示（历史脏数据兜底）
    if (mergeForeignLocalUrls.has(a.url)) {
      uni.showToast({ title: t("Mobile.Message.audioPlayFailed"), icon: "none" });
      return;
    }
    const ctx = ensureMfdAudioCtx();
    ctx.stop();
    playingAudioId.value = a.uid;
    startVoiceTickTimer();
    let src = a.url;
    try {
      src = await resolveMfdAudioUrl(a.url);
    } catch (_e) {
      console.error("[MfdAudio] resolve failed url=" + a.url);
      stopMfdAudio();
      uni.showToast({ title: t("Mobile.Message.audioPlayFailed"), icon: "none" });
      return;
    }
    if (a.uid != playingAudioId.value || pageDisposed) {
      return;
    }
    ctx.src = src;
    ctx.play();
  }

  // App 端：页面内 downloadFile 薄封装（与 fetchAuthProtectedFileDisplayUrl 同鉴权头），
  // 额外拿 DownloadTask.onProgressUpdate 驱动占位卡百分比
  // #ifdef APP
  function fetchMfdVideoProtectedUrl(
    url: string,
    onProgress: ((percent: number) => void) | null,
  ): Promise<string> {
    return new Promise<string>((resolve, reject) => {
      const fetchUrl = resolveAuthProtectedFileFetchUrl(url);
      const task = uni.downloadFile({
        url: fetchUrl,
        header: buildAuthProtectedFileHeaders(),
        success: (res) => {
          const tempPath = res.tempFilePath;
          if (res.statusCode == 200 && tempPath != null && tempPath.length > 0) {
            resolve(tempPath);
            return;
          }
          console.error(`[MfdVideo] downloadFile statusCode=${res.statusCode} url=${fetchUrl}`);
          reject(new Error(translateFn("Mobile.Error.downloadStatus", objectI18nParams({ status: res.statusCode }), "")));
        },
        fail: (err) => {
          console.error(`[MfdVideo] downloadFile fail url=${fetchUrl}`, err);
          reject(new Error(err.errMsg != null ? err.errMsg : "download fail"));
        },
      });
      task.onProgressUpdate((res) => {
        if (onProgress != null) {
          onProgress(res.progress);
        }
      });
    });
  }
  // #endif
  // 非 App 端：复用通用受保护文件拉取（H5 换 blob；小程序换 temp），无进度回调
  // #ifndef APP
  function fetchMfdVideoProtectedUrl(
    url: string,
    _onProgress: ((percent: number) => void) | null,
  ): Promise<string> {
    return fetchAuthProtectedFileDisplayUrl(url);
  }
  // #endif

  /** 受保护视频取址：allowAk 时首选 /api/file/ak/refresh 换流式直链（播放器自行跟
   *  302 渐进拉流，预载只花一次轻量 JSON 请求）；接口不可用/失败走整段下载路径。 */
  async function resolveMfdVideoProtected(
    url: string,
    onProgress: ((percent: number) => void) | null,
    allowAk: boolean,
  ): Promise<string> {
    if (allowAk) {
      try {
        return await fetchAuthProtectedFileAkUrl(url);
      } catch (_e) {
        console.error(`[MfdVideo] ak 直链解析失败，回落整段下载 url=${url}`);
      }
    }
    return await fetchMfdVideoProtectedUrl(url, onProgress);
  }

  /** 解析视频可播地址：CDN 直链原样；受保护地址先换 ak 流式直链、失败回落整段下载
   *  temp/blob（缓存与在途去重；ak 播放报错的自愈路径见 handleVideoError）。 */
  async function resolveMfdVideo(
    url: string,
    onProgress: ((percent: number) => void) | null,
    allowAk: boolean,
  ): Promise<string> {
    if (isAuthProtectedFileUrl(url) != true) {
      return url;
    }
    const cached = videoResolved.get(url);
    if (cached != null) {
      return cached;
    }
    const existing = videoRequests.get(url);
    if (existing != null) {
      return await existing;
    }
    const task = resolveMfdVideoProtected(url, onProgress, allowAk);
    videoRequests.set(url, task);
    try {
      const resolved = await task;
      if (pageDisposed) {
        releaseDisplayImageUrl(resolved);
        return url;
      }
      videoResolved.set(url, resolved);
      resolvedMediaUrls.push(resolved);
      return resolved;
    } finally {
      videoRequests.delete(url);
    }
  }

  /** 单条视频预载：解析可播地址并回填 playUrl（非空 ⇒ 模板挂 <video> 显首帧）。
   *  ★本页 items 只做浅拷贝重建（copyItems 不换实例），直接写媒体对象即安全；
   *  Android 原地属性变更不触发行重渲，回填后整表重建调度出首帧（同图片回填）。 */
  async function preloadMfdVideoRow(v: ImMergeMedia, allowAk: boolean): Promise<void> {
    videoLoadingId.value = v.uid;
    videoLoadPercent.value = -1;
    try {
      const src = await resolveMfdVideo(v.url, (percent: number): void => {
        // 进度只归属于当前等待的那条（快速换点另一条时旧回调静默）
        if (videoLoadingId.value == v.uid) {
          videoLoadPercent.value = percent;
        }
      }, allowAk);
      if (pageDisposed) {
        return;
      }
      v.playUrl = src;
      scheduleMediaTableRefresh();
    } catch (_e) {
      console.error("[MfdVideo] 预载失败 uid=" + v.uid + " url=" + v.url);
    } finally {
      if (videoLoadingId.value == v.uid) {
        videoLoadingId.value = "";
        videoLoadPercent.value = -1;
      }
    }
  }

  /** 批量预载（onLoad 解析图片后调用）：从上往下逐条顺序预载（顺序下载避免多视频
   *  并发抢带宽；缓存命中零成本回填）。 */
  async function preloadMfdVideos(): Promise<void> {
    if (videoPreloadBusy) {
      return;
    }
    videoPreloadBusy = true;
    try {
      const rows = items.value;
      for (let i = 0; i < rows.length; i++) {
        const vids = rows[i].videos;
        for (let j = 0; j < vids.length; j++) {
          const v = vids[j];
          // 发送端本机路径：本端取不到，预载只会白跑（点按另有提示，见 handleVideoTap）
          if (mergeForeignLocalUrls.has(v.url)) {
            continue;
          }
          if (v.url.length > 0 && v.playUrl.length == 0) {
            if (pageDisposed) {
              return;
            }
            await preloadMfdVideoRow(v, true);
          }
        }
      }
    } finally {
      videoPreloadBusy = false;
    }
  }

  /** 视频区点按：已挂载=轻触整面切换播放/暂停（原生中央播放键只覆盖中心小区域，
   *  表面其余区域 5.13+ 基座不拦截触摸、会冒泡到本层——补齐微信同款整面轻触切换；
   *  中央键/控制条仍归原生，各自消费各自的触摸不会双触发）；未挂载=占位卡 ▶ 手动预载。 */
  function handleVideoTap(v: ImMergeMedia): void {
    if (v.url.length == 0) {
      return;
    }
    // 快照存的是发送端本机路径：本端没有这个文件 → 提示（历史脏数据兜底）
    if (mergeForeignLocalUrls.has(v.url)) {
      uni.showToast({ title: t("Mobile.Message.videoPlayFailed"), icon: "none" });
      return;
    }
    if (v.playUrl.length > 0) {
      // 全屏态不接管：点按留给原生播放器弹左上角标题+返回顶栏（真机实测全屏触摸
      // 仍会冒泡到本层，我们再 play/pause 会把顶栏弹出时机顶掉，只剩播放/暂停）
      if (videoFullscreen.value) {
        return;
      }
      const el = getMfdVideoElement(v.uid);
      if (el == null) {
        return;
      }
      // 音视频互斥（语音侧见 handleAudioTap 开头）
      stopMfdAudio();
      if (isChatVideoPlaying(mfdVideoKeyOf(v.uid))) {
        el.pause();
      } else {
        el.play();
      }
      return;
    }
    if (v.uid == videoLoadingId.value) {
      return;
    }
    // 音视频互斥（语音侧见 handleAudioTap 开头）
    stopMfdAudio();
    preloadMfdVideoRow(v, true);
  }

  /** 播放状态回写（video @play/@pause）：轻触切播放/暂停的方向依据，同时驱动
   *  自绘控制条的 ▶/❚❚（状态在 utils/chatVideoControl.uts，与聊天页共用一份）。 */
  function handleVideoPlaying(uid: string): void {
    setChatVideoPlaying(mfdVideoKeyOf(uid), true);
  }

  function handleVideoPaused(uid: string): void {
    setChatVideoPlaying(mfdVideoKeyOf(uid), false);
  }

  /** 播放进度回写（video @timeupdate，单位秒）：只写模块级 ref，不进页面 reactive
   *  （timeupdate 一秒数拍，写页面会把整页合记录重渲）。 */
  function handleVideoTimeUpdate(uid: string, eventValue: Any): void {
    // 模板侧带额外参数时 $event 推断为 Any（UTS error17），入参显式收窄
    const event = eventValue as UniVideoTimeUpdateEvent;
    const detail = event.detail;
    updateChatVideoProgress(mfdVideoKeyOf(uid), detail.currentTime, detail.duration);
  }

  /** 播放结束：seek(0) 定格首帧当封面（自绘控制条的 ▶ 可直接重播）。
   *  全屏态播完「停留在全屏页」——不主动 exitFullScreen（用户要求：播完不回上一页），
   *  由用户自己点返回退全屏。 */
  function handleVideoEnded(uid: string): void {
    setChatVideoPlaying(mfdVideoKeyOf(uid), false);
    const el = getMfdVideoElement(uid);
    if (el == null) {
      return;
    }
    el.seek(0);
  }

  /** 播放器报错：ak 流式直链可能过期或该端播放器不跟 302——作废该条解析缓存并自动
   *  重解析一次，且直接走整段下载兜底（重换 ak 无意义）；已重试过维持日志 + toast。 */
  function handleVideoError(v: ImMergeMedia): void {
    console.error("[MfdVideo] 播放器报错 uid=" + v.uid);
    if (!videoRetryIds.has(v.uid) && isAuthProtectedFileUrl(v.url) && v.playUrl.length > 0) {
      videoRetryIds.add(v.uid);
      setChatVideoPlaying(mfdVideoKeyOf(v.uid), false);
      videoResolved.delete(v.url);
      v.playUrl = "";
      scheduleMediaTableRefresh();
      preloadMfdVideoRow(v, false);
      return;
    }
    uni.showToast({ title: t("Mobile.Message.videoPlayFailed"), icon: "none" });
  }

  /** 全屏状态变化：回写标记（全屏态页面不再接管轻触）。
   *  进入全屏即起播（chat.uvue 同款）：全屏页停在第一帧且点按无响应，根因是
   *  播放器从未起播；全屏容器接管与事件回调存在时序差，立即起播后再补一记
   *  300ms 兜底（已起播时 play() 幂等）。退全屏不清播放状态。
   *  ★全屏入口在 components/chat-video-bar（按 playerId 取元素 requestFullScreen）。 */
  function handleVideoFullscreenChange(uid: string, eventValue: Any): void {
    // 模板侧带额外参数时 $event 推断为 Any（UTS error17），入参显式收窄
    const event = eventValue as UniVideoFullScreenChangeEvent;
    // 以事件为准校准全屏态（进/出都覆盖），同时作废控制条那次乐观置位的看门狗
    confirmChatVideoFullscreen(event.detail.fullScreen);
    if (!event.detail.fullScreen) {
      return;
    }
    const el = getMfdVideoElement(uid);
    if (el != null) {
      el.play();
    }
    setTimeout((): void => {
      const lateEl = getMfdVideoElement(uid);
      if (lateEl != null) {
        lateEl.play();
      }
    }, 300);
  }

  /** 文件卡片展示名（快照 fileName 优先，缺省从 URL 提取）。 */
  function fileDisplayNameOf(f: ImMergeMedia): string {
    return f.fileName.length > 0 ? f.fileName : extractFileNameFromUrl(f.url);
  }

  /** 文件卡片次行：大小 ·（仅 APP）已下载/未下载；H5 只显示大小（浏览器接管下载）。
   *  ★tick 必须作参进模板表达式（App-Android 方法调用绑定不收集方法体内依赖）。 */
  function fileMetaText(f: ImMergeMedia, tick: number): string {
    const sizeText = formatFileSize(f.size);
    // #ifdef APP
    const downloaded = isImFileDownloadedNow(f.fileName, f.url);
    const status = downloaded ? t("Mobile.Message.fileDownloaded") : t("Mobile.Message.fileNotDownloaded");
    return sizeText.length > 0 ? `${sizeText} · ${status}` : status;
    // #endif
    // #ifndef APP
    return sizeText;
    // #endif
  }

  /** 文件卡片点击：进文件详情页（下载/打开等在该页完成；同 quote-detail 文件卡片路由）。 */
  function handleFileTap(f: ImMergeMedia): void {
    if (f.url.length == 0) {
      return;
    }
    uni.navigateTo({
      url:
        "/subpackages/pages/im-file-detail/im-file-detail" +
        "?url=" +
        encodeURIComponent(f.url) +
        "&fileName=" +
        encodeURIComponent(fileDisplayNameOf(f)) +
        "&size=" +
        f.size +
        "&mime=",
    });
  }

  /** 头像字母底色渐变板（与聊天页 AVATAR_GRADIENTS / 搜索页同款五色系）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  const displayTitle = computed((): string => {
    return title.value.length > 0 ? title.value : t("Mobile.Message.mergeForwardFallbackTitle");
  });

  function senderNameOf(it: ImMergeItem): string {
    return it.senderName.length > 0 ? it.senderName : t("Mobile.Message.imSearchUnknownUser");
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  function pad2(n: number): string {
    return n < 10 ? `0${n}` : `${n}`;
  }

  /** 同自然日判断（chat.uvue isSameChatDay 同款）。 */
  function isSameDay(a: Date, b: Date): boolean {
    return a.getFullYear() == b.getFullYear() && a.getMonth() == b.getMonth() && a.getDate() == b.getDate();
  }

  /** 记录行时间（语义化，对齐聊天页 formatMsgTime）：今天 HH:mm / 昨天 HH:mm / 同年 M月D日 HH:mm / 跨年带年。 */
  function formatRecordTime(ts: number): string {
    if (ts <= 0) {
      return "";
    }
    const date = new Date(ts);
    const hm = pad2(date.getHours()) + ":" + pad2(date.getMinutes());
    const now = new Date();
    if (isSameDay(date, now)) {
      return hm;
    }
    const yesterday = new Date(now.getTime() - 86400000);
    if (isSameDay(date, yesterday)) {
      return t("Mobile.Message.yesterday") + " " + hm;
    }
    if (date.getFullYear() == now.getFullYear()) {
      return `${date.getMonth() + 1}月${date.getDate()}日 ${hm}`;
    }
    return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日 ${hm}`;
  }

  function handleBack(): void {
    // 刷新后栈底保护：同 chat.uvue，无页可退时切回消息 tab，避免整页重载死循环
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      switchMainTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((_options: any) => {
    const session = takeImMergeRecord();
    if (session != null) {
      title.value = session!!.title;
      convId.value = session!!.convId;
      items.value = session!!.items;
      // 音视频条目编稳定 uid（快照无 msgId；播放态/预载态模板直读比对全靠它寻址）
      const rows = items.value;
      for (let i = 0; i < rows.length; i++) {
        const vids = rows[i].videos;
        for (let j = 0; j < vids.length; j++) {
          vids[j].uid = "v" + i + "-" + j;
        }
        const auds = rows[i].audios;
        for (let j2 = 0; j2 < auds.length; j2++) {
          auds[j2].uid = "a" + i + "-" + j2;
        }
      }
      // ★排查探针（真机/鸿蒙看不到 console.log，探针必须 console.error）：先确认快照里
      // 到底有没有图片附件——「详情页不出图」若 images=0 就是数据侧没下发，不是渲染问题。
      let imgTotal = 0;
      let firstImgUrl = "";
      let foreignTotal = 0;
      for (let k = 0; k < rows.length; k++) {
        const imgs = rows[k].images;
        imgTotal += imgs.length;
        if (firstImgUrl.length == 0 && imgs.length > 0) {
          firstImgUrl = imgs[0].url;
        }
        // 快照原值里的发送端本机路径：登记为不可用（不挂 <image>、不解析、点按提示）。
        // 只登记解析前的原值；本端解析出的 temp 地址不会落进这个集合
        for (let m = 0; m < imgs.length; m++) {
          if (isForeignLocalMediaUrl(imgs[m].url)) {
            mergeForeignLocalUrls.add(imgs[m].url);
            foreignTotal++;
            console.error(`[MergeImg] 附件地址是发送端本机路径，跨端不可用 url=${imgs[m].url}`);
          }
        }
        // 音视频同源问题（旧快照可能存发送端本地路径）：同样不预载、点按提示
        const vids = rows[k].videos;
        for (let mv = 0; mv < vids.length; mv++) {
          if (isForeignLocalMediaUrl(vids[mv].url)) {
            mergeForeignLocalUrls.add(vids[mv].url);
            foreignTotal++;
            console.error(`[MergeMedia] 视频地址是发送端本机路径，跨端不可用 url=${vids[mv].url}`);
          }
        }
        const auds = rows[k].audios;
        for (let ma = 0; ma < auds.length; ma++) {
          if (isForeignLocalMediaUrl(auds[ma].url)) {
            mergeForeignLocalUrls.add(auds[ma].url);
            foreignTotal++;
            console.error(`[MergeMedia] 语音地址是发送端本机路径，跨端不可用 url=${auds[ma].url}`);
          }
        }
      }
      console.error(`[MergeRec] items=${rows.length} images=${imgTotal} foreign=${foreignTotal} firstUrl=${firstImgUrl}`);
      resolveMergeMedia();
      preloadMfdVideos();
    }
  });

  onShow((): void => {
    // 从文件详情页返回时重估文件卡片下载状态（tick 自增驱动模板重渲，见 downloadTick）
    downloadTick.value = downloadTick.value + 1;
  });

  onHide((): void => {
    // 进子页停播（chat.uvue 同款：语音停、视频只暂停不清首帧）；息屏/锁屏/切后台
    // 不停语音——判后台放行续播，见 stopMfdAudioOnHideIfNeeded
    stopMfdAudioOnHideIfNeeded();
    pauseMfdVideos();
    // 全屏态复位（模块级 ref 跨页存活：残留 true 会让下一个视频行内就挂系统控制条）
    setChatVideoFullscreen(false);
  });

  onUnload((): void => {
    pageDisposed = true;
    clearStopAudioOnHideTimer();
    destroyMfdAudio();
    pauseMfdVideos();
    setChatVideoFullscreen(false);
    if (mediaRefreshTimer != 0) {
      clearTimeout(mediaRefreshTimer);
      mediaRefreshTimer = 0;
    }
    for (let i = 0; i < resolvedMediaUrls.length; i++) {
      releaseDisplayImageUrl(resolvedMediaUrls[i]);
    }
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架：浅灰底（文件页 gf-page 同底色） ===== */
  .mfd-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #f2f3f5;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  /* ===== 顶部：返回 + 标题（引用详情页同款双段头） ===== */
  .mfd-header {
    flex-shrink: 0;
    height: 96rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    /* 底部分割线（文件页 gf-header 同款灰线） */
    border-bottom: 2rpx solid #e5e6eb;
  }

  .mfd-header__btn {
    width: 96rpx;
    height: 96rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mfd-header__btn--active {
    opacity: 0.7;
  }

  .mfd-header__title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mfd-header__title {
    font-size: 34rpx;
    line-height: 48rpx;
    font-weight: 600;
    color: #141416;
    lines: 1;
    text-overflow: ellipsis;
  }

  .mfd-header__btn--ghost {
    /* 占位平衡标题居中（与引用详情页同款） */
  }

  /* ===== 记录列表 ===== */
  .mfd-body {
    flex: 1;
    min-height: 0;
  }

  .mfd-row {
    padding: 26rpx 32rpx;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }

  /* 头像整数 px + 半径取半（同搜索页：rpx 亚像素 + 圆角在 iOS 会随机切边） */
  .mfd-row__avatar {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-right: 22rpx;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: #ecebf1;
  }

  .mfd-row__avatar-letter {
    font-size: 40rpx;
    line-height: 48rpx;
    font-weight: 600;
    color: #ffffff;
  }

  .mfd-row__rest {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .mfd-row__title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .mfd-row__name {
    flex: 1;
    min-width: 0;
    font-size: 31rpx;
    line-height: 44rpx;
    font-weight: 600;
    color: #141416;
  }

  .mfd-row__time {
    margin-left: 16rpx;
    flex-shrink: 0;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #94929c;
  }

  /* 记录正文：全文展示（不截断，转发快照本就是短消息合集）
     字号与消息详情页 chat-bubble__text 齐平：16px / 行高 25px（用 px 不随屏宽放大） */
  .mfd-row__text {
    margin-top: 4rpx;
    font-size: 16px;
    line-height: 25px;
    color: #33323d;
  }

  /* 正文链接段：微信同款链接蓝（与聊天正文 chat-md--link 一致），点击在外链 webview 打开 */
  .mfd-row__link {
    color: #576b95;
  }

  /* ===== 媒体附件（转发快照）===== */
  /* 图片缩略图网格（240rpx 方图，自动换行；多图快照横向铺开） */
  .mfd-media {
    margin-top: 8rpx;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .mfd-media__cell {
    width: 240rpx;
    height: 240rpx;
    margin: 4rpx 12rpx 4rpx 0;
  }

  .mfd-media__img {
    width: 240rpx;
    height: 240rpx;
    border-radius: 12rpx;
    background-color: #ecebf1;
  }

  /* ===== 视频附件（chat.uvue chat-video 同款）===== */
  /* 深色圆角占位卡 ↔ 播放器同尺寸（400×300 4:3）：切换不引起列表布局跳动；竖版视频 contain 黑边 */
  .mfd-video {
    margin-top: 12rpx;
    align-self: flex-start;
    width: 400rpx;
    height: 300rpx;
    border-radius: 12rpx;
    background-color: #1c1b20;
    overflow: hidden;
    /* 自绘控制条（chat-video-bar）是 <video> 的兄弟节点，靠本层定位压在播放器底部 */
    position: relative;
  }

  .mfd-video__player {
    width: 400rpx;
    height: 300rpx;
    background-color: #000000;
  }

  .mfd-video__poster {
    width: 400rpx;
    height: 300rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .mfd-video__play {
    width: 88rpx;
    height: 88rpx;
    border-radius: 44rpx;
    background-color: rgba(255, 255, 255, 0.18);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* PNG 内已做光学居中（bbox 中心右移 14/512），再整体右移 4rpx——chat.uvue 真机校准同款 */
  .mfd-video__play-icon {
    width: 60rpx;
    height: 60rpx;
    margin-left: 4rpx;
  }

  .mfd-video__hint {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.72);
  }

  /* ===== 语音附件（chat.uvue chat-voice 同款声波条 + 时长；本页无气泡，白底圆角行内卡）===== */
  .mfd-voice {
    margin-top: 12rpx;
    align-self: flex-start;
    padding: 0 20rpx;
    /* 高度定死：播放中声波条 150ms 一跳（最高 14+6=20px），高度自适应会逐帧回流抖动 */
    height: 52rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-radius: 12rpx;
    background-color: #ffffff;
  }

  .mfd-voice__bar {
    width: 6rpx;
    margin: 0 3rpx;
    border-radius: 3rpx;
    background-color: #22212a;
  }

  /* 播放中：换主题色（高度由 voiceTick 驱动跳动；App 端无 height 过渡，逐帧跳即动画） */
  .mfd-voice--playing .mfd-voice__bar {
    background-color: #5147ff;
  }

  .mfd-voice__dur {
    margin: 0 8rpx;
    font-size: 26rpx;
    line-height: 36rpx;
    color: #22212a;
  }

  /* 文件卡片（微信式：白底行卡，左名称两行+大小/下载状态，右类型图标；quote-detail qd-file 同款） */
  .mfd-file {
    margin-top: 12rpx;
    padding: 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: #ffffff;
    border-radius: 14rpx;
  }

  .mfd-file--active {
    background-color: #f2f1f7;
  }

  .mfd-file__col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .mfd-file__name {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #1c1b20;
    word-break: break-all;
  }

  .mfd-file__meta {
    margin-top: 6rpx;
    font-size: 22rpx;
    line-height: 30rpx;
    color: #9a98a5;
  }

  .mfd-file__icon-wrap {
    margin-left: 20rpx;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mfd-state {
    padding: 200rpx 48rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mfd-state__text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #9a98a5;
  }

  .mfd-bottom-space {
    height: 40rpx;
    /* #ifdef H5 || WEB */
    height: calc(40rpx + env(safe-area-inset-bottom, 0px));
    /* #endif */
  }
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #f2f3f5;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #f2f3f5;
  }
  /* #endif */
</style>
