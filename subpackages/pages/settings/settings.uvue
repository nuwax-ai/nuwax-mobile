<template>
  <view class="settings-page">
    <custom-nav-bar :title="t('Mobile.Mine.settings')" :has-safety-zone="true">
      <template v-slot:left>
        <view class="header-icon-box" @tap="handleBack">
          <svg-icon name="icon-a-Chevronleft" size="22" unit="px" />
        </view>
      </template>
    </custom-nav-bar>

    <scroll-view class="settings-scroll" direction="vertical" :show-scrollbar="false">
      <view class="card-group">
        <language-picker />
        <!-- 消息通知：业务开关。系统权限只能申请、无法由代码关闭，所以「关」只关业务侧。
             Android 无 OEM 系统推送通道时，本开关让位给下方「消息通知」入口。 -->
        <!-- #ifdef APP-ANDROID || APP-IOS || APP-HARMONY -->
        <view class="row-item" v-if="isLoggedIn && legacyPushSwitchVisible">
          <view class="row-icon-box">
            <svg-icon name="icon-bell" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.Profile.pushNotifications") }}</text>
          </view>
          <switch class="push-switch" :checked="pushSwitchChecked" :disabled="pushBusy || !pushReady" color="#6155F5" @change="handlePushChange" />
        </view>
        <!-- #endif -->
        <!-- #ifdef APP-ANDROID -->
        <view class="row-item" v-if="showPushBackgroundEntry" @click="openPushBackgroundActionSheet">
          <view class="row-icon-box">
            <svg-icon name="icon-bell" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ t("Mobile.PushBackground.title") }}</text>
          </view>
          <text class="row-value">{{ pushBackgroundStatusLabel }}</text>
          <text class="row-arrow">›</text>
        </view>
        <!-- #endif -->
      </view>

      <view class="card-group" v-if="isLoggedIn">
        <view class="row-item" @click="handleAboutNuwax">
          <view class="row-icon-box">
            <svg-icon name="icon-Info" size="20" unit="px" />
          </view>
          <view class="row-info">
            <text class="row-title">{{ aboutEntryTitle }}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref, computed, onUnmounted } from "vue";
  import { onShow } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiResCode } from "@/utils/apiResponse";
  import { getApiBaseUrl, isAboutUsEntryHost } from "@/constants/config";
  import { jumpNavigateBack } from "@/utils/common";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";
  import { useI18n, emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import LanguagePicker from "@/pages/mine/components/language-picker/language-picker.uvue";
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  import { apiImDeviceRegister, ensureImPushPreferenceUser } from "@/servers/im";
  import {
    getImPushCid,
    ensureImPushCid,
    getImNotifyPermissionState,
    openImNotifyPermissionSettings,
    IM_NOTIFY_PERMISSION_GRANTED,
  } from "@/utils/im/imPushClient";
  import {
    hasImPushPreferenceUser,
    readImPushEnabled,
    writeImPushEnabled,
  } from "@/utils/im/imPushPreference";
  import { getImSessionStamp } from "@/utils/im/imSessionScope";
  // #endif
  // #ifdef APP-ANDROID
  import {
    getPushBackgroundStatus,
    openBatteryOptimizationSettings,
    openNotificationSettings,
    type PushBackgroundStatus,
  } from "@/utils/push/pushBackgroundStatus";
  // #endif

  const { ensureLangList } = useI18n();
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const { hasToken } = useAuthInterceptor();
  const isLoggedIn = ref<boolean>(false);
  /** 女娲个人版正式站显示「关于女娲」，其它服务域名显示「关于我们」。 */
  const nuwaxOwnApp = ref<boolean>(isAboutUsEntryHost());
  const aboutEntryTitle = computed((): string => {
    return t(nuwaxOwnApp.value ? "Mobile.Mine.aboutNuwax" : "Mobile.Mine.aboutUs");
  });

  const handleBack = () => {
    jumpNavigateBack();
  };

  const handleAboutNuwax = () => {
    uni.navigateTo({ url: "/subpackages/pages/about-nuwax/about-nuwax" });
  };
  // === 推送通知（业务开关，自账号管理页移入「我的-账户」，「系统消息」下方） ===
  // ★开关状态 = 业务开关本身（后端 push_enabled）：拨开即开、拨关即关。
  //   系统通知权限只在「拨到开」之后做一次提示：未开启则弹窗引导去设置，
  //   ★但开关保持打开（用户是否去开启系统权限不影响这里的业务状态）；拨关完全不读权限。
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  const pushEnabled = ref<boolean>(false);
  /** 原「推送通知」业务开关是否显示：iOS/鸿蒙恒显示；Android 按「有没有 OEM 系统推送通道」
   *  二选一——有渠道显示本开关，无渠道让位给「消息通知」入口（见 refreshPushBackgroundStatus）。
   *  ★Android 初值/检测失败一律 true（fail-open）：绝大多数机型有渠道，且本开关只关业务侧、
   *    误显示无害；确认无渠道的那一帧再切走。 */
  const legacyPushSwitchVisible = ref<boolean>(true);
  /** 推送身份（users/me）已就绪：未就绪时本地偏好无宿主，开关置灰不可拨。 */
  const pushReady = ref<boolean>(false);
  const pushBusy = ref<boolean>(false);
  /** 开关的显示值：乐观更新（用户拨动即变），失败时回弹到真实业务开关。 */
  const pushSwitchChecked = ref<boolean>(false);
  let pushPageActive = true;
  let pushPageStamp = "";
  /**
   * pushBusy 操作代次 + 看门狗。
   * ★踩过的坑：拨开开关时若用户跳去系统设置手动开权限，App 期间退到后台，
   *   `ensureImPushPreferenceUser` / `apiImDeviceRegister` 的请求回调可能丢失
   *   （Promise 永不 settle）→ pushBusy 卡在 true → 开关 `:disabled="pushBusy"` 永久变灰，
   *   用户只能杀 App。所以：①每次操作带代次，旧流程回来不得再写状态；②看门狗超时强制复位。
   */
  let pushBusySeq = 0;
  let pushBusyTimer = 0;
  const PUSH_BUSY_TIMEOUT_MS = 8000;

  // #ifdef APP-ANDROID
  const pushBackgroundLoading = ref<boolean>(false);
  const pushBackgroundState = ref<PushBackgroundStatus | null>(null);
  let pushBackgroundSeq = 0;

  // ★不再看 pushEnabled：无渠道机型的原业务开关已被本入口取代（见模板与 legacyPushSwitchVisible），
  //   存量「已关闭」不再有 UI 入口，否则这一行会永久隐藏。
  const showPushBackgroundEntry = computed((): boolean => {
    const state = pushBackgroundState.value;
    return isLoggedIn.value && state != null && state.vendor == "none";
  });

  const pushBackgroundStatusLabel = computed((): string => {
    if (pushBackgroundLoading.value) return t("Mobile.PushBackground.checking");
    const state = pushBackgroundState.value;
    if (state == null) return "";
    return state.manualSettingsRequired
      ? t("Mobile.PushBackground.needsSetup")
      : t("Mobile.PushBackground.optimized");
  });

  async function refreshPushBackgroundStatus(): Promise<void> {
    const seq = ++pushBackgroundSeq;
    if (!isLoggedIn.value) {
      pushBackgroundLoading.value = false;
      pushBackgroundState.value = null;
      legacyPushSwitchVisible.value = true;
      return;
    }
    pushBackgroundLoading.value = true;
    try {
      const state = await getPushBackgroundStatus();
      if (seq != pushBackgroundSeq) return;
      pushBackgroundState.value = state;
      // 无渠道 → 原业务开关让位给「消息通知」入口；有渠道 → 保留原开关
      legacyPushSwitchVisible.value = state.vendor != "none";
    } catch (_e) {
      if (seq == pushBackgroundSeq) {
        pushBackgroundState.value = null;
        legacyPushSwitchVisible.value = true;
      }
    } finally {
      if (seq == pushBackgroundSeq) pushBackgroundLoading.value = false;
    }
  }

  /**
   * 无 OEM 系统推送通道的机型没有业务推送开关入口：存量「已关闭」恢复开启。
   * ★否则 registerImDeviceNow 会继续上报 pushEnabled=false，后端永不下发离线推送，
   *   而页面里已经没有任何入口能把开关拨回来。
   * ★有渠道机型**不得**调用：用户主动关掉推送是有效诉求，强行打开属于篡改偏好。
   * @returns 是否真的做了写入（调用方据此决定要不要补一次设备注册）
   */
  function ensureAndroidPushPreferenceOn(): boolean {
    if (!hasImPushPreferenceUser() || readImPushEnabled()) return false;
    writeImPushEnabled(true);
    return true;
  }

  function openPushBackgroundActionSheet(): void {
    uni.showActionSheet({
      itemList: [
        t("Mobile.PushBackground.openNotificationSettings"),
        // 电池子页没有公开深链：落到应用详情页，用户在那里点「电池」即可。
        t("Mobile.PushBackground.openBatterySettings"),
      ],
      success: (res: ShowActionSheetSuccess): void => {
        if (res.tapIndex == 0) openNotificationSettings();
        else if (res.tapIndex == 1) openBatteryOptimizationSettings();
      },
    });
  }
  // #endif

  /** 按业务开关同步开关显示值。 */
  function syncPushSwitch(): void {
    pushSwitchChecked.value = pushEnabled.value;
  }

  /** 开始一次开关操作：返回本次代次，并挂上看门狗（请求挂起时自动解灰）。 */
  function beginPushBusy(): number {
    pushBusySeq += 1;
    const seq = pushBusySeq;
    pushBusy.value = true;
    if (pushBusyTimer != 0) {
      clearTimeout(pushBusyTimer);
    }
    pushBusyTimer = setTimeout(() => {
      pushBusyTimer = 0;
      if (seq != pushBusySeq) return;
      pushBusy.value = false;
      // 挂起期间显示的乐观值可能从未落库：按真实业务开关重算
      syncPushSwitch();
    }, PUSH_BUSY_TIMEOUT_MS);
    return seq;
  }

  /** 结束一次开关操作（只有代次仍是最新的那次才生效，旧流程回来不得解掉新流程的忙碌态）。 */
  function endPushBusy(seq: number): void {
    if (seq != pushBusySeq) return;
    if (pushBusyTimer != 0) {
      clearTimeout(pushBusyTimer);
      pushBusyTimer = 0;
    }
    pushBusy.value = false;
  }

  /** 作废所有在途操作并解灰（页面重新可见时用：上一次操作可能已被系统挂起）。 */
  function abortPushBusy(): void {
    pushBusySeq += 1;
    if (pushBusyTimer != 0) {
      clearTimeout(pushBusyTimer);
      pushBusyTimer = 0;
    }
    pushBusy.value = false;
    syncPushSwitch();
  }

  function pushSettingsStamp(): string {
    return `${getImSessionStamp()}|${getApiBaseUrl()}`;
  }

  function pushCurrent(stamp: string, seq: number): boolean {
    // 代次不符 = 本次操作已被 onShow 的 abortPushBusy 作废，返回值一律丢弃
    return pushPageActive && seq == pushBusySeq && stamp == pushSettingsStamp();
  }

  /** 补推一次当前偏好（用于旧请求可能晚于新状态落到服务端的收敛，失败忽略）。
   *  ★cid 还没有时不要注册：registerImDeviceNow 在 pushToken 为空时会把 pushEnabled 写 false，
   *    等于替用户把服务端开关关掉（等 cid 到达后由推送客户端自己的注册链路补推）。 */
  async function resyncPushRegistration(): Promise<void> {
    if (getImPushCid().length == 0) return;
    try {
      await apiImDeviceRegister(getImPushCid());
    } catch (_e) {
      // 忽略：下次进页 onShow 的 refreshPushPreference 还会再注册
    }
  }

  // #ifdef APP-ANDROID
  /**
   * 检测后台接收状态，并在「确认无 OEM 推送通道」时把存量「已关闭」恢复为开启。
   * ★必须在拿到 vendor 之后才改偏好：有渠道机型的开关是用户主动关的，提前改会篡改其意图。
   * ★不能把这段搬进 refreshPushBackgroundStatus：它要调下面的 resyncPushRegistration，
   *   而 UTS 不允许前向引用（error18）。
   */
  function refreshPushBackgroundAndMigrate(): void {
    // UI 状态（入口分流 + 文案）走统一的 seq 去重链路
    refreshPushBackgroundStatus();
    // 偏好迁移单独判一次：不读 pushBackgroundState，避免和并发调用互相覆盖导致漏迁移
    getPushBackgroundStatus().then((state): void => {
      if (state.vendor != "none") return;
      if (!ensureAndroidPushPreferenceOn()) return;
      // 偏好已从「关」恢复为「开」：同步开关显示值，并补一次注册让服务端收敛
      pushEnabled.value = readImPushEnabled();
      syncPushSwitch();
      resyncPushRegistration();
    }).catch((_e: any | null): void => {
      // 检测失败不动偏好（下次进页重试）
    });
  }
  // #endif

  /**
   * 进页/切回本 Tab 时校正开关。
   * ★tab 页每次显示都会走这里（比账号管理页的「进页一次」频繁得多），所以分两条路：
   *   ①身份已绑定（常态）：先用本地偏好即时点亮开关，再后台补一次设备注册——不占 pushBusy，
   *     开关不会每次切回来都短暂置灰；注册体在真正发送时才读本地偏好，与用户拨动天然收敛。
   *   ②身份未绑定（首次登录/换账号/换环境）：走完整流程（whoami 绑定 → 注册），期间置灰防并发。
   */
  async function refreshPushPreference(): Promise<void> {
    if (pushBusy.value) return;
    if (hasImPushPreferenceUser()) {
      pushReady.value = true;
      pushEnabled.value = readImPushEnabled();
      syncPushSwitch();
      // #ifdef APP-ANDROID
      // 后台接收状态检测；确认无 OEM 通道时同时迁移存量「已关闭」偏好（见上）
      refreshPushBackgroundAndMigrate();
      // #endif
      resyncPushRegistration();
      return;
    }
    const stamp = pushSettingsStamp();
    const seq = beginPushBusy();
    try {
      const ready = await ensureImPushPreferenceUser();
      if (!pushCurrent(stamp, seq)) return;
      pushReady.value = ready;
      pushEnabled.value = readImPushEnabled();
      syncPushSwitch();
      // #ifdef APP-ANDROID
      refreshPushBackgroundAndMigrate();
      // #endif
      if (!ready) throw new Error(t("Mobile.Error.pushIdentityUnavailable"));
      // 注册一次让服务端拿到本设备的最新偏好（失败无 UI 提示：下次 onShow 会重试）
      await apiImDeviceRegister(getImPushCid());
    } catch (_e) {
      // 忽略：开关状态保持不变
    } finally {
      endPushBusy(seq);
    }
  }

  /**
   * 拨开后检查系统通知权限：未开启就弹窗提示并引导去系统设置。
   * ★只提示，不影响开关：业务开关已经打开，用户去不去开系统权限由他自己决定。
   */
  function hintSystemNotificationIfOff(): void {
    getImNotifyPermissionState().then((state: string): void => {
      if (!pushPageActive) return;
      if (state == IM_NOTIFY_PERMISSION_GRANTED) return;
      uni.showModal({
        title: t("Mobile.Profile.systemNotificationPermission"),
        content: t("Mobile.Profile.systemNotificationDeniedTip"),
        confirmText: t("Mobile.Voice.goToSettings"),
        cancelText: t("Mobile.Common.cancel"),
        success: (res: ShowModalSuccess) => {
          if (res.confirm == true) {
            openImNotifyPermissionSettings();
          }
        },
      });
    }).catch((_e: any | null): void => {
      // 读不到权限状态就不提示，不影响业务开关
    });
  }

  /**
   * 推送通知（业务开关）：拨开即开、拨关即关。
   * ★打开后若系统通知未开启，弹一次提示引导去设置；开关本身保持打开，
   *   用户是否去开启系统权限不影响这里的业务状态。
   * ★并发控制：busy 期间开关 disabled + 入口再判 busy（互斥，杜绝并发注册乱序）；
   *   不做时间窗防抖——拨动必须即时响应，重复/连拨已被互斥挡住。
   */
  async function handlePushChange(event: any): Promise<void> {
    if (pushBusy.value || !pushReady.value) return;
    const change = event as UniSwitchChangeEvent;
    const want = change.detail.value;
    // 程序化改值（回弹）在部分平台会再冒一次 change：与当前显示值相同即视为回传，忽略
    if (want == pushSwitchChecked.value) return;
    // 乐观更新：用户拨动即改变显示值，失败时再回弹（switch 非受控回弹需要值有变化）
    pushSwitchChecked.value = want;
    const stamp = pushSettingsStamp();
    const seq = beginPushBusy();
    try {
      if (want) {
        // ★开启前必须先有推送 cid：cid 为空时设备注册会把 pushEnabled 强制置为 false
        //   （见 servers/im.uts registerImDeviceNow），服务端会继续按「关闭」过滤本设备，
        //   表现为「开关已打开但退后台收不到离线通知」。
        const cid = await ensureImPushCid();
        if (!pushCurrent(stamp, seq)) return;
        if (cid.length == 0) {
          console.error("[PushSwitch] open aborted: push cid unavailable");
          uni.showToast({ title: t("Mobile.Profile.pushTokenPending"), icon: "none" });
          // 没有 cid 就无法真正开启：回弹到真实业务开关值（保持关闭）
          syncPushSwitch();
          return;
        }
      }
      if (!writeImPushEnabled(want)) throw new Error(t("Mobile.Error.pushIdentityChanged"));
      pushEnabled.value = readImPushEnabled();
      const res = await apiImDeviceRegister(getImPushCid());
      if (!pushCurrent(stamp, seq)) {
        // 本次操作已被 onShow / 换账号作废，但请求可能后到把旧偏好写进服务端：
        // 按当前真实偏好补推一次，让服务端收敛到最新值（并发互斥之外的最后一道保险）
        resyncPushRegistration();
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) throw new Error(t("Mobile.Error.pushNotSynchronized"));
      syncPushSwitch();
      // #ifdef APP-ANDROID
      refreshPushBackgroundStatus();
      // #endif
      if (want) {
        uni.showToast({title:t("Mobile.Profile.pushSaved"),icon:"none"});
        // 开关已打开；若系统通知未开启，过一拍弹提示（先让 toast 露一下再弹窗）
        setTimeout((): void => {
          hintSystemNotificationIfOff();
        }, 750);
      } else {
        uni.showToast({title:t("Mobile.Profile.pushDisabledToast"),icon:"none"});
      }
    } catch (_e) {
      if (pushCurrent(stamp, seq)) {
        pushEnabled.value = readImPushEnabled();
        // 按真实业务开关回算显示：关闭失败时业务仍开着，应显示为开
        syncPushSwitch();
        uni.showToast({title:t("Mobile.Profile.pushPending"),icon:"none"});
      }
    } finally {
      endPushBusy(seq);
    }
  }

  onUnmounted(() => {
    pushPageActive = false;
    if (pushBusyTimer != 0) {
      clearTimeout(pushBusyTimer);
      pushBusyTimer = 0;
    }
  });
  // #endif

  const refreshSettings = async () => {
    ensureLangList();
    nuwaxOwnApp.value = isAboutUsEntryHost();
    isLoggedIn.value = await hasToken();
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    pushPageActive = true;
    if (pushPageStamp != pushSettingsStamp()) {
      pushPageStamp = pushSettingsStamp();
      pushReady.value = false;
      pushEnabled.value = false;
    }
    abortPushBusy();
    refreshPushPreference();
    // #endif
  };

  onShow(() => {
    refreshSettings();
  });
</script>

<style lang="scss" scoped>
  .settings-page {
    flex: 1;
    background-color: #f7f7f7;
    display: flex;
    flex-direction: column;
  }

  .header-icon-box {
    width: 32px;
    height: 32px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .settings-scroll {
    flex: 1;
  }

  .card-group {
    background-color: #ffffff;
    border-radius: 12px;
    margin: 12px 12px 0;
    overflow: hidden;
  }

  .row-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid #f5f5f5;

    &:last-child {
      border-bottom-width: 0;
    }
  }

  .row-icon-box {
    width: 28px;
    height: 28px;
    margin-right: 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .row-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .row-title {
    font-size: 15px;
    font-weight: 500;
    color: #1a1a1a;
  }

  .row-arrow {
    font-size: 20px;
    color: #c0c0c0;
    font-weight: 300;
    line-height: 1;
    padding-left: 4px;
  }

  .row-value {
    font-size: 13px;
    color: #999999;
    margin-left: 8px;
  }

  .push-switch {
    margin-left: 8px;
  }
</style>
