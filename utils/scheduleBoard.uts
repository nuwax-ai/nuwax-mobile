/**
 * 日程页四种视图共用的日期计算与条目组装。
 * 演示日程按设计稿落在 2026 年 11 月；本机新建的日程会叠在同一天。
 */
import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
import { ScheduleEvent, eventsOnDateIn, loadScheduleEvents } from "@/utils/scheduleStore";

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

/** 一条可渲染的日程。时间以当天 0 点起的分钟数表示，全天时 startMin 为 -1。 */
export class ScheduleItem {
  id: string = "";
  title: string = "";
  date: string = "";
  allDay: boolean = false;
  startMin: number = 0;
  endMin: number = 0;
  /** 色条 / 时间块实色 */
  solid: string = "#7C6BF2";
  /** 列表、全天条的浅底 */
  pastel: string = "#E7E4FF";
  /** 浅底上的文字色 */
  ink: string = "#6A5AE0";
  /** 月视图副标题：全天，或 09:30 - 10:30 */
  timeRange: string = "";
  /** 列表右侧：全天，或开始时间 */
  timeStart: string = "";
}

export function pad2(n: number): string {
  if (n < 10) {
    return "0" + n;
  }
  return "" + n;
}

/** yyyy-mm-dd */
export function toIso(year: number, month: number, day: number): string {
  return year + "-" + pad2(month) + "-" + pad2(day);
}

export function dateKey(year: number, month: number, day: number): number {
  return year * 10000 + month * 100 + day;
}

/** 把日期平移 delta 天，返回 [year, month, day]。 */
export function shiftDate(year: number, month: number, day: number, delta: number): number[] {
  const date = new Date(year, month - 1, day + delta);
  const result: number[] = [];
  result.push(date.getFullYear());
  result.push(date.getMonth() + 1);
  result.push(date.getDate());
  return result;
}

/** 所在周的周日，周从周日开始。 */
export function weekSunday(year: number, month: number, day: number): number[] {
  const weekday = new Date(year, month - 1, day).getDay();
  return shiftDate(year, month, day, -weekday);
}

function packDate(year: number, month: number, day: number): number[] {
  const result: number[] = [];
  result.push(year);
  result.push(month);
  result.push(day);
  return result;
}

function firstSunday(year: number): number[] {
  const weekday = new Date(year, 0, 1).getDay();
  if (weekday == 0) {
    return packDate(year, 1, 1);
  }
  return packDate(year, 1, 1 + (7 - weekday));
}

function dayDiff(from: number[], to: number[]): number {
  const start = new Date(from[0], from[1] - 1, from[2]).getTime();
  const end = new Date(to[0], to[1] - 1, to[2]).getTime();
  const raw = (end - start) / 86400000;
  if (raw >= 0) {
    return Math.round(raw);
  }
  return -Math.round(-raw);
}

/**
 * 年内周序号。周从周日开始，当年第一个周日为第 1 周。
 * 2026-11-01 是周日，对应第 44 周。
 */
export function weekNumber(year: number, month: number, day: number): number {
  const sunday = weekSunday(year, month, day);
  let first = firstSunday(sunday[0]);
  if (dateKey(sunday[0], sunday[1], sunday[2]) < dateKey(first[0], first[1], first[2])) {
    first = firstSunday(sunday[0] - 1);
  }
  const diff = dayDiff(first, sunday);
  if (diff < 0) {
    return 1;
  }
  return Math.floor(diff / 7) + 1;
}

export function minutesLabel(total: number): string {
  let value = total;
  if (value < 0) {
    value = 0;
  }
  const hour = Math.floor(value / 60);
  const minute = value % 60;
  return pad2(hour) + ":" + pad2(minute);
}

export function gmtLabel(): string {
  const offset = -new Date().getTimezoneOffset();
  const sign = offset >= 0 ? "+" : "-";
  const abs = offset >= 0 ? offset : -offset;
  const hours = Math.floor(abs / 60);
  return "GMT" + sign + hours;
}

function fillText(key: string, params: Map<string, string | number>): string {
  return translateFn(key, toI18nParams(params), "");
}

/** 月视图日期行，不含「今天」。 */
export function dateLine(year: number, month: number, day: number, weekday: string): string {
  const params = new Map<string, string | number>();
  params.set("month", month);
  params.set("day", day);
  params.set("weekday", weekday);
  return fillText("Mobile.Discover.scheduleDate", params);
}

export function dayHead(month: number, day: number, weekday: string): string {
  const params = new Map<string, string | number>();
  params.set("month", month);
  params.set("day", day);
  params.set("weekday", weekday);
  return fillText("Mobile.Discover.scheduleDayHead", params);
}

export function weekSpan(startMonth: number, startDay: number, endMonth: number, endDay: number): string {
  const params = new Map<string, string | number>();
  params.set("startMonth", startMonth);
  params.set("startDay", startDay);
  params.set("endMonth", endMonth);
  params.set("endDay", endDay);
  return fillText("Mobile.Discover.scheduleWeekSpan", params);
}

export function weekNoText(week: number): string {
  const params = new Map<string, string | number>();
  params.set("week", week);
  return fillText("Mobile.Discover.scheduleWeekNo", params);
}

export function monthTitle(year: number, month: number): string {
  const params = new Map<string, string | number>();
  params.set("year", year);
  params.set("month", month);
  return fillText("Mobile.Discover.scheduleMonth", params);
}

function paint(item: ScheduleItem, color: string): void {
  if (color == "orange") {
    item.solid = "#F0A04A";
    item.pastel = "#FDEBD8";
    item.ink = "#C47A32";
    return;
  }
  if (color == "green") {
    item.solid = "#2FBF86";
    item.pastel = "#DDF6EA";
    item.ink = "#1E9A68";
    return;
  }
  if (color == "mint") {
    item.solid = "#5FCB8A";
    item.pastel = "#E5F6EC";
    item.ink = "#3D9A62";
    return;
  }
  if (color == "teal") {
    item.solid = "#2EBF9A";
    item.pastel = "#D8F6EF";
    item.ink = "#1F9A80";
    return;
  }
  item.solid = "#7C6BF2";
  item.pastel = "#E7E4FF";
  item.ink = "#6A5AE0";
}

function applyTimeText(item: ScheduleItem): void {
  if (item.allDay) {
    const label = t("Mobile.Discover.scheduleAllDay");
    item.timeRange = label;
    item.timeStart = label;
    return;
  }
  const start = minutesLabel(item.startMin);
  const end = minutesLabel(item.endMin);
  item.timeRange = start + " - " + end;
  item.timeStart = start;
}

function makeItem(id: string, title: string, date: string, allDay: boolean, startMin: number, endMin: number, color: string): ScheduleItem {
  const item = new ScheduleItem();
  item.id = id;
  item.title = title;
  item.date = date;
  item.allDay = allDay;
  item.startMin = startMin;
  item.endMin = endMin;
  paint(item, color);
  applyTimeText(item);
  return item;
}

function pushSample(list: ScheduleItem[], date: string, titleKey: string, startMin: number, endMin: number, color: string): void {
  if (startMin < 0) {
    list.push(makeItem("sample-" + date + "-" + titleKey, t(titleKey), date, true, 0, 0, color));
    return;
  }
  list.push(makeItem("sample-" + date + "-" + titleKey, t(titleKey), date, false, startMin, endMin, color));
}

/** 设计稿里 2026 年 11 月的演示日程。其它月份返回空。 */
function samplesOn(iso: string): ScheduleItem[] {
  const list: ScheduleItem[] = [];
  if (iso == "2026-11-21") {
    pushSample(list, iso, "Mobile.Discover.scheduleSampleWeekly", 16 * 60, 17 * 60, "purple");
  } else if (iso == "2026-11-22") {
    pushSample(list, iso, "Mobile.Discover.scheduleSampleGear", -1, -1, "orange");
    pushSample(list, iso, "Mobile.Discover.scheduleSampleReview", 9 * 60 + 30, 10 * 60 + 30, "purple");
    pushSample(list, iso, "Mobile.Discover.scheduleSampleSplit", 14 * 60, 15 * 60, "green");
  } else if (iso == "2026-11-23") {
    pushSample(list, iso, "Mobile.Discover.scheduleSampleIterate", 10 * 60, 11 * 60 + 30, "mint");
  } else if (iso == "2026-11-24") {
    pushSample(list, iso, "Mobile.Discover.scheduleSampleBadminton", 19 * 60, 21 * 60, "teal");
  } else if (iso == "2026-11-25") {
    pushSample(list, iso, "Mobile.Discover.scheduleSampleStandup", 9 * 60, 9 * 60 + 30, "mint");
  } else if (iso == "2026-11-27") {
    pushSample(list, iso, "Mobile.Discover.scheduleSampleCamp", -1, -1, "orange");
  }
  return list;
}

function hmToMin(text: string): number {
  const parts = text.split(":");
  if (parts.length < 2) {
    return 0;
  }
  const hour = parseInt(parts[0]);
  const minute = parseInt(parts[1]);
  if (isNaN(hour) || isNaN(minute)) {
    return 0;
  }
  return hour * 60 + minute;
}

function localItems(iso: string, locals: ScheduleEvent[]): ScheduleItem[] {
  const year = parseInt(iso.substring(0, 4));
  const month = parseInt(iso.substring(5, 7));
  const day = parseInt(iso.substring(8, 10));
  if (isNaN(year) || isNaN(month) || isNaN(day)) {
    return [] as ScheduleItem[];
  }
  const weekday = new Date(year, month - 1, day).getDay();
  const matched = eventsOnDateIn(locals, iso, weekday, day, month);
  const list: ScheduleItem[] = [];
  for (let i = 0; i < matched.length; i++) {
    const event = matched[i];
    const name = event.title.trim();
    const title = name.length > 0 ? name : t("Mobile.Discover.scheduleUntitled");
    const start = hmToMin(event.startTime);
    let end = hmToMin(event.endTime);
    if (end <= start) {
      end = start + 30;
    }
    list.push(makeItem(event.id, title, iso, false, start, end, "purple"));
  }
  return list;
}

function sortItems(items: ScheduleItem[]): void {
  items.sort((a: ScheduleItem, b: ScheduleItem): number => {
    if (a.allDay == true && b.allDay != true) {
      return -1;
    }
    if (a.allDay != true && b.allDay == true) {
      return 1;
    }
    return a.startMin - b.startMin;
  });
}

/**
 * 某一天要展示的日程：演示数据在前，本机新建的接在后面。
 * @param iso yyyy-mm-dd
 * @param locals 已加载的本机日程，避免月历每个格子重复读存储
 */
export function buildItems(iso: string, locals: ScheduleEvent[]): ScheduleItem[] {
  const items = samplesOn(iso);
  const saved = localItems(iso, locals);
  for (let i = 0; i < saved.length; i++) {
    items.push(saved[i]);
  }
  sortItems(items);
  return items;
}

/** 读存储后组装某一天的日程。 */
export function itemsOnDate(iso: string): ScheduleItem[] {
  return buildItems(iso, loadScheduleEvents());
}

/** 月历格点颜色，最多 3 个。 */
export function dotHexesFor(iso: string, locals: ScheduleEvent[]): string[] {
  const items = buildItems(iso, locals);
  const hexes: string[] = [];
  for (let i = 0; i < items.length && hexes.length < 3; i++) {
    hexes.push(items[i].solid);
  }
  return hexes;
}

/** 详情页展示用的一条日程。文案已按当前语言拼好。 */
export class ScheduleDetail {
  id: string = "";
  title: string = "";
  allDay: boolean = false;
  startHeadline: string = "";
  endHeadline: string = "";
  startDateText: string = "";
  endDateText: string = "";
  repeatText: string = "";
  remindText: string = "";
  location: string = "";
  notes: string = "";
  hasLocation: boolean = false;
  hasNotes: boolean = false;
}

const detailWeekdayKeys: string[] = [
  "Mobile.Discover.weekdaySun",
  "Mobile.Discover.weekdayMon",
  "Mobile.Discover.weekdayTue",
  "Mobile.Discover.weekdayWed",
  "Mobile.Discover.weekdayThu",
  "Mobile.Discover.weekdayFri",
  "Mobile.Discover.weekdaySat",
];

function plainDateText(iso: string): string {
  if (iso.length < 10) {
    return "";
  }
  const year = parseInt(iso.substring(0, 4));
  const month = parseInt(iso.substring(5, 7));
  const day = parseInt(iso.substring(8, 10));
  if (isNaN(year) || isNaN(month) || isNaN(day)) {
    return "";
  }
  const weekday = t(detailWeekdayKeys[new Date(year, month - 1, day).getDay()]);
  const params = new Map<string, string | number>();
  params.set("month", month);
  params.set("day", day);
  params.set("weekday", weekday);
  return fillText("Mobile.Discover.scheduleDatePlain", params);
}

function remindText(key: string): string {
  if (key == "none") {
    return t("Mobile.Discover.scheduleRemindNone");
  }
  if (key == "start") {
    return t("Mobile.Discover.scheduleRemindStart");
  }
  if (key == "m5") {
    const params = new Map<string, string | number>();
    params.set("minutes", 5);
    return fillText("Mobile.Discover.scheduleRemindMinutes", params);
  }
  if (key == "m30") {
    const params = new Map<string, string | number>();
    params.set("minutes", 30);
    return fillText("Mobile.Discover.scheduleRemindMinutes", params);
  }
  if (key == "h1") {
    return t("Mobile.Discover.scheduleRemindHour");
  }
  const params = new Map<string, string | number>();
  params.set("minutes", 15);
  return fillText("Mobile.Discover.scheduleRemindMinutes", params);
}

function repeatText(key: string): string {
  if (key == "daily") {
    return t("Mobile.Discover.scheduleRepeatDaily");
  }
  if (key == "weekly") {
    return t("Mobile.Discover.scheduleRepeatWeekly");
  }
  if (key == "monthly") {
    return t("Mobile.Discover.scheduleRepeatMonthly");
  }
  if (key == "yearly") {
    return t("Mobile.Discover.scheduleRepeatYearly");
  }
  return t("Mobile.Discover.scheduleRepeatNone");
}

function detailFromParts(id: string, title: string, allDay: boolean, startDate: string, endDate: string, startMin: number, endMin: number, repeat: string, remind: string, location: string, notes: string): ScheduleDetail {
  const detail = new ScheduleDetail();
  detail.id = id;
  detail.title = title;
  detail.allDay = allDay;
  const allDayLabel = t("Mobile.Discover.scheduleAllDay");
  detail.startHeadline = allDay ? allDayLabel : minutesLabel(startMin);
  detail.endHeadline = allDay ? allDayLabel : minutesLabel(endMin);
  detail.startDateText = plainDateText(startDate);
  const end = endDate.length > 0 ? endDate : startDate;
  detail.endDateText = plainDateText(end);
  detail.repeatText = repeatText(repeat);
  detail.remindText = remindText(remind);
  const place = location.trim();
  const note = notes.trim();
  detail.location = place;
  detail.notes = note;
  detail.hasLocation = place.length > 0;
  detail.hasNotes = note.length > 0;
  return detail;
}

/**
 * 按 id 找一条日程。演示数据和本机新建的都能打开。
 * 找不到时返回 null。
 */
export function findScheduleDetail(id: string): ScheduleDetail | null {
  if (id.length == 0) {
    return null;
  }
  const locals = loadScheduleEvents();
  for (let i = 0; i < locals.length; i++) {
    const event = locals[i];
    if (event.id != id) {
      continue;
    }
    const name = event.title.trim();
    const title = name.length > 0 ? name : t("Mobile.Discover.scheduleUntitled");
    const start = hmToMin(event.startTime);
    let end = hmToMin(event.endTime);
    if (end <= start) {
      end = start + 30;
    }
    return detailFromParts(event.id, title, false, event.startDate, event.endDate, start, end, event.repeat, event.remind, event.location, event.notes);
  }
  if (id.indexOf("sample-") != 0 || id.length < 18) {
    return null;
  }
  const date = id.substring(7, 17);
  const samples = samplesOn(date);
  for (let i = 0; i < samples.length; i++) {
    const item = samples[i];
    if (item.id != id) {
      continue;
    }
    return detailFromParts(item.id, item.title, item.allDay, item.date, item.date, item.startMin, item.endMin, "none", "m15", "", "");
  }
  return null;
}
