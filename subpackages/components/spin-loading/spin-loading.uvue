<template>
  <!--
    App 端 CSS @keyframes / image animation 常无效；
    用 transition + setInterval 自驱动旋转，避免 transitionend 在父级重渲染中途改响应式触发 CME。
  -->
  <view
    class="spin-loading"
    :style="boxStyle"
  ></view>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { ref, computed, onMounted, onUnmounted } from "vue";

  const props = withDefaults(
    defineProps<{
      /** 尺寸，如 14px / 24px */
      size?: string;
      /** 环颜色 */
      color?: string;
      /** 一圈时长（ms），默认 1000 对齐 H5 */
      durationMs?: number;
    }>(),
    {
      size: "16px",
      color: "#3283ff",
      durationMs: 1000,
    },
  );

  const times = ref<number>(0);
  let spinTimer: number = 0;
  let startTimer: number = 0;

  const boxStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    style["width"] = props.size;
    style["height"] = props.size;
    style["borderTopColor"] = props.color;
    style["borderRightColor"] = props.color;
    style["transform"] = `rotate(${times.value * 360}deg)`;
    style["transitionDuration"] = `${props.durationMs}ms`;
    return style;
  });

  function clearSpinTimers(): void {
    if (spinTimer != 0) {
      clearInterval(spinTimer);
      spinTimer = 0;
    }
    if (startTimer != 0) {
      clearTimeout(startTimer);
      startTimer = 0;
    }
  }

  onMounted(() => {
    // 等节点就绪后再启动，避免首帧 transition 不触发
    startTimer = setTimeout(() => {
      startTimer = 0;
      times.value = 1;
      const period =
        props.durationMs != null && props.durationMs > 0
          ? props.durationMs
          : 1000;
      spinTimer = setInterval(() => {
        times.value = times.value + 1;
      }, period);
    }, 50);
  });

  onUnmounted(() => {
    clearSpinTimers();
  });
</script>

<style lang="scss" scoped>
  .spin-loading {
    box-sizing: border-box;
    border-radius: 100px;
    border-top-width: 2px;
    border-top-style: solid;
    border-right-width: 2px;
    border-right-style: solid;
    border-bottom-width: 2px;
    border-bottom-style: solid;
    border-bottom-color: transparent;
    border-left-width: 2px;
    border-left-style: solid;
    border-left-color: transparent;
    transition-property: transform;
    transition-timing-function: linear;
    transform: rotate(0deg);
  }
</style>
