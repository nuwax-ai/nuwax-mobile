    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ga-search__btn--active {
    background-color: rgba(81, 71, 255, 0.16);
  }

  .ga-body {
    flex: 1;
    min-height: 0;
    padding: 16rpx 32rpx;
  }

  .ga-tip {
    padding: 160rpx 48rpx;
    display: flex;
    flex-direction: column;
