<template>
  <!-- 外层须包普通 view 再放 scroll-view（manual-component-bar 同款）：scroll-view 直接当
       组件根节点时 App 端宽度测量异常，内容不超宽、横滑失效 -->
  <view class="files-wrapper">
    <scroll-view
      class="files-container"
      direction="horizontal"
      :scroll-x="true"
      :scroll-y="false"
      :scroll-with-animation="true"
      :show-scrollbar="false"
    >
      <view class="files-scroll-content" :style="filesRowStyle">
        <template v-for="file in files" :key="resolveUploadItemKey(file)">
          <!-- 如果文件是图片，则显示图片，否则显示文档默认图片 -->
          <view
            class="files-box relative"
            :class="[
              isImageFile(file) == false
                ? 'files-box-file'
                : 'files-box-image',
              isFileError(file) ? 'files-box-error' : '',
            ]"
            @click="onPreview(file)"
          >
            <view
              class="files-box-loading"
              v-if="isFileUploading(file)"
            >
              <!-- App：CSS animation 对 image 无效，用 spin-loading -->
              <!-- #ifdef APP -->
              <spin-loading size="48rpx" color="#3bb346" :duration-ms="800" />
              <!-- #endif -->
              <!-- #ifndef APP -->
              <image
                class="icon-loading-image"
                src="@/static/assets/image_loading.svg"
                alt=""
              />
              <!-- #endif -->
            </view>
            <!-- 图片 -->
            <image
              class="image"
              v-if="isImageFile(file)"
              :src="displayFileUrl(file)"
              mode="aspectFill"
              :alt="fileName(file).length > 0 ? fileName(file) : t('Mobile.Chat.uploadImageAlt')"
            />
            <!-- 文件 -->
            <template v-else>
              <image
                class="doc-image"
                :src="docImage"
                mode="aspectFill"
                :alt="t('Mobile.Chat.uploadFileAlt')"
              />
              <view class="doc-info-container">
                <text class="doc-name">{{ fileName(file) }}</text>
                <text class="doc-size">{{ formatFileSize(fileSize(file)) }}</text>
              </view>
            </template>
            <!-- 删除按钮 -->
            <view
              v-if="isFileUploading(file) == false"
              class="del-container"
              @click.stop="emitDel(file)"
            >
              <image
                src="@/static/assets/x-circle-fill.svg"
                mode="aspectFit"
                style="width: 40rpx; height: 40rpx"
                :alt="t('Mobile.Common.deleteIconAlt')"
              />
            </view>
          </view>
        </template>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts" setup>
  import { computed, getCurrentInstance, onMounted, ref, watch } from "vue";
  import docImage from "@/static/assets/doc_image.png";
  import { formatBytes } from "@/utils/byteConverter";
  import { UploadFileStatus } from "@/types/enums/common";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import { isUploadImageLike } from "../chatInputActions.uts";
  import { normalizePreviewImageUrl, previewImageCompat } from "@/utils/appWebViewImagePreview.uts";
  import { isAuthProtectedFileUrl, fetchAuthProtectedFileDisplayUrl } from "@/utils/authProtectedFileUrl.uts";
  // #ifdef APP
  import SpinLoading from "@/subpackages/components/spin-loading/spin-loading.uvue";
  // #endif

  const props = defineProps<{
    // Android 会将父组件 ref 数组元素包装为 UTSReactiveJSONObject。
    files: UTSJSONObject[];
    showAddButton?: boolean;
  }>();
  const resolvedProtectedImages = new Map<string, string>();
  const pendingProtectedImages = new Map<string, Promise<string>>();
  const protectedImageVersion = ref<number>(0);

  const emit = defineEmits<{
    (e: 'onAdd'): void;
    (e: 'onDel', uid: string): void;
  }>();
  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  // ===== 行宽实测写回（shared-home-tools 同款）=====
  // iOS/原生端 flex 行会被压成视口宽：scroll-view 看似开启却没有可滚动余量，
  // flex:none 的附件盒溢出行盒被容器裁掉（滚不动 + 末尾删除按钮被截的根因）。
  // 逐项实测总宽、超宽时显式写回行宽内联样式，制造滚动余量。
  const componentInstance = getCurrentInstance();
  /** 内容行显式宽度 px（0=未超宽，不写 width 走自然布局）。 */
  const filesRowWidthPx = ref<number>(0);

  const filesRowStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    if (filesRowWidthPx.value > 0) {
      style["width"] = `${filesRowWidthPx.value}px`;
    }
    return style;
  });

  function filesRpxToPx(rpx: number): number {
    const info = uni.getWindowInfo();
    const width = info.windowWidth != null ? info.windowWidth : 375;
    return (rpx * width) / 750;
  }

  /** 附件盒逐项实测（含 margin-right 10rpx），总宽超滚动视口才写回行宽。 */
  function measureFilesRow(attempt: number): void {
    if (componentInstance == null || componentInstance.proxy == null) return;
    uni.createSelectorQuery()
      .in(componentInstance.proxy)
      .select(".files-container")
      .boundingClientRect()
      .selectAll(".files-box")
      .boundingClientRect()
      .exec((results: Array<any>) => {
        const ready = results.length >= 2 && results[0] != null && results[1] != null && Array.isArray(results[1]);
        if (ready != true) {
          if (attempt < 2) setTimeout((): void => measureFilesRow(attempt + 1), 180);
          return;
        }
        const viewport = results[0] as NodeInfo;
        const boxes = results[1] as NodeInfo[];
        const viewportWidth = viewport.width != null ? parseFloat(`${viewport.width}`) : 0;
        let contentWidth = 0;
        for (let i = 0; i < boxes.length; i++) {
          const box = boxes[i];
          contentWidth += box.width != null ? parseFloat(`${box.width}`) : 0;
        }
        contentWidth += boxes.length * filesRpxToPx(10);
        filesRowWidthPx.value = contentWidth > viewportWidth + 1
          ? Math.ceil(contentWidth) + 2
          : 0;
      });
  }

  // 附件增删即重量（盒宽固定，状态变化不影响宽度）；挂载后首测覆盖进页已带附件
  watch((): number => props.files.length, (_count: number) => {
    setTimeout((): void => measureFilesRow(0), 120);
  });
  onMounted((): void => {
    setTimeout((): void => measureFilesRow(0), 120);
  });

  // 模板辅助：UTS 模板不能直接引用枚举类，且需规避 ?. / ! / ===
  const getFileType = (file: UTSJSONObject): string => {
    const value = file["type"] as string | null;
    return value != null ? value : "";
  };
  const fileUrl = (file: UTSJSONObject): string => {
    let value = file["url"] as string | null;
    if (value == null || `${value}`.length == 0) value = file["fileUrl"] as string | null;
    if (value == null || `${value}`.length == 0) value = file["path"] as string | null;
    return value != null ? `${value}` : "";
  };
  const resolveProtectedImage = (raw: string): Promise<string> => {
    const cached = resolvedProtectedImages.get(raw);
    if (cached != null && cached.length > 0) return Promise.resolve(cached);
    const pending = pendingProtectedImages.get(raw);
    if (pending != null) return pending;
    const request = fetchAuthProtectedFileDisplayUrl(raw);
    pendingProtectedImages.set(raw, request);
    request.then((resolved: string) => {
      pendingProtectedImages.delete(raw);
      if (resolved.length > 0) {
        resolvedProtectedImages.set(raw, resolved);
        protectedImageVersion.value = protectedImageVersion.value + 1;
      }
    }).catch((_error) => {
      pendingProtectedImages.delete(raw);
    });
    return request;
  };
  /** 本地临时路径保持原样；受保护地址异步下载成可预览的本地路径。 */
  const displayFileUrl = (file: UTSJSONObject): string => {
    const raw = fileUrl(file);
    if (
      raw.indexOf("_doc/") == 0 ||
      raw.indexOf("_www/") == 0 ||
      raw.indexOf("uniapp://") == 0
    ) {
      return raw;
    }
    // 读取版本号让异步 Bearer 下载完成后模板重新求值。
    const _version = protectedImageVersion.value;
    const cached = resolvedProtectedImages.get(raw);
    if (cached != null && cached.length > 0) return cached;
    if (raw.length > 0 && isAuthProtectedFileUrl(raw) == true) {
      // 图片加载与点击预览复用同一个请求；点击时可等待这个临时路径就绪。
      resolveProtectedImage(raw).catch((_error) => {});
      return "";
    }
    return normalizePreviewImageUrl(raw);
  };
  const fileName = (file: UTSJSONObject): string => {
    const value = file["name"] as string | null;
    return value != null ? value : "";
  };
  /** 列表 key：优先 uid（上传前后 url 会变，不能用 url 当 key） */
  const resolveUploadItemKey = (file: UTSJSONObject): string => {
    const value = file["uid"] as string | null;
    if (value != null && `${value}`.length > 0) {
      return `${value}`;
    }
    return fileUrl(file);
  };
  /** App chooseImage 常无 type，需用 name/url 扩展名兜底。 */
  const isImageFile = (file: UTSJSONObject): boolean => {
    return isUploadImageLike(getFileType(file), fileName(file), fileUrl(file));
  };
  const fileStatusText = (file: UTSJSONObject): string => {
    const value = file["status"];
    return value != null ? `${value}` : "";
  };
  const isFileError = (file: UTSJSONObject): boolean =>
    fileStatusText(file) == `${UploadFileStatus.error}`;
  const isFileUploading = (file: UTSJSONObject): boolean =>
    fileStatusText(file) == `${UploadFileStatus.uploading}`;

  // #ifndef APP
  const previewImages = computed((): string[] => {
    const urls: string[] = [];
    const list = props.files;
    for (let i = 0; i < list.length; i++) {
      const item = list[i] as UTSJSONObject;
      if (isImageFile(item) == true) {
        const url = displayFileUrl(item);
        if (url.length > 0) urls.push(url);
      }
    }
    return urls;
  });
  // #endif

  const fileSize = (file: UTSJSONObject): number => {
    const value = file["size"] as number | null;
    return value != null ? value : 0;
  };
  const emitDel = (file: UTSJSONObject): void => {
    const uid = file["uid"] as string | null;
    emit("onDel", uid != null ? uid : "");
  };
  const showAdd = computed((): boolean => props.showAddButton == true);
  const formatFileSize = (bytes: number): string => formatBytes(bytes);

  // 预览图片
  const onPreview = async (file: UTSJSONObject): Promise<void> => {
    if (isImageFile(file) == false) {
      uni.showToast({
        title: t("Mobile.Chat.previewTypeUnsupported"),
        icon: "none",
        duration: 1500,
      });
      return;
    }
    // #ifndef APP
    previewImageCompat(previewImages.value, displayFileUrl(file));
    return;
    // #endif
    // #ifdef APP
    const urls: string[] = [];
    const selectedRaw = fileUrl(file);
    let currentUrl = "";
    let loadingShown = false;
    const list = props.files;
    for (let i = 0; i < list.length; i++) {
      const item = list[i] as UTSJSONObject;
      if (isImageFile(item) == false) continue;
      const raw = fileUrl(item);
      if (raw.length == 0) continue;
      let resolved = "";
      if (isAuthProtectedFileUrl(raw) == true) {
        try {
          if (resolvedProtectedImages.has(raw) != true && loadingShown != true) {
            uni.showLoading({ title: "" });
            loadingShown = true;
          }
          resolved = await resolveProtectedImage(raw);
        } catch (_error) {
          if (raw == selectedRaw) {
            if (loadingShown == true) uni.hideLoading();
            uni.showToast({ title: t("Mobile.Intervention.McpAsk.previewImageFailed"), icon: "none" });
            return;
          }
          continue;
        }
      } else {
        resolved = normalizePreviewImageUrl(raw);
      }
      if (resolved.length == 0) continue;
      urls.push(resolved);
      if (raw == selectedRaw) currentUrl = resolved;
    }
    if (loadingShown == true) uni.hideLoading();
    if (currentUrl.length == 0) return;
    previewImageCompat(urls, currentUrl);
    // #endif
  };
</script>

<style lang="scss" scoped>
  /* 横滑结构对齐 shared-home-tools（本页内已验证配方）：普通 view 包 scroll-view，
     scroll 用 flex:1 + min-width:0（不用 width:100%/flex-direction:row），滚动余量由
     measureFilesRow 实测总宽写回行内联样式制造（flex 行会被原生端压成视口宽） */
  .files-wrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 132rpx;
  }

  .files-container {
    flex: 1;
    min-width: 0;
    height: 132rpx;
    /* #ifndef APP */
    scroll-behavior: smooth;
    /* #endif */
    /* #ifdef H5 || MP-WEIXIN */
    -webkit-overflow-scrolling: touch;
    /* #endif */
  }

  .files-scroll-content {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    height: 132rpx;
    /* #ifdef H5 */
    width: max-content;
    /* #endif */

    .files-box {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      flex: none;
      border-radius: 16rpx;
      margin-right: 10rpx;
      overflow: hidden;
      border: 2rpx solid transparent;

      &-loading {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 10;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        background: rgba(64, 62, 62, 0.15);

        .icon-loading-image {
          width: 48rpx;
          height: 48rpx;
          border-radius: 50%;
          /* #ifndef APP */
          animation: chat-upload-spin 1s linear infinite;
          /* #endif */
        }
      }

      &-plus {
        width: 128rpx;
        height: 128rpx;
        background: #f6f6f6;

        .iconfont {
          font-size: 48rpx;
          color: #888;
        }
      }

      &-image {
        width: 128rpx;
        height: 128rpx;
        background: #f6f6f6;
      }

      &-error {
        border-color: #f93920;
      }

      &-file {
        width: 400rpx;
        padding: 16rpx;
        background: rgba(12, 20, 102, 0.04);
        overflow: hidden;

        .doc-image {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 96rpx;
          height: 96rpx;
          margin-right: 8rpx;
        }

        .doc-info-container {
          flex: 1;
          min-width: 0;
          overflow: hidden;
          display: flex;
          flex-direction: column;
          font-weight: 400;

          .doc-name,
          .doc-size {
            width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            /* #ifdef APP */
            lines: 1;
            /* #endif */
          }

          .doc-name {
            font-size: 28rpx;
            color: #15171f;
            margin-bottom: 4rpx;
          }

          .doc-size {
            font-size: 24rpx;
            color: #828894;
          }
        }
      }

      .image {
        width: 100%;
        height: 100%;
      }

      .del-container {
        position: absolute;
        /* 内移避让 16rpx 圆角裁切（overflow:hidden 会削贴角的圆形图标），并按
           「往左、往下挪一点」落到明确离开角落的位置 */
        top: 16rpx;
        right: 16rpx;
        z-index: 10;
      }
    }
  }

  /* #ifndef APP */
  @keyframes chat-upload-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  /* #endif */
</style>
