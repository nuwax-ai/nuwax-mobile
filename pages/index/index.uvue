    flex: 1;
    font-size: 27rpx;
    line-height: 40rpx;
    color: #92929a;
    lines: 1;
  }

  .create-hub__bottom {
    /* 保持 auto，让输入区弹层在页面根层级参与比较。 */
    position: relative;
    flex-shrink: 0;
    overflow: visible;
  }

  .create-hub__bottom--keyboard-raised {
    // 键盘态下整组输入 UI 位于页面内容之上，避免工具栏/上传栏被原生 editor 热区盖住。
    z-index: 40;
  }

  .create-hub__bottom--quick-popup {
    // 仅 @ / 快捷弹层显示期间建立根级高层，避免被首页 scroll-view、工具行或分类层遮挡。
    z-index: 500;
  }

  /* ── 智能体工具独立区块（对齐 PC manualComponents）：收起=chip 滚动行；展开=灰色全宽面板 ── */
  .create-hub__tools {
    display: flex;
    flex-direction: column;
    padding: 8rpx 0 4rpx;
    /* Android 原生 editor 的内部触摸视图可能超出裁剪外壳；工具栏单独抬高，
       防止不可见的 editor 热区压住 checkbox。 */
    position: relative;
    z-index: 2;
  }

  .create-hub__tools-rowwrap {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 32rpx;
  }

  .create-hub__tools-scroll {
    flex: 1;
    min-width: 0;
  }

  .create-hub__tools-row {
    /* 横滑关键：flex nowrap 自然按内容撑宽（对齐 manual-component-bar 模式）；
       勿加 width: max-content —— iOS 原生端会塌缩成容器宽，导致无法滚动、无展开收起。
       行宽在溢出时由内联实测内容宽（px）显式指定。 */
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
  }

  /* 展开/收起切换：纯箭头图标（无底色），保证点击热区 */
  .create-hub__tool-toggle {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 56rpx;
    height: 52rpx;
    margin-left: 4rpx;
  }

  /* 展开态：灰色全宽贯穿；收起图标悬浮右上角（不占行） */
  .create-hub__tools-expanded {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: #f7f8fa;
  }

  .create-hub__tool-toggle--float {
    position: absolute;
    top: 4rpx;
    right: 24rpx;
    z-index: 2;
  }

  .create-hub__tool-chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: none;
    min-height: 64rpx;
    padding: 0 20rpx;
    margin-right: 12rpx;
    border-radius: 999rpx;
    background-color: #f3f4f6;
  }

  .create-hub__tool-chip--on {
    background-color: rgba(81, 71, 255, 0.1);
  }

  .create-hub__tool-check {
    width: 28rpx;
    height: 28rpx;
    margin-right: 10rpx;
    border-radius: 8rpx;
    border: 2rpx solid #c7c9d1;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .create-hub__tool-check--on {
    border-color: #5147ff;
    background-color: #5147ff;
  }

  .create-hub__tool-check-mark {
    width: 14rpx;
    height: 8rpx;
    border-left: 3rpx solid #ffffff;
    border-bottom: 3rpx solid #ffffff;
    transform: rotate(-45deg);
    margin-top: -4rpx;
  }

  .create-hub__tool-chip-text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #44444c;
    lines: 1;
  }

  .create-hub__tool-chip--on .create-hub__tool-chip-text {
    color: #5147ff;
  }

  .create-hub__tools-panel {
    /* 展开态主体：灰底在 expanded 容器上全宽贯穿，此处仅限高滚动 */
    max-height: 360rpx;
  }

  .create-hub__tools-panel-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    /* 右侧留白避让悬浮的收起图标 */
    padding: 12rpx 88rpx 16rpx 32rpx;
  }

  .create-hub__tools-panel-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 60rpx;
    padding: 0 24rpx;
    margin: 8rpx 12rpx 0 0;
    border-radius: 999rpx;
    background-color: #ffffff;
  }

  .create-hub__tools-panel-item-text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #44444c;
    lines: 1;
  }

  .create-hub__tools-panel-item--on .create-hub__tools-panel-item-text {
    color: #5147ff;
  }

  /* Android / 鸿蒙离线包预热容器：1px 隐藏 + 裁剪，仅为触发 WebView 的 JS 编译缓存；
     内部组件根节点自带 100% 尺寸，宿主必须显式限位防其撑满全屏吞掉点击 */
  .offline-warmup-host {
    position: fixed;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
  }

  /* #ifdef APP-IOS */
  .resident-chat-opening-cover {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    /* 必须高于 resident-chat-shell(10000)，否则换会话时仍会透出上一会话 */
    z-index: 10001;
  }
  /* #endif */
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }
  /* #endif */
  /* #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || MP-LARK || MP-KUAISHOU || MP-JD */
  page {
    height: 100%;
  }
  /* #endif */
</style>
