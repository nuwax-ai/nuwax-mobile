<template>
  <voip-call-screen :shown="pageShown" />
</template>
<script setup lang="uts">
  import { ref } from "vue";
  import VoipCallScreen from "@/features/voip/screens/call.uvue";
  // #ifdef APP-ANDROID
  import { watch } from "vue";
  import { getVoipSnapshot, setVoipCallPageVisible, voipRevision } from "@/features/voip/callManager";

  // #endif
  const pageShown = ref(false);

  // #ifdef APP-ANDROID
  let visibleCallId = "";
  function syncCallPageVisibility(): void {
    const callId = pageShown.value ? (getVoipSnapshot()?.callId ?? "") : "";
    if (visibleCallId == callId) return;
    if (visibleCallId.length > 0) setVoipCallPageVisible(visibleCallId, false);
    visibleCallId = callId;
    if (callId.length > 0) setVoipCallPageVisible(callId, true);
  }
  watch(voipRevision, (): void => { syncCallPageVisibility(); });
  // #endif

  function updatePageShown(shown: boolean): void {
    pageShown.value = shown;
    // #ifdef APP-ANDROID
    syncCallPageVisibility();
    // #endif
  }
  function hideCallPage(): void { updatePageShown(false); }
  onShow((): void => { updatePageShown(true); });
  onHide(hideCallPage);
  onUnload(hideCallPage);
</script>
