<template>
  <view class="chat-message-editor">
    <editor
      ref="editorRef"
      id="chat-message-editor-input"
      class="chat-message-editor__input"
      :type="null"
      :read-only="readonly"
      :placeholder="placeholder"
      @ready="handleReady"
      @input="handleInput"
      @focus="handleFocus"
      @blur="handleBlur"
    />
  </view>
</template>

<script setup lang="uts">
  import { getCurrentInstance, nextTick, onUnmounted, ref, watch } from "vue";

  const props = withDefaults(
    defineProps<{
      modelValue?: string;
      placeholder?: string;
      readonly?: boolean;
      focusRequest?: boolean;
    }>(),
    {
      modelValue: "",
      placeholder: "",
      readonly: false,
      focusRequest: false,
    },
  );

  const emit = defineEmits<{
    (e: "update:modelValue", value: string): void;
    (e: "focus"): void;
    (e: "blur"): void;
    (e: "input"): void;
  }>();

  const componentInstance = getCurrentInstance();
  const editorRef = ref<UniEditorElement | null>(null);
  let editorContext: EditorContext | null = null;
  let editorReady = false;
  let syncingContent = false;
  let localText = "";
  let styleRetryTimer = 0;

  function resolveEditorElement(): UniEditorElement | null {
    const current = editorRef.value;
    if (current != null) return current;
    const element = uni.getElementById("chat-message-editor-input");
    return element != null ? element as UniEditorElement : null;
  }

  function focusEditor(): void {
    const editor = resolveEditorElement();
    if (editor != null) editor.focus();
  }

  function editorText(event: UniEditorInputEvent): string {
    let text = event.detail.text != null ? `${event.detail.text}` : "";
    if (text.endsWith("\n")) text = text.substring(0, text.length - 1);
    return text;
  }

  function setPlainText(text: string): void {
    if (editorContext == null || editorReady != true) return;
    const insert = new UTSJSONObject();
    insert["insert"] = text.length > 0 ? `${text}\n` : "\n";
    const ops: UTSJSONObject[] = [];
    ops.push(insert);
    const delta = new UTSJSONObject();
    delta["ops"] = ops;
    syncingContent = true;
    editorContext!.setContents({
      delta,
      complete: (_res: any): void => {
        syncingContent = false;
        localText = text;
      },
    });
  }

  function injectEditorStyle(attempt: number): void {
    const editor = resolveEditorElement();
    const web = editor != null ? editor.querySelector("web-view") : null;
    if (web != null) {
      (web as UniWebViewElement).evalJS("(function install(attempt){var root=document.querySelector('.ql-container'),input=document.querySelector('.ql-editor');if(!document.head||!root||!input){if((attempt||0)<20)setTimeout(function(){install((attempt||0)+1)},50);return;}var id='nuwax-im-chat-editor-style',style=document.getElementById(id);if(!style){style=document.createElement('style');style.id=id;document.head.appendChild(style)}style.textContent='html,body{height:100%!important;overflow:hidden!important}.ql-container{height:100%!important;min-height:0!important;max-height:100%!important;overflow:hidden!important;border:0!important}.ql-editor{height:100%!important;min-height:0!important;max-height:100%!important;box-sizing:border-box!important;overflow-y:auto!important;padding:7px 4px 7px 14px!important;font-size:16px!important;line-height:22px!important;font-weight:400!important;font-family:sans-serif!important;color:#17171a!important;-webkit-text-size-adjust:100%}.ql-editor.ql-blank::before{left:14px!important;right:4px!important;top:7px!important;font-style:normal!important;font-weight:400!important;color:#b6b5c1!important;font-size:16px!important;line-height:22px!important}.ql-editor::-webkit-scrollbar{display:block!important;width:3px!important}.ql-editor::-webkit-scrollbar-track{background:transparent!important}.ql-editor::-webkit-scrollbar-thumb{background:#c9c7d6!important;border-radius:2px!important}';input.style.setProperty('overflow-y','auto','important');})();");
      return;
    }
    if (attempt < 10) {
      styleRetryTimer = setTimeout((): void => {
        styleRetryTimer = 0;
        injectEditorStyle(attempt + 1);
      }, 120) as number;
    }
  }

  function handleReady(): void {
    if (componentInstance == null || componentInstance.proxy == null) return;
    uni.createEditorContextAsync({
      id: "chat-message-editor-input",
      component: componentInstance.proxy,
      success: (context: EditorContext): void => {
        editorContext = context;
        editorReady = true;
        localText = props.modelValue;
        setPlainText(props.modelValue);
        injectEditorStyle(0);
        if (props.focusRequest) nextTick((): void => focusEditor());
      },
      fail: (_error: UniError): void => {},
    });
  }

  function handleInput(event: UniEditorInputEvent): void {
    const text = editorText(event);
    localText = text;
    if (syncingContent) return;
    if (text != props.modelValue) emit("update:modelValue", text);
    emit("input");
  }

  function handleFocus(): void {
    emit("focus");
  }

  function handleBlur(): void {
    emit("blur");
  }

  watch((): string => props.modelValue, (value: string): void => {
    if (value == localText) return;
    localText = value;
    setPlainText(value);
  });

  watch((): boolean => props.focusRequest, (focus: boolean): void => {
    if (focus != true || editorReady != true) return;
    nextTick((): void => focusEditor());
  });

  onUnmounted((): void => {
    if (styleRetryTimer != 0) {
      clearTimeout(styleRetryTimer);
      styleRetryTimer = 0;
    }
    editorContext = null;
    editorReady = false;
  });

  defineExpose({
    focus: (): void => focusEditor(),
  });
</script>

<style lang="scss" scoped>
  .chat-message-editor {
    position: relative;
    width: 100%;
    min-width: 0;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
  }

  .chat-message-editor__input {
    width: 100%;
    height: 100%;
    min-height: 0px;
    max-height: 100%;
    background-color: rgba(0, 0, 0, 0);
  }
</style>
