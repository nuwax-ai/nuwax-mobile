<template>
  <!--
    名片二维码弹窗（群设置页 / 我的页共用）：
    - open(title, subtitle, qrContent, tip)：qrContent 为空或编码超限 → 失败态
      （不弹错误流，占位提示即可，与 buildXxxCardUrl 空 host 返回空串对称）
    - 二维码本地生成（utils/qrcode：encodeQr + qrPngDataUrl，纯 UTS 无网络依赖），
      setTimeout(0) 让 loading 态先渲染一帧再同步计算
    - 点图 previewImageCompat 全屏放大（data: 前缀按绝对地址透传，见 appWebViewImagePreview）
  -->
  <uni-modal-popup
    ref="modalRef"
    :title="popupTitle"
    position="center"
    width="640rpx"
    :enable-swipe-close="false"
    :body-scroll="false"
  >
    <view class="qr-card">
      <text class="qr-card__subtitle">{{ subtitle }}</text>

      <view v-if="state == 'loading'" class="qr-card__box">
        <text class="qr-card__loading">{{ t("Mobile.Common.loading") }}</text>
      </view>
      <view v-else-if="state == 'failed'" class="qr-card__box">
        <text class="qr-card__failed">{{ t("Mobile.Qr.generateFailed") }}</text>
      </view>
      <image
        v-else
        class="qr-card__image"
        :src="dataUrl"
        mode="aspectFit"
        :fade-show="false"
        @click="previewQr"
      />

      <text class="qr-card__tip">{{ tip }}</text>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  import { encodeQr } from "@/utils/qrcode/qrcodeEncoder";
  import { qrPngDataUrl } from "@/utils/qrcode/qrPng";
  import { previewImageCompat } from "@/utils/appWebViewImagePreview";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const modalRef = ref<any | null>(null);
  const popupTitle = ref<string>("");
  const subtitle = ref<string>("");
  const tip = ref<string>("");
  /** loading | failed | done（纯字符串，避免枚举串化平台分歧） */
  const state = ref<string>("loading");
  const dataUrl = ref<string>("");

  // Android：Gen* 组件禁止 as UTSJSONObject，用 $callMethod
  function callRefMethod(methodName: string): void {
    const inst = modalRef.value;
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  /**
   * 打开名片码弹窗并异步生成二维码。
   * qrContent 为空（如服务域名未配置时 build 返回空串）→ 直接失败态。
   */
  function open(title: string, subtitleText: string, qrContent: string, tipText: string): void {
    popupTitle.value = title;
    subtitle.value = subtitleText;
    tip.value = tipText;
    dataUrl.value = "";
    callRefMethod("open");
    if (qrContent.length == 0) {
      state.value = "failed";
      return;
    }
    state.value = "loading";
    // 同步计算放在下一帧：先让 loading 态渲染（名片码 v4~v5 毫秒级，仅为交互确定性）
    setTimeout(() => {
      const res = encodeQr(qrContent);
      if (res == null) {
        state.value = "failed";
        return;
      }
      dataUrl.value = qrPngDataUrl(res, 12, 2);
      state.value = "done";
    }, 0);
  }

  /** 点图全屏放大（复用 H5 遮罩 / App 官方预览的兼容层）。 */
  function previewQr(): void {
    if (state.value != "done" || dataUrl.value.length == 0) {
      return;
    }
    previewImageCompat([dataUrl.value], dataUrl.value);
  }

  defineExpose({
    open: open as any,
  });
</script>

<style lang="scss" scoped>
  .qr-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16rpx 40rpx 44rpx;
  }

  .qr-card__subtitle {
    font-size: 26rpx;
    color: #666666;
    line-height: 38rpx;
    text-align: center;
    word-break: break-all;
  }

  /* loading / 失败占位：与二维码同尺寸，避免状态切换时弹窗高度跳动 */
  .qr-card__box {
    width: 440rpx;
    height: 440rpx;
    margin-top: 24rpx;
    border-radius: 16rpx;
    background-color: #f6f5f8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qr-card__loading {
    font-size: 26rpx;
    color: #9a9aa2;
  }

  .qr-card__failed {
    font-size: 26rpx;
    color: #9a9aa2;
    text-align: center;
    padding: 0 24rpx;
  }

  .qr-card__image {
    width: 440rpx;
    height: 440rpx;
    margin-top: 24rpx;
    border-radius: 16rpx;
    background-color: #ffffff;
  }

  .qr-card__tip {
    margin-top: 24rpx;
    font-size: 24rpx;
    color: #9a9aa2;
    line-height: 34rpx;
    text-align: center;
  }
</style>
