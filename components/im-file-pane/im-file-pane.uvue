<template>
  <scroll-view
    class="ifp-scroll"
    direction="vertical"
    :show-scrollbar="false"
    @scrolltolower="emitLoadOlder"
  >
    <!-- ★padding 放内层容器：iOS 上 scroll-view 的水平 padding 不参与子元素宽度计算，
         文件行会伸进右侧 padding 区被裁掉右边框（Android 正常，iOS 兼容问题） -->
    <view class="ifp-list">
      <!-- 首屏态（列表还空着）：加载中 / 失败重试 / 续拉保险丝触顶 / 空态。
           加载与错误互斥呈现（页面侧 catch 置 error，同帧 loading 落 false）。 -->
      <view v-if="files.length == 0 && loading" class="ifp-state">
        <text class="ifp-state__text">{{ t("Mobile.Message.filesLoadingFirst") }}</text>
      </view>
      <view
        v-else-if="files.length == 0 && error"
        class="ifp-state"
        @click="emitLoadOlder"
      >
        <text class="ifp-state__text">{{ t("Mobile.Message.loadFailed") }}</text>
      </view>
      <view
        v-else-if="files.length == 0 && autoStopped"
        class="ifp-state"
        @click="emitLoadOlder"
      >
        <text class="ifp-state__text">{{ t("Mobile.Message.filesAutoStopped") }}</text>
      </view>
      <view v-else-if="files.length == 0" class="ifp-state">
        <text class="ifp-state__text">{{ t("Mobile.Message.filesEmpty") }}</text>
      </view>
      <template v-else>
      <view
        v-for="f in files"
        :key="f.key"
        class="ifp-row"
        hover-class="ifp-row--active"
        @click="emitRowTap(f)"
      >
        <view class="ifp-icon" :class="f.kind == 'video' ? 'ifp-icon--video' : ''">
          <!-- 缩略图槽位抽独立组件（im-file-thumb）：解析中三点 loading、完成直显、
               失败回落文件图标，状态全部组件内自驱动（行内绑定不穿透数组元素
               属性的 Android 坑，抽组件后页级 tick 不再需要）；解析结果上抛存 Map
               供点行放大预览复用 -->
          <im-file-thumb v-if="f.kind == 'image'" :url="f.url" @resolved="onThumbResolved" />
          <!-- 视频行：深色块 + 白色播放键（icon-video-play 本是白图，专为深底设计，
               聊天页视频海报同款；浅底上不可见，勿单独放浅色槽） -->
          <image
            v-else-if="f.kind == 'video'"
            class="ifp-icon__play"
            src="/static/images/icon-video-play.png"
            mode="aspectFit"
          />
          <!-- 音频行：喇叭线稿（icon-voice，语音输入同字形） -->
          <svg-icon
            v-else-if="f.kind == 'audio'"
            name="icon-voice"
            size="20"
            unit="px"
            color="#5147ff"
          />
          <!-- 文档行：微信式类型纸面（PDF 红/DOC 蓝/XLS 绿/PPT 橙/ZIP 琥珀/TXT 灰蓝，
               认不出后缀给「?」问号纸面）——im-file-detail/引用详情同款组件 -->
          <file-type-icon
            v-else
            :file-name="f.fileName"
            :url="f.url"
            :size="24"
            unit="px"
          />
        </view>
        <view class="ifp-col">
          <!-- 标题最多两行（text-ellipsis-2：App 端 lines:2 / H5 端 line-clamp:2） -->
          <text class="ifp-name text-ellipsis-2">{{ f.fileName.length > 0 ? f.fileName : f.url }}</text>
          <!-- 次行拆两段：左「发送人 · 大小」可省略，右时间 flex-shrink:0 恒完整
               （合并单条时长发送人名会把时间挤进省略号里看不全） -->
          <view class="ifp-meta">
            <text class="ifp-meta__sub text-ellipsis">{{ f.subText }}</text>
            <text v-if="f.timeText.length > 0" class="ifp-meta__time">{{ f.timeText }}</text>
          </view>
        </view>
        <!-- 预览按钮（仅网关支持的类型显示）：受保护地址先换 ak 匿名直链，再进站内
             webview 打开平台预览网关页（对齐 Web 端开新窗预览），动作上抛页面处理 -->
        <view
          v-if="canPreview(f.url)"
          class="ifp-pv"
          hover-class="ifp-pv--active"
          @click.stop="emitPreview(f)"
        >
          <text class="ifp-pv__text">{{ t("Mobile.Message.filesPreview") }}</text>
        </view>
        <view class="ifp-dl" hover-class="ifp-dl--active" @click.stop="emitDownload(f)">
          <text class="ifp-dl__text">{{ t("Mobile.Terminal.download") }}</text>
        </view>
      </view>
      <!-- 底部状态行（列表非空时）：错误 > 加载中 > 保险丝 > 没有更多。
           错误/保险丝整条可点（= 重试 / 继续查找），门控在页面侧。 -->
      <view
        v-if="!loading && error"
        class="ifp-foot"
        hover-class="ifp-foot--active"
        @click="emitLoadOlder"
      >
        <text class="ifp-foot__text">{{ t("Mobile.Message.filesLoadOlderFailed") }}</text>
      </view>
      <view v-else-if="loading" class="ifp-foot">
        <text class="ifp-foot__text">{{ t("Mobile.Message.filesLoadingMore") }}</text>
      </view>
      <view
        v-else-if="autoStopped"
        class="ifp-foot"
        hover-class="ifp-foot--active"
        @click="emitLoadOlder"
      >
        <text class="ifp-foot__text">{{ t("Mobile.Message.filesAutoStopped") }}</text>
      </view>
      <view v-else-if="!hasMore" class="ifp-foot">
        <text class="ifp-foot__text">{{ t("Mobile.Message.noMore") }}</text>
      </view>
      </template>
      <view class="ifp-tail" />
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { GfFile, gfCanPreviewUrl } from "./gf-models.uts";

  /**
   * 文件页单个 tab 的列表面（文件行 + 空态，纵向滚动）。
   * ★抽组件的意义：tab 切换/横滑提交 activeKind 时页面根重渲只 diff 到本组件的
   * props（files 不变即整体跳过），行级 v-for 不再跟着页头重渲全量重执行——
   * 伙伴页横滑卡顿的教训（pane 内联数百行在切页动画窗内重跑冻住动画）。
   * 行动作与翻页触发全部上抛页面处理（页面持有导航/下载/预览/分页链路），
   * 本组件无状态。
   */
  defineProps<{
    /** 本 tab 的文件列表（页面按 kind 分好组传入，新→旧）。 */
    files: GfFile[];
    /** 是否有请求在途（首屏/续拉共用；首屏与「加载更早」由 files 是否为空区分）。 */
    loading: boolean;
    /** 最近一次请求失败（列表空=首屏失败，非空=翻更早失败；点击行=重试）。 */
    error: boolean;
    /** 游标之前还有更早的（false 且非空时底部给「没有更多」）。 */
    hasMore: boolean;
    /** 空页续拉保险丝触顶（页数上限打满仍 hasMore）：给「继续查找」入口。 */
    autoStopped: boolean;
  }>();

  const emit = defineEmits<{
    (e: "rowtap", f: GfFile): void;
    (e: "preview", f: GfFile): void;
    (e: "download", f: GfFile): void;
    (e: "loadolder"): void;
    (e: "resolved", url: string, src: string): void;
  }>();

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 预览按钮显隐（gf-models 共享口径）。★模板直调 import 函数会 error18
   *  （invoke 找不到，模板只认组件实例成员），须本地函数中转。 */
  function canPreview(url: string): boolean {
    return gfCanPreviewUrl(url);
  }

  /** 滚到底部（scrolltolower）：首屏失败重试 / 翻更早 / 保险丝续找统一入口，
   *  门控全在页面侧（inflight / hasMore / cursor）。 */
  function emitLoadOlder(): void {
    emit("loadolder");
  }

  function emitRowTap(f: GfFile): void {
    emit("rowtap", f);
  }

  function emitPreview(f: GfFile): void {
    emit("preview", f);
  }

  function emitDownload(f: GfFile): void {
    emit("download", f);
  }

  /** 缩略图组件的解析结果继续上抛（页面存 Map 供点行放大预览复用）。 */
  function onThumbResolved(url: string, src: string): void {
    emit("resolved", url, src);
  }
</script>

<style lang="scss" scoped>
  .ifp-scroll {
    height: 100%;
  }

  /* 内层容器承担左右留白（勿挪回 .ifp-scroll：iOS 上 scroll-view 的水平 padding
     不参与子元素宽度计算，文件行右边框会被裁） */
  .ifp-list {
    padding: 8px 16px;
  }

  .ifp-state {
    padding: 100px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ifp-state__text {
    font-size: 14px;
    line-height: 20px;
    color: #9a98a5;
  }

  /* ===== 底部状态行（加载中 / 失败重试 / 继续查找 / 没有更多） ===== */
  .ifp-foot {
    padding: 4px 4px 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  .ifp-foot--active {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .ifp-foot__text {
    font-size: 12px;
    line-height: 18px;
    color: #9a98a5;
    text-align: center;
  }

  /* ===== 文件行 ===== */
  .ifp-row {
    margin-bottom: 8px;
    padding: 10px 12px;
    background-color: #ffffff;
    border: 1px solid #ecebf1;
    border-radius: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .ifp-row--active {
    background-color: #f7f6fb;
  }

  .ifp-icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background-color: rgba(81, 71, 255, 0.08);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  /* 视频行深色块（白色播放键的底，色值对齐次行主文案 #22212a） */
  .ifp-icon--video {
    background-color: #22212a;
  }

  .ifp-icon__play {
    width: 18px;
    height: 18px;
  }

  .ifp-col {
    flex: 1;
    min-width: 0;
    margin-left: 10px;
    margin-right: 4px;
    display: flex;
    flex-direction: column;
  }

  .ifp-name {
    font-size: 14px;
    line-height: 20px;
    color: #22212a;
  }

  /* 次行：左段可缩（省略号）右段时间不缩（恒完整） */
  .ifp-meta {
    margin-top: 2px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .ifp-meta__sub {
    flex: 1;
    min-width: 0;
    font-size: 11px;
    line-height: 16px;
    color: #9a98a5;
  }

  .ifp-meta__time {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 11px;
    line-height: 16px;
    color: #9a98a5;
  }

  /* ===== 预览按钮（描边款，与填充款下载按钮并排区分） ===== */
  .ifp-pv {
    flex-shrink: 0;
    margin-right: 8px;
    padding: 5px 12px;
    border-radius: 15px;
    background-color: #ffffff;
    border: 1px solid rgba(81, 71, 255, 0.4);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .ifp-pv--active {
    background-color: rgba(81, 71, 255, 0.08);
  }

  .ifp-pv__text {
    font-size: 12px;
    line-height: 17px;
    font-weight: 600;
    color: #5147ff;
  }

  /* ===== 下载按钮 ===== */
  .ifp-dl {
    flex-shrink: 0;
    padding: 6px 13px;
    border-radius: 15px;
    background-color: rgba(81, 71, 255, 0.1);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .ifp-dl--active {
    background-color: rgba(81, 71, 255, 0.2);
  }

  .ifp-dl__text {
    font-size: 12px;
    line-height: 17px;
    font-weight: 600;
    color: #5147ff;
  }

  .ifp-tail {
    height: 20px;
  }
</style>
