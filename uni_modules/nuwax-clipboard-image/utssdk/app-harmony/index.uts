// nuwax-clipboard-image · app-harmony
//
// 聊天页「粘贴剪贴板图片」的鸿蒙实现。★权限现状（2026-10 调研）：
// ohos.permission.READ_PASTEBOARD 为受限开放权限（system_basic + user_grant + ACL 使能），
// 当前政策下手机端三方应用不可申请（仅 PC/2in1 或使用系统 PasteButton 粘贴控件的场景可批），
// 故默认不在 module.json5 声明（声明了还会因 ACL 不在 profile 导致打基座/签名失败）。
// 未授权时 getData() 报 201：探测按「无图」降级（提示条不出现）、读取回 PERM，纯文本粘贴不受影响。
import { pasteboard, BusinessError } from '@kit.BasicServicesKit';
import { image } from '@kit.ImageKit';
// @kit.CoreFileKit 不导出 fs（ArkTS 编译报 10505001）；官方 runtime 同款默认导入
import fs from '@ohos.file.fs';
import type {
  ClipboardImageFailureCallback,
  ClipboardImageSuccessCallback,
  ClipboardProbeCallback,
} from '../interface.uts';

/** 探测剪贴板是否含图片（fingerprint 恒空串：鸿蒙拿不到廉价指纹，上层不去重）。 */
export function probeClipboardImage(onResult: ClipboardProbeCallback): void {
  try {
    pasteboard.getSystemPasteboard().getData()
      .then((data: pasteboard.PasteData) => {
        onResult(data.hasMimeType(pasteboard.MIMETYPE_PIXELMAP), '');
      })
      .catch((_e: BusinessError) => {
        // 201=READ_PASTEBOARD 未授权（常态），其余读取失败同口径：按无图降级不弹提示
        onResult(false, '');
      });
  } catch (_e) {
    onResult(false, '');
  }
}

/** 读取剪贴板 PixelMap → ImagePacker 转 JPEG → fs 写 cacheDir，回传绝对路径。 */
export function readClipboardImageFile(
  success: ClipboardImageSuccessCallback,
  fail: ClipboardImageFailureCallback,
): void {
  try {
    pasteboard.getSystemPasteboard().getData()
      .then((data: pasteboard.PasteData) => {
        // getPrimary() 已废弃且本 SDK 无此方法（ArkTS 10505001），getPrimaryPixelMap 直接取图
        const pixelMap = data.getPrimaryPixelMap();
        if (pixelMap == null) {
          fail('EMPTY', 'clipboard has no image');
          return;
        }
        const cacheDir = UTSHarmony.getUIAbilityContext().cacheDir;
        const filePath = `${cacheDir}/clipboard_${Date.now()}.jpg`;
        const packer = image.createImagePacker();
        const option: image.PackingOption = { format: 'image/jpeg', quality: 92 };
        packer.packToData(pixelMap, option)
          .then((buffer: ArrayBuffer) => {
            packer.release();
            const file = fs.openSync(filePath, fs.OpenMode.READ_WRITE | fs.OpenMode.CREATE | fs.OpenMode.TRUNC);
            try {
              fs.writeSync(file.fd, buffer);
            } finally {
              fs.closeSync(file);
            }
            success(filePath);
          })
          .catch((e: BusinessError) => {
            packer.release();
            fail('WRITE', `packToData failed: ${e.code}`);
          });
      })
      .catch((e: BusinessError) => {
        if (e.code == 201) {
          fail('PERM', 'READ_PASTEBOARD not granted');
        } else {
          fail('READ', `getData failed: ${e.code}`);
        }
      });
  } catch (e) {
    fail('READ', `${e}`);
  }
}
