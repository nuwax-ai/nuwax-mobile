/**
 * 消息长按操作项（msg-action-sheet 底部操作弹窗的一行）。
 *
 * chat.uvue 按消息状态与用户角色（buildActionsFor）计算列表传入，
 * 组件只负责渲染与上抛 select——显隐规则全部收敛在页面侧。
 *
 * UTS: 使用 class，interface 对象字面量初始化会报 UTS110111163（同 chatSubpageTab 约定）。
 */
export class MsgActionItem {
  /** 操作标识："quote" 引用 / "pin"|"unpin" 置顶/取消置顶 / "edit" 编辑 / "revoke" 撤回。 */
  key: string = "";
  /** 展示文案（调用方走 i18n 取好再传入）。 */
  label: string = "";
  /** 图标地址（/static/images/...，iconfont 无 Pin/撤回/引用字形，统一走 PNG）。 */
  icon: string = "";
  /** 破坏性操作（撤回）：文案与图标红色（#e05f5f，与左滑删除按钮同色系）。 */
  danger: boolean = false;
}
