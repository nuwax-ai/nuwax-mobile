<template>
  <uni-modal-popup
    ref="modalRef"
    :title="expertName.length > 0 ? '' : modalTitle"
    :width="expertName.length > 0 ? '100%' : '90%'"
    :height="expertName.length > 0 ? expertDrawerHeightPx + 'px' : '80%'"
    :position="expertName.length > 0 ? 'bottom' : 'center'"
    :z-index="expertName.length > 0 ? 3100 : 999"
    :show-header="expertName.length == 0"
    :enable-swipe-close="false"
    :body-scroll="expertName.length > 0"
    @update-visible="handleUpdateVisible"
  >
    <view class="agent-sub-container" :class="expertName.length > 0 ? 'agent-sub-container--expert' : ''">
      <view v-if="expertName.length > 0" class="expert-summary">
        <view class="expert-summary-head">
          <agent-icon :icon="expertIcon" :alt="expertName" :size="80" :margin-right="0" />
          <view class="expert-summary-heading">
            <text class="expert-summary-name">{{ expertName }}</text>
            <text v-if="expertUserCount > 0" class="expert-summary-count">{{ expertUserCount }} {{ t("Mobile.ExpertList.users") }}</text>
          </view>
          <view class="expert-summary-close" @tap="close">
            <view class="expert-summary-close-line expert-summary-close-line--left" />
            <view class="expert-summary-close-line expert-summary-close-line--right" />
          </view>
        </view>
        <view class="expert-summon-button" @tap="handleExpertSummon">
          <text class="expert-summon-label">{{ expertSummonLabel }}</text>
        </view>
        <text v-if="expertDescription.length > 0" class="expert-summary-description" :lines="3">{{ expertDescription }}</text>
        <view class="expert-summary-divider" />
        <view class="expert-plan-heading">
          <text class="expert-plan-title">{{ t("Mobile.ExpertList.selectPlan") }}</text>
          <text v-if="detailTrialCount > 0" class="expert-plan-trial">{{ t("Mobile.ExpertList.trialCount") }} {{ detailCalledTrialCount }}/{{ detailTrialCount }}</text>
        </view>
      </view>
      <!-- 骨架屏 / 加载状态 -->
      <view v-if="loading" class="loading-state">
        <text class="loading-icon">⏳</text>
        <text class="loading-text">{{ t("Mobile.Common.loading") }}</text>
      </view>

      <!-- 空状态 -->
      <view v-else-if="plans.length == 0" class="empty-state">
        <text class="empty-icon">📁</text>
        <text class="empty-text">{{ t("Mobile.MySubscriptions.empty") }}</text>
      </view>

      <!-- 套餐卡片列表 -->
      <scroll-view
        v-else
        class="plans-scroll"
        :style="expertName.length > 0 ? 'height:' + expertPlansHeightPx + 'px;' : ''"
        :scroll-y="expertName.length == 0"
        :scroll-x="expertName.length > 0"
        :show-scrollbar="false"
      >
        <view class="plans-list" :style="plansRowStyle">
          <view
            v-for="plan in plans"
            :key="plan.id"
            class="plan-card"
            :style="expertName.length > 0 ? 'width:' + expertCardWidthPx + 'px;' : ''"
            :class="{
              'plan-current': expertName.length == 0 && plan.id == activePlanId,
              'plan-expired':
                expertName.length == 0 &&
                plan.id == activePlanId &&
                isCurrentExpired,
              'plan-cancelled':
                expertName.length == 0 &&
                plan.id == activePlanId &&
                isCurrentCancelled,
            }"
          >
            <!-- 热门标签 / 订阅状态标签 -->
            <view
              class="card-badge-row"
              v-if="expertName.length == 0 && (plan.id == activePlanId || plan.isHot)"
            >
              <view
                v-if="plan.id == activePlanId"
                class="badge"
                :class="{
                  'badge-active':
                    currentSubscription == null ||
                    currentSubscription.status == 'ACTIVE',
                  'badge-expired':
                    currentSubscription != null &&
                    currentSubscription.status == 'EXPIRED',
                  'badge-cancelled':
                    currentSubscription != null &&
                    currentSubscription.status == 'CANCELLED',
                }"
              >
                <text class="badge-text">{{
                  currentSubscription != null &&
                  plan.id == currentSubscription.planId
                    ? getSubscriptionStatusText(currentSubscription.status)
                    : t("Mobile.MySubscriptions.currentPlan")
                }}</text>
              </view>
              <view v-else-if="plan.isHot" class="badge badge-hot">
                <text class="badge-text">{{
                  t("Mobile.MySubscriptions.statusHot")
                }}</text>
              </view>
            </view>

            <!-- 计划核心信息 -->
            <view class="card-main">
              <view class="plan-info-header">
                <text class="plan-name">{{ plan.name }}</text>
                <text class="plan-desc" v-if="plan.description != null && plan.description.length > 0">{{
                  plan.description
                }}</text>
              </view>

              <!-- 价格与计费周期 -->
              <view class="plan-price-box">
                <text class="price-symbol">¥</text>
                <text class="price-value">{{
                  formatNumberLocal(plan.price, 2)
                }}</text>
                <text class="price-period">{{
                  getPeriodUnitLocal(plan.period)
                }}</text>
              </view>

              <!-- 操作按钮 -->
              <view class="card-action">
                <view
                  class="action-btn"
                  :class="{
                    'btn-current':
                      expertName.length == 0 &&
                      !iosEmbeddedH5PayDisabled &&
                      plan.id == activePlanId &&
                      !isCurrentCancelled,
                    'btn-processing': processingId == plan.id,
                    'btn-disabled':
                      iosEmbeddedH5PayDisabled || plan.price <= 0,
                  }"
                  @tap="handleSelectPlan(plan)"
                >
                  <text class="btn-text">{{ getActionText(plan) }}</text>
                </view>
              </view>

              <!-- 权益清单 -->
              <view class="plan-limits">
                <view class="limit-item" v-if="plan.callLimitCount != null">
                  <text class="limit-bullet">✦</text>
                  <text class="limit-label"
                    >{{ t("Mobile.Chat.callLimitLabel") }}：</text
                  >
                  <text class="limit-val">{{
                    plan.callLimitCount == -1
                      ? t("Mobile.Chat.unlimited")
                      : plan.callLimitCount + t("Mobile.Chat.timesPerMonth")
                  }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, computed, nextTick, watch, getCurrentInstance, type ComponentPublicInstance } from "vue";
  import { useI18n, toI18nParams, emptyI18nParams } from "@/utils/i18n";
  import {
    apiGetAgentSubscriptionPlanList,
    apiGetMySubscription,
    apiQueryToolPricing,
  } from "@/subpackages/servers/subscription";
  import { formatNumber } from "@/utils/system";
  import { toStringRecord, toAnyRecord } from "@/utils/common";
  import { useSubscriptionPurchase } from "@/subpackages/pages/my-subscriptions/hooks/useSubscriptionPurchase";
  import { getPeriodUnit } from "@/subpackages/pages/my-subscriptions/utils.uts";
  import { SUCCESS_CODE } from "@/constants/codes.constants.uts";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { isIosAppWebView } from "@/utils/appWebViewDetect";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import AgentIcon from "@/components/agent-icon/agent-icon.uvue";
  import { apiPublishedAgentInfo } from "@/servers/agentDev";
  import {
    getSubscriptionResponseValue,
    normalizeMySubscriptionItem,
    normalizeSystemSubscriptionPlanList,
    type SubscriptionItemView,
    type SubscriptionPlanView,
  } from "@/subpackages/utils/subscriptionAdapter";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  // 模板中调用需通过本地包装函数
  const formatNumberLocal = (value: any, precision: number): string => formatNumber(value, precision);
  const getPeriodUnitLocal = (period: string): string => getPeriodUnit(period);

  const props = defineProps({
    agentId: {
      type: Number,
      default: 0,
    },
    targetId: {
      type: Number,
      default: 0,
    },
    targetType: {
      type: String,
      default: "Agent",
    },
    currentPlanId: {
      type: Number,
      default: null,
    },
    currentPlanPrice: {
      type: Number,
      default: null,
    },
    calledTrialCount: {
      type: Number,
      default: 0,
    },
    trialCount: {
      type: Number,
      default: 0,
    },
    isNeedSubscription: {
      type: Boolean,
      default: true,
    },
    expertName: { type: String, default: "" },
    expertIcon: { type: String, default: "" },
    expertDescription: { type: String, default: "" },
    expertUserCount: { type: Number, default: 0 },
  });

  const emit = defineEmits(["purchase-success", "payment-start", "update-visible", "summon"]);

  const handleUpdateVisible = (visible: boolean) => {
    emit("update-visible", visible);
  };

  const modalRef = ref<any | null>(null);
  const loading = ref(false);
  const plans = ref<SubscriptionPlanView[]>([]);
  const currentSubscription = ref<SubscriptionItemView | null>(null);
  let plansRequestId: number = 0;
  const componentInstance = getCurrentInstance();
  const expertDrawerHeightPx = ref<number>(400);
  const expertPlansHeightPx = ref<number>(250);
  const windowWidthPx = ref<number>(375);
  const expertCardWidthPx = computed((): number => {
    const width = windowWidthPx.value;
    const scale = width / 750;
    const side = 24 * scale;
    const gap = 16 * scale;
    if (width < 350) return Math.max(220, width - side * 2);
    if (width < 600) return (width - side * 2 - gap) / 2;
    return Math.min(250, (width - side * 2 - gap * 2) / 3);
  });
  const plansRowStyle = computed((): string => {
    if (props.expertName.length == 0) return "";
    const scale = windowWidthPx.value / 750;
    const count = plans.value.length;
    const width = count * expertCardWidthPx.value + Math.max(0, count - 1) * 16 * scale + 48 * scale;
    return `width: ${width}px;`;
  });
  const detailTrialCount = ref<number>(0);
  const detailCalledTrialCount = ref<number>(0);
  const detailSubscribed = ref<boolean>(false);
  const detailPaymentRequired = ref<boolean>(true);
  const summonChecking = ref<boolean>(false);
  const hasExpertTrialRemaining = computed((): boolean => {
    return props.expertName.length > 0 &&
      detailPaymentRequired.value &&
      !detailSubscribed.value &&
      detailTrialCount.value > detailCalledTrialCount.value;
  });
  const expertSummonLabel = computed((): string => {
    return hasExpertTrialRemaining.value
      ? t("Mobile.ExpertList.trialExpert")
      : t("Mobile.ExpertList.summonExpert");
  });

  function measureExpertDrawer(attempt: number): void {
    if (props.expertName.length == 0 || componentInstance == null || componentInstance.proxy == null) return;
    const proxy = componentInstance.proxy;
    nextTick((): void => {
      uni.createSelectorQuery()
        .in(proxy)
        .select(".expert-summary")
        .boundingClientRect()
        .selectAll(".agent-sub-container--expert .plan-card")
        .boundingClientRect()
        .select(".agent-sub-container--expert .loading-state")
        .boundingClientRect()
        .select(".agent-sub-container--expert .empty-state")
        .boundingClientRect()
        .exec((results: Array<any>) => {
          const summaryRaw = results.length > 0 ? results[0] : null;
          if (summaryRaw == null) {
            if (attempt < 3) setTimeout((): void => measureExpertDrawer(attempt + 1), 100);
            return;
          }
          const summary = summaryRaw as NodeInfo;
          const summaryHeight = summary.height != null ? parseFloat(`${summary.height}`) : 0;
          let plansHeight = 0;
          const cardsRaw = results.length > 1 ? results[1] : null;
          if (cardsRaw != null && Array.isArray(cardsRaw)) {
            const cards = cardsRaw as NodeInfo[];
            for (let i = 0; i < cards.length; i++) {
              const height = cards[i].height != null ? parseFloat(`${cards[i].height}`) : 0;
              if (height > plansHeight) plansHeight = height;
            }
            if (plansHeight > 0) plansHeight += 56 * windowWidthPx.value / 750;
          }
          if (plansHeight == 0) {
            const stateRaw = loading.value ? (results.length > 2 ? results[2] : null) : (results.length > 3 ? results[3] : null);
            if (stateRaw != null) {
              const state = stateRaw as NodeInfo;
              plansHeight = state.height != null ? parseFloat(`${state.height}`) : 0;
            }
          }
          if (summaryHeight <= 0 || plansHeight <= 0) {
            if (attempt < 3) setTimeout((): void => measureExpertDrawer(attempt + 1), 100);
            return;
          }
          if (cardsRaw != null && plansHeight > 0) expertPlansHeightPx.value = Math.ceil(plansHeight);
          const windowInfo = uni.getWindowInfo();
          const viewportHeight = windowInfo.windowHeight != null ? windowInfo.windowHeight : 700;
          const naturalHeight = summaryHeight + plansHeight + 24 * windowWidthPx.value / 750;
          expertDrawerHeightPx.value = Math.ceil(Math.min(naturalHeight, Math.floor(viewportHeight * 0.78)));
        });
    });
  }

  watch(
    (): string => `${props.expertName}|${props.expertDescription}|${loading.value}|${plans.value.length}|${detailTrialCount.value}`,
    (): void => { measureExpertDrawer(0); },
  );

  const effectiveTargetId = computed((): number => props.targetId > 0 ? props.targetId : props.agentId);
  const isSkillTarget = computed((): boolean => props.targetType == "Skill");

  /**
   * 动态计算生效中的 planId
   */
  const activePlanId = computed((): number | null => {
    if (currentSubscription.value != null) {
      return currentSubscription.value.planId;
    }
    return props.currentPlanId;
  });

  /**
   * 动态计算生效中的 plan 价格，便于判断升级关系
   */
  const activePlanPrice = computed((): number | null => {
    if (
      currentSubscription.value != null &&
      currentSubscription.value.plan != null
    ) {
      return currentSubscription.value.plan.price;
    }
    return props.currentPlanPrice;
  });

  /**
   * 当前订阅状态辅助计算（模板中替代可选链）
   */
  const isCurrentExpired = computed((): boolean => {
    return currentSubscription.value != null && currentSubscription.value.status == "EXPIRED";
  });

  const isCurrentCancelled = computed((): boolean => {
    return currentSubscription.value != null && currentSubscription.value.status == "CANCELLED";
  });

  /**
   * iOS 常驻壳内嵌 H5 无应用内购买渠道：套餐按钮一律禁用。
   * 同一份 H5 也服务 Android/鸿蒙壳与浏览器直开，不能用 #ifdef APP-IOS。
   */
  const iosEmbeddedH5PayDisabled = computed((): boolean => {
    return isIosAppWebView() == true;
  });

  /**
   * 动态计算模态框标题，如含试用次数
   */
  const modalTitle = computed((): string => {
    const used = props.calledTrialCount;
    const total = props.trialCount;

    if (!props.isNeedSubscription || total == 0) {
      return t("Mobile.Chat.subscriptionModalTitle");
    }

    const trialParams = new Map<string, string | number>();
    trialParams.set("used", used.toString());
    trialParams.set("total", total.toString());
    return tFn("Mobile.Chat.subscriptionModalTitleTrial", toI18nParams(trialParams), "");
  });

  /**
   * 获取订阅状态文本
   */
  const getSubscriptionStatusText = (status: string): string => {
    if (status == "ACTIVE") {
      return t("Mobile.MySubscriptions.stateActive");
    }
    if (status == "EXPIRED") {
      return t("Mobile.MySubscriptions.stateExpired");
    }
    if (status == "CANCELLED") {
      return t("Mobile.MySubscriptions.stateCancelled");
    }
    return "";
  };

  /**
   * 计算操作按钮的文本（对齐 PC 端逻辑）
   * - 当前使用中套餐(ACTIVE/EXPIRED): "当前套餐(续订)"，支持点击续订
   * - 当前套餐已取消(CANCELLED): "订阅"
   * - 无订阅 / 价格 <= 当前使用金额: "订阅"
   * - 价格 > 当前使用金额: "升级"
   */
  const getActionText = (plan: SubscriptionPlanView): string => {
    if (props.expertName.length > 0) {
      return t("Mobile.MySubscriptions.planGrid");
    }
    const curPlanId = activePlanId.value;
    if (plan.id == curPlanId) {
      if (currentSubscription.value != null) {
        const status = currentSubscription.value.status;
        if (status == "CANCELLED") {
          return t("Mobile.MySubscriptions.planGrid");
        }
      }
      // 使用中/已过期的当前套餐：显示"当前套餐(续订)"
      const currentPlanText = t("Mobile.MySubscriptions.currentPlanButton");
      const renewText = t("Mobile.MySubscriptions.renewNow");
      return `${currentPlanText}(${renewText})`;
    }
    if (curPlanId == null) {
      return t("Mobile.MySubscriptions.planGrid");
    }
    // 使用当前生效套餐的金额作为判断基准
    const ap = activePlanPrice.value;
    const currentPrice = ap != null ? ap : 0;
    if (plan.price <= currentPrice) {
      return t("Mobile.MySubscriptions.planGrid");
    }
    return t("Mobile.MySubscriptions.upgradeNow");
  };

  /**
   * 加载智能体订阅及套餐列表
   */
  const fetchPlans = async () => {
    const targetId = effectiveTargetId.value;
    if (targetId <= 0) return;
    const requestId = ++plansRequestId;
    loading.value = true;
    plans.value = [] as SubscriptionPlanView[];
    currentSubscription.value = null;
    try {
      // 1. 获取当前智能体订阅情况
      const subParams = new Map<string, string>();
      subParams.set("bizId", targetId.toString());
      subParams.set("bizType", isSkillTarget.value ? "SKILL" : "AGENT");
      const subRes = await apiGetMySubscription(toStringRecord(subParams));
      if (requestId != plansRequestId) return;
      const subDataRaw = apiResData<any>(subRes);
      if (apiResCode(subRes) == SUCCESS_CODE && subDataRaw != null) {
        // Android：data 可能为 Map/UTSJSONObject，统一读取并转换为订阅模型
        const current = getSubscriptionResponseValue(
          subDataRaw,
          "currentSubscription",
        );
        currentSubscription.value =
          current != null ? normalizeMySubscriptionItem(current) : null;
      } else {
        currentSubscription.value = null;
      }

      // 2. 获取套餐列表
      if (isSkillTarget.value) {
        const res = await apiQueryToolPricing("SKILL", targetId);
        if (requestId != plansRequestId) return;
        const pricingRaw = apiResData<any>(res);
        if (apiResCode(res) == SUCCESS_CODE && pricingRaw != null) {
          plans.value = normalizeSystemSubscriptionPlanList(
            getSubscriptionResponseValue(pricingRaw, "plans"),
          );
        }
      } else {
        const planParams = new Map<string, any | null>();
        planParams.set("agentId", targetId);
        planParams.set("status", 1);
        const res = await apiGetAgentSubscriptionPlanList(toAnyRecord(planParams));
        if (requestId != plansRequestId) return;
        const planDataRaw = apiResData<any>(res);
        if (apiResCode(res) == SUCCESS_CODE && planDataRaw != null) {
          plans.value = normalizeSystemSubscriptionPlanList(planDataRaw);
        }
      }
    } catch (e) {
      console.error("[AgentSubscriptionModal] 加载数据失败:", e);
    } finally {
      if (requestId == plansRequestId) loading.value = false;
    }
  };

  /** Android：Gen* 组件禁止 as UTSJSONObject，用 $callMethod 调 defineExpose */
  const callModalMethod = (methodName: string) => {
    const m = modalRef.value;
    if (m == null) {
      return;
    }
    const proxy = m as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  };

  /** 关闭订阅计划弹框。 */
  const close = () => {
    callModalMethod("close");
  };

  const refreshExpertDetail = async (): Promise<boolean> => {
    const targetId = effectiveTargetId.value;
    if (props.expertName.length == 0 || targetId <= 0) return false;
    try {
      const response = await apiPublishedAgentInfo(targetId, false);
      if (targetId != effectiveTargetId.value) return false;
      const raw = apiResCode(response) == SUCCESS_CODE ? apiResData<any>(response) : null;
      if (raw == null) return false;
      const detail = raw as UTSJSONObject;
      detailSubscribed.value = detail["subscribed"] == true;
      detailPaymentRequired.value = detail["paymentRequired"] == true;
      const total = detail["trialCount"];
      const used = detail["calledTrialCount"];
      detailTrialCount.value = total != null ? parseFloat(`${total}`) : 0;
      detailCalledTrialCount.value = used != null ? parseFloat(`${used}`) : 0;
      return true;
    } catch (_error) {
      // 复核失败时保留付费门，不放行召唤。
      return false;
    }
  };

  const handleExpertSummon = async (): Promise<void> => {
    if (summonChecking.value) return;
    summonChecking.value = true;
    const verified = await refreshExpertDetail();
    summonChecking.value = false;
    if (
      verified &&
      (detailSubscribed.value ||
        !detailPaymentRequired.value ||
        hasExpertTrialRemaining.value)
    ) {
      emit("summon", detailSubscribed.value);
      close();
      return;
    }
    uni.showToast({ title: t("Mobile.ExpertList.subscribeFirst"), icon: "none" });
  };

  const purchase = useSubscriptionPurchase(
    () => {
      fetchPlans();
      refreshExpertDetail();
      emit("purchase-success", effectiveTargetId.value);
    },
    () => {
      // 订单创建成功、即将弹出微信/支付宝选择时主动收起套餐弹框。
      if (props.expertName.length > 0) emit("payment-start");
      close();
    },
  );
  // 模板解包用：须从 class 实例取 Ref，不能 as UTSJSONObject
  const processingId = purchase.processingId;

  const handleSelectPlan = async (plan: SubscriptionPlanView) => {
    if (iosEmbeddedH5PayDisabled.value || plan.price <= 0) return;
    await purchase.handlePaySubscription(plan.id);
  };

  /**
   * 打开弹窗
   */
  const open = () => {
    detailSubscribed.value = false;
    detailPaymentRequired.value = true;
    detailTrialCount.value = 0;
    detailCalledTrialCount.value = 0;
    summonChecking.value = false;
    const windowInfo = uni.getWindowInfo();
    const viewportHeight = windowInfo.windowHeight != null ? windowInfo.windowHeight : 700;
    windowWidthPx.value = windowInfo.windowWidth != null ? windowInfo.windowWidth : 375;
    expertDrawerHeightPx.value = Math.min(400, Math.floor(viewportHeight * 0.78));
    expertPlansHeightPx.value = 250;
    callModalMethod("open");
    fetchPlans();
    refreshExpertDetail();
    measureExpertDrawer(0);
  };

  defineExpose({
    open: open as any,
    close: close as any,
  });
</script>

<style lang="scss" scoped>
  @import "./agent-subscription-modal.scss";
</style>
