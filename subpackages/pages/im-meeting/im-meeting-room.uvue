    align-items: center;
    justify-content: center;
  }

  .mr-chat-send--disabled {
    background-color: #e5e6ea;
  }

  .mr-chat-send--active {
    opacity: 0.72;
  }

  /* flex:1 让参会人多时在面板内滚动（父级 max-height 封顶，内容短则按内容高） */
  .mr-sheet__body {
    flex: 1;
    padding: 0 16px 12px 16px;
  }

  /* 会议主题（面板第一项，PC 同序） */
  .mr-sheet__topic {
    padding: 2px 0 10px 0;
    font-size: 17px;
    line-height: 24px;
    font-weight: 600;
    color: #141416;
  }

  .mr-sheet__foot {
    padding: 16px 0 8px 0;
  }

  /* ---- 信息行 / 链接 / 按钮 ---- */
  .mr-row {
    padding: 10px 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .mr-label {
