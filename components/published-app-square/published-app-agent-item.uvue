<template>
  <agent-component
    :icon="iconText"
    :name="nameText"
    :description="descriptionText"
    :userCount="userCount"
    :convCount="convCount"
    :collectCount="collectCount"
    :collect="collected"
    :paymentRequired="paymentRequired"
    :subscribed="subscribed"
    @click="emit('click', info)"
    @collect="emit('collect', info)"
  />
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import AgentComponent from "@/components/agent-component/agent-component.uvue";

  const props = withDefaults(
    defineProps<{
      info: UTSJSONObject;
      enableSubscription?: number;
    }>(),
    {
      enableSubscription: 0,
    },
  );

  const emit = defineEmits<{
    click: [info: UTSJSONObject];
    collect: [info: UTSJSONObject];
  }>();

  function readText(info: UTSJSONObject, key: string): string {
    const raw = info[key];
    return raw != null ? `${raw}` : "";
  }

  function getNestedObj(info: UTSJSONObject, key: string): UTSJSONObject | null {
    const raw = info[key];
    if (raw == null) {
      return null;
    }
    return raw as UTSJSONObject;
  }

  function getStatNumber(info: UTSJSONObject, key: string): number {
    const stat = getNestedObj(info, "statistics");
    if (stat == null) {
      return 0;
    }
    const val = stat[key];
    return val != null ? val as number : 0;
  }

  const iconText = computed((): string => readText(props.info, "icon"));
  const nameText = computed((): string => readText(props.info, "name"));
  const descriptionText = computed((): string => readText(props.info, "description"));
  const userCount = computed((): number => getStatNumber(props.info, "userCount"));
  const convCount = computed((): number => getStatNumber(props.info, "convCount"));
  const collectCount = computed((): number => getStatNumber(props.info, "collectCount"));
  const collected = computed((): boolean => props.info["collect"] == true);
  const subscribed = computed((): boolean => props.info["subscribed"] == true);
  const paymentRequired = computed((): boolean => {
    return props.info["paymentRequired"] == true && props.enableSubscription == 1;
  });
</script>
