/** 所有编辑器适配器只提供文本/选区；触发规则不按平台分叉。 */
export function detectComposerQuickTrigger(text: string, cursor: number, selectionLength: number, composing: boolean, allowSkill: boolean, allowAt: boolean): UTSJSONObject | null {
  if (composing || selectionLength != 0 || cursor < 0 || cursor > text.length) return null;
  const prefix = text.substring(0, cursor);
  let start = prefix.length - 1;
  while (start >= 0 && !/\s/.test(prefix.charAt(start))) start--;
  start++;
  if (start >= prefix.length) return null;
  const trigger = prefix.charAt(start);
  const skill = trigger == "/";
  if (skill ? !allowSkill : ((trigger != "@" && trigger != "＠") || !allowAt)) return null;
  const keyword = prefix.substring(start + 1);
  // 第二个斜杠、协议分隔符、@ 等使 token 成为路径/URL/邮箱，而非快捷搜索。
  if (!/^[\w\u3400-\u9fff.\-]*$/.test(keyword)) return null;
  return { mode: skill ? "skill" : "at", start: start, end: cursor, keyword: keyword };
}
