<template>
  <view class="provision-progress">
    <custom-nav-bar
      :title="t('Mobile.Provision.Progress.title')"
      :show-back="true"
      :has-safety-zone="true"
      :intercept-back="isRunning"
      @back="onRequestLeave"
    />

    <scroll-view class="provision-progress__body" :scroll-y="true">
      <view class="provision-progress__inner">
      <!-- 进行中 -->
      <view v-if="!isSuccess" class="progress">
        <!-- 呼吸雷达动效 -->
        <view v-if="!isFailed" class="radar">
          <view class="radar__ring radar__ring--1"></view>
          <view class="radar__ring radar__ring--2"></view>
          <view class="radar__ring radar__ring--3"></view>
          <view class="radar__core">
            <text class="radar__core-icon">📡</text>
          </view>
        </view>

        <view class="stages">
          <view
            v-for="(stage, index) in stages"
            :key="index"
            class="stage"
          >
            <view class="stage__rail">
              <view v-if="index > 0" :class="['stage__line stage__line--top', stage.state != 'pending' ? 'stage__line--done' : '']"></view>
              <view class="stage__dot" :class="`stage__dot--${stage.state}`">
                <text v-if="stage.state == 'done'" class="stage__dot-icon">✓</text>
                <text v-else-if="stage.state == 'fail'" class="stage__dot-icon">✕</text>
                <view v-else-if="stage.state == 'active'" class="stage__dot-pulse"></view>
              </view>
              <view v-if="index < stages.length - 1" :class="['stage__line stage__line--bottom', stage.state == 'done' ? 'stage__line--done' : '']"></view>
            </view>
            <text class="stage__text" :class="{ 'stage__text--active': stage.state == 'active', 'stage__text--done': stage.state == 'done' }">{{ stage.label }}</text>
          </view>
        </view>
      </view>

      <!-- WiFi 写入成功后的设备在线确认：轮询期间以加载状态为主视觉 -->
      <view v-if="isCheckingOnline" class="online-check">
        <view class="online-check__visual">
          <view class="online-check__ring"></view>
          <view :class="['online-check__dot', 'online-check__dot--top', onlineIndicatorStep == 0 ? 'online-check__dot--active' : '']"></view>
          <view :class="['online-check__dot', 'online-check__dot--right', onlineIndicatorStep == 1 ? 'online-check__dot--active' : '']"></view>
          <view :class="['online-check__dot', 'online-check__dot--bottom', onlineIndicatorStep == 2 ? 'online-check__dot--active' : '']"></view>
          <view :class="['online-check__dot', 'online-check__dot--left', onlineIndicatorStep == 3 ? 'online-check__dot--active' : '']"></view>
          <view class="online-check__core">
            <text class="online-check__core-icon">📶</text>
          </view>
        </view>
        <text class="online-check__title">{{ t('Mobile.Provision.Result.checkingOnline') }}</text>
        <text class="online-check__desc">{{ t('Mobile.Provision.Result.onlineCheckDesc') }}</text>
        <view class="online-check__countdown">
          <text class="online-check__countdown-value">{{ onlineCountdown }}</text>
          <text class="online-check__countdown-unit">s</text>
        </view>
      </view>

      <!-- 仅确认设备上线后进入成功完成态；随后自动返回来源页 -->
      <view v-else-if="isSuccess && deviceOnline" class="result">
        <view class="result__badge result__badge--success">
          <text class="result__badge-icon">✓</text>
        </view>
        <text class="result__title">{{ t('Mobile.Provision.Result.successTitle') }}</text>
        <text class="result__desc">{{ successDesc }}</text>
        <text class="result__online result__online--ok">✓ {{ t('Mobile.Provision.Result.deviceOnline') }}</text>
      </view>

      <!-- 30 秒内未确认上线：进入待确认态，仅此时显示手动返回 -->
      <view v-else-if="isSuccess && onlineCheckFailed" class="result result--pending">
        <view class="result__badge result__badge--pending">
          <text class="result__badge-icon result__badge-icon--pending">!</text>
        </view>
        <text class="result__title">{{ t('Mobile.Provision.Result.onlineCheckTimeoutTitle') }}</text>
        <text class="result__desc">{{ t('Mobile.Provision.Result.onlineCheckFailed') }}</text>
        <view class="result__btn result__btn--primary" hover-class="result__btn--hover" @tap="onDone">
          <text class="result__btn-text result__btn-text--primary">{{ t('Mobile.Provision.Result.manualReturn') }}</text>
        </view>
      </view>

      <!-- 失败 -->
      <view v-if="isFailed" class="result result--failed">
        <view class="result__badge result__badge--fail">
          <text class="result__badge-icon">✕</text>
        </view>
        <text class="result__title">{{ t('Mobile.Provision.Result.failTitle') }}</text>
        <text class="result__desc">{{ failReason }}</text>
        <view class="result__btn-group">
          <view v-if="shouldEditWifi" class="result__btn result__btn--primary" hover-class="result__btn--hover" @tap="onEditWifi">
            <text class="result__btn-text result__btn-text--primary">{{ t('Mobile.Provision.Result.editWifi') }}</text>
          </view>
          <view v-else-if="retryable" class="result__btn result__btn--primary" hover-class="result__btn--hover" @tap="onRetry">
            <text class="result__btn-text result__btn-text--primary">{{ shouldReconnect ? t('Mobile.Provision.Result.reconnect') : t('Mobile.Provision.Result.retry') }}</text>
          </view>
          <view class="result__btn result__btn--plain" hover-class="result__btn--hover" @tap="onReprovision">
            <text class="result__btn-text result__btn-text--plain">{{ t('Mobile.Provision.Result.reprovision') }}</text>
          </view>
        </view>
      </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { ref, computed, watch, onUnmounted } from "vue";
  import { onLoad, onBackPress } from "@dcloudio/uni-app";
  import { useI18n, toI18nParams, emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { useEspProvisioning, releaseEspProvisioning } from "@/hooks/useEspProvisioning";
  import { getProvisionDevice, getProvisionCredentials, clearProvisionSession, getReprovisionTarget, getQrPayload, getProvisionReturnUrl } from "@/utils/provisionSession";
  import { EspProvisioningPhaseEnum } from "@/types/enums/espProvisioning";
  import { ProvisionRetryActionEnum } from "@/types/enums/provision";
  import { apiVoxDeviceDetail } from "@/servers/vox/voxDevice";
  import { apiResCode, apiResData } from "@/utils/common";
  import { SUCCESS_CODE } from "@/constants/codes.constants";

  // 本地 t 包装（composable 的 t 在模板中解析有坑，与主包页面一致）
  const t = (key: string, params?: Record<string, string | number>): string =>
    translateFn(key, params != null ? params : emptyI18nParams(), "");

  class StageItem {
    label: string;
    state: string; // 'pending' | 'active' | 'done' | 'fail'
    constructor(label: string, state: string) {
      this.label = label;
      this.state = state;
    }
  }

  const controller = useEspProvisioning();
  const phase = controller.phase;
  const error = controller.error;
  const connectedSsid = controller.connectedSsid;

  const isSuccess = computed((): boolean => phase.value == EspProvisioningPhaseEnum.SUCCESS);
  const isFailed = computed((): boolean => phase.value == EspProvisioningPhaseEnum.FAILED);
  const isRunning = computed((): boolean => !isSuccess.value && !isFailed.value);
  const retryable = computed((): boolean => error.value != null && error.value!!.retryable);
  const retryAction = computed((): ProvisionRetryActionEnum => error.value != null ? error.value!!.retryAction : ProvisionRetryActionEnum.NONE);
  const shouldEditWifi = computed((): boolean => retryAction.value == ProvisionRetryActionEnum.REWRITE);
  const shouldReconnect = computed((): boolean => retryAction.value == ProvisionRetryActionEnum.RECONNECT);
  const successDesc = computed((): string => {
    const m = new Map<string, string | number>();
    m.set("ssid", connectedSsid.value);
    const isReprovision = getReprovisionTarget() != null;
    const baseKey = isReprovision ? "Mobile.Provision.Result.reprovisionSuccessDesc" : "Mobile.Provision.Result.successDesc";
    return t(baseKey, toI18nParams(m));
  });

  const failReason = computed((): string => {
    const e = error.value;
    if (e == null) return t("Mobile.Provision.Error.unknown");
    return t(e.i18nKey);
  });

  // 进度步骤条
  const stages = computed((): StageItem[] => {
    const p = phase.value;
    const displayPhase = p == EspProvisioningPhaseEnum.FAILED ? controller.failedPhase.value : p;
    const order = [
      EspProvisioningPhaseEnum.CONNECTING,
      EspProvisioningPhaseEnum.ESTABLISHING_SESSION,
      EspProvisioningPhaseEnum.BINDING_DEVICE,
      EspProvisioningPhaseEnum.SENDING_CREDENTIALS,
      EspProvisioningPhaseEnum.CHECKING_STATUS,
    ] as EspProvisioningPhaseEnum[];
    const labels = [
      t("Mobile.Provision.Progress.stageConnect"),
      t("Mobile.Provision.Progress.stageSecureSession"),
      t("Mobile.Provision.Progress.stageBind"),
      t("Mobile.Provision.Progress.stageWrite"),
      t("Mobile.Provision.Progress.stageWait"),
    ] as string[];
    // 当前阶段在 order 中的下标（绑定+下发须在 WiFi 之前：Security 2 会话活着才能下发）
    let activeIdx = 0;
    if (displayPhase == EspProvisioningPhaseEnum.CONNECTING || displayPhase == EspProvisioningPhaseEnum.DISCOVERING) activeIdx = 0;
    else if (displayPhase == EspProvisioningPhaseEnum.ESTABLISHING_SESSION || displayPhase == EspProvisioningPhaseEnum.READING_DEVICE_INFO || displayPhase == EspProvisioningPhaseEnum.READY) activeIdx = 1;
    else if (displayPhase == EspProvisioningPhaseEnum.BINDING_DEVICE) activeIdx = 2;
    else if (displayPhase == EspProvisioningPhaseEnum.SENDING_CREDENTIALS || displayPhase == EspProvisioningPhaseEnum.APPLYING_CONFIG) activeIdx = 3;
    else if (displayPhase == EspProvisioningPhaseEnum.CHECKING_STATUS) activeIdx = 4;
    else if (p == EspProvisioningPhaseEnum.SUCCESS) activeIdx = 5; // 全部完成
    else activeIdx = 0;

    const result = [] as StageItem[];
    for (let i = 0; i < order.length; i++) {
      let state = 'pending';
      if (p == EspProvisioningPhaseEnum.FAILED) {
        state = i < activeIdx ? 'done' : (i == activeIdx ? 'fail' : 'pending');
      } else if (p == EspProvisioningPhaseEnum.SUCCESS) {
        state = 'done';
      } else {
        state = i < activeIdx ? 'done' : (i == activeIdx ? 'active' : 'pending');
      }
      result.push(new StageItem(labels[i], state));
    }
    return result;
  });

  const run = async () => {
    const cred = getProvisionCredentials();
    if (cred == null) {
      // 参数缺失，回扫描页
      uni.navigateBack({ delta: 2 });
      return;
    }
    const isFromQr = getQrPayload() != null;
    // 手动扫描链路：在 progress 页一次性 connect → READY；扫码直连链路已在 connect 页 READY
    if (!isFromQr) {
      const device = getProvisionDevice();
      if (device == null) {
        uni.navigateBack({ delta: 2 });
        return;
      }
      // 连接失败时仍保留本次内存凭据，用户点击重试可完成 reconnect → provision。
      const ok = await controller.selectAndPrepare(device, cred.ssid, cred.password);
      if (!ok) return;
    } else if (controller.phase.value != EspProvisioningPhaseEnum.READY) {
      const ok = await controller.selectAndPrepareFromQr();
      if (!ok) return;
    }
    // WiFi 前：绑定 App 账号并下发 vox-config（Security 2 会话活着才能下发；
    //   WiFi 成功后 SDK 清理会话，再下发会 SECURITY_AUTH_FAILED）。失败进失败页。
    const delivered = await controller.bindAndDeliverSecret("");
    if (!delivered) return;
    // WiFi set/apply/status
    await controller.provision(cred.ssid, cred.password);
  };

  const onRetry = async () => {
    await controller.retry();
  };

  const onEditWifi = () => {
    uni.navigateBack();
  };

  const onReprovision = () => {
    const target = getReprovisionTarget();
    let entryUrl = "/subpackages/pages/provision/provision-entry/provision-entry";
    if (target != null) {
      entryUrl = `${entryUrl}?deviceId=${encodeURIComponent(target.deviceId)}&name=${encodeURIComponent(target.name)}`;
    }
    releaseEspProvisioning();
    clearProvisionSession();
    uni.reLaunch({ url: entryUrl });
  };

  // ===== 配网写入后轮询检测设备上线（最长 30s，上线后自动返回，失败后手动返回）=====
  const ONLINE_TIMEOUT_SEC = 30;
  const onlineCountdown = ref<number>(ONLINE_TIMEOUT_SEC);
  const deviceOnline = ref<boolean>(false);
  const pollingOnline = ref<boolean>(false);
  const onlineCheckFailed = ref<boolean>(false);
  let pollTimerId = 0;
  const pollTick = ref<number>(0);
  let pollSessionId = 0;
  const isCheckingOnline = computed((): boolean => isSuccess.value && !deviceOnline.value && !onlineCheckFailed.value);
  const onlineIndicatorStep = computed((): number => pollTick.value % 4);

  const stopOnlinePolling = () => {
    // 让已发出的异步请求失效，避免超时后旧回包再次改变页面状态。
    pollSessionId = pollSessionId + 1;
    if (pollTimerId != 0) {
      clearInterval(pollTimerId);
      pollTimerId = 0;
    }
    pollingOnline.value = false;
  };

  let hasDone = false;
  const returnToSource = () => {
    const returnUrl = getProvisionReturnUrl();
    releaseEspProvisioning();
    clearProvisionSession();
    if (returnUrl == "/pages/terminal/terminal") {
      uni.switchTab({ url: returnUrl });
    } else if (returnUrl != "") {
      uni.reLaunch({ url: returnUrl });
    } else {
      uni.navigateBack();
    }
  };

  const onDone = () => {
    if (hasDone) return;
    hasDone = true;
    stopOnlinePolling();
    returnToSource();
  };

  const leaveProvision = () => {
    if (hasDone) return;
    hasDone = true;
    stopOnlinePolling();
    returnToSource();
  };

  const onRequestLeave = () => {
    if (!isRunning.value) {
      uni.navigateBack();
      return;
    }
    uni.showModal({
      content: t("Mobile.Provision.Progress.leaveConfirm"),
      success: (res: ShowModalSuccess) => {
        if (res.confirm) leaveProvision();
      },
    });
  };

  onBackPress((_options: OnBackPressOptions): boolean => {
    if (!isRunning.value) return false;
    onRequestLeave();
    return true;
  });

  const checkDeviceOnline = async (sessionId: number) => {
    const info = controller.deviceInfo.value;
    if (info == null || info.serialNumber == "") {
      if (sessionId == pollSessionId && pollingOnline.value) {
        stopOnlinePolling();
        onlineCheckFailed.value = true;
      }
      return;
    }
    try {
      const res = await apiVoxDeviceDetail(info.serialNumber);
      if (sessionId != pollSessionId || !pollingOnline.value) return;
      if (apiResCode(res) == SUCCESS_CODE) {
        const raw = apiResData<any>(res);
        const d = raw != null ? (raw as UTSJSONObject) : null;
        if (d != null) {
          const onlineVal = d["online"];
          if (onlineVal != null && (onlineVal as boolean)) {
            deviceOnline.value = true;
            stopOnlinePolling();
            // 30 秒窗口内确认成功立即返回；成功态不显示任何操作按钮。
            onDone();
          }
        }
      }
    } catch (e) {
      console.error("checkDeviceOnline error", e);
    }
  };

  const startOnlinePolling = () => {
    stopOnlinePolling();
    onlineCountdown.value = ONLINE_TIMEOUT_SEC;
    deviceOnline.value = false;
    onlineCheckFailed.value = false;
    pollingOnline.value = true;
    pollTick.value = 0;
    const sessionId = pollSessionId;
    pollTimerId = setInterval(() => {
      pollTick.value = pollTick.value + 1;
      onlineCountdown.value = onlineCountdown.value - 1;
      // 每 2 个 tick（约 2s）探测一次
      if (pollTick.value % 2 == 0) {
        checkDeviceOnline(sessionId);
      }
      // 倒计时结束后停留在结果页，仅此时提供手动返回。
      if (onlineCountdown.value <= 0) {
        stopOnlinePolling();
        onlineCheckFailed.value = true;
      }
    }, 1000) as number;
    // 进入结果页立即查询一次，后续每 2 秒继续确认。
    checkDeviceOnline(sessionId);
  };

  watch(isSuccess, (val: boolean) => {
    if (val) startOnlinePolling();
  });

  onUnmounted(() => {
    stopOnlinePolling();
  });

  onLoad((_options: OnLoadOptions) => {
    run();
  });
</script>

<style lang="scss" scoped>
  .provision-progress {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;

    &__body {
      flex: 1;
      overflow: hidden;
    }

    &__inner {
      padding: 32rpx 32rpx 56rpx;
    }
  }

  .progress {
    display: flex;
    flex-direction: column;
  }

  /* ===== 呼吸雷达动效 ===== */
  .radar {
    width: 240rpx;
    height: 240rpx;
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 24rpx;

    &__ring {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 200rpx;
      height: 200rpx;
      border-radius: 50%;
      border: 2rpx solid rgba(81, 71, 255, 0.5);
      transform: translate(-50%, -50%);
      opacity: 0.25;

      &--2 {
        width: 168rpx;
        height: 168rpx;
        opacity: 0.4;
      }

      &--3 {
        width: 144rpx;
        height: 144rpx;
        opacity: 0.6;
      }
    }

    &__core {
      width: 128rpx;
      height: 128rpx;
      border-radius: 50%;
      background-color: rgba(81, 71, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    &__core-icon {
      font-size: 56rpx;
    }
  }

  /* ===== 步骤条（带连接线） ===== */
  .stages {
    display: flex;
    flex-direction: column;
  }

  .stage {
    display: flex;
    flex-direction: row;
    align-items: stretch;

    &__rail {
      // active 圆点会放大到约 53rpx；轨道须预留左右安全区，避免 App 原生布局裁切。
      width: 64rpx;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-right: 16rpx;
    }

    &__line {
      width: 4rpx;
      flex: 1;
      min-height: 20rpx;
      background-color: #e0e0e0;
      transition: background-color 0.3s ease;

      &--done {
        background-color: #5147ff;
      }
    }

    &__dot {
      width: 48rpx;
      height: 48rpx;
      border-radius: 50%;
      background-color: #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background-color 0.3s ease, transform 0.3s ease;

      &--active {
        background-color: #5147ff;
        transform: scale(1.1);
      }

      &--done {
        background-color: #4cd964;
      }

      &--fail {
        background-color: #dd524d;
      }
    }

    &__dot-pulse {
      width: 20rpx;
      height: 20rpx;
      border-radius: 50%;
      background-color: #ffffff;
    }

    &__dot-icon {
      color: #ffffff;
      font-size: 28rpx;
      line-height: 32rpx;
      text-align: center;
    }

    &__text {
      flex: 1;
      min-width: 0;
      font-size: 30rpx;
      color: #999;
      padding: 20rpx 0;
      line-height: 40rpx;
      transition: color 0.3s ease;

      &--active {
        color: #333;
        font-weight: 600;
      }

      &--done {
        color: #666;
      }
    }
  }

  /* ===== 写入完成后的在线确认（由轮询 tick 驱动动态高亮，兼容 uni-app x App） ===== */
  .online-check {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 72rpx;

    &__visual {
      position: relative;
      width: 280rpx;
      height: 280rpx;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 48rpx;
    }

    &__ring {
      position: absolute;
      top: 20rpx;
      left: 20rpx;
      width: 240rpx;
      height: 240rpx;
      border-radius: 50%;
      border: 4rpx solid rgba(81, 71, 255, 0.16);
      background-color: rgba(81, 71, 255, 0.04);
    }

    &__core {
      width: 144rpx;
      height: 144rpx;
      border-radius: 50%;
      background-color: #ffffff;
      border: 2rpx solid rgba(81, 71, 255, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    &__core-icon {
      font-size: 64rpx;
    }

    &__dot {
      position: absolute;
      width: 18rpx;
      height: 18rpx;
      border-radius: 50%;
      background-color: rgba(81, 71, 255, 0.22);
      transition: background-color 0.2s ease, transform 0.2s ease;

      &--top {
        top: 10rpx;
        left: 131rpx;
      }

      &--right {
        top: 131rpx;
        right: 10rpx;
      }

      &--bottom {
        bottom: 10rpx;
        left: 131rpx;
      }

      &--left {
        top: 131rpx;
        left: 10rpx;
      }

      &--active {
        width: 28rpx;
        height: 28rpx;
        background-color: #5147ff;
      }
    }

    &__title {
      color: #333333;
      font-size: 36rpx;
      font-weight: 600;
      text-align: center;
      margin-bottom: 20rpx;
    }

    &__desc {
      width: 86%;
      color: #888888;
      font-size: 27rpx;
      line-height: 42rpx;
      text-align: center;
      margin-bottom: 36rpx;
    }

    &__countdown {
      min-width: 112rpx;
      padding: 14rpx 28rpx;
      border-radius: 40rpx;
      background-color: rgba(81, 71, 255, 0.1);
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
    }

    &__countdown-value {
      color: #5147ff;
      font-size: 36rpx;
      font-weight: 600;
    }

    &__countdown-unit {
      color: #5147ff;
      font-size: 24rpx;
      margin-left: 4rpx;
    }
  }

  /* ===== 结果（成功/失败） ===== */
  .result {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 60rpx;

    &--failed {
      padding-top: 32rpx;
    }

    &--pending {
      padding-top: 72rpx;
    }

    &__badge {
      width: 160rpx;
      height: 160rpx;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 32rpx;

      &--success {
        background-color: rgba(76, 217, 100, 0.12);
      }

      &--fail {
        background-color: rgba(221, 82, 77, 0.1);
      }

      &--pending {
