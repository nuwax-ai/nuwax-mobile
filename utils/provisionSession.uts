/**
 * 配网会话存储（页间共享，纯内存，不落盘）
 *
 * 用途：配网流程跨 3 个页面（scan → wifi → progress），
 *  - WiFi 页输入的凭据经此传递给进度页（敏感信息不走 URL query/页面栈/日志）
 *  - 扫描页选中的设备信息经此传递
 * 进度页 onUnload 调 clear() 清空。
 */
import type { WifiCredentials } from '@/types/interfaces/provision';
import type { EspProvisioningDevice } from '@/types/interfaces/espProvisioning';

/** 当前选中的目标设备 */
let currentDevice: EspProvisioningDevice | null = null;
/** 当前输入的 WiFi 凭据（仅内存） */
let currentCredentials: WifiCredentials | null = null;

export function setProvisionDevice(device: EspProvisioningDevice): void {
  currentDevice = device;
}

export function getProvisionDevice(): EspProvisioningDevice | null {
  return currentDevice;
}

export function setProvisionCredentials(credentials: WifiCredentials): void {
  currentCredentials = credentials;
}

export function getProvisionCredentials(): WifiCredentials | null {
  return currentCredentials;
}

/** 清空会话（进度页离开/完成/失败重开时调用） */
export function clearProvisionSession(): void {
  currentDevice = null;
  currentCredentials = null;
}
