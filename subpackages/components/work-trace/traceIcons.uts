/**
 * V2 轨迹类型 → iconfont 类名映射（H5/MP-WEIXIN 分支使用）。
 * 图标取自项目 iconfont（static/iconfont），语义对齐 PC antd 图标：
 * file-read=ReadOutlined→book、todo=OrderedListOutlined→List；
 * 其余与 PC 同义（Edit/Search/Globe/skill/wrench）。
 * 注意：terminal 不走本映射——iconfont 无终端字形，行/组头用内联 SVG mask
 * （方框+>_ 终端图标，见 tool-trace-row / tool-trace-group 的 *-icon-terminal）；
 * 此处 branch 仅作未命中专用图标的兜底。
 */
export function traceKindIconClass(kind: string): string {
  if (kind == "terminal") return "icon-branch";
  if (kind == "file-read") return "icon-book";
  if (kind == "file-edit") return "icon-Edit";
  if (kind == "search") return "icon-Search";
  if (kind == "browser") return "icon-Globe";
  if (kind == "skill") return "icon-skill";
  if (kind == "todo") return "icon-List";
  return "icon-wrench";
}

/** App 原生端不生成空 text 的 ::before，直接提供 iconfont 字形。 */
export function traceKindIconGlyph(kind: string): string {
  if (kind == "terminal") return "\ue638";
  if (kind == "file-read") return "\ue63d";
  if (kind == "file-edit") return "\ue642";
  if (kind == "search") return "\ue62a";
  if (kind == "browser") return "\ue619";
  if (kind == "skill") return "\ue64f";
  if (kind == "todo") return "\ue630";
  return "\ue63c";
}
