<template>
  <view class="vh-page">
    <safety-zone />
    <view class="vh-nav">
      <view class="vh-nav__side" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="22" unit="px" color="#1a1a1a" />
      </view>
      <text class="vh-nav__title">历史记录</text>
      <view class="vh-nav__side"></view>
    </view>
    <scroll-view class="vh-list" scroll-y="true">
      <view v-for="item in records" :key="item.id" class="vh-card">
        <view class="vh-card__head">
          <text class="vh-card__title">{{ item.title }}</text>
          <view class="vh-card__download" @click="handleDownload(item)">
            <svg-icon name="icon-msg-download" size="20" unit="px" color="#5b4dff" />
          </view>
        </view>
        <text class="vh-card__meta">时长 {{ item.duration }} · {{ item.recordedAt }}</text>
        <view class="vh-card__file">
          <svg-icon name="icon-a-Filetext" size="16" unit="px" color="#7a78e6" />
          <text class="vh-card__path">{{ item.libraryPath }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
/**
 * 录音历史。列表暂为写死数据，字段对齐后续接口：标题、时长、时间、资料库路径、正文。
 */
type VoiceRecordHistoryItem = {
  id: string;
  title: string;
  duration: string;
  recordedAt: string;
  libraryPath: string;
  fileName: string;
  content: string;
};

const records = ref<VoiceRecordHistoryItem[]>([
  {
    id: "1",
    title: "产品评审会议录音",
    duration: "12:36",
    recordedAt: "2026-10-31 14:30",
    libraryPath: "资料库 / 录音 / 产品评审会议录音.md",
    fileName: "产品评审会议录音.md",
    content: "# 产品评审会议录音\n\n时长 12:36\n时间 2026-10-31 14:30\n",
  },
  {
    id: "2",
    title: "需求沟通要点",
    duration: "08:52",
    recordedAt: "2026-10-30 10:15",
    libraryPath: "资料库 / 录音 / 需求沟通要点.md",
    fileName: "需求沟通要点.md",
    content: "# 需求沟通要点\n\n时长 08:52\n时间 2026-10-30 10:15\n",
  },
  {
    id: "3",
    title: "周会速记",
    duration: "23:04",
    recordedAt: "2026-10-29 09:00",
    libraryPath: "资料库 / 录音 / 周会速记.md",
    fileName: "周会速记.md",
    content: "# 周会速记\n\n时长 23:04\n时间 2026-10-29 09:00\n",
  },
]);

function handleBack(): void {
  uni.navigateBack({ delta: 1 });
}

function handleDownload(item: VoiceRecordHistoryItem): void {
  const filePath = uni.env.USER_DATA_PATH + "/" + item.fileName;
  const fs = uni.getFileSystemManager();
  fs.writeFile({
    filePath: filePath,
    data: item.content,
    encoding: "utf8",
    success: () => {
      uni.openDocument({
        filePath: filePath,
        success: () => {
          uni.showToast({ title: "已下载", icon: "none" });
        },
        fail: () => {
          uni.showToast({ title: "已保存到本地", icon: "none" });
        },
      });
    },
    fail: () => {
      uni.showToast({ title: "下载失败", icon: "none" });
    },
  });
}
</script>

<style lang="scss" scoped>
