import { VoipBridge } from './VoipBridge.ets'
export { VoipBridge } from './VoipBridge.ets'
export function executeVoip(command: string): void {
  VoipBridge.context = UTSHarmony.getUIAbilityContext()
  VoipBridge.execute(command)
}
export function drainVoipEvents(): string { return VoipBridge.drain() }
export function getNativeMeetingInviteState(msgId: string): string { return VoipBridge.meetingInviteState(msgId) }
export function isVoipTestPackage(): boolean { return false }
export function hasNativeVoipCall(): boolean {
  const pending = VoipBridge.pendingIncoming
  return VoipBridge.current != null || (pending != null && pending.invite.scene !== 'meeting')
}
export function ensureVoipPermissions(mediaType: string): Promise<boolean> {
  VoipBridge.context = UTSHarmony.getUIAbilityContext()
  return VoipBridge.ensurePermissions(mediaType)
}
/** Harmony renders both tracks in a separate native Ability, retained while the chat page changes. */
export class VoipVideoBinding {
  constructor(_element: UniNativeViewElement, _local: boolean) { VoipBridge.showMedia() }
  dispose(): void {}
}

/** Android call presentation permissions are managed independently of media grants. */
export function getVoipPresentationStatus(): string { return '{"supported":false}'; }
export function openVoipPresentationSettings(): void {}
export function openVoipAppSettings(): void {}
