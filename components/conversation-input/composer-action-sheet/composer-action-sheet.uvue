<template>
  <uni-modal-popup ref="popupRef" position="bottom" height="75%" :show-header="false" :body-scroll="false" @update-visible="handleVisibleChange">
    <view class="sheet" :class="{ 'sheet--avoid-tab-bar': avoidTabBar }">
      <view class="sheet-handle" />
      <view class="media-grid">
        <view class="media-card" @click="selectAction('camera')"><svg-icon name="icon-Camera" size="48" /><text class="media-text">{{ t("Mobile.Chat.takePhoto") }}</text></view>
        <view class="media-card" @click="selectAction('album')"><svg-icon name="icon-Image" size="48" /><text class="media-text">{{ t("Mobile.CreateHub.photoVideo") }}</text></view>
        <view class="media-card" @click="selectAction('file')"><svg-icon name="icon-Folder" size="48" /><text class="media-text">{{ t("Mobile.CreateHub.phoneFiles") }}</text></view>
      </view>
      <scroll-view class="action-list" direction="vertical" :show-scrollbar="false">
        <view class="action-row" @click="selectAction('expert')"><view class="action-icon"><text class="action-symbol">@</text></view><text class="action-name">{{ t("Mobile.CreateHub.mentionExpert") }}</text></view>
        <view class="action-row" @click="selectAction('skill')"><view class="action-icon"><text class="action-symbol">/</text></view><text class="action-name">{{ t("Mobile.CreateHub.selectSkill") }}</text></view>
        <view class="action-row" @click="selectAction('connector')">
          <view class="action-icon"><svg-icon name="icon-Link" size="36" /></view>
          <text class="action-name">{{ t("Mobile.CreateHub.connector") }}</text>
          <view v-if="connectedConnectors.length > 0" class="connector-avatar-group">
            <view v-for="(connector, index) in visibleConnectorAvatars" :key="connector.key" class="connector-avatar" :style="{ zIndex: `${10 - index}` }">
              <agent-icon v-if="connector.icon.length > 0" :icon="connector.icon" :alt="connector.name" :size="48" :margin-right="0" />
              <text v-else class="connector-avatar-fallback">{{ connector.name.length > 0 ? connector.name.substring(0, 1) : "C" }}</text>
            </view>
            <view v-if="connectedConnectorOverflow > 0" class="connector-avatar connector-avatar--more">
              <text class="connector-avatar-more">+{{ connectedConnectorOverflow }}</text>
            </view>
          </view>
        </view>
        <view class="action-row" @click="selectAction('knowledge')"><view class="action-icon"><svg-icon name="icon-a-Filetext" size="36" /></view><text class="action-name">{{ t("Mobile.CreateHub.knowledgeBase") }}</text></view>
        <view class="action-divider" />
        <view class="action-row"><view class="action-icon"><svg-icon name="icon-Clock" size="36" /></view><text class="action-name">{{ t("Mobile.CreateHub.versionManagement") }}</text><switch :checked="versionEnabled" :disabled="switchDisabled" color="#5147ff" @change="handleVersionControlChange" /></view>
        <view v-if="versionEnabled" class="action-row"><view class="action-icon"><svg-icon name="icon-branch" size="36" /></view><text class="action-name">{{ t("Mobile.CreateHub.autoCommit") }}</text><switch :checked="autoCommitEnabled" :disabled="switchDisabled" color="#5147ff" @change="handleAutoCommitChange" /></view>
        <view class="action-row"><view class="action-icon"><svg-icon name="icon-seal" size="36" /></view><text class="action-name">{{ t("Mobile.CreateHub.approvalMode") }}</text><switch :checked="approvalEnabled" :disabled="switchDisabled" color="#5147ff" @change="handleApprovalChange" /></view>
      </scroll-view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { computed, ref, watch, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import AgentIcon from "@/components/agent-icon/agent-icon.uvue";
  import { apiConnectorProviderList } from "@/servers/connector";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { t as tRaw, emptyI18nParams } from "@/utils/i18n";
  const t = (key: string): string => tRaw(key, emptyI18nParams(), "");
  const props = withDefaults(defineProps<{ visible: boolean; approvalEnabled?: boolean; versionEnabled?: boolean; autoCommitEnabled?: boolean; switchDisabled?: boolean; avoidTabBar?: boolean; }>(), { visible: false, approvalEnabled: false, versionEnabled: false, autoCommitEnabled: true, switchDisabled: false, avoidTabBar: false });
  const emit = defineEmits<{ (e: "close"): void; (e: "action", action: string): void; (e: "version-control-change", value: boolean): void; (e: "auto-commit-change", value: boolean): void; (e: "approval-change", value: boolean): void; }>();
  const popupRef = ref<any | null>(null);
  class ConnectorMenuAvatar {
    key: string = "";
    name: string = "";
    icon: string = "";
  }
  const connectedConnectors = ref<ConnectorMenuAvatar[]>([] as ConnectorMenuAvatar[]);
  const visibleConnectorAvatars = computed((): ConnectorMenuAvatar[] => connectedConnectors.value.slice(0, 3));
  const connectedConnectorOverflow = computed((): number => Math.max(0, connectedConnectors.value.length - 3));
  let connectorRequestId = 0;

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  async function loadConnectedConnectors(): Promise<void> {
    const requestId = connectorRequestId + 1;
    connectorRequestId = requestId;
    try {
      const res = await apiConnectorProviderList(1, 9999, "", "true", "", "", 0);
      if (requestId != connectorRequestId || apiResCode(res) != SUCCESS_CODE) return;
      const dataRaw = apiResData<any>(res);
      let rows = [] as any[];
      if (dataRaw != null) {
        if (Array.isArray(dataRaw)) rows = dataRaw as any[];
        else {
          const data = dataRaw as UTSJSONObject;
          const records = data["records"];
          if (records != null) rows = records as any[];
        }
      }
      const next = [] as ConnectorMenuAvatar[];
      for (let i = 0; i < rows.length; i++) {
        const raw = rows[i] as UTSJSONObject;
        const item = new ConnectorMenuAvatar();
        item.key = readString(raw, "service");
        if (item.key.length == 0) item.key = readString(raw, "id");
        item.name = readString(raw, "displayName");
        if (item.name.length == 0) item.name = readString(raw, "service");
        item.icon = readString(raw, "icon");
        next.push(item);
      }
      connectedConnectors.value = next;
    } catch (_error) {
      if (requestId == connectorRequestId) connectedConnectors.value = [] as ConnectorMenuAvatar[];
    }
  }
  function callPopup(method: string): void { if (popupRef.value != null) (popupRef.value as ComponentPublicInstance).$callMethod(method); }
  function handleVisibleChange(value: boolean): void { if (value != true) emit("close"); }
  function selectAction(action: string): void { emit("action", action); if (action != "approval" && action != "version") callPopup("close"); }
  function handleVersionControlChange(e: UniSwitchChangeEvent): void { emit("version-control-change", e.detail.value); }
  function handleAutoCommitChange(e: UniSwitchChangeEvent): void { emit("auto-commit-change", e.detail.value); }
  function handleApprovalChange(e: UniSwitchChangeEvent): void { emit("approval-change", e.detail.value); }
  watch((): boolean => props.visible, (value: boolean): void => {
    if (value) {
      callPopup("open");
      loadConnectedConnectors();
    } else callPopup("close");
  });
</script>

<style lang="scss" scoped>
  .sheet { display: flex; flex-direction: column; height: 100%; padding: 18rpx 32rpx 0; background: #fff; box-sizing: border-box; }
  /* #ifdef APP */
  .sheet--avoid-tab-bar { padding-bottom: 100rpx; }
  /* #endif */
  /* #ifdef H5 */
  .sheet--avoid-tab-bar { padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
  /* #endif */
  .sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 34rpx; border-radius: 999rpx; background: #dedee8; }
  .media-grid { display: flex; flex-direction: row; }
  .media-card { flex: 1; height: 154rpx; margin-right: 18rpx; border-radius: 26rpx; background: #f5f4f8; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .media-card:last-child { margin-right: 0; }
  .media-text { margin-top: 18rpx; color: #2c2c33; font-size: 27rpx; }
  .action-list { flex: 1; min-height: 0; margin-top: 18rpx; }
  .action-row { min-height: 80rpx; display: flex; flex-direction: row; align-items: center; padding: 4rpx 8rpx; box-sizing: border-box; }
  .action-icon { width: 64rpx; height: 64rpx; border-radius: 50%; background: #f3f2f6; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .action-symbol { color: #25252d; font-size: 40rpx; line-height: 48rpx; }
  .action-name { flex: 1; margin-left: 22rpx; color: #292930; font-size: 29rpx; }
  .connector-avatar-group { flex-shrink: 0; display: flex; flex-direction: row; align-items: center; padding-right: 4rpx; }
  .connector-avatar { width: 56rpx; height: 56rpx; margin-left: -12rpx; border: 4rpx solid #ffffff; border-radius: 999rpx; background-color: #f0eff8; display: flex; align-items: center; justify-content: center; overflow: hidden; box-sizing: border-box; }
  .connector-avatar:first-child { margin-left: 0; }
  .connector-avatar--more { z-index: 0; background-color: #eeeef3; }
  .connector-avatar-fallback { color: #5147ff; font-size: 24rpx; font-weight: 700; }
  .connector-avatar-more { color: #686873; font-size: 22rpx; font-weight: 600; }
  .action-divider { height: 2rpx; margin: 6rpx 0; background: #eeeef2; }
</style>
