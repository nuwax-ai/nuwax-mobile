<template>
  <view class="detail">
    <custom-nav-bar :title="t('Mobile.Discover.scheduleDetailTitle')" className="border-b" hasSafetyZone :show-back="true" />
    <scroll-view v-if="ready" class="detail__scroll" direction="vertical" :show-scrollbar="false">
      <view class="detail__theme">
        <text class="detail__theme-text">{{ title }}</text>
      </view>
      <view class="detail__line"></view>

      <view class="detail__row">
        <view class="detail__icon">
          <svg-icon name="icon-User" size="20" unit="px" color="#c9cdd4" />
        </view>
        <text class="detail__muted">{{ t("Mobile.Discover.scheduleNoParticipants") }}</text>
      </view>
      <view class="detail__line"></view>

      <view class="detail__when">
        <view class="detail__icon detail__icon--top">
          <svg-icon name="icon-Clock" size="20" unit="px" color="#c9cdd4" />
        </view>
        <view class="detail__when-main">
          <view class="detail__when-side">
            <text class="detail__hm">{{ startHeadline }}</text>
            <text class="detail__date">{{ startDateText }}</text>
            <text class="detail__tz">{{ t("Mobile.Discover.scheduleTimezone") }}</text>
          </view>
          <view class="detail__when-arrow">
            <svg-icon name="icon-a-Chevronright" size="16" unit="px" color="#c9cdd4" />
          </view>
          <view class="detail__when-side">
            <text class="detail__hm">{{ endHeadline }}</text>
            <text class="detail__date">{{ endDateText }}</text>
          </view>
        </view>
      </view>
      <view class="detail__line"></view>

      <view class="detail__row">
        <view class="detail__icon">
          <svg-icon name="icon-refresh" size="20" unit="px" color="#c9cdd4" />
        </view>
        <text class="detail__label">{{ t("Mobile.Discover.scheduleRepeat") }}</text>
        <text class="detail__value">{{ repeatText }}</text>
      </view>
      <view class="detail__line"></view>

      <view class="detail__row">
        <view class="detail__icon">
          <view class="detail__pin"></view>
        </view>
        <text :class="hasLocation ? 'detail__label' : 'detail__muted'">{{ locationText }}</text>
      </view>
      <view class="detail__line"></view>

      <view class="detail__row">
        <view class="detail__icon">
          <svg-icon name="icon-bell" size="20" unit="px" color="#c9cdd4" />
        </view>
        <text class="detail__label">{{ t("Mobile.Discover.scheduleRemind") }}</text>
        <text class="detail__value">{{ remindText }}</text>
      </view>
      <view class="detail__line"></view>

      <view class="detail__row">
        <view class="detail__icon">
          <svg-icon name="icon-a-Filetext" size="20" unit="px" color="#c9cdd4" />
        </view>
        <text :class="hasNotes ? 'detail__label' : 'detail__muted'">{{ notesText }}</text>
      </view>
      <view class="detail__line"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { findScheduleDetail } from "@/utils/scheduleBoard";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const ready = ref<boolean>(false);
  const title = ref<string>("");
  const startHeadline = ref<string>("");
  const endHeadline = ref<string>("");
  const startDateText = ref<string>("");
  const endDateText = ref<string>("");
  const repeatText = ref<string>("");
  const remindText = ref<string>("");
  const locationText = ref<string>("");
  const notesText = ref<string>("");
  const hasLocation = ref<boolean>(false);
  const hasNotes = ref<boolean>(false);

  function readQuery(options: any, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    return `${raw}`;
  }

  onLoad((options: any) => {
    const detail = findScheduleDetail(readQuery(options, "id"));
    if (detail == null) {
      uni.showToast({ title: t("Mobile.Discover.scheduleMissing"), icon: "none" });
      setTimeout(() => {
        uni.navigateBack();
      }, 400);
      return;
    }
    title.value = detail.title;
    startHeadline.value = detail.startHeadline;
    endHeadline.value = detail.endHeadline;
    startDateText.value = detail.startDateText;
    endDateText.value = detail.endDateText;
    repeatText.value = detail.repeatText;
    remindText.value = detail.remindText;
    hasLocation.value = detail.hasLocation;
    hasNotes.value = detail.hasNotes;
    locationText.value = detail.hasLocation ? detail.location : t("Mobile.Discover.scheduleNoLocation");
    notesText.value = detail.hasNotes ? detail.notes : t("Mobile.Discover.scheduleNoNotes");
    ready.value = true;
  });
</script>

<style scoped>
  .detail {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
  }

  .detail__scroll {
    flex: 1;
  }

  .detail__theme {
    padding: 18px 16px 16px;
  }

  .detail__theme-text {
    font-size: 22px;
    color: #1f2329;
    line-height: 32px;
  }

  .detail__line {
    height: 1px;
    background-color: #f2f3f5;
  }

  .detail__row {
    min-height: 56px;
    padding: 0 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .detail__icon {
    width: 22px;
    height: 22px;
    margin-right: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .detail__icon--top {
    margin-top: 4px;
    align-self: flex-start;
  }

  .detail__label {
    flex: 1;
    font-size: 16px;
    color: #1f2329;
  }

  .detail__muted {
    flex: 1;
    font-size: 16px;
    color: #86909c;
  }

  .detail__value {
    font-size: 15px;
    color: #86909c;
  }

  .detail__when {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }

  .detail__when-main {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }

  .detail__when-side {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .detail__when-arrow {
    width: 28px;
    height: 28px;
    margin-top: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .detail__hm {
    font-size: 22px;
    font-weight: 600;
    color: #1f2329;
    line-height: 30px;
  }

  .detail__date {
    margin-top: 2px;
    font-size: 13px;
    color: #4e5969;
    line-height: 18px;
  }

  .detail__tz {
    margin-top: 2px;
    font-size: 12px;
    color: #86909c;
    line-height: 16px;
  }

  .detail__pin {
    width: 14px;
    height: 14px;
    border-width: 1.5px;
    border-style: solid;
    border-color: #c9cdd4;
    border-radius: 8px 8px 8px 2px;
    transform: rotate(-45deg);
  }
</style>
