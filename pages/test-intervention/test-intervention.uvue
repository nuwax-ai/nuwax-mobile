<template>
  <view class="ti-page">
    <view class="ti-header">
      <text class="ti-title">干预卡片渲染测试（vapor）</text>
      <text class="ti-sub">全 widget + wizard + 权限审批。提交/响应看控制台。参考 nuwax/src/examples/AgentInterventionDemo。</text>
    </view>
    <scroll-view class="ti-scroll" direction="vertical" :show-scrollbar="false">
      <!-- MCP Ask 场景 -->
      <view v-for="(it, idx) in askInteractions" :key="'ask-' + idx" class="ti-section">
        <text class="ti-section-title">MCP Ask #{{ idx + 1 }} · {{ askTitles[idx] }}</text>
        <mcp-ask-question-card :interaction="it" @respond="onRespond" />
      </view>

      <!-- ACP 权限审批场景 -->
      <view v-for="(it, idx) in acpInteractions" :key="'acp-' + idx" class="ti-section">
        <text class="ti-section-title">ACP #{{ idx + 1 }} · {{ acpTitles[idx] }}</text>
        <acp-permission-card :interaction="it" @respond="onRespond" />
      </view>
      <view class="ti-footer-gap" />
    </scroll-view>
  </view>
</template>

<script lang="uts" setup>
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { ref } from "vue";
  import McpAskQuestionCard from "@/components/agent-intervention/mcp-ask-question-card/mcp-ask-question-card.uvue";
  import AcpPermissionCard from "@/components/agent-intervention/acp-permission-card/acp-permission-card.uvue";

  // ---------- mock 构造 helpers（移动端 v2 格式：ui.fields[] 自描述数组） ----------
  const opt = (v: string, l: string): UTSJSONObject => {
    const o = new UTSJSONObject(); o["value"] = v; o["label"] = l; return o;
  };
  // 字段：options 传 [] 表示无选项（text/textarea/number）
  const mkField = (name: string, widget: string, title: string, type: string, options: UTSJSONObject[]): UTSJSONObject => {
    const f = new UTSJSONObject();
    f["name"] = name; f["widget"] = widget; f["title"] = title; f["type"] = type;
    if (options.length > 0) f["options"] = options;
    return f;
  };
  // ask interaction
  const mkAsk = (requestId: string, title: string, description: string, fields: UTSJSONObject[]): UTSJSONObject => {
    const ui = new UTSJSONObject();
    ui["fields"] = fields; ui["title"] = title; ui["description"] = description;
    ui["presentation"] = "inline"; ui["submitLabel"] = "提交";
    const it = new UTSJSONObject();
    it["requestId"] = requestId; it["revision"] = 1; it["responseStatus"] = "pending";
    it["title"] = title; it["description"] = description; it["ui"] = ui;
    return it;
  };
  // ask wizard（带 steps）
  const mkAskWizard = (requestId: string, title: string, description: string, fields: UTSJSONObject[], steps: UTSJSONObject[]): UTSJSONObject => {
    const ui = new UTSJSONObject();
    ui["fields"] = fields; ui["title"] = title; ui["description"] = description;
    ui["presentation"] = "wizard"; ui["submitLabel"] = "完成";
    ui["steps"] = steps;
    const it = new UTSJSONObject();
    it["requestId"] = requestId; it["revision"] = 1; it["responseStatus"] = "pending";
    it["title"] = title; it["description"] = description; it["ui"] = ui;
    return it;
  };
  const mkStep = (id: string, title: string, desc: string, fieldNames: string[]): UTSJSONObject => {
    const s = new UTSJSONObject();
    s["id"] = id; s["title"] = title; s["description"] = desc;
    s["fields"] = fieldNames; // steps.fields 是 string[]（字段名列表）
    return s;
  };
  // acp option
  const acpOpt = (optionId: string, kind: string, name: string): UTSJSONObject => {
    const o = new UTSJSONObject(); o["optionId"] = optionId; o["kind"] = kind; o["name"] = name; return o;
  };
  // acp interaction
  const mkAcp = (options: UTSJSONObject[], toolCallTitle: string): UTSJSONObject => {
    const toolCall = new UTSJSONObject();
    toolCall["toolCallId"] = "tc-demo"; toolCall["title"] = toolCallTitle; toolCall["kind"] = "execute";
    const request = new UTSJSONObject();
    request["sessionId"] = "sess-demo"; request["toolCall"] = toolCall; request["options"] = options;
    const it = new UTSJSONObject();
    it["responseStatus"] = "pending"; it["request"] = request;
    return it;
  };

  // ---------- 场景 1：综合字段（全 widget） ----------
  const fText = mkField("name", "text", "姓名", "string", []);
  const fTextarea = mkField("bio", "textarea", "个人简介", "string", []);
  const fNumberInt = mkField("age", "number", "年龄（整数）", "integer", []);
  const fNumberFloat = mkField("score", "number", "评分（小数）", "number", []);
  const fRadio = mkField("favorite_language", "radio", "最喜欢的编程语言", "string", [
    opt("ts", "TypeScript"), opt("go", "Go"), opt("kt", "Kotlin"), opt("py", "Python"),
  ]);
  const fSelect = mkField("level", "select", "职级", "string", [
    opt("junior", "初级"), opt("mid", "中级"), opt("senior", "高级"),
  ]);
  const fList = mkField("framework", "list", "前端框架", "string", [
    opt("react", "React"), opt("vue", "Vue"), opt("angular", "Angular"),
    opt("svelte", "Svelte"), opt("solid", "SolidJS"), opt("astro", "Astro"),
  ]);
  const fCheckboxes = mkField("interests", "checkboxes", "兴趣爱好", "array", [
    opt("music", "音乐"), opt("code", "编码"), opt("sport", "运动"), opt("read", "阅读"),
  ]);
  // radio-with-custom：带「其它」自定义输入
  const fRadioCustom = mkField("topic", "radio-with-custom", "咨询主题（可选其它）", "string", [
    opt("sales", "售前咨询"), opt("tech", "技术支持"), opt("billing", "账单问题"),
  ]);
  fRadioCustom["otherValue"] = "__other__";
  fRadioCustom["otherField"] = "topic_other";
  const askComprehensive = mkAsk("ask-comprehensive", "综合字段测试", "覆盖 text/textarea/number/radio/select/list/checkboxes/radio-with-custom。", [
    fText, fTextarea, fNumberInt, fNumberFloat, fRadio, fSelect, fList, fCheckboxes, fRadioCustom,
  ]);

  // ---------- 场景 2：Wizard 多步表单 ----------
  const wProjectName = mkField("projectName", "text", "项目名称", "string", []);
  const wDescription = mkField("description", "textarea", "项目描述", "string", []);
  const wFramework = mkField("framework", "list", "前端框架", "string", [
    opt("react", "React"), opt("vue", "Vue"), opt("angular", "Angular"), opt("svelte", "Svelte"),
  ]);
  const wFeatures = mkField("features", "checkboxes", "功能模块", "array", [
    opt("auth", "用户认证"), opt("api", "API 接口"), opt("database", "数据库"), opt("testing", "自动化测试"), opt("ci", "CI/CD"),
  ]);
  const wDeploy = mkField("deployTarget", "list", "部署目标", "string", [
    opt("vercel", "Vercel"), opt("netlify", "Netlify"), opt("docker", "Docker"), opt("aws", "AWS"),
  ]);
  const wNotes = mkField("notes", "textarea", "备注", "string", []);
  const askWizard = mkAskWizard("ask-wizard", "项目初始化向导", "请按步骤填写项目配置信息。", [
    wProjectName, wDescription, wFramework, wFeatures, wDeploy, wNotes,
  ], [
    mkStep("basic", "基本信息", "填写项目名称和描述", ["projectName", "description"]),
    mkStep("tech", "技术选型", "选择框架和功能模块", ["framework", "features"]),
    mkStep("deploy", "部署配置", "选择部署目标和备注", ["deployTarget", "notes"]),
  ]);

  // ---------- 场景 3：文件上传（file widget：图片 + 多文件） ----------
  const fDesc = mkField("description", "textarea", "问题描述", "string", []);
  const fScreenshot = mkField("screenshot", "file", "截图（图片）", "string", []);
  fScreenshot["accept"] = "image/*";
  const fAttachments = mkField("attachments", "file", "相关附件（多文件）", "string", []);
  fAttachments["accept"] = "image/*";
  fAttachments["multiple"] = true;
  const askFile = mkAsk("ask-file", "文件上传测试", "file widget：图片上传 + 多文件附件。", [fDesc, fScreenshot, fAttachments]);

  // ---------- ACP 场景 ----------
  const acpFull = mkAcp([
    acpOpt("opt-1", "allow_once", "允许一次"),
    acpOpt("opt-2", "allow_always", "始终允许"),
    acpOpt("opt-3", "reject_once", "拒绝一次"),
  ], "执行 bash 命令: npm install");
  const acpFileEdit = mkAcp([
    acpOpt("opt-a", "allow_once", "允许一次"),
    acpOpt("opt-r", "reject_once", "拒绝"),
  ], "编辑文件 src/utils/upload.ts");

  // ---------- 渲染列表 ----------
  const askInteractions = ref<UTSJSONObject[]>([askComprehensive, askWizard, askFile]);
  const askTitles = ["综合字段（全 widget）", "Wizard 多步表单", "文件上传（file）"];
  const acpInteractions = ref<UTSJSONObject[]>([acpFull, acpFileEdit]);
  const acpTitles = ["完整选项（允许/拒绝）", "文件编辑（2 选项）"];

  const onRespond = (resp: any) => {
    console.log("[test-intervention] respond:", JSON.stringify(resp));
    uni.showToast({ title: "已响应（看控制台）", icon: "none" });
  };
</script>

<style lang="scss" scoped>
  .ti-page {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: #f5f5f5;
  }
  .ti-header {
    padding: 24rpx;
    background-color: #ffffff;
    border-bottom: 2rpx solid #eee;
  }
  .ti-title {
    font-size: 34rpx;
    font-weight: 600;
    color: #333;
  }
  .ti-sub {
    font-size: 22rpx;
    color: #999;
    margin-top: 8rpx;
  }
  .ti-scroll {
    flex: 1;
  }
  .ti-section {
    margin: 24rpx;
    padding: 24rpx;
    background-color: #ffffff;
    border-radius: 16rpx;
    border: 2rpx solid #eee;
  }
  .ti-section-title {
    font-size: 26rpx;
    color: #0066cc;
    margin-bottom: 16rpx;
  }
  .ti-footer-gap {
    height: 60rpx;
  }
</style>
