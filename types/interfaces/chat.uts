import { Ref } from "vue";
import { AgentSelectedComponentInfo } from "./agent";
import type { UploadFileInfo } from "./common";

/** 聊天消息角色 */
export type ChatMessageRole = 'user' | 'assistant' | 'system'

/** 聊天消息状态 */
export type ChatMessageStatus = 'sending' | 'sent' | 'error' | 'processing'

/**
 * 聊天消息类型
 * UTS: 使用 class，interface 对象字面量初始化会报 UTS110111163
 */
export class ChatMessage {
  id: string = ''
  role: ChatMessageRole = 'user'
  content: string = ''
  timestamp: number = 0
  status: ChatMessageStatus = 'sending'
  error?: string
  markdownContent?: string
  rendered?: boolean
}

// 聊天会话类型
export interface ChatSession {
  id: string
  title: string
  messages: ChatMessage[]
  createdAt: number
  updatedAt: number
  isActive: boolean
}

// 流式响应块类型
export class StreamChunk {
  type: 'content' | 'error' | 'done' = 'content'
  data: string = ''
  messageId?: string
}

// Markdown元素类型
export interface MarkdownElement {
  type: 'text' | 'code' | 'table' | 'list' | 'heading' | 'paragraph' | 'link' | 'image' | 'hr' | 'blockquote'
  content: string
  language?: string
  level?: number
  href?: string
  alt?: string
  children?: MarkdownElement[]
  className?: string
}

// 流式请求配置
export class StreamRequestConfig {
  url: string = ''
  method: 'GET' | 'POST' = 'POST'
  headers?: UTSJSONObject | null = null
  body?: any = null
  onChunk?: (chunk: StreamChunk) => void
  onError?: (error: any) => void
  onComplete?: () => void
  onOpen?: (response: any) => void
  onTimeout?: () => void // 超时回调（微信小程序专用，60秒内无数据流动时触发）
}

// 消息渲染状态
export interface MessageRenderState {
  isRendering: boolean
  rendered: boolean
  markdownElements: MarkdownElement[]
  error?: string
}

// 定义 chat-input-phone 组件的引用类型
export interface ChatInputPhoneRef {
  files: Ref<UploadFileInfo[]>;
  selectedComponents: Ref<AgentSelectedComponentInfo[]>;
}

/** chat-input-phone 发送消息事件数据 */
export class ChatSendMessageData {
  messageInfo: string = "";
  files: UploadFileInfo[] = [];
  selectedComponents: AgentSelectedComponentInfo[] = [];
  skillIds: number[] = [];
  /** 本轮消息是否由语音输入产生（用于语音轮次自动播报判定） */
  voiceInput: boolean = false;

  constructor() {
  }
}