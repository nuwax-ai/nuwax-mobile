<template>
  <!-- 禁言常驻提示条：位于输入坞上方（对齐 PC ChatWindow 的 MutedTipLine）。
       未禁言时整条不渲染（不做"空白占位条"——那会在输入区顶上留一条有内边距的
       空白，既占位又看着像加载中）。 -->
  <view v-if="tipText.length > 0" class="cmt">
    <text class="cmt__text">{{ tipText }}</text>
  </view>
</template>

<script lang="uts" setup>
  import { computed, onMounted, onUnmounted, ref } from "vue";
  import {
    chatMuteConvId,
    chatMuteKindOf,
    chatMuteTipText,
    CHAT_MUTE_SELF,
  } from "@/utils/im/chatMuteState";

  /**
   * 群禁言提示条（「你已被禁言，X 后自动解除」/「群主已开启全员禁言，你暂时无法发言」）。
   *
   * <h2>★为什么是零 prop 零事件的独立组件</h2>
   * <ol>
   *   <li>chat.uvue 的渲染 lambda 捕获参数已顶到 255 硬限（多一个就 R8 桩超限 →
   *       Android {@code VerifyError} → 整页加载失败），挂一个带绑定的组件等于
   *       往那 255 里再塞参数；</li>
   *   <li>更关键的是**重渲范围**：这条提示里有一个每秒都在变的量（还剩几分几秒）。
   *       放进聊天页就是每秒重渲一整个会话窗口（几千行 + 消息列表），而且会干扰
   *       滚动锚定那套（贴底探测 / prepend 补偿）的稳定性。抽成叶子组件后，
   *       每秒的跳动被关在这一行字的范围内（PC 同款裁定，见其 MutedTipLine 注释）。</li>
   * </ol>
   * 数据从模块级 store 现取（{@code utils/im/chatMuteState}），页面侧只负责写入快照。
   *
   * <h2>★定时器的三条纪律</h2>
   * <ul>
   *   <li><b>只在「我被单独禁言」时每秒写</b>：全员禁言的文案是静态的（只能等群主关），
   *       给它 tick 等于让群里每个人每秒白渲一次；</li>
   *   <li><b>到期那一拍要把时间推过 until</b>：否则文案停在"1 秒后自动解除"再也不更新
   *       —— 用实时 {@code Date.now()} 判断"还锁着吗"，判一次就够；</li>
   *   <li><b>卸载必须停</b>：模块级 store 的引用不会随页面消失，定时器不停就是
   *       每个退出的聊天页留一个每秒空转的计时器。</li>
   * </ul>
   */
  const now = ref<number>(Date.now());

  const tipText = computed((): string => chatMuteTipText(chatMuteConvId.value, now.value));

  let timer: number | null = null;

  function tick(): void {
    const live = Date.now();
    // 已到期：下面两个判断都为 false ⇒ 不再写 now（文案随上一次写入清空，组件隐藏）
    const stillMutedNow = chatMuteKindOf(chatMuteConvId.value, live) == CHAT_MUTE_SELF;
    // ★还判一次"旧 now 视角"：到期那一拍 live 已经过去，但 now 还停在禁言期内，
    //   必须推一次才能让 computed 收缩成空串；之后两边都是 none，自然停下。
    const stillMutedBefore = chatMuteKindOf(chatMuteConvId.value, now.value) == CHAT_MUTE_SELF;
    if (stillMutedNow || stillMutedBefore) {
      now.value = live;
    }
  }

  onMounted((): void => {
    timer = setInterval((): void => {
      tick();
    }, 1000);
  });

  onUnmounted((): void => {
    const t = timer;
    if (t != null) {
      clearInterval(t);
      timer = null;
    }
  });

  // ★组件挂载时若已经处于禁言中（从子页返回后才被禁言等），now 已是当前时刻，
  //   computed 首帧就能算出文案；无需额外初始化。
</script>

<style lang="scss" scoped>
  /* 配色对齐 PC 的 .composer-locked-tip（#646a73 字 / 12px / 4px 圆角 / 灰底）：
     它不是报错，是"现在不能发"，做成红色会让人以为系统坏了、去点重试。
     ★底色改白（PC 那边 composer 是白底、提示条是 #f2f3f5；本页输入坞外层本身就是
       #f2f3f5，照抄会整块看不见）——在灰底上白条反而更接近 PC 的对比关系。
     不做 hover / transition：它没有任何交互，有反馈反而像能点。 */
  .cmt {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin: 6px 12px;
    padding: 6px 10px;
    border-radius: 6px;
    background-color: #ffffff;
  }

  .cmt__text {
    font-size: 12px;
    line-height: 17px;
    color: #646a73;
  }
</style>
