/**
 * markdown-custom-process 标签解析（引号感知）。
 * name 常含 shell 重定向 `>` 或整段 HTML，禁止用 [^>]* 截属性。
 */

export class MarkdownCustomProcessTagMatch {
  /** 是否命中 */
  found: boolean = false;
  /** 完整匹配起点（含可选 div/p 包裹） */
  index: number = 0;
  /** 完整匹配终点（不含） */
  endIndex: number = 0;
  /** 仅过程标签（不含外层 div/p） */
  tagMatch: string = "";
  /** 含可选包裹的完整片段 */
  fullMatch: string = "";
  /** 开标签属性串 */
  attributes: string = "";
  executeId: string = "";
  type: string = "";
  status: string = "";
  name: string = "";
}

/**
 * 从属性串读取指定属性（支持双/单引号；&quot; 还原为 "）。
 */
export function extractMarkdownCustomProcessAttribute(
  attributes: string,
  name: string,
): string {
  if (attributes.length == 0 || name.length == 0) {
    return "";
  }
  let regex = new RegExp(`${name}="([^"]*)"`, "i");
  let match = attributes.match(regex);
  if (match != null && match.length > 1) {
    const value = match[1];
    return value != null ? value.replace(/&quot;/g, '"') : "";
  }
  regex = new RegExp(`${name}='([^']*)'`, "i");
  match = attributes.match(regex);
  if (match != null && match.length > 1) {
    const value = match[1];
    return value != null ? value.replace(/&quot;/g, '"') : "";
  }
  return "";
}

function fillTagAttrs(item: MarkdownCustomProcessTagMatch): void {
  let executeId = extractMarkdownCustomProcessAttribute(
    item.attributes,
    "executeId",
  );
  if (executeId.length == 0) {
    executeId = extractMarkdownCustomProcessAttribute(
      item.attributes,
      "executeid",
    );
  }
  item.executeId = executeId;
  item.type = extractMarkdownCustomProcessAttribute(item.attributes, "type");
  item.status = extractMarkdownCustomProcessAttribute(item.attributes, "status");
  item.name = extractMarkdownCustomProcessAttribute(item.attributes, "name");
}

/**
 * 引号感知扫描开标签结束位置（指向 '>' 之后）；失败返回 -1。
 * openStart 须指向 '<'。
 */
function scanOpenTagEnd(text: string, openStart: number): number {
  const marker = "<markdown-custom-process";
  if (text.substring(openStart, openStart + marker.length) != marker) {
    return -1;
  }
  let i = openStart + marker.length;
  // 排除 -group
  if (text.substring(i, i + 6) == "-group") {
    return -1;
  }
  let quote = "";
  while (i < text.length) {
    const ch = text.charAt(i);
    if (quote.length > 0) {
      if (ch == quote) {
        quote = "";
      }
      i++;
      continue;
    }
    if (ch == '"' || ch == "'") {
      quote = ch;
      i++;
      continue;
    }
    if (ch == ">") {
      return i + 1;
    }
    i++;
  }
  return -1;
}

function isSelfClosingOpen(text: string, openStart: number, openEnd: number): boolean {
  // openEnd 指向 '>' 之后；检测 "/>"
  if (openEnd < openStart + 2) {
    return false;
  }
  return text.charAt(openEnd - 2) == "/";
}

function isHtmlSpace(ch: string): boolean {
  return ch == " " || ch == "\n" || ch == "\r" || ch == "\t";
}

/**
 * 若过程标签外包了 <div>/<p>，扩展匹配范围；仅开标签匹配时才吃闭合标签。
 */
function expandDivOrPWrapper(
  text: string,
  tagStart: number,
  tagEnd: number,
): number[] {
  let start = tagStart;
  let end = tagEnd;
  let j = tagStart;
  while (j > 0 && isHtmlSpace(text.charAt(j - 1))) {
    j--;
  }
  if (j > 0 && text.charAt(j - 1) == ">") {
    let k = j - 1;
    const minK = tagStart - 256 > 0 ? tagStart - 256 : 0;
    while (k >= minK) {
      if (text.charAt(k) == "<") {
        const open = text.substring(k, j);
        if (/^<(?:div|p)\b[^>]*>$/i.test(open)) {
          start = k;
        }
        break;
      }
      k--;
    }
  }
  if (start < tagStart) {
    let p = tagEnd;
    while (p < text.length && isHtmlSpace(text.charAt(p))) {
      p++;
    }
    const lower = text.substring(p, p + 6).toLowerCase();
    if (lower == "</div>") {
      end = p + 6;
    } else if (text.substring(p, p + 4).toLowerCase() == "</p>") {
      end = p + 4;
    }
  }
  const range: number[] = [];
  range.push(start);
  range.push(end);
  return range;
}

/**
 * 从 from 起查找下一个 markdown-custom-process（非 group），引号感知。
 */
export function findNextMarkdownCustomProcessTag(
  text: string,
  from: number = 0,
): MarkdownCustomProcessTagMatch {
  const result = new MarkdownCustomProcessTagMatch();
  if (text.length == 0 || from >= text.length) {
    return result;
  }
  const marker = "<markdown-custom-process";
  let search = from > 0 ? from : 0;
  while (search < text.length) {
    const idx = text.indexOf(marker, search);
    if (idx < 0) {
      return result;
    }
    const afterName = idx + marker.length;
    if (text.substring(afterName, afterName + 6) == "-group") {
      search = afterName;
      continue;
    }
    const openEnd = scanOpenTagEnd(text, idx);
    if (openEnd < 0) {
      search = afterName;
      continue;
    }
    let tagEnd = openEnd;
    if (!isSelfClosingOpen(text, idx, openEnd)) {
      const closeMarker = "</markdown-custom-process>";
      const closeIdx = text.indexOf(closeMarker, openEnd);
      if (closeIdx >= 0) {
        tagEnd = closeIdx + closeMarker.length;
      }
    }
    let attrEnd = openEnd - 1;
    if (isSelfClosingOpen(text, idx, openEnd)) {
      attrEnd = openEnd - 2;
    }
    const attributes = text.substring(afterName, attrEnd);
    const tagMatch = text.substring(idx, tagEnd);
    const range = expandDivOrPWrapper(text, idx, tagEnd);
    const fullStart = range[0];
    const fullEnd = range[1];

    result.found = true;
    result.index = fullStart;
    result.endIndex = fullEnd;
    result.tagMatch = tagMatch;
    result.fullMatch = text.substring(fullStart, fullEnd);
    result.attributes = attributes;
    fillTagAttrs(result);
    return result;
  }
  return result;
}

/**
 * 列举文本中全部过程标签（按出现顺序）。
 */
export function listMarkdownCustomProcessTags(
  text: string,
): MarkdownCustomProcessTagMatch[] {
  const list: MarkdownCustomProcessTagMatch[] = [];
  let from = 0;
  while (from < text.length) {
    const item = findNextMarkdownCustomProcessTag(text, from);
    if (item.found != true) {
      break;
    }
    list.push(item);
    from = item.endIndex > from ? item.endIndex : from + 1;
  }
  return list;
}

/**
 * 规范化为当前渲染链路可识别的 HTML 标签（name 内 " 转 &quot;）。
 */
export function toMarkdownCustomProcessHtml(
  executeId: string,
  type: string,
  status: string,
  name: string,
): string {
  const safeName = name.replace(/"/g, "&quot;");
  const safeType = type.replace(/"/g, "&quot;");
  const safeStatus = status.replace(/"/g, "&quot;");
  return `<markdown-custom-process executeid="${executeId}" type="${safeType}" status="${safeStatus}" name="${safeName}"></markdown-custom-process>`;
}

/**
 * 查找 :::container ...\\n:::（属性可跨多行，直到独立行 :::）。
 */
export class MarkdownContainerFenceMatch {
  found: boolean = false;
  index: number = 0;
  endIndex: number = 0;
  fullMatch: string = "";
  attributes: string = "";
  executeId: string = "";
  type: string = "";
  status: string = "";
  name: string = "";
}

export function findNextMarkdownContainerFence(
  text: string,
  from: number = 0,
): MarkdownContainerFenceMatch {
  const result = new MarkdownContainerFenceMatch();
  const marker = ":::container";
  let search = from > 0 ? from : 0;
  while (search < text.length) {
    const idx = text.indexOf(marker, search);
    if (idx < 0) {
      return result;
    }
    const after = idx + marker.length;
    // 避免误伤其它 ::: 语法：container 后应为空白或属性
    if (after < text.length) {
      const next = text.charAt(after);
      if (next != " " && next != "\t" && next != "\n" && next != "\r") {
        search = after;
        continue;
      }
    }
    const closeIdx = text.indexOf("\n:::", after);
    if (closeIdx < 0) {
      search = after;
      continue;
    }
    const endIndex = closeIdx + "\n:::".length;
    const attributes = text.substring(after, closeIdx).trim();
    result.found = true;
    result.index = idx;
    result.endIndex = endIndex;
    result.fullMatch = text.substring(idx, endIndex);
    result.attributes = attributes;
    result.executeId = extractMarkdownCustomProcessAttribute(
      attributes,
      "executeId",
    );
    if (result.executeId.length == 0) {
      result.executeId = extractMarkdownCustomProcessAttribute(
        attributes,
        "executeid",
      );
    }
    result.type = extractMarkdownCustomProcessAttribute(attributes, "type");
    result.status = extractMarkdownCustomProcessAttribute(attributes, "status");
    result.name = extractMarkdownCustomProcessAttribute(attributes, "name");
    return result;
  }
  return result;
}
