/** 克隆 MessageInfo 为可编辑 draft（Android：JSON.stringify(class) 会丢 text 等字段） */
function cloneMessageInfoDraft(base: MessageInfo): UTSJSONObject {
  return messageToJsonObject(base);
}

function readMessageText(msg: MessageInfo | null): string {
  if (msg == null) {
    return "";
  }
  const raw = readRawField(msg, "text");
  return raw != null ? `${raw}` : "";
}

function readMessageThink(msg: MessageInfo | null): string {
  if (msg == null) {
    return "";
  }
  const raw = readRawField(msg, "think");
  return raw != null ? `${raw}` : "";
}

/** 将编辑后的 draft 转为 MessageInfo 实例 */
function buildMessageInfoFromDraft(draft: UTSJSONObject): MessageInfo | null {
  return createMessageInfoFromAny(draft);
}

function findMessageIndexById(
  list: MessageInfo[],
  primaryId: string,
  fallbackId: string | null = null,
): number {
  const tryMatch = (target: string): number => {
    if (target.length == 0) {
      return -1;
    }
    for (let i = 0; i < list.length; i++) {
      const rawId = readRawField(list[i], "id");
      const itemId = rawId != null ? `${rawId}` : "";
      if (itemId == target) {
        return i;
      }
    }
    return -1;
  };

  let idx = tryMatch(primaryId);
  if (idx >= 0) {
    return idx;
  }
  if (fallbackId != null && fallbackId.length > 0) {
    idx = tryMatch(fallbackId);
  }
  return idx;
}

/** Android：UTSJSONObject 禁止 as ConversationChatSuggestParams，通过 class 构造 */
class _ConversationChatSuggestParams implements ConversationChatSuggestParams {
  conversationId: number = 0;
  variableParams?: StringAnyRecord;
  message: string = "";
  attachments: AttachmentFile[] = [];
  debug: boolean = false;
  selectedComponents: AgentSelectedComponentInfo[] = [];
  sandboxId?: string;
  skillIds?: number[];
  agentMode?: "ask" | "yolo";

  constructor(raw: any | null) {
    if (raw == null) {
      return;
    }
    const convIdRaw = readRawField(raw, "conversationId");
    if (convIdRaw != null) {
      const n = parseFloat(`${convIdRaw}`);
      this.conversationId = n != n ? 0 : n;
    }
    const messageRaw = readRawField(raw, "message");
    this.message = messageRaw != null ? `${messageRaw}` : "";
    const debugRaw = readRawField(raw, "debug");
    this.debug = debugRaw == true;
    const attachmentsRaw = readRawField(raw, "attachments");
    if (attachmentsRaw != null) {
      this.attachments = attachmentsRaw as AttachmentFile[];
    }
    const selectedRaw = readRawField(raw, "selectedComponents");
    if (selectedRaw != null) {
      this.selectedComponents = selectedRaw as AgentSelectedComponentInfo[];
    }
    const variableRaw = readRawField(raw, "variableParams");
    if (variableRaw != null) {
      // Android：UTSReactiveJSONObject / UTSJSONObject 禁止 as StringAnyRecord(Map)
      this.variableParams = AgentDetailUtils.utsObjToRecord(
        variableRaw as UTSJSONObject,
      );
    }
    const sandboxRaw = readRawField(raw, "sandboxId");
    if (sandboxRaw != null) {
      this.sandboxId = `${sandboxRaw}`;
    }
    const skillIdsRaw = readRawField(raw, "skillIds");
    if (skillIdsRaw != null) {
      this.skillIds = skillIdsRaw as number[];
    }
    const agentModeRaw = readRawField(raw, "agentMode");
    if (agentModeRaw === "ask" || agentModeRaw === "yolo") {
      this.agentMode = `${agentModeRaw}`;
    }
  }
}

function buildConversationChatSuggestParams(raw: any): ConversationChatSuggestParams {
  return new _ConversationChatSuggestParams(raw);
}

function isStreamTerminalSsePayload(resObj: any): boolean {
  const completedRaw = readRawField(resObj, "completed");
  if (completedRaw == true) {
    return true;
  }
  const completedStr = completedRaw != null ? `${completedRaw}` : "";
  return completedStr == "true" || completedStr == "1";
}

/** 无 data 时可静默忽略的 SSE 包（心跳 / 完成标记等） */
function shouldSkipSsePayloadWithoutData(resObj: any): boolean {
  const eventTypeRaw = readRawField(resObj, "eventType");
  const eventTypeStr = eventTypeRaw != null ? `${eventTypeRaw}` : "";
  if (eventTypeStr == "HEART_BEAT") {
    return true;
  }
  return isStreamTerminalSsePayload(resObj);
}

