<template>
  <!-- 中转启动页：不渲染任何业务内容，视觉上与 splash / 登录页同为白底，无可见跳变 -->
  <view class="launch-page">
    <!-- 首启协议弹窗：未同意前不创建登录页/首页，只此一张卡片。
         此时系统「允许发送通知」弹窗（鸿蒙由 uni-push SDK 在启动时弹出）会盖在本卡片之上，
         用户先处理系统弹窗、再处理本弹窗——与市面主流 App 的首启顺序一致。 -->
    <view v-if="showAgreement" class="agreement-mask">
      <view class="agreement-card">
        <view class="agreement-inner">
          <text class="agreement-title">{{ t("Mobile.Auth.firstLaunchTitle") }}</text>
          <!-- App 端约束：协议片段不可嵌进父 text（text 内嵌 text 渲染为 span，border 不渲染），
               下划线用绝对定位 view 覆盖，零占位不影响基线（同 agreement-checkbox） -->
          <!-- 正文分两行：引导句一段、链接一段。不能用 wrap 拼一整段——
               App 端每段是独立 text，换行按段边界断开，段首标点（、，）会掉到行首。 -->
          <view class="agreement-body">
            <text class="body-text">{{ t("Mobile.Auth.firstLaunchPrefix") }}</text>
            <view class="link-row">
              <view class="link-wrap">
                <text class="link" @click="openServiceAgreement">{{ t("Mobile.Auth.serviceAgreement") }}</text>
                <view class="link-underline" />
              </view>
              <text class="link-sep">{{ t("Mobile.Auth.agreementSeparator") }}</text>
              <view class="link-wrap">
                <text class="link" @click="openPrivacyAgreement">{{ t("Mobile.Auth.privacyAgreement") }}</text>
                <view class="link-underline" />
              </view>
            </view>
          </view>
          <view class="agree-btn" @click="onAgree">
            <text class="agree-btn-text">{{ t("Mobile.Auth.firstLaunchAgree") }}</text>
          </view>
          <view class="reject-btn" @click="onReject">
            <text class="reject-btn-text">{{ t("Mobile.Auth.firstLaunchReject") }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { switchMainTab } from "@/utils/mainTabNavigation";
  import { ref } from "vue";

  import { onReady, onUnload } from "@dcloudio/uni-app";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import {
    hasAcceptedFirstLaunchAgreement,
    markFirstLaunchAgreementAccepted,
  } from "@/utils/firstLaunchAgreement";
  import { handleExternalLink } from "@/utils/system";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  import { hasPushClickSinceLaunch, requestImNotifyPermission } from "@/utils/im/imPushClient";
  // #endif

  /**
   * App（Android / iOS / 鸿蒙）冷启动分流页，pages.json 中以 `#ifdef APP` 置于首位。
   *
   * 为什么需要它：uni-app x 的启动页在 App.onLaunch 之后仍会被创建并渲染，
   * 在 onLaunch 里 reLaunch 登录页只能“先进首页再跳登录页”——首页会闪一下，
   * 且首页挂载即发起的接口随后返回 4010，会再次踢登录页，把登录页重建一遍。
   * 因此把启动页换成这个空白中转页：未登录直接进登录页，首页根本不会被创建。
   *
   * ★首启协议（2026-10-30）：首次安装启动先弹协议卡片，同意才分流、不同意退出。
   *   同意状态由 utils/firstLaunchAgreement 持久化，之后启动直接走分流。
   *   **iOS 例外**：不弹协议卡片，直接走分流（见 shouldSkipAgreementGate）；
   *   Android / 鸿蒙保持原行为。
   *
   * 依赖保持最小（只引分流/协议/i18n），避免为分流拉起整条请求链拖慢冷启动。
   * H5 / 小程序不走本页（条件编译已排除），其登录态由各自路由与拦截逻辑处理。
   */
  const HOME_PAGE_PATH = "/pages/message/message";
  const LOGIN_PAGE_PATH = "/subpackages/pages/login/login";

  const _params = emptyI18nParams();
  const t = (key: string): string => translateFn(key, _params, "");

  /** 首启协议卡片是否展示（本版本已同意过的用户恒 false，页面保持空白中转）。 */
  const showAgreement = ref(false);
  /** 推送点击兜底检查的定时器（0 = 无在途）。 */
  let pushClickGuardTimer = 0;

  function clearPushClickGuard(): void {
    if (pushClickGuardTimer != 0) {
      clearTimeout(pushClickGuardTimer);
      pushClickGuardTimer = 0;
    }
  }

  /**
   * 本平台是否跳过首启协议闸门。
   *
   * ★仅 iOS（2026-10-30 产品决定）：iPhone 安装后没有出现系统推送授权弹窗，
   *   首启再叠一层协议卡片，等于把「安装后的第一次打开」整个让给自家弹窗，用户既没
   *   同意通知也先看了协议，链路混乱。iOS 端改为直接放行，协议告知靠登录页勾选框。
   * ★Android / 鸿蒙不受影响：未同意仍只显示协议卡片，同意后分流。
   * ★不写「已同意」标记：哪天 iOS 恢复闸门（或用户换机到 Android），照常会弹。
   */
  function shouldSkipAgreementGate(): boolean {
    let skip = false;
    // #ifdef APP-IOS
    skip = true;
    // #endif
    return skip;
  }

  function routeByAuthState(): void {
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    const token = tokenRaw != null ? `${tokenRaw}`.trim() : "";
    if (token.length == 0) {
      uni.reLaunch({ url: LOGIN_PAGE_PATH });
      return;
    }
    // 创建常驻主界面，默认进入伙伴 Tab。
    switchMainTab({ url: HOME_PAGE_PATH });
  }

  function openServiceAgreement(): void {
    handleExternalLink(translateFn("Mobile.Auth.userAgreementLink", _params, ""));
  }

  function openPrivacyAgreement(): void {
    handleExternalLink(translateFn("Mobile.Auth.privacyAgreementLink", _params, ""));
  }

  function onAgree(): void {
    clearPushClickGuard();
    // 先落盘再放行：下次启动不再打扰
    markFirstLaunchAgreementAccepted();
    showAgreement.value = false;
    routeByAuthState();
    // 通知权限：**协议同意后**申请一次（不再放在登录成功后，避免登录完再弹一次打扰）。
    // 鸿蒙首启的系统通知弹窗由 uni-push SDK 在启动时自己弹出（比 JS 更早，端上拦不住），
    // 这里探测到已授权会直接跳过；Android 13+ 才是这一调用真正弹窗的时机；
    // iOS 由 uni-push 模块首帧申请，本函数在 iOS 是空实现。
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    requestImNotifyPermission();
    // #endif
  }

  function onReject(): void {
    clearPushClickGuard();
    // 不同意：不进入应用。
    // #ifdef APP-ANDROID || APP-HARMONY
    uni.exit();
    // #endif
    // #ifdef APP-IOS
    // iOS 禁止应用主动退出（审核会拒），只能提示并保持在协议页
    uni.showToast({ title: t("Mobile.Auth.pleaseAgreeProtocol"), icon: "none" });
    // #endif
  }

  /**
   * 本次启动若是「点通知进来的」，不弹协议卡片，直接分流（卡片会盖在推送跳转上，
   * 用户要先看协议、再被推到会话页 —— 2026-10-30 鸿蒙真机反馈）。
   *
   * ★不在这里记「已同意」：点通知不是用户主动打开 App，不该替用户同意协议。
   *   标记仍留空 ⇒ 下一次用户自己打开时照常弹（升级后的协议告知不会被推送绕过），
   *   而点通知进来这一路完全不打扰。
   * ★只用于首帧阶段（此时推送跳转还没开始，分流不会和它抢页面）。
   *   迟到信号走 dismissAgreementForPushClick()，那里不能再调 routeByAuthState：
   *   推送的 openConvWithRetry 可能已经把会话页压上去了，switchMainTab 会把它顶掉。
   */
  function routeIfLaunchedByPushClick(): boolean {
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    if (hasPushClickSinceLaunch()) {
      showAgreement.value = false;
      routeByAuthState();
      return true;
    }
    // #endif
    return false;
  }

  /**
   * 推送点击信号晚到：只收卡片，导航交给 imPushClient 的 openConvWithRetry（同上，不记已同意）。
   */
  function dismissAgreementForPushClick(): boolean {
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    if (hasPushClickSinceLaunch()) {
      showAgreement.value = false;
      return true;
    }
    // #endif
    return false;
  }

  // 后续若接入推送 / 深链唤起，需在此透传目标路径（登录态满足时直达目标页）
  onReady(() => {
    if (shouldSkipAgreementGate() || hasAcceptedFirstLaunchAgreement()) {
      routeByAuthState();
      return;
    }
    if (routeIfLaunchedByPushClick()) {
      return;
    }
    showAgreement.value = true;
    // 兜底：冷启动点通知时，uni-push 的 click 回调可能晚于首帧才到。
    // 1 秒内到了就把卡片收掉（不额外导航）；正常启动没有 click 信号，卡片留在屏幕上等用户点。
    clearPushClickGuard();
    pushClickGuardTimer = setTimeout(() => {
      pushClickGuardTimer = 0;
      // 用户 1 秒内已点同意/未弹出：什么都不做
      if (!showAgreement.value) return;
      dismissAgreementForPushClick();
    }, 1000);
  });

  onUnload(() => {
    clearPushClickGuard();
  });
</script>

<style lang="scss" scoped>
  .launch-page {
    flex: 1;
    background-color: #ffffff;
  }

  /* 贴底面板而不是居中卡片：鸿蒙的系统通知授权弹窗固定在屏幕正中，
     两者同时出现时居中卡片会被压成一团；贴底后互不干扰，也贴合主流 App 的首启样式。 */
  .agreement-mask {
    flex: 1;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0.45);
  }

  .agreement-card {
    width: 100%;
    background-color: #ffffff;
    border-radius: 16px 16px 0 0;
    flex-direction: column;
    padding-bottom: env(safe-area-inset-bottom);
  }

  .agreement-inner {
    padding: 24px 20px 8px 20px;
    flex-direction: column;
  }

  .agreement-title {
    font-size: 17px;
    font-weight: 600;
    color: #15171f;
    text-align: center;
    margin-bottom: 14px;
  }

  .agreement-body {
    flex-direction: column;
    margin-bottom: 20px;
  }

  .link-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 6px;
  }

  .link-sep {
    font-size: 14px;
    line-height: 22px;
    color: rgba(21, 23, 31, 0.65);
    padding: 0 1px;
  }

  .body-text {
    font-size: 14px;
    line-height: 22px;
    color: rgba(21, 23, 31, 0.65);
  }

  .link-wrap {
    position: relative;
  }

  .link {
    font-size: 14px;
    line-height: 22px;
    font-weight: 500;
    color: #5147ff;
  }

  .link-underline {
    position: absolute;
    left: 0;
    width: 100%;
    bottom: 2px;
    height: 1px;
    background-color: rgba(81, 71, 255, 0.4);
  }

  .agree-btn {
    height: 44px;
    border-radius: 22px;
    background-color: #5147ff;
    align-items: center;
    justify-content: center;
    flex-direction: row;
  }

  .agree-btn-text {
    font-size: 16px;
    font-weight: 500;
    color: #ffffff;
  }

  .reject-btn {
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-direction: row;
    margin-top: 4px;
  }

  .reject-btn-text {
    font-size: 14px;
    color: rgba(21, 23, 31, 0.45);
  }
</style>
