<template>
  <!-- 建议单一根节点：native-view 若有兄弟需包裹（见 DCloud native-view 文档） -->
  <view class="xnm-wrap" :style="wrapStyle">
    <!-- #ifdef APP -->
    <!-- native-view 自身无渲染内容，@init 时绑定平台原生 View（Android=MTMathView）。
         native-view 仅支持排版相关样式（不支持 background/border/box-shadow），android overflow 仅 hidden。 -->
    <native-view class="xnm-native" :style="nativeViewStyle" @init="onViewInit"></native-view>
    <!-- #endif -->
    <!-- #ifndef APP -->
    <!-- 非 APP 平台（H5/MP）降级显示 LaTeX 原文：原生后端仅 App 端，Web 仍走 <x-math> 的 KaTeX 链路 -->
    <text class="xnm-fallback">{{ latex }}</text>
    <!-- #endif -->
  </view>
</template>

<script lang="uts" setup>
// #ifdef APP-ANDROID || APP-IOS
import { NativeMathView } from '@/uni_modules/nuwax-uni-math'
// #endif
import { computed, onUnmounted, watchEffect } from 'vue'

/** Props：latex 必填；displayMode 块级/行内；fontSize px（0=用库默认）；color ARGB int（-1=默认） */
const props = defineProps<{
  latex: string
  displayMode?: boolean
  fontSize?: number
  color?: number
}>()

// #ifdef APP-ANDROID || APP-IOS
let mathView: NativeMathView | null = null
// #endif

/** 块级撑满宽度、行内按内容；高度均由 MTMathView onMeasure 自决定（min-height 兜底防初次塌陷） */
const nativeViewStyle = computed((): string => {
  if (props.displayMode == true) {
    return 'width:100%;min-height:60px;'
  }
  return 'min-height:24px;'
})

const wrapStyle = computed((): string => {
  if (props.displayMode == true) {
    return 'width:100%;'
  }
  return 'flex-direction:row;align-items:center;'
})

/** 把当前 props 全量下发到原生 View（latex / 模式 / 字号 / 颜色）。
 *  注意须声明在 onViewInit / watchEffect 之前——UTS function 不提升，后置会让调用处 Unresolved。*/
function applyProps(): void {
  // #ifdef APP-ANDROID || APP-IOS
  const v = mathView
  if (v == null) {
    return
  }
  v.setLatex(props.latex)
  v.setDisplayMode(props.displayMode ?? false)
  if ((props.fontSize ?? 0) > 0) {
    v.setFontSize(props.fontSize!)
  }
  if ((props.color ?? -1) != -1) {
    v.setTextColor(props.color!)
  }
  // #endif
}

/** native-view 初始化：构造 NativeMathView（内部 new MTMathView 并 bindAndroidView），随后下发 props */
function onViewInit(e: UniNativeViewInitEvent): void {
  // #ifdef APP-ANDROID || APP-IOS
  mathView = new NativeMathView(e.detail.element)
  applyProps()
  // #endif
}

/** latex / displayMode / fontSize / color 任一变化 → 重排（watchEffect 自动依赖收集） */
watchEffect((): void => {
  // 显式读取以稳定依赖收集（applyProps 内部读取在 #ifdef 下，非 APP 平台需此处兜底注册依赖）
  const _latex = props.latex
  const _mode = props.displayMode
  const _size = props.fontSize
  const _color = props.color
  // #ifdef APP-ANDROID || APP-IOS
  if (mathView != null) {
    applyProps()
  }
  // #endif
})

onUnmounted((): void => {
  // #ifdef APP-ANDROID || APP-IOS
  mathView?.destroy()
  mathView = null
  // #endif
})
</script>

<style lang="scss">
.xnm-wrap {
  flex-direction: column;
}
.xnm-native {
  /* native-view 仅支持排版样式；具体宽高在脚本里按 displayMode 动态下发 */
}
.xnm-fallback {
  font-size: 30rpx;
  color: #333;
}
</style>
