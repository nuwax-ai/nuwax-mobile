/**
 * 多人待办完成弹窗的完成方式。
 * scope 为 choice 时，创建人自己也是责任人，可选整体完成或仅自己完成。
 * scope 为 whole 时，创建人不是责任人，只显示整体完成。
 * scope 为空时，弹窗不展示这两种选项。
 */
export class TodoCompleteHint {
  scope: string = "";
  /** 还没完成自己份额的其他责任人，用顿号拼接。 */
  pending: string = "";
}

function readText(obj: UTSJSONObject, key: string): string {
  const raw = obj[key];
  if (raw == null) {
    return "";
  }
  const text = `${raw}`.trim();
  if (text == "null" || text == "undefined") {
    return "";
  }
  return text;
}

function readBool(obj: UTSJSONObject, key: string): boolean {
  const raw = obj[key];
  if (raw == true) {
    return true;
  }
  return raw != null && `${raw}` == "true";
}

function asRecordList(raw: any | null): UTSJSONObject[] {
  const list: UTSJSONObject[] = [];
  if (raw == null) {
    return list;
  }
  try {
    const text = JSON.stringify(raw);
    if (text == null || text.length == 0 || text.charAt(0) != "[") {
      return list;
    }
    const parsed = JSON.parse(text) as UTSJSONObject[] | null;
    if (parsed == null) {
      return list;
    }
    for (let i = 0; i < parsed.length; i++) {
      const row = parsed[i];
      if (row != null) {
        list.push(row);
      }
    }
  } catch (_error) {
    return list;
  }
  return list;
}

function personName(row: UTSJSONObject): string {
  const name = readText(row, "name");
  if (name.length > 0) {
    return name;
  }
  const nick = readText(row, "nickName");
  if (nick.length > 0) {
    return nick;
  }
  return readText(row, "userName");
}

/**
 * 根据创建人和责任人判断完成弹窗该展示哪种完成方式。
 * 只在责任人多于 1 个、且当前用户是创建人时返回 choice 或 whole。
 * @param record 日程详情或列表里的单条记录
 * @param myId 当前用户 ID
 */
export function readTodoCompleteHint(record: UTSJSONObject, myId: string): TodoCompleteHint {
  const hint = new TodoCompleteHint();
  const creatorId = readText(record, "creatorId");
  const creator = myId.length > 0 && creatorId == myId;
  const participants = asRecordList(record["participants"]);
  const seen: string[] = [];
  let assignee = false;
  const pendingNames: string[] = [];
  for (let i = 0; i < participants.length; i++) {
    const row = participants[i];
    const userId = readText(row, "userId");
    if (userId.length == 0) {
      continue;
    }
    let duplicated = false;
    for (let j = 0; j < seen.length; j++) {
      if (seen[j] == userId) {
        duplicated = true;
        break;
      }
    }
    if (duplicated) {
      continue;
    }
    seen.push(userId);
    const mine = myId.length > 0 && userId == myId;
    if (mine) {
      assignee = true;
      continue;
    }
    if (!readBool(row, "completed")) {
      const name = personName(row);
      if (name.length > 0) {
        pendingNames.push(name);
      }
    }
  }
  if (seen.length > 1 && creator) {
    hint.scope = assignee ? "choice" : "whole";
  }
  if (hint.scope.length == 0) {
    return hint;
  }
  let pending = "";
  for (let i = 0; i < pendingNames.length; i++) {
    if (i > 0) {
      pending += "、";
    }
    pending += pendingNames[i];
  }
  hint.pending = pending;
  return hint;
}
