<script lang="uts">
  import { apiAgentComponentPageResultUpdate } from "@/servers/agentDev";
  import {
    initEventPolling,
    startEventPolling,
    stopEventPolling,
  } from "@/hooks/useEventPolling";
  import { loadI18n, t, bootstrapI18nCache } from "@/utils/i18n";
  import { refreshSystemMessageBadge } from "@/utils/notificationBadge";
  import {
    bindImUnreadWsEvents,
    clearImUnreadBadge,
    refreshImUnreadBadge,
  } from "@/utils/imUnreadBadge";
  import { bindImNoticeEvents, clearImNoticeState } from "@/utils/imNoticeBar";
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  import {
    bindImPushClientIfLoggedIn,
    scheduleImPushAfterLogin,
    // 回前台校正推送注册（Android 实作；系统通知权限「关 → 开」后个推通道失效）
    syncImPushOnForeground,
  } from "@/utils/im/imPushClient";
  // #endif
  import {
    initImWsClient,
    reconnectImWsOnForeground,
    pauseImWsKeepalive,
    stopImWsClient,
    unregisterImDeviceSafe,
  } from "@/utils/im/imWsClient";
  import { IM_SESSION_CLEARED, IM_SESSION_READY } from "@/utils/im/imSessionScope";
  import { clearImChatCache } from "@/utils/im/imChatCache";
  import { clearImForwardSession } from "@/utils/im/imForwardSession";
  import eventBus from "@/utils/eventBus";
  import { EVENT_TYPE } from "@/constants/event.constants";
  import { initCmark } from "@/uni_modules/uni-cmark";
  import { setAppInBackground } from "@/utils/appLifecycle.uts";
  import { routeIncomingShare } from "@/utils/appShare";
  import { APP_PRIVACY_GRANTED_EVENT, hasAppPrivacyConsent, prepareAppPrivacyConsent } from "@/utils/appPrivacyConsent";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import { notifyStreamAppForeground } from "@/utils/streamRequest.uts";
  import { clearLoginCheckPending } from "@/utils/profileSetupGate";
  import { primeSafeAreaBottom } from "@/utils/safeAreaBottom.uts";
  import { clearNotificationsOnAppOpen } from "@/utils/notificationClear.uts";
  // 桌面角标：App 前台/退后台生命周期清零；后台收到新推送时重新允许厂商角标落地。
  import { clearAppIconBadge, setAppIconBadgeSuppressed } from "@/utils/appIconBadge.uts";
  // #ifdef H5 || WEB
  import { bootstrapH5AccessTokenFromUrl } from "@/utils/authSession";
  import { isAppWebViewEmbedded, readAppWebViewHostPlatform } from "@/utils/appWebViewDetect";
  // #endif
  // #ifdef APP-IOS || APP-ANDROID
  import { bootstrapAppNativePay } from "@/subpackages/utils/appNativePay.uts";
  // #endif
  // #ifdef APP-ANDROID
  import { registerAndroidEspProvisioningProvider } from "@/utils/provisioning/androidEspProvisioningClient.uts";
  // #endif
  // #ifdef APP-IOS
  import { registerIosEspProvisioningProvider } from "@/utils/provisioning/iosEspProvisioningClient.uts";
  // #endif
  // #ifdef APP-HARMONY
  import { registerHarmonyEspProvisioningProvider } from "@/utils/provisioning/harmonyEspProvisioningClient.uts";
  // #endif
  // #ifdef MP-WEIXIN
  import { htmlToMarkdown } from "@/utils/htmlToMarkdown";
  // #endif

  // #ifdef H5
  let stableViewportWidth = 0;
  function fix100vh() {
    // 检测输入焦点；会话富文本 editor 的实际焦点是 contenteditable 元素。
    const focusedElement = document.activeElement;
    const isInputFocused =
      focusedElement &&
      (focusedElement.tagName === "TEXTAREA" ||
        focusedElement.tagName === "INPUT" ||
        focusedElement.getAttribute("contenteditable") === "true");

    // 如果有输入框聚焦（键盘弹起），不更新 --vh 变量，保持页面容器高度稳定
    // 这样可以防止输入框因页面高度变化而"飘起"
    if (isInputFocused) {
      return;
    }

    // 取 layout 视口（innerHeight）与视觉视口的较小值，且不四舍五入：
    // 键盘收起 / WebView 布局过渡期 visualViewport 可能短暂偏高，Math.round 放大后
    // 会让 --vh 大于实际可见高度 → 文档层多出几像素可滚动余量（配合聊天页文档滚动锁，
    // 余量虽不会再被滚动，但会把底部输入框向下裁切掉几像素）。
    let vh = window.innerHeight;
    // iOS WKWebView 冷启动阶段 visualViewport getter 可能在连续读取间短暂返回 undefined；
    // 固定本次快照，避免第二次取值时报 Cannot read properties of undefined (reading 'height')。
    const visualViewport = window.visualViewport;
    if (visualViewport != null && visualViewport.height > 0) {
      const visualH = Math.min(vh, visualViewport.height);
      if (visualH > 0) {
        vh = visualH;
      }
    }
    // iOS WebView 的视觉视口可能先于 focus 事件随键盘缩短。
    // 同一屏幕方向下保留已测量的页面高度，避免会话根容器先塌陷再被键盘占位撑回。
    if (isAppWebViewEmbedded() && readAppWebViewHostPlatform() == "ios" &&
        document.getElementById("chat-input-editor") != null) {
      const width = window.innerWidth;
      const previous = parseFloat(document.documentElement.style.getPropertyValue("--vh"));
      if (stableViewportWidth == width && !isNaN(previous) && vh < previous) {
        return;
      }
    }
    stableViewportWidth = window.innerWidth;
    document.documentElement.style.setProperty("--vh", `${vh}px`);
  }
  fix100vh();
  window.addEventListener("resize", fix100vh);
  window.addEventListener("orientationchange", fix100vh);
  // 解决iOS键盘问题的代码 使用Visual Viewport API
  const visualViewport = window.visualViewport;
  if (visualViewport != null) {
    visualViewport.addEventListener("resize", fix100vh);
  }
  // #endif

  // #ifdef APP-ANDROID || APP-HARMONY
  let firstBackTime = 0;
  // #endif
  // #ifdef APP
  let appShareColdStart = true;
  // #endif
  let applicationInitialized = false;
  function initializeApplication(): void {
    if (applicationInitialized || !hasAppPrivacyConsent()) return;
    applicationInitialized = true;
  // 打开 App 清空通知栏里的推送通知（Android 首启协议弹窗期间 onShow 已提前返回，
  // 同意后不会再触发第二次 onShow，这里补一次；见 utils/notificationClear.uts）
  clearNotificationsOnAppOpen();
  // 冷启动一律清「待做新用户引导判定」标记：只有登录页真实调登录接口（saveAccessToken
  // 写新 token）才重新置位——保证杀 App 重开（持久登录态）不再弹引导（utils/profileSetupGate.uts）
  clearLoginCheckPending();
  // 底部安全区预热（见 utils/safeAreaBottom.uts）：鸿蒙页面 setup 阶段两种口径都可能
  // 取不到底部 insets，页面首帧会按 0 垫底、下一拍才校正。启动后取到的第一个真值先记下来，
  // 后续页面 setup 期直接命中；首帧可能仍未就绪，补两拍重试。
  // 整体 try：onLaunch 里任何同步异常都会截断后续初始化（见下方 WS 注释）。
  try {
    primeSafeAreaBottom();
  } catch (_eSafeBottomLaunch) {}
  setTimeout((): void => {
    try {
      primeSafeAreaBottom();
    } catch (_eSafeBottomTick) {}
  }, 0);
  setTimeout((): void => {
    try {
      primeSafeAreaBottom();
    } catch (_eSafeBottomLate) {}
  }, 600);
  // #ifdef H5 || WEB
  // 常驻壳把纯 token 放在 hash query 的 accessToken 上；请求前写入 storage 并标记内嵌，才能带 Bearer。
  bootstrapH5AccessTokenFromUrl();
  if (window.location.hash.indexOf('#/pages/offline-h5-bootstrap/offline-h5-bootstrap') == 0) {
    bootstrapI18nCache();
    return;
  }
  // #endif

  // === IM WebSocket 长连接（接入 nuwax-im /instant-message/ws）===
  // ★ 尽量前置：onLaunch 里 initCmark() 等依赖 uts 插件的调用一旦同步抛异常，
  //   后续初始化全部中断（实测 uni-cmark iOS uts 编译失败时 onLaunch 在此处截断，
  //   WS 从未启动、未读角标失去唯一更新链路）。
  // 启动 WS：token 已就绪则立即 connect，否则等下次 reconnect
  eventBus.on(IM_SESSION_CLEARED, (_event: any) => {
    // 注销设备（登出/切账号/换 token 都走这里；此刻还是旧 token，按旧账号注销本 deviceId）
    unregisterImDeviceSafe();
    stopImWsClient();
    clearImUnreadBadge();
    clearImNoticeState();
    clearImChatCache();
    clearImForwardSession();
  });
  eventBus.on(IM_SESSION_READY, (_event: any) => {
    initImWsClient();
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    // ★推送 SDK 初始化 + 通知权限申请都在登录成功后（延迟两拍执行，见
    //   imPushClient.scheduleImPushAfterLogin）：应用市场审核要求「同意隐私政策前
    //   不得初始化第三方 SDK / 申请权限」，首次安装未登录期间这两件事都不做。
    scheduleImPushAfterLogin();
    // #endif
  });
  initImWsClient();
  // tabBar 未读角标接 WS 帧（新消息/其他端已读同步 → 1s 去抖全量拉；回前台 onShow 再拉一次兜断线窗口）
  bindImUnreadWsEvents();
  // 新消息顶部横幅（非消息 tab 页弹提示；预拉 myUserId 与会话缓存，未登录静默失败）
  bindImNoticeEvents();
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  // ★uni-push 2.0 离线推送（2026-11-04 合规调整）：
  //   onPushMessage / getPushClientId 一旦调用就会初始化个推 SDK、采集 cid 并发网络请求，
  //   而 onLaunch 早于用户同意隐私政策（登录页勾选框），是应用市场自动审核的直接命中项。
  //   ⇒ 未登录（含首次安装）这里什么都不做；已登录冷启动只补绑点击监听，
  //     取 cid / 申请通知权限都等登录态成立后由 scheduleImPushAfterLogin 延迟执行
  //     （见 IM_SESSION_READY、pages/launch/launch.uvue）。
  bindImPushClientIfLoggedIn();
  // #endif
  // 监听 IM 鉴权失效（CONNECT_REJECT 非重试 / KICK.stopReconnect=true）
  // useRequest.uts:248 已 redirectToLoginOnce，这里只需关 WS 防止 4010 循环重连
  eventBus.on(`${EVENT_TYPE.ImAuthInvalid}`, (_event: any) => {
    console.log("[App] IM auth invalid, stop ws");
    stopImWsClient();
  });

  // 优先从缓存初始化国际化状态并快速应用 TabBar 翻译
  bootstrapI18nCache();

      // #ifdef H5 || WEB
      // uni-app x H5 运行时 InnerAudioContext.play() 丢弃 play() Promise（play(){this._audio.play()}），
      // 被后续 pause()/stop()/换源打断的 AbortError 在 UTS 层无法 catch，只能全局兜底吞掉。
      // 仅过滤 HTMLMediaElement.play() 的 rejection，不掩盖 fetch/其他 AbortError。
      window.addEventListener("unhandledrejection", (e: any) => {
        const reason = e != null ? e.reason : null;
        const name = reason != null && reason.name != null ? `${reason.name}` : "";
        const msg = reason != null && reason.message != null ? `${reason.message}` : "";
        if (msg.indexOf("play()") >= 0 && (name == "AbortError" || name == "NotAllowedError")) {
          console.warn("[H5] swallow media play rejection", name, msg);
          e.preventDefault();
        }
      });
      // #endif

      // App（Android / iOS / 鸿蒙）冷启动登录态分流已前移到启动页 pages/launch/launch：
      // 在 onLaunch 里 reLaunch 无法阻止首页被创建渲染，只能做到「先进首页再跳登录页」。

      // 异步加载语言包（不阻塞 onLaunch 生命周期）
      loadI18n();

      // 初始化 uni-cmark（Web/小程序必需；App 端为空实现或加载原生库）。
      // try 包同步 throw：uts 插件编译失败时占位模块的导出会同步抛异常，
      // .catch 接不住（Promise 未生成），会把整个 onLaunch 打断——
      // 实测曾导致后面的 IM WS 初始化全部丢失（WS adapter 为 null）。
      try {
        initCmark().then(() => {
          console.log("uni-cmark init ok");
        }).catch((err) => {
          console.error("uni-cmark init failed:", err);
        });
      } catch (e) {
        console.error("uni-cmark init threw (uts plugin broken?):", e);
      }

      // #ifdef APP-ANDROID
      registerAndroidEspProvisioningProvider();
      bootstrapAppNativePay();
      // #endif
      // #ifdef APP-IOS
      registerIosEspProvisioningProvider();
      // 注：不要在这里调 uni.setInnerAudioOption({obeyMuteSwitch:false})——真机 A/B 实证它会把
      // InnerAudioContext 播放切成无声（.playback 路径在 DCloud iOS 实现有问题；soloAmbient 基线
      // 有声）。聊天语音的锁屏/后台续播改由 chat.uvue 的 BackgroundAudioManager 分支实现。
      // #endif
      // #ifdef APP-HARMONY
      registerHarmonyEspProvisioningProvider();
      // 不在此注册鸿蒙支付桥：appNativePay.uts 在分包内，鸿蒙编译成独立 JS chunk，
      // 主包 import 会被丢弃（bootstrapAppNativePay is not defined）。
      // 鸿蒙支付走 paymentUtils.uts 的 #ifdef APP-HARMONY 直连插件分支，不依赖桥注册。
      // #endif


      // 使用 globalThis 定义全局变量（仅微信小程序需要）
      // #ifdef MP-WEIXIN
      globalThis.appConfig = {
        redirectUrl: null,
      };

      // 微信小程序事件绑定
      uni.$on("browser_navigate_page", async (data) => {
        console.log("browser_navigate_page 事件触发2", data);
        const html = data.html;

        if (!data.method) return;
        // 获取 iframe 内容
        let str = "";
        // 如果是 html
        if (data.data_type === "html") {
          str = html;
        }
        // 如果是 markdown
        if (data.data_type === "markdown") {
          // 将 HTML 转换为 Markdown
          str = htmlToMarkdown(html);
          console.log("HTML 已转换为 Markdown");
        }
        if (!str) {
          return;
        }

        if (data.method === "browser_navigate_page") {
          const params = {
            requestId: data.request_id ?? "",
            html: str,
          };
          await apiAgentComponentPageResultUpdate(params);
        }
      });
      // #endif

      // 初始化全局事件轮询
      // H5: 自动监听 visibilitychange，切换标签页时自动暂停/恢复
      // 小程序: 需要依赖 onHide/onShow 手动控制
      initEventPolling();

      // 初始化未读徽标，并在服务端推送新系统消息时立即刷新。
      refreshSystemMessageBadge();
      // IM 未读徽标（消息 Tab）：冷启拉一次；H5 同样需路由稳定后补拉。
      refreshImUnreadBadge();
      // H5 刷新时 App 生命周期会早于首个 Tab 页挂载，路由稳定后补一次刷新。
      // #ifdef H5 || WEB
      setTimeout(() => {
        refreshSystemMessageBadge();
        refreshImUnreadBadge();
      }, 200);
      // #endif
      eventBus.on(`${EVENT_TYPE.NewNotifyMessage}`, (_event: any) => {
        refreshSystemMessageBadge();
      });

      // #ifdef APP-IOS
      // 注册 iOS 原生支付桥（支付宝 openURL / 微信 scheme 兜底）
      bootstrapAppNativePay();
      // #endif
  }
  export default {
    onLaunch: function () {
      // Android 首启先停在 launch 页；真实同意后才初始化 IM、推送、设备与业务请求。
      // #ifdef APP-ANDROID
      uni.$on(APP_PRIVACY_GRANTED_EVENT, () => { initializeApplication(); });
      prepareAppPrivacyConsent((accepted: boolean) => {
        if (accepted) initializeApplication();
      });
      // #endif
      // #ifndef APP-ANDROID
      initializeApplication();
      // #endif
    },
    onShow: function (options : OnShowOptions) {
      if (!hasAppPrivacyConsent()) return;
      console.log("App Show");
      setAppInBackground(false);
      setAppIconBadgeSuppressed(true);
      // 打开 App（冷启动 / 回前台）即清空通知栏里本 App 的推送通知。
      // 点通知进 App 时系统只会消掉被点的那条，其余留在这里统一清掉。
      clearNotificationsOnAppOpen();
      // 回前台（含冷启动第一个 onShow）再刷一次底部安全区缓存：此时窗口 insets 必已就绪
      try {
        primeSafeAreaBottom();
      } catch (_eSafeBottomShow) {}
      // #ifdef APP
      // 冷启动交给 pages/launch。协议字符串在 appScheme，不在页面 path。
      const scheme = options.appScheme != null ? options.appScheme : "";
      const link = options.appLink != null ? options.appLink : "";
      const incoming = scheme.length > 0 ? scheme : link;
      if (appShareColdStart) {
        appShareColdStart = false;
      } else {
        const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
        const token = tokenRaw != null ? `${tokenRaw}`.trim() : "";
        if (incoming.length > 0) {
          routeIncomingShare(token.length > 0, incoming);
        }
      }
      // #endif
      // 回前台：活跃 SSE 恢复空闲超时监控并刷新 lastChunk 时间
      notifyStreamAppForeground();
      // #ifndef H5
      // 非 H5 端：从后台回到前台，恢复轮询（H5 由 visibilitychange 自动处理）
      startEventPolling();
      // #endif
      refreshSystemMessageBadge();
      // IM 未读徽标：回前台全量拉一次（实时更新由 WS 帧去抖全量拉驱动，此处兜断线窗口）。
      refreshImUnreadBadge();
      // IM WS：恢复心跳 + 强制重连（OS 后台期间 socket 状态不可信）
      reconnectImWsOnForeground();
      // #ifdef APP-ANDROID
      // 回前台校正离线推送注册：系统设置里关掉「允许通知」再打开后，个推/厂商通道的
      // 注册已被系统注销，进程在后台存活时 SDK 不会自己恢复 → 表现为「权限开着却收不到」。
      // 这里重新取 cid（权限恢复时强制重报设备），见 imPushClient.syncImPushOnForeground。
      syncImPushOnForeground();
      // #endif
    },
    onHide: function () {
      if (!hasAppPrivacyConsent()) return;
      console.log("App Hide");
      setAppInBackground(true);
      setAppIconBadgeSuppressed(false);
      clearAppIconBadge();
      // #ifndef H5
      // 非 H5 端：切换到后台，暂停轮询（H5 由 visibilitychange 自动处理）
      stopEventPolling();
      // #endif
      // IM WS：暂停心跳并**断开连接**。后端判「在线」只看 im:route 里有没有本 uid，
      // 连接不断就永远走不到离线推送（退后台 / 锁屏都触发 onHide，真机已验）。
      // 回前台由 onShow 的 reconnectImWsOnForeground 重建 + 补拉。
      pauseImWsKeepalive();
    },
    // #ifdef APP-ANDROID || APP-HARMONY
    onLastPageBackPress: function () {
      if (!hasAppPrivacyConsent()) {
        uni.exit();
        return;
      }
      console.log("App LastPageBackPress");
      if (firstBackTime == 0) {
        uni.showToast({
          title: t("Mobile.App.pressAgainToExit"),
          position: "bottom",
        });
        firstBackTime = Date.now();
        setTimeout(() => {
          firstBackTime = 0;
        }, 2000);
      } else if (Date.now() - firstBackTime < 2000) {
        firstBackTime = Date.now();
        uni.exit();
      }
    },
    // #endif
    onExit: function () {
      console.log("App Exit");
    },
  };
</script>

<style lang="scss">
  /* #ifdef APP */
  /* iconfont：App 端直接内联 @font-face（不走 @import 外联 .css），且 src 用根路径 "/static/..."。
    原先 @import iconfont-app.css 且 url 用 "@/static/..."，编译后 "@/" 不被改写，
     App 原生渲染引擎无法解析该路径 → 字体未注册 → 所有 iconfont 图标变 tofu（方框）。
     对齐 DCloud 官方 uni-ai-x 组件写法（src: url('/uni_modules/...')，内联在 <style>）。 */
  @font-face {
    font-family: "iconfont";
    src: url('/static/iconfont/iconfont.ttf');
  }
  .iconfont {
    font-family: "iconfont" !important;
    font-size: 16px;
    font-style: normal;
  }
  /* #endif */
  /* #ifndef APP */
  @import "@/static/iconfont/iconfont.css";
  /* #endif */

  @import "@/styles/global.scss";

  /* #ifdef H5 */
  html,
  body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  page,
  uni-page-wrapper,
  uni-page-body,
  #app {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  /* #endif */

  .page-container {
    /* #ifdef H5 */
    height: var(
      --vh,
      100svh
    ); /* 能识别 svh 就用 svh，否则用 JS 算出来的 --vh */
    /* #endif */

    /* #ifndef H5 */
    height: 100%;
    /* #endif */
  }
</style>
