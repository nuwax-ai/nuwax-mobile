import View from "android.view.View";
import { getElementById as uniGetElementById } from "io.dcloud.uniapp.extapi";
import PullActionCallback from "com.nuwax.pullaction.PullActionCallback";
import PullActionRegistry from "com.nuwax.pullaction.PullActionRegistry";
import type {
  NativePullActionHandler,
  NativePullActionProgressHandler,
  NativePullActionSettledHandler,
} from "../interface.uts";

class PullActionCallbackAdapter implements PullActionCallback {
  private progressHandler: NativePullActionProgressHandler;
  private triggerHandler: NativePullActionHandler;
  private settledHandler: NativePullActionSettledHandler;

  constructor(
    progressHandler: NativePullActionProgressHandler,
    triggerHandler: NativePullActionHandler,
    settledHandler: NativePullActionSettledHandler,
  ) {
    super();
    this.progressHandler = progressHandler;
    this.triggerHandler = triggerHandler;
    this.settledHandler = settledHandler;
  }

  override onProgress(distance: Double, dragging: boolean): void {
    this.progressHandler(distance, dragging);
  }

  override onTriggered(): void {
    this.triggerHandler();
  }

  override onSettled(triggered: boolean): void {
    this.settledHandler(triggered);
  }
}

/**
 * 把指定 scroll-view 的原生 View 包进 SmartRefreshLayout。
 * 原生控件独占手势判定与回弹；uvue 只消费距离并绘制现有三圆点。
 */
@UTSJS.keepAlive
export function attachAndroidPullAction(
  key: string,
  elementId: string,
  threshold: number,
  maxDragDistance: number,
  backgroundColor: string,
  enabled: boolean,
  onProgress: NativePullActionProgressHandler,
  onTriggered: NativePullActionHandler,
  onSettled: NativePullActionSettledHandler,
): boolean {
  const element = uniGetElementById(elementId);
  const view = element?.getAndroidView<View>();
  if (view == null) return false;
  return PullActionRegistry.attach(
    key,
    view,
    threshold,
    maxDragDistance,
    backgroundColor,
    enabled,
    new PullActionCallbackAdapter(onProgress, onTriggered, onSettled),
  );
}

export function setAndroidPullActionEnabled(key: string, enabled: boolean): void {
  PullActionRegistry.setEnabled(key, enabled);
}

export function detachAndroidPullAction(key: string): void {
  PullActionRegistry.detach(key);
}
