/**
 * nuwax-image-viewer：Android 原生全屏图片查看器（分块按需解码）的类型定义。
 * 仅 Android 实现；其余平台不经 #ifdef 不引用本模块。
 */

/** 长按保存回调：入参为当前图片 URL，鉴权下载与入相册由上层完成。 */
export type NativeViewerSaveHandler = (url: string) => void;

/** 取图回调：上层用 uni.downloadFile 把 URL 落成本地临时文件后回调（见 downloadPreviewImageToTemp）。 */
export type NativeViewerFileFetcher = (
  url: string,
  onOk: (path: string) => void,
  onFail: (message: string) => void,
) => void;
