<?xml version="1.0" encoding="utf-8"?>
<!--
  推送保活锚点。

  ★必须跑在**主进程**，不能声明 android:process=":pushservice"：
    个推的 PushManager.initialize 平时由主进程 JS 层（uni.getPushClientId）调用。
    2026-11-24 真机实测：把本服务放在 :pushservice 进程里调 initialize(context)，
    进程能被拉活、SDK 也会写库，但长连接不建立、离线推送收不到
    （打开 App 能收到、划掉后收不到，A/B 已确认不是时序问题）。
    主进程恢复不等于 Activity/UTS 业务初始化：接收桥接与普通通知由 DCloud 回调桥补齐。

  主进程本来就会被个推的 GtcProvider（ContentProvider）拉起，不额外增加进程。

  ★不要加 android:foregroundServiceType / android:persistent：
    - 该服务不调用 startForeground，产品上不挂常驻通知；
    - persistent 只对系统签名应用有效，第三方声明会被忽略。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="uts.sdk.modules.nuwaxPushKeepalive">
  <application>
    <provider
      android:name="com.nuwax.pushkeepalive.PushBootstrapProvider"
      android:authorities="${applicationId}.nuwax.push-bootstrap"
      android:exported="false" />
    <service
      android:name="com.nuwax.pushkeepalive.PushKeepAliveService"
      android:exported="false" />
  </application>
</manifest>
