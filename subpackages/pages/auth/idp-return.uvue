<template>
  <view class="auth-return">
    <text class="auth-status">{{ loading ? t('Mobile.Auth.idpVerifying') : t('Mobile.Auth.idpReturnFailed') }}</text>
    <button v-if="!loading" @click="retry">{{ t('Mobile.Auth.idpRetry') }}</button>
    <button @click="backToLogin">{{ t('Mobile.Auth.otherLogin') }}</button>
  </view>
</template>
<script setup lang="uts">
import { ref, onUnmounted } from 'vue';
import { apiVerifyIdpSession } from '@/servers/authIdp';
import { apiResCode } from '@/utils/apiResponse';
import { SUCCESS_CODE } from '@/constants/codes.constants';
import { getApiBaseUrl } from '@/constants/config';
import { AuthLoadScope, resolveMobileAuthReturn } from '@/utils/authIdp';
import { canUseBrowserIdp, authBrowserQuery, authBrowserOrigin, ordinaryLoginUrl } from '@/utils/idpNavigation';
import { navigateAfterMobileLogin } from '@/utils/loginNavigation';
import { clearAccessToken } from '@/utils/authSession';
import { notifyImSessionReady } from '@/utils/im/imSessionScope';
import { useI18n, emptyI18nParams } from '@/utils/i18n';

const { t: translate } = useI18n();
const t = (key: string): string => translate(key, emptyI18nParams(), '');
const loading = ref(false);
const scope = new AuthLoadScope();
let target = '';
async function retry(): Promise<void> {
  if (loading.value || !canUseBrowserIdp()) return;
  const sequence = scope.begin();
  const origin = getApiBaseUrl();
  loading.value = true;
  try {
    const response = await apiVerifyIdpSession();
    if (!scope.accepts(sequence, origin, getApiBaseUrl())) return;
    if (apiResCode(response) == SUCCESS_CODE) {
      // 新 Cookie 会话不继承上一个用户的本地 Bearer/IM 状态。
      clearAccessToken();
      notifyImSessionReady();
      navigateAfterMobileLogin('', target);
    }
  } catch (_error) {
    // 原始错误不含在 URL/日志中；保留重试和普通登录。
  } finally {
    if (scope.accepts(sequence, origin, getApiBaseUrl())) loading.value = false;
  }
}
function backToLogin(): void {
  scope.invalidate();
  uni.reLaunch({ url: ordinaryLoginUrl(target) });
}
onLoad(() => {
  target = resolveMobileAuthReturn(authBrowserQuery('redirect'), authBrowserOrigin());
  retry();
});
onUnmounted(() => scope.invalidate());
</script>
<style scoped>
.auth-return { flex: 1; padding: 64rpx 40rpx; background-color: #ffffff; }
.auth-status { margin-bottom: 40rpx; font-size: 30rpx; text-align: center; }
</style>
