/**
 * 桌宠配件初始化配置（BLE WiFi 配网）枚举定义
 *
 * 需求来源：桌宠硬件 WiFi 配网技术需求文档 v1.0（DH-WIFI-PROV-20260716）
 * 说明：APP 作为 BLE Central（主机），ESP32 作为 Peripheral（从机）。
 */

/**
 * 设备配网状态枚举（PROV_STATUS 特征 Notify/Read 的 byte0 状态码）
 * 与固件约定，值即协议字节码。
 */
export enum ProvStatusEnum {
  /** 待配网，等待凭据 */
  IDLE = 0,
  /** 正在尝试连接 WiFi */
  PROVISIONING = 1,
  /** WiFi 连接成功 */
  CONNECTED = 2,
  /** WiFi 连接失败 */
  FAILED = 3,
  /** 设备已有有效 WiFi 配置 */
  ALREADY_CONFIGURED = 255,
}

/**
 * APP 端配网流程阶段（状态机用，驱动 UI 进度）
 */
export enum ProvisionPhaseEnum {
  /** 初始/未开始 */
  IDLE = 'IDLE',
  /** 扫描待配网设备中 */
  SCANNING = 'SCANNING',
  /** 连接设备 BLE 中 */
  CONNECTING = 'CONNECTING',
  /** 读取设备信息（DEVICE_INFO）中 */
  READING_INFO = 'READING_INFO',
  /** 订阅配网状态（PROV_STATUS Notify）中 */
  SUBSCRIBING = 'SUBSCRIBING',
  /** 写入 WiFi SSID 中 */
  WRITING_SSID = 'WRITING_SSID',
  /** 写入 WiFi 密码中 */
  WRITING_PASSWORD = 'WRITING_PASSWORD',
  /** 等待设备联网结果中 */
  WAITING_RESULT = 'WAITING_RESULT',
  /** 配网成功 */
  SUCCESS = 'SUCCESS',
  /** 配网失败 */
  FAILED = 'FAILED',
}

/**
 * 设备控制命令（COMMAND 特征 Write 的单字节命令）
 */
export enum ProvCommandEnum {
  /** 重置配网：清除设备端 WiFi 凭据并重启进入配网模式 */
  RESET = 1,
  /** 触发设备扫描附近 AP（可选增强） */
  SCAN = 2,
}

/**
 * 配网失败后的重试动作（决定 retry() 行为）
 */
export enum ProvisionRetryActionEnum {
  /** 无需重试 */
  NONE = 'none',
  /** 重新连接设备后重写凭据 */
  RECONNECT = 'reconnect',
  /** 仅重新写入凭据 */
  REWRITE = 'rewrite',
  /** 回到扫描页重新扫描 */
  RESCAN = 'rescan',
  /** BLE 会话仍存活：直接重试绑定设备并下发密钥（绑定接口网络/网关错误时用，无需重连） */
  RETRY_BIND = 'retryBind',
}

/**
 * Mock 模拟场景（调试页可切换，驱动 MockBleAdapter 行为）
 */
export enum MockScenarioEnum {
  /** 顺利联网成功 */
  SUCCESS = 'SUCCESS',
  /** 联网失败：WiFi 密码错误（FAILED + 密码错误详情） */
  FAIL_WRONG_PASSWORD = 'FAIL_WRONG_PASSWORD',
  /** 联网失败：找不到 AP（FAILED + AP 不可达详情） */
  FAIL_AP_NOT_FOUND = 'FAIL_AP_NOT_FOUND',
  /** 只推进到 PROVISIONING 不再推进（触发 APP 30s 超时） */
  FAIL_TIMEOUT = 'FAIL_TIMEOUT',
  /** 连接前 2 次失败第 3 次成功（验证连接重试） */
  CONNECT_FLAKY = 'CONNECT_FLAKY',
  /** 写凭据前 1 次失败（验证写重试） */
  WRITE_FLAKY = 'WRITE_FLAKY',
  /** 订阅即报 ALREADY_CONFIGURED（设备已配置） */
  ALREADY_CONFIGURED = 'ALREADY_CONFIGURED',
  /** 写入凭据后意外断开连接 */
  UNEXPECTED_DISCONNECT = 'UNEXPECTED_DISCONNECT',
}
