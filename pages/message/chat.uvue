    border-radius: 8rpx 36rpx 36rpx 36rpx;
    box-shadow: 0 4rpx 16rpx rgba(60, 50, 140, 0.04);
  }

  .chat-bubble--mine {
    background-image: linear-gradient(135deg, #6a5cff 0%, #5147ff 100%);
    border: 2rpx solid rgba(0, 0, 0, 0);
    border-radius: 36rpx 8rpx 36rpx 36rpx;
    box-shadow: 0 4rpx 16rpx rgba(81, 71, 255, 0.16);
  }

  .chat-bubble--active {
    background-color: #f7f6fb;
  }

  .chat-bubble__text {
    font-size: 30rpx;
    line-height: 46rpx;
    color: #22212a;
  }

  .chat-bubble__text--mine {
