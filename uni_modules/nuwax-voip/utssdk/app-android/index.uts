import { UTSAndroid } from "io.dcloud.uts";
import { VoipBridge } from "com.nuwax.voip";
import FrameLayout from "android.widget.FrameLayout";

export function executeVoip(command: string): void {
  const context = UTSAndroid.getAppContext();
  const activity = UTSAndroid.getUniActivity();
  if (activity != null) VoipBridge.setActivity(activity);
  if (context != null) VoipBridge.execute(context, command);
}
export function drainVoipEvents(): string { return VoipBridge.drainEvents(); }
export function isVoipTestPackage(): boolean {
  const context = UTSAndroid.getAppContext();
  return context != null && VoipBridge.isTestPackage(context);
}
export function getVoipPresentationStatus(): string {
  const context = UTSAndroid.getAppContext();
  return context == null ? '{"supported":false}' : VoipBridge.presentationStatus(context);
}
export function openVoipPresentationSettings(): void {
  const context = UTSAndroid.getAppContext();
  if (context != null) VoipBridge.openPresentationSettings(context);
}
export function openVoipAppSettings(): void {
  const context = UTSAndroid.getAppContext();
  if (context != null) VoipBridge.openAppSettings(context);
}
export class VoipVideoBinding {
  private view: FrameLayout | null = null;
  constructor(element: UniNativeViewElement, local: boolean) {
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) return;
    const view = VoipBridge.createVideoView(activity, local); this.view = view;
    element.bindAndroidView(view);
  }
  dispose(): void { const view = this.view; if (view != null) VoipBridge.releaseVideoView(view); this.view = null; }
}
export function ensureVoipPermissions(mediaType: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) { resolve(false); return; }
    const permissions = ["android.permission.RECORD_AUDIO"] as string[];
    if (mediaType == "video") permissions.push("android.permission.CAMERA");
    if (UTSAndroid.checkSystemPermissionGranted(activity, permissions)) { resolve(true); return; }
    UTSAndroid.requestSystemPermission(activity, permissions,
      (allGranted: boolean, _grantedList: string[]) => { resolve(allGranted); },
      (_neverAsk: boolean, _deniedList: string[]) => { resolve(false); });
  });
}
