/**
 * 自定义操作服务（当前仅保留文件树刷新）
 *
 * 全局检索确认：业务侧仅 AgentDetailService 在 PROCESSING + ToolCall 时调用
 * CustomActionService.refreshFileList；页面通过 uni.$on('refreshFileList') 消费。
 */

/**
 * 统一的自定义操作服务类
 */
export class CustomActionService {
  /**
   * 刷新文件树
   * 对应 PC 端 handleRefreshFileList：向页面发出 refreshFileList 事件
   * @param conversationId 会话 ID
   */
  static refreshFileList(conversationId: string): void {
    if (conversationId.length === 0) {
      return;
    }

    // 移除 chat- 前缀
    const idStr = conversationId;
    const cid = idStr.startsWith("chat-") ? idStr.replace("chat-", "") : idStr;

    uni.$emit("refreshFileList", cid);
  }
}
