<template>
  <view class="inline-openui" :style="{ height: height }">
    <web-view v-if="src.length > 0" :src="src" @message="onMessage" />
  </view>
</template>

<script setup lang="uts">
  import { getApiBaseUrl } from "@/constants/config";
  import {
    buildOpenUiFilePath,
    parseOpenUiResizeHeight,
  } from "@/utils/openUiSchema.uts";
  import { computed, ref } from "vue";

  /**
   * inline 模式：把 OpenUI runtime 直接内嵌渲染在聊天气泡里（不点击）。
   * 默认最小高度 100rpx(≈50px)；runtime 经 OPENUI_RESIZE 上报后自适应撑开。
   * 注：小程序/App 的 <web-view> 可能全屏；本组件面向 H5(iframe) 内嵌，App 若全屏则需改方案。
   */
  const props = withDefaults(
    defineProps<{
      artifactId: string;
      conversationId?: string;
      title?: string;
    }>(),
    {
      conversationId: "",
      title: "OpenUI",
    },
  );

  // App/小程序 @message 不实时触发，OPENUI_RESIZE 收不到 → 无法真正自适应；先给一个可用默认高度。
  // H5(iframe) 下 @message 可实时收到，会在 onMessage 里被 OPENUI_RESIZE 覆盖为真实高度。
  const height = ref("400rpx");

  const src = computed((): string => {
    const cidRaw = props.conversationId.startsWith("chat-")
      ? props.conversationId.substring(5)
      : props.conversationId;
    const filePath = buildOpenUiFilePath(cidRaw, props.artifactId);
    if (filePath == null) {
      return "";
    }
    const nonce = `${Date.now()}`;
    const safeTitle = props.title.length > 0 ? props.title : "OpenUI";
    return (
      `${getApiBaseUrl()}/static/openui-runtime/index.html` +
      `?file_path=${encodeURIComponent(filePath)}` +
      `&nonce=${nonce}` +
      `&title=${encodeURIComponent(safeTitle)}`
    );
  });

  function onMessage(e: any): void {
    // 解析逻辑在普通模块 openUiSchema（含 try/catch）；<script setup> 内只一行调用，避免编译问题。
    const h = parseOpenUiResizeHeight(e);
    if (h > 0) {
      height.value = `${h}px`;
    }
  }
</script>

<style lang="scss" scoped>
  .inline-openui {
    width: 100%;
    min-height: 100rpx;
    margin: 16rpx 0;
    border-radius: 16rpx;
    overflow: hidden;
    background-color: rgba(12, 20, 102, 0.045);
  }
</style>
