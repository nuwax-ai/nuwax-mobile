/**
 * Nuwax Vox 设备语音网关 - App 监控接口
 * 列表/详情/录音临时地址/删除。
 * 后端服务已就绪、真机在线联调，不走 mock。
 */
import request from "@/servers/useRequest";
import { VOX_BASE_URL } from "@/constants/config";
import { requestVoxAudioFiles } from "./voxAudioFiles";
import type { RequestResponse, VoidRequestResponse } from "@/types/interfaces/request";
import type {
  AppMonitoringListParams,
  IAppMonitoringPageView,
  IAppMonitoringDetailView,
  IAppMonitoringAudioUrlView,
  IAppMonitoringAudioFilesView,
  IAppMonitoringSettingsView,
  AppMonitoringSettingsUpdateParams,
  AppMonitoringContentUpsertParams,
} from "@/types/interfaces/voxMonitoring";

/**
 * 监控列表（分页；keyword 匹配转写预览；timeRange=ALL|TODAY|THIS_WEEK|THIS_MONTH）。
 * agentId 为设备关联的终端智能体 ID，后端必传。
 */
export async function apiVoxMonitoringList(data: AppMonitoringListParams): Promise<RequestResponse<IAppMonitoringPageView>> {
  const res = await request({
    url: `/api/app/monitorings?agentId=${data.agentId}&keyword=${encodeURIComponent(data.keyword)}&timeRange=${data.timeRange}&page=${data.page}&pageSize=${data.pageSize}`,
    method: "GET",
    baseUrl: VOX_BASE_URL,
  });
  return res;
}

/** 监控详情（含转写全文与 utterances 分段） */
export async function apiVoxMonitoringDetail(id: number): Promise<RequestResponse<IAppMonitoringDetailView>> {
  const res = await request({ url: `/api/app/monitorings/${id}`, method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 监控录音临时播放地址（有效期约 24h，勿持久化）
 *  @deprecated NW-269 播放接口变更：后端已废弃单文件口径，新代码一律用
 *  apiVoxMonitoringAudioFiles；本函数仅存量下载链路未切完前保留。 */
export async function apiVoxMonitoringAudioUrl(id: number): Promise<RequestResponse<IAppMonitoringAudioUrlView>> {
  const res = await request({ url: `/api/app/monitorings/${id}/audio-url`, method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 监控录音分段列表（NW-269 新口径：无卡单段、有卡多段，按 segmentIndex 升序连播）
 *  commitType=MONITORING_HISTORY 的补传段靠后；文字同步的段归属按本列表顺序对齐；
 *  audioUrl 为预签名地址（24h 有效）勿持久化；total=0 表示无音频。 */
export async function apiVoxMonitoringAudioFiles(id: number, page: number, pageSize: number): Promise<RequestResponse<IAppMonitoringAudioFilesView>> {
  return await requestVoxAudioFiles("monitorings", id, page, pageSize);
}

/** 删除监控记录 */
export async function apiVoxMonitoringDelete(id: number): Promise<VoidRequestResponse> {
  const res = await request({ url: `/api/app/monitorings/${id}/delete`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}

/** 设备监控设置（含告警开关与监控内容列表） */
export async function apiVoxGetMonitoringSettings(deviceId: string): Promise<RequestResponse<IAppMonitoringSettingsView>> {
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/monitoring/settings`, method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 更新设备监控设置（未传字段保持原值） */
export async function apiVoxUpdateMonitoringSettings(deviceId: string, data: AppMonitoringSettingsUpdateParams): Promise<RequestResponse<IAppMonitoringSettingsView>> {
  const body = new UTSJSONObject();
  if (data.appAlertEnabled != null) body["appAlertEnabled"] = data.appAlertEnabled;
  if (data.smsAlertEnabled != null) body["smsAlertEnabled"] = data.smsAlertEnabled;
  if (data.smsPhones != null) body["smsPhones"] = data.smsPhones;
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/monitoring/settings/update`, method: "POST", data: body, baseUrl: VOX_BASE_URL });
  return res;
}

/** 新增监控内容（场景） */
export async function apiVoxAddMonitoringContent(deviceId: string, data: AppMonitoringContentUpsertParams): Promise<RequestResponse<IAppMonitoringSettingsView>> {
  const body = new UTSJSONObject();
  body["title"] = data.title;
  const kwArr: string[] = data.keywords;
  body["keywords"] = kwArr;
  if (data.enabled != null) body["enabled"] = data.enabled;
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/monitoring/contents`, method: "POST", data: body, baseUrl: VOX_BASE_URL });
  return res;
}

/** 更新监控内容（场景）启用态等 */
export async function apiVoxUpdateMonitoringContent(deviceId: string, contentId: number, data: AppMonitoringContentUpsertParams): Promise<RequestResponse<IAppMonitoringSettingsView>> {
  const body = new UTSJSONObject();
  if (data.title != "") body["title"] = data.title;
  if (data.keywords.length > 0) body["keywords"] = data.keywords;
  if (data.enabled != null) body["enabled"] = data.enabled;
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/monitoring/contents/${contentId}/update`, method: "POST", data: body, baseUrl: VOX_BASE_URL });
  return res;
}

/** 删除监控内容（场景） */
export async function apiVoxDeleteMonitoringContent(deviceId: string, contentId: number): Promise<VoidRequestResponse> {
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/monitoring/contents/${contentId}/delete`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}

/** 开启监控模式（向在线设备下发，异步等 ack） */
export async function apiVoxMonitoringStart(deviceId: string): Promise<VoidRequestResponse> {
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/monitoring/start`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}

/** 关闭监控模式 */
export async function apiVoxMonitoringStop(deviceId: string): Promise<VoidRequestResponse> {
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/monitoring/stop`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}
