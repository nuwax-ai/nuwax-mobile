<template>
  <!-- 首页 @ 专家快捷浮层：由父组件 v-if 控制真实挂载，关闭时必须卸载命中层。
       Android 原生端 v-show 仅隐藏绘制时可能残留绝对定位 hit-test，挡住后续 + 面板。 -->
  <!-- #ifdef APP-IOS -->
  <!-- iOS 原生 scroll-view / editor 各自建立图层，子树内 z-index 无法越层。
       page-container 将快捷列表提升到页面原生顶层；关闭时父级 v-if 会一并卸载。 -->
  <page-container
    :show="visible"
    position="bottom"
    :overlay="false"
    :round="false"
    :duration="0"
    :z-index="3000"
    :custom-style="iosPageContainerStyle"
  >
    <view class="expert-quick-popup expert-quick-popup--ios" :style="popupStyle">
      <view class="quick-panel">
        <view class="quick-header">
          <text class="quick-title">{{ popupTitle }}</text>
          <view class="quick-close" @click="handleClose">
            <view class="quick-close-line quick-close-line--left" />
            <view class="quick-close-line quick-close-line--right" />
          </view>
        </view>
        <expert-list-view
          v-if="mode == 'expert'"
          ref="listRef"
          class="quick-list"
          type="convenient"
          variant="simple"
          :keyword="keyword"
          @select="handleSelect"
        />
        <skill-list-view
          v-else-if="mode == 'skill'"
          ref="listRef"
          class="quick-list"
          type="convenient"
          variant="simple"
          :keyword="keyword"
          @select="handleSelect"
        />
        <scroll-view
          v-else
          class="quick-list quick-file-list"
          direction="vertical"
          :show-scrollbar="false"
        >
          <view v-if="filteredFiles.length == 0" class="quick-file-state">
            <text class="quick-file-state-text">{{ t("Mobile.FileTree.noFiles") }}</text>
          </view>
          <view
            v-for="(item, index) in filteredFiles"
            :key="item.key"
            class="quick-file-row"
            :class="{ 'quick-file-row--highlight': index == fileHighlightIndex }"
            @tap.stop="handleFileSelect(item)"
          >
            <view class="quick-file-icon">
              <svg-icon name="icon-a-Filetext" size="34" color="#777783" />
            </view>
            <view class="quick-file-main">
              <text class="quick-file-name">{{ item.name }}</text>
              <text v-if="item.path != item.name" class="quick-file-path">{{ item.path }}</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </page-container>
  <!-- #endif -->
  <!-- #ifndef APP-IOS -->
  <view class="expert-quick-popup" :style="popupStyle">
    <view class="quick-panel">
      <view class="quick-header">
        <text class="quick-title">{{ popupTitle }}</text>
        <view class="quick-close" @click="handleClose">
          <view class="quick-close-line quick-close-line--left" />
          <view class="quick-close-line quick-close-line--right" />
        </view>
      </view>
      <!-- 快捷类型（convenient：最近召唤+系统广场去重合并），simple 紧凑行 -->
      <expert-list-view
        v-if="mode == 'expert'"
        ref="listRef"
        class="quick-list"
        type="convenient"
        variant="simple"
        :keyword="keyword"
        @select="handleSelect"
      />
      <skill-list-view
        v-else-if="mode == 'skill'"
        ref="listRef"
        class="quick-list"
        type="convenient"
        variant="simple"
        :keyword="keyword"
        @select="handleSelect"
      />
      <scroll-view
        v-else
        class="quick-list quick-file-list"
        direction="vertical"
        :show-scrollbar="false"
      >
        <view v-if="filteredFiles.length == 0" class="quick-file-state">
          <text class="quick-file-state-text">{{ t("Mobile.FileTree.noFiles") }}</text>
        </view>
        <view
          v-for="(item, index) in filteredFiles"
          :key="item.key"
          class="quick-file-row"
          :class="{ 'quick-file-row--highlight': index == fileHighlightIndex }"
          @tap.stop="handleFileSelect(item)"
        >
          <view class="quick-file-icon">
            <svg-icon name="icon-a-Filetext" size="34" color="#777783" />
          </view>
          <view class="quick-file-main">
            <text class="quick-file-name">{{ item.name }}</text>
            <text v-if="item.path != item.name" class="quick-file-path">{{ item.path }}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import ExpertListView from "@/components/expert-list-view/expert-list-view.uvue";
  import SkillListView from "@/components/skill-list-view/skill-list-view.uvue";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const props = withDefaults(defineProps<{
    visible: boolean;
    mode?: string;
    /** @ 之后的实时搜索词（受控，组件内 300ms 防抖） */
    keyword?: string;
    /** 可用高度（px）：取 640rpx 与输入框上方剩余空间的较小值；0 = 尚未测量 */
    height?: number;
    /** iOS page-container 中，输入卡锚点距视口底部的距离（px）。 */
    bottom?: number;
    /** 会话上下文文件树；file 模式会递归摊平并仅展示文件。 */
    files?: any[];
  }>(), {
    visible: false,
    mode: "expert",
    keyword: "",
    height: 0,
    bottom: 0,
    files: () => [] as any[],
  });

  class ConversationFileMentionItem {
    key: string = "";
    name: string = "";
    path: string = "";
  }

  const popupTitle = computed((): string => {
    if (props.mode == "skill") return t("Mobile.Nav.skill");
    if (props.mode == "file") return t("Mobile.Common.workspace");
    return t("Mobile.Nav.expert");
  });

  function readNodeString(node: any, key: string): string {
    if (node == null) return "";
    const value = (node as UTSJSONObject)[key];
    return value != null ? `${value}` : "";
  }

  function appendFileNodes(nodes: any[], target: ConversationFileMentionItem[]): void {
    for (let i = 0; i < nodes.length; i++) {
      const node = nodes[i];
      if (node == null) continue;
      const type = readNodeString(node, "type");
      const childrenRaw = (node as UTSJSONObject)["children"];
      const children = Array.isArray(childrenRaw) ? (childrenRaw as any[]) : ([] as any[]);
      if (type == "folder" || children.length > 0) {
        if (children.length > 0) appendFileNodes(children, target);
        continue;
      }
      let path = readNodeString(node, "fullPath");
      if (path.length == 0) path = readNodeString(node, "path");
      if (path.length == 0) path = readNodeString(node, "id");
      let name = readNodeString(node, "name");
      if (path.length == 0) path = name;
      if (name.length == 0 && path.length > 0) {
        const slashIndex = path.lastIndexOf("/");
        name = slashIndex >= 0 && slashIndex + 1 < path.length
          ? path.substring(slashIndex + 1)
          : path;
      }
      if (path.length == 0 || name.length == 0) continue;
      const item = new ConversationFileMentionItem();
      item.key = `file:${path}`;
      item.name = name;
      item.path = path;
      target.push(item);
      if (target.length >= 100) return;
    }
  }

  const filteredFiles = computed((): ConversationFileMentionItem[] => {
    const all = [] as ConversationFileMentionItem[];
    appendFileNodes(props.files, all);
    const keyword = props.keyword.trim().toLowerCase();
    if (keyword.length == 0) return all;
    const result = [] as ConversationFileMentionItem[];
    for (let i = 0; i < all.length; i++) {
      const item = all[i];
      if (item.name.toLowerCase().indexOf(keyword) >= 0 || item.path.toLowerCase().indexOf(keyword) >= 0) {
        result.push(item);
      }
    }
    return result;
  });

  const fileHighlightIndex = ref<number>(0);

  const emit = defineEmits<{
    (e: "close"): void;
    (e: "select", item: UTSJSONObject): void;
  }>();

  const popupStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    style["height"] = `${props.height}px`;
    style["maxHeight"] = `${props.height}px`;
    return style;
  });

  const iosPageContainerStyle = computed((): string => {
    const totalHeight = Math.max(0, Math.round(props.height + props.bottom));
    return `width: 100%; height: ${totalHeight}px; background-color: transparent;`;
  });

  function handleClose(): void {
    emit("close");
  }

  function handleSelect(item: UTSJSONObject): void {
    emit("select", item);
  }

  function handleFileSelect(item: ConversationFileMentionItem): void {
    const payload = new UTSJSONObject();
    payload["key"] = item.key;
    payload["name"] = item.name;
    payload["path"] = item.path;
    emit("select", payload);
  }

  const listRef = ref<any | null>(null);

  function callList(method: string, args: UTSJSONObject = new UTSJSONObject()): any | null {
    const inst = listRef.value;
    if (inst == null) return null;
    return (inst as ComponentPublicInstance).$callMethod(method, args);
  }

  /** 键盘导航桥（对齐 PC useImperativeHandle） */
  defineExpose({
    getItemCount(): number {
      if (props.mode == "file") return filteredFiles.value.length;
      const r = callList("getItemCount");
      return r != null ? (r as number) : 0;
    },
    setHighlightIndex(index: number): void {
      if (props.mode == "file") {
        fileHighlightIndex.value = index;
        return;
      }
      callList("setHighlightIndex", new UTSJSONObject({ index: index }));
    },
    pickHighlight(): void {
      if (props.mode == "file") {
        const item = filteredFiles.value[fileHighlightIndex.value];
        if (item != null) handleFileSelect(item);
        return;
      }
      callList("pickHighlight");
    },
  });
</script>

<style scoped lang="scss">
  .expert-quick-popup {
    /* #ifndef APP-IOS */
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    /* #endif */
    z-index: 2000;
    display: flex;
    flex-direction: column;
    height: 640rpx;
    max-height: 640rpx;
    // Android/其他端走绝对定位，在这里保留与输入卡片之间的 4px 间距。
    /* #ifndef APP-IOS */
    margin-bottom: 4px;
    /* #endif */
    /* #ifdef APP-IOS */
    // iOS 的 4px 已计入 page-container bottom，避免重复叠加。
    margin-bottom: 0;
    /* #endif */
    background-color: rgba(255, 255, 255, 0);
    box-sizing: border-box;
    overflow: visible;
  }

  /* #ifdef APP-IOS */
  .expert-quick-popup--ios {
    position: relative;
    margin-left: 32rpx;
    margin-right: 32rpx;
  }
  /* #endif */

  .quick-panel {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    background-color: #ffffff;
    border-radius: 24rpx;
    box-sizing: border-box;
    /* 阴影/边框与输入框容器（record-tip-container）同款分端处理 */
    /* #ifndef APP */
    box-shadow:
      0 9rpx 45rpx 0 rgba(0, 0, 0, 0.08),
      0 2rpx 10rpx 0 rgba(0, 0, 0, 0.08),
      0 0 3rpx 0 rgba(0, 0, 0, 0.08);
    border: 1rpx solid rgba(0, 0, 0, 0.15);
    /* #endif */
    /* #ifdef APP */
    box-shadow: 0 0 28rpx rgba(0, 0, 0, 0.12);
    /* #endif */
    /* #ifdef APP-IOS */
    border: 1rpx solid rgba(0, 0, 0, 0.15);
    /* #endif */
    /* #ifdef APP-ANDROID */
    // Android：1rpx 半像素丢失，与输入框一致用 1px 物理边框
    border: 1px solid rgba(0, 0, 0, 0.15);
    /* #endif */
    overflow: hidden;
  }

  .quick-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 22rpx 28rpx 10rpx;
  }

  .quick-title {
    color: #6f6f7b;
    font-size: 24rpx;
    font-weight: 600;
  }

  .quick-close {
    position: relative;
    width: 44rpx;
    height: 44rpx;
  }

  .quick-close-line {
    position: absolute;
    left: 10rpx;
    top: 21rpx;
    width: 24rpx;
    height: 3rpx;
    border-radius: 999rpx;
    background-color: #8d8d97;
  }

  .quick-close-line--left { transform: rotate(45deg); }
  .quick-close-line--right { transform: rotate(-45deg); }

  .quick-list {
    flex: 1;
    min-height: 0;
  }

  .quick-file-list {
    height: 100%;
    padding: 0 20rpx 18rpx;
    box-sizing: border-box;
  }

  .quick-file-row {
    min-height: 82rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 10rpx 8rpx;
    border-radius: 12rpx;
    box-sizing: border-box;
  }

  .quick-file-row--highlight { background-color: #f3f1fa; }

  .quick-file-icon {
    width: 52rpx;
    height: 52rpx;
    margin-right: 16rpx;
    border-radius: 14rpx;
    background-color: #f3f2f6;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .quick-file-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .quick-file-name {
    color: #202028;
    font-size: 28rpx;
    line-height: 38rpx;
    lines: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .quick-file-path {
    color: #9797a1;
    font-size: 22rpx;
    line-height: 30rpx;
    lines: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .quick-file-state {
    min-height: 220rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quick-file-state-text {
    color: #9797a1;
    font-size: 26rpx;
  }
</style>
