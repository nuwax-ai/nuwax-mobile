/**
 * 缩略图共享模块（模块级，全部 im-file-thumb 实例共享）：
 * 1) 并发闸门——文件页长列表一次性挂载 N 行缩略图组件，若各自同时发起受保护
 *    图片解析（=整文件下载），网络队列与内存会被打满，页面明显卡顿甚至假死。
 *    限制同时进行的解析数，超出的排队等待——与 utils/remoteSvgImage.uts 的
 *    SVG 并发闸门同款结构（FIFO 等待队列）。
 * 2) 成功缓存——resolveDisplayImageUrl 对受保护图片无成功缓存，而切 tab 会
 *    重建行、组件重挂重走解析（重复整文件下载）。这里按 原始url→展示地址
 *    缓存成功结果，重挂命中即秒显零网络；失败不缓存（重挂可重试）。
 */
const THUMB_MAX_CONCURRENT = 3;
let activeThumbJobs = 0;
const thumbWaiters: Array<() => void> = [] as Array<() => void>;

const resolvedThumbCache = new Map<string, string>();

export function getCachedThumbSrc(url: string): string | null {
  return resolvedThumbCache.get(url);
}

export function cacheThumbSrc(url: string, src: string): void {
  resolvedThumbCache.set(url, src);
}

export function acquireThumbSlot(): Promise<boolean> {
  return new Promise<boolean>((resolve, _reject) => {
    if (activeThumbJobs < THUMB_MAX_CONCURRENT) {
      activeThumbJobs++;
      resolve(true);
      return;
    }
    thumbWaiters.push(() => {
      activeThumbJobs++;
      resolve(true);
    });
  });
}

export function releaseThumbSlot(): void {
  activeThumbJobs--;
  if (thumbWaiters.length > 0) {
    const next = thumbWaiters[0];
    thumbWaiters.splice(0, 1);
    next();
  }
}
