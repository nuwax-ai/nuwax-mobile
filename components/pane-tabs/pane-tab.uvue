<template>
  <view class="pane-tab">
    <slot />
  </view>
</template>

<script setup lang="uts">
  import { inject, onMounted, onUnmounted, watch } from "vue";

  const props = defineProps({
    tab: {
      type: String,
      default: "",
    },
    keyValue: {
      type: String,
      default: "",
    },
    forceRender: {
      type: Boolean,
      default: false,
    },
  });

  const paneTabsCtx = inject("paneTabs", null as any | null);

  const getPaneTabsContext = (): UTSJSONObject | null => {
    if (paneTabsCtx == null) {
      return null;
    }
    return paneTabsCtx as UTSJSONObject;
  };

  const registerToParent = () => {
    const paneTabs = getPaneTabsContext();
    if (paneTabs == null) return;
    const registerFn = paneTabs["registerTab"];
    if (registerFn == null) return;
    const fn = registerFn as (
      key: string,
      label: string,
      forceRender: boolean,
    ) => void;
    fn(props.keyValue, props.tab, props.forceRender);
  };

  const updateParentTabLabel = (newTab: string) => {
    const paneTabs = getPaneTabsContext();
    if (paneTabs == null) return;
    const updateFn = paneTabs["updateTabLabel"];
    if (updateFn == null) return;
    const fn = updateFn as (key: string, label: string) => void;
    fn(props.keyValue, newTab);
  };

  const unregisterFromParent = () => {
    const paneTabs = getPaneTabsContext();
    if (paneTabs == null) return;
    const unregisterFn = paneTabs["unregisterTab"];
    if (unregisterFn == null) return;
    const fn = unregisterFn as (key: string) => void;
    fn(props.keyValue);
  };

  onMounted(() => {
    registerToParent();
  });

  watch(
    (): string => props.tab,
    (newTab: string) => {
      updateParentTabLabel(newTab);
    },
  );

  onUnmounted(() => {
    unregisterFromParent();
  });
</script>

<style lang="scss" scoped>
  .pane-tab {
    flex: 0 0 auto;
    /* #ifdef H5 || WEB */
    width: 100vw;
    /* #endif */
    /* #ifndef H5 || WEB */
    width: 100%;
    /* #endif */
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
  }
</style>
