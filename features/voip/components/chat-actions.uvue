<template>
  <view class="call-actions" :style="{ width: actionsWidth + 'px', height: actionsWidth > 0 ? '82px' : '0px' }">
    <view v-if="busy" class="call-action" @click="openVoipPage()">
      <text class="call-icon">↗</text><text class="call-label">{{ t("Mobile.Voip.return") }}</text>
    </view>
    <!-- #ifdef APP-IOS -->
    <view v-if="historyAvailable && !busy" class="call-action" @click="openHistory()">
      <text class="call-icon">◷</text><text class="call-label">{{ t("Mobile.Voip.history") }}</text>
    </view>
    <!-- #endif -->
  </view>
</template>
<script setup lang="uts">
  import { computed } from "vue";
  // #ifdef APP-IOS
  import { ref, watch, onMounted } from "vue";
  // #endif
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  import { isVoipBusy, voipRevision, openVoipPage as openCallPage } from "@/features/voip/callManager";
  // #ifdef APP-IOS
  import { openVoipHistory, voipCapabilities } from "@/features/voip/callManager";
  // #endif
  const props = defineProps({ convId: { type: String, default: "" } });
  // #ifdef APP-IOS
  const historyAvailable = ref(false);
  let request = 0;
  // #endif
  const busy = computed((): boolean => { voipRevision.value; return isVoipBusy(); });
  // iOS 原生布局不能依赖异步插入的子节点重新推算组件根节点宽度。
  // 保留根节点，并随能力结果明确占位；隐藏时不挤占加号面板。
  const actionsWidth = computed((): number => {
    if (busy.value) return 90;
    // #ifdef APP-IOS
    if (historyAvailable.value) return 90;
    // #endif
    return 0;
  });
  function openVoipPage(): void { openCallPage(); }
  // #ifdef APP-IOS
  function openHistory(): void { openVoipHistory(); }
  async function refreshHistoryAvailability(): Promise<void> {
    const run = ++request;
    historyAvailable.value = false;
    if (props.convId.length == 0) return;
    const caps = await voipCapabilities(props.convId);
    if (run != request) return;
    historyAvailable.value = caps["enabled"] === true && caps["audio"] === true;
  }
  watch((): string => props.convId, (): void => { refreshHistoryAvailability(); });
  onMounted(() => { refreshHistoryAvailability(); });
  // #endif
</script>
<style scoped>
  .call-actions { flex-direction: row; }
  .call-action { width: 78px; align-items: center; margin-right: 12px; }
  .call-icon { width: 58px; height: 58px; border-radius: 14px; background-color: #ffffff; color: #3568cf; font-size: 28px; text-align: center; line-height: 58px; }
  .call-label { margin-top: 8px; font-size: 12px; color: #55565e; }
</style>
