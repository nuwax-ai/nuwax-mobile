/**
 * SSE/正文插入 OpenUI 过程标签（从 containerHelper 抽出）。
 */

import { toMarkdownCustomProcessHtml } from "@/utils/markdownCustomProcess.uts";
import { isOpenUiRenderToolName } from "@/utils/openUiSchema.uts";

/**
 * RENDER_UI 后端 type=Event 时改为 ToolCall，避免 groupMarkdownContainers 跳过。
 */
export function coerceOpenUiToolCallType(name: string, type: string): string {
  if (isOpenUiRenderToolName(name) && (type == "Event" || type.length == 0)) {
    return "ToolCall";
  }
  return type;
}

/**
 * OpenUI 写入扁平 HTML 过程标签；非 OpenUI 返回空串（调用方走 :::container）。
 */
export function tryAppendOpenUiProcessHtml(
  beforeText: string,
  executeId: string,
  type: string,
  status: string,
  name: string,
): string {
  if (isOpenUiRenderToolName(name) != true) {
    return "";
  }
  const htmlTag = toMarkdownCustomProcessHtml(executeId, type, status, name);
  return `${beforeText}\n\n${htmlTag}\n\n`;
}
