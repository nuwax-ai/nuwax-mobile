<template>
  <view class="tsp-page">
    <view class="tsp-header">
      <text class="tsp-title">{{ t("Mobile.Debug.streamTitle") }}</text>
      <text class="tsp-sub">{{ t("Mobile.Debug.streamHint") }}</text>
    </view>

    <view class="tsp-row">
      <text class="tsp-label">mdType</text>
      <view class="tsp-types">
        <text
          v-for="(t, i) in mdTypes"
          :key="t"
          class="tsp-type-chip"
          :class="i == mdTypeIndex ? 'tsp-type-chip-active' : ''"
          @click="onSelectType(i)"
        >{{ t }}</text>
      </view>
    </view>

    <view class="tsp-row">
      <text class="tsp-label">{{ t("Mobile.Debug.streamHistory") }}</text>
      <view class="tsp-types">
        <text
          v-for="h in historyOptions"
          :key="'h' + h"
          class="tsp-type-chip"
          :class="historyStr == `${h}` ? 'tsp-type-chip-active' : ''"
          @click="onSelectHistory(h)"
        >{{ h }}</text>
      </view>
    </view>
    <view class="tsp-row">
      <text class="tsp-label">{{ t("Mobile.Debug.streamLength") }}</text>
      <view class="tsp-types">
        <text
          v-for="l in streamLenOptions"
          :key="'l' + l"
          class="tsp-type-chip"
          :class="streamLenStr == `${l}` ? 'tsp-type-chip-active' : ''"
          @click="onSelectStreamLen(l)"
        >{{ l }}</text>
      </view>
    </view>

    <button class="tsp-start" type="primary" @click="onStart">{{ t("Mobile.Debug.startTest") }}</button>
    <button class="tsp-clear" @click="onClear">{{ t("Mobile.Debug.clearMock") }}</button>
  </view>
</template>

<script lang="uts" setup>
  import { t } from "@/utils/i18n";

  import { ref } from "vue";
  import {
    applyStreamPerfConfig,
    clearStreamPerfMock,
    PERF_MOCK_MDTYPES,
    PERF_MOCK_DEFAULT_MDTYPE,
    PERF_MOCK_DEFAULT_HISTORY,
    PERF_MOCK_DEFAULT_STREAMLEN,
    PERF_MOCK_DEFAULT_INTERVAL_MS,
    PERF_MOCK_DEFAULT_CHUNK,
  } from "@/subpackages/pages/chat-conversation-component/layers/mockStreamPerf.uts";

  const mdTypes = PERF_MOCK_MDTYPES;

  // UTS：function 须先声明后使用（不提升），mdIndex/parseNum 放到引用前。
  function mdIndex(md: string): number {
    for (let i = 0; i < mdTypes.length; i++) {
      if (mdTypes[i] == md) {
        return i;
      }
    }
    return mdTypes.length - 1;
  }

  function parseNum(s: string, fallback: number): number {
    if (s.length == 0) return fallback;
    const n = parseFloat(s);
    if (n != n) return fallback; // NaN
    return n;
  }

  const mdTypeIndex = ref<number>(mdIndex(PERF_MOCK_DEFAULT_MDTYPE));
  const historyStr = ref<string>(`${PERF_MOCK_DEFAULT_HISTORY}`);
  const streamLenStr = ref<string>(`${PERF_MOCK_DEFAULT_STREAMLEN}`);

  const historyOptions = [0, 10, 50, 100, 200];
  const streamLenOptions = [0, 2000, 4000, 6000];

  const onSelectType = (i: number) => {
    if (i >= 0 && i < mdTypes.length) {
      mdTypeIndex.value = i;
    }
  };
  const onSelectHistory = (h: number) => {
    historyStr.value = `${h}`;
  };
  const onSelectStreamLen = (l: number) => {
    streamLenStr.value = `${l}`;
  };

  const onStart = () => {
    const md = mdTypes[mdTypeIndex.value];
    applyStreamPerfConfig(
      md,
      parseNum(historyStr.value, PERF_MOCK_DEFAULT_HISTORY),
      parseNum(streamLenStr.value, PERF_MOCK_DEFAULT_STREAMLEN),
      PERF_MOCK_DEFAULT_INTERVAL_MS,
      PERF_MOCK_DEFAULT_CHUNK,
    );
    uni.navigateTo({
      url: "/subpackages/pages/agent-detail/agent-detail?id=perf&conversationId=0",
    });
  };

  const onClear = () => {
    clearStreamPerfMock();
    uni.showToast({ title: t("Mobile.Debug.mockCleared"), icon: "none" });
  };
</script>

<style lang="scss" scoped>
  .tsp-page {
    padding: 24rpx;
  }
  .tsp-header {
    margin-bottom: 24rpx;
  }
  .tsp-title {
    font-size: 36rpx;
    font-weight: 700;
  }
  .tsp-sub {
    font-size: 24rpx;
    color: #888;
    margin-top: 8rpx;
  }
  .tsp-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 20rpx;
  }
  .tsp-label {
    width: 200rpx;
    font-size: 28rpx;
  }
  .tsp-types {
    flex: 1;
    flex-direction: row;
    flex-wrap: wrap;
  }
  .tsp-type-chip {
    padding: 8rpx 20rpx;
    margin: 6rpx 10rpx 6rpx 0;
    font-size: 26rpx;
    color: #555;
    background: #f0f0f0;
    border-radius: 24rpx;
  }
  .tsp-type-chip-active {
    background: #007aff;
    color: #fff;
  }
  .tsp-num {
    flex: 1;
    padding: 12rpx 16rpx;
    background: #f5f5f5;
    border-radius: 8rpx;
    font-size: 28rpx;
  }
  .tsp-start {
    margin-top: 40rpx;
  }
  .tsp-clear {
    margin-top: 20rpx;
  }
</style>
