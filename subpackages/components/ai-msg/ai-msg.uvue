  .codespan {
    color: #666;
    background-color: #f5f5f5;
    padding: 4rpx 8rpx;
    border-radius: 10rpx;
    font-size: 28rpx;
    /* #ifndef APP */
    word-break: break-all;
    overflow-wrap: anywhere;
