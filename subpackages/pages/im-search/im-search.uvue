<template>
  <view class="ims-page">
    <safety-zone />

    <!-- 顶部：搜索框 + 取消（飞书搜索页样式） -->
    <view class="ims-header">
      <view class="ims-search-box" :class="{ 'ims-search-box--focus': inputFocused }">
        <svg-icon name="icon-Search" size="34" color="#9a98a5" />
        <input
          ref="searchInputRef"
          class="ims-search-input"
          v-model="keyword"
          :placeholder="t('Mobile.Message.imSearchPlaceholder')"
          placeholder-class="ims-search-ph"
          confirm-type="search"
          :focus="autoFocus"
          @focus="handleInputFocus"
          @blur="handleInputBlur"
          @input="onKeywordInput"
          @confirm="onKeywordConfirm"
        />
        <view v-if="keyword.length > 0" class="ims-clear" @click="handleClear">
          <svg-icon name="icon-a-Xcircle-fill" size="32" color="#c0bec8" />
        </view>
      </view>
      <view class="ims-cancel" hover-class="ims-cancel--active" @click="handleBack">
        <text class="ims-cancel__text">{{ t("Mobile.Common.cancel") }}</text>
      </view>
    </view>

    <!-- 筛选 pill：全部 / 消息 / 联系人 / 群组 -->
    <view class="ims-pills">
      <view
        class="ims-pill"
        :class="{ 'ims-pill--on': activeTab == 'all' }"
        @click="switchTab('all')"
      >
        <text class="ims-pill__text" :class="{ 'ims-pill__text--on': activeTab == 'all' }">
          {{ t("Mobile.Message.imSearchTabAll") }}
        </text>
      </view>
      <view
        class="ims-pill"
        :class="{ 'ims-pill--on': activeTab == 'messages' }"
        @click="switchTab('messages')"
      >
        <text class="ims-pill__text" :class="{ 'ims-pill__text--on': activeTab == 'messages' }">
          {{ t("Mobile.Message.imSearchTabMessages") }}
        </text>
      </view>
      <view
        class="ims-pill"
        :class="{ 'ims-pill--on': activeTab == 'contacts' }"
        @click="switchTab('contacts')"
      >
        <text class="ims-pill__text" :class="{ 'ims-pill__text--on': activeTab == 'contacts' }">
          {{ t("Mobile.Message.imSearchTabContacts") }}
        </text>
      </view>
      <view
        class="ims-pill"
        :class="{ 'ims-pill--on': activeTab == 'groups' }"
        @click="switchTab('groups')"
      >
        <text class="ims-pill__text" :class="{ 'ims-pill__text--on': activeTab == 'groups' }">
          {{ t("Mobile.Message.imSearchTabGroups") }}
        </text>
      </view>
    </view>

    <!-- 结果区 -->
    <scroll-view class="ims-body" direction="vertical" :show-scrollbar="false">
      <!-- 空关键词：待输入提示（群组 tab 除外——它的加入入口不受搜索门控，见下） -->
      <view v-if="submittedKw.length == 0 && activeTab != 'groups'" class="ims-state">
        <text class="ims-state__text">{{ t("Mobile.Message.imSearchIdle") }}</text>
      </view>

      <!-- ===== 全部：聚合视图（联系人 → 群组 → 消息，飞书综合结果） ===== -->
      <template v-else-if="activeTab == 'all'">
        <!-- 联系人 -->
        <view v-if="contactsLoading" class="ims-state ims-state--thin">
          <text class="ims-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
        </view>
        <template v-else-if="contactRows.length > 0">
          <view class="ims-section-head">
            <text class="ims-section-head__title">{{ t("Mobile.Message.imSearchTabContacts") }}</text>
            <view class="ims-section-head__more" @click="switchTab('contacts')">
              <text class="ims-section-head__more-text">{{ t("Mobile.Message.imSearchMore") }}</text>
              <svg-icon name="icon-a-Chevronright" size="24" color="#9a98a5" />
            </view>
          </view>
          <view v-for="row in contactRows.slice(0, 3)" :key="`c-${row.userId}`">
            <view class="ims-row" hover-class="ims-row--active" @click="handleContactTap(row)">
              <view class="ims-row__avatar-wrap">
                <image
                  v-if="row.avatar.length > 0 && row.avatarFailed != true"
                  class="ims-row__avatar"
                  :src="row.avatar"
                  mode="aspectFill"
                  @error="handleContactAvatarError(row)"
                />
                <view v-else class="ims-row__avatar" :style="{ backgroundImage: avatarGradient(row.displayName) }">
                  <text class="ims-row__avatar-letter">{{ avatarLetter(row.displayName) }}</text>
                </view>
              </view>
              <view class="ims-row__body">
                <text class="ims-row__title text-ellipsis">{{ row.displayName }}</text>
                <text v-if="row.fromLocal" class="ims-row__sub text-ellipsis">
                  {{ t("Mobile.Message.imSearchFromLocal") }}
                </text>
              </view>
            </view>
            <view class="ims-divider" />
          </view>
        </template>

        <!-- 群组 -->
        <template v-if="groupsLoading">
          <view class="ims-state ims-state--thin">
            <text class="ims-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
          </view>
        </template>
        <template v-else-if="matchedGroups.length > 0">
          <view class="ims-section-head">
            <text class="ims-section-head__title">{{ t("Mobile.Message.imSearchTabGroups") }}</text>
            <view class="ims-section-head__more" @click="switchTab('groups')">
              <text class="ims-section-head__more-text">{{ t("Mobile.Message.imSearchMore") }}</text>
              <svg-icon name="icon-a-Chevronright" size="24" color="#9a98a5" />
            </view>
          </view>
          <view v-for="row in matchedGroups.slice(0, 3)" :key="`g-${row.convId}`">
            <view class="ims-row" hover-class="ims-row--active" @click="handleGroupTap(row)">
              <view class="ims-row__avatar-wrap">
                <image
                  v-if="row.avatarUrl.length > 0 && row.avatarFailed != true"
                  class="ims-row__avatar"
                  :src="row.avatarUrl"
                  mode="aspectFill"
                  @error="handleGroupAvatarError(row)"
                />
                <view v-else class="ims-row__avatar" :style="{ backgroundImage: avatarGradient(row.displayName) }">
                  <text class="ims-row__avatar-letter">{{ avatarLetter(row.displayName) }}</text>
                </view>
              </view>
              <view class="ims-row__body">
                <text class="ims-row__title text-ellipsis">{{ row.displayName }}</text>
                <text class="ims-row__sub text-ellipsis">{{ groupMemberLabel(row) }}</text>
              </view>
            </view>
            <view class="ims-divider" />
          </view>
        </template>

        <!-- 消息 -->
        <view v-if="msgAllLoading" class="ims-state ims-state--thin">
          <text class="ims-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
        </view>
        <template v-else-if="msgAllRows.length > 0">
          <view class="ims-section-head">
            <text class="ims-section-head__title">{{ t("Mobile.Message.imSearchTabMessages") }}</text>
            <view class="ims-section-head__more" @click="switchTab('messages')">
              <text class="ims-section-head__more-text">{{ t("Mobile.Message.imSearchMore") }}</text>
              <svg-icon name="icon-a-Chevronright" size="24" color="#9a98a5" />
            </view>
          </view>
          <view v-for="row in msgAllRows.slice(0, 5)" :key="`m-${row.msgId}`">
            <view class="ims-row" hover-class="ims-row--active" @click="handleMsgTap(row)">
              <view class="ims-row__avatar-wrap">
                <image
                  v-if="msgAvatarSrc(row).length > 0"
                  class="ims-row__avatar"
                  :src="msgAvatarSrc(row)"
                  mode="aspectFill"
                />
                <view v-else class="ims-row__avatar" :style="{ backgroundImage: avatarGradient(msgTitle(row)) }">
                  <text class="ims-row__avatar-letter">{{ avatarLetter(msgTitle(row)) }}</text>
                </view>
              </view>
              <view class="ims-row__body">
                <view class="ims-row__title-row">
                  <text class="ims-row__title text-ellipsis">{{ msgTitle(row) }}</text>
                  <text class="ims-row__time">{{ formatHitTime(row.sendTime) }}</text>
                </view>
                <text class="ims-row__snippet text-ellipsis-2">
                  <text
                    v-for="(seg, i) in row.segs"
                    :key="i"
                    :class="seg.hit ? 'ims-row__seg--hit' : 'ims-row__seg'"
                  >{{ seg.text }}</text>
                </text>
              </view>
            </view>
            <view class="ims-divider" />
          </view>
        </template>

        <!-- 三类都加载完且都无结果 -->
        <view
          v-if="allLoaded && contactRows.length == 0 && matchedGroups.length == 0 && msgAllRows.length == 0"
          class="ims-state"
        >
          <text class="ims-state__text">{{ t("Mobile.Message.imSearchEmpty") }}</text>
        </view>
      </template>

      <!-- ===== 消息 tab：消息级视角（collapseByConv=false，PC 同款 size=50） ===== -->
      <template v-else-if="activeTab == 'messages'">
        <view v-if="msgLoading" class="ims-state">
          <text class="ims-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
        </view>
        <view v-else-if="msgRows.length == 0" class="ims-state">
          <text class="ims-state__text">{{ t("Mobile.Message.imSearchEmpty") }}</text>
        </view>
        <template v-else>
          <view v-for="row in msgRows" :key="row.msgId">
            <view class="ims-row" hover-class="ims-row--active" @click="handleMsgTap(row)">
              <view class="ims-row__avatar-wrap">
                <image
                  v-if="msgAvatarSrc(row).length > 0"
                  class="ims-row__avatar"
                  :src="msgAvatarSrc(row)"
                  mode="aspectFill"
                />
                <view v-else class="ims-row__avatar" :style="{ backgroundImage: avatarGradient(msgTitle(row)) }">
                  <text class="ims-row__avatar-letter">{{ avatarLetter(msgTitle(row)) }}</text>
                </view>
              </view>
              <view class="ims-row__body">
                <view class="ims-row__title-row">
                  <text class="ims-row__title text-ellipsis">{{ msgTitle(row) }}</text>
                  <text class="ims-row__time">{{ formatHitTime(row.sendTime) }}</text>
                </view>
                <text class="ims-row__snippet text-ellipsis-2">
                  <text
                    v-for="(seg, i) in row.segs"
                    :key="i"
                    :class="seg.hit ? 'ims-row__seg--hit' : 'ims-row__seg'"
                  >{{ seg.text }}</text>
                </text>
              </view>
            </view>
            <view class="ims-divider" />
          </view>
        </template>
      </template>

      <!-- ===== 联系人 tab ===== -->
      <template v-else-if="activeTab == 'contacts'">
        <view v-if="contactsLoading" class="ims-state">
          <text class="ims-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
        </view>
        <view v-else-if="contactRows.length == 0" class="ims-state">
          <text class="ims-state__text">{{ t("Mobile.Message.imSearchEmpty") }}</text>
        </view>
        <template v-else>
          <view v-if="contactsDegraded" class="ims-degraded">
            <text class="ims-degraded__text">{{ t("Mobile.Message.searchDegraded") }}</text>
          </view>
          <view v-for="row in contactRows" :key="row.userId">
            <view class="ims-row" hover-class="ims-row--active" @click="handleContactTap(row)">
              <view class="ims-row__avatar-wrap">
                <image
                  v-if="row.avatar.length > 0 && row.avatarFailed != true"
                  class="ims-row__avatar"
                  :src="row.avatar"
                  mode="aspectFill"
                  @error="handleContactAvatarError(row)"
                />
                <view v-else class="ims-row__avatar" :style="{ backgroundImage: avatarGradient(row.displayName) }">
                  <text class="ims-row__avatar-letter">{{ avatarLetter(row.displayName) }}</text>
                </view>
              </view>
              <view class="ims-row__body">
                <text class="ims-row__title text-ellipsis">{{ row.displayName }}</text>
                <text v-if="row.fromLocal" class="ims-row__sub text-ellipsis">
                  {{ t("Mobile.Message.imSearchFromLocal") }}
                </text>
              </view>
            </view>
            <view class="ims-divider" />
          </view>
        </template>
      </template>

      <!-- ===== 群组 tab：本地过滤已加入群 + 按群号加入入口（PC DEV-201/197 同款语义） ===== -->
      <template v-else>
        <!-- 入口行：不受搜索门控，常驻列表上方（搜不到群时的第二条出路） -->
        <view class="ims-row" hover-class="ims-row--active" @click="handleJoinTap">
          <view class="ims-row__avatar ims-row__avatar--entry">
            <svg-icon name="icon-Plus" size="36" color="#5147ff" />
          </view>
          <view class="ims-row__body">
            <view class="ims-row__title-row">
              <text class="ims-row__title ims-row__title--entry text-ellipsis">
                {{ t("Mobile.Message.joinGroupTitle") }}
              </text>
              <svg-icon name="icon-a-Chevronright" size="24" color="#c0bec8" />
            </view>
          </view>
        </view>
        <view class="ims-divider" />

        <view v-if="groupsLoading" class="ims-state">
          <text class="ims-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
        </view>
        <view v-else-if="matchedGroups.length == 0" class="ims-state">
          <!-- 空关键词=待输入（入口行上方已见），有关键词=确实没匹配 -->
          <text class="ims-state__text">{{
            submittedKw.length == 0
              ? t("Mobile.Message.imSearchIdle")
              : t("Mobile.Message.imSearchEmpty")
          }}</text>
        </view>
        <template v-else>
          <view v-for="row in matchedGroups" :key="row.convId">
            <view class="ims-row" hover-class="ims-row--active" @click="handleGroupTap(row)">
              <view class="ims-row__avatar-wrap">
                <image
                  v-if="row.avatarUrl.length > 0 && row.avatarFailed != true"
                  class="ims-row__avatar"
                  :src="row.avatarUrl"
                  mode="aspectFill"
                  @error="handleGroupAvatarError(row)"
                />
                <view v-else class="ims-row__avatar" :style="{ backgroundImage: avatarGradient(row.displayName) }">
                  <text class="ims-row__avatar-letter">{{ avatarLetter(row.displayName) }}</text>
                </view>
              </view>
              <view class="ims-row__body">
                <text class="ims-row__title text-ellipsis">{{ row.displayName }}</text>
                <text class="ims-row__sub text-ellipsis">{{ groupMemberLabel(row) }}</text>
              </view>
            </view>
            <view class="ims-divider" />
          </view>
        </template>
      </template>

      <view class="ims-bottom-space" />
    </scroll-view>

    <!-- 按群号加入群聊（复用消息页组件） -->
    <join-group-sheet ref="joinSheetRef" @joined="handleJoinedGroup" />
  </view>
</template>

<script setup lang="uts">
  import { computed, nextTick, onMounted, onUnmounted, ref, type ComponentPublicInstance } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import {
    apiImConversations,
    apiImCreateP2pConversation,
    apiImMyGroups,
    apiImSearchContacts,
    apiImSearchMessages,
  } from "@/servers/im";
  import type { RequestResponse } from "@/types/interfaces/request";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import JoinGroupSheet from "@/pages/message/components/join-group-sheet.uvue";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 消息 tab 单次拉取条数（PC 搜索弹窗同款 size=50，服务端上限 100）。 */
  const MSG_PAGE_SIZE = 50;
  /** 全部 tab 消息区拉取条数（collapseByConv=true，每会话一条）。 */
  const MSG_ALL_SIZE = 10;
  /** 会话/联系人搜索条数上限（服务端 limit，默认 50 上限 200）。 */
  const CONTACT_LIMIT = 20;
  /** 我的群组单页条数（与消息页智联录同款：单页拉满免分页）。 */
  const GROUP_PAGE_SIZE = 100;
  /** 会话名兜底映射的拉取条数（PC 启动时同款 conversations?limit=100）。 */
  const CONV_BRIEF_LIMIT = 100;
  /** 输入防抖（ms）：飞书式边输边搜，但逐字不打 ES（对齐 PC 提交式搜索的顾虑）。 */
  const DEBOUNCE_MS = 400;

  /** 头像字母底色渐变板（与消息列表页同款六色系）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #f59a9a, #e05f5f)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  /** 高亮片段：服务端 highlight 的 <em>…</em> 拆段（只按标记切分，内容一律纯文本渲染，天然无 XSS）。 */
  class SearchSeg {
    text: string = "";
    hit: boolean = false;
  }

  /**
   * 消息命中行。★msgId/convId 是 int64 雪花号（字符串存防精度丢失）。
   * segs 已含 [图片]/[文件] 前缀段（附件消息索引里只有文件名，与 PC previewOf 同口径）。
   */
  class MsgHit {
    msgId: string = "";
    convId: string = "";
    convType: number = 1;
    senderName: string = "";
    sendTime: number = 0;
    segs: SearchSeg[] = [];
  }

  /** 联系人命中行（p2pConvId 空 ⇒ 需先 createP2p 再进会话，契约见 im-openapi searchContacts）。 */
  class ContactHit {
    userId: string = "";
    displayName: string = "";
    avatar: string = "";
    p2pConvId: string = "";
    fromLocal: boolean = false;
    avatarFailed: boolean = false;
  }

  /** 我的群组行（本地过滤数据源，DEV-165 语义：含已从会话列表删除但仍在群内的群）。 */
  class GroupHit {
    convId: string = "";
    displayName: string = "";
    avatarUrl: string = "";
    memberCount: number = 0;
    avatarFailed: boolean = false;
  }

  /** 会话摘要（消息行的会话名/头像兜底映射，PC 启动 conversations?limit=100 同款）。 */
  class ConvBrief {
    convId: string = "";
    convType: number = 1;
    displayName: string = "";
    avatarUrl: string = "";
  }

  // ===== 输入与 tab =====
  const keyword = ref<string>("");
  const submittedKw = ref<string>("");
  const inputFocused = ref<boolean>(false);
  const autoFocus = ref<boolean>(false);
  const activeTab = ref<string>("all");
  const searchInputRef = ref<UniInputElement | null>(null);
  const joinSheetRef = ref<any | null>(null);

  // ===== 消息结果（两个视角独立缓存，各自记录已加载关键词） =====
  const msgRows = ref<MsgHit[]>([]);
  const msgLoading = ref<boolean>(false);
  let msgLoadedKw = "";
  const msgAllRows = ref<MsgHit[]>([]);
  const msgAllLoading = ref<boolean>(false);
  let msgAllLoadedKw = "";

  // ===== 联系人结果 =====
  const contactRows = ref<ContactHit[]>([]);
  const contactsLoading = ref<boolean>(false);
  const contactsDegraded = ref<boolean>(false);
  let contactsLoadedKw = "";

  // ===== 我的群组（一次拉取缓存，本地过滤） =====
  const groupsAll = ref<GroupHit[]>([]);
  const groupsLoading = ref<boolean>(false);
  let groupsLoaded = false;

  // ===== 会话名/头像兜底映射 =====
  const convBriefs = ref<ConvBrief[]>([]);
  let convBriefsLoaded = false;

  /** 请求时序号：慢响应回来时关键词已变则丢弃。 */
  let searchSeq = 0;
  let debounceTimer = 0;
  /** 联系人建会话防重（连点保护，与消息页 openContactChat 同款）。 */
  let contactOpening = false;

  /** 群组本地过滤：按展示名 includes、大小写不敏感（PC DEV-201 同口径）；空关键词=非搜索态返回空。 */
  const matchedGroups = computed((): GroupHit[] => {
    const kw = submittedKw.value.trim().toLowerCase();
    if (kw.length == 0) {
      const empty: GroupHit[] = [];
      return empty;
    }
    const rows: GroupHit[] = [];
    const all = groupsAll.value;
    for (let i = 0; i < all.length; i++) {
      if (all[i].displayName.toLowerCase().indexOf(kw) >= 0) {
        rows.push(all[i]);
      }
    }
    return rows;
  });

  const allLoaded = computed<boolean>((): boolean => {
    return (
      contactsLoading.value != true &&
      msgAllLoading.value != true &&
      groupsLoading.value != true
    );
  });

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  // ===== 高亮解析 =====

  const EM_OPEN = "<em>";
  const EM_CLOSE = "</em>";

  /**
   * highlight 拆段：按 <em>/</em> 标记切分为 普通/命中 交替片段。
   * 片段内容只作纯文本渲染（不进 rich-text），标记本身被剥离，天然免疫注入。
   */
  function parseHighlight(frag: string, prefix: string): SearchSeg[] {
    const segs: SearchSeg[] = [];
    if (prefix.length > 0) {
      const head = new SearchSeg();
      head.text = prefix;
      segs.push(head);
    }
    let rest = frag;
    let hit = false;
    let guard = 0;
    while (rest.length > 0 && guard < 100) {
      guard++;
      const marker = hit ? EM_CLOSE : EM_OPEN;
      const at = rest.indexOf(marker);
      if (at < 0) {
        const seg = new SearchSeg();
        seg.text = rest;
        seg.hit = hit;
        segs.push(seg);
        break;
      }
      if (at > 0) {
        const seg = new SearchSeg();
        seg.text = rest.substring(0, at);
        seg.hit = hit;
        segs.push(seg);
      }
      rest = rest.substring(at + marker.length);
      hit = !hit;
    }
    return segs;
  }

  /**
   * 命中预览拆段：highlight > text > fileName 逐级回落（后端 pickHighlight 已做过
   * text→fileName 回落，前端再兜一层兼容旧后端）；附件消息加 [图片]/[文件] 前缀
   * （索引里只有文件名，不标前缀用户看不出为什么命中——PC previewOf 同口径）。
   */
  function buildSegs(obj: UTSJSONObject): SearchSeg[] {
    const msgType = readString(obj, "msgType");
    let prefix = "";
    if (msgType == "image") {
      prefix = t("Mobile.Message.quoteImage") + " ";
    } else if (msgType == "file") {
      prefix = t("Mobile.Message.quoteFile") + " ";
    }
    let frag = readString(obj, "highlight");
    if (frag.length == 0) {
      frag = readString(obj, "text");
    }
    if (frag.length == 0) {
      frag = readString(obj, "fileName");
    }
    return parseHighlight(frag, prefix);
  }

  function readMsgHit(obj: UTSJSONObject): MsgHit {
    const row = new MsgHit();
    row.msgId = readString(obj, "msgId");
    row.convId = readString(obj, "convId");
    row.convType = readNumber(obj, "convType", 1);
    row.senderName = readString(obj, "senderName");
    row.sendTime = readNumber(obj, "sendTime", 0);
    row.segs = buildSegs(obj);
    return row;
  }

  /** 联系人展示名：昵称 > 账号，两者都有时「昵称（账号）」（PC DEV-202 #218 同规则），全空给未知用户。 */
  function contactDisplayName(nickName: string, userName: string): string {
    if (nickName.length > 0) {
      return userName.length > 0 && userName != nickName ? `${nickName}（${userName}）` : nickName;
    }
    if (userName.length > 0) {
      return userName;
    }
    return t("Mobile.Message.imSearchUnknownUser");
  }

  // ===== 取数 =====

  /** 会话名/头像映射：懒加载一次（首次有消息命中时按需触发，best-effort）。 */
  function ensureConvBriefs(): void {
    if (convBriefsLoaded) {
      return;
    }
    convBriefsLoaded = true;
    apiImConversations("", CONV_BRIEF_LIMIT)
      .then((res: RequestResponse<any>) => {
        if (apiResCode(res) != SUCCESS_CODE) {
          convBriefsLoaded = false;
          return;
        }
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj == null) {
          return;
        }
        const recordsRaw = dataObj["records"];
        if (recordsRaw == null) {
          return;
        }
        const records = recordsRaw as UTSJSONObject[];
        const rows: ConvBrief[] = [];
        for (let i = 0; i < records.length; i++) {
          const brief = new ConvBrief();
          brief.convId = readString(records[i], "convId");
          brief.convType = readNumber(records[i], "convType", 1);
          // 单聊 name 恒为 null（服务端约定）：展示名/头像取对端字段，群聊取 name（与消息页同规则）
          const name = readString(records[i], "name");
          const peerName = readString(records[i], "peerName");
          const avatar = readString(records[i], "avatar");
          const peerAvatar = readString(records[i], "peerAvatar");
          if (brief.convType == 1) {
            brief.displayName = peerName.length > 0 ? peerName : name;
            brief.avatarUrl = peerAvatar.length > 0 ? peerAvatar : avatar;
          } else {
            brief.displayName = name;
            brief.avatarUrl = avatar;
          }
          if (brief.convId.length > 0) {
            rows.push(brief);
          }
        }
        convBriefs.value = rows;
      })
      .catch((_e: any | null) => {
        convBriefsLoaded = false;
      });
  }

  function briefOf(convId: string): ConvBrief | null {
    const rows = convBriefs.value;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].convId == convId) {
        return rows[i];
      }
    }
    return null;
  }

  /** 消息行标题：会话名（映射兜底）> 发送者名（PC 全局搜索同款回落）。 */
  function msgTitle(row: MsgHit): string {
    const brief = briefOf(row.convId);
    if (brief != null && brief.displayName.length > 0) {
      return brief.displayName;
    }
    return row.senderName.length > 0 ? row.senderName : t("Mobile.Common.conversations");
  }

  function msgAvatarSrc(row: MsgHit): string {
    const brief = briefOf(row.convId);
    return brief != null ? brief.avatarUrl : "";
  }

  /** 我的群组：一次拉满缓存（含 visible=0 的群，这正是本地过滤而非 /search/conversations 的理由）。 */
  function ensureGroups(): void {
    if (groupsLoaded || groupsLoading.value) {
      return;
    }
    groupsLoading.value = true;
    apiImMyGroups("", GROUP_PAGE_SIZE)
      .then((res: RequestResponse<any>) => {
        groupsLoading.value = false;
        if (apiResCode(res) != SUCCESS_CODE) {
          groupsLoaded = true;
          return;
        }
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        const rows: GroupHit[] = [];
        if (dataObj != null) {
          const recordsRaw = dataObj["records"];
          if (recordsRaw != null) {
            const records = recordsRaw as UTSJSONObject[];
            for (let i = 0; i < records.length; i++) {
              const hit = new GroupHit();
              hit.convId = readString(records[i], "convId");
              const name = readString(records[i], "name");
              const peerName = readString(records[i], "peerName");
              hit.displayName = name.length > 0 ? name : peerName;
              hit.avatarUrl = readString(records[i], "avatar");
              hit.memberCount = readNumber(records[i], "memberCount", 0);
              if (hit.convId.length > 0) {
                rows.push(hit);
              }
            }
          }
        }
        groupsAll.value = rows;
        groupsLoaded = true;
      })
      .catch((_e: any | null) => {
        groupsLoading.value = false;
        groupsLoaded = true;
      });
  }

  function parseMsgItems(res: RequestResponse<any>): MsgHit[] {
    const rows: MsgHit[] = [];
    const dataRaw = apiResData<any>(res);
    const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
    if (dataObj != null) {
      const itemsRaw = dataObj["items"];
      if (itemsRaw != null) {
        const items = itemsRaw as UTSJSONObject[];
        for (let i = 0; i < items.length; i++) {
          rows.push(readMsgHit(items[i]));
        }
      }
    }
    return rows;
  }

  /** 消息搜索（两个视角共用；collapse=true 每会话一条给聚合用）。 */
  function fetchMessages(collapse: boolean): void {
    const seq = searchSeq;
    const kw = submittedKw.value;
    if (collapse) {
      msgAllLoading.value = true;
    } else {
      msgLoading.value = true;
    }
    apiImSearchMessages(kw, collapse ? MSG_ALL_SIZE : MSG_PAGE_SIZE, collapse)
      .then((res: RequestResponse<any>) => {
        if (seq != searchSeq || submittedKw.value != kw) {
          return;
        }
        if (collapse) {
          msgAllLoading.value = false;
        } else {
          msgLoading.value = false;
        }
        if (apiResCode(res) != SUCCESS_CODE) {
          if (collapse) {
            msgAllRows.value = [];
          } else {
            msgRows.value = [];
          }
          return;
        }
        const rows = parseMsgItems(res);
        if (collapse) {
          msgAllRows.value = rows;
          msgAllLoadedKw = kw;
        } else {
          msgRows.value = rows;
          msgLoadedKw = kw;
        }
        if (rows.length > 0) {
          ensureConvBriefs();
        }
      })
      .catch((_e: any | null) => {
        if (seq != searchSeq || submittedKw.value != kw) {
          return;
        }
        if (collapse) {
          msgAllLoading.value = false;
          msgAllRows.value = [];
        } else {
          msgLoading.value = false;
          msgRows.value = [];
        }
      });
  }


  /** 联系人搜索（全部/联系人 tab 共用一份数据）。 */
  function fetchContacts(): void {
    const seq = searchSeq;
    const kw = submittedKw.value;
    contactsLoading.value = true;
    apiImSearchContacts(kw, CONTACT_LIMIT)
      .then((res: RequestResponse<any>) => {
        if (seq != searchSeq || submittedKw.value != kw) {
          return;
        }
        contactsLoading.value = false;
        if (apiResCode(res) != SUCCESS_CODE) {
          contactRows.value = [];
          contactsDegraded.value = false;
          return;
        }
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        const rows: ContactHit[] = [];
        let degraded = false;
        if (dataObj != null) {
          degraded = readBool(dataObj, "degraded");
          const itemsRaw = dataObj["items"];
          if (itemsRaw != null) {
            const items = itemsRaw as UTSJSONObject[];
            for (let i = 0; i < items.length; i++) {
              const hit = new ContactHit();
              hit.userId = readString(items[i], "userId");
              hit.displayName = contactDisplayName(
                readString(items[i], "nickName"),
                readString(items[i], "userName"),
              );
              hit.avatar = readString(items[i], "avatar");
              hit.p2pConvId = readString(items[i], "p2pConvId");
              hit.fromLocal = readBool(items[i], "fromLocalFallback");
              if (hit.userId.length > 0) {
                rows.push(hit);
              }
            }
          }
        }
        contactRows.value = rows;
        contactsDegraded.value = degraded;
        contactsLoadedKw = kw;
      })
      .catch((_e: any | null) => {
        if (seq != searchSeq || submittedKw.value != kw) {
          return;
        }
        contactsLoading.value = false;
        contactRows.value = [];
        contactsDegraded.value = false;
      });
  }

  /** 提交关键词：按当前 tab 触发所需请求（已加载同关键词的跳过）。 */
  function runSearch(): void {
    const kw = submittedKw.value;
    searchSeq++;
    if (kw.length == 0) {
      msgRows.value = [];
      msgAllRows.value = [];
      contactRows.value = [];
      contactsDegraded.value = false;
      msgLoading.value = false;
      msgAllLoading.value = false;
      contactsLoading.value = false;
      return;
    }
    if (activeTab.value == "all") {
      if (msgAllLoadedKw != kw && !msgAllLoading.value) {
        fetchMessages(true);
      }
      if (contactsLoadedKw != kw && !contactsLoading.value) {
        fetchContacts();
      }
      ensureGroups();
      return;
    }
    if (activeTab.value == "messages") {
      if (msgLoadedKw != kw && !msgLoading.value) {
        fetchMessages(false);
      }
      ensureConvBriefs();
      return;
    }
    if (activeTab.value == "contacts") {
      if (contactsLoadedKw != kw && !contactsLoading.value) {
        fetchContacts();
      }
      return;
    }
    ensureGroups();
  }

  function switchTab(tab: string): void {
    if (activeTab.value == tab) {
      return;
    }
    activeTab.value = tab;
    // 切 tab 时关键词已提交但该 tab 数据未取：补拉
    if (submittedKw.value.length > 0) {
      runSearch();
    }
  }

  // ===== 输入事件 =====

  function handleInputFocus(): void {
    inputFocused.value = true;
  }

  function handleInputBlur(): void {
    inputFocused.value = false;
  }

  function handleContactAvatarError(row: ContactHit): void {
    row.avatarFailed = true;
  }

  function handleGroupAvatarError(row: GroupHit): void {
    row.avatarFailed = true;
  }

  function submitKeyword(kw: string): void {
    if (kw == submittedKw.value && kw.length > 0) {
      return;
    }
    submittedKw.value = kw;
    runSearch();
  }

  /** 防抖提交：边输边搜（飞书式），但逐字不直接打 ES。 */
  function handleSearchDebounced(value: string): void {
    if (debounceTimer != 0) {
      clearTimeout(debounceTimer);
      debounceTimer = 0;
    }
    debounceTimer = setTimeout(() => {
      debounceTimer = 0;
      submitKeyword(value.trim());
    }, DEBOUNCE_MS);
  }

  function onKeywordInput(e: UniInputEvent): void {
    if (e == null) {
      return;
    }
    handleSearchDebounced(e.detail.value);
  }

  function onKeywordConfirm(e: UniInputConfirmEvent): void {
    if (e == null) {
      return;
    }
    submitKeyword(e.detail.value.trim());
  }



  function handleClear(): void {
    keyword.value = "";
    if (debounceTimer != 0) {
      clearTimeout(debounceTimer);
      debounceTimer = 0;
    }
    submittedKw.value = "";
    runSearch();
  }

  // ===== 行点击 =====

  /** 进聊天页：搜索结果跳转会话可带 jumpMsgId 定位到具体消息（比 PC 只开会话更进一步，飞书同款）。 */
  function openChat(convId: string, convType: number, name: string, avatar: string, jumpMsgId: string): void {
    let url =
      `/pages/message/chat?convId=${convId}&convType=${convType}` +
      `&name=${encodeURIComponent(name)}&avatar=${encodeURIComponent(avatar)}`;
    if (jumpMsgId.length > 0) {
      url += `&jumpMsgId=${jumpMsgId}`;
    }
    uni.navigateTo({ url });
  }

  function handleMsgTap(row: MsgHit): void {
    if (row.convId.length == 0) {
      return;
    }
    openChat(row.convId, row.convType, msgTitle(row), msgAvatarSrc(row), row.msgId);
  }

  function handleGroupTap(row: GroupHit): void {
    if (row.convId.length == 0) {
      return;
    }
    openChat(row.convId, 2, row.displayName, row.avatarUrl, "");
  }

  /** 联系人点击：p2pConvId 非空直接进会话，空则 createP2p（幂等）后进（与消息页同款）。 */
  function handleContactTap(row: ContactHit): void {
    if (row.userId.length == 0 || contactOpening) {
      return;
    }
    if (row.p2pConvId.length > 0) {
      openChat(row.p2pConvId, 1, row.displayName, row.avatar, "");
      return;
    }
    contactOpening = true;
    apiImCreateP2pConversation(row.userId)
      .then((res: RequestResponse<any>) => {
        contactOpening = false;
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        const convId = dataObj != null ? readString(dataObj, "convId") : "";
        if (apiResCode(res) != SUCCESS_CODE || convId.length == 0) {
          uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
          return;
        }
        openChat(convId, 1, row.displayName, row.avatar, "");
      })
      .catch((_e: any | null) => {
        contactOpening = false;
        uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
      });
  }

  /** 按群号加入群聊（复用消息页底部弹窗；它是群组 tab 的第二条出路——搜不到 ≠ 群不存在）。 */
  function handleJoinTap(): void {
    const proxy = joinSheetRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod("open");
  }

  /** 入群申请已提交：刷新群组缓存与会话映射（免审批群会立即出现）。 */
  function handleJoinedGroup(): void {
    groupsLoaded = false;
    convBriefsLoaded = false;
    ensureGroups();
    ensureConvBriefs();
  }

  // ===== 展示辅助 =====

  function groupMemberLabel(row: GroupHit): string {
    const params = new Map<string, string | number>();
    params.set("count", row.memberCount);
    return translateFn(
      "Mobile.Message.groupMemberCount",
      toI18nParams(params),
      `${row.memberCount}`,
    );
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  function pad2(n: number): string {
    return n < 10 ? `0${n}` : `${n}`;
  }

  function isSameDay(a: Date, b: Date): boolean {
    return (
      a.getFullYear() == b.getFullYear() &&
      a.getMonth() == b.getMonth() &&
      a.getDate() == b.getDate()
    );
  }

  /** 搜索行时间：今天 HH:mm / 昨天 HH:mm / 今年 M月D日 HH:mm / 跨年 YYYY年M月D日。 */
  function formatHitTime(ts: number): string {
    if (ts <= 0) {
      return "";
    }
    const date = new Date(ts);
    const now = new Date();
    if (isSameDay(date, now)) {
      return `${pad2(date.getHours())}:${pad2(date.getMinutes())}`;
    }
    const yesterday = new Date(now.getTime() - 86400000);
    if (isSameDay(date, yesterday)) {
      return `${t("Mobile.Message.yesterday")} ${pad2(date.getHours())}:${pad2(date.getMinutes())}`;
    }
    if (date.getFullYear() == now.getFullYear()) {
      return `${date.getMonth() + 1}月${date.getDate()}日 ${pad2(date.getHours())}:${pad2(date.getMinutes())}`;
    }
    return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;
  }

  function handleBack(): void {
    // 刷新后栈底保护：同 chat.uvue，无页可退时切回消息 tab，避免整页重载死循环
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      uni.switchTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((_options: any) => {
    // 进入即聚焦（飞书交互）；#ifndef MP 平台在 onMounted 里聚焦
    // #ifdef MP-WEIXIN
    autoFocus.value = true;
    // #endif
  });

  onMounted(() => {
    nextTick(() => {
      const input = searchInputRef.value;
      if (input != null) {
        input.focus();
      }
    });
  });

  onUnmounted(() => {
    if (debounceTimer != 0) {
      clearTimeout(debounceTimer);
      debounceTimer = 0;
    }
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架 ===== */
  .ims-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #f6f5fb;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  /* ===== 顶部搜索框 + 取消 ===== */
  .ims-header {
    flex-shrink: 0;
    padding: 16rpx 24rpx 8rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .ims-search-box {
    flex: 1;
    min-width: 0;
    height: 76rpx;
    padding: 0 24rpx;
    border-radius: 38rpx;
    background-color: #ffffff;
    border: 2rpx solid rgba(81, 71, 255, 0);
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .ims-search-box--focus {
    border: 2rpx solid rgba(81, 71, 255, 0.45);
  }

  .ims-search-input {
    flex: 1;
    min-width: 0;
    margin: 0 16rpx;
    font-size: 30rpx;
    line-height: 42rpx;
    color: #17171a;
    background-color: rgba(0, 0, 0, 0);
  }

  .ims-search-ph {
    color: #b0aebc;
    font-size: 30rpx;
  }

  .ims-clear {
    width: 48rpx;
    height: 48rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ims-cancel {
    flex-shrink: 0;
    height: 76rpx;
    padding: 0 8rpx 0 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .ims-cancel--active {
    opacity: 0.7;
  }

  .ims-cancel__text {
    font-size: 30rpx;
    line-height: 42rpx;
    color: #5147ff;
  }

  /* ===== 筛选 pill ===== */
  .ims-pills {
    flex-shrink: 0;
    height: 92rpx;
    padding: 0 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .ims-pill {
    height: 60rpx;
    padding: 0 30rpx;
    margin-right: 16rpx;
    border-radius: 30rpx;
    background-color: #ecebf3;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .ims-pill--on {
    background-color: rgba(81, 71, 255, 0.12);
  }

  .ims-pill__text {
    font-size: 26rpx;
    line-height: 36rpx;
    color: #55535f;
  }

  .ims-pill__text--on {
    color: #5147ff;
    font-weight: 600;
  }

  /* ===== 结果区 ===== */
  .ims-body {
    flex: 1;
    min-height: 0;
  }

  .ims-state {
    padding: 200rpx 48rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ims-state--thin {
    padding: 48rpx 48rpx;
  }

  .ims-state__text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #9a98a5;
  }

  /* 联系人搜索降级提示 */
  .ims-degraded {
    margin: 8rpx 32rpx 4rpx;
    padding: 12rpx 20rpx;
    border-radius: 12rpx;
    background-color: rgba(255, 171, 0, 0.1);
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .ims-degraded__text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #b57b00;
  }

  /* ===== 聚合分区头 ===== */
  .ims-section-head {
    height: 72rpx;
    padding: 0 32rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .ims-section-head__title {
    font-size: 24rpx;
    line-height: 34rpx;
    font-weight: 600;
    color: #9a98a5;
  }

  .ims-section-head__more {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .ims-section-head__more-text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #9a98a5;
  }

  /* ===== 结果行（头像 + 标题/摘要 + 右侧时间） ===== */
  .ims-row {
    padding: 26rpx 32rpx;
    display: flex;
