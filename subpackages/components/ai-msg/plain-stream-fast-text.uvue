<template>
  <PlainStreamFrozenText :chunks="frozenChunks" :text-style="textStyle" />
  <text v-if="liveChunk.length > 0" class="plain-stream-live-text" :style="textStyle">{{ liveChunk }}</text>
</template>

<script lang="uts" setup>
  import PlainStreamFrozenText from "@/subpackages/components/ai-msg/plain-stream-frozen-text.uvue";
  import {
    nextPlainStreamRevealEnd,
    PLAIN_STREAM_TICK_MS,
  } from "@/subpackages/components/ai-msg/plainStreamDisplay.uts";

  const props = withDefaults(
    defineProps<{
      initialText?: string;
      pacing?: boolean;
      textStyle?: string;
    }>(),
    {
      initialText: "",
      pacing: false,
      textStyle: "",
    },
  );

  const emit = defineEmits<{
    caughtUp: [];
  }>();

  const frozenChunks = ref<string[]>([] as string[]);
  const liveChunk = ref<string>("");
  let displayText: string = "";
  let targetText: string = "";
  let frozenLength: number = 0;
  let timer: number = 0;
  const FREEZE_CHUNK_CHARS: number = 512;

  function clearTimer(): void {
    if (timer != 0) {
      clearTimeout(timer);
      timer = 0;
    }
  }

  function paint(text: string): void {
    const previous = displayText;
    displayText = text;
    if (text.indexOf(previous) != 0 || text.length < frozenLength) {
      frozenChunks.value = [] as string[];
      frozenLength = 0;
    }
    const unfrozen = text.substring(frozenLength);
    if (unfrozen.length >= FREEZE_CHUNK_CHARS) {
      const cut = unfrozen.lastIndexOf("\n");
      if (cut > 0) {
        const nextChunks = frozenChunks.value.slice();
        nextChunks.push(unfrozen.substring(0, cut));
        frozenChunks.value = nextChunks;
        frozenLength = frozenLength + cut + 1;
      }
    }
    liveChunk.value = text.substring(frozenLength);
    if (displayText == targetText) {
      emit("caughtUp");
    }
  }

  function scheduleTick(): void {
    if (timer != 0) return;
    timer = setTimeout((): void => {
      timer = 0;
      if (targetText.indexOf(displayText) != 0) {
        paint(targetText);
        return;
      }
      const end = nextPlainStreamRevealEnd(displayText.length, targetText);
      paint(targetText.substring(0, end));
      if (end < targetText.length) scheduleTick();
    }, PLAIN_STREAM_TICK_MS) as number;
  }

  function updateText(text: string, pacing: boolean): void {
    const previousTargetLength = targetText.length;
    const wasBehindPreviousTarget = displayText.length < previousTargetLength;
    const visibleBatchChars = text.length - previousTargetLength;
    targetText = text;
    // 原始 SSE 可能是密集小块，但经过 24ms UI 合并后形成一次几十字的可见突发。
    // 在叶子层按实际目标增量兜底，避免只看 raw chunk 的 p95/maxChunk 时误判为无需匀速。
    const shouldPace =
      pacing == true ||
      visibleBatchChars > 16 ||
      wasBehindPreviousTarget == true;
    if (shouldPace != true) {
      clearTimer();
      paint(text);
      return;
    }
    scheduleTick();
  }

  function isCaughtUp(): boolean {
    return displayText == targetText;
  }

  watch(
    (): string => props.initialText,
    (text: string) => updateText(text, props.pacing),
    { immediate: true },
  );

  onUnmounted(() => clearTimer());

  defineExpose({ updateText, isCaughtUp });
</script>

<style lang="scss">
  .plain-stream-live-text {
    width: 100%;
    color: #404040;
    font-size: 32rpx;
    line-height: 48rpx;
    white-space: pre-wrap;
  }
</style>
