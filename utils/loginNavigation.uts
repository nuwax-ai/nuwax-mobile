import { redirectTo } from "@/utils/common";
import { resolveMobileAuthReturn, resolvePendingAuthReturn, mobileAuthWebReturn } from "@/utils/authIdp";
import { authBrowserOrigin, canUseBrowserIdp } from "@/utils/idpNavigation";

/** 密码、验证码和 IdP 回跳共用；业务返回与后端 pending 续接分别校验。 */
export function navigateAfterMobileLogin(responseRedirect: string, requestedReturn: string): void {
  const origin = authBrowserOrigin();
  // #ifdef H5 || WEB
  if (canUseBrowserIdp()) {
    const responsePending = resolvePendingAuthReturn(responseRedirect, origin);
    const requestedPending = resolvePendingAuthReturn(requestedReturn, origin);
    const pending = responsePending.length > 0 ? responsePending : requestedPending;
    if (pending.length > 0) {
      window.location.replace(pending);
      return;
    }
  }
  window.location.replace(mobileAuthWebReturn(responseRedirect.length > 0 ? responseRedirect : requestedReturn, origin));
  return;
  // #endif
  // #ifndef H5 || WEB
  redirectTo(resolveMobileAuthReturn(requestedReturn));
  // #endif
}
