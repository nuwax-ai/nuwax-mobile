<template>
  <view class="subscribed-credits">
    <view v-if="loading" class="loading-state">
      <text class="loading-text">...</text>
    </view>

    <view v-else-if="list.length == 0" class="empty-wrapper">
      <empty-state text="Mobile.MySubscriptions.empty" />
    </view>

    <view v-else class="credit-list">
      <view v-for="item in list" :key="item.id" class="credit-card">
        <!-- 头部 -->
        <view class="credit-header">
          <text class="credit-name">
            {{
              item.remark.length > 0 ? item.remark : item.batchNo
            }}
          </text>
          <text class="credit-date">{{
            formatDateLocal(item.created, "YYYY-MM-DD")
          }}</text>
        </view>

        <!-- 数据四宫格 -->
        <view class="credit-grid">
          <view class="grid-item">
            <text class="grid-label">{{
              t("Mobile.MySubscriptions.totalCredits")
            }}</text>
            <text class="grid-value"
              >+{{ formatNumberLocal(item.totalAmount, 0) }}</text
            >
          </view>
          <view class="grid-item">
            <text class="grid-label">{{
              t("Mobile.MySubscriptions.usedAmount")
            }}</text>
            <text class="grid-value">{{
              formatNumberLocal(item.usedAmount, 0)
            }}</text>
          </view>
          <view class="grid-item">
            <text class="grid-label">{{
              t("Mobile.MySubscriptions.expireTime")
            }}</text>
            <text class="grid-value">{{
              formatDateLocal(item.expireTime, "YYYY-MM-DD")
            }}</text>
          </view>
          <view class="grid-item">
            <text class="grid-label">{{
              t("Mobile.MySubscriptions.purchaseAmount")
            }}</text>
            <text
              class="grid-value highlight-price"
              >{{ getPriceText(item) }}</text
            >
          </view>
        </view>

        <!-- 底部 -->
        <view class="credit-footer">
          <text class="footer-remain">
            {{
              `${t("Mobile.MySubscriptions.remaining")}：${formatNumberLocal(item.remainAmount, 0)} ${t("Mobile.MySubscriptions.creditUnit")}`
            }}
          </text>
          <view
            class="status-tag"
            :class="getCreditStatus(item).cls"
          >
            <text class="status-text">{{ getCreditStatus(item).text }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { SUCCESS_CODE } from "@/constants/codes.constants.uts";
  import { apiGetCreditBatches } from "@/subpackages/servers/subscription";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import {
    normalizeCreditBatchList,
    type CreditBatchItemView,
  } from "@/subpackages/utils/subscriptionAdapter";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import EmptyState from "@/components/empty-state/empty-state.uvue";
  import { formatDate, formatNumber } from "@/utils/system";
  import { toStringRecord } from "@/utils/common";

  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");
  // uvue 模板中直接调用 t() 会报 invoke 解析失败，这里包一层单参版本
  // uvue 模板里直接调用导入函数会报 invoke 解析失败，包一层本地 const
  const formatNumberLocal = (value: any, precision: number): string =>
    formatNumber(value, precision);
  const formatDateLocal = (
    input: string | number | Date,
    format: string,
  ): string => formatDate(input, format);

  const list = ref<CreditBatchItemView[]>([]);
  const loading = ref(true);

  // UTS 对象字面量只能匹配 type 别名（非 interface）
  type CreditStatus = {
    text: string;
    cls: string;
  };

  // 所有分支均有返回，返回类型为非空 CreditStatus
  const getCreditStatus = (item: CreditBatchItemView): CreditStatus => {
    if (item.expired) {
      return {
        text: t("Mobile.MySubscriptions.expired"),
        cls: "status-expired",
      } as CreditStatus;
    }
    if (item.remainAmount <= 0) {
      return {
        text: t("Mobile.MySubscriptions.fullyUsed"),
        cls: "status-expired",
      } as CreditStatus;
    }
    const ratio = item.totalAmount > 0 ? item.usedAmount / item.totalAmount : 0;
    if (ratio >= 0.8) {
      return {
        text: t("Mobile.MySubscriptions.aboutToUseUp"),
        cls: "status-warning",
      } as CreditStatus;
    }
    return {
      text: t("Mobile.MySubscriptions.normalUsage"),
      cls: "status-active",
    } as CreditStatus;
  };

  // 安全读取 extra.price（extra 可能为 null）
  const getPriceText = (item: CreditBatchItemView): string => {
    const extra = item.extra;
    if (extra == null) {
      return "-";
    }
    const price = extra.price;
    if (price == null) {
      return "-";
    }
    return `¥ ${formatNumber(price, 2)}`;
  };

  const fetchData = async () => {
    loading.value = true;
    try {
      const batchParams = new Map<string, string>();
      batchParams.set("creditType", "PURCHASE");
      const res = await apiGetCreditBatches(toStringRecord(batchParams));
      if (apiResCode(res) == SUCCESS_CODE) {
        list.value = normalizeCreditBatchList(apiResData<any>(res));
      }
    } catch (e) {
      // ignore
    } finally {
      loading.value = false;
    }
  };

  onMounted(() => {
    fetchData();
  });
</script>

<style lang="scss" scoped>
  // vapor: 全部反嵌套为顶层单类规则（drops descendant/compound selectors）。
  // .status-active / .status-warning / .status-expired 原作用于 .status-tag 父级，
  // 并经后代选择器下传 .status-text 颜色；color 上提到修饰类本身，
  // 子 <text class="status-text"> 经隐式 color 继承获得（.status-text 无显式 color）。
  .subscribed-credits {
    min-height: 200rpx;
  }

  .loading-state {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80rpx 0;
  }

  .loading-text {
    font-size: 28rpx;
    color: #999;
  }

  .empty-wrapper {
    padding: 40rpx 0;
  }

  .credit-list {
    display: flex;
    flex-direction: column;
  }

  .credit-card {
    margin-bottom: 16rpx;
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    overflow: hidden;
    border: 2rpx solid #e5e6eb;
  }

  .credit-card:last-child {
    margin-bottom: 0;
  }

  .credit-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
  }

  .credit-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 16rpx;
  }

  .credit-date {
    font-size: 22rpx;
    color: #999;
    flex-shrink: 0;
  }

  .credit-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: -16rpx;
    margin-bottom: -16rpx;
    padding: 20rpx 0;
    border-top: 2rpx solid #e5e6eb;
  }

  .grid-item {
    /* #ifdef H5 */
    width: calc(50% - 8rpx);
    /* #endif */
    /* #ifndef H5 */
    width: 48%;
    /* #endif */
    display: flex;
    flex-direction: column;
    // margin-right: 16rpx;
    margin-bottom: 16rpx;
  }

  .grid-label {
    font-size: 22rpx;
    color: #999;
    margin-bottom: 8rpx;
  }

  .grid-value {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
  }

  // vapor: 原 &.highlight-price（复合于 .grid-value），反嵌套为单类；
  // 置于 .grid-value 之后以源序覆盖 color（元素为 <text class="grid-value highlight-price">）
  .highlight-price {
    color: #f59e0b;
  }

  .credit-footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 20rpx -24rpx -24rpx -24rpx;
    padding: 24rpx 24rpx;
    background: #f8fafc;
    border-top: 2rpx solid #e5e6eb;
  }

  .footer-remain {
    font-size: 24rpx;
    color: #666;
  }

  .status-tag {
    padding: 4rpx 16rpx;
    border-radius: 6rpx;
  }

  .status-text {
    font-size: 22rpx;
    font-weight: 500;
  }

  // vapor: 原 &.status-*（复合）+ 后代 .status-* .status-text（违例）合并为单类：
  // background 与 color 都上提到修饰类本身，color 经隐式继承下达到 .status-text
  .status-active {
    background: rgba(82, 196, 26, 0.1);
    color: #52c41a;
  }

  .status-warning {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
  }

  .status-expired {
    background: rgba(255, 77, 79, 0.1);
    color: #ff4d4f;
  }
</style>
