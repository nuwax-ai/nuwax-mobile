import {
  DEFAULT_LANG,
  I18N_LANG_STORAGE_KEY,
} from "@/constants/i18n.constants";
import { getLocalFallback } from "@/constants/i18n.local.constants";

/** 基础请求/文件工具的错误文案只读本地词包，避免反向依赖 Vue 和网络初始化。 */
export function localText(key: string): string {
  let lang = DEFAULT_LANG;
  try {
    const stored = uni.getStorageSync(I18N_LANG_STORAGE_KEY);
    if (stored != null && `${stored}`.length > 0) lang = `${stored}`;
  } catch (_error) {
    // 登录前或存储不可用时继续使用默认词包。
  }
  return getLocalFallback(lang, key);
}
