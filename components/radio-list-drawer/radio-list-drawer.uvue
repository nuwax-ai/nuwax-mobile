<template>
  <drawer-popup
    :show="visible"
    direction="bottom"
    :title="title"
    height="50vh"
    :auto-height="false"
    max-height="70%"
    @update-visible="handleUpdateVisible"
  >
    <scroll-view
      class="drawer-content"
      :scroll-y="true"
      :show-scrollbar="false"
    >
      <view v-if="loading" class="loading-container">
        <text class="loading-text">...</text>
      </view>
      <!-- Android：只 v-for 一个 string[]，禁止模板里再取 classList[index] -->
      <view v-else class="radio-group">
        <view
          v-for="(row, index) in rowList"
          :key="index"
          class="radio-item"
          @tap="handleItemTapByIndex(index)"
        >
          <text class="radio-text">{{ row }}</text>
        </view>
      </view>
    </scroll-view>
  </drawer-popup>
</template>

<script lang="uts" setup>
  import { computed } from "vue";
  import { RadioListItem } from "@/types/interfaces/radio";

  const props = withDefaults(
    defineProps<{
      visible: boolean;
      title: string;
      list: RadioListItem[];
      currentValue?: string;
      readonly?: boolean;
      maxHeight?: string;
      loading?: boolean;
    }>(),
    {
      visible: false,
      title: "",
      list: () => [] as RadioListItem[],
      currentValue: "",
      readonly: false,
      /* #ifdef H5 */
      maxHeight: "70vh",
      /* #endif */
      /* #ifndef H5 */
      maxHeight: "70%",
      /* #endif */
      loading: false,
    },
  );

  const emit = defineEmits<{
    (e: "onClose"): void;
    (e: "onChange", value: string): void;
  }>();

  const currentValueSafe = computed((): string => {
    const v = props.currentValue;
    return v != null ? `${v}` : "";
  });

  /** 展示文案（选中项带 ✓），模板只依赖这一份数组 */
  const rowList = computed((): string[] => {
    const raw = props.list;
    const result: string[] = [];
    if (raw == null) {
      return result;
    }
    const cur = currentValueSafe.value;
    for (let i = 0; i < raw.length; i++) {
      const src = raw[i];
      if (src == null) {
        result.push("");
        continue;
      }
      const label = src.label != null ? `${src.label}` : "";
      const value = src.value != null ? `${src.value}` : "";
      if (value == cur && label.length > 0) {
        result.push(label + "  ✓");
      } else {
        result.push(label);
      }
    }
    return result;
  });

  const valueList = computed((): string[] => {
    const raw = props.list;
    const result: string[] = [];
    if (raw == null) {
      return result;
    }
    for (let i = 0; i < raw.length; i++) {
      const src = raw[i];
      if (src == null) {
        result.push("");
        continue;
      }
      result.push(src.value != null ? `${src.value}` : "");
    }
    return result;
  });

  const disabledList = computed((): boolean[] => {
    const raw = props.list;
    const result: boolean[] = [];
    if (raw == null) {
      return result;
    }
    const readonly = props.readonly == true;
    for (let i = 0; i < raw.length; i++) {
      const src = raw[i];
      result.push(readonly || (src != null && src.disabled == true));
    }
    return result;
  });

  const handleUpdateVisible = (val: boolean) => {
    if (val != true) {
      emit("onClose");
    }
  };

  const handleItemTapByIndex = (index: number) => {
    const values = valueList.value;
    const disableds = disabledList.value;
    if (index < 0 || index >= values.length) {
      return;
    }
    if (disableds[index] == true) {
      return;
    }
    const value = values[index];
    if (value != null && value.length > 0 && value != currentValueSafe.value) {
      emit("onChange", value);
    }
    emit("onClose");
  };
</script>

<style lang="scss" scoped>
  .drawer-content {
    height: 100%;
    padding: 0 40rpx;
    /* #ifdef H5 || MP-WEIXIN */
    overflow-y: auto;
    /* #endif */
    /* #ifdef APP */
    overflow: hidden;
    /* #endif */
    box-sizing: border-box;

    .radio-group {
      display: flex;
      flex-direction: column;
      width: 100%;

      .radio-item {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 28rpx 0;
        border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);

        .radio-text {
          font-size: 30rpx;
          color: #1a1a1a;
          font-weight: 400;
        }
      }
    }
  }

  .loading-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 60rpx 0;
    width: 100%;

    .loading-text {
      font-size: 28rpx;
      color: #999;
    }
  }
</style>
