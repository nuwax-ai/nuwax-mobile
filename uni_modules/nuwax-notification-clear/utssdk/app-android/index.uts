// nuwax-notification-clear · app-android
//
import Context from "android.content.Context";
import NotificationManager from "android.app.NotificationManager";

/**
 * 清空本 App 在通知栏里已展示的全部通知。
 *
 * NotificationManager.cancelAll() 只作用于「同 uid 发布的通知」：厂商通道
 * （hms / oppo / vivo / honor）最终也是以本应用包名投递到通知栏，所以一并清掉；
 * 其他 App 的通知不受影响。
 *
 * 注意：
 * - 不需要通知权限（清自己的通知不是敏感操作），未授权时调用也不会抛。
 * - 从 activeNotifications 读取厂商通知的 tag/id，保留通话前台服务通知。
 * - 会连带清掉「常驻通知」（如厂商推送服务自身的通道提示），系统允许，且重连时
 *   SDK 会自己重建；通话的 nuwax-voip 通道必须保留。
 */
export function clearAppNotifications(): void {
  try {
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) {
      // 冷启动极早期 / Activity 尚未就绪：本次跳过（下一次 onShow 会再清一次）
      return;
    }
    const manager = activity.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager;
    if (manager == null) {
      return;
    }
    const notifications = manager.getActiveNotifications();
    for (const item of notifications) {
      if (item.getNotification().getChannelId() != "nuwax-voip") manager.cancel(item.getTag(), item.getId());
    }
  } catch (e) {
    console.error("[NotificationClear][android] cancelAll fail:", e);
  }
}
