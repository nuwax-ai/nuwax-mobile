<template>
  <scroll-view
    class="files-container"
    direction="horizontal"
    :scroll-x="true"
    :scroll-y="false"
    :scroll-with-animation="true"
    :show-scrollbar="false"
  >
    <view class="files-scroll-content">
      <template v-for="file in files" :key="resolveUploadItemKey(file)">
        <!-- 如果文件是图片，则显示图片，否则显示文档默认图片 -->
        <view
          class="files-box relative"
          :class="[
            isImageFile(file) == false
              ? 'files-box-file'
              : 'files-box-image',
            isFileError(file) ? 'files-box-error' : '',
          ]"
          @click="onPreview(file)"
        >
          <view
            class="files-box-loading"
            v-if="isFileUploading(file)"
          >
            <!-- App：CSS animation 对 image 无效，用 spin-loading -->
            <!-- #ifdef APP -->
            <spin-loading size="48rpx" color="#3bb346" :duration-ms="800" />
            <!-- #endif -->
            <!-- #ifndef APP -->
            <image
              class="icon-loading-image"
              src="@/static/assets/image_loading.svg"
              alt=""
            />
            <!-- #endif -->
          </view>
          <!-- 图片 -->
          <image
            class="files-box__image"
            v-if="isImageFile(file)"
            :src="fileUrl(file)"
            mode="aspectFill"
            :alt="fileName(file).length > 0 ? fileName(file) : t('Mobile.Chat.uploadImageAlt')"
          />
          <!-- 文件 -->
          <template v-else>
            <image
              class="doc-image"
              :src="docImage"
              mode="aspectFill"
              :alt="t('Mobile.Chat.uploadFileAlt')"
            />
            <view class="doc-info-container">
              <text class="doc-name">{{ fileName(file) }}</text>
              <text class="doc-size">{{ formatFileSize(fileSize(file)) }}</text>
            </view>
          </template>
          <!-- 删除按钮 -->
          <view
            v-if="isFileUploading(file) == false"
            class="del-container"
            @click.stop="emitDel(file)"
          >
            <image
              src="@/static/assets/x-circle-fill.svg"
              mode="aspectFit"
              style="width: 40rpx; height: 40rpx"
              :alt="t('Mobile.Common.deleteIconAlt')"
            />
          </view>
        </view>
      </template>
      <!-- 添加按钮 -->
      <view
        class="files-box files-box-plus"
        @click="emit('onAdd')"
        v-if="showAdd"
      >
        <svg-icon name="icon-Plus" />
      </view>
    </view>
  </scroll-view>
</template>

<script lang="uts" setup>
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

  import { computed } from "vue";
  import docImage from "@/static/assets/doc_image.png";
  import { formatBytes } from "@/utils/byteConverter";
  import { UploadFileStatus } from "@/types/enums/common";
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  import { isUploadImageLike } from "../chatInputActions.uts";
  // #ifdef APP
  import SpinLoading from "@/subpackages/components/spin-loading/spin-loading.uvue";
  // #endif

  const props = defineProps<{
    // Android 会将父组件 ref 数组元素包装为 UTSReactiveJSONObject。
    files: UTSJSONObject[];
    showAddButton?: boolean;
  }>();

  const emit = defineEmits<{
    (e: 'onAdd'): void;
    (e: 'onDel', uid: string): void;
  }>();
  const { t: tFn } = useI18n();
  const t = (key: string): string => tFn(key, emptyI18nParams(), "");

  // 模板辅助：UTS 模板不能直接引用枚举类，且需规避 ?. / ! / ===
  const getFileType = (file: UTSJSONObject): string => {
    const value = file["type"] as string | null;
    return value != null ? value : "";
  };
  const fileUrl = (file: UTSJSONObject): string => {
    const value = file["url"] as string | null;
    return value != null ? value : "";
  };
  const fileName = (file: UTSJSONObject): string => {
    const value = file["name"] as string | null;
    return value != null ? value : "";
  };
  /** 列表 key：优先 uid（上传前后 url 会变，不能用 url 当 key） */
  const resolveUploadItemKey = (file: UTSJSONObject): string => {
    const value = file["uid"] as string | null;
    if (value != null && `${value}`.length > 0) {
      return `${value}`;
    }
    return fileUrl(file);
  };
  /** App chooseImage 常无 type，需用 name/url 扩展名兜底。 */
  const isImageFile = (file: UTSJSONObject): boolean => {
    return isUploadImageLike(getFileType(file), fileName(file), fileUrl(file));
  };
  const fileStatusText = (file: UTSJSONObject): string => {
    const value = file["status"];
    return value != null ? `${value}` : "";
  };
  const isFileError = (file: UTSJSONObject): boolean =>
    fileStatusText(file) == `${UploadFileStatus.error}`;
  const isFileUploading = (file: UTSJSONObject): boolean =>
    fileStatusText(file) == `${UploadFileStatus.uploading}`;

  const previewImages = computed((): string[] => {
    const urls: string[] = [];
    const list = props.files;
    const listLen = list.length;
    for (let i = 0; i < listLen; i++) {
      const file = list[i] as UTSJSONObject;
      if (isImageFile(file) == true) {
        const url = fileUrl(file);
        if (url.length > 0) {
          urls.push(url);
        }
      }
    }
    return urls;
  });
  const fileSize = (file: UTSJSONObject): number => {
    const value = file["size"] as number | null;
    return value != null ? value : 0;
  };
  const emitDel = (file: UTSJSONObject): void => {
    const uid = file["uid"] as string | null;
    emit("onDel", uid != null ? uid : "");
  };
  const showAdd = computed((): boolean => props.showAddButton == true);
  const formatFileSize = (bytes: number): string => formatBytes(bytes);

  // 预览图片
  const onPreview = (file: UTSJSONObject) => {
    if (isImageFile(file) == false) {
      uni.showToast({
        title: t("Mobile.Chat.previewTypeUnsupported"),
        icon: "none",
        duration: 1500,
      });
      return;
    }
    const urls = previewImages.value;
    let currentUrl = "";
    if (file["url"] != null) {
      currentUrl = file["url"] as string;
    }
    uni.previewImage({
      urls,
      current: currentUrl,
    });
  };
</script>

<style lang="scss" scoped>
  /* 对齐 manual-component-bar：App 横滑依赖 direction + scroll-view 自身 flex-direction:row */
  .files-container {
    width: 100%;
    height: 132rpx;
    flex-direction: row;
    /* #ifndef APP */
    scroll-behavior: smooth;
    /* #endif */
    /* #ifdef H5 || MP-WEIXIN */
    -webkit-overflow-scrolling: touch;
    /* #endif */
  }

  .files-scroll-content {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    height: 132rpx;
    /* #ifdef H5 */
    width: max-content;
    /* #endif */
  }

  .files-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    flex: none;
    border-radius: 16rpx;
    margin-right: 10rpx;
    overflow: hidden;
    border: 2rpx solid transparent;
  }

  .files-box-loading {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background: rgba(64, 62, 62, 0.15);
  }

  .icon-loading-image {
    width: 48rpx;
    height: 48rpx;
    border-radius: 24rpx;
    /* #ifndef APP */
    animation: chat-upload-spin 1s linear infinite;
    /* #endif */
  }

  .files-box-plus {
    width: 128rpx;
    height: 128rpx;
    background: #f6f6f6;
  }

  .files-box-image {
    width: 128rpx;
    height: 128rpx;
    background: #f6f6f6;
  }

  .files-box-error {
    border-color: #f93920;
  }

  .files-box-file {
    width: 400rpx;
    padding: 16rpx;
    background: rgba(12, 20, 102, 0.04);
    overflow: hidden;
  }

  .doc-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96rpx;
    height: 96rpx;
    margin-right: 8rpx;
  }

  .doc-info-container {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    font-weight: 400;
  }

  .doc-name,
  .doc-size {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* #ifdef APP */
    lines: 1;
    /* #endif */
  }

  .doc-name {
    font-size: 28rpx;
    color: #15171f;
    margin-bottom: 4rpx;
  }

  .doc-size {
    font-size: 24rpx;
    color: #828894;
  }

  .files-box__image {
    width: 100%;
    height: 100%;
  }

  .del-container {
    position: absolute;
    top: 4rpx;
    right: 4rpx;
    z-index: 10;
  }

  /* #ifndef APP */
  @keyframes chat-upload-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  /* #endif */
</style>
