<template>
    <view
        class="katex-el"
        :class="[`ui-theme-${uiTheme}`, inline == true ? 'katex-el-inline' : '']"
        :style="rootStyle"
    >
        <!-- #ifdef WEB -->
        <view class="katex" v-if="html != null && html.length > 0" v-html="html"></view>
        <!-- #endif -->
        <image
            v-if="href != null && href.length > 0"
            :src="href"
            class="katex-el-katex-image"
            :class="inline == true ? 'katex-el-katex-image-inline' : ''"
            :mode="inline == true ? 'aspectFit' : 'widthFix'"
            :style="imageStyle"
        />
        <!-- #ifdef APP -->
        <!-- App 截图较慢：空白占位；H5 直接吃 resultHtml，无需占位 -->
        <view
            v-if="showPlaceholder == true"
            class="katex-el-placeholder"
            :class="inline == true ? 'katex-el-placeholder-inline' : ''"
            :style="placeholderStyle"
        />
        <!-- #endif -->
    </view>
</template>

<script lang="uts" setup>
    import {uiTheme} from '@/uni_modules/uni-ai-x/sdk'

    const props = defineProps<{
        html?: string
        href?: string
        width?: number
        height?: number
        /** 表格单元格等场景：按内容宽度收缩，避免撑满一行 */
        inline?: boolean
        /**
         * 保持截图原始尺寸（不缩小字号）。
         * 表格内公式用 true：宽度不足时由表格横向滚动，而不是压扁公式。
         */
        preserveSize?: boolean
    }>()

    /**
     * 行内公式目标高度（约等于正文 15~16px 字号下的 KaTeX 行盒）。
     * 标题等场景若回传物理像素/大画布尺寸，按此高度等比缩小。
     */
    const INLINE_TARGET_HEIGHT = 20
    /** 超过该高度视为异常偏大（物理像素或截到了大容器），需要缩放 */
    const INLINE_OVERSIZE_HEIGHT = 36

    /** App 最低高度用 rpx；H5 为空字符串表示不用 */
    let appBlockMinHeight = ''
    let appInlineMinHeight = ''
    // #ifdef APP
    appBlockMinHeight = '120rpx'
    appInlineMinHeight = '40rpx'
    // #endif

    // #ifdef APP
    const showPlaceholder = computed((): boolean => {
        const htmlLen = props.html != null ? props.html!.length : 0
        const hrefLen = props.href != null ? props.href!.length : 0
        return htmlLen == 0 && hrefLen == 0
    })

    /** 占位只撑开空间：一律 min-height（rpx） */
    const placeholderStyle = computed((): string => {
        if (props.inline == true) {
            return 'width:120rpx;min-height:' + appInlineMinHeight + ';background-color:transparent;'
        }
        return 'width:100%;min-height:' + appBlockMinHeight + ';background-color:transparent;'
    })
    // #endif

    /** 计算行内公式最终展示宽高（拆成两个 number，规避 UTS 对象字面量限制） */
    function resolveInlineDisplayWidth(): number {
        const rawW = props.width ?? 0
        const rawH = props.height ?? 0
        if (props.preserveSize == true) {
            return rawW > 0 ? rawW : 0
        }
        if (rawW <= 0 || rawH <= 0) {
            return 0
        }
        if (rawH <= INLINE_OVERSIZE_HEIGHT) {
            const maxH = 32
            if (rawH > maxH) {
                return Math.max(8, Math.ceil(rawW * (maxH / rawH)))
            }
            return rawW
        }
        return Math.max(8, Math.ceil(rawW * (INLINE_TARGET_HEIGHT / rawH)))
    }

    function resolveInlineDisplayHeight(): number {
        const rawW = props.width ?? 0
        const rawH = props.height ?? 0
        if (props.preserveSize == true) {
            return rawH > 0 ? rawH : 0
        }
        if (rawW <= 0 || rawH <= 0) {
            return INLINE_TARGET_HEIGHT
        }
        if (rawH <= INLINE_OVERSIZE_HEIGHT) {
            return rawH > 32 ? 32 : rawH
        }
        return INLINE_TARGET_HEIGHT
    }

    const rootStyle = computed((): string => {
        if (props.inline != true) {
            // App：上屏后仍保留最低高度，避免矮图把布局往回抽
            if (appBlockMinHeight.length > 0) {
                return 'min-height:' + appBlockMinHeight + ';'
            }
            return ''
        }
        const w = resolveInlineDisplayWidth()
        const h = resolveInlineDisplayHeight()
        const useAppMin = appInlineMinHeight.length > 0
        // 表格保持原尺寸：禁止 max-width:100%，否则会在窄单元格里被压扁
        if (props.preserveSize == true) {
            if (w > 0 && h > 0) {
                if (useAppMin == true) {
                    return 'width:' + w + 'px;min-height:' + appInlineMinHeight + ';height:auto;'
                }
                return 'width:' + w + 'px;height:' + h + 'px;'
            }
            if (useAppMin == true) {
                return 'width:auto;min-height:' + appInlineMinHeight + ';'
            }
            return 'width:auto;height:auto;'
        }
        if (w > 0) {
            if (useAppMin == true) {
                return 'width:' + w + 'px;min-height:' + appInlineMinHeight + ';height:auto;max-width:100%;'
            }
            return 'width:' + w + 'px;height:' + h + 'px;max-width:100%;'
        }
        if (useAppMin == true) {
            return 'width:auto;min-height:' + appInlineMinHeight + ';max-width:100%;'
        }
        return 'width:auto;height:' + INLINE_TARGET_HEIGHT + 'px;max-width:100%;'
    })

    const imageStyle = computed((): string => {
        if (props.inline != true) {
            return ''
        }
        const w = resolveInlineDisplayWidth()
        const h = resolveInlineDisplayHeight()
        if (props.preserveSize == true) {
            if (w > 0 && h > 0) {
                return 'width:' + w + 'px;height:' + h + 'px;'
            }
            return 'width:auto;height:auto;'
        }
        if (w > 0) {
            return 'width:' + w + 'px;height:' + h + 'px;'
        }
        return 'width:auto;height:' + INLINE_TARGET_HEIGHT + 'px;'
    })
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
    // #ifdef WEB
    @import './katex.min.scss';
    // 与会话正文一致：白底 + #404040，不跟随 dark theme
    .katex {
        color: #404040 !important;
        // KaTeX 斜体末字右倾，避免被 overflow 裁掉
        padding-right: 0.35em;
        overflow: visible;
    }
    .katex-html {
        overflow: visible;
    }
    .katex-el-inline .katex {
        font-size: 16px;
        line-height: 1.25;
    }
    // #endif
    .katex-el {
        width: 100%;
        background-color: #ffffff;
        overflow: visible;
    }

    .katex-el-inline {
        width: auto;
        display: flex;
        flex-direction: row;
        align-items: center;
        background-color: transparent;
        overflow: visible;
        padding-right: 2px;
        box-sizing: content-box;
        flex-shrink: 0;
    }

    .katex-el-katex-image {
        width: 100%;
        background-color: #ffffff;
    }

    .katex-el-katex-image-inline {
        background-color: transparent;
        flex-shrink: 0;
    }

    /* #ifdef APP */
    .katex-el-placeholder {
        width: 100%;
        min-height: 120rpx;
        background-color: transparent;
    }

    .katex-el-placeholder-inline {
        min-width: 120rpx;
        min-height: 40rpx;
        flex-shrink: 0;
        background-color: transparent;
    }
    /* #endif */
</style>
