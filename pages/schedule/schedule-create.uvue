<template>
  <view class="create">
    <custom-nav-bar :title="t('Mobile.Discover.scheduleCreate')" className="border-b" hasSafetyZone :show-back="false">
      <template #left>
        <text class="create__nav" @click="onCancel">{{ t("Mobile.Common.cancel") }}</text>
      </template>
      <template #right>
        <text class="create__nav create__nav--save" @click="onSave">{{ t("Mobile.Common.save") }}</text>
      </template>
    </custom-nav-bar>

    <scroll-view class="create__scroll" direction="vertical" :show-scrollbar="false">
      <view class="create__theme">
        <input
          class="create__theme-input"
          v-model="title"
          :maxlength="80"
          :placeholder="t('Mobile.Discover.scheduleThemePlaceholder')"
          placeholder-style="color: #c8cad0; font-size: 22px;"
        />
      </view>
      <view class="create__line"></view>

      <view class="create__row" @click="onParticipants">
        <view class="create__icon">
          <svg-icon name="icon-User" size="20" unit="px" color="#c9cdd4" />
        </view>
        <text class="create__placeholder">{{ t("Mobile.Discover.scheduleAddParticipants") }}</text>
      </view>
      <view class="create__line"></view>

      <view class="create__when">
        <view class="create__icon create__icon--top">
          <svg-icon name="icon-Clock" size="20" unit="px" color="#c9cdd4" />
        </view>
        <view class="create__when-main">
          <view class="create__when-side">
            <picker mode="time" :value="startTime" @change="onStartTimeChange">
              <text class="create__hm">{{ startTime }}</text>
            </picker>
            <picker mode="date" :value="startDate" @change="onStartDateChange">
              <text class="create__date">{{ startDateText }}</text>
            </picker>
            <text class="create__tz">{{ t("Mobile.Discover.scheduleTimezone") }}</text>
          </view>
          <view class="create__when-arrow">
            <svg-icon name="icon-a-Chevronright" size="16" unit="px" color="#c9cdd4" />
          </view>
          <view class="create__when-side">
            <picker mode="time" :value="endTime" @change="onEndTimeChange">
              <text class="create__hm">{{ endTime }}</text>
            </picker>
            <picker mode="date" :value="endDate" @change="onEndDateChange">
              <text class="create__date">{{ endDateText }}</text>
            </picker>
          </view>
        </view>
      </view>
      <view class="create__line"></view>

      <view class="create__row" @click="pickRepeat">
        <view class="create__icon">
          <svg-icon name="icon-refresh" size="20" unit="px" color="#c9cdd4" />
        </view>
        <text class="create__label">{{ t("Mobile.Discover.scheduleRepeat") }}</text>
        <text class="create__value">{{ repeatLabel }}</text>
        <svg-icon name="icon-a-Chevronright" size="14" unit="px" color="#c9cdd4" />
      </view>
      <view class="create__line"></view>

      <view class="create__row">
        <view class="create__icon">
          <view class="create__pin"></view>
        </view>
        <input
          class="create__field"
          v-model="location"
          :maxlength="80"
          :placeholder="t('Mobile.Discover.scheduleAddLocation')"
          placeholder-style="color: #86909c; font-size: 16px;"
        />
      </view>
      <view class="create__line"></view>

      <view class="create__row" @click="pickRemind">
        <view class="create__icon">
          <svg-icon name="icon-bell" size="20" unit="px" color="#c9cdd4" />
        </view>
        <text class="create__label">{{ t("Mobile.Discover.scheduleRemind") }}</text>
        <text class="create__value">{{ remindLabel }}</text>
        <svg-icon name="icon-a-Chevronright" size="14" unit="px" color="#c9cdd4" />
      </view>
      <view class="create__line"></view>

      <view class="create__row">
        <view class="create__icon">
          <svg-icon name="icon-a-Filetext" size="20" unit="px" color="#c9cdd4" />
        </view>
        <input
          class="create__field"
          v-model="notes"
          :maxlength="200"
          :placeholder="t('Mobile.Discover.scheduleAddNotes')"
          placeholder-style="color: #86909c; font-size: 16px;"
        />
      </view>
      <view class="create__line"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { ScheduleEvent, appendScheduleEvent } from "@/utils/scheduleStore";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const weekdayKeys: string[] = [
    "Mobile.Discover.weekdaySun",
    "Mobile.Discover.weekdayMon",
    "Mobile.Discover.weekdayTue",
    "Mobile.Discover.weekdayWed",
    "Mobile.Discover.weekdayThu",
    "Mobile.Discover.weekdayFri",
    "Mobile.Discover.weekdaySat",
  ];

  const repeatKeys: string[] = ["none", "daily", "weekly", "monthly", "yearly"];
  const remindKeys: string[] = ["none", "start", "m5", "m15", "m30", "h1"];

  const title = ref<string>("");
  const location = ref<string>("");
  const notes = ref<string>("");
  const startDate = ref<string>("");
  const endDate = ref<string>("");
  const startTime = ref<string>("14:30");
  const endTime = ref<string>("15:00");
  const startDateText = ref<string>("");
  const endDateText = ref<string>("");
  const repeat = ref<string>("none");
  const remind = ref<string>("m15");
  const repeatLabel = ref<string>("");
  const remindLabel = ref<string>("");
  let saving = false;

  function pad2(n: number): string {
    if (n < 10) {
      return "0" + n;
    }
    return "" + n;
  }

  function isoDate(year: number, month: number, day: number): string {
    return year + "-" + pad2(month) + "-" + pad2(day);
  }

  function dateText(iso: string): string {
    if (iso.length < 10) {
      return "";
    }
    const year = parseInt(iso.substring(0, 4));
    const month = parseInt(iso.substring(5, 7));
    const day = parseInt(iso.substring(8, 10));
    if (isNaN(year) || isNaN(month) || isNaN(day)) {
      return "";
    }
    const date = new Date(year, month - 1, day);
    const params = new Map<string, string | number>();
    params.set("month", month);
    params.set("day", day);
    params.set("weekday", t(weekdayKeys[date.getDay()]));
    return translateFn("Mobile.Discover.scheduleDatePlain", toI18nParams(params), "");
  }

  function refreshDateText(): void {
    startDateText.value = dateText(startDate.value);
    endDateText.value = dateText(endDate.value);
  }

  function minutesText(minutes: number): string {
    const params = new Map<string, string | number>();
    params.set("minutes", minutes);
    return translateFn("Mobile.Discover.scheduleRemindMinutes", toI18nParams(params), "");
  }

  function refreshChoiceText(): void {
    if (repeat.value == "daily") {
      repeatLabel.value = t("Mobile.Discover.scheduleRepeatDaily");
    } else if (repeat.value == "weekly") {
      repeatLabel.value = t("Mobile.Discover.scheduleRepeatWeekly");
    } else if (repeat.value == "monthly") {
      repeatLabel.value = t("Mobile.Discover.scheduleRepeatMonthly");
    } else if (repeat.value == "yearly") {
      repeatLabel.value = t("Mobile.Discover.scheduleRepeatYearly");
    } else {
      repeatLabel.value = t("Mobile.Discover.scheduleRepeatNone");
    }

    if (remind.value == "none") {
      remindLabel.value = t("Mobile.Discover.scheduleRemindNone");
    } else if (remind.value == "start") {
      remindLabel.value = t("Mobile.Discover.scheduleRemindStart");
    } else if (remind.value == "m5") {
      remindLabel.value = minutesText(5);
    } else if (remind.value == "m30") {
      remindLabel.value = minutesText(30);
    } else if (remind.value == "h1") {
      remindLabel.value = t("Mobile.Discover.scheduleRemindHour");
    } else {
      remindLabel.value = minutesText(15);
    }
  }

  function timeToMin(hm: string): number {
    const parts = hm.split(":");
    if (parts.length < 2) {
      return 0;
    }
    const hour = parseInt(parts[0]);
    const minute = parseInt(parts[1]);
    if (isNaN(hour) || isNaN(minute)) {
      return 0;
    }
    return hour * 60 + minute;
  }

  function minToTime(total: number): string {
    let value = total;
    if (value < 0) {
      value = 0;
    }
    if (value > 23 * 60 + 59) {
      value = 23 * 60 + 59;
    }
    const hour = Math.floor(value / 60);
    const minute = value % 60;
    return pad2(hour) + ":" + pad2(minute);
  }

  function readQueryInt(options: any, key: string, fallback: number): number {
    if (options == null) {
      return fallback;
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const n = parseInt(`${raw}`);
    if (isNaN(n)) {
      return fallback;
    }
    return n;
  }

  function pickerText(event: UniPickerChangeEvent): string {
    const raw = event.detail.value;
    if (typeof raw == "string") {
      return raw;
    }
    return "";
  }

  function compareIso(a: string, b: string): number {
    const left = a.length < b.length ? a.length : b.length;
    for (let i = 0; i < left; i++) {
      const caRaw = a.charCodeAt(i);
      const cbRaw = b.charCodeAt(i);
      const ca = caRaw != null ? caRaw : 0;
      const cb = cbRaw != null ? cbRaw : 0;
      const diff = ca - cb;
      if (diff != 0) {
        return diff;
      }
    }
    return a.length - b.length;
  }

  /** 结束时间不早于开始时间；同一天不足 1 分钟时把结束时间推后 30 分钟。 */
  function keepEndAfterStart(): void {
    const dateOrder = compareIso(endDate.value, startDate.value);
    if (dateOrder > 0) {
      return;
    }
    if (dateOrder < 0) {
      endDate.value = startDate.value;
    }
    const startMin = timeToMin(startTime.value);
    const endMin = timeToMin(endTime.value);
    if (endMin <= startMin) {
      endTime.value = minToTime(startMin + 30);
    }
  }

  function onStartTimeChange(event: UniPickerChangeEvent): void {
    const value = pickerText(event);
    if (value.length == 0) {
      return;
    }
    startTime.value = value;
    keepEndAfterStart();
  }

  function onEndTimeChange(event: UniPickerChangeEvent): void {
    const value = pickerText(event);
    if (value.length == 0) {
      return;
    }
    endTime.value = value;
    keepEndAfterStart();
  }

  function onStartDateChange(event: UniPickerChangeEvent): void {
    const value = pickerText(event);
    if (value.length == 0) {
      return;
    }
    startDate.value = value;
    if (compareIso(endDate.value, startDate.value) < 0) {
      endDate.value = startDate.value;
    }
    keepEndAfterStart();
    refreshDateText();
  }

  function onEndDateChange(event: UniPickerChangeEvent): void {
    const value = pickerText(event);
    if (value.length == 0) {
      return;
    }
    endDate.value = value;
    keepEndAfterStart();
    refreshDateText();
  }

  function pickRepeat(): void {
    uni.showActionSheet({
      itemList: [
        t("Mobile.Discover.scheduleRepeatNone"),
        t("Mobile.Discover.scheduleRepeatDaily"),
        t("Mobile.Discover.scheduleRepeatWeekly"),
        t("Mobile.Discover.scheduleRepeatMonthly"),
        t("Mobile.Discover.scheduleRepeatYearly"),
      ],
      success: (res: ShowActionSheetSuccess): void => {
        if (res.tapIndex >= 0 && res.tapIndex < repeatKeys.length) {
          repeat.value = repeatKeys[res.tapIndex];
          refreshChoiceText();
        }
      },
    });
  }

  function pickRemind(): void {
    uni.showActionSheet({
      itemList: [
        t("Mobile.Discover.scheduleRemindNone"),
        t("Mobile.Discover.scheduleRemindStart"),
        minutesText(5),
        minutesText(15),
        minutesText(30),
        t("Mobile.Discover.scheduleRemindHour"),
      ],
      success: (res: ShowActionSheetSuccess): void => {
        if (res.tapIndex >= 0 && res.tapIndex < remindKeys.length) {
          remind.value = remindKeys[res.tapIndex];
          refreshChoiceText();
        }
      },
    });
  }

  function onParticipants(): void {
    uni.showToast({ title: t("Mobile.Common.comingSoon"), icon: "none" });
  }

  function onCancel(): void {
    uni.navigateBack();
  }

  function onSave(): void {
    if (saving) {
      return;
    }
    saving = true;
    const event = new ScheduleEvent();
    event.id = "" + Date.now();
    event.title = title.value.trim();
    event.startDate = startDate.value;
    event.endDate = endDate.value;
    event.startTime = startTime.value;
    event.endTime = endTime.value;
    event.repeat = repeat.value;
    event.remind = remind.value;
    event.location = location.value.trim();
    event.notes = notes.value.trim();
    appendScheduleEvent(event);
    uni.showToast({ title: t("Mobile.Discover.scheduleSaved"), icon: "none" });
    setTimeout(() => {
      uni.navigateBack();
    }, 400);
  }

  onLoad((options: any) => {
    const today = new Date();
    const year = readQueryInt(options, "year", today.getFullYear());
    const month = readQueryInt(options, "month", today.getMonth() + 1);
    const day = readQueryInt(options, "day", today.getDate());
    const iso = isoDate(year, month, day);
    startDate.value = iso;
    endDate.value = iso;
    refreshDateText();
    refreshChoiceText();
  });
</script>

<style scoped>
  .create {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
  }

  .create__nav {
    font-size: 16px;
    color: #1f2329;
    line-height: 22px;
    padding: 8px 0;
  }

  .create__nav--save {
    color: #5b4dff;
    font-weight: 600;
  }

  .create__scroll {
    flex: 1;
  }

  .create__theme {
    padding: 18px 16px 16px;
  }

  .create__theme-input {
    height: 32px;
    font-size: 22px;
    color: #1f2329;
  }

  .create__line {
    height: 1px;
    background-color: #f2f3f5;
  }

  .create__row {
    min-height: 56px;
    padding: 0 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .create__icon {
    width: 22px;
    height: 22px;
    margin-right: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .create__icon--top {
    margin-top: 4px;
    align-self: flex-start;
  }

  .create__placeholder {
    flex: 1;
    font-size: 16px;
    color: #86909c;
  }

  .create__label {
    flex: 1;
    font-size: 16px;
    color: #1f2329;
  }

  .create__value {
    font-size: 15px;
    color: #86909c;
    margin-right: 4px;
  }

  .create__field {
    flex: 1;
    height: 24px;
    font-size: 16px;
    color: #1f2329;
  }

  .create__when {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }

  .create__when-main {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }

  .create__when-side {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .create__when-arrow {
    width: 28px;
    height: 28px;
    margin-top: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .create__hm {
    font-size: 22px;
    font-weight: 600;
    color: #1f2329;
    line-height: 30px;
  }

  .create__date {
    margin-top: 2px;
    font-size: 13px;
    color: #4e5969;
    line-height: 18px;
  }

  .create__tz {
    margin-top: 2px;
    font-size: 12px;
    color: #86909c;
    line-height: 16px;
  }

  .create__pin {
    width: 14px;
    height: 14px;
    border-width: 1.5px;
    border-style: solid;
    border-color: #c9cdd4;
    border-radius: 8px 8px 8px 2px;
    transform: rotate(-45deg);
  }
</style>
