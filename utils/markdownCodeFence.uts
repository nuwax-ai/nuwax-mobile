/** 代码围栏范围包含开/闭围栏行；流式未闭合时一直保护到文末。 */
export class MarkdownCodeFenceRange {
  start: number = 0;
  end: number = 0;
}

/** 按整行识别围栏，代码字符串内的反引号不能提前结束保护。 */
export function findMarkdownCodeFenceRanges(markdown: string): MarkdownCodeFenceRange[] {
  const ranges = [] as MarkdownCodeFenceRange[];
  let openStart = -1;
  let fenceChar = "";
  let fenceLength = 0;
  let lineStart = 0;
  while (lineStart < markdown.length) {
    const newline = markdown.indexOf("\n", lineStart);
    const lineEnd = newline < 0 ? markdown.length : newline + 1;
    const line = markdown.substring(lineStart, lineEnd).trim();
    const marker = line.length > 0 ? line.charAt(0) : "";
    let markerLength = 0;
    if (marker == "`" || marker == "~") {
      while (markerLength < line.length && line.charAt(markerLength) == marker) {
        markerLength++;
      }
    }
    if (openStart < 0) {
      if (markerLength >= 3) {
        openStart = lineStart;
        fenceChar = marker;
        fenceLength = markerLength;
      }
    } else if (
      marker == fenceChar && markerLength >= fenceLength &&
      line.substring(markerLength).trim().length == 0
    ) {
      const range = new MarkdownCodeFenceRange();
      range.start = openStart;
      range.end = lineEnd;
      ranges.push(range);
      openStart = -1;
    }
    lineStart = lineEnd;
  }
  if (openStart >= 0) {
    const range = new MarkdownCodeFenceRange();
    range.start = openStart;
    range.end = markdown.length;
    ranges.push(range);
  }
  return ranges;
}

/** 只变换围栏外正文；代码中的美元符、反斜杠和换行全部保留。 */
export function mapMarkdownOutsideCodeFences(
  markdown: string,
  transform: (text: string) => string,
): string {
  const ranges = findMarkdownCodeFenceRanges(markdown);
  if (ranges.length == 0) return transform(markdown);
  let out = "";
  let cursor = 0;
  for (let i = 0; i < ranges.length; i++) {
    const range = ranges[i];
    if (range.start > cursor) {
      out += transform(markdown.substring(cursor, range.start));
    }
    out += markdown.substring(range.start, range.end);
    cursor = range.end;
  }
  if (cursor < markdown.length) out += transform(markdown.substring(cursor));
  return out;
}
