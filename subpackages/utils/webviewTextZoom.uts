/**
 * App 端内嵌 H5（web-view）字体放大修复。
 *
 * Android 系统字体缩放会传导到 WebView，导致内嵌页面（如 agent-detail 的 H5 聊天）
 * 字号比原生 UI 大。等价于 uni-app(vue) 的：
 *   plus.webview.currentWebview().setStyle({ webview: { textZoom: '100%' } })
 * uni-app x 无 plus 体系，改为遍历当前 Activity 视图树定位 android.webkit.WebView，
 * 强制 settings.textZoom = 100。
 *
 * 用法：在包含 <web-view> 的页面 onLoad / onReady / @load 中调用 fixAppWebviewTextZoom()；
 * 内部带 100ms × 30 次短轮询，兼容 webview 尚未挂载的时序。
 */

// #ifdef APP-ANDROID
import WebView from 'android.webkit.WebView';
import View from 'android.view.View';
import ViewGroup from 'android.view.ViewGroup';
// #endif

// #ifdef APP-ANDROID
/** 递归查找视图树中的第一个 WebView（SysWebView 等 DCloud 实现均继承自 android.webkit.WebView）。 */
function findFirstWebView(view: View | null): WebView | null {
  if (view == null) {
    return null
  }
  if (view instanceof WebView) {
    return view as WebView
  }
  if (view instanceof ViewGroup) {
    const group = view as ViewGroup
    const count: Int = group.getChildCount()
    for (let i: Int = 0; i < count; i++) {
      const child = group.getChildAt(i)
      if (child == null) {
        continue
      }
      const found = findFirstWebView(child)
      if (found != null) {
        return found
      }
    }
  }
  return null
}

/** 单次尝试：找到 WebView 并设置 textZoom；未找到返回 false（由调用方轮询重试）。 */
function applyWebviewTextZoomOnce(): boolean {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    return false
  }
  const window = activity.getWindow()
  if (window == null) {
    return false
  }
  const decorView = window.getDecorView()
  if (decorView == null) {
    return false
  }
  const webView = findFirstWebView(decorView)
  if (webView == null) {
    return false
  }
  webView.settings.textZoom = 100
  return true
}
// #endif

/**
 * 修复 App 内嵌 H5 的 WebView 字体缩放（Android；iOS 无此问题，自动跳过）。
 * 页面 onLoad / onReady / @load 调用一次即可；内部 100ms 轮询最多 3s 覆盖 webview 挂载时序。
 */
export function fixAppWebviewTextZoom(): void {
  // #ifdef APP-ANDROID
  if (applyWebviewTextZoomOnce()) {
    return
  }
  // 短轮询：webview 尚未挂载时每 100ms 重试，最多 30 次（3s）
  let attempts = 0
  let timer: number = 0
  timer = setInterval((): void => {
    attempts++
    if (applyWebviewTextZoomOnce()) {
      clearInterval(timer)
      return
    }
    if (attempts >= 30) {
      clearInterval(timer)
    }
  }, 100) as number
  // #endif
}
