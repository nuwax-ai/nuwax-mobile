<template>
  <web-view id="aliyun-captcha-webview" :src="src" @message="onMessage"></web-view>
</template>

<script lang="uts">
  import { API_BASE_URL } from "@/constants/config";
  const path = "/static/aliyun-captcha.html";

  function extractCaptchaVerifyParam(value: any): string {
    if (typeof value == "string") {
      return value;
    }
    if (value == null) {
      return "";
    }
    const payload = value as UTSJSONObject;
    const directParam = payload["captchaVerifyParam"];
    if (typeof directParam == "string") {
      return directParam;
    }
    // Android 的 uni.webView 桥接会按运行时版本包在 data 或 arg 字段中。
    const data = payload["data"];
    if (data != null) {
      const dataParam = extractCaptchaVerifyParam(data);
      if (dataParam.length > 0) {
        return dataParam;
      }
    }
    const arg = payload["arg"];
    return arg != null ? extractCaptchaVerifyParam(arg) : "";
  }

  export default {
    computed: {
      src(): string {
        return API_BASE_URL + path;
      }
      },
      methods: {
      onMessage(event: UniWebViewMessageEvent) {
        const messages = event.detail.data;
        if (messages.length == 0) {
          return;
        }
        // 与微信小程序保持一致：直接取回阿里云返回的原始校验参数。
        const rawParam = messages[messages.length - 1] as any;
        const captchaVerifyParam = extractCaptchaVerifyParam(rawParam);
        if (captchaVerifyParam.length == 0) {
          return;
        }
        uni.$emit("login_aliyun_captcha_result", captchaVerifyParam);
        uni.navigateBack({ delta: 1 });
      }
    }
  };
</script>
