/** 等后端合同与安装包回调登记完成后再开放，不影响现有 H5 Cookie 登录。 */
export const NATIVE_AUTH_ENABLED = false;
/** 仅填入后端明确允许原生交接的 provider ID；空列表表示不开放任何入口。 */
export const NATIVE_AUTH_PROVIDER_IDS: string[] = [];
export const NATIVE_AUTH_CALLBACK_URL = "com.nuwax.app.auth://oauth/callback";
/** 客户端事务上限；服务器 TTL 更短时从严处理，不代表后端当前配置。 */
export const NATIVE_AUTH_MAX_AGE_MS = 300000;
