import { ACCESS_TOKEN, ACCESS_TOKEN_ORIGIN } from "@/constants/home.constants";
import { getApiBaseUrl } from "@/constants/config";
import { IM_PUSH_PREFERENCES_KEY } from "@/utils/installScopedStorage";
import { getImSessionStamp } from "./imSessionScope";
import eventBus from "@/utils/eventBus";

export const IM_PUSH_PREFERENCE_CHANGED = "im_push_preference_changed";

// 身份须来自当前会话的 users/me，不能拿上一账号残留的 USER_INFO 绑定偏好。
let boundUserId = "";
let boundStamp = "";
let boundOrigin = "";

function currentOrigin(): string {
  return getApiBaseUrl().trim().replace(/\/+$/, "");
}

export function hasImPushPreferenceSession(): boolean {
  const token = uni.getStorageSync(ACCESS_TOKEN);
  const origin = uni.getStorageSync(ACCESS_TOKEN_ORIGIN);
  return token != null && `${token}`.length > 0
    && (origin == null || `${origin}`.trim().length == 0
      || `${origin}`.trim().replace(/\/+$/, "") == currentOrigin());
}

export function bindImPushPreferenceUser(userId: string): boolean {
  if (!hasImPushPreferenceSession() || userId.length == 0 || userId == "0") return false;
  boundUserId = userId;
  boundStamp = getImSessionStamp();
  boundOrigin = currentOrigin();
  return true;
}

function preferenceScope(): string {
  if (boundUserId.length == 0 || boundStamp != getImSessionStamp()
    || boundOrigin != currentOrigin() || !hasImPushPreferenceSession()) return "";
  return `${encodeURIComponent(boundOrigin)}:${boundUserId}`;
}

export function hasImPushPreferenceUser(): boolean {
  return preferenceScope().length > 0;
}

function preferences(): UTSJSONObject {
  try {
    const raw = uni.getStorageSync(IM_PUSH_PREFERENCES_KEY);
    if (raw != null && `${raw}`.length > 0) {
      const value = JSON.parse<UTSJSONObject>(`${raw}`);
      if (value != null && typeof value == "object" && !Array.isArray(value)) return value;
    }
  } catch (_e) {
    // 旧/损坏偏好按首次使用处理；用户再次设置时重写。
  }
  return new UTSJSONObject();
}

/** 身份未确认前不启用推送；已确认账号无记录时延续原先默认开启的行为。 */
export function readImPushEnabled(): boolean {
  const scope = preferenceScope();
  if (scope.length == 0) return false;
  return `${preferences()[scope] ?? "1"}` != "0";
}

export function writeImPushEnabled(enabled: boolean): boolean {
  const scope = preferenceScope();
  if (scope.length == 0) return false;
  const values = preferences();
  values[scope] = enabled ? "1" : "0";
  uni.setStorageSync(IM_PUSH_PREFERENCES_KEY, JSON.stringify(values));
  eventBus.emit(IM_PUSH_PREFERENCE_CHANGED, {});
  return true;
}
