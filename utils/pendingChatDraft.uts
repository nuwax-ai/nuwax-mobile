import { PendingChatDraft } from "@/types/interfaces/pendingChatDraft";
import { AgentSelectedComponentInfo } from "@/types/interfaces/agent";
import { AgentComponentTypeEnum } from "@/types/enums/agent";

const PREFIX = "pendingChatDraft:";
const TTL_MS = 10 * 60 * 1000;

function storageKey(conversationId: number): string {
  return PREFIX + conversationId;
}

export function savePendingChatDraft(draft: PendingChatDraft): void {
  uni.setStorageSync(storageKey(draft.conversationId), JSON.stringify(draft));
}

export function consumePendingChatDraft(
  conversationId: number,
  agentId: number,
): PendingChatDraft | null {
  const key = storageKey(conversationId);
  const raw = uni.getStorageSync(key);
  if (raw == null || `${raw}`.length == 0) return null;
  try {
    const parsed = JSON.parse<UTSJSONObject>(`${raw}`);
    if (parsed == null) {
      uni.removeStorageSync(key);
      return null;
    }
    const draft = new PendingChatDraft();
    draft.version = parsed["version"] as number | null ?? 1;
    draft.createdAt = parsed["createdAt"] as number | null ?? 0;
    draft.agentId = parsed["agentId"] as number | null ?? 0;
    draft.conversationId = parsed["conversationId"] as number | null ?? 0;
    draft.message = `${parsed["message"] as string | null ?? ""}`;
    draft.attachments = parsed["attachments"] as UTSJSONObject[] | null ?? [] as UTSJSONObject[];
    draft.skillIds = parsed["skillIds"] as number[] | null ?? [] as number[];
    draft.sandboxId = `${parsed["sandboxId"] as string | null ?? ""}`;
    draft.modelId = parsed["modelId"] as number | null ?? 0;
    const selectedRaw = parsed["selectedComponents"] as UTSJSONObject[] | null;
    if (selectedRaw != null) {
      for (let i = 0; i < selectedRaw.length; i++) {
        const item = selectedRaw[i];
        const id = item["id"] as number | null ?? 0;
        const type = item["type"] as AgentComponentTypeEnum | null ?? AgentComponentTypeEnum.Plugin;
        draft.selectedComponents.push(new AgentSelectedComponentInfo(id, type));
      }
    }
    const valid = draft.conversationId == conversationId &&
      draft.agentId == agentId && Date.now() - draft.createdAt <= TTL_MS;
    if (valid == false) {
      uni.removeStorageSync(key);
      return null;
    }
    uni.removeStorageSync(key);
    return draft;
  } catch (_error) {
    uni.removeStorageSync(key);
    return null;
  }
}

export function removePendingChatDraft(conversationId: number): void {
  uni.removeStorageSync(storageKey(conversationId));
}
