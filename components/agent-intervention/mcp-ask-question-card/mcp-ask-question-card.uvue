<template>
  <view class="mcp-ask-card" v-if="interaction">
    <!-- 标题区 -->
    <view class="card-header">
      <text class="card-eyebrow">{{ eyebrowText }}</text>
      <text class="card-title">{{ cardTitle }}</text>
      <text v-if="hasCardDescription" class="card-desc">{{
        cardDescription
      }}</text>
    </view>

    <!-- 状态标签（对齐 PC 端：failed 状态不显示标签，仅底部展示 errorMessage）-->
    <view v-if="showStatusTag" class="status-tag">
      <svg-icon
        v-if="isStatusSubmitted"
        name="icon-a-Checkcircle"
        customClass="status-icon status-icon-success"
      />
      <svg-icon
        v-else-if="isStatusCancelled"
        name="icon-a-Xcircle"
        customClass="status-icon status-icon-cancelled"
      />
      <svg-icon
        v-else-if="isStatusSkipped"
        name="icon-attention"
        customClass="status-icon status-icon-skipped"
      />
      <text class="status-tag-text">{{ statusLabel }}</text>
    </view>

    <!-- 表单区 -->
    <view v-if="isPending" class="card-form">
      <!-- 步骤进度条（对齐 PC antd Steps） -->
      <view v-if="isWizard && steps.length > 1" class="wizard-steps-block">
        <view class="wizard-step-row">
          <view
            v-for="(step, index) in steps"
            :key="step.id"
            class="wizard-step-cell"
          >
            <view class="step-icon-row">
              <!-- 左侧连接线（第一步不显示） -->
              <view
                v-if="index > 0"
                class="step-connector-half"
                :class="{ 'step-connector-active': index <= currentStep }"
              />
              <!-- 步骤圆圈 -->
              <view
                class="step-circle"
                :class="{
                  'step-circle-done': index < currentStep,
                  'step-circle-active': index === currentStep,
                }"
              >
                <svg-icon
                  v-if="index < currentStep"
                  name="icon-Check"
                  customClass="step-check-icon"
                />
                <text v-else class="step-num-text">{{ index + 1 }}</text>
              </view>
              <!-- 右侧连接线（最后一步不显示） -->
              <view
                v-if="index < steps.length - 1"
                class="step-connector-half"
                :class="{ 'step-connector-active': index < currentStep }"
              />
            </view>
            <text
              class="step-label"
              :class="{
                'step-label-active': index === currentStep,
                'step-label-done': index < currentStep,
              }"
            >{{ step.title }}</text>
          </view>
        </view>
        <!-- 当前步骤描述（对齐 PC stepCallout） -->
        <view v-if="activeStepDescription" class="step-callout">
          <text class="step-callout-text">{{ activeStepDescription }}</text>
        </view>
      </view>
      <scroll-view
        class="card-form-scroll"
        direction="vertical"
        :show-scrollbar="false"
      >
        <view
          v-for="field in visibleFields"
          :key="field.name"
          class="form-field"
        >
          <text class="field-label"
            >{{ field.label
            }}<text v-if="field.required" class="field-required">{{
              requiredMark
            }}</text></text
          >

          <!-- text 输入 -->
          <input
            v-if="field.widget == 'text'"
            class="field-input"
            :value="getFormStringValue(field.name)"
            @input="onInputText(field.name, $event)"
            :placeholder="getFieldPlaceholder(field)"
          />

          <!-- textarea 输入 -->
          <textarea
            v-else-if="field.widget == 'textarea'"
            class="field-textarea"
            :value="getFormStringValue(field.name)"
            @input="onTextareaInput(field.name, $event)"
            :placeholder="getFieldPlaceholder(field)"
          />

          <!-- number 数字输入 -->
          <input
            v-else-if="field.widget == 'number'"
            class="field-input"
            :type="field.isInteger ? 'number' : 'digit'"
            :value="getFieldNumberDisplay(field)"
            @input="onNumberInput(field.name, $event)"
            :placeholder="getFieldPlaceholder(field)"
          />

          <!-- radio / select / list / radio-with-custom — 单选列表 -->
          <view
            v-else-if="
              field.widget == 'radio' ||
              field.widget == 'select' ||
              field.widget == 'list' ||
              field.widget == 'radio-with-custom'
            "
            class="field-list-group"
          >
            <view
              v-for="opt in field.options"
              :key="opt.value"
              class="list-option"
              @tap="onRadioSelect(field.name, opt.value)"
            >
              <view
                class="list-radio-dot"
                :class="{ 'dot-selected': isFormValueSelected(field.name, opt.value) }"
              >
                <svg-icon
                  v-if="isFormValueSelected(field.name, opt.value)"
                  name="icon-Check"
                  customClass="dot-check-icon"
                />
              </view>
              <text class="list-label">{{ opt.label }}</text>
            </view>
            <view
              v-if="field.widget == 'radio-with-custom'"
              class="list-option"
              @tap="onRadioSelect(field.name, field.otherValue)"
            >
              <view
                class="list-radio-dot"
                :class="{
                  'dot-selected': isOtherOptionSelected(field),
                }"
              >
                <svg-icon
                  v-if="isOtherOptionSelected(field)"
                  name="icon-Check"
                  customClass="dot-check-icon"
                />
              </view>
              <text class="list-label">{{ customOptionText }}</text>
            </view>
            <input
              v-if="shouldShowCustomInput(field)"
              class="field-input custom-input"
              :value="getFormStringValue(field.otherField)"
              @input="onInputText(field.otherField, $event)"
              :placeholder="getCustomPlaceholder(field)"
            />
          </view>

          <!-- checkboxes 多选 -->
          <l-checkbox-group
            v-else-if="field.widget == 'checkboxes'"
            :modelValue="getFormStringArrayValue(field.name)"
            @update:modelValue="(val: string[]) => onCheckboxUpdate(field.name, val)"
            direction="vertical"
            icon="rectangle"
            checkedColor="#1677ff"
            gap="12rpx"
          >
            <l-checkbox
              v-for="opt in field.options"
              :key="opt.value"
              :value="opt.value"
              :label="opt.label"
            />
          </l-checkbox-group>

          <!-- file 文件上传：预览与删除按钮对齐聊天输入区 chat-upload-image -->
          <view v-else-if="field.widget == 'file'" class="field-file-area">
            <chat-upload-image
              v-if="getFileList(field.name).length"
              :files="getFileList(field.name)"
              :show-add-button="false"
                @onDel="(uid: string) => handleFileDelete(field.name, uid)"
            />
            <!-- 上传按钮 -->
            <view class="file-upload-actions">
              <view
                class="file-upload-btn file-upload-btn-leading"
                @tap="chooseAndUpload(field, 'image')"
              >
                <text class="iconfont icon-tupian" />
                <text class="file-upload-btn-text">{{
                  uploadImageText
                }}</text>
              </view>
              <view
                class="file-upload-btn"
                @tap="chooseAndUpload(field, 'file')"
              >
                <svg-icon name="icon-a-Filetext" />
                <text class="file-upload-btn-text">{{
                  uploadFileText
                }}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 操作按钮 -->
      <view class="form-actions">
        <l-button
          v-if="isWizard && currentStep > 0"
          class="action-button"
          type="default"
          variant="light"
          radius="12rpx"
          @click="handlePrev"
        >
          {{ prevButtonText }}
        </l-button>
        <l-button
          class="action-button"
          type="default"
          variant="light"
          radius="12rpx"
          @click="handleCancel"
        >
          {{ cancelLabelText }}
        </l-button>
        <l-button
          v-if="allowSkip"
          class="action-button"
          type="default"
          variant="light"
          radius="12rpx"
          @click="handleSkip"
        >
          {{ skipLabel }}
        </l-button>
        <l-button
          v-if="isWizard && !isLastStep"
          class="action-button action-button-primary"
          type="primary"
          radius="12rpx"
          @click="handleNext"
        >
          {{ nextButtonText }}
        </l-button>
        <l-button
          v-else
          class="action-button action-button-primary"
          type="primary"
          radius="12rpx"
          @click="handleSubmit"
        >
          {{ submitLabelText }}
        </l-button>
      </view>
    </view>

    <!-- 失败错误消息（对齐 PC 端 isFailed errorMessage 展示）-->
    <text
      v-if="showFailedError"
      class="card-error-msg"
    >{{ failedErrorMessage }}</text>
  </view>
</template>

<script lang="uts">
  /**
   * MCP Ask 结构化提问卡片
   *
   * 详见 components/agent-intervention/README.md
   */
  import { t } from "@/utils/i18n.uts";
  import {
    McpAskAnsweredBy,
  } from "@/types/intervention";
  import type {
    InteractionUiSchema,
    InteractionUiStep,
    McpAskRespondPayload,
  } from "@/types/intervention";
  import { uploadSingleFile, generateFileUid } from "@/utils/fileUploader";
  import { UploadFileInfo } from "@/types/interfaces/common.uts";
  import { UploadFileStatus } from "@/types/enums/common.uts";
  import type { AttachmentFile } from "@/types/interfaces/conversationInfo.uts";
  import { readRawField } from "@/utils/readRawField.uts";
  import { orArray, orNumber, orString } from "@/utils/utsCoalesce.uts";
  import {
    createInteractionUiSchemaFromAny,
    getInteractionSteps,
    getSkipLabel,
    isSkipAllowed,
    isWizardPresentation,
    parseInteractionFields,
  } from "@/utils/mcpAskSchema.uts";
  import type { ParsedMcpAskField } from "@/utils/mcpAskSchema.uts";
  import { extractMcpAskFormAttachments } from "@/subpackages/utils/normalizeMcpAskFormData";
  import ChatUploadImage from "@/subpackages/components/chat-input-phone/chat-upload-image/chat-upload-image.uvue";

  // uiSchema 解析缓存（模块级）：Android 原生渲染器父级每 40ms 重渲时不跳过 prop 稳定的子组件，
  // 卡片常驻时每帧整树重渲 + 8 处 createInteractionUiSchemaFromAny 全量解析 → 卡顿。
  // 按 requestId:revision 缓存（与父组件 :key 同粒度），换提问/revision 自动失效。
  let _uiSchemaCacheKey: string = "";
  let _uiSchemaCache: InteractionUiSchema | null = null;

  // 模块级缓存函数：computed 里调它（普通函数，非 method/computed），
  // 规避 UTS「computed 调 method / computed 互引」触发 Return statement is not allowed here。
  function cachedUiSchema(interaction: any): InteractionUiSchema | null {
    const interactionObj = interaction as UTSJSONObject;
    const rid = orString(readRawField(interactionObj, "requestId"), "");
    const rev = orNumber(readRawField(interactionObj, "revision"), 1);
    const key = `${rid}:${rev}`;
    if (key == _uiSchemaCacheKey) {
      return _uiSchemaCache;
    }
    const ui = createInteractionUiSchemaFromAny(readRawField(interactionObj, "ui"));
    _uiSchemaCacheKey = key;
    _uiSchemaCache = ui;
    return ui;
  }

  class ParsedFieldOption {
    label: string;
    value: string;

    constructor(label: string, value: string) {
      this.label = label;
      this.value = value;
    }
  }

  class ParsedField {
    name: string = "";
    label: string = "";
    widget: string = "";
    options: ParsedFieldOption[] = [];
    required: boolean = false;
    placeholder: string = "";
    otherValue: string = "";
    otherField: string = "";
    multiple: boolean = false;
    minimum?: number;
    maximum?: number;
    isInteger: boolean = false;
  }

  function nonEmptyString(value: string | null, fallback: string): string {
    if (value != null && value.length > 0) {
      return value;
    }
    return fallback;
  }

  function optionalString(value: string | null): string {
    if (value != null && value.length > 0) {
      return value;
    }
    return "";
  }

  /** 禁止 as McpAskInteraction：prop 实为 UTSJSONObject，强转会 CCE；一律 readRawField 读字段 */
  function readMcpResponseStatus(interaction: any | null): string {
    if (interaction == null) return "pending";
    const status = orString(readRawField(interaction, "responseStatus"), "pending");
    if (status == "submitted") return "submitted";
    if (status == "failed") return "failed";
    if (status == "cancelled") return "cancelled";
    if (status == "skipped") return "skipped";
    if (status == "timeout") return "timeout";
    if (status == "submitting") return "submitting";
    return "pending";
  }

  function createEmptyFormData(): UTSJSONObject {
    return new UTSJSONObject();
  }

  function createEmptyFileData(): UTSJSONObject {
    return new UTSJSONObject();
  }

  function copyUtsObject(source: UTSJSONObject, target: UTSJSONObject): void {
    const keys = UTSJSONObject.keys(source);
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i];
      target[key] = source[key];
    }
  }

  function cloneUtsObject(source: UTSJSONObject): UTSJSONObject {
    const cloned = new UTSJSONObject();
    copyUtsObject(source, cloned);
    return cloned;
  }

  function readUtsField(store: UTSJSONObject, key: string): any | null {
    // UTSJSONObject[key] 可为 null；禁止 `as any`（非空 Any）—— null 时会 NPE。
    // 直接返回可空值，调用方按需判空。
    return store[key];
  }

  function writeUtsField(store: UTSJSONObject, key: string, value: any): void {
    store[key] = value;
  }

  function isSameFormValue(current: any | null, expected: string): boolean {
    if (current == null) return false;
    return `${current}` == expected;
  }

  function readPropertyString(property: any | null, key: string): string | null {
    if (property == null || typeof property !== "object") return null;
    const value = (property as UTSJSONObject)[key];
    if (value == null) return null;
    return `${value}`;
  }

  function readPropertyNumber(property: any | null, key: string): number | null {
    if (property == null || typeof property !== "object") return null;
    const value = (property as UTSJSONObject)[key];
    if (typeof value === "number") {
      return value as number;
    }
    return null;
  }

  function stringArrayOrEmpty(value: any | null): string[] {
    if (Array.isArray(value)) {
      return value as string[];
    }
    return [];
  }

  export default {
    name: "McpAskQuestionCard",
    components: {
      ChatUploadImage,
    },
    props: {
      // Android：interaction 实为 UTSJSONObject，禁止 class 类型 prop / as class（CCE）。
      // 用宽松 Object，内部一律 readRawField 读字段。
      interaction: {
        type: Object,
        required: true,
      },
    },
    emits: ["respond"],
    data() {
      return {
        formData: createEmptyFormData(),
        fileData: createEmptyFileData(),
        currentStep: 0,
      };
    },
    mounted() {
      this.initializeFormData();
    },
    // 说明：requestId/revision 变化的表单重置由父组件 :key="frontInterventionKey"
    // （含 requestId:revision）触发卡片重挂载完成，无需 watch。Android UTS Options API
    // 的 computed 多分支 return / watch→computed 链会报 "Return statement is not allowed here"，故移除。
    computed: {
      eyebrowText(): string {
        return t("Mobile.Intervention.McpAsk.eyebrow");
      },
      cardTitle(): string {
        return orString(readRawField(this.interaction as UTSJSONObject, "title"), "");
      },
      cardDescription(): string {
        return orString(readRawField(this.interaction as UTSJSONObject, "description"), "");
      },
      hasCardDescription(): boolean {
        return this.cardDescription.length > 0;
      },
      responseStatus(): string {
        return readMcpResponseStatus(this.interaction);
      },
      isPending(): boolean {
        return this.responseStatus === "pending";
      },
      showStatusTag(): boolean {
        return this.responseStatus !== "pending" && this.responseStatus !== "failed";
      },
      isStatusSubmitted(): boolean {
        return this.responseStatus === "submitted";
      },
      isStatusCancelled(): boolean {
        return this.responseStatus === "cancelled";
      },
      isStatusSkipped(): boolean {
        return this.responseStatus === "skipped";
      },
      showFailedError(): boolean {
        return this.responseStatus === "failed" && this.failedErrorMessage.length > 0;
      },
      failedErrorMessage(): string {
        return orString(readRawField(this.interaction as UTSJSONObject, "errorMessage"), "");
      },
      customOptionText(): string {
        return t("Mobile.Intervention.McpAsk.customOption");
      },
      uploadImageText(): string {
        return t("Mobile.Intervention.McpAsk.uploadImage");
      },
      uploadFileText(): string {
        return t("Mobile.Intervention.McpAsk.uploadFile");
      },
      prevButtonText(): string {
        return t("Mobile.Intervention.McpAsk.prev");
      },
      nextButtonText(): string {
        return t("Mobile.Intervention.McpAsk.next");
      },
      parsedFields(): ParsedField[] {
        const ui = cachedUiSchema(this.interaction);
        if (ui == null) return [];

        return parseInteractionFields(ui, [] as string[]).map(
          (field: ParsedMcpAskField): ParsedField => this.toParsedField(field),
        );
      },
      steps(): InteractionUiStep[] {
        const ui = cachedUiSchema(this.interaction);
        if (ui == null) return [];
        return getInteractionSteps(ui);
      },
      isWizard(): boolean {
        const ui = cachedUiSchema(this.interaction);
        if (ui == null) return false;
        return (
          isWizardPresentation(ui) && this.steps.length > 1
        );
      },
      activeStepTitle(): string {
        const stepTitle = this.steps[this.currentStep]?.title;
        if (stepTitle != null && stepTitle.length > 0) {
          return stepTitle;
        }
        const ui = cachedUiSchema(this.interaction);
        if (ui == null) return "";
        const uiTitle = ui.title;
        if (uiTitle != null && uiTitle.length > 0) {
          return uiTitle;
        }
        return "";
      },
      cancelLabelText(): string {
        const ui = cachedUiSchema(this.interaction);
        if (ui == null) {
          return t("Mobile.Intervention.McpAsk.cancel");
        }
        return nonEmptyString(
          ui.cancelLabel,
          t("Mobile.Intervention.McpAsk.cancel"),
        );
      },
      submitLabelText(): string {
        const ui = cachedUiSchema(this.interaction);
        if (ui == null) {
          return t("Mobile.Intervention.McpAsk.submit");
        }
        return nonEmptyString(
          ui.submitLabel,
          t("Mobile.Intervention.McpAsk.submit"),
        );
      },
      wizardProgressText(): string {
        return `${this.currentStep + 1}/${this.steps.length}`;
      },
      requiredMark(): string {
        return "*";
      },
      activeStepDescription(): string {
        return optionalString(this.steps[this.currentStep]?.description);
      },
      visibleFields(): ParsedField[] {
        if (!this.isWizard) return this.parsedFields;
        const activeStep = this.steps[this.currentStep];
        if (activeStep == null) return this.parsedFields;
        const names = activeStep.fields != null ? activeStep.fields : [];
        return this.parsedFields.filter((field: ParsedField): boolean =>
          names.includes(field.name),
        );
      },
      isLastStep(): boolean {
        return this.currentStep >= this.steps.length - 1;
      },
      allowSkip(): boolean {
        const ui = cachedUiSchema(this.interaction);
        if (ui == null) return false;
        return isSkipAllowed(ui);
      },
      skipLabel(): string {
        const ui = cachedUiSchema(this.interaction);
        if (ui == null) return t("Mobile.Intervention.McpAsk.skip");
        return nonEmptyString(getSkipLabel(ui), t("Mobile.Intervention.McpAsk.skip"));
      },
      statusLabel(): string {
        const status = this.responseStatus;
        if (status === "submitted")
          return t("Mobile.Intervention.McpAsk.submitted");
        if (status === "cancelled")
          return t("Mobile.Intervention.McpAsk.cancelled");
        if (status === "skipped")
          return t("Mobile.Intervention.McpAsk.skipped");
        if (status === "timeout")
          return t("Mobile.Intervention.McpAsk.timeout");
        if (status === "failed") {
          return orString(readRawField(this.interaction as UTSJSONObject, "errorMessage"), "");
        }
        return "";
      },
    },
    methods: {
      // schema 解析记忆化：卡片常驻时每帧重渲，8 处 computed 不再各自全量解析，统一走缓存
      uiSchema(): InteractionUiSchema | null {
        const interactionObj = this.interaction as UTSJSONObject;
        const rid = orString(readRawField(interactionObj, "requestId"), "");
        const rev = orNumber(readRawField(interactionObj, "revision"), 1);
        const key = `${rid}:${rev}`;
        if (key == _uiSchemaCacheKey) {
          return _uiSchemaCache;
        }
        const ui = createInteractionUiSchemaFromAny(
          readRawField(interactionObj, "ui"),
        );
        _uiSchemaCacheKey = key;
        _uiSchemaCache = ui;
        return ui;
      },
      formStore(): UTSJSONObject {
        return this.formData as UTSJSONObject;
      },
      fileStore(): UTSJSONObject {
        return this.fileData as UTSJSONObject;
      },
      readFormField(key: string): any | null {
        return readUtsField(this.formStore(), key);
      },
      writeFormField(key: string, value: any): void {
        writeUtsField(this.formStore(), key, value);
      },
      isFormValueSelected(fieldName: string, value: string): boolean {
        return isSameFormValue(this.readFormField(fieldName), value);
      },
      isOtherOptionSelected(field: ParsedField): boolean {
        return isSameFormValue(this.readFormField(field.name), field.otherValue);
      },
      shouldShowCustomInput(field: ParsedField): boolean {
        return field.widget == "radio-with-custom" && this.isOtherOptionSelected(field);
      },
      getFieldNumberDisplay(field: ParsedField): string {
        return this.formatNumberValue(this.readFormField(field.name));
      },
      onCheckboxUpdate(fieldName: string, values: string[]) {
        this.writeFormField(fieldName, values);
      },
      getFormStringValue(name: string): string {
        const value = this.readFormField(name);
        if (value != null && typeof value === "string") {
          return value as string;
        }
        return "";
      },
      getFormStringArrayValue(name: string): string[] {
        return stringArrayOrEmpty(this.readFormField(name));
      },
      getFieldPlaceholder(field: ParsedField): string {
        return nonEmptyString(field.placeholder, field.label);
      },
      getCustomPlaceholder(field: ParsedField): string {
        return nonEmptyString(
          field.placeholder,
          t("Mobile.Intervention.McpAsk.customPlaceholder"),
        );
      },
      toParsedField(field: ParsedMcpAskField): ParsedField {
        const options: ParsedFieldOption[] = field.enumValues.map(
          (value: string, index: number): ParsedFieldOption => {
            const label = field.enumLabels[index];
            const optionLabel =
              label != null && label.length > 0 ? label : value;
            return new ParsedFieldOption(optionLabel, value);
          },
        );
        const fieldOptions = field.options;
        const propertyTitle = readPropertyString(field.property, "title");
        const propertyType = readPropertyString(field.property, "type");
        const propertyMinimum = readPropertyNumber(field.property, "minimum");
        const propertyMaximum = readPropertyNumber(field.property, "maximum");
        const parsed = new ParsedField();
        parsed.name = field.name;
        parsed.label = nonEmptyString(propertyTitle, field.name);
        parsed.widget = field.widget;
        parsed.options = options;
        parsed.required = field.required;
        parsed.placeholder = optionalString(fieldOptions.placeholder);
        parsed.otherValue = nonEmptyString(
          fieldOptions.otherValue,
          "__custom__",
        );
        parsed.otherField = nonEmptyString(
          fieldOptions.otherField,
          `${field.name}Custom`,
        );
        parsed.multiple =
          fieldOptions.multiple == true || propertyType == "array";
        if (propertyMinimum != null) {
          parsed.minimum = propertyMinimum;
        }
        if (propertyMaximum != null) {
          parsed.maximum = propertyMaximum;
        }
        parsed.isInteger = field.isInteger;
        return parsed;
      },
      formatNumberValue(value: any | null): string {
        if (value == null || value === "") {
          return "";
        }
        return `${value}`;
      },
      initializeFormData() {
        const uiRaw = readRawField(this.interaction as UTSJSONObject, "ui");
        // fields 数组元素是 UTSJSONObject，禁止 as McpAskFormField[] 后点访问；用 orArray + readRawField
        const fields = orArray<any>(readRawField(uiRaw, "fields"));
        const fieldInitials = createEmptyFormData();
        fields.forEach((f: any) => {
          const initialValue = readRawField(f, "initialValue");
          const fieldName = orString(readRawField(f, "name"), "");
          if (initialValue != null && fieldName.length > 0) {
            fieldInitials[fieldName] = initialValue;
          }
        });
        const nextFormData = createEmptyFormData();
        const initialKeys = UTSJSONObject.keys(fieldInitials);
        const interactionFormData = readRawField(this.interaction as UTSJSONObject, "formData");
        if (initialKeys.length > 0) {
          copyUtsObject(fieldInitials, nextFormData);
        } else if (interactionFormData != null) {
          copyUtsObject(interactionFormData as UTSJSONObject, nextFormData);
        }
        this.formData = nextFormData;
        this.fileData = createEmptyFileData();
      },
      writeInputEventValue(name: string, event: UniInputEvent) {
        const value = event.detail.value;
        this.writeFormField(name, value != null ? value : "");
      },
      onInputText(name: string, event: UniInputEvent) {
        this.writeInputEventValue(name, event);
      },
      onTextareaInput(name: string, event: any) {
        this.writeInputEventValue(name, event as UniInputEvent);
      },
      onNumberInput(name: string, event: UniInputEvent) {
        const raw = (event.detail.value != null ? event.detail.value : "").trim();
        if (raw === "") {
          this.writeFormField(name, "");
          return;
        }
        const num = parseFloat(raw);
        this.writeFormField(name, isNaN(num) ? raw : num);
      },
      onRadioSelect(name: string, value: string) {
        this.writeFormField(name, value);
      },

      // ==================== 文件上传 ====================

      getFileList(fieldName: string): UploadFileInfo[] {
        const list = readUtsField(this.fileStore(), fieldName);
        if (list != null && Array.isArray(list)) {
          return list as UploadFileInfo[];
        }
        return [];
      },

      handleFileDelete(fieldName: string, uid: string) {
        this.removeFile(fieldName, uid);
      },

      getUploadCount(field: ParsedField): number {
        const existingCount = this.getFileList(field.name).length;
        if (!field.multiple && existingCount > 0) return 0;
        return field.multiple ? Math.max(9 - existingCount, 0) : 1;
      },

      chooseAndUpload(field: ParsedField, type: "image" | "file") {
        const count = this.getUploadCount(field);
        if (count <= 0) {
          uni.showToast({
            title: t("Mobile.Intervention.McpAsk.singleFileOnly"),
            icon: "none",
          });
          return;
        }

        if (type === "image") {
          uni.chooseImage({
            count,
            sizeType: ["original", "compressed"],
            sourceType: ["album", "camera"],
            success: (res) => {
              this.uploadFiles(field.name, res.tempFilePaths, true);
            },
          });
        } else {
          uni.chooseFile({
            count,
            success: (res) => {
              this.uploadFiles(field.name, res.tempFilePaths, false);
            },
          });
        }
      },

      /**
       * 根据路径推断是否为图片（H5 blob 路径无扩展名时需配合 preferImage）
       */
      isImageFilePath(filePath: string): boolean {
        const lower = filePath.toLowerCase();
        return (
          lower.includes(".png") ||
          lower.includes(".jpg") ||
          lower.includes(".jpeg") ||
          lower.includes(".gif") ||
          lower.includes(".webp") ||
          lower.includes(".bmp") ||
          lower.includes(".svg")
        );
      },

      async uploadFiles(
        fieldName: string,
        filePaths: string[],
        preferImage: boolean = false,
      ) {
        // 初始化字段文件列表
        const store = this.fileStore();
        if (readUtsField(store, fieldName) == null) {
          writeUtsField(store, fieldName, [] as UploadFileInfo[]);
        }

        for (const filePath of filePaths) {
          const uid = generateFileUid();
          const parts = filePath.split("/");
          const lastPart = parts.length > 0 ? parts[parts.length - 1] : "";
          const fileName = lastPart.length > 0 ? lastPart : "file";

          // 添加上传中的占位条目
          const isImage = preferImage ? true : this.isImageFilePath(filePath);
          const placeholder = new UploadFileInfo();
          placeholder.key = "";
          placeholder.name = fileName;
          placeholder.type = isImage ? "image/jpeg" : "application/octet-stream";
          placeholder.size = 0;
          placeholder.url = filePath;
          placeholder.uid = uid;
          placeholder.status = UploadFileStatus.uploading;
          placeholder.percent = 0;
          const currentList = this.getFileList(fieldName);
          writeUtsField(store, fieldName, [...currentList, placeholder]);

          // 执行上传
          const result = await uploadSingleFile(filePath, uid, (percent) => {
            const list = this.getFileList(fieldName);
            if (list.length == 0) return;
            const idx = list.findIndex((f) => f.uid === uid);
            if (idx >= 0) {
              list[idx].percent = percent;
              writeUtsField(store, fieldName, [...list]);
            }
          });

          // 更新条目状态
          const list = this.getFileList(fieldName);
          if (list.length == 0) continue;
          const idx = list.findIndex((f) => f.uid === uid);
          if (idx >= 0) {
            if (result.success && result.file != null) {
              let uploaded = result.file;
              // 服务端未返回 image/* 时，相册选图仍按图片预览
              if (
                preferImage &&
                uploaded.type != null &&
                !uploaded.type.includes("image/")
              ) {
                uploaded.type = "image/jpeg";
              }
              list[idx] = uploaded;
            } else {
              list[idx].status = UploadFileStatus.error;
            }
            writeUtsField(store, fieldName, [...list]);
          }
        }
      },

      removeFile(fieldName: string, uid: string) {
        const list = this.getFileList(fieldName);
        writeUtsField(this.fileStore(), fieldName, list.filter((f) => f.uid !== uid));
      },

      /**
       * 将文件数据转换为 AttachmentFile 格式存入 formData
       */
      syncFileDataToForm() {
        const fileStore = this.fileData as UTSJSONObject;
        const fieldNames = UTSJSONObject.keys(fileStore);
        for (let i = 0; i < fieldNames.length; i++) {
          const fieldName = fieldNames[i];
          const files = this.getFileList(fieldName);
          const doneFiles = files.filter(
            (f) => f.status === UploadFileStatus.done,
          );
          if (doneFiles.length > 0) {
            const attachments: AttachmentFile[] = [];
            for (let j = 0; j < doneFiles.length; j++) {
              const f = doneFiles[j];
              const attObj: UTSJSONObject = {
                fileKey: f.key != null ? f.key : "",
                fileUrl: f.url != null ? f.url : "",
                fileName: f.name != null ? f.name : "",
                mimeType: f.type != null ? f.type : "",
                fileSize: f.size != null ? f.size : 0,
              };
              attachments.push(attObj as AttachmentFile);
            }
            this.writeFormField(fieldName, attachments);
          }
        }
      },

      isEmptyValue(value: any | null): boolean {
        if (value == null || value === "") return true;
        if (Array.isArray(value) && value.length == 0) return true;
        return false;
      },

      validateFields(fields: ParsedField[]): boolean {
        for (const field of fields) {
          if (field.required && this.isEmptyValue(this.readFormField(field.name))) {
            uni.showToast({
              title: `${field.label}${t("Mobile.Intervention.McpAsk.requiredSuffix")}`,
              icon: "none",
            });
            return false;
          }
          if (
            field.widget == "number" &&
            !this.isEmptyValue(this.readFormField(field.name))
          ) {
            const num = parseFloat(
              this.formatNumberValue(this.readFormField(field.name)),
            );
            if (isNaN(num)) {
              uni.showToast({
                title: `${field.label}${t("Mobile.Intervention.McpAsk.invalidNumberSuffix")}`,
                icon: "none",
              });
              return false;
            }
            if (field.isInteger && !Number.isInteger(num)) {
              uni.showToast({
                title: `${field.label}${t("Mobile.Intervention.McpAsk.integerNumberSuffix")}`,
                icon: "none",
              });
              return false;
            }
            if (field.minimum != null && num < field.minimum) {
              uni.showToast({
                title: `${field.label}${t("Mobile.Intervention.McpAsk.minNumberSuffix")}${field.minimum}`,
                icon: "none",
              });
              return false;
            }
            if (field.maximum != null && num > field.maximum) {
              uni.showToast({
                title: `${field.label}${t("Mobile.Intervention.McpAsk.maxNumberSuffix")}${field.maximum}`,
                icon: "none",
              });
              return false;
            }
          }
          if (
            field.widget == "radio-with-custom" &&
            isSameFormValue(this.readFormField(field.name), field.otherValue) &&
            this.isEmptyValue(this.readFormField(field.otherField))
          ) {
            uni.showToast({
              title: `${field.label}${t("Mobile.Intervention.McpAsk.requiredSuffix")}`,
              icon: "none",
            });
            return false;
          }
        }
        return true;
      },

      handleNext() {
        if (!this.validateFields(this.visibleFields)) return;
        this.currentStep = Math.min(
          this.currentStep + 1,
          this.steps.length - 1,
        );
      },

      handlePrev() {
        this.currentStep = Math.max(this.currentStep - 1, 0);
      },

      handleSubmit() {
        this.syncFileDataToForm();
        if (!this.validateFields(this.parsedFields)) return;
        const ui = this.uiSchema();
        if (ui == null) return;
        const formValues = cloneUtsObject(this.formData as UTSJSONObject);
        const files = extractMcpAskFormAttachments(
          formValues as any,
          ui,
        );
        this.$emit(
          "respond",
          this.buildRespondPayload("submit", formValues as any, files),
        );
      },
      handleCancel() {
        this.$emit("respond", this.buildRespondPayload("cancel", null, null));
      },
      handleSkip() {
        this.$emit("respond", this.buildRespondPayload("skip", null, null));
      },
      /**
       * 构建 MCP Ask 响应 payload，统一 submit / cancel / skip 公共字段
       */
      buildRespondPayload(
        action: "submit" | "cancel" | "skip",
        submitFormData: any | null,
        submitFiles: UploadFileInfo[] | null,
      ): McpAskRespondPayload {
        // revision 缺失/非正数时回退 1（保持原 revision != null && revision > 0 语义）
        const revisionRaw = readRawField(this.interaction as UTSJSONObject, "revision");
        let revision = 1;
        if (revisionRaw != null && typeof revisionRaw === "number" && (revisionRaw as number) > 0) {
          revision = revisionRaw as number;
        }
        const payload = new McpAskRespondPayload();
        payload.interventionId = orString(
          readRawField(this.interaction as UTSJSONObject, "requestId"),
          "",
        );
        const toolCallId = readRawField(this.interaction as UTSJSONObject, "toolCallId");
        if (toolCallId != null && `${toolCallId}`.length > 0) {
          payload.toolCallId = `${toolCallId}`;
        }
        payload.revision = revision > 0 ? revision : 1;
        payload.source = "mcp_ask";
        payload.protocol = "mcp";
        payload.action = action;
        const answeredBy = new McpAskAnsweredBy();
        answeredBy.kind = "mobile";
        payload.answeredBy = answeredBy;
        payload.answeredAt = Date.now();
        if (submitFormData != null) {
          payload.formData = submitFormData;
        }
        if (submitFiles != null && submitFiles.length > 0) {
          payload.files = submitFiles;
        }
        return payload;
      },
    },
  };
</script>

<style lang="scss" scoped>
  // 卡片容器及公共布局变量
  $card-bg-color: #fff;
  $card-border-radius: 16rpx;
  $card-padding: 24rpx;
  $card-margin: 8rpx;
  $card-box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);

  // 基础状态颜色
  $primary-color: #1677ff;
  $success-color: #52c41a;
  $warning-color: #faad14;
  $danger-color: #ff4d4f;
  $cancel-color: #999;

  // 灰色与辅助颜色背景
  $bg-gray-light: #f7f9fc;
  $bg-gray-tag: #f0f0f0;
  $bg-gray-file: #fafafa;
  $bg-mask: rgba(0, 0, 0, 0.5);

  // 字体颜色
  $text-color-primary: #1a1a1a;
  $text-color-secondary: #666;
  $text-color-light: #fff;
  $text-wizard-title: #1f2937;
  $text-wizard-desc: #6b7280;
  $text-field-label: #333;

  // 边框颜色
  $border-color: #e0e0e0;
  $border-color-light: #d0d0d0;

  // 尺寸与圆角倒角
  $field-border-radius: 12rpx;
  $button-border-radius: 12rpx;
  $button-border-radius-double: 24rpx;

  .mcp-ask-card {
    background-color: $card-bg-color;
    border-radius: $card-border-radius;
    padding: $card-padding;
    margin: $card-margin;
    box-shadow: $card-box-shadow;
    display: flex;
    flex-direction: column;

    .card-error-msg {
      font-size: 24rpx;
      color: $danger-color;
      padding-top: 12rpx;
    }

    .card-header {
      margin-bottom: 20rpx;

      .card-eyebrow {
        font-size: 22rpx;
        font-weight: 500;
        color: $primary-color;
        margin-bottom: 6rpx;
      }

      .card-title {
        font-size: 32rpx;
        font-weight: 600;
        color: $text-color-primary;
      }

      .card-desc {
        font-size: 26rpx;
        color: $text-color-secondary;
        margin-top: 8rpx;
      }
    }

    .status-tag {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 12rpx 16rpx;
      border-radius: 8rpx;
      background-color: $bg-gray-tag;
      margin-bottom: 16rpx;

      .status-icon {
        font-size: 28rpx;
        margin-right: 8rpx;

        &.status-icon-success {
          color: $success-color;
        }

        &.status-icon-cancelled {
          color: $cancel-color;
        }

        &.status-icon-skipped {
          color: $warning-color;
        }
      }

      .status-tag-text {
        font-size: 24rpx;
        color: $text-color-secondary;
      }
    }

    .card-form {
      display: flex;
      flex-direction: column;

      .wizard-steps-block {
        margin-bottom: 16rpx;

        .wizard-step-row {
          display: flex;
          flex-direction: row;
          align-items: flex-start;

          .wizard-step-cell {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;

            .step-icon-row {
              width: 100%;
              display: flex;
              flex-direction: row;
              align-items: center;

              .step-connector-half {
                flex: 1;
                height: 2rpx;
                background-color: $border-color;

                &.step-connector-active {
                  background-color: $primary-color;
                }
              }

              .step-circle {
                flex-shrink: 0;
                width: 40rpx;
                height: 40rpx;
                border-radius: 20rpx;
                border: 2rpx solid $border-color-light;
                display: flex;
                align-items: center;
                justify-content: center;

                &.step-circle-done {
                  background-color: $primary-color;
                  border-color: $primary-color;
                }

                &.step-circle-active {
                  border-color: $primary-color;

                  .step-num-text {
                    color: $primary-color;
                    font-weight: 600;
                  }
                }

                .step-check-icon {
                  font-size: 22rpx;
                  color: $text-color-light;
                }

                .step-num-text {
                  font-size: 22rpx;
                  color: $text-color-secondary;
                }
              }
            }

            .step-label {
              margin-top: 8rpx;
              font-size: 20rpx;
              color: $text-color-secondary;
              text-align: center;

              &.step-label-active {
                color: $primary-color;
                font-weight: 500;
              }
            }
          }
        }

        .step-callout {
          margin-top: 12rpx;
          padding: 12rpx 16rpx;
          border-radius: $field-border-radius;
          background-color: $bg-gray-light;

          .step-callout-text {
            font-size: 24rpx;
            color: $text-wizard-desc;
          }
        }
      }

      .card-form-scroll {
        // 表单区封顶高度，超出滚动（控件已能正常渲染，== 修复后 scroll-view 不再空白）
        max-height: 400rpx;
        margin-bottom: 16rpx;
      }

      .form-field {
        margin-bottom: 24rpx;

        .field-label {
          font-size: 28rpx;
          color: $text-field-label;
          margin-bottom: 12rpx;
          font-weight: 500;

          .field-required {
            color: $danger-color;
            margin-left: 4rpx;
          }
        }

        .field-input {
          width: 100%;
          // Android uvue：原生 <input> 不会像 iOS/H5 自动给默认高度，缺 height 会塌成 0（不可见）。
          height: 80rpx;
          border: 2rpx solid $border-color;
          border-radius: $field-border-radius;
          padding: 16rpx 20rpx;
          font-size: 28rpx;

          &.custom-input {
            margin-top: 12rpx;
          }
        }

        .field-textarea {
          width: 100%;
          border: 2rpx solid $border-color;
          border-radius: $field-border-radius;
          padding: 16rpx 20rpx;
          font-size: 28rpx;
          min-height: 160rpx;
        }

        /* 单选列表（样式类似 checkboxes） */
        .field-list-group {
          display: flex;
          flex-direction: column;
          /* #ifdef H5 || WEB */
          gap: 8rpx;
          /* #endif */

          .list-option {
            display: flex;
            flex-direction: row;
            align-items: center;
            padding: 8rpx 0;
            /* #ifndef H5 || WEB */
            margin-bottom: 8rpx;
            /* #endif */

            .list-radio-dot {
              width: 32rpx;
              height: 32rpx;
              border-radius: 50%;
              border: 2rpx solid $border-color-light;
              margin-right: 12rpx;
              display: flex;
              align-items: center;
              justify-content: center;

              &.dot-selected {
                border-color: $primary-color;
                background-color: $primary-color;
              }

              .dot-check-icon {
                font-size: 20rpx;
                color: $text-color-light;
                font-weight: bold;
                line-height: 1;
                padding: 0;
                margin: 0;
              }
            }

            .list-label {
              font-size: 28rpx;
              color: $text-field-label;
            }
          }
        }

        /* 文件上传 */
        .field-file-area {
          display: flex;
          flex-direction: column;
          /* #ifdef H5 || WEB */
          gap: 16rpx;
          /* #endif */

          .file-upload-actions {
            display: flex;
            flex-direction: row;
            /* #ifdef H5 || WEB */
            gap: 16rpx;
            /* #endif */

            .file-upload-btn {
              flex: 1;
              display: flex;
              flex-direction: row;
              align-items: center;
              justify-content: center;
              /* #ifdef H5 || WEB */
              gap: 8rpx;
              /* #endif */
              padding: 20rpx 0;
              border: 2rpx dashed $border-color-light;
              border-radius: $field-border-radius;
              color: $text-color-secondary;
              font-size: 28rpx;

              .file-upload-btn-text {
                font-size: 28rpx;
                color: $text-color-secondary;
              }
            }

            .file-upload-btn-leading {
              /* #ifndef H5 || WEB */
              margin-right: 16rpx;
              /* #endif */
            }
          }
        }
      }

      .form-actions {
        flex-shrink: 0;
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        /* #ifdef H5 || WEB */
        gap: 16rpx;
        /* #endif */
        margin-top: 24rpx;

        .action-button {
          // 用 1 1 auto（按内容定基准）而非 1 1 0（强制等宽）：
          // 否则「提交并生成」这类长文案只分到 1/3 宽度、文字被挤换行。
          flex: 1 1 auto;
          min-width: 160rpx;
          /* #ifndef H5 || WEB */
          margin-right: 16rpx;
          margin-bottom: 16rpx;
          /* #endif */
        }
      }
    }
  }

  /* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
  ::v-deep .l-button {
    border: 0 !important;
    border-radius: $button-border-radius !important;
    overflow: visible !important;
  }
  ::v-deep .l-button::after {
    border-radius: $button-border-radius-double !important;
  }
  /* #endif */
</style>
