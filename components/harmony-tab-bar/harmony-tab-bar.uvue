<template>
  <view class="harmony-tab-bar" :style="safeAreaStyle">
    <view
      v-for="(item, index) in items"
      :key="item.path"
      class="harmony-tab-bar__item"
      @click="switchTo(index)"
    >
      <text class="harmony-tab-bar__label" :class="{ 'harmony-tab-bar__label--active': index == active }">{{ t(item.key) }}</text>
      <view v-if="badgeCount(index) > 0" class="harmony-tab-bar__badge">
        <text class="harmony-tab-bar__badge-text">{{ badgeText(index) }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import { onPageShow } from "@dcloudio/uni-app";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { systemMessageUnreadCount } from "@/utils/notificationBadge";
  import { imUnreadCount } from "@/utils/imUnreadBadge";

  type HarmonyTabItem = { path: string; key: string };

  const items: Array<HarmonyTabItem> = [
    { path: "/pages/message/message", key: "Mobile.Nav.message" },
    { path: "/pages/index/index", key: "Mobile.Nav.task" },
    { path: "/pages/expert-list/expert-list", key: "Mobile.Nav.expert" },
    { path: "/pages/app-dev/app-dev", key: "Mobile.Nav.app" },
    { path: "/pages/mine/mine", key: "Mobile.Nav.mine" },
  ];

  const props = defineProps<{ active: number }>();
  const active = computed((): number => props.active);
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const badgeCount = (index: number): number => {
    if (index == 0) return imUnreadCount.value;
    if (index == 4) return systemMessageUnreadCount.value;
    return 0;
  };
  const badgeText = (index: number): string => {
    const count = badgeCount(index);
    return count > 99 ? "99+" : `${count}`;
  };

  onPageShow(() => {
    uni.hideTabBar({ animation: false });
  });

  const safeAreaStyle = computed((): string => {
    const info = uni.getSystemInfoSync();
    const bottom = info.safeAreaInsets != null ? info.safeAreaInsets.bottom : 0;
    return `padding-bottom: ${bottom > 0 ? bottom : 0}px;`;
  });

  function switchTo(index: number): void {
    if (index == props.active) return;
    uni.switchTab({ url: items[index].path });
  }
</script>

<style scoped>
  .harmony-tab-bar {
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    height: 50px;
    box-sizing: content-box;
    background-color: #ffffff;
  }

  .harmony-tab-bar__item {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .harmony-tab-bar__label {
    font-size: 35rpx;
    line-height: 48rpx;
    color: #8a8a93;
  }

  .harmony-tab-bar__label--active {
    color: #141416;
  }

  .harmony-tab-bar__badge {
    position: absolute;
    top: 4px;
    right: 12px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    background-color: #ff4d4f;
    align-items: center;
    justify-content: center;
  }

  .harmony-tab-bar__badge-text {
    font-size: 11px;
    color: #ffffff;
  }
</style>
