import { UIApplication, UIView } from "UIKit";
export function executeVoip(command: string): void { NuwaxVoipBridge.execute(command); }
export function drainVoipEvents(): string { return NuwaxVoipBridge.drainEvents(); }
export class VoipVideoBinding {
  private view: UIView | null = null;
  constructor(element: UniNativeViewElement, local: boolean) {
    const view = NuwaxVoipBridge.createVideoView(local); this.view = view; element.bindIOSView(view);
  }
  release(): void { const view = this.view; if (view != null) NuwaxVoipBridge.releaseVideoView(view); this.view = null; }
}
export function ensureVoipPermissions(mediaType: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => { NuwaxVoipBridge.requestPermissions(mediaType, (granted: boolean) => { resolve(granted); }); });
}

/** Native startup hook only restores an already consented, logged-in call context. */
export class NuwaxVoipHook implements UTSiOSHookProxy {
  applicationDidFinishLaunchingWithOptions(_application: UIApplication | null, _launchOptions: Map<UIApplication.LaunchOptionsKey, any> | null): boolean {
    NuwaxVoipBridge.restoreOnLaunch(); return true;
  }
}
