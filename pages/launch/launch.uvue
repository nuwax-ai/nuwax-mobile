<template>
  <view class="launch-page">
    <!-- #ifdef APP-ANDROID -->
    <!-- 沿用“我的”中的线上隐私协议；用户明确同意之前不进入业务页面。 -->
    <view v-if="showPrivacy" class="privacy-card">
      <text class="privacy-title">用户协议与隐私保护指引</text>
      <text class="privacy-text">请阅读隐私协议。点击“同意并继续”后才能使用女娲 App；阅读、返回或关闭均不代表同意。</text>
      <web-view class="privacy-document" :src="privacyPolicyUrl"></web-view>
      <view class="privacy-actions">
        <button class="privacy-decline" @click="declinePrivacy">不同意</button>
        <button class="privacy-agree" open-type="agreePrivacyAuthorization" @click="agreePrivacy">同意并继续</button>
      </view>
    </view>
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { switchMainTab } from "@/utils/mainTabNavigation";
  import { onReady, onUnload } from "@dcloudio/uni-app";
  import { ACCESS_TOKEN } from "@/constants/home.constants";
  import { routeIncomingShare } from "@/utils/appShare";
  // #ifdef APP-ANDROID
  import { completeAppPrivacyConsent, prepareAppPrivacyConsent } from "@/utils/appPrivacyConsent";
  import { APP_PRIVACY_POLICY_URL } from "@/constants/appPrivacyPolicy";
  // #endif
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  import { scheduleImPushAfterLogin } from "@/utils/im/imPushClient";
  // #endif

  // #ifdef APP-ANDROID
  const showPrivacy = ref(false);
  const privacyPolicyUrl = APP_PRIVACY_POLICY_URL;
  let privacyListener = 0;
  let acceptingPrivacy = false;
  // #endif
  let routed = false;

  function routeByAuthState(): void {
    if (routed) return;
    routed = true;
    const raw = uni.getStorageSync(ACCESS_TOKEN);
    const token = raw != null ? `${raw}`.trim() : "";
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    if (token.length > 0) scheduleImPushAfterLogin();
    // #endif
    if (routeIncomingShare(token.length > 0, "")) return;
    if (token.length == 0) {
      uni.reLaunch({ url: "/subpackages/pages/login/login" });
    } else {
      switchMainTab({ url: "/pages/message/message" });
    }
  }

  // #ifdef APP-ANDROID
  function declinePrivacy(): void { uni.exit(); }

  // 原生按钮完成真实授权后，显式完成本地记录、关闭弹窗和登录态分流。
  // 不能只依赖全局授权变化事件：独立 APK 里的按钮点击也必须有自己的完成链路。
  function agreePrivacy(): void {
    if (acceptingPrivacy || routed) return;
    acceptingPrivacy = true;
    setTimeout(() => {
      completeAppPrivacyConsent((accepted: boolean) => {
        acceptingPrivacy = false;
        if (!accepted) {
          uni.showToast({ title: "隐私授权未完成，请再次点击同意", icon: "none" });
          return;
        }
        showPrivacy.value = false;
        routeByAuthState();
      });
    }, 0);
  }
  // #endif

  onReady(() => {
    // #ifdef APP-ANDROID
    privacyListener = uni.onPrivacyAuthorizationChange((res) => {
      if (res.needAuthorization) return;
      agreePrivacy();
    });
    prepareAppPrivacyConsent((accepted: boolean) => {
      if (accepted) routeByAuthState();
      else showPrivacy.value = true;
    });
    // #endif
    // #ifndef APP-ANDROID
    routeByAuthState();
    // #endif
  });
  onUnload(() => {
    // #ifdef APP-ANDROID
    if (privacyListener > 0) uni.offPrivacyAuthorizationChange(privacyListener);
    // #endif
  });
</script>

<style scoped>
  /* #ifndef APP-ANDROID */
  .launch-page { flex: 1; background-color: #ffffff; }
  /* #endif */
  /* #ifdef APP-ANDROID */
  .launch-page { flex: 1; padding: 32px 4px 20px; background-color: #f5f4fa; }
  .privacy-card { flex: 1; width: 100%; border-radius: 12px; background-color: #ffffff; }
  .privacy-title { font-size: 18px; font-weight: bold; color: #222222; margin: 12px 12px 6px; }
  .privacy-document { flex: 1; width: 100%; margin-bottom: 10px; }
  .privacy-text { font-size: 13px; line-height: 20px; color: #444444; margin: 0 12px 10px; }
  .privacy-actions { flex-direction: row; margin: 0 8px 12px; }
  .privacy-decline { flex: 1; margin-right: 12px; font-size: 15px; color: #555555; background-color: #f0f0f3; border-radius: 24px; }
  .privacy-agree { flex: 1; font-size: 15px; color: #ffffff; background-color: #5147ff; border-radius: 24px; }
  /* #endif */
</style>
