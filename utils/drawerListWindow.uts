/** 与抽屉两种列表的固定行高一致，单位为 CSS px。 */
export const DRAWER_PROJECT_ROW_HEIGHT = 38;
export const DRAWER_PROJECT_CHILD_HEIGHT = 33;
export const DRAWER_PROJECT_EMPTY_CHILD_HEIGHT = 25;
export const DRAWER_PROJECT_GAP = 4;
export const DRAWER_PROJECT_EMPTY_HEIGHT = 165;
export const DRAWER_PROJECT_MORE_HEIGHT = 44;
export const DRAWER_TASK_HEADER_HEIGHT = 35;
export const DRAWER_TASK_ROW_HEIGHT = 38;
export const DRAWER_SCROLL_STEP = 96;

export class DrawerListWindow {
  start: number = 0;
  end: number = 0;
  before: number = 0;
  after: number = 0;
}

function boundaryIndex(offsets: number[], position: number, strict: boolean): number {
  let low = 0;
  let high = offsets.length;
  while (low < high) {
    const middle = Math.floor((low + high) / 2);
    const boundary = offsets[middle];
    if (boundary < position || (strict && boundary == position)) low = middle + 1;
    else high = middle;
  }
  return low;
}

/** offsets 包含首端 0 和末端总高度。占位保留原始滚动坐标及触底距离。 */
export function resolveDrawerListWindow(offsets: number[], top: number, bottom: number): DrawerListWindow {
  const window = new DrawerListWindow();
  const count = offsets.length - 1;
  if (count <= 0) return window;
  window.start = Math.max(0, Math.min(count, boundaryIndex(offsets, top, true) - 1));
  window.end = bottom <= top ? window.start : Math.max(window.start, Math.min(count, boundaryIndex(offsets, bottom, false)));
  window.before = offsets[window.start];
  window.after = offsets[count] - offsets[window.end];
  return window;
}
