import type { AgentSelectedComponentInfo } from "./agent";
import { SelectedDocInfo } from "./knowledgeList";

/** 首页创建会话后，交给会话页自动发送的一次性草稿。 */
export class PendingChatDraft {
  version: number = 1;
  createdAt: number = 0;
  agentId: number = 0;
  conversationId: number = 0;
  message: string = "";
  // 附件为已上传后的结构化数据，使用 UTSJSONObject 避免接口无法实例化。
  attachments: UTSJSONObject[] = [];
  selectedComponents: AgentSelectedComponentInfo[] = [];
  skillIds: number[] = [];
  sandboxId: string = "";
  modelId: number = 0;
  /** 首页已选模型名称，用于会话页首屏与 modelId 保持一致。 */
  modelName: string = "";
  agentMode?: "ask" | "yolo";
  /** 自定义工作目录（仅个人电脑沙箱生效时携带；对齐 PC workspacePath） */
  workspacePath?: string;
  /** 已选资料库文档（对齐 PC selectedDocs：随首条消息发送） */
  selectedDocs: SelectedDocInfo[] = [] as SelectedDocInfo[];
}
