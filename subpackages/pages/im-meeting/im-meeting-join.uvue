<template>
  <!--
    加入会议（伙伴页「会议」tab 的第二个入口）。

    ★文案与交互逐项对齐 PC `MeetingPane.tsx` 的「加入会议」弹窗：
      字段一 = 会议号 / 邀请码、字段二 = 入会密码（如会议设置了），底部「取消 / 加入」。
      PC 弹窗里点「加入」就**直接入会**，中间没有确认屏；本页同理——校验通过即进会，
      不再停在一个中间结果页上（原来的「会议室信息 + 复制会议号」屏 PC 没有，已去掉）。

    ★为什么还要先打一次匿名接口（GET /meetings/public/rooms/{room}）：
      PC 的 joinRoomMeeting 由服务端直接报错，错误文案来自接口；端上没有媒体层，
      只有这一步能把「会议不存在 / 已取消 / 还没开始 / 要密码 / 要登录」说清楚，
      否则用户只会看到一句笼统的失败。
    ★用匿名端点的另一个理由：它不要求登录、401 也不广播 auth-expired ——
      登录用户与游客看到的是同一份事实。
  -->
  <view class="mj-page">
    <safety-zone />

    <view class="mj-header">
      <view class="mj-header__btn" hover-class="mj-header__btn--active" @click="handleBack">
        <back-chevron :size="20" color="#141416" />
      </view>
      <view class="mj-header__title-wrap">
        <text class="mj-header__title">{{ t("Mobile.Meeting.join") }}</text>
      </view>
      <view class="mj-header__btn mj-header__btn--ghost" />
    </view>

    <scroll-view class="mj-body" direction="vertical" :show-scrollbar="false">
      <view class="mj-card">
        <text class="mj-label">{{ t("Mobile.Meeting.joinNoLabel") }}</text>
        <input
          class="mj-input"
          v-model="rawNo"
          :maxlength="80"
          :placeholder="t('Mobile.Meeting.joinNoPlaceholder')"
          placeholder-style="color:#b0aebc"
        />
      </view>

      <view class="mj-card">
        <text class="mj-label">{{ t("Mobile.Meeting.joinPasscodeLabel") }}</text>
        <input
          class="mj-input"
          v-model="passcode"
          type="number"
          :maxlength="6"
          :placeholder="t('Mobile.Meeting.joinPasscodePlaceholder')"
          placeholder-style="color:#b0aebc"
        />
        <!-- 设了密码却没填：就地提示，不把用户丢回上一屏（PC 由服务端拦，端上先讲清楚） -->
        <text v-if="needPasscodeHint" class="mj-hint mj-hint--warn">{{ t("Mobile.Meeting.passcodeRequired") }}</text>
      </view>

      <view class="mj-actions">
        <view class="mj-btn" hover-class="mj-btn--active" @click="handleBack">
          <text class="mj-btn__text">{{ t("Mobile.Common.cancel") }}</text>
        </view>
        <view
          class="mj-btn mj-btn--primary"
          :class="{ 'mj-btn--busy': checking }"
          hover-class="mj-btn--primary-active"
          @click="handleSubmit"
        >
          <text class="mj-btn__text mj-btn__text--primary">{{ checking ? t("Mobile.Meeting.validating") : t("Mobile.Meeting.submitJoin") }}</text>
        </view>
      </view>

      <view class="mj-tail" />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiImMeetingPublicRoomSafe } from "@/servers/imMeeting";
  import { hasLoginSession } from "@/utils/authSession";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { normalizeMeetingNo, readInviteNoFromUrl } from "@/utils/meeting/meetingLink";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const rawNo = ref<string>("");
  const passcode = ref<string>("");
  const checking = ref<boolean>(false);
  /** 上次校验提示「该会议需要入会密码」：只在用户填了空密码试过之后亮起。 */
  const needPasscodeHint = ref<boolean>(false);

  onLoad((options: any) => {
    // 邀请卡片/深链带过来的会议号（或 slug）：预填，用户点一下就能进
    if (options == null) {
      return;
    }
    const obj = options as UTSJSONObject;
    const preset = obj["room"];
    if (preset != null) {
      rawNo.value = `${preset}`;
    }
  });

  function handleBack(): void {
    uni.navigateBack({ delta: 1 });
  }

  function readStr(obj: UTSJSONObject, key: string): string {
    const value = obj[key];
    return value != null ? `${value}` : "";
  }

  function readNum(obj: UTSJSONObject, key: string, fallback: number): number {
    const value = obj[key];
    if (value == null) {
      return fallback;
    }
    if (typeof value == "number") {
      const n = value as number;
      return n != n ? fallback : n;
    }
    const parsed = parseFloat(`${value}`);
    return parsed != parsed ? fallback : parsed;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const value = obj[key];
    if (value == null) {
      return false;
    }
    if (typeof value == "boolean") {
      return value as boolean;
    }
    return `${value}` == "true";
  }

  /** 会议号归一化：整段粘贴的邀请链接也认（链接里带的是 slug 或老会议号）。 */
  function resolveRoom(raw: string): string | null {
    const text = raw.trim();
    if (text.length == 0) {
      return null;
    }
    const fromLink = readInviteNoFromUrl(text);
    if (fromLink != null) {
      return fromLink;
    }
    return normalizeMeetingNo(text);
  }

  /**
   * 点「加入」：先归一化 → 匿名核房间状态 → 进会。
   * 与 PC `doJoin` 的差别只在中间那次状态查询（原因见文件头注释），
   * 校验顺序与错误文案与 PC 一一对应。
   */
  async function handleSubmit(): Promise<void> {
    if (checking.value) {
      return;
    }
    const room = resolveRoom(rawNo.value);
    if (room == null) {
      uni.showToast({ title: t("Mobile.Meeting.invalidNo"), icon: "none" });
      return;
    }
    checking.value = true;
    needPasscodeHint.value = false;
    try {
      // ★用 Safe 变体：失败文案由本页自己说（框架再弹一条只会叠两层 toast）
      const res = await apiImMeetingPublicRoomSafe(room);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Meeting.roomEnded"), icon: "none" });
        return;
      }
      const dataRaw = apiResData<any>(res);
      if (dataRaw == null) {
        uni.showToast({ title: t("Mobile.Meeting.roomEnded"), icon: "none" });
        return;
      }
      const data = dataRaw as UTSJSONObject;
      const active = readBool(data, "active");
      const status = readNum(data, "status", -1);
      const requiresPasscode = readBool(data, "requiresPasscode");
      const allowEarlyJoin = readBool(data, "allowEarlyJoin");
      const guestAllowed = readBool(data, "guestAllowed");

      // 已取消 / 已结束 / 还没开始（且不允许提前进入）：都是「不能进」，但话不一样
      if (status == 3) {
        uni.showToast({ title: t("Mobile.Meeting.roomCancelled"), icon: "none" });
        return;
      }
      if (!active && status == 0 && !allowEarlyJoin) {
        uni.showToast({ title: t("Mobile.Meeting.roomNotStarted"), icon: "none" });
        return;
      }
      if (!active && status != 0) {
        uni.showToast({ title: t("Mobile.Meeting.roomEnded"), icon: "none" });
        return;
      }
      // 设了密码但没填：先补密码再来，不把用户丢回上一屏
      if (requiresPasscode && passcode.value.trim().length == 0) {
        needPasscodeHint.value = true;
        return;
      }
      // 这场会不允许游客、而当前又没有登录态：媒体层发不出令牌，提前把话说清楚
      if (!guestAllowed && !hasLoginSession()) {
        uni.showToast({ title: t("Mobile.Meeting.joinLoginRequired"), icon: "none" });
        return;
      }

      // 媒体层（LiveKit）尚未接入：如实提示，不伪造一个进不去的会中页
      uni.showToast({ title: t("Mobile.Meeting.enginePending"), icon: "none" });
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Meeting.roomEnded"), icon: "none" });
    } finally {
      checking.value = false;
    }
  }
</script>

<style lang="scss" scoped>
  .mj-page {
    flex: 1;
    background-color: #f5f6f8;
  }

  .mj-header {
    height: 48px;
    padding: 0 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .mj-header__btn {
    width: 40px;
    height: 40px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mj-header__btn--active {
    opacity: 0.6;
  }

  .mj-header__btn--ghost {
    opacity: 0;
  }

  .mj-header__title-wrap {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mj-header__title {
    font-size: 17px;
    line-height: 24px;
    font-weight: 600;
    color: #141416;
  }

  .mj-body {
    flex: 1;
  }

  .mj-card {
    margin: 10px 12px 0 12px;
    padding: 14px;
    background-color: #ffffff;
    border-radius: 12px;
  }

  .mj-label {
    font-size: 13px;
    line-height: 18px;
    color: rgba(21, 23, 31, 0.55);
  }

  .mj-input {
    margin-top: 8px;
    height: 24px;
    font-size: 16px;
    line-height: 24px;
    color: #141416;
  }

  .mj-hint {
    margin-top: 6px;
    font-size: 11px;
    line-height: 16px;
    color: rgba(21, 23, 31, 0.4);
  }

  .mj-hint--warn {
    color: #e05353;
  }

  /* 底部「取消 / 加入」：与 PC 弹窗页脚同序（左取消、右主操作） */
  .mj-actions {
    margin: 24px 12px 0 12px;
    display: flex;
    flex-direction: row;
  }

  .mj-btn {
    flex: 1;
    height: 46px;
    border-radius: 23px;
    background-color: #f2f1f7;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mj-btn--active {
    opacity: 0.7;
  }

  /* 主操作黑色（与预约页「保存」同一套按钮风格） */
  .mj-btn--primary {
    margin-left: 10px;
    background-color: #111111;
  }

  .mj-btn--primary-active {
    opacity: 0.85;
  }

  .mj-btn--busy {
    opacity: 0.6;
  }

  .mj-btn__text {
    font-size: 15px;
    line-height: 21px;
    font-weight: 600;
    color: #141416;
  }

  .mj-btn__text--primary {
    color: #ffffff;
  }

  .mj-tail {
    height: 32px;
  }
</style>
