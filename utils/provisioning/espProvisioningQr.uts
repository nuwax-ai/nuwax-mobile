/** Nuwax 配网二维码（URL 方案）解析与生产安全校验。 */
import {
  EspProvisioningQrParseResult,
  EspProvisioningQrPayload,
} from '@/types/interfaces/espProvisioning';
import { EspProvisioningSecurityEnum } from '@/types/enums/espProvisioning';

/** 二维码链接允许的主机：nuwax.com 及其子域名（覆盖 dev/staging 测试环境）。 */
const PROVISION_QR_HOST = 'nuwax.com';
/** 二维码链接固定路径。 */
const PROVISION_QR_PATH = '/lz.html';

/**
 * 清洗扫码原始文本：按码点过滤 BOM / 零宽 / 格式字符 / 控制字符 + 首尾空白。
 * Android 部分机型 scanCode 会在结果里注入 U+FEFF、零宽连接符(U+200C/D)、NBSP(U+A0)、
 * 字连接符(U+2060) 等不可见字符。链接取值均为 ASCII，按码点剥掉这些不可见/控制字符是安全的。
 */
function sanitizeQrRaw(raw: string): string {
  let out = '';
  for (let i = 0; i < raw.length; i++) {
    const c = raw.charCodeAt(i) ?? 0;
    if (c < 0x20) continue;                       // 控制字符（\r\n\t 等）
    if (c == 0xfeff) continue;                    // BOM / 零宽非断空格
    if (c == 0xa0) continue;                      // 不间断空格 NBSP
    if (c >= 0x200b && c <= 0x200f) continue;     // 零宽空格/非连接/连接 + 方向标记
    if (c >= 0x2028 && c <= 0x202e) continue;     // 行/段分隔 + 方向覆盖
    if (c >= 0x2060 && c <= 0x2064) continue;     // 字连接符 + 不可见数学运算符
    out += raw.charAt(i);
  }
  return out.trim();
}

/** URL 结构视图（纯字符串解析，不依赖平台 URL 类，保证 Android/iOS/H5 行为一致）。 */
class ParsedUrl {
  scheme: string;
  host: string;
  path: string;
  query: string;

  constructor(scheme: string, host: string, path: string, query: string) {
    this.scheme = scheme;
    this.host = host;
    this.path = path;
    this.query = query;
  }
}

/**
 * 把清洗后的文本拆成 scheme/host/path/query。
 * 无 `://`、scheme 为空或 host 为空时返回 null（不是合法链接结构）。
 * host 去除 userinfo（user:pass@host）与端口（host:8080）后统一小写；
 * fragment（#…）对配网无意义，直接丢弃。
 */
function parseUrlStructure(raw: string): ParsedUrl | null {
  const schemeSep = raw.indexOf('://');
  if (schemeSep <= 0) return null;
  const scheme = raw.substring(0, schemeSep).toLowerCase();
  let rest = raw.substring(schemeSep + 3);
  const fragmentIdx = rest.indexOf('#');
  if (fragmentIdx >= 0) rest = rest.substring(0, fragmentIdx);
  const queryIdx = rest.indexOf('?');
  const pathAndHost = queryIdx >= 0 ? rest.substring(0, queryIdx) : rest;
  const query = queryIdx >= 0 ? rest.substring(queryIdx + 1) : '';
  const slashIdx = pathAndHost.indexOf('/');
  let hostRaw = slashIdx >= 0 ? pathAndHost.substring(0, slashIdx) : pathAndHost;
  const path = slashIdx >= 0 ? pathAndHost.substring(slashIdx) : '';
  const atIdx = hostRaw.lastIndexOf('@');
  if (atIdx >= 0) hostRaw = hostRaw.substring(atIdx + 1);
  const colonIdx = hostRaw.lastIndexOf(':');
  if (colonIdx >= 0) hostRaw = hostRaw.substring(0, colonIdx);
  const host = hostRaw.toLowerCase();
  if (host == '') return null;
  return new ParsedUrl(scheme, host, path, query);
}

/** 解码单个 query 组件；percent 序列非法时返回 null（视为无效二维码）。 */
function decodeQueryComponent(value: string): string | null {
  try {
    return decodeURIComponent(value);
  } catch (e) {
    return null;
  }
}

/**
 * 解析 query 为参数表。同名参数取第一个出现；key/value 任一处 percent 编码非法
 * 即整体返回 null。未知参数忽略，保留前向扩展空间。
 */
function parseQueryParams(query: string): Map<string, string> | null {
  const map = new Map<string, string>();
  if (query == '') return map;
  const pairs = query.split('&');
  for (let i = 0; i < pairs.length; i++) {
    const pair = pairs[i];
    if (pair == '') continue;
    const eqIdx = pair.indexOf('=');
    const rawKey = eqIdx >= 0 ? pair.substring(0, eqIdx) : pair;
    const rawValue = eqIdx >= 0 ? pair.substring(eqIdx + 1) : '';
    const key = decodeQueryComponent(rawKey);
    if (key == null) return null;
    const value = decodeQueryComponent(rawValue);
    if (value == null) return null;
    if (!map.has(key)) map.set(key, value);
  }
  return map;
}

/**
 * 解析配网二维码链接（新 URL 方案）：
 *
 *   https://nuwax.com/lz.html?n=PROV_A1B2C3&u=NX-A1B2-C3D4-E5F6&p=<PoP>
 *
 *  - n = name：广播名（PROV_ + STA MAC 后三字节大写十六进制）
 *  - u = username：设备 UID（Security 2 SRP6a 用户名，须与固件一致）
 *  - p = pop：逐设备随机 PoP（Security 2 证明密钥）
 *
 * transport/network/security 不再由二维码携带，按本期冻结契约固定为
 * ble / wifi / Security 2（不允许降级）。
 *
 * 失败只返回稳定错误码，不回传原始文本，避免调用方误写敏感日志（URL 内含 PoP）。
 */
export function parseNuwaxProvisionUrl(raw: string): EspProvisioningQrParseResult {
  const cleaned = sanitizeQrRaw(raw);
  if (cleaned == '') return new EspProvisioningQrParseResult(null, 'QR_EMPTY');

  const url = parseUrlStructure(cleaned);
  if (url == null) return new EspProvisioningQrParseResult(null, 'QR_URL_INVALID');
  if (url.scheme != 'https' && url.scheme != 'http') {
    return new EspProvisioningQrParseResult(null, 'QR_SCHEME_UNSUPPORTED');
  }
  // 域名白名单：防误扫普通网页二维码被当作配网码
  if (url.host != PROVISION_QR_HOST && !url.host.endsWith('.' + PROVISION_QR_HOST)) {
    return new EspProvisioningQrParseResult(null, 'QR_HOST_INVALID');
  }
  if (url.path != PROVISION_QR_PATH) {
    return new EspProvisioningQrParseResult(null, 'QR_PATH_INVALID');
  }

  const params = parseQueryParams(url.query);
  if (params == null) return new EspProvisioningQrParseResult(null, 'QR_QUERY_INVALID');

  const name = params.get('n') ?? '';
  const username = params.get('u') ?? '';
  const pop = params.get('p') ?? '';
  // 契约要求大写；扫码/贴纸偶发小写 hex，归一化后再校验与下游使用
  const normalizedName = name.toUpperCase();
  const namePattern = new RegExp('^PROV_[0-9A-F]{6}$');
  if (normalizedName == '') return new EspProvisioningQrParseResult(null, 'QR_NAME_REQUIRED');
  if (!namePattern.test(normalizedName)) return new EspProvisioningQrParseResult(null, 'QR_NAME_INVALID');
  if (username == '') return new EspProvisioningQrParseResult(null, 'QR_USERNAME_REQUIRED');
  if (pop == '') return new EspProvisioningQrParseResult(null, 'QR_POP_REQUIRED');

  return new EspProvisioningQrParseResult(
    new EspProvisioningQrPayload(
      'v1',
      normalizedName,
      'ble',
      'wifi',
      EspProvisioningSecurityEnum.SECURITY_2,
      username,
      pop,
    ),
  );
}

/** 设备 ID 日志脱敏：仅保留首尾各 2 个字符。 */
export function maskProvisioningDeviceId(deviceId: string): string {
  if (deviceId.length <= 4) return '****';
  return `${deviceId.substring(0, 2)}***${deviceId.substring(deviceId.length - 2)}`;
}
