  .im-state__text { font-size: 14px; line-height: 20px; color: #94929c; }
  .im-foot { padding: 14px 0 22px; display: flex; flex-direction: row; justify-content: center; }
  .im-foot__text { font-size: 12px; line-height: 17px; color: #c0bec8; }
  .chat-item { display: flex; flex-direction: row; align-items: center; padding: 10.5px 16px; }
  .chat-item--pinned { background-color: #f7f6fb; }
  .chat-item--active { background-color: #eceaf3; }
  .chat-item--menu-on { background-color: #eceaf3; }
</style>
