<template>
  <view class="gj-page">
    <safety-zone />

    <!-- 顶部：返回 + 入群申请 -->
    <view class="gj-header">
      <view class="gj-header__btn" hover-class="gj-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="gj-header__title-wrap">
        <text class="gj-header__title">{{ t("Mobile.Message.joinRequests") }}</text>
      </view>
      <view class="gj-header__btn gj-header__btn--ghost" />
    </view>

    <!-- ★padding 放内层容器：iOS 上 scroll-view 的水平 padding 不参与子元素宽度计算，
         卡片会伸进右侧 padding 区被裁掉右边框（Android 正常，iOS 兼容问题） -->
    <scroll-view class="gj-body" direction="vertical" :show-scrollbar="false">
      <view class="gj-list">
        <view v-if="loading" class="gj-state">
          <text class="gj-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
        </view>
        <view v-else-if="loadFailed" class="gj-state" @click="handleRetry">
          <text class="gj-state__text">{{ t("Mobile.Message.loadFailed") }}</text>
        </view>
        <view v-else>
          <view v-for="r in requests" :key="r.requestId" class="gj-card">
            <view class="gj-ava" :style="{ backgroundImage: avatarGradient(r.userName) }">
              <text class="gj-ava-letter">{{ avatarLetter(r.userName) }}</text>
            </view>
            <view class="gj-col">
              <text class="gj-title text-ellipsis">{{ r.titleText }}</text>
              <text v-if="r.remark.length > 0" class="gj-remark text-ellipsis-2">{{ t("Mobile.Message.joinRemarkLabel") }}：{{ r.remark }}</text>
              <text class="gj-time">{{ r.timeText }}</text>
            </view>
            <view class="gj-actions">
              <view class="gj-btn" hover-class="gj-btn--active" @click="handleReview(r, false)">
                <text class="gj-btn__text">{{ t("Mobile.Message.contactReject") }}</text>
              </view>
              <view class="gj-btn gj-btn--ok" hover-class="gj-btn--ok-active" @click="handleReview(r, true)">
                <text class="gj-btn__text gj-btn__text--ok">{{ t("Mobile.Message.contactAccept") }}</text>
              </view>
            </view>
          </view>
          <view v-if="requests.length == 0" class="gj-state">
            <text class="gj-state__text">{{ t("Mobile.Message.joinRequestsEmpty") }}</text>
            <text class="gj-state__hint">{{ t("Mobile.Message.joinRequestsEmptyHint") }}</text>
          </view>
          <view class="gj-tail" />
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { apiImReviewJoinRequest, apiImJoinRequests } from "@/servers/im";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 头像字母底色渐变板（与群信息页同款）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #f59a9a, #e05f5f)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  /**
   * 申请行（JoinRequestDto 投影；列表只回 pending，按 createTime 升序=先来先审）。
   * source='invite' 必须用「由 xx 邀请加入」文案（inviterName 可能为 null → 某位成员）。
   */
  class GjRequest {
    requestId: string = "";
    userName: string = "";
    inviterName: string = "";
    remark: string = "";
    source: string = "";
    titleText: string = "";
    timeText: string = "";
  }

  // ===== 页面入参 =====
  const convId = ref<string>("");

  // ===== 状态 =====
  const requests = ref<GjRequest[]>([]);
  const loading = ref<boolean>(false);
  const loadFailed = ref<boolean>(false);
  const reviewing = ref<boolean>(false);

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  /** 时间展示：MM-DD HH:mm（createTime 为服务端毫秒）。 */
  function formatTime(ms: number): string {
    if (ms <= 0) {
      return "";
    }
    const d = new Date(ms);
    const pad = (n: number): string => (n < 10 ? `0${n}` : `${n}`);
    return `${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  /** 行标题：apply=「xx 申请加入群聊」/ invite=「xx 由 xx 邀请加入」（★两套文案，勿混用）。 */
  function buildTitle(r: GjRequest): string {
    const name = r.userName.length > 0 ? r.userName : `用户`;
    const params = new Map<string, string | number>();
    params.set("name", name);
    if (r.source == "invite") {
      const inviter = r.inviterName.length > 0 ? r.inviterName : t("Mobile.Message.joinInviterFallback");
      params.set("inviter", inviter);
      return translateFn("Mobile.Message.joinSourceInvite", toI18nParams(params), `${name} ${inviter}`);
    }
    return translateFn("Mobile.Message.joinSourceApply", toI18nParams(params), name);
  }

  /**
   * 待审列表（★管理员专属端点：data 是顶层数组信封 JoinRequestDto[]，
   * 非 PageResult；权限不足/列表为空都正常渲染空态）。
   */
  async function loadRequests(): Promise<void> {
    if (convId.value.length == 0 || loading.value) {
      return;
    }
    loading.value = true;
    loadFailed.value = false;
    try {
      const res = await apiImJoinRequests(convId.value);
      if (apiResCode(res) != SUCCESS_CODE) {
        loading.value = false;
        loadFailed.value = true;
        return;
      }
      const dataRaw = apiResData<any>(res);
      const arr = dataRaw != null ? (dataRaw as UTSJSONObject[]) : null;
      const out: GjRequest[] = [];
      if (arr != null) {
        for (let i = 0; i < arr.length; i++) {
          const r = new GjRequest();
          r.requestId = readString(arr[i], "requestId");
          r.userName = readString(arr[i], "userName");
          r.inviterName = readString(arr[i], "inviterName");
          r.remark = readString(arr[i], "remark");
          r.source = readString(arr[i], "source");
          r.titleText = buildTitle(r);
          const createTimeRaw = arr[i]["createTime"];
          let createTime = 0;
          if (createTimeRaw != null) {
            const parsed = parseFloat(`${createTimeRaw}`);
            if (!isNaN(parsed)) {
              createTime = parsed;
            }
          }
          r.timeText = formatTime(createTime);
          if (r.requestId.length > 0) {
            out.push(r);
          }
        }
      }
      requests.value = out;
      loading.value = false;
    } catch (_error) {
      loading.value = false;
      loadFailed.value = true;
    }
  }

  function handleRetry(): void {
    if (loadFailed.value) {
      loadRequests();
    }
  }

  /**
   * 审批（approve=true 真的加人入群；拒绝时 reviewRemark 会发给申请人，
   * 移动端一期不填附言传空串）。成功后行移除；失败行保留（群满时服务端保持 pending）。
   */
  function handleReview(r: GjRequest, approve: boolean): void {
    if (reviewing.value) {
      return;
    }
    reviewing.value = true;
    apiImReviewJoinRequest(convId.value, r.requestId, approve, "")
      .then((res) => {
        if (apiResCode(res) == SUCCESS_CODE) {
          uni.showToast({
            title: approve ? t("Mobile.Message.joinApproved") : t("Mobile.Message.joinRejectedDone"),
            icon: "none",
          });
          const rows = requests.value;
          for (let i = 0; i < rows.length; i++) {
            if (rows[i].requestId == r.requestId) {
              rows.splice(i, 1);
              break;
            }
          }
        } else {
          uni.showToast({ title: apiResMessage(res), icon: "none" });
        }
        reviewing.value = false;
      })
      .catch((_e: any | null) => {
        uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
        reviewing.value = false;
      });
  }

  function handleBack(): void {
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      uni.switchTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    loadRequests();
  });
</script>

<style lang="scss" scoped>
  /* ===== 页面骨架 ===== */
  .gj-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #f6f5fb;
    /* #ifdef H5 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* #endif */
  }

  .gj-header {
    flex-shrink: 0;
    height: 108rpx;
    padding: 0 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(250, 249, 253, 0.92);
    border-bottom: 2rpx solid rgba(81, 71, 255, 0.1);
  }

  .gj-header__btn {
    width: 72rpx;
    height: 72rpx;
    border-radius: 24rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gj-header__btn--active {
    background-color: rgba(81, 71, 255, 0.06);
  }

  .gj-header__btn--ghost {
    background-color: rgba(0, 0, 0, 0);
  }

  .gj-header__title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .gj-header__title {
    font-size: 33rpx;
    line-height: 46rpx;
    font-weight: 600;
    color: #17171a;
  }

  .gj-body {
    flex: 1;
    min-height: 0;
  }

  /* 内层容器承担左右留白（勿挪回 .gj-body：iOS 上 scroll-view 的水平 padding
     不参与子元素宽度计算，卡片右边框会被裁） */
  .gj-list {
    padding: 16rpx 32rpx;
  }

  .gj-state {
    padding: 200rpx 48rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .gj-state__text {
    font-size: 28rpx;
    line-height: 40rpx;
    color: #9a98a5;
  }

  /* 空态说明行：解释为何可能一直没有申请单（未开审批时凭群号直接入群） */
  .gj-state__hint {
    margin-top: 16rpx;
    font-size: 24rpx;
    line-height: 36rpx;
    color: #b0aebc;
    text-align: center;
  }

  /* ===== 申请卡片 ===== */
  .gj-card {
    margin-bottom: 16rpx;
    padding: 24rpx;
    background-color: #ffffff;
    border: 2rpx solid #ecebf1;
    border-radius: 20rpx;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }

  .gj-ava {
    width: 84rpx;
    height: 84rpx;
    border-radius: 42rpx;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .gj-ava-letter {
    font-size: 34rpx;
    line-height: 44rpx;
    font-weight: 600;
    color: #ffffff;
  }

  .gj-col {
    flex: 1;
    min-width: 0;
    margin-left: 20rpx;
    display: flex;
    flex-direction: column;
  }

  .gj-title {
    font-size: 28rpx;
    line-height: 40rpx;
    font-weight: 600;
    color: #22212a;
  }

  .gj-remark {
    margin-top: 8rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: #6b6976;
  }

  .gj-time {
    margin-top: 8rpx;
    font-size: 22rpx;
    line-height: 30rpx;
    color: #b0aebc;
  }

  /* 操作按钮：拒绝（灰描边）+ 同意（蓝描边），叠在卡片右下 */
  .gj-actions {
    margin-top: 12rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
  }

  .gj-btn {
    min-width: 112rpx;
    height: 60rpx;
    padding: 0 24rpx;
    border-radius: 30rpx;
    border: 2rpx solid #d7d4e8;
    background-color: rgba(0, 0, 0, 0);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .gj-btn--active {
    background-color: #f3f1fb;
  }

  .gj-btn--ok {
    margin-left: 16rpx;
    border: 2rpx solid #4a7fd9;
    background-color: rgba(0, 0, 0, 0);
  }

  .gj-btn--ok-active {
    background-color: rgba(74, 127, 217, 0.1);
  }

  .gj-btn__text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #6b6976;
  }

  .gj-btn__text--ok {
    color: #4a7fd9;
    font-weight: 600;
  }

  .gj-tail {
    height: 40rpx;
  }
</style>

<!-- uvue (uni-app x Android/iOS) 不支持 page 选择器，仅 H5 / 小程序需要 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
    background-color: #f6f5fb;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    background-color: #f6f5fb;
  }
  /* #endif */
</style>
