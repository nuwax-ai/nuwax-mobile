<template>
  <!-- APP 平台（iOS/Android）：渲染 PNG 图片（原生 <image> 不支持 SVG） -->
  <!-- #ifdef APP -->
  <image
    :src="svgSrc"
    mode="aspectFit"
    :style="imageStyle"
    class="svg-icon"
    @click="handleClick"
  />
  <!-- #endif -->

  <!-- 非 APP 平台（H5 / MP-WEIXIN）：渲染字体图标 -->
  <!-- #ifndef APP -->
  <text
    class="iconfont"
    :class="textClasses"
    :style="iconStyle"
    @click="handleClick"
  ><slot /></text>
  <!-- #endif -->
</template>

<script lang="uts" setup>
  import { computed } from "vue";

  /**
   * 通用图标组件
   * - APP 平台：使用 <image> 加载 PNG 图标（原生 <image> 不支持 SVG）
   * - H5 / MP-WEIXIN 平台：使用 iconfont 字体图标
   */
  const props = withDefaults(
    defineProps<{
      /** 图标名称，如 "icon-Search"、"icon-Star" */
      name: string;
      /**
       * 图标大小（单位 rpx）。
       * Android：props 运行时可能是 String，禁止声明为 number（会 ClassCastException）
       */
      size?: any | null;
      /** 额外的 CSS 类名（非 APP 平台附加到 text 元素） */
      customClass?: string;
    }>(),
    {
      size: 32 as any,
      customClass: "",
    },
  );

  const emit = defineEmits<{
    (e: "click", event: any): void;
  }>();

  /** PNG 文件路径（APP 平台使用，/static 为 APP 资源根目录） */
  const svgSrc = `/static/images/${props.name}.png`;

  /** 将 size 安全转为 number（兼容 string / number） */
  function resolveSize(raw: any | null): number {
    if (raw == null) {
      return 32;
    }
    if (typeof raw == "number") {
      const n = raw as number;
      return n != n ? 32 : n;
    }
    const s = `${raw}`;
    if (s.length == 0) {
      return 32;
    }
    const parsed = parseFloat(s);
    return parsed != parsed ? 32 : parsed;
  }

  const sizeNum = computed((): number => {
    return resolveSize(props.size);
  });

  /** APP 图片宽高样式 */
  const imageStyle = computed((): string => {
    const s = sizeNum.value;
    return "width: " + s.toString() + "rpx; height: " + s.toString() + "rpx;";
  });

  /** 非 APP 平台的 text 元素类名 */
  const textClasses = computed((): string => {
    let cls = props.name;
    if (props.customClass.length > 0) {
      cls = cls + " " + props.customClass;
    }
    return cls;
  });

  /** 字体图标大小 */
  const iconStyle = computed((): string => {
    return "font-size: " + sizeNum.value.toString() + "rpx;";
  });

  /** 处理点击事件 */
  const handleClick = (event: any) => {
    emit("click", event);
  };
</script>

<style scoped>
  /* #ifdef APP */
  .svg-icon {
    /* uvue 仅支持 display: flex | none */
    display: flex;
  }
  /* #endif */
</style>
