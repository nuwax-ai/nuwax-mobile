<template>
  <view class="openui-card" @tap="handleClick">
    <view class="openui-card__icon">
      <svg-icon name="icon-a-Filetext" size="32" />
    </view>
    <view class="openui-card__content">
      <text class="openui-card__title">{{ displayTitle }}</text>
      <text class="openui-card__hint">点击查看界面</text>
    </view>
    <view class="openui-card__arrow">
      <svg-icon name="icon-a-Chevronright" size="24" />
    </view>
  </view>
</template>

<script setup lang="uts">
  import { openOpenUiArtifact } from "@/utils/system.uts";

  const props = withDefaults(
    defineProps<{
      /** OpenUI artifactId（UUID）。 */
      artifactId: string;
      /** 卡片标题（artifact.title）。 */
      title?: string;
      /** 当前会话 ID，可带 chat- 前缀。 */
      conversationId?: string;
    }>(),
    {
      title: "",
      conversationId: "",
    },
  );

  const displayTitle = computed((): string => {
    return props.title.length > 0 ? props.title : "OpenUI 界面";
  });

  /** 打开全屏 webview 预览（移动端统一点击 → 全屏，含小程序）。 */
  function handleClick(): void {
    if (props.artifactId.length == 0 || props.conversationId.length == 0) {
      uni.showToast({ title: "无法打开 OpenUI", icon: "none" });
      return;
    }
    openOpenUiArtifact(props.conversationId, props.artifactId, props.title);
  }
</script>

<style lang="scss" scoped>
  .openui-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 72rpx; /* sidecar：紧凑摘要行 */
    margin: 8rpx 0;
    padding: 10rpx 14rpx;
    border-radius: 10rpx;
    background-color: rgba(12, 20, 102, 0.045);
    box-sizing: border-box;

    &__icon,
    &__arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    &__icon {
      width: 40rpx;
      height: 40rpx;
      margin-right: 12rpx;
    }

    &__content {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-width: 0;
    }

    &__title {
      color: #333333;
      font-size: 28rpx;
      font-weight: 600;
      line-height: 40rpx;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &__hint {
      margin-top: 4rpx;
      color: #8b8e96;
      font-size: 23rpx;
      line-height: 32rpx;
    }

    &__arrow {
      width: 32rpx;
      height: 32rpx;
      margin-left: 12rpx;
    }
  }
</style>
