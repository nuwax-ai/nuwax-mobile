<template>
  <button
    class="voice-recorder-container"
    :class="{
      'is-recording': isRecorderActive,
      'is-uploading': currentState == 'uploading'
    }"
    :style="{ backgroundColor: isRecorderActive ? 'rgb(108, 101, 244)' : '#ffffff' }"
    hover-class="none"
    @touchstart="handleTouchStart"
    @touchend="handleTouchEnd"
    @touchcancel="cancelRecording"
    @touchmove="handleTouchMove"
    @click.stop.prevent="handleRecorderClickFallback"
    @contextmenu.stop.prevent
    @mousedown.prevent
  >
    <text
      class="voice-recorder-prompt-text"
      @touchstart.stop="handleTouchStart"
      @touchend.stop="handleTouchEnd"
      @touchcancel.stop="cancelRecording"
      @touchmove.stop="handleTouchMove"
    >{{ recorderPromptText }}</text>
  </button>
</template>

<script lang="uts" setup>
  // #ifdef H5
  import jzRecorder from '@/uni_modules/jz-h5-recorder-manager'
  // #endif

  import { ref, computed, onMounted, onUnmounted } from 'vue';
  import { onShow, onHide } from "@dcloudio/uni-app";
  import {
    createAudioUploader,
    AudioUploader,
    AudioFile as UploaderAudioFile,
    TranscriptResult as UploaderTranscriptResult,
    type UploadProgress
  } from '@/servers/audioUploader'
  import { MicrophonePermissionHelper, type PermissionState } from '@/utils/permissionHelper'
  import { useI18n, emptyI18nParams } from "@/utils/i18n";
  // #ifdef APP
  import {
    asrWebSocketClient,
    ASR_SAMPLE_RATE,
  } from "@/subpackages/utils/voice/asrWebSocketClient";
  import { streamLocalAudioFileToAsr } from "@/subpackages/utils/voice/pcmStreamRecorder";
  // #endif

  const { t: tFn } = useI18n();
  function t(key: string): string {
    return tFn(key, emptyI18nParams(), "");
  }

  // 组件Props类型定义
  interface VoiceRecorderProps {
    // 录音配置
    duration?: number        // 最大录音时长 (ms)
    // 会话是否正在进行中（有消息正在处理）
    isConversationActive?: boolean
  }

  // 录音状态类型
  type RecordState = 'default' | 'recording' | 'uploading' | 'success' | 'error'

  const props = defineProps<VoiceRecorderProps>();

  // uvue 下 optional props + withDefaults 会导致 override 类型冲突，
  // 改为内部默认值 helper
  function getDuration(): number {
    return props.duration != null ? props.duration! : 600000;
  }

  /**
   * 各端录音参数（须满足官方采样率-码率表，否则 iOS 报 1107603）
   * @see https://doc.dcloud.net.cn/uni-app-x/api/get-recorder-manager.html
   */
  function buildNativeRecorderStartOptions(): RecorderManagerStartOptions {
    const duration = Math.min(getDuration(), 600000);
    // #ifdef APP
    // App：16kHz mono PCM，走 WebSocket ASR（非 HTTP 上传）
    const appAsrOptions = {
      duration: duration,
      sampleRate: ASR_SAMPLE_RATE,
      numberOfChannels: 1,
      format: "pcm",
    } as RecorderManagerStartOptions;
    return appAsrOptions;
    // #endif
    // #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ
    const mpOptions = {
      duration: duration,
      sampleRate: 44100,
      numberOfChannels: 1,
      encodeBitRate: 128000,
      format: "mp3",
    } as RecorderManagerStartOptions;
    return mpOptions;
    // #endif
    const fallbackOptions = {
      duration: duration,
      sampleRate: 44100,
      numberOfChannels: 1,
      encodeBitRate: 128000,
      format: "mp3",
    } as RecorderManagerStartOptions;
    return fallbackOptions;
  }

  // 构建H5录音参数
  function buildH5RecorderStartOptions(): UTSJSONObject {
    const duration = Math.min(getDuration(), 600000);
    const options = new UTSJSONObject();
    options["duration"] = duration;
    options["sampleRate"] = 44100;
    options["numberOfChannels"] = 1;
    options["encodeBitRate"] = 128000;
    options["format"] = "default";
    return options;
  }

  const emit = defineEmits<{
    (e: 'onRecordPress'): void
    (e: 'onRecordStart'): void
    (e: 'onRecordStop', result: string): void
    (e: 'onError', error: any): void
    (e: 'onUploadProgress', progress: number): void
    (e: 'onRecordCancel'): void
    (e: 'onRecordEnd'): void
  }>()

  // 响应式状态
  const currentState = ref<RecordState>('default')
  const isCancelled = ref<boolean>(false)
  // 是否点击
  const isTapped = ref<boolean>(false)
  const isRecorderActive = computed((): boolean => {
    return (
      currentState.value == 'recording' ||
      (currentState.value == 'default' && isTapped.value)
    );
  })
  const recorderPromptText = computed((): string => {
    if (currentState.value == 'uploading') {
      return t("Mobile.Voice.recognizing")
    }
    if (isRecorderActive.value) {
      return t("Mobile.Voice.releaseToEnd")
    }
    return t("Mobile.Voice.holdToTalk")
  })
  // 手指在 RecorderManager.onStart 前松开时，忽略随后返回的空录音文件。
  let ignoreNextStopResult: boolean = false
  // iOS 原生 button 在状态切换后可能补发一组紧邻的触摸事件。
  let lastTouchEndAt: number = 0
  // #ifdef APP
  /** App：ASR 会话已 begin，等待 asr_ready / 结果 */
  let asrSessionActive: boolean = false
  /** App：已发 stop，等待 asr_result */
  let asrWaitingResult: boolean = false
  // #endif
  // 音频上传服务
  let audioUploadService: AudioUploader | null = null
  let recorderInitialized: boolean = false
  // #ifdef H5 || WEB
  let h5RecorderManager: any | null = null
  // #endif
  // #ifndef H5
  let nativeRecorderManager: RecorderManager | null = null
  // #endif

  // #ifdef H5 || WEB
  function setH5TouchEndCancelFlag(value: boolean) {
    const rm = h5RecorderManager as UTSJSONObject | null
    if (rm != null) {
      rm["touchEndCancelFlag"] = value
    }
  }
  // #endif

  function callRecorderStop() {
    // #ifdef H5 || WEB
    if (h5RecorderManager != null) {
      (h5RecorderManager as any).stop()
    }
    // #endif
    // #ifndef H5
    if (nativeRecorderManager != null) {
      nativeRecorderManager!.stop()
    }
    // #endif
  }

  function callRecorderStart() {
    // #ifdef H5 || WEB
    if (h5RecorderManager != null) {
      (h5RecorderManager as any).start(buildH5RecorderStartOptions())
    }
    // #endif
    // #ifndef H5
    if (nativeRecorderManager != null) {
      const options = buildNativeRecorderStartOptions();
      console.log("[VoiceRecord] invoking native RecorderManager.start,开启录音参数：", options);
      nativeRecorderManager!.start(options)
    } else {
      console.error("[VoiceRecord] native RecorderManager is null");
    }
    // #endif
  }

  /** 是否已展示「连接中」loading；避免重复 hideLoading 触发 H5 uncaught Promise */
  let connectingLoadingVisible = false

  function showConnectingLoading(): void {
    connectingLoadingVisible = true
    uni.showLoading({
      title: t("Mobile.Voice.connecting"),
    })
  }

  // 重置状态
  function hideConnectingLoading(): void {
    if (connectingLoadingVisible == false) {
      return
    }
    connectingLoadingVisible = false
    // #ifdef H5 || WEB
    // H5：无 loading / 已取消时 hideLoading 会 reject，须吞掉，勿只用 try/catch
    Promise.resolve(uni.hideLoading() as any).then(
      (): void => {},
      (): void => {},
    )
    // #endif
    // #ifndef H5 || WEB
    try {
      uni.hideLoading()
    } catch (_e) {
      // ignore
    }
    // #endif
  }

  function resetState() {
    hideConnectingLoading()
    currentState.value = 'default'
    isCancelled.value = false
    isTapped.value = false
    // #ifdef APP
    asrWaitingResult = false
    // #endif
  }

  /** RecorderManager.onError 回调结构（禁止 as UTSJSONObject） */
  type RecorderManagerFail = {
    errCode?: number | null
    errMsg?: string | null
    errSubject?: string | null
  }

  function readErrorMessage(error: any | null, fallback: string): string {
    if (error == null) {
      return fallback;
    }
    try {
      const fail = error as RecorderManagerFail;
      if (fail.errMsg != null && `${fail.errMsg}`.length > 0) {
        return `${fail.errMsg}`;
      }
    } catch (_eFail) {
      // ignore
    }
    try {
      const err = error as Error;
      if (err.message != null && `${err.message}`.length > 0) {
        const message = `${err.message}`;
        if (message.indexOf("ClassCastException") >= 0) {
          return fallback;
        }
        return message;
      }
    } catch (_eErr) {
      // ignore
    }
    try {
      const jsonStr = JSON.stringify(error);
      if (jsonStr != null && jsonStr.length > 2 && jsonStr != "{}" && jsonStr != "null") {
        const parsed = JSON.parse(jsonStr) as UTSJSONObject;
        const msg = parsed["message"];
        if (msg != null && `${msg}`.length > 0) {
          return `${msg}`;
        }
        const errMsg = parsed["errMsg"];
        if (errMsg != null && `${errMsg}`.length > 0) {
          return `${errMsg}`;
        }
      }
    } catch (_eJson) {
      // ignore
    }
    const text = `${error}`;
    if (text.length > 0 && text != "null" && text.indexOf("ClassCastException") < 0) {
      return text;
    }
    return fallback;
  }

  function normalizeRecorderFail(err: any | null): Error {
    const fallback = t("Mobile.Voice.recordFailed");
    return new Error(readErrorMessage(err, fallback));
  }

  // 录音错误
  function handleRecordError(err: any) {
    // APP 原生回调也可能直接传 java.lang.Exception，不能强转 RecorderManagerFail。
    let rawError = "";
    try {
      rawError = JSON.stringify(err) ?? "";
    } catch (_eJson) {
      rawError = `${err}`;
    }
    console.error("[VoiceRecord] recorder error message=" + readErrorMessage(err, "") + " raw=" + rawError);
    // #ifdef APP
    asrWebSocketClient.abort()
    asrSessionActive = false
    asrWaitingResult = false
    // #endif
    resetState()
    // #ifdef H5 || WEB
    setH5TouchEndCancelFlag(false)
    // #endif
    emit('onError', normalizeRecorderFail(err))
  }

  // #ifdef APP
  function handleAsrResult(text: string, ok: boolean, errorMessage: string): void {
    asrSessionActive = false
    asrWaitingResult = false
    if (ok == true && text.length > 0) {
      currentState.value = "success"
      emit("onRecordStop", text)
      resetState()
    } else {
      const errMsg =
        errorMessage.length > 0
          ? errorMessage
          : t("Mobile.Voice.noSpeechDetected")
      handleRecordError(new Error(errMsg))
    }
  }

  function handleAsrError(message: string): void {
    asrSessionActive = false
    asrWaitingResult = false
    try {
      callRecorderStop()
    } catch (_eStop) {
      // ignore
    }
    handleRecordError(new Error(message.length > 0 ? message : t("Mobile.Voice.recordFailed")))
  }

  /** App：ASR ready 后开始本地 PCM 录音 */
  function startAppRecorderAfterAsrReady(): void {
    if (ignoreNextStopResult) {
      console.log("[VoiceRecord] asr_ready after release, abort")
      asrWebSocketClient.abort()
      asrSessionActive = false
      resetState()
      emit("onRecordCancel")
      return
    }
    try {
      callRecorderStart()
    } catch (error: any) {
      asrWebSocketClient.abort()
      asrSessionActive = false
      handleRecordError(error)
    }
  }

  /** App：按下后先连 ASR，再录音 */
  function beginAppAsrSession(): void {
    asrSessionActive = true
    asrWaitingResult = false
    asrWebSocketClient.begin(
      () => {
        startAppRecorderAfterAsrReady()
      },
      (text: string, ok: boolean, errorMessage: string) => {
        handleAsrResult(text, ok, errorMessage)
      },
      (message: string) => {
        handleAsrError(message)
      },
    )
  }

  /** App：录音文件就绪后切帧推送并 finish */
  function pushRecordedFileThenFinish(tempFilePath: string): void {
    currentState.value = "uploading"
    streamLocalAudioFileToAsr(
      tempFilePath,
      (frame: ArrayBuffer) => {
        asrWebSocketClient.sendPcm(frame)
      },
      (ok: boolean) => {
        if (ok == true) {
          asrWaitingResult = true
          asrWebSocketClient.finish()
        } else {
          asrWebSocketClient.abort()
          asrSessionActive = false
          handleRecordError(new Error(t("Mobile.AudioUploader.fileEmpty")))
        }
      },
    )
  }
  // #endif

  // 使用audioUploader转换音频
  async function uploadAndConvertWithService(
    audioFile: UploaderAudioFile,
  ): Promise<UploaderTranscriptResult> {
    const svc = audioUploadService;
    if (svc == null) {
      throw new Error(t("Mobile.Voice.serviceNotReady"));
    }
    try {
      return await svc.uploadAudio(audioFile, null);
    } catch (error: any) {
      const errText = readErrorMessage(error, t("Mobile.Voice.recordFailed"));
      return new UploaderTranscriptResult(false, errText, 0, 0, errText);
    }
  }

  // 取消录音
  function cancelRecording() {
    ignoreNextStopResult = true
    // #ifdef APP
    asrSessionActive = false
    asrWaitingResult = false
    asrWebSocketClient.abort()
    // #endif
    if (currentState.value != 'default') {
      callRecorderStop()
    }
    resetState()
    // #ifdef H5 || WEB
    setH5TouchEndCancelFlag(false)
    // #endif
    emit('onRecordCancel')
  }

  // 停止录音
  function stopRecording() {
    const neverStarted = currentState.value == 'default'
    if (neverStarted) {
      ignoreNextStopResult = true
      console.log("[VoiceRecord] released before onStart, wait for onStart then stop")
      // #ifdef APP
      asrWebSocketClient.abort()
      asrSessionActive = false
      // #endif
      resetState()
      emit('onRecordCancel')
      return
    }
    try {
      // #ifdef APP
      // 先进入识别中，等 onStop 推流 + asr_result；勿立刻 reset
      currentState.value = "uploading"
      isTapped.value = false
      callRecorderStop()
      emit("onRecordEnd")
      // #endif
      // #ifndef APP
      callRecorderStop()
      emit('onRecordEnd')
      resetState()
      // #endif
    } catch (error: any) {
      // #ifdef H5 || WEB
      setH5TouchEndCancelFlag(false)
      // #endif
      // #ifdef APP
      asrWebSocketClient.abort()
      asrSessionActive = false
      // #endif
      currentState.value = 'error'
      emit('onError', normalizeRecorderFail(error))
      resetState()
    }
  }

  // 录音中结束
  function handleTouchEnd() {
    console.log('录音中结束handleTouchEnd')
    if (isTapped.value == false && currentState.value == 'default') {
      console.log("[VoiceRecord] ignored duplicated touchend")
      return
    }
    lastTouchEndAt = Date.now()
    // Android：onStart 可能未触发，必须在松手时关闭「正在连接」
    hideConnectingLoading()
    // #ifdef H5 || WEB
    setH5TouchEndCancelFlag(true)
    // #endif
    isTapped.value = false;
    // 如果正在上传/识别，则不停止录音
    if (currentState.value == 'uploading') {
      return
    }
    // #ifdef APP
    if (asrWaitingResult == true) {
      return
    }
    // #endif
    if (isCancelled.value) {
      cancelRecording()
    } else {
      stopRecording()
    }
  }

  /** Android 模拟器短点击偶尔不派发 touchend，使用 click 补齐状态收尾。 */
  function handleRecorderClickFallback(): void {
    if (isTapped.value == false) {
      return
    }
    console.log("[VoiceRecord] click fallback dispatches touchend")
    handleTouchEnd()
  }

  /** H5：仅在事件可取消时 preventDefault，避免 Intervention 警告 */
  function safePreventDefault(e: UniTouchEvent | null) {
    // #ifdef H5 || WEB
    if (e == null) return;
    if (e.cancelable == true) {
      e.preventDefault();
    }
    // #endif
  }

  /** 各端录音权限：uni-app x APP 不支持 uni.getSetting，Android 用 UTSAndroid */
  async function ensureRecordPermission(): Promise<boolean> {
    // #ifdef APP-ANDROID
    return await new Promise<boolean>((resolve) => {
      const activity = UTSAndroid.getUniActivity();
      if (activity == null) {
        resolve(false);
        return;
      }
      const permissionCheck = ["android.permission.RECORD_AUDIO"] as string[];
      if (UTSAndroid.checkSystemPermissionGranted(activity, permissionCheck)) {
        resolve(true);
        return;
      }
      UTSAndroid.requestSystemPermission(
        activity,
        permissionCheck,
        (allGranted: boolean, _granted: string[]) => {
          resolve(allGranted);
        },
        (_doNotAskAgain: boolean, _denied: string[]) => {
          resolve(false);
        },
      );
    });
    // #endif

    // #ifdef APP-IOS
    const authSetting = uni.getAppAuthorizeSetting();
    if (authSetting.microphoneAuthorized == "authorized") {
      return true;
    }
    if (authSetting.microphoneAuthorized == "denied") {
      return false;
    }
    // not determined：首次录音时系统弹窗
    return true;
    // #endif

    // #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ
    return await new Promise<boolean>((resolve) => {
      uni.getSetting({
        success: (res) => {
          const setting = res.authSetting as UTSJSONObject;
          if (setting["scope.record"] == true) {
            resolve(true);
            return;
          }
          uni.authorize({
            scope: "scope.record",
            success: () => resolve(true),
            fail: () => resolve(false),
          });
        },
        fail: () => resolve(false),
      });
    });
    // #endif

    // #ifdef H5 || WEB
    return await MicrophonePermissionHelper.ensure(false);
    // #endif

    return true;
  }

  function openRecordPermissionSettings(): void {
    // #ifdef APP-ANDROID
    const activity = UTSAndroid.getUniActivity();
    if (activity != null) {
      const permissionNeed = ["android.permission.RECORD_AUDIO"] as string[];
      UTSAndroid.gotoSystemPermissionActivity(activity, permissionNeed);
    }
    // #endif
    // #ifdef APP-IOS
    uni.openAppAuthorizeSetting({});
    // #endif
    // #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ
    uni.openSetting({});
    // #endif
    // #ifdef H5 || WEB
    MicrophonePermissionHelper.showGuide();
    // #endif
  }

  function showRecordPermissionModal(): void {
    uni.showModal({
      title: t("Mobile.Voice.permissionRequired"),
      content: t("Mobile.Voice.permissionContent"),
      confirmText: t("Mobile.Voice.goToSettings"),
      cancelText: t("Mobile.Common.cancel"),
      success: (res) => {
        if (res.confirm == true) {
          openRecordPermissionSettings();
        }
      },
    });
  }

  // 开始录音
  async function handleTouchStart(e: UniTouchEvent) {
    console.log('开始录音handleTouchStart')
    const touchStartAt = Date.now()
    if (touchStartAt - lastTouchEndAt < 100) {
      console.log("[VoiceRecord] ignored duplicated touchstart after touchend")
      return
    }
    // #ifdef H5 || WEB
    safePreventDefault(e);
    setH5TouchEndCancelFlag(false)
    // #endif

    if (props.isConversationActive == true) {
      emit("onError", new Error(t("Mobile.Voice.conversationActiveError")));
      return
    }
    if (currentState.value != 'default') {
      return
    }

    isTapped.value = true;
    ignoreNextStopResult = false;
    emit('onRecordPress')

    showConnectingLoading()

    const permitted = await ensureRecordPermission();
    if (permitted == false) {
      hideConnectingLoading();
      resetState();
      showRecordPermissionModal();
      emit("onError", new Error(t("Mobile.Voice.permissionRequired")));
      return;
    }

    try {
      // #ifdef APP
      beginAppAsrSession()
      // #endif
      // #ifndef APP
      callRecorderStart()
      // #endif
    } catch (error: any) {
      console.error("[VoiceRecord] RecorderManager.start threw message=" + readErrorMessage(error, ""));
      handleRecordError(error)
    }
  }

  // 监听录音开始
  function handleRecordStart(_res: any | null) {
    console.log('[VoiceRecord] onStart received')
    if (ignoreNextStopResult) {
      console.log("[VoiceRecord] onStart arrived after release, stopping without upload")
      callRecorderStop()
      // #ifdef APP
      asrWebSocketClient.abort()
      asrSessionActive = false
      // #endif
      resetState()
      return
    }
    hideConnectingLoading()
    // 设置状态，开始录音，并触发事件
    currentState.value = 'recording'
    emit('onRecordStart')
  }

  /**
   * 录音结束后上传并转写（async 独立函数，避免 onStop 回调里 .catch 类型不匹配）
   */
  async function runUploadAfterStop(audioFile: UploaderAudioFile): Promise<void> {
    try {
      const result = await uploadAndConvertWithService(audioFile)
      if (result.success == true) {
        currentState.value = 'success'
        emit('onRecordStop', result.text)
        resetState()
      } else {
        const rText = result.text;
        const errMsg = rText.length > 0 ? rText : t("Mobile.Voice.noSpeechDetected");
        handleRecordError(new Error(errMsg))
      }
    } catch (error: any) {
      handleRecordError(error)
    }
  }

  /** 录音 onStop 回调结构（APP 原生对象禁止 as UTSJSONObject） */
  type RecorderStopResult = {
    tempFilePath?: string | null
    duration?: number | null
    fileSize?: number | null
    format?: string | null
  }

  function readRecorderStopString(res: any | null, key: string): string {
    if (res == null) {
      return "";
    }
    try {
      const stopRes = res as RecorderStopResult;
      if (key == "tempFilePath" && stopRes.tempFilePath != null) {
        return `${stopRes.tempFilePath}`;
      }
      if (key == "format" && stopRes.format != null) {
        return `${stopRes.format}`;
      }
    } catch (_eNative) {
      // ignore
    }
    try {
      const jsonStr = JSON.stringify(res);
      if (jsonStr != null && jsonStr.length > 2 && jsonStr != "{}" && jsonStr != "null") {
        const parsed = JSON.parse(jsonStr) as UTSJSONObject;
        const value = parsed[key];
        return value != null ? `${value}` : "";
      }
    } catch (_eJson) {
      // ignore
    }
    return "";
  }

  function readRecorderStopNumber(res: any | null, key: string, fallback: number = 0): number {
    if (res == null) {
      return fallback;
    }
    try {
      const stopRes = res as RecorderStopResult;
      if (key == "duration" && stopRes.duration != null) {
        const durationVal = stopRes.duration as number;
        return isNaN(durationVal) ? fallback : durationVal;
      }
      if (key == "fileSize" && stopRes.fileSize != null) {
        const sizeVal = stopRes.fileSize as number;
        return isNaN(sizeVal) ? fallback : sizeVal;
      }
    } catch (_eNative) {
      // ignore
    }
    try {
      const jsonStr = JSON.stringify(res);
      if (jsonStr != null && jsonStr.length > 2 && jsonStr != "{}" && jsonStr != "null") {
        const parsed = JSON.parse(jsonStr) as UTSJSONObject;
        const value = parsed[key];
        if (value == null) {
          return fallback;
        }
        const num = parseFloat(`${value}`);
        return isNaN(num) ? fallback : num;
      }
    } catch (_eJson) {
      // ignore
    }
    return fallback;
  }

  /**
   * 录音停止事件处理
   */
  function handleRecordStop(res: any | null): void {
    hideConnectingLoading()
    if (ignoreNextStopResult) {
      ignoreNextStopResult = false
      console.log("[VoiceRecord] ignored empty/cancelled stop result")
      // #ifdef APP
      asrWebSocketClient.abort()
      asrSessionActive = false
      // #endif
      resetState()
      return
    }
    if (res == null) return;
    let rawStopResult = ""
    try {
      rawStopResult = JSON.stringify(res) ?? ""
    } catch (_eJson) {
      rawStopResult = `${res}`
    }
    console.log("[VoiceRecord] onStop result=" + rawStopResult)

    const tempFilePath = readRecorderStopString(res, "tempFilePath");
    if (tempFilePath.length == 0) {
      handleRecordError(new Error(t("Mobile.Voice.recordFailed")));
      return;
    }

    // #ifdef APP
    // App：PCM 文件切帧经 WebSocket 推给 ASR，识别完成后走与 H5 相同的 onRecordStop
    if (asrSessionActive != true || asrWebSocketClient.isReady() != true) {
      handleRecordError(new Error(t("Mobile.Voice.recordFailed")));
      return;
    }
    pushRecordedFileThenFinish(tempFilePath)
    // #endif

    // #ifndef APP
    // H5 / 小程序：上传文件转写
    let duration = readRecorderStopNumber(res, "duration", 0);
    // #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ
    duration = duration / 1000;
    // #endif
    const fileSize = readRecorderStopNumber(res, "fileSize", 0);
    let formatStr = readRecorderStopString(res, "format");
    if (formatStr.length == 0) {
      const dotIndex = tempFilePath.lastIndexOf(".");
      formatStr = dotIndex >= 0 ? tempFilePath.slice(dotIndex + 1).toLowerCase() : "mp3";
    }
    const audioFile = new UploaderAudioFile(
      tempFilePath,
      duration,
      fileSize,
      formatStr,
    );
    // #ifdef H5 || WEB
    setH5TouchEndCancelFlag(false)
    // #endif
    currentState.value = 'uploading'
    runUploadAfterStop(audioFile)
    // #endif
  }

  function bindRecorderEvents() {
    // #ifdef H5 || WEB
    if (h5RecorderManager != null) {
      (h5RecorderManager as any).onStart(handleRecordStart)
      ;(h5RecorderManager as any).onStop(handleRecordStop)
      ;(h5RecorderManager as any).onError(handleRecordError)
    }
    // #endif
    // #ifndef H5
    if (nativeRecorderManager != null) {
      nativeRecorderManager!.onStart(handleRecordStart)
      nativeRecorderManager!.onStop(handleRecordStop)
      nativeRecorderManager!.onError(handleRecordError)
    }
    // #endif
  }

  function unbindRecorderEvents() {
    // #ifdef H5 || WEB
    if (h5RecorderManager != null) {
      const rm = h5RecorderManager as any
      // jz-h5-recorder 早期版本可能缺少部分 off*，逐个防护
      if (typeof rm.offStart == "function") {
        rm.offStart(handleRecordStart)
      }
      if (typeof rm.offStop == "function") {
        rm.offStop(handleRecordStop)
      }
      if (typeof rm.offError == "function") {
        rm.offError(handleRecordError)
      }
    }
    // #endif
    // #ifndef H5
    if (nativeRecorderManager != null) {
      nativeRecorderManager!.offStart()
      nativeRecorderManager!.offStop()
      nativeRecorderManager!.offError()
    }
    // #endif
  }

  function initRecorderManager() {
    if (recorderInitialized) {
      return
    }
    recorderInitialized = true
    // #ifdef H5 || WEB
    h5RecorderManager = jzRecorder.getRecorderManager()
    // #endif

    // #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || APP
    nativeRecorderManager = uni.getRecorderManager()
    // #endif

    bindRecorderEvents()
    audioUploadService = createAudioUploader()
  }

  // 销毁录音管理器等资源
  function destroyRecorderManager() {
    if (!recorderInitialized) {
      return
    }
    recorderInitialized = false
    // #ifdef APP
    asrWebSocketClient.abort()
    asrSessionActive = false
    asrWaitingResult = false
    // #endif
    resetState()
    unbindRecorderEvents()
    // #ifdef H5 || WEB
    h5RecorderManager = null
    // #endif
    // #ifndef H5
    nativeRecorderManager = null
    // #endif
    audioUploadService = null
  }

  // Add touchmove handler to the button
  function handleTouchMove(e: UniTouchEvent) {
    // #ifdef H5
    // 录音中阻止页面滚动；touchstart 不可取消时不强调 preventDefault
    if (isTapped.value == true || currentState.value == 'recording') {
      safePreventDefault(e);
    }
    // #endif
  }

  // 初始化录音管理器
  onShow(function () {
    // #ifdef MP-WEIXIN || APP
    initRecorderManager()
    // #endif
  })

  // 初始化录音管理器
  onMounted(function () {
    initRecorderManager()
  })

  // 组件卸载时清理资源
  onHide(function () {
    // #ifdef MP-WEIXIN || APP
    destroyRecorderManager()
    // #endif
  })

  // 组件卸载时清理资源
  onUnmounted(function () {
    destroyRecorderManager()
  })
</script>

<style lang="scss" scoped>
  .voice-recorder-container {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 90rpx;
    // height: 112rpx;
    border-radius: 24rpx;
    transition: all 0.15s ease;
    /* #ifndef APP */
    -webkit-touch-callout: none;
    /* #endif */
    color: #000;
    font-size: 32rpx;
    font-weight: 400;
    background-color: #ffffff;
    margin: 0;
    padding: 0; // 删除uni-button默认padding
    line-height: normal;
    /* #ifdef APP-IOS */
    line-height: 90rpx;
    /* #endif */
    /* #ifndef APP */
    user-select: none;
    -webkit-user-select: none;
    touch-action: none; /* 防止系统手势干预 */
    /* #endif */
    border: none;

    &::after {
      border: none !important;
    }

    .voice-recorder-prompt-text {
      width: 100%;
      height: 90rpx;
      line-height: 90rpx;
      align-self: center;
      text-align: center;
      font-size: 32rpx;
      color: #000000;
    }

    &.is-recording {
      background-color: rgb(108, 101, 244);
      z-index: 100;

      .voice-recorder-prompt-text {
        color: #ffffff;
      }
    }

    &.is-uploading {
      .voice-recorder-prompt-text {
        color: #666666;
      }
    }
  }
</style>
