/**
 * ESP-IDF 6.0 network_provisioning 平台客户端契约。
 *
 * 业务层只依赖本接口，不直接依赖固定 GATT Characteristic。
 * Android 实现桥接乐鑫官方 Provisioning Library；其他平台保持同语义实现。
 */
import type {
  EspProvisioningCapabilities,
  EspProvisioningConfig,
  EspProvisioningDevice,
  EspProvisioningDeviceInfo,
  EspProvisioningProgress,
  EspProvisioningQrPayload,
  EspWifiNetwork,
} from '@/types/interfaces/espProvisioning';

export type EspProvisioningDeviceFoundCallback = (device: EspProvisioningDevice) => void;
export type EspProvisioningProgressCallback = (progress: EspProvisioningProgress) => void;
export type EspProvisioningLogCallback = (level: string, event: string, detail: string) => void;

export interface EspProvisioningClient {
  /** 初始化客户端及平台权限环境。 */
  initialize(config: EspProvisioningConfig): Promise<void>;

  /** 扫描广播中包含目标 Provisioning Service UUID 的设备。 */
  startScan(): Promise<void>;
  stopScan(): Promise<void>;
  onDeviceFound(cb: EspProvisioningDeviceFoundCallback): void;

  /** 建立 BLE 连接、发现 endpoint，并按配置设置 Security/PoP。 */
  connect(device: EspProvisioningDevice): Promise<void>;

  /**
   * 按二维码里的蓝牙信息直连设备（跳过完整扫描列表）。
   * 实现上通常是用 QR 的 name 作 prefix 快速扫描，匹配到即停并连接。
   */
  connectFromQr(qr: EspProvisioningQrPayload): Promise<void>;

  /** 官方 `proto-ver` 分层响应，必须校验 Security 2 与 wifi_prov。 */
  getCapabilities(): Promise<EspProvisioningCapabilities>;

  /** 建立 Security 2 会话后读取 Nuwax `device-info`。 */
  getDeviceInfo(): Promise<EspProvisioningDeviceInfo>;

  /** 让 ESP32-S3 扫描 AP；UI 也可继续允许手动输入。 */
  scanNetworks(): Promise<EspWifiNetwork[]>;

  /** 建立安全会话，执行 set_config → apply_config → get_status。 */
  provision(ssid: string, password: string): Promise<void>;

  /**
   * 向固件自定义 protocomm endpoint 写数据（走已加密的 Security 2 会话）。
   * 用于绑定后下发 vox-config（deviceSecret + gatewayUrl）；payload 为 JSON 字符串，
   * 返回值 resolve 设备端响应 JSON 字符串。须在配网成功后 BLE 窗口（约 15s）内调用。
   */
  sendCustomData(endpoint: string, payloadJson: string): Promise<string>;

  onProgress(cb: EspProvisioningProgressCallback): void;
  onLog(cb: EspProvisioningLogCallback): void;

  disconnect(): Promise<void>;
  dispose(): void;
}
