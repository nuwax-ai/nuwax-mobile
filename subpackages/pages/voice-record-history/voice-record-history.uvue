<template>
  <view class="vh-page">
    <safety-zone />
    <view class="vh-nav">
      <view class="vh-nav__side" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="22" unit="px" color="#1a1a1a" />
      </view>
      <text class="vh-nav__title">历史记录</text>
      <view class="vh-nav__side"></view>
    </view>
    <scroll-view
      class="vh-list"
      scroll-y="true"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      @refresherrefresh="handleRefresh"
      @scrolltolower="loadMore"
    >
      <view v-for="item in records" :key="item.id" class="vh-card" @click="openDetail(item)">
        <view class="vh-card__head">
          <text class="vh-card__title">{{ item.title }}</text>
        </view>
        <text class="vh-card__meta">时长 {{ item.duration }} · {{ item.recordedAt }}</text>
        <view v-if="item.docLabel.length > 0" class="vh-card__file">
          <svg-icon name="icon-a-Filetext" size="16" unit="px" color="#7a78e6" />
          <text class="vh-card__path">{{ item.docLabel }}</text>
        </view>
        <view class="vh-card__actions" @click.stop="keepCardActions">
          <view v-if="item.status == 'SUCCESS'" class="vh-card__btn" hover-class="vh-card__btn--active" @click="handleDownload(item)">
            <svg-icon name="icon-eye-open" size="16" unit="px" color="#666666" />
            <text class="vh-card__btn-text">文档</text>
          </view>
          <view v-if="canReprocess(item.status)" class="vh-card__btn" hover-class="vh-card__btn--active" @click="handleReprocess(item)">
            <svg-icon name="icon-restart" size="16" unit="px" color="#666666" />
            <text class="vh-card__btn-text">{{ reprocessLabel(item.status) }}</text>
          </view>
          <view class="vh-card__btn" hover-class="vh-card__btn--active" @click="handleDelete(item)">
            <text class="vh-card__btn-text vh-card__btn-text--plain">删除</text>
          </view>
        </view>
      </view>
      <view v-if="records.length > 0" class="vh-footer">
        <text class="vh-footer__text">{{ footerText }}</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
/**
 * 录音历史。列表来自 POST /api/voice/note/list。
 * 转写成功后点下载，再查详情拿到 docUrl 打开文稿。
 */
import { apiVoiceNoteDelete, apiVoiceNoteDetail, apiVoiceNoteList, apiVoiceNoteReprocess } from "@/servers/voiceNote.uts";

type VoiceRecordHistoryItem = {
  id: string;
  title: string;
  duration: string;
  recordedAt: string;
  detail: string;
  status: string;
  segmentCount: number;
  docUrl: string;
  docLabel: string;
};

const records = ref<VoiceRecordHistoryItem[]>([]);
const loading = ref<boolean>(false);
const refreshing = ref<boolean>(false);
const hasMore = ref<boolean>(true);
const lastId = ref<string>("");
const pageSize = 20;
const footerText = computed((): string => {
  if (loading.value) return "加载中";
  if (!hasMore.value) return "没有更多了";
  return "上拉加载更多";
});

function pad2(n: number): string {
  if (n < 10) return "0" + n.toString();
  return n.toString();
}

function formatDuration(ms: number): string {
  const safe = ms < 0 ? 0 : ms;
  const totalSec = Math.floor(safe / 1000);
  const sec = totalSec % 60;
  const min = Math.floor(totalSec / 60);
  return pad2(min) + ":" + pad2(sec);
}

function formatClock(ts: number): string {
  if (ts <= 0) return "";
  const d = new Date(ts);
  return (
    d.getFullYear() +
    "-" +
    pad2(d.getMonth() + 1) +
    "-" +
    pad2(d.getDate()) +
    " " +
    pad2(d.getHours()) +
    ":" +
    pad2(d.getMinutes())
  );
}

function readItemString(obj: UTSJSONObject, key: string): string {
  const raw = obj[key];
  if (raw == null) return "";
  return `${raw}`;
}

function readItemNumber(obj: UTSJSONObject, key: string): number {
  const raw = obj[key];
  if (raw == null) return 0;
  const value = parseFloat(`${raw}`);
  if (isNaN(value)) return 0;
  return value;
}

function statusLabel(status: string): string {
  if (status == "UPLOADING") return "传输中";
  if (status == "PROCESSING") return "转写中";
  if (status == "ASR_PARTIAL_FAILED") return "部分转写失败";
  if (status == "DOC_FAILED") return "文档生成失败";
  if (status == "SUCCESS") return "已完成";
  if (status == "DOC_REMOVED") return "文档已删除";
  return status;
}

function formatCreated(raw: string): string {
  if (raw.length == 0) return "";
  const value = parseFloat(raw);
  const digitsOnly = !isNaN(value) && `${Math.floor(value)}` == raw;
  if (digitsOnly && value > 1000000000000) return formatClock(value);
  if (digitsOnly && value > 1000000000) return formatClock(value * 1000);
  const text = raw.replace("T", " ");
  if (text.length > 16) return text.substring(0, 16);
  return text;
}

function mapHistoryItem(row: UTSJSONObject): VoiceRecordHistoryItem {
  const noteId = readItemString(row, "noteId");
  const titleRaw = readItemString(row, "title");
  const status = readItemString(row, "status");
  const segmentCount = readItemNumber(row, "segmentCount");
  const created = formatCreated(readItemString(row, "created"));
  const title = titleRaw.length > 0 ? titleRaw : "语音笔记";
  let docUrl = readItemString(row, "docUrl");
  if (docUrl == "null") {
    docUrl = "";
  }
  let docTitle = readItemString(row, "docTitle");
  if (docTitle == "null") {
    docTitle = "";
  }
  const item: VoiceRecordHistoryItem = {
    id: noteId,
    title: title,
    duration: formatDuration(readItemNumber(row, "totalDurationMs")),
    recordedAt: created,
    detail: "",
    status: status,
    segmentCount: segmentCount,
    docUrl: docUrl,
    docLabel: docTitle,
  };
  return item;
}

function applyStatus(item: VoiceRecordHistoryItem, status: string): void {
  item.status = status;
  item.detail = statusLabel(status) + " · " + item.segmentCount.toString() + " 段";
}

async function loadRecords(reset: boolean): Promise<void> {
  if (loading.value) {
    refreshing.value = false;
    return;
  }
  if (!reset && !hasMore.value) return;
  loading.value = true;
  const cursor = reset ? "" : lastId.value;
  try {
    const rows = await apiVoiceNoteList(cursor, pageSize);
    const next: VoiceRecordHistoryItem[] = [];
    for (let i = 0; i < rows.length; i++) {
      const item = mapHistoryItem(rows[i]);
      if (item.id.length > 0) next.push(item);
    }
    if (reset) {
      records.value = next;
    } else {
      const merged: VoiceRecordHistoryItem[] = [];
      for (let i = 0; i < records.value.length; i++) {
        merged.push(records.value[i]);
      }
      for (let i = 0; i < next.length; i++) {
        merged.push(next[i]);
      }
      records.value = merged;
    }
    if (next.length > 0) lastId.value = next[next.length - 1].id;
    hasMore.value = rows.length >= pageSize;
  } catch (_error) {
    uni.showToast({ title: "历史记录加载失败", icon: "none" });
  } finally {
    loading.value = false;
    refreshing.value = false;
  }
}

function loadMore(): void {
  void loadRecords(false);
}

function handleRefresh(): void {
  refreshing.value = true;
  void loadRecords(true);
}

function handleBack(): void {
  uni.navigateBack({ delta: 1 });
}

function keepCardActions(): void {}

function openDoc(item: VoiceRecordHistoryItem, docUrl: string): void {
  uni.navigateTo({
    url: "/subpackages/pages/webview/webview?url=" + encodeURIComponent(docUrl) + "&title=" + encodeURIComponent(item.title),
  });
}

async function handleDownload(item: VoiceRecordHistoryItem): Promise<void> {
  if (item.status != "SUCCESS") {
    uni.showToast({ title: "文档还未生成", icon: "none" });
    return;
  }
  if (item.docUrl.length > 0) {
    openDoc(item, item.docUrl);
    return;
  }
  try {
    const detail = await apiVoiceNoteDetail(item.id);
    const docUrl = detail != null && detail["docUrl"] != null ? `${detail["docUrl"]}` : "";
    if (docUrl.length == 0) {
      uni.showToast({ title: "文档还未生成", icon: "none" });
      return;
    }
    item.docUrl = docUrl;
    openDoc(item, docUrl);
  } catch (_error) {
    uni.showToast({ title: "文档还未生成", icon: "none" });
  }
}

function openDetail(item: VoiceRecordHistoryItem): void {
  if (item.id.length == 0) {
    return;
  }
  uni.navigateTo({
    url: "/subpackages/pages/voice-record-detail/voice-record-detail?noteId=" + encodeURIComponent(item.id),
  });
}

function canReprocess(status: string): boolean {
  return status == "ASR_PARTIAL_FAILED" || status == "DOC_FAILED" || status == "DOC_REMOVED";
}

/** 三种失败都调同一个 reprocess，后端按当前状态决定重新转写、重出文档或重建文档。 */
function reprocessLabel(status: string): string {
  if (status == "ASR_PARTIAL_FAILED") return "重新转写";
  if (status == "DOC_FAILED") return "重新生成文档";
  if (status == "DOC_REMOVED") return "重建文档";
  return "";
}

async function handleReprocess(item: VoiceRecordHistoryItem): Promise<void> {
  try {
    const status = await apiVoiceNoteReprocess(item.id);
    applyStatus(item, status);
    uni.showToast({ title: "已开始处理", icon: "none" });
  } catch (error) {
    const message = `${error}`;
    uni.showToast({ title: message.length > 0 ? message : "处理失败", icon: "none" });
  }
}

function removeRecord(noteId: string): void {
  const next: VoiceRecordHistoryItem[] = [];
  for (let i = 0; i < records.value.length; i++) {
    if (records.value[i].id != noteId) next.push(records.value[i]);
  }
  records.value = next;
}

async function confirmDelete(item: VoiceRecordHistoryItem): Promise<void> {
  try {
    await apiVoiceNoteDelete(item.id);
    removeRecord(item.id);
    uni.showToast({ title: "已删除", icon: "none" });
  } catch (_error) {
    uni.showToast({ title: "删除失败", icon: "none" });
  }
}

function handleDelete(item: VoiceRecordHistoryItem): void {
  uni.showModal({
    title: "删除录音",
    content: "删除后无法恢复，确定删除？",
    confirmText: "删除",
    cancelText: "取消",
    success: (res) => {
      if (res.confirm != true) return;
      confirmDelete(item);
    },
  });
}

onShow(() => {
  void loadRecords(true);
});
</script>

<style lang="scss" scoped>
.vh-page {
  flex: 1;
  background-color: #f4f5f7;
}

.vh-nav {
  height: 88rpx;
  flex-direction: row;
  align-items: center;
  padding: 0 8rpx;
}

.vh-nav__side {
  width: 88rpx;
  height: 88rpx;
  justify-content: center;
  padding-left: 16rpx;
}

.vh-nav__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.vh-list {
  flex: 1;
  padding: 8rpx 24rpx 32rpx 24rpx;
}

.vh-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.vh-card__head {
  flex-direction: row;
  align-items: flex-start;
}

.vh-card__title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  lines: 2;
}

.vh-card__actions {
  margin-top: 20rpx;
  flex-direction: row;
  flex-wrap: wrap;
}

.vh-card__btn {
  flex-direction: row;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  background-color: #ffffff;
}

.vh-card__btn--active {
  background-color: rgba(12, 20, 102, 0.04);
}

.vh-card__btn-text {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #666666;
}

.vh-card__btn-text--plain {
  margin-left: 0;
}

.vh-footer {
  padding: 8rpx 0 24rpx 0;
  align-items: center;
}

.vh-footer__text {
  font-size: 24rpx;
  color: #9a9aa2;
}

.vh-card__meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9a9aa2;
}

.vh-card__file {
  margin-top: 20rpx;
  flex-direction: row;
  align-items: center;
  background-color: #f3f2fb;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}

.vh-card__path {
  flex: 1;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #6a68b8;
  lines: 1;
  text-overflow: ellipsis;
}
</style>
