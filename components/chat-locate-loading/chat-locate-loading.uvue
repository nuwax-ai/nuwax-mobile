<template>
  <!-- 消息定位等待遮罩：带定位目标进聊天页时，列表在 veiled 遮蔽期是纯白空白
       （等 seq 直达取页 + 150ms 稳定重定位），这里给居中的转圈 + 文案反馈。
       零绑定挂载——显隐读模块级 ref（chat-ai-hint 同款），页面侧写入即重渲；
       chat.uvue 模板不能再新增 setup 顶层引用（255 捕获上限）。 -->
  <view v-if="visible" class="chat-locate-loading" :class="inlineMode ? 'chat-locate-loading--inline' : ''">
    <view class="chat-locate-loading__panel" :class="inlineMode ? 'chat-locate-loading__panel--inline' : ''">
      <view class="chat-locate-loading__spin" :style="spinStyle(spinDeg)" />
      <text class="chat-locate-loading__text">{{ t("Mobile.Message.locateLoading") }}</text>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { onUnmounted, ref, watch } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { chatLocateLoadingVisible, chatLocateLoadingInline } from "@/utils/chatLocateLoading.uts";

  /** 模块级 ref 直接取别名（勿包 computed）：模板直读模块 ref、页面侧写入即重渲。 */
  const visible = chatLocateLoadingVisible;
  /** 轻量形态（会话内跳转）：铺满白底 → 居中半透明胶囊，见 utils/chatLocateLoading.uts。 */
  const inlineMode = chatLocateLoadingInline;
  /** 文案在模板里逐渲染取（chat-ai-hint 同款），不缓存：语言包/文案更新即刻生效。 */
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ===== 转圈环（照搬 chat.uvue 图片 loading 环的配方）=====
  // App 端 CSS animation 不可靠——旋转由 inline style 注入的 transform + transition-duration
  // 共同完成。起转段=单圈短 tick（800ms，首帧就有可见弧线）；稳态段=4 圈长 tick（3200ms），
  // JS→native 桥接降频 4 倍、弧间接缝抖动摊薄（spin-loading / agentClock 同款）。
  // 两段周期不同，setInterval 定周期接不上，用链式 setTimeout 自续。
  const SPIN_PERIOD_MS: number = 800;
  const SPIN_CYCLES_PER_TICK: number = 4;

  const spinDeg = ref<number>(0);
  /** 当前过渡弧时长（起转 800ms / 稳态 3200ms）。非 ref：只在 tick 里改，值由随后
   *  deg 变更驱动的重渲染带上（模板对 deg 的响应依赖不变）。 */
  let spinArcMs = SPIN_PERIOD_MS;
  let spinTickTimer = 0;
  let spinStartTimer = 0;

  /** 旋转环 inline style：★返回 UTSJSONObject 而非样式串——App-Android 串内 border 颜色
   *  解析不可靠（解析不掉会回落平台默认黑边，真机「黑色圆圈」即此），对象形态 camelCase
   *  键由各端归一化；class 内同步给 top/right 色兜底，任一通道失效都不出黑边。 */
  function spinStyle(deg: number): UTSJSONObject {
    const style = new UTSJSONObject();
    style["transform"] = `rotate(${deg}deg)`;
    style["transitionDuration"] = `${spinArcMs}ms`;
    style["borderTopColor"] = "#94929c";
    style["borderRightColor"] = "#94929c";
    return style;
  }

  function clearSpinTimers(): void {
    if (spinTickTimer != 0) {
      clearTimeout(spinTickTimer);
      spinTickTimer = 0;
    }
    if (spinStartTimer != 0) {
      clearTimeout(spinStartTimer);
      spinStartTimer = 0;
    }
  }

  /** 稳态段自续：到点抬 4 圈角、切长弧时长并按同周期续下一段。 */
  function scheduleSpinSteadyTick(): void {
    spinTickTimer = setTimeout(() => {
      spinArcMs = SPIN_PERIOD_MS * SPIN_CYCLES_PER_TICK;
      spinDeg.value = spinDeg.value + 360 * SPIN_CYCLES_PER_TICK;
      scheduleSpinSteadyTick();
    }, spinArcMs);
  }

  /** 起转：先落 0 度，等一拍节点就绪再抬 360（首帧就有 transition 才转得起来）。 */
  function startSpin(): void {
    clearSpinTimers();
    spinDeg.value = 0;
    spinArcMs = SPIN_PERIOD_MS;
    spinStartTimer = setTimeout(() => {
      spinStartTimer = 0;
      spinDeg.value = 360;
      scheduleSpinSteadyTick();
    }, 50);
  }

  // 显隐切换跟随（组件被 v-if 卸载前不会再有 tick，这里统一收定时器）
  watch(
    (): boolean => visible.value,
    (on: boolean) => {
      if (on) {
        startSpin();
      } else {
        clearSpinTimers();
      }
    },
    { immediate: true },
  );

  onUnmounted(() => {
    clearSpinTimers();
  });
</script>

<style lang="scss" scoped>
  /* 绝对铺满 .chat-body-wrap（消息列区域）：遮罩不需要参与布局，揭幕时零位移。
     ★不透明白底：首屏拉取阶段底下还有 chat-state 的「加载中…」，透出会变成
     「加载中 + 正在定位」两套文案；白底一并盖掉，全流程只给这一处反馈 */
  .chat-locate-loading {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* 轻量形态：不铺满、不挡触碰——容器收成居中的一小块（上下留出阅读区），
     底下一层极淡的黑色 scrim 都不给（会话是活的，任何整屏叠加都会闪） */
  .chat-locate-loading--inline {
    background-color: rgba(0, 0, 0, 0);
  }

  .chat-locate-loading__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 胶囊：白底 + 细边 + 轻投影，深色气泡上也认得出；横向排（转圈在左、文案在右） */
  .chat-locate-loading__panel--inline {
    flex-direction: row;
    padding: 9px 16px;
    background-color: rgba(255, 255, 255, 0.96);
    border-radius: 18px;
    border-width: 1px;
    border-style: solid;
    border-color: #ececf1;
  }

  /* 胶囊内文案跟转圈同基线，去掉竖排时的上边距 */
  .chat-locate-loading__panel--inline .chat-locate-loading__text {
    margin-top: 0px;
    margin-left: 8px;
  }

  /* 转圈环：四边 border 用 longhand 且非高亮边 transparent；高亮弧颜色（top/right）由
     spinStyle 对象 inline 注入（class 单边 border-color 覆盖在 App-Android 不可靠），
     class 内仍给同色兜底：inline 通道失效时不回落平台默认黑边 */
  .chat-locate-loading__spin {
    width: 24px;
    height: 24px;
    border-radius: 100px;
    box-sizing: border-box;
    flex-shrink: 0;
    border-top-width: 2px;
    border-top-style: solid;
    border-top-color: #94929c;
    border-right-width: 2px;
    border-right-style: solid;
    border-right-color: #94929c;
    border-bottom-width: 2px;
    border-bottom-style: solid;
    border-bottom-color: transparent;
    border-left-width: 2px;
    border-left-style: solid;
    border-left-color: transparent;
    transition-property: transform;
    transition-timing-function: linear;
    transform: rotate(0deg);
  }

  /* 与列表 loading 胶囊同款次级灰小字 */
  .chat-locate-loading__text {
    margin-top: 10px;
    font-size: 12px;
    line-height: 17px;
    color: #b0aebc;
  }
</style>
