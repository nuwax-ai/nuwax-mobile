<template>
  <uni-modal-popup
    ref="modal"
    :title="displayTitle"
    position="center"
    :enable-swipe-close="false"
    :body-scroll="false"
  >
    <template #header-extra>
      <view class="copy-btn" @tap="copy">
        <svg-icon name="icon-CopyOutlined" />
      </view>
    </template>
    <view class="details-content">
      <scroll-view
        v-if="diffFiles.length > 0"
        class="details-diff-scroll"
        direction="vertical"
        :show-scrollbar="true"
        :style="{ height: diffViewportHeight }"
      >
        <diff-list-view :files="diffFiles" />
      </scroll-view>
      <!-- 深色代码区：高度随内容自适应，超过上限后内外层分别竖/横滚动 -->
      <view v-else class="details-code-panel">
        <scroll-view
          class="details-code-v"
          direction="vertical"
          :show-scrollbar="true"
          :style="{ height: codeViewportHeight }"
        >
          <scroll-view
            class="details-code-h"
            direction="horizontal"
            :show-scrollbar="true"
            :style="{ height: codeContentHeight }"
          >
            <view class="details-code-body" :style="{ width: codeContentWidth }">
              <view
                v-for="(line, index) in codeLines"
                :key="index"
                class="details-code-row"
              >
                <text class="details-code-ln">{{ index + 1 }}</text>
                <text class="details-code-text">{{ line.length > 0 ? line : " " }}</text>
              </view>
            </view>
          </scroll-view>
        </scroll-view>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script lang="uts" setup>
  import { ref, computed, type ComponentPublicInstance } from "vue";
  import { t } from "@/utils/i18n";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import DiffListView from "@/components/diff-list-view/diff-list-view.uvue";

  /** 单行高度（rpx），与样式 .details-code-row 保持一致 */
  const LINE_HEIGHT_RPX = 40;
  /** 代码区上内边距（rpx） */
  const CODE_PAD_TOP_RPX = 16;
  /** 代码区下内边距（rpx）：略加大，避免末行被裁切 */
  const CODE_PAD_BOTTOM_RPX = 40;
  /**
   * iOS 嵌套 scroll-view 滚到底时常差一截，额外预留缓冲。
   */
  const SCROLL_BOTTOM_BUFFER_RPX = 48;
  /** 代码区最高高度（rpx），超出后纵向滚动 */
  const MAX_CODE_HEIGHT_RPX = 640;
  /** diff 列表最高高度 */
  const MAX_DIFF_HEIGHT_RPX = 720;

  const props = withDefaults(
    defineProps<{
      title?: string | null;
      detailData?: any | null;
    }>(),
    {
      title: "",
      detailData: null,
    },
  );

  const modal = ref<any | null>(null);
  /** openWith 写入的本地数据，避免父页改 props 触发整页消息列表重渲染 */
  const localTitle = ref<string>("");
  const localDetailData = ref<any | null>(null);
  const useLocalData = ref(false);

  const activeDetailData = computed((): any | null => {
    if (useLocalData.value) {
      return localDetailData.value;
    }
    return props.detailData != null ? props.detailData : null;
  });

  const displayTitle = computed((): string => {
    if (useLocalData.value) {
      return localTitle.value;
    }
    const raw = props.title;
    if (raw == null) {
      return "";
    }
    return `${raw}`;
  });

  /** Android：Gen* 组件禁止 as UTSJSONObject，须 $callMethod 调 defineExpose。 */
  const callRefMethod = (refVal: any | null, methodName: string): void => {
    if (refVal == null) {
      return;
    }
    const proxy = refVal as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  };

  const readDetailField = (key: string): any | null => {
    const data = activeDetailData.value;
    if (data == null) {
      return null;
    }
    try {
      const obj = data as UTSJSONObject;
      const value = obj[key];
      return value != null ? value : null;
    } catch (e) {
      return null;
    }
  };

  const appPlainDetailText = computed((): string => {
    const data = activeDetailData.value;
    if (data == null) {
      return "";
    }
    try {
      return JSON.stringify(data, null, 2);
    } catch (e) {
      return `${data}`;
    }
  });

  const codeLines = computed((): string[] => {
    const text = appPlainDetailText.value;
    if (text.length == 0) {
      const empty = [] as string[];
      empty.push("");
      return empty;
    }
    return text.split("\n");
  });

  /** 内容实际高度（随行数增长）；含底部缓冲，保证能滚到最后一行 */
  const codeContentHeightRpx = computed((): number => {
    const lineCount = Math.max(codeLines.value.length, 1);
    return (
      lineCount * LINE_HEIGHT_RPX +
      CODE_PAD_TOP_RPX +
      CODE_PAD_BOTTOM_RPX +
      SCROLL_BOTTOM_BUFFER_RPX
    );
  });

  /** 视口高度：内容自适应，封顶 MAX */
  const codeViewportHeight = computed((): string => {
    const content = codeContentHeightRpx.value;
    const h = content < MAX_CODE_HEIGHT_RPX ? content : MAX_CODE_HEIGHT_RPX;
    return `${h}rpx`;
  });

  /** 内层横向 scroll 需用内容真实高度，才能被外层纵向滚完 */
  const codeContentHeight = computed((): string => {
    return `${codeContentHeightRpx.value}rpx`;
  });

  /** 按最长行估算宽度，保证横向可滚 */
  const codeContentWidth = computed((): string => {
    const lines = codeLines.value;
    let maxLen = 0;
    for (let i = 0; i < lines.length; i++) {
      if (lines[i].length > maxLen) {
        maxLen = lines[i].length;
      }
    }
    // 行号约 72rpx + 每字符约 16rpx（等宽）+ 右侧留白
    const width = 72 + Math.max(maxLen, 8) * 16 + 48;
    return `${width}rpx`;
  });

  const diffFiles = computed((): any[] => {
    const files = readDetailField("__diffFiles");
    if (files != null && Array.isArray(files)) {
      return files as any[];
    }
    return [];
  });

  const diffViewportHeight = computed((): string => {
    return `${MAX_DIFF_HEIGHT_RPX}rpx`;
  });

  const copy = () => {
    const data =
      diffFiles.value.length > 0 ? diffFiles.value : activeDetailData.value;
    if (data == null) {
      return;
    }
    let content = "";
    try {
      content = JSON.stringify(data, null, 2);
    } catch (e) {
      content = `${data}`;
    }

    uni.setClipboardData({
      data: content,
      success: () => {
        uni.showToast({
          title: t("Mobile.Common.copySuccess"),
          icon: "none",
        });
      },
      fail: () => {
        uni.showToast({
          title: t("Mobile.Common.copyFailed"),
          icon: "none",
        });
      },
    });
  };

  const open = () => {
    useLocalData.value = false;
    callRefMethod(modal.value, "open");
  };

  /**
   * 带数据打开：数据落在弹窗内部，父页不必改 title/detailData。
   * Android $callMethod 传参：openWith(title, detailData)
   */
  const openWith = (title: string | null, detailData: any | null) => {
    useLocalData.value = true;
    localTitle.value = title != null ? `${title}` : "";
    localDetailData.value = detailData;
    callRefMethod(modal.value, "open");
  };

  const close = () => {
    callRefMethod(modal.value, "close");
  };

  defineExpose({
    open,
    openWith,
    close,
  });
</script>

<style lang="scss" scoped>
  .copy-btn {
    margin: 0 25rpx;
    .iconfont {
      color: #333;
      font-size: 32rpx;
    }
  }

  .details-content {
    width: 100%;
    min-height: 0;
    padding: 0 24rpx 24rpx;
    box-sizing: border-box;
  }

  .details-diff-scroll {
    width: 100%;
  }

  /* 对齐参考图：圆角深色代码面板 */
  .details-code-panel {
    width: 100%;
    border-radius: 16rpx;
    overflow: hidden;
    background-color: #2b2b2b;
  }

  .details-code-v {
    width: 100%;
  }

  .details-code-h {
    width: 100%;
  }

  .details-code-body {
    flex-direction: column;
    padding-top: 16rpx;
    /* 底部多留一些，避免末行贴边/被裁 */
    padding-bottom: 40rpx;
  }

  .details-code-row {
    flex-direction: row;
    align-items: flex-start;
    height: 40rpx;
    flex-shrink: 0;
  }

  .details-code-ln {
    width: 72rpx;
    flex-shrink: 0;
    text-align: right;
    padding-right: 16rpx;
    font-size: 24rpx;
    line-height: 40rpx;
    color: rgba(255, 255, 255, 0.35);
    font-family: monospace;
    border-right-width: 1px;
    border-right-style: solid;
    border-right-color: rgba(255, 255, 255, 0.12);
  }

  .details-code-text {
    flex-shrink: 0;
    padding-left: 20rpx;
    padding-right: 24rpx;
    font-size: 26rpx;
    line-height: 40rpx;
    color: #e8e8e8;
    font-family: monospace;
    white-space: pre;
  }
</style>
