export const SUCCESS_CODE = '0000';
// 用户未登录
export const USER_NO_LOGIN = '4010';
// 重定向登录
export const REDIRECT_LOGIN = '4011';
// IM 网关鉴权失败：token 无效或已过期（HTTP 401，后端 ImAuthInterceptor 注明「前端据此跳登录页；不可重试」，
// 语义等同 4010：清登录态踢登录页。长时间挂后台 token 过期后进聊天页只 toast 不踢登录的死胡同由此修掉）
export const IM_TOKEN_INVALID = 'IM_10401';
// IM 网关鉴权失败：平台 4011 要求跳转到 message 指定地址重新登录（HTTP 401，语义等同 4011）
export const IM_AUTH_REDIRECT = 'IM_10402';
// 智能体不存在或已下架
export const AGENT_NOT_EXIST = '0001';
