<template>
  <uni-modal-popup ref="popupRef" position="bottom" height="32%" :show-header="false" :body-scroll="false" @update-visible="handleVisibleChange">
    <view class="sheet" :class="{ 'sheet--avoid-tab-bar': avoidTabBar }">
      <view class="sheet-handle" />
      <!-- 两选项（对齐 PC workspace-dir-bar Dropdown）：默认工作目录 / 打开电脑文件夹 -->
      <view class="option-row" @click="handlePickDefault">
        <svg-icon name="icon-Folder" size="38" color="#5147ff" />
        <text class="option-text">{{ t("Mobile.CreateHub.defaultWorkspaceDir") }}</text>
        <text v-if="currentPath.length == 0" class="option-check">✓</text>
      </view>
      <view class="option-row" @click="handlePickFolder">
        <svg-icon name="icon-Folder" size="38" color="#5147ff" />
        <text class="option-text">{{ t("Mobile.CreateHub.openComputerFolder") }}</text>
        <text v-if="currentPath.length > 0" class="option-check">✓</text>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, watch, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import SvgIcon from "@/components/svg-icon/svg-icon.uvue";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const props = withDefaults(defineProps<{
    visible: boolean;
    /** 当前工作目录（空 = 默认工作目录选中态） */
    currentPath?: string;
    avoidTabBar?: boolean;
  }>(), {
    visible: false,
    currentPath: "",
    avoidTabBar: false,
  });
  const emit = defineEmits<{ (e: "close"): void; (e: "selectDefault"): void; (e: "openPicker"): void; }>();

  const popupRef = ref<any | null>(null);

  function callPopup(method: string): void {
    if (popupRef.value != null) (popupRef.value as ComponentPublicInstance).$callMethod(method);
  }

  function close(): void {
    callPopup("close");
  }

  function handleVisibleChange(value: boolean): void {
    if (value != true) emit("close");
  }

  function handlePickDefault(): void {
    emit("selectDefault");
    close();
  }

  function handlePickFolder(): void {
    emit("openPicker");
    close();
  }

  watch(
    (): boolean => props.visible,
    (value: boolean): void => {
      if (value) callPopup("open");
      else callPopup("close");
    },
  );
</script>

<style lang="scss" scoped>
  .sheet { display: flex; flex-direction: column; height: 100%; padding: 18rpx 32rpx 0; background-color: #ffffff; box-sizing: border-box; }
  /* #ifdef APP-ANDROID || APP-HARMONY */
  .sheet--avoid-tab-bar { padding-bottom: 100rpx; }
  /* #endif */
  /* #ifdef APP-IOS */
  /* iOS 窗口高度不含 tabBar（2026-09-19 真机实测），弹层无需避让，多留只会出现底部空白 */
  .sheet--avoid-tab-bar { padding-bottom: env(safe-area-inset-bottom); }
  /* #endif */
  /* #ifdef H5 */
  .sheet--avoid-tab-bar { padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
  /* #endif */
  .sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 999rpx; background-color: #dedee8; }

  .option-row { display: flex; flex-direction: row; align-items: center; min-height: 104rpx; padding: 16rpx 24rpx; border-radius: 20rpx; }
  .option-text { flex: 1; margin-left: 18rpx; color: #292930; font-size: 30rpx; }
  .option-check { color: #5147ff; font-size: 32rpx; font-weight: 700; }
</style>
