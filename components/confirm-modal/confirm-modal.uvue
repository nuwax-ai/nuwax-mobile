<template>
  <!--
    紧凑确认弹窗（危险操作二次确认用）。
    风格对齐项目内 delete-account-modal：600rpx 白底圆角卡片、居中标题、
    底部分割线双按钮（取消 / 红色确认），替代 uni.showModal 系统样式（App 端偏大偏松）。
  -->
  <view v-if="visible" class="confirm-modal__mask" @tap="cancel">
    <view class="confirm-modal__panel" @tap.stop>
      <text class="confirm-modal__title">{{ title }}</text>
      <view class="confirm-modal__body">
        <text class="confirm-modal__desc">{{ content }}</text>
      </view>
      <view class="confirm-modal__actions">
        <view class="confirm-modal__btn confirm-modal__btn--cancel" @tap="cancel">
          <text class="confirm-modal__btn-text">{{ t("Mobile.Common.cancel") }}</text>
        </view>
        <view class="confirm-modal__btn" @tap="confirm">
          <text class="confirm-modal__btn-text confirm-modal__btn-text--danger">{{ confirmLabel }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const emit = defineEmits<{
    /** 点确认（红色钮）或无取消钮时点遮罩外：关闭后通知宿主执行操作 */
    confirm: [];
    /** 点取消 / 点遮罩：仅关闭 */
    cancel: [];
  }>();

  const visible = ref(false);
  const title = ref("");
  const content = ref("");
  const confirmLabel = ref("");

  /** 打开（文案由宿主传入）：标题 / 正文 / 确认按钮文案（恒红色危险态）。 */
  function open(dialogTitle: string, dialogContent: string, dialogConfirm: string): void {
    title.value = dialogTitle;
    content.value = dialogContent;
    confirmLabel.value = dialogConfirm;
    visible.value = true;
  }

  function close(): void {
    visible.value = false;
  }

  function cancel(): void {
    close();
    emit("cancel");
  }

  function confirm(): void {
    close();
    emit("confirm");
  }

  defineExpose({ open, close });
</script>

<style lang="scss" scoped>
  .confirm-modal__mask {
    position: fixed;
    z-index: 1000;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .confirm-modal__panel {
    width: 600rpx;
    box-sizing: border-box;
    background-color: #ffffff;
    border-radius: 24rpx;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .confirm-modal__title {
    font-size: 32rpx;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 44rpx;
    text-align: center;
    margin-top: 44rpx;
  }

  .confirm-modal__body {
    display: flex;
    flex-direction: column;
    padding: 24rpx 40rpx 40rpx;
  }

  .confirm-modal__desc {
    font-size: 28rpx;
    color: #666666;
    line-height: 44rpx;
    text-align: center;
  }

  .confirm-modal__actions {
    display: flex;
    flex-direction: row;
    border-top: 2rpx solid #f0f0f0;
  }

  .confirm-modal__btn {
    flex: 1;
    height: 100rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .confirm-modal__btn--cancel {
    border-right: 2rpx solid #f0f0f0;
  }

  .confirm-modal__btn-text {
    font-size: 32rpx;
    color: #1a1a1a;
  }

  .confirm-modal__btn-text--danger {
    color: #fa5151;
  }
</style>
