/**
 * ACP 权限审批状态 reconcile（对齐 nuwax PC reconcileAcpPermissionStatus.ts）
 * 用于 sub 流重放、跨端审批后将会话内 pending 标为 submitted。
 */
import {
  MessageInfo,
  ProcessingInfo,
} from "@/types/interfaces/conversationInfo.uts";
import {
  McpAskInteraction,
  MCP_ASK_TOOL_NAME,
} from "@/types/intervention";
import { ProcessingEnum } from "@/types/enums/common";
import { orArray, orString } from "@/utils/utsCoalesce.uts";
import { hasMcpAskResumeMessage } from "@/subpackages/utils/mcpAskResumeLite.uts";
import { createInteractionUiSchemaFromAny } from "@/utils/mcpAskSchema.uts";
import { readRawField } from "@/utils/readRawField.uts";
import {
  createMessageInfoFromRaw,
  messageToJsonObject,
} from "@/subpackages/utils/messageInfoClass.uts";

// Android 上 UTSJSONObject as MessageInfo（class）会 ClassCastException。
// 禁止 JSON.parse 后强转 class；走 messageToJsonObject（手写字段，避免 stringify(class) 丢字段）
// → 改字段 → createMessageInfoFromRaw 重建 MessageInfoClass，与 messageInfoClass.cloneMessageInfo 同源。
function patchMessageInfo(
  message: MessageInfo,
  field: string,
  value: any,
): MessageInfo {
  const copy = messageToJsonObject(message);
  copy[field] = value;
  return createMessageInfoFromRaw(copy);
}

// Android 上 interaction 运行时是 UTSJSONObject，JSON.parse 返回 UTSJSONObject，
// 禁止 as AcpPermissionInteraction（class）→ CCE。统一 as UTSJSONObject（bracket 可写）。
function cloneAcpPermissionInteraction(
  interaction: any,
): UTSJSONObject {
  return JSON.parse(
    JSON.stringify(interaction),
  ) as UTSJSONObject;
}

function readMcpAskRequestId(rawInput: any | null): string | null {
  if (rawInput == null || typeof rawInput != "object") return null;
  const id = readRawField(rawInput, "requestId");
  return typeof id == "string" && id.length > 0 ? id : null;
}

function getToolCallId(
  interaction: any,
): string | null {
  // Android：interaction 实为 UTSJSONObject，链式直读会失效，须 readRawField 逐层取
  const request = readRawField(interaction, "request");
  const toolCall = readRawField(request, "toolCall");
  const id = readRawField(toolCall, "toolCallId");
  return id != null && `${id}`.length > 0 ? `${id}` : null;
}

function isProcessingFinishedForTool(
  processingList: any[] | null,
  toolCallId: string,
  permissionExecuteId: string | null = null,
): boolean {
  if (processingList == null || processingList.length == 0) return false;

  // Android：processingList 元素实为 UTSJSONObject，禁止声明为 ProcessingInfo[]（泛型数组取元素会强转），
  // 必须 any[] + readRawField 逐字段读取。
  for (let i = 0; i < processingList.length; i++) {
    const item = processingList[i];
    const itemStatus = `${readRawField(item, "status")}`;
    if (itemStatus != `${ProcessingEnum.FINISHED}`) continue;

    const itemExecuteId = orString(readRawField(item, "executeId"), "");
    if (
      permissionExecuteId != null &&
      permissionExecuteId.length > 0 &&
      itemExecuteId == permissionExecuteId
    ) {
      return true;
    }
    if (itemExecuteId == toolCallId) {
      return true;
    }

    const result = readRawField(item, "result");
    const input = readRawField(result, "input");
    if (input != null && typeof input == "object") {
      const matchedId = orString(
        readRawField(input, "toolCallId"),
        orString(readRawField(input, "tool_call_id"), ""),
      );
      if (matchedId == toolCallId) {
        return true;
      }
    }
  }

  return false;
}

function buildMcpAskInteractionFromRawInput(
  rawInput: any | null,
  toolCallId: string,
): McpAskInteraction | null {
  if (rawInput == null || typeof rawInput != "object") return null;
  const requestId = readMcpAskRequestId(rawInput);
  const titleRaw = readRawField(rawInput, "title");
  const title = typeof titleRaw == "string" ? titleRaw : null;
  const ui = readRawField(rawInput, "ui");
  if (
    requestId == null ||
    requestId.length == 0 ||
    title == null ||
    title.length == 0 ||
    ui == null ||
    typeof ui != "object"
  ) {
    return null;
  }

  const uiSchema = createInteractionUiSchemaFromAny(ui);
  if (uiSchema == null) {
    return null;
  }
  const interaction = new McpAskInteraction();
  interaction.toolName = MCP_ASK_TOOL_NAME;
  interaction.schemaVersion = "nuwax.mcp_ask.v2";
  interaction.requestId = requestId;
  interaction.revision = 1;
  interaction.sessionId = "";
  interaction.title = title;
  interaction.ui = uiSchema;
  interaction.toolCallId = toolCallId;
  interaction.responseStatus = "pending";
  return interaction;
}

function shouldMarkAcpPermissionSubmitted(
  interaction: any,
  message: MessageInfo,
  contextMessageList: MessageInfo[],
): boolean {
  const status = orString(readRawField(interaction, "responseStatus"), "pending");
  if (status == "submitted" || status == "failed") {
    return false;
  }

  const toolCallId = getToolCallId(interaction);
  const executeIdRaw = readRawField(interaction, "executeId");
  const executeId: string | null = executeIdRaw != null ? `${executeIdRaw}` : null;
  // message.processingList 声明为 ProcessingInfo[]，传入 any[] 参数前显式转 any[]（Android 元素实为 UTSJSONObject）
  const processingAny = orArray<any>(message.processingList);
  if (
    toolCallId != null &&
    toolCallId.length > 0 &&
    isProcessingFinishedForTool(
      processingAny,
      toolCallId,
      executeId,
    )
  ) {
    console.log(
      `[ITV] reconcile acp id=${readRawField(interaction, "id")} toolCall=${toolCallId} → submitted (processing FINISHED)`,
    );
    return true;
  }

  const request = readRawField(interaction, "request");
  const toolCall = readRawField(request, "toolCall");
  const rawInput = readRawField(toolCall, "rawInput");
  if (toolCallId != null && toolCallId.length > 0 && readMcpAskRequestId(rawInput) != null) {
    const syntheticAsk = buildMcpAskInteractionFromRawInput(
      rawInput,
      toolCallId,
    );
    if (
      syntheticAsk != null &&
      hasMcpAskResumeMessage(contextMessageList, syntheticAsk)
    ) {
      console.log(
        `[ITV] reconcile acp id=${readRawField(interaction, "id")} → submitted (mcp resume)`,
      );
      return true;
    }
  }

  return false;
}

/** 单条消息内 ACP 审批 reconcile */
export function reconcileMessageAcpPermissionStatuses(
  message: MessageInfo,
  contextMessageList?: MessageInfo[],
): MessageInfo {
  // interaction 运行时是 UTSJSONObject：禁止 orArray<AcpPermissionInteraction> 泛型强转后直读/改属性。
  const interactions = orArray<any>(
    message.acpPermissionInteractions,
  );
  if (interactions.length == 0) {
    return message;
  }

  const context = contextMessageList != null ? contextMessageList : [message];
  let changed = false;
  const nextInteractions = interactions.map(
    (interaction: any): any => {
      if (
        !shouldMarkAcpPermissionSubmitted(interaction, message, context)
      ) {
        return interaction;
      }
      changed = true;
      const next = cloneAcpPermissionInteraction(interaction);
      next["responseStatus"] = "submitted";
      return next;
    },
  );

  if (!changed) return message;

  return patchMessageInfo(
    message,
    "acpPermissionInteractions",
    nextInteractions,
  );
}

/** 全量 messageList reconcile */
export function reconcileAcpPermissionStatusesInMessageList(
  messageList: MessageInfo[],
): MessageInfo[] {
  return messageList.map((message: MessageInfo) =>
    reconcileMessageAcpPermissionStatuses(message, messageList),
  );
}

/** notify-resolved 幂等：Host 侧 pending 已不存在时视为已审批成功 */
export function isIdempotentAcpPermissionResolveError(error: any): boolean {
  const message =
      error instanceof Error ? error.message : `${error != null ? error : ""}`;
  const normalized = message.toLowerCase();
  return (
    normalized.includes("not_found") ||
    normalized.includes("not found") ||
    normalized.includes("already_resolved") ||
    normalized.includes("already resolved") ||
    normalized.includes("permission not found") ||
    normalized.includes("err_permission_not_found") ||
    normalized.includes("gone")
  );
}
