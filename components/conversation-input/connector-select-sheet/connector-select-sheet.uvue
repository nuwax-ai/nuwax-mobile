<template>
  <uni-modal-popup ref="popupRef" position="bottom" height="78%" :show-header="false" :body-scroll="false" @update-visible="handleVisibleChange">
    <view class="sheet" :class="avoidTabBar ? 'sheet--avoid-tab-bar' : ''">
      <view class="sheet-header">
        <view class="title-box">
          <text class="sheet-title">{{ t("Mobile.CreateHub.connector") }}</text>
        </view>
        <view class="close-button" @click="close">
          <view class="close-line close-line--left" />
          <view class="close-line close-line--right" />
        </view>
      </view>

      <connector-source-panel
        :pager-enabled="visible"
        :refresh-on-show="false"
        :open-token="openToken"
        :initial-tab="initialTab"
      />
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, watch, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import ConnectorSourcePanel from "@/components/connector-source-panel/connector-source-panel.uvue";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const props = withDefaults(defineProps<{ visible: boolean; avoidTabBar?: boolean; initialTab?: string }>(), {
    visible: false,
    avoidTabBar: false,
    initialTab: "system",
  });
  const emit = defineEmits<{ (e: "close"): void; }>();
  const popupRef = ref<any | null>(null);
  const openToken = ref<number>(0);

  function callMethod(inst: any | null, method: string): void {
    if (inst != null) (inst as ComponentPublicInstance).$callMethod(method);
  }

  function close(): void { callMethod(popupRef.value, "close"); }

  function handleVisibleChange(value: boolean): void {
    if (!value) emit("close");
  }

  watch(
    (): boolean => props.visible,
    (value: boolean): void => {
      if (value) {
        // 打开时递增，页签区据此重置搜索并落到 initialTab
        openToken.value = openToken.value + 1;
        callMethod(popupRef.value, "open");
      } else {
        callMethod(popupRef.value, "close");
      }
    },
  );
</script>

<style scoped lang="scss">
  .sheet { display: flex; flex-direction: column; height: 100%; padding-top: 15px; background-color: #ffffff; box-sizing: border-box; }
  /* #ifdef H5 */
  .sheet--avoid-tab-bar { padding-bottom: calc(50px + env(safe-area-inset-bottom)); }
  /* #endif */
  .sheet-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 18px; }
  .title-box { display: flex; flex-direction: column; }
  .sheet-title { color: #17171d; font-size: 18px; font-weight: 700; line-height: 24px; }
  .close-button { position: relative; width: 29px; height: 29px; }
  .close-line { position: absolute; left: 6.5px; top: 14px; width: 17px; height: 2px; border-radius: 999px; background-color: #8b8b96; }
  .close-line--left { transform: rotate(45deg); }
  .close-line--right { transform: rotate(-45deg); }
</style>
