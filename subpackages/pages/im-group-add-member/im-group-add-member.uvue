<template>
  <view class="ga-page">
    <safety-zone />

    <!-- 顶部：返回 + 添加成员 -->
    <view class="ga-header">
      <view class="ga-header__btn" hover-class="ga-header__btn--active" @click="handleBack">
        <svg-icon name="icon-a-Chevronleft" size="40" color="#141416" />
      </view>
      <view class="ga-header__title-wrap">
        <text class="ga-header__title">{{ t("Mobile.Message.groupAddTitle") }}</text>
      </view>
      <view class="ga-header__btn ga-header__btn--ghost" />
    </view>

    <!-- tab：人 / 智能体（同建群页双 tab 口径） -->
    <view class="ga-tabs">
      <view
        class="ga-tab"
        :class="tab == 'user' ? 'ga-tab--on' : ''"
        hover-class="ga-tab--active"
        @click="switchTab('user')"
      >
        <text class="ga-tab__text" :class="tab == 'user' ? 'ga-tab__text--on' : ''">{{ t("Mobile.Message.buddyTabUser") }}</text>
      </view>
      <view
        class="ga-tab"
        :class="tab == 'agent' ? 'ga-tab--on' : ''"
        hover-class="ga-tab--active"
        @click="switchTab('agent')"
      >
        <text class="ga-tab__text" :class="tab == 'agent' ? 'ga-tab__text--on' : ''">{{ t("Mobile.Message.buddyTabAgent") }}</text>
      </view>
    </view>

    <!-- 搜索框（placeholder 按 tab 切换） -->
    <view class="ga-search">
      <input
        class="ga-search__input"
        v-model="keyword"
        :placeholder="tab == 'user' ? t('Mobile.Message.searchUserPlaceholder') : t('Mobile.Message.searchAgentPlaceholder')"
        placeholder-style="color:#b0aebc"
        confirm-type="search"
        @confirm="handleSearch"
      />
      <view class="ga-search__btn" hover-class="ga-search__btn--active" @click="handleSearch">
        <svg-icon name="icon-Search" size="36" color="#5147ff" />
      </view>
    </view>

    <scroll-view class="ga-body" direction="vertical" :show-scrollbar="false">
      <view v-if="!searched" class="ga-tip">
        <text class="ga-tip__text">{{ t(tab == 'user' ? "Mobile.Message.searchUserLabel" : "Mobile.Message.searchAgentLabel") }}</text>
      </view>
      <view v-else-if="loading" class="ga-state">
        <text class="ga-state__text">{{ t("Mobile.Page.loadingMore") }}</text>
      </view>
      <view v-else-if="loadFailed" class="ga-state" @click="handleSearch">
        <text class="ga-state__text">{{ t("Mobile.Message.loadFailed") }}</text>
      </view>
      <view v-else>
        <view
          v-for="c in candidates"
          :key="c.userId"
          class="ga-row"
          hover-class="ga-row--active"
          @click="togglePick(c)"
        >
          <image
            v-if="c.avatar.length > 0 && c.avatarFailed != true"
            class="ga-ava"
            :src="c.avatar"
            mode="aspectFill"
            @error="handleAvatarError(c)"
          />
          <view v-else class="ga-ava" :style="{ backgroundImage: avatarGradient(c.token) }">
            <text class="ga-ava-letter">{{ avatarLetter(c.token) }}</text>
          </view>
          <view class="ga-col">
            <text class="ga-name text-ellipsis">{{ c.token }}</text>
            <text v-if="c.sub.length > 0" class="ga-sub text-ellipsis">{{ c.sub }}</text>
          </view>
          <!-- 已在群里的成员：不可再选（服务端也会拒，前端直接置灰） -->
          <view v-if="isExisting(c)" class="ga-in">
            <text class="ga-in__text">{{ t("Mobile.Message.groupAlreadyMember") }}</text>
          </view>
          <view v-else class="ga-check" :class="c.checked ? 'ga-check--on' : ''">
            <svg-icon v-if="c.checked" name="icon-Check" size="32" color="#ffffff" />
          </view>
        </view>
        <view v-if="candidates.length == 0" class="ga-state">
          <text class="ga-state__text">{{ t("Mobile.AgentSearch.emptyResult") }}</text>
        </view>
        <view class="ga-tail" />
      </view>
    </scroll-view>

    <!-- 底部操作条：已选 N 人 + 添加 -->
    <view class="ga-bar">
      <text class="ga-bar__count">{{ selectedText }}</text>
      <view
        class="ga-bar__btn"
        :class="selectedIds.length > 0 ? 'ga-bar__btn--ready' : ''"
        hover-class="ga-bar__btn--active"
        @click="handleSubmit"
      >
        <text
          class="ga-bar__btn-text"
          :class="selectedIds.length > 0 ? 'ga-bar__btn-text--ready' : ''"
        >{{ t("Mobile.Message.groupAddSubmit") }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from "vue";
  import { onLoad } from "@dcloudio/uni-app";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import {
    apiImConvMembers,
    apiImGroupAddMembers,
    apiImSearchAgents,
    apiImSearchContacts,
  } from "@/servers/im";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /** 头像字母底色渐变板（与群信息页同款）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #f59a9a, #e05f5f)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  /** 搜索结果行（人/智能体统一模型）。sub 为次行说明（账号/描述）。 */
  class GaCandidate {
    userId: string = "";
    token: string = "";
    sub: string = "";
    avatar: string = "";
    checked: boolean = false;
    avatarFailed: boolean = false;
  }

  // ===== 页面入参 =====
  const convId = ref<string>("");
  const groupName = ref<string>("");

  // ===== 搜索状态 =====
  const tab = ref<string>("user");
  const keyword = ref<string>("");
  const candidates = ref<GaCandidate[]>([]);
  const searched = ref<boolean>(false);
  const loading = ref<boolean>(false);
  const loadFailed = ref<boolean>(false);
  const submitting = ref<boolean>(false);
  /** 已在群内的 userId 集合（搜索结果置灰不可选）。 */
  const existingIds = ref<string[]>([]);

  const selectedIds = computed((): string[] => {
    const out: string[] = [];
    const all = candidates.value;
    for (let i = 0; i < all.length; i++) {
      if (all[i].checked) {
        out.push(all[i].userId);
      }
    }
    return out;
  });

  const selectedText = computed((): string => {
    const params = new Map<string, string | number>();
    params.set("count", selectedIds.value.length);
    return translateFn("Mobile.Message.groupAddSelected", toI18nParams(params), `${selectedIds.value.length}`);
  });

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readOption(options: any | null, key: string): string {
    if (options == null) {
      return "";
    }
    const obj = options as UTSJSONObject;
    const raw = obj[key];
    if (raw == null) {
      return "";
    }
    const value = `${raw}`;
    try {
      const decoded = decodeURIComponent(value);
      return decoded != null ? decoded : value;
    } catch (_e) {
      return value;
    }
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  function handleAvatarError(c: GaCandidate): void {
    c.avatarFailed = true;
  }

  function isExisting(c: GaCandidate): boolean {
    return existingIds.value.indexOf(c.userId) >= 0;
  }

  function switchTab(next: string): void {
    if (tab.value == next || loading.value) {
      return;
    }
    tab.value = next;
    keyword.value = "";
    candidates.value = [];
    searched.value = false;
  }

  function togglePick(c: GaCandidate): void {
    if (isExisting(c) || submitting.value) {
      return;
    }
    c.checked = c.checked != true;
  }

  /** 拉取现有成员（置灰依据）；失败静默——只是少一层置灰，服务端仍会兜底。 */
  async function loadExisting(): Promise<void> {
    if (convId.value.length == 0) {
      return;
    }
    try {
      const res = await apiImConvMembers(convId.value);
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj == null) {
        return;
      }
      const recordsRaw = dataObj["records"];
      if (recordsRaw == null) {
        return;
      }
      const records = recordsRaw as UTSJSONObject[];
      const out: string[] = [];
      for (let i = 0; i < records.length; i++) {
        const id = readString(records[i], "userId");
        if (id.length > 0) {
          out.push(id);
        }
      }
      existingIds.value = out;
    } catch (_error) {
      // 静默
    }
  }

  /** 搜索：人（searchContacts）/ 智能体（contactSearchAgents，空关键词=浏览全部）。 */
  async function handleSearch(): Promise<void> {
    if (loading.value) {
      return;
    }
    loading.value = true;
    loadFailed.value = false;
    try {
      const out: GaCandidate[] = [];
      if (tab.value == "user") {
        // keyword 必填（1-64 字符）：空关键词不发起搜索，回到提示态
        const kw = keyword.value.trim();
        if (kw.length == 0) {
          searched.value = false;
          loading.value = false;
          return;
        }
        const res = await apiImSearchContacts(kw, 50);
        if (apiResCode(res) != SUCCESS_CODE) {
          loading.value = false;
          loadFailed.value = true;
          return;
        }
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj != null) {
          const itemsRaw = dataObj["items"];
          if (itemsRaw != null) {
            const items = itemsRaw as UTSJSONObject[];
            for (let i = 0; i < items.length; i++) {
              const c = new GaCandidate();
              c.userId = readString(items[i], "userId");
              const nickName = readString(items[i], "nickName");
              const userName = readString(items[i], "userName");
              c.token = nickName.length > 0 ? nickName : userName.length > 0 ? userName : `用户${c.userId}`;
              c.sub = userName.length > 0 && userName != c.token ? userName : "";
              c.avatar = readString(items[i], "avatar");
              if (c.userId.length > 0) {
                out.push(c);
              }
            }
          }
        }
      } else {
        const kw = keyword.value.trim();
        const res = await apiImSearchAgents(kw, 1, 50);
        if (apiResCode(res) != SUCCESS_CODE) {
          loading.value = false;
          loadFailed.value = true;
          return;
        }
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj != null) {
          const itemsRaw = dataObj["items"];
          if (itemsRaw != null) {
            const items = itemsRaw as UTSJSONObject[];
            for (let i = 0; i < items.length; i++) {
              const c = new GaCandidate();
              c.userId = readString(items[i], "userId");
              // AgentSearchItem 字段是 name/description（同 add-buddy-sheet readAgentRow 口径）
              const name = readString(items[i], "name");
              c.token = name.length > 0 ? name : `用户${c.userId}`;
              c.sub = readString(items[i], "description");
              c.avatar = readString(items[i], "avatar");
              if (c.userId.length > 0) {
                out.push(c);
              }
            }
          }
        }
      }
      candidates.value = out;
      searched.value = true;
      loading.value = false;
    } catch (_error) {
      loading.value = false;
      loadFailed.value = true;
    }
  }

  /**
   * 提交添加（AddMembersResult）：
   * applied>0 ⇒ 群开了入群审批，部分「人」被转成入群申请（按成功，文案提示已发申请）；
   * 智能体不走审批（直接入群）。空选择先提示。
   */
  async function handleSubmit(): Promise<void> {
    const ids = selectedIds.value;
    if (ids.length == 0) {
      uni.showToast({ title: t("Mobile.Message.groupAddNone"), icon: "none" });
      return;
    }
    if (submitting.value || convId.value.length == 0) {
      return;
    }
    submitting.value = true;
    try {
      const res = await apiImGroupAddMembers(convId.value, ids);
      if (apiResCode(res) == SUCCESS_CODE) {
        let applied = 0;
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj != null) {
          const appliedRaw = dataObj["applied"];
          if (appliedRaw != null) {
            const parsed = parseFloat(`${appliedRaw}`);
            if (!isNaN(parsed)) {
              applied = parsed;
            }
          }
        }
        uni.showToast({
          title: applied > 0 ? t("Mobile.Message.groupAddApplied") : t("Mobile.Message.groupAddDone"),
          icon: "none",
        });
        setTimeout(() => {
          uni.navigateBack({ delta: 1 });
        }, 400);
      } else {
        uni.showToast({ title: apiResMessage(res), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    }
    submitting.value = false;
  }

  function handleBack(): void {
    const pages = getCurrentPages();
    if (pages.length <= 1) {
      uni.switchTab({ url: "/pages/message/message" });
      return;
    }
    uni.navigateBack({ delta: 1 });
  }

  onLoad((options: any) => {
    convId.value = readOption(options, "convId");
    groupName.value = readOption(options, "name");
    loadExisting();
    // 智能体 tab 支持空关键词浏览全部：进页先出一版人搜索提示态，由用户触发搜索
  });
</script>

<style lang="scss" scoped>
