<template>
  <uni-modal-popup ref="popupRef" position="bottom" height="78%" :show-header="false" :body-scroll="false" @update-visible="handleVisibleChange">
    <view class="sheet" :class="avoidTabBar ? 'sheet--avoid-tab-bar' : ''">
      <view class="sheet-header">
        <view class="title-box">
          <text class="sheet-title">{{ t("Mobile.Nav.skill") }}</text>
          <text class="sheet-subtitle">{{ t("Mobile.Skill.capabilities") }}</text>
        </view>
        <view class="close-button" @click="close">
          <view class="close-line close-line--left" />
          <view class="close-line close-line--right" />
        </view>
      </view>

      <view class="tabs-row">
        <view class="tabs">
          <view class="tab" :class="source == 'enabled' ? 'tab--active' : ''" @click="source = 'enabled'">
            <text class="tab-text">{{ t("Mobile.Skill.enabled") }}</text>
            <view v-if="source == 'enabled'" class="tab-indicator" />
          </view>
          <view class="tab" :class="source == 'system' ? 'tab--active' : ''" @click="source = 'system'">
            <text class="tab-text">{{ t("Mobile.ExpertList.system") }}</text>
            <view v-if="source == 'system'" class="tab-indicator" />
          </view>
          <view class="tab" :class="source == 'team' ? 'tab--active' : ''" @click="source = 'team'">
            <text class="tab-text">{{ t("Mobile.ExpertList.team") }}</text>
            <view v-if="source == 'team'" class="tab-indicator" />
          </view>
        </view>
        <view class="search-toggle" @click="toggleSearch">
          <svg-icon name="icon-Search" size="38" color="#686878" />
        </view>
      </view>

      <view v-if="searchVisible" class="search-bar">
        <svg-icon name="icon-Search" size="32" color="#9999a3" />
        <input
          v-model="keyword"
          class="search-input"
          :placeholder="t('Mobile.Skill.searchSkillName')"
          confirm-type="search"
        />
        <svg-icon v-if="keyword.length > 0" name="icon-X" size="28" color="#9999a3" @click="keyword = ''" />
      </view>

      <skill-list-view
        class="sheet-list"
        :type="source"
        variant="default"
        :keyword="keyword"
        :page-size="20"
        @select="handleSelect"
        @enabledChange="handleEnabledChange"
      />
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { ref, watch, type ComponentPublicInstance } from "vue";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import SvgIcon from "@/components/svg-icon/svg-icon.uvue";
  import SkillListView from "@/components/skill-list-view/skill-list-view.uvue";
  import { type SkillListSourceType } from "@/types/interfaces/skillList";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const props = withDefaults(defineProps<{ visible: boolean; avoidTabBar?: boolean }>(), {
    visible: false,
    avoidTabBar: false,
  });
  const emit = defineEmits<{
    (e: "close"): void;
    (e: "select", item: UTSJSONObject): void;
    (e: "enabledChange", item: UTSJSONObject, enabled: boolean): void;
  }>();
  const popupRef = ref<any | null>(null);
  const source = ref<SkillListSourceType>("enabled");
  const searchVisible = ref<boolean>(false);
  const keyword = ref<string>("");

  function callPopup(method: string): void {
    if (popupRef.value != null) (popupRef.value as ComponentPublicInstance).$callMethod(method);
  }

  function close(): void {
    callPopup("close");
  }

  function handleVisibleChange(value: boolean): void {
    if (value != true) emit("close");
  }

  function toggleSearch(): void {
    searchVisible.value = !searchVisible.value;
    if (searchVisible.value != true) keyword.value = "";
  }

  function handleSelect(item: UTSJSONObject): void {
    emit("select", item);
    close();
  }

  function handleEnabledChange(item: UTSJSONObject, enabled: boolean): void {
    emit("enabledChange", item, enabled);
  }

  watch(
    (): boolean => props.visible,
    (value: boolean): void => {
      if (value) {
        source.value = "enabled";
        keyword.value = "";
        searchVisible.value = false;
        callPopup("open");
      } else {
        callPopup("close");
      }
    },
  );
</script>

<style scoped lang="scss">
  .sheet { display: flex; flex-direction: column; height: 100%; padding: 30rpx 32rpx 0; background-color: #ffffff; box-sizing: border-box; }
  /* #ifdef APP */
  .sheet--avoid-tab-bar { padding-bottom: 100rpx; }
  /* #endif */
  /* #ifdef H5 */
  .sheet--avoid-tab-bar { padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
  /* #endif */
  .sheet-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 4rpx; }
  .title-box { display: flex; flex-direction: column; }
  .sheet-title { color: #17171d; font-size: 36rpx; font-weight: 700; line-height: 48rpx; }
  .sheet-subtitle { margin-top: 4rpx; color: #94949e; font-size: 25rpx; line-height: 34rpx; letter-spacing: 1rpx; }
  .close-button { position: relative; width: 58rpx; height: 58rpx; }
  .close-line { position: absolute; left: 13rpx; top: 28rpx; width: 34rpx; height: 4rpx; border-radius: 999rpx; background-color: #8b8b96; }
  .close-line--left { transform: rotate(45deg); }
  .close-line--right { transform: rotate(-45deg); }
  .tabs-row { display: flex; flex-direction: row; align-items: flex-end; height: 92rpx; margin-top: 12rpx; border-bottom: 2rpx solid #f1f1f4; }
  .tabs { flex: 1; display: flex; flex-direction: row; align-items: flex-end; height: 92rpx; min-width: 0; }
  .tab { position: relative; display: flex; align-items: center; justify-content: center; height: 92rpx; margin-right: 38rpx; }
  .tab-text { color: #92929c; font-size: 29rpx; font-weight: 600; white-space: nowrap; }
  .tab--active .tab-text { color: #202027; }
  .tab-indicator { position: absolute; left: 0; right: 0; bottom: -2rpx; height: 6rpx; border-radius: 999rpx; background-color: #5b46ff; }
  .search-toggle { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 92rpx; }
  .search-bar { flex-shrink: 0; display: flex; flex-direction: row; align-items: center; height: 70rpx; margin: 18rpx 0 6rpx; padding: 0 20rpx; border-radius: 18rpx; background-color: #f5f5f8; box-sizing: border-box; }
  .search-input { flex: 1; height: 70rpx; margin: 0 14rpx; color: #25252d; font-size: 27rpx; }
  .sheet-list { flex: 1; min-height: 0; }
</style>
