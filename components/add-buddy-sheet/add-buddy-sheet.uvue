<template>
  <!--
    添加伙伴底部弹窗（双 tab，两种模式）：
    - 伙伴模式 open()（消息 tab 用）：
      - 「用户」：searchContacts 搜平台用户，附言随「加为联系人」发送（对方需同意）
      - 「智能体」：contactSearchAgents 搜已发布智能体，「加为联系人」直接生效
      - 「发消息」：convCreateP2p 建会话后跳转消息详情页
    - 群添加模式 openForGroup(convId)（群成员页用）：隐藏附言与发消息，多选批量「添加」
      走 convAddMembers（群开审批时转申请 applied>0 → 已发送入群申请）；选人 tag 盒
      （点盒展开下方常驻面板：contacts 按 subjectType 分桶、拼音字母序平铺，点行以 tag
      插回盒内；盒尾输入搜索，点结果同样插 tag 且保留关键词，清空回默认列表）；已在群内
      的行置灰不可选（打开时拉群成员比对）；未点盒时面板紧凑定高、展开后恒 75%
    - 伙伴模式打开不搜索，输入 400ms 防抖后才调接口（同创建群组）；未输入时面板紧凑
      定高、输入搜索后展开 75% 给结果列表，附言说明收进输入框 placeholder
    - 按钮区避让 home 条（sheetStyle）
  -->
  <uni-modal-popup
    ref="popupRef"
    position="bottom"
    :height="sheetHeight"
    :show-header="false"
    :body-scroll="false"
    :enable-swipe-close="true"
    @afterleave="handleAfterLeave"
  >
    <view class="buddy-sheet" :style="sheetStyle">
      <view class="buddy-sheet__header">
        <text class="buddy-sheet__title">{{
          groupConvId.length > 0 ? t("Mobile.Message.groupAddTitle") : t("Mobile.Message.addBuddy")
        }}</text>
        <view
          class="buddy-sheet__close"
          @click="handleCloseTapFallback"
          @touchstart="handleCloseTouchStart($event)"
          @touchend="handleCloseTouchEnd($event)"
          @touchcancel="handleCloseTouchEnd($event)"
        >
          <svg-icon name="icon-X" size="36" color="#8a8a8a" />
        </view>
      </view>

      <!-- tab：人 / 智能体（群模式多选时标题后括号计数=各自桶已选数；伙伴模式单选不显） -->
      <view class="buddy-sheet__tabs">
        <view class="buddy-sheet__tab" @click="switchTab('user')">
          <text
            class="buddy-sheet__tab-text"
            :class="{ 'buddy-sheet__tab-text--on': activeTab == 'user' }"
          >{{ t("Mobile.Message.buddyTabUser") }}<text v-if="groupConvId.length > 0 && userTabCount > 0" class="buddy-sheet__tab-count">({{ userTabCount }})</text></text>
          <view v-if="activeTab == 'user'" class="buddy-sheet__tab-line" />
        </view>
        <view class="buddy-sheet__tab" @click="switchTab('agent')">
          <text
            class="buddy-sheet__tab-text"
            :class="{ 'buddy-sheet__tab-text--on': activeTab == 'agent' }"
          >{{ t("Mobile.Message.buddyTabAgent") }}<text v-if="groupConvId.length > 0 && agentTabCount > 0" class="buddy-sheet__tab-count">({{ agentTabCount }})</text></text>
          <view v-if="activeTab == 'agent'" class="buddy-sheet__tab-line" />
        </view>
      </view>

      <view class="buddy-sheet__form">
        <view class="buddy-sheet__label-row">
          <text class="buddy-sheet__label">
            {{ activeTab == 'user' ? t("Mobile.Message.searchUserLabel") : t("Mobile.Message.searchAgentLabel") }}
          </text>
        </view>
        <!-- 群添加模式：选人 tag 盒（点盒展开下方常驻面板，点行/点结果均以 tag 插盒，
             保留关键词便于连续勾选；已选芯片点 × 移除） -->
        <view v-if="groupConvId.length > 0" class="buddy-sheet__tagbox" @click="focusTagInput">
          <view class="buddy-sheet__tagbox-main">
            <view
              v-for="m in selectedGroupMembers"
              :key="m.userId"
              class="buddy-sheet__tag"
              hover-class="buddy-sheet__tag--active"
              @click.stop="toggleGroupMember(m)"
            >
              <text class="buddy-sheet__tag-text">{{ m.displayName }}</text>
              <text class="buddy-sheet__tag-x">×</text>
            </view>
            <input
              class="buddy-sheet__tagbox-input"
              v-model="keyword"
              :focus="focusRequest"
              :placeholder="activeTab == 'user'
                ? t('Mobile.Message.searchUserPlaceholder')
                : t('Mobile.Message.searchAgentPlaceholder')"
              placeholder-class="buddy-sheet__ph"
              @focus="handleTagFocus"
              @blur="handleTagBlur"
            />
          </view>
          <view class="buddy-sheet__search-icon">
            <svg-icon name="icon-Search" size="28" color="#9a9aa2" />
          </view>
        </view>
        <!-- 伙伴模式：原搜索框（无面板常驻交互，输入搜索后面板才升高） -->
        <view v-else class="buddy-sheet__search">
          <input
            class="buddy-sheet__search-input"
            v-model="keyword"
            :placeholder="activeTab == 'user'
              ? t('Mobile.Message.searchUserPlaceholder')
              : t('Mobile.Message.searchAgentPlaceholder')"
            placeholder-class="buddy-sheet__ph"
          />
          <view class="buddy-sheet__search-icon">
            <svg-icon name="icon-Search" size="28" color="#9a9aa2" />
          </view>
        </view>

        <!-- 申请附言：仅伙伴模式的「用户」tab（智能体加联系人直接生效，群添加无需附言）；
             说明收进 placeholder -->
        <view v-if="activeTab == 'user' && groupConvId.length == 0" class="buddy-sheet__msg-box">
          <textarea
            class="buddy-sheet__msg-input"
            v-model="applyMessage"
            :maxlength="100"
            :placeholder="t('Mobile.Message.buddyRemarkPlaceholder')"
            placeholder-class="buddy-sheet__ph"
          />
          <text class="buddy-sheet__msg-count">{{ applyMessage.length }} / 100</text>
        </view>
      </view>

      <scroll-view
        class="buddy-sheet__list"
        direction="vertical"
        :show-scrollbar="false"
      >
        <!-- 群添加模式：面板未展开时收空（弹窗保持紧凑定高）；展开后 idle 态展示默认
             联系人/智能体（contacts 拉取、拼音字母序平铺，已在群内的行置灰）；伙伴模式
             idle 仍走原分支（留白，面板紧凑定高） -->
        <view v-if="groupConvId.length > 0 && !panelVisible" class="buddy-sheet__closed" />
        <view v-else-if="searchState == 'idle' && groupConvId.length > 0 && defaultState == 'loading'" class="buddy-sheet__state">
          <text class="buddy-sheet__state-text">{{ t("Mobile.Common.loading") }}</text>
        </view>
        <view v-else-if="searchState == 'idle' && groupConvId.length > 0 && defaultState == 'failed'" class="buddy-sheet__state" @click="loadDefaultContacts">
          <text class="buddy-sheet__state-text">{{ t("Mobile.Message.loadFailed") }}</text>
        </view>
        <view v-else-if="searchState == 'idle' && groupConvId.length > 0 && sortedDefaults.length == 0" class="buddy-sheet__state">
          <text class="buddy-sheet__state-text">{{ activeTab == 'user' ? t("Mobile.Message.emptyContact") : t("Mobile.Message.emptyAgentContact") }}</text>
        </view>
        <view v-else-if="searchState == 'idle' && groupConvId.length > 0" class="buddy-sheet__list-body">
          <view
            v-for="m in sortedDefaults"
            :key="m.userId"
            class="buddy-sheet__row"
            hover-class="buddy-sheet__row--active"
            @click="toggleGroupMember(m)"
          >
            <view class="buddy-sheet__avatar">
              <image
                v-if="m.avatarUrl.length > 0 && m.avatarFailed != true"
                class="buddy-sheet__avatar-img"
                :src="m.avatarUrl"
                mode="aspectFit"
                @error="handleAvatarError(m)"
              />
              <view
                v-else
                class="buddy-sheet__avatar-fallback"
                :style="{ backgroundImage: avatarGradient(m.displayName) }"
              >
                <text class="buddy-sheet__avatar-letter">{{ avatarLetter(m.displayName) }}</text>
              </view>
            </view>
            <view class="buddy-sheet__row-main">
              <text class="buddy-sheet__row-name text-ellipsis">{{ m.displayName }}</text>
              <text v-if="m.description.length > 0" class="buddy-sheet__row-desc text-ellipsis">
                {{ m.description }}
              </text>
            </view>
            <view
              v-if="isExistingMember(m)"
              class="buddy-sheet__in"
            >
              <text class="buddy-sheet__in-text">{{ t("Mobile.Message.groupAlreadyMember") }}</text>
            </view>
            <view
              v-else
              class="buddy-sheet__check"
              :class="{ 'buddy-sheet__check--on': isGroupSelected(m) }"
            >
              <svg-icon
                v-if="isGroupSelected(m)"
                name="icon-Check"
                size="24"
                color="#ffffff"
              />
            </view>
          </view>
        </view>
        <!-- 初始态（伙伴模式）：未输入不搜也不展示，列表区留白（面板此时为紧凑定高） -->
        <view v-else-if="searchState == 'loading'" class="buddy-sheet__state">
          <text class="buddy-sheet__state-text">{{ t("Mobile.Common.loading") }}</text>
        </view>
        <view v-else-if="searchState == 'failed'" class="buddy-sheet__state" @click="doSearchNow">
          <text class="buddy-sheet__state-text">{{ t("Mobile.Message.loadFailed") }}</text>
        </view>
        <!-- 智能体专属：平台侧不可用（契约 degraded=true 时 items 为空≠没有结果） -->
        <view v-else-if="searchState == 'unavailable'" class="buddy-sheet__state" @click="doSearchNow">
          <text class="buddy-sheet__state-text">{{ t("Mobile.Message.agentSearchUnavailable") }}</text>
        </view>
        <view v-else-if="searchState == 'done' && results.length == 0" class="buddy-sheet__state">
          <text class="buddy-sheet__state-text">{{ t("Mobile.AgentSearch.emptyResult") }}</text>
        </view>
        <view v-else class="buddy-sheet__list-body">
          <view
            v-for="m in results"
            :key="m.userId"
            class="buddy-sheet__row"
            hover-class="buddy-sheet__row--active"
            @click="handleResultRowTap(m)"
          >
            <view class="buddy-sheet__avatar">
              <image
                v-if="m.avatarUrl.length > 0 && m.avatarFailed != true"
                class="buddy-sheet__avatar-img"
                :src="m.avatarUrl"
                mode="aspectFit"
                @error="handleAvatarError(m)"
              />
              <view
                v-else
                class="buddy-sheet__avatar-fallback"
                :style="{ backgroundImage: avatarGradient(m.displayName) }"
              >
                <text class="buddy-sheet__avatar-letter">{{ avatarLetter(m.displayName) }}</text>
              </view>
            </view>
            <view class="buddy-sheet__row-main">
              <text class="buddy-sheet__row-name text-ellipsis">{{ m.displayName }}</text>
              <text v-if="m.description.length > 0" class="buddy-sheet__row-desc text-ellipsis">
                {{ m.description }}
              </text>
            </view>
            <view
              v-if="isExistingMember(m)"
              class="buddy-sheet__in"
            >
              <text class="buddy-sheet__in-text">{{ t("Mobile.Message.groupAlreadyMember") }}</text>
            </view>
            <view
              v-else
              class="buddy-sheet__check"
              :class="{ 'buddy-sheet__check--on': isResultRowChecked(m) }"
            >
              <svg-icon
                v-if="isResultRowChecked(m)"
                name="icon-Check"
                size="24"
                color="#ffffff"
              />
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="buddy-sheet__footer">
        <view class="buddy-sheet__btn" hover-class="buddy-sheet__btn-cancel--active" @click="close">
          <text class="buddy-sheet__btn-text buddy-sheet__btn-text--cancel">
            {{ t("Mobile.Common.cancel") }}
          </text>
        </view>
        <!-- 群添加模式：单个「添加」主按钮（convAddMembers） -->
        <view
          v-if="groupConvId.length > 0"
          class="buddy-sheet__btn buddy-sheet__btn--ok"
          :class="{ 'buddy-sheet__btn--disabled': busy }"
          hover-class="buddy-sheet__btn-ok--active"
          @click="handleGroupAdd"
        >
          <text class="buddy-sheet__btn-text buddy-sheet__btn-text--ok">
            {{ t("Mobile.Message.groupAddSubmit") }}
          </text>
        </view>
        <template v-else>
          <view
            class="buddy-sheet__btn buddy-sheet__btn--secondary"
            :class="{ 'buddy-sheet__btn--disabled': busy }"
            hover-class="buddy-sheet__btn-cancel--active"
            @click="handleAddContact"
          >
            <text class="buddy-sheet__btn-text buddy-sheet__btn-text--cancel">
              {{ t("Mobile.Message.addAsContact") }}
            </text>
          </view>
          <view
            class="buddy-sheet__btn buddy-sheet__btn--ok"
            :class="{ 'buddy-sheet__btn--disabled': busy }"
            hover-class="buddy-sheet__btn-ok--active"
            @click="handleSendMsg"
          >
            <text class="buddy-sheet__btn-text buddy-sheet__btn-text--ok">
              {{ t("Mobile.Message.sendMessage") }}
            </text>
          </view>
        </template>
      </view>
    </view>
  </uni-modal-popup>
</template>

<script setup lang="uts">
  import { computed, nextTick, onUnmounted, ref, watch, type ComponentPublicInstance } from "vue";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import { syncNativeTabBarState } from "@/utils/commonBusiness";
  import { ReliableTap } from "@/utils/reliableTap.uts";
  import { imAvatarDisplayUrl, resolveImAvatarDisplay } from "@/utils/imAvatarDisplay";
  import { cnFirstLetter } from "@/utils/cn-initials";
  import {
    apiImAddContact,
    apiImContacts,
    apiImConvMembers,
    apiImCreateP2pConversation,
    apiImGroupAddMembers,
    apiImSearchAgents,
    apiImSearchContacts,
  } from "@/servers/im";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const emit = defineEmits<{
    /** 群添加模式提交成功（convId：群成员页借此刷新成员列表） */
    added: [convId: string];
  }>();

  /** 搜索结果行（人 tab 与智能体 tab 共用；description 仅智能体有；
   *  avatarRaw 仅默认列表行用——搜索行走原直连口径不动；isAgent 供群模式
   *  tab 标题角标按桶计数——多选混选时用户/智能体 tab 各显各自数量）。 */
  class SheetBuddy {
    userId: string = "";
    displayName: string = "";
    avatarRaw: string = "";
    avatarUrl: string = "";
    avatarFailed: boolean = false;
    description: string = "";
    isAgent: boolean = false;
  }

  /** 头像字母底色渐变板（对齐消息页五色系）。 */
  const AVATAR_GRADIENTS: string[] = [
    "linear-gradient(to bottom right, #8f9bf0, #5a67d9)",
    "linear-gradient(to bottom right, #7fe0c8, #3fae94)",
    "linear-gradient(to bottom right, #f0c06a, #e0942e)",
    "linear-gradient(to bottom right, #7fb0f0, #4a7fd9)",
    "linear-gradient(to bottom right, #f0b06a, #e08a2e)",
  ];

  const popupRef = ref<any | null>(null);
  const tabBarHiddenBySheet = ref<boolean>(false);

  /** user=人 tab（searchContacts）| agent=智能体 tab（contactSearchAgents） */
  const activeTab = ref<string>("user");
  const keyword = ref<string>("");
  const applyMessage = ref<string>("");
  /** 搜索结果（仅当次关键字命中；初始不加载，输入才搜） */
  const results = ref<SheetBuddy[]>([]);
  /** idle=未输入 | loading | failed | unavailable(智能体平台侧挂) | done */
  const searchState = ref<string>("idle");
  /** 单选目标（人/智能体通用，按 userId 比对） */
  const selectedTarget = ref<SheetBuddy | null>(null);
  /** 加为联系人/发消息 互斥防重 */
  const busy = ref<boolean>(false);
  // ===== 群添加模式（openForGroup）：非空即群模式，隐藏附言/发消息、按钮换成「添加」 =====
  const groupConvId = ref<string>("");
  /** 群内已有成员 userId 集（打开时拉 members 比对，命中行置灰不可选）。 */
  const existingIds = ref<string[]>([]);
  /** 群模式默认列表（contacts）：用户/智能体两桶按 subjectType 分（打开即加载，搜索态隐藏不清） */
  const defaultUsers = ref<SheetBuddy[]>([]);
  const defaultAgents = ref<SheetBuddy[]>([]);
  /** 默认列表加载态：loading | ready | failed（与搜索态解耦） */
  const defaultState = ref<string>("loading");
  /** 默认列表加载防重入 */
  let defaultLoading = false;
  /** 群模式多选已选（独立于伙伴模式单选 selectedTarget，互不污染）；tag 芯片与批量提交都用它 */
  const selectedGroupMembers = ref<SheetBuddy[]>([]);
  /** 群模式选人面板：点 tag 盒展开后常驻，提交/关闭弹窗才结束 */
  const panelVisible = ref<boolean>(false);
  /** 程序化聚焦边沿驱动（chat.uvue focusChatInput 同款）：false → nextTick → true */
  const focusRequest = ref<boolean>(false);
  /** input 实际聚焦态（已聚焦时不再重复拉焦，避免边沿失效） */
  const inputFocused = ref<boolean>(false);
  /** 发消息成功后待跳转的会话（等弹窗完全收起再跳，避免弹层压在推入页上） */
  let pendingChatConvId = "";
  let pendingChatName = "";
  let pendingChatAvatar = "";
  /** 扫用户名片码预填场景：目标 userId 非空时，搜索结果命中即自动选中该行
   *  （用户仍可改选；未命中/未搜到不选，交用户手动挑）。 */
  let autoSelectUserId = "";
  /** 输入防抖定时器 + 搜索序号（旧请求晚归丢弃，防竞态串结果） */
  let searchDebounceTimer = -1;
  let searchSeq = 0;

  function callPopupMethod(methodName: string): void {
    const proxy = popupRef.value as ComponentPublicInstance | null;
    if (proxy == null) {
      return;
    }
    proxy.$callMethod(methodName);
  }

  /**
   * 底部安全距离（同 remark-sheet）：App 端样式表 env(safe-area-inset-bottom) 不可靠，
   * 内联把底部内边距改为 24rpx 基础 + 系统安全区（px），按钮避开 iPhone home 条；
   * H5/小程序走样式表 env()，不叠加。
   */
  const sheetStyle = computed((): string => {
    let style = "";
    // #ifdef APP
    try {
      const win = uni.getWindowInfo();
      const scale = win.windowWidth / 750;
      const basePx = scale > 0 ? Math.round(24 * scale) : 24;
      style = `padding-bottom: ${basePx + win.safeAreaInsets.bottom}px;`;
    } catch (_e) {
      style = "";
    }
    // #endif
    return style;
  });

  /**
   * 面板高度：群添加模式未点 tag 盒时紧凑定高（tag 盒 + 按钮区；openForGroup 同步
   * 复位 panelVisible 后才 open，首帧即紧凑值，进场动画期间不跳），点盒展开选人
   * 面板后恒 75% 不再随搜索态切换。伙伴模式：初始态（未输入）紧凑定高（内容高度 +
   * 底部安全区），输入搜索后展开 75% 给结果列表——避免未输入时附言框与底部按钮之间
   * 留大片空白。（popup 的 height 是响应式 prop，面板高度随状态切换）
   */
  const sheetHeight = computed((): string => {
    let safeRpx = 0;
    try {
      const win = uni.getWindowInfo();
      const scale = win.windowWidth / 750;
      if (scale > 0) {
        safeRpx = Math.ceil(win.safeAreaInsets.bottom / scale);
      }
    } catch (_e) {
      safeRpx = 0;
    }
    if (groupConvId.value.length > 0) {
      return panelVisible.value ? "75%" : `${460 + safeRpx}rpx`;
    }
    if (searchState.value != "idle") {
      return "75%";
    }
    // 用户 tab 内容含附言框（约 600rpx）；智能体 tab 无附言（约 460rpx）
    const base = activeTab.value == "user" ? 600 : 460;
    return `${base + safeRpx}rpx`;
  });

  /** 回初始态：清结果/清防抖定时器/序号自增（作废在途请求）。 */
  function resetSearchIdle(): void {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
    searchSeq++;
    searchState.value = "idle";
    results.value = [];
  }

  function readString(obj: UTSJSONObject, key: string): string {
    const raw = obj[key];
    return raw != null ? `${raw}` : "";
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const raw = obj[key];
    return raw != null && `${raw}` == "true";
  }

  function readNumber(obj: UTSJSONObject, key: string, fallback: number): number {
    const raw = obj[key];
    if (raw == null) {
      return fallback;
    }
    const parsed = parseFloat(`${raw}`);
    return isNaN(parsed) ? fallback : parsed;
  }

  /** 群添加模式：拉群内成员 userId 集（GET /conversations/{convId}/members），命中行置灰。 */
  async function loadExistingMembers(): Promise<void> {
    const conv = groupConvId.value;
    if (conv.length == 0) {
      return;
    }
    try {
      const res = await apiImConvMembers(conv);
      // 晚归守卫：期间弹窗已关/换了群，丢弃本次结果
      if (conv != groupConvId.value) {
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj == null) {
        return;
      }
      const recordsRaw = dataObj["records"];
      if (recordsRaw == null) {
        return;
      }
      const records = recordsRaw as UTSJSONObject[];
      const out: string[] = [];
      for (let i = 0; i < records.length; i++) {
        const id = readString(records[i], "userId");
        if (id.length > 0) {
          out.push(id);
        }
      }
      existingIds.value = out;
    } catch (_error) {
      // 静默：已有成员只是辅助置灰，拉不到不阻塞添加
    }
  }

  /** 默认列表响应行（contactList 的 ContactItem）：displayName 服务端已按
   *  remark > nickName > userName 算好，缺键时逐级回落（智联录同口径）。 */
  function readContactRow(item: UTSJSONObject): SheetBuddy | null {
    const row = new SheetBuddy();
    row.userId = readString(item, "userId");
    if (row.userId.length == 0) {
      return null;
    }
    const display = readString(item, "displayName");
    const nickName = readString(item, "nickName");
    row.displayName = display.length > 0 ? display : nickName;
    row.avatarRaw = readString(item, "avatar");
    // ContactItem 的 /api/f/ 受保护与远程 SVG 头像须走统一解析（搜索行维持原直连口径不动）
    row.avatarUrl = imAvatarDisplayUrl(row.avatarRaw, 72);
    return row;
  }

  /** 批量解析默认列表头像展示地址。★须在对应 ref 数组 .value 赋值后调、传 ref 数组
   * 本身（响应式代理实例），异步写回才会触发渲染刷新（imAvatarDisplay 接入姿势）。 */
  function resolveDefaultAvatars(rows: SheetBuddy[]): void {
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      const raw = row.avatarRaw;
      if (raw.length == 0 || row.avatarUrl.length > 0) {
        continue;
      }
      resolveImAvatarDisplay(raw, 72).then((resolved: string) => {
        if (resolved != raw && resolved != row.avatarUrl) {
          row.avatarUrl = resolved;
          row.avatarFailed = false; // 首帧失败可能已标死字母兜底，解析成功救回
        }
      });
    }
  }

  /**
   * 群模式默认列表：拉当前用户联系人（contactList），status=1（已互为联系人）才收
   * （2/3 待确认态混进来会导致加群提交无权限目标），subjectType=1 进用户桶、其余进
   * 智能体桶。stale-while-revalidate：已有数据时后台刷新不闪 loading，两桶皆空才
   * 显示加载态；晚归守卫（弹窗已关/切伙伴模式/换群丢弃）。
   */
  async function loadDefaultContacts(): Promise<void> {
    if (defaultLoading) {
      return;
    }
    defaultLoading = true;
    const firstLoad = defaultUsers.value.length == 0 && defaultAgents.value.length == 0;
    if (firstLoad) {
      defaultState.value = "loading";
    }
    const mode = groupConvId.value;
    try {
      const res = await apiImContacts();
      // 晚归守卫：期间弹窗已关/切伙伴模式/换群，丢弃本次结果
      if (mode != groupConvId.value) {
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        // 已有旧数据时静默保留（下次打开再刷）；首拉失败才出可点击重试态
        if (firstLoad) {
          defaultState.value = "failed";
        }
        return;
      }
      const users: SheetBuddy[] = [];
      const agents: SheetBuddy[] = [];
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const item = items[i];
            if (readNumber(item, "status", 1) != 1) {
              continue;
            }
            const row = readContactRow(item);
            if (row == null) {
              continue;
            }
            if (readNumber(item, "subjectType", 1) == 1) {
              users.push(row);
            } else {
              row.isAgent = true;
              agents.push(row);
            }
          }
        }
      }
      // ★先落 ref 再解析头像：异步写回只有 ref 数组内代理实例才触发重渲
      defaultUsers.value = users;
      defaultAgents.value = agents;
      resolveDefaultAvatars(defaultUsers.value);
      resolveDefaultAvatars(defaultAgents.value);
      defaultState.value = "ready";
    } catch (e) {
      if (mode == groupConvId.value && firstLoad) {
        defaultState.value = "failed";
      }
    } finally {
      defaultLoading = false;
    }
  }

  /**
   * 群模式默认列表拼音字母序（@选择页 groups 同款口径，平铺不渲染字母头）：首字母
   * 分桶 → A-Z 升序、# 末尾 → 桶内按显示名纯字符串比较 → 顺序连接。
   */
  const sortedDefaults = computed((): SheetBuddy[] => {
    const buckets = new Map<string, SheetBuddy[]>();
    const keys: string[] = [];
    const all = activeTab.value == "agent" ? defaultAgents.value : defaultUsers.value;
    for (let i = 0; i < all.length; i++) {
      const m = all[i];
      const letter = cnFirstLetter(m.displayName);
      let bucket = buckets.get(letter);
      if (bucket == null) {
        bucket = [];
        buckets.set(letter, bucket);
        keys.push(letter);
      }
      bucket.push(m);
    }
    const azKeys: string[] = [];
    let hasHash = false;
    for (let i = 0; i < keys.length; i++) {
      if (keys[i] == "#") {
        hasHash = true;
      } else {
        azKeys.push(keys[i]);
      }
    }
    azKeys.sort((a: string, b: string): number => (a < b ? -1 : a > b ? 1 : 0));
    if (hasHash) {
      azKeys.push("#");
    }
    const out: SheetBuddy[] = [];
    for (let i = 0; i < azKeys.length; i++) {
      const bucket = buckets.get(azKeys[i]);
      if (bucket == null) {
        continue;
      }
      bucket.sort((a: SheetBuddy, b: SheetBuddy): number => (a.displayName < b.displayName ? -1 : a.displayName > b.displayName ? 1 : 0));
      for (let j = 0; j < bucket.length; j++) {
        out.push(bucket[j]);
      }
    }
    return out;
  });

  /** tab 标题角标（仅群模式多选有意义）：已选里用户/智能体各自数量，
   *  跨 tab 混选分桶计数、随 tag 增删联动；伙伴模式单选不渲染（模板守卫）。 */
  const userTabCount = computed((): number => {
    let n = 0;
    const sel = selectedGroupMembers.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].isAgent != true) {
        n++;
      }
    }
    return n;
  });

  const agentTabCount = computed((): number => {
    let n = 0;
    const sel = selectedGroupMembers.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].isAgent == true) {
        n++;
      }
    }
    return n;
  });

  /** 群添加模式：该结果是否已在群内（置灰 + 不可选，替代选择圈）。 */
  function isExistingMember(m: SheetBuddy): boolean {
    if (groupConvId.value.length == 0) {
      return false;
    }
    const ids = existingIds.value;
    for (let i = 0; i < ids.length; i++) {
      if (ids[i] == m.userId) {
        return true;
      }
    }
    return false;
  }

  /** 打开添加伙伴弹窗：重置表单（初始不搜索、不展示，输入才搜）。 */
  function open(): void {
    groupConvId.value = "";
    existingIds.value = [];
    activeTab.value = "user";
    keyword.value = "";
    autoSelectUserId = "";
    applyMessage.value = "";
    results.value = [];
    selectedTarget.value = null;
    // 群模式残留卫生复位（正常流程 close 后重开必经 openForGroup，双保险）
    panelVisible.value = false;
    resetSearchIdle();
    // 系统 TabBar 是独立原生层，页面内弹窗无法用 z-index 覆盖，先隐藏、关闭时恢复
    tabBarHiddenBySheet.value = true;
    uni.hideTabBar({
      animation: false,
      complete: () => {
        callPopupMethod("open");
      },
    });
  }

  /**
   * 预填关键字打开（扫用户名片码拉起）：open() 重置后赋值 keyword，
   * 现有 watch(keyword) 400ms 防抖自动搜索；userId 非空时结果命中即自动选中
   * （QR 已锁定具体用户，免得用户漏点行而「请先选择搜索结果」）。
   */
  function openWithKeyword(kw: string, userId: string): void {
    open();
    const trimmed = kw.trim();
    if (trimmed.length > 0) {
      keyword.value = trimmed;
    }
    autoSelectUserId = userId.trim();
  }

  /**
   * 群添加模式（群成员页用）：隐藏附言与「发消息」，选人 tag 盒多选，提交走
   * convAddMembers 批量（群开审批时转申请）。★宿主是非 tabBar 页，
   * 跳过 hideTabBar（隐藏后导航返回会残留）。打开即后台预载当前用户联系人/
   * 智能体（拼音字母序），点 tag 盒才展开面板；已在群内的行打开时拉取置灰。
   */
  function openForGroup(conv: string): void {
    groupConvId.value = conv;
    existingIds.value = [];
    activeTab.value = "user";
    keyword.value = "";
    autoSelectUserId = "";
    applyMessage.value = "";
    results.value = [];
    selectedTarget.value = null;
    selectedGroupMembers.value = [];
    panelVisible.value = false;
    focusRequest.value = false;
    inputFocused.value = false;
    resetSearchIdle();
    loadExistingMembers();
    loadDefaultContacts();
    callPopupMethod("open");
  }

  /** 关闭弹窗：作废未发出的防抖搜索与在途请求（列表保留到收起动画结束）。 */
  function close(): void {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
    searchSeq++;
    callPopupMethod("close");
  }

  // ===== 关闭键点按三通道（三星 One UI 弹层内按压带微移不合成 click——关闭键
  //       点了没反应/面板闪动即此症；统一封装 utils/reliableTap.uts）=====
  const closeTap = new ReliableTap(12);

  /** ★须定义在 close 之后（UTS 无提升，前向引用报 error18）。 */
  function handleCloseTouchStart(eventValue: Any): void {
    closeTap.touchStart(eventValue);
  }

  /** 主通道：touchend/touchcancel 同权（原生下滑手势抢占触摸时抬手收到 cancel）。 */
  function handleCloseTouchEnd(eventValue: Any): void {
    if (closeTap.touchEnd(eventValue)) {
      close();
    }
  }

  /** @click 兜底（H5 桌面无触摸；App 上紧随 touchend 的合成 click 由防重窗吞）。 */
  function handleCloseTapFallback(): void {
    if (closeTap.clickFallback()) {
      close();
    }
  }

  /** 切 tab：数据源不同，搜索关键字/结果/选中目标全部重置（附言保留）。 */
  function switchTab(tab: string): void {
    if (activeTab.value == tab) {
      return;
    }
    activeTab.value = tab;
    keyword.value = "";
    results.value = [];
    selectedTarget.value = null;
    resetSearchIdle();
  }

  function restoreTabBar(): void {
    if (tabBarHiddenBySheet.value != true) {
      return;
    }
    tabBarHiddenBySheet.value = false;
    syncNativeTabBarState();
  }

  /** 人 tab 结果行：ContactSearchItem 无 displayName，按 nickName > userName 回落。 */
  function readUserRow(item: UTSJSONObject): SheetBuddy | null {
    const row = new SheetBuddy();
    row.userId = readString(item, "userId");
    if (row.userId.length == 0) {
      return null;
    }
    const nickName = readString(item, "nickName");
    row.displayName = nickName.length > 0 ? nickName : readString(item, "userName");
    row.avatarUrl = readString(item, "avatar");
    return row;
  }

  /** 智能体 tab 结果行：AgentSearchItem 的 name/description/avatar。 */
  function readAgentRow(item: UTSJSONObject): SheetBuddy | null {
    const row = new SheetBuddy();
    row.userId = readString(item, "userId");
    if (row.userId.length == 0) {
      return null;
    }
    row.displayName = readString(item, "name");
    row.description = readString(item, "description");
    row.avatarUrl = readString(item, "avatar");
    row.isAgent = true;
    return row;
  }

  /** 用当前关键字立即搜索（防抖到期或失败重试触发），按 tab 走对应接口。 */
  async function doSearchNow(): Promise<void> {
    const kw = keyword.value.trim();
    if (kw.length == 0) {
      resetSearchIdle();
      return;
    }
    const tab = activeTab.value;
    const seq = ++searchSeq;
    searchState.value = "loading";
    try {
      const res = tab == "agent"
        ? await apiImSearchAgents(kw, 1, 20)
        : await apiImSearchContacts(kw, 20);
      // 期间又有新输入/切 tab/关闭：本请求作废，不覆盖新状态
      if (seq != searchSeq || tab != activeTab.value) {
        return;
      }
      if (apiResCode(res) != SUCCESS_CODE) {
        searchState.value = "failed";
        return;
      }
      const rows: SheetBuddy[] = [];
      let degraded = false;
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        degraded = readBool(dataObj, "degraded");
        const itemsRaw = dataObj["items"];
        if (itemsRaw != null) {
          const items = itemsRaw as UTSJSONObject[];
          for (let i = 0; i < items.length; i++) {
            const row = tab == "agent" ? readAgentRow(items[i]) : readUserRow(items[i]);
            if (row != null) {
              rows.push(row);
            }
          }
        }
      }
      // 智能体契约：degraded=true ⇒ 平台不可用且 items 为空（≠没有结果），单独提示
      if (tab == "agent" && degraded) {
        searchState.value = "unavailable";
        return;
      }
      results.value = rows;
      searchState.value = "done";
      // 扫码预填场景：结果命中目标 userId 即自动选中（人 tab；未命中保持手选）
      if (autoSelectUserId.length > 0 && tab == "user") {
        for (let i = 0; i < rows.length; i++) {
          if (rows[i].userId == autoSelectUserId) {
            selectedTarget.value = rows[i];
            autoSelectUserId = "";
            break;
          }
        }
      }
    } catch (e) {
      if (seq == searchSeq && tab == activeTab.value) {
        searchState.value = "failed";
      }
    }
  }

  /** 输入防抖 400ms：停顿后才发请求（连打只发最后一次）；清空立即回初始态。 */
  watch(keyword, (val: string) => {
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
    if (val.trim().length == 0) {
      resetSearchIdle();
      return;
    }
    searchDebounceTimer = setTimeout(() => {
      searchDebounceTimer = -1;
      doSearchNow();
    }, 400);
  });

  function isSelectedTarget(m: SheetBuddy): boolean {
    const sel = selectedTarget.value;
    return sel != null && sel.userId == m.userId;
  }

  /** 单选：再点同一行取消，点别行换目标。 */
  function toggleTarget(m: SheetBuddy): void {
    if (isExistingMember(m)) {
      return;
    }
    if (isSelectedTarget(m)) {
      selectedTarget.value = null;
    } else {
      selectedTarget.value = m;
    }
  }

  /** 群添加模式：行是否已选入 tag 盒（多选）。 */
  function isGroupSelected(m: SheetBuddy): boolean {
    const sel = selectedGroupMembers.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].userId == m.userId) {
        return true;
      }
    }
    return false;
  }

  /** 群添加模式多选：再点同一行取消（tag 芯片 × 同走这里），重建数组赋值触发重渲。 */
  function toggleGroupMember(m: SheetBuddy): void {
    if (isExistingMember(m)) {
      return;
    }
    const next: SheetBuddy[] = [];
    let removed = false;
    const sel = selectedGroupMembers.value;
    for (let i = 0; i < sel.length; i++) {
      if (sel[i].userId == m.userId) {
        removed = true;
      } else {
        next.push(sel[i]);
      }
    }
    if (removed != true) {
      next.push(m);
    }
    selectedGroupMembers.value = next;
  }

  /** 搜索结果行点按分发（双模式共享分支）：群添加→多选 | 伙伴→单选。 */
  function handleResultRowTap(m: SheetBuddy): void {
    if (groupConvId.value.length > 0) {
      toggleGroupMember(m);
    } else {
      toggleTarget(m);
    }
  }

  /** 搜索结果行勾选态分发：群添加→多选数组 | 伙伴→单选目标。 */
  function isResultRowChecked(m: SheetBuddy): boolean {
    if (groupConvId.value.length > 0) {
      return isGroupSelected(m);
    }
    return isSelectedTarget(m);
  }

  /** 群模式点 tag 盒（任意空白处）：展开面板 + 未聚焦时边沿驱动拉起键盘。 */
  function focusTagInput(): void {
    panelVisible.value = true;
    if (inputFocused.value) {
      return;
    }
    focusRequest.value = false;
    nextTick((): void => {
      focusRequest.value = true;
    });
  }

  /** 群模式 input 原生聚焦：记录聚焦态 + 展开面板（直接点 input 本体的双保险）。 */
  function handleTagFocus(): void {
    inputFocused.value = true;
    if (groupConvId.value.length > 0) {
      panelVisible.value = true;
    }
  }

  /** input 失焦：只复位聚焦边沿，面板常驻不收（重点盒空白可再拉键盘）。 */
  function handleTagBlur(): void {
    inputFocused.value = false;
    focusRequest.value = false;
  }

  function handleAvatarError(m: SheetBuddy): void {
    m.avatarFailed = true;
  }

  function avatarLetter(name: string): string {
    const trimmed = name.trim();
    if (trimmed.length == 0) {
      return "#";
    }
    return trimmed.charAt(0).toUpperCase();
  }

  function avatarGradient(name: string): string {
    let sum = 0;
    for (let i = 0; i < name.length; i++) {
      const code = name.charCodeAt(i);
      if (code == null) continue;
      sum += code;
    }
    return AVATAR_GRADIENTS[sum % AVATAR_GRADIENTS.length];
  }

  /**
   * 加为联系人（contactAdd）：
   * - 人 tab 附言随申请发送（对方需 accept）；智能体无附言、服务端直接生效
   * - 按 ContactAddResult 的 alreadyContact / accepted 决定文案
   */
  async function handleAddContact(): Promise<void> {
    if (busy.value) {
      return;
    }
    const target = selectedTarget.value;
    if (target == null) {
      uni.showToast({ title: t("Mobile.Message.selectTargetFirst"), icon: "none" });
      return;
    }
    busy.value = true;
    try {
      const msg = activeTab.value == "user" ? applyMessage.value.trim() : "";
      const res = await apiImAddContact(target.userId, msg);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.addContactFailed"), icon: "none" });
        return;
      }
      let accepted = false;
      let alreadyContact = false;
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      if (dataObj != null) {
        accepted = readBool(dataObj, "accepted");
        alreadyContact = readBool(dataObj, "alreadyContact");
      }
      let title = t("Mobile.Message.contactRequestSent");
      if (alreadyContact) {
        title = t("Mobile.Message.alreadyContact");
      } else if (accepted) {
        title = t("Mobile.Message.contactAdded");
      }
      uni.showToast({ title, icon: "none" });
      close();
    } catch (e) {
      uni.showToast({ title: t("Mobile.Message.addContactFailed"), icon: "none" });
    } finally {
      busy.value = false;
    }
  }

  /** 发消息：convCreateP2p（幂等）建/取会话，关弹窗后跳消息详情页。 */
  async function handleSendMsg(): Promise<void> {
    if (busy.value) {
      return;
    }
    const target = selectedTarget.value;
    if (target == null) {
      uni.showToast({ title: t("Mobile.Message.selectTargetFirst"), icon: "none" });
      return;
    }
    busy.value = true;
    try {
      const res = await apiImCreateP2pConversation(target.userId);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
        return;
      }
      const dataRaw = apiResData<any>(res);
      const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
      const convId = dataObj != null ? readString(dataObj, "convId") : "";
      if (convId.length == 0) {
        uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
        return;
      }
      pendingChatConvId = convId;
      pendingChatName = target.displayName;
      pendingChatAvatar = target.avatarUrl;
      close();
    } catch (e) {
      uni.showToast({ title: t("Mobile.Message.openChatFailed"), icon: "none" });
    } finally {
      busy.value = false;
    }
  }

  /**
   * 群添加模式提交（convAddMembers，tag 盒多选批量提交）：
   * - 与伙伴模式的 contactAdd 是不同链路：群成员走批量 members 端点，无需对方同意
   * - 群开「入群审批」时服务端转申请：AddMembersResult.applied>0 → 「已发送入群申请」
   * - 智能体不走审批直接入群；int64 userId 已是字符串，服务端接口层拼原始字面量
   */
  async function handleGroupAdd(): Promise<void> {
    if (busy.value) {
      return;
    }
    const sel = selectedGroupMembers.value;
    if (sel.length == 0) {
      uni.showToast({ title: t("Mobile.Message.groupAddNone"), icon: "none" });
      return;
    }
    const conv = groupConvId.value;
    if (conv.length == 0) {
      return;
    }
    busy.value = true;
    try {
      const ids: string[] = [];
      for (let i = 0; i < sel.length; i++) {
        ids.push(sel[i].userId);
      }
      const res = await apiImGroupAddMembers(conv, ids);
      if (apiResCode(res) == SUCCESS_CODE) {
        let applied = 0;
        const dataRaw = apiResData<any>(res);
        const dataObj = dataRaw != null ? (dataRaw as UTSJSONObject) : null;
        if (dataObj != null) {
          const appliedRaw = dataObj["applied"];
          if (appliedRaw != null) {
            const parsed = parseFloat(`${appliedRaw}`);
            if (!isNaN(parsed)) {
              applied = parsed;
            }
          }
        }
        uni.showToast({
          title: applied > 0 ? t("Mobile.Message.groupAddApplied") : t("Mobile.Message.groupAddDone"),
          icon: "none",
        });
        emit("added", conv);
        close();
      } else {
        const failMsg = apiResMessage(res);
        uni.showToast({ title: failMsg.length > 0 ? failMsg : t("Mobile.Common.operationFailed"), icon: "none" });
      }
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Common.operationFailed"), icon: "none" });
    } finally {
      busy.value = false;
    }
  }

  /** 弹窗完全收起：恢复 tabBar，再跳转消息详情页。 */
  function handleAfterLeave(): void {
    restoreTabBar();
    if (pendingChatConvId.length == 0) {
      return;
    }
    const convId = pendingChatConvId;
    const name = pendingChatName;
    const avatar = pendingChatAvatar;
    pendingChatConvId = "";
    pendingChatName = "";
    pendingChatAvatar = "";
    uni.navigateTo({
      url:
        `/pages/message/chat?convId=${convId}&convType=1` +
        `&name=${encodeURIComponent(name)}&avatar=${encodeURIComponent(avatar)}`,
    });
  }

  defineExpose({
    open: open as any,
    openWithKeyword: openWithKeyword as any,
    openForGroup: openForGroup as any,
    close: close as any,
  });

  onUnmounted(() => {
    restoreTabBar();
    if (searchDebounceTimer != -1) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = -1;
    }
  });
</script>

