<template>
  <!-- #ifndef APP -->
  <text class="iconfont" :class="[icon, extraClass]"><slot /></text>
  <!-- #endif -->
  <!-- #ifdef APP -->
  <text class="iconfont" :class="extraClass">{{ glyph }}</text>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { computed } from 'vue';
  import { getIconUnicode } from '@/constants/iconfont.constants.uts';

  interface Props {
    /** iconfont 类名，如 icon-a-Chevronright */
    icon: string;
    /** 附加样式类名 */
    extraClass?: string;
  }

  const props = withDefaults(defineProps<Props>(), {
    extraClass: '',
  });

  const glyph = computed((): string => {
    return getIconUnicode(props.icon);
  });
</script>
