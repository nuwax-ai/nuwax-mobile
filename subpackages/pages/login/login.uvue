<template>
  <login-layout
    :title="tenantConfigSiteName"
    :logo="tenantConfigSiteLogo"
  >
    <!-- 表单登录 -->
    <login-form
      v-if="!loading"
      v-show="currentFormType === 'login'"
      :tenantConfigInfo="tenantConfigInfo"
      :siteName="tenantConfigSiteName"
      @show-verify="handleShowVerify"
      :redirectUrl="redirectUrl"
    />

    <!-- 验证码登录 -->
    <captcha-verify
      v-if="currentFormType === 'verify'"
      :phoneOrEmail="phoneOrEmail"
      :tenantConfigInfo="tenantConfigInfo"
      @verify-login="handleLoginByCode"
      @back="handleBack"
    />

    <!-- 修改密码 -->
    <reset-password v-show="currentFormType === 'reset'" @back="handleBack" />
  </login-layout>
</template>

<script setup lang="uts">
  import LoginLayout from "./components/login-layout/login-layout.uvue";
  import { ref, computed } from "vue";
  import { SUCCESS_CODE, AGENT_NOT_EXIST } from "@/constants/codes.constants";
  import { ACCESS_TOKEN, EXPIRE_DATE } from "@/constants/home.constants";
  import {
    apiTenantConfig,
    apiLoginCode,
  } from "@/servers/account";
  import { CodeLogin, type TenantConfigInfo } from "@/types/interfaces/login";
  import CaptchaVerify from "./components/captcha-verify/captcha-verify.uvue";
  import LoginForm from "./components/login-form/login-form.uvue";
  import ResetPassword from "./components/reset-password/reset-password.uvue";
  import { redirectTo } from "@/utils/common.uts";
  import { useI18n } from "@/utils/i18n";
  import { apiResCode, apiResData, apiResMessage } from "@/utils/apiResponse";
  import type { RequestResponse } from "@/types/interfaces/request";

  const { t, ensureLangList } = useI18n();

  // 当前显示 form 表单类型登录-login/验证码-verify/修改密码-reset
  const currentFormType = ref<string>("login");
  // 手机号
  const phoneOrEmail = ref<string>("");
  const captchaVerifyParam = ref<string>(""); // 阿里云验证码参数
  const redirectUrl = ref<string>("");
  const tenantConfigInfo = ref<any | null>(null); // 配置信息

  const tenantConfigSiteName = computed((): string => {
    const tc = tenantConfigInfo.value;
    if (tc == null) return "";
    const obj = tc as UTSJSONObject;
    const raw = obj["siteName"];
    return raw != null ? `${raw}` : "";
  });

  const tenantConfigSiteLogo = computed((): string => {
    const tc = tenantConfigInfo.value;
    if (tc == null) return "";
    const obj = tc as UTSJSONObject;
    const raw = obj["siteLogo"];
    return raw != null ? `${raw}` : "";
  });

  // 加载中
  const loading = ref(false);
  // 获取用户配置
  const fetchTenantConfig = async () => {
    try {
      loading.value = true;
      const res = await apiTenantConfig();
      const code = apiResCode(res);
      const data = apiResData<any>(res);
      if (code == SUCCESS_CODE && data != null) {
        const dataObj = data as UTSJSONObject;
        const siteNameVal = dataObj["siteName"];
        const siteName = siteNameVal != null ? `${siteNameVal}` : "";
        if (siteName.length > 0) {
          tenantConfigInfo.value = data;
          uni.setNavigationBarTitle({ title: siteName });
        }
      }
    } finally {
      loading.value = false;
    }
  };

  // 登录成功后
  // Android：data 是 UTSJSONObject，禁止 apiResData<ILoginResult>（ClassCastException）
  const handleLoginSuccess = (result: RequestResponse<any> | null) => {
    const code = apiResCode(result);
    const message = apiResMessage(result);
    const dataRaw = apiResData<any>(result);
    // 登录失败
    if (code == AGENT_NOT_EXIST) {
      uni.showToast({
        title: message,
        icon: "none",
      });
      return;
    }

    // 登录成功
    if (code == SUCCESS_CODE && dataRaw != null) {
      const data = dataRaw as UTSJSONObject;
      const tokenRaw = data["token"];
      const token = tokenRaw != null ? `${tokenRaw}` : "";
      // #ifdef H5 || WEB
      if (process.env.NODE_ENV == "development") {
        uni.setStorageSync(ACCESS_TOKEN, token);
      }
      // #endif

      // #ifdef MP-WEIXIN || APP
      uni.setStorageSync(ACCESS_TOKEN, token);
      // #endif

      // 判断是否已经修改过密码 0-未修改/1-已修改
      const resetPassRaw = data["resetPass"];
      const resetPass = resetPassRaw != null ? parseFloat(`${resetPassRaw}`) : 1;
      if (resetPass == 0) {
        currentFormType.value = "reset";
        return;
      }
      // 验证码登录
      uni.showToast({
        title: t("Mobile.Auth.loginSuccess"),
        icon: "success",
      });
      setTimeout(() => {
        redirectTo(redirectUrl.value);
      }, 1000);
    }
  };

  // 登录
  const handleShowVerify = async (value: string, captcha: string) => {
    currentFormType.value = "verify";
    phoneOrEmail.value = value;
    captchaVerifyParam.value = captcha;
  };
  // 返回登录
  const handleBack = () => {
    currentFormType.value = "login";
  };
  // 验证码输入完成登录
  const handleLoginByCode = async (verifyCode: string) => {
    const params = new CodeLogin();
    params.phone = phoneOrEmail.value;
    params.code = verifyCode;
    const result = await apiLoginCode(params);
    handleLoginSuccess(result);
  };

  onLoad((query: any) => {
    const q = query as UTSJSONObject;
    const redirectRaw = q["redirect"];
    const redirectVal = redirectRaw != null ? `${redirectRaw}` : "";
    if (redirectVal.length > 0) {
      // 免跳转白名单
      const whiteList = ["/subpackages/pages/temporary-session/temporary-session"];
      const decodedRaw = decodeURIComponent(redirectVal);
      const redirect = decodedRaw != null ? decodedRaw : redirectVal;
      if (!whiteList.includes(redirect)) {
        redirectUrl.value = redirect;
      } else {
        redirectUrl.value = "/pages/index/index";
      }
    }
  });

  onMounted(() => {
    fetchTenantConfig();
    // #ifdef H5
    ensureLangList();
    // #endif
  });
</script>

<style lang="scss" scoped></style>
