/**
 * 前台会议邀请条：App 在前台收到 meeting_invite 时，在全局顶部展示一条可加入/忽略的邀请。
 *
 * 设计要点：
 * - 后台/熄屏/进程被杀不依赖这里，交给原生来电通道；
 * - 模块级 ref + Set 去重，页面只挂一个零绑定组件，不把状态塞进 chat.uvue（模板参数上限）；
 * - 加入/忽略后由组件回写 meeting-invite-handled，并保留 inviteId 去重，避免 WS/推送重复弹。
 *
 * ★挂载点必须是「每一个可能位于栈顶的页面」，不是只挂 tab-shell：
 *   uni-app x 没有 App 级浮层，tab-shell 上的实例会被栈顶子页整页盖住（其 onHide 还会
 *   停铃），所以 chat.uvue 与 subpackages/pages/im-meeting/* 各页都自挂一份。
 *   新增「会长期停留、收邀请要能看见」的页面时，记得补一行 <meeting-invite-banner />，
 *   否则表现为「在该页收不到邀请通知，回首页才补弹」。
 */
import { ref } from "vue";

export const meetingInviteBanner = ref<UTSJSONObject | null>(null);

const seen = new Set<string>();
const handledMessageIds = new Set<string>();

/**
 * inviteId 为空的邀请不展示；同一条邀请只展示一次。
 * ★后来者覆盖：之前是「先到先得」，上一条没被忽略/没到 60 秒自动收起时，
 *   后面所有邀请都会被静默丢掉（真机表现：前台完全收不到参会提醒）。
 *   现在按最新一条展示，旧的直接被替换。
 */
export function showMeetingInviteBanner(value: UTSJSONObject): void {
  const inviteId = `${value["inviteId"] ?? ""}`;
  const msgId = `${value["msgId"] ?? ""}`;
  if (inviteId.length == 0 || seen.has(inviteId) || (msgId.length > 0 && handledMessageIds.has(msgId))) return;
  seen.add(inviteId);
  meetingInviteBanner.value = value;
}

/** 不传 inviteId 时直接收起当前条；传入时只在同一条邀请上生效。 */
export function hideMeetingInviteBanner(inviteId: string = ""): void {
  const current = meetingInviteBanner.value;
  if (current == null) return;
  if (inviteId.length > 0 && `${current["inviteId"] ?? ""}` != inviteId) return;
  meetingInviteBanner.value = null;
}

/** 跨端已处理事件优先按 msgId 匹配，缺失时再按 inviteId。 */
export function hideHandledMeetingInviteBanner(msgId: string, inviteId: string): void {
  if (msgId.length > 0) handledMessageIds.add(msgId);
  if (inviteId.length > 0) seen.add(inviteId);
  const current = meetingInviteBanner.value;
  if (current == null) return;
  const currentMsgId = `${current["msgId"] ?? ""}`;
  const currentInviteId = `${current["inviteId"] ?? ""}`;
  const matched = (msgId.length > 0 && currentMsgId.length > 0 && currentMsgId == msgId) ||
    (inviteId.length > 0 && currentInviteId == inviteId);
  if (!matched) return;
  meetingInviteBanner.value = null;
}

/**
 * 本端已进入某场会议时收起同房间的邀请条。
 *
 * 聊天卡片、聊天里的邀请链接、「加入会议」页等入口手里没有 inviteId/msgId，
 * 只能按房间匹配；不收起的话，进会后顶部邀请条会一直挂着（最长 60 秒）并继续响铃。
 * 当前条被收起时顺手记入去重集合，避免同一条邀请再从 WS/推送重复弹。
 */
export function hideMeetingInviteBannerForRoom(room: string): void {
  const key = room.trim();
  if (key.length == 0) return;
  const current = meetingInviteBanner.value;
  if (current == null) return;
  const currentRoom = `${current["roomName"] ?? ""}`.trim();
  if (currentRoom.length == 0 || currentRoom != key) return;
  const msgId = `${current["msgId"] ?? ""}`;
  const inviteId = `${current["inviteId"] ?? ""}`;
  if (msgId.length > 0) handledMessageIds.add(msgId);
  if (inviteId.length > 0) seen.add(inviteId);
  meetingInviteBanner.value = null;
}

/** 登出/切换账号时清理当前条；去重集合由 resetMeetingInviteBannerSeen 单独重置。 */
export function clearMeetingInviteBanner(): void {
  meetingInviteBanner.value = null;
}

export function resetMeetingInviteBannerSeen(): void {
  seen.clear();
  handledMessageIds.clear();
}
