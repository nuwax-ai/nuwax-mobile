<template>
  <!--
    V2 整轮工作轨迹容器（对齐 PC WorkTraceDisclosure）：
    纯文字 metrics + 尾部箭头 + 底部 hairline；展开体直接 v-if 挂载（无动画）。
    折叠状态机托管在 ai-msg；本组件为无状态展示壳，内容经默认 slot 注入。
  -->
  <view class="trace">
    <view class="trace-toggle" @tap="onToggle">
      <text class="trace-metrics">{{ headerText }}</text>
      <text
        class="iconfont icon-a-Chevrondown trace-chevron"
        :class="{ 'trace-chevron-open': expanded }"
      />
    </view>
    <view v-if="expanded" class="trace-body">
      <slot />
    </view>
  </view>
</template>

<script setup lang="uts">
  const props = withDefaults(
    defineProps<{
      /** 轨迹是否展开（有效展开 = 手动值 ?? 运行态默认）。 */
      expanded?: boolean;
      /** 轨迹头指标文案（运行态「工作中 MM:SS」/ 终态「N 次工具调用 · 已工作 T」）。 */
      headerText?: string;
    }>(),
    {
      expanded: false,
      headerText: "",
    },
  );

  const emit = defineEmits<{
    toggle: [];
  }>();

  function onToggle(): void {
    emit("toggle");
  }
</script>

<style lang="scss" scoped>
  // 对齐 PC hairline 色板
  $hairline: rgba(5, 5, 5, 0.08);
  $text-tertiary: rgba(5, 5, 5, 0.45);
  $text-secondary: rgba(5, 5, 5, 0.65);
  $text-quaternary: rgba(5, 5, 5, 0.25);

  .trace {
    width: 100%;
    margin-top: 16rpx;
  }

  // 轨迹头：纯文字 + 底部一条 hairline（对齐 PC，无状态点/图标）
  .trace-toggle {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8rpx;
    width: 100%;
    min-height: 64rpx;
    padding: 8rpx 0;
    border-bottom: 1px solid $hairline;
  }

  .trace-metrics {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    color: $text-tertiary;
    font-size: 26rpx;
    line-height: 44rpx;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  // 箭头：-90°=收起 / 0°=展开
  .trace-chevron {
    flex-shrink: 0;
    font-size: 20rpx;
    color: $text-quaternary;
    transform: rotate(-90deg);
    transition: transform 0.18s ease, color 0.18s ease;

    &-open {
      transform: rotate(0deg);
      color: $text-secondary;
    }
  }

  .trace-body {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
    padding: 20rpx 0 16rpx;
  }
</style>
