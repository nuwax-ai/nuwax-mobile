/**
 * 历史消息适配器
 * 将PC端历史会话消息中的自定义HTML标签转换为移动端支持的Markdown容器语法
 *
 * PC端格式: <div><markdown-custom-process executeId="xxx" type="xxx" status="xxx" name="xxx"></markdown-custom-process></div>
 * 移动端格式: :::container executeId="xxx" type="xxx" status="xxx" name="xxx"\n:::\n
 */

import {
  MessageInfo,
  ProcessingInfo,
  ExecuteResultInfo,
} from "@/types/interfaces/conversationInfo.uts";
import { ProcessingEnum } from "@/types/enums/common";
import {
  AssistantRoleEnum,
  MessageTypeEnum,
  AgentComponentTypeEnum,
} from "@/types/enums/agent";
import type { McpAskInteraction } from "@/types/intervention"; // contract verification marker: revision
import { createMcpAskInteractionFromToolInput, extractMcpAskStructuredInputFromResult } from "@/utils/mcpAskSchema.uts";
import { resolveMcpAskResumeStatus } from "@/subpackages/utils/mcpAskResumeMessage.uts";
import {
  firstString,
  firstNullableString,
  orArray,
  orEmpty,
  orNumber,
  orObject,
} from "@/utils/utsCoalesce.uts";
import {
  cloneMessageInfo,
  createMessageInfoFromRaw,
  messageToJsonObject,
} from "@/subpackages/utils/messageInfoClass.uts";

function patchMessageInfo(
  message: MessageInfo,
  field: string,
  value: any,
): MessageInfo {
  const copy = messageToJsonObject(message);
  copy[field] = value;
  return createMessageInfoFromRaw(copy);
}

/**
 * 组件执行结果（来自 API componentExecutedList[].result）
 */
export interface ComponentExecutedResult {
  executeId: string;
  id: number;
  name: string;
  type: string;
  startTime: number;
  endTime?: number;
  success?: boolean;
  data?: any;
  input?: any;
  kind?: string;
}

/**
 * 组件执行列表项接口（来自API返回）
 */
export interface ComponentExecutedItem {
  name: string;
  result: ComponentExecutedResult;
  status: string; // "FINISHED" | "FAILED" | "EXECUTING"
  targetId: number;
  type: string; // "Plan", "ToolCall", "Skill", "Workflow", "Page", etc.
}

function readComponentField(component: any, key: string): any | null {
  if (component == null) {
    return null;
  }
  return (component as UTSJSONObject)[key] as any;
}

function readNestedComponentField(
  component: any,
  nestedKey: string,
  key: string,
): any | null {
  const nested = readComponentField(component, nestedKey);
  if (nested == null) {
    return null;
  }
  return (nested as UTSJSONObject)[key] as any;
}

function getComponentInput(component: any): any {
  const result = readComponentField(component, "result");
  const structuredInput = extractMcpAskStructuredInputFromResult(
    result as any,
  ) as any | null;
  if (structuredInput != null) {
    return structuredInput as any;
  }
  const componentInput = readComponentField(component, "input");
  if (componentInput != null) {
    return componentInput as any;
  }
  const resultInput = readComponentField(result, "input");
  if (resultInput != null) {
    return resultInput as any;
  }
  return {} as any;
}

function getComponentToolCallId(component: any): string {
  return firstNullableString([
    readComponentField(component, "executeId"),
    readNestedComponentField(component, "result", "executeId"),
    readComponentField(component, "toolCallId"),
    readNestedComponentField(component, "result", "toolCallId"),
    readComponentField(component, "tool_call_id"),
    readNestedComponentField(component, "result", "tool_call_id"),
  ]);
}

function isFailedComponent(component: any): boolean {
  const status = firstNullableString([
    readComponentField(component, "status"),
    readNestedComponentField(component, "result", "status"),
  ]).toLowerCase();
  return (
    status === "failed" ||
    status === "error" ||
    readComponentField(component, "success") === false ||
    readNestedComponentField(component, "result", "success") === false
  );
}

function getMcpAskKey(interaction: McpAskInteraction): string {
  return interaction.requestId;
}

function readMessageField(message: MessageInfo, key: string): any | null {
  const obj = messageToJsonObject(message);
  return obj[key] as any;
}

export function hydrateMcpAskInteractionsFromExecutedComponents(
  message: MessageInfo,
): MessageInfo {
  const componentExecutedList = readMessageField(
    message,
    "componentExecutedList",
  );
  if (componentExecutedList == null || !Array.isArray(componentExecutedList)) {
    return message;
  }

  const executedList = componentExecutedList as any[];
  if (executedList.length === 0) {
    return message;
  }

  const existing = orArray<McpAskInteraction>(
    readMessageField(message, "mcpAskInteractions"),
  );
  const existingKeys = new Set<string>();
  for (let i = 0; i < existing.length; i++) {
    existingKeys.add(getMcpAskKey(existing[i]));
  }
  const hydrated: McpAskInteraction[] = [];

  for (let i = 0; i < executedList.length; i++) {
    const component = executedList[i] as any;
    if (isFailedComponent(component)) {
      continue;
    }

    const interaction = createMcpAskInteractionFromToolInput(
      getComponentInput(component),
      getComponentToolCallId(component),
    );
    if (interaction == null) {
      continue;
    }

    const key = getMcpAskKey(interaction);
    if (existingKeys.has(key)) {
      continue;
    }

    existingKeys.add(key);
    hydrated.push(interaction);
  }

  if (hydrated.length === 0) return message;

  const merged: McpAskInteraction[] = [];
  for (let i = 0; i < existing.length; i++) {
    merged.push(existing[i]);
  }
  for (let i = 0; i < hydrated.length; i++) {
    merged.push(hydrated[i]);
  }

  return patchMessageInfo(message, "mcpAskInteractions", merged);
}

/**
 * 解析的自定义标签信息
 */
class ParsedCustomTag {
  executeId: string = "";
  type: string = "";
  status: string = "";
  name: string = "";
  fullMatch: string = "";
}

/**
 * 解析PC端的markdown-custom-process HTML标签
 * @param text 包含HTML标签的文本
 * @returns 解析出的标签信息数组
 */
export function parseMarkdownCustomProcess(text: string): ParsedCustomTag[] {
  if (text.length === 0) return [];

  const results: ParsedCustomTag[] = [];

  // 匹配 <div><markdown-custom-process ...></markdown-custom-process></div> 格式
  // 以及 <markdown-custom-process ...></markdown-custom-process> 格式（无div包裹）
  const regex =
    /<div>[\s\n]*<markdown-custom-process([^>]*)><\/markdown-custom-process>[\s\n]*<\/div>|<markdown-custom-process([^>]*)><\/markdown-custom-process>/g;

  let match = regex.exec(text);
  while (match != null) {
    const attrString = firstNullableString([match[1], match[2]]);
    const fullMatch = orEmpty(match[0]);

    // 解析属性
    const executeId = extractAttribute(attrString, "executeId");
    const type = extractAttribute(attrString, "type");
    const status = extractAttribute(attrString, "status");
    const name = extractAttribute(attrString, "name");

    if (executeId.length > 0) {
      const tag = new ParsedCustomTag();
      tag.executeId = executeId;
      tag.type = orEmpty(type);
      tag.status = orEmpty(status);
      tag.name = orEmpty(name);
      tag.fullMatch = fullMatch;
      results.push(tag);
    }
    match = regex.exec(text);
  }

  return results;
}

/**
 * 从属性字符串中提取指定属性的值
 * @param attrString 属性字符串，如 ' executeId="xxx" type="yyy"'
 * @param attrName 属性名
 * @returns 属性值
 */
function extractAttribute(attrString: string, attrName: string): string {
  let regex = new RegExp(`${attrName}="([^"]*)"`);
  let match = attrString.match(regex);
  if (match != null) {
    return orEmpty(match[1]).replace(/&quot;/g, '"');
  }

  regex = new RegExp(`${attrName}='([^']*)'`);
  match = attrString.match(regex);
  if (match != null) {
    return orEmpty(match[1]).replace(/&quot;/g, '"');
  }

  return "";
}

/**
 * 将PC端HTML标签转换为移动端Markdown容器语法
 * @param tag 解析的标签信息
 * @returns Markdown容器语法字符串
 */
export function convertToMobileContainerSyntax(tag: ParsedCustomTag): string {
  const attrParts: string[] = [];
  attrParts.push(`executeId="${tag.executeId}"`);
  if (tag.type.length > 0) {
    attrParts.push(`type="${tag.type}"`);
  }
  if (tag.status.length > 0) {
    attrParts.push(`status="${tag.status}"`);
  }
  if (tag.name.length > 0) {
    attrParts.push(`name="${tag.name}"`);
  }
  const attrs = attrParts.join(" ");

  return `\n\n:::container ${attrs}\n:::\n\n`;
}

/**
 * 解析状态字符串为ProcessingEnum
 * @param status 状态字符串
 * @returns ProcessingEnum值
 */
function parseStatus(status: string): ProcessingEnum {
  switch (status) {
    case "FINISHED":
      return ProcessingEnum.FINISHED;
    case "FAILED":
      return ProcessingEnum.FAILED;
    case "EXECUTING":
    default:
      return ProcessingEnum.EXECUTING;
  }
}

/**
 * 解析组件类型字符串为AgentComponentTypeEnum
 * @param type 类型字符串
 * @returns AgentComponentTypeEnum值
 */
function parseComponentType(type: string): AgentComponentTypeEnum {
  switch (type) {
    case "Plan":
      return AgentComponentTypeEnum.Plan;
    case "ToolCall":
      return AgentComponentTypeEnum.ToolCall;
    case "Skill":
      return AgentComponentTypeEnum.Skill;
    case "Workflow":
      return AgentComponentTypeEnum.Workflow;
    case "Knowledge":
      return AgentComponentTypeEnum.Knowledge;
    case "Page":
      return AgentComponentTypeEnum.Page;
    case "Plugin":
      return AgentComponentTypeEnum.Plugin;
    case "Event":
      return AgentComponentTypeEnum.Event;
    case "Agent":
      return AgentComponentTypeEnum.Agent;
    case "Mcp":
    case "MCP":
      return AgentComponentTypeEnum.MCP;
    default:
      // 默认返回 ToolCall，因为这是最常见的类型
      return AgentComponentTypeEnum.ToolCall;
  }
}

function readResultField(result: any, key: string): any | null {
  if (result == null) {
    return null;
  }
  return (result as UTSJSONObject)[key] as any;
}

/**
 * 将componentExecutedList转换为processingList
 * @param componentExecutedList 组件执行列表
 * @returns ProcessingInfo数组
 */
export function convertComponentExecutedListToProcessingList(
  componentExecutedList: ComponentExecutedItem[] | null | undefined,
): ProcessingInfo[] {
  if (componentExecutedList == null || !Array.isArray(componentExecutedList)) {
    return [];
  }

  const executedList = componentExecutedList as any[];
  const processingList: ProcessingInfo[] = [];
  for (let i = 0; i < executedList.length; i++) {
    const item = executedList[i] as any;
    const itemStatus = orEmpty(readComponentField(item, "status"));
    const itemName = orEmpty(readComponentField(item, "name"));
    const itemType = orEmpty(readComponentField(item, "type"));
    const itemTargetId = readComponentField(item, "targetId");
    const result = orObject(
      readComponentField(item, "result"),
      new UTSJSONObject() as any,
    );
    const status = parseStatus(itemStatus);
    const componentType = parseComponentType(itemType);
    const resultSuccess = readResultField(result, "success");
    const executeResult = {
      kind: orEmpty(readResultField(result, "kind")),
      id: orNumber(readResultField(result, "id"), -1),
      icon: "",
      name: firstNullableString([
        readResultField(result, "name"),
        itemName,
      ]),
      type: componentType,
      success:
        resultSuccess != null && typeof resultSuccess === "boolean"
          ? (resultSuccess as boolean)
          : itemStatus === "FINISHED",
      error: "",
      data: orObject(readResultField(result, "data"), null),
      startTime: orNumber(readResultField(result, "startTime"), 0),
      endTime: orNumber(readResultField(result, "endTime"), 0),
      input: orObject(readResultField(result, "input"), null),
    } as ExecuteResultInfo;

    const processingInfo = {
      executeId: orEmpty(readResultField(result, "executeId")),
      name: firstNullableString([itemName, readResultField(result, "name")]),
      type: componentType,
      status: status,
      targetId: orNumber(
        itemTargetId,
        orNumber(readResultField(result, "id"), -1),
      ),
      result: executeResult,
      cardBindConfig: null,
    } as ProcessingInfo;
    processingList.push(processingInfo);
  }

  return processingList;
}

/**
 * 适配单条历史消息
 * 将PC端格式的自定义标签转换为移动端支持的格式
 * @param message 原始消息
 * @returns 适配后的消息
 */
export function adaptHistoryMessage(message: MessageInfo): MessageInfo {
  if (message == null) return message;

  // 只处理ASSISTANT消息，非ASSISTANT消息确保text有值后直接返回
  if (
    message.role !== AssistantRoleEnum.ASSISTANT &&
    message.messageType !== MessageTypeEnum.ASSISTANT
  ) {
    // 确保 text 字段有值；始终返回 class 克隆，避免 Android 强转失败
    if (readMessageField(message, "text") == null) {
      return patchMessageInfo(message, "text", "");
    }
    return cloneMessageInfo(message);
  }

  let adaptedText = orEmpty(readMessageField(message, "text"));
  let processingList = orArray<ProcessingInfo>(
    readMessageField(message, "processingList"),
  );

  // 1. 从componentExecutedList转换processingList
  const componentExecutedListRaw = readMessageField(
    message,
    "componentExecutedList",
  );
  if (
    componentExecutedListRaw != null &&
    Array.isArray(componentExecutedListRaw) &&
    (componentExecutedListRaw as any[]).length > 0
  ) {
    const convertedProcessingList = convertComponentExecutedListToProcessingList(
      componentExecutedListRaw as any[],
    );
    const mergedProcessingList: ProcessingInfo[] = [];
    for (let i = 0; i < processingList.length; i++) {
      mergedProcessingList.push(processingList[i]);
    }
    for (let i = 0; i < convertedProcessingList.length; i++) {
      mergedProcessingList.push(convertedProcessingList[i]);
    }
    processingList = mergedProcessingList;
  }

  // 2. 解析并转换PC端HTML标签为移动端Markdown容器语法
  const parsedTags = parseMarkdownCustomProcess(adaptedText);

  for (let tagIndex = 0; tagIndex < parsedTags.length; tagIndex++) {
    const tag = parsedTags[tagIndex];
    const containerSyntax = convertToMobileContainerSyntax(tag);
    adaptedText = adaptedText.replace(tag.fullMatch, containerSyntax);
  }

  // 3. 清理多余的空行（超过2个连续换行符的情况）
  adaptedText = adaptedText.replace(/\n{3,}/g, "\n\n");

  // 转换自定义 agent-info 和 agent 标签为加粗 Markdown 格式，以兼容移动端 mp-html 渲染
  adaptedText = adaptAgentInfoTags(adaptedText);

  const adaptedObj = messageToJsonObject(message);
  adaptedObj["text"] = orEmpty(adaptedText);
  adaptedObj["processingList"] = processingList;

  return hydrateMcpAskInteractionsFromExecutedComponents(
    createMessageInfoFromRaw(adaptedObj),
  );
}

export function applyMcpAskResumeStatusesInMessageList(
  messageList: MessageInfo[],
): MessageInfo[] {
  if (messageList == null || !Array.isArray(messageList)) return [];

  return messageList.map(
    (message: MessageInfo, messageIndex: number): MessageInfo => {
      const mcpAskInteractions = orArray<McpAskInteraction>(
        readMessageField(message, "mcpAskInteractions"),
      );
      if (mcpAskInteractions.length === 0) {
        return message;
      }

      const updatedInteractions = mcpAskInteractions.map(
        (interaction: McpAskInteraction): McpAskInteraction => {
          if (
            interaction.responseStatus != null &&
            interaction.responseStatus.length > 0 &&
            interaction.responseStatus !== "pending"
          ) {
            return interaction;
          }

          for (let i = messageIndex + 1; i < messageList.length; i += 1) {
            const candidate = messageList[i];
            const status = resolveMcpAskResumeStatus(
              orEmpty(readMessageField(candidate, "text")),
              interaction,
            );
            if (status != null && status.length > 0) {
              const nextInteraction = JSON.parse(
                JSON.stringify(interaction),
              ) as UTSJSONObject;
              nextInteraction["responseStatus"] = status;
              return nextInteraction as McpAskInteraction;
            }
          }

          return interaction;
        },
      );

      return patchMessageInfo(
        message,
        "mcpAskInteractions",
        updatedInteractions,
      );
    },
  );
}

/**
 * 批量适配历史消息列表
 * @param messageList 原始消息列表
 * @returns 适配后的消息列表
 */
export function adaptHistoryMessageList(
  messageList: MessageInfo[],
): MessageInfo[] {
  if (messageList == null || !Array.isArray(messageList)) {
    return [];
  }

  return applyMcpAskResumeStatusesInMessageList(
    messageList.map((message) => adaptHistoryMessage(message)),
  );
}

/**
 * 转换自定义 agent-info 和 agent 标签为移动端 mp-html 可渲染结构
 */
export function adaptAgentInfoTags(text: string): string {
  if (text.length === 0) return "";

  const regex =
    /<agent-info([^>]*?)\/?>|<agent-info([^>]*?)><\/agent-info>|<agent([^>]*?)\/?>|<agent([^>]*?)><\/agent>/g;

  return text.replace(regex, (match, p1, p2, p3, p4) => {
    const attrString = firstNullableString([p1, p2, p3, p4]);
    const name = orEmpty(extractAttribute(attrString, "name"));
    const icon = orEmpty(extractAttribute(attrString, "icon"));
    const hasIcon =
      icon.length > 0 &&
      icon !== "null" &&
      icon !== "undefined" &&
      icon.trim() !== "";
    const imgHtml = hasIcon
      ? `<img class="agent-info-icon" style="width: 36rpx; height: 36rpx; border-radius: 50%; margin-right: 12rpx; display: inline-block; vertical-align: middle; object-fit: cover;" src="${icon}" />`
      : "";

    return `<div class="agent-info-container" style="display: block; text-align: left; margin: 12rpx 0; line-height: 1;">${imgHtml}<span class="agent-info-name" style="font-size: 26rpx; color: rgba(0, 0, 0, 0.45); font-weight: 500; display: inline-block; vertical-align: middle; line-height: 36rpx; height: 36rpx;">${name}</span></div>`;
  });
}
