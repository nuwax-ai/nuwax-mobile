<template>
	<view class="msg-root-content">
		<template v-for="(item, index) in markdownElList" :key="index">
			<TaskResultCard
				v-if="item.type == 'task_result'"
				class="msg-root-process-box"
				:task-result-data="getTaskResultData(item)"
				:conversation-id="conversationId"
			/>
			<ToolCallGroup
				v-else-if="item.type == 'markdown_custom_process_group'"
				:items="getCustomProcessList(item)"
				class="msg-root-process-box"
			>
				<ToolCallCard
					v-for="(process, processIndex) in getCustomProcessList(item)"
					:key="getProcessKey(process, processIndex)"
					:tool-call-data="resolveProcessData(process)"
				/>
			</ToolCallGroup>
			<ToolCallCard
				v-else-if="item.type == 'markdown_custom_process'"
				class="msg-root-process-box"
				:tool-call-data="resolveFirstProcessData(item)"
			/>
			<view
				v-else-if="item.type == 'markdown_image'"
				class="msg-root-markdown-image-box"
			>
				<image
					class="msg-root-markdown-image"
					:src="getMarkdownImageSrc(item)"
					mode="widthFix"
					@click="previewMarkdownImage(item)"
				/>
			</view>
			<view v-else-if="item.type == 'block_quote'" class="msg-root-block-quote-box">
				<uni-ai-text-md v-for="(blockQuote, i) in item.datasList" :key="i" :datas="blockQuote" :itemType="item.type" :content-variant="contentVariant"/>
			</view>
			<!-- 列表整块包一层：外间距只加一次，避免 App 上每项 margin 不折叠导致行距过大 -->
			<view v-else-if="item.type == 'list'" class="msg-root-list-box">
				<uni-ai-text-md
					v-for="(listRow, listIndex) in item.datasList"
					:key="listIndex"
					:datas="listRow"
					:itemType="item.type"
					:content-variant="contentVariant"
				/>
			</view>
			<!-- 忽略水平线 thematic_break，避免 $$ 后 --- 等产生多余中横线 -->
			<template v-else-if="item.type != 'thematic_break'" v-for="(datas, i) in item.datasList" :key="i">
				<template v-for="(data, k) in datas" :key="k" v-if="['table', 'code_block', 'math', 'block_quote'].includes(item.type)">
					<uni-ai-msg-table class="msg-root-table-box" v-if="item.type == 'table'" :table-node="data" />
					<uni-ai-msg-code class="msg-root-code-box" v-else-if="item.type == 'code_block'" :codeTokens="data.codeTokens ?? []"  :codeText="data.text ?? ''" :language="data.lang ?? 'text'" :href="data.href" />
					<katex-el v-else-if="item.type == 'math'" :html="data.html" :href="data.href" :width="data.width" :height="data.height" />
				</template>
				<uni-ai-text-md v-else :datas="datas" :itemType="item.type" :content-variant="contentVariant" :key="item.uniqueId"/>
			</template>
		</template>
	</view>
</template>

<script lang="uts" setup>
import type { UniAiMarkdownElItem } from '@/uni_modules/uni-ai-x/types.uts'
import type { ProcessingInfo, ExecuteResultInfo } from '@/types/interfaces/conversationInfo.uts'
import ToolCallCard from '@/subpackages/components/tool-call/tool-call-card.uvue'
import ToolCallGroup from '@/subpackages/components/tool-call/tool-call-group.uvue'
import TaskResultCard from '@/subpackages/components/task-result/task-result-card.uvue'

const props = withDefaults(
	defineProps<{
		markdownElList: UniAiMarkdownElItem[]
		processingList?: any[]
		conversationId?: string
		contentVariant?: string
	}>(),
	{
		markdownElList: (): UniAiMarkdownElItem[] => [] as UniAiMarkdownElItem[],
		processingList: (): any[] => [] as any[],
		conversationId: '',
		contentVariant: '',
	},
)

/** 获取 task-result 结构化数据。 */
function getTaskResultData(item: UniAiMarkdownElItem): any {
	return item.taskResultData != null
		? item.taskResultData!
		: new UTSJSONObject()
}

/** 获取自定义工具标签列表。 */
function getCustomProcessList(item: UniAiMarkdownElItem): any[] {
	return item.customProcessList != null
		? item.customProcessList!
		: [] as any[]
}

/** 读取标签对象中的 executeId。 */
function getTagExecuteId(item: any | null): string {
	if (item == null) return ''
	const tag = item as UTSJSONObject
	const direct = tag['executeId']
	if (direct != null && `${direct}`.length > 0) {
		return `${direct}`
	}
	return ''
}

/** 读取强类型 ProcessingInfo 中的 executeId。 */
function readProcessingField(item: any | null, key: string): any | null {
	if (item == null) return null
	try {
		const obj = item as UTSJSONObject
		const value = obj[key]
		if (value != null) return value
	} catch (_eObj) {
		// ProcessingInfo 类实例不能强转 UTSJSONObject
	}
	try {
		const process = item as ProcessingInfo
		if (key == 'executeId') return process.executeId
		if (key == 'cardBindConfig') return process.cardBindConfig
		if (key == 'name') return process.name
		if (key == 'result') return process.result
		if (key == 'status') return process.status
		if (key == 'targetId') return process.targetId
		if (key == 'type') return process.type
	} catch (_eProcess) {
		// 非 ProcessingInfo
	}
	return null
}

/** 兼容 ExecuteResultInfo 类实例与动态对象读取。 */
function readResultField(result: any | null, key: string): any | null {
	if (result == null) return null
	try {
		const obj = result as UTSJSONObject
		const value = obj[key]
		if (value != null) return value
	} catch (_eObj) {
		// ExecuteResultInfo 类实例不能强转 UTSJSONObject
	}
	try {
		const value = result as ExecuteResultInfo
		if (key == 'data') return value.data
		if (key == 'error') return value.error
		if (key == 'id') return value.id
		if (key == 'icon') return value.icon
		if (key == 'input') return value.input
		if (key == 'name') return value.name
		if (key == 'startTime') return value.startTime
		if (key == 'endTime') return value.endTime
		if (key == 'success') return value.success
		if (key == 'type') return value.type
		if (key == 'kind') return value.kind
	} catch (_eResult) {
		// 非 ExecuteResultInfo
	}
	return null
}

/** 将执行结果规范为 MarkdownContainer 可安全读取的对象。 */
function normalizeExecuteResult(result: any | null): UTSJSONObject {
	const out = new UTSJSONObject()
	out['data'] = readResultField(result, 'data')
	out['error'] = readResultField(result, 'error')
	out['id'] = readResultField(result, 'id')
	out['icon'] = readResultField(result, 'icon')
	out['input'] = readResultField(result, 'input')
	out['name'] = readResultField(result, 'name')
	out['startTime'] = readResultField(result, 'startTime')
	out['endTime'] = readResultField(result, 'endTime')
	out['success'] = readResultField(result, 'success')
	out['type'] = readResultField(result, 'type')
	out['kind'] = readResultField(result, 'kind')
	return out
}

/** 将 ProcessingInfo 类实例规范为 UTSJSONObject，避免 Android 强转崩溃。 */
function normalizeProcessingInfo(item: any): UTSJSONObject {
	const out = new UTSJSONObject()
	out['executeId'] = readProcessingField(item, 'executeId')
	out['cardBindConfig'] = readProcessingField(item, 'cardBindConfig')
	out['name'] = readProcessingField(item, 'name')
	out['result'] = normalizeExecuteResult(readProcessingField(item, 'result'))
	out['status'] = readProcessingField(item, 'status')
	out['targetId'] = readProcessingField(item, 'targetId')
	out['type'] = readProcessingField(item, 'type')
	return out
}

/** 工具调用 executeId。 */
function getProcessingExecuteId(item: any | null): string {
	const executeId = readProcessingField(item, 'executeId')
	return executeId != null ? `${executeId}` : ''
}

/** 读取标签上的 type（用于与 processingList 类型对齐，避免同 executeId 的 Event 覆盖 Plan）。 */
function getTagType(tag: any | null): string {
	if (tag == null) return ''
	const obj = tag as UTSJSONObject
	const value = obj['type']
	return value != null ? `${value}` : ''
}

/**
 * 用 processingList 中的完整执行数据补齐标签属性。
 * 对齐 dev mp-html getProcessingDataByPriority：同 executeId 时优先匹配标签声明的 type。
 */
function resolveProcessData(tag: any | null): any {
	const executeId = getTagExecuteId(tag)
	const expectedType = getTagType(tag).toLowerCase()
	const base = tag != null ? tag as UTSJSONObject : new UTSJSONObject()
	if (executeId.length == 0) {
		return base
	}

	const list = props.processingList
	let best: any | null = null
	let bestScore = 9999
	for (let i = 0; i < list.length; i++) {
		const process = list[i]
		if (getProcessingExecuteId(process) != executeId) {
			continue
		}
		const processTypeRaw = readProcessingField(process, 'type')
		const statusRaw = readProcessingField(process, 'status')
		const processType = (processTypeRaw != null ? `${processTypeRaw}` : '').toLowerCase()
		const status = statusRaw != null ? `${statusRaw}` : ''
		let score = 100
		if (expectedType.length > 0 && processType == expectedType) {
			score = 0
		} else if (processType == 'event') {
			score = 200
		}
		if (status == 'FINISHED') {
			score += 1
		} else if (status == 'FAILED') {
			score += 2
		} else {
			score += 3
		}
		if (score < bestScore) {
			bestScore = score
			best = process
		}
	}

	if (best == null) {
		return base
	}

	// 以 processing 完整数据为主，保留标签上的 name/type/status 兜底
	const merged = normalizeProcessingInfo(best)
	if (merged['name'] == null || `${merged['name']}`.length == 0) {
		const tagName = base['name']
		if (tagName != null) merged['name'] = tagName
	}
	if (merged['type'] == null || `${merged['type']}`.length == 0) {
		const tagType = base['type']
		if (tagType != null) merged['type'] = tagType
	}
	if (merged['status'] == null || `${merged['status']}`.length == 0) {
		const tagStatus = base['status']
		if (tagStatus != null) merged['status'] = tagStatus
	}
	return merged
}

/** 单个工具标签的完整渲染数据。 */
function resolveFirstProcessData(item: UniAiMarkdownElItem): any {
	const list = getCustomProcessList(item)
	return list.length > 0 ? resolveProcessData(list[0]) : new UTSJSONObject()
}

/** 工具标签稳定 key。 */
function getProcessKey(process: any | null, index: number): string {
	const executeId = getTagExecuteId(process)
	return executeId.length > 0 ? `${executeId}-${index}` : `process-${index}`
}

/** 读取 markdown_image 节点的图片地址。 */
function getMarkdownImageSrc(item: UniAiMarkdownElItem): string {
	const rows = item.datasList
	if (rows == null || rows.length == 0) {
		return ""
	}
	const row = rows[0]
	if (row == null || row.length == 0) {
		return ""
	}
	const tok = row[0]
	const href = tok.href
	return href != null ? `${href}` : ""
}

/** 预览正文原位图片。 */
function previewMarkdownImage(item: UniAiMarkdownElItem): void {
	const src = getMarkdownImageSrc(item)
	if (src.length == 0) {
		return
	}
	const urls = [] as string[]
	const list = props.markdownElList
	for (let i = 0; i < list.length; i++) {
		const el = list[i]
		if (el.type == "markdown_image") {
			const u = getMarkdownImageSrc(el)
			if (u.length > 0) {
				urls.push(u)
			}
		}
	}
	uni.previewImage({
		urls: urls.length > 0 ? urls : [src],
		current: src,
	})
}
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.msg-root-content {
	flex-direction: column;
	flex-wrap: nowrap;
	width: 100%;
	/* 对齐 dev：正文色 #404040 */
	color: #404040;
}

.msg-root-table-box,
.msg-root-code-box,
.msg-root-hr-box,
.msg-root-process-box,
.msg-root-block-quote-box,
.msg-root-list-box,
.msg-root-markdown-image-box {
	width: 100%;
	margin: 16rpx 0;
}

.msg-root-markdown-image {
	width: 100%;
	max-width: 100%;
	border-radius: 12rpx;
}

.msg-root-list-box {
	display: flex;
	flex-direction: column;
	/* #ifndef APP */
	width: 100%;
	/* #endif */
}

.msg-root-hr-box {
	height: 1rpx;
	background: #d9d9d9;
	margin: 20rpx 0;
}

.msg-root-block-quote-box {
	width: 100%;
	padding: 0 32rpx;
	color: #6a737d;
	border-left: 8rpx solid #dfe2e5;
	background-color: transparent;
	margin: 0 0 32rpx;
	box-sizing: border-box;
}
</style>
