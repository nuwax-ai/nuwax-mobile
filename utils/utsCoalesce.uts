/**
 * UTS 兼容的值回退工具
 * UTS 不允许用 `||` 做非 boolean 默认值，用这些函数替代 JS 的 `a || b`
 */

/** 字符串回退：null/undefined/空字符串 时使用 fallback */
export function orString(value: any, fallback: string): string {
  if (value != null && typeof value === "string" && value.length > 0) {
    return value;
  }
  return fallback;
}

/** 字符串回退为空串 */
export function orEmpty(value: any): string {
  return orString(value, "");
}

/** 数字回退：null/undefined/NaN 时使用 fallback（0 保留） */
export function orNumber(value: any, fallback: number): number {
  if (value != null && typeof value === "number" && !Number.isNaN(value)) {
    return value;
  }
  return fallback;
}

/** 数组回退：非数组时使用空数组 */
export function orArray<T>(value: any): T[] {
  if (value != null && Array.isArray(value)) {
    return value as T[];
  }
  return [] as T[];
}

/** 对象回退：null/undefined 时使用 fallback */
export function orObject<T>(value: any, fallback: T): T {
  if (value != null) {
    return value as T;
  }
  return fallback;
}

/** 取第一个非空字符串（等同 a || b || c 链，均为 string） */
export function firstString(values: any[], fallback: string = ""): string {
  for (let i = 0; i < values.length; i++) {
    const v = values[i];
    if (v != null && typeof v === "string" && v.length > 0) {
      return v;
    }
  }
  return fallback;
}
