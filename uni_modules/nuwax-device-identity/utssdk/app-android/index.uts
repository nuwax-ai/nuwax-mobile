/**
 * nuwax-device-identity · app-android
 *
 * IM deviceId 的 baseId 稳定来源：Settings.Secure.ANDROID_ID（SSAID）。
 *
 * 为什么用它：Android 8.0+ 的 SSAID 按（用户, 应用签名 key）作用域，卸载重装
 * （同签名）后值不变，且无需任何权限——storage 会在卸载时清空，SSAID 不会。
 * 已知边界（接受）：
 *  - 重装换签名（本地基座 ≠ 云打包基座签名）→ SSAID 变，等同新设备；
 *  - 恢复出厂设置 → SSAID 重新生成，等同新设备。
 * 返回 null（异常/为空）时由调用方回落 generateUUID + storage 的现有路径。
 */
import Settings from 'android.provider.Settings';

/**
 * 读取 SSAID；拿不到返回 null（调用方回落，不抛异常——本函数在 IM 发送热路径上）。
 * 典型值为 16 位 hex，天然满足服务端 ImProtocol.isValidDeviceId 的字符白名单。
 */
export function getStableDeviceBaseId(): string | null {
  try {
    const ctx = UTSAndroid.getAppContext();
    if (ctx == null) return null;
    const v = Settings.Secure.getString(ctx!!.getContentResolver(), Settings.Secure.ANDROID_ID);
    if (v == null) return null;
    const s = `${v!!}`.trim();
    return s.length > 0 ? s : null;
  } catch (e) {
    return null;
  }
}
