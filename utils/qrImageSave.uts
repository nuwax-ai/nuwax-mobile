/**
 * 二维码「保存图片」跨端入口：把本地生成的 PNG dataUrl 落到用户相册/下载。
 *
 * - APP：走 appWebViewImagePreview 的 saveDataUrlImageToAlbumInApp（base64 写沙盒
 *   → saveImageToPhotosAlbum；iOS 永久拒权引导去设置、写盘失败降级长按保存）
 * - MP-WEIXIN：同链路 writeFile + save；auth deny → showModal 引导 openSetting
 * - H5/WEB：anchor[download] 直接触发浏览器下载
 *
 * 文件名：qr-{净化后的名片名}.png（剔常见文件系统非法字符与空白，截 32 字防超长；
 * 空名回退 qrcode.png）。
 */
// #ifdef APP
import { saveDataUrlImageToAlbumInApp } from "./appWebViewImagePreview";
// #endif
import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

/** 名片名 → 安全图片文件名（qr-xxx.png；空/全非法字符回退 qrcode.png）。 */
export function qrImageFileName(cardName: string): string {
  let cleaned = "";
  for (let i = 0; i < cardName.length; i++) {
    const ch = cardName.charAt(i);
    if (
      ch == "/" || ch == "\\" || ch == ":" || ch == "*" || ch == "?" ||
      ch == "\"" || ch == "<" || ch == ">" || ch == "|" || ch == " " || ch == "\t"
    ) {
      continue;
    }
    cleaned += ch;
  }
  if (cleaned.length > 32) {
    cleaned = cleaned.substring(0, 32);
  }
  return cleaned.length > 0 ? `qr-${cleaned}.png` : "qrcode.png";
}

/** dataUrl 的 base64 载荷（非 data:image 前缀或无逗号返回空串）。 */
function dataUrlBase64(dataUrl: string): string {
  const commaIdx = dataUrl.indexOf(",");
  if (dataUrl.indexOf("data:image/") != 0 || commaIdx < 0) {
    return "";
  }
  return dataUrl.substring(commaIdx + 1);
}

/** 保存二维码 dataUrl 到相册/下载。resolve=已落（或已引导），reject=失败。 */
export function saveQrImageToAlbum(dataUrl: string, fileName: string): Promise<void> {
  const base64 = dataUrlBase64(dataUrl);
  if (base64.length == 0) {
    uni.showToast({ title: t("Mobile.ImagePreview.saveToAlbumFailed"), icon: "none" });
    return Promise.reject(new Error("not a data image url"));
  }
  const safeName = fileName.length > 0 ? fileName : `qr-${Date.now()}.png`;

  // #ifdef APP
  return saveDataUrlImageToAlbumInApp(dataUrl, safeName);
  // #endif

  // #ifdef MP-WEIXIN
  return new Promise<void>((resolve, reject) => {
    const filePath = `${uni.env.USER_DATA_PATH}/${safeName}`;
    // 不 showLoading：页面用按钮「保存中...」态作反馈（遮罩在快操作下的
    // 出现/消失本身就是一次闪动；与 APP 分支口径一致）
    uni.getFileSystemManager().writeFile({
      filePath: filePath,
      data: base64,
      encoding: "base64",
      success: (_res) => {
        uni.saveImageToPhotosAlbum({
          filePath: filePath,
          success: (_saveRes) => {
            uni.showToast({ title: t("Mobile.ImagePreview.savedToAlbum"), icon: "success" });
            resolve();
          },
          fail: (saveErr) => {
            const errMsg = `${saveErr.errMsg ?? ""}`;
            if (errMsg.indexOf("auth") >= 0 || errMsg.indexOf("deny") >= 0) {
              uni.showModal({
                title: t("Mobile.AgentDetail.albumPermissionTitle"),
                content: t("Mobile.ImagePreview.albumPermissionSaveContent"),
                confirmText: t("Mobile.Voice.goToSettings"),
                cancelText: t("Mobile.Common.cancel"),
                success: (res) => {
                  if (res.confirm == true) {
                    uni.openSetting({});
                  }
                },
              });
            } else {
              uni.showToast({ title: t("Mobile.ImagePreview.saveToAlbumFailed"), icon: "none" });
            }
            reject(saveErr);
          },
        });
      },
      fail: (err) => {
        uni.showToast({ title: t("Mobile.ImagePreview.saveToAlbumFailed"), icon: "none" });
        reject(err);
      },
    });
  });
  // #endif

  // #ifdef H5 || WEB
  try {
    const doc = document;
    const anchor = doc.createElement("a");
    anchor.href = dataUrl;
    anchor.download = safeName;
    anchor.style.display = "none";
    doc.body.appendChild(anchor);
    anchor.click();
    doc.body.removeChild(anchor);
  } catch (_e) {
    // 兜底：新窗直开 dataUrl（浏览器自带右键保存）
    window.open(dataUrl);
  }
  return Promise.resolve();
  // #endif

  // 无平台命中的兜底（理论不可达；保类型完整性）
  return Promise.reject(new Error("unsupported platform"));
}
