<template>
  <view class="agent-list-page">
    <custom-nav-bar :title="t('Mobile.Nav.expert')" hasSafetyZone :showBack="true">
      <!-- #ifdef MP-WEIXIN -->
      <template v-slot:left>
        <svg-icon v-if="isLoggedIn" name="icon-Search" size="48" @click="handleSearch" />
      </template>
      <!-- #endif -->
      <!-- #ifndef MP-WEIXIN -->
      <template v-slot:right>
        <svg-icon v-if="isLoggedIn" name="icon-Search" size="48" @click="handleSearch" />
      </template>
      <!-- #endif -->
    </custom-nav-bar>

    <view class="agent-list-page__body">
      <published-agent-list
        targetType="ChatBot"
      ></published-agent-list>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import PublishedAgentList from '@/components/published-agent-list/published-agent-list.uvue'
  // #ifdef MP-WEIXIN
  import { onAddToFavorites } from '@dcloudio/uni-app'
  // #endif
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";
  import { getCurrentPagePath } from "@/utils/commonBusiness";
  import { onShow } from "@dcloudio/uni-app";
  import { useAuthInterceptor } from "@/hooks/useAuthInterceptor";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // 使用登录拦截 composable
  const authInterceptor = useAuthInterceptor();
  const checkAuthAndShowPopup = authInterceptor.checkAuthAndShowPopup as () => Promise<boolean>;
  const hasToken = authInterceptor.hasToken as () => Promise<boolean>;
  // 导航栏搜索入口（登录后展示）
  const isLoggedIn = ref<boolean>(false);

  // 处理搜索
  const handleSearch = async () => {
    // 检查登录状态，如果未登录则显示登录弹窗
    const _isLoggedIn = await checkAuthAndShowPopup();
    if (_isLoggedIn != true) {
      return;
    }
    const currentUrl = getCurrentPagePath();
    uni.navigateTo({
      url:
        `/subpackages/pages/agent-search/agent-search?type=ChatBot&backUrl=` +
        encodeURIComponent(currentUrl),
    });
  };

  const initData = async () => {
    isLoggedIn.value = await hasToken();
  };

  // 切到本 tab 时清除可能残留的 mask:true loading，并触发智能体列表静默刷新（对齐 index.uvue / mine.uvue）
  onShow(() => {
    uni.hideLoading();
    initData();
  });

  // #ifdef MP-WEIXIN
  // 收藏
  onAddToFavorites(() => {
    return {
      title: t("Mobile.Nav.expert"),
    }
  })
  // #endif
</script>

<style lang="scss" scoped>
  .agent-list-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }

  .agent-list-page__body {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
</style>

<!-- H5：禁止页面级滚动，仅列表内部滚动 -->
<style lang="scss">
  /* #ifdef H5 */
  page {
    height: 100%;
    overflow: hidden;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
  }
  /* #endif */
</style>
