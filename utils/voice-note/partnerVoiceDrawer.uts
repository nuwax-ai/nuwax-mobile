import { nextTick, ref } from "vue";
// #ifdef APP-ANDROID
import Build from "android.os.Build";
import Context from "android.content.Context";
import Vibrator from "android.os.Vibrator";
import VibratorManager from "android.os.VibratorManager";
import VibrationEffect from "android.os.VibrationEffect";
// #endif

/**
 * 伙伴页录音层开关。false：不显示顶部录音图标，右滑也不会打开录音面板。
 * H5 没有录音面板，图标和消息页左右滑动一并关掉。App 端保持开启。
 */
// #ifdef H5
export const partnerVoiceRecordEnabled = false;
// #endif
// #ifndef H5
export const partnerVoiceRecordEnabled = true;
// #endif

/** 手指几乎停住时，要滑过屏幕宽度的三成才切换。轻轻一滑不看这条线。 */
const partnerVoiceCommitRatio = 0.3;
/** 轻轻一滑的速度（px/ms）。顺着滑动方向就收到全开或全关。 */
const partnerVoiceFlickSpeed = 0.18;
/** 轻滑至少离开起点这么远，手指微颤不算滑。 */
const partnerVoiceFlickDistance = 16;
/** 当前松手是否会停在录音页。和这次震动一致。 */
let hapticPast = false;

/** 伙伴页右滑位移（px）。0 为伙伴页，等于屏幕宽度时录音铺满整屏。左右并排，一起平移。 */
export const partnerVoiceOffset = ref<number>(0);
/** 跟手拖动中：两层都不做过渡，松手后再缓动到开或关。 */
export const partnerVoiceDragging = ref<boolean>(false);
/** 这次滑动从已经露出的录音层开始。跟手时不让伙伴页把手指抢走。 */
export const partnerVoiceFromRecord = ref<boolean>(false);
/** 松手后收到两端的过渡时长。跟手时为 0，避免和位移写在同一帧里直接跳完。 */
export const partnerVoiceSettleMs = ref<number>(320);
/** 已吸附打开。 */
export const partnerVoiceOpen = ref<boolean>(false);
/** 每次吸附加一，让位移样式字符串变化，安卓才会把已经写过的 translateX 再应用一次。 */
export const partnerVoicePaint = ref<number>(0);
/** 录音进行中：伙伴页麦克风保持红色。 */
export const partnerVoiceRecording = ref<boolean>(false);
/** 横向拖动时锁住会话列表的纵向滚动，避免又滑又滚。 */
export const partnerVoiceScrollLock = ref<boolean>(false);
/** 第一次露出后保持挂载，收回动画时左边的录音层不会先消失。 */
export const partnerVoiceAlive = ref<boolean>(false);
/** 卸掉左侧录音页时不做位移动画，避免伙伴页再从左边滑进来一次。 */
export const partnerVoiceSnapless = ref<boolean>(false);

let maxOffsetPx = 0;
let startX = 0;
let startY = 0;
let startOffset = 0;
let beginTime = 0;
let lastX = 0;
let lastTime = 0;
let velocity = 0;
let axis = "";
let tracking = false;
let aliveTimer = 0;
/** 最近一次松手是否算横滑。列表用它吞掉随后的点击，函数本身保持无返回值。 */
let partnerVoiceClaimed = false;
/** 点麦克风或主动开关会作废尚未落地的吸附，避免刚打开又被拉回伙伴页。 */
let gestureEpoch = 0;
/** 松手后待落地的全开/全关。手指还按着时先挂起，松手或抬手丢失后再收。 */
let hasPendingSettle = false;
let pendingSettleOpen = false;
let settleSerial = 0;
let restWatchTimer = 0;
let lastMoveAt = 0;
/** 这么久没有新的位移，视为抬手事件丢失。手指还在滑动时不会触发。 */
const partnerVoiceMoveIdleMs = 480;
/** 松手后的过渡没在下一帧写上时，隔这么久再补一次。安卓热更新会按这个名字找静态方法，不能删。 */
const partnerVoiceSettleFallbackMs = 32;
/** 同一次按下从子视图冒泡到外层的间隔。这段时间内不换手势代号。 */
const partnerVoiceBeginDedupeMs = 40;
/** 当前手势代号。过期的 touchend/touchcancel 不能把还按着的手指清掉。 */
let dragToken = 0;
let lastBeginAt = 0;

function cancelPartnerVoiceAliveTimer(): void {
  if (aliveTimer != 0) {
    clearTimeout(aliveTimer);
    aliveTimer = 0;
  }
}

/** 收回动画结束后卸掉左侧录音页。先停掉过渡，下一帧再收成单屏。 */
function schedulePartnerVoiceUnmount(): void {
  cancelPartnerVoiceAliveTimer();
  let wait = partnerVoiceSettleMs.value + 60;
  if (wait < 180) {
    wait = 180;
  }
  aliveTimer = setTimeout(() => {
    aliveTimer = 0;
    if (partnerVoiceOpen.value || partnerVoiceOffset.value > 0 || partnerVoiceDragging.value || tracking) {
      return;
    }
    // 这一帧只把时长收成 0，位移仍停在「只露出消息页」。
    // 和卸页写在同一帧时，iOS 会沿用关闭动画的时长，把消息页再从左侧滑进来一次。
    partnerVoiceSettleMs.value = 0;
    partnerVoiceSnapless.value = true;
    const epoch = gestureEpoch;
    nextTick(() => {
      if (epoch != gestureEpoch || partnerVoiceOpen.value || partnerVoiceOffset.value > 0 || partnerVoiceDragging.value || tracking) {
        partnerVoiceSnapless.value = false;
        return;
      }
      partnerVoiceAlive.value = false;
      nextTick(() => {
        partnerVoiceSnapless.value = false;
      });
    });
  }, wait);
}

/** 录音铺满整屏时，伙伴页（含底栏）右移一整屏。 */
export function partnerVoiceMaxOffset(): number {
  const width = Math.round(uni.getWindowInfo().windowWidth);
  // tab-shell setup 首拍在部分 Android 设备上早于窗口尺寸就绪，windowWidth 会短暂为 0。
  // 兜底 240 只能用于这一拍，不能写进缓存；否则华为 362dp 宽屏会永久只渲染 240dp，
  // 右侧露出 Stage 灰底。后续 onReady/onResize 重算时用真实宽度覆盖缓存。
  if (width >= 240) {
    maxOffsetPx = width;
    return maxOffsetPx;
  }
  return maxOffsetPx >= 240 ? maxOffsetPx : 240;
}

function cancelPartnerVoiceRestWatch(): void {
  if (restWatchTimer != 0) {
    clearTimeout(restWatchTimer);
    restWatchTimer = 0;
  }
}

/** 剩余距离越短，收得越快。整屏大约 320ms，接近微信侧滑松手后的 ease-out。 */
function settleDurationMs(open: boolean): number {
  const max = partnerVoiceMaxOffset();
  const distance = Math.abs((open ? max : 0) - partnerVoiceOffset.value);
  if (max <= 0) {
    return 320;
  }
  let ms = Math.round(120 + (distance / max) * 200);
  if (ms < 120) {
    ms = 120;
  }
  if (ms > 320) {
    ms = 320;
  }
  return ms;
}

function offsetIsMid(): boolean {
  const max = partnerVoiceMaxOffset();
  const offset = partnerVoiceOffset.value;
  return offset > 1 && offset < max - 1;
}

/** 收到全开或全关。调用前一帧已经把过渡时长写成非 0，这一帧只改位移。 */
function commitPartnerVoiceSettle(open: boolean): void {
  cancelPartnerVoiceRestWatch();
  cancelPartnerVoiceAliveTimer();
  const max = partnerVoiceMaxOffset();
  partnerVoiceDragging.value = false;
  partnerVoiceScrollLock.value = false;
  partnerVoiceOpen.value = open;
  partnerVoiceOffset.value = open ? max : 0;
  partnerVoicePaint.value = partnerVoicePaint.value + 1;
  if (!open) {
    schedulePartnerVoiceUnmount();
  }
  const serial = settleSerial;
  const paintWait = partnerVoiceSettleMs.value + 120;
  setTimeout(() => {
    if (serial != settleSerial || !offsetIsMid()) {
      return;
    }
    partnerVoiceDragging.value = false;
    partnerVoiceScrollLock.value = false;
    tracking = false;
    axis = "";
    partnerVoiceSettleMs.value = 0;
    partnerVoiceOpen.value = open;
    partnerVoiceOffset.value = open ? partnerVoiceMaxOffset() : 0;
    partnerVoicePaint.value = partnerVoicePaint.value + 1;
  }, paintWait);
}

/** 方向已经丢了时，按当前位移决定全开还是全关。正在关的用剩余 30%，正在开的用滑过 30%。 */
function partnerVoiceRestingOpen(offset: number): boolean {
  const max = partnerVoiceMaxOffset();
  if (max <= 0) {
    return false;
  }
  const closing = startOffset > max * 0.5;
  if (closing) {
    return offset > max * (1 - partnerVoiceCommitRatio);
  }
  return offset >= max * partnerVoiceCommitRatio;
}

function finishSettleAnimation(serial: number, epoch: number): boolean {
  if (serial != settleSerial || epoch != gestureEpoch || !hasPendingSettle) {
    return false;
  }
  tracking = false;
  axis = "";
  velocity = 0;
  partnerVoiceDragging.value = false;
  partnerVoiceScrollLock.value = false;
  hasPendingSettle = false;
  cancelPartnerVoiceRestWatch();
  commitPartnerVoiceSettle(pendingSettleOpen);
  return true;
}

/** 只在松手后把抽屉收到全开或全关。跟手过程中不调用。 */
function schedulePartnerVoiceSettle(open: boolean): void {
  hasPendingSettle = true;
  pendingSettleOpen = open;
  settleSerial = settleSerial + 1;
  const serial = settleSerial;
  const epoch = gestureEpoch;
  partnerVoiceDragging.value = false;
  partnerVoiceScrollLock.value = false;
  tracking = false;
  axis = "";
  partnerVoiceSettleMs.value = settleDurationMs(open);
  nextTick(() => {
    finishSettleAnimation(serial, epoch);
  });
  const fallbackMs = partnerVoiceSettleFallbackMs + (partnerVoiceMoveIdleMs > 0 ? 0 : 0);
  setTimeout(() => {
    if (serial != settleSerial || epoch != gestureEpoch) {
      return;
    }
    finishSettleAnimation(serial, epoch);
  }, fallbackMs);
}

function notePartnerVoiceMotion(): void {
  lastMoveAt = Date.now();
}

/** 宽度变化后，已打开的录音层继续铺满；没有手指按下时不许停在半路。 */
export function syncPartnerVoiceOffsetToWidth(): void {
  if (tracking || partnerVoiceDragging.value || hasPendingSettle) {
    return;
  }
  const max = partnerVoiceMaxOffset();
  const offset = partnerVoiceOffset.value;
  if (partnerVoiceOpen.value) {
    if (offset != max) {
      partnerVoiceOffset.value = max;
    }
    return;
  }
  if (offset <= 0) {
    return;
  }
  if (offset >= max) {
    partnerVoiceOffset.value = 0;
    return;
  }
  commitPartnerVoiceSettle(partnerVoiceRestingOpen(offset));
}

export function setPartnerVoiceRecording(recording: boolean): void {
  partnerVoiceRecording.value = recording;
}

/** 麦克风点击：先无动画把录音页放在左边，再把伙伴页连底栏滑到右侧。 */
export function openPartnerVoiceDrawer(): void {
  if (partnerVoiceRecordEnabled != true) {
    return;
  }
  gestureEpoch = gestureEpoch + 1;
  const epoch = gestureEpoch;
  hasPendingSettle = false;
  cancelPartnerVoiceRestWatch();
  cancelPartnerVoiceAliveTimer();
  partnerVoiceDragging.value = false;
  partnerVoiceScrollLock.value = false;
  tracking = false;
  axis = "";
  hapticPast = true;
  partnerVoiceOpen.value = true;
  const max = partnerVoiceMaxOffset();
  const wasAlive = partnerVoiceAlive.value;
  partnerVoiceAlive.value = true;
  if (partnerVoiceOffset.value >= max) {
    partnerVoiceSnapless.value = false;
    return;
  }
  if (!wasAlive) {
    partnerVoiceSnapless.value = true;
    partnerVoiceOffset.value = 0;
  }
  partnerVoiceSettleMs.value = 320;
  nextTick(() => {
    if (epoch != gestureEpoch) {
      return;
    }
    partnerVoiceSnapless.value = false;
    nextTick(() => {
      if (epoch != gestureEpoch) {
        return;
      }
      partnerVoiceOffset.value = partnerVoiceMaxOffset();
    });
  });
}

/** 录音层返回，或切离伙伴页。 */
export function closePartnerVoiceDrawer(): void {
  gestureEpoch = gestureEpoch + 1;
  hasPendingSettle = false;
  cancelPartnerVoiceRestWatch();
  partnerVoiceDragging.value = false;
  partnerVoiceScrollLock.value = false;
  tracking = false;
  axis = "";
  velocity = 0;
  hapticPast = false;
  partnerVoiceOffset.value = 0;
  partnerVoiceOpen.value = false;
  schedulePartnerVoiceUnmount();
}


export function beginPartnerVoiceDrag(x: number, y: number): number {
  if (partnerVoiceRecordEnabled != true) {
    return dragToken;
  }
  const now = Date.now();
  // 同一次按下会冒泡到多层。不换代号，否则先到的 touchend 会被当成过期。
  if (tracking && now - lastBeginAt <= partnerVoiceBeginDedupeMs) {
    notePartnerVoiceMotion();
    return dragToken;
  }
  cancelPartnerVoiceAliveTimer();
  const stolen = tracking;
  dragToken = dragToken + 1;
  lastBeginAt = now;
  notePartnerVoiceMotion();
  tracking = true;
  startX = x;
  startY = y;
  startOffset = partnerVoiceOffset.value;
  beginTime = now;
  lastX = x;
  lastTime = now;
  if (!stolen) {
    axis = "";
    velocity = 0;
    hapticPast = partnerVoiceRestingOpen(startOffset);
    partnerVoiceScrollLock.value = false;
    partnerVoiceFromRecord.value = partnerVoiceOpen.value || startOffset > 1;
    return dragToken;
  }
  // 录音层滑到手指下面时，新的一层会接走这次触摸。保持横滑轴，继续 1:1 跟手。
  hasPendingSettle = false;
  settleSerial = settleSerial + 1;
  cancelPartnerVoiceRestWatch();
  return dragToken;
}

/** 比系统 light 更短、幅度更低。安卓 light 仍接近满幅短震。 */
const partnerVoiceHapticMs = 8;
const partnerVoiceHapticAmplitude = 28;

// #ifdef APP-ANDROID
function androidVibrator(): Vibrator | null {
  const context = UTSAndroid.getAppContext();
  if (context == null) {
    return null;
  }
  if (Build.VERSION.SDK_INT >= 31) {
    const manager = context.getSystemService(Context.VIBRATOR_MANAGER_SERVICE) as VibratorManager | null;
    if (manager == null) {
      return null;
    }
    return manager.getDefaultVibrator();
  }
  return context.getSystemService(Context.VIBRATOR_SERVICE) as Vibrator | null;
}
// #endif

function pulsePartnerVoiceHaptic(): void {
  // #ifdef APP-ANDROID
  try {
    const vibrator = androidVibrator();
    if (vibrator != null && vibrator.hasVibrator()) {
      if (Build.VERSION.SDK_INT >= 26) {
        vibrator.vibrate(VibrationEffect.createOneShot(partnerVoiceHapticMs.toLong(), partnerVoiceHapticAmplitude.toInt()));
      } else {
        vibrator.vibrate(partnerVoiceHapticMs.toLong());
      }
      return;
    }
  } catch (_error) {
    // 取不到震动器时走下面的系统短震。
  }
  // #endif
  try {
    uni.vibrateShort({
      type: "light",
      fail: (_err) => {
        // 个别机型没有震动器，忽略即可。
      },
    });
  } catch (_error) {
    // ignore
  }
}

/** 右滑越过 30% 线时轻震一下；退回线内再震一下。左滑不震。 */
function syncPartnerVoiceHaptic(): void {
  if (!partnerVoiceDragging.value) {
    return;
  }
  const passed = partnerVoiceRestingOpen(partnerVoiceOffset.value);
  if (passed == hapticPast) {
    return;
  }
  hapticPast = passed;
  if (startOffset <= partnerVoiceMaxOffset() * 0.5) {
    pulsePartnerVoiceHaptic();
  }
}

function applyPartnerVoiceOffset(next: number): void {
  const max = partnerVoiceMaxOffset();
  let clamped = next;
  if (clamped < 0) {
    clamped = 0;
  }
  if (clamped > max) {
    clamped = max;
  }
  partnerVoiceOffset.value = clamped;
  syncPartnerVoiceHaptic();
}

/**
 * 方向还混在一起时，最多再等这么远。
 * 右滑已经明显比上下滑大时不必等满：等满 8px 页面才突然跟上，手感会顿一下；
 * 拖到系统触摸容差（大约 8px，再晚到 18px）列表会把这次手势截走。
 */
function partnerVoiceDecideAt(): number {
  return 8;
}

/** 右滑明显大于上下滑时提前跟手。距离更短，第一帧追上手指的跳跃也更小。 */
function partnerVoiceEarlyHorizontal(dx: number, dy: number): boolean {
  const adx = Math.abs(dx);
  const ady = Math.abs(dy);
  return adx >= 3 && adx > ady * 1.25;
}

/** 面板只要露出一条，左右滑都只负责把它开全或关全，不看录音、补传。 */
function partnerVoiceCanDrag(dx: number): boolean {
  const max = partnerVoiceMaxOffset();
  const offset = partnerVoiceOffset.value;
  const exposed = partnerVoiceOpen.value || offset > 1;
  if (dx < 0 && exposed) {
    return true;
  }
  if (dx > 0 && offset < max - 1) {
    return true;
  }
  return false;
}

/**
 * 跟手移动。返回 true 表示这次触摸已锁定为左右滑，调用方应阻止列表把它当成下拉。
 * 坐标用屏幕坐标：页面自己在 translateX，用相对坐标会越滑越滞。
 */
export function movePartnerVoiceDrag(x: number, y: number): boolean {
  if (!tracking) {
    return false;
  }
  const dx = x - startX;
  const dy = y - startY;
  if (axis == "") {
    const adx = Math.abs(dx);
    const ady = Math.abs(dy);
    const decideAt = partnerVoiceDecideAt();
    const earlyHorizontal = partnerVoiceEarlyHorizontal(dx, dy);
    if (!earlyHorizontal && adx < decideAt && ady < decideAt) {
      return false;
    }
    const horizontal = earlyHorizontal || adx > ady;
    if (horizontal && partnerVoiceCanDrag(dx)) {
      axis = "h";
      // 手指已经接管位移，上一次松手的决定作废，改由这次松手重新结算。
      hasPendingSettle = false;
      settleSerial = settleSerial + 1;
      cancelPartnerVoiceRestWatch();
      partnerVoiceAlive.value = true;
      partnerVoiceDragging.value = true;
      partnerVoiceScrollLock.value = true;
    } else if (!horizontal) {
      axis = "v";
      return false;
    } else {
      return false;
    }
  }
  if (axis != "h") {
    return false;
  }
  const now = Date.now();
  const dt = now - lastTime;
  if (dt > 0) {
    velocity = (x - lastX) / dt;
  }
  lastX = x;
  lastTime = now;
  notePartnerVoiceMotion();
  applyPartnerVoiceOffset(startOffset + dx);
  return true;
}

/**
 * 松手吸附。x/y 为抬手屏幕坐标，中间的 touchmove 被列表吃掉时仍按整段位移结算。
 * 传负数表示没有坐标。轻点不关闭，避免误触录音按钮。
 * 返回值保持 void：改成 boolean 后，未使用返回值的调用会按旧签名查找而报 NoSuchMethodError。
 */
export function endPartnerVoiceDrag(x: number, y: number, token: number): void {
  if (token != dragToken) {
    return;
  }
  if (!tracking) {
    partnerVoiceClaimed = false;
    // 抬手已经丢过一次：再来的结束事件如果还停在半路，立刻收到两端之一。
    if (!hasPendingSettle && !partnerVoiceDragging.value && offsetIsMid()) {
      schedulePartnerVoiceSettle(partnerVoiceRestingOpen(partnerVoiceOffset.value));
    }
    return;
  }
  if (x >= 0 && y >= 0 && axis != "v") {
    const dx = x - startX;
    const dy = y - startY;
    const decideAt = partnerVoiceDecideAt();
    const horizontal = Math.abs(dx) > Math.abs(dy) && Math.abs(dx) >= decideAt;
    if (axis == "" && horizontal && partnerVoiceCanDrag(dx)) {
      axis = "h";
      hasPendingSettle = false;
      partnerVoiceAlive.value = true;
      partnerVoiceDragging.value = true;
    }
    if (axis == "h") {
      const now = Date.now();
      const span = now - beginTime;
      if (span > 0) {
        const average = dx / span;
        if (Math.abs(average) > Math.abs(velocity)) {
          velocity = average;
        }
      }
      applyPartnerVoiceOffset(startOffset + dx);
    }
  }
  const wasHorizontal = axis == "h";
  if (wasHorizontal) {
    syncPartnerVoiceHaptic();
  }
  tracking = false;
  axis = "";
  partnerVoiceDragging.value = false;
  partnerVoiceScrollLock.value = false;
  if (!wasHorizontal) {
    velocity = 0;
    const max = partnerVoiceMaxOffset();
    const offset = partnerVoiceOffset.value;
    const shouldSettle = hasPendingSettle || (offset > 0 && offset < max);
    partnerVoiceClaimed = shouldSettle;
    if (hasPendingSettle) {
      const serial = settleSerial;
      const epoch = gestureEpoch;
      nextTick(() => {
        finishSettleAnimation(serial, epoch);
      });
    } else if (shouldSettle) {
      schedulePartnerVoiceSettle(partnerVoiceRestingOpen(offset));
    } else if (!partnerVoiceOpen.value && offset <= 0) {
      schedulePartnerVoiceUnmount();
    }
    return;
  }
  const displacement = partnerVoiceOffset.value - startOffset;
  const flicked = displacement * velocity > 0 && Math.abs(velocity) > partnerVoiceFlickSpeed && Math.abs(displacement) >= partnerVoiceFlickDistance;
  let open = hapticPast;
  const flickOpen = velocity > 0;
  if (flicked && flickOpen != open) {
    open = flickOpen;
    hapticPast = open;
    if (flickOpen) {
      pulsePartnerVoiceHaptic();
    }
  }
  velocity = 0;
  schedulePartnerVoiceSettle(open);
  partnerVoiceClaimed = true;
}

/** 取走最近一次松手是否为横滑，取走后清掉。 */
export function takePartnerVoiceClaim(): boolean {
  const claimed = partnerVoiceClaimed;
  partnerVoiceClaimed = false;
  return claimed;
}
