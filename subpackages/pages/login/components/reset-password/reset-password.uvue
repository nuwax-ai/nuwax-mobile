        /* #ifdef H5 */
        overflow: auto;
        /* #endif */
        /* #ifndef H5 */
        overflow: hidden;
        /* #endif */
        display: flex;
        flex-direction: column;
    }

    .captcha-verify-header {
        width: 100%;
    }

    .back-box {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        width: 58rpx;
        height: 58rpx;
        background-color: rgba(12, 20, 102, 0.04);
        border-radius: 50%;
    }

    .back-icon {
        color: #333;
    }

    .captcha-verify-content {
        width: 100%;
        /* #ifdef H5 */
        overflow: auto;
        /* #endif */
        /* #ifndef H5 */
        overflow: hidden;
        /* #endif */
    }

    .title {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: center;
        margin-bottom: 24rpx;
    }

    .title-text {
        width: 100%;
        font-size: 40rpx;
        line-height: 64rpx;
        font-weight: 600;
        color: #15171f;
        text-align: center;
    }

    .phone-info {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: center;
        margin-bottom: 80rpx;
    }

    .phone-info-text {
        width: 100%;
        font-size: 28rpx;
        line-height: 44rpx;
        font-weight: 400;
        color: rgba(21, 23, 31, 0.7);
        text-align: center;
    }

    .password-input-wrapper {
        height: 80rpx;
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 0 24rpx;
        margin-bottom: 24rpx;
        position: relative;
        border: 2rpx solid #e7e7eb;
        transition: border-color 0.3s ease;
        display: flex;
        flex-direction: row;
        align-items: center;
        // justify-content: center;
    }

    // vapor: :focus-within 伪类运行时丢弃，聚焦边框改 ref + 条件类（模板 :class 绑 pwdFocused/confirmFocused）
    .password-input-wrapper--focus {
        border-color: #5147FF;
    }

    .password-input {
        width: 100%;
        height: 76rpx;
        background-color: #ffffff;
        border: none;
        /* #ifndef APP */
        outline: none;
        /* #endif */
        font-size: 30rpx;
        color: #15171f;
        font-weight: 400;
        line-height: 48rpx;
        padding-right: 60rpx;
        /* #ifndef APP */
        caret-color: #5147FF;
        cursor-color: #5147FF;
        /* #endif */
    }

    .login-input-placeholder {
        color: #b9bbc5;
        font-size: 30rpx;
        font-weight: 400;
    }

    .clear-btn {
        position: absolute;
        right: 32rpx;
        top: 50%;
        transform: translateY(-50%);
        /* #ifndef APP */
        cursor: pointer;
        /* #endif */
    }

    .clear-icon {
        color: #b2b4b8;
        font-size: 32rpx;
    }

    .reset-btn {
        width: 100%;
        height: 82rpx;
        border-radius: 16rpx;
        margin-top: 32rpx;
        padding: 0 24rpx;
        font-size: 32rpx;
        font-weight: 400;
        margin-bottom: 24rpx;
        line-height: 82rpx;
        text-align: center;
        background: #5147ff;
        color: #ffffff;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        border: none;
    }

    .reset-btn-text {
        font-size: 32rpx;
        line-height: 44rpx;
        font-weight: 400;
        color: #ffffff;
        text-align: center;
    }

    .reset-btn::after {
        border-width: 0;
    }

    .reset-btn:disabled {
        background-color: #5147ff;
        opacity: 0.7;
        /* #ifndef APP */
        cursor: not-allowed;
        /* #endif */
    }

    /* #ifndef APP */
    @keyframes rotate {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
    /* #endif */
</style>
