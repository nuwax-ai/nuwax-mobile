<template>
  <!-- 待发图片暂存条缩略图的 loading 环：垫在 <image> 下面（图片未解码时透出，上屏即整块
       盖住），所以不需要 @load 记录加载态。
       ★为什么单独成组件：宿主 chat.uvue 的模板不能再新增顶层引用（渲染 lambda 255 捕获
       上限），也不能让转圈由页面级 ref 驱动——那会每 3.2s 整页重渲一次（选着图打字时
       iOS 中文组字会被打断）。本组件自驱动 transition，只重渲自己这一小块。
       ★绝对铺满父盒（暂存格 .chat-staged__item 是 position: relative），不参与布局。 -->
  <view class="chat-staged-spinner">
    <view class="chat-staged-spinner__ring" :style="ringStyle" />
  </view>
</template>

<script lang="uts" setup>
  import { computed, onUnmounted, ref } from "vue";

  // ===== 转圈环（照搬 chat-locate-loading / chat.uvue 图片 loading 环的配方）=====
  // App 端 CSS animation 不可靠——旋转由 inline style 注入的 transform + transition-duration
  // 完成。起转段=单圈短 tick（800ms，首帧就有可见弧线）；稳态段=4 圈长 tick（3200ms），
  // JS→native 桥接降频 4 倍。两段周期不同，setInterval 定周期接不上，用链式 setTimeout 自续。
  const SPIN_PERIOD_MS: number = 800;
  const SPIN_CYCLES_PER_TICK: number = 4;

  const spinDeg = ref<number>(0);
  /** 当前过渡弧时长（起转 800ms / 稳态 3200ms）。非 ref：只在 tick 里改，值由随后
   *  deg 变更驱动的重渲染带上（模板对 deg 的响应依赖不变）。 */
  let spinArcMs = SPIN_PERIOD_MS;
  let spinTickTimer = 0;
  let spinStartTimer = 0;

  /** 环 inline style：旋转角+过渡时长+高亮弧颜色。返回 UTSJSONObject（不是样式串）——
   *  App-Android 串内 border 颜色解析不可靠（会回落平台默认黑边）。灰取 #94929c：
   *  在 #f2f3f5 灰底上可见但不扎眼，与消息图片 loading 环同色。 */
  const ringStyle = computed((): UTSJSONObject => {
    const style = new UTSJSONObject();
    style["transform"] = `rotate(${spinDeg.value}deg)`;
    style["transitionDuration"] = `${spinArcMs}ms`;
    style["borderTopColor"] = "#94929c";
    style["borderRightColor"] = "#94929c";
    return style;
  });

  function clearSpinTimers(): void {
    if (spinTickTimer != 0) {
      clearTimeout(spinTickTimer);
      spinTickTimer = 0;
    }
    if (spinStartTimer != 0) {
      clearTimeout(spinStartTimer);
      spinStartTimer = 0;
    }
  }

  /** 稳态段自续：到点抬 4 圈角、切长弧时长并按同周期续下一段。 */
  function scheduleSpinSteadyTick(): void {
    spinTickTimer = setTimeout(() => {
      spinArcMs = SPIN_PERIOD_MS * SPIN_CYCLES_PER_TICK;
      spinDeg.value = spinDeg.value + 360 * SPIN_CYCLES_PER_TICK;
      scheduleSpinSteadyTick();
    }, spinArcMs);
  }

  // setup 即开转：组件随暂存格常驻（图片上屏后环被盖住、不可见，但定时器仍在跑——一条
  // 3.2s 的 setTimeout，开销可忽略；换来「无需任何加载态，也就不加模板引用」）。
  // 起转：先落 0 度，等一拍节点就绪再抬 360（首帧有 transition 才转得起来）。
  spinStartTimer = setTimeout(() => {
    spinStartTimer = 0;
    spinDeg.value = 360;
    scheduleSpinSteadyTick();
  }, 50);

  onUnmounted(() => {
    clearSpinTimers();
  });
</script>

<style lang="scss" scoped>
  /* 绝对铺满暂存格：环居中、不参与布局。命中上不用管——缩略图 70×70 整块盖在它上面，
     点按先到缩略图（删除键更在其后），本盒收不到触摸 */
  .chat-staged-spinner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* 四边 border 用 longhand：高亮弧颜色（top/right）由 ringStyle inline 注入，class 内
     给同色兜底（inline 通道失效时不回落平台默认黑边——chat.uvue chat-img-spin 同款） */
  .chat-staged-spinner__ring {
    width: 20px;
    height: 20px;
    box-sizing: border-box;
    border-radius: 100px;
    flex-shrink: 0;
    border-top-width: 2px;
    border-top-style: solid;
    border-top-color: #94929c;
    border-right-width: 2px;
    border-right-style: solid;
    border-right-color: #94929c;
    border-bottom-width: 2px;
    border-bottom-style: solid;
    border-bottom-color: transparent;
    border-left-width: 2px;
    border-left-style: solid;
    border-left-color: transparent;
  }
</style>
