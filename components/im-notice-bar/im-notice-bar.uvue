<template>
  <!-- 新消息顶部横幅：fixed 覆盖层（各非消息 tab 页挂载，消息页不挂）。
       数据/显隐/计时全在 utils/imNoticeBar.uts 模块单例，组件只读渲染保持 dumb。 -->
  <view
    v-if="visible"
    class="im-notice"
    :style="{ top: barTopPx + 'px' }"
    @click="handleTap"
  >
    <view class="im-notice__avatar-wrap">
      <!-- 圆角裁剪由外层 view 承担（Android <image> 裁不住 SVG 的既有坑，同 mine 头像结构） -->
      <image
        v-if="notice.avatar.length > 0"
        class="im-notice__avatar"
        :src="notice.avatar"
        mode="aspectFill"
        :fade-show="false"
      />
      <view v-else class="im-notice__avatar im-notice__avatar--ph">
        <text class="im-notice__ph">{{ placeholderChar }}</text>
      </view>
    </view>
    <view class="im-notice__main">
      <text class="im-notice__title text-ellipsis">{{ notice.title }}</text>
      <text class="im-notice__digest text-ellipsis">{{ notice.digest }}</text>
    </view>
    <view class="im-notice__close" @click.stop="handleClose">
      <text class="im-notice__close-x">×</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from "vue";
import { imNoticeData, imNoticeVisible, hideImNoticeBar } from "@/utils/imNoticeBar";
import { getStatusBarHeight, getEmbeddedStatusBarHeight } from "@/utils/system.uts";

/** 横幅数据（模块级 ref 单例，恒非空实例；显隐拆在 imNoticeVisible）。 */
const notice = imNoticeData;
/** 横幅显隐（模块 gate 链控制）。 */
const visible = imNoticeVisible;

/** H5 内嵌页状态栏高度（reactive：URL fragment 注入晚于首帧也能自动补上；0 = 浏览器直开）。 */
const embeddedStatusBarPx = getEmbeddedStatusBarHeight();

/** 横幅 top：状态栏之下留 6px 呼吸位（App/小程序=系统状态栏；H5=内嵌注入高度）。 */
const barTopPx = computed((): number => {
  // #ifdef MP-WEIXIN || APP
  return getStatusBarHeight() + 6;
  // #endif
  // #ifdef H5 || WEB
  return embeddedStatusBarPx.value + 6;
  // #endif
  // #ifndef MP-WEIXIN || APP || H5 || WEB
  return 6;
  // #endif
});

/** 头像占位字符：标题首字符（大写）。 */
const placeholderChar = computed((): string => {
  const data = imNoticeData.value;
  if (data.title.length == 0) {
    return "#";
  }
  return data.title.substring(0, 1).toUpperCase();
});

/** 点击横幅：隐藏 + 直达对应会话（与 message.uvue openConversation 同构）。 */
function handleTap(): void {
  if (imNoticeVisible.value != true) {
    return;
  }
  const data = imNoticeData.value;
  hideImNoticeBar();
  uni.navigateTo({
    url:
      `/pages/message/chat?convId=${data.convId}&convType=${data.convType}` +
      `&name=${encodeURIComponent(data.title)}` +
      `&avatar=${encodeURIComponent(data.avatar)}`,
    fail: (_err) => {
      // 吞 locked（连点/页面跳转中）；无障碍下不重试
    },
  });
}

/** 关闭钮：只关不跳（.stop 防冒泡触发 handleTap）。 */
function handleClose(): void {
  hideImNoticeBar();
}
</script>

<style lang="scss">
.im-notice {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  z-index: 999;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: rgba(33, 35, 42, 0.94);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.16);
}

.im-notice__avatar-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.im-notice__avatar {
  width: 76rpx;
  height: 76rpx;
}

.im-notice__avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #4c5bd4;
}

.im-notice__ph {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.im-notice__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  margin-right: 8rpx;
  overflow: hidden;
}

.im-notice__title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.im-notice__digest {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.im-notice__close {
  padding: 8rpx 8rpx 8rpx 20rpx;
  flex-shrink: 0;
}

.im-notice__close-x {
  color: rgba(255, 255, 255, 0.8);
  font-size: 32rpx;
}
</style>
