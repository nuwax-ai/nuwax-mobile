/**
 * Android 兼容：API / JSON 数据需通过 class 构造 MessageInfo，禁止 UTSJSONObject as MessageInfo。
 */
import {
  MessageInfo,
  ProcessingInfo,
  ConversationFinalResult,
  markdownElItem,
  AttachmentFile,
  MessageQuestionExtInfo,
} from "@/types/interfaces/conversationInfo";
import {
  AssistantRoleEnum,
  MessageTypeEnum,
  MessageModeEnum,
} from "@/types/enums/agent";
import { MessageStatusEnum } from "@/types/enums/common";

function parseAssistantRole(val: any | null): AssistantRoleEnum {
  if (val == null) return AssistantRoleEnum.USER;
  const s = `${val}`;
  if (s == "ASSISTANT") return AssistantRoleEnum.ASSISTANT;
  if (s == "SYSTEM") return AssistantRoleEnum.SYSTEM;
  if (s == "FUNCTION") return AssistantRoleEnum.FUNCTION;
  return AssistantRoleEnum.USER;
}

function parseMessageMode(val: any | null): MessageModeEnum | null {
  if (val == null) return null;
  const s = `${val}`;
  if (s == "CHAT") return MessageModeEnum.CHAT;
  if (s == "THINK") return MessageModeEnum.THINK;
  if (s == "GUID") return MessageModeEnum.GUID;
  if (s == "QUESTION") return MessageModeEnum.QUESTION;
  if (s == "ANSWER") return MessageModeEnum.ANSWER;
  return null;
}

function parseMessageType(val: any | null): MessageTypeEnum {
  if (val == null) return MessageTypeEnum.USER;
  const s = `${val}`;
  if (s == "ASSISTANT") return MessageTypeEnum.ASSISTANT;
  if (s == "SYSTEM") return MessageTypeEnum.SYSTEM;
  if (s == "TOOL") return MessageTypeEnum.TOOL;
  return MessageTypeEnum.USER;
}

function parseMessageStatus(val: any | null): MessageStatusEnum | null {
  if (val == null) return null;
  const s = `${val}`;
  if (s == "loading") return MessageStatusEnum.Loading;
  if (s == "incomplete") return MessageStatusEnum.Incomplete;
  if (s == "complete") return MessageStatusEnum.Complete;
  if (s == "error") return "error" as MessageStatusEnum;
  return null;
}

export class MessageInfoClass implements MessageInfo {
  id: number | string = 0;
  role: AssistantRoleEnum = AssistantRoleEnum.USER;
  type: MessageModeEnum | null = null;
  text: string | null = null;
  think: string | null = null;
  time: string = "";
  attachments: AttachmentFile[] | null = null;
  ext: MessageQuestionExtInfo[] | null = null;
  finished: boolean | null = null;
  metadata: any | null = null;
  messageType: MessageTypeEnum = MessageTypeEnum.USER;
  requestId: string | null = null;
  index: number | null = null;
  status: MessageStatusEnum | null = null;
  finalResult: ConversationFinalResult | null = null;
  processingList: ProcessingInfo[] | null = null;
  markdownElList: markdownElItem[] | null = null;
  componentExecutedList: any | null = null;
  mcpAskInteractions: any | null = null;

  constructor(raw: UTSJSONObject) {
    if (raw == null) return;
    this.id = (raw["id"] as number | string | null) ?? 0;
    this.role = parseAssistantRole(raw["role"]);
    this.type = parseMessageMode(raw["type"]);
    const textRaw = raw["text"];
    this.text = textRaw != null ? `${textRaw}` : null;
    const thinkRaw = raw["think"];
    this.think = thinkRaw != null ? `${thinkRaw}` : null;
    this.time = (raw["time"] as string | null) ?? "";
    const attachmentsRaw = raw["attachments"];
    this.attachments =
      attachmentsRaw != null ? (attachmentsRaw as AttachmentFile[]) : null;
    const extRaw = raw["ext"];
    this.ext = extRaw != null ? (extRaw as MessageQuestionExtInfo[]) : null;
    const finishedRaw = raw["finished"];
    this.finished = finishedRaw != null ? (finishedRaw as boolean) : null;
    this.metadata = raw["metadata"] ?? null;
    this.messageType = parseMessageType(raw["messageType"]);
    const requestIdRaw = raw["requestId"];
    this.requestId = requestIdRaw != null ? `${requestIdRaw}` : null;
    const indexRaw = raw["index"];
    this.index = indexRaw != null ? (indexRaw as number) : null;
    this.status = parseMessageStatus(raw["status"]);
    const finalResultRaw = raw["finalResult"];
    this.finalResult =
      finalResultRaw != null ? (finalResultRaw as ConversationFinalResult) : null;
    const processingListRaw = raw["processingList"];
    this.processingList =
      processingListRaw != null ? (processingListRaw as ProcessingInfo[]) : null;
    const markdownElListRaw = raw["markdownElList"];
    this.markdownElList =
      markdownElListRaw != null ? (markdownElListRaw as markdownElItem[]) : null;
    this.componentExecutedList = raw["componentExecutedList"] ?? null;
    this.mcpAskInteractions = raw["mcpAskInteractions"] ?? null;
  }
}

export function messageToJsonObject(message: MessageInfo): UTSJSONObject {
  const jsonStr = JSON.stringify(message);
  if (jsonStr == null || jsonStr.length <= 2) {
    return new UTSJSONObject();
  }
  const parsed = JSON.parse<UTSJSONObject>(jsonStr);
  return parsed != null ? parsed : new UTSJSONObject();
}

export function createMessageInfoFromRaw(raw: UTSJSONObject): MessageInfo {
  return new MessageInfoClass(raw);
}

export function cloneMessageInfo(message: MessageInfo): MessageInfo {
  return createMessageInfoFromRaw(messageToJsonObject(message));
}
