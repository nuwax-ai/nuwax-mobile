<template>
  <view class="common-tab-bar" :style="coverStyle">
  <uni-tab-bar class="common-tab-bar__items" style="padding-bottom: 0px; border-top-width: 0px;">
    <uni-tab-item v-for="item in items" :key="item.path">
      <!-- 插槽全尺寸 wrapper：uni-tab 的 changeTab 有同索引守卫，点已激活 tab 不 emit change，
           插槽子 view 的 click 是感知重复点按的唯一通道（官方 uni-tab 示例同构）。
           不加 .stop：先跑本 handler 再冒泡到 item 根完成切 tab，互不影响。 -->
      <view class="common-tab-bar__hit" @click="handleTabItemTap(item.path)">
        <text class="common-tab-bar__label" :class="{ 'common-tab-bar__label--active': item.path == props.activePath }">{{ t(item.key) }}</text>
        <view v-if="badgeCount(item) > 0" class="common-tab-bar__badge">
          <text class="common-tab-bar__badge-text">{{ badgeText(item) }}</text>
        </view>
      </view>
    </uni-tab-item>
  </uni-tab-bar>
  <view class="common-tab-bar__safe-area" :style="safeAreaStyle" />
  </view>
</template>

<script setup lang="uts">
  import { computed } from "vue";
  import { mainTabBarCovered } from "@/utils/mainTabNavigation";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { systemMessageUnreadCount } from "@/utils/notificationBadge";
  import { imTabBadgeCount } from "@/utils/imUnreadBadge";
  import { dispatchMainTabRetap } from "@/hooks/useMainTabLifecycle";

  type CommonTabItem = { path: string; key: string };

  const items: Array<CommonTabItem> = [
    { path: "/pages/message/message", key: "Mobile.Nav.message" },
    { path: "/pages/index/index", key: "Mobile.Nav.task" },
    { path: "/pages/expert-list/expert-list", key: "Mobile.Nav.expert" },
    // #ifndef APP-IOS
    { path: "/pages/app-dev/app-dev", key: "Mobile.Nav.app" },
    // #endif
    { path: "/pages/mine/mine", key: "Mobile.Nav.mine" },
  ];

  // 用路由标识选中项；iOS 隐藏应用后，高亮和角标不依赖视觉序号。
  const props = defineProps<{ activePath: string; bottomInset: number }>();
  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");
  const badgeCount = (item: CommonTabItem): number => {
    // 伙伴：会话未读 + 智联录待我处理；直接复用状态，不新增请求。
    if (item.path == "/pages/message/message") return imTabBadgeCount.value;
    if (item.path == "/pages/mine/mine") return systemMessageUnreadCount.value;
    return 0;
  };
  const badgeText = (item: CommonTabItem): string => {
    const count = badgeCount(item);
    return count > 99 ? "99+" : `${count}`;
  };

  const coverStyle = computed((): string => mainTabBarCovered.value ? "height: 0px; visibility: hidden;" : "");
  const safeAreaStyle = computed((): string => {
    // #ifdef APP
    return `height: ${props.bottomInset}px;`;
    // #endif
    // #ifndef APP
    return "";
    // #endif
  });

  // ===== 双击「伙伴」tab 定位首条未读 =====
  const MESSAGE_TAB_PATH = "/pages/message/message";
  const RETAP_WINDOW_MS = 300;
  let lastMessageTabTapMs = 0;

  function handleTabItemTap(path: string): void {
    if (path != MESSAGE_TAB_PATH) return;
    const now = Date.now();
    if (lastMessageTabTapMs > 0 && now - lastMessageTabTapMs <= RETAP_WINDOW_MS) {
      // 触发即清零：三连击只定位一次
      lastMessageTabTapMs = 0;
      dispatchMainTabRetap(MESSAGE_TAB_PATH);
    } else {
      lastMessageTabTapMs = now;
    }
  }

</script>

<style scoped>
  .common-tab-bar {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: #ffffff;
  }

  .common-tab-bar__items {
    height: 50px;
    flex-shrink: 0;
  }

  .common-tab-bar__safe-area {
    flex-shrink: 0;
    height: 0px;
    background-color: #ffffff;
    /* #ifdef H5 || WEB */
    height: constant(safe-area-inset-bottom);
    height: env(safe-area-inset-bottom, 0px);
    /* #endif */
  }

  .common-tab-bar__hit {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* badge 是 absolute top/right 定位：基准随本层（100% 同盒）平移，几何不变 */
    position: relative;
  }

  .common-tab-bar__label {
    font-size: 35rpx;
    font-weight: 700;
    line-height: 48rpx;
    color: #8a8a93;
  }

  .common-tab-bar__label--active {
    color: #141416;
  }

  .common-tab-bar__badge {
    position: absolute;
    top: 4px;
    right: 12px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    background-color: #ff4d4f;
    align-items: center;
    justify-content: center;
  }

  .common-tab-bar__badge-text {
    font-size: 11px;
    color: #ffffff;
  }

</style>
