/**
 * Android BLE 运行环境预检（仅 APP-ANDROID 引用）。
 *
 * 乐鑫库的 BleScanner.startScan() 只在 `BluetoothAdapter.isEnabled() == false` 时回调
 * scanStartFailed，扫不到设备与蓝牙没开在业务层长得几乎一样。华为/鸿蒙机型上尤其容易踩：
 *  - 系统「附近设备 / 畅连」会把适配器保持在 BLE_ON 底座状态，用户以为蓝牙是开的，
 *    实际主开关是关的，`isEnabled()` 返回 false，配网一进来就失败；
 *  - 蓝牙运行时权限（BLUETOOTH_SCAN/CONNECT）多半早已授予，全程不会有任何授权弹窗，
 *    用户只看到「配网失败」，无从下手。
 * 因此在发起扫描前先探测环境，把「去开蓝牙 / 去开位置信息」这类可执行动作直接给到用户。
 */

// #ifdef APP-ANDROID
import BluetoothAdapter from 'android.bluetooth.BluetoothAdapter';
import Context from 'android.content.Context';
import Intent from 'android.content.Intent';
import LocationManager from 'android.location.LocationManager';
import Build from 'android.os.Build';
import Settings from 'android.provider.Settings';
// #endif

// #ifdef APP-ANDROID
/** 蓝牙主开关是否打开（BLE_ON 底座状态同样返回 false，与乐鑫库的判定保持一致）。 */
export function isAndroidBluetoothEnabled(): boolean {
  try {
    const adapter = BluetoothAdapter.getDefaultAdapter();
    if (adapter == null) return false;
    return adapter!!.isEnabled();
  } catch (e) {
    return false;
  }
}

/** 当前机型是否有蓝牙适配器（模拟器 / 部分定制机可能没有）。 */
export function hasAndroidBluetoothAdapter(): boolean {
  try {
    return BluetoothAdapter.getDefaultAdapter() != null;
  } catch (e) {
    return false;
  }
}

/** 系统「位置信息」总开关是否打开。 */
export function isAndroidLocationEnabled(): boolean {
  try {
    const context = UTSAndroid.getAppContext();
    if (context == null) return true;
    const manager = context!!.getSystemService(Context.LOCATION_SERVICE) as LocationManager;
    return manager.isProviderEnabled(LocationManager.GPS_PROVIDER)
      || manager.isProviderEnabled(LocationManager.NETWORK_PROVIDER);
  } catch (e) {
    return true;
  }
}

/**
 * 该 ROM 的 BLE 扫描是否**可能**依赖「位置信息」总开关。
 * Android 12+ 声明 BLUETOOTH_SCAN + neverForLocation 后原生 AOSP 不再要求定位，
 * 但华为 / 荣耀 ROM 上位置总开关关闭时扫不到广播的反馈很常见，且扫描不会报错。
 * 未在真机上取得确证前，这里只用于「扫描窗口超时后」的归因提示，
 * **不要**拿它在扫描前硬拦截——万一该机型其实不需要定位，就会把本可成功的配网挡死。
 */
export function androidBleScanNeedsLocation(): boolean {
  if (Build.VERSION.SDK_INT < 31) return true;
  const vendor = `${Build.MANUFACTURER}${Build.BRAND}`.toLowerCase();
  return vendor.indexOf('huawei') >= 0 || vendor.indexOf('honor') >= 0;
}

/** 诊断日志用的一行环境摘要（不含任何用户数据）。 */
export function androidBleEnvironmentSummary(): string {
  return `brand=${Build.BRAND} model=${Build.MODEL} sdk=${Build.VERSION.SDK_INT}`
    + ` btAdapter=${hasAndroidBluetoothAdapter()} btEnabled=${isAndroidBluetoothEnabled()}`
    + ` location=${isAndroidLocationEnabled()} locationRequired=${androidBleScanNeedsLocation()}`;
}

/** 拉起系统蓝牙设置页；返回是否成功跳转。 */
export function openAndroidBluetoothSettings(): boolean {
  return startSettingsActivity(Settings.ACTION_BLUETOOTH_SETTINGS);
}

/** 拉起系统定位设置页；返回是否成功跳转。 */
export function openAndroidLocationSettings(): boolean {
  return startSettingsActivity(Settings.ACTION_LOCATION_SOURCE_SETTINGS);
}

function startSettingsActivity(action: string): boolean {
  try {
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) return false;
    const intent = new Intent(action);
    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
    activity!!.startActivity(intent);
    return true;
  } catch (e) {
    return false;
  }
}
// #endif
