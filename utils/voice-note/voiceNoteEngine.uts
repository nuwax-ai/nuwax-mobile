/**
 * 伙伴页录音会话。
 * App 使用独立的 VoiceNoteM4aRecorder。一次会话只有一个采集器，每段单独写成 m4a，不经过聊天页的 PCM 采集。
 * 录音器挂在模块上，不随页面卸载停止。退到后台继续录。切段只封口当前文件并打开下一份，不释放采集器。
 * 主按钮只暂停或继续，不结束会话，也不落盘。当前段满 2 分钟，或点完成，才落盘并上传。
 */
import {
  findOpenVoiceNote,
  loadBackfillGate,
  loadVoiceNotes,
  removeVoiceNote,
  saveBackfillGate,
  upsertVoiceNote,
  VoiceNoteBackfillGate,
  VoiceNoteRecord,
  VoiceNoteSegmentRecord,
} from "@/utils/voice-note/voiceNoteStore.uts";
import {
  apiVoiceNoteComplete,
  apiVoiceNoteCreate,
  apiVoiceNoteDelete,
  apiVoiceNoteDetail,
  apiVoiceNoteReprocess,
  apiVoiceNoteUploadSegment,
} from "@/servers/voiceNote.uts";
import { pushVoiceNoteDebug } from "@/utils/voice-note/voiceNoteDebugLog.uts";

// #ifdef APP-ANDROID || APP-IOS
import {
  VoiceNoteM4aRecorder,
  beginVoiceNoteBackground,
  endVoiceNoteBackground,
} from "@/uni_modules/nuwax-stream-pcm-player";
// #endif
// #ifdef APP-HARMONY
import {
  VoiceNoteM4aRecorder,
  beginVoiceNoteBackground,
  endVoiceNoteBackground,
} from "@/uni_modules/nuwax-stream-pcm-player";
// #endif

/**
 * 伙伴页录音切片时长（毫秒）。当前段累计超过这个时间才落盘并上传。
 * 上线用 3600000（1 小时）。测试可改成 120000（2 分钟）。只改这一处。
 */
const segmentMs = 120000;

let recorderBound = false;
// #ifdef APP
let m4aRecorder: VoiceNoteM4aRecorder | null = null;
/** 当前这一段正在写的 m4a 绝对路径。停录后交给上传，不再从 PCM 临时文件拷贝。 */
let currentSegmentPath = "";
let recorderBusy = false;
/** 停录过程中又点了停止或重录时，等这一段收尾后按这个意图处理。 */
let queuedIntent = "";
/** 切段已经打开的下一段路径。采集器不重建。 */
let pendingRotatedPath = "";
/** 原生按实际写入采样算出的刚封口时长。closeSegment 读一次后清零。 */
let closedDurationOverride = 0;
/** 切段过程中点了暂停。新文件打开后再暂停同一个采集器。 */
let pauseAfterRotate = false;
// #endif
/** "" 用户没要求停 / rotate 到点切段 / user 用户停止 / discard 重录放弃 / busy 正在停 */
/** 已经点了完成。暂停或切段的回调不能再把这次录音改回未结束。 */
let sessionEnding = false;
let endingLocalId = "";
let stopIntent = "";
/** 本进程里录音器是否还在写当前段。进程重启后为 false，用来把没停完的段收成最后一段。 */
let captureAlive = false;
let tickTimer = 0;
let lastPersistAt = 0;
/** 本次录音自己的上传是否在进行。不占用补传。 */
let uploadRunning = false;
/** 本次录音上传过程中又落下新分段时，这一轮结束后立刻再传这一次。 */
let uploadRerunLocalId = "";
/** 当前正在上传的本次录音。补传会避开它。 */
let uploadLocalId = "";
/** 补传是否在进行。不占用本次录音的上传。 */
let backfillRunning = false;
/** 总开关这一轮正在补的本地会话。历史记录里的单条补传不写这里。 */
let activeBackfillLocalId = "";
/** 历史列表里正在单独补传的本地会话。同一条不重复开。 */
let historyBackfillLocalIds: string[] = [];
/** 正在创建笔记的本地会话。不同会话可以同时创建，同一条不重复创建。 */
let noteCreateLocalIds: string[] = [];
let pollTimer = 0;

function activeRecord(): VoiceNoteRecord | null {
  const open = findOpenVoiceNote();
  if (open != null && open.phase == "recording") return open;
  return null;
}

function touch(record: VoiceNoteRecord): void {
  upsertVoiceNote(record);
}

function beginBackground(): void {
  pushVoiceNoteDebug("录音", "申请后台录音");
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    beginVoiceNoteBackground();
  } catch (e) {
    console.warn("[voice-note] begin background failed " + e);
  }
  // #endif
}

function endBackground(): void {
  pushVoiceNoteDebug("录音", "结束后台录音");
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  try {
    endVoiceNoteBackground();
  } catch (e) {
    console.warn("[voice-note] end background failed " + e);
  }
  // #endif
}

function copySegmentFile(src: string, localId: string, index: number): Promise<string> {
  const root = `${uni.env.USER_DATA_PATH}/voice-notes/${localId}`;
  const dest = `${root}/${segmentFileName(index)}`;
  const fs = uni.getFileSystemManager();
  return new Promise<string>((resolve) => {
    const copy = () => {
      fs.copyFile({
        srcPath: src,
        destPath: dest,
        success: () => {
          resolve(dest);
        },
        fail: () => {
          resolve(src);
        },
      });
    };
    fs.mkdir({
      dirPath: root,
      recursive: true,
      success: () => {
        copy();
      },
      fail: () => {
        copy();
      },
    });
  });
}

function segmentFileName(index: number): string {
  return `${index}.aac`;
}

/** 录音文件名：当前时间年月日时分秒，再加这一段的序号。 */
function segmentStampName(index: number): string {
  const now = new Date();
  const pad2 = (n: number): string => {
    const text = `${n}`;
    return text.length < 2 ? `0${text}` : text;
  };
  const stamp =
    `${now.getFullYear()}` +
    pad2(now.getMonth() + 1) +
    pad2(now.getDate()) +
    pad2(now.getHours()) +
    pad2(now.getMinutes()) +
    pad2(now.getSeconds());
  return `${stamp}${index}`;
}

async function startRecorder(): Promise<void> {
  const record = activeRecord();
  if (record == null) {
    captureAlive = false;
    return;
  }
  // #ifdef APP
  if (m4aRecorder == null) {
    m4aRecorder = new VoiceNoteM4aRecorder();
  }
  let path = "";
  try {
    path = await m4aRecorder!.start(record.localId, segmentStampName(record.openSegmentIndex));
  } catch (e) {
    console.warn("[voice-note] m4a start failed " + e);
    path = "";
  }
  if (path.length == 0) {
    onNativeError(null);
    return;
  }
  currentSegmentPath = path;
  captureAlive = true;
  const latest = activeRecord();
  if (latest != null) {
    latest.openSegmentPath = path;
    touch(latest);
    bindNoteAfterCapture(latest.localId);
    // 鸿蒙长时任务会校验当前确实在录音，必须等 AVRecorder.start 成功后再申请。
    // #ifdef APP-HARMONY
    beginBackground();
    // #endif
  }
  // #endif
  // #ifndef APP
  captureAlive = true;
  const recorder = uni.getRecorderManager();
  recorder.start({
    duration: 600000,
    sampleRate: 16000,
    numberOfChannels: 1,
    format: "aac",
  });
  // #endif
}

function stopActiveRecorder(intent: string): void {
  captureAlive = false;
  // #ifdef APP
  if (recorderBusy) {
    queuedIntent = intent;
    return;
  }
  recorderBusy = true;
  stopIntent = "busy";
  const path = currentSegmentPath;
  currentSegmentPath = "";
  void finishM4aStop(intent, path);
  // #endif
  // #ifndef APP
  stopIntent = intent;
  uni.getRecorderManager().stop();
  // #endif
}

// #ifdef APP
async function finishM4aStop(intent: string, path: string): Promise<void> {
  let ok = "0";
  let rotatedPath = "";
  if (m4aRecorder != null) {
    try {
      if (intent == "rotate") {
        const recording = activeRecord();
        if (recording != null) {
          const nextName = segmentStampName(recording.openSegmentIndex + 1);
          rotatedPath = await m4aRecorder!.rotate(recording.localId, nextName);
          ok = rotatedPath.length > 0 ? "1" : "0";
        }
      } else {
        ok = await m4aRecorder!.stop();
      }
      if (ok == "1") {
        closedDurationOverride = m4aRecorder!.takeClosedDurationMs();
      }
    } catch (e) {
      console.warn("[voice-note] m4a stop failed " + e);
      ok = "0";
      rotatedPath = "";
    }
  }
  let intentToUse = intent;
  if (queuedIntent.length > 0) {
    intentToUse = queuedIntent;
    queuedIntent = "";
    rotatedPath = "";
  }
  pendingRotatedPath = ok == "1" ? rotatedPath : "";
  recorderBusy = false;
  await handleRecorderStop(intentToUse, ok == "1" ? path : "");
}
// #endif

function ensureTicker(): void {
  if (tickTimer != 0) return;
  tickTimer = setInterval(() => {
    onTick();
  }, 1000);
}

function stopTicker(): void {
  if (tickTimer != 0) {
    clearInterval(tickTimer);
    tickTimer = 0;
  }
}

function openSegmentMs(record: VoiceNoteRecord, now: number): number {
  let extra = 0;
  if (record.segmentStartedAt > 0) {
    extra = now - record.segmentStartedAt;
    if (extra < 0) extra = 0;
  }
  return record.openElapsedMs + extra;
}

function freezeOpenSegment(record: VoiceNoteRecord): void {
  const now = Date.now();
  record.openElapsedMs = openSegmentMs(record, now);
  record.elapsedMs = record.accumulatedMs + record.openElapsedMs;
  record.segmentStartedAt = 0;
}

function onTick(): void {
  const record = activeRecord();
  if (record == null) {
    stopTicker();
    return;
  }
  const now = Date.now();
  const segmentElapsed = openSegmentMs(record, now);
  record.elapsedMs = record.accumulatedMs + segmentElapsed;
  if (now - lastPersistAt >= 2000) {
    lastPersistAt = now;
    touch(record);
  }
  if (segmentElapsed >= segmentMs && stopIntent.length == 0) {
    stopActiveRecorder("rotate");
  }
}

async function closeSegment(record: VoiceNoteRecord, tempPath: string): Promise<number> {
  const index = record.openSegmentIndex;
  const endedAt = Date.now();
  let durationMs = 0;
  // #ifdef APP
  durationMs = closedDurationOverride;
  closedDurationOverride = 0;
  // #endif
  if (durationMs <= 0) {
    durationMs = openSegmentMs(record, endedAt);
  }
  const startedAt = endedAt - durationMs;
  // App 的 m4a 已经写在最终路径上。小程序拿到的是临时 aac，再拷进会话目录。
  let filePath = tempPath;
  // #ifndef APP
  filePath = await copySegmentFile(tempPath, record.localId, index);
  // #endif
  const segment = new VoiceNoteSegmentRecord();
  segment.segmentIndex = index;
  segment.filePath = filePath;
  const duration = durationMs > 0 ? durationMs : 0;
  segment.durationMs = duration;
  segment.startedAt = startedAt;
  segment.endedAt = endedAt;
  segment.uploadStatus = "pending";
  segment.uploadAttempts = 0;
  record.segments.push(segment);
  record.openSegmentIndex = index + 1;
  record.segmentStartedAt = 0;
  record.openElapsedMs = 0;
  record.openSegmentPath = "";
  record.accumulatedMs = record.accumulatedMs + duration;
  record.elapsedMs = record.accumulatedMs;
  touch(record);
  return index;
}

function readErrorMessage(err: any | null): string {
  if (err == null) return "录音失败";
  const obj = err as UTSJSONObject;
  if (obj["errMsg"] != null) return `${obj["errMsg"]}`;
  return "录音失败";
}

function onNativeError(err: any | null): void {
  captureAlive = false;
  stopIntent = "";
  const record = activeRecord();
  if (record == null) {
    releaseRecorderCallbacks();
    return;
  }
  const message = readErrorMessage(err);
  record.phase = "failed";
  record.error = message;
  touch(record);
  endBackground();
  stopTicker();
  releaseRecorderCallbacks();
  uni.showToast({ title: message, icon: "none" });
}

/** App 的 m4a 录音器不占用 RecorderManager。小程序才需要松开那组单例回调。 */
function releaseRecorderCallbacks(): void {
  recorderBound = false;
  // #ifndef APP
  const recorder = uni.getRecorderManager();
  recorder.onStart((_res: any | null) => {});
  recorder.onStop((_res: RecorderManagerOnStopResult) => {});
  recorder.onError((_err: any) => {});
  // #endif
}

function bindRecorder(): void {
  // #ifdef APP
  if (m4aRecorder == null) {
    m4aRecorder = new VoiceNoteM4aRecorder();
  }
  // #endif
  // #ifndef APP
  const recorder = uni.getRecorderManager();
  recorder.onStart((_res: any | null) => {
    const open = activeRecord();
    if (open == null) return;
    bindNoteAfterCapture(open.localId);
  });
  recorder.onStop((res: RecorderManagerOnStopResult) => {
    const intent = stopIntent;
    stopIntent = "busy";
    const path = res.tempFilePath != null ? `${res.tempFilePath}` : "";
    void handleRecorderStop(intent, path);
  });
  recorder.onError((err: any) => {
    onNativeError(err);
  });
  // #endif
  recorderBound = true;
}

/** 录音中或暂停中都还拿着当前文件。点完成时状态往往已是暂停，不能只认录音中。 */
function sessionHoldingFile(): VoiceNoteRecord | null {
  const open = findOpenVoiceNote();
  if (open == null) return null;
  if (open.phase == "recording" || open.phase == "paused") return open;
  return null;
}

function noteByLocalId(localId: string): VoiceNoteRecord | null {
  if (localId.length == 0) return null;
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].localId == localId) return rows[i];
  }
  return null;
}

async function handleRecorderStop(intent: string, tempPath: string): Promise<void> {
  let usedIntent = intent;
  if (sessionEnding && usedIntent != "discard" && usedIntent != "finish") {
    usedIntent = "finish";
  }
  let record = sessionHoldingFile();
  if (record == null && usedIntent == "finish") {
    record = noteByLocalId(endingLocalId);
    if (record == null) record = findOpenVoiceNote();
  }
  if (record == null) {
    stopIntent = "";
    sessionEnding = false;
    endingLocalId = "";
    return;
  }
  if (intent == "discard") {
    // #ifdef APP
    pauseAfterRotate = false;
    pendingRotatedPath = "";
    // #endif
    sessionEnding = false;
    endingLocalId = "";
    record.phase = "discarded";
    touch(record);
    removeVoiceNote(record.localId);
    const noteId = record.noteId;
    endBackground();
    stopTicker();
    releaseRecorderCallbacks();
    if (noteId.length > 0) {
      try {
        await apiVoiceNoteDelete(noteId);
      } catch (_e) {
        // 本地已放弃。服务端会话会在 7 天未收尾后回收。
      }
    }
    return;
  }
  if (usedIntent == "finish") {
    // #ifdef APP
    pauseAfterRotate = false;
    pendingRotatedPath = "";
    // #endif
    let path = tempPath;
    if (path.length == 0 && record.openSegmentPath.length > 0) {
      path = record.openSegmentPath;
    }
    let closedIndex = -1;
    if (path.length > 0) {
      closedIndex = await closeSegment(record, path);
    }
    record.phase = "uploading";
    record.awaitComplete = true;
    record.segmentStartedAt = 0;
    record.openSegmentPath = "";
    touch(record);
    endBackground();
    stopTicker();
    releaseRecorderCallbacks();
    stopIntent = "";
    sessionEnding = false;
    endingLocalId = "";
    void pumpQueue(record.localId, false);
    return;
  }
  const pausing = usedIntent == "user";
  let closedIndex = -1;
  if (tempPath.length > 0) {
    closedIndex = await closeSegment(record, tempPath);
  }
  if (pausing) {
    pushVoiceNoteDebug("录音", "暂停，会话未结束");
    if (sessionEnding) {
      const savedEnding = noteByLocalId(record.localId);
      const ending = savedEnding != null ? savedEnding : record;
      ending.phase = "uploading";
      ending.awaitComplete = true;
      ending.segmentStartedAt = 0;
      ending.openSegmentPath = "";
      touch(ending);
      endBackground();
      stopTicker();
      releaseRecorderCallbacks();
      sessionEnding = false;
      endingLocalId = "";
      void pumpQueue(ending.localId, false);
      return;
    }
    let paused: VoiceNoteRecord | null = null;
    const saved = loadVoiceNotes();
    for (let i = 0; i < saved.length; i++) {
      const row = saved[i];
      if (row != null && row.localId == record.localId) {
        paused = row;
        break;
      }
    }
    const found = paused;
    const target = found != null ? found : record;
    target.phase = "paused";
    target.segmentStartedAt = 0;
    target.openSegmentPath = "";
    target.awaitComplete = false;
    touch(target);
    endBackground();
    stopTicker();
    releaseRecorderCallbacks();
    return;
  }
  // 分段时长已满：当前文件已经封口。采集器仍是原来的那个，下一段文件也已打开。
  void pumpQueue(record.localId, false);
  record.segmentStartedAt = Date.now();
  touch(record);
  stopIntent = "";
  // #ifdef APP
  if (pendingRotatedPath.length > 0) {
    const opened = pendingRotatedPath;
    pendingRotatedPath = "";
    currentSegmentPath = opened;
    record.openSegmentPath = opened;
    captureAlive = true;
    touch(record);
    pushVoiceNoteDebug("录音", "切段，采集器不重建");
    if (pauseAfterRotate) {
      pauseAfterRotate = false;
      await pauseActiveRecorder(record);
    }
    return;
  }
  pendingRotatedPath = "";
  // #endif
  await startRecorder();
}

function findVoiceNoteByLocalId(localId: string): VoiceNoteRecord | null {
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].localId == localId) return rows[i];
  }
  return null;
}

/**
 * 按段号回写上传状态。先重读缓存，避免覆盖停止录音时刚落下的最后一段。
 */
function writeSegmentUpload(
  localId: string,
  segmentIndex: number,
  status: string,
  segmentId: string,
  error: string,
  attempts: number,
): VoiceNoteRecord | null {
  const record = findVoiceNoteByLocalId(localId);
  if (record == null) return null;
  for (let i = 0; i < record.segments.length; i++) {
    const row = record.segments[i];
    if (row.segmentIndex != segmentIndex) continue;
    if (segmentId.length > 0) row.segmentId = segmentId;
    row.error = error;
    row.uploadStatus = status;
    if (attempts >= 0) row.uploadAttempts = attempts;
    if (error.length > 0) {
      record.error = error;
    } else if (status == "uploaded") {
      record.error = "";
    }
    touch(record);
    return record;
  }
  return record;
}

/** 刚落下的一段在同一次上传里连续失败时，最多再试到 3 次，然后留给以后的补传。 */
const maxSegmentUploadAttempts = 3;

/** 两次补传开始时间至少间隔 5 分钟。不满就跳过这次。 */
const backfillGapMs = 300000;

/**
 * 补传只处理还没上传成功的分段。
 * pending 未上传，failed 上传失败，uploading 是上次没传完。
 * uploaded 已成功，不再上传。失败次数不在这里封顶，避免文件永远留在本地。
 */
function segmentCanUpload(row: VoiceNoteSegmentRecord): boolean {
  const status = row.uploadStatus;
  return status == "pending" || status == "failed" || status == "uploading";
}

/** 历史记录触发的补传：正在上传或已经成功的分段不再传。 */
function historySegmentNeedsUpload(row: VoiceNoteSegmentRecord): boolean {
  const status = row.uploadStatus;
  if (status == "uploading" || status == "uploaded") return false;
  return true;
}

function allSegmentsUploaded(record: VoiceNoteRecord): boolean {
  if (record.segments.length <= 0) return false;
  for (let i = 0; i < record.segments.length; i++) {
    if (record.segments[i].uploadStatus != "uploaded") return false;
  }
  return true;
}

function parentDirectory(filePath: string): string {
  const slash = filePath.lastIndexOf("/");
  if (slash <= 0) return "";
  return filePath.substring(0, slash);
}

function rememberDirectory(dirs: string[], dir: string): void {
  if (dir.length == 0) return;
  for (let i = 0; i < dirs.length; i++) {
    if (dirs[i] == dir) return;
  }
  dirs.push(dir);
}

/** 本地录音记录被清掉时，一并删掉本机上的分段文件和会话目录。 */
function deleteVoiceNoteFiles(record: VoiceNoteRecord): void {
  const fs = uni.getFileSystemManager();
  const dirs: string[] = [];
  const unlinkOne = (filePath: string): void => {
    if (filePath.length == 0) return;
    rememberDirectory(dirs, parentDirectory(filePath));
    try {
      fs.unlink({
        filePath: filePath,
        fail: (_err) => {},
      });
    } catch (_eUnlink) {
      // 文件已经不在时忽略。
    }
  };
  for (let i = 0; i < record.segments.length; i++) {
    unlinkOne(record.segments[i].filePath);
  }
  unlinkOne(record.openSegmentPath);
  for (let i = 0; i < dirs.length; i++) {
    try {
      fs.rmdir({
        dirPath: dirs[i],
        recursive: true,
        fail: (_err) => {},
      });
    } catch (_eRmdir) {
      // 目录非空或已经删掉时忽略。
    }
  }
}

/** 异步确认本地文件还在。iOS 上 accessSync 对不存在的文件也会判成存在，所以只信 getFileInfo 回调。 */
function segmentFileExists(filePath: string): Promise<boolean> {
  if (filePath.length == 0) {
    return Promise.resolve(false);
  }
  return new Promise<boolean>((resolve) => {
    uni.getFileSystemManager().getFileInfo({
      filePath: filePath,
      success: (_res) => {
        resolve(true);
      },
      fail: (_err) => {
        resolve(false);
      },
    });
  });
}

function segmentIndexUsed(indexes: number[], index: number): boolean {
  for (let i = 0; i < indexes.length; i++) {
    if (indexes[i] == index) return true;
  }
  return false;
}

/** 已上传分段的编号不能改。未上传的分段补进空位，保证剩下的编号从 0 连续排到最后。 */
function compactPendingSegmentIndexes(record: VoiceNoteRecord): void {
  const used: number[] = [];
  for (let i = 0; i < record.segments.length; i++) {
    const row = record.segments[i];
    if (row.uploadStatus == "uploaded") used.push(row.segmentIndex);
  }
  let next = 0;
  let maxIndex = -1;
  for (let i = 0; i < record.segments.length; i++) {
    const row = record.segments[i];
    if (row.uploadStatus == "uploaded") {
      if (row.segmentIndex > maxIndex) maxIndex = row.segmentIndex;
      continue;
    }
    while (segmentIndexUsed(used, next)) {
      next = next + 1;
    }
    row.segmentIndex = next;
    used.push(next);
    if (next > maxIndex) maxIndex = next;
    next = next + 1;
  }
  const following = maxIndex + 1;
  record.openSegmentIndex = following > 0 ? following : 0;
}

/** 补传时本地文件已被删掉：从分段列表移除，不占用上传次数。 */
function removeMissingSegment(localId: string, segmentIndex: number): VoiceNoteRecord | null {
  const record = findVoiceNoteByLocalId(localId);
  if (record == null) return null;
  const kept: VoiceNoteSegmentRecord[] = [];
  for (let i = 0; i < record.segments.length; i++) {
    const row = record.segments[i];
    if (row.segmentIndex != segmentIndex || row.uploadStatus == "uploaded") {
      kept.push(row);
    }
  }
  while (record.segments.length > 0) {
    record.segments.pop();
  }
  for (let i = 0; i < kept.length; i++) {
    record.segments.push(kept[i]);
  }
  compactPendingSegmentIndexes(record);
  touch(record);
  return record;
}

function rememberCreateError(localId: string, message: string): void {
  console.warn("[voice-note] create note failed " + message);
  const latest = findVoiceNoteByLocalId(localId);
  if (latest == null) return;
  if (latest.phase == "recording" || latest.phase == "paused") return;
  latest.error = message;
  touch(latest);
}

/**
 * 补齐 noteId。本地录音记录始终保留。
 * 已有非空 noteId 直接返回。这一条正在创建时返回 null，调用方不得上传。其他会话的创建互不影响。
 * 创建失败或没有返回 noteId 时抛错，不把空编号写进这条记录。
 * 创建返回时本地会话已删除或已放弃，则删掉刚建的服务端笔记，不再写回缓存。
 */
async function ensureNoteId(localId: string): Promise<VoiceNoteRecord | null> {
  const current = findVoiceNoteByLocalId(localId);
  if (current == null || current.phase == "discarded") return null;
  if (current.noteId.length > 0) return current;
  if (noteCreateBusy(localId)) return null;
  rememberNoteCreate(localId);
  try {
    const noteId = await apiVoiceNoteCreate(current.title);
    if (noteId.length == 0) {
      throw new Error("创建笔记未返回 noteId");
    }
    const latest = findVoiceNoteByLocalId(localId);
    if (latest == null || latest.phase == "discarded") {
      void deleteNoteQuiet(noteId);
      return null;
    }
    latest.noteId = noteId;
    latest.error = "";
    touch(latest);
    return latest;
  } finally {
    forgetNoteCreate(localId);
  }
}

function noteCreateBusy(localId: string): boolean {
  for (let i = 0; i < noteCreateLocalIds.length; i++) {
    if (noteCreateLocalIds[i] == localId) return true;
  }
  return false;
}

function rememberNoteCreate(localId: string): void {
  noteCreateLocalIds.push(localId);
}

function forgetNoteCreate(localId: string): void {
  const next: string[] = [];
  for (let i = 0; i < noteCreateLocalIds.length; i++) {
    if (noteCreateLocalIds[i] != localId) next.push(noteCreateLocalIds[i]);
  }
  noteCreateLocalIds = next;
}

function segmentSkipped(indexes: number[], segmentIndex: number): boolean {
  for (let i = 0; i < indexes.length; i++) {
    if (indexes[i] == segmentIndex) return true;
  }
  return false;
}

/**
 * 面板上还没点完成的这一次。录音中优先，否则最近一条暂停或停止。
 * 历史补传不能收尾这一次：播放时采集已暂停，阶段不再是录音中。
 */
function panelVoiceNote(): VoiceNoteRecord | null {
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].phase == "recording") return rows[i];
  }
  for (let i = 0; i < rows.length; i++) {
    const phase = rows[i].phase;
    if (phase == "paused" || phase == "stopped") return rows[i];
  }
  return null;
}

/**
 * 本次录音和补传各传各的会话，同时进行。
 * backfill 为 true：某一段失败后跳过，继续下一个文件。
 * 为 false：刚落下的这一段失败后还可以在本次接着试，满 3 次后留给以后的补传。
 */
async function pumpQueue(localId: string, backfill: boolean, history: boolean = false): Promise<void> {
  if (history) {
    if (historyBackfillBusy(localId)) return;
    rememberHistoryBackfill(localId);
  } else if (backfill) {
    if (backfillRunning) return;
    backfillRunning = true;
    activeBackfillLocalId = localId;
    markBackfillRunning(true);
  } else {
    if (uploadRunning) {
      uploadRerunLocalId = localId;
      return;
    }
    uploadRunning = true;
    uploadLocalId = localId;
  }
  const panelAtStart = panelVoiceNote();
  const protectedLocalId = panelAtStart != null ? panelAtStart.localId : "";
  try {
    const skipped: number[] = [];
    let guard = 0;
    while (guard < 10000) {
      const open = findVoiceNoteByLocalId(localId);
      if (open == null) break;
      if (history && (open.phase == "recording" || open.localId == uploadLocalId || (protectedLocalId.length > 0 && open.localId == protectedLocalId))) {
        break;
      }
      if (!history && backfill && (open.phase == "recording" || open.phase == "paused" || open.localId == uploadLocalId)) {
        break;
      }
      let pending: VoiceNoteSegmentRecord | null = null;
      for (let i = 0; i < open.segments.length; i++) {
        const row = open.segments[i];
        if (segmentSkipped(skipped, row.segmentIndex)) continue;
        if (history) {
          if (!historySegmentNeedsUpload(row)) continue;
        } else if (!segmentCanUpload(row)) {
          continue;
        }
        pending = row;
        break;
      }
      if (pending == null) {
        if (history) {
          const latest = findVoiceNoteByLocalId(localId);
          if (latest != null && allSegmentsUploaded(latest)) {
            await completeRecord(latest);
          } else if (latest != null && !historyNoteStillUploading(latest) && latest.phase != "recording" && latest.phase != "paused") {
            latest.phase = "failed";
            latest.awaitComplete = false;
            if (latest.error.length == 0) latest.error = "有录音分段上传失败";
            touch(latest);
          }
        } else if (open.awaitComplete && open.phase != "recording") {
          if (allSegmentsUploaded(open)) {
            await completeRecord(open);
          } else {
            open.phase = "failed";
            open.awaitComplete = false;
            if (open.error.length == 0) open.error = "有录音分段上传失败";
            touch(open);
          }
        }
        break;
      }
      guard = guard + 1;
      const sessionId = open.localId;
      const missingPath = pending.filePath;
      const fileExists = await segmentFileExists(missingPath);
      if (!fileExists) {
        const left = removeMissingSegment(sessionId, pending.segmentIndex);
        if (left != null && left.segments.length == 0 && left.awaitComplete && left.phase != "recording") {
          left.phase = "failed";
          left.awaitComplete = false;
          left.error = "录音文件已删除";
          touch(left);
          break;
        }
        continue;
      }
      let ready: VoiceNoteRecord | null = null;
      try {
        ready = await ensureNoteId(sessionId);
      } catch (e) {
        const message = `${e}`;
        rememberCreateError(sessionId, message);
        break;
      }
      if (ready == null || ready.noteId.length == 0) {
        break;
      }
      const segmentIndex = pending.segmentIndex;
      const filePath = pending.filePath;
      const durationMs = pending.durationMs;
      const attempts = pending.uploadAttempts + 1;
      const marked = writeSegmentUpload(sessionId, segmentIndex, "uploading", "", "", attempts);
      if (marked == null) break;
      try {
        const segmentId = await apiVoiceNoteUploadSegment(
          ready.noteId,
          filePath,
          segmentIndex,
          durationMs,
        );
        writeSegmentUpload(sessionId, segmentIndex, "uploaded", segmentId, "", attempts);
      } catch (e) {
        writeSegmentUpload(sessionId, segmentIndex, "failed", "", `${e}`, attempts);
        if (history || backfill || attempts >= maxSegmentUploadAttempts) {
          skipped.push(segmentIndex);
        }
      }
    }
  } finally {
    if (history) {
      forgetHistoryBackfill(localId);
    } else if (backfill) {
      markBackfillRunning(false);
      backfillRunning = false;
      activeBackfillLocalId = "";
    } else {
      uploadRunning = false;
      uploadLocalId = "";
      if (uploadRerunLocalId.length > 0) {
        const again = uploadRerunLocalId;
        uploadRerunLocalId = "";
        void pumpQueue(again, false);
      }
    }
  }
}

/** 补传总开关。正在补传，或距上次开始不满 5 分钟，这一轮都不开。 */
function backfillBlocked(gate: VoiceNoteBackfillGate): boolean {
  if (gate.catchingUp) return true;
  if (gate.backfillStartedAt <= 0) return false;
  return Date.now() - gate.backfillStartedAt < backfillGapMs;
}

function markBackfillRunning(running: boolean): void {
  const gate = loadBackfillGate();
  if (gate.catchingUp == running) return;
  gate.catchingUp = running;
  saveBackfillGate(gate);
}

/** 进程已不在补传。清掉上次异常退出留下的正在补传标记，保留开始时间。 */
function clearStaleBackfillRunning(): void {
  if (backfillRunning) return;
  markBackfillRunning(false);
}

/** 更早没传完的会话。正在录、已暂停的这一次不拿来补传。 */
function findBackfillVoiceNote(): VoiceNoteRecord | null {
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    if (row.phase == "recording" || row.phase == "paused") continue;
    if (row.localId == uploadLocalId) continue;
    if (row.phase != "stopped" && row.phase != "uploading" && row.phase != "processing" && row.phase != "failed") {
      continue;
    }
    for (let s = 0; s < row.segments.length; s++) {
      if (segmentCanUpload(row.segments[s])) return row;
    }
  }
  return null;
}

/**
 * 只在点击开始录音后调用。上一轮补传还没结束，或距上次开始不满 5 分钟，都跳过。
 * 只补更早的会话。开始之后离开录音页，这一轮仍继续传完。
 */
function startBackfill(): void {
  if (backfillRunning) return;
  clearStaleBackfillRunning();
  const gate = loadBackfillGate();
  if (backfillBlocked(gate)) return;
  const open = findBackfillVoiceNote();
  if (open == null) return;
  const current = findVoiceNoteByLocalId(open.localId);
  if (current == null || current.phase == "recording" || current.phase == "paused") return;
  if (current.localId == uploadLocalId) return;
  gate.catchingUp = true;
  gate.backfillStartedAt = Date.now();
  saveBackfillGate(gate);
  void pumpQueue(current.localId, true);
}

function findVoiceNoteByNoteId(noteId: string): VoiceNoteRecord | null {
  if (noteId.length == 0) return null;
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].noteId == noteId) return rows[i];
  }
  return null;
}

function noteHasPendingUpload(record: VoiceNoteRecord): boolean {
  for (let i = 0; i < record.segments.length; i++) {
    if (segmentCanUpload(record.segments[i])) return true;
  }
  return false;
}

function historyNoteNeedsUpload(record: VoiceNoteRecord): boolean {
  for (let i = 0; i < record.segments.length; i++) {
    if (historySegmentNeedsUpload(record.segments[i])) return true;
  }
  return false;
}

function historyNoteStillUploading(record: VoiceNoteRecord): boolean {
  for (let i = 0; i < record.segments.length; i++) {
    if (record.segments[i].uploadStatus == "uploading") return true;
  }
  return false;
}

function historyBackfillBusy(localId: string): boolean {
  for (let i = 0; i < historyBackfillLocalIds.length; i++) {
    if (historyBackfillLocalIds[i] == localId) return true;
  }
  return false;
}

function rememberHistoryBackfill(localId: string): void {
  historyBackfillLocalIds.push(localId);
}

function forgetHistoryBackfill(localId: string): void {
  const next: string[] = [];
  for (let i = 0; i < historyBackfillLocalIds.length; i++) {
    if (historyBackfillLocalIds[i] != localId) next.push(historyBackfillLocalIds[i]);
  }
  historyBackfillLocalIds = next;
}

/**
 * 历史列表里已加载、且状态是上传中的某一条。
 * 只用 noteId 找到本地那一条的文件。正在上传或已经成功的分段跳过。
 * 失败和其他状态才传。不看 5 分钟间隔。
 * 面板上这一次不补：录音中，或播放时已经暂停。其他录音的补传不改这一次。
 * 全部分段补成功后收尾；服务端完成后从本地补传记录里删掉。
 */
export function backfillVoiceNoteByNoteId(noteId: string): void {
  if (noteId.length == 0) return;
  const recording = activeRecord();
  if (recording != null && recording.noteId == noteId) return;
  const target = findVoiceNoteByNoteId(noteId);
  if (target == null) return;
  if (target.phase == "recording") return;
  const panel = panelVoiceNote();
  if (panel != null && panel.localId == target.localId) return;
  if (target.localId == uploadLocalId) return;
  if (backfillRunning && target.localId == activeBackfillLocalId) return;
  if (historyBackfillBusy(target.localId)) return;
  if (!historyNoteNeedsUpload(target)) {
    if (allSegmentsUploaded(target)) {
      void completeRecord(target);
    }
    return;
  }
  void pumpQueue(target.localId, false, true);
}

async function completeRecord(record: VoiceNoteRecord): Promise<void> {
  if (record.noteId.length == 0) {
    return;
  }
  const total = record.segments.length;
  if (total <= 0 || !allSegmentsUploaded(record)) {
    record.phase = "failed";
    if (total <= 0) {
      record.error = "没有可上传的录音";
    } else if (record.error.length == 0) {
      record.error = "有录音分段上传失败";
    }
    record.awaitComplete = false;
    touch(record);
    return;
  }
  record.phase = "uploading";
  touch(record);
  try {
    const status = await apiVoiceNoteComplete(record.noteId, total);
    record.phase = "processing";
    record.serverStatus = status;
    record.awaitComplete = false;
    record.error = "";
    touch(record);
    ensurePoll();
  } catch (e) {
    record.phase = "failed";
    record.error = `${e}`;
    touch(record);
  }
}

function ensurePoll(): void {
  if (pollTimer != 0) return;
  pollTimer = setInterval(() => {
    void pollProcessing();
  }, 8000);
  void pollProcessing();
}

/** 两次自动重试转写的最小间隔。没超过这个时间就跳过，继续后面的补传。 */
const reprocessGapMs = 120000;

function reprocessFailureStatus(status: string): boolean {
  return status == "ASR_PARTIAL_FAILED" || status == "DOC_FAILED" || status == "DOC_REMOVED";
}

function reprocessDue(record: VoiceNoteRecord): boolean {
  if (record.reprocessAt <= 0) return true;
  return Date.now() - record.reprocessAt > reprocessGapMs;
}

/** 详情仍需跟进：转写中，或上次是转写/文档失败、还可以再查。 */
function noteNeedsStatusPoll(record: VoiceNoteRecord): boolean {
  if (record.noteId.length == 0) return false;
  if (record.phase == "processing") return true;
  return record.phase == "failed" && reprocessFailureStatus(record.serverStatus);
}

/** 重试转写。失败只记日志，不挡住同一次补传里后面的请求。 */
async function reprocessQuiet(noteId: string): Promise<void> {
  try {
    await apiVoiceNoteReprocess(noteId);
  } catch (e) {
    console.warn("[voice-note] reprocess failed " + e);
  }
}

/** 本地列表只留未成功的录音。已经标成成功的旧记录也从缓存删掉。 */
function dropStoredSuccessNotes(): void {
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].phase == "success") {
      deleteVoiceNoteFiles(rows[i]);
      removeVoiceNote(rows[i].localId);
    }
  }
}

async function pollProcessing(): Promise<void> {
  dropStoredSuccessNotes();
  const rows = loadVoiceNotes();
  let pending = false;
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    if (!noteNeedsStatusPoll(row)) continue;
    try {
      const detail = await apiVoiceNoteDetail(row.noteId);
      if (detail == null) {
        pending = true;
        continue;
      }
      const status = detail["status"] != null ? `${detail["status"]}` : "";
      if (status == "SUCCESS") {
        deleteVoiceNoteFiles(row);
        removeVoiceNote(row.localId);
        continue;
      }
      row.serverStatus = status;
      if (detail["title"] != null) row.title = `${detail["title"]}`;
      if (detail["docUrl"] != null) row.docUrl = `${detail["docUrl"]}`;
      if (detail["asrText"] != null) row.asrText = `${detail["asrText"]}`;
      const duration = parseFloat(`${detail["totalDurationMs"]}`);
      if (!isNaN(duration) && duration > 0) row.elapsedMs = duration;
      let retryNoteId = "";
      if (reprocessFailureStatus(status)) {
        row.phase = "failed";
        row.error = status;
        if (reprocessDue(row)) {
          row.reprocessAt = Date.now();
          retryNoteId = row.noteId;
        }
      } else if (row.phase == "failed") {
        row.phase = "processing";
        row.error = "";
      }
      touch(row);
      if (retryNoteId.length > 0) {
        void reprocessQuiet(retryNoteId);
      }
      if (row.phase == "processing") pending = true;
    } catch (e) {
      row.error = `${e}`;
      touch(row);
      pending = true;
    }
  }
  if (!pending && pollTimer != 0) {
    clearInterval(pollTimer);
    pollTimer = 0;
  }
}

/** 页面展示用：还没点完成的这一次录音。完成后的记录留在缓存里，面板不再接着显示。 */
export function getPanelVoiceNote(): VoiceNoteRecord | null {
  return panelVoiceNote();
}

export function listCachedVoiceNotes(): VoiceNoteRecord[] {
  return loadVoiceNotes();
}

function findPausedVoiceNote(): VoiceNoteRecord | null {
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].phase == "paused") return rows[i];
  }
  return null;
}

/** 创建服务端笔记。失败只记在会话上，不改录音阶段，也不挡住计时。 */
async function bindVoiceNoteId(localId: string): Promise<void> {
  const current = findVoiceNoteByLocalId(localId);
  if (current == null || current.phase == "discarded") {
    return;
  }
  try {
    await ensureNoteId(localId);
  } catch (e) {
    rememberCreateError(localId, `${e}`);
  }
}

/** 原生录音已经在写之后才创建笔记。已有 noteId、未在录、或会话已结束时不请求。 */
function bindNoteAfterCapture(localId: string): void {
  if (!captureAlive) return;
  const latest = findVoiceNoteByLocalId(localId);
  if (latest == null) return;
  if (latest.phase != "recording") return;
  if (latest.noteId.length > 0) return;
  void bindVoiceNoteId(localId);
}

/** 暂停后的同一条笔记接着录，不新建会话，也不新开文件。 */
async function resumePausedNote(record: VoiceNoteRecord): Promise<void> {
  bindRecorder();
  record.phase = "recording";
  record.segmentStartedAt = Date.now();
  record.awaitComplete = false;
  record.error = "";
  touch(record);
  captureAlive = true;
  // #ifndef APP-HARMONY
  beginBackground();
  // #endif
  stopIntent = "";
  ensureTicker();
  // #ifdef APP
  if (m4aRecorder != null && record.openSegmentPath.length > 0) {
    const resumed = await m4aRecorder!.resume();
    if (resumed == "1") {
      pushVoiceNoteDebug("录音", "继续写入当前文件");
      bindNoteAfterCapture(record.localId);
      // #ifdef APP-HARMONY
      beginBackground();
      // #endif
      return;
    }
  }
  // #endif
  pushVoiceNoteDebug("录音", "继续录音");
  await startRecorder();
}

/** 开始一轮录音。已暂停的会话会接着录。调用前页面需已拿到麦克风权限。
 *  有权限后立刻进入录音并开始计时。笔记在原生真正开录之后才创建，不参与这一步。 */
export async function startVoiceNote(): Promise<void> {
  const existing = activeRecord();
  if (existing != null) return;
  const paused = findPausedVoiceNote();
  if (paused != null) {
    await resumePausedNote(paused);
    return;
  }
  bindRecorder();
  const now = Date.now();
  const record = new VoiceNoteRecord();
  record.localId = `${now}`;
  record.phase = "recording";
  record.startedAt = now;
  record.segmentStartedAt = now;
  record.openSegmentIndex = 0;
  record.title = "";
  touch(record);
  captureAlive = true;
  // #ifndef APP-HARMONY
  beginBackground();
  // #endif
  stopIntent = "";
  ensureTicker();
  await startRecorder();
  void startBackfill();
}

/**
 * 暂停采集。App 不结束当前文件，也不上传。
 * 满 1 小时切段，或点完成，才会落盘并上传。
 */
function newestSegmentPath(record: VoiceNoteRecord): string {
  for (let i = record.segments.length - 1; i >= 0; i--) {
    if (record.segments[i].filePath.length > 0) {
      return record.segments[i].filePath;
    }
  }
  return "";
}

async function pauseActiveRecorder(record: VoiceNoteRecord): Promise<void> {
  if (sessionEnding) {
    stopActiveRecorder("finish");
    return;
  }
  // #ifdef APP
  if (recorderBusy) {
    pauseAfterRotate = true;
    return;
  }
  if (m4aRecorder != null && record.openSegmentPath.length > 0) {
    recorderBusy = true;
    let paused = "0";
    try {
      paused = await m4aRecorder!.pause();
    } catch (_e) {
      paused = "0";
    }
    recorderBusy = false;
    if (sessionEnding || queuedIntent == "finish") {
      queuedIntent = "";
      stopActiveRecorder("finish");
      return;
    }
    if (paused == "2") {
      closedDurationOverride = m4aRecorder!.takeClosedDurationMs();
      const sealedPath = record.openSegmentPath;
      if (sealedPath.length > 0) {
        await closeSegment(record, sealedPath);
      }
      record.phase = "paused";
      record.awaitComplete = false;
      record.openSegmentPath = "";
      record.segmentStartedAt = 0;
      touch(record);
      pushVoiceNoteDebug("录音", "暂停接口不可用，当前段已封口");
      // #ifdef APP-HARMONY
      endBackground();
      // #endif
      return;
    }
    if (paused == "1") {
      pushVoiceNoteDebug("录音", "暂停，当前文件不落盘");
      const latest = noteByLocalId(record.localId);
      const target = latest != null ? latest : record;
      freezeOpenSegment(target);
      target.phase = "paused";
      target.awaitComplete = false;
      touch(target);
      // 暂停后已不再采集。停掉长时任务，避免系统因“未在录音仍占后台”把进程冻住。
      // #ifdef APP-HARMONY
      endBackground();
      // #endif
      return;
    }
    pushVoiceNoteDebug("录音", "暂停未停住采集，当前段不落盘");
    return;
  }
  // #endif
  if (sessionEnding) {
    stopActiveRecorder("finish");
    return;
  }
  // 停不住采集时也不要 stop。stop 会把未满分段的文件落盘并上传。
  pushVoiceNoteDebug("录音", "暂停未停住采集，当前段不落盘");
}

/**
 * 播放前如果正在录音，只暂停采集，不落盘、不上传。
 * 正在写、还没封口的文件不能播。没有已落盘分段时不暂停，直接返回空字符串。
 * @returns 最近一段已落盘文件的路径。没有则空字符串
 */
export async function playableLocalVoiceFile(): Promise<string> {
  const recording = activeRecord();
  const current = recording != null ? recording : findOpenVoiceNote();
  if (current == null || newestSegmentPath(current).length == 0) {
    return "";
  }
  if (recording != null) {
    await pauseActiveRecorder(recording);
  }
  const record = findOpenVoiceNote();
  if (record == null) {
    return newestSegmentPath(current);
  }
  return newestSegmentPath(record);
}

export function stopVoiceNote(): void {
  const record = activeRecord();
  if (record == null) return;
  void pauseActiveRecorder(record);
}

/** 重录：停掉当前会话并删掉服务端笔记。 */
export function discardVoiceNote(): void {
  const record = findOpenVoiceNote();
  if (record == null) return;
  sessionEnding = false;
  endingLocalId = "";
  if (record.phase == "recording" || record.phase == "paused") {
    stopActiveRecorder("discard");
    return;
  }
  record.phase = "discarded";
  touch(record);
  removeVoiceNote(record.localId);
  const noteId = record.noteId;
  if (noteId.length > 0) {
    void deleteNoteQuiet(noteId);
  }
}

async function deleteNoteQuiet(noteId: string): Promise<void> {
  try {
    await apiVoiceNoteDelete(noteId);
  } catch (_e) {
    // 本地已放弃。未收尾的服务端会话会在 7 天后回收。
  }
}

/** 点完成即结束本次录音。录音中、暂停中、正在播放，都把当前文件落盘并上传。 */
export function finishVoiceNote(): void {
  const record = findOpenVoiceNote();
  if (record == null) {
    return;
  }
  if (record.phase == "processing" || record.phase == "success" || record.phase == "discarded") return;
  if (sessionEnding) {
    return;
  }
  sessionEnding = true;
  endingLocalId = record.localId;
  const holdingFile = record.phase == "recording" || record.phase == "paused" || record.openSegmentPath.length > 0 || captureAlive;
  // #ifdef APP
  if (recorderBusy) {
    queuedIntent = "finish";
    return;
  }
  // #endif
  if (holdingFile) {
    stopActiveRecorder("finish");
    return;
  }
  sessionEnding = false;
  endingLocalId = "";
  record.awaitComplete = true;
  record.phase = "uploading";
  record.segmentStartedAt = 0;
  record.openSegmentPath = "";
  touch(record);
  endBackground();
  stopTicker();
  releaseRecorderCallbacks();
  void pumpQueue(record.localId, false);
}

let recoveringAbandoned = false;

/**
 * 进程被杀掉后缓存里仍是录音中。正在写的文件收成一段并暂停。
 * 会话不结束，也不在这里上传。下次点继续录音接着录，点完成时再和已有分段一起上传。
 */
async function recoverAbandonedRecording(): Promise<void> {
  try {
    const record = activeRecord();
    if (record == null) return;
    const path = record.openSegmentPath;
    if (path.length > 0) {
      pushVoiceNoteDebug("录音", "进程已退出，落下当前段并暂停");
      await closeSegment(record, path);
    } else if (record.segments.length > 0) {
      record.openSegmentPath = "";
    } else {
      const noteId = record.noteId;
      record.phase = "discarded";
      touch(record);
      removeVoiceNote(record.localId);
      if (noteId.length > 0) {
        void deleteNoteQuiet(noteId);
      }
      endBackground();
      stopTicker();
      releaseRecorderCallbacks();
      return;
    }
    record.phase = "paused";
    record.awaitComplete = false;
    record.segmentStartedAt = 0;
    touch(record);
    endBackground();
    stopTicker();
    releaseRecorderCallbacks();
  } finally {
    recoveringAbandoned = false;
  }
}

function resumeProcessingPoll(): void {
  const rows = loadVoiceNotes();
  for (let i = 0; i < rows.length; i++) {
    if (noteNeedsStatusPoll(rows[i])) {
      ensurePoll();
      break;
    }
  }
}

/** 回前台：本进程仍在录就继续计时和切段。进程已被杀掉则把正在写的段落下并暂停，不在这里上传或补传。 */
export function voiceNoteOnAppShow(): void {
  clearStaleBackfillRunning();
  dropStoredSuccessNotes();
  const record = activeRecord();
  if (record != null && !captureAlive && stopIntent.length == 0) {
    if (!recoveringAbandoned) {
      recoveringAbandoned = true;
      void recoverAbandonedRecording();
    }
    resumeProcessingPoll();
    return;
  }
  if (record != null) {
    beginBackground();
    ensureTicker();
    const now = Date.now();
    if (openSegmentMs(record, now) >= segmentMs && stopIntent.length == 0) {
      stopActiveRecorder("rotate");
    }
  }
  resumeProcessingPoll();
}

/** 退出程序：把正在写的段收成文件。会话不结束，只有点完成才 complete。 */
export function voiceNoteOnAppExit(): void {
  if (activeRecord() == null) return;
  pushVoiceNoteDebug("录音", "退出程序，落下当前段，会话未结束");
  stopActiveRecorder("user");
}
