/** 同一份几何规则供在线/离线 H5 与原生桥使用：只补系统尚未消化的遮挡。 */
export function computeComposerKeyboardCover(height: number, layoutHeight: number, visibleHeight: number, viewportTop: number, resizes: boolean): number {
  if (height <= 0 || resizes) return 0;
  const shrink = visibleHeight > 0 ? Math.max(0, layoutHeight - visibleHeight) : 0;
  const remaining = height - Math.max(shrink, Math.max(0, viewportTop));
  return remaining > 2 ? Math.round(remaining) : 0;
}

/** 原生壳只安装统一适配器，不再各自维护 Android/iOS/鸿蒙的计算分支。 */
export function buildComposerKeyboardResolverScript(): string {
  return `;window.__nuwaxKbResolveCover=function(h){
    var de=document.documentElement;
    var layout=Math.max(window.innerHeight||0,de?de.clientHeight:0);
    if(!(h>0)){
      // 收起事件可能早于窗口恢复；保留本方向的最大高度，避免下一次重复垫高。
      window.__nuwaxKbLayoutHeight=window.__nuwaxKbLayoutWidth===window.innerWidth?
        Math.max(layout,window.__nuwaxKbLayoutHeight||0):layout;
      window.__nuwaxKbLayoutWidth=window.innerWidth;
      return 0;
    }
    if(window.__nuwaxKbPlatform==='harmony')return 0;
    if(window.__nuwaxKbLayoutWidth===window.innerWidth)
      layout=Math.max(layout,window.__nuwaxKbLayoutHeight||0);
    var vv=window.visualViewport;
    var shrink=vv&&vv.height>0?Math.max(0,layout-vv.height):0;
    var top=vv&&vv.offsetTop>0?vv.offsetTop:0;
    var remaining=h-Math.max(shrink,top);
    return remaining>2?Math.round(remaining):0;
  };if(!(window.__nuwaxKeyboardHeight>0))window.__nuwaxKbResolveCover(0);`;
}
