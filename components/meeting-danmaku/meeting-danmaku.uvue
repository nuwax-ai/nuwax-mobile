<template>
  <!--
    会中弹幕飘屏层（零 props，自驱）。

    ★为什么不用 CSS `@keyframes`：uvue App 端动画支持有限（同 voice-wave-bars 的结论），
      keyframes 不跑时元素会永远停在起点（left:100%），表现就是「弹幕完全不出现」。
      这里用约 30fps 定时器更新 left，并逐帧创建新渲染对象，保证原生模板实际刷新。
    ★逐帧只改本组件内部的 ref：会议页只负责 push 队列，不参与重渲。
  -->
  <view class="md-layer">
    <view
      v-for="item in items"
      :key="item.id"
      class="md-item"
      :style="'top:' + item.top + 'px;left:' + item.x + 'px'"
    >
      <text v-if="item.name.length > 0" class="md-name" :lines="1">{{ item.name }}</text>
      <text class="md-text" :lines="1">{{ item.text }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { onMounted, onUnmounted, ref } from "vue";
  import { drainMeetingDanmaku, MeetingDanmakuMessage } from "@/utils/meeting/meetingDanmaku";

  /** 单条弹幕的渲染态（位置按屏幕像素维护）。 */
  class DanmakuRenderItem {
    id: string = "";
    name: string = "";
    text: string = "";
    top: number = 0;
    /** 起始时间（ms）：位移进度由 `now - startAt` 推出来，掉帧也不会累计漂移。 */
    startAt: number = 0;
    duration: number = 8000;
    /** 横向位置（px）。uni-app x 原生端对动态 transform 的局部刷新不稳定，使用 left 保证跑动。 */
    x: number = 0;
  }

  const items = ref<DanmakuRenderItem[]>([]);
  /** 同时最多几条：多了会互相压字，超出直接丢最旧的。 */
  const MAX_ITEMS = 6;
  /** 从右往左飘完整屏所需时长。 */
  const MOVE_MS = 8000;
  /** 轨道数：4 条，避免同一行上下重叠。 */
  const LANES = 4;

  let timer = -1;
  let seq = 0;
  let viewportWidth = 375;

  function tick(): void {
    const now = Date.now();
    const list = items.value;
    const next: DanmakuRenderItem[] = [];
    for (let i = 0; i < list.length; i++) {
      const previous = list[i];
      const progress = (now - previous.startAt) / previous.duration;
      if (progress >= 1) {
        continue;
      }
      // 每帧创建新实例：UTS 原生模板不会稳定追踪 class 实例字段的原地变更，
      // 只换数组但复用同一实例仍可能停在首次渲染位置。
      const item = new DanmakuRenderItem();
      item.id = previous.id;
      item.name = previous.name;
      item.text = previous.text;
      item.top = previous.top;
      item.startAt = previous.startAt;
      item.duration = previous.duration;
      item.x = Math.round(viewportWidth + 24 - progress * (viewportWidth + 320));
      next.push(item);
    }
    // 新弹幕：一次取空队列，按到达顺序错开轨道
    const fresh = drainMeetingDanmaku();
    for (let i = 0; i < fresh.length; i++) {
      seq++;
      const source: MeetingDanmakuMessage = fresh[i];
      const item = new DanmakuRenderItem();
      item.id = `dm-${seq}`;
      item.name = source.name;
      item.text = source.text;
      item.top = 8 + (seq % LANES) * 32;
      item.startAt = now;
      item.duration = MOVE_MS;
      item.x = viewportWidth;
      next.push(item);
    }
    while (next.length > MAX_ITEMS) {
      next.shift();
    }
    // 新数组 + 全新 item 实例，强制原生模板逐帧刷新 left，形成稳定的右进左出跑马灯。
    items.value = next;
  }

  onMounted(() => {
    if (timer != -1) {
      return;
    }
    const info = uni.getSystemInfoSync();
    viewportWidth = info.windowWidth > 0 ? info.windowWidth : 375;
    // left 会参与布局，使用约 30fps，兼顾流畅度和会议页面渲染开销。
    timer = setInterval(() => { tick(); }, 33);
  });

  onUnmounted(() => {
    if (timer != -1) {
      clearInterval(timer);
      timer = -1;
    }
    items.value = [];
  });
</script>

<style lang="scss" scoped>
  .md-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 56px;
    height: 140px;
    z-index: 4;
    overflow: hidden;
    pointer-events: none;
  }

  .md-item {
    position: absolute;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.42);
  }

  .md-name {
    margin-right: 4px;
    font-size: 13px;
    line-height: 18px;
    color: #9fc7ff;
  }

  .md-text {
    font-size: 13px;
    line-height: 18px;
    color: #ffffff;
  }
</style>
