<template>
  <view
    class="layout"
    :class="className"
    :style="{
      backgroundColor: transparentBackground == true ? 'transparent' : (backgroundColor || '#FFFFFF'),
    }"
  >
    <!-- 微信安全区 -->
    <safety-zone v-if="hasSafetyZone"></safety-zone>
    <view :class="['nav-bar', leftWide == true ? 'nav-bar-left-wide' : '']">
      <!-- 左侧菜单按钮 -->
      <view class="left-box">
        <view class="menu-btn">
          <view v-if="showBack" class="back-btn" @click="onBackClick">
            <svg-icon name="icon-a-Chevronleft" size="44" />
          </view>
          <slot name="left"></slot>
        </view>
      </view>

      <!-- 中间 logo + 名称 -->
      <view class="logo-wrap">
        <view class="title-box">
          <!-- 图标 -->
          <view class="logo" v-if="icon != null && icon != ''">
            <image
              class="logo__image"
              :src="currentIcon"
              mode="aspectFill"
              :alt="displayTitle != null && displayTitle != '' ? displayTitle : t('Mobile.Common.agentIconAlt')"
              @error="handleImageError"
            ></image>
          </view>
          <!-- 标题 -->
          <text
            class="title text-ellipsis"
            :class="icon != null && icon != '' ? 'title-exist-icon' : 'title-no-icon'"
            >{{ displayTitle }}</text
          >
        </view>
      </view>

      <!-- 右侧插槽 -->
      <view class="right-box">
        <slot name="right"></slot>
      </view>

      <!-- 微信胶囊按钮功能区 -->
      <!-- #ifdef MP-WEIXIN -->
      <view
        v-if="false"
        class="right-safety"
        :style="{
          width: clientRect.width + 'px',
          height: clientRect.height + 'px',
        }"
      ></view>
      <!-- #endif -->
    </view>
  </view>
</template>

<script setup lang="uts">
  // vapor styleIsolation 2.0 默认 isolated，放开接收全局样式（工具类/iconfont 等全局 class）
  defineOptions({ styleIsolation: 'app' });

import { computed, ref, watch } from "vue";
import { chatService } from "@/utils/chatService";
import agentImage from "@/static/assets/agent_image.png";
import { translateText, t as translateFn, emptyI18nParams } from "@/utils/i18n";
const _params = emptyI18nParams();
const t = (key: string): string => translateFn(key, _params, "");

// #ifdef MP-WEIXIN
const clientRect = uni.getMenuButtonBoundingClientRect();
// #endif

const props = defineProps({
  title: String,
  icon: String,
  showBack: Boolean,
  className: String,
  hasSafetyZone: Boolean,
  transparentBackground: Boolean,
  backgroundColor: String,
  interceptBack: Boolean,
  leftWide: Boolean,
});
const emit = defineEmits(["back"]);

const displayTitle = computed<string>(() => {
  return translateText(props.title != null ? props.title : "");
});

// 当前显示的图标（用于处理加载失败时使用默认图片）
const currentIcon = ref<string>(props.icon != null && props.icon != "" ? props.icon : agentImage);

const onBackClick = () => {
  if (props.interceptBack == true) {
    emit("back");
    return;
  }
  // 中止当前会话
  chatService.abort();
  // 获取当前页面栈
  const pages = getCurrentPages();
  // 如果页面栈中有多个页面，正常返回
  if (pages.length > 1) {
    uni.navigateBack({
      delta: 1,
    });
    return;
  }
  // 如果页面栈只有一个页面（浏览器刷新后），使用浏览器历史记录返回 如果没有历史记录，跳转到首页
  uni.reLaunch({
    url: "/pages/index/index",
  });
};

/**
 * 图片加载失败处理
 * 当图片加载失败时，使用默认图片
 */
const handleImageError = () => {
  currentIcon.value = agentImage;
};

// 监听 props.icon 变化，更新当前图标
watch(
  () : string | null => props.icon as string | null,
  (newIcon : string | null) => {
    currentIcon.value = newIcon != null && newIcon != "" ? newIcon : agentImage;
  },
  { immediate: true },
);
</script>

<style lang="scss" scoped>
.nav-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 90rpx;
  /* #ifndef H5 */
  /* 64rpx 图标加上下 20rpx 内边距，避免 Android 父容器裁切标题区域。 */
  height: 104rpx;
  /* #endif */
  padding: 20rpx;
  box-sizing: border-box;
}

.left-box {
  /* #ifdef H5 */
  min-width: 30%;
  /* #endif */
  /* #ifndef H5 */
  /* Android 屏宽为 750rpx，225rpx 两侧预留会挤压中间标题。 */
  min-width: 180rpx;
  /* #endif */
  align-items: flex-start;
}

.menu-btn {
  margin-right: 12rpx;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
}

.back-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 64rpx;
  padding: 10rpx;
  margin-left: -10rpx;
  margin-right: 8rpx;
  /* #ifdef H5 */
  cursor: pointer;
  /* #endif */
}

/* vapor: 删除 .iconfont.icon-a-Chevronleft 复合选择器——模板使用 svg-icon 组件，本 scoped 内无对应元素 */

.logo-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.title-box {
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-width: 0;
  overflow: hidden;
}

.logo {
  margin-right: 12rpx;
  width: 64rpx;
  height: 64rpx;
  /* vapor: 原 border-radius:50% 不被支持，元素为 64rpx 方形，等价 32rpx */
  border-radius: 32rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

/* vapor: 原 .image 通用类按 parent__child 重命名为 .logo__image（模板同步更新）*/
.logo__image {
  position: absolute;
  left: -3%;
  top: -3%;
  width: 106%;
  height: 106%;
}

.title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
  color: rgba(21, 23, 31, 1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.title-exist-icon {
  /* #ifdef H5 */
  max-width: calc(100% - 64rpx - 12rpx);
  /* #endif */
  text-align: left;
}

.title-no-icon {
  text-align: center;
}

.right-box {
  /* #ifdef H5 */
  min-width: 30%;
  /* #endif */
  /* #ifndef H5 */
  min-width: 180rpx;
  /* #endif */
  display: flex;
  flex-direction: row;
  align-items: center;
  /* App 端 slot 容器默认从起始位排列，需明确整体靠右 */
  justify-content: flex-end;
  align-content: flex-end;
}
</style>
