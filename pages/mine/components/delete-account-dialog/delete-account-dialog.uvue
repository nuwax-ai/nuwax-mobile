<template>
  <!--
    删除账号确认弹窗页（dialogPage）。
    dialogPage 是 uni-app x 中唯一能覆盖原生 tabBar / 导航栏的弹窗形式，
    页面背景默认透明，遮罩由内部组件自绘。
  -->
  <delete-account-modal ref="modalRef" @confirm="onConfirm" @cancel="onCancel" />
</template>

<script setup lang="uts">
  import { ref, type ComponentPublicInstance } from "vue";
  import { onReady } from "@dcloudio/uni-app";
  import DeleteAccountModal from "../delete-account-modal/delete-account-modal.uvue";
  import { DELETE_ACCOUNT_CONFIRM_EVENT } from "../delete-account-modal/deleteAccountEvent";

  const modalRef = ref<any | null>(null);

  // Android：组件 ref 是 Gen* 类，禁止 as UTSJSONObject 或直接点方法；用 $callMethod 调 defineExpose 方法
  function callRefMethod(inst: any | null, methodName: string): void {
    if (inst == null) {
      return;
    }
    const proxy = inst as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  onReady(() => {
    callRefMethod(modalRef.value, "open");
  });

  const closeSelf = () => {
    uni.closeDialogPage({});
  };

  const onCancel = () => {
    closeSelf();
  };

  /** 校验通过：先关弹窗页，再通知「我的」页执行注销 */
  const onConfirm = () => {
    closeSelf();
    uni.$emit(DELETE_ACCOUNT_CONFIRM_EVENT);
  };
</script>

<style>
</style>
