/**
 * 通用文件上传工具
 * 从 chat-input-phone 提取的共享上传逻辑
 * 供 MCP Ask 卡片等组件复用
 */
import { getUploadFileAction } from "@/constants/common.constants";
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { SUCCESS_CODE } from "@/constants/codes.constants";
import { UploadFileInfo } from "@/types/interfaces/common.uts";
import { UploadFileStatus } from "@/types/enums/common.uts";
import { t } from "@/utils/i18n.uts";
import { orEmpty, orNumber, orString } from "@/utils/utsCoalesce";
import { applyBearerAuthorization } from "@/utils/authSession";
import { applyXClientTypeHeader } from "@/utils/appWebViewDetect";

// #ifdef APP-ANDROID
import Uri from "android.net.Uri";
import File from "java.io.File";
import FileInputStream from "java.io.FileInputStream";
import FileOutputStream from "java.io.FileOutputStream";
import InputStream from "java.io.InputStream";
// #endif

function readObjectField(obj: UTSJSONObject | null, key: string): any | null {
  if (obj == null) {
    return null;
  }
  return obj[key];
}

/**
 * 安全解析 uni.uploadFile 的 res.data。
 * Android 上 res.data 可能为 null / 非 string，直接 JSON.parse 会 NPE：
 * "null cannot be cast to non-null type kotlin.Any"
 */
function parseUploadResponseData(raw: any | null): UTSJSONObject | null {
  if (raw == null) {
    return null;
  }
  if (typeof raw == "string") {
    const text = `${raw}`.trim();
    if (text.length == 0) {
      return null;
    }
    try {
      return JSON.parse(text) as UTSJSONObject;
    } catch (_eStr) {
      return null;
    }
  }
  try {
    const obj = raw as UTSJSONObject;
    if (obj["code"] != null || obj["data"] != null || obj["message"] != null) {
      return obj;
    }
  } catch (_eObj) {
    // ignore
  }
  try {
    const jsonStr = JSON.stringify(raw);
    if (
      jsonStr != null &&
      jsonStr.length > 2 &&
      jsonStr != "{}" &&
      jsonStr != "null"
    ) {
      return JSON.parse(jsonStr) as UTSJSONObject;
    }
  } catch (_eJson) {
    // ignore
  }
  return null;
}

function resolveFailMessage(
  dataMessage: any | null,
  resultMessage: any | null,
  fallback: string,
): string {
  if (dataMessage != null) {
    const text = `${dataMessage}`;
    if (text.length > 0 && text != "null") {
      return text;
    }
  }
  if (resultMessage != null) {
    const text = `${resultMessage}`;
    if (text.length > 0 && text != "null") {
      return text;
    }
  }
  return fallback;
}

/** 上传结果 */
export class UploadResult {
  success: boolean = false;
  file?: UploadFileInfo;
  error?: string;
}

function createSuccessUploadResult(file: UploadFileInfo): UploadResult {
  const result = new UploadResult();
  result.success = true;
  result.file = file;
  return result;
}

function createFailedUploadResult(error: string): UploadResult {
  const result = new UploadResult();
  result.success = false;
  result.error = error;
  return result;
}

/**
 * 生成文件唯一 ID
 */
export function generateFileUid(): string {
  return Date.now().toString() + Math.random().toString(36).substring(2, 11);
}

/**
 * 构建上传请求的 header（处理多平台 auth token）
 */
function buildUploadHeaders(): UTSJSONObject {
  const token = uni.getStorageSync(ACCESS_TOKEN) ?? "";
  const header = {} as UTSJSONObject;
  // App / 小程序 / H5 开发 / App 内嵌 H5 → Bearer；浏览器 H5 生产仍走 Cookie
  applyBearerAuthorization(header, token != null ? `${token}` : null);
  applyXClientTypeHeader(header);
  return header;
}

/** 路径末段扩展名（小写、无点；无扩展名返回空串）。displayFileName 无斜杠同样适用。 */
function pathExtensionOf(path: string): string {
  const segs = path.split("/");
  const seg = segs.length > 0 ? segs[segs.length - 1] : "";
  const dot = seg.lastIndexOf(".");
  if (dot <= 0 || dot == seg.length - 1) {
    return "";
  }
  return seg.substring(dot + 1).toLowerCase();
}

// #ifdef APP-ANDROID
/** 流拷贝到缓存文件（16K 缓冲，finally 关闭两侧流）。 */
function copyStreamTo(input: InputStream, output: FileOutputStream): void {
  try {
    const buffer = new ByteArray(1024 * 16);
    let readCount = input.read(buffer);
    while (readCount != -1) {
      output.write(buffer, 0, readCount);
      readCount = input.read(buffer);
    }
    output.flush();
  } finally {
    input.close();
    output.close();
  }
}

/**
 * ContentResolver 报告的 mime 映射扩展名（相册视频的真实容器）：
 * URI 末段无扩展名时优先用它，避免把 mkv/3gp 一律盲补成 .mp4。
 * 认不出的容器返回空串，交回调用方 fallbackExtension。
 */
function extensionOfResolverMime(mime: string): string {
  if (mime.length == 0) {
    return "";
  }
  const slash = mime.indexOf("/");
  const sub = slash >= 0 ? mime.substring(slash + 1) : mime;
  if (sub == "mp4") {
    return "mp4";
  }
  if (sub == "quicktime") {
    return "mov";
  }
  if (sub == "x-matroska") {
    return "mkv";
  }
  if (sub == "webm") {
    return "webm";
  }
  if (sub == "3gpp" || sub == "3gpp2") {
    return "3gp";
  }
  if (sub == "x-msvideo" || sub == "avi" || sub == "msvideo") {
    return "avi";
  }
  if (sub == "mpeg" || sub == "mp2t") {
    return "mpeg";
  }
  return "";
}
// #endif

/**
 * Android 系统文件选择器返回的通常是 content:// URI，而 uni.uploadFile 内部仍会
 * 尝试按文件路径查询 `_data` 列；部分 Provider 不提供该列，会直接抛出 CursorWindow
 * col -1。上传前通过 ContentResolver 把内容复制到应用缓存，交给上传器真实路径。
 *
 * 缓存文件扩展名优先级：URI 末段自带 → ContentResolver 报告的真实容器 mime
 * （mkv 如实 .mkv，不盲补 .mp4）→ fallbackExtension（调用方 displayFileName 的
 * 扩展名——调用方明确知道文件类型，如相册混选视频）→ .tmp。
 * uni.uploadFile 的 multipart 文件名取自物理路径末段，服务端按它嗅探 mimeType：
 * 扩展名缺失（相册视频 URI 末段常是纯数字 id）会被判成 octet-stream，
 * 视频消息确认后降级成不可预览的文件附件。无扩展名的普通本地路径同此处理。
 */
function prepareUploadFilePath(filePath: string, uid: string, fallbackExtension: string): string {
  // #ifdef APP-ANDROID
  try {
    const context = UTSAndroid.getAppContext();
    if (context == null) {
      throw new Error("Android context unavailable");
    }
    if (filePath.indexOf("content://") != 0) {
      // 已带扩展名或调用方未提供类型线索：保持原路径（原行为）
      if (pathExtensionOf(filePath).length > 0 || fallbackExtension.length == 0) {
        return filePath;
      }
      const plainTarget = new File(
        context.getCacheDir(),
        "nuwax_upload_" + uid + "." + fallbackExtension,
      );
      copyStreamTo(new FileInputStream(new File(filePath)), new FileOutputStream(plainTarget));
      const renamedPath = plainTarget.getAbsolutePath();
      console.log("[fileUploader] materialized extensionless path=" + renamedPath);
      return renamedPath;
    }
    const uri = Uri.parse(filePath);
    const input = context.getContentResolver().openInputStream(uri);
    if (input == null) {
      throw new Error("Cannot open selected file");
    }
    let extension = ".tmp";
    const lastSegmentRaw = uri.getLastPathSegment();
    if (lastSegmentRaw != null) {
      const lastSegment = `${lastSegmentRaw}`;
      const dotIndex = lastSegment.lastIndexOf(".");
      if (dotIndex >= 0 && lastSegment.length - dotIndex <= 12) {
        extension = lastSegment.substring(dotIndex);
      }
    }
    if (extension == ".tmp") {
      // 末段无扩展名：先问 ContentResolver 真实容器（mkv 如实 .mkv），
      // 查不到再用调用方 displayFileName 的扩展名兜底
      let resolverMime = "";
      try {
        resolverMime = context.getContentResolver().getType(uri) ?? "";
      } catch (_eType) {
        resolverMime = "";
      }
      const resolverExt = extensionOfResolverMime(resolverMime);
      if (resolverExt.length > 0) {
        extension = "." + resolverExt;
      } else if (fallbackExtension.length > 0) {
        extension = "." + fallbackExtension;
      }
    }
    const target = new File(
      context.getCacheDir(),
      "nuwax_upload_" + uid + extension,
    );
    copyStreamTo(input, new FileOutputStream(target));
    const resolvedPath = target.getAbsolutePath();
    console.log("[fileUploader] materialized content uri path=" + resolvedPath);
    return resolvedPath;
  } catch (error) {
    console.error("[fileUploader] materialize content uri failed:", error);
    throw error;
  }
  // #endif
  // #ifndef APP-ANDROID
  return filePath;
  // #endif
}

/**
 * 上传单个文件到服务器
 *
 * @param filePath 本地临时文件路径
 * @param uid 文件唯一标识
 * @param onProgress 进度回调（可选）
 * @returns Promise<UploadResult>
 */
export function uploadSingleFile(
  filePath: string,
  uid: string,
  onProgress?: (percent: number) => void,
  displayFileName: string = "",
): Promise<UploadResult> {
  const header = buildUploadHeaders();

  const progressCallback = onProgress;

  return new Promise((resolve, _reject) => {
    let uploadPath = filePath;
    try {
      uploadPath = prepareUploadFilePath(
        filePath,
        uid,
        pathExtensionOf(displayFileName),
      );
    } catch (_prepareError) {
      resolve(createFailedUploadResult(t("Mobile.FileUploader.uploadFailed")));
      return;
    }
    const lastSegment = uploadPath.split("/").pop();
    const fileName = orString(lastSegment as any, "file");
    const formDataObj = new UTSJSONObject();
    formDataObj["type"] = "tmp";
    const uploadTask: UploadTask = uni.uploadFile({
      url: getUploadFileAction(),
      filePath: uploadPath,
      name: "file",
      header: header,
      formData: formDataObj,
      success: (res) => {
        try {
          const rawPreview = res.data != null ? `${res.data}` : "(null)";
          console.log(
            "[fileUploader] response statusCode=" +
              res.statusCode +
              " body=" +
              rawPreview
          );
          const resultObj = parseUploadResponseData(res.data);
          if (resultObj == null) {
            console.error(
              "[fileUploader] 解析上传响应失败, statusCode=" +
                res.statusCode +
                " data=" +
                rawPreview
            );
            resolve(
              createFailedUploadResult(t("Mobile.FileUploader.parseFailed")),
            );
            return;
          }
          const code = resultObj["code"];
          const dataRaw = resultObj["data"];
          const message = resultObj["message"];
          const dataObj =
            dataRaw != null && typeof dataRaw == "object"
              ? (dataRaw as UTSJSONObject)
              : null;
          const codeText = code != null ? `${code}` : "";
          if (codeText == SUCCESS_CODE) {
            const uploadedFile = new UploadFileInfo();
            uploadedFile.key = orEmpty(readObjectField(dataObj, "key"));
            const serverFileName = orString(
              readObjectField(dataObj, "fileName"),
              fileName,
            );
            uploadedFile.name =
              displayFileName.length > 0 ? displayFileName : serverFileName;
            uploadedFile.type = orString(
              readObjectField(dataObj, "mimeType"),
              "application/octet-stream",
            );
            uploadedFile.size = orNumber(readObjectField(dataObj, "size"), 0);
            uploadedFile.url = orEmpty(readObjectField(dataObj, "url"));
            uploadedFile.uid = uid;
            uploadedFile.status = UploadFileStatus.done;
            uploadedFile.percent = 100;
            uploadedFile.response = resultObj;
            resolve(createSuccessUploadResult(uploadedFile));
          } else {
            const dataMessage = readObjectField(dataObj, "message");
            resolve(
              createFailedUploadResult(
                resolveFailMessage(
                  dataMessage,
                  message,
                  t("Mobile.FileUploader.uploadFailed"),
                ),
              ),
            );
          }
        } catch (error) {
          console.error("[fileUploader] 解析上传响应失败:", error);
          resolve(
            createFailedUploadResult(t("Mobile.FileUploader.parseFailed")),
          );
        }
      },
      fail: (error) => {
        console.error("[fileUploader] 上传失败:", error);
        const errorObj = error as UTSJSONObject;
        resolve(
          createFailedUploadResult(
            orString(
              readObjectField(errorObj, "errMsg"),
              t("Mobile.FileUploader.networkError"),
            ),
          ),
        );
      },
    });

    if (progressCallback != null) {
      uploadTask.onProgressUpdate((res: OnProgressUpdateResult) => {
        progressCallback(res.progress);
      });
    }
  });
}

/**
 * 批量上传文件
 *
 * @param filePaths 本地临时文件路径数组
 * @param fileUidMap 路径 → uid 的映射
 * @param onFileProgress 单文件进度回调（可选）
 * @returns Promise<UploadFileInfo[]> 上传完成的文件列表
 */
export async function uploadMultipleFiles(
  filePaths: string[],
  fileUidMap: Record<string, string>,
  onFileProgress?: (uid: string, percent: number) => void,
): Promise<UploadFileInfo[]> {
  const results: UploadFileInfo[] = [];

  const fileProgressCallback = onFileProgress;

  const uploadPromises = filePaths.map(async (filePath) => {
    const uid = orString(fileUidMap[filePath] as any, generateFileUid());
    const result = await uploadSingleFile(filePath, uid, (percent) => {
      if (fileProgressCallback != null) {
        fileProgressCallback(uid, percent);
      }
    });
    return result;
  });

  const settledResults = await Promise.allSettled(uploadPromises);

  for (const settled of settledResults) {
    if (settled.status === "fulfilled") {
      const uploadResult = settled.value as UploadResult;
      if (uploadResult.success && uploadResult.file != null) {
        results.push(uploadResult.file);
      } else {
        const errorFile = new UploadFileInfo();
        errorFile.status = UploadFileStatus.error;
        results.push(errorFile);
      }
    }
  }

  return results;
}
