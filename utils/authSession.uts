import { ACCESS_TOKEN, ACCESS_TOKEN_ORIGIN } from "@/constants/home.constants";
import { getApiBaseUrl } from "@/constants/config";
import { isAppWebViewEmbedded } from "@/utils/appWebViewDetect";

/** 保存 Token 及其所属服务域名。 */
export function saveAccessToken(token: string): void {
  uni.setStorageSync(ACCESS_TOKEN, token);
  uni.setStorageSync(ACCESS_TOKEN_ORIGIN, getApiBaseUrl());
}

/** 切换企业服务时清理旧服务的认证信息。 */
export function clearAccessToken(): void {
  uni.setStorageSync(ACCESS_TOKEN, "");
  uni.removeStorageSync(ACCESS_TOKEN_ORIGIN);
}

/**
 * 若当前运行时需要 Bearer 鉴权且 token 非空，写入 Authorization 头。
 *
 * - App / 微信小程序：始终写入（独立 `#ifdef`，避免 OR 条件被误裁）
 * - H5 开发 / App web-view 内嵌：写入
 * - H5 生产浏览器：不写，继续走 Cookie `ticket`
 *
 * @param header 请求头对象（会被原地修改）
 * @param accessToken 访问令牌；空则跳过
 */
export function applyBearerAuthorization(
  header: UTSJSONObject,
  accessToken: string | null,
): void {
  if (accessToken == null || `${accessToken}` == "") {
    return;
  }
  // #ifdef APP
  header["Authorization"] = `Bearer ${accessToken}`;
  return;
  // #endif
  // #ifdef MP-WEIXIN
  header["Authorization"] = `Bearer ${accessToken}`;
  return;
  // #endif

  // #ifdef H5 || WEB
  if (
    process.env.NODE_ENV === "development" ||
    isAppWebViewEmbedded()
  ) {
    header["Authorization"] = `Bearer ${accessToken}`;
  }
  // #endif
}
