    margin-top: 32rpx;
  }

  /* 加载状态 */
  .loading-state {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40rpx;
  }

  .loading-text {
    font-size: 28rpx;
