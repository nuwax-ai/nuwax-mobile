  .im-foot__text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #c0bec8;
  }

  /* ===== 会话 / 联系人通用行 ===== */
  .chat-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 38rpx 32rpx;
  }

  .chat-item--active {
    background-color: #f4f3f8;
  }

  .chat-item__avatar-wrap {
    position: relative;
    width: 112rpx;
    height: 112rpx;
    margin-right: 28rpx;
    flex-shrink: 0;
  }

  .chat-item__avatar {
    width: 112rpx;
    height: 112rpx;
    border-radius: 56rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-item__avatar-letter {
    font-size: 48rpx;
    line-height: 56rpx;
    font-weight: 600;
    color: #ffffff;
  }

  .chat-item__badge {
    position: absolute;
    top: -8rpx;
    right: -10rpx;
    min-width: 38rpx;
    height: 38rpx;
    padding: 0 10rpx;
    border-radius: 20rpx;
    background-color: #ff4d4f;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .chat-item__badge-text {
    font-size: 22rpx;
    line-height: 26rpx;
    font-weight: 600;
    color: #ffffff;
  }

  .chat-item__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .chat-item__title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .chat-item__title {
    flex: 1;
    font-size: 34rpx;
    line-height: 44rpx;
    font-weight: 600;
    color: #141416;
  }

  .chat-item__time {
    margin-left: 16rpx;
    flex-shrink: 0;
    font-size: 27rpx;
    line-height: 36rpx;
    color: #94929c;
  }

  .chat-item__sub {
    margin-top: 12rpx;
    font-size: 29rpx;
    line-height: 40rpx;
    color: #94929c;
  }

  .chat-divider {
    height: 2rpx;
    margin-left: 172rpx;
    background-color: #f0eff4;
  }

  /* ===== 智联录分组 ===== */
  .contact-group {
    display: flex;
    flex-direction: column;
