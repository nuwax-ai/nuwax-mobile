<template>
  <view class="provision-scan">
    <custom-nav-bar :title="t('Mobile.Provision.Scan.title')" :show-back="true" :has-safety-zone="true">
    </custom-nav-bar>

    <view class="provision-scan__body">
      <!-- 蓝牙/权限未就绪 -->
      <view v-if="!bleReady" class="provision-scan__panel">
        <text class="provision-scan__panel-text">{{ bleBlockText }}</text>
        <view class="provision-scan__btn" @tap="openBleSetting">
          <text class="provision-scan__btn-text">{{ bleBlockBtnText }}</text>
        </view>
      </view>

      <!-- 扫描中 / 结果 -->
      <template v-else>
        <view class="provision-scan__status">
          <view v-if="scanning" class="provision-scan__radar">
            <view class="provision-scan__radar-ring provision-scan__radar-ring--1"></view>
            <view class="provision-scan__radar-ring provision-scan__radar-ring--2"></view>
            <view class="provision-scan__radar-core"></view>
          </view>
          <text v-if="scanning" class="provision-scan__status-text">
            {{ t('Mobile.Provision.Scan.searching', toParams('seconds', countdown)) }}
          </text>
          <text v-else class="provision-scan__status-text">
            {{ t('Mobile.Provision.Scan.found', toParams('count', devices.length)) }}
          </text>
        </view>

        <!-- 设备列表 -->
        <scroll-view scroll-y class="provision-scan__list">
          <view
            v-for="(item, index) in devices"
            :key="item.deviceId"
            class="device-item"
            hover-class="device-item--hover"
            @tap="selectDevice(item)"
          >
            <view class="device-item__info">
              <text class="device-item__name">{{ item.name != '' ? item.name : item.deviceId }}</text>
              <text class="device-item__id">{{ item.deviceId }}</text>
            </view>
            <view class="device-item__rssi">
              <text class="device-item__rssi-text" :class="{ 'device-item__rssi-text--weak': item.rssi < -75 }">
                {{ item.rssi < -75 ? t('Mobile.Provision.Scan.signalWeak') : `${item.rssi}` }}
              </text>
            </view>
          </view>

          <!-- 空结果 -->
          <view v-if="!scanning && devices.length == 0" class="provision-scan__empty">
            <text class="provision-scan__empty-title">{{ t('Mobile.Provision.Scan.empty') }}</text>
            <text class="provision-scan__empty-tip">{{ t('Mobile.Provision.Scan.emptyTip') }}</text>
            <view class="provision-scan__btn" @tap="startScan">
              <text class="provision-scan__btn-text">{{ t('Mobile.Provision.Scan.rescan') }}</text>
            </view>
          </view>
        </scroll-view>
      </template>
    </view>
  </view>
</template>

<script setup lang="uts">
  import CustomNavBar from "@/components/custom-nav-bar/custom-nav-bar.uvue";
  import { ref, onUnmounted } from "vue";
  import { onLoad, onUnload } from "@dcloudio/uni-app";
  import { toI18nParams, emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { useEspProvisioning, releaseEspProvisioning } from "@/hooks/useEspProvisioning";
  import type { EspProvisioningDevice } from "@/types/interfaces/espProvisioning";
  import { setProvisionDevice } from "@/utils/provisionSession";
  import { ESP_PROV_SCAN_TIMEOUT_MS } from "@/constants/espProvisioning.constants";

  // 本地 t 包装（composable 的 t 在模板中解析有坑，与主包页面一致）
  // UTS 会将箭头函数的可选参数生成为 Kotlin 必填参数，因此显式提供默认值。
  function t(key: string, params: Record<string, string | number> | null = null): string {
    return translateFn(key, params != null ? params : emptyI18nParams(), "");
  }

  const controller = useEspProvisioning();
  const devices = controller.scannedDevices;

  const scanning = ref<boolean>(false);
  const countdown = ref<number>(Math.floor(ESP_PROV_SCAN_TIMEOUT_MS / 1000));
  // 蓝牙环境（M2 接入真实权限检查；Mock 下默认可用）
  const bleReady = ref<boolean>(true);
  const bleBlockText = ref<string>("");
  const bleBlockBtnText = ref<string>("");

  let countdownTimer = 0;
  let scanStopTimer = 0;

  const toParams = (key: string, value: number): Map<string, string | number> => {
    const m = new Map<string, string | number>();
    m.set(key, value);
    return toI18nParams(m);
  };

  const stopCountdown = () => {
    if (countdownTimer != 0) {
      clearInterval(countdownTimer);
      countdownTimer = 0;
    }
  };
  const startCountdown = () => {
    stopCountdown();
    countdown.value = Math.floor(ESP_PROV_SCAN_TIMEOUT_MS / 1000);
    countdownTimer = setInterval(() => {
      if (countdown.value > 0) {
        countdown.value -= 1;
      }
    }, 1000) as number;
  };

  const startScan = async () => {
    if (scanStopTimer != 0) clearTimeout(scanStopTimer);
    scanning.value = true;
    startCountdown();
    await controller.startScan();
    const scanError = controller.error.value;
    if (scanError != null) {
      scanning.value = false;
      stopCountdown();
      bleReady.value = false;
      bleBlockText.value = t(scanError.i18nKey);
      bleBlockBtnText.value = scanError.i18nKey == "Mobile.Provision.Scan.noPermission"
        ? t("Mobile.Provision.Scan.goAuthorize")
        : t("Mobile.Provision.Scan.rescan");
      return;
    }
    scanStopTimer = setTimeout(() => {
      controller.stopScan();
      scanning.value = false;
      stopCountdown();
      scanStopTimer = 0;
    }, ESP_PROV_SCAN_TIMEOUT_MS) as number;
  };

  const selectDevice = (item: EspProvisioningDevice) => {
    controller.stopScan();
    if (scanStopTimer != 0) {
      clearTimeout(scanStopTimer);
      scanStopTimer = 0;
    }
    scanning.value = false;
    stopCountdown();
    setProvisionDevice(item);
    uni.navigateTo({ url: "/subpackages/pages/provision/provision-wifi/provision-wifi" });
  };

  const openBleSetting = () => {
    if (controller.error.value != null && controller.error.value!!.i18nKey == "Mobile.Provision.Scan.noPermission") {
      uni.openAppAuthorizeSetting({});
      return;
    }
    bleReady.value = true;
    startScan();
  };

  onLoad((_options: OnLoadOptions) => {
    startScan();
  });

  onUnload(() => {
    stopCountdown();
    if (scanStopTimer != 0) clearTimeout(scanStopTimer);
    // scan → wifi → progress 使用同一会话；仅扫描页真正退出页面栈时释放。
    releaseEspProvisioning();
  });

  onUnmounted(() => {
    stopCountdown();
  });
</script>

<style lang="scss" scoped>
  .provision-scan {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;
  }

  .provision-scan__debug {
    font-size: 26rpx;
    color: #5147ff;
    padding: 0 24rpx;
  }

  .provision-scan__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .provision-scan__panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60rpx;
  }

  .provision-scan__panel-text {
    font-size: 30rpx;
    color: #666;
    text-align: center;
    margin-bottom: 40rpx;
  }

  .provision-scan__status {
    padding: 32rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .provision-scan__radar {
    width: 40rpx;
    height: 40rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-right: 16rpx;
  }

  .provision-scan__radar-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 36rpx;
    height: 36rpx;
    border-radius: 50%;
    border: 2rpx solid rgba(81, 71, 255, 0.5);
    transform: translate(-50%, -50%);
    opacity: 0.45;
  }

  .provision-scan__radar-ring--2 {
    width: 28rpx;
    height: 28rpx;
    opacity: 0.7;
  }

  .provision-scan__radar-core {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background-color: #5147ff;
  }

  .provision-scan__status-text {
    font-size: 28rpx;
    color: #999;
  }

  .provision-scan__list {
    flex: 1;
    padding: 0 32rpx;
  }

  .provision-scan__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 80rpx 40rpx;
  }

  .provision-scan__empty-title {
    font-size: 32rpx;
    color: #333;
    font-weight: 500;
    margin-bottom: 16rpx;
  }

  .provision-scan__empty-tip {
    font-size: 26rpx;
    color: #999;
    text-align: center;
    line-height: 1.6;
    margin-bottom: 40rpx;
  }

  .provision-scan__btn {
    background-color: #5147ff;
    border-radius: 48rpx;
    padding: 24rpx 64rpx;
  }

  .provision-scan__btn-text {
    color: #ffffff;
    font-size: 30rpx;
  }

  .device-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #ffffff;
    border-radius: 20rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
  }

  .device-item--hover {
    background-color: #f1f1f1;
  }

  .device-item__info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .device-item__name {
    font-size: 32rpx;
    color: #333;
    font-weight: 500;
    margin-bottom: 8rpx;
  }

  .device-item__id {
    font-size: 24rpx;
    color: #999;
  }

  .device-item__rssi-text {
    font-size: 26rpx;
    color: #4cd964;
  }

  .device-item__rssi-text--weak {
    color: #f0ad4e;
  }

</style>
