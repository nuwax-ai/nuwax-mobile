<template>
  <view class="recent-app-section">
    <view v-if="pages.length > 0" class="recent-section">
      <text class="section-title">{{ t("Mobile.Common.recentUsed") }}</text>
      <swiper
        class="recent-swiper"
        :current="current"
        :indicator-dots="false"
        :circular="false"
        :duration="300"
        @change="handleSwiperChange"
      >
        <swiper-item v-for="page in pages" :key="page.key">
          <view class="recent-grid">
            <view
              v-for="item in page.items"
              :key="getRecentItemKey(item)"
              class="recent-item"
              @click="handleItemClick(item)"
            >
              <view class="recent-icon-wrap">
                <image
                  class="recent-icon"
                  :src="getRecentItemIcon(item)"
                  mode="aspectFill"
                  :alt="getRecentItemName(item)"
                />
              </view>
              <text class="recent-name text-ellipsis">{{ getRecentItemName(item) }}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view v-if="pages.length > 1" class="custom-indicator">
        <view
          v-for="(page, pageIndex) in pages"
          :key="page.key"
          class="custom-indicator-item"
          @click="handleIndicatorClick(pageIndex)"
        >
          <view
            class="custom-indicator-dot"
            :class="{ 'custom-indicator-dot--on': current == pageIndex }"
          ></view>
        </view>
      </view>
    </view>
    <text class="section-title">{{ t("Mobile.AppDev.allApps") }}</text>
  </view>
</template>

<script setup lang="uts">
  import { RecentAppPage } from "@/types/interfaces/recentAppPage";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import agentImage from "@/static/assets/agent_image.png";

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  const props = withDefaults(
    defineProps<{
      pages: RecentAppPage[];
      current: number;
    }>(),
    {
      pages: [] as RecentAppPage[],
      current: 0,
    },
  );

  const emit = defineEmits<{
    change: [index: number];
    indicatorClick: [index: number];
    itemClick: [item: UTSJSONObject];
  }>();

  function getRecentItemKey(item: UTSJSONObject): string {
    const idRaw = item["id"];
    if (idRaw != null) {
      return `${idRaw}`;
    }
    const targetRaw = item["targetId"];
    return targetRaw != null ? `${targetRaw}` : "";
  }

  function getRecentItemName(item: UTSJSONObject): string {
    const nameRaw = item["name"];
    return nameRaw != null ? `${nameRaw}` : "";
  }

  function getRecentItemIcon(item: UTSJSONObject): string {
    const iconRaw = item["icon"];
    const icon = iconRaw != null ? `${iconRaw}` : "";
    return icon.length > 0 ? icon : agentImage;
  }

  function handleSwiperChange(e: UniSwiperChangeEvent): void {
    emit("change", e.detail.current);
  }

  function handleIndicatorClick(index: number): void {
    emit("indicatorClick", index);
  }

  function handleItemClick(item: UTSJSONObject): void {
    emit("itemClick", item);
  }
</script>

<style lang="scss" scoped>
  .section-title {
    padding: 24rpx 32rpx 8rpx;
    color: #111111;
    font-size: 32rpx;
    font-weight: 600;
    line-height: 44rpx;
  }

  .recent-section {
    flex-shrink: 0;
  }

  .recent-swiper {
    width: 100%;
    height: 360rpx;
  }

  .custom-indicator {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 8rpx 0 0;
  }

  .custom-indicator-item {
    height: 16rpx;
    padding: 0 6rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .custom-indicator-dot {
    width: 10rpx;
    height: 10rpx;
    border-radius: 10rpx;
    background-color: #e6e6e6;
  }

  .custom-indicator-dot--on {
    width: 28rpx;
    background-color: #d0d0d0;
  }

  .recent-grid {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8rpx 16rpx 0;
    box-sizing: border-box;
  }

  .recent-item {
    width: 25%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16rpx 8rpx 8rpx;
    box-sizing: border-box;
  }

  .recent-icon-wrap {
    width: 112rpx;
    height: 112rpx;
    border-radius: 28rpx;
    overflow: hidden;
    background-color: #f5f5f7;
  }

  .recent-icon {
    width: 112rpx;
    height: 112rpx;
  }

  .recent-name {
    width: 100%;
    margin-top: 12rpx;
    color: #333333;
    font-size: 24rpx;
    line-height: 34rpx;
    text-align: center;
  }
</style>
