<!-- 智能体卡片组件 -->
<template>
  <view
    class="card-container"
    :class="cardPressed ? 'card-container-press' : ''"
    @click.prevent="handleClick"
    @touchstart="handlePressStart"
    @touchmove="handlePressMove"
    @touchend="handlePressEnd"
    @touchcancel="handlePressEnd"
  >
    <agent-icon
      :icon="icon"
      :size="props.iconSize"
      :radius="props.iconRadius"
      :marginRight="24"
      :alt="name != null ? name : altIcon"
    />
    <view class="info-box">
      <view class="agent-info">
        <text class="agent-name">{{ name }}</text>
      </view>
      <text class="agent-description text-ellipsis">{{ description }}</text>
      <view class="agent-stats">
        <view class="stat-item">
          <image :src="iconUser" class="stat-icon" :fade-show="false" alt="" />
          <text class="stat-value">{{ userCount != null ? userCount : 0 }}</text>
        </view>
        <view class="stat-item">
          <image :src="iconMessage" class="stat-icon" :fade-show="false" alt="" />
          <text class="stat-value">{{ convCount != null ? convCount : 0 }}</text>
        </view>
        <view class="stat-item" hover-class="stat-item-active" @click.stop.prevent="handleCollect">
          <svg-icon name="icon-Star" customClass="stat-icon" v-if="!collect" />
          <svg-icon name="icon-Star-fill" customClass="stat-icon" v-else />
          <text class="stat-value">{{ collectCount != null ? collectCount : 0 }}</text>
        </view>
        <view class="flex-1"></view>
        <view class="status-tags" v-if="paymentRequired">
          <text v-if="subscribed" class="status-tag status-active">{{ tagSubscribed }}</text>
          <text v-else class="status-tag status-warning">{{ tagPaymentRequired }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import iconUser from "@/static/assets/icon_user.png";
  import iconMessage from "@/static/assets/icon_message.png";
  import AgentIcon from "@/components/agent-icon/agent-icon.uvue";
  import { ref } from "vue";
  import { t as translateFn, emptyI18nParams } from "@/utils/i18n";

  const _params = emptyI18nParams();
  const altIcon = translateFn("Mobile.Common.agentIconAlt", _params, "");
  const tagSubscribed = translateFn("Mobile.AgentList.subscribedTag", _params, "");
  const tagPaymentRequired = translateFn("Mobile.AgentList.paymentRequiredTag", _params, "");

  interface AgentComponentProps {
    // 图标
    icon: string;
    // 名称
    name: string;
    // 描述
    description: string;
    // 用户数
    userCount: number;
    // 对话数
    convCount: number;
    // 收藏数
    collectCount: number;
    // 收藏状态
    collect: boolean;
    // 是否要求订阅
    paymentRequired: boolean;
    // 是否已订阅
    subscribed: boolean;
    // 图标边长（rpx）。应用广场按设计稿 56px → 112rpx
    iconSize: number;
    // 图标圆角（rpx）。应用广场按设计稿 14px → 28rpx；小于 0 时为圆形
    iconRadius: number;
  }

  const props = withDefaults(defineProps<AgentComponentProps>(), {
    paymentRequired: false,
    subscribed: false,
    iconSize: 80,
    iconRadius: -1,
  });

  // Android / 鸿蒙的 hover-class 会在「按下」和「click」各加一次同类名，同一套背景会闪两下。
  // 不用 hover-class，只在 touch 期间加一次按下类。iOS 仍不加高亮。
  const cardPressed = ref<boolean>(false);
  let pressStartX = 0;
  let pressStartY = 0;

  const emit = defineEmits(["click", "collect"]);

  const handlePressStart = (e: UniTouchEvent) => {
    // #ifdef APP-IOS
    return;
    // #endif
    // #ifndef APP-IOS
    if (e == null || e.touches == null || e.touches.length == 0) return;
    pressStartX = e.touches[0].clientX;
    pressStartY = e.touches[0].clientY;
    cardPressed.value = true;
    // #endif
  };

  const handlePressMove = (e: UniTouchEvent) => {
    // #ifdef APP-IOS
    return;
    // #endif
    // #ifndef APP-IOS
    if (cardPressed.value != true) return;
    if (e == null || e.touches == null || e.touches.length == 0) return;
    const dx = Math.abs(e.touches[0].clientX - pressStartX);
    const dy = Math.abs(e.touches[0].clientY - pressStartY);
    if (dx > 10 || dy > 10) {
      cardPressed.value = false;
    }
    // #endif
  };

  const handlePressEnd = () => {
    cardPressed.value = false;
  };

  const handleClick = () => {
    cardPressed.value = false;
    emit("click");
  };

  const handleCollect = (e: UniPointerEvent) => {
    // 阻止冒泡到卡片 @click，避免收藏时进入详情
    e.stopPropagation();
    emit("collect");
  };
</script>

<style scoped lang="scss">
  .card-container {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 24rpx 32rpx 0 32rpx;
    background-color: #ffffff;
    // #ifndef APP
    cursor: pointer;
    // #endif
    transform: translateZ(0);
    // App 上 hover-class 会把过渡播两遍；按下态改为即时变色
    // #ifndef APP
    transition: background-color 0.3s ease;
    // #endif

    // #ifdef WEB
    &:hover {
      background-color: rgba(12, 20, 102, 0.04);
    }
    // #endif

    .info-box {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding-bottom: 24rpx;
      border-bottom: 1rpx solid #f5f5f7;

      .agent-info {
        display: flex;
        align-items: center;
        flex-direction: row;
        margin-bottom: 4rpx;

        .agent-name {
          flex: 1;
          line-height: 44rpx;
          font-size: 30rpx;
          font-weight: 600;
          color: #15171f;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
      }
    }

    .agent-description {
      font-size: 26rpx;
      color: rgba(21, 23, 31, 0.45);
      line-height: 40rpx;
      font-weight: 400;
      margin-bottom: 8rpx;
    }

    .agent-stats {
      display: flex;
      align-items: center;
      flex-direction: row;

      .stat-item {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: row;
        height: 48rpx;
        padding: 0 16rpx;
        border-radius: 8rpx;
        margin-right: 24rpx;

        &:last-child {
          margin-right: 0;
        }

        &-active {
          background-color: rgba(12, 20, 102, 0.04);
        }

        .stat-icon {
          width: 32rpx;
          height: 32rpx;
          margin-right: 8rpx;
        }

        .iconfont {
          margin-right: 8rpx;
          font-size: 28rpx;
          color: rgba(21, 23, 31, 0.45);
        }

        .icon-Star-fill {
          color: #faad14;
        }

        .stat-value {
          font-size: 24rpx;
          color: rgba(21, 23, 31, 0.45);
          font-weight: 400;
        }
      }

      .flex-1 {
        margin-right: 20rpx;
      }

      .status-tags {
        display: flex;
        align-items: center;
        flex-shrink: 0;

        .status-tag {
          padding: 2rpx 12rpx;
          border-radius: 6rpx;
          font-size: 20rpx;
          font-weight: 500;
          line-height: 1.5;
        }

        .status-active {
          background-color: rgba(82, 196, 26, 0.1);
          color: #52c41a;
        }

        .status-warning {
          border: 2rpx solid rgba(0, 122, 255, 0.4);
          color: #007aff;
          background-color: rgba(0, 122, 255, 0.08);
        }
      }
    }
  }

  /* 独立顶层类：勿嵌套在 .card-container 下（App 易匹配失败） */
  /* #ifndef APP-IOS */
  .card-container-press {
    background-color: rgba(12, 20, 102, 0.04);
  }
  /* #endif */
</style>
