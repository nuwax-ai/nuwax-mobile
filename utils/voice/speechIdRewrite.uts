/**
 * SSE 流式消息 id 改写映射（模块级单例）。
 *
 * 流式期间助手气泡使用客户端临时 id，SSE 收尾帧 / 会话重拉会把气泡 id 改写为服务端真实 id；
 * 而 voiceStreamSpeaker / ttsWebSocketPlayer / 原生桥镜像仍持有旧的临时 id。
 * 此映射记录「临时 id → 真实 id」，供 msg-tool-bar 判定「最后一条兜底亮灯」是否真的指向在播消息：
 * 只有兜底项恰好是被改写的在播消息时才允许亮，避免切换播报到另一条消息后旧图标残留。
 */
const rewriteMap: Map<string, string> = new Map();

/** 记录一次改写：oldId（客户端临时 id）→ newId（服务端真实 id）。 */
export function setMessageIdRewrite(oldId: string, newId: string): void {
  if (oldId.length == 0 || newId.length == 0 || oldId == newId) {
    return;
  }
  rewriteMap.set(oldId, newId);
}

/** 查询 oldId 改写后的真实 id；未改写返回空串。 */
export function getRewrittenMessageId(oldId: string): string {
  if (oldId.length == 0) {
    return "";
  }
  const v = rewriteMap.get(oldId);
  return v != null ? v : "";
}

/** 清空映射（新轮播报开始时调用；防止长会话内映射无限累积）。 */
export function clearMessageIdRewrite(): void {
  rewriteMap.clear();
}
