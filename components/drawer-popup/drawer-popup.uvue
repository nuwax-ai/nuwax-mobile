<template>
  <!-- APP：不用 uni-popup（$callMethod / v-if 销毁易 NPE，关闭后无法再开） -->
  <!-- #ifdef APP -->
  <view
    v-if="visible"
    class="drawer-wrapper page-container"
    :class="wrapperClass"
    @tap="onMaskTap"
  >
    <view
      class="drawer-content drawer-show"
      :class="drawerContentClass"
      :style="contentStyle"
      @tap.stop="onContentTap"
    >
      <view class="head-box" v-if="showHeader">
        <view class="title">
          <text class="text-ellipsis">{{ displayTitle }}</text>
        </view>
        <view class="close-btn" v-if="showCloseBtn" @tap.stop="close">
          <text class="close-text">×</text>
        </view>
      </view>
      <view class="content-box">
        <slot></slot>
      </view>
    </view>
  </view>
  <!-- #endif -->

  <!-- #ifndef APP -->
  <uni-popup
    ref="popupRef"
    :mask-click="false"
    :is-mask-click="false"
    @close="onUniPopupClose"
  >
    <view
      class="drawer-wrapper page-container"
      :class="wrapperClass"
      @tap="onMaskTap"
    >
      <view
        class="drawer-content"
        :class="drawerContentClass"
        :style="contentStyle"
        @tap.stop="onContentTap"
      >
        <view class="head-box" v-if="showHeader">
          <view class="title">
            <text class="text-ellipsis">{{ displayTitle }}</text>
          </view>
          <view class="close-btn" v-if="showCloseBtn" @tap.stop="close">
            <text class="close-text">×</text>
          </view>
        </view>
        <view v-if="visible" class="content-box">
          <slot></slot>
        </view>
      </view>
    </view>
  </uni-popup>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ref, computed, watch, type ComponentPublicInstance } from "vue";
  import { translateText } from "@/utils/i18n";

  const props = defineProps({
    title: { type: String, default: "" },
    width: { type: String, default: "75vw" },
    height: { type: String, default: "50vh" },
    defaultHeight: { type: String, default: "20vh" },
    maxHeight: { type: String, default: "50vh" },
    autoHeight: { type: Boolean, default: false },
    maskClick: { type: Boolean, default: true },
    direction: { type: String, default: "left" },
    showHeader: { type: Boolean, default: true },
    showCloseBtn: { type: Boolean, default: true },
    show: { type: Boolean, default: false },
  });

  const emit = defineEmits(["update-visible"]);

  const popupRef = ref<any | null>(null);
  const visible = ref(false);

  const displayTitle = computed((): string => {
    return translateText(props.title);
  });

  const wrapperClass = computed((): string => {
    return "direction-" + props.direction;
  });

  const drawerContentClass = computed((): string => {
    let cls = "direction-" + props.direction;
    // #ifndef APP
    if (visible.value == true) {
      cls = cls + " drawer-show";
    }
    // #endif
    if (props.autoHeight == true && props.direction == "bottom") {
      cls = cls + " auto-height";
    }
    return cls;
  });

  const contentStyle = computed((): string => {
    if (props.direction == "left") {
      return "width:" + props.width + ";height:100%;";
    }
    if (props.direction == "bottom") {
      if (props.autoHeight == true) {
        return (
          "width:100%;min-height:" +
          props.defaultHeight +
          ";max-height:" +
          props.maxHeight +
          ";"
        );
      }
      return "width:100%;height:" + props.height + ";";
    }
    return "";
  });

  const close = () => {
    if (visible.value != true) {
      return;
    }
    visible.value = false;
    emit("update-visible", false);
    // #ifndef APP
    setTimeout(() => {
      const popup = popupRef.value;
      if (popup != null) {
        const inst = popup as ComponentPublicInstance;
        inst.$callMethod("close");
      }
    }, 200);
    // #endif
  };

  const onMaskTap = () => {
    if (props.maskClick == true) {
      close();
    }
  };

  const onContentTap = () => {};

  const onUniPopupClose = () => {
    visible.value = false;
    if (props.show == true) {
      emit("update-visible", false);
    }
  };

  const open = () => {
    // #ifndef APP
    const popup = popupRef.value;
    if (popup != null) {
      const inst = popup as ComponentPublicInstance;
      inst.$callMethod("open");
    }
    setTimeout(() => {
      visible.value = true;
    }, 20);
    // #endif
    // #ifdef APP
    visible.value = true;
    // #endif
  };

  defineExpose({
    open: open as any,
    close: close as any,
  });

  // 受控：直接跟随 show，避免 closing 标志导致无法再次打开
  watch(
    (): boolean => props.show as boolean,
    (newVal: boolean) => {
      if (newVal == true) {
        open();
      } else {
        if (visible.value == true) {
          close();
        } else {
          visible.value = false;
        }
      }
    },
    { immediate: true },
  );
</script>

<style scoped lang="scss">
  @import "./drawer-popup.scss";

  .close-text {
    font-size: 40rpx;
    color: #333;
    line-height: 1;
  }
</style>
