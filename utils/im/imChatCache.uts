/**
 * 聊天页首屏消息缓存（模块级，页面销毁不丢）。
 *
 * 目的：退出聊天再进入时先立即渲染上次的窗口（免白屏等网络），随后由
 * silentSyncLatest 静默拉最新一页增量合并（去重按 msgId，插入按 seq）。
 *
 * 存服务端 records 原文（UTSJSONObject[]，降序 新→旧，与接口返回一致），
 * 进页时用页面内 readMsgRow 重新构造 ImMsgRow——uts 模块不能反向依赖
 * uvue 页面类型，存原文是最小耦合。
 *
 * 只缓存首屏窗口（最新一页）；向上翻页按 beforeSeq 实时拉取，不进缓存。
 * LRU 容量 3 个会话：频繁切换会话时淘汰最久未访问的，防内存累积。
 *
 * 另存「阅读位置记忆」（ChatScrollMemo，飞书式）：离开页面时记首可见行 msgId
 * 与距底余量，下次进页缓存命中且不在底部时锚定回该行；与 records 缓存
 * 同会话同淘汰（没有 records 窗口的位置记忆无意义）。
 */

const chatRecordsCache = new Map<string, UTSJSONObject[]>();
/** 阅读位置记忆（convId → 离开时的 scrollTop / 距底余量）。 */
const chatScrollMemoCache = new Map<string, ChatScrollMemo>();
/** 访问顺序（队尾最新），用于超量淘汰最久未访问的会话。 */
const chatCacheOrder: string[] = [];
const CHAT_CACHE_MAX_CONVS = 3;

/** 阅读位置记忆：anchorId=离开时首可见行 msgId；distBottom=视口底距内容底的余量（在底部≈0）。 */
export class ChatScrollMemo {
  anchorId: string = "";
  distBottom: number = 0;
}

/** 取缓存的 records 原文；无缓存或空返回 null（调用方走正常网络路径）。 */
export function getCachedChatRecords(convId: string): UTSJSONObject[] | null {
  if (convId.length == 0) {
    return null;
  }
  const cached = chatRecordsCache.get(convId);
  if (cached == null || cached.length == 0) {
    return null;
  }
  return cached;
}

/** 写/刷新缓存并挪到 LRU 队尾；超量淘汰队头。 */
export function setCachedChatRecords(convId: string, records: UTSJSONObject[]): void {
  if (convId.length == 0 || records.length == 0) {
    return;
  }
  const existedIdx = chatCacheOrder.indexOf(convId);
  if (existedIdx >= 0) {
    chatCacheOrder.splice(existedIdx, 1);
  }
  chatCacheOrder.push(convId);
  chatRecordsCache.set(convId, records);
  while (chatCacheOrder.length > CHAT_CACHE_MAX_CONVS) {
    const oldest = chatCacheOrder[0];
    chatCacheOrder.splice(0, 1);
    chatRecordsCache.delete(oldest);
    chatScrollMemoCache.delete(oldest);
  }
}

/** 取阅读位置记忆；无记忆返回 null（调用方按底部进页）。 */
export function getCachedChatScroll(convId: string): ChatScrollMemo | null {
  if (convId.length == 0) {
    return null;
  }
  return chatScrollMemoCache.get(convId);
}

/** 写阅读位置记忆（生命周期跟随 records 缓存的 LRU 淘汰）。 */
export function setCachedChatScroll(convId: string, memo: ChatScrollMemo): void {
  if (convId.length == 0) {
    return;
  }
  chatScrollMemoCache.set(convId, memo);
}
