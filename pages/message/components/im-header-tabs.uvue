<template>
  <!--
    伙伴页页头（组件化 Stage 3 从 message-content 抽出，模板/样式原样迁移）：
    消息 / 智联录 tab + 搜索、添加占位入口。全部交互经 emit 上抛，守卫（吞击判定）
    与状态在页面侧处理器内——组件零自有状态。
    ★加号测量协议：uni-app x 的 createSelectorQuery 不穿透自定义组件（.in 限定
    范围），「+」节点移入本组件后页面查不到——measurePlus() 在组件自身作用域
    测 .im-action--plus，原始矩形数字经 plus-rect 上抛（页面 onHeaderPlusMeasured
    拼「+」气泡锚定/Android 补层；同机制后续供行菜单测量复用）。
  -->
  <view class="im-header">
    <view class="im-tab-row">
      <view class="im-tab" @click="emitTabClick('chat')">
        <text
          class="im-tab__text"
          :class="{ 'im-tab__text--on': activeTab == 'chat' }"
        >{{ t("Mobile.Message.chatTabMessages") }}</text>
      </view>
      <view class="im-tab" @click="emitTabClick('contact')">
        <view class="im-tab__label">
          <text
            class="im-tab__text"
            :class="{ 'im-tab__text--on': activeTab == 'contact' }"
          >{{ t("Mobile.Nav.unionRecord") }}</text>
          <!-- 待我处理的好友申请角标：同意/拒绝后整表重拉，角标随之增减 -->
          <view v-if="pendingInCount > 0" class="im-tab__badge">
            <text class="im-tab__badge-text">{{ formatUnread(pendingInCount) }}</text>
          </view>
        </view>
      </view>
      <view class="im-tab-spacer" />
      <view class="im-action" @click="emitSearchTap">
        <svg-icon name="icon-Search" size="22" unit="px" color="#1c1b20" />
      </view>
      <view
        class="im-action im-action--plus"
        :class="{ 'im-action--covered': addCovered }"
        @click="emitPlusTap"
      >
        <svg-icon name="icon-a-Pluscircle" size="22" unit="px" color="#1c1b20" />
      </view>
    </view>
    <view class="im-header-line" />
  </view>
</template>

<script setup lang="uts">
  import { getCurrentInstance } from "vue";
  import { emptyI18nParams, t as translateFn } from "@/utils/i18n";
  import { formatUnread as formatUnreadOf } from "./im-row-helpers.uts";

  // 事件名须 kebab-case：App-Android 模板监听会把 camelCase 转小写导致收不到（add-menu-drawer 同规约）
  const emit = defineEmits<{
    /** tab 点击（载荷 'chat' | 'contact'；页面 switchTab 含吞击守卫+延迟提交）。 */
    "tab-click": [tab: string];
    /** 搜索入口点击（页面 handlePlaceholderTap：吞击守卫+跳 im-search）。 */
    "search-tap": [];
    /** 加号点击（页面 openAddDrawer：toggle/守卫/发起测量）。 */
    "plus-tap": [];
    /** 加号矩形测量结果（视口 px 原始数字；-1=未测到。页面拼气泡锚定与 Android 补层）。 */
    "plus-rect": [left: number, top: number, right: number, bottom: number];
  }>();

  withDefaults(
    defineProps<{
      /** 当前 tab（'chat' | 'contact'；页面 activeTab 直发，控制文案激活态）。 */
      activeTab: string;
      /** 智联录 tab 待处理申请角标数（0=不渲染角标）。 */
      pendingInCount: number;
      /** 加号补层方案开启（页面 addDrawerVisible 直发：Android 隐藏真图标由替身接手）。 */
      addCovered: boolean;
    }>(),
    {
      activeTab: "chat",
      pendingInCount: 0,
      addCovered: false,
    },
  );

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  // ★uvue 模板不能直接调用导入函数（invoke 解析失败）——本地 const 包装（Stage 1 同款）
  const formatUnread = (count: number): string => formatUnreadOf(count);

  const componentInstance = getCurrentInstance();

  /** createSelectorQuery.exec 回调（具名函数：深层箭头块会触发 UTS 截断编译，
      message-content 同款约束）。矩形解析后原始数字直发页面（视口坐标系）。 */
  function onPlusRectMeasured(results: Array<any>): void {
    let leftPx = -1;
    let topPx = -1;
    let rightPx = -1;
    let bottomPx = -1;
    if (results.length > 0) {
      const raw = results[0];
      if (raw != null) {
        const rect = raw as NodeInfo;
        if (rect.left != null) {
          leftPx = parseFloat(`${rect.left}`);
        }
        if (rect.top != null) {
          topPx = parseFloat(`${rect.top}`);
        }
        if (rect.right != null) {
          rightPx = parseFloat(`${rect.right}`);
        }
        if (rect.bottom != null) {
          bottomPx = parseFloat(`${rect.bottom}`);
        }
      }
    }
    emit("plus-rect", leftPx, topPx, rightPx, bottomPx);
  }

  /** 组件作用域测加号矩形（页面 openAddDrawer 经 $callMethod 调起；boundingClientRect
      为视口坐标系，与页面 touch 事件的 clientX/Y 同系，无需换算）。 */
  function measurePlus(): void {
    const proxy = componentInstance != null ? componentInstance.proxy : null;
    if (proxy == null) {
      return;
    }
    uni.createSelectorQuery()
      .in(proxy)
      .select(".im-action--plus")
      .boundingClientRect()
      .exec(onPlusRectMeasured);
  }

  defineExpose({
    measurePlus: measurePlus as any,
  });

  function emitTabClick(tab: string): void {
    emit("tab-click", tab);
  }

  function emitSearchTap(): void {
    emit("search-tap");
  }

  function emitPlusTap(): void {
    emit("plus-tap");
  }
</script>

<style lang="scss" scoped>
  .im-header {
    flex-shrink: 0;
  }

  .im-tab-row {
    height: 52px;
    padding: 0 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .im-tab {
    margin-right: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .im-tab__text {
    /* 未激活态对齐专家页右上角「更多」（search-more-bar）；激活色同底部 tabBar selectedColor */
    font-size: 16px;
    line-height: 22px;
    font-weight: 400;
    color: rgba(21, 23, 31, 0.5);
  }

  .im-tab__text--on {
    color: #141416;
    /* 激活加粗对齐应用页官方推荐/团队发布（source-item--on） */
    font-weight: 700;
  }

  /* tab 文案行：横排文案 + 角标（角标随「待我处理」数出现，整组仍随 tab 居中） */
  .im-tab__label {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  /* 智联录 tab 待处理数字角标：红底白字对齐行内未读（chat-item__badge），尺寸收小贴 tab 文案 */
  .im-tab__badge {
    min-width: 16px;
    height: 16px;
    margin-left: 5px;
    padding: 0 4px;
    border-radius: 8px;
    background-color: #ff4d4f;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .im-tab__badge-text {
    font-size: 10px;
    line-height: 12px;
    font-weight: 600;
    color: #ffffff;
  }

  .im-tab-spacer {
    flex: 1;
  }

  .im-action {
    width: 36px;
    height: 36px;
    margin-left: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .im-action--plus {
    position: relative;
  }

  /* Android 专属：加号补层方案开启时隐藏真图标（补层图标替身）。iOS/H5 不渲染
     补层，真图标不遮——否则蒙层展开期间加号会凭空消失（class 仍会挂上但无规则）。 */
  /* #ifdef APP-ANDROID */
  .im-action--covered {
    opacity: 0;
  }
  /* #endif */

  .im-header-line {
    height: 1px;
    background-color: #eceaf1;
  }
</style>
