/**
 * App TTS WebSocket 播放器。
 * 服务端下发 PCM16 LE mono；客户端收齐后封装为 WAV，再交给 InnerAudioContext 播放。
 *
 * H5 注意：浏览器要求 play() 落在用户手势链路内。TTS 合成是异步的，
 * 因此在 play() 同步阶段先用同一 InnerAudioContext 播一段静音 WAV 解锁
 * （SILENT_WAV_DATA_URI，宽限期防被打断），合成完成后再切到真实 WAV。
 */
import { getApiBaseUrl } from "@/constants/config";
import { resolveSpeechAccessToken } from "./speechToken";
import { audioPlayerManager } from "./audioPlayerManager";
import { loadVoiceSettings } from "./voiceTypes";
import { SpeechWsKeepalive } from "./speechWsKeepalive";

export type TtsPlaybackState =
  | "idle"
  | "connecting"
  | "synthesizing"
  | "playing"
  | "paused"
  | "error";

export type TtsPlaybackListener = (
  state: TtsPlaybackState,
  messageId: string,
) => void;

class TtsListenerEntry {
  id: number;
  callback: TtsPlaybackListener;

  constructor(id: number, callback: TtsPlaybackListener) {
    this.id = id;
    this.callback = callback;
  }
}

/**
 * 极短静音 WAV，仅用于 H5 在用户点击时解锁音频通道。
 * 结构完全合法：0.05s / 8kHz / 16bit mono，44 字节 RIFF 头 + 800 字节全零 PCM，
 * 可正常解码并“播放”0.05s 数字静音，没有任何可闻声音（unlock-tone 的提示音会漏出）。
 * 也带真实播放时长（非 0 data 空壳），iOS 判定元素“播放过”即可放行后续异步 play()。
 */
const SILENT_WAV_DATA_URI =
  "data:audio/wav;base64,";

function createTtsWebSocketUrl(token: string): string {
  let baseUrl = getApiBaseUrl();
  if (baseUrl.startsWith("https://")) {
    baseUrl = "wss://" + baseUrl.substring(8);
  } else if (baseUrl.startsWith("http://")) {
    baseUrl = "ws://" + baseUrl.substring(7);
  }
  // 与 ASR 一致，使用 /api/speech/*（不以旧文档 /api/app/* 为准）
  let url = baseUrl + "/api/speech/tts/ws";
  // 浏览器无法可靠传递自定义握手 Header，使用 Query 鉴权；App（含 iOS）走 Header。
  // #ifdef H5 || WEB
  const encodedTokenRaw = encodeURIComponent(token);
  const encodedToken =
    encodedTokenRaw != null ? encodedTokenRaw : token;
  url += "?access_token=" + encodedToken;
  // #endif
  return url;
}

/** 构建 App/小程序 WebSocket 握手鉴权头。 */
function createTtsWebSocketHeaders(token: string): UTSJSONObject {
  const header = new UTSJSONObject();
  header["Authorization"] = "Bearer " + token;
  return header;
}

function writeAscii(view: DataView, offset: number, text: string): void {
  for (let i = 0; i < text.length; i++) {
    const code = text.charCodeAt(i);
    view.setUint8(offset + i, code != null ? code : 0);
  }
}

/** 将多个 PCM16 数据块封装为标准 WAV。 */
function buildPcm16Wav(chunks: Uint8Array[], sampleRate: number): ArrayBuffer {
  let pcmLength = 0;
  for (let i = 0; i < chunks.length; i++) {
    pcmLength += chunks[i].length;
  }
  const buffer = new ArrayBuffer(44 + pcmLength);
  const view = new DataView(buffer);
  writeAscii(view, 0, "RIFF");
  view.setUint32(4, 36 + pcmLength, true);
  writeAscii(view, 8, "WAVE");
  writeAscii(view, 12, "fmt ");
  view.setUint32(16, 16, true);
  view.setUint16(20, 1, true);
  view.setUint16(22, 1, true);
  view.setUint32(24, sampleRate, true);
  view.setUint32(28, sampleRate * 2, true);
  view.setUint16(32, 2, true);
  view.setUint16(34, 16, true);
  writeAscii(view, 36, "data");
  view.setUint32(40, pcmLength, true);

  const output = new Uint8Array(buffer);
  let offset = 44;
  // App UTS 不支持 TypedArray.set(array, offset)；H5 虽可用 set，统一按下标写入保证各端 WAV 有真实 PCM。
  // （曾用条件编译混写 set/loop，App 上易出现「有头无数据」导致播不出声）
  for (let i = 0; i < chunks.length; i++) {
    const chunk = chunks[i];
    for (let j = 0; j < chunk.length; j++) {
      output[offset + j] = chunk[j];
    }
    offset += chunk.length;
  }
  return buffer;
}

/**
 * H5 手势解锁播放宽限期（ms）：
 * unlockInGesture 启动的解锁 play() 是异步 pending 的，若在同一同步栈内（toggleSpeech 的
 * stop / begin 的 stop）立即 audio.stop()，会打断它 → 每次必抛 AbortError，且 iOS 判定元素
 * 从未真正播放过 → 后续异步 play() 仍被拦截。宽限期内 stopSharedAudio 跳过 stop，让解锁
 * 片段（约 0.05s）自然播完。真实播放开始（synth 至少数百 ms 后）时早已超窗，不受影响。
 */
const UNLOCK_PLAY_GRACE_MS: number = 500;

async function saveWavFile(buffer: ArrayBuffer): Promise<string> {
  // #ifdef H5 || WEB
  const blob = new Blob([buffer], { type: "audio/wav" });
  return URL.createObjectURL(blob);
  // #endif

  // #ifndef H5 || WEB
  return await new Promise<string>((resolve, reject) => {
    const filePath =
      uni.env.USER_DATA_PATH + "/tts-" + Date.now().toString() + ".wav";
    uni.getFileSystemManager().writeFile({
      filePath,
      data: buffer,
      success: () => resolve(filePath),
      fail: (err) => reject(new Error(err.errMsg ?? "TTS 音频保存失败")),
    });
  });
  // #endif
}

/**
 * 同步识别 ArrayBuffer / TypedArray（避免 UTS 里 Promise.then 丢失）。
 * Blob 无法同步读取，返回 null 走异步路径。
 */
function tryAsArrayBufferSync(data: any | null): ArrayBuffer | null {
  if (data == null) {
    return null;
  }
  // #ifdef H5 || WEB
  try {
    const dataObj = data as UTSJSONObject;
    const byteOffsetVal = dataObj["byteOffset"];
    const sizeVal = dataObj["size"];
    // Blob：有 size，需 FileReader
    if (typeof sizeVal == "number" && typeof byteOffsetVal != "number") {
      return null;
    }
    // TypedArray
    if (typeof byteOffsetVal == "number" && dataObj["buffer"] != null) {
      const maybeView = data as Uint8Array;
      const out = new Uint8Array(maybeView.byteLength);
      for (let i = 0; i < maybeView.byteLength; i++) {
        out[i] = maybeView[i];
      }
      return out.buffer as ArrayBuffer;
    }
  } catch (_eSync) {
    // fallthrough
  }
  // #endif
  const asBuffer = data as ArrayBuffer;
  if (typeof asBuffer.byteLength == "number") {
    return asBuffer;
  }
  return null;
}

/**
 * 将 WebSocket 二进制帧规范为 ArrayBuffer。
 * H5 上常见为 Blob，不能直接当 ArrayBuffer 读 byteLength。
 * 注意：本函数对外不 reject，避免 UTS 对 Promise.catch 回调签名的限制。
 * Android：禁止对 ArrayBuffer 使用 `as Uint8Array`（会 ClassCastException）。
 */
function toArrayBufferAsync(data: any): Promise<ArrayBuffer | null> {
  if (data == null) {
    return Promise.resolve(null);
  }
  const sync = tryAsArrayBufferSync(data);
  if (sync != null) {
    return Promise.resolve(sync);
  }
  // #ifdef H5 || WEB
  try {
    const dataObj = data as UTSJSONObject;
    const sizeVal = dataObj["size"];
    if (typeof sizeVal == "number") {
      const blobCandidate = data as Blob;
      return new Promise<ArrayBuffer | null>((resolve) => {
        try {
          const reader = new FileReader();
          reader.onload = (): void => {
            const result = reader.result;
            if (
              result != null &&
              typeof (result as ArrayBuffer).byteLength == "number"
            ) {
              resolve(result as ArrayBuffer);
            } else {
              resolve(null);
            }
          };
          reader.onerror = (): void => {
            resolve(null);
          };
          reader.readAsArrayBuffer(blobCandidate);
        } catch (_eRead) {
          if (typeof blobCandidate.arrayBuffer == "function") {
            blobCandidate
              .arrayBuffer()
              .then((buf: ArrayBuffer): void => {
                resolve(buf);
              })
              .catch((): void => {
                resolve(null);
              });
          } else {
            resolve(null);
          }
        }
      });
    }
  } catch (_eAsync) {
    // fallthrough
  }
  // #endif
  return Promise.resolve(null);
}

/** 构造 TTS JSON 控制帧（避免 object literal as UTSJSONObject 序列化丢字段） */
function buildTtsControlMessage(
  type: string,
  text: string | null = null,
  sampleRate: number = 0,
  flush: boolean = false,
): UTSJSONObject {
  const payload = new UTSJSONObject();
  payload["type"] = type;
  if (type == "start") {
    payload["sample_rate"] = sampleRate;
    payload["frame_duration_ms"] = 20;
  } else if (type == "text") {
    payload["text"] = text != null ? text! : "";
    payload["flush"] = flush;
  }
  return payload;
}

/**
 * TTS Socket 统一抽象。
 * Android UTS 不能把任意类 as interface，故用可继承基类，避免 ClassCastException。
 */
type TtsSocketOpenCallback = (result: OnSocketOpenCallbackResult) => void;
type TtsSocketMessageCallback = (result: OnSocketMessageCallbackResult) => void;
type TtsSocketErrorCallback = (result: GeneralCallbackResult) => void;
type TtsSocketCloseCallback = (result: OnSocketCloseCallbackResult) => void;

class TtsSocketHandle {
  send(_options: SendSocketMessageOptions): void {}
  close(_options: CloseSocketOptions): void {}
  onOpen(_callback: TtsSocketOpenCallback): void {}
  onMessage(_callback: TtsSocketMessageCallback): void {}
  onError(_callback: TtsSocketErrorCallback): void {}
  onClose(_callback: TtsSocketCloseCallback): void {}
}

/**
 * App / 小程序：包装 uni.SocketTask。
 */
class UniSocketTaskAdapter extends TtsSocketHandle {
  private task: SocketTask;

  constructor(task: SocketTask) {
    super();
    this.task = task;
  }

  override onOpen(cb: TtsSocketOpenCallback): void {
    this.task.onOpen(cb);
  }

  override onMessage(cb: TtsSocketMessageCallback): void {
    this.task.onMessage(cb);
  }

  override onError(cb: TtsSocketErrorCallback): void {
    this.task.onError(cb);
  }

  override onClose(cb: TtsSocketCloseCallback): void {
    // 编译期签名是 (Any)=>void；运行期实参是 OnSocketCloseCallbackResult
    this.task.onClose((result: any): void => {
      cb(result as OnSocketCloseCallbackResult);
    });
  }

  override send(options: SendSocketMessageOptions): void {
    this.task.send(options);
  }

  override close(options: CloseSocketOptions): void {
    this.task.close(options);
  }
}

/**
 * H5 原生 WebSocket 适配器（API 对齐 SocketTask 常用方法）。
 * uni.connectSocket 在部分 H5 环境会出现：能收 tts_ready，后续 PCM/tts_end 全部丢失。
 */
// #ifdef H5 || WEB
class H5NativeSocketAdapter extends TtsSocketHandle {
  private ws: any | null = null;
  private openCbs: TtsSocketOpenCallback[] = [];
  private messageCbs: TtsSocketMessageCallback[] = [];
  private errorCbs: TtsSocketErrorCallback[] = [];
  private closeCbs: TtsSocketCloseCallback[] = [];

  constructor(url: string) {
    super();
    const ws = new WebSocket(url);
    ws.binaryType = "arraybuffer";
    this.ws = ws;
    ws.onopen = (): void => {
      const openResult = {} as OnSocketOpenCallbackResult;
      for (let i = 0; i < this.openCbs.length; i++) {
        this.openCbs[i](openResult);
      }
    };
    ws.onmessage = (ev: any): void => {
      const res = {
        data: ev.data,
      } as OnSocketMessageCallbackResult;
      for (let i = 0; i < this.messageCbs.length; i++) {
        this.messageCbs[i](res);
      }
    };
    ws.onerror = (): void => {
      const err = {
        errMsg: "TTS WebSocket 错误",
      } as GeneralCallbackResult;
      for (let i = 0; i < this.errorCbs.length; i++) {
        this.errorCbs[i](err);
      }
    };
    ws.onclose = (): void => {
      const closeResult = {
        code: 1000,
        reason: "TTS WebSocket closed",
      } as OnSocketCloseCallbackResult;
      for (let i = 0; i < this.closeCbs.length; i++) {
        this.closeCbs[i](closeResult);
      }
    };
  }

  override onOpen(cb: TtsSocketOpenCallback): void {
    this.openCbs.push(cb);
  }

  override onMessage(cb: TtsSocketMessageCallback): void {
    this.messageCbs.push(cb);
  }

  override onError(cb: TtsSocketErrorCallback): void {
    this.errorCbs.push(cb);
  }

  override onClose(cb: TtsSocketCloseCallback): void {
    this.closeCbs.push(cb);
  }

  override send(options: SendSocketMessageOptions): void {
    const ws = this.ws;
    if (ws == null) {
      return;
    }
    // readyState 1 = OPEN
    if (ws.readyState == 1) {
      ws.send(options.data);
    } else {
      console.warn("[TTS] native send skip readyState=", ws.readyState);
    }
  }

  override close(_options: CloseSocketOptions): void {
    try {
      if (this.ws != null) {
        this.ws.close();
      }
    } catch (_eClose) {
      // ignore
    }
  }
}
// #endif

/** 创建 TTS Socket：H5 走原生 WebSocket，App 走 uni.connectSocket */
function createTtsSocket(
  accessToken: string,
  onFail: (errMsg: string) => void,
): TtsSocketHandle | null {
  const url = createTtsWebSocketUrl(accessToken);
  // #ifdef H5 || WEB
  try {
    return new H5NativeSocketAdapter(url);
  } catch (e: any) {
    onFail(e != null && e.message != null ? `${e.message}` : "TTS 连接失败");
    return null;
  }
  // #endif
  // #ifndef H5 || WEB
  const task = uni.connectSocket({
    url: url,
    header: createTtsWebSocketHeaders(accessToken),
    fail: (err) => {
      onFail(err.errMsg ?? "TTS 连接失败");
    },
  });
  return new UniSocketTaskAdapter(task);
  // #endif
}

export class TtsWebSocketPlayer {
  /** UniSocketTaskAdapter / H5NativeSocketAdapter */
  private socketTask: TtsSocketHandle | null = null;
  private audioContext: InnerAudioContext | null = null;
  private chunks: Uint8Array[] = [];
  private state: TtsPlaybackState = "idle";
  private messageId: string = "";
  private text: string = "";
  private generation: number = 0;
  private listeners: TtsListenerEntry[] = [];
  private nextListenerId: number = 1;
  private readonly sampleRate: number = 16000;
  /** 尚未完成 ArrayBuffer 转换的二进制帧数（H5 Blob） */
  private pendingBinary: number = 0;
  /** 已收到 tts_end，等待 pendingBinary 清零后再封装播放 */
  private finishRequested: boolean = false;
  /** 是否已切入真实 TTS 音频（避免静音解锁片段的 onEnded 误停） */
  private realPlayback: boolean = false;
  /** 正在从解锁片段切换到真实音频，期间忽略 abort 类错误 */
  private switchingToReal: boolean = false;
  /** 因静音而暂停，取消静音后可 resume */
  private pausedByMute: boolean = false;
  /** H5 blob: URL，stop 时 revoke */
  private blobUrl: string = "";
  /**
   * 允许预热建连（按下录音时开启；非进页长连）。
   * false 时 ensureWarmSocketAsync 不再建连。
   */
  private warmupEnabled: boolean = false;
  /** 预热待命连接（已 open，尚未 send start） */
  private warmSocketTask: TtsSocketHandle | null = null;
  private warmOpen: boolean = false;
  private warmGeneration: number = 0;
  /** 等待预热 open 的回调（避免覆盖 socket.onOpen） */
  private warmOpenWaiters: ((ok: boolean) => void)[] = [];
  /** 闲置关闭定时器：播报结束后延迟释放 TCP */
  private idleCloseTimerId: number = 0;
  /**
   * 播报/合成空闲后关闭连接的等待（ms）。
   * 分句间隙会取消重计；完整播报结束后也可由 releaseIdleConnection 立刻关。
   */
  private readonly IDLE_CLOSE_MS: number = 30000;
  /**
   * 每次 finishSynthesis 递增；H5/WEB 上 InnerAudioContext 的 onCanplay 会叠加，
   * 旧回调用过期 id 直接 return，避免双重 play 重启。
   */
  private playRequestId: number = 0;
  /**
   * 边播边合成取消令牌：仅 bump 本字段，禁止动 generation / 当前音频。
   * 流式分句在播 A 时预取合成 B。
   */
  private synthEpoch: number = 0;
  /** 是否有 preservePlayingAudio 合成占用 session socket */
  private synthInFlight: boolean = false;
  /**
   * 单一消息出口：每个 SocketTask 只注册一次 onMessage，业务通过替换 sink 切换。
   * 避免 warm 空回调 + bindSession 二次 onMessage 在 H5 上叠层/后者被忽略。
   */
  private socketMessageSink: ((res: OnSocketMessageCallbackResult) => void) | null =
    null;
  /** 已安装 router 的 socket，避免重复 onMessage */
  private socketRouterInstalledFor: TtsSocketHandle | null = null;
  /** 预热连接 open 时刻，用于丢弃过久空闲连接 */
  private warmOpenedAtMs: number = 0;
  /** tts_ready 后合成卡住检测定时器 */
  private synthStallTimerId: number = 0;
  /** 预热 / 会话连接成功后的心跳保活 */
  private keepalive: SpeechWsKeepalive = new SpeechWsKeepalive();
  /** fail toast 节流，避免流式多句连续弹窗 */
  private lastFailToastAtMs: number = 0;
  /** 最近一次合成 PCM 估算时长（ms）；H5 blob URL 长度不能反映音频时长 */
  private lastSynthDurationMs: number = 0;
  /** H5：最近一次手势解锁 play() 的发起时刻；宽限期内 stopSharedAudio 跳过 stop */
  private unlockPlayAtMs: number = 0;

  /**
   * 录音 onStart 后预热：建连但不发合成请求（轻触未开录勿调）。
   * 防重连风暴：已有 warm / 建连中则直接返回。
   */
  enableWarmupAndConnect(): void {
    this.warmupEnabled = true;
    this.cancelIdleClose();
    if (this.isWarmOpen() == true) {
      return;
    }
    if (this.warmSocketTask != null) {
      return;
    }
    if (this.socketTask != null) {
      // 会话进行中已有连接，无需再预热
      return;
    }
    this.ensureWarmSocketAsync();
  }

  /** 离开会话页 / 停止会话：关闭预热与业务连接（前后台 Hide 不要调） */
  disableWarmupAndDisconnect(): void {
    this.warmupEnabled = false;
    this.cancelIdleClose();
    this.generation += 1;
    this.warmGeneration += 1;
    this.clearSynthStallWatchdog();
    this.closeWarmSocket();
    this.closeSessionSocketOnly();
    this.keepalive.resume();
    this.stopKeepalive();
    this.keepalive.resetServerReject();
    // 销毁音频，但不经由 recycle（上面已关连）
    const audio = this.audioContext;
    this.audioContext = null;
    if (audio != null) {
      try {
        audio!.stop();
        audio!.destroy();
      } catch (_eAudio) {
        // ignore
      }
    }
    this.revokeBlobUrl();
    this.chunks = [] as Uint8Array[];
    this.text = "";
    this.messageId = "";
    this.setState("idle");
  }

  /**
   * 整轮播报结束后释放空闲连接（流式分句全部播完 / 工具栏播完）。
   * 分句之间请勿调用——应继续复用 warm TCP。
   */
  releaseIdleConnection(): void {
    this.cancelIdleClose();
    // 合成或播放进行中：改走闲置超时，避免掐断尾句
    if (
      this.state == "connecting" ||
      this.state == "synthesizing" ||
      this.state == "playing" ||
      this.synthInFlight == true
    ) {
      this.scheduleIdleClose(this.IDLE_CLOSE_MS);
      return;
    }
    this.closeWarmSocket();
    this.closeSessionSocketOnly();
    this.stopKeepalive();
  }

  private cancelIdleClose(): void {
    if (this.idleCloseTimerId != 0) {
      clearTimeout(this.idleCloseTimerId);
      this.idleCloseTimerId = 0;
    }
  }

  /** 空闲后关闭 warm/session TCP；busy 时由调用方改用更长 delay */
  private scheduleIdleClose(delayMs: number): void {
    this.cancelIdleClose();
    let wait = delayMs;
    if (wait < 0) {
      wait = 0;
    }
    this.idleCloseTimerId = setTimeout((): void => {
      this.idleCloseTimerId = 0;
      if (
        this.state == "connecting" ||
        this.state == "synthesizing" ||
        this.state == "playing" ||
        this.synthInFlight == true
      ) {
        // 仍忙：再延一档
        this.scheduleIdleClose(this.IDLE_CLOSE_MS);
        return;
      }
      this.closeWarmSocket();
      this.closeSessionSocketOnly();
      this.stopKeepalive();
    }, wait) as number;
  }

  /**
   * 当前应保活的 socket：会话优先，否则预热。
   * open 成功或 socket 角色切换后调用。
   */
  private refreshKeepalive(): void {
    const sock =
      this.socketTask != null ? this.socketTask : this.warmSocketTask;
    if (sock == null) {
      this.stopKeepalive();
      return;
    }
    this.keepalive.start(
      "TTS",
      (payloadJson: string): boolean => {
        const active =
          this.socketTask != null ? this.socketTask : this.warmSocketTask;
        if (active == null) {
          return false;
        }
        try {
          const sendOpts = {
            data: payloadJson,
          } as SendSocketMessageOptions;
          active!.send(sendOpts);
          return true;
        } catch (_eSend) {
          return false;
        }
      },
      (): void => {
        // 心跳成功则刷新预热空闲计时，避免误判 stale 半死连接
        if (this.socketTask == null && this.warmSocketTask != null) {
          this.warmOpenedAtMs = Date.now();
        }
      },
    );
  }

  private stopKeepalive(): void {
    this.keepalive.stop();
  }

  /** SSE 进行中暂停 TTS 心跳（不断连、不打断合成） */
  pauseKeepalive(): void {
    this.keepalive.pause();
  }

  /** SSE 结束后恢复 TTS 心跳 */
  resumeKeepalive(): void {
    this.keepalive.resume();
  }

  /**
   * 识别服务端 UNKNOWN_TYPE(ping)：仅降噪标记，返回 true 表示本帧已消费。
   * 不关连接、不停业务、不触碰 chat SSE。
   */
  private tryHandleKeepaliveReject(raw: string): boolean {
    if (raw.indexOf("UNKNOWN_TYPE") < 0) {
      return false;
    }
    if (raw.indexOf("ping") < 0 && raw.indexOf("pong") < 0) {
      return false;
    }
    let message: UTSJSONObject | null = null;
    try {
      message = JSON.parse<UTSJSONObject>(raw);
    } catch (_eJson) {
      return false;
    }
    if (message == null) {
      return false;
    }
    const typeVal = message!["type"];
    const type = typeVal != null ? `${typeVal}` : "";
    if (type != "error") {
      return false;
    }
    const codeVal = message!["code"];
    const msgVal = message!["message"];
    const code = codeVal != null ? `${codeVal}` : "";
    const msg = msgVal != null ? `${msgVal}` : "";
    if (
      code == "UNKNOWN_TYPE" &&
      (msg.indexOf("ping") >= 0 || msg.indexOf("pong") >= 0)
    ) {
      this.keepalive.markRejectedByServer();
      return true;
    }
    return false;
  }

  /** 是否已有可用预热连接 */
  isWarmOpen(): boolean {
    return this.warmOpen == true && this.warmSocketTask != null;
  }

  subscribe(callback: TtsPlaybackListener): number {
    const id = this.nextListenerId++;
    this.listeners.push(new TtsListenerEntry(id, callback));
    callback(this.state, this.messageId);
    return id;
  }

  unsubscribe(listenerId: number): void {
    this.listeners = this.listeners.filter(
      (entry: TtsListenerEntry): boolean => entry.id != listenerId,
    );
  }

  getState(): TtsPlaybackState {
    return this.state;
  }

  getMessageId(): string {
    return this.messageId;
  }

  /**
   * 最近一次 synthesizeToSrc 完成时的 PCM 估算时长（ms）。
   * H5 blob: URL 的 string.length 不能反映音频时长，播放超时请用此值或 playSrcAndWait 的 durationMs 入参。
   */
  getLastSynthDurationMs(): number {
    return this.lastSynthDurationMs;
  }

  /**
   * 全局静音：调节当前音频音量。
   * 静音期间点播会以 volume=0 继续播；取消静音时调用本方法即可恢复出声，无需 stop/resume。
   */
  setMuted(muted: boolean): void {
    const audio = this.audioContext;
    if (audio != null) {
      audio!.volume = muted ? 0 : 1;
    }
  }

  /**
   * 暂停当前播报（用于切到静音时）。
   * - 已在播放：pause 音频，状态改为 paused
   * - 仍在连接/合成：直接 stop，避免静音后继续合成
   */
  pause(): void {
    if (this.state == "playing" && this.audioContext != null) {
      try {
        this.audioContext!.pause();
      } catch (e: any) {
        console.warn("[TTS] pause failed", e);
      }
      this.pausedByMute = true;
      this.setState("paused");
      return;
    }
    if (this.state == "connecting" || this.state == "synthesizing") {
      this.stop();
    }
  }

  /**
   * 恢复因静音暂停的播报。
   */
  resume(): void {
    if (
      this.pausedByMute != true ||
      this.state != "paused" ||
      this.audioContext == null
    ) {
      return;
    }
    const audio = this.audioContext!;
    audio.volume = this.getTargetVolume();
    this.pausedByMute = false;
    this.setState("playing");
    try {
      audio.play();
    } catch (e: any) {
      console.warn("[TTS] resume failed", e);
    }
  }

  /**
   * H5：audio.play() 在 uni-app x 运行时内被丢弃（play(){this._audio.play()}），返回值恒为
   * undefined，因此这里 catch 不到任何东西——被 pause()/stop()/换源打断的 AbortError 只能靠
   * App.uvue 的全局 unhandledrejection 兜底吞掉。本方法保留：一是防御未来运行时返回 Promise，
   * 二是非 H5 平台正常同步 play()。
   */
  private safePlay(audio: InnerAudioContext): void {
    // #ifdef H5 || WEB
    try {
      const p = audio.play() as any;
      if (p != null && typeof p.catch == "function") {
        p.catch((e: any) => {
          const name = e != null && (e as any).name != null ? `${(e as any).name}` : "";
          const msg = e != null && (e as any).message != null ? `${(e as any).message}` : "";
          console.error("[H5Voice] safePlay rejected name=" + name + " msg=" + msg);
        });
      }
    } catch (eSafe: any) {
      console.error("[H5Voice] safePlay threw", eSafe);
    }
    // #endif
    // #ifndef H5 || WEB
    audio.play();
    // #endif
  }

  /** 按当前 VoiceSettings.muted 计算目标音量 */
  private getTargetVolume(): number {
    return loadVoiceSettings().muted == true ? 0 : 1;
  }

  async play(messageId: string, text: string): Promise<void> {
    // 串行分句时复用已解锁的 InnerAudioContext，避免 H5 第二句再走手势解锁失败后卡住
    // 只结束上一句会话音频状态，禁止动预热 TCP（recycle 空 session 为 no-op）
    this.prepareForNextUtterance(true);
    if (text.trim().length == 0) {
      throw new Error("没有可播报的文本");
    }
    const accessToken = resolveSpeechAccessToken();
    if (accessToken.length == 0) {
      throw new Error("登录状态已失效");
    }
    audioPlayerManager.stop();
    this.generation += 1;
    const expectedGeneration = this.generation;
    this.messageId = messageId;
    this.text = text;
    this.chunks = [] as Uint8Array[];
    this.pendingBinary = 0;
    this.finishRequested = false;
    this.realPlayback = false;
    this.switchingToReal = false;
    this.pausedByMute = false;
    this.setState("connecting");

    // 仅首次创建并解锁；后续句子复用同一 audio，否则无手势下 H5 会拦截且 playAndWait 永不结束
    if (this.audioContext == null) {
      this.prepareAudioContextForGesture();
    }

    // 预热丢失（上次 fail 关连 / 对端掐断）时先补待命再取用，避免业务路径直接 new WebSocket
    if (
      this.warmupEnabled == true &&
      this.isWarmOpen() != true &&
      this.warmSocketTask == null
    ) {
      console.warn("[TTS] warm missing before play → ensure warm");
      this.ensureWarmSocketAsync();
      await this.waitForWarmOpen(3000);
      if (expectedGeneration != this.generation) {
        return;
      }
    }

    await this.takeOrOpenSessionSocket(accessToken, expectedGeneration);
    if (expectedGeneration != this.generation) {
      return;
    }
    this.sendJson(buildTtsControlMessage("start", null, this.sampleRate));
  }

  /**
   * 与工具栏 play 同一套合成+播报，并等到本轮结束（idle/error）再返回。
   * @returns true=正常播完；false=error/超时/无音频（调用方应停掉后续分句）
   */
  async playAndWait(messageId: string, text: string): Promise<boolean> {
    const trimmed = text.trim();
    if (trimmed.length == 0) {
      return true;
    }
    await this.play(messageId, trimmed);
    const expectedGeneration = this.generation;
    // 防止 H5 起播失败时永远卡在 synthesizing（听感=播完一句就停）
    let waitMs = 30000 + trimmed.length * 80;
    if (waitMs > 180000) {
      waitMs = 180000;
    }
    return await new Promise<boolean>((resolve) => {
      let settled = false;
      let seenActive = false;
      let succeeded = true;
      let listenerId = 0;
      let timerId = 0;
      const finish = (ok: boolean): void => {
        if (settled) {
          return;
        }
        settled = true;
        if (timerId > 0) {
          clearTimeout(timerId);
          timerId = 0;
        }
        if (listenerId > 0) {
          this.unsubscribe(listenerId);
          listenerId = 0;
        }
        resolve(ok);
      };
      timerId = setTimeout(() => {
        if (expectedGeneration == this.generation) {
          // 超时收尾：收回待命并进入闲置关闭，不再强制补预热
          this.prepareForNextUtterance(true);
        }
        finish(false);
      }, waitMs);
      listenerId = this.subscribe((state: TtsPlaybackState, _mid: string) => {
        // 正常播完：onEnded → prepareForNextUtterance 会先 bump generation 再 idle。
        // 若此处一律按 generation 不等判失败，流式首句播完会被当成 TTS failed，后续分句全部丢弃。
        if (expectedGeneration != this.generation) {
          if (seenActive == true && (state == "idle" || state == "error")) {
            finish(state != "error");
          } else if (seenActive != true) {
            finish(false);
          }
          return;
        }
        if (
          state == "connecting" ||
          state == "synthesizing" ||
          state == "playing"
        ) {
          seenActive = true;
          return;
        }
        if (state == "error") {
          succeeded = false;
          finish(false);
          return;
        }
        if (seenActive == true && state == "idle") {
          finish(succeeded);
        }
      });
    });
  }

  /** 当前合成/取连接操作是否已取消 */
  private isSynthOpCancelled(
    preservePlayingAudio: boolean,
    expectedGeneration: number,
    expectedSynthEpoch: number,
  ): boolean {
    if (preservePlayingAudio == true) {
      return expectedSynthEpoch != this.synthEpoch;
    }
    return expectedGeneration != this.generation;
  }

  /**
   * 取消边播边合成（不打断当前音频播放）。
   * kickPlay 失败 / 换轮次时调用。
   */
  cancelInFlightPreserveSynth(): void {
    if (this.synthInFlight != true) {
      return;
    }
    this.synthEpoch += 1;
    this.synthInFlight = false;
    this.clearSynthStallWatchdog();
    this.finishRequested = false;
    this.pendingBinary = 0;
    this.chunks = [] as Uint8Array[];
    this.recycleSessionToWarm();
  }

  /**
   * 只合成可播放 src，不播报（供 audioPlayerManager / 流式边播边合成）。
   * @param preservePlayingAudio true：不 stop 当前音频、不 bump generation；供播 A 时预取 B
   */
  async synthesizeToSrc(
    text: string,
    preservePlayingAudio: boolean = false,
  ): Promise<string> {
    const trimmed = text.trim();
    if (trimmed.length == 0) {
      return "";
    }
    const accessToken = resolveSpeechAccessToken();
    if (accessToken.length == 0) {
      throw new Error("登录状态已失效");
    }

    if (preservePlayingAudio == true) {
      // 取消上一笔预取合成；保留正在播放的音频与 generation
      // 主句仍在占用 session 时禁止并发开第二条 WS（否则双连接 + 帧风暴 → ANR）
      if (this.socketTask != null) {
        console.warn("[TTS] refuse preserve synth while session busy");
        throw new Error("TTS session busy");
      }
      this.synthEpoch += 1;
      this.synthInFlight = true;
      this.clearSynthStallWatchdog();
      this.chunks = [] as Uint8Array[];
      this.pendingBinary = 0;
      this.finishRequested = false;
      this.text = trimmed;
      // 不改 messageId / realPlayback：当前句仍在播
    } else {
      // 与工具栏互斥：结束上一会话，但保留已解锁 InnerAudioContext（H5）
      this.prepareForNextUtterance(true);
      this.messageId = "";
      this.text = trimmed;
      this.chunks = [] as Uint8Array[];
      this.pendingBinary = 0;
      this.finishRequested = false;
      this.realPlayback = false;
      this.switchingToReal = false;
      this.pausedByMute = false;
    }

    const expectedGeneration = this.generation;
    const expectedSynthEpoch = this.synthEpoch;
    const preserve = preservePlayingAudio == true;

    await this.takeOrOpenSessionSocket(
      accessToken,
      expectedGeneration,
      preserve,
      expectedSynthEpoch,
    );
    if (
      this.isSynthOpCancelled(preserve, expectedGeneration, expectedSynthEpoch)
    ) {
      if (preserve == true) {
        this.synthInFlight = false;
        this.recycleSessionToWarm();
      }
      throw new Error("TTS 会话已取消");
    }

    return await new Promise<string>((resolve, reject) => {
      let settled = false;
      /** 对端已关闭时不可 recycle */
      let canRecycle = true;
      const fail = (message: string): void => {
        if (settled) {
          return;
        }
        settled = true;
        if (preserve == true) {
          this.synthInFlight = false;
        }
        // 失败不断连：收回待命，心跳继续；不碰当前播放音频
        this.recycleSessionToWarm();
        reject(new Error(message));
      };

      const tryFinishSrc = (): void => {
        if (!this.finishRequested || this.pendingBinary > 0 || settled) {
          return;
        }
        if (
          this.isSynthOpCancelled(
            preserve,
            expectedGeneration,
            expectedSynthEpoch,
          )
        ) {
          return;
        }
        settled = true;
        if (preserve == true) {
          this.synthInFlight = false;
        }
        if (this.chunks.length == 0) {
          this.recycleSessionToWarm();
          reject(new Error("TTS 未返回音频"));
          return;
        }
        let pcmBytes = 0;
        for (let ci = 0; ci < this.chunks.length; ci++) {
          pcmBytes += this.chunks[ci].length;
        }
        // PCM16 mono：时长 = bytes / (sampleRate * 2)
        const durMs = Math.floor((pcmBytes * 1000) / (this.sampleRate * 2));
        this.lastSynthDurationMs = durMs > 0 ? durMs : 0;
        const wav = buildPcm16Wav(this.chunks, this.sampleRate);
        if (canRecycle == true) {
          this.recycleSessionToWarm();
        } else {
          this.socketTask = null;
        }
        saveWavFile(wav).then(
          (src: string) => {
            resolve(src);
          },
          (e: any | null) => {
            let msg = "TTS 音频保存失败";
            if (e != null) {
              const em = (e as UTSJSONObject)["message"];
              if (em != null && `${em}`.length > 0) {
                msg = `${em}`;
              }
            }
            reject(new Error(msg));
          },
        );
      };

      // 临时覆盖消息处理：合成路径不走播放（经 socketMessageSink，不二次 onMessage）
      const sock = this.socketTask;
      if (sock == null) {
        fail("TTS 连接失败");
        return;
      }
      this.installSocketRouter(sock!);
      this.socketMessageSink = (res: OnSocketMessageCallbackResult): void => {
        if (
          this.isSynthOpCancelled(
            preserve,
            expectedGeneration,
            expectedSynthEpoch,
          )
        ) {
          return;
        }
        if (typeof res.data != "string") {
          this.pendingBinary += 1;
          toArrayBufferAsync(res.data).then((buffer: ArrayBuffer | null): void => {
            this.pendingBinary -= 1;
            if (this.pendingBinary < 0) {
              this.pendingBinary = 0;
            }
            if (
              this.isSynthOpCancelled(
                preserve,
                expectedGeneration,
                expectedSynthEpoch,
              )
            ) {
              tryFinishSrc();
              return;
            }
            if (buffer != null && buffer!.byteLength > 0) {
              this.chunks.push(new Uint8Array(buffer!));
            }
            tryFinishSrc();
          });
          return;
        }
        let message: UTSJSONObject | null = null;
        try {
          message = JSON.parse<UTSJSONObject>(res.data as string);
        } catch (_eJson) {
          fail("TTS 返回了无效消息");
          return;
        }
        if (message == null) {
          return;
        }
        const typeVal = message!["type"];
        const type = typeVal != null ? `${typeVal}` : "";
        if (type == "ping" || type == "pong") {
          return;
        }
        if (type == "tts_ready") {
          this.sendJson(buildTtsControlMessage("text", trimmed, 0, true));
        } else if (type == "tts_begin") {
          // 服务端正常生命周期：每句合成开始都会推一次，流式多句会多次出现，无需告警
          return;
        } else if (type == "tts_end") {
          this.finishRequested = true;
          tryFinishSrc();
        } else if (type == "error") {
          const codeVal = message!["code"];
          const messageVal = message!["message"];
          const code = codeVal != null ? `${codeVal}` : "";
          const msg = messageVal != null ? `${messageVal}` : "TTS 合成失败";
          if (
            code == "UNKNOWN_TYPE" &&
            (msg.indexOf("ping") >= 0 || msg.indexOf("pong") >= 0)
          ) {
            this.keepalive.markRejectedByServer();
            return;
          }
          fail(msg);
        } else if (type.length > 0) {
          console.warn("[TTS] synthesize unknown type=", type);
        }
      };
      sock!.onError((err: GeneralCallbackResult) => {
        if (
          this.isSynthOpCancelled(
            preserve,
            expectedGeneration,
            expectedSynthEpoch,
          )
        ) {
          return;
        }
        fail(err.errMsg ?? "TTS WebSocket 错误");
      });
      sock!.onClose((_res: OnSocketCloseCallbackResult) => {
        if (
          this.isSynthOpCancelled(
            preserve,
            expectedGeneration,
            expectedSynthEpoch,
          ) ||
          settled
        ) {
          return;
        }
        canRecycle = false;
        this.finishRequested = true;
        tryFinishSrc();
      });

      this.sendJson(buildTtsControlMessage("start", null, this.sampleRate));
    });
  }

  /**
   * 播放已合成的 src，并等到结束（供流式边播边合成，避免串行 playAndWait 的合成空窗）。
   * @param expectedDurationMs 该 src 对应 PCM 估算时长；深预取时 lastSynthDurationMs 会被后续句覆盖，必须传本条目时长。
   * @returns true=正常播完；false=error/超时
   */
  async playSrcAndWait(
    messageId: string,
    src: string,
    expectedDurationMs: number = 0,
  ): Promise<boolean> {
    if (src.trim().length == 0) {
      return true;
    }
    audioPlayerManager.stop();
    // 不 bump generation / 不 recycle：预取合成可能占用 socket
    this.clearSynthStallWatchdog();
    this.messageId = messageId;
    this.finishRequested = false;
    this.realPlayback = false;
    this.switchingToReal = false;
    this.pausedByMute = false;

    if (this.audioContext == null) {
      this.prepareAudioContextForGesture();
    }
    let audio = this.audioContext;
    if (audio == null) {
      audio = uni.createInnerAudioContext();
      this.audioContext = audio;
      // #ifdef APP-IOS
      audio.obeyMuteSwitch = false;
      // #endif
    }

    // #ifdef H5 || WEB
    this.revokeBlobUrl();
    if (src.indexOf("blob:") == 0) {
      this.blobUrl = src;
    }
    // #endif

    this.stopSharedAudio();
    audio!.volume = this.getTargetVolume();
    // #ifdef APP-IOS
    audio!.obeyMuteSwitch = false;
    // #endif

    this.playRequestId = this.playRequestId + 1;
    const reqId = this.playRequestId;
    const waitGeneration = this.generation;
    let playStarted = false;
    const startPlay = (): void => {
      if (reqId != this.playRequestId) {
        return;
      }
      if (playStarted) {
        return;
      }
      playStarted = true;
      this.switchingToReal = true;
      try {
        audio!.play();
      } catch (ePlay: any) {
        console.warn("[TTS] playSrc.play threw", ePlay);
        playStarted = false;
      }
    };

    audio!.onPlay(() => {
      if (reqId != this.playRequestId) {
        return;
      }
      if (this.switchingToReal || this.realPlayback) {
        this.switchingToReal = false;
        this.realPlayback = true;
        this.setState("playing");
      }
    });
    audio!.onEnded(() => {
      if (reqId != this.playRequestId) {
        return;
      }
      if (this.realPlayback != true) {
        return;
      }
      // 流水线预取可能紧接下一句合成：播放收尾一律不 recycle，避免清掉 in-flight PCM
      this.endPlaybackKeepSynth();
    });
    audio!.onError((err) => {
      if (reqId != this.playRequestId) {
        return;
      }
      if (this.switchingToReal && this.realPlayback != true) {
        return;
      }
      if (this.realPlayback) {
        this.fail(err.errMsg ?? "TTS 音频播放失败");
      }
    });

    // #ifdef H5 || WEB
    audio!.onCanplay(() => {
      startPlay();
    });
    audio!.src = src;
    setTimeout(() => {
      startPlay();
    }, 80);
    // #endif

    // #ifndef H5
    // #ifndef WEB
    audio!.src = src;
    startPlay();
    // #endif
    // #endif

    // H5 blob: URL 的 src.length≈63，旧公式几乎总是 ~30s，长音频会被误掐断
    let durationHint = expectedDurationMs;
    if (durationHint <= 0) {
      durationHint = this.lastSynthDurationMs;
    }
    let waitMs = 60000;
    if (durationHint > 0) {
      waitMs = durationHint + 15000;
    }
    if (waitMs < 20000) {
      waitMs = 20000;
    }
    if (waitMs > 300000) {
      waitMs = 300000;
    }
    return await new Promise<boolean>((resolve) => {
      let settled = false;
      let seenActive = false;
      let listenerId = 0;
      let timerId = 0;
      const finish = (ok: boolean): void => {
        if (settled) {
          return;
        }
        settled = true;
        if (timerId > 0) {
          clearTimeout(timerId);
          timerId = 0;
        }
        if (listenerId > 0) {
          this.unsubscribe(listenerId);
          listenerId = 0;
        }
        resolve(ok);
      };
      timerId = setTimeout(() => {
        console.warn(
          "[TTS] playSrcAndWait timeout reqId=",
          reqId,
          "state=",
          this.state,
          "waitMs=",
          waitMs,
          "durationHint=",
          durationHint,
        );
        // 必须先 finish(false)：若先 endPlayback→idle，订阅会抢成 finish(true)
        finish(false);
        if (reqId == this.playRequestId) {
          this.endPlaybackKeepSynth();
        }
      }, waitMs);
      listenerId = this.subscribe((state: TtsPlaybackState, _mid: string) => {
        // endPlaybackKeepSynth 不 bump generation；外部 stop/synthesize(false) 才会 bump
        if (waitGeneration != this.generation) {
          if (seenActive == true && (state == "idle" || state == "error")) {
            finish(state != "error");
          } else if (seenActive != true) {
            finish(false);
          }
          return;
        }
        if (state == "playing") {
          seenActive = true;
          return;
        }
        if (state == "error") {
          finish(false);
          return;
        }
        if (state == "idle" && seenActive == true) {
          finish(true);
        }
      });
    });
  }

  /**
   * 播放结束且预取合成仍在进行：停音频、idle，但不 recycle / 不清 PCM / 不取消合成。
   */
  private endPlaybackKeepSynth(): void {
    this.clearSynthStallWatchdog();
    this.stopSharedAudio();
    this.revokeBlobUrl();
    this.realPlayback = false;
    this.switchingToReal = false;
    this.pausedByMute = false;
    this.messageId = "";
    this.setState("idle");
  }

  private notifyWarmOpenWaiters(ok: boolean): void {
    const waiters = this.warmOpenWaiters.slice();
    this.warmOpenWaiters = [] as ((ok: boolean) => void)[];
    for (let i = 0; i < waiters.length; i++) {
      waiters[i](ok);
    }
  }

  /** 等待预热连接 open；超时返回 false。不替换已有 onOpen。 */
  private waitForWarmOpen(timeoutMs: number): Promise<boolean> {
    if (this.warmOpen == true && this.warmSocketTask != null) {
      return Promise.resolve(true);
    }
    if (this.warmSocketTask == null) {
      return Promise.resolve(false);
    }
    return new Promise<boolean>((resolve) => {
      let settled = false;
      const done = (ok: boolean): void => {
        if (settled) {
          return;
        }
        settled = true;
        resolve(ok);
      };
      this.warmOpenWaiters.push(done);
      setTimeout(() => {
        done(false);
      }, timeoutMs);
    });
  }

  /** 取预热连接或新建会话连接，并绑好播放用消息回调 */
  private async takeOrOpenSessionSocket(
    accessToken: string,
    expectedGeneration: number,
    preservePlayingAudio: boolean = false,
    expectedSynthEpoch: number = 0,
  ): Promise<void> {
    // 即将使用连接：取消闲置关闭
    this.cancelIdleClose();
    // 合成路径允许在无预热时临时建连（文本发送未按过录音）
    if (this.warmupEnabled != true) {
      this.warmupEnabled = true;
    }
    const cancelled = (): boolean => {
      return this.isSynthOpCancelled(
        preservePlayingAudio,
        expectedGeneration,
        expectedSynthEpoch,
      );
    };
    // 预热已就绪 → 直接复用；若仍在连 → 短等；否则新建
    if (this.warmOpen != true || this.warmSocketTask == null) {
      if (this.warmSocketTask != null) {
        const ok = await this.waitForWarmOpen(5000);
        if (cancelled()) {
          return;
        }
        // 超时也不主动 close：继续等 open 回调；若仍不可用再走新建
        if (ok != true && this.warmOpen != true) {
          console.warn("[TTS] warm still not open after wait");
        }
      }
    }
    if (this.warmOpen == true && this.warmSocketTask != null) {
      this.socketTask = this.warmSocketTask;
      this.warmSocketTask = null;
      this.warmOpen = false;
      this.warmOpenedAtMs = 0;
      // preserve 合成会立刻覆盖 sink；仍 bind 以保证 socket router 就绪
      this.bindSessionHandlers(expectedGeneration);
      this.refreshKeepalive();
      return;
    }
    // 已有未 open 完的 warm：禁止再 new，避免双连接
    if (this.warmSocketTask != null) {
      console.warn("[TTS] warm connecting, skip openSession");
      const ok = await this.waitForWarmOpen(5000);
      if (cancelled()) {
        return;
      }
      if (ok == true && this.warmSocketTask != null) {
        this.socketTask = this.warmSocketTask;
        this.warmSocketTask = null;
        this.warmOpen = false;
        this.warmOpenedAtMs = 0;
        this.bindSessionHandlers(expectedGeneration);
        this.refreshKeepalive();
        return;
      }
    }
    await this.openSessionSocketOnce(
      accessToken,
      expectedGeneration,
      preservePlayingAudio,
      expectedSynthEpoch,
    );
  }

  /** 建立会话 Socket（open 后 bindSessionHandlers） */
  private openSessionSocketOnce(
    accessToken: string,
    expectedGeneration: number,
    preservePlayingAudio: boolean = false,
    expectedSynthEpoch: number = 0,
  ): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      let settled = false;
      const socketTask = createTtsSocket(accessToken, (errMsg: string) => {
        if (settled) {
          return;
        }
        settled = true;
        reject(new Error(errMsg));
      });
      if (socketTask == null) {
        return;
      }
      this.socketTask = socketTask;
      this.installSocketRouter(socketTask);
      this.preferArrayBufferBinaryType(socketTask);
      socketTask.onOpen((_openRes: OnSocketOpenCallbackResult) => {
        if (settled) {
          return;
        }
        settled = true;
        if (
          this.isSynthOpCancelled(
            preservePlayingAudio,
            expectedGeneration,
            expectedSynthEpoch,
          )
        ) {
          reject(new Error("TTS 会话已取消"));
          return;
        }
        this.preferArrayBufferBinaryType(socketTask);
        this.bindSessionHandlers(expectedGeneration);
        this.refreshKeepalive();
        resolve();
      });
      socketTask.onError((err: GeneralCallbackResult) => {
        if (settled) {
          return;
        }
        settled = true;
        const errMsg =
          err.errMsg != null && err.errMsg.length > 0
            ? err.errMsg
            : "TTS WebSocket 错误";
        reject(new Error(errMsg));
      });
      // 握手超时：避免挂死在半开连接
      setTimeout(() => {
        if (settled) {
          return;
        }
        settled = true;
        reject(new Error("TTS 连接超时"));
      }, 8000);
    });
  }

  /**
   * 每个 Socket 只装一次 onMessage，转发到 socketMessageSink。
   * 切换 warm/session 时只改 sink，不再二次 onMessage（H5 上后者可能无效或叠层）。
   */
  private installSocketRouter(socketTask: TtsSocketHandle): void {
    if (this.socketRouterInstalledFor == socketTask) {
      return;
    }
    this.socketRouterInstalledFor = socketTask;
    socketTask.onMessage((res: OnSocketMessageCallbackResult) => {
      const dataType = typeof res.data;
      // 仅处理「当前会话 socket」或「当前预热 socket」的消息，避免旧连接串扰
      const isSession = this.socketTask == socketTask;
      const isWarm = this.warmSocketTask == socketTask;
      // 预热期 sink=null，须在此识别服务端拒绝 ping，否则心跳会一直打
      if (
        dataType == "string" &&
        (isSession || isWarm) &&
        this.tryHandleKeepaliveReject(res.data as string)
      ) {
        return;
      }
      if (!isSession && !isWarm) {
        return;
      }
      const sink = this.socketMessageSink;
      if (sink == null) {
        // 预热待命期 sink 故意为 null；会话期若为空则属异常
        if (isSession) {
          const dataType = typeof res.data;
          let hint = dataType;
          if (dataType == "string") {
            const s = res.data as string;
            hint = s.length > 80 ? s.substring(0, 80) : s;
          } else {
            const sync = tryAsArrayBufferSync(res.data);
            if (sync != null) {
              hint = "bin:" + sync.byteLength.toString();
            }
          }
          console.warn(
            "[TTS] drop msg: session sink=null data=",
            hint,
          );
        }
        return;
      }
      // 预热 socket 在待命期不应处理业务；若误装 sink 也忽略
      if (isWarm && !isSession) {
        return;
      }
      sink(res);
    });
  }

  /** H5 uni.SocketTask：尽量用 arraybuffer；原生适配器构造时已设置，此处为兼容 */
  private preferArrayBufferBinaryType(socketTask: TtsSocketHandle): void {
    // #ifdef H5 || WEB
    try {
      const anySock = socketTask as any;
      if (anySock == null) {
        return;
      }
      anySock.binaryType = "arraybuffer";
      const nestedKeys = ["ws", "_webSocket", "socket", "_socket"];
      for (let i = 0; i < nestedKeys.length; i++) {
        const nested = anySock[nestedKeys[i]];
        if (nested != null) {
          try {
            nested.binaryType = "arraybuffer";
          } catch (_eNested) {
            // ignore
          }
        }
      }
    } catch (_eBin) {
      // ignore
    }
    // #endif
  }

  private bindSessionHandlers(expectedGeneration: number): void {
    const socketTask = this.socketTask;
    if (socketTask == null) {
      return;
    }
    this.installSocketRouter(socketTask!);
    this.preferArrayBufferBinaryType(socketTask!);
    this.socketMessageSink = (res: OnSocketMessageCallbackResult): void => {
      if (expectedGeneration != this.generation) {
        return;
      }
      this.handleSocketMessage(res);
    };
    socketTask!.onError((err: GeneralCallbackResult) => {
      if (expectedGeneration != this.generation || this.socketTask == null) {
        return;
      }
      let errMsg = "TTS WebSocket 错误";
      if (err.errMsg != null && err.errMsg.length > 0) {
        errMsg = err.errMsg;
      }
      this.fail(errMsg);
    });
    socketTask!.onClose((_res: OnSocketCloseCallbackResult) => {
      if (this.socketTask == null) {
        return;
      }
      // 已在播 / 暂停：只清 socket，继续本地音频；绝不触碰 chat SSE
      if (
        expectedGeneration == this.generation &&
        this.state != "playing" &&
        this.state != "paused" &&
        this.state != "idle"
      ) {
        this.fail("TTS 连接已关闭");
      } else {
        this.socketTask = null;
        this.stopKeepalive();
      }
    });
  }

  private ensureWarmSocketAsync(): void {
    if (this.warmupEnabled != true) {
      return;
    }
    this.cancelIdleClose();
    // 会话进行中禁止新建预热：会抢 router / 误清 sink，导致 tts_ready 后收不到 PCM
    if (this.socketTask != null) {
      return;
    }
    if (this.warmOpen == true && this.warmSocketTask != null) {
      return;
    }
    if (this.warmSocketTask != null) {
      // connecting：防重连风暴
      return;
    }
    const accessToken = resolveSpeechAccessToken();
    if (accessToken.length == 0) {
      console.warn("[TTS] warmup skip: no token");
      return;
    }
    this.warmGeneration += 1;
    const expectedWarm = this.warmGeneration;
    const socketTask = createTtsSocket(accessToken, (errMsg: string) => {
      console.warn("[TTS] warmup fail (no auto-retry)", errMsg);
      if (expectedWarm == this.warmGeneration) {
        this.warmSocketTask = null;
        this.warmOpen = false;
        this.notifyWarmOpenWaiters(false);
      }
    });
    if (socketTask == null) {
      return;
    }
    this.warmSocketTask = socketTask;
    this.warmOpen = false;
    this.warmOpenedAtMs = 0;
    this.installSocketRouter(socketTask);
    this.preferArrayBufferBinaryType(socketTask);
    // 待命期：仅当当前没有会话 sink 时才清空，绝不能打断正在合成的会话
    if (this.socketTask == null) {
      this.socketMessageSink = null;
    }
    socketTask.onOpen((_openRes: OnSocketOpenCallbackResult) => {
      if (expectedWarm != this.warmGeneration) {
        return;
      }
      this.warmOpen = true;
      this.warmOpenedAtMs = Date.now();
      this.preferArrayBufferBinaryType(socketTask);
      this.refreshKeepalive();
      this.notifyWarmOpenWaiters(true);
      // 预热后若长时间无合成，按闲置策略关闭
      this.scheduleIdleClose(this.IDLE_CLOSE_MS);
    });
    socketTask.onError((_err: GeneralCallbackResult) => {
      if (expectedWarm != this.warmGeneration) {
        return;
      }
      // 不主动 close：等 onClose 清状态
      console.warn("[TTS] warmup error (wait peer close)");
      this.notifyWarmOpenWaiters(false);
    });
    socketTask.onClose((_res: OnSocketCloseCallbackResult) => {
      if (expectedWarm != this.warmGeneration) {
        return;
      }
      this.warmSocketTask = null;
      this.warmOpen = false;
      this.warmOpenedAtMs = 0;
      if (this.socketRouterInstalledFor == socketTask && this.socketTask == null) {
        this.socketRouterInstalledFor = null;
        this.socketMessageSink = null;
      }
      this.refreshKeepalive();
      this.notifyWarmOpenWaiters(false);
      // 用完即关：对端关闭后不再自动重连，等下次按录音预热或合成时再建
    });
  }

  /**
   * 仅离开会话页时关预热连接。
   */
  private closeWarmSocket(): void {
    this.warmGeneration += 1;
    const sock = this.warmSocketTask;
    this.warmSocketTask = null;
    this.warmOpen = false;
    this.warmOpenedAtMs = 0;
    this.notifyWarmOpenWaiters(false);
    if (sock != null) {
      // 勿清会话 sink：预热与会话可能先后共用 router 标记
      if (this.socketRouterInstalledFor == sock && this.socketTask == null) {
        this.socketRouterInstalledFor = null;
        this.socketMessageSink = null;
      } else if (this.socketRouterInstalledFor == sock) {
        this.socketRouterInstalledFor = null;
      }
      try {
        sock!.close({} as CloseSocketOptions);
      } catch (_e) {
        // ignore
      }
    }
    this.refreshKeepalive();
  }

  /**
   * 仅离开会话页时关会话连接。
   * 业务 fail/stall/stop 禁止调用——应走 recycleSessionToWarm。
   */
  private closeSessionSocketOnly(): void {
    const socket = this.socketTask;
    this.socketTask = null;
    if (socket != null) {
      if (this.socketRouterInstalledFor == socket) {
        this.socketRouterInstalledFor = null;
        this.socketMessageSink = null;
      }
      try {
        socket!.close({} as CloseSocketOptions);
      } catch (_eSocket) {
        // ignore
      }
    }
    this.refreshKeepalive();
  }

  /**
   * 本轮合成/播报间隙：不立刻关 TCP，收回预热池供下一分句复用；
   * 并启动闲置关闭计时（下一句合成会 cancel）。
   */
  private recycleSessionToWarm(): void {
    const sock = this.socketTask;
    this.socketTask = null;
    this.socketMessageSink = null;
    if (sock == null) {
      this.refreshKeepalive();
      this.scheduleIdleClose(this.IDLE_CLOSE_MS);
      return;
    }
    // 已有待命：保留当前会话 sock 作为 warm（不主动 close 任一端）
    if (this.warmSocketTask != null && this.warmSocketTask != sock) {
      console.warn(
        "[TTS] dual socket on recycle; keep session TCP as warm (no close)",
      );
    }
    this.warmGeneration += 1;
    const expectedWarm = this.warmGeneration;
    this.warmSocketTask = sock;
    this.warmOpen = true;
    this.warmOpenedAtMs = Date.now();
    this.installSocketRouter(sock!);
    this.socketMessageSink = null;
    sock!.onError((_err: GeneralCallbackResult) => {
      if (expectedWarm != this.warmGeneration) {
        return;
      }
      console.warn("[TTS] warm error after recycle (wait peer close)");
    });
    sock!.onClose((_res: OnSocketCloseCallbackResult) => {
      if (expectedWarm != this.warmGeneration) {
        return;
      }
      this.warmSocketTask = null;
      this.warmOpen = false;
      this.warmOpenedAtMs = 0;
      if (this.socketRouterInstalledFor == sock && this.socketTask == null) {
        this.socketRouterInstalledFor = null;
        this.socketMessageSink = null;
      }
      this.refreshKeepalive();
      // 不再自动重连
    });
    this.refreshKeepalive();
    this.scheduleIdleClose(this.IDLE_CLOSE_MS);
  }

  /**
   * 结束当前播报会话；TCP 收回待命并进入闲置关闭倒计时。
   * @param keepAudio true：仅 stop、保留 InnerAudioContext（H5 串行分句复用已解锁通道）
   */
  /**
   * H5：停止共享 InnerAudioContext。解锁播放刚启动（<UNLOCK_PLAY_GRACE_MS）时跳过 stop，
   * 让解锁片段自然播完——避免打断 pending play() 抛 AbortError，并确保 iOS 判定元素
   * “真正播放过”从而放行后续异步 play()。非 H5 平台行为与直接 stop() 一致。
   */
  private stopSharedAudio(): void {
    const audio = this.audioContext;
    if (audio == null) {
      return;
    }
    // #ifdef H5 || WEB
    if (this.unlockPlayAtMs > 0 && Date.now() - this.unlockPlayAtMs < UNLOCK_PLAY_GRACE_MS) {
      return;
    }
    // #endif
    try {
      audio!.stop();
    } catch (_eStop) {
      // ignore
    }
  }

  private prepareForNextUtterance(keepAudio: boolean): void {
    this.generation += 1;
    this.synthEpoch += 1;
    this.synthInFlight = false;
    this.clearSynthStallWatchdog();
    this.finishRequested = false;
    this.pendingBinary = 0;
    this.realPlayback = false;
    this.switchingToReal = false;
    this.pausedByMute = false;
    this.recycleSessionToWarm();
    if (keepAudio == true) {
      this.stopSharedAudio();
    } else {
      // H5/WEB：保留已解锁的 InnerAudioContext（手势内解锁过即持续放行），
      // 仅 stop 当前音频，不销毁。若在此 destroy，下一次播放会重建一个未被手势解锁的
      // 新元素，被移动端浏览器拦截（NotAllowedError，iOS 最严）。
      // 销毁推迟到 disableWarmupAndDisconnect（离开页面 / 停会话）。
      this.stopSharedAudio();
      // #ifndef H5 || WEB
      const audio = this.audioContext;
      this.audioContext = null;
      if (audio != null) {
        try {
          audio!.destroy();
        } catch (_eAudio) {
          // ignore
        }
      }
      // #endif
    }
    this.revokeBlobUrl();
    this.chunks = [] as Uint8Array[];
    this.text = "";
    // 先带原 messageId 通知 idle，工具栏才能按消息匹配退出播报态
    this.setState("idle");
    this.messageId = "";
  }

  stop(): void {
    this.prepareForNextUtterance(false);
    // 显式停止：立刻释放连接，不保留空闲长连
    this.releaseIdleConnection();
  }

  private revokeBlobUrl(): void {
    // #ifdef H5 || WEB
    if (this.blobUrl.length > 0) {
      try {
        URL.revokeObjectURL(this.blobUrl);
      } catch (_eRevoke) {
        // ignore
      }
      this.blobUrl = "";
    }
    // #endif
  }

  /**
   * 用户手势同步阶段创建 InnerAudioContext，并播放一段静音 WAV 解锁媒体通道。
   * 用 SILENT_WAV_DATA_URI（0.05s 全零静音，无任何可闻声音），并记下 unlockPlayAtMs
   * 宽限期，保证它不被同一同步栈内的 stop() 打断。
   */
  private prepareAudioContextForGesture(): void {
    const audio = uni.createInnerAudioContext();
    this.audioContext = audio;
    audio.volume = this.getTargetVolume();
    // #ifdef APP-IOS
    audio.obeyMuteSwitch = false;
    // #endif
    // #ifdef H5 || WEB
    try {
      // 静音 WAV 本身无声，音量置最低兜底
      audio.volume = this.getTargetVolume() > 0 ? 0.01 : 0;
      audio.src = SILENT_WAV_DATA_URI;
      this.unlockPlayAtMs = Date.now();
      this.safePlay(audio);
    } catch (e: any) {
      console.error("[H5Voice] audioUnlockFailed", e);
    }
    // #endif
  }

  /**
   * H5：在用户手势调用栈内同步解锁音频通道（工具栏播报点击时调用）。
   * 浏览器要求 play() 落在手势栈内；TTS 合成是异步的（WebSocket 往返后才播放），
   * 若等到合成完成才首次 play()，会被移动端浏览器拦截（NotAllowedError，iOS 最严）。
   * 这里在点击同步阶段用同一 InnerAudioContext 播一段静音 WAV 解锁（unlockPlayAtMs
   * 宽限期保证它不被随后的 stop() 打断），后续异步播放复用已解锁实例即被放行。
   * 仅首次创建并解锁；重复调用为幂等。App / 小程序无需手势解锁，本方法为 no-op。
   */
  unlockInGesture(): void {
    // #ifdef H5 || WEB
    if (this.audioContext == null) {
      this.prepareAudioContextForGesture();
    }
    // #endif
  }

  private sendJson(data: UTSJSONObject): void {
    const socket = this.socketTask;
    if (socket == null) {
      console.warn("[TTS] sendJson skip: no socket");
      return;
    }
    const payload = JSON.stringify(data);
    const typeVal = data["type"];
    const type = typeVal != null ? `${typeVal}` : "";
    try {
      socket!.send({ data: payload } as SendSocketMessageOptions);
    } catch (e: any) {
      console.error("[TTS] send throw type=", type, e);
      this.fail("TTS 发送失败");
    }
  }

  private handleSocketMessage(res: OnSocketMessageCallbackResult): void {
    if (typeof res.data != "string") {
      const sync = tryAsArrayBufferSync(res.data);
      this.appendBinaryChunk(res.data);
      return;
    }

    let message: UTSJSONObject | null = null;
    try {
      message = JSON.parse<UTSJSONObject>(res.data as string);
    } catch (_eJson) {
      this.fail("TTS 返回了无效消息");
      return;
    }
    if (message == null) {
      return;
    }
    const typeVal = message!["type"];
    const type = typeVal != null ? `${typeVal}` : "";
    if (type == "ping" || type == "pong") {
      return;
    }
    if (type == "tts_ready") {
      this.setState("synthesizing");
      // 冒烟协议：单帧 text + flush:true
      this.sendJson(buildTtsControlMessage("text", this.text, 0, true));
      this.armSynthStallWatchdog();
    } else if (type == "tts_begin") {
      this.setState("synthesizing");
    } else if (type == "tts_end") {
      this.clearSynthStallWatchdog();
      this.finishRequested = true;
      this.tryFinishSynthesis();
    } else if (type == "error") {
      const codeVal = message!["code"];
      const messageVal = message!["message"];
      const code = codeVal != null ? `${codeVal}` : "";
      const msg = messageVal != null ? `${messageVal}` : "TTS 合成失败";
      // 服务端不支持应用层 ping：停心跳，不断连 / 不中断合成
      if (
        code == "UNKNOWN_TYPE" &&
        (msg.indexOf("ping") >= 0 || msg.indexOf("pong") >= 0)
      ) {
        this.keepalive.markRejectedByServer();
        return;
      }
      this.clearSynthStallWatchdog();
      this.fail(msg);
    } else if (type.length > 0) {
      console.warn("[TTS] unknown ctrl type=", type);
    }
  }

  /** 合成卡住检测：tts_ready 后若长时间无 PCM/tts_end，打诊断并失败 */
  private armSynthStallWatchdog(): void {
    this.clearSynthStallWatchdog();
    const expectedGeneration = this.generation;
    this.synthStallTimerId = setTimeout(() => {
      this.synthStallTimerId = 0;
      if (expectedGeneration != this.generation) {
        return;
      }
      if (this.state != "synthesizing" && this.state != "connecting") {
        return;
      }
      console.warn(
        "[TTS] synth stall: server produced no audio (no tts_begin/pcm/tts_end)",
        "state=",
        this.state,
        "chunks=",
        this.chunks.length,
        "pendingBinary=",
        this.pendingBinary,
        "textLen=",
        this.text.length,
      );
      // 文档：flush 后若无音频产出，服务端不发 tts_begin/tts_end
      this.fail("TTS 服务未返回音频，请检查后端 speech.tts 配置");
    }, 12000);
  }

  private clearSynthStallWatchdog(): void {
    if (this.synthStallTimerId > 0) {
      clearTimeout(this.synthStallTimerId);
      this.synthStallTimerId = 0;
    }
  }

  private appendBinaryChunk(data: any): void {
    const expectedGeneration = this.generation;
    // 同步路径：ArrayBuffer / TypedArray，避免 Promise.then 在 UTS 丢失
    const syncBuffer = tryAsArrayBufferSync(data);
    if (syncBuffer != null) {
      if (expectedGeneration != this.generation) {
        return;
      }
      if (syncBuffer!.byteLength > 0) {
        this.chunks.push(new Uint8Array(syncBuffer!));
        this.clearSynthStallWatchdog();
      } else {
        console.warn("[TTS] skip empty binary frame");
      }
      this.tryFinishSynthesis();
      return;
    }

    this.pendingBinary += 1;
    toArrayBufferAsync(data).then((buffer: ArrayBuffer | null): void => {
      // 无论 generation 是否变化都要减计数，否则 pendingBinary 卡死无法 finish
      this.pendingBinary -= 1;
      if (this.pendingBinary < 0) {
        this.pendingBinary = 0;
      }
      if (expectedGeneration != this.generation) {
        this.tryFinishSynthesis();
        return;
      }
      if (buffer != null && buffer!.byteLength > 0) {
        this.chunks.push(new Uint8Array(buffer!));
        this.clearSynthStallWatchdog();
      } else {
        console.warn("[TTS] skip empty/unrecognized binary frame");
      }
      this.tryFinishSynthesis();
    });
  }

  private tryFinishSynthesis(): void {
    if (!this.finishRequested || this.pendingBinary > 0) {
      return;
    }
    this.finishRequested = false;
    this.finishSynthesis();
  }

  private async finishSynthesis(): Promise<void> {
    const expectedGeneration = this.generation;
    if (this.chunks.length == 0) {
      this.fail("TTS 未返回音频");
      return;
    }
    try {
      let pcmBytes = 0;
      for (let i = 0; i < this.chunks.length; i++) {
        pcmBytes += this.chunks[i].length;
      }
      const wav = buildPcm16Wav(this.chunks, this.sampleRate);
      const src = await saveWavFile(wav);
      if (expectedGeneration != this.generation) {
        return;
      }
      // #ifdef H5 || WEB
      this.revokeBlobUrl();
      this.blobUrl = src;
      // #endif
      const socket = this.socketTask;
      if (socket != null) {
        // 合成完收回 TCP 待命，播放期复用；闲置超时后关闭
        this.recycleSessionToWarm();
      }

      // H5/WEB 与 App 起播路径互斥：
      // Web 跑在 /m/ 时平台宏常是 WEB 而非 H5；旧逻辑 #ifndef H5 会立刻 play，
      // 同时 onCanplay 再 play → 1ms 内双重起播、听感断续。
      // playRequestId 挡住叠加的旧 onCanplay（InnerAudioContext 无法移除监听）。
      let audio = this.audioContext;
      if (audio == null) {
        audio = uni.createInnerAudioContext();
        this.audioContext = audio;
        // #ifdef APP-IOS
        audio.obeyMuteSwitch = false;
        // #endif
      }
      // 换源前 stop，降低 H5 上旧 src 与新 play 打架的概率
      try {
        audio!.stop();
      } catch (eStop: any) {}
      audio!.volume = this.getTargetVolume();
      // #ifdef APP-IOS
      audio!.obeyMuteSwitch = false;
      // #endif

      this.playRequestId = this.playRequestId + 1;
      const reqId = this.playRequestId;
      let playStarted = false;
      const startPlay = (): void => {
        if (expectedGeneration != this.generation) {
          return;
        }
        if (reqId != this.playRequestId) {
          return;
        }
        if (playStarted) {
          return;
        }
        playStarted = true;
        this.switchingToReal = true;
        try {
          audio!.play();
        } catch (ePlay: any) {
          console.warn("[TTS] audio.play threw", ePlay);
          playStarted = false;
        }
      };

      audio!.onPlay(() => {
        if (expectedGeneration != this.generation) {
          return;
        }
        if (reqId != this.playRequestId) {
          return;
        }
        // 解锁静音片段的 onPlay 忽略；真实音频才切状态
        if (this.switchingToReal || this.realPlayback) {
          this.switchingToReal = false;
          this.realPlayback = true;
          this.setState("playing");
        }
      });
      audio!.onEnded(() => {
        if (reqId != this.playRequestId) {
          return;
        }
        // 忽略 H5 解锁静音片段结束；真实播报结束：idle 但保留 audio，供下一句复用
        if (
          expectedGeneration == this.generation &&
          this.realPlayback
        ) {
          this.prepareForNextUtterance(true);
          // 预热已在 finishSynthesis 收回，此处不再 ensureWarm / connectSocket
        }
      });
      audio!.onError((err) => {
        if (expectedGeneration != this.generation) {
          return;
        }
        if (reqId != this.playRequestId) {
          return;
        }
        // 切换 src 时常见 abort，尚未真正起播则忽略
        if (this.switchingToReal && this.realPlayback != true) {
          console.warn(
            "[TTS] audio transient error while switching",
            err.errMsg ?? err,
          );
          return;
        }
        if (this.realPlayback) {
          this.fail(err.errMsg ?? "TTS 音频播放失败");
        }
      });

      // #ifdef H5 || WEB
      audio!.onCanplay(() => {
        startPlay();
      });
      audio!.src = src;
      // canplay 偶发不来时兜底；已起播则 startPlay 直接 return
      setTimeout(() => {
        startPlay();
      }, 80);
      // #endif

      // #ifndef H5
      // #ifndef WEB
      // App：onCanplay 常不触发，主动 play
      audio!.src = src;
      startPlay();
      // #endif
      // #endif
    } catch (e: any) {
      this.fail(e.message ?? "TTS 音频处理失败");
    }
  }

  private fail(message: string): void {
    console.error("[TTS] " + message);
    this.clearSynthStallWatchdog();
    // 保留 messageId 直到 idle 通知结束，便于工具栏按消息匹配并退出播报态
    this.setState("error");
    // 流式多句连续 stall 时只弹一次，避免连环 toast
    const now = Date.now();
    if (now - this.lastFailToastAtMs > 8000) {
      this.lastFailToastAtMs = now;
      uni.showToast({ title: message, icon: "none" });
    }
    // 出错即断（即开即用、用完即断）：不留 warm / 长连，避免半开连接残留导致后续 no_speech / asr_error
    this.cancelIdleClose();
    this.closeWarmSocket();
    this.closeSessionSocketOnly();
    this.stopKeepalive();
    this.chunks = [] as Uint8Array[];
    this.text = "";
    this.finishRequested = false;
    this.pendingBinary = 0;
    this.realPlayback = false;
    this.switchingToReal = false;
    // 仍带原 messageId 通知 idle，避免监听方因 id 已空而跳过复位
    this.setState("idle");
    this.messageId = "";
  }

  /**
   * 强制通知 idle（即使当前已是 idle）。
   * 流式整轮结束后 TTS 往往已 idle 不会再发事件，工具栏需靠这次回调复位。
   */
  notifyUiIdle(): void {
    this.setState("idle");
  }

  private setState(state: TtsPlaybackState): void {
    this.state = state;
    const messageId = this.messageId;
    for (let i = 0; i < this.listeners.length; i++) {
      this.listeners[i].callback(state, messageId);
    }
  }
}

export const ttsWebSocketPlayer = new TtsWebSocketPlayer();

/**
 * 单句合成：优先复用预热 TTS WebSocket，收齐 PCM 后封装为可播放 src（不播报）。
 * @param preservePlayingAudio true 时不打断当前音频（流式边播边合成）
 */
export async function synthesizeSpeechToSrc(
  text: string,
  preservePlayingAudio: boolean = false,
): Promise<string> {
  return await ttsWebSocketPlayer.synthesizeToSrc(text, preservePlayingAudio);
}
