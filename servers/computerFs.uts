import request from "./useRequest";
import { RequestResponse } from "@/types/interfaces/request";

/** 电脑文件系统浏览（对齐 PC 实际网关路由 /api/computer/static/fs/*）：工作目录选择用。 */

/** 列出电脑根目录（盘符；回包含用户主目录快捷入口 home）。 */
export async function apiComputerFsRoots(sandboxId: string): Promise<RequestResponse<any>> {
  const parts = [] as string[];
  parts.push(`sandboxId=${encodeURIComponent(sandboxId)}`);
  return await request({
    url: `/api/computer/static/fs/roots?${parts.join("&")}`,
    method: "GET",
  });
}

/** 列出指定绝对路径下的一层子项（子项绝对路径由服务端直接回传）。 */
export async function apiComputerFsChildren(path: string, sandboxId: string): Promise<RequestResponse<any>> {
  const parts = [] as string[];
  parts.push(`path=${encodeURIComponent(path)}`);
  parts.push(`sandboxId=${encodeURIComponent(sandboxId)}`);
  return await request({
    url: `/api/computer/static/fs/children?${parts.join("&")}`,
    method: "GET",
  });
}
