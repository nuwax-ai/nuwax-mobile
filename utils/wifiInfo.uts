/**
 * 获取手机当前连接的 WiFi SSID（三端封装）
 *
 * ⚠️ M2 里程碑实现各端真实获取；当前统一返回 ""（拿不到），
 * 由 WiFi 页兜底为「手动输入」，绝不阻塞配网流程。
 *
 * 各端实现要点（详见方案 §6）：
 *  - Android/iOS：uni.getConnectedWifi（uni-wifi 插件）+ 定位权限；iOS 需 Access WiFi Information entitlement
 *  - 鸿蒙：@kit.NetworkKit 的 wifiManager.getLinkedInfo()（GET_WIFI_INFO 权限）
 *  - 返回 SSID 可能带引号需 trim('"')；Android10+ 可能返回 <unknown ssid>
 */

/** 去除 SSID 首尾引号与 <unknown ssid> 兜底 */
function normalizeSsid(raw: string): string {
  let s = raw;
  if (s.startsWith('"') && s.endsWith('"') && s.length >= 2) {
    s = s.substring(1, s.length - 1);
  }
  if (s == '<unknown ssid>') return '';
  return s;
}

/**
 * 获取当前 WiFi SSID；拿不到返回 ""（由页面兜底手动输入）。
 */
export function getCurrentWifiSsid(): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
    // M2/M3：接入 uni.getConnectedWifi / 鸿蒙 wifiManager，再 normalizeSsid
    resolve('');
    return;
    // #endif
    // #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
    resolve('');
    // #endif
  });
}
