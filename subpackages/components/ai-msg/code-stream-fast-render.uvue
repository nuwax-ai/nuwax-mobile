<template>
  <CodeStreamFrozenRender :segments="frozenSegments" />
  <text
    v-if="liveKind == CODE_STREAM_SEGMENT_PROSE && liveText.length > 0"
    class="code-stream-live-prose"
  >{{ liveText }}</text>
  <view
    v-else-if="liveKind == CODE_STREAM_SEGMENT_CODE"
    class="code-stream-live-code"
  >
    <view class="code-stream-code-header">
      <text class="code-stream-code-language">{{ liveLanguage }}</text>
    </view>
    <text class="code-stream-code-text">{{ liveText }}</text>
  </view>
</template>

<script lang="uts" setup>
  import CodeStreamFrozenRender from "@/subpackages/components/ai-msg/code-stream-frozen-render.uvue";
  import {
    CodeStreamSegment,
    CODE_STREAM_SEGMENT_PROSE,
    CODE_STREAM_SEGMENT_CODE,
    parseCodeStreamSegments,
  } from "@/subpackages/components/ai-msg/codeStreamDisplay.uts";

  const props = withDefaults(
    defineProps<{
      initialText?: string;
    }>(),
    {
      initialText: "",
    },
  );

  const emit = defineEmits<{
    caughtUp: [];
  }>();

  const frozenSegments = ref<CodeStreamSegment[]>([] as CodeStreamSegment[]);
  const liveKind = ref<string>(CODE_STREAM_SEGMENT_PROSE);
  const liveText = ref<string>("");
  const liveLanguage = ref<string>("text");
  let displayText = "";

  function updateText(text: string): void {
    const appendOnly =
      text.length >= displayText.length && text.startsWith(displayText);
    if (appendOnly != true) {
      frozenSegments.value = [] as CodeStreamSegment[];
    }
    displayText = text;
    const segments = parseCodeStreamSegments(text);
    const frozenCount = segments.length > 0 ? segments.length - 1 : 0;
    if (frozenCount < frozenSegments.value.length) {
      frozenSegments.value = [] as CodeStreamSegment[];
    }
    // SSE 正常只追加。已经冻结的段不重建数组，让 VDOM 只挂载新闭合段。
    for (let i = frozenSegments.value.length; i < frozenCount; i++) {
      frozenSegments.value.push(segments[i]);
    }

    if (segments.length == 0) {
      liveKind.value = CODE_STREAM_SEGMENT_PROSE;
      liveText.value = "";
      liveLanguage.value = "text";
    } else {
      const live = segments[segments.length - 1];
      liveKind.value = live.kind;
      liveText.value = live.text;
      liveLanguage.value = live.language;
    }
    emit("caughtUp");
  }

  function isCaughtUp(): boolean {
    return displayText == props.initialText || displayText.length > 0;
  }

  watch(
    (): string => props.initialText,
    (text: string) => updateText(text),
    { immediate: true },
  );

  defineExpose({ updateText, isCaughtUp });
</script>

<style lang="scss">
  .code-stream-live-prose {
    width: 100%;
    color: #404040;
    font-size: 32rpx;
    line-height: 48rpx;
    white-space: pre-wrap;
  }

  .code-stream-live-code {
    width: 100%;
    margin-bottom: 5px;
    overflow: hidden;
    background-color: var(--bg-secondary);
    border-radius: 6px;
    border: 1px solid var(--border-color);
  }

  .code-stream-code-header {
    width: 100%;
    padding: 4px 10px;
    background-color: var(--bg-tertiary);
  }

  .code-stream-code-language {
    color: var(--text-secondary);
    font-size: 12px;
  }

  .code-stream-code-text {
    width: 100%;
    padding: 8px 10px;
    color: var(--text-primary);
    font-family: monospace;
    font-size: 14px;
    line-height: 22px;
    white-space: pre;
  }
</style>
