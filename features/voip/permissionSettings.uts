export type VoipPermissionStep = { id: string, title: string, description: string, ready: boolean | null };

// #ifdef APP-ANDROID
import { getVoipPresentationStatus } from "@/uni_modules/nuwax-voip";
import { readBackgroundRestricted } from "@/utils/push/pushBackgroundStatus";

export function readAndroidCallPresentation(): UTSJSONObject | null {
  try {
    const status = JSON.parse<UTSJSONObject>(getVoipPresentationStatus());
    return status != null && status["supported"] === true ? status : null;
  } catch (_e) {
    return null;
  }
}

export function androidCallFlag(status: UTSJSONObject | null, key: string): boolean | null {
  const value = status == null ? null : status[key];
  if (value === true) return true;
  if (value === false) return false;
  return null;
}

export function androidCallAlertSteps(status: UTSJSONObject | null): VoipPermissionStep[] {
  const channelExists = status != null && parseFloat(`${status["channelImportance"] ?? -1}`) >= 0;
  const channelSound = androidCallFlag(status, "channelSoundEnabled");
  const channelEnabled = androidCallFlag(status, "channelEnabled");
  let channelReady: boolean | null = null;
  if (channelExists && (channelEnabled == false || channelSound == false)) channelReady = false;
  else if (channelExists && channelEnabled == true && channelSound == true) channelReady = true;
  const steps: VoipPermissionStep[] = [
    { id: "notifications", title: "Mobile.Profile.systemNotificationPermission", description: "Mobile.Voip.setupNotifications", ready: androidCallFlag(status, "notificationsAllowed") },
    { id: "channel", title: "Mobile.Voip.notificationIncoming", description: channelExists && channelSound == false ? "Mobile.Voip.setupChannelMuted" : "Mobile.Voip.setupChannel", ready: channelReady },
    { id: "overlay", title: "Mobile.Voip.setupOverlayTitle", description: "Mobile.Voip.setupOverlay", ready: androidCallFlag(status, "overlayAllowed") },
  ];
  if (androidCallFlag(status, "fullScreenPermissionChecked") == true) {
    steps.push({ id: "fullScreen", title: "Mobile.Voip.setupFullScreenTitle", description: "Mobile.Voip.setupFullScreen", ready: androidCallFlag(status, "fullScreenAllowed") });
  }
  if (androidCallFlag(status, "presentedChannelExists") == true) {
    steps.push({ id: "presentedChannel", title: "Mobile.Voip.setupPresentedTitle", description: "Mobile.Voip.setupPresented", ready: androidCallFlag(status, "presentedChannelAudible") });
  }
  const restriction = readBackgroundRestricted();
  if (restriction.supported && restriction.restricted != null) {
    steps.push({ id: "background", title: "Mobile.Voip.setupBackgroundTitle", description: "Mobile.Voip.setupBackground", ready: restriction.restricted == false });
  }
  return steps;
}
// #endif
