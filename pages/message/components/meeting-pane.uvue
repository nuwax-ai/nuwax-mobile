<template>
  <!--
    伙伴页「会议」tab（第 2 页，夹在消息与智联录之间）。

    ★★自己管数据，页面零接线：会议是独立业务面（servers/imMeeting.uts 的注释同理），
    塞进 message-content 的 4500 行会造成两处不必要的耦合，也白白逼近 uvue 渲染
    lambda 的参数上限（chat.uvue 255 硬限的教训）。页面只传 active。

    ★本期是**纯 REST** 范围：三个入口（发起 / 加入 / 预约）+ 会议列表（预约中 /
    进行中 / 历史）。真正的入会音视频要 LiveKit 客户端（Android/iOS 有官方 SDK，
    鸿蒙没有），属于媒体层后续分期——所以「开始 / 入会」先进 `im-meeting-room`
    会议信息页（占位），不伪造一个进不去的会中界面。

    ★列表口径 = 「我参与过」（服务端按参会人判定），不是「我主持的」；
    预约（status=0）与会议记录是同一条 im_meeting，多端登录看到的是同一份。
  -->
  <view class="mt-root">
    <scroll-view
      class="mt-scroll"
      direction="vertical"
      :show-scrollbar="false"
      lower-threshold="80"
      @scrolltolower="handleLoadMore"
    >
      <!-- 三入口：发起 / 加入 / 预约（对齐 PC MeetingPane 顶部平铺操作） -->
      <view class="mt-actions">
        <view class="mt-action" hover-class="mt-action--active" @click="handleEntry('create')">
          <view class="mt-action__icon mt-action__icon--create">
            <!-- 统一 22x22 字形盒：字形（text）与图片（image）走同一套居中，
                 文字类图标额外把 line-height 钉成盒高，消掉字体行高造成的上下偏。
                 字体图标墨迹在字身框内偏左，故文字类两枚各做水平补正（发起 2px、
                 预约 3px）；image 类（加入会议）墨迹本身就居中，不加 -->
            <view class="mt-action__glyph mt-action__glyph--nudge">
              <svg-icon name="icon-VideoCamera" size="22" unit="px" color="#5147ff" />
            </view>
          </view>
          <text class="mt-action__label">{{ t("Mobile.Meeting.create") }}</text>
        </view>
        <view class="mt-action" hover-class="mt-action--active" @click="handleEntry('join')">
          <view class="mt-action__icon mt-action__icon--join">
            <!-- 复用智联录「新的伙伴」入口的线性图标（同一份 svg，不另画），语义=人 + 加入 -->
            <view class="mt-action__glyph">
              <image class="mt-action__img" :src="iconJoinMeeting" mode="aspectFit" />
            </view>
          </view>
          <text class="mt-action__label">{{ t("Mobile.Meeting.join") }}</text>
        </view>
        <view class="mt-action" hover-class="mt-action--active" @click="handleEntry('schedule')">
          <view class="mt-action__icon mt-action__icon--schedule">
            <view class="mt-action__glyph mt-action__glyph--nudge-more">
              <svg-icon name="icon-Clock" size="22" unit="px" color="#e08a1e" />
            </view>
          </view>
          <text class="mt-action__label">{{ t("Mobile.Meeting.schedule") }}</text>
        </view>
      </view>

      <!-- 我的预约（逐项对齐 PC `MeetingPane.tsx` 的 meeting-schedule 卡片）：
           正文三行 = 标题 /「时间 · N 人」/「会议号 xxx」，状态 Tag 在标题右侧；
           操作顺序与 PC 一致 = 开始 · 复制 · 邀请 ·（非主持）提前进入 ·
           （主持）设置 ·（主持）删除（垃圾桶图标，PC 同款）。
           PC 没有的「我主持 / 允许游客 / 需密码」小标签已去掉。 -->
      <view v-if="scheduledRows.length > 0" class="mt-section">
        <text class="mt-section__title mt-section__title--muted">{{ t("Mobile.Meeting.scheduledSection") }}</text>
        <view v-for="row in scheduledView" :key="row.id" class="mt-card">
          <view class="mt-card__body">
            <view class="mt-card__head">
              <text class="mt-card__title" :lines="1">{{ row.title }}</text>
              <view :class="row.tagClass">
                <text :class="row.tagTextClass">{{ row.statusText }}</text>
              </view>
            </view>
            <text class="mt-card__meta" :lines="1">{{ row.scheduleMeta }}</text>
            <view class="mt-card__norow">
              <text class="mt-card__nolabel">{{ t("Mobile.Meeting.roomNoLabel") }}</text>
              <text class="mt-card__no" :lines="1">{{ row.roomLabel.length > 0 ? row.roomLabel : "—" }}</text>
            </view>
          </view>
          <view class="mt-card__acts">
            <view class="mt-btn mt-btn--primary" hover-class="mt-btn--primary-active" @click="handleStartRow(row)">
              <text class="mt-btn__text mt-btn__text--primary">{{ t("Mobile.Meeting.start") }}</text>
            </view>
            <view class="mt-btn" hover-class="mt-btn--active" @click="handleCopyNo(row)">
              <text class="mt-btn__text">{{ t("Mobile.Meeting.copyNoShort") }}</text>
            </view>
            <view class="mt-btn" hover-class="mt-btn--active" @click="handleCopyInvite(row)">
              <text class="mt-btn__text">{{ t("Mobile.Meeting.invite") }}</text>
            </view>
            <view
              v-if="!row.host"
              class="mt-btn"
              :class="{ 'mt-btn--off': !row.allowEarlyJoin }"
              hover-class="mt-btn--active"
              @click="handleEarlyJoin(row)"
            >
              <text class="mt-btn__text">{{ t("Mobile.Meeting.earlyJoinEnter") }}</text>
            </view>
            <view v-if="row.host" class="mt-btn" hover-class="mt-btn--active" @click="openPolicy(row)">
              <text class="mt-btn__text">{{ t("Mobile.Meeting.joinPolicy") }}</text>
            </view>
            <!-- 删除（对齐 PC：这里是图标按钮，不是「取消预约」文字；点下去仍是取消这场预约的二次确认）
                 图标整体右移 2px：垃圾桶字形左侧留白比右侧多，居中看着偏左 -->
            <view v-if="row.host" class="mt-btn mt-btn--icon" hover-class="mt-btn--active" @click="handleCancelSchedule(row)">
              <view class="mt-trash">
                <svg-icon name="icon-a-trashcan" size="14" unit="px" color="#8f8f99" />
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 进行中的会议（逐项对齐 PC `MeetingPane.tsx` 的 is-live 卡片）：
           区块位于「我的预约」之下（PC 同序）；标题与「我的预约」同色，
           「可直接入会」紧跟标题之后（中间留一个空格，只作说明、不单独占一行）；
           正文三行 = 标题 /「开始时间 · 已进行 xx · N 人」/「会议号 xxx」，
           状态 Tag 在标题右侧；★动作只有「入会」一个（PC 没有复制邀请、也没有小标签）。 -->
      <view v-if="ongoingRows.length > 0" class="mt-section">
        <view class="mt-section__head">
          <view class="mt-section__lead">
            <text class="mt-section__title mt-section__title--muted">{{ t("Mobile.Meeting.ongoingSection") }}</text>
            <text class="mt-section__note">{{ t("Mobile.Meeting.ongoingNote") }}</text>
          </view>
        </view>
        <view v-for="row in ongoingView" :key="row.id" class="mt-card mt-card--live">
          <view class="mt-card__body">
            <view class="mt-card__head">
              <text class="mt-card__title" :lines="1">{{ row.title }}</text>
              <view :class="row.tagClass">
                <text :class="row.tagTextClass">{{ row.statusText }}</text>
              </view>
            </view>
            <text class="mt-card__meta" :lines="1">{{ row.liveMeta }}</text>
            <view class="mt-card__norow">
              <text class="mt-card__nolabel">{{ t("Mobile.Meeting.roomNoLabel") }}</text>
              <text class="mt-card__no" :lines="1">{{ row.roomLabel.length > 0 ? row.roomLabel : "—" }}</text>
            </view>
          </view>
          <view class="mt-card__acts">
            <view class="mt-btn mt-btn--primary" hover-class="mt-btn--primary-active" @click="handleEnterRow(row)">
              <text class="mt-btn__text mt-btn__text--primary">{{ t("Mobile.Meeting.enterRoom") }}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 历史记录（含已取消）：带刷新按钮 + 空/失败/加载态 -->
      <view class="mt-section">
        <view class="mt-section__head">
          <text class="mt-section__title mt-section__title--muted">{{ t("Mobile.Meeting.historySection") }}</text>
          <!-- 刷新：图标按钮（loading 期间淡出）。图标走独立 svg 资源：iconfont 的
               icon-restart 中间带一枚播放三角（语义是「重新开始」而非「刷新」），
               而 border + transform 手拼的箭头在各端舍入不一致、接不上弧线，
               改成在 svg 里把弧线端点与箭头底边画在同一条轴上，一次画准。 -->
          <view
            class="mt-section__refresh"
            :class="{ 'mt-section__refresh--busy': loading }"
            @click="handleRefresh"
          >
            <image class="mt-refresh" :src="iconRefresh" mode="aspectFit" />
          </view>
        </view>
        <view v-if="!loaded" class="mt-state">
          <text class="mt-state__text">{{ t("Mobile.Common.loading") }}</text>
        </view>
        <view v-else-if="failed" class="mt-state" @click="handleRefresh">
          <text class="mt-state__text">{{ t("Mobile.Meeting.loadFailed") }}</text>
        </view>
        <view v-else-if="historyRows.length == 0 && scheduledRows.length == 0 && ongoingRows.length == 0" class="mt-state">
          <text class="mt-state__text">{{ t("Mobile.Meeting.empty") }}</text>
        </view>
        <view v-else-if="historyRows.length == 0" class="mt-state">
          <text class="mt-state__text">{{ t("Mobile.Meeting.empty") }}</text>
        </view>
        <!-- ★渲染封顶：只用 historyView（<=RENDER_CAP 条），源数据 historyRows 可以更长 -->
        <view v-for="row in historyView" :key="row.id" class="mt-card">
          <view class="mt-card__body">
            <view class="mt-card__head">
              <text class="mt-card__title mt-card__title--muted" :lines="1">{{ row.title }}</text>
              <view :class="row.tagClass">
                <text :class="row.tagTextClass">{{ row.statusText }}</text>
              </view>
            </view>
            <!-- 历史行只保留「标题 + 状态 Tag」「时间 · 时长 · 人数」两行：
                 时间下面那行（会议号/我主持）信息密度低，用户明确要求去掉 -->
            <text class="mt-card__meta" :lines="1">{{ row.metaText }}</text>
          </view>
        </view>
        <!-- 分页尾：加载中 / 已到渲染上限 / 没有更多 -->
        <view v-if="loaded && historyRows.length > 0" class="mt-foot">
          <text class="mt-foot__text">{{ footText }}</text>
        </view>
      </view>

      <view class="mt-tail" />
    </scroll-view>

    <!-- 入会设置（仅主持人，对齐 PC `openPolicy` 弹窗）：提前进入 + 入会密码。
         ★语义（服务端）：joinPasscode 不传=不改密码，传空串=取消密码。
           所以「只改开关」时绝不能带密码字段，否则会把已有密码洗掉。 -->
    <uni-modal-popup
      ref="policyPopup"
      :title="t('Mobile.Meeting.joinPolicyTitle')"
      position="center"
      :enable-swipe-close="false"
    >
      <view class="mp">
        <view class="mp-field">
          <view class="mp-row">
            <text class="mp-label">{{ t("Mobile.Meeting.earlyJoinLabel") }}</text>
            <switch
              class="mp-switch"
              :checked="policyEarly"
              color="#5147ff"
              @change="handlePolicyEarlyChange"
            />
          </view>
          <text class="mp-hint">{{ policyEarly ? t("Mobile.Meeting.policyEarlyOn") : t("Mobile.Meeting.policyEarlyOff") }}</text>
        </view>

        <view class="mp-field">
          <text class="mp-label">{{ t("Mobile.Meeting.passcodeLabel") }}</text>
          <input
            class="mp-input"
            v-model="policyPwd"
            type="number"
            :maxlength="6"
            :placeholder="policyTargetRequiresPasscode ? t('Mobile.Meeting.policyPwdPlaceholderKeep') : t('Mobile.Meeting.policyPwdPlaceholderNew')"
            placeholder-style="color:#b0aebc"
          />
          <text class="mp-hint">{{ policyTargetRequiresPasscode ? t("Mobile.Meeting.policyPwdHintKeep") : t("Mobile.Meeting.policyPwdHintNew") }}</text>
        </view>

        <view class="mp-actions">
          <view class="mp-btn" hover-class="mp-btn--active" @click="closePolicy">
            <text class="mp-btn__text">{{ t("Mobile.Common.cancel") }}</text>
          </view>
          <view
            v-if="policyTargetRequiresPasscode"
            class="mp-btn"
            hover-class="mp-btn--active"
            @click="handleClearPasscode"
          >
            <text class="mp-btn__text">{{ t("Mobile.Meeting.policyClearPwd") }}</text>
          </view>
          <view
            class="mp-btn mp-btn--primary"
            :class="{ 'mp-btn--busy': policyBusy }"
            hover-class="mp-btn--primary-active"
            @click="handleSavePolicy"
          >
            <text class="mp-btn__text mp-btn__text--primary">{{ policyBusy ? t("Mobile.Common.loading") : t("Mobile.Common.save") }}</text>
          </view>
        </view>
      </view>
    </uni-modal-popup>
  </view>
</template>

<script setup lang="uts">
  import { computed, onMounted, onUnmounted, ref, watch, type ComponentPublicInstance } from "vue";
  import type { RequestResponse } from "@/types/interfaces/request";
  import UniModalPopup from "@/components/uni-modal-popup/uni-modal-popup.uvue";
  import { SUCCESS_CODE } from "@/constants/codes.constants";
  import { getApiBaseUrl } from "@/constants/config";
  import {
    apiImMeetingCancelSchedule,
    apiImMeetingRecords,
    apiImMeetingUpdateJoinPolicy,
    IM_MEETING_CHANGED_EVENT,
  } from "@/servers/imMeeting";
  import { apiResCode, apiResData } from "@/utils/apiResponse";
  // ★会议数据变更广播走仓内 eventBus，不走 uni.$on（App-Android 零触发前科，见常量声明处）
  import eventBus from "@/utils/eventBus";
  import { emptyI18nParams, t as translateFn, toI18nParams } from "@/utils/i18n";
  import { getCachedMyInfo } from "@/utils/im/myInfoCache";
  // 与智联录「新的伙伴」入口共用同一份线性 svg（contact-list-pane 同款 import 方式）
  import iconJoinMeeting from "@/static/icons/new_partner.svg";
  // 刷新图标：缺口圆环 + 箭头，几何在 svg 内一次对齐（见文件内注释）
  import iconRefresh from "@/static/icons/refresh_meeting.svg";
  import {
    buildMeetingInviteText,
    buildMeetingInviteUrl,
    formatMeetingId,
    meetingDisplayTitle,
    shareKeyOf,
  } from "@/utils/meeting/meetingLink";

  const props = withDefaults(
    defineProps<{
      /** 当前是否停在会议 tab：首拉/回切都靠它触发（页面只传这一个 prop）。 */
      active: boolean;
    }>(),
    {
      active: false,
    },
  );

  const t = (key: string): string => translateFn(key, emptyI18nParams(), "");

  /**
   * 每页条数：取服务端 clamp 上限 100（`MeetingRecordApplicationService.LIST_MAX`）。
   * ★不是「越大越快」——请求大、渲染也必须跟上，见 RENDER_CAP。
   */
  const PAGE_SIZE = 100;

  /**
   * ★★渲染封顶 + 渲染步进（性能闸门）。
   *
   * scroll-view 没有虚拟化/回收，节点数 = 行数 × 每行节点数，成长是线性的
   * （鸿蒙 ArkUI 首帧布局与 JS 同线程，60 行卡片实测约 1.2s）。所以「一次请求
   * 100 条」不能等于「一次渲染 100 行」：
   *   · 首屏只渲染 RENDER_INITIAL 行（滚到尾部再 +RENDER_STEP，纯本地、不发请求）；
   *   · 已加载行渲染完了才去请求下一页（100 条/次）；
   *   · 渲染量在 RENDER_CAP 处硬停，尾部提示「仅显示最近 N 条」；
   *   · 数据本身不丢（内存里是纯对象，1000 条量级可忽略），要看完整体请到网页端。
   *
   * 步长取 20 而不是 40：一次触底只新增约 200 个节点（一张卡 ≈10 个 view/text），
   * 单帧插入的布局开销减半，滚动手感更稳；行是 keyed 追加在末尾，已有行不重排，
   * 所以追加成本 ≈ 新节点创建 + 一次滚动内容高度更新。
   *
   * 后续若要真·虚拟列表，替换的是这里 + 容器（list-view/list-item 复用），
   * 数据层与封顶语义都不用动。
   */
  const RENDER_INITIAL = 40;
  const RENDER_STEP = 20;
  const RENDER_CAP = 500;

  /** 一行会议（列表项投影：接口运行时是 UTSJSONObject，不能 as DTO）。 */
  class MeetingRow {
    id: string = "";
    title: string = "";
    roomName: string = "";
    shareSlug: string = "";
    status: number = 2;
    statusText: string = "";
    /** 展示用：会议号 3-3-3 分组（空串=没有房间名）。 */
    roomLabel: string = "";
    /** 展示用：时间 · 时长 · 人数（缺的项不拼）。历史区用。 */
    metaText: string = "";
    /** 展示用：预约区文案 —— 今天/明天 + 时刻 · N 人（对齐 PC formatScheduleTime）。 */
    scheduleMeta: string = "";
    /** 展示用：进行中区文案 —— 开始时间 · 已进行 xx · N 人（每 30s 重算，对齐 PC）。 */
    liveMeta: string = "";
    /** 原始开始时间（服务端 yyyy-MM-dd HH:mm:ss）：「已进行」按它实时算，
     *  不能读落库的 durationSec（要到会议结束才写，进行中恒为 0）。 */
    startRaw: string = "";
    /** 落库时长（文案 / 秒数）：已结束才有值，进行中为空。 */
    durationStored: string = "";
    durationSec: number = -1;
    memberCount: number = 0;
    host: boolean = false;
    allowGuest: boolean = false;
    requiresPasscode: boolean = false;
    /** 允许提前进入（预约阶段只存在记录上；非主持人据此决定「提前进入」能不能点）。 */
    allowEarlyJoin: boolean = true;
    /** 录制状态：0 未录制 / 1 录制中 / 2 已完成 / 3 失败（服务端 im_meeting.record_status）。 */
    recordStatus: number = 0;
    /**
     * 这场会名下的转写状态（im_meeting_transcript.status，1 待抽音频 … 7 跳过；0=没下发）。
     * ★列表 DTO 也带这一列（服务端 `pickTranscriptStatus` 取最靠前的一档），
     *   「录制已保存 + 转写还在跑」要显示成「录制转写中」，只看 recordStatus 会误判已完成。
     */
    transcriptStatus: number = 0;
    /**
     * Tag 配色档位，与 statusText 同批算好（模板只拼类名，不在模板里做复合判断）：
     * pending 待开始 / live 进行中 / cancelled 已取消 / ok 录制已保存 /
     * running 录制中·录制转写中 / failed 录制失败 / none 无录制。
     */
    tone: string = "none";
    /** 预先拼好的类名：模板里只做一次字符串绑定（不在模板表达式里拼串）。 */
    tagClass: string = "mt-tag mt-tag--none";
    tagTextClass: string = "mt-tag__text mt-tag__text--none";
  }

  const rows = ref<MeetingRow[]>([]);
  const scheduledRows = ref<MeetingRow[]>([]);
  const ongoingRows = ref<MeetingRow[]>([]);
  const historyRows = ref<MeetingRow[]>([]);
  const loaded = ref<boolean>(false);
  const loading = ref<boolean>(false);
  const failed = ref<boolean>(false);
  const loadingMore = ref<boolean>(false);
  const hasMore = ref<boolean>(false);
  /**
   * 历史区当前渲染到第几行（只影响渲染，不影响已加载数据）。
   * 预约/进行中两区天然很少，直接全渲染（仍受 RENDER_CAP 兜底）。
   */
  const historyLimit = ref<number>(RENDER_INITIAL);

  // ★模板只读这三份「渲染视图」，源数组继续持有全部已加载数据。
  //   computed 只在源数组/上限换值时才重算，等于把模板的 v-for 规模钉在上限内。
  const scheduledView = computed((): MeetingRow[] => scheduledRows.value.slice(0, RENDER_CAP));
  const ongoingView = computed((): MeetingRow[] => ongoingRows.value.slice(0, RENDER_CAP));
  const historyView = computed((): MeetingRow[] => {
    const limit = historyLimit.value < RENDER_CAP ? historyLimit.value : RENDER_CAP;
    return historyRows.value.slice(0, limit);
  });

  /** 渲染量已撞上封顶（三区任一）。 */
  const capped = computed((): boolean => {
    return scheduledRows.value.length > RENDER_CAP
      || ongoingRows.value.length > RENDER_CAP
      || historyRows.value.length > RENDER_CAP;
  });

  /** 历史区还有已加载但未渲染的行（触底时先本地展开，不发请求）。 */
  const hasUnrendered = computed((): boolean => {
    return historyRows.value.length > historyLimit.value && historyLimit.value < RENDER_CAP;
  });

  /** 列表尾文案（模板不做嵌套三元：uvue 模板表达式越简单越稳）。 */
  const footText = computed((): string => {
    if (loadingMore.value) {
      return t("Mobile.Common.loading");
    }
    if (capped.value) {
      const params = new Map<string, string | number>();
      params.set("count", RENDER_CAP);
      return translateFn("Mobile.Meeting.renderCapHint", toI18nParams(params), "");
    }
    // 本地还能接着展开、或还能翻页：尾巴上不需要文案
    if (hasUnrendered.value || hasMore.value) {
      return "";
    }
    return t("Mobile.Meeting.noMore");
  });

  /** 分页游标（上一页最后一条 id；空=首页）。 */
  let beforeId = "";
  let lastLoadedAt = 0;
  /** 已加载 id 集合（Map 当 Set 用；重置时整个换新而非 clear()——Map.clear 在
   *  uni-app x 三端没有先例，换引用是与其它集合用法一致的最稳写法）。 */
  let seenIds = new Map<string, boolean>();
  /** 非当前 tab 收到「会议数据变了」广播时只置脏，等切回来再拉。 */
  let dirty = false;
  /** 首页请求序号 / 已应用序号：子页保存的广播与回页补拉常前后脚各发一次请求，
   *  两者并发时「先发后到」的旧回包会把新数据盖回旧的，所以回包按序号单调应用
   *  （比已应用序号旧的一律丢弃，但先到的仍可先用，不因为后一次失败就白拉）。 */
  let headSeq = 0;
  let headAppliedSeq = 0;
  /** 转写轮询间隔（对齐 PC `MeetingPane` 的 10s）与定时器句柄（<0 = 没在跑）。 */
  const TRANSCRIPT_POLL_MS = 10000;
  let pollTimer: number = -1;
  /** 进行中卡片「已进行 xx」的走表间隔（对齐 PC 30s；只重算文案，列表不轮询接口）。 */
  const LIVE_TICK_MS = 30000;
  let liveTimer: number = -1;
  /**
   * 每次成功写入列表数据 +1。用来在「写完之后」触发一次轮询开关重算 ——
   * ★写成计数器 + watch 而不是在 fetchRows 里直接调 syncTranscriptPoll：
   *   同层函数前向引用会报 error18（被调必须排在调用者之前），而轮询回调里
   *   又要调 fetchRows，两者互相引用，只能靠这个中间信号解耦。
   */
  const dataSeq = ref<number>(0);

  // ---------------------------------------------------------------- 字段读取

  function readStr(obj: UTSJSONObject, key: string): string {
    const value = obj[key];
    return value != null ? `${value}` : "";
  }

  function readNum(obj: UTSJSONObject, key: string, fallback: number): number {
    const value = obj[key];
    if (value == null) {
      return fallback;
    }
    if (typeof value == "number") {
      const n = value as number;
      return n != n ? fallback : n;
    }
    const parsed = parseFloat(`${value}`);
    return parsed != parsed ? fallback : parsed;
  }

  function readBool(obj: UTSJSONObject, key: string): boolean {
    const value = obj[key];
    if (value == null) {
      return false;
    }
    if (typeof value == "boolean") {
      return value as boolean;
    }
    return `${value}` == "true";
  }

  /** 布尔读取（带默认值）：键缺省时用 fallback —— 给「默认开」的开关用。 */
  function readBoolDefault(obj: UTSJSONObject, key: string, fallback: boolean): boolean {
    if (obj[key] == null) {
      return fallback;
    }
    return readBool(obj, key);
  }

  // ---------------------------------------------------------------- 展示辅助

  /**
   * 状态文案 + 配色档位：0 未开始 / 1 进行中 / 2 已结束 / 3 已取消（数字码判据，
   * 不比对服务端文案 —— `recordStatusText` 是「未录制 / 已录制 / 录制中 / 录制失败」，
   * 与 PC 徽标口径不同，端上自己算）。
   *
   * ★已结束 / 已取消的 Tag 都不写状态 —— 历史区只显示这场的**录制结果**
   *   （对齐 PC：列表用 `recordingBadge`，已取消同样显示成「无录制」；
   *    「已取消」这种状态说明进会议详情页才给，见 PC `MeetingDetailDialog`）。
   *   四档对齐 PC `recordBadge` + `recordingBadge`：
   *     record_status 1 ⇒ 录制中（Egress 还在写，散会后收尾阶段也会短暂停留）
   *     record_status 2 ⇒ 录制已保存；但转写还在 1~4 ⇒ 录制转写中（PC 2026-11-10 口径：
   *                      录像落库 ≠ 这单活干完，写「已保存」会让人以为不会再有文字）
   *     record_status 3 ⇒ 录制失败
   *     其余（0 / 未知码 / 老数据）⇒ 无录制（绝不显示空白 Tag）
   */
  function applyStatus(row: MeetingRow): void {
    let text = t("Mobile.Meeting.tagNoRecording");
    let tone = "none";
    if (row.status == 0) {
      text = t("Mobile.Meeting.tagPending");
      tone = "pending";
    } else if (row.status == 1) {
      text = t("Mobile.Meeting.tagOngoing");
      tone = "live";
    } else if (row.recordStatus == 1) {
      text = t("Mobile.Meeting.tagRecording");
      tone = "running";
    } else if (row.recordStatus == 3) {
      text = t("Mobile.Meeting.tagRecordFailed");
      tone = "failed";
    } else if (row.recordStatus == 2) {
      if (row.transcriptStatus >= 1 && row.transcriptStatus <= 4) {
        text = t("Mobile.Meeting.tagRecordingTranscribing");
        tone = "running";
      } else {
        text = t("Mobile.Meeting.tagRecorded");
        tone = "ok";
      }
    }
    row.statusText = text;
    row.tone = tone;
    row.tagClass = `mt-tag mt-tag--${tone}`;
    row.tagTextClass = `mt-tag__text mt-tag__text--${tone}`;
  }

  /**
   * 时间展示：服务端可能给 ISO（2026-11-14T20:00:00）或 yyyy-MM-dd HH:mm。
   * 统一成「yyyy-MM-dd HH:mm」——历史记录会翻到往年的会，只给 MM-DD 分不清是哪一年。
   */
  function formatTime(raw: string): string {
    const text = raw.trim();
    if (text.length == 0) {
      return "";
    }
    let s = text.replaceAll("T", " ");
    const dot = s.indexOf(".");
    if (dot > 0) {
      s = s.substring(0, dot);
    }
    // yyyy-MM-dd HH:mm[:ss]
    if (s.length >= 16) {
      return `${s.substring(0, 10)} ${s.substring(11, 16)}`;
    }
    return s;
  }

  /**
   * 预约卡片的时间写法（对齐 PC `formatScheduleTime`）：今天 / 明天换成相对说法，
   * 其余仍给绝对时间。★按**日历天**判相对（22:00 与次日 01:00 是「明天」不是「3 小时后」）；
   * PC 还会给星期，端上不引入四语言星期表，跨天时直接用完整日期，语义不丢。
   */
  function scheduleTimeText(raw: string): string {
    const text = formatTime(raw);
    if (text.length < 16) {
      return text;
    }
    const year = parseInt(text.substring(0, 4));
    const month = parseInt(text.substring(5, 7));
    const day = parseInt(text.substring(8, 10));
    const hh = parseInt(text.substring(11, 13));
    const mm = parseInt(text.substring(14, 16));
    if (isNaN(year) || isNaN(month) || isNaN(day) || isNaN(hh) || isNaN(mm)) {
      return text;
    }
    const target = new Date(year, month - 1, day, hh, mm, 0);
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0);
    const targetDay = new Date(year, month - 1, day, 0, 0, 0);
    const diffDays = Math.round((targetDay.getTime() - today.getTime()) / 86400000);
    const params = new Map<string, string | number>();
    params.set("time", `${hh < 10 ? "0" : ""}${hh}:${mm < 10 ? "0" : ""}${mm}`);
    if (diffDays == 0) {
      return translateFn("Mobile.Meeting.timeToday", toI18nParams(params), "");
    }
    if (diffDays == 1) {
      return translateFn("Mobile.Meeting.timeTomorrow", toI18nParams(params), "");
    }
    return text;
  }

  /** 两位补零（时长文案用）。 */
  function pad2(value: number): string {
    return value < 10 ? `0${value}` : `${value}`;
  }

  /**
   * 时长文案（对齐 PC `durationText`）：`45秒` / `12分05秒` / `2小时05分`。
   * ★用词条而不是写死中文：这个 App 的四套语言都要出这句。
   */
  function durationTextOf(sec: number): string {
    if (sec < 0) {
      return "";
    }
    const total = Math.floor(sec);
    const params = new Map<string, string | number>();
    if (total < 60) {
      params.set("sec", total);
      return translateFn("Mobile.Meeting.durationSec", toI18nParams(params), "");
    }
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    if (h > 0) {
      params.set("hour", h);
      params.set("min", pad2(m));
      return translateFn("Mobile.Meeting.durationHourMin", toI18nParams(params), "");
    }
    params.set("min", m);
    params.set("sec", pad2(s));
    return translateFn("Mobile.Meeting.durationMinSec", toI18nParams(params), "");
  }

  /** 服务端 `yyyy-MM-dd HH:mm[:ss]` ⇒ 毫秒时间戳（不用 new Date(串)：iOS 对该格式解析不一致）。 */
  function parseServerTime(raw: string): number {
    const text = formatTime(raw);
    if (text.length < 16) {
      return -1;
    }
    const year = parseInt(text.substring(0, 4));
    const month = parseInt(text.substring(5, 7));
    const day = parseInt(text.substring(8, 10));
    const hh = parseInt(text.substring(11, 13));
    const mm = parseInt(text.substring(14, 16));
    if (isNaN(year) || isNaN(month) || isNaN(day) || isNaN(hh) || isNaN(mm)) {
      return -1;
    }
    return new Date(year, month - 1, day, hh, mm, 0).getTime();
  }

  /**
   * 进行中第二行（对齐 PC）：`2026-11-14 20:00 · 已进行 12分05秒 · 3 人`。
   * ★PC 用绝对时间（meetingTimeText），不是预约区的「今天/明天」相对说法。
   * ★时长优先用落库值；进行中没有落库值 ⇒ 按开始时间实时算。
   */
  function liveMetaOf(row: MeetingRow, now: number): string {
    const parts: string[] = [];
    const timeText = formatTime(row.startRaw);
    if (timeText.length > 0) {
      parts.push(timeText);
    }
    let duration = row.durationStored;
    if (duration.length == 0 && row.status == 1) {
      const started = parseServerTime(row.startRaw);
      if (started > 0) {
        const sec = Math.floor((now - started) / 1000);
        duration = durationTextOf(sec > 0 ? sec : 0);
      }
    }
    if (duration.length > 0) {
      const params = new Map<string, string | number>();
      params.set("duration", duration);
      parts.push(translateFn("Mobile.Meeting.liveFor", toI18nParams(params), ""));
    }
    if (row.memberCount > 0) {
      const params = new Map<string, string | number>();
      params.set("count", row.memberCount);
      parts.push(translateFn("Mobile.Meeting.inRoomCount", toI18nParams(params), ""));
    }
    let out = "";
    for (let i = 0; i < parts.length; i++) {
      out += i == 0 ? parts[i] : ` · ${parts[i]}`;
    }
    return out;
  }

  /**
   * 重算进行中卡片的第二行。
   * ★写进「换引用」的新数组：直接改行对象字段在 App 端不一定触发重渲染
   *   （class 实例不是深响应），换数组引用是这里最稳的写法。
   */
  function refreshLiveMeta(): void {
    const list = ongoingRows.value;
    if (list.length == 0) {
      return;
    }
    const now = Date.now();
    const next: MeetingRow[] = [];
    for (let i = 0; i < list.length; i++) {
      const row = list[i];
      row.liveMeta = liveMetaOf(row, now);
      next.push(row);
    }
    ongoingRows.value = next;
  }

  /** 预约区第二行：`今天 20:00 · 5 人`（时长要到会议结束才有，预约阶段不显示）。 */
  function scheduleMetaOf(record: UTSJSONObject): string {
    const parts: string[] = [];
    const timeText = scheduleTimeText(readStr(record, "startTime"));
    if (timeText.length > 0) {
      parts.push(timeText);
    }
    const memberCount = readNum(record, "memberCount", 0);
    if (memberCount > 0) {
      const params = new Map<string, string | number>();
      params.set("count", memberCount);
      parts.push(translateFn("Mobile.Meeting.inRoomCount", toI18nParams(params), ""));
    }
    let out = "";
    for (let i = 0; i < parts.length; i++) {
      out += i == 0 ? parts[i] : ` · ${parts[i]}`;
    }
    return out;
  }

  function metaTextOf(record: UTSJSONObject): string {
    const parts: string[] = [];
    const timeText = formatTime(readStr(record, "startTime"));
    if (timeText.length > 0) {
      parts.push(timeText);
    }
    const duration = readStr(record, "durationText");
    if (duration.length > 0) {
      parts.push(duration);
    }
    const memberCount = readNum(record, "memberCount", 0);
    if (memberCount > 0) {
      const params = new Map<string, string | number>();
      params.set("count", memberCount);
      parts.push(translateFn("Mobile.Meeting.inRoomCount", toI18nParams(params), ""));
    }
    let out = "";
    for (let i = 0; i < parts.length; i++) {
      out += i == 0 ? parts[i] : ` · ${parts[i]}`;
    }
    return out;
  }

  function toRow(record: UTSJSONObject): MeetingRow {
    const row = new MeetingRow();
    row.id = readStr(record, "id");
    row.roomName = readStr(record, "roomName");
    row.shareSlug = readStr(record, "shareSlug");
    row.status = readNum(record, "status", 2);
    row.recordStatus = readNum(record, "recordStatus", 0);
    // 老服务端不下发 ⇒ 0，状态退回只看录制结果
    row.transcriptStatus = readNum(record, "transcriptStatus", 0);
    applyStatus(row);
    // ★标题回落必须用 roomName 拼（空标题的会议不能显示成「会议 」）
    const rawTitle = readStr(record, "title");
    row.title = meetingDisplayTitle(rawTitle, row.roomName);
    row.roomLabel = row.roomName.length > 0 ? formatMeetingId(row.roomName) : "";
    row.metaText = metaTextOf(record);
    row.scheduleMeta = scheduleMetaOf(record);
    // 进行中区的第二行要按开始时间实时算（durationSec 要到会议结束才写）
    row.startRaw = readStr(record, "startTime");
    row.durationStored = readStr(record, "durationText");
    row.durationSec = readNum(record, "durationSec", -1);
    row.memberCount = readNum(record, "memberCount", 0);
    row.host = readBool(record, "host");
    row.allowGuest = readBool(record, "allowGuest");
    row.requiresPasscode = readBool(record, "requiresPasscode");
    // 老服务端/老记录不下发 ⇒ 默认允许（PC 用 `s.allowEarlyJoin === false` 判禁用，同一口径）
    row.allowEarlyJoin = readBoolDefault(record, "allowEarlyJoin", true);
    return row;
  }

  /** 列表解析：服务端正常返回数组；网关半坏返回 {records:[...]} 或 null 时都不能白屏。 */
  function parseRows(res: RequestResponse<any>): MeetingRow[] {
    const out: MeetingRow[] = [];
    const data = apiResData<any>(res);
    if (data == null) {
      return out;
    }
    let list: UTSJSONObject[] | null = null;
    if (Array.isArray(data)) {
      list = data as UTSJSONObject[];
    } else if (typeof data == "object") {
      const obj = data as UTSJSONObject;
      const records = obj["records"];
      if (records != null) {
        list = records as UTSJSONObject[];
      }
    }
    if (list == null) {
      return out;
    }
    for (let i = 0; i < list.length; i++) {
      const item = list[i];
      if (item == null) {
        continue;
      }
      out.push(toRow(item as UTSJSONObject));
    }
    return out;
  }

  /** 三区拆分（预约 / 进行中 / 历史），单次遍历，避免模板里反复 filter。 */
  function splitRows(): void {
    const scheduled: MeetingRow[] = [];
    const ongoing: MeetingRow[] = [];
    const history: MeetingRow[] = [];
    const list = rows.value;
    for (let i = 0; i < list.length; i++) {
      const row = list[i];
      if (row.status == 0) {
        scheduled.push(row);
      } else if (row.status == 1) {
        ongoing.push(row);
      } else {
        history.push(row);
      }
    }
    scheduledRows.value = scheduled;
    ongoingRows.value = ongoing;
    historyRows.value = history;
    // 进行中那几行的第二行要按当前时间现算（见 liveMetaOf）
    refreshLiveMeta();
  }

  /** 按 status 判断归属区（0=预约 1=进行中 其余=历史）。 */
  function bucketOf(row: MeetingRow): number {
    if (row.status == 0) return 0;
    if (row.status == 1) return 1;
    return 2;
  }

  /**
   * ★加载更多：**增量分区**。
   * 只遍历新页（<=100 条）分发到对应区，不复制整表、不重建三区——
   * 翻到第 10 页时仍是 100 次遍历，而不是 1000 次。
   * 数组用 concat 换引用（uvue 里原地 push 的更新不如换引用可靠）；
   * 三个区里只有真正有新行的区才换引用，另外两区保持原数组、不触发重渲染。
   */
  function appendRows(page: MeetingRow[]): void {
    const s: MeetingRow[] = [];
    const o: MeetingRow[] = [];
    const h: MeetingRow[] = [];
    const fresh: MeetingRow[] = [];
    for (let i = 0; i < page.length; i++) {
      const row = page[i];
      // ★空 id 不参与去重：服务端异常缺 id 时按原样保留，不能把行吞掉
      if (row.id.length > 0) {
        if (seenIds.has(row.id)) {
          continue; // 游标重叠/并发刷新导致的重复行
        }
        seenIds.set(row.id, true);
      }
      fresh.push(row);
      const bucket = bucketOf(row);
      if (bucket == 0) {
        s.push(row);
      } else if (bucket == 1) {
        o.push(row);
      } else {
        h.push(row);
      }
    }
    if (fresh.length == 0) {
      return;
    }
    rows.value = rows.value.concat(fresh);
    if (s.length > 0) {
      scheduledRows.value = scheduledRows.value.concat(s);
    }
    if (o.length > 0) {
      ongoingRows.value = ongoingRows.value.concat(o);
      refreshLiveMeta();
    }
    if (h.length > 0) {
      historyRows.value = historyRows.value.concat(h);
    }
  }

  /**
   * 首页是否与已加载数据「逐条相同」（一致 ⇒ 静默刷新不动列表、不丢滚动位置）。
   * ★除了 id，还要比 status/title/metaText：预约到点变「进行中」、会议结束、
   * 人数变化都只改这几列而不换 id，只比 id 会让列表停在旧状态。
   * 比较是 100 量级的字符串比对，比整表重建便宜两个数量级。
   */
  function isSameHead(page: MeetingRow[]): boolean {
    const old = rows.value;
    if (old.length == 0 || page.length == 0 || old.length < page.length) {
      return false;
    }
    for (let i = 0; i < page.length; i++) {
      const a = old[i];
      const b = page[i];
      // 空 id 无法判定同一行：按「有变化」处理，宁可重建也不把行认错
      if (a.id.length == 0 || b.id.length == 0) {
        return false;
      }
      // statusText 也要比：已结束行的 Tag 现在显示录制结果（recordStatus），
      // 录制转存完成只改这一列，漏比会让列表停在「无录制」
      if (a.id != b.id || a.status != b.status || a.title != b.title
        || a.metaText != b.metaText || a.statusText != b.statusText) {
        return false;
      }
    }
    return true;
  }

  /**
   * ★静默刷新（切 tab 回来 / 子页广播）：拉首页后**按 id 合并**，不整表替换。
   * 目的有二：
   *   1) 不丢已翻过的页——旧实现把 beforeId 清空后首页覆盖，已加载 300 条会缩回 100 条，
   *      滚动位置还在中间就成了空白；
   *   2) 数据没变时直接跳过写 ref，一行都不重渲染。
   */
  function mergeHead(page: MeetingRow[]): void {
    // 空首页（后端异常/无数据）不重建：merged 结果与现状等价，白跑一次三区重建
    if (page.length == 0 || isSameHead(page)) {
      return;
    }
    const freshIds = new Map<string, boolean>();
    for (let i = 0; i < page.length; i++) {
      freshIds.set(page[i].id, true);
    }
    // 首页在前（新会议加到最上面），旧数据里不在首页的按原序接在后面
    const merged: MeetingRow[] = [];
    for (let i = 0; i < page.length; i++) {
      merged.push(page[i]);
    }
    const old = rows.value;
    for (let i = 0; i < old.length; i++) {
      const row = old[i];
      if (freshIds.has(row.id)) {
        continue;
      }
      merged.push(row);
    }
    const nextSeen = new Map<string, boolean>();
    for (let i = 0; i < merged.length; i++) {
      nextSeen.set(merged[i].id, true);
    }
    seenIds = nextSeen;
    rows.value = merged;
    splitRows();
  }

  // ---------------------------------------------------------------- 拉取

  /**
   * 拉列表。
   * @param append true=加载更多（游标续页，增量分区）；false=首页（首屏/刷新/静默合并）
   * @param silent true=静默刷新（不动 loading/failed，列表不闪）
   */
  async function fetchRows(append: boolean, silent: boolean): Promise<void> {
    let myHeadSeq = 0;
    if (append) {
      if (loadingMore.value || !hasMore.value) {
        return;
      }
      loadingMore.value = true;
    } else {
      // 首页并发不拦请求：子页保存的广播与回页补拉常前后脚到达，两次都发，
      // 回包按序号单调应用（见 headSeq 注释），先发后到的那次整批丢弃。
      headSeq = headSeq + 1;
      myHeadSeq = headSeq;
      if (!silent) {
        loading.value = true;
        failed.value = false;
      }
    }
    try {
      const res = await apiImMeetingRecords(append ? beforeId : "", PAGE_SIZE, silent);
      const code = apiResCode(res);
      if (code != SUCCESS_CODE) {
        if (!silent && !append) {
          failed.value = true;
        }
        return;
      }
      // 首页回包按序号单调应用：比「已应用」更旧的（先发后到的那个）整批丢弃，
      // 否则会拿旧数据盖掉新数据；先到的照常应用，不因后一次失败而白拉。
      if (!append) {
        if (myHeadSeq < headAppliedSeq) {
          return;
        }
        headAppliedSeq = myHeadSeq;
      }
      const page = parseRows(res);
      if (append) {
        appendRows(page);
      } else if (silent) {
        mergeHead(page);
      } else {
        // 手动刷新/首拉：整表重置（游标从头开始）
        const nextSeen = new Map<string, boolean>();
        for (let i = 0; i < page.length; i++) {
          nextSeen.set(page[i].id, true);
        }
        seenIds = nextSeen;
        rows.value = page;
        splitRows();
        // 整表重置 = 渲染也从第一屏重新开始（与数据换引用同一批，避免先收缩再长大）
        historyLimit.value = RENDER_INITIAL;
      }
      // 游标只跟着「本页最后一条」走；静默合并不动它（否则会丢已加载的后续页）
      if (!silent && page.length > 0) {
        beforeId = page[page.length - 1].id;
      }
      if (!silent) {
        hasMore.value = page.length >= PAGE_SIZE;
      }
      loaded.value = true;
      lastLoadedAt = Date.now();
      dataSeq.value = dataSeq.value + 1;
    } catch (_error) {
      if (!silent && !append) {
        failed.value = true;
      }
    } finally {
      if (append) {
        loadingMore.value = false;
      } else if (myHeadSeq == headSeq) {
        // 只有「最后一次」首页请求负责收 loading；被接管的那次别提前把转圈关掉
        loading.value = false;
      }
    }
  }

  // ---------------------------------------------------------------- 转写轮询

  /**
   * 列表里是否还有转写跑在流水线上（1 待抽音频 / 2 提取中 / 3 待识别 / 4 识别中）。
   * 5 完成 / 6 失败 / 7 跳过都是终态。
   */
  function hasRunningTranscript(): boolean {
    const list = rows.value;
    for (let i = 0; i < list.length; i++) {
      const s = list[i].transcriptStatus;
      if (s >= 1 && s <= 4) {
        return true;
      }
    }
    return false;
  }

  function stopTranscriptPoll(): void {
    if (pollTimer >= 0) {
      clearInterval(pollTimer);
      pollTimer = -1;
    }
  }

  /**
   * ★有转写在跑时静默轮询（对齐 PC 10s）。
   *
   * 没有它，「录制转写中」会一直挂在列表上直到用户切走再切回来 —— 徽标说的是
   * "还在跑"，但列表本身不会自己变，转写早就跑完了也照样挂着，比原来显示
   * 「录制已保存」更误导。转写进终态后 hasRunningTranscript 变 false，定时器自停。
   *
   * 三重闸门：不在会议 tab 不拉（切回来由 active watch 补一次）、已有请求在飞不拉、
   * 只在确实有进行中转写时才起表。
   */
  function syncTranscriptPoll(): void {
    if (!props.active || !hasRunningTranscript()) {
      stopTranscriptPoll();
      return;
    }
    if (pollTimer >= 0) {
      return;
    }
    pollTimer = setInterval((): void => {
      if (!props.active || loading.value || loadingMore.value) {
        return;
      }
      // 静默合并：数据没变时零重渲染，不会把正在看的位置顶掉
      fetchRows(false, true);
    }, TRANSCRIPT_POLL_MS);
  }

  // ---------------------------------------------------------------- 进行中计时

  function stopLiveTimer(): void {
    if (liveTimer >= 0) {
      clearInterval(liveTimer);
      liveTimer = -1;
    }
  }

  /**
   * ★有进行中的会议时才走表，只重算那几行「已进行 xx」（对齐 PC 的 30s tick）。
   * 列表本身**不**轮询接口 —— 每 30s 打一次接口是把低频动作变成常态流量。
   */
  function syncLiveTimer(): void {
    if (!props.active || ongoingRows.value.length == 0) {
      stopLiveTimer();
      return;
    }
    if (liveTimer >= 0) {
      return;
    }
    liveTimer = setInterval((): void => {
      if (!props.active) {
        return;
      }
      refreshLiveMeta();
    }, LIVE_TICK_MS);
  }

  /** 首屏/刷新：清游标从头拉（loading 期间重复点击直接忽略）。 */
  function handleRefresh(): void {
    if (loading.value) {
      return;
    }
    beforeId = "";
    hasMore.value = true;
    fetchRows(false, false);
  }

  /**
   * 触底：优先「本地展开已加载但未渲染的行」，全部渲染完才去请求下一页。
   * 这样 100 条一页不会被一次性塞进 100 个节点，而是 40 → 60 → 80 → 100 长出来。
   */
  function handleLoadMore(): void {
    if (loadingMore.value || loading.value || failed.value) {
      return;
    }
    // 已撞渲染封顶：再翻页也只会进内存、永远看不到 → 不再发请求（省流量、省服务端）
    if (capped.value) {
      return;
    }
    if (hasUnrendered.value) {
      const next = historyLimit.value + RENDER_STEP;
      historyLimit.value = next < RENDER_CAP ? next : RENDER_CAP;
      return;
    }
    if (!hasMore.value) {
      return;
    }
    fetchRows(true, false);
  }

  // ---------------------------------------------------------------- 交互

  function handleEntry(kind: string): void {
    if (kind == "create") {
      uni.navigateTo({ url: "/subpackages/pages/im-meeting/im-meeting-create" });
      return;
    }
    if (kind == "join") {
      uni.navigateTo({ url: "/subpackages/pages/im-meeting/im-meeting-join" });
      return;
    }
    uni.navigateTo({ url: "/subpackages/pages/im-meeting/im-meeting-schedule" });
  }

  function myDisplayName(): string {
    const info = getCachedMyInfo();
    return info != null ? info.displayName : "";
  }

  function inviteTextOf(row: MeetingRow): string {
    const url = buildMeetingInviteUrl(getApiBaseUrl(), shareKeyOf(row.shareSlug, row.roomName));
    return buildMeetingInviteText(myDisplayName(), row.title, row.roomName, url);
  }

  function copyText(data: string): void {
    if (data.length == 0) {
      return;
    }
    uni.setClipboardData({
      data,
      success: (_res) => {
        uni.showToast({ title: t("Mobile.Meeting.copied"), icon: "none" });
      },
    });
  }

  function handleCopyInvite(row: MeetingRow): void {
    copyText(inviteTextOf(row));
  }

  /**
   * 拉起「会议信息」页（= 会中页的占位）。
   *
   * ★PC 在「开始 / 入会」之后直接进会中界面（左上角才有「会议信息」入口）；App 的
   *   媒体层（LiveKit）还没接，先落到信息页，会中能力后续迭代补。
   * ★数据全走 query：列表里已有这份投影，信息页不再请求一次（避免两份数据打架）。
   * ★本函数必须写在 handleEnterRow / handleStartRow 之前——uvue 同级函数前向引用报 error18。
   */
  function openMeetingRoom(row: MeetingRow): void {
    if (row.roomName.length == 0) {
      return;
    }
    const url =
      `/subpackages/pages/im-meeting/im-meeting-room?room=${encodeURIComponent(row.roomName)}` +
      `&title=${encodeURIComponent(row.title)}` +
      `&slug=${encodeURIComponent(row.shareSlug)}` +
      `&status=${row.status}` +
      `&start=${encodeURIComponent(row.startRaw)}` +
      `&members=${row.memberCount}` +
      `&passcode=${row.requiresPasscode ? 1 : 0}`;
    uni.navigateTo({ url });
  }

  /** 进行中「入会」：先进会议信息页（媒体层接入后再换成真正的会中页）。 */
  function handleEnterRow(row: MeetingRow): void {
    openMeetingRoom(row);
  }

  /** 取消失败/成功都要回到最新列表：服务端删的是所有人的这条预约。 */
  async function cancelSchedule(meetingId: string): Promise<void> {
    try {
      const res = await apiImMeetingCancelSchedule(meetingId);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Meeting.failed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Meeting.cancelDone"), icon: "none" });
      handleRefresh();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Meeting.failed"), icon: "none" });
    }
  }

  /** 取消预约：二次确认后调服务端（仅主持人；非主持人服务端会拒）。
   *  ★顺序：cancelSchedule 必须写在调用者之前——uvue 同级函数前向引用报 error18。 */
  /** 预约卡「开始」：先打开会议信息页（占位）。
   *  ★PC 在这里会 createRoom 把记录 0→1 再拉会中界面；App 没有媒体层，先不建房——
   *    否则会留下一场「进行中」却没人能进的会议，列表也会把它挪进进行中区。 */
  function handleStartRow(row: MeetingRow): void {
    openMeetingRoom(row);
  }

  /** 预约卡「复制」：复制会议号（PC 复制的是原始号串，不是 3-3-3 分组写法）。 */
  function handleCopyNo(row: MeetingRow): void {
    if (row.roomName.length == 0) {
      return;
    }
    uni.setClipboardData({
      data: row.roomName,
      success: (_res) => {
        uni.showToast({ title: t("Mobile.Meeting.noCopied"), icon: "none" });
      },
    });
  }

  /** 预约卡「提前进入」（仅非主持人）：走「加入」页把会议号带过去——可能设了密码，
   *  直接进会会让用户先失败一次才知道要密码（PC 同样是 openJoinWith）。 */
  function handleEarlyJoin(row: MeetingRow): void {
    if (row.roomName.length == 0) {
      return;
    }
    if (!row.allowEarlyJoin) {
      uni.showToast({ title: t("Mobile.Meeting.earlyJoinClosed"), icon: "none" });
      return;
    }
    uni.navigateTo({
      url: `/subpackages/pages/im-meeting/im-meeting-join?room=${encodeURIComponent(row.roomName)}`,
    });
  }

  // ---------------------------------------------------------------- 入会设置（仅主持人）

  /** 当前正在改的预约；null = 弹窗关着。 */
  const policyTarget = ref<MeetingRow | null>(null);
  const policyEarly = ref<boolean>(true);
  const policyPwd = ref<string>("");
  const policyBusy = ref<boolean>(false);
  const policyPopup = ref<any | null>(null);
  /** 这条预约是否已经设了密码（决定 placeholder / 提示 / 是否展示「清除密码」）。 */
  const policyTargetRequiresPasscode = computed((): boolean => {
    const row = policyTarget.value;
    return row != null && row.requiresPasscode;
  });

  /** Android：Gen* 组件 ref 禁止 as UTSJSONObject，用 $callMethod 调 uni-modal-popup */
  function callPolicyMethod(methodName: string): void {
    const refVal = policyPopup.value;
    if (refVal == null) {
      return;
    }
    const proxy = refVal as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  }

  function closePolicy(): void {
    callPolicyMethod("close");
    policyTarget.value = null;
    policyBusy.value = false;
  }

  function openPolicy(row: MeetingRow): void {
    policyTarget.value = row;
    // 复位到「这条预约的现状」：密码永远空白输入（服务端不保存明文回显）
    policyEarly.value = row.allowEarlyJoin;
    policyPwd.value = "";
    policyBusy.value = false;
    callPolicyMethod("open");
  }

  function handlePolicyEarlyChange(event: any): void {
    const se = event as UniSwitchChangeEvent;
    policyEarly.value = se.detail.value;
  }

  /** 入会密码校验：4-6 位纯数字（不写正则——三端 RegExp 行为不一致，同 meetingLink 口径）。 */
  function isPasscodeText(text: string): boolean {
    if (text.length < 4 || text.length > 6) {
      return false;
    }
    for (let i = 0; i < text.length; i++) {
      const c = text.charCodeAt(i)!!;
      if (c < 48 || c > 57) {
        return false;
      }
    }
    return true;
  }

  /** 提交入会设置。
   *  @param clearPasscode true = 清除密码（服务端把 password 置空）。
   *  ★joinPasscode 的三态：null=不改 / ""=清除 / "1234"=重设，只改开关时传 null。 */
  async function doSavePolicy(clearPasscode: boolean): Promise<void> {
    const row = policyTarget.value;
    if (row == null || policyBusy.value) {
      return;
    }
    const pwd = policyPwd.value.trim();
    if (!clearPasscode && pwd.length > 0 && !isPasscodeText(pwd)) {
      uni.showToast({ title: t("Mobile.Meeting.passcodeInvalid"), icon: "none" });
      return;
    }
    let passcode: string | null = null;
    if (clearPasscode) {
      passcode = "";
    } else if (pwd.length > 0) {
      passcode = pwd;
    }
    policyBusy.value = true;
    try {
      const res = await apiImMeetingUpdateJoinPolicy(row.id, policyEarly.value, passcode);
      if (apiResCode(res) != SUCCESS_CODE) {
        uni.showToast({ title: t("Mobile.Meeting.failed"), icon: "none" });
        return;
      }
      uni.showToast({ title: t("Mobile.Meeting.policySaved"), icon: "none" });
      closePolicy();
      handleRefresh();
    } catch (_error) {
      uni.showToast({ title: t("Mobile.Meeting.failed"), icon: "none" });
    } finally {
      policyBusy.value = false;
    }
  }

  function handleSavePolicy(): void {
    doSavePolicy(false);
  }

  function handleClearPasscode(): void {
    doSavePolicy(true);
  }

  /** 删除图标 → 二次确认，文案与按钮逐项对齐 PC `cancelSchedule`：
   *  标题「取消这场预约？」/ 正文「取消后所有人都会收到通知，记录会标记为「已取消」。」/
   *  主操作「取消预约」（危险色）/ 次操作「先留着」。 */
  function handleCancelSchedule(row: MeetingRow): void {
    uni.showModal({
      title: t("Mobile.Meeting.cancelScheduleTitle"),
      content: t("Mobile.Meeting.cancelScheduleConfirm"),
      confirmText: t("Mobile.Meeting.cancelSchedule"),
      cancelText: t("Mobile.Meeting.cancelScheduleKeep"),
      confirmColor: "#e5484d",
      success: (res) => {
        if (!res.confirm) {
          return;
        }
        cancelSchedule(row.id);
      },
    });
  }

  // ---------------------------------------------------------------- 生命周期

  /** 子页（发起/加入/预约）改动会议数据后广播，这里静默重拉（不闪列表）。
   *  ★不在会议 tab 时不发请求：只置脏，切回来时由 watch 统一拉一次
   *  （否则在消息/智联录页停留期间，子页每次广播都会白跑一次请求 + 三区重建）。
   *  ★广播还有第二个来源：message-content 的 onShow 在会议 tab 可见时也发一条。
   *    子页保存后广播的那次请求是在本页被覆盖期间发出的，回包若赶在服务端写入对读
   *    可见之前，列表就停在旧数据；回页时 activeTab 没变、active watch 不触发，需要
   *    这条补拉的广播才能看到「刚建的预约」。数据没变时 mergeHead/isSameHead 不写 ref。 */
  function handleMeetingChanged(_payload: any): void {
    if (!props.active) {
      dirty = true;
      return;
    }
    fetchRows(false, true);
  }

  /** ★必须箭头包装再交给 eventBus.on：App-Android(UTS→Kotlin) 裸函数引用传 eventBus.on
   *  绑不上回调（编译产物原样透传函数名，运行时不成立，订阅静默失效——message-content
   *  4220 行的真机结论）。on/off 须同一引用，故存为具名 const，别写箭头字面量
   *  （每次都是新引用，off 匹配不上会泄漏）。
   *  本条订阅就是「预约保存后回到会议页看不到新会议」的直接原因：广播发了、订阅没绑上。 */
  const onMeetingChanged = (payload: any): void => { handleMeetingChanged(payload); };

  onMounted(() => {
    eventBus.on(IM_MEETING_CHANGED_EVENT, onMeetingChanged);
    if (props.active && !loaded.value) {
      handleRefresh();
    }
  });

  onUnmounted(() => {
    eventBus.off(IM_MEETING_CHANGED_EVENT, onMeetingChanged);
    // 定时器必须在卸载时停：组件的 setInterval 不会随节点销毁自动清（否则会一直拉接口）
    stopTranscriptPoll();
    stopLiveTimer();
  });

  // 每次成功写入数据后重算一次「要不要开转写轮询 / 进行中计时」（见 dataSeq 注释）
  watch(
    (): number => dataSeq.value,
    (_seq: number): void => {
      syncTranscriptPoll();
      syncLiveTimer();
    },
  );

  // 切到会议 tab：静默刷新（SWR——已有列表继续显示，回来即最新）。
  // ★静默刷新走 mergeHead（按 id 合并），不动 beforeId：已翻过的页不会缩回去。
  // ★距上次拉取 < 5s 且没有脏标记时直接跳过，避免来回横滑刷出一串请求。
  // ★watch 源的箭头必须显式标返回类型（`(): boolean =>`）：写 `() => props.active`
  //   时 Kotlin 侧会按「值」重载解析，报 expected Function / actual Boolean
  //   （conv-list-pane / contact-list-pane 同款约束）。
  watch(
    (): boolean => props.active,
    (nowActive: boolean): void => {
      if (!nowActive) {
        // 离开会议 tab 就停表：后台不轮询（数据由切回来时的静默刷新兜底）
        stopTranscriptPoll();
        stopLiveTimer();
        return;
      }
      if (!loaded.value) {
        dirty = false;
        handleRefresh();
        return;
      }
      const stale = dirty;
      dirty = false;
      if (!stale && Date.now() - lastLoadedAt < 5000) {
        // 本次跳过请求，但仍要把（可能被离开时停掉的）转写轮询 / 进行中计时重新起来
        syncTranscriptPoll();
        syncLiveTimer();
        return;
      }
      fetchRows(false, true);
    },
  );

</script>

<style lang="scss" scoped>
  .mt-root {
    flex: 1;
    background-color: #f5f6f8;
  }

  .mt-scroll {
    flex: 1;
  }

  /* 三入口平铺：白底卡片 + 图标圆底 */
  .mt-actions {
    display: flex;
    flex-direction: row;
    margin: 12px 12px 4px 12px;
    padding: 14px 0;
    background-color: #ffffff;
    border-radius: 12px;
  }

  .mt-action {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .mt-action--active {
    opacity: 0.7;
  }

  .mt-action__icon {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mt-action__icon--create {
    background-color: #eeecff;
  }

  /* 字形盒：三枚入口图标统一 22x22、居中。
     ★line-height 钉成盒高：App 端 <text> 的行盒比字形本身高，不钉会让字形在
     圆圈里看起来偏上/偏下（纯 flex 居中只对齐「行盒」，不对齐墨迹）。 */
  .mt-action__glyph {
    width: 22px;
    height: 22px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    line-height: 22px;
  }

  /* 字体图标墨迹在字身框内偏左，两枚字形图标补正右移（发起 2px / 预约 3px：
     两枚字形的左右边距不同，预约的时钟外圆更窄，故多补 1px 才与另两枚视觉对齐）。
     ★用 relative + left 而不是 margin-left：外层是 justify-content:center，
       加 margin 会让「居中」把留白对半分，实际只挪一半（margin-left:2px 只移动 1px）；
       relative 偏移不参与布局，写多少就是多少，且不改动圆内其它对齐。 */
  .mt-action__glyph--nudge {
    position: relative;
    left: 2px;
  }

  .mt-action__glyph--nudge-more {
    position: relative;
    left: 3px;
  }

  /* svg 线性图标（新的伙伴同款）：固定 22px，随 image 自身描边色（#4E5969） */
  .mt-action__img {
    width: 22px;
    height: 22px;
  }

  .mt-action__icon--join {
    background-color: #e7f6ef;
  }

  .mt-action__icon--schedule {
    background-color: #fdf1e0;
  }

  .mt-action__label {
    margin-top: 8px;
    font-size: 13px;
    line-height: 18px;
    color: #141416;
  }

  .mt-section {
    margin-top: 12px;
    padding: 0 12px;
  }

  .mt-section__head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .mt-section__title {
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: #141416;
    padding: 4px 0;
  }

  /* 历史记录标题：与右侧刷新图标同色（#6b6a75），弱化「历史」的存在感 */
  .mt-section__title--muted {
    color: #6b6a75;
  }

  /* 标题 + 紧跟其后的说明：「进行中的会议 可直接入会」（同一个左对齐组，不贴右边） */
  .mt-section__lead {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  /* 区块标题右侧的说明（PC `.meeting-section-note`：进行中 →「可直接入会」）
     ★margin-left 就是用户要的那个「空格」：4px ≈ 14px 标题字号下的一个词间距，
       比塞一个真实空格稳定（App 端多空格会被折叠/吃掉）。 */
  .mt-section__note {
    margin-left: 4px;
    font-size: 11px;
    line-height: 16px;
    color: #9a9aa2;
  }

  /* 刷新按钮：图标热区 32x32（文字改图标后靠 padding 撑点击范围，纯图标 16px 太难点） */
  .mt-section__refresh {
    width: 32px;
    height: 32px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mt-section__refresh--busy {
    opacity: 0.4;
  }

  /* 刷新图标（static/icons/refresh_meeting.svg，色 #6b6a75，与左侧标题同色）。
     ★不再用 border + transform 手拼：那版箭头与弧线只是「理论相切」，各端对
       border-radius 缺口角度 / 旋转舍入的处理不同，实际渲染接不上。改由 svg 承载
       几何——弧线端点的径向切面与箭头底边是同一条直线，物理上不可能断开。
     18px 是因为 svg 画布 20 单位、墨迹只占 16.4 单位，放大后视觉尺寸≈原来的 16px 字形。 */
  .mt-refresh {
    width: 18px;
    height: 18px;
  }

  .mt-card {
    margin-top: 8px;
    padding: 12px;
    background-color: #ffffff;
    border-radius: 12px;
  }

  /* 进行中：左侧 3px 绿条（PC `.meeting-schedule.is-live` 同款），一眼能从预约卡里分出来 */
  .mt-card--live {
    border-left: 3px solid #0f9d58;
  }

  .mt-card__body {
    display: flex;
    flex-direction: column;
  }

  .mt-card__head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  /* ★截断：模板侧 :lines="1" 出省略号，但还需要这里「能收缩」——
     flex:1 + min-width:0（不加 min-width 时长标题会把右侧状态 Tag 挤出圆角外，
     uni-app x 的 flex 子项默认 min-width:auto，同 shared-home-tools 的教训） */
  .mt-card__title {
    flex: 1;
    min-width: 0;
    font-size: 15px;
    line-height: 20px;
    font-weight: 600;
    color: #141416;
  }

  .mt-card__title--muted {
    font-weight: 400;
    color: rgba(21, 23, 31, 0.8);
  }

  .mt-card__meta {
    margin-top: 4px;
    font-size: 12px;
    line-height: 17px;
    color: rgba(21, 23, 31, 0.5);
  }

  /* 预约卡的「会议号 xxx」行：与时间分两行（挤一行时末尾的号会被截掉，
     而会议号恰恰是这张卡上唯一要念给别人听的） */
  .mt-card__norow {
    margin-top: 4px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .mt-card__nolabel {
    font-size: 12px;
    line-height: 18px;
    color: rgba(21, 23, 31, 0.5);
    margin-right: 6px;
    flex-shrink: 0;
  }

  .mt-card__no {
    font-size: 12px;
    line-height: 18px;
    color: rgba(21, 23, 31, 0.6);
    letter-spacing: 0.4px;
    margin-right: 8px;
  }

  /* 预约卡最多 6 个操作（开始/复制/邀请/提前进入/设置/取消）：窄屏放不下一行时换行，
     仍靠右对齐（PC 的 meeting-schedule-actions 同样是右对齐 + 允许挤） */
  .mt-card__acts {
    margin-top: 10px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    row-gap: 6px;
  }

  .mt-btn {
    margin-left: 8px;
    padding: 5px 10px;
    border-radius: 14px;
    background-color: #f2f1f7;
  }

  /* 不可用（主持人关掉了提前进入）：压暗但仍可点——点了会说清原因，
     比一个点不动的按钮更好（PC 是 disabled + hover 提示，端上没有 hover） */
  .mt-btn--off {
    opacity: 0.45;
  }

  .mt-btn--active {
    opacity: 0.7;
  }

  .mt-btn--primary {
    background-color: #5147ff;
  }

  /* 图标按钮（删除）：方形小命中区，与文字按钮同高，避免 14px 图标自己撑不出可点范围 */
  .mt-btn--icon {
    width: 28px;
    height: 27px;
    padding: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  /* 垃圾桶字形左侧留白比右侧多，居中看着偏左：整体右移 2px（用户口径） */
  .mt-trash {
    transform: translateX(2px);
  }

  .mt-btn--primary-active {
    opacity: 0.8;
  }

  .mt-btn__text {
    font-size: 12px;
    line-height: 17px;
    color: #141416;
  }

  .mt-btn__text--primary {
    color: #ffffff;
  }

  .mt-tag {
    padding: 2px 8px;
    border-radius: 9px;
    background-color: #f2f1f7;
    /* 标题再长也不压缩 Tag（「录制已保存」被压成两行比截断标题更难看） */
    flex-shrink: 0;
    margin-left: 8px;
  }

  .mt-tag__text {
    font-size: 11px;
    line-height: 15px;
    color: rgba(21, 23, 31, 0.6);
  }

  /* Tag 七档配色（tone 由 applyStatus 一次算好，模板只拼类名）。
     与 PC `styles.css` 的 mtg-badge-* 同一套色：ok 绿 / running 橙 / failed 红 / none 灰。 */
  .mt-tag--pending {
    background-color: #f2f1f7;
  }

  .mt-tag__text--pending {
    color: rgba(21, 23, 31, 0.6);
  }

  /* 进行中 / 录制已保存：同一套成功色（★不合并选择器：App 端 CSS 子集对
     选择器列表的支持不如标准 CSS 稳定，两条各写一份最省心） */
  .mt-tag--live {
    background-color: #e7f6ef;
  }

  .mt-tag__text--live {
    color: #1f9e6f;
  }

  .mt-tag--ok {
    background-color: #e7f6ef;
  }

  .mt-tag__text--ok {
    color: #1f9e6f;
  }

  /* 录制中 / 录制转写中：橙（进行中的活儿，区别于"已完成"的绿） */
  .mt-tag--running {
    background-color: #fdf3e3;
  }

  .mt-tag__text--running {
    color: #d97706;
  }

  /* 录制失败：红 */
  .mt-tag--failed {
    background-color: #fdeceb;
  }

  .mt-tag__text--failed {
    color: #d83931;
  }

  .mt-tag--cancelled {
    background-color: #f7f1f1;
  }

  .mt-tag__text--cancelled {
    color: rgba(21, 23, 31, 0.6);
  }

  .mt-tag--none {
    background-color: #f2f1f7;
  }

  .mt-tag__text--none {
    color: rgba(21, 23, 31, 0.6);
  }

  .mt-state {
    margin-top: 8px;
    padding: 28px 0;
    background-color: #ffffff;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .mt-state__text {
    font-size: 13px;
    line-height: 18px;
    color: rgba(21, 23, 31, 0.45);
  }

  .mt-foot {
    padding: 12px 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .mt-foot__text {
    font-size: 12px;
    line-height: 17px;
    color: rgba(21, 23, 31, 0.4);
  }

  .mt-tail {
    height: 24px;
  }

  /* ===== 入会设置弹窗（仅主持人） ===== */
  .mp {
    padding: 4px 16px 16px 16px;
  }

  .mp-field {
    margin-top: 12px;
  }

  .mp-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .mp-label {
    font-size: 14px;
    line-height: 20px;
    color: #1c1b20;
  }

  .mp-switch {
    transform: scale(0.85);
  }

  .mp-input {
    margin-top: 8px;
    height: 40px;
    padding: 0 12px;
    border-radius: 10px;
    background-color: #f6f5f8;
    font-size: 14px;
    color: #1c1b20;
  }

  .mp-hint {
    margin-top: 6px;
    font-size: 12px;
    line-height: 17px;
    color: rgba(21, 23, 31, 0.5);
  }

  .mp-actions {
    margin-top: 20px;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
  }

  .mp-btn {
    margin-left: 8px;
    padding: 7px 14px;
    border-radius: 16px;
    background-color: #f2f1f7;
  }

  .mp-btn--active {
    opacity: 0.7;
  }

  /* 主操作（保存）用黑色，与「发起/加入/预约」三页的黑色主按钮同一口径 */
  .mp-btn--primary {
    background-color: #111111;
  }

  .mp-btn--primary-active {
    opacity: 0.8;
  }

  .mp-btn--busy {
    opacity: 0.6;
  }

  .mp-btn__text {
    font-size: 13px;
    line-height: 18px;
    color: #141416;
  }

  .mp-btn__text--primary {
    color: #ffffff;
  }
</style>
