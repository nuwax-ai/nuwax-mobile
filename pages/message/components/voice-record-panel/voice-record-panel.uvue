  width: 96rpx;
  height: 96rpx;
  background-color: #f5b942;
}

.vr-history {
  flex: 1;
}

.vr-history__empty {
  padding-top: 200rpx;
  align-items: center;
}

.vr-history__empty-text {
  font-size: 28rpx;
  color: #8e8e93;
}

.vr-history__row {
