/** 与 PC meetingReplay.ts 对齐：原始录像与转写派生音频不是两段回放。 */
export class MeetingReplayFile {
  id: string = "";
  name: string = "";
  contentType: string = "";
  status: number = 1;
  stateText: string = "";
  durationSec: number = 0;
  sizeBytes: number = 0;
  meta: string = "";
  isVideo: boolean = false;
}

export function meetingReplayKind(name: string, contentType: string): string {
  const mime = contentType.toLowerCase();
  if (mime.startsWith("video/")) return "video";
  if (mime.startsWith("audio/")) return "audio";
  const lower = name.toLowerCase();
  const dot = lower.lastIndexOf(".");
  const ext = dot >= 0 ? lower.substring(dot + 1) : "";
  if (["mp4", "mov", "webm", "mkv", "m4v"].includes(ext)) return "video";
  if (["ogg", "m4a", "mp3", "wav", "aac", "opus", "flac"].includes(ext)) return "audio";
  return "";
}

function replayLocalName(name: string): string {
  const slash = Math.max(name.lastIndexOf("/"), name.lastIndexOf("\\"));
  return name.substring(slash + 1).trim();
}

function replaySegmentName(name: string): string {
  const local = replayLocalName(name);
  const dot = local.lastIndexOf(".");
  let base = dot > 0 ? local.substring(0, dot) : local;
  if (base.endsWith("-音频")) base = base.substring(0, base.length - 3);
  return base.trim();
}

export function visibleMeetingReplayFiles(files: MeetingReplayFile[]): MeetingReplayFile[] {
  const result: MeetingReplayFile[] = [];
  for (let i = 0; i < files.length; i++) {
    const file = files[i];
    let derived = false;
    if (meetingReplayKind(file.name, file.contentType) == "audio") {
      derived = replayLocalName(file.name).indexOf("-音频.") >= 0;
      const base = replaySegmentName(file.name);
      for (let j = 0; !derived && base.length > 0 && j < files.length; j++) {
        const other = files[j];
        derived = other.id != file.id && other.isVideo && replaySegmentName(other.name) == base;
      }
    }
    if (!derived) result.push(file);
  }
  // 源录像被删除、仅剩音频时仍保留能播放的内容，和 PC 的兜底一致。
  return result.length > 0 ? result : files;
}

/** 签名链接不能通过路由反复编解码；播放页用文件 ID 现签。 */
export function meetingReplayVideoRoute(meetingId: string, fileId: string, seekSec: number = 0): string {
  return `/subpackages/pages/im-meeting/im-meeting-replay?id=${encodeURIComponent(meetingId)}` +
    `&fileId=${encodeURIComponent(fileId)}&seek=${Math.max(0, Math.floor(seekSec))}`;
}

export function meetingReplaySignedUrl(data: UTSJSONObject, download: boolean): string {
  const primary = data[download ? "downloadUrl" : "playUrl"];
  const value = primary != null ? `${primary}` : "";
  if (value.length > 0) return value;
  // 兼容老服务端 url；不能把非主持人的 playUrl 当下载地址绕过权限。
  const legacy = data["url"];
  return legacy != null ? `${legacy}` : "";
}
