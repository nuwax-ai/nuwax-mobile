import { toI18nParams, t as translateFn } from "@/utils/i18n";

/**
 * 「添加群成员」的结果 → 界面上的一句话（对齐 PC nuwax-im-web `lib/memberAdd.ts` 的
 * {@code addMembersOutcome}，逐条同判据）。
 *
 * <h2>★为什么不能只有「已添加 / 已发申请」两句话</h2>
 * 服务端一次「加 5 个人」可能落在三种**互不相同**的结局上，其中两种都是
 * 「一个成员行也没新增」：
 * <ul>
 *   <li>{@code applied > 0} —— 整批转成入群申请单，等<b>群主/管理员</b>审核；</li>
 *   <li>{@code pendingConfirm > 0} —— 逐人发出邀请卡片，等<b>被邀请人本人</b>点同意；</li>
 *   <li>{@code inserted / revived / alreadyIn} —— 有人真的在群里了。</li>
 * </ul>
 * ★判据必须是 {@code applied > 0}，**不是** {@code inserted == 0}：「三个人本来就都在群里」
 *   同样让 inserted 为 0，但那是办成了，说成「已提交申请、等待审核」就是在撒谎。
 * ★{@code pendingConfirm} 与 {@code inserted} **可以同时非零**（服务端逐个分流：
 *   同团队的直接进、不同团队的等本人同意）⇒ 这两种话都要说，不是二选一。
 *
 * <h2>★两个「没办成」的名单不是一回事</h2>
 * {@code failedUserIds} = 这个人加不了（账号停用/注销、无权限），重试也没用；
 * {@code skippedUserIds} = 冷却期（刚被拒绝），过一阵还能试。
 * 合成一句「失败，请重试」会让用户对着同一堵墙反复撞。
 */

/** 单计数文案。 */
function countText(key: string, count: number): string {
  const params = new Map<string, string | number>();
  params.set("count", count);
  return translateFn(key, toI18nParams(params), "");
}

/** 双计数文案（「已加入（新插入 X，已在群 Y）」）。 */
function joinedText(inserted: number, alreadyIn: number): string {
  const params = new Map<string, string | number>();
  params.set("inserted", inserted);
  params.set("alreadyIn", alreadyIn);
  return translateFn("Mobile.Message.groupAddOutcomeJoined", toI18nParams(params), "");
}

/**
 * 把 {@code AddMembersResult} 的计数翻译成一句提示。
 *
 * @param inserted 真正新增的成员行数
 * @param revived 曾退群、本次复活的成员行数
 * @param alreadyIn 本来就在群里的人数（不是失败）
 * @param applied 转为入群申请的人数（等群主/管理员审核）
 * @param pendingConfirm 已发邀请、等被邀请人本人同意的人数
 * @param failed 加不进去的人数（failedUserIds.length）
 * @param skipped 冷却期内被跳过的人数（skippedUserIds.length）
 */
export function groupAddOutcomeText(
  inserted: number,
  revived: number,
  alreadyIn: number,
  applied: number,
  pendingConfirm: number,
  failed: number,
  skipped: number,
): string {
  if (applied > 0) {
    let text = countText("Mobile.Message.groupAddOutcomeApplied", applied);
    if (skipped > 0) {
      text += countText("Mobile.Message.groupAddOutcomeAppliedSkipped", skipped);
    }
    if (failed > 0) {
      text += countText("Mobile.Message.groupAddOutcomeAppliedFailed", failed);
    }
    return text;
  }
  // ★本次有没有人真的进群：三个来源都算（不能只看 inserted —— 全都在群里也是办成了）
  const direct = inserted + revived + alreadyIn;
  let text = "";
  if (pendingConfirm > 0 && direct == 0) {
    // 谁都没进、只有等对方同意的 ⇒ 绝不能沿用「已加入（新插入 0，已在群 0）」
    text = countText("Mobile.Message.groupAddOutcomePendingOnly", pendingConfirm);
  } else {
    text = joinedText(inserted, alreadyIn);
    if (pendingConfirm > 0) {
      text += countText("Mobile.Message.groupAddOutcomeJoinedPending", pendingConfirm);
    }
  }
  if (failed > 0) {
    text += countText("Mobile.Message.groupAddOutcomeFailed", failed);
  }
  if (skipped > 0) {
    text += countText("Mobile.Message.groupAddOutcomeSkipped", skipped);
  }
  return text;
}
