import { showToastOverlay, hideToastOverlay } from './TextToast.ets';

/** 窗口不可用时交回框架显示，避免业务提示丢失。 */
export function showTextToast(title: string, maxWidth: number, duration: number): boolean {
  try {
    const context = UTSHarmony.getCurrentWindow().getUIContext();
    return showToastOverlay(context, title, maxWidth, duration);
  } catch (_error) {
    return false;
  }
}

export function hideTextToast(): void {
  hideToastOverlay();
}
