/**
 * App ASR WebSocket 客户端。
 * 协议：start → asr_ready → Binary PCM16 → stop → asr_result
 *
 * 生命周期（一问一答 / 按下说话）：
 * - 按下录音 → begin() 新建连接并 start
 * - 收到 asr_result / abort / 失败 → 关闭连接（不回收待命、不进页长连）
 */
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { API_BASE_URL } from "@/constants/config";
import { SpeechWsKeepalive } from "./speechWsKeepalive";

export const ASR_SAMPLE_RATE = 16000;
export const ASR_FRAME_DURATION_MS = 20;
/** 16kHz * 20ms * 2 bytes = 640 */
export const ASR_FRAME_BYTES = 640;

export type AsrReadyCallback = () => void;
export type AsrResultCallback = (
  text: string,
  ok: boolean,
  errorMessage: string,
) => void;
export type AsrErrorCallback = (message: string) => void;

function createAsrWebSocketUrl(token: string): string {
  let baseUrl = API_BASE_URL;
  if (baseUrl.startsWith("https://")) {
    baseUrl = "wss://" + baseUrl.substring(8);
  } else if (baseUrl.startsWith("http://")) {
    baseUrl = "ws://" + baseUrl.substring(7);
  }
  let url = baseUrl + "/api/speech/asr/ws";
  // 与 TTS 一致：仅 H5/WEB 用 Query；App（含 iOS）走 Authorization Header。
  // iOS 若只拼 access_token 易被网关 401（Starscream notAnUpgrade）。
  // #ifdef H5 || WEB
  const encodedTokenRaw = encodeURIComponent(token);
  const encodedToken = encodedTokenRaw != null ? encodedTokenRaw : token;
  url += "?access_token=" + encodedToken;
  // #endif
  return url;
}

function createAsrWebSocketHeaders(token: string): UTSJSONObject {
  const header = new UTSJSONObject();
  header["Authorization"] = "Bearer " + token;
  return header;
}

/**
 * H5：从 document.cookie 读取指定 key（仅非 HttpOnly 可读）。
 */
function readCookie(name: string): string {
  // #ifdef H5 || WEB
  try {
    const raw = document.cookie;
    if (raw == null || raw.length == 0) {
      return "";
    }
    const parts = raw.split(";");
    const prefix = name + "=";
    for (let i = 0; i < parts.length; i++) {
      let part = parts[i];
      while (part.length > 0 && part.charAt(0) == " ") {
        part = part.substring(1);
      }
      if (part.indexOf(prefix) == 0) {
        const value = part.substring(prefix.length);
        const decodedRaw = decodeURIComponent(value);
        return decodedRaw != null ? decodedRaw : value;
      }
    }
  } catch (_e) {
    // ignore
  }
  // #endif
  return "";
}

/** 去掉 Bearer 前缀 */
function normalizeAccessToken(token: string): string {
  if (token.startsWith("Bearer ")) {
    return token.substring(7);
  }
  return token;
}

/**
 * 解析 ASR 鉴权 Token（与 TTS 一致）。
 * H5：优先 Cookie（ACCESS_TOKEN / access_token），否则回退本地 storage。
 * iOS：key 不存在时 getStorageSync 可能抛「返回值为 undefined」，必须 try-catch。
 */
function readAccessToken(): string {
  // #ifdef H5 || WEB
  let cookieToken = readCookie(ACCESS_TOKEN);
  if (cookieToken.length == 0) {
    cookieToken = readCookie("access_token");
  }
  if (cookieToken.length > 0) {
    return normalizeAccessToken(cookieToken);
  }
  // #endif
  try {
    const tokenRaw = uni.getStorageSync(ACCESS_TOKEN);
    if (tokenRaw == null) {
      return "";
    }
    const asStr = `${tokenRaw}`;
    if (asStr.length == 0 || asStr == "undefined" || asStr == "null") {
      return "";
    }
    return normalizeAccessToken(asStr);
  } catch (_eStorage) {
    return "";
  }
}

/** 等待 asr_ready 超时（建连 + start），避免假死卡在「识别中」 */
const ASR_READY_TIMEOUT_MS: number = 15000;
/** 已发 stop 后等待 asr_result 超时 */
const ASR_RESULT_TIMEOUT_MS: number = 25000;

export class AsrWebSocketClient {
  private socketTask: SocketTask | null = null;
  private generation: number = 0;
  /** 已收到 asr_ready，可发音频 */
  private ready: boolean = false;
  /** TCP 已 open，尚未 asr_ready（含预热待命 / 已发 start 等待中） */
  private socketOpen: boolean = false;
  /** 正在建连 */
  private connecting: boolean = false;
  /** 已发 start，等待 asr_ready */
  private starting: boolean = false;
  private onReadyCb: AsrReadyCallback | null = null;
  private onResultCb: AsrResultCallback | null = null;
  private onErrorCb: AsrErrorCallback | null = null;
  private warmupEnabled: boolean = false;
  /** TCP 预热待命（open 且未 start） */
  private warmIdle: boolean = false;
  /** 连接成功后的心跳保活（预热 / 业务会话共用） */
  private keepalive: SpeechWsKeepalive = new SpeechWsKeepalive();
  /** 等待 asr_ready 的超时定时器 */
  private readyTimeoutId: number = 0;
  /** 等待 asr_result 的超时定时器 */
  private resultTimeoutId: number = 0;

  isReady(): boolean {
    return this.ready == true && this.socketTask != null;
  }

  /** 是否有可复用的预热 TCP（未 start） */
  isWarmOpen(): boolean {
    return (
      this.warmIdle == true &&
      this.socketOpen == true &&
      this.socketTask != null &&
      this.ready == false
    );
  }

  /**
   * 兼容旧调用：ASR 不再进页预连。
   * 仅标记允许页内生命周期；真正建连由 begin() 完成。
   */
  enableWarmupAndConnect(): void {
    this.warmupEnabled = true;
    // 故意不 connectWarmTcp：随录随建，避免空闲长连
  }

  /** 离开页面 / 进后台：关闭 ASR 连接 */
  disableWarmupAndDisconnect(): void {
    this.warmupEnabled = false;
    this.warmIdle = false;
    this.keepalive.resume();
    this.keepalive.resetServerReject();
    this.abortInternal(true);
  }

  /** SSE 进行中暂停 ASR 心跳（不断连） */
  pauseKeepalive(): void {
    this.keepalive.pause();
  }

  /** SSE 结束后恢复 ASR 心跳 */
  resumeKeepalive(): void {
    this.keepalive.resume();
  }

  /**
   * 开始一轮识别：优先复用尚未 start 的 TCP；否则新建连接。
   * 防重连风暴：connecting / 已有 socket 时只挂回调，不二次 connectSocket。
   * 注意：不在此处启动 ready 超时——长按录音可能超过超时窗口；
   * 松手后仍未 ready 时由 watchReadyAfterStop() 启动。
   */
  begin(
    onReady: AsrReadyCallback,
    onResult: AsrResultCallback,
    onError: AsrErrorCallback,
  ): void {
    this.onReadyCb = onReady;
    this.onResultCb = onResult;
    this.onErrorCb = onError;
    this.clearResultTimeout();
    this.clearReadyTimeout();

    // 业务会话已 asr_ready（极少见）：直接开录
    if (this.isReady() == true && this.warmIdle == false) {
      onReady();
      return;
    }

    // 已有 open 且未 start：发 start，等 asr_ready（不 connectSocket）
    if (this.isWarmOpen() == true) {
      this.warmIdle = false;
      this.starting = true;
      this.sendJsonStart();
      return;
    }

    // 建连中：挂好回调，等 open 后由 onOpen 发 start
    if (this.connecting == true && this.socketTask != null) {
      this.warmIdle = false;
      return;
    }

    this.connectForSession(onReady, onResult, onError);
  }

  /**
   * 松手时录音已结束但尚未 asr_ready：启动 ready 看门狗。
   * 超时走 fail → 录音按钮复位，避免一直停在「识别中」。
   */
  watchReadyAfterStop(): void {
    if (this.ready == true) {
      this.clearReadyTimeout();
      return;
    }
    this.armReadyTimeout();
  }

  private clearReadyTimeout(): void {
    if (this.readyTimeoutId != 0) {
      clearTimeout(this.readyTimeoutId);
      this.readyTimeoutId = 0;
    }
  }

  private clearResultTimeout(): void {
    if (this.resultTimeoutId != 0) {
      clearTimeout(this.resultTimeoutId);
      this.resultTimeoutId = 0;
    }
  }

  private clearAllTimeouts(): void {
    this.clearReadyTimeout();
    this.clearResultTimeout();
  }

  /** 等待 asr_ready；到期走 fail → 录音按钮 onError 复位 UI */
  private armReadyTimeout(): void {
    this.clearReadyTimeout();
    const expectedGeneration = this.generation;
    this.readyTimeoutId = setTimeout((): void => {
      this.readyTimeoutId = 0;
      if (expectedGeneration != this.generation) {
        return;
      }
      if (this.ready == true) {
        return;
      }
      this.fail("ASR 连接超时，请重试");
    }, ASR_READY_TIMEOUT_MS) as number;
  }

  /** 已发 stop 后等待 asr_result */
  private armResultTimeout(): void {
    this.clearResultTimeout();
    const expectedGeneration = this.generation;
    this.resultTimeoutId = setTimeout((): void => {
      this.resultTimeoutId = 0;
      if (expectedGeneration != this.generation) {
        return;
      }
      this.fail("ASR 识别超时，请重试");
    }, ASR_RESULT_TIMEOUT_MS) as number;
  }

  /** 业务：open 后立即 start */
  private connectForSession(
    onReady: AsrReadyCallback,
    onResult: AsrResultCallback,
    onError: AsrErrorCallback,
  ): void {
    this.openSocket(false, onReady, onResult, onError);
  }

  /**
   * @param warmOnly true=预热（open 后不 start）；false=业务（open 后 start）
   */
  private openSocket(
    warmOnly: boolean,
    onReady: AsrReadyCallback,
    onResult: AsrResultCallback,
    onError: AsrErrorCallback,
  ): void {
    // 已有存活连接：禁止再 connectSocket，只更新回调与角色
    if (this.socketTask != null && this.socketOpen == true) {
      this.onReadyCb = onReady;
      this.onResultCb = onResult;
      this.onErrorCb = onError;
      this.warmIdle = warmOnly;
      this.ready = false;
      this.starting = false;
      this.connecting = false;
      if (warmOnly == true) {
        return;
      }
      this.starting = true;
      this.sendJsonStart();
      return;
    }
    // 建连中：挂回调，open 后按 warmIdle 决定是否 start
    if (this.connecting == true && this.socketTask != null) {
      this.onReadyCb = onReady;
      this.onResultCb = onResult;
      this.onErrorCb = onError;
      this.warmIdle = warmOnly;
      return;
    }
    // 仅此时允许新建：先清掉残留引用（socket 已死），不主动 close 第二次
    if (this.socketTask != null) {
      this.socketTask = null;
    }
    this.generation += 1;
    const expectedGeneration = this.generation;
    this.onReadyCb = onReady;
    this.onResultCb = onResult;
    this.onErrorCb = onError;
    this.ready = false;
    this.socketOpen = false;
    this.starting = false;
    this.connecting = true;
    this.warmIdle = warmOnly;

    const accessToken = readAccessToken();
    if (accessToken.length == 0) {
      this.connecting = false;
      this.fail("登录状态已失效");
      return;
    }

    let socketTask: SocketTask;
    // #ifdef H5 || WEB
    socketTask = uni.connectSocket({
      url: createAsrWebSocketUrl(accessToken),
      fail: (err) => {
        if (expectedGeneration != this.generation) {
          return;
        }
        this.connecting = false;
        this.fail(err.errMsg != null ? `${err.errMsg}` : "ASR 连接失败");
      },
    });
    // #endif
    // #ifndef H5 || WEB
    socketTask = uni.connectSocket({
      url: createAsrWebSocketUrl(accessToken),
      header: createAsrWebSocketHeaders(accessToken),
      fail: (err) => {
        if (expectedGeneration != this.generation) {
          return;
        }
        this.connecting = false;
        this.fail(err.errMsg != null ? `${err.errMsg}` : "ASR 连接失败");
      },
    });
    // #endif
    this.socketTask = socketTask;

    socketTask.onOpen((_res) => {
      if (expectedGeneration != this.generation) {
        return;
      }
      this.connecting = false;
      this.socketOpen = true;
      this.startKeepalive();
      // 预热建连过程中用户已 begin：warmIdle 会被 begin 清掉，此处应发 start
      if (this.warmIdle == true) {
        const cb = this.onReadyCb;
        // 预热 onReady 仅用于标记待命，不触发录音
        if (cb != null && warmOnly == true) {
          cb();
        }
        return;
      }
      this.starting = true;
      this.sendJsonStart();
    });
    socketTask.onMessage((res: OnSocketMessageCallbackResult) => {
      if (expectedGeneration != this.generation) {
        return;
      }
      this.handleMessage(res);
    });
    socketTask.onError((err) => {
      if (expectedGeneration != this.generation || this.socketTask == null) {
        return;
      }
      this.connecting = false;
      this.fail(err.errMsg != null ? `${err.errMsg}` : "ASR WebSocket 错误");
    });
    socketTask.onClose((_res) => {
      if (expectedGeneration != this.generation) {
        return;
      }
      this.stopKeepalive();
      this.ready = false;
      this.connecting = false;
      this.socketOpen = false;
      this.starting = false;
      this.warmIdle = false;
      this.socketTask = null;
      // ASR 用完即关：对端关闭后不再自动重连，等下次 begin
    });
  }

  /** WebSocket 已 open：启动 / 刷新心跳 */
  private startKeepalive(): void {
    this.keepalive.start("ASR", (payloadJson: string): boolean => {
      const socket = this.socketTask;
      if (socket == null || this.socketOpen != true) {
        return false;
      }
      try {
        socket!.send({ data: payloadJson });
        return true;
      } catch (_eSend) {
        return false;
      }
    });
  }

  private stopKeepalive(): void {
    this.keepalive.stop();
  }

  sendPcm(frame: ArrayBuffer): void {
    this.sendPcmAsync(frame).then(
      (_ok: boolean) => {},
      (_e: any | null) => {},
    );
  }

  /**
   * 发送一帧 PCM，等原生 send success 后再 resolve。
   * 文件推流必须用这个，避免 stop 抢在 binary 之前发出。
   */
  sendPcmAsync(frame: ArrayBuffer): Promise<boolean> {
    if (this.ready != true || this.socketTask == null) {
      return Promise.resolve(false);
    }
    if (frame.byteLength == 0) {
      return Promise.resolve(true);
    }
    const socket = this.socketTask!;
    return new Promise<boolean>((resolve) => {
      socket.send({
        data: frame,
        success: (_res) => {
          resolve(true);
        },
        fail: (err) => {
          console.warn(
            "[ASR] sendPcm fail " +
              (err.errMsg != null ? `${err.errMsg}` : ""),
          );
          resolve(false);
        },
      });
    });
  }

  finish(): void {
    if (this.socketTask == null) {
      this.fail("ASR 连接不存在");
      return;
    }
    const payload = new UTSJSONObject();
    payload["type"] = "stop";
    const socket = this.socketTask!;
    // 先挂结果超时：即使 send success 回调缺失，也不会永远停在 uploading
    this.armResultTimeout();
    try {
      socket.send({
        data: JSON.stringify(payload),
        fail: (err) => {
          this.fail(
            err.errMsg != null ? `${err.errMsg}` : "ASR stop 发送失败",
          );
        },
      });
    } catch (e) {
      this.fail("ASR stop 发送失败");
    }
  }

  /**
   * 取消本轮识别并关闭连接（录完即关 / 用户取消）。
   */
  abort(): void {
    this.abortInternal(true);
  }

  /**
   * 一轮识别结束后关闭连接（不再回收待命长连）。
   * bump generation，忽略关连过程中迟到的 onMessage/onClose 副作用。
   */
  private closeAfterSession(): void {
    this.abortInternal(true);
  }

  /**
   * 真正关连。
   */
  private abortInternal(bumpGeneration: boolean): void {
    if (bumpGeneration) {
      this.generation += 1;
    }
    this.clearAllTimeouts();
    this.stopKeepalive();
    this.ready = false;
    this.connecting = false;
    this.socketOpen = false;
    this.starting = false;
    this.warmIdle = false;
    this.onReadyCb = null;
    this.onResultCb = null;
    this.onErrorCb = null;
    const socket = this.socketTask;
    this.socketTask = null;
    if (socket != null) {
      try {
        socket!.close({});
      } catch (_eClose) {
        // ignore
      }
    }
  }

  private sendJsonStart(): void {
    const payload = new UTSJSONObject();
    payload["type"] = "start";
    payload["sample_rate"] = ASR_SAMPLE_RATE;
    payload["frame_duration_ms"] = ASR_FRAME_DURATION_MS;
    if (this.socketTask == null) {
      return;
    }
    this.socketTask!.send({ data: JSON.stringify(payload) });
  }

  private handleMessage(res: OnSocketMessageCallbackResult): void {
    if (typeof res.data != "string") {
      return;
    }
    let message: UTSJSONObject | null = null;
    try {
      message = JSON.parse(`${res.data}`) as UTSJSONObject;
    } catch (_eJson) {
      this.fail("ASR 返回了无效消息");
      return;
    }
    if (message == null) {
      return;
    }
    const typeVal = message["type"];
    const type = typeVal != null ? `${typeVal}` : "";
    if (type == "ping" || type == "pong") {
      // 心跳应答，忽略
      return;
    }
    if (type == "asr_ready") {
      this.clearReadyTimeout();
      this.ready = true;
      this.connecting = false;
      this.starting = false;
      this.warmIdle = false;
      const cb = this.onReadyCb;
      if (cb != null) {
        cb();
      }
    } else if (type == "asr_result") {
      this.clearResultTimeout();
      const textVal = message["text"];
      const text = textVal != null ? `${textVal}` : "";
      const okVal = message["ok"];
      let ok = true;
      if (okVal != null) {
        ok = `${okVal}` == "true" || okVal == true;
      }
      const errVal = message["error"];
      const errorMessage = errVal != null ? `${errVal}` : "";
      const cb = this.onResultCb;
      // 识别结束：先关连再回调（随录随关）
      this.closeAfterSession();
      if (cb != null) {
        cb(text, ok, errorMessage);
      }
    } else if (type == "error") {
      const codeVal = message["code"];
      const msgVal = message["message"];
      const code = codeVal != null ? `${codeVal}` : "";
      const msg = msgVal != null ? `${msgVal}` : "ASR 错误";
      // 服务端拒识 ping：心跳仍继续（网关保活），此处仅降噪
      if (
        code == "UNKNOWN_TYPE" &&
        (msg.indexOf("ping") >= 0 || msg.indexOf("pong") >= 0)
      ) {
        this.keepalive.markRejectedByServer();
        return;
      }
      this.fail(code.length > 0 ? code + ": " + msg : msg);
    }
  }

  /**
   * 业务失败：通知回调并关闭连接。
   */
  private fail(message: string): void {
    console.error("[ASR] fail " + message);
    const cb = this.onErrorCb;
    this.closeAfterSession();
    if (cb != null) {
      cb(message);
    }
  }
}

export const asrWebSocketClient = new AsrWebSocketClient();
