/** 用户选中的文件（沙盒临时路径、文件名）。 */
export type IosFilePickedCallback = (path: string, name: string) => void;

/** 文件选择器失败或取消。 */
export type IosFileFailureCallback = (code: string, message: string) => void;

/** 打开 iOS 系统文件选择器。 */
export type PickIosFilesApi = (
  onPicked: IosFilePickedCallback,
  onFail: IosFileFailureCallback,
) => void;
