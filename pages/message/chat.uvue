  }

  .chat-ava-letter {
    font-size: 32rpx;
    line-height: 40rpx;
    font-weight: 600;
    color: #ffffff;
  }

  .chat-col {
    flex: 1;
    min-width: 0;
    margin: 0 20rpx;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .chat-col--mine {
    align-items: flex-end;
  }

  .chat-name {
    align-self: flex-start;
    max-width: 480rpx;
    margin-bottom: 12rpx;
