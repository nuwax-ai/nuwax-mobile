<template>
  <view class="tab-shell-stage">
    <view
      v-if="partnerVoiceAlive"
      class="tab-shell-record"
      :style="recordStyle"
      @touchstart="handleDismissTouchStart"
      @touchmove="handleDismissTouchMove"
      @touchend="handleDismissTouchEnd"
      @touchcancel="handleDismissTouchEnd"
    >
      <voice-record-panel @close="handleVoicePanelClose()" @recording-change="handleVoiceRecordingChange($event)" />
    </view>
    <view class="tab-shell-foreground" :style="foregroundStyle">
  <uni-tab class="tab-shell" :style="safeAreaStyle" :active-index="activeIndex" @change="handleTabChange">
    <uni-tab-content><MessageContent /></uni-tab-content>
    <uni-tab-content><UnionRecordContent /></uni-tab-content>
    <uni-tab-content><DiscoverContent /></uni-tab-content>
    <uni-tab-content><MineContent /></uni-tab-content>
    <common-tab-bar :active-path="mainTabActivePath" :bottom-inset="safeArea.bottom" />
    <!-- #ifdef APP -->
    <!-- 首帧揭幕蒙层：冷启动 window insets 未就绪，首帧 tab 栏偏低、onReady 校正时整栏上跳。
         蒙层盖住首帧（白底与 launch 页/页面背景连续），与校正后的 inset 同一渲染帧揭幕，
         用户只见终态。仅存在 1~2 帧，无可交互诉求。 -->
    <view v-if="settleMaskVisible" class="tab-shell__settle-mask" />
    <!-- #endif -->
  </uni-tab>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, onUnmounted, ref, watch } from "vue";
  import { onLoad, onShow, onHide, onReady, onBackPress, onResize } from "@dcloudio/uni-app";
  import MessageContent from "@/pages/message/message-content.uvue";
  import UnionRecordContent from "@/pages/union-record/union-record-content.uvue";
  import DiscoverContent from "@/pages/discover/discover-content.uvue";
  import MineContent from "@/pages/mine/mine-content.uvue";
  import { MAIN_TAB_PATHS, mainTabActivePath, mainTabPageVisible, isMainTabPath, selectMainTab, syncMainTabLocation } from "@/utils/mainTabNavigation";
  import { dispatchMainTabBack, dispatchMainTabResize } from "@/hooks/useMainTabLifecycle";
  import { syncNativeTabBarState } from "@/utils/commonBusiness";
  import { readMainTabSafeArea, type MainTabSafeArea } from "@/utils/mainTabSafeArea";
  import { maybePromptProfileSetup } from "@/utils/profileSetupPrompt";
  import VoiceRecordPanel from "@/pages/message/components/voice-record-panel/voice-record-panel.uvue";
  import {
    beginPartnerVoiceDrag,
    closePartnerVoiceDrawer,
    endPartnerVoiceDrag,
    movePartnerVoiceDrag,
    partnerVoiceAlive,
    partnerVoiceDragging,
    partnerVoiceMaxOffset,
    partnerVoiceOffset,
    partnerVoiceOpen,
    setPartnerVoiceRecording,
  } from "@/utils/partnerVoiceDrawer";

  const activeIndex = computed((): number => MAIN_TAB_PATHS.indexOf(mainTabActivePath.value));
  const foregroundStyle = computed((): string => {
    const offset = partnerVoiceOffset.value;
    const duration = partnerVoiceDragging.value ? 0 : 280;
    return `transform: translateX(${offset}px); transition-property: transform; transition-duration: ${duration}ms; transition-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);`;
  });
  const recordStyle = computed((): string => {
    const info = uni.getWindowInfo();
    const width = info.windowWidth;
    const max = width > 0 ? width : 1;
    const progress = partnerVoiceOffset.value / max;
    // 微信页面切换：底层从左侧约 35% 处跟手滑入，前景走满一屏时底层回到原位。
    const shift = (progress - 1) * max * 0.35;
    const duration = partnerVoiceDragging.value ? 0 : 280;
    const insets = info.safeAreaInsets;
    const topInset = insets != null ? insets.top : 0;
    return `padding-top: ${topInset}px; transform: translateX(${shift}px); transition-property: transform; transition-duration: ${duration}ms; transition-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);`;
  });

  function touchPointX(eventValue: Any): number {
    const e = eventValue as UniTouchEvent;
    if (e.touches.length > 0) {
      return e.touches[0].screenX;
    }
    if (e.changedTouches != null && e.changedTouches.length > 0) {
      return e.changedTouches[0].screenX;
    }
    return -1;
  }

  function touchPointY(eventValue: Any): number {
    const e = eventValue as UniTouchEvent;
    if (e.touches.length > 0) {
      return e.touches[0].screenY;
    }
    if (e.changedTouches != null && e.changedTouches.length > 0) {
      return e.changedTouches[0].screenY;
    }
    return -1;
  }

  function handleDismissTouchStart(eventValue: Any): void {
    const x = touchPointX(eventValue);
    const y = touchPointY(eventValue);
    if (x < 0 || y < 0) {
      return;
    }
    beginPartnerVoiceDrag(x, y);
  }

  function handleDismissTouchMove(eventValue: Any): void {
    const x = touchPointX(eventValue);
    const y = touchPointY(eventValue);
    if (x < 0 || y < 0) {
      return;
    }
    const claimed = movePartnerVoiceDrag(x, y);
    if (claimed) {
      const e = eventValue as UniTouchEvent;
      e.preventDefault();
      e.stopPropagation();
    }
  }

  function handleDismissTouchEnd(eventValue: Any): void {
    endPartnerVoiceDrag(touchPointX(eventValue), touchPointY(eventValue));
  }

  function handleVoicePanelClose(): void {
    closePartnerVoiceDrawer();
  }

  function handleVoiceRecordingChange(eventValue: Any): void {
    setPartnerVoiceRecording(eventValue == true);
  }
  const safeArea = ref<MainTabSafeArea>(readMainTabSafeArea());
  /** 首帧揭幕闸（App）：insets 未就绪的首帧不上屏，onReady 校正后同帧揭幕，tab 栏不再「先偏下再弹回」。 */
  const settleMaskVisible = ref<boolean>(true);
  const safeAreaStyle = computed((): string => {
    // #ifdef APP
    return `padding-left: ${safeArea.value.left}px; padding-right: ${safeArea.value.right}px;`;
    // #endif
    // #ifndef APP
    return "";
    // #endif
  });

  function handleTabChange(index: number): void {
    selectMainTab(index);
  }

  watch((): string => mainTabActivePath.value, (path: string) => {
    if (path != "/pages/message/message") closePartnerVoiceDrawer();
    if (mainTabPageVisible.value) syncMainTabLocation();
  });

  onLoad((options: OnLoadOptions) => {
    const tab = options["tab"];
    if (tab != null) {
      const path = decodeURIComponent(`${tab}`) ?? `${tab}`;
      if (isMainTabPath(path)) mainTabActivePath.value = path;
    }
  });
  onShow(() => {
    safeArea.value = readMainTabSafeArea();
    syncNativeTabBarState();
    mainTabPageVisible.value = true;
    syncMainTabLocation();
    // 新用户引导判定：未登录/拉取失败不 latch，下次 onShow 仍会重查（会话内至多一次）。
    // 弹窗改独立页（2026-10-21）：键盘让位吃页面级默认行为，背景 tab-shell 不受键盘影响
    maybePromptProfileSetup((_raw: UTSJSONObject): boolean => {
      uni.navigateTo({
        url: "/pages/profile-setup/profile-setup",
      });
      return true;
    });
  });
  onReady(() => {
    // 页面渲染完成后，窗口的手势条 Insets 才能准确取得。
    safeArea.value = readMainTabSafeArea();
    // 与上面的校正同批渲染（同一 tick 两次写入合并为一次重绘）：
    // 揭幕帧即校正后布局，蒙层之下的「偏低首帧」永远不与用户见面。
    settleMaskVisible.value = false;
  });
  onHide(() => { mainTabPageVisible.value = false; });
  onUnmounted(() => { mainTabPageVisible.value = false; });
  onBackPress((options: OnBackPressOptions): boolean => {
    if (partnerVoiceOpen.value || partnerVoiceOffset.value > 0) {
      closePartnerVoiceDrawer();
      return true;
    }
    return dispatchMainTabBack(mainTabActivePath.value, options);
  });
  onResize((options: OnResizeOptions) => {
    safeArea.value = readMainTabSafeArea();
    dispatchMainTabResize(mainTabActivePath.value, options);
  });
</script>

<style>
  /* #ifdef H5 || WEB */
  page {
    height: 100%;
    overflow: hidden;
  }
  uni-page-body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  /* #endif */
</style>

<style scoped>
  /* #ifdef APP */
  .tab-shell__settle-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 9999;
    background-color: #ffffff;
  }
  /* #endif */

  .tab-shell-stage {
    flex: 1;
    height: 100%;
    position: relative;
    overflow: hidden;
    background-color: #ffffff;
  }

  .tab-shell-record {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
  }

  .tab-shell-foreground {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #ffffff;
    box-shadow: -8px 0 18px rgba(0, 0, 0, 0.12);
  }

  .tab-shell {
    flex: 1;
    height: 100%;
    box-sizing: border-box;
    background-color: #ffffff;
    /* #ifdef H5 || WEB */
    padding-top: constant(safe-area-inset-top);
    padding-top: env(safe-area-inset-top, 0px);
    padding-left: constant(safe-area-inset-left);
    padding-left: env(safe-area-inset-left, 0px);
    padding-right: constant(safe-area-inset-right);
    padding-right: env(safe-area-inset-right, 0px);
    /* #endif */
  }
</style>
