import { callEndTranslationKey } from "./callErrors";

const HISTORY_LIMIT = 100;
const HISTORY_ID = /^[A-Za-z0-9_-]{1,128}$/;

/** Only observations made by this device; the native store is separated by origin and account. */
export class VoipHistoryRecord {
  callId: string = "";
  convId: string = "";
  peerName: string = "";
  direction: string = "";
  mediaType: string = "audio";
  startedAt: number = 0;
  connectedAt: number = 0;
  endedAt: number = 0;
  reason: string = "";
  missed: boolean = false;
}

export function parseVoipHistory(values: UTSJSONObject[]): VoipHistoryRecord[] {
  const records: VoipHistoryRecord[] = [];
  const seen: string[] = [];
  for (let i = 0; i < Math.min(values.length, HISTORY_LIMIT); i++) {
    const value = values[i];
    const row = new VoipHistoryRecord();
    row.callId = `${value["callId"] ?? ""}`;
    row.convId = `${value["convId"] ?? ""}`;
    row.direction = `${value["direction"] ?? ""}`;
    row.mediaType = `${value["mediaType"] ?? ""}`;
    row.startedAt = parseFloat(`${value["startedAt"] ?? 0}`);
    row.connectedAt = parseFloat(`${value["connectedAt"] ?? 0}`);
    row.endedAt = parseFloat(`${value["endedAt"] ?? 0}`);
    if (!HISTORY_ID.test(row.callId) || !HISTORY_ID.test(row.convId) || seen.indexOf(row.callId) >= 0) continue;
    if ((row.direction != "incoming" && row.direction != "outgoing") || (row.mediaType != "audio" && row.mediaType != "video")) continue;
    if (!Number.isFinite(row.startedAt) || !Number.isFinite(row.connectedAt) || !Number.isFinite(row.endedAt) || row.startedAt < 0 || row.connectedAt < 0 || row.endedAt < 0) continue;
    row.peerName = `${value["peerName"] ?? ""}`.slice(0, 80);
    row.reason = `${value["reason"] ?? ""}`;
    row.missed = value["missed"] === true;
    seen.push(row.callId); records.push(row);
  }
  return records;
}

export function voipChatEndTranslationKey(reason: string): string {
  if (reason == "rejected") return "Mobile.Voip.callDeclined";
  if (reason == "ended" || reason == "remoteEnded") return "Mobile.Voip.ended";
  if (reason == "timeout" || reason == "cancel" || reason == "cancelled" || reason == "remoteCancelled") return callEndTranslationKey(reason);
  return "";
}

export class VoipChatTerminal {
  callId: string = "";
  convId: string = "";
  reason: string = "";
}

function makeVoipChatTerminal(callId: string, convId: string, reason: string): VoipChatTerminal | null {
  if (!HISTORY_ID.test(callId) || !HISTORY_ID.test(convId) || voipChatEndTranslationKey(reason).length == 0) return null;
  const row = new VoipChatTerminal();
  row.callId = callId;
  row.convId = convId;
  row.reason = reason;
  return row;
}

export function readVoipChatTerminals(storageKey: string): VoipChatTerminal[] {
  const records: VoipChatTerminal[] = [];
  try {
    const raw = uni.getStorageSync(storageKey);
    if (typeof raw != "string" || raw.length == 0) return records;
    const values = JSON.parse<UTSJSONObject[]>(raw);
    if (values == null) return records;
    for (let i = 0; i < Math.min(values.length, HISTORY_LIMIT); i++) {
      const value = values[i];
      if (value == null) continue;
      const row = makeVoipChatTerminal(`${value["callId"] ?? ""}`, `${value["convId"] ?? ""}`, `${value["reason"] ?? ""}`);
      if (row != null) records.push(row);
    }
  } catch (_e) { /* Unavailable or invalid local history leaves the usual message text. */ }
  return records;
}

export function addVoipChatTerminal(records: VoipChatTerminal[], callId: string, convId: string, reason: string): VoipChatTerminal[] | null {
  const row = makeVoipChatTerminal(callId, convId, reason);
  if (row == null) return null;
  const next = records.filter((entry: VoipChatTerminal): boolean => entry.callId != callId || entry.convId != convId);
  next.unshift(row);
  return next.slice(0, HISTORY_LIMIT);
}
