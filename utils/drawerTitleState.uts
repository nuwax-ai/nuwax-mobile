/** 标题写回与列表快照之间的版本保护。只保存本次登录期间已成功写回的标题。 */
class DrawerTitleEntry {
  title: string = "";
  revision: number = 0;
  confirmed: boolean = false;
  readRevision: number = 0;
}

let titleRevision = 0;
const titles = new Map<string, DrawerTitleEntry>();

function titleKey(kind: string, id: number, projectType: string): string {
  return kind == "project" ? `project:${projectType}:${id}` : `conversation:${id}`;
}

export function getDrawerTitleRevision(): number {
  return titleRevision;
}

/** 每个列表请求独立编号，同一写回之后发出的并发请求也能比较先后。 */
export function beginDrawerTitleRead(): number {
  return ++titleRevision;
}

export function recordDrawerTitle(kind: string, id: number, title: string, projectType: string): boolean {
  if ((kind != "project" && kind != "conversation") || id != id || id <= 0 || title.trim().length == 0) return false;
  if (kind == "project" && projectType != "NormalProject" && projectType != "UserApp") return false;
  const entry = new DrawerTitleEntry();
  entry.title = title;
  entry.revision = ++titleRevision;
  titles.set(titleKey(kind, id, projectType), entry);
  return true;
}

/**
 * 写回前发出的请求永远不能覆盖新标题。写回后的请求须先读到同一标题才解除保护，
 * 防止列表读副本暂时滞后；确认后允许后续请求读入其它端的新名称。
 * 保留版本记录，避免确认之后才返回的更早请求再次覆盖。
 */
export function resolveDrawerTitle(kind: string, id: number, projectType: string, serverTitle: string, requestRevision: number): string {
  const entry = titles.get(titleKey(kind, id, projectType));
  if (entry == null) return serverTitle;
  // 内存缓存只恢复尚未确认的写回值，不能拿缓存内容当作服务端确认。
  if (requestRevision < 0) return entry.confirmed ? serverTitle : entry.title;
  if (requestRevision < entry.revision || requestRevision < entry.readRevision) return entry.title;
  if (!entry.confirmed) {
    if (serverTitle == entry.title) {
      entry.confirmed = true;
      entry.readRevision = requestRevision;
    }
    return entry.title;
  }
  entry.title = serverTitle;
  entry.readRevision = requestRevision;
  return serverTitle;
}

export function protectConversationTitles(rows: UTSJSONObject[], requestRevision: number): void {
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    const id = row["id"] != null ? parseFloat(`${row["id"]}`) : 0;
    const topic = row["topic"] != null ? `${row["topic"]}` : "";
    row["topic"] = resolveDrawerTitle("conversation", id, "", topic, requestRevision);
  }
}

export function clearDrawerTitles(): void {
  titleRevision++;
  titles.clear();
}
