import { ref } from "vue";
import { ACCESS_TOKEN } from "@/constants/home.constants";
import { hasAppPrivacyConsent } from "@/utils/appPrivacyConsent";

/** App 根页面内的界面状态。只有显式登录完成导航才进入 main，保存 Token 本身不跳过重置密码。 */
export const appEntryStage = ref<string>("privacy");
export const appEntryLoginReturn = ref<string>("");
let rootAttached = false;
let rootOwner = 0;

export function hasAppEntryToken(): boolean {
  const raw = uni.getStorageSync(ACCESS_TOKEN);
  return raw != null && `${raw}`.trim().length > 0;
}

export function resolveAppEntryStage(): string {
  if (!hasAppPrivacyConsent()) return "privacy";
  return hasAppEntryToken() ? "main" : "login";
}

export function attachAppEntry(): number {
  rootOwner += 1;
  rootAttached = true;
  appEntryLoginReturn.value = "";
  appEntryStage.value = resolveAppEntryStage();
  return rootOwner;
}

export function detachAppEntry(owner: number): void {
  if (owner != rootOwner) return;
  rootAttached = false;
}

export function activateAppEntryMain(): void {
  // #ifdef APP
  if (rootAttached) appEntryStage.value = resolveAppEntryStage();
  // #endif
}

/** 只接管栈顶根页面的登录，深层页面继续沿用原有清栈/回跳行为。 */
export function showAppEntryLogin(redirect: string): boolean {
  // #ifdef APP
  if (!rootAttached || !hasAppPrivacyConsent()) return false;
  const pages = getCurrentPages();
  const page = pages.length > 0 ? pages[pages.length - 1] : null;
  if (page == null || `/${page.route}` != "/pages/tab-shell/tab-shell") return false;
  appEntryLoginReturn.value = redirect;
  appEntryStage.value = "login";
  return true;
  // #endif
  // #ifndef APP
  return false;
  // #endif
}

export function isAppEntryLogin(): boolean {
  // #ifdef APP
  return rootAttached && appEntryStage.value == "login";
  // #endif
  // #ifndef APP
  return false;
  // #endif
}

let coldStartTaken = false;
/** 根页面被 reLaunch 重建时不重放本次进程启动链接。 */
export function takeAppEntryColdStart(): boolean {
  if (coldStartTaken) return false;
  coldStartTaken = true;
  return true;
}
