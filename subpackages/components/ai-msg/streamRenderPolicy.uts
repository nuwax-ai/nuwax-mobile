import { isPlainStreamBody } from "@/subpackages/components/ai-msg/plainStreamDisplay.uts";

/** 内部流式渲染类型。只负责路由，不改变消息/SSE 对外协议。 */
export const STREAM_RENDER_KIND_PLAIN = "plain";
export const STREAM_RENDER_KIND_MARKDOWN = "markdown";
export const STREAM_RENDER_KIND_CODE = "code";
export const STREAM_RENDER_KIND_TABLE = "table";
export const STREAM_RENDER_KIND_FORMULA = "formula";
export const STREAM_RENDER_KIND_MEDIA = "media";
export const STREAM_RENDER_KIND_TOOL = "tool";
export const STREAM_RENDER_KIND_MIXED = "mixed";

export class StreamRenderProfile {
  kind: string = STREAM_RENDER_KIND_MARKDOWN;
  /** 是否可绕过消息列表发布，仅直更当前渲染叶子。 */
  canPatchLeaf: boolean = false;
  /** 是否可能因公式、图片、工具卡等异步任务再次改变高度。 */
  mayAsyncRelayout: boolean = true;
}

/**
 * 流式 renderer 的唯一内容分类入口。
 * 本轮只有 plain 启用叶子快速通道；其余类型先分类、仍走既有 Markdown renderer。
 */
export function resolveStreamRenderProfile(body: string): StreamRenderProfile {
  const profile = new StreamRenderProfile();
  if (isPlainStreamBody(body) == true) {
    profile.kind = STREAM_RENDER_KIND_PLAIN;
    profile.canPatchLeaf = true;
    profile.mayAsyncRelayout = false;
    return profile;
  }

  let matched: number = 0;
  if (body.indexOf("markdown-custom-process") >= 0 || body.indexOf("<task-result") >= 0) {
    profile.kind = STREAM_RENDER_KIND_TOOL;
    matched = matched + 1;
  }
  if (body.indexOf("```") >= 0 || body.indexOf("mermaid") >= 0) {
    profile.kind = STREAM_RENDER_KIND_CODE;
    matched = matched + 1;
  }
  if (body.indexOf("$") >= 0 || body.indexOf("\\[") >= 0 || body.indexOf("\\(") >= 0) {
    profile.kind = STREAM_RENDER_KIND_FORMULA;
    matched = matched + 1;
  }
  if (/^\s*\|.*\|\s*$/m.test(body)) {
    profile.kind = STREAM_RENDER_KIND_TABLE;
    matched = matched + 1;
  }
  if (body.indexOf("![") >= 0) {
    profile.kind = STREAM_RENDER_KIND_MEDIA;
    matched = matched + 1;
  }
  if (matched > 1) profile.kind = STREAM_RENDER_KIND_MIXED;
  return profile;
}
