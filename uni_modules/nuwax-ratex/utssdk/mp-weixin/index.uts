/** nuwax-ratex 微信小程序后端。占位。 */
export * from '../interface.uts'
import { RatexRenderOptions, RatexRenderResult } from '../interface.uts'

export function renderLatex(tex: string, opts: RatexRenderOptions): RatexRenderResult {
	return { imageDataURL: '', width: 0, height: 0, errMsg: 'mp_wasm_not_implemented' }
}

export function renderLatexAsync(
	tex: string,
	opts: RatexRenderOptions,
	onResult: (res: RatexRenderResult) => void,
): void {
	onResult(renderLatex(tex, opts))
}
