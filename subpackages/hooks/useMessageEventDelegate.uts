import { onMounted, onUnmounted, Ref } from "vue";
import { EventBindResponseActionEnum } from "@/types/enums/agent";
import {
  checkPathParams,
  fillPathParams,
  objectToQueryString,
} from "@/utils/common.uts";
import {
  EventBindConfig,
  EventArg,
  EventConfig,
  ShowPagePreviewOptions,
} from "@/types/interfaces/agent";
import { handleExternalLink } from "@/utils/system.uts";
import { t } from "@/utils/i18n";

const showError = (msg: string): void => {
  uni.showToast({
    title: msg,
    icon: "none",
  });
};

function readBindValue(
  parsedData: UTSJSONObject,
  key: string,
  fallback: any,
): any {
  const value = parsedData[key];
  if (value != null) {
    return value;
  }
  return fallback;
}

/**
 * 事件防重复触发管理器
 */
export class EventDedupManager {
  handledEvents: Set<string> = new Set();
  timeout: number = 1000;

  constructor(timeout?: number) {
    if (timeout != null) {
      this.timeout = timeout;
    }
  }

  isDuplicate(eventKey: string): boolean {
    if (this.handledEvents.has(eventKey)) {
      return true;
    }
    this.handledEvents.add(eventKey);
    setTimeout(() => {
      this.handledEvents.delete(eventKey);
    }, this.timeout);
    return false;
  }

  clear(): void {
    this.handledEvents.clear();
  }
}

export const handleMessageEventClick = (
  eventType: string,
  dataStr: string,
  eventBindConfig: EventBindConfig | null | undefined,
  showPagePreview?: (opts: ShowPagePreviewOptions) => void,
  dedupManager?: EventDedupManager,
): void => {
  const eventKey = `${eventType}-${dataStr}`;

  if (dedupManager != null && dedupManager.isDuplicate(eventKey) == true) {
    return;
  }

  let parsedData: UTSJSONObject = {};
  try {
    parsedData = JSON.parse(dataStr) as UTSJSONObject;
  } catch (err) {
    console.error("[Event Handler] 数据解析失败:", err);
    return;
  }

  const configs = eventBindConfig?.eventConfigs;
  let eventConfig: EventConfig | null = null;
  if (configs != null) {
    for (let i = 0; i < configs.length; i++) {
      const cfg = configs[i];
      if (cfg.identification == eventType) {
        eventConfig = cfg;
        break;
      }
    }
  }

  if (eventConfig == null) {
    console.warn(`[Event Handler] 未找到事件配置: ${eventType}`);
    return;
  }

  switch (eventConfig.type) {
    case EventBindResponseActionEnum.Page: {
      const pageUrl = eventConfig.pageUrl;
      if (pageUrl == null || pageUrl.length == 0) {
        showError(t("Mobile.ButtonWrapper.pagePathConfigError"));
        return;
      }

      const pathParams: UTSJSONObject = {};
      const params: UTSJSONObject = {};
      const args = eventConfig.args;
      if (args != null) {
        for (let ai = 0; ai < args.length; ai++) {
          const arg = args[ai] as EventArg;
          const argName = arg.name;
          if (argName == null || argName.length == 0) {
            continue;
          }
          if (arg.inputType == "Path") {
            pathParams[argName] = readBindValue(parsedData, argName, arg.bindValue);
          }
          if (arg.inputType == "Query") {
            params[argName] = readBindValue(parsedData, argName, arg.bindValue);
          }
        }
      }

      if (checkPathParams(pageUrl, pathParams) == true) {
        const filledPageUrl = fillPathParams(pageUrl, pathParams);
        let fullUri = filledPageUrl;
        const basePath = eventConfig.basePath;
        if (basePath != null && basePath.length > 0) {
          fullUri = `${basePath}${filledPageUrl}`;
        }

        const queryString = objectToQueryString(params);
        if (showPagePreview != null) {
          if (queryString.length > 0) {
            showPagePreview({
              uri: `${fullUri}?${queryString}`,
            });
          } else {
            showPagePreview({
              uri: fullUri,
            });
          }
        }
      } else {
        showError(t("Mobile.ButtonWrapper.pagePathParamConfigError"));
      }
      break;
    }

    case EventBindResponseActionEnum.Link: {
      handleExternalLink(eventConfig.url);
      break;
    }

    default:
      console.warn(`[Event Handler] 未知的事件类型: ${eventConfig.type}`);
  }
};

export const useMessageEventDelegate = (
  containerRef: Ref<any | null>,
  eventBindConfig: Ref<EventBindConfig | null>,
  showPagePreview?: (opts: ShowPagePreviewOptions) => void,
): void => {
  const dedupManager = new EventDedupManager(1000);

  // #ifdef H5 || WEB
  const handleEventClick = (eventType: string, dataStr: string): void => {
    const config = eventBindConfig.value;
    handleMessageEventClick(
      eventType,
      dataStr,
      config,
      showPagePreview,
      dedupManager,
    );
  };

  const handleClick = (e: MouseEvent): void => {
    const target = e.target as HTMLElement;
    const eventElement = target.closest(".event") as HTMLElement | null;

    if (eventElement != null) {
      e.preventDefault();
      e.stopPropagation();
      const eventType = eventElement.getAttribute("event-type");
      const dataStr = eventElement.getAttribute("data");
      if (eventType != null && eventType.length > 0 && dataStr != null && dataStr.length > 0) {
        handleEventClick(eventType, dataStr);
      } else {
        console.warn("[Event Delegate] 缺少必要属性", { eventType, dataStr });
      }
    }
  };

  onMounted(() => {
    const container = containerRef.value;
    if (container != null) {
      container.addEventListener("click", handleClick);
    }
  });

  onUnmounted(() => {
    const container = containerRef.value;
    if (container != null) {
      container.removeEventListener("click", handleClick);
    }
  });
  // #endif
};
