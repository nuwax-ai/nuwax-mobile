/**
 * 分步表单 - wizard + allowSkip + radio-with-custom
 * 场景: Agent 分阶段收集发布配置
 */
export function mockMcpAskWizard(): McpAskInteraction {
  const ui = parseMockUi(
    `{"version":"${INTERACTION_UI_SCHEMA_VERSION}","presentation":"wizard","title":"发布检查","description":"请按步骤确认发布配置","allowSkip":true,"skipLabel":"稍后处理","fields":[{"name":"target","title":"发布目标","widget":"radio","required":true,"options":[{"value":"staging","label":"预发布"},{"value":"production","label":"生产"}]},{"name":"strategy","title":"发布策略","widget":"radio-with-custom","required":true,"allowCustom":true,"otherValue":"__custom__","otherField":"strategyCustom","placeholder":"输入自定义发布策略","options":[{"value":"full","label":"全量发布"},{"value":"gray","label":"灰度发布"}]},{"name":"notes","title":"补充说明","widget":"textarea","maxLength":500}],"steps":[{"id":"target","title":"选择目标","description":"先确认要发布到哪个环境","fields":["target"]},{"id":"strategy","title":"确认策略","description":"再选择发布方式","fields":["strategy","notes"]}],"submitLabel":"确认发布","cancelLabel":"取消"}`,
  );
  return createMockMcpAsk(
    "发布检查",
    "请按步骤确认发布配置",
    ui,
  );
}

// ==================== Mock 场景注册表 ====================

type MockScenarioKey =
  | "acp-simple"
  | "acp-multi"
  | "acp-network"
  | "mcp-survey"
  | "mcp-select"
  | "mcp-simple"
  | "mcp-file"
  | "mcp-list"
  | "mcp-wizard";

const MOCK_SCENARIOS: Record<
  MockScenarioKey,
  () => AcpPermissionInteraction | McpAskInteraction
> = {
  "acp-simple": mockAcpPermissionSimple,
  "acp-multi": mockAcpPermissionMultiOption,
  "acp-network": mockAcpPermissionNetwork,
  "mcp-survey": mockMcpAskSurvey,
  "mcp-select": mockMcpAskSelectForm,
  "mcp-simple": mockMcpAskSimple,
  "mcp-file": mockMcpAskWithFile,
  "mcp-list": mockMcpAskWithList,
  "mcp-wizard": mockMcpAskWizard,
};

/** 获取所有可用的 mock 场景 key 列表 */
export function getMockScenarioKeys(): string[] {
  return Object.keys(MOCK_SCENARIOS);
}

/** 根据 key 生成对应的 mock 交互数据 */
export function createMockInteraction(
  key: MockScenarioKey,
): AcpPermissionInteraction | McpAskInteraction | null {
  const factory = MOCK_SCENARIOS[key];
  if (factory == null) return null;
  return factory();
}

// ==================== 注入工具 ====================

function cloneMessageInfo(message: any): any {
  return JSON.parse(JSON.stringify(message));
}

function patchMessageField(message: any, field: string, value: any): any {
  const copy = cloneMessageInfo(message);
  copy[field] = value;
  return copy;
}

/**
 * 向消息列表中注入 mock 干预交互
 */
export function injectMockIntervention(
  messageListRef: MessageListRef,
  scenarioKey: MockScenarioKey,
): boolean {
  const interaction = createMockInteraction(scenarioKey);
  if (interaction == null) {
    console.error(`[MockIntervention] 未知的 mock 场景: ${scenarioKey}`);
    return false;
  }

  const list = [...messageListRef.value];

  let targetIndex = -1;
  for (let i = list.length - 1; i >= 0; i--) {
    if (list[i].messageType === "ASSISTANT") {
      targetIndex = i;
      break;
    }
  }

  if (targetIndex < 0) {
    const mockMsg: any = {
      id: `mock_msg_${Date.now()}`,
      index: 0,
      messageType: "ASSISTANT",
      text: "[Mock] 这是一条测试消息, 用于展示干预交互卡片",
      time: new Date().toISOString(),
      attachments: null,
    };
    list.push(mockMsg);
    targetIndex = list.length - 1;
  }

  const targetMessage = list[targetIndex];

  if (interaction.request != null && interaction.request.toolCall != null) {
    const existing = orArray(targetMessage.acpPermissionInteractions);
    list[targetIndex] = patchMessageField(
      targetMessage,
      "acpPermissionInteractions",
      [...existing, interaction],
    );
    console.log(
      `[MockIntervention] 注入 ACP Permission: ${interaction.request.toolCall.title}`,
    );
  } else {
    const existing = orArray(targetMessage.mcpAskInteractions);
    list[targetIndex] = patchMessageField(
      targetMessage,
      "mcpAskInteractions",
      [...existing, interaction],
    );
    console.log(`[MockIntervention] 注入 MCP Ask: ${interaction.title}`);
  }

  messageListRef.value = list;
  return true;
}

/**
 * 清除消息列表中所有 mock 干预交互
 */
export function clearMockInterventions(messageListRef: MessageListRef): void {
  const list = [...messageListRef.value];
  for (let i = 0; i < list.length; i++) {
    const msg = cloneMessageInfo(list[i]);
    if (msg.acpPermissionInteractions != null) {
      msg.acpPermissionInteractions = msg.acpPermissionInteractions.filter(
        (item: AcpPermissionInteraction) => !item.id.startsWith("mock_acp_"),
      );
      if (msg.acpPermissionInteractions.length === 0) {
        msg.acpPermissionInteractions = null;
      }
    }
    if (msg.mcpAskInteractions != null) {
      msg.mcpAskInteractions = msg.mcpAskInteractions.filter(
        (item: McpAskInteraction) => !item.requestId.startsWith("mock_mcp_"),
      );
      if (msg.mcpAskInteractions.length === 0) {
        msg.mcpAskInteractions = null;
      }
    }
    if (msg.id != null && `${msg.id}`.startsWith("mock_msg_")) {
      list.splice(i, 1);
      i--;
      continue;
    }
    list[i] = msg;
  }
  messageListRef.value = list;
}
