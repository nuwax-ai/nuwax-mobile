/**
 * Nuwax Vox 设备语音网关 - App 设备接口
 * 绑定/解绑/改名/列表/会议模式开关；mock 开关见 mockVoxData.uts
 */
import request from "@/servers/useRequest";
import { VOX_BASE_URL } from "@/constants/config";
import type { RequestResponse, VoidRequestResponse } from "@/types/interfaces/request";
import type { AppDeviceBindParams, AppDeviceRenameParams, IAppDeviceView, IAppDeviceEventEmotionView, IAppDeviceEmotionView, IAppTtsVoiceView, IAppDeviceVoiceSettingsView, AppDeviceVoiceSettingsUpdateParams, IAppDeviceGoodsView } from "@/types/interfaces/voxDevice";
import {
  isVoxMockEnabled,
  mockVoxBindDevice,
  mockVoxDeviceList,
  mockVoxEmotionOptions,
  mockVoxEventEmotions,
  mockVoxMeetingModeSwitch,
  mockVoxRenameDevice,
  mockVoxUnbindDevice,
  mockVoxUpdateEventEmotion,
} from "./mockVoxData";

/**
 * 注：后端服务已就绪、真机在线联调。下列新增接口（设备详情 / 模式切换 / 语音设置）
 * 不再走 mock 分支，直接打真实网关；mock 仅保留在绑定/解绑/改名/列表/会议模式/事件表情。
 */

/** Android 上自定义 class 序列化会丢字段，显式构造 body */
function buildBindBody(data: AppDeviceBindParams): UTSJSONObject {
  const body = new UTSJSONObject();
  body["deviceId"] = data.deviceId;
  body["displayName"] = data.displayName;
  return body;
}

/** 绑定设备；deviceSecret 仅此接口返回，需下发给设备本地保存 */
export async function apiVoxBindDevice(data: AppDeviceBindParams): Promise<RequestResponse<IAppDeviceView>> {
  if (isVoxMockEnabled()) {
    return mockVoxBindDevice(data.deviceId, data.displayName);
  }
  const res = await request({ url: "/api/app/devices/bind", method: "POST", data: buildBindBody(data), baseUrl: VOX_BASE_URL });
  return res;
}

/** 解绑设备（deviceId 需 URL 编码） */
export async function apiVoxUnbindDevice(deviceId: string): Promise<VoidRequestResponse> {
  if (isVoxMockEnabled()) {
    return mockVoxUnbindDevice(deviceId);
  }
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/unbind`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}

/** 修改设备名称 */
export async function apiVoxRenameDevice(deviceId: string, data: AppDeviceRenameParams): Promise<RequestResponse<IAppDeviceView>> {
  if (isVoxMockEnabled()) {
    return mockVoxRenameDevice(deviceId, data.displayName);
  }
  const body = new UTSJSONObject();
  body["displayName"] = data.displayName;
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/rename`, method: "POST", data: body, baseUrl: VOX_BASE_URL });
  return res;
}

/** 当前用户已绑定设备列表（不含密钥） */
export async function apiVoxDeviceList(): Promise<RequestResponse<IAppDeviceView[]>> {
  if (isVoxMockEnabled()) {
    return mockVoxDeviceList();
  }
  const res = await request({ url: "/api/app/devices", method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 设备详情（GET /{deviceId}，含 mode/online/agentId） */
export async function apiVoxDeviceDetail(deviceId: string): Promise<RequestResponse<IAppDeviceView>> {
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}`, method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 切换设备工作模式（POST /mode/update；返回最新设备详情，含 mode/online） */
export async function apiVoxUpdateDeviceMode(deviceId: string, mode: string): Promise<RequestResponse<IAppDeviceView>> {
  const body = new UTSJSONObject();
  body["mode"] = mode;
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/mode/update`, method: "POST", data: body, baseUrl: VOX_BASE_URL });
  return res;
}

/** 设备语音设置（GET /voice-settings） */
export async function apiVoxGetVoiceSettings(deviceId: string): Promise<RequestResponse<IAppDeviceVoiceSettingsView>> {
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/voice-settings`, method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 更新设备语音设置（POST /voice-settings/update；未传字段保持原值） */
export async function apiVoxUpdateVoiceSettings(deviceId: string, data: AppDeviceVoiceSettingsUpdateParams): Promise<RequestResponse<IAppDeviceVoiceSettingsView>> {
  const body = new UTSJSONObject();
  if (data.voiceBroadcastEnabled != null) body["voiceBroadcastEnabled"] = data.voiceBroadcastEnabled;
  if (data.volumePercent != null) body["volumePercent"] = data.volumePercent;
  if (data.ttsVoice != null) body["ttsVoice"] = data.ttsVoice;
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/voice-settings/update`, method: "POST", data: body, baseUrl: VOX_BASE_URL });
  return res;
}

/** 开启会议模式（向在线设备下发 set_audio_mode enabled，异步等 ack） */
export async function apiVoxMeetingModeStart(deviceId: string): Promise<VoidRequestResponse> {
  if (isVoxMockEnabled()) {
    return mockVoxMeetingModeSwitch(deviceId, true);
  }
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/meeting/start`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}

/** 关闭会议模式 */
export async function apiVoxMeetingModeStop(deviceId: string): Promise<VoidRequestResponse> {
  if (isVoxMockEnabled()) {
    return mockVoxMeetingModeSwitch(deviceId, false);
  }
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/meeting/stop`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}

/** 设备事件表情绑定列表（GET /event-emotions） */
export async function apiVoxGetEventEmotions(deviceId: string): Promise<RequestResponse<IAppDeviceEventEmotionView[]>> {
  if (isVoxMockEnabled()) {
    return mockVoxEventEmotions(deviceId);
  }
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/event-emotions`, method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/**
 * 更新单条事件表情绑定（POST /event-emotions/update）
 * 一次只写一条；emotion 传空串恢复系统默认。
 */
export async function apiVoxUpdateEventEmotion(deviceId: string, event: string, emotion: string): Promise<VoidRequestResponse> {
  if (isVoxMockEnabled()) {
    return mockVoxUpdateEventEmotion(deviceId, event, emotion);
  }
  // Android 上自定义 class 序列化会丢字段，显式构造 {bindings:[{event,emotion}]}
  const binding = new UTSJSONObject();
  binding["event"] = event;
  binding["emotion"] = emotion;
  const bindingsArr: UTSJSONObject[] = [binding];
  const body = new UTSJSONObject();
  body["bindings"] = bindingsArr;
  const res = await request({ url: `/api/app/devices/${encodeURIComponent(deviceId)}/event-emotions/update`, method: "POST", data: body, baseUrl: VOX_BASE_URL });
  return res;
}

/** 可选设备表情列表（GET /emotions，无 deviceId） */
export async function apiVoxGetEmotionOptions(): Promise<RequestResponse<IAppDeviceEmotionView[]>> {
  if (isVoxMockEnabled()) {
    return mockVoxEmotionOptions();
  }
  const res = await request({ url: "/api/app/devices/emotions", method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 可选 TTS 音色列表（GET /tts-voices，无 deviceId） */
export async function apiVoxGetTtsVoices(): Promise<RequestResponse<IAppTtsVoiceView[]>> {
  const res = await request({ url: "/api/app/devices/tts-voices", method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/**
 * 设备商品列表（GET /api/app/device-goods，无入参）
 * 终端产品购买卡数据源；取列表首项展示，goodsId 随下单回传。
 */
export async function apiVoxListGoods(): Promise<RequestResponse<IAppDeviceGoodsView[]>> {
  const res = await request({ url: "/api/app/device-goods", method: "GET", baseUrl: VOX_BASE_URL });
  return res;
}

/** 删除设备绑定记录（POST /api/app/devices/bindings/{id}/delete） */
export async function apiDeleteDeviceBinding(id: string): Promise<VoidRequestResponse> {
  const res = await request({ url: `/api/app/devices/bindings/${encodeURIComponent(id)}/delete`, method: "POST", baseUrl: VOX_BASE_URL });
  return res;
}


