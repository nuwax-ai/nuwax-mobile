<template>
  <!--
    App 必须自绘浮层：modal-popup/uni-popup 在 Android 打开时会触发框架 setupRenderEffect NPE。
    内容区两端一致：diff-list-view / uni-ai-msg-code。
  -->
  <!-- #ifdef APP -->
  <view v-if="appVisible" class="app-details-mask" @tap="close">
    <view class="app-details-panel" @tap.stop="onPanelTap">
      <view class="app-details-head">
        <text class="app-details-title">{{ displayTitle }}</text>
        <text class="app-details-action" @tap="copy">{{ copyLabel }}</text>
        <text class="app-details-action" @tap="close">×</text>
      </view>
      <scroll-view scroll-y class="app-details-body">
        <diff-list-view v-if="diffFiles.length > 0" :files="diffFiles" />
        <uni-ai-msg-code
          v-else
          class="details-code-box"
          :codeText="appPlainDetailText"
          :codeTokens="emptyCodeTokens"
          language="json"
        />
      </scroll-view>
    </view>
  </view>
  <!-- #endif -->

  <!-- #ifndef APP -->
  <modal-popup ref="modal" :title="displayTitle" :enable-swipe-close="false">
    <template #header-extra>
      <view class="copy-btn" @tap="copy">
        <svg-icon name="icon-CopyOutlined" />
      </view>
    </template>
    <view class="details-content">
      <diff-list-view v-if="diffFiles.length > 0" :files="diffFiles" />
      <uni-ai-msg-code
        v-else
        class="details-code-box"
        :codeText="appPlainDetailText"
        :codeTokens="emptyCodeTokens"
        language="json"
      />
    </view>
  </modal-popup>
  <!-- #endif -->
</template>

<script lang="uts" setup>
  import { ref, computed, type ComponentPublicInstance } from "vue";
  import { t } from "@/utils/i18n";
  // #ifndef APP
  import modalPopup from "@/components/modal-popup/modal-popup.uvue";
  // #endif
  import DiffListView from "@/components/diff-list-view/diff-list-view.uvue";
  import UniAiMsgCode from "@/uni_modules/uni-ai-x/components/uni-ai-msg-code/uni-ai-msg-code.uvue";

  const props = withDefaults(
    defineProps<{
      title?: string | null;
      detailData?: any | null;
    }>(),
    {
      title: "",
      detailData: null,
    },
  );

  const modal = ref<any | null>(null);
  const appVisible = ref(false);
  /** openWith 写入的本地数据，避免父页改 props 触发整页消息列表重渲染 */
  const localTitle = ref<string>("");
  const localDetailData = ref<any | null>(null);
  const useLocalData = ref(false);
  /** 无高亮 token 时 uni-ai-msg-code 走 codeText 原文渲染 */
  const emptyCodeTokens = [] as any[];

  const copyLabel = computed((): string => {
    const text = t("Mobile.ThirdParty.MpHtml.copyCode");
    return text.length > 0 ? text : "复制";
  });

  const activeDetailData = computed((): any | null => {
    if (useLocalData.value) {
      return localDetailData.value;
    }
    return props.detailData != null ? props.detailData : null;
  });

  const displayTitle = computed((): string => {
    if (useLocalData.value) {
      return localTitle.value;
    }
    const raw = props.title;
    if (raw == null) {
      return "";
    }
    return `${raw}`;
  });

  /** Android：Gen* 组件禁止 as UTSJSONObject，须 $callMethod 调 defineExpose。 */
  const callRefMethod = (refVal: any | null, methodName: string): void => {
    if (refVal == null) {
      return;
    }
    const proxy = refVal as ComponentPublicInstance;
    proxy.$callMethod(methodName);
  };

  const readDetailField = (key: string): any | null => {
    const data = activeDetailData.value;
    if (data == null) {
      return null;
    }
    try {
      const obj = data as UTSJSONObject;
      const value = obj[key];
      return value != null ? value : null;
    } catch (e) {
      return null;
    }
  };

  const appPlainDetailText = computed((): string => {
    const data = activeDetailData.value;
    if (data == null) {
      return "";
    }
    try {
      return JSON.stringify(data, null, 2);
    } catch (e) {
      return `${data}`;
    }
  });

  const diffFiles = computed((): any[] => {
    const files = readDetailField("__diffFiles");
    if (files != null && Array.isArray(files)) {
      return files as any[];
    }
    return [];
  });

  const onPanelTap = (): void => {};

  const copy = () => {
    const data =
      diffFiles.value.length > 0 ? diffFiles.value : activeDetailData.value;
    if (data == null) {
      return;
    }
    let content = "";
    try {
      content = JSON.stringify(data, null, 2);
    } catch (e) {
      content = `${data}`;
    }

    uni.setClipboardData({
      data: content,
      success: () => {
        uni.showToast({
          title: t("Mobile.Common.copySuccess"),
          icon: "none",
        });
      },
      fail: () => {
        uni.showToast({
          title: t("Mobile.Common.copyFailed"),
          icon: "none",
        });
      },
    });
  };

  const open = () => {
    useLocalData.value = false;
    // #ifdef APP
    appVisible.value = true;
    // #endif
    // #ifndef APP
    callRefMethod(modal.value, "open");
    // #endif
  };

  /**
   * 带数据打开：数据落在弹窗内部，父页不必改 title/detailData。
   * Android $callMethod 传参：openWith(title, detailData)
   */
  const openWith = (title: string | null, detailData: any | null) => {
    useLocalData.value = true;
    localTitle.value = title != null ? `${title}` : "";
    localDetailData.value = detailData;
    // #ifdef APP
    appVisible.value = true;
    // #endif
    // #ifndef APP
    callRefMethod(modal.value, "open");
    // #endif
  };

  const close = () => {
    // #ifdef APP
    appVisible.value = false;
    // #endif
    // #ifndef APP
    callRefMethod(modal.value, "close");
    // #endif
  };

  defineExpose({
    open,
    openWith,
    close,
  });
</script>

<style lang="scss" scoped>
  .copy-btn {
    margin: 0 25rpx;
    .iconfont {
      color: #333;
      font-size: 32rpx;
    }
  }

  .details-content {
    width: 100%;
  }

  .details-code-box {
    width: 100%;
  }

  /* #ifdef APP */
  .app-details-mask {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    justify-content: center;
    align-items: center;
    z-index: 999;
  }

  .app-details-panel {
    width: 80%;
    max-height: 80%;
    background-color: #ffffff;
    border-radius: 16rpx;
    overflow: hidden;
    flex-direction: column;
  }

  .app-details-head {
    flex-direction: row;
    align-items: center;
    padding: 24rpx 28rpx;
    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: #eceff5;
  }

  .app-details-title {
    flex: 1;
    font-size: 30rpx;
    color: #15171f;
  }

  .app-details-action {
    margin-left: 24rpx;
    font-size: 28rpx;
    color: #3d5cff;
  }

  .app-details-body {
    width: 100%;
    max-height: 900rpx;
    padding: 24rpx 28rpx;
  }
  /* #endif */
</style>
