import request from "./useRequest";
import type { RequestResponse } from "@/types/interfaces/request";

/** 公开列表：旧后端或网络失败时由登录页保留普通登录，不触发全局踢登录。 */
export async function apiAuthIdpLoginList(): Promise<RequestResponse<UTSJSONObject>> {
  return await request({
    url: "/api/auth/idp/list",
    method: "GET",
    skipAuth: true,
    suppressAuthRedirect: true,
    suppressErrorToast: true,
    timeout: 6000,
  });
}

/** 回跳后由服务端验证 Cookie，包括 HttpOnly Cookie；不读取或导出 ticket。 */
export async function apiAuthIdpSession(): Promise<RequestResponse<UTSJSONObject>> {
  return await request({
    url: "/api/user/getLoginInfo",
    method: "GET",
    skipAuth: true,
    suppressAuthRedirect: true,
    suppressErrorToast: true,
    timeout: 10000,
  });
}
