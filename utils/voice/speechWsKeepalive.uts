/**
 * Speech WebSocket 应用层心跳保活。
 * 连接 open 后定时发送 {"type":"ping"}，避免空闲被网关断开。
 *
 * 注意：即使服务端回 UNKNOWN_TYPE，往返流量仍能保活 TCP/网关；
 * 因此不得因业务层拒识而停心跳（停了反而会被空闲超时踢掉）。
 * 心跳与 SSE HTTP 流互不干扰：禁止在 chat abort / 清渲染路径里停心跳。
 */

/** 心跳间隔（ms）；需小于常见网关空闲超时（常 30～60s） */
export const SPEECH_WS_KEEPALIVE_INTERVAL_MS = 15000;

export type SpeechWsKeepaliveSendFn = (payloadJson: string) => boolean;

/**
 * 绑定到「当前活跃 Socket」的心跳定时器。
 * 通过 sendFn 解耦 SocketTask / H5 原生 WebSocket。
 */
export class SpeechWsKeepalive {
  private timerId: number = 0;
  private sendFn: SpeechWsKeepaliveSendFn | null = null;
  private label: string = "";
  private onTick: (() => void) | null = null;
  /** 仅用于降噪：服务端拒识 ping 时只打一次日志，心跳继续发 */
  private loggedServerReject: boolean = false;
  /**
   * SSE 会话进行中暂停发 ping：已不再使用（SSE 与 WS 心跳解耦）。
   * 保留方法以免旧调用编译失败；调用无效果。
   */
  private paused: boolean = false;

  /**
   * 启动或重启心跳。
   * @param label 日志前缀，如 ASR / TTS
   * @param sendFn 发送 JSON 文本；返回 false 表示发送失败（连接可能已断）
   * @param onTick 每次成功发送后的可选回调（如刷新 warm 空闲计时）
   */
  start(
    label: string,
    sendFn: SpeechWsKeepaliveSendFn,
    onTick: (() => void) | null = null,
  ): void {
    this.stopTimerOnly();
    this.label = label;
    this.sendFn = sendFn;
    this.onTick = onTick;
    this.timerId = setInterval((): void => {
      this.tick();
    }, SPEECH_WS_KEEPALIVE_INTERVAL_MS) as number;
  }

  /** 仅更换发送目标，不重置计时（会话 socket 与预热 socket 切换时用） */
  rebind(
    sendFn: SpeechWsKeepaliveSendFn,
    onTick: (() => void) | null = null,
  ): void {
    this.sendFn = sendFn;
    this.onTick = onTick;
    if (this.timerId == 0 && sendFn != null) {
      this.start(this.label.length > 0 ? this.label : "SpeechWS", sendFn, onTick);
    }
  }

  stop(): void {
    this.stopTimerOnly();
    this.sendFn = null;
    this.onTick = null;
    this.paused = false;
  }

  /** SSE 进行中：跳过发送，定时器仍跑（resume 后下一拍立刻可发） */
  pause(): void {
    this.paused = true;
  }

  /** SSE 结束：恢复发 ping */
  resume(): void {
    this.paused = false;
  }

  /**
   * 服务端回 UNKNOWN_TYPE(ping)：只记日志，不停心跳、不关连、不触碰 SSE/chat。
   * 应用层拒识不影响网关侧「有流量=保活」。
   */
  markRejectedByServer(): void {
    if (this.loggedServerReject == true) {
      return;
    }
    this.loggedServerReject = true;
    if (this.label.length > 0) {
      console.warn(
        "[" +
          this.label +
          "] server UNKNOWN_TYPE ping (ignored; keepalive continues; does not affect SSE/chat)",
      );
    }
  }

  /** 离开页面 / 完整 teardown 时重置日志标记，便于下次进页重试提示 */
  resetServerReject(): void {
    this.loggedServerReject = false;
  }

  isRunning(): boolean {
    return this.timerId > 0;
  }

  private stopTimerOnly(): void {
    if (this.timerId > 0) {
      clearInterval(this.timerId);
      this.timerId = 0;
    }
  }

  private tick(): void {
    if (this.paused == true) {
      return;
    }
    const sendFn = this.sendFn;
    if (sendFn == null) {
      return;
    }
    try {
      const payload = new UTSJSONObject();
      payload["type"] = "ping";
      const ok = sendFn(JSON.stringify(payload));
      if (ok != true) {
        console.warn("[" + this.label + "] keepalive send failed");
        return;
      }
    } catch (_eSend) {
      console.warn("[" + this.label + "] keepalive send threw");
      return;
    }
    const tickCb = this.onTick;
    if (tickCb == null) {
      return;
    }
    try {
      tickCb();
    } catch (_eTick) {
      // onTick 不得打断心跳（iOS storage 等副作用异常）
      console.warn("[" + this.label + "] keepalive onTick threw");
    }
  }
}
